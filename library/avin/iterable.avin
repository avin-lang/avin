module avin

// What can be traversed: every collection, and every iterator. `iterator()` hands out an iterator
// over the elements; a collection makes a fresh one each time, so it can be traversed again, while an
// iterator returns itself, so traversing it consumes it. Code generic over `Iterable` therefore
// traverses its input once.
trait Iterable[+A]
    iterator() -> Iterator[A]

    // The first element the iterator gives, or `None` when there is none.
    headOption -> Option[A]
        val it = iterator()
        if it.hasNext() then Some(it.next()) else None

    // The first element the iterator gives, which traps when there is none.
    head -> A = headOption match
        Some(x) -> x
        None -> fail("head of an empty collection")

    // The last element the iterator gives, found by traversing them all, or `None` when there is none.
    lastOption -> Option[A]
        val it = iterator()
        if !it.hasNext() then return None
        var x = it.next()
        while it.hasNext()
            x = it.next()
        Some(x)

    // The last element the iterator gives, which traps when there is none.
    last -> A = lastOption match
        Some(x) -> x
        None -> fail("last of an empty collection")

    // The number of elements, found by traversing them all; on an iterator it uses the iterator up.
    // A collection that holds its count overrides this to answer at once.
    size -> int
        val it = iterator()
        var n = 0
        while it.hasNext()
            it.next()
            n += 1
        n

    // The number of elements when it is known without traversing, otherwise `-1`. A collection that
    // holds its count overrides this to answer it; a lazy view, an iterator, or a type that has not
    // overridden it answers `-1`, and `size` then counts.
    knownSize -> int = -1

    // A negative number, zero or a positive number as the number of elements is less than, equal to
    // or greater than `n`. It reads no more than `n + 1` elements when the count is not known.
    sizeCompare(n: int) -> int
        val known = knownSize
        if known >= 0 then return if known < n then -1 else if known == n then 0 else 1
        if n < 0 then return 1
        val it = iterator()
        var seen = 0
        while seen < n && it.hasNext()
            it.next()
            seen += 1
        if seen < n then -1 else if it.hasNext() then 1 else 0

// A single pass over a sequence of elements. `hasNext()` says whether another element remains, and
// `next()` yields it and moves past it; `next()` on an iterator with no element left traps.
//
// The iterators made from an iterator here are lazy: each reads its source only as far as its own
// `hasNext()` and `next()` ask, so `it.map(f).take(2)` calls `f` twice however long `it` is. They
// share the source, which then must not be read on its own.
trait Iterator[+A]: Iterable[A]
    hasNext() -> bool
    next() -> A
    override iterator() -> Iterator[A] = self

    // The number of elements remaining, found by reading them all: the iterator is used up, so
    // `hasNext()` is false afterwards and a second call answers 0.
    override size -> int
        var n = 0
        while hasNext()
            next()
            n += 1
        n

    // The same as `size`.
    length -> int = size

    // The elements with `f` applied to each, `f` being called as each is read.
    map[B](f: (A) -> B) -> Iterator[B] = MappedIterator(self, f)

    // The elements that satisfy `p`; `p` is called as the source is read past each one.
    filter(p: (A) -> bool) -> Iterator[A] = FilteredIterator(self, p, None)

    // The same as `filter`, which is already lazy, so a comprehension over an iterator tests each
    // element just before its yielded value is computed.
    withFilter(p: (A) -> bool) -> Iterator[A] = FilteredIterator(self, p, None)

    // The elements of the collections `f` makes of each element, joined in order; `f` is called on
    // an element only once the elements of the collection before it are used up.
    flatMap[B](f: (A) -> Iterable[B]) -> Iterator[B] = FlatMappedIterator(self, f, None)

    // The values of the options `f` makes of each element, those that hold one, read as the source
    // is read past each element.
    flatMap[B](f: (A) -> Option[B]) -> Iterator[B] = CollectedIterator(self, f, None)

    // `pf` of each element it is defined at, tested as the source is read past each one.
    collect[B](pf: PartialFunction[A, B]) -> Iterator[B] = CollectedIterator(self, pf.lift(), None)

    // The first `n` elements, or all of them when there are fewer; none when `n` is not positive.
    take(n: int) -> Iterator[A] = TakenIterator(self, n)

    // The elements after the first `n`, which are skipped when the first element is asked for.
    drop(n: int) -> Iterator[A] = DroppedIterator(self, n)

    // The elements up to, and not including, the first that does not satisfy `p`.
    takeWhile(p: (A) -> bool) -> Iterator[A] = TakenWhileIterator(self, p, None, false)

    // The elements from the first that does not satisfy `p` on.
    dropWhile(p: (A) -> bool) -> Iterator[A] = DroppedWhileIterator(self, p, None, false)

    // Pairs of this iterator's elements and `other`'s, in step, ending when either does. `other` is
    // any collection, read through one iterator of its own.
    zip[B](other: Iterable[B]) -> Iterator[(A, B)] = ZippedIterator(self, other.iterator())

    // Each element paired with its position, counted from 0.
    zipWithIndex -> Iterator[(A, int)] = IndexedIterator(self, 0)

// More lazy transformations of an iterator. Each answers an iterator that reads its source only as far
// as its own `hasNext()` and `next()` ask, as `map` and the rest above do, and shares the source.
// Being added to `Iterator`, they are found before the forms every `Iterable` has, which make
// vectors.
impl[T] Iterator[T]
    // The elements followed by those of `other`, whose iterator is asked for only once these are
    // used up.
    ++[W >: T](other: Iterable[W]) -> Iterator[W] = JoinedIterator[W](self, other, None)

    // The same as `++`.
    concat[W >: T](other: Iterable[W]) -> Iterator[W] = JoinedIterator[W](self, other, None)

    // `initial`, then each partial result of folding the elements with `f` from `initial`: one more
    // than there are elements. `f` is called on an element as the result after it is read.
    scanLeft[B](initial: B, f: (B, T) -> B) -> Iterator[B] = ScannedIterator(self, initial, f, false)

    // Vectors of `size` consecutive elements, in order, the last holding what remains when it is
    // fewer. A size below 1 traps.
    grouped(size: int) -> Iterator[Vector[T]]
        if size < 1 then fail("group size is not positive")
        WindowIterator(self, size, size, None, None)

    // Vectors of `size` consecutive elements starting at every `step`th one, in order, up to the
    // first that reaches the last element, which holds what remains when it is fewer; a source
    // shorter than `size` gives one window of all of it, and an empty one none. A size or step below
    // 1 traps. Each window is read when it is asked for, and no element is held beyond the window.
    sliding(size: int, step: int = 1) -> Iterator[Vector[T]]
        if size < 1 then fail("window size is not positive")
        if step < 1 then fail("window step is not positive")
        WindowIterator(self, size, step, None, None)

    // The elements with each one equal to an earlier one left out.
    distinct -> Iterator[T] = DistinctIterator(self, x -> x, Set.empty[T](), None)

    // The elements with each one whose `key` equals an earlier one's left out; `key` is called once
    // for each element read.
    distinctBy[K](key: (T) -> K) -> Iterator[T] = DistinctIterator(self, key, Set.empty[K](), None)

    // Pairs as `zip` makes them, as many as the longer side has: where these elements have run out
    // the pair holds `thisElement`, and where `other`'s have, `thatElement`.
    zipAll[U](other: Iterable[U], thisElement: T, thatElement: U) -> Iterator[(T, U)] =
        ZippedAllIterator(self, other.iterator(), thisElement, thatElement)

    // The elements followed by as many copies of `element` as make `total` of them; just the
    // elements when there are already `total` or more.
    padTo(total: int, element: T) -> Iterator[T] = PaddedIterator(self, total, element, 0)

    // The same elements, `f` being called with each as it is read.
    tapEach(f: (T) -> unit) -> Iterator[T] = TappedIterator(self, f)

    // The same elements, through an iterator that can look at the next one without moving past it.
    buffered() -> BufferedIterator[T] = BufferedIterator(self, None)

// An iterator of collections joins their elements lazily: `flatten` reads the next collection only
// once the one before it is used up.
impl[T] Iterator[Iterable[T]]
    flatten -> Iterator[T] = FlatMappedIterator(self, x -> x, None)

// An iterator of options yields the values they hold, lazily.
impl[T] Iterator[Option[T]]
    flatten -> Iterator[T] = CollectedIterator(self, x -> x, None)

// An iterator that can look at its next element without moving past it. `peek()` answers the element
// `next()` would, reading it from the source when it has not already, and traps when none is left;
// `peekOption()` answers `Some` of it, or `None`.
class BufferedIterator[A](private val source: Iterator[A], private var held: Option[A]): Iterator[A]
    override hasNext() -> bool = held.isDefined || source.hasNext()

    override next() -> A = held match
        Some(x) ->
            held = None
            x
        None -> source.next()

    peekOption() -> Option[A]
        if held.isEmpty && source.hasNext() then held = Some(source.next())
        held

    peek() -> A = peekOption() match
        Some(x) -> x
        None -> fail("peek on an exhausted iterator")

// Iterators made from nothing but a value or a function. Each is lazy: an element is computed when it
// is read, and an endless one is used through `take`, `takeWhile` and the other methods that stop.
object Iterator
    // An iterator with no elements.
    empty[T]() -> Iterator[T] = EmptyIterator[T]()

    // An iterator of the one element `element`.
    single[T](element: T) -> Iterator[T] = SingleIterator(element, false)

    // The endless iterator of `start`, `f(start)`, `f(f(start))` and so on, each call of `f` made when
    // its result is read.
    iterate[T](start: T, f: (T) -> T) -> Iterator[T] = IteratedIterator(start, f, false)

    // The elements `f` gives from `state`: while `f` of the state is `Some((element, next))`, the
    // element is given and `next` becomes the state; the first `None` ends it. `f` is called when
    // the iterator is asked whether another element remains.
    unfold[T, S](state: S, f: (S) -> Option[(T, S)]) -> Iterator[T] = UnfoldedIterator(state, f, None, false)

    // The endless iterator of the values of `element`, which is evaluated once for each element read.
    continually[T](element: -> T) -> Iterator[T] = ContinualIterator(() -> element)

    // The endless iterator of `start`, `start + 1`, `start + 2` and so on, of any integer type. Each
    // element is computed when it is read, so an addition that overflows traps only when the element
    // past the greatest value is asked for.
    from[T: Integer](start: T) -> Iterator[T] = CountingIterator(start, T(1), false)

    // The endless iterator of `start`, `start + step`, `start + 2 * step` and so on; a negative
    // `step` counts down. Overflow traps as `from(start)`'s does.
    from[T: Integer](start: T, step: T) -> Iterator[T] = CountingIterator(start, step, false)

    // An iterator of `count` elements, each the value of `element`, which is evaluated when the
    // element is read; empty when `count` is not positive.
    fill[T](count: int, element: -> T) -> Iterator[T] = ContinualIterator(() -> element).take(count)

    // An iterator of `count` elements, the one at `i` being `f(i)`, computed when it is read; empty
    // when `count` is not positive.
    tabulate[T](count: int, f: (int) -> T) -> Iterator[T] = (0 ..< count).iterator().map(f)

// Every collection and iterator has these, written once here over `iterator()`. Each traverses the
// elements in iteration order and, on an iterator, consumes it. A type with a faster way to answer
// one keeps its own method of the same name and parameter types, which is found first.
impl[T] Iterable[T]
    // A lazy view of the elements: an iterator whose `map`, `filter`, `flatMap`, `collect`, `take`,
    // `drop`, `takeWhile`, `dropWhile` and `zip` make no intermediate collection and compute each
    // element only when it is read. `toVector`, `toList` and the other conversions force it.
    view() -> Iterator[T] = iterator()

    // Whether there are no elements.
    isEmpty -> bool = !iterator().hasNext()

    // Whether there is at least one element.
    nonEmpty -> bool = iterator().hasNext()

    // `f` applied to `initial` and the first element, then to that result and the second, and so on
    // to the last: `f(f(initial, x0), x1)`; `initial` when there are no elements.
    foldLeft[B](initial: B, f: (B, T) -> B) -> B
        var acc = initial
        val it = iterator()
        while it.hasNext() do acc = f(acc, it.next())
        acc

    // `f` applied to the first two elements, then to that result and the third, and so on; traps
    // when there are no elements.
    reduce(f: (T, T) -> T) -> T = reduceOption(f) match
        Some(x) -> x
        None -> fail("reduce of an empty collection")

    // `f` applied as `reduce` applies it, or `None` when there are no elements.
    reduceOption(f: (T, T) -> T) -> Option[T]
        val it = iterator()
        if !it.hasNext() then return None
        var acc = it.next()
        while it.hasNext() do acc = f(acc, it.next())
        Some(acc)

    // Calls `f` with each element, in order.
    foreach(f: (T) -> unit)
        val it = iterator()
        while it.hasNext() do f(it.next())

    // Whether `p` holds for some element; the elements after the first that satisfies it are not
    // reached.
    exists(p: (T) -> bool) -> bool
        val it = iterator()
        while it.hasNext()
            if p(it.next()) then return true
        false

    // Whether `p` holds for every element; true when there are none.
    forall(p: (T) -> bool) -> bool
        val it = iterator()
        while it.hasNext()
            if !p(it.next()) then return false
        true

    // The first element that satisfies `p`, or `None`.
    find(p: (T) -> bool) -> Option[T]
        val it = iterator()
        while it.hasNext()
            val x = it.next()
            if p(x) then return Some(x)
        None

    // How many elements satisfy `p`.
    count(p: (T) -> bool) -> int
        var n = 0
        val it = iterator()
        while it.hasNext()
            if p(it.next()) then n += 1
        n

    // The element whose key is least, the first of equal ones, or `None` when there are none. `key`
    // is computed once for each element.
    minByOption[K: Ord](key: (T) -> K) -> Option[T] = extremeBy(iterator(), key, false)

    // The element whose key is greatest, the first of equal ones, or `None` when there are none.
    maxByOption[K: Ord](key: (T) -> K) -> Option[T] = extremeBy(iterator(), key, true)

    // The element whose key is least, as `minByOption` finds it; traps when there are none.
    minBy[K: Ord](key: (T) -> K) -> T = minByOption(key) match
        Some(x) -> x
        None -> fail("minBy of an empty collection")

    // The element whose key is greatest, as `maxByOption` finds it; traps when there are none.
    maxBy[K: Ord](key: (T) -> K) -> T = maxByOption(key) match
        Some(x) -> x
        None -> fail("maxBy of an empty collection")

    // The elements that satisfy `p` and those that do not, each in order.
    partition(p: (T) -> bool) -> (Vector[T], Vector[T])
        val yes = Vector.newBuilder[T]()
        val no = Vector.newBuilder[T]()
        for x in iterator()
            if p(x) then yes.addOne(x) else no.addOne(x)
        (yes.result(), no.result())

    // The elements grouped by their keys: each key maps to the elements that have it, in order.
    groupBy[K](key: (T) -> K) -> Map[K, Vector[T]] = groupMap(key, x -> x)

    // `f` of the elements, grouped by the elements' keys: each key maps to `f` of the elements that
    // have it, in order.
    groupMap[K, V](key: (T) -> K, f: (T) -> V) -> Map[K, Vector[V]]
        var groups = Map.empty[K, Buffer[V]]()
        for x in iterator()
            val k = key(x)
            groups.get(k) match
                Some(group) -> group.addOne(f(x))
                None ->
                    val group = Buffer[V]()
                    group.addOne(f(x))
                    groups = groups.updated(k, group)
        groups.map((k, group) -> (k, group.toVector))

    // `f` of the elements, grouped by the elements' keys and each group combined: a key with one
    // element maps to `f` of it, and `combine` joins the values of a key's elements in order.
    groupMapReduce[K, V](key: (T) -> K, f: (T) -> V, combine: (V, V) -> V) -> Map[K, V]
        var groups = Map.empty[K, V]()
        for x in iterator()
            val k = key(x)
            val v = f(x)
            val joined = groups.get(k) match
                Some(before) -> combine(before, v)
                None -> v
            groups = groups.updated(k, joined)
        groups

    // A list of the elements, in order.
    toList -> List[T]
        val b = List.newBuilder[T]()
        for x in iterator() do b.addOne(x)
        b.result()

    // A vector of the elements, in order.
    toVector -> Vector[T]
        val b = Vector.newBuilder[T]()
        for x in iterator() do b.addOne(x)
        b.result()

    // An `ArraySeq` of the elements, in order.
    toArraySeq -> ArraySeq[T]
        val b = ArraySeq.newBuilder[T]()
        for x in iterator() do b.addOne(x)
        b.result()

    // A new array of the elements, in order.
    toArray() -> Array[T]
        val b = Array.newBuilder[T]()
        for x in iterator() do b.addOne(x)
        b.result()

    // A new buffer of the elements, in order.
    toBuffer() -> Buffer[T]
        val b = Buffer[T]()
        for x in iterator() do b.addOne(x)
        b

    // Each element paired with its position in iteration order, counted from 0.
    zipWithIndex -> Vector[(T, int)]
        val b = Vector.newBuilder[(T, int)]()
        var i = 0
        for x in iterator()
            b.addOne((x, i))
            i += 1
        b.result()

    // The transformations every collection has. Each makes a new collection, an `Iterable` whose
    // elements are in iteration order; a collection that knows its own kind keeps a method of the
    // same name answering one of that kind, as a list's `map` answers a `List`.

    // The elements with `f` applied to each.
    map[B](f: (T) -> B) -> Iterable[B] = mappedInto(self, f, Vector.newBuilder[B]())

    // The elements of the collections `f` makes of each element, joined in order.
    flatMap[B](f: (T) -> Iterable[B]) -> Iterable[B] = flatMappedInto(self, f, Vector.newBuilder[B]())

    // The values of the options `f` makes of each element, those that hold one, in order.
    flatMap[B](f: (T) -> Option[B]) -> Iterable[B] = keptSomeInto(self, f, Vector.newBuilder[B]())

    // The elements that satisfy `p`.
    filter(p: (T) -> bool) -> Iterable[T] = keptInto(self, p, true, Vector.newBuilder[T]())

    // The elements that satisfy `p`, which a comprehension's guard asks for.
    withFilter(p: (T) -> bool) -> Iterable[T] = keptInto(self, p, true, Vector.newBuilder[T]())

    // `pf` of each element it is defined at.
    collect[B](pf: PartialFunction[T, B]) -> Iterable[B] = collectedInto(self, pf, Vector.newBuilder[B]())

    // Pairs of these elements and `other`'s, in step, ending when either does.
    zip[B](other: Iterable[B]) -> Iterable[(T, B)]
        val b = Vector.newBuilder[(T, B)]()
        val mine = iterator()
        val theirs = other.iterator()
        while mine.hasNext() && theirs.hasNext() do b.addOne((mine.next(), theirs.next()))
        b.result()

    // `pf` of the first element it is defined at, or `None` when it is defined at none; the elements
    // after that one are not reached.
    collectFirst[B](pf: PartialFunction[T, B]) -> Option[B]
        val f = pf.lift()
        val it = iterator()
        while it.hasNext()
            val found = f(it.next())
            if found.isDefined then return found
        None

    // A set of the elements, each equal one once.
    toSet -> Set[T]
        val b = Set.newBuilder[T]()
        for x in iterator() do b.addOne(x)
        b.result()

    // `initial`, then each partial result of `foldLeft(initial, f)`, in order: one more than there
    // are elements.
    scanLeft[B](initial: B, f: (B, T) -> B) -> Vector[B] = iterator().scanLeft(initial, f).toVector

    // The elements, `f` having been called with each in order.
    tapEach(f: (T) -> unit) -> Vector[T]
        val b = Vector.newBuilder[T]()
        for x in iterator()
            f(x)
            b.addOne(x)
        b.result()

    // The values of the `Left`s `f` makes of the elements and those of the `Right`s, each in order.
    partitionMap[A, B](f: (T) -> Either[A, B]) -> (Vector[A], Vector[B])
        val lefts = Vector.newBuilder[A]()
        val rights = Vector.newBuilder[B]()
        for x in iterator()
            f(x) match
                Left(a) -> lefts.addOne(a)
                Right(b) -> rights.addOne(b)
        (lefts.result(), rights.result())

    // The elements before the first that does not satisfy `p`, and the rest, in one traversal; `p`
    // is not called after it first fails.
    span(p: (T) -> bool) -> (Vector[T], Vector[T]) = spanInto(self, p, Vector.newBuilder[T](), Vector.newBuilder[T]())

    // Vectors of `size` consecutive elements, as an iterator's `grouped` makes them. A size below 1
    // traps.
    grouped(size: int) -> Iterator[Vector[T]] = iterator().grouped(size)

    // Windows of `size` elements every `step`, as an iterator's `sliding` makes them. A size or step
    // below 1 traps.
    sliding(size: int, step: int = 1) -> Iterator[Vector[T]] = iterator().sliding(size, step)

    // The elements followed by those of `other`.
    concat[W >: T](other: Iterable[W]) -> Vector[W] = joinedInto[W, Vector[W]](self, other, Vector.newBuilder[W]())

// A collection of collections flattens into one vector of their elements, in order.
impl[T] Iterable[Iterable[T]]
    flatten -> Vector[T]
        val b = Vector.newBuilder[T]()
        for xs in iterator() do b.addAll(xs)
        b.result()

// A collection of options flattens into one vector of the values they hold, in order.
impl[T] Iterable[Option[T]]
    flatten -> Vector[T]
        val b = Vector.newBuilder[T]()
        for o in iterator()
            if o is Some(x) then b.addOne(x)
        b.result()

// Ordered elements have a greatest and a least.
impl[T: Ord] Iterable[T]
    // The greatest element, the first of equal ones, or `None` when there are none.
    maxOption -> Option[T] = extreme(iterator(), true)

    // The least element, the first of equal ones, or `None` when there are none.
    minOption -> Option[T] = extreme(iterator(), false)

    // The greatest element, the first of equal ones; traps when there are none.
    max -> T = maxOption match
        Some(x) -> x
        None -> fail("max of an empty collection")

    // The least element, the first of equal ones; traps when there are none.
    min -> T = minOption match
        Some(x) -> x
        None -> fail("min of an empty collection")

// Displayable elements join into a string.
impl[T: Display] Iterable[T]
    // The elements in their own `Display`, separated by `sep`: `[1, 2, 3].mkString()` is `1, 2, 3`.
    mkString(sep: string = ", ") -> string = joined(iterator(), "", sep, "")

    // The elements between `start` and `end`, separated by `sep`.
    mkString(start: string, sep: string, end: string) -> string = joined(iterator(), start, sep, end)

// Every collection of elements that add has the total of them, an empty one `T.zero()`. Overflow traps
// as `+` does; a string collection concatenates. Traversing an iterator consumes it.
impl[T: Add] Iterable[T]
    sum -> T
        var total = T.zero()
        val it = iterator()
        while it.hasNext() do total = total + it.next()
        total

// Every collection of elements that multiply has the product of them, an empty one `T.one()`.
impl[T: Mul] Iterable[T]
    product -> T
        var total = T.one()
        val it = iterator()
        while it.hasNext() do total = total * it.next()
        total

// Every collection of numbers has their mean, a `real`. The elements are totalled as `real`s, so a
// collection of integers whose sum would overflow its type still averages. Traversing an iterator
// consumes it.
impl[T: Numeric] Iterable[T]
    // The mean of the elements, or `None` when there are none.
    averageOption -> Option[real]
        var total = 0.0
        var count: long = 0
        val it = iterator()
        while it.hasNext()
            total = total + it.next().toReal
            count = count + 1
        if count == 0 then None else Some(total / real(count))

    // The mean of the elements; traps when there are none.
    average -> real = averageOption match
        Some(x) -> x
        None -> fail("average of an empty collection")

// Every collection of ordered elements makes a sorted set, each equal element held once.
impl[T: Ord] Iterable[T]
    toSortedSet -> TreeSet[T] = TreeSet.from(self)

// Every collection of pairs with ordered keys makes a sorted map, a key that comes again replacing
// the value it had.
impl[K: Ord, V] Iterable[(K, V)]
    toSortedMap -> TreeMap[K, V] = TreeMap.from(self)

// Every collection of pairs makes a map, binding each first part to its second; a key that comes
// again replaces the value it had.
impl[K, V] Iterable[(K, V)]
    toMap -> Map[K, V]
        val b = Map.newBuilder[K, V]()
        val it = iterator()
        while it.hasNext() do b.addOne(it.next())
        b.result()

// The element of `items` whose key is greatest, or least, the first of equal ones.
private extremeBy[T, K: Ord](items: Iterator[T], key: (T) -> K, greatest: bool) -> Option[T]
    if !items.hasNext() then return None
    var best = items.next()
    var bestKey = key(best)
    while items.hasNext()
        val x = items.next()
        val k = key(x)
        if (if greatest then k > bestKey else k < bestKey)
            best = x
            bestKey = k
    Some(best)

private class MappedIterator[A, B](source: Iterator[A], f: (A) -> B): Iterator[B]
    override hasNext() -> bool = source.hasNext()

    override next() -> B = f(source.next())

// Holds the next element that satisfies `p` once `hasNext()` has found it.
private class FilteredIterator[A](source: Iterator[A], p: (A) -> bool, private var found: Option[A]): Iterator[A]
    override hasNext() -> bool
        while found.isEmpty && source.hasNext()
            val x = source.next()
            if p(x) then found = Some(x)
        found.isDefined

    override next() -> A
        hasNext()
        found match
            Some(x) ->
                found = None
                x
            None -> fail("next on an exhausted iterator")

private class TakenIterator[A](source: Iterator[A], private var remaining: int): Iterator[A]
    override hasNext() -> bool = remaining > 0 && source.hasNext()

    override next() -> A
        if remaining <= 0 then fail("next on an exhausted iterator")
        remaining -= 1
        source.next()

private class DroppedIterator[A](source: Iterator[A], private var skip: int): Iterator[A]
    private skipped()
        while skip > 0 && source.hasNext()
            source.next()
            skip -= 1
        skip = 0

    override hasNext() -> bool
        skipped()
        source.hasNext()

    override next() -> A
        skipped()
        source.next()

// Holds the next element once `hasNext()` has read it, and stops at the first that fails `p`.
private class TakenWhileIterator[A](source: Iterator[A], p: (A) -> bool, private var found: Option[A], private var done: bool): Iterator[A]
    override hasNext() -> bool
        if done then return false
        if found.isDefined then return true
        if !source.hasNext()
            done = true
            return false
        val x = source.next()
        if p(x) then found = Some(x) else done = true
        !done

    override next() -> A
        hasNext()
        found match
            Some(x) ->
                found = None
                x
            None -> fail("next on an exhausted iterator")

// Holds the first element that fails `p` once the elements before it are skipped.
private class DroppedWhileIterator[A](source: Iterator[A], p: (A) -> bool, private var found: Option[A], private var started: bool): Iterator[A]
    private start()
        if started then return
        started = true
        while source.hasNext()
            val x = source.next()
            if !p(x)
                found = Some(x)
                return

    override hasNext() -> bool
        start()
        found.isDefined || source.hasNext()

    override next() -> A
        start()
        found match
            Some(x) ->
                found = None
                x
            None -> source.next()

// Reads the collection `f` makes of each source element until one has an element left.
private class FlatMappedIterator[A, B](source: Iterator[A], f: (A) -> Iterable[B], private var current: Option[Iterator[B]]): Iterator[B]
    override hasNext() -> bool
        while true
            if current is Some(inner)
                if inner.hasNext() then return true
            if !source.hasNext()
                current = None
                return false
            current = Some(f(source.next()).iterator())
        false

    override next() -> B
        if !hasNext() then fail("next on an exhausted iterator")
        current match
            Some(inner) -> inner.next()
            None -> fail("next on an exhausted iterator")

// Holds the next value `f` gives `Some` of once `hasNext()` has found it.
private class CollectedIterator[A, B](source: Iterator[A], f: (A) -> Option[B], private var found: Option[B]): Iterator[B]
    override hasNext() -> bool
        while found.isEmpty && source.hasNext() do found = f(source.next())
        found.isDefined

    override next() -> B
        hasNext()
        found match
            Some(x) ->
                found = None
                x
            None -> fail("next on an exhausted iterator")

private class ZippedIterator[A, B](left: Iterator[A], right: Iterator[B]): Iterator[(A, B)]
    override hasNext() -> bool = left.hasNext() && right.hasNext()

    override next() -> (A, B)
        if !hasNext() then fail("next on an exhausted iterator")
        val x = left.next()
        (x, right.next())

private class IndexedIterator[A](source: Iterator[A], private var index: int): Iterator[(A, int)]
    override hasNext() -> bool = source.hasNext()

    override next() -> (A, int)
        val x = source.next()
        val i = index
        index += 1
        (x, i)

// Reads `first`, then the iterator of `second`, which it asks for once `first` is used up.
private class JoinedIterator[A](first: Iterator[A], second: Iterable[A], private var rest: Option[Iterator[A]]): Iterator[A]
    private remaining() -> Iterator[A] = rest match
        Some(it) -> it
        None ->
            if first.hasNext() then return first
            val it = second.iterator()
            rest = Some(it)
            it

    override hasNext() -> bool = remaining().hasNext()

    override next() -> A = remaining().next()

// Gives `acc` first, then `f` of it and each source element in turn.
private class ScannedIterator[A, B](source: Iterator[A], private var acc: B, f: (B, A) -> B, private var started: bool): Iterator[B]
    override hasNext() -> bool = !started || source.hasNext()

    override next() -> B
        if started then acc = f(acc, source.next()) else started = true
        acc

// The windows of `sliding` and `grouped`. `last` is the window given most recently and `pending` the
// next one once `hasNext()` has read it; a window shorter than `size`, or a step that finds no new
// element, ends them.
private class WindowIterator[A](source: Iterator[A], size: int, step: int, private var last: Option[Vector[A]], private var pending: Option[Vector[A]]): Iterator[Vector[A]]
    private var done = false

    // Adds up to `n` elements of the source to `b`, answering how many there were.
    private readInto(b: Builder[A, Vector[A]], n: int) -> int
        var read = 0
        while read < n && source.hasNext()
            b.addOne(source.next())
            read += 1
        read

    private following() -> Option[Vector[A]]
        val b = Vector.newBuilder[A]()
        last match
            None ->
                if readInto(b, size) == 0 then return None
            Some(previous) ->
                if previous.length < size then return None
                if step <= size
                    b.addAll(previous.drop(step))
                    if readInto(b, step) == 0 then return None
                else
                    var skipped = size
                    while skipped < step
                        if !source.hasNext() then return None
                        source.next()
                        skipped += 1
                    if readInto(b, size) == 0 then return None
        Some(b.result())

    override hasNext() -> bool
        if pending.isDefined then return true
        if done then return false
        pending = following()
        if pending.isEmpty then done = true
        pending.isDefined

    override next() -> Vector[A]
        if !hasNext() then fail("next on an exhausted iterator")
        val window = pending match
            Some(w) -> w
            None -> fail("next on an exhausted iterator")
        pending = None
        last = Some(window)
        window

// Holds the next element whose key is not in `seen` once `hasNext()` has found it.
private class DistinctIterator[A, K](source: Iterator[A], key: (A) -> K, private var seen: Set[K], private var found: Option[A]): Iterator[A]
    override hasNext() -> bool
        while found.isEmpty && source.hasNext()
            val x = source.next()
            val k = key(x)
            if !seen.contains(k)
                seen = seen.incl(k)
                found = Some(x)
        found.isDefined

    override next() -> A
        hasNext()
        found match
            Some(x) ->
                found = None
                x
            None -> fail("next on an exhausted iterator")

private class ZippedAllIterator[A, B](left: Iterator[A], right: Iterator[B], thisElement: A, thatElement: B): Iterator[(A, B)]
    override hasNext() -> bool = left.hasNext() || right.hasNext()

    override next() -> (A, B)
        if !hasNext() then fail("next on an exhausted iterator")
        val x = if left.hasNext() then left.next() else thisElement
        val y = if right.hasNext() then right.next() else thatElement
        (x, y)

// Counts the elements given, up to `total`, and gives `element` while the count is short of it once
// the source is used up.
private class PaddedIterator[A](source: Iterator[A], total: int, element: A, private var given: int): Iterator[A]
    override hasNext() -> bool = given < total || source.hasNext()

    override next() -> A
        val x = if source.hasNext() then source.next() elif given < total then element else fail("next on an exhausted iterator")
        if given < total then given += 1
        x

private class TappedIterator[A](source: Iterator[A], f: (A) -> unit): Iterator[A]
    override hasNext() -> bool = source.hasNext()

    override next() -> A
        val x = source.next()
        f(x)
        x

private class EmptyIterator[A](): Iterator[A]
    override hasNext() -> bool = false

    override next() -> A = fail("next on an exhausted iterator")

private class SingleIterator[A](element: A, private var used: bool): Iterator[A]
    override hasNext() -> bool = !used

    override next() -> A
        if used then fail("next on an exhausted iterator")
        used = true
        element

// Gives `current`, then replaces it by `f` of it before each element after the first.
private class IteratedIterator[A](private var current: A, f: (A) -> A, private var started: bool): Iterator[A]
    override hasNext() -> bool = true

    override next() -> A
        if started then current = f(current) else started = true
        current

// Holds the element `f` gave once `hasNext()` has asked for it, and stops at the first `None`.
private class UnfoldedIterator[A, S](private var state: S, f: (S) -> Option[(A, S)], private var found: Option[A], private var done: bool): Iterator[A]
    override hasNext() -> bool
        if found.isDefined then return true
        if done then return false
        f(state) match
            Some((x, next)) ->
                found = Some(x)
                state = next
            None -> done = true
        found.isDefined

    override next() -> A
        hasNext()
        found match
            Some(x) ->
                found = None
                x
            None -> fail("next on an exhausted iterator")

private class ContinualIterator[A](element: () -> A): Iterator[A]
    override hasNext() -> bool = true

    override next() -> A = element()

// Gives `current`, then adds `step` to it before each element after the first.
private class CountingIterator[T: Integer](private var current: T, step: T, private var started: bool): Iterator[T]
    override hasNext() -> bool = true

    override next() -> T
        if started then current = current + step else started = true
        current
