module avin

// What can be traversed: every collection, and every iterator. `iterator()` hands out an iterator
// over the elements; a collection makes a fresh one each time, so it can be traversed again, while an
// iterator returns itself, so traversing it consumes it. Code generic over `Iterable` therefore
// traverses its input once.
trait Iterable[+A]
    iterator() -> Iterator[A]

// A single pass over a sequence of elements. `hasNext()` says whether another element remains, and
// `next()` yields it and moves past it; `next()` on an iterator with no element left traps.
trait Iterator[+A]: Iterable[A]
    hasNext() -> bool
    next() -> A
    override iterator() -> Iterator[A] = self

// Every collection and iterator. Traversing an iterator consumes it.
impl[A] Iterable[A]
    // `pf` of the first element it is defined at, or `None` when it is defined at none; the elements
    // after that one are not reached.
    collectFirst[B](pf: PartialFunction[A, B]) -> Option[B]
        val f = pf.lift()
        val it = iterator()
        while it.hasNext()
            val found = f(it.next())
            if found.isSome() then return found
        None

// Every collection of elements that add has the total of them, an empty one `T.zero()`. Overflow traps
// as `+` does; a string collection concatenates. Traversing an iterator consumes it.
impl[T: Add] Iterable[T]
    sum() -> T
        var total = T.zero()
        val it = iterator()
        while it.hasNext() do total = total + it.next()
        total

// Every collection of elements that multiply has the product of them, an empty one `T.one()`.
impl[T: Mul] Iterable[T]
    product() -> T
        var total = T.one()
        val it = iterator()
        while it.hasNext() do total = total * it.next()
        total

// Every collection of pairs makes a map, binding each first part to its second; a key that comes
// again replaces the value it had. The keys are bounded as a map's are.
impl[K: Eq + Hash, V] Iterable[(K, V)]
    toMap() -> Map[K, V]
        val b = Map.builder[K, V]()
        val it = iterator()
        while it.hasNext() do b.add(it.next())
        b.result()

