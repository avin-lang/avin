module avin.random

// Pseudo-random numbers from PCG32 (PCG-XSH-RR: 64 bits of state, 32 bits of output). A generator made
// with a seed gives the same numbers on every platform and in every release; one made without is
// seeded by the platform. None of it is fit for secrets: a few outputs give away the rest.

import avin.math.{log, sqrt}
import avin.threads.Mutex

// A seed from the platform's entropy, different for every call.
@sysl("avin.rt.random_seed")
private platformSeed() -> long

// The published PCG multiplier.
private val Multiplier: long = 6364136223846793005

// The stream every generator uses: the reference implementation's demonstration stream, 54, made odd
// as an increment. With it, `Random(42)` gives the published sequence.
private val Increment: long = 109

// 2^64, the number of values a 64-bit draw takes.
private val TwoTo64: i128 = i128(1) << 64

// `x` shifted right by `k` bits with zeros coming in at the top, for `k` from 1 to 63.
private shiftRight(x: long, k: long) -> long = (x >> k) & ((long(1) << (64 - k)) -% 1)

// The 32 bits of `x` rotated right by `k`, for `k` from 0 to 31.
private rotateRight(x: int, k: int) -> int = ((x >> k) & ((1 << (32 - k)) -% 1)) | (x << ((32 - k) & 31))

// The state after one step from `state`.
private advance(state: long) -> long = state *% Multiplier +% Increment

// The 32 bits a step from `state` gives: the state's high bits folded down by an xorshift and rotated
// by its top five.
private output(state: long) -> int =
    rotateRight(int.wrap(shiftRight(shiftRight(state, 18) ^ state, 27)), int(shiftRight(state, 59)))

// The state of a generator seeded with `seed`, as the reference implementation makes it: one step
// from zero, the seed added, and one step more.
private seededState(seed: long) -> long = advance(advance(0) +% seed)

// The 62 characters `alphanumeric` draws from, in code point order.
private val AlphanumericChars: string = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

// A pseudo-random generator: every number it gives follows from its seed. It takes no lock, so threads
// that share one share it through a `Mutex`; the companion's methods use one shared generator that
// is safe from any thread.
//
//     val dice = Random(42)
//     println(dice.between(1, 7))
class Random(seed: long)
    private var state: long = seededState(seed)
    private var spareGaussian: real = 0.0
    private var hasSpareGaussian: bool = false

    // Starts the generator again as `Random(seed)` would.
    setSeed(seed: long)
        state = seededState(seed)
        hasSpareGaussian = false

    // Advances the state and gives the 32 bits of output the old state makes.
    private step() -> int
        val old = state
        state = advance(old)
        output(old)

    // Any `int`, each equally likely.
    nextInt() -> int = step()

    // Any `long`, each equally likely: two draws, the first the high half.
    nextLong() -> long
        val high = long(step())
        val low = long(step()) & 0xFFFFFFFF
        (high << 32) | low

    // From `0` up to `bound`, not including it, each equally likely; a bound that is not positive traps.
    nextInt(bound: int) -> int
        if bound <= 0 then fail(s"Random.nextInt: bound must be positive, was ${bound}")
        val n = long(bound)
        val threshold = (long(1) << 32) % n
        var r = long(step()) & 0xFFFFFFFF
        while r < threshold do r = long(step()) & 0xFFFFFFFF
        int(r % n)

    // From `0` up to `bound`, not including it, each equally likely; a bound that is not positive traps.
    nextLong(bound: long) -> long
        if bound <= 0 then fail(s"Random.nextLong: bound must be positive, was ${bound}")
        long(below(i128(bound)))

    // From `0` up to `n`, not including it, for `n` from 1 to 2^64: a 64-bit draw, the draws below
    // `2^64 % n` rejected so that every value is equally likely.
    private below(n: i128) -> i128
        val threshold = TwoTo64 % n
        var r = i128(nextLong()) & (TwoTo64 - 1)
        while r < threshold do r = i128(nextLong()) & (TwoTo64 - 1)
        r % n

    // From `min` up to `max`, not including it, each equally likely; `min >= max` traps.
    between(min: int, max: int) -> int
        if min >= max then fail(s"Random.between: min must be less than max, was ${min} and ${max}")
        val span = long(max) - long(min)
        if span <= long(int.MaxValue) then min + nextInt(int(span)) else int(long(min) + nextLong(span))

    // From `min` up to `max`, not including it, each equally likely; `min >= max` traps.
    between(min: long, max: long) -> long
        if min >= max then fail(s"Random.between: min must be less than max, was ${min} and ${max}")
        long(i128(min) + below(i128(max) - i128(min)))

    // From `min` up to `max`, not including it; `min >= max` traps, and so does a NaN bound or a
    // distance between them too large for a `real`.
    between(min: real, max: real) -> real
        if !(min < max) then fail(s"Random.between: min must be less than max, was ${min} and ${max}")
        val span = max - min
        if span == real.PositiveInfinity then fail(s"Random.between: the distance from ${min} to ${max} is too large")
        var r = min + nextReal() * span
        while r >= max do r = min + nextReal() * span
        r

    // From `0.0` up to `1.0`, not including it, every multiple of 2^-53 equally likely.
    nextReal() -> real = real(shiftRight(nextLong(), 11)) / 9007199254740992.0

    // `true` or `false`, equally likely: the top bit of a draw.
    nextBoolean() -> bool = step() < 0

    // Normally distributed, mean `0.0` and standard deviation `1.0`. The polar method makes two at a
    // time; the second is kept for the next call.
    nextGaussian() -> real
        if hasSpareGaussian
            hasSpareGaussian = false
            return spareGaussian
        var v1 = 0.0
        var v2 = 0.0
        var s = 0.0
        while s >= 1.0 || s == 0.0
            v1 = 2.0 * nextReal() - 1.0
            v2 = 2.0 * nextReal() - 1.0
            s = v1 * v1 + v2 * v2
        val multiplier = sqrt(-2.0 * log(s) / s)
        spareGaussian = v2 * multiplier
        hasSpareGaussian = true
        v1 * multiplier

    // A new array of `n` bytes, four from each draw, lowest first; a negative `n` traps.
    nextBytes(n: int) -> Array[byte]
        if n < 0 then fail(s"Random.nextBytes: count must not be negative, was ${n}")
        var draw = 0
        Array.tabulate(n, i ->
            if i % 4 == 0 then draw = step()
            byte((draw >> (8 * (i % 4))) & 0xFF))

    // An endless run of characters from `A`–`Z`, `a`–`z` and `0`–`9`, equally likely, each drawn from
    // this generator as it is read.
    alphanumeric() -> Iterator[char] = Alphanumeric(() -> nextInt(62))

    // The elements in a new order, every order equally likely: Fisher-Yates, from the last position
    // down, each taking an element from those at or before it.
    shuffle[T](xs: Iterable[T]) -> Vector[T]
        val a = xs.toArray()
        var i = a.length()
        while i > 1
            i -= 1
            val j = nextInt(i + 1)
            val x = a(i)
            a(i) = a(j)
            a(j) = x
        a.toVector()

// The endless characters of `alphanumeric`, each from an index `draw` gives.
private class Alphanumeric(private val draw: () -> int): Iterator[char]
    override hasNext() -> bool = true
    override next() -> char = AlphanumericChars.charAt(draw())

// The generator the program shares, seeded by the platform when it is first used.
private lazy val shared: Mutex[Random] = Mutex(Random(platformSeed()))

// `Random()` is a generator seeded by the platform; every other method is the one on the generator
// the program shares, which is safe to call from any thread.
object Random
    // A generator seeded by the platform, differently each time.
    apply() -> Random = Random(platformSeed())

    nextInt() -> int = shared.with(g -> g.nextInt())
    nextLong() -> long = shared.with(g -> g.nextLong())
    nextInt(bound: int) -> int = shared.with(g -> g.nextInt(bound))
    nextLong(bound: long) -> long = shared.with(g -> g.nextLong(bound))
    between(min: int, max: int) -> int = shared.with(g -> g.between(min, max))
    between(min: long, max: long) -> long = shared.with(g -> g.between(min, max))
    between(min: real, max: real) -> real = shared.with(g -> g.between(min, max))
    nextReal() -> real = shared.with(g -> g.nextReal())
    nextBoolean() -> bool = shared.with(g -> g.nextBoolean())
    nextGaussian() -> real = shared.with(g -> g.nextGaussian())
    nextBytes(n: int) -> Array[byte] = shared.with(g -> g.nextBytes(n))
    alphanumeric() -> Iterator[char] = Alphanumeric(() -> shared.with(g -> g.nextInt(62)))
    shuffle[T](xs: Iterable[T]) -> Vector[T] = shared.with(g -> g.shuffle(xs))

    // Starts the shared generator again as `Random(seed)` would, so the companion's numbers replay.
    setSeed(seed: long)
        shared.with(g -> g.setSeed(seed))
