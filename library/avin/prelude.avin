module avin

// Writes nothing to standard output.
print()
    ()

// Writes `value` to standard output, with no new line, as `s"$value"` would show it: by its type's
// `Display`, or, for a type with none, by the type's name.
print(value: Any)
    value.display(StandardOutput, FormatSpec())

// Writes the values, each shown as `print(value)` shows it, separated by `, `, to standard output, with
// no new line.
print(first: Any, second: Any, rest: Any*)
    first.display(StandardOutput, FormatSpec())
    StandardOutput.write(", ")
    second.display(StandardOutput, FormatSpec())
    for value in rest
        StandardOutput.write(", ")
        value.display(StandardOutput, FormatSpec())

// Writes a new line to standard output.
println()
    StandardOutput.write("\n")

// Writes `value`, shown as `print(value)` shows it, and a new line to standard output.
println(value: Any)
    value.display(StandardOutput, FormatSpec())
    StandardOutput.write("\n")

// Writes the values, each shown as `print(value)` shows it, separated by `, `, and a new line to standard
// output.
println(first: Any, second: Any, rest: Any*)
    first.display(StandardOutput, FormatSpec())
    StandardOutput.write(", ")
    second.display(StandardOutput, FormatSpec())
    for value in rest
        StandardOutput.write(", ")
        value.display(StandardOutput, FormatSpec())
    StandardOutput.write("\n")

// Writes nothing to standard error.
eprint()
    ()

// Writes `value`, shown as `print(value)` shows it, to standard error, with no new line, in one write,
// after flushing what has been written to standard output.
eprint(value: Any)
    val out = StringWriter()
    value.display(out, FormatSpec())
    StandardError.write(out.text())

// Writes the values, each shown as `print(value)` shows it, separated by `, `, to standard error, with
// no new line, in one write.
eprint(first: Any, second: Any, rest: Any*)
    val out = StringWriter()
    first.display(out, FormatSpec())
    out.write(", ")
    second.display(out, FormatSpec())
    for value in rest
        out.write(", ")
        value.display(out, FormatSpec())
    StandardError.write(out.text())

// Writes a new line to standard error.
eprintln()
    StandardError.write("\n")

// Writes `value`, shown as `print(value)` shows it, and a new line to standard error, in one write,
// after flushing what has been written to standard output.
eprintln(value: Any)
    val out = StringWriter()
    value.display(out, FormatSpec())
    out.write("\n")
    StandardError.write(out.text())

// Writes the values, each shown as `print(value)` shows it, separated by `, `, and a new line to
// standard error, in one write.
eprintln(first: Any, second: Any, rest: Any*)
    val out = StringWriter()
    first.display(out, FormatSpec())
    out.write(", ")
    second.display(out, FormatSpec())
    for value in rest
        out.write(", ")
        value.display(out, FormatSpec())
    out.write("\n")
    StandardError.write(out.text())

// `value`'s `Debug` form as a string; `println(debug(x))` prints it.
debug[T: Debug](value: T) -> string
    val out = StringWriter()
    value.debug(out, FormatSpec())
    out.text()
