module avin

// Writes `value`'s `Display` form and a new line to standard output.
print[T: Display](value: T)
    value.display(StandardOutput, FormatSpec())
    StandardOutput.write("\n")

// Writes `value`'s `Display` form and a new line to standard error, in one write, after flushing what
// has been written to standard output.
eprint[T: Display](value: T)
    val out = StringWriter()
    value.display(out, FormatSpec())
    out.write("\n")
    StandardError.write(out.text())

// `value`'s `Debug` form as a string; `print(debug(x))` prints it.
debug[T: Debug](value: T) -> string
    val out = StringWriter()
    value.debug(out, FormatSpec())
    out.text()
