module avin

// Writes `values` to `out`, separated by `, `, each as `s"$value"` would show an `Any`: by its type's
// `Display`, or, for a type with none, by the type's name.
private writeValues(out: Writer, values: Vector[Any])
    var first = true
    for value in values
        if !first then out.write(", ")
        value.display(out, FormatSpec())
        first = false

// Writes the values, separated by `, `, to standard output, with no new line: nothing for none, and
// one value as it is shown alone.
print(values: Any*)
    writeValues(StandardOutput, values)

// Writes the values, separated by `, `, and a new line to standard output: just the new line for none.
println(values: Any*)
    writeValues(StandardOutput, values)
    StandardOutput.write("\n")

// Sends everything written to standard output so far on its way, a partial line included, so a
// program that draws without ending lines can show what it has drawn.
flush() = StandardOutput.flush()

// Writes the values, separated by `, `, to standard error, with no new line, in one write, after
// flushing what has been written to standard output; nothing for none.
eprint(values: Any*)
    if values.isEmpty then return
    val out = StringWriter()
    writeValues(out, values)
    StandardError.write(out.text)

// Writes the values, separated by `, `, and a new line to standard error, in one write, after flushing
// what has been written to standard output.
eprintln(values: Any*)
    val out = StringWriter()
    writeValues(out, values)
    out.write("\n")
    StandardError.write(out.text)

// `value`'s `Debug` form as a string; `println(debug(x))` prints it.
debug[T: Debug](value: T) -> string
    val out = StringWriter()
    value.debug(out, FormatSpec())
    out.text
