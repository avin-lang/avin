module avin

// Writes nothing to standard output.
print()
    ()

// Writes `value`'s `Display` form to standard output, with no new line.
print[T: Display](value: T)
    value.display(StandardOutput, FormatSpec())

// Writes the values' `Display` forms, separated by `, `, to standard output, with no new line.
print(first: Display, second: Display, rest: Display*)
    first.display(StandardOutput, FormatSpec())
    StandardOutput.write(", ")
    second.display(StandardOutput, FormatSpec())
    for value in rest
        StandardOutput.write(", ")
        value.display(StandardOutput, FormatSpec())

// Writes a new line to standard output.
println()
    StandardOutput.write("\n")

// Writes `value`'s `Display` form and a new line to standard output.
println[T: Display](value: T)
    value.display(StandardOutput, FormatSpec())
    StandardOutput.write("\n")

// Writes the values' `Display` forms, separated by `, `, and a new line to standard output.
println(first: Display, second: Display, rest: Display*)
    first.display(StandardOutput, FormatSpec())
    StandardOutput.write(", ")
    second.display(StandardOutput, FormatSpec())
    for value in rest
        StandardOutput.write(", ")
        value.display(StandardOutput, FormatSpec())
    StandardOutput.write("\n")

// Writes nothing to standard error.
eprint()
    ()

// Writes `value`'s `Display` form to standard error, with no new line, in one write, after flushing what
// has been written to standard output.
eprint[T: Display](value: T)
    val out = StringWriter()
    value.display(out, FormatSpec())
    StandardError.write(out.text())

// Writes the values' `Display` forms, separated by `, `, to standard error, with no new line, in one write.
eprint(first: Display, second: Display, rest: Display*)
    val out = StringWriter()
    first.display(out, FormatSpec())
    out.write(", ")
    second.display(out, FormatSpec())
    for value in rest
        out.write(", ")
        value.display(out, FormatSpec())
    StandardError.write(out.text())

// Writes a new line to standard error.
eprintln()
    StandardError.write("\n")

// Writes `value`'s `Display` form and a new line to standard error, in one write, after flushing what
// has been written to standard output.
eprintln[T: Display](value: T)
    val out = StringWriter()
    value.display(out, FormatSpec())
    out.write("\n")
    StandardError.write(out.text())

// Writes the values' `Display` forms, separated by `, `, and a new line to standard error, in one write.
eprintln(first: Display, second: Display, rest: Display*)
    val out = StringWriter()
    first.display(out, FormatSpec())
    out.write(", ")
    second.display(out, FormatSpec())
    for value in rest
        out.write(", ")
        value.display(out, FormatSpec())
    out.write("\n")
    StandardError.write(out.text())

// `value`'s `Debug` form as a string; `println(debug(x))` prints it.
debug[T: Debug](value: T) -> string
    val out = StringWriter()
    value.debug(out, FormatSpec())
    out.text()
