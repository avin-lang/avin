module avin.c

// Bytes that cross a C binding in place, without a copy. A `ByteView` reads memory a C handle lends,
// pixels or samples it owns, and a `MutByteView` writes it too; both are valid until the handle that
// lent them is used again, by any of its bound methods or its `close()`, which closes them first. A
// `ByteBlock` is memory Avin gives C: a fixed number of zeroed bytes outside the collected heap, whose
// address never moves, so C may keep it and write into it, freed once nothing reaches it.
//
// Every operation first checks that the code running may use the bytes, which belong to the code that
// owns the handle that lent them, or to the code that made the block; then that a view is still open;
// then that every index falls inside. A failed check stops the program at the call, a closed view
// naming its lender: "the `ByteView` of `Frame` was closed when `Frame` was used again".

// Bytes C lends, read in place. A binding marked `view` makes one; its own constructor makes an empty
// view of no memory.
open class ByteView: Sendable
  // How many bytes there are.
  @intrinsic("c_view_length")
  length -> int

  // The byte at `index`, which traps outside `0 ..< length()`.
  @intrinsic("c_view_apply")
  apply(index: int) -> byte

  // A new array of the bytes from `from` up to `until`, which traps when the indices are not in
  // order within the view.
  @intrinsic("c_view_slice")
  slice(from: int, until: int) -> Array[byte]

  // A new array of every byte.
  copy() -> Array[byte] = slice(0, length)

// Bytes C lends that Avin may also write, made by a binding marked `view` and `writable`. Whether C
// sees what was written is the library's own protocol, such as telling C the memory is dirty, which,
// being a use of the lender, closes the view.
open class MutByteView: ByteView
  // Replaces the byte at `index`, which traps outside `0 ..< length()`.
  @intrinsic("c_view_update")
  update(index: int, value: byte)

  // Sets every byte from `from` up to `until` to `value`, which traps when the indices are not in
  // order within the view.
  @intrinsic("c_view_fill")
  fill(from: int, until: int, value: byte)

  // Copies `bytes` in, the first at `at`, which traps unless every one falls inside.
  @intrinsic("c_view_write")
  write(at: int, bytes: Array[byte])

// Memory Avin gives C: `ByteBlock(length)` zeroed bytes outside the collected heap, read and written in
// place, passed to C where a prototype names a byte pointer without being copied, and kept by C through
// `keeps:`. It belongs to the code that made it, and moves between threads as a handle does. Its own
// constructor, with no length, makes a block of no bytes.
class ByteBlock: MutByteView

object ByteBlock
  // A block of `length` zeroed bytes; a negative length traps.
  apply(length: int) -> ByteBlock = blockNew(length)

@intrinsic("c_block_new")
private blockNew(length: int) -> ByteBlock
