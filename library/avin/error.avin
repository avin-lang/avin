module avin

// A failure to report to a person: a sentence saying what went wrong, and the failure that caused
// it, if one did. Every error type of the standard library is an `Error`, and a type of a program's
// own becomes one by giving it a `message`.
//
// An error shows as its message followed by each cause's, joined by `: `, so a failure wrapped in
// context reads from the outermost step in: `loading config: cannot read app.conf: no such file or
// directory`.
trait Error: Display
  // What went wrong, as this error's own sentence, without its cause's.
  message -> string

  // The failure this one was caused by, or `None` where it is the first.
  cause -> Option[Error] = None

  // The message, then `: ` and the cause as it shows, which is its own message and causes; a
  // message that is empty is left out with its separator.
  override display(out: Writer, spec: FormatSpec)
    val text = cause match
      Some(c) -> if message == "" then s"$c" else s"$message: $c"
      None -> message
    out.writeField(text, spec)

// An error put in context: a sentence saying what was being done, and the error that stopped it.
// `Result.context` makes one, and it shows as the sentence, then the error it wraps:
// `loading config: cannot read app.conf: no such file or directory`. The error wrapped is its
// `cause`, which a program may match on by type: `e.cause` is `Some(io: IoError)`.
data ContextError(message: string, inner: Error)

impl Error for ContextError
  cause -> Option[Error] = Some(inner)

// A result whose error is an `Error` may have that error put in context.
impl[T, E: Error] Result[T, E]
  // This result, its error wrapped in a `ContextError` saying what was being done:
  // `fs.readText(path).context(s"loading $path")?`. The text is passed by name, so it is built
  // only for an `Err`.
  context(text: -> string) -> Result[T, ContextError] = self match
    Ok(v) -> Ok(v)
    Err(e) -> Err(ContextError(text, e))
