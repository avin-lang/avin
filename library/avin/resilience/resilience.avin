module avin.resilience

// Keeping a program working while what it depends on fails for a while: `retry` runs work again after
// a growing, spread-out delay, within the deadline the calling code runs under; a `CircuitBreaker`
// stops calling what keeps failing, and lets a trial call through once it has had time to recover; a
// `RateLimiter` holds work to a rate. Each reads the time and draws its randomness through a function
// it is given, the monotonic clock, `threads.sleep` and the shared generator by default, so a test can
// drive them on time of its own, without waiting.

import avin.random.Random
import avin.time.Duration

// Reads the time: a monotonic clock, `time.monotonic` unless given another.
type Clock = @sendable () -> Duration

// Waits for a duration: `threads.sleep` unless given another.
type Pause = @sendable (Duration) -> unit

// Draws a number at least zero and less than one, each as likely as another.
type Uniform = @sendable () -> real

// The shared generator's `nextReal`, the draw a retry policy spreads its delays with unless given
// another.
uniform() -> real = Random.nextReal()
