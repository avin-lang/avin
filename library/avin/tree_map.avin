module avin

// The sorted immutable map, kept in the order of its keys' `compare`, so any `Ord` type can be a key;
// values are covariant, as every `Map`'s are. It is a `SortedMap`, and so a `Map`. An update answers a
// new tree map that shares all but the changed path with the old one, which is left as it was.
// Iteration visits the entries in ascending order of their keys, and the ordered operations — the
// first and last entries, the nearest entry to a key, and the entries from, to, until or between keys —
// take time in the logarithm of the size. `TreeMap.empty[K, V]()` is the empty map, and
// `TreeMap.newBuilder[K, V]()` builds one from pairs.
data TreeMap[K: Ord, +V](root: SortedTree[K, V] = Tip)

impl[K, V] SortedMap[K, V] for TreeMap[K, V]
    size() -> int = treeSize(root)

    isEmpty() -> bool = root is Tip

    nonEmpty() -> bool = !isEmpty()

    get(key: K) -> Option[V] = treeFind(root, key)

    updated[W >: V](key: K, value: W) -> TreeMap[K, W] = TreeMap(treeInsert[K, W](root, key, value))

    removed(key: K) -> TreeMap[K, V] =
        if treeFind(root, key) is None then self else TreeMap(treeRemove(root, key))

    ++[W >: V](other: Iterable[(K, W)]) -> TreeMap[K, W]
        var t: SortedTree[K, W] = root
        for (k, v) in other do t = treeInsert(t, k, v)
        TreeMap(t)

    --(keys: Iterable[K]) -> TreeMap[K, V]
        var t = root
        for k in keys
            if treeFind(t, k) is Some(_) then t = treeRemove(t, k)
        TreeMap(t)

    updatedWith[W >: V](key: K, f: (Option[V]) -> Option[W]) -> TreeMap[K, W] = f(get(key)) match
        Some(v) -> updated(key, v)
        None -> removed(key)

    keysIterator() -> Iterator[K] = MapKeys(SortedTreeIterator(root, false))

    valuesIterator() -> Iterator[V] = MapValues(SortedTreeIterator(root, false))

    keySet() -> TreeSet[K] = TreeSet(treeTransform(root, (k, v) -> ()))

    filterKeys(p: (K) -> bool) -> TreeMap[K, V] = TreeMap(treeFilter(root, (k, v) -> p(k)))

    filter(p: (K, V) -> bool) -> TreeMap[K, V] = TreeMap(treeFilter(root, p))

    // The same keys, each bound to `f` of the key and its value, called in key order.
    transform[W](f: (K, V) -> W) -> TreeMap[K, W] = TreeMap(treeTransform(root, f))

    mapValues[W](f: (V) -> W) -> TreeMap[K, W] = TreeMap(treeTransform(root, (k, v) -> f(v)))

    // The entries in ascending order of their keys.
    iterator() -> Iterator[(K, V)] = SortedTreeIterator(root, false)

    reverseIterator() -> Iterator[(K, V)] = SortedTreeIterator(root, true)

    override headOption() -> Option[(K, V)] = treeFirst(root)

    override lastOption() -> Option[(K, V)] = treeLast(root)

    minAfter(key: K) -> Option[(K, V)] = treeMinAfter(root, key)

    maxBefore(key: K) -> Option[(K, V)] = treeMaxBefore(root, key)

    rangeFrom(low: K) -> TreeMap[K, V] = TreeMap(treeFrom(root, low))

    rangeTo(high: K) -> TreeMap[K, V] = TreeMap(treeTo(root, high))

    rangeUntil(high: K) -> TreeMap[K, V] = TreeMap(treeUntil(root, high))

    range(low: K, high: K) -> TreeMap[K, V] = TreeMap(treeUntil(treeFrom(root, low), high))

// A tree map's own versions of the methods every map has that make keys of another type: they build
// tree maps, so the new keys are bounded by `Ord`.
impl[K, V] TreeMap[K, V]
    // The entries whose key and value satisfy `p` and those that do not, as two tree maps; `p` is
    // called once for each entry, in key order.
    partition(p: (K, V) -> bool) -> (TreeMap[K, V], TreeMap[K, V])
        var yes = self
        var no = self
        for (k, v) in iterator()
            if p(k, v) then no = no.removed(k) else yes = yes.removed(k)
        (yes, no)

    // The map of the pairs `f` makes of each entry; where two make the same key, the later one's
    // value, in this map's order, is kept.
    map[L: Ord, W](f: (K, V) -> (L, W)) -> TreeMap[L, W]
        var t: SortedTree[L, W] = Tip
        for (k, v) in iterator()
            val (l, w) = f(k, v)
            t = treeInsert(t, l, w)
        TreeMap(t)

    // The map of the pairs `f` makes of each entry, given as a pair, as a `for` with `yield` gives
    // it; where two make the same key, the later one's value is kept.
    map[L: Ord, W](f: ((K, V)) -> (L, W)) -> TreeMap[L, W]
        var t: SortedTree[L, W] = Tip
        for entry in iterator()
            val (l, w) = f(entry)
            t = treeInsert(t, l, w)
        TreeMap(t)

    // The map of the pairs `pf` makes of each entry it is defined at; where two make the same key,
    // the later one's value is kept.
    collect[L: Ord, W](pf: PartialFunction[(K, V), (L, W)]) -> TreeMap[L, W]
        val f = pf.lift()
        var t: SortedTree[L, W] = Tip
        for entry in iterator()
            if f(entry) is Some((l, w)) then t = treeInsert(t, l, w)
        TreeMap(t)

    // The map of the pairs in the collections `f` makes of each entry; where two make the same key,
    // the later one's value is kept.
    flatMap[L: Ord, W](f: ((K, V)) -> Iterable[(L, W)]) -> TreeMap[L, W]
        var t: SortedTree[L, W] = Tip
        for entry in iterator()
            for (l, w) in f(entry) do t = treeInsert(t, l, w)
        TreeMap(t)

    // The entries that satisfy `p`, tested only as `map`, `flatMap` or `foreach` reaches each one.
    withFilter(p: ((K, V)) -> bool) -> FilteredTreeMap[K, V] = FilteredTreeMap(self, p)

// Two tree maps visit equal keys in the same order, so they are compared entry by entry in step.
impl[K, V: Eq] Eq for TreeMap[K, V]
    equals(other: TreeMap[K, V]) -> bool
        if size() != other.size() then return false
        val theirs = other.iterator()
        for (k, v) in iterator()
            val (j, w) = theirs.next()
            if k != j || v != w then return false
        true

// The sum a `HashMap` of the same entries hashes to, so that the hash does not depend on the order
// the entries are visited in.
impl[K: Hash, V: Hash] Hash for TreeMap[K, V]
    hash() -> long
        var h: long = 0
        for (k, v) in iterator() do h = h +% spreadHash(k.hash() *% 31 +% v.hash())
        h

// A tree map displays as a map does, `{a: 1, b: 2}`, in key order. A field width pads the whole.
impl[K: Display, V: Display] Display for TreeMap[K, V]
    display(out: Writer, spec: FormatSpec)
        writeEntry(w: Writer, entry: (K, V))
            entry.0.display(w, FormatSpec())
            w.write(": ")
            entry.1.display(w, FormatSpec())
        writeBraced(out, spec, iterator(), writeEntry)

// A tree map's diagnostic form is its keys' and values' diagnostic forms in braces: `{"a": 1}`.
impl[K: Debug, V: Debug] Debug for TreeMap[K, V]
    debug(out: Writer, spec: FormatSpec)
        writeEntry(w: Writer, entry: (K, V))
            entry.0.debug(w, FormatSpec())
            w.write(": ")
            entry.1.debug(w, FormatSpec())
        writeBraced(out, spec, iterator(), writeEntry)

object TreeMap
    // A tree map with no entries.
    empty[K: Ord, V]() -> TreeMap[K, V] = TreeMap(Tip)

    // A tree map of the pairs given, a later pair's value replacing an earlier one's for the same
    // key: `TreeMap((2, "two"), (1, "one"))`.
    apply[K: Ord, V](pairs: (K, V)*) -> TreeMap[K, V]
        var t: SortedTree[K, V] = Tip
        for (k, v) in pairs do t = treeInsert(t, k, v)
        TreeMap(t)

    // A tree map of the pairs of `pairs`, in any order, a later pair's value replacing an earlier
    // one's for the same key.
    from[K: Ord, V](pairs: Iterable[(K, V)]) -> TreeMap[K, V]
        val b = TreeMapBuilder[K, V]()
        b.addAll(pairs)
        b.result()

    // A builder of a tree map: the pairs it is given, a later pair's value replacing an earlier one's
    // for the same key. It is typed as a `Builder` of tree maps, so a literal where a `TreeMap[K, V]`
    // is expected gives the call its `K`, which must be known there to be held to its bound.
    newBuilder[K: Ord, V]() -> Builder[(K, V), TreeMap[K, V]] = TreeMapBuilder[K, V]()

// Builds a tree map from `(key, value)` pairs.
class TreeMapBuilder[K: Ord, V]: Builder[(K, V), TreeMap[K, V]]
    private var tree: SortedTree[K, V] = Tip
    private var spent = false

    override addOne(element: (K, V))
        if spent then fail("add to a builder whose result was taken")
        val (k, v) = element
        tree = treeInsert(tree, k, v)

    override result() -> TreeMap[K, V]
        if spent then fail("result of a builder whose result was taken")
        spent = true
        TreeMap(tree)

    override clear()
        tree = Tip
        spent = false

// A tree map seen through a test of its entries, which a guard of a `for` with `yield` makes: each
// entry is tested just before the call after it would use it, in key order.
class FilteredTreeMap[K: Ord, V](private val source: TreeMap[K, V], private val p: ((K, V)) -> bool)
    // The map of the pairs `f` makes of each entry that passes the test.
    map[L: Ord, W](f: ((K, V)) -> (L, W)) -> TreeMap[L, W]
        var t: SortedTree[L, W] = Tip
        for entry in source
            if p(entry)
                val (l, w) = f(entry)
                t = treeInsert(t, l, w)
        TreeMap(t)

    // The map of the pairs in the collections `f` makes of each entry that passes the test.
    flatMap[L: Ord, W](f: ((K, V)) -> Iterable[(L, W)]) -> TreeMap[L, W]
        var t: SortedTree[L, W] = Tip
        for entry in source
            if p(entry)
                for (l, w) in f(entry) do t = treeInsert(t, l, w)
        TreeMap(t)

    // The entries that pass this test and then `q`.
    withFilter(q: ((K, V)) -> bool) -> FilteredTreeMap[K, V] =
        FilteredTreeMap(source, e -> p(e) && q(e))

    // Calls `f` with each entry that passes the test.
    foreach(f: ((K, V)) -> unit)
        for entry in source
            if p(entry) then f(entry)
