module avin

// An immutable map from keys to values, each key present at most once, kept in the order of its keys'
// `compare`, so any `Ord` type can be a key; values are covariant, as a `Map`'s are. An update returns
// a new map that shares all but the changed path with the old one, which is left as it was. Iteration
// visits the entries in ascending order of their keys, and the ordered operations — the first and
// last entries, the nearest entry to a key, and the entries from, until or between keys — take time
// in the logarithm of the size. Two tree maps are equal when they hold the same keys bound to equal
// values. `TreeMap.empty[K, V]()` is the empty map, and `TreeMap.builder[K, V]()` builds one from
// pairs.
data TreeMap[K: Ord, +V](root: SortedTree[K, V] = Tip)

impl[K, V] TreeMap[K, V]
    // The number of entries.
    size() -> int = treeSize(root)

    isEmpty() -> bool = root is Tip

    nonEmpty() -> bool = !isEmpty()

    // The value bound to `key`, or `None` when there is none.
    get(key: K) -> Option[V] = treeFind(root, key)

    // The value bound to `key`, which traps when there is none.
    apply(key: K) -> V = get(key) match
        Some(v) -> v
        None -> fail("key not found in the map")

    // The value bound to `key`, or `default`, which is evaluated only when there is none.
    getOrElse(key: K, default: -> V) -> V = get(key) match
        Some(v) -> v
        None -> default

    contains(key: K) -> bool = get(key) is Some(_)

    // This map with `key` bound to `value`, replacing the value it had.
    updated(key: K, value: V) -> TreeMap[K, V] = TreeMap(treeInsert(root, key, value))

    // This map without `key`; the same map when `key` is absent.
    removed(key: K) -> TreeMap[K, V] =
        if treeFind(root, key) is None then self else TreeMap(treeRemove(root, key))

    // This map with every entry of `other` added: `m ++ other`. `other` may be any collection of
    // `(key, value)` pairs; for a key it repeats, the last pair wins.
    ++(other: Iterable[(K, V)]) -> TreeMap[K, V]
        var t = root
        for (k, v) in other do t = treeInsert(t, k, v)
        TreeMap(t)

    // This map without any of `keys`; a key it lacks is ignored: `m -- ks`.
    --(keys: Iterable[K]) -> TreeMap[K, V]
        var t = root
        for k in keys
            if treeFind(t, k) is Some(_) then t = treeRemove(t, k)
        TreeMap(t)

    // This map with the value of `key` replaced by what `f` makes of the value it has now, or of
    // `None` when it has none: `Some(v)` binds `key` to `v` and `None` leaves it unbound.
    updatedWith(key: K, f: (Option[V]) -> Option[V]) -> TreeMap[K, V] = f(get(key)) match
        Some(v) -> updated(key, v)
        None -> removed(key)

    // The keys in ascending order, as a vector.
    keys() -> Vector[K] = keysIterator().toVector()

    // The values in the order of their keys, as a vector: the value at each index belongs to the key
    // at the same index of `keys()`.
    values() -> Vector[V] = valuesIterator().toVector()

    // The keys in ascending order, visited one at a time.
    keysIterator() -> Iterator[K] = MapKeys(SortedTreeIterator(root, false))

    // The values in the order of their keys, visited one at a time.
    valuesIterator() -> Iterator[V] = MapValues(SortedTreeIterator(root, false))

    // The set of the keys, in the same order.
    keySet() -> TreeSet[K] = TreeSet(treeTransform(root, (k, v) -> ()))

    // The entries in descending order of their keys, visited one at a time.
    reverseIterator() -> Iterator[(K, V)] = SortedTreeIterator(root, true)

    // The entry with the least key, or `None` when the map is empty.
    first() -> Option[(K, V)] = treeFirst(root)

    // The entry with the greatest key, or `None` when the map is empty.
    last() -> Option[(K, V)] = treeLast(root)

    // The entry with the greatest key at most `key`, or `None` when every key is greater.
    floor(key: K) -> Option[(K, V)] = treeFloor(root, key)

    // The entry with the least key at least `key`, or `None` when every key is less.
    ceiling(key: K) -> Option[(K, V)] = treeCeiling(root, key)

    // The entries whose keys are at least `low`.
    from(low: K) -> TreeMap[K, V] = TreeMap(treeFrom(root, low))

    // The entries whose keys are less than `high`.
    until(high: K) -> TreeMap[K, V] = TreeMap(treeUntil(root, high))

    // The entries whose keys are at least `low` and less than `high`; none when `high` is not greater
    // than `low`.
    range(low: K, high: K) -> TreeMap[K, V] = TreeMap(treeUntil(treeFrom(root, low), high))

    // The entries whose key satisfies `p`.
    filterKeys(p: (K) -> bool) -> TreeMap[K, V] = TreeMap(treeFilter(root, (k, v) -> p(k)))

    // The same keys, each bound to `f` of the key and its value, called in key order.
    transform[W](f: (K, V) -> W) -> TreeMap[K, W] = TreeMap(treeTransform(root, f))

    // Calls `f` with each key and its value, in key order.
    foreach(f: (K, V) -> unit)
        for (k, v) in iterator() do f(k, v)

    // The entries whose key and value satisfy `p`.
    filter(p: (K, V) -> bool) -> TreeMap[K, V] = TreeMap(treeFilter(root, p))

    // The map of the pairs `f` makes of each entry; where two make the same key, the later one's
    // value, in this map's order, is kept.
    map[L: Ord, W](f: (K, V) -> (L, W)) -> TreeMap[L, W]
        var t: SortedTree[L, W] = Tip
        for (k, v) in iterator()
            val (l, w) = f(k, v)
            t = treeInsert(t, l, w)
        TreeMap(t)

    // The map of the pairs `f` makes of each entry, given as a pair, as a `for` with `yield` gives
    // it; where two make the same key, the later one's value is kept.
    map[L: Ord, W](f: ((K, V)) -> (L, W)) -> TreeMap[L, W]
        var t: SortedTree[L, W] = Tip
        for entry in iterator()
            val (l, w) = f(entry)
            t = treeInsert(t, l, w)
        TreeMap(t)

    // The map of the pairs `pf` makes of each entry it is defined at; where two make the same key,
    // the later one's value is kept.
    collect[L: Ord, W](pf: PartialFunction[(K, V), (L, W)]) -> TreeMap[L, W]
        val f = pf.lift()
        var t: SortedTree[L, W] = Tip
        for entry in iterator()
            if f(entry) is Some((l, w)) then t = treeInsert(t, l, w)
        TreeMap(t)

    // The map of the pairs in the collections `f` makes of each entry; where two make the same key,
    // the later one's value is kept.
    flatMap[L: Ord, W](f: ((K, V)) -> Iterable[(L, W)]) -> TreeMap[L, W]
        var t: SortedTree[L, W] = Tip
        for entry in iterator()
            for (l, w) in f(entry) do t = treeInsert(t, l, w)
        TreeMap(t)

    // The entries that satisfy `p`, tested only as `map`, `flatMap` or `foreach` reaches each one.
    withFilter(p: ((K, V)) -> bool) -> FilteredTreeMap[K, V] = FilteredTreeMap(self, p)

    // The same keys, each bound to `f` of its value.
    mapValues[W](f: (V) -> W) -> TreeMap[K, W] = TreeMap(treeTransform(root, (k, v) -> f(v)))

// A tree map is the function from its keys to their values, its `apply`, so `keys.map(table)` looks
// up each key, and a key with no value traps.
impl[K, V] (K) -> V for TreeMap[K, V]

// A tree map is iterable as its entries, `(key, value)` pairs, in ascending order of their keys.
impl[K, V] Iterable[(K, V)] for TreeMap[K, V]
    iterator() -> Iterator[(K, V)] = SortedTreeIterator(root, false)

// Two tree maps visit equal keys in the same order, so they are compared entry by entry in step.
impl[K, V: Eq] Eq for TreeMap[K, V]
    equals(other: TreeMap[K, V]) -> bool
        if size() != other.size() then return false
        val theirs = other.iterator()
        for (k, v) in iterator()
            val (j, w) = theirs.next()
            if k != j || v != w then return false
        true

// The sum a `Map` of the same entries hashes to, so that the hash does not depend on the order the
// entries are visited in.
impl[K: Hash, V: Hash] Hash for TreeMap[K, V]
    hash() -> long
        var h: long = 0
        for (k, v) in iterator() do h = h +% spreadHash(k.hash() *% 31 +% v.hash())
        h

// A tree map of displayable keys and values joins into a string, each entry as `key: value`, in key
// order.
impl[K: Display, V: Display] TreeMap[K, V]
    // The entries separated by `sep`.
    mkString(sep: string = ", ") -> string = mkString("", sep, "")

    // The entries between `start` and `end`, separated by `sep`.
    mkString(start: string, sep: string, end: string) -> string
        val out = StringWriter()
        out.write(start)
        var first = true
        for (k, v) in iterator()
            if !first then out.write(sep)
            k.display(out, FormatSpec())
            out.write(": ")
            v.display(out, FormatSpec())
            first = false
        out.write(end)
        out.text()

// A tree map displays as a map does, `{a: 1, b: 2}`, in key order. A field width pads the whole.
impl[K: Display, V: Display] Display for TreeMap[K, V]
    display(out: Writer, spec: FormatSpec)
        writeEntry(w: Writer, entry: (K, V))
            entry.0.display(w, FormatSpec())
            w.write(": ")
            entry.1.display(w, FormatSpec())
        writeBraced(out, spec, iterator(), writeEntry)

// A tree map's diagnostic form is its keys' and values' diagnostic forms in braces: `{"a": 1}`.
impl[K: Debug, V: Debug] Debug for TreeMap[K, V]
    debug(out: Writer, spec: FormatSpec)
        writeEntry(w: Writer, entry: (K, V))
            entry.0.debug(w, FormatSpec())
            w.write(": ")
            entry.1.debug(w, FormatSpec())
        writeBraced(out, spec, iterator(), writeEntry)

object TreeMap
    // A tree map with no entries.
    empty[K: Ord, V]() -> TreeMap[K, V] = TreeMap(Tip)

    // A tree map of the pairs given, a later pair's value replacing an earlier one's for the same
    // key: `TreeMap((2, "two"), (1, "one"))`.
    apply[K: Ord, V](pairs: (K, V)*) -> TreeMap[K, V]
        var t: SortedTree[K, V] = Tip
        for (k, v) in pairs do t = treeInsert(t, k, v)
        TreeMap(t)

    // A builder of a tree map: the pairs it is given, a later pair's value replacing an earlier one's
    // for the same key. It is typed as a `Builder` of tree maps, so a literal where a `TreeMap[K, V]`
    // is expected gives the call its `K`, which must be known there to be held to its bound.
    builder[K: Ord, V]() -> Builder[(K, V), TreeMap[K, V]] = TreeMapBuilder[K, V]()

// Builds a tree map from `(key, value)` pairs.
class TreeMapBuilder[K: Ord, V]: Builder[(K, V), TreeMap[K, V]]
    private var tree: SortedTree[K, V] = Tip
    private var spent = false

    override add(element: (K, V))
        if spent then fail("add to a builder whose result was taken")
        val (k, v) = element
        tree = treeInsert(tree, k, v)

    override result() -> TreeMap[K, V]
        if spent then fail("result of a builder whose result was taken")
        spent = true
        TreeMap(tree)

// A tree map seen through a test of its entries, which a guard of a `for` with `yield` makes: each
// entry is tested just before the call after it would use it, in key order.
class FilteredTreeMap[K: Ord, V](private val source: TreeMap[K, V], private val p: ((K, V)) -> bool)
    // The map of the pairs `f` makes of each entry that passes the test.
    map[L: Ord, W](f: ((K, V)) -> (L, W)) -> TreeMap[L, W]
        var t: SortedTree[L, W] = Tip
        for entry in source
            if p(entry)
                val (l, w) = f(entry)
                t = treeInsert(t, l, w)
        TreeMap(t)

    // The map of the pairs in the collections `f` makes of each entry that passes the test.
    flatMap[L: Ord, W](f: ((K, V)) -> Iterable[(L, W)]) -> TreeMap[L, W]
        var t: SortedTree[L, W] = Tip
        for entry in source
            if p(entry)
                for (l, w) in f(entry) do t = treeInsert(t, l, w)
        TreeMap(t)

    // The entries that pass this test and then `q`.
    withFilter(q: ((K, V)) -> bool) -> FilteredTreeMap[K, V] =
        FilteredTreeMap(source, e -> p(e) && q(e))

    // Calls `f` with each entry that passes the test.
    foreach(f: ((K, V)) -> unit)
        for entry in source
            if p(entry) then f(entry)
