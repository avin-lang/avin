module avin

// The hash-based immutable set: elements are found by their hash and compared with `==`, so any type
// can be an element. It is the set a set literal `{1, 2}`, `Set(...)` and `Set.empty` build. An update
// answers a new hash set that shares all but the changed path with the old one, which is left as it
// was. Iteration visits the elements in an order fixed by their hashes, not by the order they were
// added. `HashSet.empty[A]()` is the empty set, and `HashSet.builder[A]()` builds one from elements.
data HashSet[A: Eq + Hash](root: HashTrie[A, unit] = Empty)

impl[A] Set[A] for HashSet[A]
    size() -> int = trieSize(root)

    isEmpty() -> bool = root is Empty

    nonEmpty() -> bool = !isEmpty()

    contains(element: A) -> bool = trieFind(root, spreadHash(element.hash()), element) is Some(_)

    added(element: A) -> HashSet[A]
        val h = spreadHash(element.hash())
        if trieFind(root, h, element) is Some(_) then self else HashSet(trieInsert(root, h, element, ()))

    removed(element: A) -> HashSet[A]
        val h = spreadHash(element.hash())
        if trieFind(root, h, element) is None then self else HashSet(trieRemove(root, h, element))

    ++(other: Iterable[A]) -> HashSet[A]
        var t = root
        for x in other do t = trieInsert(t, spreadHash(x.hash()), x, ())
        HashSet(t)

    --(other: Iterable[A]) -> HashSet[A]
        var t = root
        for x in other
            val h = spreadHash(x.hash())
            if trieFind(t, h, x) is Some(_) then t = trieRemove(t, h, x)
        HashSet(t)

    union(other: Set[A]) -> HashSet[A] = self ++ other

    intersect(other: Set[A]) -> HashSet[A] = filter(x -> other.contains(x))

    diff(other: Set[A]) -> HashSet[A] = filter(x -> !other.contains(x))

    filter(p: (A) -> bool) -> HashSet[A]
        var t = root
        for x in self
            if !p(x) then t = trieRemove(t, spreadHash(x.hash()), x)
        HashSet(t)

    iterator() -> Iterator[A] = SetElements(HashTrieIterator(root))

impl[A] HashSet[A]
    // Calls `f` with each element.
    foreach(f: (A) -> unit)
        for x in self do f(x)

impl[A] Eq for HashSet[A]
    equals(other: HashSet[A]) -> bool = size() == other.size() && subsetOf(other)

// A sum over the elements, so that the hash does not depend on the order they are visited in; a tree
// set of the same elements hashes alike.
impl[A] Hash for HashSet[A]
    hash() -> long
        var h: long = 0
        for x in self do h = h +% spreadHash(x.hash())
        h

// A set of displayable elements displays as `{1, 2, 3}`, the shape of a set literal. A field width
// pads the whole.
impl[A: Display] Display for HashSet[A]
    display(out: Writer, spec: FormatSpec)
        writeElement(w: Writer, x: A) = x.display(w, FormatSpec())
        writeBraced(out, spec, iterator(), writeElement)

// A set's diagnostic form is its elements' diagnostic forms in braces: `{"a", "b"}`.
impl[A: Debug] Debug for HashSet[A]
    debug(out: Writer, spec: FormatSpec)
        writeElement(w: Writer, x: A) = x.debug(w, FormatSpec())
        writeBraced(out, spec, iterator(), writeElement)

object HashSet
    // A hash set with no elements.
    empty[A]() -> HashSet[A] = HashSet(Empty)

    // A hash set of the elements given, each equal one once: `HashSet(1, 2, 3)`.
    apply[A: Eq + Hash](elements: A*) -> HashSet[A]
        var t: HashTrie[A, unit] = Empty
        for x in elements do t = trieInsert(t, spreadHash(x.hash()), x, ())
        HashSet(t)

    // A builder of a hash set: the elements it is given, each held once.
    builder[A]() -> Builder[A, HashSet[A]] = HashSetBuilder[A]()

// Builds a hash set from elements, an element added twice held once.
class HashSetBuilder[A: Eq + Hash]: Builder[A, HashSet[A]]
    private var trie: HashTrie[A, unit] = Empty
    private var spent = false

    override add(element: A)
        if spent then fail("add to a builder whose result was taken")
        trie = trieInsert(trie, spreadHash(element.hash()), element, ())

    override result() -> HashSet[A]
        if spent then fail("result of a builder whose result was taken")
        spent = true
        HashSet(trie)
