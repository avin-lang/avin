module avin

// The structure under the immutable `Map` and `Set`: a binary trie over the spread hashes of the
// keys, branching on one bit at a time, lowest bits first. A branch holds the bits its keys share
// below its branching bit, and has a subtrie for each value of that bit. The shape depends only on
// which hashes are present, never on the order they arrived in, and every update copies only the
// path from the root to the changed entry, sharing the rest with the trie it came from.
//
// Keys whose spread hashes are equal and that are not themselves equal share a `Collision`, which
// holds two or more entries.
private data HashTrie[K, +V]
  Empty
  Leaf(hash: long, key: K, value: V)
  Collision(hash: long, size: int, entries: Chain[K, V])
  Branch(prefix: long, bit: long, size: int, zero: HashTrie[K, V], one: HashTrie[K, V])

// The entries of a collision, in no particular order.
private data Chain[K, +V]
  Link(key: K, value: V, next: Chain[K, V])
  End

// Spreads a key's hash over all 64 bits, so that keys whose hashes differ only in their high bits, or
// form a sequence, still differ in the low bits the trie branches on first. It is the finalizer of
// MurmurHash3: alternating shifts and multiplications by odd constants, each step a bijection, so
// distinct hashes stay distinct.
private spreadHash(h: long) -> long
  var x = h ^ ((h >> 33) & 0x7fffffff)
  x = x *% -0x00ae502812aa7333
  x = x ^ ((x >> 33) & 0x7fffffff)
  x = x *% -0x3b314601e57a13ad
  x ^ ((x >> 33) & 0x7fffffff)

// The number of entries in `t`.
private trieSize[K, V](t: HashTrie[K, V]) -> int = t match
  Empty -> 0
  Leaf(_, _, _) -> 1
  Collision(_, n, _) -> n
  Branch(_, _, n, _, _) -> n

// The lowest bit at which `a` and `b` differ, which must exist.
private lowestDifference(a: long, b: long) -> long
  val d = a ^ b
  d & (0 -% d)

// The bits of `h` below `bit`.
private below(h: long, bit: long) -> long = h & (bit -% 1)

// A branch over two tries whose hashes, `h1` and `h2`, differ below every branching bit either has.
private join[K, V](h1: long, t1: HashTrie[K, V], h2: long, t2: HashTrie[K, V]) -> HashTrie[K, V]
  val bit = lowestDifference(h1, h2)
  val n = trieSize(t1) + trieSize(t2)
  if h1 & bit == 0 then Branch(below(h1, bit), bit, n, t1, t2) else Branch(below(h1, bit), bit, n, t2, t1)

// A branch from its two halves, or the one half that is not empty.
private branch[K, V](prefix: long, bit: long, zero: HashTrie[K, V], one: HashTrie[K, V]) -> HashTrie[K, V]
  if zero is Empty then one
  elif one is Empty then zero
  else Branch(prefix, bit, trieSize(zero) + trieSize(one), zero, one)

// The value at `key`, whose spread hash is `h`, found by descending in a loop. A branch whose shared
// bits differ from `h`'s ends the search early, since `key` would have to lie below it.
private trieFind[K: Eq, V](root: HashTrie[K, V], h: long, key: K) -> Option[V]
  var t = root
  loop
    t match
      Branch(p, b, _, z, o) ->
        if below(h, b) != p then return None
        t = if h & b == 0 then z else o
      Leaf(lh, k, v) -> return if lh == h && k == key then Some(v) else None
      Collision(ch, _, entries) -> return if ch == h then chainFind(entries, key) else None
      Empty -> return None

// The value at `key` in a collision's entries.
private chainFind[K: Eq, V](entries: Chain[K, V], key: K) -> Option[V]
  var c = entries
  loop
    c match
      Link(k, v, next) ->
        if k == key then return Some(v)
        c = next
      End -> return None

// Updates recurse, rebuilding the path on the way back up. Each level consumes one bit of the 64-bit
// hash, so the recursion is never deeper than 64, however large the map.

// The trie with `key` bound to `value`, replacing any value it had.
private trieInsert[K: Eq, V](t: HashTrie[K, V], h: long, key: K, value: V) -> HashTrie[K, V] = t match
  Empty -> Leaf(h, key, value)
  Leaf(lh, k, v) ->
    if lh != h then join(h, Leaf(h, key, value), lh, t)
    elif k == key then Leaf(h, key, value)
    else Collision(h, 2, Link(key, value, Link(k, v, End)))
  Collision(ch, n, entries) ->
    if ch != h then join(h, Leaf(h, key, value), ch, t)
    elif chainFind(entries, key) is Some(_) then Collision(h, n, Link(key, value, chainRemove(entries, key)))
    else Collision(h, n + 1, Link(key, value, entries))
  Branch(p, b, _, z, o) ->
    if below(h, b) != p then join(h, Leaf(h, key, value), p, t)
    elif h & b == 0 then branch(p, b, trieInsert(z, h, key, value), o)
    else branch(p, b, z, trieInsert(o, h, key, value))

// The trie without `key`, which must be in it.
private trieRemove[K: Eq, V](t: HashTrie[K, V], h: long, key: K) -> HashTrie[K, V] = t match
  Empty -> Empty
  Leaf(_, _, _) -> Empty
  Collision(ch, n, entries) ->
    val rest = chainRemove(entries, key)
    if n > 2 then Collision(ch, n - 1, rest)
    else rest match
      Link(k, v, _) -> Leaf(ch, k, v)
      End -> Empty
  Branch(p, b, _, z, o) ->
    if h & b == 0 then branch(p, b, trieRemove(z, h, key), o)
    else branch(p, b, z, trieRemove(o, h, key))

// A collision's entries without `key`. A collision's entries are in no particular order, so the ones
// kept are moved onto a new chain in a loop, which reverses them.
private chainRemove[K: Eq, V](entries: Chain[K, V], key: K) -> Chain[K, V]
  var kept: Chain[K, V] = End
  var c = entries
  loop
    c match
      Link(k, v, next) ->
        if k != key then kept = Link(k, v, kept)
        c = next
      End -> return kept

// Steps through a trie's entries, depth first, the subtries still to visit on `pending` and the
// remaining entries of a collision on `chain`.
private class HashTrieIterator[K, V](root: HashTrie[K, V]): Iterator[(K, V)]
  private var pending: List[HashTrie[K, V]] = [root]
  private var chain: Chain[K, V] = End
  private var ready: Option[(K, V)] = None
  advance()

  override hasNext() -> bool = ready is Some(_)

  override next() -> (K, V) = ready match
    Some(entry) ->
      advance()
      entry
    None -> fail("next on an exhausted iterator")

  // Moves the next entry, if any, into `ready`.
  private advance()
    ready = None
    chain match
      Link(k, v, next) ->
        ready = Some((k, v))
        chain = next
        return
      End -> ()
    while ready is None
      pending match
        t :: rest ->
          pending = rest
          t match
            Empty -> ()
            Leaf(_, k, v) -> ready = Some((k, v))
            Collision(_, _, Link(k, v, next)) ->
              ready = Some((k, v))
              chain = next
            Collision(_, _, End) -> ()
            Branch(_, _, _, z, o) -> pending = z :: o :: rest
        [] -> return
