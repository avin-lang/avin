module avin

// The outcome of something that can fail: `Ok(value)` when it succeeded, `Err(error)` with the
// reason when it did not.
data Result[+T, +E]
    Ok(value: T)
    Err(error: E)

// As for `Option`, a method taking a value that may be wider than `T` or `E` takes it as a type with
// that parameter as its lower bound.
impl[T, E] Result[T, E]
    isOk -> bool = self match
        Ok(_) -> true
        Err(_) -> false

    isErr -> bool = !isOk

    // The value, or `default`, which is evaluated only on an error.
    getOrElse[U >: T](default: -> U) -> U = self match
        Ok(v) -> v
        Err(_) -> default

    // The value as an `Option`, dropping the error.
    ok -> Option[T] = self match
        Ok(v) -> Some(v)
        Err(_) -> None

    // The error as an `Option`, dropping the value.
    err -> Option[E] = self match
        Ok(_) -> None
        Err(x) -> Some(x)

    map[U](f: (T) -> U) -> Result[U, E] = self match
        Ok(v) -> Ok(f(v))
        Err(x) -> Err(x)

    mapErr[F](f: (E) -> F) -> Result[T, F] = self match
        Ok(v) -> Ok(v)
        Err(x) -> Err(f(x))

    flatMap[U, F >: E](f: (T) -> Result[U, F]) -> Result[U, F] = self match
        Ok(v) -> f(v)
        Err(x) -> Err(x)

    // `onErr` of the error, or `onOk` of the value.
    fold[U](onErr: (E) -> U, onOk: (T) -> U) -> U = self match
        Ok(v) -> onOk(v)
        Err(x) -> onErr(x)

    // Calls `f` with the value, if there is one.
    foreach(f: (T) -> unit) = self match
        Ok(v) -> f(v)
        Err(_) -> ()

    // Whether it succeeded and the value satisfies `p`; false for an error.
    exists(p: (T) -> bool) -> bool = self match
        Ok(v) -> p(v)
        Err(_) -> false

    // Whether every value satisfies `p`: true for an error, which has none.
    forall(p: (T) -> bool) -> bool = self match
        Ok(v) -> p(v)
        Err(_) -> true

    // The value as a list of one element, or the empty list for an error.
    toList -> List[T] = self match
        Ok(v) -> v :: Nil
        Err(_) -> Nil

    // This result if it succeeded, otherwise `f` of the error, which may recover or give another error.
    orElse[U >: T, F](f: (E) -> Result[U, F]) -> Result[U, F] = self match
        Ok(v) -> Ok(v)
        Err(x) -> f(x)

// A result of a result with the same error type has `flatten`: `Ok(Ok(v))` is `Ok(v)`, and an error
// at either level is that error.
impl[T, E] Result[Result[T, E], E]
    flatten -> Result[T, E] = self match
        Ok(inner) -> inner
        Err(x) -> Err(x)

// Results of ordered values are ordered as eithers are, an `Err` taking the place of a `Left`: every
// `Err` before every `Ok`, and two on the same side as their values.
impl[T: Ord, E: Ord] Ord for Result[T, E]
    compare(other: Result[T, E]) -> int = self match
        Err(a) -> other match
            Err(b) -> a.compare(b)
            Ok(_) -> -1
        Ok(a) -> other match
            Err(_) -> 1
            Ok(b) -> a.compare(b)

// A type made from a value of `E`: an error type implements it once for each error it wraps, and
// `?` converts an `Err` through it where the enclosing function yields errors of the implementing
// type. Its one member is static, so a type may implement it at several `E`.
trait From[E]
    static from(value: E) -> Self
