module avin

// The arithmetic operators are trait methods: `a + b` is `a.add(b)`, `-`, `*`, `/` and `%` are
// `subtract`, `multiply`, `divide` and `remainder`, and unary `-a` is `a.negate()`. Each takes and
// yields the implementing type. On the built-in types an operator is the machine's operation, with
// integer overflow trapping, wherever it is written, generic code included.

trait Add
    add(other: Self) -> Self

trait Sub
    subtract(other: Self) -> Self

trait Mul
    multiply(other: Self) -> Self

trait Div
    divide(other: Self) -> Self

trait Rem
    remainder(other: Self) -> Self

trait Neg
    negate() -> Self

impl Add for i8
    add(other: i8) -> i8 = self + other

impl Add for i16
    add(other: i16) -> i16 = self + other

impl Add for int
    add(other: int) -> int = self + other

impl Add for long
    add(other: long) -> long = self + other

impl Add for real
    add(other: real) -> real = self + other

// Strings join with `+`.
impl Add for string
    add(other: string) -> string = self + other

impl Sub for i8
    subtract(other: i8) -> i8 = self - other

impl Sub for i16
    subtract(other: i16) -> i16 = self - other

impl Sub for int
    subtract(other: int) -> int = self - other

impl Sub for long
    subtract(other: long) -> long = self - other

impl Sub for real
    subtract(other: real) -> real = self - other

impl Mul for i8
    multiply(other: i8) -> i8 = self * other

impl Mul for i16
    multiply(other: i16) -> i16 = self * other

impl Mul for int
    multiply(other: int) -> int = self * other

impl Mul for long
    multiply(other: long) -> long = self * other

impl Mul for real
    multiply(other: real) -> real = self * other

impl Div for i8
    divide(other: i8) -> i8 = self / other

impl Div for i16
    divide(other: i16) -> i16 = self / other

impl Div for int
    divide(other: int) -> int = self / other

impl Div for long
    divide(other: long) -> long = self / other

impl Div for real
    divide(other: real) -> real = self / other

impl Rem for i8
    remainder(other: i8) -> i8 = self % other

impl Rem for i16
    remainder(other: i16) -> i16 = self % other

impl Rem for int
    remainder(other: int) -> int = self % other

impl Rem for long
    remainder(other: long) -> long = self % other

impl Rem for real
    remainder(other: real) -> real = self % other

impl Neg for i8
    negate() -> i8 = -self

impl Neg for i16
    negate() -> i16 = -self

impl Neg for int
    negate() -> int = -self

impl Neg for long
    negate() -> long = -self

impl Neg for real
    negate() -> real = -self
