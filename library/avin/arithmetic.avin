module avin

// The arithmetic operators are trait methods: `a + b` is `a.add(b)`, `-`, `*`, `/` and `%` are
// `subtract`, `multiply`, `divide` and `remainder`, and unary `-a` is `a.negate()`. Each takes and
// yields the implementing type. On the built-in types an operator is the machine's operation, with
// integer overflow trapping, wherever it is written, generic code included.
//
// `Add` and `Mul` also name their identities, static members of the implementing type: `zero()`,
// which `add` leaves a value unchanged by, and `one()`, which `multiply` does. They are called on a
// type, `int.zero()`, or on a bounded type parameter, `T.zero()`.

trait Add
    add(other: Self) -> Self
    static zero() -> Self

trait Sub
    subtract(other: Self) -> Self

trait Mul
    multiply(other: Self) -> Self
    static one() -> Self

trait Div
    divide(other: Self) -> Self

trait Rem
    remainder(other: Self) -> Self

trait Neg
    negate() -> Self

// The numbers: every integer width and `real`. A number has the five arithmetic operators, negation,
// the ordering and both text forms, the identities `T.zero()` and `T.one()`, and its value as a
// `real`, so generic code over numbers can total, compare and average them. `toReal` is exact for
// every integer up to 2^53 in magnitude and rounds to the nearest `real` beyond.
trait Numeric: Add, Sub, Mul, Div, Rem, Neg, Ord, Display, Debug
    toReal -> real

// The integers, every width from `i1` up: a closed family, whose members the compiler decides and
// nothing else joins. Each member is a number, with the arithmetic, the ordering and both text forms,
// from one impl of each trait for every width, and a type parameter bounded by `Integer` converts to
// and from the other integer types, as in `T(n)` and `long(x)`.
trait Integer: Numeric

// A type every integer converts to, of any width and without loss, as a `BigInt` does. Where one is
// expected an integer literal of any size is that value, `val x: BigInt = 5`, and as the other
// operand of an arithmetic operator or a comparison an integer of any type is converted to it:
// `big * i`, `i * big`, `big < 100`, `0 == big`. The conversion is `T.fromInteger(n)`.
trait FromInteger
  static fromInteger[N: Integer](n: N) -> Self

// A type every decimal number converts to exactly, as a `BigDecimal` does. Where one is expected a
// real literal is that value, read from its digits and never rounded through a `real`:
// `val price: BigDecimal = 19.99` is `BigDecimal.fromDecimal("19.99")`. The literal's text is passed
// as written, with its sign, without its separators and with any exponent, `1.5e-3`. Such a type takes
// integers too, and a `BigInt` beside one under an operator or a comparison is converted to it,
// `BigDecimal.fromBigInt(n)`, on either side.
trait FromDecimal: FromInteger
  static fromDecimal(text: string) -> Self
  static fromBigInt(n: BigInt) -> Self

impl[T: Integer] Numeric for T
    toReal -> real = real(self)

impl Numeric for real
    toReal -> real = self

impl[T: Integer] Add for T
    add(other: T) -> T = self + other
    static zero() -> T = T(0)

impl[T: Integer] Sub for T
    subtract(other: T) -> T = self - other

impl[T: Integer] Mul for T
    multiply(other: T) -> T = self * other
    static one() -> T
        val unit = T.wrap(1)
        // The width `i1` holds 0 and -1, so its `1` wraps to a negative number: it has none.
        if unit < T(0) then fail("i1 has no 1")
        unit

impl[T: Integer] Div for T
    divide(other: T) -> T = self / other

impl[T: Integer] Rem for T
    remainder(other: T) -> T = self % other

impl[T: Integer] Neg for T
    negate() -> T = -self

impl Add for real
    add(other: real) -> real = self + other
    static zero() -> real = 0.0

// Strings join with `+`, and the empty string joins to nothing.
impl Add for string
    add(other: string) -> string = self + other
    static zero() -> string = ""

impl Sub for real
    subtract(other: real) -> real = self - other

impl Mul for real
    multiply(other: real) -> real = self * other
    static one() -> real = 1.0

impl Div for real
    divide(other: real) -> real = self / other

impl Rem for real
    remainder(other: real) -> real = self % other

impl Neg for real
    negate() -> real = -self
