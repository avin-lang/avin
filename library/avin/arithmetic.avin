module avin

// The arithmetic operators are trait methods: `a + b` is `a.add(b)`, `-`, `*`, `/` and `%` are
// `subtract`, `multiply`, `divide` and `remainder`, and unary `-a` is `a.negate()`. Each takes and
// yields the implementing type. On the built-in types an operator is the machine's operation, with
// integer overflow trapping, wherever it is written, generic code included.
//
// `Add` and `Mul` also name their identities, static members of the implementing type: `zero()`,
// which `add` leaves a value unchanged by, and `one()`, which `multiply` does. They are called on a
// type, `int.zero()`, or on a bounded type parameter, `T.zero()`.

trait Add
    add(other: Self) -> Self
    static zero() -> Self

trait Sub
    subtract(other: Self) -> Self

trait Mul
    multiply(other: Self) -> Self
    static one() -> Self

trait Div
    divide(other: Self) -> Self

trait Rem
    remainder(other: Self) -> Self

trait Neg
    negate() -> Self

// The integers, every width from `i1` up: a closed family, whose members the compiler decides and
// nothing else joins. Each member has the arithmetic, the ordering and both text forms, from one impl
// of each trait for every width, and a type parameter bounded by `Integer` converts to and from the
// other integer types, as in `T(n)` and `long(x)`.
trait Integer: Add, Sub, Mul, Div, Rem, Neg, Ord, Display, Debug

impl[T: Integer] Add for T
    add(other: T) -> T = self + other
    static zero() -> T = T(0)

impl[T: Integer] Sub for T
    subtract(other: T) -> T = self - other

impl[T: Integer] Mul for T
    multiply(other: T) -> T = self * other
    static one() -> T
        val unit = T(1)
        // The width `i1` holds 0 and -1, so its `1` wraps to a negative number: it has none.
        if unit < T(0) then fail("i1 has no 1")
        unit

impl[T: Integer] Div for T
    divide(other: T) -> T = self / other

impl[T: Integer] Rem for T
    remainder(other: T) -> T = self % other

impl[T: Integer] Neg for T
    negate() -> T = -self

impl Add for real
    add(other: real) -> real = self + other
    static zero() -> real = 0.0

// Strings join with `+`, and the empty string joins to nothing.
impl Add for string
    add(other: string) -> string = self + other
    static zero() -> string = ""

impl Sub for real
    subtract(other: real) -> real = self - other

impl Mul for real
    multiply(other: real) -> real = self * other
    static one() -> real = 1.0

impl Div for real
    divide(other: real) -> real = self / other

impl Rem for real
    remainder(other: real) -> real = self % other

impl Neg for real
    negate() -> real = -self
