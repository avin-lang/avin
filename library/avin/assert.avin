module avin

// Assertions: a check the program states, which stops it with the reason at the assertion's own
// line when it does not hold. A `@test` function asserts what it tests, and a test passes when it
// returns.

// Stops the program with `message` as the trap's message, at the place the program called it. Its
// type is `Nothing`, so it stands where a value of any type is expected: it says "this cannot
// happen".
@intrinsic("trap")
fail(message: string) -> Nothing

// Stops the program when `condition` is false.
assert(condition: bool)
    if !condition then fail("assertion failed")

// Stops the program when `condition` is false, with `message` saying what was expected.
assert(condition: bool, message: string)
    if !condition then fail("assertion failed: " + message)

// Stops the program when `condition`, a requirement on what a function was given, is false.
require(condition: bool)
    if !condition then fail("requirement failed")

// Stops the program when `condition` is false, with `message` saying what was required. The message
// is evaluated only when the requirement fails.
require(condition: bool, message: -> string)
    if !condition then fail("requirement failed: " + message)

// Stands for code not yet written: stops the program, saying so, wherever it is reached. Its type is
// `Nothing`, so it stands where a value of any type is expected.
todo() -> Nothing = fail("not implemented")

// Stands for code not yet written, with `message` saying what is missing.
todo(message: string) -> Nothing = fail("not implemented: " + message)

// The value it is given: the function to pass where one is asked for and nothing should change.
identity[T](value: T) -> T = value

// Stops the program when `actual` is not equal to `expected`, showing both in their `Debug` form,
// so a string is quoted: `assertion failed: expected "b", found "a"`.
assertEq[T: Eq + Debug](actual: T, expected: T)
    if actual != expected then fail(s"assertion failed: expected ${debug(expected)}, found ${debug(actual)}")

// How `avin test` reads a test that answers with a `Result`: an `Err` fails the test, with the error
// as the reason.
private testAnswered[E: Display](answer: Result[unit, E])
    if answer is Err(error) then fail(s"test answered Err: $error")

// How a program reads the `Result` its `main` answers with: the exit status, 0 for `Ok`; an `Err`
// is written to standard error as `error: ` and the error's `Display`, and exits with 1. `T` is
// unit, or `Nothing` for a `main` that only ever answers `Err`.
private mainAnswered[T, E: Display](answer: Result[T, E]) -> int = answer match
    Ok(_) -> 0
    Err(error) -> mainFailed(error)

// The same for a `main` answering with `Result[N, E]` for an integer type `N`: `Ok` exits with the
// integer it holds.
private mainAnsweredStatus[N: Integer, E: Display](answer: Result[N, E]) -> N = answer match
    Ok(status) -> status
    Err(error) -> N.wrap(mainFailed(error))

private mainFailed[E: Display](error: E) -> int
    eprintln(s"error: $error")
    1
