module avin.process

// The running program's process: the arguments it was started with, its environment, and ending it
// with an exit status.

import avin.io
import avin.io.IoError

@intrinsic("argument_count")
private argumentCount() -> int

@intrinsic("argument")
private argument(index: int) -> string

@sysl("sysl.env.get")
private variable(name: string) -> Option[string]

// The arguments the program was started with, after its own name, in order.
args() -> Vector[string]
    val b = Vector.newBuilder[string]()
    for i in 1..<argumentCount() do b.addOne(argument(i))
    b.result()

// The name the program was started by, as the platform gave it: usually the path it was run as. A
// program started with no arguments at all, which only a parent asking for it can do, has the empty
// string.
programName() -> string = if argumentCount() > 0 then argument(0) else ""

// The value of the environment variable `name`, or `None` when it is not set. A variable set to the
// empty string is `Some("")`.
env(name: string) -> Option[string] = variable(name)

@sysl("sysl.env.vars")
private variables() -> Vector[(string, string)]

// Every environment variable and its value, read when called. A variable set to the empty string is
// there with `""`; an entry whose name or value is not UTF-8 is passed over, as `env` answers `None`
// for it.
environment() -> Map[string, string] = variables().toMap

// Ends the program now, with `code` as its exit status. What the program has written so far is
// flushed first, as a trap flushes it, and then the exit hooks run (`onExit`).
@intrinsic("exit")
exit(code: int) -> Nothing

// Where the program runs: the platform's facts, each asked for by name.

@sysl("sysl.fs.current_dir")
private workingDir() -> Result[string, SyslError]

// The directory relative paths are read from.
currentDir() -> Result[string, IoError] = workingDir().mapErr(failed("read the working directory", ""))

// The user's home directory, `None` where the platform names none.
@sysl("sysl.fs.home_dir")
homeDir() -> Option[string]

// The absolute path of the running program's file, `None` where the platform cannot tell.
@sysl("sysl.env.current_exe")
executable() -> Option[string]

@sysl("avin.rt.processors")
private processorCount() -> long

// How many processors the program may run on, and at least one: the number the futures' pool grows
// to.
processors() -> int = int(processorCount())

@sysl("sysl.process.pid")
private processId() -> int

// The process's identifier, which no other process running beside it has.
pid() -> long = long(processId())

@sysl("sysl.process.total_memory")
private machineMemory() -> Result[long, SyslError]

// The physical memory the machine has, in bytes: what is installed, not what is free.
totalMemory() -> Result[long, IoError] = machineMemory().mapErr(failed("read the machine's memory", ""))

@sysl("sysl.process.resident_bytes")
private residentOf(pid: int) -> Result[long, SyslError]

// The memory the process `pid` holds in RAM now, in bytes: `residentBytes(pid())` is the program's
// own, and a started command's `Child` asks it for the program it ran. A process that is not there,
// a child already waited for among them, is `Err(NotFound)`, and so is a `pid` of zero or less, or
// one no process id can be; one the program may not look at is `Err(PermissionDenied)`.
residentBytes(pid: long) -> Result[long, IoError] = residentBytesOf(pid)

private residentBytesOf(pid: long) -> Result[long, IoError]
  val subject = s"process $pid"
  if !(0 < pid <= long(int.MaxValue)) then return Err(IoError(io.NotFound, "read the memory of", subject))
  residentOf(int(pid)).mapErr(e -> e match
    NotPermitted -> IoError(io.PermissionDenied, "read the memory of", subject)
    other -> ioError(other, "read the memory of", subject))

@sysl("sysl.process.group_members")
private listedGroup(pgid: int) -> Result[Vector[int], SyslError]

@sysl("sysl.process.children")
private listedChildren(pid: int) -> Result[Vector[int], SyslError]

// The live processes whose process group is `pgid`, as pids, in no particular order: a group's
// leader, the programs it started, and their children that stayed in the group. A program that has
// ended but not been waited for is still listed, as `ps` lists it, and once waited for it is not.
// A group nobody is in, one that has ended, and one the program may not look at, are `Ok([])`; a
// `pgid` of zero or less, or one no process id can be, is `Err(Other(...))`. The list is a snapshot:
// a process may have started or ended by the time it is read.
groupMembers(pgid: long) -> Result[Vector[long], IoError]
  val subject = s"process group $pgid"
  if !(0 < pgid <= long(int.MaxValue)) then return Err(IoError(io.Other("Invalid argument"), "list", subject))
  listedGroup(int(pgid)).map(pids -> pids.map(p -> long(p))).mapErr(failed("list", subject))

// The live processes whose parent is `pid`, as pids, in no particular order, found as `groupMembers`
// finds a group's: `children(pid())` is the programs this one started and not yet waited for, and
// not their own children. A `pid` with no children, or none at all, is `Ok([])`; a `pid` of zero or
// less, or one no process id can be, is `Err(Other(...))`.
children(pid: long) -> Result[Vector[long], IoError]
  val subject = s"process $pid"
  if !(0 < pid <= long(int.MaxValue)) then return Err(IoError(io.Other("Invalid argument"), "list the children of", subject))
  listedChildren(int(pid)).map(pids -> pids.map(p -> long(p))).mapErr(failed("list the children of", subject))

@sysl("sysl.process.exec")
private replaceImage(program: string, args: Vector[string], env: Vector[Var], inheritEnv: bool) -> SyslError

// Replaces the program with `program`, run with `args`, and answers only if that failed. On success
// nothing comes back: the process goes on with the same id, the same parent and every descriptor not
// closed on exec (the standard streams; everything the library opens closes), running `program` from
// its beginning with this program's environment. What the program has written so far is flushed
// first. Nothing else of the program is left: its other threads vanish, its exit hooks do not run
// and its signal watches end. A bare name is looked for on the `PATH`. A program that is not there
// is `Err(NotFound)` and one that may not be run `Err(PermissionDenied)`, and the program then
// carries on exactly as it was.
exec(program: string, args: Vector[string]) -> Result[Nothing, IoError] =
  Err(ioError(replaceImage(program, args, [], true), "run", program))

// `exec` with `environment` as the whole of the new program's environment, nothing of this program's
// inherited: `process.environment().updated("NAME", "value")` adds to this program's. A bare name is looked for on
// the `PATH` that `environment` holds, or the system's default search path where it holds none.
exec(program: string, args: Vector[string], environment: Map[string, string]) -> Result[Nothing, IoError]
  var vars: Vector[Var] = []
  for (name, value) in environment do vars = vars :+ Var(name, value)
  Err(ioError(replaceImage(program, args, vars, false), "run", program))

@sysl("sysl.process.wait_pid", blocking)
private waitedPid(pid: int) -> Result[ExitStatus, SyslError]

@sysl("sysl.process.try_wait_pid")
private polledPid(pid: int) -> Result[Option[ExitStatus], SyslError]

// Waits for this program's child `pid` to end and answers how it ended, as a `Child`'s `waitFor`
// does: for a child no `Child` holds, one detached or one an earlier image of the process started
// before it became this program through `exec`. The child is reaped, so a second wait for it is
// `Err(NotFound)`, as is a `pid` that is not this program's child and a `pid` of zero or less. A
// lightweight thread waiting leaves its worker to run others.
waitPid(pid: long) -> Result[ExitStatus, IoError]
  if !(0 < pid <= long(int.MaxValue)) then return Err(IoError(io.NotFound, "wait for", s"process $pid"))
  waitedPid(int(pid)).mapErr(waitError(pid))

// Whether this program's child `pid` has ended, without waiting: `None` while it runs, and how it
// ended once it has, reaping it then. The errors are `waitPid`'s.
tryWaitPid(pid: long) -> Result[Option[ExitStatus], IoError]
  if !(0 < pid <= long(int.MaxValue)) then return Err(IoError(io.NotFound, "wait for", s"process $pid"))
  polledPid(int(pid)).mapErr(waitError(pid))

// The platform's "no child process" (10 on every platform the library runs on) is the child not
// being there to wait for.
private waitError(pid: long) -> (SyslError) -> IoError = e -> e match
  Other(10) -> IoError(io.NotFound, "wait for", s"process $pid")
  other -> ioError(other, "wait for", s"process $pid")

// The operating system the program was compiled for.
@sysl("sysl.Os")
data Os
  MacOS
  Linux
  Windows
  Freestanding
  Android
  Wasi

@sysl("sysl.os")
os() -> Os

@sysl("sysl.signal.send")
private sendSignal(pid: long, sig: int) -> Result[unit, SyslError]

// Sends the signal `sig` to the process `pid`. A negative `pid` names the process group `-pid`, and
// zero this program's own group; a `sig` of zero sends nothing and answers whether a signal could
// have been sent. A pid that names no process, or a group with nobody left in it, is
// `Err(Other("No such process"))`; one the program may not signal is `Err(Other(...))` with the
// platform's sentence, and a signal number the platform does not have is refused before anything
// is sent.
signal(pid: long, sig: int) -> Result[unit, IoError] =
  sendSignal(pid, sig).mapErr(failed("signal", if pid < 0 then s"process group ${-pid}" else s"process $pid"))

@sysl("sysl.process.new_session")
private startSession() -> Result[int, SyslError]

// Makes the program the leader of a new session and of a new process group in it, with no
// controlling terminal, and answers the session's number, which is the program's process id: what a
// daemon does to leave the terminal and the job it was started from. A program that already leads a
// process group, one started `inNewGroup` among them, is refused and stays where it was.
newSession() -> Result[long, IoError] = startSession().map(s -> long(s)).mapErr(failed("start a new session", ""))
