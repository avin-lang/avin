module avin.process

// The running program's process: the arguments it was started with, its environment, and ending it
// with an exit status.

import avin.io
import avin.io.IoError

@intrinsic("argument_count")
private argumentCount() -> int

@intrinsic("argument")
private argument(index: int) -> string

@sysl("sysl.env.get")
private variable(name: string) -> Option[string]

// The arguments the program was started with, after its own name, in order.
args() -> Vector[string]
    val b = Vector.newBuilder[string]()
    for i in 1..<argumentCount() do b.addOne(argument(i))
    b.result()

// The name the program was started by, as the platform gave it: usually the path it was run as. A
// program started with no arguments at all, which only a parent asking for it can do, has the empty
// string.
programName() -> string = if argumentCount() > 0 then argument(0) else ""

// The value of the environment variable `name`, or `None` when it is not set. A variable set to the
// empty string is `Some("")`.
env(name: string) -> Option[string] = variable(name)

@sysl("sysl.env.vars")
private variables() -> Vector[(string, string)]

// Every environment variable and its value, read when called. A variable set to the empty string is
// there with `""`; an entry whose name or value is not UTF-8 is passed over, as `env` answers `None`
// for it.
environment() -> Map[string, string] = variables().toMap()

// Ends the program now, with `code` as its exit status. What the program has written so far is
// flushed first, as a trap flushes it, and then the exit hooks run (`onExit`).
@intrinsic("exit")
exit(code: int) -> Nothing

// Where the program runs: the platform's facts, each asked for by name.

@sysl("sysl.fs.current_dir")
private workingDir() -> Result[string, SyslError]

// The directory relative paths are read from.
currentDir() -> Result[string, IoError] = workingDir().mapErr(ioError)

// The user's home directory, `None` where the platform names none.
@sysl("sysl.fs.home_dir")
homeDir() -> Option[string]

// The absolute path of the running program's file, `None` where the platform cannot tell.
@sysl("sysl.env.current_exe")
executable() -> Option[string]

@sysl("avin.rt.processors")
private processorCount() -> long

// How many processors the program may run on, and at least one: the number the futures' pool grows
// to.
processors() -> int = int(processorCount())

@sysl("sysl.process.pid")
private processId() -> int

// The process's identifier, which no other process running beside it has.
pid() -> long = long(processId())

@sysl("sysl.process.total_memory")
private machineMemory() -> Result[long, SyslError]

// The physical memory the machine has, in bytes: what is installed, not what is free.
totalMemory() -> Result[long, IoError] = machineMemory().mapErr(ioError)

@sysl("sysl.process.resident_bytes")
private residentOf(pid: int) -> Result[long, SyslError]

// The memory the process `pid` holds in RAM now, in bytes: `residentBytes(pid())` is the program's
// own, and a started command's `Child` asks it for the program it ran. A process that is not there,
// a child already waited for among them, is `Err(NotFound)`, and so is a `pid` of zero or less, or
// one no process id can be; one the program may not look at is `Err(PermissionDenied)`.
residentBytes(pid: long) -> Result[long, IoError] = residentBytesOf(pid)

private residentBytesOf(pid: long) -> Result[long, IoError]
  if !(0 < pid <= long(int.MaxValue)) then return Err(io.NotFound)
  // The platform's "no such process" (3 on every platform the library runs on) is the process not
  // being there.
  residentOf(int(pid)).mapErr(e -> e match
    NotPermitted -> io.PermissionDenied
    Other(3) -> io.NotFound
    other -> ioError(other))

// The operating system the program was compiled for.
@sysl("sysl.Os")
data Os
  MacOS
  Linux
  Windows
  Freestanding
  Android
  Wasi

@sysl("sysl.os")
os() -> Os

@sysl("sysl.signal.send")
private sendSignal(pid: long, sig: int) -> Result[unit, SyslError]

// Sends the signal `sig` to the process `pid`. A negative `pid` names the process group `-pid`, and
// zero this program's own group; a `sig` of zero sends nothing and answers whether a signal could
// have been sent. A pid that names no process, or a group with nobody left in it, is
// `Err(Other("No such process"))`; one the program may not signal is `Err(Other(...))` with the
// platform's sentence, and a signal number the platform does not have is refused before anything
// is sent.
signal(pid: long, sig: int) -> Result[unit, IoError] = sendSignal(pid, sig).mapErr(ioError)

@sysl("sysl.process.new_session")
private startSession() -> Result[int, SyslError]

// Makes the program the leader of a new session and of a new process group in it, with no
// controlling terminal, and answers the session's number, which is the program's process id: what a
// daemon does to leave the terminal and the job it was started from. A program that already leads a
// process group, one started `inNewGroup` among them, is refused and stays where it was.
newSession() -> Result[long, IoError] = startSession().map(s -> long(s)).mapErr(ioError)
