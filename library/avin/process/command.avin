module avin.process

// Commands: other programs to run, described first and run when asked. A command is one program and
// its arguments, or two commands joined as a pipeline or a sequence, each with the directory,
// variables, time limit and streams it runs with.

import avin.fs
import avin.io
import avin.io.IoError
import avin.threads
import avin.threads.Atomic
import avin.time
import avin.time.Duration

// How a program ended: exited with a code, ended by a signal, or stopped for running past its time.
@sysl("sysl.process.Status")
data ExitStatus
  Exited(code: int)
  Signalled(signal: int)
  TimedOut

impl ExitStatus
  // Whether the program exited with code 0, the one status that is success.
  isSuccess() -> bool = self match
    Exited(code) -> code == 0
    _ -> false

// Why `output()` has no text to give: the command could not be run, or it ran and did not succeed.
data CommandError
  Io(error: IoError)
  Failed(status: ExitStatus)

impl CommandError
  // A sentence saying why the command gave no text, for a message to a person: the start failure's
  // own message, or how the program ended.
  message() -> string = self match
    Io(e) -> e.message()
    Failed(Exited(code)) -> s"exited with status $code"
    Failed(Signalled(sig)) -> s"killed by signal $sig (${signalName(sig)})"
    Failed(TimedOut) -> "timed out"

// The name of a signal this library has a name for, otherwise "unknown".
private signalName(sig: int) -> string
signalName(1) = "Hangup"
signalName(2) = "Interrupt"
signalName(3) = "Quit"
signalName(9) = "Kill"
signalName(13) = "BrokenPipe"
signalName(14) = "Alarm"
signalName(15) = "Terminate"
signalName(28) = "WindowChange"
signalName(_) = "unknown"

// A program to run: one program and its arguments, or two commands joined. Each method that changes
// something answers a new command and leaves this one as it was, so a command can be run any number
// of times.
class Command(
    private val shape: Shape,
    private val dir: Option[string],
    private val env: Vector[EnvEdit],
    private val limit: Option[Duration],
    private val sink: Sink,
    private val feed: Feed,
    private val errors: Drain,
    private val grouped: bool
)
  // The same command, run in `dir`. A part that names a directory of its own runs in that one.
  inDir(dir: string) -> Command = Command(shape, Some(dir), env, limit, sink, feed, errors, grouped)

  // The same command, with the variable `name` set to `value` for it; the rest of the program's
  // environment is passed on, and a part setting the same variable sets it for itself.
  withEnv(name: string, value: string) -> Command = Command(shape, dir, env :+ SetVar(name, value), limit, sink, feed, errors, grouped)

  // The same command, started from an empty environment: none of the program's variables is passed
  // on, and none set by a `withEnv` before this call stays. Variables set after it are the whole of
  // the environment, `PATH` included: a program named without a directory is looked for on the
  // `PATH` the command was given, or, where it was given none, on the system's default search path,
  // never on the running program's.
  clearEnv() -> Command = Command(shape, dir, env :+ ClearVars, limit, sink, feed, errors, grouped)

  // The same command, without the variable `name`: the program's value for it is not passed on, and
  // a `withEnv` of it before this call is dropped. A name that is not set is no error.
  withoutEnv(name: string) -> Command = Command(shape, dir, env :+ RemoveVar(name), limit, sink, feed, errors, grouped)

  // The same command, with exactly the variables of `vars` for its environment, none of the
  // program's passed on: `clearEnv()` and then a `withEnv` for each, in the map's order.
  withEnvironment(vars: Map[string, string]) -> Command
    var c = clearEnv()
    for (name, value) in vars do c = c.withEnv(name, value)
    c

  // The same command, stopped when it has run for `d`: a program still running then is ended, its
  // status `TimedOut`, and a part not yet started is not started.
  withTimeout(d: Duration) -> Command = Command(shape, dir, env, Some(d), sink, feed, errors, grouped)

  // The same command, its standard output written to `file`, which is made empty first, or made.
  toFile(file: string) -> Command = Command(shape, dir, env, limit, OutputTo(file, false), feed, errors, grouped)

  // The same command, its standard output added to the end of `file`, which is made if it is not
  // there.
  appendTo(file: string) -> Command = Command(shape, dir, env, limit, OutputTo(file, true), feed, errors, grouped)

  // The same command, reading `file` as its standard input.
  fromFile(file: string) -> Command = Command(shape, dir, env, limit, sink, InputFrom(file), errors, grouped)

  // The same command, reading `text` as its standard input.
  withInput(text: string) -> Command = Command(shape, dir, env, limit, sink, InputText(text), errors, grouped)

  // The same command, its standard error written to `file`, which is made empty first, or made.
  errorsToFile(file: string) -> Command = Command(shape, dir, env, limit, sink, feed, ErrorsTo(file, false), grouped)

  // The same command, its standard error added to the end of `file`, which is made if it is not
  // there.
  errorsAppendTo(file: string) -> Command = Command(shape, dir, env, limit, sink, feed, ErrorsTo(file, true), grouped)

  // The same command, its standard error going where its standard output goes: into the same open
  // file, so neither stream empties what the other wrote, and into the text `output()` and `lines()`
  // capture.
  errorsToOutput() -> Command = Command(shape, dir, env, limit, sink, feed, ErrorsToOutput, grouped)

  // The same command, started in a process group of its own, which every program it starts joins:
  // the group `Child.signalGroup` signals, and with it every program those programs start that stays
  // in it.
  inNewGroup() -> Command = Command(shape, dir, env, limit, sink, feed, errors, true)

  // A pipeline: this command's standard output is `next`'s standard input, the two running at once.
  // Its status is `next`'s.
  |(next: Command) -> Command = joined(Piped(self, next))

  // This command, then `next` where this one succeeded. The status is the last one run.
  andThen(next: Command) -> Command = joined(Joined(self, WhenSucceeded, next))

  // This command, then `next` where this one did not succeed. The status is the last one run.
  orElse(next: Command) -> Command = joined(Joined(self, WhenFailed, next))

  // This command, then `next` whatever this one's status. The status is `next`'s.
  followedBy(next: Command) -> Command = joined(Joined(self, Always, next))

  // Runs the command with the program's own streams, waits for it, and answers how it ended. A
  // status other than success is a value; the `Err` is a command that could not be started.
  run() -> Result[ExitStatus, IoError]
    val job = launch(Context.outermost(Track()), Streams.own())?
    job.finish()
    job.outcome()

  // Runs the command with its standard output captured and its standard error the program's own,
  // and answers the output as text, bytes that are not UTF-8 each replaced with U+FFFD. Any status
  // but success is `Failed(status)`, and the output is then dropped.
  output() -> Result[string, CommandError]
    val dir = fs.createTempDir("avin-output").mapErr(e -> Io(e))?
    val file = dir + "/output"
    val opened = createFile(file)
    if opened.isErr()
      fs.removeDirAll(dir)
      return Err(Io(ioError(opened.err().get())))
    val into = opened.ok().get()
    val started = launch(Context.outermost(Track()), Streams.into(into))
    val outcome = started.map(job -> finished(job))
    val bytes = fs.readBytes(file)
    fs.removeDirAll(dir)
    outcome.flatten() match
      Err(e) -> Err(Io(e))
      Ok(status) if !status.isSuccess() -> Err(Failed(status))
      Ok(_) -> bytes match
        Ok(b) -> Ok(string.fromUtf8Lossy(b))
        Err(e) -> Err(Io(e))

  // Starts the command and answers its standard output's lines as they arrive, each without its
  // `\n` or `\r\n`, bytes that are not UTF-8 replaced with U+FFFD. Its status is not checked; once the
  // output has ended the command is waited for.
  lines() -> Result[Iterator[string], IoError]
    val (from, into) = makePipe().mapErr(ioError)?
    // A sequence starts its later parts as its earlier ones end, which has to happen while the
    // output is read, so a command holding one is started and driven on a thread of its own, which
    // the job belongs to; whether it started comes back through a promise.
    if sequenced()
      val launched = threads.Promise[Result[unit, IoError]]()
      val driver = threads.spawn(() ->
        launch(Context.outermost(Track()), Streams.into(into)) match
          Ok(job) ->
            launched.complete(Ok(()))
            job.finish()
          Err(e) -> launched.complete(Err(e)))
      launched.future.await() match
        Err(e) ->
          closeFile(Some(from))
          driver.join()
          return Err(e)
        Ok(_) -> ()
      val descriptor = from.fd()
      if descriptor.isErr()
        closeFile(Some(from))
        driver.join()
        return Err(ioError(descriptor.err().get()))
      return Ok(OutputLines(from, fdReader(descriptor.ok().get()), () -> driver.join()))
    val started = launch(Context.outermost(Track()), Streams.into(into))
    if started.isErr()
      closeFile(Some(from))
      return Err(started.err().get())
    val job = started.ok().get()
    val descriptor = from.fd()
    if descriptor.isErr()
      closeFile(Some(from))
      job.finish()
      return Err(ioError(descriptor.err().get()))
    Ok(OutputLines(from, fdReader(descriptor.ok().get()), () -> job.finish()))

  // Starts the command and answers at once, with the `Child` it is waited for and stopped by.
  start() -> Result[Child, IoError]
    val track = Track()
    launch(Context.outermost(track), Streams.own()).map(job -> Child(job, newOwner(), track))

  // Whether the command holds a sequence, whose later parts start as its earlier ones end.
  private sequenced() -> bool = shape match
    Program(_, _) -> false
    Joined(_, _, _) -> true
    Piped(from, into) -> from.sequenced() || into.sequenced()

  private joined(shape: Shape) -> Command = Command(shape, None, [], None, OwnOutput, OwnInput, OwnErrors, false)

  // Starts the command within `outer`'s settings, its streams `given`. Whatever it fails at, the
  // files `given` holds are closed.
  private launch(outer: Context, given: Streams) -> Result[Job, IoError]
    val context = outer.within(dir, env, limit, grouped)
    val streams = redirected(given)?
    shape match
      Program(program, args) -> startProgram(program, args, context, streams)
      Joined(first, joint, second) -> first.launch(context, streams.lent()) match
        Ok(job) -> Ok(Sequence(job, joint, () -> second.launch(context, streams.lent()), streams))
        Err(e) ->
          streams.release()
          Err(e)
      Piped(from, into) ->
        val ends = makePipe()
        if ends.isErr()
          streams.release()
          return Err(ioError(ends.err().get()))
        val (reading, writing) = ends.ok().get()
        // Both stages write their errors to the pipeline's; the second, started last, closes its file.
        val left = from.launch(context, Streams(streams.input, streams.inputFile, ToFile(writing), Some(writing), streams.errors, None, false))
        if left.isErr()
          closeFile(Some(reading))
          closeFile(streams.outputFile)
          closeFile(streams.errorsFile)
          return left
        val right = into.launch(context, Streams(FromFile(reading), Some(reading), streams.output, streams.outputFile, streams.errors, streams.errorsFile, streams.errorsShared))
        right match
          Ok(job) -> Ok(Pipeline(left.ok().get(), job))
          Err(e) ->
            left.ok().get().finish()
            Err(e)

  // `given` with this command's own redirections in place of its streams, each replaced stream's
  // file closed. A file that cannot be opened closes every file held so far. Standard error sent to
  // the output goes where the output goes once this command's own output is in place.
  private redirected(given: Streams) -> Result[Streams, IoError]
    var streams = given
    sink match
      OwnOutput -> ()
      OutputTo(file, append) -> (if append then appendFile(file) else createFile(file)) match
        Ok(f) -> streams = streams.withOutput(f)
        Err(e) ->
          streams.release()
          return Err(ioError(e))
    errors match
      OwnErrors -> ()
      // The program's own output is reached through the name the platform gives it, opened to add to
      // its end, so what was written there is kept.
      ErrorsToOutput -> streams.output match
        Inherit -> appendFile("/dev/stdout") match
          Ok(f) -> streams = streams.withErrors(f)
          Err(e) ->
            streams.release()
            return Err(ioError(e))
        _ -> streams = streams.errorsToOutput()
      ErrorsTo(file, append) -> (if append then appendFile(file) else createFile(file)) match
        Ok(f) -> streams = streams.withErrors(f)
        Err(e) ->
          streams.release()
          return Err(ioError(e))
    val input = feed match
      OwnInput -> return Ok(streams)
      InputFrom(file) -> openFile(file).mapErr(ioError)
      InputText(text) -> textFile(text)
    input match
      Ok(f) -> Ok(streams.withInput(f))
      Err(e) ->
        streams.release()
        Err(e)

object Command
  // One program and its arguments, each passed as it is: no shell reads them. A program without a
  // `/` is looked for on `PATH`.
  apply(program: string, args: string*) -> Command = Command(
    Program(program, args),
    None,
    [],
    None,
    OwnOutput,
    OwnInput,
    OwnErrors,
    false
  )

  // The line split at runs of white space, the first word the program and the rest its arguments;
  // no quoting and no shell. A line with no word traps.
  parse(line: string) -> Command
    val words = Vector.newBuilder[string]()
    var word = ""
    for c in line.chars()
      if c.isWhitespace()
        if !word.isEmpty() then words.addOne(word)
        word = ""
      else
        word = word + c.toString()
    if !word.isEmpty() then words.addOne(word)
    val all = words.result()
    if all.isEmpty() then fail("a command line with no word in it")
    Command(Program(all(0), all.drop(1)), None, [], None, OwnOutput, OwnInput, OwnErrors, false)

impl string
  // The string as a command line, `Command.parse(self).run()`.
  run() -> Result[ExitStatus, IoError] = Command.parse(self).run()

  // The string as a command line, `Command.parse(self).output()`.
  output() -> Result[string, CommandError] = Command.parse(self).output()

// A command that has been started: it is waited for, asked whether it is still running, and stopped.
// It belongs to one thread at a time, as a connection does: handed to another thread's or a future's
// body, it is the body's, which may wait for it, stop it and start its later parts, and every
// operation first checks the child's owner, so the code that handed it over traps where it uses it
// again while the body runs.
class Child(private val job: Job, private val owner: Owner, private val track: Track): Sendable
  // Waits for the command to end and answers how it ended, the same answer every time.
  waitFor() -> Result[ExitStatus, IoError]
    owner.held()
    val outcome = finished(job)
    track.ended.store(true)
    outcome

  // Whether the command is still running, without waiting for it.
  isAlive() -> bool
    owner.held()
    if !job.poll() then return true
    track.ended.store(true)
    false

  // Asks every program of the command still running to stop, with the signal 15, and starts no
  // part not yet started.
  kill()
    owner.held()
    job.stop()

  // The process id of the program the command started last: its one program, a pipeline's last
  // stage, or the part of a sequence started most recently. Zero where no program was started, its
  // time having run out first. Any thread may ask, while another waits for the command.
  pid() -> long = track.pid.load()

  // The process group the command's programs run in, where it was started `inNewGroup`: the number
  // of the group its first program leads. Any thread may ask.
  group() -> Option[long] = track.group.load() match
    0 -> None
    g -> Some(g)

  // Sends the signal `sig` to the program `pid()` names. A command seen to have ended, by `waitFor`
  // or by `isAlive` answering `false`, is not signalled, its process id being free for the platform
  // to give again: that is `Err(Other("No such process"))`, as for a program that has ended
  // unseen. Any thread may signal it while another waits for it, and `kill` aside, a sequence goes on
  // to its next part as its status says.
  signal(sig: int) -> Result[unit, IoError]
    val p = track.pid.load()
    if p == 0 || track.ended.load() then return Err(ioError(Other(3)))
    sendSignal(p, sig).mapErr(ioError)

  // Sends the signal `sig` to every process in the command's group, its programs and every program
  // they started that stays in it, however the command itself has ended; a group with no one left in
  // it is `Err(Other("No such process"))`, also while the last of them has ended but not been
  // reaped (the platform may refuse a group holding only such zombies; every process in a group the
  // command made belongs to this program's user, so a refusal means that). A command not started `inNewGroup` has no group of its
  // own and is refused, `Err(Other("the command has no group of its own"))`. Any thread may signal
  // it.
  signalGroup(sig: int) -> Result[unit, IoError] = track.group.load() match
    0 -> Err(io.Other("the command has no group of its own"))
    g -> sendSignal(-g, sig) match
      Err(NotPermitted) -> Err(ioError(Other(3)))
      r -> r.mapErr(ioError)

// What the command is: one program, a pipeline, or two commands one after the other.
private data Shape
  Program(program: string, args: Vector[string])
  Piped(from: Command, into: Command)
  Joined(first: Command, joint: Joint, second: Command)

// When the second command of a sequence runs.
private data Joint
  WhenSucceeded
  WhenFailed
  Always

// Where a command's standard output goes when the command says.
private data Sink
  OwnOutput
  OutputTo(file: string, append: bool)

// Where a command's standard input comes from when the command says.
private data Feed
  OwnInput
  InputFrom(file: string)
  InputText(text: string)

// Where a command's standard error goes when the command says: to a file, or where its output goes.
private data Drain
  OwnErrors
  ErrorsTo(file: string, append: bool)
  ErrorsToOutput

// The settings a command's parts run with: the directory, the variables set for them, and when they
// are stopped, a deadline being a reading of the monotonic clock; what the command's `Child` is told
// of the programs it starts, and whether they start in a group of their own.
private class Context(
    val dir: Option[string],
    val env: Vector[EnvEdit],
    val deadline: Option[Duration],
    val track: Track,
    val grouped: bool
)
  // These settings with a part's own on top: its directory where it names one, its variables after
  // these (a name it sets replacing the one here), the earlier of the two deadlines, and a group of
  // its own where either asks for one, the outermost command's being the one every part joins.
  within(ownDir: Option[string], ownEnv: Vector[EnvEdit], limit: Option[Duration], ownGroup: bool) -> Context
    val own = limit.map(d -> time.monotonic() + d)
    val until = (deadline, own) match
      (Some(a), Some(b)) -> Some(if b < a then b else a)
      (Some(a), None) -> Some(a)
      _ -> own
    Context(ownDir.orElse(dir), env ++ ownEnv, until, track, grouped || ownGroup)

private object Context
  // The settings a command run from the program starts with: its own, and none of a command's.
  outermost(track: Track) -> Context = Context(None, [], None, track, false)

// What a started command's `Child` knows of its programs without asking them, so that any thread
// may read it while another waits: the process id of the program started last, the group its
// programs were started in (zero for none), and whether the command has been seen to end. The code
// that starts the programs writes it, whichever thread that is.
private class Track(): Sendable
  val pid: Atomic[long] = Atomic(long(0))
  val group: Atomic[long] = Atomic(long(0))
  val ended: Atomic[bool] = Atomic(false)

// A part's three streams as Sysl takes them, with the files among them this part closes once it no
// longer needs them: a pipe's end, or a file a redirection opened. Standard error sent where the
// output goes shares the output's open file, which `errorsShared` says, and the output closes.
private class Streams(
    val input: Stdio,
    val inputFile: Option[File],
    val output: Stdio,
    val outputFile: Option[File],
    val errors: Stdio,
    val errorsFile: Option[File],
    val errorsShared: bool
)
  // The same streams, for a part that does not close them: a sequence's, which closes them itself.
  lent() -> Streams = Streams(input, None, output, None, errors, None, false)

  // The same streams, reading `f`; the input replaced is closed.
  withInput(f: File) -> Streams
    closeFile(inputFile)
    Streams(FromFile(f), Some(f), output, outputFile, errors, errorsFile, errorsShared)

  // The same streams, writing the output to `f`. The output replaced is closed, unless standard error
  // still goes to it, which then closes it.
  withOutput(f: File) -> Streams
    if errorsShared then return Streams(input, inputFile, ToFile(f), Some(f), errors, outputFile, false)
    closeFile(outputFile)
    Streams(input, inputFile, ToFile(f), Some(f), errors, errorsFile, false)

  // The same streams, writing standard error to `f`; the one replaced is closed.
  withErrors(f: File) -> Streams
    if !errorsShared then closeFile(errorsFile)
    Streams(input, inputFile, output, outputFile, ToFile(f), Some(f), false)

  // The same streams, standard error going to the output's file, which the output keeps closing.
  errorsToOutput() -> Streams
    if !errorsShared then closeFile(errorsFile)
    Streams(input, inputFile, output, outputFile, output, None, outputFile.isDefined())

  release()
    closeFile(inputFile)
    closeFile(outputFile)
    closeFile(errorsFile)

private object Streams
  // The program's own three streams.
  own() -> Streams = Streams(Inherit, None, Inherit, None, Inherit, None, false)

  // The program's own input and standard error, the output going into `f`, which these streams close.
  into(f: File) -> Streams = Streams(Inherit, None, ToFile(f), Some(f), Inherit, None, false)

// Closes the descriptor the file holds and gives its Sysl value back.
private closeFile(file: Option[File]) = file match
  Some(f) ->
    f.shut()
    f.close()
  None -> ()

// A started command's status, once it has been waited for.
private finished(job: Job) -> Result[ExitStatus, IoError]
  job.finish()
  job.outcome()

// The text in a file that is then removed, opened for reading: a command's input given as text. The
// open file outlives its name.
private textFile(text: string) -> Result[File, IoError]
  val dir = fs.createTempDir("avin-input")?
  val file = dir + "/input"
  val written = fs.writeText(file, text)
  val opened = if written.isOk() then openFile(file).mapErr(ioError) else Err(written.err().get())
  fs.removeDirAll(dir)
  opened

// One change to a program's environment, made in the order the calls were.
private data EnvEdit
  SetVar(name: string, value: string)
  RemoveVar(name: string)
  ClearVars

// The variables a program is started with and whether the running program's are passed on beneath
// them. Setting and removing alone leave the running program's environment to Sysl; once the edits
// clear or remove, the whole environment is built here, as the edits leave it.
private resolveEnv(edits: Vector[EnvEdit]) -> (Vector[Var], bool)
  val needsAll = edits.exists(e -> e match
    SetVar(_, _) -> false
    _ -> true
  )
  var names: Vector[string] = []
  var values: Vector[string] = []
  if needsAll
    for (name, value) in environment()
      names = names :+ name
      values = values :+ value
  for edit in edits
    edit match
      SetVar(name, value) ->
        val at = names.indexOf(name)
        if at >= 0
          values = values.updated(at, value)
        else
          names = names :+ name
          values = values :+ value
      RemoveVar(name) ->
        val at = names.indexOf(name)
        if at >= 0
          names = names.take(at) ++ names.drop(at + 1)
          values = values.take(at) ++ values.drop(at + 1)
      ClearVars ->
        names = []
        values = []
  var vars: Vector[Var] = []
  for i in 0 ..< names.length() do vars = vars :+ Var(names(i), values(i))
  (vars, !needsAll)

// Starts one program. Its streams' files are closed once it has its own copies of them.
private startProgram(program: string, args: Vector[string], context: Context, streams: Streams) -> Result[Job, IoError]
  var millis = 0
  context.deadline match
    Some(d) ->
      val left = (d - time.monotonic()).micros
      if left <= 0
        streams.release()
        return Ok(Ended(Ok(TimedOut)))
      millis = if left >= 2147483647000 then 2147483647 else int((left + 999) / 1000)
    None -> ()
  val (vars, inherits) = resolveEnv(context.env)
  val dir = context.dir.getOrElse("")
  val spawning = (group: Group) -> spawnProgram(program, args, dir, vars, millis, inherits, streams.input, streams.output, streams.errors, group)
  var leads = false
  var started = if !context.grouped then spawning(Group.Inherit) else context.track.group.load() match
    0 ->
      leads = true
      spawning(Group.New)
    g -> spawning(Group.Join(int(g)))
  // A group whose every member has ended is gone, and joining it is refused: a sequence's later part
  // started then leads a new group, which the command's group becomes.
  val refused = started match
    Err(NotPermitted) -> context.grouped && !leads
    _ -> false
  if refused
    leads = true
    started = spawning(Group.New)
  streams.release()
  started match
    Ok(child) ->
      context.track.pid.store(long(child.pid()))
      if leads then context.track.group.store(long(child.group()))
      Ok(Process(child, context.deadline))
    Err(e) -> Err(ioError(e))

// A started command: one program, a pipeline or a sequence. `poll` moves it on without waiting and
// says whether it has ended; `finish` waits for it to end; `outcome` is its status once it has.
private abstract class Job
  // Whether a sequence inside it still has parts to start, which only `poll` or `finish` start.
  sequenced() -> bool
  poll() -> bool
  finish() -> unit
  outcome() -> Result[ExitStatus, IoError]
  stop() -> unit

// A part that ended before it began: its time ran out first.
private class Ended(private val result: Result[ExitStatus, IoError]): Job
  override sequenced() -> bool = false
  override poll() -> bool = true
  override finish() = ()
  override outcome() -> Result[ExitStatus, IoError] = result
  override stop() = ()

// One running program.
private class Process(private val child: Spawned, private val deadline: Option[Duration]): Job
  private var result: Option[Result[ExitStatus, IoError]] = None

  override sequenced() -> bool = false

  override poll() -> bool
    if result.isDefined() then return true
    // A program past its deadline is waited for, which stops it.
    val late = deadline match
      Some(d) -> time.monotonic() >= d
      None -> false
    if late
      finish()
      return true
    child.tryWait() match
      Ok(Some(status)) -> ended(Ok(status))
      Ok(None) -> return false
      Err(e) -> ended(Err(ioError(e)))
    true

  override finish()
    if result.isEmpty() then ended(child.wait().mapErr(ioError))

  override outcome() -> Result[ExitStatus, IoError] = result.get()

  override stop()
    if result.isEmpty() then child.kill(15)

  private ended(r: Result[ExitStatus, IoError])
    result = Some(r)
    child.close()

// Two parts run at once, the first's standard output the second's input.
private class Pipeline(private val from: Job, private val into: Job): Job
  override sequenced() -> bool = from.sequenced() || into.sequenced()

  override poll() -> bool
    val a = from.poll()
    val b = into.poll()
    a && b

  // Parts that are programs have all started and end by themselves; a sequence among them is moved
  // on as its parts end, both sides polled until both have ended.
  override finish()
    if sequenced()
      var pause: long = 1
      while !poll()
        threads.sleep(time.millis(pause))
        if pause < 16 then pause = pause * 2
    else
      from.finish()
      into.finish()

  override outcome() -> Result[ExitStatus, IoError] = from.outcome() match
    Err(e) -> Err(e)
    Ok(_) -> into.outcome()

  override stop()
    from.stop()
    into.stop()

// Two parts one after the other, the second started by `second` when the first ends, if `joint` says
// so. The streams are both parts', closed when the sequence ends.
private class Sequence(
    private var current: Job,
    private val joint: Joint,
    private val second: () -> Result[Job, IoError],
    private val streams: Streams
): Job
  private var started = false
  private var stopped = false
  private var result: Option[Result[ExitStatus, IoError]] = None

  override sequenced() -> bool = result.isEmpty()

  override poll() -> bool
    while result.isEmpty()
      if !current.poll() then return false
      advance()
    true

  override finish()
    while result.isEmpty()
      current.finish()
      advance()

  override outcome() -> Result[ExitStatus, IoError] = result.get()

  override stop()
    stopped = true
    current.stop()

  // The current part has ended: the second is started where the joint says so, and otherwise the
  // sequence has ended with the current part's outcome.
  private advance()
    val o = current.outcome()
    if started || stopped || !goesOn(o) then return ended(o)
    started = true
    second() match
      Ok(job) -> current = job
      Err(e) -> ended(Err(e))

  private goesOn(o: Result[ExitStatus, IoError]) -> bool = o match
    Ok(status) -> joint match
      WhenSucceeded -> status.isSuccess()
      WhenFailed -> !status.isSuccess()
      Always -> true
    Err(_) -> false

  private ended(o: Result[ExitStatus, IoError])
    result = Some(o)
    streams.release()

// A command's standard output read a line at a time from the pipe it writes into. When the output
// ends, `ending` waits for the command, and the pipe is closed.
private class OutputLines(
    private val file: File,
    private val reader: FdReader,
    private val ending: () -> unit
): Iterator[string]
  private val room = Array.fill(4096, byte(0))
  private var chunk = Array.empty[byte]()
  private var at = 0
  private var ended = false
  private var waiting: Option[string] = None

  override hasNext() -> bool
    if waiting.isEmpty() then waiting = takeLine()
    waiting.isDefined()

  override next() -> string
    if !hasNext() then fail("next on an exhausted iterator")
    val line = waiting.get()
    waiting = None
    line

  // The next line, without its terminator, or `None` once the output has ended.
  private takeLine() -> Option[string]
    val line = Buffer[byte]()
    loop
      if at == chunk.length()
        if ended then return if line.isEmpty() then None else Some(text(line))
        chunk = reader.read(room)
        at = 0
        if chunk.length() == 0 then end()
      else
        val b = chunk(at)
        at += 1
        if b == byte(10)
          if line.nonEmpty() && line(line.length() - 1) == byte(13) then line.remove(line.length() - 1)
          return Some(text(line))
        line.addOne(b)

  private text(line: Buffer[byte]) -> string = string.fromUtf8Lossy(line.toArray())

  private end()
    ended = true
    ending()
    reader.close()
    closeFile(Some(file))

// The Sysl side: its error, its open files, its processes and how their streams are given.

@sysl("sysl.fs.IoError")
private data SyslError
  NotFound
  PermissionDenied
  AlreadyExists
  NotADirectory
  IsADirectory
  DirectoryNotEmpty
  TooManyOpenFiles
  NoSpaceLeft
  Interrupted
  NotOpen
  NotPermitted
  InvalidUtf8(offset: long)
  Other(code: int)

private ioError(e: SyslError) -> IoError = e match
  NotFound -> io.NotFound
  PermissionDenied -> io.PermissionDenied
  AlreadyExists -> io.AlreadyExists
  NotADirectory -> io.NotADirectory
  IsADirectory -> io.IsADirectory
  DirectoryNotEmpty -> io.DirectoryNotEmpty
  InvalidUtf8(at) -> io.InvalidUtf8(at)
  _ -> io.Other(syslMessage(e))

// The platform's own sentence for a Sysl error, as Sysl words it.
@sysl("avin.rt.io_error_message")
private syslMessage(e: SyslError) -> string

// An open file: a pipe's end, or a file a redirection opened.
@sysl("sysl.fs.File")
private class File
  // Closes the descriptor; closing again does nothing.
  @sysl("close")
  shut() -> Result[unit, SyslError]
  fd() -> Result[int, SyslError]

@sysl("sysl.fs.create")
private createFile(file: string) -> Result[File, SyslError]

@sysl("sysl.fs.append")
private appendFile(file: string) -> Result[File, SyslError]

@sysl("sysl.fs.open")
private openFile(file: string) -> Result[File, SyslError]

@sysl("sysl.process.pipe")
private makePipe() -> Result[(File, File), SyslError]

// A descriptor read as bytes arrive, each read answering what is there rather than waiting to fill.
@sysl("sysl.io.FdReader")
private class FdReader
  @sysl(blocking)
  read(into: Array[byte]) -> Array[byte]

@sysl("sysl.io.fd_reader")
private fdReader(fd: int) -> FdReader

@sysl("sysl.process.Stdio")
private data Stdio
  Inherit
  ToFile(file: File)
  ToPath(path: string)
  FromFile(file: File)
  FromPath(path: string)

@sysl("sysl.process.Var")
private data Var(name: string, value: string)

// Who a started command belongs to: a Sysl handle holding nothing else, which moves between threads
// with the `Child` that holds it whatever the command's own handles are, a program that has ended
// and a part not yet started having none. Its traps name the `Child`.
@sysl("avin.rt.Token", named: "Child")
private class Owner
  // Does nothing: calling it checks the child belongs to the code running.
  held() -> unit

@sysl("avin.rt.token")
private newOwner() -> Owner

// A started program, which ends it if it is collected before it has been waited for.
@sysl("sysl.process.Spawned")
private class Spawned
  @sysl(blocking)
  wait() -> Result[ExitStatus, SyslError]
  tryWait() -> Result[Option[ExitStatus], SyslError]
  kill(signal: int) -> Result[unit, SyslError]
  pid() -> int
  group() -> int

@sysl("sysl.process.spawn")
private spawnProgram(
    program: string,
    args: Vector[string],
    dir: string,
    env: Vector[Var],
    timeout: int,
    inheritEnv: bool,
    stdin: Stdio,
    stdout: Stdio,
    stderr: Stdio,
    group: Group
) -> Result[Spawned, SyslError]

// The process group a program starts in: this program's, a new one it leads, or one already there.
@sysl("sysl.process.Group")
private data Group
  Inherit
  New
  Join(pgid: int)
