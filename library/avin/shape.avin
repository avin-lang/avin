module avin

// Shapes: what the compiler tells a derive template about a data type or a class. A shape is plain
// data, made once for each type before `main`: the type's variants in declaration order, each with
// its fields, and the annotations written on the type, its variants and its fields. A class has one
// variant, of its name, whose fields are its constructor parameters.

// A value written with `@` before a type, a variant or a field, kept in the shape for a template to
// read: `@JsonKey("full_name") name: string`. A shape is one value for the whole program, read by
// whichever thread runs the code a template made, so an annotation is sendable.
trait Annotation: Sendable

data TypeShape(name: string, variantCount: int, variants: Vector[VariantShape], annotations: Vector[Annotation])

data VariantShape(
    name: string,
    index: int,
    fieldCount: int,
    fields: Vector[FieldShape],
    annotations: Vector[Annotation]
)

data FieldShape(name: string, index: int, hasDefault: bool, annotations: Vector[Annotation])

// Each shape answers `annotation[A]()`, the first of its annotations of type `A`, and `has(a)`,
// whether `a` is among them by `==`.
impl TypeShape
  annotation[A: Annotation]() -> Option[A] = firstAnnotation[A](annotations)
  has(a: Annotation) -> bool = annotations.exists(b -> b == a)

impl VariantShape
  annotation[A: Annotation]() -> Option[A] = firstAnnotation[A](annotations)
  has(a: Annotation) -> bool = annotations.exists(b -> b == a)

impl FieldShape
  annotation[A: Annotation]() -> Option[A] = firstAnnotation[A](annotations)
  has(a: Annotation) -> bool = annotations.exists(b -> b == a)

private firstAnnotation[A: Annotation](items: Vector[Annotation]) -> Option[A]
  for a in items
    a match
      found: A -> return Some(found)
      _ -> ()
  None

// What a derive template's `T` has besides the derived trait: its shape, and code written for its
// own fields. Only a template names it, as the bound its `T` has.
//
// - `walk` calls `visitor.variant` with the value's variant, then the visitor's `field` once per field
//   of that variant, in order, at the field's own type, then `finish` with the variant, each call
//   taking the visitor the one before returned.
// - `walkPair` calls `visitor.variants` with both values' variants, then, where they are the same
//   variant, the visitor's `field` once per field with both values' fields.
// - `build` makes a value from what `builder` supplies: the variant, then the fields in any order, a
//   field never supplied taking its default or the builder's `missing`.
trait Shaped
  static shape() -> TypeShape
  static variantOf(value: Self) -> VariantShape
  static walk[V: ShapeVisitor](value: Self, visitor: V) -> V
  static walkPair[V: ShapePairVisitor](a: Self, b: Self, visitor: V) -> V
  static build[B: ShapeBuilder[E], E](builder: B) -> Result[Self, E]

// A visitor of one value's fields. Its type also declares `field[F: Bound](f: FieldShape, value: F) ->
// Self`, with one type parameter of its own, whose bound each field's type must meet.
trait ShapeVisitor
  variant(v: VariantShape) -> Self

  // Called after the variant's last field; a visitor that has nothing to end keeps this one.
  finish(v: VariantShape) -> Self = self

// A visitor of two values' fields side by side. Its type also declares `field[F: Bound](f:
// FieldShape, a: F, b: F) -> Self`.
trait ShapePairVisitor
  variants(a: VariantShape, b: VariantShape) -> Self

// What `build` reads a value from: the index of the variant to make, the index of the next field
// supplied (`None` when there are no more), and the error for a field supplied twice. Its type also
// declares `field[F: Bound](f: FieldShape) -> Result[F, E]`, reading that field's value, and
// `missing[F: Bound](f: FieldShape) -> Result[F, E]`, deciding a field never supplied that has no
// default.
trait ShapeBuilder[E]
  variant(t: TypeShape) -> Result[int, E]
  next(v: VariantShape) -> Result[Option[int], E]
  duplicate(f: FieldShape) -> E
