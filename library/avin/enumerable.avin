module avin

// An enumeration: a data type whose variants have no fields, each value being one of its variants.
// `derives Enumerable` gives the type its variants as values, in declaration order, each one's
// position and name, and the variant of a name.
//
// - `T.values()` is every variant, in declaration order, as a new vector.
// - `ordinal()` is the variant's 0-based position in the declaration.
// - `name()` is the variant's name exactly as declared, whatever its `Display` writes.
// - `T.valueOf(name)` is the variant of exactly that name, or `None`; names are compared byte for
//   byte, so case and every character count.
//
// Only a data type without type parameters whose every variant has no fields derives it; the
// compiler refuses any other at the `derives` entry.
trait Enumerable
  static values -> Vector[Self]
  ordinal -> int
  name -> string
  static valueOf(name: string) -> Option[Self]

// A variant without fields is built from its position alone, so each build succeeds.
derive Enumerable for T
  static values -> Vector[T] = Vector.tabulate(T.shape().variantCount, i -> T.build(ChooseVariant(i)).ok.get)
  ordinal -> int = T.variantOf(self).index
  name -> string = T.variantOf(self).name
  static valueOf(name: string) -> Option[T] =
    for v in T.shape().variants
      if v.name == name then return T.build(ChooseVariant(v.index)).ok
    None

// A builder that chooses the variant at `index` and supplies no fields.
private data ChooseVariant(index: int)

impl ShapeBuilder[unit] for ChooseVariant
  variant(t: TypeShape) -> Result[int, unit] = Ok(index)
  next(v: VariantShape) -> Result[Option[int], unit] = Ok(None)
  duplicate(f: FieldShape) -> unit = ()

impl ChooseVariant
  field[F: Enumerable](f: FieldShape) -> Result[F, unit] = Err(())
  missing[F: Enumerable](f: FieldShape) -> Result[F, unit] = Err(())
