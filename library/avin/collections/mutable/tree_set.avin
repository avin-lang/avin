module avin.collections.mutable

import avin.{TreeSet as ImmutableTreeSet}

// A mutable set kept in the order of its elements' `compare`, so any `Ord` type can be an element.
// It holds an immutable `TreeSet` and replaces it at every update: an update, a lookup and each
// ordered query take time in the logarithm of the size, and `toTreeSet()` hands out the current tree
// in constant time, a snapshot that later updates do not reach. Iteration visits the elements in
// ascending order, and an iterator made before an update goes on over the elements as they were
// then. A set is the predicate of membership, `(A) -> bool`.
class TreeSet[A: Ord]: Iterable[A], (A) -> bool
    private var tree = ImmutableTreeSet.empty[A]()

    // The number of elements.
    override size() -> int = tree.size()

    // The number of elements, which the set holds: the same as `size()`.
    override knownSize() -> int = tree.size()

    isEmpty() -> bool = tree.isEmpty()

    nonEmpty() -> bool = tree.nonEmpty()

    contains(element: A) -> bool = tree.contains(element)

    // Whether `element` is in the set: `s(x)` is `s.contains(x)`.
    apply(element: A) -> bool = tree.contains(element)

    // Adds `element`, answering whether it was absent.
    add(element: A) -> bool
        if tree.contains(element) then return false
        tree = tree.incl(element)
        true

    // Removes `element`, answering whether it was present.
    remove(element: A) -> bool
        if !tree.contains(element) then return false
        tree = tree.excl(element)
        true

    // Removes every element.
    clear()
        tree = ImmutableTreeSet.empty[A]()

    // Adds every element of `elements`.
    addAll(elements: Iterable[A])
        for x in elements do tree = tree.incl(x)

    // Adds `element`: `s += x`, which needs no `var`.
    +=(element: A)
        tree = tree.incl(element)

    // Removes `element` if it is present: `s -= x`.
    -=(element: A)
        tree = tree.excl(element)

    // Adds every element of `elements`: `s ++= xs`.
    ++=(elements: Iterable[A]) = addAll(elements)

    // Removes every element of `elements` that is present: `s --= xs`. A set with itself removed is
    // empty.
    --=(elements: Iterable[A])
        if elements === self then return clear()
        for x in elements do tree = tree.excl(x)

    // Removes every element that does not satisfy `p`.
    filterInPlace(p: (A) -> bool)
        tree = tree.filter(p)

    // A new set of the elements in this set, in `other`, or in both.
    union(other: TreeSet[A]) -> TreeSet[A] = fromTree(tree ++ other)

    // A new set of the elements in both this set and `other`.
    intersect(other: TreeSet[A]) -> TreeSet[A] = filter(x -> other.contains(x))

    // A new set of the elements in this set and not in `other`.
    diff(other: TreeSet[A]) -> TreeSet[A] = filter(x -> !other.contains(x))

    // Whether every element of this set is in `other`.
    subsetOf(other: TreeSet[A]) -> bool
        if size() > other.size() then return false
        for x in tree
            if !other.contains(x) then return false
        true

    // A new set of `f` of each element; elements that `f` maps alike become one.
    map[B: Ord](f: (A) -> B) -> TreeSet[B] = TreeSet.fromTree(tree.map(f))

    // A new set of the elements of the collections `f` makes of each element.
    flatMap[B: Ord](f: (A) -> Iterable[B]) -> TreeSet[B] = TreeSet.fromTree(tree.flatMap(f))

    // The elements that satisfy `p`, tested only as `map`, `flatMap` or `foreach` reaches each one.
    withFilter(p: (A) -> bool) -> FilteredTreeSet[A] = FilteredTreeSet(self, p)

    // Calls `f` with each element, in ascending order.
    foreach(f: (A) -> unit)
        for x in tree do f(x)

    // A new set of the elements that satisfy `p`.
    filter(p: (A) -> bool) -> TreeSet[A] = fromTree(tree.filter(p))

    // A new set of the same elements.
    copy() -> TreeSet[A] = fromTree(tree)

    // The immutable tree set of the elements now in this one, in constant time.
    toTreeSet() -> ImmutableTreeSet[A] = tree

    // The elements in ascending order. The iterator goes over the elements as they are when it is
    // made.
    override iterator() -> Iterator[A] = tree.iterator()

    // The elements in descending order.
    reverseIterator() -> Iterator[A] = tree.reverseIterator()

    // The least element, or `None` when the set is empty.
    override headOption() -> Option[A] = tree.headOption()

    // The greatest element, or `None` when the set is empty.
    override lastOption() -> Option[A] = tree.lastOption()

    // The least element; traps when the set is empty.
    override head() -> A = tree.headOption() match
        Some(x) -> x
        None -> fail("head of an empty set")

    // The greatest element; traps when the set is empty.
    override last() -> A = tree.lastOption() match
        Some(x) -> x
        None -> fail("last of an empty set")

    // The least element; traps when the set is empty.
    firstKey() -> A = head()

    // The greatest element; traps when the set is empty.
    lastKey() -> A = last()

    // Removes the least element, answering it; traps when the set is empty.
    removeFirst() -> A
        val x = head()
        tree = tree.excl(x)
        x

    // Removes the greatest element, answering it; traps when the set is empty.
    removeLast() -> A
        val x = last()
        tree = tree.excl(x)
        x

    // Removes the least element, answering it, or `None` when the set is empty.
    removeFirstOption() -> Option[A]
        val x = tree.headOption()
        if x is Some(e) then tree = tree.excl(e)
        x

    // Removes the greatest element, answering it, or `None` when the set is empty.
    removeLastOption() -> Option[A]
        val x = tree.lastOption()
        if x is Some(e) then tree = tree.excl(e)
        x

    // The least element at least `x`, or `None` when every element is less.
    minAfter(x: A) -> Option[A] = tree.minAfter(x)

    // The greatest element less than `x`, or `None` when no element is less.
    maxBefore(x: A) -> Option[A] = tree.maxBefore(x)

    // A new set of the elements at least `low`.
    rangeFrom(low: A) -> TreeSet[A] = fromTree(tree.rangeFrom(low))

    // A new set of the elements at most `high`.
    rangeTo(high: A) -> TreeSet[A] = fromTree(tree.rangeTo(high))

    // A new set of the elements less than `high`.
    rangeUntil(high: A) -> TreeSet[A] = fromTree(tree.rangeUntil(high))

    // A new set of the elements at least `low` and less than `high`; none when `high` is not greater
    // than `low`.
    range(low: A, high: A) -> TreeSet[A] = fromTree(tree.range(low, high))

    private fromTree(t: ImmutableTreeSet[A]) -> TreeSet[A] = TreeSet.fromTree(t)

// A mutable tree set seen through a test, which a guard of a `for` with `yield` makes: each element
// is tested just before the call after it would use it, in ascending order. What it makes is a new
// mutable tree set.
class FilteredTreeSet[A: Ord](private val set: TreeSet[A], private val p: (A) -> bool)
    // A new set of `f` of each element that passes the test.
    map[B: Ord](f: (A) -> B) -> TreeSet[B]
        val result = TreeSet[B]()
        for x in set
            if p(x) then result.add(f(x))
        result

    // A new set of the elements of the collections `f` makes of each element that passes the test.
    flatMap[B: Ord](f: (A) -> Iterable[B]) -> TreeSet[B]
        val result = TreeSet[B]()
        for x in set
            if p(x) then result.addAll(f(x))
        result

    // The elements that pass this test and then `q`.
    withFilter(q: (A) -> bool) -> FilteredTreeSet[A] = FilteredTreeSet(set, x -> p(x) && q(x))

    // Calls `f` with each element that passes the test.
    foreach(f: (A) -> unit)
        for x in set
            if p(x) then f(x)

// Two mutable tree sets are equal when they hold the same elements at the moment they are compared.
impl[A] Eq for TreeSet[A]
    equals(other: TreeSet[A]) -> bool = toTreeSet() == other.toTreeSet()

// A sum over the elements, which agrees with an immutable tree set's of the same elements.
impl[A: Hash] Hash for TreeSet[A]
    hash() -> long = toTreeSet().hash()

// Displays as `{1, 2, 3}`, in ascending order, as an immutable set does.
impl[A: Display] Display for TreeSet[A]
    display(out: Writer, spec: FormatSpec)
        writeElement(w: Writer, x: A) = x.display(w, FormatSpec())
        writeBraced(out, spec, iterator(), writeElement)

// The diagnostic form is `{"a", "b"}`, as an immutable set's is.
impl[A: Debug] Debug for TreeSet[A]
    debug(out: Writer, spec: FormatSpec)
        writeElement(w: Writer, x: A) = x.debug(w, FormatSpec())
        writeBraced(out, spec, iterator(), writeElement)

object TreeSet
    // A new, empty set.
    empty[A: Ord]() -> TreeSet[A] = TreeSet[A]()

    // A new set of the elements given.
    apply[A: Ord](elements: A*) -> TreeSet[A]
        val result = TreeSet[A]()
        for x in elements do result.add(x)
        result

    // A new set holding the elements of an immutable tree set.
    fromTree[A: Ord](t: ImmutableTreeSet[A]) -> TreeSet[A]
        val result = TreeSet[A]()
        result.tree = t
        result

    // A builder of a mutable tree set: the elements it is given, each held once. It is typed as a
    // `Builder` of sets, so a literal where a `TreeSet[A]` is expected gives the call its `A`.
    newBuilder[A: Ord]() -> Builder[A, TreeSet[A]] = TreeSetBuilder[A]()

// Builds a mutable tree set by adding to it.
class TreeSetBuilder[A: Ord]: Builder[A, TreeSet[A]]
    private var set = TreeSet[A]()
    private var spent = false

    override addOne(element: A)
        if spent then fail("add to a builder whose result was taken")
        set.add(element)

    override result() -> TreeSet[A]
        if spent then fail("result of a builder whose result was taken")
        spent = true
        set

    // Starts a new set, leaving one already handed over as it is.
    override clear()
        set = TreeSet[A]()
        spent = false

    override knownSize() -> int = set.size()
