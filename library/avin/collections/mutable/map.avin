module avin.collections.mutable

import avin.{Map as ImmutableMap, Set as ImmutableSet}

// A mutable map from keys to values, each key present at most once, found by its hash and compared
// with `==`. `m(key) = value` binds a key and `remove` unbinds one, in place. The entries sit in an
// open-addressed table, probed linearly from the slot the key's spread hash picks, and the table
// doubles before it is two thirds full; a removal moves later entries of the same run back, so no
// slot is ever marked deleted. Iteration visits the entries in table order, which depends on the
// keys' hashes and the order of the updates, not on any order the program can rely on. A map is the
// function `(K) -> V` from its keys to their values, its `apply`.
class Map[K: Eq + Hash, V]: Iterable[(K, V)], (K) -> V
    // The table has `mask + 1` slots, a power of two, and slot `i` holds an entry when `hashes(i)` is
    // not 0, its key and value at `i` in `slotKeys` and `slotValues`. The arrays have one element more,
    // past the slots: the first key and value the map was given, which every slot without an entry
    // holds too, so that every element of the arrays is a value and none holds on to a removed entry.
    private var hashes = Array.empty[long]()
    private var slotKeys = Array.empty[K]()
    private var slotValues = Array.empty[V]()
    private var mask = 0
    private var count = 0

    // The number of entries.
    override size -> int = count

    // The number of entries, which the map holds: the same as `size`.
    override knownSize -> int = count

    isEmpty -> bool = count == 0

    nonEmpty -> bool = count != 0

    // The value bound to `key`, or `None` when there is none.
    get(key: K) -> Option[V]
        val i = find(key, slotHash(key))
        if i < 0 then None else Some(slotValues(i))

    // The value bound to `key`, which traps when there is none.
    apply(key: K) -> V
        val i = find(key, slotHash(key))
        if i < 0 then fail("key not found in the map")
        slotValues(i)

    // The value bound to `key`, or `default`, which is evaluated only when there is none.
    getOrElse(key: K, default: -> V) -> V
        val i = find(key, slotHash(key))
        if i < 0 then default else slotValues(i)

    contains(key: K) -> bool = find(key, slotHash(key)) >= 0

    // Binds `key` to `value`, replacing the value it had; `m(key) = value` calls it.
    update(key: K, value: V)
        val h = slotHash(key)
        val i = find(key, h)
        if i >= 0
            slotValues(i) = value
            return
        if hashes.length == 0 || (count + 1) * 3 > (mask + 1) * 2 then grow(key, value)
        place(h, key, value)
        count += 1

    // The value bound to `key`; when there is none, `default` is evaluated, bound to `key` and
    // returned.
    getOrElseUpdate(key: K, default: -> V) -> V
        val i = find(key, slotHash(key))
        if i >= 0 then return slotValues(i)
        val value = default
        update(key, value)
        value

    // Unbinds `key`, answering the value it had, or `None` when it had none.
    remove(key: K) -> Option[V]
        var i = find(key, slotHash(key))
        if i < 0 then return None
        val removed = slotValues(i)
        var j = (i + 1) & mask
        // Each later entry of the run moves back into the hole unless the slot its hash picks lies
        // after the hole, where a lookup for it would never reach the hole.
        while hashes(j) != 0
            val home = int(hashes(j) & long(mask))
            if ((j - home) & mask) >= ((j - i) & mask)
                hashes(i) = hashes(j)
                slotKeys(i) = slotKeys(j)
                slotValues(i) = slotValues(j)
                i = j
            j = (j + 1) & mask
        vacate(i)
        count -= 1
        Some(removed)

    // Removes every entry, keeping the table's capacity.
    clear()
        for i in 0..<hashes.length
            if hashes(i) != 0 then vacate(i)
        count = 0

    // Binds every key of `entries` to its value, in order.
    addAll(entries: Iterable[(K, V)])
        for (k, v) in entries do update(k, v)

    // The keys, in iteration order.
    keysIterator() -> Iterator[K] = TableKeys(hashes, slotKeys)

    // The values, in iteration order.
    valuesIterator() -> Iterator[V] = TableValues(hashes, slotValues)

    // The keys in iteration order, as a vector snapshot.
    keys -> Vector[K] = keysIterator().toVector

    // The values in iteration order, as a vector snapshot: the value at each index belongs to the
    // key at the same index of `keys`.
    values -> Vector[V] = valuesIterator().toVector

    // An immutable set of the keys, a snapshot.
    keySet -> ImmutableSet[K]
        var result = ImmutableSet[K]()
        for k in keysIterator() do result = result.incl(k)
        result

    // Calls `f` with each key and its value.
    foreach(f: (K, V) -> unit)
        for i in 0..<hashes.length
            if hashes(i) != 0 then f(slotKeys(i), slotValues(i))

    // Binds `key` to `value`: `m += (key, value)`, which needs no `var`.
    +=(entry: (K, V))
        update(entry.0, entry.1)

    // Unbinds `key` if it is bound: `m -= key`.
    -=(key: K)
        remove(key)
        ()

    // Binds every key of `entries` to its value, in order: `m ++= entries`.
    ++=(entries: Iterable[(K, V)]) = addAll(entries)

    // Unbinds every key of `ks` that is bound: `m --= ks`.
    --=(ks: Iterable[K])
        for k in ks do remove(k)

    // Replaces the value of `key` by what `f` makes of the value it has now, or of `None` when it has
    // none: `Some(v)` binds `key` to `v` and `None` leaves it unbound. Answers the new binding.
    updateWith(key: K, f: (Option[V]) -> Option[V]) -> Option[V]
        val updated = f(get(key))
        updated match
            Some(v) -> update(key, v)
            None -> remove(key)
        updated

    // Unbinds every entry whose key and value do not satisfy `p`.
    filterInPlace(p: (K, V) -> bool)
        val doomed = Buffer[K]()
        foreach((k, v) -> if !p(k, v) then doomed.addOne(k))
        for k in doomed do remove(k)

    // A new map of the entries whose key satisfies `p`.
    filterKeys(p: (K) -> bool) -> Map[K, V] = filter((k, v) -> p(k))

    // A new map of the same keys, each bound to `f` of its value.
    mapValues[W](f: (V) -> W) -> Map[K, W]
        val result = Map[K, W]()
        foreach((k, v) -> result(k) = f(v))
        result

    // A new map of the same keys, each bound to `f` of the key and its value.
    transform[W](f: (K, V) -> W) -> Map[K, W]
        val result = Map[K, W]()
        foreach((k, v) -> result(k) = f(k, v))
        result

    // A new map of the pairs `f` makes of each entry; where two make the same key, the later in
    // iteration order is kept.
    map[L, W](f: (K, V) -> (L, W)) -> Map[L, W]
        val result = Map[L, W]()
        foreach((k, v) -> result += f(k, v))
        result

    // A new map of the pairs `f` makes of each entry, given as a pair, as a `for` with `yield` gives
    // it; where two make the same key, the later in iteration order is kept.
    map[L, W](f: ((K, V)) -> (L, W)) -> Map[L, W]
        val result = Map[L, W]()
        for entry in iterator() do result += f(entry)
        result

    // A new map of the pairs in the collections `f` makes of each entry.
    flatMap[L, W](f: ((K, V)) -> Iterable[(L, W)]) -> Map[L, W]
        val result = Map[L, W]()
        for entry in iterator() do result ++= f(entry)
        result

    // The entries that satisfy `p`, tested only as `map`, `flatMap` or `foreach` reaches each one.
    withFilter(p: ((K, V)) -> bool) -> FilteredMap[K, V] = FilteredMap(self, p)

    // A new map of the entries whose key and value satisfy `p`.
    filter(p: (K, V) -> bool) -> Map[K, V]
        val result = Map[K, V]()
        foreach((k, v) -> if p(k, v) then result(k) = v)
        result

    // A new map of the same entries.
    copy() -> Map[K, V]
        val result = Map[K, V]()
        foreach((k, v) -> result(k) = v)
        result

    // An immutable map of the same entries.
    toMap -> ImmutableMap[K, V]
        var result = ImmutableMap[K, V]()
        foreach((k, v) -> result = result.updated(k, v))
        result

    // The entries as `(key, value)` pairs, in table order.
    override iterator() -> Iterator[(K, V)] = TableEntries(hashes, slotKeys, slotValues)

    // The index of `key`'s slot, or -1 when it has none.
    private find(key: K, h: long) -> int
        if count == 0 then return -1
        var i = int(h & long(mask))
        while hashes(i) != 0
            if hashes(i) == h && slotKeys(i) == key then return i
            i = (i + 1) & mask
        -1

    // Puts an entry in the first free slot of its run, which there must be.
    private place(h: long, key: K, value: V)
        var i = int(h & long(mask))
        while hashes(i) != 0 do i = (i + 1) & mask
        hashes(i) = h
        slotKeys(i) = key
        slotValues(i) = value

    // Empties slot `i`, giving it the filler's key and value.
    private vacate(i: int)
        hashes(i) = 0
        slotKeys(i) = slotKeys(mask + 1)
        slotValues(i) = slotValues(mask + 1)

    // Doubles the table, or makes the first one, whose filler is `key` and `value`.
    private grow(key: K, value: V)
        val oldHashes = hashes
        val oldKeys = slotKeys
        val oldValues = slotValues
        val first = oldHashes.length == 0
        val capacity = if first then 8 else (mask + 1) * 2
        val fillKey = if first then key else oldKeys(mask + 1)
        val fillValue = if first then value else oldValues(mask + 1)
        hashes = Array.fill(capacity + 1, long(0))
        slotKeys = Array.fill(capacity + 1, fillKey)
        slotValues = Array.fill(capacity + 1, fillValue)
        mask = capacity - 1
        for i in 0..<oldHashes.length
            if oldHashes(i) != 0 then place(oldHashes(i), oldKeys(i), oldValues(i))

// A mutable map seen through a test of its entries, which a guard of a `for` with `yield` makes: each
// entry is tested just before the call after it would use it, so a guard runs in turn with the rest of
// the comprehension, entry by entry. What it makes is a new mutable map.
class FilteredMap[K: Eq + Hash, V](private val source: Map[K, V], private val p: ((K, V)) -> bool)
    // A new map of the pairs `f` makes of each entry that passes the test.
    map[L, W](f: ((K, V)) -> (L, W)) -> Map[L, W]
        val result = Map[L, W]()
        for entry in source
            if p(entry) then result += f(entry)
        result

    // A new map of the pairs in the collections `f` makes of each entry that passes the test.
    flatMap[L, W](f: ((K, V)) -> Iterable[(L, W)]) -> Map[L, W]
        val result = Map[L, W]()
        for entry in source
            if p(entry) then result ++= f(entry)
        result

    // The entries that pass this test and then `q`.
    withFilter(q: ((K, V)) -> bool) -> FilteredMap[K, V] = FilteredMap(source, e -> p(e) && q(e))

    // Calls `f` with each entry that passes the test.
    foreach(f: ((K, V)) -> unit)
        for entry in source
            if p(entry) then f(entry)

// Two mutable maps are equal when they hold the same keys bound to equal values at the moment they are
// compared, as arrays compare by their contents; `===` tells two maps apart.
impl[K, V: Eq] Eq for Map[K, V]
    equals(other: Map[K, V]) -> bool
        if size != other.size then return false
        for (k, v) in self
            other.get(k) match
                Some(w) -> if w != v then return false
                None -> return false
        true

// A sum over the entries, so that the hash does not depend on the table's order.
impl[K, V: Hash] Hash for Map[K, V]
    hash() -> long
        var h: long = 0
        for (k, v) in self do h = h +% spreadHash(k.hash() *% 31 +% v.hash())
        h

// Displays as `{a: 1, b: 2}`, as an immutable map does.
impl[K: Display, V: Display] Display for Map[K, V]
    display(out: Writer, spec: FormatSpec)
        writeEntry(w: Writer, entry: (K, V))
            entry.0.display(w, FormatSpec())
            w.write(": ")
            entry.1.display(w, FormatSpec())
        writeBraced(out, spec, iterator(), writeEntry)

// The diagnostic form is `{"a": 1}`, as an immutable map's is.
impl[K: Debug, V: Debug] Debug for Map[K, V]
    debug(out: Writer, spec: FormatSpec)
        writeEntry(w: Writer, entry: (K, V))
            entry.0.debug(w, FormatSpec())
            w.write(": ")
            entry.1.debug(w, FormatSpec())
        writeBraced(out, spec, iterator(), writeEntry)

// Writes `items` between braces, separated by commas, each by `item`, padded as a whole to the field
// `spec` describes: the rendering of maps and sets, which mirrors their literals.
private writeBraced[T](out: Writer, spec: FormatSpec, items: Iterator[T], item: (Writer, T) -> unit)
    if spec.width > 0
        val text = StringWriter()
        writeBraced(text, FormatSpec(), items, item)
        out.writeField(text.text(), spec)
        return
    out.write("{")
    var first = true
    for x in items
        if !first then out.write(", ")
        item(out, x)
        first = false
    out.write("}")

// Steps through the occupied slots of a table.
private class TableEntries[K, V](hashes: Array[long], keys: Array[K], values: Array[V]): Iterator[(K, V)]
    private var index = nextOccupied(hashes, 0)

    override hasNext() -> bool = index < hashes.length

    override next() -> (K, V)
        if index >= hashes.length then fail("next on an exhausted iterator")
        val entry = (keys(index), values(index))
        index = nextOccupied(hashes, index + 1)
        entry

private class TableKeys[K](hashes: Array[long], keys: Array[K]): Iterator[K]
    private var index = nextOccupied(hashes, 0)

    override hasNext() -> bool = index < hashes.length

    override next() -> K
        if index >= hashes.length then fail("next on an exhausted iterator")
        val key = keys(index)
        index = nextOccupied(hashes, index + 1)
        key

private class TableValues[V](hashes: Array[long], values: Array[V]): Iterator[V]
    private var index = nextOccupied(hashes, 0)

    override hasNext() -> bool = index < hashes.length

    override next() -> V
        if index >= hashes.length then fail("next on an exhausted iterator")
        val value = values(index)
        index = nextOccupied(hashes, index + 1)
        value

// The first occupied slot at or after `from`, or the table's length when there is none.
private nextOccupied(hashes: Array[long], from: int) -> int
    var i = from
    while i < hashes.length && hashes(i) == 0 do i += 1
    i

// The hash a table stores for `key`: its spread hash, with 0, which marks a free slot, moved to 1.
private slotHash[K: Hash](key: K) -> long
    val h = spreadHash(key.hash())
    if h == 0 then 1 else h

// Spreads a hash over all 64 bits, so that hashes forming a sequence, or differing only in their
// high bits, still differ in the low bits a table's slot is chosen by. It is the finalizer of
// MurmurHash3, each step a bijection, so distinct hashes stay distinct.
private spreadHash(h: long) -> long
    var x = h ^ ((h >> 33) & 0x7fffffff)
    x = x *% -0x00ae502812aa7333
    x = x ^ ((x >> 33) & 0x7fffffff)
    x = x *% -0x3b314601e57a13ad
    x ^ ((x >> 33) & 0x7fffffff)

// Stops the program with `reason` as the trap's message.
@intrinsic("trap")
private fail(reason: string) -> Nothing

object Map
    // A new, empty map.
    empty[K: Eq + Hash, V]() -> Map[K, V] = Map[K, V]()

    // A new map of the pairs of `pairs`, a later pair's value replacing an earlier one's for the same
    // key.
    from[K: Eq + Hash, V](pairs: Iterable[(K, V)]) -> Map[K, V]
        val result = Map[K, V]()
        for (k, v) in pairs do result(k) = v
        result

    // A builder of a mutable map: the pairs it is given, a later pair's value replacing an earlier
    // one's for the same key. It is typed as a `Builder` of maps, so a literal where a `Map[K, V]` is
    // expected gives the call its `K` and `V`.
    newBuilder[K, V]() -> Builder[(K, V), Map[K, V]] = MapBuilder[K, V]()

// Builds a mutable map by storing each pair in it.
class MapBuilder[K: Eq + Hash, V]: Builder[(K, V), Map[K, V]]
    private var map = Map[K, V]()
    private var spent = false

    override addOne(element: (K, V))
        if spent then fail("add to a builder whose result was taken")
        map(element.0) = element.1

    override result() -> Map[K, V]
        if spent then fail("result of a builder whose result was taken")
        spent = true
        map

    // Starts a new map, leaving one already handed over as it is.
    override clear()
        map = Map[K, V]()
        spent = false

    override knownSize -> int = map.size
