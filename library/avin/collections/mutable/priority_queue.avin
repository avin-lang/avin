module avin.collections.mutable

// A mutable priority queue: elements go in in any order and come out greatest first, by a
// comparison given when the queue is made. `PriorityQueue[int]()` orders by the element type's own
// `compare`; `PriorityQueue.withOrdering(compare)` takes a comparison, and `Reverse` or a
// `reverseOrder` of one makes a queue that gives the least first. `enqueue` and `dequeue` take
// O(log n); `head` and `size` take constant time.
//
// The elements are kept as a binary heap in one buffer: the greatest is at the front and each
// element is not less than its two children. Elements the comparison finds equal come out in no
// promised order, and not in the order they went in. A queue is `Iterable`, and iterates in heap
// order, which is not sorted: only the first element, the one `dequeue` would give, is known to be
// the greatest. An iterator sees the elements the queue held when it was made, whatever is
// enqueued or dequeued while it runs. `toSortedVector()` is the elements in the order `dequeue`
// gives them, without taking them out.
class PriorityQueue[T](private val order: (T, T) -> int): Iterable[T]
    private val heap = Buffer[T]()

    // The number of elements.
    override size -> int = heap.length

    // The number of elements, which the queue holds: the same as `size`.
    override knownSize -> int = heap.length

    isEmpty -> bool = heap.length == 0

    nonEmpty -> bool = heap.length != 0

    // Puts each of `elements` in the queue.
    enqueue(elements: T*)
        for x in elements do addOne(x)

    // Puts `element` in the queue.
    addOne(element: T)
        heap.addOne(element)
        siftUp(heap.length - 1)

    // Puts every element of `elements` in the queue. A queue added to itself doubles each element.
    addAll(elements: Iterable[T])
        for x in elements.toVector do addOne(x)

    // Puts `element` in the queue: `q += x`, which needs no `var`.
    +=(element: T) = addOne(element)

    // Puts every element of `elements` in the queue: `q ++= xs`.
    ++=(elements: Iterable[T]) = addAll(elements)

    // The greatest element, left in the queue. Traps where the queue is empty.
    override head -> T
        if heap.length == 0 then fail("head of an empty priority queue")
        heap(0)

    // The greatest element, left in the queue, or `None` where the queue is empty.
    override headOption -> Option[T] = if heap.length == 0 then None else Some(heap(0))

    // Takes out and answers the greatest element. Traps where the queue is empty.
    dequeue() -> T
        if heap.length == 0 then fail("dequeue from an empty priority queue")
        val top = heap(0)
        val last = heap.remove(heap.length - 1)
        if heap.length > 0
            heap(0) = last
            siftDown(0)
        top

    // Takes out and answers the greatest element, or answers `None` where the queue is empty.
    dequeueOption() -> Option[T] = if heap.length == 0 then None else Some(dequeue())

    // Takes out every element and answers them greatest first, leaving the queue empty.
    dequeueAll() -> Vector[T]
        val out = Buffer[T]()
        while heap.length > 0 do out.addOne(dequeue())
        out.toVector

    // Removes every element.
    clear() = heap.clear()

    // A new queue of the same elements and the same comparison.
    copy() -> PriorityQueue[T]
        val result = PriorityQueue[T](order)
        for x in heap do result.heap.addOne(x)
        result

    // The elements in the order the queue holds them, the greatest first and the rest not sorted.
    override iterator() -> Iterator[T] = heap.toVector.iterator()

    // The elements greatest first, the order `dequeueAll` gives them, leaving the queue as it is.
    toSortedVector() -> Vector[T] = copy().dequeueAll()

    private siftUp(from: int)
        var i = from
        val x = heap(i)
        while i > 0
            val parent = (i - 1) / 2
            if order(x, heap(parent)) <= 0 then break
            heap(i) = heap(parent)
            i = parent
        heap(i) = x

    private siftDown(from: int)
        val n = heap.length
        var i = from
        val x = heap(i)
        while 2 * i + 1 < n
            var child = 2 * i + 1
            if child + 1 < n && order(heap(child + 1), heap(child)) > 0 then child += 1
            if order(heap(child), x) <= 0 then break
            heap(i) = heap(child)
            i = child
        heap(i) = x

object PriorityQueue
    // A new, empty queue that gives the greatest element first by the elements' own order.
    apply[T: Ord]() -> PriorityQueue[T] = PriorityQueue[T]((x, y) -> x.compare(y))

    // A new, empty queue that gives first the element `compare` finds greatest: `compare(x, y)` is
    // positive where `x` is to come out before `y`.
    withOrdering[T](compare: (T, T) -> int) -> PriorityQueue[T] = PriorityQueue[T](compare)

    // A new queue by the elements' own order holding the elements of `elements`.
    from[T: Ord](elements: Iterable[T]) -> PriorityQueue[T]
        val result = PriorityQueue[T]()
        for x in elements do result.addOne(x)
        result

    // A builder of a queue by the elements' own order: the elements it is given, in any order.
    newBuilder[T: Ord]() -> PriorityQueueBuilder[T] = PriorityQueueBuilder(PriorityQueue[T](), false)

// Builds a priority queue by adding to it.
class PriorityQueueBuilder[T](private var queue: PriorityQueue[T], private var spent: bool): Builder[T, PriorityQueue[T]]
    override addOne(element: T)
        if spent then fail("add to a builder whose result was taken")
        queue.addOne(element)

    override result() -> PriorityQueue[T]
        if spent then fail("result of a builder whose result was taken")
        spent = true
        queue

    // Starts a new queue, with the same comparison, leaving one already handed over as it is.
    override clear()
        queue = queue.copy()
        queue.clear()
        spent = false

    override knownSize -> int = queue.size
