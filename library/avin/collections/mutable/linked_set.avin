module avin.collections.mutable

import avin.{Set as ImmutableSet}

// A mutable set that remembers the order its elements were first added in: iteration and the display
// visit them oldest first. Adding an element that is present leaves it where it was; `addLast` and
// `moveToEnd` make it the newest. An element that is removed and added again is new. `removeFirst()`
// and `removeLast()` take the oldest and the newest element. Its elements are the keys of a
// `LinkedMap` whose values are `()`, so removing during an iteration is safe as it is there. A set is
// the predicate of membership, `(A) -> bool`.
class LinkedSet[A: Eq + Hash]: Iterable[A], (A) -> bool
    private val table = LinkedMap[A, unit]()

    // The number of elements.
    override size() -> int = table.size()

    // The number of elements, which the set holds: the same as `size()`.
    override knownSize() -> int = size()

    isEmpty() -> bool = table.isEmpty()

    nonEmpty() -> bool = table.nonEmpty()

    contains(element: A) -> bool = table.contains(element)

    // Whether `element` is in the set: `s(x)` is `s.contains(x)`.
    apply(element: A) -> bool = table.contains(element)

    // Adds `element` as the newest, answering whether it was absent; a present element stays where
    // it was.
    add(element: A) -> bool
        if table.contains(element) then return false
        table(element) = ()
        true

    // Adds `element` and makes it the newest, whether or not it was present.
    addLast(element: A)
        table.putLast(element, ())

    // Makes `element` the newest, answering whether it was present.
    moveToEnd(element: A) -> bool = table.moveToEnd(element)

    // Removes `element`, answering whether it was present.
    remove(element: A) -> bool = table.remove(element) is Some(_)

    // The oldest element, or `None` when the set is empty.
    override headOption() -> Option[A]
        table.headOption() match
            Some(entry) -> Some(entry.0)
            None -> None

    // The newest element, or `None` when the set is empty; `head()` and `last()` trap on an empty set.
    override lastOption() -> Option[A]
        table.lastOption() match
            Some(entry) -> Some(entry.0)
            None -> None

    // Removes the oldest element and answers it; traps when the set is empty.
    removeFirst() -> A
        if table.isEmpty() then fail("removeFirst on an empty set")
        table.removeFirst().0

    // Removes the newest element and answers it; traps when the set is empty.
    removeLast() -> A
        if table.isEmpty() then fail("removeLast on an empty set")
        table.removeLast().0

    // Removes every element.
    clear() = table.clear()

    // Adds every element of `elements`, in order.
    addAll(elements: Iterable[A])
        for x in elements do table(x) = ()

    // Adds `element`: `s += x`, which needs no `var`.
    +=(element: A)
        table(element) = ()

    // Removes `element` if it is present: `s -= x`.
    -=(element: A)
        table.remove(element)
        ()

    // Adds every element of `elements`: `s ++= xs`.
    ++=(elements: Iterable[A]) = addAll(elements)

    // Removes every element of `elements` that is present: `s --= xs`. A set with itself removed is
    // empty.
    --=(elements: Iterable[A])
        if elements === self then return clear()
        for x in elements do table.remove(x)

    // Removes every element that does not satisfy `p`.
    filterInPlace(p: (A) -> bool)
        val doomed = Buffer[A]()
        for x in table.keysIterator()
            if !p(x) then doomed.addOne(x)
        for x in doomed do table.remove(x)

    // A new set of the elements in this set, then those of `other` that it lacks.
    union(other: LinkedSet[A]) -> LinkedSet[A]
        val result = copy()
        result.addAll(other)
        result

    // A new set of the elements in both this set and `other`, in this set's order.
    intersect(other: LinkedSet[A]) -> LinkedSet[A] = filter(x -> other.contains(x))

    // A new set of the elements in this set and not in `other`, in this set's order.
    diff(other: LinkedSet[A]) -> LinkedSet[A] = filter(x -> !other.contains(x))

    // Whether every element of this set is in `other`.
    subsetOf(other: LinkedSet[A]) -> bool
        if size() > other.size() then return false
        for x in table.keysIterator()
            if !other.contains(x) then return false
        true

    // A new set of `f` of each element; elements that `f` maps alike become one, at the place of
    // the first.
    map[B](f: (A) -> B) -> LinkedSet[B]
        val result = LinkedSet[B]()
        for x in table.keysIterator() do result.add(f(x))
        result

    // A new set of the elements of the collections `f` makes of each element.
    flatMap[B](f: (A) -> Iterable[B]) -> LinkedSet[B]
        val result = LinkedSet[B]()
        for x in table.keysIterator() do result.addAll(f(x))
        result

    // The elements that satisfy `p`, tested only as `map`, `flatMap` or `foreach` reaches each one.
    withFilter(p: (A) -> bool) -> FilteredLinkedSet[A] = FilteredLinkedSet(self, p)

    // Calls `f` with each element, oldest first.
    foreach(f: (A) -> unit)
        for x in table.keysIterator() do f(x)

    // A new set of the elements that satisfy `p`, in this set's order.
    filter(p: (A) -> bool) -> LinkedSet[A]
        val result = LinkedSet[A]()
        for x in table.keysIterator()
            if p(x) then result.add(x)
        result

    // A new set of the same elements in the same order.
    copy() -> LinkedSet[A] = filter(_ -> true)

    // An immutable set of the same elements.
    toSet() -> ImmutableSet[A]
        var result = ImmutableSet[A]()
        for x in table.keysIterator() do result = result.incl(x)
        result

    override iterator() -> Iterator[A] = table.keysIterator()

// A linked set seen through a test, which a guard of a `for` with `yield` makes: each element is
// tested just before the call after it would use it. What it makes is a new linked set.
class FilteredLinkedSet[A: Eq + Hash](private val set: LinkedSet[A], private val p: (A) -> bool)
    // A new set of `f` of each element that passes the test.
    map[B](f: (A) -> B) -> LinkedSet[B]
        val result = LinkedSet[B]()
        for x in set
            if p(x) then result.add(f(x))
        result

    // A new set of the elements of the collections `f` makes of each element that passes the test.
    flatMap[B](f: (A) -> Iterable[B]) -> LinkedSet[B]
        val result = LinkedSet[B]()
        for x in set
            if p(x) then result.addAll(f(x))
        result

    // The elements that pass this test and then `q`.
    withFilter(q: (A) -> bool) -> FilteredLinkedSet[A] = FilteredLinkedSet(set, x -> p(x) && q(x))

    // Calls `f` with each element that passes the test.
    foreach(f: (A) -> unit)
        for x in set
            if p(x) then f(x)

// Two linked sets are equal when they hold the same elements at the moment they are compared,
// whatever order they were added in.
impl[A] Eq for LinkedSet[A]
    equals(other: LinkedSet[A]) -> bool
        if size() != other.size() then return false
        for x in self
            if !other.contains(x) then return false
        true

// A sum over the elements, so that the hash does not depend on the order.
impl[A] Hash for LinkedSet[A]
    hash() -> long
        var h: long = 0
        for x in self do h = h +% spreadHash(x.hash())
        h

// Displays as `{1, 2, 3}`, oldest element first.
impl[A: Display] Display for LinkedSet[A]
    display(out: Writer, spec: FormatSpec)
        writeElement(w: Writer, x: A) = x.display(w, FormatSpec())
        writeBraced(out, spec, iterator(), writeElement)

// The diagnostic form is `{"a", "b"}`, oldest element first.
impl[A: Debug] Debug for LinkedSet[A]
    debug(out: Writer, spec: FormatSpec)
        writeElement(w: Writer, x: A) = x.debug(w, FormatSpec())
        writeBraced(out, spec, iterator(), writeElement)

object LinkedSet
    // A new, empty linked set.
    empty[A: Eq + Hash]() -> LinkedSet[A] = LinkedSet[A]()

    // A builder of a linked set: the elements it is given in order, each held once.
    newBuilder[A]() -> Builder[A, LinkedSet[A]] = LinkedSetBuilder[A]()

// Builds a linked set by adding to it.
class LinkedSetBuilder[A: Eq + Hash]: Builder[A, LinkedSet[A]]
    private var set = LinkedSet[A]()
    private var spent = false

    override addOne(element: A)
        if spent then fail("add to a builder whose result was taken")
        set.add(element)

    override result() -> LinkedSet[A]
        if spent then fail("result of a builder whose result was taken")
        spent = true
        set

    // Starts a new set, leaving one already handed over as it is.
    override clear()
        set = LinkedSet[A]()
        spent = false

    override knownSize() -> int = set.size()
