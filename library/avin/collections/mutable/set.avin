module avin.collections.mutable

import avin.{Set as ImmutableSet}

// A mutable set: each element present at most once, found by its hash and compared with `==`. `add`
// and `remove` change it in place. Its elements are the keys of a mutable `Map` whose values are
// `()`, and it iterates in that map's order.
class Set[A: Eq + Hash]: Iterable[A]
    private val table = Map[A, unit]()

    // The number of elements.
    size() -> int = table.size()

    isEmpty() -> bool = table.isEmpty()

    nonEmpty() -> bool = table.nonEmpty()

    contains(element: A) -> bool = table.contains(element)

    // Whether `element` is in the set, so that a set is a function from elements to `bool`.
    apply(element: A) -> bool = table.contains(element)

    // Adds `element`, answering whether it was absent.
    add(element: A) -> bool
        if table.contains(element) then return false
        table(element) = ()
        true

    // Removes `element`, answering whether it was present.
    remove(element: A) -> bool = table.remove(element) is Some(_)

    // Removes every element.
    clear() = table.clear()

    // Adds every element of `elements`.
    addAll(elements: Iterable[A])
        for x in elements do table(x) = ()

    // Calls `f` with each element.
    foreach(f: (A) -> unit)
        for x in table.keysIterator() do f(x)

    // A new set of the elements that satisfy `p`.
    filter(p: (A) -> bool) -> Set[A]
        val result = Set[A]()
        for x in table.keysIterator()
            if p(x) then result.add(x)
        result

    // A new set of the same elements.
    copy() -> Set[A] = filter(_ -> true)

    // An immutable set of the same elements.
    toSet() -> ImmutableSet[A]
        var result = ImmutableSet[A]()
        for x in table.keysIterator() do result = result.added(x)
        result

    override iterator() -> Iterator[A] = table.keysIterator()
