module avin.collections.mutable

import avin.{Set as ImmutableSet}

// A mutable set: each element present at most once, found by its hash and compared with `==`. `add`
// and `remove` change it in place. Its elements are the keys of a mutable `Map` whose values are
// `()`, and it iterates in that map's order. A set is the predicate of membership, `(A) -> bool`.
class Set[A: Eq & Hash]: Iterable[A], (A) -> bool
  private val table = Map[A, unit]()

  // The number of elements.
  override size -> int = table.size

  // The number of elements, which the set holds: the same as `size`.
  override knownSize -> int = size

  isEmpty -> bool = table.isEmpty

  nonEmpty -> bool = table.nonEmpty

  contains(element: A) -> bool = table.contains(element)

  // Whether `element` is in the set: `s(x)` is `s.contains(x)`.
  apply(element: A) -> bool = table.contains(element)

  // Adds `element`, answering whether it was absent.
  add(element: A) -> bool
    if table.contains(element) then return false
    table(element) = ()
    true

  // Removes `element`, answering whether it was present.
  remove(element: A) -> bool = table.remove(element) is Some(_)

  // Removes every element.
  clear() = table.clear()

  // Adds every element of `elements`.
  addAll(elements: Iterable[A])
    for x in elements do table(x) = ()

  // Adds `element`: `s += x`, which needs no `var`.
  +=(element: A)
    table(element) = ()

  // Removes `element` if it is present: `s -= x`.
  -=(element: A)
    table.remove(element)
    ()

  // Adds every element of `elements`: `s ++= xs`.
  ++=(elements: Iterable[A]) = addAll(elements)

  // Removes every element of `elements` that is present: `s --= xs`. A set with itself removed is
  // empty.
  --=(elements: Iterable[A])
    if elements === self then return clear()
    for x in elements do table.remove(x)

  // Removes every element that does not satisfy `p`.
  filterInPlace(p: (A) -> bool)
    val doomed = Buffer[A]()
    for x in table.keysIterator()
      if !p(x) then doomed.addOne(x)
    for x in doomed do table.remove(x)

  // A new set of the elements in this set, in `other`, or in both.
  union(other: Set[A]) -> Set[A]
    val result = copy()
    result.addAll(other)
    result

  // A new set of the elements in both this set and `other`.
  intersect(other: Set[A]) -> Set[A] = filter(x -> other.contains(x))

  // A new set of the elements in this set and not in `other`.
  diff(other: Set[A]) -> Set[A] = filter(x -> !other.contains(x))

  // Whether every element of this set is in `other`.
  subsetOf(other: Set[A]) -> bool
    if size > other.size then return false
    for x in table.keysIterator()
      if !other.contains(x) then return false
    true

  // A new set of `f` of each element; elements that `f` maps alike become one.
  map[B](f: (A) -> B) -> Set[B]
    val result = Set[B]()
    for x in table.keysIterator() do result.add(f(x))
    result

  // A new set of the elements of the collections `f` makes of each element.
  flatMap[B](f: (A) -> Iterable[B]) -> Set[B]
    val result = Set[B]()
    for x in table.keysIterator() do result.addAll(f(x))
    result

  // A new set of the values of the options `f` makes of each element, those that hold one.
  flatMap[B](f: (A) -> Option[B]) -> Set[B]
    val result = Set[B]()
    for x in table.keysIterator()
      if f(x) is Some(y) then result += y
    result

  // The elements that satisfy `p`, tested only as `map`, `flatMap` or `foreach` reaches each one.
  withFilter(p: (A) -> bool) -> FilteredSet[A] = FilteredSet(self, p)

  // Calls `f` with each element.
  foreach(f: (A) -> unit)
    for x in table.keysIterator() do f(x)

  // A new set of the elements that satisfy `p`.
  filter(p: (A) -> bool) -> Set[A]
    val result = Set[A]()
    for x in table.keysIterator()
      if p(x) then result.add(x)
    result

  // A new set of the same elements.
  copy() -> Set[A] = filter(_ -> true)

  // An immutable set of the same elements.
  toSet -> ImmutableSet[A]
    var result = ImmutableSet[A]()
    for x in table.keysIterator() do result = result.incl(x)
    result

  override iterator() -> Iterator[A] = table.keysIterator()

// A mutable set seen through a test, which a guard of a `for` with `yield` makes: each element is
// tested just before the call after it would use it, so a guard runs in turn with the rest of the
// comprehension, element by element. What it makes is a new mutable set.
class FilteredSet[A: Eq & Hash](private val set: Set[A], private val p: (A) -> bool)
  // A new set of `f` of each element that passes the test.
  map[B](f: (A) -> B) -> Set[B]
    val result = Set[B]()
    for x in set
      if p(x) then result.add(f(x))
    result

  // A new set of the elements of the collections `f` makes of each element that passes the test.
  flatMap[B](f: (A) -> Iterable[B]) -> Set[B]
    val result = Set[B]()
    for x in set
      if p(x) then result.addAll(f(x))
    result

  // A new set of the values of the options `f` makes of each element that passes the test.
  flatMap[B](f: (A) -> Option[B]) -> Set[B]
    val result = Set[B]()
    for x in set
      if p(x)
        if f(x) is Some(y) then result += y
    result

  // The elements that pass this test and then `q`.
  withFilter(q: (A) -> bool) -> FilteredSet[A] = FilteredSet(set, x -> p(x) && q(x))

  // Calls `f` with each element that passes the test.
  foreach(f: (A) -> unit)
    for x in set
      if p(x) then f(x)

// Two mutable sets are equal when they hold the same elements at the moment they are compared.
impl[A] Eq for Set[A]
  equals(other: Set[A]) -> bool
    if size != other.size then return false
    for x in self
      if !other.contains(x) then return false
    true

// A sum over the elements, so that the hash does not depend on the table's order.
impl[A] Hash for Set[A]
  hash() -> long
    var h: long = 0
    for x in self do h = h +% spreadHash(x.hash())
    h

// Displays as `{1, 2, 3}`, as an immutable set does.
impl[A: Display] Display for Set[A]
  display(out: Writer, spec: FormatSpec)
    writeElement(w: Writer, x: A) = x.display(w, FormatSpec())
    writeBraced(out, spec, iterator(), writeElement)

// The diagnostic form is `{"a", "b"}`, as an immutable set's is.
impl[A: Debug] Debug for Set[A]
  debug(out: Writer, spec: FormatSpec)
    writeElement(w: Writer, x: A) = x.debug(w, FormatSpec())
    writeBraced(out, spec, iterator(), writeElement)

object Set
  // A new, empty set.
  empty[A: Eq & Hash]() -> Set[A] = Set[A]()

  // A new set of the elements of `elements`, each equal one once.
  from[A: Eq & Hash](elements: Iterable[A]) -> Set[A]
    val result = Set[A]()
    for x in elements do result.add(x)
    result

  // A builder of a mutable set: the elements it is given, each held once. It is typed as a
  // `Builder` of sets, so a literal where a `Set[A]` is expected gives the call its `A`.
  newBuilder[A]() -> Builder[A, Set[A]] = SetBuilder[A]()

// Builds a mutable set by adding to it.
class SetBuilder[A: Eq & Hash]: Builder[A, Set[A]]
  private var set = Set[A]()
  private var spent = false

  override addOne(element: A)
    if spent then fail("add to a builder whose result was taken")
    set.add(element)

  override result() -> Set[A]
    if spent then fail("result of a builder whose result was taken")
    spent = true
    set

  // Starts a new set, leaving one already handed over as it is.
  override clear()
    set = Set[A]()
    spent = false

  override knownSize -> int = set.size
