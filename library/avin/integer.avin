module avin

// Methods every integer type has, from one impl for the whole family: `abs`, `sign`, `pow`, `gcd`,
// `lcm`, floored division, bit counting and the text of a number in any radix. Each works at the
// width it is called at: an `i8` stays an `i8`, and a result that does not fit its width traps as
// arithmetic does.

impl[T: Integer] T
    // The magnitude. It traps for the least value, whose magnitude does not fit the width.
    abs() -> T = magnitude(self)

    // `-1`, `0` or `1` by whether the number is negative, zero or positive.
    sign() -> int = if self < T(0) then -1 elif self == T(0) then 0 else 1

    // The number raised to the power `n`, trapping when the result does not fit the width or when
    // `n` is negative. `x.pow(0)` is `1`, `0.pow(0)` included.
    pow(n: int) -> T
        if n < 0 then fail("pow: negative exponent")
        var result = T.wrap(1)
        if n == 0
            if result < T(0) then fail("i1 has no 1")
            return result
        var base = self
        var rest = n
        while true
            if rest & 1 == 1 then result = result * base
            rest = rest >> 1
            if rest == 0 then break
            base = base * base
        result

    // The greatest number that divides both, never negative; `gcd(0, 0)` is `0`. It traps when that
    // is the least value's magnitude, as in `MinValue.gcd(0)`.
    gcd(other: T) -> T
        var a = self
        var b = other
        while b != T(0)
            val r = a % b
            a = b
            b = r
        magnitude(a)

    // The least positive number both divide, `0` when either is `0`. It traps when that does not
    // fit the width.
    lcm(other: T) -> T
        if self == T(0) || other == T(0) then return T(0)
        magnitude(self / gcd(other)) * magnitude(other)

    // The quotient rounded towards negative infinity, where `/` rounds towards zero. It traps as `/`
    // does: on a zero divisor, and for `MinValue.floorDiv(-1)`.
    floorDiv(other: T) -> T
        val q = self / other
        if self % other != T(0) && (self < T(0)) != (other < T(0)) then q - T(1) else q

    // The remainder that takes the sign of the divisor, so `self == self.floorDiv(o) * o +
    // self.floorMod(o)`. It traps on a zero divisor and never otherwise.
    floorMod(other: T) -> T
        val r = self % other
        if r != T(0) && (r < T(0)) != (other < T(0)) then r + other else r

    // The number of one bits in the number's two's-complement form at its width, so `(-1).bitCount()`
    // is `32` for an `int`.
    bitCount() -> int
        if self < T(0) then integerWidth[T]() - onesIn(T(-1) - self) else onesIn(self)

    // The number of zero bits above the highest one bit, `0` for a negative number and the width
    // for zero.
    leadingZeros() -> int = if self < T(0) then 0 else integerWidth[T]() - bitLength(self)

    // The number of zero bits below the lowest one bit; the width for zero.
    trailingZeros() -> int
        if self == T(0) then return integerWidth[T]()
        // `i1`, whose only one is `-1`, has no `T(1)`: its `1` wraps to that.
        val one = T.wrap(1)
        var rest = self
        var n = 0
        while rest & one == T(0)
            rest = rest >> one
            n += 1
        n

    // Whether the number is a positive power of two.
    isPowerOfTwo() -> bool = self > T(0) && self & (self - T(1)) == T(0)

    // The number's digits in `radix`, from 2 to 36, lower case, with a `-` for a negative number and
    // no prefix: `255.toRadix(16)` is `"ff"`. Any other radix traps.
    toRadix(radix: int) -> string
        if !(2 <= radix <= 36) then fail("toRadix: radix must be from 2 to 36")
        val base = T.wrap(radix)
        // A width too narrow to hold the radix computes through `long`, which holds every such value.
        if int(base) != radix then return long.wrap(self).toRadix(radix)
        val out = StringWriter()
        if self < T(0) then out.writeChar('-')
        writeDigits(out, self, base, false)
        out.text()

// The number of bits in the width of `T`.
private integerWidth[T: Integer]() -> int
    // A one shifted up reaches the sign bit, and goes negative, at the width's last bit; `i1` has no
    // one, its `1` already being `-1`.
    var bit = T.wrap(1)
    var n = 1
    while bit > T(0)
        bit = bit << T(1)
        n += 1
    n

// The number of bits the non-negative `x` needs: `0` for zero, `1` for one, `8` for 128.
private bitLength[T: Integer](x: T) -> int
    var rest = x
    var n = 0
    while rest != T(0)
        rest = rest >> T(1)
        n += 1
    n

// The magnitude of `x`; the least value has none that fits, so it traps.
private magnitude[T: Integer](x: T) -> T = if x < T(0) then -x else x

// The number of one bits of the non-negative `x`.
private onesIn[T: Integer](x: T) -> int
    var rest = x
    var n = 0
    while rest != T(0)
        rest = rest & (rest - T(1))
        n += 1
    n
