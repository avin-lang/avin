module avin.regex

// The character classes a pattern can name: the predefined escapes `\d`, `\s`, `\w`, `\h`, `\v`, the
// POSIX classes, the Unicode general categories and the binary properties the Unicode Character
// Database gives through its general category. A class is a predicate over a code point, held as an
// `int` so that a surrogate written as an escape in a pattern is a value the class can name and the
// text, which holds only scalar values, never contains.

// A character's Unicode general category, as the database's two-letter abbreviations, in its order.
@sysl("sysl.unicode.Category")
private data GeneralCategory
    Cn
    Lu
    Ll
    Lt
    Lm
    Lo
    Mn
    Mc
    Me
    Nd
    Nl
    No
    Pc
    Pd
    Ps
    Pe
    Pi
    Pf
    Po
    Sm
    Sc
    Sk
    So
    Zs
    Zl
    Zp
    Cc
    Cf
    Cs
    Co

@sysl("sysl.unicode.category")
private generalCategory(c: char) -> GeneralCategory

// The position of a category in the database's order, for a set of categories held as bits.
private categoryBit(g: GeneralCategory) -> int = g match
    Cn -> 0
    Lu -> 1
    Ll -> 2
    Lt -> 3
    Lm -> 4
    Lo -> 5
    Mn -> 6
    Mc -> 7
    Me -> 8
    Nd -> 9
    Nl -> 10
    No -> 11
    Pc -> 12
    Pd -> 13
    Ps -> 14
    Pe -> 15
    Pi -> 16
    Pf -> 17
    Po -> 18
    Sm -> 19
    Sc -> 20
    Sk -> 21
    So -> 22
    Zs -> 23
    Zl -> 24
    Zp -> 25
    Cc -> 26
    Cf -> 27
    Cs -> 28
    Co -> 29

private val CategoryNames: Vector[string] = ["Cn", "Lu", "Ll", "Lt", "Lm", "Lo", "Mn", "Mc", "Me", "Nd", "Nl", "No", "Pc", "Pd", "Ps", "Pe", "Pi", "Pf", "Po", "Sm", "Sc", "Sk", "So", "Zs", "Zl", "Zp", "Cc", "Cf", "Cs", "Co"]

// Whether `c` is a scalar value, which a `char` can hold.
private isScalar(c: int) -> bool = c >= 0 && c <= 0x10ffff && (c < 0xd800 || c > 0xdfff)

// The category of a code point as its bit position; a surrogate is `Cs` and a number past the last
// code point `Cn`.
private categoryOf(c: int) -> int
    if isScalar(c) then return categoryBit(generalCategory(char(c)))
    if c >= 0xd800 && c <= 0xdfff then 28 else 0

private inCategories(mask: int, c: int) -> bool = ((mask >> categoryOf(c)) & 1) != 0

private bit(n: int) -> int = 1 << n

private val LetterMask: int = bit(1) | bit(2) | bit(3) | bit(4) | bit(5)
private val MarkMask: int = bit(6) | bit(7) | bit(8)
private val NumberMask: int = bit(9) | bit(10) | bit(11)
private val PunctuationMask: int = bit(12) | bit(13) | bit(14) | bit(15) | bit(16) | bit(17) | bit(18)
private val SymbolMask: int = bit(19) | bit(20) | bit(21) | bit(22)
private val SeparatorMask: int = bit(23) | bit(24) | bit(25)
private val OtherMask: int = bit(0) | bit(26) | bit(27) | bit(28) | bit(29)
private val CasedLetterMask: int = bit(1) | bit(2) | bit(3)

private categories(mask: int) -> (int) -> bool = c -> inCategories(mask, c)

private between(low: int, high: int) -> (int) -> bool = c -> c >= low && c <= high

private isAsciiDigit(c: int) -> bool = c >= 48 && c <= 57
private isAsciiUpper(c: int) -> bool = c >= 65 && c <= 90
private isAsciiLower(c: int) -> bool = c >= 97 && c <= 122
private isAsciiAlpha(c: int) -> bool = isAsciiUpper(c) || isAsciiLower(c)
private isAsciiAlnum(c: int) -> bool = isAsciiAlpha(c) || isAsciiDigit(c)
private isAsciiHexDigit(c: int) -> bool = isAsciiDigit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)

// The six ASCII white space characters: space, tab, newline, vertical tab, form feed and return.
private isAsciiSpace(c: int) -> bool = c == 32 || (c >= 9 && c <= 13)

private isAsciiWord(c: int) -> bool = isAsciiAlnum(c) || c == 95

private isAsciiPunct(c: int) -> bool = (c >= 33 && c <= 47) || (c >= 58 && c <= 64) || (c >= 91 && c <= 96) || (c >= 123 && c <= 126)

private isAsciiCntrl(c: int) -> bool = (c >= 0 && c < 32) || c == 127

// The horizontal white space of `\h`.
private isHorizontalSpace(c: int) -> bool
    c == 32 || c == 9 || c == 0xa0 || c == 0x1680 || c == 0x180e || (c >= 0x2000 && c <= 0x200a) || c == 0x202f || c == 0x205f || c == 0x3000

// The vertical white space of `\v`.
private isVerticalSpace(c: int) -> bool = (c >= 10 && c <= 13) || c == 0x85 || c == 0x2028 || c == 0x2029

// The ends of a line for `.` and the multiline anchors: newline, return, next line, and the line and
// paragraph separators.
private isLineTerminator(c: int) -> bool = c == 10 || c == 13 || c == 0x85 || c == 0x2028 || c == 0x2029

private isUnicodeLetterOrDigit(c: int) -> bool = inCategories(LetterMask | bit(9), c)

private isNonSpacingMark(c: int) -> bool = c >= 0x300 && categoryOf(c) == 6

// The case mappings over code points; a code point that is not a scalar value maps to itself.
private upperOf(c: int) -> int = if c < 128 then (if isAsciiLower(c) then c - 32 else c) elif isScalar(c) then int(char(c).toUpper()) else c

private lowerOf(c: int) -> int = if c < 128 then (if isAsciiUpper(c) then c + 32 else c) elif isScalar(c) then int(char(c).toLower()) else c

private asciiLower(c: int) -> int = if isAsciiUpper(c) then c + 32 else c

private asciiUpper(c: int) -> int = if isAsciiLower(c) then c - 32 else c

// What looking up a property name found: a class, or a name the pattern language has that needs
// Unicode data the runtime does not hold, or nothing.
private data Property
    Found(test: (int) -> bool)
    Unsupported
    Unknown

// The general categories and the POSIX classes by their exact names, as `\p{Lu}` and `\p{Alpha}`
// write them. Under case-insensitive matching the cased categories and the POSIX `Lower` and `Upper`
// each take every cased letter, as a case-insensitive match of any one of them would.
private propertyByName(name: string, caseless: bool) -> Property
    var k = 0
    while k < CategoryNames.length()
        if CategoryNames(k) == name
            if caseless && (k == 1 || k == 2 || k == 3) then return Found(categories(CasedLetterMask))
            return Found(categories(bit(k)))
        k += 1
    name match
        "L" -> Found(categories(LetterMask))
        "M" -> Found(categories(MarkMask))
        "N" -> Found(categories(NumberMask))
        "P" -> Found(categories(PunctuationMask))
        "S" -> Found(categories(SymbolMask))
        "Z" -> Found(categories(SeparatorMask))
        "C" -> Found(categories(OtherMask))
        "LC" -> Found(categories(CasedLetterMask))
        "LD" -> Found(categories(LetterMask | bit(9)))
        "L1" -> Found(between(0, 0xff))
        "all" -> Found(c -> true)
        "ASCII" -> Found(between(0, 0x7f))
        "Alnum" -> Found(isAsciiAlnum)
        "Alpha" -> Found(isAsciiAlpha)
        "Blank" -> Found(c -> c == 32 || c == 9)
        "Cntrl" -> Found(isAsciiCntrl)
        "Digit" -> Found(isAsciiDigit)
        "Graph" -> Found(between(0x21, 0x7e))
        "Lower" -> Found(if caseless then isAsciiAlpha else isAsciiLower)
        "Print" -> Found(between(0x20, 0x7e))
        "Punct" -> Found(isAsciiPunct)
        "Space" -> Found(isAsciiSpace)
        "Upper" -> Found(if caseless then isAsciiAlpha else isAsciiUpper)
        "XDigit" -> Found(isAsciiHexDigit)
        _ -> Unknown

// The Unicode binary properties `\p{IsName}` names, matched without regard to case. Those the
// general category decides are here; those that need the database's other property files are
// reported as unsupported.
private binaryProperty(name: string, caseless: bool) -> Property
    name.toUpper() match
        "ASSIGNED" -> Found(c -> categoryOf(c) != 0)
        "CONTROL" -> Found(categories(bit(26)))
        "DIGIT" -> Found(categories(bit(9)))
        "HEXDIGIT" | "HEX_DIGIT" -> Found(c -> inCategories(bit(9), c) || isAsciiHexDigit(c) || (c >= 0xff10 && c <= 0xff19) || (c >= 0xff21 && c <= 0xff26) || (c >= 0xff41 && c <= 0xff46))
        "JOINCONTROL" | "JOIN_CONTROL" -> Found(between(0x200c, 0x200d))
        "LETTER" -> Found(categories(LetterMask))
        "NONCHARACTERCODEPOINT" | "NONCHARACTER_CODE_POINT" -> Found(c -> (c & 0xfffe) == 0xfffe || (c >= 0xfdd0 && c <= 0xfdef))
        "TITLECASE" -> if caseless then Unsupported else Found(categories(bit(3)))
        "PUNCTUATION" -> Found(categories(PunctuationMask))
        "WHITESPACE" | "WHITE_SPACE" -> Found(isWhiteSpace)
        "BLANK" -> Found(c -> c == 9 || categoryOf(c) == 23)
        "GRAPH" -> Found(isGraph)
        "PRINT" -> Found(c -> (isGraph(c) || c == 9 || categoryOf(c) == 23) && categoryOf(c) != 26)
        "ALPHABETIC" | "IDEOGRAPHIC" | "LOWERCASE" | "UPPERCASE" | "WORD" | "ALNUM" | "EMOJI" | "EMOJI_PRESENTATION" | "EMOJI_MODIFIER" | "EMOJI_MODIFIER_BASE" | "EMOJI_COMPONENT" | "EXTENDED_PICTOGRAPHIC" -> Unsupported
        _ -> Unknown

private isWhiteSpace(c: int) -> bool = (c >= 9 && c <= 13) || c == 0x85 || inCategories(SeparatorMask, c)

private isGraph(c: int) -> bool = !inCategories(SeparatorMask | bit(26) | bit(28) | bit(0), c)
