module avin.regex

// The character classes a pattern can name: the predefined escapes `\d`, `\s`, `\w`, `\h`, `\v`, the
// POSIX classes, the Unicode general categories, scripts and blocks, and the binary properties of the
// Unicode Character Database, those the general category does not decide read from the tables of
// `unicode.avin`. A class is a predicate over a code point, held as an
// `int` so that a surrogate written as an escape in a pattern is a value the class can name and the
// text, which holds only scalar values, never contains.

// A character's Unicode general category, as the database's two-letter abbreviations, in its order.
@sysl("sysl.unicode.Category")
private data GeneralCategory
    Cn
    Lu
    Ll
    Lt
    Lm
    Lo
    Mn
    Mc
    Me
    Nd
    Nl
    No
    Pc
    Pd
    Ps
    Pe
    Pi
    Pf
    Po
    Sm
    Sc
    Sk
    So
    Zs
    Zl
    Zp
    Cc
    Cf
    Cs
    Co

@sysl("sysl.unicode.category")
private generalCategory(c: char) -> GeneralCategory

// The position of a category in the database's order, for a set of categories held as bits.
private categoryBit(g: GeneralCategory) -> int = g match
    Cn -> 0
    Lu -> 1
    Ll -> 2
    Lt -> 3
    Lm -> 4
    Lo -> 5
    Mn -> 6
    Mc -> 7
    Me -> 8
    Nd -> 9
    Nl -> 10
    No -> 11
    Pc -> 12
    Pd -> 13
    Ps -> 14
    Pe -> 15
    Pi -> 16
    Pf -> 17
    Po -> 18
    Sm -> 19
    Sc -> 20
    Sk -> 21
    So -> 22
    Zs -> 23
    Zl -> 24
    Zp -> 25
    Cc -> 26
    Cf -> 27
    Cs -> 28
    Co -> 29

private val CategoryNames: Vector[string] = ["Cn", "Lu", "Ll", "Lt", "Lm", "Lo", "Mn", "Mc", "Me", "Nd", "Nl", "No", "Pc", "Pd", "Ps", "Pe", "Pi", "Pf", "Po", "Sm", "Sc", "Sk", "So", "Zs", "Zl", "Zp", "Cc", "Cf", "Cs", "Co"]

// Whether `c` is a scalar value, which a `char` can hold.
private isScalar(c: int) -> bool = 0 <= c <= 0x10ffff && (c < 0xd800 || c > 0xdfff)

// The category of a code point as its bit position; a surrogate is `Cs` and a number past the last
// code point `Cn`.
private categoryOf(c: int) -> int
    if isScalar(c) then return categoryBit(generalCategory(char(c)))
    if 0xd800 <= c <= 0xdfff then 28 else 0

private inCategories(mask: int, c: int) -> bool = ((mask >> categoryOf(c)) & 1) != 0

private bit(n: int) -> int = 1 << n

private val LetterMask: int = bit(1) | bit(2) | bit(3) | bit(4) | bit(5)
private val MarkMask: int = bit(6) | bit(7) | bit(8)
private val NumberMask: int = bit(9) | bit(10) | bit(11)
private val PunctuationMask: int = bit(12) | bit(13) | bit(14) | bit(15) | bit(16) | bit(17) | bit(18)
private val SymbolMask: int = bit(19) | bit(20) | bit(21) | bit(22)
private val SeparatorMask: int = bit(23) | bit(24) | bit(25)
private val OtherMask: int = bit(0) | bit(26) | bit(27) | bit(28) | bit(29)
private val CasedLetterMask: int = bit(1) | bit(2) | bit(3)

private categories(mask: int) -> (int) -> bool = c -> inCategories(mask, c)

private between(low: int, high: int) -> (int) -> bool = c -> low <= c <= high

private isAsciiDigit(c: int) -> bool = int('0') <= c <= int('9')
private isAsciiUpper(c: int) -> bool = int('A') <= c <= int('Z')
private isAsciiLower(c: int) -> bool = int('a') <= c <= int('z')
private isAsciiAlpha(c: int) -> bool = isAsciiUpper(c) || isAsciiLower(c)
private isAsciiAlnum(c: int) -> bool = isAsciiAlpha(c) || isAsciiDigit(c)
private isAsciiHexDigit(c: int) -> bool = isAsciiDigit(c) || (int('A') <= c <= int('F')) || (int('a') <= c <= int('f'))

// The six ASCII white space characters: space, tab, newline, vertical tab, form feed and return.
private isAsciiSpace(c: int) -> bool = c == 32 || (9 <= c <= 13)

private isAsciiWord(c: int) -> bool = isAsciiAlnum(c) || c == int('_')

private isAsciiPunct(c: int) -> bool = (int('!') <= c <= int('/')) || (int(':') <= c <= int('@')) || (int('[') <= c <= int('`')) || (int('{') <= c <= int('~'))

private isAsciiCntrl(c: int) -> bool = (0 <= c < 32) || c == 127

// The horizontal white space of `\h`.
private isHorizontalSpace(c: int) -> bool
    c == 32 || c == 9 || c == 0xa0 || c == 0x1680 || c == 0x180e || (0x2000 <= c <= 0x200a) || c == 0x202f || c == 0x205f || c == 0x3000

// The vertical white space of `\v`.
private isVerticalSpace(c: int) -> bool = (10 <= c <= 13) || c == 0x85 || c == 0x2028 || c == 0x2029

// The ends of a line for `.` and the multiline anchors: newline, return, next line, and the line and
// paragraph separators.
private isLineTerminator(c: int) -> bool = c == 10 || c == 13 || c == 0x85 || c == 0x2028 || c == 0x2029

private isUnicodeLetterOrDigit(c: int) -> bool = inCategories(LetterMask | bit(9), c)

private isNonSpacingMark(c: int) -> bool = c >= 0x300 && categoryOf(c) == 6

// The case mappings over code points; a code point that is not a scalar value maps to itself.
private upperOf(c: int) -> int = if c < 128 then (if isAsciiLower(c) then c - 32 else c) elif isScalar(c) then int(char(c).toUpper()) else c

private lowerOf(c: int) -> int = if c < 128 then (if isAsciiUpper(c) then c + 32 else c) elif isScalar(c) then int(char(c).toLower()) else c

private asciiLower(c: int) -> int = if isAsciiUpper(c) then c + 32 else c

private asciiUpper(c: int) -> int = if isAsciiLower(c) then c - 32 else c

// The general categories and the POSIX classes by their exact names, as `\p{Lu}` and `\p{Alpha}`
// write them. Under case-insensitive matching the cased categories and the POSIX `Lower` and `Upper`
// each take every cased letter, as a case-insensitive match of any one of them would.
private propertyByName(name: string, caseless: bool) -> Option[(int) -> bool]
    var k = 0
    while k < CategoryNames.length()
        if CategoryNames(k) == name
            if caseless && (k == 1 || k == 2 || k == 3) then return Some(categories(CasedLetterMask))
            return Some(categories(bit(k)))
        k += 1
    name match
        "L" -> Some(categories(LetterMask))
        "M" -> Some(categories(MarkMask))
        "N" -> Some(categories(NumberMask))
        "P" -> Some(categories(PunctuationMask))
        "S" -> Some(categories(SymbolMask))
        "Z" -> Some(categories(SeparatorMask))
        "C" -> Some(categories(OtherMask))
        "LC" -> Some(categories(CasedLetterMask))
        "LD" -> Some(categories(LetterMask | bit(9)))
        "L1" -> Some(between(0, 0xff))
        "all" -> Some(c -> true)
        "ASCII" -> Some(between(0, 0x7f))
        "Alnum" -> Some(isAsciiAlnum)
        "Alpha" -> Some(isAsciiAlpha)
        "Blank" -> Some(c -> c == 32 || c == 9)
        "Cntrl" -> Some(isAsciiCntrl)
        "Digit" -> Some(isAsciiDigit)
        "Graph" -> Some(between(0x21, 0x7e))
        "Lower" -> Some(if caseless then isAsciiAlpha else isAsciiLower)
        "Print" -> Some(between(0x20, 0x7e))
        "Punct" -> Some(isAsciiPunct)
        "Space" -> Some(isAsciiSpace)
        "Upper" -> Some(if caseless then isAsciiAlpha else isAsciiUpper)
        "XDigit" -> Some(isAsciiHexDigit)
        _ -> None

// The Unicode binary properties `\p{IsName}` names, matched without regard to case, and after them
// the Unicode forms of the POSIX classes. Under case-insensitive matching `Lowercase`, `Uppercase` and
// `Titlecase` each take every cased character.
private binaryProperty(name: string, caseless: bool) -> Option[(int) -> bool]
    val upper = name.toUpperCase()
    upper match
        "ALPHABETIC" -> Some(isAlphabetic)
        "ASSIGNED" -> Some(c -> categoryOf(c) != 0)
        "CONTROL" -> Some(categories(bit(26)))
        "EMOJI" -> Some(isEmoji)
        "EMOJI_PRESENTATION" -> Some(isEmojiPresentation)
        "EMOJI_MODIFIER" -> Some(isEmojiModifier)
        "EMOJI_MODIFIER_BASE" -> Some(isEmojiModifierBase)
        "EMOJI_COMPONENT" -> Some(isEmojiComponent)
        "EXTENDED_PICTOGRAPHIC" -> Some(isExtendedPictographic)
        "HEXDIGIT" | "HEX_DIGIT" -> Some(isHexDigit)
        "IDEOGRAPHIC" -> Some(isIdeographic)
        "JOINCONTROL" | "JOIN_CONTROL" -> Some(between(0x200c, 0x200d))
        "LETTER" -> Some(categories(LetterMask))
        "LOWERCASE" -> Some(if caseless then isCased else isLowercase)
        "NONCHARACTERCODEPOINT" | "NONCHARACTER_CODE_POINT" -> Some(c -> (c & 0xfffe) == 0xfffe || (0xfdd0 <= c <= 0xfdef))
        "TITLECASE" -> Some(if caseless then isCased else categories(bit(3)))
        "PUNCTUATION" -> Some(categories(PunctuationMask))
        "UPPERCASE" -> Some(if caseless then isCased else isUppercase)
        "WHITESPACE" | "WHITE_SPACE" -> Some(isWhiteSpace)
        "WORD" -> Some(isWord)
        _ -> unicodePosixClass(upper, caseless)

// The POSIX classes over all of Unicode, by their names upper-cased: what `\p{IsAlpha}` names, and
// `\p{Alpha}` under the `U` flag.
private unicodePosixClass(upper: string, caseless: bool) -> Option[(int) -> bool] = upper match
    "ALPHA" -> Some(isAlphabetic)
    "LOWER" -> Some(if caseless then isCased else isLowercase)
    "UPPER" -> Some(if caseless then isCased else isUppercase)
    "SPACE" -> Some(isWhiteSpace)
    "PUNCT" -> Some(categories(PunctuationMask))
    "XDIGIT" -> Some(isHexDigit)
    "ALNUM" -> Some(c -> isAlphabetic(c) || inCategories(bit(9), c))
    "CNTRL" -> Some(categories(bit(26)))
    "DIGIT" -> Some(categories(bit(9)))
    "BLANK" -> Some(c -> c == 9 || categoryOf(c) == 23)
    "GRAPH" -> Some(isGraph)
    "PRINT" -> Some(c -> (isGraph(c) || c == 9 || categoryOf(c) == 23) && categoryOf(c) != 26)
    _ -> None

private isWhiteSpace(c: int) -> bool = (9 <= c <= 13) || c == 0x85 || inCategories(SeparatorMask, c)

private isGraph(c: int) -> bool = !inCategories(SeparatorMask | bit(26) | bit(28) | bit(0), c)

private isHexDigit(c: int) -> bool = inCategories(bit(9), c) || isAsciiHexDigit(c) || (0xff10 <= c <= 0xff19) || (0xff21 <= c <= 0xff26) || (0xff41 <= c <= 0xff46)

// A cased character: lower case, upper case or title case.
private isCased(c: int) -> bool = isLowercase(c) || isUppercase(c) || categoryOf(c) == 3

// A word character over all of Unicode, as `\w` takes under the `U` flag: alphabetic, a mark, a
// decimal digit, a connector punctuation or a joiner.
private isWord(c: int) -> bool = isAlphabetic(c) || inCategories(MarkMask | bit(9) | bit(12), c) || c == 0x200c || c == 0x200d
