module avin.regex

// Reading a pattern into a syntax tree. The reader follows the pattern language character by
// character: where a construct ends, which characters are literal in which position, and what is
// an error are all decided here, and each error names the index of the character it was found at.

// The flags a pattern turns on and off inline, as bits.
private val UnixLines: int = 1
private val CaseInsensitive: int = 2
private val Comments: int = 4
private val Multiline: int = 8
private val DotAll: int = 32
private val UnicodeCase: int = 64
private val UnicodeCharacterClass: int = 256

// The largest count a repetition can name; `*`, `+` and `{n,}` repeat up to it.
private val MaxRepeat: int = 0x7fffffff

// A pattern that cannot be read: what is wrong, the pattern, and the index of the character, counted
// in characters from 0, where it was found, or -1 where no one character is to blame.
data PatternError(description: string, pattern: string, index: int)

impl PatternError
    // The error as one text: the description and the index, then the pattern on a line of its own,
    // and under it a caret at the character, where the index falls inside the pattern.
    message() -> string
        var text = description
        if index >= 0 then text = text + " near index " + index.toString()
        text = text + "\n" + pattern
        if index >= 0 && index < pattern.charCount() then text = text + "\n" + " ".repeat(index) + "^"
        text

impl Display for PatternError
    display(out: Writer, spec: FormatSpec) = out.writeField(message(), spec)

// One character drawn from a class: its answers for the ASCII characters looked up in a table, and
// the test for any other.
private data CharSet(table: Array[bool], test: (int) -> bool)

private charSet(test: (int) -> bool) -> CharSet = CharSet(Array.tabulate(128, k -> test(k)), test)

impl CharSet
    contains(c: int) -> bool = if c < 128 then table(c) else test(c)

// How a repetition gives back what it took: the most first, the fewest first, or never.
private val Greedy: int = 0
private val Lazy: int = 1
private val Possessive: int = 2

// The positions an anchor tests.
private data AnchorKind
    // `\A`, and `^` without multiline: the start of the input.
    Begin
    // `\z`: the end of the input.
    EndOfInput
    // `^` in multiline mode: the start of the input or of a line, never the very end.
    Caret(unixLines: bool)
    // `$` and `\Z`: the end of the input or before a line terminator ending it, or, in multiline mode,
    // before any line terminator.
    Dollar(multiline: bool, unixLines: bool)
    // `\G`: where the previous match ended.
    LastMatch

// The four lookarounds.
private data LookKind
    Ahead
    NotAhead
    Behind
    NotBehind

// A parsed pattern.
private data Tree
    Empty
    // One character of a class.
    Chars(set: CharSet)
    // A run of characters matched exactly.
    Literal(codes: Array[int])
    Concat(items: Vector[Tree])
    // Alternatives tried left to right.
    Alternation(alternatives: Vector[Tree])
    Capture(group: int, body: Tree)
    // A group that only groups, `(?:…)` or a group of scoped flags.
    Plain(body: Tree)
    // `(?>…)`: once the body has matched it is never tried another way.
    Atomic(body: Tree)
    // A lookaround; a lookbehind carries the least and most characters its body can match.
    Look(kind: LookKind, body: Tree, least: int, most: int)
    // A repetition; `optional` marks one written `?`, which differs from `{0,1}` in how it is
    // matched.
    Repeat(atom: Tree, least: int, most: int, mode: int, optional: bool)
    Anchor(kind: AnchorKind)
    // `\b` when `boundary` is true, `\B` when it is false; with `unicode`, a word character is one
    // `\w` takes under the `U` flag.
    WordBoundary(boundary: bool, unicode: bool)
    // `\b{g}`: a boundary between grapheme clusters.
    GraphemeBoundary
    // `\X`: one extended grapheme cluster.
    Grapheme
    BackReference(group: int, caseless: bool, unicode: bool)
    // `\R`: a line break, `\r\n` or any one vertical character.
    LineBreak

// What an escape stands for: a character, a class, or a construct of its own.
private data Escaped
    Code(code: int)
    Class(test: (int) -> bool)
    Construct(tree: Tree)

// What a pattern reads as: its tree, the number of groups counting the whole match as group 0, and
// the names of its named groups with their numbers.
private data Parsed(tree: Tree, groupCount: int, names: Vector[(string, int)])

// Reads `text` as a pattern.
private parsePattern(text: string) -> Result[Parsed, PatternError]
    val p = Parser(text)
    p.parse()

// The pattern's characters with every `\Q…\E` quotation written as escaped characters, so the rest of
// the reader never meets one: inside a quotation a letter or a character beyond ASCII stays as it
// is, any other character is escaped, a digit just after the `\Q` is written as a hexadecimal escape
// so it cannot extend an escape before it, and a backslash not followed by `E` is a literal
// backslash. A quotation not closed runs to the end.
private unquoted(codes: Vector[char]) -> Buffer[char]
    val out = Buffer[char]()
    val n = codes.length()
    var i = 0
    var quoting = false
    var opening = false
    while i < n
        val c = codes(i)
        i += 1
        if !quoting
            if c == '\\' && i < n && codes(i) == 'Q'
                i += 1
                quoting = true
                opening = true
                continue
            out.addOne(c)
            if c == '\\' && i < n
                out.addOne(codes(i))
                i += 1
            continue
        if c == '\\' && i < n && codes(i) == 'E'
            i += 1
            quoting = false
            continue
        val code = int(c)
        if code >= 128 || isAsciiAlpha(code)
            out.addOne(c)
        elif isAsciiDigit(code)
            if opening
                out.addOne('\\')
                out.addOne('x')
                out.addOne('3')
            out.addOne(c)
        else
            out.addOne('\\')
            out.addOne(c)
        opening = false
    out

private class Parser(text: string)
    private val src: Array[char] = withEnd(unquoted(text.chars()))
    private val len: int = src.length() - 2
    private var cursor = 0
    private var flags = 0
    private var groupCount = 1
    private val names = Buffer[(string, int)]()

    parse() -> Result[Parsed, PatternError]
        val tree = expr()?
        if cursor != len
            if peek() == ')' then return Err(error("Unmatched closing ')'"))
            return Err(error("Unexpected internal error"))
        Ok(Parsed(tree, groupCount, names.toVector()))

    private has(flag: int) -> bool = (flags & flag) != 0

    private error(description: string) -> PatternError = PatternError(description, text, cursor - 1)

    // The character at `k`; past the end of the pattern there are only zeros.
    private at(k: int) -> char = if k < src.length() then src(k) else '\u{0}'

    // The cursor's character, past white space and comments in comments mode.
    private peek() -> char
        val ch = at(cursor)
        if has(Comments) then peekPastWhitespace(ch) else ch

    // The cursor's character, moving past it.
    private read() -> char
        val ch = at(cursor)
        cursor += 1
        if has(Comments) then parsePastWhitespace(ch) else ch

    // The character after the cursor, moving to it.
    private next() -> char
        cursor += 1
        val ch = at(cursor)
        if has(Comments) then peekPastWhitespace(ch) else ch

    // The character after the cursor, moving to it, with no comment skipped.
    private nextEscaped() -> char
        cursor += 1
        at(cursor)

    // The character after the cursor, moving past it.
    private skip() -> char
        val ch = at(cursor + 1)
        cursor += 2
        ch

    private unread()
        cursor -= 1

    private isSpaceChar(ch: char) -> bool = isAsciiSpace(int(ch))

    private peekPastWhitespace(first: char) -> char
        var ch = first
        while isSpaceChar(ch) || ch == '#'
            while isSpaceChar(ch)
                cursor += 1
                ch = at(cursor)
            if ch == '#' then ch = peekPastLine()
        ch

    private parsePastWhitespace(first: char) -> char
        var ch = first
        while isSpaceChar(ch) || ch == '#'
            while isSpaceChar(ch)
                ch = at(cursor)
                cursor += 1
            if ch == '#' then ch = parsePastLine()
        ch

    private parsePastLine() -> char
        var ch = at(cursor)
        cursor += 1
        while ch != '\u{0}' && !isLineSeparator(ch)
            ch = at(cursor)
            cursor += 1
        if ch == '\u{0}' && cursor > len
            cursor = len
            ch = at(cursor)
            cursor += 1
        ch

    private peekPastLine() -> char
        cursor += 1
        var ch = at(cursor)
        while ch != '\u{0}' && !isLineSeparator(ch)
            cursor += 1
            ch = at(cursor)
        if ch == '\u{0}' && cursor >= len
            cursor = len
            ch = at(cursor)
        ch

    private isLineSeparator(ch: char) -> bool = if has(UnixLines) then ch == '\n' else isLineTerminator(int(ch))

    // Moves past `ch`, or fails with `description`.
    private accept(ch: char, description: string) -> Result[unit, PatternError]
        var test = at(cursor)
        cursor += 1
        if has(Comments) then test = parsePastWhitespace(test)
        if test != ch then return Err(error(description))
        Ok(())

    // Alternatives separated by `|`.
    private expr() -> Result[Tree, PatternError]
        val alternatives = Buffer[Tree]()
        loop
            alternatives.addOne(sequence()?)
            if peek() != '|' then break
            next()
        if alternatives.length() == 1 then Ok(alternatives(0)) else Ok(Alternation(alternatives.toVector()))

    // The items of one alternative, up to a `|`, a `)` or the end.
    private sequence() -> Result[Tree, PatternError]
        val items = Buffer[Tree]()
        loop
            val ch = peek()
            var node: Tree = Empty
            if ch == '('
                if group0()? is Some(t) then items.addOne(t)
                continue
            elif ch == '['
                node = Chars(charSet(clazz(true)?))
            elif ch == '\\'
                val e = nextEscaped()
                if e == 'p' || e == 'P'
                    var oneLetter = true
                    if next() != '{' then unread() else oneLetter = false
                    node = Chars(charSet(family(oneLetter, e == 'P')?))
                else
                    unread()
                    node = atom()?
            elif ch == '^'
                next()
                node = if has(Multiline) then Anchor(Caret(has(UnixLines))) else Anchor(Begin)
            elif ch == '$'
                next()
                node = Anchor(Dollar(has(Multiline), has(UnixLines)))
            elif ch == '.'
                next()
                if has(DotAll) then node = Chars(charSet(c -> true))
                elif has(UnixLines) then node = Chars(charSet(c -> c != 10))
                else node = Chars(charSet(c -> !isLineTerminator(c)))
            elif ch == '|' || ch == ')'
                break
            elif ch == '?' || ch == '*' || ch == '+'
                next()
                return Err(error("Dangling meta character '" + ch.toString() + "'"))
            elif ch == '\u{0}' && cursor >= len
                break
            else
                node = atom()?
            items.addOne(closure(node)?)
        Ok(concatenation(items))

    // A group, with any repetition after it; nothing for a group that only sets flags.
    private group0() -> Result[Option[Tree], PatternError]
        val saved = flags
        var tree: Tree = Empty
        val ch = next()
        if ch == '?'
            val kind = skip()
            if kind == ':'
                tree = Plain(expr()?)
            elif kind == '='
                tree = Look(Ahead, expr()?, 0, 0)
            elif kind == '!'
                tree = Look(NotAhead, expr()?, 0, 0)
            elif kind == '>'
                tree = Atomic(expr()?)
            elif kind == '<'
                val c = read()
                if c != '=' && c != '!'
                    val name = groupName(c)?
                    for (known, _) in names
                        if known == name then return Err(error("Named capturing group <" + name + "> is already defined"))
                    val group = groupCount
                    groupCount += 1
                    names.addOne((name, group))
                    tree = Capture(group, expr()?)
                else
                    val body = expr()?
                    val size = measure(body)
                    if !size.bounded then return Err(error("Look-behind group does not have an obvious maximum length"))
                    tree = Look(if c == '=' then Behind else NotBehind, body, size.least, size.most)
            elif kind == '$' || kind == '@'
                return Err(error("Unknown group type"))
            else
                unread()
                addFlags()?
                val after = read()
                if after == ')' then return Ok(None)
                if after != ':' then return Err(error("Unknown inline modifier"))
                tree = Plain(expr()?)
        else
            val group = groupCount
            groupCount += 1
            tree = Capture(group, expr()?)
        accept(')', "Unclosed group")?
        flags = saved
        Ok(Some(closure(tree)?))

    // The flags after `(?`, turned on, and after a `-`, off.
    private addFlags() -> Result[unit, PatternError]
        var ch = peek()
        loop
            if ch == 'i' then flags = flags | CaseInsensitive
            elif ch == 'm' then flags = flags | Multiline
            elif ch == 's' then flags = flags | DotAll
            elif ch == 'd' then flags = flags | UnixLines
            elif ch == 'u' then flags = flags | UnicodeCase
            elif ch == 'x' then flags = flags | Comments
            elif ch == 'U' then flags = flags | UnicodeCharacterClass | UnicodeCase
            elif ch == 'c'
                cursor += 1
                return Err(error("Unsupported inline modifier '" + ch.toString() + "'"))
            elif ch == '-'
                next()
                return subtractFlags()
            else
                return Ok(())
            ch = next()

    private subtractFlags() -> Result[unit, PatternError]
        var ch = peek()
        loop
            if ch == 'i' then flags = flags & ~CaseInsensitive
            elif ch == 'm' then flags = flags & ~Multiline
            elif ch == 's' then flags = flags & ~DotAll
            elif ch == 'd' then flags = flags & ~UnixLines
            elif ch == 'u' then flags = flags & ~UnicodeCase
            elif ch == 'x' then flags = flags & ~Comments
            elif ch == 'U' then flags = flags & ~(UnicodeCharacterClass | UnicodeCase)
            elif ch != 'c' then return Ok(())
            ch = next()

    // A group's name: a Latin letter, then Latin letters and digits, then `>`.
    private groupName(first: char) -> Result[string, PatternError]
        if !isAsciiAlpha(int(first)) then return Err(error("capturing group name does not start with a Latin letter"))
        var name = first.toString()
        var ch = read()
        while isAsciiAlnum(int(ch))
            name = name + ch.toString()
            ch = read()
        if ch != '>' then return Err(error("named capturing group is missing trailing '>'"))
        Ok(name)

    // The repetition after an item, if there is one.
    private closure(prev: Tree) -> Result[Tree, PatternError]
        val ch = peek()
        if ch == '?'
            val mode = next()
            if mode == '?'
                next()
                return Ok(Repeat(prev, 0, 1, Lazy, true))
            if mode == '+'
                next()
                return Ok(Repeat(prev, 0, 1, Possessive, true))
            return Ok(Repeat(prev, 0, 1, Greedy, true))
        if ch == '*' then return Ok(curly(prev, 0))
        if ch == '+' then return Ok(curly(prev, 1))
        if ch == '{'
            var c = at(cursor + 1)
            if !isAsciiDigit(int(c)) then return Err(error("Illegal repetition"))
            skip()
            var least = 0
            loop
                if least >= MaxRepeat / 10 then return Err(error("Illegal repetition range"))
                least = least * 10 + (int(c) - 48)
                c = read()
                if !isAsciiDigit(int(c)) then break
            var most = least
            if c == ','
                c = read()
                most = MaxRepeat
                if c != '}'
                    most = 0
                    while isAsciiDigit(int(c))
                        if most >= MaxRepeat / 10 then return Err(error("Illegal repetition range"))
                        most = most * 10 + (int(c) - 48)
                        c = read()
            if c != '}' then return Err(error("Unclosed counted closure"))
            if most < least then return Err(error("Illegal repetition range"))
            val mode = peek()
            if mode == '?'
                next()
                return Ok(Repeat(prev, least, most, Lazy, false))
            if mode == '+'
                next()
                return Ok(Repeat(prev, least, most, Possessive, false))
            return Ok(Repeat(prev, least, most, Greedy, false))
        Ok(prev)

    // `*` or `+`, with its mode.
    private curly(prev: Tree, least: int) -> Tree
        val ch = next()
        if ch == '?'
            next()
            return Repeat(prev, least, MaxRepeat, Lazy, false)
        if ch == '+'
            next()
            return Repeat(prev, least, MaxRepeat, Possessive, false)
        Repeat(prev, least, MaxRepeat, Greedy, false)

    // A run of literal characters, stopping before the last when a repetition follows it, so the
    // repetition takes that character alone; or one escape that stands for a construct.
    private atom() -> Result[Tree, PatternError]
        val codes = Buffer[int]()
        var prev = -1
        var ch = peek()
        loop
            if ch == '*' || ch == '+' || ch == '?' || ch == '{'
                if codes.length() > 1
                    cursor = prev
                    codes.remove(codes.length() - 1)
                break
            elif ch == '$' || ch == '.' || ch == '^' || ch == '(' || ch == '[' || ch == '|' || ch == ')'
                break
            elif ch == '\\'
                val e = nextEscaped()
                if e == 'p' || e == 'P'
                    if codes.length() > 0
                        unread()
                        break
                    var oneLetter = true
                    if next() != '{' then unread() else oneLetter = false
                    return Ok(Chars(charSet(family(oneLetter, e == 'P')?)))
                unread()
                prev = cursor
                val escaped = escape(false, false)?
                escaped match
                    Code(c) ->
                        codes.addOne(c)
                        ch = peek()
                        continue
                    Class(test) ->
                        if codes.isEmpty() then return Ok(Chars(charSet(test)))
                    Construct(tree) ->
                        if codes.isEmpty() then return Ok(tree)
                cursor = prev
                break
            elif ch == '\u{0}' && cursor >= len
                break
            else
                prev = cursor
                codes.addOne(int(ch))
                ch = next()
        if codes.length() == 1 then return Ok(singleTree(codes(0)))
        if has(CaseInsensitive)
            val items = Buffer[Tree]()
            for c in codes do items.addOne(Chars(charSet(single(c))))
            return Ok(concatenation(items))
        Ok(if codes.isEmpty() then Empty else Literal(codes.toArray()))

    // One literal character: exact, or a class of its cases.
    private singleTree(c: int) -> Tree
        if has(CaseInsensitive) then Chars(charSet(single(c))) else Literal(Array.fill(1, c))

    // The test for one character as a literal, with its other cases where matching ignores case.
    private single(c: int) -> (int) -> bool
        if has(CaseInsensitive)
            if has(UnicodeCase)
                val upper = upperOf(c)
                val lower = lowerOf(upper)
                if upper != lower then return x -> x == lower || lower == lowerOf(upperOf(x))
            elif isAsciiAlpha(c)
                val lower = asciiLower(c)
                val upper = asciiUpper(c)
                return x -> x == lower || x == upper
        x -> x == c

    // The escape after a backslash at the cursor.
    private escape(inClass: bool, isRange: bool) -> Result[Escaped, PatternError]
        val ch = skip()
        val bad: Result[Escaped, PatternError] = Err(error("Illegal/unsupported escape sequence"))
        if ch == '0' then return Ok(Code(octal()?))
        if ch >= '1' && ch <= '9'
            if inClass then return bad
            return Ok(Construct(reference(int(ch) - 48)))
        ch match
            'A' -> if inClass then bad else Ok(Construct(Anchor(Begin)))
            'B' -> if inClass then bad else Ok(Construct(WordBoundary(false, has(UnicodeCharacterClass))))
            'D' ->
                val digit = digitClass()
                Ok(Class(c -> !digit(c)))
            'G' -> if inClass then bad else Ok(Construct(Anchor(LastMatch)))
            'H' -> Ok(Class(c -> !isHorizontalSpace(c)))
            'N' -> Err(error("Unsupported escape \\N: the runtime has no Unicode character names"))
            'R' -> if inClass then bad else Ok(Construct(LineBreak))
            'S' ->
                val space = spaceClass()
                Ok(Class(c -> !space(c)))
            'V' -> Ok(Class(c -> !isVerticalSpace(c)))
            'W' ->
                val word = wordClass()
                Ok(Class(c -> !word(c)))
            'X' -> if inClass then bad else Ok(Construct(Grapheme))
            'Z' -> if inClass then bad else Ok(Construct(Anchor(Dollar(false, has(UnixLines)))))
            'a' -> Ok(Code(7))
            'b' ->
                if inClass then return bad
                if peek() == '{'
                    if skip() == 'g'
                        if read() == '}' then return Ok(Construct(GraphemeBoundary))
                        return Err(error("Illegal/unsupported escape sequence"))
                    unread()
                    unread()
                Ok(Construct(WordBoundary(true, has(UnicodeCharacterClass))))
            'c' -> Ok(Code(control()?))
            'd' -> Ok(Class(digitClass()))
            'e' -> Ok(Code(27))
            'f' -> Ok(Code(12))
            'h' -> Ok(Class(isHorizontalSpace))
            'k' ->
                if inClass then return bad
                if read() != '<' then return Err(error("\\k is not followed by '<' for named capturing group"))
                val name = groupName(read())?
                for (known, group) in names
                    if known == name then return Ok(Construct(BackReference(group, has(CaseInsensitive), has(UnicodeCase))))
                Err(error("named capturing group <" + name + "> does not exist"))
            'n' -> Ok(Code(10))
            'r' -> Ok(Code(13))
            's' -> Ok(Class(spaceClass()))
            't' -> Ok(Code(9))
            'u' -> Ok(Code(unicodeEscape()?))
            'v' -> if isRange then Ok(Code(11)) else Ok(Class(isVerticalSpace))
            'w' -> Ok(Class(wordClass()))
            'x' -> Ok(Code(hexadecimal()?))
            'z' -> if inClass then bad else Ok(Construct(Anchor(EndOfInput)))
            _ -> if isAsciiAlnum(int(ch)) then bad else Ok(Code(int(ch)))

    // The classes of `\d`, `\s` and `\w`: over ASCII, or under the `U` flag over all of Unicode.
    private digitClass() -> (int) -> bool = if has(UnicodeCharacterClass) then categories(bit(9)) else isAsciiDigit

    private spaceClass() -> (int) -> bool = if has(UnicodeCharacterClass) then isWhiteSpace else isAsciiSpace

    private wordClass() -> (int) -> bool = if has(UnicodeCharacterClass) then isWord else isAsciiWord

    // A back reference: more digits extend the number while it names a group already opened.
    private reference(first: int) -> Tree
        var group = first
        loop
            val ch = peek()
            if !isAsciiDigit(int(ch)) then break
            val extended = group * 10 + (int(ch) - 48)
            if groupCount - 1 < extended then break
            group = extended
            read()
        BackReference(group, has(CaseInsensitive), has(UnicodeCase))

    // `\0` and one to three octal digits, the three-digit form at most `\0377`.
    private octal() -> Result[int, PatternError]
        val n = int(read())
        if n >= 48 && n <= 55
            val m = int(read())
            if m >= 48 && m <= 55
                val o = int(read())
                if o >= 48 && o <= 55 && n <= 51 then return Ok((n - 48) * 64 + (m - 48) * 8 + (o - 48))
                unread()
                return Ok((n - 48) * 8 + (m - 48))
            unread()
            return Ok(n - 48)
        Err(error("Illegal octal escape sequence"))

    // `\xhh` or `\x{h…}`.
    private hexadecimal() -> Result[int, PatternError]
        val n = int(read())
        if isAsciiHexDigit(n)
            val m = int(read())
            if isAsciiHexDigit(m) then return Ok(hexValue(n) * 16 + hexValue(m))
        elif n == 123 && isAsciiHexDigit(int(peek()))
            var code = 0
            var d = int(read())
            while isAsciiHexDigit(d)
                code = code * 16 + hexValue(d)
                if code > 0x10ffff then return Err(error("Hexadecimal codepoint is too big"))
                d = int(read())
            if d != 125 then return Err(error("Unclosed hexadecimal escape sequence"))
            return Ok(code)
        Err(error("Illegal hexadecimal escape sequence"))

    private hexValue(d: int) -> int = if d <= 57 then d - 48 elif d <= 70 then d - 55 else d - 87

    private fourHex() -> Result[int, PatternError]
        var n = 0
        for _ in 0..<4
            val d = int(read())
            if !isAsciiHexDigit(d) then return Err(error("Illegal Unicode escape sequence"))
            n = n * 16 + hexValue(d)
        Ok(n)

    // `\uhhhh`; a high surrogate followed by an escaped low one is the one character they encode.
    private unicodeEscape() -> Result[int, PatternError]
        val n = fourHex()?
        if n >= 0xd800 && n <= 0xdbff
            val mark = cursor
            if read() == '\\' && read() == 'u'
                val low = fourHex()?
                if low >= 0xdc00 && low <= 0xdfff then return Ok(0x10000 + ((n - 0xd800) << 10) + (low - 0xdc00))
            cursor = mark
        Ok(n)

    // `\cX`: the control character whose code is X's with bit 6 flipped.
    private control() -> Result[int, PatternError]
        if cursor < len then return Ok(int(read()) ^ 64)
        Err(error("Illegal control escape sequence"))

    // A character class from its `[`; `consume` moves past its `]`.
    private clazz(consume: bool) -> Result[(int) -> bool, PatternError]
        var prev: Option[(int) -> bool] = None
        var curr: Option[(int) -> bool] = None
        val bits = Array.fill(256, false)
        var hasBits = false
        var isNeg = false
        var ch = next()
        if ch == '^' && at(cursor - 1) == '['
            ch = next()
            isNeg = true
        loop
            if ch == '['
                val inner = clazz(true)?
                curr = Some(inner)
                prev = Some(unionOf(prev, inner))
                ch = peek()
                continue
            elif ch == '&'
                ch = next()
                if ch == '&'
                    ch = next()
                    var right: Option[(int) -> bool] = None
                    while ch != ']' && ch != '&'
                        if ch == '['
                            right = Some(unionOf(right, clazz(true)?))
                        else
                            unread()
                            right = Some(clazz(false)?)
                        ch = peek()
                    if hasBits
                        val b = bitTest(bits)
                        if prev.isEmpty()
                            prev = Some(b)
                            curr = Some(b)
                        else
                            prev = Some(unionOf(prev, b))
                        hasBits = false
                    if right.isDefined() then curr = right
                    if prev.isEmpty()
                        if right.isEmpty() then return Err(error("Bad class syntax"))
                        prev = right
                    else
                        val left = prev.get()
                        val both = curr.get()
                        prev = Some(c -> left(c) && both(c))
                    continue
                unread()
            elif ch == '\u{0}' && cursor >= len
                return Err(error("Unclosed character class"))
            elif ch == ']'
                if prev.isDefined() || hasBits
                    if consume then next()
                    var result = if prev.isEmpty() then bitTest(bits) elif hasBits then unionOf(prev, bitTest(bits)) else prev.get()
                    if isNeg
                        val inner = result
                        result = c -> !inner(c)
                    return Ok(result)
            val member = range(bits)?
            if member is Some(test)
                curr = member
                prev = Some(unionOf(prev, test))
            else
                hasBits = true
            ch = peek()

    // One member of a class: a character, which joins `bits` when it can and answers None, a range,
    // or a class an escape names.
    private range(bits: Array[bool]) -> Result[Option[(int) -> bool], PatternError]
        var ch = peek()
        var code = 0
        if ch == '\\'
            ch = nextEscaped()
            if ch == 'p' || ch == 'P'
                var oneLetter = true
                if next() != '{' then unread() else oneLetter = false
                return Ok(Some(family(oneLetter, ch == 'P')?))
            val isRange = at(cursor + 1) == '-'
            unread()
            val escaped = escape(true, isRange)?
            escaped match
                Code(c) -> code = c
                Class(test) -> return Ok(Some(test))
                Construct(_) -> return Err(error("Illegal/unsupported escape sequence"))
        else
            next()
            code = int(ch)
        if peek() == '-'
            val endRange = at(cursor + 1)
            if endRange == '['
                return Ok(bitsOrSingle(bits, code))
            if endRange != ']'
                next()
                var m = int(peek())
                if peek() == '\\'
                    val bound = escape(true, true)?
                    m = bound match
                        Code(c) -> c
                        _ -> -1
                else
                    next()
                if m < code then return Err(error("Illegal character range"))
                val low = code
                if has(CaseInsensitive)
                    if has(UnicodeCase)
                        return Ok(Some(c -> (c >= low && c <= m) || caseRangeUnicode(low, m, c)))
                    return Ok(Some(c -> (c >= low && c <= m) || (c < 128 && caseRangeAscii(low, m, c))))
                return Ok(Some(c -> c >= low && c <= m))
        Ok(bitsOrSingle(bits, code))

    // A character of a class below 256 joins the table, with its other cases where matching ignores
    // case; the few whose case partners lie outside the table under Unicode case are tested alone.
    private bitsOrSingle(bits: Array[bool], c: int) -> Option[(int) -> bool]
        val unicodeCaseless = has(CaseInsensitive) && has(UnicodeCase)
        val partnerOutside = c == 0xff || c == 0xb5 || c == 0x49 || c == 0x69 || c == 0x53 || c == 0x73 || c == 0x4b || c == 0x6b || c == 0xc5 || c == 0xe5
        if c < 256 && !(unicodeCaseless && partnerOutside)
            if has(CaseInsensitive)
                if c < 128
                    bits(asciiUpper(c)) = true
                    bits(asciiLower(c)) = true
                elif has(UnicodeCase)
                    val lower = lowerOf(c)
                    val upper = upperOf(c)
                    if lower < 256 then bits(lower) = true
                    if upper < 256 then bits(upper) = true
            bits(c) = true
            return None
        Some(single(c))

    // `\p{…}` or `\pX`, and with `complement` its negation.
    private family(singleLetter: bool, complement: bool) -> Result[(int) -> bool, PatternError]
        next()
        var name = ""
        if singleLetter
            name = at(cursor).toString()
            read()
        else
            val start = cursor
            while cursor <= len && at(cursor) != '}'
                cursor += 1
            cursor += 1
            if cursor > len + 1 || at(cursor - 1) != '}'
                cursor = len + 1
                return Err(error("Unclosed character family"))
            if start + 1 >= cursor then return Err(error("Empty character family"))
            name = textOf(start, cursor - 1)
        val caseless = has(CaseInsensitive)
        val sign = name.indexOf("=")
        if sign >= 0
            val key = name.slice(0, sign).toLowerCase()
            val value = name.slice(sign + 1, name.byteLength())
            val found =
                if key == "gc" || key == "general_category" then propertyByName(value, caseless)
                elif key == "sc" || key == "script" then scriptProperty(value)
                elif key == "blk" || key == "block" then blockProperty(value)
                else None
            return found match
                Some(test) -> Ok(negatedIf(complement, test))
                None -> Err(error("Unknown Unicode property {name=<" + key + ">, value=<" + value + ">}"))
        var found: Option[(int) -> bool] = None
        if name.startsWith("In")
            found = blockProperty(name.slice(2, name.byteLength()))
        elif name.startsWith("Is")
            val rest = name.slice(2, name.byteLength())
            found = binaryProperty(rest, caseless)
            if found is None then found = propertyByName(rest, caseless)
            if found is None then found = scriptProperty(rest)
        else
            if has(UnicodeCharacterClass) then found = unicodePosixClass(name.toUpperCase(), caseless)
            if found is None then found = propertyByName(name, caseless)
        found match
            Some(test) -> Ok(negatedIf(complement, test))
            None -> Err(error("Unknown character property name {" + name + "}"))

    // The pattern's characters from `from` up to `until` as a string.
    private textOf(from: int, until: int) -> string
        val w = StringWriter()
        for k in from..<until do w.writeChar(src(k))
        w.text()

// The pattern's characters followed by two zeros, which stand for its end.
private withEnd(codes: Buffer[char]) -> Array[char]
    codes.addOne('\u{0}')
    codes.addOne('\u{0}')
    codes.toArray()

private negatedIf(complement: bool, test: (int) -> bool) -> (int) -> bool = if complement then c -> !test(c) else test

private unionOf(left: Option[(int) -> bool], right: (int) -> bool) -> (int) -> bool = left match
    Some(l) -> c -> l(c) || right(c)
    None -> right

// The members of a table of the characters below 256.
private bitTest(bits: Array[bool]) -> (int) -> bool
    val table = bits.copy()
    c -> c < 256 && table(c)

// Whether a case partner of the ASCII character `c` lies in the range.
private caseRangeAscii(low: int, high: int, c: int) -> bool
    val u = asciiUpper(c)
    val l = asciiLower(c)
    (u >= low && u <= high) || (l >= low && l <= high)

// Whether the upper case of `c`, or the lower case of that, lies in the range.
private caseRangeUnicode(low: int, high: int, c: int) -> bool
    val u = upperOf(c)
    if u >= low && u <= high then return true
    val l = lowerOf(u)
    l >= low && l <= high

// A sequence of items as one tree.
private concatenation(items: Buffer[Tree]) -> Tree
    if items.isEmpty() then return Empty
    if items.length() == 1 then return items(0)
    Concat(items.toVector())
