module avin.regex

// The backtracking matcher. It runs a program over the input's characters, held as code points with
// the byte offset each one starts at. `run(pc, i)` answers whether the program from operation `pc`
// matches at character index `i` and on to an end. Each choice is tried in the pattern's order, so
// the first success found is the leftmost-first one.
//
// The matcher keeps its own backtrack stack, an array of frames, so however many repetitions a match
// takes, it takes no deeper a call stack. A choice pushes a frame naming the way not yet tried, and
// whatever a step overwrites that a failure must put back (a group's span, where a group began, a
// loop's count) pushes a frame holding the old value. A failure pops frames, putting values back,
// until one names a way still to try, and goes on from there; with none left the attempt fails. Only
// a part matched on its own (the item of a repetition matched one way, an atomic group, a
// lookaround's body) runs in a call of its own, with its frames above the caller's; when it succeeds
// its frames are dropped, so nothing it did is put back and none of its choices is tried again.
//
// Every attempt at a start has a step budget, each operation run and each frame popped one step; an
// attempt that spends it traps, as catastrophic backtracking would otherwise run for ever.

// The frames, each its fields and then its kind, so a frame is read from the top down.
// Where `local` held `value`: (local, value).
private val UndoLocal: int = 0
// Where `group` spanned `start` to `end`: (group, start, end).
private val UndoGroup: int = 1
// Go on at `pc` from `i`: (pc, i).
private val Resume: int = 2
// The `k`th alternative of the branch at `pc`, from `i`: (pc, k, i).
private val BranchNext: int = 3
// A reluctant `Ques` at `pc` that went on without its item from `i`: (pc, i).
private val QuesLazy: int = 4
// A greedy `Curly` giving back: go on to `next` from `i` with `j` repetitions, each `k` long, while
// `j` is at least `backLimit`: (next, i, j, k, backLimit).
private val CurlyGive: int = 5
// A reluctant `Curly` at `pc` that went on with `j` repetitions ending at `i`: (pc, i, j).
private val CurlyLazy: int = 6
// A greedy `CharLoop` giving back: go on to `next` from `i`, then from each index before it down to
// `least`: (next, least, i).
private val CharBack: int = 7
// A reluctant `CharLoop` at `pc` that went on with `j` repetitions ending at `i`: (pc, i, j).
private val CharLazy: int = 8
// A greedy `GroupCurly` at `pc` giving back: go on from `i` with `j` repetitions, each `k` long,
// down to `backLimit` of them, where the group spanned `start` to `end`: (pc, i, j, k, backLimit,
// start, end).
private val GroupCurlyGive: int = 9
// A reluctant `GroupCurly` at `pc` that went on with `j` repetitions ending at `i`: (pc, i, j).
private val GroupCurlyLazy: int = 10
// A reluctant `Loop` at `pc` that went on without a first repetition from `i`: (pc, i).
private val LoopLazyStart: int = 11
// A reluctant `Loop` at `pc` that went on after `n` repetitions ending at `i`: (pc, i, n).
private val LoopLazyMore: int = 12
// A greedy `Loop` at `pc` that tried repetition `n + 1` from `i`: when that fails, the count is
// `n` again, the failure is remembered, and the rest of the pattern is tried from `i`: (pc, i, n).
private val LoopRepeatFail: int = 13

// The steps an attempt may take, unless the regex sets its own: this many for each character of the
// input and each operation of the program, and never fewer than `LeastStepBudget`.
private val StepsPerCharacterAndOperation: long = 1000
private val LeastStepBudget: long = 10000000

// The step budget for an attempt over `length` characters with a program of `size` operations.
private stepBudget(length: int, size: int) -> long
    val b = long(length + 1) * long(size) * StepsPerCharacterAndOperation
    if b < LeastStepBudget then LeastStepBudget else b

private class Engine(val program: Program, val text: Array[int])
    private val ops: Array[Op] = program.ops
    private val to: int = text.length()
    // The start and end of each group, as character indices, -1 where the group has not matched.
    val groups: Array[int] = Array.fill(program.groupCount * 2, -1)
    private val locals: Array[int] = Array.fill(program.localCount, -1)
    // Where the last part matched on its own ended.
    var last = 0
    // Where the previous match ended, for `\G`; -1 before the first.
    var oldLast = -1
    // Where the match being made started.
    var first = -1
    private var lookbehindTo = 0
    private var wholeInput = false
    // For each remembering loop, the attempt in which a repetition last failed at each index: a mark
    // counts only in the attempt that made it, so starting an attempt forgets every mark at once.
    // Made when the first mark is.
    private var failures: Array[int] = Array.empty[int]()
    private var attempt = 0
    // The backtrack stack: its frames are the first `top` elements.
    private var stack: Array[int] = Array.fill(64, 0)
    private var top = 0
    // The steps the current attempt has taken, and how many it may.
    private var steps: long = 0
    private val budget: long = if program.stepLimit > 0 then program.stepLimit else stepBudget(text.length(), program.ops.length())
    // Where a step goes on: the operation and the index.
    private var nextPc = 0
    private var nextAt = 0

    private clear()
        for k in 0..<groups.length() do groups(k) = -1
        for k in 0..<locals.length() do locals(k) = -1
        attempt += 1
        top = 0

    private failedBefore(memo: int, i: int) -> bool = failures.length() > 0 && failures(memo * (to + 1) + i) == attempt

    private markFailed(memo: int, i: int)
        if failures.length() == 0 then failures = Array.fill(program.memoCount * (to + 1), 0)
        failures(memo * (to + 1) + i) = attempt

    // Searches for a match starting at `from` or after it; on success the groups hold it.
    search(from: int) -> bool
        first = from
        if oldLast < 0 then oldLast = from
        clear()
        wholeInput = false
        val found = scan(from)
        if !found then first = -1
        oldLast = last
        found

    // Matches at `from` exactly: the whole input to its end when `whole`, otherwise a prefix.
    matchAt(from: int, whole: bool) -> bool
        first = from
        if oldLast < 0 then oldLast = from
        clear()
        wholeInput = whole
        steps = 0
        val found = run(program.entry, from)
        if found
            groups(0) = from
            groups(1) = last
        else
            first = -1
        oldLast = last
        found

    private scan(from: int) -> bool
        val guard = to - program.minLength
        if program.startsAtBeginning
            steps = 0
            if from == 0 && guard >= 0 && run(program.entry, 0)
                return found(0)
            return false
        val entry = ops(program.entry)
        var i = from
        while i <= guard
            val worth = entry match
                CharOp(set, _) -> i < to && set.contains(text(i))
                LiteralOp(codes, _) -> i < to && text(i) == codes(0)
                _ -> true
            steps = 0
            if worth && run(program.entry, i) then return found(i)
            i += 1
        false

    private found(i: int) -> bool
        first = i
        groups(0) = i
        groups(1) = last
        true

    // One step more of the attempt, trapping once the budget is spent.
    private step()
        steps += 1
        if steps > budget
            val limit = if program.stepLimit > 0 then s" (step limit ${program.stepLimit})" else ""
            fail(s"pattern `${program.text}` backtracked too far on a ${to}-character input$limit; make a repetition possessive or atomic")

    // Room on the stack for `n` more elements.
    private reserve(n: int)
        if top + n > stack.length()
            var size = stack.length() * 2
            while top + n > size do size *= 2
            val bigger = Array.fill(size, 0)
            for k in 0..<top do bigger(k) = stack(k)
            stack = bigger

    private push2(a: int, b: int, kind: int)
        reserve(3)
        stack(top) = a
        stack(top + 1) = b
        stack(top + 2) = kind
        top += 3

    private push3(a: int, b: int, c: int, kind: int)
        reserve(4)
        stack(top) = a
        stack(top + 1) = b
        stack(top + 2) = c
        stack(top + 3) = kind
        top += 4

    private push5(a: int, b: int, c: int, d: int, e: int, kind: int)
        reserve(6)
        stack(top) = a
        stack(top + 1) = b
        stack(top + 2) = c
        stack(top + 3) = d
        stack(top + 4) = e
        stack(top + 5) = kind
        top += 6

    private push7(a: int, b: int, c: int, d: int, e: int, f: int, g: int, kind: int)
        reserve(8)
        stack(top) = a
        stack(top + 1) = b
        stack(top + 2) = c
        stack(top + 3) = d
        stack(top + 4) = e
        stack(top + 5) = f
        stack(top + 6) = g
        stack(top + 7) = kind
        top += 8

    // Goes on at `pc` from `i`.
    private goOn(pc: int, i: int) -> bool
        nextPc = pc
        nextAt = i
        true

    // Whether the program from `start` matches at `from`. The frames this call pushes sit above
    // `base`; on either answer the stack is cut back to it.
    run(start: int, from: int) -> bool
        val base = top
        var pc = start
        var i = from
        var failed = false
        loop
            step()
            if failed
                if !backtrack(base) then return false
                failed = false
                pc = nextPc
                i = nextAt
                continue
            ops(pc) match
                Accept ->
                    if wholeInput && i != to
                        failed = true
                    else
                        last = i
                        top = base
                        return true
                SetLast ->
                    last = i
                    top = base
                    return true
                LookbehindEnd ->
                    if i != lookbehindTo
                        failed = true
                    else
                        top = base
                        return true
                CharOp(set, next) ->
                    if i >= to || !set.contains(text(i))
                        failed = true
                    else
                        pc = next
                        i += 1
                LiteralOp(codes, next) ->
                    if literalAt(codes, i)
                        pc = next
                        i += codes.length()
                    else
                        failed = true
                AnchorOp(kind, next) ->
                    if anchor(kind, i) then pc = next else failed = true
                BoundaryOp(boundary, unicode, next) ->
                    if isBoundary(i, unicode) == boundary then pc = next else failed = true
                LineBreakOp(next) ->
                    val size = lineBreak(i)
                    if size == 0
                        failed = true
                    else
                        // `\r\n` gives back its `\n` if the rest fails.
                        if size == 2 then push2(next, i + 1, Resume)
                        pc = next
                        i += size
                GraphemeBoundaryOp(next) ->
                    if isGraphemeBoundary(text, i, to) then pc = next else failed = true
                GraphemeOp(next) ->
                    if i >= to
                        failed = true
                    else
                        i = graphemeEnd(text, i, to)
                        pc = next
                GroupHead(local, next) ->
                    push2(local, locals(local), UndoLocal)
                    locals(local) = i
                    pc = next
                GroupTail(local, group, next) ->
                    if group >= 0
                        push3(group, groups(group * 2), groups(group * 2 + 1), UndoGroup)
                        groups(group * 2) = locals(local)
                        groups(group * 2 + 1) = i
                    pc = next
                Branch(alternatives) ->
                    if alternatives.length() > 1 then push3(pc, 1, i, BranchNext)
                    pc = alternatives(0)
                Ques(atom, mode, next) ->
                    if mode == Greedy
                        if run(atom, i)
                            push2(next, i, Resume)
                            i = last
                    elif mode == Lazy
                        push2(pc, i, QuesLazy)
                    elif mode == Possessive
                        if run(atom, i) then i = last
                    elif run(atom, i)
                        i = last
                    else
                        failed = true
                    pc = next
                Curly(atom, least, most, mode, next) ->
                    if curly(pc, atom, least, most, mode, next, i)
                        pc = nextPc
                        i = nextAt
                    else
                        failed = true
                CharLoop(set, least, most, mode, next) ->
                    if charLoop(pc, set, least, most, mode, next, i)
                        pc = nextPc
                        i = nextAt
                    else
                        failed = true
                GroupCurly(atom, least, most, mode, group, next) ->
                    if groupCurly(pc, atom, least, most, mode, group, next, i)
                        pc = nextPc
                        i = nextAt
                    else
                        failed = true
                Prolog(entry) ->
                    if loopStart(entry, i)
                        pc = nextPc
                        i = nextAt
                    else
                        failed = true
                Loop(body, count, begin, least, most, lazy, memo, next) ->
                    loopEnd(pc, body, count, begin, least, most, lazy, memo, next, i)
                    pc = nextPc
                    i = nextAt
                LookOp(kind, cond, least, most, next) ->
                    if look(kind, cond, least, most, i) then pc = next else failed = true
                BackReferenceOp(group, caseless, unicode, next) ->
                    val size = backReference(group, caseless, unicode, i)
                    if size < 0
                        failed = true
                    else
                        pc = next
                        i += size

    // Pops frames down to `base`, putting back what each held, until one names a way still to try;
    // answers whether one did, with where to go on in `nextPc` and `nextAt`.
    private backtrack(base: int) -> bool
        loop
            if top <= base then return false
            val kind = stack(top - 1)
            if kind == UndoLocal
                top -= 3
                locals(stack(top)) = stack(top + 1)
            elif kind == UndoGroup
                top -= 4
                val group = stack(top)
                groups(group * 2) = stack(top + 1)
                groups(group * 2 + 1) = stack(top + 2)
            elif kind == Resume
                top -= 3
                return goOn(stack(top), stack(top + 1))
            elif kind == BranchNext
                val at = top - 4
                val pc = stack(at)
                val k = stack(at + 1)
                val i = stack(at + 2)
                val alternatives = ops(pc) match
                    Branch(alternatives) -> alternatives
                    _ -> Array.empty[int]()
                if k + 1 < alternatives.length() then stack(at + 1) = k + 1 else top = at
                return goOn(alternatives(k), i)
            elif kind == CharBack
                val at = top - 4
                val next = stack(at)
                val least = stack(at + 1)
                val i = stack(at + 2)
                if i > least then stack(at + 2) = i - 1 else top = at
                return goOn(next, i)
            elif kind == CurlyGive
                val at = top - 6
                val next = stack(at)
                val i = stack(at + 1)
                val j = stack(at + 2)
                val k = stack(at + 3)
                if j - 1 >= stack(at + 4)
                    stack(at + 1) = i - k
                    stack(at + 2) = j - 1
                else
                    top = at
                return goOn(next, i)
            elif kind == GroupCurlyGive
                val at = top - 8
                return ops(stack(at)) match
                    GroupCurly(_, _, _, _, group, next) -> groupGiveBack(at, group, next)
                    _ -> false
            elif kind == LoopRepeatFail
                top -= 4
                val pc = stack(top)
                val i = stack(top + 1)
                ops(pc) match
                    Loop(_, count, _, _, _, _, memo, next) ->
                        locals(count) = stack(top + 2)
                        if memo >= 0 then markFailed(memo, i)
                        return goOn(next, i)
                    _ -> ()
            elif retry(kind)
                return true
            step()

    // The frames that try a reluctant item once more, or a loop's first repetition: whether the way
    // `kind` names can still go on, with where in `nextPc` and `nextAt`. Each is popped first, as
    // trying the item again is a part matched on its own, run above the frames below.
    private retry(kind: int) -> bool
        if kind == QuesLazy
            top -= 3
            val pc = stack(top)
            val i = stack(top + 1)
            return ops(pc) match
                Ques(atom, _, next) -> run(atom, i) && goOn(next, last)
                _ -> false
        if kind == CharLazy
            top -= 4
            val pc = stack(top)
            val i = stack(top + 1)
            val j = stack(top + 2)
            return ops(pc) match
                CharLoop(set, _, most, _, next) ->
                    if j >= most || i >= to || !set.contains(text(i)) then return false
                    push3(pc, i + 1, j + 1, CharLazy)
                    goOn(next, i + 1)
                _ -> false
        if kind == CurlyLazy
            top -= 4
            val pc = stack(top)
            val i = stack(top + 1)
            val j = stack(top + 2)
            return ops(pc) match
                Curly(atom, _, most, _, next) ->
                    if j >= most || !run(atom, i) || i == last then return false
                    val end = last
                    push3(pc, end, j + 1, CurlyLazy)
                    goOn(next, end)
                _ -> false
        if kind == GroupCurlyLazy
            top -= 4
            val pc = stack(top)
            val i = stack(top + 1)
            val j = stack(top + 2)
            return ops(pc) match
                GroupCurly(atom, _, most, _, group, next) ->
                    if j >= most || !run(atom, i) || i == last then return false
                    val end = last
                    if group >= 0 then setGroup(group, i, end)
                    push3(pc, end, j + 1, GroupCurlyLazy)
                    goOn(next, end)
                _ -> false
        if kind == LoopLazyStart
            top -= 3
            val pc = stack(top)
            val i = stack(top + 1)
            return ops(pc) match
                Loop(body, count, _, _, most, _, _, _) ->
                    if 0 >= most then return false
                    locals(count) = 1
                    goOn(body, i)
                _ -> false
        if kind == LoopLazyMore
            top -= 4
            val pc = stack(top)
            val i = stack(top + 1)
            val n = stack(top + 2)
            return ops(pc) match
                Loop(body, count, _, _, most, _, _, _) ->
                    if n >= most then return false
                    push2(count, n, UndoLocal)
                    locals(count) = n + 1
                    goOn(body, i)
                _ -> false
        fail("unknown backtrack frame")

    // The `GroupCurlyGive` frame at `at` giving back: the try from where it stands, with the span
    // before it, and the frame stepped back one repetition; once it has given back all its level
    // took, the span the level started with and the frame gone.
    private groupGiveBack(at: int, group: int, next: int) -> bool
        val i = stack(at + 1)
        val j = stack(at + 2)
        val k = stack(at + 3)
        if j > stack(at + 4)
            if group >= 0 then setGroup(group, i - k, i)
            stack(at + 1) = i - k
            stack(at + 2) = j - 1
        else
            if group >= 0 then setGroup(group, stack(at + 5), stack(at + 6))
            top = at
        goOn(next, i)

    // Whether `codes` are the characters at `i`.
    private literalAt(codes: Array[int], i: int) -> bool
        val n = codes.length()
        if i + n > to then return false
        var k = 0
        while k < n
            if text(i + k) != codes(k) then return false
            k += 1
        true

    private setGroup(group: int, start: int, end: int)
        groups(group * 2) = start
        groups(group * 2 + 1) = end

    private anchor(kind: AnchorKind, i: int) -> bool = kind match
        Begin -> i == 0
        EndOfInput -> i == to
        LastMatch -> i == oldLast
        Caret(unixLines) ->
            if i == to then return false
            if i > 0
                val ch = text(i - 1)
                if unixLines then return ch == 10
                if !isLineTerminator(ch) then return false
                if ch == 13 && text(i) == 10 then return false
            true
        Dollar(multiline, unixLines) -> if unixLines then unixDollar(multiline, i) else dollar(multiline, i)

    private dollar(multiline: bool, i: int) -> bool
        if !multiline
            if i < to - 2 then return false
            if i == to - 2 && (text(i) != 13 || text(i + 1) != 10) then return false
        if i < to
            val ch = text(i)
            if ch == 10
                if i > 0 && text(i - 1) == 13 then return false
                return true
            if ch == 13 || ch == 0x85 || ch == 0x2028 || ch == 0x2029 then return true
            return false
        true

    private unixDollar(multiline: bool, i: int) -> bool
        if i < to
            if text(i) != 10 then return false
            if !multiline && i != to - 1 then return false
        true

    // A word character for `\b`: an ASCII letter, digit or underscore, or with `unicode` a character
    // `\w` takes under the `U` flag, or a non-spacing mark that follows letters or digits.
    private isWordAt(i: int, unicode: bool) -> bool
        val ch = text(i)
        if (if unicode then isWord(ch) else isAsciiWord(ch)) then return true
        if !isNonSpacingMark(ch) then return false
        var k = i
        while k >= 0
            val c = text(k)
            if isUnicodeLetterOrDigit(c) then return true
            if !isNonSpacingMark(c) then return false
            k -= 1
        false

    private isBoundary(i: int, unicode: bool) -> bool
        val left = i > 0 && isWordAt(i - 1, unicode)
        val right = i < to && isWordAt(i, unicode)
        left != right

    // How many characters `\R` takes at `i`, 0 where it does not match: `\r\n`, or one of the
    // vertical characters.
    private lineBreak(i: int) -> int
        if i >= to then return 0
        val ch = text(i)
        if ch == 10 || ch == 11 || ch == 12 || ch == 0x85 || ch == 0x2028 || ch == 0x2029 then return 1
        if ch == 13 then return if i + 1 < to && text(i + 1) == 10 then 2 else 1
        0

    // An item repeated; each repetition is the item's first match, and a greedy repetition gives back
    // one repetition at a time.
    private curly(pc: int, atom: int, least: int, most: int, mode: int, next: int, start: int) -> bool
        var i = start
        var j = 0
        while j < least
            if !run(atom, i) then return false
            i = last
            j += 1
        if mode == Greedy then return curlyGreedy(atom, most, next, i, j)
        if mode == Lazy
            push3(pc, i, j, CurlyLazy)
            return goOn(next, i)
        while j < most
            if !run(atom, i) then break
            if i == last then break
            i = last
            j += 1
        goOn(next, i)

    // A greedy repetition takes repetitions while they are all one length, `k`, which it can give
    // back by stepping back; where a repetition's length differs, it goes on from there as a
    // repetition of its own, giving back to here once that has given back all it took.
    private curlyGreedy(atom: int, most: int, next: int, start: int, count: int) -> bool
        var i = start
        var j = count
        loop
            if j >= most then return goOn(next, i)
            val backLimit = j
            if !run(atom, i) then return goOn(next, i)
            val k = last - i
            if k == 0 then return goOn(next, i)
            i = last
            j += 1
            var again = false
            while j < most
                if !run(atom, i) then break
                if i + k != last
                    push5(next, i, j, k, backLimit, CurlyGive)
                    i = last
                    j += 1
                    again = true
                    break
                i += k
                j += 1
            if !again
                if j - 1 >= backLimit then push5(next, i - k, j - 1, k, backLimit, CurlyGive)
                return goOn(next, i)

    // One character of a set repeated.
    private charLoop(pc: int, set: CharSet, least: int, most: int, mode: int, next: int, start: int) -> bool
        var i = start
        var j = 0
        while j < least
            if i >= to || !set.contains(text(i)) then return false
            i += 1
            j += 1
        if mode == Lazy
            push3(pc, i, j, CharLazy)
            return goOn(next, i)
        while j < most && i < to && set.contains(text(i))
            i += 1
            j += 1
        if mode == Possessive then return goOn(next, i)
        val lowest = i - (j - least)
        if i > lowest then push3(next, lowest, i - 1, CharBack)
        goOn(next, i)

    // A group whose body has one length, repeated, its span recorded at each repetition; a failure
    // puts back the span it had before.
    private groupCurly(pc: int, atom: int, least: int, most: int, mode: int, group: int, next: int, start: int) -> bool
        val capture = group >= 0
        if capture then push3(group, groups(group * 2), groups(group * 2 + 1), UndoGroup)
        var i = start
        var j = 0
        while j < least
            if !run(atom, i) then return false
            if capture then setGroup(group, i, last)
            i = last
            j += 1
        if mode == Greedy then return groupCurlyGreedy(pc, atom, most, group, next, i, least)
        if mode == Lazy
            push3(pc, i, least, GroupCurlyLazy)
            return goOn(next, i)
        while j < most
            if !run(atom, i) then break
            if capture then setGroup(group, i, last)
            if i == last then break
            i = last
            j += 1
        goOn(next, i)

    // As `curlyGreedy`, recording the group's span: each repetition given back leaves the one before
    // it as the span, and giving back every repetition this level took puts back the span the level
    // started with.
    private groupCurlyGreedy(pc: int, atom: int, most: int, group: int, next: int, start: int, count: int) -> bool
        val capture = group >= 0
        var i = start
        var j = count
        loop
            val backLimit = j
            val savedStart = if capture then groups(group * 2) else 0
            val savedEnd = if capture then groups(group * 2 + 1) else 0
            if j >= most || !run(atom, i) then return goOn(next, i)
            val k = last - i
            if k <= 0
                i = i + k
                if capture then setGroup(group, savedStart, savedEnd)
                return goOn(next, i)
            var again = false
            loop
                if capture then setGroup(group, i, i + k)
                i = i + k
                j += 1
                if j >= most then break
                if !run(atom, i) then break
                if i + k != last
                    again = true
                    break
            push7(pc, i, j, k, backLimit, savedStart, savedEnd, GroupCurlyGive)
            if !again then return false

    // The first repetition of a `Loop`, from its `Prolog`; the count is put back when it fails, so
    // an enclosing repetition of the same loop finds its own.
    private loopStart(entry: int, i: int) -> bool = ops(entry) match
        Loop(body, count, _, least, most, lazy, _, next) ->
            push2(count, locals(count), UndoLocal)
            if 0 < least
                locals(count) = 1
                return goOn(body, i)
            if lazy
                push2(entry, i, LoopLazyStart)
                return goOn(next, i)
            if 0 < most
                locals(count) = 1
                push2(next, i, Resume)
                return goOn(body, i)
            goOn(next, i)
        _ -> false

    // The end of a repetition of a loop's body: another repetition, or the rest of the pattern. A
    // repetition that matched nothing ends the loop.
    private loopEnd(pc: int, body: int, count: int, begin: int, least: int, most: int, lazy: bool, memo: int, next: int, i: int)
        if i > locals(begin)
            val n = locals(count)
            if n < least
                push2(count, n, UndoLocal)
                locals(count) = n + 1
                goOn(body, i)
                return
            if lazy
                push3(pc, i, n, LoopLazyMore)
                goOn(next, i)
                return
            if n < most && (memo < 0 || !failedBefore(memo, i))
                push3(pc, i, n, LoopRepeatFail)
                locals(count) = n + 1
                goOn(body, i)
                return
        goOn(next, i)

    // A lookaround at `i`. A lookbehind tries its body from each start its lengths allow, nearest
    // first, and the body must end at `i`.
    private look(kind: LookKind, cond: int, least: int, most: int, i: int) -> bool = kind match
        Ahead -> run(cond, i)
        NotAhead -> !run(cond, i)
        Behind -> behind(cond, least, most, i)
        NotBehind -> !behind(cond, least, most, i)

    private behind(cond: int, least: int, most: int, i: int) -> bool
        val savedTo = lookbehindTo
        lookbehindTo = i
        val from = if i - most > 0 then i - most else 0
        var matched = false
        var j = i - least
        while !matched && j >= from
            matched = run(cond, j)
            j -= 1
        lookbehindTo = savedTo
        matched

    // The length of the text group `group` matched, when it matches again at `i`, or -1.
    private backReference(group: int, caseless: bool, unicode: bool, i: int) -> int
        if group * 2 >= groups.length() then return -1
        val j = groups(group * 2)
        if j < 0 then return -1
        val size = groups(group * 2 + 1) - j
        if i + size > to then return -1
        for k in 0..<size
            val c1 = text(i + k)
            val c2 = text(j + k)
            if c1 != c2
                if !caseless then return -1
                if unicode
                    val u1 = upperOf(c1)
                    val u2 = upperOf(c2)
                    if u1 != u2 && lowerOf(u1) != lowerOf(u2) then return -1
                elif asciiLower(c1) != asciiLower(c2)
                    return -1
        size
