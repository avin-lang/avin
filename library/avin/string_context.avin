module avin

// An interpolated string is a method call on a `StringContext`. `p"text $a and ${b + 1}"` is
// `StringContext(["text ", " and ", ""]).p(a, b + 1)`: the literal pieces between the holes become
// the context's parts, as written, with their escapes not yet decoded, and the holes become the
// method's arguments. There is always one more part than there are holes. `s`, `f` and `raw` are
// the core library's interpolators; a program adds its own with a trait and an `impl` of it for
// `StringContext`.
data StringContext(parts: Vector[string])

impl StringContext
    // The parts with their escapes decoded and each argument's `Display` form between them. The
    // compiler writes an `s"…"` literal out directly, to the same text.
    s(args: Display*) -> string = joined(args, true)

    // The parts exactly as written, escapes and all, with each argument's `Display` form between
    // them.
    raw(args: Display*) -> string = joined(args, false)

    // The parts with their escapes decoded and each argument rendered between them as an `f"…"`
    // literal renders it, with the specifier at the start of the part after it read as the program
    // runs. A width or precision written as a hole is an argument of its own, an `int` or a `long`.
    // An argument renders in its own form under a conversion its type does not take. The compiler
    // writes an `f"…"` literal out directly, checking its specifiers as it compiles them; here a
    // specifier that is malformed, a count that is not an `int` or a `long`, and `%?`, which asks for
    // a `Debug` form a `Display` argument does not have, trap.
    f(args: Display*) -> string
        if args.length != parts.length - 1 then fail(s"an interpolator was given ${args.length} arguments for ${parts.length} parts")
        val out = StringWriter()
        writeDecoded(out, parts(0))
        var k = 0
        while k < args.length
            val value = args(k)
            k += 1
            var part = parts(k)
            if !part.startsWith("%")
                value.display(out, FormatSpec())
                writeDecoded(out, part)
                continue
            var left = false
            var plus = false
            var space = false
            var zeroPad = false
            var alternate = false
            var grouping = false
            var at = 1
            while at < part.byteLength && isFlag(part.charAt(at))
                val flag = part.charAt(at)
                if flag == '-' then left = true
                elif flag == '+' then plus = true
                elif flag == ' ' then space = true
                elif flag == '0' then zeroPad = true
                elif flag == ',' then grouping = true
                else alternate = true
                at += 1
            var width = 0
            var widthArgument: Option[Display] = None
            if at == part.byteLength && k < args.length
                widthArgument = Some(args(k))
                k += 1
                part = parts(k)
                at = 0
            else
                while at < part.byteLength && isDigit(part.charAt(at))
                    width = countDigit(width, part.charAt(at), "width")
                    at += 1
            var precision = -1
            var precisionArgument: Option[Display] = None
            if at < part.byteLength && part.charAt(at) == '.'
                at += 1
                precision = 0
                if at == part.byteLength && k < args.length
                    precisionArgument = Some(args(k))
                    k += 1
                    part = parts(k)
                    at = 0
                else
                    while at < part.byteLength && isDigit(part.charAt(at))
                        precision = countDigit(precision, part.charAt(at), "precision")
                        at += 1
            if at >= part.byteLength then fail("a format specifier has no conversion: a `%` right after a hole begins one, such as `%d` or `%s`")
            val conversion = part.charAt(at)
            if conversion == 'u' then fail("`%u` is not a format conversion: integers are signed, so `%d` writes every one")
            if conversion == '?' then fail("`%?` asks for a value's `Debug` form, which a `Display` argument does not have")
            if !"dixXobfeEgGcs".contains(conversion.toString()) then fail(s"`%$conversion` is not a format conversion")
            at += 1
            var spec = FormatSpec(width, precision, left, zeroPad, plus, space, alternate, conversion, grouping)
            if widthArgument is Some(n) then spec = spec.withWidth(countOf(n))
            if precisionArgument is Some(n) then spec = spec.withPrecision(countOf(n))
            writeDisplayed(out, value, spec)
            writeDecoded(out, part.slice(at, part.byteLength))
        out.text

    // The parts, decoded when `decode`, alternating with the arguments. A context given a number of
    // arguments other than one fewer than its parts traps.
    private joined(args: Vector[Display], decode: bool) -> string
        if args.length != parts.length - 1 then fail(s"an interpolator was given ${args.length} arguments for ${parts.length} parts")
        val out = StringWriter()
        for i in 0..<parts.length
            if i > 0 then args(i - 1).display(out, FormatSpec())
            if decode then writeDecoded(out, parts(i)) else out.write(parts(i))
        out.text

private isDigit(c: char) -> bool = '0' <= c <= '9'

private isFlag(c: char) -> bool = c == '-' || c == '+' || c == ' ' || c == '0' || c == '#' || c == ','

// `count` with the digit `d` written after it, which traps beyond the largest `int`.
private countDigit(count: int, d: char, what: string) -> int
    val next = long(count) * 10 + long(int(d) - int('0'))
    if next > 2147483647 then fail(s"a format $what is at most 2147483647")
    int(next)

// A width or precision given as an argument, which has to be an `int` or a `long`.
private countOf(n: Display) -> long =
    if n is i: int then long(i)
    elif n is l: long then l
    else fail("a width or precision given as an argument has to be an `int` or a `long`")

// Writes `part` with its escapes decoded, as a string literal's are: `\n`, `\t`, `\r`, `\0`, `\a`,
// `\b`, `\f`, `\v`, `\e`, a backslash before `\`, `"`, `'`, `` ` `` or `/` for that character,
// `\xHH`, `\uHHHH` (a surrogate pair as two of them), `\u{H…}` and `\UHHHHHHHH`. Anything else after
// a backslash traps, as it is no escape.
private writeDecoded(out: Writer, part: string)
    val n = part.byteLength
    var from = 0
    var at = 0
    while at < n
        if part.byteAt(at) != byte(0x5c)
            at += 1
            continue
        out.write(part.slice(from, at))
        if at + 1 >= n then fail("a backslash ends the text, escaping nothing")
        val letter = part.charAt(at + 1)
        at += 2
        letter match
            'n' -> out.writeChar('\n')
            't' -> out.writeChar('\t')
            'r' -> out.writeChar('\r')
            '0' -> out.writeChar(char(0))
            'a' -> out.writeChar(char(7))
            'b' -> out.writeChar(char(8))
            'f' -> out.writeChar(char(12))
            'v' -> out.writeChar(char(11))
            'e' -> out.writeChar(char(27))
            '\\' | '"' | '\'' | '`' | '/' -> out.writeChar(letter)
            'x' ->
                out.writeChar(char(hexDigits(part, at, 2)))
                at += 2
            'U' ->
                out.writeChar(char(hexDigits(part, at, 8)))
                at += 8
            'u' ->
                if at < n && part.byteAt(at) == byte(0x7b)
                    val close = part.indexOf("}", at)
                    if close < 0 then fail("`\\u{` is not closed")
                    if close == at + 1 || close > at + 7 then fail("`\\u{…}` takes one to six hexadecimal digits")
                    out.writeChar(char(hexDigits(part, at + 1, close - at - 1)))
                    at = close + 1
                else
                    val high = hexDigits(part, at, 4)
                    at += 4
                    if 0xd800 <= high <= 0xdbff
                        if !part.startsWith("\\u", at) then fail("a high surrogate escape needs a low one after it")
                        val low = hexDigits(part, at + 2, 4)
                        if low < 0xdc00 || low > 0xdfff then fail("a high surrogate escape needs a low one after it")
                        out.writeChar(char(0x10000 + ((high - 0xd800) << 10) + (low - 0xdc00)))
                        at += 6
                    else out.writeChar(char(high))
            _ -> fail(s"`\\$letter` is not an escape")
        from = at
    out.write(part.slice(from, n))

// The value of the `count` hexadecimal digits at byte offset `at`, which traps when any is missing or
// is not a hexadecimal digit.
private hexDigits(text: string, at: int, count: int) -> int
    if at + count > text.byteLength then fail(s"an escape needs $count hexadecimal digits")
    var value = 0
    for i in at..<at + count
        val b = int(text.byteAt(i))
        val digit =
            if int('0') <= b <= int('9') then b - int('0')
            elif int('a') <= b <= int('f') then b - int('a') + 10
            elif int('A') <= b <= int('F') then b - int('A') + 10
            else fail(s"an escape needs $count hexadecimal digits")
        value = value * 16 + digit
    value
