module avin

// Every sort in the library is this one: a merge sort, which is stable, so elements that compare
// equal keep the order they had, and which takes time proportional to n log n comparisons in the
// worst case. Runs of a few elements are first sorted by insertion, which is faster at that size,
// and the runs are then merged pairwise, wider each pass, between the array and one scratch copy of
// it. A comparison is negative, zero or positive as its first argument orders before, with or after
// its second, as `Ord.compare` is.

// Sorts the first `count` elements of `items` in place by `compare`.
private sortElements[T](items: Array[T], count: int, compare: (T, T) -> int)
  if count < 2 then return
  val run = 16
  var start = 0
  while start < count
    val stop = if count - start > run then start + run else count
    insertionSort(items, start, stop, compare)
    start = stop
  if count <= run then return
  var source = items
  var target = items.slice(0, count)
  var inScratch = false
  var width = run
  while width < count
    var low = 0
    while low < count
      val middle = if count - low > width then low + width else count
      val high = if count - middle > width then middle + width else count
      mergeRuns(source, target, low, middle, high, compare)
      low = high
    val merged = target
    target = source
    source = merged
    inScratch = !inScratch
    width = if count - width > width then width * 2 else count
  if inScratch then for i in 0 ..< count do items(i) = source(i)

// Sorts the elements of `items` from `from` up to `until` in place by `compare`, moving each one back
// past the elements greater than it, and no further, so equal elements keep their order.
private insertionSort[T](items: Array[T], from: int, until: int, compare: (T, T) -> int)
  for i in from + 1 ..< until
    val x = items(i)
    var j = i - 1
    while j >= from && compare(items(j), x) > 0
      items(j + 1) = items(j)
      j -= 1
    items(j + 1) = x

// Merges the sorted runs of `source` from `low` up to `middle` and from `middle` up to `high` into
// `target` at the same indices, taking from the first run while its element is not greater than the
// second's, so equal elements keep their order.
private mergeRuns[T](source: Array[T], target: Array[T], low: int, middle: int, high: int, compare: (T, T) -> int)
  var i = low
  var j = middle
  for k in low ..< high
    if i < middle && (j >= high || compare(source(j), source(i)) >= 0)
      target(k) = source(i)
      i += 1
    else
      target(k) = source(j)
      j += 1

// Sorts the first `count` elements of `items` in place by `key`, which is computed once for each
// element; the elements are then reordered as their keys sort.
private sortElementsBy[T, K: Ord](items: Array[T], count: int, key: (T) -> K)
  if count < 2 then return
  val keys = Array.tabulate(count, i -> key(items(i)))
  val order = Array.tabulate(count, i -> i)
  sortElements(order, count, (a, b) -> keys(a).compare(keys(b)))
  val elements = items.slice(0, count)
  for i in 0 ..< count do items(i) = elements(order(i))

// A new array of the elements of `xs`, in order, reached through its iterator, so a list is walked
// once rather than indexed.
private elementArray[T](xs: Seq[T]) -> Array[T]
  val a = newArray[T](xs.length)
  var i = 0
  for x in xs
    a(i) = x
    i += 1
  a
