module avin

// Composing functions. A function type is a trait, so these methods reach every value that is a
// function of their shape: a lambda, a reference to a function, a method value, and a value of a type
// that names a function type, a sequence or a map among them.

impl[A, B] (A) -> B
    // The function that runs this one and then `g` on its result: `f.andThen(g)(x)` is `g(f(x))`.
    andThen[C](g: (B) -> C) -> (A) -> C = x -> g(self(x))

    // The function that runs `g` and then this one on its result: `f.compose(g)(x)` is `f(g(x))`.
    compose[Z](g: (Z) -> A) -> (Z) -> B = x -> self(g(x))

impl[A, B, C] (A, B) -> C
    // This function taking its two arguments as one pair: `f.tupled()((a, b))` is `f(a, b)`.
    tupled() -> ((A, B)) -> C = (pair: (A, B)) -> self(pair.0, pair.1)
