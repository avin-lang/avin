module avin

// A value of one of two types: `Left(value)` holds an `L`, `Right(value)` holds an `R`. The methods
// are right-biased: `map`, `flatMap` and the rest work on a `Right` and pass a `Left` through, so a
// `Left` is the usual place for the reason something did not give a value.
data Either[+L, +R]
  Left(value: L)
  Right(value: R)

// As for `Option`, a method taking a value that may be wider than `L` or `R` takes it as a type with
// that side as its lower bound: `getOrElse(animal)` on an `Either[string, Cat]` is an `Animal`.
impl[L, R] Either[L, R]
  isLeft -> bool = self match
    Left(_) -> true
    Right(_) -> false

  isRight -> bool = !isLeft

  // `fa` of the value of a `Left`, or `fb` of the value of a `Right`.
  fold[C](fa: (L) -> C, fb: (R) -> C) -> C = self match
    Left(a) -> fa(a)
    Right(b) -> fb(b)

  // The same value on the other side: a `Left` becomes a `Right` and a `Right` a `Left`.
  swap -> Either[R, L] = self match
    Left(a) -> Right(a)
    Right(b) -> Left(b)

  map[R2](f: (R) -> R2) -> Either[L, R2] = self match
    Left(a) -> Left(a)
    Right(b) -> Right(f(b))

  flatMap[L1 >: L, R2](f: (R) -> Either[L1, R2]) -> Either[L1, R2] = self match
    Left(a) -> Left(a)
    Right(b) -> f(b)

  // The value of a `Right`, or `default`, which is evaluated only for a `Left`.
  getOrElse[R1 >: R](default: -> R1) -> R1 = self match
    Right(b) -> b
    Left(_) -> default

  // This either if it is a `Right`, otherwise `other`, evaluated only then.
  orElse[L1 >: L, R1 >: R](other: -> Either[L1, R1]) -> Either[L1, R1] = self match
    Right(_) -> self
    Left(_) -> other

  // Whether it is a `Right` whose value is equal to `x`, by `==`.
  contains[R1 >: R](x: R1) -> bool = self match
    Right(b) -> b == x
    Left(_) -> false

  // Whether it is a `Right` whose value satisfies `p`; false for a `Left`.
  exists(p: (R) -> bool) -> bool = self match
    Right(b) -> p(b)
    Left(_) -> false

  // Whether every right value satisfies `p`: true for a `Left`, which has none.
  forall(p: (R) -> bool) -> bool = self match
    Right(b) -> p(b)
    Left(_) -> true

  // This either if it is a `Right` whose value satisfies `p`, a `Left` of `zero` if it is a `Right`
  // whose value does not, and this `Left` unchanged. `zero` is evaluated only when it is used.
  filterOrElse[L1 >: L](p: (R) -> bool, zero: -> L1) -> Either[L1, R] = self match
    Right(b) -> if p(b) then self else Left(zero)
    Left(_) -> self

  // The value of a `Right` as `Some`, or `None` for a `Left`.
  toOption -> Option[R] = self match
    Right(b) -> Some(b)
    Left(_) -> None

  // The value of a `Right` as a list of one element, or the empty list for a `Left`.
  toList -> List[R] = self match
    Right(b) -> b :: Nil
    Left(_) -> Nil

  // The value of a `Right` as a vector of one element, or the empty vector for a `Left`.
  toVector -> Vector[R] = self match
    Right(b) -> [b]
    Left(_) -> Vector.empty[R]()

  // Calls `f` with the value of a `Right`; does nothing for a `Left`.
  foreach(f: (R) -> unit) = self match
    Right(b) -> f(b)
    Left(_) -> ()

  // An iterator over the value of a `Right`: one element, or none for a `Left`.
  iterator() -> Iterator[R] = toList.iterator()

// Eithers of ordered values are ordered: every `Left` before every `Right`, and two on the same
// side as their values.
impl[L: Ord, R: Ord] Ord for Either[L, R]
  compare(other: Either[L, R]) -> int = self match
    Left(a) -> other match
      Left(b) -> a.compare(b)
      Right(_) -> -1
    Right(a) -> other match
      Left(_) -> 1
      Right(b) -> a.compare(b)

// An either whose two sides hold the same type has `merge`: the value, from whichever side holds it.
impl[A] Either[A, A]
  merge -> A = self match
    Left(a) -> a
    Right(a) -> a

// An either with an either on its left has `joinLeft`: a `Left` of an either is that either, and a
// `Right` stays a `Right`.
impl[C, R] Either[Either[C, R], R]
  joinLeft -> Either[C, R] = self match
    Left(inner) -> inner
    Right(b) -> Right(b)

// An either with an either on its right has `joinRight`: a `Right` of an either is that either, and a
// `Left` stays a `Left`.
impl[L, C] Either[L, Either[L, C]]
  joinRight -> Either[L, C] = self match
    Left(a) -> Left(a)
    Right(inner) -> inner

object Either
  // `Right(right)` when `test` holds, otherwise `Left(left)`; only the one used is evaluated.
  cond[L, R](test: bool, right: -> R, left: -> L) -> Either[L, R] =
    if test then Right(right) else Left(left)
