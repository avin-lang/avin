module avin.time

// Lengths of calendar. A `Period` is so many months and so many days, kept apart because neither is
// some number of the other: a month is 28 to 31 days. Adding one to a date moves the months first,
// clamping the day to the month it lands in, and then the days, so "the last day of the month" stays
// on a last day. `a.until(b)` is the period from one date to another, the whole months as a person
// counts them and the days left over.

// A length of calendar: `months` months and `days` days, each negative, zero or positive.
data Period(months: int, days: int)

object Period
    // The empty period.
    val Zero: Period = Period(0, 0)

// The periods of `n` months and of `n` years, twelve months each; a count of months beyond an `int`
// traps.
months(n: int) -> Period = Period(n, 0)
years(n: int) -> Period = Period(n * 12, 0)

impl int
    months() -> Period = Period(self, 0)
    years() -> Period = Period(self * 12, 0)

impl Period
    // The months split into whole years and the months left over, each carrying the period's sign:
    // `months(14)` is 1 year and 2 months, `months(-14)` -1 and -2.
    toYearsPart() -> int = months / 12
    toMonthsPart() -> int = months % 12

    isZero() -> bool = months == 0 && days == 0

    // Both parts `n` times over; a part beyond an `int` traps.
    *(n: int) -> Period = Period(months * n, days * n)

    // The period in ISO 8601's form, `P1Y2M3D`: the years, the months left over and the days, each
    // written where it is not zero, and `P0D` for the empty period. A negative part carries its own
    // sign, `P-1Y-2M`, since a period's parts may differ in sign.
    toIsoString() -> string
        if isZero() then return "P0D"
        val wholeYears = toYearsPart()
        val rest = toMonthsPart()
        val y = if wholeYears != 0 then wholeYears.toString() + "Y" else ""
        val m = if rest != 0 then rest.toString() + "M" else ""
        val d = if days != 0 then days.toString() + "D" else ""
        "P" + y + m + d

impl Add for Period
    add(other: Period) -> Period = Period(months + other.months, days + other.days)
    static zero() -> Period = Period(0, 0)

impl Sub for Period
    subtract(other: Period) -> Period = Period(months - other.months, days - other.days)

impl Neg for Period
    negate() -> Period = Period(-months, -days)

// A period reads as its years, the months left over and its days, each where it is not zero:
// `1y 2mo 3d`, `14d`, and the empty period as `0d`.
private periodText(p: Period) -> string
    if p.isZero() then return "0d"
    var text = ""
    if p.toYearsPart() != 0 then text = p.toYearsPart().toString() + "y"
    if p.toMonthsPart() != 0 then text = spaced(text) + p.toMonthsPart().toString() + "mo"
    if p.days != 0 then text = spaced(text) + p.days.toString() + "d"
    text

// `text` with a space after it where it is not empty.
private spaced(text: string) -> string = if text == "" then "" else text + " "

impl Display for Period
    display(out: Writer, spec: FormatSpec) = out.writeField(periodText(self), spec)

impl Debug for Period
    debug(out: Writer, spec: FormatSpec) = out.writeField("Period(" + periodText(self) + ")", spec)

// The date `n` months from `d`, the day clamped to the month it lands in; an answer outside
// `Date.Min` to `Date.Max` traps naming it. The count is a `long`, so no step overflows on the way.
private monthsMoved(d: Date, n: long) -> Date
    if n == 0 then return d
    val total = d.year() * 12 + long(d.month() - 1) + n
    val year = floorDiv(total, 12)
    val month = int(floorMod(total, 12)) + 1
    dateIn(year, month, clampedDay(year, month, d.day()))

// The date `months` months and then `days` days from `d`.
private dateMoved(d: Date, months: long, days: long) -> Date
    val moved = monthsMoved(d, months)
    if days == 0 then moved else dateOfDay(long(moved.epochDay) + days)

impl Date
    // The date a period later, `d + p`, or earlier, `d - p`: the months first, the day clamped to the
    // month it lands in, then the days. An answer outside `Date.Min` to `Date.Max` traps.
    +(p: Period) -> Date = dateMoved(self, long(p.months), long(p.days))
    -(p: Period) -> Date = dateMoved(self, -long(p.months), -long(p.days))

    // The period of days from `earlier` to this date, negative where `earlier` is the later one; a
    // count beyond an `int` traps.
    -(earlier: Date) -> Period = Period(0, epochDay - earlier.epochDay)

    // The calendar steps by name: `+ years(n)`, `+ months(n)`, `+ Period(0, 7 * n)` and
    // `+ Period(0, n)`, a negative `n` stepping back.
    plusYears(n: int) -> Date = dateMoved(self, long(n) * 12, 0)
    plusMonths(n: int) -> Date = dateMoved(self, long(n), 0)
    plusWeeks(n: int) -> Date = dateMoved(self, 0, long(n) * 7)
    plusDays(n: int) -> Date = dateMoved(self, 0, long(n))

    // The whole months from this date to `other`, as a person counts them: from the 31st of January
    // to the 28th of February is no whole month, and to the 1st of March is one. Negative where
    // `other` is earlier, and `b.monthsUntil(a)` is always `-a.monthsUntil(b)`.
    monthsUntil(other: Date) -> int
        val span = (other.year() - year()) * 12 + long(other.month() - month())
        val whole = if span > 0 && other.day() < day() then span - 1 elif span < 0 && other.day() > day() then span + 1 else span
        int(whole)

    // The period from this date to `other`: the whole months of `monthsUntil` and the days left over,
    // both negative where `other` is earlier, so `d + d.until(other) == other` either way round.
    until(other: Date) -> Period
        val whole = monthsUntil(other)
        Period(whole, other.epochDay - monthsMoved(self, long(whole)).epochDay)

impl DateTime
    // The reading a period later or earlier: the date moved as a `Date` is, the time of day kept.
    +(p: Period) -> DateTime = DateTime(date + p, time)
    -(p: Period) -> DateTime = DateTime(date - p, time)

    plusYears(n: int) -> DateTime = DateTime(date.plusYears(n), time)
    plusMonths(n: int) -> DateTime = DateTime(date.plusMonths(n), time)
    plusWeeks(n: int) -> DateTime = DateTime(date.plusWeeks(n), time)
    plusDays(n: int) -> DateTime = DateTime(date.plusDays(n), time)
