module avin.time

// Reading ISO 8601 text back into values. Each `parse…` answers the value its text writes, or a
// `TimeParseError` saying why the text is none: where it stops having the expected shape and what was
// expected there, which field holds a number the calendar or the clock does not have, or where a
// complete value ends with more text after it. The whole text is read for its shape before any field
// is checked against its range. Digits are ASCII only.
//
// Every display of a `Date`, a `Time`, a `DateTime`, an `Instant` and a `Zoned` reads back equal,
// and so does every period's `toIsoString()`.

// Why a text is not the value it was read as. `at` is a byte offset into `text`.
data TimeParseError
    // At `at` the text stops having the shape expected there, which `expected` names.
    BadShape(text: string, at: int, expected: string)
    // The text has the shape, but `field` holds a number out of its range: a month of `13`, the 30th
    // of February, an hour of `24`.
    OutOfRange(text: string, field: string)
    // A whole value ends at `at`, and more text follows it.
    Trailing(text: string, at: int)
    // The zone named in brackets is not one the host's database has.
    UnknownZone(text: string, name: string)

impl TimeParseError
    // A sentence quoting the text and saying what is wrong with it and where.
    message -> string = self match
        BadShape(text, at, expected) -> s"cannot read \"$text\": expected $expected at byte $at"
        OutOfRange(text, field) -> s"cannot read \"$text\": $field is out of range"
        Trailing(text, at) -> s"cannot read \"$text\": expected the end at byte $at"
        UnknownZone(text, name) -> s"cannot read \"$text\": no zone is named '$name'"

impl Display for TimeParseError
    display(out: Writer, spec: FormatSpec) = out.writeField(message, spec)

// The text being read and how far the reading has got.
private class TimeCursor(val text: string)
    var at = 0

    // The byte at the cursor, or -1 at the end of the text.
    code() -> int = if at < text.byteLength then int(text.byteAt(at)) else -1

    isDigit() -> bool = int('0') <= code() <= int('9')

    atEnd() -> bool = at == text.byteLength

    // Steps past `c` where it is next, answering whether it was.
    skip(c: char) -> bool
        if code() != int(c) then return false
        at += 1
        true

    // A shape error at the cursor, naming what was expected there.
    bad(expected: string) -> TimeParseError = BadShape(text, at, expected)

    // Exactly `count` digits, as a number; anything else is a shape error naming `what`.
    digits(count: int, what: string) -> Result[int, TimeParseError]
        var value = 0
        var read = 0
        while read < count
            if !isDigit() then return Err(bad(what))
            value = value * 10 + code() - int('0')
            at += 1
            read += 1
        Ok(value)

// The fields of a reading as written, before any is checked against its range.
private data WrittenDate(year: long, month: int, day: int)
private data WrittenTime(hour: int, minute: int, second: int, micros: int, fractionDigits: int)
private data WrittenReading(date: WrittenDate, time: WrittenTime)
private data WrittenOffset(negative: bool, hours: int, minutes: int)

// A year written with more digits than this is out of range whatever they are.
private val LongestYear: int = 18

// A year: four digits, or a sign and four or more (`+10000`, `-0001`, `+2026`).
private readYear(c: TimeCursor) -> Result[long, TimeParseError]
    val negative = c.code() == int('-')
    val signed = negative || c.code() == int('+')
    if signed then c.at += 1
    val start = c.at
    var value: long = 0
    while c.isDigit()
        if c.at - start < LongestYear then value = value * 10 + long(c.code() - int('0'))
        c.at += 1
    val count = c.at - start
    if count < 4 then return Err(c.bad("a digit of the year"))
    if count > 4 && !signed then return Err(BadShape(c.text, start + 4, "'-'"))
    val magnitude = if count > LongestYear then long.MaxValue else value
    Ok(if negative then -magnitude else magnitude)

// `YYYY-MM-DD`, the year as `readYear` reads it.
private readDate(c: TimeCursor) -> Result[WrittenDate, TimeParseError]
    val year = readYear(c)?
    if !c.skip('-') then return Err(c.bad("'-'"))
    val month = c.digits(2, "two digits of the month")?
    if !c.skip('-') then return Err(c.bad("'-'"))
    val day = c.digits(2, "two digits of the day")?
    Ok(WrittenDate(year, month, day))

// `hh:mm`, `hh:mm:ss` or `hh:mm:ss.f`, the fraction one digit or more; how many there are is kept so
// that a seventh is refused as out of range once the shape has been read.
private readTime(c: TimeCursor) -> Result[WrittenTime, TimeParseError]
    val hour = c.digits(2, "two digits of the hour")?
    if !c.skip(':') then return Err(c.bad("':'"))
    val minute = c.digits(2, "two digits of the minute")?
    if !c.skip(':') then return Ok(WrittenTime(hour, minute, 0, 0, 0))
    val second = c.digits(2, "two digits of the second")?
    if !c.skip('.') then return Ok(WrittenTime(hour, minute, second, 0, 0))
    var micros = 0
    var count = 0
    while c.isDigit()
        if count < 6 then micros = micros * 10 + c.code() - int('0')
        count += 1
        c.at += 1
    if count == 0 then return Err(c.bad("a digit of the fraction"))
    var scale = count
    while scale < 6
        micros *= 10
        scale += 1
    Ok(WrittenTime(hour, minute, second, micros, count))

// A date and a time joined by `T` or one space.
private readReading(c: TimeCursor) -> Result[WrittenReading, TimeParseError]
    val date = readDate(c)?
    if !c.skip('T') && !c.skip(' ') then return Err(c.bad("'T' or a space"))
    val time = readTime(c)?
    Ok(WrittenReading(date, time))

// An offset from UTC: `Z`, `+hh:mm`, `-hh:mm`, `+hhmm` or `-hhmm`.
private readOffset(c: TimeCursor) -> Result[WrittenOffset, TimeParseError]
    if c.skip('Z') then return Ok(WrittenOffset(false, 0, 0))
    val negative = c.code() == int('-')
    if !negative && c.code() != int('+') then return Err(c.bad("an offset like Z, +05:30 or -0800"))
    c.at += 1
    val hours = c.digits(2, "two digits of the offset's hours")?
    val colon = c.skip(':')
    val minutes = c.digits(2, if colon then "two digits of the offset's minutes" else "':' or two digits of the offset's minutes")?
    Ok(WrittenOffset(negative, hours, minutes))

// The date the fields name, or the first of them out of its range.
private checkedDate(text: string, d: WrittenDate) -> Result[Date, TimeParseError]
    if !(MinYear <= d.year <= MaxYear) then return Err(OutOfRange(text, "year"))
    if !(1 <= d.month <= 12) then return Err(OutOfRange(text, "month"))
    if !(1 <= d.day <= monthLength(d.year, d.month)) then return Err(OutOfRange(text, "day"))
    val count = epochDayOf(d.year, d.month, d.day)
    if !(long(int.MinValue) <= count <= long(int.MaxValue)) then return Err(OutOfRange(text, "date"))
    Ok(Date(int(count)))

// The time of day the fields name, or the first of them out of its range: there is no hour `24`, no
// second `60`, and no seventh digit of fraction.
private checkedTime(text: string, t: WrittenTime) -> Result[Time, TimeParseError]
    if t.hour > 23 then return Err(OutOfRange(text, "hour"))
    if t.minute > 59 then return Err(OutOfRange(text, "minute"))
    if t.second > 59 then return Err(OutOfRange(text, "second"))
    if t.fractionDigits > 6 then return Err(OutOfRange(text, "fraction"))
    Ok(time(t.hour, t.minute, t.second, t.micros))

private checkedReading(text: string, r: WrittenReading) -> Result[DateTime, TimeParseError]
    val date = checkedDate(text, r.date)?
    val time = checkedTime(text, r.time)?
    Ok(DateTime(date, time))

// The offset the fields name, within ±23:59.
private checkedOffset(text: string, o: WrittenOffset) -> Result[Duration, TimeParseError]
    if o.hours > 23 || o.minutes > 59 then return Err(OutOfRange(text, "offset"))
    val size = hours(long(o.hours)) + minutes(long(o.minutes))
    Ok(if o.negative then -size else size)

// The days of the least and the greatest instant, counted from 1970-01-01.
private val FirstInstantDay: long = floorDiv(long.MinValue, MicrosPerDay)
private val LastInstantDay: long = floorDiv(long.MaxValue, MicrosPerDay)

// The instant `dt` names where the clocks are `offset` from UTC, or `None` where it is outside
// `Instant.Min` to `Instant.Max`. The day and the microseconds within it are kept apart until the last
// step, where a day before the epoch is counted from the day after it, so no step overflows.
private instantAt(dt: DateTime, offset: Duration) -> Option[Instant]
    val r = dt.time.microsOfDay - offset.micros
    val day = long(dt.date.epochDay) + floorDiv(r, MicrosPerDay)
    val rest = floorMod(r, MicrosPerDay)
    if !(FirstInstantDay <= day <= LastInstantDay) then return None
    if day < 0
        val base = (day + 1) * MicrosPerDay
        val back = rest - MicrosPerDay
        if back < long.MinValue - base then None else Some(Instant(base + back))
    else
        val base = day * MicrosPerDay
        if rest > long.MaxValue - base then None else Some(Instant(base + rest))

// The date `YYYY-MM-DD`, with a sign and more digits for a year outside `0` to `9999`.
parseDate(text: string) -> Result[Date, TimeParseError]
    val c = TimeCursor(text)
    val written = readDate(c)?
    if !c.atEnd() then return Err(Trailing(text, c.at))
    checkedDate(text, written)

// The time of day `hh:mm`, `hh:mm:ss` or `hh:mm:ss.f` with one to six digits of fraction.
parseTime(text: string) -> Result[Time, TimeParseError]
    val c = TimeCursor(text)
    val written = readTime(c)?
    if !c.atEnd() then return Err(Trailing(text, c.at))
    checkedTime(text, written)

// A wall reading: a date and a time joined by `T` or one space.
parseDateTime(text: string) -> Result[DateTime, TimeParseError]
    val c = TimeCursor(text)
    val written = readReading(c)?
    if !c.atEnd() then return Err(Trailing(text, c.at))
    checkedReading(text, written)

// The instant a wall reading and its offset name: `Z`, `±hh:mm` or `±hhmm`. A reading with no offset
// is refused, since defaulting one would invent it.
parseTimestamp(text: string) -> Result[Instant, TimeParseError]
    val c = TimeCursor(text)
    val reading = readReading(c)?
    val offset = readOffset(c)?
    if !c.atEnd() then return Err(Trailing(text, c.at))
    val dt = checkedReading(text, reading)?
    val shift = checkedOffset(text, offset)?
    instantAt(dt, shift) match
        Some(t) -> Ok(t)
        None -> Err(OutOfRange(text, "instant"))

// A reading in a zone: a timestamp and, optionally, a zone's name in brackets. Without a name the
// zone is the offset's fixed zone, `utc` for `Z`; with one, the offset must be the one the zone's
// clocks show at that instant, so the text cannot name a reading the zone never shows.
parseZoned(text: string) -> Result[Zoned, TimeParseError]
    val c = TimeCursor(text)
    val reading = readReading(c)?
    val offset = readOffset(c)?
    var name = ""
    if c.skip('[')
        val close = text.indexOf("]", c.at)
        if close < 0 then return Err(BadShape(text, text.byteLength, "']'"))
        if close == c.at then return Err(c.bad("a zone's name"))
        name = text.slice(c.at, close)
        c.at = close + 1
    if !c.atEnd() then return Err(Trailing(text, c.at))
    val dt = checkedReading(text, reading)?
    val shift = checkedOffset(text, offset)?
    val instant = instantAt(dt, shift) match
        Some(t) -> t
        None -> return Err(OutOfRange(text, "instant"))
    if name == "" then return Ok(Zoned(dt, shift, fixedZone(shift)))
    val z = zone(name) match
        Ok(found) -> found
        Err(_) -> return Err(UnknownZone(text, name))
    if z.offsetAt(instant) != shift then return Err(OutOfRange(text, "offset"))
    Ok(Zoned(dt, shift, z))

// What a period's designator may be once `next` of `Y`, `M` and `D` have been passed.
private designatorsFrom(next: int) -> string = if next == 0 then "'Y', 'M' or 'D'" elif next == 1 then "'M' or 'D'" else "'D'"

// A number past every `int` once multiplied by twelve and added to any other part, standing for a
// part written with more digits than any period has.
private val TooLongPart: long = 1000000000000

// A period as `toIsoString()` writes it: `P`, then a number of years, of months and of days, each
// followed by its letter `Y`, `M` or `D`, in that order, at least one of them, and each with its own
// `-` where it is negative: `P1Y2M3D`, `P0D`, `P-1Y-2M`, `P1M-3D`. Years are twelve months each, and
// a part beyond an `int` is out of range.
parsePeriod(text: string) -> Result[Period, TimeParseError]
    val c = TimeCursor(text)
    if !c.skip('P') then return Err(c.bad("'P'"))
    var months: long = 0
    var days: long = 0
    var next = 0
    while next < 3 && (c.isDigit() || c.code() == int('-'))
        val negative = c.skip('-')
        val start = c.at
        var value: long = 0
        while c.isDigit()
            if c.at - start < 11 then value = value * 10 + long(c.code() - int('0'))
            c.at += 1
        if c.at == start then return Err(c.bad("a digit"))
        val magnitude = if c.at - start > 10 then TooLongPart else value
        val part = if negative then -magnitude else magnitude
        val letter = c.code()
        if letter == int('Y') && next == 0 then months += part * 12
        elif letter == int('M') && next <= 1 then months += part
        elif letter == int('D') then days = part
        else return Err(c.bad(designatorsFrom(next)))
        next = if letter == int('Y') then 1 elif letter == int('M') then 2 else 3
        c.at += 1
    if next == 0 then return Err(c.bad("a number"))
    if !c.atEnd() then return Err(Trailing(text, c.at))
    if !(long(int.MinValue) <= months <= long(int.MaxValue)) then return Err(OutOfRange(text, "months"))
    if !(long(int.MinValue) <= days <= long(int.MaxValue)) then return Err(OutOfRange(text, "days"))
    Ok(Period(int(months), int(days)))
