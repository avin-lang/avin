module avin.time

// The calendar and the zones. A `Date` is a day of the proleptic Gregorian calendar, a `Time` a time
// of day, and a `DateTime` the two together: a wall reading, with no zone. A `Zone` says how far its
// clocks are set from UTC at any instant, and an instant read in a zone, `t.atZone(z)`, is a `Zoned`:
// the wall reading its clocks show then, the offset in force and the zone. `format(pattern)` writes
// a reading the way a person wants to read it.
//
// A zone is UTC, a fixed offset, or a zone of the host's tz database, whose file it keeps as an
// immutable vector of bytes and asks Sysl's decoder about one instant at a time.

@sysl("avin.rt.zone_file_bytes")
private zoneFileBytes(file: string) -> Option[Vector[byte]]

@sysl("avin.rt.zone_link_target")
private zoneLinkTarget(file: string) -> Option[string]

@sysl("avin.rt.zone_table_valid")
private zoneTableValid(table: Vector[byte]) -> bool

@sysl("avin.rt.zone_offset_minutes")
private zoneOffsetMinutes(table: Vector[byte], micros: long) -> int

@sysl("avin.rt.zone_is_dst")
private zoneIsDst(table: Vector[byte], micros: long) -> bool

@sysl("avin.rt.zone_abbreviation")
private zoneAbbreviation(table: Vector[byte], micros: long) -> string

@sysl("sysl.posix.time.zoneinfo_root")
private zoneinfoRoot() -> string

@sysl("sysl.env.get")
private environmentVariable(name: string) -> Option[string]

// `n` divided by `d` and its remainder, rounded toward negative infinity.
private floorMod(n: long, d: long) -> long = if n % d < 0 then n % d + d else n % d

// The year, month and day of a day counted from 1970-01-01, by the calendar's 400-year cycles.
private civilOf(epochDay: long) -> (long, int, int)
    val z = epochDay + 719468
    val era = floorDiv(z, 146097)
    val dayOfEra = z - era * 146097
    val yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
    val dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
    val mp = (5 * dayOfYear + 2) / 153
    val day = dayOfYear - (153 * mp + 2) / 5 + 1
    val month = if mp < 10 then mp + 3 else mp - 9
    (yearOfEra + era * 400 + (if month <= 2 then 1 else 0), int(month), int(day))

// The day counted from 1970-01-01 of a year, month and day, the inverse of `civilOf`.
private epochDayOf(year: long, month: int, day: int) -> long
    val y = if month <= 2 then year - 1 else year
    val era = floorDiv(y, 400)
    val yearOfEra = y - era * 400
    val m = long(month)
    val dayOfYear = (153 * (if m > 2 then m - 3 else m + 9) + 2) / 5 + long(day) - 1
    val dayOfEra = yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear
    era * 146097 + dayOfEra - 719468

// Whether `year` has a 29th of February.
private leapYear(year: long) -> bool = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
isLeapYear(year: long) -> bool = leapYear(year)

// How many days the month has; a month outside 1 to 12 traps.
daysInMonth(year: long, month: int) -> int = monthLength(year, month)

private monthLength(year: long, month: int) -> int
    if !(1 <= month <= 12) then fail(s"there is no month $month: a month is 1 to 12")
    if month == 2 then (if leapYear(year) then 29 else 28)
    elif month == 4 || month == 6 || month == 9 || month == 11 then 30
    else 31

private val MonthNames: Vector[string] = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]

// A day of the week, Monday first, as ISO 8601 orders them.
data Weekday derives Ord
    Monday
    Tuesday
    Wednesday
    Thursday
    Friday
    Saturday
    Sunday

private val Weekdays: Vector[Weekday] = [Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday]

private val WeekdayNames: Vector[string] = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]

impl Weekday
    // `1` for Monday to `7` for Sunday.
    isoNumber() -> int = self match
        Monday -> 1
        Tuesday -> 2
        Wednesday -> 3
        Thursday -> 4
        Friday -> 5
        Saturday -> 6
        Sunday -> 7

    // The day `n` days on, or back where `n` is negative.
    plus(n: int) -> Weekday = Weekdays(int(floorMod(long(isoNumber()) - 1 + long(n), 7)))

impl Display for Weekday
    display(out: Writer, spec: FormatSpec) = out.writeField(WeekdayNames(isoNumber() - 1), spec)

impl Debug for Weekday
    debug(out: Writer, spec: FormatSpec) = display(out, spec)

// A day of the calendar, with no time of day and no zone: days since 1970-01-01.
data Date(epochDay: int) derives Ord

object Date
    // The least and greatest dates.
    val Min: Date = Date(int.MinValue)
    val Max: Date = Date(int.MaxValue)

// A time of day, with no date and no zone: microseconds since midnight, `0` to `86_399_999_999`.
data Time(microsOfDay: long) derives Ord

object Time
    val Midnight: Time = Time(0)
    val Noon: Time = Time(43200000000)

// A wall reading: a date and a time of day, with no zone.
data DateTime(date: Date, time: Time) derives Ord

// A wall reading: a date and a time of day, with no zone.
object DateTime
    // The least and greatest readings: the first microsecond of `Date.Min` and the last of `Date.Max`.
    val Min: DateTime = DateTime(Date.Min, Time.Midnight)
    val Max: DateTime = DateTime(Date.Max, Time(MicrosPerDay - 1))

// The date `year`-`month`-`day`; numbers that name no date trap.
date(year: int, month: int, day: int) -> Date = dateIn(long(year), month, day)

// The date `year`-`month`-`day`, trapping where the numbers name no date or one outside `Date.Min`
// to `Date.Max`.
private dateIn(year: long, month: int, day: int) -> Date
    val text = s"${yearText(year)}-${padded(long(month), 2)}-${padded(long(day), 2)}"
    if !(1 <= month <= 12) || !(1 <= day <= monthLength(year, month)) then fail(s"there is no such date: $text")
    if !(MinYear <= year <= MaxYear) then fail(s"the date $text is outside Date.Min to Date.Max")
    val count = epochDayOf(year, month, day)
    if !(long(int.MinValue) <= count <= long(int.MaxValue)) then fail(s"the date $text is outside Date.Min to Date.Max")
    Date(int(count))

// The years of `Date.Min` and `Date.Max`.
private val MinYear: long = civilOf(long(int.MinValue)).0
private val MaxYear: long = civilOf(long(int.MaxValue)).0

// The date `day` days from 1970-01-01, trapping outside `Date.Min` to `Date.Max`.
private dateOfDay(day: long) -> Date
    if !(long(int.MinValue) <= day <= long(int.MaxValue)) then fail(s"the date $day days from 1970-01-01 is outside Date.Min to Date.Max")
    Date(int(day))

// The Thursday of the ISO 8601 week holding `day`, a day counted from 1970-01-01 (a Thursday): the
// week's year and number are that Thursday's.
private isoThursday(day: long) -> long = day - floorMod(day + 3, 7) + 3

// `day` where the month has it, else the month's last day.
private clampedDay(year: long, month: int, day: int) -> int
    val length = monthLength(year, month)
    if day < length then day else length

// The reading `days` days and `micros` microseconds (less than a day) after `dt`.
private movedReading(dt: DateTime, days: long, micros: long) -> DateTime
    val inDay = dt.time.microsOfDay + micros
    val carry: long = if inDay >= MicrosPerDay then 1 else 0
    DateTime(dateOfDay(long(dt.date.epochDay) + days + carry), Time(inDay - carry * MicrosPerDay))

// `value` where it is within `lo` to `hi`, and a trap naming the field and its range where it is not.
private checked(field: string, value: long, lo: long, hi: long) -> long
    if !(lo <= value <= hi) then fail(s"$field $value is outside $lo to $hi")
    value

// The time of day `hour`:`minute`:`second` and `micros` microseconds; a field outside its range traps.
time(hour: int, minute: int) -> Time = time(hour, minute, 0, 0)
time(hour: int, minute: int, second: int) -> Time = time(hour, minute, second, 0)
time(hour: int, minute: int, second: int, micros: int) -> Time
    val h = checked("hour", long(hour), 0, 23)
    val m = checked("minute", long(minute), 0, 59)
    val s = checked("second", long(second), 0, 59)
    val us = checked("microsecond", long(micros), 0, 999999)
    Time(h * MicrosPerHour + m * MicrosPerMinute + s * MicrosPerSecond + us)

// The time of day `micros` microseconds after midnight; a count outside a day traps.
timeOfMicros(micros: long) -> Time = Time(checked("microsecond of the day", micros, 0, MicrosPerDay - 1))

// The wall reading of a date and a time of day.
dateTime(year: int, month: int, day: int, hour: int, minute: int) -> DateTime = DateTime(date(year, month, day), time(hour, minute))
dateTime(year: int, month: int, day: int, hour: int, minute: int, second: int) -> DateTime = DateTime(date(year, month, day), time(hour, minute, second))
dateTime(year: int, month: int, day: int, hour: int, minute: int, second: int, micros: int) -> DateTime = DateTime(date(year, month, day), time(hour, minute, second, micros))
dateTime(date: Date, time: Time) -> DateTime = DateTime(date, time)

impl Date
    year() -> long = civilOf(long(epochDay)).0
    month() -> int = civilOf(long(epochDay)).1
    day() -> int = civilOf(long(epochDay)).2
    weekday() -> Weekday = Weekdays(int(floorMod(long(epochDay) + 3, 7)))
    dayOfYear() -> int = int(long(epochDay) - epochDayOf(year(), 1, 1)) + 1
    daysInMonth() -> int = monthLength(year(), month())
    daysInYear() -> int = if isLeapYear() then 366 else 365
    isLeapYear() -> bool = leapYear(year())
    monthName() -> string = MonthNames(month() - 1)
    atTime(t: Time) -> DateTime = DateTime(self, t)

    // The ISO 8601 week, `1` to `53`, and the year it belongs to: weeks start on Monday, and week 1
    // is the one holding its year's first Thursday, so 2027-01-01 is in week 53 of 2026.
    isoWeek() -> int
        val thursday = isoThursday(long(epochDay))
        int((thursday - epochDayOf(civilOf(thursday).0, 1, 1)) / 7) + 1
    isoWeekYear() -> long = civilOf(isoThursday(long(epochDay))).0

    // The date with one field replaced. `withYear` and `withMonth` clamp the day to the new month's
    // length, so 2024-02-29 `withYear(2025)` is 2025-02-28; a month outside 1 to 12, a day the month
    // does not have, and a date outside `Date.Min` to `Date.Max` trap.
    withYear(year: long) -> Date = dateIn(year, month(), clampedDay(year, month(), day()))
    withMonth(month: int) -> Date = dateIn(year(), month, clampedDay(year(), month, day()))
    withDay(day: int) -> Date = dateIn(year(), month(), day)

    // The first day of the date's year, month and week (the Monday), and the last day of its month.
    startOfYear() -> Date = dateIn(year(), 1, 1)
    startOfMonth() -> Date = dateIn(year(), month(), 1)
    startOfWeek() -> Date = dateOfDay(long(epochDay) - floorMod(long(epochDay) + 3, 7))
    endOfMonth() -> Date = dateIn(year(), month(), daysInMonth())

    // The first date on or after this one falling on `w`, and the last on or before it; a date on `w`
    // is its own answer.
    onOrAfter(w: Weekday) -> Date = dateOfDay(long(epochDay) + floorMod(long(w.isoNumber()) - long(weekday().isoNumber()), 7))
    onOrBefore(w: Weekday) -> Date = dateOfDay(long(epochDay) - floorMod(long(weekday().isoNumber()) - long(w.isoNumber()), 7))

    // The whole days from this date to `other`, negative where `other` is earlier; a count beyond an
    // `int` traps.
    daysUntil(other: Date) -> int = other.epochDay - epochDay

    // The date written by `pattern`; an element of a time of day or a zone traps.
    format(pattern: string) -> string = formatReading(pattern, Some(self), None, None)

impl Time
    hour() -> int = int(microsOfDay / MicrosPerHour)
    minute() -> int = int(microsOfDay % MicrosPerHour / MicrosPerMinute)
    second() -> int = int(microsOfDay % MicrosPerMinute / MicrosPerSecond)
    microsecond() -> int = int(microsOfDay % MicrosPerSecond)
    atDate(d: Date) -> DateTime = DateTime(d, self)

    // The time of day with one field replaced; a value outside the field's range traps.
    withHour(hour: int) -> Time = time(hour, minute(), second(), microsecond())
    withMinute(minute: int) -> Time = time(hour(), minute, second(), microsecond())
    withSecond(second: int) -> Time = time(hour(), minute(), second, microsecond())
    withMicrosecond(micros: int) -> Time = time(hour(), minute(), second(), micros)

    // The time of day written by `pattern`; an element of a date or a zone traps.
    format(pattern: string) -> string = formatReading(pattern, None, Some(self), None)

impl DateTime
    year() -> long = date.year()
    month() -> int = date.month()
    day() -> int = date.day()
    weekday() -> Weekday = date.weekday()
    dayOfYear() -> int = date.dayOfYear()
    daysInMonth() -> int = date.daysInMonth()
    daysInYear() -> int = date.daysInYear()
    isLeapYear() -> bool = date.isLeapYear()
    monthName() -> string = date.monthName()
    hour() -> int = time.hour()
    minute() -> int = time.minute()
    second() -> int = time.second()
    microsecond() -> int = time.microsecond()
    isoWeek() -> int = date.isoWeek()
    isoWeekYear() -> long = date.isoWeekYear()

    // The reading with one field replaced, as `Date` and `Time` replace them.
    withYear(year: long) -> DateTime = DateTime(date.withYear(year), time)
    withMonth(month: int) -> DateTime = DateTime(date.withMonth(month), time)
    withDay(day: int) -> DateTime = DateTime(date.withDay(day), time)
    withHour(hour: int) -> DateTime = DateTime(date, time.withHour(hour))
    withMinute(minute: int) -> DateTime = DateTime(date, time.withMinute(minute))
    withSecond(second: int) -> DateTime = DateTime(date, time.withSecond(second))
    withMicrosecond(micros: int) -> DateTime = DateTime(date, time.withMicrosecond(micros))

    // The start of the reading's year, month and week (the Monday), at midnight; the last day of its
    // month at the same time of day.
    startOfYear() -> DateTime = DateTime(date.startOfYear(), Time.Midnight)
    startOfMonth() -> DateTime = DateTime(date.startOfMonth(), Time.Midnight)
    startOfWeek() -> DateTime = DateTime(date.startOfWeek(), Time.Midnight)
    endOfMonth() -> DateTime = DateTime(date.endOfMonth(), time)

    // The reading with its time of day truncated to the day, hour, minute or second.
    startOfDay() -> DateTime = DateTime(date, Time.Midnight)
    startOfHour() -> DateTime = DateTime(date, Time(time.microsOfDay - time.microsOfDay % MicrosPerHour))
    startOfMinute() -> DateTime = DateTime(date, Time(time.microsOfDay - time.microsOfDay % MicrosPerMinute))
    startOfSecond() -> DateTime = DateTime(date, Time(time.microsOfDay - time.microsOfDay % MicrosPerSecond))

    // The reading `d` later along its own wall clock, `dt + d`, or earlier, `dt - d`, with no zone to
    // skip or repeat an hour; an answer outside `DateTime.Min` to `DateTime.Max` traps. The duration
    // is split into whole days and the rest before it is added, so no step overflows on the way.
    +(d: Duration) -> DateTime = movedReading(self, floorDiv(d.micros, MicrosPerDay), floorMod(d.micros, MicrosPerDay))
    -(d: Duration) -> DateTime
        val days = floorDiv(d.micros, MicrosPerDay)
        val rest = floorMod(d.micros, MicrosPerDay)
        if rest == 0 then movedReading(self, -days, 0) else movedReading(self, -days - 1, MicrosPerDay - rest)

    // The duration from `earlier` to this reading along the wall clock, negative where `earlier` is
    // the later one; one beyond a `Duration` traps.
    -(earlier: DateTime) -> Duration
        val days = long(date.epochDay) - long(earlier.date.epochDay)
        val rest = time.microsOfDay - earlier.time.microsOfDay
        if days > 0 && rest < 0 then Duration((days - 1) * MicrosPerDay + (rest + MicrosPerDay))
        elif days < 0 && rest > 0 then Duration((days + 1) * MicrosPerDay + (rest - MicrosPerDay))
        else Duration(days * MicrosPerDay + rest)

    // The reading written by `pattern`; an element of a zone traps.
    format(pattern: string) -> string = formatReading(pattern, Some(date), Some(time), None)

private dateText(d: Date) -> string = yearText(d.year()) + "-" + padded(long(d.month()), 2) + "-" + padded(long(d.day()), 2)

private timeText(t: Time) -> string
    val fraction = trimmed(padded(long(t.microsecond()), 6))
    val clock = padded(long(t.hour()), 2) + ":" + padded(long(t.minute()), 2) + ":" + padded(long(t.second()), 2)
    if fraction == "" then clock else clock + "." + fraction

impl Display for Date
    display(out: Writer, spec: FormatSpec) = out.writeField(dateText(self), spec)

impl Debug for Date
    debug(out: Writer, spec: FormatSpec) = display(out, spec)

impl Display for Time
    display(out: Writer, spec: FormatSpec) = out.writeField(timeText(self), spec)

impl Debug for Time
    debug(out: Writer, spec: FormatSpec) = display(out, spec)

impl Display for DateTime
    display(out: Writer, spec: FormatSpec) = out.writeField(dateText(date) + "T" + timeText(time), spec)

impl Debug for DateTime
    debug(out: Writer, spec: FormatSpec) = display(out, spec)

// What a zone's clocks follow: one offset always, or the transitions of a tz database file.
private data ZoneRules
    FixedRules(offset: Duration)
    TableRules(table: Vector[byte])

// A zone: a name, and the offset its clocks show at any instant. Two zones are equal when their names
// are.
class Zone(private val zoneName: string, private val rules: ZoneRules)

impl Zone
    // `"America/Toronto"`, `"UTC"`, `"+05:30"`.
    name() -> string = zoneName

    // How far the zone's clocks are from UTC at `t`.
    offsetAt(t: Instant) -> Duration = rules match
        FixedRules(offset) -> offset
        TableRules(table) -> minutes(long(zoneOffsetMinutes(table, t.epochMicros)))

    // Whether `t` falls in daylight saving time there; a fixed zone never does.
    isDaylightSavingAt(t: Instant) -> bool = rules match
        FixedRules(_) -> false
        TableRules(table) -> zoneIsDst(table, t.epochMicros)

    // The clocks' abbreviation at `t`, `"EDT"`; a fixed zone's is its name.
    abbreviationAt(t: Instant) -> string = rules match
        FixedRules(_) -> zoneName
        TableRules(table) -> zoneAbbreviation(table, t.epochMicros)

    // Whether its offset never changes.
    isFixed() -> bool = rules match
        FixedRules(_) -> true
        TableRules(_) -> false

impl Eq for Zone
    equals(other: Zone) -> bool = zoneName == other.name()

impl Hash for Zone
    hash() -> long = zoneName.hash()

impl Display for Zone
    display(out: Writer, spec: FormatSpec) = out.writeField(zoneName, spec)

impl Debug for Zone
    debug(out: Writer, spec: FormatSpec) = out.writeField("Zone(" + zoneName + ")", spec)

// UTC, the one zone that cannot fail to be found.
val utc: Zone = Zone("UTC", FixedRules(Duration.Zero))

// An offset written `+hh:mm` or `-hh:mm`, or `zz`'s `+hhmm`.
private offsetText(offset: Duration, colon: bool) -> string
    val total = offset.micros / MicrosPerMinute
    val sign = if total < 0 then "-" else "+"
    val m = if total < 0 then -total else total
    sign + padded(m / 60, 2) + (if colon then ":" else "") + padded(m % 60, 2)

// A zone whose clocks are always `offset` from UTC; the offset is whole minutes within ±23:59, and
// anything else traps. The zero offset is `utc`.
fixedZone(offset: Duration) -> Zone
    if offset.micros % MicrosPerMinute != 0 then fail(s"a zone's offset is whole minutes, and $offset is not")
    if !(-(hours(24).micros) < offset.micros < hours(24).micros) then fail(s"a zone's offset is within ±23:59, and $offset is not")
    if offset.isZero() then utc else Zone(offsetText(offset, true), FixedRules(offset))

// Why `zone` found no zone.
data ZoneError
    // The tz database has no zone of that name.
    UnknownZone(name: string)
    // The text cannot be a zone's name: it is empty, starts with `/`, holds a `..` segment, or a
    // character outside ASCII letters, digits and `/ _ + -`.
    NotAZoneName(name: string)
    // The database's file for the zone cannot be decoded.
    Malformed(name: string)

impl ZoneError
    // A sentence naming the zone.
    message() -> string = self match
        UnknownZone(name) -> s"no zone is named '$name'"
        NotAZoneName(name) -> s"'$name' cannot be a zone's name"
        Malformed(name) -> s"the zone file for '$name' cannot be decoded"

impl Display for ZoneError
    display(out: Writer, spec: FormatSpec) = out.writeField(message(), spec)

// Whether `c` may stand in a zone's name.
private isNameChar(c: char) -> bool = 'a' <= c <= 'z' || 'A' <= c <= 'Z' || '0' <= c <= '9' || c == '/' || c == '_' || c == '+' || c == '-'

// Whether `name` can be a zone's name; it is decided before anything is read.
private isZoneName(name: string) -> bool
    if name.isEmpty() || name.startsWith("/") then return false
    if name.split("/").contains("..") then return false
    name.chars().forall(isNameChar)

// The value of two ASCII digits at `at` in `text`, or -1 where they are not digits.
private twoDigits(text: string, at: int) -> int
    if at + 2 > text.byteLength() then return -1
    val a = text.charAt(at)
    val b = text.charAt(at + 1)
    if '0' <= a <= '9' && '0' <= b <= '9' then (int(a) - int('0')) * 10 + int(b) - int('0') else -1

// The offset a fixed zone's name writes, `Z`, `+05:30` or `+0530`, or `None` where it writes none.
private offsetOfName(name: string) -> Option[Duration]
    if name == "Z" then return Some(Duration.Zero)
    val n = name.byteLength()
    if !(n == 5 || n == 6) || !(name.startsWith("+") || name.startsWith("-")) then return None
    if n == 6 && name.charAt(3) != ':' then return None
    val h = twoDigits(name, 1)
    val m = twoDigits(name, n - 2)
    if !(0 <= h <= 23) || !(0 <= m <= 59) then return None
    val size = hours(long(h)) + minutes(long(m))
    Some(if name.startsWith("-") then -size else size)

// The zone of a tz database file's bytes, under `name`.
private zoneOfTable(name: string, table: Vector[byte]) -> Result[Zone, ZoneError] =
    if zoneTableValid(table) then Ok(Zone(name, TableRules(table))) else Err(Malformed(name))

// A zone by its name in the host's tz database (`TZDIR`, otherwise `/usr/share/zoneinfo`), `"UTC"`,
// or a fixed offset `"+05:30"`, `"-08:00"`, `"+0530"`, `"Z"`.
zone(name: string) -> Result[Zone, ZoneError]
    if name == "UTC" then return Ok(utc)
    offsetOfName(name) match
        Some(offset) -> return Ok(fixedZone(offset))
        None -> ()
    if !isZoneName(name) then return Err(NotAZoneName(name))
    zoneFileBytes(zoneinfoRoot() + "/" + name) match
        Some(table) -> zoneOfTable(name, table)
        None -> Err(UnknownZone(name))

// The zone a path into a tz database names: what follows its `zoneinfo/`, or the path itself.
private nameOfPath(file: string) -> string
    val at = file.lastIndexOf("zoneinfo/")
    if at < 0 then file else file.drop(at + "zoneinfo/".byteLength())

// The zone of the file at `file`, named `name`, or `utc` where it cannot be read as one.
private zoneOfFile(name: string, file: string) -> Zone = zoneFileBytes(file) match
    Some(table) -> zoneOfTable(name, table).getOrElse(utc)
    None -> utc

// The host's own zone: the one `TZ` names, otherwise the one `/etc/localtime` is. It always answers:
// where the host names no zone it can read, `utc`.
localZone() -> Zone = environmentVariable("TZ") match
    Some(setting) ->
        val name = setting.stripPrefix(":")
        if name.startsWith("/") then zoneOfFile(nameOfPath(name), name)
        else zone(name).getOrElse(utc)
    None ->
        val name = zoneLinkTarget("/etc/localtime") match
            Some(target) -> nameOfPath(target)
            None -> "localtime"
        if name == "UTC" then utc else zoneOfFile(name, "/etc/localtime")

// A wall reading in a zone: the reading its clocks show, the offset in force, and the zone. Two are
// equal only with the same instant in the same zone.
data Zoned(dateTime: DateTime, offset: Duration, zone: Zone)

// The reading of the instant `micros` in a zone whose offset there is `offset`. The day and the time
// within it are split before the offset is added, so no instant's reading overflows.
private readingOf(micros: long, offset: Duration) -> DateTime
    val days = floorDiv(micros, MicrosPerDay)
    val inDay = floorMod(micros, MicrosPerDay) + offset.micros
    DateTime(Date(int(days + floorDiv(inDay, MicrosPerDay))), Time(floorMod(inDay, MicrosPerDay)))

impl Instant
    // The reading of this instant in `z`; always one.
    atZone(z: Zone) -> Zoned
        val offset = z.offsetAt(self)
        Zoned(readingOf(epochMicros, offset), offset, z)

impl Zoned
    // The instant the reading names.
    // A day before the epoch is counted from the day after it, so the least instant's reading comes
    // back without its day's microseconds overflowing on the way.
    toInstant() -> Instant
        val r = dateTime.time.microsOfDay - offset.micros
        val day = long(dateTime.date.epochDay) + floorDiv(r, MicrosPerDay)
        val rest = floorMod(r, MicrosPerDay)
        if day < 0 then Instant((day + 1) * MicrosPerDay + (rest - MicrosPerDay)) else Instant(day * MicrosPerDay + rest)

    // The same instant read in `z`.
    atZone(z: Zone) -> Zoned = toInstant().atZone(z)

    isDaylightSaving() -> bool = zone.isDaylightSavingAt(toInstant())
    abbreviation() -> string = zone.abbreviationAt(toInstant())

    date() -> Date = dateTime.date
    time() -> Time = dateTime.time
    year() -> long = dateTime.year()
    month() -> int = dateTime.month()
    day() -> int = dateTime.day()
    weekday() -> Weekday = dateTime.weekday()
    dayOfYear() -> int = dateTime.dayOfYear()
    daysInMonth() -> int = dateTime.daysInMonth()
    daysInYear() -> int = dateTime.daysInYear()
    isLeapYear() -> bool = dateTime.isLeapYear()
    monthName() -> string = dateTime.monthName()
    hour() -> int = dateTime.hour()
    minute() -> int = dateTime.minute()
    second() -> int = dateTime.second()
    microsecond() -> int = dateTime.microsecond()
    isoWeek() -> int = dateTime.isoWeek()
    isoWeekYear() -> long = dateTime.isoWeekYear()
    epochSeconds() -> long = toInstant().epochSeconds()
    epochMillis() -> long = toInstant().epochMillis()
    epochMicros() -> long = toInstant().epochMicros

    // Whether this names an earlier, a later or the same instant as `other`, whatever the zones.
    isBefore(other: Zoned) -> bool = toInstant() < other.toInstant()
    isAfter(other: Zoned) -> bool = toInstant() > other.toInstant()
    isSameInstant(other: Zoned) -> bool = toInstant() == other.toInstant()

    // The reading written by `pattern`.
    format(pattern: string) -> string = formatReading(pattern, Some(dateTime.date), Some(dateTime.time), Some(self))

impl Display for Zoned
    display(out: Writer, spec: FormatSpec)
        val reading = dateText(dateTime.date) + "T" + timeText(dateTime.time)
        val where = if zone == utc then "Z" elif zone.isFixed() then offsetText(offset, true) else offsetText(offset, true) + "[" + zone.name() + "]"
        out.writeField(reading + where, spec)

impl Debug for Zoned
    debug(out: Writer, spec: FormatSpec) = display(out, spec)

// What a pattern's element writes, given the parts of the reading there are. `None` for a part says
// the value being formatted has no such part, which traps naming what the value lacks.
private dateOf(d: Option[Date]) -> Date = d match
    Some(v) -> v
    None -> fail("a time of day has no date")

private timeOf(t: Option[Time]) -> Time = t match
    Some(v) -> v
    None -> fail("a date has no time of day")

private zonedOf(z: Option[Zoned]) -> Zoned = z match
    Some(v) -> v
    None -> fail("only a zoned reading knows its zone")

// A piece of a pattern: text written as it stands, or a run of `count` of an element's letter.
private data PatternPiece
    Literal(text: string)
    Element(letter: char, count: int, twelve: bool)

// Whether `c` begins an element of a pattern.
private isElementLetter(c: char) -> bool = c == 'Y' || c == 'M' || c == 'D' || c == 'W' || c == 'h' || c == 'a' || c == 'A' || c == 'm' || c == 's' || c == 'f' || c == 'z'

// What the lengths of `letter`'s element are, where `count` of it is none of them.
private runFault(letter: char, count: int) -> Option[string]
    if letter == 'Y' then (if count == 1 || count == 2 || count == 4 then None else Some("a year is Y, YY or YYYY"))
    elif letter == 'M' then (if count <= 4 then None else Some("a month is M, MM, MMM or MMMM"))
    elif letter == 'D' then (if count <= 3 then None else Some("a day is D, DD or DDD"))
    elif letter == 'W' then (if count == 3 || count == 4 then None else Some("a weekday is WWW or WWWW"))
    elif letter == 'h' then (if count <= 2 then None else Some("an hour is h, hh, h12 or hh12"))
    elif letter == 'a' || letter == 'A' then (if count == 1 then None else Some("the half of the day is a or A"))
    elif letter == 'm' then (if count <= 2 then None else Some("a minute is m or mm"))
    elif letter == 's' then (if count <= 2 then None else Some("a second is s or ss"))
    elif letter == 'f' then (if count <= 6 then None else Some("a fraction of a second is f to ffffff"))
    else (if count <= 4 then None else Some("a zone is z, zz, zzz or zzzz"))

// The pieces of `pattern`: a run of one element letter is an element, text between `|` bars is
// written as it stands (`||` is a bar, inside the bars too), and every other character stands for
// itself; a run of `h` followed by `12` is the hour on the twelve-hour clock. The whole pattern is
// read before anything is written, so a malformed pattern traps whatever value it is given.
private piecesOf(pattern: string) -> Vector[PatternPiece]
    val cs = pattern.chars()
    val n = cs.length()
    val pieces = Vector.newBuilder[PatternPiece]()
    var i = 0
    while i < n
        val c = cs(i)
        if c == '|' && i + 1 < n && cs(i + 1) == '|'
            pieces.addOne(Literal("|"))
            i = i + 2
        elif c == '|'
            i = i + 1
            var text = ""
            var closed = false
            while i < n && !closed
                if cs(i) == '|' && i + 1 < n && cs(i + 1) == '|'
                    text = text + "|"
                    i = i + 2
                elif cs(i) == '|'
                    closed = true
                    i = i + 1
                else
                    text = text + cs(i).toString()
                    i = i + 1
            if !closed then fail(s"the pattern \"$pattern\" has a | that never closes")
            pieces.addOne(Literal(text))
        elif isElementLetter(c)
            var count = 1
            while i + count < n && cs(i + count) == c do count = count + 1
            runFault(c, count) match
                Some(lengths) -> fail(s"the pattern \"$pattern\" has ${c.toString().repeat(count)}, which is no element: $lengths")
                None -> ()
            i = i + count
            val twelve = c == 'h' && i + 1 < n && cs(i) == '1' && cs(i + 1) == '2'
            if twelve then i = i + 2
            pieces.addOne(Element(c, count, twelve))
        else
            pieces.addOne(Literal(c.toString()))
            i = i + 1
    pieces.result()

// The text of the run of `count` of `letter`, an element `runFault` has accepted.
private elementText(letter: char, count: int, twelve: bool, d: Option[Date], t: Option[Time], z: Option[Zoned]) -> string
    if letter == 'Y'
        val year = dateOf(d).year()
        if count == 1 then year.toString()
        elif count == 2 then padded((if year < 0 then -year else year) % 100, 2)
        else yearText(year)
    elif letter == 'M'
        val month = dateOf(d).month()
        if count == 1 then month.toString()
        elif count == 2 then padded(long(month), 2)
        elif count == 3 then MonthNames(month - 1).take(3)
        else MonthNames(month - 1)
    elif letter == 'D'
        val date = dateOf(d)
        if count == 1 then date.day().toString()
        elif count == 2 then padded(long(date.day()), 2)
        else padded(long(date.dayOfYear()), 3)
    elif letter == 'W'
        val name = WeekdayNames(dateOf(d).weekday().isoNumber() - 1)
        if count == 3 then name.take(3) else name
    elif letter == 'h'
        val hour = timeOf(t).hour()
        val shown = if !twelve then hour elif hour % 12 == 0 then 12 else hour % 12
        if count == 1 then shown.toString() else padded(long(shown), 2)
    elif letter == 'a' || letter == 'A'
        val half = if timeOf(t).hour() < 12 then "am" else "pm"
        if letter == 'a' then half else half.toUpperCase()
    elif letter == 'm'
        val minute = timeOf(t).minute()
        if count == 1 then minute.toString() else padded(long(minute), 2)
    elif letter == 's'
        val second = timeOf(t).second()
        if count == 1 then second.toString() else padded(long(second), 2)
    elif letter == 'f'
        padded(long(timeOf(t).microsecond()), 6).take(count)
    else
        val zoned = zonedOf(z)
        if count == 1 then offsetText(zoned.offset, true)
        elif count == 2 then offsetText(zoned.offset, false)
        elif count == 3 then zoned.abbreviation()
        else zoned.zone.name()

// A reading written by `pattern`, from the parts of it there are.
private formatReading(pattern: string, d: Option[Date], t: Option[Time], z: Option[Zoned]) -> string
    var out = ""
    for piece in piecesOf(pattern)
        out = out + (piece match
            Literal(text) -> text
            Element(letter, count, twelve) -> elementText(letter, count, twelve, d, t, z))
    out

