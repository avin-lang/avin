module avin

// A growable, mutable, contiguous sequence: `addOne(x)` (or `append(x)`) appends an element,
// `prepend(x)` puts one in front, `insert` and `remove` add and take one at any index, and `b(i)` reads and `b(i) = v` replaces one, an index outside
// `0 ..< length` trapping at the call. `Buffer[int]()` is a new, empty buffer.
//
// The elements are the first `count` of `items`. The array's later elements are spare capacity:
// each is zero bytes, never read before an element is written to it, so the buffer needs no value
// to fill them with. When the array is full it is replaced by one twice as long.
class Buffer[T](): Seq[T]
    private var items: Array[T] = newArray[T](0)
    private var count = 0

    override length -> int = count

    // The element at `index`.
    override apply(index: int) -> T
        if index < 0 || index >= count then fail("index out of range")
        items(index)

    // Replaces the element at `index` with `value`.
    update(index: int, value: T)
        if index < 0 || index >= count then fail("index out of range")
        items(index) = value

    // Appends `element`.
    addOne(element: T)
        if count == items.length then grow()
        items(count) = element
        count += 1

    // Appends `element`, as `addOne` does.
    append(element: T) = addOne(element)

    // Appends every element of `elements`, in order. A buffer added to itself appends the elements
    // it held when the call began, once.
    addAll(elements: Iterable[T]) = insertAll(count, elements)

    // Appends every element of `elements`, in order, as `addAll` does.
    appendAll(elements: Iterable[T]) = insertAll(count, elements)

    // Puts `element` in front of the others.
    prepend(element: T) = insert(0, element)

    // Puts every element of `elements` in front of the others, in their order.
    prependAll(elements: Iterable[T]) = insertAll(0, elements)

    // Appends `element`: `buffer += x` is `buffer.addOne(x)`.
    +=(element: T) = addOne(element)

    // Appends every element of `elements`, in order: `buffer ++= xs` is `buffer.addAll(xs)`.
    ++=(elements: Iterable[T]) = addAll(elements)

    // Puts `element` at `index`, moving the elements from there one place on; `index` may be
    // `length`, which appends.
    insert(index: int, element: T)
        if index < 0 || index > count then fail("index out of range")
        if count == items.length then grow()
        var i = count
        while i > index
            items(i) = items(i - 1)
            i -= 1
        items(index) = element
        count += 1

    // Puts every element of `elements` at `index`, in their order, moving the elements from there
    // on past them; `index` may be `length`, which appends. The elements are read before any is
    // placed, so a buffer inserted into itself inserts the elements it held when the call began.
    insertAll(index: int, elements: Iterable[T])
        if index < 0 || index > count then fail("index out of range")
        if index == count && !(elements === self)
            for x in elements do addOne(x)
            return
        val incoming = elements.toArraySeq
        val n = incoming.length
        if n == 0 then return
        while count + n > items.length do grow()
        var i = count - 1
        while i >= index
            items(i + n) = items(i)
            i -= 1
        for j in 0 ..< n do items(index + j) = incoming(j)
        count += n

    // Takes out the element at `index` and returns it, moving the elements after it one place back.
    remove(index: int) -> T
        if index < 0 || index >= count then fail("index out of range")
        val removed = items(index)
        for i in index ..< count - 1 do items(i) = items(i + 1)
        count -= 1
        clearElements(items, count, count + 1)
        removed

    // Takes out `n` elements from `index` on, moving the elements after them `n` places back. `n` may
    // be 0, and `index` may be `length` when `n` is 0; a range that is not within the buffer traps.
    remove(index: int, n: int)
        if index < 0 || n < 0 || n > count - index then fail("range out of range")
        if n == 0 then return
        for i in index ..< count - n do items(i) = items(i + n)
        clearElements(items, count - n, count)
        count -= n

    // Takes out the first `n` elements; traps unless `0 <= n <= length`.
    trimStart(n: int)
        if n < 0 || n > count then fail("count out of range")
        remove(0, n)

    // Takes out the last `n` elements; traps unless `0 <= n <= length`.
    trimEnd(n: int)
        if n < 0 || n > count then fail("count out of range")
        remove(count - n, n)

    // Keeps only the elements that satisfy `p`, in order, testing each once from the first. `p` must
    // not change the buffer; a buffer that has changed when `p` returns traps.
    filterInPlace(p: (T) -> bool)
        val n = count
        var kept = 0
        for i in 0 ..< n
            val x = items(i)
            val keep = p(x)
            if count != n then fail("buffer changed during filterInPlace")
            if keep
                items(kept) = x
                kept += 1
        clearElements(items, kept, n)
        count = kept

    // Replaces each element with `f` of it, from the first. `f` must not change the buffer; a buffer
    // that has changed when `f` returns traps.
    mapInPlace(f: (T) -> T)
        val n = count
        for i in 0 ..< n
            val y = f(items(i))
            if count != n then fail("buffer changed during mapInPlace")
            items(i) = y

    // Replaces the `replaced` elements from `from` on with the elements of `other`, in their order.
    // `from` may be `length` and `replaced` may be 0 (an insertion); a range that is not within the
    // buffer traps. The elements of `other` are read before any change, so a buffer patched with
    // itself places the elements it held when the call began.
    patchInPlace(from: int, other: Iterable[T], replaced: int)
        if from < 0 || from > count || replaced < 0 || replaced > count - from then fail("range out of range")
        val incoming = other.toArraySeq
        remove(from, replaced)
        insertAll(from, incoming)

    // Puts the elements in the opposite order.
    reverseInPlace()
        var i = 0
        var j = count - 1
        while i < j
            val x = items(i)
            items(i) = items(j)
            items(j) = x
            i += 1
            j -= 1

    // Makes room for `size` elements at once, so adding up to that many grows the buffer no further.
    // A size no larger than the room it has changes nothing.
    sizeHint(size: int)
        if size <= items.length then return
        val larger = newArray[T](size)
        for i in 0 ..< count do larger(i) = items(i)
        publish(larger)
        items = larger

    // Removes every element, keeping the capacity.
    clear()
        clearElements(items, 0, count)
        count = 0

    // A new array of the elements.
    toArray() -> Array[T] = items.slice(0, count)

    // A vector of the elements as they are now.
    override toVector -> Vector[T]
        val b = VectorAssembler[T]()
        b.addElements(freeze(items), 0, count)
        b.result()

    // The elements as they are now, in one array read in constant time.
    override toArraySeq -> ArraySeq[T] = ArraySeq(freeze(items.slice(0, count)))

    // A new buffer of `f` of each element, in order.
    map[U](f: (T) -> U) -> Buffer[U]
        val out = Buffer[U]()
        for i in 0 ..< count do out.addOne(f(items(i)))
        out

    // A new buffer of `pf` of each element it is defined at, in order.
    collect[U](pf: PartialFunction[T, U]) -> Buffer[U]
        val f = pf.lift()
        val out = Buffer[U]()
        for i in 0 ..< count
            if f(items(i)) is Some(u) then out.addOne(u)
        out

    // A new buffer of the elements of the collections `f` makes of each element, joined in order.
    flatMap[U](f: (T) -> Iterable[U]) -> Buffer[U]
        val out = Buffer[U]()
        for i in 0 ..< count do out.addAll(f(items(i)))
        out

    // A new buffer of the values of the options `f` makes of each element, those that hold one.
    flatMap[U](f: (T) -> Option[U]) -> Buffer[U] = keptSomeInto(self, f, Buffer.newBuilder[U]())

    // A new buffer of the elements that satisfy `p`, in order.
    filter(p: (T) -> bool) -> Buffer[T] = keptInto(self, p, true, Buffer.newBuilder[T]())

    // A new buffer of the elements that do not satisfy `p`, in order.
    filterNot(p: (T) -> bool) -> Buffer[T] = keptInto(self, p, false, Buffer.newBuilder[T]())

    // The elements that satisfy `p`, tested only as `map`, `flatMap` or `foreach` reaches each one.
    withFilter(p: (T) -> bool) -> FilteredBuffer[T] = FilteredBuffer(self, p)

    // Reorders the elements in place by `compare`, which is negative, zero or positive as its first
    // argument orders before, with or after its second. The sort is stable.
    sortInPlaceWith(compare: (T, T) -> int) = sortElements(items, count, compare)

    // Reorders the elements in place by their keys, `key` being computed once for each element. The
    // sort is stable.
    sortInPlaceBy[K: Ord](key: (T) -> K) = sortElementsBy(items, count, key)

    // Replaces the array with one twice as long, or of eight elements when it is empty.
    private grow()
        val capacity = items.length
        val larger = newArray[T](if capacity == 0 then 8 elif capacity >= 1073741824 then 2147483647 else capacity * 2)
        for i in 0 ..< count do larger(i) = items(i)
        publish(larger)
        items = larger

// A buffer of ordered elements sorts in place, ascending or descending; the sort is stable.
impl[T: Ord] Buffer[T]
    sortInPlace() = sortInPlaceWith((x, y) -> x.compare(y))
    sortInPlaceDescending() = sortInPlaceWith((x, y) -> y.compare(x))

// A buffer of displayable elements displays its elements as they are now, as `[1, 2, 3]`. A field
// width pads the whole.
impl[T: Display] Display for Buffer[T]
    display(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            display(text, FormatSpec())
            out.writeField(text.text, spec)
            return
        out.write("[")
        for i in 0 ..< count
            if i > 0 then out.write(", ")
            items(i).display(out, FormatSpec())
        out.write("]")

// A buffer's diagnostic form is its elements' diagnostic forms in brackets: `["a", "b"]`.
impl[T: Debug] Debug for Buffer[T]
    debug(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            debug(text, FormatSpec())
            out.writeField(text.text, spec)
            return
        out.write("[")
        for i in 0 ..< count
            if i > 0 then out.write(", ")
            items(i).debug(out, FormatSpec())
        out.write("]")

// A buffer of comparable elements can take one out by value.
impl[T: Eq] Buffer[T]
    // Takes out the first element equal to `element`, moving the elements after it one place back,
    // and answers whether there was one.
    subtractOne(element: T) -> bool
        val at = indexOf(element)
        if at < 0 then return false
        remove(at)
        true

object Buffer
    // A new, empty buffer.
    empty[T]() -> Buffer[T] = Buffer[T]()

    // A new buffer of the elements of `elements`, in iteration order.
    from[T](elements: Iterable[T]) -> Buffer[T]
        val result = Buffer[T]()
        for x in elements do result.addOne(x)
        result

    // A builder of a buffer: the elements it is given, in order.
    newBuilder[T]() -> BufferBuilder[T] = BufferBuilder(Buffer[T](), false)

// Builds a buffer by adding to it.
class BufferBuilder[T](private var buffer: Buffer[T], private var spent: bool): Builder[T, Buffer[T]]
    override addOne(element: T)
        if spent then fail("add to a builder whose result was taken")
        buffer.addOne(element)

    override result() -> Buffer[T]
        if spent then fail("result of a builder whose result was taken")
        spent = true
        buffer

    // Starts a new buffer, leaving one already handed over as it is.
    override clear()
        buffer = Buffer[T]()
        spent = false

    override sizeHint(size: int) = buffer.sizeHint(size)

    override knownSize -> int = buffer.length

// A buffer seen through a test, which a guard of a `for` with `yield` makes: each element is tested
// just before the call after it would use it, so a guard runs in turn with the rest of the
// comprehension, element by element.
class FilteredBuffer[T](private val buffer: Buffer[T], private val p: (T) -> bool)
    // A new buffer of `f` of each element that passes the test, in order.
    map[U](f: (T) -> U) -> Buffer[U]
        val out = Buffer[U]()
        for x in buffer
            if p(x) then out.addOne(f(x))
        out

    // A new buffer of the elements of the collections `f` makes of each element that passes the test.
    flatMap[U](f: (T) -> Iterable[U]) -> Buffer[U]
        val out = Buffer[U]()
        for x in buffer
            if p(x) then out.addAll(f(x))
        out

    // A new buffer of the values of the options `f` makes of each element that passes the test.
    flatMap[U](f: (T) -> Option[U]) -> Buffer[U] = keptSomeInto(buffer, x -> if p(x) then f(x) else None, Buffer.newBuilder[U]())

    // The elements that pass this test and then `q`.
    withFilter(q: (T) -> bool) -> FilteredBuffer[T] = FilteredBuffer(buffer, x -> p(x) && q(x))

    // Calls `f` with each element that passes the test, in order.
    foreach(f: (T) -> unit)
        for x in buffer
            if p(x) then f(x)
