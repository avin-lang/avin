module avin

// A growable, mutable, contiguous sequence: `add(x)` appends an element, `insert` and `remove` add
// and take one at any index, and `b(i)` reads and `b(i) = v` replaces one, an index outside
// `0 ..< length()` trapping at the call. `Buffer[int]()` is a new, empty buffer.
//
// The elements are the first `count` of `items`. The array's later elements are spare capacity:
// each is zero bytes, never read before an element is written to it, so the buffer needs no value
// to fill them with. When the array is full it is replaced by one twice as long.
class Buffer[T](): Seq[T]
    private var items: Array[T] = newArray[T](0)
    private var count = 0

    override length() -> int = count

    // The element at `index`.
    override apply(index: int) -> T
        if index < 0 || index >= count then fail("index out of range")
        items(index)

    // Replaces the element at `index` with `value`.
    update(index: int, value: T)
        if index < 0 || index >= count then fail("index out of range")
        items(index) = value

    // Appends `element`.
    add(element: T)
        if count == items.length() then grow()
        items(count) = element
        count += 1

    // Appends every element of `elements`, in order.
    addAll(elements: Iterable[T])
        for x in elements do add(x)

    // Appends `element`: `buffer += x` is `buffer.add(x)`.
    +=(element: T) = add(element)

    // Appends every element of `elements`, in order: `buffer ++= xs` is `buffer.addAll(xs)`.
    ++=(elements: Iterable[T]) = addAll(elements)

    // Puts `element` at `index`, moving the elements from there one place on; `index` may be
    // `length()`, which appends.
    insert(index: int, element: T)
        if index < 0 || index > count then fail("index out of range")
        if count == items.length() then grow()
        var i = count
        while i > index
            items(i) = items(i - 1)
            i -= 1
        items(index) = element
        count += 1

    // Takes out the element at `index` and returns it, moving the elements after it one place back.
    remove(index: int) -> T
        if index < 0 || index >= count then fail("index out of range")
        val removed = items(index)
        for i in index ..< count - 1 do items(i) = items(i + 1)
        count -= 1
        clearElements(items, count, count + 1)
        removed

    // Removes every element, keeping the capacity.
    clear()
        clearElements(items, 0, count)
        count = 0

    // A new array of the elements.
    toArray() -> Array[T] = items.slice(0, count)

    // A vector of the elements as they are now.
    override toVector() -> Vector[T] = Vector(freeze(items.slice(0, count)))

    // A new buffer of `f` of each element, in order.
    map[U](f: (T) -> U) -> Buffer[U]
        val out = Buffer[U]()
        for i in 0 ..< count do out.add(f(items(i)))
        out

    // A new buffer of `pf` of each element it is defined at, in order.
    collect[U](pf: PartialFunction[T, U]) -> Buffer[U]
        val f = pf.lift()
        val out = Buffer[U]()
        for i in 0 ..< count
            if f(items(i)) is Some(u) then out.add(u)
        out

    // A new buffer of the elements of the collections `f` makes of each element, joined in order.
    flatMap[U](f: (T) -> Iterable[U]) -> Buffer[U]
        val out = Buffer[U]()
        for i in 0 ..< count do out.addAll(f(items(i)))
        out

    // The elements that satisfy `p`, tested only as `map`, `flatMap` or `foreach` reaches each one.
    withFilter(p: (T) -> bool) -> FilteredBuffer[T] = FilteredBuffer(self, p)

    // Reorders the elements in place by `compare`, which is negative, zero or positive as its first
    // argument orders before, with or after its second. The sort is stable.
    sortWith(compare: (T, T) -> int) = sortElements(items, count, compare)

    // Reorders the elements in place by their keys, `key` being computed once for each element. The
    // sort is stable.
    sortBy[K: Ord](key: (T) -> K) = sortElementsBy(items, count, key)

    // Replaces the array with one twice as long, or of eight elements when it is empty.
    private grow()
        val capacity = items.length()
        val larger = newArray[T](if capacity == 0 then 8 elif capacity >= 1073741824 then 2147483647 else capacity * 2)
        for i in 0 ..< count do larger(i) = items(i)
        publish(larger)
        items = larger

// A buffer of ordered elements sorts in place, ascending; the sort is stable.
impl[T: Ord] Buffer[T]
    sort() = sortWith((x, y) -> x.compare(y))

// Two buffers are equal when they hold equal elements in the same order, at the time they are
// compared.
impl[T] Eq for Buffer[T]
    equals(other: Buffer[T]) -> bool
        if count != other.length() then return false
        for i in 0 ..< count
            if !items(i).equals(other(i)) then return false
        true

impl[T] Hash for Buffer[T]
    hash() -> long
        var h = long(1)
        for i in 0 ..< count do h = h *% 31 +% items(i).hash()
        h

// A buffer of displayable elements displays its elements as they are now, as `[1, 2, 3]`. A field
// width pads the whole.
impl[T: Display] Display for Buffer[T]
    display(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            display(text, FormatSpec())
            out.writeField(text.text(), spec)
            return
        out.write("[")
        for i in 0 ..< count
            if i > 0 then out.write(", ")
            items(i).display(out, FormatSpec())
        out.write("]")

// A buffer's diagnostic form is its elements' diagnostic forms in brackets: `["a", "b"]`.
impl[T: Debug] Debug for Buffer[T]
    debug(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            debug(text, FormatSpec())
            out.writeField(text.text(), spec)
            return
        out.write("[")
        for i in 0 ..< count
            if i > 0 then out.write(", ")
            items(i).debug(out, FormatSpec())
        out.write("]")

object Buffer
    // A new, empty buffer.
    empty[T]() -> Buffer[T] = Buffer[T]()

    // A builder of a buffer: the elements it is given, in order.
    builder[T]() -> BufferBuilder[T] = BufferBuilder(Buffer[T](), false)

// Builds a buffer by adding to it.
class BufferBuilder[T](private val buffer: Buffer[T], private var spent: bool): Builder[T, Buffer[T]]
    override add(element: T)
        if spent then fail("add to a builder whose result was taken")
        buffer.add(element)

    override result() -> Buffer[T]
        if spent then fail("result of a builder whose result was taken")
        spent = true
        buffer

// A buffer seen through a test, which a guard of a `for` with `yield` makes: each element is tested
// just before the call after it would use it, so a guard runs in turn with the rest of the
// comprehension, element by element.
class FilteredBuffer[T](private val buffer: Buffer[T], private val p: (T) -> bool)
    // A new buffer of `f` of each element that passes the test, in order.
    map[U](f: (T) -> U) -> Buffer[U]
        val out = Buffer[U]()
        for x in buffer
            if p(x) then out.add(f(x))
        out

    // A new buffer of the elements of the collections `f` makes of each element that passes the test.
    flatMap[U](f: (T) -> Iterable[U]) -> Buffer[U]
        val out = Buffer[U]()
        for x in buffer
            if p(x) then out.addAll(f(x))
        out

    // The elements that pass this test and then `q`.
    withFilter(q: (T) -> bool) -> FilteredBuffer[T] = FilteredBuffer(buffer, x -> p(x) && q(x))

    // Calls `f` with each element that passes the test, in order.
    foreach(f: (T) -> unit)
        for x in buffer
            if p(x) then f(x)
