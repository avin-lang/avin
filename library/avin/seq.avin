module avin

// An ordered collection whose elements are numbered from 0: `xs(i)` is the element at `i`, and an
// index outside `0 ..< length()` traps, while `xs.get(i)` answers `None` there. Every list, vector,
// array, buffer and deque is a `Seq`, so a function over `Seq[T]` takes any of them.
//
// A sequence implements `length()` and `apply(index)`; everything else here is written once over
// those two, in index order. A sequence that reaches its elements faster another way, as a list does
// by walking from its front, overrides the methods that would be slow for it.
trait Seq[+T]: Iterable[T]
    // The number of elements.
    length() -> int

    // The element at `index`, which traps when there is none.
    apply(index: int) -> T

    // The element at `index`, or `None` when there is none.
    get(index: int) -> Option[T] = if 0 <= index < length() then Some(apply(index)) else None

    isEmpty() -> bool = length() == 0

    nonEmpty() -> bool = length() != 0

    // The first element, which traps when there is none.
    head() -> T
        if length() == 0 then fail("head of an empty sequence")
        apply(0)

    // The first element, or `None` when there is none.
    headOption() -> Option[T] = if length() == 0 then None else Some(apply(0))

    // The last element, which traps when there is none.
    last() -> T
        val n = length()
        if n == 0 then fail("last of an empty sequence")
        apply(n - 1)

    // The last element, or `None` when there is none.
    lastOption() -> Option[T]
        val n = length()
        if n == 0 then None else Some(apply(n - 1))

    // `f` applied to `initial` and the first element, then to that result and the second, and so on
    // to the last: `f(f(initial, x0), x1)`; `initial` when there are no elements.
    foldLeft[B](initial: B, f: (B, T) -> B) -> B
        var acc = initial
        for i in 0 ..< length() do acc = f(acc, apply(i))
        acc

    // `f` applied from the right: `f(x0, f(x1, initial))`; `initial` when there are no elements.
    foldRight[B](initial: B, f: (T, B) -> B) -> B
        var acc = initial
        var i = length() - 1
        while i >= 0
            acc = f(apply(i), acc)
            i -= 1
        acc

    // Calls `f` with each element, in order.
    foreach(f: (T) -> unit)
        for i in 0 ..< length() do f(apply(i))

    // Whether `p` holds for some element.
    exists(p: (T) -> bool) -> bool
        for i in 0 ..< length()
            if p(apply(i)) then return true
        false

    // Whether `p` holds for every element; true when there are none.
    forall(p: (T) -> bool) -> bool
        for i in 0 ..< length()
            if !p(apply(i)) then return false
        true

    // The first element that satisfies `p`, or `None`.
    find(p: (T) -> bool) -> Option[T]
        for i in 0 ..< length()
            val x = apply(i)
            if p(x) then return Some(x)
        None

    // The index of the first element that satisfies `p`, or `None`.
    indexWhere(p: (T) -> bool) -> Option[int]
        for i in 0 ..< length()
            if p(apply(i)) then return Some(i)
        None

    // How many elements satisfy `p`.
    count(p: (T) -> bool) -> int
        var n = 0
        for i in 0 ..< length()
            if p(apply(i)) then n += 1
        n

    // A vector of the elements as they are now.
    toVector() -> Vector[T]
        val b = Vector.builder[T]()
        for i in 0 ..< length() do b.add(apply(i))
        b.result()

    // A list of the elements as they are now.
    toList() -> List[T]
        var out: List[T] = []
        var i = length() - 1
        while i >= 0
            out = apply(i) :: out
            i -= 1
        out

    // Steps through the elements in order, reading each by its index when it is reached.
    override iterator() -> Iterator[T] = SeqIterator(self, 0)

    // Steps through the elements from the last to the first, reading each by its index when it is
    // reached.
    reverseIterator() -> Iterator[T] = ReverseSeqIterator(self, length() - 1)

// Every sequence has these, written once here for all of them. They reach the elements only through
// the trait's own methods, so `T` may appear in a parameter: on a `Seq[Dog]` seen as a `Seq[Animal]`,
// `T` is `Animal`. Each call is compiled for the receiver's type, so the trait's methods called here
// are that type's own.
impl[T] Seq[T]
    // Whether some element equals `element`.
    contains(element: T) -> bool = exists(x -> x.equals(element))

    // The index of the first element equal to `element`, or `None` when there is none.
    indexOf(element: T) -> Option[int] = indexWhere(x -> x.equals(element))

    // A vector of the elements ordered by `compare`, which is negative, zero or positive as its
    // first argument orders before, with or after its second. The sort is stable: elements that
    // compare equal keep their order.
    sortedWith(compare: (T, T) -> int) -> Vector[T]
        val a = elementArray(self)
        sortElements(a, a.length(), compare)
        Vector(freeze(a))

    // A vector of the elements ordered by their keys, `key` being computed once for each element.
    // The sort is stable: elements with equal keys keep their order.
    sortedBy[K: Ord](key: (T) -> K) -> Vector[T]
        val a = elementArray(self)
        sortElementsBy(a, a.length(), key)
        Vector(freeze(a))

// A sequence of ordered elements has a greatest and a least, and sorts.
impl[T: Ord] Seq[T]
    // The greatest element, the first of equal ones, or `None` when there are none.
    max() -> Option[T] = extreme(iterator(), true)

    // The least element, the first of equal ones, or `None` when there are none.
    min() -> Option[T] = extreme(iterator(), false)

    // A vector of the elements in ascending order; the sort is stable, so equal elements keep their
    // order.
    sorted() -> Vector[T]
        val a = elementArray(self)
        sortElements(a, a.length(), (x, y) -> x.compare(y))
        Vector(freeze(a))

// A sequence of displayable elements joins into a string.
impl[T: Display] Seq[T]
    // The elements in their own `Display`, separated by `sep`: `[1, 2, 3].mkString()` is `1, 2, 3`.
    mkString(sep: string = ", ") -> string = joined(iterator(), "", sep, "")

    // The elements between `start` and `end`, separated by `sep`.
    mkString(start: string, sep: string, end: string) -> string = joined(iterator(), start, sep, end)

// `xs` as the function from an index to the element there: a sequence passed or stored where a
// function from `int` is expected becomes this.
private elementAt[T](xs: Seq[T]) -> (int) -> T = i -> xs(i)

private class SeqIterator[T](items: Seq[T], private var index: int): Iterator[T]
    override hasNext() -> bool = index < items.length()

    override next() -> T
        if index >= items.length() then fail("next on an exhausted iterator")
        val value = items(index)
        index += 1
        value

private class ReverseSeqIterator[T](items: Seq[T], private var index: int): Iterator[T]
    override hasNext() -> bool = 0 <= index < items.length()

    override next() -> T
        if !(0 <= index < items.length()) then fail("next on an exhausted iterator")
        val value = items(index)
        index -= 1
        value

// A sequence of sequences flattens into one vector of their elements, in order.
impl[T] Seq[Seq[T]]
    flatten() -> Vector[T]
        val b = Vector.builder[T]()
        for i in 0 ..< length()
            val xs = apply(i)
            for j in 0 ..< xs.length() do b.add(xs(j))
        b.result()

// A sequence of pairs splits into the vector of their first parts and the vector of their second.
impl[A, B] Seq[(A, B)]
    unzip() -> (Vector[A], Vector[B])
        val firsts = Vector.builder[A]()
        val seconds = Vector.builder[B]()
        for i in 0 ..< length()
            val (a, b) = apply(i)
            firsts.add(a)
            seconds.add(b)
        (firsts.result(), seconds.result())
