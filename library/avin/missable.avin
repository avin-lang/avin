module avin

// A type with an answer for a value that is absent: `whenMissing` is what a decoder takes for a field
// its input leaves out. It is `None`, an absence the decoder reports as an error, for every type but
// an `Option`, whose absent field is `Some(None)`. Every format's decoder trait requires it, so each
// type has one answer, whichever formats decode it, and a program may import any of them together.
// A type of the program's own gets the default by deriving a decoder, or writes its own with
// `impl Missable for T`, which every format's derived decoder then takes.
trait Missable
  static whenMissing() -> Option[Self] = None

impl Missable for bool
  static whenMissing() -> Option[bool] = None

impl Missable for byte
  static whenMissing() -> Option[byte] = None

impl Missable for char
  static whenMissing() -> Option[char] = None

impl Missable for int
  static whenMissing() -> Option[int] = None

impl Missable for long
  static whenMissing() -> Option[long] = None

impl Missable for real
  static whenMissing() -> Option[real] = None

impl Missable for string
  static whenMissing() -> Option[string] = None

impl[A] Missable for Array[A]
  static whenMissing() -> Option[Array[A]] = None

impl[A] Missable for Option[A]
  static whenMissing() -> Option[Option[A]] = Some(None)

impl[A] Missable for Vector[A]
  static whenMissing() -> Option[Vector[A]] = None

impl[A] Missable for List[A]
  static whenMissing() -> Option[List[A]] = None

impl[K, A] Missable for HashMap[K, A]
  static whenMissing() -> Option[HashMap[K, A]] = None

impl[K, A] Missable for TreeMap[K, A]
  static whenMissing() -> Option[TreeMap[K, A]] = None
