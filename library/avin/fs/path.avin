module avin.fs

// Paths, tree walks and patterns. A path is a `string`, as every other call of `avin.fs` takes one.
// The functions before `absolute` answer from the text alone and touch no disk, as do `matches` and
// `matcher`; `absolute`, `canonicalize`, `isLink`, `walker`, `walk`, `find` and `glob` ask the file
// system. Paths are POSIX: `/` separates
// components, and a path starting with `/` starts at the root.

import avin.io
import avin.io.IoError

@sysl("sysl.path.is_absolute")
private syslIsAbsolute(p: string) -> bool

@sysl("sysl.path.components")
private syslComponents(p: string) -> Vector[string]

@sysl("sysl.path.join")
private syslJoin(a: string, b: string) -> string

@sysl("sysl.path.join_all")
private syslJoinAll(parts: Vector[string]) -> string

@sysl("sysl.path.parent")
private syslParent(p: string) -> Option[string]

@sysl("sysl.path.file_name")
private syslFileName(p: string) -> Option[string]

@sysl("sysl.path.extension")
private syslExtension(p: string) -> Option[string]

@sysl("sysl.path.stem")
private syslStem(p: string) -> Option[string]

@sysl("sysl.path.normalize")
private syslNormalize(p: string) -> string

@sysl("sysl.path.relative_to")
private syslRelativeTo(p: string, base: string) -> Option[string]

@sysl("sysl.fs.current_dir")
private syslCurrentDir() -> Result[string, SyslError]

@sysl("sysl.fs.canonicalize")
private syslCanonicalize(p: string) -> Result[string, SyslError]

@sysl("sysl.fs.is_link")
private syslIsLink(p: string) -> bool

@sysl("sysl.fs.symlink")
private syslSymlink(target: string, link: string) -> Result[unit, SyslError]

@sysl("sysl.fs.read_link")
private syslReadLink(link: string) -> Result[string, SyslError]

// Whether `p` starts at the root, which is whether it starts with `/`.
isAbsolute(p: string) -> bool = syslIsAbsolute(p)

// Whether `p` does not start at the root; the empty path is relative.
isRelative(p: string) -> bool = !syslIsAbsolute(p)

// The names between the separators, empty ones dropped: `/a//b/` has `a` and `b`. The root is not a
// component, and `.` and `..` are kept as written.
components(p: string) -> Vector[string] = syslComponents(p)

// `b` after `a`, with exactly one `/` between them however many `a` ends with. An empty side adds
// nothing, and an absolute `b` replaces `a`, since it already says where it starts.
join(a: string, b: string) -> string = syslJoin(a, b)

// Every part joined in turn by the rule of `join`: an absolute part discards the parts before it.
join(parts: Vector[string]) -> string = syslJoinAll(parts)

// Everything above the last component: `/a/b` has `/a`, `/a` has `/`. The root has nothing above it,
// and neither has a relative path of one component, nor the empty path.
parent(p: string) -> Option[string] = syslParent(p)

// The last component. The root, the empty path, `.` and `..` name no file and answer `None`.
fileName(p: string) -> Option[string] = syslFileName(p)

// What follows the last `.` of the file name: `gz` for `a.tar.gz`, empty for `a.`. A name with no dot
// has none, and neither has a name whose only dot is its first, such as `.profile`.
extension(p: string) -> Option[string] = syslExtension(p)

// The file name without its extension and the dot before it: `a.tar` for `a.tar.gz`, `.profile` for
// `.profile`.
stem(p: string) -> Option[string] = syslStem(p)

// `.` and `..` resolved in the text, doubled and trailing separators dropped. A `..` at the root is
// dropped, one leading a relative path is kept, and a path that cancels to nothing is `/` when it is
// absolute and `.` when it is not. Links are not consulted, so where one is in the path the answer
// may name another file than the path does; `canonicalize` asks the file system.
normalize(p: string) -> string = syslNormalize(p)

// `p` expressed from `base`, both normalized first: `../c` for `/a/c` from `/a/b`, `.` for a path
// from itself. `None` when one is absolute and the other is not, or when `base` climbs with `..`
// above what it names.
relativeTo(p: string, base: string) -> Option[string] = syslRelativeTo(p, base)

// `p` from the root, normalized: a relative path is read against the current directory. The file
// system is asked only for that directory; links are not resolved.
absolute(p: string) -> Result[string, IoError]
  if syslIsAbsolute(p) then return Ok(syslNormalize(p))
  val here = syslCurrentDir().mapErr(failed("read the current directory for", p))?
  Ok(syslNormalize(syslJoin(here, p)))

// The one absolute path the file system itself gives `p`, every link resolved and every `.` and `..`
// with them. The path must exist; `NotFound` otherwise.
canonicalize(p: string) -> Result[string, IoError] = syslCanonicalize(p).mapErr(failed("resolve", p))

// Whether `p` is a symbolic link, whatever it names and whether or not that exists.
isLink(p: string) -> bool = syslIsLink(p)

// Makes `link` a symbolic link to `target`, which need not exist and is stored as written, so a
// relative target is read from the directory `link` is in. `AlreadyExists` when something is at `link`.
symlink(target: string, link: string) -> Result[unit, IoError] = syslSymlink(target, link).mapErr(
  failed("make the link", link)
)

// What the symbolic link `link` holds, as it was written. A path that is not a link is an `Err`.
readLink(link: string) -> Result[string, IoError] = syslReadLink(link).mapErr(failed("read the link", link))

// One entry found by a walk: its `path` (the root joined with `relative`), its path `relative` to the
// root (empty for the root itself), its `depth` (0 for the root, 1 for the root's own entries),
// whether it is a directory and whether it is a symbolic link. A link is a directory here only when
// the walk follows links and it names one. `error` is what stopped the walk from going into a
// directory, whose entries are then absent: it could not be listed, or, following links, it is a
// directory the walk is already inside.
data Entry(path: string, relative: string, depth: int, isDir: bool, isLink: bool, error: Option[IoError])

// The entries of the tree at `root`, read as the iterator advances: each directory is listed when the
// walk reaches it, so taking the first few entries of a huge tree lists only the directories on the
// way to them. The walk is depth first, each directory's entries in code-point order, so two walks of
// an unchanged tree agree.
//
// - `maxDepth`: entries deeper than this are left out; a directory at `maxDepth` is an entry but is
//   not listed. 0 is the root alone. A negative `maxDepth` fails.
// - `includeRoot`: the root itself is the first entry (the last, in post-order), at depth 0.
// - `postOrder`: a directory comes after what it holds rather than before.
// - `followLinks`: a link that names a directory is gone into as a directory is; one that names a
//   directory the walk is already inside is an entry whose `error` says so, and is not gone into, so a
//   link back up the tree ends. Otherwise a link is an entry and is never followed.
// - `prune`: asked about each directory the walk is about to go into, the root excepted; one it
//   answers true for is an entry, but nothing in it is.
// - `stopOnError`: a directory that cannot be gone into ends the walk with that `Err`, rather than
//   being an entry carrying it while the walk goes on past.
//
// The root itself is followed when it is a link. A root that cannot be listed is one `Err` and
// nothing else; so is a root that is not a directory, unless `includeRoot` asks for it, when it is the
// one entry.
walker(
    root: string,
    maxDepth: int = int.MaxValue,
    includeRoot: bool = false,
    postOrder: bool = false,
    followLinks: bool = false,
    prune: (Entry) -> bool = _ -> false,
    stopOnError: bool = false
) -> Iterator[Result[Entry, IoError]]
  if maxDepth < 0 then fail(s"walk of $root with a negative maxDepth: $maxDepth")
  Walker(root, maxDepth, includeRoot, postOrder, followLinks, prune, stopOnError)

// Every entry `walker` finds with the same options, gathered into a vector; the first `Err` the walk
// meets is the answer instead. With no options it is every entry below the root, a directory before
// what it holds, links not followed, and a directory that cannot be listed an entry carrying the
// reason in its `error`.
walk(
    root: string,
    maxDepth: int = int.MaxValue,
    includeRoot: bool = false,
    postOrder: bool = false,
    followLinks: bool = false,
    prune: (Entry) -> bool = _ -> false,
    stopOnError: bool = false
) -> Result[Vector[Entry], IoError]
  val out = Buffer[Entry]()
  for step in walker(root, maxDepth, includeRoot, postOrder, followLinks, prune, stopOnError)
    out.addOne(step?)
  Ok(out.toVector)

// The paths of the entries below `root` that `p` is true for, in the walk's order, with the walk's
// options as `walk` takes them.
find(
    root: string,
    p: (Entry) -> bool,
    maxDepth: int = int.MaxValue,
    followLinks: bool = false,
    prune: (Entry) -> bool = _ -> false,
    stopOnError: bool = false
) -> Result[Vector[string], IoError]
  val out = Buffer[string]()
  for step in walker(root, maxDepth, false, false, followLinks, prune, stopOnError)
    val e = step?
    if p(e) then out.addOne(e.path)
  Ok(out.toVector)

// The paths of the entries below `root` whose path relative to the root fits `pattern`, as `matches`
// reads it: `find(dir, "**/*.avin")`.
find(
    root: string,
    pattern: string,
    maxDepth: int = int.MaxValue,
    followLinks: bool = false,
    prune: (Entry) -> bool = _ -> false,
    stopOnError: bool = false
) -> Result[Vector[string], IoError]
  val fits = matcher(pattern)
  find(root, e -> fits(e.relative), maxDepth, followLinks, prune, stopOnError)

// A directory the walk is inside: its entry, its names, how many of them the walk has taken, and,
// when links are followed, the one path the file system gives it.
private class WalkFrame(val entry: Entry, val names: Vector[string], val canonical: string)
  var index = 0

private class Walker(
    private val root: string,
    private val maxDepth: int,
    private val includeRoot: bool,
    private val postOrder: bool,
    private val followLinks: bool,
    private val prune: (Entry) -> bool,
    private val stopOnError: bool
): Iterator[Result[Entry, IoError]]
  private var started = false
  private var done = false
  private val stack = Buffer[WalkFrame]()
  private var pending: Option[Result[Entry, IoError]] = None

  override hasNext() -> bool
    fill()
    pending is Some(_)

  override next() -> Result[Entry, IoError]
    fill()
    pending match
      Some(r) ->
        pending = None
        r
      None -> fail("next on an exhausted iterator")

  // Fills `pending` with the next entry or error, or leaves it empty when the walk is over.
  private fill()
    if !started
      started = true
      start()
    while pending is None && !done
      if stack.isEmpty
        done = true
        return
      val top = stack(stack.length - 1)
      if top.index < top.names.length
        val name = top.names(top.index)
        top.index += 1
        val rel = syslJoin(top.entry.relative, name)
        val full = syslJoin(root, rel)
        val link = syslIsLink(full)
        val dir = (!link || followLinks) && isDir(full)
        val e = Entry(full, rel, top.entry.depth + 1, dir, link, None)
        if dir && e.depth < maxDepth && !prune(e) then enter(e) else pending = Some(Ok(e))
      else
        stack.remove(stack.length - 1)
        if postOrder && (stack.nonEmpty || includeRoot) then pending = Some(Ok(top.entry))

  private start()
    val e = Entry(root, "", 0, isDir(root), syslIsLink(root), None)
    if !e.isDir
      if includeRoot && metadata(root).isOk then pending = Some(Ok(e))
      else pending = Some(Err(listDir(root).err.getOrElse(IoError(io.NotADirectory, "list", root))))
      done = true
    else if maxDepth == 0
      if includeRoot then pending = Some(Ok(e))
      done = true
    else
      listDir(root) match
        Ok(names) ->
          stack.addOne(WalkFrame(e, names, canonicalOf(root)))
          if includeRoot && !postOrder then pending = Some(Ok(e))
        Err(err) ->
          pending = Some(Err(err))
          done = true

  // Goes into the directory `e`: lists it and, before its entries in pre-order, makes it the next
  // entry; or makes it an entry carrying why it could not, or ends the walk with that.
  private enter(e: Entry)
    val canonical = canonicalOf(e.path)
    val listed =
      if followLinks && stack.exists(f -> f.canonical == canonical)
        Err(IoError(io.Other("file system loop"), "walk into", e.path))
      else listDir(e.path)
    listed match
      Ok(names) ->
        stack.addOne(WalkFrame(e, names, canonical))
        if !postOrder then pending = Some(Ok(e))
      Err(err) ->
        if stopOnError
          pending = Some(Err(err))
          done = true
        else pending = Some(Ok(Entry(e.path, e.relative, e.depth, e.isDir, e.isLink, Some(err))))

  // The path the file system gives `p`, asked only when links are followed, since only then can a walk
  // come back to a directory it is inside.
  private canonicalOf(p: string) -> string =
    if followLinks then syslCanonicalize(p).getOrElse(p) else p

// Whether the path `p` fits `pattern`. Both are compared component by component (`components`), so
// doubled and trailing separators do not matter, and an absolute pattern fits only an absolute path.
// In a component, `*` is any run of characters, `?` one character, `[abc]` and `[a-z]` one character
// of the set, `[!a-z]` and `[^a-z]` one not in it, and `\` makes the next character literal. A
// component that is exactly `**` is any number of whole components, none at all included. `{a,b}` is
// any one of its comma-separated alternatives, which may hold `/`, wildcards and further braces:
// `src/{lib,test}/**/*.{c,h}`. A name starting with `.` is hidden: only a pattern component starting
// with a literal `.` fits it, and `**` never passes through it. A `[` with no closing `]` is a literal
// `[`, and a `{` with no closing `}` a literal `{`.
matches(pattern: string, p: string) -> bool = matcher(pattern)(p)

// `matches` for one pattern read once, for testing many paths: `fs.matcher("**/*.avin")`.
matcher(pattern: string) -> (string) -> bool
  val each = expandBraces(pattern).map(one -> (syslIsAbsolute(one), syslComponents(one).map(compileComponent)))
  p ->
    val absolute = syslIsAbsolute(p)
    val parts = syslComponents(p)
    each.exists(c -> c.0 == absolute && matchParts(c.1, 0, parts, 0))

// The paths that exist and fit `pattern`, in code-point order, each once. A relative pattern is read
// from the current directory and answers relative paths; an absolute one answers absolute paths. A
// `**` does not go through symbolic links, as `walk` does not; a link named by another component is
// followed. A directory that cannot be read contributes nothing. Each alternative of a `{a,b}` is
// globbed in turn and the answers merged.
glob(pattern: string) -> Vector[string] = expandBraces(pattern).flatMap(globOne).distinct.sorted

private globOne(pattern: string) -> Vector[string]
  val parts = syslComponents(pattern)
  if parts.isEmpty
    return if syslIsAbsolute(pattern) then ["/"] else []
  var current: Vector[string] = [if syslIsAbsolute(pattern) then "/" else ""]
  for k in 0 ..< parts.length
    val part = parts(k)
    val last = k == parts.length - 1
    val next = Buffer[string]()
    val compiled = compileComponent(part)
    for base in current
      compiled match
        AnyComponents -> globBelow(base, last, next)
        Literal(name) ->
          val candidate = syslJoin(base, name)
          if exists(candidate) || syslIsLink(candidate) then next.addOne(candidate)
        Pattern(tokens) ->
          for name in listDir(dirOf(base)).getOrElse(Vector.empty[string]())
            if matchName(tokens, name) then next.addOne(syslJoin(base, name))
    current = next.toVector
  current

// The patterns a `{a,b}` alternation stands for, each brace written out, in the order the
// alternatives are written: `x{a,b}{1,2}` is `xa1`, `xa2`, `xb1`, `xb2`. A brace escaped with `\` or
// inside a `[...]` class is not one, a `{` with no closing `}` is literal, and `{a}` is `a`.
private expandBraces(pattern: string) -> Vector[string]
  val cs = pattern.chars
  findBraces(cs, 0) match
    None -> [pattern]
    Some((open, close, commas)) ->
      val before = cs.slice(0, open).mkString("")
      val after = cs.slice(close + 1, cs.length).mkString("")
      val bounds = Vector(open) ++ commas ++ Vector(close)
      (0 ..< bounds.length - 1).toVector.flatMap(
        k -> expandBraces(before + cs.slice(bounds(k) + 1, bounds(k + 1)).mkString("") + after)
      )

// The first `{` from `from` with a closing `}`: its index, the closing one's, and the commas between
// them that are not inside a nested brace.
private findBraces(cs: Vector[char], from: int) -> Option[(int, int, Vector[int])]
  var i = from
  while i < cs.length
    val c = cs(i)
    if c == '\\' then i += 2
    else if c == '[' then i = afterClass(cs, i)
    else if c == '{'
      closeBrace(cs, i) match
        Some((close, commas)) -> return Some((i, close, commas))
        None -> i += 1
    else i += 1
  None

// The `}` closing the `{` at `open`, and the commas at its own level.
private closeBrace(cs: Vector[char], open: int) -> Option[(int, Vector[int])]
  val commas = Buffer[int]()
  var depth = 0
  var i = open + 1
  while i < cs.length
    val c = cs(i)
    if c == '\\' then i += 2
    else if c == '[' then i = afterClass(cs, i)
    else
      if c == '{' then depth += 1
      else if c == '}'
        if depth == 0 then return Some((i, commas.toVector))
        depth -= 1
      else if c == ',' && depth == 0 then commas.addOne(i)
      i += 1
  None

// The index after the class starting with the `[` at `at`, or after the `[` alone when it is not
// closed and so is a literal `[`.
private afterClass(cs: Vector[char], at: int) -> int = readClass(cs, at + 1) match
  Some((_, after)) -> after
  None -> at + 1

private dirOf(base: string) -> string = if base.isEmpty then "." else base

// For a `**`: `base` itself and every directory below it, links not followed and hidden names left
// out; as the last component, the files below it too.
private globBelow(base: string, last: bool, out: Buffer[string])
  if !base.isEmpty then out.addOne(base)
  for name in listDir(dirOf(base)).getOrElse(Vector.empty[string]())
    if !name.startsWith(".")
      val full = syslJoin(base, name)
      if !syslIsLink(full) && isDir(full) then globBelow(full, last, out)
      else if last then out.addOne(full)

// A pattern component, read once: `**`, a name with nothing special in it, or tokens to match.
private data Component
  AnyComponents
  Literal(name: string)
  Pattern(tokens: Vector[Token])

private data Token
  Exact(c: char)
  AnyChar
  AnyRun
  OneOf(negated: bool, ranges: Vector[CharRange])

private data CharRange(lo: char, hi: char)

private compileComponent(part: string) -> Component
  if part == "**" then return AnyComponents
  val tokens = tokenize(part.chars)
  if tokens.forall(t -> t is Exact(_)) then Literal(tokens.map(exactChar).mkString("")) else Pattern(tokens)

private exactChar(t: Token) -> char = t match
  Exact(c) -> c
  _ -> ' '

private tokenize(cs: Vector[char]) -> Vector[Token]
  val out = Buffer[Token]()
  var i = 0
  while i < cs.length
    val c = cs(i)
    if c == '*'
      out.addOne(AnyRun)
      i += 1
    else if c == '?'
      out.addOne(AnyChar)
      i += 1
    else if c == '\\' && i + 1 < cs.length
      out.addOne(Exact(cs(i + 1)))
      i += 2
    else if c == '['
      readClass(cs, i + 1) match
        Some((token, after)) ->
          out.addOne(token)
          i = after
        None ->
          out.addOne(Exact('['))
          i += 1
    else
      out.addOne(Exact(c))
      i += 1
  out.toVector

// The class whose body starts at `from`, and the index after its `]`; `None` when it is not closed.
// A `]` first in the body is a member, as is a `-` first or last.
private readClass(cs: Vector[char], from: int) -> Option[(Token, int)]
  var i = from
  val negated = i < cs.length && (cs(i) == '!' || cs(i) == '^')
  if negated then i += 1
  val ranges = Buffer[CharRange]()
  var first = true
  while i < cs.length
    var c = cs(i)
    if c == ']' && !first then return Some((OneOf(negated, ranges.toVector), i + 1))
    first = false
    if c == '\\' && i + 1 < cs.length
      i += 1
      c = cs(i)
    if i + 2 < cs.length && cs(i + 1) == '-' && cs(i + 2) != ']'
      var hi = cs(i + 2)
      var skip = 3
      if hi == '\\' && i + 3 < cs.length
        hi = cs(i + 3)
        skip = 4
      ranges.addOne(CharRange(c, hi))
      i += skip
    else
      ranges.addOne(CharRange(c, c))
      i += 1
  None

private matchParts(pattern: Vector[Component], i: int, parts: Vector[string], j: int) -> bool
  if i == pattern.length then return j == parts.length
  pattern(i) match
    AnyComponents ->
      var k = j
      while true
        if matchParts(pattern, i + 1, parts, k) then return true
        if k == parts.length || parts(k).startsWith(".") then return false
        k += 1
      false
    Literal(name) -> j < parts.length && parts(j) == name && matchParts(pattern, i + 1, parts, j + 1)
    Pattern(tokens) -> j < parts.length && matchName(tokens, parts(j)) && matchParts(pattern, i + 1, parts, j + 1)

// Whether one name fits one component's tokens; a hidden name needs a literal leading `.`.
private matchName(tokens: Vector[Token], name: string) -> bool
  if name.startsWith(".") && !(tokens.nonEmpty && tokens(0) is Exact(_)) then return false
  matchFrom(tokens, 0, name.chars, 0)

private matchFrom(tokens: Vector[Token], i: int, cs: Vector[char], j: int) -> bool
  if i == tokens.length then return j == cs.length
  tokens(i) match
    AnyRun ->
      var k = j
      while k <= cs.length
        if matchFrom(tokens, i + 1, cs, k) then return true
        k += 1
      false
    AnyChar -> j < cs.length && matchFrom(tokens, i + 1, cs, j + 1)
    Exact(c) -> j < cs.length && cs(j) == c && matchFrom(tokens, i + 1, cs, j + 1)
    OneOf(negated, ranges) ->
      j < cs.length && ranges.exists(r -> r.lo <= cs(j) <= r.hi) != negated
        && matchFrom(tokens, i + 1, cs, j + 1)
