module avin.fs

// Paths, tree walks and patterns. A path is a `string`, as every other call of `avin.fs` takes one.
// The functions down to `matches` answer from the text alone and touch no disk; `absolute`,
// `canonicalize`, `isLink`, `walk` and `glob` ask the file system. Paths are POSIX: `/` separates
// components, and a path starting with `/` starts at the root.

import avin.io.IoError

@sysl("sysl.path.is_absolute")
private syslIsAbsolute(p: string) -> bool

@sysl("sysl.path.components")
private syslComponents(p: string) -> Vector[string]

@sysl("sysl.path.join")
private syslJoin(a: string, b: string) -> string

@sysl("sysl.path.join_all")
private syslJoinAll(parts: Vector[string]) -> string

@sysl("sysl.path.parent")
private syslParent(p: string) -> Option[string]

@sysl("sysl.path.file_name")
private syslFileName(p: string) -> Option[string]

@sysl("sysl.path.extension")
private syslExtension(p: string) -> Option[string]

@sysl("sysl.path.stem")
private syslStem(p: string) -> Option[string]

@sysl("sysl.path.normalize")
private syslNormalize(p: string) -> string

@sysl("sysl.path.relative_to")
private syslRelativeTo(p: string, base: string) -> Option[string]

@sysl("sysl.fs.current_dir")
private syslCurrentDir() -> Result[string, SyslError]

@sysl("sysl.fs.canonicalize")
private syslCanonicalize(p: string) -> Result[string, SyslError]

@sysl("sysl.fs.is_link")
private syslIsLink(p: string) -> bool

@sysl("sysl.fs.symlink")
private syslSymlink(target: string, link: string) -> Result[unit, SyslError]

@sysl("sysl.fs.read_link")
private syslReadLink(link: string) -> Result[string, SyslError]

// Whether `p` starts at the root, which is whether it starts with `/`.
isAbsolute(p: string) -> bool = syslIsAbsolute(p)

// Whether `p` does not start at the root; the empty path is relative.
isRelative(p: string) -> bool = !syslIsAbsolute(p)

// The names between the separators, empty ones dropped: `/a//b/` has `a` and `b`. The root is not a
// component, and `.` and `..` are kept as written.
components(p: string) -> Vector[string] = syslComponents(p)

// `b` after `a`, with exactly one `/` between them however many `a` ends with. An empty side adds
// nothing, and an absolute `b` replaces `a`, since it already says where it starts.
join(a: string, b: string) -> string = syslJoin(a, b)

// Every part joined in turn by the rule of `join`: an absolute part discards the parts before it.
join(parts: Vector[string]) -> string = syslJoinAll(parts)

// Everything above the last component: `/a/b` has `/a`, `/a` has `/`. The root has nothing above it,
// and neither has a relative path of one component, nor the empty path.
parent(p: string) -> Option[string] = syslParent(p)

// The last component. The root, the empty path, `.` and `..` name no file and answer `None`.
fileName(p: string) -> Option[string] = syslFileName(p)

// What follows the last `.` of the file name: `gz` for `a.tar.gz`, empty for `a.`. A name with no dot
// has none, and neither has a name whose only dot is its first, such as `.profile`.
extension(p: string) -> Option[string] = syslExtension(p)

// The file name without its extension and the dot before it: `a.tar` for `a.tar.gz`, `.profile` for
// `.profile`.
stem(p: string) -> Option[string] = syslStem(p)

// `.` and `..` resolved in the text, doubled and trailing separators dropped. A `..` at the root is
// dropped, one leading a relative path is kept, and a path that cancels to nothing is `/` when it is
// absolute and `.` when it is not. Links are not consulted, so where one is in the path the answer
// may name another file than the path does; `canonicalize` asks the file system.
normalize(p: string) -> string = syslNormalize(p)

// `p` expressed from `base`, both normalized first: `../c` for `/a/c` from `/a/b`, `.` for a path
// from itself. `None` when one is absolute and the other is not, or when `base` climbs with `..`
// above what it names.
relativeTo(p: string, base: string) -> Option[string] = syslRelativeTo(p, base)

// `p` from the root, normalized: a relative path is read against the current directory. The file
// system is asked only for that directory; links are not resolved.
absolute(p: string) -> Result[string, IoError]
  if syslIsAbsolute(p) then return Ok(syslNormalize(p))
  val here = syslCurrentDir().mapErr(failed("read the current directory for", p))?
  Ok(syslNormalize(syslJoin(here, p)))

// The one absolute path the file system itself gives `p`, every link resolved and every `.` and `..`
// with them. The path must exist; `NotFound` otherwise.
canonicalize(p: string) -> Result[string, IoError] = syslCanonicalize(p).mapErr(failed("resolve", p))

// Whether `p` is a symbolic link, whatever it names and whether or not that exists.
isLink(p: string) -> bool = syslIsLink(p)

// Makes `link` a symbolic link to `target`, which need not exist and is stored as written, so a
// relative target is read from the directory `link` is in. `AlreadyExists` when something is at `link`.
symlink(target: string, link: string) -> Result[unit, IoError] = syslSymlink(target, link).mapErr(
  failed("make the link", link)
)

// What the symbolic link `link` holds, as it was written. A path that is not a link is an `Err`.
readLink(link: string) -> Result[string, IoError] = syslReadLink(link).mapErr(failed("read the link", link))

// One entry found by `walk`: its `path` (the root joined with `relative`), its path `relative` to the
// root, its `depth` (1 for the root's own entries), whether it is a directory and whether it is a
// symbolic link. A link is never a directory here, whatever it names. `error` is what stopped the walk
// from listing a directory, whose entries are then absent.
data Entry(path: string, relative: string, depth: int, isDir: bool, isLink: bool, error: Option[IoError])

// Every entry below the directory `root`, the root itself not included: depth first, a directory
// before what it holds, the entries of each directory in code-point order, so two walks of an
// unchanged tree agree. A symbolic link is listed and never followed, so a link back up the tree ends
// nothing early and repeats nothing. A directory that cannot be listed is still an entry, with the
// reason in its `error`, and the walk goes on past it. The root itself is followed when it is a link,
// and when it cannot be listed the whole walk is that error.
walk(root: string) -> Result[Vector[Entry], IoError]
  val names = listDir(root)?
  val out = Buffer[Entry]()
  walkInto(root, "", 1, names, out)
  Ok(out.toVector)

private walkInto(root: string, relative: string, depth: int, names: Vector[string], out: Buffer[Entry])
  for name in names
    val rel = syslJoin(relative, name)
    val full = syslJoin(root, rel)
    if syslIsLink(full)
      out.addOne(Entry(full, rel, depth, false, true, None))
    else if isDir(full)
      listDir(full) match
        Ok(inner) ->
          out.addOne(Entry(full, rel, depth, true, false, None))
          walkInto(root, rel, depth + 1, inner, out)
        Err(e) -> out.addOne(Entry(full, rel, depth, true, false, Some(e)))
    else
      out.addOne(Entry(full, rel, depth, false, false, None))

// Whether the path `p` fits `pattern`. Both are compared component by component (`components`), so
// doubled and trailing separators do not matter, and an absolute pattern fits only an absolute path.
// In a component, `*` is any run of characters, `?` one character, `[abc]` and `[a-z]` one character
// of the set, `[!a-z]` and `[^a-z]` one not in it, and `\` makes the next character literal. A
// component that is exactly `**` is any number of whole components, none at all included. A name
// starting with `.` is hidden: only a pattern component starting with a literal `.` fits it, and `**`
// never passes through it. A `[` with no closing `]` is a literal `[`.
matches(pattern: string, p: string) -> bool =
  syslIsAbsolute(pattern) == syslIsAbsolute(p)
    && matchParts(syslComponents(pattern).map(compileComponent), 0, syslComponents(p), 0)

// The paths that exist and fit `pattern`, in code-point order, each once. A relative pattern is read
// from the current directory and answers relative paths; an absolute one answers absolute paths. A
// `**` does not go through symbolic links, as `walk` does not; a link named by another component is
// followed. A directory that cannot be read contributes nothing.
glob(pattern: string) -> Vector[string]
  val parts = syslComponents(pattern)
  if parts.isEmpty
    return if syslIsAbsolute(pattern) then ["/"] else []
  var current: Vector[string] = [if syslIsAbsolute(pattern) then "/" else ""]
  for k in 0 ..< parts.length
    val part = parts(k)
    val last = k == parts.length - 1
    val next = Buffer[string]()
    val compiled = compileComponent(part)
    for base in current
      compiled match
        AnyComponents -> globBelow(base, last, next)
        Literal(name) ->
          val candidate = syslJoin(base, name)
          if exists(candidate) || syslIsLink(candidate) then next.addOne(candidate)
        Pattern(tokens) ->
          for name in listDir(dirOf(base)).getOrElse(Vector.empty[string]())
            if matchName(tokens, name) then next.addOne(syslJoin(base, name))
    current = next.toVector
  current.distinct.sorted

private dirOf(base: string) -> string = if base.isEmpty then "." else base

// For a `**`: `base` itself and every directory below it, links not followed and hidden names left
// out; as the last component, the files below it too.
private globBelow(base: string, last: bool, out: Buffer[string])
  if !base.isEmpty then out.addOne(base)
  for name in listDir(dirOf(base)).getOrElse(Vector.empty[string]())
    if !name.startsWith(".")
      val full = syslJoin(base, name)
      if !syslIsLink(full) && isDir(full) then globBelow(full, last, out)
      else if last then out.addOne(full)

// A pattern component, read once: `**`, a name with nothing special in it, or tokens to match.
private data Component
  AnyComponents
  Literal(name: string)
  Pattern(tokens: Vector[Token])

private data Token
  Exact(c: char)
  AnyChar
  AnyRun
  OneOf(negated: bool, ranges: Vector[CharRange])

private data CharRange(lo: char, hi: char)

private compileComponent(part: string) -> Component
  if part == "**" then return AnyComponents
  val tokens = tokenize(part.chars)
  if tokens.forall(t -> t is Exact(_)) then Literal(tokens.map(exactChar).mkString("")) else Pattern(tokens)

private exactChar(t: Token) -> char = t match
  Exact(c) -> c
  _ -> ' '

private tokenize(cs: Vector[char]) -> Vector[Token]
  val out = Buffer[Token]()
  var i = 0
  while i < cs.length
    val c = cs(i)
    if c == '*'
      out.addOne(AnyRun)
      i += 1
    else if c == '?'
      out.addOne(AnyChar)
      i += 1
    else if c == '\\' && i + 1 < cs.length
      out.addOne(Exact(cs(i + 1)))
      i += 2
    else if c == '['
      readClass(cs, i + 1) match
        Some((token, after)) ->
          out.addOne(token)
          i = after
        None ->
          out.addOne(Exact('['))
          i += 1
    else
      out.addOne(Exact(c))
      i += 1
  out.toVector

// The class whose body starts at `from`, and the index after its `]`; `None` when it is not closed.
// A `]` first in the body is a member, as is a `-` first or last.
private readClass(cs: Vector[char], from: int) -> Option[(Token, int)]
  var i = from
  val negated = i < cs.length && (cs(i) == '!' || cs(i) == '^')
  if negated then i += 1
  val ranges = Buffer[CharRange]()
  var first = true
  while i < cs.length
    var c = cs(i)
    if c == ']' && !first then return Some((OneOf(negated, ranges.toVector), i + 1))
    first = false
    if c == '\\' && i + 1 < cs.length
      i += 1
      c = cs(i)
    if i + 2 < cs.length && cs(i + 1) == '-' && cs(i + 2) != ']'
      var hi = cs(i + 2)
      var skip = 3
      if hi == '\\' && i + 3 < cs.length
        hi = cs(i + 3)
        skip = 4
      ranges.addOne(CharRange(c, hi))
      i += skip
    else
      ranges.addOne(CharRange(c, c))
      i += 1
  None

private matchParts(pattern: Vector[Component], i: int, parts: Vector[string], j: int) -> bool
  if i == pattern.length then return j == parts.length
  pattern(i) match
    AnyComponents ->
      var k = j
      while true
        if matchParts(pattern, i + 1, parts, k) then return true
        if k == parts.length || parts(k).startsWith(".") then return false
        k += 1
      false
    Literal(name) -> j < parts.length && parts(j) == name && matchParts(pattern, i + 1, parts, j + 1)
    Pattern(tokens) -> j < parts.length && matchName(tokens, parts(j)) && matchParts(pattern, i + 1, parts, j + 1)

// Whether one name fits one component's tokens; a hidden name needs a literal leading `.`.
private matchName(tokens: Vector[Token], name: string) -> bool
  if name.startsWith(".") && !(tokens.nonEmpty && tokens(0) is Exact(_)) then return false
  matchFrom(tokens, 0, name.chars, 0)

private matchFrom(tokens: Vector[Token], i: int, cs: Vector[char], j: int) -> bool
  if i == tokens.length then return j == cs.length
  tokens(i) match
    AnyRun ->
      var k = j
      while k <= cs.length
        if matchFrom(tokens, i + 1, cs, k) then return true
        k += 1
      false
    AnyChar -> j < cs.length && matchFrom(tokens, i + 1, cs, j + 1)
    Exact(c) -> j < cs.length && cs(j) == c && matchFrom(tokens, i + 1, cs, j + 1)
    OneOf(negated, ranges) ->
      j < cs.length && ranges.exists(r -> r.lo <= cs(j) <= r.hi) != negated
        && matchFrom(tokens, i + 1, cs, j + 1)
