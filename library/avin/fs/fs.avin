module avin.fs

// Files and directories: whole files read and written at once, and the directories that hold them.
// Every failure is an `IoError` value, which `?` passes on, naming what was being done and the path
// it was done to: `cannot read app.conf: no such file or directory`.

import avin.io
import avin.io.ErrorKind
import avin.io.IoError
import avin.process
import avin.time.Instant
import avin.time.epochMicros

// Sysl's own error, converted into an `IoError` as each result comes back.
@sysl("sysl.fs.IoError")
private data SyslError
  NotFound
  PermissionDenied
  AlreadyExists
  NotADirectory
  IsADirectory
  DirectoryNotEmpty
  TooManyOpenFiles
  NoSpaceLeft
  Interrupted
  NotOpen
  NotPermitted
  InvalidUtf8(offset: long)
  Other(code: int)

private kindOf(e: SyslError) -> ErrorKind = e match
  NotFound -> io.NotFound
  PermissionDenied -> io.PermissionDenied
  AlreadyExists -> io.AlreadyExists
  NotADirectory -> io.NotADirectory
  IsADirectory -> io.IsADirectory
  DirectoryNotEmpty -> io.DirectoryNotEmpty
  InvalidUtf8(at) -> io.InvalidUtf8(at)
  _ -> io.Other(syslMessage(e))

// The error `operation` on `subject` failed with, of the kind Sysl's error `e` is.
private failed(operation: string, subject: string) -> (SyslError) -> IoError =
  e -> IoError(kindOf(e), operation, subject)

// The platform's own sentence for a Sysl error, as Sysl words it.
@sysl("avin.rt.io_error_message")
private syslMessage(e: SyslError) -> string

// Reading, writing and opening wait on the file's other end where it is a pipe, a FIFO or a device,
// so each is bound `blocking`; asking about a path, listing a directory and moving entries do not.
@sysl("sysl.fs.read_text", blocking)
private syslReadText(file: string) -> Result[string, SyslError]

@sysl("sysl.fs.read_bytes", blocking)
private syslReadBytes(file: string) -> Result[Array[byte], SyslError]

@sysl("sysl.fs.write_text", blocking)
private syslWriteText(file: string, text: string) -> Result[unit, SyslError]

@sysl("sysl.fs.append_text", blocking)
private syslAppendText(file: string, text: string) -> Result[unit, SyslError]

@sysl("sysl.fs.write_bytes", blocking)
private syslWriteBytes(file: string, bytes: Array[byte]) -> Result[unit, SyslError]

@sysl("sysl.fs.append_bytes", blocking)
private syslAppendBytes(file: string, bytes: Array[byte]) -> Result[unit, SyslError]

@sysl("sysl.fs.exists")
private syslExists(file: string) -> bool

@sysl("sysl.fs.remove_file")
private syslRemoveFile(file: string) -> Result[unit, SyslError]

@sysl("sysl.fs.remove_dir")
private syslRemoveDir(dir: string) -> Result[unit, SyslError]

@sysl("sysl.fs.remove_dir_all")
private syslRemoveDirAll(dir: string) -> Result[unit, SyslError]

@sysl("sysl.fs.rename")
private syslRename(from: string, to: string) -> Result[unit, SyslError]

@sysl("sysl.fs.make_dir")
private syslMakeDir(dir: string) -> Result[unit, SyslError]

@sysl("sysl.fs.make_dir_all")
private syslMakeDirAll(dir: string) -> Result[unit, SyslError]

@sysl("sysl.fs.make_temp_dir")
private syslMakeTempDir(prefix: string) -> Result[string, SyslError]

@sysl("sysl.fs.entries")
private syslEntries(dir: string) -> Result[Vector[string], SyslError]

@sysl("sysl.fs.pending_name")
private syslPendingName(file: string) -> string

@sysl("sysl.fs.publish_file")
private syslPublishFile(pending: string, file: string) -> Result[unit, SyslError]

// Makes the directories above `file` that are missing; nothing for a name with no directory part.
private makeParents(file: string) -> Result[unit, IoError] = parent(file) match
  Some(dir) -> if dir == "" then Ok(()) else createDirAll(dir)
  None -> Ok(())

// The whole of `file` as text. Bytes that are not UTF-8 are `InvalidUtf8`, at the first one that
// is not.
readText(file: string) -> Result[string, IoError] = syslReadText(file).mapErr(failed("read", file))

// The whole of `file` as bytes, in a new array the caller owns.
readBytes(file: string) -> Result[Array[byte], IoError] = syslReadBytes(file).mapErr(failed("read", file))

// Makes `file` hold exactly `text`, creating it if it does not exist and replacing what it held if
// it does. With `createParents`, the directories above `file` that are missing are made first.
writeText(file: string, text: string, createParents: bool = false) -> Result[unit, IoError]
  if createParents then makeParents(file)?
  syslWriteText(file, text).mapErr(failed("write", file))

// Adds `text` to the end of `file`, creating it if it does not exist.
appendText(file: string, text: string) -> Result[unit, IoError] =
  syslAppendText(file, text).mapErr(failed("append to", file))

// Makes `file` hold exactly `bytes`, creating it if it does not exist and replacing what it held if
// it does. With `createParents`, the directories above `file` that are missing are made first.
writeBytes(file: string, bytes: Array[byte], createParents: bool = false) -> Result[unit, IoError]
  if createParents then makeParents(file)?
  syslWriteBytes(file, bytes).mapErr(failed("write", file))

// Adds `bytes` to the end of `file`, creating it if it does not exist.
appendBytes(file: string, bytes: Array[byte]) -> Result[unit, IoError] =
  syslAppendBytes(file, bytes).mapErr(failed("append to", file))

// Whether anything, file or directory, exists at `file`. A symbolic link is followed, so a dangling
// one answers `false`; with `followLinks = false` the link itself is what is asked about, so a
// dangling one answers `true`.
exists(file: string, followLinks: bool = true) -> bool =
  if followLinks then syslExists(file) else syslLinkStat(file).isOk

// Whether `file` names a directory, one the program may not read included. A symbolic link is
// followed.
isDir(file: string) -> bool = syslStat(file) match
  Ok(m) -> m.isDir()
  Err(_) -> false

// Whether `file` names a regular file: not a directory, and not a FIFO, a socket or a device either.
// A symbolic link is followed.
isFile(file: string) -> bool = syslStat(file) match
  Ok(m) -> m.isFile()
  Err(_) -> false

@sysl("sysl.fs.readable")
private syslReadable(file: string) -> bool

@sysl("sysl.fs.writable")
private syslWritable(file: string) -> bool

// Whether the user who started the program may read `file`, as its permission bits, owner and group
// say: a file that is not there answers `false`. A symbolic link is followed. The superuser may read
// any file, so the answer is `true` for one whatever its bits. The answer can be stale by the time
// the file is opened; opening it is the check that counts.
isReadable(file: string) -> bool = syslReadable(file)

// Whether the user who started the program may write `file`, as `isReadable` asks about reading.
isWritable(file: string) -> bool = syslWritable(file)

// Whether `a` and `b` name the same file, whatever path leads there: two hard links to one file, or
// a symbolic link and what it names, are the same; two files with equal contents are not. Both
// paths are followed and must exist; a missing one is `NotFound`.
isSameFile(a: string, b: string) -> Result[bool, IoError]
  val first = metadata(a)?
  val second = metadata(b)?
  Ok(first.inode == second.inode && first.device == second.device)

// Removes the file `file`. A directory is not removed: that is `removeDir`, and `remove` answers
// `IsADirectory` on every platform, whatever the platform's own refusal says. A link to a directory
// is a file here, and is removed.
remove(file: string) -> Result[unit, IoError] =
  syslRemoveFile(file).mapErr(e ->
    if isDir(file) then IoError(io.IsADirectory, "remove", file) else failed("remove", file)(e))

// Removes the empty directory `dir`.
removeDir(dir: string) -> Result[unit, IoError] = syslRemoveDir(dir).mapErr(failed("remove directory", dir))

// Removes `dir` and everything in it. A symbolic link inside is removed, never followed.
removeDirAll(dir: string) -> Result[unit, IoError] =
  syslRemoveDirAll(dir).mapErr(failed("remove directory", dir))

// Removes whatever is at `path`: a file, a symbolic link, or a directory with everything in it. A
// link is removed and never followed, so a link to a directory deletes the link and leaves the
// directory and its contents. A path that is not there is `NotFound`; `removeIfExists` is the call
// that accepts that.
removeAll(path: string) -> Result[unit, IoError] = syslRemoveFile(path) match
  Ok(_) -> Ok(())
  Err(e) -> if isDir(path) then removeDirAll(path) else Err(failed("remove", path)(e))

// As `removeAll`, but a path that is not there is success: `Ok(true)` when something was removed,
// `Ok(false)` when nothing was there. A dangling link is something and is removed. Any other failure
// is the `Err`.
removeIfExists(path: string) -> Result[bool, IoError] = removeAll(path) match
  Ok(_) -> Ok(true)
  Err(e) -> e.kind match
    io.NotFound -> Ok(false)
    _ -> Err(e)

// Moves `from` to `to`, a file or a directory, in one step: a reader sees the old `to` or the new
// one, never a mixture. A file already at `to` is replaced; an empty directory at `to` is replaced
// by a directory; a directory that holds entries is `DirectoryNotEmpty`. The directory that is to
// hold `to` must exist, and both names must be on one file system, or the call fails and moves
// nothing. Renaming a name to itself changes nothing and succeeds.
rename(from: string, to: string) -> Result[unit, IoError] =
  syslRename(from, to).mapErr(failed("rename", s"$from to $to"))

// Makes the directory `dir`, whose parent must exist; `AlreadyExists` if something is there.
createDir(dir: string) -> Result[unit, IoError] = syslMakeDir(dir).mapErr(failed("create directory", dir))

// Makes the directory `dir` and every missing directory above it. A directory already there is no
// error; a file in the way is.
createDirAll(dir: string) -> Result[unit, IoError] = syslMakeDirAll(dir).mapErr(failed("create directory", dir))

// Makes a new, empty directory in the platform's place for temporary files, its name starting with
// `prefix`, and answers its path. No other call makes the same directory; the program removes it
// when it is done.
createTempDir(prefix: string) -> Result[string, IoError] =
  syslMakeTempDir(prefix).mapErr(failed("create temporary directory", prefix))

// A new, empty directory made as `createTempDir` makes one, held as a resource: `close()` removes it
// and everything in it, so `defer dir.close()` removes it on every way out of the block.
tempDir(prefix: string) -> Result[TempDir, IoError] = createTempDir(prefix).map(p -> TempDir(p, false))

// A temporary directory that `close()` removes with everything in it. Closing it again does nothing
// and answers `Ok`; one never closed stays on the disk.
class TempDir(private val dir: string, private var removed: bool): io.Close
  // The directory's path.
  path -> string = dir

  // Whether `close` has removed it.
  isClosed -> bool = removed

  // Removes the directory and everything in it; `Err` where that failed, which leaves it to be
  // removed again by a later `close`.
  override close() -> Result[unit, IoError]
    if removed then return Ok(())
    removeDirAll(dir)?
    removed = true
    Ok(())

// One reading of a path, as the runtime makes it.
@sysl("avin.rt.FsStat")
private class SyslStat
  sizeBytes() -> long
  modifiedMicros() -> long
  isDir() -> bool
  isFile() -> bool
  permissionBits() -> int
  kindBits() -> int
  accessedMicros() -> long
  changedMicros() -> long
  ownerId() -> long
  groupId() -> long
  linkCount() -> long
  inodeNumber() -> long
  deviceNumber() -> long

@sysl("avin.rt.fs_stat")
private syslStat(file: string) -> Result[SyslStat, SyslError]

@sysl("avin.rt.fs_link_stat")
private syslLinkStat(file: string) -> Result[SyslStat, SyslError]

@sysl("avin.rt.fs_set_modified")
private syslSetModified(file: string, micros: long) -> Result[unit, SyslError]

@sysl("avin.rt.fs_set_permissions")
private syslSetPermissions(file: string, mode: int) -> Result[unit, SyslError]

@sysl("avin.rt.fs_set_owner")
private syslSetOwner(file: string, owner: long, group: long) -> Result[unit, SyslError]

// What a path names, beside what is in it.
data FileKind
  // A file holding bytes: what `isFile` asks about.
  Regular
  Directory
  // A symbolic link itself, which only `linkMetadata` reports; `metadata` follows it.
  Symlink
  // A named pipe.
  Fifo
  // A Unix-domain socket bound to a path.
  Socket
  // A device read and written a character at a time, such as `/dev/null`.
  CharDevice
  // A device read and written in blocks, such as a disk.
  BlockDevice
  // A kind of entry the platform has beyond these, with the type bits `stat` reported for it.
  UnknownKind(bits: int)

// The kind the type bits of a mode name.
private fileKindOf(bits: int) -> FileKind
fileKindOf(0o100000) = Regular
fileKindOf(0o040000) = Directory
fileKindOf(0o120000) = Symlink
fileKindOf(0o010000) = Fifo
fileKindOf(0o140000) = Socket
fileKindOf(0o020000) = CharDevice
fileKindOf(0o060000) = BlockDevice
fileKindOf(bits) = UnknownKind(bits)

// What one look at a path found. `size` is in bytes; for a directory it is the file system's own
// bookkeeping, not a count of entries. `modified` is when the contents last changed, `accessed` when
// they were last read, and `changed` when the entry itself last changed, which a change of
// permissions or owner moves too and no ordinary call can set back. `isDir` and `isFile` say whether
// it is a directory and a regular file, and `kind` says which of every kind it is. `permissions` is
// the twelve low bits of the mode: the nine `rwx` bits (`0o644`) with setuid `0o4000`, setgid
// `0o2000` and the sticky bit `0o1000`; never the file type. `owner` and `group` are the numeric user
// and group ids (`process.userName(owner)` names the user). `links` counts the names that lead to
// the file: more than one means a hard link. `inode` and `device` together identify the file on this
// machine, which is what `isSameFile` compares; neither does on its own.
data Metadata(
    size: long,
    modified: Instant,
    isDir: bool,
    isFile: bool,
    permissions: int,
    kind: FileKind,
    accessed: Instant,
    changed: Instant,
    owner: long,
    group: long,
    links: long,
    inode: long,
    device: long
)

impl Metadata
  // Whether it is a symbolic link, which only a `linkMetadata` reading can be.
  isLink -> bool = kind match
    Symlink -> true
    _ -> false

private metadataOf(s: SyslStat) -> Metadata =
  Metadata(
    s.sizeBytes(),
    epochMicros(s.modifiedMicros()),
    s.isDir(),
    s.isFile(),
    s.permissionBits(),
    fileKindOf(s.kindBits()),
    epochMicros(s.accessedMicros()),
    epochMicros(s.changedMicros()),
    s.ownerId(),
    s.groupId(),
    s.linkCount(),
    s.inodeNumber(),
    s.deviceNumber()
  )

// Everything `Metadata` holds, read at once so the fields describe one entry. A symbolic link is
// followed, so a dangling one is `NotFound`. A path that is not there is `NotFound`.
metadata(file: string) -> Result[Metadata, IoError] = syslStat(file).map(metadataOf).mapErr(
  failed("read metadata of", file)
)

// `metadata` of the entry `file` itself: a symbolic link is described rather than followed, so its
// `kind` is `Symlink`, its `size` the length of the path it holds, and a dangling one answers `Ok`.
// Anything else answers as `metadata` does.
linkMetadata(file: string) -> Result[Metadata, IoError] =
  syslLinkStat(file).map(metadataOf).mapErr(failed("read metadata of", file))

// The permission bits of `file`, a file or a directory, as `Metadata.permissions` holds them:
// `0o600` for one only its owner may read and write. A symbolic link is followed.
permissions(file: string) -> Result[int, IoError] = metadata(file).map(m -> m.permissions)

// Sets the permission bits of `file`, a file or a directory, to exactly `mode`: it is not a mask
// added to what is there, so `0o600` takes every bit for the group and others away. The process
// umask plays no part. `mode` is `0o0` to `0o7777`; setuid, setgid and the sticky bit are allowed
// where the platform allows them, and anything outside that range is an `Err` that leaves the file
// as it was. A symbolic link is followed. A path that is not there is `NotFound`.
setPermissions(file: string, mode: int) -> Result[unit, IoError]
  checkMode(mode, "set permissions of", file)?
  syslSetPermissions(file, mode).mapErr(failed("set permissions of", file))

// `Ok` for a mode of `0o0` to `0o7777`; any other is the `Err` of kind `Other` naming it in octal,
// `operation` on `subject` being what it would have done.
private checkMode(mode: int, operation: string, subject: string) -> Result[unit, IoError] =
  if 0 <= mode <= 0o7777 then Ok(()) else Err(
    IoError(io.Other(s"a mode outside 0o0 to 0o7777: ${octal(mode)}"), operation, subject)
  )

// `mode` as an octal literal reads, its sign before the prefix.
private octal(mode: int) -> string
octal(mode < 0) = f"-0o${-long(mode)}%o"
octal(mode) = f"0o${mode}%o"

// Sets the owner and the group of `file`, a file or a directory, to the numeric ids `owner` and
// `group`: the two numbers `Metadata.owner` and `Metadata.group` read back. Both are set, so a call
// changing only one passes the other as `metadata` reports it. Giving a file away is privileged: a
// program not acting as the superuser is refused with `PermissionDenied`, though it may name its
// own ids (`process.userId()`, `process.groupId()`) where it belongs to that group. Ids are `0` to
// `0xffffffff`; anything outside is an `Err` of kind `Other` that leaves the file as it was. A
// symbolic link is followed. A path that is not there is `NotFound`.
setOwner(file: string, owner: long, group: long) -> Result[unit, IoError]
  if !(0 <= owner <= 0xffff_ffff)
    return Err(IoError(io.Other(s"an owner id outside 0 to 4294967295: $owner"), "set owner of", file))
  if !(0 <= group <= 0xffff_ffff)
    return Err(IoError(io.Other(s"a group id outside 0 to 4294967295: $group"), "set owner of", file))
  syslSetOwner(file, owner, group).mapErr(failed("set owner of", file))

// The name the system's user database gives the owner of `file`, as `process.userName` reads it:
// an owner with no entry is `Err(NotFound)` naming that user. A symbolic link is followed. Group
// names are not offered.
ownerName(file: string) -> Result[string, IoError]
  val m = metadata(file)?
  process.userName(m.owner)

// The size of the file `file` in bytes. A symbolic link is followed.
size(file: string) -> Result[long, IoError] = metadata(file).map(m -> m.size)

// When the contents of `file`, a file or a directory, last changed, to the resolution the file
// system keeps. A symbolic link is followed.
modified(file: string) -> Result[Instant, IoError] = metadata(file).map(m -> m.modified)

// Sets the modification time of `file`, a file or a directory, to `when`; its access time moves
// with it. A symbolic link is followed. Reading it back may round `when` to the file system's
// resolution. A path that is not there is `NotFound`.
setModified(file: string, when: Instant) -> Result[unit, IoError] =
  syslSetModified(file, when.epochMicros).mapErr(failed("set modification time of", file))

// Who an open file belongs to: a Sysl handle holding nothing else, which moves between threads with
// the `File` that holds it and stays after the file is closed, so a closed file checks its owner as
// an open one does. Its traps name the `File`.
@sysl("avin.rt.Token", named: "File")
private class FileOwner
  // Does nothing: calling it checks the file belongs to the code running.
  held() -> unit

@sysl("avin.rt.token")
private newOwner() -> FileOwner

// A file Sysl holds open. It closes when it is closed or, for one the program forgot, when the
// collector frees it.
@sysl("sysl.fs.File")
private class SyslFile
  size() -> Result[long, SyslError]
  tell() -> Result[long, SyslError]
  seek(to: long) -> Result[unit, SyslError]
  @sysl(blocking)
  read(into: Array[byte]) -> Array[byte]
  @sysl(blocking)
  write(bytes: Array[byte])
  failed() -> bool
  @sysl(blocking)
  flush() -> Result[unit, SyslError]
  @sysl(blocking)
  sync() -> Result[unit, SyslError]
  @sysl("sync_data", blocking)
  syncData() -> Result[unit, SyslError]
  @sysl("full_sync", blocking)
  fullSync() -> Result[unit, SyslError]
  @sysl("truncate", blocking)
  setLength(length: long) -> Result[unit, SyslError]
  @sysl("read_at", blocking)
  readAt(offset: long, into: Array[byte]) -> Result[Array[byte], SyslError]
  @sysl("write_at", blocking)
  writeAt(offset: long, bytes: Array[byte]) -> Result[long, SyslError]
  @sysl("close")
  release() -> Result[unit, SyslError]

@sysl("sysl.fs.open", blocking)
private syslOpen(file: string) -> Result[SyslFile, SyslError]

@sysl("avin.rt.fs_create", blocking)
private syslCreate(file: string, mode: int) -> Result[SyslFile, SyslError]

@sysl("sysl.fs.append", blocking)
private syslAppend(file: string) -> Result[SyslFile, SyslError]

@sysl("sysl.fs.open_update", blocking)
private syslOpenUpdate(file: string) -> Result[SyslFile, SyslError]

@sysl("avin.rt.fs_create_update", blocking)
private syslCreateUpdate(file: string, mode: int) -> Result[SyslFile, SyslError]

@sysl("avin.rt.fs_file_set_permissions")
private syslFileSetPermissions(f: SyslFile, mode: int) -> Result[unit, SyslError]

// How much a line or a read-everything call takes from the file at once.
private val ChunkSize = 8192

// The text of the bytes `from` up to `until`, a `\r` at the end dropped, bytes that are not UTF-8
// becoming U+FFFD.
private lineText(bytes: Array[byte], from: int, until: int) -> string
  val stop = if until > from && bytes(until - 1) == byte(13) then until - 1 else until
  string.fromUtf8Lossy(bytes.slice(from, stop))

// A file held open, made by `open`, `create`, `append`, `openUpdate` or `createUpdate`. Reading and
// writing go on from one position, which `seek` moves and `position` tells; a file opened to append
// writes at its end whatever the position. Reading takes up where the last read stopped, and a file
// that has grown since a read reached its end gives the new bytes to the next read, so a program can
// follow a file another writes. A file belongs to one thread at a time, at first the one that opened
// it, and moves as a connection does: to a thread or a future whose body reaches it, with a message
// sent to an actor or on a channel, and to whichever thread holds the mutex that keeps it. Every call
// first checks that the code running owns it, so the code that handed it over traps where it uses it
// again. It is closed by `close` or, if the program forgot, when the collector frees it; every call
// on a closed file is an `Err`. It is an `io.Reader` by its `read`, and an `io.ByteWriter` by its
// `write`.
@trusted_sendable(
  "it belongs to one thread at a time: handing it over moves its handles, and every call first checks its owner, so the code that handed it over traps"
)
class File(
    private val name: string,
    private val handle: SyslFile,
    private val readable: bool,
    private val writable: bool,
    private var ahead: Array[byte],
    private var at: int,
    private var closed: bool
): Sendable, io.Reader, io.ByteWriter, io.Close
  private val owner = newOwner()

  // How many bytes the file holds now, what other handles have written included.
  size() -> Result[long, IoError]
    mine()
    if closed then return Err(closedError("read the size of"))
    handle.size().mapErr(failed("read the size of", name))

  // Where the next read or write happens, in bytes from the start of the file.
  position() -> Result[long, IoError]
    mine()
    if closed then return Err(closedError("read the position in"))
    val sysl = handle.tell().mapErr(failed("read the position in", name))?
    Ok(sysl - long(ahead.length - at))

  // Moves to `offset` bytes from the start. Past the end is allowed: a read there finds the end
  // and a write leaves a gap of zero bytes. A negative offset is an `Err`.
  seek(offset: long) -> Result[unit, IoError]
    mine()
    if closed then return Err(closedError("seek in"))
    if offset < 0 then return Err(IoError(io.Other(s"a negative offset: $offset"), "seek in", name))
    ahead = Array.empty[byte]()
    at = 0
    handle.seek(offset).mapErr(failed("seek in", name))

  // Moves to the end of the file as it is now, so the next read waits for what is written after.
  seekToEnd() -> Result[unit, IoError]
    seek(size()?)

  // Up to `max` bytes from the position, fewer only where the file ends first; empty at the end.
  // A `max` below zero traps.
  override read(max: int) -> Result[Array[byte], IoError]
    mine()
    if closed then return Err(closedError("read"))
    if !readable then return Err(notReadable)
    if max < 0 then fail(s"a read of $max bytes: a read takes none or more")
    if max == 0 then return Ok(Array.empty[byte]())
    if at < ahead.length
      val end = if ahead.length - at > max then at + max else ahead.length
      val taken = ahead.slice(at, end)
      at = end
      return Ok(taken)
    pull(max)

  // Everything from the position to the end of the file as it is while the read runs.
  readAll() -> Result[Array[byte], IoError]
    mine()
    if closed then return Err(closedError("read"))
    if !readable then return Err(notReadable)
    val all = Buffer[byte]()
    for k in at ..< ahead.length
      all.addOne(ahead(k))
    ahead = Array.empty[byte]()
    at = 0
    while true
      val more = pull(65536)?
      if more.length == 0 then return Ok(all.toArray())
      all.addAll(more)
    Ok(all.toArray())

  // Everything from the position to the end as text; `InvalidUtf8` where it is not UTF-8, the
  // offset counted from the position the read started at.
  readText() -> Result[string, IoError]
    val bytes = readAll()?
    string.fromUtf8(bytes) match
      Ok(text) -> Ok(text)
      Err(e) -> Err(IoError(io.InvalidUtf8(e.offset), "read", name))

  // The next line without its terminator, or `None` at the end of the file. A line ends at `\n`,
  // a `\r` before it going too; the last line needs no terminator, and a file another program is
  // still writing may give half of it. Bytes that are not UTF-8 become U+FFFD.
  readLine() -> Result[Option[string], IoError] = nextLine(false)

  // As `readLine`, but only a line that ends at `\n`: the bytes after the last one are left
  // unread, and a later call finds the line whole once its end is written. This is the call to
  // follow a log with.
  readCompleteLine() -> Result[Option[string], IoError] = nextLine(true)

  // Writes all of `bytes` at the position.
  override write(bytes: Array[byte]) -> Result[unit, IoError]
    mine()
    if closed then return Err(closedError("write"))
    if !writable then return Err(IoError(io.Other("the file is not open for writing"), "write", name))
    unread()?
    handle.write(bytes)
    if handle.failed() then Err(IoError(io.Other("the write failed"), "write", name)) else Ok(())

  // Writes `text` as UTF-8.
  writeText(text: string) -> Result[unit, IoError]
    write(Array.tabulate(text.byteLength, i -> text.byteAt(i)))

  // Hands what has been written to the platform, so another handle or program reading the file
  // sees it. A failure that only now shows, a full disk, is the `Err`.
  flush() -> Result[unit, IoError]
    mine()
    if closed then return Err(closedError("flush"))
    handle.flush().mapErr(failed("flush", name))

  // Up to `max` bytes starting `offset` bytes from the start of the file, without moving the
  // position: reads and writes go on from where they were. Fewer bytes come back only where the file
  // ends first, and none at or past its end. What this handle has written is handed over first, so
  // the bytes read include it. An offset or a `max` below zero is an `Err`.
  readAt(offset: long, max: int) -> Result[Array[byte], IoError]
    mine()
    if closed then return Err(closedError("read"))
    if !readable then return Err(notReadable)
    if offset < 0 then return Err(IoError(io.Other(s"a negative offset: $offset"), "read", name))
    if max < 0 then return Err(IoError(io.Other(s"a read of $max bytes: a read takes none or more"), "read", name))
    val got = Buffer[byte]()
    while got.length < max
      val part = handle.readAt(
        offset + long(got.length),
        Array.fill(max - got.length, byte(0))
      ).mapErr(failed("read", name))?
      if part.length == 0 then break
      got.addAll(part)
    Ok(got.toArray())

  // Writes all of `bytes` starting `offset` bytes from the start of the file, without moving the
  // position. An offset past the end extends the file, the gap reading as zero bytes. A handle opened
  // to append may put the bytes at the end whatever the offset, as the platform decides. An offset
  // below zero is an `Err`.
  writeAt(offset: long, bytes: Array[byte]) -> Result[unit, IoError]
    mine()
    if closed then return Err(closedError("write"))
    if !writable then return Err(IoError(io.Other("the file is not open for writing"), "write", name))
    if offset < 0 then return Err(IoError(io.Other(s"a negative offset: $offset"), "write", name))
    unread()?
    var done = 0
    while done < bytes.length
      val put = handle.writeAt(offset + long(done), bytes.slice(done, bytes.length)).mapErr(failed("write", name))?
      done += int(put)
    Ok(())

  // Sets the length of the file to `length` bytes: a shorter file loses its end, a longer one gains
  // zero bytes. The position does not move, and may then lie past the end. What was written is handed
  // over first. A length below zero is an `Err`, and so is a file not open for writing.
  setLength(length: long) -> Result[unit, IoError]
    mine()
    if closed then return Err(closedError("set the length of"))
    if !writable then return Err(IoError(io.Other("the file is not open for writing"), "set the length of", name))
    if length < 0 then return Err(IoError(io.Other(s"a negative length: $length"), "set the length of", name))
    unread()?
    handle.setLength(length).mapErr(failed("set the length of", name))

  // The same as `setLength`.
  truncate(length: long) -> Result[unit, IoError] = setLength(length)

  // Hands what has been written to the platform and asks the device to keep it, the contents and the
  // file's own details such as its length, returning once it has.
  sync() -> Result[unit, IoError]
    mine()
    if closed then return Err(closedError("sync"))
    handle.sync().mapErr(failed("sync", name))

  // As `sync`, without the details a reader of the contents does not need, such as the modification
  // time, where the platform can skip them. On macOS there is nothing cheaper and it is `sync`, which
  // reaches the drive but not the drive's own write cache.
  syncData() -> Result[unit, IoError]
    mine()
    if closed then return Err(closedError("sync"))
    handle.syncData().mapErr(failed("sync", name))

  // The strongest durability the platform offers: as `sync`, and the drive's own write cache is
  // emptied too (`F_FULLFSYNC` on macOS). The slowest of the three.
  fullSync() -> Result[unit, IoError]
    mine()
    if closed then return Err(closedError("sync"))
    handle.fullSync().mapErr(failed("sync", name))

  // Makes `close` remove the file from its directory as well, for a scratch file that should not
  // outlive its use. The name is removed, so a program that renamed the file away should not ask for
  // this. A file the collector frees without a `close` is not removed.
  deleteOnClose() -> Result[unit, IoError]
    mine()
    if closed then return Err(closedError("mark for removal"))
    removeOnClose = true
    Ok(())

  // Sets the permission bits of the file this handle holds to exactly `mode`, as `fs.setPermissions`
  // sets them on a path, whatever name the file has now; a file opened only to read may be changed
  // too, as its owner may change any file. A mode outside `0o0` to `0o7777` is an `Err` that changes
  // nothing, and a closed file is an `Err`.
  setPermissions(mode: int) -> Result[unit, IoError]
    if closed then return Err(closedError("set permissions of"))
    checkMode(mode, "set permissions of", name)?
    syslFileSetPermissions(handle, mode).mapErr(failed("set permissions of", name))

  // Flushes and releases the file; closing a closed file is not an error. Every later call
  // answers an `Err`. A file marked by `deleteOnClose` is removed once released, and a failure to
  // remove it is the `Err` where releasing succeeded.
  override close() -> Result[unit, IoError]
    mine()
    if closed then return Ok(())
    closed = true
    ahead = Array.empty[byte]()
    at = 0
    val released = handle.release().mapErr(failed("close", name))
    if removeOnClose
      val removed = remove(name)
      if released.isOk then return removed
    released

  private var removeOnClose = false

  // Whether `close` has been called.
  isClosed() -> bool
    mine()
    closed

  // Stops the program where the file belongs to another thread, before anything else is read.
  private mine() = owner.held()

  // What a call on the closed file answers, `operation` being what it was to do.
  private closedError(operation: string) -> IoError = IoError(io.Other("the file is closed"), operation, name)

  private notReadable -> IoError = IoError(io.Other("the file is not open for reading"), "read", name)

  // Up to `max` bytes from the file itself.
  private pull(max: int) -> Result[Array[byte], IoError]
    val got = handle.read(Array.fill(max, byte(0)))
    if got.length == 0 && handle.failed() then Err(IoError(io.Other("the read failed"), "read", name)) else Ok(got)

  // Gives back what was read ahead and not handed out, so the file's own position is the
  // logical one, which a write needs.
  private unread() -> Result[unit, IoError]
    val left = ahead.length - at
    if left > 0
      val sysl = handle.tell().mapErr(failed("write", name))?
      handle.seek(sysl - long(left)).mapErr(failed("write", name))?
    ahead = Array.empty[byte]()
    at = 0
    Ok(())

  // Reads one more chunk after what is unread; false at the end of the file.
  private fill() -> Result[bool, IoError]
    val more = pull(ChunkSize)?
    if more.length == 0 then return Ok(false)
    val all = Buffer[byte]()
    for k in at ..< ahead.length
      all.addOne(ahead(k))
    all.addAll(more)
    ahead = all.toArray()
    at = 0
    Ok(true)

  private nextLine(terminated: bool) -> Result[Option[string], IoError]
    mine()
    if closed then return Err(closedError("read"))
    if !readable then return Err(notReadable)
    var scanned = 0
    while true
      var i = at + scanned
      while i < ahead.length && ahead(i) != byte(10)
        i += 1
      if i < ahead.length
        val text = lineText(ahead, at, i)
        at = i + 1
        return Ok(Some(text))
      scanned = ahead.length - at
      val more = fill()?
      if !more
        if terminated || scanned == 0 then return Ok(None)
        val text = lineText(ahead, at, ahead.length)
        at = ahead.length
        return Ok(Some(text))
    Ok(None)

// Opens the existing file `file` for reading, at its start. A directory is `IsADirectory`.
open(file: string) -> Result[File, IoError]
  if isDir(file) then return Err(IoError(io.IsADirectory, "open", file))
  syslOpen(file).mapErr(failed("open", file)).map(h -> File(file, h, true, false, Array.empty[byte](), 0, false))

// Opens `file` for writing, making it if it is not there and emptying it if it is. A file it makes
// has the permission bits `mode` from the moment it exists, narrowed by the process umask as every
// new file is; a file already there keeps the mode it has. A mode outside `0o0` to `0o7777` is an
// `Err` of kind `Other`, before the path is touched.
create(file: string, mode: int = 0o666) -> Result[File, IoError]
  checkMode(mode, "create", file)?
  syslCreate(file, mode).mapErr(failed("create", file)).map(
    h -> File(file, h, false, true, Array.empty[byte](), 0, false)
  )

// Opens `file` for writing at its end, making it if it is not there. Every write goes to the end,
// however many handles append to the file at once.
append(file: string) -> Result[File, IoError]
  syslAppend(file).mapErr(failed("open", file)).map(h -> File(file, h, false, true, Array.empty[byte](), 0, false))

// Opens the existing file `file` for reading and writing, at its start, keeping what it holds.
openUpdate(file: string) -> Result[File, IoError]
  if isDir(file) then return Err(IoError(io.IsADirectory, "open", file))
  syslOpenUpdate(file).mapErr(failed("open", file)).map(h -> File(file, h, true, true, Array.empty[byte](), 0, false))

// Opens `file` for reading and writing, making it if it is not there and emptying it if it is. A file
// it makes has the permission bits `mode`, as `create` makes one.
createUpdate(file: string, mode: int = 0o666) -> Result[File, IoError]
  checkMode(mode, "create", file)?
  syslCreateUpdate(file, mode).mapErr(failed("create", file)).map(
    h -> File(file, h, true, true, Array.empty[byte](), 0, false)
  )

// Every byte of `file` from `offset` on, empty where the file is no longer than `offset`: what has
// been appended since a program last read to `offset`. A negative `offset` traps.
readBytesFrom(file: string, offset: long) -> Result[Array[byte], IoError]
  if offset < 0 then fail(s"a read from offset $offset: an offset is not negative")
  val f = open(file)?
  defer f.close()
  f.seek(offset)?
  f.readAll()

// The last `maxBytes` bytes of `file` as text, read without reading the rest. A start in the middle
// of a character skips the rest of that character, so the text begins at a whole one; bytes that are
// not UTF-8 elsewhere become U+FFFD. A `maxBytes` below zero traps.
readTail(file: string, maxBytes: long) -> Result[string, IoError]
  if maxBytes < 0 then fail(s"a tail of $maxBytes bytes: a tail takes none or more")
  val f = open(file)?
  defer f.close()
  val size = f.size()?
  val from = if size > maxBytes then size - maxBytes else long(0)
  f.seek(from)?
  val bytes = f.readAll()?
  var k = 0
  if from > 0
    while k < bytes.length && (int(bytes(k)) & 0xc0) == 0x80
      k += 1
  Ok(string.fromUtf8Lossy(bytes.slice(k, bytes.length)))

// The last `count` lines of `file`, fewer where it has fewer, without their terminators, read from
// the end without reading the rest. A file's final `\n` ends its last line rather than starting an
// empty one. A `count` below zero traps.
readTailLines(file: string, count: int) -> Result[Vector[string], IoError]
  if count < 0 then fail(s"a tail of $count lines: a tail takes none or more")
  if count == 0 then return Ok(Vector.empty[string]())
  val f = open(file)?
  defer f.close()
  val size = f.size()?
  // Walk back a block at a time until the region holds `count` newlines, not counting one that
  // ends the file: dropping the first, partial line then leaves `count` whole ones.
  var from = size
  var newlines = 0
  while from > 0 && newlines < count
    val block = if from > long(ChunkSize) then ChunkSize else int(from)
    from -= long(block)
    f.seek(from)?
    val got = f.read(block)?
    for k in 0 ..< got.length
      if got(k) == byte(10) && from + long(k) < size - 1 then newlines += 1
  f.seek(from)?
  val bytes = f.readAll()?
  val lines = Buffer[string]()
  var start = 0
  var first = from > 0
  for k in 0 ..< bytes.length
    if bytes(k) == byte(10)
      if first then first = false else lines.addOne(lineText(bytes, start, k))
      start = k + 1
  if start < bytes.length && !first then lines.addOne(lineText(bytes, start, bytes.length))
  val all = lines.toVector
  Ok(if all.length > count then all.slice(all.length - count, all.length) else all)

// Every line of `file` in a vector, each without its terminator: a line ends at `\n` or `\r\n`, the
// last line needs no terminator, and a final terminator ends the last line rather than starting an
// empty one, so an empty file has no lines. Bytes that are not UTF-8 become U+FFFD. The whole file
// is held in memory; `lines` reads it a line at a time.
readLines(file: string) -> Result[Vector[string], IoError]
  val reader = lines(file)?
  val all = Buffer[string]()
  while reader.hasNext()
    all.addOne(reader.next()?)
  Ok(all.toVector)

// The lines of `file` as they are read: an iterator of each line, or the `Err` that stopped the
// reading, after which it has no more. Lines are split as `readLines` splits them. Only the line
// being read is held in memory. The file is closed when the iterator has given its last line or its
// `Err`; a program that stops early closes it with `close()` (`defer reader.close()`), and one that
// forgets leaves it to the collector.
lines(file: string) -> Result[Lines, IoError] = open(file).map(f -> Lines(f, None, false))

// The iterator `lines` answers, which is also an `io.Close`: closing it closes the file under it.
class Lines(
    private val source: File,
    private var held: Option[Result[string, IoError]],
    private var finished: bool
): Iterator[Result[string, IoError]], io.Close
  override hasNext() -> bool
    if held.isDefined then return true
    if finished then return false
    source.readLine() match
      Ok(Some(line)) -> held = Some(Ok(line))
      Ok(None) ->
        finished = true
        _ = source.close()
      Err(e) ->
        finished = true
        held = Some(Err(e))
        _ = source.close()
    held.isDefined

  override next() -> Result[string, IoError]
    hasNext()
    held match
      Some(x) ->
        held = None
        x
      None -> fail("next on an exhausted iterator")

  // Closes the file; the iterator has no more lines afterwards. Closing again does nothing.
  override close() -> Result[unit, IoError]
    finished = true
    held = None
    source.close()

// Writes each of `lines` to `file` followed by `\n`, so a file of three lines ends in a newline and
// no list of lines is written with `\r\n`. The file is made or emptied first, and what was written
// before a failure stays. With `createParents`, missing directories above `file` are made first. A
// file it makes has the permission bits `mode`, as `create` makes one; a file already there keeps
// its mode.
writeLines(
    file: string,
    lines: Iterable[string],
    createParents: bool = false,
    mode: int = 0o666
) -> Result[unit, IoError]
  checkMode(mode, "create", file)?
  if createParents then makeParents(file)?
  val out = create(file, mode)?
  val it = lines.iterator()
  while it.hasNext()
    val wrote = out.writeText(it.next() + "\n")
    if wrote.isErr
      _ = out.close()
      return wrote
  out.close()

// As `writeText`, but a reader of `file` sees all of the old contents or all of the new, never a mix,
// and a failure leaves `file` as it was. The text is written to a new file beside `file` (so on its
// file system), synced to the device, and renamed over `file`; the new file has a name no other
// call or program gets, and is removed on every failure. `file`'s directory must exist unless
// `createParents`. The result keeps the permission bits of the file it replaces; where there was none
// it has the bits `mode`, which the umask narrows as it does for `create`. The new file has its final
// bits from the moment it exists, so a file kept at `0o600` is never readable by others on the way.
// After the rename the directory is synced too, so the new name survives a crash; a failure there
// is an `Err` with the new contents already in place. A mode outside `0o0` to `0o7777` is an `Err` of
// kind `Other`, before anything is touched.
writeTextAtomic(
    file: string,
    text: string,
    createParents: bool = false,
    mode: int = 0o666
) -> Result[unit, IoError] =
  writeBytesAtomic(file, Array.tabulate(text.byteLength, i -> text.byteAt(i)), createParents, mode)

// As `writeTextAtomic`, with bytes.
writeBytesAtomic(
    file: string,
    bytes: Array[byte],
    createParents: bool = false,
    mode: int = 0o666
) -> Result[unit, IoError]
  checkMode(mode, "write", file)?
  if createParents then makeParents(file)?
  val kept = permissionsIfThere(file)?
  val pending = syslPendingName(file)
  val h = syslCreate(pending, kept.getOrElse(mode)).mapErr(failed("write", file))?
  val outcome = fillPending(h, bytes, kept, file)
  val closed = h.release().mapErr(failed("write", file))
  val result = outcome match
    Ok(_) -> closed
    Err(e) -> Err(e)
  result match
    Ok(_) ->
      syslPublishFile(pending, file).mapErr(failed("write", file))?
      syncParent(file)
    Err(e) ->
      _ = syslRemoveFile(pending)
      Err(e)

// The permission bits of `file`, or `None` where nothing is there; any other failure to look is the
// `Err` of writing it.
private permissionsIfThere(file: string) -> Result[Option[int], IoError] = metadata(file) match
  Ok(m) -> Ok(Some(m.permissions))
  Err(e) -> e.kind match
    io.NotFound -> Ok(None)
    _ -> Err(IoError(e.kind, "write", file))

// Writes `bytes` to the pending file `h`, gives it exactly the bits `kept` of the file it replaces,
// and syncs it to the device. The bits are set after the write and its flush, since a write clears
// setuid and setgid, and the umask may have narrowed the others when the file was made; until then
// the file has fewer bits than it ends with, never more.
private fillPending(h: SyslFile, bytes: Array[byte], kept: Option[int], file: string) -> Result[unit, IoError]
  h.write(bytes)
  if h.failed() then return Err(IoError(io.Other("the write failed"), "write", file))
  h.flush().mapErr(failed("write", file))?
  val fixed = kept match
    Some(bits) -> syslFileSetPermissions(h, bits).mapErr(failed("write", file))
    None -> Ok(())
  if fixed.isErr then return fixed
  h.sync().mapErr(failed("write", file))

// Syncs the directory that holds `file` to the device, so a rename that put `file` there survives a
// crash: the directory is opened to read and synced like a file.
private syncParent(file: string) -> Result[unit, IoError]
  val dir = parent(file) match
    Some(d) -> if d == "" then "." else d
    None -> "."
  val h = syslOpen(dir).mapErr(failed("sync the directory of", file))?
  val synced = h.sync().mapErr(failed("sync the directory of", file))
  val released = h.release().mapErr(failed("sync the directory of", file))
  if synced.isErr then synced else released

// The names of the entries of the directory `dir`, without `dir` before them and without `.` and
// `..`, sorted by code point, so two listings of an unchanged directory agree. A name that is not
// UTF-8 makes the whole listing `InvalidUtf8`.
listDir(dir: string) -> Result[Vector[string], IoError] =
  syslEntries(dir).map(names -> names.sorted).mapErr(failed("list", dir))

@sysl("avin.rt.fs_entry_names", blocking)
private syslEntryNames(dir: string, skip: bool) -> Result[Vector[string], SyslError]

@sysl("sysl.fs.hard_link")
private syslHardLink(existing: string, fresh: string) -> Result[unit, SyslError]

// Makes `fresh` a second name for the file `existing`: afterwards both lead to one file, a change
// through either shows through the other, and `isSameFile` is true of them. `Metadata.links` counts
// the names. `AlreadyExists` when something is at `fresh`; `PermissionDenied`, or an error of kind
// `Other`, for a directory and for a `fresh` on another file system.
hardLink(existing: string, fresh: string) -> Result[unit, IoError] =
  syslHardLink(existing, fresh).mapErr(failed("link", fresh))

// One entry of a directory listing: its `name` in the directory, its `path` (the directory joined
// with the name, so it reads wherever the program is), and its `kind`. The kind is the entry's own,
// as `linkMetadata` reads it: a symbolic link is `Symlink` whatever it points at, so a dangling link
// is listed, and `isDir` is false for a link to a directory.
data DirEntry(name: string, path: string, kind: FileKind)

impl DirEntry
  // Whether it is a directory itself, not a link to one.
  isDir -> bool = kind match
    Directory -> true
    _ -> false
  // Whether it is a regular file itself, not a link to one.
  isFile -> bool = kind match
    Regular -> true
    _ -> false
  // Whether it is a symbolic link, dangling or not.
  isLink -> bool = kind match
    Symlink -> true
    _ -> false

// The entry `name` of `dir`, `None` when it was removed after the directory was read.
private entryOf(dir: string, name: string) -> Result[Option[DirEntry], IoError]
  val full = syslJoin(dir, name)
  syslLinkStat(full) match
    Ok(s) -> Ok(Some(DirEntry(name, full, fileKindOf(s.kindBits()))))
    Err(NotFound) -> Ok(None)
    Err(e) -> Err(failed("read metadata of", full)(e))

// The names of `dir` that a listing keeps, sorted by code point: the ones `pattern` fits, when given.
private listedNames(dir: string, pattern: Option[string], skipInvalid: bool) -> Result[Vector[string], IoError]
  val names = syslEntryNames(dir, skipInvalid).map(ns -> ns.sorted).mapErr(failed("list", dir))?
  pattern match
    Some(p) ->
      val fits = matcher(p)
      Ok(names.filter(n -> fits(n)))
    None -> Ok(names)

// The entries of the directory `dir` with each one's full path and kind, sorted by name by code point
// (as `listDir` sorts), without `.` and `..` and without what is inside a subdirectory. `pattern`,
// when given, keeps the entries whose name fits it, as `matches` reads a pattern (`*.avin`,
// `*.{c,h}`; a name starting with `.` fits only a pattern component starting with a literal `.`).
// A name that is not UTF-8 is `InvalidUtf8` for the whole listing, as in `listDir`, unless
// `skipInvalid` is true, which leaves such names out. An entry removed while the listing was being
// made is left out; any other error reading an entry ends the listing with it.
list(dir: string, pattern: Option[string] = None, skipInvalid: bool = false) -> Result[Vector[DirEntry], IoError]
  val names = listedNames(dir, pattern, skipInvalid)?
  val out = Vector.newBuilder[DirEntry]()
  for name in names
    val found = entryOf(dir, name)?
    found match
      Some(e) -> out.addOne(e)
      None -> ()
  Ok(out.result())

// `list` read as the iterator advances: the names are read from the directory at once, in one pass,
// and each entry's kind is asked for when the iterator reaches it, so taking the first few entries of
// a huge directory asks the file system about those few. The same order, `pattern` and `skipInvalid`
// as `list`. An entry removed before the iterator reaches it is skipped; an error reading one is an
// `Err` element and the iterator goes on to the next.
entries(
    dir: string,
    pattern: Option[string] = None,
    skipInvalid: bool = false
) -> Result[Iterator[Result[DirEntry, IoError]], IoError] =
  listedNames(dir, pattern, skipInvalid).map(names -> EntryIterator(dir, names))

private class EntryIterator(
    private val dir: string,
    private val names: Vector[string]
): Iterator[Result[DirEntry, IoError]]
  private var index = 0
  private var pending: Option[Result[DirEntry, IoError]] = None

  override hasNext() -> bool
    fill()
    pending is Some(_)

  override next() -> Result[DirEntry, IoError]
    fill()
    pending match
      Some(r) ->
        pending = None
        r
      None -> fail("next on an exhausted iterator")

  private fill()
    while pending is None && index < names.length
      val name = names(index)
      index += 1
      entryOf(dir, name) match
        Ok(Some(e)) -> pending = Some(Ok(e))
        Ok(None) -> ()
        Err(e) -> pending = Some(Err(e))
