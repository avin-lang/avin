module avin.fs

// Files and directories: whole files read and written at once, and the directories that hold them.
// Every failure is an `IoError` value, which `?` passes on.

import avin.io
import avin.io.IoError

// Sysl's own error, converted into an `IoError` as each result comes back.
@sysl("sysl.fs.IoError")
private data SyslError
    NotFound
    PermissionDenied
    AlreadyExists
    NotADirectory
    IsADirectory
    DirectoryNotEmpty
    TooManyOpenFiles
    NoSpaceLeft
    Interrupted
    NotOpen
    NotPermitted
    InvalidUtf8(offset: long)
    Other(code: int)

private ioError(e: SyslError) -> IoError = e match
    NotFound -> io.NotFound
    PermissionDenied -> io.PermissionDenied
    AlreadyExists -> io.AlreadyExists
    NotADirectory -> io.NotADirectory
    IsADirectory -> io.IsADirectory
    DirectoryNotEmpty -> io.DirectoryNotEmpty
    InvalidUtf8(at) -> io.InvalidUtf8(at)
    _ -> io.Other(syslMessage(e))

// The platform's own sentence for a Sysl error, as Sysl words it.
@sysl("avin.rt.io_error_message")
private syslMessage(e: SyslError) -> string

@sysl("sysl.fs.read_text")
private syslReadText(file: string) -> Result[string, SyslError]

@sysl("sysl.fs.read_bytes")
private syslReadBytes(file: string) -> Result[Array[byte], SyslError]

@sysl("sysl.fs.write_text")
private syslWriteText(file: string, text: string) -> Result[unit, SyslError]

@sysl("sysl.fs.append_text")
private syslAppendText(file: string, text: string) -> Result[unit, SyslError]

@sysl("sysl.fs.write_bytes")
private syslWriteBytes(file: string, bytes: Array[byte]) -> Result[unit, SyslError]

@sysl("sysl.fs.append_bytes")
private syslAppendBytes(file: string, bytes: Array[byte]) -> Result[unit, SyslError]

@sysl("sysl.fs.exists")
private syslExists(file: string) -> bool

@sysl("sysl.fs.is_dir")
private syslIsDir(file: string) -> bool

@sysl("sysl.fs.is_file")
private syslIsFile(file: string) -> bool

@sysl("sysl.fs.remove_file")
private syslRemoveFile(file: string) -> Result[unit, SyslError]

@sysl("sysl.fs.remove_dir")
private syslRemoveDir(dir: string) -> Result[unit, SyslError]

@sysl("sysl.fs.remove_dir_all")
private syslRemoveDirAll(dir: string) -> Result[unit, SyslError]

@sysl("sysl.fs.make_dir")
private syslMakeDir(dir: string) -> Result[unit, SyslError]

@sysl("sysl.fs.make_dir_all")
private syslMakeDirAll(dir: string) -> Result[unit, SyslError]

@sysl("sysl.fs.make_temp_dir")
private syslMakeTempDir(prefix: string) -> Result[string, SyslError]

@sysl("sysl.fs.entries")
private syslEntries(dir: string) -> Result[Vector[string], SyslError]

// The whole of `file` as text. Bytes that are not UTF-8 are `InvalidUtf8`, at the first one that
// is not.
readText(file: string) -> Result[string, IoError] = syslReadText(file).mapErr(ioError)

// The whole of `file` as bytes, in a new array the caller owns.
readBytes(file: string) -> Result[Array[byte], IoError] = syslReadBytes(file).mapErr(ioError)

// Makes `file` hold exactly `text`, creating it if it does not exist and replacing what it held if
// it does.
writeText(file: string, text: string) -> Result[unit, IoError] = syslWriteText(file, text).mapErr(ioError)

// Adds `text` to the end of `file`, creating it if it does not exist.
appendText(file: string, text: string) -> Result[unit, IoError] = syslAppendText(file, text).mapErr(ioError)

// Makes `file` hold exactly `bytes`, creating it if it does not exist and replacing what it held if
// it does.
writeBytes(file: string, bytes: Array[byte]) -> Result[unit, IoError] =
    syslWriteBytes(file, bytes).mapErr(ioError)

// Adds `bytes` to the end of `file`, creating it if it does not exist.
appendBytes(file: string, bytes: Array[byte]) -> Result[unit, IoError] =
    syslAppendBytes(file, bytes).mapErr(ioError)

// Whether anything, file or directory, exists at `file`. A symbolic link is followed.
exists(file: string) -> bool = syslExists(file)

// Whether `file` names a directory. A symbolic link is followed.
isDir(file: string) -> bool = syslIsDir(file)

// Whether `file` names something that exists and is not a directory. A symbolic link is followed.
isFile(file: string) -> bool = syslIsFile(file)

// Removes the file `file`. A directory is not removed: that is `removeDir`.
remove(file: string) -> Result[unit, IoError] = syslRemoveFile(file).mapErr(ioError)

// Removes the empty directory `dir`.
removeDir(dir: string) -> Result[unit, IoError] = syslRemoveDir(dir).mapErr(ioError)

// Removes `dir` and everything in it. A symbolic link inside is removed, never followed.
removeDirAll(dir: string) -> Result[unit, IoError] = syslRemoveDirAll(dir).mapErr(ioError)

// Makes the directory `dir`, whose parent must exist; `AlreadyExists` if something is there.
createDir(dir: string) -> Result[unit, IoError] = syslMakeDir(dir).mapErr(ioError)

// Makes the directory `dir` and every missing directory above it. A directory already there is no
// error; a file in the way is.
createDirAll(dir: string) -> Result[unit, IoError] = syslMakeDirAll(dir).mapErr(ioError)

// Makes a new, empty directory in the platform's place for temporary files, its name starting with
// `prefix`, and answers its path. No other call makes the same directory; the program removes it
// when it is done.
createTempDir(prefix: string) -> Result[string, IoError] = syslMakeTempDir(prefix).mapErr(ioError)

// The names of the entries of the directory `dir`, without `dir` before them and without `.` and
// `..`, sorted by code point, so two listings of an unchanged directory agree. A name that is not
// UTF-8 makes the whole listing `InvalidUtf8`.
listDir(dir: string) -> Result[Vector[string], IoError] = syslEntries(dir).map(names -> names.sorted()).mapErr(ioError)
