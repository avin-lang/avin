module avin.target

// The machine the program is compiled for: its operating system, `os`, and its processor, `arch`.
// Both are known when the program is compiled, so a branch over them that the machine does not take
// is folded away, at every optimization level, while both branches are still checked on every
// machine. Each value is declared in the file of this module read on the machines it is true of
// (`target.linux.avin`, `target.aarch64.avin`), so every machine sees one of each.
//
//   configDir(home: string) -> string = target.os match
//     MacOS -> s"$home/Library/Application Support/probe"
//     _     -> s"$home/.config/probe"
//
// `avin.process.os()` answers the same operating system at run time.

// A processor Avin builds for.
data Arch
  // 64-bit Arm.
  Aarch64
  // 64-bit Intel and AMD.
  X86_64
