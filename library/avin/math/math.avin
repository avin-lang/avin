module avin.math

// The elementary functions on `real`, and the two constants they are written around. Each follows
// IEEE 754: a NaN argument gives NaN, an argument outside the function's domain gives NaN
// (`sqrt(-1.0)`, `log(-1.0)`, `asin(2.0)`), and a pole gives the infinity its limit approaches
// (`log(0.0)` is negative infinity). Nothing here traps.

// The ratio of a circle's circumference to its diameter, to the nearest `real`.
val Pi: real = 3.141592653589793

// The base of the natural logarithm, to the nearest `real`.
val E: real = 2.718281828459045

// The square root, correctly rounded; `sqrt(-0.0)` is `-0.0`.
@sysl("avin.rt.real_sqrt")
sqrt(x: real) -> real

// The cube root, negative for a negative argument.
@sysl("avin.rt.real_cbrt")
cbrt(x: real) -> real

// `E` raised to `x`.
@sysl("avin.rt.real_exp")
exp(x: real) -> real

// `exp(x) - 1.0`, accurate where `x` is near zero.
@sysl("avin.rt.real_expm1")
expm1(x: real) -> real

// The natural logarithm.
@sysl("avin.rt.real_log")
log(x: real) -> real

// The logarithm to base 10.
@sysl("avin.rt.real_log10")
log10(x: real) -> real

// `log(1.0 + x)`, accurate where `x` is near zero.
@sysl("avin.rt.real_log1p")
log1p(x: real) -> real

// `x` raised to `y`. Anything to the power `0.0` is `1.0`, NaN included; a negative base with an
// exponent that is not a whole number is NaN.
@sysl("avin.rt.real_pow")
pow(x: real, y: real) -> real

// `sqrt(x * x + y * y)` without overflowing or underflowing on the way.
@sysl("avin.rt.real_hypot")
hypot(x: real, y: real) -> real

// The sine of an angle in radians.
@sysl("avin.rt.real_sin")
sin(x: real) -> real

// The cosine of an angle in radians.
@sysl("avin.rt.real_cos")
cos(x: real) -> real

// The tangent of an angle in radians.
@sysl("avin.rt.real_tan")
tan(x: real) -> real

// The angle in radians, from `-Pi / 2` to `Pi / 2`, whose sine is `x`.
@sysl("avin.rt.real_asin")
asin(x: real) -> real

// The angle in radians, from `0.0` to `Pi`, whose cosine is `x`.
@sysl("avin.rt.real_acos")
acos(x: real) -> real

// The angle in radians, from `-Pi / 2` to `Pi / 2`, whose tangent is `x`.
@sysl("avin.rt.real_atan")
atan(x: real) -> real

// The angle in radians, from `-Pi` to `Pi`, of the point `(x, y)`: note `y` comes first.
@sysl("avin.rt.real_atan2")
atan2(y: real, x: real) -> real

@sysl("avin.rt.real_sinh")
sinh(x: real) -> real

@sysl("avin.rt.real_cosh")
cosh(x: real) -> real

@sysl("avin.rt.real_tanh")
tanh(x: real) -> real

// The greatest whole number not above `x`, as a `real`.
@sysl("avin.rt.real_floor")
floor(x: real) -> real

// The least whole number not below `x`, as a `real`.
@sysl("avin.rt.real_ceil")
ceil(x: real) -> real

// The whole number nearest `x`, as a `real`; a tie goes to the even one, so `rint(2.5)` is `2.0`.
@sysl("avin.rt.real_rint")
rint(x: real) -> real

// The whole number nearest `x`, a tie going away from zero, as a `real`: `roundAway(2.5)` is `3.0`
// and `roundAway(-2.5)` is `-3.0`. Infinities, NaN and negative zero come back as they are.
@sysl("avin.rt.real_round")
private roundAway(x: real) -> real

// The whole number nearest `x` as a `long`, a tie going away from zero: `round(2.5)` is `3` and
// `round(-2.5)` is `-3`. It converts as `long(x)` does: NaN is `0`, and a value beyond the range of
// `long`, an infinity included, is the nearest bound.
round(x: real) -> long = long(roundAway(x))

// `x` with its fraction dropped, towards zero, as a `real`: `trunc(-2.7)` is `-2.0`, and `trunc(-0.5)`
// is `-0.0`.
@sysl("avin.rt.real_trunc")
trunc(x: real) -> real

// The logarithm to base 2, exact at every power of two.
@sysl("avin.rt.real_log2")
log2(x: real) -> real

// `x * y + z` as one operation, rounded once. Writing it as `x * y + z` rounds twice: the language
// never fuses by itself, so `fma` is how a program asks for it.
@sysl("avin.rt.real_fma")
fma(x: real, y: real, z: real) -> real

// The magnitude of `x` with the sign of `sign`, a negative zero or NaN's sign bit included.
@sysl("avin.rt.real_copysign")
copySign(x: real, sign: real) -> real

// The gap from `|x|` to the next `real` above it: `ulp(1.0)` is `2.220446049250313e-16`. It is the
// least positive value, `real.MinPositiveValue`, at zero and throughout the subnormals; infinity at
// an infinity and NaN at NaN; and at the greatest finite value the gap below it.
@sysl("avin.rt.real_ulp")
ulp(x: real) -> real

// The least `real` above `x`: `nextUp(0.0)` and `nextUp(-0.0)` are `real.MinPositiveValue`, the
// greatest finite value goes to positive infinity, and positive infinity and NaN stay as they are.
@sysl("avin.rt.real_next_up")
nextUp(x: real) -> real

// The greatest `real` below `x`: the mirror of `nextUp`.
@sysl("avin.rt.real_next_down")
nextDown(x: real) -> real

// The magnitude of `x`; `abs(-0.0)` is `0.0`.
@sysl("avin.rt.real_abs")
abs(x: real) -> real

// Whether the sign bit of `x` is set: true for every negative value, `-0.0`, `-infinity` and a NaN
// carrying the sign.
@sysl("avin.rt.real_sign_bit")
signBit(x: real) -> bool

// The greater of the two; NaN when either is, and `0.0` is greater than `-0.0`.
@sysl("avin.rt.real_max")
max(x: real, y: real) -> real

// The lesser of the two; NaN when either is, and `-0.0` is less than `0.0`.
@sysl("avin.rt.real_min")
min(x: real, y: real) -> real

// `1.0` for a positive `x`, `-1.0` for a negative one, and `x` itself for a zero or NaN.
signum(x: real) -> real = if x > 0.0 then 1.0 else if x < 0.0 then -1.0 else x

// The angle `degrees` in radians.
toRadians(degrees: real) -> real = degrees * 0.017453292519943295

// The angle `radians` in degrees.
toDegrees(radians: real) -> real = radians * 57.29577951308232
