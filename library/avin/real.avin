module avin

impl real
    // Whether it is NaN, the one value that is not equal to itself.
    isNaN -> bool = self != self

    // Whether it is positive or negative infinity.
    isInfinite -> bool = self == real.PositiveInfinity || self == real.NegativeInfinity

    // Whether it is neither NaN nor an infinity.
    isFinite -> bool = self - self == 0.0

    // The number as an `int`, as `int(x)` is: truncated toward zero, the least or greatest `int`
    // beyond them, and zero for NaN.
    toInt -> int = int(self)

    // The number as a `long`, as `long(x)` is: truncated toward zero, the least or greatest `long`
    // beyond them, and zero for NaN.
    toLong -> long = long(self)
