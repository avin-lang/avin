module avin

@sysl("avin.rt.real_to_bits")
private realToBits(x: real) -> long

@sysl("avin.rt.real_from_bits")
private realFromBits(bits: long) -> real

@sysl("avin.rt.real_to_bits32")
private realToBits32(x: real) -> int

@sysl("avin.rt.real_from_bits32")
private realFromBits32(bits: int) -> real

@sysl("avin.rt.real_max")
private realMax(x: real, y: real) -> real

@sysl("avin.rt.real_min")
private realMin(x: real, y: real) -> real

impl real
  // The greater of the number and `other`, as `math.max` finds it: NaN when either is, and `0.0` is
  // greater than `-0.0`.
  max(other: real) -> real = realMax(self, other)

  // The lesser of the number and `other`, as `math.min` finds it: NaN when either is, and `-0.0` is
  // less than `0.0`.
  min(other: real) -> real = realMin(self, other)

  // The number whose IEEE 754 binary64 encoding is `bits`, sign bit highest: every `long` is one
  // `real`, a NaN keeping its payload, so `real.fromBits(x.toBits) == x` for every `x` but NaN, and
  // its bits are the same for every `x`.
  static fromBits(bits: long) -> real = realFromBits(bits)

  // The number whose IEEE 754 binary32 encoding is `bits`, widened to a `real` exactly: a
  // subnormal binary32 is a normal `real`, an infinity stays one, and a NaN keeps its payload in
  // the top bits of a `real`'s.
  static fromBits32(bits: int) -> real = realFromBits32(bits)

  // The IEEE 754 binary64 encoding, sign bit highest, as a `long`: `1.0.toBits` is
  // `0x3FF0000000000000`, `-0.0.toBits` is `long.MinValue`, and a NaN's payload is kept.
  toBits -> long = realToBits(self)

  // The IEEE 754 binary32 encoding of the number rounded to the nearest binary32, ties to even, as
  // an `int`: a magnitude too great for binary32 becomes an infinity, one too small for its least
  // subnormal becomes a zero of the same sign, and a NaN stays a quiet NaN, keeping the top bits of
  // its payload where the platform's conversion does.
  toBits32 -> int = realToBits32(self)

  // Whether it is NaN, the one value that is not equal to itself.
  isNaN -> bool = self != self

  // Whether it is positive or negative infinity.
  isInfinite -> bool = self == real.PositiveInfinity || self == real.NegativeInfinity

  // Whether it is neither NaN nor an infinity.
  isFinite -> bool = self - self == 0.0

  // The number as an `int`, as `int(x)` is: truncated toward zero, the least or greatest `int`
  // beyond them, and zero for NaN.
  toInt -> int = int(self)

  // The number as a `long`, as `long(x)` is: truncated toward zero, the least or greatest `long`
  // beyond them, and zero for NaN.
  toLong -> long = long(self)
