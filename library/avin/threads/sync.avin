module avin.threads

// Mutual exclusion, conditions to wait for, and initialization run once. Each waits for another thread
// in the runtime, safe for the collector while it sleeps, so a thread blocked here never holds up a
// collection.

import avin.time.Duration

// A new lock, free: an opaque object on the collected heap that a thread sleeps on while another
// holds it.
@intrinsic("lock_new")
private lockNew() -> Any

// Takes `lock`, sleeping safe for the collector until no other thread holds it.
@intrinsic("lock_acquire")
private lockAcquire(lock: Any)

// Lets `lock` go, which the calling thread holds.
@intrinsic("lock_release")
private lockRelease(lock: Any)

// A new condition, with no thread waiting on it.
@intrinsic("condition_new")
private conditionNew() -> Any

// Lets `lock` go, sleeps safe for the collector until `condition` is notified, and takes `lock`
// again. A wait may also end with no notification.
@intrinsic("condition_wait")
private conditionWait(condition: Any, lock: Any)

// `conditionWait` for at most `millis` milliseconds, answering `false` where the time ran out first.
// Either way `lock` is held again when it answers.
@intrinsic("condition_wait_for")
private conditionWaitFor(condition: Any, lock: Any, millis: long) -> bool

// Milliseconds on a clock that only moves forward; the difference of two readings is the time between
// them.
@sysl("avin.rt.monotonic_millis")
private monotonicMillis() -> long

@intrinsic("condition_notify")
private conditionNotify(condition: Any)

@intrinsic("condition_notify_all")
private conditionNotifyAll(condition: Any)

// A lock and the thread holding it. Only the holder writes its own identity to `holder` and only the
// holder clears it, so a thread that reads its own identity there holds the lock, whatever other
// threads are writing: taking the lock a second time is found before it waits for ever.
private class Lock()
    private val handle = lockNew()
    private var holder: long = 0

    // Takes the lock, waiting for any other thread holding it; traps where this thread holds it.
    acquire()
        val me = current()
        if holder == me then fail("a thread takes a lock it already holds, which would wait for ever")
        lockAcquire(handle)
        holder = me

    release()
        holder = 0
        lockRelease(handle)

    // Lets the lock go while waiting for `condition`, and holds it again after; traps where this
    // thread does not hold it.
    await(condition: Any)
        val me = current()
        if holder != me then fail("a condition is waited for by the thread that holds its mutex")
        holder = 0
        conditionWait(condition, handle)
        holder = me

    // `await` for at most `millis` milliseconds, answering `false` where the time ran out first.
    awaitFor(condition: Any, millis: long) -> bool
        val me = current()
        if holder != me then fail("a condition is waited for by the thread that holds its mutex")
        holder = 0
        val notified = conditionWaitFor(condition, handle, millis)
        holder = me
        notified

// A value only one thread reaches at a time. `with` is the way to it: it takes the lock, runs its body
// with the value, and lets the lock go when the body returns. A body that changes a mutable value,
// such as a buffer, changes the one the mutex holds; for a sendable value, `update` replaces it and
// `get` reads it. A thread that takes a mutex it already holds, from inside a body, traps instead of
// waiting for ever. A mutex of any value may be shared between threads, since its value is reached
// only under its lock: it is the one deliberate door to shared mutable state. So that nothing else
// reaches the value, it is made in the argument that makes the mutex, and a body gives back only a
// sendable value; both are `@isolating`, using only sendable values from around them and reaching no
// module-level mutable state, where the value could be left for code that does not take the lock.
@keeps_owners
class Mutex[T](@isolating private var value: T): Sendable
    private val lock = Lock()

    // Runs `body` with the value while holding the lock, and gives back what it returns.
    with[R: Sendable](@isolating body: (T) -> R) -> R
        lock.acquire()
        defer lock.release()
        body(value)

    // A new condition to wait for with this mutex held.
    condition() -> Condition = Condition(lock)

// A sendable value may leave the lock and be put back whole, since no thread can change it.
impl[T: Sendable] Mutex[T]
    // The value, read under the lock.
    get() -> T = with(v -> v)

    // Replaces the value under the lock.
    set(v: T) = update(_ -> v)

    // Replaces the value with `f` of it, holding the lock throughout, and gives back the new value.
    update(f: (T) -> T) -> T
        lock.acquire()
        defer lock.release()
        value = f(value)
        value

// A place for threads to wait, inside their mutex's `with`, until another says something has changed.
// `wait` lets the mutex go while it sleeps and holds it again before it returns, so the state it
// guards is checked again in a loop: a wait may also end with nothing having changed.
//
//     while queue.isEmpty() do ready.wait()
//
// A condition is made by its mutex's `condition()` and waited for with that mutex only; waiting from a
// thread that does not hold it traps. Like its mutex, it may be shared between threads.
@keeps_owners
class Condition(private val lock: Lock): Sendable
    private val handle = conditionNew()

    // Lets the mutex go, sleeps until notified, and holds the mutex again.
    wait() = lock.await(handle)

    // `wait` for at most `timeoutMillis` milliseconds: `false` where the time ran out before a
    // notification, `true` where the wait ended sooner, which may also be with nothing having changed.
    // A time that is not positive answers `false` at once, holding the mutex throughout.
    waitFor(timeoutMillis: long) -> bool = lock.awaitFor(handle, timeoutMillis)

    // `wait` for at most `timeout`, as `waitFor(timeoutMillis)` does, a part of a millisecond waited
    // for as a whole one.
    waitFor(timeout: Duration) -> bool = lock.awaitFor(handle, waitMillis(timeout))

    // Wakes one thread waiting, if any is.
    notify() = conditionNotify(handle)

    // Wakes every thread waiting.
    notifyAll() = conditionNotifyAll(handle)

// Initialization run exactly once, whichever threads ask for it and however many at once: the first
// call of `run` runs its body, every other waits until that body has returned and then returns
// without running its own. A body that runs the same `Once` again traps.
@keeps_owners
class Once(): Sendable
    private val lock = Lock()
    private val done = Atomic(false)

    run(body: () -> unit)
        if done.load() then return
        lock.acquire()
        if !done.load()
            body()
            done.store(true)
        lock.release()

    // Whether a body has run to the end.
    isDone() -> bool = done.load()
