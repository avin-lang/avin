module avin.threads

// Threads: a closure run on a lightweight thread of its own, joined for its result. The runtime runs
// lightweight threads on a few operating system threads, parking one that waits and time-slicing one
// that computes, so a thread costs a stack reservation and a small record. The heap
// is shared, but a closure given to a thread captures only sendable values and no `var`, and what it
// returns is sendable, so the threads share nothing mutable but through a `Mutex`, an `Atomic` or a
// `Channel`; nothing is copied. A trap
// in any thread stops the whole program, and the program ends when `main` returns, whatever other
// threads are still running.

import avin.time.Duration

// Waits until `micros` microseconds have passed, safe for the collector while it waits: the runtime
// parks the lightweight thread on a timer, freeing its worker, rather than blocking it.
@sysl("avin.rt.sleep_micros")
private sleepMicros(micros: long)

// Pauses the calling thread for at least `d`, safe for the collector while it sleeps; a duration of
// zero or less returns at once. The thread parks, so its worker runs other threads meanwhile. A
// worker of a pool that sleeps keeps its place there; a body that should leave its place to another
// worker while it sleeps says so with `blocking`.
//
//     sleep(millis(50))
sleep(d: Duration)
  if d.micros > 0 then sleepMicros(d.micros)

// A duration as the whole milliseconds a timed wait takes, a part of one counting as one, so the wait
// is never shorter than the duration; zero for a duration of zero or less.
private waitMillis(d: Duration) -> long = if d.micros <= 0 then 0 else (d.micros - 1) / 1000 + 1

// Whether the calling code runs on the main thread, the operating system thread `main` was called on.
// It is never a lightweight thread, so work that has to run on that thread, a window's among it, can
// tell where it is.
@sysl("avin.rt.on_main_thread")
isMainThread() -> bool

// Starts a thread running `run` on a stack of `stack` bytes, and gives back the object it is joined
// by. The thread's context is attached before it starts, so `run` is never out of the collector's
// sight.
@intrinsic("thread_start")
private start(run: () -> unit, stack: long) -> Any

// Waits for the thread `joint` was given back for, safe for the collector while it waits. Waiting a
// second time returns at once.
@intrinsic("thread_join")
private await(joint: Any)

// The calling thread's identity, which no other running thread shares.
@intrinsic("thread_current")
private current() -> long

// A new owner of Sysl handles, which nothing has been given yet.
@intrinsic("owner_new")
private newOwner() -> long

// The owner of the code running, who alone may use the Sysl handles it owns.
@intrinsic("owner_current")
private currentOwner() -> long

// Makes `owner` the owner of the code running from now on.
@intrinsic("owner_set")
private runAs(owner: long)

// Gives every Sysl handle `value` reaches that `from` owns to `to`.
@intrinsic("hand_over")
private handOver(value: Any, from: long, to: long)

// The owner a handle in transit has: the next code to use it takes it.
private val inTransit: long = 0

// Where a thread leaves its result, which `join` reads once the thread has finished.
private class Outcome[T]()
  var value: Option[T] = None

  finish(v: T) = value = Some(v)

// A thread of a sendable result may be joined from any thread.
impl[T: Sendable] Sendable for Thread[T]

// A running or finished thread whose body yields a `T`.
@keeps_owners
class Thread[T](private val joint: Any, private val outcome: Outcome[T])
  // Waits for the thread to finish and gives back what its body returned. Joining again gives the
  // same result again. Joining a thread its scope cancelled before its body returned traps, since it
  // has no result; `result` answers `None` for one.
  join() -> T
    await(joint)
    outcome.value match
      Some(v) -> v
      None -> fail("a joined thread was cancelled before it finished")

  // Waits for the thread to end and answers what its body returned, or `None` where its scope
  // cancelled it before its body returned.
  result() -> Option[T]
    await(joint)
    outcome.value

// Starts `body` on a new thread with a stack of `stack` bytes, 8 MiB unless asked otherwise, reserved
// and committed only as the thread touches it, and 64 KiB at the least. The
// Sysl handles `body` reaches that the calling code owns are the new thread's until its body
// returns; then they, and those in what it returns, are in transit, for the next code to use them.
spawn[T: Sendable](@sendable body: () -> T, stack: long = 8388608) -> Thread[T] = launch(body, stack).0

// `spawn`, giving back too what a scope keeps of the thread: its joint, which the scope cancels it
// by, and what hands back the Sysl handles its body reaches once it has ended, which a thread
// cancelled before its body returned did not do itself. Where `runs` is false the thread is one a
// cancelled scope starts: it runs nothing, and ends with no result.
private launch[T: Sendable](@sendable body: () -> T, stack: long, runs: bool = true) -> (Thread[T], Any, () -> unit)
  val outcome = Outcome[T]()
  if !runs
    val joint = start(() -> (), stack)
    return (Thread(joint, outcome), joint, () -> ())
  val owner = newOwner()
  handOver(body, currentOwner(), owner)
  val run = () ->
    runAs(owner)
    val v = body()
    handOver(body, owner, inTransit)
    handOver(v, owner, inTransit)
    outcome.finish(v)
  val joint = start(run, stack)
  val handBack = () ->
    if outcome.value.isEmpty then handOver(body, owner, inTransit)
  (Thread(joint, outcome), joint, handBack)

// Cancels the thread `joint` was given back for, unless it has ended.
@intrinsic("thread_cancel")
private cancelThread(joint: Any)

// Runs `run` so that a cancellation of the calling thread returns here, and answers whether it did.
// The thread is then still cancelled, but nothing stops it again until it calls `resumeCancel`.
@intrinsic("cancel_guarded")
private cancelGuarded(run: () -> unit) -> bool

// Goes on with the calling thread's cancellation, which returned to `cancelGuarded`: to the scope
// around this one, or to the end of the thread.
@intrinsic("cancel_resume")
private resumeCancel() -> Nothing

// Enters, and leaves, a region the calling thread's cancellation does not stop it in, for work other
// threads wait on that holds no lock, such as running what waits for a future the thread completed. A
// cancellation that comes meanwhile stops the thread at its next cancellation point after.
@intrinsic("uncancellable_enter")
private enterUncancellable()

@intrinsic("uncancellable_leave")
private leaveUncancellable()

// What a scope has started: the joint of each of its threads and what hands back the handles of one
// that was cancelled, newest first, whether it is still open and whether it has been cancelled. It
// belongs to the thread that runs the scope's body.
private class Started()
  val owner = current()
  var open = true
  var cancelled = false
  var joints: List[Any] = []
  var handBacks: List[() -> unit] = []

  // Cancels every thread started so far; one started later runs nothing.
  cancelAll()
    cancelled = true
    for j in joints do cancelThread(j)

  // Waits for every thread started so far to end, hands back the handles the cancelled ones
  // reached, and closes the scope.
  close()
    for j in joints do await(j)
    for h in handBacks do h()
    open = false

  // Checks that the scope is open and used by the thread that runs its body.
  use(what: string)
    if !open then fail("a scope's threads are " + what + " while it is open")
    if current() != owner then fail("a scope's threads are " + what + " by the thread that runs its body")

// The threads one call of `scope` starts, which it waits for before it returns. They are started, and
// cancelled, by the thread that runs the scope's body, while the scope is open.
@keeps_owners
class Scope(private val started: Started)
  // Starts `body` on a new thread with a stack of `stack` bytes, as `spawn` does, which the scope
  // waits for before it returns. In a cancelled scope the thread starts cancelled, and ends before
  // its body runs.
  spawn[T: Sendable](@sendable body: () -> T, stack: long = 8388608) -> Thread[T]
    started.use("started")
    // A cancellation of the calling thread does not come between starting the thread and
    // recording it, so the scope always waits for it.
    // A thread started in a cancelled scope runs nothing, and ends with no result.
    enterUncancellable()
    val (t, joint, handBack) = launch(body, stack, !started.cancelled)
    started.joints = joint :: started.joints
    started.handBacks = handBack :: started.handBacks
    leaveUncancellable()
    t

  // Cancels every thread the scope has started and every one it starts from now on: each stops at
  // its next cancellation point, and its result is `None`. The scope still waits for them all before
  // it returns, and the body goes on.
  cancel()
    started.use("cancelled")
    started.cancelAll()

  // Whether the scope has been cancelled, by `cancel` or by a cancellation of the thread running it.
  isCancelled() -> bool = started.cancelled

// Runs `body` with a new scope, and returns what it returns once every thread started through the
// scope has ended. Where the thread running it is itself cancelled, by a scope it was started in,
// the scope cancels its own threads, waits for them to end, and the thread's cancellation goes on.
scope[T](body: (Scope) -> T) -> T
  val started = Started()
  val out = Outcome[T]()
  val run = () ->
    out.finish(body(Scope(started)))
    started.close()
  if cancelGuarded(run)
    started.cancelAll()
    started.close()
    resumeCancel()
  out.value match
    Some(v) -> v
    None -> fail("a scope's body left no result")

// Runs `body` with a new scope, as `scope` does, for at most `timeout`: `Some` of what it returns
// where it returns in time, and `None` where the time runs out first. Then the body is cancelled where
// it is, with every thread the scope started and everything below them, as a scope's `cancel` cancels
// them, and `withTimeout` answers once they have all ended. A body that has returned keeps its
// result, however close to the time it did. A timeout of zero or less runs nothing and answers
// `None`. Timeouts nest: an inner one ends at its own time or when the outer one's runs out, whichever
// comes first, and so does a `scope` inside.
//
// So that it can be stopped wherever it is, even when `withTimeout` is called from `main`, the body
// runs on a lightweight thread of its own while the calling thread waits for it; it reaches what the
// calling code reaches, its Sysl handles among them, and returns to it. Its waits, and the waits of
// the threads it starts, park on the runtime's timers as every wait does, holding no worker.
//
//     val page = withTimeout(seconds(5), s -> fetch(url)) match
//       Some(p) -> p
//       None -> "timed out"
withTimeout[T](timeout: Duration, body: (Scope) -> T) -> Option[T]
  if timeout.micros <= 0 then return None
  val started = Started()
  val out = Outcome[T]()
  val ended = Channel[unit](1)
  val owner = currentOwner()
  val runBody = () ->
    runAs(owner)
    out.finish(scope(body))
    ended.send(())
  val run = () ->
    // A cancellation of the calling thread does not come between starting the body and recording
    // it, so its scope always waits for the body.
    enterUncancellable()
    val joint = start(runBody, 8388608)
    started.joints = joint :: started.joints
    leaveUncancellable()
    if selectWithin(timeout, SelectReceive(ended, ReceiveEither)) != 0 then started.cancelAll()
    started.close()
  if cancelGuarded(run)
    started.cancelAll()
    started.close()
    resumeCancel()
  out.value
