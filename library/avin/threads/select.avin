module avin.threads

// What a `select` block is read into: an arm object for each of its channel, `readable()` and
// `writable()` arms,
// made in the order written, and a call of `selectWaiting`, `selectOrElse` or `selectWithin` with
// them, which answers the arm that ran, its body then chosen by that number. A program writes
// `select` rather than calling these.
//
// A select tries its arms in an order drawn at random each time, so of several arms ready at once
// each is as likely to run as any other. Where none is ready, the select waits on all of their
// channels at once: in one pass, each arm is tried under its channel's lock and, where it cannot
// complete, enlisted on the condition of the channel it waits for before the lock goes, and then the
// thread parks once, until the first of those conditions is notified, the select's time runs out or
// its thread is cancelled (`runtime/avin/rt/select.sysl`). A `readable()` arm whose source is not
// readable has its descriptor watched by the runtime's poller under the same wait instead, so bytes
// arriving end it as a channel's notification does; a `writable()` arm's sink is watched for room
// the same way. Woken through an arm, it tries that arm
// first; where another thread got there first, it passes the notification on to the next thread
// waiting on that channel, so a notification a select took is never lost, and then begins again.

import avin.time.Duration

// A new wait for a select of `arms` arms.
@intrinsic("select_new")
private selectNew(arms: long) -> Any

// Begins a round of the select's arms, its wait ended by nothing yet.
@intrinsic("select_reset")
private selectReset(wait: Any)

// Takes every arm of the select off the channel it was enlisted on.
@intrinsic("select_withdraw")
private selectWithdraw(wait: Any)

// Opens the select, every arm of whose round has been tried and enlisted, to claims by threads that
// complete an arm on a channel of capacity zero themselves.
@intrinsic("select_open")
private selectOpen(wait: Any)

// Ends the select's wait through arm `index`, for a thread completing that arm under its channel's
// lock: 1 where this ended it; 0 where the select is still trying its arms; -1 where its wait has
// already ended. With `poke` 1, ends a wait still trying its arms too, so that the select tries the
// arm again once its round is over.
@intrinsic("select_claim")
private selectClaim(wait: Any, index: long, poke: long) -> long

// Waits until a channel an arm is enlisted on is notified, or until `deadline` where it is positive:
// the arm notified, or -1 where the time ran out. A cancellation point.
@intrinsic("select_park")
private selectPark(wait: Any, deadline: long) -> long

// The deadline `micros` microseconds from now.
@intrinsic("select_deadline")
private selectDeadline(micros: long) -> long

// What a receive arm waits for: a value (`Some(x)`), the channel closed and drained (`None`), or
// either.
private val ReceiveEither: int = 0
private val ReceiveValue: int = 1
private val ReceiveClosed: int = 2

// The wait of one select of `arms` arms, which only this module makes, so only its code tries an arm.
private class Selecting(arms: int)
  val handle = selectNew(long(arms))
  // Whether the select is trying again the arm it was woken through, so that an arm on a channel of
  // capacity zero waits out another select still trying its arms there rather than missing it.
  var retrying = false

// One channel arm of a `select` block.
trait SelectArm
  // Tries the arm as arm `index` of the select waiting as `wait`: completes it and answers `true`
  // where its channel is ready for it, and otherwise, where `enlist`, enlists it on the channel.
  offer(wait: Selecting, index: int, enlist: bool) -> bool

  // Passes on a notification the arm was woken by and did not use.
  passOn(wait: Selecting) -> unit

  // When the select is to try the arm again although nothing notifies it, on the monotonic clock in
  // microseconds: the time a channel `after` or a `Ticker` made next falls due; 0 for never.
  wakeAt(wait: Selecting) -> long = 0

  // Takes what stands for the arm off its channel, once the select has ended or before it begins
  // another round: only an arm on a channel of capacity zero leaves anything there.
  withdraw() = ()

// A receive arm, `channel.receive() as pattern`, wanting what `wants` says: 0 a value or the channel
// closed, 1 a value, 2 the channel closed and drained.
class SelectReceive[T](private val channel: Channel[T], private val wants: int): SelectArm
  private var got: Option[T] = None
  // On a channel of capacity zero, what stands for the arm there in this round, which a sender
  // completes.
  private var party: Option[Party[T]] = None

  override offer(wait: Selecting, index: int, enlist: bool) -> bool
    val r =
      if channel.handsOver()
        channel.offerTake(wants, wait, index, enlist, partyFor(wait, index, enlist))
      else channel.offerReceive(wants, wait, index, enlist)
    r match
      Some(x) ->
        got = x
        true
      None -> false

  override passOn(wait: Selecting) = channel.passOn(wait, false)

  override withdraw()
    if party is Some(p)
      channel.withdrawParty(p)
      party = None

  // The party of this round: a new one where the round begins, which `enlist` says, or where there is
  // none yet.
  private partyFor(wait: Selecting, index: int, enlist: bool) -> Party[T]
    if !enlist
      if party is Some(p) then return p
    val p = Party[T](None, Some(wait), index, ReceiveWait)
    party = Some(p)
    p

  override wakeAt(wait: Selecting) -> long = channel.wakeAt(wait)

  // What the arm received: the value, or `None` from a closed and drained channel.
  received() -> Option[T] = got

  // The value the arm received, which an arm wanting a value has once it has run.
  value() -> T = got match
    Some(x) -> x
    None -> fail("a select's receive arm holds no value")

// A send arm, `channel.send(x)`, its value evaluated once, before the select tries any arm.
class SelectSend[T](private val channel: Channel[T], private val x: T): SelectArm
  // On a channel of capacity zero, what stands for the arm there in this round, which a receiver
  // completes.
  private var party: Option[Party[T]] = None

  override offer(wait: Selecting, index: int, enlist: bool) -> bool
    if !channel.handsOver() then return channel.offerSend(x, wait, index, enlist)
    channel.offerGive(x, wait, index, enlist, partyFor(wait, index, enlist))

  override passOn(wait: Selecting) = channel.passOn(wait, true)

  override withdraw()
    if party is Some(p)
      channel.withdrawParty(p)
      party = None

  // The party of this round, as a receive arm's is.
  private partyFor(wait: Selecting, index: int, enlist: bool) -> Party[T]
    if !enlist
      if party is Some(p) then return p
    val p = Party[T](Some(x), Some(wait), index, SendWait)
    party = Some(p)
    p

// What a select's `readable()` arm waits on: a source of bytes from outside the program, a
// connection's `ByteStream` among them, that says at once whether a read of it would answer without
// waiting, and names the descriptor whose becoming readable may make it so.
trait Readiness
  // Whether a read would answer now, without waiting: bytes are already buffered or have arrived,
  // the other end has finished sending, or the source has failed or been closed, which the read then
  // reports. Never waits.
  readable() -> bool

  // The operating system descriptor a select watches for the source to become readable, or -1 for
  // one with none, which a select finds readable only when it tries its arms.
  readinessDescriptor() -> int

// What a select's `writable()` arm waits on: a sink of bytes to outside the program, a connection's
// `ByteStream` or the writing half of one among them, that says at once whether a write to it would
// send something without waiting, and names the descriptor whose becoming writable may make it so.
trait Writability
  // Whether a write would send at least one byte now, without waiting: there is room for it, or the
  // sink has failed or been closed, which the write then reports. Never waits.
  writable() -> bool

  // The operating system descriptor a select watches for the sink to become writable, or -1 for one
  // with none, which a select finds writable only when it tries its arms.
  writabilityDescriptor() -> int

// Watches descriptor `fd` for arm `index` of the select waiting as `wait`, on the runtime's poller,
// for being readable, or writable where `writing` is 1: 1, or 0 where the poller cannot take it.
@intrinsic("select_watch")
private selectWatch(wait: Any, index: long, fd: int, writing: int) -> long

// A `readable()` arm, `source.readable()`: ready once a read of `source` would answer without
// waiting. Running it reads nothing; its body reads.
class SelectReadable(private val source: Readiness): SelectArm
  override offer(wait: Selecting, index: int, enlist: bool) -> bool
    if source.readable() then return true
    if !enlist then return false
    val fd = source.readinessDescriptor()
    // A descriptor the poller cannot take makes the arm ready, so that its read answers why.
    fd >= 0 && selectWatch(wait.handle, long(index), fd, 0) == 0

  // A report of the descriptor that the select could not use, the source not readable after all,
  // is the select's alone: nobody else waits on it.
  override passOn(wait: Selecting) = ()

// A `writable()` arm, `sink.writable()`: ready once a write to `sink` would send something without
// waiting. Running it writes nothing; its body writes, with `writeSome` to send only what goes at once.
class SelectWritable(private val sink: Writability): SelectArm
  override offer(wait: Selecting, index: int, enlist: bool) -> bool
    if sink.writable() then return true
    if !enlist then return false
    val fd = sink.writabilityDescriptor()
    // A descriptor the poller cannot take makes the arm ready, so that its write answers why.
    fd >= 0 && selectWatch(wait.handle, long(index), fd, 1) == 0

  // A report the select could not use is its alone, as a `readable()` arm's is.
  override passOn(wait: Selecting) = ()

// A select with no `else` and no `after`: waits until one of `arms` runs, and answers which.
selectWaiting(arms: SelectArm*) -> int = chosen(arms, 0, false)

// A select with `else`: runs one of `arms` that is ready now and answers which, or answers the number
// of arms, the `else`, where none is.
selectOrElse(arms: SelectArm*) -> int
  val wait = Selecting(0)
  for i in drawnOrder(arms.length)
    if arms(i).offer(wait, i, false) then return i
  arms.length

// A select with `after timeout`: runs one of `arms`, waiting at most `timeout` for one to be ready,
// and answers which, or the number of arms, the `after`, where the time ran out first. A timeout of
// zero or less tries the arms once, as `else` does.
selectWithin(timeout: Duration, arms: SelectArm*) -> int
  if timeout.micros <= 0 then return selectOrElse(arms*)
  chosen(arms, selectDeadline(timeout.micros), true)

// Runs one of `arms`, waiting until `deadline` where `timed`: the arm, or the number of arms where
// the time ran out.
private chosen(arms: Vector[SelectArm], deadline: long, timed: bool) -> int
  val wait = Selecting(arms.length)
  var woken = -1
  loop
    // Woken through an arm, the select tries that arm first and, where the arm cannot complete,
    // passes the notification on to the next thread waiting on its channel, which may be able to
    // use it.
    // A thread that claimed the select through an arm on a channel of capacity zero has completed
    // that arm already, and the arm's offer finds it so.
    if woken >= 0
      wait.retrying = true
      val done = arms(woken).offer(wait, woken, false)
      wait.retrying = false
      if done
        withdrawn(arms)
        return woken
      arms(woken).passOn(wait)
    withdrawn(arms)
    selectReset(wait.handle)
    for i in drawnOrder(arms.length)
      if arms(i).offer(wait, i, true)
        selectWithdraw(wait.handle)
        withdrawn(arms)
        return i
    // An arm on a channel `after` or a `Ticker` made is notified by nothing, so the select also wakes
    // when the soonest of their clocks falls due, and tries the arms again.
    var limit = if timed then deadline else 0
    for arm in arms
      val at = arm.wakeAt(wait)
      if at > 0 && (limit <= 0 || at < limit) then limit = at
    // Only now, with every arm tried, may another thread complete one of them and end the wait.
    selectOpen(wait.handle)
    val ended = selectPark(wait.handle, limit)
    if ended >= 0
      woken = int(ended)
    elif timed && limit == deadline
      withdrawn(arms)
      return arms.length
    else woken = -1

// Takes what every arm of a select left on its channel off it.
private withdrawn(arms: Vector[SelectArm])
  for arm in arms do arm.withdraw()

// The draws of every select, each a step of a sequence no two draws share.
private val draws = Atomic(long(0))

// A random order of `0 ..< n`, each order as likely as any other.
private drawnOrder(n: int) -> Array[int]
  val order = Array.tabulate(n, i -> i)
  if n < 2 then return order
  var bits = mixed(draws.update(s -> s +% -7046029254386353131))
  var i = n - 1
  while i > 0
    val j = int(unsigned(bits) % long(i + 1))
    val t = order(i)
    order(i) = order(j)
    order(j) = t
    bits = mixed(bits +% -7046029254386353131)
    i -= 1
  order

// A 64-bit value whose bits each depend on every bit of `z`.
private mixed(z: long) -> long
  var x = (z ^ logicalShift(z, 30)) *% -4658895280553007687
  x = (x ^ logicalShift(x, 27)) *% -7723592293110705685
  x ^ logicalShift(x, 31)

// `x` shifted right by `k`, with zeros shifted in.
private logicalShift(x: long, k: long) -> long = (x >> k) & ((long(1) << (64 - k)) -% 1)

// `x` with its sign bit cleared, so it is not negative.
private unsigned(x: long) -> long = x & 9223372036854775807
