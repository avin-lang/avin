module avin.threads

import avin.time.{Duration, micros, monotonic}

// A channel of sendable values may be shared between threads: every send and receive is synchronized.
impl[T: Sendable] Sendable for Channel[T]

// A queue between threads. `send` puts a value at the back and `receive` takes the one at the front,
// so values arrive in the order one thread sent them; a send happens before the receive that gets its
// value. A channel made with a capacity is bounded: a send waits while it holds that many values, so a
// fast sender keeps pace with its receivers. With no capacity, or zero, it is unbounded and a send
// never waits. `close` ends it: a send to a closed channel traps, and once the values sent before the
// close are received, `receive` gives `None`. A thread waiting to send or receive is safe for the
// collector while it waits. Iterating a channel receives from it until it is closed and drained:
//
//     for job in jobs do run(job)
//
// A channel `after` or a `Ticker` makes (`timing.avin`) holds a clock instead of a sender: the time
// its next value falls due, a number in the channel, so it costs no timer and no thread while nobody
// waits on it. The value is delivered by the first receive or select that looks once the time has
// come, and a thread waiting on such a channel waits on its condition until that time at the most.
@keeps_owners
class Channel[T](capacity: int = 0): Iterable[T]
  private val bound = boundOf(capacity)
  private val lock = Lock()
  private val items = Deque[T]()
  private val readable = Condition(lock, ReceiveWait)
  private val writable = Condition(lock, SendWait)
  private var closed = false
  // Whether `after` or a `Ticker` made the channel, which nothing sends to; set before the channel
  // is shared, and never changed after.
  private var timed = false
  private var clock: Option[Clock[T]] = None

  // Puts `x` at the back, waiting while a bounded channel is full; traps where the channel is
  // closed.
  send(x: T)
    sendable()
    lock.acquire()
    while !closed && full() do writable.wait()
    if closed
      lock.release()
      fail("a send to a closed channel")
    items.append(x)
    readable.notify()
    lock.release()

  // Puts `x` at the back, waiting at most `timeout` while a bounded channel is full, and answers
  // whether it did: `false` where the time ran out with the channel still full. A timeout of zero or
  // less is `trySend`. Traps where the channel is closed, as `send` does.
  send(x: T, timeout: Duration) -> bool
    if timeout.micros <= 0 then return trySend(x)
    sendable()
    val deadline = monotonic().micros +| timeout.micros
    lock.acquire()
    while !closed && full() && monotonic().micros < deadline do waitOn(writable, deadline)
    if closed
      lock.release()
      fail("a send to a closed channel")
    val room = !full()
    if room
      items.append(x)
      readable.notify()
    lock.release()
    room

  // Puts `x` at the back where there is room now, and answers whether it did; traps where the
  // channel is closed.
  trySend(x: T) -> bool
    sendable()
    lock.acquire()
    if closed
      lock.release()
      fail("a send to a closed channel")
    val room = !full()
    if room
      items.append(x)
      readable.notify()
    lock.release()
    room

  // Takes the value at the front, waiting while there is none; `None` once the channel is closed
  // and every value sent before is received.
  receive() -> Option[T]
    lock.acquire()
    ripen()
    while items.isEmpty && !closed
      waitOn(readable, 0)
      ripen()
    val got = taken()
    lock.release()
    got

  // Takes the value at the front, waiting at most `timeout` while there is none: `None` where the
  // time ran out first, or once the channel is closed and every value sent before is received. A
  // timeout of zero or less is `tryReceive`.
  receive(timeout: Duration) -> Option[T]
    if timeout.micros <= 0 then return tryReceive()
    val deadline = monotonic().micros +| timeout.micros
    lock.acquire()
    ripen()
    while items.isEmpty && !closed && monotonic().micros < deadline
      waitOn(readable, deadline)
      ripen()
    val got = taken()
    lock.release()
    got

  // Takes the value at the front where there is one now; `None` where there is not.
  tryReceive() -> Option[T]
    lock.acquire()
    ripen()
    val got = taken()
    lock.release()
    got

  // Ends the channel: no value is sent to it after, and every thread waiting on it wakes. Closing a
  // closed channel does nothing. A channel `after` or a `Ticker` made delivers nothing more once it
  // is closed.
  close()
    lock.acquire()
    closed = true
    clock = None
    readable.notifyAll()
    writable.notifyAll()
    lock.release()

  // Whether the channel is closed.
  isClosed() -> bool
    lock.acquire()
    val c = closed
    lock.release()
    c

  // The values received from the channel, one at a time, until it is closed and drained.
  override iterator() -> Iterator[T] = Receiving(self)

  // Whether a bounded channel holds as many values as it may; under the lock.
  private full() -> bool = bound > 0 && items.length >= bound

  // Traps where `after` or a `Ticker` made the channel: its values come from its clock alone.
  private sendable()
    if timed then fail("a send to a channel `after` or a `Ticker` made, which only its clock sends to")

  // Delivers what the channel's clock has fallen due for, if anything; under the lock. A clock of one
  // value delivers it and ends. A ticking one delivers a tick where the channel holds none, and moves
  // on to its first time after now, so the ticks a slow receiver missed are dropped rather than kept.
  private ripen()
    if clock is Some(k)
      val now = monotonic().micros
      if now < k.due then return
      if k.period <= 0
        items.append(k.stamp(k.due))
        clock = None
      else
        if items.isEmpty then items.append(k.stamp(k.due))
        k.due = k.due +| ((now - k.due) / k.period + 1) *| k.period
      readable.notify()

  // Waits on `condition`, which goes with the channel's lock, until it is notified, the channel's
  // clock falls due, or `deadline` on the monotonic clock in microseconds passes where it is
  // positive; holds the lock again after. A wait may end with nothing having changed.
  private waitOn(condition: Condition, deadline: long)
    val due = if clock is Some(k) then k.due else 0
    val until = if due > 0 && (deadline <= 0 || due < deadline) then due else deadline
    if until <= 0
      condition.wait()
      return
    val left = until - monotonic().micros
    if left > 0 then condition.waitFor(micros(left))

  // The value at the front, taken off, waking a sender waiting for room; under the lock. Taking the
  // last value of a closed channel also wakes every `select` waiting for it to be drained.
  private taken() -> Option[T]
    if items.isEmpty then return None
    val x = items.removeHead()
    writable.notify()
    if closed && items.isEmpty then readable.notifyAll()
    Some(x)

// What a `select` block's arms do with a channel (`select.avin`). Only the module makes a
// `Selecting`, so only its code calls these. Each tries its operation under the channel's lock and,
// where it cannot complete and the select is to wait, enlists the arm on the condition it waits for
// before letting the lock go, so no change made after it looked goes unseen.
impl[T] Channel[T]
  // A receive by arm `index` of the select waiting as `wait`: the value taken, or `None` from a
  // closed and drained channel, where the channel is ready for what the arm `wants` (`ReceiveValue`,
  // `ReceiveClosed` or `ReceiveEither`), and otherwise `None`, the arm enlisted where `enlist`.
  offerReceive(wants: int, wait: Selecting, index: int, enlist: bool) -> Option[Option[T]]
    lock.acquire()
    ripen()
    val ready =
      if wants == ReceiveValue then !items.isEmpty
      elif wants == ReceiveClosed then items.isEmpty && closed
      else !items.isEmpty || closed
    if ready
      val got = taken()
      lock.release()
      return Some(got)
    if enlist then readable.enlist(wait, index) else lock.release()
    None

  // A send of `x` by arm `index` of the select `wait`: whether there was room for it, the arm
  // enlisted where there was not and `enlist`; traps where the channel is closed, as `send` does.
  offerSend(x: T, wait: Selecting, index: int, enlist: bool) -> bool
    sendable()
    lock.acquire()
    if closed
      lock.release()
      fail("a send to a closed channel")
    if !full()
      items.append(x)
      readable.notify()
      lock.release()
      return true
    if enlist then writable.enlist(wait, index) else lock.release()
    false

  // Passes on a notification a select took and did not use: wakes the next thread waiting to
  // receive where a value is waiting, or to send, where `sending`, where there is room. Where another
  // thread has already taken what the notification was for, there is nothing to pass on.
  passOn(wait: Selecting, sending: bool)
    lock.acquire()
    if sending
      if !closed && !full() then writable.notify()
    elif !items.isEmpty then readable.notify()
    lock.release()

  // When the select waiting as `wait` is to look at the channel again although nothing notifies it:
  // the time its clock next falls due, on the monotonic clock in microseconds, or 0 for a channel
  // with no clock.
  wakeAt(wait: Selecting) -> long
    if !timed then return 0
    lock.acquire()
    val at = if clock is Some(k) then k.due else 0
    lock.release()
    at

// What `after` and a `Ticker` do with the channel they make (`timing.avin`). The clock is of a type
// private to the module, so only its code calls these.
impl[T] Channel[T]
  // Gives the channel, which nothing has reached yet, the clock its values come from.
  startClock(k: Clock[T])
    timed = true
    clock = Some(k)

  // Stops the clock `k`, where it is still the channel's, and drops a value of it not yet received.
  stopClock(k: Clock[T])
    lock.acquire()
    if clock is Some(c) && c === k
      clock = None
      items.clear()
    lock.release()

// When a channel `after` or a `Ticker` made has its next value: `due`, on the monotonic clock in
// microseconds, and every `period` after it where `period` is positive. `stamp` makes the value for a
// time it fell due.
private class Clock[T](var due: long, val period: long, val stamp: (long) -> T)

// A channel's capacity, which is not negative.
private boundOf(capacity: int) -> int
  if capacity < 0 then fail("a channel's capacity is not negative")
  capacity

// An iterator receiving from a channel: each `hasNext` that finds no value waiting receives one.
private class Receiving[T](private val channel: Channel[T]): Iterator[T]
  private var pending: Option[T] = None
  private var drained = false

  override hasNext() -> bool
    if pending.isDefined then return true
    if drained then return false
    pending = channel.receive()
    if pending.isDefined then return true
    drained = true
    false

  override next() -> T
    if !hasNext() then fail("next on a channel's iterator once the channel is closed and drained")
    pending match
      Some(x) ->
        pending = None
        x
      None -> fail("next on a channel's iterator once the channel is closed and drained")
