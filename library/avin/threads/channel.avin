module avin.threads

// A channel of sendable values may be shared between threads: every send and receive is synchronized.
impl[T: Sendable] Sendable for Channel[T]

// A queue between threads. `send` puts a value at the back and `receive` takes the one at the front,
// so values arrive in the order one thread sent them; a send happens before the receive that gets its
// value. A channel made with a capacity is bounded: a send waits while it holds that many values, so a
// fast sender keeps pace with its receivers. With no capacity, or zero, it is unbounded and a send
// never waits. `close` ends it: a send to a closed channel traps, and once the values sent before the
// close are received, `receive` gives `None`. A thread waiting to send or receive is safe for the
// collector while it waits. Iterating a channel receives from it until it is closed and drained:
//
//     for job in jobs do run(job)
@keeps_owners
class Channel[T](capacity: int = 0): Iterable[T]
  private val bound = boundOf(capacity)
  private val lock = Lock()
  private val items = Deque[T]()
  private val readable = Condition(lock, ReceiveWait)
  private val writable = Condition(lock, SendWait)
  private var closed = false

  // Puts `x` at the back, waiting while a bounded channel is full; traps where the channel is
  // closed.
  send(x: T)
    lock.acquire()
    while !closed && full() do writable.wait()
    if closed
      lock.release()
      fail("a send to a closed channel")
    items.append(x)
    readable.notify()
    lock.release()

  // Puts `x` at the back where there is room now, and answers whether it did; traps where the
  // channel is closed.
  trySend(x: T) -> bool
    lock.acquire()
    if closed
      lock.release()
      fail("a send to a closed channel")
    val room = !full()
    if room
      items.append(x)
      readable.notify()
    lock.release()
    room

  // Takes the value at the front, waiting while there is none; `None` once the channel is closed
  // and every value sent before is received.
  receive() -> Option[T]
    lock.acquire()
    while items.isEmpty && !closed do readable.wait()
    val got = taken()
    lock.release()
    got

  // Takes the value at the front where there is one now; `None` where there is not.
  tryReceive() -> Option[T]
    lock.acquire()
    val got = taken()
    lock.release()
    got

  // Ends the channel: no value is sent to it after, and every thread waiting on it wakes. Closing a
  // closed channel does nothing.
  close()
    lock.acquire()
    closed = true
    readable.notifyAll()
    writable.notifyAll()
    lock.release()

  // Whether the channel is closed.
  isClosed() -> bool
    lock.acquire()
    val c = closed
    lock.release()
    c

  // The values received from the channel, one at a time, until it is closed and drained.
  override iterator() -> Iterator[T] = Receiving(self)

  // Whether a bounded channel holds as many values as it may; under the lock.
  private full() -> bool = bound > 0 && items.length >= bound

  // The value at the front, taken off, waking a sender waiting for room; under the lock.
  private taken() -> Option[T]
    if items.isEmpty then return None
    val x = items.removeHead()
    writable.notify()
    Some(x)

// A channel's capacity, which is not negative.
private boundOf(capacity: int) -> int
  if capacity < 0 then fail("a channel's capacity is not negative")
  capacity

// An iterator receiving from a channel: each `hasNext` that finds no value waiting receives one.
private class Receiving[T](private val channel: Channel[T]): Iterator[T]
  private var pending: Option[T] = None
  private var drained = false

  override hasNext() -> bool
    if pending.isDefined then return true
    if drained then return false
    pending = channel.receive()
    if pending.isDefined then return true
    drained = true
    false

  override next() -> T
    if !hasNext() then fail("next on a channel's iterator once the channel is closed and drained")
    pending match
      Some(x) ->
        pending = None
        x
      None -> fail("next on a channel's iterator once the channel is closed and drained")
