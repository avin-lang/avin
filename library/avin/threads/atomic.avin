module avin.threads

// An atomic holding a sendable value may be shared between threads: every access is indivisible.
impl[T: Sendable] Sendable for Atomic[T]

// A value threads read and write indivisibly, every operation sequentially consistent: all threads see
// all operations on all `Atomic`s in one order, and a store happens before every load that reads it.
// It holds any type: an integer, a bool or a reference is one machine word and is accessed as one,
// lock-free; an integer wider than 64 bits is accessed under one lock the runtime keeps for them.
// `compareAndSet` compares a value without identity with `==` and anything else as the word stored.
class Atomic[T](private var value: T)
    // The value.
    @intrinsic("atomic_load")
    load() -> T

    // Replaces the value.
    @intrinsic("atomic_store")
    store(v: T)

    // Replaces the value and gives back the one it replaced.
    @intrinsic("atomic_swap")
    swap(v: T) -> T

    // Replaces the value with `desired` where it is `expected`, and answers whether it did. A value
    // without identity (a data value, an `Option` among them, a tuple, a string or an `Any`) is
    // expected when it is `==` to `expected`, however it was made; any other is expected when it is
    // the same word: the same object for a reference, as `===` does, and the same value for a scalar
    // (for a real, the same bits). Which applies is decided for each `T`, so a scalar or a reference
    // costs one hardware compare-and-set.
    compareAndSet(expected: T, desired: T) -> bool
        if !heldByValue() then return sameWordSet(expected, desired)
        loop
            val seen = load()
            if !seen.equals(expected) then return false
            if sameWordSet(seen, desired) then return true

    // Whether `T` is a type whose values have no identity, known when the program is compiled. It
    // serves `compareAndSet`.
    @intrinsic("atomic_by_value")
    private heldByValue() -> bool

    // Replaces the value with `desired` where it is the very word `expected`, never comparing with
    // `==`. It serves `compareAndSet`.
    @intrinsic("atomic_compare_set")
    private sameWordSet(expected: T, desired: T) -> bool

    // Replaces the value with `f` of it, retrying where another thread changed it meanwhile, and
    // gives back the new value. `f` may run more than once.
    update(f: (T) -> T) -> T
        loop
            val seen = load()
            val next = f(seen)
            if compareAndSet(seen, next) then return next

// An integer `Atomic` adds and subtracts as one step, trapping on overflow as `+` and `-` do; the
// value is left as it was when the result would overflow.
impl[T: Integer] Atomic[T]
    // Adds `n` and gives back the new value.
    add(n: T) -> T
        loop
            val seen = load()
            val next = seen + n
            if compareAndSet(seen, next) then return next

    // Subtracts `n` and gives back the new value.
    sub(n: T) -> T
        loop
            val seen = load()
            val next = seen - n
            if compareAndSet(seen, next) then return next
