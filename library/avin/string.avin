module avin

// The methods of `string`. A string is immutable UTF-8; offsets into it count bytes, and an offset
// that falls inside a character's encoding is not a place in the text, so slicing at one traps.
// Searching, comparing and trimming walk bytes, which is exact for UTF-8: a character's encoding
// never begins inside another's.

@sysl("sysl.text.to_upper")
private upperText(s: string) -> string

@sysl("sysl.text.to_lower")
private lowerText(s: string) -> string

@sysl("sysl.text.replace_all")
private replaceText(s: string, old: string, new: string) -> string

@sysl("sysl.unicode.is_space")
private isSpace(c: char) -> bool

impl string
    // The number of bytes of the string's encoding, read from the string itself.
    @intrinsic("string_byte_length")
    byteLength() -> int

    // The byte at `offset`, which traps when it is not inside the string.
    @intrinsic("string_byte_at")
    byteAt(offset: int) -> byte

    // The bytes from offset `from` up to `until`, a new string. It traps when the offsets are not in
    // order within the string, or when either falls inside a character.
    @intrinsic("string_slice")
    slice(from: int, until: int) -> string

    // The offset of the first `needle` at or after `from`, or -1 when there is none.
    @intrinsic("string_find")
    private find(needle: string, from: int) -> int

    // The string written `count` times over: empty for zero, and a trap for a negative count.
    @intrinsic("string_repeat")
    repeat(count: int) -> string

    // The number the string writes, correctly rounded, or not-a-number when the string is not a
    // number or the number is not finite.
    @intrinsic("string_parse_real")
    private parseReal() -> real

    // The offset of the first `needle`, or None. An empty needle is found at offset 0.
    indexOf(needle: string) -> Option[int] = indexOf(needle, 0)

    // The offset of the first `needle` at or after `from`, or None. A `from` below 0 starts at 0, and
    // one past the end finds nothing; an empty needle is found at `from` itself.
    indexOf(needle: string, from: int) -> Option[int]
        val at = find(needle, from)
        if at < 0 then None else Some(at)

    // The offset of the last `needle`, or None. An empty needle is found at the end of the string.
    lastIndexOf(needle: string) -> Option[int]
        var at = byteLength() - needle.byteLength()
        while at >= 0
            if occursAt(needle, at) then return Some(at)
            at -= 1
        None

    // The number the string writes in decimal, with an optional leading `-` or `+` and at least one
    // digit, and nothing else: no white space, separators or exponent. None when it is not that or
    // does not fit a `long`.
    toLong() -> Option[long]
        val n = byteLength()
        var i = 0
        var negative = false
        if n > 0
            val sign = int(byteAt(0))
            negative = sign == 0x2d
            if negative || sign == 0x2b then i = 1
        if i == n then return None
        val least = long(-9223372036854775807) - 1
        // The value builds on the negative side, which holds every `long` including the least.
        var acc: long = 0
        while i < n
            val digit = long(int(byteAt(i))) - 0x30
            if digit < 0 || digit > 9 then return None
            if acc < least / 10 then return None
            acc = acc * 10
            if acc < least + digit then return None
            acc -= digit
            i += 1
        if negative then return Some(acc)
        if acc == least then None else Some(-acc)

    // As `toLong`, and None when the number does not fit an `int`.
    toInt() -> Option[int]
        val v = toLong()?
        if v < long(-2147483647) - 1 || v > 2147483647 then return None
        Some(int(v))

    // The number the string writes as a decimal fraction, `3.25`, `-.5`, `1e10`, correctly rounded; None
    // when the string is not one, or the number is too large to be finite.
    toReal() -> Option[real]
        val r = parseReal()
        if r == r then Some(r) else None

    isEmpty() -> bool = byteLength() == 0

    nonEmpty() -> bool = byteLength() != 0

    startsWith(prefix: string) -> bool = occursAt(prefix, 0)

    // Whether `prefix` occurs at byte offset `at`: false when it would reach outside the string.
    startsWith(prefix: string, at: int) -> bool = occursAt(prefix, at)

    endsWith(suffix: string) -> bool = occursAt(suffix, byteLength() - suffix.byteLength())

    contains(needle: string) -> bool = find(needle, 0) >= 0

    // The number of characters: the bytes that begin one, which every byte but a continuation does.
    charCount() -> int
        val n = byteLength()
        var count = 0
        var i = 0
        while i < n
            if (byteAt(i) & 0xc0) != 0x80 then count += 1
            i += 1
        count

    // Each character mapped to its upper case, one for one: `ß` has no single upper-case character,
    // so it stays as it is.
    toUpper() -> string = upperText(self)

    toLower() -> string = lowerText(self)

    // Every occurrence of `old`, left to right and not overlapping, replaced by `new`. An empty `old`
    // occurs nowhere, so the string is returned as it is.
    replace(old: string, new: string) -> string = replaceText(self, old, new)

    // The string without the white space at either end: the characters Unicode gives the property
    // White_Space, such as the no-break and ideographic spaces as well as ASCII's.
    trim() -> string
        val from = spaceBefore()
        if from == byteLength() then return ""
        slice(from, spaceAfter())

    trimStart() -> string = slice(spaceBefore(), byteLength())

    trimEnd() -> string = slice(0, spaceAfter())

    // The characters, in order.
    chars() -> Vector[char]
        val b = Vector.builder[char]()
        val n = byteLength()
        var i = 0
        while i < n
            val c = charAt(i)
            b.add(c)
            i += encodedLength(c)
        b.result()

    // The number of characters satisfying `p`.
    count(p: (char) -> bool) -> int
        val n = byteLength()
        var total = 0
        var i = 0
        while i < n
            val c = charAt(i)
            if p(c) then total += 1
            i += encodedLength(c)
        total

    // The pieces between the occurrences of `separator`, left to right and not overlapping. Empty
    // pieces are kept, so `"a,,b,".split(",")` is `["a", "", "b", ""]` and a string without the
    // separator is one piece. An empty separator is a trap.
    split(separator: string) -> Vector[string]
        if separator.byteLength() == 0 then fail("split by an empty separator")
        val b = Vector.builder[string]()
        var from = 0
        var at = find(separator, 0)
        while at >= 0
            b.add(slice(from, at))
            from = at + separator.byteLength()
            at = find(separator, from)
        b.add(slice(from, byteLength()))
        b.result()

    // The lines, each ended by `\n` or `\r\n`, without the terminator. The last line need not be
    // terminated, but a terminator at the very end starts no further line, so `"a\nb\n".lines()` is
    // `["a", "b"]`, `"a\n\nb"` has an empty middle line and the empty string has no lines. A `\r`
    // not followed by `\n` is part of its line.
    lines() -> Vector[string]
        val b = Vector.builder[string]()
        val n = byteLength()
        var from = 0
        while from < n
            var at = find("\n", from)
            if at < 0
                b.add(slice(from, n))
                from = n
            else
                val stop = if at > from && byteAt(at - 1) == 0x0d then at - 1 else at
                b.add(slice(from, stop))
                from = at + 1
        b.result()

    // Whether it has no characters other than white space (so the empty string is blank).
    isBlank() -> bool = spaceBefore() == byteLength()

    // The string with its characters in the opposite order.
    reverse() -> string
        val b = Vector.builder[string]()
        var past = byteLength()
        while past > 0
            val start = characterBefore(past)
            b.add(slice(start, past))
            past = start
        b.result().mkString("")

    // At least `width` characters, `ch` repeated in front as often as it takes; the width counts
    // characters, not bytes, and a string already that long is returned as it is.
    padStart(width: int, ch: char = ' ') -> string
        val short = width - charCount()
        if short <= 0 then self else ch.toString().repeat(short) + self

    // As `padStart`, with the padding after the string.
    padEnd(width: int, ch: char = ' ') -> string
        val short = width - charCount()
        if short <= 0 then self else self + ch.toString().repeat(short)

    // Whether the two are the same once each character is mapped to its lower case, one for one.
    equalsIgnoreCase(other: string) -> bool = toLower() == other.toLower()

    // The first `n` characters, all of them when there are fewer, none for `n` of 0 or less.
    take(n: int) -> string = slice(0, offsetAfter(n))

    // All but the first `n` characters.
    drop(n: int) -> string = slice(offsetAfter(n), byteLength())

    // The last `n` characters, all of them when there are fewer, none for `n` of 0 or less.
    takeRight(n: int) -> string = slice(offsetBefore(n), byteLength())

    // All but the last `n` characters.
    dropRight(n: int) -> string = slice(0, offsetBefore(n))

    // The offset just past the first `n` characters, or the length when there are fewer.
    private offsetAfter(n: int) -> int
        val len = byteLength()
        var i = 0
        var left = n
        while left > 0 && i < len
            i += encodedLength(charAt(i))
            left -= 1
        i

    // The offset where the last `n` characters begin, or 0 when there are fewer.
    private offsetBefore(n: int) -> int
        var i = byteLength()
        var left = n
        while left > 0 && i > 0
            i = characterBefore(i)
            left -= 1
        i

    // The offset where the character ending at `past` begins.
    private characterBefore(past: int) -> int
        var start = past - 1
        while (byteAt(start) & 0xc0) == 0x80
            start -= 1
        start

    // Whether `part` occurs at byte offset `at`.
    private occursAt(part: string, at: int) -> bool
        val n = part.byteLength()
        if at < 0 || at > byteLength() - n then return false
        var i = 0
        while i < n
            if byteAt(at + i) != part.byteAt(i) then return false
            i += 1
        true

    // The offset of the first character that is not white space, or the length when there is none.
    private spaceBefore() -> int
        val n = byteLength()
        var i = 0
        while i < n
            val c = charAt(i)
            if !isSpace(c) then return i
            i += encodedLength(c)
        n

    // The offset just past the last character that is not white space, or 0 when there is none.
    private spaceAfter() -> int
        var past = byteLength()
        while past > 0
            var start = past - 1
            while (byteAt(start) & 0xc0) == 0x80
                start -= 1
            if !isSpace(charAt(start)) then return past
            past = start
        0

    // The character whose encoding begins at byte offset `at`, which traps when `at` is not inside
    // the string.
    charAt(at: int) -> char
        val b = int(byteAt(at))
        if b < 0x80 then return char(b)
        if b < 0xe0 then return char(((b & 0x1f) << 6) | following(at + 1))
        if b < 0xf0 then return char(((b & 0x0f) << 12) | (following(at + 1) << 6) | following(at + 2))
        char(((b & 0x07) << 18) | (following(at + 1) << 12) | (following(at + 2) << 6) | following(at + 3))

    // The six bits a continuation byte at `at` carries.
    private following(at: int) -> int = int(byteAt(at)) & 0x3f

// The number of bytes UTF-8 encodes `c` in.
private encodedLength(c: char) -> int
    val code = int(c)
    if code < 0x80 then return 1
    if code < 0x800 then return 2
    if code < 0x10000 then 3 else 4
