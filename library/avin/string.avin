module avin

// The methods of `string`. A string is immutable UTF-8; offsets into it count bytes, and an offset
// that falls inside a character's encoding is not a place in the text, so slicing at one traps.
// Searching, comparing and trimming walk bytes, which is exact for UTF-8: a character's encoding
// never begins inside another's.

@sysl("sysl.text.to_upper")
private upperText(s: string) -> string

@sysl("sysl.text.to_lower")
private lowerText(s: string) -> string

@sysl("sysl.text.replace_all")
private replaceText(s: string, old: string, new: string) -> string

@sysl("sysl.unicode.is_space")
private isSpace(c: char) -> bool

// Why bytes are not UTF-8: `offset` is where the first sequence that is not a character begins, and
// `truncated` says the bytes end inside a sequence, which more bytes could complete, rather than
// holding one that no continuation could make a character.
@sysl("sysl.text.Utf8Error")
data Utf8Error(offset: long, truncated: bool)

@sysl("sysl.text.from_utf8")
private decodeUtf8(bytes: Array[byte]) -> Result[string, Utf8Error]

@sysl("sysl.text.from_utf8_lossy")
private decodeUtf8Lossy(bytes: Array[byte]) -> string

impl string
    // The text the bytes encode, or where and why they are not UTF-8. A string's bytes are always
    // valid UTF-8: an overlong encoding, a surrogate, a value past U+10FFFF, a stray continuation
    // byte or a sequence the bytes end inside is refused.
    static fromUtf8(bytes: Array[byte]) -> Result[string, Utf8Error] = decodeUtf8(bytes)

    // The text the bytes encode, with U+FFFD, the replacement character, in place of each maximal
    // run that begins a sequence and cannot be completed, so every array of bytes gives a string: a
    // three-byte sequence cut off by the end of the bytes is one replacement, a stray continuation
    // byte another.
    static fromUtf8Lossy(bytes: Array[byte]) -> string = decodeUtf8Lossy(bytes)

    // The number of bytes of the string's encoding, read from the string itself.
    @intrinsic("string_byte_length")
    byteLength() -> int

    // The byte at `offset`, which traps when it is not inside the string.
    @intrinsic("string_byte_at")
    byteAt(offset: int) -> byte

    // The bytes from offset `from` up to `until`, a new string. It traps when the offsets are not in
    // order within the string, or when either falls inside a character.
    @intrinsic("string_slice")
    slice(from: int, until: int) -> string

    // The offset of the first `needle` at or after `from`, or -1 when there is none.
    @intrinsic("string_find")
    private find(needle: string, from: int) -> int

    // The string written `count` times over: empty for zero, and a trap for a negative count.
    @intrinsic("string_repeat")
    repeat(count: int) -> string

    // The number the string writes, correctly rounded, or not-a-number when the string is not a
    // number or the number is not finite.
    @intrinsic("string_parse_real")
    private parseReal() -> real

    // The offset of the first `needle`, or -1 when there is none. An empty needle is found at offset 0.
    indexOf(needle: string) -> int = find(needle, 0)

    // The offset of the first `needle` at or after `from`, or -1 when there is none. A `from` below 0
    // starts at 0, and one past the end finds nothing; an empty needle is found at `from` itself.
    indexOf(needle: string, from: int) -> int = find(needle, from)

    // The offset of the last `needle`, or -1 when there is none. An empty needle is found at the end
    // of the string.
    lastIndexOf(needle: string) -> int = lastIndexOf(needle, byteLength())

    // The offset of the last `needle` that begins at or before `end`, or -1 when there is none. An
    // `end` past the end of the string searches all of it.
    lastIndexOf(needle: string, end: int) -> int
        val latest = byteLength() - needle.byteLength()
        var at = if end < latest then end else latest
        while at >= 0
            if occursAt(needle, at) then return at
            at -= 1
        -1

    // The offset of the first character that satisfies `p`, or -1 when none does.
    indexWhere(p: (char) -> bool) -> int = indexWhere(p, 0)

    // The offset of the first character at or after offset `from` that satisfies `p`, or -1 when none
    // does. A `from` below 0 starts at 0; otherwise it is the offset where a character begins.
    indexWhere(p: (char) -> bool, from: int) -> int
        val n = byteLength()
        var i = if from < 0 then 0 else from
        while i < n
            val c = charAt(i)
            if p(c) then return i
            i += encodedLength(c)
        -1

    // The offset of the first `c`, or -1 when there is none.
    indexOf(c: char) -> int = find(c.toString(), 0)

    // The offset of the first `c` at or after `from`, or -1 when there is none. A `from` below 0
    // starts at 0.
    indexOf(c: char, from: int) -> int = find(c.toString(), from)

    // The offset of the last `c`, or -1 when there is none.
    lastIndexOf(c: char) -> int = lastIndexOf(c.toString(), byteLength())

    // The offset of the last `c` that begins at or before `end`, or -1 when there is none.
    lastIndexOf(c: char, end: int) -> int = lastIndexOf(c.toString(), end)

    // The offset of the last character that satisfies `p`, or -1 when none does.
    lastIndexWhere(p: (char) -> bool) -> int = lastIndexWhere(p, byteLength())

    // The offset of the last character beginning at or before offset `end` that satisfies `p`, or -1
    // when none does. An `end` past the end of the string searches all of it, and one below 0 finds
    // nothing.
    lastIndexWhere(p: (char) -> bool, end: int) -> int
        if end < 0 then return -1
        var past = if end >= byteLength() then byteLength() else end + 1
        while past > 0
            val start = characterBefore(past)
            if p(charAt(start)) then return start
            past = start
        -1

    // The number the string writes in decimal, with an optional leading `-` or `+` and at least one
    // digit, and nothing else: no white space, separators or exponent. It traps when the string is
    // not that or the number does not fit a `long`; `toLongOption` answers None instead.
    toLong() -> long
        if toLongOption() is Some(n) then return n
        notANumber(self)

    // As `toLong`, and a trap when the number does not fit an `int`.
    toInt() -> int
        if toIntOption() is Some(n) then return n
        notANumber(self)

    // The number the string writes as a decimal fraction, `3.25`, `-.5`, `1e10`, correctly rounded. It
    // traps when the string is not one, or the number is too large to be finite; `toRealOption`
    // answers None instead.
    toReal() -> real
        if toRealOption() is Some(x) then return x
        notANumber(self)

    // The number `toLong` reads, or None when the string is not that or does not fit a `long`.
    toLongOption() -> Option[long]
        val n = byteLength()
        var i = 0
        var negative = false
        if n > 0
            val sign = int(byteAt(0))
            negative = sign == 0x2d
            if negative || sign == 0x2b then i = 1
        if i == n then return None
        val least = long(-9223372036854775807) - 1
        // The value builds on the negative side, which holds every `long` including the least.
        var acc: long = 0
        while i < n
            val digit = long(int(byteAt(i))) - 0x30
            if digit < 0 || digit > 9 then return None
            if acc < least / 10 then return None
            acc = acc * 10
            if acc < least + digit then return None
            acc -= digit
            i += 1
        if negative then return Some(acc)
        if acc == least then None else Some(-acc)

    // As `toLongOption`, and None when the number does not fit an `int`.
    toIntOption() -> Option[int]
        val v = toLongOption()?
        if v < long(-2147483647) - 1 || v > 2147483647 then return None
        Some(int(v))

    // The number `toReal` reads, or None when the string is not one or the number is too large to be
    // finite.
    toRealOption() -> Option[real]
        val r = parseReal()
        if r == r then Some(r) else None

    isEmpty() -> bool = byteLength() == 0

    nonEmpty() -> bool = byteLength() != 0

    startsWith(prefix: string) -> bool = occursAt(prefix, 0)

    // Whether `prefix` occurs at byte offset `at`: false when it would reach outside the string.
    startsWith(prefix: string, at: int) -> bool = occursAt(prefix, at)

    endsWith(suffix: string) -> bool = occursAt(suffix, byteLength() - suffix.byteLength())

    contains(needle: string) -> bool = find(needle, 0) >= 0

    // The number of characters: the bytes that begin one, which every byte but a continuation does.
    charCount() -> int
        val n = byteLength()
        var count = 0
        var i = 0
        while i < n
            if (byteAt(i) & 0xc0) != 0x80 then count += 1
            i += 1
        count

    // Each character mapped to its upper case, one for one: `ß` has no single upper-case character,
    // so it stays as it is.
    toUpperCase() -> string = upperText(self)

    toLowerCase() -> string = lowerText(self)

    // Every occurrence of `old`, left to right and not overlapping, replaced by `new`. An empty `old`
    // occurs nowhere, so the string is returned as it is.
    replace(old: string, new: string) -> string = replaceText(self, old, new)

    // The string without the control characters and spaces at either end: every character up to
    // U+0020. `strip` removes white space of every kind instead.
    trim() -> string
        val n = byteLength()
        var from = 0
        while from < n && int(byteAt(from)) <= 0x20
            from += 1
        var past = n
        while past > from && int(byteAt(past - 1)) <= 0x20
            past -= 1
        slice(from, past)

    // The string without the white space at either end: the characters Unicode gives the property
    // White_Space, such as the no-break and ideographic spaces as well as ASCII's.
    strip() -> string
        val from = spaceBefore()
        if from == byteLength() then return ""
        slice(from, spaceAfter())

    // The string without the white space, as `strip` reads it, at its start.
    stripLeading() -> string = slice(spaceBefore(), byteLength())

    // The string without the white space at its end.
    stripTrailing() -> string = slice(0, spaceAfter())

    // The string without `prefix` at its start, or the string as it is when it does not start so.
    stripPrefix(prefix: string) -> string = if startsWith(prefix) then slice(prefix.byteLength(), byteLength()) else self

    // The string without `suffix` at its end, or the string as it is when it does not end so.
    stripSuffix(suffix: string) -> string = if endsWith(suffix) then slice(0, byteLength() - suffix.byteLength()) else self

    // The string with its first character mapped to its upper case when that character is a lower-case
    // one, and as it is otherwise.
    capitalize() -> string
        if isEmpty() then return self
        val c = charAt(0)
        if !c.isLower() then return self
        c.toUpper().toString() + slice(encodedLength(c), byteLength())

    // Each line without its leading margin: the control characters and spaces at its start followed
    // by `|`, which are removed with the `|`. A line whose first character past those is not `|` is
    // kept as it is, and the line terminators are kept.
    stripMargin() -> string = stripMargin('|')

    // As `stripMargin()`, with `marginChar` marking the margin.
    stripMargin(marginChar: char) -> string
        val b = Vector.newBuilder[string]()
        val n = byteLength()
        var from = 0
        while from < n
            val at = find("\n", from)
            val past = if at < 0 then n else at + 1
            var i = from
            while i < past && int(byteAt(i)) <= 0x20
                i += 1
            if i < past && charAt(i) == marginChar
                b.addOne(slice(i + encodedLength(marginChar), past))
            else
                b.addOne(slice(from, past))
            from = past
        b.result().mkString("")

    // The first character; traps when the string is empty.
    head() -> char
        if isEmpty() then fail("head of empty string")
        charAt(0)

    // The last character; traps when the string is empty.
    last() -> char
        if isEmpty() then fail("last of empty string")
        charAt(characterBefore(byteLength()))

    // The first character, or None when the string is empty.
    headOption() -> Option[char] = if isEmpty() then None else Some(charAt(0))

    // The last character, or None when the string is empty.
    lastOption() -> Option[char] = if isEmpty() then None else Some(charAt(characterBefore(byteLength())))

    // The characters, in order.
    chars() -> Vector[char]
        val b = Vector.newBuilder[char]()
        val n = byteLength()
        var i = 0
        while i < n
            val c = charAt(i)
            b.addOne(c)
            i += encodedLength(c)
        b.result()

    // The bytes of the string's encoding, in order.
    bytes() -> Vector[byte]
        val b = Vector.newBuilder[byte]()
        for i in 0..<byteLength()
            b.addOne(byteAt(i))
        b.result()

    // The number of characters satisfying `p`.
    count(p: (char) -> bool) -> int
        val n = byteLength()
        var total = 0
        var i = 0
        while i < n
            val c = charAt(i)
            if p(c) then total += 1
            i += encodedLength(c)
        total

    // The pieces between the occurrences of `separator`, left to right and not overlapping. Empty
    // pieces are kept, so `"a,,b,".split(",")` is `["a", "", "b", ""]` and a string without the
    // separator is one piece. An empty separator is a trap.
    split(separator: string) -> Vector[string]
        if separator.byteLength() == 0 then fail("split by an empty separator")
        val b = Vector.newBuilder[string]()
        var from = 0
        var at = find(separator, 0)
        while at >= 0
            b.addOne(slice(from, at))
            from = at + separator.byteLength()
            at = find(separator, from)
        b.addOne(slice(from, byteLength()))
        b.result()

    // The lines, each ended by `\n` or `\r\n`, without the terminator. The last line need not be
    // terminated, but a terminator at the very end starts no further line, so `"a\nb\n".lines()` is
    // `["a", "b"]`, `"a\n\nb"` has an empty middle line and the empty string has no lines. A `\r`
    // not followed by `\n` is part of its line.
    lines() -> Vector[string]
        val b = Vector.newBuilder[string]()
        val n = byteLength()
        var from = 0
        while from < n
            var at = find("\n", from)
            if at < 0
                b.addOne(slice(from, n))
                from = n
            else
                val stop = if at > from && byteAt(at - 1) == 0x0d then at - 1 else at
                b.addOne(slice(from, stop))
                from = at + 1
        b.result()

    // Whether it has no characters other than white space (so the empty string is blank).
    isBlank() -> bool = spaceBefore() == byteLength()

    // The string with its characters in the opposite order.
    reverse() -> string
        val b = Vector.newBuilder[string]()
        var past = byteLength()
        while past > 0
            val start = characterBefore(past)
            b.addOne(slice(start, past))
            past = start
        b.result().mkString("")

    // At least `width` characters, `ch` repeated in front as often as it takes; the width counts
    // characters, not bytes, and a string already that long is returned as it is.
    padStart(width: int, ch: char = ' ') -> string
        val short = width - charCount()
        if short <= 0 then self else ch.toString().repeat(short) + self

    // As `padStart`, with the padding after the string.
    padEnd(width: int, ch: char = ' ') -> string
        val short = width - charCount()
        if short <= 0 then self else self + ch.toString().repeat(short)

    // At least `length` characters, `ch` appended as often as it takes, as a sequence's `padTo` does.
    padTo(length: int, ch: char) -> string = padEnd(length, ch)

    // Whether the two are the same once each character is mapped to its lower case, one for one.
    equalsIgnoreCase(other: string) -> bool = toLowerCase() == other.toLowerCase()

    // The first `n` characters, all of them when there are fewer, none for `n` of 0 or less.
    take(n: int) -> string = slice(0, offsetAfter(n))

    // All but the first `n` characters.
    drop(n: int) -> string = slice(offsetAfter(n), byteLength())

    // The last `n` characters, all of them when there are fewer, none for `n` of 0 or less.
    takeRight(n: int) -> string = slice(offsetBefore(n), byteLength())

    // All but the last `n` characters.
    dropRight(n: int) -> string = slice(0, offsetBefore(n))

    // The offset just past the first `n` characters, or the length when there are fewer.
    private offsetAfter(n: int) -> int
        val len = byteLength()
        var i = 0
        var left = n
        while left > 0 && i < len
            i += encodedLength(charAt(i))
            left -= 1
        i

    // The offset where the last `n` characters begin, or 0 when there are fewer.
    private offsetBefore(n: int) -> int
        var i = byteLength()
        var left = n
        while left > 0 && i > 0
            i = characterBefore(i)
            left -= 1
        i

    // The offset where the character ending at `past` begins.
    private characterBefore(past: int) -> int
        var start = past - 1
        while (byteAt(start) & 0xc0) == 0x80
            start -= 1
        start

    // Whether `part` occurs at byte offset `at`.
    private occursAt(part: string, at: int) -> bool
        val n = part.byteLength()
        if at < 0 || at > byteLength() - n then return false
        var i = 0
        while i < n
            if byteAt(at + i) != part.byteAt(i) then return false
            i += 1
        true

    // The offset of the first character that is not white space, or the length when there is none.
    private spaceBefore() -> int
        val n = byteLength()
        var i = 0
        while i < n
            val c = charAt(i)
            if !isSpace(c) then return i
            i += encodedLength(c)
        n

    // The offset just past the last character that is not white space, or 0 when there is none.
    private spaceAfter() -> int
        var past = byteLength()
        while past > 0
            var start = past - 1
            while (byteAt(start) & 0xc0) == 0x80
                start -= 1
            if !isSpace(charAt(start)) then return past
            past = start
        0

    // The character whose encoding begins at byte offset `at`, which traps when `at` is not inside
    // the string.
    charAt(at: int) -> char
        val b = int(byteAt(at))
        if b < 0x80 then return char(b)
        if b < 0xe0 then return char(((b & 0x1f) << 6) | following(at + 1))
        if b < 0xf0 then return char(((b & 0x0f) << 12) | (following(at + 1) << 6) | following(at + 2))
        char(((b & 0x07) << 18) | (following(at + 1) << 12) | (following(at + 2) << 6) | following(at + 3))

    // The six bits a continuation byte at `at` carries.
    private following(at: int) -> int = int(byteAt(at)) & 0x3f

// The trap of a number read from a string that does not write one.
private notANumber(s: string) -> Nothing = fail(s"For input string: \"$s\"")

// The number of bytes UTF-8 encodes `c` in.
private encodedLength(c: char) -> int
    val code = int(c)
    if code < 0x80 then return 1
    if code < 0x800 then return 2
    if code < 0x10000 then 3 else 4
