module avin.toml

// Reading TOML 1.0 text into a `Toml` table.

import avin.collections.mutable.LinkedMap
import avin.time.{Time, Zoned, date, dateTime, daysInMonth, fixedZone, minutes, time}

// How deeply tables and arrays may nest in the text `parse` reads unless it is told otherwise. The
// document's own table is 0 deep and each table or array inside another one deeper: `a.b = 1` puts the table `a`
// one deep, `[a.b]` the table `b` two deep, and `a = [[1]]` the inner array two deep.
val defaultMaxDepth: int = 128

// The table `text` writes, or the first thing wrong with it, with its line and column. Tables and
// arrays may nest `maxDepth` deep, counting each key of a dotted key and each array.
parse(text: string, maxDepth: int = defaultMaxDepth) -> Result[Toml, TomlError] = TomlReader(text, maxDepth).document()

// As `parse(text)`, for text given as its UTF-8 bytes; bytes that are not UTF-8 are an error at the
// first of them.
parse(bytes: Array[byte], maxDepth: int = defaultMaxDepth) -> Result[Toml, TomlError] = string.fromUtf8(bytes) match
  Ok(text) -> parse(text, maxDepth)
  Err(e) ->
    val offset = int(e.offset)
    Err(errorAt(string.fromUtf8Lossy(bytes.slice(0, offset)), offset, "bytes that are not UTF-8"))

// The error `message` at byte `offset` of `text`, with its line and column counted out.
private errorAt(text: string, offset: int, message: string) -> TomlError
  var line = 1
  var lineStart = 0
  val end = if offset < text.byteLength then offset else text.byteLength
  var i = 0
  while i < end
    if text.byteAt(i) == byte(0x0a)
      line += 1
      lineStart = i + 1
    i += 1
  var column = 1
  i = lineStart
  while i < end
    if (int(text.byteAt(i)) & 0xc0) != 0x80 then column += 1
    i += 1
  TomlError(message, long(line), long(column), long(offset))

// A table as the reader builds it. `defined` is whether a header or a dotted key of an earlier
// section defined it, so no later one may; a table only created on the way to another may still be.
// `path` is its key from the document's top, for messages, and the key of the value an inline table
// is.
private class Node(val depth: int, val path: Vector[string])
  val slots = LinkedMap[string, Slot]()
  var defined = false

  // The table as a value, its members in the order their keys were first written.
  freeze() -> Toml
    val members = Buffer[(string, Toml)]()
    for (k, slot) in slots
      members.addOne((k, slot.value()))
    Table(members.toVector)

// What a key of a table being built holds: a table that may still grow, an array of tables, or a
// finished value (a static array or an inline table among them, which nothing may extend).
private data Slot
  Sub(node: Node)
  Many(nodes: Buffer[Node])
  Leaf(item: Toml)

impl Slot
  value() -> Toml = self match
    Sub(node) -> node.freeze()
    Many(nodes) -> Arr(nodes.toVector.map(n -> n.freeze()))
    Leaf(item) -> item

// A key for a message: its parts joined by `.`, each quoted where it is not bare.
private keyName(parts: Vector[string]) -> string = parts.map(p -> keyText(p)).mkString(".")

// Reads one document from `text`, a byte at a time from `at`.
private class TomlReader(text: string, maxDepth: int)
  private val n: int = text.byteLength
  private var at = 0
  private val root = Node(0, Vector.empty[string]())
  // The table the key/value lines of the current section go into.
  private var current: Node = root
  // The tables dotted keys of the current section made or added to, defined once it ends.
  private val dotted = Buffer[Node]()

  document() -> Result[Toml, TomlError]
    if text.startsWith("\u{feff}") then at = 3
    root.defined = true
    loop
      skipBlank()
      if at >= n then return Ok(root.freeze())
      val c = code(at)
      if c == int('#')
        comment()?
      else if c == int('\n') || c == int('\r')
        newline()?
      else if c == int('[')
        header()?
        endOfLine("a table's header")?
      else
        keyValue(current)?
        endOfLine("a value")?

  private fault(message: string) -> TomlError = errorAt(text, at, message)

  private faultAt(offset: int, message: string) -> TomlError = errorAt(text, offset, message)

  // The byte at `i` as a number, or -1 past the end.
  private code(i: int) -> int = if i < n then int(text.byteAt(i)) else -1

  // What stands at `at`, for a message: the character quoted, or the end of the text.
  private unexpected() -> string
    if at >= n then return "the end of the text"
    val c = text.charAt(at)
    if int(c) < 0x20 || int(c) == 0x7f then s"the control character U+${hex4(int(c))}" else s"'$c'"

  // Spaces and tabs.
  private skipBlank()
    while code(at) == int(' ') || code(at) == int('\t')
      at += 1

  // A comment from its `#` to the end of its line, which holds no control character but a tab.
  private comment() -> Result[unit, TomlError]
    at += 1
    while at < n
      val c = code(at)
      if c == int('\n') || c == int('\r') then return Ok(())
      if (c < 0x20 && c != int('\t')) || c == 0x7f then return Err(fault(s"${unexpected()} in a comment"))
      at += 1
    Ok(())

  // A line feed, or a carriage return and a line feed.
  private newline() -> Result[unit, TomlError]
    if code(at) == int('\r')
      if code(at + 1) != int('\n') then return Err(fault("a carriage return not followed by a line feed"))
      at += 2
    else
      at += 1
    Ok(())

  // After `what`: spaces, a comment, and the end of the line or of the text.
  private endOfLine(what: string) -> Result[unit, TomlError]
    skipBlank()
    if code(at) == int('#') then comment()?
    if at >= n then return Ok(())
    val c = code(at)
    if c == int('\n') || c == int('\r') then return newline()
    Err(fault(s"${unexpected()} after $what, where the line should end"))

  // Spaces, tabs, line ends and comments, as an array may hold between its values.
  private skipSpace() -> Result[unit, TomlError]
    loop
      val c = code(at)
      if c == int(' ') || c == int('\t')
        at += 1
      else if c == int('\n') || c == int('\r')
        newline()?
      else if c == int('#')
        comment()?
      else
        return Ok(())

  // `[key]` or `[[key]]`: the section after it goes into that table, or into a new table at the end
  // of that array of tables.
  private header() -> Result[unit, TomlError]
    val start = at
    at += 1
    val many = code(at) == int('[')
    if many then at += 1
    skipBlank()
    val parts = key()?
    skipBlank()
    if code(at) != int(']') then return Err(fault(s"${unexpected()} in a table's header, where ']' was expected"))
    at += 1
    if many
      if code(at) != int(']') then return Err(
        fault(s"${unexpected()} after an array of tables' header, where ']]' was expected")
      )
      at += 1
    for node in dotted
      node.defined = true
    dotted.clear()
    var t = root
    var i = 0
    while i < parts.length - 1
      t = headerStep(t, parts, i, start)?
      i += 1
    val name = parts.last
    val whole = keyName(parts)
    current = t.slots.get(name) match
      None ->
        val node = fresh(t, name, start)?
        node.defined = true
        if many
          val nodes = Buffer[Node]()
          nodes.addOne(node)
          t.slots.update(name, Many(nodes))
        else
          t.slots.update(name, Sub(node))
        node
      Some(Sub(node)) ->
        if many then return Err(faultAt(start, s"`$whole` is a table, so it cannot be an array of tables"))
        if node.defined then return Err(faultAt(start, s"the table `$whole` is defined twice"))
        node.defined = true
        node
      Some(Many(nodes)) ->
        if !many then return Err(faultAt(start, s"`$whole` is an array of tables, so it cannot be a table"))
        val node = fresh(t, name, start)?
        node.defined = true
        nodes.addOne(node)
        node
      Some(Leaf(item)) ->
        return Err(
          faultAt(
            start,
            s"`$whole` is already ${item.kind}, so it cannot be ${if many then "an array of tables" else "a table"}"
          )
        )
    Ok(())

  // The table `parts(i)` of `t` on the way to a header's own: made where it is missing, the last
  // table of an array of tables.
  private headerStep(t: Node, parts: Vector[string], i: int, start: int) -> Result[Node, TomlError]
    t.slots.get(parts(i)) match
      None ->
        val node = fresh(t, parts(i), start)?
        t.slots.update(parts(i), Sub(node))
        Ok(node)
      Some(Sub(node)) -> Ok(node)
      Some(Many(nodes)) -> Ok(nodes.last)
      Some(Leaf(item)) ->
        Err(faultAt(start, s"`${keyName(parts.take(i + 1))}` is already ${item.kind}, so it cannot hold a table"))

  // A new table inside `t`, unless that nests too deep.
  private fresh(t: Node, name: string, start: int) -> Result[Node, TomlError]
    if t.depth + 1 > maxDepth then return Err(faultAt(start, s"tables and arrays nested more than $maxDepth deep"))
    Ok(Node(t.depth + 1, t.path :+ name))

  // `key = value` into `t`: each part of a dotted key but the last names a table, made where it is
  // missing.
  private keyValue(t: Node) -> Result[unit, TomlError]
    val start = at
    val parts = key()?
    skipBlank()
    if code(at) != int('=') then return Err(fault(s"${unexpected()} after a key, where '=' was expected"))
    at += 1
    skipBlank()
    var table = t
    var i = 0
    while i < parts.length - 1
      table = dottedStep(table, parts, i, start)?
      i += 1
    val name = parts.last
    val whole = table.path :+ name
    if table.slots.contains(name) then return Err(faultAt(start, s"the key `${keyName(whole)}` is defined twice"))
    val item = value(table.depth + 1, whole)?
    table.slots.update(name, Leaf(item))
    Ok(())

  // The table `parts(i)` of `t` that a dotted key goes through: made where it is missing; never one a
  // header or an earlier section defined, an array of tables or a finished value.
  private dottedStep(t: Node, parts: Vector[string], i: int, start: int) -> Result[Node, TomlError]
    val whole = keyName(t.path :+ parts(i))
    t.slots.get(parts(i)) match
      None ->
        val node = fresh(t, parts(i), start)?
        t.slots.update(parts(i), Sub(node))
        dotted.addOne(node)
        Ok(node)
      Some(Sub(node)) ->
        if node.defined then return Err(
          faultAt(start, s"the table `$whole` is already defined, so a dotted key cannot add to it")
        )
        dotted.addOne(node)
        Ok(node)
      Some(Many(_)) -> Err(faultAt(start, s"`$whole` is an array of tables, so a dotted key cannot add to it"))
      Some(Leaf(item)) -> Err(faultAt(start, s"`$whole` is already ${item.kind}, so a dotted key cannot add to it"))

  // A key: one or more simple keys joined by `.`, with spaces allowed around each dot.
  private key() -> Result[Vector[string], TomlError]
    val parts = Buffer[string]()
    loop
      parts.addOne(simpleKey()?)
      skipBlank()
      if code(at) != int('.') then return Ok(parts.toVector)
      at += 1
      skipBlank()

  // A bare key of letters, digits, `_` and `-`, or a quoted one, a basic string or a literal string
  // on one line.
  private simpleKey() -> Result[string, TomlError]
    val c = code(at)
    if c == int('"')
      if text.startsWith("\"\"\"", at) then return Err(fault("a multi-line string cannot be a key"))
      return basicString()
    if c == int('\'')
      if text.startsWith("'''", at) then return Err(fault("a multi-line string cannot be a key"))
      return literalString()
    val start = at
    while isBare(code(at))
      at += 1
    if at == start then return Err(fault(s"${unexpected()} where a key was expected"))
    Ok(text.slice(start, at))

  private isBare(c: int) -> bool =
    int(
      'a'
    ) <= c <= int('z') || int('A') <= c <= int('Z') || int('0') <= c <= int('9') || c == int('_') || c == int('-')

  // A value, which nests `depth` deep where it is an array or an inline table, at the key `path`.
  private value(depth: int, path: Vector[string]) -> Result[Toml, TomlError]
    val c = code(at)
    if c == int('"')
      return Ok(Str(if text.startsWith("\"\"\"", at) then multiLineBasic()? else basicString()?))
    if c == int('\'')
      return Ok(Str(if text.startsWith("'''", at) then multiLineLiteral()? else literalString()?))
    if c == int('[') then return array(depth, path)
    if c == int('{') then return inlineTable(depth, path)
    if text.startsWith("true", at) && !isBare(code(at + 4))
      at += 4
      return Ok(Bool(true))
    if text.startsWith("false", at) && !isBare(code(at + 5))
      at += 5
      return Ok(Bool(false))
    if looksLikeDate() || looksLikeTime() then return dateOrTime()
    if int(
      '0'
    ) <= c <= int('9') || c == int('+') || c == int('-') || c == int('i') || c == int('n') then return number()
    Err(fault(s"${unexpected()} where a value was expected"))

  private isDigitAt(i: int) -> bool = int('0') <= code(i) <= int('9')

  // Whether `YYYY-` or `hh:` stands at `at`.
  private looksLikeDate() -> bool =
    isDigitAt(at) && isDigitAt(at + 1) && isDigitAt(at + 2) && isDigitAt(at + 3) && code(at + 4) == int('-')

  private looksLikeTime() -> bool = isDigitAt(at) && isDigitAt(at + 1) && code(at + 2) == int(':')

  // `[ value, … ]` over any number of lines, a comma after the last value allowed.
  private array(depth: int, path: Vector[string]) -> Result[Toml, TomlError]
    if depth > maxDepth then return Err(fault(s"tables and arrays nested more than $maxDepth deep"))
    at += 1
    val items = Buffer[Toml]()
    loop
      skipSpace()?
      if code(at) == int(']')
        at += 1
        return Ok(Arr(items.toVector))
      items.addOne(value(depth + 1, path)?)
      skipSpace()?
      val c = code(at)
      if c == int(',')
        at += 1
      else if c == int(']')
        at += 1
        return Ok(Arr(items.toVector))
      else
        return Err(fault(s"${unexpected()} in an array, where ',' or ']' was expected"))

  // `{ key = value, … }` on one line, with no comma after the last pair. Nothing may add to it
  // later.
  private inlineTable(depth: int, path: Vector[string]) -> Result[Toml, TomlError]
    if depth > maxDepth then return Err(fault(s"tables and arrays nested more than $maxDepth deep"))
    at += 1
    val node = Node(depth, path)
    skipBlank()
    if code(at) == int('}')
      at += 1
      return Ok(node.freeze())
    loop
      skipBlank()
      if code(at) == int('}') then return Err(fault("unexpected '}' after ',' in an inline table"))
      keyValue(node)?
      skipBlank()
      val c = code(at)
      if c == int(',')
        at += 1
      else if c == int('}')
        at += 1
        return Ok(node.freeze())
      else if c == int('\n') || c == int('\r')
        return Err(fault("an inline table is written on one line"))
      else
        return Err(fault(s"${unexpected()} in an inline table, where ',' or '}' was expected"))

  // Whether the byte `c` is a control character a string may not hold as it stands: any below a
  // space but the tab, and DEL.
  private isControl(c: int) -> bool = (c < 0x20 && c != int('\t')) || c == 0x7f

  // A basic string, `"…"`, on one line, with escapes.
  private basicString() -> Result[string, TomlError]
    at += 1
    val out = StringWriter()
    var run = at
    loop
      val c = code(at)
      if c < 0 then return Err(fault("the end of the text inside a string, where '\"' was expected"))
      if c == int('"')
        out.write(text.slice(run, at))
        at += 1
        return Ok(out.text)
      if c == int('\\')
        out.write(text.slice(run, at))
        escape(out)?
        run = at
      else if c == int('\n') || c == int('\r')
        return Err(fault("a line end inside a string, where '\"' was expected"))
      else if isControl(c)
        return Err(fault(s"${unexpected()} in a string, which must be written as an escape"))
      else
        at += 1

  // A multi-line basic string, `"""…"""`: a line end right after the opening quotes is left out, a
  // backslash at the end of a line takes it and the white space after it away, and one or two
  // quotes may stand anywhere, the closing ones included.
  private multiLineBasic() -> Result[string, TomlError]
    at += 3
    skipFirstLineEnd()
    val out = StringWriter()
    var run = at
    loop
      val c = code(at)
      if c < 0 then return Err(fault("the end of the text inside a multi-line string, where '\"\"\"' was expected"))
      if c == int('"')
        var q = 0
        while code(at + q) == int('"')
          q += 1
        if q < 3
          at += q
        else
          if q > 5 then return Err(faultAt(at + 5, "more than five quotes at the end of a multi-line string"))
          out.write(text.slice(run, at + q - 3))
          at += q
          return Ok(out.text)
      else if c == int('\\')
        out.write(text.slice(run, at))
        var j = at + 1
        while code(j) == int(' ') || code(j) == int('\t')
          j += 1
        if code(j) == int('\n') || (code(j) == int('\r') && code(j + 1) == int('\n'))
          at = j
          loop
            val d = code(at)
            if d == int(' ') || d == int('\t') || d == int('\n')
              at += 1
            else if d == int('\r') && code(at + 1) == int('\n')
              at += 2
            else
              break
        else
          escape(out)?
        run = at
      else if c == int('\r')
        if code(at + 1) != int('\n') then return Err(fault("a carriage return not followed by a line feed"))
        at += 2
      else if c != int('\n') && isControl(c)
        return Err(fault(s"${unexpected()} in a string, which must be written as an escape"))
      else
        at += 1

  // A literal string, `'…'`, on one line, every character as it stands.
  private literalString() -> Result[string, TomlError]
    at += 1
    val start = at
    loop
      val c = code(at)
      if c < 0 then return Err(fault("the end of the text inside a literal string, where \"'\" was expected"))
      if c == int('\'')
        at += 1
        return Ok(text.slice(start, at - 1))
      if c == int('\n') || c == int('\r') then return Err(
        fault("a line end inside a literal string, where \"'\" was expected")
      )
      if isControl(c) then return Err(fault(s"${unexpected()} in a literal string"))
      at += 1

  // A multi-line literal string, `'''…'''`, every character as it stands but a line end right after
  // the opening quotes; one or two quotes may stand anywhere, the closing ones included.
  private multiLineLiteral() -> Result[string, TomlError]
    at += 3
    skipFirstLineEnd()
    val start = at
    loop
      val c = code(at)
      if c < 0 then return Err(
        fault("the end of the text inside a multi-line literal string, where \"'''\" was expected")
      )
      if c == int('\'')
        var q = 0
        while code(at + q) == int('\'')
          q += 1
        if q >= 3
          if q > 5 then return Err(faultAt(at + 5, "more than five quotes at the end of a multi-line literal string"))
          val body = text.slice(start, at + q - 3)
          at += q
          return Ok(body)
        at += q
      else if c == int('\r')
        if code(at + 1) != int('\n') then return Err(fault("a carriage return not followed by a line feed"))
        at += 2
      else if c != int('\n') && isControl(c)
        return Err(fault(s"${unexpected()} in a literal string"))
      else
        at += 1

  private skipFirstLineEnd()
    if code(at) == int('\n')
      at += 1
    else if code(at) == int('\r') && code(at + 1) == int('\n')
      at += 2

  // The escape at `at`, a backslash and what follows it, written to `out`.
  private escape(out: StringWriter) -> Result[unit, TomlError]
    val start = at
    at += 1
    val c = code(at)
    at += 1
    if c == int('b') then out.writeChar('\u{8}')
    else if c == int('t') then out.writeChar('\t')
    else if c == int('n') then out.writeChar('\n')
    else if c == int('f') then out.writeChar('\u{c}')
    else if c == int('r') then out.writeChar('\r')
    else if c == int('"') then out.writeChar('"')
    else if c == int('\\') then out.writeChar('\\')
    else if c == int('u') || c == int('U')
      val count = if c == int('u') then 4 else 8
      var v = 0
      var k = 0
      while k < count
        val d = hexValue(code(at))
        if d < 0 then return Err(faultAt(start, s"\\${char(c)} needs $count hexadecimal digits"))
        v = v * 16 + d
        if v > 0x10ffff then return Err(faultAt(start, "the escape names no Unicode character"))
        at += 1
        k += 1
      if 0xd800 <= v <= 0xdfff then return Err(
        faultAt(start, "the escape names a surrogate, which is no Unicode character")
      )
      out.writeChar(char(v))
    else
      at = start
      return Err(
        fault(
          if c < 0 then "the end of the text after '\\'" else s"the escape '\\${text.charAt(start + 1)}' is not one TOML has"
        )
      )
    Ok(())

  // A local date, a local date-time or an offset date-time, from `YYYY-MM-DD`; or a local time,
  // from `hh:mm:ss`.
  private dateOrTime() -> Result[Toml, TomlError]
    val start = at
    if code(at + 2) == int(':')
      val t = clock(start)?
      return Ok(LocalTime(t))
    val year = digits(4, "the year's four digits")?
    expect('-', "'-' after the year")?
    val month = digits(2, "the month's two digits")?
    expect('-', "'-' after the month")?
    val day = digits(2, "the day's two digits")?
    if !(1 <= month <= 12) || !(1 <= day <= daysInMonth(long(year), month))
      return Err(faultAt(start, s"there is no such date: ${text.slice(start, at)}"))
    val d = date(year, month, day)
    val sep = code(at)
    val timed = sep == int('T') || sep == int('t') || (
      sep == int(' ') && isDigitAt(at + 1) && isDigitAt(at + 2) && code(at + 3) == int(':')
    )
    if !timed then return Ok(LocalDate(d))
    at += 1
    val t = clock(start)?
    val reading = dateTime(d, t)
    val z = code(at)
    if z == int('Z') || z == int('z')
      at += 1
      return Ok(OffsetDateTime(Zoned(reading, minutes(0), fixedZone(minutes(0)))))
    if z == int('+') || z == int('-')
      at += 1
      val hours = digits(2, "the offset's two digits of hours")?
      expect(':', "':' in the offset")?
      val mins = digits(2, "the offset's two digits of minutes")?
      if hours > 23 || mins > 59 then return Err(
        faultAt(start, s"the offset of ${text.slice(start, at)} is outside ±23:59")
      )
      val total = long(hours * 60 + mins)
      val offset = minutes(if z == int('-') then -total else total)
      return Ok(OffsetDateTime(Zoned(reading, offset, fixedZone(offset))))
    Ok(LocalDateTime(reading))

  // `hh:mm:ss` with an optional fraction of a second, cut off after the sixth digit.
  private clock(start: int) -> Result[Time, TomlError]
    val hour = digits(2, "the hour's two digits")?
    expect(':', "':' after the hour")?
    val minute = digits(2, "the minute's two digits")?
    expect(':', "':' after the minutes, and the seconds")?
    val second = digits(2, "the second's two digits")?
    var micros = 0
    if code(at) == int('.')
      at += 1
      if !isDigitAt(at) then return Err(fault("a digit after the '.' of a second's fraction"))
      var k = 0
      while isDigitAt(at)
        if k < 6 then micros = micros * 10 + (code(at) - int('0'))
        k += 1
        at += 1
      while k < 6
        micros *= 10
        k += 1
    if hour > 23 || minute > 59 || second > 59
      return Err(faultAt(start, s"there is no such time of day: ${text.slice(start, at)}"))
    Ok(time(hour, minute, second, micros))

  private digits(count: int, what: string) -> Result[int, TomlError]
    var v = 0
    var k = 0
    while k < count
      if !isDigitAt(at) then return Err(fault(s"${unexpected()} where $what were expected"))
      v = v * 10 + (code(at) - int('0'))
      at += 1
      k += 1
    Ok(v)

  private expect(c: char, what: string) -> Result[unit, TomlError]
    if code(at) != int(c) then return Err(fault(s"${unexpected()} where $what was expected"))
    at += 1
    Ok(())

  // An integer, decimal with an optional sign or hexadecimal, octal or binary after `0x`, `0o` or
  // `0b`; or a float, `inf` or `nan` with an optional sign. An underscore stands only between two
  // digits.
  private number() -> Result[Toml, TomlError]
    val start = at
    while isNumberChar(code(at)) || (
      (code(at) == int('+') || code(at) == int('-')) && (
        at == start || code(at - 1) == int('e') || code(at - 1) == int('E')
      )
    )
      at += 1
    val word = text.slice(start, at)
    numberOf(word, start)

  private isNumberChar(c: int) -> bool =
    int(
      '0'
    ) <= c <= int('9') || int('a') <= c <= int('z') || int('A') <= c <= int('Z') || c == int('_') || c == int('.')

  private numberOf(word: string, start: int) -> Result[Toml, TomlError]
    val signed = word.startsWith("+") || word.startsWith("-")
    val negative = word.startsWith("-")
    val body = if signed then word.slice(1, word.byteLength) else word
    if body == "inf" then return Ok(Float(if negative then real.NegativeInfinity else real.PositiveInfinity))
    if body == "nan" then return Ok(Float(real.NaN))
    if body.startsWith("0x") || body.startsWith("0o") || body.startsWith("0b")
      if signed then return Err(faultAt(start, s"`$word`: an integer written in another base has no sign"))
      val radix = if body.startsWith("0x") then 16 else if body.startsWith("0o") then 8 else 2
      val digitsText = body.slice(2, body.byteLength)
      if !underscored(digitsText, radix) then return Err(faultAt(start, s"`$word` is not an integer"))
      if digitsText.replace("_", "").toLongOption(radix) is Some(v) then return Ok(Integer(v))
      return Err(faultAt(start, s"`$word` does not fit in a 64-bit integer"))
    // A decimal number: its whole part, then a fraction or an exponent for a float.
    var i = 0
    while i < body.byteLength && body.byteAt(i) != byte(
      int('.')
    ) && body.byteAt(i) != byte(int('e')) && body.byteAt(i) != byte(int('E'))
      i += 1
    val whole = body.slice(0, i)
    if !underscored(whole, 10) then return Err(faultAt(start, s"`$word` is not a number"))
    if whole.byteLength > 1 && whole.startsWith("0") then return Err(
      faultAt(start, s"`$word`: a decimal number has no leading zero")
    )
    val sign = if negative then "-" else ""
    if i == body.byteLength
      if (sign + whole.replace("_", "")).toLongOption() is Some(v) then return Ok(Integer(v))
      return Err(faultAt(start, s"`$word` does not fit in a 64-bit integer"))
    var rest = body.slice(i, body.byteLength)
    var clean = whole.replace("_", "")
    if rest.startsWith(".")
      var j = 1
      while j < rest.byteLength && rest.byteAt(j) != byte(int('e')) && rest.byteAt(j) != byte(int('E'))
        j += 1
      val fraction = rest.slice(1, j)
      if fraction == "" || !underscored(fraction, 10) then return Err(
        faultAt(start, s"`$word`: a float's '.' has digits on both sides")
      )
      clean = clean + "." + fraction.replace("_", "")
      rest = rest.slice(j, rest.byteLength)
    if rest != ""
      val exponent = rest.slice(1, rest.byteLength)
      val unsigned = if exponent.startsWith("+") || exponent.startsWith("-") then exponent.slice(
        1,
        exponent.byteLength
      ) else exponent
      if unsigned == "" || !underscored(unsigned, 10) then return Err(
        faultAt(start, s"`$word`: a float's exponent is digits after 'e'")
      )
      clean = clean + "e" + exponent.replace("_", "")
    (sign + clean).toRealOption() match
      Some(x) -> Ok(Float(x))
      None -> Err(faultAt(start, s"`$word` is too large for a 64-bit float"))

// Whether `text` is one or more digits of `radix`, an underscore standing only between two of them.
private underscored(text: string, radix: int) -> bool
  if text == "" then return false
  var i = 0
  while i < text.byteLength
    val c = int(text.byteAt(i))
    if c == int('_')
      if i == 0 || i == text.byteLength - 1 || int(text.byteAt(i + 1)) == int('_') then return false
    else
      val d = hexValue(c)
      if d < 0 || d >= radix then return false
    i += 1
  true

// The value of the hexadecimal digit `c`, or -1 where it is none.
private hexValue(c: int) -> int =
  if int('0') <= c <= int('9') then c - int('0')
  else if int('a') <= c <= int('f') then c - int('a') + 10
  else if int('A') <= c <= int('F') then c - int('A') + 10
  else -1

// `v` as four upper-case hexadecimal digits.
private hex4(v: int) -> string
  val digits = "0123456789ABCDEF"
  val out = StringWriter()
  var shift = 12
  while shift >= 0
    out.writeChar(digits.charAt((v >> shift) & 0xf))
    shift -= 4
  out.text
