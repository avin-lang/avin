module avin

// A fixed-length, mutable, contiguous sequence. Its elements are stored unboxed, each at its type's
// own width, after the length. `a(i)` reads an element and `a(i) = v` replaces one; an index outside
// `0 ..< length()` traps. An array is a reference with identity, made by `Array.fill`,
// `Array.tabulate` or `Array.empty`, which give every element a value: no element is ever unset.
class Array[T]: Iterable[T]
    @intrinsic("array_length")
    length() -> int

    @intrinsic("array_apply")
    apply(index: int) -> T

    @intrinsic("array_update")
    update(index: int, value: T)

    // A new array of the elements from `from` up to `until`, which traps when the indices are not in
    // order within the array.
    @intrinsic("array_slice")
    slice(from: int, until: int) -> Array[T]

    // A new array of the same elements.
    copy() -> Array[T] = slice(0, length())

    isEmpty() -> bool = length() == 0

    nonEmpty() -> bool = length() != 0

    // The element at `index`, or `None` when there is none.
    get(index: int) -> Option[T] = if 0 <= index < length() then Some(apply(index)) else None

    override iterator() -> Iterator[T] = ArrayIterator(self, 0)

object Array
    // An array of `length` elements, each `value`: one value, shared by every element.
    @trapsAtCaller
    fill[T](length: int, value: T) -> Array[T]
        val a = newArray[T](length)
        var i = 0
        while i < length
            a(i) = value
            i += 1
        a

    // An array of `length` elements, the element at `i` being `f(i)`, computed in index order.
    @trapsAtCaller
    tabulate[T](length: int, f: (int) -> T) -> Array[T]
        val a = newArray[T](length)
        var i = 0
        while i < length
            a(i) = f(i)
            i += 1
        a

    // An array with no elements.
    empty[T]() -> Array[T] = newArray[T](0)

    // A builder of an array: the elements it is given, in order.
    builder[T]() -> ArrayBuilder[T] = ArrayBuilder(Buffer[T](), false)

// Builds an array from the elements given to it, which it keeps in a buffer until `result()`.
class ArrayBuilder[T](private val buffer: Buffer[T], private var spent: bool): Builder[T, Array[T]]
    @trapsAtCaller
    override add(element: T)
        if spent then fail("a builder is spent once it has given its result")
        buffer.add(element)

    @trapsAtCaller
    override result() -> Array[T]
        if spent then fail("a builder is spent once it has given its result")
        spent = true
        buffer.toArray()

// A new array of `length` elements, every byte zero, which traps for a negative length. Its elements
// are not yet values, so it is filled before anything else sees it, or, as a buffer's spare capacity
// is, never read before an element is written to it.
@intrinsic("array_new")
private newArray[T](length: int) -> Array[T]

// Sets the elements of `items` from `from` up to `until` back to zero bytes, so they no longer keep
// anything alive; they are not values again until written. The indices are in order within the
// array.
@intrinsic("array_clear")
private clearElements[T](items: Array[T], from: int, until: int)

// The same array, seen through a type that only reads it. It is for an array that nothing writes to
// any more, and since reading is all it allows, its element type is covariant: a `Vector` keeps its
// elements in one.
@intrinsic("array_freeze")
private freeze[T](items: Array[T]) -> FrozenArray[T]

// An array that is never written again, made by `freeze`. Its operations are the array's own.
private class FrozenArray[+T]
    @intrinsic("array_length")
    length() -> int

    @intrinsic("array_apply")
    apply(index: int) -> T

    // A new array of the elements from `from` up to `until`, which traps when the indices are not in
    // order within the array.
    @intrinsic("array_slice")
    slice(from: int, until: int) -> FrozenArray[T]

// Steps through `items` from `index`.
private class ArrayIterator[T](items: Array[T], private var index: int): Iterator[T]
    override hasNext() -> bool = index < items.length()

    override next() -> T
        if index >= items.length() then fail("next on an exhausted iterator")
        val value = items(index)
        index += 1
        value

// Two arrays are equal when they have the same length and equal elements, in order; `===` compares
// their identities. Every element type compares, so every array does.
impl[T: Eq] Eq for Array[T]
    equals(other: Array[T]) -> bool
        if length() != other.length() then return false
        var i = 0
        while i < length()
            if self(i) != other(i) then return false
            i += 1
        true

// An array's hash combines its elements' hashes in order, so equal arrays hash alike.
impl[T: Hash] Hash for Array[T]
    hash() -> long
        var h: long = 0
        for x in self
            h = h *% 31 +% x.hash()
        h

// An array of displayable elements displays as `[1, 2, 3]`, each element in its own `Display`. A field
// width pads the whole.
impl[T: Display] Display for Array[T]
    display(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            display(text, FormatSpec())
            out.writeField(text.text(), spec)
            return
        out.write("[")
        var i = 0
        while i < length()
            if i > 0 then out.write(", ")
            self(i).display(out, FormatSpec())
            i += 1
        out.write("]")

// An array's diagnostic form is its elements' diagnostic forms in brackets: `["a", "b"]`.
impl[T: Debug] Debug for Array[T]
    debug(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            debug(text, FormatSpec())
            out.writeField(text.text(), spec)
            return
        out.write("[")
        var i = 0
        while i < length()
            if i > 0 then out.write(", ")
            self(i).debug(out, FormatSpec())
            i += 1
        out.write("]")
