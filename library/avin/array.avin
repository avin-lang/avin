module avin

// A fixed-length, mutable, contiguous sequence. Its elements are stored unboxed, each at its type's
// own width, after the length. `a(i)` reads an element and `a(i) = v` replaces one; an index outside
// `0 ..< length` traps. An array is a reference with identity, made by `Array.fill`,
// `Array.tabulate` or `Array.empty`, which give every element a value: no element is ever unset.
class Array[T]: Seq[T]
    @intrinsic("array_length")
    override length -> int

    @intrinsic("array_apply")
    override apply(index: int) -> T

    @intrinsic("array_update")
    update(index: int, value: T)

    // A new array of the elements from `from` up to `until`, which traps when the indices are not in
    // order within the array.
    @intrinsic("array_slice")
    slice(from: int, until: int) -> Array[T]

    // A new array of the same elements.
    copy() -> Array[T] = slice(0, length)

    // A new array of `f` of each element, in order.
    map[U](f: (T) -> U) -> Array[U]
        val b = Array.newBuilder[U]()
        for x in self do b.addOne(f(x))
        b.result()

    // A new array of `pf` of each element it is defined at, in order.
    collect[U](pf: PartialFunction[T, U]) -> Array[U]
        val f = pf.lift()
        val b = Array.newBuilder[U]()
        for x in self
            if f(x) is Some(u) then b.addOne(u)
        b.result()

    // A new array of the elements of the collections `f` makes of each element, joined in order.
    flatMap[U](f: (T) -> Iterable[U]) -> Array[U]
        val b = Array.newBuilder[U]()
        for x in self do b.addAll(f(x))
        b.result()

    // A new array of the elements that satisfy `p`, in order.
    filter(p: (T) -> bool) -> Array[T]
        val b = Array.newBuilder[T]()
        for x in self
            if p(x) then b.addOne(x)
        b.result()

    // A new array of the elements that do not satisfy `p`, in order.
    filterNot(p: (T) -> bool) -> Array[T] = keptInto(self, p, false, Array.newBuilder[T]())

    // The elements that satisfy `p`, tested only as `map`, `flatMap` or `foreach` reaches each one.
    withFilter(p: (T) -> bool) -> FilteredArray[T] = FilteredArray(self, p)

    override iterator() -> Iterator[T] = ArrayIterator(self, 0)

    // Puts the elements in the opposite order.
    reverseInPlace()
        var i = 0
        var j = length - 1
        while i < j
            val x = self(i)
            self(i) = self(j)
            self(j) = x
            i += 1
            j -= 1

    // Replaces each element with `f` of it, in index order.
    mapInPlace(f: (T) -> T)
        var i = 0
        while i < length
            self(i) = f(self(i))
            i += 1

    // Sets every element to `value`: one value, shared by every element, as `Array.fill` shares it.
    fillInPlace(value: T)
        var i = 0
        while i < length
            self(i) = value
            i += 1

    // Copies `count` elements, from index `from` on, into `dest` from index `at` on; `count` is every
    // element from `from` to the end when it is left out. A range outside either array traps before
    // anything is copied. `dest` may be this array itself, the ranges overlapping: the elements land as
    // they were before the call.
    copyTo(dest: Array[T], at: int, from: int = 0, count: int = length - from)
        if from < 0 || from > length || count < 0 || count > length - from then fail("source range out of range")
        if at < 0 || at > dest.length || count > dest.length - at then fail("destination range out of range")
        if dest === self && at > from
            var i = count - 1
            while i >= 0
                dest(at + i) = self(from + i)
                i -= 1
            return
        var i = 0
        while i < count
            dest(at + i) = self(from + i)
            i += 1

    // Reorders the elements in place by `compare`, which is negative, zero or positive as its first
    // argument orders before, with or after its second. The sort is stable.
    sortInPlaceWith(compare: (T, T) -> int) = sortElements(self, length, compare)

    // Reorders the elements in place by their keys, `key` being computed once for each element. The
    // sort is stable.
    sortInPlaceBy[K: Ord](key: (T) -> K) = sortElementsBy(self, length, key)

// An array of ordered elements sorts in place, ascending; the sort is stable.
impl[T: Ord] Array[T]
    sortInPlace() = sortInPlaceWith((x, y) -> x.compare(y))

// An array seen through a test, which a guard of a `for` with `yield` makes: each element is tested
// just before the call after it would use it, so a guard runs in turn with the rest of the
// comprehension, element by element.
class FilteredArray[T](private val array: Array[T], private val p: (T) -> bool)
    // A new array of `f` of each element that passes the test, in order.
    map[U](f: (T) -> U) -> Array[U]
        val b = Array.newBuilder[U]()
        for x in array
            if p(x) then b.addOne(f(x))
        b.result()

    // A new array of the elements of the collections `f` makes of each element that passes the test.
    flatMap[U](f: (T) -> Iterable[U]) -> Array[U]
        val b = Array.newBuilder[U]()
        for x in array
            if p(x) then b.addAll(f(x))
        b.result()

    // The elements that pass this test and then `q`.
    withFilter(q: (T) -> bool) -> FilteredArray[T] = FilteredArray(array, x -> p(x) && q(x))

    // Calls `f` with each element that passes the test, in order.
    foreach(f: (T) -> unit)
        for x in array
            if p(x) then f(x)

object Array
    // An array of `length` elements, each `value`: one value, shared by every element.
    fill[T](length: int, value: T) -> Array[T]
        val a = newArray[T](length)
        var i = 0
        while i < length
            a(i) = value
            i += 1
        publish(a)
        a

    // An array of `length` elements, the element at `i` being `f(i)`, computed in index order.
    tabulate[T](length: int, f: (int) -> T) -> Array[T]
        val a = newArray[T](length)
        var i = 0
        while i < length
            a(i) = f(i)
            i += 1
        publish(a)
        a

    // An array with no elements.
    empty[T]() -> Array[T] = newArray[T](0)

    // A builder of an array: the elements it is given, in order.
    newBuilder[T]() -> ArrayBuilder[T] = ArrayBuilder(Buffer[T](), false)

// Builds an array from the elements given to it, which it keeps in a buffer until `result()`.
class ArrayBuilder[T](private val buffer: Buffer[T], private var spent: bool): Builder[T, Array[T]]
    override addOne(element: T)
        if spent then fail("add to a builder whose result was taken")
        buffer.addOne(element)

    override result() -> Array[T]
        if spent then fail("result of a builder whose result was taken")
        spent = true
        buffer.toArray()

    override clear()
        buffer.clear()
        spent = false

    override sizeHint(size: int) = buffer.sizeHint(size)

    override knownSize -> int = buffer.length

// A new array of `length` elements, every byte zero, which traps for a negative length. Its elements
// are not yet values, so it is filled before anything else sees it, or, as a buffer's spare capacity
// is, never read before an element is written to it.
@intrinsic("array_new")
private newArray[T](length: int) -> Array[T]

// Sets the elements of `items` from `from` up to `until` back to zero bytes, so they no longer keep
// anything alive; they are not values again until written. The indices are in order within the
// array.
@intrinsic("array_clear")
private clearElements[T](items: Array[T], from: int, until: int)

// Ends the filling of an array this code made: a release fence after the element stores, so another
// thread that is handed the array never sees an element before its value. A function that fills a
// new array and lets it escape ends the fill with it.
@intrinsic("array_publish")
private publish[T](items: Array[T])

// The same array, seen through a type that only reads it. It is for an array that nothing writes to
// any more, and since reading is all it allows, its element type is covariant: a `Vector` keeps its
// elements in one.
@intrinsic("array_freeze")
private freeze[T](items: Array[T]) -> FrozenArray[T]

// An array that is never written again, made by `freeze`. Its operations are the array's own.
private class FrozenArray[+T]
    @intrinsic("array_length")
    length -> int

    @intrinsic("array_apply")
    apply(index: int) -> T

    // A new array of the elements from `from` up to `until`, which traps when the indices are not in
    // order within the array.
    @intrinsic("array_slice")
    slice(from: int, until: int) -> FrozenArray[T]

// Steps through `items` from `index`.
private class ArrayIterator[T](items: Array[T], private var index: int): Iterator[T]
    override hasNext() -> bool = index < items.length

    override next() -> T
        if index >= items.length then fail("next on an exhausted iterator")
        val value = items(index)
        index += 1
        value

// An array of displayable elements displays as `[1, 2, 3]`, each element in its own `Display`. A field
// width pads the whole.
impl[T: Display] Display for Array[T]
    display(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            display(text, FormatSpec())
            out.writeField(text.text, spec)
            return
        out.write("[")
        var i = 0
        while i < length
            if i > 0 then out.write(", ")
            self(i).display(out, FormatSpec())
            i += 1
        out.write("]")

// An array's diagnostic form is its elements' diagnostic forms in brackets: `["a", "b"]`.
impl[T: Debug] Debug for Array[T]
    debug(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            debug(text, FormatSpec())
            out.writeField(text.text, spec)
            return
        out.write("[")
        var i = 0
        while i < length
            if i > 0 then out.write(", ")
            self(i).debug(out, FormatSpec())
            i += 1
        out.write("]")
