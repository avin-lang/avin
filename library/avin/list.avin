module avin

// An immutable singly linked list: `Nil`, the empty list, or a `Cons` of a first element and the
// list of the rest. `x :: xs` makes the list with `x` in front of `xs`, sharing `xs`, in constant
// time; `[]` where a list is expected is `Nil`, and `[a, b]` is `a :: b :: []`. The same spellings
// take a list apart in patterns.
//
// Every method walks the list in a loop rather than by recursion, so a list of any length is
// traversed, transformed, compared and hashed without deepening the stack. A method that builds a
// list in order builds it reversed and turns it around at the end.
data List[+T]
    Cons(first: T, rest: List[T])
    Nil

// A list is a sequence, and reaches its elements by walking from its front: every method a sequence
// would write by indexing is written here as one walk, so none takes more than time proportional to
// the list's length.
impl[T] Seq[T] for List[T]
    isEmpty() -> bool = self match
        [] -> true
        _ -> false

    nonEmpty() -> bool = !isEmpty()

    // The first element, which traps on the empty list.
    head() -> T = self match
        x :: _ -> x
        [] -> fail("head of an empty list")

    // The first element, or `None` on the empty list.
    headOption() -> Option[T] = self match
        x :: _ -> Some(x)
        [] -> None

    // The last element, which traps on the empty list.
    last() -> T
        var xs = self
        loop
            xs match
                x :: [] -> return x
                _ :: more -> xs = more
                [] -> fail("last of an empty list")

    // The last element, or `None` on the empty list.
    lastOption() -> Option[T] = self match
        [] -> None
        _ -> Some(last())

    // The number of elements, counted in time proportional to it.
    length() -> int
        var n = 0
        var xs = self
        loop
            xs match
                _ :: more ->
                    n += 1
                    xs = more
                [] -> return n

    // The element at `index`, reached in time proportional to `index`; an index outside
    // `0 ..< length()` traps.
    apply(index: int) -> T = get(index) match
        Some(x) -> x
        None -> fail("list index out of range")

    // The element at `index`, or `None` when there is none.
    get(index: int) -> Option[T]
        if index < 0 then return None
        var i = index
        var xs = self
        loop
            xs match
                x :: more ->
                    if i == 0 then return Some(x)
                    i -= 1
                    xs = more
                [] -> return None

    // `f` applied from the right: `f(x0, f(x1, initial))` and so on; `initial` for the empty list.
    foldRight[B](initial: B, f: (T, B) -> B) -> B
        var acc = initial
        var xs = reverse()
        loop
            xs match
                x :: more ->
                    acc = f(x, acc)
                    xs = more
                [] -> return acc

    // The index of the first element that satisfies `p`, or `None`.
    indexWhere(p: (T) -> bool) -> Option[int]
        var i = 0
        var xs = self
        loop
            xs match
                x :: more ->
                    if p(x) then return Some(i)
                    i += 1
                    xs = more
                [] -> return None

    toVector() -> Vector[T]
        val b = Vector.builder[T]()
        for x in self do b.add(x)
        b.result()

    iterator() -> Iterator[T] = ListIterator(self)

    // Steps through the elements from the last to the first, over a reversed copy of the list.
    reverseIterator() -> Iterator[T] = ListIterator(reverse())

// A list walks itself for these rather than going through an iterator.
impl[T] List[T]
    // `f` applied from the left: `f(f(initial, x0), x1)` and so on; `initial` for the empty list.
    foldLeft[B](initial: B, f: (B, T) -> B) -> B
        var acc = initial
        var xs = self
        loop
            xs match
                x :: more ->
                    acc = f(acc, x)
                    xs = more
                [] -> return acc

    // Calls `f` with each element, in order.
    foreach(f: (T) -> unit)
        var xs = self
        loop
            xs match
                x :: more ->
                    f(x)
                    xs = more
                [] -> return

    // Whether some element satisfies `p`.
    exists(p: (T) -> bool) -> bool = find(p).isSome()

    // Whether every element satisfies `p`; true of the empty list.
    forall(p: (T) -> bool) -> bool = !exists(x -> !p(x))

    // The first element that satisfies `p`, or `None`.
    find(p: (T) -> bool) -> Option[T]
        var xs = self
        loop
            xs match
                x :: more ->
                    if p(x) then return Some(x)
                    xs = more
                [] -> return None

    // How many elements satisfy `p`.
    count(p: (T) -> bool) -> int = foldLeft(0, (n, x) -> if p(x) then n + 1 else n)

    // The list itself.
    toList() -> List[T] = self

    // Every element after the first, which traps on the empty list.
    tail() -> List[T] = self match
        _ :: more -> more
        [] -> fail("tail of an empty list")

    // The elements in the opposite order.
    reverse() -> List[T]
        var out: List[T] = []
        var xs = self
        loop
            xs match
                x :: more ->
                    out = x :: out
                    xs = more
                [] -> return out

    // This list's elements followed by `other`'s, which is shared: `xs ++ ys`.
    ++(other: List[T]) -> List[T] = prependReversed(reverse(), other)

    // The list of `f` of each element, in order.
    map[U](f: (T) -> U) -> List[U]
        var out: List[U] = []
        var xs = self
        loop
            xs match
                x :: more ->
                    out = f(x) :: out
                    xs = more
                [] -> return out.reverse()

    // The list of `pf` of each element it is defined at, in order.
    collect[U](pf: PartialFunction[T, U]) -> List[U]
        val f = pf.lift()
        var out: List[U] = []
        var xs = self
        loop
            xs match
                x :: more ->
                    if f(x) is Some(u) then out = u :: out
                    xs = more
                [] -> return out.reverse()

    // The elements of the collections `f` makes of each element, joined in order.
    flatMap[U](f: (T) -> Iterable[U]) -> List[U]
        var out: List[U] = []
        var xs = self
        loop
            xs match
                x :: more ->
                    for y in f(x) do out = y :: out
                    xs = more
                [] -> return out.reverse()

    // The elements that satisfy `p`, in order.
    filter(p: (T) -> bool) -> List[T]
        var out: List[T] = []
        var xs = self
        loop
            xs match
                x :: more ->
                    if p(x) then out = x :: out
                    xs = more
                [] -> return out.reverse()

    // The elements that satisfy `p`, tested only as `map`, `flatMap` or `foreach` reaches each one.
    withFilter(p: (T) -> bool) -> FilteredList[T] = FilteredList(self, p)

    // The first `n` elements, or all of them when there are fewer.
    take(n: int) -> List[T]
        var out: List[T] = []
        var i = 0
        var xs = self
        loop
            if i >= n then return out.reverse()
            xs match
                x :: more ->
                    out = x :: out
                    i += 1
                    xs = more
                [] -> return out.reverse()

    // The elements after the first `n`, shared with this list; empty when there are no more.
    drop(n: int) -> List[T]
        var i = 0
        var xs = self
        loop
            if i >= n then return xs
            xs match
                _ :: more ->
                    i += 1
                    xs = more
                [] -> return xs

    // The elements that do not satisfy `p`, in order.
    filterNot(p: (T) -> bool) -> List[T] = filter(x -> !p(x))

    // The elements before the first that does not satisfy `p`.
    takeWhile(p: (T) -> bool) -> List[T] = takenWhileInto(self, p, List.builder[T]())

    // The elements from the first that does not satisfy `p` on, shared with this list.
    dropWhile(p: (T) -> bool) -> List[T]
        var xs = self
        loop
            xs match
                x :: more if p(x) -> xs = more
                _ -> return xs

    // The last `n` elements, shared with this list, or all of them when there are fewer.
    takeRight(n: int) -> List[T]
        val total = length()
        drop(total - clamped(n, total))

    // The elements before the last `n`; empty when there are no more.
    dropRight(n: int) -> List[T]
        val total = length()
        take(total - clamped(n, total))

    // The elements from `from` up to `until`, which traps when the indices are not in order within
    // the list.
    slice(from: int, until: int) -> List[T]
        if from < 0 || until > length() || from > until then fail("slice out of range")
        drop(from).take(until - from)

    // The first `n` elements and the rest, which is shared with this list: `(take(n), drop(n))`.
    splitAt(n: int) -> (List[T], List[T]) = (take(n), drop(n))

    // The elements before the first that does not satisfy `p`, and the rest, which is shared with
    // this list: `(takeWhile(p), dropWhile(p))`.
    span(p: (T) -> bool) -> (List[T], List[T])
        val b = List.builder[T]()
        var xs = self
        loop
            xs match
                x :: more if p(x) ->
                    b.add(x)
                    xs = more
                _ -> return (b.result(), xs)

    // Every element before the last, which traps on the empty list.
    init() -> List[T]
        if isEmpty() then fail("init of an empty list")
        take(length() - 1)

    // This list's elements followed by those of `other`: `xs ++ ys`.
    ++(other: Iterable[T]) -> List[T] = joinedInto(self, other, List.builder[T]())

    // This list with `element` after its elements, a copy of them: `xs :+ x`.
    :+(element: T) -> List[T] = appendedInto(self, element, List.builder[T]())

    // This list with `element` in front, sharing the list: `x +: xs`, the same as `x :: xs`.
    +:(element: T) -> List[T] = Cons(element, self)

    // This list with the element at `index` replaced by `element`, sharing the elements after it;
    // traps when there is none.
    updated(index: int, element: T) -> List[T]
        if index < 0 || index >= length() then fail("index out of range")
        prependReversed(take(index).reverse(), Cons(element, drop(index + 1)))

    // The elements followed by as many copies of `element` as make `total` of them.
    padTo(total: int, element: T) -> List[T] = paddedInto(self, total, element, List.builder[T]())

    // The elements with each one equal to an earlier one left out.
    distinct() -> List[T] = distinctInto(self, x -> x, List.builder[T]())

    // The elements with each one whose `key` equals an earlier one's left out.
    distinctBy[K](key: (T) -> K) -> List[T] = distinctInto(self, key, List.builder[T]())

    // The elements that are also in `other`, counted as a multiset, in this list's order.
    intersect(other: Seq[T]) -> List[T] = multisetInto(self, other, true, List.builder[T]())

    // The elements less those in `other`, counted as a multiset, in this list's order.
    diff(other: Seq[T]) -> List[T] = multisetInto(self, other, false, List.builder[T]())

    // A new array of the elements, in order.
    toArray() -> Array[T] = self match
        [] -> Array.empty[T]()
        x :: _ ->
            val a = Array.fill(length(), x)
            var i = 0
            for y in self
                a(i) = y
                i += 1
            a

    // A list of the elements ordered by `compare`, which is negative, zero or positive as its first
    // argument orders before, with or after its second. The sort is stable: elements that compare
    // equal keep their order.
    sortedWith(compare: (T, T) -> int) -> List[T]
        val a = elementArray(self)
        sortElements(a, a.length(), compare)
        arrayList(a)

    // A list of the elements ordered by their keys, `key` being computed once for each element. The
    // sort is stable: elements with equal keys keep their order.
    sortedBy[K: Ord](key: (T) -> K) -> List[T]
        val a = elementArray(self)
        sortElementsBy(a, a.length(), key)
        arrayList(a)

// A list of ordered elements sorts into a list.
impl[T: Ord] List[T]
    // A list of the elements in ascending order; the sort is stable, so equal elements keep their
    // order.
    sorted() -> List[T]
        val a = elementArray(self)
        sortElements(a, a.length(), (x, y) -> x.compare(y))
        arrayList(a)

// A list of the elements of `items`, in order.
private arrayList[T](items: Array[T]) -> List[T]
    var out: List[T] = []
    var i = items.length() - 1
    while i >= 0
        out = items(i) :: out
        i -= 1
    out

// `reversed`'s elements, last first, in front of `onto`.
private prependReversed[T](reversed: List[T], onto: List[T]) -> List[T]
    var out = onto
    var xs = reversed
    loop
        xs match
            x :: more ->
                out = x :: out
                xs = more
            [] -> return out

// Two lists are equal when they have the same length and equal elements in order.
impl[T: Eq] Eq for List[T]
    equals(other: List[T]) -> bool
        var xs = self
        var ys = other
        loop
            xs match
                x :: more -> ys match
                    y :: others ->
                        if x != y then return false
                        xs = more
                        ys = others
                    [] -> return false
                [] -> return ys.isEmpty()

// Combines the elements' hashes in order, so equal lists hash alike.
impl[T: Hash] Hash for List[T]
    hash() -> long
        var h: long = 7
        for x in self do h = h *% 31 +% x.hash()
        h

// Lists order element by element, and a list orders before every longer list it begins.
impl[T: Ord] Ord for List[T]
    compare(other: List[T]) -> int
        var xs = self
        var ys = other
        loop
            xs match
                x :: more -> ys match
                    y :: others ->
                        val order = x.compare(y)
                        if order != 0 then return order
                        xs = more
                        ys = others
                    [] -> return 1
                [] -> return if ys.isEmpty() then 0 else -1

// A list of displayable elements displays as `[1, 2, 3]`, as an array does, each element in its own
// `Display`. A field width pads the whole.
impl[T: Display] Display for List[T]
    display(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            display(text, FormatSpec())
            out.writeField(text.text(), spec)
            return
        out.write("[")
        var first = true
        for x in self
            if !first then out.write(", ")
            x.display(out, FormatSpec())
            first = false
        out.write("]")

// A list's diagnostic form is its elements' diagnostic forms in brackets: `["a", "b"]`.
impl[T: Debug] Debug for List[T]
    debug(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            debug(text, FormatSpec())
            out.writeField(text.text(), spec)
            return
        out.write("[")
        var first = true
        for x in self
            if !first then out.write(", ")
            x.debug(out, FormatSpec())
            first = false
        out.write("]")

object List
    // The empty list, `Nil`, for a reader who wants the element type written.
    empty[T]() -> List[T] = Nil

    // A builder of a list: the elements it is given, in order.
    builder[T]() -> ListBuilder[T] = ListBuilder()

// Builds a list from the elements given to it. Each is put in front of the ones before, so adding
// takes constant time, and `result()` turns the reversed list around once.
class ListBuilder[T]: Builder[T, List[T]]
    private var reversed: List[T] = Nil
    private var spent = false

    override add(element: T)
        if spent then fail("add to a builder whose result was taken")
        reversed = element :: reversed

    override result() -> List[T]
        if spent then fail("result of a builder whose result was taken")
        spent = true
        prependReversed(reversed, Nil)

// A list seen through a test, which a guard of a `for` with `yield` makes: each element is tested
// just before the call after it would use it, so a guard runs in turn with the rest of the
// comprehension, element by element.
class FilteredList[T](private val list: List[T], private val p: (T) -> bool)
    // The list of `f` of each element that passes the test, in order.
    map[U](f: (T) -> U) -> List[U]
        val b = List.builder[U]()
        for x in list
            if p(x) then b.add(f(x))
        b.result()

    // The elements of the collections `f` makes of each element that passes the test, in order.
    flatMap[U](f: (T) -> Iterable[U]) -> List[U]
        val b = List.builder[U]()
        for x in list
            if p(x) then b.addAll(f(x))
        b.result()

    // The elements that pass this test and then `q`.
    withFilter(q: (T) -> bool) -> FilteredList[T] = FilteredList(list, x -> p(x) && q(x))

    // Calls `f` with each element that passes the test, in order.
    foreach(f: (T) -> unit)
        for x in list
            if p(x) then f(x)

// Steps through a list, holding the part not yet yielded.
private class ListIterator[T](private var remaining: List[T]): Iterator[T]
    override hasNext() -> bool = remaining.nonEmpty()

    override next() -> T = remaining match
        x :: more ->
            remaining = more
            x
        [] -> fail("next on an exhausted iterator")
