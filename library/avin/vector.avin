module avin

// An immutable indexed sequence, and the default one: `[1, 2, 3]` is a `Vector[int]`. Its elements
// are in one array that nothing writes to after the vector is made, so `v(i)` takes constant time,
// and an operation that makes a changed vector, such as `appended` or `updated`, copies them.
class Vector[+T](private val elements: FrozenArray[T]): Iterable[T]
    length() -> int = elements.length()

    isEmpty() -> bool = elements.length() == 0

    nonEmpty() -> bool = elements.length() != 0

    // The element at `index`, which traps when there is none.
    @trapsAtCaller
    apply(index: int) -> T = elements(index)

    // The element at `index`, or `None` when there is none.
    get(index: int) -> Option[T] = if 0 <= index < elements.length() then Some(elements(index)) else None

    // The elements from `from` up to `until`, which traps when the indices are not in order within
    // the vector.
    @trapsAtCaller
    slice(from: int, until: int) -> Vector[T] = Vector(elements.slice(from, until))

    // `f` of each element, in order.
    map[U](f: (T) -> U) -> Vector[U]
        val b = Vector.builder[U]()
        for i in 0 ..< elements.length() do b.add(f(elements(i)))
        b.result()

    // The elements that satisfy `p`, in order.
    filter(p: (T) -> bool) -> Vector[T]
        val b = Vector.builder[T]()
        for i in 0 ..< elements.length()
            val x = elements(i)
            if p(x) then b.add(x)
        b.result()

    // `f` applied to `initial` and the first element, then to that result and the second, and so on
    // through the vector.
    foldLeft[B](initial: B, f: (B, T) -> B) -> B
        var acc = initial
        for i in 0 ..< elements.length() do acc = f(acc, elements(i))
        acc

    // Calls `f` with each element, in order.
    foreach(f: (T) -> unit)
        for i in 0 ..< elements.length() do f(elements(i))

    // Whether `p` holds for some element.
    exists(p: (T) -> bool) -> bool
        for i in 0 ..< elements.length()
            if p(elements(i)) then return true
        false

    toVector() -> Vector[T] = self

    override iterator() -> Iterator[T] = VectorIterator(elements, 0)

// The methods an `impl` adds to a class whose fields are all immutable are not variance positions,
// so `T` may appear in a parameter: on a `Vector[Dog]` seen as a `Vector[Animal]`, `T` is `Animal`.
impl[T] Vector[T]
    // This vector with `element` after its elements.
    appended(element: T) -> Vector[T]
        val n = elements.length()
        val a = newArray[T](n + 1)
        for i in 0 ..< n do a(i) = elements(i)
        a(n) = element
        Vector(freeze(a))

    // This vector with `element` before its elements.
    prepended(element: T) -> Vector[T]
        val n = elements.length()
        val a = newArray[T](n + 1)
        a(0) = element
        for i in 0 ..< n do a(i + 1) = elements(i)
        Vector(freeze(a))

    // The elements of this vector followed by those of `other`.
    concat(other: Vector[T]) -> Vector[T]
        val n = elements.length()
        val m = other.length()
        val a = newArray[T](n + m)
        for i in 0 ..< n do a(i) = elements(i)
        for i in 0 ..< m do a(n + i) = other(i)
        Vector(freeze(a))

    // This vector with the element at `index` replaced by `element`; traps when there is none.
    @trapsAtCaller
    updated(index: int, element: T) -> Vector[T]
        if index < 0 || index >= elements.length() then fail("index out of range")
        val a = newArray[T](elements.length())
        for i in 0 ..< elements.length() do a(i) = elements(i)
        a(index) = element
        Vector(freeze(a))

    // Whether some element equals `element`.
    contains(element: T) -> bool
        for i in 0 ..< elements.length()
            if elements(i).equals(element) then return true
        false

    // The index of the first element equal to `element`, or `None` when there is none.
    indexOf(element: T) -> Option[int]
        for i in 0 ..< elements.length()
            if elements(i).equals(element) then return Some(i)
        None

    // A new array of the elements.
    toArray() -> Array[T]
        val a = newArray[T](elements.length())
        for i in 0 ..< elements.length() do a(i) = elements(i)
        a

    // A new buffer of the elements.
    toBuffer() -> Buffer[T]
        val b = Buffer[T]()
        for i in 0 ..< elements.length() do b.add(elements(i))
        b


// Two vectors are equal when they have equal elements in the same order.
impl[T] Eq for Vector[T]
    equals(other: Vector[T]) -> bool
        if elements.length() != other.length() then return false
        for i in 0 ..< elements.length()
            if !elements(i).equals(other(i)) then return false
        true

impl[T] Hash for Vector[T]
    hash() -> long
        var h = long(1)
        for i in 0 ..< elements.length() do h = h *% 31 +% elements(i).hash()
        h

// A vector of displayable elements displays as `[1, 2, 3]`, as an array does. A field width pads the
// whole.
impl[T: Display] Display for Vector[T]
    display(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            display(text, FormatSpec())
            out.writeField(text.text(), spec)
            return
        out.write("[")
        for i in 0 ..< elements.length()
            if i > 0 then out.write(", ")
            elements(i).display(out, FormatSpec())
        out.write("]")

// A vector's diagnostic form is its elements' diagnostic forms in brackets: `["a", "b"]`.
impl[T: Debug] Debug for Vector[T]
    debug(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            debug(text, FormatSpec())
            out.writeField(text.text(), spec)
            return
        out.write("[")
        for i in 0 ..< elements.length()
            if i > 0 then out.write(", ")
            elements(i).debug(out, FormatSpec())
        out.write("]")

object Vector
    // A vector with no elements.
    empty[T]() -> Vector[T] = Vector(freeze(newArray[T](0)))

    // A builder of a vector: the elements it is given, in order.
    builder[T]() -> VectorBuilder[T] = VectorBuilder(Buffer[T](), false)

// Builds a vector from the elements given to it, which it keeps in a buffer until `result()`.
class VectorBuilder[T](private val buffer: Buffer[T], private var spent: bool): Builder[T, Vector[T]]
    @trapsAtCaller
    override add(element: T)
        if spent then fail("a builder is spent once it has given its result")
        buffer.add(element)

    @trapsAtCaller
    override result() -> Vector[T]
        if spent then fail("a builder is spent once it has given its result")
        spent = true
        buffer.toVector()

// Steps through a vector's elements.
private class VectorIterator[T](items: FrozenArray[T], private var index: int): Iterator[T]
    override hasNext() -> bool = index < items.length()

    override next() -> T
        if index >= items.length() then fail("next on an exhausted iterator")
        val value = items(index)
        index += 1
        value
