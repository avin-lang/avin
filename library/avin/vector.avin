module avin

// An immutable indexed sequence, and the default one: `[1, 2, 3]` is a `Vector[int]`. Its elements
// are in a tree of arrays of 32, with a prefix and a suffix at each level beside a balanced middle
// (the shapes are in vector_tree.avin). Reading an element takes one array per level, and a vector
// of up to 2^31 elements has at most 6. Adding at either end writes into the array at that end, so
// `:+` and `+:` take amortized constant time; `updated` copies one path from the top to a leaf; and
// slicing makes new arrays only at the edges, sharing the rest, so it takes time proportional to the
// depth. Versions of a vector share every array they have in common.
abstract class Vector[+T]: Seq[T]
    override toVector() -> Vector[T] = self

// `Vector` is abstract, so these methods are in its method table and are variance positions like
// any other: a method taking an element takes it as a type parameter bounded below by `T`, as
// `:+[W >: T](element: W) -> Vector[W]` does, so a `Vector[Dog]` seen as a `Vector[Animal]` and
// given a cat answers a `Vector[Animal]`.
impl[T] Vector[T]
    // Steps through the elements a leaf at a time.
    override iterator() -> Iterator[T]
        val n = length()
        if n == 0 then return VectorIterator(self, emptyArray(), 0)
        VectorIterator(self, vectorLeaf(self, 0), n)

    // Steps through the elements from the last to the first, a leaf at a time.
    override reverseIterator() -> Iterator[T]
        val n = length()
        if n == 0 then return VectorReverseIterator(self, emptyArray(), -1)
        val leaf = vectorLeaf(self, n - 1)
        VectorReverseIterator(self, leaf, n - leaf.length())

    // The elements from `from` up to `until`, which traps when the indices are not in order within
    // the vector.
    slice(from: int, until: int) -> Vector[T]
        if from < 0 || until > length() || from > until then fail("slice out of range")
        sliced(self, from, until)

    // The first `n` elements, or all of them when there are fewer.
    take(n: int) -> Vector[T] = sliced(self, 0, clamped(n, length()))

    // The elements after the first `n`; empty when there are no more.
    drop(n: int) -> Vector[T] = sliced(self, clamped(n, length()), length())

    // The last `n` elements, or all of them when there are fewer.
    takeRight(n: int) -> Vector[T] = sliced(self, length() - clamped(n, length()), length())

    // The elements before the last `n`; empty when there are no more.
    dropRight(n: int) -> Vector[T] = sliced(self, 0, length() - clamped(n, length()))

    // The first `n` elements and the rest: `(take(n), drop(n))`.
    splitAt(n: int) -> (Vector[T], Vector[T])
        val k = clamped(n, length())
        (sliced(self, 0, k), sliced(self, k, length()))

    // Every element after the first, which traps on the empty vector.
    tail() -> Vector[T]
        if length() == 0 then fail("tail of an empty vector")
        sliced(self, 1, length())

    // Every element before the last, which traps on the empty vector.
    init() -> Vector[T]
        if length() == 0 then fail("init of an empty vector")
        sliced(self, 0, length() - 1)

    // `f` of each element, in order.
    map[U](f: (T) -> U) -> Vector[U]
        val b = VectorAssembler[U]()
        for x in self do b.addOne(f(x))
        b.result()

    // The elements that satisfy `p`, in order.
    filter(p: (T) -> bool) -> Vector[T]
        val b = VectorAssembler[T]()
        for x in self
            if p(x) then b.addOne(x)
        b.result()

    // `pf` of each element it is defined at, in order: `xs.collect(match Some(n) -> n)`.
    collect[U](pf: PartialFunction[T, U]) -> Vector[U]
        val f = pf.lift()
        val b = VectorAssembler[U]()
        for x in self
            if f(x) is Some(u) then b.addOne(u)
        b.result()

    // The elements of the collections `f` makes of each element, joined in order.
    flatMap[U](f: (T) -> Iterable[U]) -> Vector[U]
        val b = VectorAssembler[U]()
        for x in self
            for y in f(x) do b.addOne(y)
        b.result()

    // This vector with `element` after its elements: `xs :+ x`, a vector of the elements' nearest
    // common type.
    :+[W >: T](element: W) -> Vector[W]
        val me: Vector[W] = self
        me match
            v: Vector2[W] -> v.appended(element)
            v: Vector3[W] -> v.appended(element)
            v: Vector1[W] -> v.appended(element)
            v: Vector4[W] -> v.appended(element)
            v: Vector5[W] -> v.appended(element)
            v: Vector6[W] -> v.appended(element)
            _ -> Vector1(single(element))

    // This vector with `element` before its elements: `x +: xs`.
    +:[W >: T](element: W) -> Vector[W]
        val me: Vector[W] = self
        me match
            v: Vector2[W] -> v.prepended(element)
            v: Vector3[W] -> v.prepended(element)
            v: Vector1[W] -> v.prepended(element)
            v: Vector4[W] -> v.prepended(element)
            v: Vector5[W] -> v.prepended(element)
            v: Vector6[W] -> v.prepended(element)
            _ -> Vector1(single(element))

    // The elements of this vector followed by those of `other`: `xs ++ ys`. The shorter operand's
    // elements are added one at a time to the longer one's end, so the time is proportional to the
    // shorter's length; two operands of comparable length are copied into a new vector in one pass.
    ++[W >: T](other: Vector[W]) -> Vector[W]
        val me: Vector[W] = self
        val n = me.length()
        val m = other.length()
        if m == 0 then return me
        if n == 0 then return other
        if m > 64 && n > 64 && m <= 8 * n && n <= 8 * m
            val b = VectorAssembler[W]()
            b.addVector(me)
            b.addVector(other)
            return b.result()
        if m <= n
            var out = me
            for x in other do out = out :+ x
            return out
        var out = other
        val it = me.reverseIterator()
        while it.hasNext() do out = it.next() +: out
        out

    // This vector with the element at `index` replaced by `element`; traps when there is none.
    updated[W >: T](index: int, element: W) -> Vector[W]
        if index < 0 || index >= length() then fail("index out of range")
        val me: Vector[W] = self
        me match
            v: Vector2[W] -> v.updatedAt(index, element)
            v: Vector3[W] -> v.updatedAt(index, element)
            v: Vector1[W] -> v.updatedAt(index, element)
            v: Vector4[W] -> v.updatedAt(index, element)
            v: Vector5[W] -> v.updatedAt(index, element)
            v: Vector6[W] -> v.updatedAt(index, element)
            _ -> fail("index out of range")

    // Calls `f` with each element, in order.
    foreach(f: (T) -> unit)
        for x in self do f(x)

    // `f` applied to `initial` and the first element, then to that result and the second, and so on.
    foldLeft[B](initial: B, f: (B, T) -> B) -> B
        var acc = initial
        for x in self do acc = f(acc, x)
        acc

    // Whether `p` holds for some element.
    exists(p: (T) -> bool) -> bool
        for x in self
            if p(x) then return true
        false

    // Whether `p` holds for every element; true when there are none.
    forall(p: (T) -> bool) -> bool
        for x in self
            if !p(x) then return false
        true

    // How many elements satisfy `p`.
    count(p: (T) -> bool) -> int
        var n = 0
        for x in self
            if p(x) then n += 1
        n

    // A new array of the elements, copied a leaf at a time; its element type is the vector's unless
    // the call asks for a wider one.
    toArray[W >: T]() -> Array[W]
        val me: Vector[W] = self
        val n = me.length()
        val a = newArray[W](n)
        var at = 0
        while at < n
            val leaf = vectorLeaf(me, at)
            for j in 0 ..< leaf.length() do a(at + j) = leaf(j)
            at += leaf.length()
        publish(a)
        a

    // The elements in one array, read in constant time without a tree.
    override toArraySeq() -> ArraySeq[T] = ArraySeq(freeze(toArray()))


// A vector of displayable elements displays as `[1, 2, 3]`, as an array does. A field width pads the
// whole.
impl[T: Display] Display for Vector[T]
    display(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            display(text, FormatSpec())
            out.writeField(text.text(), spec)
            return
        out.write("[")
        var first = true
        for x in self
            if !first then out.write(", ")
            first = false
            x.display(out, FormatSpec())
        out.write("]")

// A vector of sendable elements may be handed to another thread: nothing writes to a vector once it
// is made.
impl[T: Sendable] Sendable for Vector[T]

// A vector's diagnostic form is its elements' diagnostic forms in brackets: `["a", "b"]`.
impl[T: Debug] Debug for Vector[T]
    debug(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            debug(text, FormatSpec())
            out.writeField(text.text(), spec)
            return
        out.write("[")
        var first = true
        for x in self
            if !first then out.write(", ")
            first = false
            x.debug(out, FormatSpec())
        out.write("]")

object Vector
    // A vector with no elements.
    empty[T]() -> Vector[T] = Vector0()

    // A vector of `length` elements, the element at `i` being `f(i)`, computed in index order;
    // empty when `length` is not positive.
    tabulate[T](length: int, f: (int) -> T) -> Vector[T]
        val b = Vector.newBuilder[T]()
        var i = 0
        while i < length
            b.addOne(f(i))
            i += 1
        b.result()

    // A vector of `length` elements, each the value of `element`, which is evaluated once for each;
    // empty when `length` is not positive.
    fill[T](length: int, element: -> T) -> Vector[T]
        val b = Vector.newBuilder[T]()
        var i = 0
        while i < length
            b.addOne(element)
            i += 1
        b.result()

    // A vector of the elements given: `Vector(1, 2, 3)`, `Vector()`.
    apply[T](elements: T*) -> Vector[T] = elements

    // A vector of the elements of `elements`, in iteration order.
    from[T](elements: Iterable[T]) -> Vector[T]
        val b = Vector.newBuilder[T]()
        b.addAll(elements)
        b.result()

    // A vector of `length` elements: `start`, `f(start)`, `f(f(start))` and so on, each computed
    // from the one before; empty when `length` is not positive.
    iterate[T](start: T, length: int, f: (T) -> T) -> Vector[T]
        val b = Vector.newBuilder[T]()
        var current = start
        var i = 0
        while i < length
            b.addOne(current)
            i += 1
            if i < length then current = f(current)
        b.result()

    // The elements `f` gives from `state`: while `f` of the state is `Some((element, next))`, the
    // element is added and `next` becomes the state; the first `None` ends the vector.
    unfold[T, S](state: S, f: (S) -> Option[(T, S)]) -> Vector[T] = Iterator.unfold(state, f).toVector()

    // A builder of a vector: the elements it is given, in order.
    newBuilder[T]() -> VectorBuilder[T] = VectorBuilder(VectorAssembler[T](), false)

// Builds a vector from the elements given to it, filling leaves of 32 as they come and making the
// tree above them once, at `result()`.
class VectorBuilder[T](private var assembler: VectorAssembler[T], private var spent: bool): Builder[T, Vector[T]]
    override addOne(element: T)
        if spent then fail("add to a builder whose result was taken")
        assembler.addOne(element)

    override result() -> Vector[T]
        if spent then fail("result of a builder whose result was taken")
        spent = true
        assembler.result()

    // Starts a new assembly, leaving a vector already handed over as it is.
    override clear()
        assembler = VectorAssembler[T]()
        spent = false

// Steps through a vector's elements, reading each leaf's elements in turn and finding the next leaf
// only when one is used up. `start` is the index of the leaf's first element.
class VectorIterator[T](private val vector: Vector[T], private var leaf: FrozenArray[T], private val total: int): Iterator[T]
    private var pos = 0
    private var start = 0

    override hasNext() -> bool = start + pos < total

    // The step to the next leaf is a method of its own, so the rest is small enough to be inlined
    // where the iterator is used.
    override next() -> T
        if pos >= leaf.length() then nextLeaf()
        val value = leaf(pos)
        pos += 1
        value

    private nextLeaf()
        start += leaf.length()
        if start >= total then fail("next on an exhausted iterator")
        leaf = vectorLeaf(vector, start)
        pos = 0

// Steps through a vector's elements from the last, a leaf at a time. `start` is the index of the
// leaf's first element, and `pos` the position in the leaf of the next element.
class VectorReverseIterator[T](private val vector: Vector[T], private var leaf: FrozenArray[T], private var start: int): Iterator[T]
    private var pos = leaf.length() - 1

    override hasNext() -> bool = start + pos >= 0

    override next() -> T
        if pos < 0
            if start <= 0 then fail("next on an exhausted iterator")
            leaf = vectorLeaf(vector, start - 1)
            start -= leaf.length()
            pos = leaf.length() - 1
        val value = leaf(pos)
        pos -= 1
        value

// The elements of `v` from `lo` up to `hi`, which lie in order within it.
private sliced[T](v: Vector[T], lo: int, hi: int) -> Vector[T]
    if lo == 0 && hi == v.length() then return v
    if lo >= hi then return Vector0()
    v match
        x: Vector1[T] -> Vector1(x.data1.slice(lo, hi))
        _ ->
            val s = newSlicer[T]()
            v match
                x: Vector2[T] -> x.feed(s, lo, hi)
                x: Vector3[T] -> x.feed(s, lo, hi)
                x: Vector4[T] -> x.feed(s, lo, hi)
                x: Vector5[T] -> x.feed(s, lo, hi)
                x: Vector6[T] -> x.feed(s, lo, hi)
                _ -> ()
            s.result()

// `n` held within `0` and `limit`.
private clamped(n: int, limit: int) -> int = if n < 0 then 0 elif n > limit then limit else n

// The number of elements of `v`, and the leaf that holds its element at `index`: how a conversion to
// Sysl reads a vector's elements, a leaf at a time.
private vectorLength[T](v: Vector[T]) -> int = v.length()

// The vector of the elements of an array a conversion from Sysl has made and nothing else holds.
private vectorOfArray[T](elements: Array[T]) -> Vector[T] = vectorOf(freeze(elements))
