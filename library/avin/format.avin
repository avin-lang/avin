module avin

// Rendering values as text. A type is printable because it implements `Display`, its human form,
// which `println`, interpolation and `toString()` use; `Debug` is its diagnostic form, which `debug`
// uses. Both render into a `Writer` with a `FormatSpec`, so a value is written where it is going
// without an intermediate string.

// Where rendered text goes: standard output, or a string being built.
trait Writer
  // Writes `text`.
  write(text: string)

  // Writes the character `c`.
  writeChar(c: char) = write(renderChar(c))

  // Writes the decimal digits of `n`, with a sign when it is negative.
  writeInt(n: long) = write(renderInt(n))

  // Writes `text` in the field `spec` describes: padded with spaces to `spec.width` characters, on
  // the left, or on the right when `spec.left`. Text as wide as the field or wider is written
  // whole.
  writeField(text: string, spec: FormatSpec)
    if spec.width <= 0
      write(text)
      return
    val pad = long(spec.width) - textWidth(text)
    if !spec.left then writeSpaces(pad)
    write(text)
    if spec.left then writeSpaces(pad)

  // Writes `n` spaces, or nothing when `n` is not positive.
  writeSpaces(n: long)
    var i: long = 0
    while i < n
      write(" ")
      i += 1

// How a value is laid out: the `width` of the field it fills, where 0 asks for no padding, padded on
// the left, or on the right when `left`; and a `precision`, -1 for none, which a renderer that takes
// one reads in its own terms. The rest is what an `f"…"` specifier writes: `zeroPad` for the `0`
// flag, `plus` for `+`, `space` for a space, `alternate` for `#`, the `conversion` letter, `s`
// when none is written, and `grouping` for `,`, which writes an integer's decimal digits in groups of
// three separated by commas. A renderer reads the conversions its type takes and renders its own form
// under any other.
data FormatSpec(
    width: int = 0,
    precision: int = -1,
    left: bool = false,
    zeroPad: bool = false,
    plus: bool = false,
    space: bool = false,
    alternate: bool = false,
    conversion: char = 's',
    grouping: bool = false
)

impl FormatSpec
  // This spec with the width `n`, counted when the program runs: a negative count asks for a field
  // of its magnitude, padded on the right, and a count beyond `int` is the largest `int`.
  withWidth[T: Integer](n: T) -> FormatSpec =
    val count = clampedCount(n)
    if count < 0 then FormatSpec(-count, precision, true, zeroPad, plus, space, alternate, conversion, grouping)
    else FormatSpec(count, precision, left, zeroPad, plus, space, alternate, conversion, grouping)

  // This spec with the precision `n`, counted when the program runs: a negative count is as though
  // no precision were written.
  withPrecision[T: Integer](n: T) -> FormatSpec =
    val count = clampedCount(n)
    FormatSpec(width, if count < 0 then -1 else count, left, zeroPad, plus, space, alternate, conversion, grouping)

// `spec` with no width and no precision, its flags and conversion kept.
private unbounded(spec: FormatSpec) -> FormatSpec =
  FormatSpec(0, -1, false, spec.zeroPad, spec.plus, spec.space, spec.alternate, spec.conversion, spec.grouping)

// `n` held to the range an `int` holds with room to negate it.
private clampedCount[T: Integer](n: T) -> int
  val wide = long.wrap(n)
  if T(wide) != n then return if n < T(0) then -2147483647 else 2147483647
  if wide > 2147483647 then 2147483647 elif wide < -2147483647 then -2147483647 else int(wide)

// A value's human form. `display` renders it into `out`, in the field `spec` describes.
trait Display
  display(out: Writer, spec: FormatSpec)

  // The value rendered as a string.
  toString() -> string
    val out = StringWriter()
    display(out, FormatSpec())
    out.text

// A value's diagnostic form, which shows what the value is: a string is quoted and escaped.
trait Debug
  debug(out: Writer, spec: FormatSpec)

// A value of `Any` or of a trait is shown by the type it has when the program runs. A type with no
// `Display` or `Debug` of its own is shown as its name, which the compiler passes here.
private renderTypeName(name: string, out: Writer, spec: FormatSpec)
  out.writeField(name, spec)

// A formatted hole: `value` rendered into `out` in the field `spec` describes, whatever its type's
// `display` does with the spec. Under `%s` the field is the formatter's: a precision makes the value
// render with no width and no precision and keeps its first `spec.precision` characters, and a width
// pads whatever the value rendered, handed the whole spec, to the field. Under every other
// conversion the renderer reads the spec itself.
writeDisplayed[T: Display](out: Writer, value: T, spec: FormatSpec)
  if spec.conversion != 's' || (spec.precision < 0 && spec.width <= 0)
    value.display(out, spec)
    return
  val text = StringWriter()
  if spec.precision < 0
    value.display(text, spec)
    out.writeField(text.text, spec)
  else
    value.display(text, unbounded(spec))
    out.writeField(text.text.take(spec.precision), spec)

// A formatted hole under `%?`, its `Debug` form padded and cut as `writeDisplayed` pads and cuts a
// `Display` form.
writeDebugged[T: Debug](out: Writer, value: T, spec: FormatSpec)
  if spec.precision < 0 && spec.width <= 0
    value.debug(out, spec)
    return
  val text = StringWriter()
  if spec.precision < 0
    value.debug(text, spec)
    out.writeField(text.text, spec)
  else
    value.debug(text, unbounded(spec))
    out.writeField(text.text.take(spec.precision), spec)

// `toString()` on a value of `Any` or of a trait: its own type's `Display` form.
private displayString[T: Display](value: T) -> string
  val out = StringWriter()
  value.display(out, FormatSpec())
  out.text

// `derives Display`, and the `Display` every data type has without asking: the type's or variant's
// name, then its fields between parentheses, separated by `, `, each in its own `Display` form; a
// variant without fields is its bare name. A field width pads the whole, rendered into a string
// first; the fields themselves are written without one.
derive Display for T
  display(out: Writer, spec: FormatSpec)
    if spec.width > 0
      val text = StringWriter()
      display(text, FormatSpec())
      out.writeField(text.text, spec)
    else
      T.walk(self, DisplayFields(out))

// `derives Debug`, and the `Debug` every data type has without asking: the shape of `Display` with each
// field's `Debug` form, so strings and chars inside are quoted and escaped.
derive Debug for T
  debug(out: Writer, spec: FormatSpec)
    if spec.width > 0
      val text = StringWriter()
      debug(text, FormatSpec())
      out.writeField(text.text, spec)
    else
      T.walk(self, DebugFields(out))

// Writes a variant's name, then each field after `(` or `, `, then `)` after the last.
private data DisplayFields(out: Writer)

impl ShapeVisitor for DisplayFields
  variant(v: VariantShape) -> DisplayFields =
    out.write(v.name)
    self

  finish(v: VariantShape) -> DisplayFields =
    if v.fieldCount > 0 then out.write(")")
    self

impl DisplayFields
  field[F: Display](f: FieldShape, value: F) -> DisplayFields =
    out.write(if f.index == 0 then "(" else ", ")
    value.display(out, FormatSpec())
    self

private data DebugFields(out: Writer)

impl ShapeVisitor for DebugFields
  variant(v: VariantShape) -> DebugFields =
    out.write(v.name)
    self

  finish(v: VariantShape) -> DebugFields =
    if v.fieldCount > 0 then out.write(")")
    self

impl DebugFields
  field[F: Debug](f: FieldShape, value: F) -> DebugFields =
    out.write(if f.index == 0 then "(" else ", ")
    value.debug(out, FormatSpec())
    self

// Standard output as a writer.
object StandardOutput: Writer
  override write(text: string) = writeOut(text)

  // Digits go out from the stack, with no string made for them.
  override writeInt(n: long) = writeIntOut(n)

  // Sends everything written so far on its way, a partial line included.
  flush() = flushOut()

// Standard error as a writer. It keeps no buffer, so each write has left when it returns, and each
// flushes standard output first, so the two streams arrive in the order the program wrote them.
object StandardError: Writer
  override write(text: string) = writeErr(text)

  // Standard error holds nothing back; this ends the same way a flush of standard output does, so
  // the two streams can be flushed alike.
  flush() = flushOut()

// A writer that builds a string: `text`, and its `Display` form and `toString()`, are everything
// written to it so far.
class StringWriter: Writer, Display
  // The text is the first `used` bytes of `store`, which grows by doubling and is filled in place.
  private var store = ""
  private var used: long = 0

  override write(text: string)
    store = textAppend(store, used, text)
    used += textSize(text)

  // Shows the text written so far, as a string shows, padded to a field's width.
  override display(out: Writer, spec: FormatSpec) = out.writeField(text, spec)

  override toString() -> string = text

  // Everything written so far.
  text -> string = textTake(store, used)

  // The number of bytes written so far: a character of several bytes counts them all.
  length -> int = int(used)

  // Whether nothing has been written, or everything was cleared.
  isEmpty -> bool = used == 0

  // Forgets everything written, so the writer is as new.
  clear()
    store = ""
    used = 0

// The elements of `items` in their own `Display`, between `start` and `end` and separated by `sep`:
// what every collection's `mkString` makes.
private joined[T: Display](items: Iterator[T], start: string, sep: string, end: string) -> string
  val out = StringWriter()
  out.write(start)
  var first = true
  for x in items
    if !first then out.write(sep)
    x.display(out, FormatSpec())
    first = false
  out.write(end)
  out.text

// The built-in types render as their literals do: integers of every width, from one impl for the
// whole family, in decimal with a sign when negative, a `byte` as its number, a `real` in the fewest
// digits that read back as the same value, a `char` and a string as themselves, `bool` as `true` or
// `false`, `unit` as `()`. A built-in type takes no default bodies, so each impl implements
// `toString` too, rendering with no writer in between.

impl[T: Integer] Display for T
  display(out: Writer, spec: FormatSpec) = writeInteger(out, self, spec)
  toString() -> string
    val n = long.wrap(self)
    if T(n) == self then renderInt(n) else wideText(self)

impl Display for byte
  display(out: Writer, spec: FormatSpec) = writeLong(out, long(int(self)), spec)
  toString() -> string = renderInt(long(int(self)))

impl Display for real
  display(out: Writer, spec: FormatSpec) = writeReal(out, self, spec)
  toString() -> string = renderReal(self)

impl Display for char
  display(out: Writer, spec: FormatSpec)
    if spec.width <= 0 then out.writeChar(self) else out.writeField(renderChar(self), spec)
  toString() -> string = renderChar(self)

impl Display for bool
  display(out: Writer, spec: FormatSpec) = out.writeField(toString(), spec)
  toString() -> string = if self then "true" else "false"

impl Display for unit
  display(out: Writer, spec: FormatSpec) = out.writeField("()", spec)
  toString() -> string = "()"

impl Display for string
  display(out: Writer, spec: FormatSpec) = out.writeField(self, spec)
  toString() -> string = self

// The Debug forms of the built-in types are their Display forms, except that a string and a `char`
// are written as the literals that make them: quoted, with quotes, backslashes and control
// characters escaped.

impl[T: Integer] Debug for T
  debug(out: Writer, spec: FormatSpec) = writeInteger(out, self, spec)

impl Debug for byte
  debug(out: Writer, spec: FormatSpec) = writeLong(out, long(int(self)), spec)

impl Debug for real
  debug(out: Writer, spec: FormatSpec) = out.writeField(renderReal(self), spec)

// A real under `f`, `e`, `g`, `E` or `G` is written as those conversions lay it out, its digits the
// exact value's rounded half to even; under any other it is its shortest form, padded with spaces.
private writeReal(out: Writer, x: real, spec: FormatSpec)
  val c = spec.conversion
  if c != 'f' && c != 'e' && c != 'g' && c != 'E' && c != 'G'
    out.writeField(renderReal(x), spec)
    return
  var flags = 0
  if spec.left then flags = flags | 1
  if spec.plus then flags = flags | 2
  if spec.space then flags = flags | 4
  if spec.zeroPad then flags = flags | 8
  if spec.alternate then flags = flags | 16
  out.write(formatReal(x, c, flags, spec.width, spec.precision))

impl Debug for char
  debug(out: Writer, spec: FormatSpec) = out.writeField(quoteChar(self), spec)

impl Debug for bool
  debug(out: Writer, spec: FormatSpec) = out.writeField(if self then "true" else "false", spec)

impl Debug for unit
  debug(out: Writer, spec: FormatSpec) = out.writeField("()", spec)

impl Debug for string
  debug(out: Writer, spec: FormatSpec) = out.writeField(quoteText(self), spec)

// An integer of any width renders through `long` wherever its value fits, which at a width of 64 bits
// or fewer it always does: there the test that it fits folds away when the width's instance is
// compiled. A value too wide for `long` is cut into chunks of eighteen digits.
private writeInteger[T: Integer](out: Writer, x: T, spec: FormatSpec)
  if !plainInteger(spec)
    out.writeField(integerText(x, spec), spec)
    return
  val n = long.wrap(x)
  if T(n) == x then writeLong(out, n, spec)
  elif spec.width <= 0 then writeWide(out, x)
  else out.writeField(wideText(x), spec)

// The decimal text of `x`, a value too wide for `long`.
private wideText[T: Integer](x: T) -> string
  val out = StringWriter()
  writeWide(out, x)
  out.text

// Writes the decimal digits of `x`, a value too wide for `long`, so at least 2^63 from zero and of a
// width above 64 bits, which holds 10^18. One division at the full width splits off the last
// eighteen digits as a `long`; what is left before them is written first, through `long` once it
// fits, and carries the sign.
private writeWide[T: Integer](out: Writer, x: T)
  val chunk = T(1000000000000000000)
  val high = x / chunk
  val h = long.wrap(high)
  if T(h) == high then out.writeInt(h) else writeWide(out, high)
  val low = long(x % chunk)
  writeChunk(out, if low < 0 then -low else low)

// Writes `n`, from 0 to 10^18 - 1, as eighteen digits, with leading zeros.
private writeChunk(out: Writer, n: long)
  var digits = 1
  var rest = n
  while rest >= 10
    rest /= 10
    digits += 1
  while digits < 18
    out.write("0")
    digits += 1
  out.writeInt(n)

// An integer with no field to fill goes to the writer as a number, which standard output renders
// with no string in between.
private writeLong(out: Writer, n: long, spec: FormatSpec)
  if !plainInteger(spec) then out.writeField(integerText(n, spec), spec)
  elif spec.width <= 0 then out.writeInt(n)
  else out.writeField(renderInt(n), spec)

// Whether `spec` asks for an integer's decimal digits padded with spaces and nothing more.
private plainInteger(spec: FormatSpec) -> bool =
  val c = spec.conversion
  (
    c == 's' || c == 'd' || c == 'i'
  ) && spec.precision < 0 && !spec.zeroPad && !spec.plus && !spec.space && !spec.grouping

// `x` under an integer conversion, everything but the spaces that pad it: the sign, `-` when
// negative or else `+` or a space when asked; the base's prefix under `#` (`0x`, `0X` or `0b` before
// a value other than zero, a leading `0` in octal); then the digits of the magnitude, at least
// `precision` of them, where a precision of 0 writes zero as no digits; and, under `0` with neither
// `-` nor a precision, zeros after the sign and prefix to fill the width. Every base writes a
// negative value as its sign and magnitude. Under `,` a decimal conversion writes its digits, the
// zeros of a precision among them, in groups of three from the right separated by commas; the zeros
// the `0` flag fills a width with come before the grouped digits, ungrouped, and the commas count in
// the width, so the field is never wider than asked unless the number is.
private integerText[T: Integer](x: T, spec: FormatSpec) -> string
  val base = integerBase(spec)
  val n = long.wrap(x)
  val written = StringWriter()
  if T(n) == x then writeDigits(written, n, base, spec.conversion == 'X') else writeDigits(
    written,
    x,
    T(base),
    spec.conversion == 'X'
  )
  signedIntegerText(x < T(0), x == T(0), written.text, base, spec)

// The base an integer conversion writes in: 16 under `x` and `X`, 8 under `o`, 2 under `b`, and 10
// under every other.
private integerBase(spec: FormatSpec) -> long
  val c = spec.conversion
  if c == 'x' || c == 'X' then 16 elif c == 'o' then 8 elif c == 'b' then 2 else 10

// An integer's text under `spec`, as `integerText` describes, from its sign, whether it is zero, and
// the digits of its magnitude in `base`, upper case under `X`.
private signedIntegerText(negative: bool, zero: bool, magnitude: string, base: long, spec: FormatSpec) -> string
  val upper = spec.conversion == 'X'
  var digits = magnitude
  if spec.precision == 0 && zero then digits = ""
  elif spec.precision > digits.byteLength then digits = "0".repeat(spec.precision - digits.byteLength) + digits
  var lead = if negative then "-" elif spec.plus then "+" elif spec.space then " " else ""
  if spec.alternate
    if base == 16 && !zero then lead = lead + (if upper then "0X" else "0x")
    elif base == 2 && !zero then lead = lead + "0b"
    elif base == 8 && !digits.startsWith("0") then digits = "0" + digits
  if spec.grouping && base == 10 then digits = grouped(digits)
  if spec.zeroPad && !spec.left && spec.precision < 0
    val fill = spec.width - lead.byteLength - digits.byteLength
    if fill > 0 then digits = "0".repeat(fill) + digits
  lead + digits

// `digits`, a run of ASCII digits, in groups of three from the right with a comma between groups.
private grouped(digits: string) -> string
  val n = digits.byteLength
  if n <= 3 then return digits
  val out = StringWriter()
  var from = 0
  var until = n % 3
  if until == 0 then until = 3
  while from < n
    if from > 0 then out.write(",")
    out.write(digits.slice(from, until))
    from = until
    until += 3
  out.text

// Writes the digits of the magnitude of `x` in `base`, most significant first.
private writeDigits[T: Integer](out: Writer, x: T, base: T, upper: bool)
  val high = x / base
  if high != T(0) then writeDigits(out, high, base, upper)
  val d = long(x % base)
  val digit = if d < 0 then -d else d
  out.writeChar(
    char(int(if digit < 10 then long('0') + digit elif upper then long('A') + digit - 10 else long('a') + digit - 10))
  )

@intrinsic("write_out")
private writeOut(text: string)

@intrinsic("write_err")
private writeErr(text: string)

@intrinsic("flush_out")
private flushOut()

@intrinsic("write_int")
private writeIntOut(n: long)

@intrinsic("render_int")
private renderInt(n: long) -> string

@intrinsic("render_real")
private renderReal(x: real) -> string

@intrinsic("format_real")
private formatReal(x: real, conversion: char, flags: int, width: int, precision: int) -> string

@intrinsic("render_char")
private renderChar(c: char) -> string

@intrinsic("text_size")
private textSize(text: string) -> long

@intrinsic("text_width")
private textWidth(text: string) -> long

@intrinsic("text_append")
private textAppend(store: string, used: long, text: string) -> string

@intrinsic("text_take")
private textTake(store: string, used: long) -> string

@intrinsic("quote_text")
private quoteText(text: string) -> string

@intrinsic("quote_char")
private quoteChar(c: char) -> string
