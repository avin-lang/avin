module avin

// A growable, mutable sequence that adds and removes at both ends in amortized constant time:
// `addFirst` and `addLast` put an element at the front or the back, `removeFirst` and `removeLast`
// take one off, trapping when there is none, and `d(i)` reads and `d(i) = v` replaces the element `i`
// places from the front. A deque is a queue (`addLast` and `removeFirst`) and a stack (`addLast` and
// `removeLast`) alike. `Deque[int]()` is a new, empty deque.
//
// The elements are `count` consecutive places of `items`, starting at `first` and wrapping around
// from the array's end to its start. The other places are spare capacity: each is zero bytes, never
// read before an element is written to it, so the deque needs no value to fill them with. When the
// array is full it is replaced by one twice as long, the elements moved to its start in order.
class Deque[T](): Seq[T]
    private var items: Array[T] = newArray[T](0)
    private var first = 0
    private var count = 0

    override length() -> int = count

    // The element `index` places from the front.
    override apply(index: int) -> T
        if index < 0 || index >= count then fail("index out of range")
        items(slot(index))

    // Replaces the element `index` places from the front with `value`.
    update(index: int, value: T)
        if index < 0 || index >= count then fail("index out of range")
        items(slot(index)) = value

    // Puts `element` in front of the others.
    addFirst(element: T)
        if count == items.length() then grow()
        first = if first == 0 then items.length() - 1 else first - 1
        items(first) = element
        count += 1

    // Puts `element` after the others.
    addLast(element: T)
        if count == items.length() then grow()
        items(slot(count)) = element
        count += 1

    // Appends every element of `elements`, in order.
    addAll(elements: Iterable[T])
        for x in elements do addLast(x)

    // Takes off the first element and returns it; traps when there is none.
    removeFirst() -> T
        if count == 0 then fail("removeFirst on an empty deque")
        val removed = items(first)
        clearElements(items, first, first + 1)
        first = if first == items.length() - 1 then 0 else first + 1
        count -= 1
        removed

    // Takes off the last element and returns it; traps when there is none.
    removeLast() -> T
        if count == 0 then fail("removeLast on an empty deque")
        val at = slot(count - 1)
        val removed = items(at)
        clearElements(items, at, at + 1)
        count -= 1
        removed

    // Removes every element, keeping the capacity.
    clear()
        for i in 0 ..< count
            val at = slot(i)
            clearElements(items, at, at + 1)
        first = 0
        count = 0

    // Whether some element equals `element`.
    contains(element: T) -> bool = indexOf(element).isSome()

    // The index of the first element equal to `element`, or `None` when there is none.
    indexOf(element: T) -> Option[int] = indexWhere(x -> x.equals(element))

    // A new array of the elements, front first.
    toArray() -> Array[T]
        val a = newArray[T](count)
        for i in 0 ..< count do a(i) = items(slot(i))
        a

    // A vector of the elements as they are now, front first.
    override toVector() -> Vector[T] = Vector(freeze(toArray()))

    // The place in `items` of the element `index` places from the front, which wraps around from the
    // array's end to its start.
    private slot(index: int) -> int
        val beforeEnd = items.length() - first
        if index < beforeEnd then first + index else index - beforeEnd

    // Replaces the array with one twice as long, or of eight elements when it is empty, with the
    // elements at its start in order.
    private grow()
        val capacity = items.length()
        val larger = newArray[T](if capacity == 0 then 8 elif capacity >= 1073741824 then 2147483647 else capacity * 2)
        for i in 0 ..< count do larger(i) = items(slot(i))
        items = larger
        first = 0

// Two deques are equal when they hold equal elements in the same order, at the time they are
// compared.
impl[T] Eq for Deque[T]
    equals(other: Deque[T]) -> bool
        if count != other.length() then return false
        for i in 0 ..< count
            if !apply(i).equals(other(i)) then return false
        true

impl[T] Hash for Deque[T]
    hash() -> long
        var h = long(1)
        for i in 0 ..< count do h = h *% 31 +% apply(i).hash()
        h

// A deque of displayable elements joins its elements, as they are now, into a string.
impl[T: Display] Deque[T]
    // The elements in their own `Display`, separated by `sep`.
    mkString(sep: string = ", ") -> string = joined(iterator(), "", sep, "")

    // The elements between `start` and `end`, separated by `sep`.
    mkString(start: string, sep: string, end: string) -> string = joined(iterator(), start, sep, end)

// A deque of displayable elements displays its elements as they are now, front first, as
// `[1, 2, 3]`. A field width pads the whole.
impl[T: Display] Display for Deque[T]
    display(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            display(text, FormatSpec())
            out.writeField(text.text(), spec)
            return
        out.write("[")
        for i in 0 ..< count
            if i > 0 then out.write(", ")
            apply(i).display(out, FormatSpec())
        out.write("]")

// A deque's diagnostic form is its elements' diagnostic forms in brackets: `["a", "b"]`.
impl[T: Debug] Debug for Deque[T]
    debug(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            debug(text, FormatSpec())
            out.writeField(text.text(), spec)
            return
        out.write("[")
        for i in 0 ..< count
            if i > 0 then out.write(", ")
            apply(i).debug(out, FormatSpec())
        out.write("]")

object Deque
    // A new, empty deque.
    empty[T]() -> Deque[T] = Deque[T]()

    // A builder of a deque: the elements it is given, front first.
    builder[T]() -> DequeBuilder[T] = DequeBuilder(Deque[T](), false)

// Builds a deque by adding to its back.
class DequeBuilder[T](private val deque: Deque[T], private var spent: bool): Builder[T, Deque[T]]
    override add(element: T)
        if spent then fail("add to a builder whose result was taken")
        deque.addLast(element)

    override result() -> Deque[T]
        if spent then fail("result of a builder whose result was taken")
        spent = true
        deque
