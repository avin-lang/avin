module avin

// A growable, mutable sequence that adds and removes at both ends in amortized constant time:
// `prepend` and `append` put an element at the front or the back, `removeHead` and `removeLast`
// take one off, trapping when there is none, and `d(i)` reads and `d(i) = v` replaces the element `i`
// places from the front. A deque is a queue (`append` and `removeHead`) and a stack (`append` and
// `removeLast`) alike. `Deque[int]()` is a new, empty deque.
//
// The elements are `count` consecutive places of `items`, starting at `first` and wrapping around
// from the array's end to its start. The other places are spare capacity: each is zero bytes, never
// read before an element is written to it, so the deque needs no value to fill them with. When the
// array is full it is replaced by one twice as long, the elements moved to its start in order.
class Deque[T](): Seq[T]
    private var items: Array[T] = newArray[T](0)
    private var first = 0
    private var count = 0

    override length -> int = count

    // The element `index` places from the front.
    override apply(index: int) -> T
        if index < 0 || index >= count then fail("index out of range")
        items(slot(index))

    // Replaces the element `index` places from the front with `value`.
    update(index: int, value: T)
        if index < 0 || index >= count then fail("index out of range")
        items(slot(index)) = value

    // Puts `element` in front of the others.
    prepend(element: T)
        if count == items.length then grow()
        first = if first == 0 then items.length - 1 else first - 1
        items(first) = element
        count += 1

    // Puts `element` after the others.
    append(element: T)
        if count == items.length then grow()
        items(slot(count)) = element
        count += 1

    // Puts `element` after the others, as `append` does.
    addOne(element: T) = append(element)

    // Appends every element of `elements`, in order. A deque added to itself appends the elements it
    // held when the call began, once.
    addAll(elements: Iterable[T])
        if elements === self
            val n = count
            for i in 0 ..< n do append(apply(i))
            return
        for x in elements do append(x)

    // Appends every element of `elements`, in order, as `addAll` does.
    appendAll(elements: Iterable[T]) = addAll(elements)

    // Puts every element of `elements` in front of the others, in their order. The elements are read
    // before any is placed, so a deque prepended to itself prepends the elements it held.
    prependAll(elements: Iterable[T])
        val incoming = elements.toArraySeq
        var i = incoming.length - 1
        while i >= 0
            prepend(incoming(i))
            i -= 1

    // Puts `element` at `index`, moving the elements from there one place on; `index` may be
    // `length`, which appends, or 0, which prepends.
    insert(index: int, element: T)
        if index < 0 || index > count then fail("index out of range")
        if index == 0
            prepend(element)
            return
        append(element)
        var i = count - 1
        while i > index
            items(slot(i)) = items(slot(i - 1))
            i -= 1
        items(slot(index)) = element

    // Puts every element of `elements` at `index`, in their order, moving the elements from there on
    // past them. The elements are read before any is placed.
    insertAll(index: int, elements: Iterable[T])
        if index < 0 || index > count then fail("index out of range")
        val incoming = elements.toArraySeq
        for j in 0 ..< incoming.length do insert(index + j, incoming(j))

    // Takes off the first element and returns it; traps when there is none.
    removeHead() -> T
        if count == 0 then fail("removeHead on an empty deque")
        val removed = items(first)
        clearElements(items, first, first + 1)
        first = if first == items.length - 1 then 0 else first + 1
        count -= 1
        removed

    // Takes off the last element and returns it; traps when there is none.
    removeLast() -> T
        if count == 0 then fail("removeLast on an empty deque")
        val at = slot(count - 1)
        val removed = items(at)
        clearElements(items, at, at + 1)
        count -= 1
        removed

    // Takes out `n` elements from `index` on, moving the elements after them `n` places back (or, at
    // the front, the front on). `n` may be 0, and `index` may be `length` when `n` is 0; a range
    // that is not within the deque traps.
    remove(index: int, n: int)
        if index < 0 || n < 0 || n > count - index then fail("range out of range")
        if n == 0 then return
        if index == 0
            trimStart(n)
            return
        for i in index ..< count - n do items(slot(i)) = items(slot(i + n))
        for i in count - n ..< count
            val at = slot(i)
            clearElements(items, at, at + 1)
        count -= n

    // Takes off the first `n` elements; traps unless `0 <= n <= length`.
    trimStart(n: int)
        if n < 0 || n > count then fail("count out of range")
        if n == 0 then return
        for i in 0 ..< n
            val at = slot(i)
            clearElements(items, at, at + 1)
        first = slot(n)
        count -= n

    // Takes off the last `n` elements; traps unless `0 <= n <= length`.
    trimEnd(n: int)
        if n < 0 || n > count then fail("count out of range")
        remove(count - n, n)

    // Keeps only the elements that satisfy `p`, in order, testing each once from the front. `p` must
    // not change the deque; a deque that has changed when `p` returns traps.
    filterInPlace(p: (T) -> bool)
        val n = count
        var kept = 0
        for i in 0 ..< n
            val x = items(slot(i))
            val keep = p(x)
            if count != n then fail("deque changed during filterInPlace")
            if keep
                items(slot(kept)) = x
                kept += 1
        for i in kept ..< n
            val at = slot(i)
            clearElements(items, at, at + 1)
        count = kept

    // Replaces each element with `f` of it, from the front. `f` must not change the deque; a deque
    // that has changed when `f` returns traps.
    mapInPlace(f: (T) -> T)
        val n = count
        for i in 0 ..< n
            val y = f(items(slot(i)))
            if count != n then fail("deque changed during mapInPlace")
            items(slot(i)) = y

    // Replaces the `replaced` elements from `from` on with the elements of `other`, in their order.
    // `from` may be `length` and `replaced` may be 0 (an insertion); a range that is not within the
    // deque traps. The elements of `other` are read before any change.
    patchInPlace(from: int, other: Iterable[T], replaced: int)
        if from < 0 || from > count || replaced < 0 || replaced > count - from then fail("range out of range")
        val incoming = other.toArraySeq
        remove(from, replaced)
        insertAll(from, incoming)

    // Puts the elements in the opposite order.
    reverseInPlace()
        var i = 0
        var j = count - 1
        while i < j
            val a = slot(i)
            val b = slot(j)
            val x = items(a)
            items(a) = items(b)
            items(b) = x
            i += 1
            j -= 1

    // Removes every element, keeping the capacity.
    clear()
        for i in 0 ..< count
            val at = slot(i)
            clearElements(items, at, at + 1)
        first = 0
        count = 0

    // A new array of the elements, front first.
    toArray() -> Array[T]
        val a = newArray[T](count)
        for i in 0 ..< count do a(i) = items(slot(i))
        publish(a)
        a

    // A vector of the elements as they are now, front first.
    override toVector -> Vector[T] = vectorOf(freeze(toArray()))

    // The elements as they are now, front first, in one array read in constant time.
    override toArraySeq -> ArraySeq[T] = ArraySeq(freeze(toArray()))

    // A new deque of `f` of each element, front first.
    map[U](f: (T) -> U) -> Deque[U]
        val out = Deque[U]()
        for i in 0 ..< count do out.append(f(items(slot(i))))
        out

    // A new deque of `pf` of each element it is defined at, front first.
    collect[U](pf: PartialFunction[T, U]) -> Deque[U]
        val f = pf.lift()
        val out = Deque[U]()
        for i in 0 ..< count
            if f(items(slot(i))) is Some(u) then out.append(u)
        out

    // A new deque of the elements of the collections `f` makes of each element, joined front first.
    flatMap[U](f: (T) -> Iterable[U]) -> Deque[U]
        val out = Deque[U]()
        for i in 0 ..< count do out.addAll(f(items(slot(i))))
        out

    // A new deque of the elements that satisfy `p`, front first.
    filter(p: (T) -> bool) -> Deque[T] = keptInto(self, p, true, Deque.newBuilder[T]())

    // A new deque of the elements that do not satisfy `p`, front first.
    filterNot(p: (T) -> bool) -> Deque[T] = keptInto(self, p, false, Deque.newBuilder[T]())

    // The elements that satisfy `p`, tested only as `map`, `flatMap` or `foreach` reaches each one.
    withFilter(p: (T) -> bool) -> FilteredDeque[T] = FilteredDeque(self, p)

    // Reorders the elements in place, front first, by `compare`, which is negative, zero or positive
    // as its first argument orders before, with or after its second. The sort is stable.
    sortInPlaceWith(compare: (T, T) -> int)
        val a = toArray()
        sortElements(a, count, compare)
        for i in 0 ..< count do items(slot(i)) = a(i)

    // Reorders the elements in place, front first, by their keys, `key` being computed once for
    // each element. The sort is stable.
    sortInPlaceBy[K: Ord](key: (T) -> K)
        val a = toArray()
        sortElementsBy(a, count, key)
        for i in 0 ..< count do items(slot(i)) = a(i)

    // The place in `items` of the element `index` places from the front, which wraps around from the
    // array's end to its start.
    private slot(index: int) -> int
        val beforeEnd = items.length - first
        if index < beforeEnd then first + index else index - beforeEnd

    // Replaces the array with one twice as long, or of eight elements when it is empty, with the
    // elements at its start in order.
    private grow()
        val capacity = items.length
        val larger = newArray[T](if capacity == 0 then 8 elif capacity >= 1073741824 then 2147483647 else capacity * 2)
        for i in 0 ..< count do larger(i) = items(slot(i))
        publish(larger)
        items = larger
        first = 0

// A deque of ordered elements sorts in place, ascending from the front; the sort is stable.
impl[T: Ord] Deque[T]
    sortInPlace() = sortInPlaceWith((x, y) -> x.compare(y))

// A deque of displayable elements displays its elements as they are now, front first, as
// `[1, 2, 3]`. A field width pads the whole.
impl[T: Display] Display for Deque[T]
    display(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            display(text, FormatSpec())
            out.writeField(text.text(), spec)
            return
        out.write("[")
        for i in 0 ..< count
            if i > 0 then out.write(", ")
            apply(i).display(out, FormatSpec())
        out.write("]")

// A deque's diagnostic form is its elements' diagnostic forms in brackets: `["a", "b"]`.
impl[T: Debug] Debug for Deque[T]
    debug(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            debug(text, FormatSpec())
            out.writeField(text.text(), spec)
            return
        out.write("[")
        for i in 0 ..< count
            if i > 0 then out.write(", ")
            apply(i).debug(out, FormatSpec())
        out.write("]")

// A deque of comparable elements can take one out by value.
impl[T: Eq] Deque[T]
    // Takes out the first element, from the front, equal to `element`, moving the elements after it
    // one place back, and answers whether there was one.
    subtractOne(element: T) -> bool
        val at = indexOf(element)
        if at < 0 then return false
        remove(at, 1)
        true

object Deque
    // A new, empty deque.
    empty[T]() -> Deque[T] = Deque[T]()

    // A builder of a deque: the elements it is given, front first.
    newBuilder[T]() -> DequeBuilder[T] = DequeBuilder(Deque[T](), false)

// Builds a deque by adding to its back.
class DequeBuilder[T](private var deque: Deque[T], private var spent: bool): Builder[T, Deque[T]]
    override addOne(element: T)
        if spent then fail("add to a builder whose result was taken")
        deque.append(element)

    override result() -> Deque[T]
        if spent then fail("result of a builder whose result was taken")
        spent = true
        deque

    // Starts a new deque, leaving one already handed over as it is.
    override clear()
        deque = Deque[T]()
        spent = false

    override knownSize -> int = deque.length

// A deque seen through a test, which a guard of a `for` with `yield` makes: each element is tested
// just before the call after it would use it, so a guard runs in turn with the rest of the
// comprehension, element by element.
class FilteredDeque[T](private val deque: Deque[T], private val p: (T) -> bool)
    // A new deque of `f` of each element that passes the test, front first.
    map[U](f: (T) -> U) -> Deque[U]
        val out = Deque[U]()
        for x in deque
            if p(x) then out.append(f(x))
        out

    // A new deque of the elements of the collections `f` makes of each element that passes the test.
    flatMap[U](f: (T) -> Iterable[U]) -> Deque[U]
        val out = Deque[U]()
        for x in deque
            if p(x) then out.addAll(f(x))
        out

    // The elements that pass this test and then `q`.
    withFilter(q: (T) -> bool) -> FilteredDeque[T] = FilteredDeque(deque, x -> p(x) && q(x))

    // Calls `f` with each element that passes the test, front first.
    foreach(f: (T) -> unit)
        for x in deque
            if p(x) then f(x)
