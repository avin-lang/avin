module avin

// `<`, `<=`, `>` and `>=` are `Ord`'s `less`, `lessOrEqual`, `greater` and `greaterOrEqual`. A type
// implements `compare`, which is negative, zero or positive as the value orders before, with or after
// `other`; the four comparisons follow from it, and a type may implement them as well where it can
// answer one more directly. `Ord` is never implemented implicitly.

trait Ord: Eq
    compare(other: Self) -> int
    less(other: Self) -> bool = compare(other) < 0
    lessOrEqual(other: Self) -> bool = compare(other) <= 0
    greater(other: Self) -> bool = compare(other) > 0
    greaterOrEqual(other: Self) -> bool = compare(other) >= 0

// The built-in types order as their comparison operators do: integers and chars by value, bytes as
// unsigned, reals as IEEE 754 orders them, and strings by their bytes.

impl[T: Integer] Ord for T
    compare(other: T) -> int = if self < other then -1 elif self > other then 1 else 0
    less(other: T) -> bool = self < other
    lessOrEqual(other: T) -> bool = self <= other
    greater(other: T) -> bool = self > other
    greaterOrEqual(other: T) -> bool = self >= other

impl Ord for byte
    compare(other: byte) -> int = if self < other then -1 elif self > other then 1 else 0
    less(other: byte) -> bool = self < other
    lessOrEqual(other: byte) -> bool = self <= other
    greater(other: byte) -> bool = self > other
    greaterOrEqual(other: byte) -> bool = self >= other

impl Ord for char
    compare(other: char) -> int = if self < other then -1 elif self > other then 1 else 0
    less(other: char) -> bool = self < other
    lessOrEqual(other: char) -> bool = self <= other
    greater(other: char) -> bool = self > other
    greaterOrEqual(other: char) -> bool = self >= other

impl Ord for real
    compare(other: real) -> int = if self < other then -1 elif self > other then 1 else 0
    less(other: real) -> bool = self < other
    lessOrEqual(other: real) -> bool = self <= other
    greater(other: real) -> bool = self > other
    greaterOrEqual(other: real) -> bool = self >= other

impl Ord for string
    compare(other: string) -> int = if self < other then -1 elif self > other then 1 else 0
    less(other: string) -> bool = self < other
    lessOrEqual(other: string) -> bool = self <= other
    greater(other: string) -> bool = self > other
    greaterOrEqual(other: string) -> bool = self >= other
