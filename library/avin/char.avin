module avin

// The methods of `char`, a Unicode scalar value. Classification and case mapping follow the Unicode
// Character Database, so `'é'` is a letter and a lower-case one, and `'٣'` is a digit.

@sysl("sysl.unicode.is_alpha")
private isAlpha(c: char) -> bool

@sysl("sysl.unicode.is_digit")
private isDecimal(c: char) -> bool

@sysl("sysl.unicode.is_space")
private isSpaceProperty(c: char) -> bool

@sysl("sysl.unicode.is_upper")
private isUpperCase(c: char) -> bool

@sysl("sysl.unicode.is_lower")
private isLowerCase(c: char) -> bool

@sysl("sysl.unicode.to_upper")
private upperChar(c: char) -> char

@sysl("sysl.unicode.to_lower")
private lowerChar(c: char) -> char

impl char
    // Whether it is a decimal digit of any script: the Unicode category `Nd`.
    isDigit() -> bool = isDecimal(self)

    // Whether it is a letter of any script: the Unicode categories `Lu`, `Ll`, `Lt`, `Lm` and `Lo`.
    isLetter() -> bool = isAlpha(self)

    isLetterOrDigit() -> bool = isLetter() || isDigit()

    // Whether it has the Unicode `White_Space` property, the characters `trim` removes.
    isWhitespace() -> bool = isSpaceProperty(self)

    // Whether it is a cased, upper-case character.
    isUpper() -> bool = isUpperCase(self)

    // Whether it is a cased, lower-case character.
    isLower() -> bool = isLowerCase(self)

    // Whether it is a control character: U+0000 to U+001F and U+007F to U+009F.
    isControl() -> bool = int(self) < 32 || (int(self) >= 127 && int(self) < 160)

    // Its simple upper-case mapping, one character for one: `'ß'` has none and is unchanged.
    toUpper() -> char = upperChar(self)

    // Its simple lower-case mapping, one character for one.
    toLower() -> char = lowerChar(self)

    // The value of the digit it names in a base up to 36: `'0'` to `'9'` are 0 to 9, and the ASCII
    // letters, either case, are 10 to 35. It traps on any other character.
    asDigit() -> int
        val n = int(self)
        if n >= 48 && n <= 57 then return n - 48
        if n >= 97 && n <= 122 then return n - 87
        if n >= 65 && n <= 90 then return n - 55
        fail("asDigit of a character that is not a digit or an ASCII letter")
