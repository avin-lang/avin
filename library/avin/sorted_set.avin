module avin

// A set kept in the order of its elements: iteration visits them in ascending order, and it has the
// ordered operations, the first and last elements, the nearest element to a value, and the elements
// from, until or between values. `TreeSet` is the sorted set. An update through `SortedSet` answers a
// `SortedSet`, so `sorted.added(x).first()` stays sorted.
trait SortedSet[A]: Set[A]
    override added(element: A) -> SortedSet[A]

    override removed(element: A) -> SortedSet[A]

    override ++(other: Iterable[A]) -> SortedSet[A]
        var s: SortedSet[A] = self
        for x in other do s = s.added(x)
        s

    override --(other: Iterable[A]) -> SortedSet[A]
        var s: SortedSet[A] = self
        for x in other do s = s.removed(x)
        s

    override union(other: Set[A]) -> SortedSet[A] = self ++ other

    override intersect(other: Set[A]) -> SortedSet[A] = filter(x -> other.contains(x))

    override diff(other: Set[A]) -> SortedSet[A] = filter(x -> !other.contains(x))

    override filter(p: (A) -> bool) -> SortedSet[A]
        var s: SortedSet[A] = self
        for x in self
            if !p(x) then s = s.removed(x)
        s

    // The elements in descending order, visited one at a time.
    reverseIterator() -> Iterator[A]

    // The least element, or `None` when the set is empty.
    first() -> Option[A]

    // The greatest element, or `None` when the set is empty.
    last() -> Option[A]

    // The greatest element at most `x`, or `None` when every element is greater.
    floor(x: A) -> Option[A]

    // The least element at least `x`, or `None` when every element is less.
    ceiling(x: A) -> Option[A]

    // The elements at least `low`.
    from(low: A) -> SortedSet[A]

    // The elements less than `high`.
    until(high: A) -> SortedSet[A]

    // The elements at least `low` and less than `high`; none when `high` is not greater than `low`.
    range(low: A, high: A) -> SortedSet[A]

// The sorted set companion builds tree sets, typed as sorted sets, as a set literal does where a
// `SortedSet` is expected.
object SortedSet
    // A sorted set with no elements.
    empty[A: Ord]() -> SortedSet[A] = TreeSet[A](Tip)

    // A sorted set of the elements given, each equal one once.
    apply[A: Ord](elements: A*) -> SortedSet[A]
        var t: SortedTree[A, unit] = Tip
        for x in elements do t = treeInsert(t, x, ())
        TreeSet(t)

    // A builder of a sorted set: the elements it is given, each held once.
    builder[A: Ord]() -> Builder[A, SortedSet[A]] = TreeSetBuilder[A]()
