module avin.json

// Why JSON text could not be read, and where: the line and column of the character at fault, both
// counted from 1 and the column in characters, and its byte offset in the text, counted from 0. A
// line ends at a line feed. All three are `long`s, since a stream read by a `JsonReader` may run
// past two gibibytes, and on one line. An error decoding a program's own type also carries the path
// from the document's top to the value at fault, outermost first: `home.street` is `[Key("home"),
// Key("street")]`. An error of `parse` has an empty path.
data JsonError(message: string, line: long, column: long, offset: long, path: List[PathStep] = [])

// One step of a path into a document: a member's key, or an element's index.
data PathStep
    Key(name: string)
    Index(at: int)

impl JsonError
    // The error with `name`'s member in front of its path, as the decoder of the object holding the
    // value at fault adds it.
    inField(name: string) -> JsonError = JsonError(message, line, column, offset, Key(name) :: path)

    // The error with the element `i` in front of its path.
    atIndex(i: int) -> JsonError = JsonError(message, line, column, offset, Index(i) :: path)

    // The path written out: keys joined by `.`, an index in brackets, so `items[2].name`; empty where
    // the error is at the document's top.
    pathText() -> string
        val out = StringWriter()
        var first = true
        for step in path
            step match
                Key(name) ->
                    if !first then out.writeChar('.')
                    out.write(name)
                Index(i) -> out.write(s"[$i]")
            first = false
        out.text

// An error displays as its path, where it has one, its message and its place: `expected ':' after an
// object's key at line 3, column 9`; `home.street: expected a string, found a number at line 1,
// column 51`.
impl Display for JsonError
    display(out: Writer, spec: FormatSpec)
        val place = if path.isEmpty then "" else s"${pathText()}: "
        out.writeField(s"$place$message at line $line, column $column", spec)

// How deeply arrays and objects may nest in the text `parse` reads unless it is told otherwise.
val defaultMaxDepth: int = 512

// The JSON value `text` writes, with nothing but white space around it, or the first thing wrong with
// it. Arrays and objects may nest `maxDepth` deep, so a top-level array of arrays is two deep.
parse(text: string, maxDepth: int = defaultMaxDepth) -> Result[Json, JsonError] = TextReader(text, maxDepth).document()

// As `parse(text)`, for text given as its UTF-8 bytes; bytes that are not UTF-8 are an error at the
// first of them.
parse(bytes: Array[byte], maxDepth: int = defaultMaxDepth) -> Result[Json, JsonError] = string.fromUtf8(bytes) match
    Ok(text) -> parse(text, maxDepth)
    Err(e) ->
        val offset = int(e.offset)
        Err(errorAt(string.fromUtf8Lossy(bytes.slice(0, offset)), offset, "bytes that are not UTF-8"))

// The error `message` at byte `offset` of `text`, with its line and column counted out.
private errorAt(text: string, offset: int, message: string) -> JsonError
    var line = 1
    var lineStart = 0
    val end = if offset < text.byteLength then offset else text.byteLength
    var i = 0
    while i < end
        if text.byteAt(i) == byte(0x0a)
            line += 1
            lineStart = i + 1
        i += 1
    var column = 1
    i = lineStart
    while i < end
        if (int(text.byteAt(i)) & 0xc0) != 0x80 then column += 1
        i += 1
    JsonError(message, long(line), long(column), long(offset))

// Reads one JSON value from `text`, a byte at a time from `at`.
private class TextReader(text: string, maxDepth: int)
    private val n: int = text.byteLength
    private var at = 0

    document() -> Result[Json, JsonError]
        skipSpace()
        val value = readValue(0)?
        skipSpace()
        if at < n then return Err(fault(s"${unexpected()} after the value"))
        Ok(value)

    private fault(message: string) -> JsonError = errorAt(text, at, message)

    // The character at `at`, which is not past the end.
    private peek() -> char = char(int(text.byteAt(at)))

    // What stands at `at`, for a message: the character quoted, or the end of the text.
    private unexpected() -> string
        if at >= n then return "unexpected end of text"
        val c = text.charAt(at)
        if int(c) < 0x20 || int(c) == 0x7f then s"unexpected control character U+${hex4(int(c))}" else s"unexpected '$c'"

    private skipSpace()
        while at < n
            peek() match
                ' ' | '\n' | '\r' | '\t' -> at += 1
                _ -> return

    private readValue(depth: int) -> Result[Json, JsonError]
        if at >= n then return Err(fault("unexpected end of text where a value was expected"))
        peek() match
            '{' -> readObject(depth + 1)
            '[' -> readArray(depth + 1)
            '"' -> Ok(Str(readString()?))
            't' -> readWord("true", Bool(true))
            'f' -> readWord("false", Bool(false))
            'n' -> readWord("null", Null)
            '-' | '0'..'9' -> readNumber()
            _ -> Err(fault(s"${unexpected()} where a value was expected"))

    private readWord(word: string, value: Json) -> Result[Json, JsonError]
        if text.startsWith(word, at)
            val after = at + word.byteLength
            if after >= n || !isWordChar(char(int(text.byteAt(after))))
                at = after
                return Ok(value)
        var end = at
        while end < n && isWordChar(char(int(text.byteAt(end))))
            end += 1
        if end == at then end = at + 1
        Err(fault(s"unexpected word '${text.slice(at, end)}' where a value was expected"))

    private isWordChar(c: char) -> bool = c match
        'a'..'z' | 'A'..'Z' | '0'..'9' | '_' -> true
        _ -> false

    private nested(depth: int) -> Result[unit, JsonError]
        if depth > maxDepth then Err(fault(s"arrays and objects nested more than $maxDepth deep")) else Ok(())

    private readArray(depth: int) -> Result[Json, JsonError]
        nested(depth)?
        at += 1
        val items = Buffer[Json]()
        skipSpace()
        if at < n && peek() == ']'
            at += 1
            return Ok(Arr(items.toVector))
        loop
            skipSpace()
            items.addOne(readValue(depth)?)
            skipSpace()
            if at >= n then return Err(fault("unexpected end of text in an array, where ',' or ']' was expected"))
            peek() match
                ',' ->
                    at += 1
                    skipSpace()
                    if at < n && peek() == ']' then return Err(fault("unexpected ']' after ',' in an array"))
                ']' ->
                    at += 1
                    return Ok(Arr(items.toVector))
                _ -> return Err(fault(s"${unexpected()} in an array, where ',' or ']' was expected"))

    private readObject(depth: int) -> Result[Json, JsonError]
        nested(depth)?
        at += 1
        val members = Buffer[(string, Json)]()
        skipSpace()
        if at < n && peek() == '}'
            at += 1
            return Ok(Obj(members.toVector))
        loop
            skipSpace()
            if at >= n || peek() != '"'
                if at < n && peek() == '}' && members.length > 0 then return Err(fault("unexpected '}' after ',' in an object"))
                return Err(fault(s"${unexpected()} where an object's key was expected"))
            val key = readString()?
            skipSpace()
            if at >= n || peek() != ':' then return Err(fault(s"${unexpected()} after an object's key, where ':' was expected"))
            at += 1
            skipSpace()
            members.addOne((key, readValue(depth)?))
            skipSpace()
            if at >= n then return Err(fault("unexpected end of text in an object, where ',' or '}' was expected"))
            peek() match
                ',' -> at += 1
                '}' ->
                    at += 1
                    return Ok(Obj(members.toVector))
                _ -> return Err(fault(s"${unexpected()} in an object, where ',' or '}' was expected"))

    // A string from its opening quote at `at` to its closing one. A string with no escape is one
    // slice of the text.
    private readString() -> Result[string, JsonError]
        at += 1
        val start = at
        while at < n
            val b = int(text.byteAt(at))
            if b == int('"')
                val s = text.slice(start, at)
                at += 1
                return Ok(s)
            if b == int('\\') || b < 0x20 then return readEscaped(start)
            at += 1
        Err(fault("unexpected end of text in a string"))

    private readEscaped(start: int) -> Result[string, JsonError]
        val out = StringWriter()
        var run = start
        while at < n
            val b = int(text.byteAt(at))
            if b == int('"')
                if run < at then out.write(text.slice(run, at))
                at += 1
                return Ok(out.text)
            if b < 0x20 then return Err(fault(s"unexpected control character U+${hex4(b)} in a string, which must be written as an escape"))
            if b == int('\\')
                if run < at then out.write(text.slice(run, at))
                readEscape(out)?
                run = at
            else
                at += 1
        Err(fault("unexpected end of text in a string"))

    // One escape, from its backslash at `at`, written to `out`.
    private readEscape(out: StringWriter) -> Result[unit, JsonError]
        at += 1
        if at >= n then return Err(fault("unexpected end of text in an escape"))
        peek() match
            '"' -> out.writeChar('"')
            '\\' -> out.writeChar('\\')
            '/' -> out.writeChar('/')
            'b' -> out.writeChar('\u{8}')
            'f' -> out.writeChar('\u{c}')
            'n' -> out.writeChar('\n')
            'r' -> out.writeChar('\r')
            't' -> out.writeChar('\t')
            'u' ->
                at -= 1
                val code = readUnit()?
                if 0xdc00 <= code <= 0xdfff
                    at -= 6
                    return Err(fault(s"a lone low surrogate \\u${hex4(code)}, which no character is"))
                if 0xd800 <= code <= 0xdbff
                    if !text.startsWith("\\u", at)
                        at -= 6
                        return Err(fault(s"a high surrogate \\u${hex4(code)} with no low surrogate after it"))
                    val low = readUnit()?
                    if !(0xdc00 <= low <= 0xdfff)
                        at -= 12
                        return Err(fault(s"a high surrogate \\u${hex4(code)} followed by \\u${hex4(low)}, which is not a low surrogate"))
                    out.writeChar(char(0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00)))
                else
                    out.writeChar(char(code))
                return Ok(())
            _ -> return Err(fault(s"${unexpected()} after '\\' in a string, where an escape was expected"))
        at += 1
        Ok(())

    // The four hexadecimal digits of a `\u` escape at `at`, moving past them.
    private readUnit() -> Result[int, JsonError]
        at += 2
        var code = 0
        var k = 0
        while k < 4
            if at >= n then return Err(fault("unexpected end of text in a \\u escape"))
            val digit = peek() match
                '0'..'9' -> int(peek()) - int('0')
                'a'..'f' -> int(peek()) - int('a') + 10
                'A'..'F' -> int(peek()) - int('A') + 10
                _ -> return Err(fault(s"${unexpected()} in a \\u escape, where a hexadecimal digit was expected"))
            code = code * 16 + digit
            at += 1
            k += 1
        Ok(code)

    // A number from `at`. A whole number that fits a `long` is a `Long`, and any other a `Real`.
    private readNumber() -> Result[Json, JsonError]
        val start = at
        val negative = peek() == '-'
        if negative then at += 1
        if at >= n || !('0' <= peek() <= '9') then return Err(fault(s"${unexpected()} in a number, where a digit was expected"))
        val least = long(-9223372036854775807) - 1
        // The value builds on the negative side, which holds every `long` including the least.
        var acc: long = 0
        var fits = true
        if peek() == '0'
            at += 1
            if at < n && '0' <= peek() <= '9'
                at -= 1
                return Err(fault("a number with a leading zero"))
        else
            while at < n && '0' <= peek() <= '9'
                val digit = long(int(peek()) - int('0'))
                if fits
                    if acc < least / 10 || acc * 10 < least + digit then fits = false else acc = acc * 10 - digit
                at += 1
        var whole = true
        if at < n && peek() == '.'
            whole = false
            at += 1
            if at >= n || !('0' <= peek() <= '9') then return Err(fault(s"${unexpected()} after a number's '.', where a digit was expected"))
            while at < n && '0' <= peek() <= '9'
                at += 1
        if at < n && (peek() == 'e' || peek() == 'E')
            whole = false
            at += 1
            if at < n && (peek() == '+' || peek() == '-') then at += 1
            if at >= n || !('0' <= peek() <= '9') then return Err(fault(s"${unexpected()} in a number's exponent, where a digit was expected"))
            while at < n && '0' <= peek() <= '9'
                at += 1
        if whole && fits
            if negative then return Ok(Long(acc))
            if acc != least then return Ok(Long(-acc))
        if text.slice(start, at).toRealOption() is Some(x) then return Ok(Real(x))
        val end = at
        at = start
        Err(fault(s"the number ${text.slice(start, end)} is too large for a real"))

// `code` as four hexadecimal digits, upper case.
private hex4(code: int) -> string
    val digits = "0123456789ABCDEF"
    var s = ""
    var shift = 12
    while shift >= 0
        s = s + digits.charAt((code >> shift) & 0xf).toString()
        shift -= 4
    s
