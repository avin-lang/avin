module avin

// An immutable set: each element present at most once. `Set` is the trait every immutable set
// conforms to: the hash-based `HashSet`, which a set literal `{1, 2}`, `Set(...)` and `Set.empty`
// build, and the sorted `TreeSet`, through `SortedSet`. A function over `Set[int]` takes either. A set
// is also the predicate of membership, `(A) -> bool`, so `xs.filter(allowed)` keeps the elements of
// `xs` in the set `allowed`.
//
// An update answers a new set of the same kind, which shares all but the changed path with the old
// one, left as it was: a tree set updated through `Set` is still a tree set. A method that makes
// elements of another type (`map`, `collect`, `flatMap`) answers a hash set. Two sets are equal when
// they hold the same elements, whatever their kinds, and equal sets hash alike.
trait Set[A]: Iterable[A], (A) -> bool, ErasedSet, Sendable
  // The number of elements.
  override size -> int

  // The number of elements, which a set holds: the same as `size`.
  override knownSize -> int = size

  contains(element: A) -> bool

  // This set with `element` in it; the same set when it already was.
  incl(element: A) -> Set[A]

  // This set without `element`; the same set when it was absent.
  excl(element: A) -> Set[A]

  isEmpty -> bool = size == 0

  nonEmpty -> bool = size != 0

  // Whether `element` is in the set: `s(x)` is `s.contains(x)`, and the set is the function
  // `(A) -> bool` this makes it.
  apply(element: A) -> bool = contains(element)

  // This set with every element of `other` in it: `s ++ xs`.
  ++(other: Iterable[A]) -> Set[A]
    var s: Set[A] = self
    for x in other do s = s.incl(x)
    s

  // This set without any element of `other`; an element of `other` it lacks is ignored: `s -- xs`.
  --(other: Iterable[A]) -> Set[A]
    var s: Set[A] = self
    for x in other do s = s.excl(x)
    s

  // The elements in this set, in `other`, or in both, as a set of this one's kind.
  union(other: Set[A]) -> Set[A] = self ++ other

  // The elements in both this set and `other`.
  intersect(other: Set[A]) -> Set[A] = filter(x -> other.contains(x))

  // The elements in this set and not in `other`.
  diff(other: Set[A]) -> Set[A] = filter(x -> !other.contains(x))

  // Whether every element of this set is in `other`.
  subsetOf(other: Set[A]) -> bool
    if size > other.size then return false
    for x in self
      if !other.contains(x) then return false
    true

  // The elements that satisfy `p`.
  filter(p: (A) -> bool) -> Set[A]
    var s: Set[A] = self
    for x in self
      if !p(x) then s = s.excl(x)
    s

  override erasedSize() -> int = size

  override erasedContains(element: Any) -> bool = element match
    x: A -> contains(x)
    _ -> false

  override erasedIterator() -> Iterator[Any] = ErasedElements(iterator())

// Every set has these, written once here; each builds a hash set of the elements it makes. A type
// with a version of its own, as a tree set's that builds a tree set, keeps it where its type is known.
impl[A] Set[A]
  // The set of `f` of each element; elements that `f` maps alike become one.
  map[B](f: (A) -> B) -> Set[B]
    var t: HashTrie[B, unit] = Empty
    for x in self
      val y = f(x)
      t = trieInsert(t, spreadHash(y.hash()), y, ())
    HashSet(t)

  // The set of `pf` of each element it is defined at; elements that `pf` maps alike become one.
  collect[B](pf: PartialFunction[A, B]) -> Set[B]
    val f = pf.lift()
    var t: HashTrie[B, unit] = Empty
    for x in self
      if f(x) is Some(y) then t = trieInsert(t, spreadHash(y.hash()), y, ())
    HashSet(t)

  // The set of the elements of the collections `f` makes of each element.
  flatMap[B](f: (A) -> Iterable[B]) -> Set[B]
    var t: HashTrie[B, unit] = Empty
    for x in self
      for y in f(x) do t = trieInsert(t, spreadHash(y.hash()), y, ())
    HashSet(t)

  // The set of the values of the options `f` makes of each element, those that hold one.
  flatMap[B](f: (A) -> Option[B]) -> Set[B] = keptSomeInto(self, f, Set.newBuilder[B]())

  // The elements that satisfy `p`, tested only as `map`, `flatMap` or `foreach` reaches each one.
  withFilter(p: (A) -> bool) -> FilteredSet[A] = FilteredSet(self, p)

  // Every subset of this set, each a set of this one's kind, visited lazily: the empty set first,
  // then the subsets of one element, of two, and so on up to the set itself, those of one size in
  // the lexicographic order of their elements' positions in iteration order. A set of `n` elements
  // has `2^n` subsets and none is made before it is asked for.
  subsets() -> Iterator[Set[A]]
    val xs = toVector
    Subsets(xs, filter(x -> false), 0, xs.length)

  // The subsets of exactly `k` elements, `C(n, k)` of them, in the order `subsets()` visits them;
  // none when `k` is negative or greater than the number of elements.
  subsets(k: int) -> Iterator[Set[A]]
    val xs = toVector
    Subsets(xs, filter(x -> false), k, k)

// The subsets of a set's elements, of each size from `low` to `high`, one combination at a time.
private class Subsets[A](
    private val elements: Vector[A],
    private val empty: Set[A],
    private val low: int,
    private val high: int
): Iterator[Set[A]]
  private var size = low
  private var more = 0 <= low <= high <= elements.length
  private var picks: Vector[int] = Vector.tabulate(low, i -> i)

  override hasNext() -> bool = more

  override next() -> Set[A]
    if !more then fail("next of an exhausted iterator")
    var s = empty
    for i in picks do s = s.incl(elements(i))
    advance()
    s

  // Moves to the next combination of this size, or to the first of the next size.
  private advance()
    val n = elements.length
    var i = size - 1
    while i >= 0 && picks(i) == n - size + i do i -= 1
    if i >= 0
      var next = picks.updated(i, picks(i) + 1)
      for j in i + 1 ..< size do next = next.updated(j, next(j - 1) + 1)
      picks = next
    else if size >= high
      more = false
    else
      size += 1
      picks = Vector.tabulate(size, i -> i)

// A set seen without its element type: how two sets held as `Any`, or as sets of different kinds, are
// compared by their elements. Every `Set` is one.
trait ErasedSet
  erasedSize() -> int

  // Whether `element` is of the set's element type and in the set.
  erasedContains(element: Any) -> bool

  erasedIterator() -> Iterator[Any]

private class ErasedElements[A](elements: Iterator[A]): Iterator[Any]
  override hasNext() -> bool = elements.hasNext()
  override next() -> Any = elements.next()

// Two sets of any kinds are equal when they have as many elements and each element of one is in the
// other.
private erasedSetEquals(x: ErasedSet, y: ErasedSet) -> bool
  if x.erasedSize() != y.erasedSize() then return false
  for e in x.erasedIterator()
    if !y.erasedContains(e) then return false
  true

// The set companion builds hash sets: `Set.empty`, `Set(...)` and `Set.newBuilder`, which a set
// literal uses, all answer a `HashSet`, typed as a `Set`.
object Set
  // A set with no elements.
  empty[A]() -> Set[A] = HashSet[A](Empty)

  // A set of the elements given, each equal one once: `Set(1, 2, 3)`.
  apply[A: Eq & Hash](elements: A*) -> Set[A] = elements.toSet

  // A builder of a set: the elements it is given, each held once. It is typed as a `Builder` of
  // sets, so a literal where a `Set[A]` is expected gives the call its `A`, which must be known
  // there to be held to its bounds.
  newBuilder[A]() -> Builder[A, Set[A]] = HashSetBuilder[A]()

// A set seen through a test, which a guard of a `for` with `yield` makes: each element is tested
// just before the call after it would use it, so a guard runs in turn with the rest of the
// comprehension, element by element.
class FilteredSet[A](private val set: Set[A], private val p: (A) -> bool)
  // The set of `f` of each element that passes the test.
  map[B](f: (A) -> B) -> Set[B]
    var t: HashTrie[B, unit] = Empty
    for x in set
      if p(x)
        val y = f(x)
        t = trieInsert(t, spreadHash(y.hash()), y, ())
    HashSet(t)

  // The set of the elements of the collections `f` makes of each element that passes the test.
  flatMap[B](f: (A) -> Iterable[B]) -> Set[B]
    var t: HashTrie[B, unit] = Empty
    for x in set
      if p(x)
        for y in f(x) do t = trieInsert(t, spreadHash(y.hash()), y, ())
    HashSet(t)

  // The set of the values of the options `f` makes of each element that passes the test.
  flatMap[B](f: (A) -> Option[B]) -> Set[B] = keptSomeInto(set, x -> if p(x) then f(x) else None, Set.newBuilder[B]())

  // The elements that pass this test and then `q`.
  withFilter(q: (A) -> bool) -> FilteredSet[A] = FilteredSet(set, x -> p(x) && q(x))

  // Calls `f` with each element that passes the test.
  foreach(f: (A) -> unit)
    for x in set
      if p(x) then f(x)

private class SetElements[A](entries: Iterator[(A, unit)]): Iterator[A]
  override hasNext() -> bool = entries.hasNext()
  override next() -> A = entries.next().0
