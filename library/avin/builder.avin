module avin

// Assembles a collection element by element. `add` takes one element and `addAll` every element of
// an iterable, in order; `result()` hands over the finished collection, after which the builder is
// spent and using it again traps.
trait Builder[-A, +C]
    add(element: A)

    addAll(elements: Iterable[A])
        for element in elements do add(element)

    result() -> C
