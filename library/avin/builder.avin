module avin

// Assembles a collection of type `C` from elements of type `A`, in the order they are given:
// `add(x)` takes one element and `addAll(xs)` every element of `xs`, and `result()` hands over the
// finished collection. The builder is then spent, and adding to it or asking for its result again
// traps. Every collection's companion object makes one, as `Vector.builder[int]()`, and a collection
// literal is built through it.
trait Builder[-A, +C]
    add(element: A)

    addAll(elements: Iterable[A])
        for x in elements do add(x)

    result() -> C
