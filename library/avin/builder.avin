module avin

// Assembles a collection of type `C` from elements of type `A`, in the order they are given:
// `addOne(x)` takes one element and `addAll(xs)` every element of `xs`, and `result()` hands over the
// finished collection. The builder is then spent, and adding to it or asking for its result again
// traps until `clear()` empties it for a new collection. A collection's companion object makes one,
// as `Vector.newBuilder[int]()`, and a sequence literal is built through it.
trait Builder[-A, +C]
    addOne(element: A)

    addAll(elements: Iterable[A])
        for element in elements do addOne(element)

    result() -> C

    // Empties the builder, spent or not, so it builds a new collection from nothing. A collection
    // already handed over by `result()` is not changed.
    clear() -> unit

    // Tells the builder that about `size` elements are coming, so it can make room for them at once.
    // The hint changes no result; a builder may ignore it, as this one does.
    sizeHint(size: int) = ()

    // The number of elements the builder holds when it knows that cheaply, and -1 otherwise, as here.
    knownSize() -> int = -1
