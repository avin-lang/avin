module avin.crypto

// SHA-224 and SHA-384 (FIPS 180-4), HMAC over SHA-1, SHA-224 and SHA-384 (RFC 2104), and HKDF (RFC
// 5869) over SHA-256, SHA-384 and SHA-512, beside the digests at the top of the module.

// SHA-224 of `bytes`, 28 bytes.
@sysl("avin.rt.digest_sha224")
sha224(bytes: Vector[byte]) -> Vector[byte]

// SHA-224 of the UTF-8 bytes of `text`.
sha224(text: string) -> Vector[byte] = sha224(text.bytes)

// SHA-384 of `bytes`, 48 bytes.
@sysl("avin.rt.digest_sha384")
sha384(bytes: Vector[byte]) -> Vector[byte]

// SHA-384 of the UTF-8 bytes of `text`.
sha384(text: string) -> Vector[byte] = sha384(text.bytes)

// HMAC-SHA-1 of `message` under `key`, 20 bytes: what HOTP and TOTP (RFC 4226, RFC 6238) and older
// protocols name. HMAC-SHA-1 remains sound where SHA-1 alone is not, since a collision does not give a
// forgery; a new design takes `hmacSha256`.
@sysl("avin.rt.digest_hmac_sha1")
hmacSha1(key: Vector[byte], message: Vector[byte]) -> Vector[byte]

// HMAC-SHA-1 of the UTF-8 bytes of `message` under the UTF-8 bytes of `key`.
hmacSha1(key: string, message: string) -> Vector[byte] = hmacSha1(key.bytes, message.bytes)

// HMAC-SHA-224 of `message` under `key`, 28 bytes.
@sysl("avin.rt.digest_hmac_sha224")
hmacSha224(key: Vector[byte], message: Vector[byte]) -> Vector[byte]

// HMAC-SHA-224 of the UTF-8 bytes of `message` under the UTF-8 bytes of `key`.
hmacSha224(key: string, message: string) -> Vector[byte] = hmacSha224(key.bytes, message.bytes)

// HMAC-SHA-384 of `message` under `key`, 48 bytes.
@sysl("avin.rt.digest_hmac_sha384")
hmacSha384(key: Vector[byte], message: Vector[byte]) -> Vector[byte]

// HMAC-SHA-384 of the UTF-8 bytes of `message` under the UTF-8 bytes of `key`.
hmacSha384(key: string, message: string) -> Vector[byte] = hmacSha384(key.bytes, message.bytes)

@sysl("sysl.crypto.hkdf256")
private rawHkdf256(
    salt: Vector[byte],
    secret: Vector[byte],
    info: Vector[byte],
    out: Array[byte]
) -> Result[unit, Fault]

@sysl("sysl.crypto.hkdf384")
private rawHkdf384(
    salt: Vector[byte],
    secret: Vector[byte],
    info: Vector[byte],
    out: Array[byte]
) -> Result[unit, Fault]

@sysl("sysl.crypto.hkdf512")
private rawHkdf512(
    salt: Vector[byte],
    secret: Vector[byte],
    info: Vector[byte],
    out: Array[byte]
) -> Result[unit, Fault]

@sysl("sysl.crypto.hkdf256_expand")
private rawHkdfExpand256(prk: Vector[byte], info: Vector[byte], out: Array[byte]) -> Result[unit, Fault]

@sysl("sysl.crypto.hkdf384_expand")
private rawHkdfExpand384(prk: Vector[byte], info: Vector[byte], out: Array[byte]) -> Result[unit, Fault]

@sysl("sysl.crypto.hkdf512_expand")
private rawHkdfExpand512(prk: Vector[byte], info: Vector[byte], out: Array[byte]) -> Result[unit, Fault]

// Traps unless `length` bytes is a length HKDF can make: from one byte up to 255 digests' worth.
private checkHkdfLength(name: string, length: int, digestSize: int)
  if length < 1 then fail(s"$name: length must be at least 1, was $length")
  if length > 255 * digestSize then fail(s"$name: length must be at most ${255 * digestSize}, was $length")

// Traps unless `prk` is at least a digest long, as RFC 5869 asks of a pseudorandom key.
private checkPrk(name: string, prk: Vector[byte], digestSize: int)
  if prk.length < digestSize then fail(
    s"$name: the pseudorandom key must be at least $digestSize bytes, was ${prk.length}"
  )

// What HKDF wrote into `out`, as the key.
private derived(result: Result[unit, Fault], out: Array[byte]) -> Vector[byte] = result match
  Ok(_) -> out.toVector
  Err(_) -> fail("HKDF's length is checked before it runs")

// HKDF (RFC 5869) over HMAC-SHA-256: `length` bytes of key from `secret`, which must already be
// unguessable (a Diffie-Hellman result, a random master key: a password goes to `pbkdf2HmacSha256`),
// with `salt` (empty is the standard's default) and `info`, the label that keeps keys derived from one
// secret apart. A `length` below 1 or over 8160 (255 digests) traps.
//
//     val encryptionKey = hkdfSha256(master, salt, "app v1 encryption".bytes, 32)
hkdfSha256(secret: Vector[byte], salt: Vector[byte], info: Vector[byte], length: int) -> Vector[byte]
  checkHkdfLength("hkdfSha256", length, 32)
  val out = Array.fill(length, byte(0))
  derived(rawHkdf256(salt, secret, info, out), out)

// HKDF over HMAC-SHA-384; a `length` of at most 12240.
hkdfSha384(secret: Vector[byte], salt: Vector[byte], info: Vector[byte], length: int) -> Vector[byte]
  checkHkdfLength("hkdfSha384", length, 48)
  val out = Array.fill(length, byte(0))
  derived(rawHkdf384(salt, secret, info, out), out)

// HKDF over HMAC-SHA-512; a `length` of at most 16320.
hkdfSha512(secret: Vector[byte], salt: Vector[byte], info: Vector[byte], length: int) -> Vector[byte]
  checkHkdfLength("hkdfSha512", length, 64)
  val out = Array.fill(length, byte(0))
  derived(rawHkdf512(salt, secret, info, out), out)

// HKDF-Extract over HMAC-SHA-256: the 32-byte pseudorandom key `secret` and `salt` condense to, which
// is `hmacSha256(salt, secret)`.
hkdfExtractSha256(salt: Vector[byte], secret: Vector[byte]) -> Vector[byte] = hmacSha256(salt, secret)

// HKDF-Extract over HMAC-SHA-384, 48 bytes.
hkdfExtractSha384(salt: Vector[byte], secret: Vector[byte]) -> Vector[byte] = hmacSha384(salt, secret)

// HKDF-Extract over HMAC-SHA-512, 64 bytes.
hkdfExtractSha512(salt: Vector[byte], secret: Vector[byte]) -> Vector[byte] = hmacSha512(salt, secret)

// HKDF-Expand over HMAC-SHA-256 (RFC 5869 § 2.3): `length` bytes from the pseudorandom key `prk` and
// `info`, the step TLS 1.3's key schedule repeats. A `prk` under 32 bytes, or a `length` below 1 or
// over 8160, traps.
hkdfExpandSha256(prk: Vector[byte], info: Vector[byte], length: int) -> Vector[byte]
  checkPrk("hkdfExpandSha256", prk, 32)
  checkHkdfLength("hkdfExpandSha256", length, 32)
  val out = Array.fill(length, byte(0))
  derived(rawHkdfExpand256(prk, info, out), out)

// HKDF-Expand over HMAC-SHA-384; a `prk` of at least 48 bytes and a `length` of at most 12240.
hkdfExpandSha384(prk: Vector[byte], info: Vector[byte], length: int) -> Vector[byte]
  checkPrk("hkdfExpandSha384", prk, 48)
  checkHkdfLength("hkdfExpandSha384", length, 48)
  val out = Array.fill(length, byte(0))
  derived(rawHkdfExpand384(prk, info, out), out)

// HKDF-Expand over HMAC-SHA-512; a `prk` of at least 64 bytes and a `length` of at most 16320.
hkdfExpandSha512(prk: Vector[byte], info: Vector[byte], length: int) -> Vector[byte]
  checkPrk("hkdfExpandSha512", prk, 64)
  checkHkdfLength("hkdfExpandSha512", length, 64)
  val out = Array.fill(length, byte(0))
  derived(rawHkdfExpand512(prk, info, out), out)

@sysl("sysl.crypto.Sha224")
private class RawSha224
  update(bytes: Vector[byte])
  finish(digest: Array[byte]) -> Result[unit, Fault]

@sysl("sysl.crypto.new_sha224")
private newRawSha224() -> RawSha224

@sysl("sysl.crypto.Sha384")
private class RawSha384
  update(bytes: Vector[byte])
  finish(digest: Array[byte]) -> Result[unit, Fault]

@sysl("sysl.crypto.new_sha384")
private newRawSha384() -> RawSha384

@sysl("avin.rt.digest_update_sha224")
private rawUpdate(h: RawSha224, bytes: Vector[byte], from: int, until: int)

@sysl("avin.rt.digest_update_sha224")
private rawUpdate(h: RawSha224, bytes: Array[byte], from: int, until: int)

@sysl("avin.rt.digest_update_sha384")
private rawUpdate(h: RawSha384, bytes: Vector[byte], from: int, until: int)

@sysl("avin.rt.digest_update_sha384")
private rawUpdate(h: RawSha384, bytes: Array[byte], from: int, until: int)

// A SHA-224 hash in progress; it works as `Sha256` does, with a 28-byte digest.
class Sha224()
  private val raw = newRawSha224()
  private var done: Option[Vector[byte]] = None

  update(bytes: Vector[byte])
    if done is Some(_) then fail("Sha224.update: the hasher is finished")
    raw.update(bytes)

  update(text: string) = update(text.bytes)

  update(bytes: Array[byte]) = update(bytes, 0, bytes.length)

  update(bytes: Vector[byte], from: int, until: int)
    if done is Some(_) then fail("Sha224.update: the hasher is finished")
    checkRange("Sha224.update", bytes.length, from, until)
    rawUpdate(raw, bytes, from, until)

  update(bytes: Array[byte], from: int, until: int)
    if done is Some(_) then fail("Sha224.update: the hasher is finished")
    checkRange("Sha224.update", bytes.length, from, until)
    rawUpdate(raw, bytes, from, until)

  finish() -> Vector[byte] = done match
    Some(d) -> d
    None ->
      val out = Array.fill(28, byte(0))
      val d = published(raw.finish(out), out)
      done = Some(d)
      d

// A SHA-384 hash in progress; it works as `Sha256` does, with a 48-byte digest.
class Sha384()
  private val raw = newRawSha384()
  private var done: Option[Vector[byte]] = None

  update(bytes: Vector[byte])
    if done is Some(_) then fail("Sha384.update: the hasher is finished")
    raw.update(bytes)

  update(text: string) = update(text.bytes)

  update(bytes: Array[byte]) = update(bytes, 0, bytes.length)

  update(bytes: Vector[byte], from: int, until: int)
    if done is Some(_) then fail("Sha384.update: the hasher is finished")
    checkRange("Sha384.update", bytes.length, from, until)
    rawUpdate(raw, bytes, from, until)

  update(bytes: Array[byte], from: int, until: int)
    if done is Some(_) then fail("Sha384.update: the hasher is finished")
    checkRange("Sha384.update", bytes.length, from, until)
    rawUpdate(raw, bytes, from, until)

  finish() -> Vector[byte] = done match
    Some(d) -> d
    None ->
      val out = Array.fill(48, byte(0))
      val d = published(raw.finish(out), out)
      done = Some(d)
      d
