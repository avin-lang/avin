module avin.crypto

// Content digests and keyed digests: SHA-256, SHA-512, SHA-1 and MD5, HMAC over the first two, PBKDF2
// key derivation over HMAC-SHA-256 and HMAC-SHA-512,
// comparison of secrets in constant time, and hexadecimal text for any digest. A digest is a
// `Vector[byte]`, the bytes the standard defines, so it can be compared, stored or used as a key;
// `toHex`, which this module offers from `avin.encoding`, writes it as text.
//
//     println(toHex(sha256("abc")))
//
// Text is hashed as its UTF-8 bytes. A hasher takes its input in pieces, so a large file is hashed
// without being held whole: `update` as often as needed, then `finish`.
//
// `sha1` and `md5` are broken for security: people can make two inputs with one digest. They are here
// for formats that already use them (a checksum in a file listing, a cache key nobody attacks), never
// to sign, to authenticate or to name untrusted content. Use `sha256` or `sha512` for those.

export avin.encoding.toHex

// SHA-256 of `bytes`, 32 bytes.
@sysl("avin.rt.digest_sha256")
sha256(bytes: Vector[byte]) -> Vector[byte]

// SHA-256 of the UTF-8 bytes of `text`.
sha256(text: string) -> Vector[byte] = sha256(text.bytes)

// SHA-512 of `bytes`, 64 bytes.
@sysl("avin.rt.digest_sha512")
sha512(bytes: Vector[byte]) -> Vector[byte]

// SHA-512 of the UTF-8 bytes of `text`.
sha512(text: string) -> Vector[byte] = sha512(text.bytes)

// SHA-1 of `bytes`, 20 bytes. Broken for security; see the note at the top of the module.
@sysl("avin.rt.digest_sha1")
sha1(bytes: Vector[byte]) -> Vector[byte]

// SHA-1 of the UTF-8 bytes of `text`. Broken for security.
sha1(text: string) -> Vector[byte] = sha1(text.bytes)

// MD5 of `bytes`, 16 bytes. Broken for security; see the note at the top of the module.
@sysl("avin.rt.digest_md5")
md5(bytes: Vector[byte]) -> Vector[byte]

// MD5 of the UTF-8 bytes of `text`. Broken for security.
md5(text: string) -> Vector[byte] = md5(text.bytes)

// HMAC-SHA-256 of `message` under `key`, 32 bytes. A key of any length, empty included, is allowed.
@sysl("avin.rt.digest_hmac_sha256")
hmacSha256(key: Vector[byte], message: Vector[byte]) -> Vector[byte]

// HMAC-SHA-256 of the UTF-8 bytes of `message` under the UTF-8 bytes of `key`.
hmacSha256(key: string, message: string) -> Vector[byte] = hmacSha256(key.bytes, message.bytes)

// HMAC-SHA-512 of `message` under `key`, 64 bytes.
@sysl("avin.rt.digest_hmac_sha512")
hmacSha512(key: Vector[byte], message: Vector[byte]) -> Vector[byte]

// HMAC-SHA-512 of the UTF-8 bytes of `message` under the UTF-8 bytes of `key`.
hmacSha512(key: string, message: string) -> Vector[byte] = hmacSha512(key.bytes, message.bytes)

@sysl("avin.rt.digest_pbkdf2_sha256")
private rawPbkdf2Sha256(password: Vector[byte], salt: Vector[byte], iterations: int, length: int) -> Vector[byte]

@sysl("avin.rt.digest_pbkdf2_sha512")
private rawPbkdf2Sha512(password: Vector[byte], salt: Vector[byte], iterations: int, length: int) -> Vector[byte]

// Traps unless a derivation of `length` bytes in `iterations` rounds is one PBKDF2 can make: at least
// one round, and from one byte up to 255 digests' worth.
private checkDerivation(name: string, iterations: int, length: int, digestSize: int)
  if iterations < 1 then fail(s"$name: iterations must be at least 1, was $iterations")
  if length < 1 then fail(s"$name: length must be at least 1, was $length")
  if length > 255 * digestSize then fail(s"$name: length must be at most ${255 * digestSize}, was $length")

// PBKDF2 (RFC 8018) over HMAC-SHA-256: `length` bytes of key derived from `password` and `salt` in
// `iterations` rounds. The iteration count is the protocol's to name (SCRAM-SHA-256 sends it), and
// buys the cost of guessing a password, nothing else. A password and a salt of any length, empty
// included, are allowed. `iterations` and `length` below 1, or a `length` over 8160 (255 digests),
// trap.
pbkdf2HmacSha256(password: Vector[byte], salt: Vector[byte], iterations: int, length: int) -> Vector[byte]
  checkDerivation("pbkdf2HmacSha256", iterations, length, 32)
  rawPbkdf2Sha256(password, salt, iterations, length)

// PBKDF2 over HMAC-SHA-256 of the UTF-8 bytes of `password` and `salt`.
pbkdf2HmacSha256(password: string, salt: string, iterations: int, length: int) -> Vector[byte] =
  pbkdf2HmacSha256(password.bytes, salt.bytes, iterations, length)

// PBKDF2 over HMAC-SHA-512; it works as `pbkdf2HmacSha256` does, a `length` of at most 16320 (255
// digests of 64 bytes).
pbkdf2HmacSha512(password: Vector[byte], salt: Vector[byte], iterations: int, length: int) -> Vector[byte]
  checkDerivation("pbkdf2HmacSha512", iterations, length, 64)
  rawPbkdf2Sha512(password, salt, iterations, length)

// PBKDF2 over HMAC-SHA-512 of the UTF-8 bytes of `password` and `salt`.
pbkdf2HmacSha512(password: string, salt: string, iterations: int, length: int) -> Vector[byte] =
  pbkdf2HmacSha512(password.bytes, salt.bytes, iterations, length)

@sysl("sysl.crypto.verify")
private verify(a: Vector[byte], b: Vector[byte]) -> bool

// Whether `a` and `b` are the same bytes, taking as long wherever they first differ: every byte is
// read and the answer is decided once, at the end. Compare a secret someone sent (a MAC tag, a bearer
// token, a password digest) with the one expected this way, never with `==`, which stops at the first
// difference and so tells a patient attacker how much of a guess was right. Different lengths answer
// `false` at once: a length is not the secret.
constantTimeEquals(a: Vector[byte], b: Vector[byte]) -> bool = verify(a, b)

// Whether `a` and `b` are the same text, compared as their UTF-8 bytes in constant time.
constantTimeEquals(a: string, b: string) -> bool = verify(a.bytes, b.bytes)

@sysl("sysl.crypto.Fault")
private data Fault
  NotStarted
  DigestTooSmall
  NoIterations
  TooMuchOutput

@sysl("sysl.crypto.Sha256")
private class RawSha256
  update(bytes: Vector[byte])
  finish(digest: Array[byte]) -> Result[unit, Fault]

@sysl("sysl.crypto.new_sha256")
private newRawSha256() -> RawSha256

@sysl("sysl.crypto.Sha512")
private class RawSha512
  update(bytes: Vector[byte])
  finish(digest: Array[byte]) -> Result[unit, Fault]

@sysl("sysl.crypto.new_sha512")
private newRawSha512() -> RawSha512

@sysl("sysl.crypto.Sha1")
private class RawSha1
  update(bytes: Vector[byte])
  finish(digest: Array[byte]) -> Result[unit, Fault]

@sysl("sysl.crypto.new_sha1")
private newRawSha1() -> RawSha1

@sysl("sysl.crypto.Md5")
private class RawMd5
  update(bytes: Vector[byte])
  finish(digest: Array[byte]) -> Result[unit, Fault]

@sysl("sysl.crypto.new_md5")
private newRawMd5() -> RawMd5

@sysl("avin.rt.digest_update_sha256")
private rawUpdate(h: RawSha256, bytes: Vector[byte], from: int, until: int)

@sysl("avin.rt.digest_update_sha256")
private rawUpdate(h: RawSha256, bytes: Array[byte], from: int, until: int)

@sysl("avin.rt.digest_update_sha512")
private rawUpdate(h: RawSha512, bytes: Vector[byte], from: int, until: int)

@sysl("avin.rt.digest_update_sha512")
private rawUpdate(h: RawSha512, bytes: Array[byte], from: int, until: int)

@sysl("avin.rt.digest_update_sha1")
private rawUpdate(h: RawSha1, bytes: Vector[byte], from: int, until: int)

@sysl("avin.rt.digest_update_sha1")
private rawUpdate(h: RawSha1, bytes: Array[byte], from: int, until: int)

@sysl("avin.rt.digest_update_md5")
private rawUpdate(h: RawMd5, bytes: Vector[byte], from: int, until: int)

@sysl("avin.rt.digest_update_md5")
private rawUpdate(h: RawMd5, bytes: Array[byte], from: int, until: int)

// Traps unless `from ..< until` lies inside `0 ..< length`.
private checkRange(name: string, length: int, from: int, until: int)
  if from < 0 || from > until || until > length then
    fail(s"$name: the range $from ..< $until is not inside 0 ..< $length")

// What a finished hasher's raw state wrote into `out`, as the digest.
private published(result: Result[unit, Fault], out: Array[byte]) -> Vector[byte] = result match
  Ok(_) -> out.toVector
  Err(_) -> fail("a hasher's digest buffer is sized from the hasher itself")

// A SHA-256 hash in progress. `update` adds input in pieces, as many as needed; `finish` gives the
// digest of everything added, and gives the same digest again if asked again. Adding input after
// `finish` traps. A hasher belongs to the thread that made it.
//
//     val h = Sha256()
//     h.update("ab")
//     h.update("c")
//     println(toHex(h.finish()))
class Sha256()
  private val raw = newRawSha256()
  private var done: Option[Vector[byte]] = None

  update(bytes: Vector[byte])
    if done is Some(_) then fail("Sha256.update: the hasher is finished")
    raw.update(bytes)

  update(text: string) = update(text.bytes)

  // Adds the bytes of an array, read in place and not copied. The array may be written after the call
  // returns without changing what was hashed.
  update(bytes: Array[byte]) = update(bytes, 0, bytes.length)

  // Adds `bytes[from ..< until]`. A range outside `0 ..< bytes.length`, or with `from > until`, traps.
  update(bytes: Vector[byte], from: int, until: int)
    if done is Some(_) then fail("Sha256.update: the hasher is finished")
    checkRange("Sha256.update", bytes.length, from, until)
    rawUpdate(raw, bytes, from, until)

  update(bytes: Array[byte], from: int, until: int)
    if done is Some(_) then fail("Sha256.update: the hasher is finished")
    checkRange("Sha256.update", bytes.length, from, until)
    rawUpdate(raw, bytes, from, until)

  finish() -> Vector[byte] = done match
    Some(d) -> d
    None ->
      val out = Array.fill(32, byte(0))
      val d = published(raw.finish(out), out)
      done = Some(d)
      d

// A SHA-512 hash in progress; it works as `Sha256` does, with a 64-byte digest.
class Sha512()
  private val raw = newRawSha512()
  private var done: Option[Vector[byte]] = None

  update(bytes: Vector[byte])
    if done is Some(_) then fail("Sha512.update: the hasher is finished")
    raw.update(bytes)

  update(text: string) = update(text.bytes)

  update(bytes: Array[byte]) = update(bytes, 0, bytes.length)

  update(bytes: Vector[byte], from: int, until: int)
    if done is Some(_) then fail("Sha512.update: the hasher is finished")
    checkRange("Sha512.update", bytes.length, from, until)
    rawUpdate(raw, bytes, from, until)

  update(bytes: Array[byte], from: int, until: int)
    if done is Some(_) then fail("Sha512.update: the hasher is finished")
    checkRange("Sha512.update", bytes.length, from, until)
    rawUpdate(raw, bytes, from, until)

  finish() -> Vector[byte] = done match
    Some(d) -> d
    None ->
      val out = Array.fill(64, byte(0))
      val d = published(raw.finish(out), out)
      done = Some(d)
      d

// A SHA-1 hash in progress, with a 20-byte digest. Broken for security; see the note at the top of the
// module.
class Sha1()
  private val raw = newRawSha1()
  private var done: Option[Vector[byte]] = None

  update(bytes: Vector[byte])
    if done is Some(_) then fail("Sha1.update: the hasher is finished")
    raw.update(bytes)

  update(text: string) = update(text.bytes)

  update(bytes: Array[byte]) = update(bytes, 0, bytes.length)

  update(bytes: Vector[byte], from: int, until: int)
    if done is Some(_) then fail("Sha1.update: the hasher is finished")
    checkRange("Sha1.update", bytes.length, from, until)
    rawUpdate(raw, bytes, from, until)

  update(bytes: Array[byte], from: int, until: int)
    if done is Some(_) then fail("Sha1.update: the hasher is finished")
    checkRange("Sha1.update", bytes.length, from, until)
    rawUpdate(raw, bytes, from, until)

  finish() -> Vector[byte] = done match
    Some(d) -> d
    None ->
      val out = Array.fill(20, byte(0))
      val d = published(raw.finish(out), out)
      done = Some(d)
      d

// An MD5 hash in progress, with a 16-byte digest. Broken for security; see the note at the top of the
// module.
class Md5()
  private val raw = newRawMd5()
  private var done: Option[Vector[byte]] = None

  update(bytes: Vector[byte])
    if done is Some(_) then fail("Md5.update: the hasher is finished")
    raw.update(bytes)

  update(text: string) = update(text.bytes)

  update(bytes: Array[byte]) = update(bytes, 0, bytes.length)

  update(bytes: Vector[byte], from: int, until: int)
    if done is Some(_) then fail("Md5.update: the hasher is finished")
    checkRange("Md5.update", bytes.length, from, until)
    rawUpdate(raw, bytes, from, until)

  update(bytes: Array[byte], from: int, until: int)
    if done is Some(_) then fail("Md5.update: the hasher is finished")
    checkRange("Md5.update", bytes.length, from, until)
    rawUpdate(raw, bytes, from, until)

  finish() -> Vector[byte] = done match
    Some(d) -> d
    None ->
      val out = Array.fill(16, byte(0))
      val d = published(raw.finish(out), out)
      done = Some(d)
      d
