module avin.crypto.password

// Password hashing: Argon2id by default, in the PHC string format every Argon2 implementation reads
// and writes, and bcrypt verification for hashes carried over from another system.
//
//     val stored = hashPassword(password)
//     verifyPassword(attempt, stored) match
//       Ok(true) -> signIn()
//       Ok(false) -> refuse()
//       Err(e) -> report(e)
//
// A password hash is slow and memory-hard on purpose, so that guessing passwords from a stolen table
// costs an attacker as much per guess as it costs the server per login. The defaults are OWASP's
// first recommendation: Argon2id, 19 MiB, two passes, one lane, a 16-byte salt and a 32-byte hash.
// The parameters travel inside the stored string, so raising them later leaves every stored hash
// valid: `needsRehash` says which ones to hash again at the next successful login.
//
// Hashing runs as blocking work: the thread computing a hash is safe for the collector, and the
// scheduler gives the other lightweight threads its worker while it runs.
//
// The C under this module is the Argon2 reference implementation and Openwall's crypt_blowfish,
// carried in `library/sysl/password` and compiled into a program that uses this module only.

import avin.crypto.constantTimeEquals
import avin.encoding.{fromBase64, toBase64}
import avin.random.SecureRandom

// Argon2's three variants (RFC 9106 §3.4). Argon2id is the one to use: it resists side channels in its
// first half-pass and time-memory trade-offs after it.
data Argon2Variant
  // Data-dependent memory access: the fastest to a given strength, and open to cache-timing side
  // channels.
  Argon2d
  // Data-independent memory access: no side channel, weaker against time-memory trade-offs.
  Argon2i
  // Argon2i for the first half of the first pass, Argon2d after it. RFC 9106's recommendation.
  Argon2id

impl Argon2Variant
  // The variant's name in a PHC string: `argon2d`, `argon2i` or `argon2id`.
  name -> string = self match
    Argon2d -> "argon2d"
    Argon2i -> "argon2i"
    Argon2id -> "argon2id"

// The variant's number in the reference implementation.
private variantCode(v: Argon2Variant) -> int = v match
  Argon2d -> 0
  Argon2i -> 1
  Argon2id -> 2

private variantNamed(name: string) -> Option[Argon2Variant]
variantNamed("argon2d") = Some(Argon2d)
variantNamed("argon2i") = Some(Argon2i)
variantNamed("argon2id") = Some(Argon2id)
variantNamed(_) = None

// How costly a hash is to compute, and the lengths of its salt and hash. `memoryKiB` is the memory in
// kibibytes, at least 8 for each lane; `passes` the sweeps over it, at least 1; `lanes` the
// parallelism, 1 to 16777215 (computed on up to 16 threads); `hashLength` at least 4 bytes and
// `saltLength` at least 8. The defaults are OWASP's first recommendation for Argon2id.
data Argon2Params(
    variant: Argon2Variant = Argon2id,
    memoryKiB: int = 19456,
    passes: int = 2,
    lanes: int = 1,
    hashLength: int = 32,
    saltLength: int = 16
)

// The most a verification computes, against a stored hash that asks for more: memory in kibibytes,
// passes, lanes, and the bcrypt cost (the base-two logarithm of its rounds). A hash over a limit is
// refused before anything is computed, so a forged or corrupted string cannot make a login take a
// gigabyte or an hour. The defaults admit every common setting: 1 GiB, 32 passes, 16 lanes, and a
// bcrypt cost of 16.
data PasswordLimits(maxMemoryKiB: int = 1048576, maxPasses: int = 32, maxLanes: int = 16, maxBcryptCost: int = 16)

// Why a stored hash could not be checked. A wrong password is not an error: it is `Ok(false)`.
data PasswordHashError
  // The text is not a hash this module reads; `reason` says what is wrong with it.
  Malformed(reason: string)
  // A scheme or version this module does not compute: `scrypt`, bcrypt's `2x`, Argon2 version 20.
  Unsupported(scheme: string)
  // The hash asks for more than the verification's limits allow: `parameter` is `m`, `t`, `p` or
  // `cost`.
  OverLimit(parameter: string, value: long, limit: long)
  // The computation failed: the memory it needs could not be allocated, or a thread not started.
  Failed(reason: string)

impl Error for PasswordHashError
  // A sentence saying what is wrong, for a message to a person.
  message -> string = self match
    Malformed(reason) -> s"not a password hash: $reason"
    Unsupported(scheme) -> s"unsupported password hash scheme: $scheme"
    OverLimit(parameter, value, limit) -> s"the password hash's $parameter is $value, over the limit of $limit"
    Failed(reason) -> s"the password hash could not be computed: $reason"

// An Argon2 hash with everything needed to check a password against it: the variant, the version
// (19, Argon2 1.3, or 16 for 1.0), the costs, the salt and the hash.
data Argon2Hash(
    variant: Argon2Variant,
    version: int,
    memoryKiB: int,
    passes: int,
    lanes: int,
    salt: Vector[byte],
    hash: Vector[byte]
)

impl Argon2Hash
  // The PHC string: `$argon2id$v=19$m=19456,t=2,p=1$` then the salt and the hash in base64 without
  // padding, separated by `$`.
  encode -> string =
    s"$$${variant.name}$$v=$version$$m=$memoryKiB,t=$passes,p=$lanes$$${unpadded(salt)}$$${unpadded(hash)}"

// Argon2 1.3, the version every current implementation writes.
private val CurrentVersion = 19

// Argon2 1.0, which a hash with no `v=` field is.
private val FirstVersion = 16

// The most lanes Argon2 defines (2^24 - 1).
private val MaxLanes: long = 16777215

// The greatest memory or pass count an `int` holds, and so the greatest a hash here is computed with.
private val MaxCost: long = 2147483647

private val NoBytes = Vector.empty[byte]()

@sysl("avin.password.argon2", blocking)
private rawArgon2(
    variant: int,
    version: int,
    memoryKiB: int,
    passes: int,
    lanes: int,
    password: Vector[byte],
    salt: Vector[byte],
    secret: Vector[byte],
    ad: Vector[byte],
    length: int
) -> Result[Vector[byte], int]

@sysl("avin.password.argon2_error")
private argon2Error(code: int) -> string

@sysl("avin.password.bcrypt", blocking)
private rawBcrypt(password: Vector[byte], setting: Vector[byte]) -> Option[Vector[byte]]

// What is wrong with costs and a hash length Argon2 is asked for, or `None`.
private costProblem(memoryKiB: long, passes: long, lanes: long, hashLength: long) -> Option[string]
  if !(1 <= lanes <= MaxLanes) then return Some(s"lanes must be from 1 to $MaxLanes, was $lanes")
  if memoryKiB < 8 * lanes then return Some(s"memoryKiB must be at least 8 for each lane, ${8 * lanes}, was $memoryKiB")
  if passes < 1 then return Some(s"passes must be at least 1, was $passes")
  if hashLength < 4 then return Some(s"the hash length must be at least 4, was $hashLength")
  None

// What is wrong with a salt of `length` bytes, or `None`.
private saltProblem(length: long) -> Option[string] =
  if length < 8 then Some(s"the salt length must be at least 8, was $length") else None

// Traps unless Argon2 can compute with `params`.
private checkParams(name: string, params: Argon2Params)
  val p = params
  if costProblem(
    long(p.memoryKiB),
    long(p.passes),
    long(p.lanes),
    long(p.hashLength)
  ) is Some(why) then fail(s"$name: $why")
  if saltProblem(long(p.saltLength)) is Some(why) then fail(s"$name: $why")

// Argon2 of checked inputs, or the reference implementation's account of its failure.
private derive(
    variant: Argon2Variant,
    version: int,
    memoryKiB: int,
    passes: int,
    lanes: int,
    password: Vector[byte],
    salt: Vector[byte],
    secret: Vector[byte],
    ad: Vector[byte],
    length: int
) -> Result[Vector[byte], string] =
  rawArgon2(variantCode(variant), version, memoryKiB, passes, lanes, password, salt, secret, ad, length) match
    Ok(hash) -> Ok(hash)
    Err(code) -> Err(argon2Error(code))

// Argon2 (RFC 9106, version 1.3): `params.hashLength` bytes derived from `password` and `salt`, with
// the optional `secret` (a key the server keeps apart from its database) and `associatedData`. Costs
// Argon2 cannot compute, a salt shorter than 8 bytes, or memory that cannot be allocated trap;
// `params.saltLength` is not used, since the salt is given.
argon2(
    password: Vector[byte],
    salt: Vector[byte],
    params: Argon2Params = Argon2Params(),
    secret: Vector[byte] = NoBytes,
    associatedData: Vector[byte] = NoBytes
) -> Vector[byte]
  val p = params
  if costProblem(
    long(p.memoryKiB),
    long(p.passes),
    long(p.lanes),
    long(p.hashLength)
  ) is Some(why) then fail(s"argon2: $why")
  if saltProblem(long(salt.length)) is Some(why) then fail(s"argon2: $why")
  derive(
    p.variant,
    CurrentVersion,
    p.memoryKiB,
    p.passes,
    p.lanes,
    password,
    salt,
    secret,
    associatedData,
    p.hashLength
  ) match
    Ok(hash) -> hash
    Err(why) -> fail(s"argon2: $why")

// The PHC string of `password` hashed with `params` and a new salt from `SecureRandom`, to store and
// later check with `verifyPassword`. A `secret`, where given, must be given to `verifyPassword` too;
// it is not stored in the string. Parameters Argon2 cannot compute with trap, as does memory that
// cannot be allocated.
hashPassword(password: Vector[byte], params: Argon2Params = Argon2Params(), secret: Vector[byte] = NoBytes) -> string
  checkParams("hashPassword", params)
  val p = params
  val salt = SecureRandom.nextBytes(p.saltLength).toVector
  val hash = derive(
    p.variant,
    CurrentVersion,
    p.memoryKiB,
    p.passes,
    p.lanes,
    password,
    salt,
    secret,
    NoBytes,
    p.hashLength
  ) match
    Ok(h) -> h
    Err(why) -> fail(s"hashPassword: $why")
  Argon2Hash(p.variant, CurrentVersion, p.memoryKiB, p.passes, p.lanes, salt, hash).encode

// `hashPassword` of the UTF-8 bytes of `password`.
hashPassword(password: string, params: Argon2Params = Argon2Params(), secret: Vector[byte] = NoBytes) -> string =
  hashPassword(password.bytes, params, secret)

// Whether `password` is the one `encoded` was made from: `Ok(true)` or `Ok(false)`, the hash
// recomputed and compared in constant time. `encoded` is an Argon2 PHC string (`$argon2id$`,
// `$argon2i$`, `$argon2d$`, version 19 or 16) or a bcrypt hash (`$2b$`, `$2a$` or `$2y$`). `Err` is a
// hash that could not be checked: malformed, of another scheme, or over `limits`, which are checked
// before anything is computed. `secret` is the one the hash was made with; bcrypt takes none and
// ignores it. bcrypt reads a password up to its first zero byte, and at most 72 bytes of it.
verifyPassword(
    password: Vector[byte],
    encoded: string,
    secret: Vector[byte] = NoBytes,
    limits: PasswordLimits = PasswordLimits()
) -> Result[bool, PasswordHashError]
  if isBcrypt(encoded) then return verifyBcrypt(password, encoded, limits)
  val h = parseArgon2Hash(encoded)?
  if h.memoryKiB > limits.maxMemoryKiB then return Err(OverLimit("m", long(h.memoryKiB), long(limits.maxMemoryKiB)))
  if h.passes > limits.maxPasses then return Err(OverLimit("t", long(h.passes), long(limits.maxPasses)))
  if h.lanes > limits.maxLanes then return Err(OverLimit("p", long(h.lanes), long(limits.maxLanes)))
  derive(h.variant, h.version, h.memoryKiB, h.passes, h.lanes, password, h.salt, secret, NoBytes, h.hash.length) match
    Ok(got) -> Ok(constantTimeEquals(got, h.hash))
    Err(why) -> Err(Failed(why))

// `verifyPassword` of the UTF-8 bytes of `password`.
verifyPassword(
    password: string,
    encoded: string,
    secret: Vector[byte] = NoBytes,
    limits: PasswordLimits = PasswordLimits()
) -> Result[bool, PasswordHashError] = verifyPassword(password.bytes, encoded, secret, limits)

// Whether `encoded` should be hashed again with `params` at the next successful login: `true` for
// every bcrypt hash, and for an Argon2 hash made with any other variant, version, costs, salt length
// or hash length. `Err` is a hash that is not one `verifyPassword` reads.
needsRehash(encoded: string, params: Argon2Params = Argon2Params()) -> Result[bool, PasswordHashError]
  if isBcrypt(encoded)
    _ = parseBcrypt(encoded)?
    return Ok(true)
  val h = parseArgon2Hash(encoded)?
  val p = params
  Ok(
    h.variant != p.variant
      || h.version != CurrentVersion
      || h.memoryKiB != p.memoryKiB
      || h.passes != p.passes
      || h.lanes != p.lanes
      || h.salt.length != p.saltLength
      || h.hash.length != p.hashLength
  )

// The Argon2 hash a PHC string spells: `$argon2id$v=19$m=<kib>,t=<passes>,p=<lanes>$<salt>$<hash>`, the
// variant `argon2d`, `argon2i` or `argon2id`, `v=` 19 or 16 and 16 where it is left out, each number in
// decimal with no sign and no leading zero, and the salt (at least 8 bytes) and the hash (at least 4)
// in base64 without padding. Anything else is `Err`: `Unsupported` for another scheme or version,
// `Malformed` for the rest.
parseArgon2Hash(encoded: string) -> Result[Argon2Hash, PasswordHashError]
  val parts = encoded.split('$')
  if parts.length < 2 || parts(0) != "" || parts(1) == ""
    return Err(Malformed("a PHC string begins with `$` and the scheme's name"))
  val variant = variantNamed(parts(1)) match
    Some(v) -> v
    None -> return Err(Unsupported(parts(1)))
  val versioned = parts.length > 2 && parts(2).startsWith("v=")
  if parts.length != (if versioned then 6 else 5)
    return Err(Malformed("an Argon2 PHC string has the fields `$variant$v=..$m=..,t=..,p=..$salt$hash`"))
  val version = if versioned then phcNumber(parts(2), "v")? else long(FirstVersion)
  if version != long(CurrentVersion) && version != long(FirstVersion) then return Err(
    Unsupported(s"${parts(1)} version $version")
  )
  val costs = parts(if versioned then 3 else 2).split(',')
  if costs.length != 3 then return Err(Malformed("the costs are `m=..,t=..,p=..`, in that order"))
  val m = phcNumber(costs(0), "m")?
  val t = phcNumber(costs(1), "t")?
  val p = phcNumber(costs(2), "p")?
  if m > MaxCost then return Err(Malformed(s"m is $m, more than this library computes with"))
  if t > MaxCost then return Err(Malformed(s"t is $t, more than this library computes with"))
  val salt = fromUnpadded(parts(parts.length - 2)) match
    Some(s) -> s
    None -> return Err(Malformed("the salt is not base64 without padding"))
  val hash = fromUnpadded(parts(parts.length - 1)) match
    Some(h) -> h
    None -> return Err(Malformed("the hash is not base64 without padding"))
  if costProblem(m, t, p, long(hash.length)) is Some(why) then return Err(Malformed(why))
  if saltProblem(long(salt.length)) is Some(why) then return Err(Malformed(why))
  Ok(Argon2Hash(variant, int(version), int(m), int(t), int(p), salt, hash))

// The number the PHC field `field=<digits>` holds, the field named `name`.
private phcNumber(field: string, name: string) -> Result[long, PasswordHashError]
  if !field.startsWith(s"$name=") then return Err(Malformed(s"expected `$name=` where `$field` is"))
  decimal(field.stripPrefix(s"$name=")) match
    Some(n) -> Ok(n)
    None -> Err(Malformed(s"`$field`: $name is one to ten decimal digits, with no sign and no leading zero"))

// The number `text` is in PHC decimal: one to ten digits, no sign, no leading zero unless it is `0`.
private decimal(text: string) -> Option[long]
  val b = text.bytes
  if !(1 <= b.length <= 10) then return None
  if b.length > 1 && int(b(0)) == int('0') then return None
  var n: long = 0
  for c in b
    if !(int('0') <= int(c) <= int('9')) then return None
    n = n * 10 + long(int(c) - int('0'))
  Some(n)

// `bytes` in base64 with the standard alphabet and no padding, as a PHC string writes them.
private unpadded(bytes: Vector[byte]) -> string = toBase64(bytes).slice(0, (bytes.length * 4 + 2) / 3)

// The bytes base64 with the standard alphabet and no padding spells, or `None`.
private fromUnpadded(text: string) -> Option[Vector[byte]]
  val n = text.byteLength
  if n % 4 == 1 || text.contains("=") then return None
  fromBase64(text + "==".slice(0, (4 - n % 4) % 4)) match
    Ok(bytes) -> Some(bytes)
    Err(_) -> None

// Whether `encoded` names a bcrypt scheme: `$2` and a `$` before any other `$`.
private isBcrypt(encoded: string) -> bool = encoded.startsWith("$2")

// The cost of the bcrypt hash `encoded`: `$2b$`, `$2a$` or `$2y$`, a cost of two digits from 04 to 31,
// `$`, and 53 characters of bcrypt's base64 (22 of salt, 31 of hash). `2x`, the setting that
// reproduces a sign-extension bug, and any other minor version are `Unsupported`.
private parseBcrypt(encoded: string) -> Result[int, PasswordHashError]
  val parts = encoded.split('$')
  if parts.length != 4 then return Err(Malformed("a bcrypt hash is `$2b$<cost>$` and 53 characters"))
  if parts(1) != "2a" && parts(1) != "2b" && parts(1) != "2y" then return Err(Unsupported(parts(1)))
  if encoded.byteLength != 60 then return Err(
    Malformed(s"a bcrypt hash is 60 characters, this is ${encoded.byteLength}")
  )
  val digits = parts(2).bytes
  if digits.length != 2 || !digits.forall(d -> int('0') <= int(d) <= int('9'))
    return Err(Malformed("the bcrypt cost is two decimal digits"))
  val cost = (int(digits(0)) - int('0')) * 10 + int(digits(1)) - int('0')
  if !(4 <= cost <= 31) then return Err(Malformed(s"the bcrypt cost is from 04 to 31, was ${parts(2)}"))
  if !parts(3).bytes.forall(isBcryptDigit) then return Err(
    Malformed("the salt and hash are bcrypt's base64: `./A-Za-z0-9`")
  )
  Ok(cost)

private isBcryptDigit(b: byte) -> bool
  val c = int(b)
  c == int('.') || c == int('/') || int('A') <= c <= int('Z') || int('a') <= c <= int('z') || int('0') <= c <= int('9')

// bcrypt's verdict on `password` against `encoded`, its 31 characters of hash compared in constant time.
private verifyBcrypt(password: Vector[byte], encoded: string, limits: PasswordLimits) -> Result[bool, PasswordHashError]
  val cost = parseBcrypt(encoded)?
  if cost > limits.maxBcryptCost then return Err(OverLimit("cost", long(cost), long(limits.maxBcryptCost)))
  rawBcrypt(password, encoded.bytes) match
    Some(made) -> Ok(constantTimeEquals(made.drop(29), encoded.bytes.drop(29)))
    None -> Err(Malformed("bcrypt does not read this setting"))
