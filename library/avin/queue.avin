module avin

// An immutable first-in, first-out sequence: `enqueue` puts an element after the others, `dequeue`
// takes the first one off, and both leave the queue they were called on as it was. `Queue(1, 2, 3)`
// is a queue with 1 at its front; `Queue.empty[int]()` is an empty one.
//
// The elements are held in two lists: the front, in order, and the back, in reverse order, so an
// enqueue is a cons on the back and a dequeue takes the head of the front. When the front runs out,
// the back is turned around into the new front, once, so enqueue and dequeue take amortized constant
// time and `front()` and `isEmpty()` take constant time. The front is never empty while the back
// is not, which is what keeps `front()` constant. Indexing with `q(i)` takes time proportional to
// `i`, as a list's does.
//
// A queue is a sequence, front first: it compares equal to any sequence of equal elements, hashes
// like one, and displays as `[1, 2, 3]`. It is covariant: a `Queue[Dog]` is a `Queue[Animal]`, and
// enqueueing a cat to it makes a `Queue[Animal]`.
abstract class Queue[+T]: Seq[T]
    // A queue with `element` after the others.
    enqueue[W >: T](element: W) -> Queue[W]

    // A queue with every element of `elements` after the others, in their order.
    enqueueAll[W >: T](elements: Iterable[W]) -> Queue[W]

    // The first element and the queue of the rest; traps when the queue is empty.
    dequeue() -> (T, Queue[T])

    // The first element and the queue of the rest, or `None` when the queue is empty.
    dequeueOption() -> Option[(T, Queue[T])]

    // The first element, which traps when the queue is empty.
    front() -> T

    // The first element, or `None` when the queue is empty.
    frontOption() -> Option[T]

    // A queue of `f` of each element, in order.
    map[U](f: (T) -> U) -> Queue[U]

    // A queue of the elements that satisfy `p`, in order.
    filter(p: (T) -> bool) -> Queue[T]

    // A queue of the elements that do not satisfy `p`, in order.
    filterNot(p: (T) -> bool) -> Queue[T]

    // A queue of the elements of the collections `f` makes of each element, joined in order.
    flatMap[U](f: (T) -> Iterable[U]) -> Queue[U]

    // The queue itself.
    toQueue() -> Queue[T] = self

// The queue with the elements `front` followed by those of `back` read from its last to its first,
// `count` of them in all.
private class QueueNode[+T](private val frontList: List[T], private val backList: List[T], private val count: int): Queue[T]
    override length() -> int = count

    override apply(index: int) -> T
        if index < 0 || index >= count then fail("index out of range")
        var i = index
        var xs = frontList
        loop
            xs match
                x :: more ->
                    if i == 0 then return x
                    i -= 1
                    xs = more
                [] ->
                    break
        // The element is in the back, which is in reverse: `i` places on from the front's end.
        backList.reverse().apply(i)

    override iterator() -> Iterator[T] =
        if backList.isEmpty() then frontList.iterator() else QueueIterator(frontList, backList.reverse())

    override isEmpty() -> bool = count == 0

    override enqueue[W >: T](element: W) -> Queue[W] = frontList match
        [] -> QueueNode[W](element :: Nil, Nil, 1)
        _ -> QueueNode[W](frontList, element :: backList, count + 1)

    override enqueueAll[W >: T](elements: Iterable[W]) -> Queue[W]
        var front: List[W] = frontList
        var back: List[W] = backList
        var n = count
        for x in elements
            if front.isEmpty() then front = x :: Nil else back = x :: back
            n += 1
        QueueNode(front, back, n)

    override dequeue() -> (T, Queue[T]) = frontList match
        x :: more -> (x, queueOf(more, backList, count - 1))
        [] -> fail("dequeue from an empty queue")

    override dequeueOption() -> Option[(T, Queue[T])] = frontList match
        x :: more -> Some((x, queueOf(more, backList, count - 1)))
        [] -> None

    override front() -> T = frontList match
        x :: _ -> x
        [] -> fail("front of an empty queue")

    override frontOption() -> Option[T] = frontList match
        x :: _ -> Some(x)
        [] -> None

    override map[U](f: (T) -> U) -> Queue[U]
        val b = Queue.newBuilder[U]()
        for x in self do b.addOne(f(x))
        b.result()

    override filter(p: (T) -> bool) -> Queue[T]
        val b = Queue.newBuilder[T]()
        for x in self
            if p(x) then b.addOne(x)
        b.result()

    override filterNot(p: (T) -> bool) -> Queue[T] = filter(x -> !p(x))

    override flatMap[U](f: (T) -> Iterable[U]) -> Queue[U]
        val b = Queue.newBuilder[U]()
        for x in self do b.addAll(f(x))
        b.result()

// The queue of `front` then `back` reversed, turning the back around when the front is empty.
private queueOf[T](front: List[T], back: List[T], count: int) -> Queue[T] = front match
    [] -> QueueNode(back.reverse(), Nil, count)
    _ -> QueueNode(front, back, count)

// A queue of displayable elements displays as `[1, 2, 3]`, front first. A field width pads the
// whole.
impl[T: Display] Display for Queue[T]
    display(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            display(text, FormatSpec())
            out.writeField(text.text(), spec)
            return
        out.write("[")
        var first = true
        for x in self
            if !first then out.write(", ")
            first = false
            x.display(out, FormatSpec())
        out.write("]")

// A queue's diagnostic form is its elements' diagnostic forms in brackets: `["a", "b"]`.
impl[T: Debug] Debug for Queue[T]
    debug(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            debug(text, FormatSpec())
            out.writeField(text.text(), spec)
            return
        out.write("[")
        var first = true
        for x in self
            if !first then out.write(", ")
            first = false
            x.debug(out, FormatSpec())
        out.write("]")

// A queue of sendable elements may be handed to another thread: nothing writes to a queue once it
// is made.
impl[T: Sendable] Sendable for Queue[T]

object Queue
    // A queue with no elements.
    empty[T]() -> Queue[T] = QueueNode(Nil, Nil, 0)

    // A queue of the elements given, the first at the front: `Queue(1, 2, 3)`.
    apply[T](elements: T*) -> Queue[T]
        val b = QueueBuilder[T]()
        for x in elements do b.addOne(x)
        b.result()

    // A builder of a queue: the elements it is given, the first at the front.
    newBuilder[T]() -> QueueBuilder[T] = QueueBuilder()

// Builds a queue from the elements given to it.
class QueueBuilder[T]: Builder[T, Queue[T]]
    private var reversed: List[T] = Nil
    private var count = 0
    private var spent = false

    override addOne(element: T)
        if spent then fail("add to a builder whose result was taken")
        reversed = element :: reversed
        count += 1

    override result() -> Queue[T]
        if spent then fail("result of a builder whose result was taken")
        spent = true
        QueueNode(reversed.reverse(), Nil, count)

    override clear()
        reversed = Nil
        count = 0
        spent = false

    override knownSize() -> int = count

// Steps through the front, then through the back turned around.
private class QueueIterator[T](private var frontRest: List[T], private val backOrdered: List[T]): Iterator[T]
    private var backRest: List[T] = backOrdered

    override hasNext() -> bool = frontRest.nonEmpty() || backRest.nonEmpty()

    override next() -> T = frontRest match
        x :: more ->
            frontRest = more
            x
        [] -> backRest match
            x :: more ->
                backRest = more
                x
            [] -> fail("next on an exhausted iterator")
