module avin

// A map kept in the order of its keys: iteration visits the entries in ascending order of their keys,
// and it has the ordered operations, the first and last entries, the nearest entry to a key, and the
// entries from, to, until or between keys. `TreeMap` is the sorted map. An update through `SortedMap`
// answers a `SortedMap`, so `sorted.updated(k, v).headOption` stays sorted.
trait SortedMap[K, +V]: Map[K, V]
    override updated[W >: V](key: K, value: W) -> SortedMap[K, W]

    override removed(key: K) -> SortedMap[K, V]

    // The set of the keys, in the same order.
    override keySet -> SortedSet[K]

    override transform[W](f: (K, V) -> W) -> SortedMap[K, W]

    override ++[W >: V](other: Iterable[(K, W)]) -> SortedMap[K, W]
        var m: SortedMap[K, W] = self
        for (k, v) in other do m = m.updated(k, v)
        m

    override --(keys: Iterable[K]) -> SortedMap[K, V]
        var m: SortedMap[K, V] = self
        for k in keys do m = m.removed(k)
        m

    override updatedWith[W >: V](key: K, f: (Option[V]) -> Option[W]) -> SortedMap[K, W] = f(get(key)) match
        Some(v) -> updated(key, v)
        None -> removed(key)

    override filterKeys(p: (K) -> bool) -> SortedMap[K, V]
        var m: SortedMap[K, V] = self
        for k in keysIterator()
            if !p(k) then m = m.removed(k)
        m

    override partition(p: (K, V) -> bool) -> (SortedMap[K, V], SortedMap[K, V])
        var yes: SortedMap[K, V] = self
        var no: SortedMap[K, V] = self
        for (k, v) in iterator()
            if p(k, v) then no = no.removed(k) else yes = yes.removed(k)
        (yes, no)

    override filter(p: (K, V) -> bool) -> SortedMap[K, V]
        var m: SortedMap[K, V] = self
        for (k, v) in iterator()
            if !p(k, v) then m = m.removed(k)
        m

    override mapValues[W](f: (V) -> W) -> SortedMap[K, W] = transform((k, v) -> f(v))

    // The entries in descending order of their keys, visited one at a time.
    reverseIterator() -> Iterator[(K, V)]

    // The entries whose keys are at least `start`, in ascending order of their keys.
    iteratorFrom(start: K) -> Iterator[(K, V)] = rangeFrom(start).iterator()

    // The keys at least `start`, in ascending order.
    keysIteratorFrom(start: K) -> Iterator[K] = rangeFrom(start).keysIterator()

    // The values of the keys at least `start`, in ascending order of their keys.
    valuesIteratorFrom(start: K) -> Iterator[V] = rangeFrom(start).valuesIterator()

    // The entry with the least key, or `None` when the map is empty.
    override headOption -> Option[(K, V)]
        val it = iterator()
        if it.hasNext() then Some(it.next()) else None

    // The entry with the greatest key, or `None` when the map is empty.
    override lastOption -> Option[(K, V)]
        val it = reverseIterator()
        if it.hasNext() then Some(it.next()) else None

    // The entry with the least key; traps when the map is empty.
    override head -> (K, V) = headOption match
        Some(e) -> e
        None -> fail("head of an empty map")

    // The entry with the greatest key; traps when the map is empty.
    override last -> (K, V) = lastOption match
        Some(e) -> e
        None -> fail("last of an empty map")

    // The least key; traps when the map is empty.
    firstKey() -> K = head.0

    // The greatest key; traps when the map is empty.
    lastKey() -> K = last.0

    // The entry with the least key at least `key`, or `None` when every key is less.
    minAfter(key: K) -> Option[(K, V)]

    // The entry with the greatest key less than `key`, or `None` when no key is less.
    maxBefore(key: K) -> Option[(K, V)]

    // The entries whose keys are at least `low`.
    rangeFrom(low: K) -> SortedMap[K, V]

    // The entries whose keys are at most `high`.
    rangeTo(high: K) -> SortedMap[K, V]

    // The entries whose keys are less than `high`.
    rangeUntil(high: K) -> SortedMap[K, V]

    // The entries whose keys are at least `low` and less than `high`; none when `high` is not greater
    // than `low`.
    range(low: K, high: K) -> SortedMap[K, V]

// The sorted map companion builds tree maps, typed as sorted maps, as a map literal does where a
// `SortedMap` is expected.
object SortedMap
    // A sorted map with no entries.
    empty[K: Ord, V]() -> SortedMap[K, V] = TreeMap[K, V](Tip)

    // A sorted map of the pairs given, a later pair's value replacing an earlier one's for the same
    // key.
    apply[K: Ord, V](pairs: (K, V)*) -> SortedMap[K, V]
        var t: SortedTree[K, V] = Tip
        for (k, v) in pairs do t = treeInsert(t, k, v)
        TreeMap(t)

    // A builder of a sorted map: the pairs it is given, a later pair's value replacing an earlier
    // one's for the same key.
    newBuilder[K: Ord, V]() -> Builder[(K, V), SortedMap[K, V]] = TreeMapBuilder[K, V]()
