module avin

// A function defined for some values of its parameter type and not for others: `isDefinedAt` says
// which, and calling it with any other value traps. A `match` with nothing before it, written where a
// `PartialFunction` is expected, makes one whose arms need not cover every value:
//
//     val half: PartialFunction[int, int] = match n if n % 2 == 0 -> n / 2
trait PartialFunction[-A, +B]
    // Whether the function is defined at `a`.
    isDefinedAt(a: A) -> bool

    // The function made total: `Some` of its value where it is defined, `None` elsewhere.
    lift() -> (A) -> Option[B]

    // The value at `a`, which traps when the function is not defined there.
    apply(a: A) -> B = lift()(a) match
        Some(b) -> b
        None -> fail("the partial function is not defined at this value")

// The methods an `impl` adds to a trait are not variance positions, so `A` and `B` may appear where
// the trait's own methods could not have them.
impl[A, B] PartialFunction[A, B]
    // The value at `a`, or `default(a)` where the function is not defined. The function is tried once:
    // for a `match`, each pattern and guard is tested once.
    applyOrElse(a: A, default: (A) -> B) -> B = lift()(a) match
        Some(b) -> b
        None -> default(a)

    // This function where it is defined, and `other` where this one is not.
    orElse(other: PartialFunction[A, B]) -> PartialFunction[A, B] = OrElsePartialFunction(self, other)

// The partial function a `match` with nothing before it makes. `defined` tests the arms' patterns and
// guards, and `attempt` also runs the body of the arm that matches, yielding `None` when none does.
class MatchPartialFunction[A, B](private val defined: (A) -> bool, private val attempt: (A) -> Option[B]): PartialFunction[A, B]
    override isDefinedAt(a: A) -> bool = defined(a)

    override lift() -> (A) -> Option[B] = attempt

// `first.orElse(second)`.
class OrElsePartialFunction[A, B](private val first: PartialFunction[A, B], private val second: PartialFunction[A, B]): PartialFunction[A, B]
    override isDefinedAt(a: A) -> bool = first.isDefinedAt(a) || second.isDefinedAt(a)

    override lift() -> (A) -> Option[B]
        val f = first.lift()
        val g = second.lift()
        a -> f(a).orElse(g(a))
