module avin

// The shapes of a vector. A vector's elements are in leaves, arrays of at most 32 elements, and a
// node above them is an array of at most 32 nodes of the level below, so an index takes 5 bits per
// level. A vector of depth `d` keeps, in order: a prefix at each level from 1 to `d - 1`, a middle
// at level `d`, and a suffix at each level from `d - 1` down to 1.
//
// - The prefix and the suffix at level 1 are leaves of 1 to 32 elements: neither is ever empty.
// - The prefix or suffix at a level `k` from 2 up holds 0 to 31 nodes of level `k - 1`, each full:
//   32 elements at level 2, 32 * 32 at level 3, and so on.
// - The middle holds full nodes of level `d - 1`: at most 31 below depth 6, and at depth 6 as many
//   as an `int` length allows, which is fewer than 64.
//
// Every array is exactly as long as what it holds, and nothing writes to one once it is made, so
// versions of a vector share every array they have in common. The prefix may have any length, and
// everything after it is aligned, so an index past the prefix splits into 5-bit digits that pick
// the node at each level directly: the middle when its digit is below the middle's length, and
// otherwise the suffix at the highest level whose digit is below that suffix's length. Each depth is
// a class of its own, so reading an element tests no depth and walks no loop.
//
// Depth 6 is the deepest: 6 levels of 5 bits, with a middle of up to 64 nodes, reach 2^31 elements,
// more than an `int` length can count.

// The vector with no elements.
private class Vector0[+T](): Vector[T]
    override length() -> int = 0

    override apply(index: int) -> T = fail("index out of range")

// A vector of 1 to 32 elements, all in one leaf.
private class Vector1[+T](val data1: FrozenArray[T]): Vector[T]
    override length() -> int = data1.length()

    override apply(index: int) -> T = data1(index)

    // The leaf that holds the element at `index`.
    leafAt(index: int) -> FrozenArray[T] = data1

// A vector of depth 2: a prefix leaf, full leaves in the middle, and a suffix leaf. `len1` is the
// prefix's length.
private class Vector2[+T](val prefix1: FrozenArray[T], val len1: int, val data2: FrozenArray[FrozenArray[T]],
                          val suffix1: FrozenArray[T], val size: int): Vector[T]
    override length() -> int = size

    override apply(index: int) -> T
        if index >= size then fail("index out of range")
        if index < len1 then return prefix1(index)
        val io = index - len1
        val i2 = io >> 5
        if i2 < data2.length() then data2(i2)(io & 31) else suffix1(io & 31)

    leafAt(index: int) -> FrozenArray[T]
        if index < len1 then return prefix1
        val i2 = (index - len1) >> 5
        if i2 < data2.length() then data2(i2) else suffix1

// A vector of depth 3. `len1` and `len12` are the lengths of the prefixes at level 1 and at levels
// 1 and 2 together.
private class Vector3[+T](val prefix1: FrozenArray[T], val len1: int,
                          val prefix2: FrozenArray[FrozenArray[T]], val len12: int,
                          val data3: FrozenArray[FrozenArray[FrozenArray[T]]],
                          val suffix2: FrozenArray[FrozenArray[T]], val suffix1: FrozenArray[T],
                          val size: int): Vector[T]
    override length() -> int = size

    override apply(index: int) -> T
        if index >= size then fail("index out of range")
        if index < len12
            if index < len1 then return prefix1(index)
            val io = index - len1
            return prefix2(io >> 5)(io & 31)
        val io = index - len12
        val i3 = io >> 10
        val i2 = (io >> 5) & 31
        val i1 = io & 31
        if i3 < data3.length() then data3(i3)(i2)(i1)
        elif i2 < suffix2.length() then suffix2(i2)(i1)
        else suffix1(i1)

    leafAt(index: int) -> FrozenArray[T]
        if index < len12
            if index < len1 then return prefix1
            return prefix2((index - len1) >> 5)
        val io = index - len12
        val i3 = io >> 10
        val i2 = (io >> 5) & 31
        if i3 < data3.length() then data3(i3)(i2)
        elif i2 < suffix2.length() then suffix2(i2)
        else suffix1

// A vector of depth 4.
private class Vector4[+T](val prefix1: FrozenArray[T], val len1: int,
                          val prefix2: FrozenArray[FrozenArray[T]], val len12: int,
                          val prefix3: FrozenArray[FrozenArray[FrozenArray[T]]], val len123: int,
                          val data4: FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]],
                          val suffix3: FrozenArray[FrozenArray[FrozenArray[T]]],
                          val suffix2: FrozenArray[FrozenArray[T]], val suffix1: FrozenArray[T],
                          val size: int): Vector[T]
    override length() -> int = size

    override apply(index: int) -> T
        if index >= size then fail("index out of range")
        if index < len123
            if index < len12
                if index < len1 then return prefix1(index)
                val io = index - len1
                return prefix2(io >> 5)(io & 31)
            val io = index - len12
            return prefix3(io >> 10)((io >> 5) & 31)(io & 31)
        val io = index - len123
        val i4 = io >> 15
        val i3 = (io >> 10) & 31
        val i2 = (io >> 5) & 31
        val i1 = io & 31
        if i4 < data4.length() then data4(i4)(i3)(i2)(i1)
        elif i3 < suffix3.length() then suffix3(i3)(i2)(i1)
        elif i2 < suffix2.length() then suffix2(i2)(i1)
        else suffix1(i1)

    leafAt(index: int) -> FrozenArray[T]
        if index < len123
            if index < len12
                if index < len1 then return prefix1
                return prefix2((index - len1) >> 5)
            val io = index - len12
            return prefix3(io >> 10)((io >> 5) & 31)
        val io = index - len123
        val i4 = io >> 15
        val i3 = (io >> 10) & 31
        val i2 = (io >> 5) & 31
        if i4 < data4.length() then data4(i4)(i3)(i2)
        elif i3 < suffix3.length() then suffix3(i3)(i2)
        elif i2 < suffix2.length() then suffix2(i2)
        else suffix1

// A vector of depth 5.
private class Vector5[+T](val prefix1: FrozenArray[T], val len1: int,
                          val prefix2: FrozenArray[FrozenArray[T]], val len12: int,
                          val prefix3: FrozenArray[FrozenArray[FrozenArray[T]]], val len123: int,
                          val prefix4: FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]], val len1234: int,
                          val data5: FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]],
                          val suffix4: FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]],
                          val suffix3: FrozenArray[FrozenArray[FrozenArray[T]]],
                          val suffix2: FrozenArray[FrozenArray[T]], val suffix1: FrozenArray[T],
                          val size: int): Vector[T]
    override length() -> int = size

    override apply(index: int) -> T
        if index >= size then fail("index out of range")
        if index < len1234
            if index < len123
                if index < len12
                    if index < len1 then return prefix1(index)
                    val io = index - len1
                    return prefix2(io >> 5)(io & 31)
                val io = index - len12
                return prefix3(io >> 10)((io >> 5) & 31)(io & 31)
            val io = index - len123
            return prefix4(io >> 15)((io >> 10) & 31)((io >> 5) & 31)(io & 31)
        val io = index - len1234
        val i5 = io >> 20
        val i4 = (io >> 15) & 31
        val i3 = (io >> 10) & 31
        val i2 = (io >> 5) & 31
        val i1 = io & 31
        if i5 < data5.length() then data5(i5)(i4)(i3)(i2)(i1)
        elif i4 < suffix4.length() then suffix4(i4)(i3)(i2)(i1)
        elif i3 < suffix3.length() then suffix3(i3)(i2)(i1)
        elif i2 < suffix2.length() then suffix2(i2)(i1)
        else suffix1(i1)

    leafAt(index: int) -> FrozenArray[T]
        if index < len1234
            if index < len123
                if index < len12
                    if index < len1 then return prefix1
                    return prefix2((index - len1) >> 5)
                val io = index - len12
                return prefix3(io >> 10)((io >> 5) & 31)
            val io = index - len123
            return prefix4(io >> 15)((io >> 10) & 31)((io >> 5) & 31)
        val io = index - len1234
        val i5 = io >> 20
        val i4 = (io >> 15) & 31
        val i3 = (io >> 10) & 31
        val i2 = (io >> 5) & 31
        if i5 < data5.length() then data5(i5)(i4)(i3)(i2)
        elif i4 < suffix4.length() then suffix4(i4)(i3)(i2)
        elif i3 < suffix3.length() then suffix3(i3)(i2)
        elif i2 < suffix2.length() then suffix2(i2)
        else suffix1

// A vector of depth 6, the deepest.
private class Vector6[+T](val prefix1: FrozenArray[T], val len1: int,
                          val prefix2: FrozenArray[FrozenArray[T]], val len12: int,
                          val prefix3: FrozenArray[FrozenArray[FrozenArray[T]]], val len123: int,
                          val prefix4: FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]], val len1234: int,
                          val prefix5: FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]], val len12345: int,
                          val data6: FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]]],
                          val suffix5: FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]],
                          val suffix4: FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]],
                          val suffix3: FrozenArray[FrozenArray[FrozenArray[T]]],
                          val suffix2: FrozenArray[FrozenArray[T]], val suffix1: FrozenArray[T],
                          val size: int): Vector[T]
    override length() -> int = size

    override apply(index: int) -> T
        if index >= size then fail("index out of range")
        if index < len12345
            if index < len1234
                if index < len123
                    if index < len12
                        if index < len1 then return prefix1(index)
                        val io = index - len1
                        return prefix2(io >> 5)(io & 31)
                    val io = index - len12
                    return prefix3(io >> 10)((io >> 5) & 31)(io & 31)
                val io = index - len123
                return prefix4(io >> 15)((io >> 10) & 31)((io >> 5) & 31)(io & 31)
            val io = index - len1234
            return prefix5(io >> 20)((io >> 15) & 31)((io >> 10) & 31)((io >> 5) & 31)(io & 31)
        val io = index - len12345
        val i6 = io >> 25
        val i5 = (io >> 20) & 31
        val i4 = (io >> 15) & 31
        val i3 = (io >> 10) & 31
        val i2 = (io >> 5) & 31
        val i1 = io & 31
        if i6 < data6.length() then data6(i6)(i5)(i4)(i3)(i2)(i1)
        elif i5 < suffix5.length() then suffix5(i5)(i4)(i3)(i2)(i1)
        elif i4 < suffix4.length() then suffix4(i4)(i3)(i2)(i1)
        elif i3 < suffix3.length() then suffix3(i3)(i2)(i1)
        elif i2 < suffix2.length() then suffix2(i2)(i1)
        else suffix1(i1)

    leafAt(index: int) -> FrozenArray[T]
        if index < len12345
            if index < len1234
                if index < len123
                    if index < len12
                        if index < len1 then return prefix1
                        return prefix2((index - len1) >> 5)
                    val io = index - len12
                    return prefix3(io >> 10)((io >> 5) & 31)
                val io = index - len123
                return prefix4(io >> 15)((io >> 10) & 31)((io >> 5) & 31)
            val io = index - len1234
            return prefix5(io >> 20)((io >> 15) & 31)((io >> 10) & 31)((io >> 5) & 31)
        val io = index - len12345
        val i6 = io >> 25
        val i5 = (io >> 20) & 31
        val i4 = (io >> 15) & 31
        val i3 = (io >> 10) & 31
        val i2 = (io >> 5) & 31
        if i6 < data6.length() then data6(i6)(i5)(i4)(i3)(i2)
        elif i5 < suffix5.length() then suffix5(i5)(i4)(i3)(i2)
        elif i4 < suffix4.length() then suffix4(i4)(i3)(i2)
        elif i3 < suffix3.length() then suffix3(i3)(i2)
        elif i2 < suffix2.length() then suffix2(i2)
        else suffix1

// Adding an element at either end writes into the leaf at that end, copying at most 32 elements. A
// full leaf moves into the level above, which moves a full node up in turn, and a full middle
// becomes the prefix or suffix of a vector one level deeper. Replacing an element copies the arrays
// on the path to it.

impl[T] Vector1[T]
    appended(x: T) -> Vector[T]
        if data1.length() < 32 then Vector1(appendedArray(data1, x)) else Vector2(data1, 32, emptyArray(), single(x), 33)

    prepended(x: T) -> Vector[T]
        if data1.length() < 32 then Vector1(prependedArray(data1, x)) else Vector2(single(x), 1, emptyArray(), data1, 33)

    updatedAt(index: int, x: T) -> Vector[T] = Vector1(replacedArray(data1, index, x))

    feed(s: VectorSlicer[T], lo: int, hi: int) = s.piece1(data1, 0, lo, hi)

impl[T] Vector2[T]
    appended(x: T) -> Vector[T]
        val n = size + 1
        if suffix1.length() < 32 then return Vector2(prefix1, len1, data2, appendedArray(suffix1, x), n)
        if data2.length() < 31 then return Vector2(prefix1, len1, appendedArray(data2, suffix1), single(x), n)
        Vector3(prefix1, len1, data2, len1 + (data2.length() << 5), emptyArray(), single(suffix1), single(x), n)

    prepended(x: T) -> Vector[T]
        val n = size + 1
        if prefix1.length() < 32 then return Vector2(prependedArray(prefix1, x), len1 + 1, data2, suffix1, n)
        if data2.length() < 31 then return Vector2(single(x), 1, prependedArray(data2, prefix1), suffix1, n)
        Vector3(single(x), 1, single(prefix1), 33, emptyArray(), data2, suffix1, n)

    updatedAt(index: int, x: T) -> Vector[T]
        if index < len1 then return Vector2(replacedArray(prefix1, index, x), len1, data2, suffix1, size)
        val io = index - len1
        if (io >> 5) < data2.length() then return Vector2(prefix1, len1, replaced2(data2, io, x), suffix1, size)
        Vector2(prefix1, len1, data2, replacedArray(suffix1, io & 31, x), size)

    feed(s: VectorSlicer[T], lo: int, hi: int)
        s.piece1(prefix1, 0, lo, hi)
        s.piece2(data2, len1, lo, hi)
        s.piece1(suffix1, len1 + (data2.length() << 5), lo, hi)

impl[T] Vector3[T]
    appended(x: T) -> Vector[T]
        val n = size + 1
        if suffix1.length() < 32 then return Vector3(prefix1, len1, prefix2, len12, data3, suffix2, appendedArray(suffix1, x), n)
        if suffix2.length() < 31 then return Vector3(prefix1, len1, prefix2, len12, data3, appendedArray(suffix2, suffix1), single(x), n)
        val full2 = appendedArray(suffix2, suffix1)
        if data3.length() < 31 then return Vector3(prefix1, len1, prefix2, len12, appendedArray(data3, full2), emptyArray(), single(x), n)
        Vector4(prefix1, len1, prefix2, len12, data3, len12 + (data3.length() << 10), emptyArray(), single(full2),
                emptyArray(), single(x), n)

    prepended(x: T) -> Vector[T]
        val n = size + 1
        if prefix1.length() < 32 then return Vector3(prependedArray(prefix1, x), len1 + 1, prefix2, len12 + 1, data3, suffix2, suffix1, n)
        if prefix2.length() < 31 then return Vector3(single(x), 1, prependedArray(prefix2, prefix1), len12 + 1, data3, suffix2, suffix1, n)
        val full2 = prependedArray(prefix2, prefix1)
        if data3.length() < 31 then return Vector3(single(x), 1, emptyArray(), 1, prependedArray(data3, full2), suffix2, suffix1, n)
        Vector4(single(x), 1, emptyArray(), 1, single(full2), 1 + (1 << 10), emptyArray(), data3, suffix2, suffix1, n)

    updatedAt(index: int, x: T) -> Vector[T]
        if index < len12
            if index < len1 then return Vector3(replacedArray(prefix1, index, x), len1, prefix2, len12, data3, suffix2, suffix1, size)
            return Vector3(prefix1, len1, replaced2(prefix2, index - len1, x), len12, data3, suffix2, suffix1, size)
        val io = index - len12
        if (io >> 10) < data3.length() then return Vector3(prefix1, len1, prefix2, len12, replaced3(data3, io, x), suffix2, suffix1, size)
        if ((io >> 5) & 31) < suffix2.length() then return Vector3(prefix1, len1, prefix2, len12, data3, replaced2(suffix2, io & 1023, x), suffix1, size)
        Vector3(prefix1, len1, prefix2, len12, data3, suffix2, replacedArray(suffix1, io & 31, x), size)

    feed(s: VectorSlicer[T], lo: int, hi: int)
        s.piece1(prefix1, 0, lo, hi)
        s.piece2(prefix2, len1, lo, hi)
        s.piece3(data3, len12, lo, hi)
        val at2 = len12 + (data3.length() << 10)
        s.piece2(suffix2, at2, lo, hi)
        s.piece1(suffix1, at2 + (suffix2.length() << 5), lo, hi)

impl[T] Vector4[T]
    appended(x: T) -> Vector[T]
        val n = size + 1
        if suffix1.length() < 32
            return Vector4(prefix1, len1, prefix2, len12, prefix3, len123, data4, suffix3, suffix2, appendedArray(suffix1, x), n)
        if suffix2.length() < 31
            return Vector4(prefix1, len1, prefix2, len12, prefix3, len123, data4, suffix3, appendedArray(suffix2, suffix1), single(x), n)
        val full2 = appendedArray(suffix2, suffix1)
        if suffix3.length() < 31
            return Vector4(prefix1, len1, prefix2, len12, prefix3, len123, data4, appendedArray(suffix3, full2), emptyArray(), single(x), n)
        val full3 = appendedArray(suffix3, full2)
        if data4.length() < 31
            return Vector4(prefix1, len1, prefix2, len12, prefix3, len123, appendedArray(data4, full3), emptyArray(), emptyArray(), single(x), n)
        Vector5(prefix1, len1, prefix2, len12, prefix3, len123, data4, len123 + (data4.length() << 15), emptyArray(),
                single(full3), emptyArray(), emptyArray(), single(x), n)

    prepended(x: T) -> Vector[T]
        val n = size + 1
        if prefix1.length() < 32
            return Vector4(prependedArray(prefix1, x), len1 + 1, prefix2, len12 + 1, prefix3, len123 + 1, data4, suffix3, suffix2, suffix1, n)
        if prefix2.length() < 31
            return Vector4(single(x), 1, prependedArray(prefix2, prefix1), len12 + 1, prefix3, len123 + 1, data4, suffix3, suffix2, suffix1, n)
        val full2 = prependedArray(prefix2, prefix1)
        if prefix3.length() < 31
            return Vector4(single(x), 1, emptyArray(), 1, prependedArray(prefix3, full2), len123 + 1, data4, suffix3, suffix2, suffix1, n)
        val full3 = prependedArray(prefix3, full2)
        if data4.length() < 31
            return Vector4(single(x), 1, emptyArray(), 1, emptyArray(), 1, prependedArray(data4, full3), suffix3, suffix2, suffix1, n)
        Vector5(single(x), 1, emptyArray(), 1, emptyArray(), 1, single(full3), 1 + (1 << 15), emptyArray(), data4,
                suffix3, suffix2, suffix1, n)

    updatedAt(index: int, x: T) -> Vector[T]
        if index < len123
            if index < len12
                if index < len1
                    return Vector4(replacedArray(prefix1, index, x), len1, prefix2, len12, prefix3, len123, data4, suffix3, suffix2, suffix1, size)
                return Vector4(prefix1, len1, replaced2(prefix2, index - len1, x), len12, prefix3, len123, data4, suffix3, suffix2, suffix1, size)
            return Vector4(prefix1, len1, prefix2, len12, replaced3(prefix3, index - len12, x), len123, data4, suffix3, suffix2, suffix1, size)
        val io = index - len123
        if (io >> 15) < data4.length()
            return Vector4(prefix1, len1, prefix2, len12, prefix3, len123, replaced4(data4, io, x), suffix3, suffix2, suffix1, size)
        if ((io >> 10) & 31) < suffix3.length()
            return Vector4(prefix1, len1, prefix2, len12, prefix3, len123, data4, replaced3(suffix3, io & 32767, x), suffix2, suffix1, size)
        if ((io >> 5) & 31) < suffix2.length()
            return Vector4(prefix1, len1, prefix2, len12, prefix3, len123, data4, suffix3, replaced2(suffix2, io & 1023, x), suffix1, size)
        Vector4(prefix1, len1, prefix2, len12, prefix3, len123, data4, suffix3, suffix2, replacedArray(suffix1, io & 31, x), size)

    feed(s: VectorSlicer[T], lo: int, hi: int)
        s.piece1(prefix1, 0, lo, hi)
        s.piece2(prefix2, len1, lo, hi)
        s.piece3(prefix3, len12, lo, hi)
        s.piece4(data4, len123, lo, hi)
        val at3 = len123 + (data4.length() << 15)
        s.piece3(suffix3, at3, lo, hi)
        val at2 = at3 + (suffix3.length() << 10)
        s.piece2(suffix2, at2, lo, hi)
        s.piece1(suffix1, at2 + (suffix2.length() << 5), lo, hi)

impl[T] Vector5[T]
    appended(x: T) -> Vector[T]
        val n = size + 1
        if suffix1.length() < 32
            return Vector5(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, data5, suffix4, suffix3, suffix2,
                           appendedArray(suffix1, x), n)
        if suffix2.length() < 31
            return Vector5(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, data5, suffix4, suffix3,
                           appendedArray(suffix2, suffix1), single(x), n)
        val full2 = appendedArray(suffix2, suffix1)
        if suffix3.length() < 31
            return Vector5(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, data5, suffix4,
                           appendedArray(suffix3, full2), emptyArray(), single(x), n)
        val full3 = appendedArray(suffix3, full2)
        if suffix4.length() < 31
            return Vector5(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, data5, appendedArray(suffix4, full3),
                           emptyArray(), emptyArray(), single(x), n)
        val full4 = appendedArray(suffix4, full3)
        if data5.length() < 31
            return Vector5(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, appendedArray(data5, full4),
                           emptyArray(), emptyArray(), emptyArray(), single(x), n)
        Vector6(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, data5, len1234 + (data5.length() << 20),
                emptyArray(), single(full4), emptyArray(), emptyArray(), emptyArray(), single(x), n)

    prepended(x: T) -> Vector[T]
        val n = size + 1
        if prefix1.length() < 32
            return Vector5(prependedArray(prefix1, x), len1 + 1, prefix2, len12 + 1, prefix3, len123 + 1, prefix4, len1234 + 1,
                           data5, suffix4, suffix3, suffix2, suffix1, n)
        if prefix2.length() < 31
            return Vector5(single(x), 1, prependedArray(prefix2, prefix1), len12 + 1, prefix3, len123 + 1, prefix4, len1234 + 1,
                           data5, suffix4, suffix3, suffix2, suffix1, n)
        val full2 = prependedArray(prefix2, prefix1)
        if prefix3.length() < 31
            return Vector5(single(x), 1, emptyArray(), 1, prependedArray(prefix3, full2), len123 + 1, prefix4, len1234 + 1,
                           data5, suffix4, suffix3, suffix2, suffix1, n)
        val full3 = prependedArray(prefix3, full2)
        if prefix4.length() < 31
            return Vector5(single(x), 1, emptyArray(), 1, emptyArray(), 1, prependedArray(prefix4, full3), len1234 + 1,
                           data5, suffix4, suffix3, suffix2, suffix1, n)
        val full4 = prependedArray(prefix4, full3)
        if data5.length() < 31
            return Vector5(single(x), 1, emptyArray(), 1, emptyArray(), 1, emptyArray(), 1, prependedArray(data5, full4),
                           suffix4, suffix3, suffix2, suffix1, n)
        Vector6(single(x), 1, emptyArray(), 1, emptyArray(), 1, emptyArray(), 1, single(full4), 1 + (1 << 20), emptyArray(),
                data5, suffix4, suffix3, suffix2, suffix1, n)

    updatedAt(index: int, x: T) -> Vector[T]
        if index < len1234
            if index < len123
                if index < len12
                    if index < len1
                        return Vector5(replacedArray(prefix1, index, x), len1, prefix2, len12, prefix3, len123, prefix4, len1234,
                                       data5, suffix4, suffix3, suffix2, suffix1, size)
                    return Vector5(prefix1, len1, replaced2(prefix2, index - len1, x), len12, prefix3, len123, prefix4, len1234,
                                   data5, suffix4, suffix3, suffix2, suffix1, size)
                return Vector5(prefix1, len1, prefix2, len12, replaced3(prefix3, index - len12, x), len123, prefix4, len1234,
                               data5, suffix4, suffix3, suffix2, suffix1, size)
            return Vector5(prefix1, len1, prefix2, len12, prefix3, len123, replaced4(prefix4, index - len123, x), len1234,
                           data5, suffix4, suffix3, suffix2, suffix1, size)
        val io = index - len1234
        if (io >> 20) < data5.length()
            return Vector5(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, replaced5(data5, io, x),
                           suffix4, suffix3, suffix2, suffix1, size)
        if ((io >> 15) & 31) < suffix4.length()
            return Vector5(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, data5,
                           replaced4(suffix4, io & 1048575, x), suffix3, suffix2, suffix1, size)
        if ((io >> 10) & 31) < suffix3.length()
            return Vector5(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, data5, suffix4,
                           replaced3(suffix3, io & 32767, x), suffix2, suffix1, size)
        if ((io >> 5) & 31) < suffix2.length()
            return Vector5(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, data5, suffix4, suffix3,
                           replaced2(suffix2, io & 1023, x), suffix1, size)
        Vector5(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, data5, suffix4, suffix3, suffix2,
                replacedArray(suffix1, io & 31, x), size)

    feed(s: VectorSlicer[T], lo: int, hi: int)
        s.piece1(prefix1, 0, lo, hi)
        s.piece2(prefix2, len1, lo, hi)
        s.piece3(prefix3, len12, lo, hi)
        s.piece4(prefix4, len123, lo, hi)
        s.piece5(data5, len1234, lo, hi)
        val at4 = len1234 + (data5.length() << 20)
        s.piece4(suffix4, at4, lo, hi)
        val at3 = at4 + (suffix4.length() << 15)
        s.piece3(suffix3, at3, lo, hi)
        val at2 = at3 + (suffix3.length() << 10)
        s.piece2(suffix2, at2, lo, hi)
        s.piece1(suffix1, at2 + (suffix2.length() << 5), lo, hi)

impl[T] Vector6[T]
    appended(x: T) -> Vector[T]
        val n = size + 1
        if suffix1.length() < 32
            return Vector6(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, prefix5, len12345, data6,
                           suffix5, suffix4, suffix3, suffix2, appendedArray(suffix1, x), n)
        if suffix2.length() < 31
            return Vector6(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, prefix5, len12345, data6,
                           suffix5, suffix4, suffix3, appendedArray(suffix2, suffix1), single(x), n)
        val full2 = appendedArray(suffix2, suffix1)
        if suffix3.length() < 31
            return Vector6(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, prefix5, len12345, data6,
                           suffix5, suffix4, appendedArray(suffix3, full2), emptyArray(), single(x), n)
        val full3 = appendedArray(suffix3, full2)
        if suffix4.length() < 31
            return Vector6(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, prefix5, len12345, data6,
                           suffix5, appendedArray(suffix4, full3), emptyArray(), emptyArray(), single(x), n)
        val full4 = appendedArray(suffix4, full3)
        if suffix5.length() < 31
            return Vector6(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, prefix5, len12345, data6,
                           appendedArray(suffix5, full4), emptyArray(), emptyArray(), emptyArray(), single(x), n)
        // The length has room for this element, so it has room for one more node in the middle.
        val full5 = appendedArray(suffix5, full4)
        Vector6(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, prefix5, len12345, appendedArray(data6, full5),
                emptyArray(), emptyArray(), emptyArray(), emptyArray(), single(x), n)

    prepended(x: T) -> Vector[T]
        val n = size + 1
        if prefix1.length() < 32
            return Vector6(prependedArray(prefix1, x), len1 + 1, prefix2, len12 + 1, prefix3, len123 + 1, prefix4, len1234 + 1,
                           prefix5, len12345 + 1, data6, suffix5, suffix4, suffix3, suffix2, suffix1, n)
        if prefix2.length() < 31
            return Vector6(single(x), 1, prependedArray(prefix2, prefix1), len12 + 1, prefix3, len123 + 1, prefix4, len1234 + 1,
                           prefix5, len12345 + 1, data6, suffix5, suffix4, suffix3, suffix2, suffix1, n)
        val full2 = prependedArray(prefix2, prefix1)
        if prefix3.length() < 31
            return Vector6(single(x), 1, emptyArray(), 1, prependedArray(prefix3, full2), len123 + 1, prefix4, len1234 + 1,
                           prefix5, len12345 + 1, data6, suffix5, suffix4, suffix3, suffix2, suffix1, n)
        val full3 = prependedArray(prefix3, full2)
        if prefix4.length() < 31
            return Vector6(single(x), 1, emptyArray(), 1, emptyArray(), 1, prependedArray(prefix4, full3), len1234 + 1,
                           prefix5, len12345 + 1, data6, suffix5, suffix4, suffix3, suffix2, suffix1, n)
        val full4 = prependedArray(prefix4, full3)
        if prefix5.length() < 31
            return Vector6(single(x), 1, emptyArray(), 1, emptyArray(), 1, emptyArray(), 1, prependedArray(prefix5, full4),
                           len12345 + 1, data6, suffix5, suffix4, suffix3, suffix2, suffix1, n)
        val full5 = prependedArray(prefix5, full4)
        Vector6(single(x), 1, emptyArray(), 1, emptyArray(), 1, emptyArray(), 1, emptyArray(), 1, prependedArray(data6, full5),
                suffix5, suffix4, suffix3, suffix2, suffix1, n)

    updatedAt(index: int, x: T) -> Vector[T]
        if index < len12345
            if index < len1234
                if index < len123
                    if index < len12
                        if index < len1
                            return Vector6(replacedArray(prefix1, index, x), len1, prefix2, len12, prefix3, len123, prefix4,
                                           len1234, prefix5, len12345, data6, suffix5, suffix4, suffix3, suffix2, suffix1, size)
                        return Vector6(prefix1, len1, replaced2(prefix2, index - len1, x), len12, prefix3, len123, prefix4,
                                       len1234, prefix5, len12345, data6, suffix5, suffix4, suffix3, suffix2, suffix1, size)
                    return Vector6(prefix1, len1, prefix2, len12, replaced3(prefix3, index - len12, x), len123, prefix4,
                                   len1234, prefix5, len12345, data6, suffix5, suffix4, suffix3, suffix2, suffix1, size)
                return Vector6(prefix1, len1, prefix2, len12, prefix3, len123, replaced4(prefix4, index - len123, x),
                               len1234, prefix5, len12345, data6, suffix5, suffix4, suffix3, suffix2, suffix1, size)
            return Vector6(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234,
                           replaced5(prefix5, index - len1234, x), len12345, data6, suffix5, suffix4, suffix3, suffix2, suffix1, size)
        val io = index - len12345
        if (io >> 25) < data6.length()
            return Vector6(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, prefix5, len12345,
                           replaced6(data6, io, x), suffix5, suffix4, suffix3, suffix2, suffix1, size)
        if ((io >> 20) & 31) < suffix5.length()
            return Vector6(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, prefix5, len12345, data6,
                           replaced5(suffix5, io & 33554431, x), suffix4, suffix3, suffix2, suffix1, size)
        if ((io >> 15) & 31) < suffix4.length()
            return Vector6(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, prefix5, len12345, data6,
                           suffix5, replaced4(suffix4, io & 1048575, x), suffix3, suffix2, suffix1, size)
        if ((io >> 10) & 31) < suffix3.length()
            return Vector6(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, prefix5, len12345, data6,
                           suffix5, suffix4, replaced3(suffix3, io & 32767, x), suffix2, suffix1, size)
        if ((io >> 5) & 31) < suffix2.length()
            return Vector6(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, prefix5, len12345, data6,
                           suffix5, suffix4, suffix3, replaced2(suffix2, io & 1023, x), suffix1, size)
        Vector6(prefix1, len1, prefix2, len12, prefix3, len123, prefix4, len1234, prefix5, len12345, data6,
                suffix5, suffix4, suffix3, suffix2, replacedArray(suffix1, io & 31, x), size)

    feed(s: VectorSlicer[T], lo: int, hi: int)
        s.piece1(prefix1, 0, lo, hi)
        s.piece2(prefix2, len1, lo, hi)
        s.piece3(prefix3, len12, lo, hi)
        s.piece4(prefix4, len123, lo, hi)
        s.piece5(prefix5, len1234, lo, hi)
        s.piece6(data6, len12345, lo, hi)
        val at5 = len12345 + (data6.length() << 25)
        s.piece5(suffix5, at5, lo, hi)
        val at4 = at5 + (suffix5.length() << 20)
        s.piece4(suffix4, at4, lo, hi)
        val at3 = at4 + (suffix4.length() << 15)
        s.piece3(suffix3, at3, lo, hi)
        val at2 = at3 + (suffix3.length() << 10)
        s.piece2(suffix2, at2, lo, hi)
        s.piece1(suffix1, at2 + (suffix2.length() << 5), lo, hi)

// Assembles a vector from pieces given in order: runs of elements, and runs of full nodes of a level,
// each as an array of that level. Cutting a vector's arrays at two indices gives such pieces, whose
// levels rise and then fall, so the pieces before the highest are prefixes, the highest become the
// middle, and those after it are suffixes. The prefix and the suffix at level 1 are then made
// non-empty by opening the nearest node above them, a path of at most 5 nodes, and the levels left
// with nothing in the middle are dropped. A builder gives its full nodes the same way, highest
// first.
private class VectorSlicer[T](private var p1: FrozenArray[T], private var s1: FrozenArray[T],
                              private var p2: FrozenArray[FrozenArray[T]], private var s2: FrozenArray[FrozenArray[T]],
                              private var p3: FrozenArray[FrozenArray[FrozenArray[T]]],
                              private var s3: FrozenArray[FrozenArray[FrozenArray[T]]],
                              private var p4: FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]],
                              private var s4: FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]],
                              private var p5: FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]],
                              private var s5: FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]],
                              private var p6: FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]]],
                              private var s6: FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]]])
    // The level of the last piece taken, and how many elements the pieces hold.
    private var last = 0
    private var size = 0

    // A run of elements, or of full nodes of a level: a prefix while the levels rise, and a suffix
    // once they stop.
    chunk1(a: FrozenArray[T])
        val n = a.length()
        if n == 0 then return
        size += n
        if last < 1 then p1 = a else s1 = a
        last = 1

    chunk2(a: FrozenArray[FrozenArray[T]])
        val n = a.length()
        if n == 0 then return
        size += n << 5
        if last < 2 then p2 = a else s2 = a
        last = 2

    chunk3(a: FrozenArray[FrozenArray[FrozenArray[T]]])
        val n = a.length()
        if n == 0 then return
        size += n << 10
        if last < 3 then p3 = a else s3 = a
        last = 3

    chunk4(a: FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]])
        val n = a.length()
        if n == 0 then return
        size += n << 15
        if last < 4 then p4 = a else s4 = a
        last = 4

    chunk5(a: FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]])
        val n = a.length()
        if n == 0 then return
        size += n << 20
        if last < 5 then p5 = a else s5 = a
        last = 5

    chunk6(a: FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]]])
        val n = a.length()
        if n == 0 then return
        size += n << 25
        if last < 6 then p6 = a else s6 = a
        last = 6

    // The elements from `from` up to `until` of a node of each level, counted from its first
    // element, given as the pieces they make: the part of the first child they reach into, the
    // children they hold whole, and the part of the last child.
    cut1(a: FrozenArray[T], from: int, until: int) = chunk1(part(a, from, until))

    cut2(a: FrozenArray[FrozenArray[T]], from: int, until: int)
        val c0 = from >> 5
        val c1 = until >> 5
        if c0 == c1
            cut1(a(c0), from & 31, until & 31)
            return
        var first = c0
        if (from & 31) != 0
            cut1(a(c0), from & 31, 32)
            first = c0 + 1
        if first < c1 then chunk2(part(a, first, c1))
        if (until & 31) != 0 then cut1(a(c1), 0, until & 31)

    cut3(a: FrozenArray[FrozenArray[FrozenArray[T]]], from: int, until: int)
        val c0 = from >> 10
        val c1 = until >> 10
        if c0 == c1
            cut2(a(c0), from & 1023, until & 1023)
            return
        var first = c0
        if (from & 1023) != 0
            cut2(a(c0), from & 1023, 1024)
            first = c0 + 1
        if first < c1 then chunk3(part(a, first, c1))
        if (until & 1023) != 0 then cut2(a(c1), 0, until & 1023)

    cut4(a: FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]], from: int, until: int)
        val c0 = from >> 15
        val c1 = until >> 15
        if c0 == c1
            cut3(a(c0), from & 32767, until & 32767)
            return
        var first = c0
        if (from & 32767) != 0
            cut3(a(c0), from & 32767, 32768)
            first = c0 + 1
        if first < c1 then chunk4(part(a, first, c1))
        if (until & 32767) != 0 then cut3(a(c1), 0, until & 32767)

    cut5(a: FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]], from: int, until: int)
        val c0 = from >> 20
        val c1 = until >> 20
        if c0 == c1
            cut4(a(c0), from & 1048575, until & 1048575)
            return
        var first = c0
        if (from & 1048575) != 0
            cut4(a(c0), from & 1048575, 1048576)
            first = c0 + 1
        if first < c1 then chunk5(part(a, first, c1))
        if (until & 1048575) != 0 then cut4(a(c1), 0, until & 1048575)

    cut6(a: FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]]], from: int, until: int)
        val c0 = from >> 25
        val c1 = until >> 25
        if c0 == c1
            cut5(a(c0), from & 33554431, until & 33554431)
            return
        var first = c0
        if (from & 33554431) != 0
            cut5(a(c0), from & 33554431, 33554432)
            first = c0 + 1
        if first < c1 then chunk6(part(a, first, c1))
        if (until & 33554431) != 0 then cut5(a(c1), 0, until & 33554431)

    // The part of a vector's array of each level, which starts at its element `start`, that lies
    // within the vector's elements from `lo` up to `hi`.
    piece1(a: FrozenArray[T], start: int, lo: int, hi: int)
        val from = if lo > start then lo else start
        val end = start + a.length()
        val until = if hi < end then hi else end
        if from < until then cut1(a, from - start, until - start)

    piece2(a: FrozenArray[FrozenArray[T]], start: int, lo: int, hi: int)
        val from = if lo > start then lo else start
        val end = start + (a.length() << 5)
        val until = if hi < end then hi else end
        if from < until then cut2(a, from - start, until - start)

    piece3(a: FrozenArray[FrozenArray[FrozenArray[T]]], start: int, lo: int, hi: int)
        val from = if lo > start then lo else start
        val end = start + (a.length() << 10)
        val until = if hi < end then hi else end
        if from < until then cut3(a, from - start, until - start)

    piece4(a: FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]], start: int, lo: int, hi: int)
        val from = if lo > start then lo else start
        val end = start + (a.length() << 15)
        val until = if hi < end then hi else end
        if from < until then cut4(a, from - start, until - start)

    piece5(a: FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]], start: int, lo: int, hi: int)
        val from = if lo > start then lo else start
        val end = start + (a.length() << 20)
        val until = if hi < end then hi else end
        if from < until then cut5(a, from - start, until - start)

    piece6(a: FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]]], start: int, lo: int, hi: int)
        val from = if lo > start then lo else start
        val end = start + (a.length() << 25)
        val until = if hi < end then hi else end
        if from < until then cut6(a, from - start, until - start)

    // The vector of the pieces taken.
    result() -> Vector[T]
        if size == 0 then return Vector0()
        // The depth: the highest level's pieces are the middle, unless together they are more than
        // a middle below depth 6 holds, when they stay a prefix and a suffix around an empty middle
        // one level up.
        var d = 2
        if p6.length() + s6.length() > 0
            p6 = concatArray(p6, s6)
            d = 6
        elif p5.length() + s5.length() > 0
            d = 6
            if p5.length() + s5.length() <= 31
                p5 = concatArray(p5, s5)
                d = 5
        elif p4.length() + s4.length() > 0
            d = 5
            if p4.length() + s4.length() <= 31
                p4 = concatArray(p4, s4)
                d = 4
        elif p3.length() + s3.length() > 0
            d = 4
            if p3.length() + s3.length() <= 31
                p3 = concatArray(p3, s3)
                d = 3
        elif p2.length() + s2.length() > 0
            d = 3
            if p2.length() + s2.length() <= 31
                p2 = concatArray(p2, s2)
                d = 2
        else
            if p1.length() == 0 then return Vector1(s1)
            if s1.length() == 0 then return Vector1(p1)
            if p1.length() + s1.length() <= 32 then return Vector1(concatArray(p1, s1))
            return Vector2(p1, p1.length(), p2, s1, size)
        // From here the suffixes are those below level `d`; one at `d` or above was merged into
        // the middle or is empty.
        if p1.length() == 0
            if p2.length() > 0
                p1 = p2(0)
                p2 = dropFirst(p2)
            elif p3.length() > 0
                openLeft3(p3(0))
                p3 = dropFirst(p3)
            elif p4.length() > 0
                openLeft4(p4(0))
                p4 = dropFirst(p4)
            elif p5.length() > 0
                openLeft5(p5(0))
                p5 = dropFirst(p5)
            elif p6.length() > 0
                openLeft6(p6(0))
                p6 = dropFirst(p6)
            elif d > 5 && s5.length() > 0
                openLeft5(s5(0))
                s5 = dropFirst(s5)
            elif d > 4 && s4.length() > 0
                openLeft4(s4(0))
                s4 = dropFirst(s4)
            elif d > 3 && s3.length() > 0
                openLeft3(s3(0))
                s3 = dropFirst(s3)
            elif d > 2 && s2.length() > 0
                p1 = s2(0)
                s2 = dropFirst(s2)
            else return Vector1(s1)
        if s1.length() == 0
            if d > 2 && s2.length() > 0
                s1 = lastOf(s2)
                s2 = dropLast(s2)
            elif d > 3 && s3.length() > 0
                openRight3(lastOf(s3))
                s3 = dropLast(s3)
            elif d > 4 && s4.length() > 0
                openRight4(lastOf(s4))
                s4 = dropLast(s4)
            elif d > 5 && s5.length() > 0
                openRight5(lastOf(s5))
                s5 = dropLast(s5)
            elif p6.length() > 0
                openRight6(lastOf(p6))
                p6 = dropLast(p6)
            elif p5.length() > 0
                openRight5(lastOf(p5))
                p5 = dropLast(p5)
            elif p4.length() > 0
                openRight4(lastOf(p4))
                p4 = dropLast(p4)
            elif p3.length() > 0
                openRight3(lastOf(p3))
                p3 = dropLast(p3)
            elif p2.length() > 0
                s1 = lastOf(p2)
                p2 = dropLast(p2)
            else return Vector1(p1)
        // A level whose middle is empty, and whose prefix and suffix below fit one middle, is dropped.
        if d == 6 && p6.length() == 0 && p5.length() + s5.length() <= 31
            p5 = concatArray(p5, s5)
            d = 5
        if d == 5 && p5.length() == 0 && p4.length() + s4.length() <= 31
            p4 = concatArray(p4, s4)
            d = 4
        if d == 4 && p4.length() == 0 && p3.length() + s3.length() <= 31
            p3 = concatArray(p3, s3)
            d = 3
        if d == 3 && p3.length() == 0 && p2.length() + s2.length() <= 31
            p2 = concatArray(p2, s2)
            d = 2
        if d == 2 && p2.length() == 0 && p1.length() + s1.length() <= 32 then return Vector1(concatArray(p1, s1))
        val l1 = p1.length()
        if d == 2 then return Vector2(p1, l1, p2, s1, size)
        val l12 = l1 + (p2.length() << 5)
        if d == 3 then return Vector3(p1, l1, p2, l12, p3, s2, s1, size)
        val l123 = l12 + (p3.length() << 10)
        if d == 4 then return Vector4(p1, l1, p2, l12, p3, l123, p4, s3, s2, s1, size)
        val l1234 = l123 + (p4.length() << 15)
        if d == 5 then return Vector5(p1, l1, p2, l12, p3, l123, p4, l1234, p5, s4, s3, s2, s1, size)
        val l12345 = l1234 + (p5.length() << 20)
        Vector6(p1, l1, p2, l12, p3, l123, p4, l1234, p5, l12345, p6, s5, s4, s3, s2, s1, size)

    // A full node made the first of the vector's elements: its first child opened in turn, and the
    // rest of each level's children made that level's prefix.
    private openLeft3(n: FrozenArray[FrozenArray[T]])
        p2 = dropFirst(n)
        p1 = n(0)

    private openLeft4(n: FrozenArray[FrozenArray[FrozenArray[T]]])
        p3 = dropFirst(n)
        openLeft3(n(0))

    private openLeft5(n: FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]])
        p4 = dropFirst(n)
        openLeft4(n(0))

    private openLeft6(n: FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]])
        p5 = dropFirst(n)
        openLeft5(n(0))

    // A full node made the last of the vector's elements, opened the same way from its end.
    private openRight3(n: FrozenArray[FrozenArray[T]])
        s2 = dropLast(n)
        s1 = lastOf(n)

    private openRight4(n: FrozenArray[FrozenArray[FrozenArray[T]]])
        s3 = dropLast(n)
        openRight3(lastOf(n))

    private openRight5(n: FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]])
        s4 = dropLast(n)
        openRight4(lastOf(n))

    private openRight6(n: FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]])
        s5 = dropLast(n)
        openRight5(lastOf(n))

// A slicer with nothing in it yet. The arrays of each level start as one empty array of that level.
private newSlicer[T]() -> VectorSlicer[T]
    val e1 = emptyArray[T]()
    val e2 = emptyArray[FrozenArray[T]]()
    val e3 = emptyArray[FrozenArray[FrozenArray[T]]]()
    val e4 = emptyArray[FrozenArray[FrozenArray[FrozenArray[T]]]]()
    val e5 = emptyArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]]()
    val e6 = emptyArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]]]()
    VectorSlicer(e1, e1, e2, e2, e3, e3, e4, e4, e5, e5, e6, e6)

// Collects elements into full leaves, and full nodes of each level into the level above, so a vector
// of `n` elements is assembled in time proportional to `n` with each element copied once. The levels
// above the first leaf are made only when one fills.
private class VectorAssembler[T]()
    private var leaf: Array[T] = newArray[T](32)
    private var count = 0
    private var levels: Option[VectorLevels[T]] = None

    addOne(element: T)
        leaf(count) = element
        count += 1
        if count == 32
            publish(leaf)
            push(freeze(leaf))
            leaf = newArray[T](32)
            count = 0

    // The elements of `a` from `from` up to `until`, whole leaves of them copied at once once the
    // leaf being filled is full.
    addElements(a: FrozenArray[T], from: int, until: int)
        var i = from
        while i < until && count > 0
            addOne(a(i))
            i += 1
        while until - i >= 32
            push(a.slice(i, i + 32))
            i += 32
        while i < until
            addOne(a(i))
            i += 1

    // The elements of `v`, a leaf at a time.
    addVector(v: Vector[T])
        val n = v.length()
        var at = 0
        while at < n
            val l = vectorLeaf(v, at)
            addElements(l, 0, l.length())
            at += l.length()

    private push(full: FrozenArray[T]) = levels match
        Some(l) -> l.push2(full)
        None ->
            val l = VectorLevels[T]()
            l.push2(full)
            levels = Some(l)

    result() -> Vector[T] = levels match
        None ->
            if count == 0 then Vector0() else Vector1(freeze(leaf.slice(0, count)))
        Some(l) ->
            val s = newSlicer[T]()
            l.feed(s)
            if count > 0 then s.chunk1(freeze(leaf.slice(0, count)))
            s.result()

// The full nodes an assembler has made at each level above the leaves, each level's array filled
// up to its count. A level that fills becomes one node of the level above.
private class VectorLevels[T]()
    private var l2: Array[FrozenArray[T]] = newArray[FrozenArray[T]](32)
    private var n2 = 0
    private var l3: Array[FrozenArray[FrozenArray[T]]] = newArray[FrozenArray[FrozenArray[T]]](32)
    private var n3 = 0
    private var l4: Array[FrozenArray[FrozenArray[FrozenArray[T]]]] = newArray[FrozenArray[FrozenArray[FrozenArray[T]]]](32)
    private var n4 = 0
    private var l5: Array[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]] =
        newArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]](32)
    private var n5 = 0
    // The top level holds as many nodes as an `int` length allows.
    private var l6: Array[FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]]] =
        newArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]]](64)
    private var n6 = 0

    push2(a: FrozenArray[T])
        l2(n2) = a
        n2 += 1
        if n2 == 32
            publish(l2)
            push3(freeze(l2))
            l2 = newArray[FrozenArray[T]](32)
            n2 = 0

    push3(a: FrozenArray[FrozenArray[T]])
        l3(n3) = a
        n3 += 1
        if n3 == 32
            publish(l3)
            push4(freeze(l3))
            l3 = newArray[FrozenArray[FrozenArray[T]]](32)
            n3 = 0

    push4(a: FrozenArray[FrozenArray[FrozenArray[T]]])
        l4(n4) = a
        n4 += 1
        if n4 == 32
            publish(l4)
            push5(freeze(l4))
            l4 = newArray[FrozenArray[FrozenArray[FrozenArray[T]]]](32)
            n4 = 0

    push5(a: FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]])
        l5(n5) = a
        n5 += 1
        if n5 == 32
            publish(l5)
            push6(freeze(l5))
            l5 = newArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]](32)
            n5 = 0

    push6(a: FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]])
        l6(n6) = a
        n6 += 1

    // Gives the slicer each level's nodes, the highest first.
    feed(s: VectorSlicer[T])
        if n6 > 0 then s.chunk6(freeze(l6.slice(0, n6)))
        if n5 > 0 then s.chunk5(freeze(l5.slice(0, n5)))
        if n4 > 0 then s.chunk4(freeze(l4.slice(0, n4)))
        if n3 > 0 then s.chunk3(freeze(l3.slice(0, n3)))
        if n2 > 0 then s.chunk2(freeze(l2.slice(0, n2)))

// The leaf of `v` that holds the element at `index`, which is in range. Every leaf is used whole, so
// the leaf that holds an index where one leaf ends begins there.
private vectorLeaf[T](v: Vector[T], index: int) -> FrozenArray[T] = v match
    x: Vector2[T] -> x.leafAt(index)
    x: Vector3[T] -> x.leafAt(index)
    x: Vector1[T] -> x.data1
    x: Vector4[T] -> x.leafAt(index)
    x: Vector5[T] -> x.leafAt(index)
    x: Vector6[T] -> x.leafAt(index)
    _ -> fail("index out of range")

// The vector of the elements of `a`, which nothing writes to again: a short one keeps `a` as its one
// leaf.
private vectorOf[T](a: FrozenArray[T]) -> Vector[T]
    val n = a.length()
    if n == 0 then return Vector0()
    if n <= 32 then return Vector1(a)
    val b = VectorAssembler[T]()
    b.addElements(a, 0, n)
    b.result()

// The arrays of a vector, each a new array.

private emptyArray[C]() -> FrozenArray[C] = freeze(newArray[C](0))

private single[C](x: C) -> FrozenArray[C]
    val a = newArray[C](1)
    a(0) = x
    publish(a)
    freeze(a)

private appendedArray[C](a: FrozenArray[C], x: C) -> FrozenArray[C]
    val n = a.length()
    val b = newArray[C](n + 1)
    var i = 0
    while i < n
        b(i) = a(i)
        i += 1
    b(n) = x
    publish(b)
    freeze(b)

private prependedArray[C](a: FrozenArray[C], x: C) -> FrozenArray[C]
    val n = a.length()
    val b = newArray[C](n + 1)
    b(0) = x
    var i = 0
    while i < n
        b(i + 1) = a(i)
        i += 1
    publish(b)
    freeze(b)

private replacedArray[C](a: FrozenArray[C], index: int, x: C) -> FrozenArray[C]
    val n = a.length()
    val b = newArray[C](n)
    var i = 0
    while i < n
        b(i) = a(i)
        i += 1
    b(index) = x
    publish(b)
    freeze(b)

private concatArray[C](a: FrozenArray[C], b: FrozenArray[C]) -> FrozenArray[C]
    val n = a.length()
    if n == 0 then return b
    val m = b.length()
    if m == 0 then return a
    val c = newArray[C](n + m)
    var i = 0
    while i < n
        c(i) = a(i)
        i += 1
    i = 0
    while i < m
        c(n + i) = b(i)
        i += 1
    publish(c)
    freeze(c)

// The elements of `a` from `from` up to `until`: `a` itself when that is all of them.
private part[C](a: FrozenArray[C], from: int, until: int) -> FrozenArray[C] =
    if from == 0 && until == a.length() then a else a.slice(from, until)

private dropFirst[C](a: FrozenArray[C]) -> FrozenArray[C] = a.slice(1, a.length())

private dropLast[C](a: FrozenArray[C]) -> FrozenArray[C] = a.slice(0, a.length() - 1)

private lastOf[C](a: FrozenArray[C]) -> C = a(a.length() - 1)

// A node of each level with the element `o` elements into it replaced: the path to it copied.
private replaced2[T](a: FrozenArray[FrozenArray[T]], o: int, x: T) -> FrozenArray[FrozenArray[T]] =
    replacedArray(a, o >> 5, replacedArray(a(o >> 5), o & 31, x))

private replaced3[T](a: FrozenArray[FrozenArray[FrozenArray[T]]], o: int, x: T) -> FrozenArray[FrozenArray[FrozenArray[T]]] =
    replacedArray(a, o >> 10, replaced2(a(o >> 10), o & 1023, x))

private replaced4[T](a: FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]], o: int, x: T) -> FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]] =
    replacedArray(a, o >> 15, replaced3(a(o >> 15), o & 32767, x))

private replaced5[T](a: FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]], o: int, x: T) -> FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]] =
    replacedArray(a, o >> 20, replaced4(a(o >> 20), o & 1048575, x))

private replaced6[T](a: FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]]], o: int, x: T) -> FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[FrozenArray[T]]]]]] =
    replacedArray(a, o >> 25, replaced5(a(o >> 25), o & 33554431, x))
