module avin

// A value that may be absent: `Some(value)` holds one, `None` holds none.
data Option[+T]
    Some(value: T)
    None

// A method taking a value that may be wider than `T` takes it as a type with `T` as its lower bound,
// so `cat.getOrElse(dog)` on an `Option[Cat]` is an `Animal`.
impl[T] Option[T]
    isDefined() -> bool = self match
        Some(_) -> true
        None -> false

    isEmpty() -> bool = !isDefined()

    nonEmpty() -> bool = isDefined()

    // The held value; traps on `None`, which has none.
    get() -> T = self match
        Some(v) -> v
        None -> fail("get of None")

    // The held value, or `default`, which is evaluated only when there is none.
    getOrElse[B >: T](default: -> B) -> B = self match
        Some(v) -> v
        None -> default

    // This option if it holds a value, otherwise `other`, evaluated only then.
    orElse[B >: T](other: -> Option[B]) -> Option[B] = self match
        Some(_) -> self
        None -> other

    map[U](f: (T) -> U) -> Option[U] = self match
        Some(v) -> Some(f(v))
        None -> None

    flatMap[U](f: (T) -> Option[U]) -> Option[U] = self match
        Some(v) -> f(v)
        None -> None

    // This option if its value satisfies `p`, otherwise `None`.
    filter(p: (T) -> bool) -> Option[T] = self match
        Some(v) if p(v) -> self
        _ -> None

    // `Some` of `pf` of the value, where there is one and `pf` is defined at it, otherwise `None`.
    collect[U](pf: PartialFunction[T, U]) -> Option[U] = self match
        Some(v) -> pf.lift()(v)
        None -> None

    // This option if its value does not satisfy `p`, otherwise `None`.
    filterNot(p: (T) -> bool) -> Option[T] = self match
        Some(v) if !p(v) -> self
        _ -> None

    // `filter`, for a guard of a `for` with `yield`: with one value at most, testing it at once
    // already tests it just before the call after the guard uses it.
    withFilter(p: (T) -> bool) -> Option[T] = filter(p)

    // `ifNone` when there is no value, otherwise `f` of it.
    fold[U](ifNone: -> U, f: (T) -> U) -> U = self match
        Some(v) -> f(v)
        None -> ifNone

    // Calls `f` with the value, if there is one.
    foreach(f: (T) -> unit) = self match
        Some(v) -> f(v)
        None -> ()

    // Whether there is a value and it satisfies `p`; false for `None`.
    exists(p: (T) -> bool) -> bool = self match
        Some(v) -> p(v)
        None -> false

    // Whether every value satisfies `p`: true for `None`, which has none.
    forall(p: (T) -> bool) -> bool = self match
        Some(v) -> p(v)
        None -> true

    // The value as a list of one element, or the empty list.
    toList() -> List[T] = self match
        Some(v) -> v :: Nil
        None -> Nil

    // The value as a vector of one element, or the empty vector.
    toVector() -> Vector[T] = self match
        Some(v) -> [v]
        None -> Vector.empty[T]()

    // The value as an `ArraySeq` of one element, or the empty one.
    toArraySeq() -> ArraySeq[T] = self match
        Some(v) -> ArraySeq.empty[T]() :+ v
        None -> ArraySeq.empty[T]()

    // An iterator over the value: one element for `Some`, none for `None`.
    iterator() -> Iterator[T] = toList().iterator()

    // The number of values held, known without looking further: 1 for `Some`, 0 for `None`.
    knownSize() -> int = self match
        Some(_) -> 1
        None -> 0

    // `Right` of the value, or `Left` of `left`, evaluated only when there is no value.
    toRight[L](left: -> L) -> Either[L, T] = self match
        Some(v) -> Right(v)
        None -> Left(left)

    // `Left` of the value, or `Right` of `right`, evaluated only when there is no value.
    toLeft[R](right: -> R) -> Either[T, R] = self match
        Some(v) -> Left(v)
        None -> Right(right)

    // The pair of the two values when both options have one, otherwise `None`.
    zip[T1 >: T, U](other: Option[U]) -> Option[(T1, U)] = self match
        Some(a) -> other match
            Some(b) -> Some((a, b))
            None -> None
        None -> None

    // Whether there is a value equal to `x`, by `==`. Every type has equality, so this is
    // available on every option, and `x` may be of a wider type than the value.
    contains[T1 >: T](x: T1) -> bool = self match
        Some(v) -> v == x
        None -> false

// An option of an option has `flatten`: `Some(Some(x))` is `Some(x)`, and either `None` is `None`.
impl[T] Option[Option[T]]
    flatten() -> Option[T] = self match
        Some(inner) -> inner
        None -> None

// An option of a pair has `unzip`: the options of its two parts, both `None` for `None`.
impl[A, B] Option[(A, B)]
    unzip() -> (Option[A], Option[B]) = self match
        Some((a, b)) -> (Some(a), Some(b))
        None -> (None, None)
