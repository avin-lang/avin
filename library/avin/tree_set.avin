module avin

// The sorted immutable set, kept in the order of its elements' `compare`, so any `Ord` type can be an
// element, each present at most once. It is a `SortedSet`, and so a `Set`. An update answers a new
// tree set that shares all but the changed path with the old one, which is left as it was. Iteration
// visits the elements in ascending order, and the ordered operations — the first and last elements,
// the nearest element to a value, and the elements from, until or between values — take time in the
// logarithm of the size. `TreeSet.empty[A]()` is the empty set, and `TreeSet.builder[A]()` builds one
// from elements.
data TreeSet[A: Ord](root: SortedTree[A, unit] = Tip)

impl[A] SortedSet[A] for TreeSet[A]
    size() -> int = treeSize(root)

    isEmpty() -> bool = root is Tip

    nonEmpty() -> bool = !isEmpty()

    contains(element: A) -> bool = treeFind(root, element) is Some(_)

    added(element: A) -> TreeSet[A] =
        if contains(element) then self else TreeSet(treeInsert(root, element, ()))

    removed(element: A) -> TreeSet[A] =
        if contains(element) then TreeSet(treeRemove(root, element)) else self

    ++(other: Iterable[A]) -> TreeSet[A]
        var t = root
        for x in other
            if treeFind(t, x) is None then t = treeInsert(t, x, ())
        TreeSet(t)

    --(other: Iterable[A]) -> TreeSet[A]
        var t = root
        for x in other
            if treeFind(t, x) is Some(_) then t = treeRemove(t, x)
        TreeSet(t)

    union(other: Set[A]) -> TreeSet[A] = self ++ other

    intersect(other: Set[A]) -> TreeSet[A] = filter(x -> other.contains(x))

    diff(other: Set[A]) -> TreeSet[A] = filter(x -> !other.contains(x))

    filter(p: (A) -> bool) -> TreeSet[A] = TreeSet(treeFilter(root, (x, u) -> p(x)))

    // The elements in ascending order.
    iterator() -> Iterator[A] = SetElements(SortedTreeIterator(root, false))

    reverseIterator() -> Iterator[A] = SetElements(SortedTreeIterator(root, true))

    first() -> Option[A] = treeFirst(root).map(e -> e.0)

    last() -> Option[A] = treeLast(root).map(e -> e.0)

    floor(x: A) -> Option[A] = treeFloor(root, x).map(e -> e.0)

    ceiling(x: A) -> Option[A] = treeCeiling(root, x).map(e -> e.0)

    from(low: A) -> TreeSet[A] = TreeSet(treeFrom(root, low))

    until(high: A) -> TreeSet[A] = TreeSet(treeUntil(root, high))

    range(low: A, high: A) -> TreeSet[A] = TreeSet(treeUntil(treeFrom(root, low), high))

// A tree set's own versions of the methods every set has that make elements of another type: they
// build tree sets, so the new elements are bounded by `Ord`.
impl[A] TreeSet[A]
    // The set of `f` of each element; elements that `f` maps alike become one.
    map[B: Ord](f: (A) -> B) -> TreeSet[B]
        var t: SortedTree[B, unit] = Tip
        for x in self do t = treeInsert(t, f(x), ())
        TreeSet(t)

    // The set of `pf` of each element it is defined at; elements that `pf` maps alike become one.
    collect[B: Ord](pf: PartialFunction[A, B]) -> TreeSet[B]
        val f = pf.lift()
        var t: SortedTree[B, unit] = Tip
        for x in self
            if f(x) is Some(y) then t = treeInsert(t, y, ())
        TreeSet(t)

    // The set of the elements of the collections `f` makes of each element.
    flatMap[B: Ord](f: (A) -> Iterable[B]) -> TreeSet[B]
        var t: SortedTree[B, unit] = Tip
        for x in self
            for y in f(x) do t = treeInsert(t, y, ())
        TreeSet(t)

    // The elements that satisfy `p`, tested only as `map`, `flatMap` or `foreach` reaches each one.
    withFilter(p: (A) -> bool) -> FilteredTreeSet[A] = FilteredTreeSet(self, p)

    // Calls `f` with each element, in ascending order.
    foreach(f: (A) -> unit)
        for x in self do f(x)

// A tree set seen through a test, which a guard of a `for` with `yield` makes: each element is
// tested just before the call after it would use it, in ascending order.
class FilteredTreeSet[A: Ord](private val set: TreeSet[A], private val p: (A) -> bool)
    // The set of `f` of each element that passes the test.
    map[B: Ord](f: (A) -> B) -> TreeSet[B]
        var t: SortedTree[B, unit] = Tip
        for x in set
            if p(x) then t = treeInsert(t, f(x), ())
        TreeSet(t)

    // The set of the elements of the collections `f` makes of each element that passes the test.
    flatMap[B: Ord](f: (A) -> Iterable[B]) -> TreeSet[B]
        var t: SortedTree[B, unit] = Tip
        for x in set
            if p(x)
                for y in f(x) do t = treeInsert(t, y, ())
        TreeSet(t)

    // The elements that pass this test and then `q`.
    withFilter(q: (A) -> bool) -> FilteredTreeSet[A] = FilteredTreeSet(set, x -> p(x) && q(x))

    // Calls `f` with each element that passes the test.
    foreach(f: (A) -> unit)
        for x in set
            if p(x) then f(x)

// Two tree sets visit equal elements in the same order, so they are compared element by element in
// step.
impl[A] Eq for TreeSet[A]
    equals(other: TreeSet[A]) -> bool
        if size() != other.size() then return false
        val theirs = other.iterator()
        for x in self
            if x != theirs.next() then return false
        true

// The sum a `HashSet` of the same elements hashes to, so that the hash does not depend on the order
// the elements are visited in.
impl[A: Hash] Hash for TreeSet[A]
    hash() -> long
        var h: long = 0
        for x in self do h = h +% spreadHash(x.hash())
        h

// A tree set displays as a set does, `{1, 2, 3}`, in ascending order. A field width pads the whole.
impl[A: Display] Display for TreeSet[A]
    display(out: Writer, spec: FormatSpec)
        writeElement(w: Writer, x: A) = x.display(w, FormatSpec())
        writeBraced(out, spec, iterator(), writeElement)

// A tree set's diagnostic form is its elements' diagnostic forms in braces: `{"a", "b"}`.
impl[A: Debug] Debug for TreeSet[A]
    debug(out: Writer, spec: FormatSpec)
        writeElement(w: Writer, x: A) = x.debug(w, FormatSpec())
        writeBraced(out, spec, iterator(), writeElement)

object TreeSet
    // A tree set with no elements.
    empty[A: Ord]() -> TreeSet[A] = TreeSet(Tip)

    // A tree set of the elements given, each equal one once: `TreeSet(3, 1, 2)`.
    apply[A: Ord](elements: A*) -> TreeSet[A]
        var t: SortedTree[A, unit] = Tip
        for x in elements do t = treeInsert(t, x, ())
        TreeSet(t)

    // A builder of a tree set: the elements it is given, each held once. It is typed as a `Builder`
    // of tree sets, so a literal where a `TreeSet[A]` is expected gives the call its `A`, which must
    // be known there to be held to its bound.
    builder[A: Ord]() -> Builder[A, TreeSet[A]] = TreeSetBuilder[A]()

// Builds a tree set from elements, an element added twice held once.
class TreeSetBuilder[A: Ord]: Builder[A, TreeSet[A]]
    private var tree: SortedTree[A, unit] = Tip
    private var spent = false

    override add(element: A)
        if spent then fail("add to a builder whose result was taken")
        tree = treeInsert(tree, element, ())

    override result() -> TreeSet[A]
        if spent then fail("result of a builder whose result was taken")
        spent = true
        TreeSet(tree)
