module avin

// The cell a local `lazy val` is kept in. The compiler makes one where the value is declared and
// stores the lambda computing it in the field's initializer slot, so the field's first read runs that
// lambda, once whichever threads read it, and a closure that captures the value shares its cell. The
// initializer written here is never the one that runs: no program makes a cell itself.
private class LazyCell[T]
  lazy val value: T = fail("a local `lazy val`'s cell is made only for the value it holds")
