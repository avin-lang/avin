module avin

// `==` is `Eq`'s `equals`, and `!=` its negation. Every type conforms to `Eq` and to `Hash` without
// declaring it: built-in types, strings, tuples and `data` types compare and hash by value, field by
// field; class instances, objects and closures by identity. A type that implements `Eq` in an impl,
// or in a class's header, compares by its own `equals` instead, and then implements `Hash` too, so
// that equal values keep equal hashes.

trait Eq
    equals(other: Self) -> bool

trait Hash
    hash() -> long

// `derives Eq, Hash` on a class: equal where every constructor parameter is, each by its own
// `equals`, and hashed from the same fields, each hash folded into the last's, multiplying by 31 and
// adding, wrapping on overflow, so equal instances hash alike. A data type already compares and
// hashes by its fields, so it takes neither.

derive Eq for T
    equals(other: T) -> bool = T.walkPair(self, other, equalSoFar).same

derive Hash for T
    hash() -> long = T.walk(self, hashFrom).h

// Whether the fields walked so far are all equal. The two answers are made once, so comparing
// allocates nothing.
private data EqualFields(same: bool)

private val equalSoFar = EqualFields(true)

private val unequal = EqualFields(false)

impl ShapePairVisitor for EqualFields
    variants(a: VariantShape, b: VariantShape) -> EqualFields = if a.index == b.index then self else unequal

impl EqualFields
    field[F: Eq](f: FieldShape, a: F, b: F) -> EqualFields = if !same || a.equals(b) then self else unequal

// The hash of the fields walked so far, starting from the variant's position.
private data HashFields(h: long)

private val hashFrom = HashFields(0)

impl ShapeVisitor for HashFields
    variant(v: VariantShape) -> HashFields = if v.index == 0 then self else HashFields(long(v.index))

impl HashFields
    field[F: Hash](f: FieldShape, value: F) -> HashFields = HashFields(h *% 31 +% value.hash())
