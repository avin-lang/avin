module avin

// `==` is `Eq`'s `equals`, and `!=` its negation. Every type conforms to `Eq` and to `Hash` without
// declaring it: built-in types, strings, tuples and `data` types compare and hash by value, field by
// field; class instances, objects and closures by identity. A type that implements `Eq` in an impl,
// or in a class's header, compares by its own `equals` instead, and then implements `Hash` too, so
// that equal values keep equal hashes.

trait Eq
    equals(other: Self) -> bool

trait Hash
    hash() -> long
