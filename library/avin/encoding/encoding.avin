module avin.encoding

// Bytes written as text and text read back as bytes, as RFC 4648 defines them: hexadecimal, base64
// with its `=` padding, base64url, the URL- and filename-safe alphabet written without padding, and
// base32, written padded, unpadded or in lower case; and quoted-printable, as RFC 2045 defines it for
// a mail body (below `toQuotedPrintable`).
//
//     println(toBase64("hello"))
//     println(fromBase64("aGVsbG8="))
//
// Text is encoded as its UTF-8 bytes. Encoding never fails. Decoding answers the bytes, or a
// `DecodeError` naming the byte offset in the text of what is wrong, and it is strict: whitespace,
// line breaks, the other alphabet's characters, a missing or misplaced `=`, and a last character
// with bits set that no bytes would set are all refused. So each byte sequence has exactly one
// encoding, and two different texts never decode to the same bytes.

// Why text is not the encoding of any bytes. `at` is a byte offset in the text.
data DecodeError
  // A character the encoding does not use, at `at`: a space, a line break, a character of the other
  // base64 alphabet, or one beyond ASCII.
  BadCharacter(at: int)
  // An `=` where padding cannot stand, at `at`: before the last two characters, followed by a
  // character that is not `=`, or anywhere in base64url, which is written without it.
  BadPadding(at: int)
  // The text ends inside a unit: an odd number of hexadecimal digits, base64 whose length is not a
  // multiple of four, or base64url one character past a multiple of four. `at` is the text's length,
  // where the missing characters would begin.
  Truncated(at: int)
  // The last character of the data, at `at`, sets bits below the last whole byte, which an encoder
  // always leaves zero.
  UnusedBits(at: int)

impl Error for DecodeError
  // A sentence saying what is wrong and where, for a message to a person.
  message -> string = self match
    BadCharacter(at) -> s"not a character of the encoding at index $at"
    BadPadding(at) -> s"padding not allowed at index $at"
    Truncated(at) -> s"the text ends inside a unit at index $at"
    UnusedBits(at) -> s"unused bits set at index $at"

// The lower-case hexadecimal digit of `n`, from 0 to 15, as its code.
private hexDigit(n: int) -> byte
hexDigit(n < 10) = byte(int('0') + n)
hexDigit(n) = byte(int('a') + n - 10)

// The value of the hexadecimal digit whose code is `c`, either case, or -1 for any other character.
private hexValue(c: int) -> int
hexValue(c)
  | int('0') <= c <= int('9') = c - int('0')
  | int('a') <= c <= int('f') = c - int('a') + 10
  | int('A') <= c <= int('F') = c - int('A') + 10
  | _ = -1

// ASCII codes as a string. Every byte an encoder writes is ASCII, so they are always UTF-8.
private ascii(codes: Array[byte]) -> string = string.fromUtf8Lossy(codes)

// `bytes` as lower-case hexadecimal text, two digits for each byte.
toHex(bytes: Vector[byte]) -> string = hexOf(bytes.toArray())

// The UTF-8 bytes of `text` as lower-case hexadecimal text.
toHex(text: string) -> string = hexOf(text.utf8)

private hexOf(bytes: Array[byte]) -> string
  val out = Array.fill(bytes.length * 2, byte(0))
  for i in 0 ..< bytes.length
    val v = int(bytes(i))
    out(2 * i) = hexDigit(v >> 4)
    out(2 * i + 1) = hexDigit(v & 15)
  ascii(out)

// The bytes hexadecimal `text` spells, two digits a byte, upper or lower case; an empty text is no
// bytes.
fromHex(text: string) -> Result[Vector[byte], DecodeError]
  val codes = text.utf8
  val n = codes.length
  for i in 0 ..< n
    if hexValue(int(codes(i))) < 0 then return Err(BadCharacter(i))
  if n % 2 != 0 then return Err(Truncated(n))
  Ok(Vector.tabulate(n / 2, i -> byte(hexValue(int(codes(2 * i))) * 16 + hexValue(int(codes(2 * i + 1))))))

// The code of the base64 digit of the six-bit value `v`, in the standard alphabet or, for `url`, the
// URL-safe one; they differ only in the last two.
private digit(v: int, url: bool) -> byte
digit(v < 26, _) = byte(int('A') + v)
digit(v < 52, _) = byte(int('a') + v - 26)
digit(v < 62, _) = byte(int('0') + v - 52)
digit(62, url) = byte(int(if url then '-' else '+'))
digit(_, url) = byte(int(if url then '_' else '/'))

// The six-bit value of the base64 digit whose code is `c`, in the standard alphabet or, for `url`,
// the URL-safe one; -1 for a character the alphabet does not have.
private sextet(c: int, url: bool) -> int
sextet(c, url)
  | int('A') <= c <= int('Z') = c - int('A')
  | int('a') <= c <= int('z') = c - int('a') + 26
  | int('0') <= c <= int('9') = c - int('0') + 52
  | c == int(if url then '-' else '+') = 62
  | c == int(if url then '_' else '/') = 63
  | _ = -1

// `bytes` in base64: each three bytes four digits, and a last one or two bytes two or three digits,
// padded with `=` to four unless `url`.
private encode64(bytes: Array[byte], url: bool) -> string
  val n = bytes.length
  val rest = n % 3
  val tail = if rest == 0 then 0 else if url then rest + 1 else 4
  val out = Array.fill(n / 3 * 4 + tail, byte(int('=')))
  var i = 0
  var o = 0
  while i + 3 <= n
    val v = (int(bytes(i)) << 16) | (int(bytes(i + 1)) << 8) | int(bytes(i + 2))
    out(o) = digit(v >> 18, url)
    out(o + 1) = digit((v >> 12) & 63, url)
    out(o + 2) = digit((v >> 6) & 63, url)
    out(o + 3) = digit(v & 63, url)
    i += 3
    o += 4
  if rest > 0
    val v = (int(bytes(i)) << 16) | (if rest == 2 then int(bytes(i + 1)) << 8 else 0)
    out(o) = digit(v >> 18, url)
    out(o + 1) = digit((v >> 12) & 63, url)
    if rest == 2 then out(o + 2) = digit((v >> 6) & 63, url)
  ascii(out)

// The bytes base64 `codes` spell: the standard alphabet with its padding, or for `url` the URL-safe
// one with none. The characters are checked first, in order, then the padding, then the length, then
// the last digit's unused bits.
private decode64(codes: Array[byte], url: bool) -> Result[Vector[byte], DecodeError]
  val n = codes.length
  var end = n
  for i in 0 ..< n
    val c = int(codes(i))
    if c == int('=')
      if url then return Err(BadPadding(i))
      if end == n then end = i
    elif sextet(c, url) < 0 then return Err(BadCharacter(i))
    elif end < n then return Err(BadPadding(end))
  if n - end > 2 then return Err(BadPadding(end))
  if !url && n % 4 != 0 then return Err(Truncated(n))
  if end % 4 == 1 then return Err(Truncated(n))
  val out = Array.fill(end / 4 * 3 + end % 4 * 3 / 4, byte(0))
  var acc = 0
  var bits = 0
  var w = 0
  for i in 0 ..< end
    acc = ((acc << 6) | sextet(int(codes(i)), url)) & 0xFFFF
    bits += 6
    if bits >= 8
      bits -= 8
      out(w) = byte((acc >> bits) & 255)
      w += 1
  if (acc & ((1 << bits) - 1)) != 0 then return Err(UnusedBits(end - 1))
  Ok(out.toVector)

// `bytes` in base64 with the standard alphabet (`A`–`Z`, `a`–`z`, `0`–`9`, `+`, `/`), padded with `=`
// to a multiple of four characters.
toBase64(bytes: Vector[byte]) -> string = encode64(bytes.toArray(), false)

// The UTF-8 bytes of `text` in base64.
toBase64(text: string) -> string = encode64(text.utf8, false)

// The bytes padded, standard base64 `text` spells; an empty text is no bytes.
fromBase64(text: string) -> Result[Vector[byte], DecodeError] = decode64(text.utf8, false)

// `bytes` in base64url: the URL- and filename-safe alphabet (`-` and `_` in place of `+` and `/`),
// with no padding.
toBase64Url(bytes: Vector[byte]) -> string = encode64(bytes.toArray(), true)

// The UTF-8 bytes of `text` in base64url.
toBase64Url(text: string) -> string = encode64(text.utf8, true)

// The bytes unpadded base64url `text` spells; an empty text is no bytes.
fromBase64Url(text: string) -> Result[Vector[byte], DecodeError] = decode64(text.utf8, true)

// The code of the base32 digit of the five-bit value `v`: `A`–`Z` then `2`–`7`, or for `lower` `a`–`z`
// then `2`–`7`.
private digit32(v: int, lower: bool) -> byte
digit32(v < 26, lower) = byte(int(if lower then 'a' else 'A') + v)
digit32(v, _) = byte(int('2') + v - 26)

// The five-bit value of the base32 digit whose code is `c`, in either case; -1 for any other character.
private quint(c: int) -> int
quint(c)
  | int('A') <= c <= int('Z') = c - int('A')
  | int('a') <= c <= int('z') = c - int('a')
  | int('2') <= c <= int('7') = c - int('2') + 26
  | _ = -1

// `bytes` in base32: each five bytes eight digits, and a last one to four bytes two, four, five or
// seven digits, followed when `pad` by `=` up to eight.
private encode32(bytes: Array[byte], lower: bool, pad: bool) -> string
  val n = bytes.length
  val rest = n % 5
  val tail = if rest == 0 then 0 else if pad then 8 else (rest * 8 + 4) / 5
  val out = Array.fill(n / 5 * 8 + tail, byte(int('=')))
  var acc = 0
  var bits = 0
  var o = 0
  for i in 0 ..< n
    acc = ((acc << 8) | int(bytes(i))) & 0xFFF
    bits += 8
    while bits >= 5
      bits -= 5
      out(o) = digit32((acc >> bits) & 31, lower)
      o += 1
  if bits > 0 then out(o) = digit32((acc << (5 - bits)) & 31, lower)
  ascii(out)

// The bytes base32 `codes` spell, either case, with or without padding. The characters are checked
// first, in order, then the padding, then the length, then the last digit's unused bits.
private decode32(codes: Array[byte]) -> Result[Vector[byte], DecodeError]
  val n = codes.length
  var end = n
  for i in 0 ..< n
    val c = int(codes(i))
    if c == int('=')
      if end == n then end = i
    elif quint(c) < 0 then return Err(BadCharacter(i))
    elif end < n then return Err(BadPadding(end))
  if n - end > 6 then return Err(BadPadding(end))
  if n != end && n % 8 != 0 then return Err(Truncated(n))
  val r = end % 8
  if r == 1 || r == 3 || r == 6 then return Err(Truncated(n))
  val out = Array.fill(end / 8 * 5 + end % 8 * 5 / 8, byte(0))
  var acc = 0
  var bits = 0
  var w = 0
  for i in 0 ..< end
    acc = ((acc << 5) | quint(int(codes(i)))) & 0xFFF
    bits += 5
    if bits >= 8
      bits -= 8
      out(w) = byte((acc >> bits) & 255)
      w += 1
  if (acc & ((1 << bits) - 1)) != 0 then return Err(UnusedBits(end - 1))
  Ok(out.toVector)

// `bytes` in base32 with RFC 4648's alphabet (`A`–`Z`, `2`–`7`), padded with `=` to a multiple of
// eight characters.
toBase32(bytes: Vector[byte]) -> string = encode32(bytes.toArray(), false, true)

// The UTF-8 bytes of `text` in base32.
toBase32(text: string) -> string = encode32(text.utf8, false, true)

// `bytes` in base32 with RFC 4648's alphabet and no padding.
toBase32Unpadded(bytes: Vector[byte]) -> string = encode32(bytes.toArray(), false, false)

// The UTF-8 bytes of `text` in unpadded base32.
toBase32Unpadded(text: string) -> string = encode32(text.utf8, false, false)

// `bytes` in base32 written in lower case (`a`–`z`, `2`–`7`) with no padding; sixteen bytes are 26
// characters.
toBase32Lower(bytes: Vector[byte]) -> string = encode32(bytes.toArray(), true, false)

// The UTF-8 bytes of `text` in lower-case unpadded base32.
toBase32Lower(text: string) -> string = encode32(text.utf8, true, false)

// The bytes base32 `text` spells: upper or lower case (also mixed), padded to a multiple of eight or
// not padded at all; an empty text is no bytes.
fromBase32(text: string) -> Result[Vector[byte], DecodeError] = decode32(text.utf8)

// The upper-case hexadecimal digit of `n`, from 0 to 15, as its code.
private upperDigit(n: int) -> byte
upperDigit(n < 10) = byte(int('0') + n)
upperDigit(n) = byte(int('A') + n - 10)

// Whether `codes` hold a CR LF line break at `i`.
private breakAt(codes: Array[byte], i: int) -> bool =
  i + 1 < codes.length && int(codes(i)) == 13 && int(codes(i + 1)) == 10

// `bytes` in quoted-printable, as `toQuotedPrintable` says, a soft break never inside an `=XX`.
private encodeQp(bytes: Array[byte]) -> string
  val n = bytes.length
  val out = Buffer[byte]()
  var column = 0
  var i = 0
  while i < n
    if breakAt(bytes, i)
      out += byte(13)
      out += byte(10)
      column = 0
      i += 2
    else
      val b = int(bytes(i))
      val lineEnd = i + 1 == n || breakAt(bytes, i + 1)
      val plain = (33 <= b <= 126 && b != int('=')) || ((b == 32 || b == 9) && !lineEnd)
      val width = if plain then 1 else 3
      // The last character of a line may fill it; any other leaves room for a soft break's `=`.
      if column + width > (if lineEnd then 76 else 75)
        out += byte(int('='))
        out += byte(13)
        out += byte(10)
        column = 0
      if plain
        out += bytes(i)
      else
        out += byte(int('='))
        out += upperDigit(b >> 4)
        out += upperDigit(b & 15)
      column += width
      i += 1
  ascii(out.toArray())

// `bytes` in quoted-printable (RFC 2045 § 6.7), for a mail body: a CR LF in them is a line break of
// the text, written as one; printable ASCII but `=` is written as itself, a space or tab too except
// at the end of a line; every other byte, a lone CR or LF included, is written `=XX` with upper-case
// digits; and lines are broken with a soft break, `=` CR LF, so that none is longer than 76
// characters. Every character of the result is ASCII.
toQuotedPrintable(bytes: Vector[byte]) -> string = encodeQp(bytes.toArray())

// The UTF-8 bytes of `text` in quoted-printable.
toQuotedPrintable(text: string) -> string = encodeQp(text.utf8)

// Whether the code is a space or a tab.
private blank(c: int) -> bool = c == 32 || c == 9

// The bytes quoted-printable `text` spells, read as RFC 2045 § 6.7 says a decoder reads them: `=XX`
// is the byte with those hexadecimal digits (either case); `=` followed by spaces or tabs and then a
// line break (CR LF or LF alone) or the end of the text is a soft break and stands for nothing; spaces
// and tabs just before a line break or the end are dropped, being what a mail relay may have added;
// every other character is itself. An `=` followed by anything else is `BadCharacter` at the `=`, and
// one with a single digit before the end is `Truncated`.
fromQuotedPrintable(text: string) -> Result[Vector[byte], DecodeError]
  val codes = text.utf8
  val n = codes.length
  val out = Buffer[byte]()
  var i = 0
  while i < n
    val c = int(codes(i))
    if c == int('=')
      var j = i + 1
      while j < n && blank(int(codes(j))) do j += 1
      if j == n then i = n
      elif breakAt(codes, j) then i = j + 2
      elif int(codes(j)) == 10 then i = j + 1
      elif j > i + 1 then return Err(BadCharacter(i))
      elif i + 2 >= n then return Err(if hexValue(int(codes(i + 1))) < 0 then BadCharacter(i) else Truncated(n))
      else
        val hi = hexValue(int(codes(i + 1)))
        val lo = hexValue(int(codes(i + 2)))
        if hi < 0 || lo < 0 then return Err(BadCharacter(i))
        out += byte(hi * 16 + lo)
        i += 3
    elif blank(c)
      var j = i
      while j < n && blank(int(codes(j))) do j += 1
      val trailing = j == n || breakAt(codes, j) || int(codes(j)) == 10
      if !trailing
        for k in i ..< j do out += codes(k)
      i = j
    else
      out += codes(i)
      i += 1
  Ok(out.toVector)
