module avin

// The extractor traits. A pattern `Name(p1, p2)` whose `Name` is not a variant names a value, an
// object, a companion or a local, whose type implements one of them; the trait decides what the
// pattern means, and its method is called with the matched value:
//
//     object Twice: Extractor[int, int]
//       override unapply(n: int) -> Option[int] = if n % 2 == 0 then Some(n / 2) else None
//
//     n match
//       Twice(half) -> half
//       _ -> n
//
// A method merely named `unapply` makes no extractor: the conformance does. A type implements each
// trait at one type argument, and where it implements an `unapply` trait and `SeqExtractor` both,
// the `unapply` one serves.

// An extractor of a value: `unapply` answers `Some` of what it takes out of `value`, matched by one
// pattern whole, or by several as the parts of a tuple, `Split(key, value)` for an
// `Extractor[string, (string, string)]`; `None` where the pattern does not match.
trait Extractor[-A, +B]
  unapply(value: A) -> Option[B]

// An extractor that only tests: the pattern, written with no patterns inside, `Even()`, matches where
// `unapply` answers `true`.
trait BoolExtractor[-A]
  unapply(value: A) -> bool

// An extractor of a sequence: `unapplySeq` answers `Some` of a sequence, a `List`, a `Vector` or any
// other, whose elements the patterns match as a sequence pattern does, `rest*` included; `None` where
// the pattern does not match.
trait SeqExtractor[-A, +S]
  unapplySeq(value: A) -> Option[S]
