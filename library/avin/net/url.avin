module avin.net

// URLs, read as RFC 3986 reads a URI: a scheme, an authority of user information, host and port, a
// path, a query and a fragment. Each component is kept as it was written, percent-escapes and all;
// `Url.decode` turns one into text. A component may also hold characters beyond ASCII, which are kept
// as they are. An absent component and an empty one are different things: `http://h?` has an empty
// query and `http://h` none.

// Why text is not a URL, or not a component of one. `at` is the byte offset, in the text that was
// read, of the first character found to be wrong.
data UrlError
    // The text does not begin with a scheme and a colon: it is a relative reference, or begins with
    // the colon.
    MissingScheme
    // A character a scheme may not hold: a scheme is a letter and then letters, digits, `+`, `-` and
    // `.`.
    BadScheme(at: int)
    // A character no URL may hold where it stands, such as a space, or a `#` in a fragment.
    BadCharacter(at: int)
    // A `%` that is not followed by two hexadecimal digits.
    BadPercent(at: int)
    // A host in brackets that is neither an IPv6 address, with an optional zone, nor an address of a
    // later form (`v` and a version); or a bracket outside one.
    BadHost(at: int)
    // A port that is not decimal digits, or is above 65535.
    BadPort(at: int)
    // Percent-escapes whose bytes are not UTF-8; `at` is the `%` beginning the sequence that is not.
    InvalidUtf8(at: int)

impl UrlError
    // A sentence saying what is wrong and where, for a message to a person.
    message() -> string = self match
        MissingScheme -> "no scheme"
        BadScheme(at) -> s"not a scheme character at index $at"
        BadCharacter(at) -> s"character not allowed at index $at"
        BadPercent(at) -> s"malformed percent-escape at index $at"
        BadHost(at) -> s"malformed host at index $at"
        BadPort(at) -> s"malformed port at index $at"
        InvalidUtf8(at) -> s"percent-escapes not UTF-8 at index $at"

impl Display for UrlError
    display(out: Writer, spec: FormatSpec) = out.writeField(message(), spec)

// An absolute URL. `host` is `None` where the URL has no authority (`mailto:a@b`) and `Some("")`
// where the authority is empty (`file:///etc`); an IPv6 host keeps its brackets. The scheme and host
// are held in lower case, and a port that is the scheme's default is held as `None`, so two URLs that
// differ only in those are equal, and a `Url` displays as the text it was read from with exactly those
// differences.
data Url(scheme: string, userInfo: Option[string], host: Option[string], port: Option[int], path: string, query: Option[string], fragment: Option[string])

impl Url
    // The port, or where none is written, the scheme's default: 80 for `http` and `ws`, 443 for
    // `https` and `wss`.
    portOrDefault() -> Option[int] = port.orElse(defaultPort(scheme))

    // The query's pairs, decoded, in order: the query is split at each `&`, an empty piece skipped, and
    // each piece at its first `=` into a name and a value, empty where there is no `=`. A `+` stands
    // for a space, as a form writes one. No query gives no pairs.
    queryParams() -> Vector[(string, string)]
        val pairs = Buffer[(string, string)]()
        query match
            Some(q) ->
                for piece in q.split("&")
                    if piece.nonEmpty()
                        val eq = piece.indexOf("=")
                        if eq < 0
                            pairs.addOne((formDecoded(piece), ""))
                        else
                            pairs.addOne((formDecoded(piece.slice(0, eq)), formDecoded(rest(piece, eq + 1))))
            None -> ()
        pairs.toVector

    // `ref` resolved against this URL as RFC 3986 resolves a reference against a base: the reference
    // read, relative or absolute, then its missing components taken from the base and its dot
    // segments removed. A reference that cannot be read is the error.
    resolve(ref: string) -> Result[Url, UrlError]
        val r = parseReference(ref)?
        Ok(resolved(self, r))

    // `ref`, which is already absolute, with its dot segments removed.
    resolve(ref: Url) -> Url = resolved(self, Reference(Some(ref.scheme), ref.userInfo, ref.host, ref.port, ref.path, ref.query, ref.fragment))

    // The URL with another scheme, held in lower case. A scheme that is not one traps.
    withScheme(s: string) -> Url
        if s.isEmpty() then fail("no scheme")
        checked(s, checkScheme(s))
        made(s, userInfo, host, port, path, query, fragment)

    // The URL with user information, as written with its escapes, or with none. User information
    // where there is no host, or one with a character it may not hold, traps.
    withUserInfo(u: Option[string]) -> Url
        u match
            Some(t) ->
                if host.isEmpty() then fail("user information without a host")
                checked(t, checkComponent(t, 0, t.byteLength(), UserInfoPart))
                checked(t, decodeRange(t, 0, t.byteLength(), false).map(d -> ()))
            None -> ()
        made(scheme, u, host, port, path, query, fragment)

    withUserInfo(u: string) -> Url = withUserInfo(Some(u))

    // The URL with another host, as written with its escapes or in brackets, or with none, which takes
    // the authority away. Taking it away while there is user information or a port traps, as does a
    // host that is not one, a path not beginning with `/` given an authority, or a path beginning with
    // `//` left without one.
    withHost(h: Option[string]) -> Url
        h match
            Some(t) ->
                checked(t, checkHost(t, 0, t.byteLength()))
                if path.nonEmpty() && !path.startsWith("/") then fail("a path beside an authority must begin with /")
            None ->
                if userInfo.isDefined() || port.isDefined() then fail("user information or a port without a host")
                if path.startsWith("//") then fail("a path without an authority may not begin with //")
        made(scheme, userInfo, h, port, path, query, fragment)

    withHost(h: string) -> Url = withHost(Some(h))

    // The URL with another port, or none. A port outside 0 to 65535, or one where there is no host,
    // traps.
    withPort(p: Option[int]) -> Url
        p match
            Some(n) ->
                if n < 0 || n > 65535 then fail(s"port out of range: $n")
                if host.isEmpty() then fail("a port without a host")
            None -> ()
        made(scheme, userInfo, host, p, path, query, fragment)

    withPort(p: int) -> Url = withPort(Some(p))

    // The URL with another path, as written with its escapes. Beside a host the path must be empty or
    // begin with `/`, and without one it may not begin with `//`; a path that breaks either, or holds a
    // character it may not, traps.
    withPath(p: string) -> Url
        checked(p, checkComponent(p, 0, p.byteLength(), PathPart))
        checked(p, decodeRange(p, 0, p.byteLength(), false).map(d -> ()))
        if host.isDefined() && p.nonEmpty() && !p.startsWith("/") then fail("a path beside an authority must begin with /")
        if host.isEmpty() && p.startsWith("//") then fail("a path without an authority may not begin with //")
        made(scheme, userInfo, host, port, p, query, fragment)

    // The URL with another query, as written with its escapes, or with none.
    withQuery(q: Option[string]) -> Url
        q match
            Some(t) ->
                checked(t, checkComponent(t, 0, t.byteLength(), QueryPart))
                checked(t, decodeRange(t, 0, t.byteLength(), false).map(d -> ()))
            None -> ()
        made(scheme, userInfo, host, port, path, q, fragment)

    withQuery(q: string) -> Url = withQuery(Some(q))

    // The URL with another fragment, as written with its escapes, or with none.
    withFragment(f: Option[string]) -> Url
        f match
            Some(t) ->
                checked(t, checkComponent(t, 0, t.byteLength(), QueryPart))
                checked(t, decodeRange(t, 0, t.byteLength(), false).map(d -> ()))
            None -> ()
        made(scheme, userInfo, host, port, path, query, f)

    withFragment(f: string) -> Url = withFragment(Some(f))

    // The URL written out: `scheme:`, then `//`, the user information and `@`, the host and `:port`
    // where there is an authority, then the path, `?query` and `#fragment`.
    private written() -> string
        val out = StringWriter()
        out.write(scheme)
        out.write(":")
        host match
            Some(h) ->
                out.write("//")
                userInfo match
                    Some(u) ->
                        out.write(u)
                        out.write("@")
                    None -> ()
                out.write(h)
                port match
                    Some(p) ->
                        out.write(":")
                        out.write(p.toString())
                    None -> ()
            None -> ()
        out.write(path)
        query match
            Some(q) ->
                out.write("?")
                out.write(q)
            None -> ()
        fragment match
            Some(f) ->
                out.write("#")
                out.write(f)
            None -> ()
        out.text()

impl Display for Url
    display(out: Writer, spec: FormatSpec) = out.writeField(written(), spec)

object Url
    // The text read as a URL; text that is not one traps with the error's message and the text.
    apply(text: string) -> Url = Url.parse(text) match
        Ok(u) -> u
        Err(e) -> fail(s"${e.message()}: $text")

    // The text read as a URL, or what is wrong with it. The text must begin with a scheme; each
    // component's percent-escapes must decode to UTF-8.
    parse(text: string) -> Result[Url, UrlError]
        val r = parseReference(text)?
        r.scheme match
            Some(s) -> Ok(made(s, r.userInfo, r.host, r.port, r.path, r.query, r.fragment))
            None -> Err(MissingScheme)

    // `text` with every byte of its UTF-8 encoding other than a letter, a digit, `-`, `.`, `_` and `~`
    // written as `%` and two upper-case hexadecimal digits, so that it can stand as any component.
    encode(text: string) -> string
        val out = StringWriter()
        val n = text.byteLength()
        var plain = 0
        for i in 0 ..< n
            val b = code(text, i)
            if !isUnreserved(b)
                if plain < i then out.write(text.slice(plain, i))
                out.write("%")
                out.write(hexDigit(b >> 4))
                out.write(hexDigit(b & 15))
                plain = i + 1
        out.write(text.slice(plain, n))
        out.text()

    // `text` with each percent-escape replaced by the byte it names, read as UTF-8; every other
    // character is kept, `+` included.
    decode(text: string) -> Result[string, UrlError] = decodeRange(text, 0, text.byteLength(), false)

// A reference as it was read: an absolute URL's components, with the scheme absent from a relative
// one.
private data Reference(scheme: Option[string], userInfo: Option[string], host: Option[string], port: Option[int], path: string, query: Option[string], fragment: Option[string])

// A URL with its scheme and host in lower case and a default port left out.
private made(scheme: string, userInfo: Option[string], host: Option[string], port: Option[int], path: string, query: Option[string], fragment: Option[string]) -> Url
    val s = asciiLower(scheme)
    val p = if port.isDefined() && port == defaultPort(s) then None else port
    Url(s, userInfo, host.map(h -> lowerHost(h)), p, path, query, fragment)

// The port a scheme is reached at when its URL names none.
private defaultPort(scheme: string) -> Option[int] = scheme match
    "http" -> Some(80)
    "ws" -> Some(80)
    "https" -> Some(443)
    "wss" -> Some(443)
    _ -> None

// Traps with the error's message and the text it was found in.
private checked(text: string, r: Result[unit, UrlError])
    r match
        Ok(_) -> ()
        Err(e) -> fail(s"${e.message()}: $text")

// The kinds of component, each allowing its own characters as they are beside percent-escapes and
// characters beyond ASCII.
private data Part
    UserInfoPart
    HostPart
    PathPart
    QueryPart

// Whether the ASCII byte `b` may stand as it is in a component of the kind `part`.
private allowedIn(part: Part, b: int) -> bool
    if isUnreserved(b) || isSubDelim(b) then return true
    part match
        UserInfoPart -> b == int(':')
        HostPart -> false
        PathPart -> b == int(':') || b == int('@') || b == int('/')
        QueryPart -> b == int(':') || b == int('@') || b == int('/') || b == int('?')

// Reads text as a reference: `scheme:` where the text begins with one, `//` and an authority, the
// path up to `?` or `#`, the query up to `#`, and the fragment.
private parseReference(text: string) -> Result[Reference, UrlError]
    val n = text.byteLength()
    var i = 0
    var scheme: Option[string] = None
    val colon = schemeColon(text)
    if colon == 0 then return Err(MissingScheme)
    if colon > 0
        checkScheme(text.slice(0, colon))?
        scheme = Some(text.slice(0, colon))
        i = colon + 1
    var userInfo: Option[string] = None
    var host: Option[string] = None
    var port: Option[int] = None
    if text.startsWith("//", i)
        val start = i + 2
        var end = start
        while end < n && !isDelimiter(code(text, end)) do end += 1
        var hostStart = start
        val at = text.indexOf("@", start)
        if 0 <= at < end
            checkComponent(text, start, at, UserInfoPart)?
            decodeRange(text, start, at, false)?
            userInfo = Some(text.slice(start, at))
            hostStart = at + 1
        var hostEnd = hostStart
        if hostStart < end && code(text, hostStart) == int('[')
            val close = text.indexOf("]", hostStart)
            if close < 0 || close >= end then return Err(BadHost(hostStart))
            hostEnd = close + 1
        else
            while hostEnd < end && code(text, hostEnd) != int(':') do hostEnd += 1
        checkHost(text, hostStart, hostEnd)?
        host = Some(text.slice(hostStart, hostEnd))
        if hostEnd < end
            if code(text, hostEnd) != int(':') then return Err(BadHost(hostEnd))
            port = readPort(text, hostEnd + 1, end)?
        i = end
    var pathEnd = i
    while pathEnd < n && code(text, pathEnd) != int('?') && code(text, pathEnd) != int('#') do pathEnd += 1
    checkComponent(text, i, pathEnd, PathPart)?
    decodeRange(text, i, pathEnd, false)?
    val path = text.slice(i, pathEnd)
    i = pathEnd
    var query: Option[string] = None
    if i < n && code(text, i) == int('?')
        var queryEnd = i + 1
        while queryEnd < n && code(text, queryEnd) != int('#') do queryEnd += 1
        checkComponent(text, i + 1, queryEnd, QueryPart)?
        decodeRange(text, i + 1, queryEnd, false)?
        query = Some(text.slice(i + 1, queryEnd))
        i = queryEnd
    var fragment: Option[string] = None
    if i < n
        checkComponent(text, i + 1, n, QueryPart)?
        decodeRange(text, i + 1, n, false)?
        fragment = Some(rest(text, i + 1))
    Ok(Reference(scheme, userInfo, host, port, path, query, fragment))

// The offset of the colon ending a scheme: the first `:` before any `/`, `?` or `#`, or -1 where there
// is none, so the text is a relative reference.
private schemeColon(text: string) -> int
    for i in 0 ..< text.byteLength()
        val b = code(text, i)
        if b == int(':') then return i
        if isDelimiter(b) then return -1
    -1

// Whether `b` ends an authority: `/`, `?` or `#`.
private isDelimiter(b: int) -> bool = b == int('/') || b == int('?') || b == int('#')

// Whether `s` is a scheme: a letter, then letters, digits, `+`, `-` and `.`.
private checkScheme(s: string) -> Result[unit, UrlError]
    for i in 0 ..< s.byteLength()
        val b = code(s, i)
        val ok = isAlpha(b) || (i > 0 && (isDigit(b) || b == int('+') || b == int('-') || b == int('.')))
        if !ok then return Err(BadScheme(i))
    Ok(())

// The port written from `from` up to `until`: `None` for no digits, otherwise a number up to 65535.
private readPort(text: string, from: int, until: int) -> Result[Option[int], UrlError]
    if from == until then return Ok(None)
    var value = 0
    for i in from ..< until
        val b = code(text, i)
        if !isDigit(b) then return Err(BadPort(i))
        value = value * 10 + (b - int('0'))
        if value > 65535 then return Err(BadPort(from))
    Ok(Some(value))

// Whether the text from `from` up to `until` is a host: an address in brackets, or a name of
// unreserved characters, sub-delimiters and percent-escapes, an IPv4 address being one.
private checkHost(text: string, from: int, until: int) -> Result[unit, UrlError]
    if from < until && code(text, from) == int('[')
        if code(text, until - 1) != int(']') || !isBracketed(text.slice(from + 1, until - 1)) then return Err(BadHost(from))
        return Ok(())
    for i in from ..< until
        val b = code(text, i)
        if b == int('[') || b == int(']') then return Err(BadHost(i))
    checkComponent(text, from, until, HostPart)?
    decodeRange(text, from, until, false)?
    Ok(())

// Whether the text between a host's brackets is an IPv6 address with an optional zone (`%25` and the
// zone's name), or an address of a later form: `v`, a hexadecimal version, `.` and the address.
private isBracketed(inside: string) -> bool
    val n = inside.byteLength()
    if n == 0 then return false
    val first = code(inside, 0)
    if first == int('v') || first == int('V')
        val dot = inside.indexOf(".")
        if dot < 2 || dot == n - 1 then return false
        for i in 1 ..< dot
            if !isHex(code(inside, i)) then return false
        for i in dot + 1 ..< n
            val b = code(inside, i)
            if !isUnreserved(b) && !isSubDelim(b) && b != int(':') then return false
        return true
    val percent = inside.indexOf("%")
    if percent < 0 then return isIpv6(inside)
    if !inside.startsWith("%25", percent) || percent + 3 == n then return false
    if !isIpv6(inside.slice(0, percent)) then return false
    for i in percent + 3 ..< n
        val b = code(inside, i)
        if !isUnreserved(b) && b != int('%') then return false
    checkComponent(inside, percent + 3, n, HostPart).isOk()

// Whether `s` is an IPv6 address: eight groups of one to four hexadecimal digits separated by `:`,
// the last two of which may be an IPv4 address, with one run of groups that are zero written `::`.
private isIpv6(s: string) -> bool
    val gap = s.indexOf("::")
    if gap < 0 then return groupCount(s, true) == 8
    if s.indexOf("::", gap + 1) >= 0 then return false
    val before = groupCount(s.slice(0, gap), false)
    val after = groupCount(rest(s, gap + 2), true)
    before >= 0 && after >= 0 && before + after <= 7

// The number of 16-bit groups `s` writes, separated by `:`, the last of them an IPv4 address counting
// two where `last` allows one; 0 for the empty string, and -1 where `s` is not such groups.
private groupCount(s: string, last: bool) -> int
    if s.isEmpty() then return 0
    val groups = s.split(":")
    var count = 0
    var k = 0
    for g in groups
        k += 1
        if last && k == groups.length && g.contains(".")
            if !isIpv4(g) then return -1
            count += 2
        else
            if g.isEmpty() || g.byteLength() > 4 then return -1
            for i in 0 ..< g.byteLength()
                if !isHex(code(g, i)) then return -1
            count += 1
    count

// Whether `s` is an IPv4 address in dotted decimal: four numbers up to 255, without leading zeros.
private isIpv4(s: string) -> bool
    val parts = s.split(".")
    if parts.length != 4 then return false
    for p in parts
        if p.isEmpty() || p.byteLength() > 3 || (p.byteLength() > 1 && p.startsWith("0")) then return false
        for i in 0 ..< p.byteLength()
            if !isDigit(code(p, i)) then return false
        if p.toInt() > 255 then return false
    true

// Whether the text from `from` up to `until` may stand as a component of the kind `part`: characters
// it allows, percent-escapes, and characters beyond ASCII other than controls and spaces.
private checkComponent(text: string, from: int, until: int, part: Part) -> Result[unit, UrlError]
    var i = from
    while i < until
        val b = code(text, i)
        if b == int('%')
            if i + 2 >= until || !isHex(code(text, i + 1)) || !isHex(code(text, i + 2)) then return Err(BadPercent(i))
            i += 3
        elif b >= 0x80
            val c = text.charAt(i)
            if c.isControl() || c.isWhitespace() || c.isSpaceChar() then return Err(BadCharacter(i))
            i += charWidth(int(c))
        elif allowedIn(part, b)
            i += 1
        else
            return Err(BadCharacter(i))
    Ok(())

// The text from `from` up to `until` with its percent-escapes decoded and, where `form` asks, each `+`
// read as a space; the bytes must be UTF-8.
private decodeRange(text: string, from: int, until: int, form: bool) -> Result[string, UrlError]
    val bytes = Buffer[byte]()
    val sources = Buffer[int]()
    var i = from
    while i < until
        val b = code(text, i)
        if b == int('%')
            if i + 2 >= until then return Err(BadPercent(i))
            val high = hexValue(code(text, i + 1))
            val low = hexValue(code(text, i + 2))
            if high < 0 || low < 0 then return Err(BadPercent(i))
            bytes.addOne(byte(high * 16 + low))
            sources.addOne(i)
            i += 3
        else
            bytes.addOne(if form && b == int('+') then byte(int(' ')) else text.byteAt(i))
            sources.addOne(i)
            i += 1
    string.fromUtf8(bytes.toArray()) match
        Ok(t) -> Ok(t)
        Err(e) -> Err(InvalidUtf8(sources(int(e.offset))))

// A query piece decoded as a form writes it.
private formDecoded(piece: string) -> string = decodeRange(piece, 0, piece.byteLength(), true) match
    Ok(t) -> t
    Err(e) -> fail(s"${e.message()}: $piece")

// `r` resolved against `base` by RFC 3986's algorithm (section 5.2.2), strictly: a reference with a
// scheme keeps it even where it is the base's.
private resolved(base: Url, r: Reference) -> Url
    r.scheme match
        Some(s) -> return made(s, r.userInfo, r.host, r.port, removeDotSegments(r.path), r.query, r.fragment)
        None -> ()
    if r.host.isDefined() then return made(base.scheme, r.userInfo, r.host, r.port, removeDotSegments(r.path), r.query, r.fragment)
    if r.path.isEmpty() then return made(base.scheme, base.userInfo, base.host, base.port, base.path, r.query.orElse(base.query), r.fragment)
    val path = if r.path.startsWith("/") then removeDotSegments(r.path) else removeDotSegments(merged(base, r.path))
    made(base.scheme, base.userInfo, base.host, base.port, path, r.query, r.fragment)

// A relative path joined to the base's: after the base's last `/`, or after `/` where the base has an
// authority and an empty path.
private merged(base: Url, path: string) -> string
    if base.host.isDefined() && base.path.isEmpty() then return "/" + path
    val slash = base.path.lastIndexOf("/")
    if slash < 0 then path else base.path.slice(0, slash + 1) + path

// The path with its `.` and `..` segments taken out, each `..` with the segment before it (RFC 3986,
// section 5.2.4).
private removeDotSegments(path: string) -> string
    var input = path
    var output = ""
    while input.nonEmpty()
        if input.startsWith("../")
            input = rest(input, 3)
        elif input.startsWith("./")
            input = rest(input, 2)
        elif input.startsWith("/./")
            input = "/" + rest(input, 3)
        elif input == "/."
            input = "/"
        elif input.startsWith("/../")
            input = "/" + rest(input, 4)
            output = withoutLastSegment(output)
        elif input == "/.."
            input = "/"
            output = withoutLastSegment(output)
        elif input == "." || input == ".."
            input = ""
        else
            var end = input.indexOf("/", 1)
            if end < 0 then end = input.byteLength()
            output = output + input.slice(0, end)
            input = rest(input, end)
    output

// `s` from byte offset `from` to its end.
private rest(s: string, from: int) -> string = s.slice(from, s.byteLength())

// `s` without its last `/` and what follows it; empty where it has no `/`.
private withoutLastSegment(s: string) -> string
    val slash = s.lastIndexOf("/")
    if slash < 0 then "" else s.slice(0, slash)

// The ASCII letters of `s` in lower case; every other character as it is.
private asciiLower(s: string) -> string
    if s.indexWhere(c -> 'A' <= c <= 'Z') < 0 then return s
    val out = StringWriter()
    for c in s.chars()
        out.write((if 'A' <= c <= 'Z' then c.toLower() else c).toString())
    out.text()

// A host in lower case: a name's ASCII letters other than the digits of its percent-escapes, and an
// address in brackets up to its zone, whose name is kept as written.
private lowerHost(h: string) -> string
    if h.startsWith("[")
        val zone = h.indexOf("%25")
        return if zone < 0 then asciiLower(h) else asciiLower(h.slice(0, zone)) + rest(h, zone)
    val out = StringWriter()
    var i = 0
    var plain = 0
    while i < h.byteLength()
        if code(h, i) == int('%')
            out.write(asciiLower(h.slice(plain, i)))
            out.write(h.slice(i, i + 3))
            i += 3
            plain = i
        else
            i += 1
    out.write(asciiLower(rest(h, plain)))
    out.text()

// The byte at offset `i` of `s`, as a number.
private code(s: string, i: int) -> int = int(s.byteAt(i))

private isAlpha(b: int) -> bool = (int('a') <= b <= int('z')) || (int('A') <= b <= int('Z'))

private isDigit(b: int) -> bool = int('0') <= b <= int('9')

private isHex(b: int) -> bool = hexValue(b) >= 0

// The value of a hexadecimal digit, -1 for any other byte.
private hexValue(b: int) -> int
    if isDigit(b) then return b - int('0')
    if int('a') <= b <= int('f') then return b - int('a') + 10
    if int('A') <= b <= int('F') then return b - int('A') + 10
    -1

private hexDigit(v: int) -> string = "0123456789ABCDEF".slice(v, v + 1)

// Whether `b` is a letter, a digit, `-`, `.`, `_` or `~`, which no component escapes.
private isUnreserved(b: int) -> bool = isAlpha(b) || isDigit(b) || b == int('-') || b == int('.') || b == int('_') || b == int('~')

// Whether `b` is one of RFC 3986's sub-delimiters, `! $ & ' ( ) * + , ; =`.
private isSubDelim(b: int) -> bool = b == int('!') || b == int('$') || b == int('&') || b == int('\'') || b == int('(') || b == int(')') || b == int('*') || b == int('+') || b == int(',') || b == int(';') || b == int('=')

// The number of bytes UTF-8 takes to encode the code point `n`.
private charWidth(n: int) -> int = if n < 0x80 then 1 elif n < 0x800 then 2 elif n < 0x10000 then 3 else 4
