module avin.net

// The two halves a TCP or Unix connection's `split` divides it into. Each half holds a handle of its
// own on the connection's socket, so each belongs to its own thread, checked at every operation as
// the connection's own handle is, and the two share the descriptor: a reader parked waiting for
// bytes and a writer parked waiting for room wait on it at once, each parking only its own
// lightweight thread on the runtime's poller. The handles are counted shares of the one socket, and
// each half gives its share back when it closes, so the second to close closes the socket then, not
// when the collector frees the halves.

import avin.io
import avin.io.IoError
import avin.time.Duration

@sysl("sysl.net.Socket", named: "StreamReader")
private class ReadSocket
  // The descriptor, which a select's `readable()` arm watches: calling it also checks the half
  // belongs to the code running.
  @sysl("fd")
  held() -> Result[int, SyslError]

@sysl("sysl.net.Socket", named: "StreamWriter")
private class WriteSocket
  shutdown(how: Shutdown) -> Result[unit, SyslError]
  // The descriptor, which a select's `writable()` arm watches: calling it also checks the half
  // belongs to the code running.
  @sysl("fd")
  held() -> Result[int, SyslError]

@sysl("avin.rt.socket_share")
private readHalfOf(s: Socket) -> ReadSocket

@sysl("avin.rt.socket_share")
private writeHalfOf(s: Socket) -> WriteSocket

@sysl("avin.rt.socket_share")
private unixReadHalfOf(s: UnixSocket) -> ReadSocket

@sysl("avin.rt.socket_share")
private unixWriteHalfOf(s: UnixSocket) -> WriteSocket

@sysl("avin.rt.socket_receive")
private halfReceive(s: ReadSocket, max: int, limitMs: int) -> Result[Array[byte], SyslError]

@sysl("avin.rt.socket_readable")
private halfReadable(s: ReadSocket) -> bool

@sysl("avin.rt.socket_send_all")
private halfSendAll(s: WriteSocket, bytes: Array[byte], limitMs: int) -> Result[unit, SyslError]

@sysl("avin.rt.socket_send_some")
private halfSendSome(s: WriteSocket, bytes: Array[byte], limitMs: int) -> Result[long, SyslError]

@sysl("avin.rt.socket_writable")
private halfWritable(s: WriteSocket) -> bool

// What an operation on a connection that has been split answers.
private splitError(operation: string, subject: string) -> IoError =
  IoError(io.Other("the connection has been split into a reader and a writer"), operation, subject)

// Stops the program where a connection cannot be split: one split already, or one closed.
private unsplittable(halved: bool) -> Nothing =
  if halved then fail("a connection is split once, and this one has been split already")
  else fail("a closed connection cannot be split")

// The halves of a connection over `read` and `write`, two handles on its socket, given what it has
// read ahead and its timeout.
private halves(
    read: ReadSocket,
    write: WriteSocket,
    buffered: ReadAhead,
    limitMs: int,
    peer: string,
    other: Option[string]
) -> (StreamReader, StreamWriter)
  val r: StreamReader = SocketReader(read, buffered, false, limitMs, peer, other)
  val w: StreamWriter = SocketWriter(write, false, limitMs, peer, other)
  (r, w)

// The reading half of a TCP or Unix connection.
@trusted_sendable(
  "it belongs to one thread at a time: a send hands it over, and every operation first checks its owner, so the code that handed it over traps; what it shares with its writing half is the socket, whose counted shares the system's descriptor outlives until the last is given back"
)
private class SocketReader(
    private val conn: ReadSocket,
    private val buffered: ReadAhead,
    private var closed: bool,
    private var limitMs: int,
    private val peer: string,
    private val other: Option[string]
): Sendable, StreamReader
  override remoteAddress -> Option[string] = other

  override read(max: int) -> Result[Array[byte], IoError]
    mine()
    if closed then return Err(closedError("read from", peer))
    buffered.read(max, received)

  override readLine() -> Result[Option[string], IoError]
    mine()
    if closed then return Err(closedError("read from", peer))
    buffered.readLine(received)

  override readAll() -> Result[Array[byte], IoError]
    mine()
    if closed then return Err(closedError("read from", peer))
    buffered.readAll(received)

  override readable() -> bool
    mine()
    closed || buffered.pending || halfReadable(conn)

  override readinessDescriptor() -> int
    mine()
    if closed then return -1
    conn.held() match
      Ok(fd) -> fd
      Err(_) -> -1

  override setTimeout(d: Duration) -> Result[unit, IoError]
    mine()
    if closed then return Err(closedError("set the timeout of", peer))
    limitMs = millisOf(d)
    Ok(())

  // Stops reading, giving back the half's share of the socket; closing again does nothing. The
  // socket closes once the writing half is closed too.
  override close() -> Result[unit, IoError]
    mine()
    if !closed
      closed = true
      conn.close()
    Ok(())

  // Stops the program where the half belongs to another thread. `held()` checks the owner of a
  // handle that still holds its share, the other half's closing having closed the descriptor or
  // not, and `close()` of a handle that has given its share back checks it and does nothing else.
  private mine()
    if closed then _ = conn.close() else _ = conn.held()

  private received(max: int) -> Result[Array[byte], IoError]
    afterWait(halfReceive(conn, max, limitMs)).mapErr(failed("read from", peer))

// The writing half of a TCP or Unix connection.
@trusted_sendable(
  "it belongs to one thread at a time: a send hands it over, and every operation first checks its owner, so the code that handed it over traps; what it shares with its reading half is the socket, whose counted shares the system's descriptor outlives until the last is given back"
)
private class SocketWriter(
    private val conn: WriteSocket,
    private var closed: bool,
    private var limitMs: int,
    private val peer: string,
    private val other: Option[string]
): Sendable, StreamWriter
  override remoteAddress -> Option[string] = other

  override write(bytes: Array[byte]) -> Result[unit, IoError]
    mine()
    if closed then return Err(closedError("write to", peer))
    afterWait(halfSendAll(conn, bytes, limitMs)).mapErr(failed("write to", peer))

  override writeSome(bytes: Array[byte]) -> Result[int, IoError]
    mine()
    if closed then return Err(closedError("write to", peer))
    afterWait(halfSendSome(conn, bytes, limitMs)).map(n -> int(n)).mapErr(failed("write to", peer))

  override writeText(text: string) -> Result[unit, IoError] = write(utf8Of(text))

  override writable() -> bool
    mine()
    closed || halfWritable(conn)

  override writabilityDescriptor() -> int
    mine()
    if closed then return -1
    conn.held() match
      Ok(fd) -> fd
      Err(_) -> -1

  override setTimeout(d: Duration) -> Result[unit, IoError]
    mine()
    if closed then return Err(closedError("set the timeout of", peer))
    limitMs = millisOf(d)
    Ok(())

  // Tells the other end nothing more will be sent and stops writing, giving back the half's share of
  // the socket; closing again does nothing. The socket closes once the reading half is closed too.
  // It answers `Ok` where the other end has gone already, as closing a connection does.
  override close() -> Result[unit, IoError]
    mine()
    if !closed
      closed = true
      _ = conn.shutdown(Write)
      conn.close()
    Ok(())

  // Stops the program where the half belongs to another thread, as the reading half's does.
  private mine()
    if closed then _ = conn.close() else _ = conn.held()
