module avin.net

// TCP: a connection to a host and port, and a listener that accepts them. Every operation that can
// fail answers a `Result` with an `IoError`, and one that waits for the other end, to connect, accept,
// read or write, is safe for the collector while it waits: a lightweight thread parks, leaving its
// worker to run other threads, until the socket is ready.
//
// A connection or listener belongs to one thread at a time. Handing one to a thread's or a future's
// body hands it over, so a server accepts a connection and gives it to the code that serves it.

import avin.io
import avin.io.ErrorKind
import avin.io.IoError
import avin.time.{Duration, monotonic}

// Why an operation on a connection failed, as the runtime tells the platform's failures apart.
@sysl("avin.rt.NetFailure")
private data NetFailure
  Refused
  Reset
  TimedOut
  Failed(message: string)

// The error a socket's operations answer, which only the runtime looks into.
@sysl("sysl.fs.IoError")
private class SyslError

@sysl("avin.rt.net_failure")
private netFailure(e: SyslError) -> NetFailure

private kindOf(e: SyslError) -> ErrorKind = netFailure(e) match
  Refused -> io.ConnectionRefused
  Reset -> io.ConnectionReset
  TimedOut -> io.TimedOut
  Failed(m) -> io.Other(m)

// The error `operation` on `subject`, an address, failed with, of the kind the socket's error `e` is.
private failed(operation: string, subject: string) -> (SyslError) -> IoError =
  e -> IoError(kindOf(e), operation, subject)

// What `operation` on the closed connection or listener `subject` answers.
private closedError(operation: string, subject: string) -> IoError =
  IoError(io.Other("the connection is closed"), operation, subject)

// Where a socket connects or listens: an address and a port, as the host's name resolved.
@sysl("sysl.net.Address")
private class Address
  port() -> int
  // The address written numerically, without its port: `127.0.0.1` or `::1`.
  text() -> string

// How much of a connection is given up.
@sysl("sysl.net.Shutdown")
private data Shutdown
  Read
  Write
  Both

// The socket under a connection. Its descriptor is closed when its handle is closed or, for one the
// program forgot, when the collector frees it. Its traps name the `TcpStream`.
@sysl("sysl.net.Socket", named: "TcpStream")
private class Socket
  shutdown(how: Shutdown) -> Result[unit, SyslError]
  // The descriptor, which only a select's `readable()` arm watches: calling it also checks the
  // socket belongs to the code running.
  @sysl("fd")
  held() -> Result[int, SyslError]
  local() -> Result[Address, SyslError]
  setNoDelay(on: bool) -> Result[unit, SyslError]
  noDelay() -> Result[bool, SyslError]
  setKeepalive(on: bool) -> Result[unit, SyslError]
  keepalive() -> Result[bool, SyslError]
  setKeepaliveIdle(seconds: int) -> Result[unit, SyslError]
  keepaliveIdle() -> Result[int, SyslError]
  setKeepaliveInterval(seconds: int) -> Result[unit, SyslError]
  keepaliveInterval() -> Result[int, SyslError]
  setKeepaliveCount(probes: int) -> Result[unit, SyslError]
  keepaliveCount() -> Result[int, SyslError]
  setSendBuffer(bytes: int) -> Result[unit, SyslError]
  sendBuffer() -> Result[int, SyslError]
  setRecvBuffer(bytes: int) -> Result[unit, SyslError]
  recvBuffer() -> Result[int, SyslError]

// The socket under a listener, closed as a connection's is, on the same Sysl type. Its traps name
// the `TcpListener`.
@sysl("sysl.net.Socket", named: "TcpListener")
private class ListenSocket
  reuseAddress(on: bool) -> Result[unit, SyslError]
  setReusePort(on: bool) -> Result[unit, SyslError]
  reusePort() -> Result[bool, SyslError]
  setSendBuffer(bytes: int) -> Result[unit, SyslError]
  sendBuffer() -> Result[int, SyslError]
  setRecvBuffer(bytes: int) -> Result[unit, SyslError]
  recvBuffer() -> Result[int, SyslError]
  bind(to: Address) -> Result[unit, SyslError]
  listen(backlog: int) -> Result[unit, SyslError]
  local() -> Result[Address, SyslError]
  // The descriptor, which is never used: calling it checks the socket belongs to the code running.
  @sysl("fd")
  held() -> Result[int, SyslError]

// Every socket is non-blocking, and an operation that would have to wait waits in the runtime: a
// lightweight thread parks on the runtime's poller, freeing its worker, and any other thread waits on
// the socket alone. Each is safe for the collector while it waits. A limit of zero milliseconds is
// none.
// A cancellation point: stops the calling thread where its scope has cancelled it and it may stop here.
@intrinsic("cancel_point")
private stopIfCancelled()

// What an operation that waited answered, once the thread has passed a cancellation point where it
// failed: a cancellation that ends a socket's wait fails the operation, and the thread stops here,
// with the operation's own code returned from.
private afterWait[T, E](r: Result[T, E]) -> Result[T, E]
  if r.isErr then stopIfCancelled()
  r

// Connects `s` to `to`, failing as timed out after `limitMs` milliseconds where that is positive.
@sysl("avin.rt.socket_connect")
private connectSocket(s: Socket, to: Address, limitMs: int) -> Result[unit, SyslError]

@sysl("avin.rt.socket_send_all")
private sendAll(s: Socket, bytes: Array[byte], limitMs: int) -> Result[unit, SyslError]

// Up to `max` bytes, exactly as many as arrived: what a read of `max` allocates is what it answers.
@sysl("avin.rt.socket_receive")
private receive(s: Socket, max: int, limitMs: int) -> Result[Array[byte], SyslError]

@sysl("avin.rt.socket_accept")
private acceptOn(s: ListenSocket) -> Result[(Socket, Address), SyslError]

@sysl("avin.rt.socket_send_some")
private sendSome(s: Socket, bytes: Array[byte], limitMs: int) -> Result[long, SyslError]

// Whether a read of `s` would answer without waiting, never waiting itself.
@sysl("avin.rt.socket_readable")
private socketReadable(s: Socket) -> bool

// Whether a write to `s` would send something without waiting, never waiting itself.
@sysl("avin.rt.socket_writable")
private socketWritable(s: Socket) -> bool

@sysl("avin.rt.socket_non_blocking")
private nonBlocking(s: ListenSocket) -> Result[unit, SyslError]

// A lookup is made on a helper thread of the runtime's and waited for as a socket is, so a
// cancellation ends the wait at once rather than when the resolver answers, and a wait longer than
// `limitMs` milliseconds, where that is positive, abandons the lookup and fails as timed out.
@sysl("avin.rt.resolve_host")
private resolveRaw(host: string, port: int, limitMs: int) -> Result[Vector[Address], SyslError]

@sysl("sysl.net.socket")
private openConnection(to: Address) -> Result[Socket, SyslError]

@sysl("sysl.net.socket")
private openListenSocket(to: Address) -> Result[ListenSocket, SyslError]

// Every address `host` and `port` resolve to, in the order the platform prefers them; a lookup
// waiting longer than `limitMs` milliseconds, where that is positive, fails as `TimedOut`.
private addressesOf(host: string, port: int, limitMs: int) -> Result[Vector[Address], IoError]
  if port < 0 || port > 65535 then fail(s"port $port is outside 0 to 65535")
  afterWait(resolveRaw(host, port, limitMs)) match
    Ok(found) if found.nonEmpty -> Ok(found)
    Err(e) if netFailure(e) is TimedOut -> Err(IoError(io.TimedOut, "resolve", host))
    _ -> Err(IoError(io.HostNotFound, "resolve", host))

// How much a read takes from the connection at once when it reads ahead.
private val ChunkSize = 8192

// The bytes a connection has read beyond what its caller has asked for, and the reading that works
// through them before asking the connection for more. A TCP connection, a Unix one and a TLS one
// share it; each passes the way it receives bytes from its own socket. `ahead` is what has already
// arrived, read from `at`; a new connection's is `ReadAhead(Array.empty[byte](), 0)`.
class ReadAhead(private var ahead: Array[byte], private var at: int)
  // Whether bytes that have arrived are still to be read, so that a read answers without waiting.
  pending -> bool = at < ahead.length

  // Keeps `bytes`, which arrived before anything asked for them, for the reads that follow, after
  // whatever is still to be read.
  keep(bytes: Array[byte])
    if bytes.length == 0 then return
    if at >= ahead.length
      ahead = bytes
    else
      val all = Buffer[byte]()
      for k in at ..< ahead.length
        all.addOne(ahead(k))
      all.addAll(bytes)
      ahead = all.toArray()
    at = 0

  // Up to `max` bytes, waiting for at least one; an empty array once the other end has finished
  // sending. `max` is at least one.
  read(max: int, fill: (int) -> Result[Array[byte], IoError]) -> Result[Array[byte], IoError]
    if max < 1 then fail(s"a read of $max bytes: a read takes at least one")
    if at < ahead.length
      val end = if ahead.length - at > max then at + max else ahead.length
      val taken = ahead.slice(at, end)
      at = end
      return Ok(taken)
    fill(max)

  // The next line, without its terminator, or `None` once the other end has finished sending and
  // every line has been read. A line ends at `\n`, a `\r` just before it being part of the
  // terminator, and the last line needs none; bytes that are not UTF-8 become U+FFFD.
  readLine(fill: (int) -> Result[Array[byte], IoError]) -> Result[Option[string], IoError]
    val line = Buffer[byte]()
    var any = false
    while true
      var i = at
      while i < ahead.length && ahead(i) != byte(10)
        i += 1
      if i > at then any = true
      for k in at ..< i
        line.addOne(ahead(k))
      if i < ahead.length
        at = i + 1
        return Ok(Some(lineText(line)))
      at = ahead.length
      val more = fill(ChunkSize)?
      if more.length == 0
        return Ok(if any then Some(lineText(line)) else None)
      ahead = more
      at = 0
    Ok(None)

  // Everything the other end sends until it finishes, after what earlier reads left.
  readAll(fill: (int) -> Result[Array[byte], IoError]) -> Result[Array[byte], IoError]
    val all = Buffer[byte]()
    for k in at ..< ahead.length
      all.addOne(ahead(k))
    at = ahead.length
    while true
      val more = fill(ChunkSize)?
      if more.length == 0 then return Ok(all.toArray())
      all.addAll(more)
    Ok(all.toArray())

// `text` as UTF-8 bytes.
private utf8Of(text: string) -> Array[byte] = Array.tabulate(text.byteLength, i -> text.byteAt(i))

// A TCP connection, made by `TcpStream.connect` or a listener's `accept`. Bytes `readLine` reads
// beyond its line are kept for the next read. A connection may be handed to another thread or actor,
// which takes it over, the bytes read ahead with it: its socket is a Sysl handle, and every
// operation, one served from those bytes and one on a closed connection included, first checks the
// socket's owner, so the code that handed it over traps where it uses it again.
// A read or write waits at most `limitMs` milliseconds at a time for the connection, zero for no
// limit.
@trusted_sendable(
  "it belongs to one thread at a time: a send hands it over, and every operation first checks its owner, so the code that handed it over traps"
)
class TcpStream(
    private val conn: Socket,
    private val buffered: ReadAhead,
    private var closed: bool,
    private var limitMs: int,
    private val peer: string,
    private val other: Option[string] = None
): Sendable, ByteStream
  // The other end's address, written numerically without its port.
  override remoteAddress -> Option[string] = other

  // Whether `split` has given the connection to its halves.
  private var halved = false

  // Up to `max` bytes, waiting for at least one; an empty array once the other end has finished
  // sending. `max` is at least one.
  override read(max: int) -> Result[Array[byte], IoError]
    mine()
    if closed || halved then return Err(unusable("read from", peer))
    buffered.read(max, received)

  // The next line, without its terminator, or `None` once the other end has finished sending and
  // every line has been read. A line ends at `\n`, a `\r` just before it being part of the
  // terminator, and the last line needs none; bytes that are not UTF-8 become U+FFFD.
  override readLine() -> Result[Option[string], IoError]
    mine()
    if closed || halved then return Err(unusable("read from", peer))
    buffered.readLine(received)

  // Everything the other end sends until it finishes, after what earlier reads left.
  override readAll() -> Result[Array[byte], IoError]
    mine()
    if closed || halved then return Err(unusable("read from", peer))
    buffered.readAll(received)

  // Whether a read would answer now, without waiting: bytes read ahead are still to be read, bytes
  // have arrived, the other end has finished sending or reset the connection, or the connection is
  // closed. Never waits.
  override readable() -> bool
    mine()
    closed || halved || buffered.pending || socketReadable(conn)

  // The socket's descriptor, which a select's `readable()` arm watches; -1 once closed.
  override readinessDescriptor() -> int
    mine()
    if closed || halved then return -1
    conn.held() match
      Ok(fd) -> fd
      Err(_) -> -1

  // Whether a write would send something now, without waiting: there is room for it, the
  // connection has failed, or it is closed. Never waits.
  override writable() -> bool
    mine()
    closed || halved || socketWritable(conn)

  // The socket's descriptor, which a select's `writable()` arm watches; -1 once closed.
  override writabilityDescriptor() -> int = readinessDescriptor()

  // Sends all of `bytes`.
  override write(bytes: Array[byte]) -> Result[unit, IoError]
    mine()
    if closed || halved then return Err(unusable("write to", peer))
    afterWait(sendAll(conn, bytes, limitMs)).mapErr(failed("write to", peer))

  // Sends what of `bytes` goes without waiting, after waiting for room for the first byte, and
  // answers how many were sent.
  override writeSome(bytes: Array[byte]) -> Result[int, IoError]
    mine()
    if closed || halved then return Err(unusable("write to", peer))
    afterWait(sendSome(conn, bytes, limitMs)).map(n -> int(n)).mapErr(failed("write to", peer))

  // Sends `text` as UTF-8.
  override writeText(text: string) -> Result[unit, IoError] = write(utf8Of(text))

  // A read or a write that waits longer than `d` for the other end fails with `TimedOut` from now
  // on; a duration of zero or less takes the limit away. The limit is kept in whole milliseconds, a
  // part of one counting as one, and each wait has the whole of it: a write that has to wait for
  // room several times fails only where one of those waits runs out.
  override setTimeout(d: Duration) -> Result[unit, IoError]
    mine()
    if closed || halved then return Err(unusable("set the timeout of", peer))
    limitMs = millisOf(d)
    Ok(())

  // The limit `setTimeout` set, in whole milliseconds; zero where there is none.
  timeout -> Duration = Duration(long(limitMs) * 1000)

  // Gives the connection every option of `options`: `noDelay` and `keepAlive` as they say, and each
  // buffer size that is not zero. A value no socket can be given traps.
  configure(options: TcpOptions) -> Result[unit, IoError]
    checkTcpOptions(options)
    usable("set the options of")?
    configured(conn, options).mapErr(failed("set the options of", peer))

  // Sends each write at once rather than holding a small one back to join the next, or holds them
  // back again, which a new connection does.
  setNoDelay(on: bool) -> Result[unit, IoError]
    usable("set the options of")?
    conn.setNoDelay(on).mapErr(failed("set the options of", peer))

  // Whether each write is sent at once, as the system says.
  noDelay() -> Result[bool, IoError]
    usable("read the options of")?
    conn.noDelay().mapErr(failed("read the options of", peer))

  // Probes the connection while it is idle as `k` says, or, for `None`, stops probing it, which is
  // how a new connection starts. A `KeepAlive` no socket can be given traps.
  setKeepAlive(k: Option[KeepAlive]) -> Result[unit, IoError]
    k match
      Some(asked) -> checkKeepAlive(asked)
      None -> ()
    usable("set the options of")?
    keepAliveOn(conn, k).mapErr(failed("set the options of", peer))

  // How the connection is probed while idle, as the system says, in whole seconds; `None` where it
  // is not. A connection probed with the system's own timing answers the system's.
  keepAlive() -> Result[Option[KeepAlive], IoError]
    usable("read the options of")?
    keepAliveOf(conn).mapErr(failed("read the options of", peer))

  // Asks the system for a send buffer of `bytes`, which must be at least one.
  setSendBuffer(bytes: int) -> Result[unit, IoError]
    if bytes < 1 then fail(s"a send buffer of $bytes bytes: it is at least one")
    usable("set the options of")?
    conn.setSendBuffer(bytes).mapErr(failed("set the options of", peer))

  // The size of the send buffer the system gave, in bytes.
  sendBuffer() -> Result[int, IoError]
    usable("read the options of")?
    conn.sendBuffer().mapErr(failed("read the options of", peer))

  // Asks the system for a receive buffer of `bytes`, which must be at least one.
  setReceiveBuffer(bytes: int) -> Result[unit, IoError]
    if bytes < 1 then fail(s"a receive buffer of $bytes bytes: it is at least one")
    usable("set the options of")?
    conn.setRecvBuffer(bytes).mapErr(failed("set the options of", peer))

  // The size of the receive buffer the system gave, in bytes.
  receiveBuffer() -> Result[int, IoError]
    usable("read the options of")?
    conn.recvBuffer().mapErr(failed("read the options of", peer))

  // This end's address, written numerically without its port: the one of the machine's addresses
  // the connection goes from.
  localAddress() -> Result[string, IoError]
    usable("read the address of")?
    conn.local().map(a -> a.text()).mapErr(failed("read the address of", peer))

  // This end's port, the one the system chose for a connection made by `connect`.
  localPort() -> Result[int, IoError]
    usable("read the address of")?
    conn.local().map(a -> a.port()).mapErr(failed("read the address of", peer))

  // Tells the other end nothing more will be sent; reading goes on.
  override shutdownOutput() -> Result[unit, IoError]
    mine()
    if closed || halved then return Err(unusable("shut down", peer))
    conn.shutdown(Write).mapErr(failed("shut down", peer))

  // Ends the connection; closing again does nothing. A read or write afterwards answers an error.
  // A connection that has been split is its halves' to close, and closing it does nothing.
  override close() -> Result[unit, IoError]
    mine()
    if !closed && !halved
      closed = true
      conn.close()
    Ok(())

  // The reading and writing halves of the connection, each with a handle of its own on the socket.
  override split() -> (StreamReader, StreamWriter)
    mine()
    if halved || closed then unsplittable(halved)
    halved = true
    halves(readHalfOf(conn), writeHalfOf(conn), buffered, limitMs, peer, other)

  // Stops the program where the connection belongs to another thread. `held()` checks an open
  // socket's owner, and `close()` of a closed one checks it and does nothing else; each is called
  // for that check alone, so what it answers is dropped. A split connection's socket is its halves',
  // so it is only ever looked at.
  private mine()
    if closed && !halved then _ = conn.close() else _ = conn.held()

  // `Ok` where the connection is open and not split, checking first that it belongs to the code
  // running; else the error `operation` answers.
  private usable(operation: string) -> Result[unit, IoError]
    mine()
    if closed || halved then Err(unusable(operation, peer)) else Ok(())

  // What an operation on the connection answers once it is closed or split.
  private unusable(operation: string, subject: string) -> IoError =
    if halved then splitError(operation, subject) else closedError(operation, subject)

  // Up to `max` bytes from the connection itself.
  private received(max: int) -> Result[Array[byte], IoError]
    afterWait(receive(conn, max, limitMs)).mapErr(failed("read from", peer))

// The text of a line's bytes, a `\r` at its end dropped.
private lineText(line: Buffer[byte]) -> string
  val bytes = line.toArray()
  val n = bytes.length
  string.fromUtf8Lossy(if n > 0 && bytes(n - 1) == byte(13) then bytes.slice(0, n - 1) else bytes)

// A duration as a socket's timeout in milliseconds, rounded up, zero for none.
private millisOf(d: Duration) -> int
  if d.micros <= 0 then return 0
  // Divided first, so the longest duration does not overflow on the way.
  val ms = if d.micros % 1000 > 0 then d.micros / 1000 + 1 else d.micros / 1000
  if ms > long(int.MaxValue) then int.MaxValue else int(ms)

// What is left of `timeout` begun at `start` on the monotonic clock, in whole milliseconds rounded
// up: zero for a timeout of zero, which is no limit, and -1 once it is spent.
private millisLeft(timeout: Duration, start: Duration) -> int
  if timeout == Duration.Zero then return 0
  val left = timeout - (monotonic() - start)
  if left <= Duration.Zero then -1 else millisOf(left)

object TcpStream
  // A connection to the first of the host's addresses that answers. Where none does, the error is
  // the last address's; a host that resolves to nothing is `Other`. The lookup and the connecting,
  // to every address tried, must be done within `timeout`, else the connection fails with
  // `TimedOut`; zero, the default, leaves the waits to the system's own limits, and a negative
  // timeout traps. The socket is given `options` before it connects, so its buffer sizes hold from
  // the first byte; options no socket can be given trap before anything is looked up.
  connect(
      host: string,
      port: int,
      timeout: Duration = Duration.Zero,
      options: TcpOptions = TcpOptions()
  ) -> Result[TcpStream, IoError]
    if timeout.isNegative then fail(s"a connect timeout of $timeout: it is at least zero")
    checkTcpOptions(options)
    val start = monotonic()
    val peer = s"$host:$port"
    val looking = millisLeft(timeout, start)
    if looking < 0 then return Err(IoError(io.TimedOut, "resolve", host))
    val addresses = addressesOf(host, port, looking)?
    var last = IoError(io.Other("no address found"), "connect to", peer)
    for a in addresses
      val limit = millisLeft(timeout, start)
      if limit < 0 then return Err(IoError(io.TimedOut, "connect to", peer))
      openConnection(a).flatMap(c -> optioned(c, options)) match
        Ok(c) ->
          connectSocket(c, a, limit) match
            Ok(_) -> return Ok(TcpStream(c, ReadAhead(Array.empty[byte](), 0), false, 0, peer, Some(a.text())))
            Err(e) ->
              c.close()
              stopIfCancelled()
              last = failed("connect to", peer)(e)
        Err(e) -> last = failed("connect to", peer)(e)
    Err(last)

// A socket listening for connections, made by `TcpListener.bind`. Like a connection, it may be handed
// to another thread, which takes it over, and every operation first checks its socket's owner.
@trusted_sendable(
  "it belongs to one thread at a time: a send hands it over, and every operation first checks its owner, so the code that handed it over traps"
)
class TcpListener(
    private val conn: ListenSocket,
    private val boundPort: int,
    private var closed: bool,
    private val host: string,
    private val chosen: ListenOptions = ListenOptions()
): Sendable, io.Close, Listener[TcpStream]
  // The port it listens on, the one the platform chose where `bind` was given port 0.
  port() -> int
    mine()
    boundPort

  // The options it was bound with.
  options -> ListenOptions = chosen

  // Whether it shares its port with other listeners, as the system says.
  reusePort() -> Result[bool, IoError]
    mine()
    val here = s"$host:$boundPort"
    if closed then return Err(IoError(io.Other("the listener is closed"), "read the options of", here))
    conn.reusePort().mapErr(failed("read the options of", here))

  // Waits for the next connection, and gives it the options' `connections`. A connection the system
  // refuses them is closed, and its error answered.
  override accept() -> Result[TcpStream, IoError]
    mine()
    val here = s"$host:$boundPort"
    if closed then return Err(IoError(io.Other("the listener is closed"), "accept on", here))
    afterWait(acceptOn(conn)) match
      Ok((c, a)) ->
        optioned(c, chosen.connections) match
          Ok(_) -> Ok(TcpStream(c, ReadAhead(Array.empty[byte](), 0), false, 0, s"a client of $here", Some(a.text())))
          Err(e) -> Err(failed("set the options of", s"a client of $here")(e))
      Err(e) -> Err(failed("accept on", here)(e))

  // Stops listening; closing again does nothing. An `accept` afterwards answers an error.
  override close() -> Result[unit, IoError]
    mine()
    if !closed
      closed = true
      conn.close()
    Ok(())

  // Stops the program where the listener belongs to another thread, as a connection's does.
  private mine()
    if closed then _ = conn.close() else _ = conn.held()

object TcpListener
  // Listens on the first of the host's addresses, `127.0.0.1` for this machine alone and `0.0.0.0`
  // for every address it answers on; port `0` lets the platform choose, and `port()` says which.
  // The listener is given `options` before it binds; options no listener can be given trap before
  // anything is looked up.
  bind(host: string, port: int, options: ListenOptions = ListenOptions()) -> Result[TcpListener, IoError]
    checkListenOptions(options)
    val addresses = addressesOf(host, port, 0)?
    val here = s"$host:$port"
    val a = addresses(0)
    val c = openListenSocket(a).mapErr(failed("listen on", here))?
    listening(c, a, options) match
      Ok(_) -> ()
      Err(e) ->
        c.close()
        return Err(failed("listen on", here)(e))
    c.local() match
      Ok(at) -> Ok(TcpListener(c, at.port(), false, host, options))
      Err(e) ->
        c.close()
        Err(failed("listen on", here)(e))
