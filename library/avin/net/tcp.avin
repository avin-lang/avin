module avin.net

// TCP: a connection to a host and port, and a listener that accepts them. Every operation that can
// fail answers a `Result` with an `IoError`, and one that waits for the other end, to connect, accept,
// read or write, is safe for the collector while it waits: a lightweight thread parks, leaving its
// worker to run other threads, until the socket is ready.
//
// A connection or listener belongs to one thread at a time. Handing one to a thread's or a future's
// body hands it over, so a server accepts a connection and gives it to the code that serves it.

import avin.io
import avin.io.IoError
import avin.time.Duration

// Why an operation on a connection failed, as the runtime tells the platform's failures apart.
@sysl("avin.rt.NetFailure")
private data NetFailure
    Refused
    Reset
    TimedOut
    Failed(message: string)

// The error a socket's operations answer, which only the runtime looks into.
@sysl("sysl.fs.IoError")
private class SyslError

@sysl("avin.rt.net_failure")
private netFailure(e: SyslError) -> NetFailure

private ioError(e: SyslError) -> IoError = netFailure(e) match
    Refused -> io.ConnectionRefused
    Reset -> io.ConnectionReset
    TimedOut -> io.TimedOut
    Failed(m) -> io.Other(m)

// Where a socket connects or listens: an address and a port, as the host's name resolved.
@sysl("sysl.net.Address")
private class Address
    port() -> int

// How much of a connection is given up.
@sysl("sysl.net.Shutdown")
private data Shutdown
    Read
    Write
    Both

// The socket under a connection. Its descriptor is closed when its handle is closed or, for one the
// program forgot, when the collector frees it. Its traps name the `TcpStream`.
@sysl("sysl.net.Socket", named: "TcpStream")
private class Socket
    shutdown(how: Shutdown) -> Result[unit, SyslError]
    // The descriptor, which is never used: calling it checks the socket belongs to the code running.
    @sysl("fd")
    held() -> Result[int, SyslError]

// The socket under a listener, closed as a connection's is, on the same Sysl type. Its traps name
// the `TcpListener`.
@sysl("sysl.net.Socket", named: "TcpListener")
private class ListenSocket
    reuseAddress(on: bool) -> Result[unit, SyslError]
    bind(to: Address) -> Result[unit, SyslError]
    listen(backlog: int) -> Result[unit, SyslError]
    local() -> Result[Address, SyslError]
    // The descriptor, which is never used: calling it checks the socket belongs to the code running.
    @sysl("fd")
    held() -> Result[int, SyslError]

// Every socket is non-blocking, and an operation that would have to wait waits in the runtime: a
// lightweight thread parks on the runtime's poller, freeing its worker, and any other thread waits on
// the socket alone. Each is safe for the collector while it waits. A limit of zero milliseconds is
// none.
// A cancellation point: stops the calling thread where its scope has cancelled it and it may stop here.
@intrinsic("cancel_point")
private stopIfCancelled()

// What an operation that waited answered, once the thread has passed a cancellation point where it
// failed: a cancellation that ends a socket's wait fails the operation, and the thread stops here,
// with the operation's own code returned from.
private afterWait[T, E](r: Result[T, E]) -> Result[T, E]
    if r.isErr then stopIfCancelled()
    r

@sysl("avin.rt.socket_connect")
private connectSocket(s: Socket, to: Address) -> Result[unit, SyslError]

@sysl("avin.rt.socket_send_all")
private sendAll(s: Socket, bytes: Array[byte], limitMs: int) -> Result[unit, SyslError]

@sysl("avin.rt.socket_recv")
private recv(s: Socket, into: Array[byte], limitMs: int) -> Result[long, SyslError]

@sysl("avin.rt.socket_accept")
private acceptOn(s: ListenSocket) -> Result[(Socket, Address), SyslError]

@sysl("avin.rt.socket_non_blocking")
private nonBlocking(s: ListenSocket) -> Result[unit, SyslError]

@sysl("sysl.net.resolve")
private resolveRaw(host: string, port: int) -> Result[Vector[Address], SyslError]

@sysl("sysl.net.socket")
private openConnection(to: Address) -> Result[Socket, SyslError]

@sysl("sysl.net.socket")
private openListenSocket(to: Address) -> Result[ListenSocket, SyslError]

// Binds `s` to `to`, letting a port a recently stopped listener used be taken again, and listens
// with the platform's usual backlog, without blocking.
private listening(s: ListenSocket, to: Address) -> Result[unit, SyslError]
    s.reuseAddress(true)?
    s.bind(to)?
    s.listen(128)?
    nonBlocking(s)

// Every address `host` and `port` resolve to, in the order the platform prefers them.
private addressesOf(host: string, port: int) -> Result[Vector[Address], IoError]
    if port < 0 || port > 65535 then fail(s"port $port is outside 0 to 65535")
    resolveRaw(host, port) match
        Ok(found) if found.nonEmpty -> Ok(found)
        _ -> Err(io.Other(s"no address found for $host"))

// What a read or write on a closed connection answers.
private closedError() -> IoError = io.Other("the connection is closed")

// How much a read takes from the connection at once when it reads ahead.
private val ChunkSize = 8192

// The bytes a connection has read beyond what its caller has asked for, and the reading that works
// through them before asking the connection for more. A TCP connection, a Unix one and a TLS one
// share it; each passes the way it receives bytes from its own socket. `ahead` is what has already
// arrived, read from `at`; a new connection's is `ReadAhead(Array.empty[byte](), 0)`.
class ReadAhead(private var ahead: Array[byte], private var at: int)
    // Up to `max` bytes, waiting for at least one; an empty array once the other end has finished
    // sending. `max` is at least one.
    read(max: int, fill: (int) -> Result[Array[byte], IoError]) -> Result[Array[byte], IoError]
        if max < 1 then fail(s"a read of $max bytes: a read takes at least one")
        if at < ahead.length
            val end = if ahead.length - at > max then at + max else ahead.length
            val taken = ahead.slice(at, end)
            at = end
            return Ok(taken)
        fill(max)

    // The next line, without its terminator, or `None` once the other end has finished sending and
    // every line has been read. A line ends at `\n`, a `\r` just before it being part of the
    // terminator, and the last line needs none; bytes that are not UTF-8 become U+FFFD.
    readLine(fill: (int) -> Result[Array[byte], IoError]) -> Result[Option[string], IoError]
        val line = Buffer[byte]()
        var any = false
        while true
            var i = at
            while i < ahead.length && ahead(i) != byte(10)
                i += 1
            if i > at then any = true
            for k in at..<i
                line.addOne(ahead(k))
            if i < ahead.length
                at = i + 1
                return Ok(Some(lineText(line)))
            at = ahead.length
            val more = fill(ChunkSize)?
            if more.length == 0
                return Ok(if any then Some(lineText(line)) else None)
            ahead = more
            at = 0
        Ok(None)

    // Everything the other end sends until it finishes, after what earlier reads left.
    readAll(fill: (int) -> Result[Array[byte], IoError]) -> Result[Array[byte], IoError]
        val all = Buffer[byte]()
        for k in at..<ahead.length
            all.addOne(ahead(k))
        at = ahead.length
        while true
            val more = fill(ChunkSize)?
            if more.length == 0 then return Ok(all.toArray())
            all.addAll(more)
        Ok(all.toArray())

// `text` as UTF-8 bytes.
private utf8Of(text: string) -> Array[byte] = Array.tabulate(text.byteLength, i -> text.byteAt(i))

// A TCP connection, made by `TcpStream.connect` or a listener's `accept`. Bytes `readLine` reads
// beyond its line are kept for the next read. A connection may be handed to another thread or actor,
// which takes it over, the bytes read ahead with it: its socket is a Sysl handle, and every
// operation, one served from those bytes and one on a closed connection included, first checks the
// socket's owner, so the code that handed it over traps where it uses it again.
// A read or write waits at most `limitMs` milliseconds at a time for the connection, zero for no
// limit.
class TcpStream(private val conn: Socket, private val buffered: ReadAhead, private var closed: bool,
                private var limitMs: int): Sendable, ByteStream
    // Up to `max` bytes, waiting for at least one; an empty array once the other end has finished
    // sending. `max` is at least one.
    override read(max: int) -> Result[Array[byte], IoError]
        mine()
        if closed then return Err(closedError())
        buffered.read(max, received)

    // The next line, without its terminator, or `None` once the other end has finished sending and
    // every line has been read. A line ends at `\n`, a `\r` just before it being part of the
    // terminator, and the last line needs none; bytes that are not UTF-8 become U+FFFD.
    override readLine() -> Result[Option[string], IoError]
        mine()
        if closed then return Err(closedError())
        buffered.readLine(received)

    // Everything the other end sends until it finishes, after what earlier reads left.
    override readAll() -> Result[Array[byte], IoError]
        mine()
        if closed then return Err(closedError())
        buffered.readAll(received)

    // Sends all of `bytes`.
    override write(bytes: Array[byte]) -> Result[unit, IoError]
        mine()
        if closed then return Err(closedError())
        afterWait(sendAll(conn, bytes, limitMs)).mapErr(ioError)

    // Sends `text` as UTF-8.
    override writeText(text: string) -> Result[unit, IoError] = write(utf8Of(text))

    // A read or a write that waits longer than `d` for the other end fails with `TimedOut` from now
    // on; a duration of zero or less takes the limit away. The limit is kept in whole milliseconds, a
    // part of one counting as one, and each wait has the whole of it: a write that has to wait for
    // room several times fails only where one of those waits runs out.
    override setTimeout(d: Duration) -> Result[unit, IoError]
        mine()
        if closed then return Err(closedError())
        limitMs = millisOf(d)
        Ok(())

    // Tells the other end nothing more will be sent; reading goes on.
    override shutdownOutput() -> Result[unit, IoError]
        mine()
        if closed then return Err(closedError())
        conn.shutdown(Write).mapErr(ioError)

    // Ends the connection; closing again does nothing. A read or write afterwards answers an error.
    override close()
        mine()
        if !closed
            closed = true
            conn.close()

    // Stops the program where the connection belongs to another thread. `held()` checks an open
    // socket's owner, and `close()` of a closed one checks it and does nothing else.
    private mine()
        if closed then conn.close() else conn.held()

    // Up to `max` bytes from the connection itself.
    private received(max: int) -> Result[Array[byte], IoError]
        val into = Array.fill(max, byte(0))
        val n = afterWait(recv(conn, into, limitMs)).mapErr(ioError)?
        Ok(if n == long(max) then into else into.slice(0, int(n)))

// The text of a line's bytes, a `\r` at its end dropped.
private lineText(line: Buffer[byte]) -> string
    val bytes = line.toArray()
    val n = bytes.length
    string.fromUtf8Lossy(if n > 0 && bytes(n - 1) == byte(13) then bytes.slice(0, n - 1) else bytes)

// A duration as a socket's timeout in milliseconds, rounded up, zero for none.
private millisOf(d: Duration) -> int
    if d.micros <= 0 then return 0
    // Divided first, so the longest duration does not overflow on the way.
    val ms = if d.micros % 1000 > 0 then d.micros / 1000 + 1 else d.micros / 1000
    if ms > long(int.MaxValue) then int.MaxValue else int(ms)

object TcpStream
    // A connection to the first of the host's addresses that answers. Where none does, the error is
    // the last address's; a host that resolves to nothing is `Other`.
    connect(host: string, port: int) -> Result[TcpStream, IoError]
        val addresses = addressesOf(host, port)?
        var last = io.Other(s"no address found for $host")
        for a in addresses
            openConnection(a) match
                Ok(c) ->
                    connectSocket(c, a) match
                        Ok(_) -> return Ok(TcpStream(c, ReadAhead(Array.empty[byte](), 0), false, 0))
                        Err(e) ->
                            c.close()
                            stopIfCancelled()
                            last = ioError(e)
                Err(e) -> last = ioError(e)
        Err(last)

// A socket listening for connections, made by `TcpListener.bind`. Like a connection, it may be handed
// to another thread, which takes it over, and every operation first checks its socket's owner.
class TcpListener(private val conn: ListenSocket, private val boundPort: int, private var closed: bool): Sendable
    // The port it listens on, the one the platform chose where `bind` was given port 0.
    port() -> int
        mine()
        boundPort

    // Waits for the next connection.
    accept() -> Result[TcpStream, IoError]
        mine()
        if closed then return Err(io.Other("the listener is closed"))
        afterWait(acceptOn(conn)) match
            Ok((c, _)) -> Ok(TcpStream(c, ReadAhead(Array.empty[byte](), 0), false, 0))
            Err(e) -> Err(ioError(e))

    // Stops listening; closing again does nothing. An `accept` afterwards answers an error.
    close()
        mine()
        if !closed
            closed = true
            conn.close()

    // Stops the program where the listener belongs to another thread, as a connection's does.
    private mine()
        if closed then conn.close() else conn.held()

object TcpListener
    // Listens on the first of the host's addresses, `127.0.0.1` for this machine alone and `0.0.0.0`
    // for every address it answers on; port `0` lets the platform choose, and `port()` says which.
    bind(host: string, port: int) -> Result[TcpListener, IoError]
        val addresses = addressesOf(host, port)?
        val a = addresses(0)
        val c = openListenSocket(a).mapErr(ioError)?
        listening(c, a) match
            Ok(_) -> ()
            Err(e) ->
                c.close()
                return Err(ioError(e))
        c.local() match
            Ok(at) -> Ok(TcpListener(c, at.port(), false))
            Err(e) ->
                c.close()
                Err(ioError(e))
