module avin.net.http

// Typed parameters: a request's query and route parameters read as the type a handler wants, a value
// that does not read as one being a `ParamError`, which `?` turns into a `400` in a handler that
// answers a `Result[Response, ToResponse]`.

// A type a parameter's text is read as: `parse` answers the value, or `None` for text that is not
// one, and `kind` names the type for an error, as in "an int".
trait FromParam
  static parse(text: string) -> Option[Self]
  static kind() -> string

impl FromParam for string
  static parse(text: string) -> Option[string] = Some(text)
  static kind() -> string = "text"

impl FromParam for int
  static parse(text: string) -> Option[int] = text.toIntOption()
  static kind() -> string = "an int"

impl FromParam for long
  static parse(text: string) -> Option[long] = text.toLongOption()
  static kind() -> string = "a long"

impl FromParam for real
  static parse(text: string) -> Option[real] = text.toRealOption()
  static kind() -> string = "a real"

impl FromParam for bool
  static parse(text: string) -> Option[bool] = text.toBoolOption()
  static kind() -> string = "true or false"

// Why a parameter has no value of the type asked for: it is missing, or its text is not one. `place`
// says which parameters it is among, `query parameter` or `route parameter`.
data ParamError
  Missing(place: string, name: string)
  Invalid(place: string, name: string, text: string, kind: string)

impl Error for ParamError
  // A sentence saying what is wrong, for the client.
  message -> string = self match
    Missing(place, name) -> s"the $place `$name` is missing"
    Invalid(place, name, text, kind) -> s"the $place `$name` is `$text`, which is not $kind"

// A parameter error is answered `400`, its message for the body, so `?` ends a handler with it.
impl ToResponse for ParamError
  toResponse() -> Response = Response.text(400, s"${message}\n")

// The value `text` reads as, or the error naming the parameter.
private parsed[T: FromParam](place: string, name: string, text: string) -> Result[T, ParamError] = T.parse(text) match
  Some(v) -> Ok(v)
  None -> Err(Invalid(place, name, text, T.kind()))
