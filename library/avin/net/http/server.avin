module avin.net.http

// An HTTP/1.1 server on a `TcpServer`: each connection is served in an actor of its own, its requests
// read one after another, so a connection is kept alive for several and pipelined ones are answered
// in order. A handler takes a `ServerRequest` and answers a `Response`; a `Router` is a handler that
// chooses another by the request's method and path. A request the server cannot take is answered
// with its status and the connection closed: a malformed one `400`, a body over the limit `413`, a
// request line or headers over theirs `414` and `431`, a client too slow `408`, and a request that
// arrives once the server is stopping `503`. A handler that traps fails its connection alone, which
// is answered `500` and closed.

import avin.io.{IoError, TimedOut}
import avin.net.{ByteStream, KeepAlive, ListenOptions, TcpOptions, TcpServer, TcpStream, Url}
import avin.net.tls.{TlsServer, TlsSource, TlsStream}
import avin.threads.{Atomic, Mutex}
import avin.time.{Duration, Instant, millis, monotonic, now, seconds}

// A request as a server read it: its method, its target as the request line gave it, its headers in
// order, its body, its version (`HTTP/1.1` or `HTTP/1.0`) and the parameters its route bound. A
// target is a path beginning with `/`, with an optional query, or an absolute `http` URL; any other
// traps where a request is made with it. A request a server read knows its server, so a handler can
// wait in a way the server's stopping ends; one made without a server never stops. It knows the
// client's address, `remote`, where its connection has one, and `route`, the pattern of the route a
// router chose for it, once one has. A request also carries the values middleware handed on with
// `withValue`, one of each type. A request whose route takes its body as a stream arrives with its
// body unread, read through `bodyReader`.
class ServerRequest(
    val method: string,
    val target: string,
    val headers: Vector[(string, string)] = Vector.empty[(string, string)](),
    val body: Array[byte] = Array.empty[byte](),
    val version: string = "HTTP/1.1",
    val params: Vector[(string, string)] = Vector.empty[(string, string)](),
    val remote: Option[string] = None,
    val route: Option[string] = None,
    private val server: Option[TcpServer] = None,
    private val values: Vector[Any] = Vector.empty[Any](),
    private val source: Option[BodySource] = None
)
  private val parts: Target = targetOf(target) match
    Some(t) -> t
    None -> fail(s"`$target` is not a request target")

  // The path with its escapes decoded: a target of `/caf%C3%A9?x=1` has the path `/café`.
  val path: string = parts.path

  // The path's segments, each decoded: `/a/b%2Fc` has `a` and `b/c`, and `/` one empty one.
  val segments: Vector[string] = parts.segments

  // The query as it was written, without its `?`; `None` where the target has none.
  val query: Option[string] = parts.url.query

  // The value of the first header of `name`, compared without regard to case.
  header(name: string) -> Option[string] = headerIn(headers, name)

  // The body read as UTF-8, a sequence that is not UTF-8 read as U+FFFD.
  text -> string = string.fromUtf8Lossy(body)

  // The query's pairs, decoded, as `Url.queryParams` reads them.
  queryParams -> Vector[(string, string)] = parts.url.queryParams

  // The body read as an `application/x-www-form-urlencoded` form by `Url.formDecode`, as UTF-8
  // whatever charset the type names. A `Content-Type` that is not that type, or none, is `NotAForm`;
  // a malformed escape or bytes that are not UTF-8 `BadEncoding`.
  form() -> Result[Form, FormError] = formOf(header("Content-Type"), body)

  // The body read as `multipart/form-data` within `limits`, as `Multipart.parse` reads it. A
  // `Content-Type` that is not that type, or none, is `NotAForm`.
  multipart(limits: MultipartLimits = MultipartLimits()) -> Result[Multipart, FormError] =
    multipartOf(body, header("Content-Type"), limits)

  // Whether the body is streamed: left on the connection for `bodyReader`, the route having asked
  // for it so. A streamed request's `body` is empty.
  bodyStreamed -> bool = source.isDefined

  // A reader of the body within `maxBytes` (100 MiB unless given), counted over the whole of it: of
  // a streamed request, the body read as it arrives; of a buffered one, the body held. A limit less
  // than zero traps.
  bodyReader(maxBytes: long = streamedBodyLimit) -> BodyReader = BodyReader(source, body, maxBytes)

  // The body read as `multipart/form-data` within `limits` a part at a time, as
  // `MultipartReader.over` reads it, through `bodyReader(limits.maxBytes)`. A `Content-Type` that is
  // not that type, or none, is `NotAForm`.
  multipartReader(limits: MultipartLimits = MultipartLimits()) -> Result[MultipartReader, FormError] =
    multipartReaderOf(bodyReader(long(limits.maxBytes)), header("Content-Type"), limits)

  // The value the route bound to the parameter `name`, written `:name` in its pattern; traps where
  // the route has no such parameter.
  param(name: string) -> string
    for (n, v) in params
      if n == name then return v
    fail(s"the route has no parameter `$name`")

  // The route's parameter `name` read as a `T`, or `Invalid` where its text is not one; traps where
  // the route has no such parameter, as `param` does.
  paramAs[T: FromParam](name: string) -> Result[T, ParamError] = parsed[T]("route parameter", name, param(name))

  // The query parameter `name`, its first where it is given more than once, read as a `T`: `Missing`
  // where the query has none of that name, and `Invalid` where its text is not a `T`.
  queryAs[T: FromParam](name: string) -> Result[T, ParamError] = queryOption[T](name).flatMap(v -> v match
    Some(x) -> Ok(x)
    None -> Err(Missing("query parameter", name)))

  // As `queryAs(name)`, answering `default` where the query has no parameter of that name.
  queryAs[T: FromParam](name: string, default: T) -> Result[T, ParamError] =
    queryOption[T](name).map(v -> v.getOrElse(default))

  // As `queryAs(name)`, answering `None` where the query has no parameter of that name.
  queryOption[T: FromParam](name: string) -> Result[Option[T], ParamError]
    for (n, v) in queryParams
      if n == name then return parsed[T]("query parameter", name, v).map(x -> Some(x))
    Ok(None)

  // Whether the server that read the request is stopping; false for a request made without one.
  isStopping() -> bool = server.exists(s -> s.isStopping())

  // Waits by `wait`, run on a thread of its own, and answers its result, or `None` where the server
  // stops first: stopping cancels `wait` wherever it waits, as `TcpServer.idle` does, so a handler
  // waiting for news, a long poll, answers at once rather than holding the shutdown. Where the
  // server is already stopping, `wait` is not run; without a server, `wait` is run as it is.
  untilStopped[T: Sendable](@sendable wait: () -> T) -> Option[T] = server match
    Some(s) -> s.idle(wait)
    None -> Some(wait())

  // The request with the parameters a route bound.
  withParams(bound: Vector[(string, string)]) -> ServerRequest = ServerRequest(
    method,
    target,
    headers,
    body,
    version,
    bound,
    remote,
    route,
    server,
    values,
    source
  )

  // The request as the route of `pattern` takes it, binding `bound`.
  routed(pattern: string, bound: Vector[(string, string)]) -> ServerRequest = ServerRequest(
    method,
    target,
    headers,
    body,
    version,
    bound,
    remote,
    Some(pattern),
    server,
    values,
    source
  )

  // The request with every header of `name`, compared without regard to case, replaced by one of
  // `value` after the others, so the handlers a middleware passes it to read that one. A header's
  // name is a token and its value holds no line break; either traps where it does not hold.
  withHeaderReplaced(name: string, value: string) -> ServerRequest
    checkHeader(name, value)
    val kept = headers.filter(h -> !h.0.equalsIgnoreCase(name))
    ServerRequest(method, target, kept :+ (name, value), body, version, params, remote, route, server, values, source)

  // The request with `address` as its client's address, `remote`.
  withRemote(address: Option[string]) -> ServerRequest =
    ServerRequest(method, target, headers, body, version, params, address, route, server, values, source)

  // The request without any header of `name`, compared without regard to case.
  withHeaderRemoved(name: string) -> ServerRequest = ServerRequest(
    method,
    target,
    headers.filter(h -> !h.0.equalsIgnoreCase(name)),
    body,
    version,
    params,
    remote,
    route,
    server,
    values,
    source
  )

  // What the `TrustedProxies` middleware learned from a trusted proxy: the connection's peer, and
  // the client's address, scheme and host. `None` where the request did not come through that
  // middleware from a trusted proxy.
  forwarding -> Option[Forwarding] = value[Forwarding]()

  // The scheme the client used, `http` or `https`, as a trusted proxy reported it; `None` where none did.
  scheme -> Option[string] = forwarding.flatMap(f -> f.scheme)

  // The host the client used: as a trusted proxy reported it, or else the request's `Host` header.
  host -> Option[string] = forwarding.flatMap(f -> f.host).orElse(header("Host"))

  // The request carrying `value` as its `T`, so a middleware hands what it learned to the handlers
  // inside it: a user it authenticated, a request id. The type is the key, compared exactly as a
  // type pattern compares a generic type's arguments: a value handed on as a `T` replaces the one of
  // that `T` the request carried, and is read by `value[T]()` and by no other type's, a supertype's
  // or a subtype's. Two values of one type are handed on as two types of the program's own. The
  // request this is called on is unchanged.
  withValue[T: Sendable](value: T) -> ServerRequest = ServerRequest(
    method,
    target,
    headers,
    body,
    version,
    params,
    remote,
    route,
    server,
    values.filter(v -> v is not _: Carried[T]) :+ Carried(value),
    source
  )

  // The value the request carries as its `T`, handed on by `withValue`; `None` where it carries none.
  value[T: Sendable]() -> Option[T]
    for v in values
      v match
        c: Carried[T] -> return Some(c.value)
        _ -> ()
    None

// A value a request carries, held as an `Any` and found again by its exact type `T`.
private class Carried[T](val value: T)

// A target read: the URL it is part of, its path decoded, and the path's segments decoded.
private data Target(url: Url, path: string, segments: Vector[string])

// The parts of a request target, or `None` where it is not one: neither a path beginning with `/`
// nor an absolute `http` or `https` URL, holding a fragment, or holding escapes that are not UTF-8.
private targetOf(target: string) -> Option[Target]
  val absolute = target.startsWith("http://") || target.startsWith("https://")
  if !absolute && !target.startsWith("/") then return None
  val url = Url.parse(if absolute then target else "http://h" + target) match
    Ok(u) -> u
    Err(_) -> return None
  if url.fragment.isDefined then return None
  val raw = if url.path.isEmpty then "/" else url.path
  val path = Url.decode(raw) match
    Ok(p) -> p
    Err(_) -> return None
  val segments = Buffer[string]()
  for piece in raw.split("/").drop(1)
    Url.decode(piece) match
      Ok(p) -> segments.addOne(p)
      Err(_) -> return None
  Some(Target(url, path, segments.toVector))

// What answers a request: a route's handler, a router's `handle`, and what `serve` is given. A
// middleware is a function from one handler to another, so handlers compose as functions do.
type Handler = @sendable (ServerRequest) -> Response

// What renders the response a router or a server makes itself for an error status: given the
// status, it answers the headers and body to send, the status itself staying the one given.
type ErrorPage = @sendable (int) -> Response

// The error page a router and a server use unless given another: the status's reason phrase as
// plain text.
plainError(status: int) -> Response = Response.text(status, s"${reasonPhrase(status)}\n")

// `page`'s rendering of `status`, carrying that status whatever `page` answered.
private rendered(page: ErrorPage, status: int) -> Response
  val r = page(status)
  Response(status, reasonPhrase(status), r.headers, r.body, r.streamed)

// A failure a handler can answer with: the response that tells the client about it. A handler
// answering a `Result[Response, ToResponse]` passes any such error on by `?` as it is, so an error
// type of the program's own implements it to end handlers early. A `Response` is one, itself, and
// so is a `ParamError`.
trait ToResponse
  toResponse() -> Response

impl ToResponse for Response
  toResponse() -> Response = self

// A handler of `answer`, which answers `Ok` with its response or `Err` with a failure, answered with
// that failure's response.
fromResult(@sendable answer: (ServerRequest) -> Result[Response, ToResponse]) -> Handler = r -> answer(r) match
  Ok(response) -> response
  Err(failure) -> failure.toResponse()

// A route: `handler` for requests of `method` whose path matches `pattern`, its body read by the
// server before the handler is called unless `streamsBody`. The method is a token and the pattern
// begins with `/`; either traps where it does not.
class Route(val method: string, val pattern: string, val handler: Handler, val streamsBody: bool = false): Sendable
  if method.isEmpty || method.indexWhere(c -> !isTokenChar(c)) >= 0 then fail(s"`$method` is not an HTTP method")
  if !pattern.startsWith("/") then fail(s"the route pattern `$pattern` does not begin with `/`")

  // The pattern's segments.
  private val parts: Vector[string] = pattern.split("/").drop(1)

  if parts.dropRight(1).exists(isTail) then fail(s"the route pattern `$pattern` has a `*name` segment before its last")

  // The parameters the pattern binds where it matches `segments`, `None` where it does not.
  matches(segments: Vector[string]) -> Option[Vector[(string, string)]] = bound(parts, segments)

  // The route with its handler passed through `middleware`, which runs around it: wrapping again
  // puts the newer middleware outside, so it runs first.
  wrap(@sendable middleware: (Handler) -> Handler) -> Route =
    Route(method, pattern, middleware(handler), streamsBody)

  // The route under `prefix`: its pattern `prefix` followed by its own, a pattern of `/` becoming
  // `prefix` itself.
  under(prefix: string) -> Route = Route(method, joined(prefix, pattern), handler, streamsBody)

  // The route taking its body as a stream: its handler is called once the request's head is read,
  // and reads the body through `ServerRequest.bodyReader`. A server asks a router which of its
  // routes do so through `Router.streamsBody`, given to `serve` as its `streamsBody`.
  streaming() -> Route = Route(method, pattern, handler, true)

object Route
  // A route for `GET`, which answers `HEAD` too.
  get(pattern: string, handler: Handler) -> Route = Route("GET", pattern, handler)

  // A route for `GET` whose handler answers a `Result`, as `fromResult` takes one.
  get(pattern: string, handler: @sendable (ServerRequest) -> Result[Response, ToResponse]) -> Route =
    Route("GET", pattern, fromResult(handler))

  // A route for `POST`.
  post(pattern: string, handler: Handler) -> Route = Route("POST", pattern, handler)

  // A route for `POST` whose handler answers a `Result`.
  post(pattern: string, handler: @sendable (ServerRequest) -> Result[Response, ToResponse]) -> Route =
    Route("POST", pattern, fromResult(handler))

  // A route for `PUT`.
  put(pattern: string, handler: Handler) -> Route = Route("PUT", pattern, handler)

  // A route for `PUT` whose handler answers a `Result`.
  put(pattern: string, handler: @sendable (ServerRequest) -> Result[Response, ToResponse]) -> Route =
    Route("PUT", pattern, fromResult(handler))

  // A route for `DELETE`.
  delete(pattern: string, handler: Handler) -> Route = Route("DELETE", pattern, handler)

  // A route for `DELETE` whose handler answers a `Result`.
  delete(pattern: string, handler: @sendable (ServerRequest) -> Result[Response, ToResponse]) -> Route =
    Route("DELETE", pattern, fromResult(handler))

  // A route for `PATCH`.
  patch(pattern: string, handler: Handler) -> Route = Route("PATCH", pattern, handler)

  // A route for `PATCH` whose handler answers a `Result`.
  patch(pattern: string, handler: @sendable (ServerRequest) -> Result[Response, ToResponse]) -> Route =
    Route("PATCH", pattern, fromResult(handler))

  // The routes of a group: each of `routes` under `prefix`, its handler passed through
  // `middleware`. A prefix begins with `/` and does not end with one, and may bind parameters as a
  // pattern does; one that does not hold traps. Groups nest, an inner group's middleware running
  // inside the outer's.
  group(
      prefix: string,
      routes: Vector[Route],
      @sendable middleware: (Handler) -> Handler = h -> h
  ) -> Vector[Route] = routes.map(r -> r.under(prefix).wrap(middleware))

// `prefix` followed by `pattern`, a pattern of `/` giving the prefix itself.
private joined(prefix: string, pattern: string) -> string
  if !prefix.startsWith("/") then fail(s"the route prefix `$prefix` does not begin with `/`")
  if prefix.endsWith("/") then fail(s"the route prefix `$prefix` ends with `/`")
  if pattern == "/" then prefix else prefix + pattern

// A handler that chooses another by a request's method and path, trying its routes in order. A
// pattern is a path whose segments are matched one for one with the request's decoded segments, a
// segment written `:name` matching any one that is not empty and binding it to `name`, and a last
// segment written `*name` matching the rest of the path, binding it to `name`. A `GET` route
// answers `HEAD` too, where no `HEAD` route matches. A path no route matches is answered `404`, and
// one that routes match for other methods only `405`, with an `Allow` header naming them; `errors`
// renders the two.
class Router(private val routes: Vector[Route], private val errors: ErrorPage = plainError): Sendable
  // The response of the first route matching the request's method and path, its parameters bound.
  handle(request: ServerRequest) -> Response
    answer(request, request.method) match
      Some(r) -> return r
      None -> ()
    if request.method == "HEAD"
      answer(request, "GET") match
        Some(r) -> return r
        None -> ()
    val allowed = Buffer[string]()
    for r in routes
      if r.matches(request.segments).isDefined && !allowed.contains(r.method) then allowed.addOne(r.method)
    if allowed.isEmpty then return rendered(errors, 404)
    if allowed.contains("GET") && !allowed.contains("HEAD") then allowed.addOne("HEAD")
    rendered(errors, 405).withHeader("Allow", allowed.mkString(", "))

  // Whether the route `handle` would choose for the request takes its body as a stream: given to
  // `serve` as its `streamsBody`, it is asked of each request once its head is read. A request no
  // route takes has its body read as any other's.
  streamsBody(request: ServerRequest) -> bool
    chosen(request, request.method) match
      Some(r) -> return r.streamsBody
      None -> ()
    if request.method == "HEAD" then return chosen(request, "GET").exists(r -> r.streamsBody)
    false

  // The first route for `method` whose pattern matches the request's path.
  private chosen(request: ServerRequest, method: string) -> Option[Route]
    for r in routes
      if r.method == method && r.matches(request.segments).isDefined then return Some(r)
    None

  // The response of the first route for `method` whose pattern matches the request's path.
  private answer(request: ServerRequest, method: string) -> Option[Response]
    for r in routes
      if r.method == method
        r.matches(request.segments) match
          Some(params) -> return Some(r.handler(request.routed(r.pattern, params)))
          None -> ()
    None

// Whether a pattern's segment is `*name`, which matches the rest of a path.
private isTail(part: string) -> bool = part.startsWith("*") && part.byteLength > 1

// The parameters `pattern` binds where it matches `segments`, `None` where it does not. A last
// segment `*name` matches the rest of the path, none of it or several segments, binding them to
// `name` joined by `/`.
private bound(pattern: Vector[string], segments: Vector[string]) -> Option[Vector[(string, string)]]
  val tail = !pattern.isEmpty && isTail(pattern(pattern.length - 1))
  val fixed = if tail then pattern.length - 1 else pattern.length
  if tail && segments.length < fixed then return None
  if !tail && pattern.length != segments.length then return None
  val params = Buffer[(string, string)]()
  for (p, s) in pattern.take(fixed).zip(segments)
    if p.startsWith(":") && p.byteLength > 1
      if s.isEmpty then return None
      params.addOne((p.slice(1, p.byteLength), s))
    else if p != s then return None
  if tail
    val last = pattern(fixed)
    params.addOne((last.slice(1, last.byteLength), segments.drop(fixed).mkString("/")))
  Some(params.toVector)

// Serves HTTP/1.1 on `host` and `port`, as `TcpServer.start` listens, answering each request by
// `handler`. At most `maxConnections` are held at once, the next waiting unaccepted. Each wait while
// a request is read may last `readTimeout`, each wait while a response is written `writeTimeout`,
// and the wait for the next request on a connection kept alive `idleTimeout`, after which it is
// closed; and the whole of a request, its line, headers and body, must arrive within
// `requestTimeout` of its first byte, and its line and headers within `headerTimeout`, counted from
// the connection's acceptance for its first request (so a client that never sends is closed then)
// and from its first byte for a later one, else it is answered `408` and the connection closed;
// zero takes a limit away. A request line may be at most `maxHeaderBytes` long, and the request
// line and headers together as long, in at most `maxHeaders` header lines; a body may be at most
// `maxBodyBytes`. A `maxHeaderBytes` or `maxHeaders` less than one, a `maxBodyBytes` or
// `maxConnections` less than zero or one, or a negative `requestTimeout`, `headerTimeout` or
// `handshakeTimeout`, traps. With `tls`, the server speaks HTTPS: each connection begins with a TLS
// handshake presenting its certificate, each of the handshake's waits lasting at most `readTimeout`
// and the whole of it, from the connection's acceptance, at most `handshakeTimeout`; a connection
// whose handshake fails or runs out of time is closed unanswered, freeing its place among
// `maxConnections`. A handler that traps on a TLS connection has it closed without an
// answer, since the answer would have to go through the connection's TLS, which ended with the
// handler; so does one that traps while it streams a response, whose head is already sent. The
// answers the server makes itself for an error status are rendered by `errors`. Each response
// carries a `Date` header, the time it is sent as an HTTP-date, unless the handler gave one or `date`
// is false; the `101` answer of an upgrade carries none. The server listens with the socket options
// `listen`, `ServerListen` unless given others. A request `streamsBody` answers true for,
// asked once its head is read, is handed to `handler` with its body unread, which `handler` reads
// through `ServerRequest.bodyReader` under the same `readTimeout` and `requestTimeout`, within the
// limit it gives there rather than `maxBodyBytes`; an `Expect: 100-continue` is answered `100
// Continue` at its first read, so a handler that answers without reading tells the client not to
// send it. A body whose read failed, over its limit, malformed or too slow, is answered by the
// server as a buffered one would be, the handler's response not sent. Once the handler is done, a
// body left unread is read and dropped where at most 64 KiB of it is left and the response is not
// streamed; otherwise, or where the client was never told to continue, the connection is closed after
// the response, so no byte of the body is read as a request.
//
// Each TLS handshake takes the settings `tls` holds as it begins, so a `ReloadableTlsServer`
// reloaded while the server runs changes the certificate the connections accepted after it present
// and leaves those already open as they were. A `TlsServer` that accepts no application protocol of
// its own accepts `http/1.1` by ALPN.
//
// With `metrics`, the server counts every request it reads, answers or refuses there, a handler's
// trap among them.
serve(
    host: string,
    port: int,
    handler: Handler,
    maxConnections: int = 1024,
    readTimeout: Duration = seconds(30),
    writeTimeout: Duration = seconds(30),
    idleTimeout: Duration = seconds(5),
    maxHeaderBytes: int = 16384,
    maxBodyBytes: int = 1048576,
    tls: Option[TlsSource] = None,
    errors: ErrorPage = plainError,
    date: bool = true,
    requestTimeout: Duration = seconds(60),
    handshakeTimeout: Duration = seconds(10),
    listen: ListenOptions = ServerListen,
    streamsBody: @sendable (ServerRequest) -> bool = bufferedBodies,
    headerTimeout: Duration = seconds(10),
    maxHeaders: int = 100,
    metrics: Option[ServerMetrics] = None
) -> Result[TcpServer, IoError]
  val s = checkedSettings(
    readTimeout,
    writeTimeout,
    idleTimeout,
    requestTimeout,
    maxHeaderBytes,
    maxBodyBytes,
    errors,
    date,
    streamsBody,
    headerTimeout,
    maxHeaders,
    metrics
  )
  if handshakeTimeout.isNegative then fail(s"a handshake timeout of $handshakeTimeout: it is at least zero")
  tls match
    None -> TcpServer.start(
      host,
      port,
      (stream, server) -> converse(stream, server, handler, s, stream.hash()),
      maxConnections,
      failed = stream ->
        s.flights.abandon(stream.hash())
        if !s.streaming.release(stream) then refuse(stream, 500, s),
      listen = listen
    )
    Some(identity) -> TcpServer.start(
      host,
      port,
      (stream, server) -> secured(stream, server, handler, s, identity, handshakeTimeout),
      maxConnections,
      failed = stream ->
        s.flights.abandon(stream.hash())
        _ = stream.close(),
      listen = listen
    )

// Serves HTTP/1.1 at the Unix socket `path`, as `TcpServer.startUnix` listens there with `backlog`
// and `replacing`, for a server that a proxy on the same machine talks to: everything else is as
// `serve` does it, but with no TLS, which a connection that never leaves the machine does not need. A
// request's `remote` is `None`, a Unix connection having no address.
serveUnix(
    path: string,
    handler: Handler,
    maxConnections: int = 1024,
    readTimeout: Duration = seconds(30),
    writeTimeout: Duration = seconds(30),
    idleTimeout: Duration = seconds(5),
    maxHeaderBytes: int = 16384,
    maxBodyBytes: int = 1048576,
    errors: ErrorPage = plainError,
    date: bool = true,
    requestTimeout: Duration = seconds(60),
    backlog: int = 128,
    replacing: bool = false,
    streamsBody: @sendable (ServerRequest) -> bool = bufferedBodies,
    headerTimeout: Duration = seconds(10),
    maxHeaders: int = 100,
    metrics: Option[ServerMetrics] = None
) -> Result[TcpServer, IoError]
  val s = checkedSettings(
    readTimeout,
    writeTimeout,
    idleTimeout,
    requestTimeout,
    maxHeaderBytes,
    maxBodyBytes,
    errors,
    date,
    streamsBody,
    headerTimeout,
    maxHeaders,
    metrics
  )
  TcpServer.startUnix(
    path,
    (stream, server) -> converse(stream, server, handler, s, stream.hash()),
    maxConnections,
    failed = stream ->
      s.flights.abandon(stream.hash())
      if !s.streaming.release(stream) then refuse(stream, 500, s),
    backlog = backlog,
    replacing = replacing
  )

// The settings of a server, each limit first checked: a `maxHeaderBytes` or `maxHeaders` less than
// one, a `maxBodyBytes` less than zero or a negative `requestTimeout` or `headerTimeout` traps.
private checkedSettings(
    readTimeout: Duration,
    writeTimeout: Duration,
    idleTimeout: Duration,
    requestTimeout: Duration,
    maxHeaderBytes: int,
    maxBodyBytes: int,
    errors: ErrorPage,
    date: bool,
    streamsBody: @sendable (ServerRequest) -> bool,
    headerTimeout: Duration,
    maxHeaders: int,
    metrics: Option[ServerMetrics]
) -> Settings
  if maxHeaderBytes < 1 then fail(s"a header limit of $maxHeaderBytes bytes: it is at least one")
  if maxBodyBytes < 0 then fail(s"a body limit of $maxBodyBytes bytes: it is at least zero")
  if requestTimeout.isNegative then fail(s"a request timeout of $requestTimeout: it is at least zero")
  if headerTimeout.isNegative then fail(s"a header timeout of $headerTimeout: it is at least zero")
  if maxHeaders < 1 then fail(s"a limit of $maxHeaders headers: it is at least one")
  Settings(
    readTimeout,
    writeTimeout,
    idleTimeout,
    requestTimeout,
    headerTimeout,
    maxHeaderBytes,
    maxHeaders,
    maxBodyBytes,
    errors,
    Streaming(),
    if date then Some(DateHeader()) else None,
    streamsBody,
    metrics,
    Flights()
  )

// The socket options `serve` listens with unless given others: the listener's defaults, and each
// connection sending every write at once, since a response is written in pieces a client waits on
// whole, and probed once idle for a minute, so one whose client vanished, a stream of events or a
// WebSocket above all, which no idle timeout ends, is found out within two minutes.
val ServerListen: ListenOptions = ListenOptions(connections = TcpOptions(noDelay = true, keepAlive = Some(KeepAlive())))

// A connection served over TLS: the handshake, under the settings `identity` holds as it begins and
// done within `handshake` in all, then its requests as `converse` serves them.
private secured(
    tcp: TcpStream,
    server: TcpServer,
    handler: Handler,
    s: Settings,
    identity: TlsSource,
    handshake: Duration
)
  if tcp.setTimeout(s.readTimeout).isErr then return
  TlsStream.server(tcp, forHttp(identity.current), handshake) match
    Ok(stream) ->
      converse(stream, server, handler, s, tcp.hash(), false)
      // The conversation is over; a close notice the client never reads changes nothing.
      _ = stream.close()
    Err(_) -> ()

// `server`, accepting `http/1.1` by ALPN where it accepts no application protocol of its own.
private forHttp(server: TlsServer) -> TlsServer =
  if server.protocols.isEmpty then server.offer(["http/1.1"]) else server

// The limits a server was started with, the error page it renders its own answers by, the
// connections streaming a response, the source of its `Date` header where it sends one, and the
// metrics it keeps where it keeps them, with the requests they count as in flight.
private data Settings(
    readTimeout: Duration,
    writeTimeout: Duration,
    idleTimeout: Duration,
    requestTimeout: Duration,
    headerTimeout: Duration,
    maxHeaderBytes: int,
    maxHeaders: int,
    maxBodyBytes: int,
    errors: ErrorPage,
    streaming: Streaming,
    date: Option[DateHeader],
    streamsBody: @sendable (ServerRequest) -> bool,
    metrics: Option[ServerMetrics],
    flights: Flights
)

// The `streamsBody` of a server whose every request has its body read before its handler is called.
bufferedBodies(request: ServerRequest) -> bool = false

// The requests a server's metrics count as in flight, by the hash of their connection, so a handler
// that traps has its request counted as answering `500` when its connection fails. Two connections
// sharing a hash only share a list: the one that fails finishes the other's request too, early.
private class Flights(): Sendable
  private val held = Mutex(HeldFlights())

  // Holds `f` while the connection `key` answers it.
  hold(key: long, f: InFlight) = held.with(
    h -> h.flights = h.flights.updated(key, h.flights.getOrElse(key, Vector.empty[InFlight]()) :+ f)
  )

  // Lets `f` go, answered.
  release(key: long, f: InFlight) = held.with(h ->
    h.flights.get(key) match
      Some(v) ->
        val rest = v.filter(g -> !(g === f))
        h.flights = if rest.isEmpty then h.flights.removed(key) else h.flights.updated(key, rest)
      None -> ())

  // The connection `key` failed: each request it held is counted as answering `500`.
  abandon(key: long)
    val left = held.with(h ->
      val v = h.flights.getOrElse(key, Vector.empty[InFlight]())
      h.flights = h.flights.removed(key)
      v)
    for f in left
      _ = f.finish(500)

private class HeldFlights()
  var flights = HashMap.empty[long, Vector[InFlight]]()

// The date a server's responses carry, as the text of a `Date` header: the HTTP-date of the clock's
// now, formatted once for each second and handed to every connection that asks within it. The latest
// second and its text are one value in an `Atomic`, so connections on any thread read it without a
// lock; a thread that finds the second over writes the next text, and two threads that do so at
// once write the same one.
class DateHeader(private val clock: @sendable () -> Instant = now): Sendable
  private val latest: Atomic[DateStamp] = Atomic(stamped(clock()))

  // The `Date` header's value for the clock's now.
  value() -> string
    val t = clock()
    val seen = latest.load()
    if seen.second == t.epochSeconds then return seen.text
    val fresh = stamped(t)
    latest.store(fresh)
    fresh.text

private data DateStamp(second: long, text: string)

private stamped(t: Instant) -> DateStamp = DateStamp(t.epochSeconds, t.toHttpDate())

// The connections whose response's head has been sent while its body is streamed, so a handler that
// traps there has its connection closed without a `500` written into the middle of the body. Each
// is held by its identity's hash: two connections sharing one would only mean a trap on the second
// is closed unanswered too.
private class Streaming(): Sendable
  private val held = Mutex(Held())

  // Holds `stream` while its body is streamed.
  hold(stream: ByteStream)
    val key = stream.hash()
    held.with(h -> h.counts = h.counts.updated(key, h.counts.getOrElse(key, 0) + 1))

  // Lets `stream` go, and answers whether it was held.
  release(stream: ByteStream) -> bool
    val key = stream.hash()
    held.with(h ->
      h.counts.get(key) match
        Some(n) ->
          h.counts = if n > 1 then h.counts.updated(key, n - 1) else h.counts.removed(key)
          true
        None -> false)

private class Held()
  var counts = HashMap.empty[long, int]()

// Why a request is not served: the connection is closed quietly, or answered with a status first.
private data Refusal
  Quietly
  Answer(status: int)

// One connection's requests, read and answered in turn until it is not kept alive, its peer ends it,
// or it waits for a request longer than its limit. Where `marks`, a connection streaming a response
// is held in `s.streaming` while it does. Where the server keeps metrics, each request read is in
// flight, held under `key`, until its response is written.
private converse(stream: ByteStream, server: TcpServer, handler: Handler, s: Settings, key: long, marks: bool = true)
  val input = Incoming(stream)
  // A new connection's first request, its line and headers, is due `headerTimeout` after the
  // connection was accepted, so the wait for its first byte is no longer than that either; a later
  // one's is due `headerTimeout` after its own first byte, the idle wait before it `idleTimeout`'s.
  val accepted = monotonic()
  var first = true
  var limit = soonest(s.readTimeout, s.headerTimeout)
  while input.awaits(limit, server)
    limit = s.idleTimeout
    input.begin(s.requestTimeout, s.headerTimeout, if first then accepted else monotonic())
    first = false
    val (request, source) = readRequest(input, stream, server, s) match
      Ok(r) -> r
      Err(Quietly) -> return
      Err(Answer(status)) ->
        if s.metrics is Some(m) then m.rejected(status)
        refuse(stream, status, s)
        return
    val flight = s.metrics.map(m -> m.started(request.method))
    if flight is Some(f) then s.flights.hold(key, f)
    if server.isStopping()
      landed(flight, key, 503, s)
      refuse(stream, 503, s)
      return
    val response = handler(request)
    // A streamed body that failed is answered as a buffered one is, in place of the handler's answer.
    if source is Some(b)
      b.refusal match
        Some(Answer(status)) ->
          landed(flight, key, status, s)
          refuse(stream, status, s)
          return
        Some(Quietly) ->
          // The body broke off, so no answer can be read: counted as the client's fault.
          landed(flight, key, 400, s)
          return
        None -> ()
    if response.upgraded is Some(upgrade)
      // The bytes after the request are its body's, not the other protocol's.
      if source.exists(b -> !b.ended)
        landed(flight, key, 400, s)
        return
      landed(flight, key, 101, s)
      upgradedOut(stream, server, response, upgrade, input.rest(), s, marks)
      return
    // Whether the body has been read to its end, so what follows on the connection is a request.
    val whole = source match
      None -> true
      Some(b) -> if response.streamed.isDefined then b.ended else b.drained(drainBytes)
    val keep = whole && keepsAlive(request) && !server.isStopping() && !asksToClose(response.headers)
    val headOnly = request.method == "HEAD"
    val kept = response.streamed match
      None -> written(stream, headOnly, response, keep, request.version, s.writeTimeout, dated(s)) && keep
      Some(body) ->
        if marks then s.streaming.hold(stream)
        val going = streamedOut(
          stream,
          server,
          headOnly,
          response,
          body,
          keep,
          request.version,
          s.writeTimeout,
          dated(s)
        )
        if marks then _ = s.streaming.release(stream)
        going
    landed(flight, key, response.status, s)
    if !kept
      // A body left unread is still arriving; the connection is shut gently, so the answer is not
      // lost to a reset.
      if !whole && source.forall(b -> b.refusal.isEmpty) then lingered(stream)
      return

// Counts the request `flight` is, where the server keeps metrics, as answered `status`.
private landed(flight: Option[InFlight], key: long, status: int, s: Settings)
  if flight is Some(f)
    s.flights.release(key, f)
    _ = f.finish(status)

// Sends the `101` of `response` and hands the connection to `upgrade`, with the bytes the client sent
// after its request, which were read ahead; the connection is no longer HTTP's, so the server reads
// no request after it. Where `marks`, it is held in `s.streaming` while `upgrade` has it, so a trap
// there closes it without an HTTP `500` written into the other protocol.
private upgradedOut(
    stream: ByteStream,
    server: TcpServer,
    response: Response,
    upgrade: Upgrade,
    ahead: Array[byte],
    s: Settings,
    marks: bool
)
  val out = StringWriter()
  out.write("HTTP/1.1 101 Switching Protocols\r\n")
  out.write(s"Upgrade: ${upgrade.protocol}\r\nConnection: Upgrade\r\n")
  for (name, value) in response.headers
    checkHeader(name, value)
    val own = name.equalsIgnoreCase("Content-Length") || name.equalsIgnoreCase(
      "Transfer-Encoding"
    ) || name.equalsIgnoreCase("Connection") || name.equalsIgnoreCase("Upgrade")
    if !own then out.write(s"$name: $value\r\n")
  out.write("\r\n")
  if !(stream.setTimeout(s.writeTimeout).isOk && stream.write(utf8(out.text)).isOk) then return
  if marks then s.streaming.hold(stream)
  upgrade.take(Upgraded(stream, ahead, server, s.writeTimeout))
  if marks then _ = s.streaming.release(stream)

// Whether the client asks for its connection to stay open after this request: by default in
// HTTP/1.1, unless `Connection: close`; in HTTP/1.0 only with `Connection: keep-alive`.
private keepsAlive(request: ServerRequest) -> bool
  val words = connectionWords(request.headers)
  if request.version == "HTTP/1.0" then words.contains("keep-alive") else !words.contains("close")

private asksToClose(headers: Vector[(string, string)]) -> bool = connectionWords(headers).contains("close")

// The options of a `Connection` header, in lower case.
private connectionWords(headers: Vector[(string, string)]) -> Vector[string] =
  headerIn(headers, "Connection").getOrElse("").toLower.split(",").map(w -> w.trim)

// Answers `status` and closes the connection gently: the server's side is shut, then what the client
// still sends is read and dropped for a moment, half a second in all, so the answer is not lost to a
// reset and a client still trickling bytes does not hold the connection.
private refuse(stream: ByteStream, status: int, s: Settings)
  if written(stream, false, rendered(s.errors, status), false, "HTTP/1.1", s.writeTimeout, dated(s))
    lingered(stream)

// Shuts the server's side of the connection, then reads and drops what the client still sends, for
// half a second in all.
private lingered(stream: ByteStream)
  if stream.shutdownOutput().isErr then return
  val start = monotonic()
  var left = 1 << 20
  while left > 0
    val wait = millis(500) - (monotonic() - start)
    if wait <= Duration.Zero then return
    if stream.setTimeout(wait).isErr then return
    stream.read(65536) match
      Ok(got) ->
        if got.length == 0 then return
        left -= got.length
      Err(_) -> return

// The `Date` header's value for the response about to be written, where the server sends one.
private dated(s: Settings) -> Option[string] = s.date.map(d -> d.value())

// Writes `response`, whether or not the connection stays open, and answers whether it was written.
// The server writes `Content-Length` and `Connection` itself, in place of any the handler gave, and
// no body for `HEAD` or for `204` and `304`; `date` is the value of the `Date` header it adds where
// the handler gave none. A status outside 200 to 599, or a header the response cannot carry, traps.
// A streamed response is written by `streamedOut`; here its body is empty.
private written(
    stream: ByteStream,
    headOnly: bool,
    response: Response,
    keep: bool,
    version: string,
    limit: Duration,
    date: Option[string]
) -> bool
  val bodiless = response.status == 204 || response.status == 304
  val length = if bodiless then None else Some(s"Content-Length: ${response.body.length}")
  val all = Buffer[byte]()
  all.addAll(utf8(headOf(response, length, keep, version, date)))
  if !headOnly && !bodiless then all.addAll(response.body)
  stream.setTimeout(limit).isOk && stream.write(all.toArray()).isOk

// Writes a streamed response and answers whether the connection may carry another request. Its head
// is sent first, saying `Content-Length` where the length is known, else `Transfer-Encoding:
// chunked`, or, to an HTTP/1.0 client, neither, the connection's end ending the body. Then `body`
// writes the body through a `BodyWriter`, unless the request is `HEAD` or the status `204` or
// `304`, which have none.
private streamedOut(
    stream: ByteStream,
    server: TcpServer,
    headOnly: bool,
    response: Response,
    body: StreamedBody,
    keep: bool,
    version: string,
    limit: Duration,
    date: Option[string]
) -> bool
  val bodiless = response.status == 204 || response.status == 304
  val framing = body.length match
    Some(n) -> Sized(n)
    None -> if version == "HTTP/1.0" then Closing else Chunked
  val going = keep && framing != Closing
  val line = if bodiless then None else framing match
    Sized(n) -> Some(s"Content-Length: $n")
    Chunked -> Some("Transfer-Encoding: chunked")
    Closing -> None
  if !(
    stream.setTimeout(limit).isOk && stream.write(utf8(headOf(response, line, going, version, date))).isOk
  ) then return false
  if headOnly || bodiless then return going
  val writer = BodyWriter(stream, Some(server), framing, limit)
  body.write(writer)
  writer.finish() && going

// The status line and headers of `response`, with `framing`, the line saying how its body is framed,
// where it has one, the `Connection` header `keep` and `version` call for, and a `Date` header of
// `date` where the response has none of its own.
private headOf(
    response: Response,
    framing: Option[string],
    keep: bool,
    version: string,
    date: Option[string]
) -> string
  if !(200 <= response.status <= 599) then fail(
    s"a response of status ${response.status}: a handler answers 200 to 599"
  )
  if response.reason.indexWhere(c -> c == '\r' || c == '\n') >= 0 then fail(
    s"the reason `${response.reason}` holds a line break"
  )
  val out = StringWriter()
  out.write(s"HTTP/1.1 ${response.status} ${response.reason}\r\n")
  for (name, value) in response.headers
    if name.isEmpty || name.indexWhere(c -> !isTokenChar(c)) >= 0 then fail(s"`$name` is not a header name")
    if value.indexWhere(c -> c == '\r' || c == '\n') >= 0 then fail(
      s"the value of the header `$name` holds a line break"
    )
    val own = name.equalsIgnoreCase("Content-Length") || name.equalsIgnoreCase(
      "Transfer-Encoding"
    ) || name.equalsIgnoreCase("Connection")
    if !own then out.write(s"$name: $value\r\n")
  if date is Some(d) && headerIn(response.headers, "Date").isEmpty then out.write(s"Date: $d\r\n")
  if framing is Some(f) then out.write(s"$f\r\n")
  if !keep then out.write("Connection: close\r\n")
  else if version == "HTTP/1.0" then out.write("Connection: keep-alive\r\n")
  out.write("\r\n")
  out.text

// The bytes of a connection, read ahead in pieces and handed out as lines and counted runs.
private class Incoming(private val stream: ByteStream)
  private var ahead: Array[byte] = Array.empty[byte]()
  private var at = 0
  // When the request being read began, on the monotonic clock, and how long it may take in all;
  // and when its line and headers are due, `Duration.Zero` once they are read or where there is no
  // such limit. A zero budget is no limit.
  private var started = Duration.Zero
  private var budget = Duration.Zero
  private var headersDue = Duration.Zero

  // Begins a request, which must be read whole within `limit` from now, and its line and headers
  // within `headers` of `from`, a time on the monotonic clock no later than now; zero is no limit.
  begin(limit: Duration, headers: Duration, from: Duration)
    started = monotonic()
    budget = limit
    headersDue = if headers > Duration.Zero then from + headers else Duration.Zero

  // The request's line and headers are read; only its whole bound is left.
  headersRead()
    headersDue = Duration.Zero

  // Whether a byte is waiting, or arrives within `limit`. The wait is the connection's idle one,
  // through `server.idle`, so a server that stops ends it at once and it answers false.
  awaits(limit: Duration, server: TcpServer) -> bool
    if at < ahead.length then return true
    if stream.setTimeout(limit).isErr then return false
    val s = stream
    server.idle(() -> s.read(8192).map(got -> got.toVector)) match
      Some(Ok(got)) ->
        if got.isEmpty then return false
        ahead = got.toArray()
        at = 0
        true
      _ -> false

  // The next line without its terminator, `\r\n`, holding at most `room` bytes: a longer one is
  // answered `tooLong`. A line ended by a bare `\n`, or holding a control character other than a
  // tab (a NUL, a bare `\r`, DEL among them), is answered `400`, as RFC 9112 lets a server do, so
  // no two readers of one request can frame it differently.
  line(limit: Duration, room: int, tooLong: int) -> Result[string, Refusal]
    val out = Buffer[byte]()
    var cr = false
    loop
      while at < ahead.length
        val b = ahead(at)
        at += 1
        val code = int(b) & 255
        if code == int('\n')
          if !cr then return Err(Answer(400))
          return Ok(string.fromUtf8Lossy(out.toArray()))
        if cr || code == 127 || (code < 32 && code != int('\t') && code != int('\r'))
          return Err(Answer(400))
        if code == int('\r')
          cr = true
        else
          if out.length >= room then return Err(Answer(tooLong))
          out.addOne(b)
      fill(limit)?
    Err(Quietly)

  // The bytes read ahead and not yet handed out.
  rest() -> Array[byte] = ahead.slice(at, ahead.length)

  // Exactly `n` bytes.
  bytes(n: int, limit: Duration) -> Result[Array[byte], Refusal]
    val out = Buffer[byte]()
    while out.length < n
      if at == ahead.length then fill(limit)?
      val end = if ahead.length - at > n - out.length then at + n - out.length else ahead.length
      out.addAll(ahead.slice(at, end))
      at = end
    Ok(out.toArray())

  // Up to `max` bytes, at least one: those read ahead, or else the next piece to arrive.
  some(max: int, limit: Duration) -> Result[Array[byte], Refusal]
    if at == ahead.length then fill(limit)?
    val end = if ahead.length - at > max then at + max else ahead.length
    val out = ahead.slice(at, end)
    at = end
    Ok(out)

  // Reads the next piece, waiting at most `limit` and no later than the request's budget allows: a
  // wait that runs out, or a budget already spent, is answered `408`, and a peer that has finished
  // or failed ends the connection quietly.
  private fill(limit: Duration) -> Result[unit, Refusal]
    var wait = limit
    val clock = monotonic()
    if budget > Duration.Zero
      val left = budget - (clock - started)
      if left <= Duration.Zero then return Err(Answer(408))
      wait = soonest(wait, left)
    if headersDue > Duration.Zero
      val left = headersDue - clock
      if left <= Duration.Zero then return Err(Answer(408))
      wait = soonest(wait, left)
    if stream.setTimeout(wait).isErr then return Err(Quietly)
    stream.read(8192) match
      Ok(got) ->
        if got.length == 0 then return Err(Quietly)
        ahead = got
        at = 0
        Ok(())
      Err(IoError(TimedOut, _, _)) -> Err(Answer(408))
      Err(_) -> Err(Quietly)

// The nearer of two time limits, where zero or less is none.
private soonest(a: Duration, b: Duration) -> Duration =
  if a <= Duration.Zero then b else if b <= Duration.Zero || a < b then a else b

// One request: its request line, its headers and its body, or, where `s.streamsBody` answers true for
// its head, its body's source, left on the connection.
private readRequest(
    input: Incoming,
    stream: ByteStream,
    server: TcpServer,
    s: Settings
) -> Result[(ServerRequest, Option[BodySource]), Refusal]
  var room = s.maxHeaderBytes
  var first = input.line(s.readTimeout, room, 414)?
  // Empty lines before a request line are passed over, counted against the limit.
  while first.isEmpty
    room -= 2
    if room <= 0 then return Err(Answer(400))
    first = input.line(s.readTimeout, room, 414)?
  room -= first.byteLength + 2
  if first.indexOf('\t') >= 0 then return Err(Answer(400))
  val words = first.split(" ")
  if words.length != 3 then return Err(Answer(400))
  val method = words(0)
  val target = words(1)
  val version = words(2)
  if method.isEmpty || method.indexWhere(c -> !isTokenChar(c)) >= 0 then return Err(Answer(400))
  if !isVersion(version) then return Err(Answer(400))
  if version != "HTTP/1.1" && version != "HTTP/1.0" then return Err(Answer(505))
  if targetOf(target).isEmpty then return Err(Answer(400))
  val headers = Buffer[(string, string)]()
  loop
    if room < 0 then return Err(Answer(431))
    val line = input.line(s.readTimeout, room, 431)?
    room -= line.byteLength + 2
    if line.isEmpty then break
    // A header folded onto a second line is refused, as RFC 9112 allows.
    if line.startsWith(" ") || line.startsWith("\t") then return Err(Answer(400))
    val colon = line.indexOf(':')
    if colon <= 0 then return Err(Answer(400))
    val name = line.slice(0, colon)
    if name.indexWhere(c -> !isTokenChar(c)) >= 0 then return Err(Answer(400))
    if headers.length >= s.maxHeaders then return Err(Answer(431))
    headers.addOne((name, line.slice(colon + 1, line.byteLength).trim))
  input.headersRead()
  val all = headers.toVector
  val hosts = all.count(h -> h.0.equalsIgnoreCase("Host"))
  if hosts > 1 || (version == "HTTP/1.1" && hosts == 0) then return Err(Answer(400))
  // A body's framing read two ways is how one request is smuggled inside another: a
  // `Transfer-Encoding` in HTTP/1.0, which knows none, or in two field lines, of which a reader
  // taking only one would see another coding, is refused (RFC 9112 section 6.1).
  val codings = all.count(h -> h.0.equalsIgnoreCase("Transfer-Encoding"))
  if codings > 1 || (codings == 1 && version == "HTTP/1.0") then return Err(Answer(400))
  val framing = framingOf(all)?
  val continues = headerIn(all, "Expect").isDefined && version == "HTTP/1.1"
  val head = ServerRequest(method, target, all, version = version, remote = stream.remoteAddress, server = Some(server))
  if s.streamsBody(head)
    val source = BodySource(input, stream, s, framing, continues)
    val request = ServerRequest(
      method,
      target,
      all,
      version = version,
      remote = stream.remoteAddress,
      server = Some(server),
      source = Some(source)
    )
    return Ok((request, Some(source)))
  val body = readBody(input, stream, framing, continues, s)?
  Ok((ServerRequest(method, target, all, body, version, remote = stream.remoteAddress, server = Some(server)), None))

// `HTTP/` and a digit, a dot and a digit.
private isVersion(text: string) -> bool =
  text.byteLength == 8 && text.startsWith("HTTP/") && isDigit(
    text.byteAt(5)
  ) && text.byteAt(6) == byte(int('.')) && isDigit(text.byteAt(7))

private isDigit(b: byte) -> bool = int('0') <= int(b) <= int('9')

// How the headers frame the body: chunked, of a `Content-Length`, or none. A request whose framing
// could be read two ways, or does not read, is answered `400`, a coding other than `chunked` `501`,
// and an expectation other than `100-continue` `417`.
private framingOf(headers: Vector[(string, string)]) -> Result[BodyFraming, Refusal]
  val expect = headerIn(headers, "Expect")
  if expect is Some(e) && !e.equalsIgnoreCase("100-continue") then return Err(Answer(417))
  val lengths = headers.filter(h -> h.0.equalsIgnoreCase("Content-Length")).map(h -> h.1)
  headerIn(headers, "Transfer-Encoding") match
    Some(encoding) ->
      // A length beside a coding could be read two ways, so the request is refused.
      if !lengths.isEmpty then return Err(Answer(400))
      val codings = encoding.split(",").map(c -> c.trim.toLower)
      if codings(codings.length - 1) != "chunked" then return Err(Answer(400))
      if codings.length > 1 then return Err(Answer(501))
      Ok(ChunkCoded)
    None ->
      if lengths.isEmpty then return Ok(NoBody)
      val n = lengthOf(lengths(0)) match
        Some(k) -> k
        None -> return Err(Answer(400))
      for other in lengths
        if lengthOf(other) != Some(n) then return Err(Answer(400))
      Ok(if n == 0 then NoBody else Announced(n))

// The body `framing` announces, read whole. Where `continues`, the client's `Expect: 100-continue`
// is answered `100 Continue` once the body is known to fit.
private readBody(
    input: Incoming,
    stream: ByteStream,
    framing: BodyFraming,
    continues: bool,
    s: Settings
) -> Result[Array[byte], Refusal]
  framing match
    NoBody -> Ok(Array.empty[byte]())
    Announced(n) ->
      if n > long(s.maxBodyBytes) then return Err(Answer(413))
      if continues then sayContinue(stream, s)?
      input.bytes(int(n), s.readTimeout)
    ChunkCoded ->
      if continues then sayContinue(stream, s)?
      readChunked(input, s)

// Tells the client to go on and send the body it waits to send.
private sayContinue(stream: ByteStream, s: Settings) -> Result[unit, Refusal]
  if stream.setTimeout(s.writeTimeout).isErr then return Err(Quietly)
  stream.write(utf8("HTTP/1.1 100 Continue\r\n\r\n")).mapErr(_ -> Quietly)

// The value of a `Content-Length`, digits only, or `None`; a value past any limit is held at 10^15.
private lengthOf(text: string) -> Option[long]
  if text.isEmpty then return None
  var n: long = 0
  for c in text.chars
    if !('0' <= c <= '9') then return None
    if n < 100000000000000 then n = n * 10 + long(int(c) - int('0'))
  Some(n)

// A chunked body: chunks, each its size in hexadecimal on a line and then its bytes and a line end,
// until one of size zero, then trailer lines, counted against the header limit, until an empty one.
private readChunked(input: Incoming, s: Settings) -> Result[Array[byte], Refusal]
  val out = Buffer[byte]()
  loop
    val line = input.line(s.readTimeout, 1024, 400)?
    val semicolon = line.indexOf(';')
    val size = chunkSize((if semicolon >= 0 then line.slice(0, semicolon) else line).trim) match
      Some(n) -> n
      None -> return Err(Answer(400))
    if size == 0
      var room = s.maxHeaderBytes
      loop
        val trailer = input.line(s.readTimeout, room, 431)?
        if trailer.isEmpty then return Ok(out.toArray())
        room -= trailer.byteLength + 2
        if room <= 0 then return Err(Answer(431))
    if long(out.length) + size > long(s.maxBodyBytes) then return Err(Answer(413))
    out.addAll(input.bytes(int(size), s.readTimeout)?)
    val end = input.line(s.readTimeout, 1, 400)?
    if !end.isEmpty then return Err(Answer(400))
  Ok(out.toArray())

// The value of hexadecimal digits, `None` for none or for any other character; a value past any
// limit is held at 16^13.
private chunkSize(text: string) -> Option[long]
  if text.isEmpty then return None
  var n: long = 0
  for c in text.chars
    val d = hexDigit(c)
    if d < 0 then return None
    if n < 4503599627370496 then n = n * 16 + long(d)
  Some(n)
