module avin.net.http

// HTTP/1.1's requests and responses, which the client sends and reads and the server reads and
// answers. The client, `send`, `get` and the others and the pooling `Client`, is in `client.avin`
// beside this file, and the server, `serve`, in `server.avin`; a `Response` is what its handlers
// answer.

import avin.compress.{CompressError, defaultMaxBytes}
import avin.encoding.toBase64
import avin.html.Html
import avin.io.IoError
import avin.net.{Url, UrlError}
import avin.net.tls.{TlsClient, TlsError}
import avin.time.{Duration, seconds}

// Why a request has no response.
data HttpError
  // The connection failed: it could not be made, or broke, or timed out.
  Io(error: IoError)
  // The request's URL is not one.
  BadUrl(error: UrlError)
  // The reply is not HTTP, or breaks off in the middle.
  Malformed(text: string)
  // The request asks for something the client does not do, such as a scheme other than `http`
  // and `https`.
  Unsupported(text: string)
  // TLS for an `https` URL could not be set up: the server's certificate was refused, the
  // handshake failed, or a certificate the request trusts cannot be read. A connection that could
  // not be made, broke or timed out is `Io`, for `https` as for `http`.
  Tls(error: TlsError)
  // The reply is over one of the client's limits: its head over `maxHeaderBytes`, or the body of a
  // response read whole over `maxResponseBytes`.
  TooLarge(text: string)
  // The proxy an `https` URL goes by answered its `CONNECT` with `status`, not a `2xx`, opening no
  // tunnel: a `407` where it wants credentials it was not given or refuses those it was.
  ProxyRefused(status: int, reason: string)
  // The response's body, compressed by the server, could not be decompressed: it is corrupt, ends
  // early, or decompresses past the request's limit.
  Decoding(error: CompressError)

impl Error for HttpError
  // A sentence saying what went wrong, for a message to a person.
  message -> string = self match
    Io(e) -> e.message
    BadUrl(e) -> s"bad URL: ${e.message}"
    Malformed(t) -> s"malformed reply: $t"
    Unsupported(t) -> s"unsupported: $t"
    Tls(e) -> e.message
    TooLarge(t) -> s"reply too large: $t"
    ProxyRefused(status, reason) -> s"the proxy refused the tunnel: $status $reason"
    Decoding(e) -> s"the response body: ${e.message}"

// A request: its method, its URL as text, the headers sent besides the ones the client writes, its
// body, how long a read or write on its connection may wait, the TLS settings an `https` URL is
// fetched with, by redirect too, how long looking the host up, connecting and an `https` URL's
// TLS handshake may take together, for each connection the request makes, and how long the whole
// request may take, redirects and reading the response included. A method is a token, such
// as `GET`, a header's name is a token and its value holds no line break; a request where one does
// not hold, or whose `connectTimeout` or `totalTimeout` is negative, traps as it is made, its
// headers given to the constructor as much as those added by `withHeader`.
//
// Unless `decoding` is `None`, the client asks for a compressed response, sending `Accept-Encoding:
// gzip`, and decompresses a body the server sent as `gzip`, `x-gzip` or `deflate`, within `decoding`
// bytes (100 MiB unless given), so the response's `body`, or the reader `Client.stream` hands over,
// is the decompressed bytes and its headers carry no `Content-Encoding` or `Content-Length`; a body
// that is corrupt, ends early or passes the limit fails the request with `Decoding`. A request that
// sends its own `Accept-Encoding` gets the body as the server sent it, as one with `decoding` of
// `None` does. A body of another coding is left as it came.
class Request(
    val method: string,
    val url: string,
    val headers: Vector[(string, string)] = Vector.empty[(string, string)](),
    val body: Array[byte] = Array.empty[byte](),
    val timeout: Option[Duration] = None,
    val tls: TlsClient = TlsClient(),
    val connectTimeout: Duration = seconds(30),
    val totalTimeout: Duration = Duration.Zero,
    val decoding: Option[long] = Some(defaultMaxBytes)
)
  if method.isEmpty || method.indexWhere(c -> !isTokenChar(c)) >= 0 then fail(s"`$method` is not an HTTP method")
  if connectTimeout.isNegative then fail(s"a connect timeout of $connectTimeout: it is at least zero")
  if totalTimeout.isNegative then fail(s"a total timeout of $totalTimeout: it is at least zero")
  if decoding is Some(n) && n < 0 then fail(s"a decompression limit of $n bytes: it is at least zero")
  for (name, value) in headers
    checkHeader(name, value)

  // The request with a header added after the ones it has. `Host`, `Content-Length` and
  // `Connection`, given here, replace the ones the client would write.
  withHeader(name: string, value: string) -> Request = Request(
    method,
    url,
    headers :+ (name, value),
    body,
    timeout,
    tls,
    connectTimeout,
    totalTimeout,
    decoding
  )

  // The value of the first header of `name`, compared without regard to case.
  header(name: string) -> Option[string] = headerIn(headers, name)

  // The request with `Authorization: Basic` and `user` and `password` (RFC 7617), as UTF-8, for its
  // only `Authorization`. Like every `Authorization`, it is dropped on a redirect to another origin. A
  // `user` holding `:`, or either holding a control character, traps.
  withBasicAuth(user: string, password: string) -> Request
    if user.indexOf(':') >= 0 then fail("a user name for basic authentication holds `:`")
    if user.exists(isControl) || password.exists(isControl)
      fail("a user name or password for basic authentication holds a control character")
    authorized("Basic " + toBase64(s"$user:$password"))

  // The request with `Authorization: Bearer token` (RFC 6750) for its only `Authorization`, dropped on
  // a redirect to another origin as `withBasicAuth`'s is. A `token` that is empty or not a `token68`
  // (letters, digits, `-`, `.`, `_`, `~`, `+` and `/`, then any `=`) traps.
  withBearer(token: string) -> Request
    if !isToken68(token) then fail("a bearer token is not a token68")
    authorized("Bearer " + token)

  private authorized(value: string) -> Request = Request(
    method,
    url,
    withoutHeader(headers, "Authorization") :+ ("Authorization", value),
    body,
    timeout,
    tls,
    connectTimeout,
    totalTimeout,
    decoding
  )

  // The request with the headers of `more` added after the ones it has, in order.
  withHeaders(more: Vector[(string, string)]) -> Request =
    Request(method, url, headers ++ more, body, timeout, tls, connectTimeout, totalTimeout, decoding)

  // The request with the query parameter `name=value` added after any its URL has, each encoded by
  // `Url.encode`, and before the URL's fragment.
  withQueryParam(name: string, value: string) -> Request =
    Request(method, withParam(url, name, value), headers, body, timeout, tls, connectTimeout, totalTimeout, decoding)

  // The request with `text`, as UTF-8, for its body.
  withBody(text: string) -> Request = withBody(utf8(text))

  // The request with `bytes` for its body.
  withBody(bytes: Array[byte]) -> Request =
    Request(method, url, headers, bytes, timeout, tls, connectTimeout, totalTimeout, decoding)

  // The request with `pairs` for its body, written as `application/x-www-form-urlencoded` by
  // `Url.formEncode`, and that for its `Content-Type`, replacing any it has.
  withForm(pairs: Vector[(string, string)]) -> Request =
    typed("application/x-www-form-urlencoded", utf8(Url.formEncode(pairs)))

  // The request with `form` for its body, written as `multipart/form-data` between delimiters of a
  // fresh `Multipart.newBoundary()`, and that type with the boundary for its `Content-Type`,
  // replacing any it has.
  withMultipart(form: Multipart) -> Request = withMultipart(form, Multipart.newBoundary())

  // As `withMultipart(form)`, with `boundary` for the delimiters; one `Multipart.encoded` refuses
  // traps.
  withMultipart(form: Multipart, boundary: string) -> Request = typed(
    form.contentType(boundary),
    form.encoded(boundary)
  )

  // The request with `bytes` for its body and `contentType` for its only `Content-Type`.
  private typed(contentType: string, bytes: Array[byte]) -> Request = Request(
    method,
    url,
    withoutHeader(headers, "Content-Type") :+ ("Content-Type", contentType),
    bytes,
    timeout,
    tls,
    connectTimeout,
    totalTimeout,
    decoding
  )

  // The request with a read or write on its connection, the TLS handshake's included, failing with
  // `TimedOut` after waiting `d`.
  withTimeout(d: Duration) -> Request =
    Request(method, url, headers, body, Some(d), tls, connectTimeout, totalTimeout, decoding)

  // The request fetching an `https` URL with `client`'s settings: the machine's trusted
  // authorities and those `client` adds.
  withTls(client: TlsClient) -> Request =
    Request(method, url, headers, body, timeout, client, connectTimeout, totalTimeout, decoding)

  // The request with looking the host up, connecting and an `https` URL's TLS handshake together
  // failing with `TimedOut` once they have taken `d`, on each connection it makes; zero takes the
  // limit away, and a negative `d` traps. A `Client` waiting for a place among its connections to
  // the host waits within the same limit.
  withConnectTimeout(d: Duration) -> Request =
    Request(method, url, headers, body, timeout, tls, d, totalTimeout, decoding)

  // The request with the whole of it, from the call that sends it until its response is answered,
  // failing with `TimedOut` once it has taken `d`: getting a connection, writing the request, every
  // redirect followed, and reading the response, its body included, or, for `Client.stream`, the
  // function given the response. Zero, the default, takes the limit away; a negative `d` traps.
  withTotalTimeout(d: Duration) -> Request =
    Request(method, url, headers, body, timeout, tls, connectTimeout, d, decoding)

  // The request asking for a compressed response and decompressing it within `maxBytes`; a limit
  // below zero traps.
  withDecoding(maxBytes: long) -> Request =
    Request(method, url, headers, body, timeout, tls, connectTimeout, totalTimeout, Some(maxBytes))

  // The request asking for no compressed response, and taking any body as the server sent it.
  withoutDecoding() -> Request = Request(method, url, headers, body, timeout, tls, connectTimeout, totalTimeout, None)

// A response: its status and reason, its headers as they came, name and value, and its body. A
// response a server writes may instead be `streamed`, its body written as the handler makes it,
// and its `body` is then empty; or it may be `upgraded`, the connection switching to another
// protocol once its head is sent.
class Response(
    val status: int,
    val reason: string,
    val headers: Vector[(string, string)],
    val body: Array[byte],
    val streamed: Option[StreamedBody] = None,
    val upgraded: Option[Upgrade] = None
)
  // The value of the first header of `name`, compared without regard to case.
  header(name: string) -> Option[string] = headerIn(headers, name)

  // The body read as UTF-8, a sequence that is not UTF-8 read as U+FFFD.
  text -> string = string.fromUtf8Lossy(body)

  // The response with a header added after the ones it has. A header's name is a token and its
  // value holds no line break; either traps where it does not hold.
  withHeader(name: string, value: string) -> Response
    checkHeader(name, value)
    Response(status, reason, headers :+ (name, value), body, streamed, upgraded)

// How a streamed response's body is written: by `write`, given a writer onto the connection, in
// `length` bytes where that is known beforehand.
class StreamedBody(val length: Option[long], val write: (BodyWriter) -> unit)

// How an upgraded connection is carried on: by `take`, given the connection once the `101` is sent.
class Upgrade(val protocol: string, val take: (Upgraded) -> unit)

object Response
  // A response of `status` whose body `write` writes as it goes, of the type `contentType`, through
  // the `BodyWriter` it is given, in chunks, each write sent at once.
  stream(status: int, contentType: string, write: (BodyWriter) -> unit) -> Response =
    streamedOf(status, contentType, None, write)

  // As `stream(status, contentType, write)`, the body being exactly `length` bytes, said beforehand
  // in its `Content-Length`. A negative length traps.
  stream(status: int, contentType: string, length: long, write: (BodyWriter) -> unit) -> Response
    if length < 0 then fail(s"a streamed body of $length bytes: its length is at least zero")
    streamedOf(status, contentType, Some(length), write)

  // A stream of server-sent events, `200` of the type `text/event-stream`, which `write` sends
  // through the `EventWriter` it is given. While it waits through the writer's `untilStopped`, a
  // comment is sent every fifteen seconds, so a client that has gone is noticed and one still there
  // keeps the stream open.
  events(write: (EventWriter) -> unit) -> Response = events(seconds(15), write)

  // As `events(write)`, sending a comment every `keepAlive` while it waits, none for zero.
  events(keepAlive: Duration, write: (EventWriter) -> unit) -> Response = Response(
    200,
    reasonPhrase(200),
    Vector(("Content-Type", "text/event-stream"), ("Cache-Control", "no-cache")),
    Array.empty[byte](),
    Some(StreamedBody(None, w -> write(EventWriter(w, keepAlive))))
  )

  // A `101 Switching Protocols` to `protocol`, a token such as `websocket`: once the server has
  // sent it, with `Upgrade: protocol` and `Connection: Upgrade`, the connection is no longer HTTP's
  // and `take` carries it on, given the `Upgraded` connection; the server closes it when `take`
  // returns. A protocol that is not a token traps.
  upgrade(protocol: string, take: (Upgraded) -> unit) -> Response
    if protocol.isEmpty || protocol.indexWhere(c -> !isTokenChar(c)) >= 0 then fail(
      s"`$protocol` is not a protocol to upgrade to"
    )
    Response(
      101,
      reasonPhrase(101),
      Vector.empty[(string, string)](),
      Array.empty[byte](),
      None,
      Some(Upgrade(protocol, take))
    )

  private streamedOf(status: int, contentType: string, length: Option[long], write: (BodyWriter) -> unit) -> Response =
    Response(
      status,
      reasonPhrase(status),
      Vector(("Content-Type", contentType)),
      Array.empty[byte](),
      Some(StreamedBody(length, write))
    )

  // A response of `status` whose body is `text` as UTF-8, of the type `text/plain; charset=utf-8`.
  text(status: int, text: string) -> Response =
    Response(status, reasonPhrase(status), Vector(("Content-Type", "text/plain; charset=utf-8")), utf8(text))

  // A response of `status` whose body is `text`, HTML already written, as UTF-8, of the type
  // `text/html; charset=utf-8`. The text is sent as it is given, neither checked nor escaped.
  html(status: int, text: string) -> Response =
    Response(status, reasonPhrase(status), Vector(("Content-Type", "text/html; charset=utf-8")), utf8(text))

  // A response of `status` whose body is the markup `page`, such as `html"…"` builds, as UTF-8, of
  // the type `text/html; charset=utf-8`.
  html(status: int, page: Html) -> Response = html(status, page.text)

  // A response of `status` whose body is `text`, JSON already written, as UTF-8, of the type
  // `application/json`. The text is sent as it is given, not checked to be JSON.
  json(status: int, text: string) -> Response =
    Response(status, reasonPhrase(status), Vector(("Content-Type", "application/json")), utf8(text))

  // A response of `status` whose body is `body`, of the type `contentType`.
  bytes(status: int, body: Array[byte], contentType: string) -> Response =
    Response(status, reasonPhrase(status), Vector(("Content-Type", contentType)), body)

  // A response of `status` with no headers and no body.
  empty(status: int) -> Response = Response(
    status,
    reasonPhrase(status),
    Vector.empty[(string, string)](),
    Array.empty[byte]()
  )

// The reason phrase RFC 9110 gives `status`, or an empty one for a status it does not name.
reasonPhrase(status: int) -> string
reasonPhrase(100) = "Continue"
reasonPhrase(101) = "Switching Protocols"
reasonPhrase(200) = "OK"
reasonPhrase(201) = "Created"
reasonPhrase(202) = "Accepted"
reasonPhrase(203) = "Non-Authoritative Information"
reasonPhrase(204) = "No Content"
reasonPhrase(205) = "Reset Content"
reasonPhrase(206) = "Partial Content"
reasonPhrase(300) = "Multiple Choices"
reasonPhrase(301) = "Moved Permanently"
reasonPhrase(302) = "Found"
reasonPhrase(303) = "See Other"
reasonPhrase(304) = "Not Modified"
reasonPhrase(307) = "Temporary Redirect"
reasonPhrase(308) = "Permanent Redirect"
reasonPhrase(400) = "Bad Request"
reasonPhrase(401) = "Unauthorized"
reasonPhrase(403) = "Forbidden"
reasonPhrase(404) = "Not Found"
reasonPhrase(405) = "Method Not Allowed"
reasonPhrase(406) = "Not Acceptable"
reasonPhrase(408) = "Request Timeout"
reasonPhrase(409) = "Conflict"
reasonPhrase(410) = "Gone"
reasonPhrase(411) = "Length Required"
reasonPhrase(412) = "Precondition Failed"
reasonPhrase(413) = "Content Too Large"
reasonPhrase(414) = "URI Too Long"
reasonPhrase(415) = "Unsupported Media Type"
reasonPhrase(416) = "Range Not Satisfiable"
reasonPhrase(417) = "Expectation Failed"
reasonPhrase(422) = "Unprocessable Content"
reasonPhrase(426) = "Upgrade Required"
reasonPhrase(429) = "Too Many Requests"
reasonPhrase(431) = "Request Header Fields Too Large"
reasonPhrase(500) = "Internal Server Error"
reasonPhrase(501) = "Not Implemented"
reasonPhrase(502) = "Bad Gateway"
reasonPhrase(503) = "Service Unavailable"
reasonPhrase(504) = "Gateway Timeout"
reasonPhrase(505) = "HTTP Version Not Supported"
reasonPhrase(_) = ""

// The value of the first header of `name` in `headers`, compared without regard to case.
private headerIn(headers: Vector[(string, string)], name: string) -> Option[string]
  for (n, v) in headers
    if n.equalsIgnoreCase(name) then return Some(v)
  None

// `headers` without those of `name`, compared without regard to case.
private withoutHeader(headers: Vector[(string, string)], name: string) -> Vector[(string, string)]
  val kept = Buffer[(string, string)]()
  for (n, v) in headers
    if !n.equalsIgnoreCase(name) then kept.addOne((n, v))
  kept.toVector

// A character a method or a header's name may hold: a letter, a digit, or one of RFC 9110's marks.
private isTokenChar(c: char) -> bool =
  ('a' <= c <= 'z') || ('A' <= c <= 'Z') || ('0' <= c <= '9') || "!#$%&'*+-.^_`|~".indexOf(c) >= 0

// Traps where `name` is not a header name, a token, or `value` holds a line break.
private checkHeader(name: string, value: string)
  if name.isEmpty || name.indexWhere(c -> !isTokenChar(c)) >= 0 then fail(s"`$name` is not a header name")
  if value.indexWhere(c -> c == '\r' || c == '\n') >= 0 then fail(s"the value of the header `$name` holds a line break")

// `url` with `name=value`, each encoded, added to its query, before its fragment.
private withParam(url: string, name: string, value: string) -> string
  val hash = url.indexOf('#')
  val before = if hash >= 0 then url.slice(0, hash) else url
  val after = if hash >= 0 then url.slice(hash, url.byteLength) else ""
  val joiner = if before.indexOf('?') < 0 then "?" else if before.endsWith("?") || before.endsWith("&") then "" else "&"
  s"$before$joiner${Url.encode(name)}=${Url.encode(value)}$after"

// The UTF-8 bytes of `text`.
private utf8(text: string) -> Array[byte] = Array.tabulate(text.byteLength, i -> text.byteAt(i))

// Whether `text` is a `token68` (RFC 9110 section 11.2): one or more of letters, digits, `-`, `.`,
// `_`, `~`, `+` and `/`, then any number of `=`.
private isToken68(text: string) -> bool
  val end = text.indexWhere(c -> c == '=')
  val body = if end < 0 then text else text.slice(0, end)
  val pad = if end < 0 then "" else text.slice(end, text.byteLength)
  !body.isEmpty && body.forall(c ->
    (
      'a' <= c <= 'z'
    ) || ('A' <= c <= 'Z') || ('0' <= c <= '9') || c == '-' || c == '.' || c == '_' || c == '~' || c == '+'
      || c == '/'
  ) && pad.forall(c -> c == '=')
