module avin.net

import avin.io.{IoError, Reader}
import avin.time.Duration

// A connection that carries bytes both ways: a `TcpStream`, a `UnixStream`, or a TLS one over a
// `TcpStream`. Code that speaks a protocol takes a `ByteStream` and runs over any of them. Each may be
// handed to another thread or actor, which takes it over. It is a `Reader`: its `read(max)` gives up
// to `max` bytes, waiting for at least one, and an empty array once the other end has finished
// sending, so anything that reads a `Reader` (a streaming JSON reader, say) reads a connection.
trait ByteStream: Sendable, Reader
    // The next line, without its terminator, or `None` once the other end has finished sending and
    // every line has been read. A line ends at `\n`, a `\r` just before it being part of the
    // terminator; bytes that are not UTF-8 become U+FFFD.
    readLine() -> Result[Option[string], IoError]

    // Everything the other end sends until it finishes, after what earlier reads left.
    readAll() -> Result[Array[byte], IoError]

    // Sends all of `bytes`.
    write(bytes: Array[byte]) -> Result[unit, IoError]

    // Sends `text` as UTF-8.
    writeText(text: string) -> Result[unit, IoError]

    // A wait longer than `d` fails with `TimedOut` from now on; zero or less takes the limit away.
    setTimeout(d: Duration) -> Result[unit, IoError]

    // Tells the other end nothing more will be sent; reading goes on.
    shutdownOutput() -> Result[unit, IoError]

    // Ends the connection; closing again does nothing.
    close() -> unit
