module avin.net

import avin.io.{ByteWriter, Close, IoError, Reader}
import avin.threads.{Readiness, Writability}
import avin.time.Duration

// A connection that carries bytes both ways: a `TcpStream`, a `UnixStream`, or a TLS one over a
// `TcpStream`. Code that speaks a protocol takes a `ByteStream` and runs over any of them. Each may be
// handed to another thread or actor, which takes it over. It is a `Reader`: its `read(max)` gives up
// to `max` bytes, waiting for at least one, and an empty array once the other end has finished
// sending, so anything that reads a `Reader` (a streaming JSON reader, say) reads a connection. It is
// a `ByteWriter`: its `write(bytes)` sends all of them, so anything that writes to a `ByteWriter`
// writes to a connection. It is a `Close`: `close()` ends the connection, and closing again does
// nothing and answers `Ok`. It is a `Readiness`: `readable()` says at once whether a read would
// answer without waiting, and a `select` waits for it with a `stream.readable()` arm beside its
// channel arms. It is a `Writability`: `writable()` says at once whether a write would send something
// without waiting, and a `stream.writable()` arm waits for that.
trait ByteStream: Sendable, Reader, ByteWriter, Close, Readiness, Writability
  // The next line, without its terminator, or `None` once the other end has finished sending and
  // every line has been read. A line ends at `\n`, a `\r` just before it being part of the
  // terminator; bytes that are not UTF-8 become U+FFFD.
  readLine() -> Result[Option[string], IoError]

  // Everything the other end sends until it finishes, after what earlier reads left.
  readAll() -> Result[Array[byte], IoError]

  // Sends what of `bytes` goes without waiting, after waiting for room for the first byte where
  // there is none, and answers how many were sent: at least one, unless `bytes` is empty. After
  // `writable()` answered `true` it does not wait.
  writeSome(bytes: Array[byte]) -> Result[int, IoError]

  // Sends `text` as UTF-8.
  writeText(text: string) -> Result[unit, IoError]

  // A wait longer than `d` fails with `TimedOut` from now on; zero or less takes the limit away.
  setTimeout(d: Duration) -> Result[unit, IoError]

  // Tells the other end nothing more will be sent; reading goes on.
  shutdownOutput() -> Result[unit, IoError]

  // Divides the connection into a half that reads and a half that writes, each its own sendable
  // value that one thread may use while another uses the other, so a thread can go on sending while
  // another receives. Bytes read ahead go to the reading half, and each half starts with the
  // connection's timeout. The connection itself is used up: every operation on it afterwards answers
  // an error, and closing it does nothing. Splitting a connection a second time, or a closed one,
  // traps.
  split() -> (StreamReader, StreamWriter)

  // The other end's IP address, written numerically without its port (`127.0.0.1`, `::1`), for a
  // connection over TCP, TLS's included; `None` for one with no such address, a Unix socket's.
  remoteAddress -> Option[string] = None

// The reading half of a connection `split` divided. It reads as the connection did, and a `select`
// waits for it with a `reader.readable()` arm. Closing it stops its reading and leaves the writing
// half working; the connection ends once both halves are closed, or once both are unreachable.
trait StreamReader: Sendable, Reader, Close, Readiness
  // The next line, as `ByteStream.readLine` reads one.
  readLine() -> Result[Option[string], IoError]

  // Everything the other end sends until it finishes, after what earlier reads left.
  readAll() -> Result[Array[byte], IoError]

  // A read that waits longer than `d` fails with `TimedOut` from now on; zero or less takes the
  // limit away. The writing half keeps its own limit.
  setTimeout(d: Duration) -> Result[unit, IoError]

  // The other end's IP address, as the connection's `remoteAddress` is.
  remoteAddress -> Option[string] = None

// The writing half of a connection `split` divided. It writes as the connection did, a
// `ByteWriter` as the connection is, and a `select` waits for room with a `writer.writable()` arm.
// Closing it tells the other end nothing more will be sent, as `shutdownOutput` does, and leaves the
// reading half working; the connection ends once both halves are closed, or once both are
// unreachable.
trait StreamWriter: Sendable, ByteWriter, Close, Writability
  // Sends what of `bytes` goes without waiting, as `ByteStream.writeSome` does; a TLS connection's
  // writing half sends the whole record it makes, waiting for room for the rest where there is too
  // little.
  writeSome(bytes: Array[byte]) -> Result[int, IoError]

  // Sends `text` as UTF-8.
  writeText(text: string) -> Result[unit, IoError]

  // A write that waits longer than `d` fails with `TimedOut` from now on; zero or less takes the
  // limit away. The reading half keeps its own limit.
  setTimeout(d: Duration) -> Result[unit, IoError]

  // The other end's IP address, as the connection's `remoteAddress` is.
  remoteAddress -> Option[string] = None
