module avin.actors

// Actors: many small owners of state, each reached only by the messages sent to it, run a message at
// a time. `spawn(behaviour)` starts one and gives back at once its `ActorRef`; `tell` puts a message
// in its mailbox and returns, never waiting. An actor with messages has one turn queued: a
// lightweight thread of its own, or a task on the executor it was given, which handles at most
// `throughput` of them before queueing the next turn at the back, so a busy actor never holds a worker
// from the others, and the actor never runs two turns at once. A turn that waits parks its thread
// and frees its worker. Each turn makes the actor the owner of the code it runs, so the Sysl handles
// the actor owns are its own on whichever worker it is.
//
// An actor runs until it stops. An actor started by code another actor runs is that actor's child,
// and an ending actor stops its children and waits for their ends before it ends itself, so a tree
// of actors is torn down from its leaves. An actor's own code reaches its lifecycle through its
// `ActorContext`: `stop`, `watch`, the timers `after` and `every`, its `children` and its `parent`.
//
// A trap in an actor's code fails the actor: the runtime reports it naming the actor and returns to
// the actor's turn, dropping the message being handled, and the actor's `Supervision` decides what
// follows: its parent fails in turn (`Escalate`), it ends (`Stop`), or it starts again with fresh
// state and the same mailbox (`Restart`).

import avin.collections.mutable.{Map as MutableMap}
import avin.random.Random
import avin.threads.{Atomic, Condition, Executor, Future, Mutex, Promise}
import avin.threads as threads
import avin.time.Duration
import avin.time as time

// A new owner of Sysl handles, which nothing has been given yet.
@intrinsic("owner_new")
private newOwner() -> long

// The owner of the code running, who alone may use the Sysl handles it owns.
@intrinsic("owner_current")
private currentOwner() -> long

// Makes `owner` the owner of the code running from now on.
@intrinsic("owner_set")
private runAs(owner: long)

// Gives every Sysl handle `value` reaches that `from` owns to `to`.
@intrinsic("hand_over")
private handOver(value: Any, from: long, to: long)

// Whether a value of `T` may reach a Sysl handle that sending it hands over, decided for each type
// where the program is compiled: a message of integers and strings, or of actors' references, is
// never walked.
@intrinsic("holds_handles")
private holdsHandles[T](value: T) -> bool

@intrinsic("trap")
private fail(reason: string) -> Nothing

// Starts a lightweight thread running `run` on a stack of `stack` bytes, handing nothing over, and
// gives back the object it is joined by, which a turn never needs.
@intrinsic("thread_start")
private startThread(run: () -> unit, stack: long) -> Any

// The stack of a turn's lightweight thread: a thread's default, reserved and committed as it is
// touched, so a turn recurses as deeply as any thread.
private val turnStack: long = 8388608

// Runs `run` as the code of the actor shown as `name`, and answers whether it trapped: the runtime
// reports a trap naming the actor, drops what `run` was doing, and stores the trap's reason as the
// element of `outcome`, an array of one string. A trap that leaves state other threads share in
// doubt stops the program instead.
@intrinsic("actor_guarded")
private guarded(run: () -> unit, name: string, outcome: Any) -> bool

// Stops the program, whose trap was reported already, from an actor whose failure no parent took.
@intrinsic("stop_reported")
private stopProgram() -> Nothing

// What follows a trap in an actor, given to `spawn`. `Escalate` fails the parent as if it had
// trapped, its own supervision deciding next, and stops the program where the actor has no parent.
// `Stop` ends the actor, its children first, and tells its watchers it failed. `Restart` stops its
// children, runs its `stopping` blocks and runs its start again, the messages in its mailbox kept;
// a failure that would make more than `limit` restarts within the last `within` escalates instead.
data Supervision
  Escalate
  Stop
  Restart(limit: int, within: Duration)

// The most messages of one actor a turn handles before the actor's next turn goes to the back of the
// queue.
private val throughput = 16

// The last number given to an actor; each actor's is one more, never reused.
private val numbers = Atomic[long](0)

// How an actor ended: `Stopped` where it stopped, by its own `stop()`, by its parent's `stop(child)`
// or because its parent ended; `Failed` with the trap's reason where a trap ended it.
data Ending
  Stopped
  Failed(reason: string)

// Where an actor is in its life: handling messages, ending (its children not yet all ended, its
// messages dropped), or ended.
private val Live = 0
private val Closing = 1
private val Gone = 2

// Whether a message that waits in a mailbox for a timer or a watch is still wanted: cancelling the
// timer or the watch drops it, whether or not it is queued already. `key` is the number of the actor
// a watch watches, and `once` says that the message comes once, so the actor forgets the guard when
// it handles it.
private class Guard(val key: long, val once: bool): Sendable
  val id: long = guards.add(1)
  private val live = Atomic[bool](true)

  isLive() -> bool = live.load()

  cancel() = live.store(false)

// The last number given to a guard.
private val guards = Atomic[long](0)

// One message in a mailbox, and the link to the one sent after it, which its sender sets once the
// message is the newest. A timer's or a watch's message carries its guard. A message a watch's or a
// pipe's function makes is made when the actor takes it, in its own turn, so a trap in the function
// fails the actor that asked for the message.
private class Node[M](private var message: Option[M], private var make: Option[() -> M], val guard: Option[Guard])
  val next = Atomic[Option[Node[M]]](None)

  // The message, which the node gives up so that the mailbox does not keep it alive.
  take() -> Option[M]
    if make is Some(f)
      make = None
      return Some(f())
    val m = message
    message = None
    m

  // Gives up the message without making it.
  drop()
    message = None
    make = None

  // Whether the message is still wanted.
  wanted() -> bool = guard match
    Some(g) -> g.isLive()
    None -> true

// An unbounded queue many threads put messages in and the actor alone takes them from, without a
// lock: a sender swaps its node in as the newest, then links the one it replaced to it, so two
// messages one sender sends arrive in the order it sent them. The oldest node is always one whose
// message was taken already; the next is the next message. A counted mailbox, a router's routee's,
// also keeps how many messages wait in it, which any thread may read.
private class Mailbox[M](private val counted: bool)
  private var oldest = Node[M](None, None, None)
  private val newest = Atomic[Node[M]](oldest)
  private val count = Atomic[long](0)

  // Puts `m` at the back, with the guard of the timer or watch that sends it; called by any thread.
  put(m: M, guard: Option[Guard]) = link(Node(Some(m), None, guard))

  // Puts at the back the message `make` makes when the actor takes it.
  putMade(make: () -> M, guard: Option[Guard]) = link(Node[M](None, Some(make), guard))

  private link(n: Node[M])
    if counted then count.add(1)
    newest.swap(n).next.store(Some(n))

  // The node at the front, taken out, where one is there; called by the actor alone. A message
  // whose sender has swapped its node in but not yet linked it is not there yet, and its sender
  // schedules the actor once it is.
  take() -> Option[Node[M]] = oldest.next.load() match
    Some(n) ->
      oldest = n
      if counted then count.add(-1)
      Some(n)
    None -> None

  // How many messages wait, in a counted mailbox; zero in any other.
  waiting() -> long = count.load()

  // Drops every message there.
  clear()
    while take() is Some(n) do n.drop()

  // Whether a message is there to take; called by the actor alone.
  isEmpty() -> bool = oldest.next.load().isEmpty

// What every actor is, whatever the type of its messages: what its parent, its children and the
// actors watching it use.
private trait Core: Sendable
  // The actor's number, which no other actor has.
  id() -> long

  // The actor's reference, which may be watched and compared but not sent to.
  ref() -> ActorRef[Nothing]

  // Asks the actor to end once the message it is handling is handled.
  requestStop() -> unit

  // Whether the actor has ended: it is so before its end is told to anyone.
  isGone() -> bool

  // Adds `child`, which this actor's code is starting.
  adopt(child: Core) -> unit

  // Tells the actor that its child `child` has ended.
  childEnded(child: Core) -> unit

  // Tells the actor that a child escalated a failure for `reason` to it, which fails it in turn.
  childFailed(reason: string) -> unit

// A running actor: its mailbox, whether it is queued on its executor or running there, its owner of
// Sysl handles, its handler, made by its behaviour's start on its first turn, and its place in the
// tree of actors. Its turns are the only code that reads or changes its handler, its timers, its
// watches and its `stopping` blocks, and one turn ends before the next begins, through the
// executor's queue; what other threads reach (its mailbox, its phase, its children, its end) is
// atomic, so it is sendable.
//
// A trap in its turn fails it, and its supervision decides: it ends, failed; it restarts, its
// children stopped and waited for, its `stopping` blocks run and its start run again on the turn
// after, its mailbox kept; or it escalates, ending failed and failing its parent, which takes the
// failure on its own next turn.
@trusted_sendable("only its own turns, one after another through its executor, touch its `var`s; what other threads reach is atomic")
private class Actor[M: Sendable](
    private val behaviour: Behaviour[M],
    private val executor: Executor,
    val parent: Option[Core],
    private val supervision: Supervision,
    counted: bool
): Core
  val number: long = numbers.add(1)
  val owner: long = newOwner()
  // Whether each turn is a lightweight thread of its own, as on the shared executor.
  private val ownThreads = executor === Executor.shared()
  val end = Promise[Ending]()
  private val mailbox = Mailbox[M](counted)
  // The messages a stash gave back, handled before the mailbox's, the first at the front; the
  // actor's turns alone reach it.
  private val unstashed = Deque[M]()
  // Set until `start`, which queues the first turn, so nothing queues one before it.
  private val scheduled = Atomic[bool](true)
  private val stopAsked = Atomic[bool](false)
  private val phase = Atomic[int](Live)
  // The children that have not ended yet, in the order they started.
  val children = Atomic[Vector[Core]](Vector())
  private var handler: Option[(M) -> unit] = None
  private var reference: Option[ActorRef[M]] = None
  // How the actor is shown, which a trap's report names.
  private val label = s"${behaviour.name}#$number"
  // Where the runtime puts the reason of a trap in the actor's code.
  private val outcome = Array.fill(1, "")
  // How many messages the last turn handled.
  private var handled = 0
  // The reason the actor is ending failed, where a trap ended it.
  private var failure: Option[string] = None
  // The failure a child escalated, which the actor takes on its next turn.
  private val escalated = Atomic[Option[string]](None)
  // Set from a failure that restarts the actor until its children have ended and it starts again.
  private var restarting = false
  // Set once the actor has escalated a failure to its parent: it handles nothing more, and waits
  // for the parent's failure to stop it.
  private var halted = false
  // When the actor restarted, in microseconds of the monotonic clock, the earliest first.
  private val restarts = Buffer[long]()
  // The guards of the timers not yet done, by the guard's number, and of the watches, by the number
  // of the actor watched.
  val timers = MutableMap[long, Guard]()
  val watches = MutableMap[long, Guard]()
  // What runs when the actor ends, in the order it was given.
  val stoppings = Buffer[() -> unit]()

  override id() -> long = number

  override ref() -> ActorRef[Nothing] = reference.get

  // Starts the actor: its first turn runs the start of its behaviour as `ref`, then its messages.
  start(ref: ActorRef[M])
    reference = Some(ref)
    schedule()

  // Puts `m` in the mailbox and queues the actor where it was neither queued nor running. A message
  // to an actor that is ending or has ended is dropped.
  post(m: M, guard: Option[Guard])
    offer(m, guard)
    ()

  // Puts `m` in the mailbox as `post` does, and answers whether it did: `false` where the actor is
  // ending or has ended, and the message was dropped. The Sysl handles the message holds that the
  // sending code owns are the actor's from then on, so the sender's next use of one traps; a
  // dropped message leaves them the sender's. Only a message whose type can hold a handle is
  // walked, and the walk stops at what is shared between owners, such as an actor's reference.
  offer(m: M, guard: Option[Guard]) -> bool
    if phase.load() != Live then return false
    if holdsHandles(m) then handOver(m, currentOwner(), owner)
    mailbox.put(m, guard)
    wake()
    true

  // Puts in the mailbox the message `make` makes when the actor takes it, in its own turn; dropped
  // where the actor is ending or has ended.
  postMade(make: () -> M, guard: Option[Guard])
    if phase.load() != Live then return ()
    mailbox.putMade(make, guard)
    wake()

  // Asks the actor to end once the message it is handling is handled.
  override requestStop()
    stopAsked.store(true)
    wake()

  override isGone() -> bool = phase.load() == Gone

  // Asks the actor to end from its own code, which looks again after each message.
  stopSelf() = stopAsked.store(true)

  // An actor that is ending already stops a child at once, and does not wait for it.
  override adopt(child: Core)
    children.update(cs -> cs :+ child)
    if phase.load() != Live then child.requestStop()

  override childEnded(child: Core)
    val gone = child.id()
    children.update(cs -> cs.filter(c -> c.id() != gone))
    wake()

  override childFailed(reason: string)
    escalated.store(Some(reason))
    wake()

  // Whether the actor is in its own turn: its code is running.
  running() -> bool = currentOwner() == owner

  private wake()
    if scheduled.compareAndSet(false, true) then schedule()

  // Queues the next turn: a lightweight thread of its own where the actor runs on the shared
  // executor, so a turn that waits parks only itself; a task on the executor's workers where it was
  // given one of its own, which bounds how many of its tasks work at once.
  private schedule()
    if ownThreads
      startThread(() -> turn(), turnStack)
      ()
    else executor.execute(() -> turn())

  // One turn on a worker, as the actor's owner: a failure a child escalated, then the start where
  // it has not run and at most `throughput` messages, stopping early where the actor is asked to
  // end; a trap in them fails the actor. A restarting actor starts again once its children have
  // ended. An ending actor goes on to stop its children, and ends once none is left. With messages
  // left the actor goes to the back of the queue; without, it is no longer scheduled, unless
  // something arrived as it stopped, which queues it again.
  private turn()
    val worker = currentOwner()
    runAs(owner)
    handled = 0
    if escalated.swap(None) is Some(reason)
      if phase.load() == Live && !restarting && !halted then failed(reason)
    if phase.load() == Live && !restarting
      if halted
        if stopAsked.load() then closing()
      elif guarded(() -> work(), label, outcome) then failed(outcome(0))
      elif stopAsked.load() then closing()
    if restarting && children.load().isEmpty then restarted()
    if phase.load() == Closing && children.load().isEmpty then ended()
    if phase.load() == Gone then mailbox.clear()
    runAs(worker)
    if handled == throughput && phase.load() == Live && !restarting && hasMessages() then return schedule()
    scheduled.store(false)
    if pending() && scheduled.compareAndSet(false, true) then schedule()

  // Whether a turn has something to do. The phase is compared rather than matched: a bare name in
  // a pattern binds, so `Live ->` would match every phase.
  private pending() -> bool
    val p = phase.load()
    if p == Live then return escalated.load().isDefined || (
      if restarting then children.load().isEmpty else stopAsked.load() || (
        !halted && (handler.isEmpty || hasMessages())
      )
    )
    if p == Closing then return children.load().isEmpty
    !mailbox.isEmpty()

  // Whether a message waits, given back by a stash or in the mailbox.
  private hasMessages() -> bool = !unstashed.isEmpty || !mailbox.isEmpty()

  // How many messages wait in a counted mailbox.
  waiting() -> long = mailbox.waiting()

  // The actor's own reference, which accepts its messages.
  typedRef() -> ActorRef[M] = reference.get

  // Puts `messages` in front of every message waiting, in their order, so the actor handles them
  // next; called by the actor's own code alone.
  unstash(messages: Iterable[M]) = unstashed.prependAll(messages)

  // The start where it has not run, then the messages: the code a trap in fails the actor.
  private work()
    handled = handle(started())

  // The handler, made by the behaviour's start where this is the first turn.
  private started() -> (M) -> unit = handler match
    Some(h) -> h
    None ->
      val h = behaviour.start(reference.get)
      handler = Some(h)
      h

  // Hands at most `throughput` messages to `h`, and answers how many it took; a message whose timer
  // or watch was cancelled is dropped.
  private handle(h: (M) -> unit) -> int
    var n = 0
    while n < throughput && !stopAsked.load()
      if !unstashed.isEmpty
        h(unstashed.removeHead())
        n += 1
        continue
      mailbox.take() match
        Some(node) ->
          if node.wanted()
            if node.guard is Some(g) then forget(g)
            h(node.take().get)
          else node.drop()
        None -> return n
      n += 1
    n

  // Forgets a guard whose one message is being handled.
  private forget(g: Guard)
    if !g.once then return
    if g.key < 0
      timers.remove(g.id)
      return
    if watches.get(g.key) is Some(w)
      if w.id == g.id then watches.remove(g.key)

  // Begins to end: the timers and watches are cancelled, the messages dropped, and every child is
  // asked to end.
  private closing()
    phase.store(Closing)
    cancelAll()
    mailbox.clear()
    unstashed.clear()
    for c in children.load() do c.requestStop()

  // Cancels every timer and every watch.
  private cancelAll()
    for (_, g) in timers
      g.cancel()
      clock.remove(g)
    timers.clear()
    for (_, g) in watches do g.cancel()
    watches.clear()

  // Takes a trap's failure, for `reason`, as the actor's supervision says.
  private failed(reason: string) = supervision match
    Restart(limit, within) -> if mayRestart(limit, within) then restart() else escalate(reason)
    Stop -> endFailed(reason)
    Escalate -> escalate(reason)

  // Begins to end, failed for `reason`.
  private endFailed(reason: string)
    failure = Some(reason)
    closing()

  // Fails the parent, or stops the program where there is none. The actor handles nothing more:
  // its timers are cancelled, and it ends failed when its parent's failure stops it.
  private escalate(reason: string) = parent match
    Some(p) ->
      failure = Some(reason)
      halted = true
      cancelAll()
      p.childFailed(reason)
    None -> stopProgram()

  // Whether one more restart now keeps to at most `limit` within the last `within`; where it does,
  // it is counted.
  private mayRestart(limit: int, within: Duration) -> bool
    val now = time.monotonic().micros
    while !restarts.isEmpty && restarts(0) <= now - within.micros do restarts.remove(0)
    if restarts.length >= limit then return false
    restarts.append(now)
    true

  // Begins a restart: it is reported, the timers and watches are cancelled and every child is
  // asked to end; the messages stay.
  private restart()
    restarting = true
    eprintln(s"avin: restarting $label")
    cancelAll()
    for c in children.load() do c.requestStop()

  // Ends a restart, every child having ended: the `stopping` blocks run and the start is to run
  // again. A trap in a `stopping` block ends the actor instead, as a stop asked for meanwhile does.
  private restarted()
    restarting = false
    handler = None
    if runStoppings() || stopAsked.load() then closing()

  // Runs the `stopping` blocks in the order they were given and forgets them, answering whether one
  // trapped: that one is reported and fails the actor where nothing had, and the rest do not run.
  private runStoppings() -> bool
    var i = 0
    while i < stoppings.length
      if guarded(stoppings(i), label, outcome)
        if failure.isEmpty then failure = Some(outcome(0))
        stoppings.clear()
        return true
      i += 1
    stoppings.clear()
    false

  // Ends, every child having ended: the `stopping` blocks run, the end is told to whoever waits for
  // it, and the parent is told after.
  private ended()
    runStoppings()
    phase.store(Gone)
    mailbox.clear()
    unstashed.clear()
    handler = None
    registry.leave(owner)
    end.complete(failure match
      Some(reason) -> Failed(reason)
      None -> Stopped)
    if parent is Some(p) then p.childEnded(self)

// The running actors, by their owner of Sysl handles, so code finds the actor running it: `spawn`
// its parent, and an `ActorContext` its actor. Every thread reaches it, under its mutex.
private class Registry(): Sendable
  private val actors = Mutex(MutableMap[long, Core]())

  enrol(owner: long, a: Core) = actors.with(m -> m(owner) = a)

  leave(owner: long) = actors.with(m ->
    m.remove(owner)
    ())

  // The actor whose code is running, where an actor's is.
  current() -> Option[Core]
    val me = currentOwner()
    actors.with(m -> m.get(me))

private lazy val registry: Registry = Registry()

// What an actor is before it starts: a name, which its references are shown by, and its start, run
// once on the actor's own execution before it handles any message, which makes the actor's state and
// gives back the handler of each message. The start is given the actor's own reference, which it may
// keep and hand out. Starting the same behaviour twice starts two actors, each with state of its own.
//
//     val counter = Behaviour[int]("Counter", me ->
//         var count = 0
//         n -> count += n)
class Behaviour[M: Sendable](val name: string, val start: @sendable (ActorRef[M]) -> (M) -> unit)

// The reference by which an actor is sent messages. Any thread may hold and use it; it holds no state
// of the actor's, compares by the actor it refers to, and is shown as its behaviour's name and the
// actor's number, `Counter#3`. A reference that accepts every message of a type accepts those of
// its subtypes, so every reference is an `ActorRef[Nothing]`, which may be watched and compared but
// not sent to.
//
// The reference an `ask` makes for its reply is one too, which accepts one message: it is shown as
// `Reply#1`, the replies of a program being numbered from one apart from the actors, and it ends
// once the ask has its answer or has timed out. `send` answers whether the message was delivered.
@keeps_owners
class ActorRef[-M: Sendable](
    private val send: @sendable (M) -> bool,
    val name: string,
    val number: long,
    private val end: Future[Ending]
): Sendable
  // Puts `message` in the actor's mailbox and returns at once: it never waits and never fails.
  // Messages one sender tells one actor are handled in the order they were told; a message told to
  // an actor that has ended is dropped.
  tell(message: M)
    send(message)
    ()

  // Sends the message `make` builds around a new reference that accepts one reply, and gives back
  // the future of that reply: `Ok` of the first message the reference is sent, which completes it,
  // a later one being dropped; `Err(TimedOut)` where none arrives within `timeout`; and
  // `Err(Ended)` where the actor had ended, so the message could not be delivered. `make` runs at
  // once, in the asking code.
  //
  //     counter.ask(r -> Get(r), timeout = time.seconds(1)).await()
  ask[R: Sendable](make: (ActorRef[R]) -> M, timeout: Duration) -> Future[Result[R, AskError]]
    val answer = Promise[Result[R, AskError]]()
    val g = Guard(-1, true)
    val reply = ActorRef[R](r -> answered(answer, g, Ok(r)), "Reply", -replies.add(1), answer.future.map(_ -> Stopped))
    // The timer is set once the question is delivered, and taken out again where the reply came
    // before it was set.
    if !send(make(reply)) then answered(answer, g, Err(Ended))
    else
      clock.add(g, timeout.micros, 0, () ->
        answered(answer, g, Err(TimedOut))
        ())
      if answer.isCompleted() then clock.remove(g)
    answer.future

  // The future of how the actor ends, complete once it has, its children and its `stopping` block
  // done. `main` waits for the actor that runs the program with `spawn(App()).ended().await()`.
  ended() -> Future[Ending] = end

// Why an ask has no answer: `TimedOut` where no reply arrived within its timeout, `Ended` where the
// actor asked had ended, so the question was never delivered.
data AskError
  TimedOut
  Ended

impl Error for AskError
  // A sentence saying why the ask has no answer.
  message -> string = self match
    TimedOut -> "the ask timed out before a reply arrived"
    Ended -> "the actor asked had ended"

// The last number given to an ask's reply reference.
private val replies = Atomic[long](0)

// Completes an ask with `outcome` where it has no answer yet, its timer then cancelled, and answers
// whether it did.
private answered[R: Sendable](answer: Promise[Result[R, AskError]], g: Guard, outcome: Result[R, AskError]) -> bool
  if !answer.tryComplete(outcome) then return false
  g.cancel()
  clock.remove(g)
  true

// Two references are equal where they refer to the same actor.
impl[M] Eq for ActorRef[M]
  equals(other: ActorRef[M]) -> bool = number == other.number

impl[M] Hash for ActorRef[M]
  hash() -> long = number

impl[M: Sendable] Display for ActorRef[M]
  display(out: Writer, spec: FormatSpec) = out.writeField(
    if number < 0 then s"$name#${-number}" else s"$name#$number",
    spec
  )

// Starts an actor of `behaviour` on `executor`, the shared pool unless another is given, and gives
// back its reference at once. Its start runs on the executor's workers, and messages told before it
// has finished wait behind it. Started by the code of an actor, it is that actor's child; started
// elsewhere, it is a top-level actor. The Sysl handles `behaviour` reaches that the calling code owns
// are the actor's from then on. `onFailure` decides what follows a trap in the actor's code; a
// `Restart` whose limit is less than zero or whose window is not more than zero traps.
spawn[M: Sendable](
    behaviour: Behaviour[M],
    onFailure: Supervision = Escalate,
    executor: Executor = Executor.shared()
) -> ActorRef[M] = launch(behaviour, onFailure, executor, false).typedRef()

// Starts an actor as `spawn` does and gives back the actor itself; a counted one keeps how many
// messages wait in its mailbox.
private launch[M: Sendable](
    behaviour: Behaviour[M],
    onFailure: Supervision,
    executor: Executor,
    counted: bool
) -> Actor[M]
  checkSupervision(onFailure)
  val parent = registry.current()
  val actor = Actor(behaviour, executor, parent, onFailure, counted)
  handOver(behaviour, currentOwner(), actor.owner)
  val ref = ActorRef[M](m -> actor.offer(m, None), behaviour.name, actor.number, actor.end.future)
  registry.enrol(actor.owner, actor)
  if parent is Some(p) then p.adopt(actor)
  actor.start(ref)
  actor

// Traps where `onFailure` is a `Restart` whose limit is less than zero or whose window is not more
// than zero.
private checkSupervision(onFailure: Supervision)
  if onFailure is Restart(limit, within)
    if limit < 0 then fail(s"a restart limit of $limit is less than zero")
    if within <= Duration.Zero then fail(s"restarts are counted within $within, which is not more than zero")

// A timer of an actor, which `after` and `every` give back: `cancel()` stops it, and a message it has
// sent that the actor has not yet handled is dropped. An actor's timers are all cancelled when it
// ends.
@keeps_owners
class Timer(private val guard: Guard): Sendable
  // Stops the timer, from any thread; a timer that is done already stays done.
  cancel()
    guard.cancel()
    clock.remove(guard)

// A timer's next time: when it is due, in microseconds of the monotonic clock, the order it was set
// in among timers due at the same time, the message it sends, and for a repeating one its interval.
private class Due(
    val at: long,
    val order: long,
    val guard: Guard,
    val fire: @sendable () -> unit,
    val interval: long
): Sendable

// The thread that keeps every actor's timers, started with the first timer: it sleeps until the
// earliest is due, sends its message, and sets a repeating timer again an interval after it fired.
private class Clock(): Sendable
  private val due = Mutex(Buffer[Due]())
  private val changed = due.condition()
  private val orders = Atomic[long](0)

  // Sets a timer due `delay` microseconds from now.
  add(guard: Guard, delay: long, interval: long, fire: @sendable () -> unit)
    val d = Due(time.monotonic().micros + delay, orders.add(1), guard, fire, interval)
    val ready = changed
    due.with(q ->
      q.append(d)
      ready.notify())

  // Forgets the timer of `guard`.
  remove(guard: Guard)
    val id = guard.id
    due.with(q -> removeTimer(q, id))

  // The thread's life: fire each timer as it falls due, in the order of their times.
  run()
    loop
      for d in next()
        if d.guard.isLive()
          d.fire()
          if d.interval > 0 && d.guard.isLive() then add(d.guard, d.interval, d.interval, d.fire)

  // Waits until a timer is due, and takes out every one due by then, earliest first.
  private next() -> Vector[Due]
    val ready = changed
    due.with(q -> waitDue(q, ready))

// Takes the timer of the guard numbered `id` out of `q`.
private removeTimer(q: Buffer[Due], id: long)
  var i = 0
  while i < q.length
    if q(i).guard.id == id
      q.remove(i)
      return
    i += 1

// Waits, `ready` being the condition of the mutex that holds `q`, until a timer of `q` is due, and
// takes out every one due by then.
private waitDue(q: Buffer[Due], ready: Condition) -> Vector[Due]
  loop
    if q.isEmpty then ready.wait()
    else
      val now = time.monotonic().micros
      var first = q(0)
      for d in q do if earlier(d, first) then first = d
      if first.at <= now then return takeDue(q, now)
      ready.waitFor((first.at - now + 999) / 1000)

// Whether `a` fires before `b`.
private earlier(a: Due, b: Due) -> bool = a.at < b.at || (a.at == b.at && a.order < b.order)

// Takes the timers of `q` due by `now` out of it, earliest first.
private takeDue(q: Buffer[Due], now: long) -> Vector[Due]
  var taken: Vector[Due] = Vector()
  var i = 0
  while i < q.length
    if q(i).at <= now then taken = taken :+ q.remove(i)
    else i += 1
  taken.sortWith((a, b) -> if earlier(a, b) then -1 elif earlier(b, a) then 1 else 0)

private startClock() -> Clock
  val c = Clock()
  threads.spawn(() -> c.run())
  c

private lazy val clock: Clock = startClock()

// An actor's own view of its life, for its own code alone: an `actor` declaration's body, arms,
// methods and `stopping` block reach these as their own, and a behaviour's start makes one from the
// reference it is given. Each traps where code other than the actor's own calls it.
//
//     Behaviour[Tick]("Ticker", me ->
//         val ctx = ActorContext(me)
//         ctx.every(time.seconds(1), Tick)
//         t -> ...)
open class ActorContext[M: Sendable](private val actorRef: ActorRef[M])
  private val actorCell: Actor[M] = own(actorRef)

  // Ends the actor once the message it is handling is handled; what is left in its mailbox is
  // dropped, and its children end first.
  stop()
    check("stop")
    actorCell.stopSelf()

  // Ends `child`, one of this actor's own children, once the message it is handling is handled; for
  // the actor itself, `stop()`. An actor that has ended stays ended; stopping any other actor traps,
  // since an actor that should end on request is sent a message saying so.
  stop(child: ActorRef[Nothing])
    check("stop")
    if child.number == actorRef.number then return actorCell.stopSelf()
    for c in actorCell.children.load()
      if c.id() == child.number then return c.requestStop()
    if child.ended().isCompleted() then return ()
    fail(
      s"stopping $child, which is not one of this actor's children: an actor that should end on request is sent a message saying so"
    )

  // Asks for `message` in this actor's own mailbox when `actor` ends, for whatever reason, at once
  // where it has ended already. Watching an actor again replaces the earlier watch, and an actor
  // watching itself is told nothing, since its mailbox ends with it.
  watch(actor: ActorRef[Nothing], message: M)
    val a = actorCell
    if watching(actor) is Some(g) then actor.ended().onComplete(_ -> a.post(message, Some(g)))

  // Asks for `f` of how `actor` ended in this actor's own mailbox when it ends. `f` runs in this
  // actor's own turn, when it takes the message, so a trap in it fails this actor; the end it is
  // given crosses threads to get there, so it is `@sendable`.
  watch(actor: ActorRef[Nothing], f: @sendable (Ending) -> M)
    val a = actorCell
    if watching(actor) is Some(g) then actor.ended().onComplete(e -> a.postMade(() -> f(e), Some(g)))

  // Stops asking to be told of `actor`'s end; a message about it not yet handled is dropped.
  unwatch(actor: ActorRef[Nothing])
    check("unwatch")
    if actorCell.watches.get(actor.number) is Some(g)
      g.cancel()
      actorCell.watches.remove(actor.number)

  // Sends the actor `message` once `delay` has passed.
  after(delay: Duration, message: M) -> Timer
    check("after")
    timer(delay, Duration.Zero, message)

  // Sends the actor `message` each time `interval` passes, until the timer is cancelled or the actor
  // ends; the interval must be more than zero.
  every(interval: Duration, message: M) -> Timer
    check("every")
    if interval <= Duration.Zero then fail(s"a timer set to repeat every $interval, which is not more than zero")
    timer(interval, interval, message)

  // This actor's children that have not ended, in the order they started.
  children() -> Vector[ActorRef[Nothing]]
    check("children")
    actorCell.children.load().filter(c -> !c.isGone()).map(c -> c.ref())

  // The actor whose code started this one, where one did.
  parent() -> Option[ActorRef[Nothing]]
    check("parent")
    actorCell.parent.map(p -> p.ref())

  // A reference to this actor that accepts another protocol: each message `R` sent to it arrives in
  // this actor's mailbox as `f` of it, so the actor answers an actor of another protocol without
  // widening its own message type. `f` runs where the message is sent, so it is `@sendable`, and a
  // trap in it is the sender's. The adapter refers to this actor: it is equal to `self`, shown as
  // it is, and ends with it.
  adapter[R: Sendable](f: @sendable (R) -> M) -> ActorRef[R]
    check("adapter")
    val a = actorCell
    ActorRef[R](r -> a.offer(f(r), None), actorRef.name, actorRef.number, actorRef.ended())

  // Sends the actor `f` of the value of `future` once it completes, so the actor goes on handling
  // messages meanwhile. `f` runs in this actor's own turn, so a trap in it fails this actor; the
  // value crosses threads to get there, so `f` is `@sendable`. A future complete already sends at
  // once, so its message comes before any this code sends the actor after it. The message of an
  // actor that has ended by then is dropped.
  pipeToSelf[T](future: Future[T], f: @sendable (T) -> M)
    check("pipeToSelf")
    val a = actorCell
    future.value() match
      Some(v) -> a.post(f(v), None)
      None -> future.onComplete(v -> a.postMade(() -> f(v), None))

  // Runs `f` when the actor ends, after its children have ended; an `actor` declaration's
  // `stopping` block is one. Several run in the order they were given.
  onStopping(f: () -> unit)
    check("onStopping")
    actorCell.stoppings.append(f)

  // The guard of a new watch of `actor`, replacing any earlier one; none where it is this actor.
  private watching(actor: ActorRef[Nothing]) -> Option[Guard]
    check("watch")
    if actor.number == actorRef.number then return None
    if actorCell.watches.get(actor.number) is Some(old) then old.cancel()
    val g = Guard(actor.number, true)
    actorCell.watches(actor.number) = g
    Some(g)

  private timer(delay: Duration, interval: Duration, message: M) -> Timer
    val g = Guard(-1, interval == Duration.Zero)
    actorCell.timers(g.id) = g
    val a = actorCell
    clock.add(g, delay.micros, interval.micros, () -> a.post(message, Some(g)))
    Timer(g)

  private check(what: string)
    if !actorCell.running() then fail(s"`$what` of $actorRef is called from code other than the actor's own")

// The actor `ref` refers to, whose code is running.
private own[M: Sendable](ref: ActorRef[M], what: string = "an `ActorContext`") -> Actor[M] = registry.current() match
  Some(a: Actor[M]) -> if a.number == ref.number then a else fail(
    s"$what of $ref is made by code other than the actor's own"
  )
  _ -> fail(s"$what of $ref is made by code other than the actor's own")

// Messages an actor sets aside because it cannot handle them in its present state, to handle them
// once it can: `add` keeps one, and `unstashAll` gives them all back, in the order they were added,
// in front of every message waiting in the mailbox, so the actor handles them next. A stash holds at
// most `capacity` messages, and adding one to a full stash traps, failing the actor. A stash is part
// of the actor's state, made by its own code from its own reference, so the messages it holds are
// lost where the actor ends or restarts, as its fields are; messages already given back are in the
// mailbox, which a restart keeps.
//
//     val waiting = Stash(self, 100)
//     ...
//     Send(bytes) ->
//       waiting.add(Send(bytes))
//       stay
class Stash[M: Sendable](owner: ActorRef[M], val capacity: int)
  private val cell: Actor[M] = own(owner, "a `Stash`")
  private val held = Buffer[M]()
  if capacity < 1 then fail(s"a stash of capacity $capacity, which is less than one")

  // How many messages the stash holds.
  length -> int = held.length

  // Whether the stash holds no message.
  isEmpty -> bool = held.isEmpty

  // Whether the stash holds `capacity` messages, so that adding another traps.
  isFull -> bool = held.length >= capacity

  // Sets `message` aside; traps where the stash is full.
  add(message: M)
    check("add")
    if held.length >= capacity then fail(s"the stash of $owner is full: it holds $capacity messages")
    held.append(message)

  // Gives back every message the stash holds, in the order they were added, in front of the
  // messages waiting in the mailbox, and leaves the stash empty.
  unstashAll()
    check("unstashAll")
    cell.unstash(held)
    held.clear()

  // Drops every message the stash holds.
  clear()
    check("clear")
    held.clear()

  private check(what: string)
    if !cell.running() then fail(s"`$what` of a stash of $owner is called from code other than the actor's own")

// How a router chooses the routee each message goes to: `RoundRobin` each in turn; `AtRandom` any,
// each equally likely; `SmallestMailbox` the one with the fewest messages waiting, the next in turn
// among equals; `ByKey` by the key `key` gives the message, so messages with one key go to one
// routee for as long as it lives, and a routee that ends moves only its own keys to the others.
data Routing[M]
  RoundRobin
  AtRandom
  SmallestMailbox
  ByKey(key: @sendable (M) -> long)

// Routers: one reference that spreads its messages over a pool of actors.
object Router
  // Starts a router and `size` routees of `behaviour`, its children, and gives back the router's
  // reference, which accepts the routees' messages: each message sent to it goes to one routee,
  // chosen by `routing`. The router is a child of the code that calls this, as `spawn`'s actor is,
  // and is shown as `Router#n`. Each routee is supervised by `onFailure` and runs on `executor`: a
  // routee that restarts keeps its place, one that ends leaves the pool, and the router stops once
  // none is left; a routee's escalated failure fails the router, which escalates it in turn. A
  // router that ends stops its routees first. Two messages one sender sends that go to one routee
  // arrive in the order they were sent. A size less than one traps, as does a `Restart` `spawn`
  // would refuse.
  //
  //     val workers = Router.pool(4, Resizer(), SmallestMailbox, onFailure = Restart(3, time.seconds(1)))
  //     workers tell Resize(image)
  pool[M: Sendable](
      size: int,
      behaviour: Behaviour[M],
      routing: Routing[M] = RoundRobin,
      onFailure: Supervision = Escalate,
      executor: Executor = Executor.shared()
  ) -> ActorRef[M]
    if size < 1 then fail(s"a pool of $size routees, which is fewer than one")
    checkSupervision(onFailure)
    val router = launch(
      Behaviour[Routed[M]]("Router", routerStart(size, behaviour, routing, onFailure, executor)),
      Escalate,
      Executor.shared(),
      false
    )
    ActorRef[M](m -> router.offer(Route(m), None), "Router", router.number, router.end.future)

// What a router handles: a message to route, or the end of one of its routees.
private data Routed[M]
  Route(message: M)
  RouteeEnded(number: long)

// The start of a router: it starts its routees and watches each, then routes each message to the
// routee `routing` chooses, choosing again where that one has ended meanwhile.
private routerStart[M: Sendable](
    size: int,
    behaviour: Behaviour[M],
    routing: Routing[M],
    onFailure: Supervision,
    executor: Executor
) -> @sendable (ActorRef[Routed[M]]) -> (Routed[M]) -> unit = me ->
  val ctx = ActorContext(me)
  val routees = Buffer[Actor[M]]()
  for _ in 0 ..< size
    val r = launch(behaviour, onFailure, executor, true)
    routees.append(r)
    ctx.watch(r.ref(), RouteeEnded[M](r.number))
  val chooser = Chooser(routing)
  message -> message match
    Route(m) ->
      var sent = false
      while !sent && !routees.isEmpty
        val i = chooser.pick(routees, m)
        sent = routees(i).offer(m, None)
        if !sent then routees.remove(i)
    RouteeEnded(number) ->
      routees.filterInPlace(r -> r.number != number)
      if routees.isEmpty then ctx.stop()

// A router's choice of routee, which keeps where its turn has got to and its own generator.
private class Chooser[M: Sendable](private val routing: Routing[M])
  private var next = 0
  private val dice = Random()

  // The index in `routees`, which is not empty, of the routee that takes `m`.
  pick(routees: Buffer[Actor[M]], m: M) -> int = routing match
    RoundRobin -> turn(routees.length)
    AtRandom -> dice.nextInt(routees.length)
    SmallestMailbox -> fewestWaiting(routees)
    ByKey(key) -> heaviest(routees, key(m))

  // The next index in turn among `n`.
  private turn(n: int) -> int
    val i = next % n
    next = (i + 1) % n
    i

  // The routee with the fewest messages waiting, the first in turn among equals.
  private fewestWaiting(routees: Buffer[Actor[M]]) -> int
    val n = routees.length
    val start = next % n
    var best = start
    var fewest = routees(start).waiting()
    for j in 1 ..< n
      val i = (start + j) % n
      val w = routees(i).waiting()
      if w < fewest
        best = i
        fewest = w
    next = (best + 1) % n
    best

  // The routee whose number weighs most with `key`: each key has its own order of the routees, so
  // a key keeps its routee while that one lives, and the keys of one that ends spread over the rest.
  private heaviest(routees: Buffer[Actor[M]], key: long) -> int
    var best = 0
    var most = weight(key, routees(0).number)
    for i in 1 ..< routees.length
      val w = weight(key, routees(i).number)
      if w > most
        best = i
        most = w
    best

// How much the routee numbered `routee` weighs with `key`: the two mixed so that every bit of each
// moves about half the bits of the result.
private weight(key: long, routee: long) -> long = mix(mix(key) ^ routee)

private mix(x: long) -> long
  val a = x +% -7046029254386353131
  val b = (a ^ (a >> 30)) *% -4658895280553007687
  val c = (b ^ (b >> 27)) *% -7723592293110705685
  c ^ (c >> 31)

// Publishing and subscribing: each event `publish` is given goes to every actor subscribed, which any
// thread may do. A subscriber is told the events of one publisher in the order they were published;
// the events of different publishers interleave in any order. An actor that ends leaves the topic of
// itself, its end being watched from the moment it subscribes, so a topic never keeps an ended actor.
// An event holding a Sysl handle goes with the first subscriber's copy, as a handle sent twice does.
//
//     val prices = Topic[Price]()
//     prices.subscribe(self)
//     prices.publish(Price("ACME", 12))
@keeps_owners
class Topic[E: Sendable](): Sendable
  private val held = Atomic[Subscribers[E]](Subscribers(Vector(), Vector()))

  // Subscribes `subscriber`, which is told every event published from now on. An actor subscribed
  // already, by this reference or another of its own such as an adapter, is subscribed once, by
  // the reference given last, in its first place. An actor that has ended is not kept.
  subscribe(subscriber: ActorRef[E])
    var fresh = false
    held.update(s ->
      fresh = !s.watched.contains(subscriber.number)
      s.adding(subscriber))
    if fresh
      val topic = self
      val number = subscriber.number
      subscriber.ended().onComplete(_ -> topic.drop(number))

  // Stops telling the actor `subscriber` refers to the events published from now on; an actor not
  // subscribed is left as it is.
  unsubscribe(subscriber: ActorRef[Nothing])
    val number = subscriber.number
    held.update(s -> s.without(number, false))
    ()

  // Tells `event` to every actor subscribed, in the order they subscribed; returns at once.
  publish(event: E)
    for s in held.load().members do s.tell(event)

  // The actors subscribed now, in the order they subscribed.
  subscribers -> Vector[ActorRef[E]] = held.load().members

  // Forgets the actor numbered `number`, which has ended.
  private drop(number: long)
    held.update(s -> s.without(number, true))
    ()

// The actors a topic tells, in the order they subscribed, and the numbers of those whose ends it
// watches, which is every one subscribed and any that left without ending. Never changed: a topic
// swaps in a new one.
@keeps_owners
private class Subscribers[E: Sendable](val members: Vector[ActorRef[E]], val watched: Vector[long]): Sendable
  // With `r` subscribed, in place of another reference to its actor where there is one.
  adding(r: ActorRef[E]) -> Subscribers[E]
    val i = members.indexWhere(m -> m.number == r.number)
    val ms = if i >= 0 then members.updated(i, r) else members :+ r
    val ws = if watched.contains(r.number) then watched else watched :+ r.number
    Subscribers(ms, ws)

  // Without the actor numbered `number`, and forgetting its end where `ended`.
  without(number: long, ended: bool) -> Subscribers[E] = Subscribers(
    members.filter(m -> m.number != number),
    if ended then watched.filter(w -> w != number) else watched
  )
