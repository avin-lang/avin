module avin.io

// What can go wrong when a program talks to the world outside it: files, directories and, later,
// streams and sockets. Each is a value a correct program can meet and handle.

// Why an input or output operation failed. The named cases are the ones a program commonly tells
// apart; every other failure is `Other`, with a sentence saying what it was.
data IoError
    // Nothing exists at the path, or a directory on the way to it is missing.
    NotFound
    // The program may not read, write or search what the path names.
    PermissionDenied
    // Something already exists where a new file or directory was to be made.
    AlreadyExists
    // A directory was used where a file was expected.
    IsADirectory
    // A file was used where a directory was expected, the path's own end or a step on the way.
    NotADirectory
    // A directory to be removed still holds entries.
    DirectoryNotEmpty
    // Text read from a file is not UTF-8; `offset` is the byte where it stops being.
    InvalidUtf8(offset: long)
    // Any other failure, in words.
    Other(text: string)

impl IoError
    // A sentence saying what went wrong, for a message to a person.
    message() -> string = self match
        NotFound -> "no such file or directory"
        PermissionDenied -> "permission denied"
        AlreadyExists -> "already exists"
        IsADirectory -> "is a directory"
        NotADirectory -> "not a directory"
        DirectoryNotEmpty -> "directory not empty"
        InvalidUtf8(at) -> s"not UTF-8 at byte $at"
        Other(m) -> m
