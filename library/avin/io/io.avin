module avin.io

// Talking to the world outside the program: standard input, read as text, and what can go wrong when
// a program reads or writes files, directories and connections. Each failure is a
// value a correct program can meet and handle.

// Why an input or output operation failed: what kind of failure it was, what was being done, and
// what it was done to, a path, a program or an address. It shows as a sentence naming all three,
// `cannot read app.conf: no such file or directory`, and a program tells failures apart by the kind:
// `Err(IoError(NotFound, _, _))`, or `e.kind == NotFound`.
//
// A failure with no operation shows as its kind's sentence alone, and one with an operation and no
// subject as `cannot read: …`.
data IoError(kind: ErrorKind, operation: string = "", subject: string = "")

impl Error for IoError
  // `cannot <operation> <subject>: <the kind's sentence>`, leaving out what is empty.
  message -> string
    val what = kind.description
    if operation == "" then return if subject == "" then what elif what == "" then subject else s"$subject: $what"
    val done = if subject == "" then s"cannot $operation" else s"cannot $operation $subject"
    if what == "" then done else s"$done: $what"

// The kinds of failure an input or output operation meets. The named cases are the ones a program
// commonly tells apart; every other failure is `Other`, with a sentence saying what it was.
data ErrorKind
  // Nothing exists at the path, or a directory on the way to it is missing.
  NotFound
  // The program may not read, write or search what the path names.
  PermissionDenied
  // Something already exists where a new file or directory was to be made.
  AlreadyExists
  // A directory was used where a file was expected.
  IsADirectory
  // A file was used where a directory was expected, the path's own end or a step on the way.
  NotADirectory
  // A directory to be removed still holds entries.
  DirectoryNotEmpty
  // Text read from a file is not UTF-8; `offset` is the byte where it stops being.
  InvalidUtf8(offset: long)
  // The other end of a connection refused it: nothing listens at that address and port.
  ConnectionRefused
  // The other end of a connection reset it, or closed it while it was being written to.
  ConnectionReset
  // A read or write on a connection waited longer than its timeout.
  TimedOut
  // Any other failure, in words.
  Other(text: string)

impl ErrorKind
  // A sentence saying what kind of failure it is, the same on every platform for a named case:
  // `no such file or directory`.
  description -> string = self match
    NotFound -> "no such file or directory"
    PermissionDenied -> "permission denied"
    AlreadyExists -> "already exists"
    IsADirectory -> "is a directory"
    NotADirectory -> "not a directory"
    DirectoryNotEmpty -> "directory not empty"
    InvalidUtf8(at) -> s"not UTF-8 at byte $at"
    ConnectionRefused -> "connection refused"
    ConnectionReset -> "connection reset by peer"
    TimedOut -> "timed out"
    Other(m) -> m

// Bytes read from somewhere a piece at a time: an open file, a connection, or a source a program
// writes. A function that takes a `Reader` reads any of them the same way, and holds no more of the
// input than it asks for.
trait Reader
  // Up to `max` bytes, `max` being at least one, waiting for at least one where the source is still
  // going; an empty array once it has ended.
  read(max: int) -> Result[Array[byte], IoError]

// Something held outside the program that `close()` gives back: an open file, a connection, a
// listening socket, a temporary directory, a started command. Closing a closed one does nothing and
// answers `Ok`, so `defer r.close()` beside the code that got `r` gives it back on every way out of
// the block, and the success path may still close it first to see the `Err`:
//
//     val f = fs.create(name)?
//     defer f.close()
//     f.writeText(text)?
//     f.close()
//
// A generic function takes any of them as `[R: Close]`.
trait Close
  // Gives the resource back; an `Err` says what could not be finished on the way, a flush that
  // failed or a directory that could not be removed. Every later call answers `Ok`.
  close() -> Result[unit, IoError]

// Standard input is read a line at a time, as an iterator of lines, or all that is left. All three
// take from one buffer the runtime holds, so they can be mixed and nothing read ahead is lost.
//
// A line ends at `\n`, and a `\r` just before it is part of the terminator; the last line needs none.
// Bytes that are not UTF-8 become U+FFFD as they are read. A read that fails ends the input, as its
// end does.

@intrinsic("input_ended")
private inputEnded() -> bool

@intrinsic("read_line")
private takeLine() -> string

@intrinsic("read_rest")
private takeRest() -> string

// The next line of standard input without its terminator, or `None` at the end of the input. An empty
// line is `Some("")`.
readLine() -> Option[string] = if inputEnded() then None else Some(takeLine())

// The lines left on standard input, each as `readLine` gives it, read as the iterator is advanced.
lines() -> Iterator[string] = InputLines()

// Everything left on standard input, terminators and all; the empty string when nothing is left.
readAll() -> string = takeRest()

private class InputLines: Iterator[string]
  override hasNext() -> bool = !inputEnded()

  override next() -> string
    if inputEnded() then fail("next on an exhausted iterator")
    takeLine()
