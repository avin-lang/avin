module avin.io

// Talking to the world outside the program: standard input, read as text or as bytes, standard output
// and error written as bytes, and what can go wrong when
// a program reads or writes files, directories and connections. Each failure is a
// value a correct program can meet and handle.

import avin.fs
import avin.threads.Readiness

// Why an input or output operation failed: what kind of failure it was, what was being done, and
// what it was done to, a path, a program or an address. It shows as a sentence naming all three,
// `cannot read app.conf: no such file or directory`, and a program tells failures apart by the kind:
// `Err(IoError(NotFound, _, _))`, or `e.kind == NotFound`.
//
// A failure with no operation shows as its kind's sentence alone, and one with an operation and no
// subject as `cannot read: …`.
data IoError(kind: ErrorKind, operation: string = "", subject: string = "")

impl Error for IoError
  // `cannot <operation> <subject>: <the kind's sentence>`, leaving out what is empty.
  message -> string
    val what = kind.description
    if operation == "" then return if subject == "" then what elif what == "" then subject else s"$subject: $what"
    val done = if subject == "" then s"cannot $operation" else s"cannot $operation $subject"
    if what == "" then done else s"$done: $what"

// The kinds of failure an input or output operation meets. The named cases are the ones a program
// commonly tells apart; every other failure is `Other`, with a sentence saying what it was.
data ErrorKind
  // Nothing exists at the path, or a directory on the way to it is missing.
  NotFound
  // The program may not read, write or search what the path names.
  PermissionDenied
  // Something already exists where a new file or directory was to be made.
  AlreadyExists
  // A directory was used where a file was expected.
  IsADirectory
  // A file was used where a directory was expected, the path's own end or a step on the way.
  NotADirectory
  // A directory to be removed still holds entries.
  DirectoryNotEmpty
  // Text read from a file is not UTF-8; `offset` is the byte where it stops being.
  InvalidUtf8(offset: long)
  // The other end of a connection refused it: nothing listens at that address and port.
  ConnectionRefused
  // The other end of a connection reset it, or closed it while it was being written to.
  ConnectionReset
  // A read or write on a connection waited longer than its timeout.
  TimedOut
  // The program has no controlling terminal to read from or write to.
  NoTerminal
  // Any other failure, in words.
  Other(text: string)

impl ErrorKind
  // A sentence saying what kind of failure it is, the same on every platform for a named case:
  // `no such file or directory`.
  description -> string = self match
    NotFound -> "no such file or directory"
    PermissionDenied -> "permission denied"
    AlreadyExists -> "already exists"
    IsADirectory -> "is a directory"
    NotADirectory -> "not a directory"
    DirectoryNotEmpty -> "directory not empty"
    InvalidUtf8(at) -> s"not UTF-8 at byte $at"
    ConnectionRefused -> "connection refused"
    ConnectionReset -> "connection reset by peer"
    TimedOut -> "timed out"
    NoTerminal -> "there is no terminal"
    Other(m) -> m

// Bytes read from somewhere a piece at a time: an open file, a connection, or a source a program
// writes. A function that takes a `Reader` reads any of them the same way, and holds no more of the
// input than it asks for.
trait Reader
  // Up to `max` bytes, `max` being at least one, waiting for at least one where the source is still
  // going; an empty array once it has ended.
  read(max: int) -> Result[Array[byte], IoError]

// Somewhere bytes are written: an open file, a connection or its writing half, a streamed HTTP
// body, or a sink a program writes. A function that takes a `ByteWriter` writes to any of them the
// same way. It writes bytes; rendered text goes to a `Writer`.
trait ByteWriter
  // Writes all of `bytes`, nothing for an empty array, or answers why it could not.
  write(bytes: Array[byte]) -> Result[unit, IoError]

// How many bytes `copy` reads at once, and so the most it holds.
private val CopyChunk = 65536

// Reads `from` to its end and writes everything it gives to `to`, a piece of at most 64 KiB at a
// time, so a copy of any length holds no more than one piece. Answers how many bytes were copied,
// or the first read's or write's `Err`, after which nothing more is read or written. Neither side is
// closed, flushed or rewound.
copy(from: Reader, to: ByteWriter) -> Result[long, IoError]
  var total: long = 0
  while true
    val piece = from.read(CopyChunk)?
    if piece.length == 0 then return Ok(total)
    to.write(piece)?
    total += long(piece.length)
  Ok(total)

// Something held outside the program that `close()` gives back: an open file, a connection, a
// listening socket, a temporary directory, a started command. Closing a closed one does nothing and
// answers `Ok`, so `defer r.close()` beside the code that got `r` gives it back on every way out of
// the block, and the success path may still close it first to see the `Err`:
//
//     val f = fs.create(name)?
//     defer f.close()
//     f.writeText(text)?
//     f.close()
//
// A generic function takes any of them as `[R: Close]`.
trait Close
  // Gives the resource back; an `Err` says what could not be finished on the way, a flush that
  // failed or a directory that could not be removed. Every later call answers `Ok`.
  close() -> Result[unit, IoError]

// Standard input is read a line at a time, as an iterator of lines, or all that is left. All three
// take from one buffer the runtime holds, so they can be mixed and nothing read ahead is lost.
//
// A line ends at `\n`, and a `\r` just before it is part of the terminator; the last line needs none.
// Bytes that are not UTF-8 become U+FFFD as they are read. A read that fails ends the input, as its
// end does.
//
// Threads read standard input one at a time: each read holds the input from its look at whether the
// input has ended to its taking of what it reads, so a line goes whole to one reader, never split
// between two or given to both.

@intrinsic("input_hold")
private holdInput()

@intrinsic("input_release")
private releaseInput()

@intrinsic("input_ended")
private inputEnded() -> bool

@intrinsic("read_line")
private takeLine() -> string

@intrinsic("read_rest")
private takeRest() -> string

// The next line of standard input without its terminator, or `None` at the end of the input. An empty
// line is `Some("")`.
readLine() -> Option[string]
  holdInput()
  val line = if inputEnded() then None else Some(takeLine())
  releaseInput()
  line

// Why a secret could not be read, as the runtime tells the failures apart.
@sysl("avin.rt.SecretFailure")
private data SecretFailure
  NoTty
  Ended
  Signalled
  Failed(message: string)

@sysl("avin.rt.read_secret")
private takeSecret(prompt: string) -> Result[Array[byte], SecretFailure]

private secretError(e: SecretFailure) -> IoError = e match
  NoTty -> IoError(NoTerminal, "read", "the terminal")
  Ended -> IoError(Other("end of input"), "read", "the terminal")
  Signalled -> IoError(Other("interrupted"), "read", "the terminal")
  Failed(m) -> IoError(Other(m), "read", "the terminal")

// One line typed at the controlling terminal with what is typed not shown, after `prompt` is written
// to the terminal: for a password or a passphrase. The terminal is `/dev/tty`, not standard input, so
// a program whose input or output is a pipe can ask, as `sudo` and `ssh` do. The line comes back
// without its terminator, as bytes the caller owns and can overwrite once it is done with them.
//
// The terminal is put back exactly as it was found whichever way the read ends. A line the user ends
// with Ctrl-D, or with the terminal's end, still counts if it has bytes in it. A program that has no
// terminal gets `Err(IoError(NoTerminal, _, _))`; the end of input before any byte, and an interrupt
// the program survives, are `Err` of kind `Other`. A line is at most what the terminal keeps of one:
// 1023 bytes on macOS, 4095 on Linux.
//
// The read takes the same lock as reading standard input, so threads never read both at once: a
// thread that asks waits for one reading, and the other way round. A thread cancelled while it waits
// for the line is stopped once the line has been read, as one reading standard input is.
readSecretBytes(prompt: string) -> Result[Array[byte], IoError] = takeSecret(prompt).mapErr(secretError)

// `readSecretBytes` as text; bytes that are not UTF-8 become U+FFFD.
readSecret(prompt: string) -> Result[string, IoError] = readSecretBytes(prompt).map(
  bytes -> string.fromUtf8Lossy(bytes)
)

// `readSecret`, or where the program has no terminal, `prompt` written to standard error and a line
// read from standard input, shown as it arrives: for a tool a script runs with its password piped in.
// A closed standard input is `Err` of kind `Other`.
readSecretOrLine(prompt: string) -> Result[string, IoError]
  readSecret(prompt) match
    Err(e) if e.kind is NoTerminal ->
      eprint(prompt)
      readLine() match
        Some(line) -> Ok(line)
        None -> Err(IoError(Other("end of input"), "read", "standard input"))
    other -> other

// The lines left on standard input, each as `readLine` gives it, read as the iterator is advanced.
lines() -> Iterator[string] = InputLines()

// Everything left on standard input, terminators and all; the empty string when nothing is left.
readAll() -> string = takeAllInput()

// Everything left on standard input, read holding it.
private takeAllInput() -> string
  holdInput()
  val rest = takeRest()
  releaseInput()
  rest

// Why reading or writing a standard stream failed, as the runtime tells the failures apart.
@sysl("avin.rt.StdioFailure")
private data StdioFailure
  Closed
  Failed(message: string)

@sysl("avin.rt.read_input_bytes")
private takeInputBytes(max: int) -> Result[Array[byte], StdioFailure]

@sysl("avin.rt.write_standard")
private writeStandard(fd: int, bytes: Array[byte]) -> Result[unit, StdioFailure]

private stdioError(operation: string, subject: string) -> (StdioFailure) -> IoError = e -> e match
  Closed -> IoError(ConnectionReset, operation, subject)
  Failed(m) -> IoError(Other(m), operation, subject)

@sysl("avin.rt.read_input_available")
private takeAvailableInput(max: int) -> Result[Option[Array[byte]], StdioFailure]

@sysl("avin.rt.input_readable")
private inputReadable() -> bool

// Standard input as bytes: what `stdin()` answers. See there.
object StandardInputBytes: Reader, Readiness
  override read(max: int) -> Result[Array[byte], IoError]
    if max < 1 then fail(s"a read of $max bytes: a read takes at least one")
    takeInputBytes(max).mapErr(stdioError("read", "standard input"))

  // Up to `max` bytes, `max` being at least one, of what `read(max)` would answer without waiting:
  // `Some` of the bytes already read ahead, or of what one read gives where standard input has bytes
  // now, an empty array once it has ended; `None` where a read would wait, standard input having
  // nothing yet or another thread being in the middle of reading it. Never waits.
  readAvailable(max: int) -> Result[Option[Array[byte]], IoError]
    if max < 1 then fail(s"a read of $max bytes: a read takes at least one")
    takeAvailableInput(max).mapErr(stdioError("read", "standard input"))

  // Whether a read would answer now, without waiting: bytes are already read ahead, a `readLine`'s
  // beyond its line among them, or have arrived, or the input has ended or failed, which the read then
  // answers, or standard input is a file. False while another thread is reading it. Never waits.
  override readable() -> bool = inputReadable()

  override readinessDescriptor() -> int = 0

// Standard output as bytes: what `stdout()` answers. See there.
object StandardOutputBytes: ByteWriter
  override write(bytes: Array[byte]) -> Result[unit, IoError] =
    writeStandard(1, bytes).mapErr(stdioError("write", "standard output"))

// Standard error as bytes: what `stderr()` answers. See there.
object StandardErrorBytes: ByteWriter
  override write(bytes: Array[byte]) -> Result[unit, IoError] =
    writeStandard(2, bytes).mapErr(stdioError("write", "standard error"))

// Standard input as a `Reader` of bytes, for input whose bytes count, a `Content-Length` most of all,
// or that is not text. Its bytes come from the same buffer `readLine`, `lines`, `readAll` and
// `Source.stdin()` take from, so a program may mix them: a header read as a line and a body read as
// bytes go on from each other, and no byte is lost or read twice. Threads read it one at a time, under
// the same lock as the text reads, and a lightweight thread waiting for input parks, leaving its
// worker to the others.
//
// `read(max)` answers the bytes already read ahead where there are any, else waits for one read of
// the input, so it may answer fewer than `max`; an empty array once the input has ended, as often as
// it is asked. A read that fails answers `Err`, with the platform's sentence, where the text readers
// see the end. Standard input may be a terminal, a pipe or a file. A `max` below one traps, as a
// connection's read does. The answer is `Sendable`.
//
// It is a `Readiness` (`avin.threads`), so a `select` waits on it beside channels and an `after`
// (`stdin().readable() -> …`), and a `Selector` among connections; any thread may, since standard
// input belongs to none. `readAvailable(max)` reads only what is there, never waiting for more.
stdin() -> StandardInputBytes = StandardInputBytes

// Standard output as a `ByteWriter`. Each write goes out whole before it returns: behind whatever
// `print` and `println` have written so far, which is sent on first, and never inside a line
// another thread prints, so there is nothing to flush afterwards. A write to a pipe or a socket whose
// reader has gone answers `Err(IoError(ConnectionReset, "write", "standard output"))` rather than
// ending the program. The answer is `Sendable`, so a thread of its own can do the writing.
stdout() -> StandardOutputBytes = StandardOutputBytes

// Standard error as a `ByteWriter`: each write goes out whole before it returns, after standard
// output has been flushed, as `eprint` does; a reader that has gone is `Err` as for `stdout()`.
stderr() -> StandardErrorBytes = StandardErrorBytes

// The standard input's name in a list of inputs, as a command-line tool is given it.
private val StdinName = "-"

// The inputs a command-line tool was told to read, in order, each as its name and all its text: the
// files `paths` names, or standard input when `paths` is empty, and `-` among them names standard
// input too. A name is given as it was written, so standard input is `"-"`. An input is read when the
// iterator reaches it, and one that cannot be read is an `Err` naming it (`cannot read a.txt: no such
// file or directory`, or not UTF-8 at a byte) in its place: the iterator goes on to the next, so a
// tool reports what failed and carries on. Standard input is read once, to its end; a second `-`
// finds it empty.
inputs(paths: Vector[string]) -> Iterator[Result[(string, string), IoError]] =
  NamedInputs(if paths.isEmpty then Vector(StdinName) else paths)

// `inputs` a line at a time: each element is an input's name and one of its lines, without its
// terminator, as `lines` and `readLine` give them. An input with no lines gives nothing, and one that
// cannot be read gives one `Err` and no lines. Standard input's lines are read as the iterator
// advances, a file is read whole when the iterator reaches it.
inputLines(paths: Vector[string]) -> Iterator[Result[(string, string), IoError]] =
  NamedInputLines(if paths.isEmpty then Vector(StdinName) else paths)

private readInput(name: string) -> Result[string, IoError] =
  if name == StdinName then Ok(readAll()) else fs.readText(name)

private class NamedInputs(private val names: Vector[string]): Iterator[Result[(string, string), IoError]]
  private var index = 0

  override hasNext() -> bool = index < names.length

  override next() -> Result[(string, string), IoError]
    if index >= names.length then fail("next on an exhausted iterator")
    val name = names(index)
    index += 1
    readInput(name).map(text -> (name, text))

private class NamedInputLines(private val names: Vector[string]): Iterator[Result[(string, string), IoError]]
  private var index = 0
  private var name = ""
  private var current: Option[Iterator[string]] = None
  private var pending: Option[Result[(string, string), IoError]] = None

  // Fills `pending` with the next line or error, or leaves it empty when every input is done.
  private fill()
    while pending is None
      current match
        Some(it) ->
          if it.hasNext() then pending = Some(Ok((name, it.next())))
          else current = None
        None ->
          if index >= names.length then return
          name = names(index)
          index += 1
          if name == StdinName then current = Some(lines())
          else
            fs.readText(name) match
              Ok(text) -> current = Some(text.lines.iterator())
              Err(e) -> pending = Some(Err(e))

  override hasNext() -> bool
    fill()
    pending is Some(_)

  override next() -> Result[(string, string), IoError]
    fill()
    pending match
      Some(r) ->
        pending = None
        r
      None -> fail("next on an exhausted iterator")

// The lines of standard input. `hasNext` takes the next line when it has none in hand, so a line it
// answers for is this iterator's even while other threads read.
private class InputLines: Iterator[string]
  private var pending: Option[string] = None

  override hasNext() -> bool
    if pending is None then pending = readLine()
    pending is Some(_)

  override next() -> string
    if pending is None then pending = readLine()
    pending match
      Some(line) ->
        pending = None
        line
      None -> fail("next on an exhausted iterator")
