module avin.io

// Text to be read from somewhere: a file, a string or standard input. A function that takes a
// `Source` reads any of them the same way.

import avin.fs

// Text read once, from wherever it comes. `lines`, `chars` and `readAll` each take up where the last
// stopped, so a source read to its end has nothing more to give.
//
// A line ends at `\n`, and a `\r` just before it is part of the terminator; the last line needs none.
trait Source
    // The lines left, without their terminators, read as the iterator is advanced.
    lines() -> Iterator[string]

    // The characters left, read as the iterator is advanced.
    chars() -> Iterator[char]

    // Everything left, terminators and all; the empty string when nothing is left.
    readAll() -> string

object Source
    // The text of the file, read whole now, as `fs.readText` reads it: a file that cannot be read,
    // or is not UTF-8, is the `Err`.
    fromFile(file: string) -> Result[Source, IoError] = fs.readText(file).map(text -> TextSource(text))

    // The text itself.
    fromString(text: string) -> Source = TextSource(text)

    // Standard input, read as it is consumed, from the buffer `readLine`, `lines` and `readAll` share.
    stdin() -> Source = InputSource

// A source over text already in hand; `at` is the byte offset of what is left.
private class TextSource(val text: string): Source
    var at: int = 0

    override lines() -> Iterator[string] = TextLines(self)
    override chars() -> Iterator[char] = TextChars(self)

    override readAll() -> string
        val rest = text.slice(at, text.byteLength())
        at = text.byteLength()
        rest

    // Whether nothing is left.
    ended() -> bool = at == text.byteLength()

    // The next line, without its terminator; there must be one.
    takeLine() -> string
        val newline = text.indexOf("\n", at)
        val past = if newline < 0 then text.byteLength() else newline
        val until = if past > at && text.byteAt(past - 1) == byte(13) then past - 1 else past
        val line = text.slice(at, until)
        at = if newline < 0 then past else past + 1
        line

    // The next character; there must be one.
    takeChar() -> char
        val c = text.charAt(at)
        at += encodedLength(c)
        c

private class TextLines(private val source: TextSource): Iterator[string]
    override hasNext() -> bool = !source.ended()

    override next() -> string
        if source.ended() then fail("next on an exhausted iterator")
        source.takeLine()

private class TextChars(private val source: TextSource): Iterator[char]
    override hasNext() -> bool = !source.ended()

    override next() -> char
        if source.ended() then fail("next on an exhausted iterator")
        source.takeChar()

// The number of bytes UTF-8 encodes `c` in.
private encodedLength(c: char) -> int
    val code = int(c)
    if code < 0x80 then return 1
    if code < 0x800 then return 2
    if code < 0x10000 then 3 else 4

// Standard input as a source: every read takes from the buffer the runtime holds for it.
private object InputSource: Source
    override lines() -> Iterator[string] = InputLines()
    override chars() -> Iterator[char] = InputChars()
    override readAll() -> string = takeRest()

@intrinsic("read_char")
private takeInputChar() -> char

private class InputChars: Iterator[char]
    override hasNext() -> bool = !inputEnded()

    override next() -> char
        if inputEnded() then fail("next on an exhausted iterator")
        takeInputChar()
