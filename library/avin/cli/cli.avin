module avin.cli

// Command-line arguments. A `Parser` declares what a program takes: flags, options with a value of a
// type, and positional arguments, each with a line of help. `parse` reads `main`'s `args` against it
// into `Args`, whose values are asked for by name and come back as their types; the help text and the
// usage line are written from the same declarations.
//
//     val parser = cli.Parser("wc", "Count lines, words and characters.")
//         .flag("lines", short = 'l', help = "count lines")
//         .int("top", help = "list the N commonest words", value = "N")
//         .positionals("file", help = "the files to count")
//
//     main(args: Vector[string]) -> int
//         val opts = parser.parseOrExit(args)
//         if opts.flag("lines") then …
//
// A mistake in the declarations themselves, two options of one name or a default that is not one of
// the choices, is the program's mistake and traps where it is declared. A mistake on the command line
// is the user's, and `parse` answers it as an `ArgsError` saying what was wrong.

import avin.process

// The character an option without a one-letter form has for its `short`.
private val noShort = '\u{0}'

// What an option holds: nothing (a flag), text, an int, a real, or one of a fixed set of words.
private data Kind
    Switch
    Text
    Whole
    Fraction
    OneOf(choices: Vector[string])

// One option as declared. `fallback` is the default as text, and `shown` whether the help mentions
// it; `value` is the placeholder for its value in the help, `<N>`.
private data Opt(
    name: string,
    short: char,
    help: string,
    kind: Kind,
    fallback: string,
    shown: bool,
    required: bool,
    repeated: bool,
    value: string
)

// One positional argument as declared. A `many` one takes every argument left.
private data Pos(name: string, help: string, required: bool, many: bool)

// Why `parse` gave no `Args`: the user asked for the help or the version, which `text` holds, or the
// arguments were not what the program takes. `reason` says what was wrong, `unknown option
// `--x``, and `usage` is the program's usage line, to show with it. Its `message` is the text or
// the reason.
data ArgsError
    HelpRequested(text: string)
    VersionRequested(text: string)
    Invalid(reason: string, usage: string)

impl Error for ArgsError
    // The help or the version text, or what was wrong with the arguments.
    message -> string = self match
        HelpRequested(text) -> text
        VersionRequested(text) -> text
        Invalid(reason, _) -> reason

// What a program takes on its command line. Each method that declares something answers a new parser
// and leaves this one as it was. `name` is the program's name in the usage line and the messages,
// `about` a sentence for the help, and a `version` that is not empty gives the program `--version`.
// Every parser has `--help`, and `-h` for it, unless the program declares an option of that name or
// that letter itself.
class Parser(
    val name: string,
    val about: string = "",
    val version: string = "",
    private val options: Vector[Opt] = [],
    private val arguments: Vector[Pos] = []
)
    // The same parser, with the flag `--name`, which is given or not. A flag may be given any number
    // of times, and `Args.count` says how many: `-vvv` is three.
    flag(name: string, short: char = noShort, help: string = "") -> Parser =
        withOption(Opt(name, short, help, Switch, "", false, false, true, ""))

    // The same parser, with the option `--name` taking a text value. Where it is not given its value
    // is `default`. A `required` option must be given; a `repeated` one may be given any number of
    // times, each value kept, where a second value of another option replaces the first. `value`
    // names the value in the help: `--out <file>`; it is the option's name when it is empty.
    string(
        name: string,
        short: char = noShort,
        help: string = "",
        default: string = "",
        required: bool = false,
        repeated: bool = false,
        value: string = ""
    ) -> Parser = withOption(Opt(name, short, help, Text, default, default != "", required, repeated, value))

    // As `string`, for an option whose value is an `int`: `--top 5`, `--top=-1`.
    int(
        name: string,
        short: char = noShort,
        help: string = "",
        default: int = 0,
        required: bool = false,
        repeated: bool = false,
        value: string = ""
    ) -> Parser = withOption(Opt(name, short, help, Whole, s"$default", default != 0, required, repeated, value))

    // As `string`, for an option whose value is a `real`: `--scale 1.5`.
    real(
        name: string,
        short: char = noShort,
        help: string = "",
        default: real = 0.0,
        required: bool = false,
        repeated: bool = false,
        value: string = ""
    ) -> Parser = withOption(Opt(name, short, help, Fraction, s"$default", default != 0.0, required, repeated, value))

    // As `string`, for an option whose value is one of `choices`, exactly as written: `--format
    // json`. Its value is read with `Args.string`. A `default` that is not empty must be one of the
    // choices, and the help shows them all: `--format <text|json>`.
    choice(
        name: string,
        choices: Vector[string],
        short: char = noShort,
        help: string = "",
        default: string = "",
        required: bool = false,
        repeated: bool = false
    ) -> Parser
        if choices.isEmpty then fail(s"cli: the choice `--$name` has no choices")
        if default != "" && !choices.contains(default)
            fail(s"cli: the default `$default` of `--$name` is not one of its choices")
        withOption(Opt(name, short, help, OneOf(choices), default, default != "", required, repeated, choices.mkString("|")))

    // The same parser, taking one more positional argument, after those declared before it. A
    // `required` one must be given; one that is not may be left off, and every argument after it
    // must then be optional too.
    positional(name: string, help: string = "", required: bool = true) -> Parser =
        withArgument(Pos(name, help, required, false))

    // The same parser, taking every argument left after the positional ones before it, none or more,
    // or one or more where it is `required`. It is the last argument declared.
    positionals(name: string, help: string = "", required: bool = false) -> Parser =
        withArgument(Pos(name, help, required, true))

    // The arguments read against the declarations: `Args` holding every value, or an `ArgsError`
    // when the user asked for `--help` or `--version`, or when the arguments are not what the program
    // takes. An argument starting with `-` is an option, except `-` alone; one starting with `--`
    // gives its value after `=` or as the next argument, and one with a single `-` is one or more
    // one-letter options, `-lw`, the last of which may take the rest of it or the next argument as
    // its value, `-n5` or `-n 5`. An option's value is the next argument whatever it starts with, so
    // `--top -1` is -1. Every argument after `--` is positional.
    parse(args: Vector[string]) -> Result[Args, ArgsError]
        var seen: Map[string, Vector[string]] = HashMap.empty[string, Vector[string]]()
        var loose = Vector.empty[string]()
        var ended = false
        var i = 0
        while i < args.length
            val a = args(i)
            i += 1
            if ended || a == "-" || !a.startsWith("-")
                loose = loose :+ a
            else if a == "--"
                ended = true
            else if a.startsWith("--")
                val body = a.drop(2)
                val eq = body.indexOf("=")
                val key = if eq >= 0 then body.slice(0, eq) else body
                if key == "help" && helpByName then return Err(HelpRequested(help))
                if key == "version" && versionByName then return Err(VersionRequested(versionText))
                val opt = byName(key) match
                    Some(o) -> o
                    None -> return invalid(s"unknown option `--$key`")
                val spelled = s"--$key"
                if opt.kind is Switch
                    if eq >= 0 then return invalid(s"`$spelled` takes no value")
                    seen = recorded(seen, opt, "")
                else
                    val text = if eq >= 0
                        body.slice(eq + 1, body.byteLength)
                    else if i < args.length
                        i += 1
                        args(i - 1)
                    else
                        return invalid(s"`$spelled` needs a value")
                    checked(opt, spelled, text)?
                    seen = recorded(seen, opt, text)
            else
                val letters = a.drop(1).chars
                var j = 0
                while j < letters.length
                    val c = letters(j)
                    j += 1
                    if c == 'h' && helpByLetter then return Err(HelpRequested(help))
                    val opt = byLetter(c) match
                        Some(o) -> o
                        None -> return invalid(s"unknown option `-$c`")
                    if opt.kind is Switch
                        seen = recorded(seen, opt, "")
                    else
                        val spelled = s"-$c"
                        val text = if j < letters.length
                            a.drop(1 + j)
                        else if i < args.length
                            i += 1
                            args(i - 1)
                        else
                            return invalid(s"`$spelled` needs a value")
                        checked(opt, spelled, text)?
                        seen = recorded(seen, opt, text)
                        j = letters.length
        var k = 0
        for p in arguments
            if p.many
                if p.required && k >= loose.length then return invalid(s"missing argument `<${p.name}>`")
                seen = seen.updated(p.name, loose.drop(k))
                k = loose.length
            else if k < loose.length
                seen = seen.updated(p.name, [loose(k)])
                k += 1
            else if p.required
                return invalid(s"missing argument `<${p.name}>`")
        if k < loose.length then return invalid(s"unexpected argument `${loose(k)}`")
        for o in options
            if o.required && !seen.contains(o.name) then return invalid(s"missing required option `--${o.name}`")
        Ok(Args(options, arguments, seen))

    // As `parse`, ending the program where it gives no `Args`: the help or the version is written to
    // standard output and the program exits with 0; a mistake is written to standard error as the
    // program's name and the message, the usage line, and where to find the help, and the program
    // exits with 2.
    parseOrExit(args: Vector[string]) -> Args = parse(args) match
        Ok(a) -> a
        Err(HelpRequested(text)) ->
            print(text)
            process.exit(0)
        Err(VersionRequested(text)) ->
            println(text)
            process.exit(0)
        Err(Invalid(reason, usage)) ->
            eprintln(s"$name: $reason")
            eprintln(usage)
            if helpByName then eprintln(s"Run `$name --help` for the options.")
            process.exit(2)

    // The usage line: the program's name, its required options, `[options]` where it has others, and
    // its positional arguments, an optional one in brackets and one taking the rest with `...`.
    usage -> string
        var line = s"Usage: $name"
        for o in options
            if o.required then line = s"$line ${spelling(o)}"
        if options.exists(o -> !o.required) || helpByName || versionByName then line = s"$line [options]"
        for p in arguments
            val shape = if p.many then s"<${p.name}>..." else s"<${p.name}>"
            line = if p.required then s"$line $shape" else s"$line [$shape]"
        line

    // The help: the usage line, the `about` sentence, then each argument and option with its help,
    // the option's default, and whether it is required or may be repeated, in the order declared.
    help -> string
        var rows = Vector.empty[(string, string)]()
        for p in arguments
            val shape = if p.many then s"<${p.name}>..." else s"<${p.name}>"
            rows = rows :+ (shape, p.help)
        val argumentRows = rows.length
        for o in options
            val letter = if o.short == noShort then "    " else s"-${o.short}, "
            rows = rows :+ (letter + spelling(o), described(o))
        if helpByName then rows = rows :+ ((if helpByLetter then "-h, " else "    ") + "--help", "show this help and exit")
        if versionByName then rows = rows :+ ("    --version", "show the version and exit")
        var width = 0
        for (left, _) in rows
            if left.charCount > width then width = left.charCount
        var text = usage + "\n"
        if about != "" then text = s"$text\n$about\n"
        var n = 0
        for (left, right) in rows
            if n == 0 && argumentRows > 0 then text = text + "\nArguments:\n"
            if n == argumentRows then text = text + "\nOptions:\n"
            val line = if right == "" then s"  $left" else s"  ${left.padEnd(width)}  $right"
            text = s"$text$line\n"
            n += 1
        text

    // The text `--version` writes: the name and the version.
    private versionText -> string = s"$name $version"

    // Whether `--help` is the parser's own, which it is unless the program declared an option of
    // that name; `-h` likewise, for the letter.
    private helpByName -> bool = !options.exists(_.name == "help")

    private helpByLetter -> bool = helpByName && !options.exists(_.short == 'h')

    private versionByName -> bool = version != "" && !options.exists(_.name == "version")

    private byName(key: string) -> Option[Opt] = options.find(_.name == key)

    private byLetter(c: char) -> Option[Opt] = options.find(_.short == c)

    // The parser with `o` added, after checking it is one the parser can take.
    private withOption(o: Opt) -> Parser
        if o.name == "" || o.name.startsWith("-") || o.name.contains("=")
            fail(s"cli: `${o.name}` is not an option name; it is written without dashes, `verbose`")
        if o.short == '-' || o.short == ' ' then fail(s"cli: `${o.short}` cannot be the letter of `--${o.name}`")
        if options.exists(_.name == o.name) || arguments.exists(_.name == o.name)
            fail(s"cli: `${o.name}` is declared twice")
        if o.short != noShort && options.exists(_.short == o.short)
            fail(s"cli: two options have the letter `-${o.short}`")
        Parser(name, about, version, options :+ o, arguments)

    // The parser with `p` added, after checking it can follow the arguments before it.
    private withArgument(p: Pos) -> Parser
        if p.name == "" then fail("cli: an argument needs a name")
        if options.exists(_.name == p.name) || arguments.exists(_.name == p.name)
            fail(s"cli: `${p.name}` is declared twice")
        if arguments.exists(_.many) then fail(s"cli: `<${p.name}>` follows an argument that takes the rest")
        if p.required && arguments.exists(!_.required)
            fail(s"cli: the required `<${p.name}>` follows an optional argument")
        Parser(name, about, version, options, arguments :+ p)

    // An `Invalid` error of `message`, with this parser's usage line.
    private invalid(message: string) -> Result[Args, ArgsError] = Err(Invalid(message, usage))

    // `text` checked as a value of `o`, which the user spelled `spelled`.
    private checked(o: Opt, spelled: string, text: string) -> Result[unit, ArgsError] = o.kind match
        Whole ->
            if text.toIntOption() is Some(_) then Ok(()) else Err(Invalid(s"`$spelled` needs an int, not `$text`", usage))
        Fraction ->
            if text.toRealOption() is Some(_) then Ok(()) else Err(Invalid(s"`$spelled` needs a number, not `$text`", usage))
        OneOf(choices) ->
            if choices.contains(text) then Ok(())
            else
                val listed = choices.map(c -> s"`$c`").mkString(", ")
                Err(Invalid(s"`$spelled` must be one of $listed, not `$text`", usage))
        _ -> Ok(())

// The values given so far with `text` added for `o`: kept beside the others where `o` is repeated,
// replacing them where it is not.
private recorded(seen: Map[string, Vector[string]], o: Opt, text: string) -> Map[string, Vector[string]] =
    if o.repeated then seen.updated(o.name, seen.getOrElse(o.name, Vector.empty[string]()) :+ text)
    else seen.updated(o.name, [text])

// The long form of `o` with its value's placeholder: `--top <N>`, or `--lines` for a flag.
private spelling(o: Opt) -> string = o.kind match
    Switch -> s"--${o.name}"
    _ -> s"--${o.name} <${if o.value == "" then o.name else o.value}>"

// The help of `o`, followed by its default where the help shows one, and by whether it is required
// or may be repeated.
private described(o: Opt) -> string
    var notes = Vector.empty[string]()
    if o.shown then notes = notes :+ s"default: ${o.fallback}"
    if o.required then notes = notes :+ "required"
    if o.repeated && !(o.kind is Switch) then notes = notes :+ "may be repeated"
    if notes.isEmpty then o.help
    else if o.help == "" then s"(${notes.mkString(", ")})"
    else s"${o.help} (${notes.mkString(", ")})"

// What an option of `kind` is, with its article, for a message.
private kindName(kind: Kind) -> string
kindName(Switch) = "a flag"
kindName(Text) = "a string"
kindName(Whole) = "an int"
kindName(Fraction) = "a real"
kindName(OneOf(_)) = "a choice"

// The arguments of one command line, as `Parser.parse` read them. Each value is asked for by the name
// it was declared with, as the type it was declared with. Asking for a name that was never declared,
// or as another type, is the program's mistake and traps.
class Args(options: Vector[Opt], arguments: Vector[Pos], seen: Map[string, Vector[string]])
    // Whether the flag `name` was given.
    flag(name: string) -> bool = count(name) > 0

    // How many times the flag `name` was given: 3 for `-vvv` or `-v -v -v`.
    count(name: string) -> int
        expect(name, "a flag", k -> k is Switch)
        seen.getOrElse(name, Vector.empty[string]()).length

    // Whether the option or argument `name` was given on the command line, rather than taking its
    // default.
    given(name: string) -> bool
        if !declared(name) then fail(s"cli: nothing is declared as `$name`")
        seen.getOrElse(name, Vector.empty[string]()).nonEmpty

    // The text of the option `name`, of a choice, or of the positional argument `name`: the last
    // value given, else its default, which is empty where it has none. For a positional argument
    // that takes the rest, it is the last of them.
    string(name: string) -> string = last(name, textual(name))

    // Every text given for a repeated option, in order, or the default alone where none was and it
    // has one; or every argument a positional argument that takes the rest took.
    strings(name: string) -> Vector[string] = every(name, textual(name))

    // The value of the int option `name`: the last given, else its default.
    int(name: string) -> int
        expect(name, "an int", k -> k is Whole)
        last(name, true).toIntOption().get

    // Every value given for the repeated int option `name`, or its default alone where none was.
    ints(name: string) -> Vector[int]
        expect(name, "an int", k -> k is Whole)
        every(name, true).map(_.toIntOption().get)

    // The value of the real option `name`: the last given, else its default.
    real(name: string) -> real
        expect(name, "a real", k -> k is Fraction)
        last(name, true).toRealOption().get

    // Every value given for the repeated real option `name`, or its default alone where none was.
    reals(name: string) -> Vector[real]
        expect(name, "a real", k -> k is Fraction)
        every(name, true).map(_.toRealOption().get)

    private declared(name: string) -> bool = options.exists(_.name == name) || arguments.exists(_.name == name)

    // Whether `name` is a text option, a choice or a positional argument, trapping where it is none.
    private textual(name: string) -> bool
        if arguments.exists(_.name == name) then return false
        expect(name, "a string", k -> k is Text || k is OneOf(_))
        true

    // Traps unless `name` is an option whose kind `fits`.
    private expect(name: string, wanted: string, fits: (Kind) -> bool)
        options.find(_.name == name) match
            Some(o) -> if !fits(o.kind) then fail(s"cli: `--$name` is ${kindName(o.kind)} option, asked for as $wanted")
            None ->
                if arguments.exists(_.name == name) then fail(s"cli: the argument `<$name>` is a string, asked for as $wanted")
                fail(s"cli: no option is declared as `--$name`")

    // The last value of `name`, or its default. `isOption` is false for a positional argument, whose
    // default is empty.
    private last(name: string, isOption: bool) -> string
        val values = seen.getOrElse(name, Vector.empty[string]())
        if values.nonEmpty then return values.last
        if isOption then options.find(_.name == name).get.fallback else ""

    // Every value of `name`, or its default alone where none was given and it has one.
    private every(name: string, isOption: bool) -> Vector[string]
        val values = seen.getOrElse(name, Vector.empty[string]())
        if values.nonEmpty || !isOption then return values
        val o = options.find(_.name == name).get
        if o.shown then [o.fallback] else values
