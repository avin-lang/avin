module avin

// An immutable indexed sequence whose elements are in one array that nothing writes to after the
// sequence is made, so `xs(i)` takes constant time, with no level of a tree between the index and
// the element, and an operation that makes a changed sequence, such as `:+` or `updated`, copies
// them. It is for a sequence built once and then read.
class ArraySeq[+T](private val elements: FrozenArray[T]): Seq[T]
  override length -> int = elements.length

  // The element at `index`, which traps when there is none.
  override apply(index: int) -> T = elements(index)

  // The elements from `from` up to `until`, which traps when the indices are not in order within
  // the sequence.
  slice(from: int, until: int) -> ArraySeq[T] = ArraySeq(elements.slice(from, until))

  // `f` of each element, in order.
  map[U](f: (T) -> U) -> ArraySeq[U]
    val b = ArraySeq.newBuilder[U]()
    for i in 0 ..< elements.length do b.addOne(f(elements(i)))
    b.result()

  // The elements that satisfy `p`, in order.
  filter(p: (T) -> bool) -> ArraySeq[T]
    val b = ArraySeq.newBuilder[T]()
    for i in 0 ..< elements.length
      val x = elements(i)
      if p(x) then b.addOne(x)
    b.result()

  // `pf` of each element it is defined at, in order: `xs.collect(match Some(n) -> n)`.
  collect[U](pf: PartialFunction[T, U]) -> ArraySeq[U]
    val f = pf.lift()
    val b = ArraySeq.newBuilder[U]()
    for i in 0 ..< elements.length
      if f(elements(i)) is Some(u) then b.addOne(u)
    b.result()

  override toVector -> Vector[T] = vectorOf(elements)

  override iterator() -> Iterator[T] = ArraySeqIterator(elements, 0)

// The methods an `impl` adds to a class whose fields are all immutable are not variance positions,
// so `T` may appear in a parameter: on an `ArraySeq[Dog]` seen as an `ArraySeq[Animal]`, `T` is
// `Animal`.
impl[T] ArraySeq[T]
  // The elements of the collections `f` makes of each element, joined in order.
  flatMap[U](f: (T) -> Iterable[U]) -> ArraySeq[U]
    val b = ArraySeq.newBuilder[U]()
    for i in 0 ..< elements.length do b.addAll(f(elements(i)))
    b.result()

  // The values of the options `f` makes of each element, those that hold one, in order.
  flatMap[U](f: (T) -> Option[U]) -> ArraySeq[U] = keptSomeInto(self, f, ArraySeq.newBuilder[U]())

  // The elements that satisfy `p`, tested only as `map`, `flatMap` or `foreach` reaches each one.
  withFilter(p: (T) -> bool) -> FilteredArraySeq[T] = FilteredArraySeq(self, p)

  // This sequence with `element` after its elements: `xs :+ x`.
  :+[W >: T](element: W) -> ArraySeq[W]
    val n = elements.length
    val a = newArray[W](n + 1)
    for i in 0 ..< n do a(i) = elements(i)
    a(n) = element
    ArraySeq(freeze(a))

  // This sequence with `element` before its elements: `x +: xs`.
  +:[W >: T](element: W) -> ArraySeq[W]
    val n = elements.length
    val a = newArray[W](n + 1)
    a(0) = element
    for i in 0 ..< n do a(i + 1) = elements(i)
    ArraySeq(freeze(a))

  // The elements of this sequence followed by those of `other`: `xs ++ ys`.
  ++[W >: T](other: ArraySeq[W]) -> ArraySeq[W]
    val n = elements.length
    val m = other.length
    val a = newArray[W](n + m)
    for i in 0 ..< n do a(i) = elements(i)
    for i in 0 ..< m do a(n + i) = other(i)
    ArraySeq(freeze(a))

  // This sequence with the element at `index` replaced by `element`; traps when there is none.
  updated[W >: T](index: int, element: W) -> ArraySeq[W]
    if index < 0 || index >= elements.length then fail("index out of range")
    val a = newArray[W](elements.length)
    for i in 0 ..< elements.length do a(i) = elements(i)
    a(index) = element
    ArraySeq(freeze(a))

  // The elements of this sequence followed by those of `other`.
  ++[W >: T](other: Iterable[W]) -> ArraySeq[W] = joinedInto[W, ArraySeq[W]](self, other, ArraySeq.newBuilder[W]())

  // The elements that do not satisfy `p`, in order.
  filterNot(p: (T) -> bool) -> ArraySeq[T] = keptInto(self, p, false, ArraySeq.newBuilder[T]())

  // The first `n` elements, or all of them when there are fewer.
  take(n: int) -> ArraySeq[T] = ArraySeq(elements.slice(0, clamped(n, elements.length)))

  // The elements after the first `n`; empty when there are no more.
  drop(n: int) -> ArraySeq[T] = ArraySeq(elements.slice(clamped(n, elements.length), elements.length))

  // The last `n` elements, or all of them when there are fewer.
  takeRight(n: int) -> ArraySeq[T]
    val total = elements.length
    ArraySeq(elements.slice(total - clamped(n, total), total))

  // The elements before the last `n`; empty when there are no more.
  dropRight(n: int) -> ArraySeq[T]
    val total = elements.length
    ArraySeq(elements.slice(0, total - clamped(n, total)))

  // The elements before the first that does not satisfy `p`.
  takeWhile(p: (T) -> bool) -> ArraySeq[T] = take(prefixLength(p))

  // The elements from the first that does not satisfy `p` on.
  dropWhile(p: (T) -> bool) -> ArraySeq[T] = drop(prefixLength(p))

  // The first `n` elements and the rest: `(take(n), drop(n))`.
  splitAt(n: int) -> (ArraySeq[T], ArraySeq[T]) = (take(n), drop(n))

  // `(takeWhile(p), dropWhile(p))`, testing each element once.
  span(p: (T) -> bool) -> (ArraySeq[T], ArraySeq[T])
    val k = prefixLength(p)
    (take(k), drop(k))

  // Every element after the first, which traps on the empty sequence.
  tail -> ArraySeq[T]
    if elements.length == 0 then fail("tail of an empty sequence")
    drop(1)

  // Every element before the last, which traps on the empty sequence.
  init -> ArraySeq[T]
    if elements.length == 0 then fail("init of an empty sequence")
    dropRight(1)

  // The elements in the opposite order.
  reverse -> ArraySeq[T] = reversedInto(self, ArraySeq.newBuilder[T]())

  // The elements followed by as many copies of `element` as make `total` of them.
  padTo(total: int, element: T) -> ArraySeq[T] = paddedInto(self, total, element, ArraySeq.newBuilder[T]())

  // The elements with each one equal to an earlier one left out.
  distinct -> ArraySeq[T] = distinctInto(self, x -> x, ArraySeq.newBuilder[T]())

  // The elements with each one whose `key` equals an earlier one's left out.
  distinctBy[K](key: (T) -> K) -> ArraySeq[T] = distinctInto(self, key, ArraySeq.newBuilder[T]())

  // The elements that are also in `other`, counted as a multiset, in this sequence's order.
  intersect(other: Seq[T]) -> ArraySeq[T] = multisetInto(self, other, true, ArraySeq.newBuilder[T]())

  // The elements less those in `other`, counted as a multiset, in this sequence's order.
  diff(other: Seq[T]) -> ArraySeq[T] = multisetInto(self, other, false, ArraySeq.newBuilder[T]())

  // How many elements from the first on satisfy `p`.
  private prefixLength(p: (T) -> bool) -> int
    var k = 0
    while k < elements.length && p(elements(k)) do k += 1
    k

  // A new array of the elements.
  toArray() -> Array[T]
    val a = newArray[T](elements.length)
    for i in 0 ..< elements.length do a(i) = elements(i)
    publish(a)
    a

  // A new buffer of the elements.
  toBuffer() -> Buffer[T]
    val b = Buffer[T]()
    for i in 0 ..< elements.length do b.addOne(elements(i))
    b

  // This sequence itself: it is already one.
  override toArraySeq -> ArraySeq[T] = self

// A sequence of displayable elements displays as `[1, 2, 3]`, as an array does. A field width pads
// the whole.
// Array sequences order element by element, and one orders before every longer one it begins.
impl[T: Ord] Ord for ArraySeq[T]
  compare(other: ArraySeq[T]) -> int
    val n = length
    val m = other.length
    val common = if n < m then n else m
    for i in 0 ..< common
      val order = self(i).compare(other(i))
      if order != 0 then return order
    if n < m then -1 elif n > m then 1 else 0

impl[T: Display] Display for ArraySeq[T]
  display(out: Writer, spec: FormatSpec)
    if spec.width > 0
      val text = StringWriter()
      display(text, FormatSpec())
      out.writeField(text.text, spec)
      return
    out.write("[")
    for i in 0 ..< elements.length
      if i > 0 then out.write(", ")
      elements(i).display(out, FormatSpec())
    out.write("]")

// The diagnostic form is the elements' diagnostic forms in brackets: `["a", "b"]`.
impl[T: Debug] Debug for ArraySeq[T]
  debug(out: Writer, spec: FormatSpec)
    if spec.width > 0
      val text = StringWriter()
      debug(text, FormatSpec())
      out.writeField(text.text, spec)
      return
    out.write("[")
    for i in 0 ..< elements.length
      if i > 0 then out.write(", ")
      elements(i).debug(out, FormatSpec())
    out.write("]")

object ArraySeq
  // A sequence with no elements.
  empty[T]() -> ArraySeq[T] = ArraySeq(freeze(newArray[T](0)))

  // A sequence of `length` elements, the element at `i` being `f(i)`, computed in index order;
  // empty when `length` is not positive.
  tabulate[T](length: int, f: (int) -> T) -> ArraySeq[T]
    val b = ArraySeq.newBuilder[T]()
    var i = 0
    while i < length
      b.addOne(f(i))
      i += 1
    b.result()

  // A sequence of `length` elements, each the value of `element`, which is evaluated once for
  // each; empty when `length` is not positive.
  fill[T](length: int, element: -> T) -> ArraySeq[T]
    val b = ArraySeq.newBuilder[T]()
    var i = 0
    while i < length
      b.addOne(element)
      i += 1
    b.result()

  // A sequence of the elements of `elements`, in iteration order.
  from[T](elements: Iterable[T]) -> ArraySeq[T]
    val b = ArraySeq.newBuilder[T]()
    b.addAll(elements)
    b.result()

  // A builder of a sequence: the elements it is given, in order.
  newBuilder[T]() -> ArraySeqBuilder[T] = ArraySeqBuilder(Buffer[T](), false)

// Builds an `ArraySeq` from the elements given to it, which it keeps in a buffer until `result()`.
class ArraySeqBuilder[T](private val buffer: Buffer[T], private var spent: bool): Builder[T, ArraySeq[T]]
  override addOne(element: T)
    if spent then fail("add to a builder whose result was taken")
    buffer.addOne(element)

  override result() -> ArraySeq[T]
    if spent then fail("result of a builder whose result was taken")
    spent = true
    buffer.toArraySeq

  override clear()
    buffer.clear()
    spent = false

  override sizeHint(size: int) = buffer.sizeHint(size)

  override knownSize -> int = buffer.length

// An `ArraySeq` seen through a test, which a guard of a `for` with `yield` makes: each element is
// tested just before the call after it would use it, so a guard runs in turn with the rest of the
// comprehension, element by element.
class FilteredArraySeq[T](private val seq: ArraySeq[T], private val p: (T) -> bool)
  // The sequence of `f` of each element that passes the test, in order.
  map[U](f: (T) -> U) -> ArraySeq[U]
    val b = ArraySeq.newBuilder[U]()
    for x in seq
      if p(x) then b.addOne(f(x))
    b.result()

  // The elements of the collections `f` makes of each element that passes the test, in order.
  flatMap[U](f: (T) -> Iterable[U]) -> ArraySeq[U]
    val b = ArraySeq.newBuilder[U]()
    for x in seq
      if p(x) then b.addAll(f(x))
    b.result()

  // The values of the options `f` makes of each element that passes the test, in order.
  flatMap[U](f: (T) -> Option[U]) -> ArraySeq[U] = keptSomeInto(
    seq,
    x -> if p(x) then f(x) else None,
    ArraySeq.newBuilder[U]()
  )

  // The elements that pass this test and then `q`.
  withFilter(q: (T) -> bool) -> FilteredArraySeq[T] = FilteredArraySeq(seq, x -> p(x) && q(x))

  // Calls `f` with each element that passes the test, in order.
  foreach(f: (T) -> unit)
    for x in seq
      if p(x) then f(x)

// Steps through an `ArraySeq`'s elements.
private class ArraySeqIterator[T](items: FrozenArray[T], private var index: int): Iterator[T]
  override hasNext() -> bool = index < items.length

  override next() -> T
    if index >= items.length then fail("next on an exhausted iterator")
    val value = items(index)
    index += 1
    value
