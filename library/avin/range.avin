module avin

// An arithmetic progression of `int`s: from `start` toward `limit` by `step`, including `limit` when
// `inclusive` holds and it lies on the progression. `a..b` is `Range(a, b, 1, true)` and `a..<b` is
// `Range(a, b, 1, false)`; `by` sets another step. A positive step counts up, so a range whose limit
// lies below its start is empty, and a negative step counts down. Iteration stops without stepping
// past the limit, or past the largest or smallest `int`. A step of zero traps.
//
// A range is a sequence of its values: `(1 ..< 10 by 3)(2)` is 7, and its length, an index and
// whether it holds a value are each computed from its bounds in constant time. It holds only a
// progression, so what a sequence method makes of it, from `map` to `take` and `reverse`, is a
// vector.
class Range(val start: int, val limit: int, val step: int, val inclusive: bool): Seq[int]
    if step == 0 then fail("range step is zero")

    // The same range with step `amount`.
    by(amount: int) -> Range = Range(start, limit, amount, inclusive)

    // The number of values; a range of more values than the largest `int` traps.
    override length -> int
        val n = count()
        if n > 2147483647 then fail("range has more values than an int holds")
        int(n)

    // The value at `index`, `start + index * step`, which traps when there is none.
    override apply(index: int) -> int
        if index < 0 || long(index) >= count() then fail("index out of range")
        at(long(index))

    // The first and last values and the value at an index are answered from the bounds, so they
    // need no `length` and work on a range of more values than an `int` holds.
    override lift(index: int) -> Option[int] = if index >= 0 && long(index) < count() then Some(at(long(index))) else None

    override head -> int
        if count() == 0 then fail("head of an empty sequence")
        start

    override headOption -> Option[int] = if count() == 0 then None else Some(start)

    override last -> int
        val n = count()
        if n == 0 then fail("last of an empty sequence")
        at(n - 1)

    override lastOption -> Option[int]
        val n = count()
        if n == 0 then None else Some(at(n - 1))

    // Whether `value` is one of the values: between the first and the last, a whole number of steps
    // from the first.
    contains(value: int) -> bool
        val n = count()
        if n == 0 then return false
        val offset = long(value) - long(start)
        val span = (n - 1) * long(step)
        val between = if step > 0 then 0 <= offset <= span else span <= offset <= 0
        between && offset % long(step) == 0

    override isEmpty -> bool = !within(start, limit, step, inclusive)

    override nonEmpty -> bool = within(start, limit, step, inclusive)

    override iterator() -> Iterator[int] = RangeIterator(start, limit, step, inclusive, nonEmpty)

    // The value `index` steps from the start, for an index below `count()`.
    private at(index: long) -> int = int(long(start) + index * long(step))

    // The number of values, in a `long`, since `int.min .. int.max` has more than an `int` holds.
    private count() -> long
        if !within(start, limit, step, inclusive) then return 0
        // The furthest point on the near side of the limit, which need not lie on the progression.
        val last = if inclusive then long(limit) elif step > 0 then long(limit) - 1 else long(limit) + 1
        (last - long(start)) / long(step) + 1

// A range displays as it is written: `1..5`, `0..<10`, and `0..<10 by 2` where the step is not 1.
// Its diagnostic form is the same. A field width pads the whole.
impl Display for Range
    display(out: Writer, spec: FormatSpec) = out.writeField(rangeText(long(start), long(limit), long(step), inclusive), spec)

impl Debug for Range
    debug(out: Writer, spec: FormatSpec) = out.writeField(rangeText(long(start), long(limit), long(step), inclusive), spec)

// How a range of any integer type is written: its start, `..` or `..<`, its limit, and its step after
// `by` where that is not 1.
private rangeText(start: long, limit: long, step: long, inclusive: bool) -> string =
    val bounds = s"$start${if inclusive then ".." else "..<"}$limit"
    if step == 1 then bounds else s"$bounds by $step"

// Whether `value` lies on the near side of `limit` for a progression by `step`.
private within(value: int, limit: int, step: int, inclusive: bool) -> bool
    if step > 0 then (if inclusive then value <= limit else value < limit)
    else (if inclusive then value >= limit else value > limit)

// Steps through a range: `current` is the next value, and `more` whether it is one.
private class RangeIterator(private var current: int, limit: int, step: int, inclusive: bool, private var more: bool): Iterator[int]
    override hasNext() -> bool = more

    override next() -> int
        if !more then fail("next on an exhausted iterator")
        val value = current
        val following = current +% step
        // A step that wraps around has passed the largest or smallest `int`.
        val advanced = if step > 0 then following > current else following < current
        more = advanced && within(following, limit, step, inclusive)
        current = following
        value
