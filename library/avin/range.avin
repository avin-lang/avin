module avin

// An arithmetic progression of `int`s: from `start` toward `limit` by `step`, including `limit` when
// `inclusive` holds and it lies on the progression. `a..b` is `Range(a, b, 1, true)` and `a..<b` is
// `Range(a, b, 1, false)`; `by` sets another step. A positive step counts up, so a range whose limit
// lies below its start is empty, and a negative step counts down. Iteration stops without stepping
// past the limit, or past the largest or smallest `int`. A step of zero traps.
class Range(val start: int, val limit: int, val step: int, val inclusive: bool): Iterable[int]
    if step == 0 then fail("range step is zero")

    // The same range with step `amount`.
    by(amount: int) -> Range = Range(start, limit, amount, inclusive)

    isEmpty() -> bool = !within(start, limit, step, inclusive)

    nonEmpty() -> bool = within(start, limit, step, inclusive)

    // The vector of `f` of each value, in order: a range holds only a progression, so what it maps
    // to is collected in a vector.
    map[U](f: (int) -> U) -> Vector[U]
        val b = Vector.builder[U]()
        for i in self do b.add(f(i))
        b.result()

    // The vector of the elements of the collections `f` makes of each value, in order.
    flatMap[U](f: (int) -> Iterable[U]) -> Vector[U]
        val b = Vector.builder[U]()
        for i in self do b.addAll(f(i))
        b.result()

    // The values that satisfy `p`, tested only as `map`, `flatMap` or `foreach` reaches each one.
    withFilter(p: (int) -> bool) -> FilteredRange = FilteredRange(self, p)

    // Calls `f` with each value, in order.
    foreach(f: (int) -> unit)
        for i in self do f(i)

    override iterator() -> Iterator[int] = RangeIterator(start, limit, step, inclusive, nonEmpty())

// A range seen through a test, which a guard of a `for` with `yield` makes: each value is tested just
// before the call after it would use it.
class FilteredRange(private val range: Range, private val p: (int) -> bool)
    // The vector of `f` of each value that passes the test, in order.
    map[U](f: (int) -> U) -> Vector[U]
        val b = Vector.builder[U]()
        for i in range
            if p(i) then b.add(f(i))
        b.result()

    // The vector of the elements of the collections `f` makes of each value that passes the test.
    flatMap[U](f: (int) -> Iterable[U]) -> Vector[U]
        val b = Vector.builder[U]()
        for i in range
            if p(i) then b.addAll(f(i))
        b.result()

    // The values that pass this test and then `q`.
    withFilter(q: (int) -> bool) -> FilteredRange = FilteredRange(range, i -> p(i) && q(i))

    // Calls `f` with each value that passes the test, in order.
    foreach(f: (int) -> unit)
        for i in range
            if p(i) then f(i)

// Whether `value` lies on the near side of `limit` for a progression by `step`.
private within(value: int, limit: int, step: int, inclusive: bool) -> bool
    if step > 0 then (if inclusive then value <= limit else value < limit)
    else (if inclusive then value >= limit else value > limit)

// Steps through a range: `current` is the next value, and `more` whether it is one.
private class RangeIterator(private var current: int, limit: int, step: int, inclusive: bool, private var more: bool): Iterator[int]
    override hasNext() -> bool = more

    override next() -> int
        if !more then fail("next on an exhausted iterator")
        val value = current
        val following = current +% step
        // A step that wraps around has passed the largest or smallest `int`.
        val advanced = if step > 0 then following > current else following < current
        more = advanced && within(following, limit, step, inclusive)
        current = following
        value
