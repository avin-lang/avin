module avin

// An immutable sequence whose elements are computed when they are first needed and then kept. A
// lazy list is a chain of cells, each either empty or an element and the lazy list of the rest; a
// cell is evaluated the first time something reads it, at most once, and every later read gives the
// cell kept. `LazyList.cons(x, rest)` makes a list whose `rest` is not evaluated until the cell after
// `x` is wanted, so a list may be endless, and may be defined by reference to itself:
//
//     lazy val fibs: LazyList[long] = LazyList.cons(0, LazyList.cons(1, fibs.zip(fibs.tail()).map(p -> p.0 + p.1)))
//
// `map`, `filter`, `take`, `drop`, `takeWhile`, `dropWhile`, `zip`, `zipWithIndex`, `++` and
// `flatMap` evaluate nothing when they are called: each makes a new lazy list whose cells read the
// cells of the source as they are themselves read. `length()`, `apply`, `toVector()`, `foreach`,
// `foldLeft` and the other methods every `Iterable` has evaluate the cells they need, and on an
// endless list a method that needs them all does not return.
//
// Evaluating cells is a loop, never a recursion over the list: a list of any length is walked,
// counted and converted without deepening the stack, and a `filter` or `dropWhile` skipping any
// number of elements does so in one loop. Only a pipeline adds depth, one frame for each of its
// stages, when a cell of the last stage is first read.
//
// A cell is a `lazy val`, so a cell whose evaluation reads that same cell traps there. A lazy list
// is not sendable, since the cells not yet evaluated are functions that may hold anything. Once a
// cell is evaluated, the expression that computed it is dropped, along with everything it held, so a
// list holds only the elements evaluated and the expressions for the cells not yet evaluated. A list
// whose head nothing holds is collected cell by cell as a `for` loop or an iterator walks it.
class LazyList[+T](private val pending: () -> Option[(T, LazyList[T])], private val progress: LazyListProgress): Iterable[T]
    private lazy val cell: Option[(T, LazyList[T])] = evaluate()

    private evaluate() -> Option[(T, LazyList[T])]
        val evaluated = pending()
        progress.evaluated = true
        evaluated

    // An iterator over the elements, evaluating each cell as it reaches it. It holds only the cell it
    // has reached, so a list read through it alone is collected behind it.
    override iterator() -> Iterator[T] = LazyListIterator(self)

    // Whether the list has no elements, which evaluates its first cell.
    isEmpty() -> bool = cell.isEmpty()

    // Whether the list has an element, which evaluates its first cell.
    nonEmpty() -> bool = cell.isDefined()

    // The first element, or `None` on the empty list; it evaluates the first cell only.
    override headOption() -> Option[T] = cell match
        Some((x, _)) -> Some(x)
        None -> None

    // The first element, which traps on the empty list.
    override head() -> T = cell match
        Some((x, _)) -> x
        None -> fail("head of an empty lazy list")

    // The list after the first element, which traps on the empty list. It evaluates the first cell
    // and not the rest.
    tail() -> LazyList[T] = cell match
        Some((_, rest)) -> rest
        None -> fail("tail of an empty lazy list")

    // 0 when the list is known to be empty without evaluating anything, otherwise `-1`.
    override knownSize() -> int = if progress.evaluated && cell.isEmpty() then 0 else -1

    // Whether the first cell has been evaluated. It evaluates nothing.
    isEvaluated() -> bool = progress.evaluated

    // The number of elements, evaluating every cell; on an endless list it does not return.
    length() -> int
        var n = 0
        var xs = self
        loop
            xs.cell match
                Some((_, rest)) ->
                    n += 1
                    xs = rest
                None -> return n

    // The number of elements: the same as `length()`.
    override size() -> int = length()

    // The element at `index`, evaluating the cells up to it; an index past the end, or a negative
    // one, traps.
    apply(index: int) -> T = lift(index) match
        Some(x) -> x
        None -> fail("lazy list index out of range")

    // The element at `index`, or `None` where there is none. It evaluates the cells up to `index`,
    // and none for a negative index.
    lift(index: int) -> Option[T]
        if index < 0 then return None
        var i = 0
        var xs = self
        loop
            xs.cell match
                Some((x, rest)) ->
                    if i == index then return Some(x)
                    i += 1
                    xs = rest
                None -> return None

    // The list itself, once every cell has been evaluated; on an endless list it does not return.
    force() -> LazyList[T]
        length()
        self

    // The list of `f` of each element, each computed when its cell is first read.
    map[U](f: (T) -> U) -> LazyList[U] = lazyListOf(() -> mappedCell(f))

    private mappedCell[U](f: (T) -> U) -> Option[(U, LazyList[U])] = cell match
        Some((x, rest)) -> Some((f(x), rest.map(f)))
        None -> None

    // The elements for which `p` holds, in order. Reading a cell runs `p` over the source's elements
    // up to the next one it accepts, in one loop.
    filter(p: (T) -> bool) -> LazyList[T] = lazyListOf(() -> filteredCell(p))

    private filteredCell(p: (T) -> bool) -> Option[(T, LazyList[T])]
        var xs = self
        loop
            xs.cell match
                Some((x, rest)) ->
                    if p(x) then return Some((x, rest.filter(p)))
                    xs = rest
                None -> return None

    // The elements for which `p` does not hold.
    filterNot(p: (T) -> bool) -> LazyList[T] = filter(x -> !p(x))

    // The first `n` elements, or all of them when there are fewer; empty when `n` is not positive.
    // The cell after the `n`th is never read.
    take(n: int) -> LazyList[T] = if n <= 0 then LazyList.empty[T]() else lazyListOf(() -> takenCell(n))

    private takenCell(n: int) -> Option[(T, LazyList[T])] = cell match
        Some((x, rest)) -> Some((x, rest.take(n - 1)))
        None -> None

    // The elements after the first `n`; the whole list when `n` is not positive. The `n` cells are
    // skipped when the first cell of the result is read.
    drop(n: int) -> LazyList[T] = if n <= 0 then self else lazyListOf(() -> droppedCell(n))

    private droppedCell(n: int) -> Option[(T, LazyList[T])]
        var xs = self
        var left = n
        while left > 0
            xs.cell match
                Some((_, rest)) -> xs = rest
                None -> return None
            left -= 1
        xs.cell

    // The longest prefix of elements for which `p` holds. The element that ends it is read, and
    // nothing after it.
    takeWhile(p: (T) -> bool) -> LazyList[T] = lazyListOf(() -> takenWhileCell(p))

    private takenWhileCell(p: (T) -> bool) -> Option[(T, LazyList[T])] = cell match
        Some((x, rest)) -> if p(x) then Some((x, rest.takeWhile(p))) else None
        None -> None

    // The elements from the first for which `p` does not hold.
    dropWhile(p: (T) -> bool) -> LazyList[T] = lazyListOf(() -> droppedWhileCell(p))

    private droppedWhileCell(p: (T) -> bool) -> Option[(T, LazyList[T])]
        var xs = self
        loop
            xs.cell match
                Some((x, rest)) ->
                    if !p(x) then return xs.cell
                    xs = rest
                None -> return None

    // Pairs of this list's elements and `other`'s, in order, as long as the shorter.
    zip[U](other: LazyList[U]) -> LazyList[(T, U)] = lazyListOf(() -> zippedCell(other))

    private zippedCell[U](other: LazyList[U]) -> Option[((T, U), LazyList[(T, U)])] = cell match
        Some((x, rest)) -> other.headOption() match
            Some(y) -> Some(((x, y), rest.zip(other.tail())))
            None -> None
        None -> None

    // Each element paired with its index, from 0.
    zipWithIndex() -> LazyList[(T, int)] = zip(LazyList.from(0))

    // This list's elements and then `other`'s. `other` is evaluated when the cell after this list's
    // last element is first read, and not at all until then.
    ++[W >: T](other: -> LazyList[W]) -> LazyList[W] = appended(() -> other)

    private appended[W >: T](other: () -> LazyList[W]) -> LazyList[W] = lazyListOf(() -> appendedCell(other))

    private appendedCell[W >: T](other: () -> LazyList[W]) -> Option[(W, LazyList[W])] = cell match
        Some((x, rest)) -> Some((x, rest.appended(other)))
        None -> other().evaluatedCell()

    // The elements of `f` of each element, in order. A collection `f` gives is read through its
    // iterator as the cells are read; reading a cell runs `f` over as many elements as give nothing.
    flatMap[U](f: (T) -> Iterable[U]) -> LazyList[U] = lazyListOf(() -> flatMappedCell(f))

    private flatMappedCell[U](f: (T) -> Iterable[U]) -> Option[(U, LazyList[U])]
        var xs = self
        loop
            xs.cell match
                Some((x, rest)) ->
                    val inner = f(x).iterator()
                    if inner.hasNext()
                        val first = inner.next()
                        return Some((first, inner.toLazyList() ++ rest.flatMap(f)))
                    xs = rest
                None -> return None

    // The list with `element` in front of it: `x +: xs`. The list after `element` is this one, whose
    // cells stay as they are.
    +:[W >: T](element: W) -> LazyList[W]
        val rest: LazyList[W] = self
        lazyListOf(() -> Some((element, rest)))

    // The cell, evaluated, for a list made from another's.
    private evaluatedCell() -> Option[(T, LazyList[T])] = cell

// Whether a lazy list's first cell has been evaluated, which `Display` and `knownSize()` ask without
// evaluating it.
private class LazyListProgress(var evaluated: bool)

// The lazy list whose first cell `f` computes. `f` is called at most once, and is dropped once it
// has been, so a cell evaluated holds nothing of the expression that made it.
private lazyListOf[T](f: () -> Option[(T, LazyList[T])]) -> LazyList[T]
    var held: Option[() -> Option[(T, LazyList[T])]] = Some(f)
    val once = () ->
        val compute = held.get()
        held = None
        compute()
    LazyList(once, LazyListProgress(false))

private class LazyListIterator[T](private var rest: LazyList[T]): Iterator[T]
    override hasNext() -> bool = rest.nonEmpty()

    override next() -> T
        val x = rest.head()
        rest = rest.tail()
        x

// A lazy list of displayable elements displays the elements evaluated so far, in brackets, without
// evaluating any: `[1, 2, 3]` when every cell has been evaluated, `[1, 2, …]` when the cell after 2
// has not, and `[…]` when nothing has. A field width pads the whole.
impl[T: Display] Display for LazyList[T]
    display(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            display(text, FormatSpec())
            out.writeField(text.text(), spec)
            return
        out.write("[")
        var first = true
        var xs = self
        loop
            if !xs.isEvaluated()
                out.write(if first then "…" else ", …")
                break
            xs.cell match
                Some((x, rest)) ->
                    if !first then out.write(", ")
                    x.display(out, FormatSpec())
                    first = false
                    xs = rest
                None -> break
        out.write("]")

// A lazy list's diagnostic form is the diagnostic forms of the elements evaluated so far, in
// brackets, with `…` for the cells not evaluated: `["a", "b", …]`. It evaluates nothing.
impl[T: Debug] Debug for LazyList[T]
    debug(out: Writer, spec: FormatSpec)
        if spec.width > 0
            val text = StringWriter()
            debug(text, FormatSpec())
            out.writeField(text.text(), spec)
            return
        out.write("[")
        var first = true
        var xs = self
        loop
            if !xs.isEvaluated()
                out.write(if first then "…" else ", …")
                break
            xs.cell match
                Some((x, rest)) ->
                    if !first then out.write(", ")
                    x.debug(out, FormatSpec())
                    first = false
                    xs = rest
                None -> break
        out.write("]")

// Lazy lists made from a value, a function or a collection. Each evaluates nothing when it is made;
// the names and argument orders are `Iterator`'s.
object LazyList
    // The empty lazy list.
    empty[T]() -> LazyList[T] = lazyListOf(() -> None)

    // The list of `head` and then the list `tail` gives. `tail` is evaluated when the cell after
    // `head` is first read, once, and not at all if it never is; `head` is evaluated at the call.
    cons[T](head: T, tail: -> LazyList[T]) -> LazyList[T] = lazyListOf(() -> Some((head, lazyListOf(() -> tail.evaluatedCell()))))

    // The endless list of `start`, `f(start)`, `f(f(start))` and so on, each call of `f` made when its
    // cell is first read.
    iterate[T](start: T, f: (T) -> T) -> LazyList[T] = lazyListOf(() -> Some((start, iteratedAfter(start, f))))

    private iteratedAfter[T](previous: T, f: (T) -> T) -> LazyList[T] = lazyListOf(() ->
        val x = f(previous)
        Some((x, iteratedAfter(x, f))))

    // The elements `f` gives from `state`: while `f` of the state is `Some((element, next))`, the
    // element is given and `next` becomes the state; the first `None` ends the list. `f` is called
    // when the cell is first read.
    unfold[T, S](state: S, f: (S) -> Option[(T, S)]) -> LazyList[T] = lazyListOf(() ->
        f(state) match
            Some((x, next)) -> Some((x, unfold(next, f)))
            None -> None)

    // The endless list of the values of `element`, evaluated once for each cell, when it is first
    // read.
    continually[T](element: -> T) -> LazyList[T] = lazyListOf(() -> Some((element, continually(element))))

    // The endless list of `start`, `start + 1`, `start + 2` and so on, of any integer type. An
    // element is computed when its cell is first read, so an addition that overflows traps only when
    // the cell past the greatest value is read.
    from[T: Integer](start: T) -> LazyList[T] = from(start, T(1))

    // The endless list of `start`, `start + step`, `start + 2 * step` and so on; a negative `step`
    // counts down. Overflow traps as `from(start)`'s does.
    from[T: Integer](start: T, step: T) -> LazyList[T] = lazyListOf(() -> Some((start, countedAfter(start, step))))

    private countedAfter[T: Integer](previous: T, step: T) -> LazyList[T] = lazyListOf(() ->
        val x = previous + step
        Some((x, countedAfter(x, step))))

    // A list of `count` elements, each the value of `element`, evaluated when its cell is first read;
    // empty when `count` is not positive.
    fill[T](count: int, element: -> T) -> LazyList[T] = continually(element).take(count)

    // A list of `count` elements, the one at `i` being `f(i)`, computed when its cell is first read;
    // empty when `count` is not positive.
    tabulate[T](count: int, f: (int) -> T) -> LazyList[T] = from(0).take(count).map(f)

// Every collection and iterator converts to a lazy list.
impl[T] Iterable[T]
    // A lazy list of the elements, read from one iterator as the cells are first read. From an
    // iterator, the list takes the iterator over: the iterator must not be read on its own after.
    toLazyList() -> LazyList[T] = LazyList.unfold(iterator(), it -> if it.hasNext() then Some((it.next(), it)) else None)
