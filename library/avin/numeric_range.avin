module avin

// An arithmetic progression of any integer type: from `start` toward `limit` by `step`, including
// `limit` when `inclusive` holds and it lies on the progression. `a..b` and `a..<b` make one where
// `a` and `b` are integers of a type other than `int` (`Range` is the `int` progression), and `by`
// sets a step of the same type. A positive step counts up, so a range whose limit lies below its
// start is empty, and a negative step counts down. Iteration stops without stepping past the limit,
// so it never passes the largest or smallest value of the type. A step of zero traps.
//
// A range is a sequence of its values and answers an index, the first value, whether it holds a
// value and whether it contains one from its bounds in constant time, with no value of the type
// wrapping: a progression of `long`s may run to either end of the type. `length()` traps when
// there are more values than an `int` holds, and `last()` and the other questions that count the
// values trap for a range whose ends lie more than the largest `long` apart. What a sequence method
// makes of a range, from `map` to `take` and `reverse`, is a vector.
class NumericRange[T: Integer](val start: T, val limit: T, val step: T, val inclusive: bool): Seq[T]
    if long(step) == 0 then fail("range step is zero")

    // The same range with step `amount`.
    by(amount: T) -> NumericRange[T] = NumericRange[T](start, limit, amount, inclusive)

    // The number of values; a range of more values than the largest `int` traps.
    override length() -> int
        val n = count()
        if n > 2147483647 then fail("range has more values than an int holds")
        int(n)

    // The value at `index`, `start + index * step`, which traps when there is none.
    override apply(index: int) -> T
        lift(index) match
            Some(value) -> value
            None -> fail("index out of range")

    // The value at `index`, answered from the bounds, so it works on a range of more values than an
    // `int` holds.
    override lift(index: int) -> Option[T]
        if index < 0 then return None
        numberAt(long(start), long(limit), long(step), inclusive, long(index)) match
            Some(value) -> Some(T(value))
            None -> None

    override head() -> T
        if isEmpty() then fail("head of an empty sequence")
        start

    override headOption() -> Option[T] = if isEmpty() then None else Some(start)

    override last() -> T
        val n = count()
        if n == 0 then fail("last of an empty sequence")
        T(long(start) + (n - 1) * long(step))

    override lastOption() -> Option[T]
        val n = count()
        if n == 0 then None else Some(T(long(start) + (n - 1) * long(step)))

    // Whether `value` is one of the values: between the first and the limit, a whole number of steps
    // from the first. The distance is never computed, so it holds for a range of the whole type.
    contains(value: T) -> bool
        val v = long(value)
        val first = long(start)
        val by = long(step)
        if !numberWithin(first, long(limit), by, inclusive) then return false
        if !numberWithin(v, long(limit), by, inclusive) then return false
        if (if by > 0 then v < first else v > first) then return false
        if by == 1 || by == -1 then return true
        // `v - first` is a multiple of `step` when their remainders agree, or differ by one step.
        val p = v % by
        val q = first % by
        if p == q then return true
        if p > 0 && q < 0 then return (if by > 0 then p - by else p + by) == q
        if p < 0 && q > 0 then return (if by > 0 then p + by else p - by) == q
        false

    override isEmpty() -> bool = !numberWithin(long(start), long(limit), long(step), inclusive)

    override nonEmpty() -> bool = numberWithin(long(start), long(limit), long(step), inclusive)

    override iterator() -> Iterator[T] = NumericRangeIterator[T](long(start), long(limit), long(step), inclusive, nonEmpty())

    // The number of values, in a `long`; a range whose ends lie further apart than a `long` can
    // measure traps.
    private count() -> long = numberCount(long(start), long(limit), long(step), inclusive)

private numberMax() -> long = 9223372036854775807

private numberMin() -> long = -9223372036854775807 - 1

// Whether `value` lies on the near side of `limit` for a progression by `step`.
private numberWithin(value: long, limit: long, step: long, inclusive: bool) -> bool
    if step > 0 then (if inclusive then value <= limit else value < limit)
    else (if inclusive then value >= limit else value > limit)

// The number of values of the progression, which traps where the distance from the first value to
// the furthest point on the near side of the limit is more than a `long` holds.
private numberCount(start: long, limit: long, step: long, inclusive: bool) -> long
    if !numberWithin(start, limit, step, inclusive) then return 0
    // The furthest point on the near side of the limit, which need not lie on the progression.
    val far = if inclusive then limit elif step > 0 then limit - 1 else limit + 1
    val tooFar = if step > 0 then start < 0 && far > numberMax() + start else far < 0 && start > numberMax() + far
    if tooFar then fail("range spans more than a long holds")
    val steps = (far - start) / step
    if steps == numberMax() then fail("range spans more than a long holds")
    steps + 1

// The value `index` steps from `start`, for an `index` of zero or more, when the progression has
// one; a value past either end of `long` is past the limit too.
private numberAt(start: long, limit: long, step: long, inclusive: bool, index: long) -> Option[long]
    if index == 0 then return (if numberWithin(start, limit, step, inclusive) then Some(start) else None)
    if step > 0
        if step > numberMax() / index then return None
        val offset = index * step
        if start > numberMax() - offset then return None
        val value = start + offset
        if numberWithin(value, limit, step, inclusive) then Some(value) else None
    else
        if step < numberMin() / index then return None
        val offset = index * step
        if start < numberMin() - offset then return None
        val value = start + offset
        if numberWithin(value, limit, step, inclusive) then Some(value) else None

// Steps through a range held as `long`s: `current` is the next value, and `more` whether it is one.
private class NumericRangeIterator[T: Integer](private var current: long, limit: long, step: long, inclusive: bool, private var more: bool): Iterator[T]
    override hasNext() -> bool = more

    override next() -> T
        if !more then fail("next on an exhausted iterator")
        val value = current
        // A step that would pass the largest or smallest `long` has passed the limit as well.
        val room = if step > 0 then current <= numberMax() - step else current >= numberMin() - step
        if room
            current = current + step
            more = numberWithin(current, limit, step, inclusive)
        else
            more = false
        T(value)
