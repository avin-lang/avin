module avin.parsing

// Where a parser is in its text, and what it reports when it cannot go on.

// A place in a text: the byte offset, and the line and column it falls on, both counted from 1. A
// column counts characters, not bytes.
data Position(offset: int, line: int, column: int)

impl Display for Position
    display(out: Writer, spec: FormatSpec) = out.write(s"$line:$column")

// Why a parse failed: the furthest position any alternative reached, everything that could have
// continued the text there, in the order the grammar tried them, and what was found instead (a
// character in its quoted, escaped form, or `end of input`).
data ParseError(position: Position, expected: Vector[string], found: string)

impl ParseError
    // The error as one line: `3:14: expected `)` or `,`, found 'x'`.
    message() -> string
        val out = StringWriter()
        out.write(s"${position.line}:${position.column}: ")
        val n = expected.length()
        if n == 0
            out.write("unexpected ")
        else
            out.write("expected ")
            for i in 0..<n
                if i > 0 then out.write(if i == n - 1 then " or " else ", ")
                out.write(expected(i))
            out.write(", found ")
        out.write(found)
        out.text()

impl Display for ParseError
    display(out: Writer, spec: FormatSpec) = out.write(message())

// The text a parser reads and the state of reading it: the byte offset of the next character, the
// furthest offset at which anything failed with what was expected there, and whether a failure has
// passed a commit point. Parsers read and move `offset`; an alternative that fails is retried from
// where it started.
class Input(val text: string)
    // The text's length in bytes.
    val length = text.byteLength()
    // The byte offset of the next character to read.
    var offset = 0
    // Set when a parser fails after a commit point: no alternative is tried after it and the whole
    // parse fails.
    var committed = false
    private var furthest = -1
    private val expectations = Buffer[string]()
    // The last position worked out, from which the next one is counted when it lies further on.
    private var known = Position(0, 1, 1)

    // Whether every character has been read.
    atEnd() -> bool = offset >= length

    // The character at `offset`, which traps at the end of the text.
    current() -> char = text.charAt(offset)

    // Records that `what` was expected at `offset`. Only the furthest offset's expectations are kept,
    // since the text is right up to there.
    expect(what: string)
        if offset > furthest
            furthest = offset
            expectations.clear()
            expectations.add(what)
        elif offset == furthest
            expectations.add(what)

    // Records that `what` was expected at `offset`, and fails.
    fail[T](what: string) -> Option[T]
        expect(what)
        None

    // The number of expectations recorded at offset `at`: -1 when nothing has failed that far yet.
    expectationsAt(at: int) -> int = if furthest < at then -1 else expectations.length()

    // Replaces what was recorded at offset `at` since `mark` (an `expectationsAt(at)` taken before)
    // by `what`: a failure that got no further than `at` is reported under one name.
    relabel(at: int, mark: int, what: string)
        if furthest != at then return
        val keep = if mark < 0 then 0 else mark
        while expectations.length() > keep
            expectations.remove(expectations.length() - 1)
        expectations.add(what)

    // The position of byte offset `at`, counted from the last position worked out when `at` lies
    // after it, so positions asked for in order cost one pass over the text.
    position(at: int) -> Position
        val from = if at >= known.offset then known else Position(0, 1, 1)
        var i = from.offset
        var line = from.line
        var column = from.column
        while i < at
            val b = int(text.byteAt(i))
            if b == 0x0a
                line += 1
                column = 1
            elif (b & 0xc0) != 0x80
                column += 1
            i += 1
        known = Position(at, line, column)
        known

    // The error the parse reports: the furthest failure, with every distinct expectation there.
    error() -> ParseError
        val at = if furthest < 0 then offset else furthest
        val seen = Buffer[string]()
        for e in expectations
            if !seen.contains(e) then seen.add(e)
        val found = if at >= length then "end of input" else debug(text.charAt(at))
        ParseError(position(at), seen.toVector(), found)
