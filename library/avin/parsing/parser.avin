module avin.parsing

// Parser combinators: small parsers joined by operators into a parser of a whole grammar.
//
//     val number = token(integer)
//     val sum = chainLeft(number, symbol("+") ^^^ ((a: long, b: long) -> a + b))
//     sum.parse("1 + 2 + 3")          // Ok(6)
//
// A parser is a function from an `Input` to `Some(value)`, having moved the input's offset past what
// it read, or to `None`, having recorded at the input what it expected. Alternatives backtrack: `p | q`
// runs `q` from where `p` started. A failure after a commit point (`p ~! q`, `commit(p)`) is final,
// so the error names what the committed grammar expected rather than the first alternative's start.

// A parser of a `T`. `run` reads from the input's offset; a custom parser is made by giving one.
class Parser[+T](val run: Input -> Option[T])

impl[T] Parser[T]
    // This parser, then `next`: both values.
    ~[U](next: Parser[U]) -> Parser[(T, U)] = Parser(input ->
        run(input) match
            Some(a) -> next.run(input) match
                Some(b) -> Some((a, b))
                None -> None
            None -> None)

    // This parser, then `next`, whose value is kept.
    ~>[U](next: Parser[U]) -> Parser[U] = Parser(input ->
        run(input) match
            Some(_) -> next.run(input)
            None -> None)

    // This parser, then `next`, whose value is dropped.
    <~[U](next: Parser[U]) -> Parser[T] = Parser(input ->
        run(input) match
            Some(a) -> next.run(input) match
                Some(_) -> Some(a)
                None -> None
            None -> None)

    // This parser, then `next`, committed: once this parser has succeeded, a failure of `next` fails
    // the whole parse instead of letting an alternative be tried.
    ~![U](next: Parser[U]) -> Parser[(T, U)] = Parser(input ->
        run(input) match
            Some(a) -> next.run(input) match
                Some(b) -> Some((a, b))
                None ->
                    input.committed = true
                    None
            None -> None)

    // This parser, or `other` from the same place when this one fails before a commit point.
    |(other: Parser[T]) -> Parser[T] = Parser(input ->
        val start = input.offset
        run(input) match
            Some(a) -> Some(a)
            None ->
                if input.committed then return None
                input.offset = start
                other.run(input))

    // The value given to `f`.
    ^^[U](f: T -> U) -> Parser[U] = map(f)

    map[U](f: T -> U) -> Parser[U] = Parser(input ->
        run(input) match
            Some(a) -> Some(f(a))
            None -> None)

    // `value` in place of what was read.
    ^^^[U](value: U) -> Parser[U] = Parser(input ->
        run(input) match
            Some(_) -> Some(value)
            None -> None)

    // The parser `f` makes of the value, run where this one stopped.
    flatMap[U](f: T -> Parser[U]) -> Parser[U] = Parser(input ->
        run(input) match
            Some(a) -> f(a).run(input)
            None -> None)

    // The value when `p` accepts it; otherwise a failure where this parser started, expecting `what`.
    filter(what: string, p: T -> bool) -> Parser[T] = Parser(input ->
        val start = input.offset
        run(input) match
            Some(a) if p(a) -> Some(a)
            Some(_) ->
                input.offset = start
                input.fail(what)
            None -> None)

    // This parser, reported as expecting `what` when it fails without getting past its first
    // character, in place of the expectations of the parsers it is made of.
    label(what: string) -> Parser[T] = Parser(input ->
        val start = input.offset
        val mark = input.expectationsAt(start)
        val r = run(input)
        if r is None then input.relabel(start, mark, what)
        r)

    // This parser, whose failure fails the whole parse.
    commit() -> Parser[T] = Parser(input ->
        val r = run(input)
        if r is None then input.committed = true
        r)

    // `Some` of the value, or `None` without reading anything when this parser fails.
    opt() -> Parser[Option[T]] = Parser(input ->
        val start = input.offset
        run(input) match
            Some(a) -> Some(Some(a))
            None ->
                if input.committed then return None
                input.offset = start
                Some(None))

    // The values of this parser run as many times as it succeeds, none included. A run that reads
    // nothing ends the repetition without adding its value, so a parser that can succeed on nothing
    // does not loop.
    rep() -> Parser[Vector[T]] = Parser(input -> repeated(self, input, Buffer[T]()))

    // As `rep`, at least once.
    rep1() -> Parser[Vector[T]] = Parser(input ->
        run(input) match
            Some(a) ->
                val items = Buffer[T]()
                items.add(a)
                repeated(self, input, items)
            None -> None)

    // The values of this parser separated by `sep`, none included. A separator must be followed by a
    // value, and a separator and value that together read nothing end the repetition.
    repSep[S](sep: Parser[S]) -> Parser[Vector[T]] = Parser(input ->
        val start = input.offset
        run(input) match
            Some(a) -> separated(self, sep, input, a)
            None ->
                if input.committed then return None
                input.offset = start
                Some(Vector.empty[T]()))

    // As `repSep`, at least one value.
    rep1Sep[S](sep: Parser[S]) -> Parser[Vector[T]] = Parser(input ->
        run(input) match
            Some(a) -> separated(self, sep, input, a)
            None -> None)

    // The value with the position it starts at.
    positioned() -> Parser[(T, Position)] = Parser(input ->
        val start = input.offset
        run(input) match
            Some(a) -> Some((a, input.position(start)))
            None -> None)

    // The value of the whole of `text`, or the error at the furthest place any alternative reached.
    parse(text: string) -> Result[T, ParseError]
        val input = Input(text)
        run(input) match
            Some(a) if input.atEnd() -> Ok(a)
            Some(_) ->
                input.expect("end of input")
                Err(input.error())
            None -> Err(input.error())

    // The value of the longest beginning of `text` this parser accepts, with the byte offset where it
    // stopped.
    parsePrefix(text: string) -> Result[(T, int), ParseError]
        val input = Input(text)
        run(input) match
            Some(a) -> Ok((a, input.offset))
            None -> Err(input.error())

// `p` run as many times as it succeeds, added to `items`.
private repeated[T](p: Parser[T], input: Input, items: Buffer[T]) -> Option[Vector[T]]
    loop
        val start = input.offset
        p.run(input) match
            Some(a) ->
                if input.offset == start then break
                items.add(a)
            None ->
                if input.committed then return None
                input.offset = start
                break
    Some(items.toVector())

// `first`, then the values of `p` after each `sep`.
private separated[T, S](p: Parser[T], sep: Parser[S], input: Input, first: T) -> Option[Vector[T]]
    val items = Buffer[T]()
    items.add(first)
    loop
        val start = input.offset
        if sep.run(input) is None
            if input.committed then return None
            input.offset = start
            break
        val a = p.run(input)?
        if input.offset == start then break
        items.add(a)
    Some(items.toVector())

// `p.rep()`.
rep[T](p: Parser[T]) -> Parser[Vector[T]] = p.rep()

// `p.rep1()`.
rep1[T](p: Parser[T]) -> Parser[Vector[T]] = p.rep1()

// `p.opt()`.
opt[T](p: Parser[T]) -> Parser[Option[T]] = p.opt()

// `p.repSep(sep)`.
repSep[T, S](p: Parser[T], sep: Parser[S]) -> Parser[Vector[T]] = p.repSep(sep)

// `p.rep1Sep(sep)`.
rep1Sep[T, S](p: Parser[T], sep: Parser[S]) -> Parser[Vector[T]] = p.rep1Sep(sep)

// `p.commit()`.
commit[T](p: Parser[T]) -> Parser[T] = p.commit()

// `p.positioned()`.
positioned[T](p: Parser[T]) -> Parser[(T, Position)] = p.positioned()

// One `p` or more separated by `op`, combined from the left by the functions `op` yields:
// `1 - 2 - 3` is `(1 - 2) - 3`.
chainLeft[T](p: Parser[T], op: Parser[(T, T) -> T]) -> Parser[T] = Parser(input ->
    var acc = p.run(input)?
    loop
        val start = input.offset
        val f = op.run(input) match
            Some(f) -> f
            None ->
                if input.committed then return None
                input.offset = start
                break
        acc = f(acc, p.run(input)?)
    Some(acc))

// One `p` or more separated by `op`, combined from the right: `2 ^ 3 ^ 2` is `2 ^ (3 ^ 2)`.
chainRight[T](p: Parser[T], op: Parser[(T, T) -> T]) -> Parser[T] = Parser(input ->
    val values = Buffer[T]()
    val ops = Buffer[(T, T) -> T]()
    values.add(p.run(input)?)
    loop
        val start = input.offset
        val f = op.run(input) match
            Some(f) -> f
            None ->
                if input.committed then return None
                input.offset = start
                break
        ops.add(f)
        values.add(p.run(input)?)
    var acc = values(values.length() - 1)
    var i = ops.length() - 1
    while i >= 0
        acc = ops(i)(values(i), acc)
        i -= 1
    Some(acc))

// Succeeds with `value`, reading nothing.
success[T](value: T) -> Parser[T] = Parser(input -> Some(value))

// Fails, expecting `what`.
failure[T](what: string) -> Parser[T] = Parser(input -> input.fail(what))

// The parser `p` names, found the first time it runs rather than where `defer` is called, so a
// grammar can refer to a rule declared after it or to itself:
//
//     lazy val expr: Parser[long] = chainLeft(term, addOp)
//     lazy val atom: Parser[long] = token(integer) | symbol("(") ~> defer(expr) <~ symbol(")")
defer[T](p: -> Parser[T]) -> Parser[T]
    var made: Option[Parser[T]] = None
    Parser(input ->
        val q = made match
            Some(q) -> q
            None ->
                val q = p
                made = Some(q)
                q
        q.run(input))

// Succeeds without reading anything where `p` fails, and fails where `p` succeeds.
notFollowedBy[T](p: Parser[T]) -> Parser[unit] = Parser(input ->
    val start = input.offset
    val committed = input.committed
    val r = p.run(input)
    input.offset = start
    input.committed = committed
    if r is None then Some(()) else None)

// The value of `p`, without reading anything: a look ahead.
guard[T](p: Parser[T]) -> Parser[T] = Parser(input ->
    val start = input.offset
    val r = p.run(input)
    input.offset = start
    r)
