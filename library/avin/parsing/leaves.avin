module avin.parsing

// The parsers grammars are built from: literal text, characters, names, numbers and quoted strings.

@sysl("sysl.unicode.is_alpha")
private isUnicodeLetter(c: char) -> bool

@sysl("sysl.unicode.is_space")
private isUnicodeSpace(c: char) -> bool

// The number of bytes UTF-8 encodes `c` in.
private width(c: char) -> int
    val code = int(c)
    if code < 0x80 then 1 elif code < 0x800 then 2 elif code < 0x10000 then 3 else 4

// Whether `c` is an ASCII decimal digit.
isDigit(c: char) -> bool = c >= '0' && c <= '9'

// Whether `c` is a letter, in any script.
isLetter(c: char) -> bool
    val code = int(c)
    if code < 0x80 then (code | 0x20) >= 0x61 && (code | 0x20) <= 0x7a else isUnicodeLetter(c)

// Whether `c` is white space, in any script.
isSpace(c: char) -> bool
    val code = int(c)
    if code < 0x80 then code == 0x20 || (code >= 0x09 && code <= 0x0d) else isUnicodeSpace(c)

// Whether `c` may begin a name: a letter or `_`.
private startsName(c: char) -> bool = c == '_' || isLetter(c)

// Whether `c` may continue a name: a letter, a digit or `_`.
private continuesName(c: char) -> bool = c == '_' || isDigit(c) || isLetter(c)

// Whether the byte at `at` is the ASCII character `b`.
private byteIs(input: Input, at: int, b: int) -> bool = at < input.length && int(input.text.byteAt(at)) == b

// Moves past the characters `p` accepts.
private skip(input: Input, p: char -> bool)
    while !input.atEnd()
        val c = input.current()
        if !p(c) then return
        input.offset += width(c)

// Moves past the ASCII digits.
private skipDigits(input: Input)
    while input.offset < input.length
        val b = int(input.text.byteAt(input.offset))
        if b < 0x30 || b > 0x39 then return
        input.offset += 1

// Exactly `text`.
lit(text: string) -> Parser[string]
    val what = s"`$text`"
    val n = text.byteLength()
    Parser(input ->
        if input.text.startsWith(text, input.offset)
            input.offset += n
            Some(text)
        else input.fail(what))

// Exactly the character `c`.
lit(c: char) -> Parser[char]
    val what = s"`$c`"
    val n = width(c)
    Parser(input ->
        if !input.atEnd() && input.current() == c
            input.offset += n
            Some(c)
        else input.fail(what))

// One character `p` accepts, described as `what` when there is none.
satisfy(what: string, p: char -> bool) -> Parser[char] = Parser(input ->
    if input.atEnd() then return input.fail(what)
    val c = input.current()
    if !p(c) then return input.fail(what)
    input.offset += width(c)
    Some(c))

// The characters `p` accepts, as many as there are, none included.
takeWhile(p: char -> bool) -> Parser[string] = Parser(input ->
    val start = input.offset
    skip(input, p)
    Some(input.text.slice(start, input.offset)))

// The characters `p` accepts, at least one, described as `what` when there is none.
takeWhile1(what: string, p: char -> bool) -> Parser[string] = Parser(input ->
    val start = input.offset
    skip(input, p)
    if input.offset == start then input.fail(what) else Some(input.text.slice(start, input.offset)))

// One ASCII decimal digit or more.
lazy val digits: Parser[string] = takeWhile1("digit", isDigit)

// A name: a letter or `_`, then letters, digits and `_`.
lazy val ident: Parser[string] = Parser(input ->
    if input.atEnd() || !startsName(input.current()) then return input.fail("identifier")
    val start = input.offset
    skip(input, continuesName)
    Some(input.text.slice(start, input.offset)))

// White space, none included.
lazy val whitespace: Parser[unit] = Parser(input ->
    skip(input, isSpace)
    Some(()))

// The end of the text.
lazy val eof: Parser[unit] = Parser(input -> if input.atEnd() then Some(()) else input.fail("end of input"))

// `p`, then the white space after it.
token[T](p: Parser[T]) -> Parser[T] = Parser(input ->
    val r = p.run(input)
    if r is Some(_) then skip(input, isSpace)
    r)

// Exactly `text`, then the white space after it.
symbol(text: string) -> Parser[string] = token(lit(text))

// A decimal integer that fits a `long`, with an optional leading `-`.
lazy val integer: Parser[long] = Parser(input ->
    val start = input.offset
    if byteIs(input, start, 0x2d) then input.offset += 1
    val first = input.offset
    skipDigits(input)
    if input.offset == first
        input.offset = start
        return input.fail("integer")
    input.text.slice(start, input.offset).toLong() match
        Some(n) -> Some(n)
        None ->
            input.offset = start
            input.fail("integer that fits a long"))

// A decimal number: an optional `-`, digits, an optional fraction `.` and digits, and an optional
// exponent `e` or `E`, a sign and digits, as JSON writes numbers. A `.` or an `e` not followed by
// digits is not part of it.
lazy val decimal: Parser[real] = Parser(input ->
    val start = input.offset
    if byteIs(input, start, 0x2d) then input.offset += 1
    val first = input.offset
    skipDigits(input)
    if input.offset == first
        input.offset = start
        return input.fail("number")
    if byteIs(input, input.offset, 0x2e)
        val dot = input.offset
        input.offset += 1
        skipDigits(input)
        if input.offset == dot + 1 then input.offset = dot
    if byteIs(input, input.offset, 0x65) || byteIs(input, input.offset, 0x45)
        val e = input.offset
        input.offset += 1
        if byteIs(input, input.offset, 0x2b) || byteIs(input, input.offset, 0x2d) then input.offset += 1
        val exponent = input.offset
        skipDigits(input)
        if input.offset == exponent then input.offset = e
    input.text.slice(start, input.offset).toReal() match
        Some(x) -> Some(x)
        None ->
            input.offset = start
            input.fail("finite number"))

// A string in double quotes, with JSON's escapes: `\"`, `\\`, `\/`, `\b`, `\f`, `\n`, `\r`, `\t` and
// `\u` with four hexadecimal digits, a pair of them for a character beyond the first 65,536. A
// control character must be escaped. The value is the text the string stands for.
lazy val stringLiteral: Parser[string] = Parser(input ->
    if !byteIs(input, input.offset, 0x22) then return input.fail("string")
    input.offset += 1
    var chunk = input.offset
    var out: Option[StringWriter] = None
    loop
        if input.atEnd() then return input.fail("`\"`")
        val b = int(input.text.byteAt(input.offset))
        if b == 0x22
            val last = input.text.slice(chunk, input.offset)
            input.offset += 1
            return out match
                None -> Some(last)
                Some(w) ->
                    w.write(last)
                    Some(w.text())
        if b < 0x20 then return input.fail("`\"`")
        if b == 0x5c
            val w = out match
                Some(w) -> w
                None ->
                    val w = StringWriter()
                    out = Some(w)
                    w
            w.write(input.text.slice(chunk, input.offset))
            input.offset += 1
            w.writeChar(escaped(input)?)
            chunk = input.offset
        else input.offset += 1)

// The character the escape after a `\` stands for, read past.
private escaped(input: Input) -> Option[char]
    if input.atEnd() then return input.fail("escape")
    val c = input.current()
    val simple = c match
        '"' -> Some('"')
        '\\' -> Some('\\')
        '/' -> Some('/')
        'b' -> Some(char(8))
        'f' -> Some(char(12))
        'n' -> Some('\n')
        'r' -> Some('\r')
        't' -> Some('\t')
        _ -> None
    if simple is Some(_)
        input.offset += 1
        return simple
    if c != 'u' then return input.fail("escape")
    // A surrogate out of place is reported at the `\` of its escape.
    val first = input.offset - 1
    input.offset += 1
    val high = hex4(input)?
    if high < 0xd800 || high > 0xdfff then return Some(char(high))
    if high >= 0xdc00
        input.offset = first
        return input.fail("escape of a character or a high surrogate")
    if !input.text.startsWith("\\u", input.offset) then return input.fail("`\\u` and a low surrogate")
    val second = input.offset
    input.offset += 2
    val low = hex4(input)?
    if low < 0xdc00 || low > 0xdfff
        input.offset = second
        return input.fail("escape of a low surrogate")
    Some(char(0x10000 + ((high - 0xd800) << 10) + (low - 0xdc00)))

// The value of four hexadecimal digits, read past.
private hex4(input: Input) -> Option[int]
    var value = 0
    for _ in 0..<4
        val d = if input.atEnd() then -1 else hexValue(int(input.text.byteAt(input.offset)))
        if d < 0 then return input.fail("hexadecimal digit")
        value = value * 16 + d
        input.offset += 1
    Some(value)

// The value of the hexadecimal digit `b`, or -1.
private hexValue(b: int) -> int
    if b >= 0x30 && b <= 0x39 then b - 0x30
    elif b >= 0x61 && b <= 0x66 then b - 0x57
    elif b >= 0x41 && b <= 0x46 then b - 0x37
    else -1
