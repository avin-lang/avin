// The OpenSSL calls behind `avin.crypto`'s signatures, keys and authenticated encryption: Ed25519,
// ECDSA over P-256 and P-384, RSA with PKCS#1 v1.5 and PSS padding, PKCS#8 and SubjectPublicKeyInfo
// keys, AES-GCM and ChaCha20-Poly1305. The standard library's `library.hocon` names this package by
// directory, so a program reaches it, and links libcrypto, only where it calls one of these.
//
// Every function here is a stateless call over bytes: a key goes in as its DER encoding and is parsed,
// used and freed inside the call, so no OpenSSL pointer ever outlives one.
package { name = "avincrypto", version = "0.1.0", sysl = "0.13.0" }

requires {
  heap = true

  pkg_config {
    libcrypto = "OpenSSL: `brew install openssl@3` on macOS, Debian's libssl-dev, Arch's openssl"
  }
}
