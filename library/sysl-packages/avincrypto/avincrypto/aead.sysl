// Authenticated encryption over libcrypto, for `avin.crypto`: AES-GCM with 128- and 256-bit keys
// (NIST SP 800-38D) and ChaCha20-Poly1305 (RFC 8439), each with a 12-byte nonce and a 16-byte tag.
//
// **A message that does not authenticate yields nothing.** Decryption writes into a buffer the caller
// never sees until the tag has checked; when it does not, the buffer is wiped and `Unauthentic` is
// the whole answer.

module avincrypto

import avincrypto.c
import sysl.slices.{as_ptr, as_mut_ptr}
import sysl.buf.{Buf, buf}

// An authenticated cipher.
enum Cipher
    Aes128Gcm
    Aes256Gcm
    ChaCha20Poly1305
end Cipher

const tag_len: usize = 16
const nonce_len: usize = 12

private cipher_of(cipher: Cipher) -> *c.EvpCipher = cipher match
    Aes128Gcm -> c.aes_128_gcm()
    Aes256Gcm -> c.aes_256_gcm()
    ChaCha20Poly1305 -> c.chacha20_poly1305()

private key_len_of(cipher: Cipher) -> usize = cipher match
    Aes128Gcm -> 16
    else 32

private checked(cipher: Cipher, key: []const u8, nonce: []const u8) -> Result[unit, Refusal]
    if key.len != key_len_of(cipher) then return Err(Refusal.Failed(s"the key is ${key.len} bytes, not ${key_len_of(cipher)}"))

    if nonce.len != nonce_len then return Err(Refusal.Failed(s"the nonce is ${nonce.len} bytes, not 12"))

    Ok(())
end checked

// `plaintext` encrypted under `key` and `nonce`, authenticating it and `aad`: the ciphertext, as long
// as the plaintext, then the 16-byte tag.
seal(cipher: Cipher, key: []const u8, nonce: []const u8, aad: []const u8, plaintext: []const u8) -> Result[Buf[u8], Refusal]
    checked(cipher, key, nonce)?

    c.err_clear_error()

    val ctx = c.cipher_ctx_new()

    if ctx == null then return Err(failed("encryption could not begin"))

    var all: []u8 = [0; plaintext.len + tag_len]
    var n: i32 = 0
    var ok = c.encrypt_init(ctx, cipher_of(cipher), as_ptr(key), as_ptr(nonce), null)

    if ok == 1 && aad.len > 0 then ok = c.encrypt_update(ctx, null, &n, as_ptr(aad), i32(aad.len))

    if ok == 1 && plaintext.len > 0
        ok = c.encrypt_update(ctx, as_mut_ptr(all), &n, as_ptr(plaintext), i32(plaintext.len))

        if ok == 1 && usize(n) != plaintext.len then ok = 0
    end if

    // A stream mode writes nothing at the end; the room is the tag's, which comes next.
    var tail: [16]u8 = [0; 16]

    if ok == 1 then ok = c.encrypt_final(ctx, &tail[0], &n)

    if ok == 1 && n != 0 then ok = 0

    if ok == 1 then ok = c.cipher_ctx_ctrl(ctx, c.EVP_CTRL_AEAD_GET_TAG, 16, as_mut_ptr(all[plaintext.len..]))

    c.cipher_ctx_free(ctx)

    if ok != 1 then return Err(failed("the message could not be sealed"))

    var out: Buf[u8] = buf()

    out.extend(all)

    Ok(out)
end seal

// What `sealed` (a ciphertext and its 16-byte tag) decrypts to under `key` and `nonce`, if it and
// `aad` authenticate; `Unauthentic` if anything about them was changed, or they were sealed under
// another key, nonce or `aad`, or are shorter than a tag.
open(cipher: Cipher, key: []const u8, nonce: []const u8, aad: []const u8, sealed: []const u8) -> Result[Buf[u8], Refusal]
    checked(cipher, key, nonce)?

    if sealed.len < tag_len then return Err(Refusal.Unauthentic)

    val body = sealed.len - tag_len

    c.err_clear_error()

    val ctx = c.cipher_ctx_new()

    if ctx == null then return Err(failed("decryption could not begin"))

    var all: []u8 = [0; body]
    var n: i32 = 0
    var ok = c.decrypt_init(ctx, cipher_of(cipher), as_ptr(key), as_ptr(nonce), null)
    var started = ok == 1

    if ok == 1 && aad.len > 0 then ok = c.decrypt_update(ctx, null, &n, as_ptr(aad), i32(aad.len))

    if ok == 1 && body > 0
        ok = c.decrypt_update(ctx, as_mut_ptr(all), &n, as_ptr(sealed[0..<body]), i32(body))

        if ok == 1 && usize(n) != body then ok = 0
    end if

    var tag: [16]u8 = [0; 16]

    for i in 0..<tag_len
        tag[i] = sealed[body + i]

    if ok == 1 then ok = c.cipher_ctx_ctrl(ctx, c.EVP_CTRL_AEAD_SET_TAG, 16, &tag[0])

    var tail: [16]u8 = [0; 16]
    var authentic = false

    if ok == 1
        authentic = c.decrypt_final(ctx, &tail[0], &n) > 0 && n == 0

    c.cipher_ctx_free(ctx)
    c.err_clear_error()

    if !started then return Err(Refusal.Failed("decryption could not begin"))

    if !authentic
        for i in 0..<body
            all[i] = 0
        return Err(Refusal.Unauthentic)
    end if

    var out: Buf[u8] = buf()

    out.extend(all)

    for i in 0..<body
        all[i] = 0

    Ok(out)
end open
