// The standard library's deflate codec: `avin.compress` binds this package, which drives the
// system's zlib a step at a time. Only a program that reaches `avin.compress` (or `avin.net.http`,
// which compresses with it) builds it and links zlib.
package {
  name    = "zcodec"
  version = "0.1.0"
  sysl    = "0.13.5"
}

requires {
  heap = true
}
