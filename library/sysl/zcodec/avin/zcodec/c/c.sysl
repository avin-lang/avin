// zlib as C declares it, through the shim beside this file: a stream made, stepped, reset and
// given back, and the numbers zlib's header holds.
//
// zlib is the system's: macOS carries it in its SDK and its libraries, and a Linux machine in its
// zlib development package (Debian's `zlib1g-dev`).

module avin.zcodec.c

@link("z")

@include("zlib.h")
@include("shim.h")

c const
    NO_FLUSH:   int = "Z_NO_FLUSH"
    SYNC_FLUSH: int = "Z_SYNC_FLUSH"
    FINISH:     int = "Z_FINISH"

    OK:           int = "Z_OK"
    STREAM_END:   int = "Z_STREAM_END"
    NEED_DICT:    int = "Z_NEED_DICT"
    STREAM_ERROR: int = "Z_STREAM_ERROR"
    DATA_ERROR:   int = "Z_DATA_ERROR"
    MEM_ERROR:    int = "Z_MEM_ERROR"
    BUF_ERROR:    int = "Z_BUF_ERROR"

// zlib's stream, which only the shim reads inside.
opaque struct ZStream

extern "avin_zcodec_open" open(compress: int, level: int, window_bits: int, status: *int) -> *ZStream

extern "avin_zcodec_step" step(s: *ZStream, compress: int, in_buf: *u8, in_len: usize, out_buf: *u8,
                               out_len: usize, flush: int, consumed: *usize, produced: *usize) -> int

extern "avin_zcodec_reset" reset(s: *ZStream, compress: int) -> int

extern "avin_zcodec_message" message(s: *ZStream) -> *u8

extern "avin_zcodec_close" close(s: *ZStream, compress: int)
