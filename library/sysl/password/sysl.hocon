// The C under `avin.crypto.password`: the Argon2 reference implementation and Openwall's
// crypt_blowfish, vendored in `vendor/` byte for byte as their authors ship them, and compiled into
// the program that hashes a password and no other. The standard library names this package by its
// directory in `library.hocon`, so it is built only where a binding reaches `avin.password`.
// `avin/password/c/shim.c` is the only C written for Avin.
package { name = "password", version = "0.1.0", sysl = "0.13.5" }

// Argon2 allocates its memory and computes its lanes on POSIX threads; bcrypt reads the C library's
// string functions.
requires { heap = true, posix = true, libc = true }

c {
  // phc-winner-argon2 at commit f57e61e19229e23c4445b85494dbf7c07de721cb (2021-06-25), CC0 or
  // Apache 2.0 (`vendor/argon2/LICENSE`). `ref.c` is the portable block function; `opt.c` needs SSE.
  argon2 {
    root    = "vendor/argon2"
    include = ["include"]
    sources = ["src/{argon2,core,encoding,ref,thread}.c", "src/blake2/blake2b.c"]
  }
  // crypt_blowfish 1.3 (2014-07-07), public domain with a fallback licence in its header.
  crypt_blowfish {
    root    = "vendor/crypt_blowfish"
    include = ["."]
    sources = ["crypt_blowfish.c"]
  }
}
