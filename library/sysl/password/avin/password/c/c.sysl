// The vendored C behind `avin.crypto.password`, as `shim.h` declares it.
//
// Two libraries are carried here as their authors ship them: the Argon2 reference implementation
// (phc-winner-argon2, commit f57e61e, CC0 or Apache 2.0, `LICENSE-argon2`) in `argon2.c`, `core.c`,
// `encoding.c`, `ref.c`, `thread.c` and `blake2/`, and Openwall's crypt_blowfish 1.3 (public
// domain, the terms in its header) in `crypt_blowfish.c`. `shim.c` is the only C written for Avin:
// it fills Argon2's context from scalars and pointers, and gives bcrypt's C strings their NULs, so
// nothing below carries a struct layout or a C string.

module avin.password.c

@include("shim.h")

extern "avin_password_argon2" argon2(variant: u32, version: u32, memory_kib: u32, passes: u32,
                                     lanes: u32, password: *u8, password_len: usize, salt: *u8,
                                     salt_len: usize, secret: *u8, secret_len: usize, ad: *u8,
                                     ad_len: usize, out: *u8, out_len: usize) -> i32

extern "avin_password_argon2_error" argon2_error(code: i32) -> *u8

extern "avin_password_bcrypt" bcrypt(key: *u8, key_len: usize, setting: *u8, setting_len: usize,
                                     out: *u8) -> i32
