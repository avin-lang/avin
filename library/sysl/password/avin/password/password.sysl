// What `avin.crypto.password` binds: Argon2 and bcrypt over the vendored C in `c/`, taking and
// answering slices and buffers, the shapes an Avin binding crosses. The Avin module checks every
// parameter before it calls, so a call here never asks the C for something it would refuse,
// except memory it cannot allocate, which comes back as the C's error code.

module avin.password

import avin.password.c
import sysl.buf.{Buf, buf}
import sysl.slices.as_ptr
import sysl.text.from_cstring

// The bytes of `xs` as a buffer, the shape a binding turns into a vector.
private to_buf(xs: []const u8) -> Buf[u8]
    var out: Buf[u8] = buf()
    for x in xs do out.push(x)
    out

/** `length` bytes of Argon2 (`variant` 0 for Argon2d, 1 for Argon2i, 2 for Argon2id; `version` 16 or
 *  19), or the reference implementation's error code. */
argon2(variant: i32, version: i32, memory_kib: i32, passes: i32, lanes: i32, password: []const u8,
       salt: []const u8, secret: []const u8, ad: []const u8, length: i32) -> Result[Buf[u8], i32]
    var out: []u8 = [0; usize(length)]
    val code = c.argon2(u32(variant), u32(version), u32(memory_kib), u32(passes), u32(lanes),
                        as_ptr(password), password.len, as_ptr(salt), salt.len, as_ptr(secret),
                        secret.len, as_ptr(ad), ad.len, &out[0], out.len)
    if code != 0 then return Err(code)
    Ok(to_buf(out))

/** The reference implementation's text for its error `code`. */
argon2_error(code: i32) -> string = from_cstring(c.argon2_error(code)).unwrap_or("unknown error code")

/** The 60 characters of the bcrypt hash `setting` (its first 29 characters: `$2a$`, `$2b$` or
 *  `$2y$`, the cost, two digits and `$`, and 22 characters of salt) gives `password`, or `None` where
 *  `setting` is not one bcrypt reads. */
bcrypt(password: []const u8, setting: []const u8) -> Option[Buf[u8]]
    var out: []u8 = [0; 61]
    if c.bcrypt(as_ptr(password), password.len, as_ptr(setting), setting.len, &out[0]) != 0 then return None
    Some(to_buf(out[0..<60]))
