// The Sysl side of the standard library's `avin.sqlite`: SQLite's C interface, and the conversions
// between its values and Avin's. The library's manifest names this package by its directory, and a
// program's shims depend on it only where one of its bindings reaches `avin.sqlite`, so a program that
// never opens a database never links SQLite.
package {
  name    = "sqlite"
  version = "0.1.0"
  sysl    = "0.13.5"
}

// SQLite is the machine's: macOS ships it in the SDK, Debian and Ubuntu as `libsqlite3-dev`, and
// pkg-config answers where its header and library are on both, so a build needs no flag. The module
// header's `@link("sqlite3")` and `@include("<sqlite3.h>")` say what is linked and read; this says
// what to install where it is missing.
requires {
  os = true
  pkg_config {
    sqlite3 = "SQLite 3.37 or newer -- macOS ships it, Debian and Ubuntu want libsqlite3-dev, Fedora sqlite-devel"
  }
}
