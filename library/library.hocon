// The Sysl packages the standard library's own bindings reach beyond Sysl's standard library and the
// runtime. A program's shims depend on one only where a binding the program compiles reaches it, so
// a program that never touches TLS never builds or links OpenSSL.
package { name = "avin-library", version = "0.0.39" }

sysl-dependencies {
  // TLS for `avin.net`'s `TlsStream` and `https` in `avin.net.http`. OpenSSL and its headers are
  // found by pkg-config: `brew install openssl@3`, Debian's libssl-dev, Arch's openssl.
  openssl { git = "github.com/sysl-lang/openssl", version = "0.2.5" }
  // Signatures, keys and authenticated encryption for `avin.crypto`, over the same libcrypto.
  avincrypto { path = "sysl-packages/avincrypto" }
  // SQLite for `avin.sqlite`: the library's own Sysl package, in `sysl/sqlite`, over the machine's
  // SQLite, which pkg-config finds: the macOS SDK carries it, Debian's libsqlite3-dev, Fedora's
  // sqlite-devel.
  sqlite { path = "sysl/sqlite" }
  // Argon2 and bcrypt for `avin.crypto.password`: the C ships in the directory, built with nothing
  // installed.
  password { path = "sysl/password" }
  // Deflate for `avin.compress`, and the content codings of `avin.net.http`: the library's own Sysl
  // package over the system's zlib, which macOS carries and Debian installs as zlib1g-dev.
  zcodec { path = "sysl/zcodec" }
}
