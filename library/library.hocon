// The Sysl packages the standard library's own bindings reach beyond Sysl's standard library and the
// runtime. A program's shims depend on one only where a binding the program compiles reaches it, so
// a program that never touches TLS never builds or links OpenSSL.
package { name = "avin-library", version = "0.1.0" }

sysl-dependencies {
  // TLS for `avin.net`'s `TlsStream` and `https` in `avin.net.http`. OpenSSL and its headers are
  // found by pkg-config: `brew install openssl@3`, Debian's libssl-dev, Arch's openssl.
  openssl { git = "github.com/sysl-lang/openssl", version = "0.2.3" }
}
