// `avin.encoding`: hexadecimal, base64 and base64url against RFC 4648's test vectors, every padding
// case, the empty input, Unicode text, round trips over every byte value and over random bytes, and
// each refusal with the offset it names.
import avin.encoding.{DecodeError, BadCharacter, BadPadding, Truncated, UnusedBits}
import avin.encoding.{toHex, fromHex, toBase64, fromBase64, toBase64Url, fromBase64Url}
import avin.random.SecureRandom

val Mixed = "héllo wörld ✓ 日本語 😀"

// Every byte value, 0 to 255, in order.
allBytes() -> Vector[byte] = Vector.tabulate(256, i -> byte(i))

// The text `bytes` hold, which a test expects to be UTF-8.
text(bytes: Vector[byte]) -> string = string.fromUtf8(bytes.toArray()).getOrElse("not UTF-8")

@test("base64 gives RFC 4648's vectors, every padding case and the empty input")
base64Vectors()
  assertEq(toBase64(""), "")
  assertEq(toBase64("f"), "Zg==")
  assertEq(toBase64("fo"), "Zm8=")
  assertEq(toBase64("foo"), "Zm9v")
  assertEq(toBase64("foob"), "Zm9vYg==")
  assertEq(toBase64("fooba"), "Zm9vYmE=")
  assertEq(toBase64("foobar"), "Zm9vYmFy")
  assertEq(toBase64(Vector[byte]()), "")
  assertEq(toBase64("foobar".bytes), "Zm9vYmFy")

@test("base64 decodes RFC 4648's vectors back to their bytes")
base64DecodeVectors()
  assertEq(fromBase64(""), Ok(Vector[byte]()))
  assertEq(fromBase64("Zg==").map(text), Ok("f"))
  assertEq(fromBase64("Zm8=").map(text), Ok("fo"))
  assertEq(fromBase64("Zm9v").map(text), Ok("foo"))
  assertEq(fromBase64("Zm9vYg==").map(text), Ok("foob"))
  assertEq(fromBase64("Zm9vYmE=").map(text), Ok("fooba"))
  assertEq(fromBase64("Zm9vYmFy").map(text), Ok("foobar"))

@test("base64url gives RFC 4648's vectors without padding, and decodes them back")
base64UrlVectors()
  assertEq(toBase64Url(""), "")
  assertEq(toBase64Url("f"), "Zg")
  assertEq(toBase64Url("fo"), "Zm8")
  assertEq(toBase64Url("foo"), "Zm9v")
  assertEq(toBase64Url("foob"), "Zm9vYg")
  assertEq(toBase64Url("fooba"), "Zm9vYmE")
  assertEq(toBase64Url("foobar"), "Zm9vYmFy")
  assertEq(fromBase64Url(""), Ok(Vector[byte]()))
  assertEq(fromBase64Url("Zg").map(text), Ok("f"))
  assertEq(fromBase64Url("Zm8").map(text), Ok("fo"))
  assertEq(fromBase64Url("Zm9vYmE").map(text), Ok("fooba"))
  assertEq(fromBase64Url("Zm9vYmFy").map(text), Ok("foobar"))

@test("the two alphabets differ only in the last two digits")
alphabets()
  val top = Vector(byte(0xFB), byte(0xFF), byte(0xBF))
  assertEq(toBase64(top), "+/+/")
  assertEq(toBase64Url(top), "-_-_")
  assertEq(fromBase64("+/+/"), Ok(top))
  assertEq(fromBase64Url("-_-_"), Ok(top))
  assertEq(toBase64(Vector(byte(0), byte(16), byte(131))), "ABCD")
  assertEq(toBase64(Vector(byte(105), byte(183), byte(29))), "abcd")
  assertEq(toBase64(Vector(byte(211), byte(93), byte(183))), "0123")

@test("hexadecimal gives RFC 4648's base16 vectors in lower case and reads either case")
hexVectors()
  assertEq(toHex(""), "")
  assertEq(toHex("f"), "66")
  assertEq(toHex("foobar"), "666f6f626172")
  assertEq(toHex("foobar".bytes), "666f6f626172")
  assertEq(fromHex(""), Ok(Vector[byte]()))
  assertEq(fromHex("666F6F626172").map(text), Ok("foobar"))
  assertEq(fromHex("666f6f626172").map(text), Ok("foobar"))
  assertEq(fromHex("DeAdBeEf"), Ok(Vector(byte(0xDE), byte(0xAD), byte(0xBE), byte(0xEF))))
  assertEq(toHex(Vector(byte(0), byte(9), byte(10), byte(15), byte(16), byte(255))), "00090a0f10ff")

@test("every byte value and every length up to 20 round-trips through all three encodings")
roundTripsAllBytes()
  val all = allBytes()
  assertEq(fromHex(toHex(all)), Ok(all))
  assertEq(fromBase64(toBase64(all)), Ok(all))
  assertEq(fromBase64Url(toBase64Url(all)), Ok(all))
  for n in 0 ..< 21
    val piece = all.slice(256 - n, 256)
    assertEq(fromHex(toHex(piece)), Ok(piece))
    assertEq(fromBase64(toBase64(piece)), Ok(piece))
    assertEq(fromBase64Url(toBase64Url(piece)), Ok(piece))
    assertEq(toBase64(piece).byteLength, (n + 2) / 3 * 4)
    assertEq(toBase64Url(piece).byteLength, (n * 4 + 2) / 3)
    assertEq(toHex(piece).byteLength, 2 * n)

@test("random bytes of every length up to 100 round-trip through base64url, base64 and hexadecimal")
roundTripsRandom()
  for n in 0 ..< 101
    val bytes = SecureRandom.nextBytes(n).toVector
    val url = toBase64Url(bytes)
    assert(!url.contains("=") && !url.contains("+") && !url.contains("/"))
    assertEq(fromBase64Url(url), Ok(bytes))
    assertEq(fromBase64(toBase64(bytes)), Ok(bytes))
    assertEq(fromHex(toHex(bytes)), Ok(bytes))

@test("Unicode text is encoded as its UTF-8 bytes and decodes back to the same text")
unicode()
  assertEq(toBase64("日本語"), "5pel5pys6Kqe")
  assertEq(toBase64Url("😀"), "8J-YgA")
  assertEq(toBase64("😀"), "8J+YgA==")
  assertEq(toHex("é"), "c3a9")
  assertEq(toBase64(Mixed), toBase64(Mixed.bytes))
  assertEq(fromBase64(toBase64(Mixed)).map(text), Ok(Mixed))
  assertEq(fromBase64Url(toBase64Url(Mixed)).map(text), Ok(Mixed))
  assertEq(fromHex(toHex(Mixed)).map(text), Ok(Mixed))

@test("a character outside the alphabet is refused at its byte offset")
badCharacters()
  assertEq(fromBase64("Zm9v YmFy"), Err(BadCharacter(4)))
  assertEq(fromBase64("Zm9v\nYmFy"), Err(BadCharacter(4)))
  assertEq(fromBase64("!m9v"), Err(BadCharacter(0)))
  assertEq(fromBase64("-_-_"), Err(BadCharacter(0)))
  assertEq(fromBase64Url("+/+/"), Err(BadCharacter(0)))
  assertEq(fromBase64Url("Zm9v/"), Err(BadCharacter(4)))
  assertEq(fromBase64("Zm9é"), Err(BadCharacter(3)))
  assertEq(fromBase64("Zg=!"), Err(BadCharacter(3)))
  assertEq(fromHex("0g"), Err(BadCharacter(1)))
  assertEq(fromHex("zz"), Err(BadCharacter(0)))
  assertEq(fromHex("00 11"), Err(BadCharacter(2)))
  assertEq(fromHex("aé"), Err(BadCharacter(1)))
  assertEq(fromHex("0x00"), Err(BadCharacter(1)))

@test("every ASCII character is accepted exactly when it is a digit of the alphabet")
everyAsciiCharacter()
  for c in 0 ..< 128
    val ch = char(c)
    val inStandard = 'A' <= ch <= 'Z' || 'a' <= ch <= 'z' || '0' <= ch <= '9' || ch == '+' || ch == '/'
    val inUrl = 'A' <= ch <= 'Z' || 'a' <= ch <= 'z' || '0' <= ch <= '9' || ch == '-' || ch == '_'
    val inHex = '0' <= ch <= '9' || 'a' <= ch <= 'f' || 'A' <= ch <= 'F'
    val standard = fromBase64(s"QUI${ch}")
    val url = fromBase64Url(s"QUI${ch}")
    if ch == '='
      assertEq(standard.map(text), Ok("AB"))
      assertEq(url, Err(BadPadding(3)))
    else
      assertEq(standard.isOk, inStandard)
      assertEq(url.isOk, inUrl)
      if !inStandard then assertEq(standard, Err(BadCharacter(3)))
      if !inUrl then assertEq(url, Err(BadCharacter(3)))
    val hex = fromHex(s"a${ch}")
    assertEq(hex.isOk, inHex)
    if !inHex then assertEq(hex, Err(BadCharacter(1)))

@test("padding is refused where it cannot stand, missing where it must, and anywhere in base64url")
badPadding()
  assertEq(fromBase64("Zg=A"), Err(BadPadding(2)))
  assertEq(fromBase64("Zg===="), Err(BadPadding(2)))
  assertEq(fromBase64("Zm9v===="), Err(BadPadding(4)))
  assertEq(fromBase64("Zm9vY==="), Err(BadPadding(5)))
  assertEq(fromBase64("===="), Err(BadPadding(0)))
  assertEq(fromBase64("Zg==Zg=="), Err(BadPadding(2)))
  assertEq(fromBase64("Z=g="), Err(BadPadding(1)))
  assertEq(fromBase64Url("Zg=="), Err(BadPadding(2)))
  assertEq(fromBase64Url("Zm8="), Err(BadPadding(3)))
  assertEq(fromBase64Url("="), Err(BadPadding(0)))

@test("a text that ends inside a unit is refused at its length")
truncated()
  assertEq(fromBase64("Zg"), Err(Truncated(2)))
  assertEq(fromBase64("Zm8"), Err(Truncated(3)))
  assertEq(fromBase64("Zg="), Err(Truncated(3)))
  assertEq(fromBase64("Z"), Err(Truncated(1)))
  assertEq(fromBase64("="), Err(Truncated(1)))
  assertEq(fromBase64("Zm9vY"), Err(Truncated(5)))
  assertEq(fromBase64("Zm9v="), Err(Truncated(5)))
  assertEq(fromBase64Url("Z"), Err(Truncated(1)))
  assertEq(fromBase64Url("Zm9vY"), Err(Truncated(5)))
  assertEq(fromHex("a"), Err(Truncated(1)))
  assertEq(fromHex("abc"), Err(Truncated(3)))

@test("a last digit with bits set below the last whole byte is refused, so each byte sequence has one spelling")
unusedBits()
  assertEq(fromBase64("Zh=="), Err(UnusedBits(1)))
  assertEq(fromBase64("Zm9="), Err(UnusedBits(2)))
  assertEq(fromBase64("Zm9vYh=="), Err(UnusedBits(5)))
  assertEq(fromBase64Url("Zh"), Err(UnusedBits(1)))
  assertEq(fromBase64Url("Zm9"), Err(UnusedBits(2)))
  val digits = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
  for v in 0 ..< 64
    val d = digits.charAt(v)
    assertEq(fromBase64Url(s"A${d}").isOk, v % 16 == 0)
    assertEq(fromBase64Url(s"AA${d}").isOk, v % 4 == 0)
    if v % 4 != 0 then assertEq(fromBase64Url(s"AA${d}"), Err(UnusedBits(2)))

@test("a refusal names what is wrong and where, as an Error")
messages()
  val e: Error = BadCharacter(4)
  assertEq(e.message, "not a character of the encoding at index 4")
  assertEq(BadPadding(2).message, "padding not allowed at index 2")
  assertEq(Truncated(3).message, "the text ends inside a unit at index 3")
  assertEq(UnusedBits(1).message, "unused bits set at index 1")
  val r: Result[Vector[byte], DecodeError] = fromBase64("Zg")
  assertEq(r.isErr, true)
