// `avin.cache`: an `LruCache` by count and by weight, its recency, `peek`, replacing, removing and
// clearing, the empty and one-entry capacities and a value heavier than the capacity; loaders, their
// failures stored or not, one load for many threads missing on a key at once, with the same or another
// error type, a write while a load runs, a loader using the cache and a cancelled load; the counts;
// many threads at once; and a `TtlCache`'s expiry by an injected clock, at its boundary, per entry,
// after a load, by `purgeExpired`, and with the monotonic clock.
import avin.cache.{CacheStats, LruCache, TtlCache}
import avin.threads.{Atomic, scope, sleep}
import avin.time.{Duration, micros, millis, seconds}

private zeros() -> CacheStats = CacheStats(0, 0, 0, 0, 0, 0)

// A clock a test moves by hand, in microseconds.
private class Hand()
  val at = Atomic[long](0)
  reading() -> Duration = micros(at.load())
  set(t: long) = at.store(t)

private data Point(x: int, y: int)

// Waits until `ready` holds, a millisecond at a time.
private until(ready: () -> bool)
  while !ready() do sleep(millis(1))

@test("an empty cache finds nothing and has counted nothing")
emptyCache()
  val c = LruCache[string, int](4)
  assertEq(c.size(), 0)
  assertEq(c.weight(), long(0))
  assertEq(c.stats(), zeros())
  assertEq(c.stats().hitRate, 0.0)
  assertEq(c.peek("a"), None)
  assertEq(c.stats(), zeros())
  assertEq(c.get("a"), None)
  assertEq(c.stats(), CacheStats(0, 1, 0, 0, 0, 0))
  assertEq(c.remove("a"), None)
  assertEq(c.capacity, long(4))

@test("put and get, a hit and a miss counted each")
putGet()
  val c = LruCache[string, int](4)
  c.put("a", 1)
  c.put("b", 2)
  assertEq(c.get("a"), Some(1))
  assertEq(c.get("b"), Some(2))
  assertEq(c.get("z"), None)
  assertEq(c.size(), 2)
  assertEq(c.weight(), long(2))
  val s = c.stats()
  assertEq(s, CacheStats(2, 1, 0, 0, 0, 0))
  assertEq(s.requests, long(3))
  assertEq(s.hitRate, 2.0 / 3.0)

@test("the least recently used entry goes first, and a get makes an entry the most recent")
recency()
  val c = LruCache[string, int](3)
  c.put("a", 1)
  c.put("b", 2)
  c.put("c", 3)
  assertEq(c.get("a"), Some(1))
  c.put("d", 4)
  assertEq(c.peek("b"), None)
  assertEq(c.peek("a"), Some(1))
  assertEq(c.peek("c"), Some(3))
  assertEq(c.peek("d"), Some(4))
  c.put("e", 5)
  assertEq(c.peek("c"), None)
  assertEq(c.size(), 3)
  assertEq(c.stats().evictions, long(2))

@test("peek neither makes an entry recent nor counts")
peekLeavesRecency()
  val c = LruCache[string, int](2)
  c.put("a", 1)
  c.put("b", 2)
  assertEq(c.peek("a"), Some(1))
  c.put("c", 3)
  assertEq(c.peek("a"), None)
  assertEq(c.stats(), CacheStats(0, 0, 0, 0, 1, 0))

@test("putting a key again replaces its value and makes it the most recent, the size kept")
replace()
  val c = LruCache[string, int](2)
  c.put("a", 1)
  c.put("b", 2)
  c.put("a", 10)
  assertEq(c.size(), 2)
  assertEq(c.weight(), long(2))
  c.put("c", 3)
  assertEq(c.peek("a"), Some(10))
  assertEq(c.peek("b"), None)
  assertEq(c.stats().evictions, long(1))

@test("a capacity of zero stores nothing, and one of one holds the newest entry")
smallCapacities()
  val none = LruCache[int, int](0)
  none.put(1, 1)
  assertEq(none.get(1), None)
  assertEq(none.size(), 0)
  assertEq(none.getOrLoad(1, k -> k * 2), 2)
  assertEq(none.size(), 0)
  assertEq(none.stats().evictions, long(0))
  val one = LruCache[int, int](1)
  one.put(1, 1)
  one.put(2, 2)
  assertEq(one.get(1), None)
  assertEq(one.get(2), Some(2))
  assertEq(one.size(), 1)
  assertEq(one.stats().evictions, long(1))

@test("a weigher bounds the cache by weight, dropping as many old entries as a heavy one needs")
weighted()
  val c = LruCache[string, string](10, (_, v) -> long(v.byteLength))
  c.put("a", "xxx")
  c.put("b", "yyy")
  c.put("c", "zzz")
  assertEq(c.weight(), long(9))
  c.put("d", "wwwwwwww")
  assertEq(c.weight(), long(8))
  assertEq(c.size(), 1)
  assertEq(c.stats().evictions, long(3))
  c.put("e", "")
  c.put("f", "")
  assertEq(c.size(), 3)
  assertEq(c.weight(), long(8))
  c.put("d", "ww")
  assertEq(c.weight(), long(2))
  assertEq(c.remove("d"), Some("ww"))
  assertEq(c.weight(), long(0))
  assertEq(c.size(), 2)

@test("a value heavier than the capacity is not stored, and the key's old value goes")
tooHeavy()
  val c = LruCache[string, string](4, (_, v) -> long(v.byteLength))
  c.put("a", "ab")
  c.put("b", "cd")
  c.put("a", "abcde")
  assertEq(c.peek("a"), None)
  assertEq(c.peek("b"), Some("cd"))
  assertEq(c.weight(), long(2))
  assertEq(c.stats().evictions, long(0))
  c.put("c", "abcd")
  assertEq(c.peek("c"), Some("abcd"))
  assertEq(c.peek("b"), None)
  assertEq(c.weight(), long(4))

@test("weights by Unicode text, and keys of every kind: Unicode strings, tuples, data")
keysOfEveryKind()
  val c = LruCache[string, string](6, (k, v) -> long(k.byteLength + v.byteLength))
  c.put("é", "ü")
  c.put("日本", "")
  assertEq(c.weight(), long(6))
  assertEq(c.get("é"), None)
  assertEq(c.get("日本"), Some(""))
  val t = LruCache[(int, string), Point](2)
  t.put((1, "a"), Point(1, 2))
  assertEq(t.get((1, "a")), Some(Point(1, 2)))
  assertEq(t.get((1, "b")), None)
  val p = LruCache[Point, Vector[int]](2)
  p.put(Point(0, 0), [1, 2, 3])
  assertEq(p.get(Point(0, 0)), Some([1, 2, 3]))

@test("remove gives back the value, and clear drops everything but the counts")
removeAndClear()
  val c = LruCache[int, int](8)
  for i in 0 ..< 5 do c.put(i, i * i)
  assertEq(c.remove(3), Some(9))
  assertEq(c.remove(3), None)
  assertEq(c.size(), 4)
  assertEq(c.get(4), Some(16))
  c.clear()
  assertEq(c.size(), 0)
  assertEq(c.weight(), long(0))
  assertEq(c.get(4), None)
  assertEq(c.stats(), CacheStats(1, 1, 0, 0, 0, 0))
  c.put(4, 1)
  assertEq(c.get(4), Some(1))

@test("getOrLoad runs its loader on a miss only, and stores what it gives")
loads()
  val c = LruCache[string, int](4)
  val calls = Atomic[long](0)
  val load = (k: string) ->
    _ = calls.add(1)
    k.byteLength
  assertEq(c.getOrLoad("abc", load), 3)
  assertEq(c.getOrLoad("abc", load), 3)
  assertEq(calls.load(), long(1))
  assertEq(c.peek("abc"), Some(3))
  c.put("x", 9)
  assertEq(c.getOrLoad("x", load), 9)
  assertEq(calls.load(), long(1))
  assertEq(c.stats(), CacheStats(2, 1, 1, 0, 0, 0))

@test("getOrTry stores an Ok, and hands back an Err without storing it, so the next call loads again")
tries()
  val c = LruCache[string, int](4)
  val calls = Atomic[long](0)
  val failing = (k: string) ->
    _ = calls.add(1)
    Err[int, string]("no " + k)
  assertEq(c.getOrTry("a", failing), Err("no a"))
  assertEq(c.getOrTry("a", failing), Err("no a"))
  assertEq(calls.load(), long(2))
  assertEq(c.size(), 0)
  assertEq(c.stats(), CacheStats(0, 2, 2, 2, 0, 0))
  assertEq(c.getOrTry("a", k -> Ok[int, string](7)), Ok(7))
  assertEq(c.getOrTry("a", failing), Ok(7))
  assertEq(calls.load(), long(2))
  assertEq(c.stats().loadFailures, long(2))

@test("a cache of Results filled by getOrLoad stores a failure too, where that is what is asked")
failuresStored()
  val c = LruCache[string, Result[int, string]](4)
  val calls = Atomic[long](0)
  val load = (k: string) ->
    _ = calls.add(1)
    Err[int, string]("gone")
  assertEq(c.getOrLoad("a", load), Err("gone"))
  assertEq(c.getOrLoad("a", load), Err("gone"))
  assertEq(calls.load(), long(1))
  assertEq(c.stats().loadFailures, long(0))

@test("threads missing on one key at once run the loader once and all get its value")
singleflight()
  val c = LruCache[string, int](4)
  val calls = Atomic[long](0)
  val got = Atomic[long](0)
  scope(s ->
    for t in 0 ..< 8
      s.spawn(() ->
        val v = c.getOrLoad("k", k ->
          _ = calls.add(1)
          until(() -> c.stats().misses == 8)
          42)
        _ = got.add(long(v))
        ()))
  assertEq(calls.load(), long(1))
  assertEq(got.load(), long(8 * 42))
  assertEq(c.stats(), CacheStats(0, 8, 1, 0, 0, 0))
  assertEq(c.get("k"), Some(42))

@test("a failing load shared by many threads hands each its error once, and stores nothing")
singleflightFailure()
  val c = LruCache[string, int](4)
  val calls = Atomic[long](0)
  val errs = Atomic[long](0)
  scope(s ->
    for t in 0 ..< 8
      s.spawn(() ->
        val r = c.getOrTry("k", k ->
          _ = calls.add(1)
          until(() -> c.stats().misses == 8)
          Err[int, string]("down"))
        if r == Err("down") then _ = errs.add(1)
        ()))
  assertEq(calls.load(), long(1))
  assertEq(errs.load(), long(8))
  assertEq(c.stats(), CacheStats(0, 8, 1, 1, 0, 0))
  assertEq(c.size(), 0)

@test("loads of different keys run at once, one each")
keysLoadApart()
  val c = LruCache[int, int](16)
  val calls = Atomic[long](0)
  scope(s ->
    for t in 0 ..< 8
      s.spawn(() ->
        _ = c.getOrLoad(t % 4, k ->
          _ = calls.add(1)
          until(() -> c.stats().misses == 8)
          k * 10)
        ()))
  assertEq(calls.load(), long(4))
  for k in 0 ..< 4 do assertEq(c.peek(k), Some(k * 10))

@test(
  "a getOrTry waiting on a getOrLoad's load gets its value, and one of another error type loads again after a failure"
)
mixedFlights()
  val c = LruCache[string, int](4)
  scope(s ->
    s.spawn(() -> c.getOrLoad("a", k ->
      until(() -> c.stats().misses == 2)
      5))
    s.spawn(() ->
      until(() -> c.stats().loads == 1)
      assertEq(c.getOrTry("a", k -> Err[int, int](0)), Ok(5))))
  assertEq(c.stats().loads, long(1))
  val calls = Atomic[long](0)
  scope(s ->
    s.spawn(() -> c.getOrTry("b", k ->
      _ = calls.add(1)
      until(() -> c.stats().misses == 4)
      Err[int, string]("first")))
    s.spawn(() ->
      until(() -> c.stats().loads == 2)
      val r = c.getOrTry("b", k ->
        _ = calls.add(1)
        Err[int, int](2))
      assertEq(r, Err(2))))
  assertEq(calls.load(), long(2))
  assertEq(c.stats().loads, long(3))
  assertEq(c.stats().loadFailures, long(2))

@test("a put, remove or clear of a key while its load runs wins: the load's value is given but not stored")
writeDuringLoad()
  val c = LruCache[string, int](4)
  assertEq(c.getOrLoad("a", k ->
    c.put("a", 2)
    1), 1)
  assertEq(c.peek("a"), Some(2))
  c.put("b", 3)
  assertEq(c.getOrLoad("c", k ->
    _ = c.remove("c")
    4), 4)
  assertEq(c.peek("c"), None)
  assertEq(c.getOrLoad("d", k ->
    c.clear()
    5), 5)
  assertEq(c.peek("d"), None)
  assertEq(c.size(), 0)
  assertEq(c.getOrLoad("d", k -> 6), 6)
  assertEq(c.peek("d"), Some(6))

@test("a loader may use the cache, loading other keys through it")
nestedLoads()
  val c = LruCache[int, long](64)
  assertEq(fibOf(c, 40), long(102334155))
  assertEq(c.stats().loads, long(41))
  assertEq(c.size(), 41)

private fibOf(c: LruCache[int, long], n: int) -> long =
  c.getOrLoad(n, k -> if k < 2 then long(k) else fibOf(c, k - 1) + fibOf(c, k - 2))

@test("a load whose thread is cancelled ends its flight, and a thread waiting on it loads again")
cancelledLoad()
  val c = LruCache[string, int](4)
  scope(outer ->
    outer.spawn(() ->
      until(() -> c.stats().loads == 1)
      assertEq(c.getOrLoad("k", k -> 7), 7))
    scope(inner ->
      inner.spawn(() -> c.getOrLoad("k", k ->
        sleep(seconds(60))
        1))
      until(() -> c.stats().misses == 2)
      inner.cancel()))
  assertEq(c.peek("k"), Some(7))
  assertEq(c.stats(), CacheStats(0, 2, 2, 1, 0, 0))

@test("many threads at once keep the size, weight and counts consistent")
contention()
  val c = LruCache[int, int](64)
  val gets = Atomic[long](0)
  scope(s ->
    for t in 0 ..< 16
      s.spawn(() ->
        var x = t * 7919 + 1
        for i in 0 ..< 2000
          x = (x *% 1103515245 +% 12345) & 0x7fffffff
          val k = x % 256
          if i % 3 == 0 then c.put(k, k)
          elif i % 7 == 0 then _ = c.remove(k)
          elif i % 11 == 0 then assertEq(c.getOrLoad(k, j -> j), k)
          else
            _ = gets.add(1)
            c.get(k) match
              Some(v) -> assertEq(v, k)
              None -> ()
        ()))
  assert(c.size() <= 64)
  assertEq(c.weight(), long(c.size()))
  val st = c.stats()
  assert(st.requests >= gets.load())
  assertEq(st.loadFailures, long(0))

@test("a TtlCache's entry is live until its time to live has passed, and expires at it exactly")
ttlBoundary()
  val h = Hand()
  val c = TtlCache[string, int](micros(100), 8, clock = h.reading)
  assertEq(c.ttl, micros(100))
  h.set(1000)
  c.put("a", 1)
  h.set(1099)
  assertEq(c.get("a"), Some(1))
  h.set(1100)
  assertEq(c.peek("a"), None)
  assertEq(c.size(), 1)
  assertEq(c.get("a"), None)
  assertEq(c.size(), 0)
  assertEq(c.stats(), CacheStats(1, 1, 0, 0, 0, 1))

@test("a TtlCache's time to live counts from the put, and a get does not lengthen it")
ttlFromWrite()
  val h = Hand()
  val c = TtlCache[string, int](micros(10), 8, clock = h.reading)
  c.put("a", 1)
  h.set(5)
  assertEq(c.get("a"), Some(1))
  c.put("b", 2)
  h.set(10)
  assertEq(c.get("a"), None)
  assertEq(c.get("b"), Some(2))
  c.put("a", 3)
  h.set(19)
  assertEq(c.get("a"), Some(3))
  assertEq(c.get("b"), None)

@test("an entry put with a life of its own expires by it")
perEntryLife()
  val h = Hand()
  val c = TtlCache[string, int](seconds(60), 8, clock = h.reading)
  c.put("short", 1, micros(5))
  c.put("long", 2)
  h.set(5)
  assertEq(c.get("short"), None)
  assertEq(c.get("long"), Some(2))
  c.put("longer", 3, seconds(3600))
  h.set(seconds(120).micros)
  assertEq(c.get("long"), None)
  assertEq(c.get("longer"), Some(3))

@test("a loaded value expires a time to live after its load ended")
ttlAfterLoad()
  val h = Hand()
  val c = TtlCache[string, int](micros(10), 8, clock = h.reading)
  assertEq(c.getOrLoad("a", k ->
    h.set(50)
    1), 1)
  h.set(59)
  assertEq(c.get("a"), Some(1))
  h.set(60)
  assertEq(c.getOrLoad("a", k -> 2), 2)
  assertEq(c.stats(), CacheStats(1, 2, 2, 0, 0, 1))

@test("purgeExpired drops every expired entry and only those, counting them")
purge()
  val h = Hand()
  val c = TtlCache[int, int](micros(10), 100, clock = h.reading)
  for i in 0 ..< 10
    h.set(long(i))
    c.put(i, i)
  assertEq(c.purgeExpired(), 0)
  h.set(14)
  assertEq(c.purgeExpired(), 5)
  assertEq(c.size(), 5)
  assertEq(c.weight(), long(5))
  assertEq(c.peek(4), None)
  assertEq(c.peek(5), Some(5))
  assertEq(c.stats().expirations, long(5))
  h.set(1000)
  assertEq(c.purgeExpired(), 5)
  assertEq(c.size(), 0)
  assertEq(c.purgeExpired(), 0)

@test("a TtlCache is bounded as an LruCache is, and remove gives back only a live value")
ttlBounded()
  val h = Hand()
  val c = TtlCache[int, string](micros(10), 2, (_, v) -> long(v.byteLength), h.reading)
  c.put(1, "a")
  c.put(2, "b")
  assertEq(c.get(1), Some("a"))
  c.put(3, "c")
  assertEq(c.peek(2), None)
  assertEq(c.stats().evictions, long(1))
  assertEq(c.remove(1), Some("a"))
  h.set(10)
  assertEq(c.remove(3), None)
  assertEq(c.size(), 0)
  c.put(4, "dd")
  c.clear()
  assertEq(c.size(), 0)

@test("a time to live as long as any saturates the expiry instead of overflowing")
ttlSaturates()
  val h = Hand()
  h.set(long.MaxValue - 5)
  val c = TtlCache[int, int](Duration.Max, 4, clock = h.reading)
  c.put(1, 1)
  assertEq(c.get(1), Some(1))

@test("a TtlCache reads the monotonic clock unless given one")
ttlRealClock()
  val c = TtlCache[string, int](seconds(3600), 4)
  c.put("a", 1)
  assertEq(c.get("a"), Some(1))
  val quick = TtlCache[string, int](millis(1), 4)
  quick.put("a", 1)
  sleep(millis(5))
  assertEq(quick.get("a"), None)

@test("singleflight and expiry together: threads missing on an expired key load it once")
ttlSingleflight()
  val h = Hand()
  val c = TtlCache[string, int](micros(10), 4, clock = h.reading)
  c.put("k", 1)
  h.set(10)
  val calls = Atomic[long](0)
  scope(s ->
    for t in 0 ..< 4
      s.spawn(() ->
        assertEq(c.getOrLoad("k", k ->
          _ = calls.add(1)
          until(() -> c.stats().misses == 4)
          2), 2)))
  assertEq(calls.load(), long(1))
  assertEq(c.stats().expirations, long(1))
