// -- Ed25519 -----------------------------------------------------------------------------------------------

@test("Ed25519 makes RFC 8032's public keys and signatures from its secret keys")
ed25519Rfc8032()
  val one = ed25519PrivateKey(
    hex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
  ).getOrElse(fail("RFC 8032 key 1"))
  assertEq(
    toHex(one.publicKey.ed25519Bytes().getOrElse(Vector())),
    "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
  )
  val sig1 = signed(one, Ed25519, Vector())
  assertEq(
    toHex(sig1),
    "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"
  )
  assert(checks(one.publicKey, Ed25519, Vector(), sig1))
  val two = ed25519PrivateKey(
    hex("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
  ).getOrElse(fail("RFC 8032 key 2"))
  assertEq(
    toHex(two.publicKey.ed25519Bytes().getOrElse(Vector())),
    "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"
  )
  assertEq(
    toHex(signed(two, Ed25519, hex("72"))),
    "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"
  )

@test("an Ed25519 public key made from its 32 bytes is the one its SubjectPublicKeyInfo encodes")
ed25519RawAndDerAgree()
  val raw = hex("7d4d0e7f6153a69b6242b522abbee685fda4420f8834b108c3bdae369ef549fa")
  val fromRaw = ed25519PublicKey(raw).getOrElse(fail("a raw Ed25519 key"))
  val fromDer = publicOfDer("302a300506032b65700321007d4d0e7f6153a69b6242b522abbee685fda4420f8834b108c3bdae369ef549fa")
  assert(fromRaw == fromDer)
  assertEq(
    toHex(fromRaw.toDer()),
    "302a300506032b65700321007d4d0e7f6153a69b6242b522abbee685fda4420f8834b108c3bdae369ef549fa"
  )
  assertEq(toHex(fromDer.ed25519Bytes().getOrElse(Vector())), toHex(raw))
  assert(fromDer.kind == Ed25519Key)

