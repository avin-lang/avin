@test("ECDSA P-256 takes Wycheproof's valid DER signatures and refuses its malformed and forged ones")
ecdsaP256Wycheproof()
  val key = publicOfDer(P256Key)
  assert(key.kind == EcP256Key)
  for (tc, msg, sig, valid) in P256Vectors
    assertEq(s"$tc ${checks(key, EcdsaP256Sha256, hex(msg), hex(sig))}", s"$tc $valid")

