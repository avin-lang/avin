@test("Ed25519 takes Wycheproof's valid signatures and refuses its truncated, padded, malleated and forged ones")
ed25519Wycheproof()
  val key = ed25519PublicKey(
    hex("7d4d0e7f6153a69b6242b522abbee685fda4420f8834b108c3bdae369ef549fa")
  ).getOrElse(fail("the key"))
  for (tc, msg, sig, valid) in Ed25519Vectors
    assertEq(s"$tc ${checks(key, Ed25519, hex(msg), hex(sig))}", s"$tc $valid")

