@test("ECDSA P-384 takes Wycheproof's valid signatures and refuses its malformed and forged ones")
ecdsaP384Wycheproof()
  val key = publicOfDer(P384Key)
  assert(key.kind == EcP384Key)
  for (tc, msg, sig, valid) in P384Vectors
    assertEq(s"$tc ${checks(key, EcdsaP384Sha384, hex(msg), hex(sig))}", s"$tc $valid")

@test("RFC 7515's ES256 signature, carried fixed-width, checks against its P-256 key")
es256Rfc7515()
  val key = publicOf(RfcEcPublic)
  val fixed = fromBase64Url(RfcEs256).getOrElse(fail("the signature"))
  assertEq(fixed.length, 64)
  val der = ecdsaDerSignature(fixed, EcdsaP256Sha256).getOrElse(fail("DER of the signature"))
  assert(checks(key, EcdsaP256Sha256, RfcInputEs.bytes, der))
  assertEq(toHex(ecdsaFixedSignature(der, EcdsaP256Sha256).getOrElse(Vector())), toHex(fixed))
  assert(!checks(key, EcdsaP256Sha256, RfcInputRs.bytes, der))
  assert(privateOf(RfcEcPrivate).publicKey == key)

@test(
  "the two forms of an ECDSA signature round trip, and anything that is not one signature in canonical DER has no fixed form"
)
ecdsaForms()
  val key = generatePrivateKey(EcP256Key)
  for i in 0 ..< 40
    val der = signed(key, EcdsaP256Sha256, s"message $i".bytes)
    val fixed = ecdsaFixedSignature(der, EcdsaP256Sha256).getOrElse(fail("the fixed form"))
    assertEq(fixed.length, 64)
    assertEq(toHex(ecdsaDerSignature(fixed, EcdsaP256Sha256).getOrElse(Vector())), toHex(der))
  val p384 = generatePrivateKey(EcP384Key)
  val der384 = signed(p384, EcdsaP384Sha384, "x".bytes)
  assertEq(ecdsaFixedSignature(der384, EcdsaP384Sha384).getOrElse(Vector()).length, 96)
  // A P-256 signature's integers fit P-384's 48-byte width too.
  val der256 = signed(key, EcdsaP256Sha256, "x".bytes)
  assertEq(ecdsaFixedSignature(der256, EcdsaP384Sha384).getOrElse(Vector()).length, 96)
  // BER, trailing bytes, an empty input, a lone tag, a negative integer, and schemes that are not ECDSA.
  for (_, _, sig, valid) in P256Vectors
    if !valid then
      val bytes = hex(sig)
      ecdsaFixedSignature(bytes, EcdsaP256Sha256) match
        Some(fixed) -> assertEq(fixed.length, 64)
        None -> ()
  assert(ecdsaFixedSignature(hex(P256Vectors(3).2), EcdsaP256Sha256) is None)
  assert(ecdsaFixedSignature(hex(P256Vectors(4).2), EcdsaP256Sha256) is None)
  assert(ecdsaFixedSignature(hex(P256Vectors(9).2), EcdsaP256Sha256) is None)
  assert(ecdsaFixedSignature(hex(P256Vectors(19).2), EcdsaP256Sha256) is None)
  assert(ecdsaFixedSignature(Vector(), EcdsaP256Sha256) is None)
  assert(ecdsaFixedSignature(hex("30"), EcdsaP256Sha256) is None)
  assert(ecdsaFixedSignature(der256 ++ hex("00"), EcdsaP256Sha256) is None)
  assert(ecdsaFixedSignature(der256, Ed25519) is None)
  assert(ecdsaFixedSignature(der256, RsaPssSha256) is None)
  assert(ecdsaDerSignature(Vector.fill(63, byte(1)), EcdsaP256Sha256) is None)
  assert(ecdsaDerSignature(Vector.fill(65, byte(1)), EcdsaP256Sha256) is None)
  assert(ecdsaDerSignature(Vector.fill(64, byte(1)), EcdsaP384Sha384) is None)
  assert(ecdsaDerSignature(Vector.fill(64, byte(1)), Ed25519) is None)
  assert(ecdsaDerSignature(Vector(), EcdsaP256Sha256) is None)
  // Integers whose top bit is set gain a leading zero in DER, and leading zeros come off.
  val high = Vector.fill(64, byte(0xff))
  assertEq(toHex(ecdsaDerSignature(high, EcdsaP256Sha256).getOrElse(Vector())).slice(0, 12), "3046022100ff")
  val low = Vector.tabulate(64, i -> if i == 31 || i == 63 then byte(7) else byte(0))
  assertEq(toHex(ecdsaDerSignature(low, EcdsaP256Sha256).getOrElse(Vector())), "3006020107020107")
  assertEq(toHex(ecdsaFixedSignature(hex("3006020107020107"), EcdsaP256Sha256).getOrElse(Vector())), toHex(low))

// -- RSA -----------------------------------------------------------------------------------------------------

val Rsa2048Key = ""

// Wycheproof's RSA PKCS#1 v1.5 SHA-256 vectors: valid, and padding that is BER, truncated or altered.
val Pkcs1Vectors = [
  (
    1,
    "",
    "",
    true
  ),
  (
    3,
    "54657374",
    "",
    true
  ),
  (
    7,
    "e0e1e2e3e4e5e6e7e8e9eaebecedeeeff0f1f2f3f4f5f6f7f8f9fafbfcfdfeff",
    "",
    true
  ),
  (
    9,
    "313233343030",
    "",
    false
  ),
  (
    21,
    "313233343030",
    "",
    false
  ),
  (
    48,
    "313233343030",
    "",
    false
  ),
  (
    62,
    "313233343030",
    "",
    false
  )
]

@test("RSA PKCS#1 v1.5 takes Wycheproof's valid signatures and refuses its malformed padding")
rsaPkcs1Wycheproof()
  val key = publicOfDer(Rsa2048Key)
  assert(key.kind == RsaKey(2048))
  for (tc, msg, sig, valid) in Pkcs1Vectors
    assertEq(s"$tc ${checks(key, RsaPkcs1Sha256, hex(msg), hex(sig))}", s"$tc $valid")
  // A signature one byte short, one byte long, empty, and a valid one under the wrong digest.
  val good = hex(Pkcs1Vectors(1).2)
  assert(!checks(key, RsaPkcs1Sha256, hex("54657374"), good.slice(1, good.length)))
  assert(!checks(key, RsaPkcs1Sha256, hex("54657374"), good ++ hex("00")))
  assert(!checks(key, RsaPkcs1Sha256, hex("54657374"), Vector()))
  assert(!checks(key, RsaPkcs1Sha384, hex("54657374"), good))
  assert(!checks(key, RsaPssSha256, hex("54657374"), good))

// Wycheproof's RSA-PSS SHA-256 vectors (MGF1 over SHA-256, a 32-byte salt), over the same key.
val PssVectors = [
  (
    1,
    "",
    "",
    true
  ),
  (
    4,
    "313233343030",
    "",
    true
  ),
  (
    62,
    "313233343030",
    "",
    false
  ),
  (
    70,
    "313233343030",
    "",
    false
  ),
  (
    71,
    "313233343030",
    "",
    false
  ),
  (
    94,
    "313233343030",
    "",
    false
  ),
  (
    102,
    "313233343030",
    "",
    false
  )
]

@test(
  "RSA-PSS takes Wycheproof's valid signatures and refuses a changed hash, a salt of another length and a signature equal to n"
)
rsaPssWycheproof()
  val key = publicOfDer(Rsa2048Key)
  for (tc, msg, sig, valid) in PssVectors
    assertEq(s"$tc ${checks(key, RsaPssSha256, hex(msg), hex(sig))}", s"$tc $valid")
  assert(!checks(key, RsaPkcs1Sha256, Vector(), hex(PssVectors(0).2)))
  assert(!checks(key, RsaPssSha512, Vector(), hex(PssVectors(0).2)))

@test("RS256 over RFC 7515's input with its key gives exactly A.2's signature, and the public key checks it")
rs256Rfc7515()
  val key = privateOf(RfcRsaPrivate)
  assert(key.kind == RsaKey(2048))
  val expected = fromBase64Url(RfcRs256).getOrElse(fail("the signature"))
  val made = signed(key, RsaPkcs1Sha256, RfcInputRs.bytes)
  assertEq(toHex(made), toHex(expected))
  assert(checks(publicOf(RfcRsaPublic), RsaPkcs1Sha256, RfcInputRs.bytes, made))
  assert(key.publicKey == publicOf(RfcRsaPublic))
  // The traditional form of the same key is the same key, and signs the same.
  val traditional = privateOf(RfcRsaTraditional)
  assertEq(toHex(traditional.toDer()), toHex(key.toDer()))
  assertEq(toHex(signed(traditional, RsaPkcs1Sha256, RfcInputRs.bytes)), toHex(expected))

// -- every scheme --------------------------------------------------------------------------------------------

// Each scheme with a key it signs with: generated for Ed25519 and the curves, RFC 7515's for RSA.
schemesAndKeys() -> Vector[(SignatureScheme, PrivateKey)]
  val ed = generatePrivateKey(Ed25519Key)
  val p256 = generatePrivateKey(EcP256Key)
  val p384 = generatePrivateKey(EcP384Key)
  val rsa = privateOf(RfcRsaPrivate)
  [
    (Ed25519, ed),
    (EcdsaP256Sha256, p256),
    (EcdsaP384Sha384, p384),
    (RsaPkcs1Sha256, rsa),
    (RsaPkcs1Sha384, rsa),
    (RsaPkcs1Sha512, rsa),
    (RsaPssSha256, rsa),
    (RsaPssSha384, rsa),
    (RsaPssSha512, rsa)
  ]

@test("every scheme signs and checks: an empty message, one byte, every byte value, a mebibyte, and Unicode text")
everySchemeRoundTrips()
  val big = Vector.tabulate(1048576 + 3, i -> byte(i * 7 % 256))
  val every = Vector.tabulate(256, i -> byte(i))
  for (scheme, key) in schemesAndKeys()
    val public = key.publicKey
    for message in [Vector(), hex("00"), every, big]
      val signature = signed(key, scheme, message)
      assert(checks(public, scheme, message, signature))
    val text = "héllo wörld ✓ 日本語 😀"
    val fromText = key.sign(scheme, text).getOrElse(fail("text"))
    assert(public.verify(scheme, text, fromText).getOrElse(false))
    assert(checks(public, scheme, text.bytes, fromText))

@test("a signature does not check over another message, after any one of its bytes changes, or under another key")
alteredSignaturesFail()
  for (scheme, key) in schemesAndKeys()
    val public = key.publicKey
    val message = "the message".bytes
    val signature = signed(key, scheme, message)
    assert(!checks(public, scheme, "the messagE".bytes, signature))
    assert(!checks(public, scheme, message ++ hex("00"), signature))
    assert(!checks(public, scheme, Vector(), signature))
    for at in [0, 1, signature.length / 2, signature.length - 1]
      assert(!checks(public, scheme, message, flipped(signature, at)))
    assert(!checks(public, scheme, message, signature.slice(0, signature.length - 1)))
    assert(!checks(public, scheme, message, signature ++ hex("00")))
    assert(!checks(public, scheme, message, Vector()))
  val other = generatePrivateKey(Ed25519Key)
  val signature = signed(other, Ed25519, "m".bytes)
  assert(!checks(generatePrivateKey(Ed25519Key).publicKey, Ed25519, "m".bytes, signature))

@test("Ed25519 and PKCS#1 v1.5 sign the same message the same way twice; ECDSA and PSS differ each time and both check")
determinism()
  for (scheme, key) in schemesAndKeys()
    val a = signed(key, scheme, "same".bytes)
    val b = signed(key, scheme, "same".bytes)
    val deterministic = scheme match
      Ed25519 -> true
      RsaPkcs1Sha256 -> true
      RsaPkcs1Sha384 -> true
      RsaPkcs1Sha512 -> true
      _ -> false
    assertEq(s"$scheme ${a == b}", s"$scheme $deterministic")
    assert(checks(key.publicKey, scheme, "same".bytes, a))
    assert(checks(key.publicKey, scheme, "same".bytes, b))

@test("signature lengths: 64 for Ed25519, the modulus for RSA, DER no longer than 72 and 104 for P-256 and P-384")
signatureLengths()
  for (scheme, key) in schemesAndKeys()
    val length = signed(key, scheme, "x".bytes).length
    val fits = scheme match
      Ed25519 -> length == 64
      EcdsaP256Sha256 -> 8 <= length <= 72
      EcdsaP384Sha384 -> 8 <= length <= 104
      _ -> length == 256
    assert(fits, s"$scheme gave $length bytes")

@test("a scheme for another kind of key is a KeyMismatch, in both directions, never a false verdict")
keyMismatch()
  val keys = [
    generatePrivateKey(Ed25519Key),
    generatePrivateKey(EcP256Key),
    generatePrivateKey(EcP384Key),
    privateOf(RfcRsaPrivate)
  ]
  val schemes = [
    Ed25519, EcdsaP256Sha256, EcdsaP384Sha384, RsaPkcs1Sha256, RsaPkcs1Sha384, RsaPkcs1Sha512, RsaPssSha256,
    RsaPssSha384, RsaPssSha512
  ]
  var mismatches = 0
  for key in keys
    for scheme in schemes
      if !scheme.fits(key.kind) then
        mismatches += 1
        key.sign(scheme, "m".bytes) match
          Err(KeyMismatch(kind, s)) ->
            assert(kind == key.kind)
            assert(s == scheme)
          _ -> fail(s"$key signed with $scheme")
        key.publicKey.verify(scheme, "m".bytes, Vector.fill(64, byte(0))) match
          Err(KeyMismatch(_, _)) -> ()
          _ -> fail(s"$key checked $scheme")
  assertEq(mismatches, 4 * 9 - 9)
  val e = generatePrivateKey(Ed25519Key).sign(RsaPssSha256, "m".bytes).err.getOrElse(fail("no error"))
  assertEq(e.message, "a Ed25519 key does not sign with RSA-PSS SHA-256")

@test("which kinds of key each scheme signs with")
schemeFits()
  assert(Ed25519.fits(Ed25519Key))
  assert(!Ed25519.fits(EcP256Key))
  assert(EcdsaP256Sha256.fits(EcP256Key))
  assert(!EcdsaP256Sha256.fits(EcP384Key))
  assert(EcdsaP384Sha384.fits(EcP384Key))
  assert(!EcdsaP384Sha384.fits(EcP256Key))
  assert(!EcdsaP384Sha384.fits(RsaKey(2048)))
  for scheme in [RsaPkcs1Sha256, RsaPkcs1Sha384, RsaPkcs1Sha512, RsaPssSha256, RsaPssSha384, RsaPssSha512]
    assert(scheme.fits(RsaKey(2048)))
    assert(scheme.fits(RsaKey(4096)))
    assert(!scheme.fits(Ed25519Key))
    assert(!scheme.fits(EcP256Key))

// -- keys ------------------------------------------------------------------------------------------------------

@test("a generated key is of the kind asked for, and two are different keys")
generatedKeys()
  assert(generatePrivateKey(Ed25519Key).kind == Ed25519Key)
  assert(generatePrivateKey(EcP256Key).kind == EcP256Key)
  assert(generatePrivateKey(EcP384Key).kind == EcP384Key)
  val rsa = generatePrivateKey(RsaKey(2048))
  assert(rsa.kind == RsaKey(2048))
  assert(checks(rsa.publicKey, RsaPssSha256, "m".bytes, signed(rsa, RsaPssSha256, "m".bytes)))
  assert(generatePrivateKey(RsaKey(3072)).kind == RsaKey(3072))
  assert(generatePrivateKey(Ed25519Key).publicKey != generatePrivateKey(Ed25519Key).publicKey)
  assert(generatePrivateKey(EcP256Key).publicKey != generatePrivateKey(EcP256Key).publicKey)

@test("a key written as PEM or DER reads back as the same key, private and public, of every kind")
pemAndDerRoundTrip()
  for (_, key) in schemesAndKeys()
    val pem = key.toPem()
    assert(pem.startsWith("-----BEGIN PRIVATE KEY-----\n"))
    assert(pem.endsWith("-----END PRIVATE KEY-----\n"))
    for line in pem.lines
      assert(line.byteLength <= 64)
    val again = privateOf(pem)
    assertEq(toHex(again.toDer()), toHex(key.toDer()))
    assert(again.kind == key.kind)
    assertEq(toHex(privateKeyFromDer(key.toDer()).getOrElse(fail("DER")).toDer()), toHex(key.toDer()))
    val public = key.publicKey
    assert(public.toPem().startsWith("-----BEGIN PUBLIC KEY-----\n"))
    assert(publicOf(public.toPem()) == public)
    assert(publicKeyFromDer(public.toDer()).getOrElse(fail("DER")) == public)
    assert(publicOf(public.toPem()).kind == key.kind)
  assertEq(publicOf(RfcRsaPublic).toPem(), RfcRsaPublic)
  assertEq(privateOf(RfcRsaPrivate).toPem(), RfcRsaPrivate)

@test(
  "PEM is found among other text, after other blocks, with CRLF line ends and indentation, and traditional forms read as PKCS#8"
)
pemLeniency()
  val key = privateOf(RfcEcPrivate)
  assert(privateOf("a note\n" + RfcEcPrivate + "trailing text").publicKey == key.publicKey)
  assert(privateOf(RfcEcPrivate.replace("\n", "\r\n")).publicKey == key.publicKey)
  assert(privateOf(RfcEcPrivate.replace("\n", "\n    ")).publicKey == key.publicKey)
  assert(privateOf(RfcEcPublic + RfcEcPrivate).publicKey == key.publicKey)
  assert(publicOf(RfcEcPrivate + RfcEcPublic) == key.publicKey)
  val traditional = privateOf(EcTraditional)
  assert(traditional.kind == EcP256Key)
  assert(traditional.toPem().startsWith("-----BEGIN PRIVATE KEY-----"))
  assert(checks(traditional.publicKey, EcdsaP256Sha256, "m".bytes, signed(traditional, EcdsaP256Sha256, "m".bytes)))

@test("text with no key, a block cut short, a body that is not base64, and an encrypted key are each refused, with why")
pemRefusals()
  assert(invalidReason(privateKeyFromPem("")).contains("no PEM block"))
  assert(invalidReason(privateKeyFromPem("just words")).contains("no PEM block"))
  assert(invalidReason(privateKeyFromPem(RfcEcPublic)).contains("no PEM block"))
  assert(invalidPublicReason(publicKeyFromPem(RfcEcPrivate)).contains("no PEM block"))
  assert(invalidReason(privateKeyFromPem("-----BEGIN PRIVATE KEY")).contains("not closed"))
  assert(invalidReason(privateKeyFromPem("-----BEGIN PRIVATE KEY-----\nMIGH\n")).contains("no END line"))
  assert(
    invalidReason(
      privateKeyFromPem("-----BEGIN PRIVATE KEY-----\nM!GH\n-----END PRIVATE KEY-----\n")
    ).contains("not base64")
  )
  assert(
    invalidReason(privateKeyFromPem("-----BEGIN PRIVATE KEY-----\n-----END PRIVATE KEY-----\n")).contains("no bytes")
  )
  assert(invalidReason(privateKeyFromPem(EncryptedEd25519)).contains("encrypted"))
  val procType = "-----BEGIN EC PRIVATE KEY-----\nProc-Type: 4,ENCRYPTED\nDEK-Info: AES-128-CBC,00\n\nAAAA\n-----END EC PRIVATE KEY-----\n"
  assert(invalidReason(privateKeyFromPem(procType)).contains("encrypted"))
  // Base64 of bytes that are not a key.
  assert(
    invalidReason(
      privateKeyFromPem("-----BEGIN PRIVATE KEY-----\nAAAA\n-----END PRIVATE KEY-----\n")
    ).contains("not an unencrypted private key")
  )

@test("DER that is empty, cut short, followed by more bytes, or of the other half of a key is refused")
derRefusals()
  val key = privateOf(RfcEcPrivate)
  val der = key.toDer()
  assert(invalidReason(privateKeyFromDer(Vector())).contains("no bytes"))
  assert(invalidReason(privateKeyFromDer(der.slice(0, der.length - 1))).contains("not an unencrypted private key"))
  assert(invalidReason(privateKeyFromDer(der.slice(0, 10))).contains("not an unencrypted private key"))
  assert(invalidReason(privateKeyFromDer(der ++ hex("00"))).contains("bytes follow"))
  assert(invalidReason(privateKeyFromDer(key.publicKey.toDer())).contains("not an unencrypted private key"))
  val spki = key.publicKey.toDer()
  assert(invalidPublicReason(publicKeyFromDer(Vector())).contains("no bytes"))
  assert(invalidPublicReason(publicKeyFromDer(spki.slice(0, spki.length - 1))).contains("not a public key"))
  assert(invalidPublicReason(publicKeyFromDer(spki ++ hex("0000"))).contains("bytes follow"))
  assert(invalidPublicReason(publicKeyFromDer(der)).contains("not a public key"))
  // A P-256 point that is not on the curve: the last byte of y changed.
  assert(publicKeyFromDer(flipped(hex(P256Key), hex(P256Key).length - 1)) is Err(InvalidKey(_)))
  // An Ed25519 key of the wrong length, either half.
  assert(ed25519PrivateKey(Vector.fill(31, byte(1))) is Err(InvalidKey(_)))
  assert(ed25519PrivateKey(Vector.fill(33, byte(1))) is Err(InvalidKey(_)))
  assert(ed25519PublicKey(Vector()) is Err(InvalidKey(_)))
  assert(ed25519PublicKey(Vector.fill(64, byte(1))) is Err(InvalidKey(_)))

@test("keys of kinds not signed with are refused: P-521, secp256k1, Ed448, X25519 and RSA under 2048 bits")
refusedKinds()
  assert(invalidReason(privateKeyFromPem(P521Private)).contains("P-256 and P-384"))
  assert(invalidPublicReason(publicKeyFromPem(P521Public)).contains("P-256 and P-384"))
  assert(invalidReason(privateKeyFromPem(Secp256k1Private)).contains("secp256k1"))
  assert(invalidReason(privateKeyFromPem(Ed448Private)).contains("kind not read"))
  assert(invalidReason(privateKeyFromPem(X25519Private)).contains("kind not read"))
  assert(invalidReason(privateKeyFromPem(Rsa1024Private)).contains("1024 bits, under the 2048"))

@test("only an Ed25519 public key has its 32 bytes to give")
ed25519Bytes()
  val ed = generatePrivateKey(Ed25519Key).publicKey
  assertEq(ed.ed25519Bytes().getOrElse(Vector()).length, 32)
  assert(ed25519PublicKey(ed.ed25519Bytes().getOrElse(Vector())).getOrElse(fail("raw")) == ed)
  assert(generatePrivateKey(EcP256Key).publicKey.ed25519Bytes() is None)
  assert(publicOf(RfcRsaPublic).ed25519Bytes() is None)

@test("a key's text names its kind and shows nothing of the key")
keysDisplayNoMaterial()
  val seed = hex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
  val ed = ed25519PrivateKey(seed).getOrElse(fail("key"))
  assertEq(s"$ed", "PrivateKey(Ed25519)")
  assertEq(s"${ed.publicKey}", "PublicKey(Ed25519)")
  assertEq(s"${privateOf(RfcRsaPrivate)}", "PrivateKey(RSA 2048)")
  assertEq(s"${publicOf(P384Public)}", "PublicKey(ECDSA P-384)")
  assertEq(s"${privateOf(RfcEcPrivate)}", "PrivateKey(ECDSA P-256)")
  assertEq(s"${[ed]}", "[PrivateKey(Ed25519)]")
  assertEq(s"${Some(ed)}", "Some(PrivateKey(Ed25519))")
  assert(!s"$ed".contains("9d61"))

@test("a key kind and a scheme say what they are, and compare by what they are")
kindsAndSchemes()
  assertEq(s"${RsaKey(4096)}", "RSA 4096")
  assertEq(s"$EcP256Key", "ECDSA P-256")
  assert(RsaKey(2048) == RsaKey(2048))
  assert(RsaKey(2048) != RsaKey(3072))
  assert(Ed25519Key != EcP256Key)
  assertEq(s"$RsaPssSha384", "RSA-PSS SHA-384")
  assertEq(s"$RsaPkcs1Sha512", "RSA PKCS#1 v1.5 SHA-512")
  assert(EcdsaP256Sha256 == EcdsaP256Sha256)
  assert(EcdsaP256Sha256 != EcdsaP384Sha384)

@test("a key read once signs and checks from other threads at the same time")
keysAcrossThreads()
  val key = privateOf(RfcEcPrivate)
  val public = key.publicKey
  val threads = Vector.tabulate(4, i -> spawn(() -> countGood(key, public, i)))
  for t in threads
    assertEq(t.join(), 25)

// How many of 25 messages `key` signs that `public` then takes.
countGood(key: PrivateKey, public: PublicKey, thread: int) -> int
  var good = 0
  for j in 0 ..< 25
    val message = s"thread $thread message $j".bytes
    if public.verify(
      EcdsaP256Sha256,
      message,
      key.sign(EcdsaP256Sha256, message).getOrElse(Vector())
    ).getOrElse(false) then good += 1
  good
