@test("a fixed-width ECDSA signature checks once made DER, and one of the wrong width makes none")
ecdsaP256FixedWycheproof()
  val key = publicOfDer(P256Key)
  for (tc, msg, sig, valid) in P256FixedVectors
    val verdict = ecdsaDerSignature(hex(sig), EcdsaP256Sha256) match
      Some(der) -> checks(key, EcdsaP256Sha256, hex(msg), der)
      None -> false
    assertEq(s"$tc $verdict", s"$tc $valid")
  assert(ecdsaDerSignature(hex(P256FixedVectors(1).2), EcdsaP256Sha256) is None)

val P384Key = "3076301006072a8648ce3d020106052b81040022036200042da57dda1089276a543f9ffdac0bff0d976cad71eb7280e7d9bfd9fee4bdb2f20f47ff888274389772d98cc5752138aa4b6d054d69dcf3e25ec49df870715e34883b1836197d76f8ad962e78f6571bbc7407b0d6091f9e4d88f014274406174f"

