// `avin.crypto`'s signatures and keys, against answers nobody here chose: RFC 8032's Ed25519 keys and
// signatures, RFC 7515's RS256 and ES256 examples, and Wycheproof's verification vectors for Ed25519,
// ECDSA over P-256 and P-384 (DER and fixed-width), RSA PKCS#1 v1.5 and RSA-PSS, each with its
// malformed, malleated and forged signatures. Then every scheme round trips with a generated key,
// keys move through PEM and DER both ways, every kind a key can wrongly be is refused, and a key's
// text shows nothing of it.
import avin.crypto.{KeyKind, Ed25519Key, EcP256Key, EcP384Key, RsaKey}
import avin.crypto.{SignatureScheme, Ed25519, EcdsaP256Sha256, EcdsaP384Sha384}
import avin.crypto.{RsaPkcs1Sha256, RsaPkcs1Sha384, RsaPkcs1Sha512, RsaPssSha256, RsaPssSha384, RsaPssSha512}
import avin.crypto.{PrivateKey, PublicKey, CryptoError, InvalidKey, KeyMismatch}
import avin.crypto.{privateKeyFromPem, privateKeyFromDer, publicKeyFromPem, publicKeyFromDer, generatePrivateKey}
import avin.crypto.{ed25519PrivateKey, ed25519PublicKey, ecdsaFixedSignature, ecdsaDerSignature}
import avin.encoding.{fromHex, toHex, fromBase64Url}
import avin.threads.spawn

// The bytes `text` writes in hexadecimal.
hex(text: string) -> Vector[byte] = fromHex(text).getOrElse(fail(s"not hexadecimal: $text"))

// The key in `pem`, which the test knows to be one.
privateOf(pem: string) -> PrivateKey = privateKeyFromPem(pem).getOrElse(fail("a fixture that is not a private key"))

publicOf(pem: string) -> PublicKey = publicKeyFromPem(pem).getOrElse(fail("a fixture that is not a public key"))

publicOfDer(der: string) -> PublicKey = publicKeyFromDer(hex(der)).getOrElse(fail("a fixture that is not a public key"))

// The signature `key` makes, which the test knows it makes.
signed(key: PrivateKey, scheme: SignatureScheme, message: Vector[byte]) -> Vector[byte] =
  key.sign(scheme, message).getOrElse(fail(s"$key did not sign with $scheme"))

// Whether `key` takes `signature` over `message`, which the test knows to be a question it can ask.
checks(key: PublicKey, scheme: SignatureScheme, message: Vector[byte], signature: Vector[byte]) -> bool =
  key.verify(scheme, message, signature) match
    Ok(verdict) -> verdict
    Err(e) -> fail(s"$key could not check $scheme: ${e.message}")

// The reason an `InvalidKey` gives, or a failure.
invalidReason(r: Result[PrivateKey, CryptoError]) -> string = r match
  Err(InvalidKey(reason)) -> reason
  Err(e) -> fail(s"not an InvalidKey: ${e.message}")
  Ok(k) -> fail(s"read $k")

invalidPublicReason(r: Result[PublicKey, CryptoError]) -> string = r match
  Err(InvalidKey(reason)) -> reason
  Err(e) -> fail(s"not an InvalidKey: ${e.message}")
  Ok(k) -> fail(s"read $k")

// `bytes` with the byte at `at` changed.
flipped(bytes: Vector[byte], at: int) -> Vector[byte] =
  Vector.tabulate(bytes.length, i -> if i == at then bytes(i) ^ byte(1) else bytes(i))

