// `avin.crypto.password`: Argon2 against RFC 9106's vectors for all three variants and the reference
// implementation's own vectors (versions 1.3 and 1.0), PHC strings written, read and refused,
// `hashPassword` and `verifyPassword` round trips (Unicode, empty, bytes, a secret), `needsRehash`
// for every parameter, verification limits, bcrypt against crypt_blowfish's vectors (`2a`, `2b`, `2y`,
// 8-bit keys, the 72-byte cut, the empty key, a zero byte) and every malformed shape.
import avin.crypto.password.{argon2, hashPassword, verifyPassword, needsRehash, parseArgon2Hash}
import avin.crypto.password.{Argon2Params, Argon2Hash, Argon2Variant, Argon2d, Argon2i, Argon2id}
import avin.crypto.password.{PasswordLimits, PasswordHashError, Malformed, Unsupported, OverLimit, Failed}
import avin.encoding.{fromHex, toHex}

// `repeated(b, count)`, `count` copies of the byte `b`, is the one `crypto.avin` declares: the files of
// `library/tests` are one program.

// The bytes `hex` spells.
hexBytes(text: string) -> Vector[byte] = fromHex(text).getOrElse(Vector[byte]())

// RFC 9106 §5's parameters: 32 KiB, three passes, four lanes, a 32-byte tag.
rfcParams(variant: Argon2Variant) -> Argon2Params = Argon2Params(variant, 32, 3, 4, 32, 16)

// RFC 9106 §5's tag for `variant`, version 1.3: password 32 × 01, salt 16 × 02, secret 8 × 03,
// associated data 12 × 04.
rfcTag(variant: Argon2Variant) -> string =
  toHex(argon2(repeated(1, 32), repeated(2, 16), rfcParams(variant), repeated(3, 8), repeated(4, 12)))

// Whether `r` is a malformed hash.
malformed(r: Result[bool, PasswordHashError]) -> bool = r is Err(Malformed(_))

// Whether parsing `encoded` refuses it as malformed.
refused(encoded: string) -> bool = parseArgon2Hash(encoded) is Err(Malformed(_))

// A small, quick setting for round trips.
val Quick = Argon2Params(Argon2id, 64, 1, 1, 32, 16)

@test("Argon2d, Argon2i and Argon2id give RFC 9106's test vectors")
rfc9106()
  assertEq(rfcTag(Argon2d), "512b391b6f1162975371d30919734294f868e3be3984f3c1a13a4db9fabe4acb")
  assertEq(rfcTag(Argon2i), "c814d9d1dc7f37aa13f0d77f2494bda1c8de6b016dd388d29952a4c4672b6ce8")
  assertEq(rfcTag(Argon2id), "0d640df58d78766c08c037a34a8b53c9d01ef0452d75b65eb52520e96b01e659")

@test("RFC 9106's vectors for version 1.0 check through a PHC string with v=16, and one with no v")
rfc9106Version10()
  // Version 1.0 hashes are read, never written: these are the reference implementation's own known
  // answers, without the secret and associated data, which a PHC string does not carry.
  val stored = "$argon2i$m=65536,t=2,p=1$c29tZXNhbHQ$9sTbSlTio3Biev89thdrlKKiCaYsjjYVJxGAL3swxpQ"
  assertEq(verifyPassword("password", stored), Ok(true))
  assertEq(
    verifyPassword("password", "$argon2i$v=16$m=65536,t=2,p=1$c29tZXNhbHQ$9sTbSlTio3Biev89thdrlKKiCaYsjjYVJxGAL3swxpQ"),
    Ok(true)
  )
  assertEq(
    verifyPassword("password", "$argon2i$m=256,t=2,p=1$c29tZXNhbHQ$/U3YPXYsSb3q9XxHvc0MLxur+GP960kN9j7emXX8zwY"),
    Ok(true)
  )
  assertEq(
    verifyPassword("password", "$argon2i$m=256,t=2,p=2$c29tZXNhbHQ$tsEVYKap1h6scGt5ovl9aLRGOqOth+AMB+KwHpDFZPs"),
    Ok(true)
  )
  assertEq(verifyPassword("passwore", stored), Ok(false))
  assertEq(parseArgon2Hash(stored).map(h -> h.version), Ok(16))
  // The same tag read as version 1.3 is a different computation.
  assertEq(
    verifyPassword("password", "$argon2i$v=19$m=65536,t=2,p=1$c29tZXNhbHQ$9sTbSlTio3Biev89thdrlKKiCaYsjjYVJxGAL3swxpQ"),
    Ok(false)
  )

@test("Argon2i and Argon2id version 1.3 give the reference implementation's vectors, raw and as PHC strings")
referenceVectors()
  val salt = "somesalt".bytes
  val i = Argon2Params(Argon2i, 256, 2, 1, 32, 8)
  assertEq(toHex(argon2("password".bytes, salt, i)), "89e9029f4637b295beb027056a7336c414fadd43f6b208645281cb214a56452f")
  assertEq(
    toHex(argon2("password".bytes, salt, Argon2Params(Argon2i, 256, 2, 2, 32, 8))),
    "4ff5ce2769a1d7f4c8a491df09d41a9fbe90e5eb02155a13e4c01e20cd4eab61"
  )
  assertEq(
    toHex(argon2("password".bytes, salt, Argon2Params(Argon2id, 256, 2, 1, 32, 8))),
    "9dfeb910e80bad0311fee20f9c0e2b12c17987b4cac90c2ef54d5b3021c68bfe"
  )
  assertEq(
    toHex(argon2("password".bytes, salt, Argon2Params(Argon2id, 256, 2, 2, 32, 8))),
    "6d093c501fd5999645e0ea3bf620d7b8be7fd2db59c20d9fff9539da2bf57037"
  )
  assertEq(
    toHex(argon2("password".bytes, salt, Argon2Params(Argon2id, 65536, 1, 1, 32, 8))),
    "f6a5adc1ba723dddef9b5ac1d464e180fcd9dffc9d1cbf76cca2fed795d9ca98"
  )
  assertEq(
    toHex(argon2("password".bytes, salt, Argon2Params(Argon2id, 65536, 2, 1, 32, 8))),
    "09316115d5cf24ed5a15a31a3ba326e5cf32edc24702987c02b6566f61913cf7"
  )
  assertEq(
    toHex(argon2("password".bytes, salt, Argon2Params(Argon2id, 65536, 4, 1, 32, 8))),
    "9025d48e68ef7395cca9079da4c4ec3affb3c8911fe4f86d1a2520856f63172c"
  )
  assertEq(
    toHex(argon2("differentpassword".bytes, salt, Argon2Params(Argon2id, 65536, 2, 1, 32, 8))),
    "0b84d652cf6b0c4beaef0dfe278ba6a80df6696281d7e0d2891b817d8c458fde"
  )
  assertEq(
    toHex(argon2("password".bytes, "diffsalt".bytes, Argon2Params(Argon2id, 65536, 2, 1, 32, 8))),
    "bdf32b05ccc42eb15d58fd19b1f856b113da1e9a5874fdcc544308565aa8141c"
  )
  assertEq(
    verifyPassword("password", "$argon2i$v=19$m=256,t=2,p=1$c29tZXNhbHQ$iekCn0Y3spW+sCcFanM2xBT63UP2sghkUoHLIUpWRS8"),
    Ok(true)
  )
  assertEq(
    verifyPassword("password", "$argon2i$v=19$m=256,t=2,p=2$c29tZXNhbHQ$T/XOJ2mh1/TIpJHfCdQan76Q5esCFVoT5MAeIM1Oq2E"),
    Ok(true)
  )
  assertEq(
    verifyPassword("password", "$argon2id$v=19$m=256,t=2,p=1$c29tZXNhbHQ$nf65EOgLrQMR/uIPnA4rEsF5h7TKyQwu9U1bMCHGi/4"),
    Ok(true)
  )
  assertEq(
    verifyPassword("password", "$argon2id$v=19$m=256,t=2,p=2$c29tZXNhbHQ$bQk8UB/VmZZF4Oo79iDXuL5/0ttZwg2f/5U52iv1cDc"),
    Ok(true)
  )
  assertEq(
    verifyPassword("password", "$argon2id$v=19$m=65536,t=2,p=1$ZGlmZnNhbHQ$vfMrBczELrFdWP0ZsfhWsRPaHppYdP3MVEMIVlqoFBw"),
    Ok(true)
  )
  // The reference's mismatch vector: the hash of "passwore".
  assertEq(
    verifyPassword("password", "$argon2i$v=19$m=65536,t=2,p=1$c29tZXNhbHQ$8iIuixkI73Js3G1uMbezQXD0b8LG4SXGsOwoQkdAQIM"),
    Ok(false)
  )

@test("Argon2's tag length, secret and associated data each change the tag; a longer tag is not a prefix extension")
argon2Inputs()
  val p = Argon2Params(Argon2id, 64, 1, 1, 32, 16)
  val base = argon2("pw".bytes, repeated(7, 16), p)
  assertEq(base.length, 32)
  assertEq(argon2("pw".bytes, repeated(7, 16), Argon2Params(Argon2id, 64, 1, 1, 4, 16)).length, 4)
  val longer = argon2("pw".bytes, repeated(7, 16), Argon2Params(Argon2id, 64, 1, 1, 100, 16))
  assertEq(longer.length, 100)
  assert(longer.take(32) != base)
  assert(argon2("pw".bytes, repeated(7, 16), p, "k".bytes) != base)
  assert(argon2("pw".bytes, repeated(7, 16), p, Vector[byte](), "ad".bytes) != base)
  assert(argon2("pw".bytes, repeated(7, 17), p) != base)
  assert(argon2("pX".bytes, repeated(7, 16), p) != base)
  assertEq(argon2("pw".bytes, repeated(7, 16), p), base)
  // The empty password, eight bytes of salt (the least), and every byte value.
  assertEq(argon2(Vector[byte](), repeated(0, 8), p).length, 32)
  assertEq(argon2(Vector.tabulate(256, i -> byte(i)), Vector.tabulate(256, i -> byte(255 - i)), p).length, 32)
  // The memory asked for is hashed into the first block even where the blocks used round it down
  // (67 KiB uses 64 blocks), so 67 KiB is not 64.
  assert(argon2("pw".bytes, repeated(7, 16), Argon2Params(Argon2id, 67, 1, 1, 32, 16)) != base)
  // Eight lanes at the least memory, 64 KiB.
  assertEq(argon2("pw".bytes, repeated(7, 16), Argon2Params(Argon2id, 64, 1, 8, 32, 16)).length, 32)

@test("hashPassword writes an Argon2id PHC string with OWASP's defaults, a fresh salt, and one verifyPassword accepts")
hashAndVerify()
  val stored = hashPassword("correct horse battery staple")
  assert(stored.startsWith("$argon2id$v=19$m=19456,t=2,p=1$"), stored)
  val h = parseArgon2Hash(stored).getOrElse(Argon2Hash(Argon2d, 0, 0, 0, 0, Vector[byte](), Vector[byte]()))
  assertEq(h.variant, Argon2id)
  assertEq(h.version, 19)
  assertEq(h.memoryKiB, 19456)
  assertEq(h.passes, 2)
  assertEq(h.lanes, 1)
  assertEq(h.salt.length, 16)
  assertEq(h.hash.length, 32)
  assertEq(stored.byteLength, 97)
  assertEq(verifyPassword("correct horse battery staple", stored), Ok(true))
  assertEq(verifyPassword("correct horse battery stapl", stored), Ok(false))
  assertEq(verifyPassword("correct horse battery staplee", stored), Ok(false))
  assertEq(verifyPassword("", stored), Ok(false))
  assertEq(needsRehash(stored), Ok(false))
  // Two hashes of one password differ in their salt, and both verify.
  val again = hashPassword("correct horse battery staple")
  assert(again != stored)
  assertEq(verifyPassword("correct horse battery staple", again), Ok(true))

@test("hashPassword and verifyPassword take Unicode, the empty password, raw bytes, and text as its UTF-8 bytes")
hashKinds()
  val unicode = hashPassword("pässwörd ✓ 日本語 😀", Quick)
  assertEq(verifyPassword("pässwörd ✓ 日本語 😀", unicode), Ok(true))
  assertEq(verifyPassword("pässwörd ✓ 日本語 😀".bytes, unicode), Ok(true))
  // NFC and NFD spell one word in two byte sequences, so they are two passwords.
  assertEq(verifyPassword("passwo\u{308}rd", hashPassword("passw\u{f6}rd", Quick)), Ok(false))
  val empty = hashPassword("", Quick)
  assertEq(verifyPassword("", empty), Ok(true))
  assertEq(verifyPassword(" ", empty), Ok(false))
  val raw = Vector.tabulate(256, i -> byte(i))
  val bytes = hashPassword(raw, Quick)
  assertEq(verifyPassword(raw, bytes), Ok(true))
  assertEq(verifyPassword(raw.take(255), bytes), Ok(false))
  // A zero byte is part of an Argon2 password: it is not where the password ends.
  assertEq(verifyPassword("ab", hashPassword("ab\u{0}cd", Quick)), Ok(false))
  assertEq(verifyPassword("ab\u{0}cd", hashPassword("ab\u{0}cd", Quick)), Ok(true))
  val tenThousand = "x".repeat(10000)
  assertEq(verifyPassword(tenThousand, hashPassword(tenThousand, Quick)), Ok(true))
  assertEq(verifyPassword(tenThousand.take(9999), hashPassword(tenThousand, Quick)), Ok(false))

@test("a secret is needed to verify a hash made with it, and is not stored in the string")
secrets()
  val pepper = "server pepper".bytes
  val stored = hashPassword("pw", Quick, pepper)
  assert(!stored.contains("server"))
  assertEq(verifyPassword("pw", stored, pepper), Ok(true))
  assertEq(verifyPassword("pw", stored), Ok(false))
  assertEq(verifyPassword("pw", stored, "server peppeR".bytes), Ok(false))
  assertEq(verifyPassword("pw", hashPassword("pw", Quick), pepper), Ok(false))

@test("hashPassword writes every variant, cost and length it is given")
hashParams()
  val p = Argon2Params(Argon2i, 128, 3, 2, 64, 32)
  val stored = hashPassword("pw", p)
  assert(stored.startsWith("$argon2i$v=19$m=128,t=3,p=2$"), stored)
  val h = parseArgon2Hash(stored).getOrElse(Argon2Hash(Argon2d, 0, 0, 0, 0, Vector[byte](), Vector[byte]()))
  assertEq(h.salt.length, 32)
  assertEq(h.hash.length, 64)
  assertEq(verifyPassword("pw", stored), Ok(true))
  assertEq(needsRehash(stored, p), Ok(false))
  val d = hashPassword("pw", Argon2Params(Argon2d, 64, 1, 1, 4, 8))
  assert(d.startsWith("$argon2d$v=19$m=64,t=1,p=1$"), d)
  assertEq(verifyPassword("pw", d), Ok(true))
  assertEq(parseArgon2Hash(d).map(h -> (h.salt.length, h.hash.length)), Ok((8, 4)))

@test("needsRehash answers true for any parameter that differs, an older version, and every bcrypt hash")
rehash()
  val p = Argon2Params(Argon2id, 64, 2, 1, 32, 16)
  val stored = hashPassword("pw", p)
  assertEq(needsRehash(stored, p), Ok(false))
  assertEq(needsRehash(stored), Ok(true))
  assertEq(needsRehash(stored, Argon2Params(Argon2i, 64, 2, 1, 32, 16)), Ok(true))
  assertEq(needsRehash(stored, Argon2Params(Argon2id, 128, 2, 1, 32, 16)), Ok(true))
  assertEq(needsRehash(stored, Argon2Params(Argon2id, 32, 2, 1, 32, 16)), Ok(true))
  assertEq(needsRehash(stored, Argon2Params(Argon2id, 64, 3, 1, 32, 16)), Ok(true))
  assertEq(needsRehash(stored, Argon2Params(Argon2id, 64, 1, 1, 32, 16)), Ok(true))
  assertEq(needsRehash(stored, Argon2Params(Argon2id, 64, 2, 2, 32, 16)), Ok(true))
  assertEq(needsRehash(stored, Argon2Params(Argon2id, 64, 2, 1, 16, 16)), Ok(true))
  assertEq(needsRehash(stored, Argon2Params(Argon2id, 64, 2, 1, 32, 24)), Ok(true))
  assertEq(
    needsRehash("$argon2id$m=64,t=2,p=1$c29tZXNhbHRzb21lc2FsdA$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc", p),
    Ok(true)
  )
  assertEq(needsRehash("$2b$05$/OK.fbVrR/bpIqNJ5ianF.CE5elHaaO4EbggVDjb8P19RukzXSM3e"), Ok(true))
  assert(needsRehash("$2b$05$short") is Err(Malformed(_)))
  assertEq(
    needsRehash("$scrypt$ln=16,r=8,p=1$aM15713r3Xsvxbi31lqr1Q$nFNh2CVHVjNldFVKDHDlm4CbdRSCdEBsjjJxD+iCs5E"),
    Err(Unsupported("scrypt"))
  )
  assert(needsRehash("") is Err(Malformed(_)))

@test("a PHC string read and written again is the same string")
phcRoundTrip()
  val all = [
    "$argon2i$v=19$m=256,t=2,p=1$c29tZXNhbHQ$iekCn0Y3spW+sCcFanM2xBT63UP2sghkUoHLIUpWRS8",
    "$argon2id$v=19$m=65536,t=2,p=1$ZGlmZnNhbHQ$vfMrBczELrFdWP0ZsfhWsRPaHppYdP3MVEMIVlqoFBw",
    "$argon2d$v=19$m=8,t=1,p=1$AAAAAAAAAAA$AAAAAA",
    "$argon2id$v=19$m=2147483647,t=2147483647,p=16777215$c29tZXNhbHRz$c29tZXNhbHRzYQ",
    "$argon2id$v=19$m=134217720,t=1,p=16777215$c29tZXNhbHRz$c29tZXNhbHRzYQ",
    "$argon2id$v=16$m=8,t=1,p=1$c29tZXNhbHQ$c29tZQ"
  ]
  for s in all
    assertEq(parseArgon2Hash(s).map(h -> h.encode), Ok(s))
  // A string with no `v=` is version 16, and is written back with it.
  assertEq(
    parseArgon2Hash("$argon2i$m=256,t=2,p=1$c29tZXNhbHQ$/U3YPXYsSb3q9XxHvc0MLxur+GP960kN9j7emXX8zwY").map(h -> h.encode),
    Ok("$argon2i$v=16$m=256,t=2,p=1$c29tZXNhbHQ$/U3YPXYsSb3q9XxHvc0MLxur+GP960kN9j7emXX8zwY")
  )
  val h = Argon2Hash(Argon2id, 19, 19456, 2, 1, hexBytes("000102030405060708"), hexBytes("ff"))
  assertEq(h.encode, "$argon2id$v=19$m=19456,t=2,p=1$AAECAwQFBgcI$/w")
  assertEq(
    Argon2Hash(Argon2d, 19, 8, 1, 1, repeated(255, 9), repeated(0, 5)).encode,
    "$argon2d$v=19$m=8,t=1,p=1$////////////$AAAAAAA"
  )
  assertEq(
    Argon2Hash(Argon2d, 19, 8, 1, 1, repeated(255, 10), repeated(0, 6)).encode,
    "$argon2d$v=19$m=8,t=1,p=1$/////////////w$AAAAAAAA"
  )
  assertEq(Argon2id.name, "argon2id")
  assertEq(Argon2i.name, "argon2i")
  assertEq(Argon2d.name, "argon2d")

@test("PHC strings with a missing or extra field, a bad number or a bad base64 field are malformed")
phcMalformed()
  val good = "$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"
  assert(parseArgon2Hash(good) is Ok(_))
  assert(refused(""))
  assert(refused("$"))
  assert(refused("argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=64,t=1,p=1c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHQc29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g$"))
  assert(refused("$argon2id$v=19$m=64,t=1,p=1$$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$$m=64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHQ"))
  // The costs: order, names, count, extra fields.
  assert(refused("$argon2id$v=19$t=1,m=64,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=64,t=1$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=64,t=1,p=1,keyid=AAAA$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$M=64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=64,t=1,p=1,$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m 64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  // The numbers: no sign, no leading zero, no space, ten digits at most, and within range.
  assert(refused("$argon2id$v=019$m=64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=+19$m=64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=064,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=-64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m= 64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=6.4,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=64,t=00000000001,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=64,t=99999999999,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=4294967295,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=2147483648,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=64,t=2147483648,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=٦٤,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  // The costs Argon2 cannot compute with.
  assert(refused("$argon2id$v=19$m=64,t=0,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=64,t=1,p=0$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=7,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=15,t=1,p=2$c29tZXNhbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=200000000,t=1,p=16777216$c29tZXNhbHQ$c29tZWhhc2g"))
  // Salt and hash: at least 8 and 4 bytes, unpadded standard base64, canonical.
  assert(refused("$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbA$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHQ$c29t"))
  assert(refused("$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHQ$"))
  assert(refused("$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHQ=$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g="))
  assert(refused("$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHR$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2h"))
  assert(refused("$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2gAA"))
  assert(refused("$argon2id$v=19$m=64,t=1,p=1$c29tZX-hbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=64,t=1,p=1$c29tZX_hbHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=64,t=1,p=1$c29tZXNh bHQ$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHQé$c29tZWhhc2g"))
  assert(refused("$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHQ\n$c29tZWhhc2g"))
  // verifyPassword gives the same refusals, computing nothing.
  assert(malformed(verifyPassword("pw", "$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHQ")))
  assert(malformed(verifyPassword("pw", "")))
  assert(malformed(verifyPassword("pw", "plain text")))
  assert(malformed(verifyPassword("pw", "$")))

@test("another scheme, an Argon2 variant this does not know and an Argon2 version other than 16 and 19 are unsupported")
phcUnsupported()
  assertEq(parseArgon2Hash("$argon2x$v=19$m=64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"), Err(Unsupported("argon2x")))
  assertEq(parseArgon2Hash("$Argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"), Err(Unsupported("Argon2id")))
  assertEq(parseArgon2Hash("$argon2$v=19$m=64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"), Err(Unsupported("argon2")))
  assertEq(
    parseArgon2Hash("$argon2id$v=20$m=64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"),
    Err(Unsupported("argon2id version 20"))
  )
  assertEq(
    parseArgon2Hash("$argon2id$v=0$m=64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"),
    Err(Unsupported("argon2id version 0"))
  )
  assertEq(
    parseArgon2Hash("$argon2id$v=18$m=64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"),
    Err(Unsupported("argon2id version 18"))
  )
  assertEq(
    parseArgon2Hash("$argon2id$v=9999999999$m=64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"),
    Err(Unsupported("argon2id version 9999999999"))
  )
  assertEq(parseArgon2Hash("$argon2d$v=16$m=64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g").map(h -> h.version), Ok(16))
  assertEq(
    verifyPassword("pw", "$scrypt$ln=16,r=8,p=1$aM15713r3Xsvxbi31lqr1Q$nFNh2CVHVjNldFVKDHDlm4CbdRSCdEBsjjJxD+iCs5E"),
    Err(Unsupported("scrypt"))
  )
  assertEq(
    verifyPassword("pw", "$pbkdf2-sha256$29000$N2ZMyRlj7J0zBuB8T6m1lg$sLK.FATqH9JW3rq6.mX7gHnsKKDdbpYwVgE5nsoCLkg"),
    Err(Unsupported("pbkdf2-sha256"))
  )
  assertEq(verifyPassword("pw", "$1$saltsalt$qjXMvbEw8oaL.CzflDugX/"), Err(Unsupported("1")))
  assertEq(
    verifyPassword(
      "pw",
      "$6$saltsalt$qFmFH.bQmmtXzyBY0s9v7Oicd2z4XSIecDzlB5KiA2/jctKu9YterLp8wwnSq.qc.eoxqOmSuNp2xS0ktL3nh/"
    ),
    Err(Unsupported("6"))
  )

@test("verifyPassword refuses a hash over its limits before computing anything, and takes it under looser limits")
limits()
  val big = "$argon2id$v=19$m=2097152,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g"
  assertEq(verifyPassword("pw", big), Err(OverLimit("m", 2097152, 1048576)))
  assertEq(verifyPassword("pw", "$argon2id$v=19$m=64,t=33,p=1$c29tZXNhbHQ$c29tZWhhc2g"), Err(OverLimit("t", 33, 32)))
  assertEq(verifyPassword("pw", "$argon2id$v=19$m=256,t=1,p=17$c29tZXNhbHQ$c29tZWhhc2g"), Err(OverLimit("p", 17, 16)))
  assertEq(
    verifyPassword("pw", "$2b$17$/OK.fbVrR/bpIqNJ5ianF.CE5elHaaO4EbggVDjb8P19RukzXSM3e"),
    Err(OverLimit("cost", 17, 16))
  )
  // At each default limit, the hash is computed (and is wrong).
  assertEq(verifyPassword("pw", "$argon2id$v=19$m=64,t=32,p=1$c29tZXNhbHQ$c29tZWhhc2g"), Ok(false))
  assertEq(verifyPassword("pw", "$argon2id$v=19$m=128,t=1,p=16$c29tZXNhbHQ$c29tZWhhc2g"), Ok(false))
  // Tighter limits refuse what the defaults take.
  val tight = PasswordLimits(64, 1, 1, 4)
  assertEq(
    verifyPassword("pw", "$argon2id$v=19$m=65,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g", limits = tight),
    Err(OverLimit("m", 65, 64))
  )
  assertEq(
    verifyPassword("pw", "$argon2id$v=19$m=64,t=2,p=1$c29tZXNhbHQ$c29tZWhhc2g", limits = tight),
    Err(OverLimit("t", 2, 1))
  )
  assertEq(
    verifyPassword("pw", "$argon2id$v=19$m=64,t=1,p=2$c29tZXNhbHQ$c29tZWhhc2g", limits = tight),
    Err(OverLimit("p", 2, 1))
  )
  assertEq(
    verifyPassword("U*U", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW", limits = tight),
    Err(OverLimit("cost", 5, 4))
  )
  assertEq(verifyPassword("pw", "$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHQ$c29tZWhhc2g", limits = tight), Ok(false))
  // Looser limits take what the defaults refuse.
  val stored = hashPassword("pw", Argon2Params(Argon2id, 64, 33, 1, 32, 16))
  assert(verifyPassword("pw", stored) is Err(OverLimit("t", _, _)))
  assertEq(verifyPassword("pw", stored, limits = PasswordLimits(maxPasses = 40)), Ok(true))

@test(
  "bcrypt verification gives crypt_blowfish's vectors for 2a, 2b and 2y, 8-bit keys, the 72-byte cut and the empty key"
)
bcryptVectors()
  assertEq(verifyPassword("U*U", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW"), Ok(true))
  assertEq(verifyPassword("U*U*", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.VGOzA784oUp/Z0DY336zx7pLYAy0lwK"), Ok(true))
  assertEq(verifyPassword("U*U*U", "$2a$05$XXXXXXXXXXXXXXXXXXXXXOAcXxm9kjPGEMsLznoKqmqw7tc8WCx4a"), Ok(true))
  assertEq(
    verifyPassword(
      "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789chars after 72 are ignored",
      "$2a$05$abcdefghijklmnopqrstuu5s2v8.iXieOjg/.AySBTTZIIVFJeBui"
    ),
    Ok(true)
  )
  assertEq(verifyPassword("", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.7uG0VCzI2bS7j6ymqJi9CdcdxiRTWNy"), Ok(true))
  val ffffa3 = [byte(0xff), byte(0xff), byte(0xa3)]
  assertEq(verifyPassword(ffffa3, "$2y$05$/OK.fbVrR/bpIqNJ5ianF.CE5elHaaO4EbggVDjb8P19RukzXSM3e"), Ok(true))
  assertEq(verifyPassword(ffffa3, "$2b$05$/OK.fbVrR/bpIqNJ5ianF.CE5elHaaO4EbggVDjb8P19RukzXSM3e"), Ok(true))
  assertEq(verifyPassword(ffffa3, "$2a$05$/OK.fbVrR/bpIqNJ5ianF.nqd1wy.pTMdcvrRWxyiGL2eMz.2a85."), Ok(true))
  val a3 = [byte(0xa3)]
  assertEq(verifyPassword(a3, "$2y$05$/OK.fbVrR/bpIqNJ5ianF.Sa7shbm4.OzKpvFnX1pQLmQW96oUlCq"), Ok(true))
  assertEq(verifyPassword(a3, "$2a$05$/OK.fbVrR/bpIqNJ5ianF.Sa7shbm4.OzKpvFnX1pQLmQW96oUlCq"), Ok(true))
  assertEq(verifyPassword(a3, "$2b$05$/OK.fbVrR/bpIqNJ5ianF.Sa7shbm4.OzKpvFnX1pQLmQW96oUlCq"), Ok(true))
  val mixed = [
    byte(0xff),
    byte(0xa3),
    byte(0x33),
    byte(0x34),
    byte(0xff),
    byte(0xff),
    byte(0xff),
    byte(0xa3),
    byte(0x33),
    byte(0x34),
    byte(0x35)
  ]
  assertEq(verifyPassword(mixed, "$2y$05$/OK.fbVrR/bpIqNJ5ianF.o./n25XVfn6oAPaUvHe.Csk4zRfsYPi"), Ok(true))
  assertEq(verifyPassword(mixed, "$2a$05$/OK.fbVrR/bpIqNJ5ianF.ZC1JEJ8Z4gPfpe1JOr/oyPXTWl9EFd."), Ok(true))
  val aa = repeated(0xaa, 72) ++ "chars after 72 are ignored as usual".bytes
  assertEq(verifyPassword(aa, "$2a$05$/OK.fbVrR/bpIqNJ5ianF.swQOIzjOiJ9GHEPuhEkvqrUyvWhEMx6"), Ok(true))
  assertEq(verifyPassword(repeated(0xaa, 72), "$2a$05$/OK.fbVrR/bpIqNJ5ianF.swQOIzjOiJ9GHEPuhEkvqrUyvWhEMx6"), Ok(true))
  assertEq(
    verifyPassword(repeated(0xaa, 71), "$2a$05$/OK.fbVrR/bpIqNJ5ianF.swQOIzjOiJ9GHEPuhEkvqrUyvWhEMx6"),
    Ok(false)
  )
  val a55 = Vector.tabulate(72, i -> byte(if i % 2 == 0 then 0xaa else 0x55))
  assertEq(verifyPassword(a55, "$2a$05$/OK.fbVrR/bpIqNJ5ianF.R9xrDjiycxMbQE2bp.vgqlYpW5wx2yy"), Ok(true))
  val a5f = Vector.tabulate(72, i -> byte(if i % 3 == 0 then 0x55 elif i % 3 == 1 then 0xaa else 0xff))
  assertEq(verifyPassword(a5f, "$2a$05$/OK.fbVrR/bpIqNJ5ianF.9tQZzcJfm3uj2NvJ/n5xkhpqLrMpWCe"), Ok(true))

@test(
  "bcrypt answers false for a wrong password, reads a key up to its first zero byte, and ignores the salt's unused bits"
)
bcryptEdges()
  val stored = "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW"
  assertEq(verifyPassword("U*u", stored), Ok(false))
  assertEq(verifyPassword("U*U ", stored), Ok(false))
  assertEq(verifyPassword("", stored), Ok(false))
  // bcrypt's key is a C string: what follows a zero byte is not read.
  assertEq(verifyPassword("U*U\u{0}anything", stored), Ok(true))
  // A secret means nothing to bcrypt.
  assertEq(verifyPassword("U*U", stored, "pepper".bytes), Ok(true))
  // The 22nd salt character carries four unused bits: `.` and `/` spell one salt.
  assertEq(verifyPassword("U*U", "$2a$05$CCCCCCCCCCCCCCCCCCCCC/E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW"), Ok(true))
  // One character of the hash changed.
  assertEq(verifyPassword("U*U", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeX"), Ok(false))

@test("bcrypt's 2x, 2 and other minor versions are unsupported, and every other malformed shape is refused")
bcryptMalformed()
  assertEq(
    verifyPassword([byte(0xa3)], "$2x$05$/OK.fbVrR/bpIqNJ5ianF.CE5elHaaO4EbggVDjb8P19RukzXSM3e"),
    Err(Unsupported("2x"))
  )
  assertEq(verifyPassword("pw", "$2$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW"), Err(Unsupported("2")))
  assertEq(verifyPassword("pw", "$2c$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW"), Err(Unsupported("2c")))
  assertEq(verifyPassword("pw", "$2z$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW"), Err(Unsupported("2z")))
  assertEq(verifyPassword("pw", "$2A$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW"), Err(Unsupported("2A")))
  assert(malformed(verifyPassword("pw", "$2a$03$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW")))
  assert(malformed(verifyPassword("pw", "$2a$32$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW")))
  assert(malformed(verifyPassword("pw", "$2a$99$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW")))
  assert(malformed(verifyPassword("pw", "$2a$5$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeWW")))
  assert(malformed(verifyPassword("pw", "$2a$0a$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW")))
  assert(malformed(verifyPassword("pw", "$2a$-5$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW")))
  assert(malformed(verifyPassword("pw", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOe")))
  assert(malformed(verifyPassword("pw", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeWW")))
  assert(malformed(verifyPassword("pw", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOe+")))
  assert(malformed(verifyPassword("pw", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOe=")))
  assert(malformed(verifyPassword("pw", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyO\u{e9}")))
  assert(malformed(verifyPassword("pw", "$2a$05$CCCCCCCCCCCCCCCCCCCCC$E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW")))
  assert(malformed(verifyPassword("pw", "$2a$05")))
  assert(malformed(verifyPassword("pw", "$2a")))
  assert(malformed(verifyPassword("pw", "$2")))

@test("every error says what is wrong in a sentence")
passwordErrorMessages()
  assertEq(Malformed("the salt is short").message, "not a password hash: the salt is short")
  assertEq(Unsupported("scrypt").message, "unsupported password hash scheme: scrypt")
  assertEq(OverLimit("m", 2097152, 1048576).message, "the password hash's m is 2097152, over the limit of 1048576")
  assertEq(
    Failed("Memory allocation error").message,
    "the password hash could not be computed: Memory allocation error"
  )

@test("the defaults are OWASP's for Argon2id, and the limits admit every common setting")
defaults()
  val p = Argon2Params()
  assertEq((p.variant, p.memoryKiB, p.passes, p.lanes, p.hashLength, p.saltLength), (Argon2id, 19456, 2, 1, 32, 16))
  val l = PasswordLimits()
  assertEq((l.maxMemoryKiB, l.maxPasses, l.maxLanes, l.maxBcryptCost), (1048576, 32, 16, 16))

@test(should_trap)
argon2NoLanes()
  argon2("pw".bytes, repeated(0, 16), Argon2Params(Argon2id, 64, 1, 0, 32, 16))

@test(should_trap)
argon2TooManyLanes()
  argon2("pw".bytes, repeated(0, 16), Argon2Params(Argon2id, 2147483647, 1, 16777216, 32, 16))

@test(should_trap)
argon2TooLittleMemory()
  argon2("pw".bytes, repeated(0, 16), Argon2Params(Argon2id, 15, 1, 2, 32, 16))

@test(should_trap)
argon2NoPasses()
  argon2("pw".bytes, repeated(0, 16), Argon2Params(Argon2id, 64, 0, 1, 32, 16))

@test(should_trap)
argon2ShortHash()
  argon2("pw".bytes, repeated(0, 16), Argon2Params(Argon2id, 64, 1, 1, 3, 16))

@test(should_trap)
argon2ShortSalt()
  argon2("pw".bytes, repeated(0, 7), Argon2Params(Argon2id, 64, 1, 1, 32, 16))

@test(should_trap)
hashShortSalt()
  hashPassword("pw", Argon2Params(Argon2id, 64, 1, 1, 32, 7))

@test(should_trap)
hashNegativeMemory()
  hashPassword("pw", Argon2Params(Argon2id, -1, 1, 1, 32, 16))
