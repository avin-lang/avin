// `avin.crypto`'s SHA-224 and SHA-384 against FIPS 180-4's examples, incremental hashing against one
// call, HMAC-SHA-1 against RFC 2202, HMAC-SHA-224 and HMAC-SHA-384 against RFC 4231, and HKDF against
// RFC 5869 and Wycheproof, with its length limits and its two halves agreeing with the whole.
import avin.crypto.{sha224, sha384, Sha224, Sha384, hmacSha1, hmacSha224, hmacSha384, hmacSha256}
import avin.crypto.{hkdfSha256, hkdfSha384, hkdfSha512, hkdfExtractSha256, hkdfExtractSha384, hkdfExtractSha512}
import avin.crypto.{hkdfExpandSha256, hkdfExpandSha384, hkdfExpandSha512}
import avin.encoding.toHex

@test("SHA-224 and SHA-384 give the published digests of the empty message, abc and the 448-bit and 896-bit messages")
sha224And384Vectors()
  assertEq(toHex(sha224("")), "d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f")
  assertEq(toHex(sha224("abc")), "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7")
  assertEq(
    toHex(sha224("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")),
    "75388b16512776cc5dba5da1fd890150b0c6455cb4f58b1952522525"
  )
  assertEq(
    toHex(sha384("")),
    "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b"
  )
  assertEq(
    toHex(sha384("abc")),
    "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"
  )
  assertEq(
    toHex(
      sha384(
        "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
      )
    ),
    "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039"
  )
  assertEq(sha224(Vector.tabulate(1000, i -> byte(i % 256))).length, 28)
  assertEq(sha384(Vector.tabulate(1000, i -> byte(i % 256))).length, 48)
  assertEq(toHex(sha224("héllo ✓")), toHex(sha224("héllo ✓".bytes)))

@test(
  "a SHA-224 or SHA-384 hasher fed in pieces, split at every point, gives the one-call digest, and again when asked again"
)
incremental()
  val message = Vector.tabulate(300, i -> byte(i * 13 % 256))
  for split in [0, 1, 55, 56, 63, 64, 65, 111, 112, 127, 128, 129, 299, 300]
    val a = Sha224()
    a.update(message.slice(0, split))
    a.update(message, split, message.length)
    assertEq(toHex(a.finish()), toHex(sha224(message)))
    assertEq(toHex(a.finish()), toHex(sha224(message)))
    val b = Sha384()
    b.update(message.toArray(), 0, split)
    b.update(message.slice(split, message.length).toArray())
    assertEq(toHex(b.finish()), toHex(sha384(message)))
  val t = Sha384()
  t.update("ab")
  t.update("c")
  assertEq(toHex(t.finish()), toHex(sha384("abc")))
  val e = Sha224()
  assertEq(toHex(e.finish()), toHex(sha224("")))

@test("HMAC-SHA-1 gives RFC 2202's answers, HMAC-SHA-224 and HMAC-SHA-384 give RFC 4231's")
hmacVectors()
  assertEq(toHex(hmacSha1(Vector.fill(20, byte(0x0b)), "Hi There".bytes)), "b617318655057264e28bc0b6fb378c8ef146be00")
  assertEq(toHex(hmacSha1("Jefe", "what do ya want for nothing?")), "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79")
  assertEq(
    toHex(hmacSha1(Vector.fill(20, byte(0xaa)), Vector.fill(50, byte(0xdd)))),
    "125d7342b9ac11cd91a39af48aa17b4f63f175d3"
  )
  // RFC 2202 test 6: a key longer than the block is hashed first.
  assertEq(
    toHex(hmacSha1(Vector.fill(80, byte(0xaa)), "Test Using Larger Than Block-Size Key - Hash Key First".bytes)),
    "aa4ae5e15272d00e95705637ce8a3b55ed402112"
  )
  assertEq(
    toHex(hmacSha224("Jefe", "what do ya want for nothing?")),
    "a30e01098bc6dbbf45690f3a7e9e6d0f8bbea2a39e6148008fd05e44"
  )
  assertEq(
    toHex(hmacSha224(Vector.fill(20, byte(0x0b)), "Hi There".bytes)),
    "896fb1128abbdf196832107cd49df33f47b4b1169912ba4f53684b22"
  )
  assertEq(
    toHex(hmacSha384("Jefe", "what do ya want for nothing?")),
    "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649"
  )
  assertEq(
    toHex(hmacSha384(Vector.fill(20, byte(0x0b)), "Hi There".bytes)),
    "afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6"
  )
  // An empty key and an empty message are allowed.
  assertEq(hmacSha1(Vector(), Vector()).length, 20)
  assertEq(hmacSha384(Vector(), Vector()).length, 48)

@test("HKDF over SHA-256 gives RFC 5869's keys, and its halves give the same")
hkdfRfc5869()
  val ikm = Vector.fill(22, byte(0x0b))
  val salt = hex("000102030405060708090a0b0c")
  val info = hex("f0f1f2f3f4f5f6f7f8f9")
  assertEq(
    toHex(hkdfSha256(ikm, salt, info, 42)),
    "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865"
  )
  val prk = hkdfExtractSha256(salt, ikm)
  assertEq(toHex(prk), "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")
  assertEq(toHex(hkdfExpandSha256(prk, info, 42)), toHex(hkdfSha256(ikm, salt, info, 42)))
  // Test case 3: no salt and no info.
  assertEq(
    toHex(hkdfSha256(ikm, Vector(), Vector(), 42)),
    "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8"
  )
  // A shorter key is the front of a longer one.
  assertEq(toHex(hkdfSha256(ikm, salt, info, 10)), "3cb25f25faacd57a9043")
  assertEq(toHex(hkdfSha256(ikm, salt, info, 1)), "3c")

@test("HKDF over SHA-384 and SHA-512 gives Wycheproof's keys, and each one's halves agree with it")
hkdfWider()
  assertEq(
    toHex(hkdfSha384(hex("24aeff2645e3e0f5494a9a102778c43a"), Vector(), Vector(), 20)),
    "4b7045423d9156424b0b85d95a7d602fba3924b1"
  )
  assertEq(
    toHex(hkdfSha384(hex("a23632e18ec76b59b1c87008da3f8a7e"), Vector(), Vector(), 42)),
    "46cddd93b528a7b2df07a3d21e809d8980e1bf8faebfa48199779626ddbe925781ce9fc8de6b27eaeec7"
  )
  val secret = "secret".bytes
  val salt = "salt".bytes
  val info = "info".bytes
  assertEq(
    toHex(hkdfExpandSha384(hkdfExtractSha384(salt, secret), info, 100)),
    toHex(hkdfSha384(secret, salt, info, 100))
  )
  assertEq(
    toHex(hkdfExpandSha512(hkdfExtractSha512(salt, secret), info, 100)),
    toHex(hkdfSha512(secret, salt, info, 100))
  )
  assertEq(hkdfExtractSha256(salt, secret), hmacSha256(salt, secret))
  assert(hkdfSha256(secret, salt, "a".bytes, 32) != hkdfSha256(secret, salt, "b".bytes, 32))
  assert(hkdfSha256(secret, "s1".bytes, info, 32) != hkdfSha256(secret, "s2".bytes, info, 32))

@test("HKDF makes from one byte up to 255 digests' worth of key")
hkdfLengths()
  assertEq(hkdfSha256("k".bytes, Vector(), Vector(), 8160).length, 8160)
  assertEq(hkdfSha384("k".bytes, Vector(), Vector(), 12240).length, 12240)
  assertEq(hkdfSha512("k".bytes, Vector(), Vector(), 16320).length, 16320)
  assertEq(hkdfExpandSha256(Vector.fill(32, byte(1)), Vector(), 8160).length, 8160)
  assertEq(hkdfExpandSha512(Vector.fill(64, byte(1)), Vector(), 1).length, 1)
  val whole = hkdfSha256("k".bytes, Vector(), Vector(), 8160)
  assertEq(toHex(hkdfSha256("k".bytes, Vector(), Vector(), 33)), toHex(whole.slice(0, 33)))
