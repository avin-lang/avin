// Sorting at its edges: every length around the size of an insertion run and the widths of the
// merge passes, input already sorted, reversed and full of duplicates, and stability throughout.

// `n` pseudo-random keys below `range`, the same ones on every run.
keys(n: int, range: int) -> Vector[int]
    val b = Vector.newBuilder[int]()
    var state: long = 12345
    for _ in 0..<n
        state = (state * 1103515245 + 12345) % 2147483648
        b.addOne(int(state % long(range)))
    b.result()

// Whether `sorted` is `original` sorted by key, stably: the keys ascend, the elements with equal keys
// keep the order of their indices, and each index appears once.
stablySorted(original: Vector[int], sorted: Vector[(int, int)]) -> bool
    if sorted.length != original.length then return false
    var seen = Set.empty[int]()
    for i in 0..<sorted.length
        val (key, index) = sorted(i)
        if original(index) != key || seen.contains(index) then return false
        seen = seen.incl(index)
        if i > 0
            val (before, earlier) = sorted(i - 1)
            if before > key || (before == key && earlier > index) then return false
    true

@test("sortBy is stable at every length around the insertion runs and merge widths")
everyLength()
    for n in [0, 1, 2, 3, 15, 16, 17, 31, 32, 33, 47, 48, 63, 64, 65, 100, 255, 256, 257, 1000]
        val ks = keys(n, 5)
        val pairs = ks.zipWithIndex
        assert(stablySorted(ks, pairs.sortBy(p -> p.0)), s"sortBy at $n")
        assert(stablySorted(ks, pairs.sortWith((a, b) -> a.0.compare(b.0))), s"sortWith at $n")

@test("sorted ascends for sorted, reversed, constant and random input")
inputShapes()
    val n = 777
    val ascending = Vector.newBuilder[int]()
    for i in 0..<n do ascending.addOne(i)
    val up = ascending.result()
    assertEq(up.sorted(), up)
    assertEq(up.reverse.sorted(), up)
    val same = up.map(x -> 4)
    assertEq(same.sorted(), same)
    val random = keys(n, 1000000)
    val sorted = random.sorted()
    for i in 1..<n do assert(sorted(i - 1) <= sorted(i))
    assertEq(sorted.length, n)

@test("a list sorts as a vector does, stably")
listSorting()
    val ks = keys(200, 7)
    val pairs = ks.zipWithIndex.toList
    assert(stablySorted(ks, pairs.sortBy(p -> p.0).toVector))
    assertEq(List(3, 1, 2).sorted(), List(1, 2, 3))
    assertEq(List.empty[int]().sorted(), List.empty[int]())
    assertEq(List(1).sortWith((a, b) -> b.compare(a)), List(1))

@test("an array sorts in place, stably by key, and descending by a reversed comparison")
arraySorting()
    val ks = keys(300, 10)
    val a = ks.zipWithIndex.toArray()
    a.sortInPlaceBy(p -> p.0)
    assert(stablySorted(ks, a.toVector))
    val b = [5, 3, 9, 1].toArray()
    b.sortInPlaceWith((x, y) -> y.compare(x))
    assertEq(b.toVector, [9, 5, 3, 1])
    val empty = Array.empty[int]()
    empty.sortInPlace()
    assertEq(empty.length, 0)

@test("an array's sortBy and sortWith answer a sorted vector and leave the array as it was")
arraySortedCopies()
    val a = [3, 1, 2].toArray()
    assertEq(a.sortBy(x -> -x), [3, 2, 1])
    assertEq(a.sortWith((x, y) -> x.compare(y)), [1, 2, 3])
    assertEq(a.toVector, [3, 1, 2])

@test("min, max, minBy and maxBy, and their Option forms")
extremes()
    val v = [3, 1, 4, 1, 5]
    assertEq(v.min, 1)
    assertEq(v.max, 5)
    assertEq(v.minBy(x -> -x), 5)
    assertEq(v.maxBy(x -> -x), 1)
    assertEq(v.minOption, Some(1))
    assertEq(v.maxByOption(x -> x % 3), Some(5))
    assertEq(Set(7).max, 7)

@test("max of an empty collection traps", should_trap: "max of an empty collection")
emptyMax()
    Vector.empty[int]().max

@test("minBy of an empty collection traps", should_trap: "minBy of an empty collection")
emptyMinBy()
    List.empty[int]().minBy(x -> x)

@test("sortBy computes each key once")
keysComputedOnce()
    var calls = 0
    val v = keys(100, 50).sortBy(x ->
        calls += 1
        -x)
    assertEq(calls, 100)
    for i in 1..<v.length do assert(v(i - 1) >= v(i))

@test("strings sort by their bytes, the empty string first")
stringSorting()
    assertEq(["b", "", "ab", "B", "a"].sorted(), ["", "B", "a", "ab", "b"])
