@test(
  "each cipher seals RFC 8439's and Wycheproof's messages to their ciphertexts, opens them, and refuses the tampered tags"
)
aeadVectors()
  for (aead, tc, k, nonce, aad, plaintext, sealed, valid) in Vectors
    val key = keyOf(aead, hex(k))
    if valid then
      assertEq(s"$aead $tc ${toHex(key.sealWithNonce(hex(nonce), hex(plaintext), hex(aad)))}", s"$aead $tc $sealed")
      assertEq(
        s"$aead $tc ${key.openWithNonce(hex(nonce), hex(sealed), hex(aad)).map(toHex)}",
        s"$aead $tc Ok($plaintext)"
      )
    else
      assert(unauthentic(key.openWithNonce(hex(nonce), hex(sealed), hex(aad))), s"$aead $tc opened")

@test("changing any one bit of a sealed message, or its associated data, makes it not open")
everyByteTampered()
  for aead in Ciphers
    val key = aead.generateKey()
    val nonce = hex("000102030405060708090a0b")
    val aad = "header".bytes
    val sealed = key.sealWithNonce(nonce, "a short secret".bytes, aad)
    assertEq(sealed.length, 14 + 16)
    for at in 0 ..< sealed.length
      for bit in [0, 7]
        assert(unauthentic(key.openWithNonce(nonce, flipped(sealed, at, bit), aad)), s"$aead byte $at bit $bit")
    for at in 0 ..< aad.length
      assert(unauthentic(key.openWithNonce(nonce, sealed, flipped(aad, at, 0))))
    assert(unauthentic(key.openWithNonce(nonce, sealed, Vector())))
    assert(unauthentic(key.openWithNonce(nonce, sealed, aad ++ hex("00"))))
    assert(unauthentic(key.openWithNonce(nonce, sealed.slice(0, sealed.length - 1), aad)))
    assert(unauthentic(key.openWithNonce(nonce, sealed ++ hex("00"), aad)))
    assert(unauthentic(key.openWithNonce(nonce, sealed.slice(1, sealed.length), aad)))
    assert(unauthentic(key.openWithNonce(nonce, sealed.slice(0, 16), aad)))
    assert(unauthentic(key.openWithNonce(nonce, sealed.slice(0, 15), aad)))
    assert(unauthentic(key.openWithNonce(nonce, Vector(), aad)))
    assert(unauthentic(key.openWithNonce(flipped(nonce, 11, 0), sealed, aad)))
    assert(unauthentic(aead.generateKey().openWithNonce(nonce, sealed, aad)))
    assertEq(key.openWithNonce(nonce, sealed, aad).map(utf8), Ok("a short secret"))

@test("a message sealed under one cipher does not open under another with the same key bytes")
crossCipher()
  val bytes = Vector.tabulate(32, i -> byte(i))
  val nonce = Vector.fill(12, byte(9))
  val sealed = keyOf(Aes256Gcm, bytes).sealWithNonce(nonce, "x".bytes)
  assert(unauthentic(keyOf(ChaCha20Poly1305, bytes).openWithNonce(nonce, sealed)))
  val back = keyOf(ChaCha20Poly1305, bytes).sealWithNonce(nonce, "x".bytes)
  assert(unauthentic(keyOf(Aes256Gcm, bytes).openWithNonce(nonce, back)))
  assert(sealed != back)

@test(
  "every length round trips: empty, one byte, each side of a block, several blocks, a mebibyte, with and without associated data"
)
sealedEveryLength()
  for aead in Ciphers
    val key = aead.generateKey()
    val nonce = Vector.fill(12, byte(1))
    for n in [0, 1, 15, 16, 17, 31, 32, 33, 63, 64, 65, 255, 256, 257, 1000, 1048576 + 5]
      val message = Vector.tabulate(n, i -> byte(i * 31 % 256))
      for aad in [Vector(), "a".bytes, Vector.tabulate(100, i -> byte(i))]
        val sealed = key.sealWithNonce(nonce, message, aad)
        assertEq(sealed.length, n + 16)
        assert(key.openWithNonce(nonce, sealed, aad).getOrElse(Vector()) == message, s"$aead $n")

@test("seal draws a fresh nonce each time and puts it in front, so one message sealed twice differs and both open")
randomNonces()
  for aead in Ciphers
    val key = aead.generateKey()
    val a = key.seal("same".bytes, "ad".bytes)
    val b = key.seal("same".bytes, "ad".bytes)
    assertEq(a.length, 12 + 4 + 16)
    assert(a != b)
    assert(a.slice(0, 12) != b.slice(0, 12))
    assertEq(key.open(a, "ad".bytes).map(utf8), Ok("same"))
    assertEq(key.open(b, "ad".bytes).map(utf8), Ok("same"))
    assert(unauthentic(key.open(a)))
    assert(unauthentic(key.open(a, "ae".bytes)))
    // What `seal` made is the nonce and what `sealWithNonce` makes under it.
    assertEq(key.openWithNonce(a.slice(0, 12), a.slice(12, a.length), "ad".bytes).map(utf8), Ok("same"))
    assertEq(toHex(key.sealWithNonce(a.slice(0, 12), "same".bytes, "ad".bytes)), toHex(a.slice(12, a.length)))
    // Text seals as its UTF-8 bytes; anything shorter than a nonce and a tag is refused.
    val text = key.seal("héllo ✓ 😀")
    assertEq(key.open(text).map(utf8), Ok("héllo ✓ 😀"))
    assertEq(key.open(key.seal("")).map(toHex), Ok(""))
    for n in [0, 1, 12, 27]
      assert(unauthentic(key.open(Vector.fill(n, byte(0)))))
    assert(unauthentic(key.open(text.slice(0, 28))))

@test("a key is the cipher's length; any other is refused; a generated key is that long and new each time")
keyLengths()
  assertEq(Aes128Gcm.keyLength, 16)
  assertEq(Aes256Gcm.keyLength, 32)
  assertEq(ChaCha20Poly1305.keyLength, 32)
  for aead in Ciphers
    assertEq(aead.nonceLength, 12)
    assertEq(aead.tagLength, 16)
    for n in [0, 1, 15, 17, 24, 31, 33, 64]
      if n != aead.keyLength then
        assert(aead.key(Vector.fill(n, byte(1))) is Err(InvalidKey(_)), s"$aead $n")
    val k = aead.generateKey()
    assertEq(k.toBytes().length, aead.keyLength)
    assert(k.aead == aead)
    assert(k.toBytes() != aead.generateKey().toBytes())
    assert(
      keyOf(aead, k.toBytes()).openWithNonce(
        Vector.fill(12, byte(0)),
        k.sealWithNonce(Vector.fill(12, byte(0)), "m".bytes)
      ) is Ok(_)
    )
  assertEq(
    Aes128Gcm.key(Vector()).err.map(e -> e.message),
    Some("not a usable key: a AES-128-GCM key is 16 bytes, and these are 0")
  )

@test("a key's text names its cipher and shows nothing of the key")
keyDisplay()
  val k = keyOf(Aes256Gcm, Vector.fill(32, byte(0xab)))
  assertEq(s"$k", "AeadKey(AES-256-GCM)")
  assertEq(s"${Aes128Gcm.generateKey()}", "AeadKey(AES-128-GCM)")
  assertEq(s"${ChaCha20Poly1305.generateKey()}", "AeadKey(ChaCha20-Poly1305)")
  assert(!s"${[k]}".contains("ab"))
  assertEq(s"${Unauthentic.message}", "the message does not authenticate")
