// `avin.crypto`'s authenticated encryption: AES-128-GCM, AES-256-GCM and ChaCha20-Poly1305 against
// RFC 8439's example and Wycheproof's vectors, valid and tampered; then every byte of a sealed message
// changed one at a time, the associated data changed, the wrong key, nonce and cipher, every length
// from empty up past several blocks and a mebibyte, the random-nonce form, keys of the wrong length,
// and a key's text.
import avin.crypto.{Aead, Aes128Gcm, Aes256Gcm, ChaCha20Poly1305, AeadKey, CryptoError, InvalidKey, Unauthentic}
import avin.encoding.toHex

// The text whose UTF-8 bytes are `bytes`.
utf8(bytes: Vector[byte]) -> string = string.fromUtf8Lossy(bytes.toArray())

keyOf(aead: Aead, bytes: Vector[byte]) -> AeadKey = aead.key(bytes).getOrElse(fail(s"a $aead key"))

// Whether `r` is an `Unauthentic` refusal.
unauthentic(r: Result[Vector[byte], CryptoError]) -> bool = r is Err(Unauthentic)

flipped(bytes: Vector[byte], at: int, bit: int) -> Vector[byte] =
  Vector.tabulate(bytes.length, i -> if i == at then bytes(i) ^ byte(1 << bit) else bytes(i))

val Ciphers = [Aes128Gcm, Aes256Gcm, ChaCha20Poly1305]

// (cipher, tcId, key, nonce, aad, plaintext, ciphertext with its tag, valid): RFC 8439 § 2.8.2 (Wycheproof
