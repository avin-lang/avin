// `saslPrep`, RFC 4013's profile of stringprep: the examples of the RFC's section 3, then each step
// of the profile, mapping, normalization, prohibition, the bidirectional rule and unassigned code
// points, at the edges of its tables.

import avin.crypto.saslPrep

@test("the examples of RFC 4013 section 3")
rfcExamples()
  assert(saslPrep("I\u{ad}X") == Some("IX"))
  assert(saslPrep("user") == Some("user"))
  assert(saslPrep("USER") == Some("USER"))
  assert(saslPrep("\u{aa}") == Some("a"))
  assert(saslPrep("\u{2168}") == Some("IX"))
  assert(saslPrep("\u{7}") == None)
  assert(saslPrep("\u{627}\u{31}") == None)

@test("ASCII without controls comes back as it is, spaces and punctuation included")
asciiUnchanged()
  assert(saslPrep("") == Some(""))
  assert(saslPrep("pencil") == Some("pencil"))
  assert(saslPrep("pass word") == Some("pass word"))
  assert(
    saslPrep(" ~!@#$%^&*()_+{}|:\"<>?`-=[]\\;',./0123456789") == Some(" ~!@#$%^&*()_+{}|:\"<>?`-=[]\\;',./0123456789")
  )

@test("spaces other than U+0020 become U+0020")
nonAsciiSpaces()
  assert(saslPrep("a\u{a0}b") == Some("a b"))
  assert(saslPrep("a\u{3000}b") == Some("a b"))
  assert(saslPrep("\u{2000}\u{200a}\u{202f}\u{205f}\u{1680}") == Some("     "))
  // U+200B ZERO WIDTH SPACE is in both the space table and the table of characters mapped to
  // nothing; the space mapping is applied first.
  assert(saslPrep("a\u{200b}b") == Some("a b"))

@test("the characters mapped to nothing are removed before normalization")
mappedToNothing()
  assert(saslPrep("\u{ad}") == Some(""))
  assert(saslPrep("a\u{34f}b\u{200c}c\u{200d}d\u{2060}e\u{feff}f") == Some("abcdef"))
  assert(saslPrep("x\u{fe00}\u{fe0f}\u{180b}\u{1806}y") == Some("xy"))
  // With the soft hyphen gone, the accent composes with the letter before it.
  assert(saslPrep("e\u{ad}\u{301}") == Some("\u{e9}"))

@test("the result is in normalization form NFKC")
normalized()
  assert(saslPrep("\u{fb01}") == Some("fi"))
  assert(saslPrep("ＰＡＳＳ１") == Some("PASS1"))
  assert(saslPrep("e\u{301}") == Some("\u{e9}"))
  assert(saslPrep("\u{e9}") == Some("\u{e9}"))
  assert(saslPrep("\u{2460}\u{b2}") == Some("12"))
  assert(saslPrep("\u{212b}") == Some("\u{c5}"))
  assert(saslPrep("\u{ac00}") == Some("\u{ac00}"))
  assert(saslPrep("\u{1100}\u{1161}") == Some("\u{ac00}"))

@test("controls, private use, non-characters and the other prohibited code points are refused")
prohibited()
  for c in ["\u{0}", "\u{1f}", "\t", "\n", "\u{7f}", "\u{80}", "\u{85}", "\u{9f}", "\u{6dd}", "\u{70f}", "\u{180e}"]
    assert(saslPrep("a" + c + "b") == None)
  // Private use, in the Basic Multilingual Plane and planes 15 and 16.
  for c in ["\u{e000}", "\u{f8ff}", "\u{f0000}", "\u{ffffd}", "\u{100000}", "\u{10fffd}"]
    assert(saslPrep(c) == None)
  // Non-characters, and the characters inappropriate for plain text or canonical representation.
  for c in [
    "\u{fdd0}",
    "\u{fdef}",
    "\u{fffe}",
    "\u{ffff}",
    "\u{1fffe}",
    "\u{10ffff}",
    "\u{fff9}",
    "\u{fffc}",
    "\u{fffd}",
    "\u{2ff0}"
  ]
    assert(saslPrep(c) == None)
  // The characters that change the display direction, the deprecated format characters, and tags.
  for c in [
    "\u{200e}",
    "\u{200f}",
    "\u{202a}",
    "\u{202e}",
    "\u{206a}",
    "\u{206f}",
    "\u{e0001}",
    "\u{e0020}",
    "\u{e007f}"
  ]
    assert(saslPrep(c) == None)
  assert(saslPrep("\u{1d173}") == None)
  // The prohibition is of the normalized string: U+0340 and U+0341, prohibited, are canonically
  // U+0300 and U+0301, which are not.
  assert(saslPrep("a\u{340}") == Some("\u{e0}"))
  assert(saslPrep("\u{341}") == Some("\u{301}"))
  // The neighbours of the prohibited ranges are allowed.
  assert(saslPrep("\u{a1}") == Some("\u{a1}"))
  assert(saslPrep("\u{d7a3}") == Some("\u{d7a3}"))

@test("a code point unassigned in Unicode 3.2 is refused, a character assigned since among them")
unassigned()
  assert(saslPrep("\u{221}") == None)
  assert(saslPrep("a\u{378}") == None)
  assert(saslPrep("\u{1e9e}") == None)
  assert(saslPrep("😀") == None)
  assert(saslPrep("\u{20ac}") == Some("\u{20ac}"))
  assert(saslPrep("\u{220}") == Some("\u{220}"))
  assert(saslPrep("\u{233}") == Some("\u{233}"))

@test("a right-to-left string holds no left-to-right character and begins and ends right-to-left")
bidirectional()
  assert(saslPrep("\u{627}\u{628}") == Some("\u{627}\u{628}"))
  assert(saslPrep("\u{5d0}\u{5d1}\u{5d2}") == Some("\u{5d0}\u{5d1}\u{5d2}"))
  assert(saslPrep("\u{627}1\u{628}") == Some("\u{627}1\u{628}"))
  assert(saslPrep("\u{627} \u{628}") == Some("\u{627} \u{628}"))
  assert(saslPrep("\u{627}") == Some("\u{627}"))
  assert(saslPrep("\u{627}a\u{628}") == None)
  assert(saslPrep("1\u{627}") == None)
  assert(saslPrep("\u{627}1") == None)
  assert(saslPrep("a\u{5d0}") == None)
  assert(saslPrep("\u{5d0}\u{627}") == Some("\u{5d0}\u{627}"))
  // A string of no strong direction, and a left-to-right one, are not held to the rule.
  assert(saslPrep("123") == Some("123"))
  assert(saslPrep("abc") == Some("abc"))
  // The rule is applied after mapping: a soft hyphen at either end does not count.
  assert(saslPrep("\u{ad}\u{627}\u{628}\u{ad}") == Some("\u{627}\u{628}"))

@test("a long password is prepared as its characters are")
longPassword()
  val piece = "p\u{e1}ss\u{a0}\u{ad}\u{fb01}"
  val text = StringWriter()
  val expected = StringWriter()
  for _ in 0 ..< 1000
    text.write(piece)
    expected.write("p\u{e1}ss fi")
  assert(saslPrep(text.text) == Some(expected.text))
