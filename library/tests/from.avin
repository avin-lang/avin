// The companion `from(xs)` of the collections, `Vector.iterate`, `Vector.unfold`, `List.unfold`, and
// `toSortedSet()` / `toSortedMap()`: sources of every kind, duplicates, order and the empty case.

@test("from keeps the order of an ordered source in sequence targets")
fromSequences()
  assertEq(List.from(Vector(3, 1, 2)), List(3, 1, 2))
  assertEq(Vector.from(List(3, 1, 2)), Vector(3, 1, 2))
  assertEq(ArraySeq.from(1 .. 3).toVector, Vector(1, 2, 3))
  assertEq(Queue.from(Vector(3, 1, 2)).toVector, Vector(3, 1, 2))
  assertEq(List.from(Vector[int]()), Nil)
  assertEq(Vector.from(Iterator.empty[int]()), Vector[int]())

@test("from sorts into the sorted targets and merges duplicates")
fromSorted()
  assertEq(TreeSet.from(Vector(3, 1, 2, 3, 1)).toVector, Vector(1, 2, 3))
  assertEq(Vector(3, 1, 2).toSortedSet.toVector, Vector(1, 2, 3))
  assertEq(BitSet.from(List(64, 1, 1)).toVector, Vector(1, 64))
  assertEq(OrderedSet.from(List(3, 1, 3, 2)).toVector, Vector(3, 1, 2))
  assertEq(HashSet.from(List(1, 1, 1)).size, 1)

@test("from a collection of pairs: a later pair's value replaces an earlier one's")
fromMaps()
  val pairs = Vector((2, "two"), (1, "one"), (2, "deux"))
  assertEq(HashMap.from(pairs).get(2), Some("deux"))
  assertEq(TreeMap.from(pairs).toVector, Vector((1, "one"), (2, "deux")))
  assertEq(OrderedMap.from(pairs).toVector, Vector((2, "deux"), (1, "one")))
  assertEq(pairs.toSortedMap.toVector, Vector((1, "one"), (2, "deux")))

@test("iterate and unfold")
iterateUnfold()
  assertEq(Vector.iterate(1, 5, x -> x * 2), Vector(1, 2, 4, 8, 16))
  assertEq(Vector.iterate(1, 0, x -> x * 2), Vector[int]())
  assertEq(Vector.unfold(3, n -> if n == 0 then None else Some((n, n - 1))), Vector(3, 2, 1))
  assertEq(List.unfold(3, n -> if n == 0 then None else Some((n, n - 1))), List(3, 2, 1))
