// The IEEE 754 encodings of `real`: `toBits` and `real.fromBits` for binary64, `toBits32` and
// `real.fromBits32` for binary32, at zeros, subnormals, the limits, infinities and NaNs, and the
// rounding binary32 narrowing does.

import avin.math

@test("toBits gives the binary64 encodings of known values")
realToBitsKnown()
  assert(0.0.toBits == 0)
  assert((-0.0).toBits == long.MinValue)
  assert(1.0.toBits == 0x3FF0000000000000)
  assert((-2.0).toBits == -0x4000000000000000)
  assert(0.1.toBits == 0x3FB999999999999A)
  assert(real.MinPositiveValue.toBits == 1)
  assert(real.MaxValue.toBits == 0x7FEFFFFFFFFFFFFF)
  assert(real.MinValue.toBits == -0x10000000000001)
  assert(real.PositiveInfinity.toBits == 0x7FF0000000000000)
  assert(real.NegativeInfinity.toBits == -0x10000000000000)
  assert(2.2250738585072014e-308.toBits == 0x0010000000000000)
  assert(2.225073858507201e-308.toBits == 0x000FFFFFFFFFFFFF)

@test("real.fromBits gives the number of a binary64 encoding")
realFromBitsKnown()
  assert(real.fromBits(0) == 0.0 && !math.signBit(real.fromBits(0)))
  assert(real.fromBits(long.MinValue) == 0.0 && math.signBit(real.fromBits(long.MinValue)))
  assert(real.fromBits(0x3FF0000000000000) == 1.0)
  assert(real.fromBits(-0x4000000000000000) == -2.0)
  assert(real.fromBits(1) == real.MinPositiveValue)
  assert(real.fromBits(0x000FFFFFFFFFFFFF) == 2.225073858507201e-308)
  assert(real.fromBits(0x7FEFFFFFFFFFFFFF) == real.MaxValue)
  assert(real.fromBits(0x7FF0000000000000) == real.PositiveInfinity)
  assert(real.fromBits(-0x10000000000000) == real.NegativeInfinity)

@test("every encoding with an all-ones exponent and a nonzero fraction is a NaN, its payload kept")
realBitsNaN()
  assert(real.NaN.toBits != 0 && real.fromBits(real.NaN.toBits).isNaN)
  val nans: Vector[long] = [
    0x7FF8000000000000, 0x7FF0000000000001, 0x7FFFFFFFFFFFFFFF, -1, -0x8000000000001, 0x7FF4000000000123
  ]
  for bits in nans
    val x = real.fromBits(bits)
    assert(x.isNaN)
    assert(x.toBits == bits)
  assert(((0.0 / 0.0).toBits & 0x7FF0000000000000) == 0x7FF0000000000000)

@test("toBits and real.fromBits are inverses across the range of encodings")
realBitsRoundTrip()
  var bits = long.MinValue
  var steps = 0
  while steps < 20000
    val x = real.fromBits(bits)
    assert(x.toBits == bits)
    if !x.isNaN then assert(real.fromBits(x.toBits) == x)
    bits = bits +% 922337203685477
    steps += 1
  for x in [1.5, -1.5, 3.141592653589793, 1e300, -1e-300, 123456789.0]
    assert(real.fromBits(x.toBits) == x)

@test("toBits orders the non-negative numbers as their encodings")
realBitsOrdered()
  assert(1.0.toBits < 2.0.toBits && 2.0.toBits < real.MaxValue.toBits)
  assert(real.MaxValue.toBits + 1 == real.PositiveInfinity.toBits)
  assert(math.nextUp(1.0).toBits == 1.0.toBits + 1)

@test("toBits32 gives the binary32 encodings of exactly representable values")
realToBits32Known()
  assert(0.0.toBits32 == 0)
  assert((-0.0).toBits32 == int.MinValue)
  assert(1.0.toBits32 == 0x3F800000)
  assert((-2.0).toBits32 == -0x40000000)
  assert(0.5.toBits32 == 0x3F000000)
  assert(3.4028234663852886e38.toBits32 == 0x7F7FFFFF)
  assert(1.1754943508222875e-38.toBits32 == 0x00800000)
  assert(1.401298464324817e-45.toBits32 == 1)
  assert(real.PositiveInfinity.toBits32 == 0x7F800000)
  assert(real.NegativeInfinity.toBits32 == -0x800000)

@test("real.fromBits32 widens a binary32 encoding exactly")
realFromBits32Known()
  assert(real.fromBits32(0) == 0.0 && !math.signBit(real.fromBits32(0)))
  assert(real.fromBits32(int.MinValue) == 0.0 && math.signBit(real.fromBits32(int.MinValue)))
  assert(real.fromBits32(0x3F800000) == 1.0)
  assert(real.fromBits32(0x3DCCCCCD) == 0.10000000149011612)
  assert(real.fromBits32(1) == 1.401298464324817e-45)
  assert(real.fromBits32(0x007FFFFF) == 1.1754942106924411e-38)
  assert(real.fromBits32(0x7F7FFFFF) == 3.4028234663852886e38)
  assert(real.fromBits32(-0x800001) == -3.4028234663852886e38)
  assert(real.fromBits32(0x7F800000) == real.PositiveInfinity)
  assert(real.fromBits32(-0x800000) == real.NegativeInfinity)

@test("toBits32 rounds to the nearest binary32, ties to even")
realToBits32Rounding()
  assert(0.1.toBits32 == 0x3DCCCCCD)
  assert(3.141592653589793.toBits32 == 0x40490FDB)
  // 1 + 2^-24 is halfway between 1.0 and the next binary32, whose last bit is odd: it goes to 1.0.
  assert(real.fromBits(0x3FF0000010000000).toBits32 == 0x3F800000)
  // 1 + 3 * 2^-24 is halfway between two binary32s, the upper of them even.
  assert(real.fromBits(0x3FF0000030000000).toBits32 == 0x3F800002)
  // Just past halfway rounds up, just short of it rounds down.
  assert(real.fromBits(0x3FF0000010000001).toBits32 == 0x3F800001)
  assert(real.fromBits(0x3FF000000FFFFFFF).toBits32 == 0x3F800000)
  // The same ties below zero: -(1 + 2^-24) goes to -1.0, -(1 + 3 * 2^-24) away from it.
  assert(real.fromBits(-0x400FFFFFF0000000).toBits32 == -0x40800000)
  assert(real.fromBits(-0x400FFFFFD0000000).toBits32 == -0x407FFFFE)

@test("toBits32 overflows to an infinity and underflows to a zero of the same sign")
realToBits32Limits()
  assert(1e39.toBits32 == 0x7F800000)
  assert((-1e39).toBits32 == -0x800000)
  assert(real.MaxValue.toBits32 == 0x7F800000)
  assert(real.MinValue.toBits32 == -0x800000)
  // Halfway between binary32's greatest finite value and 2^128 ties to the even one, infinity.
  val half = 3.4028235677973366e38
  assert(half.toBits32 == 0x7F800000)
  assert(math.nextDown(half).toBits32 == 0x7F7FFFFF)
  assert(1e-50.toBits32 == 0)
  assert((-1e-50).toBits32 == int.MinValue)
  assert(real.MinPositiveValue.toBits32 == 0)
  // 2^-150 is halfway between zero and the least subnormal: it ties to zero; past it rounds up.
  assert(real.fromBits(0x3690000000000000).toBits32 == 0)
  assert(real.fromBits(0x3698000000000000).toBits32 == 1)
  assert(real.fromBits(0x3690000000000001).toBits32 == 1)

@test("a NaN stays a quiet NaN through binary32")
realBits32NaN()
  for bits in [0x7FC00000, 0x7FC00001, 0x7FFFFFFF, -1, -0x400000]
    val x = real.fromBits32(bits)
    assert(x.isNaN)
    assert(x.toBits32 == bits)
  val signaling = real.fromBits32(0x7F800001)
  assert(signaling.isNaN)
  assert((signaling.toBits32 & 0x7FC00000) == 0x7FC00000)
  val narrowed = real.NaN.toBits32
  assert((narrowed & 0x7F800000) == 0x7F800000 && (narrowed & 0x7FFFFF) != 0)
  assert(real.fromBits32(narrowed).isNaN)

@test("toBits32 and real.fromBits32 are inverses for every binary32 that is not a NaN")
realBits32RoundTrip()
  var bits = int.MinValue
  var steps = 0
  while steps < 50000
    val x = real.fromBits32(bits)
    // A signaling NaN comes back quieted, so the quiet bit is set on both sides of a NaN's check.
    if x.isNaN then assert((x.toBits32 | 0x400000) == (bits | 0x400000)) else assert(x.toBits32 == bits)
    bits = bits +% 85899
    steps += 1
  for x in [1.0, -0.5, 0.25, 65504.0, 16777216.0, -16777215.0]
    assert(real.fromBits32(x.toBits32) == x)

@test("a value with no binary32 encoding widens back to the binary32 nearest it")
realBits32Nearest()
  val third = 1.0 / 3.0
  val narrowed = real.fromBits32(third.toBits32)
  assert(narrowed != third)
  assert(math.abs(narrowed - third) < 3e-8)
  assert(real.fromBits32(16777217.0.toBits32) == 16777216.0)
  assert(real.fromBits32(16777219.0.toBits32) == 16777220.0)
