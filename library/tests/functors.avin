// The standard constructor traits: the functor and monad laws for every constructor that implements
// them, each checked through its bound, so what is checked is the call generic code makes; `traverse`
// and `sequence` answering the first failure while giving every element to the function; a
// sequence's `map2` pairing every element with every element beside `zip` pairing them by position;
// and `foldLeft` through `Foldable` at every constructor that folds.

import avin.threads.Future

// The functor laws' two sides, for `fa`: `map(x -> x)` beside the value, and `map(f).map(g)` beside
// `map(x -> g(f(x)))`.
identityLaw[F[_]: Functor](fa: F[int]) -> (F[int], F[int]) = (fa.map(x -> x), fa)

compositionLaw[F[_]: Functor](fa: F[int]) -> (F[string], F[string]) =
  val f = (x: int) -> x * 3
  val g = (x: int) -> s"<$x>"
  (fa.map(f).map(g), fa.map(x -> g(f(x))))

// The monad laws' two sides: `pure(a).flatMap(f)` beside `f(a)`, `m.flatMap(pure)` beside `m`, and
// the two groupings of `flatMap`.
leftIdentity[F[_]: Monad](a: int, f: (int) -> F[string]) -> (F[string], F[string]) =
  (F.pure(a).flatMap(f), f(a))

rightIdentity[F[_]: Monad](m: F[int]) -> (F[int], F[int]) = (m.flatMap(x -> F.pure(x)), m)

associativity[F[_]: Monad](m: F[int], f: (int) -> F[int], g: (int) -> F[string]) -> (F[string], F[string]) =
  (m.flatMap(f).flatMap(g), m.flatMap(x -> f(x).flatMap(g)))

// Both sides of each law, equal.
holds[T: Eq & Debug](sides: (T, T)) = assertEq(sides.0, sides.1)

// The elements through `Foldable`, in folding order.
folded[F[_]: Foldable](xs: F[int]) -> Vector[int] = xs.foldLeft([], (acc, x) -> acc :+ x)

// The even elements, through `Filter`.
evens[F[_]: Filter](xs: F[int]) -> F[int] = xs.filter(x -> x % 2 == 0)

// The values through `Applicative`: `pure` and `map2`.
combined[F[_]: Applicative](a: F[int], b: F[int]) -> F[int] = a.map2(b, (x, y) -> x * 10 + y)

lifted[F[_]: Applicative](n: int) -> F[int] = F.pure(n)

halved(n: int) -> Option[int] = if n % 2 == 0 then Some(n / 2) else None

@test("Option keeps the functor and monad laws, at Some and at None")
optionLaws()
  val none: Option[int] = None
  for m in [Some(4), none]
    holds(identityLaw(m))
    holds(compositionLaw(m))
    holds(rightIdentity(m))
    holds(associativity(m, halved, x -> Some(s"$x")))
  holds(leftIdentity(4, x -> Some(s"$x")))
  holds(leftIdentity[Option](3, x -> None))
  assertEq(Option.pure(5), Some(5))
  assertEq(lifted[Option](6), Some(6))

@test("Result keeps the laws on its Ok values and passes its Err through")
resultLaws()
  val ok: Result[int, string] = Ok(4)
  val err: Result[int, string] = Err("bad")
  val f = (x: int) -> if x > 0 then Ok(x - 1) else Err[int, string]("negative")
  for m in [ok, err]
    holds(identityLaw(m))
    holds(compositionLaw(m))
    holds(rightIdentity(m))
    holds(associativity(m, f, x -> Ok(s"$x")))
  holds(leftIdentity[Result[_, string]](4, x -> Ok(s"$x")))
  assertEq(Result[_, string].pure(1), Ok(1))
  assertEq(combined(ok, err), err)
  assertEq(combined(ok, Ok(2)), Ok(42))

@test("Either keeps the laws on its Right values and passes its Left through")
eitherLaws()
  val right: Either[string, int] = Right(4)
  val left: Either[string, int] = Left("no")
  for m in [right, left]
    holds(identityLaw(m))
    holds(compositionLaw(m))
    holds(rightIdentity(m))
    holds(associativity(m, x -> Right(x + 1), x -> Right(s"$x")))
  holds(leftIdentity[Either[string, _]](4, x -> Right(s"$x")))
  assertEq(Either[string, _].pure(2), Right(2))

@test("the immutable sequences keep the laws, empty and with elements")
sequenceLaws()
  val f = (x: int) -> [x, x + 1]
  val g = (x: int) -> [s"$x"]
  for v in [[], [1], [1, 2, 3]]
    holds(identityLaw(v))
    holds(compositionLaw(v))
    holds(rightIdentity(v))
    holds(associativity(v, f, g))
    val l = v.toList
    holds(identityLaw(l))
    holds(compositionLaw(l))
    holds(rightIdentity(l))
    holds(associativity(l, x -> List(x, x + 1), x -> List(s"$x")))
    val a = v.toArraySeq
    holds(identityLaw(a))
    holds(compositionLaw(a))
    holds(rightIdentity(a))
    holds(associativity(a, x -> ArraySeq.fill(2, x), x -> ArraySeq.fill(1, s"$x")))
    val q = Queue.from(v)
    holds(identityLaw(q))
    holds(compositionLaw(q))
    holds(rightIdentity(q))
    holds(associativity(q, x -> Queue(x, x + 1), x -> Queue(s"$x")))
  holds(leftIdentity(4, g))
  holds(leftIdentity(4, x -> List(s"$x", "!")))
  holds(leftIdentity(4, x -> ArraySeq.fill(2, s"$x")))
  holds(leftIdentity(4, x -> Queue(s"$x")))
  assertEq(Vector.pure(1), [1])
  assertEq(List.pure(1), List(1))
  assertEq(ArraySeq.pure(1).toVector, [1])
  assertEq(Queue.pure(1).toVector, [1])

@test("LazyList keeps the laws, read lazily, and its pure is one element")
lazyListLaws()
  val one = LazyList.pure(3)
  val none = LazyList.empty[int]()
  for m in [one, LazyList.iterate(1, x -> x + 1).take(3), none]
    val (a, b) = identityLaw(m)
    assertEq(a.toList, b.toList)
    val (c, d) = compositionLaw(m)
    assertEq(c.toList, d.toList)
    val (e, f) = rightIdentity(m)
    assertEq(e.toList, f.toList)
    val (g, h) = associativity(m, x -> LazyList.pure(x * 2), x -> LazyList.pure(s"$x"))
    assertEq(g.toList, h.toList)
  val (l, r) = leftIdentity(5, x -> LazyList.pure(s"$x"))
  assertEq(l.toList, r.toList)
  // Mapped through the bound, an infinite list is still read only as far as it is taken.
  assertEq(evens(LazyList.iterate(1, x -> x + 1)).take(3).toList, List(2, 4, 6))

@test("the mutable sequences keep the functor laws, each map making a new one")
mutableLaws()
  for v in [[], [5], [1, 2, 3]]
    val array = Array.tabulate(v.length, i -> v(i))
    val (a, b) = identityLaw(array)
    assertEq(a.toVector, b.toVector)
    val (c, d) = compositionLaw(array)
    assertEq(c.toVector, d.toVector)
    val buffer = v.toBuffer()
    val (e, f) = identityLaw(buffer)
    assertEq(e.toVector, f.toVector)
    val (g, h) = compositionLaw(buffer)
    assertEq(g.toVector, h.toVector)
    val deque = Deque[int]()
    for x in v do deque.append(x)
    val (i, j) = identityLaw(deque)
    assertEq(i.toVector, j.toVector)
    val (k, l) = compositionLaw(deque)
    assertEq(k.toVector, l.toVector)
  val array = Array.tabulate(3, i -> i)
  val mapped = identityLaw(array).0
  mapped(0) = 9
  assertEq(array(0), 0)
  assertEq(evens(Array.tabulate(5, i -> i)).toVector, [0, 2, 4])

@test("Filter keeps the elements meeting the predicate at every constructor that filters")
filters()
  assertEq(evens(Some(4)), Some(4))
  assertEq(evens(Some(3)), None)
  assertEq(evens([1, 2, 3, 4]), [2, 4])
  assertEq(evens(List(1, 2)), List(2))
  assertEq(evens(Queue(2, 3, 4)).toVector, [2, 4])
  assertEq(evens(ArraySeq.fill(2, 6)).toVector, [6, 6])
  val b = [1, 2].toBuffer()
  assertEq(evens(b).toVector, [2])
  val d = Deque[int]()
  d.append(8)
  assertEq(evens(d).toVector, [8])

@test("Foldable folds first to last at every constructor that folds, and a set folds every element")
foldables()
  assertEq(folded(Some(1)), [1])
  val none: Option[int] = None
  assertEq(folded(none), [])
  val ok: Result[int, string] = Ok(2)
  assertEq(folded(ok), [2])
  val err: Result[int, string] = Err("e")
  assertEq(folded(err), [])
  val left: Either[string, int] = Left("l")
  assertEq(folded(left), [])
  assertEq(folded(List(1, 2, 3)), [1, 2, 3])
  assertEq(folded([3, 2, 1]), [3, 2, 1])
  assertEq(folded(Queue(1, 2)), [1, 2])
  assertEq(folded(LazyList.iterate(1, x -> x * 2).take(4)), [1, 2, 4, 8])
  assertEq(folded(Array.tabulate(3, i -> i)), [0, 1, 2])
  assertEq(folded([4].toBuffer()), [4])
  assertEq(folded(HashSet(1, 2, 3)).sum, 6)
  assertEq(folded(OrderedSet(3, 1, 2)), [3, 1, 2])

@test("a sequence's map2 pairs every element with every element, and zip pairs them by position")
cartesianAndPositional()
  assertEq([1, 2].map2([10, 20], (x, y) -> x + y), [11, 21, 12, 22])
  assertEq([1, 2].zip([10, 20]), [(1, 10), (2, 20)])
  assertEq(combined([1, 2], [3, 4]), [13, 14, 23, 24])
  assertEq(combined(List(1), List(2, 3)), List(12, 13))
  assertEq(combined([1, 2], []), [])
  assertEq(combined(Some(1), Some(2)), Some(12))
  val none: Option[int] = None
  assertEq(combined(Some(1), none), None)

@test("traverse and sequence answer the first failure, giving every element to the function")
traverseFirstFailure()
  assertEq(["1", "2"].traverse(_.toIntOption()), Some([1, 2]))
  assertEq(["1", "x", "y"].traverse(_.toIntOption()), None)
  val noWords: Vector[string] = []
  assertEq(noWords.traverse(_.toIntOption()), Some([]))
  assertEq([Some(1), None].sequence(), None)
  assertEq(List(Some(1), Some(2)).sequence(), Some(List(1, 2)))
  var seen: Vector[int] = []
  val firstBad = [1, -2, 3, -4].traverse(x ->
    seen = seen :+ x
    if x > 0 then Ok(x) else Err[int, string](s"bad $x"))
  assertEq(firstBad, Err("bad -2"))
  assertEq(seen, [1, -2, 3, -4])
  val parsed: Vector[Result[int, string]] = [Ok(1), Ok(2)]
  assertEq(parsed.sequence(), Ok([1, 2]))
  assertEq(Queue(1, 2).traverse(x -> Right[string, int](x * 2)).map(q -> q.toVector), Right([2, 4]))
  assertEq(ArraySeq.fill(2, 3).traverse(halved), None)
  assertEq(ArraySeq.fill(2, 4).traverse(halved).map(a -> a.toVector), Some([2, 2]))
  assertEq(Some(4).traverse(x -> [x, x + 1]), [Some(4), Some(5)])
  val none: Option[int] = None
  assertEq(none.traverse(x -> [x]), [None])
  val ok: Result[int, string] = Ok(8)
  assertEq(ok.traverse(halved), Some(Ok(4)))
  val right: Either[string, int] = Right(3)
  assertEq(right.traverse(halved), None)
  // A traversal into a sequence is every combination.
  assertEq([1, 2].traverse(x -> [x, -x]), [[1, 2], [1, -2], [-1, 2], [-1, -2]])

@test("a future is a sendable monad, its pure a future already complete")
futureSendableMonad()
  assertEq(Future.pure(3).await(), 3)
  val chained = Future(2).flatMap(x -> Future.pure(x * 5)).map(x -> s"$x")
  assertEq(chained.await(), "10")
