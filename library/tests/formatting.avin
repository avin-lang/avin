// Format specifiers at their edges: a width narrower than the value, a precision past its length,
// zero, negative zero and the extreme integers, and the Debug form of nested values.

@test("a width narrower than the value leaves the value whole")
narrowWidth()
  assertEq(f"${12345}%3d", "12345")
  assertEq(f"${"abcdef"}%2s", "abcdef")
  assertEq(f"${-1}%1d", "-1")

@test("a string's precision takes at most that many characters, and none for zero")
stringPrecision()
  assertEq(f"[${"zoë"}%.2s]", "[zo]")
  assertEq(f"[${"zoë"}%.3s]", "[zoë]")
  assertEq(f"[${"zoë"}%.9s]", "[zoë]")
  assertEq(f"[${"zoë"}%.0s]", "[]")
  assertEq(f"[${"zoë"}%5.2s]", "[   zo]")
  assertEq(f"[${""}%3s]", "[   ]")
  assertEq(f"[${""}%-3s|]", "[   |]")

@test("integers at zero and at the ends of their range")
integerExtremes()
  val least: long = -9223372036854775807 - 1
  val greatest: long = 9223372036854775807
  assertEq(f"${least}%d", "-9223372036854775808")
  assertEq(f"${greatest}%x", "7fffffffffffffff")
  assertEq(f"${least}%x", "-8000000000000000")
  assertEq(f"${0}%d|${0}%x|${0}%o|${0}%b", "0|0|0|0")
  assertEq(f"${0}%05d", "00000")
  assertEq(f"${-0}%+d", "+0")
  assertEq(f"${0}%.0x", "")

@test("reals at zero, negative zero and halfway values round half to even")
realEdges()
  assertEq(f"${0.0}%f", "0.000000")
  assertEq(f"${0.0}%e", "0.000000e+00")
  assertEq(f"${0.0}%g", "0")
  assertEq(f"${-0.0}%.1f", "-0.0")
  assertEq(f"${0.5}%.0f", "0")
  assertEq(f"${1.5}%.0f", "2")
  assertEq(f"${-0.5}%.0f", "-0")
  assertEq(f"${9.995}%.2f", "9.99")
  assertEq(f"${0.125}%.2f", "0.12")
  assertEq(f"${999999.5}%.0f", "1000000")
  assertEq(f"${1e-7}%g", "1e-07")
  assertEq(f"${123456789.0}%.3e", "1.235e+08")

@test("Debug quotes and escapes strings and characters, inside collections too")
debugForms()
  assertEq(f"${"a\"b\n"}%?", "\"a\\\"b\\n\"")
  assertEq(f"${'\''}%?", "'\\''")
  assertEq(f"${["x", ""]}%?", "[\"x\", \"\"]")
  assertEq(f"${Some("x")}%?", "Some(\"x\")")
  assertEq(f"[${"ab"}%6?]", "[  \"ab\"]")
  assertEq(f"[${"ab"}%-6?]", "[\"ab\"  ]")

@test("collections display their elements and an empty one displays its brackets")
collectionDisplay()
  val empty: Vector[int] = []
  assertEq(s"$empty", "[]")
  assertEq(s"${[1]}", "[1]")
  assertEq(s"${List(1, 2)}", "[1, 2]")
  assertEq(s"${List.empty[int]()}", "[]")
  assertEq(s"${Map.empty[string, int]()}", "{}")
  assertEq(s"${Set(3)}", "{3}")
  assertEq(s"${TreeMap((2, "b"), (1, "a"))}", "{1: a, 2: b}")
  assertEq(f"[${[1, 2]}%8s]", "[  [1, 2]]")

@test("a character's width counts it as one, whatever its encoding's length")
charWidth()
  assertEq(f"[${'😀'}%3c]", "[  😀]")
  assertEq(f"[${'é'}%-2c|]", "[é |]")
