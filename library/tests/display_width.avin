// The columns of a terminal a character and a string take, padding and truncating by them, and the
// field widths of formatting, which count them.

@test("an ASCII character takes one column, a control character none")
asciiChars()
  assertEq('a'.displayWidth, 1)
  assertEq(' '.displayWidth, 1)
  assertEq('~'.displayWidth, 1)
  assertEq('0'.displayWidth, 1)
  assertEq('\u{0}'.displayWidth, 0)
  assertEq('\t'.displayWidth, 0)
  assertEq('\n'.displayWidth, 0)
  assertEq('\u{1f}'.displayWidth, 0)
  assertEq('\u{7f}'.displayWidth, 0)

@test("the C1 controls take none, and the first characters past them one")
latinOne()
  assertEq('\u{80}'.displayWidth, 0)
  assertEq('\u{85}'.displayWidth, 0)
  assertEq('\u{9f}'.displayWidth, 0)
  assertEq('\u{a0}'.displayWidth, 1)
  assertEq('é'.displayWidth, 1)
  assertEq('ÿ'.displayWidth, 1)

@test("combining marks, joiners, variation selectors and format characters take no column")
zeroWidthChars()
  assertEq('\u{301}'.displayWidth, 0)
  assertEq('\u{20e3}'.displayWidth, 0)
  assertEq('\u{200b}'.displayWidth, 0)
  assertEq('\u{200d}'.displayWidth, 0)
  assertEq('\u{200e}'.displayWidth, 0)
  assertEq('\u{2060}'.displayWidth, 0)
  assertEq('\u{feff}'.displayWidth, 0)
  assertEq('\u{fe0e}'.displayWidth, 0)
  assertEq('\u{fe0f}'.displayWidth, 0)
  assertEq('\u{e0100}'.displayWidth, 0)
  assertEq('\u{e0067}'.displayWidth, 0)
  assertEq('\u{1161}'.displayWidth, 0)
  assertEq('\u{11a8}'.displayWidth, 0)
  assertEq('\u{d7b0}'.displayWidth, 0)

@test("the format characters that are shown take a column")
shownFormatChars()
  assertEq('\u{ad}'.displayWidth, 1)
  assertEq('\u{600}'.displayWidth, 1)
  assertEq('\u{110bd}'.displayWidth, 1)

@test("wide and fullwidth characters take two columns, halfwidth and ambiguous ones one")
wideChars()
  assertEq('中'.displayWidth, 2)
  assertEq('あ'.displayWidth, 2)
  assertEq('한'.displayWidth, 2)
  assertEq('\u{1100}'.displayWidth, 2)
  assertEq('Ａ'.displayWidth, 2)
  assertEq('\u{3000}'.displayWidth, 2)
  assertEq('\u{20000}'.displayWidth, 2)
  assertEq('\u{2fffd}'.displayWidth, 2)
  assertEq('\u{3fffd}'.displayWidth, 2)
  assertEq('ｱ'.displayWidth, 1)
  assertEq('α'.displayWidth, 1)
  assertEq('…'.displayWidth, 1)
  assertEq('\u{10ffff}'.displayWidth, 1)
  assertEq('\u{e000}'.displayWidth, 1)

@test("an emoji shown as a picture by default takes two columns, one shown as text one")
emojiChars()
  assertEq('😀'.displayWidth, 2)
  assertEq('👍'.displayWidth, 2)
  assertEq('\u{1f3fd}'.displayWidth, 2)
  assertEq('❤'.displayWidth, 1)
  assertEq('☺'.displayWidth, 1)
  assertEq('\u{1f1ef}'.displayWidth, 1)

@test("the empty string takes no columns, and ASCII text a column a character")
asciiText()
  assertEq("".displayWidth, 0)
  assertEq("hello".displayWidth, 5)
  assertEq("a b".displayWidth, 3)
  assertEq("a\tb\n".displayWidth, 2)
  assertEq("\u{0}\u{7f}".displayWidth, 0)

@test("a combining mark joins the character before it")
combiningText()
  assertEq("e\u{301}".displayWidth, 1)
  assertEq("é".displayWidth, 1)
  assertEq("a\u{300}\u{301}\u{302}".displayWidth, 1)
  assertEq("cafe\u{301}s".displayWidth, 5)
  assertEq("\u{301}".displayWidth, 0)
  assertEq("\u{301}a".displayWidth, 1)
  assertEq("中\u{301}".displayWidth, 2)
  assertEq("\n\u{301}".displayWidth, 0)

@test("Hangul syllables, and the conjoining jamo that make one, take two columns")
hangulText()
  assertEq("한국어".displayWidth, 6)
  assertEq("\u{1100}\u{1161}\u{11a8}".displayWidth, 2)
  assertEq("\u{1100}\u{1161}".displayWidth, 2)

@test("CJK and fullwidth text takes two columns a character, mixed with ASCII one")
cjkText()
  assertEq("日本語".displayWidth, 6)
  assertEq("漢字abc".displayWidth, 7)
  assertEq("ＡＢＣ".displayWidth, 6)
  assertEq("ｱｲｳ".displayWidth, 3)

@test("an emoji with a skin tone, a joined family and a flag each take two columns")
emojiText()
  assertEq("😀".displayWidth, 2)
  assertEq("👍🏽".displayWidth, 2)
  assertEq("👩🏽‍💻".displayWidth, 2)
  assertEq("👨‍👩‍👧".displayWidth, 2)
  assertEq("👨‍👩‍👧‍👦".displayWidth, 2)
  assertEq("🇯🇵".displayWidth, 2)
  assertEq("🇯🇵🇺🇸".displayWidth, 4)
  assertEq("\u{1f1ef}\u{1f1f5}\u{1f1fa}".displayWidth, 3)
  assertEq("\u{1f3f4}\u{e0067}\u{e0062}\u{e0065}\u{e006e}\u{e0067}\u{e007f}".displayWidth, 2)
  assertEq("a😀b".displayWidth, 4)

@test("a variation selector 16 makes an emoji two columns; one 15, or after a non-emoji, changes nothing")
variationSelectors()
  assertEq("❤\u{fe0f}".displayWidth, 2)
  assertEq("☺\u{fe0f}".displayWidth, 2)
  assertEq("1\u{fe0f}\u{20e3}".displayWidth, 2)
  assertEq("#\u{fe0f}\u{20e3}".displayWidth, 2)
  assertEq("1\u{20e3}".displayWidth, 1)
  assertEq("a\u{fe0f}".displayWidth, 1)
  assertEq("😀\u{fe0e}".displayWidth, 2)
  assertEq("❤\u{fe0e}".displayWidth, 1)

@test("a skin tone joins only an emoji, and a zero-width joiner only joins pictographs")
joinersAndModifiers()
  assertEq("a\u{1f3fd}".displayWidth, 3)
  assertEq("\u{1f3fd}".displayWidth, 2)
  assertEq("☝\u{1f3fd}".displayWidth, 2)
  assertEq("a\u{200d}😀".displayWidth, 3)
  assertEq("😀\u{200d}a".displayWidth, 3)
  assertEq("😀\u{200d}".displayWidth, 2)
  assertEq("\u{200d}😀".displayWidth, 2)
  assertEq("\u{200b}\u{200b}".displayWidth, 0)
  assertEq("😀\n\u{200d}😀".displayWidth, 4)

@test("padStartWidth and padEndWidth pad to columns, and leave text that wide as it is")
paddingByWidth()
  assertEq("日本".padEndWidth(6), "日本  ")
  assertEq("日本".padStartWidth(6, '.'), "..日本")
  assertEq("日本".padEndWidth(4), "日本")
  assertEq("日本".padEndWidth(3), "日本")
  assertEq("日本".padStartWidth(-1), "日本")
  assertEq("e\u{301}".padEndWidth(3), "e\u{301}  ")
  assertEq("👍🏽".padStartWidth(3), " 👍🏽")
  assertEq("".padStartWidth(2, '0'), "00")
  assertEq("".padEndWidth(0), "")
  assertEq("abc".padEndWidth(5), "abc  ")
  assertEq("abc".padEndWidth(5), "abc".padEnd(5))

@test("a wide fill character fills two columns at a time, and a space the one left over")
wideFill()
  assertEq("a".padEndWidth(5, '中'), "a中中")
  assertEq("a".padEndWidth(4, '中'), "a中 ")
  assertEq("a".padStartWidth(2, '中'), " a")
  assertEq("".padStartWidth(3, '・'), "・ ")

@test("truncateWidth keeps the clusters that fit with the ellipsis after them")
truncating()
  assertEq("hello world".truncateWidth(8), "hello w…")
  assertEq("short".truncateWidth(10), "short")
  assertEq("abc".truncateWidth(3), "abc")
  assertEq("abcd".truncateWidth(3), "ab…")
  assertEq("日本語テキスト".truncateWidth(7), "日本語…")
  assertEq("日本語テキスト".truncateWidth(6), "日本…")
  assertEq("e\u{301}e\u{301}e\u{301}".truncateWidth(2), "e\u{301}…")
  assertEq("👍🏽👍🏽".truncateWidth(3), "👍🏽…")
  assertEq("👨‍👩‍👧x".truncateWidth(2), "…")
  assertEq("abcdef".truncateWidth(5, "..."), "ab...")
  assertEq("abcd".truncateWidth(3, ""), "abc")

@test("truncateWidth with no room keeps nothing, and keeps no ellipsis wider than the width")
truncatingEdges()
  assertEq("abcd".truncateWidth(0), "")
  assertEq("abcd".truncateWidth(-1), "")
  assertEq("".truncateWidth(0), "")
  assertEq("".truncateWidth(-1), "")
  assertEq("abcd".truncateWidth(1), "…")
  assertEq("abcd".truncateWidth(2, "..."), "ab")
  assertEq("日本".truncateWidth(1, "..."), "")
  assertEq("日本".truncateWidth(3), "日…")
  assertEq("\u{301}abc".truncateWidth(2), "\u{301}a…")

@test("a formatted field pads to columns, so wide and combining text lines up")
formatWidths()
  val wide = "日本"
  val combined = "e\u{301}"
  assertEq(f"[${wide}%6s]", "[  日本]")
  assertEq(f"[${wide}%-6s]", "[日本  ]")
  assertEq(f"[${wide}%3s]", "[日本]")
  assertEq(f"[${combined}%3s]", "[  e\u{301}]")
  assertEq(f"[${'中'}%-3c]", "[中 ]")
  assertEq(f"[${wide}%-6?]", "[\"日本\"]")
  assertEq(f"[${"ab"}%4s]", "[  ab]")
  assertEq(f"[${"👍🏽"}%-4s]", "[👍🏽  ]")
