// `avin.net.http`'s `CookieJar`: what it stores from a `Set-Cookie` header and what a request to a URL
// carries back, by RFC 6265 and its revision, with its examples; host-only and domain cookies, the
// single-label domains it refuses, paths, `Secure` and the cookies an `http` URL may not replace,
// `HttpOnly` and `SameSite` kept, `Max-Age` and `Expires` against an injected clock, the `__Host-` and
// `__Secure-` prefixes, and its limits and what they evict.
import avin.net.Url
import avin.net.http.{CookieJar, Lax, Strict, Unrestricted}
import avin.threads.Atomic
import avin.time.{Instant, days, epochSeconds}

// A jar's clock: the seconds `at` holds since the epoch.
clockOf(at: Atomic[long]) -> @sendable () -> Instant = () -> epochSeconds(at.load())

// 2021-06-09T10:18:14Z, the `Expires` of RFC 6265's example.
val RfcExpiry: long = 1623233894

// A jar at a clock set to an hour before `RfcExpiry`.
jarAt(at: Atomic[long]) -> CookieJar = CookieJar(clock = clockOf(at))

// The jar's cookies as `name=value@domain path` with `host` for a host-only one.
shown(jar: CookieJar) -> Vector[string] = jar.all().map(c ->
  s"${c.name}=${c.value}@${c.domain}${if c.hostOnly then " host" else ""} ${c.path}"

)

@test("RFC 6265 3.1: a cookie with no Domain goes back to the host that set it, on any path")
hostOnly()
  val jar = CookieJar()
  assert(jar.setCookie("http://example.com/", "SID=31d4d96e407aad42"))
  assertEq(jar.header("http://example.com/"), Some("SID=31d4d96e407aad42"))
  assertEq(jar.header("http://example.com/any/path?q=1"), Some("SID=31d4d96e407aad42"))
  assertEq(jar.header("http://www.example.com/"), None)
  assertEq(jar.header("http://other.com/"), None)
  assertEq(shown(jar), ["SID=31d4d96e407aad42@example.com host /"])

@test("RFC 6265 3.1: Secure and HttpOnly with Path=/, and a Domain cookie for the subdomains")
secureAndDomain()
  val jar = CookieJar()
  assert(jar.setCookie("https://www.example.com/", "SID=31d4d96e407aad42; Path=/; Secure; HttpOnly"))
  assert(jar.setCookie("https://www.example.com/", "lang=en-US; Path=/; Domain=example.com"))
  assertEq(jar.header("https://www.example.com/"), Some("SID=31d4d96e407aad42; lang=en-US"))
  assertEq(jar.header("http://www.example.com/"), Some("lang=en-US"))
  assertEq(jar.header("https://example.com/"), Some("lang=en-US"))
  assertEq(jar.header("https://deep.www.example.com/"), Some("lang=en-US"))
  assertEq(jar.header("https://notexample.com/"), None)
  val sid = jar.all()(0)
  assert(sid.secure && sid.httpOnly && sid.hostOnly)
  val lang = jar.all()(1)
  assert(!lang.secure && !lang.httpOnly && !lang.hostOnly)
  assertEq(jar.cookies("https://www.example.com/").map(c -> c.name), ["SID", "lang"])

@test("RFC 6265 3.1: Expires keeps a cookie until then, and a past Expires removes it")
expiresExample()
  val at = Atomic(RfcExpiry - 3600)
  val jar = jarAt(at)
  assert(jar.setCookie("http://www.example.com/", "lang=en-US; Expires=Wed, 09 Jun 2021 10:18:14 GMT"))
  assertEq(jar.header("http://www.example.com/"), Some("lang=en-US"))
  assertEq(jar.all()(0).expires, Some(epochSeconds(RfcExpiry)))
  at.store(RfcExpiry - 1)
  assertEq(jar.size, 1)
  at.store(RfcExpiry)
  assertEq(jar.header("http://www.example.com/"), None)
  assertEq(jar.size, 0)
  at.store(RfcExpiry - 3600)
  assert(jar.setCookie("http://www.example.com/", "lang=en-US"))
  assert(jar.setCookie("http://www.example.com/", "lang=; Expires=Sun, 06 Nov 1994 08:49:37 GMT"))
  assertEq(jar.size, 0)

@test("Max-Age wins over Expires, and zero or less removes the cookie")
maxAge()
  val at = Atomic(RfcExpiry)
  val jar = jarAt(at)
  assert(jar.setCookie("http://a.test/", "m=1; Max-Age=60; Expires=Sun, 06 Nov 1994 08:49:37 GMT"))
  assertEq(jar.all()(0).expires, Some(epochSeconds(RfcExpiry + 60)))
  assert(jar.setCookie("http://a.test/", "e=1; Expires=Sun, 06 Nov 1994 08:49:37 GMT; Max-Age=60"))
  assertEq(jar.size, 2)
  at.store(RfcExpiry + 59)
  assertEq(jar.header("http://a.test/"), Some("m=1; e=1"))
  at.store(RfcExpiry + 60)
  assertEq(jar.header("http://a.test/"), None)
  assert(jar.setCookie("http://a.test/", "z=1"))
  assert(jar.setCookie("http://a.test/", "z=1; Max-Age=0"))
  assertEq(jar.size, 0)
  assert(jar.setCookie("http://a.test/", "z=1"))
  assert(jar.setCookie("http://a.test/", "z=1; Max-Age=-5"))
  assertEq(jar.size, 0)
  assert(jar.setCookie("http://a.test/", "never=1; Max-Age=0"))
  assertEq(jar.size, 0)
  assert(jar.setCookie("http://a.test/", "bad=1; Max-Age=soon"))
  assertEq(jar.all()(0).expires, None)

@test("Max-Age and Expires are cut to 400 days, the largest Max-Age too")
lifetimeCap()
  val at = Atomic(RfcExpiry)
  val jar = jarAt(at)
  val cap = Some(epochSeconds(RfcExpiry) + days(400))
  assert(jar.setCookie("http://a.test/", "big=1; Max-Age=9223372036854775807"))
  assert(jar.setCookie("http://a.test/", "year=1; Max-Age=34560000"))
  assert(jar.setCookie("http://a.test/", "far=1; Expires=Fri, 01 Jan 2100 00:00:00 GMT"))
  assert(jar.setCookie("http://a.test/", "under=1; Max-Age=34559999"))
  assertEq(jar.all().map(c -> c.expires), [cap, cap, cap, Some(epochSeconds(RfcExpiry + 34559999))])

@test("a Domain must be the host or a domain above it, and a single label only the host's own")
domains()
  val jar = CookieJar()
  assert(!jar.setCookie("http://example.com/", "a=1; Domain=other.com"))
  assert(!jar.setCookie("http://example.com/", "a=1; Domain=www.example.com"))
  assert(!jar.setCookie("http://www.example.com/", "a=1; Domain=com"))
  assert(!jar.setCookie("http://www.example.com/", "a=1; Domain=.com"))
  assert(!jar.setCookie("http://ample.com/", "a=1; Domain=example.com"))
  assert(!jar.setCookie("http://badexample.com/", "a=1; Domain=example.com"))
  assertEq(jar.size, 0)
  assert(jar.setCookie("http://www.example.com/", "dot=1; Domain=.EXAMPLE.com"))
  assert(jar.setCookie("http://example.com/", "same=1; Domain=example.com"))
  assertEq(shown(jar), ["dot=1@example.com /", "same=1@example.com /"])
  assertEq(jar.header("http://x.y.example.com/"), Some("dot=1; same=1"))
  jar.clear()
  assert(jar.setCookie("http://localhost:8080/", "l=1; Domain=localhost"))
  assertEq(shown(jar), ["l=1@localhost host /"])
  assertEq(jar.header("http://localhost/"), Some("l=1"))
  assertEq(jar.header("http://app.localhost/"), None)
  assert(!jar.setCookie("http://app.localhost/", "l=2; Domain=localhost"))

@test("an IP address is a domain only to itself, and IPv6 hosts are host-only")
addresses()
  val jar = CookieJar()
  assert(jar.setCookie("http://127.0.0.1/", "ip=1; Domain=127.0.0.1"))
  assert(!jar.setCookie("http://127.0.0.1/", "ip=2; Domain=0.0.1"))
  assert(!jar.setCookie("http://10.0.0.1/", "ip=3; Domain=0.1"))
  assertEq(jar.header("http://127.0.0.1/"), Some("ip=1"))
  assertEq(jar.header("http://1.127.0.0.1/"), None)
  assert(jar.setCookie("http://[::1]:8080/", "six=1"))
  assertEq(jar.header("http://[::1]/"), Some("six=1"))
  assertEq(jar.header("http://[::2]/"), None)
  assert(!jar.setCookie("http://[::1]/", "six=2; Domain=::1"))

@test("cookies ignore the port, and a host's trailing dot and case")
portsAndCase()
  val jar = CookieJar()
  assert(jar.setCookie("http://Example.COM.:8080/", "p=1"))
  assertEq(jar.header("http://example.com:9090/"), Some("p=1"))
  assertEq(jar.header("http://EXAMPLE.com/"), Some("p=1"))
  assertEq(jar.header("http://example.com./"), Some("p=1"))

@test("the default path is the request's up to its last slash, and a Path not starting with / is none")
defaultPaths()
  val jar = CookieJar()
  assert(jar.setCookie("http://a.test/docs/web/page", "a=1"))
  assert(jar.setCookie("http://a.test/page", "b=1"))
  assert(jar.setCookie("http://a.test", "c=1"))
  assert(jar.setCookie("http://a.test/docs/web/", "d=1"))
  assert(jar.setCookie("http://a.test/x/y?q=/z/w", "e=1; Path=relative"))
  assertEq(jar.all().map(c -> c.path), ["/docs/web", "/", "/", "/docs/web", "/x"])

@test("a path matches itself, below it at a slash, and not a longer name or above it")
pathMatching()
  val jar = CookieJar()
  assert(jar.setCookie("http://a.test/", "p=1; Path=/docs"))
  assert(jar.setCookie("http://a.test/", "s=1; Path=/docs/"))
  assertEq(jar.header("http://a.test/docs"), Some("p=1"))
  assertEq(jar.header("http://a.test/docs/"), Some("s=1; p=1"))
  assertEq(jar.header("http://a.test/docs/web/x"), Some("s=1; p=1"))
  assertEq(jar.header("http://a.test/docsx"), None)
  assertEq(jar.header("http://a.test/"), None)
  assertEq(jar.header("http://a.test/Docs"), None)

@test("longer paths go first, then the earlier created, then the earlier stored")
sendOrder()
  val at = Atomic(RfcExpiry)
  val jar = jarAt(at)
  assert(jar.setCookie("http://a.test/", "a=1; Path=/"))
  at.store(RfcExpiry + 1)
  assert(jar.setCookie("http://a.test/", "b=2; Path=/x/y"))
  assert(jar.setCookie("http://a.test/", "c=3; Path=/x"))
  assert(jar.setCookie("http://a.test/", "d=4; Path=/x"))
  at.store(RfcExpiry - 10)
  assert(jar.setCookie("http://a.test/", "early=5; Path=/x"))
  assertEq(jar.header("http://a.test/x/y/z"), Some("b=2; early=5; c=3; d=4; a=1"))

@test("a cookie of the same name, domain and path replaces the stored one and keeps its creation")
replacing()
  val at = Atomic(RfcExpiry)
  val jar = jarAt(at)
  assert(jar.setCookie("http://a.test/", "id=1"))
  at.store(RfcExpiry + 100)
  assert(jar.setCookie("http://a.test/", "id=2; HttpOnly; SameSite=Strict"))
  assertEq(jar.size, 1)
  val c = jar.all()(0)
  assertEq(c.value, "2")
  assertEq(c.created, epochSeconds(RfcExpiry))
  assert(c.httpOnly)
  assertEq(c.sameSite, Some(Strict))
  assert(jar.setCookie("http://a.test/", "id=3; Path=/other"))
  assert(jar.setCookie("http://www.a.test/", "id=4; Domain=a.test"))
  assert(jar.setCookie("http://a.test/", "id=5; Domain=a.test"))
  assertEq(shown(jar), ["id=2@a.test host /", "id=3@a.test host /other", "id=5@a.test /"])
  assertEq(jar.header("http://a.test/"), Some("id=2; id=5"))

@test("HttpOnly and SameSite are kept and do not hold a cookie back")
keptAttributes()
  val jar = CookieJar()
  assert(jar.setCookie("https://a.test/", "h=1; HttpOnly"))
  assert(jar.setCookie("https://a.test/", "l=1; SameSite=Lax"))
  assert(jar.setCookie("https://a.test/", "s=1; SameSite=Strict"))
  assert(jar.setCookie("https://a.test/", "n=1; SameSite=None; Secure"))
  assert(!jar.setCookie("https://a.test/", "bad=1; SameSite=None"))
  assertEq(jar.all().map(c -> c.sameSite), [None, Some(Lax), Some(Strict), Some(Unrestricted)])
  assertEq(jar.header("https://a.test/"), Some("h=1; l=1; s=1; n=1"))
  assertEq(jar.header("http://a.test/"), Some("h=1; l=1; s=1"))

@test("Secure is stored only from https, and http may not replace or shadow a Secure cookie")
secureRules()
  val jar = CookieJar()
  assert(!jar.setCookie("http://a.test/", "s=1; Secure"))
  assert(jar.setCookie("https://a.test/", "s=1; Secure"))
  assert(!jar.setCookie("http://a.test/", "s=2"))
  assert(!jar.setCookie("http://a.test/", "s=2; Path=/deeper"))
  assert(!jar.setCookie("http://www.a.test/", "s=2; Domain=a.test"))
  assert(jar.setCookie("http://a.test/", "t=2"))
  assertEq(jar.header("https://a.test/"), Some("s=1; t=2"))
  assert(jar.setCookie("https://a.test/", "p=1; Secure; Path=/a"))
  assert(jar.setCookie("http://a.test/", "p=2; Path=/"))
  assert(jar.setCookie("https://a.test/", "s=3"))
  assertEq(jar.header("https://a.test/a"), Some("p=1; s=3; t=2; p=2"))
  assertEq(jar.header("http://a.test/a"), Some("s=3; t=2; p=2"))

@test("the __Secure- and __Host- prefixes, compared without regard to case")
prefixes()
  val jar = CookieJar()
  assert(jar.setCookie("https://a.test/", "__Secure-a=1; Secure"))
  assert(!jar.setCookie("https://a.test/", "__Secure-b=1"))
  assert(!jar.setCookie("http://a.test/", "__Secure-c=1; Secure"))
  assert(jar.setCookie("https://a.test/x", "__Host-d=1; Secure; Path=/"))
  assert(!jar.setCookie("https://a.test/", "__Host-e=1; Secure"))
  assert(!jar.setCookie("https://a.test/", "__Host-f=1; Secure; Path=/x"))
  assert(!jar.setCookie("https://www.a.test/", "__Host-g=1; Secure; Path=/; Domain=a.test"))
  assert(!jar.setCookie("http://a.test/", "__Host-h=1; Secure; Path=/"))
  assert(!jar.setCookie("https://a.test/", "__HOST-i=1; Path=/"))
  assert(!jar.setCookie("https://a.test/", "__secure-j=1"))
  assertEq(shown(jar), ["__Secure-a=1@a.test host /", "__Host-d=1@a.test host /"])

@test("a header that is no cookie, and a URL that is not http or https, take none")
refused()
  val jar = CookieJar()
  assert(!jar.setCookie("http://a.test/", "no equals sign"))
  assert(!jar.setCookie("http://a.test/", "=value"))
  assert(!jar.setCookie("http://a.test/", "café=1"))
  assert(!jar.setCookie("http://a.test/", "a=b c"))
  assert(!jar.setCookie("http://a.test/", ""))
  assert(!jar.setCookie("not a url", "a=1"))
  assert(!jar.setCookie("ftp://a.test/", "a=1"))
  assert(!jar.setCookie("file:///etc", "a=1"))
  assertEq(jar.size, 0)
  assertEq(jar.header("ftp://a.test/"), None)
  assertEq(jar.header("not a url"), None)
  assert(jar.setCookie("http://a.test/", "empty="))
  assert(jar.setCookie("http://a.test/", "q=\"quoted\""))
  assertEq(jar.header("http://a.test/"), Some("empty=; q=quoted"))

@test("a cookie over maxCookieBytes, name and value together, is refused")
cookieSize()
  val jar = CookieJar(maxCookieBytes = 10)
  assert(jar.setCookie("http://a.test/", "abcde=12345"))
  assert(!jar.setCookie("http://a.test/", "abcde=123456"))
  assertEq(jar.header("http://a.test/"), Some("abcde=12345"))
  val big = CookieJar()
  assert(big.setCookie("http://a.test/", "n=" + "v".repeat(4095)))
  assert(!big.setCookie("http://a.test/", "n2=" + "v".repeat(4095)))

@test("over maxPerDomain, the domain's least recently sent or stored cookie goes")
perDomain()
  val at = Atomic(RfcExpiry)
  val jar = CookieJar(maxPerDomain = 2, clock = clockOf(at))
  assert(jar.setCookie("http://a.test/", "a=1"))
  at.store(RfcExpiry + 1)
  assert(jar.setCookie("http://a.test/", "b=1; Path=/b"))
  at.store(RfcExpiry + 2)
  assertEq(jar.header("http://a.test/"), Some("a=1"))
  at.store(RfcExpiry + 3)
  assert(jar.setCookie("http://other.test/", "o=1"))
  assert(jar.setCookie("http://a.test/", "c=1"))
  assertEq(shown(jar), ["a=1@a.test host /", "o=1@other.test host /", "c=1@a.test host /"])
  assert(jar.setCookie("http://a.test/", "c=2"))
  assertEq(jar.size, 3)

@test("an expired cookie is evicted before a live one")
evictExpiredFirst()
  val at = Atomic(RfcExpiry)
  val jar = CookieJar(maxPerDomain = 2, clock = clockOf(at))
  assert(jar.setCookie("http://a.test/", "old=1"))
  assert(jar.setCookie("http://a.test/", "soon=1; Max-Age=5"))
  at.store(RfcExpiry + 10)
  assert(jar.setCookie("http://a.test/", "new=1"))
  assertEq(shown(jar), ["old=1@a.test host /", "new=1@a.test host /"])

@test("over maxCookies, the jar's least recently sent or stored cookie goes")
total()
  val at = Atomic(RfcExpiry)
  val jar = CookieJar(maxCookies = 3, clock = clockOf(at))
  val hosts = ["a.test", "b.test", "c.test"]
  for i in 0 ..< hosts.length
    at.store(RfcExpiry + long(i))
    assert(jar.setCookie(s"http://${hosts(i)}/", s"${hosts(i)}=1"))
  at.store(RfcExpiry + 10)
  assertEq(jar.header("http://a.test/"), Some("a.test=1"))
  assert(jar.setCookie("http://d.test/", "d.test=1"))
  assertEq(jar.all().map(c -> c.name), ["a.test", "c.test", "d.test"])
  val one = CookieJar(maxCookies = 1, maxPerDomain = 1)
  for i in 0 ..< 5
    assert(one.setCookie("http://a.test/", s"k$i=1"))
  assertEq(one.all().map(c -> c.name), ["k4"])

@test("clear removes every cookie and clearSession those with no expiry")
clearing()
  val jar = CookieJar()
  assert(jar.setCookie("http://a.test/", "session=1"))
  assert(jar.setCookie("http://a.test/", "kept=1; Max-Age=600"))
  jar.clearSession()
  assertEq(jar.all().map(c -> c.name), ["kept"])
  jar.clear()
  assertEq(jar.size, 0)
  assertEq(jar.header("http://a.test/"), None)

@test("receive stores every Set-Cookie of a response's headers, in any case")
receiving()
  val jar = CookieJar()
  val url = Url("https://a.test/login")
  jar.receive(
    url,
    [("set-cookie", "a=1"), ("Content-Type", "text/plain"), ("SET-COOKIE", "b=2; Secure"), ("Set-Cookie", "bad")]
  )
  assertEq(jar.header(Url("https://a.test/")), Some("a=1; b=2"))
  assertEq(jar.cookies("https://a.test/").length, 2)
