// List and Vector at their edges: empty, one element, counts below zero and past the end, and for a
// vector the lengths where its tree grows another level.

// The vector 0, 1, …, n - 1, built by appending.
appendedUpTo(n: int) -> Vector[int]
    var v: Vector[int] = []
    for i in 0..<n do v = v :+ i
    v

// The vector 0, 1, …, n - 1, built by prepending.
prependedUpTo(n: int) -> Vector[int]
    var v: Vector[int] = []
    var i = n - 1
    while i >= 0
        v = i +: v
        i -= 1
    v

// Whether `v` holds exactly 0, 1, …, n - 1, read by index, by iterator and in reverse.
holdsUpTo(v: Vector[int], n: int) -> bool
    if v.length() != n then return false
    for i in 0..<n
        if v(i) != i then return false
    var expected = 0
    for x in v
        if x != expected then return false
        expected += 1
    if expected != n then return false
    val back = v.reverseIterator()
    var i = n - 1
    while back.hasNext()
        if back.next() != i then return false
        i -= 1
    i == -1

@test("a vector appended and prepended to across the lengths where its tree deepens")
vectorLevels()
    for n in [0, 1, 31, 32, 33, 63, 64, 65, 1023, 1024, 1025, 1056, 32768, 32769]
        assert(holdsUpTo(appendedUpTo(n), n), s"appended $n")
        assert(holdsUpTo(prependedUpTo(n), n), s"prepended $n")

@test("a vector grown at both ends holds its elements in order")
vectorBothEnds()
    var v: Vector[int] = [0]
    for i in 1..2000
        v = v :+ i
        v = -i +: v
    assertEq(v.length(), 4001)
    assertEq(v.head(), -2000)
    assertEq(v.last(), 2000)
    for i in 0..<v.length()
        assertEq(v(i), i - 2000)

@test("slicing a vector across leaves, and with bounds clamped at both ends")
vectorSlices()
    val v = appendedUpTo(2000)
    assert(holdsUpTo(v.take(1025), 1025))
    assertEq(v.drop(1990), [1990, 1991, 1992, 1993, 1994, 1995, 1996, 1997, 1998, 1999])
    assertEq(v.slice(31, 34), [31, 32, 33])
    assertEq(v.slice(5, 5).length(), 0)
    assertEq(v.take(-3).length(), 0)
    assertEq(v.take(5000).length(), 2000)
    assertEq(v.drop(-3).length(), 2000)
    assertEq(v.drop(5000).length(), 0)
    assertEq(v.takeRight(2), [1998, 1999])
    assertEq(v.dropRight(1998), [0, 1])
    assertEq(v.tail().head(), 1)
    assertEq(v.init().last(), 1998)
    val (left, right) = v.splitAt(1024)
    assertEq(left.length() + right.length(), 2000)
    assertEq(right.head(), 1024)

@test("updated replaces one element and leaves the original as it was")
vectorUpdated()
    val v = appendedUpTo(1100)
    val w = v.updated(1050, -1).updated(0, -2)
    assertEq(w(1050), -1)
    assertEq(w(0), -2)
    assertEq(v(1050), 1050)
    assertEq(v(0), 0)
    assertEq(w.length(), 1100)

@test(should_trap: "index out of range")
vectorUpdatedPastTheEndTraps()
    appendedUpTo(3).updated(3, 0)

@test(should_trap)
vectorIndexPastTheEndTraps()
    val v = appendedUpTo(33)
    v(33)

@test(should_trap)
emptyVectorHeadTraps()
    val v: Vector[int] = []
    v.head()

@test("++ joins vectors of every relative length")
vectorConcat()
    for (n, m) in [(0, 0), (0, 5), (5, 0), (1, 1), (3, 100), (100, 3), (100, 100), (70, 500), (500, 70), (1000, 1000)]
        val joined = appendedUpTo(n) ++ appendedUpTo(m).map(x -> x + n)
        assert(holdsUpTo(joined, n + m), s"$n ++ $m")

@test("an empty or one-element vector through the common operations")
vectorSmall()
    val empty: Vector[int] = []
    assertEq(empty.reverse().length(), 0)
    assertEq(empty.headOption(), None)
    assertEq(empty.lastOption(), None)
    assertEq(empty.foldLeft(7, (a, x) -> a + x), 7)
    assertEq(empty.reduceOption((a, b) -> a + b), None)
    assertEq(empty.maxOption(), None)
    assertEq(empty.minByOption(x -> -x), None)
    assertEq(empty.grouped(3).toVector().length(), 0)
    val one = [9]
    assertEq(one.reverse(), [9])
    assertEq(one.tail().length(), 0)
    assertEq(one.init().length(), 0)
    assertEq(one.sliding(3).toVector(), [[9]])
    assertEq(one.grouped(2).toVector(), [[9]])
    assertEq(one.zip(empty).length(), 0)
    assertEq(one.zipAll(empty, 0, -1), [(9, -1)])
    assertEq(one.scanLeft(0, (a, x) -> a + x), [0, 9])

@test("grouped and sliding cover every element, the last group short")
vectorWindows()
    val v = appendedUpTo(7)
    assertEq(v.grouped(3).toVector(), [[0, 1, 2], [3, 4, 5], [6]])
    assertEq(v.sliding(3, 2).toVector(), [[0, 1, 2], [2, 3, 4], [4, 5, 6]])
    assertEq(v.sliding(3, 3).toVector(), [[0, 1, 2], [3, 4, 5], [6]])
    assertEq(appendedUpTo(2).sliding(5).toVector(), [[0, 1]])

@test("search and comparison on sequences: first and last occurrences, prefixes and suffixes")
vectorSearch()
    val v = [1, 2, 1, 2]
    assertEq(v.indexOf(2), 1)
    assertEq(v.lastIndexOf(2), 3)
    assertEq(v.indexOf(5), -1)
    assertEq(v.lastIndexOf(5), -1)
    assertEq(v.indexOf(1, 1), 2)
    assertEq(v.indexOf(1, 3), -1)
    assertEq(v.indexOf(1, -4), 0)
    assertEq(v.lastIndexOf(2, 2), 1)
    assertEq(v.lastIndexOf(2, 0), -1)
    assertEq(v.lastIndexOf(2, 99), 3)
    assertEq(v.indexWhere(x -> x > 1), 1)
    assertEq(v.indexWhere(x -> x > 1, 2), 3)
    assertEq(v.indexWhere(x -> x > 1, 4), -1)
    assertEq(v.lastIndexWhere(x -> x < 2), 2)
    assertEq(v.lastIndexWhere(x -> x < 2, 1), 0)
    assertEq(v.lastIndexWhere(x -> x < 2, -1), -1)
    assertEq(Vector.empty[int]().indexWhere(_ -> true), -1)
    val xs = List(1, 2, 1, 2)
    assertEq(xs.indexOf(2), 1)
    assertEq(xs.indexOf(1, 1), 2)
    assertEq(xs.indexWhere(x -> x > 1, 2), 3)
    assertEq(xs.indexWhere(x -> x > 5), -1)
    assertEq(xs.lastIndexOf(1), 2)
    assertEq(xs.lastIndexOf(1, 1), 0)
    assert(v.startsWith([1, 2]) && v.endsWith([1, 2]))
    assert(v.startsWith([]) && v.endsWith([]))
    assert(!v.startsWith([1, 2, 1, 2, 1]))
    assert(!v.endsWith([0, 1, 2, 1, 2]))
    assert(v.sameElements(List(1, 2, 1, 2)))
    assert(!v.sameElements(List(1, 2, 1)))
    assertEq(v.distinct(), [1, 2])
    assertEq([1, 1, 2, 3].intersect([1, 3, 3]), [1, 3])
    assertEq([1, 1, 2, 3].diff([1, 3, 3]), [1, 2])

@test("every collection has head, headOption, last and lastOption in its iteration order")
iterableEnds()
    val s: Set[int] = {7}
    assertEq(s.head(), 7)
    assertEq(s.last(), 7)
    assertEq(s.headOption(), Some(7))
    assertEq(Set.empty[int]().headOption(), None)
    assertEq(Set.empty[int]().lastOption(), None)
    val m: Map[string, int] = {"a": 1}
    assertEq(m.head(), ("a", 1))
    assertEq(m.lastOption(), Some(("a", 1)))
    val it = [1, 2, 3].iterator()
    assertEq(it.head(), 1)
    assertEq(it.next(), 2)
    assertEq([1, 2, 3].iterator().last(), 3)
    assertEq([4, 5].iterator().lastOption(), Some(5))
    assertEq(Vector.empty[int]().iterator().headOption(), None)
    val sorted = TreeSet(3, 1, 2)
    assertEq((sorted.head(), sorted.last()), (1, 3))
    val many: Iterable[int] = TreeSet(5, 4)
    assertEq((many.head(), many.last()), (4, 5))

@test(should_trap: "head of an empty collection")
iterableHeadOfEmptyTraps()
    Set.empty[int]().head()

@test(should_trap: "last of an empty collection")
iterableLastOfEmptyTraps()
    Map.empty[int, int]().last()

@test("a list's take, drop and slice clamp counts below zero and past the end")
listCounts()
    val xs = List(1, 2, 3)
    assertEq(xs.take(-1), List.empty[int]())
    assertEq(xs.take(9), xs)
    assertEq(xs.drop(-1), xs)
    assertEq(xs.drop(9), List.empty[int]())
    assertEq(xs.takeRight(2), List(2, 3))
    assertEq(xs.takeRight(-2), List.empty[int]())
    assertEq(xs.dropRight(2), List(1))
    assertEq(xs.dropRight(9), List.empty[int]())
    assertEq(xs.slice(0, 3), xs)
    assertEq(xs.slice(1, 1), List.empty[int]())
    assertEq(xs.splitAt(1), (List(1), List(2, 3)))
    assertEq(xs.span(x -> x < 3), (List(1, 2), List(3)))
    assertEq(xs.span(x -> false), (List.empty[int](), xs))

@test(should_trap: "slice out of range")
listSlicePastTheEndTraps()
    List(1, 2).slice(1, 3)

@test(should_trap: "init of an empty list")
listInitOfEmptyTraps()
    List.empty[int]().init()

@test(should_trap: "index out of range")
listUpdatedPastTheEndTraps()
    List(1).updated(1, 0)

@test("a list's own operations: reverse, :+, ++, updated and padTo")
listBuilding()
    val xs = List(1, 2, 3)
    assertEq(xs.reverse(), List(3, 2, 1))
    assertEq(xs :+ 4, List(1, 2, 3, 4))
    assertEq(0 +: xs, List(0, 1, 2, 3))
    assertEq(0 :: xs, List(0, 1, 2, 3))
    assertEq(xs ++ [4, 5], List(1, 2, 3, 4, 5))
    assertEq(List.empty[int]() ++ xs, xs)
    assertEq(xs.updated(0, 9), List(9, 2, 3))
    assertEq(xs.updated(2, 9), List(1, 2, 9))
    assertEq(xs.padTo(5, 0), List(1, 2, 3, 0, 0))
    assertEq(xs.padTo(1, 0), xs)
    assertEq(xs.init(), List(1, 2))
    assertEq(xs.last(), 3)
    assertEq(xs.lift(3), None)
    assertEq(xs.lift(-1), None)
    assertEq(xs.lift(1), Some(2))
    assertEq(xs(2), 3)

@test("a long list is walked, compared and hashed without deepening the stack")
listLong()
    var xs: List[int] = []
    for i in 0..<200000 do xs = i :: xs
    assertEq(xs.length(), 200000)
    val ys = xs.map(x -> x)
    assert(xs == ys)
    assertEq(xs.hash(), ys.hash())
    assertEq(xs.reverse().head(), 0)
    assertEq(xs.foldRight(0, (x, n) -> n + 1), 200000)

@test("lists order element by element, a prefix before the longer list")
listOrdering()
    assert(List(1, 2) < List(1, 3))
    assert(List(1, 2) < List(1, 2, 0))
    assert(List.empty[int]() < List(0))
    assertEq(List(1, 2).compare(List(1, 2)), 0)
