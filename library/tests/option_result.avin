// Option and Result: each method on both of its cases, and the arguments taken by name evaluated only
// when they are needed.

var evaluated = 0

// `value`, counting that it was evaluated.
counted[T](value: T) -> T
    evaluated += 1
    value

@test("getOrElse and orElse evaluate their default only for None")
optionDefaultsAreLazy()
    val some: Option[int] = Some(1)
    val none: Option[int] = None
    assertEq(some.getOrElse(counted(9)), 1)
    assertEq(some.orElse(counted(Some(9))), Some(1))
    assertEq(evaluated, 0)
    assertEq(none.getOrElse(counted(9)), 9)
    assertEq(none.orElse(counted(Some(9))), Some(9))
    assertEq(evaluated, 2)

@test("map, flatMap and filter keep None as None and never call the function on it")
optionNoneSkipsFunctions()
    val none: Option[int] = None
    assertEq(none.map[int](x -> fail("called")), None)
    assertEq(none.flatMap[int](x -> fail("called")), None)
    assertEq(none.filter(x -> fail("called")), None)
    assert(!none.exists(x -> fail("called")))
    assert(none.forall(x -> fail("called")))
    assert(!none.contains(0))

@test("filter keeps a value that passes and drops one that does not")
optionFilter()
    assertEq(Some(4).filter(x -> x % 2 == 0), Some(4))
    assertEq(Some(3).filter(x -> x % 2 == 0), None)
    assertEq(Some(3).flatMap(x -> if x > 2 then Some(x * 10) else None), Some(30))
    assertEq(Some(1).flatMap(x -> if x > 2 then Some(x * 10) else None), None)

@test("fold, zip, flatten and the conversions")
optionShapes()
    val none: Option[int] = None
    assertEq(Some(2).fold(0, x -> x + 1), 3)
    assertEq(none.fold(7, x -> x + 1), 7)
    assertEq(Some(1).zip(Some("a")), Some((1, "a")))
    val noText: Option[string] = None
    assertEq(Some(1).zip(noText), None)
    val nested: Option[Option[int]] = Some(None)
    assertEq(nested.flatten, None)
    assertEq(Some(Some(5)).flatten, Some(5))
    assertEq(Some(1).toList, List(1))
    assertEq(none.toList, List.empty[int]())
    assertEq(none.toVector.length, 0)
    assertEq(Some(1).toVector, [1])
    assert(Some(0).isDefined && none.isEmpty)

@test("foreach calls its function once for Some and never for None")
optionForeach()
    var calls = 0
    Some(1).foreach(x -> calls += x)
    val none: Option[int] = None
    none.foreach(x -> calls += 100)
    assertEq(calls, 1)

@test("Result's methods act on Ok and pass an Err through untouched")
resultOkAndErr()
    val ok: Result[int, string] = Ok(2)
    val err: Result[int, string] = Err("bad")
    assertEq(ok.map(x -> x * 3), Ok(6))
    assertEq(err.map(x -> x * 3), Err("bad"))
    val okLength: Result[int, int] = Ok(2)
    val errLength: Result[int, int] = Err(3)
    assertEq(ok.mapErr(e -> e.charCount), okLength)
    assertEq(err.mapErr(e -> e.charCount), errLength)
    assertEq(ok.ok, Some(2))
    assertEq(err.ok, None)
    assertEq(ok.err, None)
    assertEq(err.err, Some("bad"))
    assertEq(err.getOrElse(0), 0)
    assertEq(ok.fold(e -> -1, x -> x), 2)
    assertEq(err.fold(e -> -1, x -> x), -1)
    assert(ok.exists(x -> x == 2) && !err.exists(x -> true))
    assert(err.forall(x -> false))
    assertEq(err.toList, List.empty[int]())

@test("flatMap stops at the first Err, and orElse recovers from one")
resultChains()
    val half = (x: int) -> if x % 2 == 0 then Ok(x / 2) else Err(s"$x is odd")
    val start: Result[int, string] = Ok(12)
    assertEq(start.flatMap(half).flatMap(half), Ok(3))
    assertEq(start.flatMap(half).flatMap(half).flatMap(half), Err("3 is odd"))
    val failed: Result[int, string] = Err("no")
    val recovered: Result[int, int] = Ok(2)
    assertEq(failed.orElse(e -> Ok(e.charCount)), recovered)
    assertEq(start.orElse[int, string](e -> fail("called")), start)
    val nested: Result[Result[int, string], string] = Ok(Err("inner"))
    assertEq(nested.flatten, Err("inner"))

@test("a test answering Ok passes")
answersOk() -> Result[unit, string]
    val n = "42".toIntOption().fold(Err("not a number"), x -> Ok(x))?
    assertEq(n, 42)
    Ok(())

@test("get returns the value, and filterNot keeps a value that fails the test")
optionGetAndFilterNot()
    val some: Option[int] = Some(4)
    val none: Option[int] = None
    assertEq(some.get, 4)
    assertEq(some.filterNot(x -> x > 5), Some(4))
    assertEq(some.filterNot(x -> x > 3), None)
    assertEq(none.filterNot(x -> fail("called")), None)

@test("isDefined, isEmpty and nonEmpty")
optionPresence()
    val some: Option[int] = Some(1)
    val none: Option[int] = None
    assert(some.isDefined && some.nonEmpty && !some.isEmpty)
    assert(!none.isDefined && !none.nonEmpty && none.isEmpty)
