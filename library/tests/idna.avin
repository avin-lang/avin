@test("Punycode encodes and decodes every sample string of RFC 3492")
rfcSamples()
  val wrong = Buffer[string]()
  for (codes, punycode) in samples()
    val text = fromHex(codes)
    if idna.encodePunycode(text) != Ok(punycode) then wrong.addOne(s"encode $codes: ${idna.encodePunycode(text)}")
    if idna.decodePunycode(punycode) != Ok(text) then wrong.addOne(
      s"decode $punycode: ${idna.decodePunycode(punycode)}"
    )
  assertEq(wrong.toVector, Vector.empty[string]())
  // The RFC's own spelling, with its case hint, decodes alike.
  val (russian, _) = samples()(8)
  assertEq(idna.decodePunycode("b1abfaaepdrnnbgefbaDotcwatmq2g4l"), Ok(fromHex(russian)))
  // Digits read in either case; the ASCII characters are kept in theirs.
  assertEq(idna.decodePunycode("BCHER-KVA"), Ok("B\u{fc}CHER"))
  assertEq(idna.decodePunycode("bcher-KVA"), Ok("b\u{fc}cher"))

@test("Punycode of the empty string, ASCII only, and one character")
punycodeBoundaries()
  assertEq(idna.encodePunycode(""), Ok(""))
  assertEq(idna.decodePunycode(""), Ok(""))
  assertEq(idna.encodePunycode("abc"), Ok("abc-"))
  assertEq(idna.decodePunycode("abc-"), Ok("abc"))
  assertEq(idna.decodePunycode("a-"), Ok("a"))
  assertEq(idna.encodePunycode("-"), Ok("--"))
  assertEq(idna.decodePunycode("--"), Ok("-"))
  assertEq(idna.encodePunycode("\u{fc}"), Ok("tda"))
  assertEq(idna.decodePunycode("tda"), Ok("\u{fc}"))
  assertEq(idna.encodePunycode("b\u{fc}cher"), Ok("bcher-kva"))
  assertEq(idna.encodePunycode("\u{80}"), Ok("a"))
  assertEq(idna.decodePunycode("a"), Ok("\u{80}"))
  assertEq(idna.decodePunycode(idna.encodePunycode("\u{10ffff}").getOrElse("")), Ok("\u{10ffff}"))
  assertEq(idna.decodePunycode(idna.encodePunycode("a\u{10ffff}\u{80}a").getOrElse("")), Ok("a\u{10ffff}\u{80}a"))

@test("Punycode round-trips every code point beyond ASCII, alone and among others")
punycodeRoundTrips()
  var wrong = 0
  var c = 0x80
  while c <= 0x10ffff
    if !(0xd800 <= c <= 0xdfff)
      val text = s"x${char(c)}y${char(0x80 + c % 1000)}"
      val encoded = idna.encodePunycode(text).getOrElse("!")
      if !encoded.chars.forall(ch -> int(ch) < 0x80) || idna.decodePunycode(encoded) != Ok(text) then wrong += 1
    c += if c < 0x3000 then 1 else 97
  assertEq(wrong, 0)
  // Every character of a long text, repeated and out of order.
  val mixed = StringWriter()
  for k in 0 ..< 1000 do mixed.writeChar(char(0x4e00 + (k * 7919) % 2000))
  assertEq(idna.decodePunycode(idna.encodePunycode(mixed.text).getOrElse("")), Ok(mixed.text))

// Punycode for the single value 0x110000, one past the last code point: the number 0x110000 - 128
// in digits of 1, 1, 26 and 26 (RFC 3492's thresholds at the initial bias), `e` `n` `3` `2` `g`.
val OutOfRange: string = "en32g"

// Punycode for the single value 0xD800, the first surrogate.
val Surrogate: string = "ib9b"

@test("Punycode refuses text that is not Punycode, saying where")
punycodeInvalid()
  assertEq(idna.decodePunycode("-"), Err(InvalidInput(0)))
  assertEq(idna.decodePunycode("a-!"), Err(InvalidInput(2)))
  assertEq(idna.decodePunycode("\u{fc}-a"), Err(InvalidInput(0)))
  assertEq(idna.decodePunycode("ab\u{fc}-a"), Err(InvalidInput(2)))
  assertEq(idna.decodePunycode("a-\u{fc}"), Err(InvalidInput(2)))
  assertEq(idna.decodePunycode("a b"), Err(InvalidInput(1)))
  // A number cut off before its last digit.
  assertEq(idna.decodePunycode("b"), Err(InvalidInput(1)))
  assertEq(idna.decodePunycode("bcher-kv9"), Err(InvalidInput(9)))
  // A value beyond Unicode, and a surrogate.
  assertEq(idna.decodePunycode(OutOfRange), Err(InvalidCodePoint(0x110000)))
  assertEq(idna.decodePunycode(Surrogate), Err(InvalidCodePoint(0xd800)))

@test("Punycode answers Overflow for numbers past the range of int, rather than trapping")
punycodeOverflow()
  assertEq(idna.decodePunycode("999999999"), Err(Overflow))
  assertEq(idna.decodePunycode("a-99999999999999999999"), Err(Overflow))
  // Two thousand ASCII characters and then the last code point: the first number does not fit.
  assertEq(idna.encodePunycode("a".repeat(2000) + "\u{10ffff}"), Err(Overflow))
  // One thousand fit.
  assert(idna.encodePunycode("a".repeat(1000) + "\u{10ffff}").isOk)
  assert(idna.encodePunycode("\u{10ffff}".repeat(3000)).isOk)

// The columns of the conformance file read: escapes `\uXXXX` turned into characters, `""` into the
// empty string. `None` where an escape is a surrogate, which a string cannot hold.
unescape(field: string) -> Option[string]
  val text = field.trim
  if text == "\"\"" then return Some("")
  val out = StringWriter()
  var i = 0
  while i < text.byteLength
    if text.startsWith("\\u", i)
      val c = hexCode(text.slice(i + 2, i + 6))
      if 0xd800 <= c <= 0xdfff then return None
      out.writeChar(char(c))
      i += 6
    else
      val ch = text.slice(i, text.byteLength).chars(0)
      out.writeChar(ch)
      i += ch.toString().byteLength
  Some(out.text)

// The codes of a status column, `[B5, B6]`, as a vector; empty for a blank one.
statuses(field: string) -> Vector[string]
  val text = field.trim
  if text.isEmpty || text == "[]" then return Vector.empty[string]()
  text.slice(1, text.byteLength - 1).split(",").map(s -> s.trim).toVector

// A line of the conformance file: the source, the expected `toUnicode` result and its status codes,
// and the expected non-transitional `toAscii` result and its status codes.
data Case(source: string, unicode: string, unicodeErrors: Vector[string], ascii: string, asciiErrors: Vector[string])

// The conformance file's lines, and how many were skipped for holding a surrogate.
conformance() -> (Vector[Case], int)
  val text = fs.readText("tests/fixtures/unicode/IdnaTestV2.txt") match
    Ok(t) -> t
    Err(e) -> fail(s"cannot read the conformance file: ${e.message}")
  val found = Buffer[Case]()
  var skipped = 0
  for line in text.split("\n")
    if line.isEmpty || line.startsWith("#") then continue
    val hash = line.indexOf("#")
    val fields = (if hash >= 0 then line.slice(0, hash) else line).split(";")
    val source = unescape(fields(0))
    val unicodeField = unescape(fields(1))
    val asciiField = unescape(fields(3))
    if source.isEmpty || unicodeField.isEmpty || asciiField.isEmpty
      skipped += 1
      continue
    val s = source.getOrElse("")
    val unicode = if fields(1).trim.isEmpty then s else unicodeField.getOrElse("")
    val unicodeErrors = statuses(fields(2))
    val ascii = if fields(3).trim.isEmpty then unicode else asciiField.getOrElse("")
    val asciiErrors = if fields(4).trim.isEmpty then unicodeErrors else statuses(fields(4))
    found.addOne(Case(s, unicode, unicodeErrors, ascii, asciiErrors))
  (found.toVector, skipped)

// Whether `answer` is what the file expects: the result where no code counts, an error where one does.
agrees(answer: Result[string, IdnaError], expected: string, codes: Vector[string], ignored: Vector[string]) -> bool
  val errors = codes.filter(c -> !ignored.contains(c))
  answer match
    Ok(t) -> errors.isEmpty && t == expected
    Err(_) -> errors.nonEmpty

// The source, its code points, for a failure's message.
shown(s: string) -> string = s.chars.map(c -> int(c).toString()).mkString(" ")

@test("every line of the Unicode conformance file, with every check on")
conformanceStrict()
  val (cases, skipped) = conformance()
  assert(cases.length > 6000)
  // The two lines holding an unpaired surrogate.
  assertEq(skipped, 2)
  var failures = 0
  for c in cases
    // `X4_2` is a length rule `toUnicode` reports only for compatibility; it has no length rule.
    val unicode = idna.toUnicode(c.source, checkHyphens = true, useStd3AsciiRules = true)
    val ascii = idna.toAscii(c.source, checkHyphens = true, useStd3AsciiRules = true, verifyDnsLength = true)
    val ok = agrees(unicode, c.unicode, c.unicodeErrors, ["X4_2"]) && agrees(ascii, c.ascii, c.asciiErrors, [])
    if !ok
      if failures < 10 then eprintln(
        s"conformance line fails: ${shown(c.source)}: $unicode $ascii, expected ${c.unicode} ${c.unicodeErrors} ${c.ascii} ${c.asciiErrors}"
      )
      failures += 1
  assertEq(failures, 0)

@test("every line of the Unicode conformance file, with the WHATWG URL standard's checks")
conformanceWhatwg()
  val (cases, _) = conformance()
  // The codes of the checks the URL standard turns off: hyphens, STD3 rules and DNS lengths.
  val off = ["V2", "V3", "U1", "A4_1", "A4_2", "X4_2"]
  var failures = 0
  for c in cases
    val unicode = idna.toUnicode(c.source)
    val ascii = idna.toAscii(c.source)
    if !agrees(unicode, c.unicode, c.unicodeErrors, off) || !agrees(ascii, c.ascii, c.asciiErrors, off)
      if failures < 10 then eprintln(s"conformance line fails: ${shown(c.source)}: $unicode $ascii")
      failures += 1
  assertEq(failures, 0)

@test("toAscii maps, normalizes and writes labels beyond ASCII in Punycode; toUnicode reverses it")
processing()
  assertEq(idna.toAscii("B\u{fc}cher.example"), Ok("xn--bcher-kva.example"))
  assertEq(idna.toUnicode("xn--bcher-kva.example"), Ok("b\u{fc}cher.example"))
  assertEq(idna.toUnicode("XN--BCHER-KVA.Example"), Ok("b\u{fc}cher.example"))
  assertEq(idna.toAscii("xn--bcher-kva.example"), Ok("xn--bcher-kva.example"))
  // Decomposed and composed spellings are one name.
  assertEq(idna.toAscii("bu\u{308}cher.example"), Ok("xn--bcher-kva.example"))
  // Non-transitional: `ß` and `ς` are kept.
  assertEq(idna.toAscii("fa\u{df}.de"), Ok("xn--fa-hia.de"))
  assertEq(idna.toUnicode("xn--fa-hia.de"), Ok("fa\u{df}.de"))
  assertEq(idna.toAscii("\u{3c2}"), Ok("xn--3xa"))
  // Fullwidth letters, the ideographic full stop and upper case are mapped.
  assertEq(idna.toAscii("\u{ff25}\u{ff38}\u{ff21}\u{ff2d}\u{ff30}\u{ff2c}\u{ff25}\u{3002}com"), Ok("example.com"))
  assertEq(idna.toAscii("WWW.Example.COM"), Ok("www.example.com"))
  assertEq(idna.toAscii("\u{3a3}"), idna.toAscii("\u{3c3}"))
  // Ignored characters are removed: the soft hyphen, a variation selector.
  assertEq(idna.toAscii("a\u{ad}b\u{fe0f}.c"), Ok("ab.c"))
  // Compatibility characters are mapped to their plain forms.
  assertEq(idna.toAscii("\u{2460}.\u{fb01}"), Ok("1.fi"))
  // Several scripts in several labels.
  assertEq(idna.toAscii("\u{65e5}\u{672c}.\u{440}\u{444}"), Ok("xn--wgv71a.xn--p1ai"))
  assertEq(idna.toUnicode("xn--wgv71a.xn--p1ai"), Ok("\u{65e5}\u{672c}.\u{440}\u{444}"))
  // An emoji is valid.
  assertEq(idna.toAscii("\u{1f600}.example"), Ok("xn--e28h.example"))
  // Empty labels, a trailing dot, and the empty name are kept by default.
  assertEq(idna.toAscii(""), Ok(""))
  assertEq(idna.toAscii("."), Ok("."))
  assertEq(idna.toAscii("a..b."), Ok("a..b."))
  assertEq(idna.toUnicode(""), Ok(""))
  // ASCII the URL standard allows in a name, without the STD3 rules.
  assertEq(idna.toAscii("a_b c"), Ok("a_b c"))

@test("each kind of error, in the label it is found in")
errors()
  assertEq(idna.toAscii("a.b\u{fffd}c"), Err(Disallowed(1)))
  assertEq(idna.toAscii("\u{e000}"), Err(Disallowed(0)))
  assertEq(idna.toAscii("a\u{378}"), Err(Disallowed(0)))
  assertEq(idna.toAscii("\u{300}a"), Err(LeadingMark(0)))
  assertEq(idna.toAscii("ok.\u{94d}a"), Err(LeadingMark(1)))
  assertEq(idna.toAscii("xn--"), Err(BadPunycode(0)))
  assertEq(idna.toAscii("xn--ascii-"), Err(BadPunycode(0)))
  assertEq(idna.toAscii("a.xn--a-\u{e4}"), Err(BadPunycode(1)))
  assertEq(idna.toAscii("xn--9999999999"), Err(BadPunycode(0)))
  // Punycode for an upper-case letter, which mapping would have lowered: disallowed in the label.
  assertEq(idna.toAscii("xn--Bcher-kva"), Ok("xn--bcher-kva"))
  assertEq(idna.toAscii(s"xn--${idna.encodePunycode("\u{dc}x").getOrElse("")}"), Err(Disallowed(0)))
  // Punycode not in normalization form NFC.
  assertEq(idna.toAscii(s"xn--${idna.encodePunycode("u\u{308}x").getOrElse("")}"), Err(BadPunycode(0)))
  // Punycode for a label itself beginning `xn--`.
  assertEq(idna.toAscii(s"xn--${idna.encodePunycode("xn--\u{fc}").getOrElse("")}"), Err(BadPunycode(0)))
  // Joiners: allowed after a virama, and a non-joiner between joining letters.
  assertEq(idna.toAscii("a\u{200d}b"), Err(Joiners(0)))
  assertEq(idna.toAscii("a\u{200c}b"), Err(Joiners(0)))
  assert(idna.toAscii("\u{915}\u{94d}\u{200d}\u{937}").isOk)
  assert(idna.toAscii("\u{915}\u{94d}\u{200c}\u{937}").isOk)
  assert(idna.toAscii("\u{628}\u{200c}\u{628}").isOk)
  assert(idna.toAscii("\u{628}\u{64b}\u{200c}\u{64b}\u{628}").isOk)
  assertEq(idna.toAscii("\u{628}\u{200c}"), Err(Joiners(0)))
  assertEq(idna.toAscii("\u{200c}\u{628}"), Err(Joiners(0)))
  assert(idna.toAscii("a\u{200d}b", checkJoiners = false).isOk)
  // Bidirectional rules, in a name holding a right-to-left label.
  assertEq(idna.toAscii("\u{e0}\u{5d0}"), Err(Bidi(0)))
  assertEq(idna.toAscii("0a.\u{5d0}"), Err(Bidi(0)))
  assertEq(idna.toAscii("\u{5d0}.\u{5d0}0\u{660}"), Err(Bidi(1)))
  assert(idna.toAscii("\u{5d0}\u{5d1}.example").isOk)
  assert(idna.toAscii("0a.example").isOk)
  assert(idna.toAscii("\u{e0}\u{5d0}", checkBidi = false).isOk)
  // Hyphens, only where asked.
  assert(idna.toAscii("-a-.ab--c").isOk)
  assertEq(idna.toAscii("-a", checkHyphens = true), Err(Hyphens(0)))
  assertEq(idna.toAscii("x.a-", checkHyphens = true), Err(Hyphens(1)))
  assertEq(idna.toAscii("ab--c", checkHyphens = true), Err(Hyphens(0)))
  assert(idna.toAscii("a-b--c", checkHyphens = true).isOk)
  // The STD3 rules, only where asked.
  assertEq(idna.toAscii("a_b", useStd3AsciiRules = true), Err(Disallowed(0)))
  assertEq(idna.toAscii("\u{2474}", useStd3AsciiRules = true), Err(Disallowed(0)))
  assert(idna.toAscii("a-0", useStd3AsciiRules = true).isOk)
  // Messages.
  assertEq(Bidi(2).message, "mixed directions not allowed in label 2")
  assertEq(DomainLength.message, "the domain name is empty or too long")
  assertEq(Overflow.message, "a Punycode number out of range")
  assertEq(InvalidInput(3).message, "not Punycode at index 3")

@test("lengths: DNS's limits where asked, and MaxLabelLength always")
lengths()
  val a63 = "a".repeat(63)
  assert(idna.toAscii(a63, verifyDnsLength = true).isOk)
  assertEq(idna.toAscii("a".repeat(64), verifyDnsLength = true), Err(LabelLength(0)))
  assert(idna.toAscii("a".repeat(64)).isOk)
  assertEq(idna.toAscii("", verifyDnsLength = true), Err(LabelLength(0)))
  assertEq(idna.toAscii("a.", verifyDnsLength = true), Err(LabelLength(1)))
  assertEq(idna.toAscii("a..b", verifyDnsLength = true), Err(LabelLength(1)))
  // A label's length is that of its ASCII form: 59 `ü` take more than 63.
  assertEq(idna.toAscii("\u{fc}".repeat(59), verifyDnsLength = true), Err(LabelLength(0)))
  assert(idna.toAscii("\u{fc}".repeat(20), verifyDnsLength = true).isOk)
  // 253 characters in all, and 254.
  val name253 = s"$a63.$a63.$a63.${"a".repeat(61)}"
  assertEq(name253.byteLength, 253)
  assertEq(idna.toAscii(name253, verifyDnsLength = true), Ok(name253))
  assertEq(idna.toAscii(name253 + "a", verifyDnsLength = true), Err(DomainLength))
  // MaxLabelLength code points beyond ASCII, or of Punycode, and one more.
  assertEq(MaxLabelLength, 1024)
  assert(idna.toAscii("\u{fc}".repeat(MaxLabelLength)).isOk)
  assertEq(idna.toAscii("\u{fc}".repeat(MaxLabelLength + 1)), Err(LabelLength(0)))
  assertEq(idna.toUnicode("ok." + "\u{fc}".repeat(MaxLabelLength + 1)), Err(LabelLength(1)))
  assertEq(idna.toAscii("xn--" + "a".repeat(MaxLabelLength + 1)), Err(LabelLength(0)))
  // An ASCII label has no such limit: its work is linear.
  val huge = "a".repeat(1000000)
  assertEq(idna.toAscii(huge), Ok(huge))
  assertEq(idna.toAscii("A".repeat(100000)), Ok("a".repeat(100000)))

@test("hostile names are refused quickly: many labels, long Punycode, many joiners")
hostile()
  val many = "\u{fc}.".repeat(20000)
  assertEq(idna.toAscii(many), Ok("xn--tda.".repeat(20000)))
  assertEq(idna.toAscii("xn--" + "9".repeat(MaxLabelLength)), Err(BadPunycode(0)))
  assertEq(idna.toAscii(("\u{628}" + "\u{64b}".repeat(500) + "\u{200c}").repeat(2)), Err(Joiners(0)))
  assertEq(idna.toAscii("\u{200c}".repeat(MaxLabelLength)), Err(Joiners(0)))
  // A character mapped to many: U+FDFA becomes eighteen, spaces among them.
  assertEq(idna.toUnicode("\u{fdfa}", checkBidi = false).map(t -> t.chars.length), Ok(18))
  assertEq(idna.toAscii("\u{fdfa}"), Err(Bidi(0)))
  assertEq(idna.toAscii("\u{fdfa}".repeat(100)), Err(LabelLength(0)))
