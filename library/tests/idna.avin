// `avin.net.idna`: Punycode by RFC 3492's own sample strings and its failures, and UTS #46 processing
// by the Unicode conformance file and the cases a reader meets first.
//
// `tests/fixtures/unicode/IdnaTestV2.txt` is `IdnaTestV2.txt` of Unicode 17.0.0
// (`https://www.unicode.org/Public/17.0.0/idna/IdnaTestV2.txt`, SHA-256
// `beb5d0be20e896189b03209a82fdc34f06351502bbd4b8e2523583fc2954d9cf`), as published; its licence is
// `tests/fixtures/unicode/LICENSE.txt`.

import avin.fs
import avin.net.idna

import avin.net.idna.{
  Bidi, BadPunycode, Disallowed, DomainLength, Hyphens, IdnaError, InvalidCodePoint, InvalidInput, Joiners, LabelLength,
  LeadingMark, MaxLabelLength, Overflow
}

hexCode(text: string) -> int
  var n = 0
  for c in text.chars
    n = n * 16 + c.asDigit
  n

// Code points written in hexadecimal with a space between them, as a string.
fromHex(text: string) -> string
  val out = StringWriter()
  for code in text.split(" ") do out.writeChar(char(hexCode(code)))
  out.text

// The sample strings of RFC 3492 §7.1, each its code points and its Punycode.
samples() -> Vector[(string, string)] = [
  (
    "0644 064A 0647 0645 0627 0628 062A 0643 0644 0645 0648 0634 0639 0631 0628 064A 061F",
    "egbpdaj6bu4bxfgehfvwxn"
