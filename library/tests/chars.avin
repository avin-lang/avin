// The `char` methods: ASCII, characters beyond it, and the edges of each classification.

@test("isDigit is true for decimal digits of any script and false for other numerals")
digits()
    assert('0'.isDigit() && '9'.isDigit())
    assert('\u{663}'.isDigit())
    assert(!'a'.isDigit() && !' '.isDigit() && !'\u{b2}'.isDigit())

@test("isLetter and isLetterOrDigit")
letters()
    assert('a'.isLetter() && 'Z'.isLetter() && 'é'.isLetter() && 'Ж'.isLetter())
    assert(!'1'.isLetter() && !'_'.isLetter() && !'-'.isLetter())
    assert('a'.isLetterOrDigit() && '7'.isLetterOrDigit() && !'$'.isLetterOrDigit())

@test("isWhitespace is the White_Space property")
whitespace()
    assert(' '.isWhitespace() && '\n'.isWhitespace() && '\t'.isWhitespace())
    assert('\u{a0}'.isWhitespace() && '\u{3000}'.isWhitespace())
    assert(!'a'.isWhitespace() && !'\u{200b}'.isWhitespace() && !'\u{0}'.isWhitespace())

@test("isUpper, isLower and isControl")
casesAndControls()
    assert('A'.isUpper() && 'É'.isUpper() && !'a'.isUpper() && !'1'.isUpper())
    assert('a'.isLower() && 'é'.isLower() && !'A'.isLower() && !'1'.isLower())
    assert('\u{0}'.isControl() && '\n'.isControl() && '\u{7f}'.isControl() && '\u{9f}'.isControl())
    assert(!' '.isControl() && !'a'.isControl() && !'\u{a0}'.isControl() && !'~'.isControl())

@test("toUpper and toLower map one character to one")
caseMapping()
    assertEq('a'.toUpper(), 'A')
    assertEq('é'.toUpper(), 'É')
    assertEq('Ж'.toLower(), 'ж')
    assertEq('1'.toUpper(), '1')
    assertEq('ß'.toUpper(), 'ß')
    assertEq('Z'.toLower(), 'z')

@test("asDigit reads digits and ASCII letters as numbers up to base 36")
asDigitValues()
    assertEq('0'.asDigit(), 0)
    assertEq('9'.asDigit(), 9)
    assertEq('a'.asDigit(), 10)
    assertEq('F'.asDigit(), 15)
    assertEq('z'.asDigit(), 35)
    assertEq('Z'.asDigit(), 35)
