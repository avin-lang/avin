// The `char` methods: ASCII, characters beyond it, and the edges of each classification.

@test("isDigit is true for decimal digits of any script and false for other numerals")
charDigits()
    assert('0'.isDigit() && '9'.isDigit())
    assert('\u{663}'.isDigit())
    assert(!'a'.isDigit() && !' '.isDigit() && !'\u{b2}'.isDigit())

@test("isLetter and isLetterOrDigit")
charLetters()
    assert('a'.isLetter() && 'Z'.isLetter() && 'é'.isLetter() && 'Ж'.isLetter())
    assert(!'1'.isLetter() && !'_'.isLetter() && !'-'.isLetter())
    assert('a'.isLetterOrDigit() && '7'.isLetterOrDigit() && !'$'.isLetterOrDigit())

@test("isWhitespace excludes the non-breaking spaces and includes the separator controls")
charWhitespace()
    assert(' '.isWhitespace() && '\n'.isWhitespace() && '\t'.isWhitespace())
    assert('\u{3000}'.isWhitespace() && '\u{2003}'.isWhitespace() && '\u{b}'.isWhitespace())
    assert('\u{1c}'.isWhitespace() && '\u{1f}'.isWhitespace() && '\r'.isWhitespace())
    assert(!'\u{a0}'.isWhitespace() && !'\u{2007}'.isWhitespace() && !'\u{202f}'.isWhitespace())
    assert(!'a'.isWhitespace() && !'\u{200b}'.isWhitespace() && !'\u{0}'.isWhitespace())
    assert(!'\u{85}'.isWhitespace() && !'\u{1b}'.isWhitespace())

@test("isSpaceChar is the categories Zs, Zl and Zp")
charSpaceChar()
    assert(' '.isSpaceChar() && '\u{a0}'.isSpaceChar() && '\u{2028}'.isSpaceChar())
    assert('\u{2029}'.isSpaceChar() && '\u{3000}'.isSpaceChar())
    assert(!'\n'.isSpaceChar() && !'\t'.isSpaceChar() && !'\u{85}'.isSpaceChar() && !'a'.isSpaceChar())

@test("isUpper, isLower and isControl")
charCasesAndControls()
    assert('A'.isUpper() && 'É'.isUpper() && !'a'.isUpper() && !'1'.isUpper())
    assert('a'.isLower() && 'é'.isLower() && !'A'.isLower() && !'1'.isLower())
    assert('\u{0}'.isControl() && '\n'.isControl() && '\u{7f}'.isControl() && '\u{9f}'.isControl())
    assert(!' '.isControl() && !'a'.isControl() && !'\u{a0}'.isControl() && !'~'.isControl())

@test("toUpperCase and toLowerCase map one character to one")
charCaseMapping()
    assertEq('a'.toUpperCase(), 'A')
    assertEq('é'.toUpperCase(), 'É')
    assertEq('Ж'.toLowerCase(), 'ж')
    assertEq('1'.toUpperCase(), '1')
    assertEq('ß'.toUpperCase(), 'ß')
    assertEq('Z'.toLowerCase(), 'z')

@test("asDigit gives the radix 36 value of a digit or letter, and -1 for anything else")
charAsDigitValues()
    assertEq('0'.asDigit(), 0)
    assertEq('9'.asDigit(), 9)
    assertEq('a'.asDigit(), 10)
    assertEq('F'.asDigit(), 15)
    assertEq('z'.asDigit(), 35)
    assertEq('Z'.asDigit(), 35)
    assertEq('\u{663}'.asDigit(), 3)
    assertEq('\u{966}'.asDigit(), 0)
    assertEq('\u{1d7ff}'.asDigit(), 9)
    assertEq('\u{ff10}'.asDigit(), 0)
    assertEq('\u{ff21}'.asDigit(), 10)
    assertEq('\u{ff5a}'.asDigit(), 35)
    assertEq('-'.asDigit(), -1)
    assertEq('é'.asDigit(), -1)
    assertEq(' '.asDigit(), -1)
    assertEq('\u{b2}'.asDigit(), -1)
