// `avin.msgpack`: every format of the specification read to its tree and written back in its shortest
// form, the timestamp extension, and input from outside: truncation at every byte, lengths beyond the
// input, nesting, bad text, the limits, strict and deterministic modes, streaming and derived types.
import avin.encoding.{fromHex, toHex}
import avin.io.{ByteWriter, IoError, Other, Reader}
import avin.msgpack

import avin.msgpack.{
  Arr, BigUint, Bin, Bool, Dict, Double, Ext, Msgpack, MsgpackError, MsgpackKey, MsgpackOmit, MsgpackOmitNone,
  MsgpackOptions, MsgpackReader, MsgpackTag, MsgpackWriter, Nil, Num, Single, Str
}

import avin.msgpack.{MsgpackDecoder, MsgpackEncoder}

val minLong: long = -9223372036854775807 - 1
val maxLong: long = 9223372036854775807

hex(text: string) -> Array[byte] = fromHex(text).getOrElse(Vector.empty[byte]()).toArray()

hexOf(bytes: Array[byte]) -> string = toHex(bytes.toVector)

// `text` reads to `tree`, and `tree` writes back to `text`.
golden(text: string, tree: Msgpack)
  assertEq(msgpack.parse(hex(text)), Ok(tree))
  assertEq(hexOf(msgpack.encodeTree(tree)), text)

// `text` reads to `tree` but is not what `tree` writes: a longer form than the shortest.
readsAs(text: string, tree: Msgpack) = assertEq(msgpack.parse(hex(text)), Ok(tree))

// The message of the error reading `text` gives, or "ok".
failure(text: string, options: MsgpackOptions = MsgpackOptions()) -> string = msgpack.parse(hex(text), options) match
  Ok(_) -> "ok"
  Err(e) -> e.message

repeated(piece: string, n: int, tail: string) -> Array[byte]
  val u = hex(piece)
  val t = hex(tail)
  Array.tabulate(u.length * n + t.length, i -> if i < u.length * n then u(i % u.length) else t(i - u.length * n))

// `text` repeated `n` times, as a string of hexadecimal digits.
hexRepeated(piece: string, n: int) -> string = hexOf(repeated(piece, n, ""))

@test("nil, booleans and the integer formats, each at its boundaries")
goldenIntegers()
  golden("c0", Nil)
  golden("c2", Bool(false))
  golden("c3", Bool(true))
  golden("00", Num(0))
  golden("01", Num(1))
  golden("7f", Num(127))
  golden("cc80", Num(128))
  golden("ccff", Num(255))
  golden("cd0100", Num(256))
  golden("cdffff", Num(65535))
  golden("ce00010000", Num(65536))
  golden("ceffffffff", Num(4294967295))
  golden("cf0000000100000000", Num(4294967296))
  golden("cf7fffffffffffffff", Num(maxLong))
  golden("cf8000000000000000", BigUint(minLong))
  golden("cfffffffffffffffff", BigUint(-1))
  golden("ff", Num(-1))
  golden("e0", Num(-32))
  golden("d0df", Num(-33))
  golden("d080", Num(-128))
  golden("d1ff7f", Num(-129))
  golden("d18000", Num(-32768))
  golden("d2ffff7fff", Num(-32769))
  golden("d280000000", Num(-2147483648))
  golden("d3ffffffff7fffffff", Num(-2147483649))
  golden("d38000000000000000", Num(minLong))

@test("integers written in a longer format than they need read as the same integer")
longerIntegers()
  readsAs("cc00", Num(0))
  readsAs("cc7f", Num(127))
  readsAs("cd0001", Num(1))
  readsAs("ce00000001", Num(1))
  readsAs("cf0000000000000001", Num(1))
  readsAs("d001", Num(1))
  readsAs("d0ff", Num(-1))
  readsAs("d1ffff", Num(-1))
  readsAs("d2ffffffff", Num(-1))
  readsAs("d3ffffffffffffffff", Num(-1))
  readsAs("d300000000000000ff", Num(255))
  readsAs("d17fff", Num(32767))

@test("floats of both widths keep their width")
goldenFloats()
  golden("ca3fc00000", Single(1.5))
  golden("cb3ff199999999999a", Double(1.1))
  golden("ca00000000", Single(0.0))
  golden("cb0000000000000000", Double(0.0))
  golden("cb8000000000000000", Double(-0.0))
  golden("ca7f800000", Single(1.0 / 0.0))
  golden("caff800000", Single(-1.0 / 0.0))
  golden("cb7ff0000000000000", Double(1.0 / 0.0))
  golden("ca7f7fffff", Single(3.4028234663852886e38))
  golden("cb7e37e43c8800759c", Double(1.0e300))
  golden("ca00000001", Single(1.401298464324817e-45))
  for text in ["ca7fc00000", "cb7ff8000000000000"]
    val v = msgpack.parse(hex(text)).getOrElse(Nil)
    assertEq(v.asReal.map(x -> x != x), Some(true))
    assertEq(hexOf(msgpack.encodeTree(v)), text)
  assertEq(msgpack.parse(hex("cb8000000000000000")).map(v -> v.asReal.getOrElse(1.0).toBits), Ok(minLong))

@test("strings take the fix, 8, 16 and 32 bit formats by length, and read back")
goldenStrings()
  golden("a0", Str(""))
  golden("a161", Str("a"))
  golden("a3e6b0b4", Str("水"))
  golden("a4f0908591", Str("\u{10151}"))
  golden("bf" + hexRepeated("61", 31), Str("a".repeat(31)))
  golden("d920" + hexRepeated("61", 32), Str("a".repeat(32)))
  golden("d9ff" + hexRepeated("61", 255), Str("a".repeat(255)))
  golden("da0100" + hexRepeated("61", 256), Str("a".repeat(256)))
  golden("daffff" + hexRepeated("61", 65535), Str("a".repeat(65535)))
  golden("db00010000" + hexRepeated("61", 65536), Str("a".repeat(65536)))
  readsAs("d900", Str(""))
  readsAs("da000161", Str("a"))
  readsAs("db0000000161", Str("a"))

@test("binary data takes the 8, 16 and 32 bit formats by length")
goldenBinary()
  golden("c400", Bin(hex("")))
  golden("c403010203", Bin(hex("010203")))
  golden("c4ff" + hexRepeated("07", 255), Bin(Array.fill(255, byte(7))))
  golden("c50100" + hexRepeated("07", 256), Bin(Array.fill(256, byte(7))))
  golden("c6" + "00010000" + hexRepeated("07", 65536), Bin(Array.fill(65536, byte(7))))
  readsAs("c5000101", Bin(hex("01")))
  readsAs("c600000001ab", Bin(hex("ab")))

@test("arrays and maps take the fix, 16 and 32 bit formats by length")
goldenCollections()
  golden("90", Arr([]))
  golden("93010203", Arr([Num(1), Num(2), Num(3)]))
  golden("9f" + hexRepeated("c0", 15), Arr(Vector.tabulate(15, i -> Nil)))
  golden("dc0010" + hexRepeated("c0", 16), Arr(Vector.tabulate(16, i -> Nil)))
  golden("dd00010000" + hexRepeated("c0", 65536), Arr(Vector.tabulate(65536, i -> Nil)))
  golden("80", Dict([]))
  golden("81a16101", Dict([(Str("a"), Num(1))]))
  golden("8201020304", Dict([(Num(1), Num(2)), (Num(3), Num(4))]))
  golden("de0010" + hexRepeated("0100", 16), Dict(Vector.tabulate(16, i -> (Num(1), Num(0)))))
  golden("9291a16191a162", Arr([Arr([Str("a")]), Arr([Str("b")])]))
  readsAs("dc0000", Arr([]))
  readsAs("dd00000001c0", Arr([Nil]))
  readsAs("de0000", Dict([]))
  readsAs("df00000000", Dict([]))

@test("extensions take the fixext, 8, 16 and 32 bit formats by length, with their type")
goldenExtensions()
  golden("d40105", Ext(1, hex("05")))
  golden("d5020102", Ext(2, hex("0102")))
  golden("d603" + "01020304", Ext(3, hex("01020304")))
  golden("d704" + "0102030405060708", Ext(4, hex("0102030405060708")))
  golden("d805" + hexRepeated("aa", 16), Ext(5, Array.fill(16, byte(170))))
  golden("c70005", Ext(5, hex("")))
  golden("c7030501" + "0203", Ext(5, hex("010203")))
  golden("c70a7f" + hexRepeated("01", 10), Ext(127, Array.fill(10, byte(1))))
  golden("c70a80" + hexRepeated("01", 10), Ext(-128, Array.fill(10, byte(1))))
  golden("c8" + "0100" + "ff" + hexRepeated("02", 256), Ext(-1, Array.fill(256, byte(2))))
  golden("c9" + "00010000" + "09" + hexRepeated("03", 65536), Ext(9, Array.fill(65536, byte(3))))
  readsAs("c7010501", Ext(5, hex("01")))
  readsAs("c7020501" + "02", Ext(5, hex("0102")))
  readsAs("c8000105" + "01", Ext(5, hex("01")))

@test("the timestamp extension has three forms, and each reads as its seconds and nanoseconds")
timestamps()
  golden("d6ff00000000", Ext(-1, hex("00000000")))
  golden("d6ffffffffff", Ext(-1, hex("ffffffff")))
  golden("d7ff0000000400000001", Ext(-1, hex("0000000400000001")))
  golden("d7ff" + "0000000" + "3ffffffff", Ext(-1, hex("00000003ffffffff")))
  golden("c70cff" + "00000000" + "ffffffffffffffff", Ext(-1, hex("00000000ffffffffffffffff")))
  assertEq(Msgpack.timestamp(0), Ext(-1, hex("00000000")))
  assertEq(Msgpack.timestamp(1), Ext(-1, hex("00000001")))
  assertEq(Msgpack.timestamp(4294967295), Ext(-1, hex("ffffffff")))
  assertEq(Msgpack.timestamp(4294967296), Ext(-1, hex("0000000100000000")))
  assertEq(Msgpack.timestamp(1, 1), Ext(-1, hex("0000000400000001")))
  assertEq(Msgpack.timestamp(17179869183, 999999999), Ext(-1, hex("ee6b27ffffffffff")))
  assertEq(Msgpack.timestamp(17179869184), Ext(-1, hex("00000000" + "0000000400000000")))
  assertEq(Msgpack.timestamp(-1), Ext(-1, hex("00000000" + "ffffffffffffffff")))
  assertEq(Msgpack.timestamp(minLong, 5), Ext(-1, hex("00000005" + "8000000000000000")))
  assertEq(Msgpack.timestamp(maxLong, 999999999), Ext(-1, hex("3b9ac9ff" + "7fffffffffffffff")))
  val cases: Vector[(long, int)] = [
    (0, 0),
    (1, 0),
    (4294967295, 0),
    (4294967296, 0),
    (1, 1),
    (17179869183, 999999999),
    (17179869184, 0),
    (-1, 0),
    (-1, 7),
    (1700000000, 123456789)
  ]
  for (s, n) in cases
    assertEq(Msgpack.timestamp(s, n).asTimestamp, Some((s, n)))
  assertEq(Msgpack.timestamp(minLong, 5).asTimestamp, Some((minLong, 5)))
  assertEq(Msgpack.timestamp(maxLong, 999999999).asTimestamp, Some((maxLong, 999999999)))
  assertEq(Ext(-1, hex("0102")).asTimestamp, None)
  assertEq(Ext(-1, hex("")).asTimestamp, None)
  assertEq(Ext(5, hex("00000000")).asTimestamp, None)
  assertEq(Ext(-1, hex("ffffffff" + "ffffffff")).asTimestamp, None)
  assertEq(Ext(-1, hex("3b9aca00" + "0000000000000000")).asTimestamp, None)
  assertEq(Num(1).asTimestamp, None)

@test("the accessors take a tree apart")
accessors()
  val tree = Dict([(Str("a"), Arr([Num(1), Str("x")])), (Str("b"), Bool(true)), (Str("a"), Nil)])
  assertEq(tree.get("a"), Some(Nil))
  assertEq(tree.get("b").flatMap(v -> v.asBool), Some(true))
  assertEq(tree.get("z"), None)
  assertEq(Arr([Num(1), Num(2)]).get(1), Some(Num(2)))
  assertEq(Arr([Num(1)]).get(1), None)
  assertEq(Arr([Num(1)]).get(-1), None)
  assertEq(Num(1).get(0), None)
  assertEq(Nil.isNil, true)
  assertEq(Num(1).isNil, false)
  assertEq(Num(5).asLong, Some(5))
  assertEq(BigUint(-1).asLong, None)
  assertEq(BigUint(-1).asInteger, Some(BigInt("18446744073709551615")))
  assertEq(Num(-5).asInteger, Some(BigInt(-5)))
  assertEq(Num(2).asReal, Some(2.0))
  assertEq(Single(2.5).asReal, Some(2.5))
  assertEq(Str("s").asText, Some("s"))
  assertEq(Num(1).asText, None)
  assertEq(Bin(hex("01")).asBytes, Some(hex("01")))
  assertEq(Arr([]).asVector, Some(Vector.empty[Msgpack]()))
  assertEq(Dict([]).asEntries, Some(Vector.empty[(Msgpack, Msgpack)]()))
  assertEq(Nil.asBool, None)

@test("every proper prefix of every well-formed document is an error")
truncationAtEveryByte()
  val corpus = [
    "c0",
    "c2",
    "c3",
    "00",
    "cc80",
    "cd0100",
    "ce00010000",
    "cf0000000100000000",
    "d0df",
    "d1ff7f",
    "d2ffff7fff",
    "d3ffffffff7fffffff",
    "ca3fc00000",
    "cb3ff199999999999a",
    "a0",
    "a161",
    "a4f0908591",
    "d920" + hexRepeated("61", 32),
    "c403010203",
    "c50100" + hexRepeated("07", 256),
    "93010203",
    "dc0010" + hexRepeated("c0", 16),
    "81a16101",
    "de0010" + hexRepeated("0100", 16),
    "d40105",
    "d603" + "01020304",
    "d805" + hexRepeated("aa", 16),
    "c7030501" + "0203",
    "c8" + "0100" + "ff" + hexRepeated("02", 256),
    "d6ff00000001",
    "d7ff0000000400000001",
    "c70cff" + "00000000" + "ffffffffffffffff",
    "9291a16191a162",
    "81a1619181a16201"
  ]
  for text in corpus
    val whole = hex(text)
    assertEq(failure(text), "ok")
    assertEq(failure(text + "c0"), "there is data after the item")
    for n in 0 ..< whole.length
      assertEq(msgpack.parse(whole.slice(0, n)).isErr, true)

@test("a length beyond the input is an error before anything is allocated for it")
lengthsBeyondTheInput()
  assertEq(failure("dbffffffff"), "a string of 4294967295 is longer than the limit of 16777216")
  assertEq(failure("c6ffffffff"), "a binary of 4294967295 is longer than the limit of 16777216")
  assertEq(failure("c9ffffffff01"), "an extension of 4294967295 is longer than the limit of 16777216")
  assertEq(failure("ddffffffff"), "a collection of 4294967295 items is longer than the limit of 1048576")
  assertEq(failure("dfffffffff"), "a collection of 4294967295 items is longer than the limit of 1048576")
  assertEq(failure("db00ffffff"), "the input ends inside an item")
  assertEq(failure("c600ffffff"), "the input ends inside an item")
  assertEq(failure("dd000fffff"), "a collection is longer than the input that remains")
  assertEq(failure("df000fffff"), "a collection is longer than the input that remains")
  assertEq(failure("dc0002c0"), "a collection is longer than the input that remains")
  assertEq(failure("da0002"), "the input ends inside an item")
  assertEq(failure("d9"), "the input ends inside an item")
  assertEq(failure("d4"), "the input ends inside an item")
  assertEq(failure("d401"), "the input ends inside an item")

@test("nesting is limited: exactly maxDepth deep reads, one more is an error, however many follow")
nestingLimit()
  val options = MsgpackOptions(maxDepth = 8)
  assertEq(msgpack.parse(repeated("91", 8, "c0"), options).isOk, true)
  assertEq(msgpack.parse(repeated("91", 9, "c0"), options).isErr, true)
  assertEq(msgpack.parse(repeated("8101", 9, "c0"), options).isErr, true)
  assertEq(msgpack.parse(repeated("dc0001", 9, "c0"), options).isErr, true)
  assertEq(msgpack.parse(repeated("91", 200000, "c0")).isErr, true)
  assertEq(msgpack.parse(repeated("8101", 200000, "c0")).isErr, true)
  assertEq(msgpack.parse(repeated("91", 128, "c0")).isOk, true)
  assertEq(msgpack.parse(repeated("91", 129, "c0")).isErr, true)

@test("a collection, a string and a whole document are limited too")
sizeLimits()
  val items = MsgpackOptions(maxItems = 3)
  assertEq(failure("93010203", items), "ok")
  assertEq(failure("9401020304", items), "a collection of 4 items is longer than the limit of 3")
  assertEq(failure("8401020304050607" + "08", items), "a collection of 4 items is longer than the limit of 3")
  val bytes = MsgpackOptions(maxBytes = 4)
  assertEq(failure("c404" + "01020304", bytes), "ok")
  assertEq(failure("c405" + "0102030405", bytes), "a binary of 5 is longer than the limit of 4")
  assertEq(failure("a568656c6c6f", bytes), "a string of 5 is longer than the limit of 4")
  assertEq(failure("c70501" + "0102030405", bytes), "an extension of 5 is longer than the limit of 4")
  val size = MsgpackOptions(maxSize = 5)
  assertEq(failure("93010203", size), "ok")
  assertEq(failure("950102030405", size), "the document is longer than the limit of 5 bytes")
  assertEq(failure("cf0000000000000001", size), "the document is longer than the limit of 5 bytes")

@test("malformed items: the unused format byte, text that is not UTF-8")
malformed()
  assertEq(failure("c1"), "the format byte 0xC1 is never used")
  assertEq(failure("91c1"), "the format byte 0xC1 is never used")
  for text in ["a2c328", "a1ff", "a2c080", "a3eda080", "a3e6b0", "d902c328", "a1c3", "a180"]
    assertEq(failure(text).endsWith("is not UTF-8") || failure(text).startsWith("the input ends"), true)
  assertEq(failure("a1ff"), "a string is not UTF-8")
  assertEq(failure("a3eda080"), "a string is not UTF-8")
  assertEq(msgpack.parse(hex("a2c328")).mapErr(e -> e.offset), Err(1))
  assertEq(msgpack.parse(hex("92a161a2c328")).mapErr(e -> e.offset), Err(4))
  assertEq(failure(""), "the input ends inside an item")
  assertEq(failure("c0c0"), "there is data after the item")

@test("an integer beyond a long reads as the integer it is, and decoding it as a long is an error")
integersBeyondLong()
  assertEq(
    msgpack.decode[long](hex("cfffffffffffffffff")).mapErr(e -> e.message),
    Err("the integer 18446744073709551615 is beyond a long")
  )
  assertEq(
    msgpack.decode[int](hex("ce80000000")).mapErr(e -> e.message),
    Err("the integer 2147483648 is beyond an int")
  )
  assertEq(msgpack.decode[int](hex("ce7fffffff")), Ok(2147483647))
  assertEq(msgpack.decode[int](hex("d280000000")), Ok(-2147483648))
  assertEq(msgpack.decode[int](hex("d3ffffffff7fffffff")).isErr, true)
  assertEq(msgpack.decode[long](hex("d38000000000000000")), Ok(minLong))
  assertEq(msgpack.decode[long](hex("cf7fffffffffffffff")), Ok(maxLong))
  assertEq(msgpack.decode[real](hex("07")), Ok(7.0))
  assertEq(msgpack.decode[real](hex("ff")), Ok(-1.0))
  assertEq(msgpack.decode[real](hex("ca3fc00000")), Ok(1.5))

@test("deterministic writing: shortest floats, sorted keys, the same bytes for equal trees")
deterministicWriting()
  assertEq(hexOf(msgpack.encodeTree(Double(1.5), true)), "ca3fc00000")
  assertEq(hexOf(msgpack.encodeTree(Double(1.5))), "cb3ff8000000000000")
  assertEq(hexOf(msgpack.encodeTree(Single(1.5), true)), "ca3fc00000")
  assertEq(hexOf(msgpack.encodeTree(Double(1.1), true)), "cb3ff199999999999a")
  assertEq(hexOf(msgpack.encodeTree(Double(0.0), true)), "ca00000000")
  assertEq(hexOf(msgpack.encodeTree(Double(-0.0), true)), "ca80000000")
  assertEq(hexOf(msgpack.encodeTree(Double(1.0 / 0.0), true)), "ca7f800000")
  assertEq(hexOf(msgpack.encodeTree(Double(0.0 / 0.0), true)), "ca7fc00000")
  assertEq(hexOf(msgpack.encodeTree(Single(0.0 / 0.0), true)), "ca7fc00000")
  assertEq(hexOf(msgpack.encodeTree(Double(1.0e300), true)), "cb7e37e43c8800759c")
  val shuffled = [Str("bb"), Num(10), Str("a"), Nil, Num(-1), Bool(true)]
  assertEq(
    hexOf(msgpack.encodeTree(Dict(shuffled.map(k -> (k, Num(0)))), true)),
    "86" + "0a00" + "a16100" + "a2626200" + "c000" + "c300" + "ff00"
  )
  assertEq(hexOf(msgpack.encodeTree(Dict([(Str("b"), Num(1)), (Str("a"), Num(2))]), true)), "82a16102a16201")
  assertEq(hexOf(msgpack.encodeTree(Dict([(Str("b"), Num(1)), (Str("a"), Num(2))]))), "82a16201a16102")
  assertEq(hexOf(msgpack.encodeTree(Arr([Dict([(Num(2), Nil), (Num(1), Nil)])]), true)), "9182" + "01c0" + "02c0")

@test("strict reading takes the shortest forms and refuses every other")
strictReading()
  val strict = MsgpackOptions(strict = true)
  for text in [
    "00",
    "7f",
    "cc80",
    "ccff",
    "cd0100",
    "ce00010000",
    "cf0000000100000000",
    "ff",
    "e0",
    "d0df",
    "d080",
    "d1ff7f",
    "d2ffff7fff",
    "d3ffffffff7fffffff",
    "a0",
    "d920" + hexRepeated("61", 32),
    "c400",
    "d40105",
    "c7030501" + "0203",
    "c0",
    "ca3fc00000",
    "cb3ff199999999999a",
    "dc0010" + hexRepeated("c0", 16),
    "de0010" + hexRepeated("0100", 16)
  ]
    assertEq(
      failure(text, strict) == "ok" || failure(text, strict) == "map keys are not in sorted order, without repeats",
      true
    )
  for text in [
    "cc00",
    "cc7f",
    "cd0001",
    "cd00ff",
    "ce0000ffff",
    "cf00000000ffffffff",
    "d001",
    "d0ff",
    "d0e0",
    "d1ff80",
    "d2ffff8000",
    "d3ffffffff80000000",
    "d900",
    "d91f" + hexRepeated("61", 31),
    "da0001" + "61",
    "db0000000161",
    "c5000101",
    "c600000001ab",
    "dc0001c0",
    "dd00000001c0",
    "de0000",
    "df00000000",
    "c7010501",
    "c7020501" + "02",
    "c8000105" + "01",
    "cb3ff8000000000000",
    "ca7fc00001",
    "cb7ff8000000000000"
  ]
    assertEq(failure(text, strict) == "ok", false)
  assertEq(failure("cc00", strict), "an integer is not in its shortest form")
  assertEq(failure("d900", strict), "a length is not in its shortest form")
  assertEq(failure("cb3ff8000000000000", strict), "a float is not in its shortest form")
  assertEq(failure("ca7fc00001", strict), "a NaN is not the one deterministic NaN")
  assertEq(failure("82a16102a16201", strict), "ok")
  assertEq(failure("82a16201a16102", strict), "map keys are not in sorted order, without repeats")
  assertEq(failure("82a16101a16102", strict), "map keys are not in sorted order, without repeats")
  assertEq(failure("82a16101a16202", strict), "ok")
  assertEq(failure("82a16201a16102"), "ok")
  assertEq(failure("cc00"), "ok")

@test("whatever the deterministic writer writes, the strict reader reads back to the same tree")
strictReadsDeterministic()
  val strict = MsgpackOptions(strict = true)
  val trees = [
    Num(0),
    Num(127),
    Num(128),
    Num(255),
    Num(256),
    Num(65535),
    Num(65536),
    Num(4294967295),
    Num(4294967296),
    Num(-1),
    Num(-32),
    Num(-33),
    Num(-128),
    Num(-129),
    Num(-32768),
    Num(-32769),
    Num(minLong),
    Num(maxLong),
    BigUint(-1),
    BigUint(minLong),
    Double(1.5),
    Double(0.1),
    Single(100000.0),
    Str("é"),
    Bin(hex("0102")),
    Ext(5, hex("01")),
    Ext(-1, hex("00000000")),
    Dict([(Str("bb"), Num(1)), (Str("a"), Num(2)), (Num(7), Nil)]),
    Arr([Bool(true), Nil, Str("")])
  ]
  for tree in trees
    val bytes = msgpack.encodeTree(tree, true)
    val back = msgpack.parse(bytes, strict)
    assertEq(back.isOk, true)
    assertEq(msgpack.encodeTree(back.getOrElse(Nil), true), bytes)

@test("the bytes of a tree read back to it at every size of integer, string and collection")
roundTripSizes()
  for n in [0, 1, 31, 32, 255, 256, 65535, 65536, 300000]
    let_bytes(n)
  for n in [0, 1, 15, 16, 255, 256, 70000]
    val items = Vector.tabulate(n, i -> Num(long(i)))
    assertEq(msgpack.parse(msgpack.encodeTree(Arr(items))), Ok(Arr(items)))
    val entries = Vector.tabulate(n, i -> (Num(long(i)), Num(long(-i))))
    assertEq(msgpack.parse(msgpack.encodeTree(Dict(entries))), Ok(Dict(entries)))
  for n in integerSizes
    assertEq(msgpack.parse(msgpack.encodeTree(Num(n))), Ok(Num(n)))

let_bytes(n: int)
  val bytes = Array.fill(n, byte(7))
  assertEq(msgpack.parse(msgpack.encodeTree(Bin(bytes))), Ok(Bin(bytes)))
  assertEq(msgpack.parse(msgpack.encodeTree(Ext(3, bytes))), Ok(Ext(3, bytes)))
  val text = "x".repeat(n)
  assertEq(msgpack.parse(msgpack.encodeTree(Str(text))), Ok(Str(text)))

val integerSizes: Vector[long] = [
  minLong, -4294967297, -4294967296, -2147483649, -2147483648, -32769, -32768, -129, -128, -33, -32, -1, 0, 127, 128,
  255, 256, 65535, 65536, 4294967295, 4294967296, maxLong
]

data Address(street: string, city: string) derives MsgpackEncoder, MsgpackDecoder

data Person(
    @MsgpackKey("full_name") name: string,
    age: int,
    home: Option[Address],
    @MsgpackOmit visits: int = 0
) derives MsgpackEncoder, MsgpackDecoder

@MsgpackTag("kind")
data Shape derives MsgpackEncoder, MsgpackDecoder
  @MsgpackKey("circle") Circle(radius: real)
  Rect(width: real, height: real)
  Empty

data Node(value: int, children: Vector[Node]) derives MsgpackEncoder, MsgpackDecoder

data Sparse(@MsgpackOmitNone a: Option[int], b: Option[int], c: int) derives MsgpackEncoder, MsgpackDecoder

data Bag(
    tags: List[string],
    scores: HashMap[string, int],
    ordered: TreeMap[int, string],
    blob: Array[byte],
    big: long,
    ratio: real,
    nested: Option[Option[int]],
    flag: bool,
    raw: Msgpack
) derives MsgpackEncoder, MsgpackDecoder

class Counter(val n: int, val label: string) derives MsgpackEncoder, MsgpackDecoder

class Trickle(bytes: Array[byte], step: int): Reader
  private var at = 0
  override read(max: int) -> Result[Array[byte], IoError]
    val n = if bytes.length - at < step then bytes.length - at else step
    val m = if n < max then n else max
    val out = bytes.slice(at, at + m)
    at += m
    Ok(out)

class Failing(bytes: Array[byte], ok: int): Reader
  private var at = 0
  override read(max: int) -> Result[Array[byte], IoError]
    if at >= ok then return Err(IoError(Other("the connection dropped"), "read", "the source"))
    val out = bytes.slice(at, at + 1)
    at += 1
    Ok(out)

class Collect: ByteWriter
  val got = Buffer[byte]()
  var writes = 0
  override write(bytes: Array[byte]) -> Result[unit, IoError]
    writes += 1
    for b in bytes
      got.addOne(b)
    Ok(())

class Broken: ByteWriter
  override write(bytes: Array[byte]) -> Result[unit, IoError] = Err(IoError(Other("disk full"), "write", "the sink"))

val ada = Person("Ada", 36, Some(Address("1 Main", "Oslo")))

@test("a derived type is a map of its fields by name, and reads back to itself")
dataRoundTrip()
  assertEq(hexOf(msgpack.encode(Address("a", "b"))), "82" + "a6737472656574" + "a161" + "a463697479" + "a162")
  assertEq(msgpack.decode[Address](msgpack.encode(Address("a", "b"))), Ok(Address("a", "b")))
  assertEq(msgpack.decode[Person](msgpack.encode(ada)), Ok(ada))
  assertEq(
    msgpack.toTree(ada),
    Dict(
      [
        (Str("full_name"), Str("Ada")),
        (Str("age"), Num(36)),
        (Str("home"), Dict([(Str("street"), Str("1 Main")), (Str("city"), Str("Oslo"))]))
      ]
    )
  )
  assertEq(msgpack.decode[Person](msgpack.toTree(ada)), Ok(ada))
  val noHome = Person("Bo", 0, None)
  assertEq(msgpack.decode[Person](msgpack.encode(noHome)), Ok(noHome))
  assertEq(msgpack.toTree(noHome).get("home"), Some(Nil))
  assertEq(msgpack.toTree(Person("Bo", 0, None, 5)).get("visits"), None)

@test("variants carry their name under the discriminator, recursive shapes and every built-in round trip")
shapesAndBuiltIns()
  assertEq(msgpack.toTree(Circle(1.5)), Dict([(Str("kind"), Str("circle")), (Str("radius"), Single(1.5))]))
  assertEq(msgpack.decode[Shape](msgpack.encode(Circle(1.5))), Ok(Circle(1.5)))
  assertEq(msgpack.decode[Shape](msgpack.encode(Rect(2.0, 3.0))), Ok(Rect(2.0, 3.0)))
  assertEq(msgpack.decode[Shape](msgpack.encode(Empty)), Ok(Empty))
  assertEq(msgpack.toTree(Empty), Dict([(Str("kind"), Str("Empty"))]))
  assertEq(
    msgpack.decode[Shape](
      msgpack.encodeTree(Dict([(Str("radius"), Num(1)), (Str("kind"), Str("circle"))]))
    ).mapErr(e -> e.message),
    Err("expected \"kind\" first, naming the variant")
  )
  assertEq(
    msgpack.decode[Shape](msgpack.encodeTree(Dict([(Str("kind"), Str("blob"))]))).mapErr(e -> e.message),
    Err("unknown variant \"blob\"")
  )
  val tree = Node(1, [Node(2, []), Node(3, [Node(4, [])])])
  assertEq(msgpack.decode[Node](msgpack.encode(tree)), Ok(tree))
  assertEq(msgpack.decode[bool](msgpack.encode(true)), Ok(true))
  assertEq(msgpack.decode[int](msgpack.encode(-2147483647 - 1)), Ok(-2147483647 - 1))
  assertEq(msgpack.decode[long](msgpack.encode(minLong)), Ok(minLong))
  assertEq(msgpack.decode[long](msgpack.encode(maxLong)), Ok(maxLong))
  assertEq(msgpack.decode[string](msgpack.encode("é水\u{10151}")), Ok("é水\u{10151}"))
  assertEq(msgpack.decode[Array[byte]](msgpack.encode(Array[byte](1, 2, 255))), Ok(Array[byte](1, 2, 255)))
  assertEq(msgpack.decode[Array[byte]](msgpack.encode(Array.empty[byte]())), Ok(Array.empty[byte]()))
  for x in [0.0, 1.0, -1.5, 0.1, 65504.0, 1.0e300, 3.4028234663852886e38, 1.0 / 0.0, -1.0 / 0.0]
    assertEq(msgpack.decode[real](msgpack.encode(x)), Ok(x))
  assertEq(msgpack.decode[real](msgpack.encode(0.0 / 0.0)).map(x -> x != x), Ok(true))
  assertEq(hexOf(msgpack.encode(1.5)), "ca3fc00000")
  assertEq(hexOf(msgpack.encode(0.1)), "cb3fb999999999999a")
  assertEq(msgpack.decode[Option[int]](hex("c0")), Ok(None))
  assertEq(msgpack.decode[Option[int]](hex("05")), Ok(Some(5)))
  assertEq(hexOf(msgpack.encode(Vector[Option[int]](None, Some(1)))), "92c001")

@test("maps of any key type, bags of everything, None fields and unknown keys")
bagsAndKeys()
  val bag = Bag(
    ["a", "b"],
    {"x": 1, "y": 2},
    {3: "c", 1: "a"},
    Array[byte](9, 8),
    long(1) << 40,
    2.5,
    Some(Some(3)),
    true,
    Dict([(Num(1), Str("one"))])
  )
  assertEq(msgpack.decode[Bag](msgpack.encode(bag)).map(b -> b.scores.get("y")), Ok(Some(2)))
  assertEq(msgpack.decode[Bag](msgpack.encode(bag)).map(b -> b.ordered.get(3)), Ok(Some("c")))
  assertEq(msgpack.decode[Bag](msgpack.encode(bag)).map(b -> b.tags), Ok(["a", "b"].toList))
  assertEq(msgpack.decode[Bag](msgpack.encode(bag)).map(b -> b.nested), Ok(Some(Some(3))))
  assertEq(msgpack.decode[Bag](msgpack.encode(bag)).map(b -> b.raw), Ok(Dict([(Num(1), Str("one"))])))
  val two: TreeMap[int, string] = {2: "b", 1: "a"}
  assertEq(hexOf(msgpack.encode(two)), "82" + "01a161" + "02a162")
  assertEq(msgpack.decode[Counter](msgpack.encode(Counter(3, "x"))).map(c -> c.label), Ok("x"))
  assertEq(msgpack.toTree(Sparse(None, None, 1)), Dict([(Str("b"), Nil), (Str("c"), Num(1))]))
  assertEq(msgpack.decode[Sparse](msgpack.encodeTree(Dict([(Str("c"), Num(1))]))), Ok(Sparse(None, None, 1)))
  val extra = Dict(
    [
      (Str("zzz"), Arr([Dict([(Str("deep"), Arr([Num(1)]))]), Str("t"), Bin(hex("00")), Ext(1, hex("00"))])),
      (Str("street"), Str("s")),
      (Str("city"), Str("c"))
    ]
  )
  assertEq(msgpack.decode[Address](msgpack.encodeTree(extra)), Ok(Address("s", "c")))
  val twice = Dict([(Str("street"), Str("s")), (Str("city"), Str("c")), (Str("street"), Str("t"))])
  assertEq(msgpack.decode[Address](msgpack.encodeTree(twice)).mapErr(e -> e.message), Err("duplicate field \"street\""))
  assertEq(msgpack.decode[Address](hex("80")).mapErr(e -> e.message), Err("missing field \"street\""))
  assertEq(msgpack.decode[Address](hex("90")).mapErr(e -> e.message), Err("expected a map, found an array"))
  assertEq(msgpack.decode[Address](hex("810100")).mapErr(e -> e.message), Err("expected a string, found an integer"))

@test("an error names the path to the value at fault, keys and indexes in order")
errorPaths()
  val bad = Dict(
    [
      (Str("full_name"), Str("Ada")),
      (Str("age"), Num(1)),
      (Str("home"), Dict([(Str("street"), Str("s")), (Str("city"), Num(5))]))
    ]
  )
  assertEq(msgpack.decode[Person](msgpack.encodeTree(bad)).mapErr(e -> e.pathText()), Err("home.city"))
  assertEq(
    msgpack.decode[Person](msgpack.encodeTree(bad)).mapErr(e -> e.message),
    Err("expected a string, found an integer")
  )
  assertEq(
    msgpack.decode[Vector[Address]](
      msgpack.encodeTree(Arr([Dict([(Str("street"), Str("s")), (Str("city"), Str("c"))]), Num(3)]))
    ).mapErr(e -> e.pathText()),
    Err("[1]")
  )
  assertEq(
    msgpack.decode[Node](
      msgpack.encodeTree(
        Dict(
          [
            (Str("value"), Num(1)),
            (Str("children"), Arr([Dict([(Str("value"), Str("x")), (Str("children"), Arr([]))])]))
          ]
        )
      )
    ).mapErr(e -> e.pathText()),
    Err("children[0].value")
  )
  assertEq(msgpack.decode[int](hex("a0")).mapErr(e -> e.offset), Err(0))

@test("a document is read from a Reader a byte at a time, and written to a ByteWriter")
streaming()
  val bytes = msgpack.encode(ada)
  for step in [1, 2, 3, 7, 100000]
    assertEq(msgpack.decode[Person](Trickle(bytes, step)), Ok(ada))
  val big = Array.tabulate(300000, i -> byte(i % 251))
  assertEq(msgpack.parse(Trickle(msgpack.encodeTree(Bin(big)), 7000)), Ok(Bin(big)))
  assertEq(msgpack.decode[Person](Trickle(bytes.slice(0, bytes.length - 1), 1)).isErr, true)
  assertEq(msgpack.decode[Person](Trickle(bytes, 1), MsgpackOptions(maxSize = 10)).isErr, true)
  assertEq(
    msgpack.decode[Person](Failing(bytes, 5)).mapErr(e -> e.message),
    Err("the document could not be read: cannot read the source: the connection dropped")
  )
  val sink = Collect()
  assertEq(msgpack.encodeTo(sink, ada), Ok(()))
  assertEq(Array.tabulate(sink.got.length, i -> sink.got(i)), bytes)
  assertEq(sink.writes, 1)
  val many = Collect()
  val items = Vector.tabulate(100000, i -> i)
  assertEq(msgpack.encodeTo(many, items), Ok(()))
  assertEq(many.got.length, msgpack.encode(items).length)
  assertEq(many.writes > 1, true)
  assertEq(msgpack.decode[Vector[int]](Array.tabulate(many.got.length, i -> many.got(i))), Ok(items))
  assertEq(msgpack.encodeTo(Broken(), ada).mapErr(e -> e.message), Err("cannot write the sink: disk full"))
  assertEq(msgpack.encodeTo(Broken(), items).isErr, true)

@test("several documents in one stream are read one after another")
sequences()
  val bytes = hex("01" + "a161" + "93010203" + "c0")
  val r = MsgpackReader.fromReader(Trickle(bytes, 2))
  assertEq(r.hasMore(), Ok(true))
  assertEq(r.readLong(), Ok(1))
  assertEq(r.readText(), Ok("a"))
  assertEq(r.readValue(), Ok(Arr([Num(1), Num(2), Num(3)])))
  assertEq(r.takeNil(), Ok(true))
  assertEq(r.hasMore(), Ok(false))
  assertEq(r.finish(), Ok(()))
  assertEq(r.offset(), 8)
  val unfinished = MsgpackReader.fromBytes(hex("9101"))
  assertEq(unfinished.beginArray(), Ok(()))
  assertEq(unfinished.finish().isErr, true)
  assertEq(unfinished.nextElement(), Ok(true))
  assertEq(unfinished.readLong(), Ok(1))
  assertEq(unfinished.nextElement(), Ok(false))
  assertEq(unfinished.depth(), 0)

@test("strict decoding of a derived type, and deterministic encoding of one")
strictAndDeterministic()
  val strict = MsgpackOptions(strict = true)
  assertEq(msgpack.decode[Person](msgpack.encode(ada, true), strict), Ok(ada))
  assertEq(
    msgpack.decode[Address](hex("82" + "a463697479" + "a162" + "a6737472656574" + "a161"), strict),
    Ok(Address("a", "b"))
  )
  assertEq(msgpack.decode[Address](hex("82" + "a6737472656574" + "a161" + "a463697479" + "a162"), strict).isErr, true)
  assertEq(msgpack.decode[int](hex("cc00"), strict).isErr, true)
  assertEq(msgpack.decode[int](hex("cc00")), Ok(0))
  val bag = Bag(["a"], {"b": 1, "a": 2}, {2: "b", 1: "a"}, Array[byte](), 0, 1.0, None, false, Nil)
  val one = msgpack.encode(bag, true)
  assertEq(one, msgpack.encode(bag, true))
  assertEq(msgpack.decode[Bag](one, strict).map(b -> b.scores.get("a")), Ok(Some(2)))
  assertEq(msgpack.parse(one).getOrElse(Nil).get("scores"), Some(Dict([(Str("a"), Num(2)), (Str("b"), Num(1))])))

@test("GC stress: many documents built, written, read and dropped")
gcStress()
  var total = 0
  for i in 0 ..< 3000
    val p = Person(s"name $i", i, if i % 2 == 0 then Some(Address(s"street $i", "c")) else None)
    assertEq(msgpack.decode[Person](msgpack.encode(p)), Ok(p))
    total += i
    val tree = Arr(Vector.tabulate(20, k -> Dict([(Str("k"), Str(s"v$k$i"))])))
    assertEq(msgpack.parse(msgpack.encodeTree(tree)), Ok(tree))
  assertEq(total, 4498500)
