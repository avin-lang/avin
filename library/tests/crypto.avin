// `avin.crypto`: SHA-256, SHA-512, SHA-1 and MD5 against the published test vectors (the empty
// message, "abc", the 448-bit and 896-bit messages, a million `a`), Unicode text, every byte value,
// incremental hashing against one-shot at every split point, and HMAC against RFC 4231.
import avin.crypto.{sha256, sha512, sha1, md5, hmacSha256, hmacSha512, toHex, Sha256, Sha512, Sha1, Md5}

val Block448 = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
val Block896 = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
val Mixed = "héllo wörld ✓ 日本語 😀"

// `count` copies of the byte `b`.
repeated(b: int, count: int) -> Vector[byte] = Vector.tabulate(count, i -> byte(b))

// Every byte value, 0 to 255, in order.
allBytes() -> Vector[byte] = Vector.tabulate(256, i -> byte(i))

// A million `a`, as a thousand pieces of a thousand.
thousandA() -> Vector[byte] = repeated(97, 1000)

@test("SHA-256 gives the published digests of the empty message, abc, and the 448-bit and 896-bit messages")
sha256Vectors()
    assertEq(toHex(sha256("")), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    assertEq(toHex(sha256("abc")), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    assertEq(toHex(sha256(Block448)), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
    assertEq(toHex(sha256(Block896)), "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1")

@test("SHA-512 gives the published digests of the empty message, abc, and the 448-bit and 896-bit messages")
sha512Vectors()
    assertEq(toHex(sha512("")), "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")
    assertEq(toHex(sha512("abc")), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
    assertEq(toHex(sha512(Block448)), "204a8fc6dda82f0a0ced7beb8e08a41657c16ef468b228a8279be331a703c33596fd15c13b1b07f9aa1d3bea57789ca031ad85c7a71dd70354ec631238ca3445")
    assertEq(toHex(sha512(Block896)), "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909")

@test("SHA-1 gives the published digests of the empty message, abc, and the 448-bit and 896-bit messages")
sha1Vectors()
    assertEq(toHex(sha1("")), "da39a3ee5e6b4b0d3255bfef95601890afd80709")
    assertEq(toHex(sha1("abc")), "a9993e364706816aba3e25717850c26c9cd0d89d")
    assertEq(toHex(sha1(Block448)), "84983e441c3bd26ebaae4aa1f95129e5e54670f1")
    assertEq(toHex(sha1(Block896)), "a49b2446a02c645bf419f995b67091253a04a259")

@test("MD5 gives the published digests of the empty message, abc, and the 448-bit and 896-bit messages")
md5Vectors()
    assertEq(toHex(md5("")), "d41d8cd98f00b204e9800998ecf8427e")
    assertEq(toHex(md5("abc")), "900150983cd24fb0d6963f7d28e17f72")
    assertEq(toHex(md5(Block448)), "8215ef0796a20bcaaae116d3876c664a")
    assertEq(toHex(md5(Block896)), "03dd8807a93175fb062dfb55dc7d359c")

@test("a digest is as long as its algorithm says, whatever the input")
digestLengths()
    for input in ["", "a", Block896]
        assertEq(sha256(input).length(), 32)
        assertEq(sha512(input).length(), 64)
        assertEq(sha1(input).length(), 20)
        assertEq(md5(input).length(), 16)

@test("a million a, hashed incrementally in pieces of a thousand, has the published digest, and a hasher is no worse for a long input than a short one")
millionA()
    val piece = thousandA()
    val s256 = Sha256()
    val s512 = Sha512()
    val s1 = Sha1()
    val m5 = Md5()
    for i in 0 ..< 1000
        s256.update(piece)
        s512.update(piece)
        s1.update(piece)
        m5.update(piece)
    assertEq(toHex(s256.finish()), "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")
    assertEq(toHex(s512.finish()), "e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b")
    assertEq(toHex(s1.finish()), "34aa973cd4c4daa4f61eeb2bdbad27316534016f")
    assertEq(toHex(m5.finish()), "7707d6ae4e027c70eea2a935c2296f21")

@test("a million a hashed in one call has the same digests")
millionAOneShot()
    val all = repeated(97, 1000000)
    assertEq(toHex(sha256(all)), "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")
    assertEq(toHex(sha1(all)), "34aa973cd4c4daa4f61eeb2bdbad27316534016f")
    assertEq(toHex(md5(all)), "7707d6ae4e027c70eea2a935c2296f21")

@test("text is hashed as its UTF-8 bytes: multi-byte characters, and a string against its own bytes")
unicodeText()
    assertEq(toHex(sha256(Mixed)), "66755ff3516f2609be4eb559dd0610e7f4f69b88269ce9e20b709548d3febb86")
    assertEq(toHex(sha512(Mixed)), "92977cc229e7feaa37cf74d422ff53a46cfbc6f2517906b5504ffc374ee546713b710e78afa95b339d33179e73eb3e0845b985cd7d1155c30d99b040618d30cc")
    assertEq(toHex(sha1(Mixed)), "a1864913cc04b59de932cd2fb7366f91e1dfa253")
    assertEq(toHex(md5(Mixed)), "90d6bcc506582efbe0c19e717f4c2764")
    assertEq(sha256(Mixed), sha256(Mixed.bytes()))
    assertEq(sha512(Mixed), sha512(Mixed.bytes()))
    assertEq(sha1(Mixed), sha1(Mixed.bytes()))
    assertEq(md5(Mixed), md5(Mixed.bytes()))

@test("all 256 byte values, including 0 and the ones above 127, are hashed as the bytes they are")
everyByte()
    val all = allBytes()
    assertEq(toHex(sha256(all)), "40aff2e9d2d8922e47afd4648e6967497158785fbd1da870e7110266bf944880")
    assertEq(toHex(sha512(all)), "1e7b80bc8edc552c8feeb2780e111477e5bc70465fac1a77b29b35980c3f0ce4a036a6c9462036824bd56801e62af7e9feba5c22ed8a5af877bf7de117dcac6d")
    assertEq(toHex(sha1(all)), "4916d6bdb7f78e6803698cab32d1586ea457dfc8")
    assertEq(toHex(md5(all)), "e2c865db4162bed963bfaa9ef6ac18f0")

@test("toHex writes two lower-case digits for every byte, zero and 255 included, and nothing for no bytes")
hexText()
    assertEq(toHex(Vector.empty[byte]()), "")
    assertEq(toHex(Vector[byte](byte(0), byte(9), byte(10), byte(15), byte(16), byte(171), byte(255))), "00090a0f10abff")
    assertEq(toHex(allBytes()).byteLength(), 512)

@test("hashing incrementally gives the one-shot digest at every split point of an input, for every algorithm")
splitPoints()
    // 130 bytes: past two SHA-256 blocks and one SHA-512 block, so a split lands before, on and after
    // every block boundary.
    val input = Vector.tabulate(130, i -> byte((i * 7 + 3) % 256))
    for at in 0 .. input.length()
        val a = Sha256()
        val b = Sha512()
        val c = Sha1()
        val d = Md5()
        a.update(input.take(at))
        a.update(input.drop(at))
        b.update(input.take(at))
        b.update(input.drop(at))
        c.update(input.take(at))
        c.update(input.drop(at))
        d.update(input.take(at))
        d.update(input.drop(at))
        assertEq(a.finish(), sha256(input))
        assertEq(b.finish(), sha512(input))
        assertEq(c.finish(), sha1(input))
        assertEq(d.finish(), md5(input))

@test("every input length from 0 to 130 hashes the same one call or a byte at a time")
digestsOfEveryLength()
    for n in 0 .. 130
        val input = Vector.tabulate(n, i -> byte(i))
        val h = Sha256()
        val g = Sha512()
        for i in 0 ..< n
            h.update(input.slice(i, i + 1))
            g.update(input.slice(i, i + 1))
        assertEq(h.finish(), sha256(input))
        assertEq(g.finish(), sha512(input))

@test("a hasher fed nothing, empty vectors and empty text gives the digest of the empty message")
emptyUpdates()
    val h = Sha256()
    h.update(Vector.empty[byte]())
    h.update("")
    assertEq(toHex(h.finish()), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")

@test("a hasher takes text and bytes alike, and finish answers the same digest every time")
hasherText()
    val h = Sha256()
    h.update("a")
    h.update(Vector[byte](byte(98)))
    h.update("c")
    val first = h.finish()
    assertEq(toHex(first), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    assertEq(h.finish(), first)
    val m = Md5()
    m.update("abc")
    assertEq(toHex(m.finish()), "900150983cd24fb0d6963f7d28e17f72")
    assertEq(toHex(m.finish()), "900150983cd24fb0d6963f7d28e17f72")

@test(should_trap: "Sha256.update: the hasher is finished")
sha256UpdateAfterFinish()
    val h = Sha256()
    h.finish()
    h.update("x")

@test(should_trap: "Sha512.update: the hasher is finished")
sha512UpdateAfterFinish()
    val h = Sha512()
    h.finish()
    h.update("x")

@test(should_trap: "Sha1.update: the hasher is finished")
sha1UpdateAfterFinish()
    val h = Sha1()
    h.finish()
    h.update("x")

@test(should_trap: "Md5.update: the hasher is finished")
md5UpdateAfterFinish()
    val h = Md5()
    h.finish()
    h.update("x")

@test("two hashers are independent of each other")
independentHashers()
    val a = Sha256()
    val b = Sha256()
    a.update("a")
    b.update("abc")
    a.update("bc")
    assertEq(a.finish(), b.finish())

@test("HMAC-SHA-256 gives RFC 4231's test cases, a key longer than a block included")
hmacSha256Vectors()
    val aa131 = repeated(170, 131)
    assertEq(toHex(hmacSha256(repeated(11, 20), "Hi There".bytes())), "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
    assertEq(toHex(hmacSha256("Jefe", "what do ya want for nothing?")), "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
    assertEq(toHex(hmacSha256(repeated(170, 20), repeated(221, 50))), "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe")
    assertEq(toHex(hmacSha256(Vector.tabulate(25, i -> byte(i + 1)), repeated(205, 50))), "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b")
    assertEq(toHex(hmacSha256(repeated(12, 20), "Test With Truncation".bytes())), "a3b6167473100ee06e0c796c2955552bfa6f7c0a6a8aef8b93f860aab0cd20c5")
    assertEq(toHex(hmacSha256(aa131, "Test Using Larger Than Block-Size Key - Hash Key First".bytes())), "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")
    assertEq(toHex(hmacSha256(aa131, "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.".bytes())), "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2")

@test("HMAC-SHA-512 gives RFC 4231's test cases, a key longer than a block included")
hmacSha512Vectors()
    val aa131 = repeated(170, 131)
    assertEq(toHex(hmacSha512(repeated(11, 20), "Hi There".bytes())), "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854")
    assertEq(toHex(hmacSha512("Jefe", "what do ya want for nothing?")), "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737")
    assertEq(toHex(hmacSha512(repeated(170, 20), repeated(221, 50))), "fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb")
    assertEq(toHex(hmacSha512(Vector.tabulate(25, i -> byte(i + 1)), repeated(205, 50))), "b0ba465637458c6990e5a8c5f61d4af7e576d97ff94b872de76f8050361ee3dba91ca5c11aa25eb4d679275cc5788063a5f19741120c4f2de2adebeb10a298dd")
    assertEq(toHex(hmacSha512(repeated(12, 20), "Test With Truncation".bytes())), "415fad6271580a531d4179bc891d87a650188707922a4fbb36663a1eb16da008711c5b50ddd0fc235084eb9d3364a1454fb2ef67cd1d29fe6773068ea266e96b")
    assertEq(toHex(hmacSha512(aa131, "Test Using Larger Than Block-Size Key - Hash Key First".bytes())), "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598")
    assertEq(toHex(hmacSha512(aa131, "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.".bytes())), "e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58")

@test("HMAC with an empty key and an empty or short message, and the text form against the bytes form")
hmacEdges()
    assertEq(toHex(hmacSha256("", "")), "b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad")
    assertEq(toHex(hmacSha256("", "x")), "4cbc96099a6467ce002461f10549b4898265ebe6188b45efacc44293516e62c4")
    assertEq(toHex(hmacSha512("", "")), "b936cee86c9f87aa5d3c6f2e84cb5a4239a5fe50480a6ec66b70ab5b1f4ac6730c6c515421b327ec1d69402e53dfb49ad7381eb067b338fd7b0cb22247225d47")
    assertEq(toHex(hmacSha512("", "x")), "aee650458ddcbcd4557531b27f1cded4c577f576079b086f57f3c6b9e037a7c0b3cdf7ff58afa09fe279076d1107d5d554f4d34fc6f03d8fd12f93d892802ac3")
    assertEq(hmacSha256(Mixed, Mixed), hmacSha256(Mixed.bytes(), Mixed.bytes()))
    assertEq(hmacSha512(Mixed, Mixed), hmacSha512(Mixed.bytes(), Mixed.bytes()))
    assertEq(hmacSha256("k", "m").length(), 32)
    assertEq(hmacSha512("k", "m").length(), 64)

@test("a digest is a vector of bytes that compares by value and differs for different input")
digestEquality()
    assertEq(sha256("abc"), sha256("abc"))
    assert(sha256("abc") != sha256("abd"))
    assert(sha256("abc") != sha256("abc "))
