// What the tests of the binary formats, `avin.cbor` and `avin.msgpack`, share: hexadecimal text as
// bytes and back, the limits of a `long`, and the readers and writers that feed and take a document a
// piece at a time or fail. `library/tests` is one module, so each is declared here once.
import avin.encoding.{fromHex, toHex}
import avin.io.{ByteWriter, IoError, Other, Reader}

val minLong: long = -9223372036854775807 - 1
val maxLong: long = 9223372036854775807

// The bytes hexadecimal `text` writes, or none where it is not hexadecimal.
hexArray(text: string) -> Array[byte] = fromHex(text).getOrElse(Vector.empty[byte]()).toArray()

hexOf(bytes: Array[byte]) -> string = toHex(bytes.toVector)

// A reader that gives at most `step` bytes at a time.
class SlowReader(bytes: Array[byte], step: int): Reader
  private var at = 0
  override read(max: int) -> Result[Array[byte], IoError]
    val n = if bytes.length - at < step then bytes.length - at else step
    val m = if n < max then n else max
    val out = bytes.slice(at, at + m)
    at += m
    Ok(out)

// A reader that fails after `ok` bytes.
class FailingReader(bytes: Array[byte], ok: int): Reader
  private var at = 0
  override read(max: int) -> Result[Array[byte], IoError]
    if at >= ok then return Err(IoError(Other("the connection dropped"), "read", "the source"))
    val out = bytes.slice(at, at + 1)
    at += 1
    Ok(out)

// A sink that keeps what it is given and how many writes it took.
class CollectingSink: ByteWriter
  val got = Buffer[byte]()
  var writes = 0
  override write(bytes: Array[byte]) -> Result[unit, IoError]
    writes += 1
    for b in bytes
      got.addOne(b)
    Ok(())

// A sink whose every write fails.
class BrokenSink: ByteWriter
  override write(bytes: Array[byte]) -> Result[unit, IoError] = Err(IoError(Other("disk full"), "write", "the sink"))
