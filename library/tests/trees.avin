// TreeMap and TreeSet at their edges: empty, one entry, the bounds of minAfter, maxBefore and the
// ranges, and removal in every order down to nothing.

// The tree set 0, 1, …, n - 1, added in an order that is neither ascending nor descending.
scattered(n: int) -> TreeSet[int]
    var s = TreeSet.empty[int]()
    for i in 0..<n do s = s.incl((i * 7919) % n)
    s

@test("an empty tree map has no first or last entry, and nothing after or before a key")
emptyTreeMap()
    val m = TreeMap.empty[int, string]()
    assert(m.isEmpty)
    assertEq(m.headOption, None)
    assertEq(m.lastOption, None)
    assertEq(m.maxBefore(0), None)
    assertEq(m.minAfter(0), None)
    assertEq(m.removed(0), m)
    assertEq(m.range(0, 10), m)
    assertEq(m.rangeTo(0), m)
    assertEq(m.keys.length, 0)
    assert(!m.iteratorFrom(0).hasNext())

@test("minAfter is at or after a key, maxBefore strictly before it")
minAfterAndMaxBefore()
    val m = TreeMap((10, "a"), (20, "b"), (30, "c"))
    assertEq(m.maxBefore(20), Some((10, "a")))
    assertEq(m.minAfter(20), Some((20, "b")))
    assertEq(m.maxBefore(25), Some((20, "b")))
    assertEq(m.minAfter(25), Some((30, "c")))
    assertEq(m.maxBefore(10), None)
    assertEq(m.maxBefore(9), None)
    assertEq(m.minAfter(31), None)
    assertEq(m.maxBefore(1000), Some((30, "c")))
    assertEq(m.minAfter(-1000), Some((10, "a")))
    assertEq(m.headOption, Some((10, "a")))
    assertEq(m.lastOption, Some((30, "c")))

@test("head, last, firstKey and lastKey of a tree map")
treeMapEnds()
    val m = TreeMap((20, "b"), (10, "a"), (30, "c"))
    assertEq(m.head, (10, "a"))
    assertEq(m.last, (30, "c"))
    assertEq(m.firstKey(), 10)
    assertEq(m.lastKey(), 30)
    val one = TreeMap((5, "x"))
    assertEq(one.head, one.last)

@test("head of an empty tree map traps", should_trap: "head of an empty map")
emptyTreeMapHead()
    TreeMap.empty[int, string]().head

@test("lastKey of an empty tree map traps", should_trap: "last of an empty map")
emptyTreeMapLastKey()
    TreeMap.empty[int, string]().lastKey()

@test("rangeFrom and rangeTo are inclusive, rangeUntil exclusive, and an empty or reversed range is empty")
rangeBounds()
    val m = TreeMap((1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'))
    assertEq(m.rangeFrom(2).keys, [2, 3, 4])
    assertEq(m.rangeTo(3).keys, [1, 2, 3])
    assertEq(m.rangeUntil(3).keys, [1, 2])
    assertEq(m.range(2, 4).keys, [2, 3])
    assertEq(m.range(2, 2).size, 0)
    assertEq(m.range(4, 2).size, 0)
    assertEq(m.rangeFrom(5).size, 0)
    assertEq(m.rangeUntil(1).size, 0)
    assertEq(m.rangeTo(0).size, 0)
    assertEq(m.rangeTo(1).keys, [1])
    assertEq(m.rangeTo(9), m)
    assertEq(m.rangeFrom(-5), m)

@test("rangeTo between keys and on every key of a larger tree")
rangeToLarge()
    var m = TreeMap.empty[int, int]()
    for i in 0..<200 do m = m.updated(i * 2, i)
    for k in 0..<400
        assertEq(m.rangeTo(k).size, k / 2 + 1)
    assertEq(m.rangeTo(-1).size, 0)

@test("iteratorFrom, keysIteratorFrom and valuesIteratorFrom start at the least key at least the one given")
iteratorsFrom()
    val m = TreeMap((1, "a"), (3, "c"), (5, "e"))
    assertEq(m.iteratorFrom(3).toVector, [(3, "c"), (5, "e")])
    assertEq(m.keysIteratorFrom(2).toVector, [3, 5])
    assertEq(m.valuesIteratorFrom(4).toVector, ["e"])
    assertEq(m.keysIteratorFrom(0).toVector, [1, 3, 5])
    assert(!m.iteratorFrom(6).hasNext())

@test("keys, values and iteration run in ascending key order, and reverseIterator descending")
treeMapOrder()
    var m = TreeMap.empty[string, int]()
    for w in ["pear", "apple", "fig", "kiwi", "banana"] do m = m.updated(w, w.charCount())
    assertEq(m.keys, ["apple", "banana", "fig", "kiwi", "pear"])
    assertEq(m.values, [5, 6, 3, 4, 4])
    assertEq(m.reverseIterator().map(e -> e.0).toVector, ["pear", "kiwi", "fig", "banana", "apple"])
    assertEq(m.updated("fig", 0)("fig"), 0)
    assertEq(m.updated("fig", 0).size, 5)

@test("a tree map equals and hashes alike however it was built")
treeMapEquality()
    var up = TreeMap.empty[int, int]()
    for i in 0..<500 do up = up.updated(i, i * i)
    var down = TreeMap.empty[int, int]()
    var i = 499
    while i >= 0
        down = down.updated(i, i * i)
        i -= 1
    assert(up == down)
    assertEq(up.hash(), down.hash())
    assert(up != down.updated(0, 1))

@test("removing every key, in ascending, descending and scattered order, empties the tree and keeps it ordered")
treeRemovals()
    val n = 300
    val full = scattered(n)
    assertEq(full.size, n)
    var ascending = full
    for i in 0..<n
        ascending = ascending.excl(i)
        assertEq(ascending.size, n - 1 - i)
        assertEq(ascending.headOption, if i == n - 1 then None else Some(i + 1))
    var descending = full
    var i = n - 1
    while i >= 0
        descending = descending.excl(i)
        assertEq(descending.lastOption, if i == 0 then None else Some(i - 1))
        i -= 1
    var mixed = full
    for k in 0..<n
        mixed = mixed.excl((k * 7919) % n)
        assertEq(mixed.size, n - 1 - k)
    assert(mixed.isEmpty)
    assertEq(full.size, n)

@test("removing an absent element leaves an equal set")
treeRemoveAbsent()
    val s = TreeSet(1, 3)
    assertEq(s.excl(2), s)
    assertEq(TreeSet.empty[int]().excl(2).size, 0)

@test("a tree set iterates in order whatever order its elements were added in")
treeSetOrder()
    val s = scattered(1000)
    var expected = 0
    for x in s
        assertEq(x, expected)
        expected += 1
    assertEq(expected, 1000)
    assertEq(TreeSet(3, 1, 2, 3, 1), TreeSet(1, 2, 3))

@test("minAfter, maxBefore, the ends and the ranges of a tree set, and of an empty one")
treeSetBounds()
    val s = TreeSet(2, 4, 6)
    assertEq(s.maxBefore(5), Some(4))
    assertEq(s.maxBefore(4), Some(2))
    assertEq(s.minAfter(5), Some(6))
    assertEq(s.minAfter(4), Some(4))
    assertEq(s.maxBefore(2), None)
    assertEq(s.minAfter(7), None)
    assertEq(s.headOption, Some(2))
    assertEq(s.lastOption, Some(6))
    assertEq(s.head, 2)
    assertEq(s.last, 6)
    assertEq(s.firstKey(), 2)
    assertEq(s.lastKey(), 6)
    assertEq(s.rangeFrom(4), TreeSet(4, 6))
    assertEq(s.rangeTo(4), TreeSet(2, 4))
    assertEq(s.rangeUntil(4), TreeSet(2))
    assertEq(s.iteratorFrom(3).toVector, [4, 6])
    val empty = TreeSet.empty[int]()
    assertEq(empty.headOption, None)
    assertEq(empty.maxBefore(3), None)
    assertEq(empty.rangeTo(3), empty)

@test("last of an empty tree set traps", should_trap: "last of an empty set")
emptyTreeSetLast()
    TreeSet.empty[int]().last

@test("union, intersect, diff and subsetOf on tree sets, with each side empty")
treeSetAlgebra()
    val a = TreeSet(1, 2, 3)
    val b = TreeSet(3, 4)
    val none = TreeSet.empty[int]()
    assertEq(a.union(b), TreeSet(1, 2, 3, 4))
    assertEq(a.intersect(b), TreeSet(3))
    assertEq(a.diff(b), TreeSet(1, 2))
    assertEq(a.union(none), a)
    assertEq(none.intersect(a), none)
    assertEq(none.diff(a), none)
    assert(none.subsetOf(a) && a.subsetOf(a) && !a.subsetOf(b))
    assertEq(a.range(2, 3), TreeSet(2))
    assertEq(a.map(x -> -x).headOption, Some(-3))

@test("the ordered operations through SortedMap and SortedSet")
throughTheTraits()
    val m: SortedMap[int, string] = TreeMap((1, "a"), (2, "b"), (3, "c"))
    assertEq(m.rangeTo(2).keys, [1, 2])
    assertEq(m.maxBefore(3), Some((2, "b")))
    assertEq(m.lastKey(), 3)
    assertEq(m.keysIteratorFrom(2).toVector, [2, 3])
    val s: SortedSet[int] = TreeSet(5, 1, 3)
    assertEq(s.incl(0).head, 0)
    assertEq(s.rangeTo(3).toVector, [1, 3])
    assertEq(s.minAfter(2), Some(3))

@test("a tree map with string keys orders them by their bytes")
stringKeyOrder()
    val m = TreeMap(("b", 1), ("B", 2), ("", 3), ("ab", 4), ("a", 5))
    assertEq(m.keys, ["", "B", "a", "ab", "b"])
