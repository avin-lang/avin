module jsontests

// Text that is JSON: each document read and written back compact, checked together so every mismatch
// is reported. The shapes follow the accepting half of a JSON conformance suite: every kind of
// value at the top level, white space of each kind in each place, empty and nested containers.
import avin.json
import avin.json.Json

// Each text read and rendered, or its error, beside what it should be.
readAll(cases: Vector[(string, string)])
    val wrong = Buffer[string]()
    for (text, expected) in cases
        val actual = json.parse(text) match
            Ok(j) -> j.render
            Err(e) -> s"error: $e"
        if actual != expected then wrong.addOne(s"$text: expected $expected, found $actual")
        wrong.addAll(disagreements(text))
    assertEq(wrong.toVector, Vector.empty[string]())

@test("every kind of value is a document on its own")
topLevelValues()
    readAll([
        ("null", "null"),
        ("true", "true"),
        ("false", "false"),
        ("0", "0"),
        ("-1", "-1"),
        ("1.5", "1.5"),
        ("\"\"", "\"\""),
        ("\"a\"", "\"a\""),
        ("[]", "[]"),
        ("{}", "{}"),
    ])

@test("white space is space, tab, line feed and carriage return, before, after and between tokens")
whiteSpace()
    readAll([
        (" \t\r\n null \t\r\n ", "null"),
        ("[ ]", "[]"),
        ("{ }", "{}"),
        ("[\n1\n,\n2\n]", "[1,2]"),
        ("{\r\n\"a\"\t:\t1 , \"b\" :2}", "{\"a\":1,\"b\":2}"),
        ("\n\n\n[\n\n]\n\n", "[]"),
        ("[\"a b\"]", "[\"a b\"]"),
    ])

@test("arrays hold any values, of mixed kinds, nested and empty")
arrays()
    readAll([
        ("[1]", "[1]"),
        ("[1,2,3]", "[1,2,3]"),
        ("[null,true,false,0,\"s\",[],{}]", "[null,true,false,0,\"s\",[],{}]"),
        ("[[]]", "[[]]"),
        ("[[[[[]]]]]", "[[[[[]]]]]"),
        ("[[1],[2,[3]]]", "[[1],[2,[3]]]"),
        ("[{}, {\"a\": []}]", "[{},{\"a\":[]}]"),
    ])

@test("objects keep their members in the order written, duplicates included")
objects()
    readAll([
        ("{\"a\":1}", "{\"a\":1}"),
        ("{\"b\":1,\"a\":2}", "{\"b\":1,\"a\":2}"),
        ("{\"a\":1,\"a\":2}", "{\"a\":1,\"a\":2}"),
        ("{\"\":0}", "{\"\":0}"),
        ("{\"a\":{\"b\":{\"c\":{}}}}", "{\"a\":{\"b\":{\"c\":{}}}}"),
        ("{\"x\":[1,{\"y\":null}]}", "{\"x\":[1,{\"y\":null}]}"),
        ("{\"é\":\"ü\"}", "{\"é\":\"ü\"}"),
        ("{\"a\\nb\":1}", "{\"a\\nb\":1}"),
    ])

@test("words are read whole and stand next to punctuation with no space")
words()
    readAll([
        ("[true,false,null]", "[true,false,null]"),
        ("{\"a\":true}", "{\"a\":true}"),
        ("[null]", "[null]"),
    ])

@test("an object's duplicate key: every member is kept, and get answers the last")
duplicateKeys()
    val j = json.parse("{\"a\":1,\"b\":2,\"a\":3}").ok.get
    assertEq(j.size, 3)
    assertEq(j.keys, ["a", "b", "a"])
    assertEq(j.get("a"), Some(Json.Long(3)))
    assertEq(j("b"), Json.Long(2))
