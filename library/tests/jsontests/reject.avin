module jsontests

// Text that is not JSON: each is refused with the first thing wrong and its line and column. The
// shapes follow the refusing half of a JSON conformance suite: trailing and missing commas, leading
// zeros, bare words, control characters in strings, bad escapes, lone surrogates, unclosed
// containers, and text after the value.
import avin.json

// Each text's error, displayed, beside what it should be; a text that reads is a mismatch.
refuseAll(cases: Vector[(string, string)])
    val wrong = Buffer[string]()
    for (text, expected) in cases
        val actual = json.parse(text) match
            Ok(j) -> s"read as ${j.render}"
            Err(e) -> s"$e"
        if actual != expected then wrong.addOne(s"$text: expected $expected, found $actual")
        wrong.addAll(disagreements(text))
    assertEq(wrong.toVector, Vector.empty[string]())

@test("empty text and white space alone are no document")
noDocument()
    refuseAll([
        ("", "unexpected end of text where a value was expected at line 1, column 1"),
        ("   ", "unexpected end of text where a value was expected at line 1, column 4"),
        ("\n\n", "unexpected end of text where a value was expected at line 3, column 1"),
    ])

@test("a trailing comma, a missing comma and a lone comma are refused")
commas()
    refuseAll([
        ("[1,]", "unexpected ']' after ',' in an array at line 1, column 4"),
        ("[1, ]", "unexpected ']' after ',' in an array at line 1, column 5"),
        ("{\"a\":1,}", "unexpected '}' after ',' in an object at line 1, column 8"),
        ("[1 2]", "unexpected '2' in an array, where ',' or ']' was expected at line 1, column 4"),
        ("{\"a\":1 \"b\":2}", "unexpected '\"' in an object, where ',' or '}' was expected at line 1, column 8"),
        ("[,]", "unexpected ',' where a value was expected at line 1, column 2"),
        ("[,1]", "unexpected ',' where a value was expected at line 1, column 2"),
        ("[1,,2]", "unexpected ',' where a value was expected at line 1, column 4"),
        ("{,}", "unexpected ',' where an object's key was expected at line 1, column 2"),
    ])

@test("unclosed arrays, objects and strings end the text too soon")
unclosed()
    refuseAll([
        ("[", "unexpected end of text where a value was expected at line 1, column 2"),
        ("[1", "unexpected end of text in an array, where ',' or ']' was expected at line 1, column 3"),
        ("[1,", "unexpected end of text where a value was expected at line 1, column 4"),
        ("{", "unexpected end of text where an object's key was expected at line 1, column 2"),
        ("{\"a\"", "unexpected end of text after an object's key, where ':' was expected at line 1, column 5"),
        ("{\"a\":", "unexpected end of text where a value was expected at line 1, column 6"),
        ("{\"a\":1", "unexpected end of text in an object, where ',' or '}' was expected at line 1, column 7"),
        ("\"abc", "unexpected end of text in a string at line 1, column 5"),
        ("[\"a\\n", "unexpected end of text in a string at line 1, column 6"),
        ("\"\\", "unexpected end of text in an escape at line 1, column 3"),
        ("]", "unexpected ']' where a value was expected at line 1, column 1"),
        ("}", "unexpected '}' where a value was expected at line 1, column 1"),
    ])

@test("an object's key is a string, followed by a colon")
badKeys()
    refuseAll([
        ("{a:1}", "unexpected 'a' where an object's key was expected at line 1, column 2"),
        ("{1:1}", "unexpected '1' where an object's key was expected at line 1, column 2"),
        ("{null:1}", "unexpected 'n' where an object's key was expected at line 1, column 2"),
        ("{'a':1}", "unexpected ''' where an object's key was expected at line 1, column 2"),
        ("{\"a\" 1}", "unexpected '1' after an object's key, where ':' was expected at line 1, column 6"),
        ("{\"a\"=1}", "unexpected '=' after an object's key, where ':' was expected at line 1, column 5"),
        ("{\"a\"::1}", "unexpected ':' where a value was expected at line 1, column 6"),
        ("{\"a\":1:2}", "unexpected ':' in an object, where ',' or '}' was expected at line 1, column 7"),
    ])

@test("words are true, false and null, spelled whole in lower case")
badWords()
    refuseAll([
        ("tru", "unexpected word 'tru' where a value was expected at line 1, column 1"),
        ("True", "unexpected 'T' where a value was expected at line 1, column 1"),
        ("nulls", "unexpected word 'nulls' where a value was expected at line 1, column 1"),
        ("[truefalse]", "unexpected word 'truefalse' where a value was expected at line 1, column 2"),
        ("NaN", "unexpected 'N' where a value was expected at line 1, column 1"),
        ("Infinity", "unexpected 'I' where a value was expected at line 1, column 1"),
        ("undefined", "unexpected 'u' where a value was expected at line 1, column 1"),
        ("[n]", "unexpected word 'n' where a value was expected at line 1, column 2"),
    ])

@test("a number has digits where the grammar asks for them, and no leading zero")
badNumbers()
    refuseAll([
        ("01", "a number with a leading zero at line 1, column 1"),
        ("-01", "a number with a leading zero at line 1, column 2"),
        ("[00]", "a number with a leading zero at line 1, column 2"),
        ("-", "unexpected end of text in a number, where a digit was expected at line 1, column 2"),
        ("-a", "unexpected 'a' in a number, where a digit was expected at line 1, column 2"),
        ("- 1", "unexpected ' ' in a number, where a digit was expected at line 1, column 2"),
        ("+1", "unexpected '+' where a value was expected at line 1, column 1"),
        (".5", "unexpected '.' where a value was expected at line 1, column 1"),
        ("1.", "unexpected end of text after a number's '.', where a digit was expected at line 1, column 3"),
        ("1.e5", "unexpected 'e' after a number's '.', where a digit was expected at line 1, column 3"),
        ("1e", "unexpected end of text in a number's exponent, where a digit was expected at line 1, column 3"),
        ("1e+", "unexpected end of text in a number's exponent, where a digit was expected at line 1, column 4"),
        ("1E-x", "unexpected 'x' in a number's exponent, where a digit was expected at line 1, column 4"),
        ("0x10", "unexpected 'x' after the value at line 1, column 2"),
        ("1.5.2", "unexpected '.' after the value at line 1, column 4"),
        ("[1e400]", "the number 1e400 is too large for a real at line 1, column 2"),
        ("-1e400", "the number -1e400 is too large for a real at line 1, column 1"),
    ])

@test("a control character inside a string must be an escape")
controlCharacters()
    refuseAll([
        ("\"a\nb\"", "unexpected control character U+000A in a string, which must be written as an escape at line 1, column 3"),
        ("\"\t\"", "unexpected control character U+0009 in a string, which must be written as an escape at line 1, column 2"),
        ("\"\u{0}\"", "unexpected control character U+0000 in a string, which must be written as an escape at line 1, column 2"),
        ("\"\u{1f}\"", "unexpected control character U+001F in a string, which must be written as an escape at line 1, column 2"),
        ("[\"x\\n\r\"]", "unexpected control character U+000D in a string, which must be written as an escape at line 1, column 6"),
    ])

@test("an escape is one of the nine JSON names, and \\u takes four hexadecimal digits")
badEscapes()
    refuseAll([
        ("\"\\a\"", "unexpected 'a' after '\\' in a string, where an escape was expected at line 1, column 3"),
        ("\"\\x41\"", "unexpected 'x' after '\\' in a string, where an escape was expected at line 1, column 3"),
        ("\"\\'\"", "unexpected ''' after '\\' in a string, where an escape was expected at line 1, column 3"),
        ("\"\\U0041\"", "unexpected 'U' after '\\' in a string, where an escape was expected at line 1, column 3"),
        ("\"\\u41\"", "unexpected '\"' in a \\u escape, where a hexadecimal digit was expected at line 1, column 6"),
        ("\"\\u00G1\"", "unexpected 'G' in a \\u escape, where a hexadecimal digit was expected at line 1, column 6"),
        ("\"\\u", "unexpected end of text in a \\u escape at line 1, column 4"),
        ("\"\\é\"", "unexpected 'é' after '\\' in a string, where an escape was expected at line 1, column 3"),
    ])

@test("a surrogate escape is a high one followed at once by a low one")
badSurrogates()
    refuseAll([
        ("\"\\ud800\"", "a high surrogate \\uD800 with no low surrogate after it at line 1, column 2"),
        ("\"\\uDBFF x\"", "a high surrogate \\uDBFF with no low surrogate after it at line 1, column 2"),
        ("\"\\udc00\"", "a lone low surrogate \\uDC00, which no character is at line 1, column 2"),
        ("\"\\uDFFF\\uD800\"", "a lone low surrogate \\uDFFF, which no character is at line 1, column 2"),
        ("\"\\ud800\\u0041\"", "a high surrogate \\uD800 followed by \\u0041, which is not a low surrogate at line 1, column 2"),
        ("\"\\ud800\\ud800\"", "a high surrogate \\uD800 followed by \\uD800, which is not a low surrogate at line 1, column 2"),
        ("\"ab\\ud83d\\n\"", "a high surrogate \\uD83D with no low surrogate after it at line 1, column 4"),
    ])

@test("only white space may follow the value")
trailingText()
    refuseAll([
        ("1 2", "unexpected '2' after the value at line 1, column 3"),
        ("[] []", "unexpected '[' after the value at line 1, column 4"),
        ("{}x", "unexpected 'x' after the value at line 1, column 3"),
        ("null\u{0}", "unexpected control character U+0000 after the value at line 1, column 5"),
        ("\"a\"\"b\"", "unexpected '\"' after the value at line 1, column 4"),
        ("[1]\n]", "unexpected ']' after the value at line 2, column 1"),
        ("1 // comment", "unexpected '/' after the value at line 1, column 3"),
    ])

@test("white space is only the four JSON characters: form feed, vertical tab and no-break space are not")
otherSpaces()
    refuseAll([
        ("\u{c}1", "unexpected control character U+000C where a value was expected at line 1, column 1"),
        ("[1\u{b}]", "unexpected control character U+000B in an array, where ',' or ']' was expected at line 1, column 3"),
        ("\u{a0}1", "unexpected '\u{a0}' where a value was expected at line 1, column 1"),
        ("\u{feff}1", "unexpected '\u{feff}' where a value was expected at line 1, column 1"),
    ])

@test("the line and column count lines by line feed, and columns in characters rather than bytes")
positions()
    refuseAll([
        ("[\n  1,\n  x]", "unexpected 'x' where a value was expected at line 3, column 3"),
        ("{\"é\":\"日本\",x}", "unexpected 'x' where an object's key was expected at line 1, column 11"),
        ("[\"😀\" x]", "unexpected 'x' in an array, where ',' or ']' was expected at line 1, column 6"),
        ("\r\n\r\n x", "unexpected 'x' where a value was expected at line 3, column 2"),
        ("[1,\n\n\n", "unexpected end of text where a value was expected at line 4, column 1"),
    ])

@test("an error carries its byte offset as well as its line and column")
errorFields()
    val e = json.parse("[\"é\", x]").err.get
    assertEq(e.line, 1)
    assertEq(e.column, 7)
    assertEq(e.offset, 7)
    assertEq(e.message, "unexpected 'x' where a value was expected")
