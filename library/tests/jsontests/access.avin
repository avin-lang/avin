module jsontests

// Reading values out of a `Json`: the Option accessors, `get` and `apply` by key and index, and making
// values with the companion's functions and `with`.
import avin.json
import avin.json.Json

val sample: Json = json.parse("{\"id\": 7, \"name\": \"job\", \"ok\": true, \"none\": null, \"tags\": [\"a\", \"b\"], \"inner\": {\"x\": 1.5}}").ok.get

@test("each accessor answers for its own kind of value and None for every other")
accessorsByKind()
    val values = [Json.Null, Json.Bool(true), Json.Long(1), Json.Real(1.5), Json.Str("s"), Json.arr(), Json.obj()]
    assertEq(values.map(v -> v.isNull), [true, false, false, false, false, false, false])
    assertEq(values.map(v -> v.asBool.isDefined), [false, true, false, false, false, false, false])
    assertEq(values.map(v -> v.asLong.isDefined), [false, false, true, false, false, false, false])
    assertEq(values.map(v -> v.asReal.isDefined), [false, false, true, true, false, false, false])
    assertEq(values.map(v -> v.asString.isDefined), [false, false, false, false, true, false, false])
    assertEq(values.map(v -> v.asVector.isDefined), [false, false, false, false, false, true, false])
    assertEq(values.map(v -> v.asMembers.isDefined), [false, false, false, false, false, false, true])
    assertEq(values.map(v -> v.size), [0, 0, 0, 0, 0, 0, 0])

@test("a member is reached by get as an Option and by apply directly")
members()
    assertEq(sample.get("id"), Some(Json.Long(7)))
    assertEq(sample("name").asString, Some("job"))
    assertEq(sample("ok").asBool, Some(true))
    assert(sample("none").isNull)
    assertEq(sample.get("missing"), None)
    assertEq(sample("inner")("x").asReal, Some(1.5))
    assertEq(sample.get("inner").flatMap(i -> i.get("x")).flatMap(x -> x.asReal), Some(1.5))
    assert(sample.has("none"))
    assert(!sample.has("missing"))
    assertEq(sample.keys, ["id", "name", "ok", "none", "tags", "inner"])
    assertEq(sample.size, 6)
    assertEq(Json.Arr([Json.Long(1)]).get("id"), None)
    assertEq(Json.Str("id").get("id"), None)

@test("an element is reached by get as an Option, None outside the array, and by apply directly")
elements()
    val tags = sample("tags")
    assertEq(tags.get(0), Some(Json.Str("a")))
    assertEq(tags(1).asString, Some("b"))
    assertEq(tags.get(2), None)
    assertEq(tags.get(-1), None)
    assertEq(tags.size, 2)
    assertEq(tags.asVector.get.map(t -> t.asString.get), ["a", "b"])
    assertEq(sample.get(0), None)
    assertEq(Json.arr().get(0), None)

@test("the Option accessors chain with ? inside a function answering an Option")
chained()
    assertEq(innerX(sample), Some(1.5))
    assertEq(innerX(Json.obj()), None)
    assertEq(innerX(Json.obj(("inner", Json.Long(3)))), None)
    assertEq(innerX(Json.obj(("inner", Json.obj(("x", Json.Long(3)))))), Some(3.0))

innerX(j: Json) -> Option[real] = j.get("inner")?.get("x")?.asReal

@test("the companion's functions make each kind of value; num takes an int, a long or a real")
making()
    assertEq(Json.obj(("a", Json.num(1)), ("b", Json.str("x"))).render, "{\"a\":1,\"b\":\"x\"}")
    assertEq(Json.arr(Json.num(1), Json.num(long(2)), Json.num(2.5), Json.Null, Json.Bool(false)).render, "[1,2,2.5,null,false]")
    assertEq(Json.obj().render, "{}")
    assertEq(Json.arr().render, "[]")
    assertEq(Json.num(1), Json.Long(1))
    assertEq(Json.num(1.0), Json.Real(1.0))
    val items = [Json.num(1), Json.num(2)]
    assertEq(Json.arr(items*).render, "[1,2]")
    val pairs = Buffer[(string, Json)]()
    for i in 0..<3 do pairs.addOne((s"k$i", Json.num(i)))
    assertEq(Json.Obj(pairs.toVector).render, "{\"k0\":0,\"k1\":1,\"k2\":2}")

@test("with replaces a member in place, the last of duplicates, adds a new one at the end, and leaves a non-object alone")
withMembers()
    val o = Json.obj(("a", Json.num(1)), ("b", Json.num(2)))
    assertEq(o.with("a", Json.num(9)).render, "{\"a\":9,\"b\":2}")
    assertEq(o.with("c", Json.Null).render, "{\"a\":1,\"b\":2,\"c\":null}")
    assertEq(o.render, "{\"a\":1,\"b\":2}")
    val dup = json.parse("{\"a\":1,\"a\":2}").ok.get
    assertEq(dup.with("a", Json.num(3)).render, "{\"a\":1,\"a\":3}")
    assertEq(Json.obj().with("x", Json.Bool(true)).render, "{\"x\":true}")
    assertEq(Json.arr().with("x", Json.Null), Json.arr())
    assertEq(Json.Null.with("x", Json.Null), Json.Null)

@test("values compare by structure, an object's members in order")
equality()
    assertEq(json.parse("{\"a\":[1,2]}").ok.get, Json.obj(("a", Json.arr(Json.num(1), Json.num(2)))))
    assert(json.parse("{\"a\":1,\"b\":2}").ok.get != json.parse("{\"b\":2,\"a\":1}").ok.get)
    assert(Json.Long(1) != Json.Real(1.0))
    assert(Json.Str("1") != Json.Long(1))
    assertEq(Json.Null, Json.Null)

@test("a value displays and debugs as its compact text, in interpolation and in a field")
display()
    val j = Json.obj(("a", Json.arr(Json.num(1), Json.str("é"))))
    assertEq(s"$j", "{\"a\":[1,\"é\"]}")
    assertEq(j.toString(), "{\"a\":[1,\"é\"]}")
    assertEq(debug(j), "{\"a\":[1,\"é\"]}")
    assertEq(f"[${Json.Null}%6s]", "[  null]")
    assertEq(f"[${Json.Null}%-6s]", "[null  ]")
    assertEq(s"${[Json.Long(1), Json.Null]}", "[1, null]")
    val w = StringWriter()
    j.writeTo(w)
    assertEq(w.text, j.render)

@test("an error displays as its message and its place")
errorDisplay()
    val e = json.parse("[1,\n x]").err.get
    assertEq(s"$e", "unexpected 'x' where a value was expected at line 2, column 2")
    assertEq(e, json.JsonError("unexpected 'x' where a value was expected", 2, 2, 5))

@test("values travel in generic containers, Options and Results, and through closures")
inContainers()
    val byName = Map(("a", Json.num(1)), ("b", Json.arr()))
    assertEq(byName("a"), Json.Long(1))
    val maybe: Option[Json] = Some(Json.Null)
    assertEq(maybe.map(j -> j.isNull), Some(true))
    val results: Vector[Result[Json, json.JsonError]] = ["1", "x", "[]"].map(t -> json.parse(t))
    assertEq(results.map(r -> r.isOk), [true, false, true])
    val readers = ["{\"n\":1}", "{\"n\":2}"].map(t -> json.parse(t).ok.get).map(j -> () -> j("n").asLong.get)
    assertEq(readers.map(f -> f()), [long(1), long(2)])
    val nested: Vector[Vector[Json]] = [[Json.num(1)], [], [Json.str("x"), Json.Null]]
    assertEq(Json.Arr(nested.map(v -> Json.Arr(v))).render, "[[1],[],[\"x\",null]]")
