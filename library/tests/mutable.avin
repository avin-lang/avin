import avin.collections.mutable.{Map as MutableMap, Set as MutableSet}

// Buffer and Deque at their edges: empty, one element, growth past the capacity, a deque wrapping
// around its array, and the indices just inside and just outside the elements.

@test("a buffer grows past every capacity it passes and keeps its elements in order")
bufferGrowth()
    val b = Buffer.empty[int]()
    for i in 0..<1000 do b.add(i)
    assertEq(b.length(), 1000)
    for i in 0..<1000 do assertEq(b(i), i)

@test("insert at the front, in the middle and at the end, which appends")
bufferInsert()
    val b = Buffer.empty[string]()
    b.insert(0, "b")
    b.insert(0, "a")
    b.insert(2, "d")
    b.insert(2, "c")
    assertEq(b.toVector(), ["a", "b", "c", "d"])

@test(should_trap: "index out of range")
bufferInsertPastTheEndTraps()
    val b = Buffer.empty[int]()
    b.insert(1, 0)

@test("remove at the front, the middle and the end returns the element and closes the gap")
bufferRemove()
    val b = Buffer.empty[int]()
    b.addAll([0, 1, 2, 3, 4])
    assertEq(b.remove(0), 0)
    assertEq(b.remove(3), 4)
    assertEq(b.remove(1), 2)
    assertEq(b.toVector(), [1, 3])
    assertEq(b.remove(0), 1)
    assertEq(b.remove(0), 3)
    assert(b.isEmpty())

@test(should_trap: "index out of range")
bufferRemoveFromEmptyTraps()
    Buffer.empty[int]().remove(0)

@test(should_trap: "index out of range")
bufferNegativeIndexTraps()
    val b = Buffer.empty[int]()
    b.add(1)
    b(-1)

@test(should_trap: "index out of range")
bufferUpdatePastTheEndTraps()
    val b = Buffer.empty[int]()
    b.add(1)
    b(1) = 2

@test("clear empties a buffer, which then takes new elements")
bufferClear()
    val b = Buffer.empty[int]()
    b.addAll([1, 2, 3])
    b.clear()
    assert(b.isEmpty())
    b.add(9)
    assertEq(b.toVector(), [9])

@test("a buffer added to itself appends the elements it held, once")
bufferAddsItself()
    val b = Buffer.empty[int]()
    b.addAll([1, 2])
    b.addAll(b)
    assertEq(b.toVector(), [1, 2, 1, 2])
    b ++= b
    assertEq(b.length(), 8)

@test("sorting a buffer in place is stable, and an empty or one-element buffer sorts")
bufferSort()
    val b = Buffer.empty[(int, string)]()
    b.addAll([(2, "a"), (1, "b"), (2, "c"), (1, "d")])
    b.sortInPlaceBy(p -> p.0)
    assertEq(b.toVector(), [(1, "b"), (1, "d"), (2, "a"), (2, "c")])
    val empty = Buffer.empty[int]()
    empty.sortInPlace()
    assert(empty.isEmpty())
    val one = Buffer.empty[int]()
    one.add(5)
    one.sortInPlace()
    assertEq(one.toVector(), [5])

@test("a deque used as a queue wraps around its array many times and keeps its order")
dequeWraps()
    val d = Deque[int]()
    var next = 0
    var expected = 0
    for round in 0..<200
        for _ in 0..<3
            d.addLast(next)
            next += 1
        for _ in 0..<2
            assertEq(d.removeFirst(), expected)
            expected += 1
    assertEq(d.length(), 200)
    for i in 0..<d.length() do assertEq(d(i), expected + i)

@test("a deque grows at both ends past its capacity, and reads front to back")
dequeBothEnds()
    val d = Deque[int]()
    for i in 1..100
        d.addLast(i)
        d.addFirst(-i)
    assertEq(d.length(), 200)
    assertEq(d(0), -100)
    assertEq(d(199), 100)
    assertEq(d.toVector().take(3), [-100, -99, -98])
    assertEq(d.removeLast(), 100)
    assertEq(d.removeFirst(), -100)
    assertEq(d.length(), 198)

@test("a deque emptied from either end is empty, and takes elements again")
dequeEmptied()
    val d = Deque[string]()
    d.addFirst("a")
    assertEq(d.removeLast(), "a")
    assert(d.isEmpty())
    d.addLast("b")
    assertEq(d.removeFirst(), "b")
    assert(d.isEmpty())
    d.addAll(["c", "d"])
    d.clear()
    assertEq(d.length(), 0)
    d.addFirst("e")
    assertEq(d.toVector(), ["e"])

@test(should_trap: "removeFirst on an empty deque")
dequeRemoveFirstFromEmptyTraps()
    Deque[int]().removeFirst()

@test(should_trap: "removeLast on an empty deque")
dequeRemoveLastFromEmptyTraps()
    Deque[int]().removeLast()

@test(should_trap: "index out of range")
dequeIndexPastTheEndTraps()
    val d = Deque[int]()
    d.addFirst(1)
    d(1)

@test("a deque added to itself appends the elements it held, once")
dequeAddsItself()
    val d = Deque[int]()
    d.addAll([1, 2])
    d.addFirst(0)
    d.addAll(d)
    assertEq(d.toVector(), [0, 1, 2, 0, 1, 2])

@test("a mutable set added to itself is unchanged, and one with itself removed is empty")
mutableSetWithItself()
    val s = MutableSet[int]()
    for i in 0..<100 do s += i
    s ++= s
    assertEq(s.size(), 100)
    s --= s
    assert(s.isEmpty())

@test("a mutable map added to itself is unchanged, and one with its own keys removed is empty")
mutableMapWithItself()
    val m = MutableMap[int, string]()
    for i in 0..<100 do m(i) = i.toString()
    m ++= m
    assertEq(m.size(), 100)
    assertEq(m(42), "42")
    m --= m.keys()
    assert(m.isEmpty())