import avin.collections.mutable.{Map as MutableMap, Set as MutableSet}

// Buffer and Deque at their edges: empty, one element, growth past the capacity, a deque wrapping
// around its array, and the indices just inside and just outside the elements.

@test("a buffer grows past every capacity it passes and keeps its elements in order")
bufferGrowth()
    val b = Buffer.empty[int]()
    for i in 0..<1000 do b.addOne(i)
    assertEq(b.length, 1000)
    for i in 0..<1000 do assertEq(b(i), i)

@test("insert at the front, in the middle and at the end, which appends")
bufferInsert()
    val b = Buffer.empty[string]()
    b.insert(0, "b")
    b.insert(0, "a")
    b.insert(2, "d")
    b.insert(2, "c")
    assertEq(b.toVector, ["a", "b", "c", "d"])

@test(should_trap: "index out of range")
bufferInsertPastTheEndTraps()
    val b = Buffer.empty[int]()
    b.insert(1, 0)

@test("remove at the front, the middle and the end returns the element and closes the gap")
bufferRemove()
    val b = Buffer.empty[int]()
    b.addAll([0, 1, 2, 3, 4])
    assertEq(b.remove(0), 0)
    assertEq(b.remove(3), 4)
    assertEq(b.remove(1), 2)
    assertEq(b.toVector, [1, 3])
    assertEq(b.remove(0), 1)
    assertEq(b.remove(0), 3)
    assert(b.isEmpty)

@test(should_trap: "index out of range")
bufferRemoveFromEmptyTraps()
    Buffer.empty[int]().remove(0)

@test(should_trap: "index out of range")
bufferNegativeIndexTraps()
    val b = Buffer.empty[int]()
    b.addOne(1)
    b(-1)

@test(should_trap: "index out of range")
bufferUpdatePastTheEndTraps()
    val b = Buffer.empty[int]()
    b.addOne(1)
    b(1) = 2

@test("clear empties a buffer, which then takes new elements")
bufferClear()
    val b = Buffer.empty[int]()
    b.addAll([1, 2, 3])
    b.clear()
    assert(b.isEmpty)
    b.addOne(9)
    assertEq(b.toVector, [9])

@test("a buffer added to itself appends the elements it held, once")
bufferAddsItself()
    val b = Buffer.empty[int]()
    b.addAll([1, 2])
    b.addAll(b)
    assertEq(b.toVector, [1, 2, 1, 2])
    b ++= b
    assertEq(b.length, 8)

@test("sorting a buffer in place is stable, and an empty or one-element buffer sorts")
bufferSort()
    val b = Buffer.empty[(int, string)]()
    b.addAll([(2, "a"), (1, "b"), (2, "c"), (1, "d")])
    b.sortInPlaceBy(p -> p.0)
    assertEq(b.toVector, [(1, "b"), (1, "d"), (2, "a"), (2, "c")])
    val empty = Buffer.empty[int]()
    empty.sortInPlace()
    assert(empty.isEmpty)
    val one = Buffer.empty[int]()
    one.addOne(5)
    one.sortInPlace()
    assertEq(one.toVector, [5])

@test("a deque used as a queue wraps around its array many times and keeps its order")
dequeWraps()
    val d = Deque[int]()
    var next = 0
    var expected = 0
    for round in 0..<200
        for _ in 0..<3
            d.append(next)
            next += 1
        for _ in 0..<2
            assertEq(d.removeHead(), expected)
            expected += 1
    assertEq(d.length, 200)
    for i in 0..<d.length do assertEq(d(i), expected + i)

@test("a deque grows at both ends past its capacity, and reads front to back")
dequeBothEnds()
    val d = Deque[int]()
    for i in 1..100
        d.append(i)
        d.prepend(-i)
    assertEq(d.length, 200)
    assertEq(d(0), -100)
    assertEq(d(199), 100)
    assertEq(d.toVector.take(3), [-100, -99, -98])
    assertEq(d.removeLast(), 100)
    assertEq(d.removeHead(), -100)
    assertEq(d.length, 198)

@test("a deque emptied from either end is empty, and takes elements again")
dequeEmptied()
    val d = Deque[string]()
    d.prepend("a")
    assertEq(d.removeLast(), "a")
    assert(d.isEmpty)
    d.append("b")
    assertEq(d.removeHead(), "b")
    assert(d.isEmpty)
    d.addAll(["c", "d"])
    d.clear()
    assertEq(d.length, 0)
    d.prepend("e")
    assertEq(d.toVector, ["e"])

@test(should_trap: "removeHead on an empty deque")
dequeRemoveHeadFromEmptyTraps()
    Deque[int]().removeHead()

@test(should_trap: "removeLast on an empty deque")
dequeRemoveLastFromEmptyTraps()
    Deque[int]().removeLast()

@test(should_trap: "index out of range")
dequeIndexPastTheEndTraps()
    val d = Deque[int]()
    d.prepend(1)
    d(1)

@test("a deque added to itself appends the elements it held, once")
dequeAddsItself()
    val d = Deque[int]()
    d.addAll([1, 2])
    d.prepend(0)
    d.addAll(d)
    assertEq(d.toVector, [0, 1, 2, 0, 1, 2])

@test("append, prepend and their All forms add at the ends of a buffer, in order")
bufferEnds()
    val b = Buffer.empty[int]()
    b.append(3)
    b.prepend(2)
    b.addOne(4)
    b.prependAll([0, 1])
    b.appendAll([5, 6])
    assertEq(b.toVector, [0, 1, 2, 3, 4, 5, 6])
    b.prependAll([])
    b.appendAll(List.empty[int]())
    assertEq(b.length, 7)
    val e = Buffer.empty[string]()
    e.prepend("x")
    assertEq(e.toVector, ["x"])

@test("insertAll puts the elements at the front, in the middle and at the end, across growth")
bufferInsertAll()
    val b = Buffer.empty[int]()
    b.insertAll(0, [4, 5])
    b.insertAll(0, [0, 1])
    b.insertAll(2, [2, 3])
    b.insertAll(6, [6])
    assertEq(b.toVector, [0, 1, 2, 3, 4, 5, 6])
    b.insertAll(3, 100..<120)
    assertEq(b.length, 27)
    assertEq(b(2), 2)
    assertEq(b(3), 100)
    assertEq(b(22), 119)
    assertEq(b(23), 3)
    assertEq(b(26), 6)

@test("a buffer inserted into or prepended to itself places the elements it held, once")
bufferInsertsItself()
    val b = Buffer.empty[int]()
    b.addAll([1, 2, 3])
    b.insertAll(1, b)
    assertEq(b.toVector, [1, 1, 2, 3, 2, 3])
    val p = Buffer.empty[int]()
    p.addAll([7, 8])
    p.prependAll(p)
    assertEq(p.toVector, [7, 8, 7, 8])
    p.appendAll(p)
    assertEq(p.length, 8)

@test(should_trap: "index out of range")
bufferInsertAllPastTheEndTraps()
    val b = Buffer.empty[int]()
    b.addOne(1)
    b.insertAll(2, [0])

@test("sizeHint makes room without changing a buffer's elements")
bufferSizeHint()
    val b = Buffer.empty[int]()
    b.addAll([1, 2])
    b.sizeHint(100)
    assertEq(b.toVector, [1, 2])
    for i in 3..100 do b.addOne(i)
    assertEq(b.length, 100)
    assertEq(b(99), 100)
    b.sizeHint(0)
    b.sizeHint(-1)
    assertEq(b.length, 100)

@test("a deque appends and prepends, singly and in order, and inserts at any index")
dequeEnds()
    val d = Deque[int]()
    d.append(3)
    d.prepend(2)
    d.addOne(4)
    d.prependAll([0, 1])
    d.appendAll([5, 6])
    assertEq(d.toVector, [0, 1, 2, 3, 4, 5, 6])
    d.insert(0, -1)
    d.insert(8, 7)
    d.insert(4, 100)
    assertEq(d.toVector, [-1, 0, 1, 2, 100, 3, 4, 5, 6, 7])
    d.insertAll(1, [10, 11])
    d.insertAll(d.length, [12])
    assertEq(d.toVector, [-1, 10, 11, 0, 1, 2, 100, 3, 4, 5, 6, 7, 12])
    assertEq(d.removeHead(), -1)
    assertEq(d.removeLast(), 12)

@test("a deque prepended to or inserted into itself places the elements it held, once")
dequeWithItself()
    val d = Deque[int]()
    d.appendAll([1, 2])
    d.prependAll(d)
    assertEq(d.toVector, [1, 2, 1, 2])
    d.insertAll(2, d)
    assertEq(d.toVector, [1, 2, 1, 2, 1, 2, 1, 2])

@test("a deque inserts after wrapping around its array")
dequeInsertWrapped()
    val d = Deque[int]()
    for i in 0..<8 do d.append(i)
    for _ in 0..<6 do d.removeHead()
    d.append(8)
    d.append(9)
    d.insert(2, 50)
    assertEq(d.toVector, [6, 7, 50, 8, 9])

@test(should_trap: "index out of range")
dequeInsertPastTheEndTraps()
    Deque[int]().insert(1, 0)

@test("every builder clears to build again, leaving a result it handed over unchanged")
buildersClear()
    val vb = Vector.newBuilder[int]()
    vb.addAll([1, 2])
    val v = vb.result()
    vb.clear()
    vb.addOne(3)
    assertEq(vb.result(), [3])
    assertEq(v, [1, 2])
    val bb = Buffer.newBuilder[int]()
    bb.addOne(1)
    val buffer = bb.result()
    bb.clear()
    bb.addOne(2)
    assertEq(bb.result().toVector, [2])
    assertEq(buffer.toVector, [1])
    val db = Deque.newBuilder[int]()
    db.addOne(1)
    val deque = db.result()
    db.clear()
    assertEq(db.result().length, 0)
    assertEq(deque.toVector, [1])
    val lb = List.newBuilder[int]()
    lb.addOne(1)
    lb.clear()
    lb.addOne(2)
    assertEq(lb.result(), List(2))
    val ab = Array.newBuilder[int]()
    ab.addOne(1)
    val array = ab.result()
    ab.clear()
    ab.addOne(5)
    assertEq(ab.result().length, 1)
    assertEq(array(0), 1)
    val sb = ArraySeq.newBuilder[string]()
    sb.addOne("a")
    sb.clear()
    assertEq(sb.result().length, 0)

@test("map and set builders clear to build again")
keyedBuildersClear()
    val mb = Map.newBuilder[string, int]()
    mb.addOne(("a", 1))
    val m = mb.result()
    mb.clear()
    mb.addOne(("b", 2))
    assertEq(mb.result(), {b: 2})
    assertEq(m, {a: 1})
    val hs = Set.newBuilder[int]()
    hs.addOne(1)
    hs.clear()
    hs.addOne(2)
    assertEq(hs.result(), {2})
    val tm = TreeMap.newBuilder[int, string]()
    tm.addOne((1, "x"))
    tm.clear()
    assertEq(tm.result().size, 0)
    val ts = TreeSet.newBuilder[int]()
    ts.addOne(3)
    val kept = ts.result()
    ts.clear()
    ts.addOne(4)
    assertEq(ts.result().toVector, [4])
    assertEq(kept.toVector, [3])
    val mm = MutableMap.newBuilder[string, int]()
    mm.addOne(("a", 1))
    val mutableKept = mm.result()
    mm.clear()
    mm.addOne(("b", 2))
    assertEq(mm.result().size, 1)
    assertEq(mutableKept.size, 1)
    assert(mutableKept.contains("a"))
    val ms = MutableSet.newBuilder[int]()
    ms.addOne(1)
    val setKept = ms.result()
    ms.clear()
    assertEq(ms.result().size, 0)
    assertEq(setKept.size, 1)

@test("knownSize counts what a builder holding its elements has, and is -1 for the others")
builderSizes()
    val bb = Buffer.newBuilder[int]()
    assertEq(bb.knownSize, 0)
    bb.sizeHint(10)
    bb.addAll([1, 2, 3])
    assertEq(bb.knownSize, 3)
    val ab = Array.newBuilder[int]()
    ab.sizeHint(2)
    ab.addOne(1)
    assertEq(ab.knownSize, 1)
    val db = Deque.newBuilder[int]()
    db.addOne(1)
    assertEq(db.knownSize, 1)
    val vb = Vector.newBuilder[int]()
    vb.sizeHint(5)
    vb.addOne(1)
    assertEq(vb.knownSize, -1)
    assertEq(vb.result(), [1])
    val lb = List.newBuilder[int]()
    assertEq(lb.knownSize, -1)
    val generic: Builder[int, Vector[int]] = Vector.newBuilder[int]()
    generic.sizeHint(3)
    assertEq(generic.knownSize, -1)

@test(should_trap: "add to a builder whose result was taken")
spentBuilderStillTraps()
    val b = Vector.newBuilder[int]()
    b.result()
    b.addOne(1)

@test("a mutable set added to itself is unchanged, and one with itself removed is empty")
mutableSetWithItself()
    val s = MutableSet[int]()
    for i in 0..<100 do s += i
    s ++= s
    assertEq(s.size, 100)
    s --= s
    assert(s.isEmpty)

@test("a mutable map added to itself is unchanged, and one with its own keys removed is empty")
mutableMapWithItself()
    val m = MutableMap[int, string]()
    for i in 0..<100 do m(i) = i.toString()
    m ++= m
    assertEq(m.size, 100)
    assertEq(m(42), "42")
    m --= m.keys
    assert(m.isEmpty)