// Map and Set at their edges: empty, one entry, keys whose hashes collide, removal down to nothing,
// and enough entries to deepen the trie.

// A key whose hash is the same for every value, so every key collides with every other.
data Clash(n: int)

impl Eq for Clash
  equals(other: Clash) -> bool = n == other.n

impl Hash for Clash
  hash() -> long = 7

@test("an empty map finds nothing, and removing from it leaves it empty")
emptyMap()
  val m = Map.empty[string, int]()
  assert(m.isEmpty)
  assertEq(m.size, 0)
  assertEq(m.get("a"), None)
  assertEq(m.getOrElse("a", 5), 5)
  assert(!m.contains("a"))
  assert(m.removed("a").isEmpty)
  assertEq(m.keys.length, 0)
  assertEq(m, Map.empty[string, int]())

@test(should_trap)
missingKeyTraps()
  Map(("a", 1)).apply("b")

@test("updated replaces a key's value rather than adding a second entry")
updateReplaces()
  val m = Map(("a", 1)).updated("a", 2)
  assertEq(m.size, 1)
  assertEq(m("a"), 2)
  assertEq(Map(("a", 1), ("a", 3)), Map(("a", 3)))

@test("keys whose hashes collide are kept apart, found, replaced and removed one by one")
collidingKeys()
  var m = Map.empty[Clash, int]()
  for i in 0 ..< 20 do m = m.updated(Clash(i), i * 10)
  assertEq(m.size, 20)
  for i in 0 ..< 20 do assertEq(m.get(Clash(i)), Some(i * 10))
  assertEq(m.get(Clash(20)), None)
  m = m.updated(Clash(5), -1)
  assertEq(m.size, 20)
  assertEq(m(Clash(5)), -1)
  for i in 0 ..< 20
    m = m.removed(Clash(i))
    assertEq(m.size, 19 - i)
    assert(!m.contains(Clash(i)))
    if i < 19 then assert(m.contains(Clash(i + 1)))
  assert(m.isEmpty)
  assertEq(m, Map.empty[Clash, int]())

@test("a large map holds, finds and removes every key, and equals one built in another order")
largeMap()
  var m = Map.empty[int, int]()
  for i in 0 ..< 5000 do m = m.updated(i, -i)
  assertEq(m.size, 5000)
  var back = Map.empty[int, int]()
  var i = 4999
  while i >= 0
    back = back.updated(i, -i)
    i -= 1
  assert(m == back)
  assertEq(m.hash(), back.hash())
  for k in 0 ..< 5000 do assertEq(m(k), -k)
  for k in 0 ..< 5000
    if k % 2 == 0 then m = m.removed(k)
  assertEq(m.size, 2500)
  assert(!m.contains(0) && m.contains(1) && !m.contains(4998) && m.contains(4999))
  assert(m != back)

@test("removing an absent key gives an equal map")
removeAbsent()
  val m = Map((1, "a"), (2, "b"))
  assertEq(m.removed(3), m)
  assertEq(m.removed(1).removed(1), Map((2, "b")))

@test("updatedWith adds, changes and removes by what its function answers")
updatedWith()
  val m = Map(("a", 1))
  assertEq(m.updatedWith("a", v -> v.map(x -> x + 1)), Map(("a", 2)))
  assertEq(m.updatedWith("a", v -> None), Map.empty[string, int]())
  assertEq(m.updatedWith("b", v -> Some(9)), Map(("a", 1), ("b", 9)))
  assertEq(m.updatedWith("b", v -> None), m)

@test("map, filter and the other transformations, including a map that merges keys")
mapTransformations()
  val m = Map((1, "a"), (2, "bb"), (3, "ccc"))
  assertEq(m.filter((k, v) -> k > 1), Map((2, "bb"), (3, "ccc")))
  assertEq(m.filterKeys(k -> false), Map.empty[int, string]())
  assertEq(m.mapValues(v -> v.charCount), Map((1, 1), (2, 2), (3, 3)))
  assertEq(m.transform((k, v) -> k + v.charCount), Map((1, 2), (2, 4), (3, 6)))
  val merged = m.map((k, v) -> (k % 2, v))
  assertEq(merged.size, 2)
  assertEq(m.keySet, Set(1, 2, 3))
  assertEq(m.values.sorted, ["a", "bb", "ccc"])

@test("an empty set and a set of one")
smallSets()
  val empty = Set.empty[int]()
  assert(empty.isEmpty && !empty.contains(0))
  assertEq(empty.excl(1), empty)
  assert(empty.subsetOf(Set(1)))
  assert(empty.subsetOf(empty))
  assertEq(empty.union(empty), empty)
  val one = Set(1)
  assertEq(one.incl(1), one)
  assertEq(one.excl(1), empty)
  assert(!one.subsetOf(empty))
  assertEq(Set(1, 1, 1).size, 1)

@test("union, intersect and diff, with each side empty")
setAlgebra()
  val a = Set(1, 2, 3)
  val b = Set(3, 4)
  val none = Set.empty[int]()
  assertEq(a.union(b), Set(1, 2, 3, 4))
  assertEq(a.intersect(b), Set(3))
  assertEq(a.diff(b), Set(1, 2))
  assertEq(a.union(none), a)
  assertEq(none.union(a), a)
  assertEq(a.intersect(none), none)
  assertEq(none.intersect(a), none)
  assertEq(a.diff(none), a)
  assertEq(none.diff(a), none)
  assertEq(a.diff(a), none)

@test("a set of colliding elements adds, finds and removes each")
collidingSet()
  var s = Set.empty[Clash]()
  for i in 0 ..< 10 do s = s.incl(Clash(i))
  assertEq(s.size, 10)
  assertEq(s.incl(Clash(3)).size, 10)
  for i in 0 ..< 10 do assert(s.contains(Clash(i)))
  assert(!s.contains(Clash(10)))
  for i in 0 ..< 10 do s = s.excl(Clash(i))
  assert(s.isEmpty)

@test("sets equal and hash alike whatever order their elements were added in")
setEquality()
  var up = Set.empty[int]()
  for i in 0 ..< 3000 do up = up.incl(i)
  var down = Set.empty[int]()
  var i = 2999
  while i >= 0
    down = down.incl(i)
    i -= 1
  assert(up == down)
  assertEq(up.hash(), down.hash())
  assert(up != down.excl(1500))
