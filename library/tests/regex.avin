@test("scripts, by name or code, after Is or sc= or script=, ignoring case")
scripts()
    conform([
        (raw"\p{IsGreek}+", "abc αβγ def", "4:αβγ"),
        (raw"\p{IsGREEK}", "aβ", "1:β"),
        (raw"\p{IsLatin}+", "αβγabc", "6:abc"),
        (raw"\p{sc=Cyrillic}", "aЖ", "1:Ж"),
        (raw"\p{script=cyrl}", "aЖ", "1:Ж"),
        (raw"\p{SC=Cyrl}", "aЖ", "1:Ж"),
        (raw"\p{IsCommon}+", "a1 ,b", "1:1 ,"),
        (raw"\p{IsInherited}", "e\u{301}", "1:\u{301}"),
        (raw"\p{IsZinh}", "e\u{301}", "1:\u{301}"),
        (raw"\p{IsHan}", "a中", "1:中"),
        (raw"\p{IsOld_Italic}", "a𐌀", "1:𐌀"),
        (raw"\p{sc=ital}", "a𐌀", "1:𐌀"),
        (raw"\p{IsUnknown}", "a\u{378}", "1:\u{378}"),
        (raw"\p{sc=Zzzz}", "\u{e000}", "0:\u{e000}"),
        (raw"\P{IsGreek}+", "αab", "2:ab"),
        (raw"[\p{IsGreek}\p{IsCyrillic}]+", "aβЖ", "1:βЖ"),
        (raw"[\p{L}&&[^\p{IsLatin}]]+", "abβЖc", "2:βЖ"),
        (raw"(?i)\p{IsGreek}", "aΣ", "1:Σ"),
        (raw"\p{IsL}", "1a", "1:a"),
        (raw"\p{IsHrkt}", "", "error: Unknown character property name {IsHrkt} @9"),
        (raw"\p{IsOld Italic}", "", "error: Unknown character property name {IsOld Italic} @15"),
        (raw"\p{sc=Foo}", "", "error: Unknown Unicode property {name=<sc>, value=<Foo>} @9"),
        (raw"\p{Greek}", "", "error: Unknown character property name {Greek} @8"),
    ])

@test("blocks, by name, the name without spaces or an alias, after In or blk= or block=, ignoring case")
blocks()
    conform([
        (raw"\p{InGreek}+", "abc αβγ", "4:αβγ"),
        (raw"\p{blk=Greek and Coptic}+", "abc αβγ", "4:αβγ"),
        (raw"\p{InGreekAndCoptic}+", "abc αβγ", "4:αβγ"),
        (raw"\p{block=GREEK_AND_COPTIC}+", "abc αβγ", "4:αβγ"),
        (raw"\p{InBasicLatin}+", "é ab", "2: ab"),
        (raw"\p{InBASIC_LATIN}", "éa", "2:a"),
        (raw"\p{block=Latin-1 Supplement}", "aé", "1:é"),
        (raw"\p{InLatin-1Supplement}", "aé", "1:é"),
        (raw"\p{InLatin_1_Supplement}", "aé", "1:é"),
        (raw"\p{blk=Latin_1_Sup}", "aé", "1:é"),
        (raw"\p{InGreek and Coptic}", "aβ", "1:β"),
        (raw"\p{InGreek}", "\u{36f}\u{370}", "2:\u{370}"),
        (raw"\p{InGreek}+", "\u{3ff}\u{400}", "0:\u{3ff}"),
        (raw"\P{InGreek}", "\u{3ff}\u{400}", "2:\u{400}"),
        (raw"\p{InSupplementary_Private_Use_Area_B}", "a\u{10ffff}", "1:\u{10ffff}"),
        (raw"\p{InHigh Surrogates}", raw"a", "none"),
        (raw"[\x{d800}&&\p{InHigh Surrogates}]", "", "none"),
        (raw"\p{InFoo}", "", "error: Unknown character property name {InFoo} @8"),
        (raw"\p{blk=No_Block}", "", "error: Unknown Unicode property {name=<blk>, value=<No_Block>} @15"),
    ])

