// `avin.regex`: a conformance table of patterns, each searched for in a text, covering every
// construct of the pattern language, and the API around a match.
import avin.regex
import avin.regex.{Regex, Match, PatternError}

// The first match of `pattern` in `input`, written as its start, `:`, the text matched, and each
// group after a `|`, `!` for a group that took no part; `none` when nothing matches, and for a
// pattern that is not valid, the error's description and index.
firstMatch(pattern: string, input: string) -> string = Regex.compile(pattern) match
    Err(e) -> s"error: ${e.description} @${e.index}"
    Ok(r) -> r.findFirstMatchIn(input) match
        None -> "none"
        Some(m) -> described(m)

described(m: Match) -> string
    var t = s"${m.start()}:${m.matched()}"
    for g in m.subgroups()
        t = t + "|" + g.getOrElse("!")
    t

// Each case's pattern, text and expected first match, checked together so that every mismatch is
// reported at once.
conform(cases: Vector[(string, string, string)])
    val wrong = Buffer[string]()
    for (pattern, input, expected) in cases
        val actual = firstMatch(pattern, input)
        if actual != expected then wrong.addOne(s"$pattern on ${debug(input)}: expected ${debug(expected)}, found ${debug(actual)}")
    assertEq(wrong.toVector(), Vector.empty[string]())

@test("literals and escapes")
literalsAndEscapes()
    conform([
        ("abc", "xabcx", "1:abc"),
        (raw"a\tb", "a\tb", "0:a\tb"),
        (raw"\x41B\x{43}", "ABC", "0:ABC"),
        (raw"\0101\01\0377", "A\u{1}\u{ff}", "0:A\u{1}\u{ff}"),
        (raw"\0400", " 0", "0: 0"),
        (raw"\cA\c?", "\u{1}\u{7f}", "0:\u{1}\u{7f}"),
        (raw"\e\a\f\n\r", "\u{1b}\u{7}\u{c}\n\r", "0:\u{1b}\u{7}\u{c}\n\r"),
        (raw"\.\*\\", "a.*\\", "1:.*\\"),
        (raw"\Qa.b*\E+", "a.b**", "0:a.b**"),
        (raw"\Q(a)\E\1", "(a)", "none"),
        (raw"\Q1\E", "21", "1:1"),
        (raw"\Qa\\b", "a\\\\b", "0:a\\\\b"),
        (raw"x\Qab", "xab", "0:xab"),
        (raw"😀", "a😀", "1:😀"),
        ("😀+", "a😀😀b", "1:😀😀"),
        (raw"\x{1F600}", "😀", "0:😀"),
        ("a.c", "abc", "0:abc"),
        ("a.c", "a\nc", "none"),
        ("a.c", "a\rc", "none"),
        ("a.c", "a\u{85}c a\u{2028}c", "none"),
        ("a.c", "a😀c", "0:a😀c"),
        ("(?s)a.c", "a\nc", "0:a\nc"),
        ("(?d)a.c", "a\rc", "0:a\rc"),
        ("(?d)a.c", "a\nc", "none"),
        ("]}", "]}", "0:]}"),
    ])

@test("character classes")
characterClasses()
    conform([
        ("[abc]+", "xxbcay", "2:bca"),
        ("[^abc]+", "abxyc", "2:xy"),
        ("[a-cx-z]+", "dxaczw", "1:xacz"),
        ("[a[bc]]+", "dcab", "1:cab"),
        ("[a-z&&[^aeiou]]+", "aebcdi", "2:bcd"),
        ("[abc&&b]", "acb", "2:b"),
        ("[a-z&&b-y&&c-x]+", "abcxyz", "2:cx"),
        ("[^a[b]]+", "abcd", "2:cd"),
        ("[]a]+", "x]a]", "1:]a]"),
        ("[^]a]+", "]ab", "2:b"),
        ("[a-]+", "-a-b", "0:-a-"),
        ("[-a]+", "b-a", "1:-a"),
        ("[a&b]+", "x&ab", "1:&ab"),
        (raw"[\d.]+", "x1.5y", "1:1.5"),
        (raw"[\w&&[^\d]]+", "12ab3", "2:ab"),
        (raw"[\Q]\E]", "a]", "1:]"),
        (raw"[\x41-\x43]+", "xABCD", "1:ABC"),
        (raw"[а-я]+", "Ðµ", "none"),
        ("[а-я]+", "Жжуk", "2:жу"),
        ("[😀-😂]", "a😁", "1:😁"),
        (raw"\d+\s\w+", "id 42 abc_9", "3:42 abc_9"),
        (raw"\D+", "12ab3", "2:ab"),
        (raw"\S+", "  ab c", "2:ab"),
        (raw"\W+", "ab, cd", "2:, "),
        (raw"\s+", "a \t\n\u{b}\u{c}\rb", "1: \t\n\u{b}\u{c}\r"),
        (raw"\s", "a\u{a0}b", "none"),
        (raw"\h+", "a \t\u{a0}\u{3000}b", "1: \t\u{a0}\u{3000}"),
        (raw"\v+", "a\n\u{b}\u{2029}b", "1:\n\u{b}\u{2029}"),
        (raw"\H", " \tx", "2:x"),
        (raw"\V", "\nx", "1:x"),
        (raw"\w+", "héllo", "0:h"),
        (raw"\d", "٣", "none"),
        ("[z-a]", "", "error: Illegal character range @3"),
        ("[abc", "", "error: Unclosed character class @3"),
        ("[", "", "error: Unclosed character class @0"),
        ("[]", "", "error: Unclosed character class @1"),
        (raw"[\b]", "", "error: Illegal/unsupported escape sequence @2"),
        (raw"[a-\d]", "", "error: Illegal character range @4"),
    ])

@test("the POSIX classes and the Unicode categories and properties")
properties()
    conform([
        (raw"\p{Lu}+", "abCDÉf", "2:CDÉ"),
        (raw"\p{L}+", "12héllo3", "2:héllo"),
        (raw"\pL+", "12héllo3", "2:héllo"),
        (raw"\PL+", "ab12cd", "2:12"),
        (raw"\P{L}+", "ab12cd", "2:12"),
        (raw"\p{IsL}+", "1Жx2", "1:Жx"),
        (raw"\p{IsLu}", "aЖ", "1:Ж"),
        (raw"\p{IsLetter}+", "1Жx2", "1:Жx"),
        (raw"\p{IsLETTER}+", "1Жx2", "1:Жx"),
        (raw"\p{isletter}+", "1Жx2", "error: Unknown character property name {isletter} @11"),
        (raw"\p{Ll}+", "ABcdÉé", "2:cd"),
        (raw"\p{LC}+", "1aB2", "1:aB"),
        (raw"\p{LD}+", "-a1-", "1:a1"),
        (raw"\p{gc=Lu}", "aB", "1:B"),
        (raw"\p{general_category=Nd}+", "a٣1", "1:٣1"),
        (raw"\p{Nd}+", "a٣12", "1:٣12"),
        (raw"\p{IsDigit}+", "a٣12", "1:٣12"),
        (raw"\p{N}+", "x½2", "1:½2"),
        (raw"\p{Sc}+", "a$€", "1:$€"),
        (raw"\p{S}", "a+", "1:+"),
        (raw"\p{Pd}", "a-", "1:-"),
        (raw"\p{P}+", "a!?b", "1:!?"),
        (raw"\p{IsPunctuation}+", "a!?b", "1:!?"),
        (raw"\p{Zs}", "a\u{3000}", "1:\u{3000}"),
        (raw"\p{Z}", "a\u{2028}", "1:\u{2028}"),
        (raw"\p{Cc}", "a\u{7f}", "1:\u{7f}"),
        (raw"\p{Mn}", "e\u{301}", "1:\u{301}"),
        (raw"\p{M}", "e\u{301}", "1:\u{301}"),
        (raw"\p{Cn}", "a\u{378}", "1:\u{378}"),
        (raw"\p{IsAssigned}+", "ab\u{378}", "0:ab"),
        (raw"\p{C}", "a\u{378}", "1:\u{378}"),
        (raw"\p{Co}", "a\u{e000}", "1:\u{e000}"),
        (raw"[\p{L}&&[^a-z]]+", "abCDé", "2:CDé"),
        (raw"[^\p{L}\p{N}]+", "ab, 12", "2:, "),
        (raw"\p{Alpha}+", "1éab", "3:ab"),
        (raw"\p{Alnum}+", "-é1a_", "3:1a"),
        (raw"\p{Digit}+", "a٣12", "3:12"),
        (raw"\p{Lower}+", "ABcd", "2:cd"),
        (raw"\p{Upper}+", "abCD", "2:CD"),
        (raw"\p{Punct}+", "a!?b", "1:!?"),
        (raw"\p{Graph}+", " ab~ ", "1:ab~"),
        (raw"\p{Print}+", "\u{1}a b\u{1}", "1:a b"),
        (raw"\p{Blank}+", "a \tb", "1: \t"),
        (raw"\p{Cntrl}", "a\u{1f}", "1:\u{1f}"),
        (raw"\p{Space}+", "a \n\u{b}b", "1: \n\u{b}"),
        (raw"\p{XDigit}+", "xx0aFg", "2:0aF"),
        (raw"\p{ASCII}+", "abé", "0:ab"),
        (raw"\p{L1}+", "aé€", "0:aé"),
        (raw"\p{all}+", "a\n", "0:a\n"),
        (raw"\p{IsWhite_Space}+", "a \u{2003}\u{85}b", "1: \u{2003}\u{85}"),
        (raw"\p{IsWhiteSpace}", "a\u{a0}", "1:\u{a0}"),
        (raw"\p{IsHex_Digit}+", "g9fＦ", "1:9fＦ"),
