// `avin.regex`: a conformance table of patterns, each searched for in a text, covering every
// construct of the pattern language, and the API around a match.
import avin.regex
import avin.regex.{Regex, Match, PatternError}

// The first match of `pattern` in `input`, written as its start, `:`, the text matched, and each
// group after a `|`, `!` for a group that took no part; `none` when nothing matches, and for a
// pattern that is not valid, the error's description and index.
firstMatch(pattern: string, input: string) -> string = Regex.compile(pattern) match
    Err(e) -> s"error: ${e.description} @${e.index}"
    Ok(r) -> r.findFirstMatchIn(input) match
        None -> "none"
        Some(m) -> described(m)

described(m: Match) -> string
    var t = s"${m.start()}:${m.matched()}"
    for g in m.subgroups()
        t = t + "|" + g.getOrElse("!")
    t

// Each case's pattern, text and expected first match, checked together so that every mismatch is
// reported at once.
conform(cases: Vector[(string, string, string)])
    val wrong = Buffer[string]()
    for (pattern, input, expected) in cases
        val actual = firstMatch(pattern, input)
        if actual != expected then wrong.add(s"$pattern on ${debug(input)}: expected ${debug(expected)}, found ${debug(actual)}")
    assertEq(wrong.toVector(), Vector.empty[string]())

@test("literals and escapes")
literalsAndEscapes()
    conform([
        ("abc", "xabcx", "1:abc"),
        (raw"a\tb", "a\tb", "0:a\tb"),
        (raw"\x41B\x{43}", "ABC", "0:ABC"),
        (raw"\0101\01\0377", "A\u{1}\u{ff}", "0:A\u{1}\u{ff}"),
        (raw"\0400", " 0", "0: 0"),
        (raw"\cA\c?", "\u{1}\u{7f}", "0:\u{1}\u{7f}"),
        (raw"\e\a\f\n\r", "\u{1b}\u{7}\u{c}\n\r", "0:\u{1b}\u{7}\u{c}\n\r"),
        (raw"\.\*\\", "a.*\\", "1:.*\\"),
        (raw"\Qa.b*\E+", "a.b**", "0:a.b**"),
        (raw"\Q(a)\E\1", "(a)", "none"),
        (raw"\Q1\E", "21", "1:1"),
        (raw"\Qa\\b", "a\\\\b", "0:a\\\\b"),
        (raw"x\Qab", "xab", "0:xab"),
        (raw"😀", "a😀", "1:😀"),
        ("😀+", "a😀😀b", "1:😀😀"),
        (raw"\x{1F600}", "😀", "0:😀"),
        ("a.c", "abc", "0:abc"),
        ("a.c", "a\nc", "none"),
        ("a.c", "a\rc", "none"),
        ("a.c", "a\u{85}c a\u{2028}c", "none"),
        ("a.c", "a😀c", "0:a😀c"),
        ("(?s)a.c", "a\nc", "0:a\nc"),
        ("(?d)a.c", "a\rc", "0:a\rc"),
        ("(?d)a.c", "a\nc", "none"),
        ("]}", "]}", "0:]}"),
    ])

@test("character classes")
characterClasses()
    conform([
        ("[abc]+", "xxbcay", "2:bca"),
        ("[^abc]+", "abxyc", "2:xy"),
        ("[a-cx-z]+", "dxaczw", "1:xacz"),
        ("[a[bc]]+", "dcab", "1:cab"),
        ("[a-z&&[^aeiou]]+", "aebcdi", "2:bcd"),
        ("[abc&&b]", "acb", "2:b"),
        ("[a-z&&b-y&&c-x]+", "abcxyz", "2:cx"),
        ("[^a[b]]+", "abcd", "2:cd"),
        ("[]a]+", "x]a]", "1:]a]"),
        ("[^]a]+", "]ab", "2:b"),
        ("[a-]+", "-a-b", "0:-a-"),
        ("[-a]+", "b-a", "1:-a"),
        ("[a&b]+", "x&ab", "1:&ab"),
        (raw"[\d.]+", "x1.5y", "1:1.5"),
        (raw"[\w&&[^\d]]+", "12ab3", "2:ab"),
        (raw"[\Q]\E]", "a]", "1:]"),
        (raw"[\x41-\x43]+", "xABCD", "1:ABC"),
        (raw"[а-я]+", "Ðµ", "none"),
        ("[а-я]+", "Жжуk", "2:жу"),
        ("[😀-😂]", "a😁", "1:😁"),
        (raw"\d+\s\w+", "id 42 abc_9", "3:42 abc_9"),
        (raw"\D+", "12ab3", "2:ab"),
        (raw"\S+", "  ab c", "2:ab"),
        (raw"\W+", "ab, cd", "2:, "),
        (raw"\s+", "a \t\n\u{b}\u{c}\rb", "1: \t\n\u{b}\u{c}\r"),
        (raw"\s", "a\u{a0}b", "none"),
        (raw"\h+", "a \t\u{a0}\u{3000}b", "1: \t\u{a0}\u{3000}"),
        (raw"\v+", "a\n\u{b}\u{2029}b", "1:\n\u{b}\u{2029}"),
        (raw"\H", " \tx", "2:x"),
        (raw"\V", "\nx", "1:x"),
        (raw"\w+", "héllo", "0:h"),
        (raw"\d", "٣", "none"),
        ("[z-a]", "", "error: Illegal character range @3"),
        ("[abc", "", "error: Unclosed character class @3"),
        ("[", "", "error: Unclosed character class @0"),
        ("[]", "", "error: Unclosed character class @1"),
        (raw"[\b]", "", "error: Illegal/unsupported escape sequence @2"),
        (raw"[a-\d]", "", "error: Illegal character range @4"),
    ])

@test("the POSIX classes and the Unicode categories and properties")
properties()
    conform([
        (raw"\p{Lu}+", "abCDÉf", "2:CDÉ"),
        (raw"\p{L}+", "12héllo3", "2:héllo"),
        (raw"\pL+", "12héllo3", "2:héllo"),
        (raw"\PL+", "ab12cd", "2:12"),
        (raw"\P{L}+", "ab12cd", "2:12"),
        (raw"\p{IsL}+", "1Жx2", "1:Жx"),
        (raw"\p{IsLu}", "aЖ", "1:Ж"),
        (raw"\p{IsLetter}+", "1Жx2", "1:Жx"),
        (raw"\p{IsLETTER}+", "1Жx2", "1:Жx"),
        (raw"\p{isletter}+", "1Жx2", "error: Unknown character property name {isletter} @11"),
        (raw"\p{Ll}+", "ABcdÉé", "2:cd"),
        (raw"\p{LC}+", "1aB2", "1:aB"),
        (raw"\p{LD}+", "-a1-", "1:a1"),
        (raw"\p{gc=Lu}", "aB", "1:B"),
        (raw"\p{general_category=Nd}+", "a٣1", "1:٣1"),
        (raw"\p{Nd}+", "a٣12", "1:٣12"),
        (raw"\p{IsDigit}+", "a٣12", "1:٣12"),
        (raw"\p{N}+", "x½2", "1:½2"),
        (raw"\p{Sc}+", "a$€", "1:$€"),
        (raw"\p{S}", "a+", "1:+"),
        (raw"\p{Pd}", "a-", "1:-"),
        (raw"\p{P}+", "a!?b", "1:!?"),
        (raw"\p{IsPunctuation}+", "a!?b", "1:!?"),
        (raw"\p{Zs}", "a\u{3000}", "1:\u{3000}"),
        (raw"\p{Z}", "a\u{2028}", "1:\u{2028}"),
        (raw"\p{Cc}", "a\u{7f}", "1:\u{7f}"),
        (raw"\p{Mn}", "e\u{301}", "1:\u{301}"),
        (raw"\p{M}", "e\u{301}", "1:\u{301}"),
        (raw"\p{Cn}", "a\u{378}", "1:\u{378}"),
        (raw"\p{IsAssigned}+", "ab\u{378}", "0:ab"),
        (raw"\p{C}", "a\u{378}", "1:\u{378}"),
        (raw"\p{Co}", "a\u{e000}", "1:\u{e000}"),
        (raw"[\p{L}&&[^a-z]]+", "abCDé", "2:CDé"),
        (raw"[^\p{L}\p{N}]+", "ab, 12", "2:, "),
        (raw"\p{Alpha}+", "1éab", "3:ab"),
        (raw"\p{Alnum}+", "-é1a_", "3:1a"),
        (raw"\p{Digit}+", "a٣12", "3:12"),
        (raw"\p{Lower}+", "ABcd", "2:cd"),
        (raw"\p{Upper}+", "abCD", "2:CD"),
        (raw"\p{Punct}+", "a!?b", "1:!?"),
        (raw"\p{Graph}+", " ab~ ", "1:ab~"),
        (raw"\p{Print}+", "\u{1}a b\u{1}", "1:a b"),
        (raw"\p{Blank}+", "a \tb", "1: \t"),
        (raw"\p{Cntrl}", "a\u{1f}", "1:\u{1f}"),
        (raw"\p{Space}+", "a \n\u{b}b", "1: \n\u{b}"),
        (raw"\p{XDigit}+", "xx0aFg", "2:0aF"),
        (raw"\p{ASCII}+", "abé", "0:ab"),
        (raw"\p{L1}+", "aé€", "0:aé"),
        (raw"\p{all}+", "a\n", "0:a\n"),
        (raw"\p{IsWhite_Space}+", "a \u{2003}\u{85}b", "1: \u{2003}\u{85}"),
        (raw"\p{IsWhiteSpace}", "a\u{a0}", "1:\u{a0}"),
        (raw"\p{IsHex_Digit}+", "g9fＦ", "1:9fＦ"),
        (raw"\p{IsJoin_Control}", "a\u{200d}", "1:\u{200d}"),
        (raw"\p{IsNoncharacterCodePoint}", "a\u{fdd0}", "1:\u{fdd0}"),
        (raw"\p{IsControl}", "a\u{85}", "1:\u{85}"),
        (raw"\p{IsTitlecase}", "aǅ", "1:ǅ"),
        (raw"\p{IsBlank}+", "a\t\u{3000}", "1:\t\u{3000}"),
        (raw"\p{Foo}", "", "error: Unknown character property name {Foo} @6"),
        (raw"\p{IsFoo}", "", "error: Unsupported character property {IsFoo}: it needs Unicode data the runtime does not have @8"),
        (raw"\p{}", "", "error: Empty character family @3"),
        (raw"\p{L", "", "error: Unclosed character family @4"),
        (raw"\p{foo=bar}", "", "error: Unknown Unicode property {name=<foo>, value=<bar>} @10"),
        (raw"\p{gc=Xx}", "", "error: Unknown Unicode property {name=<gc>, value=<Xx>} @8"),
    ])

@test("properties that need Unicode data the runtime does not hold are reported, not guessed")
unsupportedProperties()
    for name in ["IsAlphabetic", "IsIdeographic", "IsUppercase", "IsLowercase", "InGreek", "IsGreek", "script=Latn", "blk=Greek"]
        val outcome = Regex.compile(raw"\p{" + name + "}")
        assert(outcome is Err(e) && e.description.startsWith("Unsupported"))

@test("greedy, reluctant and possessive quantifiers")
quantifiers()
    conform([
        ("a*", "baaa", "0:"),
        ("a+", "baaa", "1:aaa"),
        ("a?b", "ab", "0:ab"),
        ("a{2}", "aaaa", "0:aa"),
        ("a{2,}", "aaaa", "0:aaaa"),
        ("a{2,3}", "aaaa", "0:aaa"),
        ("a{0}b", "ab", "1:b"),
        ("a+?", "aaa", "0:a"),
        ("a*?b", "aaab", "0:aaab"),
        ("a{2,3}?", "aaaa", "0:aa"),
        ("a??b", "ab", "0:ab"),
        ("a*+a", "aaa", "none"),
        ("a++b", "aaab", "0:aaab"),
        ("a?+a", "a", "none"),
        ("a{1,2}+a", "aaa", "0:aaa"),
        ("x{2}{3}", "xxxxxx", "0:xx"),
        ("{2}", "a", "0:"),
        (".*foo", "xfooyfoo", "0:xfooyfoo"),
        (".*?foo", "xfooyfoo", "0:xfoo"),
        ("(a+)(a+)", "aaaa", "0:aaaa|aaa|a"),
        ("(a+?)(a+)", "aaaa", "0:aaaa|a|aaa"),
        ("(a*)*", "b", "0:|"),
        ("(a*)+", "b", "0:|"),
        ("(a|b)*", "abba", "0:abba|a"),
        ("(a|b)*?c", "abc", "0:abc|b"),
        ("(a|b){2}", "abb", "0:ab|b"),
        ("(a|b){2,}?", "abab", "0:ab|b"),
        ("(ab)*", "ababx", "0:abab|ab"),
        ("(ab)*?x", "ababx", "0:ababx|ab"),
        ("(ab){2}", "ababab", "0:abab|ab"),
        ("(ab)?c", "abc", "0:abc|ab"),
        ("(ab)??c", "abc", "0:abc|ab"),
        ("(ab)?c", "c", "0:c|!"),
        ("(ab)*+ab", "ababab", "none"),
        ("(ab)?+a", "aba", "0:aba|ab"),
        ("(a|ab)*c", "abac", "0:abac|a"),
        ("(|a)+", "a", "0:|"),
        ("(a?)+?b", "aab", "0:aab|a"),
        ("(?:a|b)*?c", "abc", "0:abc"),
        ("a**", "", "error: Dangling meta character '*' @2"),
        ("*a", "", "error: Dangling meta character '*' @0"),
        ("+", "", "error: Dangling meta character '+' @0"),
        ("a{", "", "error: Illegal repetition @0"),
        ("x{a}", "", "error: Illegal repetition @0"),
        ("a{3,2}", "", "error: Illegal repetition range @5"),
        ("a{2", "", "error: Unclosed counted closure @3"),
        ("a{2,x}", "", "error: Unclosed counted closure @4"),
        ("a{,2}", "", "error: Illegal repetition @0"),
    ])

@test("which group captures what after backtracking and in repeated groups")
captures()
    conform([
        ("(a|ab)(c|bcd)(d*)", "abcd", "0:abcd|a|bcd|"),
        ("(a|(b))+", "ba", "0:ba|a|b"),
        ("(?:(a)|b)+", "ab", "0:ab|a"),
        ("(a)|b", "b", "0:b|!"),
        ("((a)|b)+", "ab", "0:ab|b|a"),
        ("(a)?(a)", "a", "0:a|!|a"),
        ("((a)b){0,2}abc", "ababc", "0:ababc|ab|a"),
        ("(x)?(?(1)y)", "", "error: Unknown inline modifier @6"),
        ("(\\w)(\\d)?", "a", "0:a|a|!"),
        ("(a*)b\\1", "aabaa", "0:aabaa|aa"),
        ("(a*)b\\1", "aaba", "1:aba|a"),
        ("(a*)b\\1$", "aabaa", "0:aabaa|aa"),
        ("(?<n>a+)\\k<n>", "aaaa", "0:aaaa|aa"),
        ("(a)\\2", "aa", "none"),
        ("(a)\\11", "aa1", "0:aa1|a"),
        ("(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)\\10", "abcdefghijj", "0:abcdefghijj|a|b|c|d|e|f|g|h|i|j"),
        ("\\1(a)", "aa", "none"),
        ("(a\\1?)+", "aaa", "0:aaa|aa"),
        ("(?i)(a)\\1", "aA", "0:aA|a"),
        ("(a)\\1", "aA", "none"),
        ("(?iu)(é)\\1", "éÉ", "0:éÉ|é"),
        ("(?i)(é)\\1", "éÉ", "none"),
        ("\\k<x>", "", "error: named capturing group <x> does not exist @4"),
        ("\\kx", "", "error: \\k is not followed by '<' for named capturing group @2"),
        ("(?<n>a)(?<n>b)", "", "error: Named capturing group <n> is already defined @11"),
        ("(?<1a>x)", "", "error: capturing group name does not start with a Latin letter @3"),
        ("(?<ab-c>x)", "", "error: named capturing group is missing trailing '>' @5"),
        ("(?<a1>x)(?<b>y)", "xy", "0:xy|x|y"),
    ])

@test("lookahead and lookbehind")
lookarounds()
    conform([
        ("a(?=b)", "acab", "2:a"),
        ("a(?!b)", "abac", "2:a"),
        ("(?<=a)b", "cbab", "3:b"),
        ("(?<!a)b", "abcb", "3:b"),
        ("(?<=ab|c)d", "abdcd", "2:d"),
        ("(?<=a{1,3})b", "aab", "2:b"),
        ("(?<=a?b)c", "bc", "1:c"),
        ("(?<=\\b)x", "a x", "2:x"),
        ("(?<=(a|bc))d", "bcd", "2:d|bc"),
        ("(?<=(a))b", "ab", "1:b|a"),
        ("(?<=(a+?){2})b", "", "error: Look-behind group does not have an obvious maximum length @11"),
        ("(?<=a+)b", "", "error: Look-behind group does not have an obvious maximum length @5"),
        ("(?<=a*)b", "", "error: Look-behind group does not have an obvious maximum length @5"),
        ("(?<=a{2,})b", "", "error: Look-behind group does not have an obvious maximum length @8"),
        ("(?<=\\1)b", "", "error: Look-behind group does not have an obvious maximum length @5"),
        ("(?=(a))a", "a", "0:a|a"),
        ("(?:(?=(a))b|a)", "a", "0:a|a"),
        ("(?!(a))b", "b", "0:b|!"),
        ("(?=a)*b", "b", "0:b"),
        ("(?=.*z)\\w+", "abz", "0:abz"),
        ("^(?=.*\\d)(?=.*[a-z]).{4,}$", "ab1c", "0:ab1c"),
        ("^(?=.*\\d)(?=.*[a-z]).{4,}$", "abcd", "none"),
        ("(?<=^|,)\\w+", "ab,cd", "0:ab"),
        ("\\w+(?<!b)\\b", "ab ac", "3:ac"),
        ("(?<!^)x", "xx", "1:x"),
        ("(?<=😀)a", "😀a", "4:a"),
    ])

@test("atomic groups and possessive repetition never give back")
atomicGroups()
    conform([
        ("(?>a|ab)c", "abc", "none"),
        ("(?>ab|a)c", "abc", "0:abc"),
        ("(?>a+)a", "aaa", "none"),
        ("(?>a+)b", "aab", "0:aab"),
        ("(?>(a)|b)+c", "abc", "0:abc|a"),
        ("(?>x*)*y", "xxy", "0:xxy"),
        ("(?>a)?a", "a", "0:a"),
        ("(?>a?)?a", "a", "0:a"),
        ("(?>a?)a", "a", "none"),
    ])

@test("anchors, boundaries and multiline mode")
anchors()
    conform([
        ("^abc$", "abc", "0:abc"),
        ("^b", "a\nb", "none"),
        ("(?m)^b", "a\nb", "2:b"),
        ("(?m)^b", "a\r\nb", "3:b"),
        ("(?m)^b", "a\u{2028}b", "4:b"),
        ("(?m)^$", "a\n", "none"),
        ("(?m)^$", "a\n\nb", "2:"),
        ("(?m)^\\n", "a\r\nb", "none"),
        ("a$", "a\n", "0:a"),
        ("a$", "a\r\n", "0:a"),
        ("a$", "a\n\n", "none"),
        ("a$", "a\nb", "none"),
        ("(?m)a$", "a\nb", "0:a"),
        ("(?m)a$", "a\rb", "0:a"),
        ("(?m)a$", "a\u{85}b", "0:a"),
        ("$", "a\r\n", "1:"),
        ("(?m)\\r$", "a\r\n", "none"),
        ("a\\Z", "a\n", "0:a"),
        ("a\\Z", "a\nb", "none"),
        ("a\\z", "a\n", "none"),
        ("a\\z", "ba", "1:a"),
        ("\\Aa", "ba", "none"),
        ("(?m)\\Ab", "a\nb", "none"),
        ("(?d)a$", "a\r\n", "none"),
        ("(?d)a$", "a\n", "0:a"),
        ("(?md)^b", "a\rb", "none"),
        ("(?md)^b", "a\nb", "2:b"),
        ("(?md)a$", "a\rb", "none"),
        ("\\bfoo\\b", "a foo b", "2:foo"),
        ("\\bfoo\\b", "afoo foob foo", "10:foo"),
        ("\\Bo\\B", "foo", "1:o"),
        ("\\b", "", "none"),
        ("\\B", "", "0:"),
        ("\\b\\w", "_a", "0:_"),
        ("\\b.", "é", "none"),
        ("\\R", "a\r\nb", "1:\r\n"),
        ("\\R\\n", "a\r\nb", "1:\r\n"),
        ("\\R+", "\n\u{b}\u{c}\u{85}\u{2028}\u{2029}", "0:\n\u{b}\u{c}\u{85}\u{2028}\u{2029}"),
        ("a\\Rb", "a\rb", "0:a\rb"),
    ])

@test("inline and scoped flags, and comments mode")
flags()
    conform([
        ("(?i)abc", "xABC", "1:ABC"),
        ("a(?i)b", "aB", "0:aB"),
        ("a(?i)b", "AB", "none"),
        ("(?i:a)b", "Ab", "0:Ab"),
        ("(?i:a)b", "AB", "none"),
        ("a(?i)b|c", "C", "0:C"),
        ("(a(?i)b)c", "aBc", "0:aBc|aB"),
        ("(a(?i)b)c", "aBC", "none"),
        ("(?i)a(?-i)b", "Ab", "0:Ab"),
        ("(?i)a(?-i)b", "AB", "none"),
        ("(?i-i)a", "A", "none"),
        ("(?i)é", "É", "none"),
        ("(?iu)é", "É", "0:É"),
        ("(?iu)ǆ", "ǅ", "0:ǅ"),
        ("(?i)[a-c]+", "ABCd", "0:ABC"),
        ("(?i)[^a]", "Ab", "1:b"),
        ("(?i)[é]", "É", "none"),
        ("(?iu)[é]", "É", "0:É"),
        ("(?iu)[à-ê]+", "ÀÊ", "0:ÀÊ"),
        ("(?iu)k", "\u{212a}", "0:\u{212a}"),
        ("(?i)k", "\u{212a}", "none"),
        ("(?iu)[k]", "\u{212a}", "0:\u{212a}"),
        ("(?i)ab|cd", "CD", "0:CD"),
        ("(?x) a b # comment\n c", "abc", "0:abc"),
        ("(?x)a\\ b", "a b", "0:a b"),
        ("(?x)[a b]+", "ba ", "0:ba"),
        ("(?x)a #b\n", "ab", "0:a"),
        ("(?x)a{2} ", "aa", "0:aa"),
        ("(?x)\\Q a \\E", " a ", "0: a "),
        ("(?s:.)", "\n", "0:\n"),
        ("(?m)a$\\n^b", "a\nb", "0:a\nb"),
        ("(?q)", "", "error: Unknown inline modifier @2"),
        ("(?i", "", "error: Unknown inline modifier @3"),
        ("(?U)a", "", "error: Unsupported inline modifier 'U' @2"),
    ])

@test("alternation is leftmost-first")
alternation()
    conform([
        ("a|ab", "ab", "0:a"),
        ("ab|a", "ab", "0:ab"),
        ("|a", "a", "0:"),
        ("a|", "b", "0:"),
        ("x(a|ab)y", "xaby", "0:xaby|ab"),
        ("(a|ab)(c|bcd)", "abcd", "0:abcd|a|bcd"),
        ("(?:c|b)a|cab", "cab", "0:ca"),
        ("cat|dog|bird", "a bird", "2:bird"),
    ])

@test("errors in group syntax")
groupErrors()
    conform([
        ("(ab", "", "error: Unclosed group @3"),
        ("ab)", "", "error: Unmatched closing ')' @1"),
        (")", "", "error: Unmatched closing ')' @-1"),
        ("(?$a)", "", "error: Unknown group type @2"),
        (raw"\y", "", "error: Illegal/unsupported escape sequence @1"),
        (raw"\E", "", "error: Illegal/unsupported escape sequence @1"),
        (raw"\x{110000}", "", "error: Hexadecimal codepoint is too big @8"),
        (raw"\xg", "", "error: Illegal hexadecimal escape sequence @2"),
        (raw"\x{12", "", "error: Unclosed hexadecimal escape sequence @5"),
        (raw"\u00", "", "error: Illegal Unicode escape sequence @4"),
        (raw"\c", "", "error: Illegal control escape sequence @1"),
        (raw"\08", "", "error: Illegal octal escape sequence @2"),
        (raw"\X", "", "error: Unsupported escape \\X: grapheme clusters are not matched @1"),
    ])

@test("an error's message names the place, and a caret marks it inside the pattern")
errorMessages()
    assertEq(Regex.compile("ab)").map(r -> r.regex()), Err(PatternError("Unmatched closing ')'", "ab)", 1)))
    val e = PatternError("Unmatched closing ')'", "ab)", 1)
    assertEq(e.message(), "Unmatched closing ')' near index 1\nab)\n ^")
    assertEq(PatternError("Unclosed group", "(ab", 3).message(), "Unclosed group near index 3\n(ab")
    assertEq(PatternError("Unmatched closing ')'", ")", -1).message(), "Unmatched closing ')'\n)")
    assertEq(e.toString(), e.message())

@test("matches, findPrefixOf and the anchoring of a regex")
wholeAndPrefix()
    val r = Regex("a+b")
    assert(r.matches("aab"))
    assert(!r.matches("aabx"))
    assert(!r.matches("xaab"))
    assert(r.unanchored().matches("xaabx"))
    assert(!r.unanchored().anchored().matches("xaabx"))
    assert(Regex("a*?").matches("aaa"))
    assert(Regex("(?m)a$").matches("a"))
    assert(Regex("").matches(""))
    assert(!Regex("a|ab").findPrefixOf("abc").contains("ab"))
    assertEq(Regex("a|ab").findPrefixOf("abc"), Some("a"))
    assert(Regex("a|ab").matches("ab"))
    assertEq(Regex("b").findPrefixOf("abc"), None)
    assertEq(Regex("\\w+").findPrefixMatchOf("ab cd").map(m -> m.end()), Some(2))
    assertEq(Regex("x").findFirstIn("abc"), None)
    assertEq(Regex("b+").findFirstIn("abbc"), Some("bb"))

@test("findAllIn walks every match, an empty match moving the search on one character")
allMatches()
    assertEq(Regex("\\d+").findAllIn("a1b22c333").toList(), List("1", "22", "333"))
    assertEq(Regex("a*").findAllIn("baac").toList(), List("", "aa", "", ""))
    assertEq(Regex("").findAllIn("ab").toList(), List("", "", ""))
    assertEq(Regex("").findAllIn("é😀").toList(), List("", "", ""))
    assertEq(Regex("(?m)^").findAllMatchIn("a\nb\n").map(m -> m.start()).toList(), List(0, 2))
    assertEq(Regex("\\Ga").findAllIn("aaba").toList(), List("a", "a"))
    assertEq(Regex("x").findAllIn("abc").toList(), List.empty[string]())
    assertEq(Regex("(\\w)(\\d)").findAllMatchIn("a1 b2 c").map(m -> m.group(1).get()).toList(), List("a", "b"))
    val it = Regex("(o)").findAllIn("foo")
    assert(it.hasNext())
    assertEq(it.start(), 1)
    assertEq(it.next(), "o")
    assertEq(it.start(), 1)
    assertEq(it.end(), 2)
    assertEq(it.group(1), Some("o"))
    assertEq(it.groupCount(), 1)
    assertEq(it.next(), "o")
    assertEq(it.start(), 2)
    assert(!it.hasNext())

@test("a match's groups, offsets and surroundings")
matchData()
    val m = Regex("(\\d+)-(x)?(\\d+)").findFirstMatchIn("tel 12-345 ok").get()
    assertEq(m.matched(), "12-345")
    assertEq(m.start(), 4)
    assertEq(m.end(), 10)
    assertEq(m.groupCount(), 3)
    assertEq(m.group(0), Some("12-345"))
    assertEq(m.group(1), Some("12"))
    assertEq(m.group(2), None)
    assertEq(m.start(2), -1)
    assertEq(m.end(2), -1)
    assertEq(m.start(3), 7)
    assertEq(m.end(3), 10)
    assertEq(m.before(), "tel ")
    assertEq(m.after(), " ok")
    assertEq(m.before(3), Some("tel 12-"))
    assertEq(m.after(1), Some("-345 ok"))
    assertEq(m.before(2), None)
    assertEq(m.subgroups(), List(Some("12"), None, Some("345")))
    assertEq(m.source, "tel 12-345 ok")
    assertEq(m.toString(), "12-345")
    val w = Regex("((a)b){0,2}abc").findFirstMatchIn("ababc").get()
    assertEq(w.start(2), 2)

@test("group names come from the pattern, or from the names given to the regex")
groupNames()
    val m = Regex("(?<year>\\d{4})-(?<month>\\d\\d)").findFirstMatchIn("on 2024-06").get()
    assertEq(m.group("year"), Some("2024"))
    assertEq(m.group("month"), Some("06"))
    assertEq(m.groupNames(), Vector.empty[string]())
    val n = Regex("(\\d+)/(\\d+)", "num", "den").findFirstMatchIn("3/4").get()
    assertEq(n.group("num"), Some("3"))
    assertEq(n.group("den"), Some("4"))
    assertEq(n.group(""), Some("3/4"))
    assertEq(n.groupNames(), ["num", "den"])
    assertEq("(a)".r("first").findFirstMatchIn("a").get().group("first"), Some("a"))

@test("offsets count bytes, and matching counts characters")
offsets()
    val m = Regex("(.)b").findFirstMatchIn("é😀b").get()
    assertEq(m.start(), 2)
    assertEq(m.end(), 7)
    assertEq(m.group(1), Some("😀"))
    assertEq(m.before(), "é")
    assertEq(Regex("^.{2}$").matches("é😀"), true)

@test("a regex shows as its pattern")
shown()
    val r = "a+b".r()
    assertEq(r.toString(), "a+b")
    assertEq(r.regex(), "a+b")
    assertEq(r.pattern().pattern(), "a+b")
    assertEq(Regex("(a)(?:b)(?<c>d)").pattern().groupCount(), 2)

@test("long inputs are searched without a step limit, in reasonable time")
longInputs()
    val words = Buffer[string]()
    for i in 0..<20000 do words.add(s"word$i")
    val text = words.mkString(" ")
    assertEq(Regex("\\w+").findAllIn(text).toList().length(), 20000)
    assertEq(Regex("word19999").findFirstMatchIn(text).map(m -> m.start()), Some(text.byteLength() - 9))
    assertEq(Regex("word(\\d+)").findAllMatchIn(text).map(m -> m.group(1).get().toInt().get()).toList().length(), 20000)
    assertEq(Regex("(a|b)*c").findFirstMatchIn("ab".repeat(100) + "c").map(m -> m.group(1)), Some(Some("b")))
    assert(Regex(".*19999$").matches(text))
    assertEq(Regex("[a-z]+(\\d+)$").findFirstMatchIn(text).flatMap(m -> m.group(1)), Some("19999"))
    val many = "a".repeat(5000)
    assert(Regex("a*a*a*b?").matches(many))
    assert(!Regex("(?:a|aa)*b").matches("a".repeat(25)))
    assertEq(Regex("(?:a|aa)*b").findFirstIn("a".repeat(300)), None)
    assertEq(Regex("(x+x+)+y").findFirstIn("x".repeat(200)), None)
    assertEq(Regex("^(\\w+\\s?)*$").findFirstIn("an example sentence that does not end well!"), None)
