        (raw"\p{IsLowercase}+", "Aaª", "1:aª"),
        (raw"\p{IsTitlecase}+", "aǅB", "1:ǅ"),
        (raw"(?i)\p{IsLowercase}+", "1aBǅ", "1:aBǅ"),
        (raw"(?i)\p{IsUppercase}+", "1aBǅ", "1:aBǅ"),
        (raw"(?i)\p{IsTitlecase}+", "1aBǅ", "1:aBǅ"),
        (raw"(?i)\P{IsLowercase}+", "aB12", "2:12"),
        (raw"\p{IsWord}+", "-é_1\u{301}\u{200d}-", "1:é_1\u{301}\u{200d}"),
        (raw"\p{IsAlnum}+", "_a٣_", "1:a٣"),
        (raw"\p{IsAlpha}+", "1éa", "1:éa"),
        (raw"\p{IsLower}+", "Aéa", "1:éa"),
        (raw"\p{IsUpper}+", "aÉA", "1:ÉA"),
        (raw"\p{IsSpace}+", "a\u{2003}\u{85}", "1:\u{2003}\u{85}"),
        (raw"\p{IsPunct}+", "a¡!", "1:¡!"),
        (raw"\p{IsXDigit}+", "gＦ9", "1:Ｆ9"),
        (raw"\p{IsCntrl}", "a\u{85}", "1:\u{85}"),
        (raw"\p{IsEmoji}", "a😀", "1:😀"),
        (raw"\p{IsEmoji}", "a1", "1:1"),
        (raw"\p{IsEMOJI}", "a😀", "1:😀"),
        (raw"\p{IsEmoji_Presentation}", "#😀", "1:😀"),
        (raw"\p{IsEmoji_Modifier}", "a\u{1f3fb}", "1:\u{1f3fb}"),
        (raw"\p{IsEmoji_Modifier_Base}", "a👍", "1:👍"),
        (raw"\p{IsEmoji_Component}", "a#", "1:#"),
        (raw"\p{IsExtended_Pictographic}", "a©", "1:©"),
        (raw"\p{IsEmojiPresentation}", "", "error: Unknown character property name {IsEmojiPresentation} @22"),
    ])

@test("the U flag makes the predefined and POSIX classes and word boundaries Unicode's, and case Unicode's")
unicodeCharacterClass()
    conform([
        (raw"(?U)\w+", "-héllo_1-", "1:héllo_1"),
        (raw"\w+", "-héllo_1-", "1:h"),
        (raw"(?U)\W+", "é--a", "2:--"),
        (raw"(?U)\d+", "a٣1", "1:٣1"),
        (raw"\d+", "a٣1", "3:1"),
        (raw"(?U)\D+", "٣a1", "2:a"),
        (raw"(?U)\s+", "a\u{2003}\u{85}b", "1:\u{2003}\u{85}"),
        (raw"\s+", "a\u{2003} b", "4: "),
        (raw"(?U)\S+", " \u{2003}é ", "4:é"),
        (raw"(?U)[\w&&[^\d]]+", "1é2", "1:é"),
        (raw"(?U)\bé\b", "aé é", "4:é"),
        (raw"\bé", " é", "none"),
        (raw"(?U)\Bé", "aé", "1:é"),
        (raw"(?U)\p{Alpha}+", "1éa", "1:éa"),
        (raw"\p{Alpha}+", "1éa", "3:a"),
        (raw"(?U)\p{alpha}+", "1éa", "1:éa"),
        (raw"\p{alpha}", "", "error: Unknown character property name {alpha} @8"),
        (raw"(?U)\p{Lower}+", "ABªa", "2:ªa"),
        (raw"(?U)(?i)\p{Lower}+", "1aB", "1:aB"),
        (raw"(?U)\p{Digit}+", "a٣", "1:٣"),
        (raw"(?U)\p{Punct}", "a¡", "1:¡"),
        (raw"(?U)\p{ASCII}+", "éab", "2:ab"),
        (raw"(?U)\p{Lu}", "aÉ", "1:É"),
        (raw"(?U)(?-U)\w+", "éa", "2:a"),
        (raw"(?U:\w)\w", "aé", "none"),
        (raw"(?U:\w)\w", "éa", "0:éa"),
        (raw"(?U)(?i)é", "É", "0:É"),
        (raw"(?i)é", "É", "none"),
        (raw"(?U)(?i)[à-æ]", "Ä", "0:Ä"),
    ])

@test("\\X matches one extended grapheme cluster, the one way it can")
graphemeClusters()
    conform([
        (raw"\X", "e\u{301}x", "0:e\u{301}"),
        (raw"\X\X", "\r\nab", "0:\r\na"),
        (raw"\X", "\u{1100}\u{1161}\u{11a8}a", "0:\u{1100}\u{1161}\u{11a8}"),
        (raw"\X", "👨\u{200d}👩\u{200d}👧a", "0:👨\u{200d}👩\u{200d}👧"),
        (raw"\X", "\u{915}\u{94d}\u{937}\u{93f}a", "0:\u{915}\u{94d}\u{937}\u{93f}"),
        (raw"\X", "\u{600}1a", "0:\u{600}1"),
        (raw"\X", "\u{915}\u{93e}a", "0:\u{915}\u{93e}"),
        (raw"\X", "a\u{0}", "0:a"),
        (raw"\X", "\u{301}a", "0:\u{301}"),
        (raw"a\X", "a", "none"),
        (raw"\X\x{301}", "e\u{301}", "none"),
        (raw"(\X)+", "ab", "0:ab|b"),
        (raw"\X{2}", "🇫🇷🇩🇪🇮", "0:🇫🇷🇩🇪"),
        (raw"(?<=\X)a", "", "error: Look-behind group does not have an obvious maximum length @5"),
    ])
    assertEq(Regex(raw"\X").findAllIn("🇫🇷🇩🇪🇮e\u{301}\r\n").toList(), ["🇫🇷", "🇩🇪", "🇮", "e\u{301}", "\r\n"].toList())

@test("\\b{g} matches between grapheme clusters, at the ends of the text and nowhere inside a cluster")
graphemeBoundaries()
    val bound = Regex(raw"\b{g}")
    assertEq(bound.replaceAllIn("e\u{301}a", "|"), "|e\u{301}|a|")
    assertEq(bound.replaceAllIn("🇫🇷🇩🇪", "|"), "|🇫🇷|🇩🇪|")
    assertEq(bound.replaceAllIn("👨\u{200d}👩", "|"), "|👨\u{200d}👩|")
    assertEq(bound.replaceAllIn("\r\n", "|"), "|\r\n|")
    assertEq(bound.replaceAllIn("", "|"), "|")
    conform([
        (raw"\b{g}x", "x", "0:x"),
        (raw"e\b{g}", "e\u{301}", "none"),
        (raw"(?<=\b{g})\x{301}", "e\u{301}", "none"),
        (raw"\b{g}\x{301}", "\u{301}", "0:\u{301}"),
    ])

@test("greedy, reluctant and possessive quantifiers")
quantifiers()
    conform([
        ("a*", "baaa", "0:"),
        ("a+", "baaa", "1:aaa"),
        ("a?b", "ab", "0:ab"),
        ("a{2}", "aaaa", "0:aa"),
        ("a{2,}", "aaaa", "0:aaaa"),
        ("a{2,3}", "aaaa", "0:aaa"),
        ("a{0}b", "ab", "1:b"),
        ("a+?", "aaa", "0:a"),
        ("a*?b", "aaab", "0:aaab"),
        ("a{2,3}?", "aaaa", "0:aa"),
        ("a??b", "ab", "0:ab"),
        ("a*+a", "aaa", "none"),
        ("a++b", "aaab", "0:aaab"),
        ("a?+a", "a", "none"),
        ("a{1,2}+a", "aaa", "0:aaa"),
        ("x{2}{3}", "xxxxxx", "0:xx"),
        ("{2}", "a", "0:"),
        (".*foo", "xfooyfoo", "0:xfooyfoo"),
        (".*?foo", "xfooyfoo", "0:xfoo"),
        ("(a+)(a+)", "aaaa", "0:aaaa|aaa|a"),
        ("(a+?)(a+)", "aaaa", "0:aaaa|a|aaa"),
        ("(a*)*", "b", "0:|"),
        ("(a*)+", "b", "0:|"),
        ("(a|b)*", "abba", "0:abba|a"),
        ("(a|b)*?c", "abc", "0:abc|b"),
        ("(a|b){2}", "abb", "0:ab|b"),
        ("(a|b){2,}?", "abab", "0:ab|b"),
        ("(ab)*", "ababx", "0:abab|ab"),
        ("(ab)*?x", "ababx", "0:ababx|ab"),
        ("(ab){2}", "ababab", "0:abab|ab"),
        ("(ab)?c", "abc", "0:abc|ab"),
        ("(ab)??c", "abc", "0:abc|ab"),
        ("(ab)?c", "c", "0:c|!"),
        ("(ab)*+ab", "ababab", "none"),
        ("(ab)?+a", "aba", "0:aba|ab"),
        ("(a|ab)*c", "abac", "0:abac|a"),
        ("(|a)+", "a", "0:|"),
        ("(a?)+?b", "aab", "0:aab|a"),
        ("(?:a|b)*?c", "abc", "0:abc"),
        ("a**", "", "error: Dangling meta character '*' @2"),
        ("*a", "", "error: Dangling meta character '*' @0"),
        ("+", "", "error: Dangling meta character '+' @0"),
        ("a{", "", "error: Illegal repetition @1"),
        ("x{a}", "", "error: Illegal repetition @1"),
        ("a{3,2}", "", "error: Illegal repetition range @5"),
        ("a{2", "", "error: Unclosed counted closure @3"),
        ("a{2,x}", "", "error: Unclosed counted closure @4"),
        ("a{,2}", "", "error: Illegal repetition @1"),
        ("{", "", "error: Illegal repetition @0"),
        ("{1}", "", "0:"),
        ("{a}", "", "error: Illegal repetition @0"),
        ("ab{}", "", "error: Illegal repetition @2"),
        ("(a){x", "", "error: Illegal repetition @3"),
        ("[a]{-1}", "", "error: Illegal repetition @3"),
        ("é{", "", "error: Illegal repetition @1"),
        ("😀{", "", "error: Illegal repetition @1"),
        ("a|{", "", "error: Illegal repetition @2"),
        ("(?:{)", "", "error: Illegal repetition @3"),
        ("a{1}{x", "", "error: Illegal repetition @4"),
    ])

@test("which group captures what after backtracking and in repeated groups")
captures()
    conform([
        ("(a|ab)(c|bcd)(d*)", "abcd", "0:abcd|a|bcd|"),
        ("(a|(b))+", "ba", "0:ba|a|b"),
        ("(?:(a)|b)+", "ab", "0:ab|a"),
        ("(a)|b", "b", "0:b|!"),
        ("((a)|b)+", "ab", "0:ab|b|a"),
        ("(a)?(a)", "a", "0:a|!|a"),
        ("((a)b){0,2}abc", "ababc", "0:ababc|ab|a"),
        ("(x)?(?(1)y)", "", "error: Unknown inline modifier @6"),
        ("(\\w)(\\d)?", "a", "0:a|a|!"),
        ("(a*)b\\1", "aabaa", "0:aabaa|aa"),
        ("(a*)b\\1", "aaba", "1:aba|a"),
        ("(a*)b\\1$", "aabaa", "0:aabaa|aa"),
        ("(?<n>a+)\\k<n>", "aaaa", "0:aaaa|aa"),
        ("(a)\\2", "aa", "none"),
        ("(a)\\11", "aa1", "0:aa1|a"),
        ("(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)\\10", "abcdefghijj", "0:abcdefghijj|a|b|c|d|e|f|g|h|i|j"),
        ("\\1(a)", "aa", "none"),
        ("(a\\1?)+", "aaa", "0:aaa|aa"),
        ("(?i)(a)\\1", "aA", "0:aA|a"),
        ("(a)\\1", "aA", "none"),
        ("(?iu)(é)\\1", "éÉ", "0:éÉ|é"),
        ("(?i)(é)\\1", "éÉ", "none"),
        ("\\k<x>", "", "error: named capturing group <x> does not exist @4"),
        ("\\kx", "", "error: \\k is not followed by '<' for named capturing group @2"),
        ("(?<n>a)(?<n>b)", "", "error: Named capturing group <n> is already defined @11"),
        ("(?<1a>x)", "", "error: capturing group name does not start with a Latin letter @3"),
        ("(?<ab-c>x)", "", "error: named capturing group is missing trailing '>' @5"),
        ("(?<a1>x)(?<b>y)", "xy", "0:xy|x|y"),
    ])

@test("lookahead and lookbehind")
lookarounds()
    conform([
        ("a(?=b)", "acab", "2:a"),
        ("a(?!b)", "abac", "2:a"),
        ("(?<=a)b", "cbab", "3:b"),
        ("(?<!a)b", "abcb", "3:b"),
        ("(?<=ab|c)d", "abdcd", "2:d"),
        ("(?<=a{1,3})b", "aab", "2:b"),
        ("(?<=a?b)c", "bc", "1:c"),
        ("(?<=\\b)x", "a x", "2:x"),
        ("(?<=(a|bc))d", "bcd", "2:d|bc"),
        ("(?<=(a))b", "ab", "1:b|a"),
        ("(?<=(a+?){2})b", "", "error: Look-behind group does not have an obvious maximum length @11"),
        ("(?<=a+)b", "", "error: Look-behind group does not have an obvious maximum length @5"),
        ("(?<=a*)b", "", "error: Look-behind group does not have an obvious maximum length @5"),
        ("(?<=a{2,})b", "", "error: Look-behind group does not have an obvious maximum length @8"),
        ("(?<=\\1)b", "", "error: Look-behind group does not have an obvious maximum length @5"),
        ("(?=(a))a", "a", "0:a|a"),
        ("(?:(?=(a))b|a)", "a", "0:a|a"),
        ("(?!(a))b", "b", "0:b|!"),
        ("(?=a)*b", "b", "0:b"),
        ("(?=.*z)\\w+", "abz", "0:abz"),
        ("^(?=.*\\d)(?=.*[a-z]).{4,}$", "ab1c", "0:ab1c"),
        ("^(?=.*\\d)(?=.*[a-z]).{4,}$", "abcd", "none"),
        ("(?<=^|,)\\w+", "ab,cd", "0:ab"),
        ("\\w+(?<!b)\\b", "ab ac", "3:ac"),
        ("(?<!^)x", "xx", "1:x"),
        ("(?<=😀)a", "😀a", "4:a"),
    ])

@test("atomic groups and possessive repetition never give back")
atomicGroups()
    conform([
        ("(?>a|ab)c", "abc", "none"),
        ("(?>ab|a)c", "abc", "0:abc"),
        ("(?>a+)a", "aaa", "none"),
        ("(?>a+)b", "aab", "0:aab"),
        ("(?>(a)|b)+c", "abc", "0:abc|a"),
        ("(?>x*)*y", "xxy", "0:xxy"),
        ("(?>a)?a", "a", "0:a"),
        ("(?>a?)?a", "a", "0:a"),
        ("(?>a?)a", "a", "none"),
    ])

@test("anchors, boundaries and multiline mode")
anchors()
    conform([
        ("^abc$", "abc", "0:abc"),
        ("^b", "a\nb", "none"),
        ("(?m)^b", "a\nb", "2:b"),
        ("(?m)^b", "a\r\nb", "3:b"),
        ("(?m)^b", "a\u{2028}b", "4:b"),
        ("(?m)^$", "a\n", "none"),
        ("(?m)^$", "a\n\nb", "2:"),
        ("(?m)^\\n", "a\r\nb", "none"),
        ("a$", "a\n", "0:a"),
        ("a$", "a\r\n", "0:a"),
        ("a$", "a\n\n", "none"),
        ("a$", "a\nb", "none"),
        ("(?m)a$", "a\nb", "0:a"),
        ("(?m)a$", "a\rb", "0:a"),
        ("(?m)a$", "a\u{85}b", "0:a"),
        ("$", "a\r\n", "1:"),
        ("(?m)\\r$", "a\r\n", "none"),
        ("a\\Z", "a\n", "0:a"),
        ("a\\Z", "a\nb", "none"),
        ("a\\z", "a\n", "none"),
        ("a\\z", "ba", "1:a"),
        ("\\Aa", "ba", "none"),
        ("(?m)\\Ab", "a\nb", "none"),
        ("(?d)a$", "a\r\n", "none"),
        ("(?d)a$", "a\n", "0:a"),
        ("(?md)^b", "a\rb", "none"),
        ("(?md)^b", "a\nb", "2:b"),
        ("(?md)a$", "a\rb", "none"),
        ("\\bfoo\\b", "a foo b", "2:foo"),
        ("\\bfoo\\b", "afoo foob foo", "10:foo"),
        ("\\Bo\\B", "foo", "1:o"),
        ("\\b", "", "none"),
        ("\\B", "", "0:"),
        ("\\b\\w", "_a", "0:_"),
        ("\\b.", "é", "none"),
        ("\\R", "a\r\nb", "1:\r\n"),
        ("\\R\\n", "a\r\nb", "1:\r\n"),
        ("\\R+", "\n\u{b}\u{c}\u{85}\u{2028}\u{2029}", "0:\n\u{b}\u{c}\u{85}\u{2028}\u{2029}"),
        ("a\\Rb", "a\rb", "0:a\rb"),
    ])

@test("inline and scoped flags, and comments mode")
flags()
    conform([
        ("(?i)abc", "xABC", "1:ABC"),
        ("a(?i)b", "aB", "0:aB"),
        ("a(?i)b", "AB", "none"),
        ("(?i:a)b", "Ab", "0:Ab"),
        ("(?i:a)b", "AB", "none"),
        ("a(?i)b|c", "C", "0:C"),
        ("(a(?i)b)c", "aBc", "0:aBc|aB"),
        ("(a(?i)b)c", "aBC", "none"),
        ("(?i)a(?-i)b", "Ab", "0:Ab"),
        ("(?i)a(?-i)b", "AB", "none"),
        ("(?i-i)a", "A", "none"),
        ("(?i)é", "É", "none"),
        ("(?iu)é", "É", "0:É"),
        ("(?iu)ǆ", "ǅ", "0:ǅ"),
        ("(?i)[a-c]+", "ABCd", "0:ABC"),
        ("(?i)[^a]", "Ab", "1:b"),
        ("(?i)[é]", "É", "none"),
        ("(?iu)[é]", "É", "0:É"),
        ("(?iu)[à-ê]+", "ÀÊ", "0:ÀÊ"),
        ("(?iu)k", "\u{212a}", "0:\u{212a}"),
        ("(?i)k", "\u{212a}", "none"),
        ("(?iu)[k]", "\u{212a}", "0:\u{212a}"),
        ("(?i)ab|cd", "CD", "0:CD"),
        ("(?x) a b # comment\n c", "abc", "0:abc"),
        ("(?x)a\\ b", "a b", "0:a b"),
        ("(?x)[a b]+", "ba ", "0:ba"),
        ("(?x)a #b\n", "ab", "0:a"),
        ("(?x)a{2} ", "aa", "0:aa"),
        ("(?x)\\Q a \\E", " a ", "0: a "),
        ("(?s:.)", "\n", "0:\n"),
        ("(?m)a$\\n^b", "a\nb", "0:a\nb"),
        ("(?q)", "", "error: Unknown inline modifier @2"),
        ("(?i", "", "error: Unknown inline modifier @3"),
        ("(?c)a", "", "error: Unsupported inline modifier 'c' @2"),
        ("(?-c)a", "a", "0:a"),
    ])

@test("alternation is leftmost-first")
alternation()
    conform([
        ("a|ab", "ab", "0:a"),
        ("ab|a", "ab", "0:ab"),
        ("|a", "a", "0:"),
        ("a|", "b", "0:"),
        ("x(a|ab)y", "xaby", "0:xaby|ab"),
        ("(a|ab)(c|bcd)", "abcd", "0:abcd|a|bcd"),
        ("(?:c|b)a|cab", "cab", "0:ca"),
        ("cat|dog|bird", "a bird", "2:bird"),
    ])

@test("errors in group syntax")
groupErrors()
    conform([
        ("(ab", "", "error: Unclosed group @3"),
        ("ab)", "", "error: Unmatched closing ')' @1"),
        (")", "", "error: Unmatched closing ')' @-1"),
        ("(?$a)", "", "error: Unknown group type @2"),
        (raw"\y", "", "error: Illegal/unsupported escape sequence @1"),
        (raw"\E", "", "error: Illegal/unsupported escape sequence @1"),
        (raw"\x{110000}", "", "error: Hexadecimal codepoint is too big @8"),
        (raw"\xg", "", "error: Illegal hexadecimal escape sequence @2"),
        (raw"\x{12", "", "error: Unclosed hexadecimal escape sequence @5"),
        (raw"\u00", "", "error: Illegal Unicode escape sequence @4"),
        (raw"\c", "", "error: Illegal control escape sequence @1"),
        (raw"\08", "", "error: Illegal octal escape sequence @2"),
        (raw"[\X]", "", "error: Illegal/unsupported escape sequence @2"),
        (raw"\b{g", "", "error: Illegal/unsupported escape sequence @4"),
        (raw"\b{gx}", "", "error: Illegal/unsupported escape sequence @4"),
        (raw"\b{x}", "", "error: Illegal repetition @2"),
        (raw"\N{LATIN SMALL LETTER A}", "", "error: Unsupported escape \\N: the runtime has no Unicode character names @1"),
    ])

@test("an error's message names the place, and a caret marks it inside the pattern")
errorMessages()
    assertEq(Regex.compile("ab)").map(r -> r.regex()), Err(PatternError("Unmatched closing ')'", "ab)", 1)))
    val e = PatternError("Unmatched closing ')'", "ab)", 1)
    assertEq(e.message(), "Unmatched closing ')' near index 1\nab)\n ^")
    assertEq(PatternError("Unclosed group", "(ab", 3).message(), "Unclosed group near index 3\n(ab")
    assertEq(PatternError("Unmatched closing ')'", ")", -1).message(), "Unmatched closing ')'\n)")
    assertEq(e.toString(), e.message())
    assertEq(Regex.compile("{").map(r -> r.regex()), Err(PatternError("Illegal repetition", "{", 0)))
    assertEq(Regex.compile("{").map(r -> r.regex()).mapErr(x -> x.message()), Err("Illegal repetition near index 0\n{\n^"))
    assertEq(Regex.compile("ab{").map(r -> r.regex()).mapErr(x -> x.message()), Err("Illegal repetition near index 2\nab{\n  ^"))

@test("matches, findPrefixOf and the anchoring of a regex")
wholeAndPrefix()
    val r = Regex("a+b")
    assert(r.matches("aab"))
    assert(!r.matches("aabx"))
    assert(!r.matches("xaab"))
    assert(r.unanchored().matches("xaabx"))
    assert(!r.unanchored().anchored().matches("xaabx"))
    assert(Regex("a*?").matches("aaa"))
    assert(Regex("(?m)a$").matches("a"))
    assert(Regex("").matches(""))
    assert(!Regex("a|ab").findPrefixOf("abc").contains("ab"))
    assertEq(Regex("a|ab").findPrefixOf("abc"), Some("a"))
    assert(Regex("a|ab").matches("ab"))
    assertEq(Regex("b").findPrefixOf("abc"), None)
    assertEq(Regex("\\w+").findPrefixMatchOf("ab cd").map(m -> m.end()), Some(2))
    assertEq(Regex("x").findFirstIn("abc"), None)
    assertEq(Regex("b+").findFirstIn("abbc"), Some("bb"))

@test("findAllIn walks every match, an empty match moving the search on one character")
allMatches()
    assertEq(Regex("\\d+").findAllIn("a1b22c333").toList(), List("1", "22", "333"))
    assertEq(Regex("a*").findAllIn("baac").toList(), List("", "aa", "", ""))
    assertEq(Regex("").findAllIn("ab").toList(), List("", "", ""))
    assertEq(Regex("").findAllIn("é😀").toList(), List("", "", ""))
    assertEq(Regex("(?m)^").findAllMatchIn("a\nb\n").map(m -> m.start()).toList(), List(0, 2))
    assertEq(Regex("\\Ga").findAllIn("aaba").toList(), List("a", "a"))
    assertEq(Regex("x").findAllIn("abc").toList(), List.empty[string]())
    assertEq(Regex("(\\w)(\\d)").findAllMatchIn("a1 b2 c").map(m -> m.group(1).get()).toList(), List("a", "b"))
    val it = Regex("(o)").findAllIn("foo")
    assert(it.hasNext())
    assertEq(it.start(), 1)
    assertEq(it.next(), "o")
    assertEq(it.start(), 1)
    assertEq(it.end(), 2)
    assertEq(it.group(1), Some("o"))
    assertEq(it.groupCount(), 1)
    assertEq(it.next(), "o")
    assertEq(it.start(), 2)
    assert(!it.hasNext())

@test("a match's groups, offsets and surroundings")
matchData()
    val m = Regex("(\\d+)-(x)?(\\d+)").findFirstMatchIn("tel 12-345 ok").get()
    assertEq(m.matched(), "12-345")
    assertEq(m.start(), 4)
    assertEq(m.end(), 10)
    assertEq(m.groupCount(), 3)
    assertEq(m.group(0), Some("12-345"))
    assertEq(m.group(1), Some("12"))
    assertEq(m.group(2), None)
    assertEq(m.start(2), -1)
    assertEq(m.end(2), -1)
    assertEq(m.start(3), 7)
    assertEq(m.end(3), 10)
    assertEq(m.before(), "tel ")
    assertEq(m.after(), " ok")
    assertEq(m.before(3), Some("tel 12-"))
    assertEq(m.after(1), Some("-345 ok"))
    assertEq(m.before(2), None)
    assertEq(m.subgroups(), List(Some("12"), None, Some("345")))
    assertEq(m.source, "tel 12-345 ok")
    assertEq(m.toString(), "12-345")
    val w = Regex("((a)b){0,2}abc").findFirstMatchIn("ababc").get()
    assertEq(w.start(2), 2)

@test("group names come from the pattern, or from the names given to the regex")
groupNames()
    val m = Regex("(?<year>\\d{4})-(?<month>\\d\\d)").findFirstMatchIn("on 2024-06").get()
    assertEq(m.group("year"), Some("2024"))
    assertEq(m.group("month"), Some("06"))
    assertEq(m.groupNames(), Vector.empty[string]())
    val n = Regex("(\\d+)/(\\d+)", "num", "den").findFirstMatchIn("3/4").get()
    assertEq(n.group("num"), Some("3"))
    assertEq(n.group("den"), Some("4"))
    assertEq(n.group(""), Some("3/4"))
    assertEq(n.groupNames(), ["num", "den"])
    assertEq("(a)".r("first").findFirstMatchIn("a").get().group("first"), Some("a"))

@test("offsets count bytes, and matching counts characters")
offsets()
    val m = Regex("(.)b").findFirstMatchIn("é😀b").get()
    assertEq(m.start(), 2)
    assertEq(m.end(), 7)
    assertEq(m.group(1), Some("😀"))
    assertEq(m.before(), "é")
    assertEq(Regex("^.{2}$").matches("é😀"), true)

@test("a regex shows as its pattern")
shown()
    val r = "a+b".r()
    assertEq(r.toString(), "a+b")
    assertEq(r.regex(), "a+b")
    assertEq(r.pattern().pattern(), "a+b")
    assertEq(Regex("(a)(?:b)(?<c>d)").pattern().groupCount(), 2)

@test("long inputs are searched without a step limit, in reasonable time")
longInputs()
    val words = Buffer[string]()
    for i in 0..<20000 do words.addOne(s"word$i")
    val text = words.mkString(" ")
    assertEq(Regex("\\w+").findAllIn(text).toList().length(), 20000)
    assertEq(Regex("word19999").findFirstMatchIn(text).map(m -> m.start()), Some(text.byteLength() - 9))
    assertEq(Regex("word(\\d+)").findAllMatchIn(text).map(m -> m.group(1).get().toInt()).toList().length(), 20000)
    assertEq(Regex("(a|b)*c").findFirstMatchIn("ab".repeat(100) + "c").map(m -> m.group(1)), Some(Some("b")))
    assert(Regex(".*19999$").matches(text))
    assertEq(Regex("[a-z]+(\\d+)$").findFirstMatchIn(text).flatMap(m -> m.group(1)), Some("19999"))
    val many = "a".repeat(5000)
    assert(Regex("a*a*a*b?").matches(many))
    assert(!Regex("(?:a|aa)*b").matches("a".repeat(25)))
    assertEq(Regex("(?:a|aa)*b").findFirstIn("a".repeat(300)), None)
    assertEq(Regex("(x+x+)+y").findFirstIn("x".repeat(200)), None)
    assertEq(Regex("^(\\w+\\s?)*$").findFirstIn("an example sentence that does not end well!"), None)

@test("replacing fills in group references, by number and by the pattern's names")
groupReferences()
    val date = Regex("(?<year>\\d{4})-(?<month>\\d\\d)")
    assertEq(date.replaceAllIn("2024-06, 2025-01", "$2/$1"), "06/2024, 01/2025")
    assertEq(date.replaceAllIn("2024-06, 2025-01", "${month}.${year}"), "06.2024, 01.2025")
    assertEq(date.replaceFirstIn("2024-06, 2025-01", "[$0]"), "[2024-06], 2025-01")
    assertEq(date.replaceFirstIn("no dates", "x"), "no dates")
    assertEq(date.replaceAllIn("no dates", "x"), "no dates")
    assertEq(Regex("(a)(b)?").replaceAllIn("ab a", "<$2>"), "<b> <>")
    assertEq(Regex("(a)").replaceAllIn("a", "$10$1"), "a0a")
    val eleven = Regex("(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k)")
    assertEq(eleven.replaceAllIn("abcdefghijk", "$11$12"), "ka2")
    assertEq(Regex("é(.)").replaceAllIn("aé😀b", "$1é"), "a😀éb")
    assertEq(Regex("\\Ga").replaceAllIn("aaba", "x"), "xxba")

@test("a backslash makes the character after it literal, and quoteReplacement writes text literally")
escapes()
    assertEq(Regex("a").replaceAllIn("a", "\\$1 \\\\ \\x \\é"), "$1 \\ x é")
    assertEq(Regex("a").replaceAllIn("a", Regex.quoteReplacement("$1\\")), "$1\\")
    assertEq(Regex.quoteReplacement("plain"), "plain")
    assertEq(Regex.quoteReplacement("a$b\\c"), "a\\$b\\\\c")
    assertEq(Regex("(\\w)").replaceAllIn("ab", m -> Regex.quoteReplacement("$" + m.matched())), "$a$b")

@test("a replacement may be computed from each match, and some matches kept")
computedReplacements()
    assertEq(Regex("\\d+").replaceAllIn("a1b22", m -> (m.matched().toInt() + 1).toString()), "a2b23")
    assertEq(Regex("(\\w)(\\w)").replaceAllIn("abcd", m -> "$2$1"), "badc")
    assertEq(Regex("\\w+").replaceSomeIn("one three five", m -> if m.matched().byteLength() > 3 then Some(m.matched().toUpperCase()) else None), "one THREE FIVE")
    assertEq(Regex("\\w+").replaceSomeIn("a b", m -> None), "a b")
    assertEq(Regex("x*").replaceSomeIn("axb", m -> if m.matched().isEmpty() then Some("-") else None), "-ax-b-")

@test("an empty match is replaced between characters, and the search moves on one character")
emptyMatches()
    assertEq(Regex("").replaceAllIn("é😀", "-"), "-é-😀-")
    assertEq(Regex("").replaceAllIn("", "-"), "-")
    assertEq(Regex("").replaceFirstIn("ab", "-"), "-ab")
    assertEq(Regex("a*").replaceAllIn("baaac", "-"), "-b--c-")
    assertEq(Regex("\\b").replaceAllIn("hi you", "|"), "|hi| |you|")

@test("split drops the empty pieces at the end, and a limit bounds the pieces")
splitting()
    assertEq(Regex(",").split("a,b,,c,,").toList(), List("a", "b", "", "c"))
    assertEq(Regex(",").split(",a").toList(), List("", "a"))
    assertEq(Regex(",").split(",,,").toList(), List.empty[string]())
    assertEq(Regex(",").split("").toList(), List(""))
    assertEq(Regex(",").split("abc").toList(), List("abc"))
    assertEq(Regex("").split("é😀x").toList(), List("é", "😀", "x"))
    assertEq(Regex("(?=b)").split("abab").toList(), List("a", "ba", "b"))
    assertEq(Regex("\\s*").split(" a b").toList(), List("", "", "a", "", "b"))
    assertEq(Regex("\\s*").split("a b").toList(), List("a", "", "b"))
    assertEq(Regex("😀").split("a😀b😀").toList(), List("a", "b"))
    val comma = Regex(",").pattern()
    assertEq(comma.split("a,b,,", -1).toList(), List("a", "b", "", ""))
    assertEq(comma.split("a,b,c", 2).toList(), List("a", "b,c"))
    assertEq(comma.split("a,b,c", 1).toList(), List("a,b,c"))
    assertEq(comma.split("a,b,,", 3).toList(), List("a", "b", ","))
    assertEq(comma.split("a,b,c", 10).toList(), List("a", "b", "c"))
    assertEq(comma.split("a,,", 0).toList(), List("a"))

@test("quote makes a pattern that matches its text literally")
quoting()
    assertEq(Regex.quote("a.b"), "\\Qa.b\\E")
    assertEq(Regex.quote("x\\Ey"), "\\Qx\\E\\\\E\\Qy\\E")
    for text in ["1+1=2", "a\\Eb\\E", "\\", "[(*)]", "é😀$", ""]
        assert(Regex(Regex.quote(text)).matches(text))
    assertEq(Regex(Regex.quote("a.c")).findFirstIn("abc a.c"), Some("a.c"))
