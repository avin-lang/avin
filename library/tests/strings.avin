// The string methods at their edges: the empty string, a needle at either end, a character of more
// than one byte, and numbers at the limits of their types.

@test("indexOf finds the first occurrence, an empty needle at `from`, and nothing past the end")
indexOfEdges()
    assertEq("abcabc".indexOf("bc"), 1)
    assertEq("abcabc".indexOf("bc", 2), 4)
    assertEq("abcabc".indexOf("bc", 5), -1)
    assertEq("abc".indexOf(""), 0)
    assertEq("abc".indexOf("", 2), 2)
    assertEq("abc".indexOf("x", -5), -1)
    assertEq("abc".indexOf("a", -5), 0)
    assertEq("abc".indexOf("a", 4), -1)
    assertEq("".indexOf("a"), -1)
    assertEq("".indexOf(""), 0)
    assertEq("ab".indexOf("abc"), -1)

@test("lastIndexOf finds the last occurrence, and an empty needle at the end")
lastIndexOfEdges()
    assertEq("abcabc".lastIndexOf("abc"), 3)
    assertEq("aaa".lastIndexOf("aa"), 1)
    assertEq("abc".lastIndexOf(""), 3)
    assertEq("".lastIndexOf(""), 0)
    assertEq("ab".lastIndexOf("abc"), -1)
    assertEq("abc".lastIndexOf("x"), -1)

@test("lastIndexOf with an end finds the last occurrence beginning at or before it")
lastIndexOfBeforeEdges()
    assertEq("abcabc".lastIndexOf("abc", 2), 0)
    assertEq("abcabc".lastIndexOf("abc", 3), 3)
    assertEq("abcabc".lastIndexOf("abc", 99), 3)
    assertEq("abcabc".lastIndexOf("bc", 0), -1)
    assertEq("abcabc".lastIndexOf("a", -1), -1)
    assertEq("abc".lastIndexOf("", 1), 1)

@test("indexWhere and lastIndexWhere answer the byte offset of a character, or -1")
indexWhereEdges()
    val s = "aé1€2"
    assertEq(s.indexWhere(c -> c.isDigit), 3)
    assertEq(s.indexWhere(c -> c.isDigit, 4), 7)
    assertEq(s.indexWhere(c -> c == '€'), 4)
    assertEq(s.indexWhere(c -> c == 'z'), -1)
    assertEq(s.indexWhere(c -> c == 'a', -3), 0)
    assertEq(s.indexWhere(c -> c == 'a', 99), -1)
    assertEq(s.lastIndexWhere(c -> c.isDigit), 7)
    assertEq(s.lastIndexWhere(c -> c == 'é'), 1)
    assertEq(s.lastIndexWhere(c -> c == 'z'), -1)
    assertEq("".indexWhere(_ -> true), -1)
    assertEq("".lastIndexWhere(_ -> true), -1)

@test("startsWith, endsWith and contains, with empty and over-long parts")
affixes()
    assert("abc".startsWith(""))
    assert("abc".endsWith(""))
    assert("".startsWith(""))
    assert("".endsWith(""))
    assert(!"ab".startsWith("abc"))
    assert(!"ab".endsWith("abc"))
    assert("abc".startsWith("c", 2))
    assert(!"abc".startsWith("c", 3))
    assert(!"abc".startsWith("a", -1))
    assert("abc".contains("") && !"".contains("a"))

@test("toLongOption and toIntOption accept their least and greatest values and refuse one past them")
integerParsingLimits()
    val greatest: long = 9223372036854775807
    assertEq("9223372036854775807".toLongOption(), Some(greatest))
    assertEq("-9223372036854775808".toLongOption(), Some(long(-9223372036854775807) - 1))
    assertEq("9223372036854775808".toLongOption(), None)
    assertEq("-9223372036854775809".toLongOption(), None)
    assertEq("2147483647".toIntOption(), Some(2147483647))
    assertEq("-2147483648".toIntOption(), Some(-2147483647 - 1))
    assertEq("2147483648".toIntOption(), None)
    assertEq("-2147483649".toIntOption(), None)
    assertEq("+7".toIntOption(), Some(7))
    assertEq("-0".toIntOption(), Some(0))
    assertEq("007".toIntOption(), Some(7))

@test("toInt, toLong and toReal answer the number itself")
numberParsingDirect()
    assertEq("2147483647".toInt(), 2147483647)
    assertEq("-2147483648".toInt(), -2147483647 - 1)
    assertEq("+7".toInt() + 1, 8)
    assertEq("-9223372036854775808".toLong(), long(-9223372036854775807) - 1)
    assertEq("2147483648".toLong(), long(2147483647) + 1)
    assertEq("-.5".toReal(), -0.5)
    assertEq("7".toReal(), 7.0)

@test("toLongOption refuses signs alone, white space, separators and other characters")
integerParsingRefusals()
    for text in ["", "-", "+", " 1", "1 ", "1_000", "1,000", "1e3", "0x10", "--1", "+-1", "1-", "١"]
        assertEq(text.toLongOption(), None)
        assertEq(text.toIntOption(), None)

@test("toRealOption reads fractions and exponents and refuses what is not a finite number")
realParsing()
    assertEq("3.25".toRealOption(), Some(3.25))
    assertEq("-.5".toRealOption(), Some(-0.5))
    assertEq("1e10".toRealOption(), Some(1e10))
    assertEq("".toRealOption(), None)
    assertEq("abc".toRealOption(), None)
    assertEq("1e400".toRealOption(), None)

@test("split keeps empty pieces at either end and between separators")
splitEdges()
    assertEq("a,,b,".split(","), ["a", "", "b", ""])
    assertEq(",a".split(","), ["", "a"])
    assertEq("".split(","), [""])
    assertEq(",".split(","), ["", ""])
    assertEq("abc".split(","), ["abc"])
    assertEq("a--b--".split("--"), ["a", "b", ""])
    assertEq("aaa".split("aa"), ["", "a"])

@test(should_trap: "split by an empty separator")
splitByNothingTraps()
    "abc".split("")

@test("lines ends a line at \\n or \\r\\n, starts none after a final terminator, and keeps a lone \\r")
linesEdges()
    assertEq("".lines.length, 0)
    assertEq("\n".lines, [""])
    assertEq("\r\n".lines, [""])
    assertEq("a\r\nb".lines, ["a", "b"])
    assertEq("a\n\nb\n".lines, ["a", "", "b"])
    assertEq("a\rb".lines, ["a\rb"])
    assertEq("\n\n".lines, ["", ""])

@test("strip removes Unicode white space at both ends and leaves the inside alone")
stripEdges()
    assertEq("".strip, "")
    assertEq("   ".strip, "")
    assertEq("   ".stripLeading, "")
    assertEq("   ".stripTrailing, "")
    assertEq("\u{a0}\u{3000} a b \t\n".strip, "a b")
    assertEq("  x ".stripLeading, "x ")
    assertEq("  x ".stripTrailing, "  x")
    assertEq("\u{3000}x\u{a0}".stripLeading, "x\u{a0}")
    assertEq("\u{3000}x\u{a0}".stripTrailing, "\u{3000}x")
    assert("".isBlank && " \t".isBlank && !" x".isBlank)

@test("trim removes the control characters and spaces up to U+0020 at both ends, and nothing wider")
trimEdges()
    assertEq("".trim, "")
    assertEq("   ".trim, "")
    assertEq("\u{0}\u{1f} a b \t\n".trim, "a b")
    assertEq("\u{a0}x\u{3000}".trim, "\u{a0}x\u{3000}")
    assertEq(" \u{a0}x ".trim, "\u{a0}x")
    assertEq("\u{7f}x".trim, "\u{7f}x")

@test("take, drop and their right-hand forms count characters and clamp at both ends")
takeAndDrop()
    val s = "zoë!"
    assertEq(s.take(3), "zoë")
    assertEq(s.drop(3), "!")
    assertEq(s.takeRight(2), "ë!")
    assertEq(s.dropRight(2), "zo")
    assertEq(s.take(0), "")
    assertEq(s.take(-1), "")
    assertEq(s.take(10), s)
    assertEq(s.drop(-1), s)
    assertEq(s.drop(10), "")
    assertEq(s.takeRight(10), s)
    assertEq(s.dropRight(10), "")
    assertEq("".take(1), "")
    assertEq("".takeRight(1), "")

@test("charCount, chars and reverse treat a multi-byte character as one")
charactersAndBytes()
    val s = "aé€😀"
    assertEq(s.charCount, 4)
    assertEq(s.byteLength, 10)
    assertEq(s.chars, ['a', 'é', '€', '😀'])
    assertEq(s.reverse, "😀€éa")
    assertEq("".reverse, "")
    assertEq("".chars.length, 0)
    assertEq("ab".bytes, [byte(0x61), byte(0x62)])
    assertEq(s.count(c -> c != 'a'), 3)
    assertEq(s.charAt(1), 'é')
    assertEq(s.charAt(6), '😀')

@test("padStart and padEnd count characters and leave a long enough string as it is")
padding()
    assertEq("ë".padStart(3), "  ë")
    assertEq("ë".padEnd(3, '.'), "ë..")
    assertEq("abc".padStart(2), "abc")
    assertEq("abc".padEnd(-1), "abc")
    assertEq("".padStart(2, '0'), "00")

@test("padTo appends a character up to a length counted in characters")
paddingTo()
    assertEq("ë".padTo(3, '.'), "ë..")
    assertEq("abc".padTo(2, '.'), "abc")
    assertEq("".padTo(2, '0'), "00")
    assertEq("ab".padTo(-1, '.'), "ab")

@test("replace replaces every non-overlapping occurrence left to right, and an empty old nowhere")
replacing()
    assertEq("aaaa".replace("aa", "b"), "bb")
    assertEq("aaa".replace("aa", "b"), "ba")
    assertEq("abc".replace("", "x"), "abc")
    assertEq("abc".replace("b", ""), "ac")
    assertEq("".replace("a", "b"), "")
    assertEq("abab".replace("ab", "abab"), "abababab")

@test("repeat writes the string count times, empty for zero")
repeating()
    assertEq("ab".repeat(3), "ababab")
    assertEq("ab".repeat(0), "")
    assertEq("".repeat(5), "")

@test(should_trap)
repeatNegativeTraps()
    "ab".repeat(-1)

@test("case mapping maps one for one and compares ignoring case")
caseMapping()
    assertEq("Straße Ä".toUpper, "STRAßE Ä")
    assertEq("ÉCOLE".toLower, "école")
    assertEq("".toUpper, "")
    assertEq("ǅ".toLower, "ǆ")
    // A string and a char map a character alike.
    assertEq("é".toUpper, 'é'.toUpper.toString())
    assert("Zoë".equalsIgnoreCase("zOË"))
    assert(!"a".equalsIgnoreCase("ab"))

@test(should_trap)
sliceInsideACharacterTraps()
    "é".slice(0, 1)

@test(should_trap)
sliceOutOfOrderTraps()
    "abc".slice(2, 1)

@test(should_trap: "For input string: \"x\"")
toIntOfNotANumberTraps()
    "x".toInt()

@test(should_trap: "For input string: \"2147483648\"")
toIntPastTheGreatestTraps()
    "2147483648".toInt()

@test(should_trap: "For input string: \"\"")
toLongOfEmptyTraps()
    "".toLong()

@test(should_trap: "For input string: \"1e400\"")
toRealPastFiniteTraps()
    "1e400".toReal()

@test(should_trap: "For input string: \" 1\"")
toIntOfSpacedTraps()
    " 1".toInt()

@test("stripPrefix and stripSuffix take off what is there and leave the string otherwise")
prefixAndSuffix()
    assertEq("café au lait".stripPrefix("café "), "au lait")
    assertEq("café".stripPrefix("x"), "café")
    assertEq("café".stripPrefix(""), "café")
    assertEq("café".stripPrefix("café"), "")
    assertEq("ab".stripPrefix("abc"), "ab")
    assertEq("file.avin".stripSuffix(".avin"), "file")
    assertEq("日本".stripSuffix("本"), "日")
    assertEq("ab".stripSuffix("b".repeat(3)), "ab")
    assertEq("".stripSuffix(""), "")

@test("capitalize maps a lower-case first character to upper case and nothing else")
capitalizing()
    assertEq("hello world".capitalize, "Hello world")
    assertEq("élan".capitalize, "Élan")
    assertEq("Hello".capitalize, "Hello")
    assertEq("1st".capitalize, "1st")
    assertEq("".capitalize, "")
    assertEq("ß".capitalize, "ß")
    assertEq("a".capitalize, "A")

@test("stripMargin takes the leading blanks and the margin character off each line")
margins()
    assertEq("  |one\n  |two".stripMargin(), "one\ntwo")
    assertEq("|a\n\t|b\n   c\n|".stripMargin(), "a\nb\n   c\n")
    assertEq("  |  indented\n  ||bar".stripMargin(), "  indented\n|bar")
    assertEq("one\n\n  |two\n".stripMargin(), "one\n\ntwo\n")
    assertEq("  |a\r\n  |b".stripMargin(), "a\r\nb")
    assertEq("  #x\n  |y".stripMargin('#'), "x\n  |y")
    assertEq("  ·é\n·ü".stripMargin('·'), "é\nü")
    assertEq("".stripMargin(), "")
    assertEq("no margin".stripMargin(), "no margin")

@test("head and last are the end characters, and their Option forms are None for the empty string")
endCharacters()
    assertEq("abc".head, 'a')
    assertEq("abc".last, 'c')
    assertEq("é😀".head, 'é')
    assertEq("é😀".last, '😀')
    assertEq("x".head, "x".last)
    assertEq("日本".headOption, Some('日'))
    assertEq("日本".lastOption, Some('本'))
    assertEq("".headOption, None)
    assertEq("".lastOption, None)

@test(should_trap: "head of empty string")
headOfEmptyTraps()
    "".head

@test(should_trap: "last of empty string")
lastOfEmptyTraps()
    "".last

@test("indexOf and lastIndexOf of a character answer byte offsets, -1 when it is absent")
characterSearch()
    val s = "aé日é😀a"
    assertEq(s.indexOf('a'), 0)
    assertEq(s.indexOf('é'), 1)
    assertEq(s.indexOf('日'), 3)
    assertEq(s.indexOf('😀'), 8)
    assertEq(s.indexOf('z'), -1)
    assertEq(s.indexOf('é', 2), 6)
    assertEq(s.indexOf('a', 1), 12)
    assertEq(s.indexOf('a', 13), -1)
    assertEq(s.indexOf('a', -5), 0)
    assertEq(s.lastIndexOf('a'), 12)
    assertEq(s.lastIndexOf('é'), 6)
    assertEq(s.lastIndexOf('é', 5), 1)
    assertEq(s.lastIndexOf('a', 11), 0)
    assertEq(s.lastIndexOf('z'), -1)
    assertEq("".indexOf('a'), -1)
    assertEq("".lastIndexOf('a'), -1)
    assertEq(s.indexOf("é"), s.indexOf('é'))

@test("lastIndexWhere with an end finds the last character beginning at or before it")
lastIndexWhereBefore()
    val s = "a1é2b"
    assertEq(s.lastIndexWhere(c -> c.isDigit), 4)
    assertEq(s.lastIndexWhere(c -> c.isDigit, 4), 4)
    assertEq(s.lastIndexWhere(c -> c.isDigit, 3), 1)
    assertEq(s.lastIndexWhere(c -> c == 'é', 2), 2)
    assertEq(s.lastIndexWhere(c -> c == 'é', 3), 2)
    assertEq(s.lastIndexWhere(c -> c.isDigit, 99), 4)
    assertEq(s.lastIndexWhere(c -> c == 'a', 0), 0)
    assertEq(s.lastIndexWhere(c -> c == 'a', -1), -1)
    assertEq(s.lastIndexWhere(c -> c == 'z', 99), -1)
    assertEq("".lastIndexWhere(c -> true, 0), -1)
