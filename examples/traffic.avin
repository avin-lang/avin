// A traffic light as a small state machine: `match` maps each state to what it says and to the
// state after it, and a loop runs it through two full cycles.
//
//     avin build traffic.avin && ./traffic

says(light: char) -> string = light match
  'r' -> "red: stop"
  'g' -> "green: go"
  'y' -> "yellow: slow down"
  _ -> "dark"

after(light: char) -> char = light match
  'r' -> 'g'
  'g' -> 'y'
  _ -> 'r'

main()
  var light = 'r'
  for _ in 0 ..< 6
    println(says(light))
    light = after(light)
