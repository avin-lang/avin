// Integer arithmetic never silently wraps. 20! fits in an i64 and 21! does not, so asking for 21!
// stops the program with a trap rather than handing back a wrong number. Where wrapping or clamping
// is what a program wants, it says so with `*%` (wrapping) or `*|` (saturating).
//
//     avin build overflow.avin && ./overflow        prints three lines, then stops with a trap
//
// expect: trap

factorial(n: i64) -> i64 = if n <= 1 then 1 else n * factorial(n - 1)

main()
    if factorial(20) == 2432902008176640000 then print("20! fits in an i64")
    val largest: i64 = 9223372036854775807
    if factorial(20) *| 21 == largest then print("21! saturates at the largest i64")
    if factorial(20) *% 21 < 0 then print("and wraps around to a negative number")
    factorial(21)
