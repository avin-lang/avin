// Integer arithmetic never silently wraps. 20! fits in a long and 21! does not, so asking for 21!
// stops the program with a trap rather than handing back a wrong number. Where wrapping or clamping
// is what a program wants, it says so with `*%` (wrapping) or `*|` (saturating).
//
//     avin build overflow.avin && ./overflow        prints three lines, then stops with a trap that
//                                                   names the `*` in `factorial` as the place
//
// expect: trap

factorial(n: long) -> long = if n <= 1 then 1 else n * factorial(n - 1)

main()
    print(s"20! = ${factorial(20)} fits in a long")
    print(s"21! saturates at the largest long, ${factorial(20) *| 21}")
    print(s"or wraps around to ${factorial(20) *% 21}")
    print(s"21! = ${factorial(21)}")
