// Adds up the numbers on standard input, one to a line, telling standard error about any line that
// is not a number and carrying on. The answer goes to standard output, so a pipe or a file takes it
// alone.
//
//     avin build sum_lines.avin && ./sum_lines < sum_lines.in
//
// expect: exit 0
import avin.io

main()
    var total = 0
    for line in io.lines()
        line.trim.toIntOption() match
            Some(n) -> total += n
            None -> eprintln(s"not a number: $line")
    println(total)
