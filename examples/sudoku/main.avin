// Solves sudoku puzzles read from standard input, one to a line: 81 characters, row by row, a digit
// for a given and `.` or `0` for an empty square. A line starting with `#` is a comment, and a blank
// line is skipped.
//
// The solver keeps, for every square, the set of digits still possible there as nine bits. Placing
// a digit takes it out of the square's twenty peers; a square left with one candidate is placed in
// turn. When that runs dry, the solver guesses at the square with the fewest candidates, on a copy
// of the board, and backs out of a guess that leads to a square with none. Each solution is printed
// as a grid with the number of guesses it took.
//
//     avin build main.avin && ./main < ../sudoku.in
//
// expect: exit 0
import avin.io

val All = 0x1FF

// The twenty squares that share a row, a column or a box with each square.
val Peers: Vector[Vector[int]] = Vector.tabulate(81, peersOf)

peersOf(square: int) -> Vector[int]
  val (row, col) = (square / 9, square % 9)
  val (top, left) = (row / 3 * 3, col / 3 * 3)
  for
    r in 0 ..< 9
    c in 0 ..< 9
    if (r == row || c == col || (top <= r < top + 3 && left <= c < left + 3)) && (r, c) != (row, col)
  yield r * 9 + c

// The digits a set of candidates holds, smallest first.
digits(mask: int) -> Vector[int] = (1 .. 9).filter(d -> mask & bit(d) != 0)

bit(d: int) -> int = 1 << (d - 1)

bitCount(mask: int) -> int = digits(mask).length

class Board(private val candidates: Array[int])
  copy() -> Board = Board(candidates.copy())

  solved -> bool = candidates.forall(m -> bitCount(m) == 1)

  // Places `d` at `square`: false when that leaves some square with no candidate.
  place(square: int, d: int) -> bool
    for other in digits(candidates(square))
      if other != d && !eliminate(square, other) then return false
    true

  // Takes `d` from the candidates at `square`, placing what a single remaining candidate forces.
  private eliminate(square: int, d: int) -> bool
    val mask = candidates(square)
    if mask & bit(d) == 0 then return true
    val left = mask & ~bit(d)
    candidates(square) = left
    bitCount(left) match
      0 -> false
      1 ->
        val only = digits(left)(0)
        Peers(square).forall(p -> eliminate(p, only))
      _ -> true

  // The open square with the fewest candidates, if any square is still open.
  mostConstrained() -> Option[int] =
    (0 ..< 81).filter(s -> bitCount(candidates(s)) > 1).minByOption(s -> bitCount(candidates(s)))

  options(square: int) -> Vector[int] = digits(candidates(square))

  show() -> string
    val rows = for r in 0 ..< 9 yield
      val cells = (0 ..< 9).map(c -> digits(candidates(r * 9 + c))(0).toString())
      val line = cells.grouped(3).map(_.mkString(" ")).mkString(" | ")
      if r == 3 || r == 6 then "------+-------+------\n" + line else line
    rows.mkString("\n")

// A puzzle's board with its givens placed, or None when they already contradict each other.
parse(line: string) -> Option[Board]
  val board = Board(Array.fill(81, All))
  for (ch, square) in line.chars.zipWithIndex
    ch match
      '1' <= ch <= '9' -> if !board.place(square, int(ch) - int('0')) then return None
      _ -> ()
  Some(board)

// Depth-first search over guesses; `guesses` counts every one made, wrong ones included.
class Solver
  var guesses = 0

  solve(board: Board) -> Option[Board] = board.mostConstrained() match
    None -> Some(board)
    Some(square) ->
      for d in board.options(square)
        guesses++
        val attempt = board.copy()
        if attempt.place(square, d)
          solve(attempt) match
            Some(done) -> return Some(done)
            None -> ()
      None

main()
  var n = 0
  for line in io.lines()
    val text = line.trim
    if text.isEmpty || text.startsWith("#") then continue
    n++
    if text.charCount != 81
      println(s"puzzle $n: expected 81 squares, found ${text.charCount}")
      continue
    val solver = Solver()
    parse(text).flatMap(solver.solve) match
      Some(board) ->
        println(s"puzzle $n, solved after ${solver.guesses} guesses:")
        println(board.show())
      None -> println(s"puzzle $n has no solution")
