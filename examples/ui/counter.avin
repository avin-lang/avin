// A window with a count and a button that adds one to it.
//
// The counter is a component: a function building its view, which keeps its count in a state its
// scope remembers from one build to the next. The button's callback updates the state, and the
// update asks the frame loop for a new build, which shows the new count. With an argument, the
// program writes its first frame to that PNG file and stops.
import ui.{Title, View, app, button, column, component, invalidate, root, row, run, saveFrame, spacer, stop, text}

counter(step: int) -> View = component c ->
  val count = c.state(0)
  column(
    [
      spacer(),
      row([spacer(), text(s"${count.get()}").textStyle(Title), spacer()]),
      row([spacer(), button(s"Add $step", () -> count.update(n -> n + step)).named("add"), spacer()]),
      spacer()
    ],
    16
  ).padding(24)

main(args: Vector[string]) -> int
  var frames = 0
  val shot = if args.length > 0 then args(0) else ""
  val build = root(() -> counter(1))
  // A frame is built for each call; a screenshot is the first, and the second ends the loop.
  val tree = () ->
    frames += 1
    if shot != ""
      if frames == 1 then saveFrame(shot) else stop()
      invalidate()
    build()
  run(app("Counter", tree, () -> 0x1E1E2E, width = 360, height = 240)) match
    Ok(_) -> 0
    Err(message) ->
      eprintln(message)
      1
