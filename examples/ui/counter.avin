// A window with a count and a button that adds one to it.
//
// The screen is a function of the count, built again on every frame after something has changed:
// the button's callback changes the count and calls `invalidate()`, which tells the frame loop to
// build it again. With an argument, the program writes its first frame to that PNG file and stops.
import ui.{Title, View, app, button, column, invalidate, row, run, saveFrame, spacer, stop, text}

var count = 0

screen() -> View =
    column([
        spacer(),
        row([spacer(), text(s"$count").textStyle(Title), spacer()]),
        row([spacer(), button("Add one", add).named("add"), spacer()]),
        spacer()
    ], 16).padding(24)

add()
    count += 1
    invalidate()

main(args: Vector[string]) -> int
    var frames = 0
    val shot = if args.length() > 0 then args(0) else ""
    // A frame is built for each call; a screenshot is the first, and the second ends the loop.
    val tree = () ->
        frames += 1
        if shot != ""
            if frames == 1 then saveFrame(shot) else stop()
            invalidate()
        screen()
    run(app("Counter", tree, () -> 0x1E1E2E, width = 360, height = 240)) match
        Ok(_) -> 0
        Err(message) ->
            eprintln(message)
            1
