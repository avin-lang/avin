// Counts the words of a text and lists the commonest, with a bar for each: a word is a run of
// letters, an apostrophe inside it kept (`don't`), and words are counted without regard to case
// unless asked otherwise. The text is standard input, or the files named on the command line.
//
//     avin build wordfreq && ./wordfreq --top 8 --skip-common < ../wordfreq.in
//
// expect: exit 0
// args: --top 8 --min-length 2
import avin.cli
import avin.fs
import avin.io

val parser = cli.Parser("wordfreq", "List the commonest words of a text.", version = "1.0")
  .int("top", short = 'n', help = "how many words to list", default = 10, value = "N")
  .int("min-length", help = "leave out words shorter than N letters", default = 1, value = "N")
  .flag("skip-common", short = 's', help = "leave out the commonest English words")
  .flag("keep-case", short = 'c', help = "count Word and word apart")
  .choice("format", ["table", "csv"], default = "table")
  .positionals("file", help = "the files to read; standard input when there are none")

// Words so common that a list of a text's words is better without them.
val common: Set[string] = {
  "a", "an", "and", "are", "as", "at", "be", "but", "by", "for", "from", "had", "has", "have", "he", "her", "his", "i",
  "in", "is", "it", "its", "my", "not", "of", "on", "or", "she", "so", "that", "the", "their", "them", "they", "this",
  "to", "was", "we", "were", "with", "you"
}

// The words of one line, in order.
words(line: string) -> Vector[string]
  var out = Vector.empty[string]()
  var word = ""
  for c in line.chars
    if c.isLetter || (c == '\'' && word.nonEmpty) then word = word + c.toString()
    else
      if word.nonEmpty then out = out :+ word.stripSuffix("'")
      word = ""
  if word.nonEmpty then out = out :+ word.stripSuffix("'")
  out

// A bar `width` cells wide at most, as long against `width` as `n` is against `most`.
bar(n: int, most: int, width: int = 30) -> string = "#".repeat(max(1, n * width / most))

main(args: Vector[string]) -> int
  val opts = parser.parseOrExit(args)
  val texts = opts.strings("file") match
    [] -> Vector(io.readAll())
    files -> files.map(f -> fs.readText(f).getOrElse(""))
  val fold = !opts.flag("keep-case")
  val minLength = opts.int("min-length")
  val skip = opts.flag("skip-common")
  val all = for
    text in texts
    line in text.lines
    w in words(line)
  yield if fold then w.toLower else w
  val kept = all.filter(w -> w.charCount >= minLength && !(skip && common(w.toLower)))
  val counts = kept.groupMapReduce(w -> w, _ -> 1, _ + _)
  // Commonest first; words counted alike in alphabetical order, so the list is the same every run.
  val ranked = counts.toVector.sortBy((w, n) -> (-n, w)).take(opts.int("top"))
  opts.string("format") match
    "csv" ->
      println("word,count")
      for (w, n) in ranked do println(s"$w,$n")
    _ ->
      println(s"${all.length} words, ${counts.size} distinct, ${kept.length} counted")
      val most = ranked.headOption.map(_.1).getOrElse(1)
      val wide = ranked.map(_.0.charCount).maxOption.getOrElse(4)
      for ((w, n), i) in ranked.zipWithIndex
        println(f"${i + 1}%3d. ${w.padEnd(wide)} $n%5d ${bar(n, most)}")
  0
