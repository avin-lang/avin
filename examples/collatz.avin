// The Collatz sequence: halve an even number, triple an odd one and add one, until reaching 1.
// The program finds the start below 1000 with the longest sequence:
//
//     avin build collatz.avin && ./collatz
//
// The values climb far above their start, so they are `long`; in `3 * n + 1` the literals take
// `n`'s type. Integer arithmetic that overflowed would stop the program, not wrap. `maxBy` finds
// the start whose sequence is longest; it is an `Option`, since a range may be empty.
//
// expect: exit 0

next(n: long) -> long = n % 2 match
    0 -> n / 2
    _ -> 3 * n + 1

steps(start: long) -> int
    var n = start
    var count = 0
    while n != 1 do
        n = next(n)
        count++
    count

main()
    println(s"27 reaches 1 in ${steps(27)} steps")
    val best = (1..<1000).maxBy(start -> steps(long(start))).getOrElse(1)
    println(s"below 1000, $best takes the most: ${steps(long(best))} steps")
