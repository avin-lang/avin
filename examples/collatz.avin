// The Collatz sequence: halve an even number, triple an odd one and add one, until reaching 1.
// The program finds the start below 1000 with the longest sequence (871) and exits with that
// sequence's number of steps:
//
//     avin build collatz.avin && ./collatz; echo $?        prints 178
//
// The values climb far above their start, so they are `i64`; in `3 * n + 1` the literals take
// `n`'s type. Integer arithmetic that overflowed would stop the program, not wrap.
//
// expect: exit 178

next(n: i64) -> i64 = n % 2 match
    0 -> n / 2
    _ -> 3 * n + 1

steps(start: i64) -> int
    var n = start
    var count = 0
    while n != 1 do
        n = next(n)
        count++
    count

main() -> int
    if steps(27) != 111 then return 255
    var longest = 0
    var start: i64 = 1
    while start < 1000 do
        val length = steps(start)
        if length > longest then longest = length
        start += 1
    longest
