// A list of things to do: a text field and a button to add one, a checkbox to mark each one done, a
// button to remove it, and a choice of which to show.
//
// The list is a state holding the items, and each item holds whether it is done in a state of its
// own, which its checkbox reads and writes. Each row is a component keyed by its item's id, so a
// row keeps what it remembers, here whether it is asking to confirm a removal, wherever the filter
// moves it. With an argument, the program writes its first frame to that PNG file and stops.
import ui.{Caption, Error, Outline, State, Title, View, app, button, checkbox, column, component, divider, invalidate, keyed, radioGroup, root, row, run, saveFrame, spacer, state, stop, text, textField}

class Item(val id: int, val label: string)
    val done = state(false)

// Which items the filter shows: all of them, those still to do, and those done.
val Filters = ["All", "Active", "Done"]

shows(filter: int, item: Item) -> bool = filter match
    1 -> !item.done.get()
    2 -> item.done.get()
    _ -> true

// One item: its checkbox, and a button that asks once and removes the item when tapped again.
entry(item: Item, remove: (Item) -> unit) -> View = keyed(item.id) c ->
    val confirming = c.state(false)
    val removal = if confirming.get()
        button("Sure?", () -> remove(item), Error).named(s"sure-${item.id}")
    else
        button("Remove", () -> confirming.set(true), variant = Outline).named(s"remove-${item.id}")
    row([checkbox(item.done, item.label).named(s"done-${item.id}"), spacer(), removal], 8)

todo(start: Vector[string]) -> View = component c ->
    val nextId = c.state(start.length)
    val items = c.state((0..<start.length).map(i -> Item(i, start(i))).toVector)
    val draft = c.state("")
    val filter = c.state(0)
    val add = () ->
        val label = draft.get().trim()
        if label != ""
            items.update(xs -> xs :+ Item(nextId.get(), label))
            nextId.update(n -> n + 1)
            draft.set("")
    val remove = (gone: Item) -> items.update(xs -> xs.filter(x -> x.id != gone.id))
    val left = c.derived(() -> items.get().count(x -> !x.done.get()))
    val shown = items.get().filter(x -> shows(filter.get(), x))
    column([
        text("To do").textStyle(Title),
        row([textField(draft, 1, width = 260, hint = "Something to do", onEnter = add).named("draft"), button("Add", add).named("add")], 8),
        radioGroup(Filters, filter).named("filter"),
        divider(),
        column(shown.map(x -> entry(x, remove)), 6),
        spacer(),
        text(s"$left left").textStyle(Caption)
    ], 12).padding(20)

main(args: Vector[string]) -> int
    var frames = 0
    val shot = if args.length > 0 then args(0) else ""
    val build = root(() -> todo(["Write the spec", "Build the layer", "Test every corner"]))
    // A frame is built for each call; a screenshot is the first, and the second ends the loop.
    val tree = () ->
        frames += 1
        if shot != ""
            if frames == 1 then saveFrame(shot) else stop()
            invalidate()
        build()
    run(app("To do", tree, () -> 0x1E1E2E, width = 480, height = 520)) match
        Ok(_) -> 0
        Err(message) ->
            eprintln(message)
            1
