// A window whose count another thread drives.
//
// The window runs on the main thread, and its state belongs to it. A lightweight thread counts a
// tick every tenth of a second and hands each to the window through an inbox: the inbox's handler,
// made on the main thread, sets the state, and the frame loop runs it at the start of a frame. The
// thread asks rather than sends, so it waits, parked, until the window has taken each tick. With an
// argument, the thread has the window write a frame to that PNG file after ten ticks and stop, and
// the program prints the count the window ended on.
import avin.threads.{sleep, spawn}
import avin.time.millis
import ui.{State, Title, View, app, column, component, inbox, post, root, row, run, saveFrame, spacer, state, stop, text}

shown(ticks: State[int]) -> View = component c ->
    column([
        spacer(),
        row([spacer(), text(s"${ticks.get()}").textStyle(Title), spacer()]),
        row([spacer(), text("ticks from another thread"), spacer()]),
        spacer()
    ], 16).padding(24)

main(args: Vector[string]) -> int
    val shot = if args.length > 0 then args(0) else ""
    val ticks = state(0)
    val tick = inbox((n: int) -> ticks.set(n))
    spawn(() ->
        var n = 0
        while shot == "" || n < 10
            sleep(millis(100))
            n += 1
            tick.ask(n)
        post(() ->
            saveFrame(shot)
            stop()))
    run(app("Ticker", root(() -> shown(ticks)), () -> 0x1E1E2E, width = 360, height = 240)) match
        Ok(_) ->
            if shot != "" then println(ticks.get())
            0
        Err(message) ->
            eprintln(message)
            1
