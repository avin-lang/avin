# arithmetic, with the usual precedence
1 + 2 * 3
(1 + 2) * 3
2 ^ 3 ^ 2
-2 ^ 2
2 ^ -1
7 % 3
-7 % 3
10 / 4

let r = 2.5
fn area(r) = pi * r ^ 2
area(r)
area(1) == pi
fn fact(n) = if n <= 1 then 1 else n * fact(n - 1)
fact(10)
fn fib(n) = if n < 2 then n else fib(n - 1) + fib(n - 2)
fib(20)
fn hyp(a, b) = sqrt(a ^ 2 + b ^ 2)
hyp(3, 4)
max(fact(5), 100) - min(1, 2)

