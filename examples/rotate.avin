// A generic function works for any type of value. `rotate` turns three values around a given number
// of times and returns the one in front. One multiple assignment does each turn: every value on the
// right is read before any place on the left changes, so nothing needs a temporary. Each call
// compiles its own copy, for strings, chars or integers.
//
//     avin build rotate.avin && ./rotate

rotate[T](a: T, b: T, c: T, turns: int) -> T
    var first, second, third = a, b, c
    var done = 0
    while done < turns do
        first, second, third = second, third, first
        done++
    first

main()
    print(rotate("north", "east", "south", 4))
    val letter = rotate('x', 'y', 'z', 2)
    if letter == 'z' then print("z comes round after two turns")
    if rotate(1, 2, 3, 3) == 1 then print("three turns come back to the start")
