// Conway's Game of Life on a board whose edges wrap around, so a glider that leaves on the right
// comes back on the left. The board is the set of its live cells: a generation counts, for every
// cell next to a live one, how many live neighbours it has, and keeps the cells with three, or with
// two that were already alive. Patterns are read from text, `#` for a live cell and `.` for a dead
// one, and every few generations the board is drawn the same way.
//
//     avin build main.avin && ./main
//
// expect: exit 0

data Cell(row: int, col: int)

class Board(val rows: int, val cols: int, val live: Set[Cell])
  // The eight cells around `c`, wrapping at the edges.
  neighbours(c: Cell) -> Vector[Cell] =
    for dr in -1 .. 1, dc in -1 .. 1 if (dr, dc) != (0, 0) yield Cell(wrap(c.row + dr, rows), wrap(c.col + dc, cols))

  next() -> Board
    val counts = live.toVector.flatMap(neighbours).groupMapReduce(c -> c, _ -> 1, _ + _)
    val born = for (cell, n) in counts if survives(n, live(cell)) yield cell
    Board(rows, cols, born.toSet)

  population -> int = live.size

  draw() -> string =
    (0 ..< rows).map(r -> (0 ..< cols).map(c -> if live(Cell(r, c)) then '#' else '.').mkString("")).mkString("\n")

// The rules of the game, as clauses: three neighbours give life, two keep it.
survives(neighbours: int, alive: bool) -> bool
survives(3, _) = true
survives(2, alive) = alive
survives(_, _) = false

// `n` brought into `0 ..< size`, for a coordinate that stepped off an edge.
wrap(n: int, size: int) -> int = ((n % size) + size) % size

// A pattern drawn in text, placed with its top left corner at `(top, left)`.
pattern(rows: int, cols: int, top: int, left: int, picture: Vector[string]) -> Board
  val cells = for
    (line, r) in picture.zipWithIndex
    (ch, c) in line.chars.zipWithIndex
    if ch == '#'
  yield Cell(top + r, left + c)
  Board(rows, cols, cells.toSet)

run(name: string, start: Board, generations: int, every: int)
  println(s"== $name ==")
  var board = start
  for g in 0 .. generations
    if g % every == 0
      println(s"generation $g, ${board.population} alive")
      println(board.draw())
    board = board.next()

main()
  run("blinker", pattern(5, 5, 2, 1, ["###"]), 2, 1)
  // A glider moves one cell diagonally every four generations; on an 8 by 8 board it is back where
  // it started after 32.
  val glider = pattern(8, 8, 0, 0, [".#.", "..#", "###"])
  run("glider", glider, 8, 4)
  var g = glider
  for _ in 0 ..< 32 do g = g.next()
  println(s"after 32 generations the glider is home: ${g.live == glider.live}")
  // The R-pentomino grows chaotically for a long time from five cells; here on a small torus.
  var r = pattern(16, 16, 6, 6, [".##", "##.", ".#."])
  val sizes = for _ in 0 ..< 40 yield
    r = r.next()
    r.population
  println(s"R-pentomino populations: ${sizes.mkString(" ")}")
