// Counts the primes below 1000 by trial division:
//
//     avin build primes.avin && ./primes        prints "168 primes below 1000"
//
// `isPrime` is a local function: it lives inside `countPrimes`, and `return` leaves it, not the
// function around it.
//
// expect: exit 0

countPrimes(limit: int) -> int
    isPrime(n: int) -> bool
        if n < 2 then return false
        var divisor = 2
        while divisor * divisor <= n do
            if n % divisor == 0 then return false
            divisor += 1
        true

    var count = 0
    var n = 2
    while n < limit do
        if isPrime(n) then count += 1
        n += 1
    count

main() = print(s"${countPrimes(1000)} primes below 1000")
