// Counts the primes below 1000 by trial division, and exits with the count:
//
//     avin build primes.avin && ./primes; echo $?        prints 168
//
// `is_prime` is a local function: it lives inside `count_primes`, and `return` leaves it, not the
// function around it.
//
// expect: exit 168

count_primes(limit: int) -> int
    is_prime(n: int) -> bool
        if n < 2 then return false
        var divisor = 2
        while divisor * divisor <= n do
            if n % divisor == 0 then return false
            divisor += 1
        true

    var count = 0
    var n = 2
    while n < limit do
        if is_prime(n) then count += 1
        n += 1
    count

main() -> int = count_primes(1000)
