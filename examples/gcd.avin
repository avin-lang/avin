// The greatest common divisor of 1071 and 462, by Euclid's algorithm, written three ways: with a
// loop and a multiple assignment, with clauses, and extended to find the Bézout coefficients `s`
// and `t` for which `a * s + b * t` is the divisor. `s"…"` writes values into text.
//
//     avin build gcd.avin && ./gcd
//
// expect: exit 0

gcd(a: int, b: int) -> int
    var x, y = a, b
    while y != 0
        x, y = y, x % y
    x

// A recursive function declares its result type; its signature carries it for every clause.
gcdRecursive(a: int, b: int) -> int
gcdRecursive(a, 0) = a
gcdRecursive(a, b) = gcdRecursive(b, a % b)

// The extended algorithm keeps two rows of the computation and replaces both at once, so each step
// is one line; the result is three values, written without parentheses.
extendedGcd(a: int, b: int) -> (int, int, int)
    var r0, r1 = a, b
    var s0, s1 = 1, 0
    var t0, t1 = 0, 1
    while r1 != 0
        val q = r0 / r1
        r0, r1 = r1, r0 - q * r1
        s0, s1 = s1, s0 - q * s1
        t0, t1 = t1, t0 - q * t1
    r0, s0, t0

main()
    print(s"gcd(1071, 462) = ${gcd(1071, 462)}")
    print(s"by clauses: ${gcdRecursive(1071, 462)}")
    val divisor, s, t = extendedGcd(1071, 462)
    print(s"1071 * $s + 462 * $t = ${1071 * s + 462 * t} = $divisor")
