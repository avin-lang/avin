// The greatest common divisor of 1071 and 462, by Euclid's algorithm, written twice: once with a
// loop and mutable locals, once recursively with `match`. Printing numbers arrives with the core
// library, so the program reports its answer as its exit status:
//
//     avin build gcd.avin && ./gcd; echo $?        prints 21
//
// expect: exit 21

gcd(a: int, b: int) -> int
    var x = a
    var y = b
    while y != 0 do
        val remainder = x % y
        x = y
        y = remainder
    x

// A recursive function declares its result type.
gcd_recursive(a: int, b: int) -> int = b match
    0 -> a
    _ -> gcd_recursive(b, a % b)

main() -> int
    val answer = gcd(1071, 462)
    if gcd_recursive(1071, 462) != answer then return 255
    answer
