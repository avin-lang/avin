// A `data` type describes values by their shapes. Here a small arithmetic language is a data type
// with a variant per kind of expression; `eval` computes an expression's value and `simplify`
// rewrites it, both by matching on the variants. Values like these live on the collected heap, and
// nothing is ever freed by hand. `Option` is generic, and the compiler checks every `match` covers
// all of a type's variants.
//
//     avin build expressions.avin && ./expressions
//
// expect: exit 0

data Expr
    Num(value: int)
    Var(name: string)
    Add(left: Expr, right: Expr)
    Mul(left: Expr, right: Expr)

data Option[+T]
    Some(value: T)
    None

// The value of `x` in this program; a lookup that knows only one variable.
lookup(name: string, x: int) -> Option[int] = if x >= 0 then Some(x) else None

eval(e: Expr, x: int) -> Option[int] = e match
    Num(n) -> Some(n)
    Var(name) -> lookup(name, x)
    Add(l, r) -> both(eval(l, x), eval(r, x), true)
    Mul(l, r) -> both(eval(l, x), eval(r, x), false)

both(a: Option[int], b: Option[int], add: bool) -> Option[int] = a match
    Some(m) -> b match
        Some(n) -> Some(if add then m + n else m * n)
        None -> None
    None -> None

// Removes additions of zero and multiplications by one or zero.
simplify(e: Expr) -> Expr = e match
    Add(l, r) -> tidy(Add(simplify(l), simplify(r)))
    Mul(l, r) -> tidy(Mul(simplify(l), simplify(r)))
    _ -> e

tidy(e: Expr) -> Expr = e match
    Add(Num(0), r) -> r
    Add(l, Num(0)) -> l
    Mul(Num(1), r) -> r
    Mul(l, Num(1)) -> l
    Mul(Num(0), _) -> Num(0)
    Mul(_, Num(0)) -> Num(0)
    _ -> e

describe(e: Expr) = e match
    Num(_) -> print("a number")
    Var(_) -> print("a variable")
    Add(_, _) -> print("a sum")
    Mul(_, _) -> print("a product")

main() -> int
    // (x + 0) * (1 * (3 + x))
    val e = Mul(Add(Var("x"), Num(0)), Mul(Num(1), Add(Num(3), Var("x"))))
    describe(e)
    val s = simplify(e)
    describe(s)
    s match
        Mul(Var(_), Add(Num(3), Var(_))) -> print("simplified to x * (3 + x)")
        _ -> return 1
    eval(s, 4) match
        Some(28) -> print("x = 4 gives 28")
        _ -> return 2
    if eval(s, -1) is Some(_) then return 3
    describe(simplify(Mul(Num(0), Var("y"))))
    0
