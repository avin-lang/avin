// A `data` type describes values by their shapes. Here a small arithmetic language is a data type
// with a variant per kind of expression; `eval` computes an expression's value and `simplify`
// rewrites it, both by matching on the variants, in a `match` or in a function's clauses. Values
// like these live on the collected heap, and nothing is ever freed by hand. A value that may be
// missing is an `Option`, `Some(n)` or `None`, and the compiler checks every `match`, and every set
// of clauses, covers all of a type's variants.
//
//     avin build expressions.avin && ./expressions
//
// expect: exit 0

data Expr
    Num(value: int)
    Var(name: string)
    Add(left: Expr, right: Expr)
    Mul(left: Expr, right: Expr)

// The value of `x` in this program; a lookup that knows only one variable.
lookup(name: string, x: int) -> Option[int] = if x >= 0 then Some(x) else None

// A function may be written as clauses: its signature, then one line per case.
eval(e: Expr, x: int) -> Option[int]
eval(Num(n), _) = Some(n)
eval(Var(name), x) = lookup(name, x)
eval(Add(l, r), x) = both(eval(l, x), eval(r, x), true)
eval(Mul(l, r), x) = both(eval(l, x), eval(r, x), false)

both(a: Option[int], b: Option[int], add: bool) -> Option[int]
both(Some(m), Some(n), add) = Some(if add then m + n else m * n)
both(_, _, _) = None

// An expression as text, fully parenthesized; `s"…"` writes each part into the text.
show(e: Expr) -> string
show(Num(n)) = s"$n"
show(Var(name)) = name
show(Add(l, r)) = s"(${show(l)} + ${show(r)})"
show(Mul(l, r)) = s"${show(l)} * ${show(r)}"

// Removes additions of zero and multiplications by one or zero.
simplify(e: Expr) -> Expr = e match
    Add(l, r) -> tidy(Add(simplify(l), simplify(r)))
    Mul(l, r) -> tidy(Mul(simplify(l), simplify(r)))
    _ -> e

tidy(e: Expr) -> Expr = e match
    Add(Num(0), r) -> r
    Add(l, Num(0)) -> l
    Mul(Num(1), r) -> r
    Mul(l, Num(1)) -> l
    Mul(Num(0), _) -> Num(0)
    Mul(_, Num(0)) -> Num(0)
    _ -> e

// A clause's guards are tried in order, and `| _` takes the rest.
describe(e: Expr)
describe(Num(n))
    | n < 0 = println("a negative number")
    | _ = println("a number")
describe(Var(_)) = println("a variable")
describe(Add(_, _)) = println("a sum")
describe(Mul(_, _)) = println("a product")

main() -> int
    // (x + 0) * (1 * (3 + x))
    val e = Mul(Add(Var("x"), Num(0)), Mul(Num(1), Add(Num(3), Var("x"))))
    println(show(e))
    describe(e)
    val s = simplify(e)
    describe(s)
    println(s"simplified to ${show(s)}")
    if !(s is Mul(Var(_), Add(Num(3), Var(_)))) then return 1
    eval(s, 4) match
        Some(n) -> println(s"x = 4 gives $n")
        None -> return 2
    if eval(s, -1) is Some(_) then return 3
    describe(simplify(Mul(Num(0), Var("y"))))
    0
