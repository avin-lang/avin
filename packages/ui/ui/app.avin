module ui

// syslui-sdl's application: a window, the frame loop and the events. The loop runs on the thread
// that calls `run`, and calls back on that thread only.

/// A window and what it shows, ready to `run`.
@sysl("sh.sysl.ui_sdl.App")
class App

/// An application titled `title`, whose interface is whatever `tree` builds, on a window cleared to
/// the colour `ground` answers, `0xRRGGBB`, and asking for `width` by `height` points. `tree` is
/// called again on every frame after a signal has been written or `invalidate()` called.
@sysl("sh.sysl.ui_sdl.app")
app(title: string, tree: () -> View, ground: () -> long, width: int = 900, height: int = 660) -> App

/// Open the window and run its frame loop until the window is closed or `stop()` is called. Answers
/// SDL's own sentence where the window or its renderer could not be made.
@sysl("sh.sysl.ui_sdl.run", blocking)
run(a: App) -> Result[unit, string]

/// End the frame loop after the frame it is in.
@sysl("sh.sysl.ui_sdl.stop")
stop()

/// Retitle the running window; `false` when none is running or SDL refused.
@sysl("sh.sysl.ui_sdl.set_title")
setTitle(title: string) -> bool

/// Write the next finished frame to the PNG file `file`.
@sysl("sh.sysl.ui_sdl.save_frame")
saveFrame(file: string)
