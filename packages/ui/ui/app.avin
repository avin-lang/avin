module ui

// syslui-sdl's application: a window, the frame loop and the events. The window and its loop run on
// the main thread, and call back on that thread only; the loop runs the work other threads hand it
// (`posted.avin`) at the start of every frame.

import avin.threads.isMainThread

/// A window and what it shows, ready to `run`.
@sysl("sh.sysl.ui_sdl.App")
class App

// An event the window was sent, which the application leaves to the loop's own handling.
@sysl("sh.sysl.sdl3.Event")
private class Event

@sysl("sh.sysl.ui_sdl.app")
private appOf(title: string, tree: () -> View, ground: () -> long, width: int, height: int, onEvent: Event -> bool, font: string, size: real, onFrame: real -> unit) -> App

/// An application titled `title`, whose interface is whatever `tree` builds, on a window cleared to
/// the colour `ground` answers, `0xRRGGBB`, and asking for `width` by `height` points. `tree` is
/// called again on every frame after a signal has been written or `invalidate()` called.
app(title: string, tree: () -> View, ground: () -> long, width: int = 900, height: int = 660) -> App =
    appOf(title, tree, ground, width, height, e -> false, "", 15.0, frameStarted)

// What the frame loop runs at the start of every frame, `dt` seconds after the last began: the work
// waiting for the main thread, before the loop decides whether to build the tree again, so what that
// work writes is built in the same frame.
private frameStarted(dt: real)
    handlePosted()

@sysl("sh.sysl.ui_sdl.run", blocking)
private runLoop(a: App) -> Result[unit, string]

/// Open the window and run its frame loop until the window is closed or `stop()` is called, then run
/// the work still waiting for the main thread. Answers SDL's own sentence where the window or its
/// renderer could not be made. The window runs on the main thread; called on another, `run` stops
/// the program.
run(a: App) -> Result[unit, string]
    if !isMainThread() then fail("a window runs on the main thread, and `run` was called on another")
    val ran = runLoop(a)
    handlePosted()
    ran

/// End the frame loop after the frame it is in.
@sysl("sh.sysl.ui_sdl.stop")
stop()

/// Retitle the running window; `false` when none is running or SDL refused.
@sysl("sh.sysl.ui_sdl.set_title")
setTitle(title: string) -> bool

/// Write the next finished frame to the PNG file `file`.
@sysl("sh.sysl.ui_sdl.save_frame")
saveFrame(file: string)
