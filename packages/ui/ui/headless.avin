module ui

// Drawing a tree with no window: syslui's recording canvas, which lays a tree out against a fixed
// font and writes down what it drew, and the snapshot that names what is on screen and where to tap
// it. This is how a program checks its interface without a display.

/// A rectangle, in points.
@sysl("sh.sysl.ui.Rect")
data Rect(x: int, y: int, w: int, h: int)

/// A canvas that draws nothing and records every operation, with a font `charW` wide a byte and
/// `lineH` tall at the size `size`. It is also the pointer a test presses and lets go of.
@sysl("sh.sysl.ui.Recorder")
class Recorder
  /// Move the pointer to `(x, y)`, held down or not.
  point(x: int, y: int, down: bool = false)
  /// Let the pointer go at `(x, y)`: a press and a release at one place is a tap.
  release(x: int, y: int)
  /// What was drawn, one operation a line.
  dump() -> string

/// A new recording canvas.
@sysl("sh.sysl.ui.recorder")
recorder(charW: int = 8, lineH: int = 16, size: real = 16.0) -> Recorder

/// Lay `v` out in `at` and draw it on `c`, and what it raises above itself after it.
@sysl("sh.sysl.ui.render")
render(v: View, c: Recorder, at: Rect)

/// Why a key reaches nothing to tap.
@sysl("sh.sysl.ui.MissKind")
data MissKind
  Unknown
  Duplicate
  Covered

/// A key that reaches nothing to tap, and the sentence that says why.
@sysl("sh.sysl.ui.Missed")
data Missed(kind: MissKind, message: string)

/// What a tree put on screen: every control, its role, its words, its name and its place.
@sysl("sh.sysl.ui.Snapshot")
class Snapshot
  /// How many things are on screen.
  len() -> long
  /// One line a thing, indented by its depth.
  dump() -> string
  /// The same, as JSON.
  toJson() -> string
  /// Where to tap to reach the control named `key`, or the reference `@n`.
  clickPoint(key: string) -> Result[(int, int), Missed]

/// What `v` puts on screen laid out in `at`, measured with `c`'s font.
@sysl("sh.sysl.ui.snapshot")
snapshot(v: View, c: Recorder, at: Rect) -> Snapshot

/// Draw `v` in `at` on a new recording canvas, and tap the control `key` names, as a press and a
/// release at the centre of what of it is visible, with a frame drawn while it is pressed, so a
/// control that follows the pointer while it is held, a slider, moves to it.
tap(v: View, key: string, at: Rect) -> Result[unit, Missed]
  val c = recorder()
  render(v, c, at)
  val (x, y) = snapshot(v, c, at).clickPoint(key)?
  c.point(x, y, true)
  render(v, c, at)
  c.release(x, y)
  Ok(())
