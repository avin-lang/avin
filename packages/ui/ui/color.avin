module ui

// Colours. A colour is an `int` holding `0xRRGGBB`, as syslui draws it: a hex literal is one, and
// there is no alpha, since nothing in the toolkit composites. A negative colour, which syslui's
// unsigned colour cannot hold, stops the program where it was passed.

/// The colour of the channels `r`, `g` and `b`, each from 0 to 255; a channel outside that range
/// stops the program.
rgb(r: int, g: int, b: int) -> int = (int(byte(r)) << 16) | (int(byte(g)) << 8) | int(byte(b))

/// `a` moved toward `b` by `pct` percent, channel by channel: 0 is `a`, 100 is `b`, and a percentage
/// outside that range is taken as the nearer end.
@sysl("sh.sysl.ui.mix")
mix(a: int, b: int, pct: int) -> int

/// `c` moved toward white by `pct` percent.
@sysl("sh.sysl.ui.lighten")
lighten(c: int, pct: int) -> int

/// `c` moved toward black by `pct` percent.
@sysl("sh.sysl.ui.darken")
darken(c: int, pct: int) -> int
