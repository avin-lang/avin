module ui

import avin.collections.mutable.{Map as MutableMap}

// Components and the state they keep, written in Avin over the views and signals of the binding.
// A component is a function building a view from its arguments; the state it shows lives in `State`
// objects, which ask for a new build when they are set. A component that keeps state of its own
// across builds asks its `Scope` for it, by the order it asks in, and the scope is found again on
// the next build by the component's place among its parent's components, or by its key.

/// A value an interface shows. Setting it asks the frame loop for a new build, as `invalidate()`
/// does, so whatever reads it is built again with the new value. A state belongs to the thread that
/// runs the interface: it is mutable, so it is not sendable, and no other thread is handed it.
class State[T](private var held: T)
  private var through: Option[(() -> T, (T) -> unit)] = None
  private var handle: Option[Any] = None

  /// The value.
  get() -> T = through match
    Some((read, _)) -> read()
    None -> held

  /// Replace the value with `v`: one write, which the frame loop builds again after.
  set(v: T)
    through match
      Some((_, write)) -> write(v)
      None ->
        held = v
        invalidate()

  /// Replace the value with `f` of it.
  update(f: (T) -> T) = set(f(get()))

object State
  /// The signal a control reads and writes `s` through. It is made on the first call, holding
  /// `s`'s value, and from then on it is where the value lives, so a control's write is `s`'s
  /// new value at once and a `set` is the signal's.
  signal(s: State[int]) -> IntSignal = link(s, intSignal, g -> g.read(), (g, v) -> g.set(v))

  /// The signal a control reads and writes `s` through.
  signal(s: State[real]) -> RealSignal = link(s, realSignal, g -> g.read(), (g, v) -> g.set(v))

  /// The signal a control reads and writes `s` through.
  signal(s: State[bool]) -> BoolSignal = link(s, boolSignal, g -> g.read(), (g, v) -> g.set(v))

  /// The signal a control reads and writes `s` through.
  signal(s: State[string]) -> StringSignal = link(s, stringSignal, g -> g.read(), (g, v) -> g.set(v))

  private link[T, S](s: State[T], make: (T) -> S, read: (S) -> T, write: (S, T) -> unit) -> S
    s.handle match
      Some(g: S) -> g
      _ ->
        val g = make(s.held)
        s.through = Some((() -> read(g), v -> write(g, v)))
        s.handle = Some(g)
        g

/// A new state holding `v`, kept wherever the program keeps it.
state[T](v: T) -> State[T] = State(v)

/// A value computed from others by `f`, again whenever something has been written since it was last
/// computed (a state, a signal, `invalidate()`), and otherwise kept.
class Derived[T](private val f: () -> T)
  private var value: Option[T] = None
  private var at = 0

  /// The value, computed now if anything has been written since it last was.
  get() -> T = value match
    Some(v) if at == writes() -> v
    _ ->
      val v = f()
      value = Some(v)
      at = writes()
      v

/// A value computed by `f`, and again only after something has been written.
derived[T](f: () -> T) -> Derived[T] = Derived(f)

/// What a component keeps from one build to the next: values it asks for in the order it asks for
/// them, during its own build.
class Scope(private val node: Node)
  /// The value `make` makes, made on the component's first build and the same value on every one
  /// after, for the component's `n`th request where this is its `n`th.
  remember[T](make: -> T) -> T
    val n = node
    if !n.open then fail("a component's scope was asked for a value outside the component's build")
    val i = n.used
    n.used += 1
    if i < n.slots.length
      n.slots(i) match
        kept: T -> kept
        _ -> fail("a component asked for the values it keeps in a different order from its last build")
    else
      val made = make
      n.slots.append(made)
      made

  /// A state holding `init` on the component's first build, kept across the builds after.
  state[T](init: -> T) -> State[T] = remember(State(init))

  /// A value computed by `f`, kept across builds and computed again after something is written.
  derived[T](f: () -> T) -> T = remember(Derived(f)).get()

// A component's place in the tree: what it keeps, and the components built inside it, by key.
private class Node(val builds: Builds)
  val slots = Buffer[Any]()
  var used = 0
  val children = MutableMap[string, Node]()
  var unkeyed = 0
  var built = -1
  var open = false

// The count of builds of one root, which says whether a node has been built in the current one.
private class Builds
  var current = 0

// The components being built, innermost last.
private val building = Buffer[Node]()

/// The function the frame loop calls for the tree, building `body` as the root of a tree of
/// components: each call is one build, and after it the state of every component it did not build
/// is gone.
root(body: () -> View) -> () -> View
  val top = Node(Builds())
  () ->
    if top.open then fail("a root was built again inside its own build")
    top.builds.current += 1
    enter(top, body)

/// A component: the view `body` builds with the component's scope. It is found again on the next
/// build by its place among the components its parent builds without a key.
component(body: (Scope) -> View) -> View
  val parent = innermost()
  val key = s"#${parent.unkeyed}"
  parent.unkeyed += 1
  child(parent, key, body)

/// A component found again on the next build by `key`, wherever among its parent's components it is
/// built; two components under one parent may not share a key.
keyed(key: string, body: (Scope) -> View) -> View = child(innermost(), "=" + key, body)

/// A component found again by the key `key`, written as a string.
keyed(key: int, body: (Scope) -> View) -> View = keyed(s"$key", body)

private innermost() -> Node
  if building.isEmpty then fail("a component was built outside the build of a root")
  building(building.length - 1)

private child(parent: Node, key: string, body: (Scope) -> View) -> View
  val n = parent.children.getOrElseUpdate(key, Node(parent.builds))
  if n.built == parent.builds.current then fail(s"two components built under one parent have the key '${key.drop(1)}'")
  enter(n, () -> body(Scope(n)))

private enter(n: Node, body: () -> View) -> View
  n.used = 0
  n.unkeyed = 0
  n.built = n.builds.current
  n.open = true
  building.append(n)
  val v = body()
  building.remove(building.length - 1)
  n.open = false
  n.children.filterInPlace((_, c) -> c.built == n.builds.current)
  v

// The controls over states: each takes the state's signal, `State.signal(s)`, so the control's
// writes are the state's value and a `set` of the state is what the control shows.

/// A switch over `on`.
switch(on: State[bool], role: Role = Primary) -> View = switch(State.signal(on), role)

/// A box and its label over `on`.
checkbox(on: State[bool], label: string, role: Role = Primary) -> View = checkbox(State.signal(on), label, role)

/// One option of a group over `chosen`: tapping it makes `chosen` hold `at`.
radio(
    chosen: State[int],
    at: int,
    label: string,
    role: Role = Primary
) -> View = radio(State.signal(chosen), at, label, role)

/// A column of options over `chosen`, one for each label, by index.
radioGroup(
    labels: Vector[string],
    chosen: State[int],
    role: Role = Primary,
    spacing: int = 6
) -> View = radioGroup(labels, State.signal(chosen), role, spacing)

/// A slider over the whole numbers from `lo` to `hi` over `value`.
slider(
    value: State[int],
    lo: int,
    hi: int,
    width: int,
    step: int = 0,
    role: Role = Primary,
    id: int = 0
) -> View = slider(State.signal(value), lo, hi, width, step, role, id)

/// A slider over the reals from `lo` to `hi` over `value`.
slider(
    value: State[real],
    lo: real,
    hi: real,
    width: int,
    step: real = 0.0,
    role: Role = Primary,
    id: int = 0
) -> View = slider(State.signal(value), lo, hi, width, step, role, id)

/// One line of editable text over `text`, focused by its nonzero `id`.
textField(
    text: State[string],
    id: int,
    width: int = 200,
    hint: string = "",
    onEnter: () -> unit = () -> (),
    onEscape: () -> unit = () -> ()
) -> View = textField(State.signal(text), id, width, hint, onEnter, onEscape)

/// Several lines of editable text over `text`, `rows` tall.
textArea(
    text: State[string],
    id: int,
    width: int = 320,
    rows: int = 5,
    hint: string = "",
    onEscape: () -> unit = () -> ()
) -> View = textArea(State.signal(text), id, width, rows, hint, onEscape)

/// Tab headers over `chosen`, and below them the view `body` answers for the chosen index.
tabs(labels: Vector[string], chosen: State[int], body: (int) -> View) -> View = tabs(labels, State.signal(chosen), body)

/// `child` in a window `height` tall, scrolled down by `offset`.
scroll(child: View, offset: State[int], height: int) -> View = scroll(child, State.signal(offset), height)
