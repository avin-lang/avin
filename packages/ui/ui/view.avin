module ui

// The view tree: syslui's `View` trait held as a handle, the leaves and containers that make one,
// and the modifiers that wrap one view in another.

/// A node of the view tree. Every modifier answers a new view wrapping this one, so a chain reads
/// left to right from the innermost view out: `text("hi").padding(8).panel()`.
@sysl("sh.sysl.ui.View")
class View
    /// Inset by `n` on every side.
    padding(n: int) -> View
    /// Inset on the sides named, and nowhere else.
    pad(top: int = 0, right: int = 0, bottom: int = 0, left: int = 0) -> View
    /// Inset by the theme's padding on every side.
    padded() -> View
    /// Put this on a surface, as the theme draws one.
    panel() -> View
    /// Fill the rectangle behind this with `color`, a `0xRRGGBB`, its corners rounded by `radius`.
    background(color: int, radius: int = 0) -> View
    /// Outline this in `color`, `width` thick, inside the rectangle it was given, so nothing moves;
    /// corners rounded by `radius`, and dashes `dash` long where `dash` is not zero.
    border(color: int, width: int = 1, radius: int = 0, dash: int = 0) -> View
    /// Draw the text inside this in `color`.
    foreground(color: int) -> View
    /// The controls inside this in `color` where they name no role: the theme's primary colour.
    tinted(color: int) -> View
    /// Measure and draw the text inside at one of the theme's sizes.
    textStyle(style: TextStyle) -> View
    /// Measure and draw the text inside at `pt` points.
    fontSize(pt: real) -> View
    /// Ask for exactly `w` by `h`, whatever this view would have measured to.
    frame(w: int, h: int) -> View
    /// Take `n` shares of what a column has left over in height, or a row in width. The last link of
    /// a chain.
    flex(n: int = 1) -> View
    /// How many shares of the leftover this view asks for: zero but for a spacer and `flex`.
    weight() -> int
    /// Take `span` of a grid's columns, after skipping `offset`. The last link of a chain.
    cell(span: int, offset: int = 0) -> View
    /// Call `f` when this view is tapped.
    onTap(f: () -> unit) -> View
    /// A stable name, which a snapshot reports and a tap by key finds.
    named(name: string) -> View

/// One run of text.
@sysl("sh.sysl.ui.text")
text(s: string) -> View

/// A gap that takes a share of the room its column or row has left over.
@sysl("sh.sysl.ui.spacer")
spacer() -> View

/// Children stacked top to bottom, `spacing` apart.
@sysl("sh.sysl.ui.column")
column(children: Vector[View], spacing: int = 0) -> View

/// Children side by side, left to right, `spacing` apart.
@sysl("sh.sysl.ui.row")
row(children: Vector[View], spacing: int = 0) -> View

/// Children on a grid of columns, each taking the span its `cell` gives it.
@sysl("sh.sysl.ui.grid")
grid(children: Vector[View]) -> View

/// `child` in a window `height` tall, scrolled down by `offset`.
@sysl("sh.sysl.ui.scroll")
scroll(child: View, offset: IntSignal, height: int) -> View

/// A line across its container, `thickness` thick.
@sysl("sh.sysl.ui.divider")
divider(thickness: int = 1) -> View

/// The theme's named text sizes.
@sysl("sh.sysl.ui.TextStyle")
data TextStyle
    Display
    Title
    Body
    Caption

/// Which of the theme's colours a control takes.
@sysl("sh.sysl.ui.Role")
data Role
    Primary
    Secondary
    Accent
    Success
    Warning
    Error

/// How a control wears its colour.
@sysl("sh.sysl.ui.Variant")
data Variant
    Filled
    Outline
    Dashed
    Soft
