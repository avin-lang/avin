module ui

// syslui's controls. Each one that holds a value reads and writes a signal of the application's;
// each one that acts calls an Avin function when it is tapped.

/// A labelled control that calls `onTap` when it is tapped.
@sysl("sh.sysl.ui.button")
button(label: string, onTap: () -> unit, role: Role = Primary, variant: Variant = Filled) -> View

/// A switch over `on`.
@sysl("sh.sysl.ui.switch")
switch(on: BoolSignal, role: Role = Primary) -> View

/// A box and its label over `on`; tapping either flips it.
@sysl("sh.sysl.ui.checkbox")
checkbox(on: BoolSignal, label: string, role: Role = Primary) -> View

/// One option of a group over `chosen`: tapping it makes `chosen` hold `at`.
@sysl("sh.sysl.ui.radio")
radio(chosen: IntSignal, at: int, label: string, role: Role = Primary) -> View

/// A column of options over `chosen`, one for each label, by index.
@sysl("sh.sysl.ui.radio_group")
radioGroup(labels: Vector[string], chosen: IntSignal, role: Role = Primary, spacing: int = 6) -> View

/// A slider over the whole numbers from `lo` to `hi`, inclusive, `width` wide, in multiples of
/// `step` from `lo`; a step of zero moves by one. Given an `id` other than zero, the arrows, Home and
/// End move it once it has been tapped.
@sysl("sh.sysl.ui.slider")
slider(value: IntSignal, lo: int, hi: int, width: int, step: int = 0, role: Role = Primary, id: int = 0) -> View

/// A slider over the reals from `lo` to `hi`, inclusive, `width` wide, in multiples of `step` from
/// `lo`; a step of zero moves continuously.
@sysl("sh.sysl.ui.slider")
slider(value: RealSignal, lo: real, hi: real, width: int, step: real = 0.0, role: Role = Primary, id: int = 0) -> View

/// A bar `width` wide, filled to `fraction`, from 0.0 to 1.0.
@sysl("sh.sysl.ui.progress")
progress(fraction: real, width: int, role: Role = Primary) -> View

/// A needle at `value` on a scale from `lo` to `hi`, `width` wide; `band` either side of `target`
/// is marked as right.
@sysl("sh.sysl.ui.meter")
meter(value: real, lo: real, hi: real, width: int, band: real = 0.0, target: real = 0.0, role: Role = Primary) -> View

/// One line of editable text over `text`, focused by its `id`, which is not zero. `onEnter` runs on
/// Enter and `onEscape` on Escape.
@sysl("sh.sysl.ui.text_field")
textField(text: StringSignal, id: int, width: int = 200, hint: string = "", onEnter: () -> unit = () -> (), onEscape: () -> unit = () -> ()) -> View

/// Several lines of editable text over `text`, `rows` tall; Enter is a new line.
@sysl("sh.sysl.ui.text_area")
textArea(text: StringSignal, id: int, width: int = 320, rows: int = 5, hint: string = "", onEscape: () -> unit = () -> ()) -> View

/// A row of tab headers over `chosen`, and below them the view `body` answers for the chosen index.
@sysl("sh.sysl.ui.tabs")
tabs(labels: Vector[string], chosen: IntSignal, body: (int) -> View) -> View
