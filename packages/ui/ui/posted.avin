module ui

// Work for the main thread. The interface runs on the main thread and its state belongs to it, so a
// lightweight thread changes the interface by handing the main thread something to do: a message for
// an inbox, whose handler the main thread made and runs, or a sendable piece of work posted. The
// frame loop handles everything waiting at the start of every frame, in the order it was sent.

import avin.collections.mutable.{Map as MutableMap}
import avin.threads.{Channel, Future, Promise, isMainThread}

// The inbox each message and piece of work waits in, in the order they were sent from every thread:
// an inbox's number, or `Posted` for posted work.
private val order = Channel[int]()

// Work posted with `post`, in the order it was posted.
private val posted = Channel[@sendable () -> unit]()

// The number that stands for posted work in `order`; inboxes count from 1.
private val Posted = 0

// What hands each inbox's next message to its handler, by the inbox's number. Only the main thread
// makes inboxes and handles their messages, so only it reaches this.
private val handlers = MutableMap[int, () -> unit]()
private var inboxes = 0

// An inbox's queue, which only the package names: a message and the promise of its answer, for each
// message sent.
private class Mailbox[T: Sendable, R: Sendable](val number: int, val queue: Channel[(T, Promise[R])])

/// Messages for the main thread: any thread sends a message of type `T`, and the handler `inbox` was
/// given handles it on the main thread, with the interface's state in reach, answering an `R`. Made
/// by `inbox`, on the main thread; an inbox is sendable, so threads are handed it.
class Inbox[T: Sendable, R: Sendable](private val box: Mailbox[T, R])
    /// Queues `message` for the handler and answers at once the future of its answer. The main thread
    /// handles it at the start of the next frame, after everything sent before it.
    send(message: T) -> Future[R]
        val reply = Promise[R]()
        box.queue.send((message, reply))
        order.send(box.number)
        reply.future

    /// Queues `message` and waits for the handler's answer. A lightweight thread parks while it waits,
    /// freeing its worker. On the main thread, which handles the message itself, the wait would never
    /// end, so there it stops the program.
    ask(message: T) -> R
        if isMainThread() then fail("an inbox was asked from the main thread, which would wait for itself to handle the message")
        send(message).await()

impl[T: Sendable, R: Sendable] Sendable for Inbox[T, R]

/// An inbox whose messages `handle` handles on the main thread. Made on the main thread only, since
/// the handler runs there with whatever it captures; made on another, it stops the program. An inbox
/// lasts as long as the program.
inbox[T: Sendable, R: Sendable](handle: (T) -> R) -> Inbox[T, R]
    if !isMainThread() then fail("an inbox is made on the main thread, which runs its handler, and was made on another")
    inboxes += 1
    val box = Mailbox[T, R](inboxes, Channel[(T, Promise[R])]())
    handlers.update(box.number, () -> box.queue.tryReceive() match
        Some((message, reply)) -> reply.complete(handle(message))
        None -> fail("an inbox's number was queued with no message waiting"))
    Inbox(box)

/// Queues `work` to run on the main thread at the start of the next frame, after everything sent
/// before it, and returns at once. Any thread may post, the main thread included.
post(@sendable work: () -> unit)
    posted.send(work)
    order.send(Posted)

/// Runs on the main thread every message and piece of work waiting when it is called, in the order
/// they were sent, and answers how many it ran. What they send or post meanwhile waits for the next
/// call. The frame loop calls it at the start of every frame and once more when it ends; a program
/// with no window calls it itself. Called on another thread, it stops the program.
handlePosted() -> int
    if !isMainThread() then fail("posted work runs on the main thread, and `handlePosted` was called on another")
    val due = Buffer[int]()
    var draining = true
    while draining
        order.tryReceive() match
            Some(number) -> due.append(number)
            None -> draining = false
    for number in due do handleOne(number)
    due.length

// Runs the next message or piece of work waiting in the inbox `number`, or the next posted one.
private handleOne(number: int)
    if number == Posted
        posted.tryReceive() match
            Some(work) -> work()
            None -> fail("posted work was queued with none waiting")
    else
        handlers.get(number) match
            Some(hand) -> hand()
            None -> fail("a message was queued for an inbox that does not exist")
