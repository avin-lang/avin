module ui

// syslui's signals: the values its controls read and write. One class for each instance of
// `Signal[T]` a control takes. Every write moves the counter `writes()` answers, and the frame loop
// builds the tree again on the next frame after it has moved.

/// A whole number a control reads and writes: a slider's value, a radio group's choice, a scroll
/// offset, a tab's index.
@sysl("sh.sysl.ui.Signal[int]")
class IntSignal
    read() -> int
    set(v: int)

/// A real number a control reads and writes: a continuous slider's value.
@sysl("sh.sysl.ui.Signal[real]")
class RealSignal
    read() -> real
    set(v: real)

/// A flag a control reads and writes: a switch, a checkbox, whether a popover is open.
@sysl("sh.sysl.ui.Signal[bool]")
class BoolSignal
    read() -> bool
    set(v: bool)

/// Text a control reads and writes: a text field's contents.
@sysl("sh.sysl.ui.Signal[string]")
class StringSignal
    read() -> string
    set(v: string)

/// A new signal holding `v`.
@sysl("sh.sysl.ui.signal")
intSignal(v: int) -> IntSignal

/// A new signal holding `v`.
@sysl("sh.sysl.ui.signal")
realSignal(v: real) -> RealSignal

/// A new signal holding `v`.
@sysl("sh.sysl.ui.signal")
boolSignal(v: bool) -> BoolSignal

/// A new signal holding `v`.
@sysl("sh.sysl.ui.signal")
stringSignal(v: string) -> StringSignal

/// How many writes have happened, to any signal or through `invalidate()`. The frame loop builds
/// the tree again whenever this has moved since the last frame.
@sysl("sh.sysl.ui.writes")
writes() -> int

/// Ask for the tree to be built again on the next frame, for state kept outside signals.
@sysl("sh.sysl.ui.invalidate")
invalidate()
