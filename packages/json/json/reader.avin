module json

// Reads JSON text a token at a time, for a decoder: it opens an object or an array, asks for the next
// key or element, and reads each value at the type it expects, so no tree of the document is made.
// Each method skips the white space before its token, and an error names the line and column of the
// token at fault. Arrays and objects may nest `maxDepth` deep, counted as `parse` counts them.
class JsonReader(text: string, maxDepth: int = defaultMaxDepth)
    private val tokens: Reader = Reader(text, maxDepth)

    // Opens an object, or fails where the next value is not one.
    beginObject() -> Result[unit, JsonError] = tokens.beginObjectToken()

    // The next key of the object being read, its colon read too, or None where the object ends.
    nextKey() -> Result[Option[string], JsonError] = tokens.keyToken()

    // Opens an array, or fails where the next value is not one.
    beginArray() -> Result[unit, JsonError] = tokens.beginArrayToken()

    // Whether another element of the array being read follows; false where the array ends.
    nextElement() -> Result[bool, JsonError] = tokens.elementToken()

    // Whether the next value is `null`, read where it is and left where it is not.
    takeNull() -> bool = tokens.nullToken()

    readString() -> Result[string, JsonError] = tokens.stringToken()

    readBool() -> Result[bool, JsonError] = tokens.boolToken()

    // A number that is a whole number within a `long`'s range, written plainly or as `3.0` or `1e3`.
    readLong() -> Result[long, JsonError]
        val number = tokens.numberToken()?
        number.asLong() match
            Some(n) -> Ok(n)
            None -> Err(error(s"the number $number is not a whole number within a long's range"))

    // A number that is a whole number within an `int`'s range.
    readInt() -> Result[int, JsonError]
        val number = tokens.numberToken()?
        number.asInt() match
            Some(n) -> Ok(n)
            None -> Err(error(s"the number $number is not a whole number within an int's range"))

    // A number, a whole one rounded to the nearest `real`.
    readReal() -> Result[real, JsonError] = tokens.numberToken().map(number -> number.asReal().get())

    // The next value whole, of any kind.
    readJson() -> Result[Json, JsonError] = tokens.valueToken()

    // Reads past the next value, of any kind.
    skipValue() -> Result[unit, JsonError] = tokens.valueToken().map(_ -> ())

    // Fails where anything but white space follows the value read.
    end() -> Result[unit, JsonError] = tokens.endToken()

    // The error `message` at the start of the last token read, with an empty path.
    error(message: string) -> JsonError = tokens.errorHere(message)
