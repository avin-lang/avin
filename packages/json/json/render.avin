module json

// `value` written as JSON to `out`. With `indent` 0 the text is compact; otherwise each element and
// member is on its own line, `indent` spaces deeper per level, starting from `depth` levels in.
// With `ascii`, every character outside ASCII is written as a `\u` escape.
private writeJson(out: Writer, value: Json, indent: int, depth: int, ascii: bool)
    value match
        Null -> out.write("null")
        Bool(b) -> out.write(if b then "true" else "false")
        Long(n) -> out.writeInt(n)
        Real(x) -> writeReal(out, x)
        Str(s) -> writeQuoted(out, s, ascii)
        Arr(items) ->
            if items.isEmpty then return out.write("[]")
            out.writeChar('[')
            var first = true
            for item in items
                if !first then out.writeChar(',')
                first = false
                newLine(out, indent, depth + 1)
                writeJson(out, item, indent, depth + 1, ascii)
            newLine(out, indent, depth)
            out.writeChar(']')
        Obj(members) ->
            if members.isEmpty then return out.write("{}")
            out.writeChar('{')
            var first = true
            for (key, item) in members
                if !first then out.writeChar(',')
                first = false
                newLine(out, indent, depth + 1)
                writeQuoted(out, key, ascii)
                out.writeChar(':')
                if indent > 0 then out.writeChar(' ')
                writeJson(out, item, indent, depth + 1, ascii)
            newLine(out, indent, depth)
            out.writeChar('}')

// A line break and `depth` levels of indentation, in the indented form only.
private newLine(out: Writer, indent: int, depth: int)
    if indent == 0 then return
    out.writeChar('\n')
    out.writeSpaces(long(indent) * long(depth))

// `s` as a JSON string: quoted, with the quote, the backslash and every control character escaped,
// and, with `ascii`, every character outside ASCII as a `\u` escape (a surrogate pair beyond U+FFFF).
// A run of characters needing no escape is written as one slice.
quote(s: string, ascii: bool = false) -> string
    val out = StringWriter()
    writeQuoted(out, s, ascii)
    out.text

private writeQuoted(out: Writer, s: string, ascii: bool)
    out.writeChar('"')
    val n = s.byteLength
    var start = 0
    var i = 0
    while i < n
        val b = int(s.byteAt(i))
        if int(' ') <= b < 0x80 && b != int('"') && b != int('\\')
            i += 1
        else if b >= 0x80 && !ascii
            i += 1
        else
            if start < i then out.write(s.slice(start, i))
            if b >= 0x80
                val c = s.charAt(i)
                val code = int(c)
                if code > 0xffff
                    val v = code - 0x10000
                    writeEscape(out, 0xd800 + (v >> 10))
                    writeEscape(out, 0xdc00 + (v & 0x3ff))
                else
                    writeEscape(out, code)
                i += c.toString().byteLength
            else
                char(b) match
                    '"' -> out.write("\\\"")
                    '\\' -> out.write("\\\\")
                    '\n' -> out.write("\\n")
                    '\r' -> out.write("\\r")
                    '\t' -> out.write("\\t")
                    '\u{8}' -> out.write("\\b")
                    '\u{c}' -> out.write("\\f")
                    _ -> writeEscape(out, b)
                i += 1
            start = i
    if start < n then out.write(s.slice(start, n))
    out.writeChar('"')

private val HexDigits: string = "0123456789abcdef"

// `\u` and the four hexadecimal digits of `code`.
private writeEscape(out: Writer, code: int)
    out.write("\\u")
    var shift = 12
    while shift >= 0
        out.writeChar(HexDigits.charAt((code >> shift) & 0xf))
        shift -= 4

// A `real` as the fewest digits that read back as the same value, always with a fraction or an
// exponent so it reads back as a `Real`: `2.5`, `1.0`, `1e+21`, `1.5e-7`. A number from 1e-6 up to
// 1e21 is written out in full, and any other with an exponent. A NaN or an infinity, which JSON
// cannot write, is written `null`.
private writeReal(out: Writer, x: real)
    if x != x || x - x != x - x then return out.write("null")
    val plain = x.toString()
    val negative = plain.startsWith("-")
    val body = if negative then plain.slice(1, plain.byteLength) else plain
    // The digits without the point and the leading zeros, and where the point falls among them.
    val point = body.indexOf('.')
    val whole = if point < 0 then body else body.slice(0, point)
    val fraction = if point < 0 then "" else body.slice(point + 1, body.byteLength)
    var digits = whole + fraction
    var exponent = whole.byteLength
    var lead = 0
    while lead < digits.byteLength - 1 && digits.charAt(lead) == '0'
        lead += 1
    digits = digits.slice(lead, digits.byteLength)
    exponent -= lead
    var end = digits.byteLength
    while end > 1 && digits.charAt(end - 1) == '0'
        end -= 1
    digits = digits.slice(0, end)
    if negative then out.writeChar('-')
    if digits == "0" then return out.write("0.0")
    if -6 < exponent <= 21
        if exponent <= 0
            out.write("0.")
            out.write("0".repeat(-exponent))
            out.write(digits)
        else if digits.byteLength <= exponent
            out.write(digits)
            out.write("0".repeat(exponent - digits.byteLength))
            out.write(".0")
        else
            out.write(digits.slice(0, exponent))
            out.writeChar('.')
            out.write(digits.slice(exponent, digits.byteLength))
        return
    out.write(digits.slice(0, 1))
    if digits.byteLength > 1
        out.writeChar('.')
        out.write(digits.slice(1, digits.byteLength))
    out.writeChar('e')
    out.writeChar(if exponent - 1 < 0 then '-' else '+')
    out.writeInt(long(if exponent - 1 < 0 then 1 - exponent else exponent - 1))
