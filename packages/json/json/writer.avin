module json

// Writes JSON text to `out` a token at a time, placing the commas and colons itself: a value written
// after another in the same array, or a key after a member, is preceded by a comma, and a key is
// followed by its colon. The text is compact, with no white space. Nothing checks that the calls make
// a document: an object's keys and values alternate, and every array and object is ended, because
// the code calling it says so.
class JsonWriter(out: Writer)
    // Whether the next key or value is preceded by a comma: true after a value, false right after an
    // opening bracket or a key.
    private var separate = false

    private before()
        if separate then out.writeChar(',')

    private after()
        separate = true

    beginObject()
        before()
        out.writeChar('{')
        separate = false

    endObject()
        out.writeChar('}')
        after()

    beginArray()
        before()
        out.writeChar('[')
        separate = false

    endArray()
        out.writeChar(']')
        after()

    // An object's key and its colon; the member's value is written next.
    key(name: string)
        before()
        writeQuoted(out, name, false)
        out.writeChar(':')
        separate = false

    string(s: string)
        before()
        writeQuoted(out, s, false)
        after()

    long(n: long)
        before()
        out.writeInt(n)
        after()

    // A `real` as `render` writes one: the fewest digits that read back as the same value, always
    // with a fraction or an exponent, and a NaN or an infinity as `null`.
    real(x: real)
        before()
        writeReal(out, x)
        after()

    bool(b: bool)
        before()
        out.write(if b then "true" else "false")
        after()

    writeNull()
        before()
        out.write("null")
        after()

    // A whole `Json` value, compact.
    json(value: Json)
        before()
        writeJson(out, value, 0, 0, false)
        after()
