module json

// Reading JSON text as it arrives, one event at a time, without building the whole value: from a
// file, a connection or any other `Reader`, a piece at a time. The reader holds the piece it is
// working through, the token it is reading and one entry for each array or object it is inside, so
// a document larger than memory reads in a few hundred kibibytes however long it is.

import avin.io.IoError
import avin.io.Reader

// One step through JSON text: the start or end of an array or object, a member's name, a value
// that holds no others, or the end of the text after the one value it holds.
data JsonEvent
    StartObject
    EndObject
    StartArray
    EndArray
    MemberName(name: string)
    StringValue(value: string)
    LongValue(value: long)
    RealValue(value: real)
    BoolValue(value: bool)
    NullValue
    EndOfText

impl JsonEvent
    // What the event is, for a message: `an array`, `the end of an object`, `a string`.
    describe() -> string = self match
        StartObject -> "an object"
        EndObject -> "the end of an object"
        StartArray -> "an array"
        EndArray -> "the end of an array"
        MemberName(_) -> "a member's name"
        StringValue(_) -> "a string"
        LongValue(_) | RealValue(_) -> "a number"
        BoolValue(_) -> "a boolean"
        NullValue -> "null"
        EndOfText -> "the end of the text"

// How many bytes a reader asks its source for at a time.
val streamChunkSize: int = 65536

// What the reader expects next.
private val AtStart = 0
private val AfterDocument = 1
private val Finished = 2
private val ArrayFirst = 3
private val ArrayNext = 4
private val ObjectFirst = 5
private val ObjectNext = 6
private val MemberValue = 7

// A source with nothing in it, behind a reader of text already in hand.
private object NoInput: Reader
    override read(max: int) -> Result[Array[byte], IoError] = Ok(Array.empty[byte]())

// Reads one JSON value from a source, by the grammar `parse` reads, as a stream of events. `next`
// gives each event in turn and `peek` the one coming; the rest read a whole value of a kind at a
// time, which is what a decoder written for a type calls. The first thing wrong with the text, or a
// failure to read it, is the `Err` of that call and of every call after it.
//
// A reader belongs to the thread that reads it, as its source does.
class JsonReader(private val source: Reader, private val maxDepth: int, private var chunk: Array[byte])
    // The next byte to read in `chunk`, and how many bytes of the text came before `chunk`.
    private var pos = 0
    private var base: long = 0
    private var ended = false
    // The line and column of `pos`.
    private var line: long = 1
    private var column: long = 1
    // Where the last event given or peeked began.
    private var tokenLine: long = 1
    private var tokenColumn: long = 1
    private var tokenOffset: long = 0
    // A mark taken inside a token, for an error at its start.
    private var markLine: long = 1
    private var markColumn: long = 1
    private var markOffset: long = 0
    private var state = AtStart
    // For each array or object the reader is inside, outermost first: whether it is an object.
    private val open = Buffer[bool]()
    private var peeked: Option[Result[JsonEvent, JsonError]] = None
    private var failure: Option[JsonError] = None
    private var readFailure: Option[JsonError] = None
    // The bytes of a token that runs past the end of `chunk`, or holds an escape.
    private val scratch = Buffer[byte]()

    // The next event, moving past it.
    next() -> Result[JsonEvent, JsonError]
        if peeked is Some(r)
            peeked = None
            return r
        step()

    // The next event, which the next call to `next` gives again.
    peek() -> Result[JsonEvent, JsonError]
        if peeked is Some(r) then return r
        val r = step()
        peeked = Some(r)
        r

    // How many arrays and objects the reader is inside.
    depth() -> int = open.length()

    // An error saying `message`, placed where the last event given or peeked began.
    error(message: string) -> JsonError = JsonError(message, tokenLine, tokenColumn, tokenOffset)

    // Moves into an array, which must be the next value.
    beginArray() -> Result[unit, JsonError] = next()? match
        StartArray -> Ok(())
        e -> Err(expected("an array", e))

    // Whether the array has another element, which the caller then reads; at its end, moves past it.
    nextElement() -> Result[bool, JsonError] = peek()? match
        EndArray ->
            next()?
            Ok(false)
        EndOfText | EndObject | MemberName(_) -> Err(expected("an element or the end of an array", next()?))
        _ -> Ok(true)

    // Moves into an object, which must be the next value.
    beginObject() -> Result[unit, JsonError] = next()? match
        StartObject -> Ok(())
        e -> Err(expected("an object", e))

    // The name of the object's next member, whose value the caller then reads, or `None` at the
    // object's end, moving past it.
    nextKey() -> Result[Option[string], JsonError] = next()? match
        MemberName(k) -> Ok(Some(k))
        EndObject -> Ok(None)
        e -> Err(expected("a member's name or the end of an object", e))

    // The next value, which must be a string.
    readString() -> Result[string, JsonError] = next()? match
        StringValue(s) -> Ok(s)
        e -> Err(expected("a string", e))

    // The next value, which must be `true` or `false`.
    readBool() -> Result[bool, JsonError] = next()? match
        BoolValue(b) -> Ok(b)
        e -> Err(expected("a boolean", e))

    // The next value as a `long`, as `Json.asLong` takes one: a whole number within a `long`,
    // written with a fraction or an exponent or not.
    readLong() -> Result[long, JsonError] = next()? match
        LongValue(n) -> Ok(n)
        RealValue(x) -> Real(x).asLong() match
            Some(n) -> Ok(n)
            None -> Err(error(s"the number ${Real(x)} is not a whole number within a long's range"))
        e -> Err(expected("a number", e))

    // The next value as an `int`, a whole number that fits one.
    readInt() -> Result[int, JsonError]
        val number = next()? match
            LongValue(n) -> Long(n)
            RealValue(x) -> Real(x)
            e -> return Err(expected("a number", e))
        number.asInt() match
            Some(i) -> Ok(i)
            None -> Err(error(s"the number $number is not a whole number within an int's range"))

    // The next value as a `real`, a whole number rounded to the nearest one.
    readReal() -> Result[real, JsonError] = next()? match
        LongValue(n) -> Ok(real(n))
        RealValue(x) -> Ok(x)
        e -> Err(expected("a number", e))

    // Whether the next value is `null`, moving past it when it is. Anything else, the end of an array
    // or object and a fault in the text included, is left for the next call.
    takeNull() -> bool
        if peek() is Ok(NullValue)
            peeked = None
            return true
        false

    // Moves past the next value, whatever it holds.
    skipValue() -> Result[unit, JsonError]
        var inside = 0
        loop
            val e = next()?
            e match
                StartArray | StartObject -> inside += 1
                EndArray | EndObject ->
                    if inside == 0 then return Err(expected("a value", e))
                    inside -= 1
                MemberName(_) -> ()
                EndOfText -> return Err(expected("a value", e))
                _ -> ()
            if inside == 0 then return Ok(())

    // The next value whole, as a `Json`.
    readValue() -> Result[Json, JsonError] = valueFrom(next()?)

    // The one value the text holds, read whole, and the end of the text after it.
    readDocument() -> Result[Json, JsonError]
        val value = readValue()?
        finish()?
        Ok(value)

    // The end of the text, with nothing but white space after the value.
    finish() -> Result[unit, JsonError] = next()? match
        EndOfText -> Ok(())
        e -> Err(expected("the end of the text", e))

    private expected(what: string, found: JsonEvent) -> JsonError = error(s"expected $what, found ${found.describe()}")

    private valueFrom(event: JsonEvent) -> Result[Json, JsonError] = event match
        StartArray ->
            val items = Buffer[Json]()
            loop
                val e = next()?
                if e is EndArray then return Ok(Arr(items.toVector()))
                items.addOne(valueFrom(e)?)
        StartObject ->
            val members = Buffer[(string, Json)]()
            loop
                next()? match
                    MemberName(k) -> members.addOne((k, readValue()?))
                    _ -> return Ok(Obj(members.toVector()))
        StringValue(s) -> Ok(Str(s))
        LongValue(n) -> Ok(Long(n))
        RealValue(x) -> Ok(Real(x))
        BoolValue(b) -> Ok(Bool(b))
        NullValue -> Ok(Null)
        e -> Err(expected("a value", e))

    // The next event, or the fault that ends the reading; a fault, once met, is met again.
    private step() -> Result[JsonEvent, JsonError]
        if failure is Some(e) then return Err(e)
        val r = advance()
        if readFailure is Some(e)
            failure = Some(e)
            return Err(e)
        if r is Err(e) then failure = Some(e)
        r

    private advance() -> Result[JsonEvent, JsonError]
        skipSpace()
        markToken()
        if state == AtStart || state == MemberValue then return value()
        if state == Finished then return Ok(EndOfText)
        val b = peekByte()
        if state == AfterDocument
            if b < 0
                state = Finished
                return Ok(EndOfText)
            return Err(unexpectedFault("after the value"))
        if state == ArrayFirst
            if b == int(']') then return close()
            return value()
        if state == ArrayNext
            if b < 0 then return Err(fault("unexpected end of text in an array, where ',' or ']' was expected"))
            if b == int(',')
                take()
                skipSpace()
                if peekByte() == int(']') then return Err(fault("unexpected ']' after ',' in an array"))
                markToken()
                return value()
            if b == int(']') then return close()
            return Err(unexpectedFault("in an array, where ',' or ']' was expected"))
        if state == ObjectFirst
            if b == int('}') then return close()
            return member(false)
        if b < 0 then return Err(fault("unexpected end of text in an object, where ',' or '}' was expected"))
        if b == int(',')
            take()
            skipSpace()
            markToken()
            return member(true)
        if b == int('}') then return close()
        Err(unexpectedFault("in an object, where ',' or '}' was expected"))

    // A member's name, its colon and the white space after it.
    private member(afterComma: bool) -> Result[JsonEvent, JsonError]
        val b = peekByte()
        if b != int('"')
            if afterComma && b == int('}') then return Err(fault("unexpected '}' after ',' in an object"))
            return Err(unexpectedFault("where an object's key was expected"))
        val name = readText()?
        skipSpace()
        if peekByte() != int(':') then return Err(unexpectedFault("after an object's key, where ':' was expected"))
        take()
        state = MemberValue
        Ok(MemberName(name))

    // A value, or the start of one, at `pos`.
    private value() -> Result[JsonEvent, JsonError]
        val b = peekByte()
        if b < 0 then return Err(fault("unexpected end of text where a value was expected"))
        char(b) match
            '{' -> openContainer(true)
            '[' -> openContainer(false)
            '"' ->
                val s = readText()?
                afterValue()
                Ok(StringValue(s))
            't' -> word("true", BoolValue(true))
            'f' -> word("false", BoolValue(false))
            'n' -> word("null", NullValue)
            '-' | '0'..'9' -> number()
            _ -> Err(unexpectedFault("where a value was expected"))

    private openContainer(isObject: bool) -> Result[JsonEvent, JsonError]
        if open.length() >= maxDepth then return Err(fault(s"arrays and objects nested more than $maxDepth deep"))
        take()
        open.addOne(isObject)
        state = if isObject then ObjectFirst else ArrayFirst
        Ok(if isObject then StartObject else StartArray)

    // The closing bracket at `pos`, of the innermost array or object.
    private close() -> Result[JsonEvent, JsonError]
        take()
        val isObject = open.remove(open.length() - 1)
        afterValue()
        Ok(if isObject then EndObject else EndArray)

    private afterValue()
        state = if open.length() == 0 then AfterDocument elif open(open.length() - 1) then ObjectNext else ArrayNext

    private word(text: string, event: JsonEvent) -> Result[JsonEvent, JsonError]
        val n = text.byteLength()
        ensure(n + 1)
        var same = available() >= n
        var k = 0
        while same && k < n
            if chunk(pos + k) != text.byteAt(k) then same = false
            k += 1
        if same && (available() == n || !isWordByte(int(chunk(pos + n))))
            var i = 0
            while i < n
                take()
                i += 1
            afterValue()
            return Ok(event)
        // The run of letters and digits at `pos`, for the message; the reading ends here.
        mark()
        scratch.clear()
        while peekByte() >= 0 && isWordByte(peekByte())
            scratch.addOne(chunk(pos))
            take()
        Err(faultAtMark(s"unexpected word '${string.fromUtf8Lossy(scratch.toArray())}' where a value was expected"))

    private isWordByte(b: int) -> bool = char(b) match
        'a'..'z' | 'A'..'Z' | '0'..'9' | '_' -> true
        _ -> false

    // A number at `pos`: a `LongValue` when it is a whole number that fits a `long`, and a
    // `RealValue` otherwise.
    private number() -> Result[JsonEvent, JsonError]
        mark()
        val startLine = markLine
        val startColumn = markColumn
        val startOffset = markOffset
        scratch.clear()
        val negative = peekByte() == int('-')
        if negative then keep()
        if !isDigit(peekByte()) then return Err(unexpectedFault("in a number, where a digit was expected"))
        val least = long(-9223372036854775807) - 1
        // The value builds on the negative side, which holds every `long` including the least.
        var acc: long = 0
        var fits = true
        if peekByte() == int('0')
            mark()
            keep()
            if isDigit(peekByte()) then return Err(faultAtMark("a number with a leading zero"))
        else
            while isDigit(peekByte())
                val digit = long(peekByte() - int('0'))
                if fits
                    if acc < least / 10 || acc * 10 < least + digit then fits = false else acc = acc * 10 - digit
                keep()
        var whole = true
        if peekByte() == int('.')
            whole = false
            keep()
            if !isDigit(peekByte()) then return Err(unexpectedFault("after a number's '.', where a digit was expected"))
            while isDigit(peekByte())
                keep()
        if peekByte() == int('e') || peekByte() == int('E')
            whole = false
            keep()
            if peekByte() == int('+') || peekByte() == int('-') then keep()
            if !isDigit(peekByte()) then return Err(unexpectedFault("in a number's exponent, where a digit was expected"))
            while isDigit(peekByte())
                keep()
        afterValue()
        if whole && fits
            if negative then return Ok(LongValue(acc))
            if acc != least then return Ok(LongValue(-acc))
        val digits = string.fromUtf8Lossy(scratch.toArray())
        if digits.toRealOption() is Some(x) then return Ok(RealValue(x))
        Err(JsonError(s"the number $digits is too large for a real", startLine, startColumn, startOffset))

    private isDigit(b: int) -> bool = int('0') <= b <= int('9')

    // Moves past the byte at `pos`, keeping it in `scratch`.
    private keep()
        scratch.addOne(chunk(pos))
        take()

    // A string from its opening quote at `pos` to its closing one, its UTF-8 checked as it goes. A
    // string within one piece of the text, with no escape, is one slice of it.
    private readText() -> Result[string, JsonError]
        take()
        scratch.clear()
        var whole = true
        var start = pos
        loop
            if pos >= chunk.length()
                keepRun(start)
                whole = false
                if !refill() then return Err(fault("unexpected end of text in a string"))
                start = pos
                continue
            val b = int(chunk(pos))
            if b == int('"')
                if !whole then keepRun(start)
                val bytes = if whole then chunk.slice(start, pos) else scratch.toArray()
                take()
                return string.fromUtf8(bytes) match
                    Ok(s) -> Ok(s)
                    Err(_) -> Err(fault("bytes that are not UTF-8"))
            if b == int('\\')
                keepRun(start)
                whole = false
                escape()?
                start = pos
            elif b < 0x20
                return Err(fault(s"unexpected control character U+${hex4(b)} in a string, which must be written as an escape"))
            elif b < 0x80
                pos += 1
                column += 1
            else
                val n = sequenceLength(b)
                if pos + n > chunk.length()
                    keepRun(start)
                    whole = false
                    ensure(n)
                    start = pos
                if !wellFormed(n) then return Err(fault("bytes that are not UTF-8"))
                pos += n
                column += 1

    // Keeps the bytes of `chunk` from `start` to `pos` in `scratch`.
    private keepRun(start: int)
        var i = start
        while i < pos
            scratch.addOne(chunk(i))
            i += 1

    // How many bytes the UTF-8 sequence led by `b` takes, 1 for a byte that leads none.
    private sequenceLength(b: int) -> int
        if 0xc2 <= b <= 0xdf then return 2
        if 0xe0 <= b <= 0xef then return 3
        if 0xf0 <= b <= 0xf4 then 4 else 1

    // Whether the `n` bytes at `pos`, led by a byte at or above 0x80, are one well-formed UTF-8
    // sequence: no overlong form, no surrogate and nothing beyond U+10FFFF.
    private wellFormed(n: int) -> bool
        if n == 1 || available() < n then return false
        val lead = int(chunk(pos))
        val second = int(chunk(pos + 1))
        val lo = if lead == 0xe0 then 0xa0 elif lead == 0xf0 then 0x90 else 0x80
        val hi = if lead == 0xed then 0x9f elif lead == 0xf4 then 0x8f else 0xbf
        if !(lo <= second <= hi) then return false
        var k = 2
        while k < n
            if (int(chunk(pos + k)) & 0xc0) != 0x80 then return false
            k += 1
        true

    // One escape, from its backslash at `pos`, its bytes kept in `scratch`.
    private escape() -> Result[unit, JsonError]
        mark()
        take()
        val b = peekByte()
        if b < 0 then return Err(fault("unexpected end of text in an escape"))
        val c = char(b) match
            '"' -> '"'
            '\\' -> '\\'
            '/' -> '/'
            'b' -> '\u{8}'
            'f' -> '\u{c}'
            'n' -> '\n'
            'r' -> '\r'
            't' -> '\t'
            'u' -> return unicodeEscape()
            _ -> return Err(unexpectedFault("after '\\' in a string, where an escape was expected"))
        take()
        scratch.addOne(byte(int(c)))
        Ok(())

    // A `\u` escape, its backslash taken and marked, `u` at `pos`; a surrogate pair is one character.
    private unicodeEscape() -> Result[unit, JsonError]
        take()
        val code = hexUnit()?
        if 0xdc00 <= code <= 0xdfff then return Err(faultAtMark(s"a lone low surrogate \\u${hex4(code)}, which no character is"))
        if 0xd800 <= code <= 0xdbff
            ensure(2)
            if available() < 2 || chunk(pos) != byte(0x5c) || chunk(pos + 1) != byte(0x75)
                return Err(faultAtMark(s"a high surrogate \\u${hex4(code)} with no low surrogate after it"))
            take()
            take()
            val low = hexUnit()?
            if !(0xdc00 <= low <= 0xdfff)
                return Err(faultAtMark(s"a high surrogate \\u${hex4(code)} followed by \\u${hex4(low)}, which is not a low surrogate"))
            keepChar(char(0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00)))
        else
            keepChar(char(code))
        Ok(())

    // Four hexadecimal digits at `pos`, moving past them.
    private hexUnit() -> Result[int, JsonError]
        var code = 0
        var k = 0
        while k < 4
            val b = peekByte()
            if b < 0 then return Err(fault("unexpected end of text in a \\u escape"))
            val digit = char(b) match
                '0'..'9' -> b - int('0')
                'a'..'f' -> b - int('a') + 10
                'A'..'F' -> b - int('A') + 10
                _ -> return Err(unexpectedFault("in a \\u escape, where a hexadecimal digit was expected"))
            code = code * 16 + digit
            take()
            k += 1
        Ok(code)

    // Keeps the UTF-8 bytes of `c` in `scratch`.
    private keepChar(c: char)
        for b in c.toString().bytes()
            scratch.addOne(b)

    // Moves past white space.
    private skipSpace()
        loop
            if pos >= chunk.length() && !refill() then return
            val b = chunk(pos)
            if b == byte(0x20) || b == byte(0x09) || b == byte(0x0d)
                pos += 1
                column += 1
            elif b == byte(0x0a)
                pos += 1
                line += 1
                column = 1
            else
                return

    // The byte at `pos`, or -1 at the end of the text.
    private peekByte() -> int
        if pos >= chunk.length() && !refill() then return -1
        int(chunk(pos))

    // Moves past the byte at `pos`, which is there, counting the line and column.
    private take()
        val b = int(chunk(pos))
        pos += 1
        if b == 0x0a
            line += 1
            column = 1
        elif (b & 0xc0) != 0x80
            column += 1

    // How many bytes of `chunk` are left to read.
    private available() -> int = chunk.length() - pos

    // Reads the next piece of the text once `chunk` is used up; false at the end of the text.
    private refill() -> bool
        if pos < chunk.length() then return true
        if ended then return false
        val more = fetch()
        base += long(pos)
        pos = 0
        chunk = more
        chunk.length() > 0

    // Reads until `n` bytes are left in `chunk`, or the text ends first.
    private ensure(n: int)
        while available() < n && !ended
            val more = fetch()
            if more.length() > 0
                val joined = Buffer[byte]()
                var i = pos
                while i < chunk.length()
                    joined.addOne(chunk(i))
                    i += 1
                for b in more
                    joined.addOne(b)
                base += long(pos)
                pos = 0
                chunk = joined.toArray()

    // The next piece from the source, empty once it ends or fails to read.
    private fetch() -> Array[byte]
        source.read(streamChunkSize) match
            Ok(more) ->
                if more.length() == 0 then ended = true
                more
            Err(e) ->
                ended = true
                readFailure = Some(JsonError(s"the text could not be read: ${e.message()}", line, column, base + long(pos)))
                Array.empty[byte]()

    private markToken()
        tokenLine = line
        tokenColumn = column
        tokenOffset = base + long(pos)

    private mark()
        markLine = line
        markColumn = column
        markOffset = base + long(pos)

    private fault(message: string) -> JsonError = JsonError(message, line, column, base + long(pos))

    private faultAtMark(message: string) -> JsonError = JsonError(message, markLine, markColumn, markOffset)

    // The fault of what stands at `pos` where it does not belong: the end of the text, a control
    // character or the character itself, followed by `context`; bytes that are not UTF-8 are that
    // fault instead.
    private unexpectedFault(context: string) -> JsonError
        val b = peekByte()
        if b < 0 then return fault(s"unexpected end of text $context")
        if b < 0x20 || b == 0x7f then return fault(s"unexpected control character U+${hex4(b)} $context")
        if b < 0x80 then return fault(s"unexpected '${char(b)}' $context")
        val n = sequenceLength(b)
        ensure(n)
        if !wellFormed(n) then return fault("bytes that are not UTF-8")
        fault(s"unexpected '${string.fromUtf8Lossy(chunk.slice(pos, pos + n))}' $context")

object JsonReader
    // A reader of the text `source` gives, read a piece at a time as events are asked for. Arrays
    // and objects may nest `maxDepth` deep, as in `parse`.
    fromReader(source: Reader, maxDepth: int = defaultMaxDepth) -> JsonReader = JsonReader(source, maxDepth, Array.empty[byte]())

    // A reader of `text`.
    fromString(text: string, maxDepth: int = defaultMaxDepth) -> JsonReader =
        JsonReader(NoInput, maxDepth, Array.tabulate(text.byteLength(), i -> text.byteAt(i)))

    // A reader of text given as its UTF-8 bytes.
    fromBytes(bytes: Array[byte], maxDepth: int = defaultMaxDepth) -> JsonReader = JsonReader(NoInput, maxDepth, bytes)
