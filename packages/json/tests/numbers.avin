module tests

// Numbers: a whole number that fits a `long` is read exactly as a `Long`, any other as a `Real`;
// a `Real` is written with the fewest digits that read back as itself, always with a fraction or an
// exponent, so writing and reading again gives the same kind and the same value.
import json
import json.Json

// Each text read, as its value's constructor and contents, beside what it should be.
kinds(cases: Vector[(string, string)])
    val wrong = Buffer[string]()
    for (text, expected) in cases
        val actual = json.parse(text) match
            Ok(Json.Long(n)) -> s"Long $n"
            Ok(Json.Real(x)) -> s"Real ${Json.Real(x).render()}"
            Ok(j) -> s"other ${j.render()}"
            Err(e) -> s"error: $e"
        if actual != expected then wrong.addOne(s"$text: expected $expected, found $actual")
        wrong.addAll(disagreements(text))
    assertEq(wrong.toVector, Vector.empty[string]())

// Each value rendered, beside the text it should be.
renders(cases: Vector[(Json, string)])
    val wrong = Buffer[string]()
    for (value, expected) in cases
        val actual = value.render()
        if actual != expected then wrong.addOne(s"expected $expected, found $actual")
    assertEq(wrong.toVector, Vector.empty[string]())

@test("a whole number is a Long, exact to the ends of a long's range")
wholeNumbers()
    kinds([
        ("0", "Long 0"),
        ("7", "Long 7"),
        ("-7", "Long -7"),
        ("2147483647", "Long 2147483647"),
        ("2147483648", "Long 2147483648"),
        ("-2147483649", "Long -2147483649"),
        ("9007199254740993", "Long 9007199254740993"),
        ("9223372036854775807", "Long 9223372036854775807"),
        ("-9223372036854775808", "Long -9223372036854775808"),
    ])

@test("a whole number beyond a long is a Real, correctly rounded")
beyondLong()
    kinds([
        ("9223372036854775808", "Real 9223372036854776000.0"),
        ("-9223372036854775809", "Real -9223372036854776000.0"),
        ("18446744073709551616", "Real 18446744073709552000.0"),
        ("100000000000000000000000", "Real 1e+23"),
        ("123456789012345678901234567890", "Real 1.2345678901234568e+29"),
    ])

@test("minus zero: -0 is the Long 0, and -0.0 the Real minus zero, which keeps its sign")
minusZero()
    kinds([
        ("-0", "Long 0"),
        ("-0.0", "Real -0.0"),
        ("-0e0", "Real -0.0"),
        ("0.0", "Real 0.0"),
        ("0e0", "Real 0.0"),
    ])
    val z = json.parse("-0.0").ok().get().asReal().get()
    assert(1.0 / z < 0.0)

@test("a fraction or an exponent makes a Real, even of a whole value")
fractionsAndExponents()
    kinds([
        ("1.0", "Real 1.0"),
        ("1.5", "Real 1.5"),
        ("-1.5", "Real -1.5"),
        ("0.1", "Real 0.1"),
        ("1e0", "Real 1.0"),
        ("1E2", "Real 100.0"),
        ("1e+2", "Real 100.0"),
        ("1e-2", "Real 0.01"),
        ("2.5E-3", "Real 0.0025"),
        ("1e007", "Real 10000000.0"),
        ("123.456e2", "Real 12345.6"),
        ("0.000001", "Real 0.000001"),
        ("0.0000001", "Real 1e-7"),
        ("1e21", "Real 1e+21"),
        ("1e20", "Real 100000000000000000000.0"),
        ("1.7976931348623157e308", "Real 1.7976931348623157e+308"),
        ("5e-324", "Real 5e-324"),
        ("1e-400", "Real 0.0"),
        ("-1e-400", "Real -0.0"),
        ("0.1e1", "Real 1.0"),
        ("12345678901234567890.5", "Real 12345678901234567000.0"),
    ])

@test("a Real renders as the fewest digits that read back, written out from 1e-6 to below 1e21")
realRendering()
    renders([
        (Json.Real(2.5), "2.5"),
        (Json.Real(1.0), "1.0"),
        (Json.Real(-1.0), "-1.0"),
        (Json.Real(0.0), "0.0"),
        (Json.Real(-0.0), "-0.0"),
        (Json.Real(0.1), "0.1"),
        (Json.Real(1.0 / 3.0), "0.3333333333333333"),
        (Json.Real(100.0), "100.0"),
        (Json.Real(1e20), "100000000000000000000.0"),
        (Json.Real(1e21), "1e+21"),
        (Json.Real(1.5e21), "1.5e+21"),
        (Json.Real(1e300), "1e+300"),
        (Json.Real(-1e300), "-1e+300"),
        (Json.Real(0.000001), "0.000001"),
        (Json.Real(0.0000015), "0.0000015"),
        (Json.Real(1e-7), "1e-7"),
        (Json.Real(-1.25e-7), "-1.25e-7"),
        (Json.Real(5e-324), "5e-324"),
        (Json.Real(1.7976931348623157e308), "1.7976931348623157e+308"),
        (Json.Real(123456.789), "123456.789"),
    ])

@test("a NaN or an infinity, which JSON cannot write, renders as null")
nonFinite()
    val inf = 1e308 * 10.0
    renders([
        (Json.Real(inf), "null"),
        (Json.Real(-inf), "null"),
        (Json.Real(inf - inf), "null"),
        (Json.arr(Json.Real(inf), Json.Long(1)), "[null,1]"),
    ])

@test("a Long renders as its digits, at the ends of the range too")
longRendering()
    renders([
        (Json.Long(0), "0"),
        (Json.Long(-1), "-1"),
        (Json.Long(9223372036854775807), "9223372036854775807"),
        (Json.Long(long(-9223372036854775807) - 1), "-9223372036854775808"),
        (Json.num(42), "42"),
        (Json.num(4.0), "4.0"),
    ])

@test("every number reads back from its rendering as the same kind and value")
numbersRoundTrip()
    val values = [Json.Long(0), Json.Long(-1), Json.Long(9223372036854775807), Json.Long(long(-9223372036854775807) - 1),
        Json.Real(0.0), Json.Real(-0.0), Json.Real(0.1), Json.Real(1.0 / 3.0), Json.Real(1e21), Json.Real(1e-7),
        Json.Real(5e-324), Json.Real(1.7976931348623157e308), Json.Real(-2.5e-300), Json.Real(9007199254740993.0),
        Json.Real(123456789.0), Json.Real(1e100)]
    for v in values
        val back = json.parse(v.render()).ok().get()
        assertEq(back.render(), v.render())
        assertEq(back, v)

@test("asLong takes a Long, or a Real that is a whole number within a long; asInt narrows further")
numberAccessors()
    assertEq(Json.Long(5).asLong(), Some(long(5)))
    assertEq(Json.Real(3.0).asLong(), Some(long(3)))
    assertEq(Json.Real(1e3).asLong(), Some(long(1000)))
    assertEq(Json.Real(-0.0).asLong(), Some(long(0)))
    assertEq(Json.Real(3.5).asLong(), None)
    assertEq(Json.Real(9223372036854775808.0).asLong(), None)
    assertEq(Json.Real(-9223372036854775808.0).asLong(), Some(long(-9223372036854775807) - 1))
    assertEq(Json.Real(1e300).asLong(), None)
    assertEq(Json.Real(1e308 * 10.0).asLong(), None)
    assertEq(Json.Real(0.0 / 0.0).asLong(), None)
    assertEq(Json.Str("5").asLong(), None)
    assertEq(Json.Long(2147483647).asInt(), Some(2147483647))
    assertEq(Json.Long(-2147483648).asInt(), Some(-2147483648))
    assertEq(Json.Long(2147483648).asInt(), None)
    assertEq(Json.Long(-2147483649).asInt(), None)
    assertEq(Json.Real(7.0).asInt(), Some(7))
    assertEq(Json.Null.asInt(), None)
    assertEq(Json.Long(3).asReal(), Some(3.0))
    assertEq(Json.Long(9007199254740993).asReal(), Some(9007199254740992.0))
    assertEq(Json.Real(2.5).asReal(), Some(2.5))
    assertEq(Json.Bool(true).asReal(), None)
