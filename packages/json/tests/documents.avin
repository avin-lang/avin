module tests

// Whole documents: the indented form exactly, reading back what was written in both forms, the
// nesting limit at its edge, text given as bytes, and documents of a mebibyte.
import json
import json.Json

@test("the indented form puts each element and member on its own line, empty containers kept short")
prettyForm()
    val j = json.parse("{\"a\":[1,{\"b\":null,\"c\":[]}],\"d\":{},\"e\":\"x\"}").ok.get
    assertEq(j.pretty(), "{\n  \"a\": [\n    1,\n    {\n      \"b\": null,\n      \"c\": []\n    }\n  ],\n  \"d\": {},\n  \"e\": \"x\"\n}")
    assertEq(j.pretty(4), "{\n    \"a\": [\n        1,\n        {\n            \"b\": null,\n            \"c\": []\n        }\n    ],\n    \"d\": {},\n    \"e\": \"x\"\n}")
    assertEq(j.pretty(0), j.render)
    assertEq(Json.Long(1).pretty(), "1")
    assertEq(Json.arr().pretty(), "[]")
    assertEq(Json.obj().pretty(), "{}")
    assertEq(Json.arr(Json.arr()).pretty(), "[\n  []\n]")
    assertEq(Json.obj(("k", Json.str("a\nb"))).pretty(), "{\n  \"k\": \"a\\nb\"\n}")

@test("a value reads back from its compact, indented and ASCII forms as itself")
roundTrips()
    val texts = ["null", "[]", "{}", "[[[]]]", "{\"a\":{\"b\":{\"c\":[1,2.5,-3e-7,\"é😀\\n\"]}}}",
        "[true,false,null,0,-0.0,9223372036854775807,1e+300,\"\\u0000\\u001f\"]",
        "{\"\":\"\",\"a\\\"b\":[{}],\"日本\":{\"x\":[null]}}"]
    for text in texts
        val j = json.parse(text).ok.get
        assertEq(j.render, text)
        assertEq(json.parse(j.render).ok.get, j)
        assertEq(json.parse(j.pretty()).ok.get, j)
        assertEq(json.parse(j.pretty(3)).ok.get, j)
        assertEq(json.parse(j.renderAscii).ok.get, j)

// `depth` arrays nested inside one another, around `inner`.
nest(depth: int, inner: string) -> string = "[".repeat(depth) + inner + "]".repeat(depth)

@test("arrays and objects nest 512 deep by default; 513 is refused at the bracket that goes too deep")
defaultDepth()
    assertEq(json.defaultMaxDepth, 512)
    assert(json.parse(nest(512, "1")).isOk)
    assertEq(s"${json.parse(nest(513, "1")).err.get}", "arrays and objects nested more than 512 deep at line 1, column 513")
    val objects = "{\"a\":".repeat(512) + "1" + "}".repeat(512)
    assert(json.parse(objects).isOk)
    val tooDeep = "{\"a\":".repeat(513) + "1" + "}".repeat(513)
    assertEq(json.parse(tooDeep).err.get.column, 512 * 5 + 1)
    val mixed = "[{\"a\":".repeat(256) + "1" + "}]".repeat(256)
    assert(json.parse(mixed).isOk)
    assert(json.parse("[" + mixed + "]").isErr)

@test("the nesting limit can be raised or lowered, and scalars are at depth 0")
chosenDepth()
    assert(json.parse(nest(5000, ""), 5000).isOk)
    assert(json.parse(nest(5001, ""), 5000).isErr)
    assert(json.parse("[1]", 1).isOk)
    assert(json.parse("[[1]]", 1).isErr)
    assert(json.parse("{\"a\":[]}", 1).isErr)
    assert(json.parse("1", 0).isOk)
    assert(json.parse("\"s\"", 0).isOk)
    assert(json.parse("[]", 0).isErr)
    assert(json.parse("{}", 0).isErr)

@test("a value nested deeper than the reading limit still renders and reads back with a raised limit")
deepValues()
    var j = Json.Long(1)
    for i in 0..<2000 do j = Json.arr(j)
    val text = j.render
    assertEq(text, nest(2000, "1"))
    assert(json.parse(text).isErr)
    assertEq(json.parse(text, 2000).ok.get, j)
    assert(json.parse(j.pretty(1), 2000).isOk)

@test("text given as bytes is read as its UTF-8, and bytes that are not UTF-8 are an error at the first of them")
fromBytes()
    assertEq(json.parse("{\"é\":[1]}".bytes.toArray()).ok.get.render, "{\"é\":[1]}")
    val bad = Buffer[byte]()
    for b in "[\"a\",\n \"".bytes do bad.addOne(b)
    bad.addOne(byte(0xff))
    bad.addOne(byte(0x22))
    bad.addOne(byte(0x5d))
    val e = json.parse(bad.toArray()).err.get
    assertEq(s"$e", "bytes that are not UTF-8 at line 2, column 3")
    assertEq(e.offset, 8)
    val truncated = Buffer[byte]()
    for b in "\"é".bytes do truncated.addOne(b)
    truncated.remove(truncated.length - 1)
    assertEq(json.parse(truncated.toArray()).err.get.offset, 1)
    assertEq(json.parse(Array.fill(0, byte(0))).err.get.message, "unexpected end of text where a value was expected")
    assertEq(json.parse("[[1]]".bytes.toArray(), 1).isErr, true)

// A document of about a mebibyte: records of every kind of value, strings with escapes and text
// beyond ASCII among them.
mebibyte() -> Json
    val rows = Buffer[Json]()
    var i = 0
    while i < 9000
        rows.addOne(Json.obj(("id", Json.num(i)), ("name", Json.str(s"job $i \"quoted\"\tтекст 😀")), ("score", Json.num(real(i) / 7.0)),
            ("big", Json.num(long(i) * 1000000000000)), ("tags", Json.arr(Json.str("a"), Json.Bool(i % 2 == 0), Json.Null, Json.arr(), Json.obj()))))
        i += 1
    Json.Arr(rows.toVector)

@test("a mebibyte document reads back from its compact and indented forms as itself")
largeDocuments()
    val doc = mebibyte()
    val text = doc.render
    assert(text.byteLength > 1048576)
    assertEq(json.parse(text).ok.get, doc)
    val pretty = doc.pretty()
    assertEq(json.parse(pretty).ok.get, doc)
    assertEq(json.parse(text.bytes.toArray()).ok.get.size, 9000)

@test("one string of a mebibyte, plain and full of escapes, reads back whole")
largeStrings()
    val plain = "abcdefghé".repeat(110000)
    assertEq(json.parse(Json.Str(plain).render).ok.get.asString, Some(plain))
    val escaped = "a\"\\\n\u{1}😀".repeat(100000)
    assertEq(json.parse(Json.Str(escaped).render).ok.get.asString, Some(escaped))
    assertEq(json.parse(Json.Str(escaped).renderAscii).ok.get.asString, Some(escaped))

@test("an error at the end of a mebibyte document is placed on its last line")
largeError()
    val text = mebibyte().pretty()
    val e = json.parse(text + "\nx").err.get
    assertEq(e.line, long(text.count(c -> c == '\n') + 2))
    assertEq(e.column, 1)
    assertEq(e.offset, long(text.byteLength + 1))

@test("a wide array and a wide object of a hundred thousand members each")
wide()
    val items = "[" + "0,".repeat(99999) + "0]"
    assertEq(json.parse(items).ok.get.size, 100000)
    val members = Buffer[(string, Json)]()
    for i in 0..<100000 do members.addOne((s"k$i", Json.num(i)))
    val o = Json.Obj(members.toVector)
    val back = json.parse(o.render).ok.get
    assertEq(back.size, 100000)
    assertEq(back("k99999").asInt, Some(99999))
    assertEq(back.get("k100000"), None)
