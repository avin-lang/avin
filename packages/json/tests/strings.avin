module tests

// Strings: every escape read, `\u` escapes with surrogate pairs combined into one character, text
// beyond ASCII passed through, and the writing side escaping exactly the quote, the backslash and the
// control characters (and, in the ASCII form, everything beyond ASCII).
import json
import json.Json

// The string a JSON string literal reads as.
read(text: string) -> string = json.parse(text).ok().get().asString().get()

@test("each of the nine escapes reads as its character")
everyEscape()
    assertEq(read("\"\\\"\""), "\"")
    assertEq(read("\"\\\\\""), "\\")
    assertEq(read("\"\\/\""), "/")
    assertEq(read("\"\\b\""), "\u{8}")
    assertEq(read("\"\\f\""), "\u{c}")
    assertEq(read("\"\\n\""), "\n")
    assertEq(read("\"\\r\""), "\r")
    assertEq(read("\"\\t\""), "\t")
    assertEq(read("\"\\u0041\""), "A")
    assertEq(read("\"a\\tb\\nc\""), "a\tb\nc")
    assertEq(read("\"\\\\n\""), "\\n")
    assertEq(read("\"/\""), "/")

@test("a \\u escape takes upper or lower case digits, any code below U+10000 but a surrogate, U+0000 included")
unicodeEscapes()
    assertEq(read("\"\\u00e9\""), "é")
    assertEq(read("\"\\u00E9\""), "é")
    assertEq(read("\"\\u65e5\\u672C\""), "日本")
    assertEq(read("\"\\u0000\""), "\u{0}")
    assertEq(read("\"\\u0000\"").byteLength(), 1)
    assertEq(read("\"\\u001f\""), "\u{1f}")
    assertEq(read("\"\\u007f\""), "\u{7f}")
    assertEq(read("\"\\u0080\""), "\u{80}")
    assertEq(read("\"\\uffff\""), "\u{ffff}")
    assertEq(read("\"\\ufeff\""), "\u{feff}")
    assertEq(read("\"\\ud7ff\""), "\u{d7ff}")
    assertEq(read("\"\\ue000\""), "\u{e000}")

@test("a surrogate pair reads as the one character beyond U+FFFF it encodes")
surrogatePairs()
    assertEq(read("\"\\ud83d\\ude00\""), "😀")
    assertEq(read("\"\\uD83D\\uDE00\""), "😀")
    assertEq(read("\"\\ud800\\udc00\""), "\u{10000}")
    assertEq(read("\"\\udbff\\udfff\""), "\u{10ffff}")
    assertEq(read("\"x\\ud834\\udd1ey\""), "x𝄞y")
    assertEq(read("\"\\ud83d\\ude00\"").charCount(), 1)

@test("text beyond ASCII is read as it is written, in every length of UTF-8")
rawUnicode()
    assertEq(read("\"é\""), "é")
    assertEq(read("\"日本語\""), "日本語")
    assertEq(read("\"😀𝄞\""), "😀𝄞")
    assertEq(read("\"\u{7f}\""), "\u{7f}")
    assertEq(read("\"\u{80}\u{7ff}\u{800}\u{ffff}\u{10000}\u{10ffff}\""), "\u{80}\u{7ff}\u{800}\u{ffff}\u{10000}\u{10ffff}")
    assertEq(read("\"\u{2028}\u{2029}\""), "\u{2028}\u{2029}")

@test("an escape between plain runs keeps the runs around it, at the start, middle and end")
escapesAmongRuns()
    assertEq(read("\"\\nabc\""), "\nabc")
    assertEq(read("\"abc\\n\""), "abc\n")
    assertEq(read("\"ab\\ncd\\tef\""), "ab\ncd\tef")
    assertEq(read("\"\\n\\n\\n\""), "\n\n\n")
    assertEq(read("\"é\\u00e9é\""), "ééé")
    assertEq(read("\"\""), "")

@test("writing escapes the quote, the backslash and the control characters, and nothing else")
writing()
    assertEq(Json.Str("plain").render(), "\"plain\"")
    assertEq(Json.Str("").render(), "\"\"")
    assertEq(Json.Str("a\"b\\c").render(), "\"a\\\"b\\\\c\"")
    assertEq(Json.Str("\n\r\t\u{8}\u{c}").render(), "\"\\n\\r\\t\\b\\f\"")
    assertEq(Json.Str("\u{0}\u{1}\u{1f}").render(), "\"\\u0000\\u0001\\u001f\"")
    assertEq(Json.Str("/").render(), "\"/\"")
    assertEq(Json.Str("\u{7f}").render(), "\"\u{7f}\"")
    assertEq(Json.Str("é日😀").render(), "\"é日😀\"")
    assertEq(Json.Str("\u{2028}").render(), "\"\u{2028}\"")
    assertEq(json.quote("say \"hi\"\n"), "\"say \\\"hi\\\"\\n\"")

@test("the ASCII form escapes everything beyond ASCII, a character beyond U+FFFF as its surrogate pair")
writingAscii()
    assertEq(Json.Str("é").renderAscii(), "\"\\u00e9\"")
    assertEq(Json.Str("日本").renderAscii(), "\"\\u65e5\\u672c\"")
    assertEq(Json.Str("😀").renderAscii(), "\"\\ud83d\\ude00\"")
    assertEq(Json.Str("\u{10ffff}").renderAscii(), "\"\\udbff\\udfff\"")
    assertEq(Json.Str("\u{10000}").renderAscii(), "\"\\ud800\\udc00\"")
    assertEq(Json.Str("a\u{80}b\n").renderAscii(), "\"a\\u0080b\\n\"")
    assertEq(Json.Str("\u{7f}").renderAscii(), "\"\u{7f}\"")
    assertEq(Json.obj(("ключ", Json.str("значение"))).renderAscii(), "{\"\\u043a\\u043b\\u044e\\u0447\":\"\\u0437\\u043d\\u0430\\u0447\\u0435\\u043d\\u0438\\u0435\"}")
    assertEq(json.quote("é😀", true), "\"\\u00e9\\ud83d\\ude00\"")

@test("every character from U+0000 to U+FFFF but the surrogates, and samples beyond, read back from both forms")
everyCharacterRoundTrips()
    val all = StringWriter()
    var code = 0
    while code < 0x110000
        if !(0xd800 <= code <= 0xdfff) then all.writeChar(char(code))
        code += if code < 0x10000 then 1 else 0x3ff
    val s = all.text()
    assertEq(read(Json.Str(s).render()), s)
    assertEq(read(Json.Str(s).renderAscii()), s)
    assert(Json.Str(s).renderAscii().bytes().forall(b -> int(b) < 0x80))
