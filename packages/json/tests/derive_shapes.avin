module tests

// `derives JsonEncoder` and `derives JsonDecoder` on every shape of type: a single-line data type, a
// sum type with its discriminator, variants without fields, an enumeration, classes, generic types,
// nested and recursive types, and every built-in instance; each value encodes to the text shown and
// decodes back to itself.
import json
import json.Json
import json.JsonEncoder
import json.JsonDecoder
import json.JsonKey
import json.JsonTag
import json.JsonOmit

data Address(street: string, city: string) derives JsonEncoder, JsonDecoder

data Person(@JsonKey("full_name") name: string, age: int, home: Option[Address], @JsonOmit visits: int = 0) derives JsonEncoder, JsonDecoder

@JsonTag("kind")
data Shape derives JsonEncoder, JsonDecoder
    @JsonKey("circle") Circle(radius: real)
    @JsonKey("rect") Rect(width: real, height: real)
    Empty

data Event derives JsonEncoder, JsonDecoder
    Started(at: long)
    Stopped(at: long, code: int)

data Color derives Enumerable, JsonEncoder, JsonDecoder
    Red
    Green
    Blue

data Marker() derives JsonEncoder, JsonDecoder

data Box[A](item: A) derives JsonEncoder, JsonDecoder

data Pair[A, B](first: A, second: B) derives JsonEncoder, JsonDecoder

data Tree(label: string, children: List[Tree]) derives JsonEncoder, JsonDecoder

data Scalars(b: bool, i: int, n: long, x: real, s: string) derives JsonEncoder, JsonDecoder

data Optional(a: Option[int], b: Option[Option[int]], c: Option[Address]) derives JsonEncoder, JsonDecoder

data Lists(v: Vector[int], l: List[string], nested: Vector[Vector[Shape]]) derives JsonEncoder, JsonDecoder

data Maps(byName: HashMap[string, int], byId: TreeMap[int, string], big: TreeMap[long, bool]) derives JsonEncoder, JsonDecoder

data Raw(id: int, payload: Json) derives JsonEncoder, JsonDecoder

data Defaults(a: int, b: int = a + 1, c: string = "c", d: Vector[int] = []) derives JsonEncoder, JsonDecoder

data Hidden(shown: int, @JsonOmit cache: string = "fresh", @JsonKey("x") renamed: int) derives JsonEncoder, JsonDecoder

class Account(val id: long, owner: string, var balance: real) derives JsonEncoder, JsonDecoder
    // A field the body declares takes no part.
    val label: string = s"$owner#$id"

    ownerName() -> string = owner

class Tags(name: string, tags: string*) derives JsonEncoder, JsonDecoder
    describe() -> string = s"$name ${tags.mkString(",")}"

open class Base(n: int) derives JsonEncoder

class Derived(m: int): Base(m * 2)

data Mixed(value: int | string) derives JsonEncoder

// `a` encodes to `text`, and `text` decodes to `a`.
roundTrip[A: JsonEncoder + JsonDecoder + Debug](a: A, text: string)
    assertEq(json.encode(a), text)
    assertEq(json.decode[A](text), Ok(a))

@test("the chapter's Person encodes with its renamed key, null for None, and no omitted field")
person()
    roundTrip(Person("Ada", 36, None), "{\"full_name\":\"Ada\",\"age\":36,\"home\":null}")
    assertEq(json.decode[Person]("{\"full_name\":\"Ada\",\"age\":36}"), Ok(Person("Ada", 36, None)))
    roundTrip(Person("Ada", 36, Some(Address("1 Main", "Springfield"))), "{\"full_name\":\"Ada\",\"age\":36,\"home\":{\"street\":\"1 Main\",\"city\":\"Springfield\"}}")

@test("an omitted field is never written, is skipped where the input has it, and takes its default")
omitted()
    assertEq(json.encode(Person("Ada", 36, None, 99)), "{\"full_name\":\"Ada\",\"age\":36,\"home\":null}")
    assertEq(json.decode[Person]("{\"visits\":5,\"full_name\":\"Ada\",\"age\":36}"), Ok(Person("Ada", 36, None, 0)))
    roundTrip(Hidden(1, "fresh", 2), "{\"shown\":1,\"x\":2}")
    assertEq(json.decode[Hidden]("{\"shown\":1,\"x\":2,\"cache\":\"stale\"}"), Ok(Hidden(1, "fresh", 2)))

@test("a renamed field is read only by its JSON key; its own name is an unknown key")
renamed()
    assertEq(json.decode[Hidden]("{\"shown\":1,\"renamed\":7,\"x\":2}"), Ok(Hidden(1, "fresh", 2)))
    assert(json.decode[Hidden]("{\"shown\":1,\"renamed\":7}").isErr())

@test("a sum type writes its discriminator first, under its JsonTag key, with each variant's JsonKey")
shapes()
    roundTrip[Shape](Rect(2.0, 3.0), "{\"kind\":\"rect\",\"width\":2.0,\"height\":3.0}")
    roundTrip[Shape](Circle(1.5), "{\"kind\":\"circle\",\"radius\":1.5}")
    roundTrip[Shape](Empty, "{\"kind\":\"Empty\"}")

@test("a sum type without a JsonTag uses \"type\", and a variant without a JsonKey its own name")
events()
    roundTrip[Event](Started(5), "{\"type\":\"Started\",\"at\":5}")
    roundTrip[Event](Stopped(9, -1), "{\"type\":\"Stopped\",\"at\":9,\"code\":-1}")

@test("an enumeration is an object of its discriminator alone, every variant reading back")
enumeration()
    for c in Color.values()
        roundTrip(c, s"{\"type\":\"${c.name()}\"}")
    assertEq(json.decode[Vector[Color]]("[{\"type\":\"Blue\"},{\"type\":\"Red\"}]"), Ok([Blue, Red]))

@test("a type of one variant without fields is the empty object")
marker()
    roundTrip(Marker, "{}")
    assertEq(json.decode[Marker](" { \"extra\" : [1, {}] } "), Ok(Marker))

@test("a generic type encodes at each of its instances, its own instances nested")
generic()
    roundTrip(Box(1), "{\"item\":1}")
    roundTrip(Box("s"), "{\"item\":\"s\"}")
    roundTrip(Box(Box(Some(2))), "{\"item\":{\"item\":2}}")
    roundTrip(Box[Option[int]](None), "{\"item\":null}")
    roundTrip(Pair(Color.Green, [1, 2]), "{\"first\":{\"type\":\"Green\"},\"second\":[1,2]}")
    roundTrip(Box(Pair[Shape, string](Empty, "")), "{\"item\":{\"first\":{\"kind\":\"Empty\"},\"second\":\"\"}}")

@test("a recursive type encodes through the list of its own type")
recursive()
    val tree = Tree("root", [Tree("a", []), Tree("b", [Tree("c", [])])])
    roundTrip(tree, "{\"label\":\"root\",\"children\":[{\"label\":\"a\",\"children\":[]},{\"label\":\"b\",\"children\":[{\"label\":\"c\",\"children\":[]}]}]}")

@test("every built-in type: bool, int, long, real and string")
scalars()
    roundTrip(Scalars(true, -7, 9000000000, 0.5, "hi"), "{\"b\":true,\"i\":-7,\"n\":9000000000,\"x\":0.5,\"s\":\"hi\"}")
    roundTrip(Scalars(false, 0, 0, 0.0, ""), "{\"b\":false,\"i\":0,\"n\":0,\"x\":0.0,\"s\":\"\"}")

@test("a value at the top is any encodable type, not only a derived one")
topLevel()
    roundTrip(42, "42")
    roundTrip("x", "\"x\"")
    roundTrip(true, "true")
    roundTrip(2.5, "2.5")
    roundTrip([Some(1), None], "[1,null]")
    roundTrip(Vector.empty[int](), "[]")

@test("an Option is null for None; an absent Option field is None; Some(None) writes null and reads as None")
options()
    roundTrip(Optional(Some(1), Some(Some(2)), Some(Address("s", "c"))), "{\"a\":1,\"b\":2,\"c\":{\"street\":\"s\",\"city\":\"c\"}}")
    roundTrip(Optional(None, None, None), "{\"a\":null,\"b\":null,\"c\":null}")
    assertEq(json.decode[Optional]("{}"), Ok(Optional(None, None, None)))
    assertEq(json.encode(Optional(None, Some(None), None)), "{\"a\":null,\"b\":null,\"c\":null}")

@test("vectors and lists are arrays, empty, of one and of many, nested and of a sum type")
lists()
    roundTrip(Lists([], [], []), "{\"v\":[],\"l\":[],\"nested\":[]}")
    roundTrip(Lists([1], ["a"], [[]]), "{\"v\":[1],\"l\":[\"a\"],\"nested\":[[]]}")
    roundTrip(Lists([1, 2, 3], ["a", "b"], [[Empty], [Circle(1.0), Empty]]), "{\"v\":[1,2,3],\"l\":[\"a\",\"b\"],\"nested\":[[{\"kind\":\"Empty\"}],[{\"kind\":\"circle\",\"radius\":1.0},{\"kind\":\"Empty\"}]]}")

@test("maps are objects, keyed by strings or by integers written as their digits")
maps()
    val m = Maps(HashMap(("one", 1)), TreeMap((2, "two"), (-1, "minus")), TreeMap((long(9223372036854775807), true)))
    roundTrip(m, "{\"byName\":{\"one\":1},\"byId\":{\"-1\":\"minus\",\"2\":\"two\"},\"big\":{\"9223372036854775807\":true}}")
    roundTrip(Maps(HashMap.empty[string, int](), TreeMap.empty[int, string](), TreeMap.empty[long, bool]()), "{\"byName\":{},\"byId\":{},\"big\":{}}")
    val many = json.decode[HashMap[string, int]]("{\"a\":1,\"b\":2,\"c\":3,\"a\":4}").ok().get()
    assertEq(many.size, 3)
    assertEq(many.get("a"), Some(4))
    assertEq(json.decode[TreeMap[string, Vector[int]]]("{\"z\":[],\"y\":[1]}").map(t -> t.keys.toVector), Ok(["y", "z"]))

@test("a Json field holds any value, read and written whole")
raw()
    roundTrip(Raw(1, Json.obj(("a", Json.arr(Json.Null, Json.num(2.5))))), "{\"id\":1,\"payload\":{\"a\":[null,2.5]}}")
    roundTrip(Raw(2, Json.Null), "{\"id\":2,\"payload\":null}")

@test("a field absent from the input takes its default, which sees the fields before it")
defaults()
    assertEq(json.decode[Defaults]("{\"a\":1}"), Ok(Defaults(1, 2, "c", [])))
    assertEq(json.decode[Defaults]("{\"b\":5,\"a\":1}"), Ok(Defaults(1, 5, "c", [])))
    roundTrip(Defaults(3, 0, "", [4]), "{\"a\":3,\"b\":0,\"c\":\"\",\"d\":[4]}")

@test("fields are read in any order, and keys no field has are skipped whatever their values")
anyOrder()
    assertEq(json.decode[Address]("{\"city\":\"c\",\"street\":\"s\"}"), Ok(Address("s", "c")))
    assertEq(json.decode[Address]("{\"x\":{\"street\":1,\"y\":[[],[{}]]},\"city\":\"c\",\"n\":null,\"street\":\"s\",\"t\":true,\"z\":-1.5e3}"), Ok(Address("s", "c")))
    assertEq(json.decode[Address](" \n\t{ \"street\" : \"s\" ,\r\n \"city\":\"c\" } \n"), Ok(Address("s", "c")))

@test("a class encodes its constructor parameters, plain, val and var alike, and decodes through its constructor")
classes()
    val a = Account(7, "ada", 1.5)
    assertEq(json.encode(a), "{\"id\":7,\"owner\":\"ada\",\"balance\":1.5}")
    val back = json.decode[Account]("{\"balance\":1.5,\"owner\":\"ada\",\"id\":7}").ok().get()
    assertEq((back.id, back.ownerName(), back.balance, back.label), (long(7), "ada", 1.5, "ada#7"))

@test("a repeated parameter is a vector field")
repeated()
    assertEq(json.encode(Tags("t", "a", "b")), "{\"name\":\"t\",\"tags\":[\"a\",\"b\"]}")
    assertEq(json.encode(Tags("t")), "{\"name\":\"t\",\"tags\":[]}")
    assertEq(json.decode[Tags]("{\"name\":\"t\",\"tags\":[\"x\"]}").map(t -> t.describe()), Ok("t x"))

@test("an open class encodes, and a subclass encodes as its superclass")
openClass()
    assertEq(json.encode(Base(1)), "{\"n\":1}")
    assertEq(json.encode(Derived(4)), "{\"n\":8}")
    assertEq(json.encode[Base](Derived(5)), "{\"n\":10}")

@test("a union field encodes as the member it holds")
unions()
    assertEq(json.encode(Mixed(3)), "{\"value\":3}")
    assertEq(json.encode(Mixed("three")), "{\"value\":\"three\"}")
