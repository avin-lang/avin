module dev.avinlang.compiler
@tests

import sh.sysl.parsing.source_of

// Where a diagnostic points, and how many one mistake makes. A mistake in calling or reading a
// member is shown at the member's name and its arguments, not across a receiver chain that may
// span many lines; a mistake the parser meets is reported once, saying what was meant where the
// token shows it, and reading resumes after it, so a separate mistake later is still reported.

/** The parser's diagnostics for `text`, rendered as `avin check` shows them. */
private parsed_diagnostics(text: string) -> string
    val src = source_of("test.avin", text)
    parse(src).report.render(src)

/** The diagnostics `avin check` renders for `text`, or "" when it compiles. */
private checked_diagnostics(text: string) -> string = lower_source(repository_toolchain(), source_of("test.avin", text)) match
    Ok(_) -> ""
    Err(d) -> d

/** How many errors `rendered` holds. */
private errors_in(rendered: string) -> usize
    var n = 0usize
    for line in rendered.split("\n")
        if line.starts_with("error: ") then n += 1
    n

/** The rendered block of one error: its message, its place and the line underlined. */
private shown(message: string, line: usize, column: usize, text: string, carets: string) -> string
    val number = s"$line"
    var pad = ""
    for i in 0..<number.bytes.len do pad = pad + " "
    var under = ""
    for i in 1..<column do under = under + " "
    s"error: $message\n$pad--> test.avin:$line:$column\n$pad |\n$number | $text\n$pad | $under$carets\n"

private assert_one(rendered: string, block: string)
    if errors_in(rendered) != 1 || !rendered.contains(block) then panic(s"expected exactly\n$block\ngot\n$rendered")

private assert_has(rendered: string, count: usize, block: string)
    if errors_in(rendered) != count || !rendered.contains(block) then panic(s"expected $count errors with\n$block\ngot\n$rendered")

// ---- one parse mistake, one error ----

@test("`Map(k -> v)` is one error saying how a map is written")
map_with_arrows_is_one_error()
    val src = "main()\n    val m = Map(\"a\" -> 1, \"b\" -> 2)\n    println(m)\n"
    assert_one(parsed_diagnostics(src), shown("write a map as `{\"a\": 1}`: a key and its value are joined by `:` inside braces, not by `->`", 2, 21, "    val m = Map(\"a\" -> 1, \"b\" -> 2)", "^^"))

@test("any callee named for a map takes the map hint, and the arrow in a later argument is the one shown")
map_hint_for_every_map_name()
    val tree = "main()\n    val m = TreeMap(\"a\" -> 1)\n"
    assert_one(parsed_diagnostics(tree), shown("write a map as `{\"a\": 1}`: a key and its value are joined by `:` inside braces, not by `->`", 2, 25, "    val m = TreeMap(\"a\" -> 1)", "^^"))
    val hash = "main()\n    val m = HashMap((\"x\", 0), \"é\" -> 1)\n"
    assert_one(parsed_diagnostics(hash), shown("write a map as `{\"a\": 1}`: a key and its value are joined by `:` inside braces, not by `->`", 2, 35, "    val m = HashMap((\"x\", 0), \"é\" -> 1)", "^^"))
    val member = "main()\n    val m = avin.collections.Map(1 -> 2)\n"
    assert(errors_in(parsed_diagnostics(member)) == 1)
    assert(parsed_diagnostics(member).contains("write a map as `{\"a\": 1}`"))

@test("`->` between two values elsewhere is one error saying how a pair and a map are written")
arrow_pair_is_one_error()
    val pair = "`->` does not pair two values: write a pair as `(a, b)`, and a map as `{\"a\": 1}`"
    assert_one(parsed_diagnostics("main()\n    println(1 -> 2)\n"), shown(pair, 2, 15, "    println(1 -> 2)", "^^"))
    assert_one(parsed_diagnostics("main()\n    val p = (\"a\" -> 1)\n"), shown(pair, 2, 18, "    val p = (\"a\" -> 1)", "^^"))
    assert_one(parsed_diagnostics("main()\n    val p = (0, \"a\" -> 1, 2)\n"), shown(pair, 2, 21, "    val p = (0, \"a\" -> 1, 2)", "^^"))

@test("a type written on an argument or a group is an ascription, which parses")
ascriptions_parse()
    assert_eq(parsed_diagnostics("main()\n    val t = [3, 1, 2].foldLeft(Leaf: Tree[int], insert)\n    println(t)\n"), "")
    assert_eq(parsed_diagnostics("main()\n    show(1: int)\n"), "")
    assert_eq(parsed_diagnostics("main()\n    ((x: long) -> x)(1: long)\n"), "")
    assert_eq(parsed_diagnostics("main()\n    val n = (x: long) + 1\n"), "")

@test("a refused ascription is one error at its value, saying it converts nothing and how to convert")
refused_ascription_is_one_error()
    val src = "main()\n    val n = 3\n    val m = (n: long) + 1\n    println(m)\n"
    assert_one(checked_diagnostics(src), shown("cannot give this `int` the type `long`: an ascription converts nothing; write `long(n)`", 3, 14, "    val m = (n: long) + 1", "^"))
    val narrow = "open class A\nclass B : A\nmain()\n    val b = (A(): B)\n    println(b)\n"
    assert_one(checked_diagnostics(narrow), shown("cannot give this `A` the type `B`: an ascription only widens, and `B` is narrower; test the value with `is` or `match`", 4, 14, "    val b = (A(): B)", "^^^"))
    assert_one(checked_diagnostics("main()\n    println((\"é\": int))\n"), shown("cannot give this `string` the type `int`", 2, 14, "    println((\"é\": int))", "^^^"))

@test("a lambda's typed parameter written without parentheses is one error showing them")
unparenthesized_typed_lambda_is_one_error()
    assert_one(parsed_diagnostics("main()\n    val ys = [1].map(x: int -> x + 1)\n"), shown("a lambda's parameter with a type is written in parentheses: `(x: int) -> …`", 2, 23, "    val ys = [1].map(x: int -> x + 1)", "^^^^^"))

@test("`=>` in an argument list is reported once, by the lexer")
fat_arrow_argument_is_one_error()
    val rendered = parsed_diagnostics("main()\n    val ys = [1].map(x => x + 1)\n")
    assert_one(rendered, shown("function arrows are written `->`", 2, 24, "    val ys = [1].map(x => x + 1)", "^^"))

@test("a stray token in an argument list is one error, and the rest of the list is skipped")
stray_argument_token_is_one_error()
    assert_one(parsed_diagnostics("main()\n    println(1 2 \"ü\" [3])\n"), shown("expected `)`", 2, 15, "    println(1 2 \"ü\" [3])", "^ found `2`"))
    assert_one(parsed_diagnostics("main()\n    val a = (1 2) 3 4 5\n"), shown("expected `)`", 2, 16, "    val a = (1 2) 3 4 5", "^ found `2`"))

@test("a line that could not be read is reported once, and the rest of it is skipped")
broken_line_is_one_error()
    assert_one(parsed_diagnostics("main()\n    val a = 1 2 3 4\n    println(a)\n"), shown("expected a new line between block items", 2, 15, "    val a = 1 2 3 4", "^"))
    // A line whose own mistake was reported adds nothing for the tokens after it.
    assert(errors_in(parsed_diagnostics("main()\n    val a = (1 2) 3 4 5\n    val b = f(1 2) 3\n")) == 2)

@test("a class's, an actor's and a machine's member line that could not be read is reported once")
broken_member_line_is_one_error()
    assert_one(parsed_diagnostics("class C()\n    val a = 1 2 3\n"), shown("expected a new line between class members", 2, 15, "    val a = 1 2 3", "^"))
    assert(errors_in(parsed_diagnostics("class C()\n    val m = Map(1 -> 2) 3 4\n")) == 1)
    val actor = parsed_diagnostics("actor A() receives int\n    var n = 1 2 3\n    receive\n        _ -> ()\n")
    assert_one(actor, shown("expected a new line between an actor's members", 2, 15, "    var n = 1 2 3", "^"))
    assert(errors_in(parsed_diagnostics("actor A() receives int\n    var n = f(1: int) 2 3\n    receive\n        _ -> ()\n")) == 1)
    val machine = parsed_diagnostics("machine M receives int\n    var n = 1 2 3\n    state Ready\n        _ -> stay\n")
    assert_one(machine, shown("expected a new line between a machine's members", 2, 15, "    var n = 1 2 3", "^"))
    assert(errors_in(parsed_diagnostics("machine M receives int\n    var n = Map(1 -> 2) 3\n    state Ready\n        _ -> stay\n")) == 1)

// ---- recovery keeps later mistakes ----

@test("after a mistake is recovered from, a separate mistake in a later statement is still reported")
later_statements_still_reported()
    val src = "main()\n    val m = Map(\"a\" -> 1)\n    val a = 1 2 3\n    show(1 2)\n    println(2 -> 3)\n"
    val rendered = parsed_diagnostics(src)
    assert_has(rendered, 4, shown("write a map as `{\"a\": 1}`: a key and its value are joined by `:` inside braces, not by `->`", 2, 21, "    val m = Map(\"a\" -> 1)", "^^"))
    assert(rendered.contains(shown("expected a new line between block items", 3, 15, "    val a = 1 2 3", "^")))
    assert(rendered.contains(shown("expected `)`", 4, 12, "    show(1 2)", "^ found `2`")))
    assert(rendered.contains(shown("`->` does not pair two values: write a pair as `(a, b)`, and a map as `{\"a\": 1}`", 5, 15, "    println(2 -> 3)", "^^")))

@test("an argument list read on after its mistake reports a separate one later on the same line")
same_line_after_argument_list()
    val rendered = parsed_diagnostics("main()\n    val n = f(1 -> 2) + g(3 -> 4)\n")
    assert_has(rendered, 2, shown("`->` does not pair two values: write a pair as `(a, b)`, and a map as `{\"a\": 1}`", 2, 17, "    val n = f(1 -> 2) + g(3 -> 4)", "^^"))
    assert(rendered.contains(shown("`->` does not pair two values: write a pair as `(a, b)`, and a map as `{\"a\": 1}`", 2, 29, "    val n = f(1 -> 2) + g(3 -> 4)", "^^")))

@test("a mistake in a nested block, in a later declaration and in a class member are each reported")
mistakes_in_nested_blocks_and_declarations()
    val src = "main()\n    if true\n        val y = 1 2\n    val m = Map(1 -> 2)\nclass C()\n    val a = 1 2\nf() -> int = g(1 2)\n"
    val rendered = parsed_diagnostics(src)
    assert_has(rendered, 4, shown("expected a new line between block items", 3, 19, "        val y = 1 2", "^"))
    assert(rendered.contains(shown("write a map as `{\"a\": 1}`: a key and its value are joined by `:` inside braces, not by `->`", 4, 19, "    val m = Map(1 -> 2)", "^^")))
    assert(rendered.contains(shown("expected a new line between class members", 6, 15, "    val a = 1 2", "^")))
    assert(rendered.contains(shown("expected `)`", 7, 18, "f() -> int = g(1 2)", "^ found `2`")))

@test("the forms the hints name are read without an error")
hinted_forms_parse()
    assert(parsed_diagnostics("main()\n    val m = {\"a\": 1, \"b\": 2}\n    val p = (\"a\", 1)\n    val t = [3, 1].foldLeft[int](0, (a, b) -> a + b)\n    val ys = [1].map((x: int) -> x + 1)\n    val g = (1)\n") == "")

// ---- a member's mistake is shown at the member ----

@test("`m()` for a parameterless member in a chain underlines the member and its parentheses")
parameterless_call_in_chain()
    val rendered = checked_diagnostics("main()\n    println([1, 2].map(_ * 2).toVector())\n")
    assert_one(rendered, shown("`toVector` takes no parameter list, so it is called without parentheses: write `toVector`, not `toVector()`", 2, 31, "    println([1, 2].map(_ * 2).toVector())", "^^^^^^^^^^"))

@test("a missing member called on a chain of leading-`.` lines is shown on its own line")
missing_member_on_continuation_line()
    val rendered = checked_diagnostics("main()\n    val xs = [3, 1, 2]\n        .map(_ * 2)\n        .filter(_ > 2)\n        .frob(1, 2)\n    println(xs)\n")
    assert_one(rendered, shown("`Vector` has no member `frob`", 5, 10, "        .frob(1, 2)", "^^^^"))

@test("an argument count mistake in a parenthesized chain underlines the member and its arguments")
arity_in_parenthesized_chain()
    val rendered = checked_diagnostics("main()\n    val xs = ([3, 1, 2]\n        .map(_ * 2)\n        .filter(_ > 2, 3))\n    println(xs)\n")
    assert_one(rendered, shown("`filter` takes 1 argument, not 2", 4, 10, "        .filter(_ > 2, 3))", "^^^^^^^^^^^^^^^^"))

@test("a missing member read with no call is shown at its name")
missing_member_read()
    val rendered = checked_diagnostics("main()\n    val xs = [3, 1, 2]\n        .map(_ * 2)\n        .frob\n    println(xs)\n")
    assert_one(rendered, shown("`Vector` has no member `frob`", 4, 10, "        .frob", "^^^^"))
    val one_line = checked_diagnostics("main()\n    println(\"é\".trim.frob)\n")
    assert_one(one_line, shown("string has no field `frob`", 2, 22, "    println(\"é\".trim.frob)", "^^^^"))

@test("a private method called in a chain is shown at its name")
private_member_in_chain()
    val src = "class C()\n    private secret() -> int = 1\n    me() -> C = self\nmain()\n    println(C().me().secret())\n"
    assert_one(checked_diagnostics(src), shown("`secret` is private to `C`", 5, 22, "    println(C().me().secret())", "^^^^^^"))

@test("a value of the wrong type is still shown across the whole expression")
type_mismatch_covers_the_expression()
    val read = checked_diagnostics("main()\n    val n: int = [1].map(_ * 2).toVector\n    println(n)\n")
    assert_one(read, shown("expected int, found Vector[int]", 2, 18, "    val n: int = [1].map(_ * 2).toVector", "^^^^^^^^^^^^^^^^^^^^^^^"))
    val call = checked_diagnostics("main()\n    val n: int = [1].map(_ * 2).take(1)\n    println(n)\n")
    assert_one(call, shown("expected int, found Vector[int]", 2, 18, "    val n: int = [1].map(_ * 2).take(1)", "^^^^^^^^^^^^^^^^^^^^^^"))
