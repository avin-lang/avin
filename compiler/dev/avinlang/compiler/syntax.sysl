module dev.avinlang.compiler

import sh.sysl.parsing.Span
import sysl.buf.Buf

// The syntax tree. It records what the source says and where, and makes no decision that needs
// name lookup: whether a bare name in a pattern is a binding or a constructor, for example, is
// decided by the resolver.

struct Expr
    span: Span
    kind: ExprKind

enum ExprKind
    Invalid
    UnitLit
    /** An integer literal's spelling (`42`, `0x2a`, `1_000`); its width comes from context. */
    IntLit(spelling: string)
    RealLit(value: real)
    CharLit(value: char)
    StringLit(value: string)
    /** An interpolated string, `name"…"`: the literal text around the holes, one more piece than
     * there are holes, with escapes decoded, and the expressions in the holes. */
    Interpolate(prefix: string, chunks: Buf[string], holes: Buf[&Expr])
    BoolLit(value: bool)
    Name(name: string)
    Tuple(items: Buf[&Expr])
    ListLit(items: Buf[&Expr])
    SetLit(items: Buf[&Expr])
    MapLit(keys: Buf[&Expr], values: Buf[&Expr])
    /** A block yields its last item, unless `discard` is set, in which case it yields `unit`. */
    Block(items: Buf[&Expr], discard: bool)
    Binding(name: string, declared: Option[&TypeExpr], value: &Expr, mutable: bool)
    /** `val a, b = value` or `val (a, b) = value`: a binding that takes a value apart by a pattern. */
    Destructure(pattern: &Pattern, declared: Option[&TypeExpr], value: &Expr, mutable: bool)
    LocalFunction(declaration: &Function)
    Lambda(params: Buf[LambdaParam], body: &Expr)
    /** `=` and its compound forms; `yields` marks the `:=` family, which yields the stored value.
     * `op_span` is the assignment operator's, where a failing compound operation is reported. */
    Assign(target: &Expr, op: Option[BinaryOp], value: &Expr, yields: bool, op_span: Span)
    /** `a, b = b, a`: assigns each target a part of a tuple, all after the value is complete. */
    MultiAssign(targets: Buf[&Expr], op: Option[BinaryOp], value: &Expr, op_span: Span)
    /** `++` or `--`; `op_span` is the operator's. */
    Update(target: &Expr, increment: bool, postfix: bool, op_span: Span)
    If(condition: &Expr, yes: &Expr, no: Option[&Expr])
    While(condition: &Expr, body: &Expr, otherwise: Option[&Expr])
    Loop(body: &Expr)

    /** `do body while condition`: the body runs once before the first test, and `continue` reaches the test. */
    DoWhile(body: &Expr, condition: &Expr, otherwise: Option[&Expr])
    /** `for pattern in source body`: the body runs once for each element of `source`, a range, an
     * array or any `Iterable`, with the element bound by `pattern`. */
    For(pattern: &Pattern, source: &Expr, body: &Expr)
    /** `for x in xs, y in ys if x < y yield (x, y)`: generators in order, each with the guards
     * written after it, and the value yielded for each combination of elements that passes them. */
    ForYield(generators: Buf[Generator], body: &Expr)
    Break(value: Option[&Expr])
    Continue
    Return(value: Option[&Expr])
    Match(subject: &Expr, arms: Buf[Arm])
    Unary(op: UnaryOp, operand: &Expr)
    /** `op_span` is the operator's, where a failing operation is reported. */
    Binary(op: BinaryOp, left: &Expr, right: &Expr, op_span: Span)
    /** `a < b <= c`: one more operand than operators, each middle operand evaluated once. */
    Compare(operands: Buf[&Expr], ops: Buf[CompareOp])
    Range(lower: &Expr, upper: &Expr, inclusive: bool)
    /** `head :: tail`: a new list with `head` in front of `tail`; `op_span` is the operator's. */
    Cons(head: &Expr, tail: &Expr, op_span: Span)
    Is(value: &Expr, pattern: &Pattern, negated: bool)
    Propagate(value: &Expr)
    Call(callee: &Expr, args: Buf[Argument])
    Member(target: &Expr, name: string)
    /** `a max b`, the call `a.max(b)` written infix: always a method of `target`, with one argument. */
    InfixCall(target: &Expr, name: string, name_span: Span, arg: &Expr)
    TupleIndex(target: &Expr, index: usize)
    TypeApply(target: &Expr, args: Buf[&TypeExpr])
end ExprKind

enum UnaryOp
    Negate
    Plus
    Not
    Complement

enum BinaryOp
    Add
    Subtract
    Multiply
    Divide
    Remainder
    ShiftLeft
    ShiftRight
    AddWrapping
    SubtractWrapping
    MultiplyWrapping
    AddSaturating
    SubtractSaturating
    MultiplySaturating
    BitAnd
    BitOr
    BitXor
    And
    Or

enum CompareOp
    Equal
    NotEqual
    Same
    NotSame
    Less
    LessEqual
    Greater
    GreaterEqual

/** A call argument, positional or named (`create = true`). */
struct Argument
    span: Span
    name: Option[string]
    value: &Expr

/** One generator of a `for` with `yield`, `pattern in source`, and the `if` guards after it. */
struct Generator
    span: Span
    pattern: &Pattern
    source: &Expr
    guards: Buf[&Expr]

struct LambdaParam
    span: Span
    name: string
    declared: Option[&TypeExpr]

struct TypeExpr
    span: Span
    kind: TypeExprKind

enum TypeExprKind
    InvalidType
    /** A possibly qualified name with type arguments: `int`, `List[T]`, `avin.io.File`. */
    Named(path: string, args: Buf[&TypeExpr])
    Tuple(items: Buf[&TypeExpr])
    Function(params: Buf[FunctionTypeParam], result: &TypeExpr)

struct FunctionTypeParam
    ty: &TypeExpr
    by_name: bool

struct Pattern
    span: Span
    kind: PatternKind

enum PatternKind
    InvalidPattern
    Wildcard
    /** A bare name: a binding, or a constructor with no fields; the resolver decides. */
    Name(name: string)
    /** A literal, possibly a negated number. */
    Literal(value: &Expr)
    Constructor(path: string, args: Buf[&Pattern])
    Tuple(items: Buf[&Pattern])
    /** `head :: tail`: a non-empty list, its first element matching `head` and the rest `tail`. */
    Cons(head: &Pattern, tail: &Pattern)
    /** `[a, b]`: a sequence of exactly as many elements, each matching its pattern; `[]` is empty. */
    Sequence(items: Buf[&Pattern])
    Alternatives(options: Buf[&Pattern])
    /** `name @ pattern` binds the whole matched value. */
    Named(name: string, pattern: &Pattern)
    Range(lower: &Expr, upper: &Expr, inclusive: bool)
    /** `n + k`: an integer of at least the literal `k`, binding `n` to how far above `k` it is.
     * `binder` is a name or `_`. */
    Successor(binder: &Pattern, amount: &Expr)
    /** A comparison pattern, `n < k`, `n >= k` or `lo <= n < hi`: a value within the bounds,
     * bound to `binder`, a name or `_`. */
    Bounded(binder: &Pattern, lower: Option[PatternBound], upper: Option[PatternBound])
    /** A type pattern, `x: T`: a value whose type at run time is `T`, bound to `binder`, a name or
     * `_`. */
    Typed(binder: &Pattern, ty: &TypeExpr)

/** One bound of a comparison pattern: a literal, and whether the value may equal it. */
struct PatternBound
    value: &Expr
    inclusive: bool

struct Arm
    pattern: &Pattern
    guard: Option[&Expr]
    body: &Expr

struct Param
    span: Span
    pattern: &Pattern
    ty: &TypeExpr
    default: Option[&Expr]
    by_name: bool
    variadic: bool

/** How a type's instances relate when its argument's do: `+T` is covariant, `-T` contravariant. */
enum Variance
    Invariant
    Covariant
    Contravariant

struct TypeParam
    span: Span
    name: string
    variance: Variance
    bounds: Buf[&TypeExpr]
    /** Which declaration of a type parameter this is, unique in the program: the file and the place
     * in it for a written one. The bounds an impl gives a parameter are known by it, so two impls of
     * one type keep theirs apart wherever each is declared. */
    site: string

struct AnnotationArg
    name: Option[string]
    value: &Expr

struct Annotation
    span: Span
    name: string
    args: Buf[AnnotationArg]

/** A function: a signature, then a body or the clauses on the lines after it. A function with
 * neither is a declaration that an annotation such as `@intrinsic` gives meaning to. */
struct Function
    annotations: Buf[Annotation]
    span: Span
    name_span: Span
    name: string
    type_params: Buf[TypeParam]
    params: Buf[Param]
    result: Option[&TypeExpr]
    body: Option[&Expr]
    clauses: Buf[Clause]

/** `name(patterns) = body`: one clause of a function, taken when its patterns match the arguments
 * and one of its bodies' guards holds. */
struct Clause
    span: Span
    patterns: Buf[&Pattern]
    bodies: Buf[GuardedBody]

/** A clause body, with the guard that selects it; a body with no guard is always taken. */
struct GuardedBody
    guard: Option[&Expr]
    body: &Expr

struct Variant
    span: Span
    name: string
    fields: Buf[Param]

struct DataDecl
    annotations: Buf[Annotation]
    span: Span
    name: string
    type_params: Buf[TypeParam]
    variants: Buf[Variant]
    derives: Buf[&TypeExpr]

/** A class parameter, which is also a field. A plain parameter is a private, immutable field; `val`
 * makes it public, `var` public and mutable, and `private var` mutable but private. */
struct ClassParam
    param: Param
    mutable: bool
    public: bool

/** A field the class body declares with `val` or `var`, initialized where it is written when an
 * instance is created; at the top level of a file, a module-level value, initialized before
 * `main` runs. */
struct FieldDecl
    span: Span
    name: string
    declared: Option[&TypeExpr]
    value: &Expr
    mutable: bool
    public: bool

/** `val name: T` with no initializer: a member a trait declares and each type conforming to it
 * supplies with a field. */
struct AbstractField
    span: Span
    name_span: Span
    name: string
    declared: &TypeExpr
    mutable: bool
    public: bool

/** One line of a class body: a field, a method, or a statement of the constructor. `overrides`
 * records an `override` modifier, and `static_member` a `static` one: a member of the type, called
 * on the type rather than on a value. */
enum ClassMember
    FieldMember(field: FieldDecl)
    AbstractFieldMember(field: AbstractField)
    MethodMember(method: &Function, public: bool, overrides: bool, static_member: bool)
    StatementMember(statement: &Expr)

/** A class: its parameters are its constructor's and its fields, and its body is the constructor's
 * body together with its field and method declarations. `modifier` is `open`, `abstract` or empty;
 * `parents` are what follows `:`, a superclass with its constructor arguments and traits. An
 * `object` is declared as a class with `object` set: it has no type or value parameters, and its
 * body makes its one instance. */
struct ClassDecl
    annotations: Buf[Annotation]
    span: Span
    name_span: Span
    name: string
    modifier: string
    modifier_span: Span
    type_params: Buf[TypeParam]
    params: Buf[ClassParam]
    parents: Buf[&Expr]
    derives: Buf[&TypeExpr]
    members: Buf[ClassMember]
    object: bool

/** `impl Type` adds methods to a type; `impl Trait for Type` also makes the type conform to the
 * trait. `type_params` are the impl's own, written `impl[T] Show for Box[T]`, and its body is
 * parsed as a class body, so the checker can name the fields and statements it may not hold. */
struct ImplDecl
    span: Span
    type_params: Buf[TypeParam]
    trait_name: Option[&TypeExpr]
    target: &TypeExpr
    members: Buf[ClassMember]

struct Import
    span: Span
    path: string
    binding: string

enum Item
    FunctionItem(function: &Function)
    DataItem(data: &DataDecl)
    ClassItem(decl: &ClassDecl)
    ImplItem(decl: &ImplDecl)
    /** A module-level `val` or `var`. */
    ValueItem(decl: FieldDecl)

/** One source file. */
struct SourceFile
    /** The module its header names, or "" for a file without one. */
    module_name: string
    module_span: Span
    tests_only: bool
    imports: Buf[Import]
    items: Buf[Item]
    /** For each item, whether it is marked `private`: visible only inside its module. */
    private_items: Buf[bool]
