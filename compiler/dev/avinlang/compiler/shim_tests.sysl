module dev.avinlang.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.fs.{metadata, read_text}

// The shims of Sysl bindings: where each binding's part of the generated source is, and the cache of
// built archives.

private compiled(text: string) -> Compilation = compile(repository_toolchain(), source_of("/probe/bindings.avin", text))

private lines(text: string) -> Buf[string]
    var out: Buf[string] = buf()
    for line in text.split("\n")
        out.push(line)
    out

@test("each binding's import and function are at the lines the shim source records")
shim_lines()
    val program = lower_source(repository_toolchain(), source_of("/probe/bindings.avin", "@sysl(\"sysl.text.to_upper\")\nupper(s: string) -> string\n\n@sysl(\"sysl.prints\")\nwrite(s: string)\n\n@sysl(\"sysl.path.is_absolute\")\nabsolute(p: string) -> bool\n\nmain() = 0\n")).unwrap()
    assert_eq(program.bindings.len(), 3usize)
    val shim = shim_source(program.bindings)
    val text = lines(shim.text)
    for i in 0..<program.bindings.len()
        val b = program.bindings[i]
        assert(text[shim.imports[i] - 1].starts_with(s"import ${b.target} as bound_$i"))
        assert_eq(text[shim.first[i] - 1], s"// ${b.name}")
        assert(text[shim.first[i] + 1].starts_with(s"shim_$i("))
        // The function's last line is followed by a blank line or the end of the source.
        assert(text[shim.last[i] - 1].starts_with("    "))
        assert(shim.last[i] == text.len() - 1 || text[shim.last[i]] == "")
    // A unit result has no conversion back, so its function is a line shorter.
    assert_eq(shim.last[1] - shim.first[1], 3usize)
    assert_eq(shim.last[2] - shim.first[2], 4usize)

private const MirrorProgram: string = "@sysl(\"sysl.time.LocalDate\")\ndata LocalDate\n    LocalDate(day: int)\n\n@sysl(\"sysl.time.checked_date\")\nchecked(y: int, m: int, d: int) -> Option[LocalDate]\n\n@sysl(\"sysl.hint.black_box\")\nsame(o: Option[LocalDate]) -> Option[LocalDate]\n\n@sysl(\"sysl.hint.black_box\")\nbytes(b: Array[byte]) -> Array[byte]\n\nmain() = 0\n"

@test("each type's conversion is written once in each direction, and a mirror's lines are its own")
shim_conversions()
    val program = lower_source(repository_toolchain(), source_of("/probe/mirrors.avin", MirrorProgram)).unwrap()
    val shim = shim_source(program.bindings)
    val text = lines(shim.text)
    // Two bindings return an `Option[LocalDate]` and one takes one: one conversion each way for it
    // and one for the mirror inside it.
    var outs = 0
    var ins = 0
    for line in text
        if line.starts_with("private out_") then outs += 1
        if line.starts_with("private in_") then ins += 1
    assert_eq(outs, 2)
    assert_eq(ins, 2)
    assert_eq(shim.mirrors.len(), 1usize)
    assert_eq(shim.mirrors[0].target, "sysl.time.LocalDate")
    // The mirror's import, and the first line of each of its conversions, are among its lines.
    var import_owned = false
    var conversions = 0
    for part in shim.mirror_lines
        if text[part.first - 1] == "import sysl.time.LocalDate as mirror_0" then import_owned = true
        if text[part.first - 1].starts_with("// LocalDate ") then conversions += 1
    assert(import_owned)
    assert_eq(conversions, 2)
    // An array of bytes is copied in bulk, and the result's layouts follow its parameters.
    assert(shim.text.contains("copy(out, array_elements(p)[0..<n])"))
    assert(shim.text.contains("bytes_of(ctx, r, d0)"))

@test("a binding's result is made by the layouts its body passes after its parameters")
shim_layouts()
    val program = lower_source(repository_toolchain(), source_of("/probe/mirrors.avin", MirrorProgram)).unwrap()
    for b in program.bindings
        // `Option[LocalDate]`: `Some`, `None`, then `LocalDate`'s one variant; an array, its descriptor.
        if b.name == "checked" || b.name == "same" then assert_eq(b.result.layouts, 3usize)
        if b.name == "bytes" then assert_eq(b.result.layouts, 1usize)
        assert(b.result.variants.len() == 0 || b.result.variants[0].fields[0].base == 2usize)

private const CollectionProgram: string =
    "@sysl(\"sysl.text.split\")\nsplit(s: string, sep: string) -> Vector[string]\n\n" +
    "@sysl(\"sysl.path.join_all\")\njoin(parts: Array[string]) -> string\n\n" +
    "@sysl(\"sysl.hint.black_box\")\nmaybe(o: Option[Vector[int]]) -> Option[Vector[int]]\n\nmain() = 0\n"

@test("a collection goes into Sysl as a slice and comes out of a slice or a Buf, by its layouts")
shim_collections()
    val program = lower_source(repository_toolchain(), source_of("/probe/collections.avin", CollectionProgram)).unwrap()
    for b in program.bindings
        // A vector: its array's descriptor, then the core library's functions that make one of an
        // array, give its length and give a leaf. An array: its descriptor alone.
        if b.name == "split" then assert_eq(b.result.layouts, 4usize)
        if b.name == "join" then assert_eq(b.params[0].layouts, 1usize)
        // `Some` and `None`, then the vector's four, for the parameter as for the result.
        if b.name == "maybe"
            assert_eq(b.result.layouts, 6usize)
            assert_eq(b.result.variants[0].fields[0].base, 2usize)
            assert_eq(b.params[0].layouts, 6usize)
    val text = shim_source(program.bindings).text
    // A parameter's layouts are passed after the parameters, and before the result's.
    assert(text.contains("(ctx: *Context, a0: *u8, e0_0: *u8, e0_1: *u8, e0_2: *u8, e0_3: *u8, e0_4: *u8, e0_5: *u8, d0: *u8"))
    assert(text.contains("    val ep0: **u8 = ptr_cast(&es0)"))
    // Into Sysl, a vector is read a leaf at a time; out of Sysl, it is made of an array.
    assert(text.contains("val leaf_of: *extern(*Context, *u8, i32) -> *u8 = ptr_cast(ds[3])\n"))
    assert(text.contains("    val made = of_array(ctx, root.object)\n"))
    assert(text.contains("import sysl.buf.{Buf, buf}"))
    assert(text.contains(", v: []string, ds: **u8) -> *u8\n"))
    assert(text.contains(", v: Buf[string], ds: **u8) -> *u8 = out_"))
    assert(text.contains(", v: Option[[]int], ds: **u8) -> *u8\n"))
    assert(text.contains(", v: Option[Buf[int]], ds: **u8) -> *u8\n"))
    assert(text.contains("(ctx: *Context, p: *u8, ds: **u8) -> []string\n"))
    assert(text.contains("(ctx: *Context, p: *u8, ds: **u8) -> Option[[]int]\n"))
    // A result that may be either is not given a type of its own; one that is one type is.
    assert(text.contains("    val r = bound_0("))
    assert(text.contains("    val r: string = bound_1("))

@test("a mirror's lowerCamelCase field is matched to the snake_case Sysl field of the same words")
mirror_field_names()
    assert_eq(sysl_field_of("restArePositional"), "rest_are_positional")
    assert_eq(sysl_field_of("utf8Offset"), "utf8_offset")
    assert_eq(sysl_field_of("day"), "day")
    assert_eq(sysl_field_of("parseURL"), "parse_u_r_l")

@test("a binding's shim is built once and found in the cache after that")
shim_cache()
    val text = "@sysl(\"sysl.text.to_lower\")\nlower(s: string) -> string\n\nmain() = 0\n"
    val first = compiled(text)
    assert_eq(first.diagnostics, "")
    val archive = first.archive.unwrap()
    val built = metadata(archive).unwrap().modified
    // The same bindings in another program are the same shims, which are not built again.
    val second = compiled("// another program with the same binding\n" + text)
    assert_eq(second.archive.unwrap(), archive)
    assert(metadata(archive).unwrap().modified == built)
    // Another binding is another archive.
    val other = compiled("@sysl(\"sysl.text.to_upper\")\nlower(s: string) -> string\n\nmain() = 0\n")
    assert(other.archive.unwrap() != archive)

@test("a program without bindings links the runtime's own archive")
no_shims()
    val c = compiled("main() = 0\n")
    assert_eq(c.diagnostics, "")
    assert(c.archive is None)

@test("only the library's bindings a program reaches are shims")
library_shims()
    val program = lower_source(repository_toolchain(), source_of("/probe/bindings.avin", "main()\n    println(\"a\".toUpper())\n    println(\"b\".trimEnd())\n")).unwrap()
    var targets: Buf[string] = buf()
    for b in program.bindings do targets.push(b.target)
    assert_eq(targets.len(), 2usize)
    assert(targets[0] == "sysl.text.to_upper" || targets[1] == "sysl.text.to_upper")
    assert(targets[0] == "sysl.unicode.is_space" || targets[1] == "sysl.unicode.is_space")

@test("Sysl's diagnostic of a shim is reported at the binding's name")
shim_diagnostic_place()
    val c = compiled("main() = 0\n\n@sysl(\"sysl.text.to_upper\")\nshout(s: char) -> string\n")
    assert(c.diagnostics.contains("/probe/bindings.avin:4:1"))
    assert(c.diagnostics.contains("the Sysl binding `shout` does not match `sysl.text.to_upper`: 's' of 'sysl.text.to_upper' is string, but char was given"))
    assert(c.llvm is None)

@test("a binding's shim copies strings in bulk and never byte by byte")
shim_bulk_copy()
    val program = lower_source(repository_toolchain(), source_of("/probe/bulk.avin", "@sysl(\"sysl.text.to_upper\")\nupper(s: string) -> string\n\nmain() = 0\n")).unwrap()
    val text = shim_source(program.bindings).text
    assert(text.contains("text_in(a0)"))
    assert(text.contains("text_of(ctx, r)"))
    assert(!text.contains("while"))
    assert(!text.contains("for "))
    // The runtime's copy into a new string is one slice copy.
    val runtime = read_text("runtime/avin/rt/text.sysl").unwrap()
    assert(runtime.contains("copy(to[0..<s.bytes.len], s.bytes)"))
