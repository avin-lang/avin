module dev.avinlang.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.fs.{canonicalize, exists, make_dir_all, make_temp_dir, metadata, read_text, remove_dir_all, remove_file, symlink, write_text}

// The shims of Sysl bindings: where each binding's part of the generated source is, and the cache of
// built archives.

private compiled(text: string) -> Compilation = compile(repository_toolchain(), source_of("/probe/bindings.avin", text))

private lines(text: string) -> Buf[string]
    var out: Buf[string] = buf()
    for line in text.split("\n")
        out.push(line)
    out

@test("each binding's import and function are at the lines the shim source records")
shim_lines()
    val program = lower_source(repository_toolchain(), source_of("/probe/bindings.avin", "@sysl(\"sysl.text.to_upper\")\nupper(s: string) -> string\n\n@sysl(\"sysl.prints\")\nwrite(s: string)\n\n@sysl(\"sysl.path.is_absolute\")\nabsolute(p: string) -> bool\n\nmain() = 0\n")).unwrap()
    assert_eq(program.bindings.len(), 3usize)
    val shim = shim_source(program.bindings, program.handles)
    val text = lines(shim.text)
    for i in 0..<program.bindings.len()
        val b = program.bindings[i]
        assert(text[shim.imports[i] - 1].starts_with(s"import ${b.target} as bound_$i"))
        assert_eq(text[shim.first[i] - 1], s"// ${b.name}")
        assert(text[shim.first[i] + 1].starts_with(s"shim_$i("))
        // The function's last line is followed by a blank line or the end of the source.
        assert(text[shim.last[i] - 1].starts_with("    "))
        assert(shim.last[i] == text.len() - 1 || text[shim.last[i]] == "")
    // A unit result has no conversion back, so its function is a line shorter.
    assert_eq(shim.last[1] - shim.first[1], 3usize)
    assert_eq(shim.last[2] - shim.first[2], 4usize)

@test("an integer result is converted, with a check, from whatever integer the Sysl function returns")
shim_integer_result()
    val program = lower_source(repository_toolchain(), source_of("/probe/integers.avin", "@sysl(\"sysl.math.bigint.BigInt\")\nclass BigInt\n    limbs() -> long\n    @sysl(\"limbs\")\n    limbCount() -> i8\n\n@sysl(\"sysl.math.bigint.parse\")\nparse(s: string) -> Option[BigInt]\n\nmain() -> int\n    val n = parse(\"1\").get()\n    n.limbs()\n    n.limbCount()\n    0\n")).unwrap()
    val shim = shim_source(program.bindings, program.handles)
    assert(shim.text.contains("    val r: long = integer_to(ctx, s.r.limbs(), \"long\")\n"))
    assert(shim.text.contains("    val r: i8 = integer_to(ctx, s.r.limbs(), \"i8\")\n"))

@test("a callback's integer answer is converted, with a check, into whatever integer the closure answers, unless it is fixed")
shim_callback_integer_answer()
    val program = lower_source(repository_toolchain(), source_of("/probe/answers.avin", "@sysl(\"sysl.hint.black_box\")\nanswer(f: () -> long) -> long\n\n@sysl(\"sysl.hint.black_box\")\nlabel(f: () -> string) -> string\n\nmain() -> int\n    answer(() -> 1)\n    label(() -> \"\")\n    0\n")).unwrap()
    val shim = shim_source(program.bindings, program.handles)
    assert(shim.text.contains("private call_0_0[R: Integer](cb: *Callback) -> R\n"))
    assert(shim.text.contains("    val r: R = run_0_0(e.ctx, cb)\n"))
    assert(shim.text.contains("    integer_to(ctx, r, integer_name[R]())\n"))
    // A string answer is not an integer, and is converted as before.
    assert(shim.text.contains("private call_1_0(cb: *Callback) -> string\n"))
    // Fixed, the answer is the Avin type itself.
    var fixed: Buf[string] = buf()
    fixed.push("call_0_0")
    val plain = shim_source_fixing(program.bindings, program.handles, fixed)
    assert(plain.text.contains("private call_0_0(cb: *Callback) -> long\n"))
    assert(!plain.text.contains("integer_name[R]()"))

@test("a real crosses into and out of whatever floating-point type Sysl's place is: a parameter, a result, a callback's parameter and answer, unless fixed")
shim_real_crossing()
    val program = lower_source(repository_toolchain(), source_of("/probe/reals.avin", "@sysl(\"sysl.hint.black_box\")\nsame(x: real) -> real\n\n@sysl(\"sysl.hint.black_box\")\nanswer(f: real -> real) -> real\n\n@sysl(\"sysl.hint.black_box\")\nmaybe(x: real) -> Option[real]\n\nmain() -> int\n    same(1.0)\n    answer(x -> x)\n    maybe(1.0)\n    0\n")).unwrap()
    val shim = shim_source(program.bindings, program.handles)
    assert(shim.text.contains("import sysl.math.Float\n"))
    assert(shim.text.contains("private real_in[T: Float](x: real) -> T = T(x)\n"))
    assert(shim.text.contains("private real_to[S: Float](x: S) -> real = real(x)\n"))
    assert(shim.text.contains("private param_0_0[T: Float](ctx: *Context, x: real) -> T = real_in(x)\n"))
    assert(shim.text.contains("    val r: real = real_to(bound_0(param_0_0(ctx, a0)))\n"))
    // A callback's parameter is any floating-point type, widened, and its answer any, rounded.
    assert(shim.text.contains("private call_1_0[S0: Float, R: Float](cb: *Callback, q0: S0) -> R\n"))
    assert(shim.text.contains("real_to(q0)"))
    assert(shim.text.contains("    real_in(r)\n"))
    // A real an option holds comes out of any floating-point type.
    assert(shim.text.contains("[S0: Float](ctx: *Context, v: Option[S0], ds: **u8)"))
    // Fixed, the parameter and the answer are the Avin type itself.
    var fixed: Buf[string] = buf()
    fixed.push("param_0_0")
    fixed.push("call_1_0")
    val plain = shim_source_fixing(program.bindings, program.handles, fixed)
    assert(!plain.text.contains("private param_0_0["))
    assert(plain.text.contains("(cb: *Callback, q0: S0) -> real\n"))

private const MirrorProgram: string = "@sysl(\"sysl.time.LocalDate\")\ndata LocalDate\n    LocalDate(day: int)\n\n@sysl(\"sysl.time.checked_date\")\nchecked(y: int, m: int, d: int) -> Option[LocalDate]\n\n@sysl(\"sysl.hint.black_box\")\nsame(o: Option[LocalDate]) -> Option[LocalDate]\n\n@sysl(\"sysl.hint.black_box\")\nbytes(b: Array[byte]) -> Array[byte]\n\nmain() = 0\n"

@test("each type's conversion is written once in each direction, and a mirror's lines are its own")
shim_conversions()
    val program = lower_source(repository_toolchain(), source_of("/probe/mirrors.avin", MirrorProgram)).unwrap()
    val shim = shim_source(program.bindings, program.handles)
    val text = lines(shim.text)
    // Two bindings return an `Option[LocalDate]` and one takes one: one conversion each way for it
    // and one for the mirror inside it.
    var outs = 0
    var ins = 0
    for line in text
        if line.starts_with("private out_") then outs += 1
        if line.starts_with("private in_") then ins += 1
    assert_eq(outs, 2)
    assert_eq(ins, 2)
    assert_eq(shim.mirrors.len(), 1usize)
    assert_eq(shim.mirrors[0].target, "sysl.time.LocalDate")
    // The mirror's import, and the first line of each of its conversions, are among its lines.
    var import_owned = false
    var conversions = 0
    for part in shim.mirror_lines
        if text[part.first - 1] == "import sysl.time.LocalDate as mirror_0" then import_owned = true
        if text[part.first - 1].starts_with("// LocalDate ") then conversions += 1
    assert(import_owned)
    assert_eq(conversions, 2)
    // An array of bytes is copied in bulk, and the result's layouts follow its parameters.
    assert(shim.text.contains("copy(out, array_elements(p)[0..<n])"))
    assert(shim.text.contains("bytes_of(ctx, r, d0)"))

@test("a binding's result is made by the layouts its body passes after its parameters")
shim_layouts()
    val program = lower_source(repository_toolchain(), source_of("/probe/mirrors.avin", MirrorProgram)).unwrap()
    for b in program.bindings
        // `Option[LocalDate]`: `Some`, `None`, then `LocalDate`'s one variant; an array, its descriptor.
        if b.name == "checked" || b.name == "same" then assert_eq(b.result.layouts, 3usize)
        if b.name == "bytes" then assert_eq(b.result.layouts, 1usize)
        assert(b.result.variants.len() == 0 || b.result.variants[0].fields[0].base == 2usize)

private const CollectionProgram: string =
    "@sysl(\"sysl.text.split\")\nsplit(s: string, sep: string) -> Vector[string]\n\n" +
    "@sysl(\"sysl.path.join_all\")\njoin(parts: Array[string]) -> string\n\n" +
    "@sysl(\"sysl.hint.black_box\")\nmaybe(o: Option[Vector[int]]) -> Option[Vector[int]]\n\nmain() = 0\n"

@test("a collection goes into Sysl as a slice and comes out of a slice or a Buf, by its layouts")
shim_collections()
    val program = lower_source(repository_toolchain(), source_of("/probe/collections.avin", CollectionProgram)).unwrap()
    for b in program.bindings
        // A vector: its array's descriptor, then the core library's functions that make one of an
        // array, give its length and give a leaf. An array: its descriptor alone.
        if b.name == "split" then assert_eq(b.result.layouts, 4usize)
        if b.name == "join" then assert_eq(b.params[0].layouts, 1usize)
        // `Some` and `None`, then the vector's four, for the parameter as for the result.
        if b.name == "maybe"
            assert_eq(b.result.layouts, 6usize)
            assert_eq(b.result.variants[0].fields[0].base, 2usize)
            assert_eq(b.params[0].layouts, 6usize)
    val text = shim_source(program.bindings, program.handles).text
    // A parameter's layouts are passed after the parameters, and before the result's.
    assert(text.contains("(ctx: *Context, a0: *u8, e0_0: *u8, e0_1: *u8, e0_2: *u8, e0_3: *u8, e0_4: *u8, e0_5: *u8, d0: *u8"))
    assert(text.contains("    val ep0: **u8 = ptr_cast(&es0)"))
    // Into Sysl, a vector is read a leaf at a time; out of Sysl, it is made of an array.
    assert(text.contains("val leaf_of: *extern(*Context, *u8, i32) -> *u8 = ptr_cast(ds[3])\n"))
    assert(text.contains("    val made = of_array(ctx, root.object)\n"))
    assert(text.contains("import sysl.buf.{Buf, buf}"))
    // A slice is converted by its own overload, which the `Buf` overload of the same spelling gives
    // the `Buf`'s elements to; no third function stands between them.
    assert(text.contains(", v: []string, ds: **u8) -> *u8\n"))
    assert(text.contains(", v: Buf[string], ds: **u8) -> *u8 = out_"))
    assert(text.contains("(ctx, v.view(), ds)\n"))
    assert(!text.contains("elements_"))
    // The generic overloads at an integer type: the slice's has the body, the `Buf`'s calls it.
    assert(text.contains("[S0: Integer](ctx: *Context, v: []S0, ds: **u8) -> *u8\n"))
    assert(text.contains("[S0: Integer](ctx: *Context, v: Buf[S0], ds: **u8) -> *u8 = out_"))
    // A conversion that holds an integer is generic in the Sysl integer type it is made from.
    assert(text.contains("[S0: Integer](ctx: *Context, v: Option[[]S0], ds: **u8) -> *u8\n"))
    assert(text.contains("[S0: Integer](ctx: *Context, v: Option[Buf[S0]], ds: **u8) -> *u8\n"))
    assert(text.contains("integer_to(ctx, v[i], \"int\")"))
    assert(text.contains("(ctx: *Context, p: *u8, ds: **u8) -> []string\n"))
    assert(text.contains("(ctx: *Context, p: *u8, ds: **u8) -> Option[[]int]\n"))
    // A result that may be either is not given a type of its own; one that is one type is.
    assert(text.contains("    val r = bound_0("))
    assert(text.contains("    val r: string = bound_1("))

private const BytesProgram: string = "@sysl(\"sysl.hint.black_box\")\nbytes(b: Array[byte]) -> Array[byte]\n\n@sysl(\"sysl.hint.black_box\")\nmaybe(o: Option[Array[byte]]) -> Option[Array[byte]]\n\n@sysl(\"sysl.fs.Mapped\")\nclass Mapped\n    @sysl(\"bytes\")\n    contents() -> Array[byte]\n    maybe() -> Option[Array[byte]]\n\n@sysl(\"sysl.fs.map_file\")\nmapFile(file: string) -> Option[Mapped]\n\nmain()\n    mapFile(\"f\") match\n        Some(m) ->\n            m.contents()\n            m.maybe()\n        None -> ()\n"

@test("an array of bytes comes out of a slice Sysl may write or one it may only read")
shim_bytes_results()
    val program = lower_source(repository_toolchain(), source_of("/probe/bytes.avin", BytesProgram)).unwrap()
    val text = shim_source(program.bindings, program.handles).text
    // The result takes the Sysl function's own type, `[]u8` or `[]const u8`.
    assert(text.contains("    val r = bound_0("))
    assert(text.contains("    val made: *u8 = bytes_of(ctx, r, d0)\n"))
    assert(!text.contains("val r: []u8"))
    assert(text.contains(", v: Option[[]u8], ds: **u8) -> *u8\n"))
    assert(text.contains(", v: Option[[]const u8], ds: **u8) -> *u8\n"))
    // A handle's method may answer a view of the handle's value, which no local holds while the
    // conversion allocates.
    assert(text.contains("    bytes_of(ctx, s.r.bytes(), d0)\n"))
    assert(text.contains("(ctx, s.r.maybe(), dp)\n"))

private const HandleProgram: string = "@sysl(\"sysl.checksum.Crc32\")\nclass Crc32\n    combine(other: Crc32, by: BigInt) -> long\n\n@sysl(\"sysl.math.bigint.BigInt\")\nclass BigInt\n    sign() -> int\n\n@sysl(\"sysl.checksum.new_crc32\")\nnewCrc32() -> Crc32\n\n@sysl(\"sysl.math.bigint.parse\")\nparse(s: string) -> Option[BigInt]\n\n@sysl(\"sysl.hint.black_box\")\nmany(n: long) -> Result[Vector[Crc32], string]\n\nmain()\n    val c = newCrc32()\n    parse(\"1\").foreach(b -> c.combine(c, b))\n    many(2)\n"

@test("a handle passed as a parameter is passed as its Sysl type asks, and a collection of handles comes out of whatever Sysl elements it holds")
shim_handle_crossings()
    val program = lower_source(repository_toolchain(), source_of("/probe/handles.avin", HandleProgram)).unwrap()
    val shim = shim_source(program.bindings, program.handles)
    var calls = 0
    for line in lines(shim.text)
        if line.contains("integer_to(ctx, s.r.combine(") then calls += 1
    // Two handle types among the method's parameters: each combination of a trait or not is one
    // call, of which Sysl keeps one, and a type with a destructor is no choice of its own.
    assert(shim.text.contains("\n    if const wide_0()\n        if const wide_1()\n"))
    assert(shim.text.contains("\n    else\n        if const wide_1()\n"))
    assert(!shim.text.contains(": Drop"))
    assert_eq(calls, 4)
    assert(shim.text.contains("s.r.combine(cell_0(a1).r, cell_1(a2).r)"))
    var i = 0usize
    while !program.bindings[i].name.contains("combine")
        i += 1
    assert(shim.text.contains(s"s.r.combine(pass_${i}_1(a1), pass_${i}_2(a2))"))
    // Each parameter that is a handle has helpers of its own, among the binding's lines, so that a
    // handle Sysl does not take there is reported at the binding; the receiver needs none.
    assert(shim.text.contains(s"private pass_${i}_1[P](p: *u8) -> P\n    val s = cell_0(p)\n"))
    assert(shim.text.contains(s"private pass_${i}_2[P](p: *u8) -> P\n    val s = cell_1(p)\n"))
    assert(shim.text.contains(s"private give_${i}_2[P](r: &mirror_1) -> P\n"))
    assert(!shim.text.contains(s"pass_${i}_0"))
    assert(!shim.text.contains("passed_0"))
    val helper = shim.text.index_of(s"private pass_${i}_1[").unwrap()
    val line = shim.text[0..<helper].split("\n").len
    assert(line >= shim.first[i] && line <= shim.last[i])
    assert_eq(shim.passing.len(), 2usize)
    // The vector of handles is generic in the Sysl type of its elements.
    assert(shim.text.contains("[E](ctx: *Context, v: []E, ds: **u8) -> *u8\n"))
    assert(shim.text.contains("[E](ctx: *Context, v: Buf[E], ds: **u8) -> *u8 = out_"))
    assert(!shim.text.contains("elements_"))

private const MirrorHandleProgram: string = "@sysl(\"sysl.checksum.Crc32\")\nclass Crc32\n    finish() -> long\n\n@sysl(\"sysl.math.bigint.BigInt\")\nclass BigInt\n    sign() -> int\n\n@sysl(\"some.module.Pair\")\ndata Pair\n    Both(crc: Crc32, big: BigInt)\n    Neither\n\n@sysl(\"sysl.hint.black_box\")\nkeep(p: Pair) -> Pair\n\nmain() = ()\n"

@test("a handle a mirror's field holds is checked, then passed into Sysl as a parameter is, and comes out of Sysl a handle of its own")
shim_mirror_handle_fields()
    val program = lower_source(repository_toolchain(), source_of("/probe/mirror_handles.avin", MirrorHandleProgram)).unwrap()
    val shim = shim_source(program.bindings, program.handles)
    // Each handle a field holds is checked by its own helper before the variant is made.
    assert(shim.text.contains("private held_0(ctx: *Context, p: *u8) -> *u8\n"))
    assert(shim.text.contains("private held_1(ctx: *Context, p: *u8) -> *u8\n"))
    assert(shim.text.contains("stop_in_binding(ctx, \"`Crc32` belongs to another thread\")"))
    assert(shim.text.contains("stop_in_binding(ctx, \"`BigInt` is closed\")"))
    assert(shim.text.contains("import avin.rt.handle_claim\n"))
    assert(shim.text.contains("val h0 = held_0(ctx, q0[0])\n"))
    // Two handle types in one variant: each combination of a trait or not is one construction, of
    // which Sysl keeps one.
    assert(shim.text.contains("\n        if const wide_0()\n            if const wide_1()\n"))
    assert(shim.text.contains("\n        else\n            if const wide_1()\n"))
    assert(shim.text.contains(".Both(cell_0(h0).r, cell_1(h1).r)"))
    // Each handle field has helpers of its own among the mirror's lines.
    assert(shim.text.contains("(h0), pass_in_"))
    assert(shim.text.contains(".Both(pass_in_"))
    assert(!shim.text.contains("passed_0"))
    // Out of Sysl, the mirror is its own Sysl type, and each field becomes a handle by the handle's
    // conversion, generic in what Sysl holds.
    var exact = false
    for line in lines(shim.text)
        if line.starts_with("private out_") && line.contains("(ctx: *Context, v: mirror_") then exact = true
    assert(exact)
    assert(shim.text.contains(".Both(f0, f1) ->\n"))
    assert(shim.text.contains("ds: **u8) -> *u8\n    val o = allocate(ctx, ptr_cast(ds[0]))\n"))

@test("an array the Sysl function may fill is kept as a frame and copied back after the result is made")
shim_filled_arrays()
    val program = lower_source(repository_toolchain(), source_of("/probe/bytes.avin", BytesProgram)).unwrap()
    val text = shim_source(program.bindings, program.handles).text
    // The binding's own array parameter goes in as a slice Sysl may write, kept as a root.
    assert(text.contains("    val s0 = bytes_in(a0)\n    var root0 = Root(Frame(ctx.top, 1usize), a0)\n    ctx.top = ptr_cast(&root0)\n"))
    assert(text.contains("bound_0(s0)"))
    // The result is made first, then the slice copied back, then the frame dropped.
    assert(text.contains("    val made: *u8 = bytes_of(ctx, r, d0)\n    copy(array_elements(root0.object)[0..<s0.len], s0)\n    ctx.top = root0.frame.prev\n    made\n"))
    // An array an option holds goes in read-only.
    assert(text.contains("Some(read_only(bytes_in(p)))"))

private const BlockingProgram: string = "@sysl(\"sysl.hint.black_box\", blocking)\nfill(b: Array[byte]) -> Array[byte]\n\n@sysl(\"sysl.hint.black_box\", blocking)\nsquares(a: Array[int]) -> Array[int]\n\n@sysl(\"sysl.hint.black_box\", blocking)\npair(p: (long, string)) -> (long, string)\n\nmain()\n    fill(Array.fill(2, byte(0)))\n    squares(Array.fill(2, 0))\n    pair((1, \"a\"))\n"

@test("a blocking binding copies a filled array in before the thread is safe, and back after it runs again")
shim_blocking_filled_arrays()
    val program = lower_source(repository_toolchain(), source_of("/probe/blocking.avin", BlockingProgram)).unwrap()
    val text = shim_source(program.bindings, program.handles).text
    // The copy in and the root come before the safe region, which holds nothing but the Sysl call;
    // the result and the copy back come after it.
    assert(text.contains("    val s0 = bytes_in(a0)\n    var root0 = Root(Frame(ctx.top, 1usize), a0)\n    ctx.top = ptr_cast(&root0)\n    val x0 = s0\n    enter_safe(ctx)\n    val r = bound_0(x0)\n    leave_safe(ctx)\n    val made: *u8 = bytes_of(ctx, r, d0)\n    copy(array_elements(root0.object)[0..<s0.len], s0)\n    ctx.top = root0.frame.prev\n    made\n"))
    // An array of integers is converted in, and its elements converted back, outside the region too.
    assert(text.contains("    var root0 = Root(Frame(ctx.top, 1usize), a0)\n    ctx.top = ptr_cast(&root0)\n    val x0 = s0\n    enter_safe(ctx)\n    val r = bound_1(x0)\n    leave_safe(ctx)\n"))
    assert(text.contains("    for i in 0..<s0.len do f0[i] = "))
    // A tuple goes in as a local before the region, and the tuple answered is made after it.
    assert(text.contains("    enter_safe(ctx)\n    val r = bound_2(x0)\n    leave_safe(ctx)\n"))

@test("a mirror's lowerCamelCase field is matched to the snake_case Sysl field of the same words")
mirror_field_names()
    assert_eq(sysl_field_of("restArePositional"), "rest_are_positional")
    assert_eq(sysl_field_of("utf8Offset"), "utf8_offset")
    assert_eq(sysl_field_of("day"), "day")
    assert_eq(sysl_field_of("parseURL"), "parse_u_r_l")

@test("a binding's shim is built once and found in the cache after that")
shim_cache()
    val text = "@sysl(\"sysl.text.to_lower\")\nlower(s: string) -> string\n\nmain() = 0\n"
    val first = compiled(text)
    assert_eq(first.diagnostics, "")
    val archive = first.archive.unwrap()
    val built = metadata(archive).unwrap().modified
    // The same bindings in another program are the same shims, which are not built again.
    val second = compiled("// another program with the same binding\n" + text)
    assert_eq(second.archive.unwrap(), archive)
    assert(metadata(archive).unwrap().modified == built)
    // Another binding is another archive.
    val other = compiled("@sysl(\"sysl.text.to_upper\")\nlower(s: string) -> string\n\nmain() = 0\n")
    assert(other.archive.unwrap() != archive)

@test("a shim archive keeps the C libraries it needs beside it, and one cached without them is built again")
shim_link_needs_kept()
    val text = "@sysl(\"sysl.text.to_lower\")\nlowerKeepingLibraries(s: string) -> string\n\nmain() = 0\n"
    val first = compiled(text)
    assert_eq(first.diagnostics, "")
    val archive = first.archive.unwrap()
    val needs = link_needs_file(archive)
    assert(exists(needs))
    // The standard library needs the C runtime's mathematics and nothing else.
    assert_eq(read_text(needs).unwrap(), "lib m\n")
    remove_file(needs).unwrap()
    val second = compiled(text)
    assert_eq(second.archive.unwrap(), archive)
    assert(exists(needs))

@test("the libraries `sysl build-c` reports an archive needs are kept, `@link` names and pkg-config modules apart")
link_needs_report()
    val report = "wrote /x/a.a\nwrote /x/a.a.h\nsysl: link this against: m, sqlite3\nsysl: and against what the packages require, which pkg-config answers for: pkg-config --libs sqlite3 yaml-0.1\nsysl: pass -Wl,-dead_strip when linking, so a library only unreached functions need can be left off\n"
    assert_eq(link_needs(report), "lib m\nlib sqlite3\npkg sqlite3\npkg yaml-0.1\n")
    assert_eq(link_needs("wrote /x/a.a\nwrote /x/a.a.h\n"), "")
    assert_eq(link_needs(""), "")

@test("an archive's libraries are linked with -l, less the C runtime's, and its pkg-config modules with what pkg-config answers")
link_flags_of_needs()
    assert_eq(link_flags("").unwrap().len(), 0usize)
    assert_eq(link_flags("lib m\nlib c\n").unwrap().len(), 0usize)
    val named = link_flags("lib m\nlib z\nlib c\nlib sqlite3\n").unwrap()
    assert_eq(named.len(), 2usize)
    assert_eq(named[0], "-lz")
    assert_eq(named[1], "-lsqlite3")
    // The machine is asked for a module's flags, and they follow the libraries named directly.
    val asked = link_flags("lib z\npkg sqlite3\n").unwrap()
    assert_eq(asked[0], "-lz")
    var found = false
    for flag in asked
        if flag == "-lsqlite3" then found = true
    assert(found)
    // A module the machine does not know stops the link, naming what was asked.
    link_flags("lib z\npkg avin-no-such-module\n") match
        Ok(_) -> panic("a module pkg-config does not know was linked")
        Err(message) -> assert(message.contains("`pkg-config --libs avin-no-such-module`"))

@test("the shim package's manifest names each Sysl package a program's manifests name")
shim_manifest_sysl_packages()
    var sysl: Buf[SyslPackage] = buf()
    sysl.push(SyslPackage("regex", Git("github.com/sysl-lang/regex", "0.2.0")))
    sysl.push(SyslPackage("orbits", Rev("github.com/o/orbits", "3f9a2c1")))
    sysl.push(SyslPackage("digits", Local("/work/sysl \"digits\"")))
    val text = shim_manifest("/rt", sysl)
    assert(text.contains("  avin-runtime { path = \"/rt\" }\n"))
    assert(text.contains("  regex { git = \"github.com/sysl-lang/regex\", version = \"0.2.0\" }\n"))
    assert(text.contains("  orbits { git = \"github.com/o/orbits\", rev = \"3f9a2c1\" }\n"))
    assert(text.contains("  digits { path = \"/work/sysl \\\"digits\\\"\" }\n"))
    assert(!shim_manifest("/rt", buf()).contains("regex"))

// The key of one shim source built with the Sysl packages `sysl`.
private key(sysl: Buf[SyslPackage]) -> string = shim_key(shim_manifest("/rt", sysl), "shim", "sysl 0.8.17", "runtime", sysl)

private one(label: string, origin: Origin) -> Buf[SyslPackage]
    var b: Buf[SyslPackage] = buf()
    b.push(SyslPackage(label, origin))
    b

@test("a shim archive's key changes with a Sysl package's release, commit or directory sources, and with nothing else")
shim_key_sysl_packages()
    val dir = make_temp_dir("avin-shim-key").unwrap()
    defer _ = remove_dir_all(dir)
    write_text(dir + "/sysl.hocon", "package { name = \"d\", version = \"0.1.0\" }\n").unwrap()
    write_text(dir + "/d.sysl", "module d\n\none() -> i32 = 1\n").unwrap()
    write_text(dir + "/notes.txt", "not source\n").unwrap()
    val released = key(one("regex", Git("github.com/sysl-lang/regex", "0.2.0")))
    assert_eq(key(one("regex", Git("github.com/sysl-lang/regex", "0.2.0"))), released)
    assert(key(one("regex", Git("github.com/sysl-lang/regex", "0.2.1"))) != released)
    assert(key(one("regex", Rev("github.com/sysl-lang/regex", "3f9a2c1"))) != released)
    assert(key(buf()) != released)
    val local = key(one("d", Local(dir)))
    // A file that is not source changes nothing; a source file does.
    write_text(dir + "/notes.txt", "still not source\n").unwrap()
    assert_eq(key(one("d", Local(dir))), local)
    write_text(dir + "/d.sysl", "module d\n\none() -> i32 = 2\n").unwrap()
    assert(key(one("d", Local(dir))) != local)
    // A package's working directory is not its source.
    make_dir_all(dir + "/.sysl").unwrap()
    val changed = key(one("d", Local(dir)))
    write_text(dir + "/.sysl/build.sysl", "module scratch\n").unwrap()
    assert_eq(key(one("d", Local(dir))), changed)

@test("a program without bindings links the runtime's own archive")
no_shims()
    val c = compiled("main() = 0\n")
    assert_eq(c.diagnostics, "")
    assert(c.archive is None)

@test("only the library's bindings a program reaches are shims")
library_shims()
    val program = lower_source(repository_toolchain(), source_of("/probe/bindings.avin", "main()\n    println(\"a\".toUpperCase())\n    println(\"b\".stripTrailing())\n")).unwrap()
    var targets: Buf[string] = buf()
    for b in program.bindings do targets.push(b.target)
    assert_eq(targets.len(), 2usize)
    assert(targets[0] == "sysl.text.to_upper" || targets[1] == "sysl.text.to_upper")
    assert(targets[0] == "sysl.unicode.is_space" || targets[1] == "sysl.unicode.is_space")

@test("Sysl's diagnostic of a shim is reported at the binding's name")
shim_diagnostic_place()
    val c = compiled("main() = 0\n\n@sysl(\"sysl.text.to_upper\")\nshout(s: char) -> string\n")
    assert(c.diagnostics.contains("/probe/bindings.avin:4:1"))
    assert(c.diagnostics.contains("the Sysl binding `shout` does not match `sysl.text.to_upper`: 's' of 'sysl.text.to_upper' is string, but char was given"))
    assert(c.llvm is None)

@test("a binding's shim copies strings in bulk and never byte by byte")
shim_bulk_copy()
    val program = lower_source(repository_toolchain(), source_of("/probe/bulk.avin", "@sysl(\"sysl.text.to_upper\")\nupper(s: string) -> string\n\nmain() = 0\n")).unwrap()
    val text = shim_source(program.bindings, program.handles).text
    assert(text.contains("text_in(a0)"))
    assert(text.contains("text_of(ctx, r)"))
    assert(!text.contains("while"))
    for line in text.split("\n")
        assert(!line.trim().starts_with("for "))
    // The runtime's copy into a new string is one slice copy.
    val runtime = read_text("runtime/avin/rt/text.sysl").unwrap()
    assert(runtime.contains("copy(to[0..<s.bytes.len], s.bytes)"))

private const CellProgram: string = "@sysl(\"sysl.checksum.Crc32\")\nclass Crc32\n    finish() -> long\n\n@sysl(\"sysl.checksum.new_crc32\")\nnewCrc32() -> Crc32\n\nmain()\n    val c = newCrc32()\n    c.finish()\n    c.close()\n"

@test("every handle's object is two words, the reference to its Sysl value or, for a trait object, a cell holding it, and its owner")
shim_handle_cells()
    val program = lower_source(repository_toolchain(), source_of("/probe/cells.avin", CellProgram)).unwrap()
    val text = shim_source(program.bindings, program.handles).text
    assert(text.contains("private struct Slot_0\n    word: *u8\n    owner: u64\n"))
    assert(text.contains("private struct Cell_0\n    r: &mirror_0\n"))
    assert(text.contains("private const wide_0() -> bool = sizeof(&mirror_0) > sizeof(*u8)\n"))
    // A reference of one word is the object's first word itself; a wider one is kept in a cell.
    assert(text.contains("private cell_0(p: *u8) -> *Cell_0\n    if const wide_0()\n        val s: *Slot_0 = ptr_cast(p)\n        ptr_cast(s.word)\n    else\n        ptr_cast(p)\n"))
    assert(text.contains("        s.word = shim_calloc(1usize, sizeof(Cell_0))\n"))
    assert(text.contains("extern \"calloc\" shim_calloc(n: usize, size: usize) -> *u8\n"))
    assert(text.contains("extern \"free\" shim_free(p: *u8)\n"))
    // Only a trait is told apart: a type with a destructor is passed by the same helper as any other,
    // which settles at a `&T` parameter as the handle's own counted reference.
    assert(!text.contains("counted_0"))
    assert(!text.contains(": Drop"))
    // The finalizer and `close()` give the reference back the same way, and the cell with it.
    assert(text.contains("finalize_0(p: *u8, heap: *u8) = give_back_0(p)\n"))
    assert(text.contains("    give_back_0(a0)\n"))
    assert(text.contains("        shim_free(s.word)\n        s.word = null\n"))
    assert(text.contains("    val s = cell_0(a0)\n"))
    assert(text.contains("    hold_0(ctx, o, v)\n"))
    assert(!text.contains("Slot_0 = ptr_cast(a0)"))

private const ListedProgram: string = "@sysl(\"sysl.checksum.Crc32\")\nclass Crc32\n    finish() -> long\n    absorb(others: Vector[Crc32])\n\n@sysl(\"sysl.hint.black_box\")\nall(v: Vector[Crc32]) -> long\n\n@sysl(\"sysl.hint.black_box\")\nreading(a: Array[Crc32]) -> long\n\n@sysl(\"sysl.hint.black_box\", blocking)\nwaiting(v: Vector[Crc32]) -> long\n\n@sysl(\"sysl.checksum.new_crc32\")\nnewCrc32() -> Crc32\n\nmain() = newCrc32().absorb([])\n"

@test("a collection of handles a binding passes becomes the shares of their Sysl values, each checked, made the slice its parameter asks for")
shim_handle_collections()
    val program = lower_source(repository_toolchain(), source_of("/probe/listed.avin", ListedProgram)).unwrap()
    val text = shim_source(program.bindings, program.handles).text
    // Each handle of the collection is checked as a handle passed by itself is, and shared.
    assert(text.contains("b.push(cell_0(held_0(ctx, e[i])).r)"))
    assert(text.contains("stop_in_binding(ctx, \"`Crc32` belongs to another thread\")"))
    assert(text.contains("stop_in_binding(ctx, \"`Crc32` is closed\")"))
    assert(text.contains("ds: **u8) -> []&mirror_0\n"))
    // The shares are made a slice of what the parameter takes, as is where it takes the references.
    assert(text.contains("private given_all_0[E](s: []&mirror_0) -> []E\n    if const E::Kind == Kind.Ref\n        s\n"))
    assert(text.contains("private given_reading_0[E](s: []&mirror_0) -> []const E = given_all_0[E](s)\n"))
    assert(text.contains("given_all_0(in_"))
    assert(text.contains("given_reading_0(in_"))
    // A call that waits converts the collection before it, and makes the slice from the shares.
    assert(text.contains("given_all_0(x0)"))
    // A handle's method takes one too.
    assert(text.contains("s.r.absorb(given_all_0(in_"))

private const InstanceProgram: string = "@sysl(\"sysl.buf.Buf[(int, byte)]\")\nclass Pairs\n    len() -> long\n\n@sysl(\"sysl.buf.Buf[Option[byte]]\")\nclass Maybes\n    len() -> long\n\n@sysl(\"sysl.buf.buf\")\npairs() -> Pairs\n\n@sysl(\"sysl.hint.black_box\")\nsame(p: Pairs, m: Maybes) -> Pairs\n\nmain() = ()\n"

@test("a handle on an instance of a generic Sysl type imports the type and spells the instance, as Sysl writes its arguments, wherever it names the handle's type")
shim_generic_instances()
    val program = lower_source(repository_toolchain(), source_of("/probe/instances.avin", InstanceProgram)).unwrap()
    val text = shim_source(program.bindings, program.handles).text
    assert(text.contains("import sysl.buf.Buf as instance_0\n"))
    assert(text.contains("import sysl.buf.Buf as instance_1\n"))
    assert(text.contains("    r: &instance_0[(int, u8)]\n"))
    assert(text.contains("    r: &instance_1[Option[u8]]\n"))
    assert(text.contains("sizeof(&instance_0[(int, u8)])"))
    assert(text.contains("cell_1(o).r = v\n"))
    assert(!text.contains("mirror_0"))
    assert(!text.contains("mirror_1"))

@test("the type a handle's `@sysl` names splits into its path and its arguments, which Sysl spells as Avin does but for `byte`")
generic_instance_parts()
    val (path, arguments) = instance_parts("pkg.mod.Pair[int, (string, Option[byte])]")
    assert_eq(path, "pkg.mod.Pair")
    assert_eq(arguments.len(), 2usize)
    assert_eq(arguments[0], "int")
    assert_eq(arguments[1].trim(), "(string, Option[byte])")
    assert_eq(sysl_instance_argument("(string, Option[byte])"), "(string, Option[u8])")
    assert_eq(sysl_instance_argument("Result[bytes, byte]"), "Result[bytes, u8]")
    assert_eq(sysl_instance_argument("byte"), "u8")
    val (plain, none) = instance_parts("sysl.checksum.Crc32")
    assert_eq(plain, "sysl.checksum.Crc32")
    assert_eq(none.len(), 0usize)
    // Brackets that do not close at the end, or hold nothing, give no arguments.
    for unclosed in ["a.B[int", "a.B[]", "a.B[int, ]", "a.B[(int]", "a.B[int]]"]
        val (_, nothing) = instance_parts(unclosed)
        assert_eq(nothing.len(), 0usize)

@test("a package reached through a symbolic link is keyed by its sources, as the directory itself is, and an added file changes the key")
fingerprint_through_a_link()
    val dir = canonicalize(make_temp_dir("avin-fingerprint").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    make_dir_all(dir + "/real/avin/rt").unwrap()
    write_text(dir + "/real/sysl.hocon", "package { name = \"p\" }\n").unwrap()
    write_text(dir + "/real/avin/rt/one.sysl", "module avin.rt\n").unwrap()
    symlink(dir + "/real", dir + "/linked").unwrap()
    val direct = tree_fingerprint(dir + "/real")
    assert(direct.contains("one.sysl"))
    assert_eq(tree_fingerprint(dir + "/linked"), direct)
    write_text(dir + "/real/avin/rt/two.sysl", "module avin.rt\n").unwrap()
    val grown = tree_fingerprint(dir + "/linked")
    assert(grown.contains("two.sysl"))
    assert(grown != direct)
    assert_eq(tree_fingerprint(dir + "/real"), grown)
