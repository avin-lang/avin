module dev.avinlang.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}

// `derives` written out as ordinary declarations, before anything is declared. Every derivable trait
// has a template, `derive Trait for T`, in its own module: the core library's `Eq`, `Hash`, `Ord`,
// `Display` and `Debug` as much as a library's own. Each `derives` entry makes an impl of the
// template's body for the type, and the type's shape, as module values of its module.
//
// What is the compiler's own is when the core library's templates apply:
//
// - A class derives `Eq` and `Hash` together, so that equal instances hash alike, and `Ord` only
//   beside an equality by the same fields.
// - A data type already compares and hashes by its fields, so deriving `Eq` or `Hash` there adds
//   nothing.
// - Every data type has `Display` and `Debug` without asking, as though it derived them, unless an
//   impl of its own implements the trait or declares the trait's method. That derivation is the
//   type's only where its fields allow it: a field without the trait leaves the type without it, and
//   only a use that needs it is an error.
//
// Each field's type must implement the `Ord`, `Display` or `Debug` derived from it, which the checker
// holds it to once every conformance is known (`Derivation`), before any body is checked.

/** A core library trait a declaration derives whose fields must implement the trait: `Ord`,
 * `Display` or `Debug`. */
struct Derivation
    unit: usize
    /** The derived type's name in its module. */
    type_name: string
    data: bool
    trait_name: string
    /** The `derives` entry, where the impl made for it is declared. A data type's own `Display` and
     * `Debug` are declared at the type. */
    span: Span
    /** Whether the type has the trait without naming it in `derives`: a field without the trait
     * then leaves the type without it, rather than being an error. */
    automatic: bool

/** The method each derivable trait is implemented by. */
derived_method(trait_name: string) -> string
    if trait_name == "Eq" then return "equals"
    if trait_name == "Hash" then return "hash"
    if trait_name == "Ord" then return "compare"
    if trait_name == "Display" then return "display"
    if trait_name == "Debug" then return "debug"
    ""

/** Rewrites unit `unit`'s classes and data types that derive traits, reporting what cannot be
 * derived, and records each derivation the checker holds the fields to. */
derive_unit(c: *Checker, unit: usize)
    val file = c.units[unit].file
    var derives_any = false
    for item in file.items
        item match
            ClassItem(d) -> if d.derives.len() > 0 || d.annotations.len() > 0 || params_annotated(d.params) then derives_any = true
            DataItem(_) -> derives_any = true
            ImplItem(d) -> if d.template then derives_any = true
            _ -> ()
    if !derives_any then return
    var items: Buf[Item] = buf()
    var private_items: Buf[bool] = buf()
    for i in 0..<file.items.len()
        val item = file.items[i]
        items.push(item)
        private_items.push(file.private_items[i])
        item match
            ClassItem(d) ->
                var library: Buf[LibraryDerived] = buf()
                var made_class = d
                if d.derives.len() > 0 then derive_class(c, unit, d, &library)
                if is_shaped_class(made_class)
                    // `@sysl` makes the class a handle on a Sysl type and `@c` one on a C pointer,
                    // `@keeps_owners` marks it shared between owners, and each stays on it; the
                    // others are values its shape holds.
                    var own: Buf[Annotation] = buf()
                    var written: Buf[Annotation] = buf()
                    for a in d.annotations
                        if a.name == "sysl" || a.name == "c" || a.name == "keeps_owners" then own.push(a) else written.push(a)
                    val shaped = class_shape_parts(d)
                    if library.len() > 0 || annotated(shaped, written)
                        for v in shape_values(c, unit, d.span, d.name, shaped, written)
                            items.push(ValueItem(v))
                            private_items.push(true)
                    for lib in library
                        derive_through_template(c, unit, lib, d.name, d.type_params, false)
                    made_class = ClassDecl(own, made_class.span, made_class.name_span, made_class.name, made_class.modifier, made_class.modifier_span, made_class.type_params, made_class.params, made_class.parents, made_class.derives, made_class.members, made_class.object)
                items[items_position(items, item)] = ClassItem(made_class)
            DataItem(d) ->
                var library: Buf[LibraryDerived] = buf()
                derive_data(c, unit, d, &library)
                var own: Buf[Annotation] = buf()
                var written: Buf[Annotation] = buf()
                // `@sysl` and `@c` make the type a mirror, and stay on it; the others are values its
                // shape holds.
                for a in d.annotations
                    if a.name == "sysl" || a.name == "c" then own.push(a) else written.push(a)
                val shaped = data_shape_parts(d)
                if library.len() > 0 || annotated(shaped, written)
                    for v in shape_values(c, unit, d.span, d.name, shaped, written)
                        items.push(ValueItem(v))
                        private_items.push(true)
                for lib in library
                    derive_through_template(c, unit, lib, d.name, d.type_params, true)
                if written.len() > 0
                    val position = items_position(items, item)
                    items[position] = DataItem(DataDecl(own, d.span, d.name, d.type_params, d.variants, d.derives))
            ImplItem(d) ->
                if d.template then items[items_position(items, item)] = ImplItem(template_bounded(d))
            _ -> ()
    c.units[unit].file = SourceFile(file.module_name, file.module_span, file.tests_only, file.imports, items, private_items, file.widest_tuple, file.machine_states, file.actors)

/** Adds the impls `derives` entries made from templates to the templates' files, once every unit
 * is written out: each is declared where its template is, so the template's names resolve there. */
finish_derivations(c: *Checker)
    for p in c.template_impls
        val file = c.units[p.unit].file
        var items = file.items
        var private_items = file.private_items
        items.push(ImplItem(p.decl))
        private_items.push(false)
        c.units[p.unit].file = SourceFile(file.module_name, file.module_span, file.tests_only, file.imports, items, private_items, file.widest_tuple, file.machine_states, file.actors)
    c.template_impls = buf()

/** An impl a `derives` entry made from a template, waiting to join the template's file. */
struct TemplateImpl
    unit: usize
    decl: &ImplDecl

/** A trait a `derives` list names that a template derives: the entry, and the template. `builtin`
 * when it is one of the core library's five, whose rules are the compiler's. */
private struct LibraryDerived
    name: string
    at: Span
    template_unit: usize
    template: &ImplDecl
    builtin: bool

/** The position of the item just pushed for `item`: the last one that is it. */
private items_position(items: Buf[Item], item: Item) -> usize
    var at = 0usize
    for i in 0..<items.len()
        if same_item(items[i], item) then at = i
    at

private same_item(a: Item, b: Item) -> bool = a match
    DataItem(x) -> b match
        DataItem(y) -> x.span.start == y.span.start && x.name == y.name
        _ -> false
    ImplItem(x) -> b match
        ImplItem(y) -> x.span.start == y.span.start && x.span.end == y.span.end
        _ -> false
    ClassItem(x) -> b match
        ClassItem(y) -> x.span.start == y.span.start && x.name == y.name
        _ -> false
    _ -> false

// A template's `T` is bounded by the trait it derives and by `Shaped`, which gives it the shape and
// the code written for each type's fields.
private template_bounded(d: &ImplDecl) -> &ImplDecl
    val written = d.type_params[0]
    var bounds: Buf[&TypeExpr] = buf()
    if d.trait_name is Some(t) then bounds.push(t)
    bounds.push(named_type(written.span, core_path("Shaped")))
    var params: Buf[TypeParam] = buf()
    params.push(TypeParam(written.span, written.name, Invariant, bounds, written.site, None))
    ImplDecl(d.span, params, d.trait_name, d.target, d.members, true, None)

// The impl a `derives` entry makes from a template for the type named `type_name`, declared in the
// template's file: the template's body, its `T` standing for the type, each of the type's parameters
// bounded by the trait. An impl's parameters are the type's by position, so each is renamed to a
// name no source can write: the template's body, which sees them, then means by `T`, `Writer` or any
// other name what the template's author did, whatever the type calls its parameters.
private derive_through_template(c: *Checker, unit: usize, lib: LibraryDerived, type_name: string, type_params: Buf[TypeParam], data: bool)
    val at = lib.at
    val t = lib.template
    val trait_expr = t.trait_name.unwrap()
    var params: Buf[TypeParam] = buf()
    var renamed: Buf[TypeParam] = buf()
    for tp in type_params
        var bounds: Buf[&TypeExpr] = buf()
        bounds.push(trait_expr)
        val name = tp.name + "'"
        params.push(TypeParam(at, name, Invariant, bounds, s"${c.units[unit].src.name}:${at.start}:derives ${lib.name}", None))
        renamed.push(TypeParam(tp.span, name, tp.variance, tp.bounds, tp.site, tp.lower))
    val site = DeriveSite(unit, type_name, at, lib.name, t.type_params[0].name, data, t.span)
    val decl = ImplDecl(at, params, Some(trait_expr), own_type(at, type_name, renamed), t.members, false, Some(site))
    c.template_impls.push(TemplateImpl(lib.template_unit, decl))

// The template deriving the trait `t` names, as unit `unit` sees it: one declared in the unit's own
// module, in a module the unit's file imports from, or in the core library.
private find_template(c: *Checker, unit: usize, path: string) -> Option[LibraryDerived]
    val bare = last_segment(path)
    val module_name = c.units[unit].file.module_name
    var found: Option[LibraryDerived] = None
    for u in 0..<c.units.len()
        val other = c.units[u].file.module_name
        for item in c.units[u].file.items
            if item is ImplItem(d)
                if !d.template then continue
                val name = d.trait_name.unwrap().kind match
                    Named(p, _) -> last_segment(p)
                    _ -> ""
                if name != bare then continue
                if !module_sees(c, unit, other, path) then continue
                val candidate = LibraryDerived(bare, Span(0, 0), u, d, false)
                if other == module_name then return Some(candidate)
                if found is None then found = Some(candidate)
    found

// The core library's template deriving its trait `name`.
private core_template(c: *Checker, name: string) -> Option[LibraryDerived]
    for u in 0..<c.units.len()
        if c.units[u].file.module_name != CoreModule then continue
        for item in c.units[u].file.items
            if item is ImplItem(d)
                if !d.template then continue
                if d.trait_name.unwrap().kind is Named(p, _)
                    if last_segment(p) == name then return Some(LibraryDerived(name, Span(0, 0), u, d, true))
    None

private module_sees(c: *Checker, unit: usize, other: string, path: string) -> bool
    val file = c.units[unit].file
    if other == file.module_name || other == CoreModule then return true
    if path.starts_with(other + ".") then return true
    for i in file.imports
        if i.path == other || i.path.starts_with(other + ".") then return true
    false

private last_segment(path: string) -> string
    var start = 0usize
    for i in 0..<path.bytes.len
        if path.bytes[i] == u8('.') || path.bytes[i] == u8(':') then start = i + 1
    path[start..]

/** One variant of a type as its shape describes it: its name, its fields' names and whether each has
 * a default, and the annotations on it and on each field. */
private struct ShapedVariant
    name: string
    fields: Buf[Param]
    annotations: Buf[Annotation]

private data_shape_parts(d: &DataDecl) -> Buf[ShapedVariant]
    var out: Buf[ShapedVariant] = buf()
    for v in d.variants
        // A mirror's variant names its enumerator with `@c`, which is no value of its shape.
        var held: Buf[Annotation] = buf()
        for a in v.annotations
            if a.name != "c" then held.push(a)
        // A struct mirror's field names its C field with `@c`, which is no value of its shape either.
        var fields: Buf[Param] = buf()
        for f in v.fields
            var kept: Buf[Annotation] = buf()
            for a in f.annotations
                if a.name != "c" then kept.push(a)
            fields.push(Param(f.span, f.pattern, f.ty, f.default, f.by_name, f.variadic, kept))
        out.push(ShapedVariant(v.name, fields, held))
    out

private class_shape_parts(d: &ClassDecl) -> Buf[ShapedVariant]
    var fields: Buf[Param] = buf()
    for p in d.params
        fields.push(p.param)
    var out: Buf[ShapedVariant] = buf()
    out.push(ShapedVariant(d.name, fields, buf()))
    out

/** Whether a class declaration is one a shape describes: a class, not a trait or an object. */
private is_shaped_class(d: &ClassDecl) -> bool = !d.object && d.modifier != "trait"

private params_annotated(params: Buf[ClassParam]) -> bool
    for p in params
        for a in p.param.annotations
            if !is_argument_mark(a.name) then return true
    false

/** The annotations the compiler gives meaning to on a parameter, which check what is passed for it:
 * `@sendable`, `@isolating` and `@isolated`. They are no values of a shape. */
is_argument_mark(name: string) -> bool = name == "sendable" || name == "isolating" || name == "isolated"

private annotated(variants: Buf[ShapedVariant], on_type: Buf[Annotation]) -> bool
    if on_type.len() > 0 then return true
    for v in variants
        if v.annotations.len() > 0 then return true
        for f in v.fields
            if f.annotations.len() > 0 then return true
    false

/** The name of the module value holding a shape: the type's, then a variant's, then a field's. */
shape_value_name(type_name: string) -> string = s"__shape_$type_name"

variant_shape_name(type_name: string, variant: usize) -> string = s"__shape_${type_name}_$variant"

field_shape_name(type_name: string, variant: usize, field: usize) -> string = s"__shape_${type_name}_${variant}_$field"

// The module values holding a type's shape, private to its module: one per field, one per variant
// and one for the type, each made once before `main` from the ones before it. An annotation whose
// name is no type or object the file can name is reported, and left out.
private shape_values(c: *Checker, unit: usize, at: Span, type_name: string, variants: Buf[ShapedVariant], on_type: Buf[Annotation]) -> Buf[FieldDecl]
    var out: Buf[FieldDecl] = buf()
    var variant_names: Buf[&Expr] = buf()
    for i in 0..<variants.len()
        val v = variants[i]
        var field_names: Buf[&Expr] = buf()
        for j in 0..<v.fields.len()
            val f = v.fields[j]
            val name = f.pattern.kind match
                Name(n) -> n
                _ -> s"_$j"
            var args: Buf[&Expr] = buf()
            args.push(Expr(at, StringLit(name)))
            args.push(int_lit(at, s"$j"))
            args.push(Expr(at, BoolLit(f.default is Some(_))))
            args.push(annotation_values(c, unit, f.annotations))
            out.push(FieldDecl(at, field_shape_name(type_name, i, j), None, call_core(at, "FieldShape", args), false, false, false))
            field_names.push(Expr(at, Name(field_shape_name(type_name, i, j))))
        var args: Buf[&Expr] = buf()
        args.push(Expr(at, StringLit(v.name)))
        args.push(int_lit(at, s"$i"))
        args.push(int_lit(at, s"${v.fields.len()}"))
        args.push(Expr(at, ListLit(field_names)))
        args.push(annotation_values(c, unit, v.annotations))
        out.push(FieldDecl(at, variant_shape_name(type_name, i), None, call_core(at, "VariantShape", args), false, false, false))
        variant_names.push(Expr(at, Name(variant_shape_name(type_name, i))))
    var args: Buf[&Expr] = buf()
    args.push(Expr(at, StringLit(type_name)))
    args.push(int_lit(at, s"${variants.len()}"))
    args.push(Expr(at, ListLit(variant_names)))
    args.push(annotation_values(c, unit, on_type))
    out.push(FieldDecl(at, shape_value_name(type_name), None, call_core(at, "TypeShape", args), false, false, false))
    out

private call_core(at: Span, name: string, args: Buf[&Expr]) -> &Expr
    var written: Buf[Argument] = buf()
    for a in args
        written.push(Argument(at, None, a, false))
    Expr(at, Call(Expr(at, Name(core_path(name))), written))

// The annotations as a vector of values: `@JsonOmit` the object, `@JsonKey("name")` the value its
// arguments make.
private annotation_values(c: *Checker, unit: usize, annotations: Buf[Annotation]) -> &Expr
    var values: Buf[&Expr] = buf()
    for a in annotations
        if is_argument_mark(a.name) then continue
        if !names_declaration(c, unit, a.name)
            c.note(unit, a.span, s"unknown annotation `@${a.name}`; an annotation is a value of a type or an object implementing `Annotation`")
            continue
        if a.args.len() == 0 then values.push(Expr(a.span, Name(a.name)))
        else
            var written: Buf[Argument] = buf()
            for arg in a.args
                written.push(Argument(arg.value.span, arg.name, arg.value, false))
            values.push(Expr(a.span, Call(Expr(a.span, Name(a.name)), written)))
    Expr(Span(0, 0), ListLit(values))

// The error for `@name` written on a declaration that takes only the compiler's own annotations, `what`
// being that declaration ("a trait", "a function"). Where `name` is a type or an object, the
// annotation is misplaced rather than unknown, and the message says where such values go.
misplaced_annotation(c: *Checker, unit: usize, name: string, what: string) -> string =
    if names_declaration(c, unit, name)
        s"`@$name` cannot annotate $what; an annotation implementing `Annotation` goes on a data type, a class, a variant, a field or a class parameter"
    else s"unknown annotation `@$name`"

// Whether `name`, written in unit `unit`, names a data type, a class or an object: one its module
// declares, one its file imports, or one of the core library's.
private names_declaration(c: *Checker, unit: usize, name: string) -> bool
    val file = c.units[unit].file
    for i in file.imports
        if i.binding == name then return true
    declares_type(c, file.module_name, name) || declares_type(c, CoreModule, name)

private declares_type(c: *Checker, module_name: string, name: string) -> bool
    for u in c.units
        if u.file.module_name != module_name then continue
        for item in u.file.items
            item match
                ClassItem(d) -> if d.name == name then return true
                DataItem(d) -> if d.name == name then return true
                _ -> ()
    false

// The traits `derives` names, each once, with the templates deriving them and what cannot be
// derived reported. The core library's five are its own whatever the file declares; `implemented`
// names those of them the type also implements by hand.
private derived_traits(c: *Checker, unit: usize, type_name: string, derives: Buf[&TypeExpr], implemented: Buf[string]) -> Buf[LibraryDerived]
    var out: Buf[LibraryDerived] = buf()
    for t in derives
        val name = t.kind match
            Named(path, args) -> if args.len() == 0 then path else ""
            _ -> ""
        val builtin = derived_method(name) != ""
        val found = if builtin then core_template(c, name) elif name != "" then find_template(c, unit, name) else None
        val template = found match
            Some(f) -> f
            None ->
                c.note(unit, t.span, s"`${type_text(t)}` cannot be derived; a type derives `Eq`, `Hash`, `Ord`, `Display`, `Debug`, and a trait whose module declares a template for it, `derive ${type_text(t)} for T`")
                continue
        var seen = false
        for earlier in out
            if earlier.name == template.name then seen = true
        if seen
            c.note(unit, t.span, s"`$name` is derived twice")
            continue
        if builtin && contains_name(implemented, name)
            c.note(unit, t.span, s"`$type_name` derives `$name` and also implements it; a conformance is stated once, so drop one of the two")
            continue
        out.push(LibraryDerived(template.name, t.span, template.template_unit, template.template, builtin))
    out

/** Whether `traits` holds the core library's trait `name`. */
private has_trait(traits: Buf[LibraryDerived], name: string) -> bool
    for t in traits
        if t.builtin && t.name == name then return true
    false

private contains_name(names: Buf[string], name: string) -> bool
    for n in names
        if n == name then return true
    false

private type_text(t: &TypeExpr) -> string = t.kind match
    Named(path, args) ->
        if args.len() == 0 then return path
        var text = path + "["
        for i in 0..<args.len()
            if i > 0 then text = text + ", "
            text = text + type_text(args[i])
        text + "]"
    _ -> "this type"

// The core library's traits that impls anywhere in the module implement for the type named
// `type_name`. An impl of a trait of the module's own, or one a file imports, does not count, however
// it is named.
private impl_traits(c: *Checker, unit: usize, type_name: string) -> Buf[string]
    var out: Buf[string] = buf()
    val module_name = c.units[unit].file.module_name
    for u in 0..<c.units.len()
        if c.units[u].file.module_name != module_name then continue
        for item in c.units[u].file.items
            if item is ImplItem(d)
                val target = d.target.kind match
                    Named(path, _) -> path
                    _ -> ""
                if target != type_name then continue
                if d.trait_name is Some(t)
                    if t.kind is Named(path, _)
                        if path.starts_with(CorePrefix) then out.push(path[CorePrefix.bytes.len..])
                        elif names_core(c, u, path) then out.push(path)
    out

// The traits a class derives, each through its template, into `library`. `Eq` and `Hash` come
// together, so that equal instances hash alike, and `Ord` comes with an equality by the same fields.
private derive_class(c: *Checker, unit: usize, d: &ClassDecl, library: *Buf[LibraryDerived])
    if d.modifier == "trait"
        c.note(unit, d.derives[0].span, "a trait derives nothing; the types implementing it do")
        return
    var implemented = impl_traits(c, unit, d.name)
    for parent in d.parents
        parent.kind match
            Name(n) -> if names_core(c, unit, n) then implemented.push(n)
            _ -> ()
    for m in d.members
        if m is MethodMember(f, _, _, _)
            for trait_name in ["Eq", "Hash", "Ord", "Display", "Debug"]
                if f.name == derived_method(trait_name) then implemented.push(trait_name)
    val traits = derived_traits(c, unit, d.name, d.derives, implemented)
    val equality_by_hand = contains_name(implemented, "Eq")
    for t in traits
        if !t.builtin then continue
        if t.name == "Eq" && !has_trait(traits, "Hash")
            c.note(unit, t.at, s"`${d.name}` derives `Eq` without `Hash`; equal instances must hash alike, so derive both: `derives Eq, Hash`")
            return
        if t.name == "Hash" && !has_trait(traits, "Eq") && !equality_by_hand
            c.note(unit, t.at, s"`${d.name}` derives `Hash` without `Eq`; the hash follows the fields `==` compares, so derive both: `derives Eq, Hash`")
            return
        if t.name == "Ord" && !has_trait(traits, "Eq") && !equality_by_hand
            c.note(unit, t.at, s"`${d.name}` derives `Ord` without `Eq`; ordering by the fields needs `==` by the same fields, so derive `Eq, Hash` with it")
            return
    for t in traits
        if t.builtin && fields_held(t.name) then c.derivations.push(Derivation(unit, d.name, false, t.name, t.at, false))
        library.push(t)

/** Whether the fields of a type deriving the core library's trait `name` must implement it: every
 * type has `Eq` and `Hash`. */
private fields_held(name: string) -> bool = name == "Ord" || name == "Display" || name == "Debug"

// The traits a data type derives, each through its template, into `library`. `Eq` and `Hash` it has
// already, by its fields, and `Display` and `Debug` unless its own impls give them.
private derive_data(c: *Checker, unit: usize, d: &DataDecl, library: *Buf[LibraryDerived])
    val implemented = impl_traits(c, unit, d.name)
    val traits = if d.derives.len() == 0 then buf() else derived_traits(c, unit, d.name, d.derives, implemented)
    for t in traits
        if t.builtin && !fields_held(t.name) then continue
        if t.builtin then c.derivations.push(Derivation(unit, d.name, true, t.name, t.at, false))
        library.push(t)
    // Each is declared at the type. A type declared twice is reported as such, and has none.
    if declarations_named(c, unit, d.name) > 1 then return
    for name in ["Display", "Debug"]
        if has_trait(traits, name) || contains_name(implemented, name) then continue
        if contains_name(impl_methods(c, unit, d.name), derived_method(name)) then continue
        if core_template(c, name) is Some(t)
            c.derivations.push(Derivation(unit, d.name, true, name, d.span, true))
            library.push(LibraryDerived(name, d.span, t.template_unit, t.template, true))

// Whether the bare name `name`, written in unit `unit`, denotes the core library's declaration of it:
// no declaration of the unit's module and no import of its file takes the name first. The core
// library's own files always mean their own.
private names_core(c: *Checker, unit: usize, name: string) -> bool
    val file = c.units[unit].file
    if file.module_name == CoreModule then return true
    for i in file.imports
        if i.binding == name then return false
    for u in c.units
        if u.file.module_name != file.module_name then continue
        for item in u.file.items
            item match
                FunctionItem(f) -> if f.name == name then return false
                ClassItem(d) -> if d.name == name then return false
                DataItem(d) ->
                    if d.name == name then return false
                    for v in d.variants
                        if v.name == name then return false
                ValueItem(v) -> if v.name == name then return false
                AliasItem(d) -> if d.name == name then return false
                ImplItem(_) -> ()
    true

// How many data types of the module are named `type_name`.
private declarations_named(c: *Checker, unit: usize, type_name: string) -> usize
    var count = 0usize
    val module_name = c.units[unit].file.module_name
    for u in c.units
        if u.file.module_name != module_name then continue
        for item in u.file.items
            if item is DataItem(d)
                if d.name == type_name then count += 1
    count

// The names of the methods that impls anywhere in the module declare for the type named `type_name`.
private impl_methods(c: *Checker, unit: usize, type_name: string) -> Buf[string]
    var out: Buf[string] = buf()
    val module_name = c.units[unit].file.module_name
    for u in c.units
        if u.file.module_name != module_name then continue
        for item in u.file.items
            if item is ImplItem(d)
                val target = d.target.kind match
                    Named(path, _) -> path
                    _ -> ""
                if target != type_name then continue
                for m in d.members
                    if m is MethodMember(f, _, _, _) then out.push(f.name)
    out

// `Name[T, U]`, the type with its own parameters as arguments.
private own_type(at: Span, name: string, type_params: Buf[TypeParam]) -> &TypeExpr
    var args: Buf[&TypeExpr] = buf()
    for tp in type_params
        args.push(named_type(at, tp.name))
    TypeExpr(at, Named(name, args))

private named_type(at: Span, name: string) -> &TypeExpr = TypeExpr(at, Named(name, buf()))

private int_lit(at: Span, spelling: string) -> &Expr = Expr(at, IntLit(spelling))
