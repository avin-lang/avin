module dev.avinlang.compiler

import sh.sysl.parsing.Span
import sysl.buf.Buf

// The mid-level representation: functions of basic blocks over numbered values, with explicit
// control flow and machine-level types. `unit` has no representation here: a unit value is never
// stored, passed or returned, so a unit parameter does not exist and a unit function returns
// nothing. Locals live in numbered slots, which code generation is free to promote to registers.

enum MirType
    /** An integer of a fixed width; `byte` is `MInt(8)` and `char` is `MInt(32)`. */
    MInt(bits: u32)
    MBool
    /** A binary64 floating-point number. */
    MReal
    /** An address the collector does not follow: a slot, a field, a descriptor. */
    MPtr
    /** A reference to an object on the collected heap, or to a constant object. Every reference a
     * function holds is kept where the collector can find it. */
    MRef

/** The result type of a function or call; `None` means it returns nothing. */
struct MirSignature
    params: Buf[MirType]
    result: Option[MirType]

enum Operand
    Value(id: usize)
    ConstInt(bits: u32, digits: string)
    ConstBool(value: bool)
    ConstReal(value: real)
    /** A string literal, a constant object, by its index in the program's string table. */
    ConstStr(index: usize)
    /** The address of one of the function's own slots. */
    SlotAddress(slot: usize)
    /** The one constant object of a variant with no field data, by its descriptor. */
    ConstObject(descriptor: usize)
    /** An object made at compile time, by its index in `MirProgram.constants`, and its descriptor. */
    ConstData(index: usize, descriptor: usize)
    /** The constant closure of a function that captures nothing, by its index in
     * `MirProgram.closures`. */
    ConstClosure(index: usize)
    /** The address of a function's code, by its index in `MirProgram.functions`, for code outside
     * the program to call: it is called with the C calling convention. */
    FunctionAddress(function: usize)
    /** The address of a module-level value's storage, by its index in `MirProgram.globals`. */
    GlobalAddress(index: usize)
    /** The address of a type record, by its index in `MirProgram.records`. */
    RecordAddress(index: usize)
    /** The address of a descriptor, by its index in `MirProgram.descriptors`: what the runtime
     * allocates an array by. */
    DescriptorAddress(descriptor: usize)
    /** The address that is no address: a string's descriptor's type record, and `None` of an option
     * kept as a pointer. */
    NullAddress
    /** The address of one of the program's trap sites, by its index in `MirProgram.traps`. */
    TrapSiteAddress(site: usize)
    /** The address of the context's caller site: the trap site where the thread last entered the
     * core library from the program's own code, which a trap inside the library reports. */
    CallerSite
    /** The address of the context's owner: who the code the thread runs is, which a use of a Sysl
     * handle compares with the handle's own owner. */
    OwnerWord
    /** The address of the program's closure runner, which the runtime calls with the C calling
     * convention to run a closure taking no parameters and yielding nothing: a started thread's. */
    ClosureRunner
    /** The address of the program's trampoline `c_trampolines[index]`, which C calls with its own
     * convention for a function pointer a C binding passes. */
    TrampolineAddress(index: usize)

enum Callee
    /** A function of this program, by its index in `MirProgram.functions`. */
    Direct(function: usize)
    /** An entry point of the runtime library, called with the C calling convention. */
    Runtime(symbol: string, signature: MirSignature)
    /** The code at an address: a method from a method table, a type record's entry, or what a
     * function value's `call` entry names, called with the object, then the arguments. Every such
     * address is a function of this program. */
    Indirect(target: Operand, signature: MirSignature)
    /** A C function a C binding calls, by its symbol, with the C calling convention and no context:
     * how each argument and the result cross, the result `None` where the call's answer is not
     * used. */
    CFunction(symbol: string, params: Buf[CScalar], result: Option[CScalar])

/** How a scalar crosses to or from a C function: the machine form of the C type at the target's
 * width. An integer is an operand of exactly its width, which the emitter extends to 32 bits as C's
 * convention asks for one narrower; a `float` is an operand of type `MReal`, rounded to binary32 at
 * the call and widened back from it. */
enum CScalar
    CSigned(bits: u32)
    CUnsigned(bits: u32)
    CBoolean
    CBinary64
    CBinary32
    /** A C pointer, an operand of type `MPtr`: a string's NUL-terminated bytes, in or out. */
    CAddress

/** Operations on two operands of one type that cannot fail. Division and shifts here have the
 * machine's meaning; lowering has already guarded the cases Avin defines differently. */
enum MirOp
    OpAdd
    OpSub
    OpMul
    OpDiv
    OpRem
    OpAnd
    OpOr
    OpXor
    OpShl
    OpAShr
    OpLShr
    OpAddSat
    OpSubSat
    OpMulSat
    OpFAdd
    OpFSub
    OpFMul
    OpFDiv
    OpFRem

/** Integer comparisons, signed and unsigned, and ordered real comparisons, except `FNe`, which is
 * true when either operand is NaN. */
enum MirCmp
    CmpEq
    CmpNe
    CmpLt
    CmpLe
    CmpGt
    CmpGe
    /** Unsigned `>=`, which tests a shift count against the width: a negative count is huge. */
    CmpUge
    CmpUlt
    CmpUle
    CmpUgt
    FEq
    FNe
    FLt
    FLe
    FGt
    FGe

/** An addition, subtraction or multiplication that also reports whether it overflowed. */
enum MirChecked
    CheckedAdd
    CheckedSub
    CheckedMul

/** A change of machine type. `RealToInt` truncates toward zero, saturates at the bounds and maps
 * NaN to zero. `Binary32ToReal` reads a 32-bit integer as the bits of a binary32 and widens it to a
 * `real`, exactly; `RealToBinary32` rounds a `real` to the nearest binary32 and gives its bits, which
 * is how a C `float` is read and written in memory. */
enum MirConv
    SignExtend
    ZeroExtend
    Truncate
    SignedToReal
    UnsignedToReal
    RealToInt
    Binary32ToReal
    RealToBinary32

enum Inst
    Call(dest: Option[usize], callee: Callee, args: Buf[Operand])
    Binary(dest: usize, op: MirOp, left: Operand, right: Operand)
    /** `dest` receives the wrapped result and `overflow` whether it overflowed. */
    Checked(dest: usize, overflow: usize, op: MirChecked, left: Operand, right: Operand)
    Compare(dest: usize, op: MirCmp, left: Operand, right: Operand)
    Select(dest: usize, condition: Operand, yes: Operand, no: Operand)
    Convert(dest: usize, conv: MirConv, value: Operand)
    /** Reads a value of `dest`'s type from an address. */
    Load(dest: usize, address: Operand)
    Store(address: Operand, value: Operand)
    /** A new object laid out by a descriptor, all zero, with the descriptor in the header the
     * collector keeps before it; allocating may collect. */
    Alloc(dest: usize, descriptor: usize)
    /** Makes every store before it visible to another thread no later than any store after it: it
     * ends the making of an object, so a thread that reads a reference to the object, however it
     * got it, sees the header and every field the object was made with. */
    Publish
    /** A sequentially consistent load of a value of `dest`'s type from `address`: an `Atomic`'s. */
    AtomicLoad(dest: usize, address: Operand)
    /** A sequentially consistent store of `value` at `address`. */
    AtomicStore(address: Operand, value: Operand)
    /** Stores `value` at `address` and gives `dest` what was there, as one sequentially consistent
     * step. */
    AtomicSwap(dest: usize, address: Operand, value: Operand)
    /** Stores `desired` at `address` where `expected` is there, as one sequentially consistent step,
     * and gives `dest` whether it did. */
    AtomicCompareSet(dest: usize, address: Operand, expected: Operand, desired: Operand)
    /** The address `bytes` past `base`: a field of an object. */
    Offset(dest: usize, base: Operand, bytes: usize)
    /** The address `index` bytes past `base`, for an index known only at run time and already
     * checked to lie inside the object: a byte of a string. */
    Index(dest: usize, base: Operand, index: Operand)
    /** The descriptor of `object`, read from the header word `KindBack` bytes before it. */
    DescriptorOf(dest: usize, object: Operand)
    /** The function in slot `slot` of the method table of `object`'s descriptor. */
    MethodSlot(dest: usize, object: Operand, slot: usize)
    /** The function a call of `object` as a function value runs: its descriptor's `call`. */
    CallEntry(dest: usize, object: Operand)

enum Terminator
    Return(value: Option[Operand])
    Jump(target: usize)
    Branch(condition: Operand, yes: usize, no: usize)
    /** Stops the program at one of the program's trap sites: an integer overflow, a division by
     * zero, a failed check. */
    Trap(site: usize)
    /** Stops the program on a failed check in the core library: the reason is `site`'s, the place
     * the context's caller site, where the program entered the library. */
    CallerTrap(site: usize)
    Unreachable

/** A place where the program can trap, written as constant data the runtime reports when it does:
 * what failed, and the file, line and column of the operation. `reason` and `file` index the
 * program's string constants; `line` and `col` count from 1. */
struct TrapSite
    reason: usize
    file: usize
    line: usize
    col: usize

struct MirBlock
    insts: Buf[Inst]
    term: Terminator

struct MirFunction
    symbol: string
    signature: MirSignature
    /** The type of each value. Values 0..params.len() are the parameters. */
    value_types: Buf[MirType]
    /** The type of each local slot. */
    slots: Buf[MirType]
    /** Block 0 is the entry. */
    blocks: Buf[MirBlock]

/** The layout of one variant of one data type, written as constant data the runtime reads: the
 * variant's tag, its size in bytes with the descriptor word, and the byte offsets of the fields
 * that hold references. A variant with no field data has one shared constant object instead of
 * allocating. A class's descriptor also carries its method table: the function in each slot, or
 * `None` for an abstract method's. An array's descriptor gives the size of one element instead,
 * lists no offsets, and with `elements` set holds references in every element, which the runtime's
 * array tracer marks. */
struct Descriptor
    name: string
    tag: usize
    size: usize
    refs: Buf[usize]
    constant: bool
    methods: Buf[Option[usize]]
    /** The type record of the objects' type, by its index in `MirProgram.records`. */
    record: usize
    elements: bool
    /** The function a call of the object as a function value runs, taking the object and then the
     * call's arguments: a closure's code, or the `apply` of a class or data type that is a function;
     * `None` for an object that is no function. */
    call: Option[usize]

/** What a type pattern reads to learn an object's type, written as constant data: one record per
 * type, which every descriptor of an object of that type names, and the records of the types it
 * conforms to besides itself, its ancestors. The record's address is the type's identity at run
 * time. A string is the exception: the runtime makes strings too, so their descriptors name no
 * record, and a null record is the mark of a string.
 *
 * A record also holds the type's equality entries, which `==` and the hash on an `Any` or a
 * trait-typed value call once both values are known to have the type: `equals` takes two objects of
 * it and `hash` one, by the functions' indices in `MirProgram.functions`. They are `None` for a type
 * no object has as its own, a trait's, and in a program that never compares such values.
 *
 * Its rendering entries, `display` and `debug`, are what showing an `Any` or a trait-typed value
 * calls: each takes an object of the type, a writer and a format spec, and renders the object by the
 * type's own `Display` or `Debug`, or as the type's name where the type has none. They are `None`
 * likewise, and in a program that never shows such values.
 *
 * `apart` marks the type of an object whose handles keep their owners when a value reaching it is
 * handed over: a reference to an actor, a future, a channel, a mutex. Handing a value over walks the
 * objects it reaches and stops at one of these, so a message that holds an actor's reference never
 * hands over what the actor holds. */
struct TypeRecord
    name: string
    ancestors: Buf[usize]
    equals: Option[usize]
    hash: Option[usize]
    display: Option[usize]
    debug: Option[usize]
    apart: bool

/** A closure that captures nothing, made once as constant data: its descriptor, whose `call` is
 * `function`, its entry. */
struct ClosureConstant
    descriptor: usize
    function: usize

/** An object made at compile time and written as read-only data: a module-level value whose
 * initializer is built only of literals, constructors of data types and collection literals of such
 * values. Its descriptor, its size in bytes, and its fields at their byte offsets, in order: an
 * array's length word and elements, or an object's fields. Nothing writes to it and the collector
 * never owns it, so a load from it is folded where it is compiled. */
struct ConstantObject
    descriptor: usize
    size: usize
    fields: Buf[ConstantField]

struct ConstantField
    offset: usize
    ty: MirType
    value: Operand

/** A function bound to Sysl: the shim symbol its body calls, the Sysl function the shim calls, and
 * how the shim converts each parameter and the result. `unit` and `span` place the binding's name,
 * where a diagnostic of the shim is reported. The body passes the shim the result's layouts after
 * the parameters. */
struct MirBinding
    shim: string
    target: string
    name: string
    params: Buf[&Crossing]
    result: &Crossing
    unit: usize
    span: Span
    /** For a method of a Sysl handle, how the shim reaches the handle's Sysl value, which its first
     * parameter, the receiver, holds; `TopLevel` for a top-level function. */
    reach: Reach
    /** Whether the Sysl call may wait, so the shim marks the thread safe for the collector around
     * it: `@sysl("name", blocking)`. */
    blocking: bool

/** What a binding's shim does with a Sysl handle's value. */
enum Reach
    /** A top-level function: the shim calls `target` itself. */
    TopLevel
    /** A method of a handle: the shim calls the Sysl method `method` of the value the receiver
     * holds. */
    Method(method: string)
    /** A handle's `close()`: the shim gives back the share of the value the receiver holds, leaving
     * it holding nothing. */
    Release

/** A class declared with `@sysl` as a handle on the Sysl type `target`: its objects hold one counted
 * Sysl reference each, which the shim's function `finalizer` gives back when the collector frees an
 * object still holding one: the collector's kind in the class's descriptor, `descriptor`, names it.
 * `unit` and `span` place its declaration. An instance of a generic handle class is a handle on the
 * generic Sysl type `target` names at the type `arguments` its class is given, each one Sysl type. */
struct MirHandle
    name: string
    target: string
    finalizer: string
    descriptor: usize
    unit: usize
    span: Span
    arguments: Buf[&Crossing]

/** How a binding's shim converts a value of one boundary type. Making a data value or an array out
 * of a Sysl one takes descriptors and constant objects, the conversion's `layouts`: its own
 * variants' first, one each in order, then each field's, variant by variant. */
struct Crossing
    ty: &Type
    form: CrossForm
    /** A data type's variants, in their declared order, which is their tags'; empty for any other
     * type. */
    variants: Buf[CrossVariant]
    layouts: usize

enum CrossForm
    /** A scalar or a string, converted by its type alone. */
    Plain
    /** `Array[byte]`, a Sysl `[]u8`, copied; its one layout is the array's descriptor. */
    Bytes
    /** The core library's `Option`; `pointer` where Avin keeps it as one pointer, `Some(x)` being `x`
     * and `None` null, rather than as an object. */
    OptionForm(pointer: bool)
    ResultForm
    /** A tuple of boundary types, a Sysl tuple of the same arity: one variant, whose fields are the
     * parts in order. */
    TupleForm
    /** A data type declared with `@sysl` to mirror the Sysl enum or struct `target`; `unit` and
     * `span` place its declaration. A struct is mirrored by one variant named as the type. */
    Mirror(name: string, target: string, unit: usize, span: Span, structure: bool)
    /** An `Array` or, when `vector`, a `Vector` of any other boundary type, copied element by
     * element: into Sysl as a slice, out of Sysl from a slice or a `Buf`. Its first layout is the
     * array's descriptor; a vector's next three are the core library's functions that make a vector
     * of an array, give its length and give the leaf that holds an index. The element's layouts
     * follow, and are passed for a parameter as for a result. */
    Elements(element: &Crossing, vector: bool)
    /** A class declared with `@sysl` as a handle on a Sysl type, made out of a Sysl value or counted
     * reference of that type: an object of the class laid out by its one layout, holding the
     * reference. `finalizer` names the handle among the program's. */
    Handle(finalizer: string)
    /** A function value passed as a binding's own parameter, which the shim hands Sysl as a closure
     * holding the function rooted. Sysl calls it with values converted out of Sysl by `params` and
     * takes its answer converted into Sysl by `result`; their layouts are the parameters', each in
     * order, then the result's, where its conversion into Sysl takes any. `machine` are the machine
     * types the function's code takes after the closure, `answer` the one it returns: the shim calls
     * it through an entry the program defines with the C convention. `threaded` says any thread may
     * call it; otherwise only the code that gave it may. */
    Callback(params: Buf[&Crossing], result: &Crossing, machine: Buf[MirType], answer: Option[MirType], threaded: bool)

/** One variant of a data type a shim converts: its name, which is the Sysl variant's, whether it is
 * one constant object, and its fields. Its layout is the one at its tag. */
struct CrossVariant
    name: string
    constant: bool
    fields: Buf[CrossField]

/** A field of a variant: its name, its offset in the object, absent for a field with no runtime
 * value, its conversion, and where that conversion's layouts start among its data type's. */
struct CrossField
    name: string
    offset: Option[usize]
    crossing: &Crossing
    base: usize

/** A test as `main` runs it: the test's function; for a test answering with a `Result`, the library
 * function that reads the answer, trapping on an `Err`, and the trap site it reports, the test's
 * name; and its module's hooks. */
struct MirTest
    function: usize
    answer: Option[usize]
    answer_site: usize
    setup: Option[usize]
    teardown: Option[usize]
    setup_all: Option[usize]
    teardown_all: Option[usize]

struct MirProgram
    functions: Buf[MirFunction]
    strings: Buf[string]
    descriptors: Buf[Descriptor]
    records: Buf[TypeRecord]
    closures: Buf[ClosureConstant]
    constants: Buf[ConstantObject]
    traps: Buf[TrapSite]
    /** The machine type of each module-level value, or `None` for one with no runtime value. Those
     * that hold references are roots of every collection. */
    globals: Buf[Option[MirType]]
    /** The function `main` calls; absent in a program built for its tests that has none. */
    entry: Option[usize]
    /** The function that initializes the module-level values, which `main` runs before the entry. */
    init: Option[usize]
    /** The program's Sysl bindings, in the order their functions were compiled. */
    bindings: Buf[MirBinding]
    /** The Sysl handles whose objects the program lays out, each once. */
    handles: Buf[MirHandle]
    /** The `@test` functions, in the order the checker found them. */
    tests: Buf[MirTest]
    /** Whether `main` runs the test its first argument numbers, counting from 0, instead of the
     * entry. */
    testing: bool
    /** The library function that builds the program's arguments, which `main` passes to the entry
     * when the entry takes them. */
    entry_arguments: Option[usize]
    /** The descriptor of every string, the program's literals and those the runtime makes: see
     * `string_descriptor` in lowering. */
    string_descriptor: usize
    /** The C handles whose objects the program lays out, each once: each `finalizer` is defined by
     * the program's C unit, and `target` is the C type the handle is on. */
    c_handles: Buf[MirHandle]
    /** The trampolines C calls an Avin function through, one for each parameter of a C binding that
     * takes a function. */
    c_trampolines: Buf[MirTrampoline]

/** A function C calls with its own convention, for a function pointer a C binding passes: it takes
 * `params`, the C function's parameters, among them the `userdata` at `userdata`, the address of the
 * callback's record, and answers `result`. It begins the call on the calling thread, runs `function`
 * with the thread's context, the record and every other parameter, which converts them, runs the Avin
 * function and converts its answer, and ends the call. */
struct MirTrampoline
    function: usize
    params: Buf[CScalar]
    userdata: usize
    result: Option[CScalar]
