module dev.avinlang.compiler

import sysl.buf.Buf

// The mid-level representation: functions of basic blocks over numbered values, with explicit
// control flow and machine-level types. `unit` has no representation here: a unit value is never
// stored, passed or returned, so a unit parameter does not exist and a unit function returns
// nothing. Locals live in numbered slots, which code generation is free to promote to registers.

enum MirType
    MInt(bits: u32)
    MBool
    /** A string: a pointer to UTF-8 bytes and their length. */
    MStr

/** The result type of a function or call; `None` means it returns nothing. */
struct MirSignature
    params: Buf[MirType]
    result: Option[MirType]

enum Operand
    Value(id: usize)
    ConstInt(bits: u32, digits: string)
    ConstBool(value: bool)
    /** A string literal, by its index in the program's string table. */
    ConstStr(index: usize)

enum Callee
    /** A function of this program, by its index in `MirProgram.functions`. */
    Direct(function: usize)
    /** An entry point of the runtime library, called with the C calling convention. */
    Runtime(symbol: string, signature: MirSignature)

/** Operations on two operands of one type that cannot fail. Division and shifts here have the
 * machine's meaning; lowering has already guarded the cases Avin defines differently. */
enum MirOp
    OpAdd
    OpSub
    OpMul
    OpDiv
    OpRem
    OpAnd
    OpOr
    OpXor
    OpShl
    OpAShr
    OpAddSat
    OpSubSat
    OpMulSat

/** Signed comparisons, and equality for any scalar. */
enum MirCmp
    CmpEq
    CmpNe
    CmpLt
    CmpLe
    CmpGt
    CmpGe
    /** Unsigned `>=`, which tests a shift count against the width: a negative count is huge. */
    CmpUge

/** An addition, subtraction or multiplication that also reports whether it overflowed. */
enum MirChecked
    CheckedAdd
    CheckedSub
    CheckedMul

enum Inst
    Call(dest: Option[usize], callee: Callee, args: Buf[Operand])
    Binary(dest: usize, op: MirOp, left: Operand, right: Operand)
    /** `dest` receives the wrapped result and `overflow` whether it overflowed. */
    Checked(dest: usize, overflow: usize, op: MirChecked, left: Operand, right: Operand)
    Compare(dest: usize, op: MirCmp, left: Operand, right: Operand)
    Select(dest: usize, condition: Operand, yes: Operand, no: Operand)
    Load(dest: usize, slot: usize)
    Store(slot: usize, value: Operand)

enum Terminator
    Return(value: Option[Operand])
    Jump(target: usize)
    Branch(condition: Operand, yes: usize, no: usize)
    /** Stops the program: an integer overflow, a division by zero, a failed check. */
    Trap
    Unreachable

struct MirBlock
    insts: Buf[Inst]
    term: Terminator

struct MirFunction
    symbol: string
    signature: MirSignature
    /** The type of each value. Values 0..params.len() are the parameters. */
    value_types: Buf[MirType]
    /** The type of each local slot. */
    slots: Buf[MirType]
    /** Block 0 is the entry. */
    blocks: Buf[MirBlock]

struct MirProgram
    functions: Buf[MirFunction]
    strings: Buf[string]
    entry: usize
