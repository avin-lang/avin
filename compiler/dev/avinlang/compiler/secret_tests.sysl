module dev.avinlang.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{current_dir, exists}
import sysl.process.{Var, capture}

// `avin.io.readSecret` against a real terminal. A program from `tests/pty` is built at both
// optimization levels and run by `tests/pty/pty_drive.c`, which gives it a pseudo-terminal as its
// controlling terminal (or none at all), types at it and reports the terminal's state. What the
// driver prints is everything the terminal showed, so a secret that was echoed would be in it.

/** Where the module's executables are built: the directory the runner-watch tests build the compiler
 * into, which their hooks make before any test and remove after the last. */
private const SecretDir: string = ".scratch/runner-watch-tests"

/** The driver's executable, compiled the first time it is asked for. */
private driver() -> string
    val bin = current_dir().unwrap() + "/" + SecretDir + "/pty_drive"
    if !exists(bin)
        // Tests run side by side and each may be first to ask: the executable is built under a name of
        // its own and moved into place whole, so no test finds it half written or fails to link over it.
        val made = capture("sh", ["-c", "cc -O1 -o \"$1.$$\" tests/pty/pty_drive.c -lutil && mv -f \"$1.$$\" \"$1\"", "sh", bin], stderr = true, timeout = 120000).unwrap()
        assert(made.status.ok(), made.err.unwrap_or(""))
    bin

private levels() -> []const string = ["-O0", "-O2"]

private secret_env() -> Buf[Var]
    var env: Buf[Var] = buf()
    env.push(Var("AVIN_ROOT", current_dir().unwrap()))
    env

/** The executable of the program `name` from `tests/pty` at `level`, built the first time it is asked for. */
private built(name: string, level: string) -> string
    val root = current_dir().unwrap() + "/" + SecretDir
    val bin = root + "/" + name + level
    if !exists(bin)
        // Built under a name of its own and moved into place whole, as the driver is.
        val ran = capture("sh", ["-c", "\"$1\" build \"$2\" \"$3\" -o \"$4.$$\" && mv -f \"$4.$$\" \"$4\"", "sh", root + "/avin", "tests/pty/" + name + ".avin", level, bin], env = secret_env().view(), stderr = true, timeout = 600000).unwrap()
        assert(ran.status.ok(), name + " " + level + ": " + ran.text + ran.err.unwrap_or(""))
    bin

/** Runs `name` at `level` under the driver with `script` and the program's own `args`; what the terminal showed. */
private drive(name: string, level: string, mode: string, script: []const string, args: []const string) -> string
    val bin = built(name, level)
    var all: Buf[string] = buf()
    if mode != "" then all.push(mode)
    for a in script
        all.push(a)
    all.push("--")
    all.push(bin)
    for a in args
        all.push(a)
    val ran = capture(driver(), all.view(), stderr = true, timeout = 180000).unwrap()
    assert(ran.status.ok(), ran.text + ran.err.unwrap_or(""))
    assert(!ran.text.contains("[timeout]"), "the program did not do what the script waited for:\n" + ran.text)
    ran.text

private count_of(text: string, needle: string) -> int
    var n = 0
    var tail = text
    loop
        tail.index_of(needle) match
            Some(i) ->
                n += 1
                tail = tail[i + needle.len..]
            None -> return n

/** The terminal's state as the driver reports it: echo off, line editing on, signals on. */
private const Hidden: string = "[echo=0 icanon=1 isig=1]"
/** The terminal as an ordinary one is: echo on, line editing on, signals on. */
private const Shown: string = "[echo=1 icanon=1 isig=1]"

/** The final report, which comes after the program's end. */
private ends_shown(out: string, what: string)
    assert(out.ends_with(Shown + "\n"), what + ": the terminal was not put back:\n" + out)

@test("the prompt is written to the terminal, what is typed is not echoed, and the line comes back without its newline")
prompt_hidden_and_returned()
    for level in levels()
        val out = drive("secret_show", level, "", ["expect:Password: ", "report", "send:hunter2\\n", "expect:got ", "send:next\\n"], ["bytes", "Password: "])
        assert(out.contains("Password: "), level + ":\n" + out)
        assert(!out.contains("hunter2"), level + ": the secret was echoed:\n" + out)
        assert(out.contains(Hidden), level + ": echo was not off while the secret was read:\n" + out)
        assert(out.contains("got 7 bytes: 104 117 110 116 101 114 50"), level + ":\n" + out)
        assert(out.contains("then: Some(next)"), level + ": standard input was not readable afterwards:\n" + out)
        assert(out.contains("[exit 0]"), level + ":\n" + out)
        ends_shown(out, level)

@test("a line read as text is the same line, and a typed line the program reads from standard input is echoed as ever")
text_and_control()
    for level in levels()
        val out = drive("secret_show", level, "", ["expect:pw: ", "send:swordfish\\n", "expect:got ", "send:visible\\n"], ["text", "pw: "])
        assert(out.contains("got 9 chars, 9 bytes: 115 119 111 114 100 102 105 115 104"), level + ":\n" + out)
        assert(!out.contains("swordfish"), level + ": the secret was echoed:\n" + out)
        assert(out.contains("visible"), level + ": the driver does not see an echo that is there:\n" + out)
        ends_shown(out, level)

@test("an empty line is an empty secret")
empty_line()
    for level in levels()
        val out = drive("secret_show", level, "", ["expect:> ", "send:\\n", "expect:got ", "send:x\\n"], ["bytes", "> "])
        assert(out.contains("got 0 bytes:\r"), level + ":\n" + out)
        ends_shown(out, level)

@test("a long line comes back whole")
long_line()
    var typed = ""
    for _ in 0..<1000
        typed = typed + "a"
    for level in levels()
        val out = drive("secret_show", level, "", ["expect:> ", "send:" + typed + "\\n", "expect:got ", "send:x\\n"], ["text", "> "])
        assert(out.contains("got 1000 chars, 1000 bytes: 97 97"), level + ":\n" + out)
        assert(!out.contains(typed), level + ": the secret was echoed")
        ends_shown(out, level)

@test("Unicode comes back as typed, as bytes and as text, and is not echoed")
unicode_line()
    for level in levels()
        val as_text = drive("secret_show", level, "", ["expect:> ", "send:pässwörd✓\\n", "expect:got ", "send:x\\n"], ["text", "> "])
        assert(as_text.contains("got 9 chars, 13 bytes: 112 195 164 115 115 119 195 182 114 100 226 156 147"), level + ":\n" + as_text)
        assert(!as_text.contains("pässwörd"), level + ": the secret was echoed")
        val as_bytes = drive("secret_show", level, "", ["expect:> ", "send:ü\\n", "expect:got ", "send:x\\n"], ["bytes", "> "])
        assert(as_bytes.contains("got 2 bytes: 195 188"), level + ":\n" + as_bytes)
        val prompt = drive("secret_show", level, "", ["expect:Passwort für ✓: ", "send:x\\n", "expect:got ", "send:x\\n"], ["bytes", "Passwort für ✓: "])
        assert(prompt.contains("Passwort für ✓: "), level + ": a Unicode prompt was not written whole:\n" + prompt)

@test("a line ending in a carriage return and a newline comes back without either")
carriage_return_line_feed()
    for level in levels()
        val out = drive("secret_show", level, "", ["expect:> ", "send:abc\\r\\n"], ["bytes", "> "])
        assert(out.contains("got 3 bytes: 97 98 99\r"), level + ":\n" + out)
        ends_shown(out, level)

@test("the end of input after some bytes ends the line; before any it is an error")
end_of_input()
    for level in levels()
        val some = drive("secret_show", level, "", ["expect:> ", "send:abc", "eof", "eof", "expect:got ", "eof"], ["bytes", "> "])
        assert(some.contains("got 3 bytes: 97 98 99\r"), level + ":\n" + some)
        ends_shown(some, level)
        val none = drive("secret_show", level, "", ["expect:> ", "eof", "expect:error", "eof"], ["bytes", "> "])
        assert(none.contains("error: cannot read the terminal: end of input"), level + ":\n" + none)
        assert(none.contains("no terminal: false"), level + ":\n" + none)
        ends_shown(none, level)

@test("two secrets in a row are each read with echo off, and the terminal is put back between them")
two_in_a_row()
    for level in levels()
        val out = drive("secret_twice", level, "", ["expect:one: ", "send:first\\n", "expect:two: ", "report", "send:second!\\n"], [])
        assert(out.contains("first: 5 chars") && out.contains("second: 7 chars"), level + ":\n" + out)
        assert(!out.contains("first\r") && !out.contains("second!"), level + ": a secret was echoed:\n" + out)
        assert(out.contains(Hidden), level + ":\n" + out)
        ends_shown(out, level)

@test("with no terminal the read fails with the NoTerminal kind, however standard input is connected")
no_terminal()
    for level in levels()
        val out = drive("secret_show", level, "--notty", ["expect:no terminal", "eof"], ["bytes", "> "])
        assert(out.contains("error: cannot read the terminal: there is no terminal"), level + ":\n" + out)
        assert(out.contains("no terminal: true"), level + ":\n" + out)
        assert(out.contains("then: None"), level + ":\n" + out)
        // Piped input is not read by the failed ask.
        val piped = drive("secret_show", level, "--notty", ["send:not for the secret\\n", "expect:no terminal", "send:kept\\n", "eof"], ["bytes", "> "])
        assert(piped.contains("then: Some(not for the secret)"), level + ": the failed read took from standard input:\n" + piped)

@test("readSecretOrLine takes the line from standard input, prompting on standard error, where there is no terminal")
fallback_to_standard_input()
    for level in levels()
        val out = drive("secret_show", level, "--notty", ["send:from a pipe\\n", "expect:got ", "send:rest\\n", "eof"], ["or-line", "pw: "])
        assert(out.contains("pw: "), level + ": the prompt was not written:\n" + out)
        assert(out.contains("got 11 chars, 11 bytes: 102 114 111 109 32 97 32 112 105 112 101"), level + ":\n" + out)
        assert(out.contains("then: Some(rest)"), level + ":\n" + out)
        val closed = drive("secret_show", level, "--notty", ["eof"], ["or-line", "pw: "])
        assert(closed.contains("error: cannot read standard input: end of input"), level + ":\n" + closed)
        assert(closed.contains("no terminal: false"), level + ":\n" + closed)

@test("readSecretOrLine reads at the terminal, hidden, where there is one")
or_line_with_a_terminal()
    for level in levels()
        val out = drive("secret_show", level, "", ["expect:pw: ", "report", "send:quiet\\n", "expect:got ", "send:x\\n"], ["or-line", "pw: "])
        assert(out.contains(Hidden), level + ":\n" + out)
        assert(!out.contains("quiet\r"), level + ": the secret was echoed:\n" + out)
        assert(out.contains("got 5 chars"), level + ":\n" + out)

@test("Ctrl-C while the secret is typed ends the program with the terminal put back")
interrupt_restores_echo()
    for level in levels()
        val out = drive("secret_show", level, "", ["expect:> ", "report", "send:abc\\x03"], ["bytes", "> "])
        assert(out.contains(Hidden), level + ":\n" + out)
        assert(out.contains("[signal 2]"), level + ":\n" + out)
        ends_shown(out, level)

@test("a terminate signal while the secret is typed ends the program with the terminal put back")
terminate_restores_echo()
    for level in levels()
        val out = drive("secret_show", level, "", ["expect:> ", "report", "kill:15"], ["bytes", "> "])
        assert(out.contains("[signal 15]"), level + ":\n" + out)
        ends_shown(out, level)

@test("a hangup while the secret is typed ends the program with the terminal put back")
hangup_restores_echo()
    for level in levels()
        val out = drive("secret_show", level, "", ["expect:> ", "kill:1"], ["bytes", "> "])
        assert(out.contains("[signal 1]"), level + ":\n" + out)
        ends_shown(out, level)

@test("a program that watches the interrupt signal survives Ctrl-C: the read fails as interrupted and the terminal is put back")
survived_interrupt()
    for level in levels()
        val out = drive("secret_watched", level, "", ["expect:secret: ", "report", "send:\\x03", "expect:watched"], [])
        assert(out.contains(Hidden), level + ":\n" + out)
        assert(out.contains("error: cannot read the terminal: interrupted"), level + ":\n" + out)
        assert(out.contains("watched: true"), level + ":\n" + out)
        assert(out.contains("[exit 0]"), level + ":\n" + out)
        ends_shown(out, level)

@test("a thread cancelled while it waits for the secret finishes the read, puts the terminal back, and then stops")
cancelled_read()
    for level in levels()
        val out = drive("secret_cancel", level, "", ["expect:secret: ", "sleep:700", "report", "send:typed\\n", "expect:scope done"], [])
        assert(out.contains(Hidden), level + ": the terminal was not hidden through the cancel:\n" + out)
        assert(!out.contains("typed\r"), level + ": the secret was echoed:\n" + out)
        assert(out.contains("thread: false"), level + ": the thread was not stopped:\n" + out)
        assert(out.contains("[exit 0]"), level + ":\n" + out)
        ends_shown(out, level)

@test("two threads asking at once are served one after the other")
concurrent_reads_are_serialized()
    for level in levels()
        val out = drive("secret_threads", level, "", ["expect:prompt-", "sleep:700", "report", "send:one\\n", "expect:prompt-", "report", "send:two\\n", "expect:done"], [])
        val first_report = out.index_of("[echo=").unwrap()
        assert(count_of(out[0..<first_report], "prompt-") == 1, level + ": the second prompt was written while the first read was waiting:\n" + out)
        assert(count_of(out, "prompt-") == 2, level + ":\n" + out)
        assert(count_of(out, Hidden) == 2, level + ":\n" + out)
        assert(count_of(out, "Ok(3)") == 2, level + ":\n" + out)
        assert(!out.contains("\none\r") && !out.contains("\ntwo\r"), level + ": a secret was echoed:\n" + out)
        ends_shown(out, level)

@test("a secret asked for while another thread reads standard input waits until that read is done")
secret_waits_for_standard_input()
    for level in levels()
        val out = drive("secret_vs_stdin", level, "", ["sleep:800", "report", "send:visible\\n", "expect:secret: ", "report", "send:hidden-text\\n", "expect:done"], [])
        val first_report = out.index_of("[echo=").unwrap()
        val prompt = out.index_of("secret: ").unwrap()
        assert(prompt > first_report, level + ": the prompt was written while standard input was being read:\n" + out)
        assert(out.contains("line: Some(visible)"), level + ":\n" + out)
        assert(out.contains("secret: Ok(11)"), level + ":\n" + out)
        assert(!out.contains("hidden-text"), level + ": the secret was echoed:\n" + out)
        assert(out.contains(Shown), level + ": a line read from standard input was read with echo off:\n" + out)
        ends_shown(out, level)

@test("Ctrl-Z during the read leaves echo on while the program is stopped; once continued the prompt is written again and the read goes on with echo off")
stopped_and_continued()
    for level in levels()
        val out = drive("secret_show", level, "--job", ["expect:> ", "report", "send:abc", "send:\\x1a", "expect:[stopped]", "report", "cont", "expect:> ", "report", "send:def\\n", "expect:got ", "send:x\\n"], ["bytes", "> "])
        assert(count_of(out, Hidden) == 2, level + ": echo was not off before the stop and after the continue:\n" + out)
        // The report taken while stopped, and the final one after the program ended.
        assert(count_of(out, Shown) == 2, level + ": echo was not on while the program was stopped:\n" + out)
        assert(count_of(out, "> ") >= 2, level + ": the prompt was not written again:\n" + out)
        // The terminal discards what was typed before the Ctrl-Z, as it does for any signal character.
        assert(out.contains("got 3 bytes: 100 101 102"), level + ": the line typed after the continue was not read:\n" + out)
        assert(!out.contains("abc") && !out.contains("def"), level + ": the secret was echoed:\n" + out)
        assert(out.contains("[exit 0]"), level + ":\n" + out)
        ends_shown(out, level)

@test("Ctrl-Z, a continue and Ctrl-C in turn: the terminal is put back at the end")
stopped_then_interrupted()
    for level in levels()
        val out = drive("secret_show", level, "--job", ["expect:> ", "send:\\x1a", "expect:[stopped]", "cont", "expect:> ", "report", "send:\\x03"], ["bytes", "> "])
        assert(out.contains(Hidden), level + ": the read did not go on hidden after the continue:\n" + out)
        assert(out.contains("[signal 2]"), level + ":\n" + out)
        ends_shown(out, level)
