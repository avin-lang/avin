module dev.avinlang.compiler

import sysl.process.{pid, resident_bytes}
import sysl.slices.as_mut_ptr

// What the compiler process holds, for the build log's `rss=`, `inuse=` and `maxrss=` fields.
//
// The three part company after a large compilation: the allocator keeps freed small blocks for the
// life of the process, so resident bytes stay high while the bytes in use fall back. Only a fresh
// process returns that memory, which is why the two are logged side by side.

// The bytes the allocator holds for live blocks, where the platform says (macOS's zone statistics,
// summed over every zone); zero elsewhere.
heap_in_use() -> u64
#if macos
    // `malloc_statistics_t`: a 32-bit block count (padded to a word), then the bytes in use, the most
    // ever in use, and the bytes the zones hold.
    var stats: []usize = [0; 4]

    c_zone_statistics(null, as_mut_ptr(stats))
    u64(stats[1])
#else
    0
#endif
end heap_in_use

// This process's resident bytes, or zero where the platform will not say.
own_resident() -> u64 = resident_bytes(int(pid())).unwrap_or(0)

// The most resident bytes this process has held at once.
peak_resident() -> u64
    var usage: [18]i64 = [0; 18]

    c_getrusage(0, &usage[0])
    u64(usage[4]) * peak_unit()
end peak_resident

// `ru_maxrss` is in bytes on macOS and in kilobytes elsewhere.
#if macos
private peak_unit() -> u64 = 1
#else
private peak_unit() -> u64 = 1024
#endif

private extern "getrusage" c_getrusage(who: i32, usage: *i64) -> i32

#if macos
private extern "malloc_zone_statistics" c_zone_statistics(zone: *u8, into: *usize)
#endif
