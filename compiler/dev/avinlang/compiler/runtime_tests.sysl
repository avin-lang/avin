module dev.avinlang.compiler
@tests

import sysl.process.capture

// The runtime is a package of its own, with its own Sysl tests; running them here keeps one gate for
// the whole repository.

@test("the runtime's own tests pass")
runtime_package_tests()
    val tc = repository_toolchain()
    val result = capture("sysl", ["test", tc.runtime_dir()], stderr = true, timeout = 300000) match
        Ok(r) -> r
        Err(e) -> panic("could not run sysl: " + e.to_string())
    if !result.status.ok() then panic("the runtime's tests failed:\n" + result.text + result.err.unwrap_or(""))
