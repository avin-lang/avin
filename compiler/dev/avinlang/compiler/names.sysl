module dev.avinlang.compiler

import sh.sysl.parsing.*
import sysl.text.chars_of
import sysl.unicode.{Category, Form, category, normalize, to_lower, to_upper}

// What a name may be spelled with, and what its spelling says about it.
//
// A name starts with a character of Unicode's `XID_Start` or `_` and continues with characters of
// `XID_Continue`: the identifier rule of UAX #31, with `_` added at the start. Every script's
// letters start a name; digits, combining marks and connector punctuation of every script continue
// one; nothing else (a symbol, an emoji, a space of any kind) is part of a name.
//
// A name is written in Normalization Form C. Two spellings of one name that differ only in how an
// accented letter is composed would otherwise be two names that look the same, so a name in any
// other form is reported where it is written, with its NFC spelling, and every name the compiler
// compares, looks up or emits is the text as written.
//
// A name is **capitalized** when its first character is an uppercase or titlecase letter (Unicode
// `Lu` or `Lt`): `Ärger`, `Δelta`, `ǅemal`. A letter with no case -- an ideograph, a kana, an
// Arabic letter -- is not capitalized.

/** A character of an identifier's head, below ASCII: a letter or `_`. */
private val ascii_name_start: ByteSet = byte_set_where(is_ident_start)

/** A character of an identifier's tail, below ASCII: a letter, a digit or `_`. */
private val ascii_name_cont: ByteSet = byte_set_where(is_ident_cont)

/** Whether code point `u` may begin a name. */
name_start(u: u32) -> bool =
    if u < 0x80 then ascii_name_start.has(u8(u)) else in_ranges(xid_start_ranges, u)

/** Whether code point `u` may continue a name. */
name_cont(u: u32) -> bool =
    if u < 0x80 then ascii_name_cont.has(u8(u))
    else in_ranges(xid_start_ranges, u) || in_ranges(xid_continue_ranges, u)

/** The name that starts at the scanner's cursor, read to its end; `None` and no movement where the
 * character there cannot begin one. */
read_name(s: *Scanner) -> Option[Span] =
    s.read_ident_wide(ascii_name_start, ascii_name_cont, name_start, name_cont)

/** Whether the character at the scanner's cursor can begin a name. */
at_name_start(s: *Scanner) -> bool = name_start_at(s.rest(), 0)

/** Whether the character beginning at byte `i` of `b` can begin a name. */
name_start_at(b: []const u8, i: usize) -> bool
    if i >= b.len then return false
    if b[i] < 0x80 then return ascii_name_start.has(b[i])
    chars_of(b[i..<b.len]).peek() match
        Some(c) -> name_start(u32(c))
        None -> false

/** Whether `text` is in Normalization Form C. An ASCII text always is. */
is_nfc(text: string) -> bool
    for b in text.bytes
        if b >= 0x80 then return normalize(Form.Nfc, text) == text
    true

/** `text` in Normalization Form C. */
nfc_of(text: string) -> string = normalize(Form.Nfc, text)

/** Whether `text` is spelled as a name is: a start character, then continue characters. Whether it
 * is a keyword, or in NFC, is the caller's question. */
spelled_as_name(text: string) -> bool
    var first = true
    for c in chars_of(text.bytes)
        val u = u32(c)
        if first && !name_start(u) then return false
        if !first && !name_cont(u) then return false
        first = false
    !first

/** Whether a name is capitalized: its first character is an uppercase or titlecase letter. */
is_capitalized(name: string) -> bool = chars_of(name.bytes).peek() match
    Some(c) -> is_upper_char(c)
    None -> false

/** Whether `c` is an uppercase or titlecase letter (`Lu` or `Lt`). */
is_upper_char(c: char) -> bool =
    if u32(c) < 0x80 then 'A' <= c && c <= 'Z'
    else category(c) == Category.Lu || category(c) == Category.Lt

/** Whether `c` is a lowercase letter (`Ll`). A letter with no case is not one. */
is_lower_char(c: char) -> bool =
    if u32(c) < 0x80 then 'a' <= c && c <= 'z' else category(c) == Category.Ll

/** `c`'s simple lowercase mapping. */
lower_char(c: char) -> char = to_lower(c)

/** `c`'s simple uppercase mapping. */
upper_char(c: char) -> char = to_upper(c)

/** The message for a character outside every name and every token, written where a name or a token
 * was expected. */
stray_character_message(c: char) -> string =
    if name_cont(u32(c)) then s"`$c` (${code_point_of(c)}) cannot begin a name: a name begins with a letter or `_`"
    else s"`$c` (${code_point_of(c)}) is not a character a name or an operator is spelled with"

/** `U+` and a code point's hexadecimal digits, at least four. */
code_point_of(c: char) -> string
    val hex = "0123456789ABCDEF"
    var u = u32(c)
    var digits = ""
    while u > 0 || digits.bytes.len < 4
        val d = usize(u & 15)
        digits = hex[d..<d + 1] + digits
        u = u >> 4
    "U+" + digits

/** Whether `u` falls inside one of a table's ranges, which are sorted by low end and do not overlap. */
private in_ranges(t: []const (u32, u32), u: u32) -> bool
    var lo: usize = 0
    var hi = t.len
    while lo < hi
        val mid = lo + (hi - lo) / 2
        val (a, b) = t[mid]
        if u < a then
            hi = mid
        elif u > b then
            lo = mid + 1
        else
            return true
    false

// The two tables, and where every number in them came from.
//
// **Nothing here was written by hand.** Both are `DerivedCoreProperties.txt` of the Unicode
// Character Database at **17.0.0** (the version `sysl.unicode` answers from), reduced to ranges,
// with adjacent ranges merged and the code points below 0x80 left out (the byte sets above answer
// those):
//
//   - `xid_start_ranges` is the property `XID_Start`.
//   - `xid_continue_ranges` is `XID_Continue` with `XID_Start` taken out, since every start
//     character also continues a name.
//
// Bringing them up to a later Unicode is re-running that filter over the file published at
// `https://www.unicode.org/Public/UCD/latest/ucd/`; nothing else is consulted.
