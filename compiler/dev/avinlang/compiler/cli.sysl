module dev.avinlang.compiler

import sysl.buf.{Buf, buf}
import sysl.env.get
import sysl.fs.{canonicalize, entries, exists, is_dir, read_text, write_text_atomic}
import sysl.path.stem
import sysl.process.Stdio
import sysl.slices.sort_by

const Version: string = "0.0.18"
const NoToolchain: string = "avin: cannot find the Avin library and runtime: they are installed in `share/avin` beside `bin/avin`; for a source checkout, set AVIN_ROOT to the directory that holds `library/` and `runtime/`"
const Usage: string = "usage: avin [<program>] [-O0 | -O2] [-- <argument>...]\n       avin parse [<program>]\n       avin check [<program>] [--bindings] [<features>]\n       avin emit-llvm [<program>] -o <module.ll>\n       avin build [<program>] [-o <executable>] [-O0 | -O2] [<features>]\n       avin run [<program>] [-O0 | -O2] [<features>] [-- <argument>...]\n       avin test [<program>] [<filter>] [--prefix] [-O0 | -O2] [<features>]\n       avin new <dir> [--lib]\n       avin add <source>[@<version>] [<package>]\n       avin tidy [--check] [<package>]\n       avin vendor [<package>] [<features>]\n       avin fmt [--check] [<path>...]\n       avin tangle <file.lavin> [-o <path>]\n       avin weave <file.lavin> [-o <file.html>]\n       avin lsp [--stdio]\n       avin --help\n       avin --version\n<program> is a path in a package (a directory holding avin.hocon), a source file (`.avin`, or `.lavin` for a literate one), or a directory holding a program's modules; left out, it is the current directory\n`avin` alone is `avin run`, and `avin <program> ...` is `avin run <program> ...` when the first argument is not a command; reach a file or directory named like a command as `./test`\n`avin test`: an argument that names an existing file or directory is the program, any other is the filter; `avin test . <filter>` filters when a path of that name exists; `--prefix` puts each file's path and a colon before every result line\n`avin check` stops after type checking; `--bindings` also builds the shims of the Sysl bindings and the C unit, so a binding Sysl or the C compiler rejects is reported\n<features> are `--features a,b`, `--no-default-features` and `--all-features`, choosing the package's features; `avin test`, `avin check` and `avin vendor` turn every feature on unless one is given"

// Output channels, the exit status and the toolchain location stay outside command dispatch, so
// every command can be run and tested in memory. 0 is success, 1 a source, I/O or build failure,
// 2 incorrect invocation; `avin run` exits with the program's own status.
run_cli(args: []const string, tc: Option[Toolchain], say: string -> unit, note: string -> unit) -> int =
    run_cli_with(args, tc, say, note, Stdio.Inherit, Stdio.Inherit)

/** `run_cli`, with the standard output and error that the program `avin run` starts writes to. */
run_cli_with(args: []const string, tc: Option[Toolchain], say: string -> unit, note: string -> unit, stdout: Stdio, stderr: Stdio) -> int =
    run_cli_in(".", args, tc, say, note, stdout, stderr)

/** Every command name; a first argument that is one is that command, never a path. */
is_command(word: string) -> bool
    for c in ["parse", "check", "emit-llvm", "build", "run", "test", "new", "add", "tidy", "vendor", "fmt", "tangle", "weave", "lsp"]
        if c == word then return true
    false

/** `run_cli_with`, where `here` is the program a command that takes one uses when none is named.
 *
 * `avin` alone is `avin run`, and a first argument that is not a command name is a path: `avin
 * <path> ...` is `avin run <path> ...`. A first argument of `-O0`, `-O2` or `--` is `avin run` of
 * `here` with those arguments. */
run_cli_in(here: string, args: []const string, tc: Option[Toolchain], say: string -> unit, note: string -> unit, stdout: Stdio, stderr: Stdio) -> int
    if args.len == 2 && args[1] == "--help"
        say(Usage)
        return 0
    if args.len == 2 && args[1] == "--version"
        say("avin " + Version)
        return 0
    if args.len == 1 || !is_command(args[1])
        var full: Buf[string] = buf()
        full.push(args[0])
        full.push("run")
        if args.len >= 2 && !args[1].starts_with("-") && !exists(args[1])
            note(s"avin: unknown command or file `${args[1]}`\n" + Usage)
            return 2
        if args.len >= 2 && args[1].starts_with("-") && args[1] != "-O0" && args[1] != "-O2" && args[1] != "--"
            note(Usage)
            return 2
        for i in 1..<args.len
            full.push(args[i])
        return run_command(here, full.view(), tc, say, note, stdout, stderr)
    run_command(here, args, tc, say, note, stdout, stderr)

run_command(here: string, args: []const string, tc: Option[Toolchain], say: string -> unit, note: string -> unit, stdout: Stdio, stderr: Stdio) -> int
    if args.len >= 2 && args[1] == "lsp" then return lsp_command(args, tc, note)
    if args.len >= 2 && (args[1] == "tangle" || args[1] == "weave") then return literate_command(args, say, note)
    if args.len >= 2 && args[1] == "new" then return new_command(args, say, note)
    if args.len >= 2 && args[1] == "tidy" then return tidy_command(args, say, note)
    if args.len >= 2 && args[1] == "fmt" then return fmt_command(args, say, note)
    if args.len >= 2 && args[1] == "add" then return add_command(args, say, note)
    if args.len >= 2 && args[1] == "vendor" then return vendor_command(args, say, note)
    val command = args[1]
    // The program is the next argument when it is one: not an option, and for `test`, naming an existing
    // path (otherwise that argument is the filter). Left out, it is `here`.
    val named = args.len >= 3 && !args[2].starts_with("-") && (command != "test" || exists(args[2]))
    val path = if named then args[2] else here
    var output: Option[string] = None
    var optimization: Option[string] = None
    var filter: Option[string] = None
    var program_args: Buf[string] = buf()
    var bindings = false
    var prefix = false
    var flags = FeatureFlags(false, false, false, buf())
    val takes_features = command == "build" || command == "run" || command == "check" || command == "test"
    var i = if named then 3usize else 2usize
    while i < args.len
        val a = args[i]
        if a == "--" && command == "run"
            for j in i + 1..<args.len
                program_args.push(args[j])
            break
        if takes_features
            val took = feature_flag(args, i, &flags)
            if took > 0
                i += took
                continue
        if a == "--prefix" && command == "test" && !prefix
            prefix = true
            i += 1
            continue
        if a == "--bindings" && command == "check" && !bindings
            bindings = true
            i += 1
            continue
        if a == "-o" && i + 1 < args.len && output is None
            output = Some(args[i + 1])
            i += 2
            continue
        if (a == "-O0" || a == "-O2") && optimization is None then optimization = Some(a)
        elif command == "test" && !a.starts_with("-") && filter is None then filter = Some(a)
        else
            note(Usage)
            return 2
        i += 1
    val valid = (command == "parse" || command == "check") && output is None && optimization is None ||
        command == "emit-llvm" && output is Some(_) && optimization is None || command == "build" ||
        (command == "run" || command == "test") && output is None
    if !valid
        note(Usage)
        return 2
    if output is Some(out)
        if canonicalize(path) is Ok(a)
            if canonicalize(out) is Ok(b)
                if a == b
                    note("avin: the output would overwrite the source file")
                    return 2
    // A path in a package is the package; another directory is the root of a program of many files;
    // a file is a program by itself.
    if !named && is_dir(path) && !holds_program(path)
        note(s"avin: no Avin program here: $path holds no ${ManifestName} and no `.avin` or `.lavin` files")
        return 1
    // `avin test` and `avin check` turn every feature on unless a flag says otherwise, since a module
    // no build compiles is a module nothing checks.
    val choice = flags.choice(command == "test" || command == "check")
    val program = load_program_with(path, default_fetching(), choice) match
        Ok(p) -> p
        Err(message) ->
            note(message.trim_end())
            return 1
    val files = program.files
    if command == "parse" then return run_parse(files, say, note)
    val toolchain = tc match
        Some(t) -> t
        None ->
            note(NoToolchain)
            return 1
    if open_build_log(get(BuildLogVariable)) is Err(message)
        note(message)
        return 1
    defer close_build_log()
    val level = optimization.unwrap_or("-O2")
    if command == "run" || command == "test"
        val building = live_begin(program.root, PhaseCompile)
        val built = cached_build(toolchain, program.root, files, command == "test", level, program.sysl, program.c) match
            Ok(b) -> b
            Err(message) ->
                live_end(building)
                note(message)
                return 1
        live_end(building)
        if command == "test"
            val code = run_tests(built, program.root, filter.unwrap_or(""), prefix, say)
            flush_now()
            return code
        return run_binary(built.path, program_args.view(), stdout, stderr) match
            Ok(status) -> status
            Err(message) ->
                note(message)
                1
    // A package without `main` is a library, so a package is checked as its tests are built, which
    // need no `main` but hold one that is there to its form.
    val testing = command == "check" && program.package is Some(_)
    // `check` stops after checking, which is what type errors need; `--bindings` goes on to build the
    // shims of the Sysl bindings and the C unit, whose compilers can reject a binding the checker accepts.
    if command == "check" && !bindings
        val diagnostics = check_only(toolchain, files, testing, program.c)
        if diagnostics != ""
            note(diagnostics)
            return 1
        say("checked " + path)
        return 0
    val compiled = compile_program(toolchain, files, testing, program.sysl, program.c)
    if compiled.diagnostics != ""
        note(compiled.diagnostics)
        return 1
    val llvm = compiled.llvm.unwrap_or("")
    if command == "check"
        say("checked " + path)
        return 0
    if command == "emit-llvm"
        write_text_atomic(output.unwrap_or(""), llvm) match
            Ok(_) -> return 0
            Err(e) ->
                note("avin: " + e.to_string())
                return 1
    val executable = output.unwrap_or(program.package.unwrap_or(default_output(path)))
    if is_dir(executable)
        note(s"avin: `$executable` is a directory; name the executable with -o")
        return 1
    link(toolchain, llvm, compiled.archive, executable, level, compiled.c_link) match
        Ok(_) -> 0
        Err(message) ->
            note("avin: " + message)
            1
end run_command

/** Whether the directory `dir` is, or is inside, a package, or holds source files of a program. */
holds_program(dir: string) -> bool
    if enclosing_package(dir) is Ok(Some(_)) then return true
    program_files(dir) match
        Ok(files) -> files.len() > 0
        Err(_) -> true

/** `avin new <dir> [--lib]`: a new package at `dir`, a program or with `--lib` a library. */
new_command(args: []const string, say: string -> unit, note: string -> unit) -> int
    var dir: Option[string] = None
    var library = false
    for i in 2..<args.len
        if args[i] == "--lib" && !library then library = true
        elif !args[i].starts_with("-") && dir is None then dir = Some(args[i])
        else
            note(Usage)
            return 2
    val target = dir match
        Some(d) -> d
        None ->
            note(Usage)
            return 2
    new_package(target, library) match
        Ok(name) ->
            say(s"created ${if library then "library" else "program"} package `$name` in $target")
            0
        Err(message) ->
            note(message)
            1

/** `avin add <source>[@<version>] [<package>]`: the dependency recorded in the manifest of the package
 * (the current directory's when none is named), fetched, and its hash added to the sum file. */
add_command(args: []const string, say: string -> unit, note: string -> unit) -> int
    var source: Option[string] = None
    var dir: Option[string] = None
    for i in 2..<args.len
        if !args[i].starts_with("-") && source is None then source = Some(args[i])
        elif !args[i].starts_with("-") && dir is None then dir = Some(args[i])
        else
            note(Usage)
            return 2
    val given = dir.unwrap_or(".")
    val what = source match
        Some(s) -> s
        None ->
            note(Usage)
            return 2
    val home = enclosing_package(given) match
        Ok(Some(d)) -> d
        Ok(None) ->
            note(s"avin: $given is in no package: `avin add` records a dependency in a package's $ManifestName")
            return 1
        Err(message) ->
            note(message.trim_end())
            return 1
    add_dependency(home, what, default_fetching(), say) match
        Ok(_) -> 0
        Err(message) ->
            note(message.trim_end())
            1

/** `avin tidy [--check] [<package>]`: the sum file rewritten to what the package's whole resolution
 * reads, or with `--check` a failure when it is not that already. */
tidy_command(args: []const string, say: string -> unit, note: string -> unit) -> int
    var dir: Option[string] = None
    var check = false
    for i in 2..<args.len
        if args[i] == "--check" && !check then check = true
        elif !args[i].starts_with("-") && dir is None then dir = Some(args[i])
        else
            note(Usage)
            return 2
    val home = project_of(dir.unwrap_or("."), "tidy", note) match
        Some(h) -> h
        None -> return 1
    tidy(home, default_fetching(), check, say) match
        Ok(true) -> 0
        Ok(false) ->
            if !check then return 0
            note(s"avin: $SumName is not tidy; `avin tidy` rewrites it to what the package resolves to")
            1
        Err(message) ->
            note(message.trim_end())
            1

/** `avin fmt [--check] [<path>...]`: every `.avin` and `.lavin` file under the paths (the current
 * directory when none is given) rewritten in the house style, or with `--check` the files that are
 * not in it listed and a failure. A directory or file whose name starts with `.` is passed over. */
fmt_command(args: []const string, say: string -> unit, note: string -> unit) -> int
    var check = false
    var paths: Buf[string] = buf()
    for i in 2..<args.len
        if args[i] == "--check" && !check then check = true
        elif args[i].starts_with("-")
            note(Usage)
            return 2
        else paths.push(args[i])
    if paths.len() == 0 then paths.push(".")
    var failed = false
    var files: Buf[string] = buf()
    for p in paths
        if is_dir(p) then fmt_collect(p, &files)
        elif exists(p) then files.push(p)
        else
            note(s"avin: $p: no such file or directory")
            failed = true
    var unformatted = 0
    for file in files
        val text = read_text(file) match
            Ok(t) -> t
            Err(e) ->
                note(s"avin: $file: ${e.to_string()}")
                failed = true
                continue
        val formatted = format_text(file, text) match
            Ok(t) -> t
            Err(why) ->
                note(why)
                failed = true
                continue
        if formatted == text then continue
        unformatted += 1
        if check
            say(file)
        elif write_text_atomic(file, formatted) is Err(e)
            note(s"avin: $file: ${e.to_string()}")
            failed = true
    if failed then return 1
    if check && unformatted > 0
        val files_are = if unformatted == 1 then "file is" else "files are"
        note(s"avin: $unformatted $files_are not formatted; `avin fmt` rewrites them")
        return 1
    0

// The source files under a directory, in name order.
private fmt_collect(dir: string, files: *Buf[string])
    var names = entries(dir).unwrap_or(buf())
    sort_by(names.view(), fmt_name_before)
    for name in names
        if name.starts_with(".") then continue
        val full = if dir.ends_with("/") then dir + name else dir + "/" + name
        if is_dir(full) then fmt_collect(full, files)
        elif is_source_name(name) then files.push(full)

private fmt_name_before(a: string, b: string) -> bool = a < b

/** `avin vendor [<package>]`: every fetched package the package's whole resolution reads copied into
 * `vendor/` beside its manifest, the workspace root's in a workspace, and what it no longer reads
 * removed from there. */
vendor_command(args: []const string, say: string -> unit, note: string -> unit) -> int
    var dir: Option[string] = None
    var flags = FeatureFlags(false, false, false, buf())
    var i = 2usize
    while i < args.len
        val took = feature_flag(args, i, &flags)
        if took > 0
            i += took
            continue
        if !args[i].starts_with("-") && dir is None then dir = Some(args[i])
        else
            note(Usage)
            return 2
        i += 1
    val home = project_of(dir.unwrap_or("."), "vendor", note) match
        Some(h) -> h
        None -> return 1
    vendor_with(home, default_fetching(), flags.choice(true), say) match
        Ok(_) -> 0
        Err(message) ->
            note(message.trim_end())
            1

/** The feature flags a command was given: whether any was, `--all-features`, `--no-default-features`,
 * and the names of every `--features`. */
struct FeatureFlags
    given: bool
    all: bool
    no_defaults: bool
    names: Buf[string]

    /** The root package's features the flags choose; with none given, every feature when `every`, and
     * otherwise the defaults. */
    choice(self, every: bool) -> FeatureChoice
        if !self.given then return if every then every_feature() else default_features()
        FeatureChoice(self.all, !self.no_defaults, self.names)
end FeatureFlags

// Reads the feature flag at `args[i]` into `flags`, answering how many arguments it took: 0 when
// `args[i]` is none, and for `--features` with no names after it.
private feature_flag(args: []const string, i: usize, flags: *FeatureFlags) -> usize
    val a = args[i]
    if a == "--all-features"
        flags.given = true
        flags.all = true
        return 1
    if a == "--no-default-features"
        flags.given = true
        flags.no_defaults = true
        return 1
    if a == "--features" && i + 1 < args.len && !args[i + 1].starts_with("-")
        flags.given = true
        for n in args[i + 1].split(",")
            if n != "" then flags.names.push(n)
        return 2
    0

// The package or workspace `avin <command>` given `given` works on: a workspace's root whole, and any
// other path the package it is in. Says through `note` why there is none.
private project_of(given: string, command: string, note: string -> unit) -> Option[string]
    if exists(given + "/" + ManifestName) then return Some(given)
    enclosing_package(given) match
        Ok(Some(d)) -> Some(d)
        Ok(None) ->
            note(s"avin: $given is in no package: `avin $command` reads a package's $ManifestName")
            None
        Err(message) ->
            note(message.trim_end())
            None

/** Where `avin build` writes when no `-o` is given: the package's name, or the source's name without
 * `.avin` or `.lavin`, or the program directory's name, in the working directory. */
default_output(path: string) -> string
    // `.` and `..` have no name of their own; the directory they are is named.
    val named = if is_dir(path) && canonicalize(path) is Ok(full) then full else path
    stem(named).unwrap_or("a.out")

run_parse(files: Buf[ProgramFile], say: string -> unit, note: string -> unit) -> int
    var declarations = 0usize
    var failed = false
    for f in files
        val parsed = parse(f.src)
        if parsed.report.has_errors()
            note(parsed.report.render(parsed.source))
            failed = true
        declarations += parsed.file.items.len()
    if failed then return 1
    say(s"parsed $declarations declarations")
    0
