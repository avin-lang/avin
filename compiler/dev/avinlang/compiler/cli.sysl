module dev.avinlang.compiler

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.fs.{canonicalize, is_dir, read_text, write_text_atomic}
import sysl.path.stem
import sysl.process.Stdio

const Version: string = "0.1.0"
const Usage: string = "usage: avin parse <program>\n       avin check <program>\n       avin emit-llvm <program> -o <module.ll>\n       avin build <program> [-o <executable>] [-O0 | -O2]\n       avin run <program> [-O0 | -O2] [-- <argument>...]\n       avin test <program> [<filter>] [-O0 | -O2]\n       avin lsp [--stdio]\n       avin --help\n       avin --version\n<program> is a source file, or a directory holding a program's modules"

// Output channels, the exit status and the toolchain location stay outside command dispatch, so
// every command can be run and tested in memory. 0 is success, 1 a source, I/O or build failure,
// 2 incorrect invocation; `avin run` exits with the program's own status.
run_cli(args: []const string, tc: Option[Toolchain], say: string -> unit, note: string -> unit) -> int =
    run_cli_with(args, tc, say, note, Stdio.Inherit, Stdio.Inherit)

/** `run_cli`, with the standard output and error that the program `avin run` starts writes to. */
run_cli_with(args: []const string, tc: Option[Toolchain], say: string -> unit, note: string -> unit, stdout: Stdio, stderr: Stdio) -> int
    if args.len == 2 && args[1] == "--help"
        say(Usage)
        return 0
    if args.len == 2 && args[1] == "--version"
        say("avin " + Version)
        return 0
    if args.len >= 2 && args[1] == "lsp" then return lsp_command(args, tc, note)
    if args.len < 3
        note(Usage)
        return 2
    val command = args[1]
    val path = args[2]
    var output: Option[string] = None
    var optimization: Option[string] = None
    var filter: Option[string] = None
    var program_args: Buf[string] = buf()
    var i = 3usize
    while i < args.len
        val a = args[i]
        if a == "--" && command == "run"
            for j in i + 1..<args.len
                program_args.push(args[j])
            break
        if a == "-o" && i + 1 < args.len && output is None
            output = Some(args[i + 1])
            i += 2
            continue
        if (a == "-O0" || a == "-O2") && optimization is None then optimization = Some(a)
        elif command == "test" && !a.starts_with("-") && filter is None then filter = Some(a)
        else
            note(Usage)
            return 2
        i += 1
    val valid = (command == "parse" || command == "check") && output is None && optimization is None ||
        command == "emit-llvm" && output is Some(_) && optimization is None || command == "build" ||
        (command == "run" || command == "test") && output is None
    if !valid
        note(Usage)
        return 2
    if output is Some(out)
        if canonicalize(path) is Ok(a)
            if canonicalize(out) is Ok(b)
                if a == b
                    note("avin: the output would overwrite the source file")
                    return 2
    // A directory is the root of a program of many files; a file is a program by itself.
    var files: Buf[ProgramFile] = buf()
    if is_dir(path)
        files = program_files(path) match
            Ok(f) -> f
            Err(message) ->
                note("avin: " + message)
                return 1
        if files.len() == 0
            note(s"avin: $path: no `.avin` files in the program")
            return 1
    else
        val text = read_text(path) match
            Ok(t) -> t
            Err(e) ->
                note(s"avin: $path: ${e.to_string()}")
                return 1
        files = single_file(source_of(path, text))
    if command == "parse" then return run_parse(files, say, note)
    val toolchain = tc match
        Some(t) -> t
        None ->
            note("avin: cannot find the Avin library and runtime; set AVIN_ROOT to the directory that holds them")
            return 1
    val level = optimization.unwrap_or("-O2")
    if command == "run" || command == "test"
        val built = cached_build(toolchain, path, files, command == "test", level) match
            Ok(b) -> b
            Err(message) ->
                note(message)
                return 1
        if command == "test" then return run_tests(built, path, filter.unwrap_or(""), say)
        return run_binary(built.path, program_args.view(), stdout, stderr) match
            Ok(status) -> status
            Err(message) ->
                note(message)
                1
    val compiled = compile_files(toolchain, files)
    if compiled.diagnostics != ""
        note(compiled.diagnostics)
        return 1
    val llvm = compiled.llvm.unwrap_or("")
    if command == "check"
        say("checked " + path)
        return 0
    if command == "emit-llvm"
        write_text_atomic(output.unwrap_or(""), llvm) match
            Ok(_) -> return 0
            Err(e) ->
                note("avin: " + e.to_string())
                return 1
    val executable = output.unwrap_or(default_output(path))
    if is_dir(executable)
        note(s"avin: `$executable` is a directory; name the executable with -o")
        return 1
    link(toolchain, llvm, compiled.archive, executable, level) match
        Ok(_) -> 0
        Err(message) ->
            note("avin: " + message)
            1
end run_cli_with

/** Where `avin build` writes when no `-o` is given: the source's name without `.avin`, or the
 * program directory's name, in the working directory. */
default_output(path: string) -> string = stem(path).unwrap_or("a.out")

run_parse(files: Buf[ProgramFile], say: string -> unit, note: string -> unit) -> int
    var declarations = 0usize
    var failed = false
    for f in files
        val parsed = parse(f.src)
        if parsed.report.has_errors()
            note(parsed.report.render(f.src))
            failed = true
        declarations += parsed.file.items.len()
    if failed then return 1
    say(s"parsed $declarations declarations")
    0
