module dev.avinlang.compiler
@tests

import sysl.fs.{exists, make_temp_dir, read_text, remove_dir_all}

// `avin doc --std` over the whole standard library: every module checked and indexed, its doc
// comments sound, and a page written for each module with something public.

@test("doc --std: the whole standard library is documented, and its doc comments pass --check")
doc_whole_library()
    val tc = repository_toolchain()
    var said = ""
    var noted = ""
    val checked = run_cli(["avin", "doc", "--std", "--check"], Some(tc), s -> said = said + s + "\n", s -> noted = noted + s + "\n")
    assert_eq(noted, "")
    assert_eq(checked, 0)
    assert(said.starts_with("checked the documentation of "))
    val dir = make_temp_dir("avin-doc-std").unwrap()
    defer _ = remove_dir_all(dir)
    said = ""
    val written = run_cli(["avin", "doc", "--std", "-o", dir], Some(tc), s -> said = said + s + "\n", s -> noted = noted + s + "\n")
    assert_eq(noted, "")
    assert_eq(written, 0)
    val index = read_text(dir + "/index.html").unwrap()
    assert(index.contains("<h1>Avin standard library</h1>"))
    assert(index.contains("<a href=\"avin.regex.html\">avin.regex</a>"))
    assert(!index.contains("<h2>Standard library</h2>"))
    assert(exists(dir + "/avin.fs.html"))
    val prelude = read_text(dir + "/avin.html").unwrap()
    assert(prelude.contains("<section class=\"decl data\" id=\"Option\">"))
    // A method an impl adds is anchored under the type the impl is for.
    assert(prelude.contains("<section class=\"decl method\" id=\"Option.getOrElse\">"))
    assert(!exists(dir + "/tests.html"))
