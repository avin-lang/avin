module dev.avinlang.compiler
@tests

import sh.sysl.parsing.{Source, source_of}
import sysl.buf.{Buf, buf}
import sysl.env.get
import sysl.fs.{create, current_dir, entries, exists, is_dir, make_dir_all, make_temp_dir, read_text, remove_dir_all, set_permissions, write_text}
import sysl.process.{Exited, FromPath, Signalled, Stdio, ToFile, Var, capture, run}
import sysl.text.from_utf8_unchecked

// The execution corpus: Avin programs under `tests/` with their expected behaviour.
//
// `tests/run/*.avin` must compile and, at -O0 and -O2, exit and print exactly as expected. A
// program's leading comment says how it ends: `// expect: exit N`, or `// expect: trap` for a
// program a trap stops; with neither, it exits 0. Its standard output and error are in `NAME.out`
// and `NAME.err` beside it, when it writes any. Its standard input is `NAME.in` beside it, and empty
// when there is none, so no program reads the input of the test run.
//
// Every program runs with `AVIN_GC_STRESS=1`, so the collector runs at every allocation and a
// reference the compiler failed to root is found at once. A `// env: NAME=VALUE` line sets a variable
// for the program's run, and may turn stress off for a program that allocates heavily. An
// `// args: ARG ...` line gives the program arguments, separated by spaces, an argument in double
// quotes holding spaces or nothing at all. A `// stderr: actor numbers vary` line compares standard
// error with every number after a `#` shown as `n` (`Racer#n`), for a program whose actors race and
// whose reports therefore name whichever actor lost. A `// stderr: places hidden in FILE` line compares
// it with the line and column dropped from every place in `FILE` (`at server.avin`), for a program
// that traps inside a library file whose lines move as that file is edited.
//
// A test for a known bug keeps its correct expectations and carries a `// ignore: REASON` line, which
// is required: the program is then neither compiled nor run, and the summary counts it apart and
// prints it with its reason. In a program of many files the line goes in the main module (the other
// expectation lines may be in any file, and so may this one).
//
// `examples/*.avin` are held to the same standard as `tests/run`, so every example shown to a
// reader builds and does what its header says.
//
// So is every program the website shows as one. In `docs/content/**/*.md`, a fence whose info string
// carries the word `run` after its language (```` ```text run ````) holds a complete program, and the
// next fence, carrying `output` (```` ```text output ````), holds exactly what it prints. Each such
// program is built and run as an example is; the words after the language change nothing in how the
// page renders.
//
// A program in any of these places may be a literate `.lavin` file; its expectation lines are
// comments of its program, read from the program with the prose stripped.
//
// `tests/reject/*.avin` must fail to compile, and each `// error: TEXT` line in it names text the
// diagnostics must contain.
//
// `tests/programs/run/NAME/` and `tests/programs/reject/NAME/` are programs of many files, each
// directory the root of one program, held to the same standards. Their expectation lines may be in
// any of their files, and their output is in `NAME.out` and `NAME.err` beside the directory.
//
// The tests find the corpus from the working directory, which `sysl test` leaves as it found it:
// they run from the repository root or from `compiler/`.

/** The toolchain of this tree, building into the user's cache, with the programs' own builds, which
 * the tests' programs in temporary directories would leave behind there, kept in a temporary
 * directory of this process's instead. */
repository_toolchain() -> Toolchain
    val here = current_dir().unwrap_or(".")
    for root in [here, here + "/.."]
        if toolchain_at(root) is Some(tc) then return tc.building_in(test_builds())
    panic("run the tests from the repository root or from compiler/: no library/ and runtime/ at " + here)

private var test_builds_dir: string = ""

/** The directory this process's tests keep the programs' builds in, made the first time it is asked. */
private test_builds() -> string
    if test_builds_dir == "" then test_builds_dir = make_temp_dir("avin-test-builds").unwrap()
    test_builds_dir

private struct Expectation
    exit: int
    trap: bool
    errors: Buf[string]
    env: Buf[Var]
    args: Buf[string]
    ignored: bool
    reason: string
    numbers_vary: bool
    places_hidden: Buf[string]
    times_vary: bool

private expectation(text: string) -> Expectation
    var e = Expectation(0, false, buf(), buf(), buf(), false, "", false, buf(), false)
    for line in text.split("\n")
        if line == "// ignore" || line.starts_with("// ignore:")
            e.ignored = true
            e.reason = if line.bytes.len > "// ignore:".bytes.len then line["// ignore:".bytes.len..].trim() else ""
        elif line.starts_with("// expect: exit ") then e.exit = parse_int(line["// expect: exit ".bytes.len..])
        elif line == "// expect: trap" then e.trap = true
        elif line == "// stderr: actor numbers vary" then e.numbers_vary = true
        elif line == "// stderr: times vary" then e.times_vary = true
        elif line.starts_with("// stderr: places hidden in ") then e.places_hidden.push(line["// stderr: places hidden in ".bytes.len..].trim())
        elif line.starts_with("// error: ") then e.errors.push(line["// error: ".bytes.len..])
        elif line.starts_with("// env: ")
            val setting = line["// env: ".bytes.len..]
            for i in 0..<setting.bytes.len
                if setting.bytes[i] == u8('=')
                    e.env.push(Var(setting[0..<i], setting[i + 1..]))
                    break
        elif line.starts_with("// args: ")
            for a in split_args(line["// args: ".bytes.len..]) do e.args.push(a)
    e

/** The arguments of an `// args:` line: words separated by spaces, a double-quoted word holding
 * spaces or nothing at all. */
private split_args(text: string) -> Buf[string]
    var out: Buf[string] = buf()
    var word: Buf[u8] = buf()
    var quoted = false
    var started = false
    for b in text.bytes
        if b == u8('"')
            quoted = !quoted
            started = true
        elif b == u8(' ') && !quoted
            if started then out.push(from_utf8_unchecked(word.view()))
            word = buf()
            started = false
        else
            word.push(b)
            started = true
    if started then out.push(from_utf8_unchecked(word.view()))
    out

private parse_int(text: string) -> int
    var n = 0
    for b in text.bytes
        if b >= u8('0') && b <= u8('9') then n = n * 10 + int(b - u8('0'))
    n

// The text of the sidecar `base` + `suffix`, or "" when there is none.
private sidecar(base: string, suffix: string) -> string
    val other = base + suffix
    if exists(other) then read_text(other).unwrap_or("") else ""

// What a program reads as standard input: the sidecar `base` + ".in", or nothing when there is none.
private input_of(base: string) -> Stdio =
    if exists(base + ".in") then FromPath(base + ".in") else FromPath("/dev/null")

private without_extension(path: string) -> string = without_source_extension(path)

/** The programs in a directory of the repository. */
private cases(tc: Toolchain, dir: string) -> Buf[string] = cases_in(tc.root + "/" + dir)

private cases_in(dir: string) -> Buf[string]
    var out: Buf[string] = buf()
    for name in entries(dir).unwrap_or(buf())
        if name.starts_with(".") then continue
        if is_source_name(name) then out.push(dir + "/" + name)
    out

/** The program directories in a directory of the repository; a name starting with `.` (a build
 * cache) is not a program. */
private program_cases(tc: Toolchain, dir: string) -> Buf[string] = program_cases_in(tc.root + "/" + dir)

private program_cases_in(dir: string) -> Buf[string]
    var out: Buf[string] = buf()
    for name in entries(dir).unwrap_or(buf())
        if name.starts_with(".") then continue
        if is_dir(dir + "/" + name) then out.push(dir + "/" + name)
    out

/** A program to run or reject: its files, the text of them all, which holds its expectations, the
 * Sysl packages its manifest names, and why the package could not be loaded, or "". */
private struct Case
    files: Buf[ProgramFile]
    text: string
    sysl: Buf[SyslPackage]
    c: Buf[CLibrary]
    refused: string

// A directory holding a manifest is a package, loaded with its dependencies and fetching none; its
// own files hold its expectations.
private case_at(path: string) -> Case
    if is_dir(path)
        val files = program_files(path).unwrap()
        var text = ""
        for f in files
            text = text + expectation_text(f.src) + "\n"
        val fetching = default_fetching()
        if !exists(path + "/" + ManifestName)
            return load_program(path, Fetching(fetching.cache, fetching.base, false)) match
                Ok(p) -> Case(p.files, text, buf(), buf(), "")
                Err(message) -> Case(files, text, buf(), buf(), message)
        return load_package(path, Fetching(fetching.cache, fetching.base, false)) match
            Ok(p) -> Case(p.files, text, p.sysl, p.c, "")
            Err(message) -> Case(files, text, buf(), buf(), message)
    // A program of one file reads the packages its dependencies header names, fetching none.
    val src = source_of(path, read_text(path).unwrap_or(""))
    val fetching = default_fetching()
    load_script(path, src, Fetching(fetching.cache, fetching.base, false)) match
        Ok(p) -> Case(p.files, expectation_text(src), p.sysl, p.c, "")
        Err(message) -> Case(single_file(src), expectation_text(src), buf(), buf(), message)

// Compiles a case as the command line would, or answers why its package could not be loaded.
//
// With `AVIN_INCREMENTAL=verify` in the tests' own environment, the corpus is built warm as well as
// cold: each case is built with an empty instance cache in `scratch`, then edited (`warm_edit`) and
// built again from that cache in `verify` mode, which also builds it clean and fails the case where
// the two texts differ. The warm build is the one that runs. Unset, or anything else, the case is
// built once with no cache, as every gate builds it; so is a case given no `scratch`, which a
// program that must not compile is.
private compile_case(tc: Toolchain, program: Case, scratch: string) -> Compilation
    if program.refused != "" then return Compilation(program.refused, None, None, buf(), buf())
    if scratch == "" || get("AVIN_INCREMENTAL").unwrap_or("") != "verify" then return compile_program(tc, program.files, false, program.sysl, program.c)
    val cache = scratch + "/instances"
    _ = remove_dir_all(cache)
    open_incremental(cache, IncrementalOn)
    defer close_incremental()
    val cold = compile_program(tc, program.files, false, program.sysl, program.c)
    if cold.diagnostics != "" then return cold
    open_incremental(cache, IncrementalVerify)
    compile_program(tc, warm_edit(program.files), false, program.sysl, program.c)

/** `files` with the edit the warm corpus run makes before its second build: a function nothing calls
 * added at the end of the first of the program's own files that is not literate. It changes the
 * file, so the executable's build key, but no line of what the program does or reports. */
warm_edit(files: Buf[ProgramFile]) -> Buf[ProgramFile]
    var out: Buf[ProgramFile] = buf()
    var edited = false
    for f in files
        if !edited && !f.dependency && !is_literate(f.src.name)
            val text = from_utf8_unchecked(f.src.bytes)
            val ending = if text.ends_with("\n") then "" else "\n"
            out.push(ProgramFile(source_of(f.src.name, text + ending + "\ncorpusWarmEdit() -> int = 1\n"), f.module_name, f.dependency, f.fences, f.package))
            edited = true
        else out.push(f)
    out

// The lines a file's expectations are read from: its text, or a literate file's program, where its
// expectation comments stand at the margin of the program rather than four columns in.
private expectation_text(src: Source) -> string =
    if is_literate(src.name) then tangled_program(src).unwrap_or("") else from_utf8_unchecked(src.bytes)

// A program's sidecars: `NAME.out` beside `NAME.avin`, or beside the directory `NAME`.
private sidecar_base(path: string) -> string = if is_dir(path) then path else without_extension(path)

/** What a pass over a directory of programs found: the failure descriptions, how many programs
 * passed and failed, and the ignored ones with their reasons. */
private struct Tally
    failures: string
    passed: int
    failed: int
    ignored: Buf[string]

private tally() -> Tally = Tally("", 0, 0, buf())

// Counts one program's outcome: a failure description, or "" when it passed.
private record(t: Tally, failure: string) -> Tally =
    if failure == "" then Tally(t.failures, t.passed + 1, t.failed, t.ignored)
    else Tally(t.failures + failure, t.passed, t.failed + 1, t.ignored)

// Counts an ignored program, or fails one whose `// ignore:` line gives no reason.
private record_ignored(t: Tally, path: string, want: Expectation) -> Tally =
    if want.reason == "" then record(t, path + ": `// ignore:` needs a reason\n")
    else
        var list = t.ignored
        list.push(path + ": " + want.reason)
        Tally(t.failures, t.passed, t.failed, list)

/** The summary line of a pass, which names the ignored programs beneath it. */
private summary(label: string, t: Tally) -> string
    var out = s"$label: ${t.passed} passed, ${t.failed} failed, ${t.ignored.len()} ignored\n"
    for line in t.ignored
        out = out + "  ignored " + line + "\n"
    out

// Prints the summary and fails the test when anything failed.
private finish(label: string, t: Tally)
    print(summary(label, t))
    if t.failures != "" then panic(t.failures)

// Runs every program in a directory.
private run_all(tc: Toolchain, all: Buf[string]) -> Tally
    val scratch = make_temp_dir("avin-corpus").unwrap()
    defer _ = remove_dir_all(scratch)
    var t = tally()
    assert(all.len() > 0)
    for path in all
        val program = case_at(path)
        val want = expectation(program.text)
        t = if want.ignored then record_ignored(t, path, want) else record(t, run_case(tc, path, program, want, scratch))
    t

/** Runs one program at both optimization levels; a failure description, or "" when it passed. */
private run_case(tc: Toolchain, path: string, program: Case, want: Expectation, scratch: string) -> string
    val compiled = compile_case(tc, program, scratch)
    if compiled.diagnostics != "" then return path + ": did not compile:\n" + compiled.diagnostics
    val llvm = compiled.llvm.unwrap_or("")
    val stdout = sidecar(sidecar_base(path), ".out")
    val stderr = sidecar(sidecar_base(path), ".err")
    var failures = ""
    for level in ["-O0", "-O2"]
        val binary = scratch + "/program" + level
        link(tc, llvm, compiled.archive, binary, level, compiled.c_link, keep_units = false) match
            Err(message) ->
                failures = failures + s"$path $level: did not link: $message\n"
                continue
            Ok(_) -> ()
        var env: Buf[Var] = buf()
        var stress = true
        for v in want.env
            env.push(v)
            if v.name == "AVIN_GC_STRESS" then stress = false
        if stress then env.push(Var("AVIN_GC_STRESS", "1"))
        // A minute catches a program that hangs, and leaves room for a program that collects on
        // every allocation while the machine is busy with other builds. The program runs in a
        // process group of its own, so neither it nor anything it starts outlives the run, or this
        // runner when it is stopped.
        _ = watch_for_runner_signals()
        val run = run_contained(binary, want.args.view(), env.view(), input_of(sidecar_base(path)), 60000) match
            Ok(r) -> r
            Err(e) ->
                failures = failures + s"$path $level: did not run: ${e.to_string()}\n"
                continue
        val ended = run.status match
            Exited(code) -> !want.trap && code == want.exit
            Signalled(_) -> want.trap
            _ -> false
        if !ended then failures = failures + s"$path $level: ended ${run.status.to_string()}\n"
        if run.text != stdout then failures = failures + s"$path $level: standard output was:\n${run.text}\n"
        var err = if want.numbers_vary then without_actor_numbers(run.err.unwrap_or("")) else run.err.unwrap_or("")
        for name in want.places_hidden do err = without_places_in(err, name)
        if want.times_vary then err = without_times(err)
        if err != stderr then failures = failures + s"$path $level: standard error was:\n$err\n"
    failures

/** `text` with the number after every `#` shown as `n`, so `Racer#7` reads `Racer#n`: the standard
 * error of a program whose actors race, where which actor's report it holds is decided at run time. */
without_actor_numbers(text: string) -> string
    var out: Buf[u8] = buf()
    var i: usize = 0
    while i < text.bytes.len
        out.push(text.bytes[i])
        if text.bytes[i] == u8('#') && i + 1 < text.bytes.len && u8('0') <= text.bytes[i + 1] <= u8('9')
            out.push(u8('n'))
            i += 1
            while i < text.bytes.len && u8('0') <= text.bytes[i] <= u8('9') do i += 1
        else i += 1
    from_utf8_unchecked(out.view())

/** `text` with the number before every ` ms` shown as `n`, so `sleeping, 12 ms` reads `sleeping, n ms`:
 * the standard error of a program that writes a thread dump, whose waits last as long as the machine
 * makes them. */
without_times(text: string) -> string
    val n = text.bytes.len
    var out: Buf[u8] = buf()
    var i: usize = 0
    while i < n
        var j = i
        while j < n && u8('0') <= text.bytes[j] <= u8('9') do j += 1
        val unit = j + 3 <= n && text.bytes[j] == u8(' ') && text.bytes[j + 1] == u8('m') && text.bytes[j + 2] == u8('s')
        val ends = j + 3 == n || (j + 3 < n && !(u8('a') <= text.bytes[j + 3] <= u8('z')))
        if j > i && unit && ends
            out.push(u8('n'))
            i = j
        elif j > i
            while i < j
                out.push(text.bytes[i])
                i += 1
        else
            out.push(text.bytes[i])
            i += 1
    from_utf8_unchecked(out.view())

/** `text` with the line and column dropped from every place in the file `name`, so
 * `x at server.avin:225:46` reads `x at server.avin`: the standard error of a program that traps
 * inside a library file, whose lines move whenever that file is edited. */
without_places_in(text: string, name: string) -> string
    val marker = " at " + name + ":"
    val m = marker.bytes.len
    val n = text.bytes.len
    var out: Buf[u8] = buf()
    var i: usize = 0
    while i < n
        var found = i + m < n && u8('0') <= text.bytes[i + m] <= u8('9')
        var k: usize = 0
        while found && k < m
            if text.bytes[i + k] != marker.bytes[k] then found = false
            k += 1
        if found
            for j in 0..<m - 1 do out.push(marker.bytes[j])
            i += m
            while i < n && (u8('0') <= text.bytes[i] <= u8('9') || text.bytes[i] == u8(':')) do i += 1
        else
            out.push(text.bytes[i])
            i += 1
    from_utf8_unchecked(out.view())

// The corpus is run in four parts, each its own test, so the parts run side by side and no one
// test holds every program.

/** The programs of part `k` of `n`: every `n`th program, starting from the `k`th. */
private part_of(all: Buf[string], k: int, n: int) -> Buf[string]
    var out: Buf[string] = buf()
    var i = 0
    for path in all
        if i % n == k then out.push(path)
        i = i + 1
    out

private corpus_part(k: int)
    val tc = repository_toolchain()
    finish(s"tests/run part ${k + 1} of 4", run_all(tc, part_of(cases(tc, "tests/run"), k, 4)))

@test("every program in tests/run, part 1 of 4, builds, exits and prints as expected at -O0 and -O2")
corpus_runs_1()
    corpus_part(0)

@test("every program in tests/run, part 2 of 4, builds, exits and prints as expected at -O0 and -O2")
corpus_runs_2()
    corpus_part(1)

@test("every program in tests/run, part 3 of 4, builds, exits and prints as expected at -O0 and -O2")
corpus_runs_3()
    corpus_part(2)

@test("every program in tests/run, part 4 of 4, builds, exits and prints as expected at -O0 and -O2")
corpus_runs_4()
    corpus_part(3)

@test("the four parts of tests/run hold every program exactly once, none of them empty")
corpus_parts_cover()
    val tc = repository_toolchain()
    val all = cases(tc, "tests/run")
    var seen: Buf[string] = buf()
    for k in 0..<4
        val part = part_of(all, k, 4)
        assert(part.len() > 0)
        for path in part
            seen.push(path)
    assert_eq(seen.len(), all.len())
    for path in all
        var count = 0
        for p in seen
            if p == path then count = count + 1
        assert_eq(count, 1)
    var few: Buf[string] = buf()
    few.push("a")
    few.push("b")
    assert_eq(part_of(few, 0, 4).len(), 1)
    assert_eq(part_of(few, 1, 4).len(), 1)
    assert_eq(part_of(few, 2, 4).len(), 0)
    assert_eq(part_of(few, 3, 4).len(), 0)

@test("every program of many modules in tests/programs/run builds, exits and prints as expected at -O0 and -O2")
programs_run()
    val dir = make_temp_dir("avin-c-fixture").unwrap()
    defer _ = remove_dir_all(dir)
    val tc = fixture_toolchain(repository_toolchain(), dir)
    finish("tests/programs/run", run_all(tc, program_cases(tc, "tests/programs/run")))

/** The repository's toolchain, whose `pkg-config` also answers for `avin-c-fixture`: the C library in
 * `tests/c` the C binding tests call, built into `dir` with a module file naming it there. */
fixture_toolchain(tc: Toolchain, dir: string) -> Toolchain
    val object = dir + "/avin_fixture.o"
    val compiled = capture(tc.clang, ["-c", "-O1", tc.root + "/tests/c/avin_fixture.c", "-o", object], stderr = true, timeout = 120000).unwrap()
    if !compiled.status.ok() then panic("the C fixture did not compile: " + compiled.err.unwrap_or("") + compiled.text)
    val handles = dir + "/avin_handles.o"
    val made = capture(tc.clang, ["-c", "-O1", tc.root + "/tests/c/avin_handles.c", "-o", handles], stderr = true, timeout = 120000).unwrap()
    if !made.status.ok() then panic("the C fixture's handles did not compile: " + made.err.unwrap_or("") + made.text)
    val fields = dir + "/avin_fields.o"
    val fielded = capture(tc.clang, ["-c", "-O1", tc.root + "/tests/c/avin_fields.c", "-o", fields], stderr = true, timeout = 120000).unwrap()
    if !fielded.status.ok() then panic("the C fixture's fields did not compile: " + fielded.err.unwrap_or("") + fielded.text)
    val enums = dir + "/avin_enums.o"
    val enumerated = capture(tc.clang, ["-c", "-O1", tc.root + "/tests/c/avin_enums.c", "-o", enums], stderr = true, timeout = 120000).unwrap()
    if !enumerated.status.ok() then panic("the C fixture's enums did not compile: " + enumerated.err.unwrap_or("") + enumerated.text)
    val arrays = dir + "/avin_arrays.o"
    val arrayed = capture(tc.clang, ["-c", "-O1", tc.root + "/tests/c/avin_arrays.c", "-o", arrays], stderr = true, timeout = 120000).unwrap()
    if !arrayed.status.ok() then panic("the C fixture's arrays did not compile: " + arrayed.err.unwrap_or("") + arrayed.text)
    val structs = dir + "/avin_structs.o"
    val structured = capture(tc.clang, ["-c", "-O1", tc.root + "/tests/c/avin_structs.c", "-o", structs], stderr = true, timeout = 120000).unwrap()
    if !structured.status.ok() then panic("the C fixture's structs did not compile: " + structured.err.unwrap_or("") + structured.text)
    val callbacks = dir + "/avin_callbacks.o"
    val called = capture(tc.clang, ["-c", "-O1", tc.root + "/tests/c/avin_callbacks.c", "-o", callbacks], stderr = true, timeout = 120000).unwrap()
    if !called.status.ok() then panic("the C fixture's callbacks did not compile: " + called.err.unwrap_or("") + called.text)
    val buffers = dir + "/avin_buffers.o"
    val buffered = capture(tc.clang, ["-c", "-O1", tc.root + "/tests/c/avin_buffers.c", "-o", buffers], stderr = true, timeout = 120000).unwrap()
    if !buffered.status.ok() then panic("the C fixture's buffers did not compile: " + buffered.err.unwrap_or("") + buffered.text)
    val archived = capture("ar", ["rcs", dir + "/libavin_fixture.a", object, handles, fields, enums, arrays, structs, callbacks, buffers], stderr = true, timeout = 60000).unwrap()
    if !archived.status.ok() then panic("the C fixture was not archived: " + archived.err.unwrap_or("") + archived.text)
    make_dir_all(dir + "/pkgconfig").unwrap()
    write_text(dir + "/pkgconfig/avin-c-fixture.pc", "Name: avin-c-fixture\nDescription: the C library the C binding tests call\nVersion: 1.0.0\nCflags: -I" + tc.root + "/tests/c\nLibs: -L" + dir + " -lavin_fixture\n").unwrap()
    val wrapper = dir + "/pkg-config"
    write_text(wrapper, "#!/bin/sh\nPKG_CONFIG_PATH=\"" + dir + "/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}\" exec pkg-config \"$@\"\n").unwrap()
    set_permissions(wrapper, 493u32).unwrap()
    Toolchain(tc.root, tc.cache, tc.clang, tc.sysl, wrapper, tc.builds)

@test("every example builds, exits and prints as its header says at -O0 and -O2")
examples_run()
    val tc = repository_toolchain()
    finish("examples", run_all(tc, cases(tc, "examples")))

/** A program a documentation page shows: the line its fence opens on, its text, and the output the
 * page says it prints. */
private struct DocProgram
    line: int
    program: string
    output: string

/** The programs a page marks, and what is wrong with its marks, one line per problem, or "". */
private struct DocPrograms
    programs: Buf[DocProgram]
    problems: string

/** The run of three or more backticks or tildes that opens a fence on `line`, or "" when none does. */
private fence_marker(line: string) -> string
    if line.bytes.len == 0 then return ""
    val c = line.bytes[0]
    if c != u8('`') && c != u8('~') then return ""
    var i: usize = 0
    while i < line.bytes.len && line.bytes[i] == c do i += 1
    if i >= 3 then line[0..<i] else ""

/** Whether `line` closes the fence `marker` opened: the same character, at least as many times, and
 * nothing else. */
private closes_fence(line: string, marker: string) -> bool
    val t = line.trim()
    if t.bytes.len < marker.bytes.len then return false
    for b in t.bytes
        if b != marker.bytes[0] then return false
    true

/** What a fence's info string marks it as: "run", "output", or "" for a fence that is only shown.
 * The first word is the language, so only the words after it mark. */
private fence_kind(info: string) -> string
    var kind = ""
    var first = true
    for word in info.trim().split(" ")
        if !first && (word == "run" || word == "output") then kind = word
        if word != "" then first = false
    kind

/** The programs marked on the page `page`, whose text is `text`: each `run` fence paired with the
 * `output` fence after it. A `run` fence followed by any other fence, or by none, an `output` fence
 * with no `run` fence before it, and a marked fence never closed are problems. */
private doc_programs(page: string, text: string) -> DocPrograms
    var programs: Buf[DocProgram] = buf()
    var problems = ""
    var marker = ""
    var kind = ""
    var body = ""
    var opened = 0
    var waiting = false
    var program = ""
    var program_line = 0
    var n = 0
    for line in text.split("\n")
        n = n + 1
        if marker == ""
            marker = fence_marker(line)
            if marker != ""
                kind = fence_kind(line[marker.bytes.len..])
                body = ""
                opened = n
        elif closes_fence(line, marker)
            if kind == "output"
                if waiting then programs.push(DocProgram(program_line, program, body))
                else problems = problems + s"$page:$opened: this `output` fence follows no `run` fence\n"
                waiting = false
            else
                if waiting then problems = problems + s"$page:$program_line: this `run` fence has no `output` fence after it\n"
                waiting = kind == "run"
                program = body
                program_line = opened
            marker = ""
        else body = body + line + "\n"
    if marker != "" && kind != "" then problems = problems + s"$page:$opened: this `$kind` fence is never closed\n"
    elif waiting then problems = problems + s"$page:$program_line: this `run` fence has no `output` fence after it\n"
    DocPrograms(programs, problems)

/** Every Markdown page under `dir`, at any depth. */
private markdown_pages(dir: string) -> Buf[string]
    var out: Buf[string] = buf()
    for name in entries(dir).unwrap_or(buf())
        if name.starts_with(".") then continue
        val inner = dir + "/" + name
        if is_dir(inner)
            for page in markdown_pages(inner) do out.push(page)
        elif name.ends_with(".md") then out.push(inner)
    out

/** Builds and runs every program `text`, the page `page`, marks, at -O0 and -O2, as an example is
 * run; the tally counts each program, and a page whose marks are wrong as one failure. */
private run_doc_page(tc: Toolchain, page: string, text: string, scratch: string) -> Tally
    val found = doc_programs(page, text)
    var t = tally()
    if found.problems != "" then t = record(t, found.problems)
    for p in found.programs
        val file = s"$scratch/shown_${p.line}.avin"
        write_text(file, p.program).unwrap()
        write_text(s"$scratch/shown_${p.line}.out", p.output).unwrap()
        val program = case_at(file)
        val failure = run_case(tc, file, program, expectation(program.text), scratch)
        val described = if failure == "" then "" else s"$page:${p.line}: the program shown fails:\n$failure"
        t = record(t, described)
    t

private add_tally(a: Tally, b: Tally) -> Tally
    var ignored = a.ignored
    for line in b.ignored do ignored.push(line)
    Tally(a.failures + b.failures, a.passed + b.passed, a.failed + b.failed, ignored)

@test("every program a documentation page marks `run` builds, exits and prints its `output` fence at -O0 and -O2")
docs_programs_run()
    val tc = repository_toolchain()
    val scratch = make_temp_dir("avin-docs").unwrap()
    defer _ = remove_dir_all(scratch)
    val pages = markdown_pages(tc.root + "/docs/content")
    assert(pages.len() > 0)
    var t = tally()
    for page in pages
        t = add_tally(t, run_doc_page(tc, page, read_text(page).unwrap(), scratch))
    assert(doc_programs("_index.md", read_text(tc.root + "/docs/content/_index.md").unwrap()).programs.len() > 0)
    finish("docs", t)

@test("a `run` fence pairs with the `output` fence after it, prose between them, and only the words after the language mark a fence")
doc_programs_pair()
    val page = "intro\n\n```text run\nmain()\n    println(1)\n```\n\nIt prints:\n\n```text output\n1\n```\n\n```text\nshown only\n```\n\n~~~text run\nmain() = ()\n~~~\n~~~ text output\n~~~\n\n```run\nlanguage only\n```\n"
    val found = doc_programs("p.md", page)
    assert_eq(found.problems, "")
    assert_eq(found.programs.len(), 2)
    assert_eq(found.programs[0].line, 3)
    assert_eq(found.programs[0].program, "main()\n    println(1)\n")
    assert_eq(found.programs[0].output, "1\n")
    assert_eq(found.programs[1].line, 18)
    assert_eq(found.programs[1].program, "main() = ()\n")
    assert_eq(found.programs[1].output, "")

@test("a marked fence inside a longer fence is only shown, and closes at nothing shorter than its opener")
doc_programs_nested()
    val page = "````text\n```text run\nmain() = ()\n```\n````\n\n````text run\nmain() = ()\n```\n````\n```text output\n```\n"
    val found = doc_programs("p.md", page)
    assert_eq(found.problems, "")
    assert_eq(found.programs.len(), 1)
    assert_eq(found.programs[0].line, 7)
    assert_eq(found.programs[0].program, "main() = ()\n```\n")

@test("a `run` fence with no `output` fence after it, or another fence first, an `output` fence with no `run` fence and an unclosed marked fence are each refused")
doc_programs_refused()
    assert_eq(doc_programs("p.md", "```text run\nmain() = ()\n```\n").problems, "p.md:1: this `run` fence has no `output` fence after it\n")
    assert_eq(doc_programs("p.md", "```text run\nmain() = ()\n```\n```text\nshown\n```\n```text output\n```\n").problems, "p.md:1: this `run` fence has no `output` fence after it\np.md:7: this `output` fence follows no `run` fence\n")
    assert_eq(doc_programs("p.md", "```text run\na\n```\n```text run\nb\n```\n```text output\n```\n").problems, "p.md:1: this `run` fence has no `output` fence after it\n")
    assert_eq(doc_programs("p.md", "```text output\n1\n```\n").problems, "p.md:1: this `output` fence follows no `run` fence\n")
    assert_eq(doc_programs("p.md", "```text run\nmain() = ()\n```\n```text output\n").problems, "p.md:4: this `output` fence is never closed\n")
    assert_eq(doc_programs("p.md", "```text\nshown, never closed\n").problems, "")

@test("a page's `run` fence whose program does not compile, prints other output or ends otherwise fails the docs check, naming the page and line")
docs_program_failures()
    val tc = repository_toolchain()
    val scratch = make_temp_dir("avin-docs-fail").unwrap()
    defer _ = remove_dir_all(scratch)
    val good = run_doc_page(tc, "good.md", "```text run\nmain()\n    println(\"two\")\n```\n```text output\ntwo\n```\n", scratch)
    assert_eq(good.failures, "")
    assert_eq(good.passed, 1)
    val broken = run_doc_page(tc, "broken.md", "Shown:\n\n```text run\nmain()\n    println(undefinedName)\n```\n```text output\n```\n", scratch)
    assert_eq(broken.failed, 1)
    assert(broken.failures.starts_with("broken.md:3: the program shown fails:\n"))
    assert(broken.failures.contains("did not compile"))
    val wrong = run_doc_page(tc, "wrong.md", "```text run\nmain()\n    println(\"three\")\n```\n```text output\nfour\n```\n", scratch)
    assert_eq(wrong.failed, 1)
    assert(wrong.failures.contains("-O0: standard output was:\nthree\n"))
    assert(wrong.failures.contains("-O2: standard output was:\nthree\n"))
    val trapped = run_doc_page(tc, "trapped.md", "```text run\nmain()\n    val v = [1]\n    println(v(5))\n```\n```text output\n```\n", scratch)
    assert_eq(trapped.failed, 1)
    assert(trapped.failures.contains("ended"))
    val unpaired = run_doc_page(tc, "unpaired.md", "```text run\nmain() = ()\n```\n", scratch)
    assert_eq(unpaired.failed, 1)
    assert_eq(unpaired.passed, 0)

@test("every example package under examples builds and links at -O0 and -O2; none is run, since each opens a window")
example_packages_build()
    val tc = repository_toolchain()
    val scratch = make_temp_dir("avin-examples").unwrap()
    defer _ = remove_dir_all(scratch)
    val all = program_cases(tc, "examples")
    assert(all.len() > 0)
    var failures = ""
    for path in all
        val compiled = compile_case(tc, case_at(path), scratch)
        if compiled.diagnostics != ""
            failures = failures + path + ": did not compile:\n" + compiled.diagnostics
            continue
        for level in ["-O0", "-O2"]
            link(tc, compiled.llvm.unwrap_or(""), compiled.archive, scratch + "/example" + level, level, compiled.c_link, keep_units = false) match
                Err(message) -> failures = failures + s"$path $level: did not link: $message\n"
                Ok(_) -> ()
    if failures != "" then panic(failures)

