// The core library's own tests are a program of `@test` functions in `library/tests`, which `avin test`
// runs as it runs any program's.
@test("the core library's own tests in library/tests pass at -O0 and -O2")
library_tests_pass()
    val tc = repository_toolchain()
    val dir = make_temp_dir("avin-library-tests").unwrap()
    defer _ = remove_dir_all(dir)
    var failures = ""
    for level in ["-O0", "-O2"]
        var said = ""
        var noted = ""
        val status = run_cli_in(".", ["avin", "test", tc.library_dir() + "/tests", level], Some(tc), s -> said = said + s + "\n", s -> noted = noted + s + "\n", Stdio.ToPath(dir + "/out"), Stdio.ToPath(dir + "/err"))
        if status != 0 || !said.contains(" passed, 0 failed") then failures = failures + s"library/tests at $level exited ${status.to_string()}:\n$noted$said\n"
    if failures != "" then panic(failures)

