module dev.avinlang.compiler
@tests

import sh.sysl.parsing.source_of

// `for` loops as lowering makes them. A range written in place is a counted loop and an array an
// indexed one: neither makes an object or calls anything per element. Any other `Iterable` goes
// through its iterator's methods.

/** The calls and allocations the function `name` of `text` makes, as `calls/allocations`. */
private loop_cost(text: string, name: string) -> string
    val program = lower_source(repository_toolchain(), source_of("probe.avin", text)) match
        Ok(p) -> p
        Err(d) -> panic(d)
    var calls = 0
    var allocations = 0
    for f in program.functions
        if f.symbol != "<program>." + name then continue
        for b in f.blocks
            for inst in b.insts
                if inst is Call(_, _, _) then calls = calls + 1
                if inst is Alloc(_, _) then allocations = allocations + 1
    s"$calls/$allocations"

@test("a `for` over a range written in place counts without allocating or calling")
range_loop_is_counted()
    val text = "sum(n: int) -> long\n    var total: long = 0\n    for i in 0..<n do total += long(i)\n    for i in 1..n do total += long(i)\n    total\n\nmain()\n    sum(1000000)\n"
    assert_eq(loop_cost(text, "sum"), "0/0")

@test("a `for` over an array indexes it without allocating or calling")
array_loop_is_indexed()
    val text = "sum(xs: Array[int]) -> int\n    var total = 0\n    for x in xs do total += x\n    total\n\nmain()\n    sum(Array.fill(3, 1))\n"
    assert_eq(loop_cost(text, "sum"), "0/0")

@test("a `for` over another Iterable calls its iterator's methods")
iterable_loop_calls_the_iterator()
    val text = "sum(xs: Iterable[int]) -> int\n    var total = 0\n    for x in xs do total += x\n    total\n\nmain()\n    sum(Array.fill(3, 1))\n"
    assert_eq(loop_cost(text, "sum"), "3/0")
