module dev.avinlang.compiler
@tests

import sh.sysl.parsing.source_of

// `for` loops as lowering makes them. A range written in place is a counted loop and an array an
// indexed one: neither makes an object or calls anything per element. Any other `Iterable` goes
// through its iterator's methods.

/** Whether `inst` is the call that marks a moved array's slow path cold: a call to a runtime
 * function that does nothing, made only on the path an array never moved does not take. */
private is_cold_mark(inst: Inst) -> bool = inst match
    Call(_, Runtime(symbol, _), _) -> symbol == "avin_rt_array_slow"
    _ -> false

/** The calls and allocations the function `name` of `text` makes, as `calls/allocations`. The
 * cold mark of a moved array's slow path is not counted: it is never reached for an array the
 * code running owns, and it does nothing where it is; `cold_marks` counts it. */
private loop_cost(text: string, name: string) -> string
    val program = lower_source(repository_toolchain(), source_of("probe.avin", text)) match
        Ok(p) -> p
        Err(d) -> panic(d)
    var calls = 0
    var allocations = 0
    for f in program.functions
        if f.symbol != "<program>." + name then continue
        for b in f.blocks
            for inst in b.insts
                if inst is Call(_, _, _) && !is_cold_mark(inst) then calls = calls + 1
                if inst is Alloc(_, _) then allocations = allocations + 1
    s"$calls/$allocations"

/** How many blocks of the function `name` of `text` hold the cold mark, and whether each such block
 * holds nothing else that calls. */
private cold_marks(text: string, name: string) -> string
    val program = lower_source(repository_toolchain(), source_of("probe.avin", text)) match
        Ok(p) -> p
        Err(d) -> panic(d)
    var marked = 0
    var other_calls = 0
    for f in program.functions
        if f.symbol != "<program>." + name then continue
        for b in f.blocks
            var has_mark = false
            var calls = 0
            for inst in b.insts
                if is_cold_mark(inst) then has_mark = true
                if inst is Call(_, _, _) && !is_cold_mark(inst) then calls = calls + 1
            if has_mark
                marked = marked + 1
                other_calls = other_calls + calls
    s"$marked/$other_calls"

@test("a `for` over a range written in place counts without allocating or calling")
range_loop_is_counted()
    val text = "sum(n: int) -> long\n    var total: long = 0\n    for i in 0..<n do total += long(i)\n    for i in 1..n do total += long(i)\n    total\n\nmain()\n    sum(1000000)\n"
    assert_eq(loop_cost(text, "sum"), "0/0")

@test("a `for` over an array indexes it without allocating or calling")
array_loop_is_indexed()
    val text = "sum(xs: Array[int]) -> int\n    var total = 0\n    for x in xs do total += x\n    total\n\nmain()\n    sum(Array.fill(3, 1))\n"
    assert_eq(loop_cost(text, "sum"), "0/0")

@test("a `for` over an array keeps a moved array's owner check on cold paths that call nothing else")
array_loop_slow_paths_are_cold()
    val text = "sum(xs: Array[int]) -> int\n    var total = 0\n    for x in xs do total += x\n    total\n\nmain()\n    sum(Array.fill(3, 1))\n"
    // One cold path decodes a moved array's length before the loop, one checks an element's index.
    assert_eq(cold_marks(text, "sum"), "2/0")

@test("indexing an array by hand calls nothing but the cold mark of its moved-array path")
array_index_is_call_free()
    val text = "sum(xs: Array[int]) -> int\n    var total = 0\n    var i = 0\n    while i < xs.length\n        total += xs(i)\n        i += 1\n    total\n\nmain()\n    sum(Array.fill(3, 1))\n"
    assert_eq(loop_cost(text, "sum"), "0/0")

/** The functions of the program the function `name` of `text` calls directly, each once. */
private direct_callees(text: string, name: string) -> string
    val program = lower_source(repository_toolchain(), source_of("probe.avin", text)) match
        Ok(p) -> p
        Err(d) -> panic(d)
    var out = ""
    for f in program.functions
        if f.symbol != "<program>." + name then continue
        for b in f.blocks
            for inst in b.insts
                if inst is Call(_, Direct(g), _)
                    val callee = program.functions[g].symbol
                    if !out.contains(callee + ";") then out = out + callee + ";"
    out

@test("a `for` over another Iterable calls its iterator's methods")
iterable_loop_calls_the_iterator()
    val text = "sum(xs: Iterable[int]) -> int\n    var total = 0\n    for x in xs do total += x\n    total\n\nmain()\n    sum(Array.fill(3, 1))\n"
    assert(loop_cost(text, "sum").ends_with("/0"))
    // The only iterator of `int`s the program makes is an array's, so its methods are called
    // directly.
    val callees = direct_callees(text, "sum")
    assert(callees.contains("avin.ArrayIterator.hasNext[int];"), callees)
    assert(callees.contains("avin.ArrayIterator.next[int];"), callees)
