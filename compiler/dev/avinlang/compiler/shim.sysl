module dev.avinlang.compiler

import sh.sysl.parsing.{Span, error, report}
import sysl.buf.{Buf, buf}
import sysl.crypto.sha256
import sysl.fs.{canonicalize, exists, make_dir_all, make_temp_dir, pending_name, publish_file, read_text, remove_dir_all, remove_file, walk, write_text}
import sysl.process.capture
import sysl.slices.sort
import sysl.text.{StrBuilder, str_builder}

// Sysl bindings. Each binding's body calls a shim: a Sysl function, generated here, exported with the
// C convention under the symbol the binding's body names. The shim converts each argument from its
// Avin representation, calls the Sysl function the binding names, and converts the result back. Sysl
// checks every shim against the real declaration, so a binding with a wrong type fails the build with
// Sysl's diagnostic, reported at the binding.
//
// The shims are one Sysl package that depends on the runtime's, built by `sysl build-c` into one
// archive that holds the runtime, the shims and the part of Sysl's library they reach. A program with
// bindings links that archive in place of the runtime's own, so its Sysl code shares one copy of
// Sysl's library: one standard output, one allocator.

/** The generated shim package's source, and where each binding's part of it is: the line of its
 * import and the lines of its function, counted from one. A mirror's import and conversions are its
 * own part. */
struct ShimSource
    text: string
    imports: Buf[usize]
    first: Buf[usize]
    last: Buf[usize]
    mirrors: Buf[Mirrored]
    mirror_lines: Buf[MirrorLines]
    /** For each conversion out of Sysl, by its position, what Sysl's diagnostic of a call to it that
     * no overload takes says instead: the Avin type it makes, and the Sysl types it makes it from. */
    unconverted: Buf[string]
    /** Lines of the helpers that pass a handle to Sysl as a parameter, by the handle's position. */
    passing: Buf[MirrorLines]

/** A data type's `@sysl` mirror of the Sysl enum or struct `target`, declared at `span`; or, where
 * `finalizer` names the shim's finalizer for it, a class's `@sysl` handle on the Sysl type
 * `target`, at the type `arguments` where it is an instance of a generic handle class. */
struct Mirrored
    name: string
    target: string
    unit: usize
    span: Span
    finalizer: string
    arguments: Buf[&Crossing]

/** Lines of a shim that a mirror answers for, by its position: its import, or one conversion. */
struct MirrorLines
    mirror: usize
    first: usize
    last: usize

/** The manifest of the shim package, depending on the runtime package at `runtime_dir` and on each of
 * the Sysl packages `sysl` the program's manifests name. */
shim_manifest(runtime_dir: string, sysl: Buf[SyslPackage]) -> string
    var out = str_builder()
    out.push("package { name = \"avin-shims\", version = \"0.1.0\", sysl = \"0.9.10\" }\n")
    out.push("dependencies {\n  avin-runtime { path = " + hocon_text(runtime_dir) + " }\n")
    for p in sysl
        val entry = p.origin match
            Git(c, v) -> "git = " + hocon_text(c) + ", version = " + hocon_text(v)
            Rev(c, r) -> "git = " + hocon_text(c) + ", rev = " + hocon_text(r)
            Local(d) -> "path = " + hocon_text(d)
            Member -> ""
        out.push("  " + p.label + " { " + entry + " }\n")
    out.push("}\nrequires { heap = true, posix = true }\n")
    out.finish()

// A HOCON string holding `text`.
private hocon_text(text: string) -> string = "\"" + text.replace_all("\\", "\\\\").replace_all("\"", "\\\"") + "\""

/** What a build that links the shims depends on in the Sysl packages `sysl` beyond their manifest
 * entries: the sources of each one in a directory, which change with no new version. A fetched
 * package is named by its version or commit, which the manifest holds. */
sysl_fingerprint(sysl: Buf[SyslPackage]) -> string
    var out = str_builder()
    for p in sysl
        if p.origin is Local(d)
            out.push(p.label + "\n" + tree_fingerprint(d))
    out.finish()

// The shim source as it is written, the line the next text starts on, and the conversions of data
// types it holds: one function for each type in each direction, named by its position here, with
// the mirrors those types include.
private struct ShimWriter
    out: StrBuilder
    line: usize
    ins: Buf[&Crossing]
    outs: Buf[&Crossing]
    mirrors: Buf[Mirrored]
    mirror_lines: Buf[MirrorLines]
    passing: Buf[MirrorLines]
    // The callbacks, `call_<i>_<k>`, whose integer answer is the Avin type itself, and the integer
    // parameters, `param_<i>_<k>`, passed as the Avin type itself: a closure answering, or a
    // parameter of, a type parameter of a generic Sysl function, which says no integer to convert
    // into.
    fixed: Buf[string]

// Whether `name` is one of the callbacks or parameters `w` leaves unconverted.
private is_fixed(w: *ShimWriter, name: string) -> bool
    for f in w.fixed
        if f == name then return true
    false

private put(w: *ShimWriter, text: string)
    w.out.push(text)
    for b in text.bytes
        if b == u8('\n') then w.line += 1

/** The shim module for a program's bindings and the Sysl handles whose objects it lays out. */
shim_source(bindings: Buf[MirBinding], handles: Buf[MirHandle]) -> ShimSource = shim_source_fixing(bindings, handles, buf())

/** The shim module, with the integer answers of the callbacks `fixed` names, `call_<i>_<k>`, made the
 * Avin type itself rather than converted into the type the closure Sysl takes answers, and the
 * integer parameters it names, `param_<i>_<k>`, passed as the Avin type itself rather than converted
 * into the Sysl parameter's type. */
shim_source_fixing(bindings: Buf[MirBinding], handles: Buf[MirHandle], fixed: Buf[string]) -> ShimSource
    var w = ShimWriter(str_builder(), 1, buf(), buf(), buf(), buf(), buf(), fixed)
    var imports: Buf[usize] = buf()
    var first: Buf[usize] = buf()
    var last: Buf[usize] = buf()
    // A handle is imported as a mirror is, and its part of the shim is its own.
    for h in handles
        w.mirrors.push(Mirrored(h.name, h.target, h.unit, h.span, h.finalizer, h.arguments))
    for b in bindings
        for p in b.params
            gather(&w, p, false)
        gather(&w, b.result, true)
    // A mirror a generic handle's instance is spelled with is imported as every mirror is.
    for h in handles
        for a in h.arguments
            import_mirrors(&w, a)
    var calls_back = false
    for b in bindings
        for p in b.params
            if p.form is Callback(_, _, _, _, _) then calls_back = true
    val converts = w.ins.len() + w.outs.len() > 0 || uses_bytes(bindings) || calls_back
    // A handle a mirror's field holds into Sysl is checked by a helper of its own.
    var held: Buf[bool] = buf()
    for _ in 0..<w.mirrors.len()
        held.push(false)
    var holds = false
    for c in w.ins
        for v in c.variants
            for f in v.fields
                if f.crossing.form is Handle(_)
                    held[handle_index(&w, f.crossing)] = true
                    holds = true
    // A handle a callback answers goes into Sysl as a mirror's field does, checked the same way, and
    // so does each handle of a collection a binding passes, whose shares are then made the slice the
    // Sysl parameter asks for.
    var listed: Buf[bool] = buf()
    for _ in 0..<w.mirrors.len()
        listed.push(false)
    for b in bindings
        for p in b.params
            if p.form is Callback(_, result, _, _, _)
                if result.form is Handle(_)
                    held[handle_index(&w, result)] = true
                    holds = true
            if handle_elements(p) is Some(e)
                held[handle_index(&w, e)] = true
                listed[handle_index(&w, e)] = true
                holds = true
    put(&w, "module avin.shims\n\nimport avin.rt.{Context, stop_in_binding, text_bytes, text_length, text_of}\nimport sysl.math.Float\nimport sysl.raw.str_cast\n")
    if holds then put(&w, "import avin.rt.handle_claim\n")
    if converts then put(&w, "import avin.rt.{Frame, allocate, array_elements, array_length, descriptor_of, new_array}\nimport sysl.raw.ptr_cast\nimport sysl.slices.copy\n")
    elif handles.len() > 0 then put(&w, "import sysl.raw.ptr_cast\n")
    var blocks = false
    // A handle's method that blocks and answers bytes copies them into a buffer of the shim's own.
    var owns_bytes = false
    for b in bindings
        if b.blocking then blocks = true
        if b.blocking && !(b.reach is TopLevel) && b.result.form is Bytes then owns_bytes = true
    if blocks then put(&w, "import avin.rt.{enter_safe, leave_safe}\n")
    if calls_back then put(&w, "import avin.rt.{Callback, callback_enter, callback_layouts, callback_leave, callback_pin, callback_pin_threaded}\n")
    var collects = false
    for c in w.ins
        if c.form is Elements(_, _) then collects = true
    for l in listed
        if l then collects = true
    for c in w.outs
        if c.form is Elements(_, _) then collects = true
    if collects || owns_bytes then put(&w, "import sysl.buf.{Buf, buf}\n")
    for i in 0..<bindings.len()
        // A handle's method is reached through the handle's import.
        if !(bindings[i].reach is TopLevel)
            imports.push(0)
            continue
        imports.push(w.line)
        put(&w, s"import ${bindings[i].target} as bound_$i\n")
    for m in 0..<w.mirrors.len()
        w.mirror_lines.push(MirrorLines(m, w.line, w.line))
        // An instance of a generic Sysl type imports the type, and is spelled with its arguments.
        val (path, arguments) = instance_parts(w.mirrors[m].target)
        if arguments.len() == 0 && w.mirrors[m].arguments.len() == 0 then put(&w, s"import ${w.mirrors[m].target} as mirror_$m\n")
        else put(&w, s"import $path as instance_$m\n")
    put(&w, "\n// An Avin string's bytes, copied into a Sysl string.\nprivate text_in(p: *u8) -> string = str_cast(text_bytes(p)[0..<text_length(p)])\n")
    put(&w, IntegerHelper)
    put(&w, RealHelper)
    // A call that waits converts its integer parameters with the thread safe for the collector, and
    // one that does not fit makes the thread running again before the program stops.
    if blocks then put(&w, IntegerWaiting)
    // A handle whose Sysl reference is a trait object keeps it in a cell of its own.
    if handles.len() > 0 then put(&w, "\nextern \"calloc\" shim_calloc(n: usize, size: usize) -> *u8\nextern \"free\" shim_free(p: *u8)\n")
    if converts then put(&w, ConversionHelpers)
    // A handle passed to Sysl as a parameter, other than a method's receiver, is read by helpers of
    // its own.
    var passed: Buf[bool] = buf()
    for _ in 0..<w.mirrors.len()
        passed.push(false)
    for b in bindings
        for k in 0..<b.params.len()
            if b.params[k].form is Handle(_) && (k > 0 || b.reach is TopLevel) then passed[handle_index(&w, b.params[k])] = true
            if b.params[k].form is Callback(_, result, _, _, _)
                if result.form is Handle(_) then passed[handle_index(&w, result)] = true
    for m in 0..<w.mirrors.len()
        if w.mirrors[m].finalizer != "" then handle_lines(&w, m, passed[m] || held[m], held[m], listed[m])
    if calls_back then callback_declarations(&w, bindings)
    for i in 0..<bindings.len()
        val b = bindings[i]
        put(&w, "\n")
        first.push(w.line)
        put(&w, s"// ${b.name}\n@export(\"${b.shim}\")\nshim_$i(ctx: *Context")
        var args: Buf[string] = buf()
        var lists: Buf[string] = buf()
        var handles: Buf[PassedHandle] = buf()
        // A handle's method takes the handle first, and reads the Sysl value it holds.
        val receiver = if b.reach is TopLevel then None else Some(handle_index(&w, b.params[0]))
        for k in 0..<b.params.len()
            val p = b.params[k]
            if receiver is Some(_) && k == 0
                put(&w, ", a0: *u8")
                continue
            if *p.ty is Unit
                args.push("()")
                lists.push("")
                continue
            put(&w, s", a$k: ${crossing_c_side(p)}")
            // A collection of handles is converted into the shares of their Sysl values, which are
            // made the slice the Sysl parameter asks for at the call. An integer is converted, with a
            // check, into whatever integer the Sysl parameter is, which Sysl infers at the call.
            if converted_parameter(&w, p, i, k) then lists.push(s"param_${i}_$k")
            else lists.push(handle_elements(p) match
                Some(e) -> (if p.form is Elements(_, true) then "given_all_" else "given_reading_") + s"${handle_index(&w, e)}"
                None -> "")
            if handle_elements(p) is Some(_) then args.push(s"in_${function_of(&w, p, false).unwrap()}(ctx, a$k, ep$k)")
            elif p.form is Callback(_, _, _, _, _) then args.push(callback_lambda(&w, b, i, k))
            elif p.form is Handle(_)
                handles.push(PassedHandle(args.len(), handle_index(&w, p), s"a$k", s"${i}_$k"))
                args.push("")
            // An array the Sysl function may fill is passed as a slice of its own, read back after.
            elif filled(p) then args.push(s"s$k")
            else args.push(into_expr(&w, p, s"a$k", s"ep$k", 0))
        // Each parameter's layouts, then the result's.
        for k in 0..<b.params.len()
            for j in 0..<passed_layouts(b.params[k])
                put(&w, s", e${k}_$j: *u8")
        for k in 0..<b.result.layouts
            put(&w, s", d$k: *u8")
        put(&w, ")")
        if !(*b.result.ty is Unit) then put(&w, " -> " + crossing_c_side(b.result))
        for k in 0..<b.params.len()
            val n = passed_layouts(b.params[k])
            if n == 0 then continue
            put(&w, s"\n    var es$k: [$n]*u8 = [")
            for j in 0..<n
                if j > 0 then put(&w, ", ")
                put(&w, s"e${k}_$j")
            put(&w, s"]\n    val ep$k: **u8 = ptr_cast(&es$k)")
        receiver match
            Some(m) -> put(&w, s"\n    val s = cell_$m(a0)")
            None -> ()
        // Each function passed is rooted for as long as Sysl keeps the closure made of it.
        for k in 0..<b.params.len()
            if b.params[k].form is Callback(_, _, _, _, threaded)
                val n = b.params[k].layouts
                val pin = if threaded then "callback_pin_threaded" else "callback_pin"
                val at = if n == 0 then "null" else s"ep$k"
                put(&w, s"\n    val cb$k = $pin(ctx, a$k, $at, ${n}usize, \"${b.name}\")")
        // Each array the Sysl function may fill is copied into a slice it may write, and kept as a
        // frame of the thread's stack until its elements are copied back: the collector, which never
        // moves an object, may run while the call waits or while the result is converted.
        var fills: Buf[usize] = buf()
        for k in 0..<b.params.len()
            val p = b.params[k]
            if (receiver is Some(_) && k == 0) || !filled(p) then continue
            fills.push(k)
            val made = if p.form is Bytes then s"bytes_in(a$k)" else s"in_${function_of(&w, p, false).unwrap()}(ctx, a$k, ep$k)"
            put(&w, s"\n    val s$k = $made\n    var root$k = Root(Frame(ctx.top, 1usize), a$k)\n    ctx.top = ptr_cast(&root$k)")
        // `close()` gives back the handle's share of its Sysl value, and the handle holds nothing.
        if b.reach is Release
            put(&w, s"\n    give_back_${receiver.unwrap()}(a0)\n")
            last.push(w.line - 1)
            continue
        var callee = b.reach match
            Method(name) -> s"s.r.$name"
            _ -> s"bound_$i"
        // A result that holds a collection may be spelled with a slice or a `Buf`, and one that holds
        // an integer with any Sysl integer, so it takes the Sysl function's own type, and the
        // overloads of its conversion choose by it.
        // A handle passed as a parameter is passed as the Sysl parameter takes it, which only Sysl
        // knows: a trait is always held by a counted reference, which the handle shares; any other
        // type is passed as the generic helper its expected type instantiates gives it, the handle's
        // own counted reference at a `&T`.
        // The call is written once for each choice among the handles' types, under `if const`, and
        // Sysl keeps the one that holds.
        var types: Buf[usize] = buf()
        for h in handles
            var seen = false
            for m in types
                if m == h.mirror then seen = true
            if !seen then types.push(h.mirror)
        for p in b.params
            if p.form is Callback(_, result, _, _, _)
                if result.form is Handle(_)
                    val m = handle_index(&w, result)
                    var seen = false
                    for t in types
                        if t == m then seen = true
                    if !seen then types.push(m)
        put(&w, "\n")
        call_arms(&w, b, callee, args, lists, handles, types, 0, buf(), receiver is Some(_), fills, "    ")
        for k in 0..<b.params.len()
            if b.params[k].form is Callback(_, _, _, _, _) then callback_functions(&w, b, i, k)
            if (receiver is None || k > 0) && converted_parameter(&w, b.params[k], i, k)
                val n = if receiver is Some(_) then k else k + 1
                if *b.params[k].ty is Real
                    put(&w, s"\n// `${b.name}`'s parameter $n, rounded into the floating-point type the Sysl parameter is.\nprivate param_${i}_$k[T: Float](ctx: *Context, x: real) -> T = real_in(x)\n")
                    continue
                val check = if b.blocking then "integer_in_waiting" else "integer_in"
                put(&w, s"\n// `${b.name}`'s parameter $n, converted into the integer the Sysl parameter is.\nprivate param_${i}_$k[T: Integer](ctx: *Context, x: ${sysl_side(b.params[k].ty)}) -> T = $check(ctx, x)\n")
        for h in handles
            site_helpers(&w, h)
        last.push(w.line - 1)
    var k = 0usize
    while k < w.ins.len()
        in_function(&w, k)
        k += 1
    k = 0
    while k < w.outs.len()
        out_function(&w, k)
        k += 1
    var unconverted: Buf[string] = buf()
    for c in w.outs
        var from = ""
        var n: Buf[string] = buf()
        val spelled = spellings(&w, c, true, &n)
        for i in 0..<spelled.len()
            if i > 0 then from = from + (if i + 1 == spelled.len() then " or " else ", ")
            from = from + "`" + spelled[i] + "`"
        // A number is spelled in the shim by its type parameter, and here as any integer `I` or any
        // floating-point type `F`.
        var s = n.len()
        var integers = false
        var floats = false
        while s > 0
            s -= 1
            if n[s] == "Float"
                from = from.replace_all(s"S$s", "F")
                floats = true
            else
                from = from.replace_all(s"S$s", "I")
                integers = true
        if integers then from = from + " of any integer type `I`"
        if floats then from = from + (if integers then " and" else "") + " of any floating-point type `F`"
        // A mirror is spelled in the shim by the name it is imported as, and here by the Sysl type's.
        var m = w.mirrors.len()
        while m > 0
            m -= 1
            from = from.replace_all(s"mirror_$m", w.mirrors[m].target)
        unconverted.push(s"`${type_name(c.ty)}` is made from a Sysl $from, and the value is none of these")
    // A handle on an instance of a generic Sysl type, whose name a trait's instance cannot be given,
    // is spelled as the instance wherever the shim names its type.
    var text = w.out.finish()
    for m in 0..<w.mirrors.len()
        val (_, arguments) = instance_parts(w.mirrors[m].target)
        var spelled: Buf[string] = buf()
        for a in arguments
            spelled.push(sysl_instance_argument(a.trim()))
        for a in w.mirrors[m].arguments
            spelled.push(sysl_type(&w, a))
        if spelled.len() == 0 then continue
        text = replace_word(text, s"mirror_$m", s"instance_$m[${comma_list(spelled)}]")
    ShimSource(text, imports, first, last, w.mirrors, w.mirror_lines, unconverted, w.passing)

// `text` with each `word` that is a whole word, not the start of a longer one, replaced by `by`.
private replace_word(text: string, word: string, by: string) -> string
    var out = str_builder()
    val pieces = text.split(word)
    for i in 0..<pieces.len
        if i == 0
            out.push(pieces[i])
            continue
        val next = pieces[i]
        val longer = next.bytes.len > 0 && is_word_byte(next.bytes[0])
        out.push(if longer then word else by)
        out.push(next)
    out.finish()

// The entries through which the shims call the functions they are given, which the program defines,
// and the frames that keep a callback's function and the objects made of its arguments while it runs:
// one of each size used.
private callback_declarations(w: *ShimWriter, bindings: Buf[MirBinding])
    var sizes: Buf[usize] = buf()
    for i in 0..<bindings.len()
        val b = bindings[i]
        for k in 0..<b.params.len()
            if b.params[k].form is Callback(params, result, _, _, _)
                var line = s"\nextern \"${callback_invoker(b.shim, k)}\" invoke_${i}_$k(ctx: *Context, f: *u8"
                for j in 0..<params.len()
                    if *params[j].ty is Unit then continue
                    line = line + s", a$j: ${crossing_c_side(params[j])}"
                line = line + ") -> " + (if *result.ty is Unit then "unit" else crossing_c_side(result)) + "\n"
                put(w, line)
                val n = held_slots(params)
                var seen = false
                for m in sizes
                    if m == n then seen = true
                if !seen then sizes.push(n)
    for n in sizes
        put(w, s"\n// A callback's function and the objects made of its arguments, kept as a frame of the thread's\n// stack while it runs.\nprivate struct Held_$n\n    frame: Frame\n    slots: [$n]*u8\n")

// How many references a callback's frame holds: its function, and each argument that is an object.
private held_slots(params: Buf[&Crossing]) -> usize
    var n = 1usize
    for p in params
        if !(*p.ty is Unit) && crossing_c_side(p) == "*u8" then n += 1
    n

// The parameters and result of the function binding `b` passes as its parameter `k`.
private callback_parts(b: &MirBinding, k: usize) -> (Buf[&Crossing], &Crossing)
    val c = b.params[k]
    if c.form is Callback(ps, r, _, _, _) then return (ps, r)
    panic("a callback's crossing that is not one")

// The Sysl closure binding `b`, the `i`th, hands Sysl for its parameter `k`: it passes what Sysl
// calls it with to the function that runs the callback `cb<k>`. A handle it answers is made the
// value the closure's type asks for, a pointer to the handle's value, the value or a counted
// reference.
private callback_lambda(w: *ShimWriter, b: &MirBinding, i: usize, k: usize) -> string
    val (params, result) = callback_parts(b, k)
    var names = ""
    var call = s"call_${i}_$k(&*cb$k"
    // Sysl infers the types of the closure's parameters from the closure Sysl takes; where that type
    // is a type parameter of the Sysl function it cannot, and each is written as the Avin type's.
    val typed = is_fixed(w, s"lambda_$i")
    for j in 0..<params.len()
        if j > 0 then names = names + ", "
        names = names + s"q$j"
        if typed then names = names + ": " + (if params[j].form is Handle(_) then "&" + sysl_type(w, params[j]) else sysl_types(w, params[j])[0])
        call = call + s", q$j"
    call = call + ")"
    // A handle is answered as the closure's type asks: a pointer to the value, the value or a counted
    // reference, and a trait only by the counted reference, which the call written for that choice
    // takes as it is.
    if result.form is Handle(_) then call = s"given_${handle_index(w, result)}($call)"
    s"($names) -> $call"

// The Sysl type the answer of a callback with result `r` is converted to.
private callback_answer(w: *ShimWriter, r: &Crossing) -> string
    if r.form is Plain then return sysl_side(r.ty)
    if r.form is Handle(_) then return s"&mirror_${handle_index(w, r)}"
    sysl_type(w, r)

// The functions that run the callback binding `b`, the `i`th, is given for its parameter `k`, generic
// in the Sysl types of its arguments: `call` begins the call on the calling thread and ends it,
// and `run`, with the thread's context, converts each argument out of Sysl, keeping each object it
// makes and the function itself as a frame of the thread's stack, runs the function through the
// program's entry for it, and converts what it answers into Sysl. A handle answered gives its share
// of its Sysl value, taken while the thread is still running.
private callback_functions(w: *ShimWriter, b: &MirBinding, i: usize, k: usize)
    val (params, result) = callback_parts(b, k)
    var types = ""
    var declared = ""
    var passed = ""
    // An integer is any Sysl integer and a real any Sysl floating-point type, and a collection, an
    // option, a result, a tuple or a value a handle is made of is spelled as Sysl spells it; any other
    // scalar has its one Sysl type.
    for j in 0..<params.len()
        val p = params[j]
        passed = passed + s", q$j"
        if p.form is Plain && !numeric(p.ty)
            declared = declared + s", q$j: ${sysl_side(p.ty)}"
            continue
        if types != "" then types = types + ", "
        types = types + (if p.form is Plain then s"S$j: ${number_bound(p.ty)}" else s"S$j")
        declared = declared + s", q$j: S$j"
    // An integer answer is converted, with a check, into whatever integer the closure's type answers,
    // which Sysl infers where the closure is passed: a Sysl `u32` takes an Avin `long`. A real answer
    // is rounded into whatever floating-point type it answers, an `f32` as well as a `real`. A closure
    // whose answer is a generic Sysl function's type parameter answers the Avin type itself.
    val integral = result.form is Plain && numeric(result.ty) && !is_fixed(w, s"call_${i}_$k")
    if integral
        if types != "" then types = types + ", "
        types = types + s"R: ${number_bound(result.ty)}"
    val generic = if types == "" then "" else s"[$types]"
    val unit = *result.ty is Unit
    val answer = if unit then "" elif integral then " -> R" else " -> " + callback_answer(w, result)
    put(w, s"\n// What Sysl calls the function given for `${b.name}`'s parameter ${k + 1} with, run on the calling thread.\nprivate call_${i}_$k$generic(cb: *Callback$declared)$answer\n    val e = callback_enter(cb)\n")
    if unit then put(w, s"    run_${i}_$k(e.ctx, cb$passed)\n    callback_leave(e)\n")
    elif integral then put(w, s"    val r: R = run_${i}_$k(e.ctx, cb$passed)\n    callback_leave(e)\n    r\n")
    else put(w, s"    val r = run_${i}_$k(e.ctx, cb$passed)\n    callback_leave(e)\n    r\n")
    put(w, s"\nprivate run_${i}_$k$generic(ctx: *Context, cb: *Callback$declared)$answer\n")
    if b.params[k].layouts > 0 then put(w, "    val ep: **u8 = callback_layouts(cb)\n")
    val n = held_slots(params)
    put(w, s"    var held = Held_$n(Frame(ctx.top, ${n}usize), [null; $n])\n    ctx.top = ptr_cast(&held)\n    held.slots[0] = cb.object\n")
    var call = s"invoke_${i}_$k(ctx, held.slots[0]"
    var slot = 1usize
    var base = 0usize
    for j in 0..<params.len()
        val p = params[j]
        if !(*p.ty is Unit)
            val made = out_expr(w, p, s"q$j", "ep", base)
            val side = crossing_c_side(p)
            if side == "*u8"
                put(w, s"    held.slots[$slot] = $made\n")
                call = call + s", held.slots[$slot]"
                slot += 1
            else
                put(w, s"    val v$j: $side = $made\n")
                call = call + s", v$j"
        base += p.layouts
    call = call + ")"
    if unit
        put(w, s"    $call\n    ctx.top = held.frame.prev\n")
        return
    put(w, s"    val r = $call\n    ctx.top = held.frame.prev\n")
    if result.form is Handle(_)
        val m = handle_index(w, result)
        put(w, s"    cell_$m(held_$m(ctx, r)).r\n")
    elif integral && *result.ty is Real then put(w, "    real_in(r)\n")
    elif integral then put(w, "    integer_to(ctx, r, integer_name[R]())\n")
    else put(w, "    " + into_expr(w, result, "r", "ep", base) + "\n")

// Sysl's words for a callback's parameter whose type is not the one Sysl calls the closure with,
// `'q0' of 'avin.shims.call_2_0' is string, but int was given`, said of the callback's own parameter;
// any other message as it is.
private callback_parameter_message(message: string) -> string
    if !message.starts_with("'q") || !message.ends_with(" was given") then return message
    val halves = message.split("' of 'avin.shims.call_")
    if halves.len != 2 then return message
    val named = halves[1].split("' is ")
    if named.len != 2 then return message
    val types = named[1].split(", but ")
    if types.len != 2 then return message
    var j = 0usize
    for b in halves[0].bytes[2..]
        if b < u8('0') || b > u8('9') then return message
        j = j * 10 + usize(b - u8('0'))
    val given = types[1].replace_all(" was given", "")
    s"the function's parameter ${j + 1} is ${types[0]}, but Sysl calls it with $given"

// A handle a binding passes as a parameter: the place of its argument in the call, the mirror its type
// is, the shim's parameter that holds it, and the helper of its own that gives it as the Sysl
// parameter's type asks.
private struct PassedHandle
    arg: usize
    mirror: usize
    name: string
    site: string

// The helpers that give the handle `h` to the one place in Sysl it goes: `pass_` reads it from its
// object and `give_` from a reference already taken, each as the type `P` the place asks for, the
// counted reference itself, a pointer to the value or the value. Sysl settles `P` from that place
// and checks the helper's body against it, so the helpers are written beside the binding or the
// mirror they serve, and a handle the place does not take is reported there.
private site_helpers(w: *ShimWriter, h: &PassedHandle)
    val m = h.mirror
    put(w, s"\nprivate pass_${h.site}[P](p: *u8) -> P\n    val s = cell_$m(p)\n    if const P::Kind == Kind.Ref\n        s.r\n    elif const P::Kind == Kind.Pointer\n        &*s.r\n    else\n        *s.r\n")
    put(w, s"\nprivate give_${h.site}[P](r: &mirror_$m) -> P\n    if const P::Kind == Kind.Ref\n        r\n    elif const P::Kind == Kind.Pointer\n        &*r\n    else\n        *r\n")

// Sysl's words for a handle a place in Sysl does not take, `function 'avin.shims.pass_3_1' should
// return &A, but its body yields &B`, said of the handle; any other message as it is.
private site_message(message: string) -> string
    if !message.starts_with("function 'avin.shims.pass_") && !message.starts_with("function 'avin.shims.give_") then return message
    val halves = message.split("' should return ")
    if halves.len != 2 then return message
    val types = halves[1].split(", but its body yields ")
    if types.len != 2 then return message
    s"the handle goes in as a `${types[1]}`, and Sysl takes a `${types[0]}` there"

// The call of binding `b`'s Sysl function `callee` with `args`, and the conversion of its result,
// written once for each choice of the handles' types `types` from `depth` on being a trait or not:
// `traits` holds the ones taken so far to be one. `method` says the callee is a handle's method. A
// non-empty `lists[k]` is the helper that makes the shares a collection of handles was converted
// into the slice its Sysl parameter asks for.
private call_arms(w: *ShimWriter, b: &MirBinding, callee: string, args: Buf[string], lists: Buf[string], handles: Buf[PassedHandle], types: Buf[usize], depth: usize, traits: Buf[usize], method: bool, fills: Buf[usize], indent: string)
    if depth == types.len()
        var given: Buf[string] = buf()
        var wrappers: Buf[string] = buf()
        for k in 0..<args.len()
            var arg = args[k]
            var wrapper = lists[k]
            for h in handles
                if h.arg != k then continue
                // A call that waits takes the handle's reference before it, into a local whose type
                // is known, and the value the parameter asks for is made from that local at the call.
                if has_mirror(traits, h.mirror) then arg = s"cell_${h.mirror}(${h.name}).r"
                elif b.blocking
                    arg = s"cell_${h.mirror}(${h.name}).r"
                    wrapper = s"give_${h.site}"
                else arg = s"pass_${h.site}(${h.name})"
            // A callback answering a handle on a trait answers its counted reference.
            for m in traits
                arg = arg.replace_all(s"-> given_$m(call_", "-> (call_")
            given.push(arg)
            wrappers.push(wrapper)
        call_lines(w, b, callee, given, wrappers, method, fills, indent)
        return
    val m = types[depth]
    var with: Buf[usize] = buf()
    for d in traits
        with.push(d)
    with.push(m)
    put(w, indent + s"if const wide_$m()\n")
    call_arms(w, b, callee, args, lists, handles, types, depth + 1, with, method, fills, indent + "    ")
    put(w, indent + "else\n")
    call_arms(w, b, callee, args, lists, handles, types, depth + 1, traits, method, fills, indent + "    ")

// The call of binding `b`'s Sysl function `callee` with `args`, and the conversion of its result, at
// `indent`. `method` says the callee is a handle's method; `fills` are the parameters whose arrays the
// function may fill, copied back once the result is made. A non-empty `wrappers[k]` is a helper the
// argument `args[k]` is given to at the call.
private call_lines(w: *ShimWriter, b: &MirBinding, callee: string, args: Buf[string], wrappers: Buf[string], method: bool, fills: Buf[usize], indent: string)
    // A result that holds a collection may be spelled with a slice or a `Buf`, and one that holds an
    // integer with any Sysl integer or a real with any floating-point type, so it takes the Sysl
    // function's own type, and the overloads of its conversion choose by it.
    var numbers: Buf[string] = buf()
    val spelled = spellings(w, b.result, true, &numbers)
    val n = numbers.len()
    var target = callee
    var given: Buf[string] = buf()
    // A call that may wait is made with the thread safe for the collector, which may run, and free
    // a handle's object, meanwhile: every argument is converted, and each handle's share of its Sysl
    // value taken, before it, so the call reads no Avin object; and what it answers is converted
    // once the thread is running again.
    if b.blocking
        for k in 0..<args.len()
            if args[k] == "()"
                given.push("()")
                continue
            // A closure is made at the call, where its parameters' types are known; making it
            // reads only Sysl values.
            if b.params[k + (if method then 1 else 0)].form is Callback(_, _, _, _, _)
                given.push(args[k])
                continue
            put(w, indent + s"val x$k = ${args[k]}\n")
            given.push(wrapped(wrappers[k], s"x$k"))
        b.reach match
            Method(name) ->
                // Bytes the method answers may be a view of the handle's value, which no local may
                // hold past the end of the safe region: they are copied, while the thread is still
                // safe, into a buffer bound before the value's share.
                if b.result.form is Bytes then put(w, indent + "var owned: Buf[u8] = buf()\n")
                put(w, indent + "val h = s.r\n")
                target = s"h.$name"
            _ -> ()
        put(w, indent + "enter_safe(ctx)\n")
    else
        for k in 0..<args.len()
            given.push(wrapped(wrappers[k], args[k]))
    var call = target + "("
    for k in 0..<given.len()
        if k > 0 then call = call + ", "
        call = call + given[k]
    call = call + ")"
    // A handle's method may answer a view of the handle's Sysl value, which Sysl lets no local hold
    // across a call that may free the value, as the conversion's allocation may: the conversion
    // takes the answer where the call gives it.
    val direct = method && !(b.result.form is Plain) && !b.blocking
    // An integer result takes any Sysl integer, converted with a check as a mirror's field is, and a
    // real result any Sysl floating-point type, widened exactly.
    val integral = *b.result.ty is Int(_)
    val floating = b.result.form is Plain && *b.result.ty is Real
    if b.blocking
        if floating
            put(w, indent + s"val raw = $call\n" + indent + "leave_safe(ctx)\n" + indent + "val r: real = real_to(raw)\n")
        elif integral
            val side = sysl_side(b.result.ty)
            put(w, indent + s"val raw = $call\n" + indent + "leave_safe(ctx)\n" + indent + s"val r: $side = integer_to(ctx, raw, \"$side\")\n")
        // The bytes are copied before the thread leaves the safe region, touching only Sysl memory.
        elif method && b.result.form is Bytes
            put(w, indent + s"owned.extend($call)\n" + indent + "leave_safe(ctx)\n" + indent + "val r = owned.view()\n")
        elif spelled.len() == 1 && n == 0 then put(w, indent + s"val r: ${spelled[0]} = $call\n" + indent + "leave_safe(ctx)\n")
        else put(w, indent + s"val r = $call\n" + indent + "leave_safe(ctx)\n")
    elif floating then put(w, indent + s"val r: real = real_to($call)\n")
    elif integral
        val side = sysl_side(b.result.ty)
        put(w, indent + s"val r: $side = integer_to(ctx, $call, \"$side\")\n")
    elif !direct
        if spelled.len() == 1 && n == 0 then put(w, indent + s"val r: ${spelled[0]} = $call\n")
        else put(w, indent + s"val r = $call\n")
    val r = if direct then call else "r"
    var value = ""
    if b.result.form is Plain
        if !(*b.result.ty is Unit) then value = out_of_sysl(b.result.ty, r)
    elif b.result.form is Bytes
        value = s"bytes_of(ctx, $r, d0)"
    else
        put(w, indent + s"var ds: [${b.result.layouts}]*u8 = [")
        for k in 0..<b.result.layouts
            if k > 0 then put(w, ", ")
            put(w, s"d$k")
        put(w, "]\n" + indent + "val dp: **u8 = ptr_cast(&ds)\n")
        value = out_expr(w, b.result, r, "dp", 0)
    if fills.len() == 0
        if value != "" then put(w, indent + value + "\n")
    else
        // The result is made while the arrays are still frames, and then what the Sysl function left
        // in each slice is copied back into its array.
        if value != "" then put(w, indent + s"val made: ${crossing_c_side(b.result)} = $value\n")
        for k in fills
            copy_back(w, b.params[k], k, indent)
        put(w, indent + s"ctx.top = root${fills[0]}.frame.prev\n")
        if value != "" then put(w, indent + "made\n")

// The argument `arg` given at the call to the helper `wrapper`, or `arg` itself where there is none.
// An integer parameter's conversion takes the thread's context, to stop the program where the value
// does not fit.
private wrapped(wrapper: string, arg: string) -> string
    if wrapper == "" then return arg
    if wrapper.starts_with("param_") then return s"$wrapper(ctx, $arg)"
    s"$wrapper($arg)"

// Whether binding `i`'s parameter `k`, `p`, is a number converted into the Sysl parameter's type:
// every integer but a byte, into the parameter's integer type, and a real, into its floating-point
// type, unless the Sysl parameter is a type parameter of a generic function, which says no type to
// convert into.
private converted_parameter(w: *ShimWriter, p: &Crossing, i: usize, k: usize) -> bool =
    p.form is Plain && numeric(p.ty) && !is_fixed(w, s"param_${i}_$k")

// The conversions of arrays of bytes, and the frame that keeps an object a conversion has made while
// it makes the objects of the object's fields.
private const ConversionHelpers: string =
    "\n// An Avin array of bytes, copied into a Sysl slice.\n" +
    "private bytes_in(p: *u8) -> []u8\n" +
    "    val n = array_length(p)\n" +
    "    var out: []u8 = [0; n]\n" +
    "    copy(out, array_elements(p)[0..<n])\n" +
    "    out\n" +
    "\n// A copy of an Avin array as a Sysl function may only read it: what it wrote would never reach\n" +
    "// the array.\n" +
    "private read_only[T](s: []T) -> []const T = s\n" +
    "\n// A Sysl slice of bytes, copied into a new Avin array laid out by `d`.\n" +
    "private bytes_of(ctx: *Context, b: []const u8, d: *u8) -> *u8\n" +
    "    val p = new_array(ctx, ptr_cast(d), b.len)\n" +
    "    copy(array_elements(p)[0..<b.len], b)\n" +
    "    p\n" +
    "\n// An object a conversion has made, kept as a frame of the thread's stack, as compiled code keeps\n" +
    "// its references, while the conversion makes the objects of its fields.\n" +
    "private struct Root\n" +
    "    frame: Frame\n" +
    "    object: *u8\n"

// The conversion of an integer crossing the boundary in either direction: a binding's integer result
// and a mirror's integer field take any integer the other side gives, and stop the program, at the
// call of the binding, where the value does not fit. A conversion that loses a value keeps the low
// bits in the build the shims are made by, so the value is checked by converting it back.
private const IntegerHelper: string =
    "\n// `x` converted to the integer type its place asks for, which must hold it; `name` names that\n" +
    "// type where the program stops.\n" +
    "private integer_to[T: Integer, S: Integer](ctx: *Context, x: S, name: string) -> T\n" +
    "    val y = T.wrap(x)\n" +
    "    if S.wrap(y) != x || (y < T.wrap(0)) != (x < S.wrap(0)) then stop_in_binding(ctx, \"value out of range for \" + name)\n" +
    "    y\n" +
    "\n// `x` converted to the integer type the Sysl parameter it is passed to asks for, which must hold\n" +
    "// it; that type is named by its width and sign where the program stops.\n" +
    "private integer_in[T: Integer, S: Integer](ctx: *Context, x: S) -> T\n" +
    "    val y = T.wrap(x)\n" +
    "    if S.wrap(y) != x || (y < T.wrap(0)) != (x < S.wrap(0)) then stop_in_binding(ctx, \"value out of range for \" + integer_name[T]())\n" +
    "    y\n" +
    "\n// The integer type `T` as its width and sign spell it, `u32` or `i8`.\n" +
    "private integer_name[T: Integer]() -> string = (if T.wrap(-1) < T.wrap(0) then \"i\" else \"u\") + s\"${sizeof(T) * 8usize}\"\n"

// The conversion of a real crossing the boundary in either direction: a real goes into whatever
// floating-point type its Sysl place is, rounded to the nearest value that type holds, and comes out
// of any, widened exactly. Neither ever stops the program: a value past the type's largest rounds to
// an infinity, and one below its smallest to a subnormal or a zero of its sign.
private const RealHelper: string =
    "\n// `x` rounded to the floating-point type its place asks for, to the nearest value it holds.\n" +
    "private real_in[T: Float](x: real) -> T = T(x)\n" +
    "\n// `x`, of whatever floating-point type it is, widened exactly into a `real`.\n" +
    "private real_to[S: Float](x: S) -> real = real(x)\n"

// Whether a boundary type is a number converted where it crosses: an integer, into and out of any
// Sysl integer, or a real, into and out of any Sysl floating-point type.
private numeric(t: &Type) -> bool = *t is Int(_) || *t is Real

// The trait bounding the Sysl type a number of type `t` crosses as.
private number_bound(t: &Type) -> string = if *t is Real then "Float" else "Integer"

// The conversion of an integer parameter of a call that waits, made while the thread is safe for the
// collector: a value that does not fit makes the thread running again before stopping the program.
private const IntegerWaiting: string =
    "\n// `x` converted as `integer_in` converts it, by a thread safe for the collector.\n" +
    "private integer_in_waiting[T: Integer, S: Integer](ctx: *Context, x: S) -> T\n" +
    "    val y = T.wrap(x)\n" +
    "    if S.wrap(y) != x || (y < T.wrap(0)) != (x < S.wrap(0))\n" +
    "        leave_safe(ctx)\n" +
    "        stop_in_binding(ctx, \"value out of range for \" + integer_name[T]())\n" +
    "    y\n"

// The type parameters of a conversion generic in the Sysl types of the numbers it holds, each bounded
// as `bounds` says, any Sysl integer or any Sysl floating-point type, or nothing where it holds none.
private number_parameters(bounds: Buf[string]) -> string
    if bounds.len() == 0 then return ""
    var out = "["
    for i in 0..<bounds.len()
        if i > 0 then out = out + ", "
        out = out + s"S$i: ${bounds[i]}"
    out + "]"

// Whether a binding passes or returns an array of bytes, which no data type's conversion holds.
private uses_bytes(bindings: Buf[MirBinding]) -> bool
    for b in bindings
        if b.result.form is Bytes then return true
        for p in b.params
            if p.form is Bytes then return true
            if p.form is Callback(params, result, _, _, _)
                if result.form is Bytes then return true
                for q in params
                    if q.form is Bytes then return true
    false

// Whether a parameter is an array the Sysl function may fill: an array of bytes, integers, reals,
// booleans or characters passed as the binding's own parameter, whose elements are copied back into
// it after the call. An array anywhere else, or of any other elements, goes into Sysl read-only.
private filled(p: &Crossing) -> bool = p.form match
    Bytes -> true
    Elements(element, vector) -> !vector && element.form is Plain && scalar(element.ty)
    _ -> false

// Whether a boundary type is a number, a boolean or a character, which a slice holds by value.
private scalar(t: &Type) -> bool = *t match
    Int(_) -> true
    Real -> true
    Bool -> true
    Char -> true
    _ -> false

// Copies the slice `s<k>` the Sysl function was passed back into the array its frame `root<k>` holds:
// it has the array's length, since a slice never grows.
private copy_back(w: *ShimWriter, p: &Crossing, k: usize, indent: string)
    if p.form is Bytes
        put(w, indent + s"copy(array_elements(root$k.object)[0..<s$k.len], s$k)\n")
        return
    p.form match
        Elements(element, _) ->
            val side = crossing_c_side(element)
            put(w, indent + s"val f$k: *$side = ptr_cast(array_elements(root$k.object))\n")
            put(w, indent + s"for i in 0..<s$k.len do f$k[i] = ${out_of_sysl(element.ty, s"s$k[i]")}\n")
        _ -> ()

// Records the conversions a value of `c`'s type needs, in the direction `out` says, and the mirrors
// they include, each once.
private gather(w: *ShimWriter, c: &Crossing, out: bool)
    // A function Sysl is given takes values out of Sysl and answers one into it.
    if c.form is Callback(params, result, _, _, _)
        for p in params
            gather(w, p, true)
        gather(w, result, false)
        return
    if c.form is Plain || c.form is Bytes then return
    // A handle goes into Sysl by itself, a parameter, a receiver or a mirror's field, which the shim
    // reads through the handle's own helpers rather than a conversion.
    if c.form is Handle(_) && !out then return
    if function_of(w, c, out) is Some(_) then return
    if out then w.outs.push(c) else w.ins.push(c)
    if c.form is Mirror(name, target, unit, span, _)
        if mirror_of(w, c) is None then w.mirrors.push(Mirrored(name, target, unit, span, "", buf()))
    if c.form is Elements(element, _) then gather(w, element, out)
    for v in c.variants
        for f in v.fields
            gather(w, f.crossing, out)

// Every mirror `c`'s type is spelled with, imported where it is not yet.
private import_mirrors(w: *ShimWriter, c: &Crossing)
    if c.form is Mirror(name, target, unit, span, _)
        if mirror_of(w, c) is None then w.mirrors.push(Mirrored(name, target, unit, span, "", buf()))
        return
    for v in c.variants
        for f in v.fields
            import_mirrors(w, f.crossing)

// The position of the conversion of `c`'s type in the direction `out` says.
private function_of(w: *ShimWriter, c: &Crossing, out: bool) -> Option[usize]
    val key = type_key(c.ty)
    if out
        for i in 0..<w.outs.len()
            if type_key(w.outs[i].ty) == key then return Some(i)
    else
        for i in 0..<w.ins.len()
            if type_key(w.ins[i].ty) == key then return Some(i)
    None

// The position of the mirror or the handle `c`'s type is.
private mirror_of(w: *ShimWriter, c: &Crossing) -> Option[usize]
    if c.form is Mirror(name, target, unit, _, _)
        for i in 0..<w.mirrors.len()
            val m = w.mirrors[i]
            if m.finalizer == "" && m.name == name && m.target == target && m.unit == unit then return Some(i)
    if c.form is Handle(finalizer)
        for i in 0..<w.mirrors.len()
            if w.mirrors[i].finalizer == finalizer then return Some(i)
    None

// The position of the handle `c`'s type is.
private handle_index(w: *ShimWriter, c: &Crossing) -> usize = mirror_of(w, c).unwrap()

// What a handle's object is to Sysl: a word naming its Sysl value, which is zero, naming nothing, from
// when the object is made until the value is stored, and again once `close()` has given it back, and
// a word naming its owner. The first word is the counted reference to the value itself, except where
// the reference is a trait object, which takes two words: it is then kept in a cell of its own, which
// the first word points at, so that every handle's object has the same two words. The collector does
// not trace the first word; the finalizer the handle's descriptor names gives the reference back when
// the object is freed still holding it. Giving back a place that holds nothing does nothing. A trait
// is always held by a counted reference, which is what `wide` asks. A handle passed to Sysl as a
// binding's parameter or a mirror's field is read by helpers of that place's own (`site_helpers`);
// where it is `passed` otherwise, as a callback's answer or an element of a collection, a helper
// answers a reference already taken as the type `P` the place asks, the counted reference itself, a
// pointer to the value or the value itself. Where a mirror's field or a collection holding the handle goes into Sysl,
// it is `held`: a third helper checks the handle as compiled code checks one passed as a parameter,
// stopping the program at the call where it belongs to another thread or holds nothing. Where a
// collection of the handles is a binding's parameter, they are `listed`: the shares the collection's
// conversion takes are made the slice the Sysl parameter asks for.
private handle_lines(w: *ShimWriter, m: usize, passed: bool, held: bool, listed: bool)
    val start = w.line + 1
    val name = w.mirrors[m].name
    put(w, s"\n// The handle `$name`'s object.\nprivate struct Slot_$m\n    word: *u8\n    owner: u64\n")
    put(w, s"\n// Where the handle `$name`'s counted reference is kept.\nprivate struct Cell_$m\n    r: &mirror_$m\n")
    put(w, s"\n// Whether a reference to the handle's Sysl type takes two words, a trait object's.\nprivate const wide_$m() -> bool = sizeof(&mirror_$m) > sizeof(*u8)\n")
    put(w, s"\nprivate cell_$m(p: *u8) -> *Cell_$m\n    if const wide_$m()\n        val s: *Slot_$m = ptr_cast(p)\n        ptr_cast(s.word)\n    else\n        ptr_cast(p)\n")
    put(w, s"\nprivate hold_$m[V](ctx: *Context, o: *u8, v: V)\n    val s: *Slot_$m = ptr_cast(o)\n    if const wide_$m()\n        s.word = shim_calloc(1usize, sizeof(Cell_$m))\n        if s.word == null then stop_in_binding(ctx, \"out of memory\")\n    cell_$m(o).r = v\n    s.owner = ctx.owner\n")
    put(w, s"\nprivate give_back_$m(p: *u8)\n    if const wide_$m()\n        val s: *Slot_$m = ptr_cast(p)\n        if s.word == null then return\n        release(cell_$m(p).r)\n        shim_free(s.word)\n        s.word = null\n    else\n        release(cell_$m(p).r)\n")
    put(w, s"\n@export(\"${w.mirrors[m].finalizer}\")\nfinalize_$m(p: *u8, heap: *u8) = give_back_$m(p)\n")
    w.mirror_lines.push(MirrorLines(m, start, w.line - 1))
    if !passed then return
    val helpers = w.line + 1
    put(w, s"\nprivate given_$m[P](r: &mirror_$m) -> P\n    if const P::Kind == Kind.Ref\n        r\n    elif const P::Kind == Kind.Pointer\n        &*r\n    else\n        *r\n")
    if held
        put(w, s"\nprivate held_$m(ctx: *Context, p: *u8) -> *u8\n    val s: *Slot_$m = ptr_cast(p)\n    if s.owner != ctx.owner && !handle_claim(ctx, p) then stop_in_binding(ctx, \"`$name` belongs to another thread\")\n    if s.word == null then stop_in_binding(ctx, \"`$name` is closed\")\n    p\n")
    if listed
        put(w, s"\nprivate given_all_$m[E](s: []&mirror_$m) -> []E\n    if const E::Kind == Kind.Ref\n        s\n    else\n        var b: Buf[E] = buf()\n        for r in s do b.push(given_$m(r))\n        b.view()\n")
        put(w, s"\nprivate given_reading_$m[E](s: []&mirror_$m) -> []const E = given_all_$m[E](s)\n")
    w.passing.push(MirrorLines(m, helpers, w.line - 1))

// The Sysl type a value of `c`'s type is converted to. A collection goes into Sysl as a slice, and an
// array as one the Sysl function may only read, since what it wrote would never reach the array; only
// a binding's own parameter that `filled` accepts is passed a slice it may write.
private sysl_type(w: *ShimWriter, c: &Crossing) -> string = c.form match
    Plain -> sysl_side(c.ty)
    Bytes -> "[]const u8"
    OptionForm(_) -> s"Option[${sysl_type(w, payload(c, "Some"))}]"
    ResultForm -> s"Result[${sysl_type(w, payload(c, "Ok"))}, ${sysl_type(w, payload(c, "Err"))}]"
    Mirror(_, _, _, _, _) -> s"mirror_${mirror_of(w, c).unwrap()}"
    Elements(element, vector) -> (if vector then "[]" else "[]const ") + sysl_type(w, element)
    Handle(_) -> s"mirror_${handle_index(w, c)}"
    // A function goes into Sysl as a closure made where it is passed, whose type Sysl infers.
    Callback(_, _, _, _, _) -> "unit"
    TupleForm ->
        var parts: Buf[string] = buf()
        for f in c.variants[0].fields
            parts.push(sysl_type(w, f.crossing))
        "(" + comma_list(parts) + ")"

// `parts` separated by commas.
private comma_list(parts: Buf[string]) -> string
    var out = ""
    for i in 0..<parts.len()
        if i > 0 then out = out + ", "
        out = out + parts[i]
    out

// Every Sysl type a value of `c`'s type is converted from. A collection comes out of Sysl as a slice
// or a `Buf`, so a conversion that holds one is one overload for each way of spelling its type.
private sysl_types(w: *ShimWriter, c: &Crossing) -> Buf[string]
    var n: Buf[string] = buf()
    spellings(w, c, false, &n)

// Every Sysl type a value of `c`'s type is converted from, as `sysl_types` says, but where `generic`
// is set, an integer an option, a result or a collection holds is any Sysl integer, and a real any
// Sysl floating-point type: each is spelled with a type parameter, `S` and its number, whose bound,
// `Integer` or `Float`, is pushed onto `n`, so the number is its place there.
private spellings(w: *ShimWriter, c: &Crossing, generic: bool, n: *Buf[string]) -> Buf[string]
    var out: Buf[string] = buf()
    c.form match
        Plain ->
            if generic && numeric(c.ty)
                out.push(s"S${n.len()}")
                n.push(number_bound(c.ty))
            else out.push(sysl_type(w, c))
        OptionForm(_) ->
            for t in spellings(w, payload(c, "Some"), generic, n)
                out.push(s"Option[$t]")
        ResultForm ->
            val oks = spellings(w, payload(c, "Ok"), generic, n)
            val errs = spellings(w, payload(c, "Err"), generic, n)
            for t in oks
                for e in errs
                    out.push(s"Result[$t, $e]")
        // A tuple is spelled once for each way of spelling each of its parts.
        TupleForm ->
            var spelled: Buf[Buf[string]] = buf()
            spelled.push(buf())
            for f in c.variants[0].fields
                val parts = spellings(w, f.crossing, generic, n)
                var longer: Buf[Buf[string]] = buf()
                for prefix in spelled
                    for p in parts
                        var next: Buf[string] = buf()
                        for q in prefix
                            next.push(q)
                        next.push(p)
                        longer.push(next)
                spelled = longer
            for s in spelled
                out.push("(" + comma_list(s) + ")")
        Elements(element, _) ->
            for t in spellings(w, element, generic, n)
                out.push(s"[]$t")
                out.push(s"Buf[$t]")
        // An array of bytes is copied out of a slice Sysl may write or one it may only read.
        Bytes ->
            out.push("[]u8")
            out.push("[]const u8")
        // A handle is made of a Sysl value of its type or of a counted reference to one.
        Handle(_) ->
            out.push(sysl_type(w, c))
            out.push("&" + sysl_type(w, c))
        _ -> out.push(sysl_type(w, c))
    out

// The handles' crossing where `c` is a collection of them, which goes into Sysl as the shares of
// their Sysl values.
private handle_elements(c: &Crossing) -> Option[&Crossing] = c.form match
    Elements(element, _) -> if element.form is Handle(_) then Some(element) else None
    _ -> None

// Whether a value of `c`'s type holds a handle, so that its conversion out of Sysl takes whatever
// Sysl type it is called with: a value or a counted reference, which a type with a destructor can
// only be.
private holds_handle(c: &Crossing) -> bool
    if c.form is Handle(_) then return true
    if c.form is Elements(element, _) then return holds_handle(element)
    for v in c.variants
        for f in v.fields
            if holds_handle(f.crossing) then return true
    false

// The one field of `c`'s variant `name`.
private payload(c: &Crossing, name: string) -> &Crossing
    for v in c.variants
        if v.name == name then return v.fields[0].crossing
    c

// The field of an option's `Some`.
private payload_field(c: &Crossing) -> CrossField
    for v in c.variants
        if v.name == "Some" then return v.fields[0]
    panic("an option's crossing without `Some`")

// How a value of `c`'s type is passed with the C convention.
private crossing_c_side(c: &Crossing) -> string = if c.form is Plain then c_side(c.ty) else "*u8"

// How many layouts a parameter of `c`'s type is passed with: none for a scalar, a string or an array
// of bytes, which are converted by their types alone.
private passed_layouts(c: &Crossing) -> usize = if c.form is Plain || c.form is Bytes || c.form is Handle(_) then 0 else c.layouts

// A value of `c`'s type as Avin passes or stores it, `value`, converted into Sysl, with its layouts
// from `base` among the ones `ds` points at.
private into_expr(w: *ShimWriter, c: &Crossing, value: string, ds: string, base: usize) -> string = c.form match
    Plain -> into_sysl(c.ty, value)
    Bytes -> s"read_only(bytes_in($value))"
    _ ->
        val at = if base == 0 then ds else s"ptr_cast(usize($ds) + ${base * 8}usize)"
        val made = s"in_${function_of(w, c, false).unwrap()}(ctx, $value, $at)"
        if c.form is Elements(_, false) then s"read_only($made)" else made

// The Sysl value `value` of `c`'s type converted out of Sysl, with its layouts from `base` among the
// ones `ds` points at. An integer, a mirror's field or held in an option, a result or a collection,
// takes any Sysl integer, converted, and a real any Sysl floating-point type, widened.
private out_expr(w: *ShimWriter, c: &Crossing, value: string, ds: string, base: usize) -> string = c.form match
    Plain ->
        if *c.ty is Int(_) then s"integer_to(ctx, $value, \"${sysl_side(c.ty)}\")"
        elif *c.ty is Real then s"real_to($value)"
        else out_of_sysl(c.ty, value)
    Bytes -> s"bytes_of(ctx, $value, $ds[$base])"
    _ ->
        val at = if base == 0 then ds else s"ptr_cast(usize($ds) + ${base * 8}usize)"
        s"out_${function_of(w, c, true).unwrap()}(ctx, $value, $at)"

// The Sysl spelling of `c`'s variant `v` made of the values `args`.
private construction(w: *ShimWriter, c: &Crossing, v: CrossVariant, args: Buf[string]) -> string
    var joined = ""
    for i in 0..<args.len()
        if i > 0 then joined = joined + ", "
        joined = joined + args[i]
    c.form match
        Mirror(_, _, _, _, structure) ->
            val m = s"mirror_${mirror_of(w, c).unwrap()}"
            if structure then s"$m($joined)"
            elif args.len() == 0 then s"$m.${v.name}"
            else s"$m.${v.name}($joined)"
        TupleForm -> s"($joined)"
        _ -> if args.len() == 0 then v.name else s"${v.name}($joined)"

// The conversion into Sysl of a value of the `k`th data type that crosses that way: its variant is
// its descriptor's tag, and each field is read at its offset, with its layouts among the ones `ds`
// points at. A mirror's integer field becomes the integer type the Sysl variant or struct declares.
private in_function(w: *ShimWriter, k: usize)
    val c = w.ins[k]
    if c.form is Elements(element, vector)
        in_elements(w, k, c, element, vector)
        return
    val mirrored = c.form is Mirror(_, _, _, _, _)
    put(w, "\n")
    val start = w.line
    put(w, s"// ${type_name(c.ty)} into Sysl.\nprivate in_$k(ctx: *Context, p: *u8, ds: **u8) -> ${sysl_type(w, c)}\n")
    // An option Avin keeps as a pointer is `None` where it is null, and otherwise its value.
    if c.form is OptionForm(true)
        val f = payload_field(c)
        put(w, "    if p == null then return None\n")
        put(w, "    Some(" + into_expr(w, f.crossing, "p", "ds", f.base) + ")\n")
        mirror_lines(w, c, start)
        return
    if c.variants.len() > 1 then put(w, "    val tag = descriptor_of(p).tag\n")
    var sites: Buf[PassedHandle] = buf()
    for t in 0..<c.variants.len()
        val v = c.variants[t]
        val lastly = t + 1 == c.variants.len()
        val indent = if lastly then "    " else "        "
        if !lastly then put(w, s"    if tag == ${t}usize\n")
        var args: Buf[string] = buf()
        var handles: Buf[PassedHandle] = buf()
        var types: Buf[usize] = buf()
        for i in 0..<v.fields.len()
            val f = v.fields[i]
            f.offset match
                Some(offset) ->
                    put(w, indent + s"val q$i: *${crossing_c_side(f.crossing)} = ptr_cast(usize(p) + ${offset}usize)\n")
                    if f.crossing.form is Handle(_)
                        val m = handle_index(w, f.crossing)
                        put(w, indent + s"val h$i = held_$m(ctx, q$i[0])\n")
                        val h = PassedHandle(args.len(), m, s"h$i", s"in_${k}_${t}_$i")
                        handles.push(h)
                        sites.push(h)
                        if !has_mirror(types, m) then types.push(m)
                        args.push("")
                    elif mirrored && *f.crossing.ty is Int(_) then args.push(s"integer_to(ctx, q$i[0], \"the Sysl field `${f.name}`\")")
                    elif mirrored && *f.crossing.ty is Real then args.push(s"real_in(q$i[0])")
                    else args.push(into_expr(w, f.crossing, s"q$i[0]", "ds", f.base))
                None -> args.push("()")
        construction_arms(w, c, v, args, handles, types, 0, buf(), if lastly then "" else "return ", indent)
    // Each handle field's helpers are the mirror's lines, where a field Sysl does not take is reported.
    for h in sites
        site_helpers(w, h)
    mirror_lines(w, c, start)

// Whether `items` holds `m`.
private has_mirror(items: Buf[usize], m: usize) -> bool
    for i in items
        if i == m then return true
    false

// The construction of `c`'s variant `v` from `args`, after `prefix`, written once for each choice of
// the handles' types `types` from `depth` on being a trait or not, as `call_arms` writes a call: a
// handle field is passed as a parameter is, its reference shared where its type is a trait and
// otherwise given as the field's type asks.
private construction_arms(w: *ShimWriter, c: &Crossing, v: CrossVariant, args: Buf[string], handles: Buf[PassedHandle], types: Buf[usize], depth: usize, traits: Buf[usize], prefix: string, indent: string)
    if depth == types.len()
        var given: Buf[string] = buf()
        for k in 0..<args.len()
            var arg = args[k]
            for h in handles
                if h.arg != k then continue
                arg = if has_mirror(traits, h.mirror) then s"cell_${h.mirror}(${h.name}).r" else s"pass_${h.site}(${h.name})"
            given.push(arg)
        put(w, indent + prefix + construction(w, c, v, given) + "\n")
        return
    val m = types[depth]
    var with: Buf[usize] = buf()
    for d in traits
        with.push(d)
    with.push(m)
    put(w, indent + s"if const wide_$m()\n")
    construction_arms(w, c, v, args, handles, types, depth + 1, with, prefix, indent + "    ")
    put(w, indent + "else\n")
    construction_arms(w, c, v, args, handles, types, depth + 1, traits, prefix, indent + "    ")

// The conversion out of Sysl of a value of the `k`th data type that crosses that way: each variant
// is made by its layout, among the ones `ds` points at, and each field converted and stored at its
// offset.
private out_function(w: *ShimWriter, k: usize)
    val c = w.outs[k]
    if c.form is Elements(element, vector)
        out_elements(w, k, c, element, vector)
        return
    put(w, "\n")
    val start = w.line
    put(w, s"// ${type_name(c.ty)} out of Sysl.\n")
    // A handle's object is made by its one layout, and holds the reference to the Sysl value. A
    // conversion that holds a handle is generic in the Sysl type it is called with, so a value and a
    // counted reference both convert, and Sysl checks each where it is called.
    if c.form is Handle(_)
        val m = handle_index(w, c)
        put(w, s"private out_$k[V](ctx: *Context, v: V, ds: **u8) -> *u8\n    val o = allocate(ctx, ptr_cast(ds[0]))\n    hold_$m(ctx, o, v)\n    o\n")
        w.mirror_lines.push(MirrorLines(m, start, w.line - 1))
        return
    // A mirror is its one Sysl type, whatever its fields hold.
    if holds_handle(c) && !(c.form is Mirror(_, _, _, _, _)) then out_overload(w, k, c, "", "")
    else
        // A conversion that holds a number is generic in the Sysl type of each.
        var n: Buf[string] = buf()
        val spelled = spellings(w, c, true, &n)
        val parameters = number_parameters(n)
        for spelling in spelled
            out_overload(w, k, c, spelling, parameters)
    mirror_lines(w, c, start)

// One overload of the conversion out of Sysl of the `k`th data type that crosses that way, from the
// Sysl type `spelling` with the type parameters `parameters`, or the conversion generic in it where
// `spelling` is empty.
private out_overload(w: *ShimWriter, k: usize, c: &Crossing, spelling: string, parameters: string)
    val structure = c.form is Mirror(_, _, _, _, true)
    if spelling == "" then put(w, s"private out_$k[V](ctx: *Context, v: V, ds: **u8) -> *u8\n")
    else put(w, s"private out_$k$parameters(ctx: *Context, v: $spelling, ds: **u8) -> *u8\n")
    if c.form is OptionForm(true)
        val f = payload_field(c)
        put(w, "    v match\n        None -> null\n")
        put(w, "        Some(f0) -> " + out_expr(w, f.crossing, "f0", "ds", f.base) + "\n")
        return
    if !structure then put(w, "    v match\n")
    for t in 0..<c.variants.len()
        val v = c.variants[t]
        var values: Buf[string] = buf()
        var names: Buf[string] = buf()
        for i in 0..<v.fields.len()
            if structure then values.push(s"v.${sysl_field_of(v.fields[i].name)}")
            else values.push(s"f$i")
            names.push(if *v.fields[i].crossing.ty is Unit then "_" else s"f$i")
        val indent = if structure then "    " else "            "
        if !structure
            put(w, "        " + construction(w, c, v, names) + " ->")
            if v.constant
                put(w, s" ds[$t]\n")
                continue
            put(w, "\n")
        elif v.constant
            put(w, s"    ds[$t]\n")
            continue
        put(w, indent + "var root = Root(Frame(ctx.top, 1usize), null)\n")
        put(w, indent + "ctx.top = ptr_cast(&root)\n")
        put(w, indent + s"root.object = allocate(ctx, ptr_cast(ds[$t]))\n")
        for i in 0..<v.fields.len()
            val f = v.fields[i]
            if f.offset is Some(offset)
                val side = crossing_c_side(f.crossing)
                put(w, indent + s"val x$i: $side = " + out_expr(w, f.crossing, values[i], "ds", f.base) + "\n")
                put(w, indent + s"val p$i: *$side = ptr_cast(usize(root.object) + ${offset}usize)\n")
                put(w, indent + s"p$i[0] = x$i\n")
        put(w, indent + "ctx.top = root.frame.prev\n")
        put(w, indent + "root.object\n")

// The conversion into Sysl of the `k`th collection that crosses that way: each element of its array,
// read at its place and converted, pushed onto a `Buf` whose elements are the slice the Sysl function
// is passed. A vector's elements are read a leaf at a time, each leaf an array given by the core
// library's function among the layouts, which neither allocates nor collects.
private in_elements(w: *ShimWriter, k: usize, c: &Crossing, element: &Crossing, vector: bool)
    val own = if vector then 4usize else 1usize
    // A collection of handles becomes the shares of their Sysl values, each handle checked as one
    // passed by itself is.
    val shared = if element.form is Handle(_) then s"&mirror_${handle_index(w, element)}" else sysl_type(w, element)
    put(w, s"\n// ${type_name(c.ty)} into Sysl.\nprivate in_$k(ctx: *Context, p: *u8, ds: **u8) -> []$shared\n")
    put(w, s"    var b: Buf[$shared] = buf()\n")
    var indent = "    "
    if vector
        put(w, "    val length_of: *extern(*Context, *u8) -> i32 = ptr_cast(ds[2])\n")
        put(w, "    val leaf_of: *extern(*Context, *u8, i32) -> *u8 = ptr_cast(ds[3])\n")
        put(w, "    val n = usize(length_of(ctx, p))\n")
        put(w, "    var at = 0usize\n")
        put(w, "    while at < n\n")
        put(w, "        val a = leaf_of(ctx, p, i32(at))\n")
        put(w, "        at += array_length(a)\n")
        indent = "        "
    else
        put(w, "    val a = p\n")
    if *element.ty is Unit
        put(w, indent + "for _ in 0..<array_length(a) do b.push(())\n")
    else
        put(w, indent + s"val e: *${crossing_c_side(element)} = ptr_cast(array_elements(a))\n")
        val made = if element.form is Handle(_)
            val m = handle_index(w, element)
            s"cell_$m(held_$m(ctx, e[i])).r"
        else into_expr(w, element, "e[i]", "ds", own)
        put(w, indent + "for i in 0..<array_length(a) do b.push(" + made + ")\n")
    put(w, "    b.view()\n")

// The conversion out of Sysl of the `k`th collection that crosses that way: a new array laid out by
// the first of the layouts `ds` points at, kept as a frame while each element is converted and stored
// at its place, and for a vector, the vector the core library's function, the second layout, makes
// of it. The elements' layouts follow. Each way of spelling the elements' type has an overload for a
// slice, which does the conversion, and one for a `Buf`, which converts the slice of its elements. A
// collection that holds an integer is generic in the Sysl integer type of each.
private out_elements(w: *ShimWriter, k: usize, c: &Crossing, element: &Crossing, vector: bool)
    val own = if vector then 4usize else 1usize
    val side = crossing_c_side(element)
    put(w, s"\n// ${type_name(c.ty)} out of Sysl.\n")
    var n: Buf[string] = buf()
    var elements = spellings(w, element, true, &n)
    var parameters = number_parameters(n)
    // Elements that hold a handle are taken as whatever Sysl type they are, a value or a counted
    // reference, which a type with a destructor can only be.
    if holds_handle(element)
        elements = buf()
        elements.push("E")
        parameters = "[E]"
    for j in 0..<elements.len()
        val t = elements[j]
        put(w, s"private out_$k$parameters(ctx: *Context, v: Buf[$t], ds: **u8) -> *u8 = out_$k(ctx, v.view(), ds)\n")
        put(w, s"private out_$k$parameters(ctx: *Context, v: []$t, ds: **u8) -> *u8\n")
        put(w, "    var root = Root(Frame(ctx.top, 1usize), null)\n")
        put(w, "    ctx.top = ptr_cast(&root)\n")
        put(w, "    root.object = new_array(ctx, ptr_cast(ds[0]), v.len)\n")
        if !(*element.ty is Unit)
            put(w, "    for i in 0..<v.len\n")
            put(w, s"        val x: $side = " + out_expr(w, element, "v[i]", "ds", own) + "\n")
            put(w, s"        val e: *$side = ptr_cast(array_elements(root.object))\n")
            put(w, "        e[i] = x\n")
        if vector
            put(w, "    val of_array: *extern(*Context, *u8) -> *u8 = ptr_cast(ds[1])\n")
            put(w, "    val made = of_array(ctx, root.object)\n")
            put(w, "    ctx.top = root.frame.prev\n")
            put(w, "    made\n")
        else
            put(w, "    ctx.top = root.frame.prev\n")
            put(w, "    root.object\n")

// Makes the lines of a conversion from `start` to the last written its mirror's, when its type is
// one.
private mirror_lines(w: *ShimWriter, c: &Crossing, start: usize)
    if mirror_of(w, c) is Some(m) then w.mirror_lines.push(MirrorLines(m, start, w.line - 1))

// How a boundary type is passed with the C convention: as Avin's compiled code passes it.
private c_side(t: &Type) -> string = *t match
    Bool -> "u8"
    Char -> "u32"
    Str -> "*u8"
    _ -> sysl_side(t)

// The Sysl type a boundary type is converted to.
private sysl_side(t: &Type) -> string = *t match
    Unit -> "unit"
    Bool -> "bool"
    Char -> "char"
    Real -> "real"
    Str -> "string"
    Byte -> "u8"
    Int(bits) -> if bits == 32 then "int" elif bits == 64 then "long" else s"i$bits"
    _ -> "unit"

private into_sysl(t: &Type, a: string) -> string = *t match
    Bool -> s"$a != 0"
    Char -> s"char($a)"
    Str -> s"text_in($a)"
    _ -> a

private out_of_sysl(t: &Type, r: string) -> string = *t match
    Bool -> s"if $r then u8(1) else u8(0)"
    Char -> s"u32($r)"
    Str -> s"text_of(ctx, $r)"
    _ -> r

/** The archive a program with bindings links in place of the runtime's: the runtime with the
 * program's shims, built once for each shim source, Sysl version and runtime source, and kept in the
 * toolchain's cache. An error is the diagnostics of a shim Sysl rejected, reported at the bindings,
 * or why the shims could not be built. */
ensure_shims(tc: Toolchain, bindings: Buf[MirBinding], handles: Buf[MirHandle], units: Buf[SourceUnit], sysl: Buf[SyslPackage]) -> Result[string, string]
    val shim = shim_source(bindings, handles)
    val manifest = shim_manifest(tc.runtime_dir(), sysl)
    val version = capture(tc.sysl, ["--version"], timeout = 60000) match
        Ok(r) -> r.text
        Err(e) -> return Err("avin: " + missing_tool(tc.sysl, e.to_string()))
    val archive = tc.shim_cache() + "/" + shim_key(manifest, shim.text, version, runtime_fingerprint(tc), sysl) + ".a"
    // An archive is whole with the libraries it needs beside it; one without them was cached before
    // they were kept, and is built again.
    if exists(archive) && exists(link_needs_file(archive)) then return Ok(archive)
    make_dir_all(tc.shim_cache()).map_err(e -> e.to_string())?
    val dir = make_temp_dir("avin-shims").map_err(e -> e.to_string())?
    defer _ = remove_dir_all(dir)
    make_dir_all(dir + "/avin/shims").map_err(e -> e.to_string())?
    write_text(dir + "/sysl.hocon", manifest).map_err(e -> e.to_string())?
    write_text(dir + "/avin/shims/shims.sysl", shim.text).map_err(e -> e.to_string())?
    // Built under a temporary name and published by rename, so builds running at the same time never
    // see a partial archive.
    val pending = pending_name(archive)
    defer _ = remove_file(pending)
    defer _ = remove_file(pending + ".h")
    var built = shim
    var result = capture(tc.sysl, ["build-c", dir, "-o", pending], stderr = true, timeout = 300000).map_err(e -> "avin: " + missing_tool(tc.sysl, e.to_string()))?
    // A callback whose closure answers a type parameter of a generic Sysl function leaves the integer
    // its answer is converted into unsaid, so that callback answers the Avin type itself, and an
    // integer passed to a parameter of such a type leaves its Sysl type unsaid, so it is passed as
    // the Avin type itself; and a closure whose parameters' types Sysl cannot infer has each written as
    // the Avin type's. The archive is kept under the first source's key, which decides the others.
    // Sysl reports what it could not infer a part at a time, a closure's parameters before its answer,
    // so the shims are built again while each build finds more to write out.
    var fixed: Buf[string] = buf()
    while !result.status.ok()
        val more = unsaid_answers(result.err.unwrap_or("") + result.text, built, bindings)
        var grown = false
        for name in more
            val before = fixed.len()
            fixed = add_name(fixed, name)
            if fixed.len() > before then grown = true
        if !grown then break
        built = shim_source_fixing(bindings, handles, fixed)
        write_text(dir + "/avin/shims/shims.sysl", built.text).map_err(e -> e.to_string())?
        result = capture(tc.sysl, ["build-c", dir, "-o", pending], stderr = true, timeout = 300000).map_err(e -> "avin: " + missing_tool(tc.sysl, e.to_string()))?
    if !result.status.ok()
        val output = result.err.unwrap_or("") + result.text
        return Err(shim_diagnostics(output, built, bindings, units))
    // The libraries are published first, so an archive is never seen without them.
    val needs = link_needs_file(archive)
    val pending_needs = pending_name(needs)
    defer _ = remove_file(pending_needs)
    write_text(pending_needs, link_needs(result.err.unwrap_or("") + "\n" + result.text)).map_err(e -> e.to_string())?
    publish_file(pending_needs, needs).map_err(e -> e.to_string())?
    publish_file(pending, archive).map_err(e -> e.to_string())?
    Ok(archive)

// The callbacks, `call_<i>_<k>`, whose integer answer, and the integer parameters, `param_<i>_<k>`,
// whose Sysl type, Sysl could not infer a type for in `output`, the diagnostics of `shim`. Where any
// other of a binding's type arguments could not be inferred, its integer parameters may be what left
// it unsaid, as the arguments of a generic Sysl function that infers a type parameter from them do:
// every integer parameter of that binding is passed as the Avin type itself.
private unsaid_answers(output: string, shim: ShimSource, bindings: Buf[MirBinding]) -> Buf[string]
    var out: Buf[string] = buf()
    val marker = "cannot infer the type argument '"
    var stalled = false
    var untyped = false
    for text in output.split("\n")
        // The place of an error that left another type argument unsaid names its binding.
        if stalled && text.trim().starts_with("--> ") && text.contains("/avin/shims/shims.sysl:")
            stalled = false
            owner_of(shim, line_of(text.trim()["--> ".bytes.len..])) match
                Some(i) ->
                    for k in 0..<bindings[i].params.len()
                        out = add_name(out, s"param_${i}_$k")
                None -> ()
            continue
        // So does the place of a closure whose parameters' types Sysl could not infer, as where the
        // Sysl function's closure takes its own type parameter.
        if untyped && text.trim().starts_with("--> ") && text.contains("/avin/shims/shims.sysl:")
            untyped = false
            owner_of(shim, line_of(text.trim()["--> ".bytes.len..])) match
                Some(i) -> out = add_name(out, s"lambda_$i")
                None -> ()
            continue
        if text.starts_with("error: ")
            stalled = false
            untyped = text.contains("has no type here — nothing says what this closure takes")
            if untyped then continue
        val parts = text.split(marker)
        if parts.len != 2 then continue
        val answer = parts[1].starts_with("R' of 'avin.shims.call_")
        val parameter = parts[1].starts_with("T' of 'avin.shims.param_")
        if !answer && !parameter
            stalled = true
            continue
        val rest = parts[1]["R' of 'avin.shims.".bytes.len..].split("'")
        if rest.len < 2 then continue
        out = add_name(out, rest[0])
    out

// `names` with `name` added, unless it is there already.
private add_name(names: Buf[string], name: string) -> Buf[string]
    for n in names
        if n == name then return names
    var out = names
    out.push(name)
    out

/** The file beside a shim archive that lists the C libraries the archive's Sysl packages need at
 * the link, one to a line: `lib <name>` for a library a package names with `@link`, and
 * `pkg <name>` for a `pkg_config` module a package requires, whose flags are asked for at each link,
 * so a library that moves on the machine is still found. */
link_needs_file(archive: string) -> string = archive + ".link"

// What `sysl build-c` says the archive's link line still needs: what `@link` named, and the
// `pkg_config` modules the packages require.
private const LinkLibraries: string = "sysl: link this against: "
private const LinkModules: string = "sysl: and against what the packages require, which pkg-config answers for: pkg-config --libs "

/** The libraries `sysl build-c`'s report says an archive needs, in the form of `link_needs_file`. */
link_needs(output: string) -> string
    var out = str_builder()
    for text in output.split("\n")
        if text.starts_with(LinkLibraries)
            for name in text[LinkLibraries.bytes.len..].split(",")
                val n = name.trim()
                if n != "" then out.push("lib " + n + "\n")
        elif text.starts_with(LinkModules)
            for name in text[LinkModules.bytes.len..].split(" ")
                val n = name.trim()
                if n != "" then out.push("pkg " + n + "\n")
    out.finish()

/** The linker flags for the libraries a `link_needs_file` lists: `-l` for each library the C
 * runtime does not already carry, then what `pkg-config --libs` answers for the modules. */
link_flags(needs: string) -> Result[Buf[string], string]
    var flags: Buf[string] = buf()
    var modules: Buf[string] = buf()
    modules.push("--libs")
    for text in needs.split("\n")
        if text.starts_with("lib ")
            val name = text["lib ".bytes.len..]
            // Every program is linked with the C runtime and `-lm` already.
            if name != "c" && name != "m" then flags.push("-l" + name)
        elif text.starts_with("pkg ")
            modules.push(text["pkg ".bytes.len..])
    if modules.len() == 1 then return Ok(flags)
    var asked = "pkg-config"
    for m in modules
        asked = asked + " " + m
    val result = capture("pkg-config", modules.view(), stderr = true, timeout = 60000).map_err(e -> s"the Sysl packages need the flags `$asked` answers, and it could not run: ${e.to_string()}")?
    if !result.status.ok()
        return Err(s"the Sysl packages need the flags `$asked` answers, and it failed: ${result.status.to_string()}\n${result.err.unwrap_or("")}${result.text}")
    for word in result.text.replace_all("\n", " ").replace_all("\t", " ").split(" ")
        if word != "" then flags.push(word)
    Ok(flags)

/** Sysl's diagnostics of a shim, each reported at the binding whose part of the shim it is in, or
 * the whole output when one of them is elsewhere. */
shim_diagnostics(output: string, shim: ShimSource, bindings: Buf[MirBinding], units: Buf[SourceUnit]) -> string
    var rendered = ""
    var message = ""
    var unplaced = false
    for text in output.split("\n")
        if text.starts_with("error: ")
            message = unconverted_message(shim, bindings, text["error: ".bytes.len..])
            continue
        var at = 0usize
        while at < text.bytes.len && text.bytes[at] == u8(' ')
            at += 1
        if message == "" || !text[at..].starts_with("--> ") then continue
        val place = text[at + 4..]
        val in_shims = place.contains("/avin/shims/shims.sysl:")
        val line = line_of(place)
        val passing = if in_shims then passing_owner(shim, line) else None
        val m = if in_shims && passing is None then mirror_owning(shim, line) else None
        val k = if in_shims && m is None && passing is None then owner_of(shim, line) else None
        // A handle passed where Sysl takes another type is read by its helper as that type, which
        // the helper's body cannot be.
        if passing is Some(j)
            val mirror = shim.mirrors[j]
            var r = report()
            r.add(error(mirror.span, s"the Sysl handle `${mirror.name}` is passed to a Sysl parameter that does not take `${mirror.target}`: ${listed_message(message)}"))
            rendered = once(rendered, r.render(units[mirror.unit].src))
        elif m is Some(j)
            val mirror = shim.mirrors[j]
            // A mirror whose import failed is also undefined where the shim names it, and a variant
            // Sysl's type lacks, or every variant of a type Sysl could not find, is also a pattern
            // naming no variant where the shim converts it: each says nothing more.
            if message.starts_with("undefined name 'avin.shims.mirror_") || message.starts_with("unknown type 'mirror_") || (message.starts_with("'mirror_") && message.contains(" names no variant of "))
                message = ""
                continue
            var r = report()
            val what = if mirror.finalizer == "" then "mirror" else "handle"
            r.add(error(mirror.span, s"the Sysl $what `${mirror.name}` does not match `${mirror.target}`: ${site_message(message)}"))
            rendered = once(rendered, r.render(units[mirror.unit].src))
        else
            k match
                Some(i) ->
                    val b = bindings[i]
                    // A binding whose import failed is also undefined where its shim calls it, and a
                    // mirror whose import failed unknown where a binding names it, which say nothing
                    // more.
                    if message.starts_with("undefined function 'bound_") || message.starts_with("unknown type 'mirror_")
                        message = ""
                        continue
                    if message.starts_with("no module is called ")
                        message = message + ": a binding reaches Sysl's standard library and the Sysl packages the manifest names in `sysl-dependencies`"
                    // A closure Sysl takes as a `&sync Fn` may be called from any thread, which the
                    // binding's parameter has to say.
                    if message.contains("shared between two domains") && message.contains("avin.rt.Callback")
                        message = "Sysl may call the function it is given from another thread, so the parameter that takes it is marked `@threaded`"
                    message = site_message(nested_integer_message(listed_message(callback_parameter_message(message))))
                    var r = report()
                    r.add(error(b.span, s"the Sysl binding `${b.name}` does not match `${b.target}`: $message"))
                    rendered = once(rendered, r.render(units[b.unit].src))
                None -> unplaced = true
        message = ""
    if unplaced || rendered == "" then return "avin: Sysl could not build the bindings' shims:\n" + output
    rendered

// The diagnostics `rendered` with `more` after them, unless they already hold it: Sysl reports a
// mirror's or a handle's type at each line of the shim that names it, which says one thing.
private once(rendered: string, more: string) -> string = if rendered.contains(more) then rendered else rendered + more

// Sysl's words for a collection of handles whose slice is not the one the Sysl parameter takes,
// `function 'avin.shims.given_all_0' should return []&A, but its body yields []&B`, said of the
// collection, or whose slice is not what the parameter takes at all; any other message as it is.
private listed_message(message: string) -> string
    if message.starts_with("cannot infer the type argument 'E' of 'avin.shims.given_") then return "a collection of handles goes into Sysl as a slice, which the Sysl parameter does not take"
    if !message.starts_with("function 'avin.shims.given_") then return message
    val halves = message.split("' should return ")
    if halves.len != 2 then return message
    val types = halves[1].split(", but its body yields ")
    if types.len != 2 then return message
    s"the collection's handles go in as a `${types[1]}`, and the parameter takes a `${types[0]}`"

// Sysl's diagnostic `message`, or when it says that no overload of a conversion out of Sysl takes the
// value it is called with, what that conversion makes and from what; when it says an integer's
// conversion was given a value of another type, which type.
private unconverted_message(shim: ShimSource, bindings: Buf[MirBinding], message: string) -> string
    // An integer result, a mirror's integer field and an integer an option, a result or a collection
    // holds are converted from any Sysl integer, and only one.
    val integral = " to implement 'Integer', but "
    val refusal = " does not"
    val trimmed = message.trim()
    read_only_refusal(trimmed) match
        Some(wanted) -> return s"Sysl may write the elements of its `$wanted`, and an `Array` there crosses as a copy it may only read, so what it wrote would never reach the array: an `Array` is written back only as the binding's own parameter, of bytes, integers, reals, booleans or characters"
        None -> ()
    if trimmed.starts_with("'avin.shims.") && trimmed.contains(integral) && trimmed.ends_with(refusal)
        var parts: Buf[string] = buf()
        for p in trimmed.split(integral)
            parts.push(p)
        if parts.len() == 2
            val given = parts[1][0..<parts[1].bytes.len - refusal.bytes.len]
            // A callback's integer answer goes the other way, into the integer the closure answers.
            if trimmed.starts_with("'avin.shims.call_") || trimmed.starts_with("'avin.shims.run_")
                return s"the function answers an integer, which goes into Sysl only as an integer, but the closure Sysl takes answers $given"
            // An integer parameter goes into the integer the Sysl parameter is, and only an integer.
            if trimmed.starts_with("'avin.shims.param_")
                return s"parameter ${parameter_number(trimmed["'avin.shims.param_".bytes.len..], bindings)} is an integer, which goes into Sysl only as an integer, but the Sysl parameter is $given"
            return s"an integer is made from a Sysl integer, but the value is $given"
    // A real goes into and comes out of any Sysl floating-point type, and only one.
    val floating = " to implement 'Float', but "
    if trimmed.starts_with("'avin.shims.") && trimmed.contains(floating) && trimmed.ends_with(refusal)
        val parts = trimmed.split(floating)
        if parts.len == 2
            val given = parts[1][0..<parts[1].bytes.len - refusal.bytes.len]
            if trimmed.starts_with("'avin.shims.call_") || trimmed.starts_with("'avin.shims.run_")
                return s"the function answers a real, which goes into Sysl only as a floating-point number, but the closure Sysl takes answers $given"
            if trimmed.starts_with("'avin.shims.param_")
                return s"parameter ${parameter_number(trimmed["'avin.shims.param_".bytes.len..], bindings)} is a real, which goes into Sysl only as a floating-point number, but the Sysl parameter is $given"
            return s"a real is made from a Sysl floating-point number, but the value is $given"
    val prefix = "no 'avin.shims.out_"
    if !message.starts_with(prefix) then return message
    var k = 0usize
    var at = prefix.bytes.len
    while at < message.bytes.len && message.bytes[at] >= u8('0') && message.bytes[at] <= u8('9')
        k = k * 10 + usize(message.bytes[at] - u8('0'))
        at += 1
    if at == prefix.bytes.len || k >= shim.unconverted.len() then return message
    shim.unconverted[k]

// The place among the Avin binding's parameters, counted from 1 and a handle method's receiver not
// counted, of the parameter `<i>_<k>'...` names: binding `i`'s parameter `k`.
private parameter_number(named: string, bindings: Buf[MirBinding]) -> usize
    var i = 0usize
    var k = 0usize
    var at = 0usize
    while at < named.bytes.len && u8('0') <= named.bytes[at] <= u8('9')
        i = i * 10 + usize(named.bytes[at] - u8('0'))
        at += 1
    at += 1
    while at < named.bytes.len && u8('0') <= named.bytes[at] <= u8('9')
        k = k * 10 + usize(named.bytes[at] - u8('0'))
        at += 1
    if i < bindings.len() && !(bindings[i].reach is TopLevel) then k else k + 1

// Sysl's words for a parameter that holds an integer in a type Sysl's parameter spells with another
// integer, `'n' of 'f' is Option[i64], but Option[int] was given`, with why: only a binding's own
// integer parameter is converted; any other message as it is.
private nested_integer_message(message: string) -> string
    val given = " was given"
    if !message.ends_with(given) || !message.contains(", but ") then return message
    var halves: Buf[string] = buf()
    for p in message[0..<message.bytes.len - given.bytes.len].split(", but ")
        halves.push(p)
    if halves.len() != 2 then return message
    var words: Buf[string] = buf()
    for p in halves[0].split(" is ")
        words.push(p)
    val expected = words[words.len() - 1]
    val passed = halves[1]
    // A plain integer is converted, so only an integer inside another type reaches here.
    if !expected.contains("[") && !expected.contains("(") then return message
    if any_integer(expected, false) == any_integer(passed, false) then return message + ": an integer inside an `Option`, a `Result`, a tuple or a collection is passed as the type it is declared, and only a binding's own integer parameter is converted into the Sysl parameter's integer"
    // So is a real inside another type, which only a binding's own real parameter is rounded from.
    if any_integer(expected, true) == any_integer(passed, true) then return message + ": a real inside an `Option`, a `Result`, a tuple or a collection is passed as the type it is declared, and only a binding's own real parameter is rounded into the Sysl parameter's floating-point type"
    message

// `text` with each Sysl integer type it names spelled `I`, and where `floats` is set, each
// floating-point type a real converts into spelled `F`.
private any_integer(text: string, floats: bool) -> string
    var out = str_builder()
    var at = 0usize
    while at < text.bytes.len
        if !is_word_byte(text.bytes[at])
            out.push(text[at..<at + 1])
            at += 1
            continue
        var end = at
        while end < text.bytes.len && is_word_byte(text.bytes[end])
            end += 1
        val word = text[at..<end]
        var integer = false
        for t in ["isize", "usize", "long", "int", "i64", "i32", "i16", "i8", "u64", "u32", "u16", "u8"]
            if word == t then integer = true
        var floating = false
        if floats
            for t in ["real", "f64", "f32", "f16", "bf16"]
                if word == t then floating = true
        out.push(if integer then "I" elif floating then "F" else word)
        at = end
    out.finish()

// The Sysl type that wants to write, where Sysl's diagnostic `message` refuses a read-only slice in
// its place: an array the shim passes read-only, given to a slice the Sysl function may write, alone
// or inside another type.
private read_only_refusal(message: string) -> Option[string]
    val licence = "' is a licence to write them"
    if message.contains(licence) && message.contains("' views elements it may not write, and a '")
        var parts: Buf[string] = buf()
        for p in message.split("' views elements it may not write, and a '")
            parts.push(p)
        var wanted: Buf[string] = buf()
        for p in parts[1].split(licence)
            wanted.push(p)
        return Some(wanted[0])
    val given = " was given"
    if !message.ends_with(given) || !message.contains(", but ") || !message.contains("[]const ") then return None
    var halves: Buf[string] = buf()
    for p in message[0..<message.bytes.len - given.bytes.len].split(", but ")
        halves.push(p)
    if halves.len() != 2 then return None
    var words: Buf[string] = buf()
    for p in halves[0].split(" is ")
        words.push(p)
    val expected = words[words.len() - 1]
    if expected.contains("[]const ") || halves[1].replace_all("[]const ", "[]") != expected then return None
    Some(expected)

// The line of a `path:line:col` place.
private line_of(place: string) -> usize
    var parts: Buf[string] = buf()
    for p in place.split(":")
        parts.push(p)
    if parts.len() < 3 then return 0
    var n = 0usize
    for b in parts[parts.len() - 2].bytes
        if b >= u8('0') && b <= u8('9') then n = n * 10 + usize(b - u8('0'))
    n

// The mirror whose import or conversion holds a line of the shim.
private mirror_owning(shim: ShimSource, line: usize) -> Option[usize]
    for part in shim.mirror_lines
        if line >= part.first && line <= part.last then return Some(part.mirror)
    None

// The handle whose helpers for passing it to Sysl hold a line of the shim.
private passing_owner(shim: ShimSource, line: usize) -> Option[usize]
    for part in shim.passing
        if line >= part.first && line <= part.last then return Some(part.mirror)
    None

// The binding whose import or function holds a line of the shim.
private owner_of(shim: ShimSource, line: usize) -> Option[usize]
    for i in 0..<shim.first.len()
        if shim.imports[i] == line || line >= shim.first[i] && line <= shim.last[i] then return Some(i)
    None

/** The name a shim archive is cached under: a key over the shim package's manifest, which names each
 * Sysl package at its version, the shim source, the Sysl version, the runtime's sources, and the
 * sources of each Sysl package in a directory. */
shim_key(manifest: string, shim: string, sysl_version: string, runtime: string, sysl: Buf[SyslPackage]) -> string =
    content_key(manifest + shim + sysl_version + runtime + sysl_fingerprint(sysl))

/** A cache key: the first half of a SHA-256 of everything a cached file is built from, in hex. */
content_key(text: string) -> string
    val digest = sha256(text.bytes)
    val hex = "0123456789abcdef"
    var out = str_builder()
    for i in 0..<16
        out.push_char(char(hex.bytes[usize(digest[i] >> 4)]))
        out.push_char(char(hex.bytes[usize(digest[i] & 15)]))
    out.finish()

/** The runtime's sources, each file's path in the runtime and its text, in the order of their paths,
 * which a shim archive is built from as much as from the shims, and every executable is linked with.
 * The paths are the runtime's own, so the same sources installed anywhere read the same. */
runtime_fingerprint(tc: Toolchain) -> string = tree_fingerprint(tc.runtime_dir())

/** The sources of the Sysl package at `dir`, as `runtime_fingerprint` lists the runtime's: its Sysl
 * files, manifests, sum files and any C it carries, leaving out its `.sysl` working directory. A
 * `dir` that is a symbolic link is read through it, so a link to a package is keyed by its sources. */
tree_fingerprint(dir: string) -> string
    val root = canonicalize(dir).unwrap_or(dir)
    var files: Buf[string] = buf()
    var entries = walk(root)
    loop
        val entry = entries.next() match
            Some(Ok(e)) -> e
            Some(Err(_)) -> continue
            None -> break
        if entry.is_dir() && entry.path.ends_with("/.sysl")
            entries.skip_dir()
            continue
        val p = entry.path
        if p.ends_with(".sysl") || p.ends_with(".hocon") || p.ends_with(".sum") || p.ends_with(".c") || p.ends_with(".h")
            files.push(p)
    val sorted = files.view()
    sort(sorted)
    val prefix = root.bytes.len
    var out = str_builder()
    for f in sorted
        out.push(f[prefix..] + "\n" + read_text(f).unwrap_or("") + "\n")
    out.finish()
