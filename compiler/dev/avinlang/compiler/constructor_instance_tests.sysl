module dev.avinlang.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}

// Instances of generic code at constructor arguments: one copy per list of type arguments,
// constructors included, where two constructors are one when they name one type with the same
// arguments written out at the same places.

private const Program: string = "data ParseError(message: string)\n\ntype Parsed[T] = Result[T, ParseError]\n\nsame[F[_], A](x: F[A]) -> F[A] = x\n\nmain()\n  println(same[Parsed, int](Ok(1)))\n  println(same[Result[_, ParseError], int](Ok(2)))\n  println(same[Result[_, string], int](Ok(3)))\n  println(same[Option, int](Some(4)))\n  println(same[Option, string](Some(\"five\")))\n"

/** How many instances of the program's function `name` lowering made. */
private instances_of(text: string, name: string) -> int
    var files: Buf[ProgramFile] = buf()
    files.push(ProgramFile(source_of("main.avin", text), None, false, buf(), ""))
    val program = lower_files(repository_toolchain(), files) match
        Ok(p) -> p
        Err(d) -> panic(d)
    var n = 0
    for f in program.functions
        if f.symbol.starts_with(s"<program>.$name[") then n += 1
    n

@test("`Parsed` and `Result[_, ParseError]` are one constructor, so one instance; other arguments make their own")
constructor_instances_shared()
    // `Parsed` and `Result[_, ParseError]` at `int`: one; `Result[_, string]`, `Option` at `int`
    // and at `string`: one each.
    assert_eq(instances_of(Program, "same"), 4)

@test("a constructor parameter passed on, bare or partially applied, is the constructor it stands for, so one instance")
constructor_passed_on()
    val text = "same[F[_], A](x: F[A]) -> F[A] = x\n\nthrough[F[_]](x: F[int]) -> F[int] = same[F, int](x)\n\nmain()\n  println(through[Vector]([1]))\n  println(same[Vector, int]([2]))\n"
    assert_eq(instances_of(text, "same"), 1)
    val partial = "same[F[_], A](x: F[A]) -> F[A] = x\n\nright[G[_, _]](x: G[string, int]) -> G[string, int] = same[G[string, _], int](x)\n\nmain()\n  println(right[Either](Right(1)))\n  println(same[Either[string, _], int](Left(\"l\")))\n"
    assert_eq(instances_of(partial, "same"), 1)
    assert_eq(instances_of(partial, "right"), 1)
