module dev.avinlang.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.path.parent

// `avin repl`: when an input is complete, what kind of input it is, and whole sessions fed a script as
// standard input would feed them, checked against what they write.

// ---- when an input is complete ----

// Whether a session given `lines` one at a time, with no command among them, is still waiting after
// the last.
private waits(lines: []const string) -> bool
    var s = ReplSession(repository_toolchain(), "", "", buf(), "", buf(), buf(), buf(), buf(), buf(), 0, buf(), false)
    for l in lines
        s.pending.push(l)
        if !repl_wants_more(&s)
            s.pending.clear()
            s.block = false
            return false
    true

@test("a bracket left open waits for the line that closes it, and strings, characters and comments do not count")
open_brackets_wait()
    assert_eq(open_brackets("f(1, 2)"), 0)
    assert_eq(open_brackets("f(1,"), 1)
    assert_eq(open_brackets("[(1, {"), 3)
    assert_eq(open_brackets("\"(\""), 0)
    assert_eq(open_brackets("'('"), 0)
    assert_eq(open_brackets("\"a\\\"(\""), 0)
    assert_eq(open_brackets("x // ("), 0)
    assert_eq(open_brackets(")"), -1)
    assert_eq(open_brackets(""), 0)
    assert_eq(open_brackets("\"é(\" + 世界("), 1)
    assert(waits(["f(1,"]))
    assert(!waits(["f(1,", "  2)"]))
    assert(waits(["val xs = [", "  1,", "  2"]))
    assert(!waits(["val xs = [", "  1,", "  2", "]"]))

@test("a line ending with an operator, `=`, `->` or a comma goes on; one ending `++` or `--` does not")
operator_continues()
    for t in ["x +", "x -", "a *", "a /", "a %", "a &&", "a ||", "val x =", "f(a) =", "xs ::", "a <", "a >", "(a, b) ->", "a,", "x |>"]
        assert(continues_line(t), t)
    for t in ["x", "i++", "i--", "f(x)", "\"a\"", "", "x?", "a == b", "-1"]
        assert(!continues_line(t), t)
    assert(waits(["1 +"]))
    assert(!waits(["1 +", "2"]))
    assert(!waits(["count++"]))

@test("a type's declaration opens a block that only an empty line ends; one line alone is a declaration too")
types_open_blocks()
    for t in ["class A", "trait T", "data P(x: int)", "object O", "impl Show for P", "actor A()", "machine M", "open class B", "abstract class C", "private data D", "sealed trait S"]
        assert(declares_type(t), t)
    for t in ["val classes = 1", "classify(x)", "dataOf(x)", "type Id = int", "impl", "x"]
        assert(!declares_type(t), t)
    assert(waits(["data P(x: int)"]))
    assert(!waits(["data P(x: int)", ""]))
    assert(waits(["class A", "  val n = 1"]))
    assert(!waits(["class A", "  val n = 1", "   "]))

@test("a line the parser finds unfinished opens a block, which an empty line ends; a finished one is entered at once")
unfinished_opens_blocks()
    assert(unfinished_at_end("if x > 0"))
    assert(unfinished_at_end("for i in 0 ..< 3"))
    assert(waits(["double(n: int) -> int"]))
    assert(!waits(["double(n: int) -> int", "  n * 2", ""]))
    assert(unfinished_at_end("while true"))
    assert(!unfinished_at_end("1 + 2"))
    assert(!unfinished_at_end("val x = 1"))
    assert(!unfinished_at_end("double(n: int) = n * 2"))
    assert(!unfinished_at_end("if x > 0 then 1 else 2"))
    assert(waits(["if x > 0"]))
    assert(waits(["if x > 0", "  1"]))
    assert(waits(["if x > 0", "  1", "else"]))
    assert(!waits(["if x > 0", "  1", "else", "  2", ""]))
    assert(!waits(["1 + 2"]))
    assert(!waits([""]))

@test("a local function's header with parameters opens a block; a call, and a header of no parameters, do not")
function_headers_open_blocks()
    assert(heads_function("addTo(k: int)"))
    assert(heads_function("pair[T](a: T, b: T)"))
    assert(heads_function("log(m: string, level: int = 0)"))
    assert(!heads_function("greet()"))
    assert(!heads_function("id(\"g\")"))
    assert(!heads_function("f(1)"))
    assert(!heads_function("f(x)"))
    assert(!heads_function("val x = f(k: int)"))
    assert(!heads_function("addTo(k: int)\n  total += k"))
    assert(waits(["addTo(k: int)"]))
    assert(waits(["addTo(k: int)", "  total += k"]))
    assert(!waits(["addTo(k: int)", "  total += k", ""]))
    assert(!waits(["id(\"g\")"]))
    // A function whose body is on its line is whole already.
    assert(!heads_function("id[T](v: T) -> T = v"))
    assert(!heads_function("double(n: int) = n * 2"))
    assert(!heads_function("show(n: int) -> string = s\"$n\""))
    assert(!waits(["id[T](v: T) -> T = v"]))

// ---- whole sessions ----

// A session started in `dir`, fed `script` a line at a time as standard input feeds it, and everything
// it wrote. What the session built is removed after it.
private transcript_in(dir: string, script: string) -> string
    val tc = repository_toolchain()
    var s = repl_session(tc, dir).unwrap()
    var said = ""
    val out: &Fn(string) -> unit = text -> said = said + text
    var going = true
    for line in script.lines()
        if going then going = repl_line(&s, line, out)
    if going then repl_finish(&s, out)
    _ = remove_dir_all(s.scratch)
    _ = remove_dir_all(build_cache(tc.builds, s.file))
    _ = remove_dir_all(parent(parent(s.file).unwrap()).unwrap())
    said

// A session started in a directory of its own, holding no program.
private transcript(script: string) -> string
    val dir = make_temp_dir("avin-repl-test").unwrap()
    val said = transcript_in(dir, script)
    _ = remove_dir_all(dir)
    said

@test("an expression's value is shown with its type and kept as the next resN; a val by its name; a unit one shows nothing")
session_values()
    val said = transcript("1 + 2\nval x = 40\nx + res0\n\"hi\"\nprintln(\"out\")\n()\ndouble(n: int) = n * 2\ndouble(x)\n[1, 2, 3]\nSome(3)\n'é'\n\"世界\"\nvar v = -2147483648\nv\nres7.charCount\n")
    assert_eq(said, "res0: int = 3\nx: int = 40\nres1: int = 43\nres2: string = \"hi\"\nout\ndouble(n: int) -> int\nres3: int = 80\nres4: Vector[int] = [1, 2, 3]\nres5: Option[int] = Some(3)\nres6: char = 'é'\nres7: string = \"世界\"\nv: int = -2147483648\nres8: int = -2147483648\nres9: int = 2\n")

@test("a name entered again hides the earlier one from the inputs after it; a type declared again replaces the earlier declaration")
session_redefinition()
    val said = transcript("val x = 1\nval x = \"one\"\nx\nf(n: int) = n + 1\nval before = f(1)\nf(n: int) = n * 10\nf(1)\nbefore\ndata P(a: int)\n\nP(1)\ndata P(a: int, b: int)\n\ndata Q(a: int)\n\ndata Q(a: int, b: int)\n\nQ(1, 2)\n")
    assert_eq(said, "x: int = 1\nx: string = \"one\"\nres0: string = \"one\"\nf(n: int) -> int\nbefore: int = 2\nf(n: int) -> int\nres1: int = 10\nres2: int = 2\ndata P(a: int)\nres3: P = P(1)\nerror: `P` takes 2 arguments, not 1 (in an earlier input, which this one breaks)\ndata Q(a: int)\ndata Q(a: int, b: int)\nres4: Q = Q(1, 2)\n")

@test("closures, local functions and generic values reach across inputs, and blocks run over several lines")
session_closures_and_generics()
    val said = transcript("var count = 0\nbump(by: int)\n  count += by\n\nbump(2)\nbump(3)\ncount\nval add = (a: int) -> a + count\nadd(1)\ncount = 10\nadd(1)\nid[T](v: T) -> T = v\nid(\"g\")\nid(7)\n(1, \"two\")\nif count > 3\n  \"big\"\nelse\n  \"small\"\n\nfor i in 0 ..< 3\n  print(i)\n\nprintln()\nval xs = [3, 1, 2].map(x -> x * count)\nxs\n")
    assert_eq(said, "count: int = 0\nbump(by: int)\nres0: int = 5\nadd: (int) -> int = <function>\nres1: int = 6\nres2: int = 11\nid[T](v: T) -> T\nres3: string = \"g\"\nres4: int = 7\nres5: (int, string) = (1, \"two\")\nres6: string = \"big\"\n012\nxs: Vector[int] = [30, 10, 20]\nres7: Vector[int] = [30, 10, 20]\n")

@test("a thread started in one input is joined in a later one; imports are kept and listed")
session_threads_and_imports()
    val said = transcript(":imports\nimport avin.threads.spawn\n:imports\nval t = spawn(() -> 21 * 2)\nprintln(\"between\")\nt.join()\nimport avin.threads.spawn\nimport avin.nothing.here\n:imports\n")
    assert(said.starts_with("no imports\nimport avin.threads.spawn\nt: Thread[int] = Thread[int]\nbetween\nres0: int = 42\nerror: "), said)
    assert(said.ends_with("import avin.threads.spawn\n"), said)
    assert(said.contains("avin.nothing"), said)

@test("an input that traps or ends the program is not kept, and the session goes on")
session_traps()
    val said = transcript("val xs = [1, 2]\nxs(5)\nxs.length\nval zero = 0\nprintln(\"before\")\n1 / zero\nimport avin.process.exit\nexit(3)\nexit(0)\nxs.length\n")
    // A trap names its place in the input as typed, though the program wrote it after `val res0 = `.
    assert(said.starts_with("xs: Vector[int] = [1, 2]\navin: trap: index out of range at <input>:1:1\nres0: int = 2\nzero: int = 0\nbefore\navin: trap: division by zero at <input>:1:3\n"), said)
    assert(said.ends_with("the program exited with status 3, so the input is not kept\nthe input ended the program, so it is not kept\nres1: int = 2\n"), said)

@test("a command misused says how it is used, and the session goes on; :reset forgets, :quit ends")
session_commands()
    val said = transcript(":foo\n:type\n:type 1 + 2\n:type [\"a\"].map(s -> s.charCount)\n:type undefined\n:load\n:load /nonexistent/x.avin\n:reset extra\n:quit extra\n:imports extra\n:type (1,\nval y = 1\n:reset\ny\n:help\n:quit\n1 + 1\n")
    assert(said.starts_with("unknown command `:foo`: :help lists the commands\nusage: :type <expression>\nint\nVector[int]\nerror: `undefined` is not defined\n"), said)
    assert(said.contains("\nusage: :load <file>\ncannot read /nonexistent/x.avin: "), said)
    assert(said.contains("\n:reset takes nothing after it\n:quit takes nothing after it\n:imports takes nothing after it\nusage: :type <expression>, on one line\ny: int = 1\nthe session is empty\nerror: `y` is not defined\n"), said)
    assert(said.ends_with(ReplHelp + "\n"), said)
    // `:type` runs nothing and keeps nothing.
    assert(!said.contains("res0: int = 3"), said)

@test("a diagnostic is placed in the input as it was typed, on the line and column it names")
session_diagnostics()
    val said = transcript("val = 3\nif true\n  undefinedName\n\nval ok = 1\n")
    assert(said.contains("--> <input>:1:"), said)
    assert(said.contains("error: `undefinedName` is not defined\n --> <input>:2:3\n"), said)
    assert(said.ends_with("ok: int = 1\n"), said)

@test(":load enters a file's imports and declarations; its main becomes a function the session calls")
session_load()
    val dir = make_temp_dir("avin-repl-load").unwrap()
    val file = dir + "/lib.avin"
    write_text(file, "import avin.threads.spawn\n\n// twice\ntwice(n: int) = n * 2\n\ndata Box(v: int)\n\nmain()\n  println(twice(21))\n").unwrap()
    val said = transcript(s":load $file\nmain()\nBox(twice(2))\nspawn(() -> twice(4)).join()\n")
    _ = remove_dir_all(dir)
    assert_eq(said, "twice(n: int) -> int\ndata Box(v: int)\nmain()\n42\nres0: Box = Box(4)\nres1: int = 8\n")

@test("a session in a package imports the package's modules, its own main left out")
session_in_a_package()
    val dir = make_temp_dir("avin-repl-package").unwrap()
    make_dir_all(dir + "/shapes").unwrap()
    write_text(dir + "/avin.hocon", "package {\n  name = \"shapes\"\n  version = \"0.1.0\"\n}\n").unwrap()
    write_text(dir + "/shapes/area.avin", "module shapes\n\nsquare(n: int) -> int = n * n\n").unwrap()
    write_text(dir + "/main.avin", "main() = println(\"the package's main\")\n").unwrap()
    val said = transcript_in(dir, "import shapes.square\nsquare(4)\n")
    _ = remove_dir_all(dir)
    assert_eq(said, "res0: int = 16\n")

// ---- the pieces of a file `:load` enters ----

@test("a file is entered as its imports and its declarations, each with the annotations and comments above it")
pieces_of_a_file()
    val text = "#!/usr/bin/env avin\nimport avin.threads.spawn\n\n// the answer\n@inline\nanswer() = 42\n\ndata P(x: int)\n  sum() -> int\n    x\n\nmain()\n  println(answer())\nend main\n"
    val pieces = repl_pieces(text)
    assert_eq(pieces.len(), 4)
    assert_eq(pieces[0], "import avin.threads.spawn")
    assert_eq(pieces[1], "// the answer\n@inline\nanswer() = 42")
    assert_eq(pieces[2], "data P(x: int)\n  sum() -> int\n    x")
    assert_eq(pieces[3], "main()\n  println(answer())\nend main")
    assert_eq(repl_pieces("").len(), 0)
    assert_eq(repl_pieces("\n\n// only a comment\n").len(), 0)
    val brackets = repl_pieces("val xs = [\n  1,\n]\nval y = 2\n")
    assert_eq(brackets.len(), 2)
    assert_eq(brackets[0], "val xs = [\n  1,\n]")

// ---- what the program writes ----

@test("a string is written as an Avin literal, every quote, backslash and control character escaped")
strings_as_literals()
    assert_eq(avin_string("a"), "\"a\"")
    assert_eq(avin_string(""), "\"\"")
    assert_eq(avin_string("say \"hi\"\\"), "\"say \\\"hi\\\"\\\\\"")
    assert_eq(avin_string("a\nb"), "\"a\\nb\"")
    assert_eq(avin_string("\u{1E}x\u{1}"), "\"\\u{1e}x\\u{01}\"")
    assert_eq(avin_string("$x é 世界"), "\"$x é 世界\"")

// What `ReplOutput` passes on of `pieces` read in turn.
private passed(pieces: []const string) -> (string, bool, bool)
    var o = ReplOutput(false, false, "", 0, false, "", ReplPlace(1, 0, 0, 0))
    var said = ""
    val out: &Fn(string) -> unit = t -> said = said + t
    for p in pieces
        o.held = o.held + p
        o.pass(out, false)
    o.finish(out)
    (said, o.started, o.ended)

@test("only what the program writes between its two marks is passed on, however the marks are split across reads")
output_between_marks()
    val (a, started, ended) = passed(["old\n", ReplStart, "new\n", ReplEnd])
    assert_eq(a, "new\n")
    assert(started && ended)
    val (b, _, e2) = passed(["old" + ReplStart[0..<3], ReplStart[3..] + "n", "ew" + ReplEnd[0..<4], ReplEnd[4..] + "late\n"])
    assert_eq(b, "new" + "late\n")
    assert(e2)
    val (c, _, e3) = passed([ReplStart + "trap: oh\n"])
    assert_eq(c, "trap: oh\n")
    assert(!e3)
    val (d, s4, _) = passed(["boom\n"])
    assert_eq(d, "an earlier input failed when the session ran again:\nboom\n")
    assert(!s4)
    val (e, _, _) = passed([ReplStart + "é世" + ReplEnd])
    assert_eq(e, "é世")
    val (f, _, _) = passed([ReplStart, ReplEnd])
    assert_eq(f, "")

@test("a place in the session's file is shown as the place in the input, or as an earlier input outside it")
places_relocated()
    // The input is lines 10 and 11, moved 6 columns right, its first line 4 more.
    val o = ReplOutput(false, false, "", 0, false, "repl.avin", ReplPlace(10, 2, 6, 4))
    assert_eq(o.relocated("trap: x at repl.avin:10:15\n"), "trap: x at <input>:1:5\n")
    assert_eq(o.relocated("at repl.avin:11:7 and repl.avin:11:9"), "at <input>:2:1 and <input>:2:3")
    assert_eq(o.relocated("at repl.avin:9:1"), "at an earlier input")
    assert_eq(o.relocated("at repl.avin:12:1"), "at an earlier input")
    assert_eq(o.relocated("at repl.avin:x and repl.avin:10 and repl.avin:"), "at repl.avin:x and repl.avin:10 and repl.avin:")
    assert_eq(o.relocated("other.avin:10:15"), "other.avin:10:15")
    assert_eq(o.relocated(""), "")
    // A column before the input's margin is its first.
    assert_eq(o.relocated("repl.avin:11:2"), "<input>:2:1")
    assert(ReplPlace(10, 2, 0, 0).holds(10) && ReplPlace(10, 2, 0, 0).holds(11))
    assert(!ReplPlace(10, 2, 0, 0).holds(9) && !ReplPlace(10, 2, 0, 0).holds(12) && !ReplPlace(10, 0, 0, 0).holds(10))
