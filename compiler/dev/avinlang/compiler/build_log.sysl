module dev.avinlang.compiler

import sysl.fs.{append_text, write_text}
import sysl.time.{Duration, micros, monotonic}

// The build log: with `AVIN_BUILD_LOG` set, a build writes one line per phase naming the phase, the
// time it took and what it counted. Unset, no clock is read and nothing is written.

/** The name of the variable that turns the build log on. */
const BuildLogVariable: string = "AVIN_BUILD_LOG"

// Where lines go: "" for nowhere, "-" for the error channel, otherwise the file.
private var log_target: string = ""

/** Starts the build log for one build: `target` is the value of `AVIN_BUILD_LOG`, a file that is
 * emptied now so the log holds that build alone, or `-` for the error channel; none, or an empty
 * name, turns the log off. A file that cannot be written is an error naming it, before the build
 * does any work. */
open_build_log(target: Option[string]) -> Result[unit, string]
    log_target = ""
    val name = target.unwrap_or("")
    if name == "" then return Ok(())
    if name != "-"
        write_text(name, "").map_err(e -> s"avin: $BuildLogVariable: cannot write `$name`: ${e.to_string()}")?
    log_target = name
    Ok(())

/** Turns the build log off. */
close_build_log()
    log_target = ""

/** Whether builds are being logged. */
build_log_on() -> bool = log_target != ""

/** The clock's reading to give `phase_done`, or a zero that costs nothing when no log is kept. */
phase_start() -> Duration = if log_target == "" then micros(0) else monotonic()

/** Logs the end of a phase that began at `began` as the line `phase=<phase> ms=<n> <fields>`, where
 * `fields` is the phase's counts as `key=value` words separated by spaces, and returns the reading
 * that the next phase begins at. */
phase_done(phase: string, began: Duration, fields: string = "") -> Duration
    if log_target == "" then return began
    val now = monotonic()
    val extra = if fields == "" then "" else " " + fields
    val line = s"phase=$phase ms=${(now - began).us / 1000}$extra\n"
    if log_target == "-" then eprints(line) else _ = append_text(log_target, line)
    now
