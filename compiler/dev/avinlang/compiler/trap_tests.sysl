module dev.avinlang.compiler
@tests

import sh.sysl.parsing.source_of

// Trap sites as lowering records them. The execution corpus shows what a running program reports;
// these tests cover the sites no running program reaches, because the checker has proved them
// unreachable, and how sites are shared between instances and between the checks of one operation.

/** Each trap site in the program `text`, as `reason at file:line:col`, one per line, leaving out
 * the prelude's. The program is named by a path with directories, which the sites leave out. */
private sites(text: string) -> string = probe_sites(text, false)

/** The places in the program `text` of the calls that may enter the core library, as
 * `file:line:col`, one per line: the sites with no reason, which a trap inside the library reports. */
private call_sites(text: string) -> string = probe_sites(text, true)

private probe_sites(text: string, calls: bool) -> string
    val program = lower_source(repository_toolchain(), source_of("/some/dir/probe.avin", text)) match
        Ok(p) -> p
        Err(d) -> panic(d)
    var out = ""
    for t in program.traps
        val file = program.strings[t.file]
        val reason = program.strings[t.reason]
        if file != "probe.avin" || (reason == "") != calls then continue
        out = if calls then out + s"$file:${t.line}:${t.col}\n" else out + s"$reason at $file:${t.line}:${t.col}\n"
    out

@test("a call that may enter the core library has a site at its start; a call of the program's own function has none")
library_call_sites()
    val text = "twice(n: int) -> int = n * 2\n\napply(f: (int) -> int) -> int = f(1)\n\nmain() -> int\n    val a = Array.fill(twice(1), 0)\n    twice(a.length()) + apply(twice)\n"
    // `f(1)` may call the library's code, `Array.fill` does; `twice` is the program's own, and
    // `a.length()` is an operation of the language.
    assert_eq(call_sites(text), "probe.avin:3:33\nprobe.avin:6:13\n")

@test("a match, clauses and a binding's pattern name their own place, though no value reaches it")
unreachable_sites()
    val text = "main() -> int\n    val a, b = 1, 2\n    val r = a match\n        0 -> 1\n        _ -> b\n    r + pick(b)\n\npick(n: int) -> int\npick(0) = 1\npick(_) = 2\n"
    assert_eq(sites(text), "no value matched the binding's pattern at probe.avin:2:9\nno arm of the match took the value at probe.avin:3:13\ninteger overflow at probe.avin:6:7\nno clause took the arguments at probe.avin:8:1\n")

@test("every instance of a generic function shares the generic's sites")
generic_sites()
    val text = "keep[T](value: T, n: int) -> T\n    print(s\"${n * 2}\")\n    value\n\nmain() -> int\n    print(keep(\"a\", 1))\n    keep(3, 4)\n"
    assert_eq(sites(text), "integer overflow at probe.avin:2:17\n")

@test("the checks of one operation share a site, and two operations never do")
operation_sites()
    // `byte(n)` of an `int` checks both ends, `/` checks its divisor and its quotient.
    val text = "main() -> int\n    val n: int = 5\n    val b = byte(n)\n    val q = 7 / int(b)\n    val s = q + 1\n    s + 2\n"
    assert_eq(sites(text), "value out of range for byte at probe.avin:3:13\ndivision by zero at probe.avin:4:15\ninteger overflow at probe.avin:4:15\ninteger overflow at probe.avin:5:15\ninteger overflow at probe.avin:6:7\n")
