module dev.avinlang.compiler

import sh.sysl.parsing.{Source, Span, error, source_of, report}
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.env.get
import sysl.fs.{cache_dir, canonicalize, entries, exists, is_dir, make_dir_all, make_temp_dir, pending_name, publish_file, read_text, remove_dir_all, remove_file, write_text}
import sysl.path.parent
import sysl.process.capture
import sysl.slices.sort
import sysl.text.from_utf8_unchecked

/** Where the compiler finds what it compiles against: the standard library's Avin source and the
 * runtime's Sysl package under `root`, which is only ever read, and the tools it runs. What it builds
 * from them, the runtime's archive and the archives of binding shims, goes under `cache`, a directory
 * of the user's own, so an installed toolchain may be read-only. */
struct Toolchain
    root: string
    cache: string
    /** The C compiler that links every program. */
    clang: string
    /** The Sysl compiler, which builds the runtime and the shims of Sysl bindings. */
    sysl: string
    /** What answers for the C libraries' `pkg-config` modules: `pkg-config` itself, or the one a
     * build for another machine asks. */
    pkg_config: string

    library_dir(self) -> string = self.root + "/library"
    prelude_path(self) -> string = self.root + "/library/avin/prelude.avin"
    runtime_dir(self) -> string = self.root + "/runtime"
    /** The runtime's archive as a release ships it, built from the runtime's sources whose key is
     * `key`. */
    prebuilt_runtime(self, key: string) -> string = self.root + "/lib/libavinrt-" + key + ".a"
    /** Where runtime archives built from the runtime's sources are kept, by key. */
    runtime_cache(self) -> string = self.cache + "/runtime"
    /** Where the archives of the runtime with a program's binding shims are kept, by key. */
    shim_cache(self) -> string = self.cache + "/shims"
    /** Where the objects of programs' C units are kept, by key. */
    c_unit_cache(self) -> string = self.cache + "/cunit"
    /** Where the objects of programs' codegen units are kept, by key. */
    unit_cache(self) -> string = self.cache + "/units"
end Toolchain

/** A toolchain rooted at `root`, if `root` holds the library and the runtime, building into the
 * user's cache. */
toolchain_at(root: string) -> Option[Toolchain] = toolchain_in(root, toolchain_cache(get("AVIN_CACHE"), cache_dir(), get("TMPDIR")))

/** A toolchain rooted at `root` that builds into `cache`, if `root` holds the library and the
 * runtime. */
toolchain_in(root: string, cache: string) -> Option[Toolchain]
    val tc = Toolchain(root, cache, "clang", "sysl", "pkg-config")
    if exists(tc.prelude_path()) && is_dir(tc.runtime_dir()) then Some(tc) else None

/** Where this compiler keeps what it builds from a toolchain: `named` (`AVIN_CACHE`) when it is set,
 * and otherwise `avin/<version>` in the user's cache directory, `machine` (`~/Library/Caches` on
 * macOS, `$XDG_CACHE_HOME` or `~/.cache` elsewhere), or in the temporary directory `temp` (`TMPDIR`)
 * on a machine with none. The version keeps one release's archives from another's. */
toolchain_cache(named: Option[string], machine: Option[string], temp: Option[string]) -> string
    if named is Some(dir)
        if dir != "" then return dir
    val base = machine match
        Some(d) -> d
        None -> temp.unwrap_or("/tmp")
    (if base.ends_with("/") then base else base + "/") + "avin/" + Version

/** The toolchain an installed compiler finds, given the `AVIN_ROOT` it was run with and the path of
 * its own executable. `AVIN_ROOT` names one, for working on the library or the runtime; otherwise it
 * is `share/avin` in the prefix the executable is installed in, `<prefix>/bin/avin`, through any
 * symbolic links to the executable, or a source checkout's root when the executable is the
 * checkout's `compiler/avin`. */
locate_toolchain(avin_root: Option[string], exe: Option[string], cache: string) -> Option[Toolchain]
    if avin_root is Some(root)
        if root != "" then return toolchain_in(root, cache)
    val named = exe match
        Some(e) -> e
        None -> return None
    val real = canonicalize(named).unwrap_or(named)
    val above = parent(parent(real).unwrap_or("/")).unwrap_or("/")
    if toolchain_in(above + "/share/avin", cache) is Some(tc) then return Some(tc)
    toolchain_in(above, cache)

/** Why a tool could not be started, what it is for and how to install it. */
missing_tool(tool: string, error: string) -> string
    val sysl = "it builds the runtime and the Sysl bindings a program reaches; install it with `brew install sysl-lang/tap/sysl`"
    val clang = "it links every Avin program; install Xcode's command-line tools with `xcode-select --install`"
    s"cannot run `$tool` ($error): ${if tool.ends_with("sysl") then sysl else clang}"

struct Compilation
    /** Every diagnostic, rendered; empty when compilation succeeded. */
    diagnostics: string
    llvm: Option[string]
    /** For a program with Sysl bindings, the archive it links in place of the runtime's: the runtime
     * with the bindings' shims, which Sysl has checked. */
    archive: Option[string]
    /** The program's tests, in the order they are declared. */
    tests: Buf[TestEntry]
    /** What the link adds for the program's C libraries: its C unit's object, when it has C
     * bindings, then the libraries' link flags. */
    c_link: Buf[string]

/** A test a program holds: its name, and the file and line of its `@test` function; what its
 * annotation says about running it; and the names of its module's hooks, empty for one the module
 * does not declare. */
struct TestEntry
    name: string
    file: string
    line: usize
    module_name: string
    /** For a test that passes by trapping, the text the run must print, or "" for any trap. */
    should_trap: Option[string]
    /** For a test that is checked and not run, the reason. */
    ignore: Option[string]
    /** The test's own limit in seconds, 0 for none, in place of the run's. */
    timeout: Option[int]
    setup: string
    teardown: string
    setup_all: string
    teardown_all: string

/** A source file of a program, with the module its place under the program's root directory gives
 * it. A program of one file has no root directory: its `module_name` is `None`, and its header, if it has
 * one, names its module. A file of a package the program depends on is a `dependency`: its tests are
 * not the program's. */
struct ProgramFile
    src: Source
    module_name: Option[string]
    dependency: bool
    /** The imports the file may not make, which its package's features gate. */
    fences: Buf[Fence]
    /** The name of the package the file belongs to, or "" in a program with no manifest. */
    package: string

/** A program of one file. */
single_file(src: Source) -> Buf[ProgramFile]
    var files: Buf[ProgramFile] = buf()
    files.push(ProgramFile(src, None, false, buf(), ""))
    files

/** The files of the program rooted at the directory `root`: every `.avin` and `.lavin` file under it, in order of
 * path, each in the module its directory's path from the root names, `a/b` being `a.b`. The files of
 * the root directory itself are the root module, which has no name, and come last. Directories whose
 * names begin with `.` are passed over, and so is a directory below the root holding an `avin.hocon`,
 * which is another package, and a package's own `vendor` directory, which holds its dependencies. */
program_files(root: string) -> Result[Buf[ProgramFile], string] = package_files(root, false)

/** The core library's files: its modules in the directory `library`, read as a dependency's are, so
 * its `tests` directory, the program that tests it, is not among them. */
library_files(library: string) -> Result[Buf[ProgramFile], string] = package_files(library, true)

/** The files of the package tree at `root`, as `program_files` finds them. With `dependency`, those a
 * package depending on it compiles: its modules, without its root directory's files and its `tests`
 * directory, which are its own. */
package_files(root: string, dependency: bool) -> Result[Buf[ProgramFile], string] = package_files_skipping(root, dependency, buf())

/** The files of the package tree at `root`, as `package_files` finds them, without the modules `skip`
 * names and those under them. */
package_files_skipping(root: string, dependency: bool, skip: Buf[string]) -> Result[Buf[ProgramFile], string]
    var modules: Buf[ProgramFile] = buf()
    var root_files: Buf[ProgramFile] = buf()
    collect_files(root, "", "", dependency, skip, &modules, &root_files)?
    if !dependency
        for f in root_files
            modules.push(f)
    Ok(modules)

private collect_files(root: string, rel: string, module_name: string, dependency: bool, skip: Buf[string], modules: *Buf[ProgramFile], root_files: *Buf[ProgramFile]) -> Result[unit, string]
    val dir = if rel == "" then root else root + "/" + rel
    val names = entries(dir).map_err(e -> s"$dir: ${e.to_string()}")?
    val sorted = names.view()
    sort(sorted)
    for name in sorted
        if name.starts_with(".") then continue
        val child = if rel == "" then name else rel + "/" + name
        val full = root + "/" + child
        if is_dir(full)
            if exists(full + "/" + ManifestName) then continue
            if dependency && rel == "" && name == "tests" then continue
            // A package's `vendor/` holds the packages it depends on, not modules of its own.
            if rel == "" && name == VendorName && exists(root + "/" + ManifestName) then continue
            val inner = qualified(module_name, name)
            var skipped = false
            for s in skip
                if s == inner then skipped = true
            if skipped then continue
            collect_files(root, child, inner, dependency, skip, modules, root_files)?
        elif is_source_name(name)
            if dependency && rel == "" then continue
            val text = read_text(full).map_err(e -> s"$full: ${e.to_string()}")?
            val file = ProgramFile(source_of(full, text), Some(module_name), dependency, buf(), "")
            if rel == "" then root_files.push(file) else modules.push(file)
    Ok(())

/** Compiles a program of one file to LLVM IR against the toolchain's library. */
compile(tc: Toolchain, src: Source) -> Compilation = compile_files(tc, single_file(src))

/** Compiles a program to LLVM IR against the toolchain's library, and builds the shims of its Sysl
 * bindings, so a binding Sysl rejects is reported as the program's error. */
compile_files(tc: Toolchain, files: Buf[ProgramFile]) -> Compilation = compile_program(tc, files, false, buf(), buf())

/** Compiles a program as `compile_files` does, its bindings reaching the Sysl packages `sysl` as well
 * as Sysl's standard library and its C bindings the C libraries `c`; with `testing`, into a program
 * that runs one of its tests in each process rather than `main`, which it then need not have. */
compile_program(tc: Toolchain, files: Buf[ProgramFile], testing: bool, sysl: Buf[SyslPackage], c: Buf[CLibrary]) -> Compilation
    val lowered = lower_units(tc, files, testing, c) match
        Ok(l) -> l
        Err(diagnostics) -> return Compilation(diagnostics, None, None, buf(), buf())
    var archive: Option[string] = None
    if lowered.program.bindings.len() > 0 || lowered.program.handles.len() > 0
        ensure_shims(tc, lowered.program.bindings, lowered.program.handles, lowered.units, sysl) match
            Ok(a) -> archive = Some(a)
            Err(diagnostics) -> return Compilation(diagnostics, None, None, buf(), buf())
    Compilation("", Some(emit_llvm(lowered.program)), archive, lowered.tests, lowered.c_link)

/** Compiles a program of one file as far as MIR, or renders its diagnostics. */
lower_source(tc: Toolchain, src: Source) -> Result[MirProgram, string] = lower_files(tc, single_file(src))

/** Compiles a program as far as MIR against the toolchain's library, or renders its diagnostics. */
lower_files(tc: Toolchain, files: Buf[ProgramFile]) -> Result[MirProgram, string] = lower_units(tc, files, false, buf()) match
    Ok(lowered) -> Ok(lowered.program)
    Err(diagnostics) -> Err(diagnostics)

/** A program as MIR, with the units it was compiled from, which place its diagnostics. */
private struct Lowered
    program: MirProgram
    units: Buf[SourceUnit]
    tests: Buf[TestEntry]
    c_link: Buf[string]

/** A file of the standard library, found before it is read: its path and the module its directory
 * names. */
struct LibraryFile
    path: string
    module_name: string

/** Every file of the standard library in the directory `library`, unread, in the order the library's
 * modules are compiled in: the order of their paths, as `library_files` finds them. */
library_index(library: string) -> Result[Buf[LibraryFile], string]
    var out: Buf[LibraryFile] = buf()
    index_files(library, "", "", &out)?
    Ok(out)

private index_files(root: string, rel: string, module_name: string, out: *Buf[LibraryFile]) -> Result[unit, string]
    val dir = if rel == "" then root else root + "/" + rel
    val names = entries(dir).map_err(e -> s"$dir: ${e.to_string()}")?
    val sorted = names.view()
    sort(sorted)
    for name in sorted
        if name.starts_with(".") then continue
        val child = if rel == "" then name else rel + "/" + name
        val full = root + "/" + child
        if is_dir(full)
            if exists(full + "/" + ManifestName) then continue
            if rel == "" && name == "tests" then continue
            index_files(root, child, qualified(module_name, name), out)?
        elif is_source_name(name) && rel != ""
            out.push(LibraryFile(full, module_name))
    Ok(())

/** The units of a compilation, each parsed and placed in its module: the standard library's that it
 * reads, first, then the program's. `library` of them are the library's. With `broken`, some unit's
 * report holds an error, and the units are not to be checked. */
struct LoadedUnits
    units: Buf[SourceUnit]
    library: usize
    root_module: string
    broken: bool

/** Parses a program's `files` and the standard library's modules at `library` it reads: the prelude,
 * `avin`, and every library module an import names, of the program's files or of a library module
 * read, to the end. A library module nothing imports is not read. With `whole_library`, every module
 * of the library is read, as when a file of the library is itself the one analyzed. `held` gives each
 * file's source as it is to be read, which an editor's text may stand in for. An import of a module
 * under `avin` the library does not have is an error at the import; with the whole library read, as
 * for a completion whose import is half written, the check reports such an import itself. */
load_units(library: string, files: Buf[ProgramFile], whole_library: bool, held: Source -> Source) -> Result[LoadedUnits, string]
    val index = library_index(library)?
    var modules: Map[string, bool] = map()
    for f in index
        modules.put(f.module_name, true)
    // Each library file parsed so far, by its place in the index.
    var parsed_library: Map[usize, SourceUnit] = map()
    var wanted: Map[string, bool] = map()
    var queue: Buf[string] = buf()
    want_module(&wanted, &queue, CoreModule)
    if whole_library
        for f in index
            want_module(&wanted, &queue, f.module_name)
    var program: Buf[SourceUnit] = buf()
    var root_module = ""
    var broken = false
    for file in files
        var parsed = parse(held(file.src))
        file.module_name match
            Some(m) -> place_file(&parsed, m, false)
            None -> root_module = parsed.file.module_name
        if parsed.report.has_errors() then broken = true
        want_imports(parsed.file, modules, &wanted, &queue)
        // A `main` taking the program's arguments is given them by `avin.process.args`, which the
        // program need not import.
        for item in parsed.file.items
            if item is FunctionItem(f)
                if f.name == "main" && f.params.len() > 0 then want_module(&wanted, &queue, ProcessModule)
        program.push(SourceUnit(parsed.source, parsed.file, parsed.report))
    var next = 0usize
    while next < queue.len()
        val module_name = queue[next]
        next += 1
        for i in 0..<index.len()
            if index[i].module_name != module_name then continue
            val path = index[i].path
            val text = read_text(path).map_err(e -> s"$path: ${e.to_string()}")?
            var parsed = parse(held(source_of(path, text)))
            place_file(&parsed, module_name, true)
            if parsed.report.has_errors() then broken = true
            want_imports(parsed.file, modules, &wanted, &queue)
            parsed_library.put(i, SourceUnit(parsed.source, parsed.file, parsed.report))
    var units: Buf[SourceUnit] = buf()
    for i in 0..<index.len()
        if parsed_library.get(i) is Some(u) then units.push(u)
    val library_units = units.len()
    for u in program
        units.push(u)
    for k in 0..<units.len()
        var report = units[k].report
        for i in units[k].file.imports
            if whole_library then break
            if missing_library_module(i.path, modules, units) is Some(message)
                report.add(error(import_path_span(i), message))
                broken = true
        units[k].report = report
    // An import a feature's gate does not allow is refused whichever features are on, so a module that
    // is off is told about by name rather than as missing.
    for j in 0..<files.len()
        val fences = files[j].fences
        if fences.len() == 0 then continue
        val k = library_units + j
        var report = units[k].report
        for i in units[k].file.imports
            for fence in fences
                if i.path == fence.prefix || i.path.starts_with(fence.prefix + ".")
                    report.add(error(import_path_span(i), fence.message))
                    broken = true
                    break
        units[k].report = report
    Ok(LoadedUnits(units, library_units, root_module, broken))

// The place of the path an import names, without its alias.
private import_path_span(i: Import) -> Span = i.module_span.to(i.name_span)

/** The library's module that gives a program its arguments. */
const ProcessModule: string = "avin.process"

/** The library's module of actors, which an actor declaration's behaviour is made with. */
const ActorsModule: string = "avin.actors"

private want_module(wanted:*Map[string, bool], queue: *Buf[string], module_name: string)
    if wanted.get(module_name) is Some(_) then return
    wanted.put(module_name, true)
    queue.push(module_name)

// The library modules a file's imports name: the module an import names whole, `import avin.fs`, or
// the module of the declaration it names, `import avin.fs.readText`.
private want_imports(file: SourceFile, modules: Map[string, bool], wanted: *Map[string, bool], queue: *Buf[string])
    for i in file.imports
        if !is_library_module_name(i.path) then continue
        if modules.get(i.path) is Some(_) then want_module(wanted, queue, i.path)
        val owner = enclosing_module(i.path)
        if modules.get(owner) is Some(_) then want_module(wanted, queue, owner)
    // An actor declaration makes a behaviour of `avin.actors`, which its file need not import.
    if file.actors.len() > 0 then want_module(wanted, queue, ActorsModule)

private is_library_module_name(name: string) -> bool = name == CoreModule || name.starts_with(CoreModule + ".")

// `a.b` for `a.b.c`, and "" for a name with no dot.
private enclosing_module(path: string) -> string
    var dot: Option[usize] = None
    for k in 0..<path.bytes.len
        if path.bytes[k] == u8('.') then dot = Some(k)
    dot match
        Some(k) -> path[0..<k]
        None -> ""

// The error for an import under `avin` that names neither a module of the library nor a declaration
// of one: the module missing is the first part of the path below the deepest part the library has
// modules in, whose modules it lists. A missing name in a module that would be a type's,
// `avin.fs.Fil`, is left to the check, which says the module declares no such name.
private missing_library_module(path: string, modules: Map[string, bool], units: Buf[SourceUnit]) -> Option[string]
    if !is_library_module_name(path) || modules.get(path) is Some(_) then return None
    val owner = enclosing_module(path)
    val name = path[owner.bytes.len + 1..]
    val owner_is_module = modules.get(owner) is Some(_)
    if owner_is_module
        if declares(units, owner, name) then return None
        if is_capitalized(name) then return None
    var deepest = path
    while deepest != CoreModule && !has_modules_under(modules, deepest)
        deepest = enclosing_module(deepest)
    var missing = path
    if deepest != path
        val rest = path[deepest.bytes.len + 1..]
        var segment = rest
        for k in 0..<rest.bytes.len
            if rest.bytes[k] == u8('.')
                segment = rest[0..<k]
                break
        missing = deepest + "." + segment
    val under = modules_under(modules, deepest)
    // A module with no modules under it is told about by the check: it declares no such name.
    if under == "" then return None
    Some(s"the standard library has no module `$missing`; the modules under `$deepest` are $under")

// Whether a unit of module `module_name` declares `name`, a top-level declaration or a variant.
private declares(units: Buf[SourceUnit], module_name: string, name: string) -> bool
    for u in units
        if u.file.module_name != module_name then continue
        for item in u.file.items
            if item_name(item) == name then return true
            if item is DataItem(d)
                for v in d.variants
                    if v.name == name then return true
    false

// Whether the library has a module `prefix` or any under it.
private has_modules_under(modules: Map[string, bool], prefix: string) -> bool
    for (m, _) in modules
        if m == prefix || m.starts_with(prefix + ".") then return true
    false

// The modules one level under `prefix`, `prefix.x`, each quoted, in order, joined by commas; a
// directory holding only modules further down counts as one.
private modules_under(modules: Map[string, bool], prefix: string) -> string
    var seen: Map[string, bool] = map()
    var names: Buf[string] = buf()
    for (m, _) in modules
        if !m.starts_with(prefix + ".") then continue
        val rest = m[prefix.bytes.len + 1..]
        var segment = rest
        for k in 0..<rest.bytes.len
            if rest.bytes[k] == u8('.')
                segment = rest[0..<k]
                break
        if seen.get(segment) is Some(_) then continue
        seen.put(segment, true)
        names.push(prefix + "." + segment)
    val sorted = names.view()
    sort(sorted)
    var out = ""
    for n in sorted
        out = out + (if out == "" then "" else ", ") + "`" + n + "`"
    out

// The library's modules a compilation reads are the prelude and those imported, and every module in
// it is the core library's, `avin` or under it; the program's own modules may not be. A program's
// C unit is built between checking and lowering, which converts at the widths it measured.
private lower_units(tc: Toolchain, files: Buf[ProgramFile], testing: bool, c: Buf[CLibrary]) -> Result[Lowered, string]
    val loaded = load_units(tc.library_dir(), files, false, src -> src).map_err(message -> s"avin: $message\n")?
    val units = loaded.units
    val root_module = loaded.root_module
    // A file with syntax errors is not checked: its tree is a recovery, and checking it would
    // report the recovery rather than the program. A file in the wrong module is not checked either,
    // since every name it declares would be reported in a module it does not mean.
    if loaded.broken
        var diagnostics = ""
        for u in units
            if u.report.has_errors() then diagnostics = diagnostics + u.report.render(u.src)
        return Err(diagnostics)
    val checked = check_program(units, root_module, testing)
    if checked.has_errors() then return Err(checked.render())
    checked.program match
        Some(checked_program) ->
            // A package's dependencies and the core library are compiled into its program, and their
            // tests are theirs.
            var program = checked_program
            var own: Buf[TestCase] = buf()
            for t in program.tests
                val unit = program.symbols[t.symbol].unit
                if unit >= loaded.library && !files[unit - loaded.library].dependency then own.push(t)
            program.tests = own
            var tests: Buf[TestEntry] = buf()
            for t in program.tests
                val f = program.symbols[t.symbol]
                val src = program.sources[f.unit]
                tests.push(TestEntry(t.name, src.name, src.locate(f.decl.name_span.start).line, t.module_name, t.should_trap, t.ignore, t.timeout, hook_name(program, t.setup), hook_name(program, t.teardown), hook_name(program, t.setup_all), hook_name(program, t.teardown_all)))
            val parts = CUnitParts(c_unit_bindings(program, files, loaded.library), c_unit_handles(program, files, loaded.library), c_unit_enums(program, files, loaded.library), c_unit_constants(program, files, loaded.library), c_unit_structs(program, files, loaded.library), c_unit_values(program, files, loaded.library))
            val c_unit = ensure_c_unit_of(tc, parts, c, program.sources)?
            program.c_measures = c_unit.measures
            program.c_values = c_unit.values
            var c_link: Buf[string] = buf()
            if c_unit.object is Some(o) then c_link.push(o)
            for flag in c_unit.link
                c_link.push(flag)
            Ok(Lowered(lower_program(program), checked.units, tests, c_link))
        None -> Err("avin: checking produced no program\n")

// The name of a test hook, or "" for none.
private hook_name(program: TProgram, hook: Option[usize]) -> string = hook match
    Some(id) -> program.symbols[id].name
    None -> ""

// A file of a program tree belongs to the module its directory names, and its header, which every
// file outside the root directory has, says so. The root directory's files are the root module,
// which has no name, so they have none.
place_file(parsed: *Parsed, module_name: string, in_library: bool)
    val header = parsed.file.module_name
    val at = parsed.file.module_span
    val core = module_name == CoreModule || module_name.starts_with(CoreModule + ".")
    if !valid_module_name(module_name)
        parsed.report.add(error(Span(0, 0), s"`$module_name` is not a module name: each directory of a program is named as a name is, a letter or `_` and then letters, digits and `_` of any script, in Unicode Normalization Form C"))
    elif in_library && !core
        parsed.report.add(error(Span(0, 0), s"the standard library's modules are `avin` and the modules under it, not `$module_name`"))
    elif !in_library && core
        parsed.report.add(error(if header == "" then Span(0, 0) else at, s"the module `$module_name` is reserved for the standard library"))
    elif module_name == "" && header != ""
        parsed.report.add(error(at, s"this file is in the program's root directory, whose module has no name, so it has no `module` header"))
    elif module_name != "" && header == ""
        parsed.report.add(error(Span(0, 0), s"this file is in module `$module_name`, so it begins with `module $module_name`"))
    elif header != module_name
        parsed.report.add(error(at, s"the header names module `$header`, but the file is in module `$module_name`"))
    parsed.file.module_name = module_name

/** Whether `name` names a module: names joined by dots, each spelled as a name is and in NFC, or
 * the empty name of a program's root module. */
valid_module_name(name: string) -> bool
    if name == "" then return true
    if !is_nfc(name) then return false
    var from = 0usize
    for i in 0..name.bytes.len
        if i == name.bytes.len || name.bytes[i] == u8('.')
            if !spelled_as_name(name[from..<i]) then return false
            from = i + 1
    true

/** The runtime library archive for the runtime's sources as they are: the one a release ships beside
 * them, or else one built from the runtime's Sysl package into the toolchain's cache. Both are named
 * by a key over the sources, so an edited runtime is never linked from an archive of other sources. A
 * build is written under a temporary name and published by rename, so builds running at the same time
 * never see a partial archive. */
ensure_runtime(tc: Toolchain) -> Result[string, string]
    val key = runtime_key(tc)
    val shipped = tc.prebuilt_runtime(key)
    if exists(shipped) then return Ok(shipped)
    val archive = tc.runtime_cache() + "/libavinrt-" + key + ".a"
    if exists(archive) then return Ok(archive)
    make_dir_all(tc.runtime_cache()).map_err(e -> s"${tc.runtime_cache()}: ${e.to_string()}")?
    val pending = pending_name(archive)
    defer _ = remove_file(pending)
    defer _ = remove_file(pending + ".h")
    val result = capture(tc.sysl, ["build-c", tc.runtime_dir(), "-o", pending], stderr = true, timeout = 300000).map_err(e -> missing_tool(tc.sysl, e.to_string()))?
    if !result.status.ok()
        return Err("runtime build failed: " + result.status.to_string() + "\n" + result.err.unwrap_or("") + result.text)
    publish_file(pending, archive).map_err(e -> e.to_string())?
    Ok(archive)

/** The key a runtime archive is named by: the compiler's version and the runtime's sources. */
runtime_key(tc: Toolchain) -> string = content_key("avin " + Version + "\n" + runtime_fingerprint(tc))

/** Links LLVM IR with the runtime into an executable at `output`: with `shims`, the runtime with a
 * program's binding shims, when there is one, together with the C libraries its Sysl packages need,
 * and otherwise the runtime's own archive; then `c_link`, the program's C unit and the flags of its
 * C libraries. The IR is compiled as `units` codegen units at once (`codegen_units.sysl`), or as many
 * as `codegen_units` answers where `units` is 0. The executable is written under a temporary name and
 * published by rename, so a failed link leaves any previous output in place. */
link(tc: Toolchain, llvm: string, shims: Option[string], output: string, optimization: string, c_link: Buf[string], units: int = 0) -> Result[unit, string]
    var libraries: Buf[string] = buf()
    val archive = shims match
        Some(a) ->
            val needs = link_needs_file(a)
            if exists(needs)
                val listed = read_text(needs).map_err(e -> s"$needs: ${e.to_string()}")?
                libraries = link_flags(listed)?
            a
        None -> ensure_runtime(tc)?
    val dir = make_temp_dir("avin-link").map_err(e -> e.to_string())?
    defer _ = remove_dir_all(dir)
    val pending = pending_name(output)
    defer _ = remove_file(pending)
    var args: Buf[string] = buf()
    val n = if units > 0 then units else codegen_units(llvm.len)
    val parts = if n >= 2 then split_module(llvm, n, optimization != "-O0") else None
    parts match
        Some(texts) ->
            val compiled = compile_units(tc.clang, texts, dir, optimization, tc.unit_cache())?
            for o in compiled.objects
                args.push(o)
        None ->
            val ir = dir + "/program.ll"
            write_text(ir, llvm).map_err(e -> e.to_string())?
            for a in ["-x", "ir", optimization, "-Wno-override-module", ir, "-x", "none"]
                args.push(a)
    args.push(archive)
    for flag in c_link
        args.push(flag)
    for flag in libraries
        args.push(flag)
    for a in ["-lm", "-o", pending]
        args.push(a)
    val result = capture(tc.clang, args.view(), stderr = true, timeout = 120000).map_err(e -> missing_tool(tc.clang, e.to_string()))?
    if !result.status.ok()
        return Err("clang failed: " + result.status.to_string() + "\n" + result.err.unwrap_or("") + result.text)
    publish_file(pending, output).map_err(e -> e.to_string())?
    Ok(())
