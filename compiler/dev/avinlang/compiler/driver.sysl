module dev.avinlang.compiler

import sh.sysl.parsing.{Source, Span, error, source_of, report}
import sysl.buf.{Buf, buf}
import sysl.env.get
import sysl.fs.{cache_dir, canonicalize, entries, exists, is_dir, make_dir_all, make_temp_dir, pending_name, publish_file, read_text, remove_dir_all, remove_file, write_text}
import sysl.path.parent
import sysl.process.capture
import sysl.slices.sort

/** Where the compiler finds what it compiles against: the standard library's Avin source and the
 * runtime's Sysl package under `root`, which is only ever read, and the tools it runs. What it builds
 * from them, the runtime's archive and the archives of binding shims, goes under `cache`, a directory
 * of the user's own, so an installed toolchain may be read-only. */
struct Toolchain
    root: string
    cache: string
    /** The C compiler that links every program. */
    clang: string
    /** The Sysl compiler, which builds the runtime and the shims of Sysl bindings. */
    sysl: string

    library_dir(self) -> string = self.root + "/library"
    prelude_path(self) -> string = self.root + "/library/avin/prelude.avin"
    runtime_dir(self) -> string = self.root + "/runtime"
    /** The runtime's archive as a release ships it, built from the runtime's sources whose key is
     * `key`. */
    prebuilt_runtime(self, key: string) -> string = self.root + "/lib/libavinrt-" + key + ".a"
    /** Where runtime archives built from the runtime's sources are kept, by key. */
    runtime_cache(self) -> string = self.cache + "/runtime"
    /** Where the archives of the runtime with a program's binding shims are kept, by key. */
    shim_cache(self) -> string = self.cache + "/shims"
end Toolchain

/** A toolchain rooted at `root`, if `root` holds the library and the runtime, building into the
 * user's cache. */
toolchain_at(root: string) -> Option[Toolchain] = toolchain_in(root, toolchain_cache(get("AVIN_CACHE"), cache_dir(), get("TMPDIR")))

/** A toolchain rooted at `root` that builds into `cache`, if `root` holds the library and the
 * runtime. */
toolchain_in(root: string, cache: string) -> Option[Toolchain]
    val tc = Toolchain(root, cache, "clang", "sysl")
    if exists(tc.prelude_path()) && is_dir(tc.runtime_dir()) then Some(tc) else None

/** Where this compiler keeps what it builds from a toolchain: `named` (`AVIN_CACHE`) when it is set,
 * and otherwise `avin/<version>` in the user's cache directory, `machine` (`~/Library/Caches` on
 * macOS, `$XDG_CACHE_HOME` or `~/.cache` elsewhere), or in the temporary directory `temp` (`TMPDIR`)
 * on a machine with none. The version keeps one release's archives from another's. */
toolchain_cache(named: Option[string], machine: Option[string], temp: Option[string]) -> string
    if named is Some(dir)
        if dir != "" then return dir
    val base = machine match
        Some(d) -> d
        None -> temp.unwrap_or("/tmp")
    (if base.ends_with("/") then base else base + "/") + "avin/" + Version

/** The toolchain an installed compiler finds, given the `AVIN_ROOT` it was run with and the path of
 * its own executable. `AVIN_ROOT` names one, for working on the library or the runtime; otherwise it
 * is `share/avin` in the prefix the executable is installed in, `<prefix>/bin/avin`, through any
 * symbolic links to the executable, or a source checkout's root when the executable is the
 * checkout's `compiler/avin`. */
locate_toolchain(avin_root: Option[string], exe: Option[string], cache: string) -> Option[Toolchain]
    if avin_root is Some(root)
        if root != "" then return toolchain_in(root, cache)
    val named = exe match
        Some(e) -> e
        None -> return None
    val real = canonicalize(named).unwrap_or(named)
    val above = parent(parent(real).unwrap_or("/")).unwrap_or("/")
    if toolchain_in(above + "/share/avin", cache) is Some(tc) then return Some(tc)
    toolchain_in(above, cache)

/** Why a tool could not be started, what it is for and how to install it. */
missing_tool(tool: string, error: string) -> string
    val sysl = "it builds the runtime and the Sysl bindings a program reaches; install it with `brew install sysl-lang/tap/sysl`"
    val clang = "it links every Avin program; install Xcode's command-line tools with `xcode-select --install`"
    s"cannot run `$tool` ($error): ${if tool.ends_with("sysl") then sysl else clang}"

struct Compilation
    /** Every diagnostic, rendered; empty when compilation succeeded. */
    diagnostics: string
    llvm: Option[string]
    /** For a program with Sysl bindings, the archive it links in place of the runtime's: the runtime
     * with the bindings' shims, which Sysl has checked. */
    archive: Option[string]
    /** The program's tests, in the order they are declared. */
    tests: Buf[TestEntry]

/** A test a program holds: its name, and the file and line of its `@test` function; what its
 * annotation says about running it; and the names of its module's hooks, empty for one the module
 * does not declare. */
struct TestEntry
    name: string
    file: string
    line: usize
    module_name: string
    /** For a test that passes by trapping, the text the run must print, or "" for any trap. */
    should_trap: Option[string]
    /** For a test that is checked and not run, the reason. */
    ignore: Option[string]
    /** The test's own limit in seconds, 0 for none, in place of the run's. */
    timeout: Option[int]
    setup: string
    teardown: string
    setup_all: string
    teardown_all: string

/** A source file of a program, with the module its place under the program's root directory gives
 * it. A program of one file has no root directory: its `module_name` is `None`, and its header, if it has
 * one, names its module. A file of a package the program depends on is a `dependency`: its tests are
 * not the program's. */
struct ProgramFile
    src: Source
    module_name: Option[string]
    dependency: bool

/** A program of one file. */
single_file(src: Source) -> Buf[ProgramFile]
    var files: Buf[ProgramFile] = buf()
    files.push(ProgramFile(src, None, false))
    files

/** The files of the program rooted at the directory `root`: every `.avin` and `.lavin` file under it, in order of
 * path, each in the module its directory's path from the root names, `a/b` being `a.b`. The files of
 * the root directory itself are the root module, which has no name, and come last. Directories whose
 * names begin with `.` are passed over, and so is a directory below the root holding an `avin.hocon`,
 * which is another package, and a package's own `vendor` directory, which holds its dependencies. */
program_files(root: string) -> Result[Buf[ProgramFile], string] = package_files(root, false)

/** The core library's files: its modules in the directory `library`, read as a dependency's are, so
 * its `tests` directory, the program that tests it, is not among them. */
library_files(library: string) -> Result[Buf[ProgramFile], string] = package_files(library, true)

/** The files of the package tree at `root`, as `program_files` finds them. With `dependency`, those a
 * package depending on it compiles: its modules, without its root directory's files and its `tests`
 * directory, which are its own. */
package_files(root: string, dependency: bool) -> Result[Buf[ProgramFile], string]
    var modules: Buf[ProgramFile] = buf()
    var root_files: Buf[ProgramFile] = buf()
    collect_files(root, "", "", dependency, &modules, &root_files)?
    if !dependency
        for f in root_files
            modules.push(f)
    Ok(modules)

private collect_files(root: string, rel: string, module_name: string, dependency: bool, modules: *Buf[ProgramFile], root_files: *Buf[ProgramFile]) -> Result[unit, string]
    val dir = if rel == "" then root else root + "/" + rel
    val names = entries(dir).map_err(e -> s"$dir: ${e.to_string()}")?
    val sorted = names.view()
    sort(sorted)
    for name in sorted
        if name.starts_with(".") then continue
        val child = if rel == "" then name else rel + "/" + name
        val full = root + "/" + child
        if is_dir(full)
            if exists(full + "/" + ManifestName) then continue
            if dependency && rel == "" && name == "tests" then continue
            // A package's `vendor/` holds the packages it depends on, not modules of its own.
            if rel == "" && name == VendorName && exists(root + "/" + ManifestName) then continue
            collect_files(root, child, qualified(module_name, name), dependency, modules, root_files)?
        elif is_source_name(name)
            if dependency && rel == "" then continue
            val text = read_text(full).map_err(e -> s"$full: ${e.to_string()}")?
            val file = ProgramFile(source_of(full, text), Some(module_name), dependency)
            if rel == "" then root_files.push(file) else modules.push(file)
    Ok(())

/** Compiles a program of one file to LLVM IR against the toolchain's library. */
compile(tc: Toolchain, src: Source) -> Compilation = compile_files(tc, single_file(src))

/** Compiles a program to LLVM IR against the toolchain's library, and builds the shims of its Sysl
 * bindings, so a binding Sysl rejects is reported as the program's error. */
compile_files(tc: Toolchain, files: Buf[ProgramFile]) -> Compilation = compile_program(tc, files, false)

/** Compiles a program as `compile_files` does; with `testing`, into a program that runs one of its
 * tests in each process rather than `main`, which it then need not have. */
compile_program(tc: Toolchain, files: Buf[ProgramFile], testing: bool) -> Compilation
    val lowered = lower_units(tc, files, testing) match
        Ok(l) -> l
        Err(diagnostics) -> return Compilation(diagnostics, None, None, buf())
    var archive: Option[string] = None
    if lowered.program.bindings.len() > 0
        ensure_shims(tc, lowered.program.bindings, lowered.units) match
            Ok(a) -> archive = Some(a)
            Err(diagnostics) -> return Compilation(diagnostics, None, None, buf())
    Compilation("", Some(emit_llvm(lowered.program)), archive, lowered.tests)

/** Compiles a program of one file as far as MIR, or renders its diagnostics. */
lower_source(tc: Toolchain, src: Source) -> Result[MirProgram, string] = lower_files(tc, single_file(src))

/** Compiles a program as far as MIR against the toolchain's library, or renders its diagnostics. */
lower_files(tc: Toolchain, files: Buf[ProgramFile]) -> Result[MirProgram, string] = lower_units(tc, files, false) match
    Ok(lowered) -> Ok(lowered.program)
    Err(diagnostics) -> Err(diagnostics)

/** A program as MIR, with the units it was compiled from, which place its diagnostics. */
private struct Lowered
    program: MirProgram
    units: Buf[SourceUnit]
    tests: Buf[TestEntry]

// The library's directory is loaded as a program tree is, and every module in it is the core
// library's, `avin` or under it; the program's own modules may not be.
private lower_units(tc: Toolchain, files: Buf[ProgramFile], testing: bool) -> Result[Lowered, string]
    val library = library_files(tc.library_dir()).map_err(message -> s"avin: $message\n")?
    var units: Buf[SourceUnit] = buf()
    var diagnostics = ""
    var root_module = ""
    for i in 0..<library.len() + files.len()
        val in_library = i < library.len()
        val file = if in_library then library[i] else files[i - library.len()]
        var parsed = parse(file.src)
        file.module_name match
            Some(m) -> place_file(&parsed, m, in_library)
            None -> root_module = parsed.file.module_name
        if parsed.report.has_errors() then diagnostics = diagnostics + parsed.report.render(parsed.source)
        units.push(SourceUnit(parsed.source, parsed.file, parsed.report))
    // A file with syntax errors is not checked: its tree is a recovery, and checking it would
    // report the recovery rather than the program. A file in the wrong module is not checked either,
    // since every name it declares would be reported in a module it does not mean.
    if diagnostics != "" then return Err(diagnostics)
    val checked = check_program(units, root_module, testing)
    if checked.has_errors() then return Err(checked.render())
    checked.program match
        Some(checked_program) ->
            // A package's dependencies and the core library are compiled into its program, and their
            // tests are theirs.
            var program = checked_program
            var own: Buf[TestCase] = buf()
            for t in program.tests
                val unit = program.symbols[t.symbol].unit
                if unit >= library.len() && !files[unit - library.len()].dependency then own.push(t)
            program.tests = own
            var tests: Buf[TestEntry] = buf()
            for t in program.tests
                val f = program.symbols[t.symbol]
                val src = program.sources[f.unit]
                tests.push(TestEntry(t.name, src.name, src.locate(f.decl.name_span.start).line, t.module_name, t.should_trap, t.ignore, t.timeout, hook_name(program, t.setup), hook_name(program, t.teardown), hook_name(program, t.setup_all), hook_name(program, t.teardown_all)))
            Ok(Lowered(lower_program(program), checked.units, tests))
        None -> Err("avin: checking produced no program\n")

// The name of a test hook, or "" for none.
private hook_name(program: TProgram, hook: Option[usize]) -> string = hook match
    Some(id) -> program.symbols[id].name
    None -> ""

// A file of a program tree belongs to the module its directory names, and its header, which every
// file outside the root directory has, says so. The root directory's files are the root module,
// which has no name, so they have none.
place_file(parsed: *Parsed, module_name: string, in_library: bool)
    val header = parsed.file.module_name
    val at = parsed.file.module_span
    val core = module_name == CoreModule || module_name.starts_with(CoreModule + ".")
    if !valid_module_name(module_name)
        parsed.report.add(error(Span(0, 0), s"`$module_name` is not a module name: each directory of a program is named with letters, digits and `_`, not starting with a digit"))
    elif in_library && !core
        parsed.report.add(error(Span(0, 0), s"the standard library's modules are `avin` and the modules under it, not `$module_name`"))
    elif !in_library && core
        parsed.report.add(error(if header == "" then Span(0, 0) else at, s"the module `$module_name` is reserved for the standard library"))
    elif module_name == "" && header != ""
        parsed.report.add(error(at, s"this file is in the program's root directory, whose module has no name, so it has no `module` header"))
    elif module_name != "" && header == ""
        parsed.report.add(error(Span(0, 0), s"this file is in module `$module_name`, so it begins with `module $module_name`"))
    elif header != module_name
        parsed.report.add(error(at, s"the header names module `$header`, but the file is in module `$module_name`"))
    parsed.file.module_name = module_name

private valid_module_name(name: string) -> bool
    if name == "" then return true
    var start = true
    for b in name.bytes
        if b == u8('.')
            if start then return false
            start = true
            continue
        val letter = b >= u8('a') && b <= u8('z') || b >= u8('A') && b <= u8('Z') || b == u8('_')
        val digit = b >= u8('0') && b <= u8('9')
        if !letter && !(digit && !start) then return false
        start = false
    !start

/** The runtime library archive for the runtime's sources as they are: the one a release ships beside
 * them, or else one built from the runtime's Sysl package into the toolchain's cache. Both are named
 * by a key over the sources, so an edited runtime is never linked from an archive of other sources. A
 * build is written under a temporary name and published by rename, so builds running at the same time
 * never see a partial archive. */
ensure_runtime(tc: Toolchain) -> Result[string, string]
    val key = runtime_key(tc)
    val shipped = tc.prebuilt_runtime(key)
    if exists(shipped) then return Ok(shipped)
    val archive = tc.runtime_cache() + "/libavinrt-" + key + ".a"
    if exists(archive) then return Ok(archive)
    make_dir_all(tc.runtime_cache()).map_err(e -> s"${tc.runtime_cache()}: ${e.to_string()}")?
    val pending = pending_name(archive)
    defer _ = remove_file(pending)
    defer _ = remove_file(pending + ".h")
    val result = capture(tc.sysl, ["build-c", tc.runtime_dir(), "-o", pending], stderr = true, timeout = 300000).map_err(e -> missing_tool(tc.sysl, e.to_string()))?
    if !result.status.ok()
        return Err("runtime build failed: " + result.status.to_string() + "\n" + result.err.unwrap_or("") + result.text)
    publish_file(pending, archive).map_err(e -> e.to_string())?
    Ok(archive)

/** The key a runtime archive is named by: the compiler's version and the runtime's sources. */
runtime_key(tc: Toolchain) -> string = content_key("avin " + Version + "\n" + runtime_fingerprint(tc))

/** Links LLVM IR with the runtime into an executable at `output`: with `shims`, the runtime with a
 * program's binding shims, when there is one, and otherwise the runtime's own archive. The
 * executable is written under a temporary name and published by rename, so a failed link leaves any
 * previous output in place. */
link(tc: Toolchain, llvm: string, shims: Option[string], output: string, optimization: string) -> Result[unit, string]
    val archive = shims match
        Some(a) -> a
        None -> ensure_runtime(tc)?
    val dir = make_temp_dir("avin-link").map_err(e -> e.to_string())?
    defer _ = remove_dir_all(dir)
    val ir = dir + "/program.ll"
    write_text(ir, llvm).map_err(e -> e.to_string())?
    val pending = pending_name(output)
    defer _ = remove_file(pending)
    val args = ["-x", "ir", optimization, "-Wno-override-module", ir, "-x", "none", archive, "-lm", "-o", pending]
    val result = capture(tc.clang, args, stderr = true, timeout = 120000).map_err(e -> missing_tool(tc.clang, e.to_string()))?
    if !result.status.ok()
        return Err("clang failed: " + result.status.to_string() + "\n" + result.err.unwrap_or("") + result.text)
    publish_file(pending, output).map_err(e -> e.to_string())?
    Ok(())
