module dev.avinlang.compiler

import sh.sysl.parsing.{Source, source_of, report}
import sysl.buf.{Buf, buf}
import sysl.fs.{exists, is_dir, make_dir_all, make_temp_dir, metadata, pending_name, publish_file, read_text, remove_dir_all, remove_file, walk, write_text}
import sysl.process.capture

/** Where the compiler finds what it compiles against: the standard library's Avin source and the
 * runtime's Sysl package. */
struct Toolchain
    root: string

    prelude_path(self) -> string = self.root + "/library/avin/prelude.avin"
    runtime_dir(self) -> string = self.root + "/runtime"
    runtime_archive(self) -> string = self.root + "/runtime/.sysl/libavinrt.a"
    /** Where the archives of the runtime with a program's binding shims are kept, by key. */
    shim_cache(self) -> string = self.root + "/.avin/shims"
end Toolchain

/** A toolchain rooted at `root`, if `root` holds the library and the runtime. */
toolchain_at(root: string) -> Option[Toolchain]
    val tc = Toolchain(root)
    if exists(tc.prelude_path()) && is_dir(tc.runtime_dir()) then Some(tc) else None

struct Compilation
    /** Every diagnostic, rendered; empty when compilation succeeded. */
    diagnostics: string
    llvm: Option[string]
    /** For a program with Sysl bindings, the archive it links in place of the runtime's: the runtime
     * with the bindings' shims, which Sysl has checked. */
    archive: Option[string]

/** Compiles a program to LLVM IR against the toolchain's prelude, and builds the shims of its Sysl
 * bindings, so a binding Sysl rejects is reported as the program's error. */
compile(tc: Toolchain, src: Source) -> Compilation
    val lowered = lower_units(tc, src) match
        Ok(l) -> l
        Err(diagnostics) -> return Compilation(diagnostics, None, None)
    var archive: Option[string] = None
    if lowered.program.bindings.len() > 0
        ensure_shims(tc, lowered.program.bindings, lowered.units) match
            Ok(a) -> archive = Some(a)
            Err(diagnostics) -> return Compilation(diagnostics, None, None)
    Compilation("", Some(emit_llvm(lowered.program)), archive)

/** Compiles a program as far as MIR against the toolchain's prelude, or renders its diagnostics. */
lower_source(tc: Toolchain, src: Source) -> Result[MirProgram, string] = lower_units(tc, src) match
    Ok(lowered) -> Ok(lowered.program)
    Err(diagnostics) -> Err(diagnostics)

/** A program as MIR, with the units it was compiled from, which place its diagnostics. */
private struct Lowered
    program: MirProgram
    units: Buf[SourceUnit]

private lower_units(tc: Toolchain, src: Source) -> Result[Lowered, string]
    val prelude_text = read_text(tc.prelude_path()) match
        Ok(text) -> text
        Err(e) -> return Err(s"avin: ${tc.prelude_path()}: ${e.to_string()}\n")
    var units: Buf[SourceUnit] = buf()
    var syntax = ""
    for source in [source_of(tc.prelude_path(), prelude_text), src]
        val parsed = parse(source)
        if parsed.report.has_errors() then syntax = syntax + parsed.report.render(source)
        units.push(SourceUnit(source, parsed.file, parsed.report))
    // A file with syntax errors is not checked: its tree is a recovery, and checking it would
    // report the recovery rather than the program.
    if syntax != "" then return Err(syntax)
    val checked = check_program(units)
    if checked.has_errors() then return Err(checked.render())
    checked.program match
        Some(program) -> Ok(Lowered(lower_program(program), checked.units))
        None -> Err("avin: checking produced no program\n")

/** The runtime library archive, built from the runtime's Sysl package when it is missing or older
 * than any of its sources. It is built under a temporary name and published by rename, so builds
 * running at the same time never see a partial archive. */
ensure_runtime(tc: Toolchain) -> Result[string, string]
    val archive = tc.runtime_archive()
    if exists(archive) && !runtime_stale(tc, archive) then return Ok(archive)
    make_dir_all(tc.root + "/runtime/.sysl").map_err(e -> e.to_string())?
    val pending = pending_name(archive)
    defer _ = remove_file(pending)
    defer _ = remove_file(pending + ".h")
    val result = capture("sysl", ["build-c", tc.runtime_dir(), "-o", pending], stderr = true, timeout = 120000).map_err(e -> "could not run sysl: " + e.to_string())?
    if !result.status.ok()
        return Err("runtime build failed: " + result.status.to_string() + "\n" + result.err.unwrap_or("") + result.text)
    publish_file(pending, archive).map_err(e -> e.to_string())?
    Ok(archive)

private runtime_stale(tc: Toolchain, archive: string) -> bool
    val built = metadata(archive) match
        Ok(m) -> m.modified
        Err(_) -> return true
    var entries = walk(tc.runtime_dir())
    loop
        val entry = entries.next() match
            Some(Ok(e)) -> e
            Some(Err(_)) -> return true
            None -> return false
        if entry.is_dir() && entry.path.ends_with("/.sysl")
            entries.skip_dir()
            continue
        if entry.path.ends_with(".sysl") || entry.path.ends_with(".hocon")
            if entry.meta.modified > built then return true

/** Links LLVM IR with the runtime into an executable at `output`: with `shims`, the runtime with a
 * program's binding shims, when there is one, and otherwise the runtime's own archive. The
 * executable is written under a temporary name and published by rename, so a failed link leaves any
 * previous output in place. */
link(tc: Toolchain, llvm: string, shims: Option[string], output: string, optimization: string) -> Result[unit, string]
    val archive = shims match
        Some(a) -> a
        None -> ensure_runtime(tc)?
    val dir = make_temp_dir("avin-link").map_err(e -> e.to_string())?
    defer _ = remove_dir_all(dir)
    val ir = dir + "/program.ll"
    write_text(ir, llvm).map_err(e -> e.to_string())?
    val pending = pending_name(output)
    defer _ = remove_file(pending)
    val args = ["-x", "ir", optimization, "-Wno-override-module", ir, "-x", "none", archive, "-lm", "-o", pending]
    val result = capture("clang", args, stderr = true, timeout = 120000).map_err(e -> "could not run clang: " + e.to_string())?
    if !result.status.ok()
        return Err("clang failed: " + result.status.to_string() + "\n" + result.err.unwrap_or("") + result.text)
    publish_file(pending, output).map_err(e -> e.to_string())?
    Ok(())
