module dev.avinlang.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

struct Parsed
    file: SourceFile
    report: Report
    /** The program the file was read as, at the file's own offsets: the file itself, or a literate
     * file's program with its prose blanked (`literate_program`). The checker reads this. */
    source: Source

parse(src: Source) -> Parsed
    var file = SourceFile("", Span(0, 0), false, buf(), buf(), buf())
    val program = literate_program(src) match
        Ok(p) -> p
        Err(d) ->
            var refused = report()
            refused.add(d)
            return Parsed(file, refused, src)
    var p = parser_for(program)
    val header = p.toks.here()
    if p.accept("module")
        file.module_name = qualified_name(&p)
        file.module_span = header.to(p.ended())
        p.expect_kind(Newline, "expected a new line after the module header")
    loop
        if p.toks.at_end() then break
        if p.accept_kind(Newline) then continue
        val before = p.toks.position
        val start = p.toks.here()
        if p.accept("import")
            parse_import(&p, start, file.imports)
            if !p.toks.at_end() then p.expect_kind(Newline, "expected a new line after an import")
            continue
        val reported = p.report.len()
        val annotations = parse_annotations(&p)
        if annotations.len() == 1 && annotations[0].name == "tests"
            file.tests_only = true
            continue
        val hidden = p.accept("private")
        if hidden && p.at("impl")
            p.report.add(error(start.to(p.ended()), "an impl has no name, so it cannot be private: mark its methods `private`"))
        if p.accept("data") then file.items.push(DataItem(parse_data(&p, start, annotations)))
        elif p.at("class") || (p.ahead(1) == "class" && (p.at("open") || p.at("abstract")))
            file.items.push(ClassItem(parse_class(&p, start, annotations)))
        elif p.at("object") && p.ahead(1) != "("
            file.items.push(ClassItem(parse_object(&p, start, annotations)))
        elif p.at("trait") && p.ahead(1) != "("
            file.items.push(ClassItem(parse_trait(&p, start, annotations)))
        elif p.at("impl") && (p.ahead(1) != "(" || impl_of_function_ahead(&p))
            file.items.push(ImplItem(parse_impl(&p, start, annotations)))
        elif (p.at("val") || p.at("var")) && p.ahead(1) != "("
            file.items.push(parse_value(&p, start, annotations, false))
        elif lazy_ahead(&p)
            p.toks.advance()
            file.items.push(parse_value(&p, start, annotations, true))
        else
            if is_operator_spelling(p.ahead(0))
                p.report.add(error(p.toks.here(), s"`${p.ahead(0)}` names a function, but only a method can be named by a symbol: declare it in a class, trait, object or impl"))
            file.items.push(FunctionItem(parse_function(&p, annotations)))
        file.private_items.push(hidden)
        val closed_block = p.toks.position > 0 && p.toks.items[p.toks.position - 1].value == Dedent
        if !p.toks.at_end() && !p.at_kind(Newline) && !closed_block
            if p.report.len() == reported then p.report.add(error(p.toks.here(), "expected a new line after a declaration"))
            skip_to_next_declaration(&p)
        if p.toks.position == before then p.toks.advance()
    Parsed(file, p.report, program)
end parse

// Recovery: after a malformed declaration, resume at the next line that starts at the left margin,
// so one mistake is reported once rather than once per remaining token.
private skip_to_next_declaration(p: *Parser)
    var depth = 0
    loop
        val t = p.toks.peek() match
            Some(t) -> t
            None -> return
        if t.value == Newline && depth == 0 then return
        if t.value == Indent then depth += 1
        if t.value == Dedent && depth > 0 then depth -= 1
        p.toks.advance()

required_name(p: *Parser) -> string
    p.toks.advance() match
        Some(t) ->
            if t.value != Word then p.report.add(expected(t.span, "a name", found_at(p.src, t.span)))
            p.spelling(t)
        None ->
            p.report.add(error(p.toks.here(), "expected a name"))
            ""

/** Whether `lazy` begins a `lazy val` here: like `open` before `class`, `lazy` is a modifier only
 * before `val` or `var`, and elsewhere an ordinary name. */
lazy_ahead(p: *Parser) -> bool = p.at("lazy") && (p.ahead(1) == "val" || p.ahead(1) == "var")

/** Reports `lazy var`: a lazy value is computed once and never assigned. */
private reject_lazy_var(p: *Parser, at: Span, mutable: bool)
    if mutable then p.report.add(error(at, "a `lazy` value is computed once and never assigned, so it is declared `lazy val`"))

/** Whether a word may not be declared as a name. `end` is contextual (it closes a form only when a
 * name follows), `open` is a modifier only before `class`, and `self` is rejected by the checker
 * with a message of its own. */
private reserved(word: string) -> bool = is_keyword(word) && word != "end" && word != "self" && word != "open"

/** Reports a keyword used to declare `what`: `loop` is a keyword and cannot name a value. */
reject_keyword(p: *Parser, span: Span, word: string, what: string)
    if reserved(word) then p.report.add(error(span, s"`$word` is a keyword and cannot name $what"))

/** A name that a declaration introduces, which may not be a keyword. */
declared_name(p: *Parser, what: string) -> string
    val at = p.toks.here()
    val word = p.ahead(0)
    if reserved(word)
        // Some keywords are tokens of their own kind, which `required_name` would also report.
        p.toks.advance()
        reject_keyword(p, at, word, what)
        return word
    required_name(p)

// A method's name that is a run of operator characters. The language's own operators are not method
// names: a type has them through their traits.
private symbol_name(p: *Parser) -> string
    val t = p.toks.advance().unwrap()
    val name = p.spelling(t)
    if language_operator(name)
        val via = operator_trait(name)
        if via != "" then p.report.add(error(t.span, s"`$name` is an operator of the language, which a type has by implementing `$via`, not by a method named `$name`"))
        else p.report.add(error(t.span, s"`$name` is an operator of the language and cannot name a method"))
    name

/** Whether `name` is one of the language's operators, which no method may be named. The bitwise `&`,
 * `^` and `|`, and `~` between two operands, are the integers' operators and free to name a method of
 * any other type. */
language_operator(name: string) -> bool
    if bitwise_method_name(name) then return false
    if compound_operator(name) then return true
    if name.ends_with(":=") && compound_operator(name[0..<name.bytes.len - 2]) then return true
    for op in ["&&", "||", "!", "==", "!=", "<", "<=", ">", ">=", "===", "!==", "::", "=", ":=", ":", "?", "->", "=>"]
        if name == op then return true
    false

// The trait an operator comes from, or "" for one a user type cannot have.
private operator_trait(name: string) -> string
    if name == "+" then "Add"
    elif name == "-" then "Sub"
    elif name == "*" then "Mul"
    elif name == "/" then "Div"
    elif name == "%" then "Rem"
    elif name == "==" || name == "!=" then "Eq"
    elif name == "<" || name == "<=" || name == ">" || name == ">=" then "Ord"
    else ""

/** Whether the member ahead declares a method named by a symbol: the symbol, then its type
 * parameters or its parameters. */
private symbol_method_ahead(p: *Parser) -> bool = is_operator_spelling(p.ahead(0)) && (p.ahead(1) == "(" || p.ahead(1) == "[")

private qualified_name(p: *Parser) -> string
    var name = required_name(p)
    while p.accept(".")
        name = name + "." + required_name(p)
    name

// Types: a name with optional arguments, a tuple `(A, B)`, or a function type. `A -> B` and
// `(A, B) -> C` are function types and associate to the right; `-> T` in a function type's
// parameter list is a by-name parameter.
parse_type(p: *Parser) -> &TypeExpr
    val start = p.toks.here()
    if p.accept("(")
        var params: Buf[FunctionTypeParam] = buf()
        if !p.at(")")
            loop
                val by_name = p.accept("->")
                params.push(FunctionTypeParam(parse_type(p), by_name))
                if !p.accept(",") || p.at(")") then break
        p.expect(")")
        if p.accept("->")
            val result = parse_type(p)
            return TypeExpr(start.to(result.span), Function(params, result))
        var items: Buf[&TypeExpr] = buf()
        for param in params
            if param.by_name then p.report.add(error(param.ty.span, "only a function type's parameter may be by-name"))
            items.push(param.ty)
        if items.len() == 1 then return items[0]
        return TypeExpr(start.to(p.ended()), Tuple(items))
    if !p.at("[") && !p.at_kind(Word)
        p.report.add(expected(start, "a type", found_at(p.src, start)))
        p.toks.advance()
        return TypeExpr(start, InvalidType)
    val head = if p.at("[") then slice_type(p, start) else named_type(p, start)
    if !p.accept("->") then return head
    var params: Buf[FunctionTypeParam] = buf()
    params.push(FunctionTypeParam(head, false))
    val result = parse_type(p)
    TypeExpr(start.to(result.span), Function(params, result))
end parse_type

/** `[]T`, which is `Vector[T]`. The element is a name or a parenthesized type, so `[]int -> int` is
 * a function from a vector and `[](int -> int)` is a vector of functions. */
private slice_type(p: *Parser, start: Span) -> &TypeExpr
    p.expect("[")
    if p.at_kind(Number)
        p.report.add(error(p.toks.here(), "there is no fixed-length `[N]T` type; `[]T` is a vector of any length"))
        p.toks.advance()
    p.expect("]")
    val element = parse_pattern_type(p)
    var args: Buf[&TypeExpr] = buf()
    args.push(element)
    TypeExpr(start.to(element.span), Named("Vector", args))

/** A type's name and its type arguments, `Map[K, V]`. */
private named_type(p: *Parser, start: Span) -> &TypeExpr
    val path = qualified_name(p)
    var args: Buf[&TypeExpr] = buf()
    if p.accept("[")
        loop
            args.push(parse_type(p))
            if !p.accept(",") || p.at("]") then break
        p.expect("]")
    TypeExpr(start.to(p.ended()), Named(path, args))

// The type of a type pattern, which a match arm's `->` may follow, so a function type there is
// written in parentheses: `f: ((int) -> int)`.
private parse_pattern_type(p: *Parser) -> &TypeExpr
    val start = p.toks.here()
    if p.at("[") then return slice_type(p, start)
    if !p.accept("(")
        if p.at_kind(Word) then return named_type(p, start)
        p.report.add(expected(start, "a type", found_at(p.src, start)))
        return TypeExpr(start, InvalidType)
    var items: Buf[&TypeExpr] = buf()
    if !p.at(")")
        loop
            items.push(parse_type(p))
            if !p.accept(",") || p.at(")") then break
    p.expect(")")
    if items.len() == 1 then return items[0]
    TypeExpr(start.to(p.ended()), Tuple(items))

parse_pattern(p: *Parser) -> &Pattern = pattern_of(p, true)

/** A pattern where a `:` after it begins its type, as a parameter's and a binding's do: a type
 * pattern there is written in parentheses. */
parse_untyped_pattern(p: *Parser) -> &Pattern = pattern_of(p, false)

private pattern_of(p: *Parser, typed: bool) -> &Pattern
    val first = parse_named_pattern(p, typed)
    if !pattern_separator(p) then return first
    var options: Buf[&Pattern] = buf()
    options.push(first)
    loop
        options.push(parse_named_pattern(p, typed))
        if !pattern_separator(p) then break
    Pattern(first.span.to(p.ended()), Alternatives(options))

// A bar continues an unfinished pattern, including on the next line at the arm margin.
private pattern_separator(p: *Parser) -> bool
    if p.at_kind(Newline)
        if p.ahead(1) != "|" then return false
        p.toks.advance()
    if !p.accept("|") then return false
    p.accept_kind(Newline)
    true

// A name or `_` followed by `:` and a type is a type pattern, where `typed` allows one. A `::` after
// a pattern makes it the head of a list pattern whose tail is everything after, so `::` groups to the
// right, and `whole @ head :: tail` binds `whole` to the list.
private parse_named_pattern(p: *Parser, typed: bool) -> &Pattern
    val first = parse_bound_pattern(p, typed)
    if !p.at("::") then return first
    p.toks.advance()
    val tail = parse_named_pattern(p, typed)
    Pattern(first.span.to(tail.span), Cons(first, tail))

private parse_bound_pattern(p: *Parser, typed: bool) -> &Pattern
    val inner = parse_comparison_pattern(p)
    if typed && p.at(":") && binder(inner)
        p.toks.advance()
        val ty = parse_pattern_type(p)
        return Pattern(inner.span.to(ty.span), Typed(inner, ty))
    if !p.at("@") then return inner
    val at = p.toks.here()
    p.toks.advance()
    val nested = parse_named_pattern(p, typed)
    inner.kind match
        Name(name) -> Pattern(inner.span.to(nested.span), Named(name, nested))
        _ ->
            p.report.add(error(at, "only a name can be bound with `@`"))
            nested

private parse_range_pattern(p: *Parser) -> &Pattern
    val lower = parse_pattern_atom(p)
    if !p.at("..") && !p.at("..<") then return lower
    val inclusive = p.accept("..")
    if !inclusive then p.expect("..<")
    val upper = parse_pattern_atom(p)
    val low = literal_of(p, lower)
    val high = literal_of(p, upper)
    Pattern(lower.span.to(upper.span), Range(low, high, inclusive))

private literal_of(p: *Parser, pattern: &Pattern) -> &Expr = bound_of(p, pattern, "a range pattern's bounds are literals")

private bound_of(p: *Parser, pattern: &Pattern, message: string) -> &Expr = pattern.kind match
    Literal(value) -> value
    _ ->
        p.report.add(error(pattern.span, message))
        Expr(pattern.span, Invalid)

private binder(pattern: &Pattern) -> bool = pattern.kind is Name(_) || pattern.kind is Wildcard

// `n + k` and the comparison patterns: `n < k`, `n <= k`, `n > k`, `n >= k`, and a bound before
// the name, `lo <= n` or `lo <= n < hi`, with `<` or `<=` on either side. The name may be `_`.
private parse_comparison_pattern(p: *Parser) -> &Pattern
    val first = parse_range_pattern(p)
    if p.at("+") && binder(first)
        p.toks.advance()
        val amount = parse_pattern_atom(p)
        val k = bound_of(p, amount, "the amount in `n + k` is a positive integer literal")
        return Pattern(first.span.to(amount.span), Successor(first, k))
    if !at_comparison(p) then return first
    val at = p.toks.here()
    val op = p.ahead(0)
    p.toks.advance()
    if binder(first)
        val limit = parse_pattern_atom(p)
        val value = bound_of(p, limit, "a comparison pattern compares with a literal")
        val bound = PatternBound(value, op == "<=" || op == ">=")
        val span = first.span.to(limit.span)
        if at_comparison(p)
            p.report.add(error(p.toks.here(), "a comparison pattern with two bounds puts the name between them, as in `0 <= n < 10`"))
            p.toks.advance()
            parse_pattern_atom(p)
        if op == "<" || op == "<=" then return Pattern(span, Bounded(first, None, Some(bound)))
        return Pattern(span, Bounded(first, Some(bound), None))
    val low = bound_of(p, first, "a comparison pattern compares a name with a literal")
    if op != "<" && op != "<="
        p.report.add(error(at, "a comparison pattern that starts with its bound uses `<` or `<=`, as in `0 <= n < 10`"))
    val name = parse_pattern_atom(p)
    if !binder(name) then p.report.add(error(name.span, "a comparison pattern binds a name or `_` between its bounds"))
    val lower = Some(PatternBound(low, op == "<="))
    if !p.at("<") && !p.at("<=") then return Pattern(first.span.to(name.span), Bounded(name, lower, None))
    val upper_op = p.ahead(0)
    p.toks.advance()
    val limit = parse_pattern_atom(p)
    val high = bound_of(p, limit, "a comparison pattern compares with a literal")
    Pattern(first.span.to(limit.span), Bounded(name, lower, Some(PatternBound(high, upper_op == "<="))))

private at_comparison(p: *Parser) -> bool = p.at("<") || p.at("<=") || p.at(">") || p.at(">=")

private parse_pattern_atom(p: *Parser) -> &Pattern
    val start = p.toks.here()
    if p.accept("(")
        if p.accept(")") then return Pattern(start.to(p.ended()), Literal(Expr(start.to(p.ended()), UnitLit)))
        var items: Buf[&Pattern] = buf()
        loop
            items.push(parse_pattern(p))
            if !p.accept(",") || p.at(")") then break
        p.expect(")")
        if items.len() == 1 then return items[0]
        return Pattern(start.to(p.ended()), Tuple(items))
    if p.accept("[")
        var items: Buf[&Pattern] = buf()
        if !p.at("]")
            loop
                items.push(parse_pattern(p))
                if !p.accept(",") || p.at("]") then break
        p.expect("]")
        return Pattern(start.to(p.ended()), Sequence(items))
    val token = p.toks.peek() match
        Some(t) -> t
        None ->
            p.report.add(error(start, "expected a pattern"))
            return Pattern(start, InvalidPattern)
    if p.at("-") || token.value == Number || token.value == RealNumber || token.value == Quoted || token.value == CharQuoted
        val negative = p.at("-")
        val value = expression(p, 70)
        if negative && !(value.kind is Unary(Negate, _))
            p.report.add(error(value.span, "a negative pattern needs a numeric literal"))
        return Pattern(value.span, Literal(value))
    if token.value != Word && reserved(p.spelling(token))
        // A keyword that is a token of its own kind still reads as a name being bound.
        p.toks.advance()
        reject_keyword(p, start, p.spelling(token), "a value")
        return Pattern(start, InvalidPattern)
    if token.value != Word
        p.report.add(expected(start, "a pattern", found_at(p.src, start)))
        p.toks.advance()
        return Pattern(start, InvalidPattern)
    val word = p.spelling(token)
    if word == "true" || word == "false"
        p.toks.advance()
        return Pattern(token.span, Literal(Expr(token.span, BoolLit(word == "true"))))
    if word == "_"
        p.toks.advance()
        return Pattern(token.span, Wildcard)
    reject_keyword(p, start, word, "a value")
    val path = qualified_name(p)
    if !p.accept("(")
        if path.contains(".") then return Pattern(start.to(p.ended()), Constructor(path, buf()))
        return Pattern(start.to(p.ended()), Name(path))
    var args: Buf[&Pattern] = buf()
    if !p.at(")")
        loop
            args.push(parse_pattern(p))
            if !p.accept(",") || p.at(")") then break
    p.expect(")")
    Pattern(start.to(p.ended()), Constructor(path, args))
end parse_pattern_atom

// A function parameter is `pattern: type`, optionally by-name (`: -> T`), repeated (`T*`), or
// defaulted (`= value`). Data fields allow only plain and defaulted fields.
parse_params(p: *Parser, function: bool) -> Buf[Param]
    var params: Buf[Param] = buf()
    p.expect("(")
    if !p.at(")")
        loop
            val start = p.toks.here()
            if p.at("lazy") && (p.ahead(2) == ":" || lazy_ahead(p))
                val what = if function then "a parameter is given by its caller, so it cannot be `lazy`; a by-name parameter, `x: -> T`, is computed where it is read" else "a data field is given when the value is made, so it cannot be `lazy`"
                p.report.add(error(start, what))
                p.toks.advance()
                if p.at("val") || p.at("var") then p.toks.advance()
            val pattern = parse_untyped_pattern(p)
            val named = pattern.kind is Name(_)
            p.expect(":")
            val by_name = p.accept("->")
            val ty = parse_type(p)
            val star = p.toks.here()
            val variadic = p.accept("*")
            var default: Option[&Expr] = None
            if p.accept("=") then default = Some(expression(p, 0))
            if variadic
                if !function then p.report.add(error(star, "a data field cannot be repeated"))
                if !named then p.report.add(error(pattern.span, "a repeated parameter needs a name"))
                if !p.at(")") then p.report.add(error(star, "a repeated parameter must be last"))
                if default is Some(d) then p.report.add(error(d.span, "a repeated parameter cannot have a default: a call that gives it nothing passes an empty vector"))
            if by_name
                if !function then p.report.add(error(pattern.span, "a data field cannot be by-name"))
                if variadic then p.report.add(error(pattern.span, "a repeated parameter cannot be by-name"))
                if !named then p.report.add(error(pattern.span, "a by-name parameter needs a name"))
            params.push(Param(start.to(p.ended()), pattern, ty, default, by_name, variadic))
            if !p.accept(",") || p.at(")") then break
    p.expect(")")
    params

// `[T, U: Ord + Hash]`, and on a type `[+T, -U]`
parse_type_params(p: *Parser) -> Buf[TypeParam]
    var params: Buf[TypeParam] = buf()
    if !p.accept("[") then return params
    if p.at("]") then p.report.add(error(p.toks.here(), "expected at least one type parameter"))
    else
        loop
            val start = p.toks.here()
            var variance = Invariant
            if p.accept("+") then variance = Covariant
            elif p.accept("-") then variance = Contravariant
            val name = declared_name(p, "a type parameter")
            var bounds: Buf[&TypeExpr] = buf()
            if p.accept(":")
                loop
                    bounds.push(parse_type(p))
                    if !p.accept("+") then break
            params.push(TypeParam(start.to(p.ended()), name, variance, bounds, s"${p.src.name}:${start.start}"))
            if !p.accept(",") || p.at("]") then break
    p.expect("]")
    params

/** A function: `name[T](params) -> Result = body`, an indented body, the clauses on the lines after
 * a signature with no body, or neither (a declaration completed by an annotation such as
 * `@intrinsic`). */
parse_function(p: *Parser, annotations: Buf[Annotation]) -> &Function
    val start = p.toks.here()
    // `object`, `trait` and `impl` begin a declaration only when no parenthesis follows, so
    // `object(x: int) = x` declares a function.
    val declaring = p.at("object") || p.at("trait") || p.at("impl")
    val symbol = is_operator_spelling(p.ahead(0))
    val name = if symbol then symbol_name(p) elif declaring then required_name(p) else declared_name(p, "a function")
    val name_span = start.to(p.ended())
    val type_params = parse_type_params(p)
    val params = parse_params(p, true)
    var result: Option[&TypeExpr] = None
    if p.accept("->") then result = Some(parse_type(p))
    if p.at("|")
        p.report.add(error(p.toks.here(), "a guard belongs to a clause; write the clauses on the lines after the signature"))
        p.toks.advance()
        expression(p, 3)
    val equals = p.accept("=")
    var body: Option[&Expr] = None
    val indented = p.at_kind(Indent)
    var clauses: Buf[Clause] = buf()
    var end = p.ended()
    if equals || indented
        // An indented body after a header with neither `=` nor a result type is a procedure body:
        // its last value is discarded and the function yields unit.
        val b = parse_line_body(p, !equals && result is None)
        body = Some(b)
        end = b.span
        optional_end(p, name, indented)
    elif annotations.len() == 0
        // A clause is a line that starts with the function's name and an argument list. After a
        // clause with an indented body, the next line follows the end of that block directly.
        loop
            if p.at_kind(Newline) && p.ahead(1) == name && p.ahead(2) == "(" && clause_ahead(p, 1) then p.toks.advance()
            elif !(after_block(p) && p.at(name) && p.ahead(1) == "(" && clause_ahead(p, 0)) then break
            val clause = parse_clause(p)
            end = clause.span
            clauses.push(clause)
    Function(annotations, start.to(end), name_span, name, type_params, params, result, body, clauses)

// Whether the line whose name is `offset` tokens ahead is a clause: its argument list is followed by
// `=`, a guard, or an indented block of guards. A line of the same name followed by `->` or by the
// end of the line is another declaration, an overload without a body, as two abstract methods of one
// name are.
private clause_ahead(p: *Parser, offset: usize) -> bool
    var depth = 0
    var i = offset + 1
    loop
        val token = p.toks.peek_at(i) match
            Some(t) -> t
            None -> return false
        val text = p.spelling(token)
        if token.value == Newline || token.value == Dedent then return false
        if text == "(" then depth += 1
        elif text == ")"
            depth -= 1
            if depth == 0
                val after = p.toks.peek_at(i + 1) match
                    Some(t) -> t
                    None -> return false
                return p.spelling(after) == "=" || p.spelling(after) == "|" || after.value == Indent
        i += 1
    false

// `name(patterns) = body`, `name(patterns) | guard = body`, or `name(patterns)` followed by an
// indented block of `| guard = body` lines, tried in order, where `| _ = body` always holds.
private parse_clause(p: *Parser) -> Clause
    val start = p.toks.here()
    p.toks.advance()
    p.expect("(")
    var patterns: Buf[&Pattern] = buf()
    if !p.at(")")
        loop
            patterns.push(parse_pattern(p))
            if !p.accept(",") || p.at(")") then break
    p.expect(")")
    var bodies: Buf[GuardedBody] = buf()
    if p.accept("|")
        val guard = expression(p, 3)
        p.expect("=")
        bodies.push(GuardedBody(Some(guard), parse_line_body(p, false)))
    elif p.accept("=") then bodies.push(GuardedBody(None, parse_line_body(p, false)))
    elif p.accept_kind(Indent)
        loop
            if p.toks.at_end() || p.accept_kind(Dedent) then break
            if p.accept_kind(Newline) then continue
            val before = p.toks.position
            if !p.at("|")
                p.report.add(error(p.toks.here(), "expected a guard, as in `| n > 0 = value`, or `| _ = value` for the rest"))
                skip_line(p)
                continue
            p.toks.advance()
            var guard: Option[&Expr] = None
            if p.at("_") && p.ahead(1) == "=" then p.toks.advance()
            else guard = Some(expression(p, 3))
            p.expect("=")
            bodies.push(GuardedBody(guard, parse_line_body(p, false)))
            if p.toks.position == before then p.toks.advance()
    else p.report.add(error(p.toks.here(), "expected `=`, a guard, or indented guards after a clause's arguments"))
    val end = if bodies.len() > 0 then bodies[bodies.len() - 1].body.span else start
    Clause(start.to(end), patterns, bodies)

private after_block(p: *Parser) -> bool = p.toks.position > 0 && p.toks.items[p.toks.position - 1].value == Dedent

// Skips the rest of a line in a block, with any block nested in it, stopping before the new line
// or the end of the enclosing block.
private skip_line(p: *Parser)
    var depth = 0
    loop
        val t = p.toks.peek() match
            Some(t) -> t
            None -> return
        if depth == 0 && (t.value == Newline || t.value == Dedent) then return
        if t.value == Indent then depth += 1
        if t.value == Dedent then depth -= 1
        p.toks.advance()

// A local declaration has a parameter list followed by `=`, `->`, `|` or an indented body, or is a
// signature with typed parameters followed by its clauses. A bare call or a type application stays
// an expression.
local_function_ahead(p: *Parser) -> bool
    if !p.at_kind(Word) then return false
    // A keyword followed by parentheses starts a statement, as in `val (a, b) = pair`.
    val word = p.ahead(0)
    if word == "val" || word == "var" || word == "if" || word == "elif" || word == "while" || word == "for" || word == "loop" || word == "return" || word == "break" then return false
    val next = p.ahead(1)
    if next != "(" && next != "[" then return false
    var depth = 0
    var braces = 0
    var params = false
    var typed = false
    var empty = false
    var i = 1usize
    loop
        val token = p.toks.peek_at(i) match
            Some(t) -> t
            None -> return false
        val text = p.spelling(token)
        if token.value == Newline || token.value == Dedent then return false
        if text == "("
            depth += 1
            if !params then empty = p.ahead(i + 1) == ")"
            params = true
        elif params && text == "{" then braces += 1
        elif params && text == "}" then braces -= 1
        elif text == ":" && params && depth == 1 && braces == 0 then typed = true
        elif text == ")"
            depth -= 1
            if params && depth == 0
                val after = p.toks.peek_at(i + 1) match
                    Some(t) -> t
                    None -> return false
                val word = p.spelling(after)
                // A signature with no result type is followed by its clauses.
                if after.value == Newline then return typed && p.ahead(i + 2) == p.ahead(0) && p.ahead(i + 3) == "("
                // `xs(i) = v` assigns an element, and `retry(3)` before an indented block passes the
                // block as its last argument: a declaration's parameters are typed.
                return (word == "=" || after.value == Indent) && (typed || empty) || word == "->" || word == "|"
        elif !params && text != "[" && token.value != Word && text != "]" && text != "," && text != ":" && text != "+" then return false
        i += 1
    false

private parse_data(p: *Parser, start: Span, annotations: Buf[Annotation]) -> &DataDecl
    val name = declared_name(p, "a type")
    val type_params = parse_type_params(p)
    var variants: Buf[Variant] = buf()
    // The one-line form declares a type with one variant, named after the type.
    val one_line = p.at("(")
    if one_line
        val fields = parse_params(p, false)
        variants.push(Variant(start.to(p.ended()), name, fields))
    var derives: Buf[&TypeExpr] = buf()
    if p.accept("derives")
        loop
            derives.push(parse_type(p))
            if !p.accept(",") then break
    if one_line then return DataDecl(annotations, start.to(p.ended()), name, type_params, variants, derives)
    p.expect_kind(Indent, "expected indented data variants")
    loop
        if p.toks.at_end() || p.accept_kind(Dedent) then break
        if p.accept_kind(Newline) then continue
        val before = p.toks.position
        val at = p.toks.here()
        val variant = declared_name(p, "a variant")
        var fields: Buf[Param] = buf()
        if p.at("(") then fields = parse_params(p, false)
        variants.push(Variant(at.to(p.ended()), variant, fields))
        if p.toks.position == before then p.toks.advance()
    DataDecl(annotations, start.to(p.ended()), name, type_params, variants, derives)

// `class Name[T](params): Parent(args), Trait derives Eq` and an optional indented body of fields,
// methods and statements, each possibly `private`; `open` or `abstract` may come first.
private parse_class(p: *Parser, start: Span, annotations: Buf[Annotation]) -> &ClassDecl
    var modifier = ""
    var modifier_span = start
    if !p.at("class")
        modifier_span = p.toks.here()
        modifier = required_name(p)
    p.expect("class")
    val name_start = p.toks.here()
    val name = declared_name(p, "a type")
    val name_span = name_start.to(p.ended())
    val type_params = parse_type_params(p)
    var params: Buf[ClassParam] = buf()
    if p.at("(") then params = parse_class_params(p)
    val parents = parse_parents(p)
    var derives: Buf[&TypeExpr] = buf()
    if p.accept("derives")
        loop
            derives.push(parse_type(p))
            if !p.accept(",") then break
    val members = parse_class_body(p, name)
    ClassDecl(annotations, start.to(p.ended()), name_span, name, modifier, modifier_span, type_params, params, parents, derives, members, false)

// `object Name: Parent, Trait` and an optional indented body like a class's. An object is its one
// instance, so it takes neither type parameters nor parameters.
private parse_object(p: *Parser, start: Span, annotations: Buf[Annotation]) -> &ClassDecl
    p.expect("object")
    val name_start = p.toks.here()
    val name = declared_name(p, "an object")
    val name_span = name_start.to(p.ended())
    if p.at("[")
        p.report.add(error(p.toks.here(), "an object has one instance, so it cannot be generic"))
        parse_type_params(p)
    if p.at("(")
        p.report.add(error(p.toks.here(), "an object has one instance, made by its body, so it takes no parameters"))
        parse_class_params(p)
    val parents = parse_parents(p)
    val members = parse_class_body(p, name)
    ClassDecl(annotations, start.to(p.ended()), name_span, name, "", start, buf(), buf(), parents, buf(), members, true)

// `trait Name[+T]: Required, Other` and an optional indented body of methods, each with or without
// a body. A trait is recorded as a class whose modifier is `trait`; it takes no parameters, since it
// holds no state.
private parse_trait(p: *Parser, start: Span, annotations: Buf[Annotation]) -> &ClassDecl
    val modifier_span = p.toks.here()
    p.expect("trait")
    val name_start = p.toks.here()
    val name = declared_name(p, "a type")
    val name_span = name_start.to(p.ended())
    val type_params = parse_type_params(p)
    if p.at("(")
        p.report.add(error(p.toks.here(), "a trait holds no state, so it takes no parameters"))
        parse_class_params(p)
    val parents = parse_parents(p)
    val members = parse_class_body(p, name)
    ClassDecl(annotations, start.to(p.ended()), name_span, name, "trait", modifier_span, type_params, buf(), parents, buf(), members, false)

// At `impl (`: whether `for` follows on the line, outside any brackets, as in
// `impl (string) -> int for Lengths`; otherwise `impl` names a function, as in `impl(x: int) = x`.
private impl_of_function_ahead(p: *Parser) -> bool
    var depth = 0
    var i = 1usize
    loop
        val token = p.toks.peek_at(i) match
            Some(t) -> t
            None -> return false
        if token.value == Dedent || token.value == Newline || token.value == Indent then return false
        val word = p.spelling(token)
        if word == "(" || word == "[" then depth += 1
        elif word == ")" || word == "]" then depth -= 1
        elif word == "for" && depth == 0 then return true
        elif word == "=" && depth == 0 then return false
        i += 1
    false

// The parents after `:`, if any: a superclass with its constructor arguments, traits, and function
// types, which begin with `(` or have `->` outside brackets, as no superclass or trait does.
private parse_parents(p: *Parser) -> Buf[&Expr]
    var parents: Buf[&Expr] = buf()
    if !p.accept(":") then return parents
    loop
        if p.at("(") || arrow_ahead(p)
            val ty = parse_type(p)
            parents.push(Expr(ty.span, TypeParent(ty)))
        else parents.push(header_expression(p))
        if !p.accept(",") then break
    parents

// Whether the parent ahead is a function type written without parentheses, `int -> string`: `->`
// comes before the parent ends, outside any brackets.
private arrow_ahead(p: *Parser) -> bool
    var depth = 0
    var i = 0usize
    loop
        val token = p.toks.peek_at(i) match
            Some(t) -> t
            None -> return false
        if token.value == Dedent || token.value == Newline || token.value == Indent then return false
        val word = p.spelling(token)
        if word == "(" || word == "[" then depth += 1
        elif word == ")" || word == "]"
            if depth == 0 then return false
            depth -= 1
        elif depth == 0 && (word == "," || word == "derives") then return false
        elif depth == 0 && word == "->" then return true
        i += 1
    false

// `impl[T] Trait[T] for Type[T]` or `impl Type`, and an indented body of methods.
private parse_impl(p: *Parser, start: Span, annotations: Buf[Annotation]) -> &ImplDecl
    for a in annotations
        p.report.add(error(a.span, s"unknown annotation `@${a.name}`"))
    p.expect("impl")
    val type_params = parse_type_params(p)
    val first = parse_type(p)
    var trait_name: Option[&TypeExpr] = None
    var target = first
    if p.accept("for")
        trait_name = Some(first)
        target = parse_type(p)
    val name = target.kind match
        Named(path, _) -> path
        _ -> "impl"
    val members = parse_class_body(p, name)
    ImplDecl(start.to(p.ended()), type_params, trait_name, target, members)

// The indented body of a class or an object: fields, methods and statements, one per line.
private parse_class_body(p: *Parser, name: string) -> Buf[ClassMember]
    var members: Buf[ClassMember] = buf()
    val indented = p.accept_kind(Indent)
    if indented
        loop
            if p.toks.at_end() || p.accept_kind(Dedent) then break
            if p.accept_kind(Newline) then continue
            val before = p.toks.position
            members.push(parse_class_member(p))
            if p.toks.position == before then p.toks.advance()
            if !p.toks.at_end() && !p.at_kind(Newline) && !p.at_kind(Dedent) && !after_block(p)
                p.report.add(error(p.toks.here(), "expected a new line between class members"))
                skip_line(p)
        optional_end(p, name, true)
    members

// A module-level `val x = …`, `var x: T = …` or `lazy val x = …`, one name to a declaration.
private parse_value(p: *Parser, start: Span, annotations: Buf[Annotation], lazy: bool) -> Item
    for a in annotations
        p.report.add(error(a.span, s"unknown annotation `@${a.name}`"))
    val mutable = p.at("var")
    if lazy then reject_lazy_var(p, start, mutable)
    p.toks.advance()
    val binding = parse_binding(p, start, mutable)
    binding.kind match
        Binding(name, declared, value, _) -> ValueItem(FieldDecl(binding.span, name, declared, value, mutable && !lazy, true, lazy))
        _ ->
            p.report.add(error(binding.span, "a module-level declaration names one value"))
            ValueItem(FieldDecl(binding.span, "_", None, Expr(binding.span, Invalid), mutable, true, false))

// `owner: string`, `val name: string`, `var balance: int`, `private var count: int`
private parse_class_params(p: *Parser) -> Buf[ClassParam]
    var params: Buf[ClassParam] = buf()
    p.expect("(")
    if !p.at(")")
        loop
            val start = p.toks.here()
            val hidden = p.accept("private")
            if lazy_ahead(p)
                p.report.add(error(p.toks.here(), "a class parameter is given when the object is made, so it cannot be `lazy`; declare a `lazy val` in the class body"))
                p.toks.advance()
            var mutable = false
            var marked = false
            if p.accept("var")
                mutable = true
                marked = true
            elif p.accept("val") then marked = true
            if hidden && !marked then p.report.add(error(start, "a plain class parameter is already private; `private` goes before `val` or `var`"))
            val name_at = p.toks.here()
            val name = declared_name(p, "a field")
            val pattern = Pattern(name_at.to(p.ended()), Name(name))
            p.expect(":")
            if p.at("->")
                p.report.add(error(p.toks.here(), "a class parameter is a field, so it cannot be by-name"))
                p.toks.advance()
            val ty = parse_type(p)
            val star = p.toks.here()
            val variadic = p.accept("*")
            var default: Option[&Expr] = None
            if p.accept("=") then default = Some(expression(p, 0))
            if variadic
                if !p.at(")") then p.report.add(error(star, "a repeated parameter must be last"))
                if default is Some(d) then p.report.add(error(d.span, "a repeated parameter cannot have a default: a call that gives it nothing passes an empty vector"))
            params.push(ClassParam(Param(start.to(p.ended()), pattern, ty, default, false, variadic), mutable, marked && !hidden))
            if !p.accept(",") || p.at(")") then break
    p.expect(")")
    params

// A field (`val`/`var`), a method (a function declaration), or a statement the constructor runs.
private parse_class_member(p: *Parser) -> ClassMember
    // Annotations are written on the lines before a method, as before a top-level function; the
    // checker decides which a method may have.
    val annotations = if p.at("@") then parse_annotations(p) else buf()
    val start = p.toks.here()
    val hidden = p.accept("private")
    // `override static` and `static override` are one member.
    var static_member = p.accept("static")
    val overrides = p.accept("override")
    if !static_member then static_member = p.accept("static")
    val lazy = lazy_ahead(p)
    if lazy then p.toks.advance()
    if annotations.len() > 0
        if p.at("val") || p.at("var") then p.report.add(error(annotations[0].span, "a field takes no annotations"))
        else return MethodMember(parse_function(p, annotations), !hidden, overrides, static_member)
    if p.at("val") || p.at("var")
        val mutable = p.at("var")
        p.toks.advance()
        if overrides then p.report.add(error(start, "only a method can be marked `override`"))
        if static_member then p.report.add(error(start, "only a method can be `static`; a field belongs to a value"))
        if lazy then reject_lazy_var(p, start, mutable)
        // `val name: T` at the end of its line declares the field without a value, as a trait does.
        var binding: &Expr = Expr(start, Invalid)
        if !p.at("(") && p.ahead(1) == ":"
            val name_span = p.toks.here()
            val name = required_name(p)
            p.expect(":")
            val declared = parse_type(p)
            if p.at_line_end()
                if lazy then p.report.add(error(start.to(declared.span), "a `lazy val` is computed from its initializer, so it needs one"))
                return AbstractFieldMember(AbstractField(start.to(declared.span), name_span, name, declared, mutable, !hidden))
            binding = binding_value(p, start, mutable, None, name, Some(declared))
        else binding = parse_binding(p, start, mutable)
        binding.kind match
            Binding(name, declared, value, _) -> return FieldMember(FieldDecl(binding.span, name, declared, value, mutable && !lazy, !hidden, lazy))
            _ ->
                p.report.add(error(binding.span, "a field declaration names one field"))
                return StatementMember(Expr(binding.span, Invalid))
    if hidden || overrides || static_member || symbol_method_ahead(p) || local_function_ahead(p) || signature_ahead(p) then return MethodMember(parse_function(p, buf()), !hidden, overrides, static_member)
    StatementMember(line_statement(p))

// A member that is a name, type parameters perhaps, and a parameter list with a typed parameter,
// ending its line, is the signature of an abstract method yielding `unit`: a call never has a `:`
// among its arguments.
private signature_ahead(p: *Parser) -> bool
    if !p.at_kind(Word) then return false
    val next = p.ahead(1)
    if next != "(" && next != "[" then return false
    var depth = 0
    var typed = false
    var i = 1usize
    loop
        val token = p.toks.peek_at(i) match
            Some(t) -> t
            None -> return false
        if token.value == Newline || token.value == Dedent then return false
        val text = p.spelling(token)
        if text == "(" || text == "[" then depth += 1
        elif text == ":" && depth == 1 then typed = true
        elif text == ")" || text == "]"
            depth -= 1
            if text == ")" && depth == 0
                val after = p.toks.peek_at(i + 1) match
                    Some(t) -> t
                    None -> return typed
                return typed && (after.value == Newline || after.value == Dedent)
        i += 1
    false

// `import a.b.c`, `import a.b.c as d`, `import a.b.{c, d as e}`
private parse_import(p: *Parser, at: Span, imports: Buf[Import])
    var path = required_name(p)
    loop
        if !p.accept(".") then break
        if p.accept("{")
            loop
                val name = required_name(p)
                val aliased = p.accept("as")
                val binding = if aliased then declared_name(p, "an import") else name
                if !aliased then reject_keyword(p, at, name, "an import")
                imports.push(Import(at.to(p.ended()), path + "." + name, binding))
                if !p.accept(",") || p.at("}") then break
            p.expect("}")
            return
        path = path + "." + required_name(p)
    val aliased = p.accept("as")
    val binding = if aliased then declared_name(p, "an import") else last_segment(path)
    if !aliased then reject_keyword(p, at, binding, "an import")
    imports.push(Import(at.to(p.ended()), path, binding))

private last_segment(path: string) -> string
    var start = 0usize
    for i in 0..<path.bytes.len
        if path.bytes[i] == u8('.') then start = i + 1
    path[start..]

// Annotations are recorded as written; which names exist and what their arguments mean is decided
// by the resolver, which knows the declaration each one is attached to.
parse_annotations(p: *Parser) -> Buf[Annotation]
    var out: Buf[Annotation] = buf()
    while p.accept("@")
        val start = p.toks.here()
        val name = required_name(p)
        var args: Buf[AnnotationArg] = buf()
        if p.accept("(")
            if p.at(")") then p.report.add(error(p.toks.here(), "omit the parentheses of an annotation with no arguments"))
            else
                loop
                    var key: Option[string] = None
                    if p.at_kind(Word) && p.ahead(1) == ":"
                        key = Some(required_name(p))
                        p.toks.advance()
                    args.push(AnnotationArg(key, expression(p, 0)))
                    if !p.accept(",") || p.at(")") then break
            p.expect(")")
        out.push(Annotation(start.to(p.ended()), name, args))
        p.expect_kind(Newline, "expected a new line after an annotation")
        if name == "tests" then break
    out
end parse_annotations
