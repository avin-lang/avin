module dev.avinlang.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

/** A body is either one expression on the same line or an indented block. In a block, a line that
 * starts a local function declaration declares one. */
parse_body(p: *Parser, discard: bool) -> &Expr
    if !p.accept_kind(Indent) then return expression(p, 0)
    val start = p.toks.here()
    var items: Buf[&Expr] = buf()
    // A block starts a new line context: commas inside it make tuples again.
    val outer = p.in_list
    p.in_list = false
    val header = p.in_header
    p.in_header = false
    loop
        if p.toks.at_end() || p.accept_kind(Dedent) then break
        if p.accept_kind(Newline) then continue
        val position = p.toks.position
        if local_function_ahead(p)
            val declaration = parse_function(p, buf())
            items.push(Expr(declaration.span, LocalFunction(declaration)))
        else items.push(line_statement(p))
        if p.toks.position == position then p.toks.advance()
        if p.at_kind(Indent) && method_name_ahead(p) then indented_infix(p)
        elif !p.toks.at_end() && !p.at_kind(Newline) && !p.at_kind(Dedent)
            if p.toks.items[p.toks.position - 1].value != Dedent
                p.report.add(error(p.toks.here(), "expected a new line between block items"))
    p.in_list = outer
    p.in_header = header
    if items.len() == 0 then p.report.add(error(start, "expected a nonempty block"))
    Expr(start.to(p.ended()), Block(items, discard))

// Whether the indented line after a statement starts with a name and then an argument, as an
// infix call continued from the line above would: `b` then `    add 2`.
private method_name_ahead(p: *Parser) -> bool
    p.toks.peek_at(1) match
        Some(name) ->
            if name.value != Word || is_keyword(p.spelling(name)) then return false
            p.toks.peek_at(2) match
                Some(next) -> next.value != Newline && next.value != Dedent && next.value != AssignOp && p.ahead(2) != "(" && p.ahead(2) != "."
                None -> false
        None -> false

// An infix call does not continue onto an indented line that starts with the method's name. The
// indented lines are skipped, so the one mistake is reported once.
private indented_infix(p: *Parser)
    val name = p.ahead(1)
    p.report.add(error(p.toks.peek_at(1).unwrap().span, s"a line cannot start with the method of an infix call: end the line above with `$name` and indent its argument"))
    var depth = 0usize
    loop
        val t = p.toks.advance() match
            Some(t) -> t
            None -> break
        if t.value == Indent then depth += 1
        if t.value == Dedent
            depth -= 1
            if depth == 0 then break

/** A body that fills the rest of a line, where a tuple needs no parentheses (`= a, b`), or an
 * indented block. */
parse_line_body(p: *Parser, discard: bool) -> &Expr
    if p.at_kind(Indent) then parse_body(p, discard) else line_value(p)

// `else`, `elif` and `end` may continue a form on the line after its indented body.
private following(p: *Parser, word: string) -> bool
    if p.at(word) then return true
    if !p.at_kind(Newline) || p.ahead(1) != word then return false
    if word == "end"
        val label = p.toks.peek_at(2) match
            Some(value) -> value
            None -> return false
        if label.value != Word then return false
    p.toks.advance()
    true

/** An optional `end name` closing an indented form. `end` is contextual: it closes a form only
 * when a name follows it. */
optional_end(p: *Parser, name: string, indented: bool)
    if !following(p, "end") then return
    if !(p.toks.peek_at(1) is Some(_)) then return
    val at = p.toks.here()
    p.toks.advance()
    val actual = required_name(p)
    if !indented then p.report.add(error(at, s"`end $actual` cannot close a one-line form"))
    if actual != name then p.report.add(error(at, s"`end $actual` cannot close `$name`; expected `end $name`"))

// `val x = value`, or a binding that takes a value apart: `val q, r = value`, `val (a, b) = value`.
parse_binding(p: *Parser, at: Span, mutable: bool) -> &Expr
    var pattern: Option[&Pattern] = None
    var name = ""
    if p.at("(") || p.ahead(1) == ","
        val first = parse_untyped_pattern(p)
        if p.at(",")
            var items: Buf[&Pattern] = buf()
            items.push(first)
            while p.accept(",")
                items.push(parse_untyped_pattern(p))
            pattern = Some(Pattern(first.span.to(items[items.len() - 1].span), Tuple(items)))
        else pattern = Some(first)
    else name = declared_name(p, "a value")
    var declared: Option[&TypeExpr] = None
    if p.accept(":") then declared = Some(parse_type(p))
    binding_value(p, at, mutable, pattern, name, declared)

// The rest of a binding, from its `=`: `pattern` or `name` and the type `declared` are parsed.
binding_value(p: *Parser, at: Span, mutable: bool, pattern: Option[&Pattern], name: string, declared: Option[&TypeExpr]) -> &Expr
    p.expect("=")
    val indented = p.at_kind(Indent)
    val value = parse_line_body(p, false)
    optional_end(p, if mutable then "var" else "val", indented)
    pattern match
        Some(shape) -> Expr(at.to(value.span), Destructure(shape, declared, value, mutable))
        None -> Expr(at.to(value.span), Binding(name, declared, value, mutable))

parse_if(p: *Parser, at: Span) -> &Expr
    val condition = header_expression(p)
    val then_word = p.accept("then")
    var indented = p.at_kind(Indent)
    if !then_word && !indented then p.report.add(error(p.toks.here(), "a one-line `if` needs `then`"))
    val yes = parse_body(p, false)
    var no: Option[&Expr] = None
    if following(p, "elif") && p.accept("elif")
        no = Some(parse_if(p, p.toks.here()))
    elif following(p, "else") && p.accept("else")
        indented = p.at_kind(Indent)
        no = Some(parse_body(p, false))
    optional_end(p, "if", indented)
    Expr(at.to(p.ended()), If(condition, yes, no))

parse_while(p: *Parser, at: Span) -> &Expr
    val condition = header_expression(p)
    val do_word = p.accept("do")
    var indented = p.at_kind(Indent)
    if !do_word && !indented then p.report.add(error(p.toks.here(), "a one-line `while` needs `do`"))
    val body = parse_body(p, true)
    var otherwise: Option[&Expr] = None
    if following(p, "else") && p.accept("else")
        indented = p.at_kind(Indent)
        otherwise = Some(parse_body(p, false))
    optional_end(p, "while", indented)
    Expr(at.to(p.ended()), While(condition, body, otherwise))

// `for pattern in source` and an indented body, or `for pattern in source do body` on one line.
// With `yield`, a comprehension: generators separated by commas, each followed by its `if` guards,
// or written one to a line in an indented block after `for`, with `yield` on the line after it.
parse_for(p: *Parser, at: Span) -> &Expr
    var generators: Buf[Generator] = buf()
    if p.accept_kind(Indent)
        // A line starting with `if` adds guards to the generator above it.
        var guards: Buf[&Expr] = buf()
        var start = p.toks.here()
        var pattern: Option[&Pattern] = None
        var source: &Expr = Expr(start, Invalid)
        loop
            if p.toks.at_end() || p.accept_kind(Dedent) then break
            if p.accept_kind(Newline) then continue
            val before = p.toks.position
            if p.at("if") && pattern is Some(_)
                guards_after(p, &guards)
            else
                if pattern is Some(shape) then generators.push(generator_of(start, shape, source, guards))
                guards = buf()
                start = p.toks.here()
                pattern = Some(parse_pattern(p))
                p.expect("in")
                source = header_expression(p)
                guards_after(p, &guards)
            if p.toks.position == before then break
        pattern match
            Some(shape) -> generators.push(generator_of(start, shape, source, guards))
            None -> generators.push(generator(p))
        if !following(p, "yield")
            p.report.add(error(p.toks.here(), "generators written in a block after `for` need `yield` on the line after them"))
            return Expr(at.to(p.ended()), Invalid)
    else
        generators.push(generator(p))
        while p.accept(",")
            generators.push(generator(p))
    if p.accept("yield")
        val indented = p.at_kind(Indent)
        val body = parse_line_body(p, false)
        optional_end(p, "for", indented)
        return Expr(at.to(p.ended()), ForYield(generators, body))
    val first = generators[0]
    if generators.len() > 1 || first.guards.len() > 0
        p.report.add(error(first.span.to(generators[generators.len() - 1].span), "a `for` without `yield` has one generator and no guards; nest the loops, or test in the body"))
    val do_word = p.accept("do")
    val indented = p.at_kind(Indent)
    if !do_word && !indented then p.report.add(error(p.toks.here(), "a one-line `for` needs `do`"))
    val body = parse_body(p, true)
    optional_end(p, "for", indented)
    Expr(at.to(p.ended()), For(first.pattern, first.source, body))

// `pattern in source` and the `if` guards after it.
private generator(p: *Parser) -> Generator
    val start = p.toks.here()
    val pattern = parse_pattern(p)
    p.expect("in")
    val source = header_expression(p)
    var guards: Buf[&Expr] = buf()
    guards_after(p, &guards)
    generator_of(start, pattern, source, guards)

// A generator spans from its pattern through its last guard.
private generator_of(start: Span, pattern: &Pattern, source: &Expr, guards: Buf[&Expr]) -> Generator
    val end = if guards.len() > 0 then guards[guards.len() - 1].span else source.span
    Generator(start.to(end), pattern, source, guards)

private guards_after(p: *Parser, guards: *Buf[&Expr])
    while p.accept("if") do guards.push(header_expression(p))

// `loop` and an indented body, or `loop do body` on one line; only `break` or `return` leaves it.
parse_loop(p: *Parser, at: Span) -> &Expr
    val do_word = p.accept("do")
    val indented = p.at_kind(Indent)
    if !do_word && !indented then p.report.add(error(p.toks.here(), "a one-line `loop` needs `do`"))
    val body = parse_body(p, true)
    optional_end(p, "loop", indented)
    Expr(at.to(p.ended()), Loop(body))

/** `do`, then the body (an indented block, or one statement on the same line), then `while` and the
 * test, then an optional `else` that runs when the test fails. */
parse_do(p: *Parser, at: Span) -> &Expr
    val indented = p.at_kind(Indent)
    val body = parse_body(p, true)
    if !(following(p, "while") && p.accept("while"))
        p.report.add(error(p.toks.here(), "a `do` body needs a `while` test after it"))
        return Expr(at.to(p.ended()), DoWhile(body, Expr(p.toks.here(), BoolLit(false)), None))
    val condition = header_expression(p)
    var otherwise: Option[&Expr] = None
    var else_indented = false
    if following(p, "else") && p.accept("else")
        else_indented = p.at_kind(Indent)
        otherwise = Some(parse_body(p, false))
    optional_end(p, "do", indented || else_indented)
    Expr(at.to(p.ended()), DoWhile(body, condition, otherwise))

match_expression(p: *Parser, subject: &Expr) -> &Expr
    p.expect_kind(Indent, "expected indented match arms")
    val arms = match_arms(p)
    Expr(subject.span.to(p.ended()), Match(subject, arms))

// `match` with nothing before it is a function of the value its arms match. The arms are an
// indented block, as after `x match`, or one arm on the `match` line: `xs.collect(match Some(n) -> n)`.
match_function(p: *Parser, at: Span) -> &Expr
    if p.accept_kind(Indent) then return Expr(at.to(p.ended()), MatchFunction(match_arms(p)))
    var arms: Buf[Arm] = buf()
    if p.at_line_end()
        p.report.add(error(p.toks.here(), "expected match arms after `match`: one on the same line, or an indented block"))
        return Expr(at, Invalid)
    arms.push(match_arm(p, false, true))
    Expr(at.to(p.ended()), MatchFunction(arms))

// The arms of an indented block, whose Indent is consumed; reads through its Dedent and an optional
// `end match`.
private match_arms(p: *Parser) -> Buf[Arm]
    var arms: Buf[Arm] = buf()
    loop
        if p.toks.at_end() || p.accept_kind(Dedent) then break
        if p.accept_kind(Newline) then continue
        val before = p.toks.position
        val fallback = p.accept("else")
        if !fallback && p.accept("|") && p.at("else")
            p.report.add(error(p.toks.here(), "a leading `|` needs a pattern, not `else`"))
        arms.push(match_arm(p, fallback, false))
        if p.toks.position == before then break
    optional_end(p, "match", true)
    arms

// One arm: a pattern, an optional `if` guard, `->` and the body. An `else` arm, already consumed when
// `fallback` is set, has no pattern and no arrow. `alone` marks the one arm on a `match` function's
// own line.
private match_arm(p: *Parser, fallback: bool, alone: bool) -> Arm
    val pattern: &Pattern = if fallback then Pattern(p.toks.here(), Wildcard) else parse_pattern(p)
    var guard: Option[&Expr] = None
    if p.accept("if")
        val previous = p.lambda_boundary
        p.lambda_boundary = match_guard_boundary(p)
        guard = Some(expression(p, 0))
        p.lambda_boundary = previous
    if !fallback then p.expect("->")
    // In an argument list a comma ends a one-line arm's body, as it ends the argument.
    val body = if alone && p.in_list && !p.at_kind(Indent) then expression(p, 0) else parse_line_body(p, false)
    Arm(pattern, guard, body)
