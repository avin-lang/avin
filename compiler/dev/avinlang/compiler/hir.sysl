module dev.avinlang.compiler

import sh.sysl.parsing.{Source, Span}
import sysl.buf.Buf
import sysl.container.Map

// The typed tree the checker produces. Every name is resolved to a symbol and every expression
// carries its type, so later stages never look a name up or infer anything.

struct TExpr
    span: Span
    ty: &Type
    kind: TExprKind

enum TExprKind
    /** An integer constant, in decimal, already checked to fit its type. */
    IntConst(digits: string)
    BoolConst(value: bool)
    /** A Unicode scalar value. */
    CharConst(code: u32)
    RealConst(value: real)
    StrConst(value: string)
    UnitConst
    Param(index: usize)
    /** A local binding of the enclosing function, by its index in `TFunction.locals`. */
    Local(index: usize)
    /** A call; `type_args` instantiate a generic function, and are empty for any other. */
    Call(function: usize, args: Buf[&TExpr], type_args: Buf[&Type])
    /** A call of a method through the method table of the object `args[0]`: the method in `slot`,
     * which is `function` in the receiver's static class or an override of it, with the same
     * signature. `type_args` are `function`'s, its class's, from the receiver's type. */
    Dispatch(function: usize, slot: usize, args: Buf[&TExpr], type_args: Buf[&Type])
    /** A call of method `function` of a bound on a receiver `args[0]` whose type is a type
     * parameter. Each instance knows the receiver's type, and calls that type's implementation
     * directly, the one at table position `slot`; where the type is a trait or an open class, the
     * call goes through the object's method table. A method at no position (`None`) is called as it
     * is. */
    BoundCall(function: usize, slot: Option[usize], args: Buf[&TExpr], type_args: Buf[&Type])
    /** A value of a `data` type, made by one of its variants, by index, or a tuple, which is made as
     * a value with one variant whose fields are its parts; the type is the expression's, and
     * `args` are the fields in order. */
    Construct(variant: usize, args: Buf[&TExpr])
    /** A function as a value: a closure of `function`, which holds what the function captures.
     * `type_args` instantiate a generic function, and are empty for any other. */
    FunctionValue(function: usize, type_args: Buf[&Type])
    /** A call of a function value. */
    CallValue(callee: &TExpr, args: Buf[&TExpr])
    /** A field of a value of a `data` type with one variant, a part of a tuple, or a field of an
     * object of a class, by index. */
    Field(value: &TExpr, index: usize)
    /** A new object of the expression's class type, every field not yet set: the first step of a
     * constructor, which then stores the fields. */
    New
    /** Stores into a field of an object of a class. With `yields`, the expression's value is the
     * stored value; otherwise it is unit. */
    StoreField(object: &TExpr, index: usize, value: &TExpr, yields: bool)
    /** The value of a module-level `val` or `var`, or an object, by its index in `TProgram.globals`. */
    Global(index: usize)
    /** Stores into a module-level `var`, or initializes a module-level value. With `yields`, the
     * expression's value is the stored value; otherwise it is unit. */
    StoreGlobal(index: usize, value: &TExpr, yields: bool)
    /** Items in order; the block yields its last item, or unit when its type is unit. */
    Block(items: Buf[&TExpr])
    /** Initializes a local; yields unit. */
    Let(local: usize, value: &TExpr)
    /** Takes a value apart by a pattern that cannot fail, initializing the locals it binds; yields
     * unit. */
    LetPattern(pattern: &TPattern, value: &TExpr)
    /** Stores into a mutable local. With `yields`, the expression's value is the stored value;
     * otherwise it is unit. */
    Store(local: usize, value: &TExpr, yields: bool)
    /** Evaluates a tuple, then stores each part into its local; `None` discards that part. Yields
     * unit. */
    MultiStore(locals: Buf[Option[usize]], value: &TExpr)
    /** `++` and `--` on a mutable integer local; prefix yields the new value, postfix the old.
     * `op_span` is the operator's, where an overflow is reported. */
    Step(local: usize, increment: bool, postfix: bool, op_span: Span)
    Negate(operand: &TExpr)
    Not(operand: &TExpr)
    Complement(operand: &TExpr)
    /** A conversion written as a call of a built-in type: `i64(x)`, `byte(n)`, `real(n)`. What it
     * does follows from the operand's type and the expression's. */
    Convert(operand: &TExpr)
    /** An operation on two numbers of one type, where integer `+`, `-` and `*` trap on overflow;
     * or `+` joining two strings. `op_span` is the operator's, where a trap is reported. */
    Arith(op: BinaryOp, left: &TExpr, right: &TExpr, op_span: Span)
    /** A value converted to `Any`, the expression's type. A value of a type the program keeps as a
     * reference to an object with a descriptor (a string, a tuple, a `data` value, an object of a
     * class, a function) is already one, and converts as it is; a number, a char, a bool and unit
     * are put in a box, a new object whose descriptor names their type. */
    Box(value: &TExpr)
    /** A value of a built-in type as text, as an interpolation hole renders it. */
    Render(value: &TExpr)
    /** Short-circuit `&&` (`and` is true) or `||`. */
    Logic(and: bool, left: &TExpr, right: &TExpr)
    /** A comparison chain: operands left to right, each evaluated once, stopping at the first
     * failing link. */
    Compare(operands: Buf[&TExpr], ops: Buf[CompareOp])
    If(condition: &TExpr, yes: &TExpr, no: Option[&TExpr])
    /** A loop, numbered within its function so `Break` and `Continue` can name it. */
    While(label: usize, condition: &TExpr, body: &TExpr, otherwise: Option[&TExpr])
    Break(label: usize, value: Option[&TExpr])
    Continue(label: usize)
    Return(value: Option[&TExpr])
    /** Tries the arms in order; the first whose pattern matches and whose guard holds runs. */
    Match(subject: &TExpr, arms: Buf[TArm])
    /** Whether a value matches a pattern, or with `negated`, whether it does not. */
    Is(value: &TExpr, pattern: &TPattern, negated: bool)
    /** A function's clauses over its parameters' values, `subjects`, tried in order: the first
     * whose patterns match and one of whose guards holds runs that body. */
    Clauses(subjects: Buf[&TExpr], clauses: Buf[TClause])

struct TArm
    pattern: &TPattern
    guard: Option[&TExpr]
    body: &TExpr

/** A checked pattern; `ty` is the type of the value it matches. */
struct TPattern
    span: Span
    ty: &Type
    kind: TPatternKind

enum TPatternKind
    PWildcard
    /** Matches anything and binds it to a local. */
    PBind(local: usize)
    /** Matches a value equal to a constant. */
    PLiteral(value: &TExpr)
    /** Matches an integer, byte or char within the bounds that are present, and binds it to
     * `local` when there is one: a range pattern or a comparison pattern. */
    PBounds(local: Option[usize], lower: Option[TBound], upper: Option[TBound])
    /** `n + k`: matches an integer of at least `amount` and binds the value minus `amount` to
     * `local` when there is one. */
    PSuccessor(local: Option[usize], amount: &TExpr)
    /** Matches when any option does; options bind no names. */
    PAlternatives(options: Buf[&TPattern])
    /** Matches what `pattern` does and binds the whole value to a local. */
    PNamed(local: usize, pattern: &TPattern)
    /** Matches a `data` value made by the variant of that index whose fields match `fields`. */
    PVariant(variant: usize, fields: Buf[&TPattern])
    /** A type pattern: matches a value whose type at run time is `target` or, for a class or a
     * trait, one that conforms to it, and binds it, as a `target`, to `local` when there is one. The
     * pattern's own type is the matched value's static type; `tested` is false where that type
     * already conforms to `target`, so the pattern matches every value. */
    PType(target: &Type, local: Option[usize], tested: bool)

/** A constant bound of a pattern, and whether the matched value may equal it. */
struct TBound
    value: &TExpr
    inclusive: bool

/** One clause of a function: a pattern per parameter, and bodies tried in order once they match. */
struct TClause
    patterns: Buf[&TPattern]
    bodies: Buf[TGuarded]

/** A clause body, taken when its guard holds or when it has none. */
struct TGuarded
    guard: Option[&TExpr]
    body: &TExpr

/** A local binding: its name for diagnostics, its type, and the function it belongs to. Local
 * functions share their enclosing function's table, so `owner` tells a function's own locals from
 * the ones it captures. */
struct TLocal
    name: string
    ty: &Type
    mutable: bool
    owner: usize

/** A checked function. `body` is absent for an intrinsic. */
struct TFunction
    symbol: usize
    body: Option[&TExpr]
    locals: Buf[TLocal]

/** A built-in type's conformance to a trait, which an `impl` of the trait for the type states, and
 * the type's method table for the trait: at each position the trait places a method, the method of
 * the impl implementing it. A built-in value is no object, so it has no table at run time; a call
 * through a bound finds its implementation here and calls it directly. */
struct BuiltinConformance
    ty: &Type
    trait_type: &Type
    unit: usize
    span: Span
    table: Buf[Option[usize]]

/** A conformance an impl with bounds of its own states: the type whose parameters `owner` owns
 * (`data_owner` or `class_owner` of it) conforms to trait `trait_id` only at type arguments that meet
 * `conditions`, one list of bounds per type parameter, written in the type's own parameters. `params`
 * are the impl's type parameters, in unit `unit`, which its methods' type parameters begin with. */
struct ConditionalConformance
    owner: usize
    trait_id: usize
    conditions: Buf[Buf[&Type]]
    unit: usize
    params: Buf[TypeParam]

struct TProgram
    /** Each unit's source, by the unit index a symbol records, so a span can be named as a file,
     * line and column. */
    sources: Buf[Source]
    symbols: Buf[FunctionSymbol]
    data: Buf[DataSymbol]
    classes: Buf[ClassSymbol]
    globals: Buf[GlobalSymbol]
    functions: Buf[TFunction]
    /** The final solutions of the checker's inference variables, which a type in the tree may
     * still name when a nested call's unknown was settled by the call around it. */
    vars: Buf[Option[&Type]]
    /** `main`, which a program built to run has, and a program built for its tests may not. */
    entry: Option[usize]
    /** The function that initializes every module-level value in dependency order, run before the
     * entry; absent when the program has none. */
    init: Option[usize]
    builtins: Buf[BuiltinConformance]
    conditional: Buf[ConditionalConformance]
    core: CoreTraits
    /** The `@test` functions, in the order they are declared. */
    tests: Buf[TestCase]
    /** Whether the program is built to run its tests, one at a time, rather than `main`. */
    testing: bool

/** A `@test` function and the test's name: its description, or the function's own name. */
struct TestCase
    symbol: usize
    name: string

/** The core library's traits that operators and equality are written with, by name (`Eq`, `Hash`,
 * `Ord`, `Add`, `Sub`, `Mul`, `Div`, `Rem`, `Neg`), and their methods, by name (`equals`, `hash`,
 * `compare`, `less`, `add`, `negate`, …). A program checked without the core library has none. */
struct CoreTraits
    traits: Map[string, usize]
    methods: Map[string, usize]

    trait_named(self, name: string) -> Option[usize] = self.traits.get(name)

    method_named(self, name: string) -> Option[usize] = self.methods.get(name)

    /** Whether `m` is the method of a core trait named `name`. */
    is(self, m: usize, name: string) -> bool = self.methods.get(name) match
        Some(x) -> x == m
        None -> false
end CoreTraits

/** The core trait and method an operator is written with: `+` is `Add`'s `add`, `<` is `Ord`'s
 * `less`, `==` is `Eq`'s `equals`. */
struct OperatorMethod
    trait_name: string
    method: string

binary_operator_method(op: BinaryOp) -> Option[OperatorMethod] = op match
    Add -> Some(OperatorMethod("Add", "add"))
    Subtract -> Some(OperatorMethod("Sub", "subtract"))
    Multiply -> Some(OperatorMethod("Mul", "multiply"))
    Divide -> Some(OperatorMethod("Div", "divide"))
    Remainder -> Some(OperatorMethod("Rem", "remainder"))
    _ -> None

compare_operator_method(op: CompareOp) -> Option[OperatorMethod] = op match
    Equal -> Some(OperatorMethod("Eq", "equals"))
    NotEqual -> Some(OperatorMethod("Eq", "equals"))
    Less -> Some(OperatorMethod("Ord", "less"))
    LessEqual -> Some(OperatorMethod("Ord", "lessOrEqual"))
    Greater -> Some(OperatorMethod("Ord", "greater"))
    GreaterEqual -> Some(OperatorMethod("Ord", "greaterOrEqual"))
    _ -> None
