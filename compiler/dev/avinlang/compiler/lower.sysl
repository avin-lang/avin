module dev.avinlang.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.path.file_name
import sysl.text.from_utf8_unchecked

/** The machine type of a semantic type, or `None` for a type with no runtime representation. */
mir_type(t: &Type) -> Option[MirType] = *t match
    Unit -> None
    Nothing -> None
    AnyType -> Some(MRef)
    // A union is laid out as an `Any` holding its member.
    Union(_) -> Some(MRef)
    Bool -> Some(MBool)
    Str -> Some(MRef)
    Int(bits) -> Some(MInt(bits))
    Byte -> Some(MInt(8))
    Char -> Some(MInt(32))
    Real -> Some(MReal)
    Data(_, _, _) -> Some(MRef)
    Class(_, _, _) -> Some(MRef)
    Tuple(_) -> Some(MRef)
    Function(_, _, _) -> Some(MRef)
    ByName(_) -> Some(MRef)
    // A trait's `Self` is left in the code of the trait's default bodies, which every conforming
    // type shares: each such type is an object, reached by reference.
    TypeVar(owner, _, _) -> if is_self_owner(owner) then Some(MRef) else None
    _ -> None

/** Where a value is kept: the address of a slot, and the type stored there. */
private struct Place
    address: Operand
    ty: MirType

/** Where `break` and `continue` go for one loop, and the place its value is stored in. */
private struct LoopTarget
    label: usize
    head: usize
    exit: usize
    slot: Option[Place]

/** Where each field of one variant is kept in its object: a byte offset and machine type, or
 * `None` for a field with no runtime value. */
private struct VariantLayout
    descriptor: usize
    fields: Buf[Option[FieldSlot]]

private struct FieldSlot
    offset: usize
    ty: MirType

/** The layout of a data type at particular type arguments: one entry per variant. */
private struct DataLayout
    variants: Buf[VariantLayout]

/** One compiled copy of a function: a generic function has one per list of type arguments it is
 * called with, and a local function of a generic function one per copy of that function. */
private struct Instance
    function: usize
    type_args: Buf[&Type]
    /** Whether this is the function's closure entry rather than the function itself. */
    entry: bool
    /** `Written` for a function of the program; otherwise the kind of function lowering makes for
     * the type `type_args[0]`, which no source declares: its structural `==` or hash, its type
     * record's equality entries, or the comparison and hash of values of unknown type. */
    generated: u8

/** The layout of a closure of one function: its descriptor, and where each captured value is kept,
 * the captured locals first, then the captured top-level parameters. The entry's address is at
 * offset 0. A closure that captures nothing is constant. */
private struct ClosureShape
    descriptor: usize
    fields: Buf[FieldSlot]

private struct Lowering
    program: TProgram
    /** The program's string literals, each once, and each one's index. */
    strings: Buf[string]
    string_index: Map[string, usize]
    instances: Buf[Instance]
    /** Each instance's index, by its function and type arguments. */
    instance_index: Map[string, usize]
    descriptors: Buf[Descriptor]
    /** The type records, and each one's index by the type it describes. */
    records: Buf[TypeRecord]
    record_index: Map[string, usize]
    closures: Buf[ClosureConstant]
    /** The program's trap sites, each once, and each one's index by its unit, offset and reason. */
    traps: Buf[TrapSite]
    trap_index: Map[string, usize]
    /** Each closure layout, and each constant closure's index, by function instance. */
    shapes: Map[string, ClosureShape]
    closure_index: Map[string, usize]
    /** The descriptor of a box for each machine type, by the type's name. */
    boxes: Map[string, usize]
    layouts: Buf[DataLayout]
    /** Each layout's index, by the data type it lays out. */
    layout_index: Map[string, usize]
    /** The type arguments of the instance being lowered, and the function they belong to. */
    subst: Buf[&Type]
    subst_owner: usize
    /** The value holding each parameter of the top-level function, or `None` for a unit one or, in
     * a local function, one it does not capture. */
    param_values: Buf[Option[usize]]
    /** The locals of the top-level function the code being lowered belongs to, and whether each is
     * kept in a box: a `var` that a closure captures lives on the heap, so the closure and the code
     * around it share it. The local's own place then holds the box. */
    locals: Buf[TLocal]
    boxed: Buf[bool]
    /** Where each local is kept: in this function's own slot, or behind a captured address; `None`
     * for one with no runtime value or that this function does not reach. */
    local_slots: Buf[Option[Place]]
    values: Buf[MirType]
    slots: Buf[MirType]
    blocks: Buf[MirBlock]
    /** The block instructions are being added to, and those instructions. */
    current: usize
    insts: Buf[Inst]
    loops: Buf[LoopTarget]
    /** The unit the function being lowered was declared in, which its spans are offsets into. */
    unit: usize
    /** The function's block for each trap site it reaches, made when first needed, so the checks
     * of one operation share a block and different operations never do. */
    trap_blocks: Map[usize, usize]
    returns_value: bool
    /** The machine type of each module-level value, or `None` for one with no runtime value. */
    global_types: Buf[Option[MirType]]
    /** Where the slots of methods with type parameters of their own begin in a method table: past
     * every position the checker gave any type's table. */
    generic_base: usize
    /** Each slot of a method with type parameters of their own, at `generic_base` plus its index,
     * and each one's index by its key. */
    generic_slots: Buf[GenericSlot]
    generic_index: Map[string, usize]
    /** The descriptors whose method tables hold a method with type parameters of its own, each with
     * the type it describes, so a slot found later is filled in them too. */
    generic_holders: Buf[GenericHolder]
    /** The type each record describes, by the record's index. */
    record_types: Buf[&Type]
    /** The records a type pattern tests against, each once. */
    tested: Buf[usize]
    /** Whether the program compares or hashes a value of unknown type, which reads the equality
     * entries of its type's record: every record then gets them. */
    runtime_equality: bool
    /** Whether the function being lowered is the core library's, or one lowering makes: its traps
     * report where the program entered the library, and its calls that may run the program's own
     * code keep that place across them. */
    library: bool
    /** The span of the innermost expression being lowered, where a call made for it is placed. */
    here: Span
    /** For each position of a method table, the calls through it: the method's name, and the static
     * type of the receiver, `Any` where that is not known. A table holds a method only at a position
     * some call reaching its type uses, so a method reached only through tables is compiled only when
     * called: a data type's `Display` costs nothing in a program that never shows it. And a method
     * that makes an instance of a larger type, as an iterator's `zipWithIndex` does, does not fill
     * the tables of every type it makes in turn. */
    slot_calls: Buf[Buf[SlotCall]]
    /** Whether a position has come into use since the tables were last filled. */
    new_slots: bool
    /** The Sysl bindings whose bodies have been compiled, in that order. */
    bound: Buf[MirBinding]
    /** Whether the program calls a function value: until it does, no descriptor of a class or data
     * type holds the `apply` such a call would run, so none is compiled for it. */
    calls_values: bool
    /** The index of the function being lowered among the program's functions. */
    function_index: usize
    /** The calls through method tables made on a receiver of a known static type, in the order the
     * functions holding them are lowered. */
    dispatches: Buf[DispatchCall]
    /** Whether options of pointer-shaped types are kept as pointers: see `representation.sysl`. */
    options: OptionPlan
    /** For each instance that adapts a method of an option kept as a pointer to its object's method
     * table, by the instance's index, where it converts. */
    adapters: Map[usize, TableAdapter]
    /** The objects made at compile time, and for each module-level value whether it is one: 0 not
     * yet looked at, 1 being looked at, 2 decided, with `constant_values` holding the object, or
     * `None` for a value made before `main` runs. */
    constants: Buf[ConstantObject]
    /** Each constant object's index, by its descriptor and fields, so equal ones are made once. */
    constant_index: Map[string, usize]
    constant_state: Buf[u8]
    constant_values: Buf[Option[Operand]]
    /** Whether a module-level value's initializer is being made at compile time, where a vector
     * literal may be too: it runs once, so its one object is the object it would have made. */
    in_global: bool
    /** The Sysl handles whose objects have been laid out, each once. */
    handles: Buf[MirHandle]
    /** Whether the program shows a value of unknown type, which reads the `display` or `debug`
     * entry of its type's record: every record then gets them. */
    runtime_rendering: bool
    /** Where a call of the instance being lowered in tail position jumps, when its body has one:
     * the block after the parameters have been stored, which `param_slots` then hold. */
    tail_head: Option[usize]
    param_slots: Buf[Option[Place]]
    /** Whether the instance being lowered returns its body's value with nothing after it, so a call
     * in tail position returns at once (see `returned_call`); a class's constructor publishes its
     * object after the body, and nothing generated has a body. */
    tail_calls: bool
    /** The C handles whose objects have been laid out, each once. */
    c_handles: Buf[MirHandle]
    /** The trampolines C calls Avin functions through, and the callback each one's function
     * converts for, by the instance index of that function. */
    trampolines: Buf[MirTrampoline]
    c_callbacks: Map[usize, CCallbackPlan]
    /** The conformance questions already answered. */
    memo: ConformanceMemo
    /** The receivers of the calls `slot_calls` records, by position and method name. */
    slot_receivers: Map[string, Buf[KnownType]]
    /** Whether some object has the record as its own type's, by the record's index: only such a
     * record's equality and rendering entries can be called. */
    object_records: Buf[bool]
    /** The local functions made into values, by the symbol of the top-level function they are in. */
    local_values: Map[usize, Buf[usize]]
    /** For each local function, its number among its top-level function's local functions of its
     * name, from 1 in the order they are declared; 0 for a top-level function. */
    local_ordinals: Buf[usize]
    /** How many objects and trampolines each owner has made so far, which name the next by place. */
    place_counts: Map[string, usize]
    /** The qualified name of the module-level value whose objects are being made at compile time. */
    constant_owner: string
    /** The top-level functions and methods declared in each unit, by the unit's index, found when
     * the first trap site in that unit is named. */
    unit_functions: Map[usize, Buf[usize]]

/** A method table's entry for an option kept as a pointer, `option`: the method takes the pointer
 * where its trait's method takes `Self`, so the entry takes the object, in `selfs`, and gives an
 * object back for a `Self` result. */
private struct TableAdapter
    option: &Type
    selfs: Buf[bool]
    result: bool

/** A call through a method table position, in the function at index `function`, whose code is the
 * value `code`: at position `position`, on a receiver of static type `receiver`. */
private struct DispatchCall
    function: usize
    code: usize
    position: usize
    receiver: &Type

/** One slot for a method with type parameters of its own, at one list of its own type arguments: a
 * call through a method table to `name` at checker position `position` with `type_args`, on a
 * receiver of static type `receiver`, reaches it. Each type of that receiver holding that method at
 * that position fills the slot with its implementation instantiated at those arguments. */
private struct GenericSlot
    position: usize
    name: string
    type_args: Buf[&Type]
    receiver: &Type

/** A call through a method table position: of the method `name`, on a receiver of static type
 * `receiver`. */
private struct SlotCall
    name: string
    receiver: &Type

private struct GenericHolder
    descriptor: usize
    ty: &Type

/** A type with the number a `ConformanceMemo` gives it, where it names no type parameter. */
struct KnownType
    ty: &Type
    id: Option[usize]

/** The answers to the conformance questions lowering asks again and again of the types of a
 * finished program: which instance of a class or trait a type is, and whether a value of one type
 * always has another. Each type that names no type parameter has a number, by its `type_key`, and an
 * answer is kept by the numbers it was asked of. A type naming a type parameter or an unsolved type
 * means something different where it is named, so a question of one is asked afresh each time. */
struct ConformanceMemo
    type_ids: Map[string, usize]
    ancestors: Map[usize, Option[&Type]]
    always: Map[usize, bool]

    /** `t` with its number, given when first asked for. */
    known(*self, t: &Type) -> KnownType
        if names_type_parameter(t) then return KnownType(t, None)
        val key = type_key(t)
        if self.type_ids.get(key) is Some(id) then return KnownType(t, Some(id))
        val id = self.type_ids.len()
        self.type_ids.put(key, id)
        KnownType(t, Some(id))

    /** What `holding_ancestor` answers of `t` and `target`. */
    ancestor(*self, f: Conformances, t: KnownType, target: usize) -> Option[&Type]
        val a = t.id match
            Some(a) -> a
            None -> return holding_ancestor(f, t.ty, target)
        val key = pair_key(a, target)
        if self.ancestors.get(key) is Some(known) then return known
        val answer = holding_ancestor(f, t.ty, target)
        self.ancestors.put(key, answer)
        answer

    /** What `value_always_is` answers of `from` and `to`. */
    always_is(*self, f: Conformances, from: KnownType, to: KnownType) -> bool
        val a = from.id match
            Some(a) -> a
            None -> return value_always_is(f, from.ty, to.ty)
        val b = to.id match
            Some(b) -> b
            None -> return value_always_is(f, from.ty, to.ty)
        val key = pair_key(a, b)
        if self.always.get(key) is Some(known) then return known
        val answer = value_always_is(f, from.ty, to.ty)
        self.always.put(key, answer)
        answer

/** A memo with no answers yet. */
conformance_memo() -> ConformanceMemo = ConformanceMemo(map(), map(), map())

/** One number for a pair of numbers each below 2^32. */
private pair_key(a: usize, b: usize) -> usize = a * 4294967296 + b

// Every function that is not generic is compiled once; each generic function is compiled for each
// list of type arguments a compiled call gives it, as those calls are found. An abstract method has
// no code, and an abstract class's constructor is never called: its subclasses run its initializer.
lower_program(program: TProgram) -> MirProgram
    var global_types: Buf[Option[MirType]] = buf()
    for g in program.globals
        global_types.push(mir_type(solve(program.vars, program.symbols[g.init].result.unwrap_or(Unit))))
    // Each `lazy val` also has a state word, after every module-level value: see `lazy_state`.
    for g in program.globals
        if g.lazy then global_types.push(Some(MInt(64)))
    var generic_base = 0usize
    for k in program.classes
        if k.table.len() > generic_base then generic_base = k.table.len()
    for d in program.data
        if d.table.len() > generic_base then generic_base = d.table.len()
    for b in program.builtins
        if b.table.len() > generic_base then generic_base = b.table.len()
    val local = local_values(program)
    var l = Lowering(program, buf(), map(), buf(), map(), buf(), buf(), map(), buf(), buf(), map(), map(), map(), map(), buf(), map(), buf(), 0, buf(), buf(), buf(), buf(), buf(), buf(), buf(), 0, buf(), buf(), 0, map(), false, global_types, generic_base, buf(), map(), buf(), buf(), buf(), false, false, Span(0, 0), buf(), false, buf(), false, 0, buf(), option_plan(program), map(), buf(), map(), buf(), buf(), false, buf(), false, None, buf(), false, buf(), buf(), map(), conformance_memo(), map(), buf(), local, local_ordinals(program), map(), "", map())
    // Record 0 is for the objects no value of the program's types is: the boxes of captured
    // variables. A closure's record is its function type's.
    l.records.push(TypeRecord("a captured variable", buf(), None, None, None, None, false, buf(), 0))
    l.record_types.push(Unit)
    l.object_records.push(true)
    // A module-level value made at compile time has no storage: every read of it is the constant.
    for _ in program.globals
        l.constant_state.push(0)
        l.constant_values.push(None)
    for g in 0..<program.globals.len()
        if global_constant(&l, g) is Some(_) then l.global_types[g] = None
    // The core library's functions are compiled only as the program reaches them, so a program
    // carries none of the library it does not use, and builds no shim for a binding it never calls.
    // A data type's implementation of a trait is compiled as it is called, directly or through a
    // method table, and a method the checker withdrew, a derived `Display` a field of its type
    // lacks, never is.
    var implementing: Buf[bool] = buf()
    for _ in program.symbols do implementing.push(false)
    for d in program.data
        for j in 0..<d.methods.len()
            if d.implementing[j] then implementing[d.methods[j]] = true
        for m in d.withdrawn
            implementing[m] = true
    // A top-level function with a generic local function compiles the code inside that function
    // only through the calls and function values that reach it, each with its type arguments.
    var generic_locals: Buf[bool] = buf()
    for _ in program.symbols do generic_locals.push(false)
    for s in program.symbols
        if s.root is Some(r)
            if s.decl.type_params.len() > 0 then generic_locals[r] = true
    for i in 0..<program.symbols.len()
        var inside_generic_local = false
        if program.symbols[i].root is Some(r) then inside_generic_local = generic_locals[r]
        if !inside_generic_local && !is_generic(program, i) && !never_compiled(program, i) && !in_core_library(program, i) && !implementing[i] then instance(&l, i, buf())
    val entry: Option[usize] = program.entry match
        Some(id) -> Some(instance(&l, id, buf()))
        None -> None
    var entry_arguments: Option[usize] = None
    if program.entry is Some(id) && program.symbols[id].params.len() == 1
        for i in 0..<program.symbols.len()
            val s = program.symbols[i]
            if s.module_name == "avin.process" && s.name == "args" && s.params.len() == 0 && s.owner_class is None && s.receiver is None
                entry_arguments = Some(instance(&l, i, buf()))
                break
    val strings = string_descriptor(&l)
    var tests: Buf[MirTest] = buf()
    var answered: Option[usize] = None
    for i in 0..<program.symbols.len()
        val s = program.symbols[i]
        if s.module_name == CoreModule && s.name == "testAnswered" && s.owner_class is None && s.receiver is None
            answered = Some(i)
            break
    for t in program.tests
        var answer: Option[usize] = None
        var site = 0usize
        if t.answers is Some(e)
            if answered is Some(reader)
                var args: Buf[&Type] = buf()
                args.push(e)
                answer = Some(instance(&l, reader, args))
                // An `Err` is reported at the test's own name, as the place the program entered the
                // library that read it.
                val saved = l.unit
                l.unit = program.symbols[t.symbol].unit
                site = trap_site(&l, "", program.symbols[t.symbol].decl.name_span)
                l.unit = saved
        tests.push(MirTest(instance(&l, t.symbol, buf()), answer, site, hook_instance(&l, t.setup), hook_instance(&l, t.teardown), hook_instance(&l, t.setup_all), hook_instance(&l, t.teardown_all)))
    val init: Option[usize] = program.init match
        Some(id) -> Some(instance(&l, id, buf()))
        None -> None
    var functions: Buf[MirFunction] = buf()
    var k = 0usize
    while true
        while k < l.instances.len()
            functions.push(lower_function(&l, k))
            k += 1
        // A call through a position no call used before fills it in every table made so far.
        if fill_used_slots(&l) then continue
        // A comparison of values of unknown type calls the entries of their type's record, so once
        // the program makes one, every record gets them; making them may lay out more types. Showing
        // such a value does the same with the rendering entries.
        val compared = l.runtime_equality && add_equality_entries(&l)
        val shown = l.runtime_rendering && add_rendering_entries(&l)
        if !compared && !shown then break
    add_variant_ancestors(&l)
    functions = devirtualize(functions, l.descriptors, dispatch_sites(&l))
    // An object whose kind has a finalizer, a Sysl or C handle, must stay an object, however
    // little it is used: its finalizer is what gives its reference back.
    var finalized: Buf[bool] = buf()
    for _ in 0..<l.descriptors.len() do finalized.push(false)
    for h in l.handles do finalized[h.descriptor] = true
    for h in l.c_handles do finalized[h.descriptor] = true
    functions = scalar_replace(functions, l.descriptors, finalized)
    MirProgram(functions,l.strings, l.descriptors, l.records, l.closures, l.constants, l.traps, l.global_types, entry, init, l.bound, l.handles, tests, program.testing, entry_arguments, strings, l.c_handles, l.trampolines, global_names(program), string_names(l.strings))

/** Each string's name: the first 16 hexadecimal digits of the SHA-256 of its bytes. Two different
 * strings of one program that share them, which no program has been seen to hold, are told apart
 * by the later one's index after a dot. */
string_names(strings: Buf[string]) -> Buf[string]
    var names: Buf[string] = buf()
    var taken: Map[string, usize] = map()
    for i in 0..<strings.len()
        var name = content_key(strings[i])[0..<16]
        if taken.get(name) is Some(_) then name = s"$name.$i"
        taken.put(name, i)
        names.push(name)
    names

/** Each symbol's `local_ordinals` entry: a local function's number among those of its name in its
 * top-level function, which the checker declares in the order they are written. */
private local_ordinals(program: TProgram) -> Buf[usize]
    var out: Buf[usize] = buf()
    var counts: Map[string, usize] = map()
    for s in program.symbols
        var n = 0usize
        if s.root is Some(root)
            val key = s"$root ${s.name}"
            n = counts.get(key).unwrap_or(0) + 1
            counts.put(key, n)
        out.push(n)
    out

/** Whether a function belongs to the core library's module, `avin`, or one under it. */
private in_core_library(program: TProgram, id: usize) -> bool
    val m = program.symbols[id].module_name
    m == "avin" || m.starts_with("avin.")

/** Whether a function is the constructor of a class, which allocates the object it yields. */
private is_class_constructor(program: TProgram, id: usize) -> bool
    val symbol = program.symbols[id]
    symbol.owner_class match
        Some(k) -> symbol.constructor && program.classes[k].constructor == id
        None -> false

/** Whether a function has no code: an abstract method, or an abstract class's or a trait's constructor. */
private never_compiled(program: TProgram, id: usize) -> bool
    val symbol = program.symbols[id]
    if is_abstract_method(symbol) then return true
    symbol.owner_class match
        Some(k) -> symbol.constructor && program.classes[k].constructor == id && (program.classes[k].decl.modifier == "abstract" || program.classes[k].decl.modifier == "trait")
        None -> false

// An object is its fields in order, each at a multiple of 8 bytes; its descriptor is in the header
// the collector keeps before it.
/** Where a descriptor's tag is: after the collector's kind, four words. */
private const DescriptorTag: usize = 32

private field_size(t: MirType) -> usize = t match
    MInt(bits) -> usize((bits + 63) / 64) * 8
    _ -> 8

/** The layout of a data, tuple or class type, which must be concrete; made when first asked for. A
 * tuple is laid out as a data type with one variant whose fields are its parts, and a class as one
 * whose fields are the class's: its parameters, then the fields its body declares. */
private layout(l: *Lowering, t: &Type) -> DataLayout
    // The descriptors are named by the type's qualified spelling, a variant's after its type's.
    val key = stable_type_key(l.program, t)
    val identity = type_key(t)
    if l.layout_index.get(identity) is Some(index) then return l.layouts[index]
    var variants: Buf[VariantLayout] = buf()
    val record = object_record(l, t)
    *t match
        Data(id, _, args) ->
            val d = l.program.data[id]
            val methods = method_table(l, t)
            val call = call_entry(l, t)
            for v in 0..<d.variants.len()
                variants.push(variant_layout(l, key + "." + d.variants[v].name, v, variant_fields(d, id, v, args), true, methods, record, call))
        Tuple(items) -> variants.push(variant_layout(l, key, 0, items, true, method_table(l, t), record, None))
        Class(id, _, args) ->
            if is_array_class(l.program.classes[id])
                // An array's descriptor gives the size of an element; the elements follow the length.
                val element = mir_type(args[0])
                val methods = method_table(l, t)
                val shape = VariantLayout(l.descriptors.len(), buf())
                l.descriptors.push(array_descriptor(key, element_size(element), [element is Some(MRef)], methods, record, call_entry(l, t)))
                variants.push(shape)
            else
                var fields: Buf[&Type] = buf()
                for f in l.program.classes[id].fields
                    fields.push(substitute(f.ty.unwrap_or(ErrorType), class_owner(id), args))
                val shape = variant_layout(l, key, 0, fields, false, method_table(l, t), record, call_entry(l, t))
                variants.push(shape)
                // A Sysl handle has no fields of its own: its first word is the counted Sysl
                // reference the shim keeps there, which the collector does not trace, and gives back
                // in the handle's finalizer; its second is its owner, who alone may use it.
                val k = l.program.classes[id]
                if handle_target(k.decl) is Some(target)
                    l.descriptors[shape.descriptor].size = 16
                    // An instance of a generic handle class is a handle on the Sysl type's instance at
                    // its type arguments, which the shim spells as it spells the values it converts.
                    var arguments: Buf[&Crossing] = buf()
                    for a in args
                        var unused: Buf[Operand] = buf()
                        arguments.push(crossing(l, a, &unused))
                    l.handles.push(MirHandle(handle_trap_name(k.decl, k.name), target, handle_finalizer(id, args), shape.descriptor, k.unit, k.decl.name_span, arguments))
                // A C handle's first word is its C pointer and its second its owner, as a Sysl
                // handle's; its third is the C references it holds to the handles it keeps, which
                // the C unit's glue keeps off the heap; its fourth and fifth, which the collector
                // traces, the Avin objects it keeps and the view it lent last; and its sixth the
                // number of the record `attach:` gave C. Its finalizer is the C unit's.
                elif c_handle_type(k.decl) is Some(target)
                    l.descriptors[shape.descriptor].size = CHandleSize
                    l.descriptors[shape.descriptor].refs.push(CHandleKept)
                    l.descriptors[shape.descriptor].refs.push(CHandleLent)
                    l.c_handles.push(MirHandle(k.name, target, s"avin_c_finalize_$id", shape.descriptor, k.unit, k.decl.name_span, buf()))
                // A view or a block is laid out as the runtime's `CMemory`: its address, owner,
                // length and closed flag, then the reasons it traps with and its lender, which the
                // collector traces. A block's finalizer, the runtime's, frees its bytes.
                elif c_memory_class(l.program.classes, id) is Some(kind)
                    l.descriptors[shape.descriptor].size = CMemorySize
                    l.descriptors[shape.descriptor].refs = buf()
                    l.descriptors[shape.descriptor].refs.push(CMemoryClosedReason)
                    l.descriptors[shape.descriptor].refs.push(CMemoryForeignReason)
                    l.descriptors[shape.descriptor].refs.push(CMemoryLender)
                    if kind is MemBlock then l.c_handles.push(MirHandle(k.name, "", "avin_rt_c_block_finalize", shape.descriptor, k.unit, k.decl.name_span, buf()))
                // An opaque value's object is the bytes of its C value, as the C unit measured them,
                // which the collector does not trace.
                elif c_value_type(k.decl) is Some(_)
                    val size = usize(c_value(l, c_value_key(CConstInteger, c_size_expr(c_value_own(id)))).integer)
                    l.descriptors[shape.descriptor].size = (size + 7) / 8 * 8
        _ -> panic("a layout of a type that is not data, a tuple or a class: " + key)
    if holds_generic_methods(l, t)
        for v in variants
            hold_generic_slots(l, v.descriptor, t)
    val result = DataLayout(variants)
    l.layout_index.put(identity, l.layouts.len())
    l.layouts.push(result)
    result

/** The symbol of the shim's finalizer for the Sysl handle class `id` at the type arguments `args`:
 * each instance of a generic handle class is a handle of its own, named by its type arguments. */
private handle_finalizer(id: usize, args: Buf[&Type]) -> string
    if args.len() == 0 then return s"avin_handle_finalize_$id"
    var named: Buf[&Type] = buf()
    for a in args
        named.push(a)
    s"avin_handle_finalize_${id}_${content_key(type_key(Tuple(named)))}"

// One variant's fields at their offsets, and its descriptor; a variant with no field data is one
// constant object, unless `shared` is false: every object of a class is its own, for its identity.
private variant_layout(l: *Lowering, name: string, tag: usize, field_types: Buf[&Type], shared: bool, methods: Buf[Option[usize]], record: usize, call: Option[usize]) -> VariantLayout
    var fields: Buf[Option[FieldSlot]] = buf()
    var refs: Buf[usize] = buf()
    var size = 0usize
    for field in field_types
        mir_type(field) match
            Some(m) ->
                if m is MRef then refs.push(size)
                fields.push(Some(FieldSlot(size, m)))
                size += field_size(m)
            None -> fields.push(None)
    val shape = VariantLayout(l.descriptors.len(), fields)
    l.descriptors.push(Descriptor(name, tag, size, refs, shared && size == 0, methods, record, Fields, call))
    shape

/** The bytes an array element of machine type `t` takes: what storing one writes, a power of two up
 * to a word and whole words past it, and none for a type with no runtime value. */
private element_size(t: Option[MirType]) -> usize = t match
    Some(MInt(bits)) -> if bits <= 8 then 1 elif bits <= 16 then 2 elif bits <= 32 then 4 else field_size(MInt(bits))
    Some(MBool) -> 1
    Some(_) -> 8
    None -> 0

// The method table of a class instance or a data value: for each slot, the instance of the method
// that fills it, with the type arguments of the class or trait that declares the method as the
// instance sees them, or for a method an impl adds to a data type, the value's own. Each instance of
// a generic type has its own table, which every variant of a data type shares. An abstract method's
// slot is empty, as is a position no trait of the type uses. A method with type parameters of its own
// is no one function, so its position is empty too: each list of its own type arguments that a call
// through a table uses has a slot past `generic_base` instead.
private method_table(l: *Lowering, t: &Type) -> Buf[Option[usize]]
    var table: Buf[Option[usize]] = buf()
    val entries = checker_table(l, t)
    val known = known_type(l, t)
    val missing = unheld_positions(l, known)
    for p in 0..<entries.len()
        val m = entries[p] match
            Some(m) -> m
            None ->
                table.push(None)
                continue
        val symbol = l.program.symbols[m]
        if is_abstract_method(symbol) || symbol.decl.type_params.len() > 0 || missing[p] || !slot_used(l, p, symbol.decl.name, known)
            table.push(None)
            continue
        table.push(Some(table_entry(l, t, m, implementation_args(l, t, m), p)))
    table

// What a method table of type `t` holds for method `m` at checker position `position`: the instance
// of `m`, or, for an option kept as a pointer, whose table only the object it stands for carries, one
// that takes that object where the trait's method takes `Self` and calls `m` with the pointer. A
// trait's default body takes the object itself.
private table_entry(l: *Lowering, t: &Type, m: usize, type_args: Buf[&Type], position: usize) -> usize
    val code = instance(l, m, type_args)
    if is_trait_method(l, l.program.symbols[m]) then return code
    if !pointer_option(l, t) && !value_boxed(l, t) then return code
    val key = s"adapter ${instance_key(m, type_args, false)}"
    if l.instance_index.get(key) is Some(index) then return index
    val symbol = l.program.symbols[m]
    val declared = trait_method_at(l, t, position, symbol.decl.name)
    var selfs: Buf[bool] = buf()
    for i in 0..<symbol.params.len()
        selfs.push(i == 0 || (declared match
            Some(d) -> i < l.program.symbols[d].params.len() && is_self_type(l.program.symbols[d].params[i])
            None -> false))
    val result = declared match
        Some(d) -> is_self_type(l.program.symbols[d].result.unwrap_or(Unit))
        None -> false
    val index = l.instances.len()
    l.instances.push(Instance(m, type_args, false, OptionAdapter))
    l.instance_index.put(key, index)
    l.adapters.put(index, TableAdapter(t, selfs, result))
    index

/** Whether a value of type `t` is kept in a box when it is an `Any` or a trait's value: a built-in
 * value that is no reference. */
private value_boxed(l: *Lowering, t: &Type) -> bool = is_builtin(t) && !(machine(l, t) is Some(MRef))

/** The method a trait `t` conforms to declares at checker position `position`, named `name`. */
private trait_method_at(l: *Lowering, t: &Type, position: usize, name: string) -> Option[usize]
    for k in 0..<l.program.classes.len()
        val c = l.program.classes[k]
        if c.decl.modifier != "trait" || position < c.base || position >= c.base + c.methods.len() then continue
        val m = c.methods[position - c.base]
        if l.program.symbols[m].decl.name != name then continue
        if ancestor_type(l.program.classes, l.program.data, t, k) is Some(_) then return Some(m)
    None

/** The function a call of a value of class or data type `t` as a function value runs: the type's
 * `apply` for the function type it is a subtype of, once the program calls a function value. */
private call_entry(l: *Lowering, t: &Type) -> Option[usize]
    if !l.calls_values then return None
    val m = *t match
        Class(k, _, _) -> l.program.classes[k].call?
        Data(d, _, _) -> l.program.data[d].call?
        _ -> return None
    Some(instance(l, m, implementation_args(l, t, m)))

/** Whether `t` names a type parameter or an unsolved type anywhere in it. */
private names_type_parameter(t: &Type) -> bool = *t match
    TypeVar(_, _, _) -> true
    Var(_) -> true
    Tuple(items) -> any_names_type_parameter(items)
    Function(params, result, _) -> any_names_type_parameter(params) || names_type_parameter(result)
    ByName(inner) -> names_type_parameter(inner)
    Data(_, _, args) -> any_names_type_parameter(args)
    Class(_, _, args) -> any_names_type_parameter(args)
    _ -> false

private any_names_type_parameter(items: Buf[&Type]) -> bool
    for item in items
        if names_type_parameter(item) then return true
    false

/** Whether a call through `position` of a method table reaches the method `name` on an object of type
 * `t`: one of that method whose receiver's static type `t` has. Different traits' methods may share
 * a position in different types' tables, so the name tells them apart. */
private slot_used(l: *Lowering, position: usize, name: string, t: KnownType) -> bool
    val receivers = l.slot_receivers.get(s"$position $name") match
        Some(rs) -> rs
        None -> return false
    for receiver in receivers
        if always_is_known(l, t, receiver) then return true
    false

/** Records a call through `position` of a method table, of the method `name`, on a receiver of static
 * type `receiver`, `Any` where any object may be the receiver. */
private use_slot(l: *Lowering, position: usize, name: string, receiver: &Type)
    while l.slot_calls.len() <= position
        l.slot_calls.push(buf())
    // The receivers already recorded for this method at this position are the ones kept by
    // `slot_receivers`, in the order they were recorded.
    val key = s"$position $name"
    var receivers: Buf[KnownType] = l.slot_receivers.get(key).unwrap_or(buf())
    for k in receivers
        if same_type(k.ty, receiver) then return
    var known = l.slot_calls[position]
    known.push(SlotCall(name, receiver))
    l.slot_calls[position] = known
    receivers.push(known_type(l, receiver))
    l.slot_receivers.put(key, receivers)
    l.new_slots = true

// Fills the positions that came into use since the last time in the method tables already made, each
// with its type's method there. Whether that made an instance to compile is the result.
private fill_used_slots(l: *Lowering) -> bool
    if !l.new_slots then return false
    l.new_slots = false
    val before = l.instances.len()
    for i in 0..<l.descriptors.len()
        val t = l.record_types[l.descriptors[i].record]
        if !(*t is Data(_, _, _) || *t is Class(_, _, _) || *t is Tuple(_) || is_builtin(t)) then continue
        if l.descriptors[i].call is None
            if call_entry(l, t) is Some(f) then l.descriptors[i].call = Some(f)
        val old = l.descriptors[i].methods
        val table = method_table(l, t)
        var methods: Buf[Option[usize]] = buf()
        var changed = false
        for p in 0..<old.len()
            var entry = old[p]
            if entry is None && p < table.len()
                if table[p] is Some(_)
                    entry = table[p]
                    changed = true
            methods.push(entry)
        if changed then l.descriptors[i].methods = methods
    l.instances.len() > before

/** The lowering's view of conformances: of concrete types only, so with no type parameters in scope,
 * and the bounds of the impls for tuples, which a tuple's parts must meet. */
private lowering_conformances(l: *Lowering) -> Conformances =
    Conformances(l.program.classes, l.program.data, l.program.builtins, l.program.conditional, l.program.core, l.program.bounds, None, map())

// For each position of `t`'s method table, whether it belongs to a trait `t` does not conform to at
// its type arguments, though an impl with bounds of its own places the trait in every instance's
// table. No call reaches such a position, so it stays empty and its methods are not compiled for
// this instance. A tuple's table holds every trait its arity's impls state, and a tuple conforms to
// one only where its parts meet that impl's bounds: `(int, unit)` is no `Ord`, for `unit` is not.
private unheld_positions(l: *Lowering, known: KnownType) -> Buf[bool]
    val t = known.ty
    val entries = checker_table(l, t)
    var out: Buf[bool] = buf()
    for _ in entries do out.push(false)
    if *t is Tuple(_)
        val f = lowering_conformances(l)
        for b in l.program.builtins
            if !is_tuple_owner(b.owner) || !builtin_covers(b.ty, t) || tuple_parts_hold(f, b.owner, b.params, t) then continue
            if *b.trait_type is Class(k, _, _)
                val symbol = l.program.classes[k]
                for j in 0..<symbol.methods.len()
                    if symbol.base + j < out.len() then out[symbol.base + j] = true
        return out
    val owner = *t match
        Class(k, _, _) -> class_owner(k)
        Data(d, _, _) -> data_owner(d)
        _ -> return out
    // An impl with bounds of its own may be of the type or of a class it extends: a bounded impl for
    // an abstract `Vector[T]` places its trait in the table of every subclass's instance as well.
    var conditional = false
    for x in l.program.conditional
        if x.owner == owner then conditional = true
        elif x.owner >= class_owner(0) && x.owner < class_owner(l.program.classes.len()) && ancestor_type(l.program.classes, l.program.data, t, x.owner - class_owner(0)) is Some(_) then conditional = true
    if !conditional then return out
    val f = lowering_conformances(l)
    for k in 0..<l.program.classes.len()
        val symbol = l.program.classes[k]
        if symbol.decl.modifier != "trait" then continue
        if ancestor_type(l.program.classes, l.program.data, t, k) is None then continue
        if held_ancestor(l, known, k) is Some(_) then continue
        for j in 0..<symbol.methods.len()
            if symbol.base + j < out.len() then out[symbol.base + j] = true
    out

/** The checker's method table of class, data or built-in type `t`: the method at each position. */
private checker_table(l: *Lowering, t: &Type) -> Buf[Option[usize]] = *t match
    Class(k, _, _) -> l.program.classes[k].table
    Data(d, _, _) -> l.program.data[d].table
    _ -> builtin_table(l, t)

/** A built-in type's table, which the first of its conformances keeps. An integer width with no
 * impl of its own has the integer family's. */
private builtin_table(l: *Lowering, t: &Type) -> Buf[Option[usize]]
    for b in l.program.builtins
        if same_type(b.ty, t) then return b.table
    for b in l.program.builtins
        if builtin_covers(b.ty, t) then return b.table
    buf()

/** The type arguments of the class or trait declaring method `m` as a value of `t` sees them, or for
 * a method an impl adds to a data type, the value's own: the leading type arguments of the instance
 * of `m` that `t`'s table holds. A method of an impl for every integer width takes the width. */
private implementation_args(l: *Lowering, t: &Type, m: usize) -> Buf[&Type]
    if l.program.symbols[m].type_owner == integer_owner()
        var width: Buf[&Type] = buf()
        width.push(t)
        return width
    // A method of an impl for every tuple of an arity takes the tuple's parts.
    if is_tuple_owner(l.program.symbols[m].type_owner)
        if *t is Tuple(parts) then return parts
    if l.program.symbols[m].owner_class is None
        if *t is Data(_, _, xs) then return xs
        return buf()
    val owner = l.program.symbols[m].owner_class.unwrap()
    ancestor_type(l.program.classes, l.program.data, t, owner) match
        Some(a) -> *a match
            Class(_, _, xs) -> xs
            _ -> buf()
        None -> buf()

/** Whether `t`'s method table holds a method with type parameters of its own. */
private holds_generic_methods(l: *Lowering, t: &Type) -> bool
    for entry in checker_table(l, t)
        if entry is Some(m)
            if l.program.symbols[m].decl.type_params.len() > 0 then return true
    false

// A descriptor whose type's table holds a method with type parameters of its own is filled in every
// slot already made for such a method, and in each one made later.
private hold_generic_slots(l: *Lowering, descriptor: usize, t: &Type)
    l.generic_holders.push(GenericHolder(descriptor, t))
    for s in 0..<l.generic_slots.len()
        fill_generic_slot(l, descriptor, t, s)

/** The table slot of a call through a method table to the method at checker position `position`,
 * named `name`, with its own type arguments `type_args`: made when first asked for, and filled in
 * every descriptor holding such a method there. */
private generic_slot(l: *Lowering, position: usize, name: string, type_args: Buf[&Type], receiver: &Type) -> usize
    var key = s"$position $name ${type_key(receiver)}"
    for t in type_args
        key = key + "|" + type_key(t)
    if l.generic_index.get(key) is Some(index) then return l.generic_base + index
    val index = l.generic_slots.len()
    l.generic_slots.push(GenericSlot(position, name, type_args, receiver))
    l.generic_index.put(key, index)
    for h in l.generic_holders
        fill_generic_slot(l, h.descriptor, h.ty, index)
    l.generic_base + index

// Fills generic slot `s` of a descriptor of type `t` with `t`'s implementation of the method, at the
// slot's own type arguments after those of the type that declares the implementation. A type holding
// another method at that position, or none, or an abstract one, leaves the slot empty: no call reaching
// the slot is made on it. So does a type a value of the slot's receiver type never has.
private fill_generic_slot(l: *Lowering, descriptor: usize, t: &Type, s: usize)
    val slot = l.generic_slots[s]
    if !always_is(l, t, slot.receiver) then return
    val entries = checker_table(l, t)
    if slot.position >= entries.len() then return
    val m = entries[slot.position] match
        Some(m) -> m
        None -> return
    val symbol = l.program.symbols[m]
    if symbol.decl.name != slot.name || symbol.decl.type_params.len() != slot.type_args.len() || is_abstract_method(symbol) then return
    var args: Buf[&Type] = buf()
    for a in implementation_args(l, t, m)
        args.push(a)
    for a in slot.type_args
        args.push(a)
    val code = table_entry(l, t, m, args, slot.position)
    val index = l.generic_base + s
    val old = l.descriptors[descriptor].methods
    var methods: Buf[Option[usize]] = buf()
    for i in 0..<old.len()
        methods.push(old[i])
    while methods.len() <= index
        methods.push(None)
    methods[index] = Some(code)
    l.descriptors[descriptor].methods = methods

private field_address(l: *Lowering, object: Operand, field: FieldSlot) -> Operand
    val dest = fresh(l, MPtr)
    l.insts.push(Offset(dest, object, field.offset))
    Value(dest)

// The fields are evaluated in order before the object is allocated, so a collection while
// allocating sees every one of them as a root.
private construct(l: *Lowering, e: &TExpr, variant: usize, args: Buf[&TExpr]) -> Option[Operand]
    // A value built only of constants is made at compile time, once, however often this runs.
    if constant_construct(l, e, variant, args) is Some(k) then return k.value
    var values: Buf[Option[Operand]] = buf()
    for a in args
        val v = lower_expr(l, a)
        // An argument that never finishes ends the code here: the value is never made.
        if *a.ty is Nothing || (v is None && machine(l, a.ty) is Some(_)) then return None
        values.push(v)
    // An option kept as a pointer is its value, or null for `None`: nothing is allocated.
    if pointer_option(l, e.ty) then return if variant == some_variant(l) then values[0] else Some(NullAddress)
    val shape = layout(l, concrete(l, e.ty)).variants[variant]
    if l.descriptors[shape.descriptor].constant then return Some(ConstObject(shape.descriptor))
    val object = fresh(l, MRef)
    l.insts.push(Alloc(object, shape.descriptor))
    for i in 0..<values.len()
        if shape.fields[i] is Some(field)
            if values[i] is Some(v) then l.insts.push(Store(field_address(l, Value(object), field), v))
    l.insts.push(Publish)
    Some(Value(object))

// Values made at compile time. A data value or a tuple built only of literals and other such values
// is an object written as read-only data, made once however often the expression runs, and equal
// ones are one object: nothing in it can change, and a data value has no identity to tell two equal
// ones apart. A module-level `val` whose initializer is built of such values, other such `val`s and
// vector literals of at most 32 of them is made at compile time too, and not before `main`; one of a
// built-in type is the value itself. A vector is an object with an identity, so it is made at compile
// time only there, where its literal runs once, and never shared with another. A read of such a
// value is its address, and a read of one of its fields is the field's value, so code that reads a
// table of constants compiles to the constants. Anything else, a call or a class's constructor among
// them, leaves the value to be made at run time.

/** What a module-level value's initializer is at compile time: its value, `None` for one with no
 * runtime value. */
private struct Constant
    value: Option[Operand]

/** The value module-level value `g` is at compile time, or `None` where it is made at run time,
 * decided when first asked. */
private global_constant(l: *Lowering, g: usize) -> Option[Operand]
    if l.constant_state[g] == 2 then return l.constant_values[g]
    // A value its own initializer reaches is the checker's to report; it is made at run time.
    if l.constant_state[g] == 1 then return None
    l.constant_state[g] = 1
    val global = l.program.globals[g]
    var made: Option[Operand] = None
    if !global.mutable && !global.lazy && global.object is None
        if l.program.functions[global.init].body is Some(body)
            val outer = l.in_global
            val owner = l.constant_owner
            l.in_global = true
            l.constant_owner = global_name(l.program, g)
            if constant_of(l, body) is Some(k) then made = k.value
            l.in_global = outer
            l.constant_owner = owner
    l.constant_state[g] = 2
    l.constant_values[g] = made
    made

/** The module-level value `g`'s qualified name, which its symbol and the objects made for it are
 * named by: an object's after `object `, since an object may share its name with a data type. */
private global_name(program: TProgram, g: usize) -> string
    val global = program.globals[g]
    val name = module_prefix(global.module_name) + "." + global.name
    if global.object is Some(_) then "object " + name else name

/** The name of each module-level value's storage, by its index among `global_types`: each value's
 * qualified name, then each `lazy val`'s state word as its value's name followed by `#state`. */
private global_names(program: TProgram) -> Buf[string]
    var names: Buf[string] = buf()
    for g in 0..<program.globals.len()
        names.push(global_name(program, g))
    for g in 0..<program.globals.len()
        if program.globals[g].lazy then names.push(global_name(program, g) + "#state")
    names

private constant_of(l: *Lowering, e: &TExpr) -> Option[Constant] = e.kind match
    IntConst(digits) ->
        val bits = int_bits(e.ty)
        if bits > 64 then None else Some(Constant(Some(ConstInt(bits, digits))))
    BoolConst(value) -> Some(Constant(Some(ConstBool(value))))
    CharConst(code) -> Some(Constant(Some(ConstInt(32, code.to_string()))))
    RealConst(value) -> Some(Constant(Some(ConstReal(value))))
    StrConst(value) -> Some(Constant(Some(string_constant(l, value))))
    UnitConst -> Some(Constant(None))
    CConst(name) -> Some(Constant(Some(c_constant(l, e.ty, name))))
    Global(g) -> global_constant(l, g) match
        Some(k) -> Some(Constant(Some(k)))
        None -> None
    Block(items) -> if items.len() == 1 then constant_of(l, items[0]) else None
    Construct(variant, args) -> constant_construct(l, e, variant, args)
    Collection(elements, _) -> if l.in_global then constant_vector(l, e, elements) else None
    _ -> None

/** The values of `items` at compile time, `None` where one of them is not known then. */
private constants_of(l: *Lowering, items: Buf[&TExpr]) -> Option[Buf[Option[Operand]]]
    var values: Buf[Option[Operand]] = buf()
    for x in items
        values.push(constant_of(l, x)?.value)
    Some(values)

// A data value or a tuple, laid out as `construct` lays it out.
private constant_construct(l: *Lowering, e: &TExpr, variant: usize, args: Buf[&TExpr]) -> Option[Constant]
    val values = constants_of(l, args)?
    if pointer_option(l, e.ty)
        if variant != some_variant(l) then return Some(Constant(Some(NullAddress)))
        return if values[0] is Some(v) then Some(Constant(Some(v))) else None
    val shape = layout(l, concrete(l, e.ty)).variants[variant]
    if l.descriptors[shape.descriptor].constant then return Some(Constant(Some(ConstObject(shape.descriptor))))
    var fields: Buf[ConstantField] = buf()
    for i in 0..<values.len()
        if shape.fields[i] is Some(slot)
            val v = values[i] match
                Some(v) -> v
                None -> return None
            fields.push(ConstantField(slot.offset, slot.ty, v))
    Some(Constant(Some(constant_object(l, shape.descriptor, l.descriptors[shape.descriptor].size, fields, true))))

// A vector literal, laid out as the library lays out the vectors it builds: no elements is a
// `Vector0`, and 1 to 32 a `Vector1` holding them in its one leaf, a frozen array.
private constant_vector(l: *Lowering, e: &TExpr, elements: Buf[&TExpr]) -> Option[Constant]
    val t = concrete(l, e.ty)
    val args = *t match
        Class(k, _, a) -> if core_class(l, "Vector") is Some(v) && v == k then a else return None
        _ -> return None
    if elements.len() > 32 then return None
    val values = constants_of(l, elements)?
    if elements.len() == 0
        val empty = layout(l, Class(core_class(l, "Vector0")?, "Vector0", args)).variants[0]
        return Some(Constant(Some(constant_object(l, empty.descriptor, l.descriptors[empty.descriptor].size, buf(), false))))
    val element = mir_type(args[0])?
    val size = element_size(Some(element))
    var cells: Buf[ConstantField] = buf()
    cells.push(ConstantField(0, MInt(64), ConstInt(64, elements.len().to_string())))
    for i in 0..<values.len()
        val v = values[i] match
            Some(v) -> v
            None -> return None
        cells.push(ConstantField(ArrayHeader + i * size, element, v))
    val array = layout(l, Class(core_class(l, "Array")?, "Array", args)).variants[0].descriptor
    val leaf = constant_object(l, array, ArrayHeader + elements.len() * size, cells, false)
    val one = layout(l, Class(core_class(l, "Vector1")?, "Vector1", args)).variants[0]
    if one.fields.len() != 1 then return None
    val slot = one.fields[0]?
    var fields: Buf[ConstantField] = buf()
    fields.push(ConstantField(slot.offset, slot.ty, leaf))
    Some(Constant(Some(constant_object(l, one.descriptor, l.descriptors[one.descriptor].size, fields, false))))

/** The core library's class `name`. */
private core_class(l: *Lowering, name: string) -> Option[usize]
    for k in 0..<l.program.classes.len()
        val c = l.program.classes[k]
        if c.module_name == "avin" && c.name == name then return Some(k)
    None

/** A new constant object; with `shared`, the one already made with the same descriptor and fields,
 * if there is one. */
private constant_object(l: *Lowering, descriptor: usize, size: usize, fields: Buf[ConstantField], shared: bool) -> Operand
    var key = s"$descriptor:$size"
    for f in fields
        key = key + s";${f.offset}=" + constant_key(f.value)
    // A real's text need not tell two reals apart, so an object holding one is never shared.
    var name = ""
    if shared && !key.contains("?")
        if l.constant_index.get(key) is Some(index) then return ConstData(index, descriptor)
        l.constant_index.put(key, l.constants.len())
        var content = l.descriptors[descriptor].name + s"\n$size"
        for f in fields
            content = content + s"\n${f.offset}=" + stable_constant_key(l, f.value)
        name = "=" + content_key(content)
    else
        val place = l.place_counts.get(l.constant_owner).unwrap_or(0) + 1
        l.place_counts.put(l.constant_owner, place)
        name = s"${l.constant_owner}#$place"
    l.constants.push(ConstantObject(name, descriptor, size, fields))
    ConstData(l.constants.len() - 1, descriptor)

/** A constant operand as text that tells it from every other. */
private constant_key(o: Operand) -> string = o match
    ConstInt(bits, digits) -> s"i$bits:$digits"
    ConstBool(value) -> if value then "t" else "f"
    ConstStr(index) -> s"s$index"
    ConstObject(descriptor) -> s"o$descriptor"
    ConstData(index, _) -> s"d$index"
    ConstClosure(index) -> s"c$index"
    NullAddress -> "n"
    _ -> "?"

/** `constant_key` with each object spelled by its name, which no edit elsewhere in the program
 * moves, rather than by its index, which one does. */
private stable_constant_key(l: *Lowering, o: Operand) -> string = o match
    ConstStr(index) -> s"s${l.strings[index].bytes.len}:${l.strings[index]}"
    ConstObject(descriptor) -> "o" + l.descriptors[descriptor].name
    ConstData(index, _) -> "d" + l.constants[index].name
    ConstClosure(index) -> "c" + l.descriptors[l.closures[index].descriptor].name
    _ -> constant_key(o)

/** A field of an object made at compile time is its value; `None` for any other object. */
private constant_field(l: *Lowering, object: Operand, field: FieldSlot) -> Option[Operand]
    val index = object match
        ConstData(k, _) -> k
        _ -> return None
    for f in l.constants[index].fields
        if f.offset == field.offset then return Some(f.value)
    None

// The parts of a tuple-typed expression, in order. A tuple written out is never made: its parts are
// evaluated directly. None when the expression never finishes.
private tuple_parts(l: *Lowering, e: &TExpr) -> Option[Buf[Option[Operand]]]
    var parts: Buf[Option[Operand]] = buf()
    if e.kind is Construct(_, args)
        for a in args
            val v = lower_expr(l, a)
            if *a.ty is Nothing || (v is None && machine(l, a.ty) is Some(_)) then return None
            parts.push(v)
        return Some(parts)
    val object = lower_expr(l, e)?
    for field in layout(l, concrete(l, e.ty)).variants[0].fields
        parts.push(field match
            Some(f) -> Some(load_field(l, object, f))
            None -> None)
    Some(parts)

// Tests a value against a pattern, as `test_pattern` does; a tuple pattern over a tuple written out
// tests each part where it is computed, without making the tuple.
private test_parts(l: *Lowering, pattern: &TPattern, value: &TExpr, fail: usize)
    if pattern.kind is PVariant(_, fields) && *concrete(l, value.ty) is Tuple(_)
        val parts = tuple_parts(l, value) match
            Some(p) -> p
            None -> return
        for i in 0..<fields.len()
            test_pattern(l, fields[i], parts[i], fail)
        return
    val v = lower_expr(l, value)
    if v is None && machine(l, value.ty) is Some(_) then return
    test_pattern(l, pattern, v, fail)

/** Reads a field of an object. */
private load_field(l: *Lowering, object: Operand, field: FieldSlot) -> Operand
    val address = field_address(l, object, field)
    val dest = fresh(l, field.ty)
    l.insts.push(Load(dest, address))
    Value(dest)

// A generic function, or a local function of one, whose types depend on type arguments.
private is_generic(program: TProgram, id: usize) -> bool
    val symbol = program.symbols[id]
    val owner = symbol.root.unwrap_or(id)
    program.symbols[owner].type_params.len() > 0

/** The index of the instance of `function` for `type_args`, made when first asked for. */
private instance(l: *Lowering, function: usize, type_args: Buf[&Type]) -> usize =
    instance_of(l, function, type_args, false)

// The instance of a test hook, which is never generic.
private hook_instance(l: *Lowering, hook: Option[usize]) -> Option[usize] = hook match
    Some(id) -> Some(instance(l, id, buf()))
    None -> None

/** The closure entry of `function` for `type_args`: it takes the closure, then the function's
 * parameters, and calls the function with what the closure holds. */
private entry_instance(l: *Lowering, function: usize, type_args: Buf[&Type]) -> usize =
    instance_of(l, function, type_args, true)

private instance_of(l: *Lowering, function: usize, type_args: Buf[&Type], entry: bool) -> usize
    val key = instance_key(function, type_args, entry)
    if l.instance_index.get(key) is Some(index) then return index
    val index = l.instances.len()
    l.instances.push(Instance(function, type_args, entry, Written))
    l.instance_index.put(key, index)
    index

/** Whether an instance is the core library's code or code lowering makes, rather than the
 * program's own. The function that initializes the module-level values counts as the library's:
 * it makes the library's objects, and each of the program's values is computed by a function of
 * its own. */
private library_instance(l: *Lowering, index: usize) -> bool
    val inst = l.instances[index]
    if inst.generated != Written || in_core_library(l.program, inst.function) then return true
    l.program.init match
        Some(init) -> init == inst.function
        None -> false

/** The function lowering makes of kind `kind` for type `t`, made when first asked for. */
private generated(l: *Lowering, kind: u8, t: &Type) -> usize
    val key = s"generated $kind|${type_key(t)}"
    if l.instance_index.get(key) is Some(index) then return index
    val index = l.instances.len()
    var args: Buf[&Type] = buf()
    args.push(t)
    l.instances.push(Instance(0, args, false, kind))
    l.instance_index.put(key, index)
    if kind == AnyEquals || kind == AnyHash then l.runtime_equality = true
    if kind == AnyDisplay || kind == AnyDebug then l.runtime_rendering = true
    index

private instance_key(function: usize, type_args: Buf[&Type], entry: bool) -> string
    var key = if entry then s"entry $function" else function.to_string()
    for t in type_args
        key = key + "|" + type_key(t)
    key

// Which locals of a top-level function live in boxes: each `var` captured by a function of it that
// is made into a closure. Locals with no runtime value need no box.
private boxed_locals(l: *Lowering, root: usize, locals: Buf[TLocal]) -> Buf[bool]
    var boxed: Buf[bool] = buf()
    for _ in locals
        boxed.push(false)
    val inner = l.local_values.get(root) match
        Some(inner) -> inner
        None -> return boxed
    for s in inner
        for x in l.program.symbols[s].captured_locals
            if locals[x].mutable && machine(l, locals[x].ty) is Some(_) then boxed[x] = true
    boxed

/** Each top-level function's local functions that are made into values, found in one pass over the
 * symbols. */
private local_values(program: TProgram) ->Map[usize, Buf[usize]]
    var found: Map[usize, Buf[usize]] = map()
    for s in 0..<program.symbols.len()
        if !program.symbols[s].value then continue
        if program.symbols[s].root is Some(root)
            var row: Buf[usize] = found.get(root).unwrap_or(buf())
            row.push(s)
            found.put(root, row)
    found

/** The descriptor of a box holding one value of machine type `t`. */
private box_descriptor(l: *Lowering, t: MirType) -> usize
    val key = machine_name(t)
    if l.boxes.get(key) is Some(d) then return d
    var refs: Buf[usize] = buf()
    if t is MRef then refs.push(0)
    val d = l.descriptors.len()
    l.descriptors.push(Descriptor("cell of " + key, 0, field_size(t), refs, false, buf(), 0, Fields, None))
    l.boxes.put(key, d)
    d

// A type's record lists its ancestors: for a class or trait, its superclasses and the traits it and
// they conform to, for a data type the traits its impls make it conform to, with their type
// arguments as it sees them. A tuple's record lists its parts' records instead, and the runtime
// tests a tuple against another tuple type part by part, so the tuple types its parts may be seen
// as, a product of every part's ancestors, have no records unless the program names them. Every
// other type is its own and nothing else.
private record_of(l: *Lowering, t: &Type) -> usize
    val key = type_key(t)
    if l.record_index.get(key) is Some(r) then return r
    val index = l.records.len()
    val name = stable_type_key(l.program, t)
    l.records.push(TypeRecord(name, buf(), None, None, None, None, false, buf(), 0))
    l.record_types.push(t)
    l.object_records.push(false)
    l.record_index.put(key, index)
    var ancestors: Buf[usize] = buf()
    for up in supertypes(l, t)
        ancestors.push(record_of(l, up))
    var parts: Buf[usize] = buf()
    if *t is Tuple(items)
        for item in items
            parts.push(record_of(l, item))
    // A class or data part is seen through what its declarations make it, as a reference both ways.
    val part_view = if *t is Class(_, _, _) || *t is Data(_, _, _) then ancestors.len() else 0
    l.records[index] = TypeRecord(name, ancestors, None, None, None, None, keeps_owners(l, t), parts, part_view)
    index

/** The record of `t` as the type of some object: one whose equality and rendering entries a value
 * of unknown type may call. */
private object_record(l: *Lowering, t: &Type) -> usize
    val index = record_of(l, t)
    l.object_records[index] = true
    index

/** Whether `t` is a class the standard library marks `@keeps_owners`: its objects are shared
 * between owners, so handing over a value that reaches one leaves what it holds where it is. */
private keeps_owners(l: *Lowering, t: &Type) -> bool
    if *t is Class(id, _, _)
        for a in l.program.classes[id].decl.annotations
            if a.name == "keeps_owners" then return true
    false

// Whether a value of type `t` may reach a Sysl or C handle that a send hands over, so that sending it
// walks it: a handle; a tuple, a data type or a class with a field that may; a generic type of the
// standard library, such as a collection, at a type argument that may, or that keeps a function, as
// a behaviour does; a function value, whose captures its type does not show; and `Any`, a trait or
// an open or abstract class, which may hold anything. A class marked `@keeps_owners` stops the walk, so it holds none, and the scalars and
// strings hold none. `seen` holds the types being decided, which a recursive type reaches again.
private holds_handles(l: *Lowering, t: &Type, seen: *Buf[string]) -> bool
    *t match
        Tuple(items) ->
            for item in items
                if holds_handles(l, item, seen) then return true
            false
        Data(id, _, args) ->
            val key = type_key(t)
            for s in *seen
                if s == key then return false
            seen.push(key)
            val d = l.program.data[id]
            for v in 0..<d.variants.len()
                for field in variant_fields(d, id, v, args)
                    if holds_handles(l, field, seen) then return true
            false
        Class(id, _, args) ->
            val k = l.program.classes[id]
            if handle_target(k.decl) is Some(_) || c_handle_type(k.decl) is Some(_) then return true
            if keeps_owners(l, t) then return false
            val key = type_key(t)
            for s in *seen
                if s == key then return false
            seen.push(key)
            // A generic type of the standard library, a collection's trait among them, holds what its
            // type arguments are and what a function it keeps captures; its other fields are its own
            // structure, such as a vector's nodes.
            if (k.module_name == CoreModule || k.module_name.starts_with("avin.")) && args.len() > 0
                for a in args
                    if holds_handles(l, a, seen) then return true
                for f in k.fields
                    if f.ty is Some(ft)
                        if *ft is Function(_, _, _) || *ft is ByName(_) then return true
                return false
            if k.decl.modifier == "trait" || k.decl.modifier == "open" || k.decl.modifier == "abstract" then return true
            for f in k.fields
                if holds_handles(l, substitute(f.ty.unwrap_or(ErrorType), class_owner(id), args), seen) then return true
            false
        Function(_, _, _) -> true
        ByName(_) -> true
        AnyType -> true
        Union(_) -> true
        TypeVar(_, _, _) -> true
        _ -> false

/** The classes and traits `t` conforms to besides itself and `Any`, each once. A tuple's other
 * tuple types are tested through its parts' records, so they are not among them. */
private supertypes(l: *Lowering, t: &Type) -> Buf[&Type]
    var out: Buf[&Type] = buf()
    *t match
        Class(_, _, _) -> class_ancestors(l, t, &out)
        Data(_, _, _) -> class_ancestors(l, t, &out)
        _ -> ()
    out

// Adds the superclasses of the class `t` and the traits it and they conform to, each once. A
// conformance an impl with bounds of its own states is an ancestor only of the instances whose type
// arguments meet them.
private class_ancestors(l: *Lowering, t: &Type, out: *Buf[&Type])
    // A data type's ancestors are the traits its impls name, and what those require.
    if *t is Data(d, _, xs)
        for required in l.program.data[d].traits
            if !conformance_holds(lowering_conformances(l), data_owner(d), required, xs) then continue
            val parent = substitute(required, data_owner(d), xs)
            var seen = false
            for i in 0..<out.len()
                if same_type(out[i], parent) then seen = true
            if seen then continue
            out.push(parent)
            class_ancestors(l, parent, out)
        return
    val k = *t match
        Class(k, _, _) -> k
        _ -> return
    val args = *t match
        Class(_, _, a) -> a
        _ -> buf()
    val symbol = l.program.classes[k]
    var parents: Buf[&Type] = buf()
    for required in symbol.traits
        if conformance_holds(lowering_conformances(l), class_owner(k), required, args) then parents.push(substitute(required, class_owner(k), args))
    if symbol.superclass is Some(sup) then parents.push(substitute(sup, class_owner(k), args))
    for parent in parents
        var seen = false
        for i in 0..<out.len()
            if same_type(out[i], parent) then seen = true
        if seen then continue
        out.push(parent)
        class_ancestors(l, parent, out)

// Every string has the program's descriptor: the runtime's layout of a string, a length and then the
// bytes, with no references, and the type record of `string` and its method table, so a string is a
// value of `Any` and of each trait it implements as it is, with no box.
private string_descriptor(l: *Lowering) -> usize
    val record = object_record(l, Str)
    val methods = method_table(l, Str)
    val d = l.descriptors.len()
    l.descriptors.push(Descriptor("string", 0, 8, buf(), false, methods, record, Fields, None))
    if holds_generic_methods(l, Str) then hold_generic_slots(l, d, Str)
    d

/** The descriptor of a box holding a value of the built-in type `t` as an `Any`; unit's is one
 * constant object. */
private value_box(l: *Lowering, t: &Type) -> usize
    val key = "value box " + type_key(t)
    if l.boxes.get(key) is Some(d) then return d
    val size = machine(l, t) match
        Some(m) -> field_size(m)
        None -> 0
    val record = object_record(l, t)
    val methods = method_table(l, t)
    val d = l.descriptors.len()
    l.descriptors.push(Descriptor("box of " + stable_type_key(l.program, t), 0, size, buf(), size == 0, methods, record, Fields, None))
    l.boxes.put(key, d)
    // A built-in type's impls may add methods with type parameters of their own, which a call
    // through a trait reaches at a slot of their own type arguments, as an object's does.
    if holds_generic_methods(l, t) then hold_generic_slots(l, d, t)
    d

// A value as an `Any`. One the program already keeps as a reference to an object is that object;
// a built-in value is put in a new box, and unit is its one constant box. An option kept as a
// pointer becomes the object it stands for.
private box_value(l: *Lowering, t: &Type, value: Option[Operand]) -> Option[Operand]
    if *t is Unit then return Some(ConstObject(value_box(l, t)))
    val v = value?
    val m = machine(l, t)?
    if pointer_option(l, t) then return Some(option_object(l, t, v))
    if m is MRef then return Some(v)
    val object = fresh(l, MRef)
    l.insts.push(Alloc(object, value_box(l, t)))
    l.insts.push(Store(field_address(l, Value(object), FieldSlot(0, m)), v))
    l.insts.push(Publish)
    Some(Value(object))

/** Where a descriptor's type record is: after the collector's kind and three words. */
private const DescriptorRecord: usize = 56

// Whether the object `object` has type `t` at run time. A string's descriptor names no record; a
// type nothing else can be is tested by its record alone, an open class or a trait also by the
// record's ancestors, and a tuple with such a part also part by part, by the parts' records.
private type_test(l: *Lowering, object: Operand, t: &Type) -> Operand
    val record = record_at(l, object)
    val index = record_of(l, t)
    val target = RecordAddress(index)
    if exact(l, t) then return compare(l, CmpEq, record, target)
    note_tested(l, index)
    val found = runtime_call(l, "avin_rt_conforms", [MPtr, MPtr], MInt(32), [record, target])
    compare(l, CmpNe, found, ConstInt(32, "0"))

/** The address of the type record of the object `object`, read from its descriptor. */
private record_at(l: *Lowering, object: Operand) -> Operand
    val descriptor = fresh(l, MPtr)
    l.insts.push(DescriptorOf(descriptor, object))
    val address = fresh(l, MPtr)
    l.insts.push(Offset(address, Value(descriptor), DescriptorRecord))
    val record = fresh(l, MPtr)
    l.insts.push(Load(record, Value(address)))
    Value(record)

/** Records that a type pattern tests against the type whose record is `index`, so that the records
 * of the types that may be seen as it gain it as an ancestor. */
private note_tested(l: *Lowering, index: usize)
    for r in l.tested
        if r == index then return
    l.tested.push(index)

/** Whether only a value of exactly type `t` has type `t`: true of every type but an open or
 * abstract class, a trait, an instance of a type with a parameter that is not invariant, a function
 * type (whose parameters and result vary, and which a class may extend), and a tuple with a part of
 * one. */
private exact(l: *Lowering, t: &Type) -> bool = *t match
    Class(k, _, _) -> l.program.classes[k].decl.modifier == "" && all_invariant(l.program.classes[k].decl.type_params)
    Data(d, _, _) -> all_invariant(l.program.data[d].decl.type_params)
    Function(_, _, _) -> false
    Tuple(items) ->
        for item in items
            if !exact(l, item) then return false
        true
    _ -> true

private all_invariant(params: Buf[TypeParam]) -> bool
    for p in params
        if !(p.variance is Invariant) then return false
    true

// A type pattern on an instance of a generic type matches an object whose type conforms to it
// through its parameters' variance, as the checker's subtyping does. Those supertypes are open-ended,
// so a record does not list them all: once every function is lowered, each record gains those among
// the types that type patterns test against.
private add_variant_ancestors(l: *Lowering)
    var targets: Buf[KnownType] = buf()
    // The classes and traits the targets are instances of, each once, and each target's among them.
    var heads: Buf[usize] = buf()
    var target_head: Buf[Option[usize]] = buf()
    for target in l.tested
        val t = l.record_types[target]
        targets.push(known_type(l, t))
        *t match
            Class(k, _, _) ->
                var at: Option[usize] = None
                for h in 0..<heads.len()
                    if heads[h] == k then at = Some(h)
                if at is None
                    at = Some(heads.len())
                    heads.push(k)
                target_head.push(at)
            _ -> target_head.push(None)
    // Which records the record at hand already lists, marked while it is being extended.
    var listed: Buf[bool] = buf()
    for _ in 0..<l.records.len() do listed.push(false)
    for r in 1..<l.records.len()
        val from = l.record_types[r]
        val known = known_type(l, from)
        val placed = *from is Class(_, _, _) || *from is Data(_, _, _)
        // Whether `from` holds an instance of each head, asked once a head is met: 0 not yet asked,
        // 1 it does, 2 it does not.
        var holds: Buf[u8] = buf()
        for _ in heads do holds.push(0u8)
        var ancestors = l.records[r].ancestors
        for a in ancestors do listed[a] = true
        var grew = false
        for i in 0..<l.tested.len()
            val target = l.tested[i]
            if target == r || listed[target] then continue
            // A class or data value is seen as another class or trait only through the instance of
            // it that it holds, so where `held_ancestor` remembers none, the answer is no without
            // asking the rest.
            if placed && target_head[i] is Some(h)
                var itself = false
                if *from is Class(k, _, _) && k == heads[h] then itself = same_type(from, targets[i].ty)
                if !itself
                    if holds[h] == 0u8
                        holds[h] = if held_ancestor(l, known, heads[h]) is Some(_) then 1u8 else 2u8
                    if holds[h] == 2u8 then continue
            if seen_as(l, known, targets[i])
                ancestors.push(target)
                listed[target] = true
                grew = true
        for a in ancestors do listed[a] = false
        if grew then l.records[r] = TypeRecord(l.records[r].name, ancestors, l.records[r].equals, l.records[r].hash, l.records[r].display, l.records[r].debug, l.records[r].apart, l.records[r].parts, l.records[r].part_view)

/** Whether a value of type `from` is one of `to`, as `always_is` or a view through `view_as` shows. */
private seen_as(l: *Lowering, from: KnownType, target: KnownType) -> bool
    val to = target.ty
    if always_is_known(l, from, target) then return true
    // For a reference that is not boxed to be seen as a trait, `always_is` has already looked
    // through `view_as`, and its no stands.
    val boxed = (is_builtin(from.ty) || *from.ty is Tuple(_)) && *to is Class(_, _, _)
    if is_reference(from.ty) && !boxed then return false
    same_type(view_as(lowering_conformances(l), from.ty, to), to)

/** The value of type `t` an object that has that type holds: a built-in value is in its box, and an
 * option kept as a pointer is the `Some`'s value or null. */
private unbox(l: *Lowering, t: &Type, object: Operand) -> Option[Operand]
    if pointer_option(l, t) then return Some(option_pointer(l, t, object))
    machine(l, t) match
        Some(MRef) -> Some(object)
        Some(m) -> Some(load_field(l, object, FieldSlot(0, m)))
        None -> None

/** Whether `t` is an option kept as a pointer: see `representation.sysl`. */
private pointer_option(l: *Lowering, t: &Type) -> bool = option_is_pointer(l.options, concrete(l, t))

/** The position of `Some` among `Option`'s variants: the one with a field. */
private some_variant(l: *Lowering) -> usize
    val d = l.program.data[l.options.option.unwrap()]
    for v in 0..<d.variants.len()
        if d.variants[v].fields.len() == 1 then return v
    0

private none_variant(l: *Lowering) -> usize = if some_variant(l) == 0 then 1 else 0

// The object an option kept as a pointer stands for: `None`'s one constant object for null, and a new
// `Some` holding any other pointer. It has the layout every option of its type has as an object, so
// a type pattern, a trait's method table and equality on `Any` read it as any other option.
private option_object(l: *Lowering, t: &Type, pointer: Operand) -> Operand
    val shape = layout(l, concrete(l, t))
    val slot = machine_slot(l, MRef)
    val absent = new_block(l)
    val present = new_block(l)
    val join = new_block(l)
    finish_into(l, Branch(compare(l, CmpEq, pointer, NullAddress), absent, present), absent)
    store(l, slot, Some(ConstObject(shape.variants[none_variant(l)].descriptor)))
    finish_into(l, Jump(join), present)
    val variant = shape.variants[some_variant(l)]
    val object = fresh(l, MRef)
    l.insts.push(Alloc(object, variant.descriptor))
    if variant.fields[0] is Some(field) then l.insts.push(Store(field_address(l, Value(object), field), pointer))
    l.insts.push(Publish)
    store(l, slot, Some(Value(object)))
    finish_into(l, Jump(join), join)
    load(l, slot).unwrap()

// The pointer an option object stands for, where its type keeps it as one: a `Some`'s value, or
// null for `None`.
private option_pointer(l: *Lowering, t: &Type, object: Operand) -> Operand
    val shape = layout(l, concrete(l, t))
    // A `Some` with no slot holds a `Nothing`, so the object is `None`.
    if shape.variants[some_variant(l)].fields[0] is None then return NullAddress
    val slot = machine_slot(l, MRef)
    val absent = new_block(l)
    val present = new_block(l)
    val join = new_block(l)
    val some = ConstInt(64, some_variant(l).to_string())
    finish_into(l, Branch(compare(l, CmpEq, variant_tag(l, object), some), present, absent), absent)
    store(l, slot, Some(NullAddress))
    finish_into(l, Jump(join), present)
    val field = shape.variants[some_variant(l)].fields[0].unwrap()
    store(l, slot, Some(load_field(l, object, field)))
    finish_into(l, Jump(join), join)
    load(l, slot).unwrap()

// Whether a value of static type `from` always has type `to`: `to` is `Any`, or `from` itself, or
// a type a value of `from` is with no conversion: an ancestor, an instance of the same generic type
// as variance allows, a tuple part by part.
private always_is(l: *Lowering, from: &Type, to: &Type) -> bool = value_always_is(lowering_conformances(l), from, to)

/** `always_is` as the conformances `f` of a finished program decide it. */
value_always_is(f: Conformances, from: &Type, to: &Type) -> bool
    if *to is AnyType || same_type(from, to) then return true
    // A built-in value or a tuple is a value of each trait it conforms to, once boxed as one.
    if (is_builtin(from) || *from is Tuple(_)) && *to is Class(_, _, _) then return meets_bound(f, from, to)
    if !is_reference(from) then return false
    same_type(view_as(f, from, to), to)

/** `always_is` of two types with their numbers, remembered. */
private always_is_known(l: *Lowering, from: KnownType, to: KnownType) -> bool
    val f = lowering_conformances(l)
    l.memo.always_is(f, from, to)

/** `t` as an instance of the class or trait `target`, through the conformances that hold at its type
 * arguments, as `holding_ancestor` finds it, remembered. */
private held_ancestor(l: *Lowering, t: KnownType, target: usize) -> Option[&Type]
    val f = lowering_conformances(l)
    l.memo.ancestor(f, t, target)

/** `t` with the number the memo gives it. */
private known_type(l: *Lowering, t: &Type) -> KnownType = l.memo.known(t)

private machine_name(t: MirType) -> string = t match
    MInt(bits) -> s"i$bits"
    MBool -> "bool"
    MReal -> "real"
    MPtr -> "address"
    MRef -> "reference"

// A closure is the value of each local and top-level parameter the function captures; a boxed local
// is captured as its box, so it stays shared. Its descriptor's `call` is `entry`, the function's code.
private closure_shape(l: *Lowering, function: usize, type_args: Buf[&Type], entry: usize) -> ClosureShape
    val key = instance_key(function, type_args, false)
    if l.shapes.get(key) is Some(shape) then return shape
    val symbol = l.program.symbols[function]
    var fields: Buf[FieldSlot] = buf()
    var refs: Buf[usize] = buf()
    var size = 0usize
    symbol.root match
        Some(root) ->
            for x in symbol.captured_locals
                if machine(l, l.locals[x].ty) is Some(t)
                    val m = if l.boxed[x] then MRef else t
                    if m is MRef then refs.push(size)
                    fields.push(FieldSlot(size, m))
                    size += field_size(m)
            for x in symbol.captured_params
                if machine(l, l.program.symbols[root].params[x]) is Some(m)
                    if m is MRef then refs.push(size)
                    fields.push(FieldSlot(size, m))
                    size += field_size(m)
        None -> ()
    val record = object_record(l, closure_type(l, function, type_args))
    val shape = ClosureShape(l.descriptors.len(), fields)
    l.descriptors.push(Descriptor("closure of " + function_symbol(l, function, type_args), 0, size, refs, false, buf(), record, Fields, Some(entry)))
    l.shapes.put(key, shape)
    shape

// The exact type of a closure of `function`'s copy at `type_args`: the function type its own
// parameters and result make, in that copy. A type pattern on a function type tests it.
private closure_type(l: *Lowering, function: usize, type_args: Buf[&Type]) -> &Type
    val symbol = l.program.symbols[function]
    val owner = l.program.symbols[symbol.root.unwrap_or(function)].type_owner
    var params: Buf[&Type] = buf()
    for p in symbol.params
        params.push(erase_unions(substitute(solve(l.program.vars, p), owner, type_args)))
    Function(params, erase_unions(substitute(solve(l.program.vars, symbol.result.unwrap_or(Unit)), owner, type_args)), false)

// The type arguments of the copy of `symbol` a call or a function value in the instance being
// lowered reaches. A local function without type parameters of its own shares those of the code it
// is declared in, a prefix of the instance's; a lambda is made where it is written, so it shares all
// of them. A generic local function has those it shares, which the call names as its enclosing type
// parameters, followed by its own; a generic function is instantiated with the call's. Each is made
// concrete for the instance being lowered.
private instance_args(l: *Lowering, symbol: FunctionSymbol, type_args: Buf[&Type]) -> Buf[&Type]
    if symbol.root is Some(root) && symbol.decl.type_params.len() == 0
        // Only inside a generic local function's copy does the instance have more than the
        // top-level function's.
        if symbol.lambda || l.subst.len() <= l.program.symbols[root].type_params.len() then return l.subst
        val shared = shared_type_params(l.program, root, symbol)
        if shared >= l.subst.len() then return l.subst
        var prefix: Buf[&Type] = buf()
        for i in 0..<shared
            prefix.push(l.subst[i])
        return prefix
    // A union type argument is kept, so a type pattern naming the parameter tests its members; the
    // copy lays the union out as an `Any`, as every type made concrete in it is.
    var out: Buf[&Type] = buf()
    for t in type_args
        out.push(written_concrete(l, t))
    out

// How many type parameters are in scope where local function `symbol` of `root` is declared: the
// top-level function's, and those of the innermost generic local function it is declared in.
private shared_type_params(program: TProgram, root: usize, symbol: FunctionSymbol) -> usize
    var shared = program.symbols[root].type_params.len()
    for s in program.symbols
        val sibling = s.root match
            Some(r) -> r == root
            None -> false
        if !sibling || s.decl.type_params.len() == 0 || s.unit != symbol.unit then continue
        if s.decl.span.start <= symbol.decl.span.start && symbol.decl.span.end <= s.decl.span.end && s.type_params.len() > shared
            shared = s.type_params.len()
    shared

// A function as a value. One that captures nothing is a constant closure; otherwise the captured
// values are read first and the closure is allocated after, so a collection while allocating sees
// each of them as a root.
private function_value(l: *Lowering, function: usize, type_args: Buf[&Type]) -> Operand
    val symbol = l.program.symbols[function]
    val concrete_args = instance_args(l, symbol, type_args)
    val entry = entry_instance(l, function, concrete_args)
    val shape = closure_shape(l, function, concrete_args, entry)
    if shape.fields.len() == 0
        val key = instance_key(function, concrete_args, false)
        if l.closure_index.get(key) is Some(index) then return ConstClosure(index)
        val index = l.closures.len()
        l.closures.push(ClosureConstant(shape.descriptor, entry))
        l.closure_index.put(key, index)
        return ConstClosure(index)
    var values: Buf[Operand] = buf()
    for x in symbol.captured_locals
        if machine(l, l.locals[x].ty) is Some(_)
            val place = if l.boxed[x] then l.local_slots[x] else local_place(l, x)
            values.push(load(l, place).unwrap())
    for x in symbol.captured_params
        if param_operand(l, x) is Some(v) then values.push(v)
    val object = fresh(l, MRef)
    l.insts.push(Alloc(object, shape.descriptor))
    for i in 0..<values.len()
        l.insts.push(Store(field_address(l, Value(object), shape.fields[i]), values[i]))
    l.insts.push(Publish)
    Value(object)

// Calls a method through the method table of the receiver, `args[0]`: whichever override fills the
// slot in the object's class, it takes the parameters `function` takes and yields its result, as
// machine types, so the call is spelled from `function`'s signature.
private dispatch(l: *Lowering, function: usize, slot: usize, args: Buf[&TExpr], type_args: Buf[&Type]) -> Option[Operand]
    var operands: Buf[Operand] = buf()
    for a in args
        val op = lower_expr(l, a)
        // An argument that never finishes ends the code here: the call is never made.
        if *a.ty is Nothing then return None
        // A value of a type parameter that is `Nothing` in this copy, as the value of a `Some` in an
        // `Option[Nothing]`'s `compare`: there is none, so the code is never reached.
        if *concrete(l, a.ty) is Nothing
            leave(l, Unreachable)
            return None
        if machine(l, a.ty) is Some(_)
            op match
                Some(v) -> operands.push(v)
                None -> return None
    // Only the object an option kept as a pointer stands for has a method table.
    if pointer_option(l, args[0].ty) then operands[0] = option_object(l, args[0].ty, operands[0])
    if rendering_call(l, function, concrete(l, args[0].ty), operands) is Some(shown) then return shown
    val symbol = l.program.symbols[function]
    var concrete_args: Buf[&Type] = buf()
    for t in type_args
        concrete_args.push(concrete(l, t))
    var params: Buf[MirType] = buf()
    for p in symbol.params
        if machine(l, substitute(p, symbol.type_owner, concrete_args)) is Some(t) then params.push(t)
    val result = machine(l, substitute(symbol.result.unwrap_or(Unit), symbol.type_owner, concrete_args))
    // A method with type parameters of its own has a slot for each list of its own type arguments.
    var position = slot
    // A receiver whose type still names a type parameter, as `Self` does in a trait's default body
    // compiled once for every type, may be an object of any type.
    val seen = concrete(l, args[0].ty)
    val receiver: &Type = if names_type_parameter(seen) then AnyType else seen
    val own = symbol.decl.type_params.len()
    if own > 0
        var own_args: Buf[&Type] = buf()
        for i in concrete_args.len() - own..<concrete_args.len()
            own_args.push(concrete_args[i])
        position = generic_slot(l, slot, symbol.decl.name, own_args, receiver)
    else
        use_slot(l, position, symbol.decl.name, receiver)
    val code = fresh(l, MPtr)
    l.insts.push(MethodSlot(code, operands[0], position))
    if !(*receiver is AnyType) then l.dispatches.push(DispatchCall(l.function_index, code, position, receiver))
    val dest = result match
        Some(t) -> Some(fresh(l, t))
        None -> None
    push_call(l, dest, Indirect(Value(code), MirSignature(params, result)), operands)
    dest match
        Some(id) -> Some(Value(id))
        None -> None

// Whether an object whose type is `up` as an instance of the class or trait `head` can never be a
// value of the static type `receiver`: some type argument the parameter does not take the other way
// is a number, a `char`, a `bool` or `unit` on one side and a different type on the other. A value of
// such a type has no subtype but `Nothing` and is never boxed inside a container, so a `Vector[Any]`
// or a `Vector[Shape]` is never a `Vector[int]`, and the reverse.
private never_reaches(f: Conformances, head: usize, up: &Type, receiver: &Type) -> bool
    val xs = *up match
        Class(_, _, a) -> a
        _ -> return false
    val ys = *receiver match
        Class(_, _, a) -> a
        _ -> return false
    val params = f.classes[head].decl.type_params
    if xs.len() != ys.len() || xs.len() != params.len() then return false
    for i in 0..<xs.len()
        if params[i].variance is Contravariant then continue
        if same_type(xs[i], ys[i]) || *xs[i] is Nothing || *ys[i] is Nothing then continue
        if is_plain_value(xs[i]) || is_plain_value(ys[i]) then return true
    false

/** Whether `t` is a number, a `char`, a `bool` or `unit`: a built-in type held as its value. */
private is_plain_value(t: &Type) -> bool = is_builtin(t) && !(*t is Str)

// What the finished program shows of each call through a method table on a receiver of known static
// type. Every object such a call can reach has a descriptor of a type that conforms to the receiver's
// class or trait, with type arguments it can be seen through (`never_reaches`): where all of those that hold a method at the call's
// position hold the same one, that method is the one every receiver runs. A descriptor of a type that
// is no class or data type, a boxed value's, cannot be placed, so it counts as holding a method of
// its own. The guards are the descriptors of the types a value of the receiver's exact static type
// may have, each with its method.
private dispatch_sites(l: *Lowering) -> Buf[DispatchSite]
    val f = lowering_conformances(l)
    var out: Buf[DispatchSite] = buf()
    var types: Buf[KnownType] = buf()
    for descriptor in l.descriptors
        val t = l.record_types[descriptor.record]
        types.push(known_type(l, t))
    var answered: Map[usize, usize] = map()
    var answers: Buf[DispatchAnswer] = buf()
    for call in l.dispatches
        val head = *call.receiver match
            Class(k, _, _) -> k
            _ -> continue
        val receiver = known_type(l, call.receiver)
        // Calls at one position on one receiver type reach the same methods.
        var key: Option[usize] = None
        if receiver.id is Some(id) then key = Some(pair_key(call.position, id))
        if key is Some(k)
            if answered.get(k) is Some(a)
                if same_type(answers[a].receiver, call.receiver)
                    out.push(DispatchSite(call.function, call.code, answers[a].single, answers[a].guards))
                    continue
        var single: Option[usize] = None
        var many = false
        var guards: Buf[DispatchGuard] = buf()
        for d in 0..<l.descriptors.len()
            val descriptor = l.descriptors[d]
            if call.position >= descriptor.methods.len() then continue
            val g = descriptor.methods[call.position] match
                Some(g) -> g
                None -> continue
            val t = types[d].ty
            val placed = *t is Class(_, _, _) || *t is Data(_, _, _)
            if placed
                val up = held_ancestor(l, types[d], head) match
                    Some(up) -> up
                    None -> continue
                if never_reaches(f, head, up, call.receiver) then continue
            single match
                Some(s) -> if s != g then many = true
                None -> single = Some(g)
            if placed && always_is_known(l, types[d], receiver) then guards.push(DispatchGuard(d, g))
        val reached = if many then None else single
        if key is Some(k)
            if answered.get(k) is None
                answered.put(k, answers.len())
                answers.push(DispatchAnswer(call.receiver, reached, guards))
        out.push(DispatchSite(call.function, call.code, reached, guards))
    out

/** What `dispatch_sites` found of the calls at one position on a receiver of type `receiver`. */
private struct DispatchAnswer
    receiver: &Type
    single: Option[usize]
    guards: Buf[DispatchGuard]

// A direct call of `function`, the receiver first for a method. A static member's receiver is a
// type, which is not passed.
private direct_call(l: *Lowering, e: &TExpr, function: usize, args: Buf[&TExpr], type_args: Buf[&Type]) -> Option[Operand]
    val callee = l.program.symbols[function]
    // A trait's default body is compiled once for every conforming type, its `Self` an object: an
    // option kept as a pointer goes in as the object it stands for, and comes out as a pointer again.
    val default_body = is_trait_method(l, callee)
    var operands: Buf[Operand] = buf()
    for i in 0..<args.len()
        val a = args[i]
        if a.kind is TypeReceiver then continue
        val op = lower_expr(l, a)
        // An argument that never finishes ends the code here: the call is never made.
        if *a.ty is Nothing then return None
        if machine(l, a.ty) is Some(_)
            op match
                Some(v) ->
                    val self_typed = i == 0 || (i < callee.params.len() && is_self_type(callee.params[i]))
                    if default_body && self_typed && pointer_option(l, a.ty) then operands.push(option_object(l, a.ty, v))
                    else operands.push(v)
                None -> return None
    if default_body && is_self_type(callee.result.unwrap_or(Unit)) && pointer_option(l, e.ty)
        val object = call_resolved(l, e, function, callee, args, operands, type_args)?
        return Some(option_pointer(l, e.ty, object))
    call_resolved(l, e, function, callee, args, operands, type_args)

/** Whether a function is a method a trait declares, compiled once for every conforming type. */
private is_trait_method(l: *Lowering, symbol: FunctionSymbol) -> bool = symbol.owner_class match
    Some(k) -> l.program.classes[k].decl.modifier == "trait"
    None -> false

/** Whether `t` is a trait's `Self`. */
private is_self_type(t: &Type) -> bool = *t match
    TypeVar(owner, _, _) -> is_self_owner(owner)
    _ -> false

// A direct call of `function` with its arguments already lowered.
private call_resolved(l: *Lowering, e: &TExpr, function: usize, callee: FunctionSymbol, args: Buf[&TExpr], given: Buf[Operand], type_args: Buf[&Type]) -> Option[Operand]
    var operands = given
    // A string operation is lowered where it is called, so its checks report the call's place.
    if callee.intrinsic is Some(name)
        if name == "trap"
            // A literal reason is written into the trap site; one made as the program runs, such as
            // an assertion's message showing the values it compared, is passed with the site.
            if args[0].kind is StrConst(text)
                leave(l, trap_at(l, text, e.span))
                return None
            val reason = machine(l, args[0].ty)
            if operands.len() != 1 || reason is None
                leave(l, trap_at(l, "trap", e.span))
                return None
            val site = trap_site(l, "", e.span)
            val entry = if l.library then "avin_rt_caller_trap_message" else "avin_rt_trap_message"
            var types: Buf[MirType] = buf()
            types.push(MPtr)
            types.push(reason.unwrap())
            var values: Buf[Operand] = buf()
            values.push(TrapSiteAddress(site))
            values.push(operands[0])
            l.insts.push(Call(None, Runtime(entry, MirSignature(types, None)), values))
            leave(l, Unreachable)
            return None
        if name.starts_with("array_")
            // The array is the receiver, or for a new one the result.
            val array = concrete(l, if name == "array_new" then e.ty else args[0].ty)
            return array_operation(l, name, array, operands, e.span)
        if name.starts_with("string_") then return intrinsic_operation(l, name, operands, e.span)
        if name.starts_with("atomic_") then return atomic_operation(l, name, concrete(l, args[0].ty), operands)
        if name == "holds_handles"
            var seen: Buf[string] = buf()
            return Some(ConstBool(holds_handles(l, concrete(l, args[0].ty), &seen)))
    // A local function also receives what it captures, from where the caller keeps it.
    for x in callee.captured_locals
        if l.local_slots[x] is Some(p) then operands.push(p.address)
    for x in callee.captured_params
        if param_operand(l, x) is Some(v) then operands.push(v)
    val index = instance(l, function, instance_args(l, callee, type_args))
    val dest = machine(l, e.ty) match
        Some(t) -> Some(fresh(l, t))
        None -> None
    push_call(l, dest, Direct(index), operands)
    dest match
        Some(id) -> Some(Value(id))
        None -> None

// A call through a bound, in an instance that knows the receiver's type. A trait or an open class
// may hold an object of any class conforming to it, so the call goes through the object's method
// table; any other type's implementation is the method at the call's position in its table, called
// directly. In a trait's default body the receiver is the trait's `Self`, any conforming object.
private bound_call(l: *Lowering, e: &TExpr, function: usize, slot: Option[usize], args: Buf[&TExpr], type_args: Buf[&Type]) -> Option[Operand]
    if is_operator_method(l, function) then return core_call(l, e, function, args)
    val position = slot match
        Some(s) -> s
        None -> return direct_call(l, e, function, args, type_args)
    val receiver = concrete(l, args[0].ty)
    // A static member is called on a type, so the type's own table names it even where an object of
    // the type could be of a subclass.
    val on_type = args[0].kind is TypeReceiver
    if *receiver is Class(k, _, _)
        if l.program.classes[k].decl.modifier != "" && !on_type then return dispatch(l, function, position, args, type_args)
    val entries = checker_table(l, receiver)
    if position >= entries.len() then return dispatch(l, function, position, args, type_args)
    var m = entries[position] match
        Some(m) -> m
        None -> return dispatch(l, function, position, args, type_args)
    if on_type then m = conformance_member(l, receiver, function, m, type_args)
    var concrete_args: Buf[&Type] = buf()
    for a in implementation_args(l, receiver, m)
        concrete_args.push(a)
    val own = l.program.symbols[function].decl.type_params.len()
    for i in type_args.len() - own..<type_args.len()
        concrete_args.push(concrete(l, type_args[i]))
    direct_call(l, e, m, args, concrete_args)

// A type implementing a trait at several type arguments has one static member of a name for each,
// and its table holds only one of them: the one called is the one taking the parameter types the
// trait's member takes at the call's type arguments. `table_member` is the table's.
private conformance_member(l: *Lowering, receiver: &Type, function: usize, table_member: usize, type_args: Buf[&Type]) -> usize
    val trait_member = l.program.symbols[function]
    val k = trait_member.owner_class match
        Some(k) -> k
        None -> return table_member
    if !several_conformances(l.program.classes[k].decl) then return table_member
    var concrete_args: Buf[&Type] = buf()
    for t in type_args
        concrete_args.push(concrete(l, t))
    var implementer: Buf[&Type] = buf()
    implementer.push(receiver)
    var wanted: Buf[&Type] = buf()
    for i in 1..<trait_member.params.len()
        wanted.push(substitute(substitute(trait_member.params[i], self_owner(k), implementer), trait_member.type_owner, concrete_args))
    val chosen = l.program.symbols[table_member]
    for x in 0..<l.program.symbols.len()
        val candidate = l.program.symbols[x]
        if !candidate.static_member || candidate.decl.name != trait_member.decl.name || candidate.params.len() != trait_member.params.len() then continue
        // A built-in type's members are the methods of its impls, each impl with parameters of its
        // own; any other type's share its owner.
        if candidate.receiver is Some(r)
            if chosen.receiver is Some(q)
                if !same_type(r, q) then continue
            else continue
        elif chosen.receiver is Some(_) then continue
        elif candidate.type_owner != chosen.type_owner || candidate.owner_class != chosen.owner_class then continue
        val own = implementation_args(l, receiver, x)
        var matches = true
        for i in 1..<candidate.params.len()
            if !same_type(substitute(candidate.params[i], candidate.type_owner, own), wanted[i - 1]) then matches = false
        if matches then return x
    table_member

// Calls a function value, a closure or an object of a class or data type that is a function: its
// descriptor's `call` takes the object before the arguments.
private call_value(l: *Lowering, callee: &TExpr, args: Buf[&TExpr]) -> Option[Operand]
    if !l.calls_values
        l.calls_values = true
        l.new_slots = true
    val target = lower_expr(l, callee)?
    var operands: Buf[Operand] = buf()
    operands.push(target)
    for a in args
        val op = lower_expr(l, a)
        // An argument that never finishes ends the code here: the call is never made.
        if *a.ty is Nothing then return None
        if machine(l, a.ty) is Some(_)
            op match
                Some(v) -> operands.push(v)
                None -> return None
    var params: Buf[MirType] = buf()
    params.push(MRef)
    var result: Option[MirType] = None
    *concrete(l, callee.ty) match
        Function(ps, r, _) ->
            for p in ps
                if machine(l, p) is Some(t) then params.push(t)
            result = machine(l, r)
        ByName(r) -> result = machine(l, r)
        _ -> panic("a call of a value that is not a function")
    val code = fresh(l, MPtr)
    l.insts.push(CallEntry(code, target))
    val dest = result match
        Some(t) -> Some(fresh(l, t))
        None -> None
    push_call(l, dest, Indirect(Value(code), MirSignature(params, result)), operands)
    dest match
        Some(id) -> Some(Value(id))
        None -> None

/** Where a local's value is: its place, or for a boxed local, the box's field. */
private local_place(l: *Lowering, x: usize) -> Option[Place]
    val place = l.local_slots[x]?
    if !l.boxed[x] then return Some(place)
    val t = machine(l, l.locals[x].ty).unwrap()
    val box = load(l, Some(place)).unwrap()
    Some(Place(field_address(l, box, FieldSlot(0, t)), t))

/** Gives a local its first value; a boxed local gets a new box holding it. */
private bind_local(l: *Lowering, x: usize, value: Option[Operand])
    if !l.boxed[x] then return store(l, l.local_slots[x], value)
    val v = value match
        Some(v) -> v
        None -> return
    val t = machine(l, l.locals[x].ty).unwrap()
    val box = fresh(l, MRef)
    l.insts.push(Alloc(box, box_descriptor(l, t)))
    l.insts.push(Store(field_address(l, Value(box), FieldSlot(0, t)), v))
    l.insts.push(Publish)
    store(l, l.local_slots[x], Some(Value(box)))

/** A type of the code being lowered, with the instance's type arguments substituted. A union is laid
 * out as an `Any` holding its member, so lowering sees every union as `Any`. */
private concrete(l: *Lowering, t: &Type) -> &Type = erase_unions(substitute(solve(l.program.vars, t), l.subst_owner, l.subst))

/** `t` in the instance being lowered, with its unions kept: what a type pattern naming a union tests. */
private written_concrete(l: *Lowering, t: &Type) -> &Type = substitute(solve(l.program.vars, t), l.subst_owner, l.subst)

private machine(l: *Lowering, t: &Type) -> Option[MirType] = mir_type(concrete(l, t))

/** The machine type of parameter `i` of `symbol`, or `None` where nothing is passed for it: a type
 * with no machine value, or a static member's receiver, which is a type. */
private param_machine(l: *Lowering, symbol: FunctionSymbol, i: usize) -> Option[MirType]
    if symbol.static_member && i == 0 then return None
    machine(l, symbol.params[i])

// A local function takes its declared parameters, then the address of each local it captures,
// then the value of each top-level parameter it captures.
private signature_of(l: *Lowering, f: TFunction) -> MirSignature
    val program = l.program
    val symbol = program.symbols[f.symbol]
    var params: Buf[MirType] = buf()
    for i in 0..<symbol.params.len()
        if param_machine(l, symbol, i) is Some(t) then params.push(t)
    for x in symbol.captured_locals
        if machine(l, f.locals[x].ty) is Some(_) then params.push(MPtr)
    if symbol.root is Some(root)
        for x in symbol.captured_params
            if machine(l, program.symbols[root].params[x]) is Some(t) then params.push(t)
    MirSignature(params, machine(l, symbol.result.unwrap_or(Unit)))

/** The symbol a function has in the object file: its module path and name. A file with no module
 * header is in `<program>`, which no module path can spell; a local function is named within its
 * top-level function and numbered among that function's local functions of its name, counting from
 * 1 in the order they are declared, since two blocks may each declare one with the same name. An
 * overloaded function's name is followed by its parameter types, which tell it from the others, and
 * an instance's by its type arguments, spelled by `stable_type_key`. Nothing in it is a number the
 * checker or lowering gave in the order it found things, so a function keeps its symbol whatever is
 * added to or taken from the rest of the program. Quoted in LLVM, so any text is valid. */
private function_symbol(l: *Lowering, id: usize, type_args: Buf[&Type]) -> string
    val program = l.program
    val symbol = program.symbols[id]
    val prefix = module_prefix(symbol.module_name)
    var arguments = ""
    if type_args.len() > 0
        arguments = "[" + stable_key_list(program, type_args) + "]"
    symbol.root match
        Some(root) -> s"$prefix.${declared_name(program, root)}${program.symbols[root].overload}$arguments.${symbol.name}#${l.local_ordinals[id]}"
        None -> prefix + "." + declared_name(program, id) + symbol.overload + arguments

/** A function's name as its symbol spells it: an object's constructor and methods after `object `,
 * kept apart from its companion class's, and so are the local functions inside them. */
private declared_name(program: TProgram, id: usize) -> string
    val symbol = program.symbols[id]
    if symbol.owner_class is Some(k)
        if program.classes[k].decl.object then return "object " + symbol.name
    symbol.name

/** The module path a symbol is spelled under: `<program>` for a file with no module header. */
private module_prefix(module_name: string) -> string = if module_name == "" then "<program>" else module_name

/** **A type spelled by qualified names**, for the symbols of the emitted text: a data type by its
 * module and name, a class or trait the same after `class `, an object after `object `, then the
 * type arguments. It tells apart any two types `type_key` tells apart, since two types of one module
 * never share a name but an object and its companion, and it never depends on the numbers the checker
 * gave the program's types in the order it found them, which an edit elsewhere moves. */
stable_type_key(program: TProgram, t: &Type) -> string = *t match
    Tuple(items) -> "(" + stable_key_list(program, items) + ")"
    Function(params, result, sendable) -> (if sendable then "@sendable (" else "(") + stable_key_list(program, params) + ") -> " + stable_type_key(program, result)
    ByName(inner) -> "-> " + stable_type_key(program, inner)
    Data(id, _, args) ->
        val d = program.data[id]
        s"${module_prefix(d.module_name)}.${d.name}[" + stable_key_list(program, args) + "]"
    Class(id, _, args) ->
        val k = program.classes[id]
        val kind = if k.decl.object then "object " else "class "
        s"$kind${module_prefix(k.module_name)}.${k.name}[" + stable_key_list(program, args) + "]"
    // The members' keys in sorted order, so a union is one key whatever order it was written in.
    Union(members) ->
        var keys: Buf[string] = buf()
        for m in members
            val k = stable_type_key(program, m)
            var at = keys.len()
            while at > 0 && k < keys[at - 1]
                at -= 1
            keys.insert(at, k)
        var out = "union("
        for i in 0..<keys.len()
            if i > 0 then out = out + " | "
            out = out + keys[i]
        out + ")"
    _ -> type_name(t)

private stable_key_list(program: TProgram, items: Buf[&Type]) -> string
    var out = ""
    for i in 0..<items.len()
        if i > 0 then out = out + ", "
        out = out + stable_type_key(program, items[i])
    out

private lower_function(l: *Lowering, k: usize) -> MirFunction
    val inst = l.instances[k]
    l.function_index = k
    l.tail_head = None
    l.tail_calls = false
    l.param_slots = buf()
    if inst.generated != Written then return lower_generated(l, inst)
    val f = l.program.functions[inst.function]
    val symbol = l.program.symbols[f.symbol]
    l.subst = inst.type_args
    l.subst_owner = l.program.symbols[symbol.root.unwrap_or(inst.function)].type_owner
    l.values = buf()
    l.slots = buf()
    l.blocks = buf()
    l.insts = buf()
    l.loops = buf()
    l.unit = symbol.unit
    l.trap_blocks = map()
    l.library = library_instance(l, k)
    l.here = symbol.decl.name_span
    l.locals = f.locals
    l.boxed = boxed_locals(l, symbol.root.unwrap_or(inst.function), f.locals)
    if inst.entry then return lower_entry(l, inst)
    val signature = signature_of(l, f)
    l.returns_value = signature.result is Some(_)
    l.current = new_block(l)
    // The function's own locals get slots; a local function's parameters are among them.
    l.local_slots = buf()
    for x in 0..<f.locals.len()
        val local = f.locals[x]
        if local.owner != f.symbol then l.local_slots.push(None)
        elif l.boxed[x] then l.local_slots.push(machine_slot(l, MRef))
        else l.local_slots.push(new_slot(l, local.ty))
    l.param_values = buf()
    symbol.root match
        None ->
            for i in 0..<symbol.params.len()
                l.param_values.push(if param_machine(l, symbol, i) is Some(t) then Some(fresh(l, t)) else None)
        Some(root) ->
            for i in 0..<symbol.params.len()
                val value = if machine(l, symbol.params[i]) is Some(t) then Some(Value(fresh(l, t))) else None
                bind_local(l, symbol.param_locals[i], value)
            for x in symbol.captured_locals
                if machine(l, f.locals[x].ty) is Some(t)
                    l.local_slots[x] = Some(Place(Value(fresh(l, MPtr)), if l.boxed[x] then MRef else t))
            for _ in l.program.symbols[root].params
                l.param_values.push(None)
            for x in symbol.captured_params
                if machine(l, l.program.symbols[root].params[x]) is Some(t) then l.param_values[x] = Some(fresh(l, t))
    f.body match
        Some(body) ->
            if loops_on_itself(l, symbol, body) then start_loop(l, symbol)
            l.tail_calls = !is_class_constructor(l.program, f.symbol)
            val result = lower_at(l, body, true)
            l.tail_calls = false
            // A class's object is made by its constructor and complete when the constructor is.
            if is_class_constructor(l.program, f.symbol) then l.insts.push(Publish)
            finish(l, returning(l, result))
        None ->
            if binding_target(symbol.decl) is Some(_) || handle_of(l, symbol) is Some(_) then binding_body(l, symbol, shim_symbol(function_symbol(l, f.symbol, inst.type_args)))
            elif c_close_class(l, symbol) is Some(k) then c_close_body(l, symbol, k)
            elif c_field_of(symbol.decl) is Some(field) then c_field_body(l, symbol, f.symbol, field)
            elif c_prototype_of(symbol.decl) is Some(p) then c_binding_body(l, symbol, f.symbol, p)
            else intrinsic_body(l, symbol)
    MirFunction(function_symbol(l, f.symbol, inst.type_args), signature, l.values, l.slots, l.blocks)

// A function that calls itself in tail position, at its own type arguments, is compiled as a loop:
// its parameters are kept in slots, and such a call stores its arguments there and jumps back to the
// start (see `tailrec.sysl`). A constructor finishes its object after its body, and a trait's method
// is compiled for each conforming type, so neither loops.
private loops_on_itself(l: *Lowering, symbol: FunctionSymbol, body: &TExpr) -> bool
    if symbol.constructor || is_trait_method(l, symbol) then return false
    val function = l.instances[l.function_index].function
    for site in tail_sites(function, body)
        if site.tail && site.direct && same_instance(l, function, site.type_args) then return true
    false

/** Whether a call of `function`, the function being lowered, at `type_args` calls the instance being
 * lowered. */
private same_instance(l: *Lowering, function: usize, type_args: Buf[&Type]) -> bool
    val inst = l.instances[l.function_index]
    if inst.entry || inst.function != function then return false
    instance_key(function, instance_args(l, l.program.symbols[function], type_args), false) == instance_key(function, inst.type_args, false)

// Stores a top-level function's parameters in slots, which a tail call stores the next ones into, and
// starts the block it jumps back to. A local function's parameters are locals already, given new
// values by each tail call as by the caller.
private start_loop(l: *Lowering, symbol: FunctionSymbol)
    if symbol.root is None
        for i in 0..<l.param_values.len()
            var slot: Option[Place] = None
            if l.param_values[i] is Some(v)
                slot = machine_slot(l, l.values[v])
                store(l, slot, Some(Value(v)))
            l.param_slots.push(slot)
    val head = new_block(l)
    finish_into(l, Jump(head), head)
    l.tail_head = Some(head)

/** The value of parameter `x` of the top-level function, where the code being lowered can reach it. */
private param_operand(l: *Lowering, x: usize) -> Option[Operand]
    if x < l.param_slots.len() && l.param_slots[x] is Some(p) then return load(l, Some(p))
    l.param_values[x] match
        Some(v) -> Some(Value(v))
        None -> None

// A call in tail position of another function, a method through its table or a function value, where
// the function being lowered yields its body's value: the block returns the call's value as soon as
// the call has made it, which is the shape emitting makes a tail call of (see `tail_call_at` in
// `emit.sysl`). A call followed by anything, such as a conversion of its result, keeps its place.
private returned_call(l: *Lowering, tail: bool, value: Option[Operand]) -> Option[Operand]
    if !tail || !l.tail_calls || l.insts.len() == 0 then return value
    val made = l.insts[l.insts.len() - 1] match
        Call(dest, _, _) -> dest match
            Some(d) -> value match
                Some(Value(v)) -> v == d
                _ -> false
            None -> value is None && !l.returns_value
        _ -> false
    if !made then return value
    leave(l, returning(l, value))
    None

// A call in tail position of the instance being lowered: its arguments are evaluated, every one
// before any parameter changes, then become the parameters, and control goes back to the start. The
// call has no value, since control never comes back to it.
private tail_call(l: *Lowering, function: usize, args: Buf[&TExpr]) -> Option[Operand]
    val symbol = l.program.symbols[function]
    var operands: Buf[Option[Operand]] = buf()
    for i in 0..<args.len()
        val a = args[i]
        if a.kind is TypeReceiver
            operands.push(None)
            continue
        val op = lower_expr(l, a)
        if *a.ty is Nothing then return None
        if machine(l, a.ty) is Some(_) && op is None then return None
        operands.push(op)
    for i in 0..<operands.len()
        if symbol.root is Some(_) then bind_local(l, symbol.param_locals[i], operands[i])
        elif i < l.param_slots.len() then store(l, l.param_slots[i], operands[i])
    leave(l, Jump(l.tail_head.unwrap()))
    None

// A closure entry takes the closure and the function's parameters. It keeps each captured local
// the closure holds in a slot of its own and calls the function with the slot's address, as a
// direct caller passes the address of its own; captured parameters are passed as values.
private lower_entry(l: *Lowering, inst: Instance) -> MirFunction
    val f = l.program.functions[inst.function]
    val direct = signature_of(l, f)
    var params: Buf[MirType] = buf()
    params.push(MRef)
    val closure = Value(fresh(l, MRef))
    var args: Buf[Operand] = buf()
    for p in l.program.symbols[inst.function].params
        if machine(l, p) is Some(t)
            params.push(t)
            args.push(Value(fresh(l, t)))
    l.returns_value = direct.result is Some(_)
    l.current = new_block(l)
    val symbol = l.program.symbols[inst.function]
    val shape = closure_shape(l, inst.function, inst.type_args, entry_instance(l, inst.function, inst.type_args))
    var i = 0usize
    for x in symbol.captured_locals
        if machine(l, l.locals[x].ty) is Some(_)
            val field = shape.fields[i]
            val slot = machine_slot(l, field.ty).unwrap()
            l.insts.push(Store(slot.address, load_field(l, closure, field)))
            args.push(slot.address)
            i += 1
    while i < shape.fields.len()
        args.push(load_field(l, closure, shape.fields[i]))
        i += 1
    val dest = direct.result match
        Some(t) -> Some(fresh(l, t))
        None -> None
    l.insts.push(Call(dest, Direct(instance(l, inst.function, inst.type_args)), args))
    finish(l, Return(dest match
        Some(d) -> Some(Value(d))
        None -> None))
    val name = function_symbol(l, inst.function, inst.type_args) + "#closure"
    MirFunction(name, MirSignature(params, direct.result), l.values, l.slots, l.blocks)

// The terminator that returns a body's value. A function that yields a value but whose body has
// none at this point is in code that cannot be reached.
private returning(l: *Lowering, value: Option[Operand]) -> Terminator
    if !l.returns_value then return Return(None)
    value match
        Some(v) -> Return(Some(v))
        None -> Unreachable

// A Sysl binding is a function like any other in the object file; its body passes its parameters to
// the binding's shim, with the context first, and returns what the shim returns. The shim is
// generated Sysl, called with the C convention, which converts each value at the boundary. A result
// the shim makes objects for comes with the descriptors and constant objects it makes them by, and a
// parameter the shim reads through the core library, a vector, with the functions it reads it by:
// each parameter's layouts after the parameters, then the result's.
private binding_body(l: *Lowering, symbol: FunctionSymbol, shim: string)
    var args: Buf[Operand] = buf()
    var params: Buf[MirType] = buf()
    var crossings: Buf[&Crossing] = buf()
    var layouts: Buf[Operand] = buf()
    // The arguments that are handles, and their classes: each must still hold its Sysl value.
    var passed: Buf[usize] = buf()
    var passed_classes: Buf[usize] = buf()
    // A method's declared parameters follow its receiver.
    val skipped = symbol.params.len() - symbol.decl.params.len()
    for i in 0..<symbol.params.len()
        var own: Buf[Operand] = buf()
        val t = concrete(l, symbol.params[i])
        val threaded = i >= skipped && is_threaded_param(symbol.decl.params[i - skipped])
        val c = if *t is Function(_, _, _) then callback_crossing(l, t, &own, threaded) else crossing(l, t, &own)
        crossings.push(c)
        if c.form is Handle(_) && l.param_values[i] is Some(_)
            if *t is Class(k, _, _)
                passed.push(args.len())
                passed_classes.push(k)
        // An array of bytes is copied into Sysl as it is, with no layout, and a handle's method reads
        // the receiver's Sysl value where it is.
        if !(c.form is Bytes) && !(c.form is Handle(_))
            for operand in own
                layouts.push(operand)
        if l.param_values[i] is Some(v)
            args.push(Value(v))
            params.push(l.values[v])
    val result_type = concrete(l, symbol.result.unwrap_or(Unit))
    val result_crossing = crossing(l, result_type, &layouts)
    for operand in layouts
        params.push(if operand is ConstObject(_) then MRef else MPtr)
        args.push(operand)
    // A Sysl call that may hand its callback to another thread may wait for that thread to call it,
    // so it is made with the thread safe for the collector, or the callback's first collection
    // would wait for this thread for ever.
    var takes_threaded = false
    for p in symbol.decl.params
        if is_threaded_param(p) then takes_threaded = true
    var seen = false
    for b in l.bound
        if b.shim == shim then seen = true
    val handle = handle_of(l, symbol)
    val reach = handle match
        Some(_) -> if is_handle_release(symbol.decl) then Release else Method(handle_method_name(symbol.decl))
        None -> TopLevel
    val target = handle match
        Some(k) -> handle_target(l.program.classes[k].decl).unwrap()
        None -> binding_target(symbol.decl).unwrap()
    // A `named` binding names each argument by its parameter's name in Sysl's spelling.
    var names: Buf[string] = buf()
    if is_named_binding(symbol.decl)
        for p in symbol.decl.params
            if p.pattern.kind is Name(n) then names.push(sysl_field_of(n)) else names.push("_")
    if !seen then l.bound.push(MirBinding(shim, target, symbol.name, crossings, result_crossing, symbol.unit, symbol.decl.name_span, reach, is_blocking_binding(symbol.decl) || takes_threaded, names))
    // Every handle the call uses, its receiver and each one passed, `close()`'s included, belongs to
    // the code running, or the program stops where it was called.
    for j in 0..<passed.len()
        check_owner(l, args[passed[j]], passed_classes[j], symbol.decl.name_span)
    if handle is Some(k) && !(passed.len() > 0 && passed[0] == 0)
        check_owner(l, args[0], k, symbol.decl.name_span)
    // A method other than `close()` runs only while its handle holds a Sysl value: on one `close()`
    // has given back, it stops the program where the method was called.
    if reach is Method(_)
        val word = load_field(l, args[0], FieldSlot(0, MPtr))
        val closed = compare(l, CmpEq, word, NullAddress)
        val site = trap_site(l, s"`${trap_name(l, handle.unwrap())}` is closed", symbol.decl.name_span)
        val stop = new_block(l)
        l.blocks[stop].term = CallerTrap(site)
        val next = new_block(l)
        finish_into(l, Branch(closed, stop, next), next)
    // A handle passed as a parameter is checked the same way, as the receiver of a method is.
    for j in 0..<passed.len()
        if passed[j] == 0 && handle is Some(_) then continue
        val word = load_field(l, args[passed[j]], FieldSlot(0, MPtr))
        val closed = compare(l, CmpEq, word, NullAddress)
        val site = trap_site(l, s"`${trap_name(l, passed_classes[j])}` is closed", symbol.decl.name_span)
        val stop = new_block(l)
        l.blocks[stop].term = CallerTrap(site)
        val next = new_block(l)
        finish_into(l, Branch(closed, stop, next), next)
    val result = machine(l, symbol.result.unwrap_or(Unit))
    val dest = result match
        Some(t) -> Some(fresh(l, t))
        None -> None
    l.insts.push(Call(dest, Runtime(shim, MirSignature(params, result)), args))
    finish(l, Return(dest match
        Some(d) -> Some(Value(d))
        None -> None))

// A C binding's body converts each argument to its C type at the width the C unit measured, calls
// the C function directly, and converts what it answers. An integer the other side cannot hold stops
// the program at the call, as a check in the core library does: an argument's reason names the C
// type by its sign and width, a result's the Avin type.
//
// A string argument is copied into NUL-terminated memory off the collected heap, which lives for the
// call and is freed once what C answered has been converted; one holding a NUL stops the program at
// the call. A string C answers is
// copied onto the heap, checked as UTF-8 unless it is answered as an `Array[byte]`, and then freed
// by the binding's `free:` function where it names one; a null answer is `None`, or stops the
// program where the result is no `Option`.
//
// A handle passed, a method's receiver first, must belong to the code running, unless its class is
// `shared`, and hold its C pointer, or the program stops at the call; C is passed the pointer, and
// null for `None`. A pointer C answers as a handle is null-checked as a string is, then made the
// handle's object, owned by the code running, after a reference of its own is taken through the
// class's `retain` where the binding says `borrowed`. A status is `Ok` for zero and `Err` of the
// code otherwise. Once the call has succeeded, what it `keeps:` is kept by the handle it answered, or
// by a method's receiver, and what it `consumes:` is closed without its `release`.
//
// An enum mirror crosses as the value its variant's enumerator has, at the width of the C type; a
// value C answers is the first variant holding it, and one no variant holds stops the program.
//
// Each `out` and `inout` parameter is a slot in the binding's frame, at the width of the C type it
// points at, which C is passed the address of: an `inout` one holds the argument, converted as any
// argument is, and an `out` one zero or null. Once C has returned, each is read as a result of that
// type is, a handle made, a string copied and a mirror's variant found; for a status, only when it is
// zero. The binding answers the C result, unless it is left out, followed by the out values, as a
// tuple of them where there is more than one, or in the status's `Ok`.
// A struct mirror's value is converted into C memory off the heap, laid out as the C unit measured
// the struct: passed by a pointer to it, by value through the glue, or `inout`, and read back into a
// new value where C fills it, answers it or writes it back; the memory is freed once the call has
// returned. An array of a mirror is converted element by element. An opaque value is passed as a
// pointer to its object's bytes, and one C answers is a new object the glue writes them into. A call
// passing or answering a struct by value, or answering an array through `array:`, goes through the
// C unit's glue; the array is copied into a new `Array` once the call has returned, and then freed.
private c_binding_body(l: *Lowering, symbol: FunctionSymbol, n: usize, p: CPrototype)
    val outer = l.library
    l.library = true
    val at = symbol.decl.name_span
    // What each Avin parameter passed, for `keeps:` and `consumes:`: its operand, its handle object
    // where it is a handle, perhaps null for `None`, its class and whether it is in an `Option`.
    var args: Buf[Operand] = buf()
    var objects: Buf[Option[Operand]] = buf()
    var classes: Buf[usize] = buf()
    var optionals: Buf[bool] = buf()
    // What C is passed, by the prototype's parameters: each handle as the C type its parameter names,
    // through its class's `as:` conversion where that is not the class's own, and each `out` and
    // `inout` parameter as the address of its slot.
    var passed: Buf[Operand] = buf()
    var scalars: Buf[CScalar] = buf()
    var copies: Buf[Operand] = buf()
    var outs: Buf[COutSlot] = buf()
    val skipped = symbol.params.len() - symbol.decl.params.len()
    val result_type = concrete(l, symbol.result.unwrap_or(Unit))
    val parts = c_result_parts(p, result_type, l.program.data) match
        Ok(parts) -> parts
        Err(why) -> panic(why)
    val blocking = c_is_blocking(symbol.decl)
    // Each function C is passed has a record of its own, whose address is the `userdata` beside it,
    // made before any argument is converted: by the prototype's index, the record, and by the Avin
    // parameter's, the slot holding it until the binding frees it, null once a handle keeps it.
    var records: Buf[Option[Operand]] = buf()
    for _ in p.params do records.push(None)
    var record_slots: Buf[Option[Place]] = buf()
    val positions = c_avin_positions(p)
    for i in 0..<positions.len()
        record_slots.push(None)
        val k = positions[i]
        if p.params[k].callback.len() == 0 then continue
        val threaded = i >= skipped && is_threaded_param(symbol.decl.params[i - skipped])
        val record = runtime_call(l, "avin_rt_c_callback_new", [MRef, MBool, MRef], MPtr, [Value(l.param_values[i].unwrap()), ConstBool(threaded), string_constant(l, symbol.name)])
        records[k] = Some(record)
        val slot = machine_slot(l, MPtr)
        store(l, slot, Some(record))
        record_slots[i] = slot
    // Each array parameter's pointer and length, the length an `int`, by the prototype's index.
    val arrays = c_arrays_in(l, symbol, p, blocking)
    // The C memory each mirror passed in was converted into, freed after the call.
    var structs: Buf[CHeld] = buf()
    var avin_types: Buf[&Type] = buf()
    for t in symbol.params
        avin_types.push(concrete(l, t))
    val callee = if c_binding_glued(symbol.decl, p, avin_types, concrete(l, parts.result), l.program.data, l.program.classes) then c_call_glue(n) else p.symbol
    val array_outs = c_array_outs_of(symbol.decl)
    var in_at = 0usize
    var out_at = 0usize
    for k in 0..<p.params.len()
        val q = p.params[k]
        // A length is the array's, filled in rather than passed by the caller.
        if q.length_of != "" && q.mode is CIn
            val a = arrays.of[c_param_index(p, q.length_of)].unwrap()
            val s = c_scalar_of(q.ty, Int(32), l.program.c_measures)
            scalars.push(s)
            passed.push(c_argument(l, a.length, Int(32), s, s"${c_integer_name(q.ty, s)}, the length of `${q.length_of}`", at))
            continue
        if q.length_of != ""
            val a = arrays.of[c_param_index(p, q.length_of)].unwrap()
            val t = concrete(l, parts.outs[out_at])
            out_at += 1
            var slot = c_out_slot(l, symbol, q, t, Some(a.length), Int(32), &copies, at)
            slot.limit = Some(a.limit)
            outs.push(slot)
            scalars.push(CAddress)
            passed.push(SlotAddress(slot.slot))
            continue
        if arrays.of[k] is Some(a)
            // A block is an object `keeps:` may name, and the frame keeps it across a blocking call.
            var block_class = 0usize
            if a.block
                if *concrete(l, symbol.params[in_at]) is Class(bk, _, _) then block_class = bk
            in_at += 1
            args.push(a.pointer)
            objects.push(if a.block then Some(a.array) else None)
            classes.push(block_class)
            optionals.push(false)
            scalars.push(CAddress)
            passed.push(a.pointer)
            continue
        if !(q.mode is CIn)
            val t = concrete(l, parts.outs[out_at])
            out_at += 1
            var given: Option[Operand] = None
            var given_type: &Type = Unit
            if q.mode is CInOut
                val x = Value(l.param_values[in_at].unwrap())
                given = Some(x)
                given_type = concrete(l, symbol.params[in_at])
                args.push(x)
                objects.push(None)
                classes.push(0)
                optionals.push(false)
                in_at += 1
            var slot = c_out_slot(l, symbol, q, t, given, given_type, &copies, at)
            for j in 0..<array_outs.len()
                if array_outs[j].name != "" && array_outs[j].name == q.name then slot.array = Some(j)
            outs.push(slot)
            scalars.push(CAddress)
            slot.memory match
                Some(memory) ->
                    structs.push(CHeld(memory, None))
                    passed.push(memory)
                None -> passed.push(SlotAddress(slot.slot))
            continue
        // A `userdata` is the address of the record of the function it carries, and a function
        // pointer the trampoline C calls it through.
        if q.userdata
            scalars.push(CAddress)
            passed.push(records[c_callback_of_userdata(p, k)].unwrap())
            continue
        // A pointer marked `null` is passed null.
        if q.nulled
            scalars.push(CAddress)
            passed.push(NullAddress)
            continue
        if q.callback.len() > 0
            val i = in_at
            in_at += 1
            args.push(Value(l.param_values[i].unwrap()))
            objects.push(None)
            classes.push(0)
            optionals.push(false)
            scalars.push(CAddress)
            passed.push(TrampolineAddress(c_trampoline(l, symbol, q, concrete(l, symbol.params[i]))))
            continue
        val i = in_at
        in_at += 1
        val t = concrete(l, symbol.params[i])
        val x = Value(l.param_values[i].unwrap())
        objects.push(None)
        classes.push(0)
        optionals.push(false)
        if c_struct_form(t, l.program.data) is Some(m)
            val memory = c_struct_in(l, symbol, m, t, x, at)
            structs.push(CHeld(memory, Some(m.class_index)))
            scalars.push(CAddress)
            args.push(memory)
            passed.push(memory)
            continue
        // An opaque value is its object's bytes, which the object keeps through a blocking call.
        if c_value_class_of(t, l.program.classes) is Some(_)
            objects[i] = Some(x)
            scalars.push(CAddress)
            args.push(x)
            passed.push(x)
            continue
        if c_handle_form(t, l.program.data, l.program.classes) is Some(h)
            val object = if !h.optional then x elif pointer_option(l, t) then x else option_pointer(l, t, x)
            objects[i] = Some(object)
            classes[i] = h.class_index
            optionals[i] = h.optional
            scalars.push(CAddress)
            val pointer = c_handle_pointer(l, object, h.class_index, h.optional, at)
            args.push(pointer)
            passed.push(c_converted(l, pointer, h.class_index, q.text))
            continue
        val form = c_text_form(t, l.program.data, l.program.classes)
        if form is TextString(optional)
            val copy = c_string_in(l, symbol, t, x, optional, i - skipped, at)
            copies.push(copy)
            scalars.push(CAddress)
            args.push(copy)
            passed.push(copy)
            continue
        if c_mirror_of(t, l.program.data) is Some(d)
            val s = c_scalar_of(q.ty, Int(64), l.program.c_measures)
            scalars.push(s)
            val value = c_mirror_argument(l, x, d, s)
            args.push(value)
            passed.push(value)
            continue
        val s = c_scalar_of(q.ty, t, l.program.c_measures)
        scalars.push(s)
        val converted = c_argument(l, x, t, s, c_integer_name(q.ty, s), at)
        args.push(converted)
        passed.push(converted)
    // A method of a handle is a use of it, which closes the view it lent last before C is called.
    if symbol.owner_class is Some(k) && skipped > 0
        if c_handle_type(l.program.classes[k].decl) is Some(_)
            if objects[0] is Some(o) then c_close_lent(l, o)
    var answers_handle = c_handle_form(parts.result, l.program.data, l.program.classes) is Some(_)
    for o in outs
        if c_handle_form(o.t, l.program.data, l.program.classes) is Some(_) then answers_handle = true
    val calls = CCall(s"`${p.symbol}` answered", args, objects, classes, optionals, skipped, answers_handle, record_slots)
    val answered = concrete(l, parts.result)
    // The glue writes the length of each array C answers through the addresses passed last, in the
    // order the binding names them.
    var length_slots: Buf[usize] = buf()
    for _ in array_outs
        val place = machine_slot(l, MInt(64))
        store(l, place, Some(ConstInt(64, "0")))
        length_slots.push(slot_of(place))
        scalars.push(CAddress)
        passed.push(SlotAddress(slot_of(place)))
    val length_slot: Option[usize] = if length_slots.len() > 0 then Some(length_slots[0]) else None
    val outs_read = COutsRead(n, length_slots)
    // A handle answered in a `Result`: `Ok` of the handle, or, where the `attach:` that ties what the
    // call keeps to the C object answers non-zero, `Err` of that answer, the handle given back.
    if c_attach_result(answered, outs.len(), l.program.data, l.program.classes) is Some(e)
        val ok_type = c_status_ok(answered)
        val h = c_handle_form(ok_type, l.program.data, l.program.classes).unwrap()
        val answer = fresh(l, MPtr)
        c_call(l, Call(Some(answer), CFunction(callee, scalars, Some(CAddress)), passed), blocking, arrays, objects)
        val handle = c_handle_out(l, symbol, calls, Value(answer), ok_type, h, s"`${p.symbol}` answered", at)
        val code = machine_slot(l, MInt(64))
        store(l, code, Some(ConstInt(64, "0")))
        val slot = machine_slot(l, MRef)
        val failed = new_block(l)
        val join = new_block(l)
        c_keeps(l, symbol, calls, Some(handle.object), false, Some(CAttachFail(slot_of(code), failed)))
        store(l, slot, Some(variant_object(l, answered, "Ok", Some(handle.value))))
        finish_into(l, Jump(join), failed)
        // What C could not be told of is not kept: the handle gives its reference back, and the
        // objects it was to keep with it.
        c_glue_call(l, s"avin_c_give_back_${h.class_index}", [handle.object])
        l.insts.push(Store(field_address(l, handle.object, FieldSlot(CHandleKept, MRef)), NullAddress))
        val x = load(l, code).unwrap()
        val error = c_mirror_of(e, l.program.data) match
            Some(d) -> c_mirror_answer(l, x, d, CSigned(64), s"`attach:` of `${trap_name(l, h.class_index)}` answered", at)
            None -> c_answer(l, x, CSigned(64), e, at)
        store(l, slot, Some(variant_object(l, answered, "Err", Some(error))))
        finish_into(l, Jump(join), join)
        c_release_copies(l, copies)
        c_release_structs(l, symbol, structs, arrays)
        c_free_records(l, record_slots)
        c_consumes(l, symbol, calls)
        val value = load(l, slot).unwrap()
        l.library = outer
        finish(l, Return(Some(value)))
        return
    // A status: `Ok` of the out values, read only when it is zero, and `Err` of the code otherwise.
    if c_status_error(answered, l.program.data) is Some(e)
        val mirror = c_mirror_of(e, l.program.data)
        val s = c_scalar_of(p.result, if mirror is Some(_) then Int(64) else e, l.program.c_measures)
        val answer = fresh(l, c_machine(s))
        c_call(l, Call(Some(answer), CFunction(callee, scalars, Some(s)), passed), blocking, arrays, objects)
        val ok = compare(l, CmpEq, Value(answer), c_zero(s))
        val slot = machine_slot(l, MRef)
        val yes = new_block(l)
        val no = new_block(l)
        val join = new_block(l)
        finish_into(l, Branch(ok, yes, no), yes)
        val read = c_read_outs(l, symbol, calls, outs, outs_read, at)
        c_keeps(l, symbol, calls, read.made, read.made_optional, None)
        val ok_type = c_status_ok(answered)
        store(l, slot, Some(variant_object(l, answered, "Ok", c_assemble(l, ok_type, read.values))))
        finish_into(l, Jump(join), no)
        // An array C answered before failing is freed unread.
        c_free_array_outs(l, outs, n)
        val code = mirror match
            Some(d) -> c_mirror_answer(l, Value(answer), d, s, s"`${p.symbol}` answered", at)
            None -> c_answer(l, Value(answer), s, e, at)
        store(l, slot, Some(variant_object(l, answered, "Err", Some(code))))
        finish_into(l, Jump(join), join)
        c_release_copies(l, copies)
        c_release_structs(l, symbol, structs, arrays)
        c_free_records(l, record_slots)
        c_consumes(l, symbol, calls)
        val value = load(l, slot).unwrap()
        l.library = outer
        finish(l, Return(Some(value)))
        return
    val free = c_free_text(symbol.decl)
    val result_form = c_text_form(answered, l.program.data, l.program.classes)
    val text_result = !(result_form is NoText) || (*answered is Unit && free is Some(_) && !(p.result is CVoidType))
    var first: Option[Operand] = None
    var made: Option[Operand] = None
    var made_optional = false
    // Memory C lends as its result is a view of it, its length the glue's.
    val view_form = c_memory_form(answered, l.program.data, l.program.classes)
    if view_form is Some(m) && length_slot is Some(ls)
        val answer = fresh(l, MPtr)
        c_call(l, Call(Some(answer), CFunction(callee, scalars, Some(CAddress)), passed), blocking, arrays, objects)
        val length = load(l, Some(Place(SlotAddress(ls), MInt(64)))).unwrap()
        first = Some(c_view_answer(l, calls, answered, m, Value(answer), length, s"`${p.symbol}` answered", at))
    elif text_result
        val answer = fresh(l, MPtr)
        c_call(l, Call(Some(answer), CFunction(callee, scalars, Some(CAddress)), passed), blocking, arrays, objects)
        // C may answer a pointer into a string it was passed, so the copies outlive the answer's.
        first = c_text_answer(l, Value(answer), answered, result_form, free, s"`${p.symbol}` answered", at)
    elif c_handle_form(answered, l.program.data, l.program.classes) is Some(h)
        val answer = fresh(l, MPtr)
        c_call(l, Call(Some(answer), CFunction(callee, scalars, Some(CAddress)), passed), blocking, arrays, objects)
        val handle = c_handle_out(l, symbol, calls, Value(answer), answered, h, s"`${p.symbol}` answered", at)
        first = Some(handle.value)
        made = Some(handle.object)
        made_optional = h.optional
    elif c_struct_of(answered, l.program.data) is Some(d)
        // The glue writes the struct C answered into memory passed first.
        val memory = c_struct_memory(l, ConstInt(64, c_struct_size(l, d).to_string()))
        structs.push(CHeld(memory, None))
        c_call(l, Call(None, CFunction(callee, c_first_scalar(scalars), None), c_first_operand(memory, passed)), blocking, arrays, objects)
        first = Some(c_struct_read(l, d, memory, s"`${p.symbol}` answered", at))
    elif c_value_class_of(answered, l.program.classes) is Some(_)
        // The glue writes the value C answered into a new object's bytes, passed first.
        val object = fresh(l, MRef)
        l.insts.push(Alloc(object, layout(l, answered).variants[0].descriptor))
        c_call(l, Call(None, CFunction(callee, c_first_scalar(scalars), None), c_first_operand(Value(object), passed)), blocking, arrays, objects)
        l.insts.push(Publish)
        first = Some(Value(object))
    elif *answered is Unit
        c_call(l, Call(None, CFunction(callee, scalars, None), passed), blocking, arrays, objects)
    elif c_mirror_of(answered, l.program.data) is Some(d)
        val s = c_scalar_of(p.result, Int(64), l.program.c_measures)
        val answer = fresh(l, c_machine(s))
        c_call(l, Call(Some(answer), CFunction(callee, scalars, Some(s)), passed), blocking, arrays, objects)
        first = Some(c_mirror_answer(l, Value(answer), d, s, s"`${p.symbol}` answered", at))
    else
        val s = c_scalar_of(p.result, answered, l.program.c_measures)
        val answer = fresh(l, c_machine(s))
        c_call(l, Call(Some(answer), CFunction(callee, scalars, Some(s)), passed), blocking, arrays, objects)
        first = Some(c_answer(l, Value(answer), s, answered, at))
    val read = c_read_outs(l, symbol, calls, outs, outs_read, at)
    c_release_copies(l, copies)
    c_release_structs(l, symbol, structs, arrays)
    if made is None
        made = read.made
        made_optional = read.made_optional
    c_keeps(l, symbol, calls, made, made_optional, None)
    c_free_records(l, record_slots)
    c_consumes(l, symbol, calls)
    var values: Buf[Option[Operand]] = buf()
    if !(*answered is Unit) then values.push(first)
    for v in read.values
        values.push(v)
    val value = if outs.len() == 0 then first else c_assemble(l, result_type, values)
    l.library = outer
    finish(l, Return(value))

/** An array passed to a binding: the array, perhaps null for `None`; the pointer C is passed, to its
 * elements or, for a `blocking` call, to a copy of them off the heap, null for `None`; its length, an
 * `int`, zero for `None`; the most a length C writes back may be, a `long`; its element size; and
 * whether C may write through the pointer, so a copy is copied back. */
private struct CArrayIn
    array: Operand
    pointer: Operand
    length: Operand
    limit: Operand
    size: usize
    write: bool
    /** For an array of a struct mirror, the mirror: its elements are converted into C memory, which
     * nothing copies back, freed with the strings its elements hold once the call has returned. */
    converted: Option[usize]
    /** Whether it is a `ByteBlock`, whose bytes C is passed where they are, and never a copy. */
    block: bool

/** The arrays a binding passes, by the prototype's index of each. */
private struct CArraysIn
    of: Buf[Option[CArrayIn]]

// The arrays among the parameters of the binding `symbol`, each made ready to pass. A call that is
// not `blocking` is passed a pointer to the elements in the heap, which no collection can run under;
// a `blocking` one a copy outside it, since a collection runs while it waits.
private c_arrays_in(l: *Lowering, symbol: FunctionSymbol, p: CPrototype, blocking: bool) -> CArraysIn
    var of: Buf[Option[CArrayIn]] = buf()
    var in_at = 0usize
    for k in 0..<p.params.len()
        val q = p.params[k]
        val i = in_at
        if c_is_avin_param(q) then in_at += 1
        // A block is passed as a pointer to its bytes where they are, which never move, so a
        // `blocking` call is passed them too; its length is filled into a `length(p)` beside it.
        if q.mode is CIn && c_is_avin_param(q) && i < symbol.params.len()
            val b = concrete(l, symbol.params[i])
            if c_memory_form(b, l.program.data, l.program.classes) is Some(_)
                of.push(Some(c_block_in(l, Value(l.param_values[i].unwrap()), symbol.decl.name_span)))
                continue
        if !c_is_array_param(p, k)
            of.push(None)
            continue
        val t = concrete(l, symbol.params[i])
        val x = Value(l.param_values[i].unwrap())
        val form = c_array_form(t, l.program.data, l.program.classes).unwrap()
        val size = c_array_element_size(form.element)
        val a = if !form.optional then x elif pointer_option(l, t) then x else option_pointer(l, t, x)
        val write = q.ty match
            CText(constant) -> !constant
            _ -> !(" " + q.pointee_text + " ").contains(" const ")
        var length = a
        var limit = a
        if form.optional
            length = runtime_call(l, "avin_rt_c_array_length", [MRef], MInt(32), [a])
            limit = runtime_call(l, "avin_rt_c_array_limit", [MRef], MInt(64), [a])
        else
            length = byte_length(l, a)
            limit = convert_op(l, SignExtend, MInt(64), length)
        if c_struct_of(form.element, l.program.data) is Some(d)
            val memory = c_struct_array_in(l, symbol, d, a, length, symbol.decl.name_span)
            of.push(Some(CArrayIn(a, memory, length, limit, c_struct_size(l, d), false, Some(d), false)))
            continue
        var pointer = a
        if blocking then pointer = runtime_call(l, "avin_rt_c_array_copy", [MRef, MInt(64)], MPtr, [a, ConstInt(64, size.to_string())])
        elif form.optional then pointer = runtime_call(l, "avin_rt_c_array_elements", [MRef], MPtr, [a])
        else
            val elements = fresh(l, MPtr)
            l.insts.push(Offset(elements, a, ArrayHeader))
            pointer = Value(elements)
        of.push(Some(CArrayIn(a, pointer, length, limit, size, write, None, false)))
    CArraysIn(of)

// The block `x` passed to C: checked to belong to the code running, then its address and its length,
// an `int` and a `long`, no `int` being too short for it.
private c_block_in(l: *Lowering, x: Operand, at: Span) -> CArrayIn
    var types: Buf[MirType] = buf()
    types.push(MRef)
    types.push(MPtr)
    var args: Buf[Operand] = buf()
    args.push(x)
    args.push(TrapSiteAddress(trap_site(l, "", at)))
    l.insts.push(Call(None, Runtime("avin_rt_c_memory_check", MirSignature(types, None)), args))
    val pointer = load_field(l, x, FieldSlot(0, MPtr))
    val limit = load_field(l, x, FieldSlot(CMemoryLength, MInt(64)))
    val length = resize(l, limit, 64, 32, true)
    CArrayIn(x, pointer, length, limit, 1, true, None, true)

// The index of the prototype's parameter named `name`.
private c_param_index(p: CPrototype, name: string) -> usize
    for k in 0..<p.params.len()
        if p.params[k].name == name then return k
    panic(s"the prototype has no parameter `$name`")

// Makes the C call `call`. A `blocking` one is bracketed by the runtime's `enter_safe` and
// `leave_safe`, so a collection runs while it waits; once the thread is running again, each array's
// copy is copied back where C may have written it, and freed, and each handle passed is used, so the
// frame keeps its object, whose finalizer would give its C pointer back, alive across the call.
private c_call(l: *Lowering, call: Inst, blocking: bool, arrays: CArraysIn, objects: Buf[Option[Operand]])
    if !blocking
        l.insts.push(call)
        return
    l.insts.push(Call(None, Runtime("avin_rt_enter_safe", MirSignature(buf(), None)), buf()))
    l.insts.push(call)
    l.insts.push(Call(None, Runtime("avin_rt_leave_safe", MirSignature(buf(), None)), buf()))
    for x in arrays.of
        if x is Some(a)
            if a.converted is Some(_) || a.block then continue
            var types: Buf[MirType] = buf()
            types.push(MRef)
            types.push(MPtr)
            types.push(MInt(64))
            types.push(MInt(32))
            var operands: Buf[Operand] = buf()
            operands.push(a.array)
            operands.push(a.pointer)
            operands.push(ConstInt(64, a.size.to_string()))
            operands.push(ConstInt(32, if a.write then "1" else "0"))
            l.insts.push(Call(None, Runtime("avin_rt_c_array_back", MirSignature(types, None)), operands))
    for o in objects
        if o is Some(object)
            val keep = machine_slot(l, MRef)
            store(l, keep, Some(object))

// The zero of the C integer crossing as `s`.
private c_zero(s: CScalar) -> Operand = s match
    CSigned(bits) -> ConstInt(bits, "0")
    CUnsigned(bits) -> ConstInt(bits, "0")
    _ -> ConstInt(32, "0")

// The copy of the string `x` of type `t`, perhaps an `Option` of one, passed to parameter `i` of a
// binding: NUL-terminated memory off the heap, null for `None`, which stops the program on a held NUL.
private c_string_in(l: *Lowering, symbol: FunctionSymbol, t: &Type, x: Operand, optional: bool, i: usize, at: Span) -> Operand
    val text = if !optional then x elif pointer_option(l, t) then x else option_pointer(l, t, x)
    val name = c_parameter_name(symbol.decl, i)
    val site = trap_site(l, s"the string passed to `$name` of `${symbol.name}` holds a NUL", at)
    runtime_call(l, "avin_rt_c_string_in", [MRef, MPtr], MPtr, [text, TrapSiteAddress(site)])

/** An `out` or `inout` parameter of a binding's call: its prototype parameter, the Avin type of its
 * value, the slot C writes it in, and how that value crosses where it is a scalar or a mirror. */
private struct COutSlot
    q: CParam
    t: &Type
    slot: usize
    scalar: CScalar
    /** For a length C writes back, the most it may be, a `long`: the array's length, or the
     * greatest `long` where `None` passed null. */
    limit: Option[Operand]
    /** For a struct mirror, the C memory C fills, passed in place of a slot. */
    memory: Option[Operand]
    /** Where it is the pointer to an array C answers that `array:` names, which of them it is. */
    array: Option[usize]

// The slot of the `out` or `inout` parameter `q`, whose value is of Avin type `t`, holding the
// argument `given`, of Avin type `given_type`, converted to the C type `q` points at, or zero or null.
// A C `float` is kept as its bits, which C writes; a string given is copied, and the copy freed with
// the others.
private c_out_slot(l: *Lowering, symbol: FunctionSymbol, q: CParam, t: &Type, given: Option[Operand], given_type: &Type, copies: *Buf[Operand], at: Span) -> COutSlot
    // A struct mirror C fills is C memory, holding the value given for an `inout` one.
    if c_struct_of(t, l.program.data) is Some(d)
        val memory = c_struct_memory(l, ConstInt(64, c_struct_size(l, d).to_string()))
        if given is Some(x) then c_struct_write(l, symbol, d, x, memory, 0, copies, at)
        return COutSlot(q, t, 0, CAddress, None, Some(memory), None)
    val pointer = c_handle_form(t, l.program.data, l.program.classes) is Some(_) || !(c_text_form(t, l.program.data, l.program.classes) is NoText) || c_array_form(t, l.program.data, l.program.classes) is Some(_) || c_memory_form(t, l.program.data, l.program.classes) is Some(_)
    if pointer
        val place = machine_slot(l, MPtr)
        var start: Operand = NullAddress
        if given is Some(x)
            val form = c_text_form(given_type, l.program.data, l.program.classes)
            if form is TextString(optional)
                val copy = c_string_in(l, symbol, given_type, x, optional, c_out_parameter_index(symbol, q), at)
                copies.push(copy)
                start = copy
        store(l, place, Some(start))
        return COutSlot(q, t, slot_of(place), CAddress, None, None, None)
    val mirror = c_mirror_of(t, l.program.data)
    val s = c_scalar_of(q.pointee, if mirror is Some(_) then Int(64) else t, l.program.c_measures)
    val m = if s is CBinary32 then MInt(32) else c_machine(s)
    val place = machine_slot(l, m)
    var start: Operand = s match
        CSigned(bits) -> ConstInt(bits, "0")
        CUnsigned(bits) -> ConstInt(bits, "0")
        CBoolean -> ConstBool(false)
        CBinary32 -> ConstInt(32, "0")
        _ -> ConstReal(0.0)
    if given is Some(x)
        if c_mirror_of(given_type, l.program.data) is Some(d) then start = c_mirror_argument(l, x, d, s)
        else
            start = c_argument(l, x, given_type, s, c_integer_name(q.pointee, s), at)
            if s is CBinary32 then start = convert_op(l, RealToBinary32, MInt(32), start)
    store(l, place, Some(start))
    COutSlot(q, t, slot_of(place), s, None, None, None)

// The position among a binding's declared parameters of the `inout` parameter `q`, for a trap's
// name of it.
private c_out_parameter_index(symbol: FunctionSymbol, q: CParam) -> usize
    for i in 0..<symbol.decl.params.len()
        if symbol.decl.params[i].pattern.kind is Name(n) && n == q.name then return i
    0

private slot_of(place: Option[Place]) -> usize = place.unwrap().address match
    SlotAddress(id) -> id
    _ -> panic("a slot's place is its address")

/** The out values read after a call, each perhaps none for `unit`, and the first handle among them,
 * which keeps what the call `keeps:` where the C result is no handle, perhaps null where it is in an
 * `Option`. */
private struct COutValues
    values: Buf[Option[Operand]]
    made: Option[Operand]
    made_optional: bool

// Reads each out value from its slot, as a result of the C type it points at is read.
private c_read_outs(l: *Lowering, symbol: FunctionSymbol, call: CCall, outs: Buf[COutSlot], reading: COutsRead, at: Span) -> COutValues
    var values: Buf[Option[Operand]] = buf()
    var made: Option[Operand] = None
    var made_optional = false
    for o in outs
        val who = s"${call.symbol} through `${o.q.name}`"
        if o.memory is Some(memory)
            values.push(Some(c_struct_read(l, c_struct_of(o.t, l.program.data).unwrap(), memory, who, at)))
            continue
        if o.array is Some(j)
            val pointer = load(l, Some(Place(SlotAddress(o.slot), MPtr))).unwrap()
            val length = load(l, Some(Place(SlotAddress(reading.length_slots[j]), MInt(64)))).unwrap()
            c_memory_form(o.t, l.program.data, l.program.classes) match
                Some(m) -> values.push(Some(c_view_answer(l, call, o.t, m, pointer, length, who, at)))
                None -> values.push(Some(c_array_answer(l, reading.symbol, j, o.t, pointer, length, who, at)))
            continue
        val place = Some(Place(SlotAddress(o.slot), if o.scalar is CAddress then MPtr elif o.scalar is CBinary32 then MInt(32) else c_machine(o.scalar)))
        val x = load(l, place).unwrap()
        if c_handle_form(o.t, l.program.data, l.program.classes) is Some(h)
            val handle = c_handle_out(l, symbol, call, x, o.t, h, who, at)
            values.push(Some(handle.value))
            if made is None
                made = Some(handle.object)
                made_optional = h.optional
            continue
        val form = c_text_form(o.t, l.program.data, l.program.classes)
        if !(form is NoText)
            values.push(c_text_answer(l, x, o.t, form, None, who, at))
            continue
        if c_mirror_of(o.t, l.program.data) is Some(d)
            values.push(Some(c_mirror_answer(l, x, d, o.scalar, who, at)))
            continue
        val v = if o.scalar is CBinary32 then convert_op(l, Binary32ToReal, MReal, x) else x
        val answer = c_answer(l, v, o.scalar, o.t, at)
        // A length C used may be no more than the array's.
        if o.limit is Some(limit)
            val width = *o.t match
                Int(w) -> w
                _ -> 64u32
            val wide = if width < 64 then resize(l, answer, width, 64, true) else answer
            trap_if(l, compare(l, CmpGt, wide, limit), s"${call.symbol} through `${o.q.name}` a length greater than the length of `${o.q.length_of}`", at)
        values.push(Some(answer))
    COutValues(values, made, made_optional)

/** What reading a binding's out values needs beyond their slots: the binding's symbol, which names
 * its glue, and the slots the glue writes the length of each array C answers into. */
private struct COutsRead
    symbol: usize
    length_slots: Buf[usize]

/** C memory a call's struct mirrors were converted into, freed once the call has returned: for one
 * passed in, its mirror, whose strings were copied into it and are freed with it. What C fills or
 * answers is C's to write, so its strings are not freed. */
private struct CHeld
    memory: Operand
    mirror: Option[usize]

// `scalars` with a pointer before them: the struct the glue writes what C answers into.
private c_first_scalar(scalars: Buf[CScalar]) -> Buf[CScalar]
    var out: Buf[CScalar] = buf()
    out.push(CAddress)
    for s in scalars
        out.push(s)
    out

// `rest` with `first` before it.
private c_first_operand(first: Operand, rest: Buf[Operand]) -> Buf[Operand]
    var out: Buf[Operand] = buf()
    out.push(first)
    for x in rest
        out.push(x)
    out

// `size` bytes of C memory, every one zero, for one call's structs.
private c_struct_memory(l: *Lowering, size: Operand) -> Operand = runtime_call(l, "avin_rt_c_struct_new", [MInt(64)], MPtr, [size])

// The size of the struct the mirror `d` mirrors, as the C unit measured it.
private c_struct_size(l: *Lowering, d: usize) -> usize = usize(c_value(l, c_value_key(CConstInteger, c_size_expr(c_struct_own(d)))).integer)

// The offset of field `j` of the struct the mirror `d` mirrors, as the C unit measured it.
private c_struct_offset(l: *Lowering, d: usize, j: usize) -> usize
    val name = c_struct_field_name(l.program.data[d].decl.variants[0].fields[j])
    usize(c_value(l, c_value_key(CConstInteger, c_offset_expr(c_struct_own(d), name))).integer)

// How field `j` of the mirror `d`, of Avin type `t`, crosses: at the width the C unit measured of
// its C type, an enum mirror's as the integer its enumerators are.
private c_struct_field_scalar(l: *Lowering, d: usize, j: usize, t: &Type) -> CScalar =
    c_scalar_of(CTypedef(c_struct_field_type(d, j)), if c_mirror_of(t, l.program.data) is Some(_) then Int(64) else t, l.program.c_measures)

// Field `j` of the struct the mirror `d` mirrors, as a trap names its C type: `` `x` of `T` ``.
private c_struct_field_label(l: *Lowering, d: usize, j: usize) -> CType =
    CTypedef(s"`${c_struct_field_name(l.program.data[d].decl.variants[0].fields[j])}` of `${c_struct_text(l.program.data[d].decl)}`")

// The Avin name of field `j` of the mirror `d`.
private c_struct_field_avin(l: *Lowering, d: usize, j: usize) -> string = l.program.data[d].variants[0].field_names[j]

// The C memory the value `x` of the struct mirror `m` is passed to C in, `t` its Avin type: a copy
// laid out as C's struct, or null for an `Option`'s `None`. Its strings are copies, freed with it.
private c_struct_in(l: *Lowering, symbol: FunctionSymbol, m: CHandleForm, t: &Type, x: Operand, at: Span) -> Operand
    val d = m.class_index
    val size = ConstInt(64, c_struct_size(l, d).to_string())
    // The copies of strings are found again in the memory to be freed.
    var copies: Buf[Operand] = buf()
    if !m.optional
        val memory = c_struct_memory(l, size)
        c_struct_write(l, symbol, d, x, memory, 0, &copies, at)
        return memory
    val value = if pointer_option(l, t) then x else option_pointer(l, t, x)
    val slot = machine_slot(l, MPtr)
    val none = new_block(l)
    val present = new_block(l)
    val join = new_block(l)
    finish_into(l, Branch(compare(l, CmpEq, value, NullAddress), none, present), none)
    store(l, slot, Some(NullAddress))
    finish_into(l, Jump(join), present)
    val memory = c_struct_memory(l, size)
    c_struct_write(l, symbol, d, value, memory, 0, &copies, at)
    store(l, slot, Some(memory))
    finish_into(l, Jump(join), join)
    load(l, slot).unwrap()

// Writes the value `x` of the struct mirror `d` into C memory at `offset` bytes past `base`, each
// field at its measured offset and width: a scalar converted as an argument is, with the same traps,
// an enum mirror as its enumerator's value, a string as a NUL-terminated copy off the heap, which
// `copies` collects, and another mirror in place.
private c_struct_write(l: *Lowering, symbol: FunctionSymbol, d: usize, x: Operand, base: Operand, offset: usize, copies: *Buf[Operand], at: Span)
    val t: &Type = Data(d, l.program.data[d].name, buf())
    val slots = layout(l, t).variants[0].fields
    val types = l.program.data[d].variants[0].fields
    for j in 0..<types.len()
        val ft = types[j]
        val v = slots[j] match
            Some(f) -> load_field(l, x, f)
            None -> continue
        val off = offset + c_struct_offset(l, d, j)
        if c_struct_of(ft, l.program.data) is Some(e)
            c_struct_write(l, symbol, e, v, base, off, copies, at)
            continue
        val address = field_address(l, base, FieldSlot(off, MPtr))
        if c_text_form(ft, l.program.data, l.program.classes) is TextString(optional)
            val text = if !optional then v elif pointer_option(l, ft) then v else option_pointer(l, ft, v)
            val site = trap_site(l, s"the string in the field `${c_struct_field_avin(l, d, j)}` of `${l.program.data[d].name}` passed to `${symbol.name}` holds a NUL", at)
            val copy = runtime_call(l, "avin_rt_c_string_in", [MRef, MPtr], MPtr, [text, TrapSiteAddress(site)])
            copies.push(copy)
            l.insts.push(Store(address, copy))
            continue
        val s = c_struct_field_scalar(l, d, j, ft)
        if c_mirror_of(ft, l.program.data) is Some(e)
            l.insts.push(Store(address, c_mirror_argument(l, v, e, s)))
            continue
        var value = c_argument(l, v, ft, s, c_integer_name(c_struct_field_label(l, d, j), s), at)
        if s is CBinary32 then value = convert_op(l, RealToBinary32, MInt(32), value)
        l.insts.push(Store(address, value))

// Frees the copies of strings `c_struct_write` wrote into the value of the struct mirror `d` at
// `offset` bytes past `base`.
private c_struct_free_strings(l: *Lowering, d: usize, base: Operand, offset: usize)
    val types = l.program.data[d].variants[0].fields
    for j in 0..<types.len()
        val ft = types[j]
        val off = offset + c_struct_offset(l, d, j)
        if c_struct_of(ft, l.program.data) is Some(e)
            c_struct_free_strings(l, e, base, off)
            continue
        if !(c_text_form(ft, l.program.data, l.program.classes) is TextString(_)) then continue
        val p = fresh(l, MPtr)
        l.insts.push(Load(p, field_address(l, base, FieldSlot(off, MPtr))))
        var types_in: Buf[MirType] = buf()
        types_in.push(MPtr)
        var args: Buf[Operand] = buf()
        args.push(Value(p))
        l.insts.push(Call(None, Runtime("avin_rt_c_string_free", MirSignature(types_in, None)), args))

// Whether the struct mirror `d` holds a string, in a field of its own or of a mirror it holds.
private c_struct_has_strings(l: *Lowering, d: usize) -> bool
    for ft in l.program.data[d].variants[0].fields
        if c_struct_of(ft, l.program.data) is Some(e)
            if c_struct_has_strings(l, e) then return true
        elif c_text_form(ft, l.program.data, l.program.classes) is TextString(_) then return true
    false

// A new value of the struct mirror `d` read out of the C memory at `base`, each field at its
// measured offset and width: a scalar converted as a result is, with the same traps, an enum
// mirror's variant found, a string copied and checked as UTF-8 (null `None`, or a stop), and another
// mirror read in place. `who` says what answered it, as a trap names it.
private c_struct_read(l: *Lowering, d: usize, base: Operand, who: string, at: Span) -> Operand = c_struct_read_at(l, d, base, 0, who, at)

private c_struct_read_at(l: *Lowering, d: usize, base: Operand, offset: usize, who: string, at: Span) -> Operand
    val t: &Type = Data(d, l.program.data[d].name, buf())
    val shape = layout(l, t).variants[0]
    val types = l.program.data[d].variants[0].fields
    var values: Buf[Option[Operand]] = buf()
    for j in 0..<types.len()
        val ft = types[j]
        val off = offset + c_struct_offset(l, d, j)
        if c_struct_of(ft, l.program.data) is Some(e)
            values.push(Some(c_struct_read_at(l, e, base, off, who, at)))
            continue
        val address = field_address(l, base, FieldSlot(off, MPtr))
        val named = s"the field `${c_struct_field_avin(l, d, j)}` of the `${l.program.data[d].name}` $who"
        val form = c_text_form(ft, l.program.data, l.program.classes)
        if form is TextString(_)
            val p = fresh(l, MPtr)
            l.insts.push(Load(p, address))
            values.push(c_text_answer(l, Value(p), ft, form, None, named, at))
            continue
        val s = c_struct_field_scalar(l, d, j, ft)
        val m = if s is CBinary32 then MInt(32) else c_machine(s)
        val loaded = fresh(l, m)
        l.insts.push(Load(loaded, address))
        if c_mirror_of(ft, l.program.data) is Some(e)
            values.push(Some(c_mirror_answer(l, Value(loaded), e, s, named, at)))
            continue
        val x = if s is CBinary32 then convert_op(l, Binary32ToReal, MReal, Value(loaded)) else Value(loaded)
        values.push(Some(c_answer(l, x, s, ft, at)))
    if l.descriptors[shape.descriptor].constant then return ConstObject(shape.descriptor)
    val object = fresh(l, MRef)
    l.insts.push(Alloc(object, shape.descriptor))
    for j in 0..<values.len()
        if shape.fields[j] is Some(field)
            if values[j] is Some(v) then l.insts.push(Store(field_address(l, Value(object), field), v))
    l.insts.push(Publish)
    Value(object)

/** A loop over the indices from zero up to a count, a `long`: the slot holding the index, the block
 * testing it, the block after the loop, and the index in the body. */
private struct CLoop
    slot: Option[Place]
    head: usize
    exit: usize
    index: Operand

// Starts a loop over the indices below `count`, leaving the code in its body.
private c_loop_start(l: *Lowering, count: Operand) -> CLoop
    val slot = machine_slot(l, MInt(64))
    store(l, slot, Some(ConstInt(64, "0")))
    val head = new_block(l)
    val body = new_block(l)
    val exit = new_block(l)
    finish_into(l, Jump(head), head)
    val i = load(l, slot).unwrap()
    finish_into(l, Branch(compare(l, CmpLt, i, count), body, exit), body)
    CLoop(slot, head, exit, i)

// Ends the body of `loop`, leaving the code after it.
private c_loop_end(l: *Lowering, each: CLoop)
    store(l, each.slot, Some(binary(l, MInt(64), OpAdd, each.index, ConstInt(64, "1"))))
    finish_into(l, Jump(each.head), each.exit)

// The address `index` elements of `size` bytes past `base`.
private c_element_address(l: *Lowering, base: Operand, index: Operand, size: usize) -> Operand
    val offset = if size == 1 then index else binary(l, MInt(64), OpMul, index, ConstInt(64, size.to_string()))
    val address = fresh(l, MPtr)
    l.insts.push(Index(address, base, offset))
    Value(address)

// The C memory the elements of the array `a` of the struct mirror `d`, `length` of them, perhaps
// null for `None` with a length of zero, are converted into for a call: each laid out as C's struct,
// one after another. The copies of their strings are freed with it.
private c_struct_array_in(l: *Lowering, symbol: FunctionSymbol, d: usize, a: Operand, length: Operand, at: Span) -> Operand
    val stride = c_struct_size(l, d)
    val elements = runtime_call(l, "avin_rt_c_array_elements", [MRef], MPtr, [a])
    val count = convert_op(l, SignExtend, MInt(64), length)
    val memory = c_struct_memory(l, binary(l, MInt(64), OpMul, count, ConstInt(64, stride.to_string())))
    var copies: Buf[Operand] = buf()
    val each = c_loop_start(l, count)
    val element = fresh(l, MRef)
    l.insts.push(Load(element, c_element_address(l, elements, each.index, 8)))
    c_struct_write(l, symbol, d, Value(element), c_element_address(l, memory, each.index, stride), 0, &copies, at)
    c_loop_end(l, each)
    memory

// Frees the C memory a call's struct mirrors were converted into, once it has returned, and the
// copies of the strings in what was passed in; memory that is null, an `Option`'s `None`, holds none.
private c_release_structs(l: *Lowering, symbol: FunctionSymbol, structs: Buf[CHeld], arrays: CArraysIn)
    for h in structs
        if h.mirror is Some(d)
            if c_struct_has_strings(l, d)
                val present = new_block(l)
                val join = new_block(l)
                finish_into(l, Branch(compare(l, CmpEq, h.memory, NullAddress), join, present), present)
                c_struct_free_strings(l, d, h.memory, 0)
                finish_into(l, Jump(join), join)
        c_free_struct_memory(l, h.memory)
    for x in arrays.of
        val a = x match
            Some(a) -> a
            None -> continue
        val d = a.converted match
            Some(d) -> d
            None -> continue
        if c_struct_has_strings(l, d)
            val each = c_loop_start(l, convert_op(l, SignExtend, MInt(64), a.length))
            c_struct_free_strings(l, d, c_element_address(l, a.pointer, each.index, a.size), 0)
            c_loop_end(l, each)
        c_free_struct_memory(l, a.pointer)

private c_free_struct_memory(l: *Lowering, memory: Operand)
    var types: Buf[MirType] = buf()
    types.push(MPtr)
    var args: Buf[Operand] = buf()
    args.push(memory)
    l.insts.push(Call(None, Runtime("avin_rt_c_struct_free", MirSignature(types, None)), args))

// Frees, unread, the array C answered through the `out` pointer `array:` names, as a failed status
// leaves it.
private c_free_array_outs(l: *Lowering, outs: Buf[COutSlot], symbol: usize)
    for o in outs
        // Memory C lends is C's, and nothing frees it.
        val j = o.array match
            Some(j) -> j
            None -> continue
        if c_memory_form(o.t, l.program.data, l.program.classes) is Some(_) then continue
        val pointer = load(l, Some(Place(SlotAddress(o.slot), MPtr))).unwrap()
        var params: Buf[CScalar] = buf()
        params.push(CAddress)
        var args: Buf[Operand] = buf()
        args.push(pointer)
        l.insts.push(Call(None, CFunction(c_array_free_glue(symbol, j), params, None), args))

// The array C answered at `pointer`, `length` elements long, as the Avin type `t`, an `Array` or an
// `Option` of one: copied into a new array, each element as its type is, a struct mirror's read as
// an out value is, and then freed through the binding's glue, the `j`th array's. Null is `None` for
// an `Option`, and otherwise an empty array where the length is zero and a stop where it is not; a
// negative length, or one longer than an array holds, stops the program, before null does.
private c_array_answer(l: *Lowering, symbol: usize, j: usize, t: &Type, pointer: Operand, length: Operand, who: string, at: Span) -> Operand
    val form = c_array_form(t, l.program.data, l.program.classes).unwrap()
    val absent = compare(l, CmpEq, pointer, NullAddress)
    if !form.optional
        c_array_length_traps(l, length, who, at)
        val counted = compare(l, CmpNe, length, ConstInt(64, "0"))
        val both = fresh(l, MBool)
        l.insts.push(Select(both, absent, counted, ConstBool(false)))
        trap_if(l, Value(both), s"$who null", at)
        return c_array_copy_out(l, symbol, j, t, form.element, pointer, length, who, at)
    val slot = machine_slot(l, MRef)
    val none = new_block(l)
    val present = new_block(l)
    val join = new_block(l)
    finish_into(l, Branch(absent, none, present), none)
    store(l, slot, Some(NullAddress))
    finish_into(l, Jump(join), present)
    val inner = option_argument(l.options, t).unwrap()
    store(l, slot, Some(c_array_copy_out(l, symbol, j, inner, form.element, pointer, length, who, at)))
    finish_into(l, Jump(join), join)
    val value = load(l, slot).unwrap()
    if pointer_option(l, t) then value else option_object(l, t, value)

// Stops the program where the length of an array C answers is negative or longer than an array holds.
private c_array_length_traps(l: *Lowering, length: Operand, who: string, at: Span)
    trap_if(l, compare(l, CmpLt, length, ConstInt(64, "0")), s"$who a negative length", at)
    trap_if(l, compare(l, CmpGt, length, ConstInt(64, "2147483647")), s"$who more elements than an array holds", at)

private c_array_copy_out(l: *Lowering, symbol: usize, j: usize, array: &Type, element: &Type, pointer: Operand, length: Operand, who: string, at: Span) -> Operand
    c_array_length_traps(l, length, who, at)
    val descriptor = layout(l, array).variants[0].descriptor
    val made = runtime_call(l, "avin_rt_new_array", [MPtr, MInt(64)], MRef, [DescriptorAddress(descriptor), length])
    val each = c_loop_start(l, length)
    val elements = fresh(l, MPtr)
    l.insts.push(Offset(elements, made, ArrayHeader))
    if c_struct_of(element, l.program.data) is Some(d)
        val value = c_struct_read(l, d, c_element_address(l, pointer, each.index, c_struct_size(l, d)), s"element of the array $who", at)
        l.insts.push(Store(c_element_address(l, Value(elements), each.index, 8), value))
    else
        val size = c_array_element_size(element)
        val m = mir_type(element).unwrap()
        val x = fresh(l, m)
        l.insts.push(Load(x, c_element_address(l, pointer, each.index, size)))
        l.insts.push(Store(c_element_address(l, Value(elements), each.index, size), Value(x)))
    c_loop_end(l, each)
    l.insts.push(Publish)
    var params: Buf[CScalar] = buf()
    params.push(CAddress)
    var args: Buf[Operand] = buf()
    args.push(pointer)
    l.insts.push(Call(None, CFunction(c_array_free_glue(symbol, j), params, None), args))
    made

// The memory C lent at `pointer`, `length` bytes long, as the Avin type `t`, a view of the form `m`:
// a new view of it, lent by the call's receiver. Null is `None` for an `Option`, and otherwise an
// empty view where the length is zero and a stop where it is not; a negative length, or one longer
// than an `int`, stops the program.
private c_view_answer(l: *Lowering, call: CCall, t: &Type, m: CMemoryForm, pointer: Operand, length: Operand, who: string, at: Span) -> Operand
    val owner = trap_name(l, call.classes[0])
    val name = l.program.classes[m.class_index].name
    val lender = CViewLender(call.objects[0], s"the `$name` of `$owner` was closed when `$owner` was used again", s"the `$name` of `$owner` belongs to another thread")
    c_view_lent(l, lender, t, m, pointer, length, who, at, None)

/** Who lends a view and what its traps say: the handle lending it, which keeps it as the view it lent
 * last, or none for memory C lends a callback for the call; and the reasons a closed view and a use by
 * another thread stop the program with. */
private struct CViewLender
    lender: Option[Operand]
    closed: string
    foreign: string

// The view `lender` lends of `pointer`, as `c_view_answer` says; the view itself, or null for `None`,
// is also stored in `raw` where there is one, so what lent it can close it.
private c_view_lent(l: *Lowering, lender: CViewLender, t: &Type, m: CMemoryForm, pointer: Operand, length: Operand, who: string, at: Span, raw: Option[Place]) -> Operand
    val absent = compare(l, CmpEq, pointer, NullAddress)
    if !m.optional
        val counted = compare(l, CmpNe, length, ConstInt(64, "0"))
        val both = fresh(l, MBool)
        l.insts.push(Select(both, absent, counted, ConstBool(false)))
        trap_if(l, Value(both), s"$who null", at)
        val made = c_view_made(l, lender, m, pointer, length, who, at)
        if raw is Some(_) then store(l, raw, Some(made))
        return made
    val slot = machine_slot(l, MRef)
    val none = new_block(l)
    val present = new_block(l)
    val join = new_block(l)
    finish_into(l, Branch(absent, none, present), none)
    store(l, slot, Some(NullAddress))
    finish_into(l, Jump(join), present)
    store(l, slot, Some(c_view_made(l, lender, m, pointer, length, who, at)))
    finish_into(l, Jump(join), join)
    val value = load(l, slot).unwrap()
    if raw is Some(_) then store(l, raw, Some(value))
    if pointer_option(l, t) then value else option_object(l, t, value)

// A new view of the memory at `pointer`, of class `m.class_index`, owned by the code running and, where
// a handle lends it, kept by that handle as the view it lent last, to close it at its next use.
private c_view_made(l: *Lowering, lent: CViewLender, m: CMemoryForm, pointer: Operand, length: Operand, who: string, at: Span) -> Operand
    trap_if(l, compare(l, CmpLt, length, ConstInt(64, "0")), s"$who a negative length", at)
    trap_if(l, compare(l, CmpGt, length, ConstInt(64, "2147483647")), s"$who more bytes than a view holds", at)
    val name = l.program.classes[m.class_index].name
    val t: &Type = Class(m.class_index, name, buf())
    val object = fresh(l, MRef)
    l.insts.push(Alloc(object, layout(l, t).variants[0].descriptor))
    val v = Value(object)
    l.insts.push(Store(field_address(l, v, FieldSlot(0, MPtr)), pointer))
    val mine = fresh(l, MInt(64))
    l.insts.push(Load(mine, OwnerWord))
    l.insts.push(Store(field_address(l, v, FieldSlot(CMemoryOwner, MInt(64))), Value(mine)))
    l.insts.push(Store(field_address(l, v, FieldSlot(CMemoryLength, MInt(64))), length))
    l.insts.push(Store(field_address(l, v, FieldSlot(CMemoryClosedReason, MRef)), string_constant(l, lent.closed)))
    l.insts.push(Store(field_address(l, v, FieldSlot(CMemoryForeignReason, MRef)), string_constant(l, lent.foreign)))
    lent.lender match
        Some(lender) ->
            l.insts.push(Store(field_address(l, v, FieldSlot(CMemoryLender, MRef)), lender))
            l.insts.push(Publish)
            l.insts.push(Store(field_address(l, lender, FieldSlot(CHandleLent, MRef)), v))
        None -> l.insts.push(Publish)
    v

// Closes the view `view`, unless it is null: what lent it has ended, and C may free the memory.
private c_close_view(l: *Lowering, view: Operand)
    val open = new_block(l)
    val join = new_block(l)
    finish_into(l, Branch(compare(l, CmpEq, view, NullAddress), join, open), open)
    l.insts.push(Store(field_address(l, view, FieldSlot(CMemoryClosed, MInt(64))), ConstInt(64, "1")))
    finish_into(l, Jump(join), join)

// Closes the view the handle `object` lent last, if it is open: the handle is being used, and the
// use may free or replace the memory the view reads.
private c_close_lent(l: *Lowering, object: Operand)
    val slot = field_address(l, object, FieldSlot(CHandleLent, MRef))
    val lent = fresh(l, MRef)
    l.insts.push(Load(lent, slot))
    val open = new_block(l)
    val join = new_block(l)
    finish_into(l, Branch(compare(l, CmpEq, Value(lent), NullAddress), join, open), open)
    l.insts.push(Store(field_address(l, Value(lent), FieldSlot(CMemoryClosed, MInt(64))), ConstInt(64, "1")))
    l.insts.push(Store(field_address(l, object, FieldSlot(CHandleLent, MRef)), NullAddress))
    finish_into(l, Jump(join), join)

// The binding's answer of Avin type `t` made of `values`: one value alone is itself, and more are a
// tuple of them.
private c_assemble(l: *Lowering, t: &Type, values: Buf[Option[Operand]]) -> Option[Operand]
    if values.len() == 0 then return None
    if values.len() == 1 then return values[0]
    val shape = layout(l, concrete(l, t)).variants[0]
    val object = fresh(l, MRef)
    l.insts.push(Alloc(object, shape.descriptor))
    for i in 0..<values.len()
        if shape.fields[i] is Some(field)
            if values[i] is Some(v) then l.insts.push(Store(field_address(l, Value(object), field), v))
    l.insts.push(Publish)
    Some(Value(object))

/** A handle C answered: the Avin value, perhaps an `Option`, and the object, null for `None`. */
private struct CHandleOut
    value: Operand
    object: Operand

// The value `t` makes of the handle pointer C answered at `answer`: null is `None`, or stops the
// program where `t` is no `Option`, `who` saying what answered; any other pointer is a new object of
// the class, as `c_new_handle` makes it.
private c_handle_out(l: *Lowering, symbol: FunctionSymbol, call: CCall, answer: Operand, t: &Type, h: CHandleForm, who: string, at: Span) -> CHandleOut
    val absent = compare(l, CmpEq, answer, NullAddress)
    if !h.optional
        trap_if(l, absent, s"$who null", at)
        val made = c_new_handle(l, symbol, call, answer, h.class_index)
        return CHandleOut(made, made)
    val slot = machine_slot(l, MRef)
    val none = new_block(l)
    val present = new_block(l)
    val join = new_block(l)
    finish_into(l, Branch(absent, none, present), none)
    store(l, slot, Some(NullAddress))
    finish_into(l, Jump(join), present)
    store(l, slot, Some(c_new_handle(l, symbol, call, answer, h.class_index)))
    finish_into(l, Jump(join), join)
    val object = load(l, slot).unwrap()
    CHandleOut(if pointer_option(l, t) then object else option_object(l, t, object), object)

// The enumerator values of the variants of the enum mirror `d`, in order, as the C unit measured them.
private c_mirror_values(l: *Lowering, d: usize) -> Buf[i64]
    var out: Buf[i64] = buf()
    val e = c_enum_of(l.program.data[d].decl).unwrap()
    for v in l.program.data[d].decl.variants
        out.push(c_value(l, c_value_key(CConstInteger, c_enumerator(e, v))).integer)
    out

// `value` as a constant of the C integer crossing as `s`: its low bits, written as the signed number
// they make, so an unsigned type's greatest values are written as negative ones.
private c_integer_constant(value: i64, s: CScalar) -> Operand
    val bits = s match
        CSigned(b) -> b
        CUnsigned(b) -> b
        _ -> 32u32
    if bits >= 64u32 then return ConstInt(64, value.to_string())
    val span = 1i64 << i64(bits)
    var low = value % span
    if low < 0i64 then low = low + span
    if low >= span / 2i64 then low = low - span
    ConstInt(bits, low.to_string())

// The C value of the enum mirror `d`'s value `x`: its variant's enumerator, at the width of `s`.
private c_mirror_argument(l: *Lowering, x: Operand, d: usize, s: CScalar) -> Operand
    val values = c_mirror_values(l, d)
    var result = c_integer_constant(values[0], s)
    if values.len() == 1 then return result
    val tag = variant_tag(l, x)
    for v in 1..<values.len()
        val dest = fresh(l, c_machine(s))
        l.insts.push(Select(dest, compare(l, CmpEq, tag, ConstInt(64, v.to_string())), c_integer_constant(values[v], s), result))
        result = Value(dest)
    result

// The variant of the enum mirror `d` holding the C value `x`, crossing as `s`: the first one whose
// enumerator has that value. A value no variant holds stops the program, `who` saying what answered.
private c_mirror_answer(l: *Lowering, x: Operand, d: usize, s: CScalar, who: string, at: Span) -> Operand
    val values = c_mirror_values(l, d)
    val t: &Type = Data(d, l.program.data[d].name, buf())
    val slot = machine_slot(l, MRef)
    val join = new_block(l)
    for v in 0..<values.len()
        val yes = new_block(l)
        val next = new_block(l)
        finish_into(l, Branch(compare(l, CmpEq, x, c_integer_constant(values[v], s)), yes, next), yes)
        store(l, slot, Some(variant_object(l, t, l.program.data[d].decl.variants[v].name, None)))
        finish_into(l, Jump(join), next)
    val site = trap_site(l, s"$who a value no variant of `${l.program.data[d].name}` holds", at)
    finish_into(l, trap_terminator(l, site), join)
    load(l, slot).unwrap()

// The size of a C handle's object, and the offsets of its owner, the C references it holds and the
// Avin objects it keeps (see `layout`).
private const CHandleSize: usize = 48
private const CHandleOwner: usize = 8
private const CHandleKept: usize = 24
private const CHandleLent: usize = 32
private const CHandleAttach: usize = 40

// The layout of a view or a block, the runtime's `CMemory`.
private const CMemorySize: usize = 56
private const CMemoryOwner: usize = 8
private const CMemoryLength: usize = 16
private const CMemoryClosed: usize = 24
private const CMemoryClosedReason: usize = 32
private const CMemoryForeignReason: usize = 40
private const CMemoryLender: usize = 48

/** What a C binding's call was passed: what answers, as a trap on a null answer says it ("`symbol`
 * answered"), the arguments, a handle's as its own C pointer, and for each parameter that is a
 * handle its object, perhaps null for `None`, its class and whether it is in an `Option`. A method's
 * receiver is the first `skipped` parameters, which its declaration does not list. */
private struct CCall
    symbol: string
    args: Buf[Operand]
    objects: Buf[Option[Operand]]
    classes: Buf[usize]
    optionals: Buf[bool]
    skipped: usize
    /** Whether the call answers a handle, as its result or an out value, which keeps what it keeps. */
    answers: bool
    /** By the Avin parameter's index, the slot holding the record of a function the call passes C,
     * which a handle keeping it takes, leaving null. */
    records: Buf[Option[Place]]

// The C handle class whose built-in `close()` `symbol` is.
private c_close_class(l: *Lowering, symbol: FunctionSymbol) -> Option[usize]
    val k = symbol.owner_class?
    if c_handle_type(l.program.classes[k].decl) is None || !is_handle_release(symbol.decl) then return None
    Some(k)

// `close()` of a C handle gives its object back through the class's `release`, and then the C
// references it holds, and lets go of the Avin objects it keeps; a handle already closed holds
// nothing to give back. Only the code that owns the handle may close it, unless it is `shared`.
private c_close_body(l: *Lowering, symbol: FunctionSymbol, k: usize)
    val outer = l.library
    l.library = true
    val object = Value(l.param_values[0].unwrap())
    if !c_class_shared(l.program.classes[k].decl) then check_owner(l, object, k, symbol.decl.name_span)
    c_close_lent(l, object)
    c_glue_call(l, s"avin_c_give_back_$k", [object])
    l.insts.push(Store(field_address(l, object, FieldSlot(CHandleKept, MRef)), NullAddress))
    l.library = outer
    finish(l, Return(None))

// Calls the C unit's glue function `name`, which takes pointers and answers nothing.
private c_glue_call(l: *Lowering, name: string, args: []Operand)
    var params: Buf[CScalar] = buf()
    var passed: Buf[Operand] = buf()
    for a in args
        params.push(CAddress)
        passed.push(a)
    l.insts.push(Call(None, CFunction(name, params, None), passed))

// The C pointer of the handle `object` of class `k`, passed to C: the object must belong to the code
// running, unless the class is `shared`, and must not be closed. An `optional` handle may be null,
// which is passed as it is.
private c_handle_pointer(l: *Lowering, object: Operand, k: usize, optional: bool, at: Span) -> Operand
    if !optional then return c_checked_pointer(l, object, k, at)
    val slot = machine_slot(l, MPtr)
    val absent = new_block(l)
    val present = new_block(l)
    val join = new_block(l)
    finish_into(l, Branch(compare(l, CmpEq, object, NullAddress), absent, present), absent)
    store(l, slot, Some(NullAddress))
    finish_into(l, Jump(join), present)
    store(l, slot, Some(c_checked_pointer(l, object, k, at)))
    finish_into(l, Jump(join), join)
    load(l, slot).unwrap()

private c_checked_pointer(l: *Lowering, object: Operand, k: usize, at: Span) -> Operand
    if !c_class_shared(l.program.classes[k].decl) then check_owner(l, object, k, at)
    val word = load_field(l, object, FieldSlot(0, MPtr))
    trap_if(l, compare(l, CmpEq, word, NullAddress), s"`${trap_name(l, k)}` is closed", at)
    word

// The C pointer of a handle of class `k` as the prototype's parameter written `text` takes it: its own
// pointer where that names the class's own type, and otherwise the one its `as:` conversion to that
// type makes, which the C unit's glue answers, null for null.
private c_converted(l: *Lowering, pointer: Operand, k: usize, text: string) -> Operand
    val d = l.program.classes[k].decl
    val own = c_handle_type(d) match
        Some(t) -> parse_c_type(t) match
            Ok(t) -> t.text
            Err(_) -> return pointer
        None -> return pointer
    if c_names_handle(text, own, false) then return pointer
    val j = c_as_position(d, text) match
        Some(j) -> j
        None -> return pointer
    var params: Buf[CScalar] = buf()
    params.push(CAddress)
    var args: Buf[Operand] = buf()
    args.push(pointer)
    val dest = fresh(l, MPtr)
    l.insts.push(Call(Some(dest), CFunction(s"avin_c_as_${k}_$j", params, Some(CAddress)), args))
    Value(dest)

// A field accessor's body reads or writes its field through the C unit's glue, after the receiver's
// owner and closed checks, as any method's. Each index is passed as a `long long` and checked against
// its bound, which the glue answers, before C reads anything: the program stops unless
// `0 <= index < bound`. A field read is converted as a result of its C type is, a string copied and
// checked, a null one `None` or a stop, and a handle lent, taking a reference of its own; a value
// written is converted as an argument, at the field's own width.
private c_field_body(l: *Lowering, symbol: FunctionSymbol, n: usize, field: CField)
    val outer = l.library
    l.library = true
    val at = symbol.decl.name_span
    val k = symbol.owner_class.unwrap()
    val object = Value(l.param_values[0].unwrap())
    val pointer = c_checked_pointer(l, object, k, at)
    // Reading or writing a field is a use of the handle, which closes the view it lent last.
    c_close_lent(l, object)
    val result_type = concrete(l, symbol.result.unwrap_or(Unit))
    val writer = *result_type is Unit
    val last = if writer then symbol.params.len() - 1 else symbol.params.len()
    var indices: Buf[Operand] = buf()
    for i in 1..<last
        val t = concrete(l, symbol.params[i])
        indices.push(c_argument(l, Value(l.param_values[i].unwrap()), t, CSigned(64), "i64 (long long)", at))
    for b in 0..<field.bounds.len()
        if b >= indices.len() then break
        val bound = fresh(l, MInt(64))
        l.insts.push(Call(Some(bound), CFunction(c_field_glue(n, "bound" + b.to_string()), c_field_params(indices.len()), Some(CSigned(64))), c_field_args(pointer, indices)))
        val reason = s"index `${c_parameter_name(symbol.decl, b)}` of `${symbol.name}` out of range"
        trap_if(l, compare(l, CmpLt, indices[b], ConstInt(64, "0")), reason, at)
        trap_if(l, compare(l, CmpGe, indices[b], Value(bound)), reason, at)
    val field_type = CTypedef(c_field_type_name(n))
    if writer
        val t = concrete(l, symbol.params[last])
        // A struct mirror is written whole: laid out as C's struct in memory of its own, which the
        // glue assigns to the field, then freed. A mirror holding a string is never written.
        if c_struct_of(t, l.program.data) is Some(d)
            val memory = c_struct_memory(l, ConstInt(64, c_struct_size(l, d).to_string()))
            var copies: Buf[Operand] = buf()
            c_struct_write(l, symbol, d, Value(l.param_values[last].unwrap()), memory, 0, &copies, at)
            var params = c_field_params(indices.len())
            params.push(CAddress)
            var args = c_field_args(pointer, indices)
            args.push(memory)
            l.insts.push(Call(None, CFunction(c_field_glue(n, "set"), params, None), args))
            c_free_struct_memory(l, memory)
            l.library = outer
            finish(l, Return(None))
            return
        // An enum mirror is written as its enumerator's value, which the field's type holds.
        val mirror = c_mirror_of(t, l.program.data)
        val s = c_scalar_of(field_type, if mirror is Some(_) then Int(64) else t, l.program.c_measures)
        var params = c_field_params(indices.len())
        params.push(s)
        var args = c_field_args(pointer, indices)
        val written = mirror match
            Some(d) -> c_mirror_argument(l, Value(l.param_values[last].unwrap()), d, s)
            None -> c_argument(l, Value(l.param_values[last].unwrap()), t, s, c_integer_name(field_type, s).replace_all(c_field_type_name(n), s"the field `${field.expr}`"), at)
        args.push(written)
        l.insts.push(Call(None, CFunction(c_field_glue(n, "set"), params, None), args))
        l.library = outer
        finish(l, Return(None))
        return
    val get = c_field_glue(n, "get")
    val who = s"the field `${field.expr}` of `${trap_name(l, k)}` holds"
    // A field lent as a view: the memory it points at, its length the glue's, lent by the handle.
    if c_memory_form(result_type, l.program.data, l.program.classes) is Some(m)
        val answer = fresh(l, MPtr)
        l.insts.push(Call(Some(answer), CFunction(get, c_field_params(indices.len()), Some(CAddress)), c_field_args(pointer, indices)))
        val length = fresh(l, MInt(64))
        l.insts.push(Call(Some(length), CFunction(c_field_glue(n, "length"), c_field_params(indices.len()), Some(CSigned(64))), c_field_args(pointer, indices)))
        var objects: Buf[Option[Operand]] = buf()
        objects.push(Some(object))
        var classes: Buf[usize] = buf()
        classes.push(k)
        val call = CCall(who, buf(), objects, classes, buf(), 1, false, buf())
        val value = c_view_answer(l, call, result_type, m, Value(answer), Value(length), who, at)
        l.library = outer
        finish(l, Return(Some(value)))
        return
    // A struct mirror is read whole: the glue copies the field into memory of its own, read into a
    // new value of the mirror, then freed.
    if c_struct_of(result_type, l.program.data) is Some(d)
        val memory = c_struct_memory(l, ConstInt(64, c_struct_size(l, d).to_string()))
        var params = c_field_params(indices.len())
        params.push(CAddress)
        var args = c_field_args(pointer, indices)
        args.push(memory)
        l.insts.push(Call(None, CFunction(get, params, None), args))
        val value = c_struct_read(l, d, memory, s"read from the field `${field.expr}` of `${trap_name(l, k)}`", at)
        c_free_struct_memory(l, memory)
        l.library = outer
        finish(l, Return(Some(value)))
        return
    val form = c_text_form(result_type, l.program.data, l.program.classes)
    if !(form is NoText)
        val answer = fresh(l, MPtr)
        l.insts.push(Call(Some(answer), CFunction(get, c_field_params(indices.len()), Some(CAddress)), c_field_args(pointer, indices)))
        val value = c_text_answer(l, Value(answer), result_type, form, None, who, at)
        l.library = outer
        finish(l, Return(value))
        return
    if c_handle_form(result_type, l.program.data, l.program.classes) is Some(h)
        val answer = fresh(l, MPtr)
        l.insts.push(Call(Some(answer), CFunction(get, c_field_params(indices.len()), Some(CAddress)), c_field_args(pointer, indices)))
        val call = CCall(who, buf(), buf(), buf(), buf(), symbol.params.len() - symbol.decl.params.len(), true, buf())
        val value = c_handle_answer(l, symbol, call, Value(answer), result_type, h, at)
        l.library = outer
        finish(l, Return(Some(value)))
        return
    // An enum mirror is read as the integer its field is, a value no variant holds stopping the program.
    val mirror = c_mirror_of(result_type, l.program.data)
    val s = c_scalar_of(field_type, if mirror is Some(_) then Int(64) else result_type, l.program.c_measures)
    val answer = fresh(l, c_machine(s))
    l.insts.push(Call(Some(answer), CFunction(get, c_field_params(indices.len()), Some(s)), c_field_args(pointer, indices)))
    val value = mirror match
        Some(d) -> c_mirror_answer(l, Value(answer), d, s, s"the field `${field.expr}` of `${trap_name(l, k)}` held", at)
        None -> c_answer(l, Value(answer), s, result_type, at)
    l.library = outer
    finish(l, Return(Some(value)))

// The parameters of a field accessor's glue with `count` indices: the handle's pointer, then each
// index as a `long long`.
private c_field_params(count: usize) -> Buf[CScalar]
    var out: Buf[CScalar] = buf()
    out.push(CAddress)
    for _ in 0..<count
        out.push(CSigned(64))
    out

private c_field_args(pointer: Operand, indices: Buf[Operand]) -> Buf[Operand]
    var out: Buf[Operand] = buf()
    out.push(pointer)
    for x in indices
        out.push(x)
    out

// The value `result_type` makes of the handle pointer C answered at `answer`: null is `None`, or
// stops the program where the result is no `Option`; any other pointer is a new object of the
// class, holding the pointer, owned by the code running, after a reference of its own is taken where
// the binding says `borrowed`. What the call keeps, the new handle keeps.
private c_handle_answer(l: *Lowering, symbol: FunctionSymbol, call: CCall, answer: Operand, result_type: &Type, h: CHandleForm, at: Span) -> Operand
    val absent = compare(l, CmpEq, answer, NullAddress)
    if !h.optional
        trap_if(l, absent, s"${call.symbol} null", at)
        val made = c_new_handle(l, symbol, call, answer, h.class_index)
        c_after_call(l, symbol, call, Some(made), None)
        return made
    val slot = machine_slot(l, MRef)
    val none = new_block(l)
    val present = new_block(l)
    val join = new_block(l)
    finish_into(l, Branch(absent, none, present), none)
    // Nothing was made, so nothing is kept; what the call takes, it takes whatever it answers.
    c_after_call(l, symbol, call, None, None)
    store(l, slot, Some(NullAddress))
    finish_into(l, Jump(join), present)
    val made = c_new_handle(l, symbol, call, answer, h.class_index)
    c_after_call(l, symbol, call, Some(made), None)
    store(l, slot, Some(made))
    finish_into(l, Jump(join), join)
    val value = load(l, slot).unwrap()
    if pointer_option(l, result_type) then value else option_object(l, result_type, value)

// A new handle object of class `k` holding `pointer`, owned by the code running; a `borrowed`
// pointer has a reference of its own taken first, through the class's `retain`, which is given the
// pointer of the handle of the class's `kept:` the call keeps, for its name.
private c_new_handle(l: *Lowering, symbol: FunctionSymbol, call: CCall, pointer: Operand, k: usize) -> Operand
    // A handle read from a field is always lent.
    if c_binding_flag(symbol.decl, "borrowed") || c_field_of(symbol.decl) is Some(_)
        var kept: Operand = NullAddress
        if c_kept_class(l.program.classes, k) is Some(wanted)
            for name in c_binding_names(symbol.decl, "keeps")
                val i = c_named_parameter(symbol, call, name) match
                    Some(i) -> i
                    None -> continue
                if call.objects[i] is Some(_) && call.classes[i] == wanted then kept = call.args[i]
        c_glue_call(l, s"avin_c_retain_$k", [pointer, kept])
    c_handle_object(l, pointer, k)

// A new handle object of class `k` holding `pointer`, owned by the code running.
private c_handle_object(l: *Lowering, pointer: Operand, k: usize) -> Operand
    val t: &Type = Class(k, l.program.classes[k].name, buf())
    val shape = layout(l, t).variants[0]
    val object = fresh(l, MRef)
    l.insts.push(Alloc(object, shape.descriptor))
    l.insts.push(Store(field_address(l, Value(object), FieldSlot(0, MPtr)), pointer))
    val mine = fresh(l, MInt(64))
    l.insts.push(Load(mine, OwnerWord))
    l.insts.push(Store(field_address(l, Value(object), FieldSlot(CHandleOwner, MInt(64))), Value(mine)))
    l.insts.push(Publish)
    Value(object)

// The parameter of the call `keeps:` or `consumes:` names `name`: `self`, the receiver, or one of
// the declared parameters, by its position among the call's.
private c_named_parameter(symbol: FunctionSymbol, call: CCall, name: string) -> Option[usize]
    if name == "self" then return if call.skipped > 0 then Some(0) else None
    for i in 0..<symbol.decl.params.len()
        if symbol.decl.params[i].pattern.kind is Name(n) && n == name then return Some(i + call.skipped)
    None

// What a call does once it has returned with what it keeps and takes: each handle `keeps:` names is
// kept by `made`, the handle the call answered, or where it answered none by the receiver; each
// handle `consumes:` names is closed without its `release`, C having taken its reference. Where
// `succeeded` is given, nothing is kept unless it is true.
private c_after_call(l: *Lowering, symbol: FunctionSymbol, call: CCall, made: Option[Operand], succeeded: Option[Operand])
    var after: Option[usize] = None
    if succeeded is Some(flag)
        val yes = new_block(l)
        val join = new_block(l)
        finish_into(l, Branch(flag, yes, join), yes)
        after = Some(join)
    c_keeps(l, symbol, call, made, false, None)
    if after is Some(join) then finish_into(l, Jump(join), join)
    c_consumes(l, symbol, call)

// Each handle `keeps:` names is kept by `made`, the handle the call answered, which is null for
// `None` where it is `optional`, and keeps nothing then; where the call answers no handle, by the
// receiver.
private c_keeps(l: *Lowering, symbol: FunctionSymbol, call: CCall, made: Option[Operand], optional: bool, fail: Option[CAttachFail])
    val keeps = c_binding_names(symbol.decl, "keeps")
    if keeps.len() == 0 then return
    var holder: Option[Operand] = made
    if holder is None && call.skipped > 0 && !call.answers then holder = call.objects[0]
    val o = holder match
        Some(o) -> o
        None -> return
    // The holder's class; where it says `attach:`, what it keeps is held as Avin objects, on the list
    // its record in the runtime keeps for as long as C holds the C object.
    val holder_class = if made is Some(_) then c_first_handle_class(l, concrete(l, symbol.result.unwrap_or(Unit))) else symbol.owner_class
    var attached: Option[usize] = None
    if holder_class is Some(hk)
        if c_class_text(l.program.classes[hk].decl, "attach") is Some(_) then attached = Some(hk)
    val join = c_if_present(l, o, optional && made is Some(_))
    var kept_objects = false
    for name in keeps
        val i = c_named_parameter(symbol, call, name) match
            Some(i) -> i
            None -> continue
        // A function C keeps is held by the handle, its record given back with the handle's object.
        if i < call.records.len() && call.records[i] is Some(_)
            c_glue_call(l, "avin_c_keep_callback", [o, load(l, call.records[i]).unwrap()])
            store(l, call.records[i], Some(NullAddress))
            continue
        val kept = call.objects[i] match
            Some(k) -> k
            None -> continue
        if attached is Some(_)
            val present = c_if_present(l, kept, call.optionals[i])
            c_keep_object(l, o, kept)
            c_end_present(l, present)
            kept_objects = true
        else c_keep(l, o, kept, call.args[i], call.classes[i], call.optionals[i])
    if attached is Some(hk)
        if kept_objects then c_attach(l, o, hk, symbol.name, symbol.decl.name_span, fail)
    c_end_present(l, join)

/** Where an `attach:` answering non-zero goes for a binding answering its handle in a `Result`: the
 * slot its answer is written into, and the block that answers the error. */
private struct CAttachFail
    code: usize
    block: usize

// The first C handle class the Avin type `t` answers, itself or inside an `Option`, a `Result`'s `Ok`
// or a tuple.
private c_first_handle_class(l: *Lowering, t: &Type) -> Option[usize]
    if c_handle_form(t, l.program.data, l.program.classes) is Some(h) then return Some(h.class_index)
    *t match
        Data(_, _, args) ->
            if args.len() > 0 then return c_first_handle_class(l, args[0])
            None
        Tuple(items) ->
            for item in items
                if c_first_handle_class(l, item) is Some(k) then return Some(k)
            None
        _ -> None

// Ties what the handle `holder`, of class `k` with `attach:`, keeps to its C object: at its first
// keep, a record is made in the runtime and given to C through the class's glue, which stops the
// program at the call of `binding` where C answers non-zero, or, given `fail`, writes the answer into
// its slot and goes to its block; the record then keeps the holder's list of the Avin objects it
// keeps, for as long as C holds it.
private c_attach(l: *Lowering, holder: Operand, k: usize, binding: string, at: Span, fail: Option[CAttachFail])
    val word = field_address(l, holder, FieldSlot(CHandleAttach, MInt(64)))
    val known = fresh(l, MInt(64))
    l.insts.push(Load(known, word))
    val record = machine_slot(l, MInt(64))
    store(l, record, Some(Value(known)))
    val make = new_block(l)
    val join = new_block(l)
    finish_into(l, Branch(compare(l, CmpEq, Value(known), ConstInt(64, "0")), make, join), make)
    val fresh_record = fresh(l, MInt(64))
    l.insts.push(Call(Some(fresh_record), Runtime("avin_rt_c_attach_new", MirSignature(buf(), Some(MInt(64)))), buf()))
    val made = Value(fresh_record)
    var params: Buf[CScalar] = buf()
    params.push(CAddress)
    params.push(CSigned(64))
    var args: Buf[Operand] = buf()
    args.push(load_field(l, holder, FieldSlot(0, MPtr)))
    args.push(made)
    val answer = fresh(l, MInt(64))
    l.insts.push(Call(Some(answer), CFunction(s"avin_c_attach_$k", params, Some(CSigned(64))), args))
    val failed = new_block(l)
    val attached = new_block(l)
    finish_into(l, Branch(compare(l, CmpNe, Value(answer), ConstInt(64, "0")), failed, attached), failed)
    var undo: Buf[MirType] = buf()
    undo.push(MInt(64))
    var undone: Buf[Operand] = buf()
    undone.push(made)
    l.insts.push(Call(None, Runtime("avin_rt_c_attach_failed", MirSignature(undo, None)), undone))
    fail match
        Some(f) ->
            l.insts.push(Store(SlotAddress(f.code), Value(answer)))
            finish_into(l, Jump(f.block), attached)
        None ->
            val site = trap_site(l, s"`attach:` of `${trap_name(l, k)}` answered non-zero, so what `$binding` keeps cannot be kept", at)
            finish_into(l, trap_terminator(l, site), attached)
    l.insts.push(Store(field_address(l, holder, FieldSlot(CHandleAttach, MInt(64))), made))
    store(l, record, Some(made))
    finish_into(l, Jump(join), join)
    val list = fresh(l, MRef)
    l.insts.push(Load(list, field_address(l, holder, FieldSlot(CHandleKept, MRef))))
    var types: Buf[MirType] = buf()
    types.push(MInt(64))
    types.push(MRef)
    var values: Buf[Operand] = buf()
    values.push(load(l, record).unwrap())
    values.push(Value(list))
    l.insts.push(Call(None, Runtime("avin_rt_c_attach_set", MirSignature(types, None)), values))

// Frees the record of each function the call passed C that no handle keeps, once the call has
// returned: C calls it no more.
private c_free_records(l: *Lowering, slots: Buf[Option[Place]])
    for slot in slots
        if slot is None then continue
        var args: Buf[Operand] = buf()
        args.push(load(l, slot).unwrap())
        l.insts.push(Call(None, Runtime("avin_rt_c_callback_free", MirSignature(single(MPtr), None)), args))

/** What the function a trampoline runs converts for: the binding's name, the unit and span that
 * place it, the prototype of the function C calls, the Avin function's type, and the trampoline's
 * index. */
private struct CCallbackPlan
    name: string
    unit: usize
    at: Span
    f: CPrototype
    ty: &Type
    trampoline: usize

// The trampoline C calls the function the binding `symbol` passes for its parameter `q` through, of
// Avin type `t`, and the function it runs, made to be lowered with the program's others. The
// trampoline's parameters are filled in when that function is.
private c_trampoline(l: *Lowering, symbol: FunctionSymbol, q: CParam, t: &Type) -> usize
    val index = l.trampolines.len()
    val k = l.instances.len()
    val binding = l.instances[l.function_index]
    val owner = function_symbol(l, binding.function, binding.type_args) + " callback"
    val place = l.place_counts.get(owner).unwrap_or(0) + 1
    l.place_counts.put(owner, place)
    l.instances.push(Instance(0, buf(), false, CCallbackBody))
    l.trampolines.push(MirTrampoline(s"$owner#$place", k, buf(), 0, None))
    l.c_callbacks.put(k, CCallbackPlan(symbol.name, symbol.unit, symbol.decl.name_span, q.callback[0], t, index))
    index

// How a value of the Avin type `t` crosses a callback's C type `c`: a handle or a string as a
// pointer, an enum mirror as the integer it is, and a scalar at the width the C unit measured.
private c_callback_scalar(l: *Lowering, c: CType, t: &Type) -> CScalar
    if c_handle_form(t, l.program.data, l.program.classes) is Some(_) then return CAddress
    if c_memory_form(t, l.program.data, l.program.classes) is Some(_) then return CAddress
    if !(c_text_form(t, l.program.data, l.program.classes) is NoText) then return CAddress
    if c_mirror_of(t, l.program.data) is Some(_) then return c_scalar_of(c, Int(64), l.program.c_measures)
    c_scalar_of(c, t, l.program.c_measures)

// The function a trampoline runs, the `k`th instance: with the thread's context, it takes the
// callback's record and what C called it with but for the `userdata`, each converted as a binding's
// result is, a handle lent through its class's `retain`, a string copied; runs the Avin function the
// record holds; and converts its answer as a binding's argument is. A value no Avin type can hold
// stops the program where the binding C is running in was called.
private c_callback_body(l: *Lowering, k: usize) -> MirFunction
    val plan = l.c_callbacks.get(k).unwrap()
    l.unit = plan.unit
    l.here = plan.at
    val at = plan.at
    val (ps, r) = *plan.ty match
        Function(ps, r, _) -> (ps, r)
        _ -> panic("a callback whose type is no function")
    val positions = c_callback_positions(plan.f)
    var params: Buf[MirType] = buf()
    params.push(MPtr)
    val record = fresh(l, MPtr)
    // Every parameter C passes but the `userdata` is one of the function's, in C's order: each the
    // Avin function takes, and each length of a view, which only makes the view.
    var scalars: Buf[CScalar] = buf()
    var values: Buf[usize] = buf()
    for i in 0..<plan.f.params.len()
        val q = plan.f.params[i]
        if q.userdata
            scalars.push(CAddress)
            values.push(0)
            continue
        var s = CAddress
        if q.length_of != "" then s = c_scalar_of(q.ty, Int(64), l.program.c_measures)
        else
            for j in 0..<positions.len()
                if positions[j] == i then s = c_callback_scalar(l, q.ty, ps[j])
        scalars.push(s)
        params.push(c_machine(s))
        values.push(fresh(l, c_machine(s)))
    val who = s"the function given to `${plan.name}` was called by C with"
    var lent: Buf[Option[Place]] = buf()
    val closure = runtime_call(l, "avin_rt_c_callback_object", [MPtr], MRef, [Value(record)])
    var operands: Buf[Operand] = buf()
    operands.push(closure)
    var types: Buf[MirType] = buf()
    types.push(MRef)
    for j in 0..<positions.len()
        val q = plan.f.params[positions[j]]
        val t = ps[j]
        val x = Value(values[positions[j]])
        val s = scalars[positions[j]]
        val form = c_text_form(t, l.program.data, l.program.classes)
        var v: Option[Operand] = None
        if c_memory_form(t, l.program.data, l.program.classes) is Some(m)
            // Memory C lends for the call, a view closed when the function returns.
            val li = c_length_param(plan.f, q.name).unwrap()
            val length = c_answer(l, Value(values[li]), scalars[li], Int(64), at)
            val name = l.program.classes[m.class_index].name
            val lender = CViewLender(None, s"the `$name` lent to the function given to `${plan.name}` was closed when it returned", s"the `$name` lent to the function given to `${plan.name}` belongs to another thread")
            val raw = machine_slot(l, MRef)
            lent.push(raw)
            v = Some(c_view_lent(l, lender, t, m, x, length, s"C lent the function given to `${plan.name}`", at, raw))
        elif c_handle_form(t, l.program.data, l.program.classes) is Some(h) then v = Some(c_lent_handle(l, x, t, h, who, at))
        elif !(form is NoText) then v = c_text_answer(l, x, t, form, None, who, at)
        elif c_mirror_of(t, l.program.data) is Some(d) then v = Some(c_mirror_answer(l, x, d, s, who, at))
        else v = Some(c_answer(l, x, s, t, at))
        if machine(l, t) is Some(m)
            operands.push(v.unwrap())
            types.push(m)
    val answer = machine(l, r)
    val code = fresh(l, MPtr)
    l.insts.push(CallEntry(code, closure))
    val dest = answer match
        Some(m) -> Some(fresh(l, m))
        None -> None
    push_call(l, dest, Indirect(Value(code), MirSignature(types, answer)), operands)
    // The memory was lent for the call, so each view is closed once the function returns.
    for raw in lent
        c_close_view(l, load(l, raw).unwrap())
    var result: Option[CScalar] = None
    var answered: Option[Operand] = None
    if !(plan.f.result is CVoidType)
        if c_mirror_of(r, l.program.data) is Some(d)
            val s = c_scalar_of(plan.f.result, Int(64), l.program.c_measures)
            result = Some(s)
            answered = Some(c_mirror_argument(l, Value(dest.unwrap()), d, s))
        else
            val s = c_scalar_of(plan.f.result, r, l.program.c_measures)
            result = Some(s)
            answered = Some(c_argument(l, Value(dest.unwrap()), r, s, s"${c_integer_name(plan.f.result, s)}, what the function given to `${plan.name}` answered", at))
    finish(l, Return(answered))
    // The trampoline takes every parameter C passes, the `userdata` among them.
    var userdata = 0usize
    for i in 0..<plan.f.params.len()
        if plan.f.params[i].userdata then userdata = i
    val all = scalars
    val trampoline_name = l.trampolines[plan.trampoline].name
    l.trampolines[plan.trampoline] = MirTrampoline(trampoline_name, k, all, userdata, result)
    MirFunction(s"avin.c.callback.$trampoline_name", MirSignature(params, result match
        Some(s) -> Some(c_machine(s))
        None -> None), l.values, l.slots, l.blocks)

// A handle C lends a callback, the pointer `x`: null is `None`, or stops the program where `t` is no
// `Option`; any other is a new handle object of its own reference, taken through its class's `retain`.
private c_lent_handle(l: *Lowering, x: Operand, t: &Type, h: CHandleForm, who: string, at: Span) -> Operand
    val absent = compare(l, CmpEq, x, NullAddress)
    if !h.optional
        trap_if(l, absent, s"$who null", at)
        c_glue_call(l, s"avin_c_retain_${h.class_index}", [x, NullAddress])
        return c_handle_object(l, x, h.class_index)
    val slot = machine_slot(l, MRef)
    val none = new_block(l)
    val present = new_block(l)
    val join = new_block(l)
    finish_into(l, Branch(absent, none, present), none)
    store(l, slot, Some(NullAddress))
    finish_into(l, Jump(join), present)
    c_glue_call(l, s"avin_c_retain_${h.class_index}", [x, NullAddress])
    store(l, slot, Some(c_handle_object(l, x, h.class_index)))
    finish_into(l, Jump(join), join)
    val object = load(l, slot).unwrap()
    if pointer_option(l, t) then object else option_object(l, t, object)

// Each handle `consumes:` names is closed without its `release`, C having taken its reference.
private c_consumes(l: *Lowering, symbol: FunctionSymbol, call: CCall)
    for name in c_binding_names(symbol.decl, "consumes")
        val i = c_named_parameter(symbol, call, name) match
            Some(i) -> i
            None -> continue
        val taken = call.objects[i] match
            Some(t) -> t
            None -> continue
        val join = c_if_present(l, taken, call.optionals[i])
        l.insts.push(Store(field_address(l, taken, FieldSlot(0, MPtr)), NullAddress))
        c_end_present(l, join)

// Makes `holder` keep the handle `kept`, of class `k`, whose C pointer is `pointer`: by a C reference
// of its own where the class declares `retain` and no `kept:`, given back after the holder's own, with
// one to each C object `kept` so holds; and otherwise as the Avin object, on the list of what the
// holder keeps, which the collector traces.
private c_keep(l: *Lowering, holder: Operand, kept: Operand, pointer: Operand, k: usize, optional: bool)
    val d = l.program.classes[k].decl
    val join = c_if_present(l, kept, optional)
    if c_class_text(d, "retain") is Some(_) && c_class_kept(d) is None then c_glue_call(l, s"avin_c_keep_$k", [holder, pointer, kept])
    else c_keep_object(l, holder, kept)
    c_end_present(l, join)

// Puts `kept` at the head of the list of the Avin objects `holder` keeps: a pair of it and the rest.
private c_keep_object(l: *Lowering, holder: Operand, kept: Operand)
    var items: Buf[&Type] = buf()
    items.push(AnyType)
    items.push(AnyType)
    val pair: &Type = Tuple(items)
    val shape = layout(l, pair).variants[0]
    val list = field_address(l, holder, FieldSlot(CHandleKept, MRef))
    val rest = fresh(l, MRef)
    l.insts.push(Load(rest, list))
    val cell = fresh(l, MRef)
    l.insts.push(Alloc(cell, shape.descriptor))
    l.insts.push(Store(field_address(l, Value(cell), shape.fields[0].unwrap()), kept))
    l.insts.push(Store(field_address(l, Value(cell), shape.fields[1].unwrap()), Value(rest)))
    l.insts.push(Publish)
    l.insts.push(Store(field_address(l, holder, FieldSlot(CHandleKept, MRef)), Value(cell)))

// Starts code that runs only where `object` is not null, which only an `optional` handle may be: the
// block after it, which `c_end_present` ends it with, or none where it always runs.
private c_if_present(l: *Lowering, object: Operand, optional: bool) -> Option[usize]
    if !optional then return None
    val present = new_block(l)
    val join = new_block(l)
    finish_into(l, Branch(compare(l, CmpEq, object, NullAddress), join, present), present)
    Some(join)

private c_end_present(l: *Lowering, join: Option[usize])
    if join is Some(j) then finish_into(l, Jump(j), j)

// A value of the data type `t`, of its variant `name`, holding `value` where the variant has a field:
// its one constant object where it holds nothing.
private variant_object(l: *Lowering, t: &Type, name: string, value: Option[Operand]) -> Operand
    val id = *t match
        Data(d, _, _) -> d
        _ -> panic("a variant of a type that is not data")
    var v = 0usize
    for i in 0..<l.program.data[id].variants.len()
        if l.program.data[id].variants[i].name == name then v = i
    val shape = layout(l, t).variants[v]
    if l.descriptors[shape.descriptor].constant then return ConstObject(shape.descriptor)
    val object = fresh(l, MRef)
    l.insts.push(Alloc(object, shape.descriptor))
    if value is Some(x)
        if shape.fields.len() > 0
            if shape.fields[0] is Some(field) then l.insts.push(Store(field_address(l, Value(object), field), x))
    l.insts.push(Publish)
    Value(object)

// The name of a binding's parameter `i` as a trap names it: the name it was declared with, or its
// position where it was declared with a pattern.
private c_parameter_name(f: &Function, i: usize) -> string = f.params[i].pattern.kind match
    Name(n) -> n
    _ -> s"parameter ${i + 1}"

// Frees the copies a call's string arguments were made into, once the call has returned.
private c_release_copies(l: *Lowering, copies: Buf[Operand])
    for c in copies
        var types: Buf[MirType] = buf()
        types.push(MPtr)
        var args: Buf[Operand] = buf()
        args.push(c)
        l.insts.push(Call(None, Runtime("avin_rt_c_string_free", MirSignature(types, None)), args))

// Calls the C function `free` on the string C answered at `answer`.
private c_free_answer(l: *Lowering, free: string, answer: Operand)
    var params: Buf[CScalar] = buf()
    params.push(CAddress)
    var args: Buf[Operand] = buf()
    args.push(answer)
    l.insts.push(Call(None, CFunction(free, params, None), args))

// What C answered as a string, at `answer`, as the Avin type `t` carrying it in `form`: copied
// into a new string checked as UTF-8, or into a new `Array[byte]`, and then freed by `free` where
// the binding names one. Null is `None` for an `Option`, and stops the program otherwise. A binding
// whose result is `unit` frees what C answered and answers nothing.
private c_text_answer(l: *Lowering, answer: Operand, t: &Type, form: CTextForm, free: Option[string], who: string, at: Span) -> Option[Operand]
    val optional = form match
        TextString(o) -> o
        TextBytes(o) -> o
        NoText -> false
    val absent = compare(l, CmpEq, answer, NullAddress)
    if *t is Unit
        val present = new_block(l)
        val join = new_block(l)
        finish_into(l, Branch(absent, join, present), present)
        c_free_answer(l, free.unwrap(), answer)
        finish_into(l, Jump(join), join)
        return None
    if !optional then trap_if(l, absent, s"$who null", at)
    if !optional then return Some(c_text_copy(l, answer, t, form, free, who, at))
    val slot = machine_slot(l, MRef)
    val none = new_block(l)
    val present = new_block(l)
    val join = new_block(l)
    finish_into(l, Branch(absent, none, present), none)
    store(l, slot, Some(NullAddress))
    finish_into(l, Jump(join), present)
    val inner = option_argument(l.options, t).unwrap()
    store(l, slot, Some(c_text_copy(l, answer, inner, form, free, who, at)))
    finish_into(l, Jump(join), join)
    val value = load(l, slot).unwrap()
    if pointer_option(l, t) then return Some(value)
    Some(option_object(l, t, value))

// The copy of the string C answered at `answer`, which is not null, as `t`, a `string` or an
// `Array[byte]`, after which `free` frees it where the binding names one.
private c_text_copy(l: *Lowering, answer: Operand, t: &Type, form: CTextForm, free: Option[string], who: string, at: Span) -> Operand
    var copied: Operand = NullAddress
    if form is TextBytes(_)
        val descriptor = layout(l, t).variants[0].descriptor
        copied = runtime_call(l, "avin_rt_c_bytes_out", [MPtr, MPtr], MRef, [DescriptorAddress(descriptor), answer])
    else
        val site = trap_site(l, s"$who a string that is not UTF-8", at)
        copied = runtime_call(l, "avin_rt_c_string_out", [MPtr, MPtr], MRef, [answer, TrapSiteAddress(site)])
    if free is Some(f) then c_free_answer(l, f, answer)
    copied

// The C constant `name` as a constant of its Avin type `t`, an integer type, `real` or `string`, as
// the C unit measured it; the driver has checked that it fits.
private c_constant(l: *Lowering, t: &Type, name: string) -> Operand = *t match
    Int(bits) -> ConstInt(bits, c_value(l, c_value_key(CConstInteger, name)).integer.to_string())
    Real -> ConstReal(c_value(l, c_value_key(CConstReal, name)).real)
    _ -> string_constant(l, c_value(l, c_value_key(CConstString, name)).text.unwrap_or(""))

private c_value(l: *Lowering, key: string) -> CValue = l.program.c_values.get(key) match
    Some(v) -> v
    None -> panic(s"the C unit measured no `$key`")

// The machine type an operand crossing as `s` has: a `float` is carried as a `real`.
private c_machine(s: CScalar) -> MirType = s match
    CSigned(bits) -> MInt(bits)
    CUnsigned(bits) -> MInt(bits)
    CBoolean -> MBool
    CBinary64 -> MReal
    CBinary32 -> MReal
    CAddress -> MPtr

// An argument of Avin type `t` as the C type crossing as `s`, which `name` names. A signed C type
// narrower than the integer traps where the value does not survive the trip back; an unsigned one
// traps on a negative value, and on one past its greatest where it is narrower.
private c_argument(l: *Lowering, x: Operand, t: &Type, s: CScalar, name: string, at: Span) -> Operand = *t match
    Int(width) -> s match
        CSigned(bits) ->
            if bits >= width then return resize(l, x, width, bits, true)
            val narrow = resize(l, x, width, bits, true)
            val back = resize(l, narrow, bits, width, true)
            trap_if(l, compare(l, CmpNe, back, x), s"value out of range for $name", at)
            narrow
        CUnsigned(bits) ->
            if bits >= width
                trap_if(l, compare(l, CmpLt, x, ConstInt(width, "0")), s"value out of range for $name", at)
                return resize(l, x, width, bits, false)
            // A negative value compares as huge, so one unsigned test covers both ends.
            trap_if(l, compare(l, CmpUgt, x, ConstInt(width, ((1u64 << u64(bits)) - 1u64).to_string())), s"value out of range for $name", at)
            resize(l, x, width, bits, false)
        _ -> x
    // A `bool` passed to an integer used as a truth value is 0 or 1.
    Bool -> s match
        CSigned(bits) -> c_truth(l, x, bits)
        CUnsigned(bits) -> c_truth(l, x, bits)
        _ -> x
    _ -> x

private c_truth(l: *Lowering, x: Operand, bits: u32) -> Operand
    val dest = fresh(l, MInt(bits))
    l.insts.push(Select(dest, x, ConstInt(bits, "1"), ConstInt(bits, "0")))
    Value(dest)

// What C answered, crossing as `s`, as the Avin type `t`: an integer traps where `t` cannot hold it,
// and an integer answered as a `bool` is false for zero and true for every other value.
private c_answer(l: *Lowering, x: Operand, s: CScalar, t: &Type, at: Span) -> Operand = *t match
    Int(width) -> s match
        CSigned(bits) -> narrow_signed(l, x, bits, width, t, at)
        CUnsigned(bits) -> narrow_unsigned(l, x, bits, width, t, at)
        _ -> x
    Bool -> s match
        CSigned(bits) -> compare(l, CmpNe, x, ConstInt(bits, "0"))
        CUnsigned(bits) -> compare(l, CmpNe, x, ConstInt(bits, "0"))
        _ -> x
    _ -> x

// The name the traps of the handle class `k` give it.
private trap_name(l: *Lowering, k: usize) -> string = handle_trap_name(l.program.classes[k].decl, l.program.classes[k].name)

// Stops the program where the handle `h`, of the handle class `k`, does not belong to the code
// running: its owner word, after its counted reference, is compared with the context's, and only
// where they differ does the runtime look further, taking a handle in transit for the running code.
private check_owner(l: *Lowering, h: Operand, k: usize, at: Span)
    val mine = fresh(l, MInt(64))
    l.insts.push(Load(mine, OwnerWord))
    val held = load_field(l, h, FieldSlot(8, MInt(64)))
    val same = compare(l, CmpEq, held, Value(mine))
    val slow = new_block(l)
    val next = new_block(l)
    finish_into(l, Branch(same, next, slow), slow)
    val claimed = runtime_call(l, "avin_rt_handle_claim", [MRef], MBool, [h])
    val site = trap_site(l, s"`${trap_name(l, k)}` belongs to another thread", at)
    val stop = new_block(l)
    l.blocks[stop].term = CallerTrap(site)
    finish_into(l, Branch(claimed, next, stop), next)

// Whether an instance is a Sysl binding: a function bound to a Sysl function, or a method of a Sysl
// handle bound to its Sysl value.
private bound_instance(l: *Lowering, index: usize) -> bool
    val inst = l.instances[index]
    if inst.generated != Written then return false
    val symbol = l.program.symbols[inst.function]
    binding_target(symbol.decl) is Some(_) || handle_of(l, symbol) is Some(_) || c_prototype_text(symbol.decl) is Some(_) || c_field_of(symbol.decl) is Some(_) || c_close_class(l, symbol) is Some(_)

/** The Sysl handle class whose method `symbol` is, where it is one without a body: a method bound to
 * the handle's Sysl value, or its `close()`. */
private handle_of(l: *Lowering, symbol: FunctionSymbol) -> Option[usize]
    val k = symbol.owner_class match
        Some(k) -> k
        None -> return None
    if handle_target(l.program.classes[k].decl) is None || symbol.constructor then return None
    if symbol.decl.body is Some(_) || symbol.decl.clauses.len() > 0 then return None
    Some(k)

// How a shim hands Sysl the function value of type `t` a binding is passed: its parameters'
// conversions out of Sysl, with every layout each takes, then its result's into Sysl, with the
// layouts that conversion reads, which a scalar's, a string's, an array of bytes' and a handle's
// need none of.
private callback_crossing(l: *Lowering, t: &Type, layouts: *Buf[Operand], threaded: bool) -> &Crossing
    val start = layouts.len()
    var params: Buf[&Crossing] = buf()
    var machine_params: Buf[MirType] = buf()
    var result: &Type = Unit
    if *t is Function(ps, r, _)
        for p in ps
            val pt = concrete(l, p)
            params.push(crossing(l, pt, layouts))
            if machine(l, pt) is Some(m) then machine_params.push(m)
        result = concrete(l, r)
    var own: Buf[Operand] = buf()
    val answer = crossing(l, result, &own)
    if !(answer.form is Plain) && !(answer.form is Bytes) && !(answer.form is Handle(_))
        for operand in own
            layouts.push(operand)
    Crossing(t, Callback(params, answer, machine_params, machine(l, result), threaded), buf(), layouts.len() - start)

// How a shim converts a value of boundary type `t`, the checker having held every binding's types
// to those. A data type's or an array's layouts are pushed onto `layouts` in the order the
// conversion numbers them: each variant's descriptor, or its one constant object, then each field's.
private crossing(l: *Lowering, t: &Type, layouts: *Buf[Operand]) -> &Crossing
    *t match
        Class(id, _, args) ->
            // A handle is made by its class's descriptor, whose finalizer gives its Sysl value back.
            if handle_target(l.program.classes[id].decl) is Some(_)
                layouts.push(DescriptorAddress(layout(l, t).variants[0].descriptor))
                return Crossing(t, Handle(handle_finalizer(id, args)), buf(), 1)
            val array = is_array_class(l.program.classes[id])
            if array && *args[0] is Byte
                layouts.push(DescriptorAddress(layout(l, t).variants[0].descriptor))
                return Crossing(t, Bytes, buf(), 1)
            // A vector out of Sysl is made from an array made as an `Array` of its element type is;
            // into Sysl, its elements are read a leaf at a time. The core library's functions that do
            // both follow the array's descriptor.
            val start = layouts.len()
            if array
                layouts.push(DescriptorAddress(layout(l, t).variants[0].descriptor))
            else
                layouts.push(DescriptorAddress(layout(l, array_type(l, args[0])).variants[0].descriptor))
                layouts.push(vector_function(l, "vectorOfArray", args[0]))
                layouts.push(vector_function(l, "vectorLength", args[0]))
                layouts.push(vector_function(l, "vectorLeaf", args[0]))
            val element = crossing(l, args[0], layouts)
            return Crossing(t, Elements(element, !array), buf(), layouts.len() - start)
        Data(id, _, args) ->
            val d = l.program.data[id]
            val shape = layout(l, t)
            val start = layouts.len()
            for v in shape.variants
                layouts.push(if l.descriptors[v.descriptor].constant then ConstObject(v.descriptor) else DescriptorAddress(v.descriptor))
            var variants: Buf[CrossVariant] = buf()
            for v in 0..<d.variants.len()
                val types = variant_fields(d, id, v, args)
                var fields: Buf[CrossField] = buf()
                for k in 0..<types.len()
                    val base = layouts.len() - start
                    val offset: Option[usize] = shape.variants[v].fields[k] match
                        Some(slot) -> Some(slot.offset)
                        None -> None
                    fields.push(CrossField(d.variants[v].field_names[k], offset, crossing(l, types[k], layouts), base))
                variants.push(CrossVariant(d.variants[v].name, l.descriptors[shape.variants[v].descriptor].constant, fields))
            val form = mirror_target(d.decl) match
                Some(target) -> Mirror(d.name, target, d.unit, d.decl.span, d.variants.len() == 1 && d.variants[0].name == d.name)
                None -> if d.name == "Option" then OptionForm(pointer_option(l, t)) else ResultForm
            return Crossing(t, form, variants, layouts.len() - start)
        // A tuple is laid out as a one-variant data value, its parts the variant's fields.
        Tuple(items) ->
            val shape = layout(l, t)
            val start = layouts.len()
            layouts.push(DescriptorAddress(shape.variants[0].descriptor))
            var fields: Buf[CrossField] = buf()
            for k in 0..<items.len()
                val base = layouts.len() - start
                val offset: Option[usize] = shape.variants[0].fields[k] match
                    Some(slot) -> Some(slot.offset)
                    None -> None
                fields.push(CrossField(s"$k", offset, crossing(l, items[k], layouts), base))
            var variants: Buf[CrossVariant] = buf()
            variants.push(CrossVariant("", false, fields))
            return Crossing(t, TupleForm, variants, layouts.len() - start)
        _ -> return Crossing(t, Plain, buf(), 0)

// The address of the core library's function `name` for vectors of `element`, which a shim calls to
// make or to read a vector.
private vector_function(l: *Lowering, name: string, element: &Type) -> Operand = FunctionAddress(library_instance(l, name, element))

/** The instance of the core library's function `name`, which has one type parameter, at `element`. */
private library_instance(l: *Lowering, name: string, element: &Type) -> usize
    for id in 0..<l.program.symbols.len()
        val s = l.program.symbols[id]
        if s.module_name == "avin" && s.name == name && s.owner_class is None && s.receiver is None
            var args: Buf[&Type] = buf()
            args.push(element)
            return instance(l, id, args)
    panic("the core library declares no " + name)

/** The instance of the core library's function `name`, which is not generic. */
private library_function(l: *Lowering, name: string) -> usize
    for id in 0..<l.program.symbols.len()
        val s = l.program.symbols[id]
        if s.module_name == "avin" && s.name == name && s.owner_class is None && s.receiver is None
            return instance(l, id, buf())
    panic("the core library declares no " + name)

/** The element type of `t` when it is a sequence: the core library's `Seq` itself, or a class or
 * data type conforming to it. */
private seq_element(l: *Lowering, t: &Type) -> Option[&Type]
    val seq = core_class(l, "Seq")?
    if *t is Class(k, _, a)
        if k == seq then return Some(a[0])
    if !(*t is Class(_, _, _) || *t is Data(_, _, _)) then return None
    var up: Buf[&Type] = buf()
    class_ancestors(l, t, &up)
    for p in up
        if *p is Class(k, _, a)
            if k == seq then return Some(a[0])
    None

/** Whether `t` is the core library's `Seq`. */
private is_core_seq(l: *Lowering, t: &Type) -> bool
    val seq = core_class(l, "Seq")
    if seq is Some(s)
        if *t is Class(k, _, _) then return k == s
    false

/** Whether `t` is a trait or an abstract class, whose values are of the types that implement it. */
private is_abstract_or_trait(l: *Lowering, t: &Type) -> bool
    if *t is Class(k, _, _)
        return l.program.classes[k].decl.modifier == "trait" || l.program.classes[k].decl.modifier == "abstract"
    false

// The core library's `Array` of `element`.
private array_type(l: *Lowering, element: &Type) -> &Type
    for id in 0..<l.program.classes.len()
        if is_array_class(l.program.classes[id])
            var args: Buf[&Type] = buf()
            args.push(element)
            return Class(id, "Array", args)
    panic("the core library declares no Array")

/** The symbol of the shim a binding's body calls: `avin_shim_` and the binding's own symbol, with
 * each character other than a letter or a digit written as `_` and its two hex digits. */
shim_symbol(function: string) -> string
    val hex = "0123456789abcdef"
    var out: Buf[u8] = buf()
    for b in "avin_shim_".bytes
        out.push(b)
    for b in function.bytes
        if b >= u8('a') && b <= u8('z') || b >= u8('A') && b <= u8('Z') || b >= u8('0') && b <= u8('9')
            out.push(b)
        else
            out.push(u8('_'))
            out.push(hex.bytes[usize(b >> 4)])
            out.push(hex.bytes[usize(b & 15)])
    from_utf8_unchecked(out.view())

// An intrinsic is a function like any other in the object file; its body is the operation the
// intrinsic names, so it can be passed as a value. A direct call of a string operation is lowered in
// place instead, so a value of one reports its checks at the intrinsic's declaration.
private intrinsic_body(l: *Lowering, symbol: FunctionSymbol)
    val name = symbol.intrinsic.unwrap_or("")
    if name.starts_with("string_")
        var operands: Buf[Operand] = buf()
        for i in 0..<symbol.params.len()
            operands.push(Value(i))
        val result = intrinsic_operation(l, name, operands, symbol.decl.name_span)
        finish(l, Return(result))
        return
    // A trap's reason is a literal at each call; called as a value it has none to name.
    if name == "trap"
        finish(l, trap_at(l, "trap", symbol.decl.name_span))
        return
    if name.starts_with("array_")
        var elements: Buf[Operand] = buf()
        for i in 0..<symbol.params.len()
            if l.param_values[i] is Some(v) then elements.push(Value(v))
        val array = concrete(l, if name == "array_new" then symbol.result.unwrap_or(Unit) else symbol.params[0])
        finish(l, Return(array_operation(l, name, array, elements, symbol.decl.name_span)))
        return
    if name.starts_with("atomic_")
        var operands: Buf[Operand] = buf()
        for i in 0..<symbol.params.len()
            if l.param_values[i] is Some(v) then operands.push(Value(v))
        finish(l, Return(atomic_operation(l, name, concrete(l, symbol.params[0]), operands)))
        return
    if name == "holds_handles"
        var seen: Buf[string] = buf()
        finish(l, Return(Some(ConstBool(holds_handles(l, concrete(l, symbol.params[0]), &seen)))))
        return
    // An operation of a view or a block calls the runtime's entry point of its name with its receiver
    // and arguments, the descriptor of an array or block it makes, and a site for its traps, which
    // report where the program called it.
    if is_c_memory_intrinsic(name)
        var args: Buf[Operand] = buf()
        var types: Buf[MirType] = buf()
        for i in 0..<symbol.params.len()
            if l.param_values[i] is Some(v)
                if machine(l, concrete(l, symbol.params[i])) is Some(m)
                    args.push(Value(v))
                    types.push(m)
        val made = concrete(l, symbol.result.unwrap_or(Unit))
        if name == "c_view_slice" || name == "c_block_new"
            args.push(DescriptorAddress(layout(l, made).variants[0].descriptor))
            types.push(MPtr)
        args.push(TrapSiteAddress(trap_site(l, "", symbol.decl.name_span)))
        types.push(MPtr)
        val result = machine(l, made)
        val dest = result match
            Some(t) -> Some(fresh(l, t))
            None -> None
        l.insts.push(Call(dest, Runtime("avin_rt_" + name, MirSignature(types, result)), args))
        finish(l, Return(dest match
            Some(id) -> Some(Value(id))
            None -> None))
        return
    // Every other intrinsic calls one runtime entry point.
    val found = intrinsic_entry(name) match
        Some(f) -> f
        None ->
            finish(l, Unreachable)
            return
    var args: Buf[Operand] = buf()
    var params: Buf[MirType] = buf()
    for i in 0..<found.1.len()
        if machine(l, found.1[i]) is Some(t)
            if l.param_values[i] is Some(v) then args.push(Value(v))
            params.push(t)
    // The runtime runs a started thread's closure, an actor's guarded code and the exit hooks
    // through the program's closure runner, since it calls with the C convention and the closure's
    // entry has the program's own; a scope's body run so that a cancellation returns to it, too.
    if name == "thread_start" || name == "actor_guarded" || name == "exit_hooks" || name == "cancel_guarded"
        args.push(ClosureRunner)
        params.push(MPtr)
    val result = machine(l, found.2)
    val dest = result match
        Some(t) -> Some(fresh(l, t))
        None -> None
    l.insts.push(Call(dest, Runtime(found.0, MirSignature(params, result)), args))
    // An entry point that never returns, such as ending the process, leaves nothing to return.
    if *found.2 is Nothing
        finish(l, Unreachable)
        return
    finish(l, Return(dest match
        Some(id) -> Some(Value(id))
        None -> None))

/** The bytes of a string's header, its length, before its UTF-8 bytes. */
private const TextHeader: usize = 8

// The string operations. A string's length is a 64-bit word at its start, but no string is longer
// than the largest `int`, so byte offsets and lengths are `int`. An offset compared unsigned against
// a length is out of range when negative too.
private intrinsic_operation(l: *Lowering, name: string, args: Buf[Operand], at: Span) -> Option[Operand]
    val s = args[0]
    if name == "string_byte_length" then return Some(byte_length(l, s))
    if name == "string_byte_at"
        trap_if(l, compare(l, CmpUge, args[1], byte_length(l, s)), "byte offset out of range", at)
        val bytes = fresh(l, MPtr)
        l.insts.push(Offset(bytes, s, TextHeader))
        val address = fresh(l, MPtr)
        l.insts.push(Index(address, Value(bytes), args[1]))
        val b = fresh(l, MInt(8))
        l.insts.push(Load(b, Value(address)))
        return Some(Value(b))
    if name == "string_slice"
        // The runtime answers no string when an offset falls inside a character.
        trap_if(l, compare(l, CmpUgt, args[2], byte_length(l, s)), "slice out of range", at)
        trap_if(l, compare(l, CmpUgt, args[1], args[2]), "slice out of range", at)
        val part = runtime_call(l, "avin_rt_string_slice", [MRef, MInt(32), MInt(32)], MRef, [s, args[1], args[2]])
        trap_if(l, compare(l, CmpEq, part, NullAddress), "slice offset is not a character boundary", at)
        return Some(part)
    if name == "string_find"
        return Some(runtime_call(l, "avin_rt_string_find", [MRef, MRef, MInt(32)], MInt(32), [s, args[1], args[2]]))
    if name == "string_parse_real"
        return Some(runtime_call(l, "avin_rt_string_parse_real", [MRef], MReal, [s]))
    if name == "string_repeat"
        trap_if(l, compare(l, CmpLt, args[1], ConstInt(32, "0")), "negative repeat count", at)
        return Some(runtime_call(l, "avin_rt_string_repeat", [MRef, MInt(32)], MRef, [s, args[1]]))
    None

/** The bytes of an array's header, its length, before its elements. */
private const ArrayHeader: usize = 8

// The array operations, on an array of type `array`, whose element type decides each element's
// width and machine type. An array's length is a 64-bit word at its start, at most the largest
// `int`, so indices are `int`s; an index compared unsigned against the length is out of range when
// negative too. Every operand that is a reference is a root, so the array survives the allocation a
// new array makes.
private array_operation(l: *Lowering, name: string, array: &Type, args: Buf[Operand], at: Span) -> Option[Operand]
    val element: &Type = *array match
        Class(_, _, type_args) -> type_args[0]
        _ -> Unit
    val m = mir_type(element)
    val size = element_size(m)
    if name == "array_new"
        trap_if(l, compare(l, CmpLt, args[0], ConstInt(32, "0")), "negative array length", at)
        val descriptor = layout(l, array).variants[0].descriptor
        val length = convert_op(l, SignExtend, MInt(64), args[0])
        return Some(runtime_call(l, "avin_rt_new_array", [MPtr, MInt(64)], MRef, [DescriptorAddress(descriptor), length]))
    val a = args[0]
    // A frozen array is the array itself, seen through a type that only reads it.
    if name == "array_freeze" then return Some(a)
    // The end of filling an array the library made: every element store before it is visible to
    // another thread no later than any store that hands the array over.
    if name == "array_publish"
        l.insts.push(Publish)
        return None
    if name == "array_length" then return Some(byte_length(l, a))
    if name == "array_clear"
        trap_if(l, compare(l, CmpUgt, args[2], byte_length(l, a)), "slice out of range", at)
        trap_if(l, compare(l, CmpUgt, args[1], args[2]), "slice out of range", at)
        var types: Buf[MirType] = buf()
        types.push(MRef)
        types.push(MInt(32))
        types.push(MInt(32))
        l.insts.push(Call(None, Runtime("avin_rt_array_clear", MirSignature(types, None)), args))
        return None
    if name == "array_slice"
        trap_if(l, compare(l, CmpUgt, args[2], byte_length(l, a)), "slice out of range", at)
        trap_if(l, compare(l, CmpUgt, args[1], args[2]), "slice out of range", at)
        return Some(runtime_call(l, "avin_rt_array_slice", [MRef, MInt(32), MInt(32)], MRef, [a, args[1], args[2]]))
    // `array_apply` and `array_update`: the element at the index, checked against the length.
    trap_if(l, compare(l, CmpUge, args[1], byte_length(l, a)), "index out of range", at)
    val t = m match
        Some(t) -> t
        None -> return None
    val elements = fresh(l, MPtr)
    l.insts.push(Offset(elements, a, ArrayHeader))
    val index = convert_op(l, SignExtend, MInt(64), args[1])
    val offset = if size == 1 then index else binary(l, MInt(64), OpMul, index, ConstInt(64, s"$size"))
    val address = fresh(l, MPtr)
    l.insts.push(Index(address, Value(elements), offset))
    if name == "array_update"
        l.insts.push(Store(Value(address), args[2]))
        return None
    val value = fresh(l, t)
    l.insts.push(Load(value, Value(address)))
    Some(Value(value))

/** Whether the `Atomic` type `atomic` holds values that have no identity, which `compareAndSet`
 * compares with `==`: a data value (an `Option` among them), a tuple, a string or an `Any`. A scalar,
 * a function and a reference to an object of a class compare as the word they are. */
private held_by_value(atomic: &Type) -> bool = *atomic match
    Class(_, _, args) ->
        if args.len() != 1 then false
        else *args[0] match
            Str -> true
            Tuple(_) -> true
            Data(_, _, _) -> true
            AnyType -> true
            Union(_) -> true
            _ -> false
    _ -> false

// The operations of `avin.threads.Atomic`, on the value its object holds as its first field: the
// receiver is the first operand, and a value to store or compare follows it. A value with no runtime
// representation is never stored, so every compare-and-set of one succeeds.
private atomic_operation(l: *Lowering, name: string, atomic: &Type, args: Buf[Operand]) -> Option[Operand]
    if name == "atomic_by_value" then return Some(ConstBool(held_by_value(atomic)))
    val field = layout(l, atomic).variants[0].fields[0] match
        Some(f) -> f
        None -> return if name == "atomic_compare_set" then Some(ConstBool(true)) else None
    val address = field_address(l, args[0], field)
    if name == "atomic_store"
        l.insts.push(AtomicStore(address, args[1]))
        return None
    if name == "atomic_compare_set"
        val done = fresh(l, MBool)
        l.insts.push(AtomicCompareSet(done, address, args[1], args[2]))
        return Some(Value(done))
    val value = fresh(l, field.ty)
    if name == "atomic_swap" then l.insts.push(AtomicSwap(value, address, args[1]))
    else l.insts.push(AtomicLoad(value, address))
    Some(Value(value))

/** The length in bytes of the string `s`, as an `int`. */
private byte_length(l: *Lowering, s: Operand) -> Operand
    val word = fresh(l, MInt(64))
    l.insts.push(Load(word, s))
    convert_op(l, Truncate, MInt(32), Value(word))

private new_block(l: *Lowering) -> usize
    val id = l.blocks.len()
    l.blocks.push(MirBlock(buf(), Unreachable))
    id

/** Ends the current block with `term`. */
private finish(l: *Lowering, term: Terminator)
    l.blocks[l.current].insts = l.insts
    l.blocks[l.current].term = term
    l.insts = buf()

/** Ends the current block and continues in `block`. */
private finish_into(l: *Lowering, term: Terminator, block: usize)
    finish(l, term)
    l.current = block

/** Ends the current block with control that never falls through, and continues in a fresh block
 * no path reaches, for any code the program writes after it. */
private leave(l: *Lowering, term: Terminator)
    finish_into(l, term, new_block(l))

private fresh(l: *Lowering, t: MirType) -> usize
    val id = l.values.len()
    l.values.push(t)
    id

private new_slot(l: *Lowering, t: &Type) -> Option[Place] = machine(l, t) match
    Some(m) -> machine_slot(l, m)
    None -> None

private machine_slot(l: *Lowering, m: MirType) -> Option[Place]
    val id = l.slots.len()
    l.slots.push(m)
    Some(Place(SlotAddress(id), m))

/** The index of the state word of the module-level `lazy val` `g`: the state words follow the
 * values, one for each lazy value in declaration order. */
private lazy_state(l: *Lowering, g: usize) -> usize
    var index = l.program.globals.len()
    for i in 0..<g
        if l.program.globals[i].lazy then index += 1
    index

// The read of a lazy value whose state word is at `state`. The word is 0 before the first read, the
// reading thread's context while that thread runs the initializer, and 1 once the value is stored. A
// read that finds 1 loads the value at once: one atomic load and a branch the processor predicts.
// Any other asks the runtime, which answers whether this thread is to run the initializer, having
// claimed the word, or the value is now stored, having waited, safe for the collector, for the
// thread running it; a thread that finds its own context there traps at the read. The thread that
// runs it stores the value and then marks the word with a release store, so a thread that sees the
// mark sees the whole value.
private lazy_read(l: *Lowering, at: Span, name: string, p: LazyPlace, initialize: &TExpr) -> Option[Operand]
    val word = fresh(l, MInt(64))
    l.insts.push(AtomicLoad(word, lazy_state_address(l, p)))
    val ready = compare(l, CmpEq, Value(word), ConstInt(64, "1"))
    val slow = new_block(l)
    val run = new_block(l)
    val done = new_block(l)
    finish_into(l, Branch(ready, done, slow), slow)
    val site = trap_site(l, s"`$name` is read while it is being initialized", at)
    val first = runtime_call(l, "avin_rt_lazy_begin", [MPtr, MPtr], MInt(32), [lazy_state_address(l, p), TrapSiteAddress(site)])
    finish_into(l, Branch(compare(l, CmpNe, first, ConstInt(32, "0")), run, done), run)
    val value = lower_expr(l, initialize)
    // An initializer that never returns traps or ends the program.
    if value is None && machine(l, initialize.ty) is Some(_) then finish_into(l, Unreachable, done)
    else
        store(l, lazy_value_place(l, p), value)
        var types: Buf[MirType] = buf()
        types.push(MPtr)
        var args: Buf[Operand] = buf()
        args.push(lazy_state_address(l, p))
        l.insts.push(Call(None, Runtime("avin_rt_lazy_end", MirSignature(types, None)), args))
        finish_into(l, Jump(done), done)
    load(l, lazy_value_place(l, p))

/** Where a lazy value is kept: module-level value `global`'s storage, or the fields `state` and
 * `value` of `object`, `value` being `None` for a value with no runtime representation. */
private struct LazyPlace
    object: Option[Operand]
    global: usize
    state: Option[FieldSlot]
    value: Option[FieldSlot]

private lazy_state_address(l: *Lowering, p: LazyPlace) -> Operand = p.object match
    Some(o) -> field_address(l, o, p.state.unwrap())
    None -> GlobalAddress(lazy_state(l, p.global))

private lazy_value_place(l: *Lowering, p: LazyPlace) -> Option[Place] = p.object match
    Some(o) -> p.value match
        Some(f) -> Some(Place(field_address(l, o, f), f.ty))
        None -> None
    None -> global_place(l, p.global)

/** Where a module-level value is kept, or `None` for one with no runtime value. */
private global_place(l: *Lowering, g: usize) -> Option[Place] = l.global_types[g] match
    Some(t) -> Some(Place(GlobalAddress(g), t))
    None -> None

private store(l: *Lowering, place: Option[Place], value: Option[Operand])
    if place is Some(p)
        if value is Some(v) then l.insts.push(Store(p.address, v))

private load(l: *Lowering, place: Option[Place]) -> Option[Operand] = place match
    Some(p) ->
        val dest = fresh(l, p.ty)
        l.insts.push(Load(dest, p.address))
        Some(Value(dest))
    None -> None

/** The trap site for `reason` at the start of `at`, in the function being lowered; made when first
 * asked for, so every instance of a generic function shares its sites. A site names its file
 * without the directories it was compiled from, so a report reads the same wherever it was built. */
private trap_site(l: *Lowering, reason: string, at: Span) -> usize
    // An empty span is code the compiler wrote rather than the source, placed nowhere in it: its
    // site is the function being lowered's own.
    val made = if at.start == at.end then lowering_scope(l) else ""
    val key = if made == "" then s"${l.unit}:${at.start}:$reason" else s"${l.unit}:made $made:$reason"
    if l.trap_index.get(key) is Some(index) then return index
    val src = l.program.sources[l.unit]
    val position = src.locate(at.start)
    val file = file_name(src.name).unwrap_or(src.name)
    val name = if made == "" then trap_name(l, reason, at, file) else s"$made+made:" + content_key(reason)[0..<12]
    l.traps.push(TrapSite(name, intern(l, reason), intern(l, file), position.line, position.col))
    l.trap_index.put(key, l.traps.len() - 1)
    l.traps.len() - 1

/** What follows the last dot of a function's name: a method's own name. */
private member_part(name: string) -> string
    var at = name.bytes.len
    while at > 0 && name.bytes[at - 1] != u8('.')
        at -= 1
    name[at..]

/** The instance being lowered, spelled as stably as its symbol: a written function by
 * `function_symbol`, a generated one by its type arguments. */
private lowering_scope(l: *Lowering) -> string
    if l.function_index >= l.instances.len() then return "<program>"
    val inst = l.instances[l.function_index]
    if inst.generated == Written then function_symbol(l, inst.function, inst.type_args)
    else "generated " + stable_key_list(l.program, inst.type_args)

/** **A trap site's name**: the innermost top-level function or method declared around it, by its
 * symbol, then the site's byte offset from that declaration's start and a hash of its reason. Lines
 * added above the function, in its file or anywhere else, leave the name as it was, as does renaming
 * the file; only an edit to the function itself moves it. A site outside every function's
 * declaration is named by its file and offset. */
private trap_name(l: *Lowering, reason: string, at: Span, file: string) -> string
    if l.unit_functions.get(l.unit) is None
        var found: Buf[usize] = buf()
        for id in 0..<l.program.symbols.len()
            val s = l.program.symbols[id]
            if s.unit == l.unit && s.root is None then found.push(id)
        l.unit_functions.put(l.unit, found)
    var best: Option[usize] = None
    var best_name = ""
    for id in l.unit_functions.get(l.unit).unwrap()
        val span = l.program.symbols[id].decl.span
        if !(span.start <= at.start && at.start <= span.end) then continue
        val name = function_symbol(l, id, buf())
        val better = best match
            Some(b) ->
                val other = l.program.symbols[b].decl.span
                val width = span.end - span.start
                val other_width = other.end - other.start
                width < other_width || (width == other_width && name < best_name)
            None -> true
        if better
            best = Some(id)
            best_name = name
    // A declaration several functions share is a template the checker copies, a derived `Display`
    // into every type that asks for one: no copy is the site's own, and which copies exist depends on
    // the program, so such a site is named by its file and offset, as one outside every function is.
    // The copies are told by their names: one method's name on different types. A function and the
    // functions computing its defaults share its declaration too, but its name.
    var shared = false
    if best is Some(b)
        val mine = l.program.symbols[b]
        for id in l.unit_functions.get(l.unit).unwrap()
            val other = l.program.symbols[id]
            if id != b && other.decl.span.start == mine.decl.span.start && other.decl.span.end == mine.decl.span.end && other.name != mine.name && member_part(other.name) == member_part(mine.name) then shared = true
    val place = best match
        Some(id) -> if shared then s"$file+${at.start}" else s"$best_name+${at.start - l.program.symbols[id].decl.span.start}"
        None -> s"$file+${at.start}"
    place + ":" + content_key(reason)[0..<12]

/** A terminator that stops the program for `reason` at `at`. In the core library the place
 * reported is where the program entered the library instead: the program's author wrote that call,
 * not the library's check. */
private trap_at(l: *Lowering, reason: string, at: Span) -> Terminator = trap_terminator(l, trap_site(l, reason, at))

private trap_terminator(l: *Lowering, site: usize) -> Terminator = if l.library then CallerTrap(site) else Trap(site)

// A call. A trap inside the core library reports the place the program entered the library, which
// the context holds as its caller site, so each call that may enter the library from the program's
// own code first sets that site to the call's place, and each call from the library that may run
// the program's own code, which can enter the library again, keeps the site across it. A call
// between two of the program's functions, or between two of the library's, touches nothing. A call
// through a method table or a function value may reach either, so it is treated as both.
private push_call(l: *Lowering, dest: Option[usize], callee: Callee, args: Buf[Operand])
    // A Sysl binding reports a call on a closed handle, or an integer its conversion cannot hold, as
    // the library does, at the call, so a call to one is placed as a call into the library is.
    val target: Option[bool] = callee match
        Direct(index) -> Some(library_instance(l, index) || bound_instance(l, index))
        _ -> None
    if l.library
        if target is Some(true)
            l.insts.push(Call(dest, callee, args))
            return
        val saved = fresh(l, MPtr)
        l.insts.push(Load(saved, CallerSite))
        l.insts.push(Call(dest, callee, args))
        l.insts.push(Store(CallerSite, Value(saved)))
        return
    if !(target is Some(false)) then l.insts.push(Store(CallerSite, TrapSiteAddress(trap_site(l, "", l.here))))
    l.insts.push(Call(dest, callee, args))

/** Continues only when `flag` is false; otherwise the program traps for `reason` at `at`. The
 * checks of one operation for one reason branch to one block, which is cold and ends the program. */
private trap_if(l: *Lowering, flag: Operand, reason: string, at: Span)
    val site = trap_site(l, reason, at)
    val block = l.trap_blocks.get(site) match
        Some(b) -> b
        None ->
            val b = new_block(l)
            l.blocks[b].term = trap_terminator(l, site)
            l.trap_blocks.put(site, b)
            b
    val next = new_block(l)
    finish_into(l, Branch(flag, block, next), next)

private binary(l: *Lowering, t: MirType, op: MirOp, a: Operand, b: Operand) -> Operand
    val dest = fresh(l, t)
    l.insts.push(Binary(dest, op, a, b))
    Value(dest)

private compare(l: *Lowering, op: MirCmp, a: Operand, b: Operand) -> Operand
    val dest = fresh(l, MBool)
    l.insts.push(Compare(dest, op, a, b))
    Value(dest)

private select(l: *Lowering, t: MirType, condition: Operand, yes: Operand, no: Operand) -> Operand
    val dest = fresh(l, t)
    l.insts.push(Select(dest, condition, yes, no))
    Value(dest)

/** An addition, subtraction or multiplication that traps at `at` when it overflows. */
private checked(l: *Lowering, bits: u32, op: MirChecked, a: Operand, b: Operand, at: Span) -> Operand
    val dest = fresh(l, MInt(bits))
    val overflow = fresh(l, MBool)
    l.insts.push(Checked(dest, overflow, op, a, b))
    trap_if(l, Value(overflow), "integer overflow", at)
    Value(dest)

/** Lowers an expression for its value; `None` for an expression with no runtime value, or one in
 * code no path reaches. A call made for the expression is placed at its start. */
private lower_expr(l: *Lowering, e: &TExpr) -> Option[Operand] = lower_at(l, e, false)

/** Lowers `e`, which with `tail` is in tail position: its value is the function's result. */
private lower_at(l: *Lowering, e: &TExpr, tail: bool) -> Option[Operand]
    val outer = l.here
    l.here = e.span
    val value = lower_kind(l, e, tail)
    l.here = outer
    value

private lower_kind(l: *Lowering, e: &TExpr, tail: bool) -> Option[Operand] = e.kind match
    IntConst(digits) -> Some(ConstInt(int_bits(e.ty), digits))
    BoolConst(value) -> Some(ConstBool(value))
    CharConst(code) -> Some(ConstInt(32, code.to_string()))
    RealConst(value) -> Some(ConstReal(value))
    StrConst(value) -> Some(string_constant(l, value))
    UnitConst -> None
    CConst(name) -> Some(c_constant(l, e.ty, name))
    Param(index) -> param_operand(l, index)
    Local(index) -> load(l, local_place(l, index))
    TypeReceiver -> panic("a static member's receiver is a type, which has no value to lower")
    Call(function, args, type_args) ->
        if tail && l.tail_head is Some(_) && same_instance(l, function, type_args) then return tail_call(l, function, args)
        returned_call(l, tail, direct_call(l, e, function, args, type_args))
    Dispatch(function, slot, args, type_args) -> returned_call(l, tail, dispatch(l, function, slot, args, type_args))
    BoundCall(function, slot, args, type_args) -> returned_call(l, tail, bound_call(l, e, function, slot, args, type_args))
    Construct(variant, args) -> construct(l, e, variant, args)
    Collection(_, built) -> lower_expr(l, built)
    FunctionValue(function, type_args) -> Some(function_value(l, function, type_args))
    CallValue(callee, args) -> returned_call(l, tail, call_value(l, callee, args))
    Field(value, index) ->
        val object = lower_expr(l, value)?
        layout(l, concrete(l, value.ty)).variants[0].fields[index] match
            Some(field) -> constant_field(l, object, field) match
                Some(known) -> Some(known)
                None -> Some(load_field(l, object, field))
            None -> None
    New ->
        val object = fresh(l, MRef)
        l.insts.push(Alloc(object, layout(l, concrete(l, e.ty)).variants[0].descriptor))
        Some(Value(object))
    Global(index) -> l.constant_values[index] match
        Some(object) -> Some(object)
        None -> load(l, global_place(l, index))
    LazyGlobal(index, initialize, name) -> lazy_read(l, e.span, name, LazyPlace(None, index, None, None), initialize)
    LazyField(value, index, initialize, name) ->
        val object = lower_expr(l, value)?
        val fields = layout(l, concrete(l, value.ty)).variants[0].fields
        lazy_read(l, e.span, name, LazyPlace(Some(object), 0, fields[index + 1], fields[index]), initialize)
    StoreGlobal(index, value, yields) ->
        // A value made at compile time is never initialized: its initializer has no effects.
        if l.constant_values[index] is Some(object) then return if yields then Some(object) else None
        val v = lower_expr(l, value)
        if v is None && machine(l, value.ty) is Some(_) then return None
        store(l, global_place(l, index), v)
        if yields then v else None
    StoreField(object, index, value, yields) ->
        val target = lower_expr(l, object)?
        val v = lower_expr(l, value)
        if v is None && machine(l, value.ty) is Some(_) then return None
        layout(l, concrete(l, object.ty)).variants[0].fields[index] match
            Some(field) -> if v is Some(x) then l.insts.push(Store(field_address(l, target, field), x))
            None -> ()
        if yields then v else None
    Block(items) ->
        var last: Option[Operand] = None
        for i in 0..<items.len()
            last = lower_at(l, items[i], tail && i + 1 == items.len())
        if machine(l, e.ty) is Some(_) then last else None
    Let(local, value) ->
        bind_local(l, local, lower_expr(l, value))
        None
    LetPattern(pattern, value) ->
        // The pattern cannot fail, so its failure block is never reached.
        val fail = new_block(l)
        val join = new_block(l)
        test_parts(l, pattern, value, fail)
        finish_into(l, Jump(join), fail)
        finish_into(l, trap_at(l, "no value matched the binding's pattern", pattern.span), join)
        None
    Store(local, value, yields) ->
        val v = lower_expr(l, value)
        store(l, local_place(l, local), v)
        if yields then v else None
    MultiStore(locals, value) ->
        val parts = tuple_parts(l, value)?
        for i in 0..<locals.len()
            if locals[i] is Some(local) then store(l, local_place(l, local), parts[i])
        None
    Step(local, increment, postfix, op_span) -> step(l, e, local, increment, postfix, op_span)
    Negate(operand) ->
        val x = lower_expr(l, operand)?
        val t = concrete(l, e.ty)
        if !is_machine_scalar(t) then return operator_call(l, t, "negate", [x], machine(l, t))
        Some(negate_value(l, t, x, e.span))
    Not(operand) ->
        val x = lower_expr(l, operand)?
        Some(binary(l, MBool, OpXor, x, ConstBool(true)))
    Complement(operand) ->
        val x = lower_expr(l, operand)?
        val bits = int_bits(e.ty)
        Some(binary(l, MInt(bits), OpXor, x, ConstInt(bits, "-1")))
    Arith(op, left, right, op_span) ->
        val a = lower_expr(l, left)?
        val b = lower_expr(l, right)?
        val t = concrete(l, e.ty)
        // On a data type or a class the operator is its core trait's method; on a type parameter
        // whose instance is a built-in type, it is that type's machine operation.
        if !is_machine_scalar(t)
            val name = binary_operator_method(op).unwrap().method
            return operator_call(l, t, name, [a, b], machine(l, t))
        Some(scalar_arith(l, t, op, a, b, op_span))
    Convert(operand, wrap) ->
        val x = lower_expr(l, operand)?
        Some(convert(l, concrete(l, operand.ty), concrete(l, e.ty), x, e.span, wrap))
    Box(value) ->
        val v = lower_expr(l, value)
        if v is None && machine(l, value.ty) is Some(_) then return None
        box_value(l, concrete(l, value.ty), v)
    NoneAs(value) ->
        // The value is always `None`, so it is the other option's own `None`: null where that option
        // is kept as a pointer, and its one constant object where it is an object, so that as an `Any`
        // it has the option's type.
        val v = lower_expr(l, value)
        if v is None && machine(l, value.ty) is Some(_) then return None
        if pointer_option(l, e.ty) then Some(NullAddress)
        else Some(ConstObject(layout(l, concrete(l, e.ty)).variants[none_variant(l)].descriptor))
    Logic(and, left, right) -> logic(l, and, left, right, tail)
    Compare(operands, ops) -> compare_chain(l, operands, ops)
    If(condition, yes, no) -> lower_if(l, e, condition, yes, no, tail)
    While(label, condition, body, otherwise) -> lower_while(l, e, label, condition, body, otherwise)
    Break(label, value) ->
        val target = loop_target(l, label)
        var v: Option[Operand] = None
        if value is Some(x) then v = lower_expr(l, x)
        store(l, target.slot, v)
        leave(l, Jump(target.exit))
        None
    Continue(label) ->
        leave(l, Jump(loop_target(l, label).head))
        None
    Match(subject, arms) -> lower_match(l, e, subject, arms, tail)
    Is(value, pattern, negated) -> lower_is(l, value, pattern, negated)
    Clauses(subjects, clauses) -> lower_clauses(l, e, subjects, clauses, tail)
    Return(value) ->
        var v: Option[Operand] = None
        var dead = false
        if value is Some(x)
            v = lower_at(l, x, true)
            dead = *x.ty is Nothing
        leave(l, if dead then Unreachable else returning(l, v))
        None

private int_bits(t: &Type) -> u32 = *t match
    Int(bits) -> bits
    Byte -> 8
    Char -> 32
    _ -> IntBits

private loop_target(l: *Lowering, label: usize) -> LoopTarget
    for t in l.loops
        if t.label == label then return t
    LoopTarget(label, 0, 0, None)

private step(l: *Lowering, e: &TExpr, local: usize, increment: bool, postfix: bool, op_span: Span) -> Option[Operand]
    val slot = local_place(l, local)
    val old = load(l, slot)?
    val bits = int_bits(e.ty)
    val updated = checked(l, bits, if increment then CheckedAdd else CheckedSub, old, ConstInt(bits, "1"), op_span)
    store(l, slot, Some(updated))
    Some(if postfix then old else updated)

// Avin's integer operators on machine operations. `+`, `-` and `*` trap on overflow; `/` traps on
// a zero divisor and on the one quotient that does not fit; `%` traps on a zero divisor and is 0
// for a divisor of -1; a shift count at least the width, or negative, shifts every bit out.
private arith(l: *Lowering, bits: u32, op: BinaryOp, a: Operand, b: Operand, at: Span) -> Operand
    val t = MInt(bits)
    op match
        Add -> checked(l, bits, CheckedAdd, a, b, at)
        Subtract -> checked(l, bits, CheckedSub, a, b, at)
        Multiply -> checked(l, bits, CheckedMul, a, b, at)
        AddWrapping -> binary(l, t, OpAdd, a, b)
        SubtractWrapping -> binary(l, t, OpSub, a, b)
        MultiplyWrapping -> binary(l, t, OpMul, a, b)
        AddSaturating -> binary(l, t, OpAddSat, a, b)
        SubtractSaturating -> binary(l, t, OpSubSat, a, b)
        MultiplySaturating -> binary(l, t, OpMulSat, a, b)
        BitAnd -> binary(l, t, OpAnd, a, b)
        BitOr -> binary(l, t, OpOr, a, b)
        BitXor -> binary(l, t, OpXor, a, b)
        Divide ->
            trap_if(l, compare(l, CmpEq, b, ConstInt(bits, "0")), "division by zero", at)
            val minimum = compare(l, CmpEq, a, ConstInt(bits, min_digits(bits)))
            val minus_one = compare(l, CmpEq, b, ConstInt(bits, "-1"))
            trap_if(l, binary(l, MBool, OpAnd, minimum, minus_one), "integer overflow", at)
            binary(l, t, OpDiv, a, b)
        Remainder ->
            trap_if(l, compare(l, CmpEq, b, ConstInt(bits, "0")), "remainder by zero", at)
            val minus_one = compare(l, CmpEq, b, ConstInt(bits, "-1"))
            binary(l, t, OpRem, a, select(l, t, minus_one, ConstInt(bits, "1"), b))
        ShiftLeft ->
            val out = compare(l, CmpUge, b, ConstInt(bits, bits.to_string()))
            select(l, t, out, ConstInt(bits, "0"), binary(l, t, OpShl, a, b))
        ShiftRight ->
            val out = compare(l, CmpUge, b, ConstInt(bits, bits.to_string()))
            binary(l, t, OpAShr, a, select(l, t, out, ConstInt(bits, (bits - 1).to_string()), b))
        _ -> a

/** An arithmetic, bitwise or shift operation on two values of the built-in type `t`, or `+` joining
 * two strings. */
private scalar_arith(l: *Lowering, t: &Type, op: BinaryOp, a: Operand, b: Operand, at: Span) -> Operand = *t match
    Real -> real_arith(l, op, a, b)
    Byte -> byte_arith(l, op, a, b)
    Str -> runtime_call(l, "avin_rt_string_concat", [MRef, MRef], MRef, [a, b])
    _ -> arith(l, int_bits(t), op, a, b, at)

/** `-x` on an integer, which traps on overflow, or a real. */
private negate_value(l: *Lowering, t: &Type, x: Operand, at: Span) -> Operand
    if *t is Real then return binary(l, MReal, OpFSub, ConstReal(-0.0), x)
    val bits = int_bits(t)
    checked(l, bits, CheckedSub, ConstInt(bits, "0"), x, at)

private real_arith(l: *Lowering, op: BinaryOp, a: Operand, b: Operand) -> Operand
    val machine = op match
        Add -> OpFAdd
        Subtract -> OpFSub
        Multiply -> OpFMul
        Divide -> OpFDiv
        _ -> OpFRem
    binary(l, MReal, machine, a, b)

// A byte's bits are unsigned, so `>>` shifts zeros in.
private byte_arith(l: *Lowering, op: BinaryOp, a: Operand, b: Operand) -> Operand
    val t = MInt(8)
    op match
        BitAnd -> binary(l, t, OpAnd, a, b)
        BitOr -> binary(l, t, OpOr, a, b)
        BitXor -> binary(l, t, OpXor, a, b)
        ShiftLeft ->
            val out = compare(l, CmpUge, b, ConstInt(8, "8"))
            select(l, t, out, ConstInt(8, "0"), binary(l, t, OpShl, a, b))
        _ ->
            val out = compare(l, CmpUge, b, ConstInt(8, "8"))
            select(l, t, out, ConstInt(8, "0"), binary(l, t, OpLShr, a, b))

private convert_op(l: *Lowering, conv: MirConv, t: MirType, x: Operand) -> Operand
    val dest = fresh(l, t)
    l.insts.push(Convert(dest, conv, x))
    Value(dest)

// Changes an integer's width: `signed` says whether its bits are signed, as an `iN`'s are and a
// byte's and a char's are not.
private resize(l: *Lowering, x: Operand, from: u32, to: u32, signed: bool) -> Operand
    if from == to then return x
    if from > to then return convert_op(l, Truncate, MInt(to), x)
    convert_op(l, if signed then SignExtend else ZeroExtend, MInt(to), x)

private convert(l: *Lowering, from: &Type, to: &Type, x: Operand, at: Span, wrap: bool) -> Operand = *to match
    Real -> *from match
        Real -> x
        Byte -> convert_op(l, UnsignedToReal, MReal, x)
        _ -> convert_op(l, SignedToReal, MReal, x)
    Int(bits) -> *from match
        Real -> convert_op(l, RealToInt, MInt(bits), x)
        Int(width) -> if wrap then resize(l, x, width, bits, true) else narrow_signed(l, x, width, bits, to, at)
        _ -> if wrap then resize(l, x, int_bits(from), bits, false) else narrow_unsigned(l, x, int_bits(from), bits, to, at)
    Byte -> *from match
        Int(width) -> to_byte(l, x, width, at)
        _ -> x
    Char -> *from match
        Int(width) -> to_char(l, x, width, at)
        Byte -> resize(l, x, 8, 32, false)
        _ -> x
    _ -> x

// A signed integer becomes one of another width: widening sign-extends, and narrowing traps when the
// value does not survive the trip back to the wider width.
private narrow_signed(l: *Lowering, x: Operand, from: u32, to: u32, target: &Type, at: Span) -> Operand
    if from <= to then return resize(l, x, from, to, true)
    val narrow = resize(l, x, from, to, true)
    val back = resize(l, narrow, to, from, true)
    trap_if(l, compare(l, CmpNe, back, x), s"value out of range for ${type_name(target)}", at)
    narrow

// A byte or a char, whose bits are unsigned, becomes a signed integer: it traps when the value is
// above the greatest the width holds.
private narrow_unsigned(l: *Lowering, x: Operand, from: u32, to: u32, target: &Type, at: Span) -> Operand
    if from < to then return resize(l, x, from, to, false)
    trap_if(l, compare(l, CmpUgt, x, ConstInt(from, max_digits(to))), s"value out of range for ${type_name(target)}", at)
    resize(l, x, from, to, false)

// An integer becomes a byte only when it is 0 to 255; anything else traps.
private to_byte(l: *Lowering, x: Operand, width: u32, at: Span) -> Operand
    if width <= 8
        trap_if(l, compare(l, CmpLt, x, ConstInt(width, "0")), "value out of range for byte", at)
        return resize(l, x, width, 8, false)
    trap_if(l, compare(l, CmpUgt, x, ConstInt(width, "255")), "value out of range for byte", at)
    resize(l, x, width, 8, false)

// An integer becomes a char only when it is a Unicode scalar value: 0 to 0x10FFFF, outside the
// surrogates 0xD800 to 0xDFFF. A negative value compares as huge, so one unsigned test covers both
// ends.
private to_char(l: *Lowering, x: Operand, width: u32, at: Span) -> Operand
    val w = if width < 32 then 32u32 else width
    val wide = resize(l, x, width, w, true)
    trap_if(l, compare(l, CmpUgt, wide, ConstInt(w, "1114111")), "value out of range for char", at)
    val offset = binary(l, MInt(w), OpSub, wide, ConstInt(w, "55296"))
    trap_if(l, compare(l, CmpUlt, offset, ConstInt(w, "2048")), "surrogate code point is not a char", at)
    resize(l, wide, w, 32, false)

/** The most negative value of a width, in decimal. */
min_digits(bits: u32) -> string
    // Doubles a little-endian list of decimal digits, from 1, `bits - 1` times.
    var digits: Buf[u8] = buf()
    digits.push(1)
    for _ in 1..<bits
        var carry = 0u8
        for i in 0..<digits.len()
            val d = digits[i] * 2 + carry
            digits[i] = d % 10
            carry = d / 10
        if carry > 0 then digits.push(carry)
    var out = "-"
    var i = digits.len()
    while i > 0
        i -= 1
        out = out + char(u8('0') + digits[i]).to_string()
    out

/** The greatest value of a width, in decimal. */
max_digits(bits: u32) -> string
    // The magnitude of the least value is a power of two, which ends in 2, 4, 6 or 8, or is 1 for a
    // width of one bit, so taking one from its last digit never borrows.
    val least = min_digits(bits)
    val head = least[1..<least.len - 1]
    val last = least.bytes[least.len - 1] - 1
    head + char(last).to_string()

private logic(l: *Lowering, and: bool, left: &TExpr, right: &TExpr, tail: bool) -> Option[Operand]
    val a = lower_expr(l, left)?
    val slot = new_slot(l, Bool)
    store(l, slot, Some(a))
    val rest = new_block(l)
    val done = new_block(l)
    finish_into(l, if and then Branch(a, rest, done) else Branch(a, done, rest), rest)
    store(l, slot, lower_at(l, right, tail))
    finish_into(l, Jump(done), done)
    load(l, slot)

// Reals compare as IEEE 754 says, bytes as unsigned, and every other scalar as signed.
private compare_op(op: CompareOp, t: &Type) -> MirCmp
    if *t is Real
        return op match
            Equal -> FEq
            NotEqual -> FNe
            Less -> FLt
            LessEqual -> FLe
            Greater -> FGt
            _ -> FGe
    if *t is Byte
        return op match
            Equal -> CmpEq
            NotEqual -> CmpNe
            Less -> CmpUlt
            LessEqual -> CmpUle
            Greater -> CmpUgt
            _ -> CmpUge
    op match
        Equal -> CmpEq
        NotEqual -> CmpNe
        Same -> CmpEq
        NotSame -> CmpNe
        Less -> CmpLt
        LessEqual -> CmpLe
        Greater -> CmpGt
        _ -> CmpGe

/** The interned constant string `text`. */
private string_constant(l: *Lowering, text: string) -> Operand = ConstStr(intern(l, text))

/** The index of the constant string `text`, made when first asked for. */
private intern(l: *Lowering, text: string) -> usize
    if l.string_index.get(text) is Some(index) then return index
    l.string_index.put(text, l.strings.len())
    l.strings.push(text)
    l.strings.len() - 1

// Strings compare by the sign of the runtime's three-way comparison; every other type by one
// machine comparison.
private compare_values(l: *Lowering, op: CompareOp, t: &Type, a: Operand, b: Operand) -> Operand
    if *t is Str
        val order = runtime_call(l, "avin_rt_string_compare", [MRef, MRef], MInt(32), [a, b])
        return compare(l, compare_op(op, Int(32)), order, ConstInt(32, "0"))
    compare(l, compare_op(op, t), a, b)

/** An operand of a comparison: its value, a placeholder for a unit value, which has none and is equal
 * to every other, or `None` in code no path reaches. */
private link_operand(l: *Lowering, e: &TExpr) -> Option[Operand]
    val v = lower_expr(l, e)
    if v is None && machine(l, e.ty) is None && !(*e.ty is Nothing) then return Some(ConstBool(false))
    v

// One link of a comparison chain between values of types `x` and `y`, which may name the instance's
// type parameters. `==` and `!=` are equality of any type; `<` and the others are the machine's on a
// built-in type and `Ord`'s methods on any other.
private compare_link(l: *Lowering, op: CompareOp, x: &Type, y: &Type, a: Operand, b: Operand) -> Operand
    val s = concrete(l, x)
    val t = concrete(l, y)
    if op is Equal || op is NotEqual
        // Two sequences compare by their elements, of whichever kinds, so the comparison is the
        // library's own, at the element type.
        if seq_element(l, s) is Some(es)
            if seq_element(l, t) is Some(et)
                if !same_type(s, t) || is_abstract_or_trait(l, s)
                    val element = if is_core_seq(l, t) then et else es
                    val equal = call_instance(l, library_instance(l, "seqEquals", element), two(a, b), Some(MBool)).unwrap()
                    return if op is Equal then equal else binary(l, MBool, OpXor, equal, ConstBool(true))
        // A value whose type is decided at run time compares through its record, whichever side
        // holds it.
        val common = if decided_at_run_time(l, t) then t else s
        val same = equals_values(l, common, a, b)
        return if op is Equal then same else binary(l, MBool, OpXor, same, ConstBool(true))
    if op is Same || op is NotSame || is_machine_scalar(s) then return compare_values(l, op, s, a, b)
    val name = compare_operator_method(op).unwrap().method
    operator_call(l, s, name, [a, b], Some(MBool)).unwrap_or(ConstBool(false))

/** A call of a runtime entry point that returns a value. */
private runtime_call(l: *Lowering, symbol: string, params: []MirType, result: MirType, args: []Operand) -> Operand
    var types: Buf[MirType] = buf()
    for p in params do types.push(p)
    var operands: Buf[Operand] = buf()
    for a in args do operands.push(a)
    val dest = fresh(l, result)
    l.insts.push(Call(Some(dest), Runtime(symbol, MirSignature(types, Some(result))), operands))
    Value(dest)

// A chain evaluates each operand when its link is reached, and the first false link decides.
private compare_chain(l: *Lowering, operands: Buf[&TExpr], ops: Buf[CompareOp]) -> Option[Operand]
    var previous = link_operand(l, operands[0])?
    if ops.len() == 1
        val next = link_operand(l, operands[1])?
        return Some(compare_link(l, ops[0], operands[0].ty, operands[1].ty, previous, next))
    val slot = new_slot(l, Bool)
    val done = new_block(l)
    for i in 0..<ops.len()
        val next = link_operand(l, operands[i + 1])?
        val result = compare_link(l, ops[i], operands[i].ty, operands[i + 1].ty, previous, next)
        store(l, slot, Some(result))
        if i + 1 < ops.len()
            val more = new_block(l)
            finish_into(l, Branch(result, more, done), more)
        previous = next
    finish_into(l, Jump(done), done)
    load(l, slot)

private lower_if(l: *Lowering, e: &TExpr, condition: &TExpr, yes: &TExpr, no: Option[&TExpr], tail: bool) -> Option[Operand]
    val c = lower_expr(l, condition)?
    val slot = new_slot(l, e.ty)
    val then_block = new_block(l)
    val join = new_block(l)
    val else_block = if no is Some(_) then new_block(l) else join
    finish_into(l, Branch(c, then_block, else_block), then_block)
    store(l, slot, lower_at(l, yes, tail))
    finish(l, Jump(join))
    if no is Some(n)
        l.current = else_block
        store(l, slot, lower_at(l, n, tail))
        finish(l, Jump(join))
    l.current = join
    load(l, slot)

private lower_while(l: *Lowering, e: &TExpr, label: usize, condition: &TExpr, body: &TExpr, otherwise: Option[&TExpr]) -> Option[Operand]
    val slot = new_slot(l, e.ty)
    val head = new_block(l)
    val exit = new_block(l)
    finish_into(l, Jump(head), head)
    val c = lower_expr(l, condition)?
    val body_block = new_block(l)
    val else_block = if otherwise is Some(_) then new_block(l) else exit
    finish_into(l, Branch(c, body_block, else_block), body_block)
    l.loops.push(LoopTarget(label, head, exit, slot))
    lower_expr(l, body)
    l.loops.truncate(l.loops.len() - 1)
    finish(l, Jump(head))
    if otherwise is Some(o)
        l.current = else_block
        store(l, slot, lower_expr(l, o))
        finish(l, Jump(exit))
    l.current = exit
    load(l, slot)

/** Continues only when `condition` holds; otherwise control goes to `fail`. */
private continue_if(l: *Lowering, condition: Operand, fail: usize)
    val next = new_block(l)
    finish_into(l, Branch(condition, next, fail), next)

// Each arm tests its pattern and then its guard, going on to the next arm when either fails. The
// checker has proved the arms cover every value, so falling past the last arm traps rather than
// continuing.
private lower_match(l: *Lowering, e: &TExpr, subject: &TExpr, arms: Buf[TArm], tail: bool) -> Option[Operand]
    val s = lower_expr(l, subject)
    if s is None && machine(l, subject.ty) is Some(_) then return None
    val slot = new_slot(l, e.ty)
    val join = new_block(l)
    for arm in arms
        val fail = new_block(l)
        test_pattern(l, arm.pattern, s, fail)
        if arm.guard is Some(g)
            if lower_expr(l, g) is Some(ok) then continue_if(l, ok, fail)
        store(l, slot, lower_at(l, arm.body, tail))
        finish_into(l, Jump(join), fail)
    finish_into(l, trap_at(l, "no arm of the match took the value", e.span), join)
    load(l, slot)

// Each clause tests its patterns against the arguments, then tries its bodies' guards in order; when
// the patterns fail, or every guard does, the next clause is tried. The checker has proved the
// clauses cover every argument, so falling past the last one traps.
private lower_clauses(l: *Lowering, e: &TExpr, subjects: Buf[&TExpr], clauses: Buf[TClause], tail: bool) -> Option[Operand]
    var values: Buf[Option[Operand]] = buf()
    for s in subjects
        values.push(lower_expr(l, s))
    val slot = new_slot(l, e.ty)
    val join = new_block(l)
    for clause in clauses
        val fail = new_block(l)
        for i in 0..<clause.patterns.len()
            test_pattern(l, clause.patterns[i], values[i], fail)
        for b in clause.bodies
            val next = new_block(l)
            if b.guard is Some(g)
                if lower_expr(l, g) is Some(ok) then continue_if(l, ok, next)
            store(l, slot, lower_at(l, b.body, tail))
            finish_into(l, Jump(join), next)
        finish_into(l, Jump(fail), fail)
    finish_into(l, trap_at(l, "no clause took the arguments", e.span), join)
    load(l, slot)

private lower_is(l: *Lowering, value: &TExpr, pattern: &TPattern, negated: bool) -> Option[Operand]
    val v = lower_expr(l, value)
    if v is None && machine(l, value.ty) is Some(_) then return None
    val slot = new_slot(l, Bool)
    val fail = new_block(l)
    val join = new_block(l)
    test_pattern(l, pattern, v, fail)
    store(l, slot, Some(ConstBool(!negated)))
    finish_into(l, Jump(join), fail)
    store(l, slot, Some(ConstBool(negated)))
    finish_into(l, Jump(join), join)
    load(l, slot)

// Continues where `value`, of static type `from`, has type `to` at run time; otherwise goes to `fail`.
// A union `to`, with its unions kept, is had where one of its members is.
private member_test(l: *Lowering, from: &Type, to: &Type, value: Option[Operand], fail: usize)
    if *to is Union(members)
        val matched = new_block(l)
        for m in members
            val next = new_block(l)
            member_test(l, from, m, value, next)
            finish(l, Jump(matched))
            l.current = next
        finish(l, Jump(fail))
        l.current = matched
        return
    val target = erase_unions(to)
    if always_is(l, from, target) then return
    if *from is AnyType || *from is Class(_, _, _) || *from is Tuple(_) || *from is Data(_, _, _) || *from is Function(_, _, _)
        if value is Some(v)
            val object = if pointer_option(l, from) then option_object(l, from, v) else v
            continue_if(l, type_test(l, object, target), fail)
    else continue_if(l, ConstBool(false), fail)

// A pattern on a union value: each part is tried in turn, on the member its type names, taken out
// of the `Any` the union is laid out as. Where the instance being lowered made the union one of its
// members, the value is that member already.
private test_union(l: *Lowering, p: &TPattern, parts: Buf[&TPattern], value: Option[Operand], fail: usize)
    val from = concrete(l, p.ty)
    val matched = new_block(l)
    for part in parts
        val next = new_block(l)
        val member = written_concrete(l, part.ty)
        val to = concrete(l, part.ty)
        var v = value
        member_test(l, from, member, value, next)
        if *from is AnyType && !(*to is AnyType)
            if value is Some(x) then v = unbox(l, to, x)
        test_pattern(l, part, v, next)
        finish(l, Jump(matched))
        l.current = next
    finish(l, Jump(fail))
    l.current = matched

// Tests `value` against a pattern, binding its names, and continues where it matched; a failed
// test goes to `fail`. A unit value has no runtime value, and every unit pattern matches it.
private test_pattern(l: *Lowering, p: &TPattern, value: Option[Operand], fail: usize)
    p.kind match
        PWildcard -> ()
        PBind(local) -> bind_local(l, local, value)
        PNamed(local, inner) ->
            test_pattern(l, inner, value, fail)
            bind_local(l, local, value)
        PLiteral(constant) ->
            if value is Some(v)
                if lower_expr(l, constant) is Some(k) then continue_if(l, compare_values(l, Equal, p.ty, v, k), fail)
        PBounds(local, lower, upper) ->
            if value is Some(v)
                if lower is Some(b)
                    if lower_expr(l, b.value) is Some(low) then continue_if(l, compare_values(l, if b.inclusive then GreaterEqual else Greater, p.ty, v, low), fail)
                if upper is Some(b)
                    if lower_expr(l, b.value) is Some(high) then continue_if(l, compare_values(l, if b.inclusive then LessEqual else Less, p.ty, v, high), fail)
            if local is Some(index) then bind_local(l, index, value)
        PSuccessor(local, amount) ->
            if value is Some(v)
                if lower_expr(l, amount) is Some(k)
                    continue_if(l, compare(l, compare_op(GreaterEqual, p.ty), v, k), fail)
                    // The value is at least the positive amount, so the difference cannot overflow.
                    if local is Some(index) then bind_local(l, index, Some(binary(l, MInt(int_bits(p.ty)), OpSub, v, k)))
        PAlternatives(options) ->
            val matched = new_block(l)
            for i in 0..<options.len()
                val last = i + 1 == options.len()
                val next = if last then fail else new_block(l)
                test_pattern(l, options[i], value, next)
                finish(l, Jump(matched))
                l.current = next
            l.current = matched
        PType(target, local, tested) ->
            val from = concrete(l, p.ty)
            // A union matches where one of its members does, and binds the value as the union, laid
            // out as an `Any`.
            if *written_concrete(l, target) is Union(_)
                if tested then member_test(l, from, written_concrete(l, target), value, fail)
                if local is Some(x) then bind_local(l, x, if *from is AnyType then value else box_value(l, from, value))
                return
            val to = concrete(l, target)
            var bound = value
            // An option kept as a pointer is the same pointer as any option it is seen as; seen as
            // anything else, or tested as an object, it is the object it stands for.
            val pointer = pointer_option(l, from)
            if always_is(l, from, to)
                if (*to is AnyType && !(*from is AnyType)) || (pointer && !pointer_option(l, to)) then bound = box_value(l, from, value)
            elif *from is AnyType || *from is Class(_, _, _) || *from is Tuple(_) || *from is Data(_, _, _) || *from is Function(_, _, _)
                // An object whose type is a subtype of its static type: its descriptor's record says.
                if value is Some(v)
                    val object = if pointer then option_object(l, from, v) else v
                    continue_if(l, type_test(l, object, to), fail)
                    bound = unbox(l, to, object)
            else
                // A value that is neither `Any` nor an object of a class has exactly its static
                // type, which a copy of generic code may find is not `to`.
                continue_if(l, ConstBool(false), fail)
                bound = None
            if local is Some(x) then bind_local(l, x, bound)
        PSequence(local, test, elements, items, _) ->
            bind_local(l, local, value)
            if lower_expr(l, test) is Some(ok) then continue_if(l, ok, fail)
            for i in 0..<items.len()
                if items[i].kind is PWildcard then continue
                test_pattern(l, items[i], lower_expr(l, elements[i]), fail)
        PView(local, view, inner) ->
            bind_local(l, local, value)
            test_pattern(l, inner, lower_expr(l, view), fail)
        PUnion(parts) -> test_union(l, p, parts, value, fail)
        PVariant(variant, fields) ->
            if value is Some(v)
                // An option kept as a pointer is `None` where it is null, and otherwise the `Some`
                // whose value it is.
                if pointer_option(l, p.ty)
                    val some = variant == some_variant(l)
                    continue_if(l, compare(l, if some then CmpNe else CmpEq, v, NullAddress), fail)
                    if some && fields.len() == 1 && !(fields[0].kind is PWildcard) then test_pattern(l, fields[0], Some(v), fail)
                    return
                val shape = layout(l, concrete(l, p.ty))
                // A type with one variant needs no test; otherwise the tag is in the descriptor.
                if shape.variants.len() > 1
                    val descriptor = fresh(l, MPtr)
                    l.insts.push(DescriptorOf(descriptor, v))
                    val tag_address = fresh(l, MPtr)
                    l.insts.push(Offset(tag_address, Value(descriptor), DescriptorTag))
                    val tag = fresh(l, MInt(64))
                    l.insts.push(Load(tag, Value(tag_address)))
                    continue_if(l, compare(l, CmpEq, Value(tag), ConstInt(64, variant.to_string())), fail)
                val places = shape.variants[variant].fields
                for i in 0..<fields.len()
                    val sub = fields[i]
                    if sub.kind is PWildcard then continue
                    val field = if places[i] is Some(place) then Some(load_field(l, v, place)) else None
                    test_pattern(l, sub, field, fail)

// Operators and equality. An operator is a core trait's method (`+` is `Add`'s `add`, `<` is `Ord`'s
// `less`), and every instance knows its operands' types: on a built-in type the operator is the
// machine's operation, generic code included, and on a data type or a class it is a direct call of
// the type's implementation, or a call through the method table where the type is a trait or an
// open class.
//
// `==` and the hash are every type's. A type that implements `Eq` and `Hash` uses its own; otherwise
// a built-in value compares by value, a string by its bytes, a tuple and a data value field by field
// through a function made for its type, and an object or a closure by identity. Values of `Any`, of a
// trait type or of an open class compare by their types at run time: unequal when their type records
// differ, and otherwise through the record's equality entries, made for every record once a program
// compares such values.

/** The kinds of `Instance.generated`: a function of the program, or one lowering makes. */
private const Written: u8 = 0
/** `==` on two values of a tuple or data type, field by field. */
private const StructuralEquals: u8 = 1
/** The hash of a tuple or data value, from its fields'. */
private const StructuralHash: u8 = 2
/** A type record's `equals` entry: two objects of the type, compared as that type. */
private const RecordEquals: u8 = 3
/** A type record's `hash` entry. */
private const RecordHash: u8 = 4
/** `==` on two values of unknown type, through their records. */
private const AnyEquals: u8 = 5
/** The hash of a value of unknown type, through its record. */
private const AnyHash: u8 = 6
/** A method table's entry for an option kept as a pointer: see `table_entry`. */
private const OptionAdapter: u8 = 7
/** The function a C trampoline runs, converting what C calls an Avin function with: see
 * `c_callback_body`. */
private const CCallbackBody: u8 = 12
/** A type record's `display` entry: an object of the type rendered by its `Display`, or by name. */
private const RecordDisplay: u8 = 8
/** A type record's `debug` entry: the same through `Debug`. */
private const RecordDebug: u8 = 9
/** `display` on a value of unknown type, through its record. */
private const AnyDisplay: u8 = 10
/** `debug` on a value of unknown type, through its record. */
private const AnyDebug: u8 = 11

/** Where a type record's entries are: after the ancestor count, `equals`, `hash`, `display` and
 * `debug`. */
private const RecordEqualsEntry: usize = 8
private const RecordHashEntry: usize = 16
private const RecordDisplayEntry: usize = 24
private const RecordDebugEntry: usize = 32

/** Whether `t` is a built-in type whose operators are machine operations. */
private is_machine_scalar(t: &Type) -> bool = *t match
    Int(_) -> true
    Byte -> true
    Char -> true
    Real -> true
    Bool -> true
    Str -> true
    _ -> false

/** Whether a value of type `t` may be of any of several types at run time, so its operators and its
 * equality are decided by the object: `Any`, a trait, an open or abstract class, and a trait's `Self`
 * in the trait's shared default bodies. */
private decided_at_run_time(l: *Lowering, t: &Type) -> bool = *t match
    AnyType -> true
    Union(_) -> true
    TypeVar(owner, _, _) -> is_self_owner(owner)
    Class(k, _, _) -> l.program.classes[k].decl.modifier != ""
    _ -> false

/** Whether `m` is a core trait method that an operator or `==` is written with, or the hash. */
private is_operator_method(l: *Lowering, m: usize) -> bool
    val name = l.program.symbols[m].decl.name
    if !l.program.core.is(m, name) then return false
    name == "equals" || name == "hash" || method_compare_op(name) is Some(_) || method_binary_op(name) is Some(_) || name == "negate"

private method_compare_op(name: string) -> Option[CompareOp]
    if name == "less" then return Some(Less)
    if name == "lessOrEqual" then return Some(LessEqual)
    if name == "greater" then return Some(Greater)
    if name == "greaterOrEqual" then return Some(GreaterEqual)
    None

private method_binary_op(name: string) -> Option[BinaryOp]
    if name == "add" then return Some(Add)
    if name == "subtract" then return Some(Subtract)
    if name == "multiply" then return Some(Multiply)
    if name == "divide" then return Some(Divide)
    if name == "remainder" then return Some(Remainder)
    None

/** The position of the core trait method `m` in the method table of every type conforming to its
 * trait. */
private core_position(l: *Lowering, m: usize) -> usize
    val k = l.program.symbols[m].owner_class.unwrap()
    val methods = l.program.classes[k].methods
    for j in 0..<methods.len()
        if methods[j] == m then return l.program.classes[k].base + j
    0

// A call of a core trait method through a bound, or of `equals` or `hash` on any value: the
// receiver's type in this instance decides what it is.
private core_call(l: *Lowering, e: &TExpr, function: usize, args: Buf[&TExpr]) -> Option[Operand]
    var ops: Buf[Operand] = buf()
    var values: Buf[Operand] = buf()
    for a in args
        val v = lower_expr(l, a)
        // An argument that never finishes ends the code here: the call is never made.
        if *a.ty is Nothing then return None
        v match
            Some(x) ->
                ops.push(x)
                values.push(x)
            None ->
                if machine(l, a.ty) is Some(_) then return None
                ops.push(ConstBool(false))
    val t = concrete(l, args[0].ty)
    val name = l.program.symbols[function].decl.name
    if name == "equals" then return Some(equals_values(l, t, ops[0], ops[1]))
    if name == "hash" then return Some(hash_value(l, t, ops[0]))
    if is_machine_scalar(t)
        if name == "negate" then return Some(negate_value(l, t, ops[0], e.span))
        if method_compare_op(name) is Some(op) then return Some(compare_values(l, op, t, ops[0], ops[1]))
        if method_binary_op(name) is Some(op) then return Some(scalar_arith(l, t, op, ops[0], ops[1], e.span))
    operator_values(l, t, name, values, machine(l, e.ty))

/** The core trait method `name` called on `args`, the receiver first, whose type `t` is not a
 * built-in scalar. */
private operator_call(l: *Lowering, t: &Type, name: string, args: []Operand, result: Option[MirType]) -> Option[Operand]
    var values: Buf[Operand] = buf()
    for a in args do values.push(a)
    operator_values(l, t, name, values, result)

private operator_values(l: *Lowering, t: &Type, name: string, values: Buf[Operand], result: Option[MirType]) -> Option[Operand]
    val m = l.program.core.method_named(name).unwrap()
    if decided_at_run_time(l, t) then return dispatch_operands(l, core_position(l, m), name, values, result)
    explicit_implementation(l, t, m) match
        Some(index) ->
            // A trait's default body takes its `Self` as an object, so an option kept as a pointer
            // goes in as the object it stands for.
            if pointer_option(l, t) && implemented_by_trait(l, t, m)
                for i in 0..<values.len() do values[i] = option_object(l, t, values[i])
            call_instance(l, index, values, result)
        None ->
            // An instance the checker never lets run: a conditional impl's method at type
            // arguments that do not meet its bounds.
            leave(l, Unreachable)
            None

/** Whether the method table of `t` holds a trait's default body at `m`'s position. */
private implemented_by_trait(l: *Lowering, t: &Type, m: usize) -> bool
    val entries = checker_table(l, t)
    val position = core_position(l, m)
    if position >= entries.len() then return false
    entries[position] match
        Some(x) -> is_trait_method(l, l.program.symbols[x])
        None -> false

/** The instance implementing core trait method `m` for the data type or class `t`: what its method
 * table holds at `m`'s position, its own method or a trait's default body; `None` where it leaves
 * the trait's method abstract. */
private explicit_implementation(l: *Lowering, t: &Type, m: usize) -> Option[usize]
    val position = core_position(l, m)
    val entries = checker_table(l, t)
    if position >= entries.len() then return None
    val x = entries[position]?
    val symbol = l.program.symbols[x]
    if is_abstract_method(symbol) || symbol.decl.name != l.program.symbols[m].decl.name then return None
    Some(instance(l, x, implementation_args(l, t, x)))

private call_instance(l: *Lowering, index: usize, operands: Buf[Operand], result: Option[MirType]) -> Option[Operand]
    val dest = result match
        Some(t) -> Some(fresh(l, t))
        None -> None
    push_call(l, dest, Direct(index), operands)
    dest match
        Some(id) -> Some(Value(id))
        None -> None

/** A call of the method `name` at `position` of the method table of `operands[0]`'s object, which
 * may be of any type. */
private dispatch_operands(l: *Lowering, position: usize, name: string, operands: Buf[Operand], result: Option[MirType]) -> Option[Operand]
    var params: Buf[MirType] = buf()
    for o in operands
        params.push(operand_type(l, o))
    use_slot(l, position, name, AnyType)
    val code = fresh(l, MPtr)
    l.insts.push(MethodSlot(code, operands[0], position))
    val dest = result match
        Some(t) -> Some(fresh(l, t))
        None -> None
    push_call(l, dest, Indirect(Value(code), MirSignature(params, result)), operands)
    dest match
        Some(id) -> Some(Value(id))
        None -> None

private operand_type(l: *Lowering, o: Operand) -> MirType = o match
    Value(id) -> l.values[id]
    ConstInt(bits, _) -> MInt(bits)
    ConstBool(_) -> MBool
    ConstReal(_) -> MReal
    ConstStr(_) -> MRef
    ConstObject(_) -> MRef
    ConstData(_, _) -> MRef
    ConstClosure(_) -> MRef
    _ -> MPtr

private two(a: Operand, b: Operand) -> Buf[Operand]
    var out: Buf[Operand] = buf()
    out.push(a)
    out.push(b)
    out

private one(a: Operand) -> Buf[Operand]
    var out: Buf[Operand] = buf()
    out.push(a)
    out

/** `a == b` for two values of type `t`. */
private equals_values(l: *Lowering, t: &Type, a: Operand, b: Operand) -> Operand = *t match
    Unit -> ConstBool(true)
    Bool -> compare(l, CmpEq, a, b)
    Int(_) -> compare(l, CmpEq, a, b)
    Byte -> compare(l, CmpEq, a, b)
    Char -> compare(l, CmpEq, a, b)
    Real -> compare(l, FEq, a, b)
    Str -> compare_values(l, Equal, t, a, b)
    Function(_, _, _) -> compare(l, CmpEq, a, b)
    ByName(_) -> compare(l, CmpEq, a, b)
    _ ->
        if is_abstract_or_trait(l, t) && seq_element(l, t) is Some(e) then call_instance(l, library_instance(l, "seqEquals", e), two(a, b), Some(MBool)).unwrap()
        elif decided_at_run_time(l, t) then call_instance(l, generated(l, AnyEquals, AnyType), two(a, b), Some(MBool)).unwrap()
        else own_equals(l, t, a, b)

/** `a == b` for two values whose type is exactly `t`, a class, data or tuple type: the type's own
 * `equals`, or by elements for a sequence, or field by field, or by identity. */
private own_equals(l: *Lowering, t: &Type, a: Operand, b: Operand) -> Operand
    if *t is Class(_, _, _) || *t is Data(_, _, _)
        if l.program.core.method_named("equals") is Some(eq)
            if explicit_implementation(l, t, eq) is Some(i) then return call_instance(l, i, two(a, b), Some(MBool)).unwrap()
        if seq_element(l, t) is Some(e) then return call_instance(l, library_instance(l, "seqEquals", e), two(a, b), Some(MBool)).unwrap()
    *t match
        Data(_, _, _) -> call_instance(l, generated(l, StructuralEquals, t), two(a, b), Some(MBool)).unwrap()
        Tuple(_) -> call_instance(l, generated(l, StructuralEquals, t), two(a, b), Some(MBool)).unwrap()
        _ -> compare(l, CmpEq, a, b)

/** The hash of a value of type `t`, a `long`; equal values hash alike. */
private hash_value(l: *Lowering, t: &Type, a: Operand) -> Operand = *t match
    Unit -> ConstInt(64, "0")
    Bool -> select(l, MInt(64), a, ConstInt(64, "1"), ConstInt(64, "0"))
    Int(bits) -> resize(l, a, bits, 64, true)
    Byte -> resize(l, a, 8, 64, false)
    Char -> resize(l, a, 32, 64, false)
    Real -> runtime_call(l, "avin_rt_real_hash", [MReal], MInt(64), [a])
    Str -> runtime_call(l, "avin_rt_string_hash", [MRef], MInt(64), [a])
    Function(_, _, _) -> runtime_call(l, "avin_rt_identity_hash", [MRef], MInt(64), [a])
    ByName(_) -> runtime_call(l, "avin_rt_identity_hash", [MRef], MInt(64), [a])
    _ ->
        if is_abstract_or_trait(l, t) && seq_element(l, t) is Some(e) then call_instance(l, library_instance(l, "seqHash", e), one(a), Some(MInt(64))).unwrap()
        elif decided_at_run_time(l, t) then call_instance(l, generated(l, AnyHash, AnyType), one(a), Some(MInt(64))).unwrap()
        else own_hash(l, t, a)

/** The hash of a value whose type is exactly `t`, a class, data or tuple type. */
private own_hash(l: *Lowering, t: &Type, a: Operand) -> Operand
    if *t is Class(_, _, _) || *t is Data(_, _, _)
        if l.program.core.method_named("hash") is Some(h)
            if explicit_implementation(l, t, h) is Some(i) then return call_instance(l, i, one(a), Some(MInt(64))).unwrap()
        if seq_element(l, t) is Some(e) then return call_instance(l, library_instance(l, "seqHash", e), one(a), Some(MInt(64))).unwrap()
    *t match
        Data(_, _, _) -> call_instance(l, generated(l, StructuralHash, t), one(a), Some(MInt(64))).unwrap()
        Tuple(_) -> call_instance(l, generated(l, StructuralHash, t), one(a), Some(MInt(64))).unwrap()
        _ -> runtime_call(l, "avin_rt_identity_hash", [MRef], MInt(64), [a])

/** Gives every type record that some object has as its own type equality entries; whether it made
 * any. A trait's record and an abstract class's belong to no object, nor does a record only tested
 * against or listed among another's ancestors or parts. Record 0, of captured variables' boxes, and
 * a function type's record, of closures, compare by identity. */
private add_equality_entries(l: *Lowering) -> bool
    var added = false
    var r = 0usize
    while r < l.records.len()
        val record = l.records[r]
        val t: &Type = if r == 0 then Function(buf(), Unit, false) else l.record_types[r]
        var owned = record.equals is None && l.object_records[r]
        if *t is Class(k, _, _)
            if l.program.classes[k].decl.modifier == "trait" || l.program.classes[k].decl.modifier == "abstract" then owned = false
        if owned
            val equals = generated(l, RecordEquals, t)
            val hash = generated(l, RecordHash, t)
            l.records[r] = TypeRecord(record.name, l.records[r].ancestors, Some(equals), Some(hash), l.records[r].display, l.records[r].debug, l.records[r].apart, l.records[r].parts, l.records[r].part_view)
            added = true
        r += 1
    added

/** Gives every type record that some object has as its own type rendering entries; whether it made
 * any. */
private add_rendering_entries(l: *Lowering) -> bool
    // Each entry is made only where the program reads it: `display` once it shows such a value, and
    // `debug` once it debugs one.
    val displays = l.instance_index.get(s"generated $AnyDisplay|${type_key(AnyType)}") is Some(_)
    val debugs = l.instance_index.get(s"generated $AnyDebug|${type_key(AnyType)}") is Some(_)
    var added = false
    var r = 0usize
    while r < l.records.len()
        val record = l.records[r]
        val t: &Type = if r == 0 then Function(buf(), Unit, false) else l.record_types[r]
        var owned = l.object_records[r]
        if *t is Class(k, _, _)
            if l.program.classes[k].decl.modifier == "trait" || l.program.classes[k].decl.modifier == "abstract" then owned = false
        if owned
            var display = record.display
            var debug = record.debug
            if displays && display is None then display = Some(generated(l, RecordDisplay, t))
            if debugs && debug is None then debug = Some(generated(l, RecordDebug, t))
            if !same_entry(display, record.display) || !same_entry(debug, record.debug)
                l.records[r] = TypeRecord(record.name, l.records[r].ancestors, l.records[r].equals, l.records[r].hash, display, debug, record.apart, l.records[r].parts, l.records[r].part_view)
                added = true
        r += 1
    added

private same_entry(a: Option[usize], b: Option[usize]) -> bool = a match
    Some(x) -> b match
        Some(y) -> x == y
        None -> false
    None -> b is None

// `display`, `debug` or `toString` called through a table on a receiver of static type `receiver`.
// On `Any`, or on a trait that does not require the method's trait, the object's own type may have
// no `Display` or `Debug`, so the call goes through the rendering entries of its type's record.
// `None` where the table answers; otherwise the call's result.
private rendering_call(l: *Lowering, function: usize, receiver: &Type, operands: Buf[Operand]) -> Option[Option[Operand]]
    val core = l.program.core
    val shown = core.is(function, "display") || core.is(function, "toString")
    if !shown && !core.is(function, "debug") then return None
    if !rendered_at_run_time(l.program.classes, receiver) then return None
    if *receiver is Class(_, _, _)
        val k = l.program.symbols[function].owner_class?
        if holding_ancestor(lowering_conformances(l), receiver, k) is Some(_) then return None
    if core.is(function, "display") then return Some(call_instance(l, generated(l, AnyDisplay, AnyType), operands, None))
    if core.is(function, "debug") then return Some(call_instance(l, generated(l, AnyDebug, AnyType), operands, None))
    Some(call_instance(l, library_instance(l, "displayString", AnyType), one(operands[0]), machine(l, Str)))

/** The machine types of a rendering method's parameters: the object, the writer and the spec. */
private rendering_params(l: *Lowering, name: string) -> Buf[MirType]
    var params: Buf[MirType] = buf()
    params.push(MRef)
    val symbol = l.program.symbols[l.program.core.method_named(name).unwrap()]
    for p in 1..<symbol.params.len()
        if machine(l, symbol.params[p]) is Some(m) then params.push(m)
    params

// `display` or `debug`, named `name`, on an object of unknown type: its record's entry renders it.
private any_rendering(l: *Lowering, name: string, entry: usize) -> MirFunction
    val params = rendering_params(l, name)
    var operands: Buf[Operand] = buf()
    for m in params
        operands.push(Value(fresh(l, m)))
    val code = record_entry(l, object_record(l, operands[0]), entry)
    push_call(l, None, Indirect(code, MirSignature(params, None)), operands)
    finish(l, Return(None))
    MirFunction(s"avin.any.$name", MirSignature(params, None), l.values, l.slots, l.blocks)

// A record's `display` or `debug` entry for type `t`: the object rendered by the type's own
// implementation of the trait that declares `name`, or, where the type has none, as the type's name.
private record_rendering(l: *Lowering, t: &Type, name: string) -> MirFunction
    val params = rendering_params(l, name)
    var operands: Buf[Operand] = buf()
    for m in params
        operands.push(Value(fresh(l, m)))
    val m = l.program.core.method_named(name).unwrap()
    own_rendering(l, t, m) match
        Some(index) ->
            var args: Buf[Operand] = buf()
            if unbox(l, t, operands[0]) is Some(x) then args.push(x)
            for i in 1..<operands.len()
                args.push(operands[i])
            call_instance(l, index, args, None)
        None ->
            val shown = if *t is Function(_, _, _) then "<function>" else type_name(t)
            var args: Buf[Operand] = buf()
            args.push(string_constant(l, shown))
            for i in 1..<operands.len()
                args.push(operands[i])
            call_instance(l, library_function(l, "renderTypeName"), args, None)
    finish(l, Return(None))
    MirFunction(s"avin.record.$name.${stable_type_key(l.program, t)}",MirSignature(params, None), l.values, l.slots, l.blocks)

/** The instance of type `t`'s own implementation of the rendering method `m`, where `t` conforms to
 * the trait declaring it. */
private own_rendering(l: *Lowering, t: &Type, m: usize) -> Option[usize]
    if !(*t is Class(_, _, _) || *t is Data(_, _, _) || *t is Tuple(_) || is_builtin(t)) then return None
    val k = l.program.symbols[m].owner_class?
    if !meets_bound(lowering_conformances(l), t, Class(k, l.program.classes[k].decl.name, buf())) then return None
    explicit_implementation(l, t, m)

// The body of a function lowering makes, which no source declares; see `Instance.generated`.
private lower_generated(l: *Lowering, inst: Instance) -> MirFunction
    l.subst = buf()
    l.subst_owner = 0
    l.values = buf()
    l.slots = buf()
    l.blocks = buf()
    l.insts = buf()
    l.loops = buf()
    l.unit = 0
    l.trap_blocks = map()
    l.library = true
    l.locals = buf()
    l.boxed = buf()
    l.local_slots = buf()
    l.param_values = buf()
    l.returns_value = true
    l.current = new_block(l)
    if inst.generated == OptionAdapter then return lower_adapter(l, inst)
    if inst.generated == CCallbackBody then return c_callback_body(l, l.function_index)
    val t = inst.type_args[0]
    val key = stable_type_key(l.program, t)
    val kind = inst.generated
    if kind == StructuralEquals
        val m = mir_type(t).unwrap()
        val a = Value(fresh(l, m))
        val b = Value(fresh(l, m))
        structural_equals(l, t, a, b)
        return MirFunction("avin.equals." + key, MirSignature(pair(m), Some(MBool)), l.values, l.slots, l.blocks)
    if kind == StructuralHash
        val m = mir_type(t).unwrap()
        val a = Value(fresh(l, m))
        structural_hash(l, t, a)
        return MirFunction("avin.hash." + key, MirSignature(single(m), Some(MInt(64))), l.values, l.slots, l.blocks)
    if kind == RecordEquals
        val a = Value(fresh(l, MRef))
        val b = Value(fresh(l, MRef))
        val x = unbox(l, t, a).unwrap_or(ConstBool(false))
        val y = unbox(l, t, b).unwrap_or(ConstBool(false))
        val same = if *t is Class(_, _, _) || *t is Data(_, _, _) || *t is Tuple(_) then own_equals(l, t, x, y) else equals_values(l, t, x, y)
        finish(l, Return(Some(same)))
        return MirFunction("avin.record.equals." + key, MirSignature(pair(MRef), Some(MBool)), l.values, l.slots, l.blocks)
    if kind == RecordHash
        val a = Value(fresh(l, MRef))
        val x = unbox(l, t, a).unwrap_or(ConstBool(false))
        val h = if *t is Class(_, _, _) || *t is Data(_, _, _) || *t is Tuple(_) then own_hash(l, t, x) else hash_value(l, t, x)
        finish(l, Return(Some(h)))
        return MirFunction("avin.record.hash." + key, MirSignature(single(MRef), Some(MInt(64))), l.values, l.slots, l.blocks)
    if kind == RecordDisplay then return record_rendering(l, t, "display")
    if kind == RecordDebug then return record_rendering(l, t, "debug")
    if kind == AnyDisplay then return any_rendering(l, "display", RecordDisplayEntry)
    if kind == AnyDebug then return any_rendering(l, "debug", RecordDebugEntry)
    if kind == AnyEquals
        val a = Value(fresh(l, MRef))
        val b = Value(fresh(l, MRef))
        any_equals(l, a, b)
        return MirFunction("avin.any.equals", MirSignature(pair(MRef), Some(MBool)), l.values, l.slots, l.blocks)
    val a = Value(fresh(l, MRef))
    any_hash(l, a)
    MirFunction("avin.any.hash", MirSignature(single(MRef), Some(MInt(64))), l.values, l.slots, l.blocks)

// A method table's entry for an option kept as a pointer: each parameter its trait's method takes as
// `Self` arrives as the object the option stands for and is passed on as the pointer, and a `Self`
// result goes back as an object.
// A boxed built-in value's entry takes the box where the method takes the value, reads the value
// out, and boxes a `Self` result; an option kept as a pointer's converts between the object and the
// pointer the same way.
private lower_adapter(l: *Lowering, inst: Instance) -> MirFunction
    val shape = l.adapters.get(l.function_index).unwrap()
    val symbol = l.program.symbols[inst.function]
    l.subst = inst.type_args
    l.subst_owner = symbol.type_owner
    val boxed = value_boxed(l, shape.option)
    val signature = signature_of(l, l.program.functions[inst.function])
    var params: Buf[MirType] = buf()
    var given: Buf[Option[Operand]] = buf()
    for p in 0..<symbol.params.len()
        val m = if boxed && shape.selfs[p] then Some(MRef) else param_machine(l, symbol, p)
        given.push(m match
            Some(m) ->
                params.push(m)
                Some(Value(fresh(l, m)))
            None -> None)
    var operands: Buf[Operand] = buf()
    for p in 0..<given.len()
        if !shape.selfs[p]
            if given[p] is Some(v) then operands.push(v)
        elif boxed
            if unbox(l, shape.option, given[p].unwrap()) is Some(v) then operands.push(v)
        elif given[p] is Some(v) then operands.push(option_pointer(l, shape.option, v))
    val dest = signature.result match
        Some(m) -> Some(fresh(l, m))
        None -> None
    push_call(l, dest, Direct(instance(l, inst.function, inst.type_args)), operands)
    var result = dest match
        Some(d) -> Some(Value(d))
        None -> None
    if shape.result
        result = if boxed then box_value(l, shape.option, result) else Some(option_object(l, shape.option, result.unwrap()))
    var returned = signature.result
    if boxed && shape.result then returned = Some(MRef)
    finish(l, Return(result))
    MirFunction("avin.adapter." + function_symbol(l, inst.function, inst.type_args), MirSignature(params, returned), l.values, l.slots, l.blocks)

private pair(m: MirType) -> Buf[MirType]
    var out: Buf[MirType] = buf()
    out.push(m)
    out.push(m)
    out

private single(m: MirType) -> Buf[MirType]
    var out: Buf[MirType] = buf()
    out.push(m)
    out

/** The field types of variant `v` of a tuple or data type `t`. */
private field_types(l: *Lowering, t: &Type, v: usize) -> Buf[&Type] = *t match
    Tuple(items) -> items
    Data(id, _, args) -> variant_fields(l.program.data[id], id, v, args)
    _ -> buf()

/** The tag of a data value's variant, from its descriptor. */
private variant_tag(l: *Lowering, object: Operand) -> Operand
    val descriptor = fresh(l, MPtr)
    l.insts.push(DescriptorOf(descriptor, object))
    val address = fresh(l, MPtr)
    l.insts.push(Offset(address, Value(descriptor), DescriptorTag))
    val tag = fresh(l, MInt(64))
    l.insts.push(Load(tag, Value(address)))
    Value(tag)

/** Whether a variant has a field with a runtime value. */
private has_field_data(fields: Buf[Option[FieldSlot]]) -> bool
    for f in fields
        if f is Some(_) then return true
    false

// Two values of one tuple or data type are equal when they are of one variant and each field is
// equal; the first difference decides.
private structural_equals(l: *Lowering, t: &Type, a: Operand, b: Operand)
    val unequal = new_block(l)
    l.blocks[unequal].term = Return(Some(ConstBool(false)))
    // Two options kept as pointers: of one variant when both or neither is null, and two `Some`s by
    // their values.
    if pointer_option(l, t)
        val absent = compare(l, CmpEq, a, NullAddress)
        continue_if(l, compare(l, CmpEq, absent, compare(l, CmpEq, b, NullAddress)), unequal)
        val both_none = new_block(l)
        val both_some = new_block(l)
        finish_into(l, Branch(absent, both_none, both_some), both_none)
        finish_into(l, Return(Some(ConstBool(true))), both_some)
        val inner = field_types(l, t, some_variant(l))[0]
        finish(l, Return(Some(equals_values(l, inner, a, b))))
        return
    val shape = layout(l, t)
    if shape.variants.len() == 1
        equal_fields(l, field_types(l, t, 0), shape.variants[0].fields, a, b, unequal)
        finish(l, Return(Some(ConstBool(true))))
        return
    val tag = variant_tag(l, a)
    continue_if(l, compare(l, CmpEq, tag, variant_tag(l, b)), unequal)
    for v in 0..<shape.variants.len()
        val fields = shape.variants[v].fields
        if !has_field_data(fields) then continue
        val body = new_block(l)
        val other = new_block(l)
        finish_into(l, Branch(compare(l, CmpEq, tag, ConstInt(64, v.to_string())), body, other), body)
        equal_fields(l, field_types(l, t, v), fields, a, b, unequal)
        finish(l, Return(Some(ConstBool(true))))
        l.current = other
    finish(l, Return(Some(ConstBool(true))))

private equal_fields(l: *Lowering, types: Buf[&Type], fields: Buf[Option[FieldSlot]], a: Operand, b: Operand, unequal: usize)
    for i in 0..<fields.len()
        if fields[i] is Some(slot)
            val same = equals_values(l, types[i], load_field(l, a, slot), load_field(l, b, slot))
            continue_if(l, same, unequal)

// A tuple's or data value's hash combines its variant's tag with its fields' hashes, in order.
private structural_hash(l: *Lowering, t: &Type, a: Operand)
    // An option kept as a pointer hashes as the object it stands for does: `None` by its tag, and a
    // `Some` by its tag and its value.
    if pointer_option(l, t)
        val none = new_block(l)
        val some = new_block(l)
        finish_into(l, Branch(compare(l, CmpEq, a, NullAddress), none, some), none)
        finish_into(l, Return(Some(ConstInt(64, none_variant(l).to_string()))), some)
        val inner = field_types(l, t, some_variant(l))[0]
        val start = binary(l, MInt(64), OpMul, ConstInt(64, some_variant(l).to_string()), ConstInt(64, "31"))
        finish(l, Return(Some(binary(l, MInt(64), OpAdd, start, hash_value(l, inner, a)))))
        return
    val shape = layout(l, t)
    if shape.variants.len() == 1
        finish(l, Return(Some(hash_fields(l, field_types(l, t, 0), shape.variants[0].fields, a, ConstInt(64, "0")))))
        return
    val tag = variant_tag(l, a)
    for v in 0..<shape.variants.len()
        val fields = shape.variants[v].fields
        if !has_field_data(fields) then continue
        val body = new_block(l)
        val other = new_block(l)
        finish_into(l, Branch(compare(l, CmpEq, tag, ConstInt(64, v.to_string())), body, other), body)
        finish(l, Return(Some(hash_fields(l, field_types(l, t, v), fields, a, tag))))
        l.current = other
    finish(l, Return(Some(tag)))

private hash_fields(l: *Lowering, types: Buf[&Type], fields: Buf[Option[FieldSlot]], a: Operand, start: Operand) -> Operand
    var h = start
    for i in 0..<fields.len()
        if fields[i] is Some(slot)
            val part = hash_value(l, types[i], load_field(l, a, slot))
            h = binary(l, MInt(64), OpAdd, binary(l, MInt(64), OpMul, h, ConstInt(64, "31")), part)
    h

/** The type record of an object, from its descriptor; null for a string. */
private object_record(l: *Lowering, object: Operand) -> Operand
    val descriptor = fresh(l, MPtr)
    l.insts.push(DescriptorOf(descriptor, object))
    val address = fresh(l, MPtr)
    l.insts.push(Offset(address, Value(descriptor), DescriptorRecord))
    val record = fresh(l, MPtr)
    l.insts.push(Load(record, Value(address)))
    Value(record)

/** The record's entry at `offset`, a function's address. */
private record_entry(l: *Lowering, record: Operand, offset: usize) -> Operand
    val address = fresh(l, MPtr)
    l.insts.push(Offset(address, record, offset))
    val code = fresh(l, MPtr)
    l.insts.push(Load(code, Value(address)))
    Value(code)

// Two values of unknown type are equal when they have one type, by that type's own equality: two
// strings by their bytes, any other type through its record's `equals` entry. Two values of different
// types are equal only as collections of one shape with equal contents: sequences, maps or sets.
private any_equals(l: *Lowering, a: Operand, b: Operand)
    val unequal = new_block(l)
    val record = object_record(l, a)
    continue_if(l, compare(l, CmpEq, record, object_record(l, b)), unequal)
    val matched = l.current
    l.current = unequal
    val by_elements = call_instance(l, library_function(l, "anyCollectionEquals"), two(a, b), Some(MBool)).unwrap()
    finish(l, Return(Some(by_elements)))
    l.current = matched
    val strings = new_block(l)
    val others = new_block(l)
    finish_into(l, Branch(compare(l, CmpEq, record, RecordAddress(record_of(l, Str))), strings, others), strings)
    finish(l, Return(Some(compare_values(l, Equal, Str, a, b))))
    l.current = others
    val code = record_entry(l, record, RecordEqualsEntry)
    val dest = fresh(l, MBool)
    push_call(l, Some(dest), Indirect(code, MirSignature(pair(MRef), Some(MBool))), two(a, b))
    finish(l, Return(Some(Value(dest))))

private any_hash(l: *Lowering, a: Operand)
    val record = object_record(l, a)
    val strings = new_block(l)
    val others = new_block(l)
    finish_into(l, Branch(compare(l, CmpEq, record, RecordAddress(record_of(l, Str))), strings, others), strings)
    finish(l, Return(Some(runtime_call(l, "avin_rt_string_hash", [MRef], MInt(64), [a]))))
    l.current = others
    val code = record_entry(l, record, RecordHashEntry)
    val dest = fresh(l, MInt(64))
    push_call(l, Some(dest), Indirect(code, MirSignature(single(MRef), Some(MInt(64)))), one(a))
    finish(l, Return(Some(Value(dest))))
