module dev.avinlang.compiler

import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}

/** The machine type of a semantic type, or `None` for a type with no runtime representation. */
mir_type(t: &Type) -> Option[MirType] = *t match
    Unit -> None
    Nothing -> None
    Bool -> Some(MBool)
    Str -> Some(MStr)
    Int(bits) -> Some(MInt(bits))
    Byte -> Some(MInt(8))
    Char -> Some(MInt(32))
    Real -> Some(MReal)
    Data(_, _, _) -> Some(MRef)
    _ -> None

/** Where a value is kept: the address of a slot, and the type stored there. */
private struct Place
    address: Operand
    ty: MirType

/** Where `break` and `continue` go for one loop, and the place its value is stored in. */
private struct LoopTarget
    label: usize
    head: usize
    exit: usize
    slot: Option[Place]

/** Where each field of one variant is kept in its object: a byte offset and machine type, or
 * `None` for a field with no runtime value. */
private struct VariantLayout
    descriptor: usize
    fields: Buf[Option[FieldSlot]]

private struct FieldSlot
    offset: usize
    ty: MirType

/** The layout of a data type at particular type arguments: one entry per variant. */
private struct DataLayout
    variants: Buf[VariantLayout]

/** One compiled copy of a function: a generic function has one per list of type arguments it is
 * called with, and a local function of a generic function one per copy of that function. */
private struct Instance
    function: usize
    type_args: Buf[&Type]

private struct Lowering
    program: TProgram
    strings: Buf[string]
    instances: Buf[Instance]
    /** Each instance's index, by its function and type arguments. */
    instance_index: Map[string, usize]
    descriptors: Buf[Descriptor]
    layouts: Buf[DataLayout]
    /** Each layout's index, by the data type it lays out. */
    layout_index: Map[string, usize]
    /** The type arguments of the instance being lowered, and the function they belong to. */
    subst: Buf[&Type]
    subst_owner: usize
    /** The value holding each parameter of the top-level function, or `None` for a unit one or, in
     * a local function, one it does not capture. */
    param_values: Buf[Option[usize]]
    /** Where each local is kept: in this function's own slot, or behind a captured address; `None`
     * for one with no runtime value or that this function does not reach. */
    local_slots: Buf[Option[Place]]
    values: Buf[MirType]
    slots: Buf[MirType]
    blocks: Buf[MirBlock]
    /** The block instructions are being added to, and those instructions. */
    current: usize
    insts: Buf[Inst]
    loops: Buf[LoopTarget]
    /** The function's one trap block, made when first needed. */
    trap: Option[usize]
    returns_value: bool

// Every function that is not generic is compiled once; each generic function is compiled for each
// list of type arguments a compiled call gives it, as those calls are found.
lower_program(program: TProgram) -> MirProgram
    var l = Lowering(program, buf(), buf(), map(), buf(), buf(), map(), buf(), 0, buf(), buf(), buf(), buf(), buf(), 0, buf(), buf(), None, false)
    for i in 0..<program.symbols.len()
        if !is_generic(program, i) then instance(&l, i, buf())
    val entry = instance(&l, program.entry, buf())
    var functions: Buf[MirFunction] = buf()
    var k = 0usize
    while k < l.instances.len()
        functions.push(lower_function(&l, k))
        k += 1
    MirProgram(functions, l.strings, l.descriptors, entry)

// An object is a descriptor word followed by its fields in order, each at a multiple of 8 bytes.
private field_size(t: MirType) -> usize = t match
    MInt(bits) -> usize((bits + 63) / 64) * 8
    MStr -> 16
    _ -> 8

/** The layout of a data type, which must be concrete; made when first asked for. */
private layout(l: *Lowering, t: &Type) -> DataLayout
    val key = type_name(t)
    if l.layout_index.get(key) is Some(index) then return l.layouts[index]
    val (id, args) = *t match
        Data(i, _, a) -> (i, a)
        _ -> panic("a layout of a type that is not data: " + key)
    val d = l.program.data[id]
    var variants: Buf[VariantLayout] = buf()
    for v in 0..<d.variants.len()
        var fields: Buf[Option[FieldSlot]] = buf()
        var refs: Buf[usize] = buf()
        var size = 8usize
        for field in variant_fields(d, id, v, args)
            mir_type(field) match
                Some(m) ->
                    if m is MRef then refs.push(size)
                    fields.push(Some(FieldSlot(size, m)))
                    size += field_size(m)
                None -> fields.push(None)
        variants.push(VariantLayout(l.descriptors.len(), fields))
        l.descriptors.push(Descriptor(key + "." + d.variants[v].name, v, size, refs, size == 8))
    val result = DataLayout(variants)
    l.layout_index.put(key, l.layouts.len())
    l.layouts.push(result)
    result

private field_address(l: *Lowering, object: Operand, field: FieldSlot) -> Operand
    val dest = fresh(l, MPtr)
    l.insts.push(Offset(dest, object, field.offset))
    Value(dest)

// The fields are evaluated in order before the object is allocated, so a collection while
// allocating sees every one of them as a root.
private construct(l: *Lowering, e: &TExpr, variant: usize, args: Buf[&TExpr]) -> Option[Operand]
    var values: Buf[Option[Operand]] = buf()
    for a in args
        val v = lower_expr(l, a)
        if v is None && machine(l, a.ty) is Some(_) then return None
        values.push(v)
    val shape = layout(l, concrete(l, e.ty)).variants[variant]
    if l.descriptors[shape.descriptor].constant then return Some(ConstObject(shape.descriptor))
    val object = fresh(l, MRef)
    l.insts.push(Alloc(object, shape.descriptor))
    for i in 0..<values.len()
        if shape.fields[i] is Some(field)
            if values[i] is Some(v) then l.insts.push(Store(field_address(l, Value(object), field), v))
    Some(Value(object))

/** Reads a field of an object. */
private load_field(l: *Lowering, object: Operand, field: FieldSlot) -> Operand
    val address = field_address(l, object, field)
    val dest = fresh(l, field.ty)
    l.insts.push(Load(dest, address))
    Value(dest)

// A generic function, or a local function of one, whose types depend on type arguments.
private is_generic(program: TProgram, id: usize) -> bool
    val symbol = program.symbols[id]
    val owner = symbol.root.unwrap_or(id)
    program.symbols[owner].decl.type_params.len() > 0

/** The index of the instance of `function` for `type_args`, made when first asked for. */
private instance(l: *Lowering, function: usize, type_args: Buf[&Type]) -> usize
    var key = function.to_string()
    for t in type_args
        key = key + "|" + type_name(t)
    if l.instance_index.get(key) is Some(index) then return index
    val index = l.instances.len()
    l.instances.push(Instance(function, type_args))
    l.instance_index.put(key, index)
    index

/** A type of the code being lowered, with the instance's type arguments substituted. */
private concrete(l: *Lowering, t: &Type) -> &Type = substitute(solve(l.program.vars, t), l.subst_owner, l.subst)

private machine(l: *Lowering, t: &Type) -> Option[MirType] = mir_type(concrete(l, t))

// A local function takes its declared parameters, then the address of each local it captures,
// then the value of each top-level parameter it captures.
private signature_of(l: *Lowering, f: TFunction) -> MirSignature
    val program = l.program
    val symbol = program.symbols[f.symbol]
    var params: Buf[MirType] = buf()
    for p in symbol.params
        if machine(l, p) is Some(t) then params.push(t)
    for x in symbol.captured_locals
        if machine(l, f.locals[x].ty) is Some(_) then params.push(MPtr)
    if symbol.root is Some(root)
        for x in symbol.captured_params
            if machine(l, program.symbols[root].params[x]) is Some(t) then params.push(t)
    MirSignature(params, machine(l, symbol.result.unwrap_or(Unit)))

/** The symbol a function has in the object file: its module path and name. A file with no module
 * header is in `<program>`, which no module path can spell; a local function is named within its
 * top-level function and numbered, since two blocks may each declare one with the same name.
 * Quoted in LLVM, so any text is valid. */
function_symbol(program: TProgram, id: usize, type_args: Buf[&Type]) -> string
    val symbol = program.symbols[id]
    val prefix = if symbol.module_name == "" then "<program>" else symbol.module_name
    var arguments = ""
    if type_args.len() > 0
        arguments = "["
        for i in 0..<type_args.len()
            if i > 0 then arguments = arguments + ", "
            arguments = arguments + type_name(type_args[i])
        arguments = arguments + "]"
    symbol.root match
        Some(root) -> s"$prefix.${program.symbols[root].name}$arguments.${symbol.name}#$id"
        None -> prefix + "." + symbol.name + arguments

private lower_function(l: *Lowering, k: usize) -> MirFunction
    val inst = l.instances[k]
    val f = l.program.functions[inst.function]
    val symbol = l.program.symbols[f.symbol]
    l.subst = inst.type_args
    l.subst_owner = symbol.root.unwrap_or(inst.function)
    val signature = signature_of(l, f)
    l.values = buf()
    l.slots = buf()
    l.blocks = buf()
    l.insts = buf()
    l.loops = buf()
    l.trap = None
    l.returns_value = signature.result is Some(_)
    l.current = new_block(l)
    // The function's own locals get slots; a local function's parameters are among them.
    l.local_slots = buf()
    for local in f.locals
        if local.owner == f.symbol then l.local_slots.push(new_slot(l, local.ty)) else l.local_slots.push(None)
    l.param_values = buf()
    symbol.root match
        None ->
            for p in symbol.params
                l.param_values.push(if machine(l, p) is Some(t) then Some(fresh(l, t)) else None)
        Some(root) ->
            for i in 0..<symbol.params.len()
                val value = if machine(l, symbol.params[i]) is Some(t) then Some(Value(fresh(l, t))) else None
                store(l, l.local_slots[symbol.param_locals[i]], value)
            for x in symbol.captured_locals
                if machine(l, f.locals[x].ty) is Some(t)
                    l.local_slots.set(x, Some(Place(Value(fresh(l, MPtr)), t)))
            for _ in l.program.symbols[root].params
                l.param_values.push(None)
            for x in symbol.captured_params
                if machine(l, l.program.symbols[root].params[x]) is Some(t) then l.param_values.set(x, Some(fresh(l, t)))
    f.body match
        Some(body) ->
            val result = lower_expr(l, body)
            finish(l, returning(l, result))
        None -> intrinsic_body(l, symbol)
    MirFunction(function_symbol(l.program, f.symbol, inst.type_args), signature, l.values, l.slots, l.blocks)

// The terminator that returns a body's value. A function that yields a value but whose body has
// none at this point is in code that cannot be reached.
private returning(l: *Lowering, value: Option[Operand]) -> Terminator
    if !l.returns_value then return Return(None)
    value match
        Some(v) -> Return(Some(v))
        None -> Unreachable

// An intrinsic is a function like any other in the object file; its body is the operation the
// intrinsic names, so it can be called directly and, later, passed as a value.
private intrinsic_body(l: *Lowering, symbol: FunctionSymbol)
    val name = symbol.intrinsic.unwrap_or("")
    if name == "print_line"
        var args: Buf[Operand] = buf()
        args.push(Value(0))
        var params: Buf[MirType] = buf()
        params.push(MStr)
        l.insts.push(Call(None, Runtime("avin_rt_print_line", MirSignature(params, None)), args))
        finish(l, Return(None))
        return
    finish(l, Unreachable)

private new_block(l: *Lowering) -> usize
    val id = l.blocks.len()
    l.blocks.push(MirBlock(buf(), Unreachable))
    id

/** Ends the current block with `term`. */
private finish(l: *Lowering, term: Terminator)
    l.blocks[l.current].insts = l.insts
    l.blocks[l.current].term = term
    l.insts = buf()

/** Ends the current block and continues in `block`. */
private finish_into(l: *Lowering, term: Terminator, block: usize)
    finish(l, term)
    l.current = block

/** Ends the current block with control that never falls through, and continues in a fresh block
 * no path reaches, for any code the program writes after it. */
private leave(l: *Lowering, term: Terminator)
    finish_into(l, term, new_block(l))

private fresh(l: *Lowering, t: MirType) -> usize
    val id = l.values.len()
    l.values.push(t)
    id

private new_slot(l: *Lowering, t: &Type) -> Option[Place] = machine(l, t) match
    Some(m) ->
        val id = l.slots.len()
        l.slots.push(m)
        Some(Place(SlotAddress(id), m))
    None -> None

private store(l: *Lowering, place: Option[Place], value: Option[Operand])
    if place is Some(p)
        if value is Some(v) then l.insts.push(Store(p.address, v))

private load(l: *Lowering, place: Option[Place]) -> Option[Operand] = place match
    Some(p) ->
        val dest = fresh(l, p.ty)
        l.insts.push(Load(dest, p.address))
        Some(Value(dest))
    None -> None

/** Continues only when `flag` is false; otherwise the program traps. */
private trap_if(l: *Lowering, flag: Operand)
    val trap = l.trap match
        Some(t) -> t
        None ->
            val t = new_block(l)
            l.blocks[t].term = Trap
            l.trap = Some(t)
            t
    val next = new_block(l)
    finish_into(l, Branch(flag, trap, next), next)

private binary(l: *Lowering, t: MirType, op: MirOp, a: Operand, b: Operand) -> Operand
    val dest = fresh(l, t)
    l.insts.push(Binary(dest, op, a, b))
    Value(dest)

private compare(l: *Lowering, op: MirCmp, a: Operand, b: Operand) -> Operand
    val dest = fresh(l, MBool)
    l.insts.push(Compare(dest, op, a, b))
    Value(dest)

private select(l: *Lowering, t: MirType, condition: Operand, yes: Operand, no: Operand) -> Operand
    val dest = fresh(l, t)
    l.insts.push(Select(dest, condition, yes, no))
    Value(dest)

/** An addition, subtraction or multiplication that traps when it overflows. */
private checked(l: *Lowering, bits: u32, op: MirChecked, a: Operand, b: Operand) -> Operand
    val dest = fresh(l, MInt(bits))
    val overflow = fresh(l, MBool)
    l.insts.push(Checked(dest, overflow, op, a, b))
    trap_if(l, Value(overflow))
    Value(dest)

/** Lowers an expression for its value; `None` for an expression with no runtime value, or one in
 * code no path reaches. */
private lower_expr(l: *Lowering, e: &TExpr) -> Option[Operand] = e.kind match
    IntConst(digits) -> Some(ConstInt(int_bits(e.ty), digits))
    BoolConst(value) -> Some(ConstBool(value))
    CharConst(code) -> Some(ConstInt(32, code.to_string()))
    RealConst(value) -> Some(ConstReal(value))
    StrConst(value) ->
        val index = l.strings.len()
        l.strings.push(value)
        Some(ConstStr(index))
    UnitConst -> None
    Param(index) -> l.param_values[index] match
        Some(id) -> Some(Value(id))
        None -> None
    Local(index) -> load(l, l.local_slots[index])
    Call(function, args, type_args) ->
        var operands: Buf[Operand] = buf()
        for a in args
            val op = lower_expr(l, a)
            if machine(l, a.ty) is Some(_)
                op match
                    Some(v) -> operands.push(v)
                    None -> return None
        // A local function also receives what it captures, from where the caller keeps it.
        val callee = l.program.symbols[function]
        for x in callee.captured_locals
            if l.local_slots[x] is Some(p) then operands.push(p.address)
        for x in callee.captured_params
            if l.param_values[x] is Some(v) then operands.push(Value(v))
        // A local function shares its top-level function's type arguments; a generic function is
        // instantiated with the call's, made concrete for the instance being lowered.
        var concrete_args: Buf[&Type] = buf()
        if callee.root is Some(_) then concrete_args = l.subst
        else
            for t in type_args
                concrete_args.push(concrete(l, t))
        val index = instance(l, function, concrete_args)
        val dest = machine(l, e.ty) match
            Some(t) -> Some(fresh(l, t))
            None -> None
        l.insts.push(Call(dest, Direct(index), operands))
        dest match
            Some(id) -> Some(Value(id))
            None -> None
    Construct(variant, args) -> construct(l, e, variant, args)
    Field(value, index) ->
        val object = lower_expr(l, value)?
        layout(l, concrete(l, value.ty)).variants[0].fields[index] match
            Some(field) -> Some(load_field(l, object, field))
            None -> None
    Block(items) ->
        var last: Option[Operand] = None
        for item in items
            last = lower_expr(l, item)
        if machine(l, e.ty) is Some(_) then last else None
    Let(local, value) ->
        store(l, l.local_slots[local], lower_expr(l, value))
        None
    Store(local, value, yields) ->
        val v = lower_expr(l, value)
        store(l, l.local_slots[local], v)
        if yields then v else None
    Step(local, increment, postfix) -> step(l, e, local, increment, postfix)
    Negate(operand) ->
        val x = lower_expr(l, operand)?
        if *e.ty is Real then return Some(binary(l, MReal, OpFSub, ConstReal(-0.0), x))
        val bits = int_bits(e.ty)
        Some(checked(l, bits, CheckedSub, ConstInt(bits, "0"), x))
    Not(operand) ->
        val x = lower_expr(l, operand)?
        Some(binary(l, MBool, OpXor, x, ConstBool(true)))
    Complement(operand) ->
        val x = lower_expr(l, operand)?
        val bits = int_bits(e.ty)
        Some(binary(l, MInt(bits), OpXor, x, ConstInt(bits, "-1")))
    Arith(op, left, right) ->
        val a = lower_expr(l, left)?
        val b = lower_expr(l, right)?
        Some(*e.ty match
            Real -> real_arith(l, op, a, b)
            Byte -> byte_arith(l, op, a, b)
            _ -> arith(l, int_bits(e.ty), op, a, b))
    Convert(operand) ->
        val x = lower_expr(l, operand)?
        Some(convert(l, operand.ty, e.ty, x))
    Logic(and, left, right) -> logic(l, and, left, right)
    Compare(operands, ops) -> compare_chain(l, operands, ops)
    If(condition, yes, no) -> lower_if(l, e, condition, yes, no)
    While(label, condition, body, otherwise) -> lower_while(l, e, label, condition, body, otherwise)
    Break(label, value) ->
        val target = loop_target(l, label)
        var v: Option[Operand] = None
        if value is Some(x) then v = lower_expr(l, x)
        store(l, target.slot, v)
        leave(l, Jump(target.exit))
        None
    Continue(label) ->
        leave(l, Jump(loop_target(l, label).head))
        None
    Match(subject, arms) -> lower_match(l, e, subject, arms)
    Is(value, pattern, negated) -> lower_is(l, value, pattern, negated)
    Clauses(subjects, clauses) -> lower_clauses(l, e, subjects, clauses)
    Return(value) ->
        var v: Option[Operand] = None
        var dead = false
        if value is Some(x)
            v = lower_expr(l, x)
            dead = *x.ty is Nothing
        leave(l, if dead then Unreachable else returning(l, v))
        None

private int_bits(t: &Type) -> u32 = *t match
    Int(bits) -> bits
    Byte -> 8
    Char -> 32
    _ -> IntBits

private loop_target(l: *Lowering, label: usize) -> LoopTarget
    for t in l.loops
        if t.label == label then return t
    LoopTarget(label, 0, 0, None)

private step(l: *Lowering, e: &TExpr, local: usize, increment: bool, postfix: bool) -> Option[Operand]
    val slot = l.local_slots[local]
    val old = load(l, slot)?
    val bits = int_bits(e.ty)
    val updated = checked(l, bits, if increment then CheckedAdd else CheckedSub, old, ConstInt(bits, "1"))
    store(l, slot, Some(updated))
    Some(if postfix then old else updated)

// Avin's integer operators on machine operations. `+`, `-` and `*` trap on overflow; `/` traps on
// a zero divisor and on the one quotient that does not fit; `%` traps on a zero divisor and is 0
// for a divisor of -1; a shift count at least the width, or negative, shifts every bit out.
private arith(l: *Lowering, bits: u32, op: BinaryOp, a: Operand, b: Operand) -> Operand
    val t = MInt(bits)
    op match
        Add -> checked(l, bits, CheckedAdd, a, b)
        Subtract -> checked(l, bits, CheckedSub, a, b)
        Multiply -> checked(l, bits, CheckedMul, a, b)
        AddWrapping -> binary(l, t, OpAdd, a, b)
        SubtractWrapping -> binary(l, t, OpSub, a, b)
        MultiplyWrapping -> binary(l, t, OpMul, a, b)
        AddSaturating -> binary(l, t, OpAddSat, a, b)
        SubtractSaturating -> binary(l, t, OpSubSat, a, b)
        MultiplySaturating -> binary(l, t, OpMulSat, a, b)
        BitAnd -> binary(l, t, OpAnd, a, b)
        BitOr -> binary(l, t, OpOr, a, b)
        BitXor -> binary(l, t, OpXor, a, b)
        Divide ->
            trap_if(l, compare(l, CmpEq, b, ConstInt(bits, "0")))
            val minimum = compare(l, CmpEq, a, ConstInt(bits, min_digits(bits)))
            val minus_one = compare(l, CmpEq, b, ConstInt(bits, "-1"))
            trap_if(l, binary(l, MBool, OpAnd, minimum, minus_one))
            binary(l, t, OpDiv, a, b)
        Remainder ->
            trap_if(l, compare(l, CmpEq, b, ConstInt(bits, "0")))
            val minus_one = compare(l, CmpEq, b, ConstInt(bits, "-1"))
            binary(l, t, OpRem, a, select(l, t, minus_one, ConstInt(bits, "1"), b))
        ShiftLeft ->
            val out = compare(l, CmpUge, b, ConstInt(bits, bits.to_string()))
            select(l, t, out, ConstInt(bits, "0"), binary(l, t, OpShl, a, b))
        ShiftRight ->
            val out = compare(l, CmpUge, b, ConstInt(bits, bits.to_string()))
            binary(l, t, OpAShr, a, select(l, t, out, ConstInt(bits, (bits - 1).to_string()), b))
        _ -> a

private real_arith(l: *Lowering, op: BinaryOp, a: Operand, b: Operand) -> Operand
    val machine = op match
        Add -> OpFAdd
        Subtract -> OpFSub
        Multiply -> OpFMul
        Divide -> OpFDiv
        _ -> OpFRem
    binary(l, MReal, machine, a, b)

// A byte's bits are unsigned, so `>>` shifts zeros in.
private byte_arith(l: *Lowering, op: BinaryOp, a: Operand, b: Operand) -> Operand
    val t = MInt(8)
    op match
        BitAnd -> binary(l, t, OpAnd, a, b)
        BitOr -> binary(l, t, OpOr, a, b)
        BitXor -> binary(l, t, OpXor, a, b)
        ShiftLeft ->
            val out = compare(l, CmpUge, b, ConstInt(8, "8"))
            select(l, t, out, ConstInt(8, "0"), binary(l, t, OpShl, a, b))
        _ ->
            val out = compare(l, CmpUge, b, ConstInt(8, "8"))
            select(l, t, out, ConstInt(8, "0"), binary(l, t, OpLShr, a, b))

private convert_op(l: *Lowering, conv: MirConv, t: MirType, x: Operand) -> Operand
    val dest = fresh(l, t)
    l.insts.push(Convert(dest, conv, x))
    Value(dest)

// Changes an integer's width: `signed` says whether its bits are signed, as an `iN`'s are and a
// byte's and a char's are not.
private resize(l: *Lowering, x: Operand, from: u32, to: u32, signed: bool) -> Operand
    if from == to then return x
    if from > to then return convert_op(l, Truncate, MInt(to), x)
    convert_op(l, if signed then SignExtend else ZeroExtend, MInt(to), x)

private convert(l: *Lowering, from: &Type, to: &Type, x: Operand) -> Operand = *to match
    Real -> *from match
        Real -> x
        Byte -> convert_op(l, UnsignedToReal, MReal, x)
        _ -> convert_op(l, SignedToReal, MReal, x)
    Int(bits) -> *from match
        Real -> convert_op(l, RealToInt, MInt(bits), x)
        Int(width) -> resize(l, x, width, bits, true)
        _ -> resize(l, x, int_bits(from), bits, false)
    Byte -> *from match
        Int(width) -> to_byte(l, x, width)
        _ -> x
    Char -> *from match
        Int(width) -> to_char(l, x, width)
        Byte -> resize(l, x, 8, 32, false)
        _ -> x
    _ -> x

// An integer becomes a byte only when it is 0 to 255; anything else traps.
private to_byte(l: *Lowering, x: Operand, width: u32) -> Operand
    if width <= 8
        trap_if(l, compare(l, CmpLt, x, ConstInt(width, "0")))
        return resize(l, x, width, 8, false)
    trap_if(l, compare(l, CmpUgt, x, ConstInt(width, "255")))
    resize(l, x, width, 8, false)

// An integer becomes a char only when it is a Unicode scalar value: 0 to 0x10FFFF, outside the
// surrogates 0xD800 to 0xDFFF. A negative value compares as huge, so one unsigned test covers both
// ends.
private to_char(l: *Lowering, x: Operand, width: u32) -> Operand
    val w = if width < 32 then 32u32 else width
    val wide = resize(l, x, width, w, true)
    trap_if(l, compare(l, CmpUgt, wide, ConstInt(w, "1114111")))
    val offset = binary(l, MInt(w), OpSub, wide, ConstInt(w, "55296"))
    trap_if(l, compare(l, CmpUlt, offset, ConstInt(w, "2048")))
    resize(l, wide, w, 32, false)

/** The most negative value of a width, in decimal. */
min_digits(bits: u32) -> string
    // Doubles a little-endian list of decimal digits, from 1, `bits - 1` times.
    var digits: Buf[u8] = buf()
    digits.push(1)
    for _ in 1..<bits
        var carry = 0u8
        for i in 0..<digits.len()
            val d = digits[i] * 2 + carry
            digits.set(i, d % 10)
            carry = d / 10
        if carry > 0 then digits.push(carry)
    var out = "-"
    var i = digits.len()
    while i > 0
        i -= 1
        out = out + char(u8('0') + digits[i]).to_string()
    out

private logic(l: *Lowering, and: bool, left: &TExpr, right: &TExpr) -> Option[Operand]
    val a = lower_expr(l, left)?
    val slot = new_slot(l, Bool)
    store(l, slot, Some(a))
    val rest = new_block(l)
    val done = new_block(l)
    finish_into(l, if and then Branch(a, rest, done) else Branch(a, done, rest), rest)
    store(l, slot, lower_expr(l, right))
    finish_into(l, Jump(done), done)
    load(l, slot)

// Reals compare as IEEE 754 says, bytes as unsigned, and every other scalar as signed.
private compare_op(op: CompareOp, t: &Type) -> MirCmp
    if *t is Real
        return op match
            Equal -> FEq
            NotEqual -> FNe
            Less -> FLt
            LessEqual -> FLe
            Greater -> FGt
            _ -> FGe
    if *t is Byte
        return op match
            Equal -> CmpEq
            NotEqual -> CmpNe
            Less -> CmpUlt
            LessEqual -> CmpUle
            Greater -> CmpUgt
            _ -> CmpUge
    op match
        Equal -> CmpEq
        NotEqual -> CmpNe
        Less -> CmpLt
        LessEqual -> CmpLe
        Greater -> CmpGt
        _ -> CmpGe

// A chain evaluates each operand when its link is reached, and the first false link decides.
private compare_chain(l: *Lowering, operands: Buf[&TExpr], ops: Buf[CompareOp]) -> Option[Operand]
    var previous = lower_expr(l, operands[0])?
    if ops.len() == 1
        val next = lower_expr(l, operands[1])?
        return Some(compare(l, compare_op(ops[0], operands[0].ty), previous, next))
    val slot = new_slot(l, Bool)
    val done = new_block(l)
    for i in 0..<ops.len()
        val next = lower_expr(l, operands[i + 1])?
        val result = compare(l, compare_op(ops[i], operands[i].ty), previous, next)
        store(l, slot, Some(result))
        if i + 1 < ops.len()
            val more = new_block(l)
            finish_into(l, Branch(result, more, done), more)
        previous = next
    finish_into(l, Jump(done), done)
    load(l, slot)

private lower_if(l: *Lowering, e: &TExpr, condition: &TExpr, yes: &TExpr, no: Option[&TExpr]) -> Option[Operand]
    val c = lower_expr(l, condition)?
    val slot = new_slot(l, e.ty)
    val then_block = new_block(l)
    val join = new_block(l)
    val else_block = if no is Some(_) then new_block(l) else join
    finish_into(l, Branch(c, then_block, else_block), then_block)
    store(l, slot, lower_expr(l, yes))
    finish(l, Jump(join))
    if no is Some(n)
        l.current = else_block
        store(l, slot, lower_expr(l, n))
        finish(l, Jump(join))
    l.current = join
    load(l, slot)

private lower_while(l: *Lowering, e: &TExpr, label: usize, condition: &TExpr, body: &TExpr, otherwise: Option[&TExpr]) -> Option[Operand]
    val slot = new_slot(l, e.ty)
    val head = new_block(l)
    val exit = new_block(l)
    finish_into(l, Jump(head), head)
    val c = lower_expr(l, condition)?
    val body_block = new_block(l)
    val else_block = if otherwise is Some(_) then new_block(l) else exit
    finish_into(l, Branch(c, body_block, else_block), body_block)
    l.loops.push(LoopTarget(label, head, exit, slot))
    lower_expr(l, body)
    l.loops.truncate(l.loops.len() - 1)
    finish(l, Jump(head))
    if otherwise is Some(o)
        l.current = else_block
        store(l, slot, lower_expr(l, o))
        finish(l, Jump(exit))
    l.current = exit
    load(l, slot)

/** Continues only when `condition` holds; otherwise control goes to `fail`. */
private continue_if(l: *Lowering, condition: Operand, fail: usize)
    val next = new_block(l)
    finish_into(l, Branch(condition, next, fail), next)

// Each arm tests its pattern and then its guard, going on to the next arm when either fails. The
// checker has proved the arms cover every value, so falling past the last arm traps rather than
// continuing.
private lower_match(l: *Lowering, e: &TExpr, subject: &TExpr, arms: Buf[TArm]) -> Option[Operand]
    val s = lower_expr(l, subject)
    if s is None && machine(l, subject.ty) is Some(_) then return None
    val slot = new_slot(l, e.ty)
    val join = new_block(l)
    for arm in arms
        val fail = new_block(l)
        test_pattern(l, arm.pattern, s, fail)
        if arm.guard is Some(g)
            if lower_expr(l, g) is Some(ok) then continue_if(l, ok, fail)
        store(l, slot, lower_expr(l, arm.body))
        finish_into(l, Jump(join), fail)
    finish_into(l, Trap, join)
    load(l, slot)

// Each clause tests its patterns against the arguments, then tries its bodies' guards in order; when
// the patterns fail, or every guard does, the next clause is tried. The checker has proved the
// clauses cover every argument, so falling past the last one traps.
private lower_clauses(l: *Lowering, e: &TExpr, subjects: Buf[&TExpr], clauses: Buf[TClause]) -> Option[Operand]
    var values: Buf[Option[Operand]] = buf()
    for s in subjects
        values.push(lower_expr(l, s))
    val slot = new_slot(l, e.ty)
    val join = new_block(l)
    for clause in clauses
        val fail = new_block(l)
        for i in 0..<clause.patterns.len()
            test_pattern(l, clause.patterns[i], values[i], fail)
        for b in clause.bodies
            val next = new_block(l)
            if b.guard is Some(g)
                if lower_expr(l, g) is Some(ok) then continue_if(l, ok, next)
            store(l, slot, lower_expr(l, b.body))
            finish_into(l, Jump(join), next)
        finish_into(l, Jump(fail), fail)
    finish_into(l, Trap, join)
    load(l, slot)

private lower_is(l: *Lowering, value: &TExpr, pattern: &TPattern, negated: bool) -> Option[Operand]
    val v = lower_expr(l, value)
    if v is None && machine(l, value.ty) is Some(_) then return None
    val slot = new_slot(l, Bool)
    val fail = new_block(l)
    val join = new_block(l)
    test_pattern(l, pattern, v, fail)
    store(l, slot, Some(ConstBool(!negated)))
    finish_into(l, Jump(join), fail)
    store(l, slot, Some(ConstBool(negated)))
    finish_into(l, Jump(join), join)
    load(l, slot)

// Tests `value` against a pattern, binding its names, and continues where it matched; a failed
// test goes to `fail`. A unit value has no runtime value, and every unit pattern matches it.
private test_pattern(l: *Lowering, p: &TPattern, value: Option[Operand], fail: usize)
    p.kind match
        PWildcard -> ()
        PBind(local) -> store(l, l.local_slots[local], value)
        PNamed(local, inner) ->
            test_pattern(l, inner, value, fail)
            store(l, l.local_slots[local], value)
        PLiteral(constant) ->
            if value is Some(v)
                if lower_expr(l, constant) is Some(k) then continue_if(l, compare(l, compare_op(Equal, p.ty), v, k), fail)
        PBounds(local, lower, upper) ->
            if value is Some(v)
                if lower is Some(b)
                    if lower_expr(l, b.value) is Some(low) then continue_if(l, compare(l, compare_op(if b.inclusive then GreaterEqual else Greater, p.ty), v, low), fail)
                if upper is Some(b)
                    if lower_expr(l, b.value) is Some(high) then continue_if(l, compare(l, compare_op(if b.inclusive then LessEqual else Less, p.ty), v, high), fail)
            if local is Some(index) then store(l, l.local_slots[index], value)
        PSuccessor(local, amount) ->
            if value is Some(v)
                if lower_expr(l, amount) is Some(k)
                    continue_if(l, compare(l, compare_op(GreaterEqual, p.ty), v, k), fail)
                    // The value is at least the positive amount, so the difference cannot overflow.
                    if local is Some(index) then store(l, l.local_slots[index], Some(binary(l, MInt(int_bits(p.ty)), OpSub, v, k)))
        PAlternatives(options) ->
            val matched = new_block(l)
            for i in 0..<options.len()
                val last = i + 1 == options.len()
                val next = if last then fail else new_block(l)
                test_pattern(l, options[i], value, next)
                finish(l, Jump(matched))
                l.current = next
            l.current = matched
        PVariant(variant, fields) ->
            if value is Some(v)
                val shape = layout(l, concrete(l, p.ty))
                // A type with one variant needs no test; otherwise the tag is in the descriptor.
                if shape.variants.len() > 1
                    val descriptor = fresh(l, MPtr)
                    l.insts.push(Load(descriptor, v))
                    val tag = fresh(l, MInt(64))
                    l.insts.push(Load(tag, Value(descriptor)))
                    continue_if(l, compare(l, CmpEq, Value(tag), ConstInt(64, variant.to_string())), fail)
                val places = shape.variants[variant].fields
                for i in 0..<fields.len()
                    val sub = fields[i]
                    if sub.kind is PWildcard then continue
                    val field = if places[i] is Some(place) then Some(load_field(l, v, place)) else None
                    test_pattern(l, sub, field, fail)
