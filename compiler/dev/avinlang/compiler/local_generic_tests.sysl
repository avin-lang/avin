module dev.avinlang.compiler
@tests

import sh.sysl.parsing.source_of

// The copies lowering makes of local functions with type parameters of their own: one per list of
// type arguments, those shared with the enclosing code first, and a plain local function they call
// once per list of the enclosing code's.

/** The object file names of the functions lowered from `text` whose local name is `name`, the
 * symbol id left out, in the order they were made. */
private copies(text: string, name: string) -> string
    val program = lower_source(repository_toolchain(), source_of("probe.avin", text)) match
        Ok(p) -> p
        Err(d) -> panic(d)
    var out = ""
    for f in program.functions
        for part in f.symbol.split("#")
            if part.ends_with("." + name) then out = out + part + " "
            break
    out

@test("a generic local function is compiled once per list of type arguments")
generic_local_copies()
    val text = "main()\n    helper(n: int) -> int = n + 1\n    pair[T](x: T) -> (T, int) = (x, helper(1))\n    println(pair(1))\n    println(pair(2))\n    println(pair(\"a\"))\n"
    assert_eq(copies(text, "pair"), "<program>.main[int].pair <program>.main[string].pair ")
    assert_eq(copies(text, "helper"), "<program>.main.helper ")

@test("a generic local function of a generic function takes the enclosing type arguments, then its own")
nested_generic_local_copies()
    val text = "outer[A](a: A) -> int\n    plain() -> int = 1\n    with[B](b: B) -> int = plain()\n    with(1) + with('c') + with(2)\n\nmain()\n    println(outer(true) + outer(1.5))\n"
    assert_eq(copies(text, "with"), "<program>.outer[bool, int].with <program>.outer[bool, char].with <program>.outer[real, int].with <program>.outer[real, char].with ")
    assert_eq(copies(text, "plain"), "<program>.outer[bool].plain <program>.outer[real].plain ")
