@test("a class with `attach:` gives C its record through glue keyed by a static object of its `key:` type, or a `char`, and lets go of the record when its reference goes back")
attach_glue()
    var handles: Buf[CUnitHandle] = buf()
    handles.push(CUnitHandle("Surface", 2, "cairo_surface_t *", false, "cairo_surface_destroy", None, None, 0, Span(0, 0), "p", buf(), buf(), None, Some("cairo_surface_set_user_data(self, key, data, destroy)"), Some("cairo_user_data_key_t")))
    handles.push(CUnitHandle("Plain", 3, "cairo_surface_t *", false, "cairo_surface_destroy", None, None, 0, Span(0, 0), "p", buf(), buf(), None, Some("set_it(self, key, data, destroy)"), None))
    handles.push(CUnitHandle("Unattached", 4, "cairo_surface_t *", false, "cairo_surface_destroy", None, None, 0, Span(0, 0), "p", buf(), buf(), None, None, None))
    var headers: Buf[string] = buf()
    headers.push("<cairo.h>")
    val unit = c_unit_source(buf(), handles, libc(headers))
    val text = unit.text
    assert(text.contains("void avin_rt_c_attach_destroy(void *data);\nvoid avin_rt_c_attach_drop(void *id);\n"), text)
    assert(text.contains("static cairo_user_data_key_t avin_c_key_2;\nlong long avin_c_attach_2(void *p, long long avin_id) {\n    cairo_surface_t * self = (cairo_surface_t *)p;\n    void *data = (void *)(__INTPTR_TYPE__)avin_id;\n    cairo_user_data_key_t *key = &avin_c_key_2;\n    void (*destroy)(void *) = avin_rt_c_attach_destroy;\n    (void)key; (void)destroy;\n    return (long long)(cairo_surface_set_user_data(self, key, data, destroy));\n}\n"), text)
    assert(text.contains("static char avin_c_key_3;\n"), text)
    assert(text.contains("    if (o[5]) { avin_rt_c_attach_drop(o[5]); o[5] = 0; }\n"), text)
    assert(!text.contains("avin_c_attach_4"), text)
    assert_eq(unit.lines.len(), text.split("\n").len)

@test("`bytes:`, `view:` and a bare `view` with `writable` are read as what the binding answers")
buffer_words_read()
    val f = parse_c_function("@c(\"int f(t *self, out uint8_t **b, out int *n)\", view: \"b\", writable, length: \"n\")\nf() -> int\n")
    val a = c_array_out_of(f).unwrap()
    assert_eq(a.name, "b")
    assert(a.view && a.writable && !a.bytes)
    assert_eq(a.length, "n")
    val g = c_array_out_of(parse_c_function("@c(\"unsigned char *g(t *self)\", view, length: \"4\")\ng() -> int\n")).unwrap()
    assert_eq(g.name, "")
    assert(g.view && !g.writable)
    val h = c_array_out_of(parse_c_function("@c(\"void h(out uint8_t **b, out int *n)\", bytes: \"b\", length: \"n\", free: \"free\")\nh() -> int\n")).unwrap()
    assert(h.bytes && !h.view)
    assert_eq(h.free.unwrap_or(""), "free")
    assert(c_array_out_of(parse_c_function("@c(\"int k(int)\")\nk(n: int) -> int\n")) is None)
    assert_eq(c_array_outs_of(parse_c_function("@c(\"int k(int)\")\nk(n: int) -> int\n")).len(), 0)
    assert_eq(c_array_outs_of(f).len(), 1)

@test("`array:` names several arrays as a list, each with its length and its `free:`, an empty one freeing nothing")
array_lists_read()
    val f = parse_c_function("@c(\"int s(out g **a, out int *na, out c **b, out int *nb)\", array: [\"a\", \"b\"], length: [\"na\", \"nb * 1\"], free: [\"g_free\", \"\"])\ns() -> int\n")
    val all = c_array_outs_of(f)
    assert_eq(all.len(), 2)
    assert_eq(all[0].name, "a")
    assert_eq(all[0].length, "na")
    assert_eq(all[0].free.unwrap_or(""), "g_free")
    assert_eq(all[1].name, "b")
    assert_eq(all[1].length, "nb * 1")
    assert(all[1].free is None)
    assert(!all[0].view && !all[1].bytes)
    assert_eq(c_array_out_of(f).unwrap().name, "a")
    val b = c_array_outs_of(parse_c_function("@c(\"void t(out uint8_t **x, out uint8_t **y, out int *n)\", bytes: [\"y\", \"x\"], length: [\"n\", \"n\"])\nt() -> int\n"))
    assert_eq(b.len(), 2)
    assert_eq(b[0].name, "y")
    assert(b[0].bytes && b[1].bytes)

@test("every rule of buffers holds against the fixture, at -O0 and -O2")
c_buffer_rules()
    val dir = make_temp_dir("avin-c-buffers").unwrap()
    defer _ = remove_dir_all(dir)
    val tc = fixture_toolchain(repository_toolchain(), dir)
    for level in ["-O0", "-O2"]
        var said = ""
        var noted = ""
        val status = run_cli_in(".", ["avin", "test", tc.root + "/tests/c/buffer_tests", level], Some(tc), s -> said = said + s + "\n", s -> noted = noted + s + "\n", Stdio.ToPath(dir + "/out"), Stdio.ToPath(dir + "/err"))
        val out = read_text(dir + "/out").unwrap_or("")
        assert_eq(status, 0, said + noted + out)
        assert((said + out).contains("138 passed, 0 failed"), said + noted + out)

// The first function of the source `text`.
private parse_c_function(text: string) -> &Function
    val file = parse(source_of("f.avin", text)).file
    for item in file.items
        if item is FunctionItem(f) then return f
    panic("no function in " + text)
