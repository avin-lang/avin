@test("a handle's C type is read alone, to the text a prototype's parameter of that type has")
handle_types()
    assert_eq(parse_c_type("cairo_surface_t *").unwrap().text, "cairo_surface_t *")
    assert_eq(parse_c_type("  cairo_surface_t*").unwrap().text, "cairo_surface_t *")
    assert(parse_c_type("cairo_surface_t *").unwrap().ty is CPointerType)
    assert(parse_c_type("FT_Library").unwrap().ty is CTypedef(_))
    assert(parse_c_type("struct thing *").unwrap().ty is CPointerType)
    assert(parse_c_type("const char *").unwrap().ty is CText(true))
    assert(parse_c_type("int").unwrap().ty is CKeyword(_))
    assert(parse_c_type("cairo_t *cr") is Err(_))
    assert(parse_c_type("int f(void)") is Err(_))
    assert(parse_c_type("") is Err(_))
    // The prototype's parameter names the type the same way, and a `const` parameter takes it too.
    val p = prototype("int cairo_status(cairo_t* self, const cairo_t *other)")
    assert_eq(p.params[0].name, "self")
    assert(c_names_handle(p.params[0].text, parse_c_type("cairo_t *").unwrap().text, false))
    assert(c_names_handle(p.params[1].text, "cairo_t *", false))
    assert(!c_names_handle("const cairo_t *", "cairo_t *", true))
    assert(!c_names_handle("cairo_surface_t *", "cairo_t *", false))
    assert_eq(prototype("int f(int)").params[0].name, "")

@test("a `kept:` name is found as a word of its own in a C expression, never as a member")
kept_names()
    assert(c_uses_name("FT_Done_MM_Var(face->glyph->library, self)", "face"))
    assert(c_uses_name("f(self)", "self"))
    assert(!c_uses_name("f(self->face)", "face"))
    assert(!c_uses_name("f(self.face)", "face"))
    assert(!c_uses_name("f(faces, self)", "face"))
    assert(!c_uses_name("f(my_face)", "face"))
    assert(c_uses_name("face", "face"))
    assert(!c_uses_name("", "face"))

@test("a package's headers come after those of the packages whose handle classes its bindings name, and otherwise in the order listed")
headers_ordered()
    var libraries: Buf[CLibrary] = buf()
    var cairo: Buf[string] = buf()
    cairo.push("cairo.h")
    var freetype: Buf[string] = buf()
    freetype.push("<ft2build.h>")
    freetype.push("FT_FREETYPE_H")
    libraries.push(CLibrary("app", "app", None, buf(), buf(), ""))
    libraries.push(CLibrary("cairo", "cairo", None, buf(), cairo, ""))
    libraries.push(CLibrary("freetype", "freetype", None, buf(), freetype, ""))
    var bindings: Buf[CUnitBinding] = buf()
    assert_eq(header_order(bindings, libraries)[1], "cairo")
    var uses: Buf[string] = buf()
    uses.push("freetype")
    var b = unit_binding("ftFontFace", "int f(void)", buf(), Int(32))
    b.package = "cairo"
    b.uses = uses
    bindings.push(b)
    val order = header_order(bindings, libraries)
    assert_eq(order.len(), 3)
    assert_eq(order[0], "app")
    assert_eq(order[1], "freetype")
    assert_eq(order[2], "cairo")
    val unit = c_unit_source(bindings, buf(), libraries)
    // A macro is included as itself, after the header that defines it; a path is put in brackets.
    assert(unit.text.contains("#include <ft2build.h>\n#include FT_FREETYPE_H\n#include <cairo.h>\n"), unit.text)
    // Two packages naming each other's classes, which dependencies cannot, keep the order listed.
    var back: Buf[string] = buf()
    back.push("cairo")
    var c = unit_binding("loop", "int g(void)", buf(), Int(32))
    c.package = "freetype"
    c.uses = back
    bindings.push(c)
    val cycle = header_order(bindings, libraries)
    assert_eq(cycle[0], "app")
    assert_eq(cycle[1], "cairo")
    assert_eq(cycle[2], "freetype")

@test("a handle's glue gives its reference back, then the C references it holds, and keeps by reference only a class with `retain` and no `kept:`")
handle_glue_source()
    var handles: Buf[CUnitHandle] = buf()
    handles.push(CUnitHandle("Library", 3, "FT_Library", true, "FT_Done_Library", Some("FT_Reference_Library"), None, 0, Span(0, 0), "p", buf(), buf(), None, None, None))
    handles.push(CUnitHandle("MMVar", 4, "FT_MM_Var *", false, "FT_Done_MM_Var(face->glyph->library, self)", None, Some(CUnitKept("face", 5, "FT_Face")), 0, Span(0, 0), "p", buf(), buf(), None, None, None))
    handles.push(CUnitHandle("Face", 5, "FT_Face", true, "FT_Done_Face", Some("FT_Reference_Face"), None, 0, Span(0, 0), "p", buf(), buf(), None, None, None))
    var headers: Buf[string] = buf()
    headers.push("<stdlib.h>")
    val unit = c_unit_source(buf(), handles, libc(headers))
    val text = unit.text
    assert(text.contains("typedef FT_Library avin_c_type_3;\n_Static_assert(__builtin_classify_type(*(avin_c_type_3 *)0) == 5, \"avin: the C handle Library\");\n"), text)
    assert(text.contains("typedef FT_MM_Var * avin_c_type_4;\ntypedef FT_Face avin_c_type_5;"), text)
    assert(text.contains("    (void)(FT_Reference_Library(self));\n"), text)
    assert(text.contains("void avin_c_keep_3(void **o, void *p, void **kept)"), text)
    assert(text.contains("void avin_c_keep_5(void **o, void *p, void **kept)"), text)
    assert(!text.contains("avin_c_keep_4"), text)
    assert(!text.contains("avin_c_retain_4"), text)
    assert(text.contains("        FT_Face face = (FT_Face)avin_c_held(o, avin_c_drop_5);\n        o[0] = 0;\n        (void)(FT_Done_MM_Var(face->glyph->library, self));\n    }\n    avin_c_drain(o);\n"), text)
    assert(text.contains("void avin_c_finalize_4(void *o, void *heap)"), text)
    assert_eq(unit.lines.len(), text.split("\n").len)
    // The kept name, the release and the retain are each placed at their own line.
    var parts = 0
    for line in unit.lines
        if line is GlueLine(_, _) then parts += 1
    assert_eq(parts, 13)

