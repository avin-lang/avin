@test("the C unit checks a callback's function pointer with the binding, its markers removed, and checks and measures the typedefs it is called with and answers")
callback_unit_source()
    var params: Buf[&Type] = buf()
    var inner: Buf[&Type] = buf()
    inner.push(Int(64))
    inner.push(Bool)
    params.push(Function(inner, Int(32), false))
    // A `userdata` crosses as nothing.
    params.push(Unit)
    var bindings: Buf[CUnitBinding] = buf()
    bindings.push(unit_binding("f", "void f(cb_answer (*each)(userdata void *ud, cb_size n, cb_truth t), userdata void *ud)", params, Unit))
    var headers: Buf[string] = buf()
    headers.push("<f.h>")
    val unit = c_unit_source(bindings, buf(), libc(headers))
    val text = unit.text
    assert(text.contains("_Static_assert(__builtin_types_compatible_p(__typeof__(&f), void (*)(cb_answer (*)(void *, cb_size, cb_truth), void *)), \"avin: the C binding f\");\n"), text)
    assert(text.contains("\"avin: the C type cb_answer\""), text)
    assert(text.contains("\"avin: the C type cb_size\""), text)
    assert(text.contains("\"avin: the C type cb_truth\""), text)
    assert(text.contains("(unsigned char)sizeof(cb_size), (unsigned char)((cb_size)-1 < (cb_size)0),\n"), text)
    assert(text.contains("(unsigned char)sizeof(cb_answer), (unsigned char)((cb_answer)-1 < (cb_answer)0),\n"), text)
    assert_eq(unit.measured.len(), 3)
    assert_eq(unit.lines.len(), text.split("\n").len)

@test("a handle's glue tells C to forget each callback it keeps before its object goes back, and its kept handles never take a callback's record")
forget_glue()
    var handles: Buf[CUnitHandle] = buf()
    handles.push(CUnitHandle("Registry", 2, "cb_registry *", false, "cb_registry_unref", None, None, 0, Span(0, 0), "p", buf(), buf(), Some("cb_registry_forget"), None, None))
    handles.push(CUnitHandle("Spelled", 3, "cb_registry *", false, "cb_registry_unref", None, None, 0, Span(0, 0), "p", buf(), buf(), Some("forget_it(self, 1, userdata)"), None, None))
    var headers: Buf[string] = buf()
    headers.push("<r.h>")
    val unit = c_unit_source(buf(), handles, libc(headers))
    val text = unit.text
    assert(text.contains("void avin_c_keep_callback(void **o, void *record) { avin_c_hold(o, record, avin_c_no_take, avin_rt_c_callback_drop); }"), text)
    assert(text.contains("if (k->drop == avin_rt_c_callback_drop) continue; k->take(k->pointer);"), text)
    assert(text.contains("            void *userdata = k->pointer;\n            (void)(cb_registry_forget(self, userdata));\n        }\n        (void)(cb_registry_unref(self));\n"), text)
    assert(text.contains("            (void)(forget_it(self, 1, userdata));\n"), text)
    assert_eq(unit.lines.len(), text.split("\n").len)

