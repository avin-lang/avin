@test("`length(data)` marks the parameter carrying an array's length, which is no Avin parameter, and a pointer passed in points at its elements")
array_lengths()
    val p = prototype("ssize_t read(int fd, uint8_t *into, length(into) size_t count)")
    assert_eq(p.params.len(), 3)
    assert_eq(p.params[2].length_of, "into")
    assert_eq(p.params[2].text, "size_t")
    assert(p.params[2].mode is CIn)
    assert_eq(p.params[1].length_of, "")
    assert_eq(p.params[1].pointee_text, "uint8_t")
    assert(p.params[1].pointee is CTypedef("uint8_t"))
    assert(c_is_array_param(p, 1))
    assert(!c_is_array_param(p, 0))
    assert(!c_is_array_param(p, 2))
    assert(c_length_param(p, "into") == Some(2usize))
    assert(c_length_param(p, "fd") is None)
    val positions = c_avin_positions(p)
    assert_eq(positions.len(), 2)
    assert_eq(positions[0], 0)
    assert_eq(positions[1], 1)
    assert_eq(c_out_count(p), 0)
    // An `inout` length, named `length` itself, is part of the result and no Avin parameter.
    val q = prototype("FT_Error FT_Load_Sfnt_Table(FT_Face self, FT_ULong tag, FT_Long offset, FT_Byte *buffer, length(buffer) inout FT_ULong *length)")
    assert_eq(q.params[4].name, "length")
    assert_eq(q.params[4].length_of, "buffer")
    assert(q.params[4].mode is CInOut)
    assert_eq(q.params[4].pointee_text, "FT_ULong")
    assert_eq(c_avin_positions(q).len(), 4)
    assert_eq(c_out_count(q), 1)
    // A length before its array, a `const` and a `char` pointer, and two arrays.
    val r = prototype("double f(length(a) int n, const double *a, const char *s, length(s) unsigned char m)")
    assert_eq(r.params[1].pointee_text, "const double")
    assert(r.params[2].ty is CText(true))
    assert_eq(r.params[2].pointee_text, "const char")
    assert(c_is_array_param(r, 1) && c_is_array_param(r, 2))
    assert_eq(c_avin_positions(r).len(), 2)
    // A pointer qualified after its star points at nothing an array can name.
    assert_eq(prototype("int f(int *const p, int n)").params[0].pointee_text, "")
    assert_eq(prototype("int f(int **p)").params[0].pointee_text, "int *")

@test("a prototype's `length(…)` is refused where it names no array, marks no integer or is written out of place")
array_lengths_refused()
    assert_eq(refused("int f(const int *p, length(q) int n)"), "`length(q)` names no parameter of the prototype")
    assert_eq(refused("int f(const int *p, length(p) out int *n)"), "a length is filled in from the array `p`, so `length(p)` marks a parameter passed in, or an `inout` pointer C writes the length it used through, not an `out` one")
    assert_eq(refused("int f(const int *p, length(p) float n)"), "`length(p)` marks the parameter carrying the length of `p`, which is an integer, and `float` is not one")
    assert_eq(refused("int f(const int *p, length(p) char n)"), "`length(p)` marks the parameter carrying the length of `p`, which is an integer, and `char` is not one")
    assert_eq(refused("int f(const int *p, length(p) inout double *n)"), "`length(p)` marks the parameter carrying the length of `p`, which is an integer, and `double` is not one")
    assert_eq(refused("int f(const int *p, length(p) int *n)"), "`length(p)` marks the parameter carrying the length of `p`, which is an integer, and `int *` is not one")
    assert_eq(refused("int f(const int *p, length(p) int n, length(p) int m)"), "the length of `p` is carried by one parameter, and two say `length(p)`")
    assert_eq(refused("int f(int x, length(x) int n)"), "`x` is `int`, and an array is passed as a pointer to its elements, as in `uint8_t *x`")
    assert_eq(refused("int f(out int *p, length(p) int n)"), "`p` is an `out` or `inout` pointer, so it is no array; an array is a pointer passed in")
    assert_eq(refused("int f(t *self, length(self) int n)"), "`self` is the receiver, a handle, and no array")
    assert_eq(refused("int f(const int *p, length(p) int self)"), "`self` is the receiver, which carries no array's length")
    assert_eq(refused("int f(const int *p, int length(p) n)"), "`length(data)` is written first, before the parameter's type and before `inout`, as in `length(data) size_t n`")
    assert_eq(refused("int f(const int *p, inout length(p) int *n)"), "`length(data)` is written first, before the parameter's type and before `inout`, as in `length(data) size_t n`")
    assert_eq(refused("int f(const int *p, length(p int n)"), "`length` names the array parameter whose length the parameter carries, in parentheses, as in `length(data) size_t n`")
    assert_eq(refused("int f(const int *p, length(p) int n, length(n) int m)"), "`n` carries a length itself, so it is no array")

@test("an array crosses as an `Array` of a byte, an `int`, a `long` or a `real`, to a pointer to its elements; a `char` pointer takes bytes")
array_crossings()
    assert_eq(c_array_element_size(Byte), 1)
    assert_eq(c_array_element_size(Int(32)), 4)
    assert_eq(c_array_element_size(Int(64)), 8)
    assert_eq(c_array_element_size(Real), 8)
    assert_eq(c_array_element_size(Int(16)), 0)
    assert_eq(c_array_element_size(Int(8)), 0)
    assert_eq(c_array_element_size(Bool), 0)
    assert_eq(c_array_element_size(Str), 0)
    val p = prototype("void f(const uint8_t *a, length(a) int n, char *s, length(s) int m, int *const q, int k)")
    assert_eq(c_array_problem(p.params[0], CArrayForm(Byte, false)), "")
    assert_eq(c_array_problem(p.params[0], CArrayForm(Int(32), true)), "")
    assert_eq(c_array_problem(p.params[0], CArrayForm(Bool, false)), "an array crosses to C as `Array[byte]`, `Array[int]`, `Array[long]` or `Array[real]`, whose elements C reads as they are")
    assert_eq(c_array_problem(p.params[2], CArrayForm(Byte, false)), "")
    assert_eq(c_array_problem(p.params[2], CArrayForm(Real, false)), "a pointer to `char` takes an `Array[byte]`")
    assert_eq(c_array_problem(p.params[4], CArrayForm(Int(32), false)), "an array is passed as a pointer to its elements, as in `uint8_t *q`")

@test("the C unit checks what each array parameter points at holds its elements as they are, by kind, size and sign")
array_unit_source()
    var params: Buf[&Type] = buf()
    params.push(Int(32))
    params.push(Int(32))
    params.push(Real)
    params.push(Int(32))
    params.push(Byte)
    params.push(Int(32))
    params.push(Int(64))
    params.push(Int(32))
    var bindings: Buf[CUnitBinding] = buf()
    bindings.push(unit_binding("f", "void f(const int32_t *a, length(a) int n, double *b, length(b) size_t m, const char *c, length(c) int k, aa_fixed *d, length(d) int j)", params, Unit))
    var headers: Buf[string] = buf()
    headers.push("<f.h>")
    val unit = c_unit_source(bindings, buf(), libc(headers))
    val text = unit.text
    assert(text.contains("_Static_assert(__builtin_classify_type(*(const int32_t *)0) == 1 && sizeof(const int32_t) == 4 && (const int32_t)-1 < (const int32_t)0, \"avin: the elements of parameter 1 of f\");\n"), text)
    assert(text.contains("_Static_assert(__builtin_classify_type(*(double *)0) == 8 && sizeof(double) == 8, \"avin: the elements of parameter 3 of f\");\n"), text)
    assert(text.contains("_Static_assert(__builtin_classify_type(*(const char *)0) == 1 && sizeof(const char) == 1, \"avin: the elements of parameter 5 of f\");\n"), text)
    assert(text.contains("_Static_assert(__builtin_classify_type(*(aa_fixed *)0) == 1 && sizeof(aa_fixed) == 8 && (aa_fixed)-1 < (aa_fixed)0, \"avin: the elements of parameter 7 of f\");\n"), text)
    // Lengths are measured as the integers they are; the arrays' typedef is checked by its element test alone.
    assert(text.contains("(unsigned char)sizeof(size_t), (unsigned char)((size_t)-1 < (size_t)0),\n"), text)
    assert(!text.contains("\"avin: the C type aa_fixed\""), text)
    assert_eq(unit.lines.len(), text.split("\n").len)

