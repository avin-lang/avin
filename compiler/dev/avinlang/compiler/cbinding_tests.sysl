    var names: Buf[string] = buf()
    names.push("i")
    names.push("j")
    assert_eq(c_replace_names("data[i].i[j]->i + ii + i", names, "0"), "data[0].i[0]->i + ii + 0")
    assert_eq(c_replace_names("width", names, "0"), "width")
    assert_eq(c_replace_names("", names, "0"), "")

