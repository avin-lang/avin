module dev.avinlang.compiler
@tests

import sh.sysl.parsing.{Source, Span, source_of}
import sysl.buf.{Buf, buf}
import sysl.fs.{make_temp_dir, read_text, remove_dir_all}
import sysl.process.Stdio

// C bindings: reading a prototype, the rules of what crosses as what, the C unit's source, its
// measurements and its cache, and every checked conversion at its boundaries, which the C library in
// tests/c answers.

private prototype(text: string) -> CPrototype = parse_prototype(text).unwrap()

private refused(text: string) -> string = parse_prototype(text) match
    Ok(_) -> "read"
    Err(why) -> why

private keyword(t: CType) -> string = t match
    CKeyword(n) -> "keyword " + n
    CTypedef(n) -> "typedef " + n
    CBoolType -> "bool"
    CDoubleType -> "double"
    CFloatType -> "float"
    CVoidType -> "void"
    CText(constant) -> if constant then "const text" else "text"
    CPointerType -> "pointer"
    CRecordType(n) -> "record " + n

@test("a prototype is read into its symbol, result and parameters, each with the text the header check compares")
prototype_parts()
    val p = prototype("char *mlt_properties_get(mlt_properties self, const char *name)")
    assert_eq(p.symbol, "mlt_properties_get")
    assert_eq(keyword(p.result), "text")
    assert_eq(p.result_text, "char *")
    assert_eq(p.params.len(), 2)
    assert_eq(keyword(p.params[0].ty), "typedef mlt_properties")
    assert_eq(p.params[0].text, "mlt_properties")
    assert_eq(keyword(p.params[1].ty), "const text")
    assert_eq(p.params[1].text, "const char *")
    // No parameters, written either way, and a declaration's own `extern` and `;`.
    assert_eq(prototype("pid_t getpid(void)").params.len(), 0)
    assert_eq(prototype("pid_t getpid()").params.len(), 0)
    val e = prototype("  extern   int\tabs ( int n ) ; ")
    assert_eq(e.symbol, "abs")
    assert_eq(e.params[0].text, "int")
    assert_eq(keyword(prototype("void srand(unsigned)").result), "void")
    // A pointer qualified after its star, and one to a pointer.
    assert_eq(prototype("int f(char *const p)").params[0].text, "char *const")
    assert_eq(prototype("int f(char **p)").params[0].text, "char * *")

@test("one pointer to a plain `char` is a C string, `const` wherever the qualifier is written before the star, and every other pointer is not")
string_prototypes()
    assert_eq(keyword(prototype("char *f(void)").result), "text")
    assert_eq(keyword(prototype("const char *f(void)").result), "const text")
    assert_eq(keyword(prototype("char const *f(void)").result), "const text")
    assert_eq(keyword(prototype("int f(const char *const s)").params[0].ty), "const text")
    assert_eq(keyword(prototype("int f(char *const s)").params[0].ty), "text")
    assert_eq(keyword(prototype("int f(volatile char *s)").params[0].ty), "text")
    assert_eq(keyword(prototype("int f(const char **s)").params[0].ty), "pointer")
    assert_eq(keyword(prototype("int f(char **s)").params[0].ty), "pointer")
    assert_eq(keyword(prototype("int f(const unsigned char *s)").params[0].ty), "pointer")
    assert_eq(keyword(prototype("int f(signed char *s)").params[0].ty), "pointer")
    assert_eq(keyword(prototype("int f(const void *s)").params[0].ty), "pointer")
    assert_eq(keyword(prototype("int f(fixture_text s)").params[0].ty), "typedef fixture_text")
    assert_eq(prototype("const char *f(void)").result_text, "const char *")

@test("a C identifier, as `free:` names one, is a word that is no C keyword")
free_words()
    assert(is_c_identifier("free"))
    assert(is_c_identifier("_x9"))
    assert(!is_c_identifier("9x"))
    assert(!is_c_identifier("int"))
    assert(!is_c_identifier(""))
    assert(!is_c_identifier("a b"))
    assert(!is_c_identifier("a-b"))

@test("every spelling of a C integer type is read as the one spelling of its type")
integer_spellings()
    val cases = [
        ("char", "char"), ("signed char", "signed char"), ("unsigned char", "unsigned char"), ("char signed", "signed char"),
        ("short", "short"), ("short int", "short"), ("signed short int", "short"), ("unsigned short", "unsigned short"), ("short unsigned int", "unsigned short"),
        ("int", "int"), ("signed", "int"), ("signed int", "int"), ("unsigned", "unsigned int"), ("unsigned int", "unsigned int"),
        ("long", "long"), ("long int", "long"), ("signed long", "long"), ("long unsigned int", "unsigned long"), ("unsigned long", "unsigned long"),
        ("long long", "long long"), ("long long int", "long long"), ("unsigned long long", "unsigned long long"), ("long unsigned long", "unsigned long long"),
        ("const int", "int"), ("volatile unsigned", "unsigned int"), ("enum colour", "enum colour")]
    for (written, read) in cases
        val p = prototype(written + " f(" + written + " x)")
        assert_eq(keyword(p.result), "keyword " + read, written)
        assert_eq(keyword(p.params[0].ty), "keyword " + read, written)
    assert_eq(keyword(prototype("_Bool f(bool b)").result), "bool")
    assert_eq(keyword(prototype("bool f(_Bool b)").params[0].ty), "bool")
    assert_eq(keyword(prototype("float f(double x)").result), "float")
    assert_eq(keyword(prototype("float f(double x)").params[0].ty), "double")
    assert_eq(keyword(prototype("size_t f(uint8_t x)").result), "typedef size_t")
    assert_eq(keyword(prototype("struct point f(union u x)").result), "record struct point")
    assert_eq(keyword(prototype("struct point f(union u x)").params[0].ty), "record union u")
    assert_eq(keyword(prototype("struct point *f(void)").result), "pointer")

@test("a parameter taking a function is read as its function pointer's own prototype, its `userdata` beside it")
callback_prototypes()
    val p = prototype("long long f(int n, int (*each)(userdata void *ud, int i), userdata void *ud)")
    assert_eq(p.params.len(), 3)
    assert_eq(p.params[1].name, "each")
    assert_eq(p.params[1].text, "int (*)(void *, int)")
    assert(p.params[1].ty is CPointerType)
    assert_eq(p.params[1].callback.len(), 1)
    val f = p.params[1].callback[0]
    assert_eq(f.symbol, "each")
    assert_eq(f.result_text, "int")
    assert_eq(f.params.len(), 2)
    assert(f.params[0].userdata)
    assert_eq(f.params[0].text, "void *")
    assert(!f.params[1].userdata)
    assert(p.params[2].userdata)
    assert_eq(p.params[2].text, "void *")
    // Neither a `userdata` nor a function's own parameters are the binding's.
    assert_eq(c_avin_positions(p).len(), 2)
    assert_eq(c_callback_positions(f).len(), 1)
    assert_eq(c_callback_of_userdata(p, 2), 1)
    // A function taking nothing, answering nothing, and one whose `userdata` comes last.
    val q = prototype("void g(userdata void *data, void (*done)(int a, userdata void *data))")
    assert_eq(q.params[1].text, "void (*)(int, void *)")
    assert_eq(c_callback_positions(q.params[1].callback[0])[0], 0)
    assert_eq(prototype("void g(void (*f)(userdata void *u), userdata void *u)").params[0].text, "void (*)(void *)")
    // Two functions, each with a `userdata` of its own.
    val two = prototype("void h(void (*a)(userdata void *x), userdata void *x, int (*b)(userdata void *y, double v), userdata void *y)")
    assert_eq(c_callback_of_userdata(two, 1), 0)
    assert_eq(c_callback_of_userdata(two, 3), 2)
    // Memory C lends the function: the length, before or after its pointer, is no parameter of the
    // Avin function, and the pointer is.
    val lent = prototype("int w(int (*write)(userdata void *c, const unsigned char *data, length(data) unsigned int n), userdata void *c)")
    assert_eq(lent.params[0].text, "int (*)(void *, const unsigned char *, unsigned int)")
    val wf = lent.params[0].callback[0]
    assert_eq(wf.params[2].length_of, "data")
    assert_eq(c_callback_positions(wf).len(), 1)
    assert_eq(c_callback_positions(wf)[0], 1)
    val first = prototype("void s(void (*seen)(userdata void *c, length(data) size_t n, uint8_t *data), userdata void *c)").params[0].callback[0]
    assert_eq(c_callback_positions(first).len(), 1)
    assert_eq(c_callback_positions(first)[0], 2)
    assert_eq(c_length_param(first, "data").unwrap(), 1)

@test("a callback's prototype that cannot be found, carried or crossed is refused saying why")
callback_refusals()
    assert_eq(refused("void f(void (*g)(userdata void *u, int x))"), "`g` finds its closure through `u`, and no parameter of the binding is `userdata void *u`")
    assert_eq(refused("void f(void (*g)(userdata void *u, userdata void *v), userdata void *u)"), "`g` takes a function with 2 parameters marked `userdata`, and one carries its closure")
    assert_eq(refused("void f(void (*g)(userdata void *, int), userdata void *u)"), "the `userdata` of `g` is named, as the binding's `userdata` that carries it is")
    assert_eq(refused("void f(void (*)(userdata void *u), userdata void *u)"), "a parameter taking a function is named, as in `void (*listener)(void *)`")
    assert_eq(refused("void f(void (*g)(userdata void *u), void (*h)(userdata void *u), userdata void *u)"), "`u` carries the closure of two functions; a binding takes one function per `userdata`")
    assert_eq(refused("void f(void (*g)(userdata void *u), userdata void *u, userdata void *v)"), "`v` is marked `userdata`, and no parameter takes a function whose `userdata` it carries")
    assert_eq(refused("void f(void (*g)(userdata void *u), userdata int *u)"), "`userdata` marks the `void *` that carries a callback's closure, and `int *` is not `void *`")
    assert_eq(refused("void f(void (*g)(userdata void *u, out int *x), userdata void *u)"), "a callback's parameter is what C calls it with, so it is never `out`")
    // A callback's `length(p)` names a pointer of its own list, once, and marks an integer.
    assert_eq(refused("void f(void (*g)(userdata void *u, const uint8_t *p, length(q) size_t n), userdata void *u)"), "`length(q)` names no parameter of the prototype")
    assert_eq(refused("void f(void (*g)(userdata void *u, int p, length(p) size_t n), userdata void *u)"), "`p` is `int`, and an array is passed as a pointer to its elements, as in `uint8_t *p`")
    assert_eq(refused("void f(void (*g)(userdata void *u, const uint8_t *p, length(p) double n), userdata void *u)"), "`length(p)` marks the parameter carrying the length of `p`, which is an integer, and `double` is not one")
    assert_eq(refused("void f(void (*g)(userdata void *u, const uint8_t *p, length(p) int n, length(p) int m), userdata void *u)"), "the length of `p` is carried by one parameter, and two say `length(p)`")
    assert_eq(refused("void f(const uint8_t *p, void (*g)(userdata void *u, length(p) int n), userdata void *u)"), "`length(p)` names no parameter of the prototype")
    assert_eq(refused("void f(void (*g)(userdata void *u, void (*h)(int)), userdata void *u)"), "a callback's parameter taking a function cannot cross a C binding: a function crosses only as a binding's own parameter")
    assert_eq(refused("void f(void (*g)(userdata void *u), userdata void *u, ...)"), "a variadic function cannot be bound: the types of the arguments `...` takes cannot be checked")
    assert_eq(refused("void f(void (*g)(userdata void *u, ...), userdata void *u)"), "a variadic function cannot be bound: the types of the arguments `...` takes cannot be checked")
    assert_eq(refused("void f(void (g)(userdata void *u), userdata void *u)"), "a parameter taking a function is written as C declares a function pointer, as in `void (*listener)(userdata void *data, int value)`")
    assert_eq(refused("void f(void (*g)(userdata void *u), void userdata *u)"), "`userdata` is written first, before the parameter's type, as in `userdata void *data`")
    assert_eq(refused("char *f(char *(*g)(userdata void *u), userdata void *u)"), "a callback answers C a scalar or an enum mirror; a string it answered would have to outlive the call, which nothing frees")
    assert_eq(refused("void f(userdata void (*g)(userdata void *u), userdata void *u)"), "a parameter taking a function is passed in, with no `userdata`, `out`, `inout` or `length` of its own")

@test("a prototype that is no C declaration, or names what cannot cross, is refused saying why")
prototype_refusals()
    assert_eq(refused("int"), "it names no function: a prototype is a result type, the function's name and its parameters, as in `int abs(int)`")
    assert_eq(refused(""), "a type is missing")
    assert_eq(refused("int f(int, ...)"), "a variadic function cannot be bound: the types of the arguments `...` takes cannot be checked")
    assert_eq(refused("long double f(void)"), "`long double` cannot cross a C binding")
    assert_eq(refused("double long f(void)"), "`long double` cannot cross a C binding")
    assert_eq(refused("int f(unsigned __int128)"), "`__int128` cannot cross a C binding")
    assert_eq(refused("int f(int (*g)(int))"), "`g` takes a function with no `userdata`: C passes the function its closure through the `void *` marked `userdata`, and with none there is nowhere to find it")
    assert_eq(refused("int f(int a[])"), "a parameter declared with brackets is written as the pointer C passes, as in `int *values`, its length carried by a parameter marked `length(values)`")
    assert_eq(refused("int f(inout int n)"), "an `inout` parameter is a pointer C writes the value through, as in `inout int *x`, and `int` is not one")
    assert_eq(refused("int f(out double x)"), "an `out` parameter is a pointer C writes the value through, as in `out int *x`, and `double` is not one")
    assert_eq(refused("int f(out const int *n)"), "C cannot write through the `out` parameter `const int *`: what it points at is `const`")
    assert_eq(refused("int f(out char *const *n)"), "C cannot write through the `out` parameter `char *const *`: what it points at is `const`")
    // A parameter may still be named `out`, after its type.
    assert_eq(prototype("int f(int *out)").params[0].name, "out")
    assert(prototype("int f(int *out)").params[0].mode is CIn)
    assert_eq(refused("int f(int out *n)"), "`out` is written first, before the parameter's type, as in `out int *x`")
    assert_eq(refused("out int f(void)"), "`out` is written first, before the parameter's type, as in `out int *x`")
    assert_eq(refused("int f(out out int *n)"), "`out` is written first, before the parameter's type, as in `out int *x`")
    assert_eq(refused("int f(userdata void *p)"), "`p` is marked `userdata`, and no parameter takes a function whose `userdata` it carries")
    assert_eq(refused("int f(length(a) int n)"), "`length(a)` names no parameter of the prototype")
    assert_eq(refused("inline int f(void)"), "`inline` is not part of a function's prototype")
    assert_eq(refused("int f(void) g"), "`g` follows the parameter list")
    assert_eq(refused("int f(int, )"), "`)` is not a C type")
    assert_eq(refused("int f(int;"), "`;` is not part of a parameter list")
    assert_eq(refused("int f"), "`f` is not followed by its parameters in parentheses")
    assert_eq(refused("int f(int @)"), "`@` is not part of a C prototype")
    assert_eq(refused("short long f(void)"), "those keywords do not make one C type")
    assert_eq(refused("long long long f(void)"), "`long long long` is not a C type")
    assert_eq(refused("float int f(void)"), "`int` does not combine with the type before it")
    assert_eq(refused("int float f(void)"), "`float` does not combine with the type before it")
    assert_eq(refused("int f(struct)"), "`struct` is followed by its tag's name")
    assert_eq(refused("int struct s f(void)"), "`struct` does not combine with the type before it")

@test("one pointer to a typedef is read as a typedef of the whole pointer at a string's position, and nowhere else")
typedef_text_positions()
    assert_eq(c_typedef_pointee("const FT_String *"), Some("FT_String"))
    assert_eq(c_typedef_pointee("FT_String *"), Some("FT_String"))
    assert_eq(c_typedef_pointee("FT_String const *"), Some("FT_String"))
    assert_eq(c_typedef_pointee("const FT_String *const"), Some("FT_String"))
    assert(c_typedef_pointee("FT_String **") is None)
    assert(c_typedef_pointee("const char *") is None)
    assert(c_typedef_pointee("struct s *") is None)
    assert(c_typedef_pointee("FT_String") is None)
    assert(c_text_position(CPointerType, "const FT_String *", TextString(false)) is CTypedef("const FT_String *"))
    assert(c_text_position(CPointerType, "const FT_String *", TextString(true)) is CTypedef("const FT_String *"))
    assert(c_text_position(CPointerType, "FT_String *", TextBytes(false)) is CTypedef("FT_String *"))
    // A handle's pointer to a typedef stays a pointer, and so does one to a struct or a pointer.
    assert(c_text_position(CPointerType, "cairo_t *", NoText) is CPointerType)
    assert(c_text_position(CPointerType, "struct s *", TextString(false)) is CPointerType)
    assert(c_text_position(CPointerType, "FT_String **", TextString(false)) is CPointerType)
    assert(c_text_position(CText(true), "const char *", TextString(false)) is CText(true))
    // Read so, the string's crossing is the typedef's, which the C unit checks.
    val string_type: &Type = Str
    assert_eq(c_crossing_problem(c_text_position(CPointerType, "const FT_String *", TextString(false)), string_type, TextString(false), false), "")
    assert_eq(c_crossing_problem(c_text_position(CPointerType, "FT_String *", TextString(false)), string_type, TextString(false), true), "")
    assert(c_kind_needed(c_text_position(CPointerType, "const FT_String *", TextString(false)), string_type, TextString(false), false) is Some(KindConstText))
    assert(c_kind_needed(c_text_position(CPointerType, "FT_String *", TextString(false)), string_type, TextString(false), true) is Some(KindText))

@test("each C type crosses as the Avin types its kind allows, and a unit result discards any answer but a struct")
crossing_rules()
    val int_type: &Type = Int(32)
    val long_type: &Type = Int(64)
    val byte_type: &Type = Byte
    val bool_type: &Type = Bool
    val real_type: &Type = Real
    val unit_type: &Type = Unit
    val string_type: &Type = Str
    val char_type: &Type = Char
    assert_eq(c_crossing_problem(CKeyword("int"), long_type, NoText, false), "")
    assert_eq(c_crossing_problem(CKeyword("unsigned long"), int_type, NoText, true), "")
    assert(c_crossing_problem(CKeyword("int"), byte_type, NoText, false) != "")
    assert(c_crossing_problem(CKeyword("signed char"), byte_type, NoText, false) != "")
    assert_eq(c_crossing_problem(CKeyword("unsigned char"), byte_type, NoText, false), "")
    assert_eq(c_crossing_problem(CKeyword("unsigned char"), int_type, NoText, false), "")
    assert_eq(c_crossing_problem(CKeyword("char"), byte_type, NoText, true), "")
    assert(c_crossing_problem(CKeyword("char"), int_type, NoText, false) != "")
    assert_eq(c_crossing_problem(CKeyword("enum e"), int_type, NoText, false), "")
    for t in [int_type, byte_type, bool_type, real_type]
        assert_eq(c_crossing_problem(CTypedef("t"), t, NoText, false), "")
    assert(c_crossing_problem(CTypedef("t"), string_type, NoText, false) != "")
    assert(c_crossing_problem(CTypedef("t"), char_type, NoText, false) != "")
    assert_eq(c_crossing_problem(CBoolType, bool_type, NoText, false), "")
    assert(c_crossing_problem(CBoolType, int_type, NoText, false) != "")
    assert_eq(c_crossing_problem(CDoubleType, real_type, NoText, false), "")
    assert_eq(c_crossing_problem(CFloatType, real_type, NoText, true), "")
    assert(c_crossing_problem(CFloatType, long_type, NoText, false) != "")
    assert_eq(c_crossing_problem(CVoidType, unit_type, NoText, true), "")
    assert(c_crossing_problem(CVoidType, int_type, NoText, true) != "")
    assert_eq(c_crossing_problem(CPointerType, unit_type, NoText, true), "")
    assert_eq(c_crossing_problem(CPointerType, long_type, NoText, false), "a C pointer crosses as a handle, a class declared with `@c(type: \"int *\")` naming the pointer's type")
    assert_eq(c_crossing_problem(CRecordType("struct s"), unit_type, NoText, true), "a struct C answers by value is answered as its mirror, a data type declared `@c(struct: \"struct point\")`, or as an opaque value, a class declared `@c(value: \"struct point\")`")
    assert_eq(c_crossing_problem(CRecordType("struct s"), int_type, NoText, false), "a struct by value crosses as its mirror, a data type declared `@c(struct: \"struct point\")`, or as an opaque value, a class declared `@c(value: \"struct point\")`")
    assert_eq(c_crossing_problem(CKeyword("int"), unit_type, NoText, true), "")
    assert(c_crossing_problem(CKeyword("int"), unit_type, NoText, false) != "")
    // An integer used as a truth value crosses as `bool`, except a `char`, which is a byte.
    for name in ["int", "unsigned int", "long", "signed char", "unsigned char", "enum e", "unsigned long long"]
        assert_eq(c_crossing_problem(CKeyword(name), bool_type, NoText, false), "", name)
        assert_eq(c_crossing_problem(CKeyword(name), bool_type, NoText, true), "", name)
    assert_eq(c_crossing_problem(CKeyword("char"), bool_type, NoText, false), "a C `char` crosses as `byte`")
    assert_eq(c_crossing_problem(CKeyword("int"), string_type, NoText, false), "a C integer crosses as an integer type, or `bool` as a truth value")

@test("a C string crosses as a `string` in and a `string` or `Array[byte]` out, each perhaps optional, and nothing else does")
string_crossing_rules()
    val string_type: &Type = Str
    val long_type: &Type = Int(64)
    val unit_type: &Type = Unit
    for optional in [false, true]
        assert_eq(c_crossing_problem(CText(true), string_type, TextString(optional), false), "")
        assert_eq(c_crossing_problem(CText(true), string_type, TextString(optional), true), "")
        assert_eq(c_crossing_problem(CText(false), string_type, TextString(optional), true), "")
        assert_eq(c_crossing_problem(CText(false), string_type, TextBytes(optional), true), "")
        assert_eq(c_crossing_problem(CText(true), string_type, TextBytes(optional), true), "")
        assert_eq(c_crossing_problem(CTypedef("t"), string_type, TextString(optional), false), "")
        assert_eq(c_crossing_problem(CTypedef("t"), string_type, TextBytes(optional), true), "")
        assert_eq(c_crossing_problem(CText(false), string_type, TextString(optional), false), "C may write through a `char *`, so it takes an `Array[byte]`, its length carried by a parameter marked `length(n)`, rather than a `string`")
        assert_eq(c_crossing_problem(CText(true), string_type, TextBytes(optional), false), "an `Array[byte]` parameter is an array, whose length a parameter marked `length(n)` carries")
    assert_eq(c_crossing_problem(CKeyword("int"), string_type, TextString(false), false), "a string crosses as a C `const char *`")
    assert_eq(c_crossing_problem(CKeyword("int"), string_type, TextString(false), true), "a string crosses as a C `const char *` or `char *`")
    assert_eq(c_crossing_problem(CPointerType, string_type, TextString(true), true), "a string crosses as a C `const char *` or `char *`")
    assert_eq(c_crossing_problem(CVoidType, string_type, TextString(false), true), "the C function answers nothing, so the binding's result is `unit`")
    assert_eq(c_crossing_problem(CText(true), long_type, NoText, false), "a C string crosses as `string` or `Option[string]`")
    assert_eq(c_crossing_problem(CText(false), long_type, NoText, true), "a C string crosses as `string`, `Array[byte]`, or either in an `Option`")
    // A string answered to a `unit` result is discarded.
    assert_eq(c_crossing_problem(CText(false), unit_type, NoText, true), "")
    // A typedef crossing as a string is checked to be a pointer to `char`, and is not measured.
    assert(c_kind_needed(CTypedef("t"), string_type, TextString(false), true) is Some(KindText))
    assert(c_kind_needed(CTypedef("t"), string_type, TextString(true), false) is Some(KindConstText))
    assert(c_kind_needed(CText(true), string_type, TextString(false), false) is None)
    assert(!c_kind_measured(KindText))
    assert(!c_kind_measured(KindConstText))
    assert(c_kind_measured(KindBool))
    // An integer keyword crossing as `bool` is measured as an integer, and a typedef is checked to be
    // a `bool` or an integer.
    val bool_type: &Type = Bool
    assert(c_kind_needed(CKeyword("int"), bool_type, NoText, false) is Some(KindInteger))
    assert(c_kind_needed(CTypedef("t"), bool_type, NoText, true) is Some(KindBool))
    assert(c_kind_needed(CBoolType, bool_type, NoText, true) is None)

// A binding as the C unit takes it, in package `p`.
private unit_binding(name: string, text: string, params: Buf[&Type], result: &Type) -> CUnitBinding = text_binding(name, text, params, result, NoText, None)

// A binding whose result carries a string in `form` and is freed with `free`, and whose parameters
// carry none.
private text_binding(name: string, text: string, params: Buf[&Type], result: &Type, form: CTextForm, free: Option[string]) -> CUnitBinding
    var forms: Buf[CTextForm] = buf()
    forms.push(form)
    for _ in params do forms.push(NoText)
    var by_value: Buf[bool] = buf()
    by_value.push(false)
    for _ in params do by_value.push(false)
    CUnitBinding(name, prototype(text), params, result, 0, Span(0, 0), "p", forms, free, buf(), 0, false, by_value, buf(), buf())

private libc(headers: Buf[string]) -> Buf[CLibrary]
    var out: Buf[CLibrary] = buf()
    out.push(CLibrary("p", "libc", None, buf(), headers, ""))
    out

@test("the C unit checks each binding against the header, each typedef's kind, and measures each integer type once")
unit_source()
    var params: Buf[&Type] = buf()
    params.push(Int(64))
    var bindings: Buf[CUnitBinding] = buf()
    bindings.push(unit_binding("labs", "long labs(long)", params, Int(64)))
    bindings.push(unit_binding("echo", "size_t echo(size_t)", params, Int(64)))
    var real_params: Buf[&Type] = buf()
    real_params.push(Real)
    bindings.push(unit_binding("half", "real_t half(real_t)", real_params, Real))
    var headers: Buf[string] = buf()
    headers.push("<stdlib.h>")
    headers.push("framework/mlt.h")
    headers.push("<stdlib.h>")
    val unit = c_unit_source(bindings, buf(), libc(headers))
    val text = unit.text
    assert(text.contains("#include <stdlib.h>\n#include <framework/mlt.h>\n_Static"), text)
    assert(text.contains("_Static_assert(__builtin_types_compatible_p(__typeof__(&labs), long (*)(long)), \"avin: the C binding labs\");\n"), text)
    assert(text.contains("static long (*const avin_c_binding_0)(long) = &labs;\nlong labs(long);\n"), text)
    assert(text.contains("_Static_assert(__builtin_classify_type(*(size_t *)0) == 1, \"avin: the C type size_t\");\n"), text)
    assert(text.contains("_Static_assert(__builtin_classify_type(*(real_t *)0) == 8, \"avin: the C type real_t\");\n"), text)
    // The result and the parameter name one typedef, checked once and measured once.
    assert_eq(text.split("__builtin_classify_type(*(size_t *)0)").len, 2)
    assert_eq(unit.measured.len(), 3)
    assert_eq(unit.measured[0], "long")
    assert_eq(unit.measured[1], "size_t")
    assert_eq(unit.measured[2], "real real_t")
    assert(text.contains("(unsigned char)sizeof(size_t), (unsigned char)((size_t)-1 < (size_t)0),\n"), text)
    assert(text.contains("(unsigned char)sizeof(real_t), 0,\n"), text)
    // Every line clang may name is known for what it is.
    assert_eq(unit.lines.len(), text.split("\n").len)

@test("the C unit checks a string typedef's kind without measuring it, a truth value's typedef as a bool or an integer, and the function `free:` names")
unit_source_strings()
    var none: Buf[&Type] = buf()
    var bindings: Buf[CUnitBinding] = buf()
    bindings.push(text_binding("text", "text_t text(void)", none, Str, TextString(false), Some("text_free")))
    var bools: Buf[&Type] = buf()
    bools.push(Bool)
    bindings.push(unit_binding("truth", "truth_t truth(truth_t)", bools, Bool))
    var headers: Buf[string] = buf()
    headers.push("<stdlib.h>")
    val unit = c_unit_source(bindings, buf(), libc(headers))
    val text = unit.text
    assert(text.contains("_Static_assert(__builtin_types_compatible_p(text_t, char *) || __builtin_types_compatible_p(text_t, const char *), \"avin: the C type text_t\");\n"), text)
    assert(text.contains("_Static_assert(__builtin_types_compatible_p(__typeof__(&text_free), void (*)(void *)) || __builtin_types_compatible_p(__typeof__(&text_free), void (*)(char *)) || __builtin_types_compatible_p(__typeof__(&text_free), void (*)(const char *)) || __builtin_types_compatible_p(__typeof__(&text_free), void (*)(text_t)), \"avin: the free function text_free\");\n"), text)
    assert(text.contains("_Static_assert(__builtin_classify_type(*(truth_t *)0) == 4 || __builtin_classify_type(*(truth_t *)0) == 1, \"avin: the C type truth_t\");\n"), text)
    // Only the truth value is measured; the string is a pointer.
    assert_eq(unit.measured.len(), 1)
    assert_eq(unit.measured[0], "truth_t")
    assert_eq(unit.lines.len(), text.split("\n").len)

@test("the measurements are read out of an object's bytes after their marker, and only a table of the size expected")
measurements_read()
    var keys: Buf[string] = buf()
    keys.push("int")
    keys.push("real f")
    var bytes: Buf[u8] = buf()
    for b in "junk".bytes do bytes.push(b)
    for b in MeasureMarker.bytes do bytes.push(b)
    for b in [2u8, 0u8, 4u8, 1u8, 4u8, 0u8, 9u8] do bytes.push(b)
    val m = read_measures(bytes.view(), keys).unwrap()
    assert_eq(m.get("int").unwrap().bits, 32)
    assert(m.get("int").unwrap().signed)
    assert_eq(m.get("real f").unwrap().bits, 32)
    var one: Buf[string] = buf()
    one.push("int")
    assert(read_measures(bytes.view(), one) is None)
    var short: Buf[u8] = buf()
    for b in MeasureMarker.bytes do short.push(b)
    short.push(2u8)
    short.push(0u8)
    short.push(4u8)
    assert(read_measures(short.view(), keys) is None)
    var none: Buf[u8] = buf()
    for b in "no table here".bytes do none.push(b)
    assert(read_measures(none.view(), keys) is None)

@test("the C unit is compiled once for its source, measured from the object without running it, and compiled again when a binding changes")
unit_cached()
    val dir = make_temp_dir("avin-c-unit").unwrap()
    defer _ = remove_dir_all(dir)
    val real = repository_toolchain()
    val tc = Toolchain(real.root, dir, real.clang, real.sysl, real.pkg_config, dir + "/build")
    var params: Buf[&Type] = buf()
    params.push(Int(32))
    var bindings: Buf[CUnitBinding] = buf()
    bindings.push(unit_binding("abs", "int abs(int)", params, Int(32)))
    var headers: Buf[string] = buf()
    headers.push("<stdlib.h>")
    headers.push("<unistd.h>")
    var sources: Buf[Source] = buf()
    sources.push(source_of("main.avin", "abs(n: int) -> int\n"))
    val first = ensure_c_unit(tc, bindings, buf(), libc(headers), sources).unwrap()
    assert(first.built)
    val object = first.object.unwrap()
    assert(object.starts_with(dir + "/cunit/"), object)
    assert_eq(first.measures.get("int").unwrap().bits, 32)
    assert(first.measures.get("int").unwrap().signed)
    assert_eq(first.link.len(), 0)
    val again = ensure_c_unit(tc, bindings, buf(), libc(headers), sources).unwrap()
    assert(!again.built)
    assert_eq(again.object.unwrap(), object)
    assert_eq(again.measures.get("int").unwrap().bits, 32)
    var wide: Buf[&Type] = buf()
    wide.push(Int(64))
    bindings.push(unit_binding("labs", "unsigned long labs(unsigned long)", wide, Int(64)))
    bindings.push(unit_binding("pid", "pid_t getpid(void)", buf(), Int(64)))
    val changed = ensure_c_unit(tc, bindings, buf(), libc(headers), sources)
    // `labs` answers `long`, so this unit does not compile, and nothing is cached for it.
    assert(changed is Err(_))
    bindings.pop()
    bindings.pop()
    bindings.push(unit_binding("labs", "long labs(long)", wide, Int(64)))
    bindings.push(unit_binding("pid", "pid_t getpid(void)", buf(), Int(64)))
    val third = ensure_c_unit(tc, bindings, buf(), libc(headers), sources).unwrap()
    assert(third.built)
    assert(third.object.unwrap() != object)
    assert_eq(third.measures.get("long").unwrap().bits, 64)
    assert_eq(third.measures.get("pid_t").unwrap().bits, 32)
    assert(third.measures.get("pid_t").unwrap().signed)
    // With no bindings there is no unit, and the libraries are still linked.
    var linked: Buf[CLibrary] = buf()
    var names: Buf[string] = buf()
    names.push("m")
    names.push("m")
    linked.push(CLibrary("p", "libm", None, names, buf(), ""))
    val none = ensure_c_unit(tc, buf(), buf(), linked, sources).unwrap()
    assert(none.object is None)
    assert_eq(none.link.len(), 1)
    assert_eq(none.link[0], "-lm")

@test("every checked conversion of a C binding stops the program at its boundaries, at -O0 and -O2")
