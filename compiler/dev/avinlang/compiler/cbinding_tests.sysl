    var b = unit_binding("Frame.pixels", "unsigned char *frame_data(frame *self)", params, Unit)
    b.symbol = 6
    b.glued = true
    b.by_value = buf()
    for _ in 0..<2 do b.by_value.push(false)
    b.array_outs.push(CUnitArrayOut(1, "__typeof__(*(unsigned char *)0)", Byte, "frame_size(self) * 4", None, true, false))
    var bindings: Buf[CUnitBinding] = buf()
    bindings.push(b)
    var headers: Buf[string] = buf()
    headers.push("<f.h>")
    val text = c_unit_source(bindings, buf(), libc(headers)).text
    assert(text.contains("unsigned char * avin_c_call_6(frame * self, long long *avin_length) {\n    unsigned char * avin_v = frame_data(self);\n   \n    *avin_length = (long long)(frame_size(self) * 4);\n    return avin_v;\n}\n"), text)
    assert(text.contains("_Static_assert(__builtin_classify_type(*(__typeof__(*(unsigned char *)0) *)0) == 1 && sizeof(__typeof__(*(unsigned char *)0)) == 1, \"avin: the bytes Frame.pixels lends\");\n"), text)
    assert(!text.contains("avin_c_array_free_6"), text)

