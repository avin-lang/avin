@test("a field lent as a view answers its pointer and its length through glue, checks its bytes are one byte wide, and a `writable` one that it is not `const`, measuring nothing")
field_view_glue_source()
    var fields: Buf[CUnitField] = buf()
    fields.push(CUnitField("bitmap", 50, "glyph->bitmap.buffer", buf(), buf(), false, None, None, Unit, 0, Span(0, 0), false, "self->glyph->bitmap.pitch * self->glyph->bitmap.rows", ""))
    fields.push(CUnitField("pixels", 51, "glyph->bitmap.buffer", buf(), buf(), false, None, None, Unit, 0, Span(0, 0), true, "4", ""))
    var indices: Buf[string] = buf()
    indices.push("i")
    var bounds: Buf[string] = buf()
    bounds.push("2")
    fields.push(CUnitField("plane", 52, "planes[i]", indices, bounds, false, None, None, Unit, 0, Span(0, 0), false, "self->plane_length", ""))
    var handles: Buf[CUnitHandle] = buf()
    handles.push(CUnitHandle("Face", 3, "FT_Face", true, "FT_Done_Face", None, None, 0, Span(0, 0), "p", buf(), fields, None, None, None))
    var headers: Buf[string] = buf()
    headers.push("<f.h>")
    val unit = c_unit_source(buf(), handles, libc(headers))
    val text = unit.text
    assert(text.contains("_Static_assert(__builtin_classify_type(*(__typeof__(*(avin_c_field_type_50)0) *)0) == 1 && sizeof(__typeof__(*(avin_c_field_type_50)0)) == 1, \"avin: the field bitmap\");\n"), text)
    assert(text.contains("long long avin_c_field_length_50(void *avin_p) {\n    avin_c_type_3 self = (avin_c_type_3)avin_p;\n    return (long long)(self->glyph->bitmap.pitch * self->glyph->bitmap.rows);\n}\n"), text)
    assert(text.contains("void *avin_c_field_get_50(void *avin_p) {\n    avin_c_type_3 self = (avin_c_type_3)avin_p;\n    return (void *)self->glyph->bitmap.buffer;\n}\n"), text)
    assert(!text.contains("avin_c_field_writable_50"), text)
    assert(text.contains("void avin_c_field_writable_51(avin_c_field_type_51 avin_w) { *avin_w = *avin_w; }\n"), text)
    // An indexed view takes its index in the length's glue and the pointer's.
    assert(text.contains("long long avin_c_field_length_52(void *avin_p, long long i) {\n"), text)
    assert(text.contains("void *avin_c_field_get_52(void *avin_p, long long i) {\n    avin_c_type_3 self = (avin_c_type_3)avin_p;\n    return (void *)self->planes[i];\n}\n"), text)
    assert_eq(unit.measured.len(), 0)
    assert_eq(unit.lines.len(), text.split("\n").len)

@test("a callback's view is checked to point at bytes one byte wide, and its length's type measured")
callback_view_unit()
