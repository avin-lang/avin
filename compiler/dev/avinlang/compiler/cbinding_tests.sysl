@test("an `out` or `inout` parameter is a pointer, read with the type it points at, which the header check compares as written")
out_parameters()
    val p = prototype("FT_Error FT_New_Face(FT_Library library, const char *path, out FT_Face *face)")
    assert_eq(p.params.len(), 3)
    assert(p.params[0].mode is CIn)
    assert(p.params[2].mode is COut)
    assert_eq(p.params[2].text, "FT_Face *")
    assert_eq(p.params[2].pointee_text, "FT_Face")
    assert_eq(keyword(p.params[2].pointee), "typedef FT_Face")
    val q = prototype("void f(inout double *x, out const char **s, out cairo_surface_t **h, inout ae_format_t *e)")
    assert(q.params[0].mode is CInOut)
    assert_eq(keyword(q.params[0].pointee), "double")
    assert_eq(q.params[1].pointee_text, "const char *")
    assert_eq(keyword(q.params[1].pointee), "const text")
    assert(q.params[2].pointee is CPointerType)
    assert_eq(q.params[3].text, "ae_format_t *")
    assert_eq(c_out_count(q), 4)
    assert_eq(c_avin_positions(q).len(), 2)
    assert_eq(c_avin_positions(p).len(), 2)
    assert_eq(c_avin_positions(p)[1], 1usize)

// A variant named `name`, with `@c("<text>")` where `text` is given.
private variant(name: string, text: Option[string]) -> Variant
    var annotations: Buf[Annotation] = buf()
    if text is Some(t)
        var args: Buf[AnnotationArg] = buf()
        args.push(AnnotationArg(None, Expr(Span(0, 0), StringLit(t))))
        annotations.push(Annotation(Span(0, 0), "c", args))
    Variant(Span(0, 0), name, buf(), annotations)

@test("a variant's enumerator is the prefix and its words in the prefix's case, or the one its `@c` names")
enumerators()
    val upper = CEnum("cairo_format_t", "CAIRO_FORMAT_")
    assert_eq(c_enumerator(upper, variant("Argb32", None)), "CAIRO_FORMAT_ARGB32")
    assert_eq(c_enumerator(upper, variant("A8", None)), "CAIRO_FORMAT_A8")
    assert_eq(c_enumerator(upper, variant("Rgb16_565", None)), "CAIRO_FORMAT_RGB16_565")
    assert_eq(c_enumerator(CEnum("t", "CAIRO_OPERATOR_"), variant("ColorDodge", None)), "CAIRO_OPERATOR_COLOR_DODGE")
    assert_eq(c_enumerator(CEnum("t", "CAIRO_OPERATOR_"), variant("HslHue", None)), "CAIRO_OPERATOR_HSL_HUE")
    val lower = CEnum("mlt_image_format", "mlt_image_")
    assert_eq(c_enumerator(lower, variant("Yuv420p", None)), "mlt_image_yuv420p")
    assert_eq(c_enumerator(lower, variant("LcdV", None)), "mlt_image_lcd_v")
    // A prefix with no letter, or none at all, and a prefix of both cases, take lower case.
    assert_eq(c_enumerator(CEnum("t", ""), variant("ColorDodge", None)), "color_dodge")
    assert_eq(c_enumerator(CEnum("t", "_"), variant("One", None)), "_one")
    assert_eq(c_enumerator(CEnum("t", "Gdk"), variant("KeyPress", None)), "Gdkkey_press")
    assert_eq(c_enumerator(upper, variant("V1_4", Some("CAIRO_PDF_VERSION_1_4"))), "CAIRO_PDF_VERSION_1_4")
    assert(c_variant_text(variant("A", Some("X"))) == Some("X"))
    assert(c_variant_text(variant("A", None)) is None)

@test("a binding's result splits into the C result and its out values, or is refused saying why")
result_parts()
    var data: Buf[DataSymbol] = buf()
    var two: Buf[&Type] = buf()
    two.push(Int(32))
    two.push(Real)
    val pair: &Type = Tuple(two)
    var three: Buf[&Type] = buf()
    three.push(Int(64))
    three.push(Int(32))
    three.push(Real)
    val triple: &Type = Tuple(three)
    // No out values: the result is the C result's.
    val none = c_result_parts(prototype("int f(void)"), Int(32), data).unwrap()
    assert(*none.result is Int(32))
    assert_eq(none.outs.len(), 0)
    // A `void` C result is left out, one value alone is no tuple.
    val one = c_result_parts(prototype("void f(out int *a)"), Int(32), data).unwrap()
    assert(*one.result is Unit)
    assert_eq(one.outs.len(), 1)
    val both = c_result_parts(prototype("void f(out int *a, out double *b)"), pair, data).unwrap()
    assert_eq(both.outs.len(), 2)
    assert(*both.outs[1] is Real)
    // The C result first, or the out values alone.
    val first = c_result_parts(prototype("long f(out int *a, out double *b)"), triple, data).unwrap()
    assert(*first.result is Int(64))
    assert_eq(first.outs.len(), 2)
    val alone = c_result_parts(prototype("long f(out int *a, out double *b)"), pair, data).unwrap()
    assert(*alone.result is Unit)
    assert_eq(alone.outs.len(), 2)
    val single = c_result_parts(prototype("long f(inout int *a)"), Int(32), data).unwrap()
    assert(*single.result is Unit)
    assert_eq(single.outs.len(), 1)
    // A tuple is never one out value.
    assert(c_result_parts(prototype("void f(out int *a)"), pair, data) is Err(_))
    assert(c_result_parts(prototype("void f(out int *a, out int *b)"), Int(32), data) is Err(_))
    assert(c_result_parts(prototype("int f(out int *a, out int *b)"), Int(32), data) is Err(_))
    assert_eq(c_result_parts(prototype("int f(out int *a)"), triple, data).unwrap_err(), "the binding answers the C result followed by its one out value, a tuple of 2, or its one out value alone")

@test("the values are read out of an object's bytes after their marker, in the target's byte order, only from a table of the count expected")
values_read()
    var entries: Buf[CValueEntry] = buf()
    entries.push(CValueEntry("integer A", CConstInteger, "A", Some(0), None, 0, false))
    entries.push(CValueEntry("real B", CConstReal, "B", Some(1), None, 0, false))
    entries.push(CValueEntry("string C", CConstString, "C", Some(2), None, 0, false))
    entries.push(CValueEntry("string D", CConstString, "D", Some(3), None, 0, false))
    entries.push(CValueEntry("integer E", CConstInteger, "E", Some(4), None, 0, false))
    var bytes: Buf[u8] = buf()
    for b in "junk".bytes do bytes.push(b)
    for b in ValueMarker.bytes do bytes.push(b)
    for b in [5u8, 0u8] do bytes.push(b)
    // -2 and its sign.
    for b in [254u8, 255u8, 255u8, 255u8, 255u8, 255u8, 255u8, 255u8, 1u8] do bytes.push(b)
    // 1.5, binary64.
    for b in [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 248u8, 63u8] do bytes.push(b)
    // "hé" and its NUL.
    for b in [3u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 104u8, 195u8, 169u8, 0u8] do bytes.push(b)
    // One byte that is not UTF-8.
    for b in [1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 255u8, 0u8] do bytes.push(b)
    // The greatest `unsigned long long`, which is no negative number.
    for b in [255u8, 255u8, 255u8, 255u8, 255u8, 255u8, 255u8, 255u8, 0u8] do bytes.push(b)
    val v = read_values(bytes.view(), entries).unwrap()
    assert_eq(v.get("integer A").unwrap().integer, -2i64)
    assert(v.get("integer A").unwrap().negative)
    assert_eq(v.get("real B").unwrap().real, 1.5)
    assert(v.get("string C").unwrap().text == Some("hé"))
    assert(v.get("string D").unwrap().text is None)
    assert_eq(v.get("integer E").unwrap().integer, -1i64)
    assert(!v.get("integer E").unwrap().negative)
    // A table of another count, a cut one, or none.
    var fewer: Buf[CValueEntry] = buf()
    fewer.push(entries[0])
    assert(read_values(bytes.view(), fewer) is None)
    var cut: Buf[u8] = buf()
    for i in 0..<bytes.len() - 3
        cut.push(bytes[i])
    assert(read_values(cut.view(), entries) is None)
    var plain: Buf[u8] = buf()
    for b in "nothing".bytes do plain.push(b)
    assert(read_values(plain.view(), entries) is None)

@test("the C unit checks each mirror's type and each value's kind, then holds every enumerator and constant once in one packed table")
value_source()
    var enums: Buf[CUnitEnum] = buf()
    var enumerators: Buf[string] = buf()
    enumerators.push("E_A")
    enumerators.push("E_B")
    enumerators.push("E_A")
    var named: Buf[bool] = buf()
    var variants: Buf[string] = buf()
    var spans: Buf[Span] = buf()
    for v in ["A", "B", "Again"]
        named.push(false)
        variants.push(v)
        spans.push(Span(0, 0))
    enums.push(CUnitEnum("Mirror", "e_t", enumerators, named, variants, spans, 0, Span(0, 0), "p"))
    var constants: Buf[CUnitConstant] = buf()
    constants.push(CUnitConstant("a", "E_A", CConstInteger, Int(32), 0, Span(0, 0), "p"))
    constants.push(CUnitConstant("r", "R", CConstReal, Real, 0, Span(0, 0), "p"))
    constants.push(CUnitConstant("s", "S", CConstString, Str, 0, Span(0, 0), "p"))
    var headers: Buf[string] = buf()
    headers.push("<e.h>")
    val unit = c_unit_source_of(CUnitParts(buf(), buf(), enums, constants, buf(), buf()), libc(headers))
    val text = unit.text
    assert(text.contains("typedef e_t avin_c_enum_type_0;\n_Static_assert(__builtin_classify_type(*(avin_c_enum_type_0 *)0) == 1, \"avin: the C enum mirror Mirror\");\n"), text)
    assert(text.contains("_Static_assert(__builtin_classify_type(E_A) == 1, \"avin: the C constant E_A\");\n"), text)
    assert(text.contains("_Static_assert(__builtin_classify_type(R) == 8 || __builtin_classify_type(R) == 1, \"avin: the C constant R\");\n"), text)
    assert(text.contains("_Static_assert(__builtin_types_compatible_p(__typeof__(S), char[sizeof(S)]), \"avin: the C constant S\");\n"), text)
    assert(text.contains("    long long v0; unsigned char n0;\n    long long v1; unsigned char n1;\n    double v2;\n    long long v3; char s3[sizeof(S)];\n"), text)
    assert(text.contains("    (long long)(E_A), (E_A) < 0,\n    (long long)(E_B), (E_B) < 0,\n    (double)(R),\n    (long long)sizeof(S) - 1, S,\n"), text)
    // An enumerator held twice, and a constant that is one, are measured once.
    assert_eq(unit.values.len(), 4)
    assert_eq(unit.values[0].key, "integer E_A")
    assert(unit.values[0].mirror == Some(0usize))
    assert_eq(unit.values[3].key, "string S")
    assert(unit.values[3].constant == Some(2usize))
    assert_eq(unit.lines.len(), text.split("\n").len)

