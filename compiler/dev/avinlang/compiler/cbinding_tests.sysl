@test("a struct mirror's field is named in snake_case from its words, or by its own `@c`")
c_struct_field_names()
    val unit = source_of("f.avin", "@c(struct: \"t\")\ndata T(maxXAdvance: real, x0: real, index: long, @c(\"y_bearing\") rise: real, aB: int)\n")
    val file = parse(unit).file
    var names: Buf[string] = buf()
    for item in file.items
        if item is DataItem(d)
            for field in d.variants[0].fields
                names.push(c_struct_field_name(field))
    assert_eq(names.len(), 5)
    assert_eq(names[0], "max_x_advance")
    assert_eq(names[1], "x0")
    assert_eq(names[2], "index")
    assert_eq(names[3], "y_bearing")
    assert_eq(names[4], "a_b")

@test("a struct crosses by value where the prototype writes it with no pointer, and through `const` pointers")
c_struct_positions()
    assert(c_names_struct("as_point", "as_point"))
    assert(c_names_struct("const as_point", "as_point"))
    assert(!c_names_struct("as_point *", "as_point"))
    assert(!c_names_struct("as_point", ""))
    assert(c_points_at_const_struct("const as_point", "as_point"))
    assert(c_points_at_const_struct("as_point const", "as_point"))
    assert(!c_points_at_const_struct("as_point", "as_point"))
    val q = prototype("void f(out as_glyph **glyphs)").params[0]
    assert_eq(c_array_out_element(q), "as_glyph")
    assert(!c_array_out_filled(q))
    val filled = prototype("void f(out double *dashes)").params[0]
    assert_eq(c_array_out_element(filled), "double")
    assert(c_array_out_filled(filled))
    assert(c_array_out_filled(prototype("void f(out as_glyph *glyphs)").params[0]))
    // A pointer marked `null` is passed in, no Avin parameter and no out value, its text as C writes it.
    val nulled = prototype("int s(int n, out int *a, null as_cluster **clusters, null int *num)")
    assert(nulled.params[2].nulled && nulled.params[3].nulled && !nulled.params[1].nulled)
    assert(nulled.params[2].mode is CIn)
    assert_eq(nulled.params[2].text, "as_cluster * *")
    assert_eq(c_avin_positions(nulled).len(), 1)
    assert_eq(c_out_count(nulled), 1)
    assert_eq(c_size_expr("t"), "sizeof(t)")
    assert_eq(c_offset_expr("t", "x"), "__builtin_offsetof(t, x)")
    assert_eq(c_call_glue(7), "avin_c_call_7")
    assert_eq(c_array_free_glue(7, 0), "avin_c_array_free_7")
    assert_eq(c_array_free_glue(7, 2), "avin_c_array_free_7_2")
    assert_eq(c_array_length_param(0), "avin_length")
    assert_eq(c_array_length_param(1), "avin_length1")
    assert_eq(c_array_glue_part("free", 0), "free")
    assert_eq(c_array_glue_part("free", 3), "free3")

// A struct mirror of two fields, the second another mirror's struct, as the C unit takes it.
private unit_struct() -> CUnitStruct
    var fields: Buf[CUnitStructField] = buf()
    fields.push(CUnitStructField("id", "id", false, Int(32), Some(KindInteger), None, "", Span(0, 0)))
    fields.push(CUnitStructField("origin", "origin", false, Unit, None, Some(4), "as_point", Span(0, 0)))
    CUnitStruct("Tagged", 3, "as_tagged_t", fields, 0, Span(0, 0), "p")

@test("the C unit checks a struct mirror's struct, each field's kind or struct, their order and offsets, and that every field is named")
c_unit_struct_checks()
    var structs: Buf[CUnitStruct] = buf()
    structs.push(unit_struct())
    var values: Buf[CUnitValue] = buf()
    values.push(CUnitValue("Event", 2, "as_event", 0, Span(0, 0), "p"))
    var headers: Buf[string] = buf()
    headers.push("<s.h>")
    val unit = c_unit_source_of(CUnitParts(buf(), buf(), buf(), buf(), structs, values), libc(headers))
    val text = unit.text
    assert(text.contains("#pragma clang diagnostic ignored \"-Weverything\"\n"), text)
    // What clang refuses by default stays refused, so a mismatched prototype and an undeclared
    // function in glue are still errors.
    assert(text.contains("#pragma clang diagnostic error \"-Wimplicit-function-declaration\"\n#pragma clang diagnostic error \"-Wimplicit-int\"\n#pragma clang diagnostic error \"-Wint-conversion\"\n#pragma clang diagnostic error \"-Wincompatible-function-pointer-types\"\n"), text)
    assert(text.contains("typedef as_tagged_t avin_c_struct_type_3;\n_Static_assert(__builtin_classify_type(*(avin_c_struct_type_3 *)0) == 12, \"avin: the C struct mirror Tagged\");\n"), text)
    assert(text.contains("typedef __typeof__(((avin_c_struct_type_3 *)0)->id) avin_c_struct_field_3_0;\n"), text)
    assert(text.contains("_Static_assert(__builtin_classify_type(*(avin_c_struct_field_3_0 *)0) == 1, \"avin: the field id of Tagged\");\n"), text)
    assert(text.contains("_Static_assert(__builtin_offsetof(avin_c_struct_type_3, id) == 0, \"avin: the order of Tagged\");\n"), text)
    assert(text.contains("_Static_assert(__builtin_types_compatible_p(avin_c_struct_field_3_1, as_point), \"avin: the field origin of Tagged\");\n"), text)
    assert(text.contains("_Static_assert(__builtin_offsetof(avin_c_struct_type_3, origin) == (__builtin_offsetof(avin_c_struct_type_3, id) + sizeof(avin_c_struct_field_3_0) + _Alignof(avin_c_struct_field_3_1) - 1) / _Alignof(avin_c_struct_field_3_1) * _Alignof(avin_c_struct_field_3_1), \"avin: the order of Tagged\");\n"), text)
    assert(text.contains("_Static_assert(sizeof(avin_c_struct_type_3) == (__builtin_offsetof(avin_c_struct_type_3, origin) + sizeof(avin_c_struct_field_3_1) + _Alignof(avin_c_struct_type_3) - 1) / _Alignof(avin_c_struct_type_3) * _Alignof(avin_c_struct_type_3), \"avin: the fields of Tagged\");\n"), text)
    // The nested mirror's struct is not one of the unit's, so its field is a zero.
    assert(text.contains("#pragma clang diagnostic error \"-Wmissing-field-initializers\"\nstatic const avin_c_struct_type_3 avin_c_struct_full_3 = { 0, 0 };\n#pragma clang diagnostic pop\n"), text)
    assert(text.contains("typedef as_event avin_c_value_type_2;\n"), text)
    // The field's type is measured; the struct's size and the offsets and the value's size are values.
    assert(text.contains("(unsigned char)sizeof(avin_c_struct_field_3_0), (unsigned char)((avin_c_struct_field_3_0)-1 < (avin_c_struct_field_3_0)0),\n"), text)
    assert(text.contains("    (long long)(sizeof(avin_c_struct_type_3)), (sizeof(avin_c_struct_type_3)) < 0,\n"), text)
    assert(text.contains("    (long long)(__builtin_offsetof(avin_c_struct_type_3, origin)), (__builtin_offsetof(avin_c_struct_type_3, origin)) < 0,\n"), text)
    assert(text.contains("    (long long)(sizeof(avin_c_value_type_2)), (sizeof(avin_c_value_type_2)) < 0,\n"), text)
    assert_eq(unit.lines.len(), text.split("\n").len)

@test("a binding passing and answering structs by value is called through glue taking them by pointer")
c_unit_by_value_glue()
    var params: Buf[&Type] = buf()
    params.push(Int(32))
    params.push(Unit)
    params.push(Unit)
    var b = unit_binding("f", "as_point f(int a, as_point p, const as_point *q)", params, Unit)
    b.symbol = 9
    b.glued = true
    b.by_value = buf()
    b.by_value.push(true)
    b.by_value.push(false)
    b.by_value.push(true)
    b.by_value.push(false)
    var bindings: Buf[CUnitBinding] = buf()
    bindings.push(b)
    var headers: Buf[string] = buf()
    headers.push("<s.h>")
    val text = c_unit_source(bindings, buf(), libc(headers)).text
    assert(text.contains("void avin_c_call_9(as_point *avin_r, int a, as_point *avin_s1, const as_point * q) {\n    *avin_r = f(a, *avin_s1, q);\n}\n"), text)

@test("a binding answering an array through `array:` computes its length in its glue and frees it there")
c_unit_array_glue()
    var params: Buf[&Type] = buf()
    params.push(Int(32))
    params.push(Unit)
    params.push(Int(32))
    var b = unit_binding("g", "int g(int n, out as_glyph **glyphs, out int *count)", params, Int(32))
    b.symbol = 4
    b.glued = true
    b.by_value = buf()
    for _ in 0..<4 do b.by_value.push(false)
    b.array_outs.push(CUnitArrayOut(1, "as_glyph", Real, "count * 2", Some("as_glyphs_free"), false, false))
    var bindings: Buf[CUnitBinding] = buf()
    bindings.push(b)
    var headers: Buf[string] = buf()
    headers.push("<s.h>")
    val text = c_unit_source(bindings, buf(), libc(headers)).text
    // A `free:` naming `free` is declared, by the C library's header.
    assert(text.contains("#include <stdlib.h>\n"), text)
    assert(text.contains("int avin_c_call_4(int n, as_glyph * * avin_o1, int * avin_o2, long long *avin_length) {\n    int avin_v = g(n, avin_o1, avin_o2);\n    __typeof__(*avin_o1) glyphs = *avin_o1; __typeof__(*avin_o2) count = *avin_o2;\n    *avin_length = (long long)(count * 2);\n    return avin_v;\n}\n"), text)
    assert(text.contains("_Static_assert(__builtin_classify_type(*(as_glyph *)0) == 8 && sizeof(as_glyph) == 8, \"avin: the elements of the array g answers\");\n"), text)
    assert(text.contains("void avin_c_array_free_4(as_glyph *glyphs) {\n    if (glyphs) { as_glyphs_free((void *)glyphs); }\n}\n"), text)

@test("the glue allocates an array C fills at its length before the call, calls nothing for a length no array holds, and frees it with `free`")
c_unit_filled_array()
    var params: Buf[&Type] = buf()
    params.push(Unit)
    params.push(Unit)
    params.push(Real)
    var b = unit_binding("d", "int d(t *self, out double *dashes, out double *offset)", params, Int(32))
    b.symbol = 5
    b.glued = true
    b.by_value = buf()
    for _ in 0..<4 do b.by_value.push(false)
    b.array_outs.push(CUnitArrayOut(1, "double", Real, "count(self)", Some("free"), false, true))
    var bindings: Buf[CUnitBinding] = buf()
    bindings.push(b)
    var headers: Buf[string] = buf()
    headers.push("<d.h>")
    val text = c_unit_source(bindings, buf(), libc(headers)).text
    assert(text.contains("int avin_c_call_5(t * self, double * *avin_o1, double * avin_o2, long long *avin_length) {\n    long long avin_n0 = (long long)(count(self));\n    *avin_length = avin_n0;\n    if (avin_n0 < 0 || avin_n0 > 2147483647) { int avin_z; __builtin_memset(&avin_z, 0, sizeof avin_z); return avin_z; }\n    *avin_o1 = malloc(sizeof **avin_o1 * (size_t)(avin_n0 > 0 ? avin_n0 : 1));\n    if (!*avin_o1) { int avin_z; __builtin_memset(&avin_z, 0, sizeof avin_z); return avin_z; }\n    int avin_v = d(self, *avin_o1, avin_o2);\n    return avin_v;\n}\n"), text)
    assert(text.contains("void avin_c_array_free_5(double *dashes) {\n    if (dashes) { free((void *)dashes); }\n}\n"), text)

