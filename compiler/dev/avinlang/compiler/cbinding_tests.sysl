@test("a handle's `as:` conversions and field accessors compile into glue checking their types against the headers")
conversion_and_field_glue_source()
    var conversions: Buf[CAs] = buf()
    conversions.push(CAs("mlt_service", "mlt_playlist_service"))
    conversions.push(CAs("FT_GlyphSlot", "self->glyph"))
    var indices: Buf[string] = buf()
    indices.push("i")
    var bounds: Buf[string] = buf()
    bounds.push("self->num_data")
    var fields: Buf[CUnitField] = buf()
    fields.push(CUnitField("x", 40, "data[i].point.x", indices, bounds, false, Some(KindReal), None, Real, 0, Span(0, 0), false, "", ""))
    fields.push(CUnitField("setWidth", 41, "width", buf(), buf(), true, Some(KindInteger), None, Int(32), 0, Span(0, 0), false, "", ""))
    fields.push(CUnitField("next", 42, "next", buf(), buf(), false, None, Some(7), Unit, 0, Span(0, 0), false, "", ""))
    // A struct mirror read and written whole, and a string, first checked not to point at bytes.
    fields.push(CUnitField("bbox", 43, "bbox", buf(), buf(), false, None, None, Unit, 0, Span(0, 0), false, "", "FT_BBox"))
    fields.push(CUnitField("setBbox", 44, "bbox", buf(), buf(), true, None, None, Unit, 0, Span(0, 0), false, "", "FT_BBox"))
    fields.push(CUnitField("family", 45, "family_name", buf(), buf(), false, Some(KindText), None, Unit, 0, Span(0, 0), false, "", ""))
    var handles: Buf[CUnitHandle] = buf()
    handles.push(CUnitHandle("Path", 7, "cairo_path_t *", false, "cairo_path_destroy", None, None, 0, Span(0, 0), "p", conversions, fields, None, None, None))
    var headers: Buf[string] = buf()
    headers.push("<stdlib.h>")
    val unit = c_unit_source(buf(), handles, libc(headers))
    val text = unit.text
    assert(text.contains("typedef mlt_service avin_c_as_type_7_0;\nvoid *avin_c_as_7_0(void *avin_p) {\n    if (!avin_p) return 0;\n"), text)
    assert(text.contains("__builtin_types_compatible_p(__typeof__(mlt_playlist_service(self)), avin_c_as_type_7_0)"), text)
    assert(text.contains("    return (void *)(self->glyph);\n"), text)
    // The field's type is named with its indices at zero, which an unevaluated operand never reads.
    assert(text.contains("typedef __typeof__(((avin_c_type_7)0)->data[0].point.x) avin_c_field_type_40;\n_Static_assert(__builtin_classify_type(*(avin_c_field_type_40 *)0) == 8, \"avin: the field x\");\n"), text)
    assert(text.contains("long long avin_c_field_bound0_40(void *avin_p, long long i) {\n    avin_c_type_7 self = (avin_c_type_7)avin_p;\n    return (long long)(self->num_data);\n}\n"), text)
    assert(text.contains("avin_c_field_type_40 avin_c_field_get_40(void *avin_p, long long i) {\n    avin_c_type_7 self = (avin_c_type_7)avin_p;\n    return self->data[i].point.x;\n}\n"), text)
    assert(text.contains("void avin_c_field_set_41(void *avin_p, avin_c_field_type_41 avin_value) {\n    avin_c_type_7 self = (avin_c_type_7)avin_p;\n    self->width = avin_value;\n}\n"), text)
    assert(text.contains("_Static_assert(__builtin_types_compatible_p(avin_c_field_type_42, avin_c_type_7), \"avin: the field next\");"), text)
    assert(text.contains("_Static_assert(__builtin_types_compatible_p(avin_c_field_type_43, FT_BBox), \"avin: the field bbox\");\n"), text)
    assert(text.contains("void avin_c_field_get_43(void *avin_p, FT_BBox *avin_out) {\n    avin_c_type_7 self = (avin_c_type_7)avin_p;\n    *avin_out = self->bbox;\n}\n"), text)
    assert(text.contains("void avin_c_field_set_44(void *avin_p, const FT_BBox *avin_value) {\n    avin_c_type_7 self = (avin_c_type_7)avin_p;\n    self->bbox = *avin_value;\n}\n"), text)
    assert(text.contains("_Static_assert(!(__builtin_types_compatible_p(avin_c_field_type_45, unsigned char *) || __builtin_types_compatible_p(avin_c_field_type_45, const unsigned char *) || __builtin_types_compatible_p(avin_c_field_type_45, signed char *) || __builtin_types_compatible_p(avin_c_field_type_45, const signed char *)), \"avin: the field family\");\n"), text)
    // A field read or written as a scalar is measured; a handle is not.
    assert_eq(unit.measured.len(), 2)
    assert_eq(unit.measured[0], "real avin_c_field_type_40")
    assert_eq(unit.measured[1], "avin_c_field_type_41")
    assert_eq(unit.lines.len(), text.split("\n").len)
    var as_lines = 0
    var field_lines = 0
    for line in unit.lines
        if line is AsLine(_, _) then as_lines += 1
        if line is FieldLine(_, _, _) then field_lines += 1
    assert_eq(as_lines, 6)
    assert_eq(field_lines, 20)

@test("an `as:` entry is a pointer type, `=`, and a function or an expression in `self`; a field's indices are replaced by name, never as a member")
as_entries_and_names()
    val e = c_as_entry(" mlt_service  =  mlt_playlist_service(self) ").unwrap()
    assert_eq(e.ty, "mlt_service")
    assert_eq(e.expr, "mlt_playlist_service(self)")
    assert_eq(c_as_entry("FT_GlyphSlot = self->glyph").unwrap().expr, "self->glyph")
    assert_eq(c_as_entry("struct  thing* = thing_of").unwrap().ty, "struct thing *")
    assert(c_as_entry("mlt_service") is Err(_))
    assert(c_as_entry("int = f") is Err(_))
    assert(c_as_entry("mlt_service = ") is Err(_))
    assert(c_as_entry("mlt_service = 1 + 2") is Err(_))
    assert(c_as_entry("= f") is Err(_))
    var names: Buf[string] = buf()
    names.push("i")
    names.push("j")
    assert_eq(c_replace_names("data[i].i[j]->i + ii + i", names, "0"), "data[0].i[0]->i + ii + 0")
    assert_eq(c_replace_names("width", names, "0"), "width")
    assert_eq(c_replace_names("", names, "0"), "")

