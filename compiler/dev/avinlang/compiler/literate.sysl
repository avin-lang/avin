module dev.avinlang.compiler

import sh.sysl.parsing.{Diagnostic, Source, source, tangle_literate}
import sysl.buf.{Buf, buf}
import sysl.text.from_utf8_unchecked

// Literate Avin: a `.lavin` file is a Markdown document, and its lines indented four columns are the
// program. Every other line is prose and is not compiled; a fenced block is an illustration, however
// it is indented; an indented block under a list item belongs to the item. The reading itself is
// the parsing package's `tangle_literate`, which also refuses a tab in a line's indentation and a
// fence that is never closed.
//
// **The program is laid over the document rather than cut out of it.** Every line of program text
// keeps its four columns and its bytes, and every byte of prose becomes a space, so the program has
// exactly the document's bytes at exactly the document's offsets. A span, a line and a column the
// compiler records are therefore the document's own: a diagnostic, a trap's position and an
// editor's cursor need no mapping. The lexer takes the four columns off the indentation it
// measures (`literate_margin`), so the program's own indentation starts after them and prose
// between two blocks reads as blank lines.

/** The suffix of a source file written as a Markdown document. */
const LiterateExtension: string = ".lavin"

/** The suffix of an ordinary source file. */
const SourceExtension: string = ".avin"

/** How far a line of a literate file is indented to be program text: Markdown's own threshold. */
const LiterateMargin: usize = 4

/** Whether a file of this name is literate. Only the name decides: an `.avin` file is never read
 * this way, however it is indented. */
is_literate(name: string) -> bool = name.ends_with(LiterateExtension)

/** Whether a file of this name is Avin source, ordinary or literate. */
is_source_name(name: string) -> bool = name.ends_with(SourceExtension) || is_literate(name)

/** The name without its source suffix. */
without_source_extension(name: string) -> string =
    if is_literate(name) then name[0..<name.bytes.len - LiterateExtension.bytes.len]
    elif name.ends_with(SourceExtension) then name[0..<name.bytes.len - SourceExtension.bytes.len]
    else name

/** The columns of every line that are the document's margin rather than the program's
 * indentation: four in a literate file, none in an ordinary one. */
literate_margin(src: Source) -> usize = if is_literate(src.name) then LiterateMargin else 0

/** The program a source holds, at the source's own offsets, or the first thing wrong with a
 * literate file. An ordinary file is its own program. */
literate_program(doc: Source) -> Result[Source, Diagnostic]
    if !is_literate(doc.name) then return Ok(doc)
    val tangled = tangle_literate(doc)?
    var out: Buf[u8] = buf()
    for b in doc.bytes
        out.push(b)
    for line in 1..doc.line_count()
        if !tangled.line_span(line).is_empty() then continue
        val span = doc.line_span(line)
        for i in span.start..<span.end
            if out[i] != u8('\r') && out[i] != u8('\n') then out[i] = u8(' ')
    Ok(source(doc.name, out.view()))

/** The program a literate file holds with its prose stripped and the four columns taken off, line
 * for line with the document: what `avin tangle` prints. */
tangled_program(doc: Source) -> Result[string, Diagnostic]
    val tangled = tangle_literate(doc)?
    Ok(from_utf8_unchecked(tangled.bytes))
