module dev.avinlang.compiler
@tests

import sysl.fs.{canonicalize, current_dir, exists, make_dir_all, make_temp_dir, read_text, remove_dir_all, symlink, write_text}

// A directory holding the library's prelude and the runtime's package, which is what makes a
// toolchain's root.
private fake_toolchain(root: string)
    make_dir_all(root + "/library/avin").unwrap()
    write_text(root + "/library/avin/prelude.avin", "").unwrap()
    make_dir_all(root + "/runtime/avin").unwrap()
    write_text(root + "/runtime/sysl.hocon", "package { name = \"avin-runtime\" }\n").unwrap()
    write_text(root + "/runtime/avin/rt.sysl", "module avin.rt\n").unwrap()

// An installed prefix: the executable at `bin/avin`, the toolchain at `share/avin`.
private fake_prefix(prefix: string)
    make_dir_all(prefix + "/bin").unwrap()
    write_text(prefix + "/bin/avin", "").unwrap()
    fake_toolchain(prefix + "/share/avin")

@test("an installed compiler finds share/avin in its own prefix")
installed_prefix()
    val dir = canonicalize(make_temp_dir("avin-prefix").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    fake_prefix(dir + "/prefix")
    val tc = locate_toolchain(None, Some(dir + "/prefix/bin/avin"), dir + "/cache").unwrap()
    assert_eq(tc.root, dir + "/prefix/share/avin")
    assert_eq(tc.cache, dir + "/cache")

@test("a compiler run through a symbolic link finds the prefix the link resolves to")
linked_executable()
    val dir = canonicalize(make_temp_dir("avin-prefix").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    fake_prefix(dir + "/Cellar/avin/0.0.1")
    make_dir_all(dir + "/bin").unwrap()
    symlink(dir + "/Cellar/avin/0.0.1/bin/avin", dir + "/bin/avin").unwrap()
    val tc = locate_toolchain(None, Some(dir + "/bin/avin"), dir + "/cache").unwrap()
    assert_eq(tc.root, dir + "/Cellar/avin/0.0.1/share/avin")

@test("AVIN_ROOT names the toolchain ahead of the installed one, and an empty one is unset")
avin_root_first()
    val dir = canonicalize(make_temp_dir("avin-prefix").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    fake_prefix(dir + "/prefix")
    fake_toolchain(dir + "/checkout")
    val named = locate_toolchain(Some(dir + "/checkout"), Some(dir + "/prefix/bin/avin"), dir + "/cache").unwrap()
    assert_eq(named.root, dir + "/checkout")
    val empty = locate_toolchain(Some(""), Some(dir + "/prefix/bin/avin"), dir + "/cache").unwrap()
    assert_eq(empty.root, dir + "/prefix/share/avin")
    assert(locate_toolchain(Some(dir + "/absent"), Some(dir + "/prefix/bin/avin"), dir + "/cache") is None)

@test("a source checkout's compiler/avin finds the checkout, and an executable elsewhere finds none")
checkout_layout()
    val dir = canonicalize(make_temp_dir("avin-prefix").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    fake_toolchain(dir + "/checkout")
    make_dir_all(dir + "/checkout/compiler").unwrap()
    write_text(dir + "/checkout/compiler/avin", "").unwrap()
    assert_eq(locate_toolchain(None, Some(dir + "/checkout/compiler/avin"), dir + "/cache").unwrap().root, dir + "/checkout")
    make_dir_all(dir + "/elsewhere/bin").unwrap()
    write_text(dir + "/elsewhere/bin/avin", "").unwrap()
    assert(locate_toolchain(None, Some(dir + "/elsewhere/bin/avin"), dir + "/cache") is None)
    assert(locate_toolchain(None, None, dir + "/cache") is None)

@test("the cache is AVIN_CACHE, else avin/<version> in the user's cache directory, else in the temporary one")
cache_location()
    assert_eq(toolchain_cache(Some("/tmp/mine"), Some("/Users/u/Library/Caches"), None), "/tmp/mine")
    assert_eq(toolchain_cache(None, Some("/Users/u/Library/Caches"), None), "/Users/u/Library/Caches/avin/" + Version)
    assert_eq(toolchain_cache(Some(""), Some("/home/u/.cache"), None), "/home/u/.cache/avin/" + Version)
    assert_eq(toolchain_cache(None, None, Some("/var/tmp/")), "/var/tmp/avin/" + Version)
    assert_eq(toolchain_cache(None, None, None), "/tmp/avin/" + Version)

@test("the toolchain the compiler builds into is never under the installed prefix")
cache_outside_prefix()
    val dir = canonicalize(make_temp_dir("avin-prefix").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    fake_prefix(dir + "/prefix")
    val tc = locate_toolchain(None, Some(dir + "/prefix/bin/avin"), toolchain_cache(None, Some(dir + "/caches"), None)).unwrap()
    assert(!tc.runtime_cache().starts_with(dir + "/prefix"))
    assert(!tc.shim_cache().starts_with(dir + "/prefix"))
    assert(tc.runtime_cache().starts_with(dir + "/caches/avin/"))
    assert(tc.shim_cache().starts_with(dir + "/caches/avin/"))

@test("the runtime a release ships is linked without building it, and an edited runtime is not")
prebuilt_runtime()
    val dir = canonicalize(make_temp_dir("avin-prefix").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    fake_toolchain(dir + "/share/avin")
    // A Sysl that cannot be run proves the shipped archive is taken as it is.
    val tc = Toolchain(dir + "/share/avin", dir + "/cache", "clang", dir + "/no-such-sysl")
    make_dir_all(dir + "/share/avin/lib").unwrap()
    val shipped = tc.prebuilt_runtime(runtime_key(tc))
    write_text(shipped, "!<arch>\n").unwrap()
    assert_eq(ensure_runtime(tc).unwrap(), shipped)
    assert(!exists(dir + "/cache"))
    write_text(dir + "/share/avin/runtime/avin/rt.sysl", "module avin.rt\n\nedited() = 1\n").unwrap()
    assert(tc.prebuilt_runtime(runtime_key(tc)) != shipped)
    val refused = ensure_runtime(tc)
    assert(refused is Err(_))
    if refused is Err(message)
        assert(message.contains("no-such-sysl"), message)
        assert(message.contains("brew install sysl-lang/tap/sysl"), message)

@test("the runtime's key is the same wherever the same sources are installed")
runtime_key_by_content()
    val dir = canonicalize(make_temp_dir("avin-prefix").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    fake_toolchain(dir + "/one")
    fake_toolchain(dir + "/two")
    val one = toolchain_in(dir + "/one", dir + "/cache").unwrap()
    val two = toolchain_in(dir + "/two", dir + "/cache").unwrap()
    assert_eq(runtime_key(one), runtime_key(two))

@test("a missing clang is reported with what installs it")
missing_clang()
    val dir = canonicalize(make_temp_dir("avin-prefix").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    fake_toolchain(dir + "/share/avin")
    val tc = Toolchain(dir + "/share/avin", dir + "/cache", dir + "/no-such-clang", "sysl")
    make_dir_all(dir + "/share/avin/lib").unwrap()
    write_text(tc.prebuilt_runtime(runtime_key(tc)), "!<arch>\n").unwrap()
    val linked = link(tc, "", None, dir + "/program", "-O0")
    assert(linked is Err(_))
    if linked is Err(message)
        assert(message.contains("cannot run `" + dir + "/no-such-clang`"), message)
        assert(message.contains("xcode-select --install"), message)

@test("the compiler's version and its manifest's agree")
version_in_step()
    val here = current_dir().unwrap_or(".")
    val manifest = if exists(here + "/compiler/sysl.hocon") then here + "/compiler/sysl.hocon" else here + "/sysl.hocon"
    val text = read_text(manifest).unwrap()
    assert(text.contains("  version = \"" + Version + "\"\n"), "compiler/sysl.hocon names version " + Version)
