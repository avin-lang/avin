module dev.avinlang.compiler
@tests

import sysl.buf.buf
import sysl.fs.{canonicalize, current_dir, exists, make_dir_all, make_temp_dir, read_text, remove_dir_all, symlink, write_text}

// A directory holding the library's prelude and the runtime's package, which is what makes a
// toolchain's root.
private fake_toolchain(root: string)
    make_dir_all(root + "/library/avin").unwrap()
    write_text(root + "/library/avin/prelude.avin", "").unwrap()
    make_dir_all(root + "/runtime/avin").unwrap()
    write_text(root + "/runtime/sysl.hocon", "package { name = \"avin-runtime\" }\n").unwrap()
    write_text(root + "/runtime/avin/rt.sysl", "module avin.rt\n").unwrap()

// An installed prefix: the executable at `bin/avin`, the toolchain at `share/avin`.
private fake_prefix(prefix: string)
    make_dir_all(prefix + "/bin").unwrap()
    write_text(prefix + "/bin/avin", "").unwrap()
    fake_toolchain(prefix + "/share/avin")

@test("an installed compiler finds share/avin in its own prefix")
installed_prefix()
    val dir = canonicalize(make_temp_dir("avin-prefix").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    fake_prefix(dir + "/prefix")
    val tc = locate_toolchain(None, Some(dir + "/prefix/bin/avin"), dir + "/cache").unwrap()
    assert_eq(tc.root, dir + "/prefix/share/avin")
    assert_eq(tc.cache, dir + "/cache")

@test("a compiler run through a symbolic link finds the prefix the link resolves to")
linked_executable()
    val dir = canonicalize(make_temp_dir("avin-prefix").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    fake_prefix(dir + "/Cellar/avin/0.0.1")
    make_dir_all(dir + "/bin").unwrap()
    symlink(dir + "/Cellar/avin/0.0.1/bin/avin", dir + "/bin/avin").unwrap()
    val tc = locate_toolchain(None, Some(dir + "/bin/avin"), dir + "/cache").unwrap()
    assert_eq(tc.root, dir + "/Cellar/avin/0.0.1/share/avin")

@test("AVIN_ROOT names the toolchain ahead of the installed one, and an empty one is unset")
avin_root_first()
    val dir = canonicalize(make_temp_dir("avin-prefix").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    fake_prefix(dir + "/prefix")
    fake_toolchain(dir + "/checkout")
    val named = locate_toolchain(Some(dir + "/checkout"), Some(dir + "/prefix/bin/avin"), dir + "/cache").unwrap()
    assert_eq(named.root, dir + "/checkout")
    val empty = locate_toolchain(Some(""), Some(dir + "/prefix/bin/avin"), dir + "/cache").unwrap()
    assert_eq(empty.root, dir + "/prefix/share/avin")
    assert(locate_toolchain(Some(dir + "/absent"), Some(dir + "/prefix/bin/avin"), dir + "/cache") is None)

@test("a source checkout's compiler/avin finds the checkout, and an executable elsewhere finds none")
checkout_layout()
    val dir = canonicalize(make_temp_dir("avin-prefix").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    fake_toolchain(dir + "/checkout")
    make_dir_all(dir + "/checkout/compiler").unwrap()
    write_text(dir + "/checkout/compiler/avin", "").unwrap()
    assert_eq(locate_toolchain(None, Some(dir + "/checkout/compiler/avin"), dir + "/cache").unwrap().root, dir + "/checkout")
    make_dir_all(dir + "/elsewhere/bin").unwrap()
    write_text(dir + "/elsewhere/bin/avin", "").unwrap()
    assert(locate_toolchain(None, Some(dir + "/elsewhere/bin/avin"), dir + "/cache") is None)
    assert(locate_toolchain(None, None, dir + "/cache") is None)

@test("the cache is AVIN_CACHE, else avin/<version> in the user's cache directory, else in the temporary one")
cache_location()
    assert_eq(toolchain_cache(Some("/tmp/mine"), Some("/Users/u/Library/Caches"), None), "/tmp/mine")
    assert_eq(toolchain_cache(None, Some("/Users/u/Library/Caches"), None), "/Users/u/Library/Caches/avin/" + Version)
    assert_eq(toolchain_cache(Some(""), Some("/home/u/.cache"), None), "/home/u/.cache/avin/" + Version)
    assert_eq(toolchain_cache(None, None, Some("/var/tmp/")), "/var/tmp/avin/" + Version)
    assert_eq(toolchain_cache(None, None, None), "/tmp/avin/" + Version)

@test("the toolchain the compiler builds into is never under the installed prefix")
cache_outside_prefix()
    val dir = canonicalize(make_temp_dir("avin-prefix").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    fake_prefix(dir + "/prefix")
    val tc = locate_toolchain(None, Some(dir + "/prefix/bin/avin"), toolchain_cache(None, Some(dir + "/caches"), None)).unwrap()
    assert(!tc.runtime_cache().starts_with(dir + "/prefix"))
    assert(!tc.shim_cache().starts_with(dir + "/prefix"))
    assert(tc.runtime_cache().starts_with(dir + "/caches/avin/"))
    assert(tc.shim_cache().starts_with(dir + "/caches/avin/"))

@test("the runtime a release ships is linked without building it, and an edited runtime is not")
prebuilt_runtime()
    val dir = canonicalize(make_temp_dir("avin-prefix").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    fake_toolchain(dir + "/share/avin")
    // A Sysl that cannot be run proves the shipped archive is taken as it is.
    val tc = Toolchain(dir + "/share/avin", dir + "/cache", "clang", dir + "/no-such-sysl", "pkg-config", dir + "/cache/build", host_target())
    make_dir_all(dir + "/share/avin/lib/" + tc.target).unwrap()
    val shipped = tc.prebuilt_runtime(runtime_key(tc))
    write_text(shipped, "!<arch>\n").unwrap()
    assert_eq(ensure_runtime(tc).unwrap(), shipped)
    assert(!exists(dir + "/cache"))
    write_text(dir + "/share/avin/runtime/avin/rt.sysl", "module avin.rt\n\nedited() = 1\n").unwrap()
    assert(tc.prebuilt_runtime(runtime_key(tc)) != shipped)
    val refused = ensure_runtime(tc)
    assert(refused is Err(_))
    if refused is Err(message)
        assert(message.contains("no-such-sysl"), message)
        assert(message.contains("brew install sysl-lang/tap/sysl"), message)

@test("the runtime's key is the same wherever the same sources are installed")
runtime_key_by_content()
    val dir = canonicalize(make_temp_dir("avin-prefix").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    fake_toolchain(dir + "/one")
    fake_toolchain(dir + "/two")
    val one = toolchain_in(dir + "/one", dir + "/cache").unwrap()
    val two = toolchain_in(dir + "/two", dir + "/cache").unwrap()
    assert_eq(runtime_key(one), runtime_key(two))

@test("a toolchain's runtime key and archive names carry its target, and two targets share nothing")
runtime_names_by_target()
    val dir = canonicalize(make_temp_dir("avin-prefix").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    fake_toolchain(dir + "/share/avin")
    val mac = toolchain_in(dir + "/share/avin", dir + "/cache").unwrap().for_target("aarch64-macos")
    val linux = mac.for_target("x86_64-linux")
    assert(runtime_key(mac) != runtime_key(linux))
    assert_eq(runtime_key(mac), runtime_key(mac.for_target("aarch64-macos")))
    assert_eq(runtime_archive_name("x86_64-linux", "abc"), "libavinrt-x86_64-linux-abc.a")
    assert_eq(mac.runtime_archive("k"), dir + "/cache/runtime/libavinrt-aarch64-macos-k.a")
    assert_eq(linux.runtime_archive("k"), dir + "/cache/runtime/libavinrt-x86_64-linux-k.a")
    assert_eq(mac.prebuilt_runtime("k"), dir + "/share/avin/lib/aarch64-macos/libavinrt-aarch64-macos-k.a")
    assert_eq(linux.prebuilt_runtime("k"), dir + "/share/avin/lib/x86_64-linux/libavinrt-x86_64-linux-k.a")
    assert(mac.prebuilt_runtime(runtime_key(mac)) != linux.prebuilt_runtime(runtime_key(linux)))

@test("every kept entry is named by the target of the toolchain that keeps it")
entries_by_target()
    val dir = canonicalize(make_temp_dir("avin-prefix").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    fake_toolchain(dir + "/share/avin")
    val mac = toolchain_in(dir + "/share/avin", dir + "/cache").unwrap().for_target("aarch64-macos")
    val linux = mac.for_target("x86_64-linux")
    assert_eq(mac.entry_in(mac.c_unit_cache(), "k", ".o"), dir + "/cache/cunit/aarch64-macos-k.o")
    assert_eq(linux.entry_in(linux.c_unit_cache(), "k", ".o"), dir + "/cache/cunit/x86_64-linux-k.o")
    assert_eq(linux.entry_in(linux.shim_cache(), "k", ".a"), dir + "/cache/shims/x86_64-linux-k.a")
    assert_eq(linux.for_target("aarch64-macos").target, "aarch64-macos")
    // The toolchain's other fields do not change with its target.
    assert_eq(linux.cache, mac.cache)
    assert_eq(linux.builds, mac.builds)
    assert_eq(linux.runtime_cache(), mac.runtime_cache())
    // The compiler's own machine is the default.
    assert_eq(toolchain_in(dir + "/share/avin", dir + "/cache").unwrap().target, host_target())

@test("an installed prefix finds its own target's archive and no other's")
prebuilt_by_target()
    val dir = canonicalize(make_temp_dir("avin-prefix").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    fake_toolchain(dir + "/share/avin")
    // A Sysl that cannot be run proves a shipped archive is taken as it is, and its absence is not.
    val mac = Toolchain(dir + "/share/avin", dir + "/cache", "clang", dir + "/no-such-sysl", "pkg-config", dir + "/cache/build", "aarch64-macos")
    val linux = mac.for_target("x86_64-linux")
    make_dir_all(dir + "/share/avin/lib/aarch64-macos").unwrap()
    val shipped = mac.prebuilt_runtime(runtime_key(mac))
    write_text(shipped, "!<arch>\n").unwrap()
    assert_eq(ensure_runtime(mac).unwrap(), shipped)
    // The other target has no archive shipped: it is built, here with a Sysl that is not there.
    val refused = ensure_runtime(linux)
    assert(refused is Err(_))
    if refused is Err(message)
        assert(message.contains("no-such-sysl"), message)

@test("the instance and executable caches of a program are disjoint per target, and the same target finds its own")
build_cache_by_target()
    val builds = "/c/avin/0.0.2/build"
    val mac = build_cache_for(builds, "/p/x.avin", "aarch64-macos")
    val linux = build_cache_for(builds, "/p/x.avin", "x86_64-linux")
    assert(mac != linux)
    assert_eq(mac, build_cache_for(builds, "/p/x.avin", "aarch64-macos"))
    assert(mac.contains("-aarch64-macos-"))
    assert(linux.contains("-x86_64-linux-"))
    assert(program_instance_cache_for(builds, "/p/x.avin", false, "-O2", "aarch64-macos") != program_instance_cache_for(builds, "/p/x.avin", false, "-O2", "x86_64-linux"))
    assert(program_instance_cache_for(builds, "/p/x.avin", false, "-O2", "x86_64-linux").starts_with(linux + "/"))
    // The host's name is the default.
    assert_eq(build_cache(builds, "/p/x.avin"), build_cache_for(builds, "/p/x.avin", host_target()))
    // Without a cache directory the host keeps `.avin/build` and another machine a directory of its own.
    assert_eq(local_build_cache_for("/p/dir.avin", host_target()), "/p/.avin/build")
    val other = if host_target() == "x86_64-linux" then "aarch64-linux" else "x86_64-linux"
    assert_eq(local_build_cache_for("/p/dir.avin", other), "/p/.avin/build/" + other)

@test("a missing clang is reported with what installs it")
missing_clang()
    val dir = canonicalize(make_temp_dir("avin-prefix").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    fake_toolchain(dir + "/share/avin")
    val tc = Toolchain(dir + "/share/avin", dir + "/cache", dir + "/no-such-clang", "sysl", "pkg-config", dir + "/cache/build", host_target())
    make_dir_all(dir + "/share/avin/lib/" + tc.target).unwrap()
    write_text(tc.prebuilt_runtime(runtime_key(tc)), "!<arch>\n").unwrap()
    val linked = link(tc, "", None, dir + "/program", "-O0", buf())
    assert(linked is Err(_))
    if linked is Err(message)
        assert(message.contains("cannot run `" + dir + "/no-such-clang`"), message)
        assert(message.contains("xcode-select --install"), message)

@test("the compiler's version and its manifest's agree")
version_in_step()
    val here = current_dir().unwrap_or(".")
    val manifest = if exists(here + "/compiler/sysl.hocon") then here + "/compiler/sysl.hocon" else here + "/sysl.hocon"
    val text = read_text(manifest).unwrap()
    assert(text.contains("  version = \"" + Version + "\"\n"), "compiler/sysl.hocon names version " + Version)

private stamped_toolchain(root: string, manifest: Option[string]) -> Toolchain
    fake_toolchain(root)
    if manifest is Some(text) then write_text(root + "/library/library.hocon", text).unwrap()
    toolchain_in(root, root + "/cache").unwrap()

private library_manifest(version: string) -> string = "package { name = \"avin-library\", version = \"" + version + "\" }\n"

@test("a library stamped with the compiler's version passes the check")
library_version_matches()
    val dir = canonicalize(make_temp_dir("avin-libver").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    assert(library_version_error(stamped_toolchain(dir + "/a", Some(library_manifest(Version)))) is None)

@test("a library of another version is refused with one error naming both versions and the library")
library_version_mismatch()
    val dir = canonicalize(make_temp_dir("avin-libver").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    for other in ["0.0.1", "99.0.0", "0.0.190", "0.1.0"]
        val tc = stamped_toolchain(dir + "/" + other, Some(library_manifest(other)))
        val message = library_version_error(tc).unwrap()
        assert(message.contains("is version " + other + ", and this compiler is version " + Version), message)
        assert(message.contains(tc.library_dir()), message)
        assert(!message.contains("\n"), message)

@test("a library with no version, no manifest or an unreadable manifest is refused")
library_version_missing()
    val dir = canonicalize(make_temp_dir("avin-libver").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    val none = library_version_error(stamped_toolchain(dir + "/none", None)).unwrap()
    assert(none.contains("carries no version"), none)
    assert(none.contains(Version), none)
    val bare = library_version_error(stamped_toolchain(dir + "/bare", Some("package { name = \"avin-library\" }\n"))).unwrap()
    assert(bare.contains("has no `version`") && bare.contains("library.hocon"), bare)
    val broken = library_version_error(stamped_toolchain(dir + "/broken", Some("sysl-dependencies = 3\n"))).unwrap()
    assert(broken.contains("library.hocon"), broken)

@test("check against a library of another version prints the one error and no library diagnostics, for every command that compiles")
library_version_refused_before_compiling()
    val dir = canonicalize(make_temp_dir("avin-libver").unwrap()).unwrap()
    defer _ = remove_dir_all(dir)
    val tc = stamped_toolchain(dir + "/old", Some(library_manifest("0.0.1")))
    write_text(tc.library_dir() + "/avin/prelude.avin", "this is not avin at all\n").unwrap()
    write_text(dir + "/p.avin", "main() = 0\n").unwrap()
    for command in ["check", "build", "run", "test"]
        var noted = ""
        val status = run_cli(["avin", command, dir + "/p.avin"], Some(tc), s -> (), s -> noted = noted + s + "\n")
        assert_eq(status, 1)
        assert(noted.starts_with("avin: the standard library at "), noted)
        assert(noted.contains("is version 0.0.1"), noted)
        assert_eq(noted.split("\n").len, 2)

@test("the library's version and the compiler's agree in the checkout")
library_version_in_step()
    val here = current_dir().unwrap_or(".")
    val manifest = if exists(here + "/library/library.hocon") then here + "/library/library.hocon" else here + "/../library/library.hocon"
    val text = read_text(manifest).unwrap()
    assert(text.contains("version = \"" + Version + "\" }"), "library/library.hocon names version " + Version)
