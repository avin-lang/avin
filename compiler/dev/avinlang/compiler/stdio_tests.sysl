module dev.avinlang.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{current_dir, exists, make_dir_all, remove_dir_all}
import sysl.process.{Var, capture}

// `avin.io.stdin()`, `stdout()` and `stderr()`: standard input, output and error as bytes, through
// real pipes, files, `/dev/null`, closed descriptors and a terminal. `tests/stdio/stdio_bytes.avin`
// is built at both optimization levels and run by the shell, its first argument picking what it does;
// the terminal cases run `tests/pty/stdio_tty.avin` under `tests/pty/pty_drive.c`.

/** Where the executables are built: the directory the runner-watch tests build the compiler into,
 * which their hooks make before any test of the module and remove after the last. */
private const StdioDir: string = ".scratch/runner-watch-tests"

private stdio_levels() -> []const string = ["-O0", "-O2"]

private stdio_env() -> Buf[Var]
    var env: Buf[Var] = buf()
    env.push(Var("AVIN_ROOT", current_dir().unwrap()))
    env

/** The executable of `file` at `level`, built the first time it is asked for. */
private stdio_built(file: string, name: string, level: string) -> string
    val root = current_dir().unwrap() + "/" + StdioDir
    val bin = root + "/" + name + level
    if !exists(bin)
        val ran = capture(root + "/avin", ["build", file, level, "-o", bin], env = stdio_env().view(), stderr = true, timeout = 600000).unwrap()
        assert(ran.status.ok(), name + " " + level + ": " + ran.text + ran.err.unwrap_or(""))
    bin

/** The test program at `level`. */
private stdio_program(level: string) -> string = stdio_built("tests/stdio/stdio_bytes.avin", "stdio_bytes", level)

/** A directory of the test's own for files the shell makes. */
private stdio_scratch(name: string) -> string
    val dir = current_dir().unwrap() + "/" + StdioDir + "/stdio-" + name
    make_dir_all(dir).unwrap()
    dir

/** Runs `script` with `sh`, `$P` the program at `level` and `$D` the directory `dir`; what it wrote
 * to standard output, then `--- err`, then what it wrote to standard error. */
private stdio_shell(level: string, dir: string, script: string) -> string
    val all = "P='" + stdio_program(level) + "'; D='" + dir + "'; " + script
    val ran = capture("sh", ["-c", all], stderr = true, timeout = 300000).unwrap()
    assert(ran.status.ok(), level + ": the script failed: " + script + "\n" + ran.text + ran.err.unwrap_or(""))
    ran.text + "--- err\n" + ran.err.unwrap_or("")

@test("every byte value, and bytes that are not UTF-8, cross a pipe unchanged in both directions")
all_byte_values()
    val dir = stdio_scratch("bytes")
    defer _ = remove_dir_all(dir)
    for level in stdio_levels()
        val out = stdio_shell(level, dir, "$P gen 256 | $P cat | $P check 256")
        assert(out.starts_with("ok 256\n"), level + ":\n" + out)
        assert(out.contains("copied Ok(256)"), level + ":\n" + out)
        val odd = stdio_shell(level, dir, "printf 'a\\377\\376\\303(\\000z\\200' | $P codes")
        assert(odd.starts_with("97 255 254 195 40 0 122 128\n"), level + ":\n" + odd)

@test("10 MB through two pipes, and through a file to a file, arrive whole and in order")
ten_megabytes()
    val dir = stdio_scratch("large")
    defer _ = remove_dir_all(dir)
    for level in stdio_levels()
        val piped = stdio_shell(level, dir, "$P gen 10485760 | $P cat | $P check 10485760")
        assert(piped.starts_with("ok 10485760\n"), level + ":\n" + piped)
        val filed = stdio_shell(level, dir, "$P gen 10485760 > $D/a; $P cat < $D/a > $D/b; cmp $D/a $D/b && echo same; $P check 10485760 < $D/b")
        assert(filed.starts_with("same\nok 10485760\n"), level + ":\n" + filed)

@test("standard input from /dev/null and from an empty file is at its end at once")
empty_inputs()
    val dir = stdio_scratch("empty")
    defer _ = remove_dir_all(dir)
    for level in stdio_levels()
        val nothing = stdio_shell(level, dir, "$P read < /dev/null; $P cat < /dev/null | wc -c | tr -d ' '")
        assert(nothing.starts_with("ok 0\n0\n"), level + ":\n" + nothing)
        assert(nothing.contains("copied Ok(0)"), level + ":\n" + nothing)
        val empty = stdio_shell(level, dir, ": > $D/e; $P eof < $D/e")
        assert(empty.starts_with("total 0, then [Ok(0), Ok(0), Ok(0)], line None, all []\n"), level + ":\n" + empty)

@test("after the end every read answers an empty array, and the text readers see the end too")
stdio_end_of_input()
    val dir = stdio_scratch("eof")
    defer _ = remove_dir_all(dir)
    for level in stdio_levels()
        val piped = stdio_shell(level, dir, "printf 'hello world, twenty-six' | $P eof")
        assert(piped.starts_with("total 23, then [Ok(0), Ok(0), Ok(0)], line None, all []\n"), level + ":\n" + piped)
        val filed = stdio_shell(level, dir, "printf 'abc' > $D/f; $P eof < $D/f")
        assert(filed.starts_with("total 3, then [Ok(0), Ok(0), Ok(0)], line None, all []\n"), level + ":\n" + filed)

/** What `mix` says of `head\r\nABCDEtail line\nrest\xff`, however it arrives. */
private const StdioMixed: string = "line: Some(head)\nbytes: Ok(65 66 67 68 69)\nline: Some(tail line)\nbytes: Ok(114 101 115 116 255)\nbytes: Ok()\nline: None\nall: []\n"

@test("a line, then bytes, then a line: one buffer, so no byte is lost or read twice, from a file or a pipe")
lines_and_bytes_mixed()
    val dir = stdio_scratch("mix")
    defer _ = remove_dir_all(dir)
    for level in stdio_levels()
        val filed = stdio_shell(level, dir, "printf 'head\\r\\nABCDEtail line\\nrest\\377' > $D/m; $P mix < $D/m")
        assert(filed.starts_with(StdioMixed), level + ":\n" + filed)
        val piped = stdio_shell(level, dir, "printf 'head\\r\\nABCDEtail line\\nrest\\377' | $P mix")
        assert(piped.starts_with(StdioMixed), level + ":\n" + piped)
        // Arriving in pieces, a byte read answers what has come and the line goes on from there.
        val pieces = stdio_shell(level, dir, "(printf 'head\\r\\nAB'; sleep 0.3; printf 'CDEtail line\\nrest\\377') | $P mix")
        assert(pieces.starts_with("line: Some(head)\nbytes: Ok(65 66)\nline: Some(CDEtail line)\nbytes: Ok(114 101 115 116 255)\n"), level + ":\n" + pieces)

@test("bytes, then the lines iterator, then bytes: the iterator takes whole lines only")
bytes_and_lines_iterator()
    val dir = stdio_scratch("iter")
    defer _ = remove_dir_all(dir)
    for level in stdio_levels()
        val out = stdio_shell(level, dir, "printf 'xyline one\\nabcmore\\n' | $P mix-lines")
        assert(out.starts_with("bytes: Ok(120 121)\nnext: line one\nbytes: Ok(97 98 99)\nrest: 5\n"), level + ":\n" + out)

@test("four threads reading at once are served one at a time: each gets runs of the input, and between them every byte once")
threads_serialized()
    val dir = stdio_scratch("threads")
    defer _ = remove_dir_all(dir)
    for level in stdio_levels()
        val out = stdio_shell(level, dir, "$P gen 200000 | $P threads 200000")
        assert(out.contains("threads: 200000 bytes, sum right, every thread read: true, \n"), level + ":\n" + out)

@test("a thread waiting on an empty pipe parks: other threads run and finish before the input comes")
waiting_reader_parks()
    val dir = stdio_scratch("park")
    defer _ = remove_dir_all(dir)
    for level in stdio_levels()
        val out = stdio_shell(level, dir, "(sleep 1; printf hello) | $P park")
        assert(out.starts_with("others ran: 32\nreader got: Ok(5)\n"), level + ":\n" + out)

@test("a write to standard output or error whose reader has gone answers ConnectionReset, again on the next write, and the program goes on")
closed_pipe()
    val dir = stdio_scratch("epipe")
    defer _ = remove_dir_all(dir)
    for level in stdio_levels()
        val out = stdio_shell(level, dir, "$P epipe | head -c 10 > /dev/null")
        // Whether a whole write went before the reader left depends on how fast it left.
        assert(out.contains("stdout: cannot write standard output: connection reset by peer; reset true; after some "), level + ":\n" + out)
        assert(out.contains("again: true\nexit-ok\n"), level + ":\n" + out)
        val err = stdio_shell(level, dir, "$P epipe-err 2>&1 > $D/said | head -c 10 > /dev/null; cat $D/said")
        assert(err.starts_with("stderr: cannot write standard error: connection reset by peer; reset true; after some "), level + ":\n" + err)
        assert(err.contains("\nagain: true\nstderr: survived\n"), level + ":\n" + err)
        // Gone before the program writes, or soon after: whichever, the write fails and the program goes on.
        val gone = stdio_shell(level, dir, "$P epipe | true")
        assert(gone.contains("stdout: cannot write standard output: connection reset by peer; reset true; after some "), level + ":\n" + gone)
        assert(gone.contains("again: true\nexit-ok\n"), level + ":\n" + gone)

@test("println from several threads interleaved with byte writes keeps every line whole and each thread's in order")
lines_kept_whole()
    val dir = stdio_scratch("interleave")
    defer _ = remove_dir_all(dir)
    for level in stdio_levels()
        val piped = stdio_shell(level, dir, "$P interleave | $P verify")
        assert(piped.starts_with("ok 1600 lines\n"), level + ":\n" + piped)
        val filed = stdio_shell(level, dir, "$P interleave > $D/out; $P verify < $D/out")
        assert(filed.starts_with("ok 1600 lines\n"), level + ":\n" + filed)

@test("print and byte writes come out in the order they were made, standard error after the output before it")
order_of_writes()
    val dir = stdio_scratch("order")
    defer _ = remove_dir_all(dir)
    for level in stdio_levels()
        val out = stdio_shell(level, dir, "$P order 2>&1 | cat")
        assert(out.starts_with("p1 b1 p2\ne1\np3 e2\nb2 p4\nempty: Ok(())\n"), level + ":\n" + out)
        val filed = stdio_shell(level, dir, "$P order > $D/o 2>&1; cat $D/o")
        assert(filed.starts_with("p1 b1 p2\ne1\np3 e2\nb2 p4\nempty: Ok(())\n"), level + ":\n" + filed)

@test("a read that fails answers Err with the platform's sentence; a read of fewer than one byte traps")
failed_reads()
    val dir = stdio_scratch("fail")
    defer _ = remove_dir_all(dir)
    for level in stdio_levels()
        val dir_input = stdio_shell(level, dir, "$P read < /")
        assert(dir_input.starts_with("err cannot read standard input: is a directory\n"), level + ":\n" + dir_input)
        val zero = stdio_shell(level, dir, "printf x | $P read-zero; echo \"exit $?\"")
        assert(zero.contains("exit 133"), level + ":\n" + zero)
        assert(zero.contains("a read of 0 bytes: a read takes at least one"), level + ":\n" + zero)

@test("a program started with standard input, output or error closed sees /dev/null there, never the runtime's own descriptors")
closed_descriptors()
    val dir = stdio_scratch("closed")
    defer _ = remove_dir_all(dir)
    for level in stdio_levels()
        val input = stdio_shell(level, dir, "$P read <&-; $P line <&-")
        assert(input.starts_with("ok 0\n"), level + ":\n" + input)
        assert(input.contains("line: None"), level + ":\n" + input)
        val output = stdio_shell(level, dir, "$P write >&-")
        assert(output.contains("write: Ok(())"), level + ":\n" + output)
        val error = stdio_shell(level, dir, "$P write 2>&-")
        assert(error.starts_with("x"), level + ":\n" + error)

/** The pty driver, compiled the first time it is asked for. */
private stdio_driver() -> string
    val bin = current_dir().unwrap() + "/" + StdioDir + "/stdio_pty_drive"
    if !exists(bin)
        val made = capture("cc", ["-O1", "-o", bin, "tests/pty/pty_drive.c", "-lutil"], stderr = true, timeout = 120000).unwrap()
        assert(made.status.ok(), made.err.unwrap_or(""))
    bin

@test("a terminal as standard input and output: each typed line is read as bytes when it is entered, and the end of input ends the reads")
stdio_terminal()
    for level in stdio_levels()
        val bin = stdio_built("tests/pty/stdio_tty.avin", "stdio_tty", level)
        val ran = capture(stdio_driver(), ["expect:ready", "send:héllo\\n", "expect:[7]", "send:x\\n", "expect:[2]", "eof", "expect:ended", "--", bin], stderr = true, timeout = 180000).unwrap()
        assert(ran.status.ok(), ran.text + ran.err.unwrap_or(""))
        assert(!ran.text.contains("[timeout]"), level + ":\n" + ran.text)
        assert(ran.text.contains("[exit 0]"), level + ":\n" + ran.text)
