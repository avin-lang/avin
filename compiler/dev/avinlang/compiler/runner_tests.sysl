module dev.avinlang.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.fs.{exists, make_dir_all, make_temp_dir, read_text, remove_dir_all, remove_file, write_text}
import sysl.process.Stdio

// `avin run` and `avin test`, through the command line as a person types it, with the program's
// own output sent to files so it can be read back.

private struct Session
    status: int
    said: string
    noted: string
    out: string
    err: string

private session(dir: string, args: []const string) -> Session = session_in(".", dir, args)

// A session whose current directory, the program a command uses when it is given none, is `here`.
private session_in(here: string, dir: string, args: []const string) -> Session
    var said = ""
    var noted = ""
    val out = dir + "/run.out"
    val err = dir + "/run.err"
    val status = run_cli_in(here, args, Some(repository_toolchain()), s -> said = said + s + "\n", s -> noted = noted + s + "\n", Stdio.ToPath(out), Stdio.ToPath(err))
    Session(status, said, noted, read_text(out).unwrap_or(""), read_text(err).unwrap_or(""))

@test("avin alone runs the package, or the directory program, it is in")
bare_avin_runs_the_current_program()
    val dir = make_temp_dir("avin-default").unwrap()
    defer _ = remove_dir_all(dir)
    new_package(dir + "/demo", false).unwrap()
    val package = session_in(dir + "/demo", dir, ["avin"])
    assert_eq(package.noted, "")
    assert_eq(package.out, "Hello, world!\n")
    assert_eq(package.status, 0)
    // From inside the package, the enclosing package is the program.
    val inside = session_in(dir + "/demo/demo", dir, ["avin", "-O0"])
    assert_eq(inside.out, "Hello, world!\n")
    make_dir_all(dir + "/plain").unwrap()
    write_text(dir + "/plain/main.avin", "main() -> int\n    println(\"plain\")\n    5\n").unwrap()
    val plain = session_in(dir + "/plain", dir, ["avin"])
    assert_eq(plain.out, "plain\n")
    assert_eq(plain.status, 5)
    make_dir_all(dir + "/empty").unwrap()
    make_dir_all(dir + "/logs").unwrap()
    val empty = session_in(dir + "/empty", dir + "/logs", ["avin"])
    assert_eq(empty.status, 1)
    assert(empty.noted.contains("no Avin program here"))
    assert_eq(empty.out, "")

@test("avin with a first argument that is not a command runs that path, and the arguments after -- reach it")
a_path_first_is_run()
    val dir = make_temp_dir("avin-default").unwrap()
    defer _ = remove_dir_all(dir)
    val source = dir + "/echo.avin"
    write_text(source, "import avin.process\n\nmain() -> int\n    println(process.args())\n    process.exit(process.args().length())\n").unwrap()
    val plain = session(dir, ["avin", source])
    assert_eq(plain.noted, "")
    assert_eq(plain.out, "[]\n")
    val given = session(dir, ["avin", source, "-O0", "--", "a", "b"])
    assert_eq(given.out, "[a, b]\n")
    assert_eq(given.status, 2)
    // Options with no path before them are for the current directory's program.
    make_dir_all(dir + "/here").unwrap()
    write_text(dir + "/here/echo.avin", "import avin.process\n\nmain() -> int\n    println(process.args())\n    0\n").unwrap()
    val options = session_in(dir + "/here", dir, ["avin", "--", "x"])
    assert_eq(options.out, "[x]\n")
    // A path that exists is a path, a word that does not is refused with the commands.
    val unknown = session(dir, ["avin", "nosuchthing"])
    assert_eq(unknown.status, 2)
    assert(unknown.noted.starts_with("avin: unknown command or file `nosuchthing`\nusage: avin "))
    refused_usage(dir, ["avin", "--bad"])
    refused_usage(dir, ["avin", "-o", "x"])

@test("build, check, parse and test take the current directory's program when none is named")
commands_default_to_the_current_program()
    val dir = make_temp_dir("avin-default").unwrap()
    defer _ = remove_dir_all(dir)
    new_package(dir + "/demo", false).unwrap()
    val home = dir + "/demo"
    assert(session_in(home, dir, ["avin", "check"]).said.starts_with("checked "))
    assert(session_in(home, dir, ["avin", "parse"]).said.starts_with("parsed "))
    val built = session_in(home, dir, ["avin", "build", "-o", dir + "/demo-binary"])
    assert_eq(built.noted, "")
    assert(exists(dir + "/demo-binary"))
    val tested = session_in(home, dir, ["avin", "test"])
    assert_eq(tested.status, 0)
    assert(tested.said.contains("1 passed, 0 failed"))
    val ir = dir + "/demo.ll"
    assert_eq(session_in(home, dir, ["avin", "emit-llvm", "-o", ir]).status, 0)
    assert(exists(ir))
    make_dir_all(dir + "/empty").unwrap()
    for command in ["build", "check", "parse", "test", "run"]
        val r = session_in(dir + "/empty", dir, ["avin", command])
        assert_eq(r.status, 1)
        assert(r.noted.contains("no Avin program here"))

@test("avin test reads its first argument as the program when it names an existing path, and as the filter otherwise")
test_argument_is_a_program_or_a_filter()
    val dir = make_temp_dir("avin-default").unwrap()
    defer _ = remove_dir_all(dir)
    new_package(dir + "/demo", false).unwrap()
    val home = dir + "/demo"
    val filtered = session_in(home, dir, ["avin", "test", "greets"])
    assert_eq(filtered.status, 0)
    assert(filtered.said.contains("1 passed, 0 failed"))
    val excluded = session_in(home, dir, ["avin", "test", "nothing-has-this-name"])
    assert(!excluded.said.contains("1 passed"))
    val program = session(dir, ["avin", "test", home])
    assert(program.said.contains("1 passed, 0 failed"))
    val both = session(dir, ["avin", "test", home, "greets", "-O0"])
    assert(both.said.contains("1 passed, 0 failed"))
    // An argument that names an existing path is the program, so a filter spelled like one follows the program.
    val spelled = session(dir, ["avin", "test", home, "demo"])
    assert(!spelled.said.contains("0 passed, 1 failed"))

@test("a command name is the command, and a directory named like one is run by its path")
command_names_win_over_paths()
    val dir = make_temp_dir("avin-default").unwrap()
    defer _ = remove_dir_all(dir)
    make_dir_all(dir + "/test").unwrap()
    write_text(dir + "/test/main.avin", "main() -> int\n    println(\"directory\")\n    0\n").unwrap()
    val by_path = session(dir, ["avin", dir + "/test"])
    assert_eq(by_path.out, "directory\n")
    make_dir_all(dir + "/logs").unwrap()
    val by_name = session_in(dir, dir + "/logs", ["avin", "test"])
    assert_eq(by_name.out, "")
    // `test` ran as the command on the directory, which holds no tests, so the program never ran.
    assert(!by_name.noted.contains("unknown command"))
    assert(!by_name.noted.starts_with("usage:"))

@test("run builds the program, runs it with its arguments, and forwards its output and exit status")
run_forwards_output_and_status()
    val dir = make_temp_dir("avin-run").unwrap()
    defer _ = remove_dir_all(dir)
    val source = dir + "/greet.avin"
    write_text(source, "main() -> int\n    println(\"hello\")\n    3\n").unwrap()
    val run = session(dir, ["avin", "run", source, "--", "first", "-O0", "--"])
    assert_eq(run.noted, "")
    assert_eq(run.said, "")
    assert_eq(run.out, "hello\n")
    assert_eq(run.err, "")
    assert_eq(run.status, 3)
    // The executable is kept in the cache beside the source, never written beside it as `build` does.
    assert(exists(dir + "/.avin/build/greet-O2"))
    assert(!exists(dir + "/greet"))
    val unoptimized = session(dir, ["avin", "run", source, "-O0"])
    assert_eq(unoptimized.status, 3)
    assert_eq(unoptimized.out, "hello\n")
    assert(exists(dir + "/.avin/build/greet-O0"))

@test("the arguments after run's `--` are the program's, read through avin.process, flags and `--` included")
run_passes_arguments_to_the_program()
    val dir = make_temp_dir("avin-run").unwrap()
    defer _ = remove_dir_all(dir)
    val source = dir + "/echo.avin"
    write_text(source, "import avin.process\n\nmain() -> int\n    println(process.args())\n    process.exit(process.args().length())\n").unwrap()
    val run = session(dir, ["avin", "run", source, "--", "first", "-O0", "--", "two words"])
    assert_eq(run.noted, "")
    assert_eq(run.out, "[first, -O0, --, two words]\n")
    assert_eq(run.status, 4)

@test("a test sees no arguments: the number choosing it is the runner's")
test_has_no_arguments()
    val dir = make_temp_dir("avin-test").unwrap()
    defer _ = remove_dir_all(dir)
    val source = dir + "/args.avin"
    write_text(source, "import avin.process\n\n@test\nnoArguments()\n    assert(process.args().isEmpty())\n    assert(process.programName().nonEmpty())\n").unwrap()
    val run = session(dir, ["avin", "test", source])
    assert_eq(run.status, 0)
    assert(run.said.contains("1 passed, 0 failed"))

@test("a program whose main takes the arguments builds for its tests and runs them")
test_with_main_taking_arguments()
    val dir = make_temp_dir("avin-test").unwrap()
    defer _ = remove_dir_all(dir)
    val source = dir + "/args_main.avin"
    write_text(source, "main(args: Vector[string]) -> int = args.length()\n\n@test\nholds()\n    assert(true)\n").unwrap()
    val run = session(dir, ["avin", "test", source])
    assert_eq(run.status, 0)
    assert(run.said.contains("1 passed, 0 failed"))

@test("a test sees no input: standard input is at its end at once")
test_has_no_input()
    val dir = make_temp_dir("avin-test").unwrap()
    defer _ = remove_dir_all(dir)
    val source = dir + "/input.avin"
    write_text(source, "import avin.io\n\n@test\nnoInput()\n    assert(io.readLine().isEmpty())\n    assert(io.readAll().isEmpty())\n").unwrap()
    val run = session(dir, ["avin", "test", source])
    assert_eq(run.status, 0)
    assert(run.said.contains("1 passed, 0 failed"))

@test("run exits 128 and the signal's number when the program traps, with the trap's report on standard error")
run_forwards_a_trap()
    val dir = make_temp_dir("avin-run").unwrap()
    defer _ = remove_dir_all(dir)
    val source = dir + "/fails.avin"
    write_text(source, "main()\n    println(\"before\")\n    assertEq(1 + 1, 3)\n").unwrap()
    val run = session(dir, ["avin", "run", source])
    assert(run.status > 128)
    assert_eq(run.out, "before\n")
    assert_eq(run.err, "avin: trap: assertion failed: expected 3, found 2 at fails.avin:3:5\n")
    assert_eq(run.noted, "")

@test("run reports a program's diagnostics and exits 1 without running anything")
run_reports_diagnostics()
    val dir = make_temp_dir("avin-run").unwrap()
    defer _ = remove_dir_all(dir)
    val source = dir + "/bad.avin"
    write_text(source, "main() = missing\n").unwrap()
    val run = session(dir, ["avin", "run", source])
    assert_eq(run.status, 1)
    assert(run.noted.contains("`missing` is not defined"))
    assert_eq(run.out, "")
    // A program built for its tests need not have `main`, but one built to run does.
    val tests_only = dir + "/tests_only.avin"
    write_text(tests_only, "@test\nholds()\n    assert(true)\n").unwrap()
    assert(session(dir, ["avin", "run", tests_only]).noted.contains("a program needs a `main` function"))
    assert_eq(session(dir, ["avin", "test", tests_only]).status, 0)

@test("the cached executable is reused until a source, the optimization or the kind of build changes")
cache_is_reused()
    val dir = make_temp_dir("avin-run").unwrap()
    defer _ = remove_dir_all(dir)
    val tc = repository_toolchain()
    val source = dir + "/cached.avin"
    val text = "main() -> int = 7\n\n@test\nseven()\n    assertEq(main(), 7)\n"
    write_text(source, text).unwrap()
    val first = cached_build(tc, source, single_file(source_of(source, text)), false, "-O2", buf(), buf()).unwrap()
    assert(first.built)
    val again = cached_build(tc, source, single_file(source_of(source, text)), false, "-O2", buf(), buf()).unwrap()
    assert(!again.built)
    assert_eq(again.path, first.path)
    assert(cached_build(tc, source, single_file(source_of(source, text)), false, "-O0", buf(), buf()).unwrap().built)
    val tests = cached_build(tc, source, single_file(source_of(source, text)), true, "-O2", buf(), buf()).unwrap()
    assert(tests.built)
    assert(tests.path != first.path)
    // A test executable taken from the cache still knows its tests, without compiling the program.
    val cached_tests = cached_build(tc, source, single_file(source_of(source, text)), true, "-O2", buf(), buf()).unwrap()
    assert(!cached_tests.built)
    assert_eq(cached_tests.tests.len(), 1)
    assert_eq(cached_tests.tests[0].name, "seven")
    assert_eq(cached_tests.tests[0].line, 4)
    val changed = "main() -> int = 8\n"
    write_text(source, changed).unwrap()
    assert(cached_build(tc, source, single_file(source_of(source, changed)), false, "-O2", buf(), buf()).unwrap().built)
    // Through the command line, a second run of an unchanged program runs the same executable.
    assert_eq(session(dir, ["avin", "run", source]).status, 8)
    assert_eq(session(dir, ["avin", "run", source]).status, 8)

@test("the cached executable is built again when a Sysl package the program names changes release")
cache_follows_sysl_packages()
    val dir = make_temp_dir("avin-run").unwrap()
    defer _ = remove_dir_all(dir)
    val tc = repository_toolchain()
    val source = dir + "/cached.avin"
    val text = "main() -> int = 7\n"
    write_text(source, text).unwrap()
    // The program has no bindings, so nothing is fetched; the packages are still what it is built with.
    var released: Buf[SyslPackage] = buf()
    released.push(SyslPackage("regex", Git("github.com/sysl-lang/regex", "0.2.0")))
    var raised: Buf[SyslPackage] = buf()
    raised.push(SyslPackage("regex", Git("github.com/sysl-lang/regex", "0.3.0")))
    assert(cached_build(tc, source, single_file(source_of(source, text)), false, "-O0", released, buf()).unwrap().built)
    assert(!cached_build(tc, source, single_file(source_of(source, text)), false, "-O0", released, buf()).unwrap().built)
    assert(cached_build(tc, source, single_file(source_of(source, text)), false, "-O0", raised, buf()).unwrap().built)
    assert(cached_build(tc, source, single_file(source_of(source, text)), false, "-O0", buf(), buf()).unwrap().built)

// A program of two modules: three tests that fail in different ways among ones that pass.
private write_tree(dir: string)
    make_dir_all(dir + "/geom").unwrap()
    write_text(dir + "/geom/clamp.avin", "module geom\n\nclamp(n: int, low: int, high: int) -> int = if n < low then low elif n > high then high else n\n\n@test(\"clamps below the low bound\")\nbelow()\n    assertEq(clamp(0, 1, 3), 1)\n\n@test\nleavesInRange()\n    println(\"checking 2\")\n    assertEq(clamp(2, 1, 3), 3)\n").unwrap()
    write_text(dir + "/math.avin", "import geom.clamp\n\n@test\nadds()\n    assertEq(1 + 1, 2)\n\n@test\noverflows()\n    val big = 2147483647\n    assert(big + 1 > 0)\n\n@test\nmessage()\n    assert(clamp(5, 1, 3) == 5, \"five stays five\")\n\nmain() = 0\n").unwrap()

@test("test runs every test of the tree in its own process, reports each failure with its place, and carries on")
test_reports_and_continues()
    val dir = make_temp_dir("avin-test").unwrap()
    defer _ = remove_dir_all(dir)
    val root = dir + "/tree"
    write_tree(root)
    val run = session(dir, ["avin", "test", root])
    assert_eq(run.noted, "")
    assert_eq(run.status, 1)
    val lines = run.said.lines()
    assert_eq(lines[0], "running 5 tests")
    assert_eq(lines[1], "")
    assert_eq(lines[2], "geom/clamp.avin")
    assert(lines[3].starts_with("  ok    clamps below the low bound  "))
    assert(lines[3].ends_with("ms"))
    assert(lines[4].starts_with("  FAIL  leavesInRange "))
    assert_eq(lines[5], "        assertion failed: expected 3, found 2 at clamp.avin:12:5")
    assert_eq(lines[6], "        > checking 2")
    assert_eq(lines[7], "")
    assert_eq(lines[8], "math.avin")
    assert(lines[9].starts_with("  ok    adds  "))
    assert(lines[10].starts_with("  FAIL  overflows  "))
    assert_eq(lines[11], "        integer overflow at math.avin:10:16")
    assert(lines[12].starts_with("  FAIL  message  "))
    assert_eq(lines[13], "        assertion failed: five stays five at math.avin:14:5")
    assert_eq(lines[14], "")
    assert(lines[15].starts_with("2 passed, 3 failed — "))
    assert_eq(lines.len, 16)

@test("a filter keeps the tests whose name or file contains it, and a run where every test passes exits 0")
test_filter()
    val dir = make_temp_dir("avin-test").unwrap()
    defer _ = remove_dir_all(dir)
    val root = dir + "/tree"
    write_tree(root)
    val by_name = session(dir, ["avin", "test", root, "low bound"])
    assert_eq(by_name.status, 0)
    assert(by_name.said.starts_with("running 1 of 5 tests\n\ngeom/clamp.avin\n  ok    clamps below the low bound  "))
    assert(by_name.said.contains("\n\n1 passed, 0 failed — "))
    val by_file = session(dir, ["avin", "test", root, "geom/", "-O0"])
    assert_eq(by_file.status, 1)
    assert(by_file.said.starts_with("running 2 of 5 tests\n"))
    assert(by_file.said.contains("\n1 passed, 1 failed — "))
    val none = session(dir, ["avin", "test", root, "nothing matches this"])
    assert_eq(none.status, 0)
    assert(none.said.starts_with("running 0 of 5 tests\n\n0 passed, 0 failed — "))

@test("a program without tests runs none and passes; a test program of one file names the file")
test_single_file()
    val dir = make_temp_dir("avin-test").unwrap()
    defer _ = remove_dir_all(dir)
    val empty = dir + "/empty.avin"
    write_text(empty, "main() = 0\n").unwrap()
    val run = session(dir, ["avin", "test", empty])
    assert_eq(run.status, 0)
    assert(run.said.starts_with("running 0 tests\n\n0 passed, 0 failed — "))
    val one = dir + "/one.avin"
    write_text(one, "@test(\"a sentence names it\")\nnamed()\n    println(\"passing output is not shown\")\n").unwrap()
    val single = session(dir, ["avin", "test", one])
    assert_eq(single.status, 0)
    assert(single.said.starts_with("running 1 test\n\none.avin\n  ok    a sentence names it  "))
    assert(!single.said.contains("passing output"))

@test("--prefix puts each file's name before its result lines and leaves the headings and the summary alone")
test_prefix()
    val dir = make_temp_dir("avin-test").unwrap()
    defer _ = remove_dir_all(dir)
    val root = dir + "/tree"
    make_dir_all(root).unwrap()
    write_text(root + "/a.avin", "@test(\"passes\")\npasses()\n    assert(true)\n\n@test(\"fails\")\nfails()\n    assert(false, \"on purpose\")\n\n@test(ignore: \"later\")\nlater()\n    assert(true)\n").unwrap()
    write_text(root + "/b.avin", "@test(\"other\")\nother()\n    assert(true)\n").unwrap()
    val run = session(dir, ["avin", "test", root, "--prefix"])
    assert_eq(run.status, 1)
    val lines = run.said.lines()
    assert_eq(lines[0], "running 4 tests")
    assert_eq(lines[2], "a.avin")
    assert(lines[3].starts_with("a.avin:   ok    passes  "))
    assert(lines[4].starts_with("a.avin:   FAIL  fails  "))
    assert(lines[5].starts_with("a.avin:         assertion failed: on purpose"))
    assert_eq(lines[6], "a.avin:   skip  later   ignored: later")
    assert_eq(lines[8], "b.avin")
    assert(lines[9].starts_with("b.avin:   ok    other  "))
    assert(lines[11].starts_with("2 passed, 1 failed, 1 ignored — "))
    // Without the flag the lines are as they were.
    assert(session(dir, ["avin", "test", root]).said.contains("\n  ok    passes  "))
    // The flag belongs to `test` alone, and once.
    refused_usage(dir, ["avin", "run", root, "--prefix"])
    refused_usage(dir, ["avin", "test", root, "--prefix", "--prefix"])

// A program whose tests say how they are run: by trapping, with or without the text the trap must
// print; with a limit of their own; not at all; and by answering with a `Result`.
private write_attributes(dir: string)
    make_dir_all(dir).unwrap()
    write_text(dir + "/checks.avin", "@test(should_trap)\ntrapsAtAll()\n    val v = [1]\n    println(v(3))\n\n@test(should_trap: \"index out of range\")\ntrapsWithTheText()\n    val v = [1]\n    println(v(3))\n\n@test(should_trap: \"nowhere\")\ntrapsWithoutTheText()\n    val v = [1]\n    println(v(3))\n\n@test(should_trap)\nreturnsInstead()\n    println(\"returned\")\n\n@test(timeout: 1)\nspins()\n    var n = 0\n    while true\n        n = n + 0\n\n@test(\"waits for a fix\", ignore: \"the fix is not in\")\nwaits()\n    assert(false)\n\n@test\nanswersOk() -> Result[unit, string]\n    Ok(())\n\n@test(\"answers an error\")\nanswersErr() -> Result[unit, string]\n    Err(\"empty input\")\n").unwrap()

@test("should_trap passes a trap and fails a return, ignore runs nothing, timeout stops the test, and an Err answer fails")
test_attributes()
    val dir = make_temp_dir("avin-test").unwrap()
    defer _ = remove_dir_all(dir)
    val root = dir + "/tree"
    write_attributes(root)
    // The second run takes the executable and what it knows of its tests from the cache.
    for _ in 0..<2
        val run = session(dir, ["avin", "test", root])
        assert_eq(run.noted, "")
        assert_eq(run.status, 1)
        val lines = run.said.lines()
        assert_eq(lines[0], "running 8 tests")
        assert_eq(lines[2], "checks.avin")
        assert(lines[3].starts_with("  ok    trapsAtAll  "))
        assert(lines[4].starts_with("  ok    trapsWithTheText  "))
        assert(lines[5].starts_with("  FAIL  trapsWithoutTheText  "))
        assert_eq(lines[6], "        trapped without printing \"nowhere\": index out of range at checks.avin:14:13")
        assert(lines[7].starts_with("  FAIL  returnsInstead  "))
        assert_eq(lines[8], "        returned, and should have trapped")
        assert_eq(lines[9], "        > returned")
        assert(lines[10].starts_with("  FAIL  spins  "))
        assert_eq(lines[11], "        timed out after 1s")
        assert_eq(lines[12], "  skip  waits for a fix      ignored: the fix is not in")
        assert(lines[13].starts_with("  ok    answersOk  "))
        assert(lines[14].starts_with("  FAIL  answers an error  "))
        assert_eq(lines[15], "        test answered Err: empty input at checks.avin:35:1")
        assert(lines[17].starts_with("3 passed, 4 failed, 1 ignored — "))
        assert_eq(lines.len, 18)
    // A filter that leaves only tests that pass, and the ignored one, exits 0.
    val ok = session(dir, ["avin", "test", root, "answersOk"])
    assert_eq(ok.status, 0)
    val ignored = session(dir, ["avin", "test", root, "waits"])
    assert_eq(ignored.status, 0)
    assert(ignored.said.contains("\n0 passed, 0 failed, 1 ignored — "))

// A module with all four hooks, each writing its name to `log` as the tests write theirs, beside a
// root module whose tests have no hooks, one of them in a `@tests` file.
private write_hooked(dir: string, log: string)
    make_dir_all(dir + "/life").unwrap()
    write_text(dir + "/life/life.avin", "module life\n\nimport avin.fs\n\nnote(line: string)\n    fs.appendText(\"" + log + "\", line + \"\\n\")\n\n@setup_all\nopensAll()\n    note(\"setup_all\")\n\n@setup\nopens()\n    note(\"setup\")\n\n@teardown\ncloses()\n    note(\"teardown\")\n\n@teardown_all\nclosesAll()\n    note(\"teardown_all\")\n\n@test\npasses()\n    note(\"passes\")\n\n@test\nfails()\n    note(\"fails\")\n    assert(false, \"on purpose\")\n\n@test(should_trap)\ntraps()\n    note(\"traps\")\n    val v = [1]\n    println(v(3))\n\n@test(ignore: \"not yet\")\nwaits()\n    note(\"waits\")\n").unwrap()
    write_text(dir + "/plain.avin", "@test\nplain()\n    assertEq(fixture(), 42)\n\nmain()\n    println(\"main\")\n").unwrap()
    write_text(dir + "/fixtures.avin", "@tests\n\nfixture() -> int = 42\n\n@test\ninTestsFile()\n    assertEq(fixture(), 42)\n").unwrap()

@test("setup and teardown run around each test, teardown after a failed test too, and setup_all and teardown_all once around the module's tests")
test_hooks_order()
    val dir = make_temp_dir("avin-test").unwrap()
    defer _ = remove_dir_all(dir)
    val root = dir + "/tree"
    val log = dir + "/log.txt"
    write_hooked(root, log)
    val run = session(dir, ["avin", "test", root])
    assert_eq(run.noted, "")
    assert_eq(run.status, 1)
    val lines = run.said.lines()
    assert_eq(lines[0], "running 6 tests")
    assert_eq(lines[2], "life/life.avin")
    assert(lines[3].starts_with("  ok    passes  "))
    assert(lines[4].starts_with("  FAIL  fails  "))
    assert_eq(lines[5], "        assertion failed: on purpose at life.avin:31:5")
    assert(lines[6].starts_with("  ok    traps  "))
    assert_eq(lines[7], "  skip  waits        ignored: not yet")
    assert_eq(lines[9], "fixtures.avin")
    assert(lines[10].starts_with("  ok    inTestsFile  "))
    assert_eq(lines[12], "plain.avin")
    assert(lines[13].starts_with("  ok    plain  "))
    assert(lines[15].starts_with("4 passed, 1 failed, 1 ignored — "))
    // The teardown after a trapped test runs in a process of its own, and an ignored test runs no hook.
    assert_eq(read_text(log).unwrap(), "setup_all\nsetup\npasses\nteardown\nsetup\nfails\nteardown\nsetup\ntraps\nteardown\nteardown_all\n")
    // The program itself runs no test, no hook and nothing a `@tests` file declares.
    val program = session(dir, ["avin", "run", root])
    assert_eq(program.out, "main\n")
    assert_eq(program.status, 0)
    // A run that selects no test of the module runs none of its hooks.
    remove_file(log).unwrap()
    assert_eq(session(dir, ["avin", "test", root, "plain"]).status, 0)
    assert(!exists(log))

@test("a setup that fails fails its tests without running them, and a teardown or setup_all that fails is a failure of its own")
test_hook_failures()
    val dir = make_temp_dir("avin-test").unwrap()
    defer _ = remove_dir_all(dir)
    val root = dir + "/tree"
    make_dir_all(root + "/a").unwrap()
    make_dir_all(root + "/b").unwrap()
    make_dir_all(root + "/c").unwrap()
    write_text(root + "/a/a.avin", "module a\n\n@setup\nbreaks()\n    println(\"setting up\")\n    assert(false, \"no setup\")\n\n@test\nneverRuns()\n    println(\"ran\")\n").unwrap()
    write_text(root + "/b/b.avin", "module b\n\n@teardown\nbreaks()\n    assert(false, \"no teardown\")\n\n@test\nholds()\n    println(\"held\")\n").unwrap()
    write_text(root + "/c/c.avin", "module c\n\n@setup_all\nbreaks()\n    assert(false, \"no setup_all\")\n\n@test\nfirst()\n    println(\"first\")\n\n@test\nsecond()\n    println(\"second\")\n").unwrap()
    val run = session(dir, ["avin", "test", root])
    assert_eq(run.status, 1)
    val lines = run.said.lines()
    assert_eq(lines[2], "a/a.avin")
    assert(lines[3].starts_with("  FAIL  neverRuns  "))
    assert_eq(lines[4], "        not run: `@setup` `breaks` failed: assertion failed: no setup at a.avin:6:5")
    assert_eq(lines[5], "        > setting up")
    assert_eq(lines[7], "b/b.avin")
    assert(lines[8].starts_with("  ok    holds  "))
    assert_eq(lines[9], "  FAIL  @teardown breaks")
    assert_eq(lines[10], "        assertion failed: no teardown at b.avin:5:5")
    assert_eq(lines[11], "        > held")
    assert_eq(lines[13], "c/c.avin")
    assert_eq(lines[14], "  FAIL  @setup_all breaks")
    assert_eq(lines[15], "        assertion failed: no setup_all at c.avin:5:5")
    assert_eq(lines[16], "  FAIL  first")
    assert_eq(lines[17], "        not run: `@setup_all` `breaks` failed")
    assert_eq(lines[18], "  FAIL  second")
    assert_eq(lines[19], "        not run: `@setup_all` `breaks` failed")
    assert(lines[21].starts_with("1 passed, 5 failed — "))

@test("test and run are refused with the usage for flags they do not take")
usage_of_run_and_test()
    val dir = make_temp_dir("avin-run").unwrap()
    defer _ = remove_dir_all(dir)
    refused_usage(dir,["avin", "run", "x.avin", "-o", "y"])
    refused_usage(dir,["avin", "run", "x.avin", "extra"])
    refused_usage(dir,["avin", "test", "x.avin", "a", "b"])
    refused_usage(dir,["avin", "test", "x.avin", "--", "a"])
    refused_usage(dir,["avin", "test", "x.avin", "-O3"])
    refused_usage(dir,["avin", "check", "x.avin", "-O2"])
    refused_usage(dir,["avin", "emit-llvm", "x.avin", "-o", "x.ll", "-O0"])
    refused_usage(dir,["avin", "build", "x.avin", "-O2", "-O0"])

private refused_usage(dir: string, args: []const string)
    val run = session(dir, args)
    assert_eq(run.status, 2)
    assert_eq(run.said, "")
    assert(run.noted.starts_with("usage: avin "))
