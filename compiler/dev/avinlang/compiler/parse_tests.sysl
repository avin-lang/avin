module dev.avinlang.compiler
@tests

import sh.sysl.parsing.{source_of, Span}
import sysl.text.from_utf8_unchecked

private tree(text: string) -> string
    val parsed = parse_expression(source_of("test.avin", text))
    if parsed.report.has_errors() then panic(parsed.report.render(source_of("test.avin", text)))
    show_expr(parsed.tree)

private diagnostics(text: string) -> string
    val src = source_of("test.avin", text)
    val parsed = parse(src)
    parsed.report.render(src)

private declarations(text: string) -> string
    val src = source_of("test.avin", text)
    val parsed = parse(src)
    if parsed.report.has_errors() then panic(parsed.report.render(src))
    var out = ""
    for item in parsed.file.items
        val shown = item match
            FunctionItem(f) -> show_function(f)
            DataItem(d) -> show_data(d)
            ClassItem(d) -> show_class(d)
            ImplItem(d) -> show_impl(d)
            ValueItem(v) ->
                var value = "(" + (if v.lazy then "lazy " else "") + (if v.mutable then "var " else "val ") + v.name
                if v.declared is Some(t) then value = value + ": " + show_type(t)
                value + " " + show_expr(v.value) + ")"
        out = out + shown + "\n"
    out

@test("binary operators follow the precedence table and associate left")
precedence()
    assert_eq(tree("1 + 2 * 3"), "(+ 1 (* 2 3))")
    assert_eq(tree("a - b - c"), "(- (- a b) c)")
    assert_eq(tree("1 + 2 << 3"), "(+ 1 (<< 2 3))")
    assert_eq(tree("x & mask == 0"), "((& x mask) == 0)")
    assert_eq(tree("a | b ^ c & d"), "(| a (^ b (& c d)))")
    assert_eq(tree("a || b && c"), "(|| a (&& b c))")
    assert_eq(tree("-a.b"), "(- (. a b))")
    assert_eq(tree("!f(x)"), "(! (call f x))")
    assert_eq(tree("a +% b *| c"), "(+% a (*| b c))")

@test("an infix method call is a dotted call that binds below arithmetic and ranges and above comparisons")
infix_calls()
    assert_eq(tree("a max b"), "(call (. a max) b)")
    assert_eq(tree("a max b + 1"), "(call (. a max) (+ b 1))")
    assert_eq(tree("a * 2 max b"), "(call (. (* a 2) max) b)")
    assert_eq(tree("xs contains x && ok"), "(&& (call (. xs contains) x) ok)")
    assert_eq(tree("a max b max c"), "(call (. (call (. a max) b) max) c)")
    assert_eq(tree("a max b == c"), "((call (. a max) b) == c)")
    assert_eq(tree("a < b max c"), "(a < (call (. b max) c))")
    assert_eq(tree("a m (b, c)"), "(call (. a m) (tuple b c))")
    assert_eq(tree("a m 1..5"), "(call (. a m) (.. 1 5))")
    assert_eq(tree("a | b m c & d"), "(call (. (| a b) m) (& c d))")
    assert_eq(tree("xs map x -> x + 1"), "(call (. xs map) (fn (x) (+ x 1)))")
    assert_eq(tree("a.b(1) m c.d"), "(call (. (call (. a b) 1) m) (. c d))")
    assert_eq(tree("f(a m b, c)"), "(call f (call (. a m) b) c)")
    assert_eq(tree("a max b is Some(_)"), "(is (call (. a max) b) Some(_))")
    assert_eq(tree("if a max b then c else d"), "(if (call (. a max) b) c d)")
    assert_eq(tree("x = a max b"), "(= x (call (. a max) b))")

@test("the argument of an infix call continues on an indented line only after the method's name")
infix_continuation()
    assert_eq(tree("if c\n    val r = a max\n        b + 1\n    r\n"), "(if c (block (val r (call (. a max) (block (+ b 1)))) r))")

@test("keywords after an operand keep their meaning and do not start an infix call")
infix_keywords()
    assert_eq(tree("n is int"), "(is n int)")
    assert_eq(tree("x match\n    0 -> a max b\n    _ -> c\n"), "(match x (0 -> (call (. a max) b)) (_ -> c))")
    assert_eq(tree("a max b match\n    0 -> 1\n    _ -> 2\n"), "(match (call (. a max) b) (0 -> 1) (_ -> 2))")
    assert_eq(tree("while a has b do step()"), "(while (call (. a has) b) (call step))")
    assert_eq(tree("n match\n    k if k max 1 > 0 -> k\n    else 0\n"), "(match n (k if ((call (. k max) 1) > 0) -> k) (_ -> 0))")

@test("an infix call takes one argument and no postfix form")
infix_errors()
    assert(diagnostics("f(xs: Xs) -> int = xs size\n").contains("`size` has no argument"))
    assert(diagnostics("f(xs: Xs) -> bool = xs size == 0\n").contains("a method without arguments is called `xs.size()`"))
    assert(diagnostics("f(xs: Xs) -> int\n    val n = (xs\n        size 1)\n    n\n").contains("an infix call starts on its receiver's line"))

@test("an operator is the longest run of operator characters, and one the language lacks names a method")
symbol_calls()
    assert_eq(tree("a ++ b + c"), "(+ (call (. a ++) b) c)")
    assert_eq(tree("a ++ b ++ c"), "(call (. (call (. a ++) b) ++) c)")
    assert_eq(tree("a ++ b == c"), "((call (. a ++) b) == c)")
    assert_eq(tree("a ++ b max c"), "(call (. (call (. a ++) b) max) c)")
    assert_eq(tree("1 :: xs ++ ys"), "(:: 1 (call (. xs ++) ys))")
    assert_eq(tree("x +: xs"), "(call (. xs +:) x)")
    assert_eq(tree("a +: b +: xs"), "(call (. (call (. xs +:) b) +:) a)")
    assert_eq(tree("(a ++ b) :+ c"), "(call (. (call (. a ++) b) :+) c)")
    assert_eq(tree("x +: (a ++ b)"), "(call (. (call (. a ++) b) +:) x)")
    assert_eq(tree("xs.++(ys)"), "(call (. xs ++) ys)")
    assert_eq(tree("i++"), "(post++ i)")
    assert_eq(tree("f(i++)"), "(call f (post++ i))")
    assert_eq(tree("a +%= b"), "(+%= a b)")
    assert_eq(tree("xs ++= ys"), "(++= xs ys)")
    assert_eq(tree("xs :+= y"), "(:+= xs y)")

@test("a symbol method binds at the level of the operator its first character belongs to")
symbol_levels()
    // `~` and `?` start no operator of a level, and bind tightest, below prefix operators.
    assert_eq(tree("a ~ b * c"), "(* (call (. a ~) b) c)")
    assert_eq(tree("a * b ~ c"), "(* a (call (. b ~) c))")
    assert_eq(tree("a ?? b + c"), "(+ (call (. a ??) b) c)")
    assert_eq(tree("-a ~> b"), "(call (. (- a) ~>) b)")
    // Multiplicative, with the shifts.
    assert_eq(tree("a *~ b + c"), "(+ (call (. a *~) b) c)")
    assert_eq(tree("a + b *~ c"), "(+ a (call (. b *~) c))")
    assert_eq(tree("a <<< b + c"), "(+ (call (. a <<<) b) c)")
    assert_eq(tree("a * b %% c"), "(call (. (* a b) %%) c)")
    // Additive.
    assert_eq(tree("a ++ b * c"), "(call (. a ++) (* b c))")
    assert_eq(tree("a + b ++ c"), "(call (. (+ a b) ++) c)")
    assert_eq(tree("a -- b & c"), "(& (call (. a --) b) c)")
    // Bitwise: `&`, then `^`, then `|`.
    assert_eq(tree("a && b"), "(&& a b)")
    assert_eq(tree("a &&& b | c"), "(| (call (. a &&&) b) c)")
    assert_eq(tree("a ^^ b & c"), "(call (. a ^^) (& b c))")
    assert_eq(tree("a ^^ b | c"), "(| (call (. a ^^) b) c)")
    assert_eq(tree("a |> b ^ c"), "(call (. a |>) (^ b c))")
    assert_eq(tree("a |> b :: c"), "(:: (call (. a |>) b) c)")
    // Cons.
    assert_eq(tree("xs ++ ys :+ z"), "(call (. (call (. xs ++) ys) :+) z)")
    assert_eq(tree("x :+ y .. z"), "(.. (call (. x :+) y) z)")
    assert_eq(tree("1 :: xs :: ys"), "(:: 1 (:: xs ys))")
    assert_eq(tree("1 +: xs :+ 2"), "(call (. (call (. xs +:) 1) :+) 2)")
    assert_eq(tree("a ::: b ::: c"), "(call (. (call (. c :::) b) :::) a)")
    // Named calls sit between ranges and comparisons.
    assert_eq(tree("a :+ b max c"), "(call (. (call (. a :+) b) max) c)")
    // Comparison.
    assert_eq(tree("a <=> b max c"), "(call (. a <=>) (call (. b max) c))")
    assert_eq(tree("a <=> b ~ c"), "(call (. a <=>) (call (. b ~) c))")
    assert_eq(tree("a !! b && c"), "(&& (call (. a !!) b) c)")
    assert_eq(tree("a <=> b == 0"), "((call (. a <=>) b) == 0)")
    // A name ending in `=` is an assignment.
    assert_eq(tree("a |= b ~ c"), "(|= a (call (. b ~) c))")
    assert_eq(tree("a ++= b ++ c"), "(++= a (call (. b ++) c))")
    // Combinators read as written.
    assert_eq(tree("a ~ b ^^ f | c ~ d"), "(| (call (. (call (. a ~) b) ^^) f) (call (. c ~) d))")
    assert_eq(tree("a ~> b <~ c"), "(call (. (call (. a ~>) b) <~) c)")
    // Prefix `~` stays the complement.
    assert_eq(tree("~a ~ ~b"), "(call (. (~ a) ~) (~ b))")

@test("a symbol method with `~` anywhere in its name binds tightest and groups left, whatever its first character")
tilde_levels()
    assert_eq(tree("a <~ b ~ c"), "(call (. (call (. a <~) b) ~) c)")
    assert_eq(tree("a ~ b <~ c"), "(call (. (call (. a ~) b) <~) c)")
    assert_eq(tree("num | symbol(\"(\") ~> expr <~ symbol(\")\")"), "(| num (call (. (call (. (call symbol \"(\") ~>) expr) <~) (call symbol \")\")))")
    assert_eq(tree("\"[\" ~> items <~ \"]\" ^^ f"), "(call (. (call (. (call (. \"[\" ~>) items) <~) \"]\") ^^) f)")
    assert_eq(tree("a <~> b ~ c"), "(call (. (call (. a <~>) b) ~) c)")
    assert_eq(tree("a ^~ b ^^ c"), "(call (. (call (. a ^~) b) ^^) c)")
    assert_eq(tree("a ~! b * c"), "(* (call (. a ~!) b) c)")
    assert_eq(tree("a <~ b == c"), "((call (. a <~) b) == c)")
    // The first character still decides every other name, and `~=` is still an assignment.
    assert_eq(tree("a <> b ~ c"), "(call (. a <>) (call (. b ~) c))")
    assert_eq(tree("a ~= b <~ c"), "(~= a (call (. b <~) c))")
    assert(diagnostics("f(a: A) -> A = a <~ b ~: c\n").contains("`<~` groups to the left and `~:` to the right"))

@test("a line that starts with a binary operator and is indented deeper continues the expression above it, at the operator's own precedence")
continuation_lines()
    assert_eq(tree("if c\n    val total = a\n        + b * c\n        - d\n    total\n"), "(if c (block (val total (- (+ a (* b c)) d)) total))")
    assert_eq(tree("if c\n    val atom = number\n        | symbol(\"(\") ~> e <~ symbol(\")\")\n        | ident ^^ Var\n    atom\n"), "(if c (block (val atom (| (| number (call (. (call (. (call symbol \"(\") ~>) e) <~) (call symbol \")\"))) (call (. ident ^^) Var))) atom))")
    // The line break means nothing to precedence.
    assert_eq(tree("a + b\n    * c\n"), "(+ a (* b c))")
    assert_eq(tree("a * b\n    + c * d\n"), "(+ (* a b) (* c d))")
    assert_eq(tree("a max b\n    + c\n"), "(call (. a max) (+ b c))")
    assert_eq(tree("a < b\n    < c\n"), "(a < b < c)")
    assert_eq(tree("ok\n    && a\n    || b\n"), "(|| (&& ok a) b)")
    assert_eq(tree("xs\n    ++ ys\n    :+ z\n"), "(call (. (call (. xs ++) ys) :+) z)")
    assert_eq(tree("1\n    :: xs\n"), "(:: 1 xs)")
    // A deeper line goes on continuing, and its depth means nothing either.
    assert_eq(tree("a\n    + b\n        - c\n    + d\n"), "(+ (- (+ a b) c) d)")
    // `-` and `+` after an operand are binary, with or without a space after them.
    assert_eq(tree("if c\n    val y = a\n        -b\n    y\n"), "(if c (block (val y (- a b)) y))")
    // A return value, an assignment, a match arm, a lambda body and a one-line `if` branch.
    assert_eq(tree("if c\n    return a\n        + b\n"), "(if c (block (return (+ a b))))")
    assert_eq(tree("if c\n    x = a\n        * b\n"), "(if c (block (= x (* a b))))")
    assert_eq(tree("x match\n    0 -> a\n        + b\n    _ -> c\n"), "(match x (0 -> (+ a b)) (_ -> c))")
    assert_eq(tree("if c\n    val f = n -> n\n        * 2\n    f\n"), "(if c (block (val f (fn (n) (* n 2))) f))")
    assert_eq(tree("if c then a\n    + b\nelse d\n"), "(if c (+ a b) d)")
    // Blank lines and comments between continuation lines are skipped.
    assert_eq(tree("a\n    + b\n\n    // and the last\n    + c\n"), "(+ (+ a b) c)")
    // A trailing block and a line ending with an infix method's name compose with it.
    assert_eq(tree("a\n    + f(1)\n        y\n    + c\n"), "(+ (+ a (call f 1 block=(block y))) c)")
    assert_eq(tree("a max\n    b\n        + c\n"), "(call (. a max) (block (+ b c)))")
    // In brackets every line break is insignificant, so a symbol method may start a line there too.
    assert_eq(tree("f(a\n~> b)\n"), "(call f (call (. a ~>) b))")

@test("a line that starts with a prefix operator is a block's line wherever a block follows, and continues nothing")
continuation_blocks()
    assert_eq(tree("if c\n    -x\n"), "(if c (block (- x)))")
    assert_eq(tree("if c\n    a\n    -x\n"), "(if c (block a (- x)))")
    assert_eq(tree("while c\n    -x\n"), "(while c (block! (- x)))")
    assert_eq(tree("if a\n    + b\n"), "(if a (block (+ b)))")
    assert_eq(tree("x match\n    1 -> a\n    -1 -> b\n"), "(match x (1 -> a) ((- 1) -> b))")
    assert_eq(tree("if c\n    val y =\n        -x\n    y\n"), "(if c (block (val y (block (- x))) y))")
    assert_eq(declarations("f(x: int) -> int\n    -x\n"), "(def f(x: int) -> int (block (- x)))\n")
    assert(tree("for i in xs\n    -i\n").contains("(block! (- i))"))
    assert(tree("if c\n    a\nelse\n    -x\n").contains("(block (- x))"))
    assert(declarations("f(x: int) -> int\n    helper()\n        -x\n    helper()\n").contains("(def helper() (block! (- x)))"))
    // After a call, an indented line starting with an operator continues it rather than being its
    // trailing block.
    assert_eq(tree("if c\n    val y = f(1)\n        -x\n    y\n"), "(if c (block (val y (- (call f 1) x)) y))")
    assert_eq(tree("if c\n    val y = xs\n        ++ys\n    y\n"), "(if c (block (val y (call (. xs ++) ys)) y))")
    // The lines of a block inside a continuation start again: the block's own `-x` line is a statement.
    assert_eq(tree("a\n    + run(() ->\n        y\n        -x)\n"), "(+ a (call run (fn () (block y (- x)))))")

@test("a line indented under a continued expression starts with an operator")
continuation_errors()
    assert(diagnostics("f(a: int, b: int) -> int\n    val x = a\n        + b\n        b\n    x\n").contains("a line indented under a continued expression continues it, so it starts with a binary operator"))
    assert(parses("f(a: int, b: int) -> int\n    val x = a\n        + b\n    x\n"))
    assert(parses("val x = 1\n    + 2\nval y = x\n"))

@test("left- and right-grouping operators at one level do not mix, and at different levels do")
symbol_level_grouping()
    assert(diagnostics("f(a: A) -> A = 1 :: a :+ 2\n").contains("`:+` groups to the left and `::` to the right"))
    assert(diagnostics("f(a: A) -> A = a :+ 2 :: b\n").contains("`:+` groups to the left and `::` to the right"))
    assert(diagnostics("f(a: A) -> A = a + b +: c\n").contains("`+` groups to the left and `+:` to the right"))
    assert(diagnostics("f(a: A) -> A = a +: b + c\n").contains("`+` groups to the left and `+:` to the right"))
    assert(diagnostics("f(a: A) -> A = a | b |: c\n").contains("`|` groups to the left and `|:` to the right"))
    assert(parses("f(a: A) -> A = 1 +: a :+ 2\n"))
    assert(parses("f(a: A) -> A = (1 :: a) :+ 2\n"))
    assert(parses("f(a: A) -> A = 1 :: (a :+ 2)\n"))
    assert(parses("f(a: A) -> A = 1 *: a + 2\n"))

@test("a symbol method cannot be one of the language's operators, and groups one way at a time")
symbol_errors()
    assert(parses("class A\n    +(o: A) -> A = o\n    -(o: A) -> A = o\n    -() -> A = self\n    *(k: real) -> A = self\n    /(o: A) -> A = o\n    %(o: A) -> A = o\n"))
    assert(parses("class A\n    <(o: A) -> bool = true\n    <=(o: A) -> bool = true\n    >(o: A) -> bool = true\n    >=(o: A) -> bool = true\n"))
    assert(diagnostics("class A\n    !=(o: A) -> bool = true\n").contains("by implementing `Eq`"))
    assert(diagnostics("class A\n    -%(o: A) -> A = o\n").contains("`-%` is an operator of the language and cannot name a method"))
    assert(diagnostics("class A\n    +:=(o: A) -> A = o\n").contains("`+:=` is an operator of the language and cannot name a method"))
    assert(diagnostics("class A\n    &&(o: A) -> A = o\n").contains("`&&` is an operator of the language and cannot name a method"))
    assert(parses("class A\n    |(o: A) -> A = o\n    &(o: A) -> A = o\n    ^(o: A) -> A = o\n    ~(o: A) -> A = o\n"))
    assert(parses("class A\n    <<(o: A) -> A = o\n    >>(o: A) -> A = o\n    >>>(o: A) -> A = o\n"))
    assert(parses("class A\n    <<=(o: A)\n        o\n"))
    assert(diagnostics("class A\n    >>:=(o: A) -> A = o\n").contains("`>>:=` is an operator of the language and cannot name a method"))
    assert(diagnostics("f(a: A) -> A = a ++ a +: a\n").contains("`++` groups to the left and `+:` to the right"))
    assert(diagnostics("f(a: A) -> A = a +: a ++ a\n").contains("`++` groups to the left and `+:` to the right"))
    assert(diagnostics("f(a: A) -> A = !!a\n").contains("a symbol method has no prefix form"))

@test("a keyword cannot be declared as a name, but `end` and ordinary names can")
keyword_names()
    assert(diagnostics("main() -> int\n    val loop = 1\n    0\n").contains("`loop` is a keyword and cannot name a value"))
    assert(diagnostics("while(n: int) -> int = n\n").contains("`while` is a keyword and cannot name a function"))
    assert(diagnostics("f(do: int) -> int = 1\n").contains("`do` is a keyword and cannot name a value"))
    assert(diagnostics("f[match](n: int) = n\n").contains("`match` is a keyword and cannot name a type parameter"))
    assert(diagnostics("f() = (if) -> 1\n").contains("`if` is a keyword and cannot name a parameter"))
    assert(diagnostics("f() = g(loop = 1)\n").contains("`loop` is a keyword and cannot name an argument"))
    assert(diagnostics("import a.b as loop\n").contains("`loop` is a keyword and cannot name an import"))
    assert(parses("main() -> int\n    val end = 1\n    end\n"))
    assert(parses("object(x: int) = x\n"))
    assert(parses("open(owner: string) = owner\n"))
    assert(parses("f(loopy: int) = (done) -> done\n"))

private parses(text: string) -> bool = !parse(source_of("test.avin", text)).report.has_errors()

@test("a bracket opened on a declaration's line keeps the following lines out of the layout, after a return type too")
brackets_across_lines()
    assert(parses("f(b: int) -> int = (b\n    + 2)\n"))
    assert(parses("f(b: int) -> int = g(b,\n    2)\n"))
    assert(parses("f(b: int) -> int = [b,\n    2].size()\n"))
    assert(parses("val x = (1\n    + 2)\n"))
    assert(parses("class C(val n: int)\n    val m = (n\n        + 2)\n"))
    assert(parses("f(a: int) -> int\nf(0) = (1\n    + 2)\nf(n) = n\n"))
    assert(parses("f(a: int = (1\n    + 2)) -> int = a\n"))
    assert(parses("f(g: (int) -> int,\n    h: int) -> int = g(h)\n"))
    assert(parses("f(b: int) -> int = ((b\n    + 1)\n    * [2,\n        3].size())\n"))
    assert(parses("f(b: int) -> int =\n    (b\n        + 2)\n"))

@test("comparisons chain into one expression and parentheses end a chain")
comparison_chains()
    assert_eq(tree("a < b <= c"), "(a < b <= c)")
    assert_eq(tree("(a < b) == flag"), "((a < b) == flag)")
    assert_eq(tree("x === y"), "(x === y)")

@test("collection literals distinguish lists, sets and maps, and bare map keys are strings")
collections()
    assert_eq(tree("[1, 2]"), "[1 2]")
    assert_eq(tree("[]"), "[]")
    assert_eq(tree("{1, 2}"), "{1 2}")
    assert_eq(tree("{}"), "{}")
    assert_eq(tree("{a: 1, \"b c\": 2}"), "{\"a\": 1 \"b c\": 2}")
    assert_eq(tree("{(a): 1}"), "{a: 1}")
    assert_eq(tree("[1,\n 2,\n]"), "[1 2]")
    assert(parse_expression(source_of("t.avin", "{1, a: 2}")).report.has_errors())

@test("parentheses group, make tuples and unit, and tuple elements are read by index")
tuples()
    assert_eq(tree("()"), "()")
    assert_eq(tree("(1)"), "1")
    assert_eq(tree("(1, \"one\")"), "(tuple 1 \"one\")")
    assert_eq(tree("t.0"), "(.0 t)")
    assert_eq(tree("t.0.1"), "(.1 (.0 t))")
    assert_eq(tree("t.1.name"), "(. (.1 t) name)")

@test("lambdas take one bare parameter or a parenthesized list")
lambdas()
    assert_eq(tree("x -> x + 1"), "(fn (x) (+ x 1))")
    assert_eq(tree("(a, b) -> a"), "(fn (a b) a)")
    assert_eq(tree("(n: int) -> n"), "(fn (n: int) n)")
    assert_eq(tree("() -> 1"), "(fn () 1)")
    assert_eq(tree("f((x) -> x)"), "(call f (fn (x) x))")

@test("calls take positional and named arguments, and type arguments")
calls()
    assert_eq(tree("open(path, create = true)"), "(call open path create=true)")
    assert_eq(tree("f()"), "(call f)")
    assert_eq(tree("parse[int](text)"), "(call (apply parse int) text)")
    assert_eq(tree("Map.empty[string, int]"), "(apply (. Map empty) string int)")
    assert_eq(tree("f(x == y)"), "(call f (x == y))")

@test("assignment forms record their operator and whether they yield")
assignments()
    assert_eq(tree("x = 1"), "(= x 1)")
    assert_eq(tree("x += 1"), "(+= x 1)")
    assert_eq(tree("x := 2"), "(:= x 2)")
    assert_eq(tree("x +%:= 1"), "(+%:= x 1)")
    assert_eq(tree("x <<= 2"), "(<<= x 2)")
    assert_eq(tree("a = b = c"), "(= a (= b c))")
    assert_eq(tree("x++"), "(post++ x)")
    assert_eq(tree("--x"), "(pre-- x)")

@test("pattern tests, propagation and ranges are expressions")
tests_and_ranges()
    assert_eq(tree("v is Some(x)"), "(is v Some(x))")
    assert_eq(tree("v is not None"), "(is-not v None)")
    assert_eq(tree("a && v is Some(_)"), "(&& a (is v Some(_)))")
    assert_eq(tree("read()?"), "(? (call read))")
    assert_eq(tree("a not b"), "(call (. a not) b)")

@test("`not` is a keyword only directly after `is`, and an ordinary name everywhere else")
soft_not()
    assert_eq(tree("not(p)"), "(call not p)")
    assert_eq(tree("v is not(1)"), tree("v is not 1"))
    assert_eq(tree("not(v) is not None"), "(is-not (call not v) None)")
    assert_eq(tree("p.not"), "(. p not)")
    assert(parses("not(p: int) -> int = p\n"))
    assert(parses("f(not: int) -> int = not\n"))
    assert(parses("class A\n    not() -> A = self\n"))
    assert(parses("main() -> int\n    val not = 1\n    not\n"))
    assert(parses("main() -> int\n    val x = if a is not b then 1 else 2\n    x\n"))
    assert_eq(tree("1..<n + 1"), "(..< 1 (+ n 1))")
    assert_eq(tree("a..b"), "(.. a b)")
    assert(parse_expression(source_of("t.avin", "a..b..c")).report.has_errors())

@test("match arms take every pattern form, guards, and a fallback")
patterns()
    val text = "n match\n    0 -> 1\n    -1 -> 2\n    1..<5 -> 3\n    Some(x) | None -> 4\n    all @ (a, b) -> 5\n    _ -> 6\n    true -> 7\n    \"s\" | 'c' -> 8\n    () -> 9\n    k if k > 0 -> 10\n    Color.Red -> 11\n    else 12\n"
    assert_eq(tree(text), "(match n (0 -> 1) ((- 1) -> 2) ((..< 1 5) -> 3) ((| Some(x) None) -> 4) (all @ (tuple a b) -> 5) (_ -> 6) (true -> 7) ((| \"s\" 'c') -> 8) (() -> 9) (k if (k > 0) -> 10) (Color.Red -> 11) (_ -> 12))")

@test("`::` groups to the right, binding more loosely than arithmetic and bitwise operators and more tightly than ranges and comparisons")
cons_operator()
    assert_eq(tree("1 :: 2 :: []"), "(:: 1 (:: 2 []))")
    assert_eq(tree("n + 1 :: rest"), "(:: (+ n 1) rest)")
    assert_eq(tree("a | b :: c"), "(:: (| a b) c)")
    assert_eq(tree("x :: xs == ys"), "((:: x xs) == ys)")
    assert_eq(tree("a :: b..c"), "(.. (:: a b) c)")
    assert_eq(tree("a max b :: c"), "(call (. a max) (:: b c))")
    assert_eq(tree("f(a :: b, c)"), "(call f (:: a b) c)")

@test("list patterns: `::` groups to the right, `[...]` matches a sequence by length, and the two mix")
list_patterns()
    val text = "xs match\n    [] -> 0\n    [a] -> 1\n    [a, b,] -> 2\n    a :: b :: rest -> 3\n    a :: [b, c] -> 4\n    whole @ x :: _ -> 5\n    (x :: _) :: [] | [] :: _ -> 6\n    0 :: _ -> 7\n    [Some(x), _] -> 8\n"
    assert_eq(tree(text), "(match xs ([] -> 0) ([a] -> 1) ([a, b] -> 2) ((:: a (:: b rest)) -> 3) ((:: a [b, c]) -> 4) (whole @ (:: x _) -> 5) ((| (:: (:: x _) []) (:: [] _)) -> 6) ((:: 0 _) -> 7) ([Some(x), _] -> 8))")
    assert_eq(tree("for x :: _ in xss do f(x)"), "(for (:: x _) xss (call f x))")

@test("comparison patterns put a name or `_` beside a bound or between two, and `n + k` adds a literal")
comparison_patterns()
    val text = "n match\n    m < 0 -> 1\n    m <= 0 -> 2\n    m > 9 -> 3\n    _ >= 9 -> 4\n    0 <= m < 10 -> 5\n    -5 < _ <= 5 -> 6\n    1 < m -> 7\n    m + 1 -> 8\n    Some(v > 0) -> 9\n    whole @ k + 2 -> 10\n"
    assert_eq(tree(text), "(match n ((m < 0) -> 1) ((m <= 0) -> 2) ((9 < m) -> 3) ((9 <= _) -> 4) ((0 <= m < 10) -> 5) (((- 5) < _ <= 5) -> 6) ((1 < m) -> 7) ((+ m 1) -> 8) (Some((0 < v)) -> 9) (whole @ (+ k 2) -> 10))")

@test("a type pattern puts a name or `_` before `:` and a type, and an arm's arrow ends the type")
type_patterns()
    val text = "x match\n    s: string -> 1\n    _: Box[int] -> 2\n    t: (int, string) -> 3\n    f: ((int) -> int) -> 4\n    Some(d: Dog) -> 5\n    n: int if n > 0 -> 6\n"
    assert_eq(tree(text), "(match x ((: s string) -> 1) ((: _ Box[int]) -> 2) ((: t (int, string)) -> 3) ((: f (int) -> int) -> 4) (Some((: d Dog)) -> 5) ((: n int) if (n > 0) -> 6))")
    assert_eq(tree("x is _: Dog"), "(is x (: _ Dog))")
    // A clause's arguments are patterns, so a type pattern needs no parentheses there; a parameter's
    // and a binding's `:` begins their type, so one there is in parentheses.
    assert_eq(declarations("f(x: Any)\nf(s: string) = 1\nf(_) = 2\n"), "(def f(x: Any) (clause ((: s string)) 1) (clause (_) 2))\n")
    assert_eq(tree("if a\n    val ((s: string), n) = t\n"), "(if a (block (val (tuple (: s string) n) t)))")

@test("`lazy` is a modifier only before `val` or `var`, and elsewhere an ordinary name")
lazy_modifier()
    assert_eq(declarations("lazy val a: int = f()\n"), "(lazy val a: int (call f))\n")
    assert_eq(declarations("private lazy val a = 1\n"), "(lazy val a 1)\n")
    assert_eq(declarations("class C()\n    private lazy val n: int = 2\n"), "(class C() (private lazy val n: int 2))\n")
    assert(parses("lazy(x: int) -> int = x\nmain() -> int = lazy(1)\n"))
    assert(parses("f(lazy: int) -> int = lazy\n"))
    assert(!parses("lazy var a = 1\n"))
    assert(!parses("f() -> int\n    lazy val a = 1\n    a\n"))

@test("a function type with one parameter needs no parentheses, and `->` in a type groups to the right")
light_function_types()
    assert_eq(declarations("val a: int -> string = f\n"), "(val a: (int) -> string f)\n")
    assert_eq(declarations("val a: (int) -> string = f\n"), "(val a: (int) -> string f)\n")
    assert_eq(declarations("val a: Option[T] -> bool = f\n"), "(val a: (Option[T]) -> bool f)\n")
    assert_eq(declarations("val a: int -> int -> int = f\n"), "(val a: (int) -> (int) -> int f)\n")
    assert_eq(declarations("val a: int -> (int -> int) = f\n"), "(val a: (int) -> (int) -> int f)\n")
    assert_eq(declarations("val a: (int -> int) -> int = f\n"), "(val a: ((int) -> int) -> int f)\n")
    assert_eq(declarations("val a: (int, int) -> int = f\n"), "(val a: (int, int) -> int f)\n")
    assert_eq(declarations("val a: ((int, int)) -> int = f\n"), "(val a: ((int, int)) -> int f)\n")
    assert_eq(declarations("val a: () -> int -> int = f\n"), "(val a: () -> (int) -> int f)\n")
    assert_eq(declarations("val a: List[int -> int] = f\n"), "(val a: List[(int) -> int] f)\n")
    assert_eq(declarations("val a: (int -> int, string) = f\n"), "(val a: ((int) -> int, string) f)\n")
    assert_eq(declarations("val a: Map[string, int -> int] = f\n"), "(val a: Map[string, (int) -> int] f)\n")

@test("`@sendable` marks the whole function type after it, in every type position, and only a function type")
sendable_function_types()
    assert_eq(declarations("val a: @sendable (int) -> int = f\n"), "(val a: @sendable (int) -> int f)\n")
    assert_eq(declarations("val a: @sendable int -> int -> int = f\n"), "(val a: @sendable (int) -> (int) -> int f)\n")
    assert_eq(declarations("val a: int -> @sendable () -> int = f\n"), "(val a: (int) -> @sendable () -> int f)\n")
    assert_eq(declarations("val a: (@sendable () -> int) -> int = f\n"), "(val a: (@sendable () -> int) -> int f)\n")
    assert_eq(declarations("val a: List[@sendable (int, string) -> unit] = f\n"), "(val a: List[@sendable (int, string) -> unit] f)\n")
    assert_eq(declarations("val a: (@sendable () -> int, int) = f\n"), "(val a: (@sendable () -> int, int) f)\n")
    assert_eq(declarations("val a: @sendable (-> int) -> int = f\n"), "(val a: @sendable (-> int) -> int f)\n")
    assert(parses("f(@sendable g: @sendable () -> int) -> @sendable () -> int = g\n"))
    assert(diagnostics("val a: @sendable int = 1\n").contains("only a function type can be `@sendable`"))
    assert(diagnostics("val a: @sendable (int, int) = f\n").contains("only a function type can be `@sendable`"))
    assert(diagnostics("val a: @sendable []int = f\n").contains("only a function type can be `@sendable`"))

@test("`[]T` is `Vector[T]` in every type position, and `[]int -> int` is a function from a vector")
slice_types()
    assert_eq(declarations("val a: []int = f\n"), "(val a: Vector[int] f)\n")
    assert_eq(declarations("val a: [][]int = f\n"), "(val a: Vector[Vector[int]] f)\n")
    assert_eq(declarations("val a: []int -> int = f\n"), "(val a: (Vector[int]) -> int f)\n")
    assert_eq(declarations("val a: [](int -> int) = f\n"), "(val a: Vector[(int) -> int] f)\n")
    assert_eq(declarations("val a: []Option[int] = f\n"), "(val a: Vector[Option[int]] f)\n")
    assert_eq(declarations("val a: Option[[]string] = f\n"), "(val a: Option[Vector[string]] f)\n")
    assert_eq(declarations("val a: ([]int, string) = f\n"), "(val a: (Vector[int], string) f)\n")
    assert_eq(declarations("val a: [](int, string) = f\n"), "(val a: Vector[(int, string)] f)\n")
    assert_eq(declarations("val a: Map[string, []int] = f\n"), "(val a: Map[string, Vector[int]] f)\n")
    assert_eq(declarations("val a: int -> []int = f\n"), "(val a: (int) -> Vector[int] f)\n")
    assert_eq(declarations("val a: []int -> []int = f\n"), "(val a: (Vector[int]) -> Vector[int] f)\n")
    assert(parses("main(args: []string) -> int = args.length()\n"))
    assert(parses("f(xs: []int) -> []int = xs\n"))
    assert(parses("data Row(cells: []string, grid: [][]int)\n"))
    assert(parses("class Box[T](items: []T)\n"))
    assert(parses("lazy(x: -> []int) -> int = 1\n"))
    assert_eq(tree("x match\n    v: []int -> 1\n    w: [][]string -> 2\n    _ -> 3\n"), "(match x ((: v Vector[int]) -> 1) ((: w Vector[Vector[string]]) -> 2) (_ -> 3))")
    assert(diagnostics("val a: [3]int = f\n").contains("there is no fixed-length `[N]T` type"))

@test("a light function type works in parameters, results, by-name parameters, fields and supertypes")
light_function_types_in_signatures()
    assert(parses("apply(f: int -> int, x: int) -> int = f(x)\n"))
    assert(parses("adder(n: int) -> int -> int = x -> x + n\n"))
    assert(parses("curry() -> int -> int -> int = a -> b -> a + b\n"))
    assert(parses("lazy(x: -> int -> int) -> int = 1\n"))
    assert(parses("lazy(x: -> (int -> int) -> int) -> int = 1\n"))
    assert(parses("data Handler(run: string -> bool, next: Option[string -> bool])\n"))
    assert(parses("class Box[T](f: T -> T)\n"))
    assert(parses("class Twice : int -> int\n    apply(x: int) -> int = x\n"))

@test("a signature with no body is followed by its clauses, with inline guards or a guard block")
clauses()
    val text = "classify(n: int) -> string\nclassify(0) = \"zero\"\nclassify(n)\n    | n < 0 = \"negative\"\n    | _ = \"large\"\nfib(n: int) -> int\nfib(n) | n > 1 = fib(n - 1)\nfib(_) = 1\npair(a: int, b: bool)\npair(0, true) =\n    f()\n    1\npair(_, _) = 2\nnext() = 3\n"
    assert_eq(declarations(text), "(def classify(n: int) -> string (clause (0) \"zero\") (clause (n) (| (n < 0) \"negative\") \"large\"))\n(def fib(n: int) -> int (clause (n) (| (n > 1) (call fib (- n 1)))) (clause (_) 1))\n(def pair(a: int, b: bool) (clause (0, true) (block (call f) 1)) (clause (_, _) 2))\n(def next() 3)\n")
    // In a block, a signature followed by clauses declares a local function, and two calls stay calls.
    assert_eq(tree("if a\n    go(n: int)\n    go(0) = 1\n    go(_) = 2\n    f(1)\n    f(2)\n"), "(if a (block (def go(n: int) (clause (0) 1) (clause (_) 2)) (call f 1) (call f 2)))")

@test("a comma list fills a line as a tuple without parentheses, and assigns several places at once")
line_tuples()
    assert_eq(tree("if a\n    x, y = y, x\n    (x, y) = (y, x)\n    x, y += 1, 2\n    t = 1, 2\n    1, 2\n"), "(if a (block (= (x y) (tuple y x)) (= (x y) (tuple y x)) (+= (x y) (tuple 1 2)) (= t (tuple 1 2)) (tuple 1 2)))")
    assert_eq(tree("if a\n    val q, r = f(), 2\n    var (m, (n, _)) = t\n    return m, n\n"), "(if a (block (val (tuple q r) (tuple (call f) 2)) (var (tuple m (tuple n _)) t) (return (tuple m n))))")
    // Inside brackets a comma separates arguments, and a lambda's body ends at one.
    assert_eq(tree("if a\n    f(x -> x, 1)\n"), "(if a (block (call f (fn (x) x) 1)))")
    assert_eq(declarations("pair(n: int) -> (int, int) = n, n\nfirst(p: (int, int))\nfirst((a, _)) = a\n"), "(def pair(n: int) -> (int, int) (tuple n n))\n(def first(p: (int, int)) (clause ((tuple a _)) a))\n")
    assert_eq(tree("n match\n    0 -> 1, 2\n    _ -> 3, 4\n"), "(match n (0 -> (tuple 1 2)) (_ -> (tuple 3 4)))")

@test("an interpolated string keeps its text pieces, decoded, around the expressions in its holes")
interpolations()
    assert_eq(tree("s\"n is $n, ${n * 2} doubled, $$5\""), "(s\"\" \"n is \" n \", \" (* n 2) \" doubled, $5\")")
    assert_eq(tree("s\"${a}${b}\""), "(s\"\" \"\" a \"\" b \"\")")
    assert_eq(tree("s\"tab\\t ${f(\"}\")} end\""), "(s\"\" \"tab\\t \" (call f \"}\") \" end\")")
    assert_eq(tree("s\"outer ${s\"inner $x\"}\""), "(s\"\" \"outer \" (s\"\" \"inner \" x \"\") \"\")")
    val errors = diagnostics("main() = s\"a ${} b ${1 +} c ${1 2}\"")
    assert(errors.contains("an interpolation hole needs an expression"), errors)
    assert(errors.contains("expected an expression"), errors)
    assert(errors.contains("unexpected input after the expression in this hole"), errors)

@test("a match guard's arrow is not read as a lambda")
guard_arrows()
    assert_eq(tree("n match\n    k if ok(k) -> k\n    else 0\n"), "(match n (k if (call ok k) -> k) (_ -> 0))")
    assert_eq(tree("n match\n    k if any(x -> x) -> k\n    else 0\n"), "(match n (k if (call any (fn (x) x)) -> k) (_ -> 0))")

@test("a `match` with nothing before it is a function: one arm on its line, or an indented block")
bare_match_functions()
    assert_eq(tree("xs.collect(match Some(n) -> n)"), "(call (. xs collect) (match (Some(n) -> n)))")
    assert_eq(tree("f(match (k, v) if k > 0 -> v, 2)"), "(call f (match ((tuple k v) if (k > 0) -> v)) 2)")
    assert_eq(tree("shapes.collect(match\n    Circle(r) -> r\n    Rect(w, h) -> w * h)\n"), "(call (. shapes collect) (match (Circle(r) -> r) (Rect(w, h) -> (* w h))))")
    assert_eq(tree("shapes collectFirst match\n    Circle(r) if r > 10 -> r\n"), "(call (. shapes collectFirst) (match (Circle(r) if (r > 10) -> r)))")
    // A one-line `match` function opens no block: the lines after it keep their layout.
    assert_eq(tree("g(f(match 1 -> 2),\n        3)\n"), "(call g (call f (match (1 -> 2))) 3)")
    assert(diagnostics("f() = g(match)\n").contains("expected match arms after `match`"))

@test("blocks, bindings and control forms parse with their optional end markers")
control()
    assert_eq(tree("if a then 1 else 2"), "(if a 1 2)")
    assert_eq(tree("if a then 1 elif b then 2 else 3"), "(if a 1 (if b 2 3))")
    assert_eq(tree("if a\n    f()\n    1\nelse\n    2\nend if\n"), "(if a (block (call f) 1) (block 2))")
    assert_eq(tree("while go() do step()"), "(while (call go) (call step))")
    assert_eq(tree("while n < 10\n    n += 1\n    if n == 5 then break n\nelse -1\n"), "(while (n < 10) (block! (+= n 1) (if (n == 5) (break n))) (- 1))")
    assert_eq(tree("loop do step()"), "(loop (call step))")
    assert_eq(tree("loop\n    n += 1\n    if n == 5 then break n\n"), "(loop (block! (+= n 1) (if (n == 5) (break n))))")

    assert_eq(tree("do i += 1 while i < 4"), "(do (+= i 1) (i < 4))")
    assert_eq(tree("do\n    f()\n    g()\nwhile go()\nelse 0\n"), "(do (block! (call f) (call g)) (call go) 0)")
    assert_eq(tree("val x: int = 1"), "(val x: int 1)")
    assert_eq(tree("var total =\n    1\n"), "(var total (block 1))")
    assert_eq(tree("return"), "(return)")
    // A `return` or `break` value fills a line, so a list makes a tuple; inside brackets whose commas
    // separate items, the value stops at the comma.
    assert_eq(tree("return 1, 2"), "(return (tuple 1 2))")
    assert_eq(tree("f(a = return 1, b = 2)"), "(call f a=(return 1) b=2)")
    assert_eq(tree("f(return 1, 2)"), "(call f (return 1) 2)")
    assert_eq(tree("(return 1, 2)"), "(tuple (return 1) 2)")
    assert_eq(tree("[return 1, 2]"), "[(return 1) 2]")
    assert_eq(tree("f(() -> a, b)"), "(call f (fn () a) b)")
    assert_eq(tree("f(g(1), return 1, 2)"), "(call f (call g 1) (return 1) 2)")

@test("declarations: module, imports, annotations, generics, parameters and data")
declarations_parse()
    val text = "module demo.app\nimport a.b.{c, d as e}\nimport f.g as h\n@test(\"name\", timeout: 30)\ncheck() = 1\n@intrinsic(\"print_line\")\nprintln(text: string)\npick[T: Ord + Hash, U](f: (T, -> U) -> U, n: int = 1, xs: T*) -> U\n    f(xs)\nunless(c: bool, body: -> unit)\n    body\ndata Shape derives Eq\n    Circle(r: real)\n    Empty\n"
    val src = source_of("test.avin", text)
    val parsed = parse(src)
    if parsed.report.has_errors() then panic(parsed.report.render(src))
    assert_eq(parsed.file.module_name, "demo.app")
    assert_eq(parsed.file.imports.len(), 3usize)
    assert_eq(parsed.file.imports[1].path, "a.b.d")
    assert_eq(parsed.file.imports[1].binding, "e")
    assert_eq(parsed.file.imports[2].binding, "h")
    assert_eq(declarations(text), "(def @test check() 1)\n(def @intrinsic println(text: string))\n(def pick[T: Ord + Hash, U](f: (T, -> U) -> U, n: int = 1, xs: T*) -> U (block (call f xs)))\n(def unless(c: bool, body: -> unit) (block! body))\n(data Shape Circle(r: real) Empty derives Eq)\n")

@test("a top-level declaration may be marked private, an impl not; the module header keeps its span")
private_declarations_parse()
    val text = "module tools\nprivate helper() = 1\nprivate data Mark\n    Blank\nprivate class Box(x: int)\nprivate object Registry\n    val n = 1\nprivate val limit = 3\nopen() = helper()\n"
    val src = source_of("tools.avin", text)
    val parsed = parse(src)
    if parsed.report.has_errors() then panic(parsed.report.render(src))
    assert_eq(parsed.file.items.len(), 6usize)
    assert_eq(parsed.file.private_items.len(), 6usize)
    for i in 0..<5
        assert(parsed.file.private_items[i])
    assert(!parsed.file.private_items[5])
    assert_eq(parsed.file.module_span.start, 0usize)
    assert(parsed.file.module_span.end >= "module tools".bytes.len)
    val unheaded = parse(source_of("plain.avin", "f() = 1\n"))
    assert_eq(unheaded.file.module_name, "")
    val impl_src = source_of("impl.avin", "private impl int\n    twice() -> int = self * 2\n")
    val refused = parse(impl_src)
    assert(refused.report.render(impl_src).contains("an impl has no name, so it cannot be private"))

@test("data declares variants in a block, or one variant on one line, with variance on its parameters")
data_forms()
    assert_eq(declarations("data Point(x: int, y: int)\n"), "(data Point Point(x: int, y: int))\n")
    assert_eq(declarations("data Pair[+A, -B](a: A, b: B) derives Eq, Hash\n"), "(data Pair[+A, -B] Pair(a: A, b: B) derives Eq, Hash)\n")
    assert_eq(declarations("data Option[+T]\n    Some(value: T)\n    None\nf() = 1\n"), "(data Option[+T] Some(value: T) None)\n(def f() 1)\n")

@test("a class takes marked parameters and a body of fields, methods and statements")
class_forms()
    assert_eq(declarations("class P(x: int)\n"), "(class P(x: int))\n")
    assert_eq(declarations("class Box[T](val value: T, var count: int, private var seen: bool)\n"), "(class Box[T](val value: T, var count: int, private var seen: bool))\n")
    val account = "class Account(owner: string, var balance: int)\n    if balance < 0 then println(\"overdrawn\")\n    val opened = 1\n    private var log: string = \"\"\n    deposit(amount: int)\n        balance += amount\n    describe() -> string = owner\n    private helper() = 1\nend Account\n"
    assert_eq(declarations(account), "(class Account(owner: string, var balance: int) (if (balance < 0) (call println \"overdrawn\")) (val opened 1) (private var log: string \"\") (def deposit(amount: int) (block! (+= balance amount))) (def describe() -> string owner) private (def helper() 1))\n")
    assert_eq(declarations("open class A\n    override f() = 1\nabstract class B(x: int): A, Display derives Eq\n"), "(open class A() override (def f() 1))\n(abstract class B(x: int) : A, Display derives Eq)\n")

@test("class parameters and members are diagnosed where they are malformed")
class_errors()
    assert(diagnostics("class C(private x: int)\n").contains("a plain class parameter is already private"))
    assert(diagnostics("class C(f: -> int)\n").contains("cannot be by-name"))
    assert(diagnostics("class C\n    val a, b = 1, 2\n").contains("a field declaration names one field"))

@test("an object has a body like a class's and no parameters, and a file may declare values")
object_and_value_forms()
    assert_eq(declarations("object Config\n    val port = 80\n    var verbose = false\n    describe() -> string = \"c\"\n    println(\"made\")\n"), "(object Config (val port 80) (var verbose false) (def describe() -> string \"c\") (call println \"made\"))\n")
    assert_eq(declarations("object Empty\nobject Child: Base\n"), "(object Empty)\n(object Child : Base)\n")
    assert_eq(declarations("val limit = 10\nvar count: int = limit * 2\n"), "(val limit 10)\n(var count: int (* limit 2))\n")
    assert_eq(declarations("object(x: int) = x\n"), "(def object(x: int) x)\n")
    assert(diagnostics("object Box[T]\n").contains("cannot be generic"))
    assert(diagnostics("object Point(x: int)\n").contains("takes no parameters"))
    assert(diagnostics("val a, b = 1, 2\n").contains("a module-level declaration names one value"))

@test("a trait has type parameters, required traits and a body of methods, with or without bodies")
trait_forms()
    assert_eq(declarations("trait Shape\n    area() -> int\n    describe() -> string = \"shape\"\n"), "(trait Shape (def area() -> int) (def describe() -> string \"shape\"))\n")
    assert_eq(declarations("trait Source[+T]: Sized, Named\ntrait Empty\n"), "(trait Source[+T] : Sized, Named)\n(trait Empty)\n")
    assert_eq(declarations("trait(x: int) = x\n"), "(def trait(x: int) x)\n")
    assert(diagnostics("trait Point(x: int)\n").contains("a trait has no constructor, so it takes no parameters"))

@test("a member signature with typed parameters ending its line is an abstract method yielding unit; a call stays a statement")
abstract_unit_methods()
    assert_eq(declarations("trait Log\n    log(text: string)\n    flush[T: Sized](x: T)\n"), "(trait Log (def log(text: string)) (def flush[T: Sized](x: T)))\n")
    assert_eq(declarations("class C(n: int)\n    show(n)\n"), "(class C(n: int) (call show n))\n")

@test("a type parameter's lower bound is written `W >: T`, before any bounds, on functions and on methods with or without a body")
lower_bounds()
    assert_eq(declarations("pick[T, W >: T: Ord + Hash](x: W) -> W = x\n"), "(def pick[T, W >: T: Ord + Hash](x: W) -> W x)\n")
    assert_eq(declarations("trait Bag[+V]\n    put[W >: V](value: W) -> Bag[W]\n"), "(trait Bag[+V] (def put[W >: V](value: W) -> Bag[W]))\n")
    assert_eq(declarations("class Box[+T](item: T)\n    or[W >: List[T]](other: W) -> W = other\n"), "(class Box[+T](item: T) (def or[W >: List[T]](other: W) -> W other))\n")
    assert(diagnostics("pick[T, W: Ord >: T](x: W) = x\n").contains("a lower bound comes before the bounds, as in `[W >: T: Display]`"))

@test("a `val` with a type and no value at the end of its line is an abstract field; with `=` it is a field")
abstract_fields()
    assert_eq(declarations("trait Named\n    val name: string\n    var count: List[int]\n"), "(trait Named (val name: string) (var count: List[int]))\n")
    assert_eq(declarations("class A\n    val name: string = \"a\"\n    private val n: int\n"), "(class A() (val name: string \"a\") (private val n: int))\n")

@test("an impl names a type, or a trait for a type, with type parameters of its own and a body of members")
impl_forms()
    assert_eq(declarations("impl Shape\n    area() -> int = 1\n"), "(impl Shape (def area() -> int 1))\n")
    assert_eq(declarations("impl[T] Show[T] for Box[T]\n    override show() -> string = \"box\"\n"), "(impl[T] Show[T] for Box[T] override (def show() -> string \"box\"))\n")
    assert_eq(declarations("impl Marker for Point\nimpl Point\n    var n = 0\n"), "(impl Marker for Point)\n(impl Point (var n 0))\n")
    assert_eq(declarations("impl(x: int) = x\n"), "(def impl(x: int) x)\n")
    assert_eq(declarations("impl(x: int) -> int = x\n"), "(def impl(x: int) -> int x)\n")
    assert_eq(declarations("impl (string) -> int for Lengths\nimpl[K, V] (K) -> V for Table[K, V]\n"), "(impl (string) -> int for Lengths)\n(impl[K, V] (K) -> V for Table[K, V])\n")

@test("`derive Trait for T` is a template: the trait's members written once for a type named `T`")
derive_templates()
    assert_eq(declarations("derive Show for T\n    show() -> string = T.shape().name\n"), "(derive Show for T (def show() -> string (. (call (. T shape)) name)))\n")
    assert_eq(declarations("derive(x: int) = x\n"), "(def derive(x: int) x)\n")

@test("annotations go before a data field, a variant and a class parameter, on the same line")
inline_annotations()
    assert_eq(declarations("data P(@Key(\"n\") name: string, @Omit n: int = 0)\n"), "(data P P(@Key(\"n\") name: string, @Omit n: int = 0))\n")
    assert_eq(declarations("data S\n    @Key(name: \"c\") Circle(r: real)\n    Empty\n"), "(data S @Key(name: \"c\") Circle(r: real) Empty)\n")
    assert_eq(declarations("class A(@Omit val n: int)\n"), "(class A(val @Omit n: int))\n")

@test("a function's parameters take no annotation but `@sendable` or `@isolated`")
parameter_annotations_refused()
    assert(diagnostics("f(@Key(\"x\") n: int) = n\n").contains("a function's parameter takes no annotation but `@sendable` or `@isolated`"))
    assert_eq(diagnostics("f(@isolated body: (int) -> int) = body(1)\n"), "")
    assert(diagnostics("data D(@isolated n: int)\n").contains("`@isolated` marks a parameter of a function or a class"))
    assert_eq(diagnostics("f(@sendable body: () -> int) = body()\n"), "")
    assert_eq(declarations("f(@sendable body: -> int) = body\n"), "(def f(@sendable body: -> int) body)\n")
    assert(diagnostics("data D(@sendable n: int)\n").contains("`@sendable` marks a parameter of a function or a class"))

@test("a function type after `:` is a parent, beside a superclass and traits")
function_type_parents()
    assert_eq(declarations("class Table: (int) -> string\n"), "(class Table() : (type (int) -> string))\n")
    assert_eq(declarations("trait Seq[+T]: Iterable[T], ((int, int)) -> T\n"), "(trait Seq[+T] : (apply Iterable T), (type ((int, int)) -> T))\n")
    assert_eq(declarations("class Lookup: Base(1), (string) -> bool, Display\n"), "(class Lookup() : (call Base 1), (type (string) -> bool), Display)\n")
    assert_eq(declarations("class Lookup: Base(x -> x), string -> bool, Display\n"), "(class Lookup() : (call Base (fn (x) x)), (type (string) -> bool), Display)\n")
    assert_eq(declarations("trait Seq[+T]: Iterable[T], int -> T\n"), "(trait Seq[+T] : (apply Iterable T), (type (int) -> T))\n")

@test("`static` marks a member of the type, in a trait, an impl and a class, before or after `override`")
static_members()
    assert_eq(declarations("trait Add\n    static zero() -> Self\n"), "(trait Add static (def zero() -> Self))\n")
    assert_eq(declarations("impl Add for Point\n    static zero() -> Point = Point(0, 0)\n"), "(impl Add for Point static (def zero() -> Point (call Point 0 0)))\n")
    assert_eq(declarations("class M: Add\n    override static zero() -> M = M()\n    static override one() -> M = M()\n"), "(class M() : Add override static (def zero() -> M (call M)) override static (def one() -> M (call M)))\n")

@test("local functions in a block are declarations, and calls stay calls")
local_functions()
    assert_eq(declarations("f() =\n    helper(n: int) = n\n    helper(1)\n"), "(def f() (block (def helper(n: int) n) (call helper 1)))\n")
    assert_eq(tree("x =\n    1\n"), "(= x (block 1))")
    assert_eq(declarations("outer() -> int\n    inner(x: int) -> int\n        x\n    inner(2)\n"), "(def outer() -> int (block (def inner(x: int) -> int (block x)) (call inner 2)))\n")
    // A call with untyped arguments before `=` assigns an element; empty parentheses still declare.
    assert_eq(declarations("f() =\n    xs(i) = v\n    xs(i + 1) += 1\n    g() = 2\n"), "(def f() (block (= (call xs i) v) (+= (call xs (+ i 1)) 1) (def g() 2)))\n")

@test("`for` binds a pattern to each element of its source, with `do` on one line or an indented body")
for_loops()
    assert_eq(tree("for x in xs do f(x)"), "(for x xs (call f x))")
    assert_eq(tree("for i in 0..<n\n    f(i)\n"), "(for i (..< 0 n) (block! (call f i)))")
    assert_eq(tree("for (a, b) in pairs do f(a)"), "(for (tuple a b) pairs (call f a))")
    assert_eq(tree("for i in 0..10 by 2 do f(i)"), "(for i (call (. (.. 0 10) by) 2) (call f i))")
    assert(diagnostics("f() =\n    for x in xs f(x)\n").contains("a one-line `for` needs `do`"))
    assert(parses("f() =\n    for (a, b) in pairs\n        g(a)\n"))

@test("`for` with `yield` takes generators separated by commas or one to a line, each with its guards")
for_yield()
    assert_eq(tree("for x in xs yield x * 2"), "(for (x xs) (yield (* x 2)))")
    // A comparison chain shows infix.
    assert_eq(tree("for x in xs, y in ys if x < y yield x, y"), "(for (x xs) (y ys (if (x < y))) (yield (tuple x y)))")
    assert_eq(tree("for x in xs if p(x) if q(x) yield x"), "(for (x xs (if (call p x)) (if (call q x))) (yield x))")
    assert_eq(tree("for (a, b) in pairs yield a"), "(for ((tuple a b) pairs) (yield a))")
    assert_eq(tree("for\n    x in xs\n    if p(x)\n    y in ys if q(y)\nyield (x, y)\n"), "(for (x xs (if (call p x))) (y ys (if (call q y))) (yield (tuple x y)))")
    assert(parses("f() =\n    val v = for x in xs yield\n        val y = x + 1\n        y * y\n    v\n"))
    // Value definitions belong to the generator before them, each with the guards after it.
    assert_eq(tree("for x in xs if p(x), y = f(x), (a, b) = g(y) if q(a), z in zs yield z"), "(for (x xs (if (call p x))) (= y (call f x)) (= (tuple a b) (call g y) (if (call q a))) (z zs) (yield z))")
    assert_eq(tree("for\n    x in xs\n    y = f(x)\n    if q(y)\nyield y\n"), "(for (x xs) (= y (call f x) (if (call q y))) (yield y))")
    assert(diagnostics("f() =\n    val v = for y = 1, x in xs yield x\n").contains("a `for` starts with a generator"))
    assert(diagnostics("f() =\n    val v = for x in xs, x = 1 yield x\n").contains("`x` is already bound in this `for`"))
    assert(diagnostics("f() =\n    for x in xs, y = x do g(y)\n").contains("a value definition between generators needs `yield`"))
    assert(diagnostics("f() =\n    for x in xs, y in ys do g(x)\n").contains("a `for` without `yield` has one generator and no guards"))
    assert(diagnostics("f() =\n    for x in xs if p(x)\n        g(x)\n").contains("a `for` without `yield` has one generator and no guards"))
    assert(diagnostics("f() =\n    for\n        x in xs\n    g(x)\n").contains("generators written in a block after `for` need `yield`"))
    assert(diagnostics("f() =\n    val yield = 1\n").contains("`yield` is a keyword"))

@test("malformed parameters, end markers and layout are diagnosed once each")
syntax_errors()
    assert(diagnostics("f(xs: int*, n: int) = 1").contains("a repeated parameter must be last"))
    assert(diagnostics("data D\n    V(f: -> int)\n").contains("a data field cannot be by-name"))
    assert(diagnostics("f(xs: -> int*) = 1").contains("a repeated parameter cannot be by-name"))
    assert(diagnostics("f(n: int)\n    n\nend g\n").contains("`end g` cannot close `f`"))
    // `match` after `end` is the marker's label, on a whole function or a statement.
    assert(parses("f(n: int) -> int = n match\n    1 -> 1\n    _ -> 2\nend match\n"))
    assert(parses("f(n: int)\n    n match\n        1 -> g()\n        _ -> h()\n    end match\n    g()\n"))
    assert(diagnostics("f(n: int)\n    while n > 0\n        g()\n    end match\n").contains("`end match` cannot close `while`"))
    assert(diagnostics("f() =\n    1\n  2\n").contains("indentation does not match an enclosing block"))
    assert(diagnostics("f() = (1, 2]").contains("mismatched closing delimiter"))
    assert(diagnostics("f() = x => x").contains("function arrows are written `->`"))
    val repeated = diagnostics("f() = 1 2 3 4 5\ng() = 1\n")
    assert(repeated.contains("expected a new line after a declaration"))
    assert(!repeated.contains("expected a name"))

@test("a repeated parameter is the last, has no default, and a class's may be one; `xs*` splices an argument")
repeated_parameters()
    assert_eq(declarations("f(n: int, xs: int*) = n\n"), "(def f(n: int, xs: int*) n)\n")
    assert(parses("class Path(val parts: string*)\n"))
    assert(diagnostics("f(xs: int*, ys: int*) = 1").contains("a repeated parameter must be last"))
    assert(diagnostics("f(xs: int* = 1) = 1").contains("a repeated parameter cannot have a default"))
    assert(diagnostics("class P(parts: string*, n: int)\n").contains("a repeated parameter must be last"))
    assert(diagnostics("class P(parts: string* = 1)\n").contains("a repeated parameter cannot have a default"))
    assert(diagnostics("data D(xs: int*)\n").contains("a data field cannot be repeated"))
    assert(diagnostics("f(_: int*) = 1").contains("a repeated parameter needs a name"))
    assert_eq(tree("f(xs*)"), "(call f (splice xs))")
    assert_eq(tree("f(1, xs.map(g)*)"), "(call f 1 (splice (call (. xs map) g)))")
    assert_eq(tree("f(a * b)"), "(call f (* a b))")
    assert_eq(tree("f(xs*, 1)"), "(call f (splice xs) 1)")
    assert_eq(tree("f(a ++ xs*)"), "(call f (call (. a ++) (splice xs)))")
    assert_eq(tree("f((a ++ xs)*)"), "(call f (splice (call (. a ++) xs)))")

@test("comments and blank lines do not open blocks, and brackets suspend layout")
layout_rules()
    assert_eq(declarations("// comment\nf() = 1 // trailing\n\n    // indented comment\ng() = [1,\n        2]\n"), "(def f() 1)\n(def g() [1 2])\n")

@test("an indented block after a call's line is the call's last argument, or a lambda's body after `params ->`")
trailing_blocks()
    assert_eq(tree("retry(3)\n    fetch(url)"), "(call retry 3 block=(block (call fetch url)))")
    assert_eq(tree("withFile(\"data.txt\") f ->\n    process(f)"), "(call withFile \"data.txt\" block=(fn (f) (block (call process f))))")
    assert_eq(tree("zipWith(a, b) (x, y) ->\n    x + y"), "(call zipWith a b block=(fn (x y) (block (+ x y))))")
    assert_eq(tree("run() (x: int) ->\n    x"), "(call run block=(fn (x: int) (block x)))")
    assert_eq(tree("scope s ->\n    s.spawn\n        part(1)"), "(call scope block=(fn (s) (block (call (. s spawn) block=(block (call part 1))))))")
    assert_eq(tree("run\n    go()"), "(call run block=(block (call go)))")
    assert_eq(tree("xs.foreach x ->\n    println(x)"), "(call (. xs foreach) block=(fn (x) (block (call println x))))")
    assert_eq(tree("make[int]\n    1"), "(call (apply make int) block=(block 1))")
    assert_eq(tree("a + f(1)\n    2"), "(+ a (call f 1 block=(block 2)))")
    // A one-line lambda after the call stays an error, as an infix call with no argument.
    assert(diagnostics("main() -> int\n    f(1) x -> x\n    0\n").contains("error"))

@test("a trailing block keeps out of headers, declarations, infix continuations and match arms")
trailing_block_neighbours()
    assert_eq(declarations("main() -> int\n    val r = f(1)\n        2\n    r\n"), "(def main() -> int (block (val r (call f 1 block=(block 2))) r))\n")
    assert_eq(tree("if ready(x)\n    go()"), "(if (call ready x) (block (call go)))")
    assert_eq(tree("while more(x)\n    go()"), "(while (call more x) (block! (call go)))")
    assert_eq(tree("for x in xs.filter(p)\n    go(x)"), "(for x (call (. xs filter) p) (block! (call go x)))")
    assert_eq(tree("a max\n    f(1)"), "(call (. a max) (block (call f 1)))")
    assert_eq(tree("x match\n    Some(v) -> f(v)\n        2\n    None -> 0"), "(match x (Some(v) -> (call f v block=(block 2))) (None -> 0))")
    // A local function's header ends its line with typed or empty parameters, and keeps its meaning.
    assert(parses("main() -> int\n    helper()\n        println(1)\n    helper(n: int)\n        println(n)\n    0\n"))
    assert(parses("class C(n: int) : B(n)\n    f() = 1\n"))
    assert(parses("object O : T\n    f() = 1\n"))
    // A line holding only a name and an operand is reported as a misplaced infix call.
    assert(diagnostics("main() -> int\n    val s = b\n        add 2\n    s\n").contains("a line cannot start with the method of an infix call"))
    assert(diagnostics("main() -> int\n    f(1)\n        add 2\n    0\n").contains("a line cannot start with the method of an infix call"))

// The source text a span covers: a span is exact when this is exactly the construct's own words.
private cut(text: string, span: Span) -> string = from_utf8_unchecked(source_of("test.avin", text).text(span))

private parsed_file(text: string) -> SourceFile
    val src = source_of("test.avin", text)
    val parsed = parse(src)
    if parsed.report.has_errors() then panic(parsed.report.render(src))
    parsed.file

private function_at(file: SourceFile, index: usize) -> &Function = file.items[index] match
    FunctionItem(f) -> f
    _ -> panic("not a function")

private class_at(file: SourceFile, index: usize) -> &ClassDecl = file.items[index] match
    ClassItem(c) -> c
    _ -> panic("not a class")

@test("a function's span ends at its own last token: one-line, block, clause and signature-only forms")
function_spans()
    val text = "add(a: int, b: int) -> int = a + b\nsub(a: int, b: int) -> int\n    a - b\nfact(n: int) -> int\nfact(0) = 1\nfact(n) = n * fact(n - 1)\nnamed(x: int) -> int\nmain() -> int = 0\n"
    val file = parsed_file(text)
    val add = function_at(file, 0)
    assert_eq(cut(text, add.span), "add(a: int, b: int) -> int = a + b")
    assert_eq(cut(text, add.name_span), "add")
    assert_eq(cut(text, add.params[0].span), "a: int")
    assert_eq(cut(text, add.params[1].span), "b: int")
    val sub = function_at(file, 1)
    assert_eq(cut(text, sub.span), "sub(a: int, b: int) -> int\n    a - b")
    val fact = function_at(file, 2)
    assert_eq(cut(text, fact.span), "fact(n: int) -> int\nfact(0) = 1\nfact(n) = n * fact(n - 1)")
    assert_eq(cut(text, fact.clauses[0].span), "fact(0) = 1")
    assert_eq(cut(text, fact.clauses[1].span), "fact(n) = n * fact(n - 1)")
    assert_eq(cut(text, function_at(file, 3).span), "named(x: int) -> int")
    assert_eq(cut(text, function_at(file, 4).span), "main() -> int = 0")

@test("the last function of a file ends at its last token with or without a final new line")
function_spans_at_the_end_of_a_file()
    val bare = "main() -> int = 0"
    assert_eq(cut(bare, function_at(parsed_file(bare), 0).span), "main() -> int = 0")
    val block = "main() -> int\n    val x = 1\n    x"
    assert_eq(cut(block, function_at(parsed_file(block), 0).span), block)
    val padded = "main() -> int\n    val x = 1\n    x\n\n\n"
    assert_eq(cut(padded, function_at(parsed_file(padded), 0).span), "main() -> int\n    val x = 1\n    x")

@test("a parameter's span covers its default, by-name arrow and repeat mark, and no more")
parameter_spans()
    val text = "f(a: int = 1, b: -> int, c: int*) -> int = a\n"
    val params = function_at(parsed_file(text), 0).params
    assert_eq(cut(text, params[0].span), "a: int = 1")
    assert_eq(cut(text, params[1].span), "b: -> int")
    assert_eq(cut(text, params[2].span), "c: int*")

@test("a data declaration, its variants and their fields end at their own last token")
data_spans()
    val text = "data Color\n    Red\n    Green(shade: int)\ndata Point(x: int, y: int)\ndata Pair[A, B: Ord](a: A, b: B)\n"
    val file = parsed_file(text)
    val color = file.items[0] match
        DataItem(d) -> d
        _ -> panic("not data")
    assert_eq(cut(text, color.span), "data Color\n    Red\n    Green(shade: int)")
    assert_eq(cut(text, color.variants[0].span), "Red")
    assert_eq(cut(text, color.variants[1].span), "Green(shade: int)")
    assert_eq(cut(text, color.variants[1].fields[0].span), "shade: int")
    val point = file.items[1] match
        DataItem(d) -> d
        _ -> panic("not data")
    assert_eq(cut(text, point.span), "data Point(x: int, y: int)")
    assert_eq(cut(text, point.variants[0].fields[1].span), "y: int")
    val pair = file.items[2] match
        DataItem(d) -> d
        _ -> panic("not data")
    assert_eq(cut(text, pair.span), "data Pair[A, B: Ord](a: A, b: B)")
    assert_eq(cut(text, pair.type_params[0].span), "A")
    assert_eq(cut(text, pair.type_params[1].span), "B: Ord")

@test("a class, its parameters, fields and methods end at their own last token")
class_spans()
    val text = "class Account[T: Ord](val owner: string, var balance: int = 0) : Base(1)\n    val id: int = 1\n    var count = 0\n    deposit(n: int) = n\n    show() -> string\n        \"a\"\nclass Empty\nclass Last(n: int)"
    val file = parsed_file(text)
    val account = class_at(file, 0)
    assert_eq(cut(text, account.span), "class Account[T: Ord](val owner: string, var balance: int = 0) : Base(1)\n    val id: int = 1\n    var count = 0\n    deposit(n: int) = n\n    show() -> string\n        \"a\"")
    assert_eq(cut(text, account.name_span), "Account")
    assert_eq(cut(text, account.type_params[0].span), "T: Ord")
    assert_eq(cut(text, account.params[0].param.span), "val owner: string")
    assert_eq(cut(text, account.params[1].param.span), "var balance: int = 0")
    account.members[0] match
        FieldMember(f) -> assert_eq(cut(text, f.span), "val id: int = 1")
        _ -> panic("not a field")
    account.members[1] match
        FieldMember(f) -> assert_eq(cut(text, f.span), "var count = 0")
        _ -> panic("not a field")
    account.members[2] match
        MethodMember(m, _, _, _) -> assert_eq(cut(text, m.span), "deposit(n: int) = n")
        _ -> panic("not a method")
    account.members[3] match
        MethodMember(m, _, _, _) -> assert_eq(cut(text, m.span), "show() -> string\n        \"a\"")
        _ -> panic("not a method")
    assert_eq(cut(text, class_at(file, 1).span), "class Empty")
    assert_eq(cut(text, class_at(file, 2).span), "class Last(n: int)")
    assert_eq(cut(text, class_at(file, 2).params[0].param.span), "n: int")

@test("a trait, an object and an impl end at their own last token, with abstract members too")
trait_object_and_impl_spans()
    val text = "trait Shape[+T]\n    area() -> int\n    val label: string\nobject Registry\n    lookup(k: int) = k\nimpl Registry\n    other() = 1\nimpl Shape for Registry\n    area() = 2\n"
    val file = parsed_file(text)
    val shape = class_at(file, 0)
    assert_eq(cut(text, shape.span), "trait Shape[+T]\n    area() -> int\n    val label: string")
    assert_eq(cut(text, shape.type_params[0].span), "+T")
    shape.members[0] match
        MethodMember(m, _, _, _) -> assert_eq(cut(text, m.span), "area() -> int")
        _ -> panic("not a method")
    shape.members[1] match
        AbstractFieldMember(f) -> assert_eq(cut(text, f.span), "val label: string")
        _ -> panic("not an abstract field")
    assert_eq(cut(text, class_at(file, 1).span), "object Registry\n    lookup(k: int) = k")
    file.items[2] match
        ImplItem(d) -> assert_eq(cut(text, d.span), "impl Registry\n    other() = 1")
        _ -> panic("not an impl")
    file.items[3] match
        ImplItem(d) -> assert_eq(cut(text, d.span), "impl Shape for Registry\n    area() = 2")
        _ -> panic("not an impl")

@test("module values, lazy values and imports end at their own last token")
value_spans()
    val text = "import a.b\nval limit = 10\nvar total: int = limit\nlazy val big = limit + 1\nval last = 2"
    val file = parsed_file(text)
    assert_eq(cut(text, file.imports[0].span), "import a.b")
    file.items[0] match
        ValueItem(v) -> assert_eq(cut(text, v.span), "val limit = 10")
        _ -> panic("not a value")
    file.items[1] match
        ValueItem(v) -> assert_eq(cut(text, v.span), "var total: int = limit")
        _ -> panic("not a value")
    file.items[2] match
        ValueItem(v) -> assert_eq(cut(text, v.span), "lazy val big = limit + 1")
        _ -> panic("not a value")
    file.items[3] match
        ValueItem(v) -> assert_eq(cut(text, v.span), "val last = 2")
        _ -> panic("not a value")

@test("expression spans of calls, lambdas, matches and blocks end at their own last token")
expression_spans()
    val call = "f(1, 2)"
    assert_eq(cut(call, parse_expression(source_of("test.avin", call)).tree.span), "f(1, 2)")
    val lambda = "xs.map(x -> x + 1)"
    assert_eq(cut(lambda, parse_expression(source_of("test.avin", lambda)).tree.span), lambda)
    val matched = "x match\n    Some(v) -> v\n    None -> 0"
    assert_eq(cut(matched, parse_expression(source_of("test.avin", matched)).tree.span), matched)
    val text = "main() -> int\n    val r = x match\n        Some(v) -> v\n        None -> 0\n    if r > 0 then r else 0\nother() = 1\n"
    val main = function_at(parsed_file(text), 0)
    assert_eq(cut(text, main.span), "main() -> int\n    val r = x match\n        Some(v) -> v\n        None -> 0\n    if r > 0 then r else 0")

private widest(text: string) -> usize = parse(source_of("test.avin", text)).file.widest_tuple

@test("a file records the most parts of any tuple it writes, as a type, a value or a pattern")
widest_tuples()
    assert_eq(widest("f() = 1\n"), 0)
    assert_eq(widest("f(x: (int, int, int)) -> int = 1\n"), 3)
    assert_eq(widest("f() -> Vector[[](int, int, int, int)] = []\n"), 4)
    assert_eq(widest("f() = (1, 2)\n"), 2)
    assert_eq(widest("f() -> (int, int, int) = 1, 2, 3\n"), 3)
    assert_eq(widest("f()\n    a, b, c, d = 1, 2, 3, 4\n"), 4)
    assert_eq(widest("f(t: (int, int)) = t match\n    (a, b, c, d, e) -> a\n"), 5)
    assert_eq(widest("f()\n    val a, b, c = g()\n"), 3)
    assert_eq(widest("f() = s\"${(1, 2, 3, 4, 5, 6)}\"\n"), 6)
