module dev.avinlang.compiler

import sh.sysl.parsing.*
import sysl.text.from_utf8_unchecked
import sysl.buf.{Buf, buf}

// Tokens carry their operator family, which is what the expression parser's binding powers are
// keyed on. Layout is decided here: an indented line opens a block (Indent), a line at the same
// depth separates items (Newline), and a shallower line closes blocks (Dedent). Line breaks inside
// brackets are not significant.
enum Token
    Word
    Number
    RealNumber
    Quoted
    /** A name and a quoted literal with nothing between them: `s"total: $n"`. */
    Interpolated
    CharQuoted
    Symbol
    AddOp
    MultiplyOp
    CompareOp
    RangeOp
    /** `::`, which puts an element in front of a list. */
    ConsOp
    BitOrOp
    BitXorOp
    BitAndOp
    AssignOp
    AndOp
    OrOp
    Postfix
    /** A run of operator characters that is not an operator of the language: a method's name,
     * called infix (`xs ++ ys`, `x +: xs`). */
    SymbolOp
    /** A method named by a symbol in operator position, as the parser sees it, at the level of the
     * language's operator its first character belongs to (`symbol_token`). The lexer never makes
     * these: `~`- and `?`-names, and every name with `~` in it, bind tightest, `*`-names with multiplication, `+`-names with addition,
     * `&`-, `^`- and `|`-names with the bitwise operators, `:`-names with `::`, and `<`-, `>`-,
     * `=`- and `!`-names with the comparisons. */
    SymbolTight
    SymbolMultiply
    SymbolAdd
    SymbolBitAnd
    SymbolBitXor
    SymbolBitOr
    SymbolCons
    SymbolCompare
    IsKeyword
    MatchKeyword
    /** A name in operator position, after a complete operand on the same line: `max` in `a max b`.
     * The lexer never makes one; the parser sees a `Word` there as this. */
    InfixName
    Newline
    Indent
    Dedent
end Token

struct Lexed
    items: Tokens[Token]
    report: Report

// Whether nothing but blanks or a comment follows on the scanner's line; the scanner stays where it is.
private ends_line(s: *Scanner) -> bool
    val after = s.mark()
    s.skip_blanks()
    val ends = s.at_end() || s.at_line_end() || s.starts_with("//".bytes)
    s.reset(after)
    ends

lex(src: Source) -> Lexed =lex_range(src.bytes, Span(0, src.bytes.len), true)

/** The tokens of the expression in an interpolation hole: the bytes `span` covers, with offsets into
 * the whole file, and no layout, since a hole lies inside one line. */
lex_hole(src: Source, span: Span) -> Lexed = lex_range(src.bytes, span, false)

private lex_range(text: []const u8, range: Span, lines: bool) -> Lexed
    var s = scanner(text[0..<range.end])
    s.reset(range.start)
    var lay = layout()
    var out: Tokens[Token] = tokens()
    var rep = report()
    var brackets: Buf[u8] = buf()
    var head = lines
    var started = false
    loop
        if head
            val ind = measure_indent(&s, 8)
            if s.at_end() then break
            if s.at_line_end() || s.starts_with("//".bytes)
                s.skip_line()
                continue
            if ind.is_mixed() then rep.add(error(s.here(), "mixed tabs and spaces in indentation"))
            val at = s.here()
            lay.line(ind.columns) match
                Same ->
                    if started then out.push(Newline, at)
                Deeper -> out.push(Indent, at)
                Shallower(n) ->
                    for i in 0..<n do out.push(Dedent, at)
                Ragged(n) ->
                    for i in 0..<n do out.push(Dedent, at)
                    rep.add(error(at, "indentation does not match an enclosing block"))
            started = true
            head = false
        s.skip_blanks()
        if s.starts_with("//".bytes) then s.skip_to_line_end()
        if s.at_end() then break
        if s.at_line_end()
            s.accept_newline()
            head = lines && lay.significant()
            continue
        val start = s.mark()
        val c = s.peek().unwrap()
        if is_ident_start(c)
            s.read_ident(is_ident_start, is_ident_cont)
            val word = from_utf8_unchecked(text[start..<s.mark()])
            if s.peek() == Some(u8('"'))
                read_interpolated_named(&s, u8('"'), "${".bytes, u8('}'), is_ident_start, is_ident_cont) match
                    Ok(_) -> out.push(Interpolated, s.span_from(start))
                    Err(e) -> rep.add(error(where(e), e.to_string()))
            elif word == "match"
                out.push(MatchKeyword, s.span_from(start))
                // As with `->`, only a `match` that ends its line opens a block: the one arm of
                // `xs.collect(match Some(n) -> n)` leaves the lines after it as they were.
                if ends_line(&s) then lay.opens_block()
            elif word == "is" then out.push(IsKeyword, s.span_from(start))
            else out.push(Word, s.span_from(start))
        elif is_digit(c)
            scan_numeric(&s) match
                Ok(floating) -> out.push(if floating then RealNumber else Number, s.span_from(start))
                Err(e) -> rep.add(error(where(e), e.to_string()))
        elif c == u8('\'')
            read_char_literal(&s, c) match
                Ok(_) -> out.push(CharQuoted, s.span_from(start))
                Err(e) -> rep.add(error(where(e), e.to_string()))
        elif c == u8('"')
            read_quoted(&s, c) match
                Ok(_) -> out.push(Quoted, s.span_from(start))
                Err(e) -> rep.add(error(where(e), e.to_string()))
        else
            read_operator(&s)
            if c == u8('(') || c == u8('[') || c == u8('{')
                brackets.push(c)
                lay.open_bracket()
            if c == u8(')') || c == u8(']') || c == u8('}')
                val want = if c == u8(')') then u8('(') elif c == u8(']') then u8('[') else u8('{')
                if brackets.len() == 0
                    rep.add(error(s.span_from(start), "unmatched closing delimiter"))
                else
                    val opener = brackets.pop().unwrap()
                    if opener != want then rep.add(error(s.span_from(start), "mismatched closing delimiter"))
                val closed = lay.close_bracket()
                for i in 0..<closed do out.push(Dedent, s.span_from(start))
            val span = s.span_from(start)
            val word = from_utf8_unchecked(text[span.start..<span.end])
            if word == "->"
                // Only an arrow that ends its line opens a block. A return type or a function type
                // (`f(b: int) -> int = (b`) has more on the line, and its bracketed continuation lines
                // must stay insignificant.
                if ends_line(&s) then lay.opens_block()
            if word == "=>" then rep.add(error(span, "function arrows are written `->`"))
            out.push(operator_token(word), span)
    val at = s.here()
    if brackets.len() > 0 then rep.add(error(at, "unclosed delimiter"))
    val closed = lay.finish()
    for i in 0..<closed do out.push(Dedent, at)
    Lexed(out, rep)
end lex_range

// Scans a numeric literal and reports whether it is a real. Integer digits are scanned without a
// width limit, since a literal's width comes from its context and may exceed 64 bits; only a
// literal with a fraction or exponent goes through the real-number reader.
private scan_numeric(s: *Scanner) -> Result[bool, LitError]
    val start = s.offset
    scan_integer(s)?
    if s.offset > start + 1 && s.src[start] == u8('0')
        val radix = s.src[start + 1]
        if radix == u8('x') || radix == u8('X') || radix == u8('o') || radix == u8('O') || radix == u8('b') || radix == u8('B') then return Ok(false)
    var real = false
    if s.peek() == Some(u8('.'))
        if s.peek_at(1) is Some(d) then real = d >= u8('0') && d <= u8('9')
    if s.peek() == Some(u8('e')) || s.peek() == Some(u8('E')) then real = true
    if !real then return Ok(false)
    s.reset(start)
    read_number(s) match
        Ok(Real(value)) -> if value.is_infinite() then Err(BadReal(Span(start, s.offset))) else Ok(true)
        Ok(Int(_)) -> Ok(false)
        Err(e) -> Err(e)

private scan_integer(s: *Scanner) -> Result[unit, LitError]
    var base = 10
    if s.peek() == Some(u8('0'))
        val next = s.peek_at(1)
        if next == Some(u8('x')) || next == Some(u8('X')) then base = 16
        elif next == Some(u8('o')) || next == Some(u8('O')) then base = 8
        elif next == Some(u8('b')) || next == Some(u8('B')) then base = 2
        if base != 10 then s.skip(2)
    skip_digits(s, base)

/** The kind of operator token `word` is, as the lexer makes it. */
operator_token(word: string) -> Token
    if word == "+" || word == "-" || word == "+%" || word == "-%" || word == "+|" || word == "-|" then AddOp
    elif word == "*" || word == "/" || word == "%" || word == "<<" || word == ">>" || word == "*%" || word == "*|" then MultiplyOp
    elif word == "==" || word == "!=" || word == "===" || word == "!==" || word == "<" || word == ">" || word == "<=" || word == ">=" then CompareOp
    elif word == ".." || word == "..<" then RangeOp
    elif word == "::" then ConsOp
    elif word == "|" then BitOrOp
    elif word == "^" then BitXorOp
    elif word == "&" then BitAndOp
    elif word == "&&" then AndOp
    elif word == "||" then OrOp
    elif word == "=" || word.ends_with("=") && word != "==" && word != "!=" && word != "<=" && word != ">=" then AssignOp
    elif word == "(" || word == "." || word == "[" || word == "++" || word == "--" || word == "?" then Postfix
    elif word.bytes.len > 1 && is_operator_spelling(word) && word != "->" && word != "=>" then SymbolOp
    else Symbol

/** The characters an operator, and a method named by a symbol, is spelled with. */
is_operator_char(b: u8) -> bool
    for c in "+-*/%<>=!&|^~:?".bytes
        if b == c then return true
    false

/** Whether `word` is a run of operator characters. */
is_operator_spelling(word: string) -> bool
    if word.bytes.len == 0 then return false
    for b in word.bytes
        if !is_operator_char(b) then return false
    true

// An operator is the longest run of operator characters, so `xs ++ ys`, `x +: xs` and `a +%= b` are
// each one token, and `a=-1` is `a`, `=-`, `1`. A run stops before `//`, which begins a comment. The
// range operators are spelled with dots, which are not operator characters.
private read_operator(s: *Scanner)
    for candidate in ["..<", ".."]
        if s.starts_with(candidate.bytes)
            for i in 0..<candidate.bytes.len do s.bump()
            return
    var taken = 0
    loop
        val c = s.peek() match
            Some(c) -> c
            None -> break
        if !is_operator_char(c) || s.starts_with("//".bytes) then break
        s.bump()
        taken += 1
    if taken == 0 then s.bump()
