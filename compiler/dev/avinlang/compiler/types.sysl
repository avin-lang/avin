module dev.avinlang.compiler

import sysl.buf.{Buf, buf}

/** A semantic type. Types are structural values over symbols, never names compared as strings. */
enum Type
    /** The type of an expression that already failed to check; it conforms to everything, so one
     * error is reported once. */
    ErrorType
    /** The type of an expression that never yields: `return`, `break`, a trap. */
    Nothing
    Unit
    Bool
    Char
    Real
    Str
    /** A signed integer of a fixed width; `int` is `Int(32)`. */
    Int(bits: u32)
    Tuple(items: Buf[&Type])
    Function(params: Buf[&Type], result: &Type)
end Type

const IntBits: u32 = 32

int_type() -> &Type = Int(IntBits)

same_type(a: &Type, b: &Type) -> bool = *a match
    ErrorType -> *b is ErrorType
    Nothing -> *b is Nothing
    Unit -> *b is Unit
    Bool -> *b is Bool
    Char -> *b is Char
    Real -> *b is Real
    Str -> *b is Str
    Int(x) -> *b match
        Int(y) -> x == y
        _ -> false
    Tuple(xs) -> *b match
        Tuple(ys) -> same_types(xs, ys)
        _ -> false
    Function(xs, r) -> *b match
        Function(ys, s) -> same_types(xs, ys) && same_type(r, s)
        _ -> false

private same_types(xs: Buf[&Type], ys: Buf[&Type]) -> bool
    if xs.len() != ys.len() then return false
    for i in 0..<xs.len()
        if !same_type(xs.at(i), ys.at(i)) then return false
    true

/** Whether a value of type `from` may be used where `to` is expected. */
conforms(from: &Type, to: &Type) -> bool
    if *from is ErrorType || *to is ErrorType || *from is Nothing then return true
    same_type(from, to)

/** The type as a program spells it, for diagnostics. */
type_name(t: &Type) -> string = *t match
    ErrorType -> "<error>"
    Nothing -> "Nothing"
    Unit -> "unit"
    Bool -> "bool"
    Char -> "char"
    Real -> "real"
    Str -> "string"
    Int(bits) -> if bits == IntBits then "int" else s"i$bits"
    Tuple(items) -> "(" + type_list(items) + ")"
    Function(params, result) -> "(" + type_list(params) + ") -> " + type_name(result)

private type_list(items: Buf[&Type]) -> string
    var out = ""
    for i in 0..<items.len()
        if i > 0 then out = out + ", "
        out = out + type_name(items.at(i))
    out

/** The built-in type a name denotes: `int`, `bool`, `iN` and the rest. */
builtin_type(name: string) -> Option[&Type]
    if name == "int" then return Some(int_type())
    if name == "bool" then return Some(Bool)
    if name == "string" then return Some(Str)
    if name == "unit" then return Some(Unit)
    if name == "char" then return Some(Char)
    if name == "real" then return Some(Real)
    if name.bytes.len < 2 || name.bytes[0] != u8('i') then return None
    var bits = 0u32
    for i in 1..<name.bytes.len
        val b = name.bytes[i]
        if b < u8('0') || b > u8('9') then return None
        if i == 1 && b == u8('0') then return None
        bits = bits * 10 + u32(b - u8('0'))
        if bits > 8388608 then return None
    Some(Int(bits))
