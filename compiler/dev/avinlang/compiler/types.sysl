module dev.avinlang.compiler

import sysl.buf.{Buf, buf}

/** A semantic type. Types are structural values over symbols, never names compared as strings. */
enum Type
    /** The type of an expression that already failed to check; it conforms to everything, so one
     * error is reported once. */
    ErrorType
    /** The type of an expression that never yields: `return`, `break`, a trap. */
    Nothing
    /** `Any`, the top type: a reference to any object. A value of a value type becomes one by
     * boxing, and a type pattern takes it apart again. */
    AnyType
    Unit
    Bool
    Char
    Real
    Str
    /** An octet, 0 to 255: binary data, with bitwise operations and no arithmetic. */
    Byte
    /** A signed integer of a fixed width; `int` is `Int(32)`. */
    Int(bits: u32)
    Tuple(items: Buf[&Type])
    /** A function type; `sendable` is set for `@sendable (A) -> B`, whose values capture only
     * sendable values and reach no module-level state a thread may not, so they may run on any
     * thread. */
    Function(params: Buf[&Type], result: &Type, sendable: bool)
    /** The type of a by-name parameter, `-> T`: an expression of type `T`, evaluated at each read.
     * It is the type of a parameter only, so the mode is part of its function's type. */
    ByName(inner: &Type)
    /** A `data` type, by its index in the program's data table, with its name for diagnostics and
     * its type arguments. */
    Data(id: usize, name: string, args: Buf[&Type])
    /** A class: a reference to an object with identity, by its index in the program's class table,
     * with its name for diagnostics and its type arguments. */
    Class(id: usize, name: string, args: Buf[&Type])
    /** A type parameter, inside the declaration it belongs to: opaque, since it may be any type.
     * `owner` is a generic function's symbol, `data_owner` of a data type's index, or `class_owner`
     * of a class's index; `index` is its position in the type parameters. `Self` in a trait is one
     * too, owned by `self_owner` of the trait. */
    TypeVar(owner: usize, index: usize, name: string)
    /** An unknown the checker is solving for, by its index in the checker's table. */
    Var(id: usize)
    /** A union `A | B`: a value of any one of its members. The members are in the order they were
     * written, flattened, each named once, never `Nothing` or `Any`, and at least two (`union_of`
     * keeps that form); two unions with the same members are one type, whatever their order. */
    Union(members: Buf[&Type])
    /** An opaque type, `opaque type Name = Repr`: a nominal type of its own, by its index in the
     * checker's table of type declarations, with its name for diagnostics and its type arguments.
     * `repr` is its representation with those arguments in place, which only its defining module
     * sees through; a value of it is laid out as a value of `repr` is, and it is otherwise a type
     * apart from every other. */
    Opaque(id: usize, name: string, args: Buf[&Type], repr: &Type)
    /** A type constructor of `arity` arguments, what a constructor parameter `F[_]` stands for: a
     * data type, class or trait with `hole(i)` among its direct arguments for the `i`th argument left
     * open (`Result[_, ParseError]` is `Result[hole(0), ParseError]`), or a constructor parameter
     * applied to holes. That is the one form a constructor has, so two are one exactly when they are
     * structurally the same type. A constructor is never the type of a value. */
    Constructor(body: &Type, arity: usize)
    /** `F[A]`: a constructor parameter, or what it was replaced by, applied to types. Substituting a
     * `Constructor` for the head fills its holes, so no instance keeps one. */
    Applied(head: &Type, args: Buf[&Type])
end Type

/** The representation of `t`, through every opaque type it is: what its values are laid out as. */
representation(t: &Type) -> &Type = *t match
    Opaque(_, _, _, repr) -> representation(repr)
    _ -> t

/** The owner of the holes of a `Constructor`'s body. */
hole_owner() -> usize = 1usize << 44

/** The `index`th argument a constructor leaves open. */
hole(index: usize) -> &Type = TypeVar(hole_owner(), index, "_")

/** `head` applied to `args`: a constructor's body with its holes filled in order, or an `Applied`
 * while the head is still a constructor parameter. */
apply_constructor(head: &Type, args: Buf[&Type]) -> &Type = *head match
    Constructor(body, _) -> substitute(body, hole_owner(), args)
    ErrorType -> head
    _ -> Applied(head, args)

/** The constructor a constructor parameter `p` of `arity` holes is when passed bare: `p` applied to
 * its holes. */
parameter_constructor(p: &Type, arity: usize) -> &Type
    var holes: Buf[&Type] = buf()
    for i in 0..<arity
        holes.push(hole(i))
    Constructor(Applied(p, holes), arity)

/** The union of `members` in normal form, as far as it needs no knowledge of declarations: nested
 * unions flattened, a member named twice kept once, `Nothing` dropped, a union with `Any` among its
 * members `Any`, and one member that member. A member that converts to another by subtyping or into
 * a trait is absorbed by the checker, which knows the declarations. */
union_of(members: Buf[&Type]) -> &Type
    var flat: Buf[&Type] = buf()
    for m in members
        add_member(&flat, m)
    for m in flat
        if *m is AnyType || *m is ErrorType then return m
    if flat.len() == 0 then return Nothing
    if flat.len() == 1 then return flat[0]
    Union(flat)

private add_member(flat: *Buf[&Type], m: &Type)
    *m match
        Union(inner) ->
            for i in inner
                add_member(flat, i)
        Nothing -> ()
        _ ->
            for f in *flat
                if same_type(f, m) then return
            flat.push(m)

/** The members of `t`: its own where it is a union, and otherwise `t` alone. */
members_of(t: &Type) -> Buf[&Type] = *t match
    Union(ms) -> ms
    _ ->
        var one: Buf[&Type] = buf()
        one.push(t)
        one

/** `t` with every union in it, at any depth, replaced by `Any`: the type its value is seen as once
 * converted to an `Any`, a scalar member in a box. */
erase_unions(t: &Type) -> &Type = *t match
    Union(_) -> AnyType
    Tuple(items) -> Tuple(erase_all(items))
    Function(params, result, sendable) -> Function(erase_all(params), erase_unions(result), sendable)
    ByName(inner) -> ByName(erase_unions(inner))
    Data(id, name, args) -> Data(id, name, erase_all(args))
    Class(id, name, args) -> Class(id, name, erase_all(args))
    Opaque(id, name, args, repr) -> Opaque(id, name, erase_all(args), erase_unions(repr))
    _ -> t

private erase_all(items: Buf[&Type]) -> Buf[&Type]
    var out: Buf[&Type] = buf()
    for item in items
        out.push(erase_unions(item))
    out

/** `t` with every union whose members are all references replaced by `Any`, at any depth, since such
 * a union is laid out as an `Any` holding its member. A union with a scalar member has a layout of
 * its own, a tag and a payload, so it stays, its members erased the same way. */
erase_reference_unions(t: &Type) -> &Type = *t match
    Union(members) ->
        val inner = erase_reference_all(members)
        var scalar = false
        for m in inner
            if is_scalar_member(m) then scalar = true
        if scalar then union_of(inner) else AnyType
    Tuple(items) -> Tuple(erase_reference_all(items))
    Function(params, result, sendable) -> Function(erase_reference_all(params), erase_reference_unions(result), sendable)
    ByName(inner) -> ByName(erase_reference_unions(inner))
    Data(id, name, args) -> Data(id, name, erase_reference_all(args))
    Class(id, name, args) -> Class(id, name, erase_reference_all(args))
    Opaque(id, name, args, repr) -> Opaque(id, name, erase_reference_all(args), erase_reference_unions(repr))
    _ -> t

private erase_reference_all(items: Buf[&Type]) -> Buf[&Type]
    var out: Buf[&Type] = buf()
    for item in items
        out.push(erase_reference_unions(item))
    out

/** Whether a member of a union is a scalar, kept in the union's bits rather than as a reference to an
 * object: a number, a `char`, a `bool` or `unit`. */
is_scalar_member(m: &Type) -> bool = !(mir_type(m) is Some(MRef))

/** Whether `t` is a union with a scalar member, laid out as a tag and a payload. */
is_scalar_union(t: &Type) -> bool = *t match
    Union(members) ->
        for m in members
            if is_scalar_member(m) then return true
        false
    _ -> false

/** Whether a scalar member of a union is wider than the union's 64 bits, an integer of more than 64
 * bits: the union keeps it boxed, in its reference word, as a member kept as a reference is kept. */
is_boxed_member(m: &Type) -> bool = *m match
    Int(bits) -> bits > 64
    _ -> false

/** The scalar members of the union `t` kept in its bits, in the order of their keys, which is the
 * normal form's and not the order written: member `i` has tag `i + 1`, and tag 0 says the union holds
 * a reference, which an integer wider than 64 bits is boxed as. */
union_scalars(t: &Type) -> Buf[&Type]
    var out: Buf[&Type] = buf()
    var keys: Buf[string] = buf()
    for m in members_of(t)
        if !is_scalar_member(m) || is_boxed_member(m) then continue
        val k = type_key(m)
        var at = keys.len()
        while at > 0 && k < keys[at - 1]
            at -= 1
        keys.insert(at, k)
        out.insert(at, m)
    out

/** Whether the union `t` has a member kept in its reference word: a reference, or an integer wider than
 * 64 bits in its box. */
union_holds_reference(t: &Type) -> bool
    for m in members_of(t)
        if !is_scalar_member(m) || is_boxed_member(m) then return true
    false

/** Whether `t` names a union anywhere in it. */
has_union(t: &Type) -> bool = *t match
    Union(_) -> true
    Tuple(items) -> any_union(items)
    Function(params, result, _) -> any_union(params) || has_union(result)
    ByName(inner) -> has_union(inner)
    Data(_, _, args) -> any_union(args)
    Class(_, _, args) -> any_union(args)
    Opaque(_, _, args, _) -> any_union(args)
    Constructor(body, _) -> has_union(body)
    Applied(head, args) -> has_union(head) || any_union(args)
    _ -> false

private any_union(items: Buf[&Type]) -> bool
    for item in items
        if has_union(item) then return true
    false

const IntBits: u32 = 32

/** The owner of a data type's type parameters. Data types are numbered apart from functions, so
 * their owners start far above any function's symbol. */
data_owner(id: usize) -> usize = id + (1usize << 48)

/** The owner of a class's type parameters, which its constructor and methods share. A method's own
 * type parameters follow the class's, so one owner covers everything a method's types can name. */
class_owner(id: usize) -> usize = id + (1usize << 49)

/** The owner that two methods' own type parameters are renamed to when the methods are compared, so
 * the `j`th type parameter of an override and of the method it overrides are one type. */
method_params_owner() -> usize = 1usize << 50

/** The owner of `Self` in trait `id`: `TypeVar(self_owner(id), 0, "Self")` is the type implementing
 * the trait, which a call substitutes with its receiver's type. */
self_owner(id: usize) -> usize = id + (1usize << 51)

/** Whether a type parameter's owner is a trait's, so the parameter is that trait's `Self`. */
is_self_owner(owner: usize) -> bool = owner >= (1usize << 51)

/** The owner of the type parameter of an impl for every integer width, `impl[T: Integer] Display
 * for T`. Every such impl and its methods share it, so its parameter is one type wherever it is
 * named: the integer family, standing for whichever width an instance has. */
integer_owner() -> usize = 1usize << 47

/** The owner of a derive template's `T`, by the template's place among the impls: below the integer
 * family's, and apart from every other owner. */
template_owner(impl_index: usize) -> usize = impl_index + (1usize << 46)

/** The owner of a type alias's type parameters, by the alias's index in the checker's table: below
 * the derive templates'. They are named only inside the alias's body, and every use of the alias
 * replaces them with its type arguments. */
alias_owner(id: usize) -> usize = id + (1usize << 45)

/** The owner of the fresh types a pattern on a refined variant gives the variant's parameters, by
 * the pattern's place among the program's refining patterns: below the type aliases'. Each pattern
 * has its own, so two patterns on one variant, nested or one after the other, give two sets of
 * types; an arm is checked with them, and each copy of it compiled with what the value matched
 * says they are. */
pattern_owner(site: usize) -> usize = site + (1usize << 43)

/** Whether a type parameter's owner is a refining pattern's. */
is_pattern_owner(owner: usize) -> bool = owner >= (1usize << 43) && owner < (1usize << 44)

/** Whether `t` names a type of a refining pattern's. */
names_pattern_type(t: &Type) -> bool = *t match
    TypeVar(owner, _, _) -> is_pattern_owner(owner)
    Tuple(items) -> any_pattern_type(items)
    Function(params, result, _) -> any_pattern_type(params) || names_pattern_type(result)
    ByName(inner) -> names_pattern_type(inner)
    Data(_, _, args) -> any_pattern_type(args)
    Class(_, _, args) -> any_pattern_type(args)
    Union(members) -> any_pattern_type(members)
    Constructor(body, _) -> names_pattern_type(body)
    Applied(head, args) -> names_pattern_type(head) || any_pattern_type(args)
    _ -> false

private any_pattern_type(items: Buf[&Type]) -> bool
    for item in items
        if names_pattern_type(item) then return true
    false

/** Whether a type parameter's owner is a type alias's. */
is_alias_owner(owner: usize) -> bool = owner >= (1usize << 45) && owner < (1usize << 46)

/** Whether `t` names a type alias's type parameter. */
names_alias_param(t: &Type) -> bool = *t match
    TypeVar(owner, _, _) -> is_alias_owner(owner)
    Tuple(items) -> any_alias_param(items)
    Function(params, result, _) -> any_alias_param(params) || names_alias_param(result)
    ByName(inner) -> names_alias_param(inner)
    Data(_, _, args) -> any_alias_param(args)
    Class(_, _, args) -> any_alias_param(args)
    Opaque(_, _, args, _) -> any_alias_param(args)
    Union(members) -> any_alias_param(members)
    Constructor(body, _) -> names_alias_param(body)
    Applied(head, args) -> names_alias_param(head) || any_alias_param(args)
    _ -> false

/** Whether `t` names type parameter `index` of `owner`. */
names_type_var(t: &Type, owner: usize, index: usize) -> bool = *t match
    TypeVar(o, i, _) -> o == owner && i == index
    Tuple(items) -> any_names_type_var(items, owner, index)
    Function(params, result, _) -> any_names_type_var(params, owner, index) || names_type_var(result, owner, index)
    ByName(inner) -> names_type_var(inner, owner, index)
    Data(_, _, args) -> any_names_type_var(args, owner, index)
    Class(_, _, args) -> any_names_type_var(args, owner, index)
    Opaque(_, _, args, _) -> any_names_type_var(args, owner, index)
    Union(members) -> any_names_type_var(members, owner, index)
    Constructor(body, _) -> names_type_var(body, owner, index)
    Applied(head, args) -> names_type_var(head, owner, index) || any_names_type_var(args, owner, index)
    _ -> false

private any_names_type_var(items: Buf[&Type], owner: usize, index: usize) -> bool
    for item in items
        if names_type_var(item, owner, index) then return true
    false

any_alias_param(items: Buf[&Type]) -> bool
    for item in items
        if names_alias_param(item) then return true
    false

/** Whether a type parameter's owner is a derive template's. */
is_template_owner(owner: usize) -> bool = owner >= (1usize << 46) && owner < (1usize << 47)

/** The type an impl for every integer width adds to: its parameter, bounded by `Integer`. */
integer_family() -> &Type = TypeVar(integer_owner(), 0, "T")

/** Whether `t` is the integer family's type parameter. */
is_integer_family(t: &Type) -> bool = *t match
    TypeVar(owner, index, _) -> owner == integer_owner() && index == 0
    _ -> false

/** The owner of the parameters of an impl for every tuple of `arity` parts, `impl[A0: Display, A1:
 * Display] Display for (A0, A1)`: one per arity, shared by every impl for tuples of that arity, so
 * their parameters are one type, the tuple family of that arity. Above the integer family's. */
tuple_owner(arity: usize) -> usize = integer_owner() + arity

/** Whether a type parameter's owner is a tuple family's. */
is_tuple_owner(owner: usize) -> bool = owner > integer_owner() && owner < data_owner(0)

/** The type an impl for every tuple of `arity` parts adds to: a tuple of its parameters, `(A0, A1)`. */
tuple_family(arity: usize) -> &Type
    var parts: Buf[&Type] = buf()
    for i in 0..<arity
        parts.push(TypeVar(tuple_owner(arity), i, s"A$i"))
    Tuple(parts)

/** Whether `t` is a tuple family: a tuple whose parts are its family's parameters, in order. */
is_tuple_family(t: &Type) -> bool
    val parts = *t match
        Tuple(parts) -> parts
        _ -> return false
    for i in 0..<parts.len()
        val own = *parts[i] match
            TypeVar(owner, index, _) -> owner == tuple_owner(parts.len()) && index == i
            _ -> false
        if !own then return false
    true

/** Whether a conformance or method stated for built-in type `stated` is one type `t` has: `t` is that
 * type, an integer of any width where it was stated for the integer family, or a tuple of as many
 * parts where it was stated for a tuple family. Whether `t`'s parts meet the family impl's bounds is
 * the caller's to ask. */
builtin_covers(stated: &Type, t: &Type) -> bool =
    same_type(stated, t) || (is_integer_family(stated) && *t is Int(_)) || covers_tuple(stated, t) || covers_opaque(stated, t)

// An impl of a generic opaque type is stated at its own parameters, in order, and so holds at every
// instance of the type.
private covers_opaque(stated: &Type, t: &Type) -> bool = *stated match
    Opaque(x, _, params, _) -> *t match
        Opaque(y, _, _, _) ->
            if x != y || params.len() == 0 then return false
            for p in params
                if !(*p is TypeVar(_, _, _)) then return false
            true
        _ -> false
    _ -> false

private covers_tuple(stated: &Type, t: &Type) -> bool
    if !is_tuple_family(stated) then return false
    val own = *stated match
        Tuple(own) -> own.len()
        _ -> return false
    *t match
        Tuple(parts) -> parts.len() == own
        _ -> false

int_type() -> &Type = Int(IntBits)

same_type(a: &Type, b: &Type) -> bool = *a match
    ErrorType -> *b is ErrorType
    Nothing -> *b is Nothing
    AnyType -> *b is AnyType
    Unit -> *b is Unit
    Bool -> *b is Bool
    Char -> *b is Char
    Real -> *b is Real
    Str -> *b is Str
    Byte -> *b is Byte
    Int(x) -> *b match
        Int(y) -> x == y
        _ -> false
    Tuple(xs) -> *b match
        Tuple(ys) -> same_types(xs, ys)
        _ -> false
    Function(xs, r, m) -> *b match
        Function(ys, s, n) -> m == n && same_types(xs, ys) && same_type(r, s)
        _ -> false
    ByName(x) -> *b match
        ByName(y) -> same_type(x, y)
        _ -> false
    Data(x, _, xs) -> *b match
        Data(y, _, ys) -> x == y && same_types(xs, ys)
        _ -> false
    Class(x, _, xs) -> *b match
        Class(y, _, ys) -> x == y && same_types(xs, ys)
        _ -> false
    Opaque(x, _, xs, _) -> *b match
        Opaque(y, _, ys, _) -> x == y && same_types(xs, ys)
        _ -> false
    TypeVar(owner, index, _) -> *b match
        TypeVar(o, i, _) -> owner == o && index == i
        _ -> false
    Var(id) -> *b match
        Var(other) -> id == other
        _ -> false
    Union(xs) -> *b match
        Union(ys) -> same_members(xs, ys)
        _ -> false
    Constructor(x, n) -> *b match
        Constructor(y, m) -> n == m && same_type(x, y)
        _ -> false
    Applied(h, xs) -> *b match
        Applied(g, ys) -> same_type(h, g) && same_types(xs, ys)
        _ -> false

/** Whether two unions have the same members, in whatever order. */
private same_members(xs: Buf[&Type], ys: Buf[&Type]) -> bool
    if xs.len() != ys.len() then return false
    for x in xs
        var found = false
        for y in ys
            if same_type(x, y) then found = true
        if !found then return false
    true

private same_types(xs: Buf[&Type], ys: Buf[&Type]) -> bool
    if xs.len() != ys.len() then return false
    for i in 0..<xs.len()
        if !same_type(xs[i], ys[i]) then return false
    true

/** Whether a value of type `from` may be used where `to` is expected: a `@sendable` function type
 * is one of the plain function type with the same parameters and result. */
conforms(from: &Type, to: &Type) -> bool = *from is Nothing || alike(from, to) || forgets_sendable(from, to)

/** Whether `from` is a `@sendable` function type and `to` the plain one it is a subtype of. */
forgets_sendable(from: &Type, to: &Type) -> bool = *from match
    Function(xs, r, true) -> *to match
        Function(ys, s, false) -> all_alike(xs, ys) && alike(r, s)
        _ -> false
    _ -> false

/** Whether `t` is a `@sendable` function type. */
is_sendable_function(t: &Type) -> bool = *t is Function(_, _, true)

/** `t` as a `@sendable` function type, where it is a function type. */
as_sendable(t: &Type) -> &Type = *t match
    Function(ps, r, _) -> Function(ps, r, true)
    _ -> t

/** Whether two types are the same, where a type that already failed to check matches anything,
 * even inside another type, so one error is reported once. */
private alike(a: &Type, b: &Type) -> bool
    if *a is ErrorType || *b is ErrorType then return true
    *a match
        Tuple(xs) -> *b match
            Tuple(ys) -> all_alike(xs, ys)
            _ -> false
        Function(xs, r, m) -> *b match
            Function(ys, s, n) -> m == n && all_alike(xs, ys) && alike(r, s)
            _ -> false
        ByName(x) -> *b match
            ByName(y) -> alike(x, y)
            _ -> false
        Data(x, _, xs) -> *b match
            Data(y, _, ys) -> x == y && all_alike(xs, ys)
            _ -> false
        Class(x, _, xs) -> *b match
            Class(y, _, ys) -> x == y && all_alike(xs, ys)
            _ -> false
        Opaque(x, _, xs, _) -> *b match
            Opaque(y, _, ys, _) -> x == y && all_alike(xs, ys)
            _ -> false
        Union(xs) -> *b match
            Union(ys) -> members_alike(xs, ys)
            _ -> false
        Constructor(x, n) -> *b match
            Constructor(y, m) -> n == m && alike(x, y)
            _ -> false
        Applied(h, xs) -> *b match
            Applied(g, ys) -> alike(h, g) && all_alike(xs, ys)
            _ -> false
        _ -> same_type(a, b)

private members_alike(xs: Buf[&Type], ys: Buf[&Type]) -> bool
    if xs.len() != ys.len() then return false
    for x in xs
        var found = false
        for y in ys
            if alike(x, y) then found = true
        if !found then return false
    true

private all_alike(xs: Buf[&Type], ys: Buf[&Type]) -> bool
    if xs.len() != ys.len() then return false
    for i in 0..<xs.len()
        if !alike(xs[i], ys[i]) then return false
    true

/** The type as a program spells it, for diagnostics. */
type_name(t: &Type) -> string = *t match
    ErrorType -> "<error>"
    Nothing -> "Nothing"
    AnyType -> "Any"
    Unit -> "unit"
    Bool -> "bool"
    Char -> "char"
    Real -> "real"
    Str -> "string"
    Byte -> "byte"
    Int(bits) -> if bits == IntBits then "int" elif bits == 64 then "long" else s"i$bits"
    Tuple(items) -> "(" + type_list(items) + ")"
    Function(params, result, sendable) -> (if sendable then "@sendable (" else "(") + type_list(params) + ") -> " + type_name(result)
    ByName(inner) -> "-> " + type_name(inner)
    Data(_, name, args) -> if args.len() == 0 then name else name + "[" + type_list(args) + "]"
    Class(_, name, args) -> if args.len() == 0 then name else name + "[" + type_list(args) + "]"
    Opaque(_, name, args, _) -> if args.len() == 0 then name else name + "[" + type_list(args) + "]"
    TypeVar(_, _, name) -> name
    Var(_) -> "_"
    Union(members) -> union_name(members)
    Constructor(body, arity) -> if leaves_all_open(body, arity) then constructor_head_name(body) else type_name(body)
    Applied(head, args) -> type_name(head) + "[" + type_list(args) + "]"

/** Whether a constructor's body leaves every argument open, in order, so the constructor is written
 * as its type's bare name: `Option`, not `Option[_]`. */
private leaves_all_open(body: &Type, arity: usize) -> bool
    var args: Buf[&Type] = buf()
    *body match
        Data(_, _, xs) -> args = xs
        Class(_, _, xs) -> args = xs
        Applied(_, xs) -> args = xs
        _ -> return false
    if args.len() != arity then return false
    for i in 0..<args.len()
        if !same_type(args[i], hole(i)) then return false
    true

private constructor_head_name(body: &Type) -> string = *body match
    Data(_, name, _) -> name
    Class(_, name, _) -> name
    Applied(head, _) -> type_name(head)
    _ -> type_name(body)

// A union's members in the order written, a function type among them in parentheses.
private union_name(members: Buf[&Type]) -> string
    var out = ""
    for i in 0..<members.len()
        if i > 0 then out = out + " | "
        val name = type_name(members[i])
        out = out + (if *members[i] is Function(_, _, _) then s"($name)" else name)
    out

private type_list(items: Buf[&Type]) -> string
    var out = ""
    for i in 0..<items.len()
        if i > 0 then out = out + ", "
        out = out + type_name(items[i])
    out

/** A spelling of a type that tells apart any two different types, and spells one type one way, for
 * keying a table by type: a data type or class is named by its index alone, since an object and its
 * companion class share a name, and so may types of different files, while one type may be written
 * under several names (`ActorContext` and the core library's `avin::actors.ActorContext`). */
type_key(t: &Type) -> string = *t match
    Tuple(items) -> "(" + key_list(items) + ")"
    Function(params, result, sendable) -> (if sendable then "@sendable (" else "(") + key_list(params) + ") -> " + type_key(result)
    ByName(inner) -> "-> " + type_key(inner)
    Data(id, _, args) -> s"#$id[" + key_list(args) + "]"
    Class(id, _, args) -> s"class #$id[" + key_list(args) + "]"
    Opaque(id, _, args, _) -> s"opaque #$id[" + key_list(args) + "]"
    // The members' keys in sorted order, so a union is one key whatever order it was written in.
    Union(members) ->
        var keys: Buf[string] = buf()
        for m in members
            val k = type_key(m)
            var at = keys.len()
            while at > 0 && k < keys[at - 1]
                at -= 1
            keys.insert(at, k)
        var out = "union("
        for i in 0..<keys.len()
            if i > 0 then out = out + " | "
            out = out + keys[i]
        out + ")"
    // A constructor by its body, its holes spelled `_`: `#4[_, #9[]]` for `Result[_, ParseError]`,
    // which `Parsed` is too, so the two are one instance.
    Constructor(body, _) -> type_key(body)
    Applied(head, args) -> type_key(head) + "[" + key_list(args) + "]"
    _ -> type_name(t)

private key_list(items: Buf[&Type]) -> string
    var out = ""
    for i in 0..<items.len()
        if i > 0 then out = out + ", "
        out = out + type_key(items[i])
    out

/** Whether `t` is a built-in value type, which an impl may make conform to traits: an integer,
 * `byte`, `char`, `real`, `bool`, `unit` or `string`. */
is_builtin(t: &Type) -> bool = *t match
    Unit -> true
    Bool -> true
    Char -> true
    Real -> true
    Str -> true
    Byte -> true
    Int(_) -> true
    _ -> false

/** Whether `t` is a built-in value type or an opaque type: a type whose conformances and methods
 * impls state apart from any declaration of its layout, and whose values are put in a box where they
 * become an `Any` or a trait's value. */
is_builtin_or_opaque(t: &Type) -> bool = is_builtin(t) || *t is Opaque(_, _, _, _)

/** The built-in type a name denotes: `Any`, `int`, `long`, `bool`, `byte`, `iN` and the rest. */
builtin_type(name: string) -> Option[&Type]
    if name == "Any" then return Some(AnyType)
    if name == "int" then return Some(int_type())
    if name == "long" then return Some(Int(64))
    if name == "bool" then return Some(Bool)
    if name == "string" then return Some(Str)
    if name == "unit" then return Some(Unit)
    if name == "char" then return Some(Char)
    if name == "real" then return Some(Real)
    if name == "byte" then return Some(Byte)
    if name.bytes.len < 2 || name.bytes[0] != u8('i') then return None
    var bits = 0u32
    for i in 1..<name.bytes.len
        val b = name.bytes[i]
        if b < u8('0') || b > u8('9') then return None
        if i == 1 && b == u8('0') then return None
        bits = bits * 10 + u32(b - u8('0'))
        if bits > 8388608 then return None
    Some(Int(bits))

/** Whether `t` still names an unknown the checker has not solved. */
has_unknowns(t: &Type) -> bool = *t match
    Var(_) -> true
    Tuple(items) -> any_unknowns(items)
    Function(params, result, _) -> any_unknowns(params) || has_unknowns(result)
    ByName(inner) -> has_unknowns(inner)
    Data(_, _, args) -> any_unknowns(args)
    Class(_, _, args) -> any_unknowns(args)
    Opaque(_, _, args, _) -> any_unknowns(args)
    Union(members) -> any_unknowns(members)
    Constructor(body, _) -> has_unknowns(body)
    Applied(head, args) -> has_unknowns(head) || any_unknowns(args)
    _ -> false

private any_unknowns(items: Buf[&Type]) -> bool
    for item in items
        if has_unknowns(item) then return true
    false

/** `t` with the type parameters of function `owner` replaced by `args`. */
substitute(t: &Type, owner: usize, args: Buf[&Type]) -> &Type = *t match
    TypeVar(o, index, _) -> if o == owner && index < args.len() then args[index] else t
    Tuple(items) -> Tuple(substitute_all(items, owner, args))
    Function(params, result, sendable) -> Function(substitute_all(params, owner, args), substitute(result, owner, args), sendable)
    ByName(inner) -> ByName(substitute(inner, owner, args))
    Data(id, name, items) -> Data(id, name, substitute_all(items, owner, args))
    Class(id, name, items) -> Class(id, name, substitute_all(items, owner, args))
    Opaque(id, name, items, repr) -> Opaque(id, name, substitute_all(items, owner, args), substitute(repr, owner, args))
    Union(members) -> union_of(substitute_all(members, owner, args))
    // A constructor's holes are its own, so filling an outer constructor's leaves them alone.
    Constructor(body, arity) -> if owner == hole_owner() then t else Constructor(substitute(body, owner, args), arity)
    Applied(head, items) -> apply_constructor(substitute(head, owner, args), substitute_all(items, owner, args))
    _ -> t

substitute_all(items: Buf[&Type], owner: usize, args: Buf[&Type]) -> Buf[&Type]
    var out: Buf[&Type] = buf()
    for item in items
        out.push(substitute(item, owner, args))
    out

/** `t` with every solved inference variable replaced by its solution in `vars`. */
solve(vars: Buf[Option[&Type]], t: &Type) -> &Type = *t match
    Var(id) -> vars[id] match
        Some(bound) -> solve(vars, bound)
        None -> t
    Tuple(items) -> Tuple(solve_all(vars, items))
    Function(params, result, sendable) -> Function(solve_all(vars, params), solve(vars, result), sendable)
    ByName(inner) -> ByName(solve(vars, inner))
    Data(id, name, args) -> Data(id, name, solve_all(vars, args))
    Class(id, name, args) -> Class(id, name, solve_all(vars, args))
    Opaque(id, name, args, repr) -> Opaque(id, name, solve_all(vars, args), solve(vars, repr))
    Union(members) -> union_of(solve_all(vars, members))
    Constructor(body, arity) -> Constructor(solve(vars, body), arity)
    Applied(head, args) -> apply_constructor(solve(vars, head), solve_all(vars, args))
    _ -> t

private solve_all(vars: Buf[Option[&Type]], items: Buf[&Type]) -> Buf[&Type]
    var out: Buf[&Type] = buf()
    for item in items
        out.push(solve(vars, item))
    out
