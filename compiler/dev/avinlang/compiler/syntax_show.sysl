module dev.avinlang.compiler

import sysl.buf.{Buf, buf}

// A compact, fully parenthesized rendering of syntax trees, for tests and for looking at what the
// parser built: `1 + 2 * 3` shows as `(+ 1 (* 2 3))`.

unary_spelling(op: UnaryOp) -> string = op match
    Negate -> "-"
    Plus -> "+"
    Not -> "!"
    Complement -> "~"

binary_spelling(op: BinaryOp) -> string = op match
    Add -> "+"
    Subtract -> "-"
    Multiply -> "*"
    Divide -> "/"
    Remainder -> "%"
    ShiftLeft -> "<<"
    ShiftRight -> ">>"
    AddWrapping -> "+%"
    SubtractWrapping -> "-%"
    MultiplyWrapping -> "*%"
    AddSaturating -> "+|"
    SubtractSaturating -> "-|"
    MultiplySaturating -> "*|"
    BitAnd -> "&"
    BitOr -> "|"
    BitXor -> "^"
    And -> "&&"
    Or -> "||"

compare_spelling(op: CompareOp) -> string = op match
    Equal -> "=="
    NotEqual -> "!="
    Same -> "==="
    NotSame -> "!=="
    Less -> "<"
    LessEqual -> "<="
    Greater -> ">"
    GreaterEqual -> ">="

private joined(items: Buf[&Expr]) -> string
    var out = ""
    for i in 0..<items.len()
        if i > 0 then out = out + " "
        out = out + show_expr(items[i])
    out

private optional(e: Option[&Expr]) -> string = e match
    Some(v) -> " " + show_expr(v)
    None -> ""

show_expr(e: &Expr) -> string = e.kind match
    Invalid -> "<invalid>"
    UnitLit -> "()"
    IntLit(spelling) -> spelling
    RealLit(value) -> value.to_string()
    CharLit(value) -> f"$value%?"
    StringLit(value) -> f"$value%?"
    Interpolate(prefix, chunks, holes) ->
        var out = "(" + prefix + "\"\""
        for i in 0..<chunks.len()
            out = out + " " + f"${chunks[i]}%?"
            if i < holes.len() then out = out + " " + show_expr(holes[i])
        out + ")"
    BoolLit(value) -> if value then "true" else "false"
    Name(name) -> name
    Tuple(items) -> "(tuple " + joined(items) + ")"
    ListLit(items) -> "[" + joined(items) + "]"
    SetLit(items) -> "{" + joined(items) + "}"
    MapLit(keys, values) ->
        var out = "{"
        for i in 0..<keys.len()
            if i > 0 then out = out + " "
            out = out + show_expr(keys[i]) + ": " + show_expr(values[i])
        out + "}"
    Block(items, discard) -> (if discard then "(block! " else "(block ") + joined(items) + ")"
    Binding(name, declared, value, mutable) ->
        val ty = declared match
            Some(t) -> ": " + show_type(t)
            None -> ""
        (if mutable then "(var " else "(val ") + name + ty + " " + show_expr(value) + ")"
    Destructure(pattern, declared, value, mutable) ->
        val ty = declared match
            Some(t) -> ": " + show_type(t)
            None -> ""
        (if mutable then "(var " else "(val ") + show_pattern(pattern) + ty + " " + show_expr(value) + ")"
    MultiAssign(targets, op, value, _) ->
        var out = "(" + (op match
            Some(o) -> binary_spelling(o)
            None -> "") + "= ("
        for i in 0..<targets.len()
            if i > 0 then out = out + " "
            out = out + show_expr(targets[i])
        out + ") " + show_expr(value) + ")"
    LocalFunction(f) -> show_function(f)
    Lambda(params, body) ->
        var out = "(fn ("
        for i in 0..<params.len()
            if i > 0 then out = out + " "
            val p = params[i]
            out = out + p.name
            if p.declared is Some(t) then out = out + ": " + show_type(t)
        out + ") " + show_expr(body) + ")"
    Assign(target, op, value, yields, _) ->
        val spelling = (op match
            Some(o) -> binary_spelling(o)
            None -> "") + (if yields then ":=" else "=")
        "(" + spelling + " " + show_expr(target) + " " + show_expr(value) + ")"
    Update(target, increment, postfix, _) ->
        val op = if increment then "++" else "--"
        "(" + (if postfix then "post" else "pre") + op + " " + show_expr(target) + ")"
    If(condition, yes, no) -> "(if " + show_expr(condition) + " " + show_expr(yes) + optional(no) + ")"
    Loop(body) -> "(loop " + show_expr(body) + ")"
    While(condition, body, otherwise) -> "(while " + show_expr(condition) + " " + show_expr(body) + optional(otherwise) + ")"
    DoWhile(body, condition, otherwise) -> "(do " + show_expr(body) + " " + show_expr(condition) + optional(otherwise) + ")"
    Break(value) -> "(break" + optional(value) + ")"
    Continue -> "(continue)"
    Return(value) -> "(return" + optional(value) + ")"
    Match(subject, arms) ->
        var out = "(match " + show_expr(subject)
        for arm in arms
            out = out + " (" + show_pattern(arm.pattern)
            if arm.guard is Some(g) then out = out + " if " + show_expr(g)
            out = out + " -> " + show_expr(arm.body) + ")"
        out + ")"
    Unary(op, operand) -> "(" + unary_spelling(op) + " " + show_expr(operand) + ")"
    Binary(op, left, right, _) -> "(" + binary_spelling(op) + " " + show_expr(left) + " " + show_expr(right) + ")"
    Compare(operands, ops) ->
        var out = "(" + show_expr(operands[0])
        for i in 0..<ops.len()
            out = out + " " + compare_spelling(ops[i]) + " " + show_expr(operands[i + 1])
        out + ")"
    Range(lower, upper, inclusive) -> "(" + (if inclusive then ".." else "..<") + " " + show_expr(lower) + " " + show_expr(upper) + ")"
    Is(value, pattern, negated) -> "(" + (if negated then "is-not " else "is ") + show_expr(value) + " " + show_pattern(pattern) + ")"
    Propagate(value) -> "(? " + show_expr(value) + ")"
    Call(callee, args) ->
        var out = "(call " + show_expr(callee)
        for a in args
            out = out + " "
            if a.name is Some(n) then out = out + n + "="
            out = out + show_expr(a.value)
        out + ")"
    Member(target, name) -> "(. " + show_expr(target) + " " + name + ")"
    InfixCall(target, name, _, arg) -> "(call (. " + show_expr(target) + " " + name + ") " + show_expr(arg) + ")"
    TupleIndex(target, index) -> s"(.$index " + show_expr(target) + ")"
    TypeApply(target, args) ->
        var out = "(apply " + show_expr(target)
        for a in args
            out = out + " " + show_type(a)
        out + ")"
end show_expr

show_type(t: &TypeExpr) -> string = t.kind match
    InvalidType -> "<invalid>"
    Named(path, args) ->
        if args.len() == 0 then return path
        var out = path + "["
        for i in 0..<args.len()
            if i > 0 then out = out + ", "
            out = out + show_type(args[i])
        out + "]"
    Tuple(items) ->
        var out = "("
        for i in 0..<items.len()
            if i > 0 then out = out + ", "
            out = out + show_type(items[i])
        out + ")"
    Function(params, result) ->
        var out = "("
        for i in 0..<params.len()
            if i > 0 then out = out + ", "
            if params[i].by_name then out = out + "-> "
            out = out + show_type(params[i].ty)
        out + ") -> " + show_type(result)

show_pattern(p: &Pattern) -> string = p.kind match
    InvalidPattern -> "<invalid>"
    Wildcard -> "_"
    Name(name) -> name
    Literal(value) -> show_expr(value)
    Constructor(path, args) ->
        var out = path + "("
        for i in 0..<args.len()
            if i > 0 then out = out + ", "
            out = out + show_pattern(args[i])
        out + ")"
    Tuple(items) ->
        var out = "(tuple"
        for item in items
            out = out + " " + show_pattern(item)
        out + ")"
    Alternatives(options) ->
        var out = "(|"
        for option in options
            out = out + " " + show_pattern(option)
        out + ")"
    Named(name, pattern) -> name + " @ " + show_pattern(pattern)
    Range(lower, upper, inclusive) -> "(" + (if inclusive then ".." else "..<") + " " + show_expr(lower) + " " + show_expr(upper) + ")"
    Successor(binder, amount) -> "(+ " + show_pattern(binder) + " " + show_expr(amount) + ")"
    Typed(binder, ty) -> "(: " + show_pattern(binder) + " " + show_type(ty) + ")"
    Bounded(binder, lower, upper) ->
        var out = "("
        if lower is Some(b) then out = out + show_expr(b.value) + (if b.inclusive then " <= " else " < ")
        out = out + show_pattern(binder)
        if upper is Some(b) then out = out + (if b.inclusive then " <= " else " < ") + show_expr(b.value)
        out + ")"

show_function(f: &Function) -> string
    var out = "(def "
    for a in f.annotations
        out = out + "@" + a.name + " "
    out = out + f.name
    out = out + show_type_params(f.type_params) + "(" + show_params(f.params) + ")"
    if f.result is Some(r) then out = out + " -> " + show_type(r)
    if f.body is Some(b) then out = out + " " + show_expr(b)
    for clause in f.clauses
        out = out + " (clause ("
        for i in 0..<clause.patterns.len()
            if i > 0 then out = out + ", "
            out = out + show_pattern(clause.patterns[i])
        out = out + ")"
        for b in clause.bodies
            out = out + (b.guard match
                Some(g) -> " (| " + show_expr(g) + " " + show_expr(b.body) + ")"
                None -> " " + show_expr(b.body))
        out = out + ")"
    out + ")"

private show_type_params(params: Buf[TypeParam]) -> string
    if params.len() == 0 then return ""
    var out = "["
    for i in 0..<params.len()
        if i > 0 then out = out + ", "
        val tp = params[i]
        out = out + (tp.variance match
            Invariant -> ""
            Covariant -> "+"
            Contravariant -> "-") + tp.name
        for j in 0..<tp.bounds.len()
            out = out + (if j == 0 then ": " else " + ") + show_type(tp.bounds[j])
    out + "]"

private show_params(params: Buf[Param]) -> string
    var out = ""
    for i in 0..<params.len()
        if i > 0 then out = out + ", "
        val p = params[i]
        out = out + show_pattern(p.pattern) + ": " + (if p.by_name then "-> " else "") + show_type(p.ty) + (if p.variadic then "*" else "")
        if p.default is Some(d) then out = out + " = " + show_expr(d)
    out

show_class(d: &ClassDecl) -> string
    if d.object then return show_members("(object " + d.name, d)
    if d.modifier == "trait" then return show_members("(trait " + d.name + show_type_params(d.type_params), d)
    var out = "(" + (if d.modifier == "" then "" else d.modifier + " ") + "class " + d.name + show_type_params(d.type_params) + "("
    for i in 0..<d.params.len()
        if i > 0 then out = out + ", "
        val cp = d.params[i]
        if cp.mutable && !cp.public then out = out + "private "
        if cp.mutable then out = out + "var "
        elif cp.public then out = out + "val "
        var single: Buf[Param] = buf()
        single.push(cp.param)
        out = out + show_params(single)
    show_members(out + ")", d)

// What follows a class's or an object's header: its parents, derivations and members.
private show_members(header: string, d: &ClassDecl) -> string
    var out = header
    for i in 0..<d.parents.len()
        out = out + (if i == 0 then " : " else ", ") + show_expr(d.parents[i])
    for i in 0..<d.derives.len()
        out = out + (if i == 0 then " derives " else ", ") + show_type(d.derives[i])
    out + show_member_list(d.members) + ")"

show_impl(d: &ImplDecl) -> string
    var out = "(impl" + show_type_params(d.type_params) + " "
    if d.trait_name is Some(t) then out = out + show_type(t) + " for "
    out + show_type(d.target) + show_member_list(d.members) + ")"

private show_member_list(members: Buf[ClassMember]) -> string
    var out = ""
    for m in members
        out = out + " " + (m match
            FieldMember(f) ->
                var field = "(" + (if f.public then "" else "private ") + (if f.mutable then "var " else "val ") + f.name
                if f.declared is Some(t) then field = field + ": " + show_type(t)
                field + " " + show_expr(f.value) + ")"
            MethodMember(method, public, overrides) -> (if public then "" else "private ") + (if overrides then "override " else "") + show_function(method)
            StatementMember(s) -> show_expr(s))
    out

show_data(d: &DataDecl) -> string
    var out = "(data " + d.name + show_type_params(d.type_params)
    for v in d.variants
        out = out + " " + v.name
        if v.fields.len() > 0 then out = out + "(" + show_params(v.fields) + ")"
    for i in 0..<d.derives.len()
        out = out + (if i == 0 then " derives " else ", ") + show_type(d.derives[i])
    out + ")"
