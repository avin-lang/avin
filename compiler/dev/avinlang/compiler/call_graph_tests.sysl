module dev.avinlang.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}

// The call graph's components: which calls may close a cycle, and which components a call through a
// function value may come back to.

private lowered(text: string) -> MirProgram = lower_source(repository_toolchain(), source_of("probe.avin", text)) match
    Ok(p) -> p
    Err(d) -> panic(d)

private index_of(program: MirProgram, name: string) -> usize
    for i in 0..<program.functions.len()
        if program.functions[i].symbol == "<program>." + name then return i
    panic("no function " + name)

/** The graph as the definition reads: an edge from every function that calls through a function value
 * to every function whose address is taken. */
private product_graph(program: MirProgram) -> CallGraph
    val n = program.functions.len()
    var taken: Buf[bool] = buf()
    for _ in 0..<n do taken.push(false)
    for k in program.closures do taken[k.function] = true
    for d in program.descriptors
        for m in d.methods
            if m is Some(g) then taken[g] = true
        if d.call is Some(g) then taken[g] = true
    for f in program.functions
        for block in f.blocks
            for inst in block.insts
                for o in inst_operands(inst) do mark_taken(&taken, o)
            if block.term is Return(Some(o)) then mark_taken(&taken, o)
            if block.term is Branch(o, _, _) then mark_taken(&taken, o)
    var starts: Buf[usize] = buf()
    var edges: Buf[usize] = buf()
    for f in program.functions
        starts.push(edges.len())
        var indirect = false
        for block in f.blocks
            for inst in block.insts
                inst match
                    Call(_, Direct(g), _) -> edges.push(g)
                    Call(_, Indirect(_, _), _) -> indirect = true
                    _ -> ()
        if indirect
            for g in 0..<n
                if taken[g] then edges.push(g)
    starts.push(edges.len())
    val component = components(n, starts, edges)
    var reentered: Buf[bool] = buf()
    for _ in 0..<n do reentered.push(false)
    for g in 0..<n
        if taken[g] then reentered[component[g]] = true
    CallGraph(component, reentered)

private mark_taken(taken: *Buf[bool], o: Operand)
    if o is FunctionAddress(g) then (*taken)[g] = true

/** Asserts that `call_graph` groups the program's functions exactly as the product graph does, and
 * that each function's component is reentered in one exactly when it is in the other. */
private assert_same_as_product(text: string)
    val program = lowered(text)
    val graph = call_graph(program)
    val product = product_graph(program)
    var forward: Map[usize, usize] = map()
    var backward: Map[usize, usize] = map()
    for f in 0..<program.functions.len()
        val a = product.component[f]
        val b = graph.component[f]
        forward.get(a) match
            Some(seen) -> assert_eq(seen, b)
            None -> forward.put(a, b)
        backward.get(b) match
            Some(seen) -> assert_eq(seen, a)
            None -> backward.put(b, a)
        assert_eq(graph.reentered[b], product.reentered[a])

private const Apply: string = "apply(f: (int) -> int, x: int) -> int = f(x)\n\n"

@test("a recursion through a lambda puts the caller of the function value in a reentered component with the function it reaches")
recursion_through_a_lambda()
    val text = Apply + "down(n: int) -> int = if n == 0 then 0 else apply(x -> down(x), n - 1)\n\nmain()\n    println(down(3))\n"
    val program = lowered(text)
    val graph = call_graph(program)
    val apply = index_of(program, "apply")
    val down = index_of(program, "down")
    assert_eq(graph.component[apply], graph.component[down])
    assert(graph.reentered[graph.component[apply]])
    assert_same_as_product(text)

@test("a call through a function value that reaches nothing calling back is in a component no function value reenters")
indirect_call_with_no_way_back()
    val text = Apply + "main()\n    println(apply(x -> x + 1, 3))\n"
    val program = lowered(text)
    val graph = call_graph(program)
    val apply = index_of(program, "apply")
    val main = index_of(program, "main")
    assert(!graph.reentered[graph.component[apply]])
    assert(graph.component[apply] != graph.component[main])
    assert_same_as_product(text)

@test("direct mutual recursion shares a component, a function calling neither does not, and with no function value nothing is reentered")
direct_recursion_only()
    val text = "even(n: int) -> bool = if n == 0 then true else odd(n - 1)\n\nodd(n: int) -> bool = if n == 0 then false else even(n - 1)\n\nmain()\n    println(even(10))\n"
    val program = lowered(text)
    val graph = call_graph(program)
    assert_eq(graph.component[index_of(program, "even")], graph.component[index_of(program, "odd")])
    assert(graph.component[index_of(program, "main")] != graph.component[index_of(program, "even")])
    assert(!graph.reentered[graph.component[index_of(program, "even")]])
    assert_same_as_product(text)

@test("closures returned, captured and passed through several callers group as the product graph groups them")
closures_group_as_the_product()
    assert_same_as_product(Apply + "divider(n: int) -> (int) -> int = x -> x / n\n\ntwice(f: (int) -> int, x: int) -> int = apply(f, apply(f, x))\n\nspin(n: int) -> int = if n <= 0 then 0 else twice(x -> spin(x - 1), n)\n\nmain()\n    println(twice(divider(2), 40))\n    println(spin(5))\n")
    assert_same_as_product(Apply + "main()\n    println(apply(x -> x * 2, 4))\n")
    assert_same_as_product("main()\n    println(1)\n")
