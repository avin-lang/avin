module dev.avinlang.compiler

import sysl.buf.{Buf, buf}
import sysl.text.{StrBuilder, str_builder}

// Spells a MIR program as LLVM IR. Every decision about types, layout and control flow has already
// been made; this file only writes it down.
//
// Every function of the program, every closure entry and every runtime entry point takes the running
// thread's context as a hidden first argument, `%ctx`. Its first word is the top of that thread's
// shadow stack, which a function links its frame of roots into directly, without calling the runtime.

/** The program's LLVM module. Its `main` hands the runtime the program's arguments and gets the main
 * thread's context from it, runs the
 * program's entry function and returns its result as the exit status, or zero for an entry function
 * that returns nothing. */
emit_llvm(program: MirProgram) -> string
    var out = str_builder()
    out.push("; Avin program\n\n")
    // Every descriptor begins with the collector's kind, whose tracer is the runtime's.
    out.push("declare void @avin_rt_trace(ptr, ptr)\n")
    out.push("declare void @avin_rt_trace_array(ptr, ptr)\n")
    out.push("declare void @avin_rt_trace_array_map(ptr, ptr)\n")
    // A Sysl handle's kind names its finalizer, which the program's shims define.
    for h in program.handles
        out.push(s"declare void @${h.finalizer}(ptr, ptr)\n")
    // A C handle's kind names its finalizer, which the program's C unit defines.
    for h in program.c_handles
        out.push(s"declare void @${h.finalizer}(ptr, ptr)\n")
    out.push("\n")
    // A string literal is a constant object laid out as the runtime lays out a string: a header
    // naming the program's descriptor for strings, the length in bytes, then the bytes.
    val strings = program.string_descriptor
    for i in 0..<program.strings.len()
        val text = program.strings[i]
        val n = text.bytes.len
        out.push(s"@avin.str.$i.const = private constant { ptr, i64, i64, [$n x i8] } { ptr @avin.desc.$strings, i64 0, i64 $n, [$n x i8] c\"")
        push_bytes(&out, text)
        out.push("\" }, align 16\n")
        constant_payload(&out, s"@avin.str.$i")
    out.push("\n")
    for i in 0..<program.descriptors.len()
        emit_descriptor(&out, program, i)
    // A type record is the number of the type's ancestors, its equality and rendering entries,
    // whether handing a value over stops at its objects, and its ancestors' records' addresses.
    for i in 0..<program.records.len()
        val r = program.records[i]
        val n = r.ancestors.len()
        val apart = if r.apart then 1 else 0
        out.push(s"; type ${r.name}\n@avin.type.$i = private constant { i64, ptr, ptr, ptr, ptr, i64, [$n x ptr] } { i64 $n, ")
        out.push(entry_address(program, r.equals) + ", " + entry_address(program, r.hash) + ", ")
        out.push(entry_address(program, r.display) + ", " + entry_address(program, r.debug) + s", i64 $apart, [$n x ptr] ")
        if n == 0 then out.push("zeroinitializer")
        else
            out.push("[")
            for j in 0..<n
                if j > 0 then out.push(", ")
                out.push(s"ptr @avin.type.${r.ancestors[j]}")
            out.push("]")
        out.push(" }, align 8\n")
    // A closure that captures nothing is constant: only a header naming its descriptor, whose `call`
    // is its entry.
    for i in 0..<program.closures.len()
        val k = program.closures[i]
        out.push(s"@avin.fn.$i.const = private constant { ptr, i64 } { ptr @avin.desc.${k.descriptor}, i64 0 }, align 16\n")
        constant_payload(&out, s"@avin.fn.$i")
    for i in 0..<program.constants.len()
        emit_constant(&out, program, i)
    // A trap site is what the runtime reports when the program stops there: the reason and the file
    // as constant strings, then the line and column.
    for i in 0..<program.traps.len()
        val t = program.traps[i]
        out.push(s"@avin.trap.$i = private constant { ptr, ptr, i64, i64 } { ptr @avin.str.${t.reason}, ptr @avin.str.${t.file}, i64 ${t.line}, i64 ${t.col} }, align 8\n")
    // The module-level values that hold references are the slots of one frame, laid out as a
    // function's shadow-stack frame is, which `main` gives the runtime as a root of every
    // collection. Each other value is a global of its own. All start zero, before `main` initializes
    // them.
    val roots = root_count(program)
    if roots > 0
        out.push(s"@avin.roots = private global { ptr, i64, [$roots x ptr] } { ptr null, i64 $roots, [$roots x ptr] zeroinitializer }, align 8\n")
    for i in 0..<program.globals.len()
        program.globals[i] match
            Some(MRef) -> ()
            Some(t) -> out.push(s"@avin.global.$i = private global ${llvm_type(t)} zeroinitializer, align 8\n")
            None -> ()
    out.push("\n")
    var declared: Buf[string] = buf()
    for f in program.functions
        for block in f.blocks
            for inst in block.insts
                inst match
                    Call(_, Runtime(symbol, signature), _) ->
                        if !contains(declared, symbol)
                            declared.push(symbol)
                            out.push("declare " + c_result(signature) + " @" + symbol + "(" + c_params(signature, shim_extensions(program, symbol)) + ")\n")
                    Call(_, CFunction(symbol, params, result), _) ->
                        if !contains(declared, symbol)
                            declared.push(symbol)
                            var types = ""
                            for i in 0..<params.len()
                                types = types + (if i > 0 then ", " else "") + foreign_type(params[i]) + foreign_extension(params[i])
                            out.push("declare " + foreign_result(result) + " @" + symbol + "(" + types + ")\n")
                    _ -> ()
    out.push("\n")
    var intrinsics: Buf[string] = buf()
    val graph = call_graph(program)
    val collects = collecting_functions(program, graph)
    for i in 0..<program.functions.len()
        emit_function(&out, &intrinsics, program, graph, plan_roots(program, graph, collects, i), i)
    val outside = called_from_outside(program)
    for g in outside.functions
        emit_c_wrapper(&out, program, g)
    if outside.runner then emit_closure_runner(&out)
    for declaration in intrinsics
        out.push(declaration + "\n")
    for b in program.bindings
        for k in 0..<b.params.len()
            if b.params[k].form is Callback(_, result, machine, answer, _)
                emit_invoker(&out, callback_invoker(b.shim, k), machine, answer, if result.form is Plain then extension(result.ty) else "")
    for i in 0..<program.c_trampolines.len()
        emit_trampoline(&out, program, i)
    if program.c_trampolines.len() > 0
        out.push("declare ptr @avin_rt_c_callback_enter(ptr, ptr)\ndeclare void @avin_rt_c_callback_leave(ptr)\n")
    out.push("\n")
    out.push("declare ptr @avin_rt_start(i32, ptr)\n")
    out.push("declare i32 @avin_rt_finish(ptr, i32)\n")
    out.push("declare void @avin_rt_string_descriptor(ptr)\n")
    if roots > 0 then out.push("declare void @avin_rt_globals(ptr)\n")
    if program.testing
        emit_test_main(&out, program, roots)
        return out.finish()
    val entry = program.functions[program.entry.unwrap()]
    out.push("\ndefine i32 @main(i32 %argc, ptr %argv) {\nentry:\n")
    out.push("  %ctx = call ptr @avin_rt_start(i32 %argc, ptr %argv)\n")
    out.push(s"  call void @avin_rt_string_descriptor(ptr @avin.desc.${program.string_descriptor})\n")
    // The module-level values are roots before the first of them is stored, and are all
    // initialized before the entry runs.
    if roots > 0 then out.push("  call void @avin_rt_globals(ptr @avin.roots)\n")
    if program.init is Some(init) then out.push(s"  call ${convention(program.functions[init].signature)}void @\"${program.functions[init].symbol}\"(ptr %ctx)\n")
    // An entry that takes the program's arguments is given the vector the library builds from them.
    var given = "ptr %ctx"
    if program.entry_arguments is Some(a)
        val builder = program.functions[a]
        out.push(s"  %arguments = call ${convention(builder.signature)}${result_type(builder.signature)} @\"${builder.symbol}\"(ptr %ctx)\n")
        given = "ptr %ctx, ptr %arguments"
    // Once the entry returns, the runtime runs the exit hooks and answers the status to exit with.
    entry.signature.result match
        Some(MInt(bits)) ->
            out.push(s"  %result = call ${convention(entry.signature)}i$bits @\"${entry.symbol}\"($given)\n")
            if bits < 32 then out.push(s"  %status = sext i$bits %result to i32\n")
            elif bits > 32 then out.push(s"  %status = trunc i$bits %result to i32\n")
            else out.push("  %status = add i32 %result, 0\n")
        _ ->
            out.push(s"  call ${convention(entry.signature)}${result_type(entry.signature)} @\"${entry.symbol}\"($given)\n")
            out.push("  %status = add i32 0, 0\n")
    out.push("  %exit = call i32 @avin_rt_finish(ptr %ctx, i32 %status)\n  ret i32 %exit\n")
    out.push("}\n")
    out.finish()

// A program built for its tests runs one of them in each process: the one its first argument numbers,
// counting from 0 in the order the checker found them. The module-level values are initialized
// first, as for `main`, so a test sees the program as it starts; its arguments are its name alone,
// since the number is the runner's and not the test's. A missing or unknown number exits 2.
//
// With no second argument the process runs the module's `@setup`, the test and the module's
// `@teardown`, and writes a line to standard error after the setup and after the test, so the runner
// can tell from a process that trapped which of the three it was in. A test answering with a
// `Result` hands the answer to the library's reader, which traps on an `Err`. A second argument
// starting `t` runs only the module's `@teardown`, for a test whose own process ended before it
// could; `a` runs its `@setup_all`, and `z` its `@teardown_all`.
private emit_test_main(out: *StrBuilder, program: MirProgram, roots: usize)
    out.push("declare i32 @atoi(ptr)\n")
    out.push("declare i64 @write(i32, ptr, i64)\n")
    out.push(s"@avin.test.ready = private unnamed_addr constant [${TestReady.len + 1} x i8] c\"$TestReady\\0A\"\n")
    out.push(s"@avin.test.returned = private unnamed_addr constant [${TestReturned.len + 1} x i8] c\"$TestReturned\\0A\"\n")
    out.push("\ndefine i32 @main(i32 %argc, ptr %argv) {\nentry:\n")
    out.push("  %given = icmp sge i32 %argc, 2\n  br i1 %given, label %pick, label %unknown\n")
    out.push("unknown:\n  ret i32 2\n")
    out.push("pick:\n  %slot = getelementptr inbounds ptr, ptr %argv, i64 1\n  %arg = load ptr, ptr %slot\n")
    out.push("  %which = call i32 @atoi(ptr %arg)\n")
    out.push("  %moded = icmp sge i32 %argc, 3\n  br i1 %moded, label %mode, label %start\n")
    out.push("mode:\n  %mode_slot = getelementptr inbounds ptr, ptr %argv, i64 2\n  %mode_arg = load ptr, ptr %mode_slot\n")
    out.push("  %mode_char = load i8, ptr %mode_arg\n  br label %start\n")
    out.push("start:\n  %how = phi i8 [ 0, %pick ], [ %mode_char, %mode ]\n")
    out.push("  %ctx = call ptr @avin_rt_start(i32 1, ptr %argv)\n")
    out.push(s"  call void @avin_rt_string_descriptor(ptr @avin.desc.${program.string_descriptor})\n")
    if roots > 0 then out.push("  call void @avin_rt_globals(ptr @avin.roots)\n")
    if program.init is Some(init) then out.push(s"  call ${convention(program.functions[init].signature)}void @\"${program.functions[init].symbol}\"(ptr %ctx)\n")
    out.push("  switch i32 %which, label %unknown [")
    for i in 0..<program.tests.len()
        out.push(s" i32 $i, label %test$i")
    out.push(" ]\n")
    for i in 0..<program.tests.len()
        val t = program.tests[i]
        out.push(s"test$i:\n  switch i8 %how, label %unknown [ i8 0, label %run$i i8 116, label %teardown$i i8 97, label %setup_all$i i8 122, label %teardown_all$i ]\n")
        out.push(s"run$i:\n")
        call_hook(out, program, t.setup)
        out.push(s"  call i64 @write(i32 2, ptr @avin.test.ready, i64 ${TestReady.len + 1})\n")
        val test = program.functions[t.function]
        t.answer match
            Some(a) ->
                val reader = program.functions[a]
                out.push(s"  %answer$i = call ${convention(test.signature)}${result_type(test.signature)} @\"${test.symbol}\"(ptr %ctx)\n")
                // The context's caller site, which the reader's trap reports.
                out.push(s"  %site$i = getelementptr inbounds i8, ptr %ctx, i64 24\n  store ptr @avin.trap.${t.answer_site}, ptr %site$i\n")
                out.push(s"  call ${convention(reader.signature)}${result_type(reader.signature)} @\"${reader.symbol}\"(ptr %ctx, ${llvm_type(reader.signature.params[0])} %answer$i)\n")
            None -> out.push(s"  call ${convention(test.signature)}${result_type(test.signature)} @\"${test.symbol}\"(ptr %ctx)\n")
        out.push(s"  call i64 @write(i32 2, ptr @avin.test.returned, i64 ${TestReturned.len + 1})\n")
        call_hook(out, program, t.teardown)
        finish_test(out, s"run$i")
        out.push(s"teardown$i:\n")
        call_hook(out, program, t.teardown)
        finish_test(out, s"teardown$i")
        out.push(s"setup_all$i:\n")
        call_hook(out, program, t.setup_all)
        finish_test(out, s"setup_all$i")
        out.push(s"teardown_all$i:\n")
        call_hook(out, program, t.teardown_all)
        finish_test(out, s"teardown_all$i")
    out.push("}\n")

// A test's process ends as a program's does, its exit hooks run once what it ran has returned.
private finish_test(out: *StrBuilder, label: string)
    out.push(s"  %end.$label = call i32 @avin_rt_finish(ptr %ctx, i32 0)\n  ret i32 %end.$label\n")

private call_hook(out: *StrBuilder, program: MirProgram, hook: Option[usize])
    if hook is Some(h)
        val f = program.functions[h]
        out.push(s"  call ${convention(f.signature)}${result_type(f.signature)} @\"${f.symbol}\"(ptr %ctx)\n")

/** The line a test's process writes to standard error once the module's `@setup` has returned. */
const TestReady: string = "avin: test: ready"

/** The line a test's process writes to standard error once the test itself has returned. */
const TestReturned: string = "avin: test: returned"

/** A type record's equality entry as an LLVM constant: the function's address, or null. */
private entry_address(program: MirProgram, entry: Option[usize]) -> string = entry match
    Some(f) -> "ptr @\"" + program.functions[f].symbol + "\""
    None -> "ptr null"

private contains(items: Buf[string], value: string) -> bool
    for item in items
        if item == value then return true
    false

// LLVM string constants escape everything outside printable ASCII, and `"` and `\`, as `\XX`.
private push_bytes(out: *StrBuilder, text: string)
    val hex = "0123456789ABCDEF"
    for b in text.bytes
        if b >= 32 && b < 127 && b != u8('"') && b != u8('\\') then out.push_char(char(b))
        else
            out.push_char('\\')
            out.push_char(char(hex.bytes[usize(b >> 4)]))
            out.push_char(char(hex.bytes[usize(b & 15)]))

private llvm_type(t: MirType) -> string = t match
    MInt(bits) -> s"i$bits"
    MBool -> "i1"
    MReal -> "double"
    MPtr -> "ptr"
    MRef -> "ptr"

private result_type(s: MirSignature) -> string = s.result match
    Some(t) -> llvm_type(t)
    None -> "void"

// The runtime is called with the C convention, so a bool is passed as a byte.
private c_type(t: MirType) -> string = t match
    MInt(bits) -> s"i$bits"
    MBool -> "i8"
    MReal -> "double"
    MPtr -> "ptr"
    MRef -> "ptr"

private c_result(s: MirSignature) -> string = s.result match
    Some(t) -> c_type(t)
    None -> "void"

// The context comes first, then the declared parameters, each with its extension from `extensions`
// where there is one.
private c_params(s: MirSignature, extensions: Buf[string]) -> string
    var out = "ptr"
    for i in 0..<s.params.len()
        out = out + ", " + c_type(s.params[i]) + (if i < extensions.len() then extensions[i] else "")
    out

// How a value of a boundary type narrower than 32 bits is widened in a register with the C
// convention, which Sysl relies on at both ends of a call: a signed integer sign-extended, a byte
// and a bool zero-extended.
private extension(t: &Type) -> string = *t match
    Int(bits) -> if bits < 32 then " signext" else ""
    Byte -> " zeroext"
    Bool -> " zeroext"
    _ -> ""

// The extension of each parameter, after the context, of the binding whose shim is `symbol`, in the
// order the shim takes them; nothing for any other runtime function, none of whose parameters is
// narrow.
private shim_extensions(program: MirProgram, symbol: string) -> Buf[string]
    var out: Buf[string] = buf()
    for b in program.bindings
        if b.shim != symbol then continue
        for p in b.params
            if *p.ty is Unit then continue
            out.push(if p.form is Plain then extension(p.ty) else "")
        return out
    out

private emit_function(out: *StrBuilder, intrinsics: *Buf[string], program: MirProgram, graph: CallGraph, plan: RootPlan, index: usize)
    val f = program.functions[index]
    // Nothing outside the module calls a function of the program by its name: the runtime reaches the
    // ones it runs through descriptors, records and `main`. So each is internal, which lets the
    // optimizer inline it wherever that pays and drop the copy no call needs any more. Every one whose
    // arguments travel in registers has the program's own calling convention, `tailcc`, under which a
    // call in tail position replaces the caller's stack frame (see `convention` and `tail_call_at`);
    // code outside the program reaches one only through a wrapper with the C convention (see
    // `emit_c_wrapper` and `emit_closure_runner`).
    out.push("define internal " + convention(f.signature) + result_type(f.signature) + " @\"" + f.symbol + "\"(ptr %ctx")
    for i in 0..<f.signature.params.len()
        out.push(", " + llvm_type(f.signature.params[i]) + s" %v$i")
    out.push(") {\n")
    // The references live across a collection point are the function's roots, kept in its frame on
    // the shadow stack (see `plan_roots`): each such value is stored to its frame slot where it is
    // made, and a local slot of reference type that needs one is that frame slot. The frame's first
    // word links it to the caller's frame; the context's first word is the top frame, which the
    // function sets to its own on entry and gives back to the caller's on every return. A function
    // with no roots has no frame.
    val value_roots = plan.value_cells
    val roots = plan.cells
    val frame = s"{ ptr, i64, [$roots x ptr] }"
    var temp = 0usize
    var polls = 0usize
    val back = back_edges(f)
    val polled_on_entry = polled_before(graph, index, f)
    for b in 0..<f.blocks.len()
        out.push(s"b$b:\n")
        if b == 0
            // The context's caller site, which calls into the core library set and calls out of it
            // keep; offset 24 in the runtime's context.
            if uses_caller_site(f) then out.push("  %caller.site = getelementptr inbounds i8, ptr %ctx, i64 24\n")
            // The owner of the running code, which a use of a Sysl handle compares; offset 32.
            if uses_owner_word(f) then out.push("  %owner.word = getelementptr inbounds i8, ptr %ctx, i64 32\n")
            if roots > 0
                // Only the slots the collector might read before the function stores to them start
                // null; every other slot is written before any collection can see it.
                out.push(s"  %frame = alloca $frame\n")
                out.push(s"  %frame.count = getelementptr inbounds $frame, ptr %frame, i32 0, i32 1\n")
                out.push(s"  store i64 $roots, ptr %frame.count\n")
                for k in 0..<roots
                    out.push(s"  %root$k = getelementptr inbounds $frame, ptr %frame, i32 0, i32 2, i64 $k\n")
                    if plan.zeroed[k] then out.push(s"  store ptr null, ptr %root$k\n")
                out.push("  %caller = load ptr, ptr %ctx\n")
                out.push("  store ptr %caller, ptr %frame\n")
                out.push("  store ptr %frame, ptr %ctx\n")
            for s in 0..<f.slots.len()
                if plan.slot_cells[s] is Some(k) then out.push(s"  %s$s = getelementptr inbounds $frame, ptr %frame, i32 0, i32 2, i64 $k\n")
                else
                    out.push(s"  %s$s = alloca ${llvm_type(f.slots[s])}\n")
                    if plan.slot_zeroed[s] then out.push(s"  store ptr null, ptr %s$s\n")
            for i in 0..<f.signature.params.len()
                if value_roots[i] is Some(k) then out.push(s"  store ptr %v$i, ptr %root$k\n")
        val block = f.blocks[b]
        var polled = polled_on_entry[b]
        val tail = tail_call_at(program, f, block)
        for i in 0..<block.insts.len()
            val inst = block.insts[i]
            if !polled && closes_cycle(graph, index, inst)
                polls = emit_poll(out, intrinsics, polls)
                polled = true
            val last = tail && i + 1 == block.insts.len()
            // A tail call gives the caller's frame back before it is made, exactly as a return does,
            // since the callee's frame takes its place. Its arguments are then roots of no frame until
            // the callee links its own, which is the first thing it does: nothing between the two
            // allocates, polls or stores a reference, so no collection can run while they are
            // unrooted.
            if last && roots > 0 then out.push("  store ptr %caller, ptr %ctx\n")
            temp = emit_inst(out, intrinsics, program, f, inst, temp, last)
            if !last && inst_dest(inst) is Some(d)
                if value_roots[d] is Some(k) then out.push(s"  store ptr %v$d, ptr %root$k\n")
        if back[b] then polls = emit_poll(out, intrinsics, polls)
        if block.term is Return(_) && !tail
            if roots > 0 then out.push("  store ptr %caller, ptr %ctx\n")
        block.term match
            Return(Some(value)) -> out.push("  ret " + typed_operand(program, f, value) + "\n")
            Return(None) -> out.push("  ret void\n")
            Jump(target) -> out.push(s"  br label %b$target\n")
            Branch(condition, yes, no) -> out.push("  br i1 " + operand(program, f, condition) + s", label %b$yes, label %b$no\n")
            Trap(site) ->
                // The runtime flushes the program's output, reports the site and stops.
                need(intrinsics, "declare void @avin_rt_trap(ptr, ptr) noreturn cold")
                out.push(s"  call void @avin_rt_trap(ptr %ctx, ptr @avin.trap.$site)\n  unreachable\n")
            CallerTrap(site) ->
                // The runtime reports the site's reason at the place the program entered the core
                // library.
                need(intrinsics, "declare void @avin_rt_caller_trap(ptr, ptr) noreturn cold")
                out.push(s"  call void @avin_rt_caller_trap(ptr %ctx, ptr @avin.trap.$site)\n  unreachable\n")
            Unreachable -> out.push("  unreachable\n")
    out.push("}\n\n")

// Whether `block` of `f` ends in a call that is made as a tail call. Its last instruction calls a
// function of the program, by name or through an address a method table, a type record or a function
// value holds (every one of them a function of the program, with its convention), and the block
// returns what the call returned, at the caller's own result type. LLVM makes such a call with
// `musttail` under `tailcc`, the callee's frame replacing the caller's, so mutual recursion and calls
// of function values in tail position run in constant stack at every optimization level. A call stays
// an ordinary one when an argument may be the address of the caller's own stack: one of its slots, or
// a pointer it made rather than received, which the callee would read after the frame is gone.
private tail_call_at(program: MirProgram, f: MirFunction, block: MirBlock) -> bool
    val n = block.insts.len()
    if n == 0 then return false
    var dest: Option[usize] = None
    var callee = f.signature
    var args: Buf[Operand] = buf()
    block.insts[n - 1] match
        Call(d, Direct(g), a) ->
            dest = d
            callee = program.functions[g].signature
            args = a
        Call(d, Indirect(_, signature), a) ->
            dest = d
            callee = signature
            args = a
        _ -> return false
    val result = callee.result
    if !same_result(result, f.signature.result) then return false
    if convention(f.signature) == "" || convention(callee) == "" then return false
    val returned = block.term match
        Return(Some(Value(v))) -> dest == Some(v)
        Return(None) -> result is None
        _ -> false
    if !returned then return false
    for a in args
        a match
            SlotAddress(_) -> return false
            Value(id) -> if f.value_types[id] is MPtr && id >= f.signature.params.len() then return false
            _ -> ()
    true

private same_result(a: Option[MirType], b: Option[MirType]) -> bool = a match
    Some(x) -> b match
        Some(y) -> llvm_type(x) == llvm_type(y)
        None -> false
    None -> b is None

// The start of a call of a function of the program with `signature`, which has its convention.
private call_head(tail: bool, signature: MirSignature) -> string = (if tail then "musttail call " else "call ") + convention(signature)

// The convention of a function of the program with signature `s`: `tailcc`, the program's own, for one
// whose parameters and result all travel in registers on every target the program is built for (the
// context and at most five more integers, references and bools, at most eight reals, no integer wider
// than a register), and the C convention for any other. LLVM's `tailcc` has the callee pop the
// arguments passed on the stack, which its unoptimized code generation gets wrong, and a call whose
// arguments are all in registers needs no such adjustment. A tail call is made only between two
// functions of the program's own convention.
private convention(s: MirSignature) -> string
    var integers = 1usize
    var reals = 0usize
    for t in s.params
        t match
            MReal -> reals += 1
            MInt(bits) ->
                if bits > 64 then return ""
                integers += 1
            _ -> integers += 1
    if s.result is Some(MInt(bits))
        if bits > 64 then return ""
    if integers > 6 || reals > 8 then "" else "tailcc "

/** The functions of the program that code outside it calls, each through its wrapper with the C
 * convention, and whether the runtime is handed the closure runner. */
private struct Outside
    functions: Buf[usize]
    runner: bool

// A function's address is taken only for a Sysl binding's shim to call it, and the closure runner
// only for the runtime to start a thread with.
private called_from_outside(program: MirProgram) -> Outside
    var taken: Buf[bool] = buf()
    for _ in program.functions do taken.push(false)
    var runner = false
    for f in program.functions
        for block in f.blocks
            for inst in block.insts
                for o in inst_operands(inst)
                    o match
                        FunctionAddress(g) -> taken[g] = true
                        ClosureRunner -> runner = true
                        _ -> ()
    var functions: Buf[usize] = buf()
    for g in 0..<taken.len()
        if taken[g] then functions.push(g)
    Outside(functions, runner)

private c_wrapper_name(program: MirProgram, function: usize) -> string = "@\"" + program.functions[function].symbol + "!c\""

// A function of the program as code outside it calls it, with the C convention: the wrapper calls it
// with the program's own and returns what it returns, a bool crossing as a byte.
private emit_c_wrapper(out: *StrBuilder, program: MirProgram, function: usize)
    val f = program.functions[function]
    out.push("define internal " + c_result(f.signature) + " " + c_wrapper_name(program, function) + "(ptr %ctx")
    for i in 0..<f.signature.params.len()
        out.push(", " + c_type(f.signature.params[i]) + s" %a$i")
    out.push(") {\nentry:\n")
    var given = "ptr %ctx"
    for i in 0..<f.signature.params.len()
        val t = f.signature.params[i]
        if t is MBool
            out.push(s"  %p$i = icmp ne i8 %a$i, 0\n")
            given = given + s", i1 %p$i"
        else given = given + ", " + llvm_type(t) + s" %a$i"
    val call = "call " + convention(f.signature) + result_type(f.signature) + " @\"" + f.symbol + "\"(" + given + ")\n"
    f.signature.result match
        Some(MBool) ->
            out.push("  %r = " + call)
            out.push("  %b = zext i1 %r to i8\n  ret i8 %b\n")
        Some(t) ->
            out.push("  %r = " + call)
            out.push("  ret " + llvm_type(t) + " %r\n")
        None ->
            out.push("  " + call)
            out.push("  ret void\n")
    out.push("}\n\n")

// What the runtime calls, with the C convention, to run a started thread's closure: it runs the code
// the closure's descriptor names (see `emit_descriptor`) with the program's own convention.
private emit_closure_runner(out: *StrBuilder)
    out.push("define internal void @avin.run_closure(ptr %ctx, ptr %closure) {\nentry:\n")
    out.push(s"  %kind = getelementptr i8, ptr %closure, i64 -$KindBack\n")
    out.push("  %descriptor = load ptr, ptr %kind, align 8\n")
    out.push("  %call = getelementptr inbounds i8, ptr %descriptor, i64 -8\n")
    out.push("  %code = load ptr, ptr %call, align 8\n")
    out.push("  call tailcc void %code(ptr %ctx, ptr %closure)\n  ret void\n}\n\n")

// Whether any instruction of `f` reads or writes the context's caller site.
private uses_caller_site(f: MirFunction) -> bool
    for block in f.blocks
        for inst in block.insts
            inst match
                Load(_, CallerSite) -> return true
                Store(CallerSite, _) -> return true
                _ -> ()
    false

// Whether any instruction of `f` reads the context's owner.
private uses_owner_word(f: MirFunction) -> bool
    for block in f.blocks
        for inst in block.insts
            if inst is Load(_, OwnerWord) then return true
    false

// A safepoint poll: when a collection has asked the other threads to stop, the runtime parks this one
// until the collection is over. Every reference the function still needs after the poll is already
// in its frame, so the stack is consistent wherever a poll is placed. The flag is read with a relaxed atomic load and the
// slow path is a call to a cold function behind a branch weighted as almost never taken, so the
// common case is one load and a branch that falls through, and the slow path is laid out of line.
// Polls are placed before every terminator with a back edge, which every cycle of the control flow
// has, and before a call that may close a cycle of the call graph, which every recursion makes once
// per level (see `polled_before`). A call that cannot recurse needs none: its callee runs for a
// bounded time between its own polls. `n` numbers the poll within its function; the next number is
// answered.
private emit_poll(out: *StrBuilder, intrinsics: *Buf[string], n: usize) -> usize
    need(intrinsics, "@avin_rt_requested = external global i32")
    need(intrinsics, "declare void @avin_rt_safepoint(ptr) cold")
    need(intrinsics, Unlikely)
    out.push(s"  %poll$n = load atomic i32, ptr @avin_rt_requested monotonic, align 4\n")
    out.push(s"  %stop$n = icmp ne i32 %poll$n, 0\n")
    out.push(s"  br i1 %stop$n, label %park$n, label %run$n, !prof !0\n")
    out.push(s"park$n:\n  call void @avin_rt_safepoint(ptr %ctx)\n  br label %run$n\n")
    out.push(s"run$n:\n")
    n + 1

successors(term: Terminator) -> Buf[usize]
    var out: Buf[usize] = buf()
    term match
        Jump(target) -> out.push(target)
        Branch(_, yes, no) ->
            out.push(yes)
            out.push(no)
        _ -> ()
    out

// For each block of `f`, whether its terminator has a back edge: an edge to a block on the
// depth-first path from the entry to it. Every cycle of the control flow contains one, whatever order
// the blocks are numbered in, and an `if`'s join is never reached by one.
back_edges(f: MirFunction) -> Buf[bool]
    // 0: not reached yet; 1: on the current path; 2: finished.
    var state: Buf[u8] = buf()
    var back: Buf[bool] = buf()
    for _ in 0..<f.blocks.len()
        state.push(0)
        back.push(false)
    if f.blocks.len() == 0 then return back
    // The path, and for each block on it the index of the successor to follow next.
    var path: Buf[usize] = buf()
    var next: Buf[usize] = buf()
    path.push(0)
    next.push(0)
    state[0] = 1
    while path.len() > 0
        val top = path.len() - 1
        val b = path[top]
        val succ = successors(f.blocks[b].term)
        if next[top] < succ.len()
            val s = succ[next[top]]
            next[top] += 1
            if state[s] == 1 then back[b] = true
            else if state[s] == 0
                state[s] = 1
                path.push(s)
                next.push(0)
        else
            state[b] = 2
            _ = path.pop()
            _ = next.pop()
    back

/** The branch weights of a poll: taken once in about a million. A poll's branch is the module's only
 * metadata, so it is number 0. */
private const Unlikely: string = "!0 = !{!\"branch_weights\", i32 1, i32 1048575}"

/** Which calls of the program can recur. Functions are grouped into the strongly connected
 * components of the call graph, where a function calls each function it calls directly and, if it
 * calls through a function value, every function whose address is taken: every closure entry and
 * every method-table entry. A call can be part of a recursion exactly when its callee is in the
 * caller's component. Runtime entry points and the shims of Sysl bindings never call compiled code,
 * so they add no edges; a binding that takes an Avin function would add one to every function whose
 * address is taken. */
struct CallGraph
    /** The component of each function. */
    component: Buf[usize]
    /** For each component, whether one of its functions has its address taken, so that a call
     * through a function value from that component may come back to it. */
    reentered: Buf[bool]

call_graph(program: MirProgram) -> CallGraph
    val n = program.functions.len()
    var taken: Buf[bool] = buf()
    for _ in 0..<n do taken.push(false)
    for k in program.closures do taken[k.function] = true
    for d in program.descriptors
        for m in d.methods
            if m is Some(g) then taken[g] = true
        if d.call is Some(g) then taken[g] = true
    for f in program.functions
        for block in f.blocks
            for inst in block.insts
                for o in inst_operands(inst) do take(&taken, o)
            if block.term is Return(Some(o)) then take(&taken, o)
            if block.term is Branch(o, _, _) then take(&taken, o)
    var targets: Buf[usize] = buf()
    for g in 0..<n
        if taken[g] then targets.push(g)
    // The edges of function `v` are `edges[starts[v]..<starts[v + 1]]`.
    var starts: Buf[usize] = buf()
    var edges: Buf[usize] = buf()
    for f in program.functions
        starts.push(edges.len())
        var indirect = false
        for block in f.blocks
            for inst in block.insts
                inst match
                    Call(_, Direct(g), _) -> edges.push(g)
                    Call(_, Indirect(_, _), _) -> indirect = true
                    _ -> ()
        if indirect
            for g in targets do edges.push(g)
    starts.push(edges.len())
    val component = components(n, starts, edges)
    var reentered: Buf[bool] = buf()
    for _ in 0..<n do reentered.push(false)
    for g in targets do reentered[component[g]] = true
    CallGraph(component, reentered)

private take(taken: *Buf[bool], o: Operand)
    if o is FunctionAddress(g) then (*taken)[g] = true

inst_operands(inst: Inst) -> Buf[Operand]
    var out: Buf[Operand] = buf()
    inst match
        Call(_, callee, args) ->
            if callee is Indirect(target, _) then out.push(target)
            for a in args do out.push(a)
        Binary(_, _, left, right) ->
            out.push(left)
            out.push(right)
        Checked(_, _, _, left, right) ->
            out.push(left)
            out.push(right)
        Compare(_, _, left, right) ->
            out.push(left)
            out.push(right)
        Select(_, condition, yes, no) ->
            out.push(condition)
            out.push(yes)
            out.push(no)
        Convert(_, _, value) -> out.push(value)
        Load(_, address) -> out.push(address)
        Store(address, value) ->
            out.push(address)
            out.push(value)
        Alloc(_, _) -> ()
        Publish -> ()
        AtomicLoad(_, address) -> out.push(address)
        AtomicStore(address, value) ->
            out.push(address)
            out.push(value)
        AtomicSwap(_, address, value) ->
            out.push(address)
            out.push(value)
        AtomicCompareSet(_, address, expected, desired) ->
            out.push(address)
            out.push(expected)
            out.push(desired)
        Offset(_, base, _) -> out.push(base)
        Index(_, base, index) ->
            out.push(base)
            out.push(index)
        DescriptorOf(_, object) -> out.push(object)
        MethodSlot(_, object, _) -> out.push(object)
        CallEntry(_, object) -> out.push(object)
    out

// The strongly connected components of a graph of `n` vertices, numbered from 0, by Tarjan's
// algorithm with an explicit stack of the vertices being visited.
components(n: usize, starts: Buf[usize], edges: Buf[usize]) -> Buf[usize]
    // The visit order of each vertex, from 1; 0 is not visited yet.
    var order: Buf[usize] = buf()
    var low: Buf[usize] = buf()
    var on_stack: Buf[bool] = buf()
    var component: Buf[usize] = buf()
    for _ in 0..<n
        order.push(0)
        low.push(0)
        on_stack.push(false)
        component.push(0)
    var stack: Buf[usize] = buf()
    // The vertices being visited, and for each the position of its next edge.
    var path: Buf[usize] = buf()
    var next: Buf[usize] = buf()
    var visited = 0usize
    var found = 0usize
    for root in 0..<n
        if order[root] == 0
            visited += 1
            order[root] = visited
            low[root] = visited
            stack.push(root)
            on_stack[root] = true
            path.push(root)
            next.push(starts[root])
            while path.len() > 0
                val top = path.len() - 1
                val v = path[top]
                if next[top] < starts[v + 1]
                    val w = edges[next[top]]
                    next[top] += 1
                    if order[w] == 0
                        visited += 1
                        order[w] = visited
                        low[w] = visited
                        stack.push(w)
                        on_stack[w] = true
                        path.push(w)
                        next.push(starts[w])
                    elif on_stack[w] && order[w] < low[v] then low[v] = order[w]
                else
                    _ = path.pop()
                    _ = next.pop()
                    if low[v] == order[v]
                        var done = false
                        while !done
                            val w = stack.pop().unwrap()
                            on_stack[w] = false
                            component[w] = found
                            done = w == v
                        found += 1
                    if path.len() > 0
                        val u = path[path.len() - 1]
                        if low[v] < low[u] then low[u] = low[v]
    component

// Whether `inst`, in function `caller`, is a call that may close a cycle of the call graph.
closes_cycle(graph: CallGraph, caller: usize, inst: Inst) -> bool = inst match
    Call(_, Direct(g), _) -> graph.component[g] == graph.component[caller]
    Call(_, Indirect(_, _), _) -> graph.reentered[graph.component[caller]]
    _ -> false

// For each block of function `index`, whether a poll has run in this call of it on every path from
// the entry to the block. A call that may close a cycle needs a poll before it only where none has:
// every level of a recursion then still polls once on the way to the next, since every path to the
// call passes a poll, and the time between that poll and the call is bounded by the code between them,
// the calls they make, which poll for themselves, and loops, which poll on their back edges. A
// function that recurses on only some paths polls only on those, and its leaf calls never poll.
polled_before(graph: CallGraph, index: usize, f: MirFunction) -> Buf[bool]
    val n = f.blocks.len()
    var polled: Buf[bool] = buf()
    var polls: Buf[bool] = buf()
    for b in 0..<n
        polled.push(b != 0)
        var any = false
        for inst in f.blocks[b].insts
            if closes_cycle(graph, index, inst) then any = true
        polls.push(any)
    // A block's value only ever falls from true to false, so the walk reaches a fixed point.
    var changed = true
    while changed
        changed = false
        for b in 0..<n
            if !polled[b] && !polls[b]
                for s in successors(f.blocks[b].term)
                    if polled[s]
                        polled[s] = false
                        changed = true
    polled

// A descriptor is the collector's kind, then the header the runtime reads (tag, size, reference
// count, type record), then the reference offsets. An object's descriptor is the kind the collector keeps in its
// header, `KindBack` bytes before the object. The word directly before the descriptor is its `call`,
// what a call of the object as a function value runs, null for an object that is no function; a
// class's method table sits before that, in the same constant, so slot `s` is the word 8(s + 2) bytes
// before the descriptor; `@avin.desc.N` names the descriptor's address. An abstract method's slot is
// null: no object of its class exists. A variant with no field data is one constant object, which is
// only its header.
private emit_descriptor(out: *StrBuilder, program: MirProgram, i: usize)
    val d = program.descriptors[i]
    val n = d.refs.len()
    val header = s"{ $KindType, i64, i64, i64, ptr, [$n x i64] }"
    var body = str_builder()
    var kind = d.tracing match
        Fields -> KindValue
        EachElement -> ArrayKindValue
        ElementMap -> MappedArrayKindValue
    for h in program.handles
        if h.descriptor == i then kind = s"$KindType { ptr @avin_rt_trace, ptr @${h.finalizer}, ptr null, ptr null }"
    for h in program.c_handles
        if h.descriptor == i then kind = s"$KindType { ptr @avin_rt_trace, ptr @${h.finalizer}, ptr null, ptr null }"
    body.push(s"{ $kind, i64 ${d.tag}, i64 ${d.size}, i64 $n, ptr @avin.type.${d.record}, [$n x i64] ")
    if n == 0 then body.push("zeroinitializer")
    else
        body.push("[")
        for j in 0..<n
            if j > 0 then body.push(", ")
            body.push(s"i64 ${d.refs[j]}")
        body.push("]")
    body.push(" }")
    val value = body.finish()
    val m = d.methods.len()
    val words = m + 1
    val whole = s"{ [$words x ptr], $header }"
    out.push(s"; ${d.name}\n@avin.methods.$i = private constant $whole { [$words x ptr] [")
    for j in 0..<m
        d.methods[m - 1 - j] match
            Some(f) -> out.push("ptr @\"" + program.functions[f].symbol + "\", ")
            None -> out.push("ptr null, ")
    d.call match
        Some(f) -> out.push("ptr @\"" + program.functions[f].symbol + "\"")
        None -> out.push("ptr null")
    out.push(s"], $header $value }, align 8\n")
    out.push(s"@avin.desc.$i = private alias $header, ptr getelementptr inbounds ($whole, ptr @avin.methods.$i, i32 0, i32 1)\n")
    if d.constant
        out.push(s"@avin.obj.$i.const = private constant { ptr, i64 } { ptr @avin.desc.$i, i64 0 }, align 16\n")
        constant_payload(out, s"@avin.obj.$i")

/** The symbol of the entry a binding's shim calls a function value passed as its parameter `k`
 * through. */
callback_invoker(shim: string, k: usize) -> string = s"${shim}_cb$k"

// The entry through which a binding's shim calls a function value Sysl was given, with the C
// convention the shim calls with: the context, the closure, then its arguments, a bool as a byte. It
// runs the closure's code, the word before its descriptor, with the program's own convention for
// the closure's signature, and gives back what it answers, a narrow one widened as `ext` says.
private emit_invoker(out: *StrBuilder, name: string, machine: Buf[MirType], answer: Option[MirType], ext: string)
    var params: Buf[MirType] = buf()
    params.push(MRef)
    for t in machine
        params.push(t)
    val cc = convention(MirSignature(params, answer))
    val result = answer match
        Some(t) -> ext.trim() + " " + c_type(t)
        None -> "void"
    out.push(s"\ndefine $result @$name(ptr %ctx, ptr %f")
    for i in 0..<machine.len()
        out.push(s", ${c_type(machine[i])} %a$i")
    out.push(s") {\nentry:\n  %h = getelementptr i8, ptr %f, i64 -$KindBack\n  %d = load ptr, ptr %h, align 8\n  %e = getelementptr inbounds i8, ptr %d, i64 -8\n  %code = load ptr, ptr %e, align 8\n")
    var args = "ptr %ctx, ptr %f"
    for i in 0..<machine.len()
        if machine[i] is MBool
            out.push(s"  %b$i = icmp ne i8 %a$i, 0\n")
            args = args + s", i1 %b$i"
        else args = args + s", ${llvm_type(machine[i])} %a$i"
    answer match
        Some(t) ->
            out.push(s"  %r = call $cc${llvm_type(t)} %code($args)\n")
            if t is MBool then out.push("  %rb = zext i1 %r to i8\n  ret i8 %rb\n}\n")
            else out.push(s"  ret ${llvm_type(t)} %r\n}\n")
        None -> out.push(s"  call ${cc}void %code($args)\n  ret void\n}\n")

// The trampoline `program.c_trampolines[i]`, which C calls with its own convention through a function
// pointer: it begins the call on the calling thread with the `userdata`, the callback's record, as
// `avin_rt_c_callback_enter`, which answers the context and writes what ending the call needs in room
// of the trampoline's frame; runs the function that converts and calls, with the program's
// convention; ends the call; and answers what that function answered, a `float` rounded from the
// `real` carrying it, as every `float` C is passed is widened.
private emit_trampoline(out: *StrBuilder, program: MirProgram, i: usize)
    val t = program.c_trampolines[i]
    val f = program.functions[t.function]
    out.push(s"\ndefine internal ${foreign_result(t.result)} @avin.c.trampoline.$i(")
    for j in 0..<t.params.len()
        if j > 0 then out.push(", ")
        out.push(foreign_type(t.params[j]) + foreign_extension(t.params[j]) + s" %a$j")
    out.push(") {\nentry:\n  %entered = alloca [8 x i64], align 8\n")
    out.push(s"  %ctx = call ptr @avin_rt_c_callback_enter(ptr %a${t.userdata}, ptr %entered)\n")
    var args = s"ptr %ctx, ptr %a${t.userdata}"
    for j in 0..<t.params.len()
        if j == t.userdata then continue
        if t.params[j] is CBinary32
            out.push(s"  %w$j = fpext float %a$j to double\n")
            args = args + s", double %w$j"
        else args = args + ", " + foreign_type(t.params[j]) + s" %a$j"
    val call = "call " + convention(f.signature) + result_type(f.signature) + " @\"" + f.symbol + "\"(" + args + ")\n"
    t.result match
        Some(s) ->
            out.push("  %r = " + call)
            out.push("  call void @avin_rt_c_callback_leave(ptr %entered)\n")
            if s is CBinary32
                out.push("  %n = fptrunc double %r to float\n  ret float %n\n}\n")
            else out.push("  ret " + foreign_type(s) + " %r\n}\n")
        None ->
            out.push("  " + call)
            out.push("  call void @avin_rt_c_callback_leave(ptr %entered)\n  ret void\n}\n")

/** The collector's `Kind` as a descriptor begins with it: the runtime's tracer, and no finalizer,
 * weak hook or ephemeron hook. A Sysl handle's kind has its finalizer. */
private const KindType: string = "{ ptr, ptr, ptr, ptr }"
private const KindValue: string = "{ ptr, ptr, ptr, ptr } { ptr @avin_rt_trace, ptr null, ptr null, ptr null }"
/** The kind of an array whose elements are references: the runtime's array tracer marks each one. */
private const ArrayKindValue: string = "{ ptr, ptr, ptr, ptr } { ptr @avin_rt_trace_array, ptr null, ptr null, ptr null }"
/** The kind of an array with an element map: the runtime's mapped-array tracer marks, in every
 * element, the words at the descriptor's offsets. */
private const MappedArrayKindValue: string = "{ ptr, ptr, ptr, ptr } { ptr @avin_rt_trace_array_map, ptr null, ptr null, ptr null }"

/** How far before an object its descriptor is: the collector's `KIND_BACK`, two words. A constant
 * object outside the heap is laid out with those two words ahead of it, its descriptor and a word
 * left zero, which the collector never reads for an object it does not own. */
private const KindBack: usize = 16

// An object made at compile time is laid out as one the collector made, but in read-only data: its
// header, then each field at its offset in the width a store would write it, the bytes between them
// zero.
private emit_constant(out: *StrBuilder, program: MirProgram, i: usize)
    val k = program.constants[i]
    var types = str_builder()
    var values = str_builder()
    types.push("ptr, i64")
    values.push(s"ptr @avin.desc.${k.descriptor}, i64 0")
    var at = 0usize
    for f in k.fields
        if f.offset > at then pad_bytes(&types, &values, f.offset - at)
        val cell = constant_cell(f)
        types.push(", " + cell.ty)
        values.push(", " + cell.ty + " " + cell.text)
        at = f.offset + cell.width
    val end = (if k.size > at then k.size else at) + 7
    val whole = end - end % 8
    if whole > at then pad_bytes(&types, &values, whole - at)
    out.push(s"@avin.data.$i.const = private constant <{ ${types.finish()} }> <{ ${values.finish()} }>, align 16\n")
    constant_payload(out, s"@avin.data.$i")

private pad_bytes(types: *StrBuilder, values: *StrBuilder, n: usize)
    types.push(s", [$n x i8]")
    values.push(s", [$n x i8] zeroinitializer")

/** A field of a constant object as LLVM writes it: its type, its width in bytes, and its value. */
private struct Cell
    ty: string
    width: usize
    text: string

private constant_cell(f: ConstantField) -> Cell
    val text = f.value match
        ConstInt(_, digits) -> digits
        ConstBool(value) -> if value then "1" else "0"
        ConstReal(value) -> real_constant(value)
        ConstStr(index) -> payload_address(s"@avin.str.$index")
        ConstObject(descriptor) -> payload_address(s"@avin.obj.$descriptor")
        ConstData(index, _) -> payload_address(s"@avin.data.$index")
        ConstClosure(index) -> payload_address(s"@avin.fn.$index")
        _ -> "null"
    f.ty match
        MInt(_) ->
            val w = storage_bits(f.ty)
            Cell(s"i$w", usize(w / 8), text)
        MBool -> Cell("i8", 1, text)
        MReal -> Cell("double", 8, text)
        _ -> Cell("ptr", 8, text)

// Names the payload of the constant object `name.const`, which follows its two header words, as
// `name`: every reference to the object is to its payload.
private constant_payload(out: *StrBuilder, name: string)
    out.push(s"$name = private alias i8, ptr getelementptr inbounds (i8, ptr $name.const, i64 $KindBack)\n")

// The address of the payload of the constant object `name.const`, written out rather than by its
// alias: LLVM sees through the expression to the constant, so it knows the object can be read on
// either side of a choice between two of them, and folds what is read.
private payload_address(name: string) -> string = s"getelementptr inbounds (i8, ptr $name.const, i64 $KindBack)"

/** The byte offset from a descriptor to the method in slot `slot` of the table before its `call`. */
private method_slot_offset(slot: usize) -> string = "-" + ((slot + 2) * 8).to_string()

/** The value an instruction defines, if any. */
inst_dest(inst: Inst) -> Option[usize] = inst match
    Call(dest, _, _) -> dest
    Binary(dest, _, _, _) -> Some(dest)
    Checked(dest, _, _, _, _) -> Some(dest)
    Compare(dest, _, _, _) -> Some(dest)
    Select(dest, _, _, _) -> Some(dest)
    Convert(dest, _, _) -> Some(dest)
    Load(dest, _) -> Some(dest)
    Store(_, _) -> None
    Alloc(dest, _) -> Some(dest)
    Publish -> None
    AtomicLoad(dest, _) -> Some(dest)
    AtomicStore(_, _) -> None
    AtomicSwap(dest, _, _) -> Some(dest)
    AtomicCompareSet(dest, _, _, _) -> Some(dest)
    Offset(dest, _, _) -> Some(dest)
    Index(dest, _, _) -> Some(dest)
    DescriptorOf(dest, _) -> Some(dest)
    MethodSlot(dest, _, _) -> Some(dest)
    CallEntry(dest, _) -> Some(dest)

private need(intrinsics: *Buf[string], declaration: string)
    if !contains(*intrinsics, declaration) then intrinsics.push(declaration)

private op_name(op: MirOp) -> string = op match
    OpAdd -> "add"
    OpSub -> "sub"
    OpMul -> "mul"
    OpDiv -> "sdiv"
    OpRem -> "srem"
    OpAnd -> "and"
    OpOr -> "or"
    OpXor -> "xor"
    OpShl -> "shl"
    OpAShr -> "ashr"
    OpLShr -> "lshr"
    OpFAdd -> "fadd"
    OpFSub -> "fsub"
    OpFMul -> "fmul"
    OpFDiv -> "fdiv"
    OpFRem -> "frem"
    _ -> ""

// Saturating operations are LLVM intrinsics; multiplication saturates as a fixed-point product
// with no fractional bits.
private saturating_name(op: MirOp) -> string = op match
    OpAddSat -> "sadd.sat"
    OpSubSat -> "ssub.sat"
    OpMulSat -> "smul.fix.sat"
    _ -> ""

private checked_name(op: MirChecked) -> string = op match
    CheckedAdd -> "sadd"
    CheckedSub -> "ssub"
    CheckedMul -> "smul"

private cmp_name(op: MirCmp) -> string = op match
    CmpEq -> "eq"
    CmpNe -> "ne"
    CmpLt -> "slt"
    CmpLe -> "sle"
    CmpGt -> "sgt"
    CmpGe -> "sge"
    CmpUge -> "uge"
    CmpUlt -> "ult"
    CmpUle -> "ule"
    CmpUgt -> "ugt"
    FEq -> "oeq"
    FNe -> "une"
    FLt -> "olt"
    FLe -> "ole"
    FGt -> "ogt"
    FGe -> "oge"

private is_real_cmp(op: MirCmp) -> bool = op match
    FEq -> true
    FNe -> true
    FLt -> true
    FLe -> true
    FGt -> true
    FGe -> true
    _ -> false

private conv_name(conv: MirConv) -> string = conv match
    SignExtend -> "sext"
    ZeroExtend -> "zext"
    Truncate -> "trunc"
    SignedToReal -> "sitofp"
    UnsignedToReal -> "uitofp"
    RealToInt -> "fptosi.sat"
    Binary32ToReal -> "bitcast"
    RealToBinary32 -> "fptrunc"

private int_width(t: MirType) -> u32 = t match
    MInt(bits) -> bits
    _ -> 0

// The widest integer the code generator converts to and from `double` by itself; a wider one is
// converted here, in plain integer and floating-point instructions.
private val widest_native_conversion: u32 = 128

// Converts the signed `bits`-wide integer `x` to the nearest double, ties to even, as `sitofp`
// does for a narrow one. The magnitude is normalized so its top bit is the integer's top bit; its
// top 64 bits, with any lower one bits folded into the lowest as a sticky bit, round to the same
// double the whole magnitude does, and the exponent is applied by an exact multiplication by a
// power of two. A magnitude of 2^1024 or more is infinity.
private wide_int_to_real(out: *StrBuilder, intrinsics: *Buf[string], dest: string, p: string, bits: u32, x: string)
    val t = s"i$bits"
    need(intrinsics, s"declare $t @llvm.ctlz.$t($t, i1)")
    out.push(s"  ${p}.neg = icmp slt $t $x, 0\n")
    out.push(s"  ${p}.minus = sub $t 0, $x\n")
    out.push(s"  ${p}.mag = select i1 ${p}.neg, $t ${p}.minus, $t $x\n")
    out.push(s"  ${p}.zero = icmp eq $t ${p}.mag, 0\n")
    out.push(s"  ${p}.lz = call $t @llvm.ctlz.$t($t ${p}.mag, i1 false)\n")
    out.push(s"  ${p}.norm = shl $t ${p}.mag, ${p}.lz\n")
    out.push(s"  ${p}.top = lshr $t ${p}.norm, ${bits - 64}\n")
    out.push(s"  ${p}.hi = trunc $t ${p}.top to i64\n")
    out.push(s"  ${p}.low = shl $t ${p}.norm, 64\n")
    out.push(s"  ${p}.inexact = icmp ne $t ${p}.low, 0\n")
    out.push(s"  ${p}.sticky = zext i1 ${p}.inexact to i64\n")
    out.push(s"  ${p}.digits = or i64 ${p}.hi, ${p}.sticky\n")
    out.push(s"  ${p}.rounded = uitofp i64 ${p}.digits to double\n")
    // The top bit's position is bits - 1 - lz, and the 64 digits are scaled by 2^(position - 63):
    // a biased exponent of position + 960.
    out.push(s"  ${p}.lz64 = trunc $t ${p}.lz to i64\n")
    out.push(s"  ${p}.biased = sub i64 ${u64(bits) + 959}, ${p}.lz64\n")
    out.push(s"  ${p}.huge = icmp sge i64 ${p}.biased, 1984\n")
    out.push(s"  ${p}.field = shl i64 ${p}.biased, 52\n")
    out.push(s"  ${p}.scale = bitcast i64 ${p}.field to double\n")
    out.push(s"  ${p}.scaled = fmul double ${p}.rounded, ${p}.scale\n")
    out.push(s"  ${p}.finite = select i1 ${p}.huge, double 0x7FF0000000000000, double ${p}.scaled\n")
    out.push(s"  ${p}.abs = select i1 ${p}.zero, double 0.0, double ${p}.finite\n")
    out.push(s"  ${p}.negated = fneg double ${p}.abs\n")
    out.push(s"  $dest = select i1 ${p}.neg, double ${p}.negated, double ${p}.abs\n")

// Converts the double `r` to a signed `bits`-wide integer as `fptosi.sat` does for a narrow one:
// toward zero, saturating at the bounds, NaN to zero. The 53-bit significand is shifted into place
// by the unbiased exponent; a magnitude below one is zero and one of 2^(bits - 1) or more, or an
// infinity, is the bound on its side. The shifts a case does not use may be out of range, and the
// selects discard what they give.
private real_to_wide_int(out: *StrBuilder, dest: string, p: string, bits: u32, r: string)
    val t = s"i$bits"
    out.push(s"  ${p}.b = bitcast double $r to i64\n")
    out.push(s"  ${p}.neg = icmp slt i64 ${p}.b, 0\n")
    out.push(s"  ${p}.shifted = lshr i64 ${p}.b, 52\n")
    out.push(s"  ${p}.exp = and i64 ${p}.shifted, 2047\n")
    out.push(s"  ${p}.frac = and i64 ${p}.b, 4503599627370495\n")
    out.push(s"  ${p}.mant = or i64 ${p}.frac, 4503599627370496\n")
    out.push(s"  ${p}.e = sub i64 ${p}.exp, 1023\n")
    out.push(s"  ${p}.special = icmp eq i64 ${p}.exp, 2047\n")
    out.push(s"  ${p}.fraction = icmp ne i64 ${p}.frac, 0\n")
    out.push(s"  ${p}.nan = and i1 ${p}.special, ${p}.fraction\n")
    out.push(s"  ${p}.over = icmp sge i64 ${p}.e, ${bits - 1}\n")
    out.push(s"  ${p}.sat = or i1 ${p}.special, ${p}.over\n")
    out.push(s"  ${p}.small = icmp slt i64 ${p}.e, 0\n")
    out.push(s"  ${p}.wide = zext i64 ${p}.mant to $t\n")
    out.push(s"  ${p}.up64 = sub i64 ${p}.e, 52\n")
    out.push(s"  ${p}.up = zext i64 ${p}.up64 to $t\n")
    out.push(s"  ${p}.left = shl $t ${p}.wide, ${p}.up\n")
    out.push(s"  ${p}.down = sub i64 52, ${p}.e\n")
    out.push(s"  ${p}.right64 = lshr i64 ${p}.mant, ${p}.down\n")
    out.push(s"  ${p}.right = zext i64 ${p}.right64 to $t\n")
    out.push(s"  ${p}.isleft = icmp sge i64 ${p}.e, 52\n")
    out.push(s"  ${p}.mag = select i1 ${p}.isleft, $t ${p}.left, $t ${p}.right\n")
    out.push(s"  ${p}.minus = sub $t 0, ${p}.mag\n")
    out.push(s"  ${p}.value = select i1 ${p}.neg, $t ${p}.minus, $t ${p}.mag\n")
    out.push(s"  ${p}.max = lshr $t -1, 1\n")
    out.push(s"  ${p}.min = xor $t ${p}.max, -1\n")
    out.push(s"  ${p}.bound = select i1 ${p}.neg, $t ${p}.min, $t ${p}.max\n")
    out.push(s"  ${p}.clamped = select i1 ${p}.sat, $t ${p}.bound, $t ${p}.value\n")
    out.push(s"  ${p}.whole = select i1 ${p}.small, $t 0, $t ${p}.clamped\n")
    out.push(s"  $dest = select i1 ${p}.nan, $t 0, $t ${p}.whole\n")

// With `tail`, `inst` is a call that `tail_call_at` has found in tail position, made as one.
private emit_inst(out: *StrBuilder,intrinsics: *Buf[string], program: MirProgram, f: MirFunction, inst: Inst, temp: usize, tail: bool) -> usize
    var next = temp
    inst match
        Binary(dest, op, left, right) ->
            val t = llvm_type(operand_type(program, f, left))
            val a = operand(program, f, left)
            val b = operand(program, f, right)
            val sat = saturating_name(op)
            if sat == ""
                out.push(s"  %v$dest = ${op_name(op)} $t $a, $b\n")
            else
                val scale = if op is OpMulSat then ", i32 0" else ""
                need(intrinsics, s"declare $t @llvm.$sat.$t($t, $t${if scale == "" then "" else ", i32"})")
                out.push(s"  %v$dest = call $t @llvm.$sat.$t($t $a, $t $b$scale)\n")
        Checked(dest, overflow, op, left, right) ->
            val t = llvm_type(operand_type(program, f, left))
            val name = s"llvm.${checked_name(op)}.with.overflow.$t"
            need(intrinsics, s"declare { $t, i1 } @$name($t, $t)")
            out.push(s"  %t$next = call { $t, i1 } @$name($t ${operand(program, f, left)}, $t ${operand(program, f, right)})\n")
            out.push(s"  %v$dest = extractvalue { $t, i1 } %t$next, 0\n")
            out.push(s"  %v$overflow = extractvalue { $t, i1 } %t$next, 1\n")
            next += 1
        Compare(dest, op, left, right) ->
            val instruction = if is_real_cmp(op) then "fcmp" else "icmp"
            out.push(s"  %v$dest = $instruction ${cmp_name(op)} " + typed_operand(program, f, left) + ", " + operand(program, f, right) + "\n")
        Convert(dest, conv, value) ->
            val to = llvm_type(f.value_types[dest])
            val from_bits = int_width(operand_type(program, f, value))
            val to_bits = int_width(f.value_types[dest])
            if conv is SignedToReal && from_bits > widest_native_conversion
                wide_int_to_real(out, intrinsics, s"%v$dest", s"%t$next", from_bits, operand(program, f, value))
                next += 1
            else if conv is RealToInt && to_bits > widest_native_conversion
                real_to_wide_int(out, s"%v$dest", s"%t$next", to_bits, operand(program, f, value))
                next += 1
            else if conv is Binary32ToReal
                out.push(s"  %t$next = bitcast " + typed_operand(program, f, value) + " to float\n")
                out.push(s"  %v$dest = fpext float %t$next to double\n")
                next += 1
            else if conv is RealToBinary32
                out.push(s"  %t$next = fptrunc " + typed_operand(program, f, value) + " to float\n")
                out.push(s"  %v$dest = bitcast float %t$next to i32\n")
                next += 1
            else if conv is RealToInt
                need(intrinsics, s"declare $to @llvm.fptosi.sat.$to.f64(double)")
                out.push(s"  %v$dest = call $to @llvm.fptosi.sat.$to.f64(double " + operand(program, f, value) + ")\n")
            else out.push(s"  %v$dest = ${conv_name(conv)} " + typed_operand(program, f, value) + s" to $to\n")
        Select(dest, condition, yes, no) ->
            out.push(s"  %v$dest = select i1 " + operand(program, f, condition) + ", " + typed_operand(program, f, yes) + ", " + typed_operand(program, f, no) + "\n")
        Load(dest, address) ->
            val t = f.value_types[dest]
            if is_shared(f, address) then load_shared(out, s"%v$dest", t, operand(program, f, address))
            else out.push(s"  %v$dest = load ${llvm_type(t)}, ptr " + operand(program, f, address) + alignment(t) + "\n")
        Store(address, value) ->
            if is_shared(f, address)
                store_shared(out, s"%t$next", operand_type(program, f, value), operand(program, f, value), operand(program, f, address))
                next += 1
            else out.push("  store " + typed_operand(program, f, value) + ", ptr " + operand(program, f, address) + alignment(operand_type(program, f, value)) + "\n")
        Publish -> out.push("  fence release\n")
        AtomicLoad(dest, address) ->
            emit_atomic_load(out, intrinsics, f.value_types[dest], s"%v$dest", operand(program, f, address))
        AtomicStore(address, value) ->
            emit_atomic_store(out, intrinsics, s"%t$next", operand_type(program, f, value), operand(program, f, value), operand(program, f, address))
            next += 1
        AtomicSwap(dest, address, value) ->
            emit_atomic_swap(out, intrinsics, s"%t$next", f.value_types[dest], s"%v$dest", operand(program, f, value), operand(program, f, address))
            next += 1
        AtomicCompareSet(dest, address, expected, desired) ->
            val t = operand_type(program, f, expected)
            emit_atomic_compare_set(out, intrinsics, s"%t$next", t, s"%v$dest", operand(program, f, expected), operand(program, f, desired), operand(program, f, address))
            next += 1
        Alloc(dest, descriptor) ->
            need(intrinsics, "declare ptr @avin_rt_alloc(ptr, ptr)")
            out.push(s"  %v$dest = call ptr @avin_rt_alloc(ptr %ctx, ptr @avin.desc.$descriptor)\n")
        Offset(dest, base, bytes) ->
            out.push(s"  %v$dest = getelementptr inbounds i8, ptr " + operand(program, f, base) + s", i64 $bytes\n")
        Index(dest, base, index) ->
            out.push(s"  %v$dest = getelementptr inbounds i8, ptr " + operand(program, f, base) + ", " + typed_operand(program, f, index) + "\n")
        DescriptorOf(dest, object) ->
            out.push(s"  %t$next = getelementptr i8, ptr " + operand(program, f, object) + s", i64 -$KindBack\n")
            out.push(s"  %v$dest = load ptr, ptr %t$next, align 8\n")
            next += 1
        CallEntry(dest, object) ->
            out.push(s"  %t$next = getelementptr i8, ptr " + operand(program, f, object) + s", i64 -$KindBack\n")
            out.push(s"  %t${next + 1} = load ptr, ptr %t$next, align 8\n")
            out.push(s"  %t${next + 2} = getelementptr inbounds i8, ptr %t${next + 1}, i64 -8\n")
            out.push(s"  %v$dest = load ptr, ptr %t${next + 2}, align 8\n")
            next += 3
        MethodSlot(dest, object, slot) ->
            out.push(s"  %t$next = getelementptr i8, ptr " + operand(program, f, object) + s", i64 -$KindBack\n")
            out.push(s"  %t${next + 1} = load ptr, ptr %t$next, align 8\n")
            out.push(s"  %t${next + 2} = getelementptr inbounds i8, ptr %t${next + 1}, i64 ${method_slot_offset(slot)}\n")
            out.push(s"  %v$dest = load ptr, ptr %t${next + 2}, align 8\n")
            next += 3
        Call(dest, Direct(index), args) ->
            val callee = program.functions[index]
            out.push("  ")
            if dest is Some(d) then out.push(s"%v$d = ")
            out.push(call_head(tail, callee.signature) + result_type(callee.signature) + " @\"" + callee.symbol + "\"(ptr %ctx")
            for a in args
                out.push(", " + typed_operand(program, f, a))
            out.push(")\n")
        Call(dest, Indirect(target, signature), args) ->
            out.push("  ")
            if dest is Some(d) then out.push(s"%v$d = ")
            out.push(call_head(tail, signature) + result_type(signature) + " " + operand(program, f, target) + "(ptr %ctx")
            for a in args
                out.push(", " + typed_operand(program, f, a))
            out.push(")\n")
        Call(dest, Runtime(symbol, signature), args) ->
            var parts: Buf[string] = buf()
            parts.push("ptr %ctx")
            val extensions = shim_extensions(program, symbol)
            for i in 0..<args.len()
                val a = args[i]
                val ext = if i < extensions.len() then extensions[i] else ""
                operand_type(program, f, a) match
                    MBool ->
                        out.push(s"  %t$next = zext i1 " + operand(program, f, a) + " to i8\n")
                        parts.push(s"i8$ext %t$next")
                        next += 1
                    MInt(bits) -> parts.push(s"i$bits$ext " + operand(program, f, a))
                    MReal -> parts.push("double " + operand(program, f, a))
                    MPtr -> parts.push("ptr " + operand(program, f, a))
                    MRef -> parts.push("ptr " + operand(program, f, a))
            // A bool comes back as a byte, which is nonzero for true.
            val byte_result = signature.result is Some(MBool)
            out.push("  ")
            if dest is Some(d)
                if byte_result then out.push(s"%t$next = ") else out.push(s"%v$d = ")
            out.push("call " + c_result(signature) + " @" + symbol + "(")
            for i in 0..<parts.len()
                if i > 0 then out.push(", ")
                out.push(parts[i])
            out.push(")\n")
            if dest is Some(d)
                if byte_result
                    out.push(s"  %v$d = icmp ne i8 %t$next, 0\n")
                    next += 1
        Call(dest, CFunction(symbol, params, result), args) ->
            // A C function takes no context. A `float` is rounded from the `real` carrying it on the
            // way in, and widened back on the way out.
            var parts = ""
            for i in 0..<args.len()
                val a = args[i]
                if i > 0 then parts = parts + ", "
                if params[i] is CBinary32
                    out.push(s"  %t$next = fptrunc double " + operand(program, f, a) + " to float\n")
                    parts = parts + s"float %t$next"
                    next += 1
                else parts = parts + foreign_type(params[i]) + foreign_extension(params[i]) + " " + operand(program, f, a)
            val widened = result is Some(CBinary32)
            out.push("  ")
            if dest is Some(d)
                if widened then out.push(s"%t$next = ") else out.push(s"%v$d = ")
            out.push("call " + foreign_result(result) + " @" + symbol + "(" + parts + ")\n")
            if dest is Some(d)
                if widened
                    out.push(s"  %v$d = fpext float %t$next to double\n")
                    next += 1
    next

// A C scalar's type in LLVM.
private foreign_type(s: CScalar) -> string = s match
    CSigned(bits) -> s"i$bits"
    CUnsigned(bits) -> s"i$bits"
    CBoolean -> "i1"
    CBinary64 -> "double"
    CBinary32 -> "float"
    CAddress -> "ptr"

// How a C scalar narrower than 32 bits is widened in a register with the C convention: a signed
// integer sign-extended, an unsigned one and a bool zero-extended.
private foreign_extension(s: CScalar) -> string = s match
    CSigned(bits) -> if bits < 32 then " signext" else ""
    CUnsigned(bits) -> if bits < 32 then " zeroext" else ""
    CBoolean -> " zeroext"
    _ -> ""

// A C function's result as a declaration and a call write it: its extension, then its type.
private foreign_result(result: Option[CScalar]) -> string = result match
    Some(s) -> (if foreign_extension(s) == "" then "" else foreign_extension(s)[1..] + " ") + foreign_type(s)
    None -> "void"

private operand_type(program: MirProgram, f: MirFunction, a: Operand) -> MirType = a match
    Value(id) -> f.value_types[id]
    ConstInt(bits, _) -> MInt(bits)
    ConstBool(_) -> MBool
    ConstReal(_) -> MReal
    SlotAddress(_) -> MPtr
    ConstStr(_) -> MRef
    ConstObject(_) -> MRef
    ConstData(_, _) -> MRef
    ConstClosure(_) -> MRef
    FunctionAddress(_) -> MPtr
    GlobalAddress(_) -> MPtr
    RecordAddress(_) -> MPtr
    DescriptorAddress(_) -> MPtr
    NullAddress -> MPtr
    TrapSiteAddress(_) -> MPtr
    CallerSite -> MPtr
    OwnerWord -> MPtr
    ClosureRunner -> MPtr
    TrampolineAddress(_) -> MPtr

private operand(program: MirProgram, f: MirFunction, a: Operand) -> string = a match
    Value(id) -> s"%v$id"
    ConstInt(_, digits) -> digits
    ConstBool(value) -> if value then "true" else "false"
    ConstReal(value) -> real_constant(value)
    SlotAddress(slot) -> s"%s$slot"
    ConstObject(descriptor) -> payload_address(s"@avin.obj.$descriptor")
    ConstData(index, _) -> payload_address(s"@avin.data.$index")
    ConstStr(index) -> payload_address(s"@avin.str.$index")
    ConstClosure(index) -> payload_address(s"@avin.fn.$index")
    FunctionAddress(function) -> c_wrapper_name(program, function)
    GlobalAddress(index) -> global_address(program, index)
    RecordAddress(index) -> s"@avin.type.$index"
    DescriptorAddress(descriptor) -> s"@avin.desc.$descriptor"
    NullAddress -> "null"
    TrapSiteAddress(site) -> s"@avin.trap.$site"
    CallerSite -> "%caller.site"
    OwnerWord -> "%owner.word"
    ClosureRunner -> "@avin.run_closure"
    TrampolineAddress(i) -> s"@avin.c.trampoline.$i"

// A module-level value that holds a reference is a slot of the roots frame; any other is a global
// of its own.
private global_address(program: MirProgram, index: usize) -> string
    if !(program.globals[index] is Some(MRef)) then return s"@avin.global.$index"
    var slot = 0usize
    for i in 0..<index
        if program.globals[i] is Some(MRef) then slot += 1
    val n = root_count(program)
    s"getelementptr inbounds ({ ptr, i64, [$n x ptr] }, ptr @avin.roots, i64 0, i32 2, i64 $slot)"

private root_count(program: MirProgram) -> usize
    var n = 0usize
    for t in program.globals
        if t is Some(MRef) then n += 1
    n

private typed_operand(program: MirProgram, f: MirFunction, a: Operand) -> string =
    llvm_type(operand_type(program, f, a)) + " " + operand(program, f, a)

// Memory another thread can reach, a field of an object, an element of an array or a module-level
// value, is accessed with unordered atomic loads and stores, so a racing load returns a value some
// store wrote and never one nothing wrote. The function's own slots, and its callers' slots whose
// addresses a local function is passed as parameters, belong to one thread and are accessed plainly.
private is_shared(f: MirFunction, address: Operand) -> bool = address match
    Value(id) -> !(id < f.signature.params.len() && f.value_types[id] is MPtr)
    GlobalAddress(_) -> true
    ConstStr(_) -> true
    ConstObject(_) -> true
    ConstData(_, _) -> true
    _ -> false

// The width in bits an integer or bool is stored at: a whole power-of-two number of bytes up to a
// word, as fields and array elements are laid out. An atomic access is made at that width, so a bool
// is a byte and an `i5` is a byte, and the value is truncated after a load and zero-extended before a
// store.
private storage_bits(t: MirType) -> u32 = t match
    MBool -> 8
    MInt(bits) -> if bits <= 8 then 8 elif bits <= 16 then 16 elif bits <= 32 then 32 else 64
    _ -> 64

// A shared load into `dest`. An integer wider than 64 bits is loaded a word at a time, lowest word
// first, so each word is untorn while a racing load may combine words of different stores.
private load_shared(out: *StrBuilder, dest: string, t: MirType, address: string)
    val ty = llvm_type(t)
    t match
        MInt(bits) ->
            if bits > 64
                val words = usize((bits + 63) / 64)
                var acc = ""
                for k in 0..<words
                    val p = dest + s".p$k"
                    val word = dest + s".w$k"
                    val wide = dest + s".z$k"
                    out.push(s"  $p = getelementptr inbounds i64, ptr $address, i64 $k\n")
                    out.push(s"  $word = load atomic i64, ptr $p unordered, align 8\n")
                    out.push(s"  $wide = zext i64 $word to $ty\n")
                    if k == 0 then acc = wide
                    else
                        val shifted = dest + s".s$k"
                        out.push(s"  $shifted = shl $ty $wide, ${64 * k}\n")
                        val combined = if k + 1 == words then dest else dest + s".o$k"
                        out.push(s"  $combined = or $ty $acc, $shifted\n")
                        acc = combined
                return
        _ -> ()
    val w = storage_bits(t)
    val exact = t match
        MInt(bits) -> bits == w
        MBool -> false
        _ -> true
    if exact then out.push(s"  $dest = load atomic $ty, ptr $address unordered, align ${w / 8}\n")
    else
        val raw = dest + ".raw"
        out.push(s"  $raw = load atomic i$w, ptr $address unordered, align ${w / 8}\n")
        out.push(s"  $dest = trunc i$w $raw to $ty\n")

// A shared store of `value`, naming its temporaries after `temp`. An integer wider than 64 bits is
// stored a word at a time, lowest word first.
private store_shared(out: *StrBuilder, temp: string, t: MirType, value: string, address: string)
    val ty = llvm_type(t)
    t match
        MInt(bits) ->
            if bits > 64
                val words = usize((bits + 63) / 64)
                for k in 0..<words
                    var part = value
                    if k > 0
                        part = temp + s".h$k"
                        out.push(s"  $part = lshr $ty $value, ${64 * k}\n")
                    val word = temp + s".w$k"
                    val p = temp + s".p$k"
                    out.push(s"  $word = trunc $ty $part to i64\n")
                    out.push(s"  $p = getelementptr inbounds i64, ptr $address, i64 $k\n")
                    out.push(s"  store atomic i64 $word, ptr $p unordered, align 8\n")
                return
        _ -> ()
    val w = storage_bits(t)
    val exact = t match
        MInt(bits) -> bits == w
        MBool -> false
        _ -> true
    if exact then out.push(s"  store atomic $ty $value, ptr $address unordered, align ${w / 8}\n")
    else
        val raw = temp + ".raw"
        out.push(s"  $raw = zext $ty $value to i$w\n")
        out.push(s"  store atomic i$w $raw, ptr $address unordered, align ${w / 8}\n")

// An `Atomic`'s value is accessed at its storage width, as a shared field is, and every access is
// sequentially consistent. A real is accessed as the 64 bits of its encoding, since LLVM compares and
// exchanges only integers and addresses, and a bool or a narrow integer is widened to its storage
// width. An integer wider than 64 bits has no single atomic access on the machines Avin targets, so
// every operation on one is made under the runtime's lock for wide atomics, which they all take.
private atomic_type(t: MirType) -> string = t match
    MRef -> "ptr"
    _ -> s"i${storage_bits(t)}"

private atomic_alignment(t: MirType) -> string = s"align ${storage_bits(t) / 8}"

private is_wide(t: MirType) -> bool = t match
    MInt(bits) -> bits > 64
    _ -> false

// Whether a value of `t` differs from the word it is stored as.
private converts_to_word(t: MirType) -> bool = t match
    MReal -> true
    MBool -> true
    MInt(bits) -> bits != storage_bits(t)
    _ -> false

// `value` as the word it is stored as, in a temporary named `temp` where it needs converting.
private to_word(out: *StrBuilder, temp: string, t: MirType, value: string) -> string
    if !converts_to_word(t) then return value
    if t is MReal then out.push(s"  $temp = bitcast double $value to i64\n")
    else out.push(s"  $temp = zext ${llvm_type(t)} $value to i${storage_bits(t)}\n")
    temp

// Where an access yielding a value of `t` into `dest` puts the word it reads.
private word_dest(t: MirType, dest: string) -> string = if converts_to_word(t) then dest + ".word" else dest

// Makes `dest` the value of the word an access put at `word_dest`.
private from_word(out: *StrBuilder, t: MirType, dest: string)
    if !converts_to_word(t) then return
    val word = dest + ".word"
    if t is MReal then out.push(s"  $dest = bitcast i64 $word to double\n")
    else out.push(s"  $dest = trunc i${storage_bits(t)} $word to ${llvm_type(t)}\n")

// Takes or gives back the runtime's lock for atomics wider than a word.
private wide_atomic(out: *StrBuilder, intrinsics: *Buf[string], step: string)
    need(intrinsics, s"declare void @avin_rt_wide_atomic_$step()")
    out.push(s"  call void @avin_rt_wide_atomic_$step()\n")

private emit_atomic_load(out: *StrBuilder, intrinsics: *Buf[string], t: MirType, dest: string, address: string)
    if is_wide(t)
        wide_atomic(out, intrinsics, "begin")
        load_shared(out, dest, t, address)
        wide_atomic(out, intrinsics, "end")
        return
    out.push(s"  ${word_dest(t, dest)} = load atomic ${atomic_type(t)}, ptr $address seq_cst, ${atomic_alignment(t)}\n")
    from_word(out, t, dest)

private emit_atomic_store(out: *StrBuilder, intrinsics: *Buf[string], temp: string, t: MirType, value: string, address: string)
    if is_wide(t)
        wide_atomic(out, intrinsics, "begin")
        store_shared(out, temp, t, value, address)
        wide_atomic(out, intrinsics, "end")
        return
    val word = to_word(out, temp + ".in", t, value)
    out.push(s"  store atomic ${atomic_type(t)} $word, ptr $address seq_cst, ${atomic_alignment(t)}\n")

private emit_atomic_swap(out: *StrBuilder, intrinsics: *Buf[string], temp: string, t: MirType, dest: string, value: string, address: string)
    if is_wide(t)
        wide_atomic(out, intrinsics, "begin")
        load_shared(out, dest, t, address)
        store_shared(out, temp, t, value, address)
        wide_atomic(out, intrinsics, "end")
        return
    val word = to_word(out, temp + ".in", t, value)
    out.push(s"  ${word_dest(t, dest)} = atomicrmw xchg ptr $address, ${atomic_type(t)} $word seq_cst, ${atomic_alignment(t)}\n")
    from_word(out, t, dest)

// A compare-and-set compares the stored words: the same object for a reference, the same bits for a
// scalar.
private emit_atomic_compare_set(out: *StrBuilder, intrinsics: *Buf[string], temp: string, t: MirType, dest: string, expected: string, desired: string, address: string)
    if is_wide(t)
        val ty = llvm_type(t)
        val seen = temp + ".seen"
        val kept = temp + ".kept"
        wide_atomic(out, intrinsics, "begin")
        load_shared(out, seen, t, address)
        out.push(s"  $dest = icmp eq $ty $seen, $expected\n")
        out.push(s"  $kept = select i1 $dest, $ty $desired, $ty $seen\n")
        store_shared(out, temp, t, kept, address)
        wide_atomic(out, intrinsics, "end")
        return
    val ty = atomic_type(t)
    val e = to_word(out, temp + ".e", t, expected)
    val d = to_word(out, temp + ".d", t, desired)
    out.push(s"  $temp = cmpxchg ptr $address, $ty $e, $ty $d seq_cst seq_cst, ${atomic_alignment(t)}\n")
    out.push(s"  $dest = extractvalue { $ty, i1 } $temp, 1\n")

// Fields sit at multiples of 8 bytes, so an integer wider than 64 bits is accessed at that alignment
// rather than its natural one; every other type's natural alignment is at most 8.
private alignment(t: MirType) -> string = t match
    MInt(bits) -> if bits > 64 then ", align 8" else ""
    _ -> ""

// LLVM spells a double exactly as the hexadecimal digits of its encoding.
private real_constant(value: real) -> string
    val hex = "0123456789ABCDEF"
    val bits = value.bits()
    var out = "0x"
    var shift = 60
    while shift >= 0
        out = out + char(hex.bytes[usize((bits >> ulong(shift)) & 15)]).to_string()
        shift -= 4
    out
