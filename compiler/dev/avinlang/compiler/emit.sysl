module dev.avinlang.compiler

import sysl.buf.{Buf, buf}
import sysl.text.{StrBuilder, str_builder}

// Spells a MIR program as LLVM IR. Every decision about types, layout and control flow has already
// been made; this file only writes it down.
//
// Every function of the program, every closure entry and every runtime entry point takes the running
// thread's context as a hidden first argument, `%ctx`. Its first word is the top of that thread's
// shadow stack, which a function links its frame of roots into directly, without calling the runtime.

/** The program's LLVM module. Its `main` gets the main thread's context from the runtime, runs the
 * program's entry function and returns its result as the exit status, or zero for an entry function
 * that returns nothing. */
emit_llvm(program: MirProgram) -> string
    var out = str_builder()
    out.push("; Avin program\n\n")
    // Every descriptor begins with the collector's kind, whose tracer is the runtime's.
    out.push("declare void @avin_rt_trace(ptr, ptr)\n")
    out.push("declare void @avin_rt_trace_array(ptr, ptr)\n\n")
    // A string literal is a constant object laid out as the runtime lays out a string: a header
    // naming a descriptor that holds no references and no type record, the length in bytes, then the
    // bytes.
    if program.strings.len() > 0
        out.push(s"@avin.desc.string = private constant { $KindType, i64, i64, i64, ptr } { $KindValue, i64 0, i64 8, i64 0, ptr null }\n")
    for i in 0..<program.strings.len()
        val text = program.strings[i]
        val n = text.bytes.len
        out.push(s"@avin.str.$i.const = private constant { ptr, i64, i64, [$n x i8] } { ptr @avin.desc.string, i64 0, i64 $n, [$n x i8] c\"")
        push_bytes(&out, text)
        out.push("\" }, align 16\n")
        constant_payload(&out, s"@avin.str.$i")
    out.push("\n")
    for i in 0..<program.descriptors.len()
        emit_descriptor(&out, program, i)
    // A type record is the number of the type's ancestors and their records' addresses.
    for i in 0..<program.records.len()
        val r = program.records[i]
        val n = r.ancestors.len()
        out.push(s"; type ${r.name}\n@avin.type.$i = private constant { i64, [$n x ptr] } { i64 $n, [$n x ptr] ")
        if n == 0 then out.push("zeroinitializer")
        else
            out.push("[")
            for j in 0..<n
                if j > 0 then out.push(", ")
                out.push(s"ptr @avin.type.${r.ancestors[j]}")
            out.push("]")
        out.push(" }, align 8\n")
    // A closure that captures nothing is constant: a header naming its descriptor, then its entry's
    // address.
    for i in 0..<program.closures.len()
        val k = program.closures[i]
        out.push(s"@avin.fn.$i.const = private constant { ptr, i64, ptr } { ptr @avin.desc.${k.descriptor}, i64 0, ptr @\"${program.functions[k.function].symbol}\" }, align 16\n")
        constant_payload(&out, s"@avin.fn.$i")
    // A trap site is what the runtime reports when the program stops there: the reason and the file
    // as constant strings, then the line and column.
    for i in 0..<program.traps.len()
        val t = program.traps[i]
        out.push(s"@avin.trap.$i = private constant { ptr, ptr, i64, i64 } { ptr @avin.str.${t.reason}, ptr @avin.str.${t.file}, i64 ${t.line}, i64 ${t.col} }, align 8\n")
    // The module-level values that hold references are the slots of one frame, laid out as a
    // function's shadow-stack frame is, which `main` gives the runtime as a root of every
    // collection. Each other value is a global of its own. All start zero, before `main` initializes
    // them.
    val roots = root_count(program)
    if roots > 0
        out.push(s"@avin.roots = private global { ptr, i64, [$roots x ptr] } { ptr null, i64 $roots, [$roots x ptr] zeroinitializer }, align 8\n")
    for i in 0..<program.globals.len()
        program.globals[i] match
            Some(MRef) -> ()
            Some(t) -> out.push(s"@avin.global.$i = private global ${llvm_type(t)} zeroinitializer, align 8\n")
            None -> ()
    out.push("\n")
    var declared: Buf[string] = buf()
    for f in program.functions
        for block in f.blocks
            for inst in block.insts
                inst match
                    Call(_, Runtime(symbol, signature), _) ->
                        if !contains(declared, symbol)
                            declared.push(symbol)
                            out.push("declare " + c_result(signature) + " @" + symbol + "(" + c_params(signature) + ")\n")
                    _ -> ()
    out.push("\n")
    var intrinsics: Buf[string] = buf()
    val graph = call_graph(program)
    for i in 0..<program.functions.len()
        emit_function(&out, &intrinsics, program, graph, i)
    for declaration in intrinsics
        out.push(declaration + "\n")
    out.push("\n")
    val entry = program.functions[program.entry]
    out.push("declare ptr @avin_rt_start()\n")
    if roots > 0 then out.push("declare void @avin_rt_globals(ptr)\n")
    out.push("\ndefine i32 @main() {\nentry:\n")
    out.push("  %ctx = call ptr @avin_rt_start()\n")
    // The module-level values are roots before the first of them is stored, and are all
    // initialized before the entry runs.
    if roots > 0 then out.push("  call void @avin_rt_globals(ptr @avin.roots)\n")
    if program.init is Some(init) then out.push(s"  call void @\"${program.functions[init].symbol}\"(ptr %ctx)\n")
    entry.signature.result match
        Some(MInt(bits)) ->
            out.push(s"  %result = call i$bits @\"${entry.symbol}\"(ptr %ctx)\n")
            if bits < 32 then out.push(s"  %status = sext i$bits %result to i32\n  ret i32 %status\n")
            elif bits > 32 then out.push(s"  %status = trunc i$bits %result to i32\n  ret i32 %status\n")
            else out.push("  ret i32 %result\n")
        _ ->
            out.push(s"  call ${result_type(entry.signature)} @\"${entry.symbol}\"(ptr %ctx)\n")
            out.push("  ret i32 0\n")
    out.push("}\n")
    out.finish()

private contains(items: Buf[string], value: string) -> bool
    for item in items
        if item == value then return true
    false

// LLVM string constants escape everything outside printable ASCII, and `"` and `\`, as `\XX`.
private push_bytes(out: *StrBuilder, text: string)
    val hex = "0123456789ABCDEF"
    for b in text.bytes
        if b >= 32 && b < 127 && b != u8('"') && b != u8('\\') then out.push_char(char(b))
        else
            out.push_char('\\')
            out.push_char(char(hex.bytes[usize(b >> 4)]))
            out.push_char(char(hex.bytes[usize(b & 15)]))

private llvm_type(t: MirType) -> string = t match
    MInt(bits) -> s"i$bits"
    MBool -> "i1"
    MReal -> "double"
    MPtr -> "ptr"
    MRef -> "ptr"

private result_type(s: MirSignature) -> string = s.result match
    Some(t) -> llvm_type(t)
    None -> "void"

// The runtime is called with the C convention, so a bool is passed as a byte.
private c_type(t: MirType) -> string = t match
    MInt(bits) -> s"i$bits"
    MBool -> "i8"
    MReal -> "double"
    MPtr -> "ptr"
    MRef -> "ptr"

private c_result(s: MirSignature) -> string = s.result match
    Some(t) -> c_type(t)
    None -> "void"

// The context comes first, then the declared parameters.
private c_params(s: MirSignature) -> string
    var out = "ptr"
    for t in s.params
        out = out + ", " + c_type(t)
    out

private emit_function(out: *StrBuilder, intrinsics: *Buf[string], program: MirProgram, graph: CallGraph, index: usize)
    val f = program.functions[index]
    out.push("define " + result_type(f.signature) + " @\"" + f.symbol + "\"(ptr %ctx")
    for i in 0..<f.signature.params.len()
        out.push(", " + llvm_type(f.signature.params[i]) + s" %v$i")
    out.push(") {\n")
    // Every reference the function holds is a root: each slot of reference type lives in the
    // function's frame on the shadow stack, and each reference value is stored to a frame slot of
    // its own as soon as it exists, so a collection at any call finds all of them. The frame's first
    // word links it to the caller's frame; the context's first word is the top frame, which the
    // function sets to its own on entry and gives back to the caller's on every return.
    var value_roots: Buf[Option[usize]] = buf()
    var roots = 0usize
    for s in f.slots
        if s is MRef then roots += 1
    for t in f.value_types
        if t is MRef
            value_roots.push(Some(roots))
            roots += 1
        else value_roots.push(None)
    val frame = s"{ ptr, i64, [$roots x ptr] }"
    var temp = 0usize
    var polls = 0usize
    val back = back_edges(f)
    val polled_on_entry = polled_before(graph, index, f)
    for b in 0..<f.blocks.len()
        out.push(s"b$b:\n")
        if b == 0
            if roots > 0
                need(intrinsics, "declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)")
                out.push(s"  %frame = alloca $frame\n")
                out.push(s"  call void @llvm.memset.p0.i64(ptr %frame, i8 0, i64 ${16 + 8 * roots}, i1 false)\n")
                out.push(s"  %frame.count = getelementptr inbounds $frame, ptr %frame, i32 0, i32 1\n")
                out.push(s"  store i64 $roots, ptr %frame.count\n")
                for k in 0..<roots
                    out.push(s"  %root$k = getelementptr inbounds $frame, ptr %frame, i32 0, i32 2, i64 $k\n")
                out.push("  %caller = load ptr, ptr %ctx\n")
                out.push("  store ptr %caller, ptr %frame\n")
                out.push("  store ptr %frame, ptr %ctx\n")
            var next_root = 0usize
            for s in 0..<f.slots.len()
                if f.slots[s] is MRef
                    out.push(s"  %s$s = getelementptr inbounds $frame, ptr %frame, i32 0, i32 2, i64 $next_root\n")
                    next_root += 1
                else out.push(s"  %s$s = alloca ${llvm_type(f.slots[s])}\n")
            for i in 0..<f.signature.params.len()
                if value_roots[i] is Some(k) then out.push(s"  store ptr %v$i, ptr %root$k\n")
        val block = f.blocks[b]
        var polled = polled_on_entry[b]
        for inst in block.insts
            if !polled && closes_cycle(graph, index, inst)
                polls = emit_poll(out, intrinsics, polls)
                polled = true
            temp = emit_inst(out, intrinsics, program, f, inst, temp)
            if inst_dest(inst) is Some(d)
                if value_roots[d] is Some(k) then out.push(s"  store ptr %v$d, ptr %root$k\n")
        if back[b] then polls = emit_poll(out, intrinsics, polls)
        if block.term is Return(_)
            if roots > 0 then out.push("  store ptr %caller, ptr %ctx\n")
        block.term match
            Return(Some(value)) -> out.push("  ret " + typed_operand(program, f, value) + "\n")
            Return(None) -> out.push("  ret void\n")
            Jump(target) -> out.push(s"  br label %b$target\n")
            Branch(condition, yes, no) -> out.push("  br i1 " + operand(program, f, condition) + s", label %b$yes, label %b$no\n")
            Trap(site) ->
                // The runtime flushes the program's output, reports the site and stops.
                need(intrinsics, "declare void @avin_rt_trap(ptr, ptr) noreturn cold")
                out.push(s"  call void @avin_rt_trap(ptr %ctx, ptr @avin.trap.$site)\n  unreachable\n")
            Unreachable -> out.push("  unreachable\n")
    out.push("}\n\n")

// A safepoint poll: when a collection has asked the other threads to stop, the runtime parks this one
// until the collection is over. Every reference the function holds is already in its frame, so the
// stack is consistent wherever a poll is placed. The flag is read with a relaxed atomic load and the
// slow path is a call to a cold function behind a branch weighted as almost never taken, so the
// common case is one load and a branch that falls through, and the slow path is laid out of line.
// Polls are placed before every terminator with a back edge, which every cycle of the control flow
// has, and before a call that may close a cycle of the call graph, which every recursion makes once
// per level (see `polled_before`). A call that cannot recurse needs none: its callee runs for a
// bounded time between its own polls. `n` numbers the poll within its function; the next number is
// answered.
private emit_poll(out: *StrBuilder, intrinsics: *Buf[string], n: usize) -> usize
    need(intrinsics, "@avin_rt_requested = external global i32")
    need(intrinsics, "declare void @avin_rt_safepoint(ptr) cold")
    need(intrinsics, Unlikely)
    out.push(s"  %poll$n = load atomic i32, ptr @avin_rt_requested monotonic, align 4\n")
    out.push(s"  %stop$n = icmp ne i32 %poll$n, 0\n")
    out.push(s"  br i1 %stop$n, label %park$n, label %run$n, !prof !0\n")
    out.push(s"park$n:\n  call void @avin_rt_safepoint(ptr %ctx)\n  br label %run$n\n")
    out.push(s"run$n:\n")
    n + 1

private successors(term: Terminator) -> Buf[usize]
    var out: Buf[usize] = buf()
    term match
        Jump(target) -> out.push(target)
        Branch(_, yes, no) ->
            out.push(yes)
            out.push(no)
        _ -> ()
    out

// For each block of `f`, whether its terminator has a back edge: an edge to a block on the
// depth-first path from the entry to it. Every cycle of the control flow contains one, whatever order
// the blocks are numbered in, and an `if`'s join is never reached by one.
private back_edges(f: MirFunction) -> Buf[bool]
    // 0: not reached yet; 1: on the current path; 2: finished.
    var state: Buf[u8] = buf()
    var back: Buf[bool] = buf()
    for _ in 0..<f.blocks.len()
        state.push(0)
        back.push(false)
    if f.blocks.len() == 0 then return back
    // The path, and for each block on it the index of the successor to follow next.
    var path: Buf[usize] = buf()
    var next: Buf[usize] = buf()
    path.push(0)
    next.push(0)
    state[0] = 1
    while path.len() > 0
        val top = path.len() - 1
        val b = path[top]
        val succ = successors(f.blocks[b].term)
        if next[top] < succ.len()
            val s = succ[next[top]]
            next[top] += 1
            if state[s] == 1 then back[b] = true
            else if state[s] == 0
                state[s] = 1
                path.push(s)
                next.push(0)
        else
            state[b] = 2
            _ = path.pop()
            _ = next.pop()
    back

/** The branch weights of a poll: taken once in about a million. A poll's branch is the module's only
 * metadata, so it is number 0. */
private const Unlikely: string = "!0 = !{!\"branch_weights\", i32 1, i32 1048575}"

/** Which calls of the program can recur. Functions are grouped into the strongly connected
 * components of the call graph, where a function calls each function it calls directly and, if it
 * calls through a function value, every function whose address is taken: every closure entry and
 * every method-table entry. A call can be part of a recursion exactly when its callee is in the
 * caller's component. Runtime entry points and the shims of Sysl bindings never call compiled code,
 * so they add no edges; a binding that takes an Avin function would add one to every function whose
 * address is taken. */
private struct CallGraph
    /** The component of each function. */
    component: Buf[usize]
    /** For each component, whether one of its functions has its address taken, so that a call
     * through a function value from that component may come back to it. */
    reentered: Buf[bool]

private call_graph(program: MirProgram) -> CallGraph
    val n = program.functions.len()
    var taken: Buf[bool] = buf()
    for _ in 0..<n do taken.push(false)
    for k in program.closures do taken[k.function] = true
    for d in program.descriptors
        for m in d.methods
            if m is Some(g) then taken[g] = true
    for f in program.functions
        for block in f.blocks
            for inst in block.insts
                for o in inst_operands(inst) do take(&taken, o)
            if block.term is Return(Some(o)) then take(&taken, o)
            if block.term is Branch(o, _, _) then take(&taken, o)
    var targets: Buf[usize] = buf()
    for g in 0..<n
        if taken[g] then targets.push(g)
    // The edges of function `v` are `edges[starts[v]..<starts[v + 1]]`.
    var starts: Buf[usize] = buf()
    var edges: Buf[usize] = buf()
    for f in program.functions
        starts.push(edges.len())
        var indirect = false
        for block in f.blocks
            for inst in block.insts
                inst match
                    Call(_, Direct(g), _) -> edges.push(g)
                    Call(_, Indirect(_, _), _) -> indirect = true
                    _ -> ()
        if indirect
            for g in targets do edges.push(g)
    starts.push(edges.len())
    val component = components(n, starts, edges)
    var reentered: Buf[bool] = buf()
    for _ in 0..<n do reentered.push(false)
    for g in targets do reentered[component[g]] = true
    CallGraph(component, reentered)

private take(taken: *Buf[bool], o: Operand)
    if o is FunctionAddress(g) then (*taken)[g] = true

private inst_operands(inst: Inst) -> Buf[Operand]
    var out: Buf[Operand] = buf()
    inst match
        Call(_, callee, args) ->
            if callee is Indirect(target, _) then out.push(target)
            for a in args do out.push(a)
        Binary(_, _, left, right) ->
            out.push(left)
            out.push(right)
        Checked(_, _, _, left, right) ->
            out.push(left)
            out.push(right)
        Compare(_, _, left, right) ->
            out.push(left)
            out.push(right)
        Select(_, condition, yes, no) ->
            out.push(condition)
            out.push(yes)
            out.push(no)
        Convert(_, _, value) -> out.push(value)
        Load(_, address) -> out.push(address)
        Store(address, value) ->
            out.push(address)
            out.push(value)
        Alloc(_, _) -> ()
        Offset(_, base, _) -> out.push(base)
        Index(_, base, index) ->
            out.push(base)
            out.push(index)
        DescriptorOf(_, object) -> out.push(object)
        MethodSlot(_, object, _) -> out.push(object)
    out

// The strongly connected components of a graph of `n` vertices, numbered from 0, by Tarjan's
// algorithm with an explicit stack of the vertices being visited.
private components(n: usize, starts: Buf[usize], edges: Buf[usize]) -> Buf[usize]
    // The visit order of each vertex, from 1; 0 is not visited yet.
    var order: Buf[usize] = buf()
    var low: Buf[usize] = buf()
    var on_stack: Buf[bool] = buf()
    var component: Buf[usize] = buf()
    for _ in 0..<n
        order.push(0)
        low.push(0)
        on_stack.push(false)
        component.push(0)
    var stack: Buf[usize] = buf()
    // The vertices being visited, and for each the position of its next edge.
    var path: Buf[usize] = buf()
    var next: Buf[usize] = buf()
    var visited = 0usize
    var found = 0usize
    for root in 0..<n
        if order[root] == 0
            visited += 1
            order[root] = visited
            low[root] = visited
            stack.push(root)
            on_stack[root] = true
            path.push(root)
            next.push(starts[root])
            while path.len() > 0
                val top = path.len() - 1
                val v = path[top]
                if next[top] < starts[v + 1]
                    val w = edges[next[top]]
                    next[top] += 1
                    if order[w] == 0
                        visited += 1
                        order[w] = visited
                        low[w] = visited
                        stack.push(w)
                        on_stack[w] = true
                        path.push(w)
                        next.push(starts[w])
                    elif on_stack[w] && order[w] < low[v] then low[v] = order[w]
                else
                    _ = path.pop()
                    _ = next.pop()
                    if low[v] == order[v]
                        var done = false
                        while !done
                            val w = stack.pop().unwrap()
                            on_stack[w] = false
                            component[w] = found
                            done = w == v
                        found += 1
                    if path.len() > 0
                        val u = path[path.len() - 1]
                        if low[v] < low[u] then low[u] = low[v]
    component

// Whether `inst`, in function `caller`, is a call that may close a cycle of the call graph.
private closes_cycle(graph: CallGraph, caller: usize, inst: Inst) -> bool = inst match
    Call(_, Direct(g), _) -> graph.component[g] == graph.component[caller]
    Call(_, Indirect(_, _), _) -> graph.reentered[graph.component[caller]]
    _ -> false

// For each block of function `index`, whether a poll has run in this call of it on every path from
// the entry to the block. A call that may close a cycle needs a poll before it only where none has:
// every level of a recursion then still polls once on the way to the next, since every path to the
// call passes a poll, and the time between that poll and the call is bounded by the code between them,
// the calls they make, which poll for themselves, and loops, which poll on their back edges. A
// function that recurses on only some paths polls only on those, and its leaf calls never poll.
private polled_before(graph: CallGraph, index: usize, f: MirFunction) -> Buf[bool]
    val n = f.blocks.len()
    var polled: Buf[bool] = buf()
    var polls: Buf[bool] = buf()
    for b in 0..<n
        polled.push(b != 0)
        var any = false
        for inst in f.blocks[b].insts
            if closes_cycle(graph, index, inst) then any = true
        polls.push(any)
    // A block's value only ever falls from true to false, so the walk reaches a fixed point.
    var changed = true
    while changed
        changed = false
        for b in 0..<n
            if !polled[b] && !polls[b]
                for s in successors(f.blocks[b].term)
                    if polled[s]
                        polled[s] = false
                        changed = true
    polled

// A descriptor is the collector's kind, then the header the runtime reads (tag, size, reference
// count, type record), then the reference offsets. An object's descriptor is the kind the collector keeps in its
// header, `KindBack` bytes before the object. A class's method table sits directly before its
// descriptor, in the same constant, so slot `s` is the word 8(s + 1) bytes before the descriptor;
// `@avin.desc.N` names the descriptor's address. An abstract method's slot is null: no object of its
// class exists. A variant with no field data is one constant object, which is only its header.
private emit_descriptor(out: *StrBuilder, program: MirProgram, i: usize)
    val d = program.descriptors[i]
    val n = d.refs.len()
    val header = s"{ $KindType, i64, i64, i64, ptr, [$n x i64] }"
    var body = str_builder()
    val kind = if d.elements then ArrayKindValue else KindValue
    body.push(s"{ $kind, i64 ${d.tag}, i64 ${d.size}, i64 $n, ptr @avin.type.${d.record}, [$n x i64] ")
    if n == 0 then body.push("zeroinitializer")
    else
        body.push("[")
        for j in 0..<n
            if j > 0 then body.push(", ")
            body.push(s"i64 ${d.refs[j]}")
        body.push("]")
    body.push(" }")
    val value = body.finish()
    val m = d.methods.len()
    if m == 0 then out.push(s"; ${d.name}\n@avin.desc.$i = private constant $header $value\n")
    else
        val whole = s"{ [$m x ptr], $header }"
        out.push(s"; ${d.name}\n@avin.methods.$i = private constant $whole { [$m x ptr] [")
        for j in 0..<m
            if j > 0 then out.push(", ")
            d.methods[m - 1 - j] match
                Some(f) -> out.push("ptr @\"" + program.functions[f].symbol + "\"")
                None -> out.push("ptr null")
        out.push(s"], $header $value }, align 8\n")
        out.push(s"@avin.desc.$i = private alias $header, ptr getelementptr inbounds ($whole, ptr @avin.methods.$i, i32 0, i32 1)\n")
    if d.constant
        out.push(s"@avin.obj.$i.const = private constant { ptr, i64 } { ptr @avin.desc.$i, i64 0 }, align 16\n")
        constant_payload(out, s"@avin.obj.$i")

/** The collector's `Kind` as a descriptor begins with it: the runtime's tracer, and no finalizer,
 * weak hook or ephemeron hook. */
private const KindType: string = "{ ptr, ptr, ptr, ptr }"
private const KindValue: string = "{ ptr, ptr, ptr, ptr } { ptr @avin_rt_trace, ptr null, ptr null, ptr null }"
/** The kind of an array whose elements are references: the runtime's array tracer marks each one. */
private const ArrayKindValue: string = "{ ptr, ptr, ptr, ptr } { ptr @avin_rt_trace_array, ptr null, ptr null, ptr null }"

/** How far before an object its descriptor is: the collector's `KIND_BACK`, two words. A constant
 * object outside the heap is laid out with those two words ahead of it, its descriptor and a word
 * left zero, which the collector never reads for an object it does not own. */
private const KindBack: usize = 16

// Names the payload of the constant object `name.const`, which follows its two header words, as
// `name`: every reference to the object is to its payload.
private constant_payload(out: *StrBuilder, name: string)
    out.push(s"$name = private alias i8, ptr getelementptr inbounds (i8, ptr $name.const, i64 $KindBack)\n")

/** The byte offset from a descriptor to the method in slot `slot` of the table before it. */
private method_slot_offset(slot: usize) -> string = "-" + ((slot + 1) * 8).to_string()

/** The value an instruction defines, if any. */
private inst_dest(inst: Inst) -> Option[usize] = inst match
    Call(dest, _, _) -> dest
    Binary(dest, _, _, _) -> Some(dest)
    Checked(dest, _, _, _, _) -> Some(dest)
    Compare(dest, _, _, _) -> Some(dest)
    Select(dest, _, _, _) -> Some(dest)
    Convert(dest, _, _) -> Some(dest)
    Load(dest, _) -> Some(dest)
    Store(_, _) -> None
    Alloc(dest, _) -> Some(dest)
    Offset(dest, _, _) -> Some(dest)
    Index(dest, _, _) -> Some(dest)
    DescriptorOf(dest, _) -> Some(dest)
    MethodSlot(dest, _, _) -> Some(dest)

private need(intrinsics: *Buf[string], declaration: string)
    if !contains(*intrinsics, declaration) then intrinsics.push(declaration)

private op_name(op: MirOp) -> string = op match
    OpAdd -> "add"
    OpSub -> "sub"
    OpMul -> "mul"
    OpDiv -> "sdiv"
    OpRem -> "srem"
    OpAnd -> "and"
    OpOr -> "or"
    OpXor -> "xor"
    OpShl -> "shl"
    OpAShr -> "ashr"
    OpLShr -> "lshr"
    OpFAdd -> "fadd"
    OpFSub -> "fsub"
    OpFMul -> "fmul"
    OpFDiv -> "fdiv"
    OpFRem -> "frem"
    _ -> ""

// Saturating operations are LLVM intrinsics; multiplication saturates as a fixed-point product
// with no fractional bits.
private saturating_name(op: MirOp) -> string = op match
    OpAddSat -> "sadd.sat"
    OpSubSat -> "ssub.sat"
    OpMulSat -> "smul.fix.sat"
    _ -> ""

private checked_name(op: MirChecked) -> string = op match
    CheckedAdd -> "sadd"
    CheckedSub -> "ssub"
    CheckedMul -> "smul"

private cmp_name(op: MirCmp) -> string = op match
    CmpEq -> "eq"
    CmpNe -> "ne"
    CmpLt -> "slt"
    CmpLe -> "sle"
    CmpGt -> "sgt"
    CmpGe -> "sge"
    CmpUge -> "uge"
    CmpUlt -> "ult"
    CmpUle -> "ule"
    CmpUgt -> "ugt"
    FEq -> "oeq"
    FNe -> "une"
    FLt -> "olt"
    FLe -> "ole"
    FGt -> "ogt"
    FGe -> "oge"

private is_real_cmp(op: MirCmp) -> bool = op match
    FEq -> true
    FNe -> true
    FLt -> true
    FLe -> true
    FGt -> true
    FGe -> true
    _ -> false

private conv_name(conv: MirConv) -> string = conv match
    SignExtend -> "sext"
    ZeroExtend -> "zext"
    Truncate -> "trunc"
    SignedToReal -> "sitofp"
    UnsignedToReal -> "uitofp"
    RealToInt -> "fptosi.sat"

private emit_inst(out: *StrBuilder, intrinsics: *Buf[string], program: MirProgram, f: MirFunction, inst: Inst, temp: usize) -> usize
    var next = temp
    inst match
        Binary(dest, op, left, right) ->
            val t = llvm_type(operand_type(program, f, left))
            val a = operand(program, f, left)
            val b = operand(program, f, right)
            val sat = saturating_name(op)
            if sat == ""
                out.push(s"  %v$dest = ${op_name(op)} $t $a, $b\n")
            else
                val scale = if op is OpMulSat then ", i32 0" else ""
                need(intrinsics, s"declare $t @llvm.$sat.$t($t, $t${if scale == "" then "" else ", i32"})")
                out.push(s"  %v$dest = call $t @llvm.$sat.$t($t $a, $t $b$scale)\n")
        Checked(dest, overflow, op, left, right) ->
            val t = llvm_type(operand_type(program, f, left))
            val name = s"llvm.${checked_name(op)}.with.overflow.$t"
            need(intrinsics, s"declare { $t, i1 } @$name($t, $t)")
            out.push(s"  %t$next = call { $t, i1 } @$name($t ${operand(program, f, left)}, $t ${operand(program, f, right)})\n")
            out.push(s"  %v$dest = extractvalue { $t, i1 } %t$next, 0\n")
            out.push(s"  %v$overflow = extractvalue { $t, i1 } %t$next, 1\n")
            next += 1
        Compare(dest, op, left, right) ->
            val instruction = if is_real_cmp(op) then "fcmp" else "icmp"
            out.push(s"  %v$dest = $instruction ${cmp_name(op)} " + typed_operand(program, f, left) + ", " + operand(program, f, right) + "\n")
        Convert(dest, conv, value) ->
            val to = llvm_type(f.value_types[dest])
            if conv is RealToInt
                need(intrinsics, s"declare $to @llvm.fptosi.sat.$to.f64(double)")
                out.push(s"  %v$dest = call $to @llvm.fptosi.sat.$to.f64(double " + operand(program, f, value) + ")\n")
            else out.push(s"  %v$dest = ${conv_name(conv)} " + typed_operand(program, f, value) + s" to $to\n")
        Select(dest, condition, yes, no) ->
            out.push(s"  %v$dest = select i1 " + operand(program, f, condition) + ", " + typed_operand(program, f, yes) + ", " + typed_operand(program, f, no) + "\n")
        Load(dest, address) ->
            val t = f.value_types[dest]
            out.push(s"  %v$dest = load ${llvm_type(t)}, ptr " + operand(program, f, address) + alignment(t) + "\n")
        Store(address, value) ->
            out.push("  store " + typed_operand(program, f, value) + ", ptr " + operand(program, f, address) + alignment(operand_type(program, f, value)) + "\n")
        Alloc(dest, descriptor) ->
            need(intrinsics, "declare ptr @avin_rt_alloc(ptr, ptr)")
            out.push(s"  %v$dest = call ptr @avin_rt_alloc(ptr %ctx, ptr @avin.desc.$descriptor)\n")
        Offset(dest, base, bytes) ->
            out.push(s"  %v$dest = getelementptr inbounds i8, ptr " + operand(program, f, base) + s", i64 $bytes\n")
        Index(dest, base, index) ->
            out.push(s"  %v$dest = getelementptr inbounds i8, ptr " + operand(program, f, base) + ", " + typed_operand(program, f, index) + "\n")
        DescriptorOf(dest, object) ->
            out.push(s"  %t$next = getelementptr i8, ptr " + operand(program, f, object) + s", i64 -$KindBack\n")
            out.push(s"  %v$dest = load ptr, ptr %t$next, align 8\n")
            next += 1
        MethodSlot(dest, object, slot) ->
            out.push(s"  %t$next = getelementptr i8, ptr " + operand(program, f, object) + s", i64 -$KindBack\n")
            out.push(s"  %t${next + 1} = load ptr, ptr %t$next, align 8\n")
            out.push(s"  %t${next + 2} = getelementptr inbounds i8, ptr %t${next + 1}, i64 ${method_slot_offset(slot)}\n")
            out.push(s"  %v$dest = load ptr, ptr %t${next + 2}, align 8\n")
            next += 3
        Call(dest, Direct(index), args) ->
            val callee = program.functions[index]
            out.push("  ")
            if dest is Some(d) then out.push(s"%v$d = ")
            out.push("call " + result_type(callee.signature) + " @\"" + callee.symbol + "\"(ptr %ctx")
            for a in args
                out.push(", " + typed_operand(program, f, a))
            out.push(")\n")
        Call(dest, Indirect(target, signature), args) ->
            out.push("  ")
            if dest is Some(d) then out.push(s"%v$d = ")
            out.push("call " + result_type(signature) + " " + operand(program, f, target) + "(ptr %ctx")
            for a in args
                out.push(", " + typed_operand(program, f, a))
            out.push(")\n")
        Call(dest, Runtime(symbol, signature), args) ->
            var parts: Buf[string] = buf()
            parts.push("ptr %ctx")
            for a in args
                operand_type(program, f, a) match
                    MBool ->
                        out.push(s"  %t$next = zext i1 " + operand(program, f, a) + " to i8\n")
                        parts.push(s"i8 %t$next")
                        next += 1
                    MInt(bits) -> parts.push(s"i$bits " + operand(program, f, a))
                    MReal -> parts.push("double " + operand(program, f, a))
                    MPtr -> parts.push("ptr " + operand(program, f, a))
                    MRef -> parts.push("ptr " + operand(program, f, a))
            // A bool comes back as a byte, which is nonzero for true.
            val byte_result = signature.result is Some(MBool)
            out.push("  ")
            if dest is Some(d)
                if byte_result then out.push(s"%t$next = ") else out.push(s"%v$d = ")
            out.push("call " + c_result(signature) + " @" + symbol + "(")
            for i in 0..<parts.len()
                if i > 0 then out.push(", ")
                out.push(parts[i])
            out.push(")\n")
            if dest is Some(d)
                if byte_result
                    out.push(s"  %v$d = icmp ne i8 %t$next, 0\n")
                    next += 1
    next

private operand_type(program: MirProgram, f: MirFunction, a: Operand) -> MirType = a match
    Value(id) -> f.value_types[id]
    ConstInt(bits, _) -> MInt(bits)
    ConstBool(_) -> MBool
    ConstReal(_) -> MReal
    SlotAddress(_) -> MPtr
    ConstStr(_) -> MRef
    ConstObject(_) -> MRef
    ConstClosure(_) -> MRef
    FunctionAddress(_) -> MPtr
    GlobalAddress(_) -> MPtr
    RecordAddress(_) -> MPtr
    DescriptorAddress(_) -> MPtr
    NullAddress -> MPtr

private operand(program: MirProgram, f: MirFunction, a: Operand) -> string = a match
    Value(id) -> s"%v$id"
    ConstInt(_, digits) -> digits
    ConstBool(value) -> if value then "true" else "false"
    ConstReal(value) -> real_constant(value)
    SlotAddress(slot) -> s"%s$slot"
    ConstObject(descriptor) -> s"@avin.obj.$descriptor"
    ConstStr(index) -> s"@avin.str.$index"
    ConstClosure(index) -> s"@avin.fn.$index"
    FunctionAddress(function) -> "@\"" + program.functions[function].symbol + "\""
    GlobalAddress(index) -> global_address(program, index)
    RecordAddress(index) -> s"@avin.type.$index"
    DescriptorAddress(descriptor) -> s"@avin.desc.$descriptor"
    NullAddress -> "null"

// A module-level value that holds a reference is a slot of the roots frame; any other is a global
// of its own.
private global_address(program: MirProgram, index: usize) -> string
    if !(program.globals[index] is Some(MRef)) then return s"@avin.global.$index"
    var slot = 0usize
    for i in 0..<index
        if program.globals[i] is Some(MRef) then slot += 1
    val n = root_count(program)
    s"getelementptr inbounds ({ ptr, i64, [$n x ptr] }, ptr @avin.roots, i64 0, i32 2, i64 $slot)"

private root_count(program: MirProgram) -> usize
    var n = 0usize
    for t in program.globals
        if t is Some(MRef) then n += 1
    n

private typed_operand(program: MirProgram, f: MirFunction, a: Operand) -> string =
    llvm_type(operand_type(program, f, a)) + " " + operand(program, f, a)

// Fields sit at multiples of 8 bytes, so an integer wider than 64 bits is accessed at that alignment
// rather than its natural one; every other type's natural alignment is at most 8.
private alignment(t: MirType) -> string = t match
    MInt(bits) -> if bits > 64 then ", align 8" else ""
    _ -> ""

// LLVM spells a double exactly as the hexadecimal digits of its encoding.
private real_constant(value: real) -> string
    val hex = "0123456789ABCDEF"
    val bits = value.bits()
    var out = "0x"
    var shift = 60
    while shift >= 0
        out = out + char(hex.bytes[usize((bits >> ulong(shift)) & 15)]).to_string()
        shift -= 4
    out
