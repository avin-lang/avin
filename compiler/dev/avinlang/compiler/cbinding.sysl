module dev.avinlang.compiler

import sysl.buf.{Buf, buf}
import sysl.container.Map

// C bindings. A function declared `@c("<prototype>")` without a body is bound to the C function the
// prototype names: the prototype is C's declaration as the library's header writes it, and its
// parameters correspond to the Avin parameters by position. This file reads a prototype into a C
// signature and holds it against the Avin signature, which the checker does at the binding; lowering
// reads it again to convert each argument and the result, at the widths the C unit measured (see
// `cunit.sysl`).

/** A C type as a binding's prototype spells it. */
enum CType
    /** An integer type spelled with C's keywords, in one spelling per type (`unsigned long` for
     * `long unsigned int`), or an enumeration, `enum name`. */
    CKeyword(name: string)
    /** A typedef's name. What kind of type it is the header says, so the C unit checks it is the
     * kind the Avin type asks for. */
    CTypedef(name: string)
    CBoolType
    CDoubleType
    CFloatType
    CVoidType
    /** A C string: one pointer to `char`, `const char *` when `constant`. A pointer qualified after
     * its star, `char *const`, is one too. */
    CText(constant: bool)
    /** Any other pointer. */
    CPointerType
    /** A struct or union by value, `struct name`. */
    CRecordType(name: string)

/** A parameter of a prototype: its type, and the type as C spells it without the parameter's name,
 * which the header check compares. */
struct CParam
    ty: CType
    text: string
    /** The parameter's name, "" where the prototype gives none; `self` is a method's receiver. */
    name: string
    /** How the value crosses: in, or written back by C through the pointer, `out` or `inout`. */
    mode: CMode
    /** For an `out` or `inout` parameter, the type the pointer points at, and its text; for a
     * pointer passed in, what it points at, an array's element type, where the prototype writes it
     * as one pointer, and otherwise `void` and "". */
    pointee: CType
    pointee_text: string
    /** The name of the array parameter whose length this parameter carries, `length(data)`, or "".
     * Such a parameter is no Avin parameter: it is filled in from the array. */
    length_of: string
    /** Whether the parameter is the `void *` marked `userdata`, which carries a callback's closure and
     * is no Avin parameter. */
    userdata: bool
    /** For a parameter taking a function, the function pointer's own prototype, named by the
     * parameter, one entry; empty for any other parameter. */
    callback: Buf[CPrototype]

/** How a prototype's parameter crosses: passed in, or `out`, a pointer C writes a value through that
 * is part of the binding's result, or `inout`, one C is also passed a value through. */
enum CMode
    CIn
    COut
    CInOut

/** A prototype read: the C function's symbol, its result and its parameters. */
struct CPrototype
    symbol: string
    result: CType
    result_text: string
    params: Buf[CParam]

/** What a C unit measured of an integer type, or of a typedef in a `real` position: its width in
 * bits, and whether it is signed. */
struct CMeasure
    bits: u32
    signed: bool

/** What a C unit measured of a constant or an enumerator: an integer's value as a `long long` and
 * whether it is negative, which tells a value past the greatest `long long` from a negative one; a
 * `real`'s value; a string's bytes, as text where they are UTF-8. */
struct CValue
    integer: i64
    negative: bool
    real: real
    text: Option[string]

/** What kind of C constant a measurement is of. */
enum CConstKind
    CConstInteger
    CConstReal
    CConstString

/** The name a C constant's measurement is kept under: its kind, then its name. */
c_value_key(kind: CConstKind, name: string) -> string = (kind match
    CConstInteger -> "integer "
    CConstReal -> "real "
    CConstString -> "string ") + name

/** The prototype a function's `@c` gives, when it has one written as one string. */
c_prototype_text(f: &Function) -> Option[string]
    for a in f.annotations
        if a.name == "c" && a.args.len() >= 1 && a.args[0].name is None
            if a.args[0].value.kind is StringLit(text) then return Some(text)
    None

/** The prototype of a C binding, read; `None` for a function that is not one, or whose prototype the
 * checker has refused. */
c_prototype_of(f: &Function) -> Option[CPrototype] = c_prototype_text(f) match
    Some(text) -> parse_prototype(text) match
        Ok(p) -> Some(p)
        Err(_) -> None
    None -> None

/** Reads a prototype: a result type, the function's name, and its parameters in parentheses, each a
 * type with an optional name; `(void)` and `()` both take none. What cannot cross a C binding at all
 * is refused here, saying why. */
parse_prototype(text: string) -> Result[CPrototype, string]
    val tokens = c_tokens(text)?
    var at = 0usize
    val declared = c_declaration(tokens, &at)?
    val symbol = declared.name match
        Some(n) -> n
        None -> return Err("it names no function: a prototype is a result type, the function's name and its parameters, as in `int abs(int)`")
    if at >= tokens.len() || tokens[at] != "("
        return Err(s"`$symbol` is not followed by its parameters in parentheses")
    at += 1
    val params = c_param_list(tokens, &at, false)?
    if at < tokens.len() && tokens[at] == ";" then at += 1
    if at < tokens.len() then return Err(s"`${tokens[at]}` follows the parameter list")
    c_check_lengths(params)?
    c_check_callbacks(params)?
    Ok(CPrototype(symbol, declared.ty, declared.text, params))

// The parameters of a parameter list from `tokens[*at]`, just after its `(`, through its `)`. A
// callback's own list, `inner`, takes no `out`, `inout` or `length` parameter and no function.
private c_param_list(tokens: Buf[string], at: *usize, inner: bool) -> Result[Buf[CParam], string]
    var params: Buf[CParam] = buf()
    if *at + 1 < tokens.len() && tokens[*at] == "void" && tokens[*at + 1] == ")"
        *at = *at + 1
    elif *at < tokens.len() && tokens[*at] != ")"
        loop
            if *at < tokens.len() && tokens[*at] == "..."
                return Err("a variadic function cannot be bound: the types of the arguments `...` takes cannot be checked")
            var length_of = ""
            if *at < tokens.len() && tokens[*at] == "length"
                if inner then return Err("a callback's parameter marked `length(...)` carries the length of memory C lends the callback, which crosses as a `ByteView`, and views lent to a callback are not implemented")
                if *at + 3 >= tokens.len() || tokens[*at + 1] != "(" || !is_c_word(tokens[*at + 2]) || tokens[*at + 3] != ")"
                    return Err("`length` names the array parameter whose length the parameter carries, in parentheses, as in `length(data) size_t n`")
                length_of = tokens[*at + 2]
                *at = *at + 4
                if *at < tokens.len() && tokens[*at] == "out"
                    return Err(s"a length is filled in from the array `$length_of`, so `length($length_of)` marks a parameter passed in, or an `inout` pointer C writes the length it used through, not an `out` one")
            var mode = CIn
            if *at < tokens.len() && (tokens[*at] == "out" || tokens[*at] == "inout")
                if inner then return Err(s"a callback's parameter is what C calls it with, so it is never `${tokens[*at]}`")
                mode = if tokens[*at] == "out" then COut else CInOut
                *at = *at + 1
            var userdata = false
            if *at < tokens.len() && tokens[*at] == "userdata"
                if length_of != "" || !(mode is CIn) then return Err("`userdata` marks the `void *` that carries a callback, which is passed in and carries no length")
                userdata = true
                *at = *at + 1
            val p = c_declaration(tokens, at)?
            if *at < tokens.len() && tokens[*at] == "("
                if inner then return Err("a callback's parameter taking a function cannot cross a C binding: a function crosses only as a binding's own parameter")
                if userdata || length_of != "" || !(mode is CIn) then return Err("a parameter taking a function is passed in, with no `userdata`, `out`, `inout` or `length` of its own")
                if p.name is Some(n) then return Err(s"a parameter taking a function is written `${p.text} (*$n)(...)`, its name in parentheses after a `*`")
                val f = c_function_pointer(tokens, at, p)?
                var shown = ""
                for q in f.params
                    shown = shown + (if shown == "" then "" else ", ") + q.text
                if shown == "" then shown = "void"
                var own: Buf[CPrototype] = buf()
                own.push(f)
                params.push(CParam(CPointerType, s"${p.text} (*)($shown)", f.symbol, CIn, CVoidType, "", "", false, own))
                if *at < tokens.len() && tokens[*at] == ","
                    *at = *at + 1
                    continue
                break
            if p.ty is CVoidType then return Err("a parameter cannot be `void`; a function taking nothing is written `(void)`")
            if userdata && p.text != "void *"
                return Err(s"`userdata` marks the `void *` that carries a callback's closure, and `${p.text}` is not `void *`")
            var pointee = CVoidType
            var pointee_text = ""
            if !(mode is CIn)
                val word = if mode is COut then "out" else "inout"
                if !p.text.ends_with(" *")
                    return Err(s"an `$word` parameter is a pointer C writes the value through, as in `$word int *x`, and `${p.text}` is not one")
                pointee_text = p.text[..<p.text.bytes.len - 2]
                if pointee_text.starts_with("const ") && !pointee_text.ends_with("*") || pointee_text.ends_with("const")
                    return Err(s"C cannot write through the `$word` parameter `${p.text}`: what it points at is `const`")
                pointee = parse_c_type(pointee_text)?.ty
            elif p.text.ends_with(" *")
                // What a pointer passed in points at, which an array's elements are.
                val inner_text = p.text[..<p.text.bytes.len - 2]
                if parse_c_type(inner_text) is Ok(t)
                    pointee = t.ty
                    pointee_text = inner_text
            params.push(CParam(p.ty, p.text, p.name.unwrap_or(""), mode, pointee, pointee_text, length_of, userdata, buf()))
            if *at < tokens.len() && tokens[*at] == ","
                *at = *at + 1
                continue
            break
    if *at >= tokens.len() || tokens[*at] != ")"
        return Err(if *at < tokens.len() then s"`${tokens[*at]}` is not part of a parameter list" else "the parameter list has no closing `)`")
    *at = *at + 1
    Ok(params)

// A function pointer's declarator from `tokens[*at]`, after its result type `result`: `(*name)` and
// its parameter list, read as the prototype of the function C calls, named by the parameter.
private c_function_pointer(tokens: Buf[string], at: *usize, result: CDeclared) -> Result[CPrototype, string]
    val shape = "a parameter taking a function is written as C declares a function pointer, as in `void (*listener)(userdata void *data, int value)`"
    *at = *at + 1
    if *at >= tokens.len() || tokens[*at] != "*" then return Err(shape)
    *at = *at + 1
    var name = ""
    if *at < tokens.len() && is_c_word(tokens[*at]) && !is_c_keyword(tokens[*at])
        name = tokens[*at]
        *at = *at + 1
    if *at >= tokens.len() || tokens[*at] != ")" then return Err(shape)
    *at = *at + 1
    if *at >= tokens.len() || tokens[*at] != "(" then return Err(shape)
    *at = *at + 1
    val params = c_param_list(tokens, at, true)?
    if result.ty is CText(_) then return Err("a callback answers C a scalar or an enum mirror; a string it answered would have to outlive the call, which nothing frees")
    Ok(CPrototype(name, result.ty, result.text, params))

// Each parameter taking a function has a name and a `userdata` of its own, the only one its prototype
// has, which a `userdata` of the binding's carries by the same name; each of the binding's carries
// one callback, and no two carry the same.
private c_check_callbacks(params: Buf[CParam]) -> Result[unit, string]
    var carried: Buf[string] = buf()
    for q in params
        if q.callback.len() == 0 then continue
        val f = q.callback[0]
        if q.name == "" then return Err(s"a parameter taking a function is named, as in `${q.text.replace_all("(*)", "(*listener)")}`")
        var own: Option[CParam] = None
        var count = 0usize
        for r in f.params
            if r.userdata
                own = Some(r)
                count += 1
        if count == 0 then return Err(s"`${q.name}` takes a function with no `userdata`: C passes the function its closure through the `void *` marked `userdata`, and with none there is nowhere to find it")
        if count > 1 then return Err(s"`${q.name}` takes a function with ${count} parameters marked `userdata`, and one carries its closure")
        val word = own.unwrap().name
        if word == "" then return Err(s"the `userdata` of `${q.name}` is named, as the binding's `userdata` that carries it is")
        var found = false
        for r in params
            if r.userdata && r.name == word then found = true
        if !found then return Err(s"`${q.name}` finds its closure through `$word`, and no parameter of the binding is `userdata void *$word`")
        for c in carried
            if c == word then return Err(s"`$word` carries the closure of two functions; a binding takes one function per `userdata`")
        carried.push(word)
    for q in params
        if !q.userdata then continue
        if q.name == "" then return Err("a `userdata` parameter is named, as the `userdata` of the function it carries is")
        var used = false
        for c in carried
            if c == q.name then used = true
        if !used then return Err(s"`${q.name}` is marked `userdata`, and no parameter takes a function whose `userdata` it carries")
    Ok(())

// Each `length(data)` names a pointer parameter passed in, `data`, which no other parameter's length
// names, and marks an integer, or an `inout` pointer to one.
private c_check_lengths(params: Buf[CParam]) -> Result[unit, string]
    for k in 0..<params.len()
        val q = params[k]
        if q.length_of == "" then continue
        val name = q.length_of
        if q.name == "self" then return Err("`self` is the receiver, which carries no array's length")
        val integer = (if q.mode is CInOut then q.pointee else q.ty) match
            CKeyword(n) -> n != "char" && !n.starts_with("enum ")
            CTypedef(_) -> true
            _ -> false
        if !integer
            val shown = if q.mode is CInOut then q.pointee_text else q.text
            return Err(s"`length($name)` marks the parameter carrying the length of `$name`, which is an integer, and `$shown` is not one")
        var found = false
        for j in 0..<params.len()
            if j == k then continue
            val a = params[j]
            if a.length_of == name then return Err(s"the length of `$name` is carried by one parameter, and two say `length($name)`")
            if a.name != name then continue
            found = true
            if name == "self" then return Err("`self` is the receiver, a handle, and no array")
            if a.length_of != "" then return Err(s"`$name` carries a length itself, so it is no array")
            if !(a.mode is CIn) then return Err(s"`$name` is an `out` or `inout` pointer, so it is no array; an array is a pointer passed in")
            if !(a.ty is CPointerType || a.ty is CText(_)) then return Err(s"`$name` is `${a.text}`, and an array is passed as a pointer to its elements, as in `uint8_t *$name`")
        if !found then return Err(s"`length($name)` names no parameter of the prototype")
    Ok(())

/** The index of the parameter carrying the length of the array parameter `name`, if one does. */
c_length_param(p: CPrototype, name: string) -> Option[usize]
    if name == "" then return None
    for k in 0..<p.params.len()
        if p.params[k].length_of == name then return Some(k)
    None

/** Whether parameter `k` of `p` is an array: a pointer passed in whose length another parameter
 * carries. */
c_is_array_param(p: CPrototype, k: usize) -> bool = p.params[k].mode is CIn && c_length_param(p, p.params[k].name) is Some(_)

// A type and the name after it, as a declaration writes them.
private struct CDeclared
    ty: CType
    text: string
    name: Option[string]

// The type specifiers, qualifiers and pointers of one declaration from `tokens[*at]`, and the name
// after them when there is one.
private c_declaration(tokens: Buf[string], at: *usize) -> Result[CDeclared, string]
    var words: Buf[string] = buf()
    var signed = false
    var unsigned = false
    var short = false
    var longs = 0usize
    var char_word = false
    var int_word = false
    var base: Option[CType] = None
    var name: Option[string] = None
    while *at < tokens.len()
        val t = tokens[*at]
        if !is_c_word(t) then break
        if t == "extern"
            *at = *at + 1
            continue
        if t == "out" || t == "inout"
            return Err(s"`$t` is written first, before the parameter's type, as in `$t int *x`")
        if t == "userdata"
            return Err("`userdata` is written first, before the parameter's type, as in `userdata void *data`")
        if t == "length" && *at + 1 < tokens.len() && tokens[*at + 1] == "("
            return Err("`length(data)` is written first, before the parameter's type and before `inout`, as in `length(data) size_t n`")
        if t == "static" || t == "inline" || t == "register" || t == "typedef"
            return Err(s"`$t` is not part of a function's prototype")
        if t == "_Complex" || t == "__int128" || t == "_Imaginary"
            return Err(s"`$t` cannot cross a C binding")
        val specifier = t == "signed" || t == "unsigned" || t == "short" || t == "long" || t == "char" || t == "int"
        if specifier
            if base is Some(_) && !(t == "long" && base is Some(CDoubleType))
                return Err(s"`$t` does not combine with the type before it")
            if t == "signed" then signed = true
            elif t == "unsigned" then unsigned = true
            elif t == "short" then short = true
            elif t == "long" then longs += 1
            elif t == "char" then char_word = true
            else int_word = true
            words.push(t)
            *at = *at + 1
            continue
        if t == "const" || t == "volatile" || t == "restrict"
            words.push(t)
            *at = *at + 1
            continue
        val specified = signed || unsigned || short || longs > 0 || char_word || int_word
        val keyword_base = t == "void" || t == "_Bool" || t == "bool" || t == "float" || t == "double"
        if keyword_base
            if base is Some(_) || (specified && !(t == "double" && longs == 1 && !signed && !unsigned && !short && !char_word && !int_word))
                return Err(s"`$t` does not combine with the type before it")
            base = Some(if t == "void" then CVoidType elif t == "float" then CFloatType elif t == "double" then CDoubleType else CBoolType)
            words.push(t)
            *at = *at + 1
            continue
        if t == "struct" || t == "union" || t == "enum"
            if base is Some(_) || specified then return Err(s"`$t` does not combine with the type before it")
            if *at + 1 >= tokens.len() || !is_c_word(tokens[*at + 1]) then return Err(s"`$t` is followed by its tag's name")
            val tag = tokens[*at + 1]
            base = Some(if t == "enum" then CKeyword("enum " + tag) else CRecordType(t + " " + tag))
            words.push(t)
            words.push(tag)
            *at = *at + 2
            continue
        // Any other word is a typedef's name where no type has been said yet, and otherwise the name
        // the declaration declares.
        if base is None && !specified
            base = Some(CTypedef(t))
            words.push(t)
            *at = *at + 1
            continue
        name = Some(t)
        *at = *at + 1
        break
    val specified = signed || unsigned || short || longs > 0 || char_word || int_word
    if base is Some(CDoubleType) && longs > 0 then return Err("`long double` cannot cross a C binding")
    if base is None && !specified
        return Err(if *at < tokens.len() then s"`${tokens[*at]}` is not a C type" else "a type is missing")
    var ty = base match
        Some(b) -> b
        None -> CKeyword(integer_spelling(signed, unsigned, short, longs, char_word)?)
    var text = joined_words(words)
    // Pointers, each perhaps qualified, then the name if it was not before them.
    var pointers = 0usize
    while *at < tokens.len() && name is None
        val t = tokens[*at]
        if t == "*"
            pointers += 1
            text = text + " *"
            *at = *at + 1
        elif pointers > 0 && (t == "const" || t == "volatile" || t == "restrict")
            text = text + t
            *at = *at + 1
        else break
    if name is None && *at < tokens.len() && is_c_word(tokens[*at]) && !is_c_keyword(tokens[*at])
        name = Some(tokens[*at])
        *at = *at + 1
    if *at < tokens.len() && tokens[*at] == "["
        return Err("a parameter declared with brackets is written as the pointer C passes, as in `int *values`, its length carried by a parameter marked `length(values)`")
    val plain_char = ty match
        CKeyword(n) -> n == "char"
        _ -> false
    if pointers == 1 && plain_char then ty = CText(contains_word(words, "const"))
    elif pointers > 0 then ty = CPointerType
    Ok(CDeclared(ty, text, name))

private contains_word(words: Buf[string], w: string) -> bool
    for x in words
        if x == w then return true
    false

// The one spelling of an integer type its keywords make, `long unsigned int` being `unsigned long`.
private integer_spelling(signed: bool, unsigned: bool, short: bool, longs: usize, char_word: bool) -> Result[string, string]
    if signed && unsigned then return Err("`signed` and `unsigned` do not combine")
    if longs > 2 then return Err("`long long long` is not a C type")
    if (short && (longs > 0 || char_word)) || (char_word && longs > 0) then return Err("those keywords do not make one C type")
    val prefix = if unsigned then "unsigned " else ""
    if char_word then return Ok(if signed then "signed char" elif unsigned then "unsigned char" else "char")
    if short then return Ok(prefix + "short")
    if longs == 2 then return Ok(prefix + "long long")
    if longs == 1 then return Ok(prefix + "long")
    Ok(prefix + "int")

private joined_words(words: Buf[string]) -> string
    var out = ""
    for w in words
        out = if out == "" then w else out + " " + w
    out

// The words, `*`, parentheses, commas, brackets, `;` and `...` a prototype is made of.
private c_tokens(text: string) -> Result[Buf[string], string]
    var out: Buf[string] = buf()
    val b = text.bytes
    var i = 0usize
    while i < b.len
        val ch = b[i]
        if ch == u8(' ') || ch == u8('\t') || ch == u8('\n') || ch == u8('\r')
            i += 1
            continue
        // A word, or a number, which only an array's length is.
        if is_c_word_byte(ch)
            val start = i
            while i < b.len && is_c_word_byte(b[i])
                i += 1
            out.push(text[start..<i])
            continue
        if ch == u8('.') && i + 2 < b.len && b[i + 1] == u8('.') && b[i + 2] == u8('.')
            out.push("...")
            i += 3
            continue
        if ch == u8('*') || ch == u8('(') || ch == u8(')') || ch == u8(',') || ch == u8('[') || ch == u8(']') || ch == u8(';')
            out.push(text[i..<i + 1])
            i += 1
            continue
        return Err(s"`${text[i..<i + 1]}` is not part of a C prototype")
    Ok(out)

private is_c_word_byte(b: u8) -> bool = b >= u8('a') && b <= u8('z') || b >= u8('A') && b <= u8('Z') || b == u8('_') || b >= u8('0') && b <= u8('9')

private is_c_word(t: string) -> bool = t.bytes.len > 0 && is_c_word_byte(t.bytes[0]) && !(t.bytes[0] >= u8('0') && t.bytes[0] <= u8('9'))

/** Whether `t` is a C identifier that is no C keyword, as a function's name is. */
is_c_identifier(t: string) -> bool
    if !is_c_word(t) || is_c_keyword(t) then return false
    for b in t.bytes
        if !is_c_word_byte(b) then return false
    true

private is_c_keyword(t: string) -> bool =
    t == "const" || t == "volatile" || t == "restrict" || t == "void" || t == "char" || t == "short" || t == "int" || t == "long" || t == "signed" || t == "unsigned" || t == "float" || t == "double" || t == "_Bool" || t == "bool" || t == "struct" || t == "union" || t == "enum"

/** A C type written alone, as a handle's `type:` writes it: its type and the text a prototype's
 * parameter of that type has, so the two compare as text. */
struct CTypeText
    ty: CType
    text: string

/** Reads a C type written with no name after it, `cairo_surface_t *` or `FT_Library`. */
parse_c_type(text: string) -> Result[CTypeText, string]
    val tokens = c_tokens(text)?
    var at = 0usize
    val declared = c_declaration(tokens, &at)?
    if declared.name is Some(n) then return Err(s"`$n` follows the type")
    if at < tokens.len() then return Err(s"`${tokens[at]}` is not part of a C type")
    Ok(CTypeText(declared.ty, declared.text))

/** The `@c(…)` a class is declared with, which makes it a handle on a C pointer. */
c_class_annotation(d: &ClassDecl) -> Option[Annotation]
    if d.object then return None
    for a in d.annotations
        if a.name == "c" then return Some(a)
    None

/** The C pointer type a handle class's `@c(type: …)` names, as written. */
c_handle_type(d: &ClassDecl) -> Option[string] = c_class_text(d, "type")

/** The string a handle class's `@c` gives under `key`, `release`, `retain` or `kept`. */
c_class_text(d: &ClassDecl, key: string) -> Option[string]
    val a = c_class_annotation(d)?
    for arg in a.args
        if arg.name is Some(n) && n == key
            if arg.value.kind is StringLit(text) then return Some(text)
    None

/** Whether a handle class's `@c` says `shared`: its C object is safe to use from any thread, so its
 * owner is not checked. */
c_class_shared(d: &ClassDecl) -> bool
    val a = c_class_annotation(d) match
        Some(a) -> a
        None -> return false
    for arg in a.args
        if arg.name is None && arg.value.kind is Name(word) && word == "shared" then return true
    false

/** What a handle class's `kept: "name: Class"` says: the name its `release:` and `retain:` give the
 * one handle of `Class` it keeps, and that class's name as written. */
struct CKept
    name: string
    class_name: string

/** The `kept:` of a handle class, read; `None` where it has none or it is not `name: Class`. */
c_class_kept(d: &ClassDecl) -> Option[CKept]
    val text = c_class_text(d, "kept")?
    val parts = text.split(":")
    if parts.len != 2 then return None
    val name = parts[0].trim()
    val class_name = parts[1].trim()
    if !is_c_identifier(name) || class_name == "" then return None
    Some(CKept(name, class_name))

/** The class a handle class's `kept:` names, by its index: a class of the holder's own module, or one
 * named with its module, `freetype.Face`. */
c_kept_class(classes: Buf[ClassSymbol], holder: usize) -> Option[usize]
    val kept = c_class_kept(classes[holder].decl)?
    var module_name = classes[holder].module_name
    var name = kept.class_name
    val b = kept.class_name.bytes
    var i = b.len
    while i > 0
        i -= 1
        if b[i] == u8('.')
            module_name = kept.class_name[..<i]
            name = kept.class_name[i + 1..]
            break
    for k in 0..<classes.len()
        if classes[k].module_name == module_name && classes[k].name == name then return Some(k)
    None

/** Whether the C expression `text` uses the identifier `name` as a word of its own. */
c_uses_name(text: string, name: string) -> bool
    val b = text.bytes
    var i = 0usize
    while i < b.len
        if is_c_word_byte(b[i])
            val start = i
            while i < b.len && is_c_word_byte(b[i])
                i += 1
            // A word after `.` or `->` is a member's name, not the variable.
            val member = start > 0 && (b[start - 1] == u8('.') || start > 1 && b[start - 1] == u8('>') && b[start - 2] == u8('-'))
            if !member && text[start..<i] == name then return true
            continue
        i += 1
    false

/** The C expression `text` with every use of one of `names` as a variable, not as a member's name,
 * written `with` instead. */
c_replace_names(text: string, names: Buf[string], with: string) -> string
    val b = text.bytes
    var out = ""
    var from = 0usize
    var i = 0usize
    while i < b.len
        if is_c_word_byte(b[i])
            val start = i
            while i < b.len && is_c_word_byte(b[i])
                i += 1
            val member = start > 0 && (b[start - 1] == u8('.') || start > 1 && b[start - 1] == u8('>') && b[start - 2] == u8('-'))
            if !member
                for n in names
                    if text[start..<i] == n
                        out = out + text[from..<start] + with
                        from = i
                        break
            continue
        i += 1
    out + text[from..]

/** One of a handle class's `as:` conversions: the other C type the handle may be passed as, as
 * `parse_c_type` reads it, and the C function or expression in `self` that makes one. */
struct CAs
    ty: string
    expr: string

/** Reads one `as:` entry, `"mlt_service = mlt_playlist_service(self)"`: a C pointer type, `=`, and a
 * C function of the handle's pointer or a C expression in `self`. */
c_as_entry(text: string) -> Result[CAs, string]
    val at = text.index_of("=") match
        Some(a) -> a
        None -> return Err("it has no `=`")
    val written = text[..<at].trim()
    val expr = text[at + 1..].trim()
    val ty = parse_c_type(written) match
        Ok(t) -> t
        Err(why) -> return Err(s"`$written` is not a C type: $why")
    ty.ty match
        CPointerType -> ()
        CTypedef(_) -> ()
        _ -> return Err(s"`$written` is not a pointer: a handle is passed as another pointer to its C object")
    if expr == "" then return Err(s"it names no function or expression to make a `$written`")
    if !is_c_identifier(expr) && !c_uses_name(expr, "self") then return Err(s"`$expr` is neither a C function of the handle's pointer nor a C expression in `self`")
    Ok(CAs(ty.text, expr))

/** The strings a handle class's `@c` gives under `key`: one string, or a list of them. */
c_class_texts(d: &ClassDecl, key: string) -> Buf[string]
    var out: Buf[string] = buf()
    val a = c_class_annotation(d) match
        Some(a) -> a
        None -> return out
    for arg in a.args
        if arg.name != Some(key) then continue
        arg.value.kind match
            StringLit(text) -> out.push(text)
            ListLit(items) ->
                for item in items
                    if item.kind is StringLit(text) then out.push(text)
            _ -> ()
    out

/** A handle class's `as:` conversions that read, in the order written. */
c_class_as(d: &ClassDecl) -> Buf[CAs]
    var out: Buf[CAs] = buf()
    for text in c_class_texts(d, "as")
        if c_as_entry(text) is Ok(entry) then out.push(entry)
    out

/** The `as:` conversion of a handle class by which a prototype's parameter written `text` takes its
 * handle: the entry whose type it is, or that type `const`-qualified. */
c_as_position(d: &ClassDecl, text: string) -> Option[usize]
    val entries = c_class_as(d)
    for j in 0..<entries.len()
        if c_names_handle(text, entries[j].ty, false) then return Some(j)
    None

/** What a field accessor's `@c(field: …)` says: the C lvalue it reads or writes, a member path of the
 * struct `self` points at, and the `bound:` of each index, in order. */
struct CField
    expr: string
    bounds: Buf[string]

/** The field accessor a method's `@c` makes, when it says `field:`. */
c_field_of(f: &Function) -> Option[CField]
    for a in f.annotations
        if a.name != "c" then continue
        for arg in a.args
            if arg.name is Some(n) && n == "field"
                if arg.value.kind is StringLit(text)
                    var bounds: Buf[string] = buf()
                    for b in c_binding_names(f, "bound")
                        bounds.push(b)
                    return Some(CField(text, bounds))
    None

/** The name of a field accessor's glue in the C unit, by the index of its symbol: `get` reads the
 * field, `set` writes it, and `bound` with the index's position answers its bound. */
c_field_glue(symbol: usize, part: string) -> string = s"avin_c_field_${part}_$symbol"

/** The name the C unit gives the type of a field accessor's field. */
c_field_type_name(symbol: usize) -> string = s"avin_c_field_type_$symbol"

/** Whether a C binding's `@c` says the bare word `word`, `borrowed`. */
c_binding_flag(f: &Function, word: string) -> bool
    for a in f.annotations
        if a.name != "c" then continue
        for arg in a.args
            if arg.name is None && arg.value.kind is Name(w) && w == word then return true
    false

/** The parameters a C binding's `keeps:` or `consumes:` names: one string, or a list of them. */
c_binding_names(f: &Function, key: string) -> Buf[string]
    var out: Buf[string] = buf()
    for a in f.annotations
        if a.name != "c" then continue
        for arg in a.args
            if arg.name != Some(key) then continue
            arg.value.kind match
                StringLit(text) -> out.push(text)
                ListLit(items) ->
                    for item in items
                        if item.kind is StringLit(text) then out.push(text)
                _ -> ()
    out

/** The handle class an Avin type is, or holds as an `Option`'s value: the class's index, and whether
 * it is in an `Option`, which null's `None` is. */
struct CHandleForm
    class_index: usize
    optional: bool

/** The form in which `t` carries a C handle, if it does. */
c_handle_form(t: &Type, data: Buf[DataSymbol], classes: Buf[ClassSymbol]) -> Option[CHandleForm]
    var inner = t
    var optional = false
    *t match
        Data(d, _, args) ->
            if data[d].module_name == "avin" && data[d].name == "Option" && args.len() == 1
                inner = args[0]
                optional = true
        _ -> ()
    *inner match
        Class(k, _, _) -> if c_handle_type(classes[k].decl) is Some(_) then Some(CHandleForm(k, optional)) else None
        _ -> None

/** The error type of a status result, `Result[T, E]` with `E` an integer type or an enum mirror:
 * `Ok` for zero, holding the out values (`unit` where there are none), and `Err` of the code or its
 * variant otherwise. */
c_status_error(t: &Type, data: Buf[DataSymbol]) -> Option[&Type] = *t match
    Data(d, _, args) ->
        val error = data[d].module_name == "avin" && data[d].name == "Result" && args.len() == 2 && (*args[1] is Int(_) || c_mirror_of(args[1], data) is Some(_))
        if error then Some(args[1]) else None
    _ -> None

/** How a binding's Avin result is made of what C answers: the Avin type of the C result (`unit`
 * where it is no part of the result) and of each `out` and `inout` value, in order. A status's `Ok`
 * holds the out values; otherwise the result is the C result followed by them, as a tuple, a `void`
 * C result left out, and one value alone is no tuple. A C result that is not `void` is left out too
 * where the binding's result has the out values alone. */
struct CResultParts
    result: &Type
    outs: Buf[&Type]

/** The prototype indices of the parameters an Avin binding takes, in order: all but the `out` ones
 * and those carrying an array's length, which is filled in from the array. */
c_avin_positions(p: CPrototype) -> Buf[usize]
    var out: Buf[usize] = buf()
    for i in 0..<p.params.len()
        if c_is_avin_param(p.params[i]) then out.push(i)
    out

/** Whether a prototype's parameter is one an Avin binding takes: not `out`, carrying no length, and
 * not a `userdata`. */
c_is_avin_param(q: CParam) -> bool = !(q.mode is COut) && q.length_of == "" && !q.userdata

/** The number of `out` and `inout` parameters of a prototype. */
c_out_count(p: CPrototype) -> usize
    var n = 0usize
    for q in p.params
        if !(q.mode is CIn) then n += 1
    n

/** The indices of the parameters of a callback's prototype `f` the Avin function takes, in order:
 * all but its `userdata`. */
c_callback_positions(f: CPrototype) -> Buf[usize]
    var out: Buf[usize] = buf()
    for i in 0..<f.params.len()
        if !f.params[i].userdata then out.push(i)
    out

/** The index of the parameter of `p` taking the function whose closure the `userdata` parameter `k`
 * carries. */
c_callback_of_userdata(p: CPrototype, k: usize) -> usize
    for j in 0..<p.params.len()
        val q = p.params[j]
        if q.callback.len() == 0 then continue
        for r in q.callback[0].params
            if r.userdata && r.name == p.params[k].name then return j
    panic("a `userdata` that carries no callback")

/** A callback's function type as the C unit measures it: each enum mirror among its parameters, and
 * one it answers, as the integer it is. */
c_callback_measured(t: &Type, data: Buf[DataSymbol]) -> &Type = *t match
    Function(ps, r, sendable) ->
        var own: Buf[&Type] = buf()
        for q in ps
            own.push(if c_mirror_of(q, data) is Some(_) then Int(64) else q)
        Function(own, if c_mirror_of(r, data) is Some(_) then Int(64) else r, sendable)
    _ -> t

/** How the result `r` of a binding with prototype `p` splits, or why it cannot. */
c_result_parts(p: CPrototype, r: &Type, data: Buf[DataSymbol]) -> Result[CResultParts, string]
    val n = c_out_count(p)
    if n == 0 then return Ok(CResultParts(r, buf()))
    if c_status_error(r, data) is Some(_)
        val ok = c_status_ok(r)
        val outs = c_spread(ok, n) match
            Some(o) -> o
            None -> return Err(s"the `Ok` of a status holds the ${count_words(n, "out value")} of the call" + (if n > 1 then s", a tuple of $n" else ""))
        return Ok(CResultParts(r, outs))
    if !(p.result is CVoidType)
        if *r is Tuple(items)
            if items.len() == n + 1
                var outs: Buf[&Type] = buf()
                for i in 1..<items.len()
                    outs.push(items[i])
                return Ok(CResultParts(items[0], outs))
    if c_spread(r, n) is Some(outs) then return Ok(CResultParts(Unit, outs))
    val values = count_words(n, "out value")
    if p.result is CVoidType then return Err(s"the C function answers nothing, so the binding answers its $values" + (if n > 1 then s", a tuple of $n" else ""))
    Err(s"the binding answers the C result followed by its $values, a tuple of ${n + 1}, or its $values alone" + (if n > 1 then s", a tuple of $n" else ""))

// The `n` values `t` is made of: itself where `n` is one, and otherwise the parts of a tuple of `n`.
private c_spread(t: &Type, n: usize) -> Option[Buf[&Type]]
    var out: Buf[&Type] = buf()
    // An out value is never a tuple, so a tuple is the values of more than one.
    if n == 1
        if *t is Tuple(_) then return None
        out.push(t)
        return Some(out)
    if *t is Tuple(items)
        if items.len() == n
            for x in items
                out.push(x)
            return Some(out)
    None

private count_words(n: usize, word: string) -> string = if n == 1 then "one " + word else s"$n ${word}s"

/** What a status result's `Ok` holds: the out values. */
c_status_ok(t: &Type) -> &Type = *t match
    Data(_, _, args) -> args[0]
    _ -> t

/** What a data type's `@c(enum: "<C type>", prefix: "<prefix>")` says: it mirrors the C enum, each
 * variant one enumerator. */
struct CEnum
    ty: string
    prefix: string

/** The `@c` a data type is declared with, which makes it a mirror. */
c_data_annotation(d: &DataDecl) -> Option[Annotation]
    for a in d.annotations
        if a.name == "c" then return Some(a)
    None

/** The C enum a data type mirrors, read; `None` where it mirrors none, or its `@c` is not well formed
 * (which the checker reports). */
c_enum_of(d: &DataDecl) -> Option[CEnum]
    val a = c_data_annotation(d)?
    var ty: Option[string] = None
    var prefix = ""
    for arg in a.args
        val n = arg.name?
        val text = if arg.value.kind is StringLit(t) then t else return None
        if n == "enum" then ty = Some(text)
        elif n == "prefix" then prefix = text
        else return None
    Some(CEnum(ty?, prefix))

/** What is wrong with the enum mirror `d`, named `name`, crossing at a C position written `text`, or
 * "": it crosses as the C type it mirrors, `const`-qualified or not. */
c_mirror_problem(d: &DataDecl, name: string, text: string) -> string
    val e = c_enum_of(d) match
        Some(e) -> e
        None -> return ""
    val wanted = parse_c_type(e.ty) match
        Ok(t) -> t.text
        Err(_) -> return ""
    if text == wanted || text == "const " + wanted then return ""
    s"`$name` mirrors `${e.ty}`, so it crosses as that type"

/** The index of the enum mirror `t` is, if it is one. */
c_mirror_of(t: &Type, data: Buf[DataSymbol]) -> Option[usize] = *t match
    Data(d, _, args) -> if args.len() == 0 && c_enum_of(data[d].decl) is Some(_) then Some(d) else None
    _ -> None

/** The name the variant `v` of an enum mirror gives its own enumerator with `@c("name")`. */
c_variant_text(v: Variant) -> Option[string]
    for a in v.annotations
        if a.name == "c" && a.args.len() == 1 && a.args[0].name is None
            if a.args[0].value.kind is StringLit(t) then return Some(t)
    None

/** The enumerator the variant `v` of the mirror `e` holds: the one its own `@c("name")` names, or
 * the prefix followed by the variant's words, joined by `_`, in the prefix's case: upper case where
 * the prefix has an upper-case letter and no lower-case one, and lower case otherwise. A word starts
 * at each upper-case letter, and a digit belongs to the word before it: `Yuv420p` is one word,
 * `ColorDodge` two. */
c_enumerator(e: CEnum, v: Variant) -> string
    if c_variant_text(v) is Some(t) then return t
    var upper = false
    var lower = false
    for b in e.prefix.bytes
        if u8('A') <= b <= u8('Z') then upper = true
        if u8('a') <= b <= u8('z') then lower = true
    val shout = upper && !lower
    var out = e.prefix
    val b = v.name.bytes
    for i in 0..<b.len
        val ch = b[i]
        val capital = u8('A') <= ch <= u8('Z')
        if capital && i > 0 then out = out + "_"
        val c = if shout && u8('a') <= ch <= u8('z') then ch - 32u8 elif !shout && capital then ch + 32u8 else ch
        out = out + char(c).to_string()
    out

/** Whether a prototype's position, written `text`, takes or answers the handle whose `type:` reads as
 * `handle`: the same type, or for a parameter that type `const`-qualified, which C passes the same
 * pointer to. */
c_names_handle(text: string, handle: string, result: bool) -> bool
    if text == handle then return true
    !result && text == "const " + handle

/** The function a C binding's `@c(…, free: "name")` names to free the string C answers, when it
 * names one as a string. */
c_free_text(f: &Function) -> Option[string]
    for a in f.annotations
        if a.name != "c" then continue
        for arg in a.args
            if arg.name is Some(n) && n == "free"
                if arg.value.kind is StringLit(text) then return Some(text)
    None

/** Whether a C binding's call may wait: its `@c` says `blocking`, or it takes a function marked
 * `@threaded`, which C may call from another thread while this one waits for it. */
c_is_blocking(f: &Function) -> bool
    for p in f.params
        if is_threaded_param(p) then return true
    for a in f.annotations
        if a.name != "c" then continue
        for arg in a.args
            if arg.name is None && arg.value.kind is Name(word) && word == "blocking" then return true
    false

/** How an Avin type carries a C string, for the types that do: a `string`, copied and checked as
 * UTF-8, or an `Array[byte]`, copied as it is, each perhaps in an `Option`, which is null's `None`. */
enum CTextForm
    NoText
    TextString(optional: bool)
    TextBytes(optional: bool)

/** The form in which the Avin type `t` carries a C string, given the program's data types and
 * classes, which say what `Option` and `Array` are. */
c_text_form(t: &Type, data: Buf[DataSymbol], classes: Buf[ClassSymbol]) -> CTextForm
    var inner = t
    var optional = false
    *t match
        Data(d, _, args) ->
            if data[d].module_name == "avin" && data[d].name == "Option" && args.len() == 1
                inner = args[0]
                optional = true
        _ -> ()
    *inner match
        Str -> TextString(optional)
        Class(k, _, args) ->
            val array = classes[k].module_name == "avin" && classes[k].name == "Array" && !classes[k].decl.object
            if array && args.len() == 1 && *args[0] is Byte then TextBytes(optional) else NoText
        _ -> NoText

/** How an Avin type carries an array to C: its element type, and whether it is in an `Option`, whose
 * `None` passes null and a length of zero. */
struct CArrayForm
    element: &Type
    optional: bool

/** The array form of the Avin type `t`, where it is an `Array` or an `Option` of one. */
c_array_form(t: &Type, data: Buf[DataSymbol], classes: Buf[ClassSymbol]) -> Option[CArrayForm]
    var inner = t
    var optional = false
    *t match
        Data(d, _, args) ->
            if data[d].module_name == "avin" && data[d].name == "Option" && args.len() == 1
                inner = args[0]
                optional = true
        _ -> ()
    *inner match
        Class(k, _, args) ->
            val array = classes[k].module_name == "avin" && classes[k].name == "Array" && !classes[k].decl.object
            if array && args.len() == 1 then Some(CArrayForm(args[0], optional)) else None
        _ -> None

/** The size in bytes of an element of an array that crosses to C, or 0 for an element type that
 * does not: a `byte`, an `int`, a `long` and a `real` do, as they are, since nothing is converted. */
c_array_element_size(element: &Type) -> usize = *element match
    Byte -> 1
    Int(width) -> if width == 32 then 4 elif width == 64 then 8 else 0
    Real -> 8
    _ -> 0

/** Why the Avin array type `t`, carried in `form`, cannot be passed to the array parameter `q`, or
 * "". The C unit checks the element type C's pointer points at. */
c_array_problem(q: CParam, form: CArrayForm) -> string
    if c_array_element_size(form.element) == 0
        return "an array crosses to C as `Array[byte]`, `Array[int]`, `Array[long]` or `Array[real]`, whose elements C reads as they are"
    if !(q.ty is CPointerType || q.ty is CText(_)) || q.pointee_text == ""
        return s"an array is passed as a pointer to its elements, as in `uint8_t *${q.name}`"
    if q.ty is CText(_) && !(*form.element is Byte) then return "a pointer to `char` takes an `Array[byte]`"
    ""

/** What the Avin type at a C position must be, as a diagnostic says it, or "" where `avin` may cross
 * as `c`; `form` is how `avin` carries a string, if it does. A result whose Avin type is `unit`
 * discards whatever C answers, except a struct, which is passed by value. */
c_crossing_problem(c: CType, avin: &Type, form: CTextForm, result: bool) -> string
    if result && *avin is Unit
        return if c is CRecordType(_) then "a struct passed by value is not implemented" else ""
    if !(form is NoText) then return c_text_problem(c, form, result)
    c match
        CKeyword(name) ->
            if name == "char" then return if *avin is Byte then "" else "a C `char` crosses as `byte`"
            if name == "unsigned char" then return if *avin is Byte || *avin is Int(_) || *avin is Bool then "" else "it crosses as `byte`, an integer type, or `bool` as a truth value"
            if *avin is Int(_) || *avin is Bool then "" else "a C integer crosses as an integer type, or `bool` as a truth value"
        CTypedef(_) -> *avin match
            Int(_) -> ""
            Byte -> ""
            Bool -> ""
            Real -> ""
            _ -> "a typedef crosses as an integer type, `byte`, `bool`, `real` or a string, as the header's type is"
        CBoolType -> if *avin is Bool then "" else "a C `bool` crosses as `bool`"
        CDoubleType -> if *avin is Real then "" else "a C `double` crosses as `real`"
        CFloatType -> if *avin is Real then "" else "a C `float` crosses as `real`"
        CVoidType -> "the C function answers nothing, so the binding's result is `unit`"
        CText(_) -> if result then "a C string crosses as `string`, `Array[byte]`, or either in an `Option`" else "a C string crosses as `string` or `Option[string]`"
        CPointerType -> "a C pointer crosses as a handle, a class declared with `@c(type: …)` naming the pointer's type"
        CRecordType(_) -> "a struct passed by value is not implemented"

// What a string's Avin type `form` must be at the C position `c`, or "".
private c_text_problem(c: CType, form: CTextForm, result: bool) -> string
    val bytes = form is TextBytes(_)
    if !result && bytes then return "an `Array[byte]` parameter is an array, whose length a parameter marked `length(…)` carries"
    c match
        CText(constant) -> if result || constant then "" else "C may write through a `char *`, so it takes an `Array[byte]`, its length carried by a parameter marked `length(…)`, rather than a `string`"
        CTypedef(_) -> ""
        CVoidType -> "the C function answers nothing, so the binding's result is `unit`"
        _ -> "a string crosses as a C `const char *`" + (if result then " or `char *`" else "")

/** How a typedef at a C position must be, by the Avin type it crosses as: the kind the C unit checks.
 * A typedef crossing as `bool` is a C `bool` or an integer type used as a truth value; one crossing
 * as a string is `char *` or `const char *` as a result, and `const char *` as a parameter. */
enum CKind
    KindInteger
    KindByte
    KindBool
    KindReal
    KindText
    KindConstText

/** The kind of type the C type `c` must be to cross as `avin`, carried in `form`, where the C unit
 * checks or measures it: every integer type, which is measured, and every typedef, whose kind is
 * checked. */
c_kind_needed(c: CType, avin: &Type, form: CTextForm, result: bool) -> Option[CKind]
    val named = c match
        CKeyword(_) -> true
        CTypedef(_) -> true
        _ -> false
    if !named then return None
    if !(form is NoText) then return if c is CTypedef(_) then Some(if result then KindText else KindConstText) else None
    *avin match
        Int(_) -> Some(KindInteger)
        Byte -> Some(if c is CKeyword(_) then KindInteger else KindByte)
        Bool -> Some(if c is CKeyword(_) then KindInteger else KindBool)
        Real -> if c is CTypedef(_) then Some(KindReal) else None
        _ -> None

/** Whether the C unit measures a type checked as `kind`: integers, truth values and reals are, and
 * strings are pointers, which need no measure. */
c_kind_measured(kind: CKind) -> bool = !(kind is KindText || kind is KindConstText)

/** The name a measurement of a C type is kept under: the type's spelling, and for a typedef in a
 * `real` position `real` before it. */
c_measure_key(c: CType, kind: CKind) -> string
    val name = c match
        CKeyword(n) -> n
        CTypedef(n) -> n
        _ -> ""
    if kind is KindReal then "real " + name else name

/** How a value of the C type `c` crosses as `avin` at the call: the machine form the emitter passes
 * it in, at the width measured. A typedef crossing as `bool` is passed as the integer it measures,
 * which a C `bool` is too, one byte holding 0 or 1. */
c_scalar_of(c: CType, avin: &Type, measures: Map[string, CMeasure]) -> CScalar = c match
    CBoolType -> CBoolean
    CDoubleType -> CBinary64
    CFloatType -> CBinary32
    CTypedef(name) -> *avin match
        Real -> if measured(measures, "real " + name).bits == 32 then CBinary32 else CBinary64
        _ -> integer_scalar(measured(measures, name))
    CKeyword(name) -> integer_scalar(measured(measures, name))
    _ -> panic("only a scalar crosses a C binding by value")

private integer_scalar(m: CMeasure) -> CScalar = if m.signed then CSigned(m.bits) else CUnsigned(m.bits)

private measured(measures: Map[string, CMeasure], key: string) -> CMeasure = measures.get(key) match
    Some(m) -> m
    None -> panic(s"the C unit measured no `$key`")

/** The C integer type `c` as a trap names it: its sign and width, then its spelling, `u64 (size_t)`. */
c_integer_name(c: CType, s: CScalar) -> string
    val spelled = c match
        CKeyword(n) -> n
        CTypedef(n) -> n
        _ -> ""
    val width = s match
        CSigned(bits) -> s"i$bits"
        CUnsigned(bits) -> s"u$bits"
        _ -> ""
    s"$width ($spelled)"
