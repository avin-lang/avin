module dev.avinlang.compiler

import sysl.buf.{Buf, buf}
import sysl.container.Map

// C bindings. A function declared `@c("<prototype>")` without a body is bound to the C function the
// prototype names: the prototype is C's declaration as the library's header writes it, and its
// parameters correspond to the Avin parameters by position. This file reads a prototype into a C
// signature and holds it against the Avin signature, which the checker does at the binding; lowering
// reads it again to convert each argument and the result, at the widths the C unit measured (see
// `cunit.sysl`).

/** A C type as a binding's prototype spells it. */
enum CType
    /** An integer type spelled with C's keywords, in one spelling per type (`unsigned long` for
     * `long unsigned int`), or an enumeration, `enum name`. */
    CKeyword(name: string)
    /** A typedef's name. What kind of type it is the header says, so the C unit checks it is the
     * kind the Avin type asks for. */
    CTypedef(name: string)
    CBoolType
    CDoubleType
    CFloatType
    CVoidType
    /** A C string: one pointer to `char`, `const char *` when `constant`. A pointer qualified after
     * its star, `char *const`, is one too. */
    CText(constant: bool)
    /** Any other pointer. */
    CPointerType
    /** A struct or union by value, `struct name`. */
    CRecordType(name: string)

/** A parameter of a prototype: its type, and the type as C spells it without the parameter's name,
 * which the header check compares. */
struct CParam
    ty: CType
    text: string
    /** The parameter's name, "" where the prototype gives none; `self` is a method's receiver. */
    name: string

/** A prototype read: the C function's symbol, its result and its parameters. */
struct CPrototype
    symbol: string
    result: CType
    result_text: string
    params: Buf[CParam]

/** What a C unit measured of an integer type, or of a typedef in a `real` position: its width in
 * bits, and whether it is signed. */
struct CMeasure
    bits: u32
    signed: bool

/** The prototype a function's `@c` gives, when it has one written as one string. */
c_prototype_text(f: &Function) -> Option[string]
    for a in f.annotations
        if a.name == "c" && a.args.len() >= 1 && a.args[0].name is None
            if a.args[0].value.kind is StringLit(text) then return Some(text)
    None

/** The prototype of a C binding, read; `None` for a function that is not one, or whose prototype the
 * checker has refused. */
c_prototype_of(f: &Function) -> Option[CPrototype] = c_prototype_text(f) match
    Some(text) -> parse_prototype(text) match
        Ok(p) -> Some(p)
        Err(_) -> None
    None -> None

/** Reads a prototype: a result type, the function's name, and its parameters in parentheses, each a
 * type with an optional name; `(void)` and `()` both take none. What cannot cross a C binding at all
 * is refused here, saying why. */
parse_prototype(text: string) -> Result[CPrototype, string]
    val tokens = c_tokens(text)?
    var at = 0usize
    val declared = c_declaration(tokens, &at)?
    val symbol = declared.name match
        Some(n) -> n
        None -> return Err("it names no function: a prototype is a result type, the function's name and its parameters, as in `int abs(int)`")
    if at >= tokens.len() || tokens[at] != "("
        return Err(s"`$symbol` is not followed by its parameters in parentheses")
    at += 1
    var params: Buf[CParam] = buf()
    if at + 1 < tokens.len() && tokens[at] == "void" && tokens[at + 1] == ")"
        at += 1
    elif at < tokens.len() && tokens[at] != ")"
        loop
            if at < tokens.len() && tokens[at] == "..."
                return Err("a variadic function cannot be bound: the types of the arguments `...` takes cannot be checked")
            val p = c_declaration(tokens, &at)?
            if at < tokens.len() && tokens[at] == "("
                return Err("a parameter taking a function cannot cross a C binding: callbacks are not implemented")
            if p.ty is CVoidType then return Err("a parameter cannot be `void`; a function taking nothing is written `(void)`")
            params.push(CParam(p.ty, p.text, p.name.unwrap_or("")))
            if at < tokens.len() && tokens[at] == ","
                at += 1
                continue
            break
    if at >= tokens.len() || tokens[at] != ")"
        return Err(if at < tokens.len() then s"`${tokens[at]}` is not part of a parameter list" else "the parameter list has no closing `)`")
    at += 1
    if at < tokens.len() && tokens[at] == ";" then at += 1
    if at < tokens.len() then return Err(s"`${tokens[at]}` follows the parameter list")
    Ok(CPrototype(symbol, declared.ty, declared.text, params))

// A type and the name after it, as a declaration writes them.
private struct CDeclared
    ty: CType
    text: string
    name: Option[string]

// The type specifiers, qualifiers and pointers of one declaration from `tokens[*at]`, and the name
// after them when there is one.
private c_declaration(tokens: Buf[string], at: *usize) -> Result[CDeclared, string]
    var words: Buf[string] = buf()
    var signed = false
    var unsigned = false
    var short = false
    var longs = 0usize
    var char_word = false
    var int_word = false
    var base: Option[CType] = None
    var name: Option[string] = None
    while *at < tokens.len()
        val t = tokens[*at]
        if !is_c_word(t) then break
        if t == "extern"
            *at = *at + 1
            continue
        if t == "out" || t == "inout" || t == "userdata" || t == "length"
            return Err(s"`$t` parameters are not implemented")
        if t == "static" || t == "inline" || t == "register" || t == "typedef"
            return Err(s"`$t` is not part of a function's prototype")
        if t == "_Complex" || t == "__int128" || t == "_Imaginary"
            return Err(s"`$t` cannot cross a C binding")
        val specifier = t == "signed" || t == "unsigned" || t == "short" || t == "long" || t == "char" || t == "int"
        if specifier
            if base is Some(_) && !(t == "long" && base is Some(CDoubleType))
                return Err(s"`$t` does not combine with the type before it")
            if t == "signed" then signed = true
            elif t == "unsigned" then unsigned = true
            elif t == "short" then short = true
            elif t == "long" then longs += 1
            elif t == "char" then char_word = true
            else int_word = true
            words.push(t)
            *at = *at + 1
            continue
        if t == "const" || t == "volatile" || t == "restrict"
            words.push(t)
            *at = *at + 1
            continue
        val specified = signed || unsigned || short || longs > 0 || char_word || int_word
        val keyword_base = t == "void" || t == "_Bool" || t == "bool" || t == "float" || t == "double"
        if keyword_base
            if base is Some(_) || (specified && !(t == "double" && longs == 1 && !signed && !unsigned && !short && !char_word && !int_word))
                return Err(s"`$t` does not combine with the type before it")
            base = Some(if t == "void" then CVoidType elif t == "float" then CFloatType elif t == "double" then CDoubleType else CBoolType)
            words.push(t)
            *at = *at + 1
            continue
        if t == "struct" || t == "union" || t == "enum"
            if base is Some(_) || specified then return Err(s"`$t` does not combine with the type before it")
            if *at + 1 >= tokens.len() || !is_c_word(tokens[*at + 1]) then return Err(s"`$t` is followed by its tag's name")
            val tag = tokens[*at + 1]
            base = Some(if t == "enum" then CKeyword("enum " + tag) else CRecordType(t + " " + tag))
            words.push(t)
            words.push(tag)
            *at = *at + 2
            continue
        // Any other word is a typedef's name where no type has been said yet, and otherwise the name
        // the declaration declares.
        if base is None && !specified
            base = Some(CTypedef(t))
            words.push(t)
            *at = *at + 1
            continue
        name = Some(t)
        *at = *at + 1
        break
    val specified = signed || unsigned || short || longs > 0 || char_word || int_word
    if base is Some(CDoubleType) && longs > 0 then return Err("`long double` cannot cross a C binding")
    if base is None && !specified
        return Err(if *at < tokens.len() then s"`${tokens[*at]}` is not a C type" else "a type is missing")
    var ty = base match
        Some(b) -> b
        None -> CKeyword(integer_spelling(signed, unsigned, short, longs, char_word)?)
    var text = joined_words(words)
    // Pointers, each perhaps qualified, then the name if it was not before them.
    var pointers = 0usize
    while *at < tokens.len() && name is None
        val t = tokens[*at]
        if t == "*"
            pointers += 1
            text = text + " *"
            *at = *at + 1
        elif pointers > 0 && (t == "const" || t == "volatile" || t == "restrict")
            text = text + t
            *at = *at + 1
        else break
    if name is None && *at < tokens.len() && is_c_word(tokens[*at]) && !is_c_keyword(tokens[*at])
        name = Some(tokens[*at])
        *at = *at + 1
    if *at < tokens.len() && tokens[*at] == "["
        return Err("an array parameter cannot cross a C binding: arrays are not implemented")
    val plain_char = ty match
        CKeyword(n) -> n == "char"
        _ -> false
    if pointers == 1 && plain_char then ty = CText(contains_word(words, "const"))
    elif pointers > 0 then ty = CPointerType
    Ok(CDeclared(ty, text, name))

private contains_word(words: Buf[string], w: string) -> bool
    for x in words
        if x == w then return true
    false

// The one spelling of an integer type its keywords make, `long unsigned int` being `unsigned long`.
private integer_spelling(signed: bool, unsigned: bool, short: bool, longs: usize, char_word: bool) -> Result[string, string]
    if signed && unsigned then return Err("`signed` and `unsigned` do not combine")
    if longs > 2 then return Err("`long long long` is not a C type")
    if (short && (longs > 0 || char_word)) || (char_word && longs > 0) then return Err("those keywords do not make one C type")
    val prefix = if unsigned then "unsigned " else ""
    if char_word then return Ok(if signed then "signed char" elif unsigned then "unsigned char" else "char")
    if short then return Ok(prefix + "short")
    if longs == 2 then return Ok(prefix + "long long")
    if longs == 1 then return Ok(prefix + "long")
    Ok(prefix + "int")

private joined_words(words: Buf[string]) -> string
    var out = ""
    for w in words
        out = if out == "" then w else out + " " + w
    out

// The words, `*`, parentheses, commas, brackets, `;` and `...` a prototype is made of.
private c_tokens(text: string) -> Result[Buf[string], string]
    var out: Buf[string] = buf()
    val b = text.bytes
    var i = 0usize
    while i < b.len
        val ch = b[i]
        if ch == u8(' ') || ch == u8('\t') || ch == u8('\n') || ch == u8('\r')
            i += 1
            continue
        // A word, or a number, which only an array's length is.
        if is_c_word_byte(ch)
            val start = i
            while i < b.len && is_c_word_byte(b[i])
                i += 1
            out.push(text[start..<i])
            continue
        if ch == u8('.') && i + 2 < b.len && b[i + 1] == u8('.') && b[i + 2] == u8('.')
            out.push("...")
            i += 3
            continue
        if ch == u8('*') || ch == u8('(') || ch == u8(')') || ch == u8(',') || ch == u8('[') || ch == u8(']') || ch == u8(';')
            out.push(text[i..<i + 1])
            i += 1
            continue
        return Err(s"`${text[i..<i + 1]}` is not part of a C prototype")
    Ok(out)

private is_c_word_byte(b: u8) -> bool = b >= u8('a') && b <= u8('z') || b >= u8('A') && b <= u8('Z') || b == u8('_') || b >= u8('0') && b <= u8('9')

private is_c_word(t: string) -> bool = t.bytes.len > 0 && is_c_word_byte(t.bytes[0]) && !(t.bytes[0] >= u8('0') && t.bytes[0] <= u8('9'))

/** Whether `t` is a C identifier that is no C keyword, as a function's name is. */
is_c_identifier(t: string) -> bool
    if !is_c_word(t) || is_c_keyword(t) then return false
    for b in t.bytes
        if !is_c_word_byte(b) then return false
    true

private is_c_keyword(t: string) -> bool =
    t == "const" || t == "volatile" || t == "restrict" || t == "void" || t == "char" || t == "short" || t == "int" || t == "long" || t == "signed" || t == "unsigned" || t == "float" || t == "double" || t == "_Bool" || t == "bool" || t == "struct" || t == "union" || t == "enum"

/** A C type written alone, as a handle's `type:` writes it: its type and the text a prototype's
 * parameter of that type has, so the two compare as text. */
struct CTypeText
    ty: CType
    text: string

/** Reads a C type written with no name after it, `cairo_surface_t *` or `FT_Library`. */
parse_c_type(text: string) -> Result[CTypeText, string]
    val tokens = c_tokens(text)?
    var at = 0usize
    val declared = c_declaration(tokens, &at)?
    if declared.name is Some(n) then return Err(s"`$n` follows the type")
    if at < tokens.len() then return Err(s"`${tokens[at]}` is not part of a C type")
    Ok(CTypeText(declared.ty, declared.text))

/** The `@c(…)` a class is declared with, which makes it a handle on a C pointer. */
c_class_annotation(d: &ClassDecl) -> Option[Annotation]
    if d.object then return None
    for a in d.annotations
        if a.name == "c" then return Some(a)
    None

/** The C pointer type a handle class's `@c(type: …)` names, as written. */
c_handle_type(d: &ClassDecl) -> Option[string] = c_class_text(d, "type")

/** The string a handle class's `@c` gives under `key`, `release`, `retain` or `kept`. */
c_class_text(d: &ClassDecl, key: string) -> Option[string]
    val a = c_class_annotation(d)?
    for arg in a.args
        if arg.name is Some(n) && n == key
            if arg.value.kind is StringLit(text) then return Some(text)
    None

/** Whether a handle class's `@c` says `shared`: its C object is safe to use from any thread, so its
 * owner is not checked. */
c_class_shared(d: &ClassDecl) -> bool
    val a = c_class_annotation(d) match
        Some(a) -> a
        None -> return false
    for arg in a.args
        if arg.name is None && arg.value.kind is Name(word) && word == "shared" then return true
    false

/** What a handle class's `kept: "name: Class"` says: the name its `release:` and `retain:` give the
 * one handle of `Class` it keeps, and that class's name as written. */
struct CKept
    name: string
    class_name: string

/** The `kept:` of a handle class, read; `None` where it has none or it is not `name: Class`. */
c_class_kept(d: &ClassDecl) -> Option[CKept]
    val text = c_class_text(d, "kept")?
    val parts = text.split(":")
    if parts.len != 2 then return None
    val name = parts[0].trim()
    val class_name = parts[1].trim()
    if !is_c_identifier(name) || class_name == "" then return None
    Some(CKept(name, class_name))

/** The class a handle class's `kept:` names, by its index: a class of the holder's own module, or one
 * named with its module, `freetype.Face`. */
c_kept_class(classes: Buf[ClassSymbol], holder: usize) -> Option[usize]
    val kept = c_class_kept(classes[holder].decl)?
    var module_name = classes[holder].module_name
    var name = kept.class_name
    val b = kept.class_name.bytes
    var i = b.len
    while i > 0
        i -= 1
        if b[i] == u8('.')
            module_name = kept.class_name[..<i]
            name = kept.class_name[i + 1..]
            break
    for k in 0..<classes.len()
        if classes[k].module_name == module_name && classes[k].name == name then return Some(k)
    None

/** Whether the C expression `text` uses the identifier `name` as a word of its own. */
c_uses_name(text: string, name: string) -> bool
    val b = text.bytes
    var i = 0usize
    while i < b.len
        if is_c_word_byte(b[i])
            val start = i
            while i < b.len && is_c_word_byte(b[i])
                i += 1
            // A word after `.` or `->` is a member's name, not the variable.
            val member = start > 0 && (b[start - 1] == u8('.') || start > 1 && b[start - 1] == u8('>') && b[start - 2] == u8('-'))
            if !member && text[start..<i] == name then return true
            continue
        i += 1
    false

/** Whether a C binding's `@c` says the bare word `word`, `borrowed`. */
c_binding_flag(f: &Function, word: string) -> bool
    for a in f.annotations
        if a.name != "c" then continue
        for arg in a.args
            if arg.name is None && arg.value.kind is Name(w) && w == word then return true
    false

/** The parameters a C binding's `keeps:` or `consumes:` names: one string, or a list of them. */
c_binding_names(f: &Function, key: string) -> Buf[string]
    var out: Buf[string] = buf()
    for a in f.annotations
        if a.name != "c" then continue
        for arg in a.args
            if arg.name != Some(key) then continue
            arg.value.kind match
                StringLit(text) -> out.push(text)
                ListLit(items) ->
                    for item in items
                        if item.kind is StringLit(text) then out.push(text)
                _ -> ()
    out

/** The handle class an Avin type is, or holds as an `Option`'s value: the class's index, and whether
 * it is in an `Option`, which null's `None` is. */
struct CHandleForm
    class_index: usize
    optional: bool

/** The form in which `t` carries a C handle, if it does. */
c_handle_form(t: &Type, data: Buf[DataSymbol], classes: Buf[ClassSymbol]) -> Option[CHandleForm]
    var inner = t
    var optional = false
    *t match
        Data(d, _, args) ->
            if data[d].module_name == "avin" && data[d].name == "Option" && args.len() == 1
                inner = args[0]
                optional = true
        _ -> ()
    *inner match
        Class(k, _, _) -> if c_handle_type(classes[k].decl) is Some(_) then Some(CHandleForm(k, optional)) else None
        _ -> None

/** The error type of a status result, `Result[unit, E]` with `E` an integer type: `Ok(())` for zero
 * and `Err` of the code otherwise. */
c_status_error(t: &Type, data: Buf[DataSymbol]) -> Option[&Type] = *t match
    Data(d, _, args) ->
        if data[d].module_name == "avin" && data[d].name == "Result" && args.len() == 2 && *args[0] is Unit && *args[1] is Int(_) then Some(args[1]) else None
    _ -> None

/** Whether a prototype's position, written `text`, takes or answers the handle whose `type:` reads as
 * `handle`: the same type, or for a parameter that type `const`-qualified, which C passes the same
 * pointer to. */
c_names_handle(text: string, handle: string, result: bool) -> bool
    if text == handle then return true
    !result && text == "const " + handle

/** The function a C binding's `@c(…, free: "name")` names to free the string C answers, when it
 * names one as a string. */
c_free_text(f: &Function) -> Option[string]
    for a in f.annotations
        if a.name != "c" then continue
        for arg in a.args
            if arg.name is Some(n) && n == "free"
                if arg.value.kind is StringLit(text) then return Some(text)
    None

/** How an Avin type carries a C string, for the types that do: a `string`, copied and checked as
 * UTF-8, or an `Array[byte]`, copied as it is, each perhaps in an `Option`, which is null's `None`. */
enum CTextForm
    NoText
    TextString(optional: bool)
    TextBytes(optional: bool)

/** The form in which the Avin type `t` carries a C string, given the program's data types and
 * classes, which say what `Option` and `Array` are. */
c_text_form(t: &Type, data: Buf[DataSymbol], classes: Buf[ClassSymbol]) -> CTextForm
    var inner = t
    var optional = false
    *t match
        Data(d, _, args) ->
            if data[d].module_name == "avin" && data[d].name == "Option" && args.len() == 1
                inner = args[0]
                optional = true
        _ -> ()
    *inner match
        Str -> TextString(optional)
        Class(k, _, args) ->
            val array = classes[k].module_name == "avin" && classes[k].name == "Array" && !classes[k].decl.object
            if array && args.len() == 1 && *args[0] is Byte then TextBytes(optional) else NoText
        _ -> NoText

/** What the Avin type at a C position must be, as a diagnostic says it, or "" where `avin` may cross
 * as `c`; `form` is how `avin` carries a string, if it does. A result whose Avin type is `unit`
 * discards whatever C answers, except a struct, which is passed by value. */
c_crossing_problem(c: CType, avin: &Type, form: CTextForm, result: bool) -> string
    if result && *avin is Unit
        return if c is CRecordType(_) then "a struct passed by value is not implemented" else ""
    if !(form is NoText) then return c_text_problem(c, form, result)
    c match
        CKeyword(name) ->
            if name == "char" then return if *avin is Byte then "" else "a C `char` crosses as `byte`"
            if name == "unsigned char" then return if *avin is Byte || *avin is Int(_) || *avin is Bool then "" else "it crosses as `byte`, an integer type, or `bool` as a truth value"
            if *avin is Int(_) || *avin is Bool then "" else "a C integer crosses as an integer type, or `bool` as a truth value"
        CTypedef(_) -> *avin match
            Int(_) -> ""
            Byte -> ""
            Bool -> ""
            Real -> ""
            _ -> "a typedef crosses as an integer type, `byte`, `bool`, `real` or a string, as the header's type is"
        CBoolType -> if *avin is Bool then "" else "a C `bool` crosses as `bool`"
        CDoubleType -> if *avin is Real then "" else "a C `double` crosses as `real`"
        CFloatType -> if *avin is Real then "" else "a C `float` crosses as `real`"
        CVoidType -> "the C function answers nothing, so the binding's result is `unit`"
        CText(_) -> if result then "a C string crosses as `string`, `Array[byte]`, or either in an `Option`" else "a C string crosses as `string` or `Option[string]`"
        CPointerType -> "a C pointer crosses as a handle, a class declared with `@c(type: …)` naming the pointer's type"
        CRecordType(_) -> "a struct passed by value is not implemented"

// What a string's Avin type `form` must be at the C position `c`, or "".
private c_text_problem(c: CType, form: CTextForm, result: bool) -> string
    val bytes = form is TextBytes(_)
    if !result && bytes then return "an `Array[byte]` parameter is an array, and arrays are not implemented"
    c match
        CText(constant) -> if result || constant then "" else "C may write through a `char *`, so it takes an array rather than a `string`, and arrays are not implemented"
        CTypedef(_) -> ""
        CVoidType -> "the C function answers nothing, so the binding's result is `unit`"
        _ -> "a string crosses as a C `const char *`" + (if result then " or `char *`" else "")

/** How a typedef at a C position must be, by the Avin type it crosses as: the kind the C unit checks.
 * A typedef crossing as `bool` is a C `bool` or an integer type used as a truth value; one crossing
 * as a string is `char *` or `const char *` as a result, and `const char *` as a parameter. */
enum CKind
    KindInteger
    KindByte
    KindBool
    KindReal
    KindText
    KindConstText

/** The kind of type the C type `c` must be to cross as `avin`, carried in `form`, where the C unit
 * checks or measures it: every integer type, which is measured, and every typedef, whose kind is
 * checked. */
c_kind_needed(c: CType, avin: &Type, form: CTextForm, result: bool) -> Option[CKind]
    val named = c match
        CKeyword(_) -> true
        CTypedef(_) -> true
        _ -> false
    if !named then return None
    if !(form is NoText) then return if c is CTypedef(_) then Some(if result then KindText else KindConstText) else None
    *avin match
        Int(_) -> Some(KindInteger)
        Byte -> Some(if c is CKeyword(_) then KindInteger else KindByte)
        Bool -> Some(if c is CKeyword(_) then KindInteger else KindBool)
        Real -> if c is CTypedef(_) then Some(KindReal) else None
        _ -> None

/** Whether the C unit measures a type checked as `kind`: integers, truth values and reals are, and
 * strings are pointers, which need no measure. */
c_kind_measured(kind: CKind) -> bool = !(kind is KindText || kind is KindConstText)

/** The name a measurement of a C type is kept under: the type's spelling, and for a typedef in a
 * `real` position `real` before it. */
c_measure_key(c: CType, kind: CKind) -> string
    val name = c match
        CKeyword(n) -> n
        CTypedef(n) -> n
        _ -> ""
    if kind is KindReal then "real " + name else name

/** How a value of the C type `c` crosses as `avin` at the call: the machine form the emitter passes
 * it in, at the width measured. A typedef crossing as `bool` is passed as the integer it measures,
 * which a C `bool` is too, one byte holding 0 or 1. */
c_scalar_of(c: CType, avin: &Type, measures: Map[string, CMeasure]) -> CScalar = c match
    CBoolType -> CBoolean
    CDoubleType -> CBinary64
    CFloatType -> CBinary32
    CTypedef(name) -> *avin match
        Real -> if measured(measures, "real " + name).bits == 32 then CBinary32 else CBinary64
        _ -> integer_scalar(measured(measures, name))
    CKeyword(name) -> integer_scalar(measured(measures, name))
    _ -> panic("only a scalar crosses a C binding by value")

private integer_scalar(m: CMeasure) -> CScalar = if m.signed then CSigned(m.bits) else CUnsigned(m.bits)

private measured(measures: Map[string, CMeasure], key: string) -> CMeasure = measures.get(key) match
    Some(m) -> m
    None -> panic(s"the C unit measured no `$key`")

/** The C integer type `c` as a trap names it: its sign and width, then its spelling, `u64 (size_t)`. */
c_integer_name(c: CType, s: CScalar) -> string
    val spelled = c match
        CKeyword(n) -> n
        CTypedef(n) -> n
        _ -> ""
    val width = s match
        CSigned(bits) -> s"i$bits"
        CUnsigned(bits) -> s"u$bits"
        _ -> ""
    s"$width ($spelled)"
