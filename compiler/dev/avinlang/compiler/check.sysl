module dev.avinlang.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.text.from_utf8_unchecked

/** A source file in a program, with the report its diagnostics go to. */
struct SourceUnit
    src: Source
    file: SourceFile
    report: Report

/** A function's signature and where it was declared. */
struct FunctionSymbol
    unit: usize
    module_name: string
    name: string
    decl: &Function
    params: Buf[&Type]
    param_names: Buf[string]
    /** The declared result type, or the one inferred from the body once it has been checked. */
    result: Option[&Type]
    intrinsic: Option[string]
    /** For a local function, the top-level function it is declared in. */
    root: Option[usize]
    /** For a local function, the locals its parameters are stored in. */
    param_locals: Buf[usize]
    /** For a local function, the enclosing locals and top-level parameters it uses, directly or
     * through the local functions it calls. */
    captured_locals: Buf[usize]
    captured_params: Buf[usize]
    /** Whether this is a lambda, which has no name of its own. */
    lambda: bool
    /** Whether this lambda is an argument to a by-name parameter, an expression evaluated at each
     * read, which `return`, `break` and `continue` cannot leave. */
    delayed: bool
    /** Whether the function is used as a value somewhere, so a closure of it is made. */
    value: bool
    /** For each parameter with a default, the function that computes it: it takes the parameters
     * before that one, a method's receiver first, and yields the default, evaluated in this
     * function's declaration scope. An override shares the defaults of the method it overrides. */
    defaults: Buf[Option[usize]]
    /** For a function that computes a default, the parameter it is the default of. */
    default_param: Option[string]
    /** The owner of the type parameters the function's types name, and those parameters: for a
     * top-level function, itself and its own; for a constructor, its class's; for a method, its
     * class's followed by its own, all owned by `class_owner` of the class. */
    type_owner: usize
    type_params: Buf[TypeParam]
    /** For a method or a constructor, its class. A method's first parameter is its receiver,
     * `self`. */
    owner_class: Option[usize]
    constructor: bool
    /** Whether code outside the method's class may call it. */
    public: bool
    /** For a function that shares its name with others in its scope, and for the functions that
     * compute its defaults, its parameter types as written, as in `(int, string)`, which tell the
     * overloads apart in the object file; empty otherwise. */
    overload: string
    /** For a method an `impl` adds to a data type or a built-in type, the type of its receiver,
     * `self`, with the impl's type parameters as its arguments. Such a method is called directly:
     * the type has no subclasses. A class's methods, its impls' included, have `owner_class`. */
    receiver: Option[&Type]

/** A class. Its fields are its parameters, in order, then the fields its body declares; their types
 * name the class's own type parameters as `TypeVar(class_owner(id), i)`. */
struct ClassSymbol
    unit: usize
    module_name: string
    name: string
    decl: &ClassDecl
    fields: Buf[FieldSymbol]
    /** The symbols of its methods, in declaration order. */
    methods: Buf[usize]
    constructor: usize
    /** While the class body is checked, how many fields its code has initialized so far. */
    ready: usize
    /** The superclass, its type arguments written in this class's own type parameters. */
    superclass: Option[&Type]
    /** How many of `fields` the class inherits: the superclass's fields lead, in the superclass's
     * order, so the superclass's code finds each at the offset it expects. */
    inherited: usize
    /** The function the class body is checked as. For a final class it is the constructor. For an
     * open or abstract class it takes the object as its first parameter, so a subclass's constructor
     * runs it on the subclass's object; the class's own constructor allocates and then calls it. */
    initializer: usize
    /** The method in each slot of the class's method table: the superclass's slots first, in the
     * same positions, each holding this class's override where it has one, then a slot for each
     * method the class adds that a subclass may override. */
    slots: Buf[usize]
    /** For each of `methods`, whether it is declared `override`. */
    overriding: Buf[bool]
    /** 0 before the class's superclass is linked, 1 while it is, 2 after. */
    linked: u8
    /** For an object, the class of the same name in its module; for a class, that object. Each may
     * use the other's private members. */
    companion: Option[usize]
    /** For an object, the module-level value that holds its one instance. */
    global: Option[usize]
    /** The traits written after `:`, their type arguments in the class's own type parameters: for a
     * class the traits it conforms to, for a trait the traits it requires. */
    traits: Buf[&Type]
    /** For a class, its whole method table: `slots` first, then each method of every trait the class
     * conforms to, at that trait's `base`. A position no trait of the class uses, or one holding an
     * abstract method, is empty. */
    table: Buf[Option[usize]]
    /** For a trait, the position of its first method in the table of every class conforming to it;
     * its methods follow in declaration order. */
    base: usize

/** A module-level value: a `val` or `var` declared at the top level of a file, or an object's one
 * instance. Each is computed once, before `main` runs, by its `init` function: a value's initializer,
 * checked as a function with no parameters, or an object's constructor. Its type is that function's
 * result. */
struct GlobalSymbol
    unit: usize
    module_name: string
    name: string
    span: Span
    mutable: bool
    init: usize
    /** For an object, its class. */
    object: Option[usize]

/** A field of a class; `ty` is `None` until the constructor's check infers it from the field's
 * initializer, when the declaration has no type. */
struct FieldSymbol
    name: string
    span: Span
    ty: Option[&Type]
    mutable: bool
    public: bool
    param: bool
    /** The class that declares the field: a subclass inherits its superclass's fields. */
    owner: usize

/** A `data` type and its variants. Field types name the type's own parameters as
 * `TypeVar(data_owner(id), i)`, so a field of a particular value's type is its declared type with the
 * value's type arguments substituted. */
struct DataSymbol
    unit: usize
    module_name: string
    name: string
    decl: &DataDecl
    variants: Buf[VariantSymbol]
    /** The methods its impls add, in declaration order; each takes the value as `self`. */
    methods: Buf[usize]
    /** For each of `methods`, whether an impl of a trait declares it. */
    implementing: Buf[bool]
    /** The traits its impls make it conform to, their type arguments in the type's own parameters. */
    traits: Buf[&Type]
    /** Its method table, which every variant's descriptor carries: at each conformed trait's `base`,
     * the implementation of each of the trait's methods, the type's own method of that name or the
     * trait's default body. Empty when the type conforms to no trait. */
    table: Buf[Option[usize]]

/** One constructor of a data type. */
struct VariantSymbol
    name: string
    span: Span
    field_names: Buf[string]
    fields: Buf[&Type]

/** A variant, by its data type's index and its own position among the type's variants. */
struct VariantRef
    data: usize
    index: usize

/** The type of a data value, with the type's own parameters as its arguments. */
own_type(d: DataSymbol, id: usize) -> &Type
    var args: Buf[&Type] = buf()
    for i in 0..<d.decl.type_params.len()
        args.push(TypeVar(data_owner(id), i, d.decl.type_params[i].name))
    Data(id, d.name, args)

/** The field types of a variant for a value of type `Data(id, _, args)`. */
variant_fields(d: DataSymbol, id: usize, variant: usize, args: Buf[&Type]) -> Buf[&Type] =
    substitute_all(d.variants[variant].fields, data_owner(id), args)

/** A `break` the checker has seen, kept until its loop's type is known. */
struct BreakSite
    label: usize
    span: Span
    ty: &Type

/** What the checker knows inside one function body. Checking a call to a function whose result is
 * inferred checks that function's body first, so this is saved and restored around it. */
/** A use of an enclosing local (`param` false) or top-level parameter by a local function. */
struct CaptureUse
    function: usize
    index: usize
    param: bool

struct LocalCall
    caller: usize
    callee: usize

/** A call to a local function made before its declaration, with the locals initialized there. */
struct EarlyCall
    callee: usize
    span: Span
    initialized: Buf[usize]

struct BodyState
    /** The top-level function being checked. */
    root: usize
    locals: Buf[TLocal]
    /** The locals in scope, innermost last. */
    visible: Buf[usize]
    /** The loops enclosing the current expression, innermost last. */
    loops: Buf[usize]
    breaks: Buf[BreakSite]
    labels: usize
    /** Where the innermost block's locals start in `visible`. */
    block_start: usize
    /** The local functions in scope, innermost last. */
    functions: Buf[usize]
    /** For each of `functions`, where its block's local functions start in `functions`. */
    function_starts: Buf[usize]
    uses: Buf[CaptureUse]
    calls: Buf[LocalCall]
    early: Buf[EarlyCall]

fresh_body(root: usize) -> BodyState = BodyState(root, buf(), buf(), buf(), buf(), 0, 0, buf(), buf(), buf(), buf(), buf())

/** A class body checked part way: its initializer's body so far, the code checked so far, the next
 * member to check and the next field it declares. */
struct Construction
    body: BodyState
    items: Buf[&TExpr]
    receiver: &TExpr
    member: usize
    index: usize
    finishes: bool

struct GenericScope
    owner: usize
    params: Buf[TypeParam]

/** Type arguments written before every conformance is known, for the parameters `params` of `owner`,
 * held to their bounds once they are, in the generic scope they were written in. */
struct PendingBound
    unit: usize
    at: Span
    what: string
    owner: usize
    params: Buf[TypeParam]
    args: Buf[&Type]
    scope: Option[GenericScope]

/** An `impl` block, resolved. `target` is the type it adds to, with the impl's type parameters as its
 * arguments, which are the type's own: `owner` owns them, `data_owner` or `class_owner` of the type.
 * `trait` is the trait it makes the type conform to. An impl found invalid has the error type as its
 * target, and its methods are not declared. */
struct ImplSymbol
    unit: usize
    module_name: string
    decl: &ImplDecl
    target: &Type
    owner: usize
    trait_type: Option[&Type]

struct Checker
    units: Buf[SourceUnit]
    symbols: Buf[FunctionSymbol]
    data: Buf[DataSymbol]
    /** The data types and variants, by qualified name: `a.b.Shape`, or `Shape` in the root module. */
    types: Map[string, usize]
    variants: Map[string, VariantRef]
    classes: Buf[ClassSymbol]
    /** The classes, by qualified name, and the standalone objects, whose types are named after them. */
    class_types: Map[string, usize]
    globals: Buf[GlobalSymbol]
    /** The module-level values and objects, by qualified name. */
    global_names: Map[string, usize]
    /** 0: not yet checked, 1: being checked, 2: checked. */
    states: Buf[u8]
    bodies: Buf[Option[&TExpr]]
    locals: Buf[Buf[TLocal]]
    /** The top-level functions and class constructors, by qualified name: several when the name is
     * overloaded. */
    scope: Map[string, Buf[usize]]
    current: usize
    body: BodyState
    /** The bindings of inference variables: `None` while a variable is unsolved. */
    vars: Buf[Option[&Type]]
    /** The type parameters in scope, and the generic function they belong to. */
    generic: Option[GenericScope]
    /** Whether the names a pattern binds are assignable: set while a `var` binding's pattern is
     * checked. */
    binds_var: bool
    /** Whether a superclass's constructor arguments are being checked: they run before the class
     * stores its parameters, so a parameter's name reads the argument itself, not its field. */
    super_args: bool
    impls: Buf[ImplSymbol]
    /** The methods impls add to built-in types, each with its `receiver`. */
    builtin_methods: Buf[usize]
    /** For each class, how far its body is checked: 0 not begun, 1 being checked, 2 stopped after
     * the fields another function needed, 3 checked. */
    building: Buf[u8]
    /** For each class whose body is stopped part way, where to resume it. */
    constructions: Buf[Option[Construction]]
    /** The traits' `val` members: each an abstract method of no parameters that a read with field
     * syntax calls. */
    trait_fields: Buf[usize]
    /** The methods made to read a field where it supplies a trait's `val`: each yields its field. */
    field_getters: Buf[usize]
    /** The bounds of each type parameter that has any, resolved where it is declared, by
     * `bound_key`. */
    bounds: Map[string, Buf[&Type]]
    /** The trait whose methods are being declared or checked, which `Self` names the implementer
     * of. */
    self_trait: Option[usize]
    /** Whether the type being resolved is a bound or the trait of an impl, where a trait that
     * mentions `Self` may be named. */
    bound_context: bool
    /** Whether every type's conformances are known, so a type argument can be held to its bounds
     * where it is written; before then, each check waits in `pending`. */
    conformances_known: bool
    pending: Buf[PendingBound]
    /** For each unit, its module and the names its imports bring in. */
    files: Buf[FileScope]
    /** The declarations marked `private`, by qualified name: seen only inside their modules. */
    private_names: Map[string, bool]
    /** The program's root module, which declares `main`. */
    root_module: string

    note(*self, unit: usize, at: Span, message: string)
        self.units[unit].report.add(error(at, message))
end Checker

struct Checked
    units: Buf[SourceUnit]
    program: Option[TProgram]

    has_errors(self) -> bool
        for u in self.units
            if u.report.has_errors() then return true
        false

    /** Every diagnostic, rendered against its own source. */
    render(self) -> string
        var out = ""
        for u in self.units
            if u.report.has_errors() then out = out + u.report.render(u.src)
        out
end Checked

/** The core library's module. Its public declarations are seen by every file without an import, and
 * the built-in types belong to it. */
const CoreModule: string = "avin"

/** What a file sees besides its own module's declarations and the core library's: each name its
 * imports bring in, bound to the qualified name of the declaration it imports. */
struct FileScope
    module_name: string
    imports: Map[string, string]

/** The name a declaration `name` of module `module_name` has in the symbol tables: `a.b.name`, or
 * `name` alone in the root module. A declaration's name holds no dot, so two declarations of
 * different modules never share one. */
qualified(module_name: string, name: string) -> string = if module_name == "" then name else module_name + "." + name

/** Whether a declaration has the qualified name `key`, whatever kind it is. */
private declared(c: *Checker, key: string) -> bool =
    c.types.get(key) is Some(_) || c.class_types.get(key) is Some(_) || c.variants.get(key) is Some(_) ||
        c.global_names.get(key) is Some(_) || c.scope.get(key) is Some(_)

/** Whether the declaration named `key` may be seen from another module: it is not `private`. A
 * function's name is while any of its overloads is public. */
private exported(c: *Checker, key: string) -> bool
    if c.private_names.get(key) is Some(_) then return false
    if c.scope.get(key) is Some(ids)
        for id in ids
            if c.symbols[id].public then return true
        return false
    true

/** The qualified name a bare `name` denotes in a unit: its own module's declaration of that name,
 * else the one the file imports under it, else the core library's public one. The nearer hides the
 * farther whatever kind each is, so a module's function hides a core library type of its name. When
 * none exists, the module's own, which no table holds, so the use is reported as unknown. */
private resolve_name(c: *Checker, unit: usize, name: string) -> string
    val scope = c.files[unit]
    val own = qualified(scope.module_name, name)
    if declared(c, own) then return own
    if scope.imports.get(name) is Some(key) then return key
    val core = qualified(CoreModule, name)
    if declared(c, core) && exported(c, core) then return core
    own

private file_scope(c: *Checker, unit: usize) -> FileScope
    val file = c.units[unit].file
    var imports: Map[string, string] = map()
    for i in file.imports
        if imports.get(i.binding) is None then imports.put(i.binding, i.path)
    FileScope(file.module_name, imports)

private module_exists(c: *Checker, name: string) -> bool
    for f in c.files
        if f.module_name == name then return true
    false

// Each import of a unit names a public declaration of another module, under a name the file does not
// already use. An import found wrong is reported and dropped, so its uses are reported as unknown
// names rather than resolved to something the import did not mean.
private check_imports(c: *Checker, unit: usize)
    val file = c.units[unit].file
    val own = file.module_name
    var kept: Map[string, string] = map()
    for i in file.imports
        var dot: Option[usize] = None
        for k in 0..<i.path.bytes.len
            if i.path.bytes[k] == u8('.') then dot = Some(k)
        val at = dot match
            Some(k) -> k
            None ->
                if module_exists(c, i.path) then c.note(unit, i.span, s"`${i.path}` is a module; an import names its declarations, as in `import ${i.path}.{Name}`")
                else c.note(unit, i.span, s"`${i.path}` is not a declaration of a module; an import names one, as in `import a.b.{Name}`")
                continue
        val module_name = i.path[0..<at]
        val name = i.path[at + 1..]
        if module_name == own
            c.note(unit, i.span, s"`$name` is declared in this module, which sees it without an import")
            continue
        if !module_exists(c, module_name)
            if module_exists(c, i.path) then c.note(unit, i.span, s"`${i.path}` is a module; an import names its declarations, as in `import ${i.path}.{Name}`")
            else c.note(unit, i.span, s"unknown module `$module_name`")
            continue
        if !declared(c, i.path)
            c.note(unit, i.span, s"module `$module_name` declares no `$name`")
            continue
        if !exported(c, i.path)
            c.note(unit, i.span, s"`$name` is private to module `$module_name`")
            continue
        val local = qualified(own, i.binding)
        if declared(c, local)
            var companion = false
            if c.class_types.get(local) is Some(k)
                if c.classes[k].decl.object
                    if c.class_types.get(i.path) is Some(j)
                        if !c.classes[j].decl.object then companion = true
            if companion then c.note(unit, i.span, s"`${i.binding}` is a class of module `$module_name`; its companion object is declared in the class's own module")
            else c.note(unit, i.span, s"`${i.binding}` is imported and also declared in this module")
            continue
        if kept.get(i.binding) is Some(earlier)
            c.note(unit, i.span, s"`${i.binding}` is already imported, from `$earlier`")
            continue
        kept.put(i.binding, i.path)
    c.files[unit].imports = kept

/** Checks a program: the core library's units, then the program's own, each heading its module's
 * name in `file.module_name`. `root_module` is the module that must declare `main`, and the last
 * unit is one of its files. Every file sees its own module's declarations, the names it imports and
 * the core library's public declarations, in that order: an inner name hides an outer one. */
check_program(units: Buf[SourceUnit], root_module: string) -> Checked
    var c = Checker(units, buf(), buf(), map(), map(), buf(), map(), buf(), map(), buf(), buf(), buf(), map(), 0, fresh_body(0), buf(), None, false, false, buf(), buf(), buf(), buf(), buf(), buf(), map(), None, false, false, buf(), buf(), map(), root_module)
    for u in 0..<c.units.len()
        c.files.push(file_scope(&c, u))
    // Every type is named before any is used, so a data type may refer to itself or to one
    // declared after it, and functions are declared once every type is known. A class is named
    // before any object, so an object finds its companion in any file of the module.
    for u in 0..<c.units.len()
        declare_types(&c, u)
    for u in 0..<c.units.len()
        declare_objects(&c, u)
    for u in 0..<c.units.len()
        declare_impls(&c, u)
    for u in 0..<c.units.len()
        declare_variants(&c, u)
        declare_fields(&c, u)
    // A subclass's fields and methods follow its superclass's, wherever either is declared.
    for id in 0..<c.classes.len()
        inherit_fields(&c, id)
    for u in 0..<c.units.len()
        declare_unit(&c, u)
        declare_methods(&c, u)
    for i in 0..<c.impls.len()
        declare_impl_methods(&c, i)
    var linked: Buf[bool] = buf()
    for _ in c.classes
        linked.push(false)
    break_trait_cycles(&c)
    for id in 0..<c.classes.len()
        link_methods(&c, id, &linked)
    place_traits(&c)
    // Type arguments written in declarations are held to their bounds once every conformance is known.
    c.conformances_known = true
    for p in c.pending
        val outer_generic = c.generic
        c.generic = p.scope
        hold_to_bounds(&c, p.unit, p.at, p.what, p.owner, p.params, p.args, 0)
        c.generic = outer_generic
    c.pending = buf()
    for u in 0..<c.units.len()
        declare_globals(&c, u)
    for u in 0..<c.units.len()
        check_imports(&c, u)
    for _ in c.classes
        c.building.push(0)
        c.constructions.push(None)
    // Class bodies first: a function a body calls then finds each field the body declared before
    // the call already typed, and a field whose type needs itself is reported by name.
    for k in 0..<c.classes.len()
        val init = c.classes[k].initializer
        if c.symbols[init].owner_class is Some(owner) && owner == k then check_function(&c, init)
    for id in 0..<c.symbols.len()
        check_function(&c, id)
    for id in 0..<c.classes.len()
        settle_inherited_fields(&c, id)
        check_override_results(&c, id)
        check_class_variance(&c, id)
    check_initialization(&c)
    for id in 0..<c.data.len()
        check_data_implementations(&c, id)
        check_data_variance(&c, id)
    for g in 0..<c.globals.len()
        settle_global(&c, g)
    val init = initializer(&c, initialization_order(&c))
    var main_unit = c.units.len() - 1
    var entry: Option[usize] = None
    c.scope.get(qualified(root_module, "main")) match
        Some(ids) ->
            entry = Some(ids[0])
            main_unit = c.symbols[ids[0]].unit
            if ids.len() > 1 then c.note(c.symbols[ids[1]].unit, c.symbols[ids[1]].decl.name_span, "`main` cannot be overloaded")
        None -> ()
    entry match
        Some(id) ->
            // The entry function takes nothing and yields unit or an integer, which becomes the
            // exit status.
            val main = c.symbols[id]
            if main.params.len() > 0 then c.note(main_unit, main.decl.name_span, "`main` takes no parameters")
            if main.decl.type_params.len() > 0 then c.note(main_unit, main.decl.name_span, "`main` cannot be generic")
            val result = main.result.unwrap_or(ErrorType)
            if !(*result is Unit || *result is Int(_) || *result is ErrorType)
                c.note(main_unit, main.decl.name_span, s"`main` yields unit or an integer, not ${type_name(result)}")
        None -> c.note(main_unit, Span(0, 0), "a program needs a `main` function")
    var failed = false
    for u in c.units
        if u.report.has_errors() then failed = true
    if failed then return Checked(c.units, None)
    val id = entry.unwrap()
    var functions: Buf[TFunction] = buf()
    for i in 0..<c.symbols.len()
        functions.push(TFunction(i, c.bodies[i], c.locals[i]))
    var sources: Buf[Source] = buf()
    for u in c.units
        sources.push(u.src)
    Checked(c.units, Some(TProgram(sources, c.symbols, c.data, c.classes, c.globals, functions, c.vars, id, init)))

private declare_unit(c: *Checker, unit: usize)
    val file = c.units[unit].file
    for i in 0..<file.items.len()
        file.items[i] match
            FunctionItem(f) ->
                // A module's functions of a name overload one another, in whichever of its files
                // each is declared, and hide the core library's.
                val key = qualified(file.module_name, f.name)
                var set: Buf[usize] = buf()
                if c.scope.get(key) is Some(ids)
                    for other in ids
                        if !c.symbols[other].constructor then set.push(other)
                val id = c.symbols.len()
                var symbol = signature(c, unit, file.module_name, f, id, f.type_params, false)
                symbol.public = !file.private_items[i]
                if same_as_overload(c, symbol, set)
                    c.note(unit, f.name_span, s"`${f.name}` is declared more than once with the same parameter types; overloads differ in their parameter types, and a function that chooses by its arguments' values is written with clauses")
                    continue
                if set.len() == 0 && c.variants.get(key) is Some(v)
                    c.note(unit, f.name_span, s"`${f.name}` is already a variant of `${c.data[v.data].name}`")
                if set.len() == 0 && c.class_types.get(key) is Some(k)
                    if c.classes[k].decl.object then c.note(unit, f.name_span, s"`${f.name}` is already an object")
                    else c.note(unit, f.name_span, s"`${f.name}` is already a class, which is called to make one")
                c.symbols.push(symbol)
                c.states.push(0)
                c.bodies.push(None)
                c.locals.push(buf())
                declare_defaults(c, id)
                set.push(id)
                c.scope.put(key, set)
                if set.len() > 1 then mark_overloads(c, set)
            DataItem(_) -> ()
            ClassItem(_) -> ()
            ImplItem(_) -> ()
            ValueItem(_) -> ()

// Whether a function declared with `symbol` has the same parameter types as one of `others`, so that
// no call could choose between them. Two overloads are the same when each accepts the other's
// parameter types: so `f[T](x: T)` and `f[U](x: U)` are, and whether a parameter is by-name does not
// tell two apart.
private same_as_overload(c: *Checker, symbol: FunctionSymbol, others: Buf[usize]) -> bool
    // A parameter type already reported as unknown tells nothing apart.
    for p in symbol.params
        if *p is ErrorType then return false
    for other in others
        val o = c.symbols[other]
        if o.params.len() != symbol.params.len() then continue
        if accepts(c, o.params, o.type_owner, o.type_params.len(), symbol.params) && accepts(c, symbol.params, symbol.type_owner, symbol.type_params.len(), o.params)
            return true
    false

// Gives every function of an overload set, and the functions computing their defaults, its parameter
// types, which name it apart from the others in the object file.
private mark_overloads(c: *Checker, set: Buf[usize])
    for id in set
        var text = "("
        val params = c.symbols[id].params
        // A method's receiver is the same in all its overloads.
        val first = if is_method(c.symbols[id]) then 1usize else 0usize
        for i in first..<params.len()
            if i > first then text = text + ", "
            text = text + type_name(params[i])
        text = text + ")"
        c.symbols[id].overload = text
        for d in c.symbols[id].defaults
            if d is Some(default) then c.symbols[default].overload = text

// Whether a function with the parameter types `general`, whose own `type_params` type parameters
// belong to `owner`, accepts arguments of the types `specific`, once those type parameters are
// solved. The inference variables it makes and solves are discarded, whatever it answers.
private accepts(c: *Checker, general: Buf[&Type], owner: usize, type_params: usize, specific: Buf[&Type]) -> bool
    if general.len() != specific.len() then return false
    val saved = save_vars(c)
    var type_args: Buf[&Type] = buf()
    for _ in 0..<type_params
        type_args.push(fresh_var(c))
    var ok = true
    for i in 0..<general.len()
        if ok && !unify(c, strict(substitute(general[i], owner, type_args)), strict(specific[i])) then ok = false
    restore_vars(c, saved)
    ok

/** A parameter's type with any by-name marker removed. */
private strict(t: &Type) -> &Type = *t match
    ByName(inner) -> inner
    _ -> t

private save_vars(c: *Checker) -> Buf[Option[&Type]]
    var saved: Buf[Option[&Type]] = buf()
    for v in c.vars
        saved.push(v)
    saved

private restore_vars(c: *Checker, saved: Buf[Option[&Type]])
    c.vars.truncate(saved.len())
    for i in 0..<saved.len()
        c.vars.set(i, saved[i])

private declare_types(c: *Checker, unit: usize)
    val file = c.units[unit].file
    for i in 0..<file.items.len()
        if file.items[i] is DataItem(d)
            val key = qualified(file.module_name, d.name)
            if builtin_type(d.name) is Some(_)
                c.note(unit, d.span, s"`${d.name}` is a built-in type, so it cannot be declared")
                continue
            if c.types.get(key) is Some(_) || c.class_types.get(key) is Some(_)
                c.note(unit, d.span, s"the type `${d.name}` is declared more than once")
                continue
            if file.private_items[i] then c.private_names.put(key, true)
            for a in d.annotations
                c.note(unit, a.span, s"unknown annotation `@${a.name}`")
            for t in d.derives
                c.note(unit, t.span, "`derives` is not implemented")
            c.types.put(key, c.data.len())
            c.data.push(DataSymbol(unit, file.module_name, d.name, d, buf(), buf(), buf(), buf(), buf()))
    for i in 0..<file.items.len()
        if file.items[i] is ClassItem(d)
            if d.object then continue
            val key = qualified(file.module_name, d.name)
            if builtin_type(d.name) is Some(_)
                c.note(unit, d.name_span, s"`${d.name}` is a built-in type, so it cannot be declared")
                continue
            if c.types.get(key) is Some(_) || c.class_types.get(key) is Some(_)
                c.note(unit, d.name_span, s"the type `${d.name}` is declared more than once")
                continue
            if file.private_items[i] then c.private_names.put(key, true)
            c.class_types.put(key, c.classes.len())
            c.classes.push(ClassSymbol(unit, file.module_name, d.name, d, buf(), buf(), 0, 0, None, 0, 0, buf(), buf(), 0, None, None, buf(), buf(), 0))

// An object is a class with one instance. Named after a class of its module, in any of the module's
// files, it is that class's companion and its type has no name of its own; otherwise its name is
// also its type's. A class and its companion are one name, so a companion is private where its class
// is.
private declare_objects(c: *Checker, unit: usize)
    val file = c.units[unit].file
    for i in 0..<file.items.len()
        if file.items[i] is ClassItem(d)
            if !d.object then continue
            val key = qualified(file.module_name, d.name)
            if builtin_type(d.name) is Some(_)
                c.note(unit, d.name_span, s"`${d.name}` is a built-in type, so it cannot be declared")
                continue
            val id = c.classes.len()
            var companion: Option[usize] = None
            if c.class_types.get(key) is Some(k)
                if c.classes[k].decl.object || c.classes[k].companion is Some(_)
                    c.note(unit, d.name_span, s"the object `${d.name}` is declared more than once")
                    continue
                companion = Some(k)
                c.classes[k].companion = Some(id)
            elif c.types.get(key) is Some(_)
                c.note(unit, d.name_span, s"`${d.name}` is already a data type; an object may share its name only with a class")
                continue
            else
                c.class_types.put(key, id)
                if file.private_items[i] then c.private_names.put(key, true)
            c.classes.push(ClassSymbol(unit, file.module_name, d.name, d, buf(), buf(), 0, 0, None, 0, 0, buf(), buf(), 0, companion, None, buf(), buf(), 0))

// Each impl's type and trait, resolved with the impl's type parameters in scope. They are the type's
// own parameters under the names the impl gives them, so `impl[T] Box[T]` lists them in order. What
// an impl may hold, and where it may be written, is reported here once: an impl lives in the module
// of its type or of its trait, and the built-in types belong to the core library's module, the
// prelude's. A data type's conformances are recorded here; a class's join those its header states
// when its fields are declared.
private declare_impls(c: *Checker, unit: usize)
    val file = c.units[unit].file
    for item in file.items
        if item is ImplItem(d) then c.impls.push(resolve_impl(c, unit, file.module_name, d))

private resolve_impl(c: *Checker, unit: usize, module_name: string, d: &ImplDecl) -> ImplSymbol
    val invalid = ImplSymbol(unit, module_name, d, ErrorType, 0, None)
    // An impl's parameters are its type's, bounded where the type declares them; a bound of the
    // impl's own would make the conformance hold for some type arguments only.
    for tp in d.type_params
        if tp.bounds.len() > 0 then c.note(unit, tp.span, s"an impl's type parameters take the bounds of its type's, so `${tp.name}` cannot have one of its own; an impl for some type arguments only is not implemented")
        if !(tp.variance is Invariant) then c.note(unit, tp.span, "variance is written on the parameters of a type, not of an impl")
    for m in d.members
        m match
            FieldMember(f) -> c.note(unit, f.span, s"an impl adds methods, not state, so it cannot declare the field `${f.name}`")
            AbstractFieldMember(f) -> c.note(unit, f.span, s"an impl adds methods, not state, so it cannot declare the field `${f.name}`")
            StatementMember(s) -> c.note(unit, s.span, "an impl's body declares only methods")
            MethodMember(_, _, _) -> ()
    val path = d.target.kind match
        Named(p, _) -> p
        _ ->
            c.note(unit, d.target.span, "an impl adds to a data type, a class, an object or a built-in type")
            return invalid
    val written = d.target.kind match
        Named(_, args) -> args
        _ -> buf()
    var owner = 0usize
    var home = ""
    val key = resolve_name(c, unit, path)
    if c.types.get(key) is Some(id)
        owner = data_owner(id)
        home = c.data[id].module_name
    elif c.class_types.get(key) is Some(id)
        if is_trait(c, id)
            c.note(unit, d.target.span, s"`$path` is a trait; an impl adds to a data type, a class, an object or a built-in type")
            return invalid
        owner = class_owner(id)
        home = c.classes[id].module_name
    elif builtin_type(path) is Some(_) then home = CoreModule
    else
        c.note(unit, d.target.span, s"unknown type `$path`")
        return invalid
    // The arguments written on the type are the impl's parameters, in order.
    var in_order = written.len() == d.type_params.len()
    if in_order
        for i in 0..<written.len()
            written[i].kind match
                Named(n, inner) -> if n != d.type_params[i].name || inner.len() > 0 then in_order = false
                _ -> in_order = false
    if !in_order
        c.note(unit, d.target.span, "the type an impl adds to takes the impl's type parameters, in order, as in `impl[T] Box[T]`")
        return invalid
    val outer_generic = c.generic
    c.generic = Some(GenericScope(owner, d.type_params))
    val target = resolve_type(c, unit, d.target)
    var trait_type: Option[&Type] = None
    var trait_home = ""
    if d.trait_name is Some(written_trait)
        val t = resolve_bound(c, unit, written_trait)
        *t match
            Class(k, _, _) ->
                if is_trait(c, k)
                    trait_type = Some(t)
                    trait_home = c.classes[k].module_name
                else c.note(unit, written_trait.span, s"`${c.classes[k].name}` is not a trait; an impl names a trait before `for`")
            ErrorType -> ()
            _ -> c.note(unit, written_trait.span, s"${type_name(t)} is not a trait; an impl names a trait before `for`")
    c.generic = outer_generic
    if *target is ErrorType then return invalid
    if d.trait_name is Some(_) && trait_type is None then return invalid
    if module_name != home && (trait_type is None || module_name != trait_home)
        if trait_type is None then c.note(unit, d.target.span, s"`$path` is declared in another module; an impl adding methods to it belongs in that module")
        else c.note(unit, d.target.span, s"neither `$path` nor `${type_name(trait_type.unwrap())}` is declared in this module; an impl belongs in the module of its type or of its trait")
        return invalid
    if trait_type is Some(t)
        *target match
            Data(id, _, _) ->
                if conforms_directly(c.data[id].traits, t)
                    c.note(unit, written_trait_span(d), s"`$path` already conforms to `${type_name(t)}`; a conformance is stated once")
                    return invalid
                var traits = c.data[id].traits
                traits.push(t)
                c.data[id].traits = traits
            Class(_, _, _) -> ()
            _ ->
                c.note(unit, d.target.span, "conforming a built-in type to a trait is not implemented")
                return invalid
    ImplSymbol(unit, module_name, d, target, owner, trait_type)

/** Whether `traits` already holds the trait `t` names, with any type arguments. */
private conforms_directly(traits: Buf[&Type], t: &Type) -> bool
    val id = *t match
        Class(k, _, _) -> k
        _ -> return false
    for other in traits
        if *other is Class(o, _, _)
            if o == id then return true
    false

private written_trait_span(d: &ImplDecl) -> Span = d.trait_name match
    Some(t) -> t.span
    None -> d.target.span

/** Whether the trait `t` declares a method named `name`, or one of the traits it requires does. */
private trait_declares(c: *Checker, t: usize, name: string, depth: usize) -> bool
    if depth > c.classes.len() then return false
    for m in c.classes[t].decl.members
        m match
            MethodMember(f, _, _) -> if f.name == name then return true
            AbstractFieldMember(f) -> if f.name == name then return true
            _ -> ()
    for required in c.classes[t].traits
        if *required is Class(r, _, _)
            if trait_declares(c, r, name, depth + 1) then return true
    false

// A variant's fields are resolved with its type's parameters in scope. Variant names share one
// space within a file, since a variant is named on its own (`Some(1)`, `None`) wherever it is used.
private declare_variants(c: *Checker, unit: usize)
    var seen: Map[string, Span] = map()
    for id in 0..<c.data.len()
        val d = c.data[id]
        if d.unit != unit then continue
        val outer_generic = c.generic
        c.generic = Some(GenericScope(data_owner(id), d.decl.type_params))
        declare_bounds(c, unit, data_owner(id), d.decl.type_params, 0)
        var variants: Buf[VariantSymbol] = buf()
        for v in d.decl.variants
            if seen.get(v.name) is Some(_)
                c.note(unit, v.span, s"the variant `${v.name}` is declared more than once")
                continue
            seen.put(v.name, v.span)
            var names: Buf[string] = buf()
            var fields: Buf[&Type] = buf()
            for f in v.fields
                f.pattern.kind match
                    Name(n) ->
                        if contains_name(names, n) then c.note(unit, f.pattern.span, s"the field `$n` is declared more than once")
                        names.push(n)
                    _ ->
                        c.note(unit, f.pattern.span, "a field is a name and a type")
                        names.push("_")
                if f.default is Some(e) then c.note(unit, e.span, "default field values are not implemented")
                fields.push(resolve_type(c, unit, f.ty))
            // A variant is a name of its type's module, private where its type is.
            val key = qualified(c.data[id].module_name, v.name)
            c.variants.put(key, VariantRef(id, variants.len()))
            if c.private_names.get(qualified(c.data[id].module_name, c.data[id].name)) is Some(_) then c.private_names.put(key, true)
            variants.push(VariantSymbol(v.name, v.span, names, fields))
        c.data[id].variants = variants
        c.generic = outer_generic

/** The type of an instance of a class, with the class's own parameters as its arguments: the type of
 * `self` in its constructor and methods. */
own_class_type(k: ClassSymbol, id: usize) -> &Type
    var args: Buf[&Type] = buf()
    for i in 0..<k.decl.type_params.len()
        args.push(TypeVar(class_owner(id), i, k.decl.type_params[i].name))
    Class(id, k.name, args)

// A class's fields: its parameters, then the `val` and `var` fields of its body, resolved with the
// class's type parameters in scope. What this compiler does not build yet is reported here, once.
private declare_fields(c: *Checker, unit: usize)
    for id in 0..<c.classes.len()
        val k = c.classes[id]
        if k.unit != unit then continue
        val d = k.decl
        for a in d.annotations
            c.note(unit, a.span, s"unknown annotation `@${a.name}`")
        for t in d.derives
            c.note(unit, t.span, "`derives` is not implemented")
        val declares_trait = is_trait(c, id)
        if declares_trait
            for m in d.members
                m match
                    FieldMember(f) -> c.note(unit, f.span, s"a trait holds no state, so it cannot declare the field `${f.name}`")
                    AbstractFieldMember(f) ->
                        if f.mutable then c.note(unit, f.span, s"a trait declares `val` members, which are read and never assigned through it; write `val ${f.name}`")
                        elif !f.public then c.note(unit, f.span, s"`${f.name}` is declared in a trait, so it cannot be private")
                    StatementMember(s) -> c.note(unit, s.span, "a trait has no constructor, so its body declares only methods")
                    _ -> ()
        else
            for m in d.members
                if m is AbstractFieldMember(f)
                    c.note(unit, f.span, s"`${f.name}` has no value; only a trait declares a `val` without one, and a class gives each of its fields a value where it declares it")
        val outer_generic = c.generic
        c.generic = Some(GenericScope(class_owner(id), d.type_params))
        declare_bounds(c, unit, class_owner(id), d.type_params, 0)
        var traits: Buf[&Type] = buf()
        for i in 0..<d.parents.len()
            val parent = d.parents[i]
            if parent_trait(c, unit, parent) is Some(t)
                if trait_type(c, unit, t, parent) is Some(ty)
                    var repeated = false
                    for other in traits
                        if *other is Class(o, _, _)
                            if o == t then repeated = true
                    if repeated then c.note(unit, parent.span, s"`${c.classes[t].name}` is named more than once after `:`")
                    else traits.push(ty)
            elif i == 0 && !declares_trait then c.classes[id].superclass = superclass_of(c, unit, id, parent)
            else
                var is_class = false
                if parent_name(parent) is Some(n)
                    if c.class_types.get(resolve_name(c, unit, n)) is Some(_) then is_class = true
                if !is_class then c.note(unit, parent.span, s"`${parent_name(parent).unwrap_or("this")}` is not a trait")
                elif declares_trait then c.note(unit, parent.span, "a trait may require only traits, not a class")
                else c.note(unit, parent.span, "the superclass comes first after `:`, before the traits")
        // An impl of a trait for the class is the same conformance as one its header states.
        for i in 0..<c.impls.len()
            val block = c.impls[i]
            val t = block.trait_type match
                Some(t) -> t
                None -> continue
            if *block.target is Class(target, _, _)
                if target != id then continue
                if conforms_directly(traits, t)
                    c.note(block.unit, written_trait_span(block.decl), s"`${d.name}` already conforms to `${type_name(t)}`; a conformance is stated once")
                    c.impls[i].target = ErrorType
                else traits.push(t)
        c.classes[id].traits = traits
        var fields: Buf[FieldSymbol] = buf()
        for cp in d.params
            val name = cp.param.pattern.kind match
                Name(n) -> n
                _ -> "_"
            if field_named(fields, name) is Some(_) then c.note(unit, cp.param.pattern.span, s"the field `$name` is declared more than once")
            fields.push(FieldSymbol(name, cp.param.pattern.span, Some(resolve_type(c, unit, cp.param.ty)), cp.mutable, cp.public, true, id))
        for m in d.members
            if m is FieldMember(f)
                if field_named(fields, f.name) is Some(_) then c.note(unit, f.span, s"the field `${f.name}` is declared more than once")
                var ty: Option[&Type] = None
                if f.declared is Some(t) then ty = Some(resolve_type(c, unit, t))
                fields.push(FieldSymbol(f.name, f.span, ty, f.mutable, f.public, false, id))
        c.classes[id].fields = fields
        c.generic = outer_generic

/** Whether a class may be extended: one declared `open` or `abstract`. */
private is_open(c: *Checker, k: usize) -> bool = c.classes[k].decl.modifier != ""

/** Whether a class is abstract, so it cannot be instantiated: an abstract class or a trait. */
private is_abstract_class(c: *Checker, k: usize) -> bool = c.classes[k].decl.modifier == "abstract" || is_trait(c, k)

/** Whether a class symbol is a trait. */
private is_trait(c: *Checker, k: usize) -> bool = c.classes[k].decl.modifier == "trait"

/** The trait a parent after `:` names, if it names one: `Shape`, `Source[int]`, or a mistaken
 * `Shape(…)`, which `trait_type` reports. */
private parent_trait(c: *Checker, unit: usize, parent: &Expr) -> Option[usize]
    val k = c.class_types.get(resolve_name(c, unit, parent_name(parent)?))?
    if is_trait(c, k) then Some(k) else None

/** The name a parent after `:` is written with, without its type or constructor arguments. */
private parent_name(parent: &Expr) -> Option[string]
    var named = parent
    if named.kind is Call(target, _) then named = target
    if named.kind is TypeApply(inner, _) then named = inner
    named.kind match
        Name(n) -> Some(n)
        _ -> None

// A trait after `:`, named with its type arguments when it is generic and without arguments of its
// own: a trait has no constructor.
private trait_type(c: *Checker, unit: usize, t: usize, parent: &Expr) -> Option[&Type]
    val name = c.classes[t].name
    if parent.kind is Call(_, _)
        c.note(unit, parent.span, s"`$name` is a trait, which has no constructor; name it without arguments")
        return None
    var written: Buf[&TypeExpr] = buf()
    if parent.kind is TypeApply(_, types) then written = types
    var args: Buf[&Type] = buf()
    for w in written
        args.push(resolve_type(c, unit, w))
    val wanted = c.classes[t].decl.type_params.len()
    if args.len() != wanted
        if args.len() == 0 then c.note(unit, parent.span, s"`$name` is generic; write its type arguments, as in `$name[int]`")
        else c.note(unit, parent.span, s"`$name` takes ${count(wanted, "type argument")}, not ${args.len()}")
        return None
    check_type_args(c, unit, parent.span, s"`$name`", class_owner(t), c.classes[t].decl.type_params, args)
    Some(Class(t, name, args))

// The superclass after `:`: a class, called with its constructor arguments or named alone when it
// takes none, its type arguments written when it is generic. Its arguments are checked with the
// constructor.
private superclass_of(c: *Checker, unit: usize, id: usize, parent: &Expr) -> Option[&Type]
    var callee = parent
    if parent.kind is Call(target, _) then callee = target
    var written: Buf[&TypeExpr] = buf()
    var named = callee
    if callee.kind is TypeApply(inner, types)
        written = types
        named = inner
    val name = named.kind match
        Name(n) -> n
        _ ->
            c.note(unit, parent.span, "expected a superclass, as in `Base(arguments)`")
            return None
    val key = resolve_name(c, unit, name)
    val sid = c.class_types.get(key) match
        Some(s) -> s
        None ->
            if c.types.get(key) is Some(_) || builtin_type(name) is Some(_)
                c.note(unit, named.span, s"`$name` is not a class, so it cannot be extended")
            else c.note(unit, named.span, s"`$name` is neither a class nor a trait")
            return None
    val s = c.classes[sid]
    if !is_open(c, sid)
        c.note(unit, named.span, s"`$name` is final; declare it `open` or `abstract` to extend it")
        return None
    var args: Buf[&Type] = buf()
    for t in written
        args.push(resolve_type(c, unit, t))
    if args.len() != s.decl.type_params.len()
        if args.len() == 0 then c.note(unit, named.span, s"`$name` is generic; write its type arguments, as in `$name[int](…)`")
        else c.note(unit, named.span, s"`$name` takes ${count(s.decl.type_params.len(), "type argument")}, not ${args.len()}")
        return None
    Some(Class(sid, name, args))

// A subclass's fields are its superclass's, at the same positions and with the superclass's type
// arguments substituted, followed by its own. A field of its own may share the name of an inherited
// one only when one of the two is private: a public field is never overridden.
private inherit_fields(c: *Checker, id: usize)
    if c.classes[id].linked == 2 then return
    val k = c.classes[id]
    if k.linked == 1
        c.note(k.unit, k.decl.name_span, s"`${k.name}` inherits from itself")
        c.classes[id].superclass = None
        return
    var sid = 0usize
    var args: Buf[&Type] = buf()
    if k.superclass is Some(t)
        if *t is Class(s, _, a)
            sid = s
            args = a
    if k.superclass is None
        c.classes[id].linked = 2
        return
    c.classes[id].linked = 1
    inherit_fields(c, sid)
    if c.classes[id].superclass is None
        c.classes[id].linked = 2
        return
    var fields: Buf[FieldSymbol] = buf()
    for f in c.classes[sid].fields
        var copy = f
        if f.ty is Some(t) then copy.ty = Some(substitute(t, class_owner(sid), args))
        fields.push(copy)
    val inherited = fields.len()
    for f in k.fields
        for i in 0..<inherited
            if fields[i].name == f.name && fields[i].public && f.public
                c.note(k.unit, f.span, s"`${f.name}` is already a field of `${c.classes[fields[i].owner].name}`; a field cannot be overridden")
        fields.push(f)
    c.classes[id].fields = fields
    c.classes[id].inherited = inherited
    c.classes[id].linked = 2

// An inherited field declared without a type has its type once its own class's body is checked.
private settle_inherited_fields(c: *Checker, id: usize)
    val k = c.classes[id]
    if k.inherited == 0 then return
    var sid = 0usize
    var args: Buf[&Type] = buf()
    if k.superclass is Some(t)
        if *t is Class(s, _, a)
            sid = s
            args = a
    settle_inherited_fields(c, sid)
    for i in 0..<k.inherited
        c.classes[id].fields[i].ty = Some(substitute(c.classes[sid].fields[i].ty.unwrap_or(ErrorType), class_owner(sid), args))

/** The type `t`, an instance of a class or a trait, as an instance of the class or trait `target`,
 * or `None` when `target` is not among its ancestors: its superclasses and the traits they and it
 * conform to, and the traits those require. */
ancestor_type(classes: Buf[ClassSymbol], data: Buf[DataSymbol], t: &Type, target: usize) -> Option[&Type]
    // A data type conforms to the traits its impls name, and to those they require.
    if *t is Data(d, _, xs)
        for required in data[d].traits
            if ancestor_type(classes, data, substitute(required, data_owner(d), xs), target) is Some(found) then return Some(found)
        return None
    val k = *t match
        Class(k, _, _) -> k
        _ -> return None
    if k == target then return Some(t)
    val args = *t match
        Class(_, _, a) -> a
        _ -> buf()
    for required in classes[k].traits
        if ancestor_type(classes, data, substitute(required, class_owner(k), args), target) is Some(found) then return Some(found)
    ancestor_type(classes, data, substitute(classes[k].superclass?, class_owner(k), args), target)

// `x`, the type of a value, seen as the type `to`: what the value already is as an instance of
// `to`'s class, trait, data type, tuple or function type, with no conversion. An instance of a
// subclass is one of its superclass; an instance of a generic type is another instance of it where
// each type argument follows the parameter's declared variance; a tuple's parts are covariant; a
// function's parameters are contravariant and its result covariant. Where `x` is not such a view of
// `to`, the result is `x` itself or a type that differs from `to`. Both types are solved.
view_as(classes: Buf[ClassSymbol], data: Buf[DataSymbol], x: &Type, to: &Type) -> &Type = *to match
    Class(k, name, ys) -> ancestor_type(classes, data, x, k) match
        Some(up) -> *up match
            Class(_, _, xs) -> Class(k, name, vary_args(classes, data, classes[k].decl.type_params, xs, ys))
            _ -> up
        None -> x
    Data(d, name, ys) -> *x match
        Data(e, _, xs) ->
            if e != d then return x
            Data(d, name, vary_args(classes, data, data[d].decl.type_params, xs, ys))
        _ -> x
    Tuple(ys) -> *x match
        Tuple(xs) ->
            if xs.len() != ys.len() then return x
            var items: Buf[&Type] = buf()
            for i in 0..<xs.len()
                items.push(view_part(classes, data, xs[i], ys[i]))
            Tuple(items)
        _ -> x
    Function(ys, s) -> *x match
        Function(xs, r) ->
            if xs.len() != ys.len() then return x
            var params: Buf[&Type] = buf()
            for i in 0..<xs.len()
                params.push(view_contra(classes, data, xs[i], ys[i]))
            Function(params, view_part(classes, data, r, s))
        _ -> x
    _ -> x

// The type arguments `xs` seen as `ys`, one parameter's variance at a time.
private vary_args(classes: Buf[ClassSymbol], data: Buf[DataSymbol], params: Buf[TypeParam], xs: Buf[&Type], ys: Buf[&Type]) -> Buf[&Type]
    if xs.len() != ys.len() || xs.len() != params.len() then return xs
    var out: Buf[&Type] = buf()
    for i in 0..<xs.len()
        val v = params[i].variance
        if v is Covariant then out.push(view_part(classes, data, xs[i], ys[i]))
        elif v is Contravariant then out.push(view_contra(classes, data, xs[i], ys[i]))
        else out.push(xs[i])
    out

// A part in a covariant position: `x` seen as `to` where both are references, so the object `x`
// describes is already the one `to` describes. A value of a value type differs in representation
// from an `Any` or a trait, so it stays itself.
private view_part(classes: Buf[ClassSymbol], data: Buf[DataSymbol], x: &Type, to: &Type) -> &Type
    if conforms(x, to) && !(*x is Nothing) then return x
    if !is_reference(x) then return x
    if *to is AnyType then return AnyType
    view_as(classes, data, x, to)

// A part in a contravariant position: `to` where it may be seen as `x`, otherwise `x`.
private view_contra(classes: Buf[ClassSymbol], data: Buf[DataSymbol], x: &Type, to: &Type) -> &Type
    if conforms(x, to) && !(*x is Nothing) then return x
    if conforms(view_part(classes, data, to, x), x) then to else x

/** Whether a value of type `t` is a reference to an object, which every type it may be seen as
 * shares: `Any`, a string, a tuple, a function, a data type, a class or a trait. */
is_reference(t: &Type) -> bool = *t match
    AnyType -> true
    Str -> true
    Tuple(_) -> true
    Function(_, _) -> true
    Data(_, _, _) -> true
    Class(_, _, _) -> true
    _ -> false

/** Whether a field may be used from the code being checked: a public one, or a private one from
 * code of the class that declares it or of its companion. */
private field_visible(c: *Checker, f: FieldSymbol) -> bool = f.public || inside_class(c, f.owner)

/** Whether a method may be called from the code being checked. */
private method_visible(c: *Checker, m: usize) -> bool
    if c.symbols[m].public then return true
    c.symbols[m].owner_class match
        Some(k) -> inside_class(c, k)
        None -> c.symbols[m].receiver match
            Some(t) -> inside_impl(c, t)
            None -> false

/** Whether the code being checked is a method an impl adds to the data or built-in type of `t`, so it
 * may call that type's private methods. */
private inside_impl(c: *Checker, t: &Type) -> bool
    val here = c.symbols[c.body.root].receiver match
        Some(r) -> r
        None -> return false
    *here match
        Data(a, _, _) -> *t match
            Data(b, _, _) -> a == b
            _ -> false
        _ -> same_type(here, t)

// The field of class `k` a name reaches from the code being checked: the class's own field first,
// then the nearest ancestor's, passing over the private fields the code cannot see. When none is
// visible, the nearest field of that name, so its privacy can be reported.
private class_field(c: *Checker, k: usize, name: string) -> Option[usize]
    val fields = c.classes[k].fields
    var hidden: Option[usize] = None
    var i = fields.len()
    while i > 0
        i -= 1
        if fields[i].name != name then continue
        if field_visible(c, fields[i]) then return Some(i)
        if hidden is None then hidden = Some(i)
    hidden

private field_named(fields: Buf[FieldSymbol], name: string) -> Option[usize]
    for i in 0..<fields.len()
        if fields[i].name == name then return Some(i)
    None

/** A method of a class as it is declared: in the class's body, or in an impl in file `unit` that
 * names the class's type parameters `type_params`. */
private struct MethodDecl
    f: &Function
    public: bool
    overrides: bool
    unit: usize
    module_name: string
    type_params: Buf[TypeParam]
    from_impl: bool
    /** Whether this is a trait's `val`, read as a field and supplied by a field. */
    field: bool

// Each class's constructor, a function named after the class that takes its parameters and yields
// a new instance, and its methods, each a function whose first parameter is the instance.
private declare_methods(c: *Checker, unit: usize)
    val module_name = c.units[unit].file.module_name
    for id in 0..<c.classes.len()
        val k = c.classes[id]
        if k.unit != unit then continue
        val d = k.decl
        // A function of the same name was reported when it was declared.
        val key = qualified(module_name, d.name)
        if c.variants.get(key) is Some(v) then c.note(unit, d.name_span, s"`${d.name}` is already a variant of `${c.data[v.data].name}`")
        val self_type = own_class_type(k, id)
        var params: Buf[Param] = buf()
        var types: Buf[&Type] = buf()
        var names: Buf[string] = buf()
        for i in 0..<d.params.len()
            params.push(d.params[i].param)
            types.push(k.fields[k.inherited + i].ty.unwrap_or(ErrorType))
            names.push(k.fields[k.inherited + i].name)
        val decl = Function(buf(), d.span, d.name_span, d.name, d.type_params, params, None, None, buf())
        val constructor = c.symbols.len()
        var no_defaults: Buf[Option[usize]] = buf()
        for _ in d.params
            no_defaults.push(None)
        // An object's constructor makes its one instance before `main` and cannot be called.
        c.symbols.push(FunctionSymbol(unit, module_name, d.name, decl, types, names, Some(self_type), None, None, buf(), buf(), buf(), false, false, false, no_defaults, None, class_owner(id), d.type_params, Some(id), true, !d.object, "", None))
        c.states.push(0)
        c.bodies.push(None)
        c.locals.push(buf())
        declare_defaults(c, constructor)
        if !d.object
            var constructors: Buf[usize] = buf()
            constructors.push(constructor)
            c.scope.put(key, constructors)
        c.classes[id].constructor = constructor
        c.classes[id].initializer = constructor
        if is_open(c, id)
            // The initializer takes the object, then the constructor's parameters.
            var init_types: Buf[&Type] = buf()
            var init_names: Buf[string] = buf()
            var init_defaults: Buf[Option[usize]] = buf()
            init_types.push(self_type)
            init_names.push("self")
            init_defaults.push(None)
            for i in 0..<types.len()
                init_types.push(types[i])
                init_names.push(names[i])
                init_defaults.push(None)
            c.classes[id].initializer = c.symbols.len()
            c.symbols.push(FunctionSymbol(unit, module_name, d.name + ".<init>", decl, init_types, init_names, Some(Unit), None, None, buf(), buf(), buf(), false, false, false, init_defaults, None, class_owner(id), d.type_params, Some(id), true, true, "", None))
            c.states.push(0)
            c.bodies.push(None)
            c.locals.push(buf())
        var methods: Buf[usize] = buf()
        var overriding: Buf[bool] = buf()
        // The class's own methods, then those its impls add; a method of an impl of a trait
        // implements the trait's method without being marked.
        var declared: Buf[MethodDecl] = buf()
        for m in d.members
            m match
                MethodMember(f, public, overrides) -> declared.push(MethodDecl(f, public, overrides, unit, module_name, d.type_params, false, false))
                // A trait's `val` is an abstract method of no parameters, read with field syntax.
                AbstractFieldMember(f) ->
                    if is_trait(c, id) && !f.mutable && f.public
                        val getter = Function(buf(), f.span, f.name_span, f.name, buf(), buf(), Some(f.declared), None, buf())
                        declared.push(MethodDecl(getter, true, false, unit, module_name, d.type_params, false, true))
                _ -> ()
        for block in c.impls
            if *block.target is Class(target, _, _)
                if target != id then continue
                val trait_id = block.trait_type match
                    Some(t) -> *t match
                        Class(t, _, _) -> Some(t)
                        _ -> None
                    None -> None
                for m in block.decl.members
                    if m is MethodMember(f, public, overrides)
                        if trait_id is Some(t)
                            if !trait_declares(c, t, f.name, 0)
                                c.note(block.unit, f.name_span, s"`${f.name}` is not a method of `${c.classes[t].name}`; an impl of a trait implements the trait's methods, and `impl ${d.name}` adds others")
                                continue
                        declared.push(MethodDecl(f, public, overrides || trait_id is Some(_), block.unit, block.module_name, block.decl.type_params, true, false))
        for entry in declared
            val f = entry.f
            val public = entry.public
            val overrides = entry.overrides
            val file_unit = entry.unit
            if f.annotations.len() > 0 then c.note(file_unit, f.name_span, "annotations on methods are not implemented")
            if overrides then refuse_override_defaults(c, file_unit, f)
            if is_trait(c, id)
                if !public
                    c.note(file_unit, f.name_span, s"`${f.name}` is declared in a trait, so it cannot be private")
                    continue
                if overrides && f.body is None && f.clauses.len() == 0
                    c.note(file_unit, f.name_span, s"`${f.name}` overrides a method in a trait, so it needs a body, which replaces the default of the trait it requires")
                    continue
            var clash: Option[usize] = None
            for i in 0..<k.fields.len()
                if k.fields[i].name == f.name && (i >= k.inherited || k.fields[i].public) then clash = Some(i)
            if clash is Some(i)
                c.note(file_unit, f.name_span, s"`${f.name}` is already a field of `${c.classes[k.fields[i].owner].name}`")
                continue
            val bodyless = f.body is None && f.clauses.len() == 0
            if bodyless && !is_abstract_class(c, id)
                c.note(file_unit, f.name_span, s"`${f.name}` has no body; only an abstract class may leave a method without one")
            if bodyless && !public then c.note(file_unit, f.name_span, s"`${f.name}` is abstract, so it cannot be private: a subclass implements it")
            var same_name: Buf[usize] = buf()
            for other in methods
                if c.symbols[other].decl.name == f.name then same_name.push(other)
            var type_params: Buf[TypeParam] = buf()
            for tp in entry.type_params
                type_params.push(tp)
            for tp in f.type_params
                type_params.push(tp)
            // In a trait, `Self` names the type implementing it.
            val outer_trait = c.self_trait
            if is_trait(c, id) then c.self_trait = Some(id)
            var symbol = signature(c, file_unit, entry.module_name, f, class_owner(id), type_params, true)
            c.self_trait = outer_trait
            // The receiver comes first, named `self`. In a trait that mentions `Self`, it is a `Self`,
            // so the trait's methods can pass it where their parameters take one.
            var receiver_types: Buf[&Type] = buf()
            var receiver_names: Buf[string] = buf()
            if is_trait(c, id) && mentions_self(c, id, 0) then receiver_types.push(TypeVar(self_owner(id), 0, "Self"))
            else receiver_types.push(self_type)
            receiver_names.push("self")
            for t in symbol.params
                receiver_types.push(t)
            for n in symbol.param_names
                receiver_names.push(n)
            symbol.params = receiver_types
            symbol.param_names = receiver_names
            symbol.name = d.name + "." + f.name
            symbol.owner_class = Some(id)
            symbol.public = public
            var method_defaults: Buf[Option[usize]] = buf()
            for _ in receiver_types
                method_defaults.push(None)
            symbol.defaults = method_defaults
            var shared = entry.field && same_name.len() > 0
            for other in same_name
                if is_trait_field(c, other) then shared = true
            if shared
                c.note(file_unit, f.name_span, s"`${f.name}` is declared more than once in `${d.name}`; a trait's `val` shares its name with no other member")
                continue
            if same_as_overload(c, symbol, same_name)
                if entry.from_impl then c.note(file_unit, f.name_span, s"`${f.name}` is already a method of `${d.name}` with the same parameter types; a method's overloads differ in their parameter types")
                else c.note(file_unit, f.name_span, s"`${f.name}` is declared more than once in `${d.name}` with the same parameter types; a method's overloads differ in their parameter types")
                continue
            val method = c.symbols.len()
            if entry.field then c.trait_fields.push(method)
            methods.push(method)
            overriding.push(overrides)
            c.symbols.push(symbol)
            c.states.push(0)
            c.bodies.push(None)
            c.locals.push(buf())
            // An override takes the defaults of the method it overrides once the class is linked.
            if !overrides then declare_defaults(c, method)
        c.classes[id].methods = methods
        c.classes[id].overriding = overriding
        // The methods of one name are told apart in the object file by their parameter types.
        for m in methods
            var group: Buf[usize] = buf()
            for other in methods
                if c.symbols[other].decl.name == c.symbols[m].decl.name then group.push(other)
            if group.len() > 1 && group[0] == m then mark_overloads(c, group)

// The methods an impl adds to a data type or a built-in type: each a function whose first parameter
// is the value, `self`. A class's impls were declared with the class's own methods.
private declare_impl_methods(c: *Checker, i: usize)
    val target = c.impls[i].target
    if *target is ErrorType || *target is Class(_, _, _) then return
    for m in c.impls[i].decl.members
        if m is MethodMember(f, public, overrides) then declare_impl_method(c, i, f, public, overrides)

private declare_impl_method(c: *Checker, i: usize, f: &Function, public: bool, overrides: bool)
    val block = c.impls[i]
    val unit = block.unit
    val target = block.target
    val type_name_of = *target match
        Data(id, _, _) -> c.data[id].name
        _ -> type_name(target)
    val trait_id = block.trait_type match
        Some(t) -> *t match
            Class(t, _, _) -> Some(t)
            _ -> None
        None -> None
    if f.annotations.len() > 0 then c.note(unit, f.name_span, "annotations on methods are not implemented")
    if trait_id is Some(_) || overrides then refuse_override_defaults(c, unit, f)
    if trait_id is Some(t)
        if !trait_declares(c, t, f.name, 0)
            c.note(unit, f.name_span, s"`${f.name}` is not a method of `${c.classes[t].name}`; an impl of a trait implements the trait's methods, and `impl $type_name_of` adds others")
            return
    elif overrides
        c.note(unit, f.name_span, s"`${f.name}` overrides nothing; `$type_name_of` has no superclass")
    if *target is Data(id, _, _)
        var field = false
        for v in c.data[id].variants
            if contains_name(v.field_names, f.name) then field = true
        if field
            c.note(unit, f.name_span, s"`${f.name}` is already a field of `$type_name_of`")
            return
    // The methods of this name the type's impls have added so far, which this one overloads.
    var same_name: Buf[usize] = buf()
    *target match
        Data(d, _, _) ->
            for m in c.data[d].methods
                if c.symbols[m].decl.name == f.name then same_name.push(m)
        _ ->
            for m in c.builtin_methods
                if same_type(c.symbols[m].receiver.unwrap(), target) && c.symbols[m].decl.name == f.name then same_name.push(m)
    val id = c.symbols.len()
    // A data type's methods share its type parameters, then have their own; a built-in type has
    // none, so its methods' type parameters are their own.
    val owner = if *target is Data(_, _, _) then block.owner else id
    var type_params: Buf[TypeParam] = buf()
    for tp in block.decl.type_params
        type_params.push(tp)
    for tp in f.type_params
        type_params.push(tp)
    var symbol = signature(c, unit, block.module_name, f, owner, type_params, false)
    // The receiver comes first, named `self`.
    var receiver_types: Buf[&Type] = buf()
    var receiver_names: Buf[string] = buf()
    receiver_types.push(target)
    receiver_names.push("self")
    for t in symbol.params
        receiver_types.push(t)
    for n in symbol.param_names
        receiver_names.push(n)
    symbol.params = receiver_types
    symbol.param_names = receiver_names
    symbol.name = type_name_of + "." + f.name
    symbol.public = public
    symbol.receiver = Some(target)
    var method_defaults: Buf[Option[usize]] = buf()
    for _ in receiver_types
        method_defaults.push(None)
    symbol.defaults = method_defaults
    if same_as_overload(c, symbol, same_name)
        c.note(unit, f.name_span, s"`${f.name}` is already a method of `$type_name_of` with the same parameter types; a method's overloads differ in their parameter types")
        return
    c.symbols.push(symbol)
    c.states.push(0)
    c.bodies.push(None)
    c.locals.push(buf())
    if trait_id is None && !overrides then declare_defaults(c, id)
    same_name.push(id)
    if same_name.len() > 1 then mark_overloads(c, same_name)
    *target match
        Data(d, _, _) ->
            var methods = c.data[d].methods
            methods.push(id)
            c.data[d].methods = methods
            var implementing = c.data[d].implementing
            implementing.push(trait_id is Some(_))
            c.data[d].implementing = implementing
        _ -> c.builtin_methods.push(id)

/** The method named `name` that a value of data or built-in type `t` has: one its impls add, or for a
 * data type, what its method table holds under the name through a trait it conforms to. */
private receiver_method(c: *Checker, t: &Type, name: string) -> Option[usize]
    *t match
        Data(id, _, _) ->
            for m in c.data[id].methods
                if c.symbols[m].decl.name == name then return Some(m)
            for entry in c.data[id].table
                if entry is Some(m)
                    if c.symbols[m].decl.name == name then return Some(m)
            None
        Class(_, _, _) -> None
        Var(_) -> None
        TypeVar(_, _, _) -> None
        ErrorType -> None
        _ ->
            for m in c.builtin_methods
                if same_type(c.symbols[m].receiver.unwrap(), t) && c.symbols[m].decl.name == name then return Some(m)
            None

/** Every method named `name` that a value of data or built-in type `t` has, one for each list of
 * parameter types: those its impls add, then for a data type what its method table holds under the
 * name through the traits it conforms to. */
private receiver_methods(c: *Checker, t: &Type, name: string) -> Buf[usize]
    var out: Buf[usize] = buf()
    *t match
        Data(id, _, _) ->
            val self_type = own_type(c.data[id], id)
            for m in c.data[id].methods
                if c.symbols[m].decl.name == name then add_method(c, self_type, &out, m)
            for entry in c.data[id].table
                if entry is Some(m)
                    if c.symbols[m].decl.name == name then add_method(c, self_type, &out, m)
        Class(_, _, _) -> ()
        Var(_) -> ()
        TypeVar(_, _, _) -> ()
        ErrorType -> ()
        _ ->
            for m in c.builtin_methods
                if same_type(c.symbols[m].receiver.unwrap(), t) && c.symbols[m].decl.name == name then out.push(m)
    out

/** The methods of `ms` the code being checked may call. */
private visible_methods(c: *Checker, ms: Buf[usize]) -> Buf[usize]
    var out: Buf[usize] = buf()
    for m in ms
        if method_visible(c, m) then out.push(m)
    out

// Defaults belong to the method that introduces a parameter: one that overrides another method, or
// implements a trait's, takes that method's defaults and declares none of its own.
private refuse_override_defaults(c: *Checker, unit: usize, f: &Function)
    for p in f.params
        if p.default is Some(e) then c.note(unit, e.span, s"`${f.name}` overrides a method, so it takes that method's default for `${param_name(p)}`; an override cannot declare a default")

private param_name(p: Param) -> string = p.pattern.kind match
    Name(n) -> n
    _ -> "_"

// Method `m`, which overrides or implements `base`, takes `base`'s defaults. Overriding two methods
// that bring different defaults leaves the arguments it may omit unclear, so it is an error.
private inherit_defaults(c: *Checker, m: usize, base: usize)
    val from = c.symbols[base].defaults
    val own = c.symbols[m].defaults
    if from.len() != own.len() then return
    var brings = false
    for d in from
        if d is Some(_) then brings = true
    if !brings then return
    var has = false
    var same = true
    for i in 0..<own.len()
        if own[i] is Some(_) then has = true
        if own[i] != from[i] then same = false
    if has
        if !same then c.note(c.symbols[m].unit, c.symbols[m].decl.name_span, s"`${c.symbols[m].name}` overrides methods with different defaults, `${c.symbols[base].name}` among them; it can take the defaults of only one")
        return
    var copied: Buf[Option[usize]] = buf()
    for d in from
        copied.push(d)
    c.symbols[m].defaults = copied

// A method a type inherits, from its superclass or as a trait's default body, that also implements
// another trait's method keeps its own defaults, so a call omits the same arguments whichever type
// it is made through only when the trait's method declares none or has the very same ones. The
// reason it does not, when it does not; `remedy` says how the type replaces the method, which takes
// the trait method's defaults where the inherited one has none.
private defaults_conflict(c: *Checker, m: usize, base: usize, remedy: string) -> Option[string]
    val from = c.symbols[base].defaults
    val own = c.symbols[m].defaults
    if from.len() != own.len() then return None
    var brings = false
    var same = true
    var has = false
    for i in 0..<from.len()
        if from[i] is Some(_) then brings = true
        if own[i] is Some(_) then has = true
        if own[i] != from[i] then same = false
    if !brings || same then return None
    if !has then return Some(s"which has defaults `${c.symbols[m].name}` lacks; $remedy to take them")
    Some("and their defaults differ; a method can take the defaults of only one")

/** Whether a function is a method, whose first parameter is its receiver, `self`. */
private is_method(symbol: FunctionSymbol) -> bool = (symbol.owner_class is Some(_) && !symbol.constructor) || symbol.receiver is Some(_)

/** Whether a method is abstract: declared in a class without a body. */
is_abstract_method(symbol: FunctionSymbol) -> bool =
    symbol.owner_class is Some(_) && !symbol.constructor && symbol.intrinsic is None && symbol.decl.body is None && symbol.decl.clauses.len() == 0

// Each module-level value and object of a file, in declaration order, which is the order they
// initialize in where none depends on another. A value's initializer is checked as a function with
// no parameters whose result is the value; an object's is its class's constructor.
private declare_globals(c: *Checker, unit: usize)
    val file = c.units[unit].file
    for i in 0..<file.items.len()
        val key = qualified(file.module_name, item_name(file.items[i]))
        file.items[i] match
            ValueItem(v) ->
                if v.name == "_" || global_name_taken(c, unit, v.name, v.span, false) then continue
                val f = Function(buf(), v.span, v.span, v.name, buf(), buf(), v.declared, Some(v.value), buf())
                val init = c.symbols.len()
                c.symbols.push(signature(c, unit, file.module_name, f, init, buf(), false))
                c.states.push(0)
                c.bodies.push(None)
                c.locals.push(buf())
                if file.private_items[i] then c.private_names.put(key, true)
                c.global_names.put(key, c.globals.len())
                c.globals.push(GlobalSymbol(unit, file.module_name, v.name, v.span, v.mutable, init, None))
            ClassItem(d) ->
                if !d.object then continue
                // A second object of one name has no class, and was reported.
                for k in 0..<c.classes.len()
                    val cls = c.classes[k]
                    if cls.unit == unit && cls.decl.object && cls.name == d.name && cls.global is None
                        if global_name_taken(c, unit, d.name, d.name_span, true) then break
                        c.classes[k].global = Some(c.globals.len())
                        c.global_names.put(key, c.globals.len())
                        c.globals.push(GlobalSymbol(unit, file.module_name, d.name, d.name_span, false, cls.constructor, Some(k)))
            _ -> ()

/** The name a top-level declaration introduces: "" for an impl, which introduces none. */
private item_name(item: Item) -> string = item match
    FunctionItem(f) -> f.name
    DataItem(d) -> d.name
    ClassItem(d) -> d.name
    ImplItem(_) -> ""
    ValueItem(v) -> v.name

// Whether a module-level value's name is already declared in its module, reporting it if so. An
// object's clashes with a class, a function or a variant were reported with its class, so only its
// clash with a module value is reported here.
private global_name_taken(c: *Checker, unit: usize, name: string, at: Span, object: bool) -> bool
    val key = qualified(c.units[unit].file.module_name, name)
    if c.global_names.get(key) is Some(_)
        c.note(unit, at, s"`$name` is declared more than once")
        return true
    if object then return false
    if c.class_types.get(key) is Some(k)
        if !c.classes[k].decl.object && c.classes[k].companion is None
            c.note(unit, at, s"`$name` is already a class")
            return true
    if c.scope.get(key) is Some(ids)
        for f in ids
            if !c.symbols[f].constructor
                c.note(unit, at, s"`$name` is already a function")
                return true
    if c.variants.get(key) is Some(v)
        c.note(unit, at, s"`$name` is already a variant of `${c.data[v.data].name}`")
        return true
    false

/** The method of class `id` declared as `name`, its own. */
private own_method(c: *Checker, id: usize, name: string) -> Option[usize]
    for m in c.classes[id].methods
        if c.symbols[m].decl.name == name then return Some(m)
    None

/** Whether methods `a` and `b` are one method as a value of `self_type` sees them: the same name and
 * the same parameter types past the receiver. Such methods override and implement one another and
 * share a position in a method table; methods of one name with other parameter types overload it. */
private same_method(c: *Checker, self_type: &Type, a: usize, b: usize) -> bool =
    c.symbols[a].decl.name == c.symbols[b].decl.name && param_mismatch(c, self_type, a, b) is None

/** The method of class or trait `k` that is the same method as `m`, as `self_type` sees both. */
private own_matching(c: *Checker, k: usize, self_type: &Type, m: usize) -> Option[usize]
    for own in c.classes[k].methods
        if same_method(c, self_type, own, m) then return Some(own)
    None

/** Adds method `m` to `out` unless `out` already holds the same method as `self_type` sees it. */
private add_method(c: *Checker, self_type: &Type, out: *Buf[usize], m: usize)
    for i in 0..<out.len()
        if same_method(c, self_type, out[i], m) then return
    out.push(m)

/** The methods of `name` a value of class or trait `id` has that the code being checked may call: one
 * for each list of parameter types, found in the order `method_named` searches, so each is the
 * implementation the value's static type knows. */
private methods_named(c: *Checker, id: usize, name: string) -> Buf[usize]
    val self_type = own_class_type(c.classes[id], id)
    var out: Buf[usize] = buf()
    for m in c.classes[id].methods
        if c.symbols[m].decl.name == name && method_visible(c, m) then add_method(c, self_type, &out, m)
    for entry in c.classes[id].table
        if entry is Some(m)
            if c.symbols[m].decl.name == name then add_method(c, self_type, &out, m)
    var k = id
    loop
        for m in c.classes[k].methods
            if c.symbols[m].decl.name == name && method_visible(c, m) then add_method(c, self_type, &out, m)
        val sup = c.classes[k].superclass match
            Some(t) -> t
            None -> break
        k = *sup match
            Class(s, _, _) -> s
            _ -> break
    trait_methods_named(c, id, self_type, name, &out, 0)
    // A trait's `val`, and the method a field supplies it with, are read as a field, not called.
    var callable: Buf[usize] = buf()
    for m in out
        if !reads_field(c, m) then callable.push(m)
    callable

/** Adds to `out` the methods of `name` of the traits class or trait `id` conforms to or requires. */
private trait_methods_named(c: *Checker, id: usize, self_type: &Type, name: string, out: *Buf[usize], depth: usize)
    if depth > c.classes.len() then return
    for required in c.classes[id].traits
        if *required is Class(t, _, _)
            for m in c.classes[t].methods
                if c.symbols[m].decl.name == name then add_method(c, self_type, out, m)
            trait_methods_named(c, t, self_type, name, out, depth + 1)
    if c.classes[id].superclass is Some(sup)
        if *sup is Class(s, _, _) then trait_methods_named(c, s, self_type, name, out, depth + 1)

/** The method of a trait that trait `id` requires, directly or not, that is the same method as `m`. */
private required_matching(c: *Checker, id: usize, self_type: &Type, m: usize, depth: usize) -> Option[usize]
    if depth > c.classes.len() then return None
    for required in c.classes[id].traits
        if *required is Class(t, _, _)
            if own_matching(c, t, self_type, m) is Some(found) then return Some(found)
            if required_matching(c, t, self_type, m, depth + 1) is Some(found) then return Some(found)
    None

/** The text of a method's parameter types past the receiver, as `self_type` sees them, after its
 * name: `add(int, string)`. It tells apart the overloads of one name in a diagnostic. */
private method_key(c: *Checker, self_type: &Type, m: usize) -> string
    val params = c.symbols[m].params
    var text = c.symbols[m].decl.name + "("
    for i in 1..<params.len()
        if i > 1 then text = text + ", "
        text = text + type_name(seen_from(c, self_type, m, params[i]))
    text + ")"

// The method a name reaches on an instance of class `id`: the class's own, then the nearest
// ancestor's, passing over the private methods of ancestors that the code being checked cannot see.
// When none is visible, the nearest of that name, so its privacy can be reported.
// Past the class's own methods, what its method table holds under the name is the implementation
// an instance has, wherever it comes from; a method no table holds is the nearest ancestor's, and
// then a trait's. A trait's methods are its own, then those of the traits it requires.
private method_named(c: *Checker, id: usize, name: string) -> Option[usize]
    val m = any_method_named(c, id, name)?
    if reads_field(c, m) then None else Some(m)

/** The method `method_named` finds, a trait's `val` and the method that supplies it included. */
private any_method_named(c: *Checker, id: usize, name: string) -> Option[usize]
    if own_method(c, id, name) is Some(m)
        if method_visible(c, m) then return Some(m)
    for entry in c.classes[id].table
        if entry is Some(m)
            if c.symbols[m].decl.name == name then return Some(m)
    var hidden: Option[usize] = None
    var k = id
    loop
        if own_method(c, k, name) is Some(m)
            if method_visible(c, m) then return Some(m)
            if hidden is None then hidden = Some(m)
        val sup = c.classes[k].superclass match
            Some(t) -> t
            None -> break
        k = *sup match
            Class(s, _, _) -> s
            _ -> break
    if hidden is Some(_) then return hidden
    trait_method(c, id, name)

/** The method named `name` of a trait that class or trait `id` conforms to or requires. */
private trait_method(c: *Checker, id: usize, name: string) -> Option[usize]
    for required in c.classes[id].traits
        if *required is Class(t, _, _)
            if own_method(c, t, name) is Some(m) then return Some(m)
            if trait_method(c, t, name) is Some(m) then return Some(m)
    val sup = c.classes[id].superclass?
    *sup match
        Class(s, _, _) -> trait_method(c, s, name)
        _ -> None

/** The position of a trait's method in the method table of every class conforming to the trait. */
private trait_slot(c: *Checker, m: usize) -> usize
    val t = c.symbols[m].owner_class.unwrap()
    if trait_overridden(c, m) is Some(o) then return trait_slot(c, o)
    val methods = c.classes[t].methods
    for j in 0..<methods.len()
        if methods[j] == m then return c.classes[t].base + j
    0

/** For a trait's method declared `override`, the method of a trait it requires whose default it
 * replaces, at whose position it is called. */
private trait_overridden(c: *Checker, m: usize) -> Option[usize]
    val t = c.symbols[m].owner_class?
    if !is_trait(c, t) then return None
    val methods = c.classes[t].methods
    for j in 0..<methods.len()
        if methods[j] == m && c.classes[t].overriding[j]
            return required_matching(c, t, own_class_type(c.classes[t], t), m, 0)
    None

/** Whether trait method `n` overrides `m`, directly or through the overrides between them. */
private replaces(c: *Checker, n: usize, m: usize) -> bool
    var x = n
    var steps = 0usize
    while steps <= c.classes.len()
        x = trait_overridden(c, x) match
            Some(o) -> o
            None -> return false
        if x == m then return true
        steps += 1
    false

/** The method bodies a type may inherit under one name, without those another of them overrides: a
 * trait's override replaces the default of the trait it requires. */
private unreplaced(c: *Checker, bodies: Buf[usize]) -> Buf[usize]
    var out: Buf[usize] = buf()
    for m in bodies
        var replaced = false
        for n in bodies
            if n != m && replaces(c, n, m) then replaced = true
        if !replaced then out.push(m)
    out

/** Whether a trait's method `m` is an override, which has no position of its own. */
private is_trait_override(c: *Checker, m: usize) -> bool = trait_overridden(c, m) is Some(_)

/** The first position of class `k`'s method table holding the same method as `target`. */
private table_position(c: *Checker, k: usize, target: usize) -> Option[usize]
    val self_type = own_class_type(c.classes[k], k)
    val table = c.classes[k].table
    for i in 0..<table.len()
        if table[i] is Some(m)
            if same_method(c, self_type, m, target) then return Some(i)
    None

/** The traits an instance of `t` conforms to: those its class names and those they require, then
 * its superclass's, each as an instance of `t` sees it. A trait conformed to with two different type
 * argument lists appears twice. */
private collect_traits(c: *Checker, t: &Type, out: *Buf[&Type])
    if *t is Data(d, _, xs)
        for required in c.data[d].traits
            val r = substitute(required, data_owner(d), xs)
            var seen = false
            for i in 0..<out.len()
                if same_type(out[i], r) then seen = true
            if !seen
                out.push(r)
                collect_traits(c, r, out)
        return
    val k = *t match
        Class(k, _, _) -> k
        _ -> return
    val args = *t match
        Class(_, _, a) -> a
        _ -> buf()
    for required in c.classes[k].traits
        val r = substitute(required, class_owner(k), args)
        var seen = false
        for i in 0..<out.len()
            if same_type(out[i], r) then seen = true
        if !seen
            out.push(r)
            collect_traits(c, r, out)
    if c.classes[k].superclass is Some(sup) then collect_traits(c, substitute(sup, class_owner(k), args), out)

/** The ids of the traits class `k` conforms to, each once. */
private conformed_traits(c: *Checker, k: usize) -> Buf[usize] = trait_ids(c, own_class_type(c.classes[k], k))

/** The ids of the traits data type `d` conforms to through its impls, each once. */
private data_traits(c: *Checker, d: usize) -> Buf[usize] = trait_ids(c, own_type(c.data[d], d))

private trait_ids(c: *Checker, t: &Type) -> Buf[usize]
    var types: Buf[&Type] = buf()
    collect_traits(c, t, &types)
    var ids: Buf[usize] = buf()
    for t in types
        if *t is Class(id, _, _)
            if !contains_id(ids, id) then ids.push(id)
    ids

private contains_id(ids: Buf[usize], id: usize) -> bool
    for i in ids
        if i == id then return true
    false

/** Whether trait `k` requires the trait `start`, directly or through the traits it requires. */
private requires_trait(c: *Checker, start: usize, k: usize, depth: usize) -> bool
    if depth > c.classes.len() then return false
    for required in c.classes[k].traits
        if *required is Class(r, _, _)
            if r == start || requires_trait(c, start, r, depth + 1) then return true
    false

// A trait that requires itself, directly or not, is reported and requires nothing, so a walk over
// what a type conforms to ends.
private break_trait_cycles(c: *Checker)
    for id in 0..<c.classes.len()
        if !is_trait(c, id) then continue
        if requires_trait(c, id, id, 0)
            c.note(c.classes[id].unit, c.classes[id].decl.name_span, s"`${c.classes[id].name}` requires itself")
            c.classes[id].traits = buf()

/** The slot of class `k`'s method table that holds the method named `name`, if it has one. */
/** The slot of class `k`'s method table that holds the same method as `m`, as `self_type` sees both. */
private slot_matching(c: *Checker, k: usize, self_type: &Type, m: usize) -> Option[usize]
    val slots = c.classes[k].slots
    for i in 0..<slots.len()
        if same_method(c, self_type, slots[i], m) then return Some(i)
    None

// An `override` that matches no inherited method by name and parameter types. With no method of
// that name to override it overrides nothing; with one, how its parameters differ from that one's;
// with several, it overrides none of those overloads.
private unmatched_override(c: *Checker, id: usize, sid: Option[usize], conformed: Buf[&Type], m: usize)
    val k = c.classes[id]
    val symbol = c.symbols[m]
    val name = symbol.decl.name
    val self_type = own_class_type(k, id)
    var named: Buf[usize] = buf()
    if sid is Some(s)
        var a = s
        loop
            for other in c.classes[a].methods
                if c.symbols[other].decl.name == name && c.symbols[other].public then add_method(c, self_type, &named, other)
            val sup = c.classes[a].superclass match
                Some(t) -> t
                None -> break
            a = *sup match
                Class(next, _, _) -> next
                _ -> break
    for t in conformed
        if *t is Class(tid, _, _)
            for other in c.classes[tid].methods
                if c.symbols[other].decl.name == name then add_method(c, self_type, &named, other)
    if named.len() == 0
        c.note(k.unit, symbol.decl.name_span, s"`$name` overrides nothing; no superclass or trait of `${k.name}` has a method `$name`")
    elif named.len() == 1 then overrides_matches(c, id, m, named[0])
    else c.note(k.unit, symbol.decl.name_span, s"`${method_key(c, self_type, m)}` overrides nothing; the inherited overloads are ${overload_list(c, named)}, and none takes these parameter types")

// A class's method table, built after its superclass's: the superclass's slots, then a slot for each
// method a subclass may override. A method marked `override` takes the slot of the inherited method
// it replaces, which must have the same parameter types and a result it conforms to; a method that
// shares an inherited method's name without `override` is an error. A class that is not abstract
// implements every abstract method it inherits.
private link_methods(c: *Checker, id: usize, linked: *Buf[bool])
    if linked[id] then return
    linked.set(id, true)
    val k = c.classes[id]
    val unit = k.unit
    if is_trait(c, id)
        // A trait's methods take positions of their own in its conforming classes' tables, except an
        // override, which replaces the default of a method of a trait it requires at that method's
        // position. Redeclaring a required trait's method without `override` is an error.
        // An override takes the defaults of the method it overrides, so the required traits, whose
        // own overrides may bring theirs, are linked first.
        for required in k.traits
            if *required is Class(r, _, _) then link_methods(c, r, linked)
        val trait_type = own_class_type(k, id)
        for i in 0..<k.methods.len()
            val m = k.methods[i]
            val name = c.symbols[m].decl.name
            val target = required_matching(c, id, trait_type, m, 0)
            if k.overriding[i]
                if target is Some(other)
                    if overrides_matches(c, id, m, other) then inherit_defaults(c, m, other)
                elif trait_method(c, id, name) is Some(other)
                    overrides_matches(c, id, m, other)
                else c.note(unit, c.symbols[m].decl.name_span, s"`$name` overrides nothing; no trait `${k.name}` requires has a method `$name`")
            elif target is Some(other)
                c.note(unit, c.symbols[m].decl.name_span, s"`$name` is already a method of `${c.classes[c.symbols[other].owner_class.unwrap()].name}`, which `${k.name}` requires; mark it `override` to replace its default")
        return
    var slots: Buf[usize] = buf()
    var sid: Option[usize] = None
    if k.superclass is Some(t)
        if *t is Class(s, _, _)
            link_methods(c, s, linked)
            sid = Some(s)
            for m in c.classes[s].slots
                slots.push(m)
            for i in k.inherited..<k.fields.len()
                if inherited_method(c, s, k.fields[i].name) is Some(m)
                    c.note(unit, k.fields[i].span, s"`${k.fields[i].name}` is already a method of `${c.classes[c.symbols[m].owner_class.unwrap()].name}`")
    var conformed: Buf[&Type] = buf()
    collect_traits(c, own_class_type(k, id), &conformed)
    // A trait's overrides take their defaults when it is linked, before a class's methods take them.
    for t in conformed
        if *t is Class(tid, _, _) then link_methods(c, tid, linked)
    for i in 0..<conformed.len()
        for j in 0..<i
            if *conformed[i] is Class(a, _, _) && *conformed[j] is Class(b, _, _)
                if a == b then c.note(unit, k.decl.name_span, s"`${k.name}` conforms to `${c.classes[a].name}` twice, as ${type_name(conformed[j])} and ${type_name(conformed[i])}")
    for f in k.fields
        if f.owner == id && f.public
            if trait_method(c, id, f.name) is Some(m)
                if !is_trait_field(c, m) then c.note(unit, f.span, s"`${f.name}` is already a method of `${c.classes[c.symbols[m].owner_class.unwrap()].name}`")
    val self_type = own_class_type(k, id)
    for i in 0..<k.methods.len()
        val m = k.methods[i]
        val symbol = c.symbols[m]
        val name = symbol.decl.name
        var inherited: Option[usize] = None
        if sid is Some(s) then inherited = inherited_matching(c, s, self_type, m)
        // Every method of the traits the class conforms to that the method implements.
        var implemented: Buf[usize] = buf()
        for t in conformed
            if *t is Class(tid, _, _)
                if own_matching(c, tid, self_type, m) is Some(tm)
                    if !contains_id(implemented, tm) then implemented.push(tm)
        var supplies_field = false
        for tm in implemented
            if is_trait_field(c, tm) && !supplies_field
                supplies_field = true
                c.note(unit, symbol.decl.name_span, s"`$name` is a `val` of `${c.classes[c.symbols[tm].owner_class.unwrap()].name}`, which `${k.name}` supplies with a field, not a method: declare `val $name: ${type_name(seen_from(c, self_type, tm, c.symbols[tm].result.unwrap_or(ErrorType)))}`")
        if supplies_field then continue
        if k.overriding[i]
            if inherited is None && implemented.len() == 0
                unmatched_override(c, id, sid, conformed, m)
                continue
            if !symbol.public
                c.note(unit, symbol.decl.name_span, s"`$name` overrides a public method, so it cannot be private")
                continue
            if inherited is Some(target)
                // An inherited method that implements a trait's method has that trait's position
                // rather than a slot of its own.
                slot_matching(c, sid.unwrap(), self_type, m) match
                    Some(slot) ->
                        if overrides_matches(c, id, m, target)
                            slots.set(slot, m)
                            inherit_defaults(c, m, target)
                    None ->
                        if overrides_matches(c, id, m, target) then inherit_defaults(c, m, target)
            for tm in implemented
                if overrides_matches(c, id, m, tm) then inherit_defaults(c, m, tm)
        elif inherited is Some(t)
            c.note(unit, symbol.decl.name_span, s"`$name` overrides `${c.symbols[t].name}`; mark it `override`")
        elif implemented.len() > 0
            c.note(unit, symbol.decl.name_span, s"`$name` implements `${c.symbols[implemented[0]].name}`; mark it `override`")
        elif is_open(c, id) && symbol.public then slots.push(m)
    c.classes[id].slots = slots

// Each trait's position in the method tables of the classes and data types conforming to it. The
// whole program is known, so the positions are chosen once for all of them: each trait takes the
// lowest position at which its methods fit, in every type conforming to it, past a class's own slots
// and the positions of the other traits the type conforms to that are already placed.
private place_traits(c: *Checker)
    var conformed: Buf[Buf[usize]] = buf()
    for k in 0..<c.classes.len()
        if is_trait(c, k) then conformed.push(buf()) else conformed.push(conformed_traits(c, k))
    // Every conforming type's traits and slot count: the classes, then the data types.
    var holders: Buf[Buf[usize]] = buf()
    var slot_counts: Buf[usize] = buf()
    for k in 0..<c.classes.len()
        holders.push(conformed[k])
        slot_counts.push(c.classes[k].slots.len())
    var data_conformed: Buf[Buf[usize]] = buf()
    for d in 0..<c.data.len()
        val ids = data_traits(c, d)
        data_conformed.push(ids)
        holders.push(ids)
        slot_counts.push(0)
    var placed: Buf[bool] = buf()
    for _ in c.classes
        placed.push(false)
    for t in 0..<c.classes.len()
        if !is_trait(c, t) then continue
        val n = c.classes[t].methods.len()
        var base = 0usize
        loop
            if n == 0 then break
            var free = true
            for k in 0..<holders.len()
                if !contains_id(holders[k], t) then continue
                if base < slot_counts[k] then free = false
                for other in holders[k]
                    if placed[other]
                        val start = c.classes[other].base
                        val end = start + c.classes[other].methods.len()
                        if base < end && start < base + n then free = false
            if free then break
            base += 1
        c.classes[t].base = base
        placed.set(t, true)
    for k in 0..<c.classes.len()
        if !is_trait(c, k) then ensure_table(c, k, conformed)
    for d in 0..<c.data.len()
        build_data_table(c, d, data_conformed[d])

// A data type's method table: at each position of a trait it conforms to, the type's own method of
// that name, which an impl of a trait declares, or else the trait's default body. Two different
// default bodies under one name must be replaced by the type's own; every abstract method must be.
private build_data_table(c: *Checker, id: usize, conformed: Buf[usize])
    if conformed.len() == 0 then return
    val name_of = c.data[id].name
    var size = 0usize
    for t in conformed
        val end = c.classes[t].base + c.classes[t].methods.len()
        if end > size then size = end
    var table: Buf[Option[usize]] = buf()
    for _ in 0..<size
        table.push(None)
    var reported: Buf[string] = buf()
    val self_type = own_type(c.data[id], id)
    for t in conformed
        val methods = c.classes[t].methods
        for j in 0..<methods.len()
            // An override fills the position of the method it overrides.
            if is_trait_override(c, methods[j]) then continue
            val name = c.symbols[methods[j]].decl.name
            val key = method_key(c, self_type, methods[j])
            var chosen = methods[j]
            var own: Option[usize] = None
            val mine = c.data[id].methods
            if is_trait_field(c, methods[j])
                table.set(c.classes[t].base + j, Some(data_supplied_field(c, id, methods[j])))
                continue
            for k in 0..<mine.len()
                if same_method(c, self_type, mine[k], methods[j])
                    own = Some(mine[k])
                    if !c.data[id].implementing[k] && !contains_name(reported, key)
                        reported.push(key)
                        val m = mine[k]
                        c.note(c.symbols[m].unit, c.symbols[m].decl.name_span, s"`$name` implements `${c.symbols[methods[j]].name}`, so it belongs in an impl of `${c.classes[t].name}` for `$name_of`")
            if own is Some(m)
                chosen = m
                inherit_defaults(c, m, methods[j])
            else
                var found: Buf[usize] = buf()
                for other in conformed
                    if own_matching(c, other, self_type, methods[j]) is Some(m)
                        if !is_abstract_method(c.symbols[m]) && !contains_id(found, m) then found.push(m)
                val bodies = unreplaced(c, found)
                if bodies.len() > 0 then chosen = bodies[0]
                if bodies.len() > 1 && !contains_name(reported, key)
                    reported.push(key)
                    report_conformance(c, id, t, s"`$name_of` inherits two implementations of `$name`, `${c.symbols[bodies[0]].name}` and `${c.symbols[bodies[1]].name}`; implement it in an impl")
                elif bodies.len() == 1 && chosen != methods[j] && !contains_name(reported, key)
                    if defaults_conflict(c, chosen, methods[j], s"implement `$name` in an impl") is Some(text)
                        reported.push(key)
                        report_conformance(c, id, t, s"`${c.symbols[chosen].name}` implements `${c.symbols[methods[j]].name}` for `$name_of`, $text")
            table.set(c.classes[t].base + j, Some(chosen))
    c.data[id].table = table
    for entry in table
        if entry is Some(m)
            val name = c.symbols[m].decl.name
            val key = method_key(c, self_type, m)
            if is_abstract_method(c.symbols[m]) && !contains_name(reported, key)
                reported.push(key)
                val t = c.symbols[m].owner_class.unwrap()
                if is_trait_field(c, m)
                    val ty = seen_from(c, self_type, m, c.symbols[m].result.unwrap_or(ErrorType))
                    val how = if c.data[id].variants.len() == 1 then s"declare a field `$name: ${type_name(ty)}` in it" else "it has several variants, so it has no field every value shares"
                    report_conformance(c, id, t, s"`$name_of` does not supply `${c.classes[t].name}`'s `val $name`, which a data type supplies with a field of its one variant; $how")
                    continue
                // A method of an impl of the trait with this name and other parameter types was meant
                // to implement it where the trait has no other method of the name.
                var meant: Option[usize] = None
                var overloads = 0
                for other in c.classes[t].methods
                    if c.symbols[other].decl.name == name then overloads += 1
                val mine = c.data[id].methods
                for k in 0..<mine.len()
                    if c.data[id].implementing[k] && c.symbols[mine[k]].decl.name == name && meant is None then meant = Some(mine[k])
                if overloads == 1 && meant is Some(own)
                    if param_mismatch(c, self_type, own, m) is Some(text)
                        c.note(c.symbols[own].unit, c.symbols[own].decl.name_span, s"`${c.symbols[own].name}` implements `${c.symbols[m].name}`, $text")
                        continue
                report_conformance(c, id, t, s"`$name_of` does not implement `$name` from `${c.classes[t].name}`; implement it in an impl of `${c.classes[t].name}`")

// What fills the position of a trait's `val` `tm` in data type `id`'s table: a method that reads the
// field of that name of the type's one variant, or else `tm` itself, which leaves it abstract. A
// method an impl declares under the name is reported, since a field supplies a `val`.
private data_supplied_field(c: *Checker, id: usize, tm: usize) -> usize
    val d = c.data[id]
    val name = c.symbols[tm].decl.name
    val self_type = own_type(d, id)
    for m in d.methods
        if same_method(c, self_type, m, tm)
            val ty = seen_from(c, self_type, tm, c.symbols[tm].result.unwrap_or(ErrorType))
            c.note(c.symbols[m].unit, c.symbols[m].decl.name_span, s"`$name` is a `val` of `${c.classes[c.symbols[tm].owner_class.unwrap()].name}`, which `${d.name}` supplies with a field, not a method: declare the field `$name: ${type_name(ty)}`")
            return m
    if d.variants.len() == 1
        if contains_name(d.variants[0].field_names, name)
            return field_getter(c, d.unit, d.module_name, d.name, d.decl.span, name, self_type, data_owner(id), d.decl.type_params, None)
    tm

// A problem with data type `id`'s conformance to trait `t` is reported at the impl that brings the
// trait in: the impl of `t` itself, or of a trait requiring it.
private report_conformance(c: *Checker, id: usize, t: usize, message: string)
    for block in c.impls
        if *block.target is Data(d, _, _)
            if d != id then continue
            if block.trait_type is Some(tt)
                if *tt is Class(k, _, _)
                    if k == t || requires_trait(c, t, k, 0)
                        c.note(block.unit, block.decl.target.span, message)
                        return
    c.note(c.data[id].unit, c.data[id].decl.span, message)

// A class's method table: its slots, then at each trait's position the implementation of each of
// the trait's methods. Under each name the class's own override wins; otherwise the class inherits
// what its superclass's table holds and the default bodies of the traits it newly conforms to, and
// when those are two different implementations it must override the method. A class that is not
// abstract implements every abstract method its table holds.
private build_table(c: *Checker, id: usize, conformed: Buf[Buf[usize]])
    val k = c.classes[id]
    var size = k.slots.len()
    for t in conformed[id]
        val end = c.classes[t].base + c.classes[t].methods.len()
        if end > size then size = end
    var table: Buf[Option[usize]] = buf()
    for i in 0..<size
        if i < k.slots.len() then table.push(Some(k.slots[i])) else table.push(None)
    for t in conformed[id]
        val methods = c.classes[t].methods
        for j in 0..<methods.len()
            if !is_trait_override(c, methods[j]) then table.set(c.classes[t].base + j, Some(methods[j]))
    var inherited_traits: Buf[usize] = buf()
    var sup_table: Buf[Option[usize]] = buf()
    if k.superclass is Some(s)
        if *s is Class(sid, _, _)
            inherited_traits = conformed[sid]
            ensure_table(c, sid, conformed)
            sup_table = c.classes[sid].table
    var reported: Buf[string] = buf()
    val self_type = own_class_type(k, id)
    for i in 0..<size
        val held = table[i] match
            Some(m) -> m
            None -> continue
        val name = c.symbols[held].decl.name
        val key = method_key(c, self_type, held)
        if is_trait_field(c, held)
            table.set(i, Some(supplied_field(c, id, held, sup_table, i)))
            continue
        // Every method the class inherits that is this one; its own override, if it has one.
        var candidates: Buf[usize] = buf()
        var own: Option[usize] = None
        for m in k.methods
            if own is None && same_method(c, self_type, m, held)
                if c.symbols[m].public then own = Some(m)
        for entry in table
            if entry is Some(m)
                if same_method(c, self_type, m, held) && !is_trait(c, c.symbols[m].owner_class.unwrap()) && !contains_id(candidates, m) then candidates.push(m)
        for entry in sup_table
            if entry is Some(m)
                if same_method(c, self_type, m, held) && !contains_id(candidates, m) then candidates.push(m)
        for t in conformed[id]
            if contains_id(inherited_traits, t) then continue
            if own_matching(c, t, self_type, held) is Some(m)
                if !is_abstract_method(c.symbols[m]) && !contains_id(candidates, m) then candidates.push(m)
        var chosen: Option[usize] = own
        if own is None
            var found: Buf[usize] = buf()
            for m in candidates
                if !is_abstract_method(c.symbols[m]) then found.push(m)
            val bodies = unreplaced(c, found)
            if bodies.len() > 0 then chosen = Some(bodies[0])
            if bodies.len() > 1 && !contains_name(reported, key)
                reported.push(key)
                c.note(k.unit, k.decl.name_span, s"`${k.name}` inherits two implementations of `$name`, `${c.symbols[bodies[0]].name}` and `${c.symbols[bodies[1]].name}`; override it")
        if chosen is Some(m) then table.set(i, Some(m))
    c.classes[id].table = table
    if !is_abstract_class(c, id)
        var missing: Buf[string] = buf()
        for entry in table
            if entry is Some(m)
                val name = c.symbols[m].decl.name
                val key = method_key(c, self_type, m)
                if is_abstract_method(c.symbols[m]) && !contains_name(missing, key)
                    missing.push(key)
                    val owner = c.symbols[m].owner_class.unwrap()
                    // An object is its one instance, so it cannot be left abstract.
                    val otherwise = if k.decl.object then "" else s", or declare `${k.name}` abstract"
                    if is_trait_field(c, m)
                        val ty = seen_from(c, self_type, m, c.symbols[m].result.unwrap_or(ErrorType))
                        c.note(k.unit, k.decl.name_span, s"`${k.name}` does not supply `${c.classes[owner].name}`'s `val $name`; declare a public field `val $name: ${type_name(ty)}`$otherwise")
                        continue
                    c.note(k.unit, k.decl.name_span, s"`${k.name}` does not implement `$name` from `${c.classes[owner].name}`; implement it$otherwise")

// What fills the position of a trait's `val` `tm`, at `position` of class `id`'s table: the method
// that reads the class's public field of that name, the superclass's where it already supplies the
// trait, or else `tm` itself, which leaves it abstract. A method or a private field of that name is
// reported where it is declared.
private supplied_field(c: *Checker, id: usize, tm: usize, sup_table: Buf[Option[usize]], position: usize) -> usize
    if position < sup_table.len()
        if sup_table[position] is Some(m)
            if contains_id(c.field_getters, m) then return m
    val k = c.classes[id]
    val name = c.symbols[tm].decl.name
    for m in k.methods
        if same_method(c, own_class_type(k, id), m, tm) then return m
    var hidden: Option[usize] = None
    for i in 0..<k.fields.len()
        if k.fields[i].name != name then continue
        if k.fields[i].public then return field_getter(c, k.unit, k.module_name, k.name, k.fields[i].span, name, own_class_type(k, id), class_owner(id), k.decl.type_params, Some(id))
        hidden = Some(i)
    if hidden is Some(i)
        val f = k.fields[i]
        val keyword = if f.mutable then "var" else "val"
        c.note(k.unit, f.span, s"`$name` is private to `${c.classes[f.owner].name}`, so it cannot supply `${c.classes[c.symbols[tm].owner_class.unwrap()].name}`'s `val $name`; declare it a public field, `$keyword $name`")
        return field_getter(c, k.unit, k.module_name, k.name, f.span, name, own_class_type(k, id), class_owner(id), k.decl.type_params, Some(id))
    tm

// A method that yields field `name` of its receiver, `self.name`, which supplies a trait's `val` of
// that name: a class's method when `owner_class` is its class, otherwise one an impl adds to the
// data type `self_type`.
private field_getter(c: *Checker, unit: usize, module_name: string, type_name_of: string, at: Span, name: string, self_type: &Type, type_owner: usize, type_params: Buf[TypeParam], owner_class: Option[usize]) -> usize
    val read = Expr(at, Member(Expr(at, Name("self")), name))
    val decl = Function(buf(), at, at, name, buf(), buf(), None, Some(read), buf())
    var params: Buf[&Type] = buf()
    params.push(self_type)
    var names: Buf[string] = buf()
    names.push("self")
    var defaults: Buf[Option[usize]] = buf()
    defaults.push(None)
    val receiver = if owner_class is None then Some(self_type) else None
    val id = c.symbols.len()
    c.symbols.push(FunctionSymbol(unit, module_name, type_name_of + "." + name, decl, params, names, None, None, None, buf(), buf(), buf(), false, false, false, defaults, None, type_owner, type_params, owner_class, false, true, "", receiver))
    c.states.push(0)
    c.bodies.push(None)
    c.locals.push(buf())
    c.field_getters.push(id)
    id

/** Class `id`'s method table, built first if it is not yet. */
private ensure_table(c: *Checker, id: usize, conformed: Buf[Buf[usize]])
    if c.classes[id].table.len() == 0 then build_table(c, id, conformed)

// An override declares as many type parameters of its own as the method it overrides, takes its
// parameters, with the superclass's type arguments substituted and the type parameters matched by
// position, and yields its result or, for a class, a subclass of it.
private overrides_matches(c: *Checker, id: usize, m: usize, target: usize) -> bool
    val symbol = c.symbols[m]
    if param_mismatch(c, own_class_type(c.classes[id], id), m, target) is Some(text)
        c.note(c.classes[id].unit, symbol.decl.name_span, s"`${symbol.decl.name}` overrides `${c.symbols[target].name}`, $text")
        return false
    true

// The results of overrides, compared once every body is checked, since a result may be inferred: an
// override yields the overridden method's result or, where that is a class, a subclass of it.
// A trait's method may also be implemented by a method the class inherits, from its superclass or
// as another trait's default; that one takes the trait method's parameters and yields its result
// as the class sees them both.
// A class's or trait's `+T` appears only where a value of `T` is read out: a method's result, an
// immutable field, a parent's covariant argument. A `-T` appears only where one is passed in: a
// method's parameter. A mutable field is read and written, so neither may appear in it. Private
// members are checked like public ones, since a method of the instance seen at a wider type reads
// and writes them too. The receiver is the instance itself and is not checked.
private check_class_variance(c: *Checker, id: usize)
    val k = c.classes[id]
    val params = k.decl.type_params
    var variant = false
    for tp in params
        if !(tp.variance is Invariant) then variant = true
    if !variant then return
    val owner = class_owner(id)
    val at = k.decl.name_span
    if k.superclass is Some(sup) then variance_in(c, k.unit, params, owner, sup, 1, at, s"the superclass ${type_name(sup)}")
    for t in k.traits
        variance_in(c, k.unit, params, owner, t, 1, at, s"the trait ${type_name(t)}")
    for i in k.inherited..<k.fields.len()
        val f = k.fields[i]
        val ty = f.ty.unwrap_or(ErrorType)
        if f.mutable then variance_in(c, k.unit, params, owner, ty, 0, f.span, s"the mutable field `${f.name}`")
        else variance_in(c, k.unit, params, owner, ty, 1, f.span, s"the field `${f.name}`")
    for m in k.methods
        val symbol = c.symbols[m]
        val name = symbol.decl.name
        for j in 1..<symbol.params.len()
            val span = if j - 1 < symbol.decl.params.len() then symbol.decl.params[j - 1].span else symbol.decl.name_span
            val pname = if j < symbol.param_names.len() then symbol.param_names[j] else "_"
            variance_in(c, k.unit, params, owner, symbol.params[j], -1, span, s"the parameter `$pname` of `$name`")
        val result_span = symbol.decl.result match
            Some(r) -> r.span
            None -> symbol.decl.name_span
        variance_in(c, k.unit, params, owner, symbol.result.unwrap_or(ErrorType), 1, result_span, s"the result of `$name`")
        // A bound on a method's own type parameter limits what a caller passes in, as a parameter
        // type does.
        for j in params.len()..<symbol.type_params.len()
            val tp = symbol.type_params[j]
            for b in bounds_at(c, owner, symbol.type_params, j)
                variance_in(c, k.unit, params, owner, b, -1, tp.span, s"the bound of `${tp.name}` in `$name`")

// A data type's fields are immutable, so a `+T` may appear in them and a `-T` may not; the traits
// its impls make it conform to are parents, whose arguments follow their own variance.
private check_data_variance(c: *Checker, id: usize)
    val d = c.data[id]
    val params = d.decl.type_params
    var variant = false
    for tp in params
        if !(tp.variance is Invariant) then variant = true
    if !variant then return
    val owner = data_owner(id)
    for v in d.variants
        for i in 0..<v.fields.len()
            val name = if i < v.field_names.len() then v.field_names[i] else "_"
            variance_in(c, d.unit, params, owner, v.fields[i], 1, v.span, s"the field `$name` of `${v.name}`")
    for t in d.traits
        variance_in(c, d.unit, params, owner, t, 1, d.decl.span, s"the trait ${type_name(t)}")

// Reports the first type parameter of `owner` that `t` names in a position its variance forbids.
// `polarity` is 1 where a value is read out, -1 where one is passed in, 0 where both happen; it flips
// through a function type's parameters and follows each generic type's declared variance.
private variance_in(c: *Checker, unit: usize, params: Buf[TypeParam], owner: usize, t: &Type, polarity: i32, at: Span, place: string) -> bool
    *t match
        TypeVar(o, i, name) ->
            if o != owner || i >= params.len() then return true
            val v = params[i].variance
            val ok = if v is Covariant then polarity == 1 elif v is Contravariant then polarity == -1 else true
            if ok then return true
            val kind = if v is Covariant then "covariant" else "contravariant"
            val sign = if v is Covariant then "+" else "-"
            val position = if polarity == 1 then "a covariant" elif polarity == -1 then "a contravariant" else "an invariant"
            c.note(unit, at, s"the $kind type parameter `$sign$name` appears in $position position, $place")
            false
        Tuple(items) ->
            for item in items
                if !variance_in(c, unit, params, owner, item, polarity, at, place) then return false
            true
        Function(ps, r) ->
            for p in ps
                if !variance_in(c, unit, params, owner, p, -polarity, at, place) then return false
            variance_in(c, unit, params, owner, r, polarity, at, place)
        ByName(inner) -> variance_in(c, unit, params, owner, inner, polarity, at, place)
        Data(d, _, args) -> variance_args(c, unit, params, owner, c.data[d].decl.type_params, args, polarity, at, place)
        Class(k, _, args) -> variance_args(c, unit, params, owner, c.classes[k].decl.type_params, args, polarity, at, place)
        _ -> true

private variance_args(c: *Checker, unit: usize, params: Buf[TypeParam], owner: usize, declared: Buf[TypeParam], args: Buf[&Type], polarity: i32, at: Span, place: string) -> bool
    for i in 0..<args.len()
        val v = if i < declared.len() then declared[i].variance else Invariant
        val p = if v is Covariant then polarity elif v is Contravariant then -polarity else 0
        if !variance_in(c, unit, params, owner, args[i], p, at, place) then return false
    true

private check_override_results(c: *Checker, id: usize)
    val k = c.classes[id]
    if is_trait(c, id)
        for m in k.methods
            if trait_overridden(c, m) is Some(base)
                if result_mismatch(c, own_class_type(k, id), m, base) is Some(text)
                    c.note(k.unit, c.symbols[m].decl.name_span, s"`${c.symbols[m].decl.name}` overrides `${c.symbols[base].name}`, $text")
        return
    if k.superclass is Some(sup)
        if *sup is Class(sid, _, _)
            val base_slots = c.classes[sid].slots
            for i in 0..<base_slots.len()
                val m = k.slots[i]
                if m == base_slots[i] || c.symbols[m].owner_class != Some(id) then continue
                if result_mismatch(c, own_class_type(c.classes[id], id), m, base_slots[i]) is Some(text)
                    c.note(k.unit, c.symbols[m].decl.name_span, s"`${c.symbols[m].decl.name}` overrides `${c.symbols[base_slots[i]].name}`, $text")
    for t in conformed_traits(c, id)
        val methods = c.classes[t].methods
        for j in 0..<methods.len()
            val position = c.classes[t].base + j
            if position >= k.table.len() then continue
            val m = k.table[position] match
                Some(m) -> m
                None -> continue
            val base = methods[j]
            if m == base then continue
            if contains_id(c.field_getters, m)
                if field_mismatch(c, own_class_type(c.classes[id], id), m, base) is Some(text) then c.note(k.unit, c.symbols[m].decl.name_span, text)
                continue
            val described = s"`${c.symbols[m].name}` implements `${c.symbols[base].name}`"
            val own = c.symbols[m].owner_class == Some(id)
            val at = if own then c.symbols[m].decl.name_span else k.decl.name_span
            if !own
                if param_mismatch(c, own_class_type(c.classes[id], id), m, base) is Some(text)
                    c.note(k.unit, at, s"$described for `${k.name}`, $text")
                    continue
                if defaults_conflict(c, m, base, s"override `${c.symbols[m].decl.name}`") is Some(text) then c.note(k.unit, at, s"$described for `${k.name}`, $text")
            if result_mismatch(c, own_class_type(c.classes[id], id), m, base) is Some(text)
                c.note(k.unit, at, s"$described, $text")

/** A type in method `m`'s signature as a value of `self_type`, a class's or a data type's own type,
 * sees it. The method's own type parameters are renamed by position to `method_params_owner()`, so
 * the signatures of two methods with type parameters of their own compare. */
private seen_from(c: *Checker, self_type: &Type, m: usize, t: &Type) -> &Type
    val symbol = c.symbols[m]
    val own = symbol.decl.type_params.len()
    val outer = symbol.type_params.len() - own
    var renamed = t
    if own > 0
        var names: Buf[&Type] = buf()
        for i in 0..<outer
            names.push(TypeVar(symbol.type_owner, i, symbol.type_params[i].name))
        for j in 0..<own
            names.push(TypeVar(method_params_owner(), j, symbol.type_params[outer + j].name))
        renamed = substitute(t, symbol.type_owner, names)
    // A method an impl adds to a data type already names the type's own parameters.
    val owner = symbol.owner_class match
        Some(k) -> k
        None -> return renamed
    val args = ancestor_type(c.classes, c.data, self_type, owner) match
        Some(a) -> *a match
            Class(_, _, xs) -> xs
            _ -> buf()
        None -> buf()
    // A trait's `Self` is the type the method is seen from.
    var selfless = renamed
    if is_trait(c, owner)
        var implementer: Buf[&Type] = buf()
        implementer.push(self_type)
        selfless = substitute(renamed, self_owner(owner), implementer)
    substitute(selfless, class_owner(owner), args)

/** How many type parameters of its own method `m` declares. */
private own_type_params(c: *Checker, m: usize) -> usize = c.symbols[m].decl.type_params.len()

/** How method `m`'s parameters differ from those of `base`, which it implements for `self_type`.
 * The two declare the same number of type parameters of their own. */
private param_mismatch(c: *Checker, self_type: &Type, m: usize, base: usize) -> Option[string]
    val have = c.symbols[m].params
    val want = c.symbols[base].params
    val own = own_type_params(c, base)
    if own_type_params(c, m) != own then return Some(s"which has ${count(own, "type parameter")} of its own, not ${own_type_params(c, m)}")
    if have.len() != want.len() then return Some(s"which takes ${count(want.len() - 1, "parameter")}, not ${have.len() - 1}")
    for i in 1..<want.len()
        val w = seen_from(c, self_type, base, want[i])
        val h = seen_from(c, self_type, m, have[i])
        if !same_type(h, w) then return Some(s"whose parameter `${c.symbols[base].param_names[i]}` is ${type_name(w)}, not ${type_name(h)}")
    None

/** How method `m`'s result differs from that of `base`, which it overrides or implements for
 * `self_type`: it yields that result or, where that is a class or a trait, a type conforming to it. */
private result_mismatch(c: *Checker, self_type: &Type, m: usize, base: usize) -> Option[string]
    val want = seen_from(c, self_type, base, c.symbols[base].result.unwrap_or(ErrorType))
    val own = seen_from(c, self_type, m, c.symbols[m].result.unwrap_or(ErrorType))
    var fits = alike_or_error(own, want)
    if *want is Class(b, _, _)
        if ancestor_type(c.classes, c.data, own, b) is Some(up) then fits = alike_or_error(up, want)
    if fits then None else Some(s"which yields ${type_name(want)}, not ${type_name(own)}")

// The methods in a data type's table implement its traits' methods with their parameters and yield
// their results, or types conforming to them, as the data type sees both; compared once every body
// is checked, since a result may be inferred.
private check_data_implementations(c: *Checker, id: usize)
    val table = c.data[id].table
    if table.len() == 0 then return
    val self_type = own_type(c.data[id], id)
    for t in data_traits(c, id)
        val methods = c.classes[t].methods
        for j in 0..<methods.len()
            val position = c.classes[t].base + j
            if position >= table.len() then continue
            val m = table[position] match
                Some(m) -> m
                None -> continue
            val base = methods[j]
            if m == base then continue
            if contains_id(c.field_getters, m)
                if field_mismatch(c, self_type, m, base) is Some(text) then report_conformance(c, id, t, text)
                continue
            val described = s"`${c.symbols[m].name}` implements `${c.symbols[base].name}`"
            if c.symbols[m].receiver is Some(_)
                val at = c.symbols[m].decl.name_span
                if param_mismatch(c, self_type, m, base) is Some(text) then c.note(c.symbols[m].unit, at, s"$described, $text")
                elif result_mismatch(c, self_type, m, base) is Some(text) then c.note(c.symbols[m].unit, at, s"$described, $text")
            elif param_mismatch(c, self_type, m, base) is Some(text) then report_conformance(c, id, t, s"$described for `${c.data[id].name}`, $text")
            elif result_mismatch(c, self_type, m, base) is Some(text) then report_conformance(c, id, t, s"$described, $text")

/** How the field that `getter` reads differs from the trait's `val` `base` it supplies for
 * `self_type`: its type is the `val`'s or, where that is a class or a trait, one conforming to it. */
private field_mismatch(c: *Checker, self_type: &Type, getter: usize, base: usize) -> Option[string]
    if result_mismatch(c, self_type, getter, base) is None then return None
    val want = seen_from(c, self_type, base, c.symbols[base].result.unwrap_or(ErrorType))
    val have = seen_from(c, self_type, getter, c.symbols[getter].result.unwrap_or(ErrorType))
    val name = c.symbols[base].decl.name
    Some(s"the field `$name` is ${type_name(have)}, but `${c.classes[c.symbols[base].owner_class.unwrap()].name}`'s `val $name`, which it supplies, is ${type_name(want)}")

/** Whether method `m` is read with field syntax: a trait's `val`, or the method a field supplies it
 * with. */
private reads_field(c: *Checker, m: usize) -> bool = is_trait_field(c, m) || contains_id(c.field_getters, m)

/** Whether method `m` is a trait's `val`. */
private is_trait_field(c: *Checker, m: usize) -> bool = contains_id(c.trait_fields, m)

private alike_or_error(a: &Type, b: &Type) -> bool = *a is ErrorType || *b is ErrorType || same_type(a, b)

/** The nearest public method named `name` of class `id` or its ancestors: what a subclass inherits. */
private inherited_method(c: *Checker, id: usize, name: string) -> Option[usize]
    var k = id
    loop
        if own_method(c, k, name) is Some(m)
            if c.symbols[m].public then return Some(m)
        val sup = c.classes[k].superclass match
            Some(t) -> t
            None -> return None
        k = *sup match
            Class(s, _, _) -> s
            _ -> return None
    None

/** The nearest public method of class `id` or its ancestors that is the same method as `m`, as
 * `self_type` sees both: the one `m` overrides. */
private inherited_matching(c: *Checker, id: usize, self_type: &Type, m: usize) -> Option[usize]
    var k = id
    loop
        if own_matching(c, k, self_type, m) is Some(found)
            if c.symbols[found].public then return Some(found)
        val sup = c.classes[k].superclass match
            Some(t) -> t
            None -> return None
        k = *sup match
            Class(s, _, _) -> s
            _ -> return None
    None

/** `n` and a noun, plural unless `n` is one: "1 field", "2 fields". */
private count(n: usize, noun: string) -> string = if n == 1 then s"1 $noun" else s"$n ${noun}s"

private contains_name(names: Buf[string], name: string) -> bool
    for n in names
        if n == name then return true
    false

// `owner` and `type_params` are the type parameters in scope in the signature: a function's own, or
// for a method its class's and its own.
private signature(c: *Checker, unit: usize, module_name: string, f: &Function, owner: usize, type_params: Buf[TypeParam], bodyless: bool) -> FunctionSymbol
    var params: Buf[&Type] = buf()
    var names: Buf[string] = buf()
    // A generic function's own type parameters are in scope in its signature.
    val outer_generic = c.generic
    if type_params.len() > 0 then c.generic = Some(GenericScope(owner, type_params))
    // The function's own type parameters follow those of its class or impl, if it has any.
    if type_params.len() >= f.type_params.len()
        declare_bounds(c, unit, owner, type_params, type_params.len() - f.type_params.len())
    for tp in f.type_params
        if !(tp.variance is Invariant) then c.note(unit, tp.span, "variance is written on the parameters of a type, not of a function")
    for p in f.params
        p.pattern.kind match
            Name(n) -> names.push(n)
            _ ->
                c.note(unit, p.pattern.span, "parameter patterns are not implemented")
                names.push("_")
        if p.variadic then c.note(unit, p.span, "repeated parameters are not implemented")
        if p.by_name && f.clauses.len() > 0
            c.note(unit, p.pattern.span, s"`${f.name}` is defined by clauses, which match its arguments, so its parameters cannot be by-name")
        val ty = resolve_type(c, unit, p.ty)
        if p.by_name && f.clauses.len() == 0 then params.push(ByName(ty)) else params.push(ty)
    var result: Option[&Type] = None
    if f.result is Some(r) then result = Some(resolve_type(c, unit, r))
    elif f.body is None && f.clauses.len() == 0 then result = Some(Unit)
    elif f.body is Some(b)
        if b.kind is Block(_, true) then result = Some(Unit)
    val intrinsic = intrinsic_of(c, unit, f)
    val binding = has_annotation(f, "sysl")
    if binding then check_binding(c, unit, f, params, result, intrinsic is Some(_))
    if intrinsic is Some(name)
        intrinsic_signature(name) match
            Some(expected) ->
                val declared: &Type = Function(params, result.unwrap_or(Unit))
                if !same_type(declared, expected)
                    c.note(unit, f.name_span, s"intrinsic `$name` has type ${type_name(expected)}, not ${type_name(declared)}")
            None -> c.note(unit, f.name_span, s"`$name` is not an intrinsic")
    elif f.body is None && f.clauses.len() == 0 && !bodyless && !binding
        c.note(unit, f.name_span, s"`${f.name}` needs a body, or clauses on the lines after it")
    c.generic = outer_generic
    FunctionSymbol(unit, module_name, f.name, f, params, names, result, intrinsic, None, buf(), buf(), buf(), false, false, false, buf(), None, owner, type_params, None, false, true, "", None)

// Each default argument becomes a function of its own, declared beside the function whose parameter
// it belongs to: it takes the parameters before that one, so the default may use them, and yields
// the default. It is checked in the declaring function's scope, never the caller's, and a call that
// omits the argument calls it. A generic function's defaults are generic over the same parameters.
// The default of a by-name parameter is its delayed expression: the function yields it unevaluated.
//
// A method's default takes the receiver first, then the parameters before its own, and is checked as
// the method's body is: `self` and the members of the receiver's type are in scope. A constructor's
// default takes the parameters before its own; no object exists yet, so it has no `self`. The
// defaults of both share their type parameters with the class, or the impl, they belong to.
private declare_defaults(c: *Checker, id: usize)
    val f = c.symbols[id]
    val first = if is_method(f) then 1usize else 0usize
    val shared = f.owner_class is Some(_) || f.receiver is Some(_)
    var defaults: Buf[Option[usize]] = buf()
    for _ in 0..<first
        defaults.push(None)
    for i in first..<f.params.len()
        val p = f.decl.params[i - first]
        if p.default is None || p.variadic
            defaults.push(None)
            continue
        val value = p.default.unwrap()
        val did = c.symbols.len()
        var own: Buf[&Type] = buf()
        for k in 0..<f.decl.type_params.len()
            own.push(TypeVar(did, k, f.decl.type_params[k].name))
        var params: Buf[&Type] = buf()
        var names: Buf[string] = buf()
        var decls: Buf[Param] = buf()
        for k in 0..<i
            params.push(if shared then f.params[k] else substitute(f.params[k], id, own))
            names.push(f.param_names[k])
            if k >= first then decls.push(f.decl.params[k - first])
        val result = if shared then f.params[i] else substitute(f.params[i], id, own)
        val name = s"${f.name}/${f.param_names[i]}"
        val decl = Function(buf(), value.span, p.span, name, f.decl.type_params, decls, None, Some(value), buf())
        val type_owner = if shared then f.type_owner else did
        val type_params = if shared then f.type_params else f.decl.type_params
        val owner_class = if f.constructor then None else f.owner_class
        c.symbols.push(FunctionSymbol(f.unit, f.module_name, name, decl, params, names, Some(result), None, f.root, buf(), buf(), buf(), false, false, false, buf(), Some(f.param_names[i]), type_owner, type_params, owner_class, false, true, "", f.receiver))
        c.states.push(0)
        c.bodies.push(None)
        c.locals.push(buf())
        defaults.push(Some(did))
    c.symbols[id].defaults = defaults

// `@intrinsic("name")` and `@sysl("path")` are the annotations this compiler gives meaning to; each
// is valid only on a function without a body. This reads the first; `sysl_binding_of` the second.
private intrinsic_of(c: *Checker, unit: usize, f: &Function) -> Option[string]
    var out: Option[string] = None
    for a in f.annotations
        if a.name == "sysl" then continue
        if a.name != "intrinsic"
            c.note(unit, a.span, s"unknown annotation `@${a.name}`")
            continue
        if a.args.len() != 1 || a.args[0].name is Some(_)
            c.note(unit, a.span, "`@intrinsic` takes one string, the intrinsic's name")
            continue
        a.args[0].value.kind match
            StringLit(name) -> out = Some(name)
            _ -> c.note(unit, a.span, "`@intrinsic` takes one string, the intrinsic's name")
        if f.body is Some(_) then c.note(unit, a.span, "an intrinsic function has no body")
    out

/** The intrinsics the compiler implements, with the type each must be declared with. */
intrinsic_signature(name: string) -> Option[&Type]
    if name == "print_line"
        var params: Buf[&Type] = buf()
        params.push(Str)
        return Some(Function(params, Unit))
    None

// The bounds of the type parameter at `index` of `owner` are recorded under this key: the
// parameter's place in the source tells apart the methods of one class, whose own type parameters
// share an owner and positions.
private bound_key(owner: usize, index: usize, tp: TypeParam) -> string = s"$owner/$index/${tp.span.start}/${tp.name}"

// Resolves the bounds of `params` from position `from` on, in the scope that declares them, and
// records them. A bound is a trait or a class. It may name the parameters, and a trait that
// mentions `Self`, which is a bound and never a type.
private declare_bounds(c: *Checker, unit: usize, owner: usize, params: Buf[TypeParam], from: usize)
    for i in from..<params.len()
        val tp = params[i]
        if tp.bounds.len() == 0 then continue
        var bounds: Buf[&Type] = buf()
        for b in tp.bounds
            val t = resolve_bound(c, unit, b)
            *t match
                Class(k, _, _) ->
                    if c.classes[k].decl.object then c.note(unit, b.span, s"`${type_name(t)}` is an object, which has one value; a bound is a trait or a class")
                    else bounds.push(t)
                ErrorType -> ()
                _ -> c.note(unit, b.span, s"a bound is a trait or a class, not ${type_name(t)}")
        c.bounds.put(bound_key(owner, i, tp), bounds)

/** A type written as a bound, or as the trait of an impl: a trait that mentions `Self` may be named. */
private resolve_bound(c: *Checker, unit: usize, t: &TypeExpr) -> &Type
    val saved = c.bound_context
    c.bound_context = true
    val resolved = resolve_type(c, unit, t)
    c.bound_context = saved
    resolved

// The bounds of type parameter `index` of `owner`, where `params` are the parameters in scope. A
// class's or data type's own parameters are bounded where the type declares them, so they have those
// bounds wherever they are named, its methods and impls included. A trait's `Self` is bounded by the
// trait.
private bounds_at(c: *Checker, owner: usize, params: Buf[TypeParam], index: usize) -> Buf[&Type]
    if is_self_owner(owner)
        val k = owner - self_owner(0)
        var own: Buf[&Type] = buf()
        own.push(own_class_type(c.classes[k], k))
        return own
    if owner >= method_params_owner() then return buf()
    var declared = params
    if owner >= class_owner(0)
        val k = owner - class_owner(0)
        if k < c.classes.len() && index < c.classes[k].decl.type_params.len() then declared = c.classes[k].decl.type_params
    elif owner >= data_owner(0)
        val d = owner - data_owner(0)
        if d < c.data.len() && index < c.data[d].decl.type_params.len() then declared = c.data[d].decl.type_params
    if index >= declared.len() then return buf()
    c.bounds.get(bound_key(owner, index, declared[index])) match
        Some(bounds) -> bounds
        None -> buf()

/** The bounds of type parameter `t` as the code being checked names it. */
private bounds_of(c: *Checker, t: &Type) -> Buf[&Type]
    var params: Buf[TypeParam] = buf()
    *t match
        TypeVar(owner, index, _) ->
            if c.generic is Some(scope)
                if scope.owner == owner then params = scope.params
            bounds_at(c, owner, params, index)
        _ -> buf()

/** Whether a value of type `t` conforms to `bound`, a trait or a class: a type parameter does through
 * its own bounds. */
private conforms_to_bound(c: *Checker, t: &Type, bound: &Type) -> bool
    val x = zonk(c, t)
    val k = *bound match
        Class(k, _, _) -> k
        _ -> return true
    *x match
        ErrorType -> true
        Nothing -> true
        Var(_) -> true
        TypeVar(_, _, _) ->
            for b in bounds_of(c, x)
                if ancestor_type(c.classes, c.data, b, k) is Some(up)
                    if conforms(zonk(c, up), zonk(c, bound)) then return true
            false
        _ -> ancestor_type(c.classes, c.data, x, k) match
            Some(up) -> conforms(zonk(c, up), zonk(c, bound))
            None -> false

// Holds type arguments written on a type to the bounds of its parameters: at once when every
// conformance is known, and otherwise once it is.
private check_type_args(c: *Checker, unit: usize, at: Span, what: string, owner: usize, params: Buf[TypeParam], args: Buf[&Type])
    if !c.conformances_known
        c.pending.push(PendingBound(unit, at, what, owner, params, args, c.generic))
        return
    hold_to_bounds(c, unit, at, what, owner, params, args, 0)

// Reports each of `args`, from position `from` on, that does not conform to a bound of its
// parameter, the bound seen with these type arguments.
private hold_to_bounds(c: *Checker, unit: usize, at: Span, what: string, owner: usize, params: Buf[TypeParam], args: Buf[&Type], from: usize)
    for i in from..<params.len()
        if i >= args.len() then break
        for b in bounds_at(c, owner, params, i)
            val bound = substitute(b, owner, args)
            if !conforms_to_bound(c, args[i], bound)
                c.note(unit, at, s"`${type_name(zonk(c, args[i]))}` does not conform to `${type_name(bound)}`, the bound of `${params[i].name}` in $what")

/** Whether trait `k`'s methods, or those of a trait it requires, mention `Self` other than as the
 * receiver: such a trait is only a bound. */
private mentions_self(c: *Checker, k: usize, depth: usize) -> bool
    if depth > c.classes.len() then return false
    for m in c.classes[k].decl.members
        m match
            MethodMember(f, _, _) ->
                for p in f.params
                    if names_self(p.ty) then return true
                if f.result is Some(r)
                    if names_self(r) then return true
            AbstractFieldMember(f) -> if names_self(f.declared) then return true
            _ -> ()
    for parent in c.classes[k].decl.parents
        if parent_trait(c, c.classes[k].unit, parent) is Some(t)
            if mentions_self(c, t, depth + 1) then return true
    false

private names_self(t: &TypeExpr) -> bool
    t.kind match
        Named(path, args) ->
            if path == "Self" then return true
            for a in args
                if names_self(a) then return true
        Tuple(items) ->
            for item in items
                if names_self(item) then return true
        Function(params, result) ->
            for p in params
                if names_self(p.ty) then return true
            return names_self(result)
        InvalidType -> ()
    false

/** The Sysl function a binding names: the string of its `@sysl` annotation, when it has one. */
binding_target(f: &Function) -> Option[string]
    for a in f.annotations
        if a.name == "sysl" && a.args.len() == 1
            if a.args[0].value.kind is StringLit(path) then return Some(path)
    None

// A binding is a top-level function without a body whose `@sysl("module.path.name")` names a Sysl
// function. Its parameters and result are boundary types, which the generated shim converts; a
// binding with a wrong type is caught when Sysl checks the shim.
private check_binding(c: *Checker, unit: usize, f: &Function, params: Buf[&Type], result: Option[&Type], intrinsic: bool)
    for a in f.annotations
        if a.name != "sysl" then continue
        var path: Option[string] = None
        if a.args.len() == 1 && a.args[0].name is None
            if a.args[0].value.kind is StringLit(p) then path = Some(p)
        path match
            Some(p) ->
                if !is_sysl_path(p) then c.note(unit, a.span, s"`@sysl` names a Sysl function by its module and name, as in `sysl.text.to_upper`; `$p` is not one")
            None -> c.note(unit, a.span, "`@sysl` takes one string, the module and name of the Sysl function, as in `@sysl(\"sysl.text.to_upper\")`")
        if intrinsic then c.note(unit, a.span, "a function is an intrinsic or a Sysl binding, not both")
        if f.body is Some(_) || f.clauses.len() > 0 then c.note(unit, a.span, "a Sysl binding has no body: the Sysl function it names is its body")
        if f.type_params.len() > 0
            c.note(unit, f.name_span, "generic Sysl bindings are not implemented")
            continue
        for i in 0..<f.params.len()
            val p = f.params[i]
            if p.by_name then c.note(unit, p.pattern.span, "a by-name parameter cannot cross to Sysl")
            elif !crosses_to_sysl(params[i]) then c.note(unit, p.ty.span, s"`${type_name(params[i])}` cannot cross to Sysl; ${BoundaryTypes}")
        if result is Some(r)
            if !crosses_to_sysl(r)
                val at = if f.result is Some(t) then t.span else f.name_span
                c.note(unit, at, s"`${type_name(r)}` cannot cross to Sysl; ${BoundaryTypes}")

const BoundaryTypes: string = "a binding's parameters and result are integers of 8, 16, 32 or 64 bits, `byte`, `real`, `char`, `bool`, `unit` and `string`"

/** Whether a value of type `t` crosses between Avin and Sysl, converted by a binding's shim. */
crosses_to_sysl(t: &Type) -> bool = *t match
    ErrorType -> true
    Unit -> true
    Bool -> true
    Char -> true
    Real -> true
    Str -> true
    Byte -> true
    Int(bits) -> bits == 8 || bits == 16 || bits == 32 || bits == 64
    _ -> false

// A module path and a name: two or more identifiers joined by dots.
private is_sysl_path(p: string) -> bool
    var parts = 0
    var start = true
    for b in p.bytes
        if b == u8('.')
            if start then return false
            start = true
            continue
        val letter = b >= u8('a') && b <= u8('z') || b >= u8('A') && b <= u8('Z') || b == u8('_')
        val digit = b >= u8('0') && b <= u8('9')
        if !letter && !(digit && !start) then return false
        if start then parts += 1
        start = false
    !start && parts >= 2

private has_annotation(f: &Function, name: string) -> bool
    for a in f.annotations
        if a.name == name then return true
    false

resolve_type(c: *Checker, unit: usize, t: &TypeExpr) -> &Type = t.kind match
    InvalidType -> ErrorType
    Named(path, args) ->
        // The type arguments of a bound are types, so only the outermost name may be a trait that
        // mentions `Self`.
        val as_bound = c.bound_context
        c.bound_context = false
        if c.generic is Some(scope)
            for i in 0..<scope.params.len()
                if scope.params[i].name == path
                    if args.len() > 0 then c.note(unit, t.span, s"`$path` takes no type arguments")
                    return TypeVar(scope.owner, i, path)
        if path == "Self"
            if args.len() > 0 then c.note(unit, t.span, "`Self` takes no type arguments")
            if c.self_trait is Some(k) then return TypeVar(self_owner(k), 0, "Self")
            c.note(unit, t.span, "`Self` is the type implementing a trait, so it is written only in a trait's methods")
            return ErrorType
        val key = resolve_name(c, unit, path)
        if c.types.get(key) is Some(id)
            val d = c.data[id]
            var resolved: Buf[&Type] = buf()
            for a in args
                resolved.push(resolve_type(c, unit, a))
            if resolved.len() != d.decl.type_params.len()
                c.note(unit, t.span, s"`$path` takes ${count(d.decl.type_params.len(), "type argument")}, not ${resolved.len()}")
                return ErrorType
            check_type_args(c, unit, t.span, s"`$path`", data_owner(id), d.decl.type_params, resolved)
            return Data(id, d.name, resolved)
        if c.class_types.get(key) is Some(id)
            val k = c.classes[id]
            var resolved: Buf[&Type] = buf()
            for a in args
                resolved.push(resolve_type(c, unit, a))
            if resolved.len() != k.decl.type_params.len()
                c.note(unit, t.span, s"`$path` takes ${count(k.decl.type_params.len(), "type argument")}, not ${resolved.len()}")
                return ErrorType
            if !as_bound && is_trait(c, id) && mentions_self(c, id, 0)
                c.note(unit, t.span, s"`$path` mentions `Self`, so it is a bound, as in `[T: $path]`, and not a type")
                return ErrorType
            check_type_args(c, unit, t.span, s"`$path`", class_owner(id), k.decl.type_params, resolved)
            return Class(id, k.name, resolved)
        builtin_type(path) match
            Some(ty) ->
                if args.len() > 0
                    c.note(unit, t.span, s"`$path` takes no type arguments")
                    return ErrorType
                ty
            None ->
                c.variants.get(key) match
                    Some(v) -> c.note(unit, t.span, s"`$path` is a variant of `${c.data[v.data].name}`, not a type")
                    None -> c.note(unit, t.span, s"unknown type `$path`")
                ErrorType
    Tuple(items) ->
        var types: Buf[&Type] = buf()
        for item in items
            types.push(resolve_type(c, unit, item))
        Tuple(types)
    Function(params, result) ->
        var types: Buf[&Type] = buf()
        for p in params
            val ty = resolve_type(c, unit, p.ty)
            if p.by_name then types.push(ByName(ty)) else types.push(ty)
        Function(types, resolve_type(c, unit, result))

private check_function(c: *Checker, id: usize)
    if c.states[id] != 0 then return
    c.states.set(id, 1)
    val symbol = c.symbols[id]
    if symbol.decl.body is Some(_) || symbol.decl.clauses.len() > 0 || symbol.constructor
        val previous = c.current
        val outer = c.body
        c.current = id
        c.body = fresh_body(id)
        val outer_generic = c.generic
        c.generic = if symbol.type_params.len() > 0 then Some(GenericScope(symbol.type_owner, symbol.type_params)) else None
        val outer_trait = c.self_trait
        c.self_trait = None
        if symbol.owner_class is Some(k)
            if is_trait(c, k) then c.self_trait = Some(k)
        var subjects: Buf[&TExpr] = buf()
        for i in 0..<symbol.params.len()
            subjects.push(TExpr(symbol.decl.name_span, symbol.params[i], Param(i)))
        if symbol.constructor then check_constructor(c, id, None)
        else check_definition(c, id, subjects)
        c.generic = outer_generic
        c.self_trait = outer_trait
        finish_captures(c)
        c.locals.set(id, c.body.locals)
        for f in local_functions_of(c, id)
            c.locals.set(f, c.body.locals)
        c.current = previous
        c.body = outer
    c.states.set(id, 2)

// Checks class `k`'s body as far as its field `index`, in the middle of checking some other
// function: the body is its initializer's, with that function's state set aside meanwhile.
private check_class_body_upto(c: *Checker, k: usize, index: usize)
    val id = c.classes[k].initializer
    val symbol = c.symbols[id]
    val previous = c.current
    val outer = c.body
    val outer_generic = c.generic
    val outer_binds = c.binds_var
    val outer_super = c.super_args
    c.current = id
    c.body = fresh_body(id)
    c.generic = if symbol.type_params.len() > 0 then Some(GenericScope(symbol.type_owner, symbol.type_params)) else None
    c.binds_var = false
    c.super_args = false
    c.states.set(id, 1)
    check_constructor(c, id, Some(index))
    c.states.set(id, 0)
    c.current = previous
    c.body = outer
    c.generic = outer_generic
    c.binds_var = outer_binds
    c.super_args = outer_super

// Checks a function's body or clauses; `subjects` are its parameters' values, which its clauses
// match.
private check_definition(c: *Checker, id: usize, subjects: Buf[&TExpr])
    val decl = c.symbols[id].decl
    if decl.body is Some(body) then check_body(c, id, body)
    elif decl.clauses.len() > 0 then check_clauses(c, id, subjects)

// Each clause is checked like a match arm over all the parameters at once: its pattern names are
// scoped to the clause, its bodies must agree with the result, and the clauses that can always be
// taken once their patterns match must together cover every combination of arguments.
private check_clauses(c: *Checker, id: usize, subjects: Buf[&TExpr])
    val symbol = c.symbols[id]
    val decl = symbol.decl
    val unit = symbol.unit
    // A method's clauses match its arguments, not its receiver.
    val skip = if symbol.owner_class is Some(_) then 1usize else 0usize
    var params: Buf[&Type] = buf()
    var matched: Buf[&TExpr] = buf()
    for i in skip..<symbol.params.len()
        params.push(symbol.params[i])
        matched.push(subjects[i])
    var typed: Buf[TClause] = buf()
    var ty: &Type = Nothing
    var agreed = true
    for clause in decl.clauses
        if clause.patterns.len() != params.len()
            c.note(unit, clause.span, s"`${decl.name}` takes ${count(params.len(), "argument")}, but this clause matches ${clause.patterns.len()}")
            continue
        val mark = c.body.visible.len()
        val outer_start = c.body.block_start
        c.body.block_start = mark
        var patterns: Buf[&TPattern] = buf()
        for i in 0..<clause.patterns.len()
            val pattern = check_pattern(c, clause.patterns[i], params[i], "")
            // A type pattern naming the parameter's own type tests nothing: it is the signature's.
            if pattern.kind is PType(target, _, _)
                if same_type(target, params[i]) then c.note(unit, pattern.span, "a clause's arguments are patterns; their types are in the signature")
            patterns.push(pattern)
        var bodies: Buf[TGuarded] = buf()
        for b in clause.bodies
            var guard: Option[&TExpr] = None
            if b.guard is Some(g)
                val t = check_expr(c, g, Some(Bool))
                expect_bool(c, t)
                guard = Some(t)
            val body = check_expr(c, b.body, symbol.result)
            symbol.result match
                Some(declared) ->
                    if !fits(c,body.ty, declared) && !(*declared is Unit)
                        c.note(unit, b.body.span, s"${described(symbol)} yields ${type_name(body.ty)}, not ${type_name(declared)}")
                None ->
                    if agreed
                        join(c, ty, body.ty) match
                            Some(t) -> ty = t
                            None ->
                                c.note(unit, b.body.span, s"this clause yields ${type_name(body.ty)}, but the clauses before it yield ${type_name(ty)}")
                                agreed = false
            bodies.push(TGuarded(guard, body))
        c.body.visible.truncate(mark)
        c.body.block_start = outer_start
        typed.push(TClause(patterns, bodies))
    if symbol.result is None then c.symbols[id].result = Some(if agreed then ty else ErrorType)
    var settled_params = true
    for t in params
        if !settled(t) then settled_params = false
    if settled_params && typed.len() == decl.clauses.len() && !clauses_cover(typed, params, c.data)
        var blanks = ""
        for i in 0..<params.len()
            blanks = blanks + (if i == 0 then "_" else ", _")
        c.note(unit, decl.name_span, s"the clauses of `${decl.name}` do not cover every argument; add a clause for the rest, such as `${decl.name}($blanks)`")
    val result = c.symbols[id].result.unwrap_or(ErrorType)
    c.bodies.set(id, Some(TExpr(decl.span, result, Clauses(matched, typed))))

// Checks a function's body against its declared result, or infers the result from it.
private check_body(c: *Checker, id: usize, body: &Expr)
    val symbol = c.symbols[id]
    // The default of a by-name parameter is checked as an argument to it is: a delayed expression.
    if symbol.default_param is Some(_) && symbol.result is Some(r)
        if *r is ByName(inner)
            val expected: &Type = Function(buf(), inner)
            val delayed = lambda_expr(c, body, buf(), body, Some(expected), true)
            c.bodies.set(id, Some(TExpr(body.span, r, delayed.kind)))
            return
    val typed = check_expr(c, body, symbol.result)
    symbol.result match
        Some(declared) ->
            if !fits(c,typed.ty, declared) && !(*declared is Unit)
                c.note(symbol.unit, body.span, s"${described(symbol)} yields ${type_name(typed.ty)}, not ${type_name(declared)}")
        None -> c.symbols[id].result = Some(typed.ty)
    c.bodies.set(id, Some(typed))

// A constructor makes the object, runs the superclass's initializer on it, stores its parameters
// into their fields, then runs the class body top to bottom: each statement, and each field's
// initializer where the field is declared. It yields the object. `self` is a local holding the
// object, so code in the body that captures it captures it as it would any local. An open or
// abstract class does all but the allocation in its initializer, which is given the object, and its
// constructor allocates the object and calls the initializer.
//
// With `upto`, the class body is checked only until that field's type is known, and kept to be
// resumed: a function that reads an inferred field needs the code before the field, never the code
// after it, which may call that very function.
private check_constructor(c: *Checker, id: usize, upto: Option[usize])
    val symbol = c.symbols[id]
    val k = symbol.owner_class.unwrap()
    val cls = c.classes[k]
    if cls.initializer == id && c.building[k] == 2
        construct(c, k, upto)
        return
    val decl = cls.decl
    val self_type = own_class_type(cls, k)
    val self_local = c.body.locals.len()
    c.body.locals.push(TLocal("self", self_type, false, id))
    c.body.visible.push(self_local)
    val receiver = TExpr(decl.name_span, self_type, Local(self_local))
    var items: Buf[&TExpr] = buf()
    val made = TExpr(decl.name_span, self_type, New)
    if cls.initializer != id
        items.push(TExpr(decl.span, Unit, Let(self_local, made)))
        var args: Buf[&TExpr] = buf()
        args.push(receiver)
        for i in 0..<symbol.params.len()
            args.push(TExpr(decl.name_span, symbol.params[i], Param(i)))
        var type_args: Buf[&Type] = buf()
        if *self_type is Class(_, _, a) then type_args = a
        items.push(TExpr(decl.span, Unit, Call(cls.initializer, args, type_args)))
        items.push(receiver)
        c.bodies.set(id, Some(TExpr(decl.span, self_type, Block(items))))
        return
    // An initializer's object is its first parameter, and the class's parameters follow it.
    val first = if cls.constructor == id then 0usize else 1usize
    items.push(TExpr(decl.span, Unit, Let(self_local, if first == 0 then made else TExpr(decl.name_span, self_type, Param(0)))))
    c.classes[k].ready = 0
    var finishes = true
    if cls.superclass is Some(sup)
        val parent = decl.parents[0]
        val call = super_initialization(c, receiver, sup, parent)
        if *call.ty is Nothing then finishes = false
        items.push(call)
    val count_params = symbol.params.len() - first
    for i in 0..<count_params
        items.push(TExpr(decl.span, Unit, StoreField(receiver, cls.inherited + i, TExpr(decl.name_span, symbol.params[first + i], Param(first + i)), false)))
    c.classes[k].ready = cls.inherited + count_params
    c.constructions.set(k, Some(Construction(c.body, items, receiver, 0, cls.inherited + count_params, finishes)))
    construct(c, k, upto)

// Checks class `k`'s body from where it stopped: to its end, or with `upto` until that field's type
// is known, keeping the rest for later.
private construct(c: *Checker, k: usize, upto: Option[usize])
    var made = c.constructions[k].unwrap()
    c.constructions.set(k, None)
    c.body = made.body
    c.building.set(k, 1)
    val decl = c.classes[k].decl
    val unit = c.classes[k].unit
    while made.member < decl.members.len()
        if upto is Some(field) && made.index > field then break
        val m = decl.members[made.member]
        made.member += 1
        m match
            FieldMember(f) ->
                val index = made.index
                val declared = c.classes[k].fields[index].ty
                val typed = check_expr(c, f.value, declared)
                declared match
                    Some(want) ->
                        if !fits(c,typed.ty, want) then c.note(unit, f.value.span, s"expected ${type_name(want)}, found ${type_name(typed.ty)}")
                    None ->
                        val inferred = zonk(c, typed.ty)
                        if has_unknowns(inferred)
                            c.note(unit, f.span, s"cannot infer the type of the field `${f.name}`; declare it, as in `val ${f.name}: int = …`")
                            c.classes[k].fields[index].ty = Some(ErrorType)
                        else c.classes[k].fields[index].ty = Some(if *inferred is Nothing then ErrorType else inferred)
                if *typed.ty is Nothing then made.finishes = false
                made.items.push(TExpr(f.span, Unit, StoreField(made.receiver, index, typed, false)))
                made.index = index + 1
                c.classes[k].ready = made.index
            StatementMember(s) ->
                val t = check_statement(c, s)
                if *t.ty is Nothing then made.finishes = false
                made.items.push(t)
            AbstractFieldMember(_) -> ()
            MethodMember(_, _, _) -> ()
    if upto is Some(_)
        made.body = c.body
        c.constructions.set(k, Some(made))
        c.building.set(k, 2)
        return
    c.building.set(k, 3)
    val id = c.classes[k].initializer
    var items = made.items
    if c.classes[k].constructor == id
        items.push(made.receiver)
        c.bodies.set(id, Some(TExpr(decl.span, if made.finishes then made.receiver.ty else Nothing, Block(items))))
    else
        items.push(TExpr(decl.span, Unit, UnitConst))
        c.bodies.set(id, Some(TExpr(decl.span, if made.finishes then Unit else Nothing, Block(items))))

// The call of the superclass's initializer on the object, with the arguments written after the
// superclass's name. They are checked before the class stores its parameters, so a parameter's name
// reads the argument passed for it, and no field of the object is ready yet.
private super_initialization(c: *Checker, receiver: &TExpr, sup: &Type, parent: &Expr) -> &TExpr
    val sid = *sup match
        Class(s, _, _) -> s
        _ -> 0usize
    val sargs = *sup match
        Class(_, _, a) -> a
        _ -> buf()
    var args: Buf[Argument] = buf()
    var name_span = parent.span
    if parent.kind is Call(callee, a)
        args = a
        name_span = callee.span
    val s = c.classes[sid]
    val constructor = c.symbols[s.constructor]
    val signature = Signature(s.name, true, constructor.type_params, class_owner(sid), constructor.params, constructor.param_names, constructor.defaults, Unit, sargs, None)
    val outer = c.super_args
    c.super_args = true
    val applied = apply(c, parent.span, name_span, signature, args, None, None, buf())
    c.super_args = outer
    var call_args: Buf[&TExpr] = buf()
    call_args.push(receiver)
    for a in applied.args
        call_args.push(a)
    applied.wrap(parent.span, Call(s.initializer, call_args, applied.type_args))

private local_functions_of(c: *Checker, root: usize) -> Buf[usize]
    var out: Buf[usize] = buf()
    for i in 0..<c.symbols.len()
        if c.symbols[i].root == Some(root) then out.push(i)
    out

// Gives each local function of the top-level function just checked the locals and parameters it
// captures: those it uses itself, and those used by the local functions it calls that it does not
// own. Then checks each call made before its callee's declaration: everything the callee captures
// must already be initialized there.
private finish_captures(c: *Checker)
    for u in c.body.uses
        var captured = if u.param then c.symbols[u.function].captured_params else c.symbols[u.function].captured_locals
        if !contains_index(captured, u.index)
            captured.push(u.index)
            if u.param then c.symbols[u.function].captured_params = captured else c.symbols[u.function].captured_locals = captured
    var changed = true
    while changed
        changed = false
        for call in c.body.calls
            if call.caller == c.body.root then continue
            var locals = c.symbols[call.caller].captured_locals
            for x in c.symbols[call.callee].captured_locals
                if c.body.locals[x].owner != call.caller && !contains_index(locals, x)
                    locals.push(x)
                    changed = true
            c.symbols[call.caller].captured_locals = locals
            var params = c.symbols[call.caller].captured_params
            for x in c.symbols[call.callee].captured_params
                if !contains_index(params, x)
                    params.push(x)
                    changed = true
            c.symbols[call.caller].captured_params = params
    for call in c.body.early
        val callee = c.symbols[call.callee]
        for x in callee.captured_locals
            if !contains_index(call.initialized, x)
                c.note(callee.unit, call.span, s"`${callee.name}` uses `${c.body.locals[x].name}`, which is not initialized where `${callee.name}` is used here")
                break

private contains_index(items: Buf[usize], x: usize) -> bool
    for i in items
        if i == x then return true
    false

// Declares the local functions of a block before its items are checked, so they may call one
// another in any order.
private declare_local_functions(c: *Checker, items: Buf[&Expr])
    val start = c.body.functions.len()
    for item in items
        if item.kind is LocalFunction(decl)
            val enclosing = c.symbols[c.current]
            if decl.type_params.len() > 0
                c.note(unit_of(c), decl.name_span, "generic local functions are not implemented")
                continue
            var set: Buf[usize] = buf()
            for i in start..<c.body.functions.len()
                if c.symbols[c.body.functions[i]].name == decl.name then set.push(c.body.functions[i])
            val id = c.symbols.len()
            var symbol = signature(c, enclosing.unit, enclosing.module_name, decl, id, decl.type_params, false)
            symbol.root = Some(c.body.root)
            if same_as_overload(c, symbol, set)
                c.note(unit_of(c), decl.name_span, s"`${decl.name}` is declared more than once in this block with the same parameter types")
                continue
            c.symbols.push(symbol)
            c.states.push(0)
            c.bodies.push(None)
            c.locals.push(buf())
            c.body.functions.push(id)
            c.body.function_starts.push(start)
            declare_defaults(c, id)
            set.push(id)
            if set.len() > 1 then mark_overloads(c, set)

// The functions a name refers to: the local functions of that name in the innermost block that
// declares any, or else the top-level ones. A block's functions of a name hide every outer one of the
// same name, whatever their parameter types.
private lookup_functions(c: *Checker, name: string) -> Buf[usize]
    var found: Buf[usize] = buf()
    var i = c.body.functions.len()
    while i > 0
        i -= 1
        if c.symbols[c.body.functions[i]].name == name
            for k in c.body.function_starts[i]..<i + 1
                if c.symbols[c.body.functions[k]].name == name then found.push(c.body.functions[k])
            return found
    top_level_functions(c, unit_of(c), name)

// The top-level functions a bare name refers to in a file: those of the module it resolves to, and
// of another module only the public ones.
private top_level_functions(c: *Checker, unit: usize, name: string) -> Buf[usize]
    var found: Buf[usize] = buf()
    val key = resolve_name(c, unit, name)
    val ids = c.scope.get(key) match
        Some(ids) -> ids
        None -> return found
    if key == qualified(c.files[unit].module_name, name) then return ids
    for id in ids
        if c.symbols[id].public then found.push(id)
    found

/** The innermost function a name refers to, when it refers to any. */
private lookup_function(c: *Checker, name: string) -> Option[usize]
    val ids = lookup_functions(c, name)
    if ids.len() == 0 then None else Some(ids[0])

private local_function(c: *Checker, name: string) -> Option[usize]
    var i = c.body.functions.len()
    while i > 0
        i -= 1
        if c.symbols[c.body.functions[i]].name == name then return Some(c.body.functions[i])
    None

/** The class whose constructor or method the code being checked belongs to. */
private enclosing_class(c: *Checker) -> Option[usize] = c.symbols[c.body.root].owner_class

/** A member of the enclosing class named by its bare name: a field or a method. */
private enum MemberRef
    FieldOf(index: usize)
    /** A field of the one variant of the data type an impl's method works on. */
    DataFieldOf(index: usize)
    MethodOf(id: usize)
    /** A `val` of a trait the enclosing trait or class conforms to, which no field of its own
     * supplies here: it is read through the method table. */
    TraitFieldOf(id: usize)

// Inside a class, its fields and methods are in scope by bare name, behind the locals, parameters
// and local functions, and ahead of top-level declarations.
private class_member(c: *Checker, name: string) -> Option[MemberRef]
    val k = enclosing_class(c) match
        Some(k) -> k
        None -> return impl_member(c, name)
    if local_function(c, name) is Some(_) then return None
    // An ancestor's private member is not the subclass's to name.
    if class_field(c, k, name) is Some(i)
        if field_visible(c, c.classes[k].fields[i]) then return Some(FieldOf(i))
    if method_named(c, k, name) is Some(m)
        if method_visible(c, m) then return Some(MethodOf(m))
    if trait_field_named(c, k, name) is Some(m) then return Some(TraitFieldOf(m))
    None

/** The `val` named `name` of a trait that class or trait `k` conforms to or requires. */
private trait_field_named(c: *Checker, k: usize, name: string) -> Option[usize]
    val m = any_method_named(c, k, name)?
    if is_trait_field(c, m) then Some(m) else None

// A read of a trait's `val` `m` on `object`, which calls what the object's method table holds for it:
// for a class or a data type with the field, a method that yields the field.
private trait_field_read(c: *Checker, at: Span, object: &TExpr, m: usize, expected: Option[&Type]) -> &TExpr = method_call(c, at, at, object, m, buf(), None, expected, false, buf())

// Inside a method an impl adds to a data type or a built-in type, the type's methods are in scope by
// bare name, as in a class, and so are the fields of a data type with one variant: whatever
// `self.name` reaches.
private impl_member(c: *Checker, name: string) -> Option[MemberRef]
    val t = c.symbols[c.body.root].receiver?
    if local_function(c, name) is Some(_) then return None
    if *t is Data(id, _, _)
        val d = c.data[id]
        if d.variants.len() == 1
            val names = d.variants[0].field_names
            for i in 0..<names.len()
                if names[i] == name then return Some(DataFieldOf(i))
    if receiver_method(c, t, name) is Some(m)
        if method_visible(c, m) then return Some(MethodOf(m))
    None

/** The methods of `name` a bare name reaches inside a class or an impl's method, one for each list of
 * parameter types, which a call of the name chooses among. */
private bare_methods(c: *Checker, name: string) -> Buf[usize]
    if enclosing_class(c) is Some(k) then return methods_named(c, k, name)
    c.symbols[c.body.root].receiver match
        Some(t) -> visible_methods(c, receiver_methods(c, t, name))
        None -> buf()

/** `self`, the instance the enclosing constructor or method works on. */
private self_ref(c: *Checker, at: Span) -> &TExpr = binding_ref(c, at, "self").unwrap()

// A local function is checked where it is declared, seeing the locals declared before it. Its
// parameters become locals of its own, and loops outside it are not its loops.
private check_local_function(c: *Checker, decl: &Function) -> usize
    // The block's own local functions were declared last, so the innermost one declared here is it;
    // a duplicate was never declared and is not checked.
    var id = 0usize
    var found = false
    var i = c.body.functions.len()
    while i > 0 && !found
        i -= 1
        val span = c.symbols[c.body.functions[i]].decl.name_span
        if span.start == decl.name_span.start && span.end == decl.name_span.end
            id = c.body.functions[i]
            found = true
    if !found || c.states[id] != 0 then return id
    check_local_symbol(c, id)
    // Its defaults are checked where it is declared too, seeing what it sees.
    for d in c.symbols[id].defaults
        if d is Some(default) then check_local_symbol(c, default)
    id

private check_local_symbol(c: *Checker, id: usize)
    c.states.set(id, 1)
    val symbol = c.symbols[id]
    val decl = symbol.decl
    val previous = c.current
    val loops = c.body.loops
    val outer_start = c.body.block_start
    val mark = c.body.visible.len()
    c.current = id
    c.body.loops = buf()
    c.body.block_start = mark
    var param_locals: Buf[usize] = buf()
    for i in 0..<symbol.params.len()
        param_locals.push(declare_local(c, decl.span, symbol.param_names[i], symbol.params[i], false))
    c.symbols[id].param_locals = param_locals
    var subjects: Buf[&TExpr] = buf()
    for i in 0..<param_locals.len()
        subjects.push(TExpr(decl.name_span, symbol.params[i], Local(param_locals[i])))
    check_definition(c, id, subjects)
    c.body.visible.truncate(mark)
    c.body.block_start = outer_start
    c.body.loops = loops
    c.current = previous
    c.states.set(id, 2)

private unit_of(c: *Checker) -> usize = c.symbols[c.current].unit

/** A function as diagnostics name it. */
private described(symbol: FunctionSymbol) -> string
    if symbol.delayed then return "this delayed argument"
    if symbol.lambda then return "this lambda"
    if symbol.default_param is Some(p) then return s"the default of `$p`"
    s"`${symbol.name}`"

/** Checks an expression whose value is used. */
check_expr(c: *Checker, e: &Expr, expected: Option[&Type]) -> &TExpr = check_value(c, e, expected, true)

/** Checks an expression whose value is discarded, so the branches of an `if` need not agree. */
private check_statement(c: *Checker, e: &Expr) -> &TExpr = check_value(c, e, None, false)

// A value expected as `Any` converts to it where it is written. Only the forms that yield one of
// their parts (a block, `if`, `match`, a loop) pass `Any` on to those parts, so each converts its
// own; for any other the expected `Any` says nothing about how to check it.
private check_value(c: *Checker, e: &Expr, expected: Option[&Type], used: bool) -> &TExpr
    val want = expected match
        Some(w) -> w
        None -> return check_form(c, e, None, used)
    if !(*zonk(c, want) is AnyType) then return check_form(c, e, expected, used)
    val passes = e.kind is Block(_, _) || e.kind is If(_, _, _) || e.kind is Match(_, _) || e.kind is While(_, _, _) || e.kind is Loop(_) || e.kind is DoWhile(_, _, _)
    to_any(c, check_form(c, e, if passes then expected else None, used))

/** `typed` as an `Any`: put in a box where its type needs one. An unknown type is decided as
 * `Any`. */
private to_any(c: *Checker, typed: &TExpr) -> &TExpr
    val t = zonk(c, typed.ty)
    if *t is Var(_)
        unify(c, t, AnyType)
        return typed
    if *t is AnyType || *t is Nothing || *t is ErrorType || *t is ByName(_) then return typed
    TExpr(typed.span, AnyType, Box(typed))

private check_form(c: *Checker, e: &Expr, expected: Option[&Type], used: bool) -> &TExpr = e.kind match
    IntLit(spelling) -> integer_literal(c, e.span, spelling, false, expected)
    Unary(op, operand) -> unary_expr(c, e, op, operand, expected)
    BoolLit(value) -> TExpr(e.span, Bool, BoolConst(value))
    CharLit(value) -> TExpr(e.span, Char, CharConst(u32(value)))
    RealLit(value) -> TExpr(e.span, Real, RealConst(value))
    StringLit(value) -> TExpr(e.span, Str, StrConst(value))
    Interpolate(prefix, chunks, holes) -> interpolate_expr(c, e, prefix, chunks, holes)
    UnitLit -> TExpr(e.span, Unit, UnitConst)
    Name(name) -> name_expr(c, e.span, name, expected)
    TypeApply(target, types) -> type_apply(c, e, target, types, expected)
    Member(target, name) -> member_expr(c, e, target, name, expected)
    Call(callee, args) -> call_expr(c, e.span, callee, args, expected)
    InfixCall(target, name, name_span, arg) -> infix_call(c, e.span, target, name, name_span, arg, expected)
    Block(items, discard) -> block_expr(c, e, items, discard, expected, used)
    Binding(name, declared, value, mutable) -> binding_expr(c, e, name, declared, value, mutable)
    Destructure(pattern, declared, value, mutable) -> destructure_expr(c, e, pattern, declared, value, mutable)
    Assign(target, op, value, yields, op_span) -> assign_expr(c, e, target, op, value, yields, op_span)
    MultiAssign(targets, op, value, op_span) -> multi_assign_expr(c, e, targets, op, value, op_span)
    Tuple(items) -> tuple_expr(c, e, items, expected)
    TupleIndex(target, index) -> tuple_index(c, e, target, index)
    Update(target, increment, postfix, op_span) -> update_expr(c, e, target, increment, postfix, op_span)
    Binary(op, left, right, op_span) -> binary_expr(c, e, op, left, right, op_span, expected)
    Compare(operands, ops) -> compare_expr(c, e, operands, ops)
    If(condition, yes, no) -> if_expr(c, e, condition, yes, no, expected, used)
    While(condition, body, otherwise) -> while_expr(c, e, condition, body, otherwise, expected, used)
    Loop(body) -> loop_expr(c, e, body)

    DoWhile(body, condition, otherwise) -> check_form(c, do_while_form(e, body, condition, otherwise), expected, used)
    Break(value) -> break_expr(c, e, value)
    Continue -> continue_expr(c, e)
    Return(value) -> return_expr(c, e, value)
    Match(subject, arms) -> match_expr(c, e, subject, arms, expected, used)
    Is(value, pattern, negated) -> is_expr(c, e, value, pattern, negated)
    Lambda(params, body) -> lambda_expr(c, e, params, body, expected, false)
    LocalFunction(decl) ->
        check_local_function(c, decl)
        TExpr(e.span, Unit, UnitConst)
    Invalid -> TExpr(e.span, ErrorType, UnitConst)
    _ -> unsupported(c, e, "this expression")

private unsupported(c: *Checker, e: &Expr, what: string) -> &TExpr
    c.note(unit_of(c), e.span, s"$what is not implemented")
    TExpr(e.span, ErrorType, UnitConst)

private lookup_local(c: *Checker, name: string) -> Option[usize]
    var i = c.body.visible.len()
    while i > 0
        i -= 1
        val index = c.body.visible[i]
        if c.body.locals[index].name == name then return Some(index)
    None

// Parameters of the top-level function; a local function's own parameters are locals. A
// constructor's parameters are only stored into their fields, so a class's parameter is named
// through its field, which a `var` field's assignments change.
private param_index(c: *Checker, name: string) -> Option[usize]
    val symbol = c.symbols[c.body.root]
    if symbol.constructor
        // A superclass's arguments read the parameters themselves; an initializer's object is not
        // one of them.
        if !c.super_args then return None
        val first = if c.classes[symbol.owner_class.unwrap()].constructor == c.body.root then 0usize else 1usize
        for i in first..<symbol.param_names.len()
            if symbol.param_names[i] == name then return Some(i)
        return None
    for i in 0..<symbol.param_names.len()
        if symbol.param_names[i] == name then return Some(i)
    None

private name_expr(c: *Checker, at: Span, name: string, expected: Option[&Type]) -> &TExpr
    if c.super_args && name == "self"
        c.note(unit_of(c), at, "`self` cannot be used in a superclass's arguments, which run before the object is initialized")
        return TExpr(at, ErrorType, UnitConst)
    if binding_ref(c, at, name) is Some(t) then return evaluated(t)
    val symbol = c.symbols[c.current]
    if name == "super" && enclosing_class(c) is Some(_)
        c.note(symbol.unit, at, "`super` calls a superclass's method, as in `super.describe()`")
        return TExpr(at, ErrorType, UnitConst)
    class_member(c, name) match
        Some(FieldOf(i)) -> return field_read(c, at, at, self_ref(c, at), enclosing_class(c).unwrap(), i, true)
        Some(DataFieldOf(i)) -> return data_field_read(c, at, self_ref(c, at), i)
        Some(MethodOf(m)) ->
            var ms = bare_methods(c, name)
            if ms.len() == 0 then ms.push(m)
            return overloaded_method_value(c, at, self_ref(c, at), name, ms, None, expected)
        Some(TraitFieldOf(m)) -> return trait_field_read(c, at, self_ref(c, at), m, expected)
        None -> ()
    if global_named(c, name) is Some(g) then return global_read(c, at, g)
    if lookup_function(c, name) is Some(id)
        if abstract_constructor(c, id, at) then return TExpr(at, ErrorType, UnitConst)
        return named_function_value(c, at, name, None, expected)
    if variant_named(c, name) is Some(v)
        if c.data[v.data].variants[v.index].fields.len() == 0 then return construct(c, at, at, v, buf(), None, expected)
        c.note(symbol.unit, at, s"`$name` has fields; call it, as in `$name(…)`")
    else c.note(symbol.unit, at, s"`$name` is not defined")
    TExpr(at, ErrorType, UnitConst)

// Reads field `index` of an object of class `k`. Through `self` in the constructor's own code, a
// field must already be initialized: a parameter, or a body field declared above the read.
private field_read(c: *Checker, at: Span, name_span: Span, object: &TExpr, k: usize, index: usize, own: bool) -> &TExpr
    val field = c.classes[k].fields[index]
    if own && c.current == c.classes[k].initializer && index >= c.classes[k].ready
        if c.super_args then c.note(unit_of(c), name_span, s"`${field.name}` is read in a superclass's arguments, which run before the object is initialized")
        else c.note(unit_of(c), name_span, s"`${field.name}` is read before its declaration in the class body initializes it")
        return TExpr(at, ErrorType, UnitConst)
    val ty = field_type(c, k, index, name_span)
    val args = *zonk(c, object.ty) match
        Class(_, _, a) -> a
        _ -> buf()
    TExpr(at, substitute(ty, class_owner(k), args), Field(object, index))

/** Field `index` of the one variant of `object`'s data type. */
private data_field_read(c: *Checker, at: Span, object: &TExpr, index: usize) -> &TExpr = *zonk(c, object.ty) match
    Data(id, _, args) -> TExpr(at, variant_fields(c.data[id], id, 0, args)[index], Field(object, index))
    _ -> TExpr(at, ErrorType, UnitConst)

// A field declared without a type has its initializer's, so the class body is checked first, as far
// as the field. An inherited field's type is its declaring class's.
private field_type(c: *Checker, k: usize, index: usize, at: Span) -> &Type
    if index < c.classes[k].inherited
        if c.classes[k].superclass is Some(sup)
            if *sup is Class(sid, _, args) then return substitute(field_type(c, sid, index, at), class_owner(sid), args)
    if c.classes[k].fields[index].ty is Some(t) then return t
    if c.building[k] != 1 && c.states[c.classes[k].initializer] == 0
        check_class_body_upto(c, k, index)
        return c.classes[k].fields[index].ty.unwrap_or(ErrorType)
    val name = c.classes[k].fields[index].name
    c.note(unit_of(c), at, s"the type of the field `$name` is needed before its initializer is checked; declare it, as in `val $name: int = …`")
    ErrorType

// The method `name` that a value of type `t` has: its class's, or one an impl adds to its data or
// built-in type.
private method_of(c: *Checker, t: &Type, name: string) -> Option[usize]
    val known = zonk(c, t)
    if *known is Class(k, _, _) then return method_named(c, k, name)
    receiver_method(c, known, name)

// A method of `name` named without a call, chosen among `ms`, the overloads the receiver's type has
// that the code being checked may call. An overloaded name takes its overload from the expected
// function type, as a function's does: of the overloads whose parameters accept that type's, the
// most specific.
private overloaded_method_value(c: *Checker, at: Span, receiver: &TExpr, name: string, ms: Buf[usize], explicit: Option[Buf[&TypeExpr]], expected: Option[&Type]) -> &TExpr
    if ms.len() == 1 || *receiver.ty is Nothing then return method_value(c, at, receiver, ms[0], explicit, expected)
    val unit = unit_of(c)
    var wanted: Option[Buf[&Type]] = None
    if expected is Some(t)
        if *zonk(c, t) is Function(ps, _) then wanted = Some(ps)
    val params = wanted match
        Some(ps) -> ps
        None ->
            c.note(unit, at, s"`$name` is overloaded, so as a value with no expected function type it is ambiguous: ${overload_list(c, ms)} could each be meant")
            return TExpr(at, ErrorType, UnitConst)
    var fitting: Buf[usize] = buf()
    var compared: Buf[Buf[&Type]] = buf()
    for m in ms
        val s = method_signature(c, receiver, m, ErrorType)
        val view = substitute_all(s.params, s.owner, s.known)
        if accepts(c, view, s.owner, s.type_params.len(), params)
            fitting.push(m)
            compared.push(view)
    if fitting.len() == 0
        c.note(unit, at, s"no overload of `$name` has the parameter types of ${type_name(zonk(c, expected.unwrap()))}; the overloads are ${overload_list(c, ms)}")
        return TExpr(at, ErrorType, UnitConst)
    most_specific(c, fitting, compared) match
        Some(m) -> method_value(c, at, receiver, m, explicit, expected)
        None ->
            c.note(unit, at, s"`$name` used as ${type_name(zonk(c, expected.unwrap()))} is ambiguous: ${overload_list(c, fitting)} each accept it")
            TExpr(at, ErrorType, UnitConst)

/** The methods of `name` a value of type `t` has that the code being checked may call, one for each
 * list of parameter types. */
private methods_of(c: *Checker, t: &Type, name: string) -> Buf[usize]
    val known = zonk(c, t)
    if *known is Class(k, _, _) then return methods_named(c, k, name)
    if *known is TypeVar(_, _, _) then return bound_methods(c, known, name)
    visible_methods(c, receiver_methods(c, known, name))

/** The methods of `name` a value of type parameter `t` has: those of its bounds, each once. */
private bound_methods(c: *Checker, t: &Type, name: string) -> Buf[usize]
    var out: Buf[usize] = buf()
    for b in bounds_of(c, t)
        if *b is Class(k, _, _)
            for m in methods_named(c, k, name)
                if !contains_id(out, m) then out.push(m)
    out

// The bounds of type parameter `t`, as a diagnostic names them.
private bound_names(c: *Checker, t: &Type) -> string
    var text = ""
    for b in bounds_of(c, t)
        if text != "" then text = text + " + "
        text = text + type_name(b)
    text

// `object.name` for a method `m` of the object's type, named without a call: outside the class, or
// the impls, that declare it, a private method cannot be.
private member_method_value(c: *Checker, at: Span, object: &TExpr, m: usize, explicit: Option[Buf[&TypeExpr]], expected: Option[&Type]) -> &TExpr
    if !method_visible(c, m)
        val name = c.symbols[m].decl.name
        c.symbols[m].owner_class match
            Some(k) -> c.note(unit_of(c), at, s"`$name` is private to `${c.classes[k].name}`")
            None -> c.note(unit_of(c), at, s"`$name` is private to the impls of `${type_name(c.symbols[m].receiver.unwrap())}`")
        return TExpr(at, ErrorType, UnitConst)
    method_value(c, at, object, m, explicit, expected)

// A method named without a call is a function value bound to its receiver: a closure, of the
// method's type without the receiver, that holds the receiver and calls the method on it with its
// arguments. The receiver is evaluated once, where the value is made. Through a trait or an open
// class the closure calls through the object's method table, as a call there would; the object is
// fixed, so that is the implementation its class had when the value was made. The class's type
// arguments come from the receiver's type, and the method's own are written or decided by the
// expected function type.
private method_value(c: *Checker, at: Span, receiver: &TExpr, m: usize, explicit: Option[Buf[&TypeExpr]], expected: Option[&Type]) -> &TExpr
    val unit = unit_of(c)
    if *receiver.ty is Nothing then return receiver
    val target = c.symbols[m]
    val name = target.decl.name
    val known = receiver_type_args(c, receiver.ty, m)
    val result = result_of(c, m, at)
    val type_params = target.type_params
    val first = c.vars.len()
    var type_args: Buf[&Type] = buf()
    for i in 0..<type_params.len()
        type_args.push(if i < known.len() then known[i] else fresh_var(c))
    var failed = false
    if explicit is Some(types)
        val own = type_params.len() - known.len()
        if types.len() > own
            c.note(unit, at, s"`$name` takes ${count(own, "type argument")}, not ${types.len()}")
            failed = true
        else
            for i in 0..<types.len()
                unify(c, type_args[known.len() + i], resolve_type(c, unit, types[i]))
    var params: Buf[&Type] = buf()
    var names: Buf[string] = buf()
    for i in 1..<target.params.len()
        params.push(with_self(c, m, receiver.ty, target.params[i]))
        names.push(target.param_names[i])
    val declared: &Type = Function(substitute_all(params, target.type_owner, type_args), substitute(with_self(c, m, receiver.ty, result), target.type_owner, type_args))
    if expected is Some(want) then unify(c, declared, want)
    var solved: Buf[&Type] = buf()
    for i in 0..<type_args.len()
        val t = zonk(c, type_args[i])
        if *t is Var(v)
            if v >= first
                if !failed then c.note(unit, at, s"cannot infer `${type_params[i].name}` for `$name` used as a value; write it, as in `$name[int]`")
                c.vars.set(v, Some(ErrorType))
                failed = true
        solved.push(zonk(c, t))
    if failed then return TExpr(at, ErrorType, UnitConst)
    val ty = zonk(c, declared)
    var lambda_params: Buf[&Type] = buf()
    var lambda_result: &Type = ErrorType
    if *ty is Function(ps, r)
        lambda_params = ps
        lambda_result = r
    // The receiver is held in a local of the code making the value, which the closure captures.
    val held = hidden_local(c, receiver.ty)
    val enclosing = c.symbols[c.current]
    val decl = Function(buf(), at, at, "lambda", buf(), buf(), None, None, buf())
    val id = c.symbols.len()
    c.symbols.push(FunctionSymbol(enclosing.unit, enclosing.module_name, "lambda", decl, lambda_params, names, Some(lambda_result), None, Some(c.body.root), buf(), buf(), buf(), true, false, true, buf(), None, id, buf(), None, false, true, "", None))
    c.states.push(2)
    c.bodies.push(None)
    c.locals.push(buf())
    var args: Buf[&TExpr] = buf()
    args.push(TExpr(at, receiver.ty, Local(held)))
    var param_locals: Buf[usize] = buf()
    for i in 0..<lambda_params.len()
        val index = c.body.locals.len()
        c.body.locals.push(TLocal(names[i], lambda_params[i], false, id))
        param_locals.push(index)
        args.push(TExpr(at, lambda_params[i], Local(index)))
    c.symbols[id].param_locals = param_locals
    c.body.uses.push(CaptureUse(id, held, false))
    c.body.calls.push(LocalCall(c.current, id))
    val call = method_call_kind(c, receiver.ty, m, args, solved, false)
    c.bodies.set(id, Some(TExpr(at, lambda_result, call)))
    var items: Buf[&TExpr] = buf()
    items.push(TExpr(receiver.span, Unit, Let(held, receiver)))
    items.push(TExpr(at, ty, FunctionValue(id, buf())))
    TExpr(at, ty, Block(items))

// Whether code that may use the private members of class `k` is being checked: code of the class
// itself, or of its companion.
private inside_class(c: *Checker, k: usize) -> bool
    val here = enclosing_class(c) match
        Some(h) -> h
        None -> return false
    here == k || c.classes[k].companion == Some(here)

// An abstract class has a constructor its subclasses' constructors run, but cannot be called to make
// an object of its own; reports whether `id` is one.
private abstract_constructor(c: *Checker, id: usize, at: Span) -> bool
    val symbol = c.symbols[id]
    if !symbol.constructor then return false
    val k = symbol.owner_class.unwrap()
    if !is_abstract_class(c, k) then return false
    if is_trait(c, k) then c.note(unit_of(c), at, s"`${c.classes[k].name}` is a trait, so it cannot be instantiated; instantiate a class that conforms to it")
    else c.note(unit_of(c), at, s"`${c.classes[k].name}` is abstract, so it cannot be instantiated; instantiate a subclass")
    true

// A local or a parameter by name, as it is stored: a by-name parameter is its delayed expression,
// not yet evaluated.
private binding_ref(c: *Checker, at: Span, name: string) -> Option[&TExpr]
    if lookup_local(c, name) is Some(index)
        if c.body.locals[index].owner != c.current then c.body.uses.push(CaptureUse(c.current, index, false))
        return Some(TExpr(at, c.body.locals[index].ty, Local(index)))
    if param_index(c, name) is Some(i)
        if c.current != c.body.root then c.body.uses.push(CaptureUse(c.current, i, true))
        return Some(TExpr(at, c.symbols[c.body.root].params[i], Param(i)))
    None

// A read of a by-name parameter evaluates its delayed expression, a closure with no parameters,
// every time.
private evaluated(t: &TExpr) -> &TExpr = *t.ty match
    ByName(inner) -> TExpr(t.span, inner, CallValue(t, buf()))
    _ -> t

// Type arguments written on a name that is not called: a function or a method used as a value, or a
// variant with no fields, as in `None[int]`.
private type_apply(c: *Checker, e: &Expr, target: &Expr, types: Buf[&TypeExpr], expected: Option[&Type]) -> &TExpr
    if target.kind is Name(name)
        // A method of the enclosing class by bare name, bound to `self`, as in `convert[int]`.
        if lookup_local(c, name) is None && param_index(c, name) is None
            if class_member(c, name) is Some(MethodOf(m)) then return method_value(c, e.span, self_ref(c, target.span), m, Some(types), expected)
        if lookup_function(c, name) is Some(id)
            if abstract_constructor(c, id, target.span) then return TExpr(e.span, ErrorType, UnitConst)
            return named_function_value(c, e.span, name, Some(types), expected)
        if lookup_local(c, name) is None && param_index(c, name) is None
            if variant_named(c, name) is Some(v)
                if c.data[v.data].variants[v.index].fields.len() == 0
                    return construct(c, e.span, target.span, v, buf(), Some(types), expected)
    // A method named without a call, with its own type arguments, as in `box.convert[int]`.
    if target.kind is Member(inner, name)
        val object = check_expr(c, inner, None)
        val ms = methods_of(c, object.ty, name)
        if ms.len() > 1 then return overloaded_method_value(c, e.span, object, name, ms, Some(types), expected)
        if method_of(c, object.ty, name) is Some(m) then return member_method_value(c, e.span, object, m, Some(types), expected)
    unsupported(c, e, "a value with type arguments that is not called")

// A field is read by name from a value of a data type with one variant; a type with several is
// taken apart by `match`, since which fields a value has depends on its variant.
// A method named without a call is a function value bound to the value; see `method_value`.
private member_expr(c: *Checker, e: &Expr, target: &Expr, name: string, expected: Option[&Type]) -> &TExpr = member_of(c, e, check_expr(c, target, None), name, expected)

private member_of(c: *Checker, e: &Expr, value: &TExpr, name: string, expected: Option[&Type]) -> &TExpr
    val unit = unit_of(c)
    val ty = zonk(c, value.ty)
    // A field of a data type with one variant comes before a method of the same name.
    if !(*ty is Class(_, _, _)) && !one_variant_field(c, ty, name)
        val ms = methods_of(c, ty, name)
        if ms.len() > 1 then return overloaded_method_value(c, e.span, value, name, ms, None, expected)
        if receiver_method(c, ty, name) is Some(m) then return member_method_value(c, e.span, value, m, None, expected)
    *ty match
        Data(id, _, args) ->
            val d = c.data[id]
            if d.variants.len() > 1
                c.note(unit, e.span, s"`${type_name(ty)}` has several variants, so its fields are reached by `match`")
                return TExpr(e.span, ErrorType, UnitConst)
            if d.variants.len() == 1
                val names = d.variants[0].field_names
                for i in 0..<names.len()
                    if names[i] == name then return TExpr(e.span, variant_fields(d, id, 0, args)[i], Field(value, i))
            c.note(unit, e.span, s"`${type_name(ty)}` has no field `$name`")
        Class(k, _, _) -> return class_member_value(c, e.span, value, k, name, expected)
        TypeVar(_, _, _) -> return bound_member_value(c, e.span, value, ty, name, expected)
        ErrorType -> ()
        Nothing -> return value
        _ -> c.note(unit, e.span, s"${type_name(ty)} has no field `$name`")
    TExpr(e.span, ErrorType, UnitConst)

// `value.name` on a value of type parameter `ty`: a `val` of a trait bounding it, or a method of its
// bounds named without a call.
private bound_member_value(c: *Checker, at: Span, value: &TExpr, ty: &Type, name: string, expected: Option[&Type]) -> &TExpr
    if bound_field(c, ty, name) is Some(m) then return trait_field_read(c, at, value, m, expected)
    // A field of a class bounding it is read as from an instance of that class.
    if bound_class_field(c, ty, name) is Some(b)
        if *b is Class(k, _, _) then return class_member_value(c, at, TExpr(value.span, b, value.kind), k, name, expected)
    val ms = bound_methods(c, ty, name)
    if ms.len() > 0 then return member_method_value(c, at, value, ms[0], None, expected)
    no_bound_member(c, at, ty, name)
    TExpr(at, ErrorType, UnitConst)

/** The `val` named `name` of a trait bounding type parameter `ty`, read with field syntax. */
private bound_field(c: *Checker, ty: &Type, name: string) -> Option[usize]
    for b in bounds_of(c, ty)
        if *b is Class(k, _, _)
            if trait_field_named(c, k, name) is Some(m) then return Some(m)
    None

/** The class bounding type parameter `ty` that has a field named `name`. */
private bound_class_field(c: *Checker, ty: &Type, name: string) -> Option[&Type]
    for b in bounds_of(c, ty)
        if *b is Class(k, _, _)
            if !is_trait(c, k) && class_field(c, k, name) is Some(_) then return Some(b)
    None

// Reports that type parameter `ty` has no member `name`: only its bounds give it any.
private no_bound_member(c: *Checker, at: Span, ty: &Type, name: string)
    val t = type_name(ty)
    if bounds_of(c, ty).len() == 0 then c.note(unit_of(c), at, s"`$t` has no bound, so it has no member `$name`; a bound, as in `[$t: Trait]`, gives it the methods of the trait")
    else c.note(unit_of(c), at, s"`$name` is not a member of `${bound_names(c, ty)}`, the bound of `$t`")

// `object.name` on an object of class `k`: a field, which outside the class must be public.
private class_member_value(c: *Checker, at: Span, object: &TExpr, k: usize, name: string, expected: Option[&Type]) -> &TExpr
    val cls = c.classes[k]
    if class_field(c, k, name) is Some(i)
        if !field_visible(c, cls.fields[i])
            c.note(unit_of(c), at, s"`$name` is private to `${c.classes[cls.fields[i].owner].name}`")
            return TExpr(at, ErrorType, UnitConst)
        return field_read(c, at, at, object, k, i, is_self(c, object))
    if trait_field_named(c, k, name) is Some(m) then return trait_field_read(c, at, object, m, expected)
    val ms = methods_named(c, k, name)
    if ms.len() > 1 then return overloaded_method_value(c, at, object, name, ms, None, expected)
    if method_named(c, k, name) is Some(m) then return member_method_value(c, at, object, m, None, expected)
    c.note(unit_of(c), at, s"`${cls.name}` has no member `$name`")
    TExpr(at, ErrorType, UnitConst)

/** Whether `t` is a data type with one variant that has a field `name`. */
private one_variant_field(c: *Checker, t: &Type, name: string) -> bool
    if *t is Data(id, _, _)
        val d = c.data[id]
        if d.variants.len() == 1
            for n in d.variants[0].field_names
                if n == name then return true
    false

/** Whether an expression is `self` in a constructor, the object it is still initializing. */
private is_self(c: *Checker, t: &TExpr) -> bool = t.kind match
    Local(i) -> c.body.locals[i].name == "self"
    _ -> false

// A block's locals go out of scope at its end. A block that contains an expression which never
// finishes (a `return`, a `break`) never yields, so its type is `Nothing`.
private block_expr(c: *Checker, e: &Expr, items: Buf[&Expr], discard: bool, expected: Option[&Type], used: bool) -> &TExpr
    val mark = c.body.visible.len()
    val function_mark = c.body.functions.len()
    val outer_start = c.body.block_start
    c.body.block_start = mark
    declare_local_functions(c, items)
    var typed: Buf[&TExpr] = buf()
    var finishes = true
    for i in 0..<items.len()
        val item = items[i]
        val t = if i + 1 == items.len() && !discard then check_value(c, item, expected, used) else check_statement(c, item)
        if *t.ty is Nothing then finishes = false
        typed.push(t)
    c.body.visible.truncate(mark)
    c.body.functions.truncate(function_mark)
    c.body.function_starts.truncate(function_mark)
    c.body.block_start = outer_start
    var ty: &Type = Unit
    if !finishes then ty = Nothing
    elif !discard && typed.len() > 0 then ty = typed[typed.len() - 1].ty
    TExpr(e.span, ty, Block(typed))

// Checks a branch of `if` or `while`, whose bindings are not visible after it.
private branch(c: *Checker, e: &Expr, expected: Option[&Type], used: bool) -> &TExpr
    val mark = c.body.visible.len()
    val t = check_value(c, e, expected, used)
    c.body.visible.truncate(mark)
    t

private binding_expr(c: *Checker, e: &Expr, name: string, declared: Option[&TypeExpr], value: &Expr, mutable: bool) -> &TExpr
    val unit = unit_of(c)
    var want: Option[&Type] = None
    if declared is Some(d) then want = Some(resolve_type(c, unit, d))
    val typed = check_expr(c, value, want)
    var ty = typed.ty
    if want is Some(w)
        if !fits(c,typed.ty, w) then c.note(unit, value.span, s"expected ${type_name(w)}, found ${type_name(typed.ty)}")
        ty = w
    val index = declare_local(c, e.span, name, ty, mutable)
    // A binding whose value never finishes does not finish either.
    TExpr(e.span, if *typed.ty is Nothing then Nothing else Unit, Let(index, typed))

/** Brings a new local into scope; a name may be declared once per block. */
private declare_local(c: *Checker, at: Span, name: string, ty: &Type, mutable: bool) -> usize
    if name == "self" then c.note(unit_of(c), at, "`self` names the instance a method works on; it cannot be declared")
    for i in c.body.block_start..<c.body.visible.len()
        if c.body.locals[c.body.visible[i]].name == name
            c.note(unit_of(c), at, s"`$name` is already defined in this block")
    val index = c.body.locals.len()
    c.body.locals.push(TLocal(name, ty, mutable, c.current))
    c.body.visible.push(index)
    index

// The mutable local an assignment or update writes, after reporting why anything else cannot be
// written.
private assignable(c: *Checker, target: &Expr) -> Option[usize]
    val unit = unit_of(c)
    val name = target.kind match
        Name(n) -> n
        _ ->
            c.note(unit, target.span, "only a local `var` can be assigned")
            return None
    lookup_local(c, name) match
        Some(index) ->
            if c.body.locals[index].mutable
                if c.body.locals[index].owner != c.current then c.body.uses.push(CaptureUse(c.current, index, false))
                return Some(index)
            c.note(unit, target.span, s"`$name` is a `val`; only a `var` can be assigned")
        None ->
            if param_index(c, name) is Some(_) then c.note(unit, target.span, s"`$name` is a parameter, which cannot be assigned")
            elif global_named(c, name) is Some(_) then c.note(unit, target.span, "assigning a module-level value in a multiple assignment is not implemented")
            elif lookup_function(c, name) is Some(_) then c.note(unit, target.span, s"`$name` is a function, which cannot be assigned")
            else c.note(unit, target.span, s"`$name` is not defined")
    None

/** A field an assignment writes: the object, read once, and the field's index and type. `setup`
 * holds the object in a hidden local when it is computed rather than named. */
private struct FieldPlace
    setup: Option[&TExpr]
    object: &TExpr
    index: usize
    ty: &Type

    /** `body`, after the object is held. */
    wrap(self, at: Span, body: &TExpr) -> &TExpr = self.setup match
        Some(s) ->
            var items: Buf[&TExpr] = buf()
            items.push(s)
            items.push(body)
            TExpr(at, body.ty, Block(items))
        None -> body
end FieldPlace

// Whether an assignment's target is a field: `object.name`, or inside a class a bare name that no
// local or parameter hides.
private targets_field(c: *Checker, target: &Expr) -> bool = target.kind match
    Member(_, _) -> true
    Name(n) -> lookup_local(c, n) is None && param_index(c, n) is None && class_member(c, n) is Some(FieldOf(_))
    _ -> false

// The field an assignment writes, after reporting why it cannot be written: it must be a `var`
// field, public unless the code is in its own class.
private field_place(c: *Checker, target: &Expr) -> Option[FieldPlace]
    val unit = unit_of(c)
    var object: &TExpr = TExpr(target.span, ErrorType, UnitConst)
    var k = 0usize
    var name = ""
    target.kind match
        Name(n) ->
            name = n
            k = enclosing_class(c).unwrap()
            object = self_ref(c, target.span)
        Member(t, n) ->
            name = n
            object = check_expr(c, t, None)
            *zonk(c, object.ty) match
                Class(id, _, _) -> k = id
                ErrorType -> return None
                Nothing -> return None
                Data(_, _, _) ->
                    c.note(unit, target.span, "a field of a data value cannot be assigned; data values are immutable")
                    return None
                Tuple(_) ->
                    c.note(unit, target.span, "a part of a tuple cannot be assigned; tuples are immutable")
                    return None
                _ ->
                    c.note(unit, target.span, s"${type_name(object.ty)} has no field `$n`")
                    return None
        _ -> return None
    val cls = c.classes[k]
    val index = class_field(c, k, name) match
        Some(i) -> i
        None ->
            if trait_field_named(c, k, name) is Some(m) then c.note(unit, target.span, s"`$name` is a `val` of `${c.classes[c.symbols[m].owner_class.unwrap()].name}`, which is read through `${cls.name}` and never assigned")
            elif method_named(c, k, name) is Some(_) then c.note(unit, target.span, s"`$name` is a method of `${cls.name}`, which cannot be assigned")
            else c.note(unit, target.span, s"`${cls.name}` has no member `$name`")
            return None
    val field = cls.fields[index]
    if !field_visible(c, field)
        c.note(unit, target.span, s"`$name` is private to `${c.classes[field.owner].name}`")
        return None
    if !field.mutable
        if field.param then c.note(unit, target.span, s"`$name` is a class parameter, which cannot be assigned; declare it `var` to make it a mutable field")
        else c.note(unit, target.span, s"`$name` is a `val` field; only a `var` field can be assigned")
        return None
    if is_self(c, object) && c.current == cls.initializer && index >= cls.ready
        c.note(unit, target.span, s"`$name` is assigned before its declaration in the class body initializes it")
        return None
    val args = *zonk(c, object.ty) match
        Class(_, _, a) -> a
        _ -> buf()
    val ty = substitute(field_type(c, k, index, target.span), class_owner(k), args)
    if object.kind is Local(_) || object.kind is Param(_) then return Some(FieldPlace(None, object, index, ty))
    val held = hidden_local(c, object.ty)
    Some(FieldPlace(Some(TExpr(object.span, Unit, Let(held, object))), TExpr(object.span, object.ty, Local(held)), index, ty))

private assign_field(c: *Checker, e: &Expr, target: &Expr, op: Option[BinaryOp], value: &Expr, yields: bool, op_span: Span) -> &TExpr
    val place = field_place(c, target) match
        Some(p) -> p
        None ->
            check_statement(c, value)
            return TExpr(e.span, ErrorType, UnitConst)
    val current = TExpr(target.span, place.ty, Field(place.object, place.index))
    val stored = op match
        Some(o) -> operate(c, e.span, op_span, o, binary_spelling(o) + (if yields then ":=" else "="), current, check_expr(c, value, Some(place.ty)))
        None ->
            val typed = check_expr(c, value, Some(place.ty))
            if !fits(c,typed.ty, place.ty)
                c.note(unit_of(c), value.span, s"expected ${type_name(place.ty)}, found ${type_name(typed.ty)}")
            typed
    val ty: &Type = if *stored.ty is Nothing then Nothing elif yields then place.ty else Unit
    place.wrap(e.span, TExpr(e.span, ty, StoreField(place.object, place.index, stored, yields)))

// `++` and `--` on a field: the field is read, stepped with the usual overflow check, and stored.
private update_field(c: *Checker, e: &Expr, target: &Expr, increment: bool, postfix: bool, op_span: Span) -> &TExpr
    val place = field_place(c, target) match
        Some(p) -> p
        None -> return TExpr(e.span, ErrorType, UnitConst)
    val ty = place.ty
    if !(*ty is Int(_) || *ty is ErrorType)
        c.note(unit_of(c), e.span, s"`${if increment then "++" else "--"}` needs an integer, not ${type_name(ty)}")
        return TExpr(e.span, ErrorType, UnitConst)
    val op = if increment then Add else Subtract
    val one = TExpr(op_span, ty, IntConst("1"))
    val current = TExpr(target.span, ty, Field(place.object, place.index))
    if !postfix
        return place.wrap(e.span, TExpr(e.span, ty, StoreField(place.object, place.index, TExpr(e.span, ty, Arith(op, current, one, op_span)), true)))
    val old = hidden_local(c, ty)
    val previous = TExpr(target.span, ty, Local(old))
    var items: Buf[&TExpr] = buf()
    items.push(TExpr(e.span, Unit, Let(old, current)))
    items.push(TExpr(e.span, Unit, StoreField(place.object, place.index, TExpr(e.span, ty, Arith(op, previous, one, op_span)), false)))
    items.push(previous)
    place.wrap(e.span, TExpr(e.span, ty, Block(items)))

// A module-level value or object named by a bare name, unless a local function of that name hides
// it or a declaration of a nearer module, the file's own over the core library's, shadows it.
private global_named(c: *Checker, name: string) -> Option[usize]
    if local_function(c, name) is Some(_) then return None
    c.global_names.get(resolve_name(c, unit_of(c), name))

/** The variant a bare name refers to in the code being checked, if it refers to one. */
private variant_named(c: *Checker, name: string) -> Option[VariantRef] = c.variants.get(resolve_name(c, unit_of(c), name))

// A module-level value's type is its initializer's result: declared, or inferred by checking the
// initializer first, which is not possible while that initializer is itself being checked.
private global_type(c: *Checker, g: usize, at: Span) -> &Type
    val init = c.globals[g].init
    if c.symbols[init].result is Some(t) then return t
    if c.states[init] == 0
        check_function(c, init)
        return c.symbols[init].result.unwrap_or(ErrorType)
    val name = c.globals[g].name
    c.note(unit_of(c), at, s"the type of `$name` is needed while its initializer is checked; declare it, as in `val $name: int = …`")
    ErrorType

private global_read(c: *Checker, at: Span, g: usize) -> &TExpr = TExpr(at, global_type(c, g, at), Global(g))

// A value declared without a type takes its initializer's, which must be fully known.
private settle_global(c: *Checker, g: usize)
    val global = c.globals[g]
    if global.object is Some(_) then return
    val t = zonk(c, c.symbols[global.init].result.unwrap_or(ErrorType))
    if has_unknowns(t)
        c.note(global.unit, global.span, s"cannot infer the type of `${global.name}`; declare it, as in `val ${global.name}: int = …`")
        c.symbols[global.init].result = Some(ErrorType)
    else c.symbols[global.init].result = Some(t)

// Whether an assignment's target is a module-level value: a bare name that no local, parameter or
// member of the enclosing class hides.
private targets_global(c: *Checker, target: &Expr) -> Option[usize] = target.kind match
    Name(n) -> if lookup_local(c, n) is None && param_index(c, n) is None && class_member(c, n) is None then global_named(c, n) else None
    _ -> None

// Only a module-level `var` can be assigned.
private writable_global(c: *Checker, at: Span, g: usize) -> bool
    val global = c.globals[g]
    if global.object is Some(_) then c.note(unit_of(c), at, s"`${global.name}` is an object, which cannot be assigned")
    elif !global.mutable then c.note(unit_of(c), at, s"`${global.name}` is a module-level `val`; only a `var` can be assigned")
    else return true
    false

private assign_global(c: *Checker, e: &Expr, target: &Expr, g: usize, op: Option[BinaryOp], value: &Expr, yields: bool, op_span: Span) -> &TExpr
    if !writable_global(c, target.span, g)
        check_statement(c, value)
        return TExpr(e.span, ErrorType, UnitConst)
    val ty = global_type(c, g, target.span)
    val current = TExpr(target.span, ty, Global(g))
    val stored = op match
        Some(o) -> operate(c, e.span, op_span, o, binary_spelling(o) + (if yields then ":=" else "="), current, check_expr(c, value, Some(ty)))
        None ->
            val typed = check_expr(c, value, Some(ty))
            if !conforms(typed.ty, ty)
                c.note(unit_of(c), value.span, s"expected ${type_name(ty)}, found ${type_name(typed.ty)}")
            typed
    val result: &Type = if *stored.ty is Nothing then Nothing elif yields then ty else Unit
    TExpr(e.span, result, StoreGlobal(g, stored, yields))

// `++` and `--` on a module-level `var`: read, stepped with the usual overflow check, and stored.
private update_global(c: *Checker, e: &Expr, target: &Expr, g: usize, increment: bool, postfix: bool, op_span: Span) -> &TExpr
    if !writable_global(c, target.span, g) then return TExpr(e.span, ErrorType, UnitConst)
    val ty = global_type(c, g, target.span)
    if !(*ty is Int(_) || *ty is ErrorType)
        c.note(unit_of(c), e.span, s"`${if increment then "++" else "--"}` needs an integer, not ${type_name(ty)}")
        return TExpr(e.span, ErrorType, UnitConst)
    val op = if increment then Add else Subtract
    val one = TExpr(op_span, ty, IntConst("1"))
    val current = TExpr(target.span, ty, Global(g))
    if !postfix then return TExpr(e.span, ty, StoreGlobal(g, TExpr(e.span, ty, Arith(op, current, one, op_span)), true))
    val old = hidden_local(c, ty)
    val previous = TExpr(target.span, ty, Local(old))
    var items: Buf[&TExpr] = buf()
    items.push(TExpr(e.span, Unit, Let(old, current)))
    items.push(TExpr(e.span, Unit, StoreGlobal(g, TExpr(e.span, ty, Arith(op, previous, one, op_span)), false)))
    items.push(previous)
    TExpr(e.span, ty, Block(items))

/** One step of ordering the module-level values: what each value's initializer needs, and the
 * search's progress. `state` is 0 for a value not yet reached, 1 while the values it needs are being
 * ordered, and 2 once it has its place. */
private struct InitOrder
    needs: Buf[Buf[usize]]
    state: Buf[u8]
    path: Buf[usize]
    order: Buf[usize]

// Module-level values initialize before `main`, each after every value its initializer uses:
// directly, or in the functions it calls and the closures it makes, however deeply. Otherwise they
// keep their declaration order. A value that needs itself is a cycle, reported with the values it
// passes through.
// A call through a method table reaches the method the call names or any override of it: the method
// of that name in the same slot of any class's table. Every one counts as called.
private with_implementations(c: *Checker, uses: Uses) -> Uses
    var u = uses
    for i in 0..<u.dispatched.len()
        val name = c.symbols[u.dispatched[i]].decl.name
        val slot = u.dispatched_slots[i]
        for k in c.classes
            if slot < k.table.len()
                if k.table[slot] is Some(m)
                    if c.symbols[m].decl.name == name then add_function(&u, m)
    u

private initialization_order(c: *Checker) -> Buf[usize]
    var direct: Buf[Option[Uses]] = buf()
    for b in c.bodies
        direct.push(b match
            Some(body) -> Some(with_implementations(c, uses_of(body)))
            None -> None)
    var o = InitOrder(buf(), buf(), buf(), buf())
    for g in c.globals
        o.needs.push(globals_reached(direct, g.init))
        o.state.push(0)
    for g in 0..<c.globals.len()
        if o.state[g] == 0 then order_global(c, &o, g)
    o.order

private order_global(c: *Checker, o: *InitOrder, g: usize)
    o.state.set(g, 1)
    o.path.push(g)
    for need in o.needs[g]
        if o.state[need] == 1 then report_cycle(c, o, need)
        elif o.state[need] == 0 then order_global(c, o, need)
    o.path.truncate(o.path.len() - 1)
    o.state.set(g, 2)
    o.order.push(g)

// The cycle runs from `start`, where it is on the path being ordered, to the path's end and back.
private report_cycle(c: *Checker, o: *InitOrder, start: usize)
    val first = c.globals[start]
    if o.path[o.path.len() - 1] == start
        c.note(first.unit, first.span, s"`${first.name}` is needed by its own initializer, directly or through the functions it calls")
        return
    var cycle = ""
    var on = false
    for g in o.path
        if g == start then on = true
        if on then cycle = cycle + s"`${c.globals[g].name}` → "
    c.note(first.unit, first.span, s"module-level values need one another to initialize: $cycle`${first.name}`")

// One function initializes every module-level value in order, storing each initializer's result.
// The program's `main` runs it before the entry.
private initializer(c: *Checker, order: Buf[usize]) -> Option[usize]
    if c.globals.len() == 0 then return None
    val unit = c.units.len() - 1
    val module_name = c.units[unit].file.module_name
    val at = Span(0, 0)
    val id = c.symbols.len()
    val decl = Function(buf(), at, at, "<init>", buf(), buf(), None, None, buf())
    c.symbols.push(FunctionSymbol(unit, module_name, "<init>", decl, buf(), buf(), Some(Unit), None, None, buf(), buf(), buf(), false, false, false, buf(), None, id, buf(), None, false, true, "", None))
    var items: Buf[&TExpr] = buf()
    for g in order
        val init = c.globals[g].init
        val value = TExpr(at, c.symbols[init].result.unwrap_or(ErrorType), Call(init, buf(), buf()))
        items.push(TExpr(at, Unit, StoreGlobal(g, value, false)))
    c.states.push(2)
    c.bodies.push(Some(TExpr(at, Unit, Block(items))))
    c.locals.push(buf())
    Some(id)

private assign_expr(c: *Checker, e: &Expr, target: &Expr, op: Option[BinaryOp], value: &Expr, yields: bool, op_span: Span) -> &TExpr
    if targets_field(c, target) then return assign_field(c, e, target, op, value, yields, op_span)
    if targets_global(c, target) is Some(g) then return assign_global(c, e, target, g, op, value, yields, op_span)
    val unit = unit_of(c)
    val index = assignable(c, target) match
        Some(i) -> i
        None ->
            check_statement(c, value)
            return TExpr(e.span, ErrorType, UnitConst)
    val local = c.body.locals[index]
    val current = TExpr(target.span, local.ty, Local(index))
    val stored = op match
        Some(o) -> operate(c, e.span, op_span, o, binary_spelling(o) + (if yields then ":=" else "="), current, check_expr(c, value, Some(local.ty)))
        None ->
            val typed = check_expr(c, value, Some(local.ty))
            if !fits(c,typed.ty, local.ty)
                c.note(unit, value.span, s"expected ${type_name(local.ty)}, found ${type_name(typed.ty)}")
            typed
    val ty: &Type = if *stored.ty is Nothing then Nothing elif yields then local.ty else Unit
    TExpr(e.span, ty, Store(index, stored, yields))

// A tuple's parts take their expected types from an expected tuple of the same size. A part that
// never finishes means the tuple is never made.
private tuple_expr(c: *Checker, e: &Expr, items: Buf[&Expr], expected: Option[&Type]) -> &TExpr
    var wants: Buf[&Type] = buf()
    if expected is Some(t)
        if *zonk(c, t) is Tuple(types)
            if types.len() == items.len() then wants = types
    var typed: Buf[&TExpr] = buf()
    var types: Buf[&Type] = buf()
    var never = false
    var failed = false
    for i in 0..<items.len()
        val t = check_expr(c, items[i], if wants.len() > 0 then Some(wants[i]) else None)
        if *t.ty is Nothing then never = true
        if *t.ty is ErrorType then failed = true
        typed.push(t)
        types.push(t.ty)
    val ty: &Type = if failed then ErrorType elif never then Nothing else Tuple(types)
    TExpr(e.span, ty, Construct(0, typed))

// `t.0` reads a part of a tuple by its position.
private tuple_index(c: *Checker, e: &Expr, target: &Expr, index: usize) -> &TExpr
    val t = check_expr(c, target, None)
    *zonk(c, t.ty) match
        Tuple(types) ->
            if index < types.len() then return TExpr(e.span, types[index], Field(t, index))
            c.note(unit_of(c), e.span, s"${type_name(t.ty)} has ${count(types.len(), "part")}, numbered from 0, so it has no part $index")
        ErrorType -> ()
        Nothing -> return t
        _ -> c.note(unit_of(c), e.span, s"`.$index` reads a part of a tuple, and ${type_name(t.ty)} is not one")
    TExpr(e.span, ErrorType, UnitConst)

// `val a, b = value`: the pattern must match every value of the value's type, since a binding has
// no other way to go. A `var` makes every name it binds assignable.
private destructure_expr(c: *Checker, e: &Expr, pattern: &Pattern, declared: Option[&TypeExpr], value: &Expr, mutable: bool) -> &TExpr
    val unit = unit_of(c)
    var want: Option[&Type] = None
    if declared is Some(d) then want = Some(resolve_type(c, unit, d))
    val typed = check_expr(c, value, want)
    var ty = typed.ty
    if want is Some(w)
        if !fits(c,typed.ty, w) then c.note(unit, value.span, s"expected ${type_name(w)}, found ${type_name(typed.ty)}")
        ty = w
    val outer = c.binds_var
    c.binds_var = mutable
    val shape = check_pattern(c, pattern, ty, "")
    c.binds_var = outer
    if settled(ty) && settled(shape.ty)
        var arms: Buf[TArm] = buf()
        arms.push(TArm(shape, None, TExpr(e.span, Unit, UnitConst)))
        if !match_covers(arms, ty, c.data)
            c.note(unit, pattern.span, s"a binding's pattern must match every ${type_name(ty)} value; take the value apart with `match`")
    TExpr(e.span, if *typed.ty is Nothing then Nothing else Unit, LetPattern(shape, typed))

// `a, b = x, y` and its compound forms. Every place is read, then the whole value is made, and only
// then is anything stored, so `a, b = b, a` swaps. A target `_` discards its part.
private multi_assign_expr(c: *Checker, e: &Expr, targets: Buf[&Expr], op: Option[BinaryOp], value: &Expr, op_span: Span) -> &TExpr
    val unit = unit_of(c)
    var locals: Buf[Option[usize]] = buf()
    var types: Buf[Option[&Type]] = buf()
    // A field is stored through a hidden local the multiple store writes, then copied into the field;
    // the object it belongs to is held first, before anything is read.
    var fields: Buf[Option[FieldPlace]] = buf()
    var block: Buf[&TExpr] = buf()
    var ok = true
    for t in targets
        if t.kind is Name("_")
            if op is Some(o)
                c.note(unit, t.span, s"`${binary_spelling(o)}=` reads every place before writing it, and `_` has nothing to read")
                ok = false
            locals.push(None)
            types.push(None)
            fields.push(None)
            continue
        if targets_field(c, t)
            field_place(c, t) match
                Some(place) ->
                    if place.setup is Some(s) then block.push(s)
                    locals.push(Some(hidden_local(c, place.ty)))
                    types.push(Some(place.ty))
                    fields.push(Some(place))
                None ->
                    ok = false
                    locals.push(None)
                    types.push(None)
                    fields.push(None)
            continue
        fields.push(None)
        assignable(c, t) match
            Some(i) ->
                locals.push(Some(i))
                types.push(Some(c.body.locals[i].ty))
            None ->
                ok = false
                locals.push(None)
                types.push(None)
    // Each place's current value, read before anything on the right is evaluated.
    var olds: Buf[Option[usize]] = buf()
    if op is Some(_)
        for i in 0..<locals.len()
            locals[i] match
                Some(local) ->
                    val ty = c.body.locals[local].ty
                    val old = hidden_local(c, ty)
                    val current = fields[i] match
                        Some(place) -> TExpr(targets[i].span, ty, Field(place.object, place.index))
                        None -> TExpr(targets[i].span, ty, Local(local))
                    block.push(TExpr(e.span, Unit, Let(old, current)))
                    olds.push(Some(old))
                None -> olds.push(None)
    // The parts of the value: checked one by one against their places when it is written as a tuple,
    // and otherwise read from the tuple it makes.
    var parts: Buf[&TExpr] = buf()
    var never = false
    if value.kind is Tuple(items)
        if items.len() != targets.len()
            c.note(unit, value.span, s"this assigns ${count(targets.len(), "place")} from ${count(items.len(), "value")}")
            ok = false
        for i in 0..<items.len()
            val want = if i < types.len() then types[i] else None
            val t = check_expr(c, items[i], want)
            if *t.ty is Nothing then never = true
            if op is Some(_)
                val part = hidden_local(c, t.ty)
                block.push(TExpr(t.span, Unit, Let(part, t)))
                parts.push(TExpr(t.span, t.ty, Local(part)))
            else parts.push(t)
    else
        val whole = check_expr(c, value, None)
        if *whole.ty is Nothing then never = true
        *zonk(c, whole.ty) match
            Tuple(item_types) ->
                if item_types.len() != targets.len()
                    c.note(unit, value.span, s"this assigns ${count(targets.len(), "place")} from a tuple of ${item_types.len()}")
                    ok = false
                else
                    val held = hidden_local(c, whole.ty)
                    block.push(TExpr(value.span, Unit, Let(held, whole)))
                    for i in 0..<item_types.len()
                        parts.push(TExpr(value.span, item_types[i], Field(TExpr(value.span, whole.ty, Local(held)), i)))
            ErrorType -> ok = false
            Nothing -> ()
            _ ->
                c.note(unit, value.span, s"a multiple assignment takes its values from a tuple, not ${type_name(whole.ty)}")
                ok = false
    if !ok then return TExpr(e.span, ErrorType, UnitConst)
    if never then return TExpr(e.span, Nothing, Block(block))
    // Each stored value: the part itself, or the place's old value combined with it.
    var stored: Buf[&TExpr] = buf()
    var stored_types: Buf[&Type] = buf()
    for i in 0..<parts.len()
        val part = parts[i]
        var result = part
        types[i] match
            Some(ty) ->
                op match
                    Some(o) ->
                        val old = TExpr(targets[i].span, ty, Local(olds[i].unwrap()))
                        result = operate(c, targets[i].span, op_span, o, binary_spelling(o) + "=", old, part)
                    None ->
                        if !fits(c,part.ty, ty) then c.note(unit, part.span, s"expected ${type_name(ty)}, found ${type_name(part.ty)}")
            None -> ()
        stored.push(result)
        stored_types.push(result.ty)
    block.push(TExpr(e.span, Unit, MultiStore(locals, TExpr(value.span, Tuple(stored_types), Construct(0, stored)))))
    for i in 0..<fields.len()
        if fields[i] is Some(place)
            val held = TExpr(targets[i].span, place.ty, Local(locals[i].unwrap()))
            block.push(TExpr(targets[i].span, Unit, StoreField(place.object, place.index, held, false)))
    TExpr(e.span, Unit, Block(block))

/** A local the compiler introduces to hold a value for a moment; no name reaches it. */
private hidden_local(c: *Checker, ty: &Type) -> usize
    val index = c.body.locals.len()
    c.body.locals.push(TLocal("", ty, false, c.current))
    index

private update_expr(c: *Checker, e: &Expr, target: &Expr, increment: bool, postfix: bool, op_span: Span) -> &TExpr
    if targets_field(c, target) then return update_field(c, e, target, increment, postfix, op_span)
    if targets_global(c, target) is Some(g) then return update_global(c, e, target, g, increment, postfix, op_span)
    val index = assignable(c, target) match
        Some(i) -> i
        None -> return TExpr(e.span, ErrorType, UnitConst)
    val ty = c.body.locals[index].ty
    if !(*ty is Int(_) || *ty is ErrorType)
        c.note(unit_of(c), e.span, s"`${if increment then "++" else "--"}` needs an integer, not ${type_name(ty)}")
        return TExpr(e.span, ErrorType, UnitConst)
    TExpr(e.span, ty, Step(index, increment, postfix, op_span))

// An integer literal, possibly negated, takes its type from context rather than giving one.
private is_literal(e: &Expr) -> bool = e.kind match
    IntLit(_) -> true
    Unary(Negate, operand) -> operand.kind is IntLit(_)
    _ -> false

private settled(t: &Type) -> bool = !(*t is ErrorType || *t is Nothing)

private expect_bool(c: *Checker, t: &TExpr)
    if !fits(c,t.ty, Bool) then c.note(unit_of(c), t.span, s"expected bool, found ${type_name(t.ty)}")

private unary_expr(c: *Checker, e: &Expr, op: UnaryOp, operand: &Expr, expected: Option[&Type]) -> &TExpr
    if op is Not
        val x = check_expr(c, operand, Some(Bool))
        expect_bool(c, x)
        return TExpr(e.span, if *x.ty is Nothing then Nothing else Bool, Not(x))
    if op is Negate && operand.kind is IntLit(spelling)
        return integer_literal(c, e.span, spelling, true, expected)
    val x = check_expr(c, operand, expected)
    // `-` and `+` apply to integers and reals, `~` to integers and bytes.
    val fits_op = *x.ty match
        Int(_) -> true
        Real -> !(op is Complement)
        Byte -> op is Complement
        _ -> !settled(x.ty)
    if !fits_op
        val wanted = if op is Complement then "an integer or a byte" else "a number"
        c.note(unit_of(c), e.span, s"`${unary_spelling(op)}` needs $wanted, not ${type_name(x.ty)}")
        return TExpr(e.span, ErrorType, UnitConst)
    op match
        Negate -> TExpr(e.span, x.ty, Negate(x))
        Complement -> TExpr(e.span, x.ty, Complement(x))
        _ -> x

// The operand that is not a bare literal is checked first, so a literal on either side takes the
// other operand's type: in `1 + x` with `x: i8`, the `1` is an `i8`.
private binary_expr(c: *Checker, e: &Expr, op: BinaryOp, left: &Expr, right: &Expr, op_span: Span, expected: Option[&Type]) -> &TExpr
    if op is And || op is Or
        val l = check_expr(c, left, Some(Bool))
        val r = check_expr(c, right, Some(Bool))
        expect_bool(c, l)
        expect_bool(c, r)
        // The right operand may not run, so only the left one decides that the operation never finishes.
        return TExpr(e.span, if *l.ty is Nothing then Nothing else Bool, Logic(op is And, l, r))
    if is_literal(left) && !is_literal(right)
        val r = check_expr(c, right, expected)
        return operate(c, e.span, op_span, op, binary_spelling(op), check_expr(c, left, Some(r.ty)), r)
    val l = check_expr(c, left, expected)
    operate(c, e.span, op_span, op, binary_spelling(op), l, check_expr(c, right, Some(l.ty)))

// Arithmetic, bitwise and shift operators take two operands of one type and yield that type.
// Integers have them all; reals have arithmetic; bytes have bitwise operators and shifts. `at` is
// the whole operation, which diagnostics point at; `op_at` is its operator, where a trap is reported.
private operate(c: *Checker, at: Span, op_at: Span, op: BinaryOp, spelling: string, l: &TExpr, r: &TExpr) -> &TExpr
    if !settled(l.ty) || !settled(r.ty)
        // An operand that never finishes means the operation never finishes.
        val ty: &Type = if *l.ty is ErrorType || *r.ty is ErrorType then ErrorType else Nothing
        return TExpr(at, ty, Arith(op, l, r, op_at))
    if *l.ty is Str && *r.ty is Str
        if op is Add then return TExpr(at, Str, Arith(op, l, r, op_at))
        c.note(unit_of(c), at, s"`$spelling` is not defined on strings; `+` joins two strings")
        return TExpr(at, ErrorType, UnitConst)
    if *l.ty is Str && op is Add || *r.ty is Str && op is Add
        val other = if *l.ty is Str then r.ty else l.ty
        c.note(unit_of(c), at, s"`+` joins two strings, not a string and ${type_name(other)}")
        return TExpr(at, ErrorType, UnitConst)
    val numeric = *l.ty is Int(_) || *l.ty is Real || *l.ty is Byte
    if !numeric || !same_type(l.ty, r.ty)
        c.note(unit_of(c), at, s"`$spelling` needs two numbers of one type, not ${type_name(l.ty)} and ${type_name(r.ty)}")
        return TExpr(at, ErrorType, UnitConst)
    val bitwise = op is BitAnd || op is BitOr || op is BitXor || op is ShiftLeft || op is ShiftRight
    val arithmetic = op is Add || op is Subtract || op is Multiply || op is Divide || op is Remainder
    if *l.ty is Byte && !bitwise
        c.note(unit_of(c), at, s"`$spelling` is not defined on byte, which has bitwise operators and no arithmetic")
        return TExpr(at, ErrorType, UnitConst)
    if *l.ty is Real && !arithmetic
        c.note(unit_of(c), at, s"`$spelling` is not defined on real")
        return TExpr(at, ErrorType, UnitConst)
    TExpr(at, l.ty, Arith(op, l, r, op_at))

private compare_expr(c: *Checker, e: &Expr, operands: Buf[&Expr], ops: Buf[CompareOp]) -> &TExpr
    var early: Buf[Option[&TExpr]] = buf()
    var anchor: Option[&Type] = None
    for o in operands
        if is_literal(o) then early.push(None)
        else
            val t = check_expr(c, o, None)
            if anchor is None && settled(t.ty) then anchor = Some(t.ty)
            early.push(Some(t))
    var typed: Buf[&TExpr] = buf()
    for i in 0..<operands.len()
        early[i] match
            Some(t) -> typed.push(t)
            None -> typed.push(check_expr(c, operands[i], anchor))
    for i in 0..<ops.len()
        compare_link(c, ops[i], typed[i], typed[i + 1])
    var ty: &Type = Bool
    for t in typed
        if *t.ty is Nothing then ty = Nothing
    TExpr(e.span, ty, Compare(typed, ops))

private is_trait_type(c: *Checker, t: &Type) -> bool = *t match
    Class(id, _, _) -> is_trait(c, id)
    _ -> false

private compare_link(c: *Checker, op: CompareOp, a: &TExpr, b: &TExpr)
    if !settled(a.ty) || !settled(b.ty) then return
    val at = a.span.to(b.span)
    val spelling = compare_spelling(op)
    // An `Any` may hold a value with no identity and no equality; a type pattern recovers its type,
    // and with it the comparisons that type has.
    if *a.ty is AnyType || *b.ty is AnyType
        c.note(unit_of(c), at, s"`$spelling` on Any is not implemented; match the value by its type first, as in `s: string`")
        return
    val identity = op is Same || op is NotSame
    // A function value is a closure and an object of a class is a heap object: both are
    // references. `===` always compares them by identity; `==` does too, until a class defines its
    // own equality (`Eq`), which `==` would then use in its place.
    if identity || *a.ty is Function(_, _) || *a.ty is Class(_, _, _)
        if !identity && (is_trait_type(c, a.ty) || is_trait_type(c, b.ty))
            // A trait-typed value may hold a data value, which compares by value, or an object,
            // which compares by identity: telling them apart needs runtime equality entries.
            c.note(unit_of(c), at, s"`$spelling` on the trait type ${type_name(if is_trait_type(c, a.ty) then a.ty else b.ty)} is not implemented; match the value by its type first, or compare with `===`")
            return
        if (*a.ty is Function(_, _) || *a.ty is Class(_, _, _)) && same_type(a.ty, b.ty) then return
        // An instance of a subclass may be the very object a superclass-typed value holds.
        if *a.ty is Class(_, _, _) && *b.ty is Class(_, _, _)
            if same_type(upcast(c, a.ty, b.ty), b.ty) || same_type(upcast(c, b.ty, a.ty), a.ty) then return
            c.note(unit_of(c), at, s"`$spelling` cannot compare ${type_name(a.ty)} with ${type_name(b.ty)}")
            return
        if !identity
            c.note(unit_of(c), at, s"`$spelling` cannot compare ${type_name(a.ty)} with ${type_name(b.ty)}")
            return
        c.note(unit_of(c), at, s"`$spelling` compares identities, and ${type_name(a.ty)} values have none")
        return
    if !same_type(a.ty, b.ty)
        c.note(unit_of(c), at, s"`$spelling` cannot compare ${type_name(a.ty)} with ${type_name(b.ty)}")
        return
    val equality = op is Equal || op is NotEqual
    if *a.ty is Int(_) || *a.ty is Byte || *a.ty is Char || *a.ty is Real || *a.ty is Str then return
    if equality && *a.ty is Bool then return
    c.note(unit_of(c), at, s"`$spelling` cannot compare ${type_name(a.ty)} values")

// `s"a${x}b"` is the text pieces and the rendered holes joined in order, as
// `"a" + x.toString() + "b"`; an empty piece is left out. Each hole is evaluated once, left to
// right.
private interpolate_expr(c: *Checker, e: &Expr, prefix: string, chunks: Buf[string], holes: Buf[&Expr]) -> &TExpr
    val unit = unit_of(c)
    var ok = true
    if prefix != "s"
        c.note(unit, e.span, s"`$prefix\"…\"` interpolation is not implemented; `s\"…\"` is")
        ok = false
    var pieces: Buf[&TExpr] = buf()
    var ty: &Type = Str
    for i in 0..<chunks.len()
        if chunks[i] != "" then pieces.push(TExpr(e.span, Str, StrConst(chunks[i])))
        if i < holes.len()
            val h = check_expr(c, holes[i], None)
            *h.ty match
                Str -> pieces.push(h)
                Int(_) -> pieces.push(TExpr(h.span, Str, Render(h)))
                Byte -> pieces.push(TExpr(h.span, Str, Render(h)))
                Char -> pieces.push(TExpr(h.span, Str, Render(h)))
                Real -> pieces.push(TExpr(h.span, Str, Render(h)))
                Bool -> pieces.push(TExpr(h.span, Str, Render(h)))
                Unit -> pieces.push(TExpr(h.span, Str, Render(h)))
                Nothing ->
                    ty = Nothing
                    pieces.push(h)
                ErrorType -> ok = false
                _ ->
                    c.note(unit, h.span, s"rendering a ${type_name(h.ty)} value is not implemented")
                    ok = false
    if !ok then return TExpr(e.span, ErrorType, UnitConst)
    if pieces.len() == 0 then return TExpr(e.span, Str, StrConst(""))
    var out = pieces[0]
    for k in 1..<pieces.len()
        out = TExpr(e.span, ty, Arith(Add, out, pieces[k], e.span))
    if *ty is Nothing then TExpr(e.span, Nothing, out.kind) else out

// The type two branches agree on; where they have no nearest common superclass, the type expected
// of them, when both conform to it: two classes conforming to one trait agree on the trait only
// where it is asked for, since they may share several.
private join_expected(c: *Checker, a: &Type, b: &Type, expected: Option[&Type]) -> Option[&Type]
    if join(c, a, b) is Some(t) then return Some(t)
    val want = expected?
    if fits(c, a, want) && fits(c, b, want) then Some(want) else None

// The type two branches agree on, where one that never finishes agrees with anything.
// Two instances of classes agree on their nearest common ancestor, and two instances of one generic
// type on the instance whose covariant arguments are their arguments' agreement.
private join(c: *Checker, a: &Type, b: &Type) -> Option[&Type]
    if *a is Nothing || *a is ErrorType then return Some(b)
    if *b is Nothing || *b is ErrorType then return Some(a)
    if same_type(a, b) then return Some(a)
    var current = zonk(c, a)
    if *current is Data(_, _, _) then return join_args(c, current, zonk(c, b))
    loop
        val k = *current match
            Class(k, _, args) -> k
            _ -> return None
        if ancestor_type(c.classes, c.data, zonk(c, b), k) is Some(up)
            if same_type(up, current) then return Some(current)
            if join_args(c, current, up) is Some(t) then return Some(t)
        current = ancestor_parent(c, current)?
    None

// The instance of one generic type that two of its instances agree on: equal invariant arguments,
// and covariant arguments that are references agreeing on a type.
private join_args(c: *Checker, a: &Type, b: &Type) -> Option[&Type]
    val (params, xs, ys) = *a match
        Data(d, _, xs) -> *b match
            Data(e, _, ys) -> if d == e then (c.data[d].decl.type_params, xs, ys) else return None
            _ -> return None
        Class(k, _, xs) -> *b match
            Class(j, _, ys) -> if k == j then (c.classes[k].decl.type_params, xs, ys) else return None
            _ -> return None
        _ -> return None
    if xs.len() != ys.len() || xs.len() != params.len() then return None
    var args: Buf[&Type] = buf()
    for i in 0..<xs.len()
        if same_type(xs[i], ys[i])
            args.push(xs[i])
            continue
        if !(params[i].variance is Covariant) || !is_reference(xs[i]) || !is_reference(ys[i]) then return None
        args.push(join(c, xs[i], ys[i])?)
    *a match
        Data(d, name, _) -> Some(Data(d, name, args))
        Class(k, name, _) -> Some(Class(k, name, args))
        _ -> None

/** The superclass of an instance's class, as the instance's type, if it has one. */
private ancestor_parent(c: *Checker, t: &Type) -> Option[&Type] = *t match
    Class(k, _, args) -> Some(substitute(c.classes[k].superclass?, class_owner(k), args))
    _ -> None

/** `from` as the type `to` asks for, where a value of `from` is one of `to` (see `view_as`);
 * otherwise `from` itself, or a type that differs from `to`. */
private upcast(c: *Checker, from: &Type, to: &Type) -> &Type
    val x = zonk(c, from)
    // Every value converts to `Any`, by boxing where it is written; never inside a tuple or as a
    // type argument, whose parts are already laid out.
    if *zonk(c, to) is AnyType && !(*x is Var(_) || *x is ByName(_)) then return AnyType
    // A value of a type parameter is an instance of its bounds.
    if *x is TypeVar(_, _, _)
        if *zonk(c, to) is Class(k, _, _)
            for b in bounds_of(c, x)
                if ancestor_type(c.classes, c.data, b, k) is Some(_) then return view_as(c.classes, c.data, b, zonk(c, to))
    view_as(c.classes, c.data, x, zonk(c, to))

/** Whether a value of type `from` may be used where `to` is expected: an instance of a subclass is an
 * instance of its superclass, and an instance of a generic type one of another instance as its
 * parameters' variance allows, also inside a tuple or a function type. */
private fits(c: *Checker, from: &Type, to: &Type) -> bool = conforms(upcast(c, from, to), to)

private if_expr(c: *Checker, e: &Expr, condition: &Expr, yes: &Expr, no: Option[&Expr], expected: Option[&Type], used: bool) -> &TExpr
    val cond = check_expr(c, condition, Some(Bool))
    expect_bool(c, cond)
    val other = no match
        Some(n) -> n
        None ->
            // Without `else` the branch's value is discarded and the `if` yields unit.
            return TExpr(e.span, Unit, If(cond, branch(c, yes, None, false), None))
    val y = branch(c, yes, expected, used)
    val n = branch(c, other, expected, used)
    var ty: &Type = Unit
    if *y.ty is Nothing && *n.ty is Nothing then ty = Nothing
    elif used
        join_expected(c, y.ty, n.ty, expected) match
            Some(t) -> ty = t
            None ->
                c.note(unit_of(c), e.span, s"the branches of this `if` yield ${type_name(y.ty)} and ${type_name(n.ty)}")
                ty = ErrorType
    TExpr(e.span, ty, If(cond, y, Some(n)))

// A loop yields unit, or with an `else`, the value its `else` and every `break` agree on. A
// `while true` that no `break` leaves never finishes.
private while_expr(c: *Checker, e: &Expr, condition: &Expr, body: &Expr, otherwise: Option[&Expr], expected: Option[&Type], used: bool) -> &TExpr
    val unit = unit_of(c)
    val cond = check_expr(c, condition, Some(Bool))
    expect_bool(c, cond)
    val label = c.body.labels
    c.body.labels += 1
    c.body.loops.push(label)
    val b = branch(c, body, None, false)
    c.body.loops.truncate(c.body.loops.len() - 1)
    var other: Option[&TExpr] = None
    var ty: &Type = Unit
    if otherwise is Some(o)
        val t = branch(c, o, expected, used)
        other = Some(t)
        ty = t.ty
    var broken = false
    for site in c.body.breaks
        if site.label != label then continue
        broken = true
        if other is None
            if !(*site.ty is Unit || *site.ty is ErrorType)
                c.note(unit, site.span, "a `break` with a value needs its loop to have an `else`")
        elif used
            join(c, ty, site.ty) match
                Some(t) -> ty = t
                None -> c.note(unit, site.span, s"this `break` yields ${type_name(site.ty)}, but the loop yields ${type_name(ty)}")
    if !used then ty = Unit
    if !broken && cond.kind is BoolConst(true) then ty = Nothing
    TExpr(e.span, ty, While(label, cond, b, other))

// A `loop` is left only by a `break`, so it yields what its `break`s agree on, and never finishes
// when none exists. It is lowered as a `while` whose condition always holds.
private loop_expr(c: *Checker, e: &Expr, body: &Expr) -> &TExpr
    val label = c.body.labels
    c.body.labels += 1
    c.body.loops.push(label)
    val b = branch(c, body, None, false)
    c.body.loops.truncate(c.body.loops.len() - 1)
    var ty: &Type = Nothing
    var broken = false
    for site in c.body.breaks
        if site.label != label then continue
        if !broken
            ty = site.ty
            broken = true
        else
            join(c, ty, site.ty) match
                Some(t) -> ty = t
                None -> c.note(unit_of(c), site.span, s"this `break` yields ${type_name(site.ty)}, but the loop yields ${type_name(ty)}")
    TExpr(e.span, ty, While(label, TExpr(e.span, Bool, BoolConst(true)), b, None))

// `do body while test else other` is a `while` whose first test passes without being evaluated, so
// the body runs once before the test and a `continue` in it reaches the test. A flag declared just
// outside the loop, named so that no source name can equal it, is cleared by that first test.
private do_while_form(e: &Expr, body: &Expr, condition: &Expr, otherwise: Option[&Expr]) -> &Expr
    val flag = s"do first ${e.span.start}"
    val here = condition.span
    val clear = Expr(here, Assign(Expr(here, Name(flag)), None, Expr(here, BoolLit(false)), false, here))
    var first: Buf[&Expr] = buf()
    first.push(clear)
    first.push(Expr(here, BoolLit(true)))
    val test = Expr(here, If(Expr(here, Name(flag)), Expr(here, Block(first, false)), Some(condition)))
    var items: Buf[&Expr] = buf()
    items.push(Expr(here, Binding(flag, None, Expr(here, BoolLit(true)), true)))
    items.push(Expr(e.span, While(test, body, otherwise)))
    Expr(e.span, Block(items, false))

private innermost_loop(c: *Checker, e: &Expr, word: string) -> Option[usize]
    if c.body.loops.len() == 0
        if c.symbols[c.current].delayed
            c.note(unit_of(c), e.span, s"`$word` cannot leave a delayed argument, which is evaluated where its parameter is read")
        else c.note(unit_of(c), e.span, s"`$word` is outside a loop")
        return None
    Some(c.body.loops[c.body.loops.len() - 1])

private break_expr(c: *Checker, e: &Expr, value: Option[&Expr]) -> &TExpr
    val target = innermost_loop(c, e, "break")
    var typed: Option[&TExpr] = None
    var ty: &Type = Unit
    if value is Some(v)
        val t = check_expr(c, v, None)
        typed = Some(t)
        ty = t.ty
    target match
        Some(label) ->
            c.body.breaks.push(BreakSite(label, e.span, ty))
            TExpr(e.span, Nothing, Break(label, typed))
        None -> TExpr(e.span, ErrorType, UnitConst)

private continue_expr(c: *Checker, e: &Expr) -> &TExpr = innermost_loop(c, e, "continue") match
    Some(label) -> TExpr(e.span, Nothing, Continue(label))
    None -> TExpr(e.span, ErrorType, UnitConst)

private return_expr(c: *Checker, e: &Expr, value: Option[&Expr]) -> &TExpr
    val unit = unit_of(c)
    val symbol = c.symbols[c.current]
    if symbol.delayed
        c.note(unit, e.span, "`return` cannot leave a delayed argument, which is evaluated where its parameter is read")
        if value is Some(v) then check_statement(c, v)
        return TExpr(e.span, Nothing, UnitConst)
    if symbol.constructor
        c.note(unit, e.span, "`return` cannot leave a class body, which runs to its end to make the object")
        if value is Some(v) then check_statement(c, v)
        return TExpr(e.span, Nothing, UnitConst)
    var typed: Option[&TExpr] = None
    symbol.result match
        Some(r) ->
            value match
                Some(v) ->
                    val t = check_expr(c, v, Some(r))
                    if !fits(c, t.ty, r) && !(*r is Unit)
                        c.note(unit, v.span, s"${described(symbol)} yields ${type_name(r)}, not ${type_name(t.ty)}")
                    typed = Some(t)
                None ->
                    if !(*r is Unit || *r is ErrorType)
                        c.note(unit, e.span, s"`return` needs a value, because ${described(symbol)} yields ${type_name(r)}")
        None ->
            if symbol.lambda then c.note(unit, e.span, "this lambda uses `return`, so its result type must be known where it is written, as in `val f: (int) -> int = …`")
            else c.note(unit, e.span, s"`${symbol.name}` uses `return`, so it needs a declared result type")
            if value is Some(v) then typed = Some(check_expr(c, v, None))
    TExpr(e.span, Nothing, Return(typed))

// A call to a generic function solves for its type arguments: they may be written (`f[int](x)`),
// and otherwise each starts as an unknown that the expected result type and the arguments decide.
// Arguments that are not bare literals are checked first, so a literal takes the type the others
// settle. Every type argument must be decided by the end of the call. A variant of a data type is
// called the same way, with the type's parameters as its type parameters.
private call_expr(c: *Checker, at: Span, callee: &Expr, args: Buf[Argument], expected: Option[&Type]) -> &TExpr
    val unit = unit_of(c)
    var explicit: Option[Buf[&TypeExpr]] = None
    var named = callee
    if callee.kind is TypeApply(inner, types)
        explicit = Some(types)
        named = inner
    if named.kind is Member(target, member) then return member_call(c, at, callee, named.span, target, member, args, explicit, expected, false)
    val name = named.kind match
        Name(n) -> n
        _ -> return value_call(c, at, callee, args)
    // A local or a parameter hides a function of the same name, as it does where it is not called.
    if explicit is None && (lookup_local(c, name) is Some(_) || param_index(c, name) is Some(_))
        return value_call(c, at, callee, args)
    class_member(c, name) match
        Some(MethodOf(m)) ->
            if c.super_args
                c.note(unit, named.span, s"`$name` is a method, which a superclass's arguments cannot call: they run before the object is initialized")
                for a in args
                    check_statement(c, a.value)
                return TExpr(at, ErrorType, UnitConst)
            val receiver = self_ref(c, named.span)
            var ms = bare_methods(c, name)
            if ms.len() == 0 then ms.push(m)
            return call_method(c, at, named.span, receiver, name, ms, args, explicit, expected, false)
        Some(FieldOf(_)) -> if explicit is None then return value_call(c, at, callee, args)
        Some(DataFieldOf(_)) -> if explicit is None then return value_call(c, at, callee, args)
        Some(TraitFieldOf(_)) -> if explicit is None then return value_call(c, at, callee, args)
        None -> ()
    // A module-level value is called as a value; a class's name in call position is its
    // constructor, even where its companion object shares the name.
    val ids = lookup_functions(c, name)
    if explicit is None && ids.len() == 0 && global_named(c, name) is Some(g)
        if c.globals[g].object is Some(_)
            c.note(unit, named.span, s"`$name` is an object, made once before `main`; it cannot be called")
            for a in args
                check_statement(c, a.value)
            return TExpr(at, ErrorType, UnitConst)
        return value_call(c, at, callee, args)
    if ids.len() == 0
        if variant_named(c, name) is Some(v)
            if c.data[v.data].variants[v.index].fields.len() == 0
                c.note(unit, at, s"`$name` has no fields; write it without parentheses")
                for a in args
                    check_statement(c, a.value)
                return TExpr(at, ErrorType, UnitConst)
            return construct(c, at, named.span, v, args, explicit, expected)
        if explicit is None
            if builtin_type(name) is Some(target) then return conversion(c, at, target, args)
        c.note(unit, named.span, s"`$name` is not defined")
        return TExpr(at, ErrorType, UnitConst)
    if ids.len() == 1 then return call_function(c, at, named.span, ids[0], args, explicit, expected, buf())
    val choice = choose_overload(c, at, named.span, name, ids, args, explicit)
    choice.id match
        Some(id) -> call_function(c, at, named.span, id, args, explicit, expected, choice.typed)
        None -> TExpr(at, ErrorType, UnitConst)

// A call of one function, with `typed` holding the arguments already checked, if any.
private call_function(c: *Checker, at: Span, name_span: Span, id: usize, args: Buf[Argument], explicit: Option[Buf[&TypeExpr]], expected: Option[&Type], typed: Buf[Option[&TExpr]]) -> &TExpr
    if abstract_constructor(c, id, name_span)
        for i in 0..<args.len()
            if i >= typed.len() || typed[i] is None then check_statement(c, args[i].value)
        return TExpr(at, ErrorType, UnitConst)
    local_use(c, id, at)
    val declared = result_of(c, id, at)
    val applied = apply(c, at, name_span, function_signature(c, id, declared), args, explicit, expected, typed)
    applied.wrap(at, Call(id, applied.args, applied.type_args))

private function_signature(c: *Checker, id: usize, result: &Type) -> Signature
    val f = c.symbols[id]
    Signature(f.name, true, f.type_params, f.type_owner, f.params, f.param_names, f.defaults, result, buf(), None)

/** The overload a call chooses, if it chooses one, and its arguments as checked while choosing: one
 * entry per written argument, `None` for one left to be checked against the chosen parameter. */
private struct Choice
    id: Option[usize]
    typed: Buf[Option[&TExpr]]

// Chooses among the functions `ids` of one name for a call, or reports why none is chosen.
//
// The candidates are the overloads the arguments can be bound to, by number and by name. The arguments
// are then checked once, on their own, except the ones whose type comes from their parameter: an
// integer literal, a lambda, and an argument some candidate takes by name, which is delayed rather
// than evaluated. An argument that every candidate gives the same type is checked against that type.
// Each candidate is tried against the arguments' types with inference variables of its own, which
// are discarded after, so nothing one candidate decides reaches another; a literal fits a candidate
// whose parameter it can become, and a lambda one whose parameter is a function of as many
// parameters. Of the candidates that fit, the one more specific than each other is chosen: the one
// whose parameter types, for the parameters the arguments are given to, the other accepts.
private choose_overload(c: *Checker, at: Span, name_span: Span, name: string, ids: Buf[usize], args: Buf[Argument], explicit: Option[Buf[&TypeExpr]]) -> Choice
    var signatures: Buf[Signature] = buf()
    for id in ids
        signatures.push(function_signature(c, id, ErrorType))
    choose(c, at, name_span, name, ids, signatures, args, explicit)

// Chooses among the functions `ids`, called through `signatures`: a function's own, or a method's
// past its receiver, with the type arguments its receiver decides already known.
private choose(c: *Checker, at: Span, name_span: Span, name: string, ids: Buf[usize], signatures: Buf[Signature], args: Buf[Argument], explicit: Option[Buf[&TypeExpr]]) -> Choice
    val unit = unit_of(c)
    var written: Buf[&Type] = buf()
    if explicit is Some(types)
        for t in types
            written.push(resolve_type(c, unit, t))
    var bound: Buf[usize] = buf()
    var bound_signatures: Buf[Signature] = buf()
    // Each bound candidate's parameter types with the known type arguments in place.
    var views: Buf[Buf[&Type]] = buf()
    var bindings: Buf[Binding] = buf()
    for i in 0..<ids.len()
        val s = signatures[i]
        if s.type_params.len() - s.known.len() < written.len() then continue
        val binding = bind_arguments(c, at, s, args, false)
        if binding.fits
            bound.push(ids[i])
            bound_signatures.push(s)
            views.push(substitute_all(s.params, s.owner, s.known))
            bindings.push(binding)
    var typed: Buf[Option[&TExpr]] = buf()
    if bound.len() == 0
        c.note(unit, name_span, s"no overload of `$name` accepts these arguments; the overloads are ${overload_list(c, ids)}")
        return Choice(None, typed)
    for j in 0..<args.len()
        val value = args[j].value
        var delayed = false
        var agree = true
        val shared = views[0][bindings[0].targets[j].unwrap()]
        for k in 0..<bound.len()
            val p = views[k][bindings[k].targets[j].unwrap()]
            if *p is ByName(_) then delayed = true
            if bound_signatures[k].type_params.len() > bound_signatures[k].known.len() || !same_type(p, shared) then agree = false
        if value.kind is Lambda(_, _) || is_literal(value) then typed.push(None)
        elif delayed then typed.push(Some(delayed_unchosen(c, args[j], if agree then Some(strict(shared)) else None)))
        else typed.push(Some(check_expr(c, value, if agree then Some(shared) else None)))
    var fitting: Buf[usize] = buf()
    var compared: Buf[Buf[&Type]] = buf()
    for k in 0..<bound.len()
        if !fits_call(c, bound_signatures[k], bindings[k], args, typed, written) then continue
        fitting.push(bound[k])
        var params: Buf[&Type] = buf()
        for t in bindings[k].targets
            params.push(views[k][t.unwrap()])
        compared.push(params)
    if fitting.len() == 0
        c.note(unit, name_span, s"no overload of `$name` accepts these arguments; the overloads are ${overload_list(c, ids)}")
        return Choice(None, typed)
    most_specific(c, fitting, compared) match
        Some(id) -> Choice(Some(id), typed)
        None ->
            literal_preferred(c, fitting, compared, args) match
                Some(id) -> Choice(Some(id), typed)
                None ->
                    c.note(unit, name_span, s"this call to `$name` is ambiguous: ${overload_list(c, fitting)} each accept it, and none is more specific than the others")
                    Choice(None, typed)

// Where no overload is the most specific, the one that takes each integer literal argument as the
// literal's own type: `int`, or `long` for a literal too large for `int`. It must also be the most
// specific one by the arguments that are not literals alone, so the literals break only the ties
// they cause. None when there is no such overload, or more than one.
private literal_preferred(c: *Checker, ids: Buf[usize], compared: Buf[Buf[&Type]], args: Buf[Argument]) -> Option[usize]
    var own: Buf[Option[&Type]] = buf()
    var any_literal = false
    for a in args
        if is_literal(a.value)
            own.push(Some(literal_own_type(a.value)))
            any_literal = true
        else
            own.push(None)
    if !any_literal then return None
    var rest: Buf[Buf[&Type]] = buf()
    var preferred: Buf[usize] = buf()
    for k in 0..<ids.len()
        var others: Buf[&Type] = buf()
        var takes_own = true
        for j in 0..<args.len()
            if own[j] is Some(t)
                if !same_type(strict(compared[k][j]), t) then takes_own = false
            else others.push(compared[k][j])
        rest.push(others)
        if takes_own then preferred.push(k)
    if preferred.len() != 1 then return None
    val a = preferred[0]
    for b in 0..<ids.len()
        if a != b
            if !accepts(c, rest[b], c.symbols[ids[b]].type_owner, c.symbols[ids[b]].type_params.len(), rest[a]) then return None
    Some(ids[a])

// The type an integer literal, possibly negated, has where nothing else decides it.
private literal_own_type(e: &Expr) -> &Type
    var negative = false
    var spelling = ""
    e.kind match
        IntLit(s) -> spelling = s
        Unary(_, operand) ->
            negative = true
            if operand.kind is IntLit(s) then spelling = s
        _ -> ()
    val digits = literal_magnitude(spelling) match
        Some(d) -> d
        None -> return int_type()
    if fits(digits, IntBits, negative) then int_type() else Int(64)

// An argument that some candidate takes by name, checked before the overload is chosen: delayed, as
// that candidate needs it, with the type `inner` when every candidate agrees on it. A candidate that
// takes it strictly evaluates it once, at the call.
private delayed_unchosen(c: *Checker, arg: Argument, inner: Option[&Type]) -> &TExpr
    if inner is Some(t) then return delayed_argument(c, arg, ByName(t), t)
    if arg.value.kind is Name(n)
        if binding_ref(c, arg.value.span, n) is Some(t)
            if *t.ty is ByName(_) then return t
    val delayed = lambda_expr(c, arg.value, buf(), arg.value, None, true)
    val yields: &Type = *delayed.ty match
        Function(_, r) -> r
        _ -> ErrorType
    TExpr(arg.value.span, ByName(yields), delayed.kind)

// The one of `ids` more specific than each other one: its parameter types `compared[k]` are accepted
// by every other's. None when no single one is: when none is, or when two accept each other's.
private most_specific(c: *Checker, ids: Buf[usize], compared: Buf[Buf[&Type]]) -> Option[usize]
    var best: Buf[usize] = buf()
    for a in 0..<ids.len()
        var wins = true
        for b in 0..<ids.len()
            if a != b && wins
                if !accepts(c, compared[b], c.symbols[ids[b]].type_owner, c.symbols[ids[b]].type_params.len(), compared[a]) then wins = false
        if wins then best.push(ids[a])
    if best.len() == 1 then Some(best[0]) else None

// Whether one candidate of an overloaded call accepts its arguments: those already typed, then the
// literals and lambdas, by what their parameter types allow.
private fits_call(c: *Checker, s: Signature, binding: Binding, args: Buf[Argument], typed: Buf[Option[&TExpr]], written: Buf[&Type]) -> bool
    val saved = save_vars(c)
    var type_args: Buf[&Type] = buf()
    for i in 0..<s.type_params.len()
        type_args.push(if i < s.known.len() then s.known[i] else fresh_var(c))
    for i in 0..<written.len()
        unify(c, type_args[s.known.len() + i], written[i])
    var ok = true
    for j in 0..<args.len()
        if typed[j] is Some(t)
            val p = strict(substitute(s.params[binding.targets[j].unwrap()], s.owner, type_args))
            if ok && !(*t.ty is Nothing) && !unify(c, p, strict(t.ty)) then ok = false
    for j in 0..<args.len()
        if ok && typed[j] is None
            val p = zonk(c, strict(substitute(s.params[binding.targets[j].unwrap()], s.owner, type_args)))
            if !open_argument_fits(args[j].value, p) then ok = false
    restore_vars(c, saved)
    ok

// Whether a literal or a lambda, which takes its type from its parameter, can be given one of type
// `p`.
private open_argument_fits(value: &Expr, p: &Type) -> bool
    if *p is Var(_) || *p is ErrorType then return true
    if is_literal(value) then return literal_fits(value, p)
    value.kind match
        Lambda(params, _) -> *p match
            Function(ps, _) -> ps.len() == params.len()
            _ -> false
        _ -> true

// Whether an integer literal, possibly negated, can be a value of type `t`, as `integer_literal`
// would make it.
private literal_fits(e: &Expr, t: &Type) -> bool
    var negative = false
    var spelling = ""
    e.kind match
        IntLit(s) -> spelling = s
        Unary(_, operand) ->
            negative = true
            if operand.kind is IntLit(s) then spelling = s
        _ -> return true
    val digits = literal_magnitude(spelling) match
        Some(d) -> d
        None -> return true
    *t match
        Int(bits) -> fits(digits, bits, negative)
        Byte -> !(negative && digits != "0") && compare_decimal(digits, "255") <= 0
        Real -> compare_decimal(digits, "9007199254740992") <= 0
        _ -> false

/** The overloads `ids` as written, for a diagnostic: "`f(x: int)`, `f(s: string)`". */
private overload_list(c: *Checker, ids: Buf[usize]) -> string
    var out = ""
    for k in 0..<ids.len()
        if k > 0 then out = out + ", "
        val f = c.symbols[ids[k]]
        var text = f.name
        if f.type_params.len() > 0
            text = text + "["
            for i in 0..<f.type_params.len()
                if i > 0 then text = text + ", "
                text = text + f.type_params[i].name
            text = text + "]"
        text = text + "("
        // A method's receiver is not written among its parameters.
        val first = if is_method(f) then 1usize else 0usize
        for i in first..<f.params.len()
            if i > first then text = text + ", "
            text = text + f.param_names[i] + ": " + type_name(f.params[i])
        out = out + "`" + text + ")`"
    out

// `object.name(args)`: a method of the object's class, or a field holding a function, which is
// called as a value.
private member_call(c: *Checker, at: Span, callee: &Expr, name_span: Span, target: &Expr, name: string, args: Buf[Argument], explicit: Option[Buf[&TypeExpr]], expected: Option[&Type], infix: bool) -> &TExpr
    val unit = unit_of(c)
    if target.kind is Name("super")
        if lookup_local(c, "super") is None && enclosing_class(c) is Some(_)
            return super_call(c, at, name_span, target.span, name, args, explicit, expected)
    val object = check_expr(c, target, None)
    if *zonk(c, object.ty) is Class(k, _, _)
        val ms = methods_named(c, k, name)
        if ms.len() > 0
            if infix && !takes_one_argument(c, ms) then return infix_arity_error(c, at, name_span, target, name, ms, args)
            return call_method(c, at, name_span, object, name, ms, args, explicit, expected, false)
        if method_named(c, k, name) is Some(m)
            c.note(unit, name_span, s"`$name` is private to `${c.classes[c.symbols[m].owner_class.unwrap()].name}`")
            for a in args
                check_statement(c, a.value)
            return TExpr(at, ErrorType, UnitConst)
    // A value of a type parameter has the methods of its bounds, and no others.
    if *zonk(c, object.ty) is TypeVar(_, _, _)
        val ty = zonk(c, object.ty)
        val ms = bound_methods(c, ty, name)
        if ms.len() > 0
            if infix && !takes_one_argument(c, ms) then return infix_arity_error(c, at, name_span, target, name, ms, args)
            return call_method(c, at, name_span, object, name, ms, args, explicit, expected, false)
        if bound_field(c, ty, name) is None && bound_class_field(c, ty, name) is None
            no_bound_member(c, name_span, ty, name)
            for a in args
                check_statement(c, a.value)
            return TExpr(at, ErrorType, UnitConst)
    val all = receiver_methods(c, zonk(c, object.ty), name)
    if all.len() > 0
        val ms = visible_methods(c, all)
        if ms.len() == 0
            c.note(unit, name_span, s"`$name` is private to the impls of `${type_name(c.symbols[all[0]].receiver.unwrap())}`")
            for a in args
                check_statement(c, a.value)
            return TExpr(at, ErrorType, UnitConst)
        if infix && !takes_one_argument(c, ms) then return infix_arity_error(c, at, name_span, target, name, ms, args)
        return call_method(c, at, name_span, object, name, ms, args, explicit, expected, false)
    if infix
        if !(*zonk(c, object.ty) is ErrorType)
            c.note(unit, name_span, s"`${type_name(zonk(c, object.ty))}` has no method `$name` to call infix")
        for a in args
            check_statement(c, a.value)
        return TExpr(at, ErrorType, UnitConst)
    if explicit is Some(_)
        for a in args
            check_statement(c, a.value)
        return unsupported(c, callee, "type arguments on a call of a field")
    call_checked(c, at, name_span, member_of(c, callee, object, name, None), args)

// `a m b` is the call `a.m(b)`. It names a method of `a`'s type: a field holding a function and a
// function `m` of two parameters are not called infix.
private infix_call(c: *Checker, at: Span, target: &Expr, name: string, name_span: Span, arg: &Expr, expected: Option[&Type]) -> &TExpr
    var args: Buf[Argument] = buf()
    args.push(Argument(arg.span, None, arg))
    val callee = Expr(target.span.to(name_span), Member(target, name))
    member_call(c, at, callee, name_span, target, name, args, None, expected, true)

// Whether one of the methods `ms` can be called with exactly one argument.
private takes_one_argument(c: *Checker, ms: Buf[usize]) -> bool
    for m in ms
        val s = c.symbols[m]
        var required = 0usize
        for i in 1..<s.params.len()
            if i >= s.defaults.len() || s.defaults[i] is None then required += 1
        if required <= 1 && s.params.len() >= 2 then return true
    false

// An infix call of a method that takes some other number of arguments. A tuple written as the
// argument is spelled back as the arguments of a dotted call.
private infix_arity_error(c: *Checker, at: Span, name_span: Span, target: &Expr, name: string, ms: Buf[usize], args: Buf[Argument]) -> &TExpr
    val unit = unit_of(c)
    val count = c.symbols[ms[0]].params.len() - 1
    val src = c.units[unit].src
    val receiver = from_utf8_unchecked(src.text(target.span))
    var inner = "…"
    if args[0].value.kind is Tuple(items)
        inner = ""
        for i in 0..<items.len()
            if i > 0 then inner = inner + ", "
            inner = inner + from_utf8_unchecked(src.text(items[i].span))
    elif count == 0 then inner = ""
    val counted = if count == 1 then "1 argument" else s"$count arguments"
    c.note(unit, name_span, s"`$name` takes $counted, and only a method of one argument is called infix; write `$receiver.$name($inner)`")
    for a in args
        check_statement(c, a.value)
    TExpr(at, ErrorType, UnitConst)

// `super.name(args)` calls the superclass's implementation of a method on `self`, directly, even where
// the class overrides it.
private super_call(c: *Checker, at: Span, name_span: Span, super_span: Span, name: string, args: Buf[Argument], explicit: Option[Buf[&TypeExpr]], expected: Option[&Type]) -> &TExpr
    val unit = unit_of(c)
    val k = enclosing_class(c).unwrap()
    var ms: Buf[usize] = buf()
    var sup: &Type = ErrorType
    if c.classes[k].superclass is Some(t)
        sup = t
        if *t is Class(s, _, _)
            ms = methods_named(c, s, name)
            if ms.len() == 0 then c.note(unit, name_span, s"`${c.classes[s].name}` has no method `$name` for `super` to call")
    else c.note(unit, super_span, s"`${c.classes[k].name}` has no superclass for `super` to name")
    if c.super_args
        c.note(unit, super_span, "a superclass's arguments cannot call a method: they run before the object is initialized")
        ms = buf()
    if ms.len() == 0
        for a in args
            check_statement(c, a.value)
        return TExpr(at, ErrorType, UnitConst)
    val self_value = self_ref(c, super_span)
    val receiver = TExpr(super_span, sup, self_value.kind)
    val choice = pick_method(c, at, name_span, receiver, name, ms, args, explicit)
    val m = choice.id match
        Some(m) -> m
        None -> return TExpr(at, ErrorType, UnitConst)
    if is_abstract_method(c.symbols[m])
        c.note(unit, name_span, s"`${c.symbols[m].name}` is abstract, so `super` cannot call it")
        for i in 0..<args.len()
            if i >= choice.typed.len() || choice.typed[i] is None then check_statement(c, args[i].value)
        return TExpr(at, ErrorType, UnitConst)
    method_call(c, at, name_span, receiver, m, args, explicit, expected, true, choice.typed)

// The method of `ms`, the methods of `name` the receiver's type has, that a call chooses, and its
// arguments as checked while choosing. One method is chosen without looking at the arguments.
private pick_method(c: *Checker, at: Span, name_span: Span, receiver: &TExpr, name: string, ms: Buf[usize], args: Buf[Argument], explicit: Option[Buf[&TypeExpr]]) -> Choice
    if ms.len() == 1 || *receiver.ty is Nothing then return Choice(Some(ms[0]), buf())
    var signatures: Buf[Signature] = buf()
    for m in ms
        signatures.push(method_signature(c, receiver, m, ErrorType))
    choose(c, at, name_span, name, ms, signatures, args, explicit)

// A call of a method of `name` on `receiver`, chosen among the overloads `ms` its type has.
private call_method(c: *Checker, at: Span, name_span: Span, receiver: &TExpr, name: string, ms: Buf[usize], args: Buf[Argument], explicit: Option[Buf[&TypeExpr]], expected: Option[&Type], direct: bool) -> &TExpr
    val choice = pick_method(c, at, name_span, receiver, name, ms, args, explicit)
    choice.id match
        Some(m) -> method_call(c, at, name_span, receiver, m, args, explicit, expected, direct, choice.typed)
        None -> TExpr(at, ErrorType, UnitConst)

// A method's signature as a call on `receiver` sees it: its parameters past the receiver, and the
// type arguments of its class, or of the data type its impl adds it to, known from the receiver's
// type. An inherited method's types name its own class's parameters, so the receiver is seen as an
// instance of that class. Its defaults are computed from the receiver, which is passed to each.
private method_signature(c: *Checker, receiver: &TExpr, m: usize, result: &Type) -> Signature
    val target = c.symbols[m]
    val known = receiver_type_args(c, receiver.ty, m)
    var params: Buf[&Type] = buf()
    var names: Buf[string] = buf()
    var defaults: Buf[Option[usize]] = buf()
    for i in 1..<target.params.len()
        params.push(with_self(c, m, receiver.ty, target.params[i]))
        names.push(target.param_names[i])
        defaults.push(if i < target.defaults.len() then target.defaults[i] else None)
    Signature(target.decl.name, true, target.type_params, target.type_owner, params, names, defaults, with_self(c, m, receiver.ty, result), known, Some(receiver))

/** Type `t` of method `m` with the `Self` of a trait declaring `m` as the receiver's type. */
private with_self(c: *Checker, m: usize, receiver_type: &Type, t: &Type) -> &Type
    val k = c.symbols[m].owner_class match
        Some(k) -> k
        None -> return t
    if !is_trait(c, k) then return t
    var implementer: Buf[&Type] = buf()
    implementer.push(zonk(c, receiver_type))
    substitute(t, self_owner(k), implementer)

// A method call passes the receiver first. The class's type arguments come from the receiver's
// type, and the method's own, which follow them, are written or inferred as for a function.
private method_call(c: *Checker, at: Span, name_span: Span, receiver: &TExpr, m: usize, args: Buf[Argument], explicit: Option[Buf[&TypeExpr]], expected: Option[&Type], direct: bool, checked: Buf[Option[&TExpr]]) -> &TExpr
    val target = c.symbols[m]
    if *receiver.ty is Nothing
        for i in 0..<args.len()
            if i >= checked.len() || checked[i] is None then check_statement(c, args[i].value)
        return receiver
    // The receiver is evaluated before the arguments, so one that is computed is held while they are.
    var setup: Option[&TExpr] = None
    var object = receiver
    if !(receiver.kind is Local(_) || receiver.kind is Param(_))
        val held = hidden_local(c, receiver.ty)
        setup = Some(TExpr(receiver.span, Unit, Let(held, receiver)))
        object = TExpr(receiver.span, receiver.ty, Local(held))
    val applied = apply(c, at, name_span, method_signature(c, object, m, result_of(c, m, at)), args, explicit, expected, checked)
    var typed: Buf[&TExpr] = buf()
    typed.push(object)
    for a in applied.args
        typed.push(a)
    val call = applied.wrap(at, method_call_kind(c, receiver.ty, m, typed, applied.type_args, direct))
    setup match
        Some(s) ->
            var items: Buf[&TExpr] = buf()
            items.push(s)
            items.push(call)
            TExpr(at, call.ty, Block(items))
        None -> call

// The type arguments of method `m`'s class, or of the data type an impl adds it to, as a receiver of
// type `receiver_type` has them. An inherited method's types name its own class's parameters, so the
// receiver is seen as an instance of that class.
private receiver_type_args(c: *Checker, receiver_type: &Type, m: usize) -> Buf[&Type]
    val t = zonk(c, receiver_type)
    // A type parameter has the methods of its bounds, as an instance of them.
    if *t is TypeVar(_, _, _)
        if c.symbols[m].owner_class is Some(k)
            for b in bounds_of(c, t)
                if ancestor_type(c.classes, c.data, b, k) is Some(up)
                    if *up is Class(_, _, a) then return a
        return buf()
    c.symbols[m].owner_class match
        Some(k) -> *ancestor_type(c.classes, c.data, t, k).unwrap_or(t) match
            Class(_, _, a) -> a
            _ -> buf()
        None -> *t match
            Data(_, _, a) -> a
            _ -> buf()

// A method a subclass may override is called through the object's method table, unless the
// receiver's class is final, so the method is known. Through a trait, the method is at the trait's
// position in the table of whatever class the object has.
private dispatch_slot(c: *Checker, receiver_type: &Type, m: usize) -> Option[usize]
    if *zonk(c, receiver_type) is Class(r, _, _)
        if is_trait(c, r) then return Some(trait_slot(c, m))
        if is_open(c, r) then return table_position(c, r, m)
    None

// How a call of method `m` on a receiver of type `receiver_type` is made, with `args` the receiver
// and the arguments. A `super` call names its method directly, even where the class overrides it.
// On a type parameter the call goes to the method of whatever type each instance has: it is placed
// at the position the method has in every table that holds it.
private method_call_kind(c: *Checker, receiver_type: &Type, m: usize, args: Buf[&TExpr], type_args: Buf[&Type], direct: bool) -> TExprKind
    if direct then return Call(m, args, type_args)
    if *zonk(c, receiver_type) is TypeVar(_, _, _) then return BoundCall(m, bound_slot(c, m), args, type_args)
    dispatch_slot(c, receiver_type, m) match
        Some(s) -> Dispatch(m, s, args, type_args)
        None -> Call(m, args, type_args)

// The table position of a method reached through a bound: a trait's, or an open class's when the
// method may be overridden. A final class's method is the one called.
private bound_slot(c: *Checker, m: usize) -> Option[usize]
    val k = c.symbols[m].owner_class?
    if is_trait(c, k) then return Some(trait_slot(c, m))
    if is_open(c, k) then return table_position(c, k, m)
    None

/** A value made by a variant: a call of the variant with its fields, or the variant's bare name
 * when it has none. */
private construct(c: *Checker, at: Span, name_span: Span, v: VariantRef, args: Buf[Argument], explicit: Option[Buf[&TypeExpr]], expected: Option[&Type]) -> &TExpr
    val d = c.data[v.data]
    val variant = d.variants[v.index]
    val called = variant.fields.len() > 0
    var defaults: Buf[Option[usize]] = buf()
    for _ in variant.fields
        defaults.push(None)
    val signature = Signature(variant.name, called, d.decl.type_params, data_owner(v.data), variant.fields, variant.field_names, defaults, own_type(d, v.data), buf(), None)
    val applied = apply(c, at, name_span, signature, args, explicit, expected, buf())
    applied.wrap(at, Construct(v.index, applied.args))

/** What a call is checked against: a function's or a variant's parameters and result, written in
 * terms of the type parameters `type_params` that belong to `owner`. `called` is false for a variant
 * with no fields, which is written without parentheses. `defaults` names, for each parameter with a
 * default, the function that computes it. */
private struct Signature
    name: string
    called: bool
    type_params: Buf[TypeParam]
    owner: usize
    params: Buf[&Type]
    names: Buf[string]
    defaults: Buf[Option[usize]]
    result: &Type
    /** Leading type arguments already decided, a method's class's from its receiver; written type
     * arguments follow them. */
    known: Buf[&Type]
    /** A method's receiver, as the call holds it: its defaults take it before the parameters. */
    receiver: Option[&TExpr]

/** A call's arguments, one per parameter in parameter order, its solved type arguments, and its
 * result type. `prelude` evaluates what the call needs first: the written arguments in the order
 * written, then the omitted ones' defaults; when an argument never finishes, the prelude ends with it
 * and there is no call. */
private struct Applied
    args: Buf[&TExpr]
    type_args: Buf[&Type]
    result: &Type
    prelude: Buf[&TExpr]
    cut: bool

    /** The call made by `kind`, after the prelude. */
    wrap(self, at: Span, kind: TExprKind) -> &TExpr
        if self.cut then return TExpr(at, Nothing, Block(self.prelude))
        val call = TExpr(at, self.result, kind)
        if self.prelude.len() == 0 then return call
        var items: Buf[&TExpr] = buf()
        for p in self.prelude
            items.push(p)
        items.push(call)
        TExpr(at, self.result, Block(items))
end Applied

/** Which written argument each parameter takes. `slots` has one entry per parameter: the index of
 * its argument, or `None` when it is left to its default. `targets` has one per written argument:
 * the parameter it is given to, or `None` when it fits none. `fits` is false when the call cannot be
 * made, already reported. */
private struct Binding
    slots: Buf[Option[usize]]
    targets: Buf[Option[usize]]
    fits: bool

// Matches a call's arguments to a signature's parameters: positional arguments first, in order, then
// named ones, each naming a parameter not already given; a parameter given nothing must have a
// default. This is the step that decides whether a call fits a signature; with `report` false it
// only answers, which is how a candidate overload is tried.
private bind_arguments(c: *Checker, at: Span, s: Signature, args: Buf[Argument], report: bool) -> Binding
    val unit = unit_of(c)
    val noun = if s.owner >= data_owner(0) then "field" else "parameter"
    var slots: Buf[Option[usize]] = buf()
    for _ in s.params
        slots.push(None)
    var targets: Buf[Option[usize]] = buf()
    var fits = true
    var named = false
    var positional = 0usize
    for j in 0..<args.len()
        val a = args[j]
        a.name match
            None ->
                if named
                    if report then c.note(unit, a.span, "a positional argument cannot follow a named one")
                    fits = false
                    targets.push(None)
                    continue
                positional += 1
                if j < s.params.len()
                    slots.set(j, Some(j))
                    targets.push(Some(j))
                else targets.push(None)
            Some(n) ->
                named = true
                var k: Option[usize] = None
                for i in 0..<s.names.len()
                    if s.names[i] == n && n != "_" then k = Some(i)
                k match
                    None ->
                        if report then c.note(unit, a.span, s"`${s.name}` has no $noun `$n`")
                        fits = false
                        targets.push(None)
                    Some(i) ->
                        if slots[i] is Some(_)
                            if report then c.note(unit, a.span, s"`$n` is given more than once")
                            fits = false
                            targets.push(None)
                        else
                            slots.set(i, Some(j))
                            targets.push(Some(i))
    var has_defaults = false
    for d in s.defaults
        if d is Some(_) then has_defaults = true
    if positional > s.params.len()
        if report then c.note(unit, at, s"`${s.name}` takes ${count(s.params.len(), "argument")}, not $positional")
        return Binding(slots, targets, false)
    // A call already reported for a misplaced or misnamed argument is not also reported for the
    // parameter that argument was probably meant for.
    if !fits then return Binding(slots, targets, false)
    var missing: Buf[string] = buf()
    for i in 0..<s.params.len()
        if slots[i] is None && s.defaults[i] is None then missing.push(s.names[i])
    if missing.len() > 0
        fits = false
        if !report then return Binding(slots, targets, false)
        if !named && !has_defaults
            c.note(unit, at, s"`${s.name}` takes ${count(s.params.len(), "argument")}, not ${args.len()}")
        else
            for m in missing
                c.note(unit, at, s"`${s.name}` needs an argument for `$m`, which has no default")
    Binding(slots, targets, fits)

// Checks a call against a signature: binds its arguments to the parameters, solves the type
// arguments, and checks each argument against its parameter's type. `checked` holds, for an
// overloaded call, the arguments checked while its overload was chosen; it is empty otherwise.
private apply(c: *Checker, at: Span, name_span: Span, s: Signature, args: Buf[Argument], explicit: Option[Buf[&TypeExpr]], expected: Option[&Type], checked: Buf[Option[&TExpr]]) -> Applied
    val unit = unit_of(c)
    val name = s.name
    val called = s.called
    val type_params = s.type_params
    val owner = s.owner
    val params = s.params
    val result = s.result
    val known = s.known
    val binding = bind_arguments(c, at, s, args, true)
    val first = c.vars.len()
    var type_args: Buf[&Type] = buf()
    for i in 0..<type_params.len()
        type_args.push(if i < known.len() then known[i] else fresh_var(c))
    // Written type arguments may be a leading prefix, with the rest inferred.
    if explicit is Some(types)
        val unknown = type_params.len() - known.len()
        if types.len() > unknown
            c.note(unit, name_span, s"`$name` takes ${count(unknown, "type argument")}, not ${types.len()}")
        else
            for i in 0..<types.len()
                unify(c, type_args[known.len() + i], resolve_type(c, unit, types[i]))
    val wanted = substitute_all(params, owner, type_args)
    val declared = substitute(result, owner, type_args)
    if expected is Some(want) then unify(c, declared, want)
    var targets: Buf[Option[&Type]] = buf()
    for t in binding.targets
        targets.push(if t is Some(i) then Some(wanted[i]) else None)
    val typed = check_arguments(c, args, targets, checked)
    // A type argument the arguments settled settles those its bounds name: `[S: Source[A], A]`
    // takes `A` from the source `S` is.
    for i in known.len()..<type_params.len()
        val arg = zonk(c, type_args[i])
        if *arg is Var(_) then continue
        for b in bounds_at(c, owner, type_params, i)
            val bound = substitute(b, owner, type_args)
            if *bound is Class(bk, _, _)
                if ancestor_type(c.classes, c.data, arg, bk) is Some(up) then unify(c, up, bound)
    var solved: Buf[&Type] = buf()
    for i in 0..<type_args.len()
        val t = zonk(c, type_args[i])
        // An unknown that belongs to an enclosing call, as in `f(None, 'z')`, is that call's to
        // settle, and code generation reads its final solution.
        var mine = false
        if *t is Var(v) then mine = v >= first
        if mine && *t is Var(v)
            val subject = if called then s"this call to `$name`" else s"this `$name`"
            val example = if called then s"`$name[int](…)`" else s"`$name[int]`"
            c.note(unit, name_span, s"cannot infer `${type_params[i].name}` for $subject; write it, as in $example")
            c.vars.set(v, Some(ErrorType))
            solved.push(ErrorType)
        else solved.push(t)
    // The type arguments written or inferred conform to their parameters' bounds; those the receiver
    // gives were held to them where its type was made.
    hold_to_bounds(c, unit, name_span, s"`$name`", owner, type_params, solved, known.len())
    var ty = zonk(c, declared)
    for t in typed
        if *t.ty is Nothing then ty = Nothing
    // Arguments written in parameter order with none omitted are passed as they are; otherwise each
    // written argument is held in a local, in the order written, and the omitted ones' defaults are
    // computed after them, in parameter order, each from the parameters before it.
    var direct = binding.fits
    for i in 0..<binding.slots.len()
        binding.slots[i] match
            Some(j) -> if j != i then direct = false
            None -> direct = false
    if direct || !binding.fits then return Applied(typed, solved, ty, buf(), false)
    var prelude: Buf[&TExpr] = buf()
    var held: Buf[Option[&TExpr]] = buf()
    for _ in params
        held.push(None)
    for j in 0..<typed.len()
        val t = typed[j]
        prelude.push(t)
        if *t.ty is Nothing then return Applied(buf(), solved, Nothing, prelude, true)
        val local = hidden_local(c, t.ty)
        prelude.set(prelude.len() - 1, TExpr(t.span, Unit, Let(local, t)))
        held.set(binding.targets[j].unwrap(), Some(TExpr(t.span, t.ty, Local(local))))
    var passed: Buf[&TExpr] = buf()
    for i in 0..<params.len()
        held[i] match
            Some(value) -> passed.push(value)
            None ->
                val default = s.defaults[i].unwrap()
                local_use(c, default, at)
                var before: Buf[&TExpr] = buf()
                if s.receiver is Some(r) then before.push(r)
                for k in 0..<i
                    before.push(passed[k])
                val wanted_ty = zonk(c, wanted[i])
                val local = hidden_local(c, wanted_ty)
                prelude.push(TExpr(at, Unit, Let(local, TExpr(at, wanted_ty, Call(default, before, default_type_args(c, s, default, solved))))))
                passed.push(TExpr(at, wanted_ty, Local(local)))
    Applied(passed, solved, ty, prelude, false)

// The type arguments of a call of `default`, a default of the function `s` describes, made by a call
// that solved `solved`. A method that overrides another takes that one's defaults, which belong to the
// overridden method's class or trait, so they take the type arguments the receiver has as an instance
// of that class.
private default_type_args(c: *Checker, s: Signature, default: usize, solved: Buf[&Type]) -> Buf[&Type]
    if s.receiver is Some(r)
        if c.symbols[default].type_owner != s.owner then return receiver_type_args(c, r.ty, default)
    solved

// Checks a call's arguments against their parameters' types, in an order that lets each argument use
// what the others decide: first the arguments that are neither bare literals nor lambdas, then the
// literals, which take the types the others settle, and last the lambdas, whose parameter types
// come from all of them. `wanted` has an entry per argument, `None` for one that fits no parameter.
// An argument with an entry in `checked` was checked already, and only its type is matched here.
private check_arguments(c: *Checker, args: Buf[Argument], wanted: Buf[Option[&Type]], checked: Buf[Option[&TExpr]]) -> Buf[&TExpr]
    var early: Buf[Option[&TExpr]] = buf()
    for _ in args
        early.push(None)
    for pass in 0..<3
        for i in 0..<args.len()
            val value = args[i].value
            val param = if i < wanted.len() then wanted[i] else None
            if i < checked.len()
                if checked[i] is Some(given)
                    if pass == 0
                        var t = given
                        // An argument delayed for a candidate that takes it by name is evaluated
                        // once, at the call, by one that takes it strictly.
                        if param is Some(p)
                            if *given.ty is ByName(_) && !(*zonk(c, p) is ByName(_)) then t = evaluated(given)
                            if !(*t.ty is Nothing) && !unify(c, p, t.ty)
                                c.note(unit_of(c), value.span, s"expected ${type_name(zonk(c, p))}, found ${type_name(t.ty)}")
                        early.set(i, Some(t))
                    continue
            val rank = if value.kind is Lambda(_, _) then 2 elif is_literal(value) then 1 else 0
            if rank != pass then continue
            early.set(i, Some(call_argument(c, args[i], param)))
    var typed: Buf[&TExpr] = buf()
    for t in early
        typed.push(t.unwrap())
    typed

// A use of a local function, by a call or as a value, needs what the function captures where it is
// used; a use before the function's declaration needs those captures initialized already.
private local_use(c: *Checker, id: usize, at: Span)
    if c.symbols[id].root is None then return
    c.body.calls.push(LocalCall(c.current, id))
    if c.states[id] == 0
        var initialized: Buf[usize] = buf()
        for v in c.body.visible
            initialized.push(v)
        c.body.early.push(EarlyCall(id, at, initialized))

// A function used as a value by name. An overloaded name takes its overload from the expected
// function type: of the overloads whose parameters accept that type's, the most specific.
private named_function_value(c: *Checker, at: Span, name: string, explicit: Option[Buf[&TypeExpr]], expected: Option[&Type]) -> &TExpr
    val ids = lookup_functions(c, name)
    if ids.len() == 1 then return function_value(c, at, ids[0], explicit, expected)
    val unit = unit_of(c)
    var wanted: Option[Buf[&Type]] = None
    if expected is Some(t)
        if *zonk(c, t) is Function(ps, _) then wanted = Some(ps)
    val params = wanted match
        Some(ps) -> ps
        None ->
            c.note(unit, at, s"`$name` is overloaded, so it is used as a value only where a function type is expected, which chooses among ${overload_list(c, ids)}")
            return TExpr(at, ErrorType, UnitConst)
    var fitting: Buf[usize] = buf()
    var compared: Buf[Buf[&Type]] = buf()
    for id in ids
        val f = c.symbols[id]
        if accepts(c, f.params, f.type_owner, f.type_params.len(), params)
            fitting.push(id)
            compared.push(f.params)
    if fitting.len() == 0
        c.note(unit, at, s"no overload of `$name` has the parameter types of ${type_name(zonk(c, expected.unwrap()))}; the overloads are ${overload_list(c, ids)}")
        return TExpr(at, ErrorType, UnitConst)
    most_specific(c, fitting, compared) match
        Some(id) -> function_value(c, at, id, explicit, expected)
        None ->
            c.note(unit, at, s"`$name` used as ${type_name(zonk(c, expected.unwrap()))} is ambiguous: ${overload_list(c, fitting)} each accept it")
            TExpr(at, ErrorType, UnitConst)

// A named function used as a value. A generic one is instantiated as a call would be, with its type
// arguments written or decided by the expected function type.
private function_value(c: *Checker, at: Span, id: usize, explicit: Option[Buf[&TypeExpr]], expected: Option[&Type]) -> &TExpr
    val unit = unit_of(c)
    val target = c.symbols[id]
    local_use(c, id, at)
    val result = result_of(c, id, at)
    val type_params = target.type_params
    val first = c.vars.len()
    var type_args: Buf[&Type] = buf()
    for _ in type_params
        type_args.push(fresh_var(c))
    if explicit is Some(types)
        if types.len() > type_params.len()
            c.note(unit, at, s"`${target.name}` takes ${count(type_params.len(), "type argument")}, not ${types.len()}")
            for t in type_args
                unify(c, t, ErrorType)
        else
            for i in 0..<types.len()
                unify(c, type_args[i], resolve_type(c, unit, types[i]))
    val declared: &Type = Function(target.params, result)
    val ty = substitute(declared, target.type_owner, type_args)
    if expected is Some(want) then unify(c, ty, want)
    var solved: Buf[&Type] = buf()
    for i in 0..<type_args.len()
        val t = zonk(c, type_args[i])
        if *t is Var(v)
            if v >= first
                c.note(unit, at, s"cannot infer `${type_params[i].name}` for `${target.name}` used as a value; write it, as in `${target.name}[int]`")
                c.vars.set(v, Some(ErrorType))
        solved.push(zonk(c, t))
    c.symbols[id].value = true
    TExpr(at, zonk(c, ty), FunctionValue(id, solved))

// A call of a value of a function type: a local, a parameter, or any expression that yields a
// function.
private value_call(c: *Checker, at: Span, callee: &Expr, args: Buf[Argument]) -> &TExpr = call_checked(c, at, callee.span, check_expr(c, callee, None), args)

private call_checked(c: *Checker, at: Span, callee_span: Span, f: &TExpr, args: Buf[Argument]) -> &TExpr
    val unit = unit_of(c)
    val ty = zonk(c, f.ty)
    // Only a declaration's parameters have names and defaults; a function value is called with its
    // arguments by position.
    for a in args
        if a.name is Some(n) then c.note(unit, a.span, s"a function value takes its arguments by position, so `$n` cannot be named")
    *ty match
        Function(params, result) ->
            var wanted: Buf[Option[&Type]] = buf()
            for p in params
                wanted.push(Some(p))
            val typed = check_arguments(c, args, wanted, buf())
            if args.len() != params.len()
                c.note(unit, at, s"this function takes ${count(params.len(), "argument")}, not ${args.len()}")
            var r = zonk(c, result)
            for t in typed
                if *t.ty is Nothing then r = Nothing
            TExpr(at, r, CallValue(f, typed))
        _ ->
            if settled(ty) then c.note(unit, callee_span, s"a value of type ${type_name(ty)} cannot be called; only a function can")
            for a in args
                check_statement(c, a.value)
            TExpr(at, if *ty is Nothing then Nothing else ErrorType, UnitConst)

// A lambda is an anonymous local function, checked where it is written. Its parameter types are
// written or come from the function type expected there, and its result type comes from that type
// or from its body.
private lambda_expr(c: *Checker, e: &Expr, params: Buf[LambdaParam], body: &Expr, expected: Option[&Type], delayed: bool) -> &TExpr
    val unit = unit_of(c)
    var wanted: Buf[&Type] = buf()
    var wanted_result: Option[&Type] = None
    var mismatched = false
    if expected is Some(want)
        val known = zonk(c, want)
        if *known is Function(ps, r)
            if ps.len() == params.len()
                wanted = ps
                wanted_result = Some(r)
            else
                c.note(unit, e.span, s"expected a function of ${count(ps.len(), "parameter")}, but this lambda takes ${params.len()}")
                mismatched = true
    var types: Buf[&Type] = buf()
    var names: Buf[string] = buf()
    for i in 0..<params.len()
        val p = params[i]
        names.push(p.name)
        var ty: &Type = ErrorType
        p.declared match
            Some(d) ->
                ty = resolve_type(c, unit, d)
                if i < wanted.len()
                    if !unify(c, wanted[i], ty)
                        c.note(unit, p.span, s"`${p.name}` is declared ${type_name(ty)}, but this lambda is expected to take ${type_name(zonk(c, wanted[i]))}")
                        ty = ErrorType
            None ->
                val known: &Type = if i < wanted.len() then zonk(c, wanted[i]) else Var(0)
                if i < wanted.len() && !has_unknowns(known) then ty = known
                elif !mismatched then c.note(unit, p.span, s"cannot infer the type of `${p.name}`; write it, as in `(${p.name}: int) -> …`")
        types.push(ty)
    var result: Option[&Type] = None
    if wanted_result is Some(r)
        val known = zonk(c, r)
        if !has_unknowns(known) then result = Some(known)
    val enclosing = c.symbols[c.current]
    val decl = Function(buf(), e.span, e.span, "lambda", buf(), buf(), None, Some(body), buf())
    val id = c.symbols.len()
    c.symbols.push(FunctionSymbol(enclosing.unit, enclosing.module_name, "lambda", decl, types, names, result, None, Some(c.body.root), buf(), buf(), buf(), true, delayed, true, buf(), None, id, buf(), None, false, true, "", None))
    c.states.push(1)
    c.bodies.push(None)
    c.locals.push(buf())
    // Checked as a local function is: its parameters are locals of its own, and loops outside it are
    // not its loops.
    val previous = c.current
    val loops = c.body.loops
    val outer_start = c.body.block_start
    val mark = c.body.visible.len()
    c.current = id
    c.body.loops = buf()
    c.body.block_start = mark
    var param_locals: Buf[usize] = buf()
    for i in 0..<params.len()
        param_locals.push(declare_local(c, params[i].span, names[i], types[i], false))
    c.symbols[id].param_locals = param_locals
    check_body(c, id, body)
    c.body.visible.truncate(mark)
    c.body.block_start = outer_start
    c.body.loops = loops
    c.current = previous
    c.states.set(id, 2)
    // Making the closure needs everything the lambda captures where it is written.
    c.body.calls.push(LocalCall(previous, id))
    val yields = c.symbols[id].result.unwrap_or(ErrorType)
    if result is None
        if wanted_result is Some(r) then unify(c, r, yields)
    val ty: &Type = if mismatched then ErrorType else Function(types, yields)
    TExpr(e.span, ty, FunctionValue(id, buf()))

// Checks one argument against its parameter type, which may still contain unknowns; the argument's
// type decides them.
private call_argument(c: *Checker, arg: Argument, param: Option[&Type]) -> &TExpr
    val unit = unit_of(c)
    var wanted: Option[&Type] = None
    if param is Some(p)
        val known = zonk(c, p)
        if !(*known is Var(_)) then wanted = Some(known)
    if param is Some(p)
        if *zonk(c, p) is ByName(inner) then return delayed_argument(c, arg, p, inner)
    val value = check_expr(c, arg.value, wanted)
    if param is Some(p)
        if !(*value.ty is Nothing) && !unify(c, p, upcast(c, value.ty, p))
            c.note(unit, arg.value.span, s"expected ${type_name(zonk(c, p))}, found ${type_name(value.ty)}")
    value

// An argument to a by-name parameter is not evaluated at the call. It is checked as a lambda with
// no parameters, which the callee evaluates at each read. A by-name parameter passed on to another
// is forwarded as it is, still unevaluated.
private delayed_argument(c: *Checker, arg: Argument, param: &Type, inner: &Type) -> &TExpr
    val unit = unit_of(c)
    if arg.value.kind is Name(n)
        if binding_ref(c, arg.value.span, n) is Some(t)
            if *t.ty is ByName(_)
                if !unify(c, param, t.ty)
                    c.note(unit, arg.value.span, s"expected ${type_name(zonk(c, param))}, found ${type_name(t.ty)}")
                return t
    val expected: &Type = Function(buf(), inner)
    val delayed = lambda_expr(c, arg.value, buf(), arg.value, Some(expected), true)
    val yields: &Type = *delayed.ty match
        Function(_, r) -> r
        _ -> ErrorType
    TExpr(arg.value.span, ByName(yields), delayed.kind)

// A built-in type called with one value converts it. Integers convert among themselves (widening
// sign-extends, narrowing keeps the low bits), to and from `real`, and to `byte` and `char`, which
// trap on a value they cannot hold; `byte` and `char` convert to integers.
private conversion(c: *Checker, at: Span, target: &Type, args: Buf[Argument]) -> &TExpr
    val unit = unit_of(c)
    if args.len() != 1 || args[0].name is Some(_)
        c.note(unit, at, s"`${type_name(target)}(…)` converts exactly one value")
        for a in args
            check_statement(c, a.value)
        return TExpr(at, ErrorType, UnitConst)
    val arg = args[0].value
    // A literal is read at its own width, which is at least `int`'s, so that `i8(300)` narrows 300.
    var want: Option[&Type] = None
    if is_literal(arg)
        want = *target match
            Int(bits) -> Some(if bits > IntBits then target else int_type())
            Real -> Some(Real)
            _ -> Some(int_type())
    val x = check_expr(c, arg, want)
    if !settled(x.ty)
        return TExpr(at, if *x.ty is Nothing then Nothing else ErrorType, Convert(x))
    if !convertible(x.ty, target)
        c.note(unit, at, s"cannot convert ${type_name(x.ty)} to ${type_name(target)}")
        return TExpr(at, ErrorType, UnitConst)
    TExpr(at, target, Convert(x))

convertible(from: &Type, to: &Type) -> bool = *from match
    Int(_) -> *to is Int(_) || *to is Real || *to is Byte || *to is Char
    Byte -> *to is Int(_) || *to is Byte || *to is Char || *to is Real
    Char -> *to is Int(_) || *to is Char
    Real -> *to is Int(_) || *to is Real
    _ -> false

// A function without a declared result type has the type of its body, so its body is checked
// first; a cycle of such functions is reported rather than guessed at.
private result_of(c: *Checker, id: usize, at: Span) -> &Type
    if c.symbols[id].result is Some(r) then return r
    if c.symbols[id].root is Some(_) && c.states[id] == 0
        c.note(unit_of(c), at, s"`${c.symbols[id].name}` is called before its declaration, so it needs a declared result type")
        return ErrorType
    if c.states[id] == 1
        c.note(unit_of(c), at, s"`${c.symbols[id].name}` is recursive, so it needs a declared result type")
        return ErrorType
    check_function(c, id)
    c.symbols[id].result.unwrap_or(ErrorType)

// An integer literal takes its width from the expected type, or is an `int`. `-` applied directly
// to a literal is part of it, so the most negative value of each width can be written.
private integer_literal(c: *Checker, at: Span, spelling: string, negative: bool, expected: Option[&Type]) -> &TExpr
    var bits = IntBits
    var as_byte = false
    var as_real = false
    if expected is Some(t)
        *t match
            Int(b) -> bits = b
            Byte -> as_byte = true
            Real -> as_real = true
            _ -> ()
    val digits = literal_magnitude(spelling) match
        Some(d) -> d
        None ->
            c.note(unit_of(c), at, "malformed integer literal")
            return TExpr(at, ErrorType, UnitConst)
    if as_byte
        if negative && digits != "0" || compare_decimal(digits, "255") > 0
            c.note(unit_of(c), at, "integer literal does not fit in byte, which holds 0 to 255")
            return TExpr(at, ErrorType, UnitConst)
        return TExpr(at, Byte, IntConst(digits))
    if as_real
        // Where a real is expected, an integer literal is that real, provided it is exact.
        if compare_decimal(digits, "9007199254740992") > 0
            c.note(unit_of(c), at, "integer literal is not exact as a real; write it with a fraction or exponent")
            return TExpr(at, ErrorType, UnitConst)
        var value = 0.0
        for b in digits.bytes
            value = value * 10.0 + real(b - u8('0'))
        return TExpr(at, Real, RealConst(if negative then -value else value))
    val ty: &Type = Int(bits)
    if !fits(digits, bits, negative)
        c.note(unit_of(c), at, s"integer literal does not fit in ${type_name(ty)}")
        return TExpr(at, ErrorType, UnitConst)
    TExpr(at, ty, IntConst(if negative && digits != "0" then "-" + digits else digits))

/** The magnitude an integer literal spells, in decimal, whatever its base and size. */
literal_magnitude(spelling: string) -> Option[string]
    val text = spelling.bytes
    var base = 10u32
    var start = 0usize
    if text.len > 2 && text[0] == u8('0')
        val radix = text[1] | 0x20
        if radix == u8('x') then base = 16
        elif radix == u8('o') then base = 8
        elif radix == u8('b') then base = 2
        if base != 10 then start = 2
    // Decimal digits, least significant first, multiplied by the base and added to per digit.
    var digits: Buf[u32] = buf()
    digits.push(0)
    for i in start..<text.len
        val ch = text[i]
        if ch == u8('_') then continue
        val lower = ch | 0x20
        var d = 99u32
        if ch >= u8('0') && ch <= u8('9') then d = u32(ch - u8('0'))
        elif lower >= u8('a') && lower <= u8('f') then d = u32(lower - u8('a')) + 10
        if d >= base then return None
        var carry = d
        for k in 0..<digits.len()
            val v = digits[k] * base + carry
            digits.set(k, v % 10)
            carry = v / 10
        while carry > 0
            digits.push(carry % 10)
            carry = carry / 10
    var end = digits.len()
    while end > 1 && digits[end - 1] == 0 do end -= 1
    var out = ""
    var k = end
    while k > 0
        k -= 1
        out = out + char(u8('0') + u8(digits[k])).to_string()
    Some(out)

/** Whether a decimal magnitude, with its sign, fits a signed integer of `bits` bits. */
fits(digits: string, bits: u32, negative: bool) -> bool
    // Fewer than one decimal digit per 3.33 bits always fits, so huge widths cost nothing.
    if ulong(digits.bytes.len) * 4 < ulong(bits) then return true
    val limit = min_digits(bits)[1..]
    val order = compare_decimal(digits, limit)
    order < 0 || (negative && order == 0)

// Compares two decimal numbers without leading zeros: negative, zero or positive.
private compare_decimal(a: string, b: string) -> int
    if a.bytes.len != b.bytes.len then return if a.bytes.len < b.bytes.len then -1 else 1
    for i in 0..<a.bytes.len
        if a.bytes[i] != b.bytes[i] then return if a.bytes[i] < b.bytes[i] then -1 else 1
    0

// Each arm's pattern names are scoped to that arm, and may shadow names outside it. The arms'
// values must agree when the match's value is used, and together the unguarded arms must cover
// every value of the subject's type.
private match_expr(c: *Checker, e: &Expr, subject: &Expr, arms: Buf[Arm], expected: Option[&Type], used: bool) -> &TExpr
    val unit = unit_of(c)
    val s = check_expr(c, subject, None)
    var typed: Buf[TArm] = buf()
    var ty: &Type = Nothing
    var agreed = true
    var never = true
    for arm in arms
        val mark = c.body.visible.len()
        val outer_start = c.body.block_start
        c.body.block_start = mark
        val pattern = check_pattern(c, arm.pattern, s.ty, "")
        var guard: Option[&TExpr] = None
        if arm.guard is Some(g)
            val t = check_expr(c, g, Some(Bool))
            expect_bool(c, t)
            guard = Some(t)
        val body = check_value(c, arm.body, expected, used)
        c.body.visible.truncate(mark)
        c.body.block_start = outer_start
        if !(*body.ty is Nothing) then never = false
        if used && agreed
            join_expected(c, ty, body.ty, expected) match
                Some(t) -> ty = t
                None ->
                    c.note(unit, arm.body.span, s"this arm yields ${type_name(body.ty)}, but the arms before it yield ${type_name(ty)}")
                    agreed = false
        typed.push(TArm(pattern, guard, body))
    if !agreed then ty = ErrorType
    elif !used then ty = if never then Nothing else Unit
    if settled(s.ty) && !match_covers(typed, s.ty, c.data)
        c.note(unit, e.span, s"this `match` does not cover every ${type_name(s.ty)} value; add an arm for the rest, such as `_`")
    TExpr(e.span, ty, Match(s, typed))

private is_expr(c: *Checker, e: &Expr, value: &Expr, pattern: &Pattern, negated: bool) -> &TExpr
    val v = check_expr(c, value, None)
    val p = check_pattern(c, pattern, v.ty, "bindings in `is` patterns are not implemented")
    TExpr(e.span, if *v.ty is Nothing then Nothing else Bool, Is(v, p, negated))

// Checks a pattern against the type of the value it matches. `no_bind` is empty where the pattern
// may bind names, and otherwise says why it may not.
private check_pattern(c: *Checker, p: &Pattern, ty: &Type, no_bind: string) -> &TPattern
    val unit = unit_of(c)
    p.kind match
        Wildcard -> TPattern(p.span, ty, PWildcard)
        InvalidPattern -> TPattern(p.span, ErrorType, PWildcard)
        Name(name) ->
            // A bare name is a variant with no fields when one is in scope, and otherwise binds.
            if variant_named(c, name) is Some(v)
                if c.data[v.data].variants[v.index].fields.len() > 0
                    c.note(unit, p.span, s"`$name` has fields; match them, as in `$name(…)`")
                    return TPattern(p.span, ErrorType, PWildcard)
                return variant_pattern(c, p, v, buf(), ty, no_bind)
            if no_bind != ""
                c.note(unit, p.span, no_bind)
                return TPattern(p.span, ErrorType, PWildcard)
            TPattern(p.span, ty, PBind(declare_local(c, p.span, name, ty, c.binds_var)))
        Named(name, inner) ->
            if no_bind != ""
                c.note(unit, p.span, no_bind)
                return TPattern(p.span, ErrorType, PWildcard)
            val nested = check_pattern(c, inner, ty, no_bind)
            TPattern(p.span, ty, PNamed(declare_local(c, p.span, name, ty, c.binds_var), nested))
        Literal(value) ->
            val t = pattern_constant(c, value, ty)
            if !settled(t.ty) then return TPattern(p.span, ErrorType, PWildcard)
            TPattern(p.span, ty, PLiteral(t))
        Range(lower, upper, inclusive) ->
            val low = pattern_constant(c, lower, ty)
            val high = pattern_constant(c, upper, ty)
            if !settled(low.ty) || !settled(high.ty) then return TPattern(p.span, ErrorType, PWildcard)
            if !(*ty is Int(_) || *ty is Byte || *ty is Char)
                c.note(unit, p.span, s"range patterns match integers, bytes and chars, not ${type_name(ty)}")
                return TPattern(p.span, ErrorType, PWildcard)
            TPattern(p.span, ty, PBounds(None, Some(TBound(low, true)), Some(TBound(high, inclusive))))
        Bounded(binder, lower, upper) ->
            if settled(ty) && !(*ty is Int(_) || *ty is Byte || *ty is Char)
                c.note(unit, p.span, s"comparison patterns match integers, bytes and chars, not ${type_name(ty)}")
                return TPattern(p.span, ErrorType, PWildcard)
            var ok = settled(ty)
            var low: Option[TBound] = None
            if lower is Some(b)
                val t = pattern_constant(c, b.value, ty)
                if settled(t.ty) then low = Some(TBound(t, b.inclusive)) else ok = false
            var high: Option[TBound] = None
            if upper is Some(b)
                val t = pattern_constant(c, b.value, ty)
                if settled(t.ty) then high = Some(TBound(t, b.inclusive)) else ok = false
            val local = binder_local(c, binder, ty, no_bind)
            if !ok then return TPattern(p.span, ErrorType, PWildcard)
            TPattern(p.span, ty, PBounds(local, low, high))
        Successor(binder, amount) ->
            if settled(ty) && !(*ty is Int(_))
                c.note(unit, p.span, s"`n + k` patterns match integers, not ${type_name(ty)}")
                return TPattern(p.span, ErrorType, PWildcard)
            val k = pattern_constant(c, amount, ty)
            val local = binder_local(c, binder, ty, no_bind)
            if !settled(k.ty) then return TPattern(p.span, ErrorType, PWildcard)
            val positive = k.kind match
                IntConst(digits) -> !digits.starts_with("-") && digits != "0"
                _ -> false
            if !positive
                c.note(unit, amount.span, "the amount in `n + k` is a positive integer literal")
                return TPattern(p.span, ErrorType, PWildcard)
            TPattern(p.span, ty, PSuccessor(local, k))
        Alternatives(options) ->
            var typed: Buf[&TPattern] = buf()
            for o in options
                typed.push(check_pattern(c, o, ty, if no_bind == "" then "alternatives bind no names; write `_` for a value that is not used" else no_bind))
            TPattern(p.span, ty, PAlternatives(typed))
        Constructor(path, args) -> variant_named(c, path) match
            Some(v) -> variant_pattern(c, p, v, args, ty, no_bind)
            None ->
                c.note(unit, p.span, s"`$path` is not a variant")
                for a in args
                    check_pattern(c, a, ErrorType, no_bind)
                TPattern(p.span, ErrorType, PWildcard)
        Tuple(items) ->
            // A tuple pattern takes apart a tuple of the same size; a tuple is matched as a value
            // with one variant whose fields are its parts.
            var parts: Buf[&Type] = buf()
            var ok = true
            *zonk(c, ty) match
                Tuple(types) ->
                    if types.len() == items.len() then parts = types
                    else
                        c.note(unit, p.span, s"this pattern has ${items.len()} parts, but the tuple it matches, ${type_name(ty)}, has ${types.len()}")
                        ok = false
                ErrorType -> ok = false
                _ ->
                    c.note(unit, p.span, s"a tuple pattern matches a tuple, not ${type_name(ty)}")
                    ok = false
            var typed: Buf[&TPattern] = buf()
            for i in 0..<items.len()
                typed.push(check_pattern(c, items[i], if ok then parts[i] else ErrorType, no_bind))
            if !ok then return TPattern(p.span, ErrorType, PWildcard)
            TPattern(p.span, ty, PVariant(0, typed))
        Typed(binder, written) ->
            val target = resolve_type(c, unit, written)
            val local = binder_local(c, binder, target, no_bind)
            if *target is ErrorType || !settled(zonk(c, ty)) then return TPattern(p.span, ErrorType, PWildcard)
            if names_function(target)
                c.note(unit, written.span, "a type pattern on a function type is not implemented")
                return TPattern(p.span, ErrorType, PWildcard)
            if !may_match(c, ty, target)
                c.note(unit, p.span, s"a value of type ${type_name(zonk(c, ty))} is never ${type_article(target)}, so this type pattern never matches")
                return TPattern(p.span, ErrorType, PWildcard)
            TPattern(p.span, ty, PType(target, local, !fits(c, ty, target)))

/** Whether a function type is `t` or a part of it. */
private names_function(t: &Type) -> bool = *t match
    Function(_, _) -> true
    Tuple(items) ->
        for item in items
            if names_function(item) then return true
        false
    Data(_, _, args) ->
        for a in args
            if names_function(a) then return true
        false
    Class(_, _, args) ->
        for a in args
            if names_function(a) then return true
        false
    _ -> false

/** A type's name with an article, for a sentence: `an int`, `a Dog`. */
private type_article(t: &Type) -> string
    val name = type_name(t)
    val first = name.bytes[0]
    val vowel = first == u8('a') || first == u8('e') || first == u8('i') || first == u8('o') || first == u8('u') || first == u8('A') || first == u8('E') || first == u8('I') || first == u8('O') || first == u8('U')
    (if vowel then "an " else "a ") + name

// Whether a value of static type `from` may have type `to` at run time. It does where `from` fits
// `to`, where `from` is `Any`, and where `to` is a subclass of the class `from` or conforms to the
// trait `from`; a class and a trait unrelated to it may meet in a subclass, where the class is open.
// A tuple may, part by part, since its parts may be instances of subclasses. Any other value has
// exactly its static type. A type parameter may be any type, so its copies decide.
private may_match(c: *Checker, from: &Type, to: &Type) -> bool
    val x = zonk(c, from)
    val y = zonk(c, to)
    if fits(c, x, y) || *x is AnyType || *x is TypeVar(_, _, _) || *y is TypeVar(_, _, _) then return true
    // A value of a generic type may be an instance whose arguments are subtypes of the static ones,
    // or, for a contravariant parameter, supertypes.
    if !(*y is AnyType) && fits(c, y, x) then return true
    if variant_instances(c, x, y) then return true
    *x match
        Class(k, _, _) -> *y match
            Class(j, _, _) ->
                if ancestor_type(c.classes, c.data, y, k) is Some(up)
                    if same_type(up, x) then return true
                (is_trait(c, j) && is_open(c, k)) || (is_trait(c, k) && is_open(c, j))
            _ -> false
        Tuple(xs) -> *y match
            Tuple(ys) ->
                if xs.len() != ys.len() then return false
                for i in 0..<xs.len()
                    if !may_match(c, xs[i], ys[i]) then return false
                true
            _ -> false
        _ -> false

// Whether two instances of one generic type may describe one value: their invariant arguments are
// equal, and their other arguments are references that may describe one value.
private variant_instances(c: *Checker, x: &Type, y: &Type) -> bool
    val (params, xs, ys) = *x match
        Data(d, _, xs) -> *y match
            Data(e, _, ys) -> if d == e then (c.data[d].decl.type_params, xs, ys) else return false
            _ -> return false
        Class(k, _, xs) -> *y match
            Class(j, _, ys) -> if k == j then (c.classes[k].decl.type_params, xs, ys) else return false
            _ -> return false
        _ -> return false
    if xs.len() != ys.len() || xs.len() != params.len() then return false
    for i in 0..<xs.len()
        if same_type(xs[i], ys[i]) then continue
        if params[i].variance is Invariant || !is_reference(xs[i]) || !is_reference(ys[i]) then return false
        if !may_match(c, xs[i], ys[i]) && !may_match(c, ys[i], xs[i]) then return false
    true

// The local a comparison or `n + k` pattern binds: none for `_`. A name that is a variant is not a
// binder there.
private binder_local(c: *Checker, binder: &Pattern, ty: &Type, no_bind: string) -> Option[usize] = binder.kind match
    Name(name) ->
        if variant_named(c, name) is Some(_)
            c.note(unit_of(c), binder.span, s"`$name` is a variant; a comparison binds a name or `_`")
            return None
        if no_bind != ""
            c.note(unit_of(c), binder.span, no_bind)
            return None
        Some(declare_local(c, binder.span, name, ty, c.binds_var))
    _ -> None

// A variant pattern matches a value of the variant's own type, and each field pattern the field's
// type in the matched value's type.
private variant_pattern(c: *Checker, p: &Pattern, v: VariantRef, args: Buf[&Pattern], ty: &Type, no_bind: string) -> &TPattern
    val unit = unit_of(c)
    val d = c.data[v.data]
    val variant = d.variants[v.index]
    var fields: Buf[&Type] = buf()
    var ok = true
    *ty match
        Data(id, _, type_args) ->
            if id == v.data then fields = variant_fields(d, id, v.index, type_args)
            else ok = false
        ErrorType -> ()
        _ -> ok = false
    if !ok then c.note(unit, p.span, s"`${variant.name}` is a variant of `${d.name}`, but the value it matches is ${type_name(ty)}")
    if args.len() != variant.fields.len()
        c.note(unit, p.span, s"`${variant.name}` has ${count(variant.fields.len(), "field")}, not ${args.len()}")
        ok = false
    var typed: Buf[&TPattern] = buf()
    for i in 0..<args.len()
        val field: &Type = if ok && i < fields.len() then fields[i] else ErrorType
        typed.push(check_pattern(c, args[i], field, no_bind))
    if !ok || *ty is ErrorType then return TPattern(p.span, ErrorType, PWildcard)
    TPattern(p.span, ty, PVariant(v.index, typed))

// A literal in a pattern takes the matched value's type, as it would beside it in `==`.
private pattern_constant(c: *Checker, value: &Expr, ty: &Type) -> &TExpr
    val unit = unit_of(c)
    if *zonk(c, ty) is AnyType
        c.note(unit, value.span, "a literal does not match an Any; match the value by its type first, as in `n: int`")
        check_expr(c, value, None)
        return TExpr(value.span, ErrorType, UnitConst)
    val t = check_expr(c, value, Some(ty))
    if !settled(t.ty) || !settled(ty) then return TExpr(t.span, ErrorType, UnitConst)
    if !same_type(t.ty, ty)
        c.note(unit, value.span, s"this pattern is ${type_name(t.ty)}, but the value it matches is ${type_name(ty)}")
        return TExpr(t.span, ErrorType, UnitConst)
    t

/** A fresh inference variable. */
private fresh_var(c: *Checker) -> &Type
    val id = c.vars.len()
    c.vars.push(None)
    Var(id)

/** `t` with every solved variable replaced by its solution. */
private zonk(c: *Checker, t: &Type) -> &Type = solve(c.vars, t)

// Makes two types equal by solving variables, and reports whether they can be. A value that never
// finishes, or one whose type already failed, fits anything without deciding a variable.
private unify(c: *Checker, a: &Type, b: &Type) -> bool
    val x = zonk(c, a)
    val y = zonk(c, b)
    // An unknown meeting a type that already failed takes that type, so it is not reported again as
    // one that could not be inferred.
    if *x is ErrorType || *y is ErrorType
        poison(c, x)
        poison(c, y)
        return true
    if *x is Var(i)
        if !same_type(x, y) then c.vars.set(i, Some(y))
        return true
    if *y is Var(j)
        c.vars.set(j, Some(x))
        return true
    *x match
        Tuple(xs) -> *y match
            Tuple(ys) -> unify_all(c, xs, ys)
            _ -> false
        Function(xs, r) -> *y match
            Function(ys, q) -> unify_all(c, xs, ys) && unify(c, r, q)
            _ -> false
        ByName(r) -> *y match
            ByName(q) -> unify(c, r, q)
            _ -> false
        Data(i, _, xs) -> *y match
            Data(j, _, ys) -> i == j && unify_all(c, xs, ys)
            _ -> false
        Class(i, _, xs) -> *y match
            Class(j, _, ys) -> i == j && unify_all(c, xs, ys)
            _ -> false
        _ -> same_type(x, y)

/** Settles every unknown in `t` as the error type. */
private poison(c: *Checker, t: &Type)
    *zonk(c, t) match
        Var(i) -> c.vars.set(i, Some(ErrorType))
        Tuple(items) ->
            for item in items
                poison(c, item)
        Function(params, result) ->
            for p in params
                poison(c, p)
            poison(c, result)
        ByName(inner) -> poison(c, inner)
        Data(_, _, args) ->
            for a in args
                poison(c, a)
        Class(_, _, args) ->
            for a in args
                poison(c, a)
        _ -> ()

private unify_all(c: *Checker, xs: Buf[&Type], ys: Buf[&Type]) -> bool
    if xs.len() != ys.len() then return false
    for i in 0..<xs.len()
        if !unify(c, xs[i], ys[i]) then return false
    true

// Initialization: no field of an object is observed before the class body sets it. Until a class
// body has initialized its last field, `self` may only read a field already initialized and assign
// a field: it may not call a method, by any spelling, nor be passed, stored, returned or captured.
// An open or abstract class's body runs before a subclass's fields are initialized, so all of it
// keeps those limits, except that it may call a method that cannot be overridden and that is
// itself safe: one whose body uses `self` only to read and assign fields and to call other safe
// methods. Every function is checked first, so the bodies and the closures' captures are known.

/** How one body's uses of `self` are judged. `self` is the local `self_local`, or the first
 * parameter where that is absent. `last` names the class body's last field while it is not yet
 * initialized, and is empty after it. `kind` is `open` or `abstract` for the body of such a class.
 * With `report` false, nothing is reported: the scan only answers whether the body is safe. */
struct InitScan
    unit: usize
    self_local: Option[usize]
    last: string
    kind: string
    report: bool

/** Checks every class body's uses of `self`. */
private check_initialization(c: *Checker)
    var unsafe = unsafe_methods(c)
    for k in 0..<c.classes.len()
        check_class_initialization(c, k, &unsafe)

private check_class_initialization(c: *Checker, k: usize, unsafe: *Buf[bool])
    val cls = c.classes[k]
    if is_trait(c, k) then return
    val body = c.bodies[cls.initializer] match
        Some(b) -> b
        None -> return
    val items = body.kind match
        Block(xs) -> xs
        _ -> return
    val self_local = items[0].kind match
        Let(l, _) -> l
        _ -> return
    // The body's statements and field initializers are its items after the object is made, the
    // superclass initialized and the parameters stored, and before the result.
    var count = 0usize
    var last = 0usize
    var last_name = ""
    for m in cls.decl.members
        m match
            FieldMember(f) ->
                count += 1
                last = count
                last_name = f.name
            StatementMember(_) -> count += 1
            AbstractFieldMember(_) -> ()
            MethodMember(_, _, _) -> ()
    if items.len() < count + 1 then return
    val start = items.len() - 1 - count
    val kind = if is_open(c, k) then cls.decl.modifier else ""
    for i in 0..<count
        val early = i < last
        if !early && kind == "" then return
        val scan = InitScan(cls.unit, Some(self_local), if early then last_name else "", kind, true)
        val item = items[start + i]
        // A field's initializer is checked as it is stored.
        val e = item.kind match
            StoreField(_, _, value, _) -> value
            _ -> item
        scan_init(c, scan, e, unsafe)

/** The methods that cannot be called from an open or abstract class's body, which runs before a
 * subclass's fields are initialized: those that use `self` for more than reading and assigning its
 * fields and calling methods that can be. Every method is taken as safe until its body shows
 * otherwise, and a method that calls an unsafe one is unsafe, so calls among methods settle. */
private unsafe_methods(c: *Checker) -> Buf[bool]
    var unsafe: Buf[bool] = buf()
    for _ in c.symbols
        unsafe.push(false)
    var changed = true
    while changed
        changed = false
        for m in 0..<c.symbols.len()
            if !unsafe[m] && is_class_method(c, m)
                val safe = c.bodies[m] match
                    Some(b) -> scan_init(c, InitScan(c.symbols[m].unit, None, "", "", false), b, &unsafe)
                    None -> false
                if !safe
                    unsafe.set(m, true)
                    changed = true
    unsafe

private is_class_method(c: *Checker, f: usize) -> bool
    val symbol = c.symbols[f]
    symbol.owner_class is Some(_) && !symbol.constructor && symbol.root is None && !symbol.lambda

private is_init_self(s: InitScan, e: &TExpr) -> bool = s.self_local match
    Some(l) -> e.kind match
        Local(x) -> x == l
        _ -> false
    None -> e.kind match
        Param(i) -> i == 0
        _ -> false

private captures_init_self(c: *Checker, s: InitScan, f: usize) -> bool = s.self_local match
    Some(l) -> contains_index(c.symbols[f].captured_locals, l)
    None -> contains_index(c.symbols[f].captured_params, 0)

/** Reports a use of `self` the body may not make: `early` describes it before the last field is
 * initialized, `open` in an open or abstract class's body. Yields false, the scan's verdict. */
private init_violation(c: *Checker, s: InitScan, at: Span, early: string, open: string) -> bool
    if s.report
        if s.last != "" then c.note(s.unit, at, s"$early before `${s.last}` is initialized; a class body uses `self` for more than reading and assigning its fields only once every field is")
        else c.note(s.unit, at, s"$open in the body of an ${s.kind} class, which runs before a subclass's fields are initialized")
    false

/** Scans `e` for the uses of `self` that `s` forbids; yields whether there are none. */
private scan_init(c: *Checker, s: InitScan, e: &TExpr, unsafe: *Buf[bool]) -> bool
    if is_init_self(s, e) then return init_violation(c, s, e.span, "`self` is passed, stored or returned", "`self` cannot be passed, stored or returned")
    e.kind match
        Call(f, args, _) ->
            var ok = true
            var from = 0usize
            val name = c.symbols[f].decl.name
            if args.len() > 0 && is_class_method(c, f) && is_init_self(s, args[0])
                from = 1
                if s.last != "" then ok = init_violation(c, s, e.span, s"`$name` is called", "")
                elif (*unsafe)[f] then ok = init_violation(c, s, e.span, "", s"`$name` uses `self` for more than its fields, so it cannot be called")
            elif c.symbols[f].root is Some(_) && captures_init_self(c, s, f)
                ok = init_violation(c, s, e.span, s"`$name`, which uses `self`, is called", s"`$name` uses `self`, so it cannot be called")
            for i in from..<args.len()
                if !scan_init(c, s, args[i], unsafe) then ok = false
            ok
        Dispatch(f, _, args, _) ->
            var ok = true
            var from = 0usize
            val name = c.symbols[f].decl.name
            if args.len() > 0 && is_init_self(s, args[0])
                from = 1
                // A trait's `val` is read through the method table, from a field a subclass may set.
                if is_trait_field(c, f) then ok = init_violation(c, s, e.span, s"`$name` is read", s"`$name` is a trait's `val`, which a subclass may supply, so it cannot be read")
                else ok = init_violation(c, s, e.span, s"`$name` is called", s"`$name` may be overridden, so it cannot be called")
            for i in from..<args.len()
                if !scan_init(c, s, args[i], unsafe) then ok = false
            ok
        // The receiver's type is a type parameter, so it is never the object being initialized.
        BoundCall(_, _, args, _) -> scan_init_all(c, s, args, unsafe)
        FunctionValue(f, _) ->
            if !captures_init_self(c, s, f) then return true
            val symbol = c.symbols[f]
            if symbol.delayed then init_violation(c, s, e.span, "an argument passed by name uses `self`", "an argument passed by name cannot use `self`")
            elif symbol.lambda then init_violation(c, s, e.span, "a lambda that captures `self` is made", "a lambda cannot capture `self`")
            else init_violation(c, s, e.span, s"`${symbol.decl.name}`, which uses `self`, is used as a value", s"`${symbol.decl.name}` uses `self`, so it cannot be used as a value")
        Field(value, _) -> is_init_self(s, value) || scan_init(c, s, value, unsafe)
        StoreField(object, _, value, _) ->
            val target = is_init_self(s, object) || scan_init(c, s, object, unsafe)
            scan_init(c, s, value, unsafe) && target
        StoreGlobal(_, value, _) -> scan_init(c, s, value, unsafe)
        CallValue(callee, args) ->
            val ok = scan_init(c, s, callee, unsafe)
            scan_init_all(c, s, args, unsafe) && ok
        Construct(_, args) -> scan_init_all(c, s, args, unsafe)
        Block(items) ->
            if method_value_of_self(c, s, items) is Some(name) then return init_violation(c, s, e.span, s"`$name` is used as a value", s"`$name` cannot be used as a value")
            scan_init_all(c, s, items, unsafe)
        Let(_, value) -> scan_init(c, s, value, unsafe)
        LetPattern(_, value) -> scan_init(c, s, value, unsafe)
        Store(_, value, _) -> scan_init(c, s, value, unsafe)
        MultiStore(_, value) -> scan_init(c, s, value, unsafe)
        Negate(x) -> scan_init(c, s, x, unsafe)
        Not(x) -> scan_init(c, s, x, unsafe)
        Complement(x) -> scan_init(c, s, x, unsafe)
        Convert(x) -> scan_init(c, s, x, unsafe)
        Render(x) -> scan_init(c, s, x, unsafe)
        Box(x) -> scan_init(c, s, x, unsafe)
        Arith(_, a, b, _) ->
            val ok = scan_init(c, s, a, unsafe)
            scan_init(c, s, b, unsafe) && ok
        Logic(_, a, b) ->
            val ok = scan_init(c, s, a, unsafe)
            scan_init(c, s, b, unsafe) && ok
        Compare(operands, _) -> scan_init_all(c, s, operands, unsafe)
        If(condition, yes, no) ->
            var ok = scan_init(c, s, condition, unsafe)
            if !scan_init(c, s, yes, unsafe) then ok = false
            if no is Some(x) && !scan_init(c, s, x, unsafe) then ok = false
            ok
        While(_, condition, body, otherwise) ->
            var ok = scan_init(c, s, condition, unsafe)
            if !scan_init(c, s, body, unsafe) then ok = false
            if otherwise is Some(x) && !scan_init(c, s, x, unsafe) then ok = false
            ok
        Break(_, value) -> value match
            Some(x) -> scan_init(c, s, x, unsafe)
            None -> true
        Return(value) -> value match
            Some(x) -> scan_init(c, s, x, unsafe)
            None -> true
        Match(subject, arms) ->
            var ok = scan_init(c, s, subject, unsafe)
            for arm in arms
                if arm.guard is Some(g) && !scan_init(c, s, g, unsafe) then ok = false
                if !scan_init(c, s, arm.body, unsafe) then ok = false
            ok
        Is(value, _, _) -> scan_init(c, s, value, unsafe)
        Clauses(subjects, clauses) ->
            var ok = scan_init_all(c, s, subjects, unsafe)
            for clause in clauses
                for b in clause.bodies
                    if b.guard is Some(g) && !scan_init(c, s, g, unsafe) then ok = false
                    if !scan_init(c, s, b.body, unsafe) then ok = false
            ok
        _ -> true

/** The method's name when `items` make a method of `self` a value: the receiver held in a local,
 * then a closure over that local that calls the method. */
private method_value_of_self(c: *Checker, s: InitScan, items: Buf[&TExpr]) -> Option[string]
    if items.len() != 2 then return None
    val held = items[0].kind match
        Let(l, value) -> if is_init_self(s, value) then l else return None
        _ -> return None
    val f = items[1].kind match
        FunctionValue(f, _) -> f
        _ -> return None
    if !contains_index(c.symbols[f].captured_locals, held) then return None
    val body = c.bodies[f] match
        Some(b) -> b
        None -> return None
    body.kind match
        Call(m, _, _) -> Some(c.symbols[m].decl.name)
        Dispatch(m, _, _, _) -> Some(c.symbols[m].decl.name)
        _ -> None

private scan_init_all(c: *Checker, s: InitScan, items: Buf[&TExpr], unsafe: *Buf[bool]) -> bool
    var ok = true
    for item in items
        if !scan_init(c, s, item, unsafe) then ok = false
    ok
