module dev.avinlang.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.text.{from_utf8_unchecked, str_builder}

/** A source file in a program, with the report its diagnostics go to. */
struct SourceUnit
    src: Source
    file: SourceFile
    report: Report

/** A function's signature and where it was declared. */
struct FunctionSymbol
    unit: usize
    module_name: string
    name: string
    decl: &Function
    params: Buf[&Type]
    param_names: Buf[string]
    /** The declared result type, or the one inferred from the body once it has been checked. */
    result: Option[&Type]
    intrinsic: Option[string]
    /** For a local function, the top-level function it is declared in. */
    root: Option[usize]
    /** For a local function, the locals its parameters are stored in. */
    param_locals: Buf[usize]
    /** For a local function, the enclosing locals and top-level parameters it uses, directly or
     * through the local functions it calls. */
    captured_locals: Buf[usize]
    captured_params: Buf[usize]
    /** Whether this is a lambda, which has no name of its own. */
    lambda: bool
    /** Whether this lambda is an argument to a by-name parameter, an expression evaluated at each
     * read, which `return`, `break` and `continue` cannot leave. */
    delayed: bool
    /** Whether the function is used as a value somewhere, so a closure of it is made. */
    value: bool
    /** For each parameter with a default, the function that computes it: it takes the parameters
     * before that one, a method's receiver first, and yields the default, evaluated in this
     * function's declaration scope. An override shares the defaults of the method it overrides. */
    defaults: Buf[Option[usize]]
    /** For a function that computes a default, the parameter it is the default of. */
    default_param: Option[string]
    /** The owner of the type parameters the function's types name, and those parameters: for a
     * top-level function, itself and its own; for a constructor, its class's; for a method, its
     * class's followed by its own, all owned by `class_owner` of the class. */
    type_owner: usize
    type_params: Buf[TypeParam]
    /** For a method or a constructor, its class. A method's first parameter is its receiver,
     * `self`. */
    owner_class: Option[usize]
    constructor: bool
    /** Whether code outside the method's class may call it. */
    public: bool
    /** For a function that shares its name with others in its scope, and for the functions that
     * compute its defaults, its parameter types as written, as in `(int, string)`, which tell the
     * overloads apart in the object file; empty otherwise. */
    overload: string
    /** For a method an `impl` adds to a data type or a built-in type, the type of its receiver,
     * `self`, with the impl's type parameters as its arguments. Such a method is called directly:
     * the type has no subclasses. A class's methods, its impls' included, have `owner_class`. */
    receiver: Option[&Type]
    /** Whether this is a static member, or computes a default of one: a member of the type rather
     * than of a value. Its first parameter stands for the receiver, as a method's does, so it lines
     * up with the trait's member it implements, and it is given no value: a call names a type, and
     * nothing is passed for it. */
    static_member: bool

/** A class. Its fields are its parameters, in order, then the fields its body declares; their types
 * name the class's own type parameters as `TypeVar(class_owner(id), i)`. */
struct ClassSymbol
    unit: usize
    module_name: string
    name: string
    decl: &ClassDecl
    fields: Buf[FieldSymbol]
    /** The symbols of its methods, in declaration order. */
    methods: Buf[usize]
    constructor: usize
    /** While the class body is checked, how many fields its code has initialized so far. */
    ready: usize
    /** The superclass, its type arguments written in this class's own type parameters. */
    superclass: Option[&Type]
    /** How many of `fields` the class inherits: the superclass's fields lead, in the superclass's
     * order, so the superclass's code finds each at the offset it expects. */
    inherited: usize
    /** The function the class body is checked as. For a final class it is the constructor. For an
     * open or abstract class it takes the object as its first parameter, so a subclass's constructor
     * runs it on the subclass's object; the class's own constructor allocates and then calls it. */
    initializer: usize
    /** The method in each slot of the class's method table: the superclass's slots first, in the
     * same positions, each holding this class's override where it has one, then a slot for each
     * method the class adds that a subclass may override. */
    slots: Buf[usize]
    /** For each of `methods`, whether it is declared `override`. */
    overriding: Buf[bool]
    /** 0 before the class's superclass is linked, 1 while it is, 2 after. */
    linked: u8
    /** For an object, the class of the same name in its module; for a class, that object. Each may
     * use the other's private members. */
    companion: Option[usize]
    /** For an object, the module-level value that holds its one instance. */
    global: Option[usize]
    /** The traits written after `:`, their type arguments in the class's own type parameters: for a
     * class the traits it conforms to, for a trait the traits it requires. */
    traits: Buf[&Type]
    /** For a class, its whole method table: `slots` first, then each method of every trait the class
     * conforms to, at that trait's `base`. A position no trait of the class uses, or one holding an
     * abstract method, is empty. */
    table: Buf[Option[usize]]
    /** For a trait, the position of its first method in the table of every class conforming to it;
     * its methods follow in declaration order. */
    base: usize
    /** For an object named after a data type of its module, that type: the object is its companion,
     * and each uses the other's private members. */
    companion_data: Option[usize]
    /** The function types written after `:` or named by an impl for the class, in its own type
     * parameters: a class or trait is a subtype of each. */
    functions: Buf[&Type]
    /** For a class whose objects are functions, the `apply` a call of one as a function runs. */
    call: Option[usize]
    /** For a trait, the fields it declares with a value, which every class conforming to it
     * stores. */
    state: Buf[TraitState]
    /** For a class, the trait fields it stores itself, in the order it initializes them: they
     * follow its parameters in `fields`, from `inherited` plus the parameters' count on. */
    mixed: Buf[MixedField]

/** A field a trait declares with a value. The trait reads it through `getter`, the `val` the field
 * is to every type conforming to it, and assigns a `var` one through `setter`; `init` computes its
 * value, with the object as the trait's receiver. Its type names the trait's own parameters. */
struct TraitState
    field: FieldSymbol
    decl: FieldDecl
    getter: usize
    setter: Option[usize]
    init: usize

/** A trait field a class stores: the trait, as the class conforms to it, and which of its `state`. */
struct MixedField
    trait_type: &Type
    trait_id: usize
    state: usize

/** A module-level value: a `val` or `var` declared at the top level of a file, or an object's one
 * instance. Each is computed once, before `main` runs, by its `init` function: a value's initializer,
 * checked as a function with no parameters, or an object's constructor. Its type is that function's
 * result. */
struct GlobalSymbol
    unit: usize
    module_name: string
    name: string
    span: Span
    mutable: bool
    init: usize
    /** For an object, its class. */
    object: Option[usize]
    /** A `lazy val`: `init` runs on the value's first read instead of before `main`. */
    lazy: bool

/** A field of a class; `ty` is `None` until the constructor's check infers it from the field's
 * initializer, when the declaration has no type. */
struct FieldSymbol
    name: string
    span: Span
    ty: Option[&Type]
    mutable: bool
    public: bool
    param: bool
    /** The class that declares the field: a subclass inherits its superclass's fields. */
    owner: usize
    /** A `lazy val`, whose value is computed on its first read. The two fields after it hold its
     * state, which a read tests, and the closure that computes it, which the constructor stores. */
    lazy: bool

/** A `data` type and its variants. Field types name the type's own parameters as
 * `TypeVar(data_owner(id), i)`, so a field of a particular value's type is its declared type with the
 * value's type arguments substituted. */
struct DataSymbol
    unit: usize
    module_name: string
    name: string
    decl: &DataDecl
    variants: Buf[VariantSymbol]
    /** The methods its impls add, in declaration order; each takes the value as `self`. */
    methods: Buf[usize]
    /** For each of `methods`, whether an impl of a trait declares it. */
    implementing: Buf[bool]
    /** The traits its impls make it conform to, their type arguments in the type's own parameters. */
    traits: Buf[&Type]
    /** Its method table, which every variant's descriptor carries: at each conformed trait's `base`,
     * the implementation of each of the trait's methods, the type's own method of that name or the
     * trait's default body. Empty when the type conforms to no trait. */
    table: Buf[Option[usize]]
    /** The object of the same name in its module, its companion: the bare name and `Name.member`
     * are the object, while a variant of the type's name is still called to make a value. */
    companion: Option[usize]
    /** The methods of the `Display` and `Debug` it would have had without asking, but which a field
     * of it lacks: unchecked, and never compiled. */
    withdrawn: Buf[usize]
    /** The function types its impls name, in its own type parameters: the type is a subtype of each. */
    functions: Buf[&Type]
    /** For a type whose values are functions, the `apply` a call of one as a function runs. */
    call: Option[usize]

/** One constructor of a data type. */
struct VariantSymbol
    name: string
    span: Span
    field_names: Buf[string]
    fields: Buf[&Type]
    /** For each field, the function computing its value where a construction omits it. */
    defaults: Buf[Option[usize]]

/** A variant, by its data type's index and its own position among the type's variants. */
struct VariantRef
    data: usize
    index: usize

/** The type of a data value, with the type's own parameters as its arguments. */
own_type(d: DataSymbol, id: usize) -> &Type
    var args: Buf[&Type] = buf()
    for i in 0..<d.decl.type_params.len()
        args.push(TypeVar(data_owner(id), i, d.decl.type_params[i].name))
    Data(id, d.name, args)

/** The field types of a variant for a value of type `Data(id, _, args)`. */
variant_fields(d: DataSymbol, id: usize, variant: usize, args: Buf[&Type]) -> Buf[&Type] =
    substitute_all(d.variants[variant].fields, data_owner(id), args)

/** A `break` the checker has seen, kept until its loop's type is known. */
struct BreakSite
    label: usize
    span: Span
    ty: &Type

/** What the checker knows inside one function body. Checking a call to a function whose result is
 * inferred checks that function's body first, so this is saved and restored around it. */
/** A use of an enclosing local (`param` false) or top-level parameter by a local function. */
struct CaptureUse
    function: usize
    index: usize
    param: bool

struct LocalCall
    caller: usize
    callee: usize

/** A call to a local function made before its declaration, with the locals initialized there. */
struct EarlyCall
    callee: usize
    span: Span
    initialized: Buf[usize]

struct BodyState
    /** The top-level function being checked. */
    root: usize
    locals: Buf[TLocal]
    /** The locals in scope, innermost last. */
    visible: Buf[usize]
    /** The loops enclosing the current expression, innermost last. */
    loops: Buf[usize]
    breaks: Buf[BreakSite]
    labels: usize
    /** For each loop, by label, the type its `break`s' values are expected to have. */
    loop_expected: Buf[Option[&Type]]
    /** Where the innermost block's locals start in `visible`. */
    block_start: usize
    /** The local functions in scope, innermost last. */
    functions: Buf[usize]
    /** For each of `functions`, where its block's local functions start in `functions`. */
    function_starts: Buf[usize]
    /** For each of `functions`, how many locals were in scope where its block began: a local of the
     * function's name at or past that position is declared inside the block and hides the function,
     * and one before it is outside the block and is hidden by it. */
    function_marks: Buf[usize]
    uses: Buf[CaptureUse]
    calls: Buf[LocalCall]
    early: Buf[EarlyCall]
    /** The locals bound by `is` tests, which are in scope only where their test is known to hold. */
    tested: Buf[usize]

fresh_body(root: usize) -> BodyState = BodyState(root, buf(), buf(), buf(), buf(), 0, buf(), 0, buf(), buf(), buf(), buf(), buf(), buf(), buf())

/** A class body checked part way: its initializer's body so far, the code checked so far, the next
 * member to check and the next field it declares. */
struct Construction
    body: BodyState
    items: Buf[&TExpr]
    receiver: &TExpr
    member: usize
    index: usize
    finishes: bool

struct GenericScope
    owner: usize
    params: Buf[TypeParam]

/** Type arguments written before every conformance is known, for the parameters `params` of `owner`,
 * held to their bounds once they are, in the generic scope they were written in. */
struct PendingBound
    unit: usize
    at: Span
    what: string
    owner: usize
    params: Buf[TypeParam]
    args: Buf[&Type]
    scope: Option[GenericScope]

/** An `impl` block, resolved. `target` is the type it adds to, with the impl's type parameters as its
 * arguments, which are the type's own: `owner` owns them, `data_owner` or `class_owner` of the type.
 * `trait` is the trait it makes the type conform to. An impl found invalid has the error type as its
 * target, and its methods are not declared. */
struct ImplSymbol
    unit: usize
    module_name: string
    decl: &ImplDecl
    target: &Type
    owner: usize
    trait_type: Option[&Type]
    /** For each type parameter, the bounds the impl gives it besides its type's: the conformance
     * holds only for type arguments that meet them. Empty for an impl without any. */
    conditions: Buf[Buf[&Type]]

/** An impl with bounds of its own that adds methods to a data type or class: `impl[T: Display]
 * List[T]`. Its methods are the ones whose type parameters begin with `params`, and a receiver has
 * them only where its type arguments meet `conditions`, the bounds of each parameter. */
struct ConditionalImpl
    owner: usize
    conditions: Buf[Buf[&Type]]
    unit: usize
    params: Buf[TypeParam]

/** An impl that adds methods to a trait, `impl[T] Seq[T]`: every value whose type conforms to the
 * trait has them. Or an impl adding methods to a type built from its parameters, `impl[T]
 * Seq[Seq[T]]` or `impl[T] Option[Option[T]]`: the values whose type matches it have them. `on_trait`
 * tells which the type the impl adds to is; `trait_id` is that trait's. `extension` tells whether
 * the impl is written outside the module of the type or trait it adds to. */
struct TraitImpl
    unit: usize
    module_name: string
    decl: &ImplDecl
    trait_id: usize
    on_trait: bool
    extension: bool

/** A method an impl adds to trait `trait_id`. It is a generic function whose type parameters are the
 * impl's (`impl_params` of them), then `Self`, the receiver's type, bounded by the trait at the impl's
 * parameters, then its own. A call gives the receiver's static type as `Self`, so each instance calls
 * the trait's methods of that type directly, or through the method table where the receiver is seen
 * only as the trait.
 *
 * Where the impl adds to a data type, a class or a built-in type built from its parameters
 * (`on_trait` false), there is no `Self`: the receiver is of the type the impl names. Either way
 * `target` is that type, naming the impl's parameters as this function's, and a call learns them
 * by matching the receiver's static type against it.
 *
 * An `extension`, added by an impl outside the module of the type or trait it adds to, is seen only
 * by code of that module and by files importing the module or a declaration of it. */
struct TraitMethod
    function: usize
    trait_id: usize
    impl_params: usize
    on_trait: bool
    target: &Type
    extension: bool

/** An unknown type argument of a call, open until a later use settles it: where it was made, and
 * what to report if nothing does. One the call's result names only where a value is read out
 * (`R` in `Left(1)`, an `Either[int, R]`) is `Nothing` if nothing settles it, as `None` alone is an
 * `Option[Nothing]`; any other is reported. */
struct Unknown
    var_id: usize
    unit: usize
    at: Span
    message: string
    covariant: bool

struct Checker
    units: Buf[SourceUnit]
    symbols: Buf[FunctionSymbol]
    data: Buf[DataSymbol]
    /** The data types and variants, by qualified name: `a.b.Shape`, or `Shape` in the root module. */
    types: Map[string, usize]
    variants: Map[string, VariantRef]
    classes: Buf[ClassSymbol]
    /** The classes, by qualified name, and the standalone objects, whose types are named after them. */
    class_types: Map[string, usize]
    globals: Buf[GlobalSymbol]
    /** The module-level values and objects, by qualified name. */
    global_names: Map[string, usize]
    /** 0: not yet checked, 1: being checked, 2: checked. */
    states: Buf[u8]
    bodies: Buf[Option[&TExpr]]
    locals: Buf[Buf[TLocal]]
    /** The top-level functions and class constructors, by qualified name: several when the name is
     * overloaded. */
    scope: Map[string, Buf[usize]]
    current: usize
    body: BodyState
    /** The bindings of inference variables: `None` while a variable is unsolved. */
    vars: Buf[Option[&Type]]
    /** The unknowns a call left open, for a later use in the body to settle. */
    unknowns: Buf[Unknown]
    /** The type parameters in scope, and the generic function they belong to. */
    generic: Option[GenericScope]
    /** Whether the names a pattern binds are assignable: set while a `var` binding's pattern is
     * checked. */
    binds_var: bool
    /** Whether a superclass's constructor arguments are being checked: they run before the class
     * stores its parameters, so a parameter's name reads the argument itself, not its field. */
    super_args: bool
    impls: Buf[ImplSymbol]
    /** The methods impls add to built-in types, each with its `receiver`. */
    builtin_methods: Buf[usize]
    /** For each class, how far its body is checked: 0 not begun, 1 being checked, 2 stopped after
     * the fields another function needed, 3 checked. */
    building: Buf[u8]
    /** For each class whose body is stopped part way, where to resume it. */
    constructions: Buf[Option[Construction]]
    /** The traits' `val` members: each an abstract method of no parameters that a read with field
     * syntax calls. */
    trait_fields: Buf[usize]
    /** The methods made to read a field where it supplies a trait's `val`: each yields its field. */
    field_getters: Buf[usize]
    /** The bounds of each type parameter that has any, resolved where it is declared, by
     * `bound_key`. */
    bounds: Map[string, Buf[&Type]]
    /** The trait whose methods are being declared or checked, which `Self` names the implementer
     * of. */
    self_trait: Option[usize]
    /** Whether the type being resolved is a bound or the trait of an impl, where a trait that
     * mentions `Self` may be named. */
    bound_context: bool
    /** Whether every type's conformances are known, so a type argument can be held to its bounds
     * where it is written; before then, each check waits in `pending`. */
    conformances_known: bool
    pending: Buf[PendingBound]
    /** For each unit, its module and the names its imports bring in. */
    files: Buf[FileScope]
    /** The declarations marked `private`, by qualified name: seen only inside their modules. */
    private_names: Map[string, bool]
    /** The program's root module, which declares `main`. */
    root_module: string
    /** The built-in types' conformances to traits, one for each impl of a trait for a built-in
     * type. */
    builtins: Buf[BuiltinConformance]
    /** The core library's operator and equality traits, found once every method is declared. */
    core: CoreTraits
    /** The derived traits whose methods read the fields through the trait: each field's type must
     * implement it. */
    derivations: Buf[Derivation]
    /** The conformances that hold only at type arguments meeting an impl's own bounds. */
    conditional: Buf[ConditionalConformance]
    /** The methods impls add to classes, which are not variance positions in a class whose fields
     * are all immutable. */
    impl_methods: Buf[usize]
    /** The impls with bounds of their own that add methods without a trait: their methods exist only
     * at type arguments meeting the bounds. */
    conditional_methods: Buf[ConditionalImpl]
    /** The `Display` and `Debug` a data type would have had without asking, but which a field of it
     * does not implement: the type is left without the trait, and a use needing it names the field. */
    underived: Buf[Underived]
    /** The impls that add methods to a trait, and the methods they add. */
    trait_impls: Buf[TraitImpl]
    trait_methods: Buf[TraitMethod]
    /** The name spans of the infix calls that take their receiver on the right (`x +: xs`), whose
     * argument, written first, is evaluated before the receiver. */
    operand_first: Buf[Span]
    /** Where each name the program writes resolved to, for an editor; `None` for a build, which
     * records nothing (`definition_index.sysl`). */
    index: Option[&DefinitionIndex]
    /** The views `upcast` made and the type patterns checked, for lowering: see `TProgram.views`. */
    views: Buf[TypeView]
    type_tests: Buf[TypeView]
    /** The impls `derives` entries make from templates, before they join the templates' files. */
    template_impls: Buf[TemplateImpl]
    /** Each impl made from a template for a type, as declared: see `DerivedImpl`. */
    derived: Buf[DerivedImpl]
    /** The methods of those impls, by symbol, to the impl's place in `derived`. */
    derived_symbols: Map[string, usize]
    /** The impl made from a template whose declarations or bodies are being checked. */
    derived_context: Option[usize]
    /** The unit whose names the code written for a derived type's fields is checked in: the type's
     * own, while the template's body around it is checked in the template's. */
    unit_override: Option[usize]
    /** Expressions already checked and types already resolved, which written code refers to by
     * place (`Checked`, `ResolvedType`). */
    checked_slots: Buf[&TExpr]
    type_slots: Buf[&Type]
    /** Whether a template's own parameter is being declared, the one place `Shaped` is a bound. */
    declaring_template: bool
    /** The methods that assign a trait's `var` field through the trait: each abstract, taking the
     * receiver and the value, and filled in each conforming class's table by one of
     * `field_setters`. */
    trait_setters: Buf[usize]
    /** The methods made to assign a class's field where it stores a trait's `var` field. */
    field_setters: Buf[usize]
    /** The instance of a trait a type implements at several type arguments that a member of the trait
     * is being seen as, while one of those conformances is checked. */
    seen_instance: Option[&Type]
    /** The module of an interpolator the file does not import, which `interpolators_named` found
     * beside those in scope; empty otherwise. */
    hidden_module: string
    /** How many errors have been reported, for a check that asks whether one call added any. */
    reported_count: usize
    /** The lower bound of each function's or method's own type parameter that has one, resolved
     * where it is declared, by `bound_key`. */
    lowers: Map[string, &Type]
    /** The inference variables of type arguments with a lower bound, whose lower bounds join to
     * `Any` where they are references with no nearer common type. */
    widening: Buf[usize]
    /** While above zero, diagnostics are counted in `muted_notes` rather than reported: a pattern
     * asks this way whether its name is a value with an extractor method. */
    muted: usize
    muted_notes: usize

    note(*self, unit: usize, at: Span, message: string)
        if self.muted > 0
            self.muted_notes = self.muted_notes + 1
            return
        // What goes wrong in an impl made from a template is the template's, already reported where
        // it is declared, or the deriving type's, reported at its `derives` entry once all is checked.
        if self.derived_context is Some(i)
            var notes = self.derived[i].notes
            notes.push(message)
            self.derived[i].notes = notes
            return
        self.reported_count = self.reported_count + 1
        self.units[unit].report.add(error(at, message))
end Checker

/** An impl a `derives` entry made from a template: where it was asked for, its place among the
 * impls, the type `T` stands for in it, and what went wrong while it was checked. */
struct DerivedImpl
    site: DeriveSite
    impl_index: usize
    target: &Type
    template_unit: usize
    notes: Buf[string]
    /** What its derivation has reported at the `derives` entry, each once. */
    reported: Buf[string]

struct Checked
    units: Buf[SourceUnit]
    program: Option[TProgram]
    /** What each name resolved to, when the check was asked to record it; empty otherwise. */
    references: Buf[Reference]
    /** The methods that override or implement another, when the check was asked to record names. */
    overrides: Buf[Override]
    /** What may be written where the check was asked to complete, and what kind of place that is
     * (`completion.sysl`). */
    completions: Completions

    has_errors(self) -> bool
        for u in self.units
            if u.report.has_errors() then return true
        false

    /** Every diagnostic, rendered against its own source. */
    render(self) -> string
        var out = ""
        for u in self.units
            if u.report.has_errors() then out = out + u.report.render(u.src)
        out
end Checked

/** The core library's module. Its public declarations are seen by every file without an import, and
 * the built-in types belong to it. */
const CoreModule: string = "avin"

/** What begins the name code the compiler writes gives a core library declaration. No source spells
 * a name holding `::`, so `core_path(name)` reaches the core library's `name` whatever the file's own
 * declarations, imports and type parameters call `name`. */
const CorePrefix: string = "avin::"

/** The name by which compiler-written code refers to the core library's declaration `name`. */
core_path(name: string) -> string = CorePrefix + name

/** What a file sees besides its own module's declarations and the core library's: each name its
 * imports bring in, bound to the qualified name of the declaration it imports. */
struct FileScope
    module_name: string
    imports: Map[string, string]
    /** Each module the file imports whole, `import a.b`, bound to the name it is reached by and
     * holding the module's path. */
    modules: Map[string, string]

/** The name a declaration `name` of module `module_name` has in the symbol tables: `a.b.name`, or
 * `name` alone in the root module. A declaration's name holds no dot, so two declarations of
 * different modules never share one. */
qualified(module_name: string, name: string) -> string = if module_name == "" then name else module_name + "." + name

/** Whether a declaration has the qualified name `key`, whatever kind it is. */
declared(c: *Checker, key: string) -> bool =
    c.types.get(key) is Some(_) || c.class_types.get(key) is Some(_) || c.variants.get(key) is Some(_) ||
        c.global_names.get(key) is Some(_) || c.scope.get(key) is Some(_)

/** Whether the declaration named `key` may be seen from another module: it is not `private`. A
 * function's name is while any of its overloads is public. */
exported(c: *Checker, key: string) -> bool
    if c.private_names.get(key) is Some(_) then return false
    if c.scope.get(key) is Some(ids)
        for id in ids
            if c.symbols[id].public then return true
        return false
    true

/** The qualified name a bare `name` denotes in a unit: its own module's declaration of that name,
 * else the one the file imports under it, else the core library's public one. The nearer hides the
 * farther whatever kind each is, so a module's function hides a core library type of its name. When
 * none exists, the module's own, which no table holds, so the use is reported as unknown. */
resolve_name(c: *Checker, unit: usize, name: string) -> string
    if name.starts_with(CorePrefix) then return qualified(CoreModule, name[CorePrefix.bytes.len..])
    val scope = c.files[unit]
    // `m.X`, with `m` a module the file imports: that module's public `X`, else nothing.
    var dot: Option[usize] = None
    for k in 0..<name.bytes.len
        if dot is None && name.bytes[k] == u8('.') then dot = Some(k)
    if dot is Some(k)
        if scope.modules.get(name[0..<k]) is Some(module_path)
            val key = qualified(module_path, name[k + 1..])
            if declared(c, key) && exported(c, key) then return key
        return name
    val own = qualified(scope.module_name, name)
    if declared(c, own) then return own
    if scope.imports.get(name) is Some(key) then return key
    val core = qualified(CoreModule, name)
    if declared(c, core) && exported(c, core) then return core
    own

private file_scope(c: *Checker, unit: usize) -> FileScope
    val file = c.units[unit].file
    var imports: Map[string, string] = map()
    // A module imported whole is bound from the start, so a type written through it, `m.X`, resolves
    // in the signatures and fields declared before the imports are checked. `check_imports` replaces
    // these bindings with the ones it keeps.
    var modules: Map[string, string] = map()
    for i in file.imports
        if imports.get(i.binding) is None then imports.put(i.binding, i.path)
        if i.path != file.module_name && module_has_unit(c, i.path) && !names_declaration(c, i.path) && modules.get(i.binding) is None
            modules.put(i.binding, i.path)
    FileScope(file.module_name, imports, modules)

private module_has_unit(c: *Checker, name: string) -> bool
    for u in c.units
        if u.file.module_name == name then return true
    false

// Whether `path`, `a.b`, names a top-level declaration or variant `b` of a module `a`, read from the
// source before anything is declared.
private names_declaration(c: *Checker, path: string) -> bool
    var dot: Option[usize] = None
    for k in 0..<path.bytes.len
        if path.bytes[k] == u8('.') then dot = Some(k)
    val at = dot match
        Some(k) -> k
        None -> return false
    val module_name = path[0..<at]
    val name = path[at + 1..]
    for u in c.units
        if u.file.module_name != module_name then continue
        for item in u.file.items
            if item_name(item) == name then return true
            if item is DataItem(d)
                for v in d.variants
                    if v.name == name then return true
    false

// What an earlier import bound a name to, a declaration or a module, or "" when none did.
private imported_from(kept: Map[string, string], mods: Map[string, string], binding: string) -> string
    if kept.get(binding) is Some(earlier) then return earlier
    if mods.get(binding) is Some(earlier) then return earlier
    ""

private module_exists(c: *Checker, name: string) -> bool
    for f in c.files
        if f.module_name == name then return true
    false

// Each import of a unit names a public declaration of another module, under a name the file does not
// already use. An import found wrong is reported and dropped, so its uses are reported as unknown
// names rather than resolved to something the import did not mean.
private check_imports(c: *Checker, unit: usize)
    val file = c.units[unit].file
    val own = file.module_name
    var kept: Map[string, string] = map()
    var mods: Map[string, string] = map()
    for i in file.imports
        if completing_import(c, unit, i) then continue
        // A whole module, `import a.b`, is reached by its binding: `b.X`.
        var dotted = false
        for k in 0..<i.path.bytes.len
            if i.path.bytes[k] == u8('.') then dotted = true
        if module_exists(c, i.path) && !(dotted && declared(c, i.path))
            if i.path == own
                c.note(unit, i.name_span, s"`${i.path}` is this file's own module")
            elif declared(c, qualified(own, i.binding))
                c.note(unit, i.binding_span, s"`${i.binding}` is a module and also declared in this module")
            elif imported_from(kept, mods, i.binding) != ""
                c.note(unit, i.binding_span, s"`${i.binding}` is already imported, from `${imported_from(kept, mods, i.binding)}`")
            else
                mods.put(i.binding, i.path)
                index_import(c, unit, i, true)
            continue
        var dot: Option[usize] = None
        for k in 0..<i.path.bytes.len
            if i.path.bytes[k] == u8('.') then dot = Some(k)
        val at = dot match
            Some(k) -> k
            None ->
                if module_exists(c, i.path) then c.note(unit, i.module_span, s"`${i.path}` is a module; an import names its declarations, as in `import ${i.path}.{Name}`")
                else c.note(unit, i.module_span, s"`${i.path}` is not a declaration of a module; an import names one, as in `import a.b.{Name}`")
                continue
        val module_name = i.path[0..<at]
        val name = i.path[at + 1..]
        if module_name == own
            c.note(unit, i.name_span, s"`$name` is declared in this module, which sees it without an import")
            continue
        if !module_exists(c, module_name)
            if module_exists(c, i.path) then c.note(unit, i.module_span.to(i.name_span), s"`${i.path}` is a module; an import names its declarations, as in `import ${i.path}.{Name}`")
            else c.note(unit, i.module_span, s"unknown module `$module_name`")
            continue
        if !declared(c, i.path)
            c.note(unit, i.name_span, s"module `$module_name` declares no `$name`")
            continue
        if !exported(c, i.path)
            c.note(unit, i.name_span, s"`$name` is private to module `$module_name`")
            continue
        val local = qualified(own, i.binding)
        if declared(c, local)
            var companion = false
            var data_companion = false
            if c.class_types.get(local) is Some(k)
                if c.classes[k].decl.object
                    if c.class_types.get(i.path) is Some(j)
                        if !c.classes[j].decl.object then companion = true
                    if c.types.get(i.path) is Some(_) then data_companion = true
            if companion then c.note(unit, i.binding_span, s"`${i.binding}` is a class of module `$module_name`; its companion object is declared in the class's own module")
            elif data_companion then c.note(unit, i.binding_span, s"`${i.binding}` is a data type of module `$module_name`; its companion object is declared in the type's own module")
            else c.note(unit, i.binding_span, s"`${i.binding}` is imported and also declared in this module")
            continue
        if imported_from(kept, mods, i.binding) != ""
            c.note(unit, i.binding_span, s"`${i.binding}` is already imported, from `${imported_from(kept, mods, i.binding)}`")
            continue
        kept.put(i.binding, i.path)
        index_import(c, unit, i, false)
    c.files[unit].imports = kept
    c.files[unit].modules = mods

/** Checks a program: the core library's units, then the program's own, each heading its module's
 * name in `file.module_name`. `root_module` is the module that must declare `main`, and the last
 * unit is one of its files. Every file sees its own module's declarations, the names it imports and
 * the core library's public declarations, in that order: an inner name hides an outer one. With
 * `indexing`, the check also records where each name resolved to, in `Checked.references`. With
 * `completing`, a name written in the program as a stand-in for the one being typed, the check also
 * records what could be written there, in `Checked.completions`. */
check_program(units: Buf[SourceUnit], root_module: string, testing: bool, indexing: bool = false, completing: string = "") -> Checked
    var c = Checker(units, buf(), buf(), map(), map(), buf(), map(), buf(), map(), buf(), buf(), buf(), map(), 0, fresh_body(0), buf(), buf(), None, false, false, buf(), buf(), buf(), buf(), buf(), buf(), map(), None, false, false, buf(), buf(), map(), root_module, buf(), CoreTraits(map(), map()), buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf(), if indexing || completing != "" || has_tests_file(units) then Some(definition_index(completing)) else None, buf(), buf(), buf(), buf(), map(), None, None, buf(), buf(), false, buf(), buf(), None, "", 0, map(), buf(), 0, 0)
    // The core library's impls for tuples are a file made for the program, after the program's own:
    // see `tuples.sysl`.
    val given = c.units.len()
    if tuple_impls_unit(c.units) is Some(u) then c.units.push(u)
    for u in 0..<c.units.len()
        c.files.push(file_scope(&c, u))
    // `derives` is written out as the methods and impls it stands for before anything is declared.
    for u in 0..<c.units.len()
        derive_unit(&c, u)
    finish_derivations(&c)
    // Every type is named before any is used, so a data type may refer to itself or to one
    // declared after it, and functions are declared once every type is known. A class is named
    // before any object, so an object finds its companion in any file of the module.
    for u in 0..<c.units.len()
        declare_types(&c, u)
    for u in 0..<c.units.len()
        declare_objects(&c, u)
    for u in 0..<c.units.len()
        declare_impls(&c, u)
    for u in 0..<c.units.len()
        declare_variants(&c, u)
        declare_fields(&c, u)
    for id in 0..<c.data.len()
        check_mirror(&c, id)
    // A subclass's fields and methods follow its superclass's, wherever either is declared.
    for id in 0..<c.classes.len()
        inherit_fields(&c, id)
    refuse_stateful_impls(&c)
    for u in 0..<c.units.len()
        declare_unit(&c, u)
        declare_methods(&c, u)
    for i in 0..<c.impls.len()
        declare_impl_methods(&c, i)
    for i in 0..<c.trait_impls.len()
        declare_trait_methods(&c, i)
    register_derived_symbols(&c)
    find_core_traits(&c)
    var linked: Buf[bool] = buf()
    for _ in c.classes
        linked.push(false)
    break_trait_cycles(&c)
    for id in 0..<c.classes.len()
        link_methods(&c, id, &linked)
    place_traits(&c)
    for id in 0..<c.classes.len()
        check_apply_overloads(&c, id)
    // Type arguments written in declarations are held to their bounds once every conformance is known.
    c.conformances_known = true
    for p in c.pending
        val outer_generic = c.generic
        c.generic = p.scope
        hold_to_bounds(&c, p.unit, p.at, p.what, p.owner, p.params, p.args, 0)
        c.generic = outer_generic
    c.pending = buf()
    for dv in c.derivations
        if !dv.automatic then check_derivation(&c, dv)
    settle_automatic_derivations(&c)
    for u in 0..<c.units.len()
        declare_globals(&c, u)
    for u in 0..<c.units.len()
        check_imports(&c, u)
    for _ in c.classes
        c.building.push(0)
        c.constructions.push(None)
    // Class bodies first: a function a body calls then finds each field the body declared before
    // the call already typed, and a field whose type needs itself is reported by name.
    for k in 0..<c.classes.len()
        val init = c.classes[k].initializer
        if c.symbols[init].owner_class is Some(owner) && owner == k then check_function(&c, init)
    for id in 0..<c.symbols.len()
        check_function(&c, id)
    for id in 0..<c.classes.len()
        settle_inherited_fields(&c, id)
        check_override_results(&c, id)
        check_class_variance(&c, id)
    settle_unknowns(&c, 0)
    check_initialization(&c)
    for id in 0..<c.data.len()
        check_data_implementations(&c, id)
        check_data_variance(&c, id)
    check_template_implementations(&c)
    check_function_types(&c)
    check_equality_pairs(&c)
    check_several_conformances(&c)
    for g in 0..<c.globals.len()
        settle_global(&c, g)
    check_tests_impls(&c)
    check_tests_files(&c)
    check_expansion(&c)
    val init = initializer(&c, initialization_order(&c), testing)
    // A program without `main` is told so in its last file.
    var main_unit = given - 1
    var entry: Option[usize] = None
    c.scope.get(qualified(root_module, "main")) match
        Some(ids) ->
            entry = Some(ids[0])
            main_unit = c.symbols[ids[0]].unit
            if ids.len() > 1 then c.note(c.symbols[ids[1]].unit, c.symbols[ids[1]].decl.name_span, "`main` cannot be overloaded")
            if c.units[main_unit].file.tests_only then c.note(main_unit, c.symbols[ids[0]].decl.name_span, "`main` is declared in a `@tests` file, which only `avin test` builds: a program starts in an ordinary file")
        None -> ()
    entry match
        Some(id) ->
            // The entry function takes nothing or the program's arguments as a `Vector[string]`, and
            // yields unit or an integer, which becomes the exit status; one that never returns
            // (`Nothing`) is ended by whatever ends it.
            val main = c.symbols[id]
            var takes_arguments = false
            if main.params.len() == 1
                takes_arguments = *main.params[0] match
                    Class(k, _, args) -> is_vector_class(c.classes[k]) && args.len() == 1 && *args[0] is Str
                    _ -> false
            if main.params.len() > 1 || (main.params.len() == 1 && !takes_arguments && !(*main.params[0] is ErrorType))
                c.note(main_unit, main.decl.name_span, "`main` is `main()` or `main(args: Vector[string])`")
            elif takes_arguments && declares_variadic(main.decl)
                c.note(main_unit, main.decl.name_span, "`main`'s `args` is not a repeated parameter; `main` is `main()` or `main(args: Vector[string])`")
            if takes_arguments && main.defaults.len() > 0 && main.defaults[0] is Some(_)
                c.note(main_unit, main.decl.name_span, "`main`'s `args` has no default; `main` is `main()` or `main(args: Vector[string])`")
            if main.decl.type_params.len() > 0 then c.note(main_unit, main.decl.name_span, "`main` cannot be generic")
            val result = main.result.unwrap_or(ErrorType)
            if !(*result is Unit || *result is Int(_) || *result is Nothing || *result is ErrorType)
                c.note(main_unit, main.decl.name_span, s"`main` yields unit or an integer, not ${type_name(result)}")
        // A program built for its tests runs them rather than `main`, so it may have none.
        None -> if !testing then c.note(main_unit, Span(0, 0), "a program needs a `main` function")
    report_derived(&c)
    val tests = check_tests(&c)
    val completions = finish_completion(&c)
    val references = finish_index(&c)
    val overrides = finish_ties(&c)
    var failed = false
    for u in c.units
        if u.report.has_errors() then failed = true
    if failed then return Checked(c.units, None, references, overrides, completions)
    var functions: Buf[TFunction] = buf()
    for i in 0..<c.symbols.len()
        functions.push(TFunction(i, c.bodies[i], c.locals[i]))
    var sources: Buf[Source] = buf()
    for u in c.units
        sources.push(u.src)
    val views = solved_views(c.vars, c.views)
    val type_tests = solved_views(c.vars, c.type_tests)
    Checked(c.units, Some(TProgram(sources, c.symbols, c.data, c.classes, c.globals, functions, c.vars, entry, init, c.builtins, c.conditional, c.core, c.bounds, tests, testing, views, type_tests)), references, overrides, completions)

/** Each view with its unknowns solved, each distinct one once. */
private solved_views(vars: Buf[Option[&Type]], views: Buf[TypeView]) -> Buf[TypeView]
    var seen: Map[string, bool] = map()
    var out: Buf[TypeView] = buf()
    for v in views
        val from = solve(vars, v.from)
        val to = solve(vars, v.to)
        val key = type_key(from) + " as " + type_key(to)
        if seen.get(key) is Some(_) then continue
        seen.put(key, true)
        out.push(TypeView(from, to))
    out

// The program's `@test` functions, in the order they are declared. A test is a top-level function
// that `avin test` calls with nothing and that passes by returning, or by answering `Ok`, so it takes
// no parameters, has no type parameters and yields unit or a `Result[unit, E]` whose error is
// displayed. `@test` names it after the function, and `@test("a sentence")` by the sentence; after
// the description come `should_trap`, `timeout` and `ignore`. Each test carries its module's hooks.
// The core library has no tests of its own in a program's run.
private check_tests(c: *Checker) -> Buf[TestCase]
    val hooks = check_hooks(c)
    var tests: Buf[TestCase] = buf()
    for id in 0..<c.symbols.len()
        val f = c.symbols[id]
        if f.default_param is Some(_) || f.lambda || f.delayed then continue
        for a in f.decl.annotations
            if a.name != "test" then continue
            if f.root is Some(_) || f.owner_class is Some(_) || f.receiver is Some(_)
                c.note(f.unit, a.span, "`@test` marks a top-level function, which `avin test` can call by itself")
                break
            var test = TestCase(id, f.name, f.module_name, None, None, None, None, None, None, None, None)
            read_test_arguments(c, f.unit, a, f.name, &test)
            if f.params.len() > 0
                c.note(f.unit, f.decl.name_span, s"a `@test` function takes no parameters, and `${f.name}` takes ${count(f.params.len(), "parameter")}: `avin test` calls it with nothing")
            if f.decl.type_params.len() > 0
                c.note(f.unit, f.decl.name_span, s"a `@test` function has no type parameters, and `${f.name}` declares `${f.decl.type_params[0].name}`: the runner supplies no type arguments")
            val result = zonk(c, f.result.unwrap_or(ErrorType))
            test.answers = test_answer(c, result)
            if test.answers is Some(e)
                if !(*e is ErrorType) && !displays(c, e)
                    c.note(f.unit, f.decl.name_span, s"a `@test` function's error is shown by its `Display`, and `${type_name(e)}`, the error `${f.name}` answers, does not implement `Display`")
            elif !(*result is Unit || *result is Nothing || *result is ErrorType)
                c.note(f.unit, f.decl.name_span, s"a `@test` function yields unit or a `Result[unit, E]`, and `${f.name}` yields ${type_name(result)}: a test passes by returning, or by answering `Ok`, so there is nothing to read a value with")
            if f.decl.body is None && f.decl.clauses.len() == 0
                c.note(f.unit, f.decl.name_span, s"a `@test` function has a body, and `${f.name}` has none")
            if f.module_name == CoreModule || f.module_name.starts_with(CoreModule + ".") then break
            if hooks.get(f.module_name) is Some(h)
                test.setup = h.setup
                test.teardown = h.teardown
                test.setup_all = h.setup_all
                test.teardown_all = h.teardown_all
            tests.push(test)
            break
    tests

// What `@test`'s arguments say about a test: a description first, a string that is not empty; then
// `should_trap`, alone or with the text the run must print; `timeout`, whole seconds from 0 to
// 2147483; and `ignore` with the reason the test is not run. Each at most once.
private read_test_arguments(c: *Checker, unit: usize, a: Annotation, function: string, test: *TestCase)
    var timed = false
    for i in 0..<a.args.len()
        val arg = a.args[i]
        val key = arg.name match
            Some(k) -> k
            None -> arg.value.kind match
                Name(word) -> if word == "should_trap" || word == "ignore" || word == "timeout" then word else ""
                _ -> ""
        if key == ""
            val text = arg.value.kind match
                StringLit(t) -> t
                _ -> ""
            if i > 0 || text == ""
                c.note(unit, a.span, s"`@test` takes a description, a string that is not empty, or nothing, and then `$function` names the test")
            else test.name = text
        elif key == "should_trap"
            if test.should_trap is Some(_) then c.note(unit, a.span, "`@test` takes `should_trap` once")
            if arg.name is None then test.should_trap = Some("")
            else arg.value.kind match
                StringLit(t) ->
                    if t == "" then c.note(unit, arg.value.span, "`should_trap` is written alone, or with the text the trap must print: `@test(should_trap: \"out of bounds\")`")
                    test.should_trap = Some(t)
                _ -> c.note(unit, arg.value.span, "`should_trap` is written alone, or with the text the trap must print: `@test(should_trap: \"out of bounds\")`")
        elif key == "ignore"
            if test.ignore is Some(_) then c.note(unit, a.span, "`@test` takes `ignore` once")
            val reason = if arg.name is None then "" else arg.value.kind match
                StringLit(t) -> t
                _ -> ""
            if reason == "" then c.note(unit, if arg.name is None then a.span else arg.value.span, "`ignore` needs the reason the test is not run, written as a string: `@test(ignore: \"the parser drops the second arm\")`")
            test.ignore = Some(reason)
        elif key == "timeout"
            if timed then c.note(unit, a.span, "`@test` takes `timeout` once")
            timed = true
            val seconds = if arg.name is None then None else arg.value.kind match
                IntLit(spelling) -> whole_seconds(spelling)
                _ -> None
            seconds match
                Some(s) -> test.timeout = Some(s)
                None -> c.note(unit, if arg.name is None then a.span else arg.value.span, "`timeout` is a whole number of seconds from 0, for no limit, to 2147483: `@test(timeout: 30)`")
        else c.note(unit, a.span, s"`@test` has no argument `$key`: it takes a description, then `should_trap`, `timeout` and `ignore`")

// The seconds an integer literal spells, when it is at most 2147483, the most milliseconds an `int`
// counts.
private whole_seconds(spelling: string) -> Option[int]
    val digits = literal_magnitude(spelling) match
        Some(d) -> d
        None -> return None
    if digits.len > 7 then return None
    var value = 0
    for b in digits.bytes
        value = value * 10 + int(b - u8('0'))
    if value > 2147483 then None else Some(value)

// The error type of a test that answers with a `Result[unit, E]`.
private test_answer(c: *Checker, result: &Type) -> Option[&Type]
    val result_id = core_data(c, "Result") match
        Some(r) -> r
        None -> return None
    *result match
        Data(id, _, args) -> if id == result_id && args.len() == 2 && *args[0] is Unit then Some(args[1]) else None
        _ -> None

// Whether values of `t` implement the core library's `Display`.
private displays(c: *Checker, t: &Type) -> bool = c.class_types.get(qualified(CoreModule, "Display")) match
    Some(k) -> conforms_to_bound(c, t, Class(k, "Display", buf()))
    None -> false

/** The functions `avin test` calls around a module's tests: `@setup` before each test and `@teardown`
 * after it, `@setup_all` once before the module's first test and `@teardown_all` once after its last. */
private struct TestHooks
    setup: Option[usize]
    teardown: Option[usize]
    setup_all: Option[usize]
    teardown_all: Option[usize]

// Whether any of `units` is a `@tests` file.
private has_tests_file(units: Buf[SourceUnit]) -> bool
    for u in units
        if u.file.tests_only then return true
    false

/** Whether `name` is the name of an annotation marking a test hook. */
is_hook_annotation(name: string) -> bool = name == "setup" || name == "teardown" || name == "setup_all" || name == "teardown_all"

// The hooks of each module, by its name. A hook is a top-level function the runner calls with
// nothing, like a test, which yields unit, and a module declares at most one of each kind.
private check_hooks(c: *Checker) -> Map[string, TestHooks]
    var hooks: Map[string, TestHooks] = map()
    for id in 0..<c.symbols.len()
        val f = c.symbols[id]
        if f.default_param is Some(_) || f.lambda || f.delayed then continue
        for a in f.decl.annotations
            if !is_hook_annotation(a.name) then continue
            if f.root is Some(_) || f.owner_class is Some(_) || f.receiver is Some(_)
                c.note(f.unit, a.span, s"`@${a.name}` marks a top-level function, which `avin test` can call by itself")
                break
            if a.args.len() > 0 then c.note(f.unit, a.span, s"`@${a.name}` takes no arguments")
            if f.params.len() > 0
                c.note(f.unit, f.decl.name_span, s"a `@${a.name}` function takes no parameters, and `${f.name}` takes ${count(f.params.len(), "parameter")}: `avin test` calls it with nothing")
            if f.decl.type_params.len() > 0
                c.note(f.unit, f.decl.name_span, s"a `@${a.name}` function has no type parameters, and `${f.name}` declares `${f.decl.type_params[0].name}`: the runner supplies no type arguments")
            val result = f.result.unwrap_or(ErrorType)
            if !(*result is Unit || *result is Nothing || *result is ErrorType)
                c.note(f.unit, f.decl.name_span, s"a `@${a.name}` function yields unit, and `${f.name}` yields ${type_name(result)}: the runner reads nothing from it")
            if f.decl.body is None && f.decl.clauses.len() == 0
                c.note(f.unit, f.decl.name_span, s"a `@${a.name}` function has a body, and `${f.name}` has none")
            if f.module_name == CoreModule || f.module_name.starts_with(CoreModule + ".") then break
            var h = hooks.get(f.module_name).unwrap_or(TestHooks(None, None, None, None))
            val existing = if a.name == "setup" then h.setup elif a.name == "teardown" then h.teardown elif a.name == "setup_all" then h.setup_all else h.teardown_all
            if existing is Some(other)
                c.note(f.unit, f.decl.name_span, s"a module declares at most one `@${a.name}`, and this one already has `${c.symbols[other].name}`")
                break
            if a.name == "setup" then h.setup = Some(id)
            elif a.name == "teardown" then h.teardown = Some(id)
            elif a.name == "setup_all" then h.setup_all = Some(id)
            else h.teardown_all = Some(id)
            hooks.put(f.module_name, h)
            break
    hooks

// What a `@tests` file declares is there for the tests: `avin test` builds it, and no other build
// keeps it. So nothing else may name it: only a `@test` function, a test hook or another `@tests`
// file. A lambda counts as the function it is written in.
private check_tests_files(c: *Checker)
    var any = false
    for u in c.units
        if u.file.tests_only then any = true
    if !any then return
    val ix = c.index match
        Some(i) -> i
        None -> return
    // Where test code is written: the declarations of tests and hooks, by unit.
    var code_units: Buf[usize] = buf()
    var code_spans: Buf[Span] = buf()
    for s in c.symbols
        if s.root is Some(_) || s.owner_class is Some(_) || s.receiver is Some(_) || s.lambda then continue
        for a in s.decl.annotations
            if a.name == "test" || is_hook_annotation(a.name)
                code_units.push(s.unit)
                code_spans.push(s.decl.span)
                break
    // A path is noted as a whole and by its last name, which is one use, reported once.
    var reported_units: Buf[usize] = buf()
    var reported_spans: Buf[Span] = buf()
    for n in ix.noted
        if !c.units[n.declared_unit].file.tests_only || c.units[n.at_unit].file.tests_only then continue
        var again = false
        for k in 0..<reported_units.len()
            val r = reported_spans[k]
            if reported_units[k] == n.at_unit && n.at.start < r.end && r.start < n.at.end then again = true
        if again then continue
        val name = n.target match
            FunctionTarget(id) -> c.symbols[id].name
            DataTarget(id) -> c.data[id].name
            ClassTarget(k) -> c.classes[k].decl.name
            VariantTarget(d, i) -> c.data[d].decl.variants[i].name
            ValueTarget(_, value, _, role) -> if role is GlobalRole then value else ""
            _ -> ""
        if name == "" then continue
        var inside = false
        for k in 0..<code_units.len()
            val span = code_spans[k]
            if code_units[k] == n.at_unit && span.start <= n.at.start && n.at.end <= span.end then inside = true
        if !inside
            reported_units.push(n.at_unit)
            reported_spans.push(n.at)
            c.note(n.at_unit, n.at, s"`$name` is declared in a `@tests` file, so only `avin test` builds it: a `@test` function, a test hook or another `@tests` file may name it, and nothing else")

// An impl written in a `@tests` file is for a type, or of a trait, the file declares: an impl of
// anything else would make a type behave one way while the tests run and another in the program that
// ships.
private check_tests_impls(c: *Checker)
    for i in c.impls
        if !c.units[i.unit].file.tests_only || i.decl.derived is Some(_) || *i.target is ErrorType then continue
        if declared_in(c, i.target, i.unit) then continue
        if i.trait_type is Some(t)
            if declared_in(c, t, i.unit) then continue
        c.note(i.unit, i.decl.target.span, s"an impl in a `@tests` file is for a type or of a trait the file declares, and `${type_name(i.target)}` is declared elsewhere: the tests would see the impl and the program that ships would not")
    for t in c.trait_impls
        if !c.units[t.unit].file.tests_only || c.classes[t.trait_id].unit == t.unit then continue
        c.note(t.unit, t.decl.target.span, s"an impl in a `@tests` file is for a type or of a trait the file declares, and `${c.classes[t.trait_id].decl.name}` is declared elsewhere: the tests would see the impl and the program that ships would not")

// Whether `t` is a data type or class declared in `unit`.
private declared_in(c: *Checker, t: &Type, unit: usize) -> bool = *t match
    Data(id, _, _) -> c.data[id].unit == unit
    Class(k, _, _) -> c.classes[k].unit == unit
    _ -> false

private declare_unit(c: *Checker, unit: usize)
    val file = c.units[unit].file
    for i in 0..<file.items.len()
        file.items[i] match
            FunctionItem(f) ->
                // A module's functions of a name overload one another, in whichever of its files
                // each is declared, and hide the core library's.
                val key = qualified(file.module_name, f.name)
                var set: Buf[usize] = buf()
                if c.scope.get(key) is Some(ids)
                    for other in ids
                        if !c.symbols[other].constructor then set.push(other)
                val id = c.symbols.len()
                var symbol = signature(c, unit, file.module_name, f, id, f.type_params, false, None)
                symbol.public = !file.private_items[i]
                if same_as_overload(c, symbol, set)
                    c.note(unit, f.name_span, s"`${f.name}` is declared more than once with the same parameter types; overloads differ in their parameter types, and a function that chooses by its arguments' values is written with clauses")
                    continue
                if set.len() == 0 && c.variants.get(key) is Some(v)
                    c.note(unit, f.name_span, s"`${f.name}` is already a variant of `${c.data[v.data].name}`")
                if set.len() == 0 && c.class_types.get(key) is Some(k)
                    if c.classes[k].decl.object then c.note(unit, f.name_span, s"`${f.name}` is already an object")
                    else c.note(unit, f.name_span, s"`${f.name}` is already a class, which is called to make one")
                c.symbols.push(symbol)
                c.states.push(0)
                c.bodies.push(None)
                c.locals.push(buf())
                declare_defaults(c, id)
                set.push(id)
                c.scope.put(key, set)
                if set.len() > 1 then mark_overloads(c, set)
            DataItem(_) -> ()
            ClassItem(_) -> ()
            ImplItem(_) -> ()
            ValueItem(_) -> ()

// Whether a function declared with `symbol` has the same parameter types as one of `others`, so that
// no call could choose between them. Two overloads are the same when each accepts the other's
// parameter types: so `f[T](x: T)` and `f[U](x: U)` are, and whether a parameter is by-name does not
// tell two apart.
private same_as_overload(c: *Checker, symbol: FunctionSymbol, others: Buf[usize]) -> bool
    // A parameter type already reported as unknown tells nothing apart.
    for p in symbol.params
        if *p is ErrorType then return false
    for other in others
        val o = c.symbols[other]
        if o.params.len() != symbol.params.len() then continue
        if accepts(c, o.params, o.type_owner, o.type_params.len(), symbol.params) && accepts(c, symbol.params, symbol.type_owner, symbol.type_params.len(), o.params)
            return true
    false

// Gives every function of an overload set, and the functions computing their defaults, its parameter
// types, which name it apart from the others in the object file.
private mark_overloads(c: *Checker, set: Buf[usize])
    for id in set
        var text = "("
        val params = c.symbols[id].params
        // A method's receiver is the same in all its overloads.
        val first = if is_method(c.symbols[id]) then 1usize else 0usize
        for i in first..<params.len()
            if i > first then text = text + ", "
            text = text + type_name(params[i])
        text = text + ")"
        c.symbols[id].overload = text
        for d in c.symbols[id].defaults
            if d is Some(default) then c.symbols[default].overload = text

// Whether a function with the parameter types `general`, whose own `type_params` type parameters
// belong to `owner`, accepts arguments of the types `specific`, once those type parameters are
// solved. The inference variables it makes and solves are discarded, whatever it answers.
private accepts(c: *Checker, general: Buf[&Type], owner: usize, type_params: usize, specific: Buf[&Type]) -> bool = accepting(c, general, owner, type_params, specific, false)

// As `accepts`, where an argument may also be of a subtype of its parameter's type: what a call's
// candidates are compared by, so `f(x: Iterable[int])` accepts what `f(x: Vector[int])` does.
private accepts_conforming(c: *Checker, general: Buf[&Type], owner: usize, type_params: usize, specific: Buf[&Type]) -> bool = accepting(c, general, owner, type_params, specific, true)

private accepting(c: *Checker, general: Buf[&Type], owner: usize, type_params: usize, specific: Buf[&Type], subtypes: bool) -> bool
    if general.len() != specific.len() then return false
    val saved = save_vars(c)
    var type_args: Buf[&Type] = buf()
    for _ in 0..<type_params
        type_args.push(fresh_var(c))
    var ok = true
    for i in 0..<general.len()
        val p = strict(substitute(general[i], owner, type_args))
        val a = strict(specific[i])
        // A built-in value or a tuple is a value of each trait it implements, boxed as one.
        if ok && !unify(c, p, if subtypes then upcast(c, a, p) else a) && !(subtypes && boxes_to(c, a, p)) then ok = false
    restore_vars(c, saved)
    ok

/** A parameter's type with any by-name marker removed. */
private strict(t: &Type) -> &Type = *t match
    ByName(inner) -> inner
    _ -> t

private save_vars(c: *Checker) -> Buf[Option[&Type]]
    var saved: Buf[Option[&Type]] = buf()
    for v in c.vars
        saved.push(v)
    saved

private restore_vars(c: *Checker, saved: Buf[Option[&Type]])
    c.vars.truncate(saved.len())
    for i in 0..<saved.len()
        c.vars.set(i, saved[i])

private declare_types(c: *Checker, unit: usize)
    val file = c.units[unit].file
    for i in 0..<file.items.len()
        if file.items[i] is DataItem(d)
            val key = qualified(file.module_name, d.name)
            if builtin_type(d.name) is Some(_)
                c.note(unit, d.span, s"`${d.name}` is a built-in type, so it cannot be declared")
                continue
            if c.types.get(key) is Some(_) || c.class_types.get(key) is Some(_)
                c.note(unit, d.span, s"the type `${d.name}` is declared more than once")
                continue
            if file.private_items[i] then c.private_names.put(key, true)
            for a in d.annotations
                if a.name != "sysl"
                    c.note(unit, a.span, s"unknown annotation `@${a.name}`")
                    continue
                var target: Option[string] = None
                if a.args.len() == 1 && a.args[0].name is None
                    if a.args[0].value.kind is StringLit(p) then target = Some(p)
                target match
                    Some(p) ->
                        if !is_sysl_path(p) then c.note(unit, a.span, s"`@sysl` on a data type names a Sysl enum or struct by its module and name, as in `sysl.fs.IoError`; `$p` is not one")
                    None -> c.note(unit, a.span, "`@sysl` on a data type takes one string, the module and name of the Sysl enum or struct it mirrors, as in `@sysl(\"sysl.fs.IoError\")`")
                if d.type_params.len() > 0 then c.note(unit, a.span, "a Sysl mirror has no type parameters: it mirrors one Sysl type")
            c.types.put(key, c.data.len())
            c.data.push(DataSymbol(unit, file.module_name, d.name, d, buf(), buf(), buf(), buf(), buf(), None, buf(), buf(), None))
    for i in 0..<file.items.len()
        if file.items[i] is ClassItem(d)
            if d.object then continue
            val key = qualified(file.module_name, d.name)
            if builtin_type(d.name) is Some(_)
                c.note(unit, d.name_span, s"`${d.name}` is a built-in type, so it cannot be declared")
                continue
            if c.types.get(key) is Some(_) || c.class_types.get(key) is Some(_)
                c.note(unit, d.name_span, s"the type `${d.name}` is declared more than once")
                continue
            if file.private_items[i] then c.private_names.put(key, true)
            check_handle_declaration(c, unit, d)
            c.class_types.put(key, c.classes.len())
            c.classes.push(ClassSymbol(unit, file.module_name, d.name, d, buf(), buf(), 0, 0, None, 0, 0, buf(), buf(), 0, None, None, buf(), buf(), 0, None, buf(), None, buf(), buf()))

// An object is a class with one instance. Named after a class or a data type of its module, in any of
// the module's files, it is that type's companion and its type has no name of its own; otherwise its
// name is also its type's. A type and its companion are one name, so a companion is private where its
// type is.
private declare_objects(c: *Checker, unit: usize)
    val file = c.units[unit].file
    for i in 0..<file.items.len()
        if file.items[i] is ClassItem(d)
            if !d.object then continue
            val key = qualified(file.module_name, d.name)
            if builtin_type(d.name) is Some(_)
                c.note(unit, d.name_span, s"`${d.name}` is a built-in type, so it cannot be declared")
                continue
            val id = c.classes.len()
            var companion: Option[usize] = None
            var companion_data: Option[usize] = None
            if c.class_types.get(key) is Some(k)
                if c.classes[k].decl.object || c.classes[k].companion is Some(_)
                    c.note(unit, d.name_span, s"the object `${d.name}` is declared more than once")
                    continue
                companion = Some(k)
                c.classes[k].companion = Some(id)
            elif c.types.get(key) is Some(t)
                if c.data[t].companion is Some(_)
                    c.note(unit, d.name_span, s"the object `${d.name}` is declared more than once")
                    continue
                companion_data = Some(t)
                c.data[t].companion = Some(id)
            else
                c.class_types.put(key, id)
                if file.private_items[i] then c.private_names.put(key, true)
            c.classes.push(ClassSymbol(unit, file.module_name, d.name, d, buf(), buf(), 0, 0, None, 0, 0, buf(), buf(), 0, companion, None, buf(), buf(), 0, companion_data, buf(), None, buf(), buf()))

// Each impl's type and trait, resolved with the impl's type parameters in scope. They are the type's
// own parameters under the names the impl gives them, so `impl[T] Box[T]` lists them in order. What
// an impl may hold, and where it may be written, is reported here once: a conformance lives in the
// module of its type or of its trait, and the built-in types belong to the core library's module,
// the prelude's; an impl that only adds methods may be written in any module. A data type's
// conformances are recorded here; a class's join those its header states
// when its fields are declared.
private declare_impls(c: *Checker, unit: usize)
    val file = c.units[unit].file
    for item in file.items
        if item is ImplItem(d)
            d.derived match
                Some(site) ->
                    // An impl made from a template: what goes wrong declaring it is the template's or
                    // the deriving type's, reported once everything is checked (`report_derived`).
                    val index = c.derived.len()
                    c.derived.push(DerivedImpl(site, c.impls.len(), ErrorType, unit, buf(), buf()))
                    c.derived_context = Some(index)
                    val made = resolve_impl(c, unit, file.module_name, d)
                    c.derived_context = None
                    c.derived[index].target = made.target
                    c.impls.push(made)
                None -> c.impls.push(resolve_impl(c, unit, file.module_name, d))

// A derive template, `derive Trait for T`: an impl over its one parameter, `T`, bounded by the trait
// and by `Shaped`, checked once like any generic code. It states no conformance; each `derives`
// entry naming the trait makes an impl of its own from the template's body.
private resolve_template_impl(c: *Checker, unit: usize, module_name: string, d: &ImplDecl) -> ImplSymbol
    val invalid = ImplSymbol(unit, module_name, d, ErrorType, 0, None, buf())
    val owner = template_owner(c.impls.len())
    val outer_generic = c.generic
    c.generic = Some(GenericScope(owner, d.type_params))
    c.declaring_template = true
    declare_bounds(c, unit, owner, d.type_params, 0, 0)
    c.declaring_template = false
    var trait_type: Option[&Type] = None
    if d.trait_name is Some(written_trait)
        val t = resolve_bound(c, unit, written_trait)
        *t match
            Class(k, _, _) ->
                if is_trait(c, k)
                    trait_type = Some(t)
                    if c.classes[k].module_name != module_name
                        c.note(unit, written_trait.span, s"a derive template is declared in its trait's module, and `${c.classes[k].name}` is declared in `${c.classes[k].module_name}`")
                        trait_type = None
                else c.note(unit, written_trait.span, s"`${c.classes[k].name}` is not a trait; a template derives a trait")
            ErrorType -> ()
            _ -> c.note(unit, written_trait.span, s"${type_name(t)} is not a trait; a template derives a trait")
    c.generic = outer_generic
    if trait_type is None then return invalid
    for other in c.impls
        if other.decl.template && other.trait_type is Some(t)
            if same_trait(t, trait_type.unwrap())
                c.note(unit, written_trait_span(d), s"`${type_name(t)}` already has a derive template; a trait has one")
                return invalid
    ImplSymbol(unit, module_name, d, TypeVar(owner, 0, d.type_params[0].name), owner, trait_type, buf())

// Each method of a template implements the trait's method of its name, as an impl's would: it takes
// the same parameters and yields what the trait's method does, `T` standing for the implementing
// type. Every trait method without a default has one.
private check_template_implementations(c: *Checker)
    for block in c.impls
        if !block.decl.template || !is_template_type(block.target) then continue
        val k = block.trait_type match
            Some(t) -> *t match
                Class(k, _, _) -> k
                _ -> continue
            None -> continue
        var mine: Buf[usize] = buf()
        for m in c.builtin_methods
            if same_type(c.symbols[m].receiver.unwrap(), block.target) then mine.push(m)
        for base in c.classes[k].methods
            var found = false
            for m in mine
                if c.symbols[m].decl.name != c.symbols[base].decl.name || c.symbols[m].params.len() != c.symbols[base].params.len() then continue
                found = true
                val described = s"`${c.symbols[m].decl.name}` implements `${c.symbols[base].name}`"
                val at = c.symbols[m].decl.name_span
                if param_mismatch(c, block.target, m, base) is Some(text) then c.note(block.unit, at, s"$described, $text")
                elif result_mismatch(c, block.target, m, base) is Some(text) then c.note(block.unit, at, s"$described, $text")
            if !found && is_abstract_method(c.symbols[base]) && !contains_id(c.field_getters, base)
                c.note(block.unit, block.decl.span, s"the template for `${c.classes[k].name}` does not implement `${c.symbols[base].decl.name}`, which the trait leaves to each type")

/** Whether `t` is a derive template's `T`. */
private is_template_type(t: &Type) -> bool = *t match
    TypeVar(owner, _, _) -> is_template_owner(owner)
    _ -> false

private resolve_impl(c: *Checker, unit: usize, module_name: string, d: &ImplDecl) -> ImplSymbol
    val invalid = ImplSymbol(unit, module_name, d, ErrorType, 0, None, buf())
    // An impl's parameters are its type's, bounded where the type declares them. A bound of the
    // impl's own makes the conformance hold only for the type arguments that meet it.
    var conditional = false
    for tp in d.type_params
        if tp.bounds.len() > 0 then conditional = true
        if !(tp.variance is Invariant) then c.note(unit, tp.span, "variance is written on the parameters of a type, not of an impl")
        if tp.lower is Some(l) then c.note(unit, l.span, s"a lower bound is written on a function's or a method's own type parameter, not on `${tp.name}`")
    for m in d.members
        m match
            FieldMember(f) -> c.note(unit, f.span, s"an impl adds methods, not state, so it cannot declare the field `${f.name}`")
            AbstractFieldMember(f) -> c.note(unit, f.span, s"an impl adds methods, not state, so it cannot declare the field `${f.name}`")
            StatementMember(s) -> c.note(unit, s.span, "an impl's body declares only methods")
            MethodMember(_, _, _, _) -> ()
    if d.target.kind is Tuple(_) then return resolve_tuple_impl(c, unit, module_name, d)
    val path = d.target.kind match
        Named(p, _) -> p
        _ ->
            c.note(unit, d.target.span, "an impl adds to a data type, a class, an object or a built-in type")
            return invalid
    val written = d.target.kind match
        Named(_, args) -> args
        _ -> buf()
    var owner = 0usize
    var home = ""
    // An impl made from a template names the deriving type as the type's own file does.
    val target_unit = d.derived match
        Some(site) -> site.unit
        None -> unit
    val key = resolve_name(c, target_unit, path)
    if d.template then return resolve_template_impl(c, unit, module_name, d)
    if written.len() == 0 && names_type_param(d.type_params, path)
        return resolve_family_impl(c, unit, module_name, d)
    if c.types.get(key) is Some(id)
        owner = data_owner(id)
        home = c.data[id].module_name
    elif c.class_types.get(key) is Some(id)
        if is_trait(c, id)
            if d.trait_name is None then resolve_trait_impl(c, unit, module_name, d, id)
            else c.note(unit, d.target.span, s"`$path` is a trait; an impl of a trait is for a data type, a class, an object or a built-in type")
            return invalid
        owner = class_owner(id)
        home = c.classes[id].module_name
    elif builtin_type(path) is Some(_) then home = CoreModule
    else
        c.note(unit, d.target.span, s"unknown type `$path`")
        return invalid
    // The arguments written on the type are the impl's parameters, in order.
    var in_order = written.len() == d.type_params.len()
    if in_order
        for i in 0..<written.len()
            written[i].kind match
                Named(n, inner) -> if n != d.type_params[i].name || inner.len() > 0 then in_order = false
                _ -> in_order = false
    // Any other type built from the parameters is matched against each receiver's type, so its
    // methods are a call's to find; a conformance is a type's, at every instance of it. An impl
    // adding methods to a type of another module is matched the same way: its methods are not the
    // type's, so they reach no private member and no method table.
    if !in_order && d.trait_name is Some(_)
        c.note(unit, d.target.span, "the type an impl of a trait is for takes the impl's type parameters, in order, as in `impl[T] Display for Box[T]`")
        return invalid
    if !in_order || (d.trait_name is None && module_name != home)
        c.trait_impls.push(TraitImpl(unit, module_name, d, 0, false, module_name != home))
        return invalid
    val outer_generic = c.generic
    c.generic = Some(GenericScope(owner, d.type_params))
    val target = resolve_type(c, target_unit, d.target)
    var trait_type: Option[&Type] = None
    var trait_home = ""
    var function_type: Option[&Type] = None
    if d.trait_name is Some(written_trait)
        if written_trait.kind is Function(_, _)
            function_type = Some(resolve_type(c, unit, written_trait))
            if conditional then c.note(unit, written_trait.span, "an impl naming a function type has no bounds of its own")
    if d.trait_name is Some(written_trait) && function_type is None
        val t = resolve_bound(c, unit, written_trait)
        *t match
            Class(k, _, _) ->
                if is_trait(c, k)
                    trait_type = Some(t)
                    trait_home = c.classes[k].module_name
                else c.note(unit, written_trait.span, s"`${c.classes[k].name}` is not a trait; an impl names a trait before `for`")
            ErrorType -> ()
            _ -> c.note(unit, written_trait.span, s"${type_name(t)} is not a trait; an impl names a trait before `for`")
    var conditions: Buf[Buf[&Type]] = buf()
    if conditional && !(*target is ErrorType)
        if conditional_impl_refused(c, unit, d, target, trait_type)
            c.generic = outer_generic
            return invalid
        declare_bounds(c, unit, owner, d.type_params, 0, 0)
        for i in 0..<d.type_params.len()
            conditions.push(c.bounds.get(bound_key(owner, i, d.type_params[i])).unwrap_or(buf()))
    c.generic = outer_generic
    if *target is ErrorType then return invalid
    // An impl naming a function type makes the type a subtype of it; its body, if any, adds methods
    // as a plain impl's does, and the type's `apply` is what a call of a value as a function runs.
    if function_type is Some(f)
        if conditional then return invalid
        if module_name != home
            c.note(unit, d.target.span, s"`$path` is declared in another module; an impl making it a function belongs in that module")
            return invalid
        *target match
            Data(id, _, _) ->
                var functions = c.data[id].functions
                functions.push(f)
                c.data[id].functions = functions
            Class(id, _, _) ->
                var functions = c.classes[id].functions
                functions.push(f)
                c.classes[id].functions = functions
            _ ->
                c.note(unit, d.target.span, s"`$path` is a built-in type, which is not a function")
                return invalid
        return ImplSymbol(unit, module_name, d, target, owner, None, conditions)
    if d.trait_name is Some(_) && trait_type is None then return invalid
    if trait_type is Some(t)
        if refuse_closed_trait(c, unit, written_trait_span(d), t) then return invalid
    // A conformance is one answer everywhere, so it is stated where the type or the trait is.
    if trait_type is Some(t) && module_name != home && module_name != trait_home
        c.note(unit, d.target.span, s"neither `$path` nor `${type_name(t)}` is declared in this module; an impl belongs in the module of its type or of its trait")
        return invalid
    if trait_type is Some(t)
        *target match
            Data(id, _, _) ->
                if conforms_already(c, c.data[id].traits, t)
                    c.note(unit, written_trait_span(d), restated(c, path, t))
                    return invalid
                var traits = c.data[id].traits
                traits.push(t)
                c.data[id].traits = traits
            Class(_, _, _) -> ()
            _ ->
                if conforms_already(c, builtin_traits(c, target), t)
                    c.note(unit, written_trait_span(d), restated(c, path, t))
                    return invalid
                c.builtins.push(BuiltinConformance(target, t, unit, d.target.span, buf(), 0, buf()))
        if conditional
            if *t is Class(k, _, _) then c.conditional.push(ConditionalConformance(owner, k, conditions, unit, d.type_params))
    elif conditional then c.conditional_methods.push(ConditionalImpl(owner, conditions, unit, d.type_params))
    ImplSymbol(unit, module_name, d, target, owner, trait_type, conditions)

// An impl without `for` whose type is a trait adds methods to the trait, at any arguments built from
// the impl's parameters: `impl[T] Seq[T]` to every sequence, `impl[T] Seq[Seq[T]]` to a sequence of
// sequences. Written in another module than the trait's, it is an extension. Its methods are declared
// once every trait's own methods are.
private resolve_trait_impl(c: *Checker, unit: usize, module_name: string, d: &ImplDecl, id: usize)
    c.trait_impls.push(TraitImpl(unit, module_name, d, id, true, module_name != c.classes[id].module_name))

// Each method an impl adds to a trait is a generic function over the impl's parameters, then `Self`,
// the type of the value it is called on, bounded by the trait, then its own. Its receiver, `self`, is
// a `Self`, so its body reaches the value only through the trait's methods, and a call compiles it
// for the receiver's static type.
// The type the impl adds to is resolved once, with its parameters as those of a placeholder owner, to
// hold it to naming each of them: a call learns the impl's parameters only from its receiver's type.
private declare_trait_methods(c: *Checker, i: usize)
    val block = c.trait_impls[i]
    val placeholder = c.symbols.len()
    val outer_generic = c.generic
    c.generic = Some(GenericScope(placeholder, block.decl.type_params))
    // A trait is resolved as the bound it is of `Self`, so one whose methods mention `Self` is too.
    val target = if block.on_trait then resolve_bound(c, block.unit, block.decl.target) else resolve_type(c, block.unit, block.decl.target)
    c.generic = outer_generic
    if *target is ErrorType then return
    var complete = true
    for j in 0..<block.decl.type_params.len()
        if !names_param(target, placeholder, j)
            val tp = block.decl.type_params[j]
            c.note(block.unit, tp.span, s"`${tp.name}` is not part of `${show_type(block.decl.target)}`; each of an impl's type parameters is, so a call learns it from the receiver's type")
            complete = false
    if !complete then return
    for m in block.decl.members
        if m is MethodMember(f, public, overrides, static_member) then declare_trait_method(c, i, f, public, overrides, static_member, target, placeholder)

/** Whether type `t` names the `index`th type parameter of `owner`. */
private names_param(t: &Type, owner: usize, index: usize) -> bool = *t match
    TypeVar(o, i, _) -> o == owner && i == index
    Tuple(items) -> any_names_param(items, owner, index)
    Function(params, result) -> any_names_param(params, owner, index) || names_param(result, owner, index)
    ByName(inner) -> names_param(inner, owner, index)
    Data(_, _, args) -> any_names_param(args, owner, index)
    Class(_, _, args) -> any_names_param(args, owner, index)
    _ -> false

private any_names_param(items: Buf[&Type], owner: usize, index: usize) -> bool
    for t in items
        if names_param(t, owner, index) then return true
    false

private declare_trait_method(c: *Checker, i: usize, f: &Function, public: bool, overrides: bool, static_member: bool, written_target: &Type, placeholder: usize)
    val block = c.trait_impls[i]
    val unit = block.unit
    val k = block.trait_id
    val trait_name = if block.on_trait then c.classes[k].name else head_name(written_target)
    // A built-in type's static members may be added where its methods may, as an extension.
    if static_member && (block.on_trait || block.decl.type_params.len() > 0 || !scalar_builtin(written_target))
        val adds = if block.on_trait then "a trait's member and its implementations are" else "a type's own member is"
        c.note(unit, f.name_span, s"`${f.name}` is static, which only $adds; an impl adding to `$trait_name` adds methods of values")
        return
    if static_member
        if !static_member_allowed(c, unit, f, trait_name, false, false) then return
        if language_static(written_target, f.name)
            c.note(unit, f.name_span, s"`$trait_name.${f.name}` is the language's own, and no static member can redefine it")
            return
    if f.annotations.len() > 0
        c.note(unit, f.name_span, "annotations on methods are not implemented")
        return
    if overrides
        c.note(unit, f.name_span, s"`${f.name}` overrides nothing; the methods an impl adds to `$trait_name` are not the trait's, so no type implements or overrides them")
        return
    if block.on_trait && trait_declares(c, k, f.name, 0)
        c.note(unit, f.name_span, s"`${f.name}` is already a method of `$trait_name`; an impl adds to a trait only methods the trait does not declare")
        return
    val id = c.symbols.len()
    val impl_params = block.decl.type_params.len()
    var renamed: Buf[&Type] = buf()
    for j in 0..<impl_params
        renamed.push(TypeVar(id, j, block.decl.type_params[j].name))
    val target = substitute(written_target, placeholder, renamed)
    var type_params: Buf[TypeParam] = buf()
    for tp in block.decl.type_params
        type_params.push(tp)
    if block.on_trait
        var bound: Buf[&TypeExpr] = buf()
        bound.push(block.decl.target)
        type_params.push(TypeParam(block.decl.target.span, "Self", Invariant, bound, s"${c.units[unit].src.name}:${block.decl.span.start}:Self", None))
    for tp in f.type_params
        type_params.push(tp)
    // The impl's parameters and `Self` are bounded here, in this function's scope; `signature`
    // bounds the method's own.
    val outer_generic = c.generic
    c.generic = Some(GenericScope(id, type_params))
    declare_bounds(c, unit, id, type_params, 0, 0)
    c.generic = outer_generic
    val receiver: &Type = if block.on_trait then TypeVar(id, impl_params, "Self") else target
    var symbol = signature(c, unit, block.module_name, f, id, type_params, false, Some(receiver))
    var receiver_types: Buf[&Type] = buf()
    var receiver_names: Buf[string] = buf()
    receiver_types.push(receiver)
    receiver_names.push("self")
    for t in symbol.params
        receiver_types.push(t)
    for n in symbol.param_names
        receiver_names.push(n)
    symbol.params = receiver_types
    symbol.param_names = receiver_names
    // A method added to a type built from the impl's parameters is named with that type, which tells
    // it from a method of the same name another such impl adds.
    val nested = !block.on_trait || !in_order_target(target, id, impl_params)
    symbol.name = if nested then type_name(target) + "." + f.name else trait_name + "." + f.name
    symbol.public = public
    symbol.receiver = Some(receiver)
    var method_defaults: Buf[Option[usize]] = buf()
    for _ in receiver_types
        method_defaults.push(None)
    symbol.defaults = method_defaults
    // The methods impls of this module have added to this type under the name so far, which this
    // one overloads. Impls adding to different types built from one, as `Option[Option[T]]` and
    // `Option[List[T]]`, are told apart by the receiver at a call; extensions of two modules, by
    // which of the modules a file imports.
    // The bitwise and shift operators of the integers and bytes are the machine's, which no method
    // replaces.
    if bitwise_method_name(f.name) && (*target is Int(_) || *target is Byte)
        c.note(unit, f.name_span, s"`${f.name}` is the language's operator on ${type_name(target)}, and no method can redefine it")
        return
    // So are the arithmetic and orderings of every built-in type: only a data type, a class or a trait
    // has methods of those names, and an impl for every type would reach the built-in ones.
    if arithmetic_method_name(f.name) && !(*target is Data(_, _, _) || *target is Class(_, _, _))
        if *target is TypeVar(_, _, _) then c.note(unit, f.name_span, s"`${f.name}` names a method only of a data type, a class or a trait, and an impl for every type would redefine the built-in types' operator")
        else c.note(unit, f.name_span, s"`${f.name}` is the language's operator on ${type_name(target)}, and no method can redefine it")
        return
    var same_name: Buf[usize] = buf()
    for tm in c.trait_methods
        val other = c.symbols[tm.function]
        if other.decl.name == f.name && other.module_name == block.module_name && same_added_target(c, tm, block.on_trait, k, target, id, impl_params) then same_name.push(tm.function)
    if same_as_overload(c, symbol, same_name)
        c.note(unit, f.name_span, s"`${f.name}` is already added to `${if nested then type_name(target) else trait_name}` with the same parameter types; a method's overloads differ in their parameter types")
        return
    symbol.static_member = static_member
    if scalar_builtin(target)
        var named = receiver_methods(c, target, f.name)
        for m in same_name
            named.push(m)
        for m in named
            if c.symbols[m].static_member != static_member
                if static_member then c.note(unit, f.name_span, s"`${f.name}` is already a method of a value of `$trait_name`, so it cannot also be a static member of the type")
                else c.note(unit, f.name_span, s"`${f.name}` is already a static member of `$trait_name`, so it cannot also be a method of its values")
                return
    c.symbols.push(symbol)
    c.states.push(0)
    c.bodies.push(None)
    c.locals.push(buf())
    declare_defaults(c, id)
    c.trait_methods.push(TraitMethod(id, k, impl_params, block.on_trait, target, block.extension))
    same_name.push(id)
    if same_name.len() > 1 then mark_overloads(c, same_name)
    // The type's own methods are found first, so an extension one of them always hides could never
    // be called.
    if block.extension && !block.on_trait
        val own = *target match
            Class(t, _, _) -> methods_named(c, t, f.name)
            _ -> receiver_methods(c, target, f.name)
        for o in own
            if c.symbols[o].public && same_params_seen(c, target, o, id)
                c.note(unit, f.name_span, s"`${f.name}` is already a method of `${head_name(target)}` with the same parameter types, which a call always finds first; an extension adds methods the type does not have")
                return

/** The name of the type `t` is an instance of, as a diagnostic names it: `Option` for
 * `Option[Option[T]]`. */
private head_name(t: &Type) -> string = *t match
    Data(_, name, _) -> name
    Class(_, name, _) -> name
    _ -> type_name(t)

/** Whether `target`, the type an impl adds to, is its type at the impl's `count` parameters of
 * `owner`, in order, as `Seq[T]` is. */
private in_order_target(target: &Type, owner: usize, count: usize) -> bool
    val args = *target match
        Data(_, _, a) -> a
        Class(_, _, a) -> a
        _ -> return count == 0
    if args.len() != count then return false
    for j in 0..<count
        val named = *args[j] match
            TypeVar(o, i, _) -> o == owner && i == j
            _ -> false
        if !named then return false
    true

/** Whether method `tm` is added to the same type as an impl adding to `target`, whose parameters
 * are owner `owner`'s: to the same trait, or the same type built from parameters, the parameters
 * renamed alike. */
private same_added_target(c: *Checker, tm: TraitMethod, on_trait: bool, k: usize, target: &Type, owner: usize, count: usize) -> bool
    if tm.on_trait != on_trait then return false
    if on_trait && tm.trait_id != k then return false
    if tm.impl_params != count then return false
    var names: Buf[&Type] = buf()
    for j in 0..<count
        names.push(TypeVar(method_params_owner(), j, "T"))
    same_type(substitute(tm.target, tm.function, names), substitute(target, owner, names))

/** What the impls adding method `m` add to, as a diagnostic names it: a trait, or a type. */
private impls_owner(c: *Checker, m: usize) -> string = trait_method_of(c, m) match
    Some(tm) -> if tm.on_trait then c.classes[tm.trait_id].name else head_name(tm.target)
    None -> type_name(c.symbols[m].receiver.unwrap())

/** The impl's record of method `m` where an impl adds it to a trait. */
trait_method_of(c: *Checker, m: usize) -> Option[TraitMethod]
    for tm in c.trait_methods
        if tm.function == m then return Some(tm)
    None

/** Whether a value of type `t` is an instance of the type method `tm` is added to, at whatever
 * arguments: it conforms to the trait, or is of the data type, of the class or a subclass, or of the
 * built-in type. Whether its arguments match is `added_args`'s to say. */
private added_applies(c: *Checker, t: &Type, tm: TraitMethod) -> bool
    if tm.on_trait then return trait_view(c, t, tm.trait_id) is Some(_)
    val x = zonk(c, t)
    *tm.target match
        Data(d, _, _) -> *x match
            Data(e, _, _) -> d == e
            _ -> false
        Class(k, _, _) -> trait_view(c, x, k) is Some(_)
        _ -> added_args(c, x, tm) is Some(_)

/** The impl's type arguments a call of method `tm` takes on a value of type `t`: what the
 * receiver's static type gives each parameter in the type the impl adds to, or `None` where the
 * receiver's type does not match it. */
added_args(c: *Checker, t: &Type, tm: TraitMethod) -> Option[Buf[&Type]]
    var binds: Buf[Option[&Type]] = buf()
    for _ in 0..<tm.impl_params
        binds.push(None)
    if !match_target(c, tm.target, t, tm.function, &binds, true) then return None
    var out: Buf[&Type] = buf()
    for b in binds
        out.push(b.unwrap_or(ErrorType))
    Some(out)

// Matches `pattern`, a type built from the impl parameters `owner` owns, against `t`, a receiver's
// static type or a part of it, binding each parameter in `binds`. Where `covariant`, at the top and
// inside a covariant parameter, a reference is seen as the pattern's trait or class through its
// conformances and superclasses, as it is passed where one is expected: a `Vector[Vector[int]]` is a
// `Seq[Seq[int]]`. Elsewhere each part is the pattern's own type, and a parameter named twice takes
// one type.
private match_target(c: *Checker, pattern: &Type, t: &Type, owner: usize, binds: *Buf[Option[&Type]], covariant: bool) -> bool
    val x = zonk(c, t)
    if *x is ErrorType then return true
    *pattern match
        TypeVar(o, i, _) ->
            if o != owner then return same_type(pattern, x)
            binds[i] match
                Some(b) -> same_type(zonk(c, b), x)
                None ->
                    binds.set(i, Some(x))
                    true
        Data(d, _, ps) -> *x match
            Data(e, _, xs) -> d == e && match_args(c, c.data[d].decl.type_params, ps, xs, owner, binds, covariant)
            _ -> false
        Class(k, _, ps) ->
            var seen: Option[&Type] = None
            val same_class = *x match
                Class(j, _, _) -> j == k
                _ -> false
            if same_class then seen = Some(x)
            elif covariant then seen = trait_view(c, x, k)
            seen match
                Some(up) -> *up match
                    Class(_, _, xs) -> match_args(c, c.classes[k].decl.type_params, ps, xs, owner, binds, covariant)
                    _ -> false
                None -> false
        Tuple(ps) -> *x match
            Tuple(xs) -> ps.len() == xs.len() && match_parts(c, ps, xs, owner, binds, covariant)
            _ -> false
        Function(ps, r) -> *x match
            Function(xs, s) -> ps.len() == xs.len() && match_parts(c, ps, xs, owner, binds, false) && match_target(c, r, s, owner, binds, false)
            _ -> false
        _ -> same_type(pattern, x)

// The type arguments `ps` of a pattern matched against `xs`, each in a covariant position where the
// parameter it is for is covariant and the whole is.
private match_args(c: *Checker, params: Buf[TypeParam], ps: Buf[&Type], xs: Buf[&Type], owner: usize, binds: *Buf[Option[&Type]], covariant: bool) -> bool
    if ps.len() != xs.len() then return false
    for i in 0..<ps.len()
        val co = covariant && i < params.len() && params[i].variance is Covariant
        if !match_target(c, ps[i], xs[i], owner, binds, co) then return false
    true

private match_parts(c: *Checker, ps: Buf[&Type], xs: Buf[&Type], owner: usize, binds: *Buf[Option[&Type]], covariant: bool) -> bool
    for i in 0..<ps.len()
        if !match_target(c, ps[i], xs[i], owner, binds, covariant) then return false
    true

/** What a receiver must be for method `tm`, as a diagnostic says it: `an `Option` of an `Option``
 * for `Option[Option[T]]`, `a `Seq` of pairs` for `Seq[(A, B)]`; the type written out where it has
 * more than one part built from the parameters. */
private added_target_phrase(tm: TraitMethod) -> string = target_phrase(tm.target)

private target_phrase(t: &Type) -> string
    val inner = *t match
        Tuple(items) -> return if items.len() == 2 then "a pair" else s"a tuple of ${items.len()}"
        Data(_, _, args) -> args
        Class(_, _, args) -> args
        _ -> return s"`${type_name(t)}`"
    val name = head_name(t)
    var built: Option[&Type] = None
    for i in 0..<inner.len()
        val a = inner[i]
        if !(*a is TypeVar(_, _, _))
            if built is Some(_) then return s"`${type_name(t)}`"
            built = Some(a)
        else
            // A parameter named twice, as in `Either[A, A]`, asks the parts to agree, which only
            // the type written out says.
            for j in 0..<i
                if same_type(inner[j], a) then return s"`${type_name(t)}`"
    val article = if starts_with_vowel(name) then "an" else "a"
    built match
        Some(a) -> s"$article `$name` of ${target_phrase(a)}"
        None -> s"$article `$name`"

private starts_with_vowel(name: string) -> bool
    for v in ["A", "E", "I", "O", "U", "a", "e", "i", "o", "u"]
        if name.starts_with(v) then return true
    false

/** Whether `name` is one of `params`. */
private names_type_param(params: Buf[TypeParam], name: string) -> bool
    for tp in params
        if tp.name == name then return true
    false

// An impl for every integer width, `impl[T: Integer] Display for T`, adds to the integer family: its
// one type parameter, bounded by `Integer` alone, stands for the width of each instance. Only the
// core library declares one, and a trait it implements has no other impl for any width, since a
// conformance is stated once.
private resolve_family_impl(c: *Checker, unit: usize, module_name: string, d: &ImplDecl) -> ImplSymbol
    val invalid = ImplSymbol(unit, module_name, d, ErrorType, 0, None, buf())
    if module_name != CoreModule
        c.note(unit, d.target.span, "an impl for every type meeting a bound, as in `impl[T: Integer] Display for T`, is declared only in the core library")
        return invalid
    val outer_generic = c.generic
    c.generic = Some(GenericScope(integer_owner(), d.type_params))
    var bounded = d.type_params.len() == 1 && d.type_params[0].bounds.len() == 1
    if bounded
        bounded = *resolve_bound(c, unit, d.type_params[0].bounds[0]) match
            Class(k, _, _) -> is_class_named(c, k, qualified(CoreModule, "Integer"))
            _ -> false
    var trait_type: Option[&Type] = None
    if bounded && d.trait_name is Some(written_trait)
        val t = resolve_bound(c, unit, written_trait)
        *t match
            Class(k, _, _) ->
                if is_trait(c, k) then trait_type = Some(t)
                else c.note(unit, written_trait.span, s"`${c.classes[k].name}` is not a trait; an impl names a trait before `for`")
            ErrorType -> ()
            _ -> c.note(unit, written_trait.span, s"${type_name(t)} is not a trait; an impl names a trait before `for`")
    c.generic = outer_generic
    if !bounded
        c.note(unit, d.target.span, "an impl adds to a type parameter only where it is the impl's one parameter, bounded by `Integer` alone: the integer family")
        return invalid
    if d.trait_name is Some(_) && trait_type is None then return invalid
    val target = integer_family()
    if trait_type is Some(t)
        if refuse_closed_trait(c, unit, written_trait_span(d), t) then return invalid
        for b in c.builtins
            if (is_integer_family(b.ty) || *b.ty is Int(_)) && same_trait(b.trait_type, t)
                val which = if is_integer_family(b.ty) then "every integer width" else s"`${type_name(b.ty)}`"
                c.note(unit, written_trait_span(d), s"$which already conforms to `${type_name(t)}`; a conformance is stated once")
                return invalid
        c.builtins.push(BuiltinConformance(target, t, unit, d.target.span, buf(), 0, buf()))
    ImplSymbol(unit, module_name, d, target, integer_owner(), trait_type, buf())

// An impl for every tuple of some arity, `impl[A0: Display, A1: Display] Display for (A0, A1)`, adds
// to that arity's tuple family: its parameters, in order, are the tuple's parts, and a tuple of that
// many parts meets it where each part meets the parameter's bounds. Only the core library declares
// one, and it does so for every arity a program writes (`tuples.sysl`).
private resolve_tuple_impl(c: *Checker, unit: usize, module_name: string, d: &ImplDecl) -> ImplSymbol
    val invalid = ImplSymbol(unit, module_name, d, ErrorType, 0, None, buf())
    val parts = d.target.kind match
        Tuple(items) -> items
        _ -> return invalid
    if module_name != CoreModule
        c.note(unit, d.target.span, "an impl for every tuple of an arity, as in `impl[A: Display, B: Display] Display for (A, B)`, is declared only in the core library")
        return invalid
    var in_order = parts.len() == d.type_params.len()
    if in_order
        for i in 0..<parts.len()
            parts[i].kind match
                Named(n, inner) -> if n != d.type_params[i].name || inner.len() > 0 then in_order = false
                _ -> in_order = false
    if !in_order
        c.note(unit, d.target.span, "the tuple an impl is for has the impl's type parameters as its parts, in order, as in `impl[A, B] Display for (A, B)`")
        return invalid
    val owner = tuple_owner(parts.len())
    val outer_generic = c.generic
    c.generic = Some(GenericScope(owner, d.type_params))
    declare_bounds(c, unit, owner, d.type_params, 0, 0)
    var trait_type: Option[&Type] = None
    if d.trait_name is Some(written_trait)
        val t = resolve_bound(c, unit, written_trait)
        *t match
            Class(k, _, _) ->
                if is_trait(c, k) then trait_type = Some(t)
                else c.note(unit, written_trait.span, s"`${c.classes[k].name}` is not a trait; an impl names a trait before `for`")
            ErrorType -> ()
            _ -> c.note(unit, written_trait.span, s"${type_name(t)} is not a trait; an impl names a trait before `for`")
    c.generic = outer_generic
    val t = trait_type match
        Some(t) -> t
        None ->
            if d.trait_name is None then c.note(unit, d.target.span, "an impl for every tuple of an arity implements a trait")
            return invalid
    val target = tuple_family(parts.len())
    for b in c.builtins
        if same_type(b.ty, target) && same_trait(b.trait_type, t)
            c.note(unit, written_trait_span(d), s"`${type_name(target)}` already conforms to `${type_name(t)}`; a conformance is stated once")
            return invalid
    c.builtins.push(BuiltinConformance(target, t, unit, d.target.span, buf(), owner, d.type_params))
    ImplSymbol(unit, module_name, d, target, owner, trait_type, buf())

/** Whether the parts of tuple `t` meet the bounds of the parameters `params` of the tuple family
 * `owner` belongs to: where an impl for that family holds for `t`. Any other type holds at once. */
tuple_parts_hold(f: Conformances, owner: usize, params: Buf[TypeParam], t: &Type) -> bool
    if !is_tuple_owner(owner) then return true
    val parts = *t match
        Tuple(parts) -> parts
        _ -> return true
    for i in 0..<parts.len()
        if i >= params.len() then return false
        if f.bounds.get(bound_key(owner, i, params[i])) is Some(bounds)
            for b in bounds
                if !meets_bound(f, parts[i], b) then return false
    true

/** Whether `a` and `b` name one trait, with any type arguments. */
private same_trait(a: &Type, b: &Type) -> bool = *a match
    Class(x, _, _) -> *b match
        Class(y, _, _) -> x == y
        _ -> false
    _ -> false

// `Integer` is closed: its members are the integer types, every width, which the compiler decides.
// Nothing implements it, and no type names it as a trait it conforms to.
private refuse_closed_trait(c: *Checker, unit: usize, at: Span, t: &Type) -> bool
    val k = *t match
        Class(k, _, _) -> k
        _ -> return false
    if !is_class_named(c, k, qualified(CoreModule, "Integer")) then return false
    c.note(unit, at, "`Integer` is closed: its members are the integer types, and nothing else implements it")
    true

/** Whether class `k` is the one with qualified name `key`. */
private is_class_named(c: *Checker, k: usize, key: string) -> bool = c.class_types.get(key) match
    Some(x) -> x == k
    None -> false

private buf1u(x: usize) -> Buf[usize]
    var out: Buf[usize] = buf()
    out.push(x)
    out

// An impl with bounds of its own makes a data type or a class conform to a trait, or adds methods to
// it, for the type arguments that meet them. The conformance is decided wherever one is: where a
// bound is checked, where a value converts to the trait, where a type pattern tests it, and where one
// of the impl's methods is called; an added method, where it is called or taken as a value.
private conditional_impl_refused(c: *Checker, unit: usize, d: &ImplDecl, target: &Type, trait_type: Option[&Type]) -> bool
    val at = d.type_params[0].span
    if !(*target is Data(_, _, _) || *target is Class(_, _, _))
        c.note(unit, at, "an impl with bounds of its own is implemented for data types and classes only")
        return true
    val t = trait_type match
        Some(t) -> t
        None -> return false
    if *t is Class(k, _, _)
        // Every type compares and hashes, so an impl of `Eq` or `Hash` holds at every type argument,
        // and its bounds may only be ones every type meets.
        if is_class_named(c, k, qualified(CoreModule, "Eq")) || is_class_named(c, k, qualified(CoreModule, "Hash"))
            for tp in d.type_params
                for b in tp.bounds
                    val name = b.kind match
                        Named(path, _) -> path
                        _ -> ""
                    if name != "Eq" && name != "Hash"
                        c.note(unit, b.span, s"every type compares and hashes, so an impl of `${type_name(t)}` holds for every type argument; its bounds may be `Eq` and `Hash` only")
                        return true
            return false
    false

/** The traits built-in type `t` conforms to through its impls. */
private builtin_traits(c: *Checker, t: &Type) -> Buf[&Type]
    var out: Buf[&Type] = buf()
    for b in c.builtins
        if builtin_covers(b.ty, t) && (is_tuple_family(t) || tuple_parts_hold(conformances(c), b.owner, b.params, t)) then out.push(b.trait_type)
    out

/** Whether `traits` already holds the trait `t` names, with any type arguments. */
private conforms_directly(traits: Buf[&Type], t: &Type) -> bool
    val id = *t match
        Class(k, _, _) -> k
        _ -> return false
    for other in traits
        if *other is Class(o, _, _)
            if o == id then return true
    false

/** The error for a conformance of type `who` to `t` stated again. */
private restated(c: *Checker, who: string, t: &Type) -> string
    if *t is Class(k, _, _)
        if is_trait(c, k) && c.classes[k].decl.type_params.len() > 0 && !implemented_several_times(c, k)
            return s"`$who` already conforms to `${c.classes[k].name}`; a type implements a trait at several type arguments only where the trait's members are all static"
    s"`$who` already conforms to `${type_name(t)}`; a conformance is stated once"

/** Whether `traits` already holds the conformance `t` states: the trait with any type arguments, or
 * for a trait a type may implement several times, with the same ones. */
private conforms_already(c: *Checker, traits: Buf[&Type], t: &Type) -> bool
    val id = *t match
        Class(k, _, _) -> k
        _ -> return false
    if !implemented_several_times(c, id) then return conforms_directly(traits, t)
    for other in traits
        if same_trait(other, t) && same_type(other, t) then return true
    false

// A generic trait whose members are all static may be implemented by one type at several type
// arguments, `From[IoError]` and `From[ParseError]`: no value of it exists, so no method table holds
// its members, and each call names the type and finds the member by its parameter types.
private implemented_several_times(c: *Checker, k: usize) -> bool = is_trait(c, k) && several_conformances(c.classes[k].decl)

/** Whether trait `d` may be implemented by one type at several type arguments: it is generic,
 * requires no other trait, and its members are all static. */
several_conformances(d: &ClassDecl) -> bool
    if d.type_params.len() == 0 || d.parents.len() > 0 then return false
    var any = false
    for m in d.members
        m match
            MethodMember(_, _, _, static_member) ->
                if !static_member then return false
                any = true
            _ -> return false
    any

private written_trait_span(d: &ImplDecl) -> Span = d.trait_name match
    Some(t) -> t.span
    None -> d.target.span

/** Whether the trait `t` declares a method named `name`, or one of the traits it requires does. */
private trait_declares(c: *Checker, t: usize, name: string, depth: usize) -> bool
    if depth > c.classes.len() then return false
    for m in c.classes[t].decl.members
        m match
            MethodMember(f, _, _, _) -> if f.name == name then return true
            AbstractFieldMember(f) -> if f.name == name then return true
            _ -> ()
    for required in c.classes[t].traits
        if *required is Class(r, _, _)
            if trait_declares(c, r, name, depth + 1) then return true
    false

/** Whether the member `name` of trait `t`, or of a trait it requires, is static; `None` where neither
 * declares one of that name. */
private trait_member_static(c: *Checker, t: usize, name: string, depth: usize) -> Option[bool]
    if depth > c.classes.len() then return None
    for m in c.classes[t].decl.members
        m match
            MethodMember(f, _, _, static_member) -> if f.name == name then return Some(static_member)
            AbstractFieldMember(f) -> if f.name == name then return Some(false)
            _ -> ()
    for required in c.classes[t].traits
        if *required is Class(r, _, _)
            if trait_member_static(c, r, name, depth + 1) is Some(s) then return Some(s)
    None

// An implementation of trait `t`'s member is static exactly where the member is.
private static_mirrors_trait(c: *Checker, unit: usize, f: &Function, t: usize, static_member: bool) -> bool
    val declared = trait_member_static(c, t, f.name, 0) match
        Some(s) -> s
        None -> return true
    if declared == static_member then return true
    report_static_mismatch(c, unit, f.name_span, f.name, c.classes[t].name, declared)
    false

private report_static_mismatch(c: *Checker, unit: usize, at: Span, name: string, trait_name: string, declared: bool)
    if declared then c.note(unit, at, s"`$name` is a static member of `$trait_name`, so its implementation is `static` too")
    else c.note(unit, at, s"`$name` is a method of `$trait_name`'s values, so its implementation is not `static`")

// A static member of a trait is abstract: each implementing type gives its own, and no trait's
// default body could be any type's. Anywhere else a static member has a body.
private static_member_allowed(c: *Checker, unit: usize, f: &Function, owner_name: string, in_trait: bool, overrides: bool) -> bool
    val bodyless = f.body is None && f.clauses.len() == 0
    if in_trait
        if overrides
            c.note(unit, f.name_span, s"`${f.name}` is static, so no trait overrides it: each type implementing the trait gives its own")
            return false
        if !bodyless
            c.note(unit, f.name_span, s"`${f.name}` is a static member of `$owner_name`, so it has no default body: each type implementing `$owner_name` gives its own")
            return false
        return true
    if bodyless
        c.note(unit, f.name_span, s"`${f.name}` is static, so it needs a body: it belongs to `$owner_name` itself")
        return false
    true

/** Whether `t` is one of the built-in scalar types, `string` among them, whose own static members an
 * impl without a trait declares: no companion object can be declared for them. */
private scalar_builtin(t: &Type) -> bool = *t match
    Str -> true
    Char -> true
    Bool -> true
    Real -> true
    Byte -> true
    Int(_) -> true
    _ -> false

/** Whether `t.name` is a member the language gives built-in type `t`: the conversion `wrap`, which
 * every built-in type's name is read for, and the limits of a numeric type and `char`. */
private language_static(t: &Type, name: string) -> bool
    if name == "wrap" then return true
    if !(*t is Int(_) || *t is Byte || *t is Char || *t is Real) then return false
    if name == "MaxValue" || name == "MinValue" then return true
    *t is Real && (name == "MinPositiveValue" || name == "PositiveInfinity" || name == "NegativeInfinity" || name == "NaN")

// A variant's fields are resolved with its type's parameters in scope. Variant names share one
// space within a file, since a variant is named on its own (`Some(1)`, `None`) wherever it is used.
private declare_variants(c: *Checker, unit: usize)
    var seen: Map[string, Span] = map()
    for id in 0..<c.data.len()
        val d = c.data[id]
        if d.unit != unit then continue
        val outer_generic = c.generic
        c.generic = Some(GenericScope(data_owner(id), d.decl.type_params))
        declare_bounds(c, unit, data_owner(id), d.decl.type_params, 0, d.decl.type_params.len())
        var variants: Buf[VariantSymbol] = buf()
        for v in d.decl.variants
            if seen.get(v.name) is Some(_)
                c.note(unit, v.span, s"the variant `${v.name}` is declared more than once")
                continue
            seen.put(v.name, v.span)
            var names: Buf[string] = buf()
            var fields: Buf[&Type] = buf()
            for f in v.fields
                f.pattern.kind match
                    Name(n) ->
                        if contains_name(names, n) then c.note(unit, f.pattern.span, s"the field `$n` is declared more than once")
                        names.push(n)
                    _ ->
                        c.note(unit, f.pattern.span, "a field is a name and a type")
                        names.push("_")
                fields.push(resolve_type(c, unit, f.ty))
            // A variant is a name of its type's module, private where its type is.
            val key = qualified(c.data[id].module_name, v.name)
            c.variants.put(key, VariantRef(id, variants.len()))
            if c.private_names.get(qualified(c.data[id].module_name, c.data[id].name)) is Some(_) then c.private_names.put(key, true)
            variants.push(VariantSymbol(v.name, v.span, names, fields, field_defaults(c, unit, id, v, names, fields)))
        c.data[id].variants = variants
        c.generic = outer_generic

// The defaults of a variant's fields, as a constructor's: each a function of the fields before it,
// sharing the data type's type parameters, called where a construction omits the field.
private field_defaults(c: *Checker, unit: usize, id: usize, v: Variant, names: Buf[string], fields: Buf[&Type]) -> Buf[Option[usize]]
    val d = c.data[id]
    var defaults: Buf[Option[usize]] = buf()
    for i in 0..<v.fields.len()
        val value = v.fields[i].default match
            Some(e) -> e
            None ->
                defaults.push(None)
                continue
        val did = c.symbols.len()
        var params: Buf[&Type] = buf()
        var param_names: Buf[string] = buf()
        var decls: Buf[Param] = buf()
        for k in 0..<i
            params.push(fields[k])
            param_names.push(names[k])
            decls.push(v.fields[k])
        val name = s"${v.name}/${names[i]}"
        val decl = Function(buf(), value.span, v.fields[i].span, name, d.decl.type_params, decls, None, Some(value), buf())
        c.symbols.push(FunctionSymbol(unit, d.module_name, name, decl, params, param_names, Some(fields[i]), None, None, buf(), buf(), buf(), false, false, false, buf(), Some(names[i]), data_owner(id), d.decl.type_params, None, false, true, "", None, false))
        c.states.push(0)
        c.bodies.push(None)
        c.locals.push(buf())
        defaults.push(Some(did))
    defaults

/** The type of an instance of a class, with the class's own parameters as its arguments: the type of
 * `self` in its constructor and methods. */
own_class_type(k: ClassSymbol, id: usize) -> &Type
    var args: Buf[&Type] = buf()
    for i in 0..<k.decl.type_params.len()
        args.push(TypeVar(class_owner(id), i, k.decl.type_params[i].name))
    Class(id, k.name, args)

// A class's fields: its parameters, then the `val` and `var` fields of its body, resolved with the
// class's type parameters in scope. What this compiler does not build yet is reported here, once.
private declare_fields(c: *Checker, unit: usize)
    for id in 0..<c.classes.len()
        val k = c.classes[id]
        if k.unit != unit then continue
        val d = k.decl
        // `@sysl` on a class is checked where the class is declared.
        for a in d.annotations
            if a.name != "sysl" || d.object then c.note(unit, a.span, s"unknown annotation `@${a.name}`")
        val declares_trait = is_trait(c, id)
        if declares_trait
            for m in d.members
                m match
                    FieldMember(f) ->
                        val keyword = if f.mutable then "var" else "val"
                        if !f.public then c.note(unit, f.span, s"`${f.name}` is declared in a trait, so it cannot be private")
                        elif f.lazy then c.note(unit, f.span, s"`${f.name}` is declared in a trait, so it cannot be lazy: each conforming class computes it as it is made")
                        elif f.declared is None then c.note(unit, f.span, s"`${f.name}` is a trait's field, so it declares its type, as in `$keyword ${f.name}: int = …`")
                    AbstractFieldMember(f) ->
                        if f.mutable then c.note(unit, f.span, s"`${f.name}` has no value, so it is a trait's `val`, which is never assigned through the trait; write `val ${f.name}`, or give the `var` a value")
                        elif !f.public then c.note(unit, f.span, s"`${f.name}` is declared in a trait, so it cannot be private")
                    StatementMember(s) -> c.note(unit, s.span, "a trait has no constructor, so its body declares only methods")
                    _ -> ()
        else
            for m in d.members
                if m is AbstractFieldMember(f)
                    c.note(unit, f.span, s"`${f.name}` has no value; only a trait declares a `val` without one, and a class gives each of its fields a value where it declares it")
        val outer_generic = c.generic
        c.generic = Some(GenericScope(class_owner(id), d.type_params))
        declare_bounds(c, unit, class_owner(id), d.type_params, 0, d.type_params.len())
        var traits: Buf[&Type] = buf()
        var functions = c.classes[id].functions
        for i in 0..<d.parents.len()
            val parent = d.parents[i]
            if c.index is Some(_)
                if parent_name(parent) is Some(n)
                    if c.class_types.get(resolve_name(c, unit, n)) is Some(k) then index_class(c, unit, Span(parent.span.start, parent.span.start + n.bytes.len), k)
            if parent.kind is TypeParent(written)
                val f = resolve_type(c, unit, written)
                if *f is Function(_, _) then functions.push(f)
                elif !(*f is ErrorType) then c.note(unit, parent.span, s"${type_name(f)} is neither a class nor a trait")
            elif parent_trait(c, unit, parent) is Some(t)
                if trait_type(c, unit, t, parent) is Some(ty)
                    if conforms_already(c, traits, ty) then c.note(unit, parent.span, s"`${c.classes[t].name}` is named more than once after `:`")
                    else traits.push(ty)
            elif i == 0 && !declares_trait then c.classes[id].superclass = superclass_of(c, unit, id, parent)
            else
                var is_class = false
                if parent_name(parent) is Some(n)
                    if c.class_types.get(resolve_name(c, unit, n)) is Some(_) then is_class = true
                if !is_class then c.note(unit, parent.span, s"`${parent_name(parent).unwrap_or("this")}` is not a trait")
                elif declares_trait then c.note(unit, parent.span, "a trait may require only traits, not a class")
                else c.note(unit, parent.span, "the superclass comes first after `:`, before the traits")
        // An impl of a trait for the class is the same conformance as one its header states.
        for i in 0..<c.impls.len()
            val block = c.impls[i]
            val t = block.trait_type match
                Some(t) -> t
                None -> continue
            if *block.target is Class(target, _, _)
                if target != id then continue
                if conforms_already(c, traits, t)
                    val message = restated(c, d.name, t)
                    derived_of_impl(c, i) match
                        Some(x) -> derived_note(c, x, message)
                        None -> c.note(block.unit, written_trait_span(block.decl), message)
                    c.impls[i].target = ErrorType
                else traits.push(t)
        c.classes[id].traits = traits
        c.classes[id].functions = functions
        var fields: Buf[FieldSymbol] = buf()
        for cp in d.params
            val name = cp.param.pattern.kind match
                Name(n) -> n
                _ -> "_"
            if field_named(fields, name) is Some(_) then c.note(unit, cp.param.pattern.span, s"the field `$name` is declared more than once")
            val written = resolve_type(c, unit, cp.param.ty)
            val field_type = if cp.param.variadic then vector_of(c, written) else written
            fields.push(FieldSymbol(name, cp.param.pattern.span, Some(field_type), cp.mutable, cp.public, true, id, false))
        var state: Buf[TraitState] = buf()
        for m in d.members
            if m is FieldMember(f)
                if field_named(fields, f.name) is Some(_) then c.note(unit, f.span, s"the field `${f.name}` is declared more than once")
                var ty: Option[&Type] = None
                if f.declared is Some(t) then ty = Some(resolve_type(c, unit, t))
                // A trait's field is stored by each class conforming to it; the trait reads it
                // through the method its `val` is.
                if declares_trait
                    if f.public && !f.lazy && ty is Some(_)
                        var seen = false
                        for s in state
                            if s.field.name == f.name then seen = true
                        if seen then c.note(unit, f.span, s"the field `${f.name}` is declared more than once")
                        else state.push(TraitState(FieldSymbol(f.name, f.span, ty, f.mutable, true, false, id, false), f, 0, None, 0))
                    continue
                fields.push(FieldSymbol(f.name, f.span, ty, f.mutable, f.public, false, id, f.lazy))
                if f.lazy
                    fields.push(FieldSymbol(s"<state of ${f.name}>", f.span, Some(Int(64)), false, false, false, id, false))
                    fields.push(FieldSymbol(s"<initializer of ${f.name}>", f.span, lazy_initializer_type(ty), false, false, false, id, false))
        c.classes[id].fields = fields
        c.classes[id].state = state
        c.generic = outer_generic

/** Whether a class may be extended: one declared `open` or `abstract`. */
private is_open(c: *Checker, k: usize) -> bool = c.classes[k].decl.modifier != ""

/** Whether a class is abstract, so it cannot be instantiated: an abstract class or a trait. */
private is_abstract_class(c: *Checker, k: usize) -> bool = c.classes[k].decl.modifier == "abstract" || is_trait(c, k)

/** Whether a class symbol is a trait. */
is_trait(c: *Checker, k: usize) -> bool = c.classes[k].decl.modifier == "trait"

/** The trait a parent after `:` names, if it names one: `Shape`, `Source[int]`, or a mistaken
 * `Shape(…)`, which `trait_type` reports. */
private parent_trait(c: *Checker, unit: usize, parent: &Expr) -> Option[usize]
    val k = c.class_types.get(resolve_name(c, unit, parent_name(parent)?))?
    if is_trait(c, k) then Some(k) else None

/** The name a parent after `:` is written with, without its type or constructor arguments. */
private parent_name(parent: &Expr) -> Option[string]
    var named = parent
    if named.kind is Call(target, _) then named = target
    if named.kind is TypeApply(inner, _) then named = inner
    named.kind match
        Name(n) -> Some(n)
        _ -> None

// A trait after `:`, named with its type arguments when it is generic and without arguments of its
// own: a trait has no constructor.
private trait_type(c: *Checker, unit: usize, t: usize, parent: &Expr) -> Option[&Type]
    val name = c.classes[t].name
    if parent.kind is Call(_, _)
        c.note(unit, parent.span, s"`$name` is a trait, which has no constructor; name it without arguments")
        return None
    var written: Buf[&TypeExpr] = buf()
    if parent.kind is TypeApply(_, types) then written = types
    var args: Buf[&Type] = buf()
    for w in written
        args.push(resolve_type(c, unit, w))
    val wanted = c.classes[t].decl.type_params.len()
    if args.len() != wanted
        if args.len() == 0 then c.note(unit, parent.span, s"`$name` is generic; write its type arguments, as in `$name[int]`")
        else c.note(unit, parent.span, s"`$name` takes ${count(wanted, "type argument")}, not ${args.len()}")
        return None
    check_type_args(c, unit, parent.span, s"`$name`", class_owner(t), c.classes[t].decl.type_params, args)
    val resolved: &Type = Class(t, name, args)
    if refuse_closed_trait(c, unit, parent.span, resolved) then return None
    Some(resolved)

// The superclass after `:`: a class, called with its constructor arguments or named alone when it
// takes none, its type arguments written when it is generic. Its arguments are checked with the
// constructor.
private superclass_of(c: *Checker, unit: usize, id: usize, parent: &Expr) -> Option[&Type]
    var callee = parent
    if parent.kind is Call(target, _) then callee = target
    var written: Buf[&TypeExpr] = buf()
    var named = callee
    if callee.kind is TypeApply(inner, types)
        written = types
        named = inner
    val name = named.kind match
        Name(n) -> n
        _ ->
            c.note(unit, parent.span, "expected a superclass, as in `Base(arguments)`")
            return None
    val key = resolve_name(c, unit, name)
    val sid = c.class_types.get(key) match
        Some(s) -> s
        None ->
            if c.types.get(key) is Some(_) || builtin_type(name) is Some(_)
                c.note(unit, named.span, s"`$name` is not a class, so it cannot be extended")
            else c.note(unit, named.span, s"`$name` is neither a class nor a trait")
            return None
    val s = c.classes[sid]
    if !is_open(c, sid)
        c.note(unit, named.span, s"`$name` is final; declare it `open` or `abstract` to extend it")
        return None
    var args: Buf[&Type] = buf()
    for t in written
        args.push(resolve_type(c, unit, t))
    if args.len() != s.decl.type_params.len()
        if args.len() == 0 then c.note(unit, named.span, s"`$name` is generic; write its type arguments, as in `$name[int](…)`")
        else c.note(unit, named.span, s"`$name` takes ${count(s.decl.type_params.len(), "type argument")}, not ${args.len()}")
        return None
    Some(Class(sid, name, args))

// A subclass's fields are its superclass's, at the same positions and with the superclass's type
// arguments substituted, followed by its own. A field of its own may share the name of an inherited
// one only when one of the two is private: a public field is never overridden.
private inherit_fields(c: *Checker, id: usize)
    if c.classes[id].linked == 2 then return
    val k = c.classes[id]
    if k.linked == 1
        c.note(k.unit, k.decl.name_span, s"`${k.name}` inherits from itself")
        c.classes[id].superclass = None
        return
    var sid = 0usize
    var args: Buf[&Type] = buf()
    if k.superclass is Some(t)
        if *t is Class(s, _, a)
            sid = s
            args = a
    if k.superclass is None
        c.classes[id].linked = 2
        mix_fields(c, id)
        return
    c.classes[id].linked = 1
    inherit_fields(c, sid)
    if c.classes[id].superclass is None
        c.classes[id].linked = 2
        mix_fields(c, id)
        return
    var fields: Buf[FieldSymbol] = buf()
    for f in c.classes[sid].fields
        var copy = f
        if f.ty is Some(t) then copy.ty = Some(substitute(t, class_owner(sid), args))
        fields.push(copy)
    val inherited = fields.len()
    for f in k.fields
        for i in 0..<inherited
            if fields[i].name == f.name && fields[i].public && f.public
                c.note(k.unit, f.span, s"`${f.name}` is already a field of `${c.classes[fields[i].owner].name}`; a field cannot be overridden")
        fields.push(f)
    c.classes[id].fields = fields
    c.classes[id].inherited = inherited
    c.classes[id].linked = 2
    mix_fields(c, id)

// A class stores the fields of the traits it conforms to that its superclass does not, after its
// parameters: trait by trait, a trait's required traits before it and each trait once, in the order
// of its `:` list, each trait's fields in declaration order. That is also the order the constructor
// initializes them in. A field of a trait shares its name with no other field of the class.
private mix_fields(c: *Checker, id: usize)
    val k = c.classes[id]
    if is_trait(c, id) then return
    var order: Buf[&Type] = buf()
    var visiting: Buf[usize] = buf()
    for t in k.traits
        mixing_order(c, k.superclass, t, &order, &visiting)
    var fields: Buf[FieldSymbol] = buf()
    val at = k.inherited + k.decl.params.len()
    for i in 0..<at
        fields.push(k.fields[i])
    var mixed: Buf[MixedField] = buf()
    for t in order
        val tid = *t match
            Class(x, _, _) -> x
            _ -> continue
        val args = *t match
            Class(_, _, a) -> a
            _ -> buf()
        val state = c.classes[tid].state
        for j in 0..<state.len()
            val s = state[j]
            val name = s.field.name
            var clash = false
            for i in 0..<k.fields.len()
                val f = k.fields[i]
                if f.name != name then continue
                clash = true
                if i >= k.inherited then c.note(k.unit, f.span, s"`$name` is a field of `${c.classes[tid].name}`, which `${k.name}` stores; a class does not declare a field of a trait's name")
                else c.note(k.unit, k.decl.name_span, s"`$name` is already a field of `${c.classes[f.owner].name}`, so `${k.name}` cannot also store `${c.classes[tid].name}`'s field `$name`")
            for m in mixed
                val other = c.classes[m.trait_id].state[m.state].field
                if other.name == name && !clash
                    clash = true
                    c.note(k.unit, k.decl.name_span, s"`${k.name}` conforms to `${c.classes[m.trait_id].name}` and `${c.classes[tid].name}`, which both declare the field `$name`; one class cannot store both")
            if clash then continue
            var copy = s.field
            if s.field.ty is Some(ty) then copy.ty = Some(substitute(ty, class_owner(tid), args))
            fields.push(copy)
            mixed.push(MixedField(t, tid, j))
    if mixed.len() == 0 then return
    for i in at..<k.fields.len()
        fields.push(k.fields[i])
    c.classes[id].fields = fields
    c.classes[id].mixed = mixed

/** The trait among `t` and those it requires that declares a field with a value, if any. */
private stateful_trait(c: *Checker, t: usize, depth: usize) -> Option[usize]
    if depth > 64 then return None
    if c.classes[t].state.len() > 0 then return Some(t)
    for r in c.classes[t].traits
        if *r is Class(x, _, _)
            if stateful_trait(c, x, depth + 1) is Some(s) then return Some(s)
    None

// Only a class or an object stores a trait's fields: an impl of a trait that has any, or requires
// one that has, for a data type, a built-in type, a tuple or a trait is an error.
private refuse_stateful_impls(c: *Checker)
    for i in 0..<c.impls.len()
        val block = c.impls[i]
        val t = block.trait_type match
            Some(x) -> *x match
                Class(t, _, _) -> t
                _ -> continue
            None -> continue
        if *block.target is ErrorType then continue
        if *block.target is Class(x, _, _)
            if !is_trait(c, x) then continue
        val holder = stateful_trait(c, t, 0) match
            Some(s) -> s
            None -> continue
        val field = c.classes[holder].state[0].field.name
        c.note(block.unit, written_trait_span(block.decl), s"`${c.classes[t].name}` holds state, the field `$field` of `${c.classes[holder].name}`, which only a class or an object stores; ${type_name(block.target)} cannot conform to it")
        // The conformance the impl stated is withdrawn, so nothing more is reported of it.
        if *block.target is Data(d, _, _)
            var kept: Buf[&Type] = buf()
            for x in c.data[d].traits
                if *x is Class(k, _, _)
                    if k == t then continue
                kept.push(x)
            c.data[d].traits = kept
        var builtins: Buf[BuiltinConformance] = buf()
        for b in c.builtins
            if *b.trait_type is Class(k, _, _)
                if k == t && same_type(b.ty, block.target) then continue
            builtins.push(b)
        c.builtins = builtins
        c.impls[i].target = ErrorType

/** Adds trait `t` to `order` after the traits it requires, unless it is there already or the
 * superclass `sup` conforms to it, so that its fields are the superclass's. */
private mixing_order(c: *Checker, sup: Option[&Type], t: &Type, order: *Buf[&Type], visiting: *Buf[usize])
    val tid = *t match
        Class(x, _, _) -> x
        _ -> return
    for i in 0..<visiting.len()
        if visiting[i] == tid then return
    visiting.push(tid)
    val args = *t match
        Class(_, _, a) -> a
        _ -> buf()
    for r in c.classes[tid].traits
        mixing_order(c, sup, substitute(r, class_owner(tid), args), order, visiting)
    for i in 0..<order.len()
        if *order[i] is Class(x, _, _)
            if x == tid then return
    if sup is Some(s)
        if ancestor_type(c.classes, c.data, s, tid) is Some(_) then return
    order.push(t)

// An inherited field declared without a type has its type once its own class's body is checked.
private settle_inherited_fields(c: *Checker, id: usize)
    val k = c.classes[id]
    if k.inherited == 0 then return
    var sid = 0usize
    var args: Buf[&Type] = buf()
    if k.superclass is Some(t)
        if *t is Class(s, _, a)
            sid = s
            args = a
    settle_inherited_fields(c, sid)
    for i in 0..<k.inherited
        c.classes[id].fields[i].ty = Some(substitute(c.classes[sid].fields[i].ty.unwrap_or(ErrorType), class_owner(sid), args))

/** The type `t`, an instance of a class or a trait, as an instance of the class or trait `target`,
 * or `None` when `target` is not among its ancestors: its superclasses and the traits they and it
 * conform to, and the traits those require. */
ancestor_type(classes: Buf[ClassSymbol], data: Buf[DataSymbol], t: &Type, target: usize) -> Option[&Type]
    // A data type conforms to the traits its impls name, and to those they require.
    if *t is Data(d, _, xs)
        for required in data[d].traits
            if ancestor_type(classes, data, substitute(required, data_owner(d), xs), target) is Some(found) then return Some(found)
        return None
    val k = *t match
        Class(k, _, _) -> k
        _ -> return None
    if k == target then return Some(t)
    val args = *t match
        Class(_, _, a) -> a
        _ -> buf()
    for required in classes[k].traits
        if ancestor_type(classes, data, substitute(required, class_owner(k), args), target) is Some(found) then return Some(found)
    ancestor_type(classes, data, substitute(classes[k].superclass?, class_owner(k), args), target)

/** The function type a value of type `t`, an instance of a class, a trait or a data type, is a
 * subtype of: one its own declaration or an impl names, or one of its superclass's or of a trait it
 * conforms to, in `t`'s type arguments; `None` where it is no function. */
function_ancestor(classes: Buf[ClassSymbol], data: Buf[DataSymbol], t: &Type) -> Option[&Type]
    var found: Buf[&Type] = buf()
    function_ancestors(classes, data, t, &found, 0)
    if found.len() > 0 then Some(found[0]) else None

/** Every function type `t` is a subtype of, each once, as `function_ancestor` finds them. */
function_ancestors(classes: Buf[ClassSymbol], data: Buf[DataSymbol], t: &Type, out: *Buf[&Type], depth: usize)
    if depth > 64 then return
    *t match
        Data(d, _, xs) ->
            for f in data[d].functions
                add_function_type(out, substitute(f, data_owner(d), xs))
            for required in data[d].traits
                function_ancestors(classes, data, substitute(required, data_owner(d), xs), out, depth + 1)
        Class(k, _, xs) ->
            for f in classes[k].functions
                add_function_type(out, substitute(f, class_owner(k), xs))
            for required in classes[k].traits
                function_ancestors(classes, data, substitute(required, class_owner(k), xs), out, depth + 1)
            if classes[k].superclass is Some(sup)
                function_ancestors(classes, data, substitute(sup, class_owner(k), xs), out, depth + 1)
        _ -> ()

private add_function_type(out: *Buf[&Type], f: &Type)
    for i in 0..<out.len()
        if same_type(out[i], f) then return
    out.push(f)

// `x`, the type of a value, seen as the type `to`: what the value already is as an instance of
// `to`'s class, trait, data type, tuple or function type, with no conversion. An instance of a
// subclass is one of its superclass; an instance of a generic type is another instance of it where
// each type argument follows the parameter's declared variance; a tuple's parts are covariant; a
// function's parameters are contravariant and its result covariant. Where `x` is not such a view of
// `to`, the result is `x` itself or a type that differs from `to`. Both types are solved. A
// conformance an impl with bounds of its own states is a view only where `x`'s arguments meet them.
// A type parameter with a lower bound is a view of what the bound is.
view_as(f: Conformances, x: &Type, to: &Type) -> &Type = *to match
    Class(k, name, ys) -> holding_ancestor(f, x, k) match
        Some(up) -> *up match
            Class(_, _, xs) -> Class(k, name, vary_args(f, f.classes[k].decl.type_params, xs, ys))
            _ -> up
        None -> x
    Data(d, name, ys) -> *x match
        Data(e, _, xs) ->
            if e != d then return x
            Data(d, name, vary_args(f, f.data[d].decl.type_params, xs, ys))
        _ -> x
    Tuple(ys) -> *x match
        Tuple(xs) ->
            if xs.len() != ys.len() then return x
            var items: Buf[&Type] = buf()
            for i in 0..<xs.len()
                items.push(view_part(f, xs[i], ys[i]))
            Tuple(items)
        _ -> x
    Function(ys, s) -> *x match
        Function(xs, r) ->
            if xs.len() != ys.len() then return x
            var params: Buf[&Type] = buf()
            for i in 0..<xs.len()
                params.push(view_contra(f, xs[i], ys[i]))
            Function(params, view_part(f, r, s))
        // A class or data type whose values are functions is a subtype of its function type.
        Class(_, _, _) -> view_function(f, x, to)
        Data(_, _, _) -> view_function(f, x, to)
        _ -> x
    // A type parameter with a lower bound is a supertype of the bound.
    TypeVar(_, _, _) -> if below_lower(f, x, to) then to else x
    _ -> x

// A value of class or data type `x` seen as the function type `to`, through the function type `x` is
// a subtype of; `x` itself where it is none.
private view_function(f: Conformances, x: &Type, to: &Type) -> &Type = function_ancestor(f.classes, f.data, x) match
    Some(up) -> view_as(f, up, to)
    None -> x

// The type arguments `xs` seen as `ys`, one parameter's variance at a time.
private vary_args(f: Conformances, params: Buf[TypeParam], xs: Buf[&Type], ys: Buf[&Type]) -> Buf[&Type]
    if xs.len() != ys.len() || xs.len() != params.len() then return xs
    var out: Buf[&Type] = buf()
    for i in 0..<xs.len()
        val v = params[i].variance
        // No value has type `Nothing`, so an instance whose covariant argument is `Nothing` holds
        // none of it and is an instance with any type there, a value type too: `None` alone, an
        // `Option[Nothing]`, is an `Option[int]`.
        if v is Covariant && *xs[i] is Nothing && !(*ys[i] is Var(_)) then out.push(ys[i])
        elif v is Covariant then out.push(view_part(f, xs[i], ys[i]))
        elif v is Contravariant then out.push(view_contra(f, xs[i], ys[i]))
        else out.push(xs[i])
    out

// A part in a covariant position: `x` seen as `to` where both are references, so the object `x`
// describes is already the one `to` describes. A value of a value type differs in representation
// from an `Any` or a trait, so it stays itself.
private view_part(f: Conformances, x: &Type, to: &Type) -> &Type
    if conforms(x, to) && !(*x is Nothing) then return x
    // A type argument with a lower bound is given only types the bound is seen as with no
    // conversion, so a value of any type is one of it through the bound.
    if *to is TypeVar(_, _, _) && below_lower(f, x, to) then return to
    if !is_reference(x) then return x
    if *to is AnyType then return AnyType
    view_as(f, x, to)

// A part in a contravariant position: `to` where it may be seen as `x`, otherwise `x`.
private view_contra(f: Conformances, x: &Type, to: &Type) -> &Type
    if conforms(x, to) && !(*x is Nothing) then return x
    if conforms(view_part(f, to, x), x) then to else x

/** Whether a value of type `t` is a reference to an object, which every type it may be seen as
 * shares: `Any`, a string, a tuple, a function, a data type, a class or a trait. */
is_reference(t: &Type) -> bool = *t match
    AnyType -> true
    Str -> true
    Tuple(_) -> true
    Function(_, _) -> true
    Data(_, _, _) -> true
    Class(_, _, _) -> true
    _ -> false

/** Whether a field may be used from the code being checked: a public one, or a private one from
 * code of the class that declares it or of its companion. */
field_visible(c: *Checker, f: FieldSymbol) -> bool = f.public || inside_class(c, f.owner)

/** Whether a method may be called from the code being checked. */
private method_visible(c: *Checker, m: usize) -> bool
    if c.symbols[m].public then return true
    // A private method an impl adds to a trait is called from the methods impls add to that trait.
    // One an impl adds to a type built from its parameters is private to the type's own impls.
    // A private method of an extension is private to the extension's module.
    if trait_method_of(c, m) is Some(tm)
        if tm.extension then return c.files[unit_of(c)].module_name == c.symbols[m].module_name
        if tm.on_trait
            return trait_method_of(c, c.body.root) match
                Some(here) -> here.on_trait && here.trait_id == tm.trait_id
                None -> false
    c.symbols[m].owner_class match
        Some(k) -> inside_class(c, k)
        None -> c.symbols[m].receiver match
            Some(t) -> inside_impl(c, t)
            None -> false

/** Whether the code being checked is a method an impl adds to the data or built-in type of `t`, or
 * code of a data type's companion object, so it may call that type's private methods. */
private inside_impl(c: *Checker, t: &Type) -> bool
    if in_extension(c) then return false
    if *t is Data(b, _, _)
        if c.data[b].companion is Some(o)
            if enclosing_class(c) == Some(o) then return true
    val here = c.symbols[c.body.root].receiver match
        Some(r) -> r
        None -> return false
    *here match
        Data(a, _, _) -> *t match
            Data(b, _, _) -> a == b
            _ -> false
        _ -> same_type(here, t)

/** Whether the code being checked is a method of an extension: an impl written outside the module
 * of the type or trait it adds to, whose methods reach no private member of the type. */
private in_extension(c: *Checker) -> bool = trait_method_of(c, c.body.root) match
    Some(tm) -> tm.extension
    None -> false

// The field of class `k` a name reaches from the code being checked: the class's own field first,
// then the nearest ancestor's, passing over the private fields the code cannot see. When none is
// visible, the nearest field of that name, so its privacy can be reported.
private class_field(c: *Checker, k: usize, name: string) -> Option[usize]
    val fields = c.classes[k].fields
    var hidden: Option[usize] = None
    var i = fields.len()
    while i > 0
        i -= 1
        if fields[i].name != name then continue
        if field_visible(c, fields[i]) then return Some(i)
        if hidden is None then hidden = Some(i)
    hidden

private field_named(fields: Buf[FieldSymbol], name: string) -> Option[usize]
    for i in 0..<fields.len()
        if fields[i].name == name then return Some(i)
    None

/** A method of a class as it is declared: in the class's body, or in an impl in file `unit` that
 * names the class's type parameters `type_params`. */
private struct MethodDecl
    f: &Function
    public: bool
    overrides: bool
    unit: usize
    module_name: string
    type_params: Buf[TypeParam]
    from_impl: bool
    /** Whether this is a trait's `val`, read as a field and supplied by a field. */
    field: bool
    static_member: bool
    /** For a trait's field declared with a value, which of its parts this is: 1 the method that
     * assigns a `var` one through the trait, 2 the function that computes its value, 3 the `val`
     * that reads it; 0 for anything else. */
    state_part: u8
    /** For a part of a trait's field, the field's place in the trait's `state`. */
    state_index: usize

// Each class's constructor, a function named after the class that takes its parameters and yields
// a new instance, and its methods, each a function whose first parameter is the instance.
private declare_methods(c: *Checker, unit: usize)
    val module_name = c.units[unit].file.module_name
    for id in 0..<c.classes.len()
        val k = c.classes[id]
        if k.unit != unit then continue
        val d = k.decl
        // A function of the same name was reported when it was declared, unless the object is a data
        // type's companion. A data type's own variant of its name stays its constructor in call
        // position, as a class's does; a variant with no fields is a value by its bare name, which
        // the companion would take.
        val key = qualified(module_name, d.name)
        if c.variants.get(key) is Some(v)
            if k.companion_data != Some(v.data) then c.note(unit, d.name_span, s"`${d.name}` is already a variant of `${c.data[v.data].name}`")
            elif c.data[v.data].variants[v.index].fields.len() == 0 then c.note(unit, d.name_span, s"`${d.name}` is a variant of `${d.name}` with no fields, a value by its bare name; a companion object cannot share it")
        if k.companion_data is Some(_) && c.variants.get(key) is None
            if c.scope.get(key) is Some(ids)
                for f in ids
                    if !c.symbols[f].constructor
                        c.note(unit, d.name_span, s"`${d.name}` is already a function")
                        break
        val self_type = own_class_type(k, id)
        var params: Buf[Param] = buf()
        var types: Buf[&Type] = buf()
        var names: Buf[string] = buf()
        for i in 0..<d.params.len()
            params.push(d.params[i].param)
            types.push(k.fields[k.inherited + i].ty.unwrap_or(ErrorType))
            names.push(k.fields[k.inherited + i].name)
        val decl = Function(buf(), d.span, d.name_span, d.name, d.type_params, params, None, None, buf())
        val constructor = c.symbols.len()
        var no_defaults: Buf[Option[usize]] = buf()
        for _ in d.params
            no_defaults.push(None)
        // An object's constructor makes its one instance before `main` and cannot be called.
        c.symbols.push(FunctionSymbol(unit, module_name, d.name, decl, types, names, Some(self_type), None, None, buf(), buf(), buf(), false, false, false, no_defaults, None, class_owner(id), d.type_params, Some(id), true, !d.object, "", None, false))
        c.states.push(0)
        c.bodies.push(None)
        c.locals.push(buf())
        declare_defaults(c, constructor)
        if !d.object
            var constructors: Buf[usize] = buf()
            constructors.push(constructor)
            c.scope.put(key, constructors)
        c.classes[id].constructor = constructor
        c.classes[id].initializer = constructor
        if is_open(c, id)
            // The initializer takes the object, then the constructor's parameters.
            var init_types: Buf[&Type] = buf()
            var init_names: Buf[string] = buf()
            var init_defaults: Buf[Option[usize]] = buf()
            init_types.push(self_type)
            init_names.push("self")
            init_defaults.push(None)
            for i in 0..<types.len()
                init_types.push(types[i])
                init_names.push(names[i])
                init_defaults.push(None)
            c.classes[id].initializer = c.symbols.len()
            c.symbols.push(FunctionSymbol(unit, module_name, d.name + ".<init>", decl, init_types, init_names, Some(Unit), None, None, buf(), buf(), buf(), false, false, false, init_defaults, None, class_owner(id), d.type_params, Some(id), true, true, "", None, false))
            c.states.push(0)
            c.bodies.push(None)
            c.locals.push(buf())
        var methods: Buf[usize] = buf()
        var overriding: Buf[bool] = buf()
        // The class's own methods, then those its impls add; a method of an impl of a trait
        // implements the trait's method without being marked.
        var declared: Buf[MethodDecl] = buf()
        // For each, the impl made from a template it belongs to, if any.
        var made_from: Buf[Option[usize]] = buf()
        for m in d.members
            m match
                MethodMember(f, public, overrides, static_member) ->
                    declared.push(MethodDecl(f, public, overrides, unit, module_name, d.type_params, false, false, static_member, 0, 0))
                    made_from.push(None)
                // A trait's `val` is an abstract method of no parameters, read with field syntax.
                AbstractFieldMember(f) ->
                    if is_trait(c, id) && !f.mutable && f.public
                        val getter = Function(buf(), f.span, f.name_span, f.name, buf(), buf(), Some(f.declared), None, buf())
                        declared.push(MethodDecl(getter, true, false, unit, module_name, d.type_params, false, true, false, 0, 0))
                        made_from.push(None)
                _ -> ()
        // Every Sysl handle has `close()`, which gives back its Sysl value.
        val handle = handle_target(d) is Some(_)
        if handle
            var named = false
            for m in d.members
                if m is MethodMember(f, _, _, _)
                    if f.name == "close" then named = true
            if !named
                var marks: Buf[Annotation] = buf()
                marks.push(Annotation(d.name_span, HandleRelease, buf()))
                val release = Function(marks, d.name_span, d.name_span, "close", buf(), buf(), None, None, buf())
                declared.push(MethodDecl(release, true, false, unit, module_name, d.type_params, false, false, false, 0, 0))
                made_from.push(None)
        // A trait's field with a value is a `val` of the trait, which each conforming class supplies
        // with the field it stores; a `var` one is also assigned through a method, and its value is
        // computed by a function of the trait's receiver.
        for j in 0..<k.state.len()
            val f = k.state[j].decl
            val declared_type = f.declared.unwrap()
            val getter = Function(buf(), f.span, f.span, f.name, buf(), buf(), Some(declared_type), None, buf())
            declared.push(MethodDecl(getter, true, false, unit, module_name, d.type_params, false, true, false, 3, j))
            made_from.push(None)
            if f.mutable
                var value_params: Buf[Param] = buf()
                value_params.push(Param(f.span, Pattern(f.span, Name("value")), declared_type, None, false, false, buf()))
                val unit_type = TypeExpr(f.span, Named("unit", buf()))
                val setter = Function(buf(), f.span, f.span, f.name + "=", buf(), value_params, Some(unit_type), None, buf())
                declared.push(MethodDecl(setter, true, false, unit, module_name, d.type_params, false, false, false, 1, j))
                made_from.push(None)
            val init = Function(buf(), f.span, f.span, s"<value of ${f.name}>", buf(), buf(), Some(declared_type), Some(f.value), buf())
            declared.push(MethodDecl(init, true, false, unit, module_name, d.type_params, false, false, false, 2, j))
            made_from.push(None)
        for block_index in 0..<c.impls.len()
            val block = c.impls[block_index]
            if *block.target is Class(target, _, _)
                if target != id then continue
                c.derived_context = derived_of_impl(c, block_index)
                val trait_id = block.trait_type match
                    Some(t) -> *t match
                        Class(t, _, _) -> Some(t)
                        _ -> None
                    None -> None
                for m in block.decl.members
                    if m is MethodMember(f, public, overrides, static_member)
                        if trait_id is Some(t)
                            if !trait_declares(c, t, f.name, 0)
                                c.note(block.unit, f.name_span, s"`${f.name}` is not a method of `${c.classes[t].name}`; an impl of a trait implements the trait's methods, and `impl ${d.name}` adds others")
                                continue
                        declared.push(MethodDecl(f, public, overrides || trait_id is Some(_), block.unit, methods_module(c, block), block.decl.type_params, true, false, static_member, 0, 0))
                        made_from.push(c.derived_context)
                c.derived_context = None
        for entry_index in 0..<declared.len()
            val entry = declared[entry_index]
            c.derived_context = made_from[entry_index]
            val f = entry.f
            val public = entry.public
            val overrides = entry.overrides
            val file_unit = entry.unit
            // The core library's array classes declare their element operations as intrinsics, and
            // `avin.threads.Atomic` its operations on the value it holds.
            val intrinsic_method = (is_array_storage(c.classes[id]) || is_atomic_storage(c.classes[id])) && f.annotations.len() > 0
            // A Sysl handle's own methods without a body are bound to its Sysl value's; the
            // declaration of the handle has checked their annotations.
            val bound_method = handle && !entry.from_impl && !entry.static_member && f.body is None && f.clauses.len() == 0
            if f.annotations.len() > 0 && !intrinsic_method && !(handle && !entry.from_impl) then c.note(file_unit, f.name_span, "annotations on methods are not implemented")
            if overrides then refuse_override_defaults(c, file_unit, f)
            if entry.static_member && !static_member_allowed(c, file_unit, f, c.classes[id].name, is_trait(c, id), overrides) then continue
            if is_trait(c, id)
                if !public
                    c.note(file_unit, f.name_span, s"`${f.name}` is declared in a trait, so it cannot be private")
                    continue
            var clash: Option[usize] = None
            for i in 0..<k.fields.len()
                if k.fields[i].name == f.name && (i >= k.inherited || k.fields[i].public) then clash = Some(i)
            if clash is Some(i)
                c.note(file_unit, f.name_span, s"`${f.name}` is already a field of `${c.classes[k.fields[i].owner].name}`")
                continue
            val bodyless = f.body is None && f.clauses.len() == 0
            if bodyless && !is_abstract_class(c, id) && !intrinsic_method && !bound_method
                c.note(file_unit, f.name_span, s"`${f.name}` has no body; only an abstract class may leave a method without one")
            if bodyless && !public && !intrinsic_method && !bound_method then c.note(file_unit, f.name_span, s"`${f.name}` is abstract, so it cannot be private: a subclass implements it")
            var same_name: Buf[usize] = buf()
            for other in methods
                if c.symbols[other].decl.name == f.name then same_name.push(other)
            var type_params: Buf[TypeParam] = buf()
            for tp in entry.type_params
                type_params.push(tp)
            for tp in f.type_params
                type_params.push(tp)
            // In a trait, `Self` names the type implementing it.
            val outer_trait = c.self_trait
            if is_trait(c, id) then c.self_trait = Some(id)
            // A bound method's `@sysl` names a Sysl method, which the handle's declaration has
            // checked, rather than a function, so its signature is read without it.
            val written: &Function = if bound_method then Function(buf(), f.span, f.name_span, f.name, f.type_params, f.params, f.result, f.body, f.clauses) else f
            var symbol = signature(c, file_unit, entry.module_name, written, class_owner(id), type_params, true, None)
            symbol.decl = f
            c.self_trait = outer_trait
            if bound_method
                if f.type_params.len() > 0 then c.note(file_unit, f.name_span, "generic Sysl bindings are not implemented")
                else check_crossings(c, file_unit, f, symbol.params, 0, symbol.result)
            // The receiver comes first, named `self`. In a trait that mentions `Self`, it is a `Self`,
            // so the trait's methods can pass it where their parameters take one.
            var receiver_types: Buf[&Type] = buf()
            var receiver_names: Buf[string] = buf()
            if is_trait(c, id) && mentions_self(c, id, 0) then receiver_types.push(TypeVar(self_owner(id), 0, "Self"))
            else receiver_types.push(self_type)
            receiver_names.push("self")
            for t in symbol.params
                receiver_types.push(t)
            for n in symbol.param_names
                receiver_names.push(n)
            symbol.params = receiver_types
            symbol.param_names = receiver_names
            symbol.name = d.name + "." + f.name
            symbol.owner_class = Some(id)
            symbol.public = public
            symbol.static_member = entry.static_member
            var method_defaults: Buf[Option[usize]] = buf()
            for _ in receiver_types
                method_defaults.push(None)
            symbol.defaults = method_defaults
            var shared = entry.field && same_name.len() > 0
            for other in same_name
                if is_trait_field(c, other) then shared = true
            if shared
                c.note(file_unit, f.name_span, s"`${f.name}` is declared more than once in `${d.name}`; a trait's `val` shares its name with no other member")
                continue
            if same_as_overload(c, symbol, same_name)
                if entry.from_impl then c.note(file_unit, f.name_span, s"`${f.name}` is already a method of `${d.name}` with the same parameter types; a method's overloads differ in their parameter types")
                else c.note(file_unit, f.name_span, s"`${f.name}` is declared more than once in `${d.name}` with the same parameter types; a method's overloads differ in their parameter types")
                continue
            val method = c.symbols.len()
            // The function computing a trait field's value is called by each conforming class's
            // constructor, and is no method of the trait.
            if entry.state_part == 2
                c.classes[id].state[entry.state_index].init = method
                c.symbols.push(symbol)
                c.states.push(0)
                c.bodies.push(None)
                c.locals.push(buf())
                continue
            if entry.state_part == 3 then c.classes[id].state[entry.state_index].getter = method
            if entry.state_part == 1
                c.classes[id].state[entry.state_index].setter = Some(method)
                c.trait_setters.push(method)
            if entry.field then c.trait_fields.push(method)
            if entry.from_impl then c.impl_methods.push(method)
            methods.push(method)
            overriding.push(overrides)
            c.symbols.push(symbol)
            c.states.push(0)
            c.bodies.push(None)
            c.locals.push(buf())
            // An override takes the defaults of the method it overrides once the class is linked.
            if !overrides then declare_defaults(c, method)
        c.derived_context = None
        c.classes[id].methods = methods
        c.classes[id].overriding = overriding
        // The methods of one name are told apart in the object file by their parameter types.
        for m in methods
            var group: Buf[usize] = buf()
            for other in methods
                if c.symbols[other].decl.name == c.symbols[m].decl.name then group.push(other)
            if group.len() > 1 && group[0] == m then mark_overloads(c, group)

// The methods an impl adds to a data type or a built-in type: each a function whose first parameter
// is the value, `self`. A class's impls were declared with the class's own methods.
private declare_impl_methods(c: *Checker, i: usize)
    val target = c.impls[i].target
    if *target is ErrorType || *target is Class(_, _, _) then return
    val outer = c.derived_context
    c.derived_context = derived_of_impl(c, i)
    for m in c.impls[i].decl.members
        if m is MethodMember(f, public, overrides, static_member) then declare_impl_method(c, i, f, public, overrides, static_member)
    c.derived_context = outer

/** The place in `derived` of the impl at `i` among the impls, when a template made it. */
private derived_of_impl(c: *Checker, i: usize) -> Option[usize]
    for x in 0..<c.derived.len()
        if c.derived[x].impl_index == i then return Some(x)
    None

// Each method of an impl made from a template is known as that impl's, so its body is checked with
// `T` standing for the deriving type and what goes wrong in it reported at the `derives` entry. The
// template and every impl made from it share the template's declarations; the deriving type tells
// them apart.
private register_derived_symbols(c: *Checker)
    for x in 0..<c.derived.len()
        val dv = c.derived[x]
        val decl = c.impls[dv.impl_index].decl
        for m in decl.members
            val f = m match
                MethodMember(f, _, _, _) -> f
                _ -> continue
            for id in 0..<c.symbols.len()
                val s = c.symbols[id]
                if s.unit != dv.template_unit || s.decl.name_span.start != f.name_span.start || s.decl.name_span.end != f.name_span.end || s.decl.name != f.name then continue
                val mine = *dv.target match
                    Data(d, _, _) -> s.receiver match
                        Some(r) -> *r match
                            Data(e, _, _) -> e == d
                            _ -> false
                        None -> false
                    Class(k, _, _) -> s.owner_class match
                        Some(o) -> o == k
                        None -> false
                    _ -> false
                if mine then c.derived_symbols.put(s"$id", x)

/** The module an impl's methods belong to: for an impl made from a template, the deriving type's,
 * so that two modules' types of one name keep their derived methods apart; otherwise the impl's. */
private methods_module(c: *Checker, block: ImplSymbol) -> string = c.derived_context match
    Some(x) -> c.units[c.derived[x].site.unit].file.module_name
    None -> block.module_name

private declare_impl_method(c: *Checker, i: usize, f: &Function, public: bool, overrides: bool, static_member: bool)
    val block = c.impls[i]
    val unit = block.unit
    val target = block.target
    val family = is_integer_family(target)
    val type_name_of = *target match
        Data(id, _, _) -> c.data[id].name
        _ -> if family then "Integer" else type_name(target)
    val trait_id = block.trait_type match
        Some(t) -> *t match
            Class(t, _, _) -> Some(t)
            _ -> None
        None -> None
    // A built-in type's operations are intrinsics, so its impls may declare them; no other method
    // takes an annotation.
    val builtin = !(*target is Data(_, _, _)) && !family
    for a in f.annotations
        if a.name != "intrinsic" || !builtin || trait_id is Some(_)
            c.note(unit, f.name_span, "annotations on methods are not implemented")
            break
    // A built-in type's arithmetic and orderings are the machine's, which no method replaces, in a
    // trait's implementation either.
    if arithmetic_method_name(f.name) && !(*target is Data(_, _, _))
        c.note(unit, f.name_span, s"`${f.name}` is the language's operator on ${type_name(target)}, and no method can redefine it")
        return
    if trait_id is Some(_) || overrides then refuse_override_defaults(c, unit, f)
    if trait_id is Some(t)
        if !trait_declares(c, t, f.name, 0)
            c.note(unit, f.name_span, s"`${f.name}` is not a method of `${c.classes[t].name}`; an impl of a trait implements the trait's methods, and `impl $type_name_of` adds others")
            return
    elif overrides
        c.note(unit, f.name_span, s"`${f.name}` overrides nothing; `$type_name_of` has no superclass")
    if static_member && !static_member_allowed(c, unit, f, type_name_of, false, false) then return
    if trait_id is Some(t)
        if !static_mirrors_trait(c, unit, f, t, static_member) then return
    elif static_member
        if !scalar_builtin(target)
            c.note(unit, f.name_span, s"`${f.name}` is static, which only a trait's member, its implementations and a built-in type's own members are; an impl of `$type_name_of` without a trait adds methods of values, and its companion object holds what belongs to the type")
            return
        if language_static(target, f.name)
            c.note(unit, f.name_span, s"`$type_name_of.${f.name}` is the language's own, and no static member can redefine it")
            return
    if *target is Data(id, _, _)
        var field = false
        for v in c.data[id].variants
            if contains_name(v.field_names, f.name) then field = true
        if field
            c.note(unit, f.name_span, s"`${f.name}` is already a field of `$type_name_of`")
            return
    // The methods of this name the type's impls have added so far, which this one overloads.
    var same_name: Buf[usize] = buf()
    *target match
        Data(d, _, _) ->
            for m in c.data[d].methods
                if c.symbols[m].decl.name == f.name then same_name.push(m)
        _ ->
            for m in c.builtin_methods
                if same_type(c.symbols[m].receiver.unwrap(), target) && c.symbols[m].decl.name == f.name then same_name.push(m)
    // `string.name` and `s.name` would otherwise be two different functions, told apart only by
    // whether a type or a value is written before the dot.
    if scalar_builtin(target)
        for m in same_name
            if c.symbols[m].static_member != static_member
                if static_member then c.note(unit, f.name_span, s"`${f.name}` is already a method of a value of `$type_name_of`, so it cannot also be a static member of the type")
                else c.note(unit, f.name_span, s"`${f.name}` is already a static member of `$type_name_of`, so it cannot also be a method of its values")
                return
    val id = c.symbols.len()
    // A data type's methods share its type parameters, then have their own, and so do the integer
    // family's and a tuple family's; a built-in type has none, so its methods' type parameters are
    // their own.
    val owner = if *target is Data(_, _, _) || family || is_tuple_family(target) || is_template_type(target) then block.owner else id
    var type_params: Buf[TypeParam] = buf()
    for tp in block.decl.type_params
        type_params.push(tp)
    for tp in f.type_params
        type_params.push(tp)
    var symbol = signature(c, unit, methods_module(c, block), f, owner, type_params, false, Some(target))
    // The receiver comes first, named `self`.
    var receiver_types: Buf[&Type] = buf()
    var receiver_names: Buf[string] = buf()
    receiver_types.push(target)
    receiver_names.push("self")
    for t in symbol.params
        receiver_types.push(t)
    for n in symbol.param_names
        receiver_names.push(n)
    symbol.params = receiver_types
    symbol.param_names = receiver_names
    symbol.name = type_name_of + "." + f.name
    symbol.public = public
    symbol.receiver = Some(target)
    symbol.static_member = static_member
    var method_defaults: Buf[Option[usize]] = buf()
    for _ in receiver_types
        method_defaults.push(None)
    symbol.defaults = method_defaults
    if same_as_overload(c, symbol, same_name)
        c.note(unit, f.name_span, s"`${f.name}` is already a method of `$type_name_of` with the same parameter types; a method's overloads differ in their parameter types")
        return
    c.symbols.push(symbol)
    c.states.push(0)
    c.bodies.push(None)
    c.locals.push(buf())
    if trait_id is None && !overrides then declare_defaults(c, id)
    same_name.push(id)
    if same_name.len() > 1 then mark_overloads(c, same_name)
    *target match
        Data(d, _, _) ->
            var methods = c.data[d].methods
            methods.push(id)
            c.data[d].methods = methods
            var implementing = c.data[d].implementing
            implementing.push(trait_id is Some(_))
            c.data[d].implementing = implementing
        _ -> c.builtin_methods.push(id)

/** The method named `name` that a value of data or built-in type `t` has: one its impls add, or for a
 * data type, what its method table holds under the name through a trait it conforms to. */
private receiver_method(c: *Checker, t: &Type, name: string) -> Option[usize]
    *t match
        Data(id, _, _) ->
            for m in c.data[id].methods
                if c.symbols[m].decl.name == name then return Some(m)
            for entry in c.data[id].table
                if entry is Some(m)
                    if c.symbols[m].decl.name == name then return Some(m)
            None
        Class(_, _, _) -> None
        Var(_) -> None
        TypeVar(_, _, _) ->
            // Inside an impl for every integer width, its own type has the methods its impls add.
            if !is_integer_family(t) then return None
            for m in c.builtin_methods
                if same_type(c.symbols[m].receiver.unwrap(), t) && c.symbols[m].decl.name == name then return Some(m)
            None
        ErrorType -> None
        _ ->
            for m in c.builtin_methods
                if builtin_covers(c.symbols[m].receiver.unwrap(), t) && c.symbols[m].decl.name == name && method_holds(c, m, t) then return Some(m)
            None

/** Whether built-in method `m` is one a value of type `t` has: for a method of an impl for a tuple
 * family, where `t`'s parts meet the impl's bounds. */
private method_holds(c: *Checker, m: usize, t: &Type) -> bool =
    is_tuple_family(t) || tuple_parts_hold(conformances(c), c.symbols[m].type_owner, c.symbols[m].type_params, t)

/** Every method named `name` that a value of data or built-in type `t` has, one for each list of
 * parameter types: those its impls add, then for a data type what its method table holds under the
 * name through the traits it conforms to. */
receiver_methods(c: *Checker, t: &Type, name: string) -> Buf[usize]
    var out: Buf[usize] = buf()
    *t match
        Data(id, _, _) ->
            val self_type = own_type(c.data[id], id)
            for m in c.data[id].methods
                if c.symbols[m].decl.name == name then add_method(c, self_type, &out, m)
            for entry in c.data[id].table
                if entry is Some(m)
                    if c.symbols[m].decl.name == name then add_method(c, self_type, &out, m)
        Class(_, _, _) -> ()
        Var(_) -> ()
        TypeVar(_, _, _) ->
            if is_integer_family(t)
                for m in c.builtin_methods
                    if same_type(c.symbols[m].receiver.unwrap(), t) && c.symbols[m].decl.name == name then out.push(m)
        ErrorType -> ()
        _ ->
            for m in c.builtin_methods
                if builtin_covers(c.symbols[m].receiver.unwrap(), t) && c.symbols[m].decl.name == name && method_holds(c, m, t) then out.push(m)
    out

/** `t` as an instance of trait `k`, where it conforms to it at its type arguments; a type parameter
 * does through its bounds. */
private trait_view(c: *Checker, t: &Type, k: usize) -> Option[&Type]
    val known = zonk(c, t)
    val f = conformances(c)
    if *known is TypeVar(_, _, _)
        for b in bounds_of(c, known)
            if holding_ancestor(f, b, k) is Some(up) then return Some(up)
        return None
    holding_ancestor(f, known, k)

// The methods of `name` a value of type `t` has: `own`, those of its type, then each that an impl
// adds to a trait `t` conforms to. The type's own method takes precedence over an added one with the
// same parameter types, which is left out.
//
// An impl adding to a type built from its parameters, as `impl[T] Option[Option[T]]`, adds to the
// values whose type matches it. Where some added method's type matches, only those are offered;
// where none does, those whose type the receiver is an instance of are, so the call reports what the
// receiver would need to be. Such a method is not hidden by the type's own of the same parameter
// types: both are the type's, so the call is ambiguous, as `refuse_trait_clash` reports.
private with_trait_methods(c: *Checker, t: &Type, name: string, own: Buf[usize]) -> Buf[usize]
    if c.trait_methods.len() == 0 then return own
    var out: Buf[usize] = buf()
    for m in own
        out.push(m)
    var matching: Buf[usize] = buf()
    var unmatched: Buf[usize] = buf()
    for tm in c.trait_methods
        val m = tm.function
        if c.symbols[m].decl.name != name || !method_visible(c, m) || !extension_seen(c, tm) then continue
        if !added_applies(c, t, tm) then continue
        val matches = added_args(c, t, tm) is Some(_)
        var hidden = false
        for o in own
            if same_params_seen(c, t, o, m) then hidden = true
        if hidden && (tm.on_trait || tm.extension || !matches) then continue
        if matches then matching.push(m) else unmatched.push(m)
    val offered = if matching.len() > 0 || own.len() > 0 then matching else unmatched
    for m in offered
        out.push(m)
    out

/** Whether the code being checked sees the methods impl method `tm` is added with: those of an impl
 * in the module of the type or trait it adds to are seen wherever the type is; an extension's, by
 * code of its own module and of a file importing that module or any declaration of it. The core
 * library's are seen everywhere. */
private extension_seen(c: *Checker, tm: TraitMethod) -> bool
    if !tm.extension then return true
    val home = c.symbols[tm.function].module_name
    if home == CoreModule then return true
    sees_module(c, unit_of(c), home)

/** Whether file `unit` is of module `module_name` or imports it: the module itself, `import a.b`,
 * or one of its declarations, `import a.b.X`. */
private sees_module(c: *Checker, unit: usize, module_name: string) -> bool
    val scope = c.files[unit]
    if scope.module_name == module_name then return true
    for (_, imported) in scope.modules
        if imported == module_name then return true
    for (_, key) in scope.imports
        var dot = 0usize
        for k in 0..<key.bytes.len
            if key.bytes[k] == u8('.') then dot = k
        if dot > 0 && key[0..<dot] == module_name then return true
    false

/** The parameter types of method `m` past the receiver, as a call on a value of type `t` sees them,
 * with the method's own type parameters renamed alike, so two methods' lists compare. */
private seen_params(c: *Checker, t: &Type, m: usize) -> Buf[&Type]
    val symbol = c.symbols[m]
    val known = receiver_type_args(c, t, m)
    val own = symbol.decl.type_params.len()
    val outer = symbol.type_params.len() - own
    var names: Buf[&Type] = buf()
    for i in 0..<outer
        names.push(if i < known.len() then known[i] else TypeVar(symbol.type_owner, i, symbol.type_params[i].name))
    for j in 0..<own
        names.push(TypeVar(method_params_owner(), j, symbol.type_params[outer + j].name))
    var out: Buf[&Type] = buf()
    for i in 1..<symbol.params.len()
        out.push(substitute(with_self(c, m, t, symbol.params[i]), symbol.type_owner, names))
    out

/** Whether methods `a` and `b` take the same parameter types as a call on a value of type `t` sees
 * them. */
private same_params_seen(c: *Checker, t: &Type, a: usize, b: usize) -> bool
    val x = seen_params(c, t, a)
    val y = seen_params(c, t, b)
    if x.len() != y.len() then return false
    for i in 0..<x.len()
        if !same_type(zonk(c, x[i]), zonk(c, y[i])) then return false
    true

// Reports a use of `name` on a value of type `t` where the only method of that name is a private one
// an impl adds to a trait `t` conforms to, which the code being checked may not call, or one an
// extension adds in a module the file does not import.
private refuse_private_trait_method(c: *Checker, at: Span, t: &Type, name: string) -> bool
    for tm in c.trait_methods
        val m = tm.function
        if c.symbols[m].decl.name != name || !added_applies(c, t, tm) then continue
        val home = module_label(c.symbols[m].module_name)
        if !extension_seen(c, tm)
            c.note(unit_of(c), at, s"`$name` is added to `${impls_owner(c, m)}` by $home, which this file does not import")
            return true
        if method_visible(c, m) then continue
        if tm.extension then c.note(unit_of(c), at, s"`$name` is private to $home, whose impl adds it to `${impls_owner(c, m)}`")
        else c.note(unit_of(c), at, s"`$name` is private to the impls of `${impls_owner(c, m)}`")
        return true
    false

// Reports a call of `name` on a value of type `t` that reaches, among `ms`, two methods impls add to
// two traits `t` conforms to, with the same parameter types: neither trait's is the one meant.
//
// An impl adding to a type built from its parameters clashes the same way with another such impl, or
// with the type's own method, where the receiver matches both.
private refuse_trait_clash(c: *Checker, at: Span, t: &Type, name: string, ms: Buf[usize]) -> bool
    for i in 0..<ms.len()
        val a = trait_method_of(c, ms[i]) match
            Some(x) -> x
            None -> continue
        if !a.on_trait && !a.extension && added_args(c, t, a) is Some(_)
            for o in ms
                if trait_method_of(c, o) is Some(_) then continue
                if same_params_seen(c, t, o, ms[i])
                    c.note(unit_of(c), at, s"`$name` is ambiguous on ${type_name(zonk(c, t))}: `${head_name(a.target)}` has it, and an impl adding to `${type_name(a.target)}` adds it with the same parameter types")
                    return true
        for j in i + 1..<ms.len()
            val b = trait_method_of(c, ms[j]) match
                Some(x) -> x
                None -> continue
            val module_a = c.symbols[a.function].module_name
            val module_b = c.symbols[b.function].module_name
            if module_a == module_b && same_added_target(c, a, b.on_trait, b.trait_id, b.target, b.function, b.impl_params) then continue
            if added_args(c, t, a) is None || added_args(c, t, b) is None then continue
            if same_params_seen(c, t, ms[i], ms[j])
                if module_a != module_b
                    c.note(unit_of(c), at, s"`$name` is ambiguous on ${type_name(zonk(c, t))}: ${module_label(module_a)} and ${module_label(module_b)} each add it with the same parameter types, and this file sees both")
                    return true
                c.note(unit_of(c), at, s"`$name` is ambiguous on ${type_name(zonk(c, t))}: impls of `${added_label(c, a)}` and of `${added_label(c, b)}` each add it with the same parameter types")
                return true
    false

/** A module as a diagnostic names it; the root module has no name of its own. */
private module_label(module_name: string) -> string = if module_name == "" then "the root module" else s"module `$module_name`"

/** The type an impl adding method `tm` adds to, as a diagnostic names it: the trait, for an impl of
 * it at its parameters in order, or the type built from them. */
private added_label(c: *Checker, tm: TraitMethod) -> string
    if tm.on_trait && in_order_target(tm.target, tm.function, tm.impl_params) then return c.classes[tm.trait_id].name
    type_name(tm.target)

/** The methods of `ms` the code being checked may call. */
visible_methods(c: *Checker, ms: Buf[usize]) -> Buf[usize]
    var out: Buf[usize] = buf()
    for m in ms
        if method_visible(c, m) then out.push(m)
    out

// Defaults belong to the method that introduces a parameter: one that overrides another method, or
// implements a trait's, takes that method's defaults and declares none of its own.
private refuse_override_defaults(c: *Checker, unit: usize, f: &Function)
    for p in f.params
        if p.default is Some(e) then c.note(unit, e.span, s"`${f.name}` overrides a method, so it takes that method's default for `${param_name(p)}`; an override cannot declare a default")

private param_name(p: Param) -> string = p.pattern.kind match
    Name(n) -> n
    _ -> "_"

// Method `m`, which overrides or implements `base`, takes `base`'s defaults. Overriding two methods
// that bring different defaults leaves the arguments it may omit unclear, so it is an error.
private inherit_defaults(c: *Checker, m: usize, base: usize)
    val from = c.symbols[base].defaults
    val own = c.symbols[m].defaults
    if from.len() != own.len() then return
    var brings = false
    for d in from
        if d is Some(_) then brings = true
    if !brings then return
    var has = false
    var same = true
    for i in 0..<own.len()
        if own[i] is Some(_) then has = true
        if own[i] != from[i] then same = false
    if has
        if !same then c.note(c.symbols[m].unit, c.symbols[m].decl.name_span, s"`${c.symbols[m].name}` overrides methods with different defaults, `${c.symbols[base].name}` among them; it can take the defaults of only one")
        return
    var copied: Buf[Option[usize]] = buf()
    for d in from
        copied.push(d)
    c.symbols[m].defaults = copied

// A method a type inherits, from its superclass or as a trait's default body, that also implements
// another trait's method keeps its own defaults, so a call omits the same arguments whichever type
// it is made through only when the trait's method declares none or has the very same ones. The
// reason it does not, when it does not; `remedy` says how the type replaces the method, which takes
// the trait method's defaults where the inherited one has none.
private defaults_conflict(c: *Checker, m: usize, base: usize, remedy: string) -> Option[string]
    val from = c.symbols[base].defaults
    val own = c.symbols[m].defaults
    if from.len() != own.len() then return None
    var brings = false
    var same = true
    var has = false
    for i in 0..<from.len()
        if from[i] is Some(_) then brings = true
        if own[i] is Some(_) then has = true
        if own[i] != from[i] then same = false
    if !brings || same then return None
    if !has then return Some(s"which has defaults `${c.symbols[m].name}` lacks; $remedy to take them")
    Some("and their defaults differ; a method can take the defaults of only one")

/** Whether a function is a method, whose first parameter is its receiver, `self`. */
private is_method(symbol: FunctionSymbol) -> bool = (symbol.owner_class is Some(_) && !symbol.constructor) || symbol.receiver is Some(_)

/** Whether a method is abstract: declared in a class without a body. */
is_abstract_method(symbol: FunctionSymbol) -> bool =
    symbol.owner_class is Some(_) && !symbol.constructor && symbol.intrinsic is None && symbol.decl.body is None && symbol.decl.clauses.len() == 0

// Each module-level value and object of a file, in declaration order, which is the order they
// initialize in where none depends on another. A value's initializer is checked as a function with
// no parameters whose result is the value; an object's is its class's constructor.
private declare_globals(c: *Checker, unit: usize)
    val file = c.units[unit].file
    for i in 0..<file.items.len()
        val key = qualified(file.module_name, item_name(file.items[i]))
        file.items[i] match
            ValueItem(v) ->
                if v.name == "_" || global_name_taken(c, unit, v.name, v.span, false) then continue
                val f = Function(buf(), v.span, v.span, v.name, buf(), buf(), v.declared, Some(v.value), buf())
                val init = c.symbols.len()
                c.symbols.push(signature(c, unit, file.module_name, f, init, buf(), false, None))
                c.states.push(0)
                c.bodies.push(None)
                c.locals.push(buf())
                if file.private_items[i] then c.private_names.put(key, true)
                c.global_names.put(key, c.globals.len())
                c.globals.push(GlobalSymbol(unit, file.module_name, v.name, v.span, v.mutable, init, None, v.lazy))
            ClassItem(d) ->
                if !d.object then continue
                // A second object of one name has no class, and was reported.
                for k in 0..<c.classes.len()
                    val cls = c.classes[k]
                    if cls.unit == unit && cls.decl.object && cls.name == d.name && cls.global is None
                        if global_name_taken(c, unit, d.name, d.name_span, true) then break
                        c.classes[k].global = Some(c.globals.len())
                        c.global_names.put(key, c.globals.len())
                        c.globals.push(GlobalSymbol(unit, file.module_name, d.name, d.name_span, false, cls.constructor, Some(k), false))
            _ -> ()

// A companion's `apply` overloads the constructor its name has in call position, so it cannot take
// the same parameter types: no call could choose between them. Two are the same as two overloads of
// a function are, each accepting the other's parameter types.
private check_apply_overloads(c: *Checker, o: usize)
    val k = c.classes[o]
    if !k.decl.object then return
    val made = made_by(c, o) match
        Some(m) -> m
        None -> return
    for m in k.methods
        if c.symbols[m].decl.name == "apply" && clashes(c, made, m)
            c.note(k.unit, c.symbols[m].decl.name_span, s"`apply` takes the same parameter types as ${made.what}, which `${k.name}(…)` also calls, so no call could choose between them")

/** The constructor an object's name has in call position, which its `apply` methods overload: its
 * parameter types, in the `count` type parameters of `owner`, and what a diagnostic calls it. */
private struct MadeBy
    params: Buf[&Type]
    owner: usize
    count: usize
    what: string

/** For companion `o`, the constructor its name has in call position: its class's, unless that is
 * abstract or an array, or its data type's variant of its name, where that has fields. */
private made_by(c: *Checker, o: usize) -> Option[MadeBy]
    val k = c.classes[o]
    if k.companion is Some(cls)
        if is_array_class(c.classes[cls]) || is_abstract_class(c, cls) then return None
        val ctor = c.symbols[c.classes[cls].constructor]
        return Some(MadeBy(ctor.params, ctor.type_owner, ctor.type_params.len(), s"`${k.name}`'s constructor"))
    val d = k.companion_data match
        Some(d) -> d
        None -> return None
    val v = c.variants.get(qualified(k.module_name, k.name)) match
        Some(v) -> v
        None -> return None
    if v.data != d || c.data[d].variants[v.index].fields.len() == 0 then return None
    Some(MadeBy(c.data[d].variants[v.index].fields, data_owner(d), c.data[d].decl.type_params.len(), s"the variant `${k.name}`"))

/** Whether `apply` method `m` takes the same parameter types as the constructor `made`, so that no
 * call could choose between them. */
private clashes(c: *Checker, made: MadeBy, m: usize) -> bool
    val f = c.symbols[m]
    if f.params.len() != made.params.len() + 1 then return false
    for p in made.params
        if *p is ErrorType then return false
    var own: Buf[&Type] = buf()
    for i in 1..<f.params.len()
        own.push(f.params[i])
    accepts(c, own, f.type_owner, f.type_params.len(), made.params) && accepts(c, made.params, made.owner, made.count, own)

/** The `apply` methods of object `o` a call by its name may choose: those the code being checked may
 * call, less any refused for taking its constructor's parameter types. */
private object_applies(c: *Checker, o: usize) -> Buf[usize]
    val ms = methods_named(c, o, "apply")
    val made = made_by(c, o) match
        Some(m) -> m
        None -> return ms
    var out: Buf[usize] = buf()
    for m in ms
        if !clashes(c, made, m) then out.push(m)
    out

/** The name a top-level declaration introduces: "" for an impl, which introduces none. */
item_name(item: Item) -> string = item match
    FunctionItem(f) -> f.name
    DataItem(d) -> d.name
    ClassItem(d) -> d.name
    ImplItem(_) -> ""
    ValueItem(v) -> v.name

// Whether a module-level value's name is already declared in its module, reporting it if so. An
// object's clashes with a class, a function or a variant were reported with its class, so only its
// clash with a module value is reported here.
private global_name_taken(c: *Checker, unit: usize, name: string, at: Span, object: bool) -> bool
    val key = qualified(c.units[unit].file.module_name, name)
    if c.global_names.get(key) is Some(_)
        c.note(unit, at, s"`$name` is declared more than once")
        return true
    if object then return false
    if c.class_types.get(key) is Some(k)
        if !c.classes[k].decl.object && c.classes[k].companion is None
            c.note(unit, at, s"`$name` is already a class")
            return true
    if c.scope.get(key) is Some(ids)
        for f in ids
            if !c.symbols[f].constructor
                c.note(unit, at, s"`$name` is already a function")
                return true
    if c.variants.get(key) is Some(v)
        c.note(unit, at, s"`$name` is already a variant of `${c.data[v.data].name}`")
        return true
    false

/** The method of class `id` declared as `name`, its own. */
private own_method(c: *Checker, id: usize, name: string) -> Option[usize]
    for m in c.classes[id].methods
        if c.symbols[m].decl.name == name then return Some(m)
    None

/** Whether methods `a` and `b` are one method as a value of `self_type` sees them: the same name and
 * the same parameter types past the receiver. Such methods override and implement one another and
 * share a position in a method table; methods of one name with other parameter types overload it. */
private same_method(c: *Checker, self_type: &Type, a: usize, b: usize) -> bool =
    c.symbols[a].decl.name == c.symbols[b].decl.name && param_mismatch(c, self_type, a, b) is None

/** The method of class or trait `k` that is the same method as `m`, as `self_type` sees both. */
private own_matching(c: *Checker, k: usize, self_type: &Type, m: usize) -> Option[usize]
    for own in c.classes[k].methods
        if same_method(c, self_type, own, m) then return Some(own)
    None

/** Adds method `m` to `out` unless `out` already holds the same method as `self_type` sees it. */
private add_method(c: *Checker, self_type: &Type, out: *Buf[usize], m: usize)
    for i in 0..<out.len()
        if same_method(c, self_type, out[i], m) then return
    out.push(m)

/** The methods of `name` a value of class or trait `id` has that the code being checked may call: one
 * for each list of parameter types, found in the order `method_named` searches, so each is the
 * implementation the value's static type knows. */
methods_named(c: *Checker, id: usize, name: string) -> Buf[usize]
    val self_type = own_class_type(c.classes[id], id)
    var out: Buf[usize] = buf()
    for m in c.classes[id].methods
        if c.symbols[m].decl.name == name && method_visible(c, m) then add_method(c, self_type, &out, m)
    for entry in c.classes[id].table
        if entry is Some(m)
            if c.symbols[m].decl.name == name then add_method(c, self_type, &out, m)
    var k = id
    loop
        for m in c.classes[k].methods
            if c.symbols[m].decl.name == name && method_visible(c, m) then add_method(c, self_type, &out, m)
        val sup = c.classes[k].superclass match
            Some(t) -> t
            None -> break
        k = *sup match
            Class(s, _, _) -> s
            _ -> break
    trait_methods_named(c, id, self_type, name, &out, 0)
    // A trait's `val`, and the method a field supplies it with, are read as a field, not called.
    var callable: Buf[usize] = buf()
    for m in out
        if !reads_field(c, m) then callable.push(m)
    callable

/** Adds to `out` the methods of `name` of the traits class or trait `id` conforms to or requires. */
private trait_methods_named(c: *Checker, id: usize, self_type: &Type, name: string, out: *Buf[usize], depth: usize)
    if depth > c.classes.len() then return
    for required in c.classes[id].traits
        if *required is Class(t, _, _)
            for m in c.classes[t].methods
                if c.symbols[m].decl.name == name then add_method(c, self_type, out, m)
            trait_methods_named(c, t, self_type, name, out, depth + 1)
    if c.classes[id].superclass is Some(sup)
        if *sup is Class(s, _, _) then trait_methods_named(c, s, self_type, name, out, depth + 1)

/** The method of a trait that trait `id` requires, directly or not, that is the same method as `m`. */
private required_matching(c: *Checker, id: usize, self_type: &Type, m: usize, depth: usize) -> Option[usize]
    if depth > c.classes.len() then return None
    for required in c.classes[id].traits
        if *required is Class(t, _, _)
            if own_matching(c, t, self_type, m) is Some(found) then return Some(found)
            if required_matching(c, t, self_type, m, depth + 1) is Some(found) then return Some(found)
    None

/** The text of a method's parameter types past the receiver, as `self_type` sees them, after its
 * name: `add(int, string)`. It tells apart the overloads of one name in a diagnostic. */
private method_key(c: *Checker, self_type: &Type, m: usize) -> string
    val params = c.symbols[m].params
    var text = c.symbols[m].decl.name + "("
    for i in 1..<params.len()
        if i > 1 then text = text + ", "
        text = text + type_name(seen_from(c, self_type, m, params[i]))
    text + ")"

// The method a name reaches on an instance of class `id`: the class's own, then the nearest
// ancestor's, passing over the private methods of ancestors that the code being checked cannot see.
// When none is visible, the nearest of that name, so its privacy can be reported.
// Past the class's own methods, what its method table holds under the name is the implementation
// an instance has, wherever it comes from; a method no table holds is the nearest ancestor's, and
// then a trait's. A trait's methods are its own, then those of the traits it requires.
private method_named(c: *Checker, id: usize, name: string) -> Option[usize]
    val m = any_method_named(c, id, name)?
    if reads_field(c, m) then None else Some(m)

/** The method `method_named` finds, a trait's `val` and the method that supplies it included. */
private any_method_named(c: *Checker, id: usize, name: string) -> Option[usize]
    if own_method(c, id, name) is Some(m)
        if method_visible(c, m) then return Some(m)
    for entry in c.classes[id].table
        if entry is Some(m)
            if c.symbols[m].decl.name == name then return Some(m)
    var hidden: Option[usize] = None
    var k = id
    loop
        if own_method(c, k, name) is Some(m)
            if method_visible(c, m) then return Some(m)
            if hidden is None then hidden = Some(m)
        val sup = c.classes[k].superclass match
            Some(t) -> t
            None -> break
        k = *sup match
            Class(s, _, _) -> s
            _ -> break
    if hidden is Some(_) then return hidden
    trait_method(c, id, name)

/** The method named `name` of a trait that class or trait `id` conforms to or requires. */
private trait_method(c: *Checker, id: usize, name: string) -> Option[usize]
    for required in c.classes[id].traits
        if *required is Class(t, _, _)
            if own_method(c, t, name) is Some(m) then return Some(m)
            if trait_method(c, t, name) is Some(m) then return Some(m)
    val sup = c.classes[id].superclass?
    *sup match
        Class(s, _, _) -> trait_method(c, s, name)
        _ -> None

/** The position of a trait's method in the method table of every class conforming to the trait. */
private trait_slot(c: *Checker, m: usize) -> usize
    val t = c.symbols[m].owner_class.unwrap()
    if trait_overridden(c, m) is Some(o) then return trait_slot(c, o)
    val methods = c.classes[t].methods
    for j in 0..<methods.len()
        if methods[j] == m then return c.classes[t].base + j
    0

/** For a trait's method declared `override`, the method of a trait it requires whose default it
 * replaces, at whose position it is called. */
private trait_overridden(c: *Checker, m: usize) -> Option[usize]
    val t = c.symbols[m].owner_class?
    if !is_trait(c, t) then return None
    val methods = c.classes[t].methods
    for j in 0..<methods.len()
        if methods[j] == m && c.classes[t].overriding[j]
            return required_matching(c, t, own_class_type(c.classes[t], t), m, 0)
    None

/** Whether trait method `n` overrides `m`, directly or through the overrides between them. */
private replaces(c: *Checker, n: usize, m: usize) -> bool
    var x = n
    var steps = 0usize
    while steps <= c.classes.len()
        x = trait_overridden(c, x) match
            Some(o) -> o
            None -> return false
        if x == m then return true
        steps += 1
    false

/** The methods a type may inherit under one name, without those another of them overrides: a
 * trait's override replaces the method of the trait it requires, and one without a body makes the
 * method abstract again, so the default it replaces is not inherited. */
private unreplaced(c: *Checker, methods: Buf[usize]) -> Buf[usize]
    var out: Buf[usize] = buf()
    for m in methods
        var replaced = false
        for n in methods
            if n != m && replaces(c, n, m) then replaced = true
        if !replaced then out.push(m)
    out

/** The methods of `methods` that have bodies. */
private with_bodies(c: *Checker, methods: Buf[usize]) -> Buf[usize]
    var out: Buf[usize] = buf()
    for m in methods
        if !is_abstract_method(c.symbols[m]) then out.push(m)
    out

/** A trait's override without a body among `methods`: the declaration a type inheriting no body for
 * the method must implement. */
private redeclared(c: *Checker, methods: Buf[usize]) -> Option[usize]
    for m in methods
        if is_abstract_method(c.symbols[m]) && is_trait_override(c, m) then return Some(m)
    None

/** Whether a trait's method `m` is an override, which has no position of its own. */
private is_trait_override(c: *Checker, m: usize) -> bool = trait_overridden(c, m) is Some(_)

/** The first position of class `k`'s method table holding the same method as `target`. */
private table_position(c: *Checker, k: usize, target: usize) -> Option[usize]
    val self_type = own_class_type(c.classes[k], k)
    val table = c.classes[k].table
    for i in 0..<table.len()
        if table[i] is Some(m)
            if same_method(c, self_type, m, target) then return Some(i)
    None

/** The traits an instance of `t` conforms to: those its class names and those they require, then
 * its superclass's, each as an instance of `t` sees it. A trait conformed to with two different type
 * argument lists appears twice. */
private collect_traits(c: *Checker, t: &Type, out: *Buf[&Type])
    if is_builtin(t) || is_integer_family(t) || *t is Tuple(_)
        for r in builtin_traits(c, t)
            var seen = false
            for i in 0..<out.len()
                if same_type(out[i], r) then seen = true
            if !seen
                out.push(r)
                collect_traits(c, r, out)
        return
    if *t is Data(d, _, xs)
        for required in c.data[d].traits
            val r = substitute(required, data_owner(d), xs)
            var seen = false
            for i in 0..<out.len()
                if same_type(out[i], r) then seen = true
            if !seen
                out.push(r)
                collect_traits(c, r, out)
        return
    val k = *t match
        Class(k, _, _) -> k
        _ -> return
    val args = *t match
        Class(_, _, a) -> a
        _ -> buf()
    for required in c.classes[k].traits
        val r = substitute(required, class_owner(k), args)
        var seen = false
        for i in 0..<out.len()
            if same_type(out[i], r) then seen = true
        if !seen
            out.push(r)
            collect_traits(c, r, out)
    if c.classes[k].superclass is Some(sup) then collect_traits(c, substitute(sup, class_owner(k), args), out)

/** The ids of the traits class `k` conforms to, each once. */
private conformed_traits(c: *Checker, k: usize) -> Buf[usize] = trait_ids(c, own_class_type(c.classes[k], k))

/** The ids of the traits data type `d` conforms to through its impls, each once. */
private data_traits(c: *Checker, d: usize) -> Buf[usize] = trait_ids(c, own_type(c.data[d], d))

private trait_ids(c: *Checker, t: &Type) -> Buf[usize]
    var types: Buf[&Type] = buf()
    collect_traits(c, t, &types)
    var ids: Buf[usize] = buf()
    for t in types
        if *t is Class(id, _, _)
            if !contains_id(ids, id) then ids.push(id)
    ids

private contains_id(ids: Buf[usize], id: usize) -> bool
    for i in ids
        if i == id then return true
    false

/** Whether trait `k` requires the trait `start`, directly or through the traits it requires. */
private requires_trait(c: *Checker, start: usize, k: usize, depth: usize) -> bool
    if depth > c.classes.len() then return false
    for required in c.classes[k].traits
        if *required is Class(r, _, _)
            if r == start || requires_trait(c, start, r, depth + 1) then return true
    false

// A trait that requires itself, directly or not, is reported and requires nothing, so a walk over
// what a type conforms to ends.
private break_trait_cycles(c: *Checker)
    for id in 0..<c.classes.len()
        if !is_trait(c, id) then continue
        if requires_trait(c, id, id, 0)
            c.note(c.classes[id].unit, c.classes[id].decl.name_span, s"`${c.classes[id].name}` requires itself")
            c.classes[id].traits = buf()

/** The slot of class `k`'s method table that holds the method named `name`, if it has one. */
/** The slot of class `k`'s method table that holds the same method as `m`, as `self_type` sees both. */
private slot_matching(c: *Checker, k: usize, self_type: &Type, m: usize) -> Option[usize]
    val slots = c.classes[k].slots
    for i in 0..<slots.len()
        if same_method(c, self_type, slots[i], m) then return Some(i)
    None

// An `override` that matches no inherited method by name and parameter types. With no method of
// that name to override it overrides nothing; with one, how its parameters differ from that one's;
// with several, it overrides none of those overloads.
private unmatched_override(c: *Checker, id: usize, sid: Option[usize], conformed: Buf[&Type], m: usize)
    val k = c.classes[id]
    val symbol = c.symbols[m]
    val name = symbol.decl.name
    val self_type = own_class_type(k, id)
    var named: Buf[usize] = buf()
    if sid is Some(s)
        var a = s
        loop
            for other in c.classes[a].methods
                if c.symbols[other].decl.name == name && c.symbols[other].public then add_method(c, self_type, &named, other)
            val sup = c.classes[a].superclass match
                Some(t) -> t
                None -> break
            a = *sup match
                Class(next, _, _) -> next
                _ -> break
    for t in conformed
        if *t is Class(tid, _, _)
            for other in c.classes[tid].methods
                if c.symbols[other].decl.name == name then add_method(c, self_type, &named, other)
    if named.len() == 0
        c.note(k.unit, symbol.decl.name_span, s"`$name` overrides nothing; no superclass or trait of `${k.name}` has a method `$name`")
    elif named.len() == 1 then overrides_matches(c, id, m, named[0])
    else c.note(k.unit, symbol.decl.name_span, s"`${method_key(c, self_type, m)}` overrides nothing; the inherited overloads are ${overload_list(c, named)}, and none takes these parameter types")

// A class's method table, built after its superclass's: the superclass's slots, then a slot for each
// method a subclass may override. A method marked `override` takes the slot of the inherited method
// it replaces, which must have the same parameter types and a result it conforms to; a method that
// shares an inherited method's name without `override` is an error. A class that is not abstract
// implements every abstract method it inherits.
private link_methods(c: *Checker, id: usize, linked: *Buf[bool])
    if linked[id] then return
    linked.set(id, true)
    val k = c.classes[id]
    val unit = k.unit
    if is_trait(c, id)
        // A trait's methods take positions of their own in its conforming classes' tables, except an
        // override, which replaces the default of a method of a trait it requires at that method's
        // position. Redeclaring a required trait's method without `override` is an error.
        // An override takes the defaults of the method it overrides, so the required traits, whose
        // own overrides may bring theirs, are linked first.
        for required in k.traits
            if *required is Class(r, _, _) then link_methods(c, r, linked)
        val trait_type = own_class_type(k, id)
        for i in 0..<k.methods.len()
            val m = k.methods[i]
            val name = c.symbols[m].decl.name
            val target = required_matching(c, id, trait_type, m, 0)
            if k.overriding[i]
                if target is Some(other)
                    if overrides_matches(c, id, m, other) then inherit_defaults(c, m, other)
                elif trait_method(c, id, name) is Some(other)
                    overrides_matches(c, id, m, other)
                else c.note(unit, c.symbols[m].decl.name_span, s"`$name` overrides nothing; no trait `${k.name}` requires has a method `$name`")
            elif target is Some(other)
                val owner = c.classes[c.symbols[other].owner_class.unwrap()].name
                if is_trait_field(c, m) || is_trait_field(c, other) then c.note(unit, c.symbols[m].decl.name_span, s"`$name` is already a member of `$owner`, which `${k.name}` requires; a trait's field or `val` is declared once")
                else c.note(unit, c.symbols[m].decl.name_span, s"`$name` is already a method of `$owner`, which `${k.name}` requires; mark it `override` to replace its default")
        return
    var slots: Buf[usize] = buf()
    var sid: Option[usize] = None
    if k.superclass is Some(t)
        if *t is Class(s, _, _)
            link_methods(c, s, linked)
            sid = Some(s)
            for m in c.classes[s].slots
                slots.push(m)
            for i in k.inherited..<k.fields.len()
                if inherited_method(c, s, k.fields[i].name) is Some(m)
                    c.note(unit, k.fields[i].span, s"`${k.fields[i].name}` is already a method of `${c.classes[c.symbols[m].owner_class.unwrap()].name}`")
    var conformed: Buf[&Type] = buf()
    collect_traits(c, own_class_type(k, id), &conformed)
    // A trait's overrides take their defaults when it is linked, before a class's methods take them.
    for t in conformed
        if *t is Class(tid, _, _) then link_methods(c, tid, linked)
    for i in 0..<conformed.len()
        for j in 0..<i
            if *conformed[i] is Class(a, _, _) && *conformed[j] is Class(b, _, _)
                if a == b && !(implemented_several_times(c, a) && !same_type(conformed[i], conformed[j])) then c.note(unit, k.decl.name_span, s"`${k.name}` conforms to `${c.classes[a].name}` twice, as ${type_name(conformed[j])} and ${type_name(conformed[i])}")
    for f in k.fields
        if f.owner == id && f.public
            if trait_method(c, id, f.name) is Some(m)
                if !is_trait_field(c, m) then c.note(unit, f.span, s"`${f.name}` is already a method of `${c.classes[c.symbols[m].owner_class.unwrap()].name}`")
    val self_type = own_class_type(k, id)
    for i in 0..<k.methods.len()
        val m = k.methods[i]
        val symbol = c.symbols[m]
        val name = symbol.decl.name
        var inherited: Option[usize] = None
        if sid is Some(s) then inherited = inherited_matching(c, s, self_type, m)
        // Every method of the traits the class conforms to that the method implements.
        var implemented: Buf[usize] = buf()
        for t in conformed
            if *t is Class(tid, _, _)
                if own_matching(c, tid, self_type, m) is Some(tm)
                    if !contains_id(implemented, tm) then implemented.push(tm)
        // A static member implements a trait's static member, and a method a trait's method.
        var mismatched = false
        for tm in implemented
            if c.symbols[tm].static_member != symbol.static_member && !mismatched
                mismatched = true
                report_static_mismatch(c, symbol.unit, symbol.decl.name_span, name, c.classes[c.symbols[tm].owner_class.unwrap()].name, c.symbols[tm].static_member)
        if mismatched then continue
        // A static member implementing a trait the class conforms to at several type arguments is
        // matched to its conformance once every class is linked.
        if symbol.static_member && implemented.len() == 0 && implements_several(c, conformed, self_type, m) then continue
        if symbol.static_member && implemented.len() == 0
            c.note(symbol.unit, symbol.decl.name_span, s"`$name` is static, which only a trait's member and its implementations are; `${k.name}` conforms to no trait with a static `$name`")
            continue
        var supplies_field = false
        for tm in implemented
            if is_trait_field(c, tm) && !supplies_field
                supplies_field = true
                c.note(unit, symbol.decl.name_span, s"`$name` is a `val` of `${c.classes[c.symbols[tm].owner_class.unwrap()].name}`, which `${k.name}` supplies with a field, not a method: declare `val $name: ${type_name(seen_from(c, self_type, tm, c.symbols[tm].result.unwrap_or(ErrorType)))}`")
        if supplies_field then continue
        if k.overriding[i]
            if inherited is None && implemented.len() == 0
                unmatched_override(c, id, sid, conformed, m)
                continue
            if !symbol.public
                c.note(unit, symbol.decl.name_span, s"`$name` overrides a public method, so it cannot be private")
                continue
            if inherited is Some(target)
                // An inherited method that implements a trait's method has that trait's position
                // rather than a slot of its own.
                slot_matching(c, sid.unwrap(), self_type, m) match
                    Some(slot) ->
                        if overrides_matches(c, id, m, target)
                            slots.set(slot, m)
                            inherit_defaults(c, m, target)
                    None ->
                        if overrides_matches(c, id, m, target) then inherit_defaults(c, m, target)
            for tm in implemented
                if overrides_matches(c, id, m, tm) then inherit_defaults(c, m, tm)
        elif inherited is Some(t)
            c.note(unit, symbol.decl.name_span, s"`$name` overrides `${c.symbols[t].name}`; mark it `override`")
        elif implemented.len() > 0
            c.note(unit, symbol.decl.name_span, s"`$name` implements `${c.symbols[implemented[0]].name}`; mark it `override`")
        elif is_open(c, id) && symbol.public then slots.push(m)
    c.classes[id].slots = slots

// Each trait's position in the method tables of the classes and data types conforming to it. The
// whole program is known, so the positions are chosen once for all of them: each trait takes the
// lowest position at which its methods fit, in every type conforming to it, past a class's own slots
// and the positions of the other traits the type conforms to that are already placed.
private place_traits(c: *Checker)
    var conformed: Buf[Buf[usize]] = buf()
    for k in 0..<c.classes.len()
        if is_trait(c, k) then conformed.push(buf()) else conformed.push(conformed_traits(c, k))
    // Every conforming type's traits and slot count: the classes, then the data types.
    var holders: Buf[Buf[usize]] = buf()
    var slot_counts: Buf[usize] = buf()
    for k in 0..<c.classes.len()
        holders.push(conformed[k])
        slot_counts.push(c.classes[k].slots.len())
    var data_conformed: Buf[Buf[usize]] = buf()
    for d in 0..<c.data.len()
        val ids = data_traits(c, d)
        data_conformed.push(ids)
        holders.push(ids)
        slot_counts.push(0)
    // A built-in type's conformances are gathered under the first impl that names it.
    var builtin_conformed: Buf[Buf[usize]] = buf()
    for b in 0..<c.builtins.len()
        var first = true
        for e in 0..<b
            if same_type(c.builtins[e].ty, c.builtins[b].ty) then first = false
        val ids = if first then trait_ids(c, c.builtins[b].ty) else buf()
        builtin_conformed.push(ids)
        holders.push(ids)
        slot_counts.push(0)
    var placed: Buf[bool] = buf()
    for _ in c.classes
        placed.push(false)
    for t in 0..<c.classes.len()
        if !is_trait(c, t) then continue
        val n = c.classes[t].methods.len()
        var base = 0usize
        loop
            if n == 0 then break
            var free = true
            for k in 0..<holders.len()
                if !contains_id(holders[k], t) then continue
                if base < slot_counts[k] then free = false
                for other in holders[k]
                    if placed[other]
                        val start = c.classes[other].base
                        val end = start + c.classes[other].methods.len()
                        if base < end && start < base + n then free = false
            if free then break
            base += 1
        c.classes[t].base = base
        placed.set(t, true)
    for k in 0..<c.classes.len()
        if !is_trait(c, k) then ensure_table(c, k, conformed)
    for d in 0..<c.data.len()
        build_data_table(c, d, data_conformed[d])
    for b in 0..<c.builtins.len()
        build_builtin_table(c, b, builtin_conformed[b])

// A built-in type's method table, kept by the first of its conformances: at each position of a
// trait it conforms to, the method of the type's impl that implements it. A built-in value is no
// object, so it cannot take a trait's default body, which is shared by objects of every conforming
// type; its impl implements every method of the trait.
private build_builtin_table(c: *Checker, b: usize, conformed: Buf[usize])
    if conformed.len() == 0 then return
    val ty = c.builtins[b].ty
    val name_of = type_name(ty)
    var size = 0usize
    for t in conformed
        val end = c.classes[t].base + c.classes[t].methods.len()
        if end > size then size = end
    var table: Buf[Option[usize]] = buf()
    for _ in 0..<size
        table.push(None)
    for t in conformed
        val methods = c.classes[t].methods
        for j in 0..<methods.len()
            if is_trait_override(c, methods[j]) then continue
            // A built-in type has `==` and the hash already.
            if is_universal(c, methods[j]) then continue
            val name = c.symbols[methods[j]].decl.name
            var own: Option[usize] = None
            // A width's impls for every integer width implement the trait as the family sees it.
            // A trait implemented at several type arguments has its members matched to each of its
            // conformances once all are known; the table holds any one of them.
            val several = implemented_several_times(c, t)
            for m in c.builtin_methods
                val receiver = c.symbols[m].receiver.unwrap()
                if own is None && builtin_covers(receiver, ty) && (if several then c.symbols[m].decl.name == name && c.symbols[m].static_member else same_method(c, receiver, m, methods[j])) then own = Some(m)
            if several && own is None then continue
            own match
                Some(m) ->
                    inherit_defaults(c, m, methods[j])
                    table.set(c.classes[t].base + j, Some(m))
                None ->
                    var at = b
                    for e in 0..<c.builtins.len()
                        if same_type(c.builtins[e].ty, ty) && *c.builtins[e].trait_type is Class(k, _, _)
                            if k == t then at = e
                    val what = if is_trait_field(c, methods[j]) then s"`val $name`, which a built-in type has no field to supply" else s"`$name`; a built-in type takes no default bodies, so its impl implements every method of the trait"
                    c.note(c.builtins[at].unit, c.builtins[at].span, s"`$name_of` does not implement ${c.classes[t].name}'s $what")
    c.builtins[b].table = table

// A data type's method table: at each position of a trait it conforms to, the type's own method of
// that name, which an impl of a trait declares, or else the trait's default body. Two different
// default bodies under one name must be replaced by the type's own; every abstract method must be.
private build_data_table(c: *Checker, id: usize, conformed: Buf[usize])
    if conformed.len() == 0 then return
    val name_of = c.data[id].name
    var size = 0usize
    for t in conformed
        val end = c.classes[t].base + c.classes[t].methods.len()
        if end > size then size = end
    var table: Buf[Option[usize]] = buf()
    for _ in 0..<size
        table.push(None)
    var reported: Buf[string] = buf()
    val self_type = own_type(c.data[id], id)
    for t in conformed
        val methods = c.classes[t].methods
        for j in 0..<methods.len()
            // An override fills the position of the method it overrides.
            if is_trait_override(c, methods[j]) then continue
            val name = c.symbols[methods[j]].decl.name
            val key = method_key(c, self_type, methods[j])
            var chosen = methods[j]
            var own: Option[usize] = None
            val mine = c.data[id].methods
            if is_trait_field(c, methods[j])
                table.set(c.classes[t].base + j, Some(data_supplied_field(c, id, methods[j])))
                continue
            for k in 0..<mine.len()
                if same_method(c, self_type, mine[k], methods[j])
                    own = Some(mine[k])
                    if !c.data[id].implementing[k] && !contains_name(reported, key)
                        reported.push(key)
                        val m = mine[k]
                        c.note(c.symbols[m].unit, c.symbols[m].decl.name_span, s"`$name` implements `${c.symbols[methods[j]].name}`, so it belongs in an impl of `${c.classes[t].name}` for `$name_of`")
            if own is Some(m)
                chosen = m
                index_tie(c, m, methods[j])
                inherit_defaults(c, m, methods[j])
            else
                var found: Buf[usize] = buf()
                for other in conformed
                    if own_matching(c, other, self_type, methods[j]) is Some(m)
                        if !contains_id(found, m) then found.push(m)
                val kept = unreplaced(c, found)
                val bodies = with_bodies(c, kept)
                if bodies.len() > 0 then chosen = bodies[0]
                elif redeclared(c, kept) is Some(m) then chosen = m
                if bodies.len() > 1 && !contains_name(reported, key)
                    reported.push(key)
                    report_conformance(c, id, t, s"`$name_of` inherits two implementations of `$name`, `${c.symbols[bodies[0]].name}` and `${c.symbols[bodies[1]].name}`; implement it in an impl")
                elif bodies.len() == 1 && chosen != methods[j] && !contains_name(reported, key)
                    if defaults_conflict(c, chosen, methods[j], s"implement `$name` in an impl") is Some(text)
                        reported.push(key)
                        report_conformance(c, id, t, s"`${c.symbols[chosen].name}` implements `${c.symbols[methods[j]].name}` for `$name_of`, $text")
            table.set(c.classes[t].base + j, Some(chosen))
    c.data[id].table = table
    for entry in table
        if entry is Some(m)
            val name = c.symbols[m].decl.name
            val key = method_key(c, self_type, m)
            if is_abstract_method(c.symbols[m]) && !is_universal(c, m) && !contains_name(reported, key)
                reported.push(key)
                val t = c.symbols[m].owner_class.unwrap()
                if is_trait_field(c, m)
                    val ty = seen_from(c, self_type, m, c.symbols[m].result.unwrap_or(ErrorType))
                    val how = if c.data[id].variants.len() == 1 then s"declare a field `$name: ${type_name(ty)}` in it" else "it has several variants, so it has no field every value shares"
                    report_conformance(c, id, t, s"`$name_of` does not supply `${c.classes[t].name}`'s `val $name`, which a data type supplies with a field of its one variant; $how")
                    continue
                // A method of an impl of the trait with this name and other parameter types was meant
                // to implement it where the trait has no other method of the name.
                var meant: Option[usize] = None
                var overloads = 0
                for other in c.classes[t].methods
                    if c.symbols[other].decl.name == name then overloads += 1
                val mine = c.data[id].methods
                for k in 0..<mine.len()
                    if c.data[id].implementing[k] && c.symbols[mine[k]].decl.name == name && meant is None then meant = Some(mine[k])
                if overloads == 1 && meant is Some(own)
                    if param_mismatch(c, self_type, own, m) is Some(text)
                        c.note(c.symbols[own].unit, c.symbols[own].decl.name_span, s"`${c.symbols[own].name}` implements `${c.symbols[m].name}`, $text")
                        continue
                report_conformance(c, id, t, s"`$name_of` does not implement `$name` from `${c.classes[t].name}`; implement it in an impl of `${c.classes[t].name}`")

// What fills the position of a trait's `val` `tm` in data type `id`'s table: a method that reads the
// field of that name of the type's one variant, or else `tm` itself, which leaves it abstract. A
// method an impl declares under the name is reported, since a field supplies a `val`.
private data_supplied_field(c: *Checker, id: usize, tm: usize) -> usize
    val d = c.data[id]
    val name = c.symbols[tm].decl.name
    val self_type = own_type(d, id)
    for m in d.methods
        if same_method(c, self_type, m, tm)
            val ty = seen_from(c, self_type, tm, c.symbols[tm].result.unwrap_or(ErrorType))
            c.note(c.symbols[m].unit, c.symbols[m].decl.name_span, s"`$name` is a `val` of `${c.classes[c.symbols[tm].owner_class.unwrap()].name}`, which `${d.name}` supplies with a field, not a method: declare the field `$name: ${type_name(ty)}`")
            return m
    if d.variants.len() == 1
        if contains_name(d.variants[0].field_names, name)
            return field_getter(c, d.unit, d.module_name, d.name, d.decl.span, name, self_type, data_owner(id), d.decl.type_params, None)
    tm

// A problem with data type `id`'s conformance to trait `t` is reported at the impl that brings the
// trait in: the impl of `t` itself, or of a trait requiring it.
private report_conformance(c: *Checker, id: usize, t: usize, message: string)
    for block in c.impls
        if *block.target is Data(d, _, _)
            if d != id then continue
            if block.trait_type is Some(tt)
                if *tt is Class(k, _, _)
                    if k == t || requires_trait(c, t, k, 0)
                        c.note(block.unit, block.decl.target.span, message)
                        return
    c.note(c.data[id].unit, c.data[id].decl.span, message)

// A class's method table: its slots, then at each trait's position the implementation of each of
// the trait's methods. Under each name the class's own override wins; otherwise the class inherits
// what its superclass's table holds and the default bodies of the traits it newly conforms to, and
// when those are two different implementations it must override the method. A class that is not
// abstract implements every abstract method its table holds.
private build_table(c: *Checker, id: usize, conformed: Buf[Buf[usize]])
    val k = c.classes[id]
    var size = k.slots.len()
    for t in conformed[id]
        val end = c.classes[t].base + c.classes[t].methods.len()
        if end > size then size = end
    var table: Buf[Option[usize]] = buf()
    for i in 0..<size
        if i < k.slots.len() then table.push(Some(k.slots[i])) else table.push(None)
    for t in conformed[id]
        val methods = c.classes[t].methods
        for j in 0..<methods.len()
            if !is_trait_override(c, methods[j]) then table.set(c.classes[t].base + j, Some(methods[j]))
    var inherited_traits: Buf[usize] = buf()
    var sup_table: Buf[Option[usize]] = buf()
    if k.superclass is Some(s)
        if *s is Class(sid, _, _)
            inherited_traits = conformed[sid]
            ensure_table(c, sid, conformed)
            sup_table = c.classes[sid].table
    var reported: Buf[string] = buf()
    val self_type = own_class_type(k, id)
    for i in 0..<size
        val listed = table[i] match
            Some(m) -> m
            None -> continue
        // At the position of a trait the superclass already implements, the method is the
        // superclass's implementation: its `Self` is the superclass, the type that conforms, so an
        // override matches it rather than the trait's method seen with this class as `Self`.
        var held = listed
        if i >= k.slots.len() && i < sup_table.len()
            if sup_table[i] is Some(sm)
                if !is_abstract_method(c.symbols[sm]) && c.symbols[sm].decl.name == c.symbols[listed].decl.name then held = sm
        val name = c.symbols[held].decl.name
        val key = method_key(c, self_type, held)
        if is_trait_field(c, held)
            table.set(i, Some(supplied_field(c, id, held, sup_table, i)))
            continue
        if contains_id(c.trait_setters, held)
            table.set(i, Some(supplied_setter(c, id, held, sup_table, i)))
            continue
        // Every method the class inherits that is this one; its own override, if it has one.
        var candidates: Buf[usize] = buf()
        var own: Option[usize] = None
        for m in k.methods
            if own is None && same_method(c, self_type, m, held)
                if c.symbols[m].public then own = Some(m)
        for entry in table
            if entry is Some(m)
                if same_method(c, self_type, m, held) && !is_trait(c, c.symbols[m].owner_class.unwrap()) && !contains_id(candidates, m) then candidates.push(m)
        for entry in sup_table
            if entry is Some(m)
                if same_method(c, self_type, m, held) && !contains_id(candidates, m) then candidates.push(m)
        for t in conformed[id]
            if contains_id(inherited_traits, t) then continue
            if own_matching(c, t, self_type, held) is Some(m)
                if !contains_id(candidates, m) then candidates.push(m)
        var chosen: Option[usize] = own
        if own is None
            val kept = unreplaced(c, candidates)
            val bodies = with_bodies(c, kept)
            if bodies.len() > 0 then chosen = Some(bodies[0])
            elif redeclared(c, kept) is Some(m) then chosen = Some(m)
            if bodies.len() > 1 && !contains_name(reported, key)
                reported.push(key)
                c.note(k.unit, k.decl.name_span, s"`${k.name}` inherits two implementations of `$name`, `${c.symbols[bodies[0]].name}` and `${c.symbols[bodies[1]].name}`; override it")
        if chosen is Some(m) then table.set(i, Some(m))
    c.classes[id].table = table
    // A static member belongs to the type, so an abstract class implements its traits' too.
    val abstract_class = is_abstract_class(c, id)
    if !is_trait(c, id)
        var missing: Buf[string] = buf()
        for entry in table
            if entry is Some(m)
                if abstract_class && !c.symbols[m].static_member then continue
                // A trait's `var` field the class does not store was reported where it clashed.
                if contains_id(c.trait_setters, m) then continue
                val name = c.symbols[m].decl.name
                val key = method_key(c, self_type, m)
                if is_abstract_method(c.symbols[m]) && !is_universal(c, m) && !contains_name(missing, key)
                    missing.push(key)
                    val owner = c.symbols[m].owner_class.unwrap()
                    if abstract_class
                        c.note(k.unit, k.decl.name_span, s"`${k.name}` does not implement the static member `$name` from `${c.classes[owner].name}`; implement it: it belongs to the type, so an abstract class gives it too")
                        continue
                    // An object is its one instance, so it cannot be left abstract.
                    val otherwise = if k.decl.object then "" else s", or declare `${k.name}` abstract"
                    if is_trait_field(c, m)
                        val ty = seen_from(c, self_type, m, c.symbols[m].result.unwrap_or(ErrorType))
                        c.note(k.unit, k.decl.name_span, s"`${k.name}` does not supply `${c.classes[owner].name}`'s `val $name`; declare a public field `val $name: ${type_name(ty)}`$otherwise")
                        continue
                    c.note(k.unit, k.decl.name_span, s"`${k.name}` does not implement `$name` from `${c.classes[owner].name}`; implement it$otherwise")

// What fills the position of a trait's `val` `tm`, at `position` of class `id`'s table: the method
// that reads the class's public field of that name, the superclass's where it already supplies the
// trait, or else `tm` itself, which leaves it abstract. A method or a private field of that name is
// reported where it is declared.
private supplied_field(c: *Checker, id: usize, tm: usize, sup_table: Buf[Option[usize]], position: usize) -> usize
    if position < sup_table.len()
        if sup_table[position] is Some(m)
            if contains_id(c.field_getters, m) then return m
    val k = c.classes[id]
    val name = c.symbols[tm].decl.name
    for m in k.methods
        if same_method(c, own_class_type(k, id), m, tm) then return m
    var hidden: Option[usize] = None
    for i in 0..<k.fields.len()
        if k.fields[i].name != name then continue
        if k.fields[i].public then return field_getter(c, k.unit, k.module_name, k.name, k.fields[i].span, name, own_class_type(k, id), class_owner(id), k.decl.type_params, Some(id))
        hidden = Some(i)
    if hidden is Some(i)
        val f = k.fields[i]
        val keyword = if f.mutable then "var" else "val"
        c.note(k.unit, f.span, s"`$name` is private to `${c.classes[f.owner].name}`, so it cannot supply `${c.classes[c.symbols[tm].owner_class.unwrap()].name}`'s `val $name`; declare it a public field, `$keyword $name`")
        return field_getter(c, k.unit, k.module_name, k.name, f.span, name, own_class_type(k, id), class_owner(id), k.decl.type_params, Some(id))
    tm

// A method that yields field `name` of its receiver, `self.name`, which supplies a trait's `val` of
// that name: a class's method when `owner_class` is its class, otherwise one an impl adds to the
// data type `self_type`.
private field_getter(c: *Checker, unit: usize, module_name: string, type_name_of: string, at: Span, name: string, self_type: &Type, type_owner: usize, type_params: Buf[TypeParam], owner_class: Option[usize]) -> usize
    // One field supplies the `val` of that name of every trait the type conforms to, through one
    // method.
    for g in c.field_getters
        if c.symbols[g].type_owner == type_owner && c.symbols[g].decl.name == name then return g
    val read = Expr(at, Member(Expr(at, Name("self")), name))
    val decl = Function(buf(), at, at, name, buf(), buf(), None, Some(read), buf())
    var params: Buf[&Type] = buf()
    params.push(self_type)
    var names: Buf[string] = buf()
    names.push("self")
    var defaults: Buf[Option[usize]] = buf()
    defaults.push(None)
    val receiver = if owner_class is None then Some(self_type) else None
    val id = c.symbols.len()
    c.symbols.push(FunctionSymbol(unit, module_name, type_name_of + "." + name, decl, params, names, None, None, None, buf(), buf(), buf(), false, false, false, defaults, None, type_owner, type_params, owner_class, false, true, "", receiver, false))
    c.states.push(0)
    c.bodies.push(None)
    c.locals.push(buf())
    c.field_getters.push(id)
    id

// What fills the position of the method `tm` that assigns a trait's `var` field, at `position` of
// class `id`'s table: the superclass's where it already stores the field, or else a method that
// assigns the field the class stores, `self.name = value`.
private supplied_setter(c: *Checker, id: usize, tm: usize, sup_table: Buf[Option[usize]], position: usize) -> usize
    if position < sup_table.len()
        if sup_table[position] is Some(m)
            if contains_id(c.field_setters, m) then return m
    val k = c.classes[id]
    val written = c.symbols[tm].decl.name
    var name = ""
    for s in c.classes[c.symbols[tm].owner_class.unwrap()].state
        if s.setter is Some(x)
            if x == tm then name = s.field.name
    for i in 0..<k.fields.len()
        if k.fields[i].name == name && k.fields[i].owner == c.symbols[tm].owner_class.unwrap()
            val self_type = own_class_type(k, id)
            val at = k.fields[i].span
            val store = Expr(at, Assign(Expr(at, Member(Expr(at, Name("self")), name)), None, Expr(at, Name("value")), false, at))
            val decl = Function(buf(), at, at, written, buf(), buf(), None, Some(store), buf())
            var params: Buf[&Type] = buf()
            params.push(self_type)
            params.push(k.fields[i].ty.unwrap_or(ErrorType))
            var names: Buf[string] = buf()
            names.push("self")
            names.push("value")
            var defaults: Buf[Option[usize]] = buf()
            defaults.push(None)
            defaults.push(None)
            val setter = c.symbols.len()
            c.symbols.push(FunctionSymbol(k.unit, k.module_name, k.name + "." + written, decl, params, names, Some(Unit), None, None, buf(), buf(), buf(), false, false, false, defaults, None, class_owner(id), k.decl.type_params, Some(id), false, true, "", None, false))
            c.states.push(0)
            c.bodies.push(None)
            c.locals.push(buf())
            c.field_setters.push(setter)
            return setter
    tm

/** Class `id`'s method table, built first if it is not yet. */
private ensure_table(c: *Checker, id: usize, conformed: Buf[Buf[usize]])
    if c.classes[id].table.len() == 0 then build_table(c, id, conformed)

// An override declares as many type parameters of its own as the method it overrides, takes its
// parameters, with the superclass's type arguments substituted and the type parameters matched by
// position, and yields its result or, for a class, a subclass of it.
private overrides_matches(c: *Checker, id: usize, m: usize, target: usize) -> bool
    val symbol = c.symbols[m]
    if param_mismatch(c, own_class_type(c.classes[id], id), m, target) is Some(text)
        c.note(c.classes[id].unit, symbol.decl.name_span, s"`${symbol.decl.name}` overrides `${c.symbols[target].name}`, $text")
        return false
    index_tie(c, m, target)
    true

// The results of overrides, compared once every body is checked, since a result may be inferred: an
// override yields the overridden method's result or, where that is a class, a subclass of it.
// A trait's method may also be implemented by a method the class inherits, from its superclass or
// as another trait's default; that one takes the trait method's parameters and yields its result
// as the class sees them both.
// A class's or trait's `+T` appears only where a value of `T` is read out: a method's result, an
// immutable field, a parent's covariant argument. A `-T` appears only where one is passed in: a
// method's parameter. A mutable field is read and written, so neither may appear in it. Private
// members are checked like public ones, since a method of the instance seen at a wider type reads
// and writes them too. The receiver is the instance itself and is not checked.
private check_class_variance(c: *Checker, id: usize)
    val k = c.classes[id]
    val params = k.decl.type_params
    var variant = false
    for tp in params
        if !(tp.variance is Invariant) then variant = true
    if !variant then return
    val owner = class_owner(id)
    val at = k.decl.name_span
    if k.superclass is Some(sup) then variance_in(c, k.unit, params, owner, sup, 1, at, s"the superclass ${type_name(sup)}")
    for t in k.traits
        variance_in(c, k.unit, params, owner, t, 1, at, s"the trait ${type_name(t)}")
    for f in k.functions
        variance_in(c, k.unit, params, owner, f, 1, at, s"the function type ${type_name(f)}")
    for i in k.inherited..<k.fields.len()
        val f = k.fields[i]
        // A trait's field the class stores is checked with the trait, and the trait's arguments with
        // the class's traits.
        if f.owner != id then continue
        val ty = f.ty.unwrap_or(ErrorType)
        if f.mutable then variance_in(c, k.unit, params, owner, ty, 0, f.span, s"the mutable field `${f.name}`")
        else variance_in(c, k.unit, params, owner, ty, 1, f.span, s"the field `${f.name}`")
    // A trait's fields are its own, though each conforming class stores them.
    var immutable = true
    for s in k.state
        val ty = s.field.ty.unwrap_or(ErrorType)
        if s.field.mutable
            immutable = false
            variance_in(c, k.unit, params, owner, ty, 0, s.field.span, s"the mutable field `${s.field.name}`")
        else variance_in(c, k.unit, params, owner, ty, 1, s.field.span, s"the field `${s.field.name}`")
    // An instance whose fields are all immutable holds nothing a method could store a value into,
    // so the methods its impls add are not positions, as a `data` type's are not.
    for f in k.fields
        if f.mutable then immutable = false
    for m in k.methods
        if immutable && contains_id(c.impl_methods, m) then continue
        // The method assigning a trait's `var` field is the field, checked above.
        if contains_id(c.trait_setters, m) then continue
        val symbol = c.symbols[m]
        val name = symbol.decl.name
        for j in 1..<symbol.params.len()
            val span = if j - 1 < symbol.decl.params.len() then symbol.decl.params[j - 1].span else symbol.decl.name_span
            val pname = if j < symbol.param_names.len() then symbol.param_names[j] else "_"
            variance_in(c, k.unit, params, owner, symbol.params[j], -1, span, s"the parameter `$pname` of `$name`")
        val result_span = symbol.decl.result match
            Some(r) -> r.span
            None -> symbol.decl.name_span
        variance_in(c, k.unit, params, owner, symbol.result.unwrap_or(ErrorType), 1, result_span, s"the result of `$name`")
        // A bound on a method's own type parameter limits what a caller passes in, as a parameter
        // type does.
        for j in params.len()..<symbol.type_params.len()
            val tp = symbol.type_params[j]
            for b in bounds_at(c, owner, symbol.type_params, j)
                variance_in(c, k.unit, params, owner, b, -1, tp.span, s"the bound of `${tp.name}` in `$name`")
            // A lower bound is what a caller's type argument widens: a `+T` may be one, as in
            // `prepended[W >: T](x: W) -> List[W]`, and a `-T` may not.
            if lower_at(c, owner, symbol.type_params, j) is Some(l)
                variance_in(c, k.unit, params, owner, l, 1, tp.span, s"the lower bound of `${tp.name}` in `$name`")

// A data type's fields are immutable, so a `+T` may appear in them and a `-T` may not; the traits
// its impls make it conform to are parents, whose arguments follow their own variance.
private check_data_variance(c: *Checker, id: usize)
    val d = c.data[id]
    val params = d.decl.type_params
    var variant = false
    for tp in params
        if !(tp.variance is Invariant) then variant = true
    if !variant then return
    val owner = data_owner(id)
    for v in d.variants
        for i in 0..<v.fields.len()
            val name = if i < v.field_names.len() then v.field_names[i] else "_"
            variance_in(c, d.unit, params, owner, v.fields[i], 1, v.span, s"the field `$name` of `${v.name}`")
    for t in d.traits
        variance_in(c, d.unit, params, owner, t, 1, d.decl.span, s"the trait ${type_name(t)}")
    for f in d.functions
        variance_in(c, d.unit, params, owner, f, 1, d.decl.span, s"the function type ${type_name(f)}")

// Reports the first type parameter of `owner` that `t` names in a position its variance forbids.
// `polarity` is 1 where a value is read out, -1 where one is passed in, 0 where both happen; it flips
// through a function type's parameters and follows each generic type's declared variance.
private variance_in(c: *Checker, unit: usize, params: Buf[TypeParam], owner: usize, t: &Type, polarity: i32, at: Span, place: string) -> bool
    *t match
        TypeVar(o, i, name) ->
            if o != owner || i >= params.len() then return true
            val v = params[i].variance
            val ok = if v is Covariant then polarity == 1 elif v is Contravariant then polarity == -1 else true
            if ok then return true
            val kind = if v is Covariant then "covariant" else "contravariant"
            val sign = if v is Covariant then "+" else "-"
            val position = if polarity == 1 then "a covariant" elif polarity == -1 then "a contravariant" else "an invariant"
            c.note(unit, at, s"the $kind type parameter `$sign$name` appears in $position position, $place")
            false
        Tuple(items) ->
            for item in items
                if !variance_in(c, unit, params, owner, item, polarity, at, place) then return false
            true
        Function(ps, r) ->
            for p in ps
                if !variance_in(c, unit, params, owner, p, -polarity, at, place) then return false
            variance_in(c, unit, params, owner, r, polarity, at, place)
        ByName(inner) -> variance_in(c, unit, params, owner, inner, polarity, at, place)
        Data(d, _, args) -> variance_args(c, unit, params, owner, c.data[d].decl.type_params, args, polarity, at, place)
        Class(k, _, args) -> variance_args(c, unit, params, owner, c.classes[k].decl.type_params, args, polarity, at, place)
        _ -> true

private variance_args(c: *Checker, unit: usize, params: Buf[TypeParam], owner: usize, declared: Buf[TypeParam], args: Buf[&Type], polarity: i32, at: Span, place: string) -> bool
    for i in 0..<args.len()
        val v = if i < declared.len() then declared[i].variance else Invariant
        val p = if v is Covariant then polarity elif v is Contravariant then -polarity else 0
        if !variance_in(c, unit, params, owner, args[i], p, at, place) then return false
    true

private check_override_results(c: *Checker, id: usize)
    val k = c.classes[id]
    if is_trait(c, id)
        for m in k.methods
            if trait_overridden(c, m) is Some(base)
                if result_mismatch(c, own_class_type(k, id), m, base) is Some(text)
                    c.note(k.unit, c.symbols[m].decl.name_span, s"`${c.symbols[m].decl.name}` overrides `${c.symbols[base].name}`, $text")
        return
    if k.superclass is Some(sup)
        if *sup is Class(sid, _, _)
            val base_slots = c.classes[sid].slots
            for i in 0..<base_slots.len()
                val m = k.slots[i]
                if m == base_slots[i] || c.symbols[m].owner_class != Some(id) then continue
                if result_mismatch(c, own_class_type(c.classes[id], id), m, base_slots[i]) is Some(text)
                    c.note(k.unit, c.symbols[m].decl.name_span, s"`${c.symbols[m].decl.name}` overrides `${c.symbols[base_slots[i]].name}`, $text")
    var sup_table: Buf[Option[usize]] = buf()
    var sup_traits: Buf[usize] = buf()
    if k.superclass is Some(sup)
        if *sup is Class(sid, _, _)
            sup_table = c.classes[sid].table
            sup_traits = conformed_traits(c, sid)
    for t in conformed_traits(c, id)
        val methods = c.classes[t].methods
        for j in 0..<methods.len()
            // A trait's override shares the position of the method it overrides, and what fills it
            // implements the override too, yielding its narrower result.
            val redeclaring = is_trait_override(c, methods[j])
            val position = if redeclaring then trait_slot(c, methods[j]) else c.classes[t].base + j
            if position >= k.table.len() then continue
            val m = k.table[position] match
                Some(m) -> m
                None -> continue
            // Where the superclass implements the trait, the class keeps or overrides its
            // implementation, which was checked against the trait with the superclass as `Self`.
            var base = methods[j]
            if position < sup_table.len() && (!redeclaring || contains_id(sup_traits, t))
                if sup_table[position] is Some(sm)
                    if !is_abstract_method(c.symbols[sm]) && c.symbols[sm].decl.name == c.symbols[base].decl.name then base = sm
            if m == base then continue
            // A method made from a template is the template's, which is checked against the trait.
            c.derived_context = c.derived_symbols.get(s"$m")
            if contains_id(c.field_getters, m)
                if field_mismatch(c, own_class_type(c.classes[id], id), m, base) is Some(text) then c.note(k.unit, c.symbols[m].decl.name_span, text)
                continue
            val described = s"`${c.symbols[m].name}` implements `${c.symbols[base].name}`"
            val own = c.symbols[m].owner_class == Some(id)
            val at = if own then c.symbols[m].decl.name_span else k.decl.name_span
            if !own
                if param_mismatch(c, own_class_type(c.classes[id], id), m, base) is Some(text)
                    c.note(k.unit, at, s"$described for `${k.name}`, $text")
                    continue
                if defaults_conflict(c, m, base, s"override `${c.symbols[m].decl.name}`") is Some(text) then c.note(k.unit, at, s"$described for `${k.name}`, $text")
            if result_mismatch(c, own_class_type(c.classes[id], id), m, base) is Some(text)
                c.note(k.unit, at, s"$described, $text")
    c.derived_context = None

/** A type in method `m`'s signature as a value of `self_type`, a class's or a data type's own type,
 * sees it. The method's own type parameters are renamed by position to `method_params_owner()`, so
 * the signatures of two methods with type parameters of their own compare. */
private seen_from(c: *Checker, self_type: &Type, m: usize, t: &Type) -> &Type
    val symbol = c.symbols[m]
    val own = symbol.decl.type_params.len()
    val outer = symbol.type_params.len() - own
    var renamed = t
    if own > 0
        var names: Buf[&Type] = buf()
        for i in 0..<outer
            names.push(TypeVar(symbol.type_owner, i, symbol.type_params[i].name))
        for j in 0..<own
            names.push(TypeVar(method_params_owner(), j, symbol.type_params[outer + j].name))
        renamed = substitute(t, symbol.type_owner, names)
    // A method an impl adds to a data type already names the type's own parameters.
    val owner = symbol.owner_class match
        Some(k) -> k
        None -> return renamed
    var instance = ancestor_type(c.classes, c.data, self_type, owner)
    if c.seen_instance is Some(i)
        if *i is Class(k, _, _)
            if k == owner then instance = Some(i)
    val args = instance match
        Some(a) -> *a match
            Class(_, _, xs) -> xs
            _ -> buf()
        None -> buf()
    // A trait's `Self` is the type the method is seen from.
    var selfless = renamed
    if is_trait(c, owner)
        var implementer: Buf[&Type] = buf()
        implementer.push(self_type)
        selfless = substitute(renamed, self_owner(owner), implementer)
    substitute(selfless, class_owner(owner), args)

/** How many type parameters of its own method `m` declares. */
private own_type_params(c: *Checker, m: usize) -> usize = c.symbols[m].decl.type_params.len()

/** How method `m`'s parameters differ from those of `base`, which it implements for `self_type`.
 * The two declare the same number of type parameters of their own. */
private param_mismatch(c: *Checker, self_type: &Type, m: usize, base: usize) -> Option[string]
    val have = c.symbols[m].params
    val want = c.symbols[base].params
    val own = own_type_params(c, base)
    if own_type_params(c, m) != own then return Some(s"which has ${count(own, "type parameter")} of its own, not ${own_type_params(c, m)}")
    if have.len() != want.len() then return Some(s"which takes ${count(want.len() - 1, "parameter")}, not ${have.len() - 1}")
    for i in 1..<want.len()
        val w = seen_from(c, self_type, base, want[i])
        val h = seen_from(c, self_type, m, have[i])
        if !same_type(h, w) then return Some(s"whose parameter `${c.symbols[base].param_names[i]}` is ${type_name(w)}, not ${type_name(h)}")
    // An override assumes no more of its type arguments than the method it overrides: a lower bound
    // it writes is that method's.
    for j in 0..<own
        val h = method_lower(c, m, j) match
            Some(l) -> seen_from(c, self_type, m, l)
            None -> continue
        val name = c.symbols[base].decl.type_params[j].name
        method_lower(c, base, j) match
            Some(l) ->
                val w = seen_from(c, self_type, base, l)
                if !same_type(h, w) then return Some(s"whose type parameter `$name` has the lower bound ${type_name(w)}, not ${type_name(h)}")
            None -> return Some(s"whose type parameter `$name` has no lower bound")
    // A call through either method passes the same arguments, so both repeat their last parameter or
    // neither does.
    val repeats = declares_variadic(c.symbols[base].decl)
    if repeats != declares_variadic(c.symbols[m].decl)
        val last = c.symbols[base].param_names[want.len() - 1]
        return Some(if repeats then s"whose parameter `$last` is repeated" else s"whose parameter `$last` is not repeated")
    None

/** The lower bound of method `m`'s own type parameter `j`, if it has one. */
private method_lower(c: *Checker, m: usize, j: usize) -> Option[&Type]
    val symbol = c.symbols[m]
    val outer = symbol.type_params.len() - symbol.decl.type_params.len()
    lower_at(c, symbol.type_owner, symbol.type_params, outer + j)

/** How method `m`'s result differs from that of `base`, which it overrides or implements for
 * `self_type`: it yields that result or, where that is a class or a trait, a type conforming to it. */
private result_mismatch(c: *Checker, self_type: &Type, m: usize, base: usize) -> Option[string]
    val want = seen_from(c, self_type, base, c.symbols[base].result.unwrap_or(ErrorType))
    val own = seen_from(c, self_type, m, c.symbols[m].result.unwrap_or(ErrorType))
    var fits = alike_or_error(own, want) || *own is Nothing
    if *want is Class(b, _, _)
        if ancestor_type(c.classes, c.data, own, b) is Some(up) then fits = alike_or_error(up, want)
    if fits then None else Some(s"which yields ${type_name(want)}, not ${type_name(own)}")

// A class, trait or data type that is a function is one function type, and has an `apply` taking
// that type's parameters and yielding its result: what a call of its value as a function runs.
// Checked once every body is, since a result may be inferred.
private check_function_types(c: *Checker)
    for k in 0..<c.classes.len()
        val self_type = own_class_type(c.classes[k], k)
        c.classes[k].call = function_call(c, c.classes[k].unit, c.classes[k].decl.name_span, self_type, c.classes[k].name, methods_named(c, k, "apply"))
    for d in 0..<c.data.len()
        val self_type = own_type(c.data[d], d)
        c.data[d].call = function_call(c, c.data[d].unit, c.data[d].decl.span, self_type, c.data[d].name, receiver_methods(c, self_type, "apply"))

// The `apply`, among `applies`, that implements the function type `self_type` is a subtype of; `None`
// where it is no function, or reported where it is two or lacks that `apply`.
private function_call(c: *Checker, unit: usize, at: Span, self_type: &Type, name: string, applies: Buf[usize]) -> Option[usize]
    var found: Buf[&Type] = buf()
    function_ancestors(c.classes, c.data, self_type, &found, 0)
    if found.len() == 0 then return None
    if found.len() > 1
        c.note(unit, at, s"`$name` is a subtype of both ${type_name(found[0])} and ${type_name(found[1])}; a type is at most one function type")
        return None
    val f = found[0]
    var params: Buf[&Type] = buf()
    var result: &Type = ErrorType
    *f match
        Function(ps, r) ->
            params = ps
            result = r
        _ -> return None
    for m in applies
        val have = c.symbols[m].params
        if have.len() != params.len() + 1 || own_type_params(c, m) > 0 then continue
        var same = true
        for i in 0..<params.len()
            if !same_type(seen_from(c, self_type, m, have[i + 1]), params[i]) then same = false
        if !same then continue
        val yields = seen_from(c, self_type, m, c.symbols[m].result.unwrap_or(ErrorType))
        if alike_or_error(yields, result) || *yields is Nothing || same_type(view_as(conformances(c), yields, result), result) then return Some(m)
        c.note(unit, at, s"`$name` is a subtype of ${type_name(f)}, so its `apply` yields ${type_name(result)}, not ${type_name(yields)}")
        return None
    var written = ""
    for i in 0..<params.len()
        if i > 0 then written = written + ", "
        written = written + type_name(params[i])
    c.note(unit, at, s"`$name` is a subtype of ${type_name(f)}, so it has `apply($written) -> ${type_name(result)}`")
    None

// The methods in a data type's table implement its traits' methods with their parameters and yield
// their results, or types conforming to them, as the data type sees both; compared once every body
// is checked, since a result may be inferred.
private check_data_implementations(c: *Checker, id: usize)
    val table = c.data[id].table
    if table.len() == 0 then return
    val self_type = own_type(c.data[id], id)
    for t in data_traits(c, id)
        val methods = c.classes[t].methods
        for j in 0..<methods.len()
            // A trait's override shares the position of the method it overrides.
            val position = if is_trait_override(c, methods[j]) then trait_slot(c, methods[j]) else c.classes[t].base + j
            if position >= table.len() then continue
            val m = table[position] match
                Some(m) -> m
                None -> continue
            val base = methods[j]
            if m == base then continue
            if contains_id(c.field_getters, m)
                if field_mismatch(c, self_type, m, base) is Some(text) then report_conformance(c, id, t, text)
                continue
            val described = s"`${c.symbols[m].name}` implements `${c.symbols[base].name}`"
            // A method made from a template is the template's, which is checked against the trait.
            c.derived_context = c.derived_symbols.get(s"$m")
            if c.symbols[m].receiver is Some(_)
                val at = c.symbols[m].decl.name_span
                if param_mismatch(c, self_type, m, base) is Some(text) then c.note(c.symbols[m].unit, at, s"$described, $text")
                elif result_mismatch(c, self_type, m, base) is Some(text) then c.note(c.symbols[m].unit, at, s"$described, $text")
            elif param_mismatch(c, self_type, m, base) is Some(text) then report_conformance(c, id, t, s"$described for `${c.data[id].name}`, $text")
            elif result_mismatch(c, self_type, m, base) is Some(text) then report_conformance(c, id, t, s"$described, $text")
            c.derived_context = None

// A type that implements one of `equals` and `hash` implements the other, so that equal values have
// equal hashes.
private check_equality_pairs(c: *Checker)
    val eq = c.core.method_named("equals") match
        Some(m) -> m
        None -> return
    val hash = c.core.method_named("hash") match
        Some(m) -> m
        None -> return
    for k in 0..<c.classes.len()
        if is_trait(c, k) then continue
        val table = c.classes[k].table
        val own_eq = implemented_at(c, table, eq)
        if own_eq != implemented_at(c, table, hash)
            c.note(c.classes[k].unit, c.classes[k].decl.name_span, unpaired_equality(c.classes[k].name, own_eq))
    for d in 0..<c.data.len()
        val table = c.data[d].table
        val own_eq = implemented_at(c, table, eq)
        if own_eq != implemented_at(c, table, hash)
            var at = c.data[d].decl.span
            var unit = c.data[d].unit
            for block in c.impls
                if *block.target is Data(e, _, _)
                    if e == d && block.trait_type is Some(t)
                        if *t is Class(tk, _, _)
                            if is_core_trait(c, tk, "Eq") || is_core_trait(c, tk, "Hash")
                                at = written_trait_span(block.decl)
                                unit = block.unit
            c.note(unit, at, unpaired_equality(c.data[d].name, own_eq))

// A type implementing a trait at several type arguments gives each of the trait's static members once
// for each: `From[IoError]` and `From[ParseError]` need a `from` taking each. The method tables hold
// one implementation per member, so each conformance is checked here against the members it names.
private check_several_conformances(c: *Checker)
    for k in 0..<c.classes.len()
        if is_trait(c, k) then continue
        val self_type = own_class_type(c.classes[k], k)
        for t in c.classes[k].traits
            check_conformance_members(c, self_type, t, c.classes[k].unit, c.classes[k].decl.name_span)
    for block in c.impls
        if *block.target is Class(_, _, _) || *block.target is ErrorType then continue
        val t = block.trait_type match
            Some(t) -> t
            None -> continue
        check_conformance_members(c, block.target, t, block.unit, written_trait_span(block.decl))

/** Whether static member `m` of `self_type` implements a member of one of the conformances in
 * `conformed` to a trait implemented at several type arguments. */
private implements_several(c: *Checker, conformed: Buf[&Type], self_type: &Type, m: usize) -> bool
    for t in conformed
        if *t is Class(tid, _, _)
            if implemented_several_times(c, tid)
                c.seen_instance = Some(t)
                var matched = false
                for tm in c.classes[tid].methods
                    if same_method(c, self_type, tm, m) then matched = true
                c.seen_instance = None
                if matched then return true
    false

private check_conformance_members(c: *Checker, self_type: &Type, t: &Type, unit: usize, at: Span)
    val tid = *t match
        Class(k, _, _) -> k
        _ -> return
    if !implemented_several_times(c, tid) then return
    c.seen_instance = Some(t)
    for tm in c.classes[tid].methods
        val name = c.symbols[tm].decl.name
        val candidates = *self_type match
            Class(k, _, _) -> methods_named(c, k, name)
            _ -> receiver_methods(c, self_type, name)
        var found: Option[usize] = None
        for m in candidates
            if found is None && m != tm && c.symbols[m].static_member && param_mismatch(c, self_type, m, tm) is None then found = Some(m)
        found match
            Some(m) ->
                if result_mismatch(c, self_type, m, tm) is Some(text) then c.note(c.symbols[m].unit, c.symbols[m].decl.name_span, s"`$name` implements `$name` of ${type_name(t)}, $text")
            None ->
                var shown = ""
                val want = c.symbols[tm].params
                for i in 1..<want.len()
                    if i > 1 then shown = shown + ", "
                    shown = shown + s"${c.symbols[tm].param_names[i]}: ${type_name(seen_from(c, self_type, tm, want[i]))}"
                c.note(unit, at, s"`${type_name(self_type)}` implements `${type_name(t)}` without `static $name($shown)`")
    c.seen_instance = None

private unpaired_equality(name: string, has_eq: bool) -> string =
    if has_eq then s"`$name` implements `equals` from `Eq` without `hash` from `Hash`; equal values must have equal hashes, so a type implementing one implements both"
    else s"`$name` implements `hash` from `Hash` without `equals` from `Eq`; equal values must have equal hashes, so a type implementing one implements both"

/** Whether `table` holds an implementation of the core trait method `m` at its position, rather than
 * the trait's own abstract method. */
private implemented_at(c: *Checker, table: Buf[Option[usize]], m: usize) -> bool
    val position = trait_slot(c, m)
    if position >= table.len() then return false
    table[position] match
        Some(x) -> x != m && !is_abstract_method(c.symbols[x]) && c.symbols[x].decl.name == c.symbols[m].decl.name
        None -> false

/** How the field that `getter` reads differs from the trait's `val` `base` it supplies for
 * `self_type`: its type is the `val`'s or, where that is a class or a trait, one conforming to it. */
private field_mismatch(c: *Checker, self_type: &Type, getter: usize, base: usize) -> Option[string]
    if result_mismatch(c, self_type, getter, base) is None then return None
    val want = seen_from(c, self_type, base, c.symbols[base].result.unwrap_or(ErrorType))
    val have = seen_from(c, self_type, getter, c.symbols[getter].result.unwrap_or(ErrorType))
    val name = c.symbols[base].decl.name
    Some(s"the field `$name` is ${type_name(have)}, but `${c.classes[c.symbols[base].owner_class.unwrap()].name}`'s `val $name`, which it supplies, is ${type_name(want)}")

/** Whether method `m` is read with field syntax: a trait's `val`, or the method a field supplies it
 * with. */
private reads_field(c: *Checker, m: usize) -> bool = is_trait_field(c, m) || contains_id(c.field_getters, m)

/** Whether method `m` is a trait's `val`. */
private is_trait_field(c: *Checker, m: usize) -> bool = contains_id(c.trait_fields, m)

private alike_or_error(a: &Type, b: &Type) -> bool = *a is ErrorType || *b is ErrorType || same_type(a, b)

/** The nearest public method named `name` of class `id` or its ancestors: what a subclass inherits. */
private inherited_method(c: *Checker, id: usize, name: string) -> Option[usize]
    var k = id
    loop
        if own_method(c, k, name) is Some(m)
            if c.symbols[m].public then return Some(m)
        val sup = c.classes[k].superclass match
            Some(t) -> t
            None -> return None
        k = *sup match
            Class(s, _, _) -> s
            _ -> return None
    None

/** The nearest public method of class `id` or its ancestors that is the same method as `m`, as
 * `self_type` sees both: the one `m` overrides. */
private inherited_matching(c: *Checker, id: usize, self_type: &Type, m: usize) -> Option[usize]
    var k = id
    loop
        if own_matching(c, k, self_type, m) is Some(found)
            if c.symbols[found].public then return Some(found)
        val sup = c.classes[k].superclass match
            Some(t) -> t
            None -> return None
        k = *sup match
            Class(s, _, _) -> s
            _ -> return None
    None

/** `n` and a noun, plural unless `n` is one: "1 field", "2 fields". */
private count(n: usize, noun: string) -> string = if n == 1 then s"1 $noun" else s"$n ${noun}s"

private contains_name(names: Buf[string], name: string) -> bool
    for n in names
        if n == name then return true
    false

// `owner` and `type_params` are the type parameters in scope in the signature: a function's own, or
// for a method its class's and its own. `receiver` is the type an impl adds the method to, which an
// intrinsic's declared type takes as its first parameter.
private signature(c: *Checker, unit: usize, module_name: string, f: &Function, owner: usize, type_params: Buf[TypeParam], bodyless: bool, receiver: Option[&Type]) -> FunctionSymbol
    var params: Buf[&Type] = buf()
    var names: Buf[string] = buf()
    // A generic function's own type parameters are in scope in its signature.
    val outer_generic = c.generic
    if type_params.len() > 0 then c.generic = Some(GenericScope(owner, type_params))
    // The function's own type parameters follow those of its class or impl, if it has any.
    if type_params.len() >= f.type_params.len()
        declare_bounds(c, unit, owner, type_params, type_params.len() - f.type_params.len(), type_params.len() - f.type_params.len())
    for tp in f.type_params
        if !(tp.variance is Invariant) then c.note(unit, tp.span, "variance is written on the parameters of a type, not of a function")
    for p in f.params
        p.pattern.kind match
            Name(n) -> names.push(n)
            Wildcard -> names.push("_")
            _ ->
                c.note(unit, p.pattern.span, "parameter patterns are not implemented")
                names.push("_")
        if p.by_name && f.clauses.len() > 0
            c.note(unit, p.pattern.span, s"`${f.name}` is defined by clauses, which match its arguments, so its parameters cannot be by-name")
        val written = resolve_type(c, unit, p.ty)
        val ty = if p.variadic then vector_of(c, written) else written
        if p.by_name && f.clauses.len() == 0 then params.push(ByName(ty)) else params.push(ty)
    var result: Option[&Type] = None
    if f.result is Some(r) then result = Some(resolve_type(c, unit, r))
    elif f.body is None && f.clauses.len() == 0 then result = Some(Unit)
    elif f.body is Some(b)
        if b.kind is Block(_, true) then result = Some(Unit)
    val intrinsic = intrinsic_of(c, unit, f)
    val binding = has_annotation(f, "sysl")
    if binding then check_binding(c, unit, f, params, result, intrinsic is Some(_))
    if intrinsic is Some(name)
        // The array operations are generic in the element type, and only the core library's
        // `Array` declares them.
        if name.starts_with("array_")
            if module_name != CoreModule then c.note(unit, f.name_span, s"`$name` is an intrinsic of the core library's arrays")
        // The atomic operations are generic in the value held, and only `avin.threads.Atomic`
        // declares them, as methods on the value that is its first field.
        elif is_atomic_intrinsic(name)
            if module_name != "avin.threads" then c.note(unit, f.name_span, s"`$name` is an intrinsic of `avin.threads.Atomic`")
        else
            intrinsic_signature(name) match
                Some(expected) ->
                    var with_receiver: Buf[&Type] = buf()
                    if receiver is Some(r) then with_receiver.push(r)
                    for p in params
                        with_receiver.push(p)
                    val declared: &Type = Function(with_receiver, result.unwrap_or(Unit))
                    if !same_type(declared, expected)
                        c.note(unit, f.name_span, s"intrinsic `$name` has type ${type_name(expected)}, not ${type_name(declared)}")
                None -> c.note(unit, f.name_span, s"`$name` is not an intrinsic")
    elif f.body is None && f.clauses.len() == 0 && !bodyless && !binding
        c.note(unit, f.name_span, s"`${f.name}` needs a body, or clauses on the lines after it")
    c.generic = outer_generic
    FunctionSymbol(unit, module_name, f.name, f, params, names, result, intrinsic, None, buf(), buf(), buf(), false, false, false, buf(), None, owner, type_params, None, false, true, "", None, false)

// Each default argument becomes a function of its own, declared beside the function whose parameter
// it belongs to: it takes the parameters before that one, so the default may use them, and yields
// the default. It is checked in the declaring function's scope, never the caller's, and a call that
// omits the argument calls it. A generic function's defaults are generic over the same parameters.
// The default of a by-name parameter is its delayed expression: the function yields it unevaluated.
//
// A method's default takes the receiver first, then the parameters before its own, and is checked as
// the method's body is: `self` and the members of the receiver's type are in scope. A constructor's
// default takes the parameters before its own; no object exists yet, so it has no `self`. The
// defaults of both share their type parameters with the class, or the impl, they belong to.
private declare_defaults(c: *Checker, id: usize)
    val f = c.symbols[id]
    val first = if is_method(f) then 1usize else 0usize
    val shared = f.owner_class is Some(_) || f.receiver is Some(_) || (f.root is Some(_) && f.decl.type_params.len() > 0)
    var defaults: Buf[Option[usize]] = buf()
    for _ in 0..<first
        defaults.push(None)
    for i in first..<f.params.len()
        val p = f.decl.params[i - first]
        if p.default is None || p.variadic
            defaults.push(None)
            continue
        val value = p.default.unwrap()
        val did = c.symbols.len()
        var own: Buf[&Type] = buf()
        for k in 0..<f.decl.type_params.len()
            own.push(TypeVar(did, k, f.decl.type_params[k].name))
        var params: Buf[&Type] = buf()
        var names: Buf[string] = buf()
        var decls: Buf[Param] = buf()
        for k in 0..<i
            params.push(if shared then f.params[k] else substitute(f.params[k], id, own))
            names.push(f.param_names[k])
            if k >= first then decls.push(f.decl.params[k - first])
        val result = if shared then f.params[i] else substitute(f.params[i], id, own)
        val name = s"${f.name}/${f.param_names[i]}"
        val decl = Function(buf(), value.span, p.span, name, f.decl.type_params, decls, None, Some(value), buf())
        val type_owner = if shared then f.type_owner else did
        val type_params = if shared then f.type_params else f.decl.type_params
        val owner_class = if f.constructor then None else f.owner_class
        c.symbols.push(FunctionSymbol(f.unit, f.module_name, name, decl, params, names, Some(result), None, f.root, buf(), buf(), buf(), false, false, false, buf(), Some(f.param_names[i]), type_owner, type_params, owner_class, false, true, "", f.receiver, f.static_member))
        c.states.push(0)
        c.bodies.push(None)
        c.locals.push(buf())
        defaults.push(Some(did))
    c.symbols[id].defaults = defaults

// `@intrinsic("name")` and `@sysl("path")` are the annotations this compiler gives meaning to on a
// function without a body, and `@test` and the test hooks the ones it gives meaning to on a function
// with one. This reads the first; `sysl_binding_of` the second; `check_tests` and `check_hooks` the
// rest.
private intrinsic_of(c: *Checker, unit: usize, f: &Function) -> Option[string]
    var out: Option[string] = None
    for a in f.annotations
        if a.name == "sysl" || a.name == "test" || is_hook_annotation(a.name) then continue
        if a.name == "should_trap" || a.name == "timeout" || a.name == "ignore"
            val example = if a.name == "should_trap" then "should_trap" elif a.name == "timeout" then "timeout: 30" else "ignore: \"why\""
            c.note(unit, a.span, s"`${a.name}` is said of a test, as an argument of `@test`: `@test($example)`")
            continue
        if a.name != "intrinsic"
            c.note(unit, a.span, s"unknown annotation `@${a.name}`")
            continue
        if a.args.len() != 1 || a.args[0].name is Some(_)
            c.note(unit, a.span, "`@intrinsic` takes one string, the intrinsic's name")
            continue
        a.args[0].value.kind match
            StringLit(name) -> out = Some(name)
            _ -> c.note(unit, a.span, "`@intrinsic` takes one string, the intrinsic's name")
        if f.body is Some(_) then c.note(unit, a.span, "an intrinsic function has no body")
    out

/** Whether `name` is one of the operations of `avin.threads.Atomic`. */
is_atomic_intrinsic(name: string) -> bool =
    name == "atomic_load" || name == "atomic_store" || name == "atomic_swap" || name == "atomic_compare_set" || name == "atomic_by_value"

/** The intrinsics the compiler implements, with the type each must be declared with. A method's
 * type takes its receiver first. */
intrinsic_signature(name: string) -> Option[&Type]
    if name.starts_with("string_") then return string_intrinsic(name)
    // A trap with a literal reason, which lowering makes a trap site at each call.
    if name == "trap"
        var reason: Buf[&Type] = buf()
        reason.push(Str)
        return Some(Function(reason, Nothing))
    val found = intrinsic_entry(name)?
    Some(Function(found.1, found.2))

/** The runtime entry point an intrinsic calls, with its parameters and result. Each intrinsic is a
 * call of one entry point, which takes the thread's context first and then the intrinsic's own
 * arguments. */
intrinsic_entry(name: string) -> Option[(string, Buf[&Type], &Type)]
    var params: Buf[&Type] = buf()
    var result: &Type = Unit
    var entry = ""
    if name == "print_line"
        entry = "avin_rt_print_line"
        params.push(Str)
    elif name == "write_out"
        entry = "avin_rt_write_out"
        params.push(Str)
    elif name == "write_err"
        entry = "avin_rt_write_err"
        params.push(Str)
    elif name == "input_ended"
        entry = "avin_rt_input_ended"
        result = Bool
    elif name == "read_line"
        entry = "avin_rt_read_line"
        result = Str
    elif name == "read_rest"
        entry = "avin_rt_read_rest"
        result = Str
    elif name == "write_int"
        entry = "avin_rt_write_int"
        params.push(Int(64))
    elif name == "render_int"
        entry = "avin_rt_render_int"
        params.push(Int(64))
        result = Str
    elif name == "render_real"
        entry = "avin_rt_render_real"
        params.push(Real)
        result = Str
    elif name == "format_real"
        entry = "avin_rt_format_real"
        params.push(Real)
        params.push(Char)
        params.push(Int(32))
        params.push(Int(32))
        params.push(Int(32))
        result = Str
    elif name == "render_char"
        entry = "avin_rt_render_char"
        params.push(Char)
        result = Str
    elif name == "text_size"
        entry = "avin_rt_text_size"
        params.push(Str)
        result = Int(64)
    elif name == "text_width"
        entry = "avin_rt_text_width"
        params.push(Str)
        result = Int(64)
    elif name == "text_append"
        entry = "avin_rt_text_append"
        params.push(Str)
        params.push(Int(64))
        params.push(Str)
        result = Str
    elif name == "text_take"
        entry = "avin_rt_text_take"
        params.push(Str)
        params.push(Int(64))
        result = Str
    elif name == "quote_text"
        entry = "avin_rt_quote_text"
        params.push(Str)
        result = Str
    elif name == "quote_char"
        entry = "avin_rt_quote_char"
        params.push(Char)
        result = Str
    elif name == "argument_count"
        entry = "avin_rt_argument_count"
        result = Int(32)
    elif name == "argument"
        entry = "avin_rt_argument"
        params.push(Int(32))
        result = Str
    elif name == "exit"
        entry = "avin_rt_exit"
        params.push(Int(32))
        result = Nothing
    elif name == "thread_start"
        // The closure a new thread runs and the size of its stack, for the object it is joined by.
        entry = "avin_rt_thread_start"
        var none: Buf[&Type] = buf()
        params.push(Function(none, Unit))
        params.push(Int(64))
        result = AnyType
    elif name == "thread_join"
        entry = "avin_rt_thread_join"
        params.push(AnyType)
    elif name == "thread_current"
        entry = "avin_rt_thread_current"
        result = Int(64)
    // A sleeping lock and a condition variable, each an opaque object on the collected heap.
    elif name == "lock_new"
        entry = "avin_rt_lock_new"
        result = AnyType
    elif name == "lock_acquire"
        entry = "avin_rt_lock_acquire"
        params.push(AnyType)
    elif name == "lock_release"
        entry = "avin_rt_lock_release"
        params.push(AnyType)
    elif name == "condition_new"
        entry = "avin_rt_condition_new"
        result = AnyType
    elif name == "condition_wait"
        // The condition, and the lock its waiter holds.
        entry = "avin_rt_condition_wait"
        params.push(AnyType)
        params.push(AnyType)
    elif name == "condition_wait_for"
        // The condition, the lock its waiter holds, and the most milliseconds to wait; whether a
        // notification came before the time ran out.
        entry = "avin_rt_condition_wait_for"
        params.push(AnyType)
        params.push(AnyType)
        params.push(Int(64))
        result = Bool
    elif name == "condition_notify"
        entry = "avin_rt_condition_notify"
        params.push(AnyType)
    elif name == "condition_notify_all"
        entry = "avin_rt_condition_notify_all"
        params.push(AnyType)
    else return None
    Some((entry, params, result))

// The string operations, which lowering expands in place. Each takes a string first, then these.
private string_intrinsic(name: string) -> Option[&Type]
    var params: Buf[&Type] = buf()
    params.push(Str)
    if name == "string_byte_length" then return Some(Function(params, Int(32)))
    if name == "string_byte_at"
        params.push(Int(32))
        return Some(Function(params, Byte))
    if name == "string_slice"
        params.push(Int(32))
        params.push(Int(32))
        return Some(Function(params, Str))
    if name == "string_find"
        params.push(Str)
        params.push(Int(32))
        return Some(Function(params, Int(32)))
    if name == "string_parse_real" then return Some(Function(params, Real))
    if name == "string_repeat"
        params.push(Int(32))
        return Some(Function(params, Str))
    None

// The bounds of the type parameter at `index` of `owner` are recorded under this key: the
// parameter's declaration tells apart a type's own parameters and those of each impl of it, which
// share an owner and positions.
private bound_key(owner: usize, index: usize, tp: TypeParam) -> string = s"$owner/$index/${tp.site}"

// Resolves the bounds of `params` from position `from` on, in the scope that declares them, and
// records them. A bound is a trait or a class. It may name the parameters, and a trait that
// mentions `Self`, which is a bound and never a type. A lower bound is any type; only a function's
// or a method's own parameters, from position `own` on, have one.
private declare_bounds(c: *Checker, unit: usize, owner: usize, params: Buf[TypeParam], from: usize, own: usize)
    for i in from..<params.len()
        val tp = params[i]
        if tp.lower is Some(l)
            if i < own then c.note(unit, l.span, s"a lower bound is written on a function's or a method's own type parameter, not on `${tp.name}`")
            else
                val t = resolve_type(c, unit, l)
                if lower_cycle(c, owner, params, i, t) then c.note(unit, l.span, s"the lower bound of `${tp.name}` leads back to `${tp.name}`")
                elif !(*t is ErrorType) then c.lowers.put(bound_key(owner, i, tp), t)
        if tp.bounds.len() == 0 then continue
        var bounds: Buf[&Type] = buf()
        for b in tp.bounds
            val t = resolve_bound(c, unit, b)
            *t match
                Class(k, _, _) ->
                    if c.classes[k].decl.object then c.note(unit, b.span, s"`${type_name(t)}` is an object, which has one value; a bound is a trait or a class")
                    elif is_class_named(c, k, qualified(CoreModule, "Shaped")) && !c.declaring_template
                        c.note(unit, b.span, "`Shaped` is the bound a derive template's type has, and no other: a template, `derive Trait for T`, reads a type's shape")
                    else bounds.push(t)
                ErrorType -> ()
                _ -> c.note(unit, b.span, s"a bound is a trait or a class, not ${type_name(t)}")
        c.bounds.put(bound_key(owner, i, tp), bounds)

// Whether `t`, given as the lower bound of parameter `i` of `owner`, is that parameter, or another of
// the same declaration whose lower bounds lead back to it.
private lower_cycle(c: *Checker, owner: usize, params: Buf[TypeParam], i: usize, t: &Type) -> bool
    var current = t
    for _ in 0..<params.len() + 1
        val j = *current match
            TypeVar(o, j, _) -> if o == owner && j < params.len() then j else return false
            _ -> return false
        if j == i then return true
        current = c.lowers.get(bound_key(owner, j, params[j])) match
            Some(next) -> next
            None -> return false
    false

/** A type written as a bound, or as the trait of an impl: a trait that mentions `Self` may be named. */
private resolve_bound(c: *Checker, unit: usize, t: &TypeExpr) -> &Type
    val saved = c.bound_context
    c.bound_context = true
    val resolved = resolve_type(c, unit, t)
    c.bound_context = saved
    resolved

// The bounds of type parameter `index` of `owner`, where `params` are the parameters in scope. A
// class's or data type's own parameters are bounded where the type declares them, so they have those
// bounds wherever they are named, its methods and impls included. A trait's `Self` is bounded by the
// trait.
private bounds_at(c: *Checker, owner: usize, params: Buf[TypeParam], index: usize) -> Buf[&Type] = scope_bounds(conformances(c), owner, params, index)

private scope_bounds(f: Conformances, owner: usize, params: Buf[TypeParam], index: usize) -> Buf[&Type]
    if is_self_owner(owner)
        val k = owner - self_owner(0)
        var own: Buf[&Type] = buf()
        own.push(own_class_type(f.classes[k], k))
        return own
    // The integer family's parameter is bounded by `Integer`, wherever it is named.
    if owner == integer_owner() && index == 0
        var family: Buf[&Type] = buf()
        if f.core.trait_named("Integer") is Some(k) then family.push(own_class_type(f.classes[k], k))
        return family
    if owner >= method_params_owner() then return buf()
    var declared = params
    if owner >= class_owner(0)
        val k = owner - class_owner(0)
        if k < f.classes.len() && index < f.classes[k].decl.type_params.len() then declared = f.classes[k].decl.type_params
    elif owner >= data_owner(0)
        val d = owner - data_owner(0)
        if d < f.data.len() && index < f.data[d].decl.type_params.len() then declared = f.data[d].decl.type_params
    if index >= declared.len() then return buf()
    var out: Buf[&Type] = buf()
    if f.bounds.get(bound_key(owner, index, declared[index])) is Some(own)
        for b in own
            out.push(b)
    // Inside an impl with bounds of its own, its parameters have those bounds too.
    if index < params.len() && params[index].site != declared[index].site
        if f.bounds.get(bound_key(owner, index, params[index])) is Some(extra)
            for b in extra
                out.push(b)
    out

/** The bounds of type parameter `t` as the code being checked names it. */
bounds_of(c: *Checker, t: &Type) -> Buf[&Type] = type_var_bounds(conformances(c), t)

private type_var_bounds(f: Conformances, t: &Type) -> Buf[&Type]
    var params: Buf[TypeParam] = buf()
    *t match
        TypeVar(owner, index, _) ->
            if f.generic is Some(scope)
                if scope.owner == owner then params = scope.params
            scope_bounds(f, owner, params, index)
        _ -> buf()

/** The lower bound of type parameter `t` as the code being checked names it, if it has one. */
private type_var_lower(f: Conformances, t: &Type) -> Option[&Type]
    val (owner, index) = *t match
        TypeVar(o, i, _) -> (o, i)
        _ -> return None
    val scope = f.generic?
    if scope.owner != owner || index >= scope.params.len() then return None
    f.lowers.get(bound_key(owner, index, scope.params[index]))

/** The lower bound of type parameter `index` of `owner`, where `params` are the parameters in scope. */
private lower_at(c: *Checker, owner: usize, params: Buf[TypeParam], index: usize) -> Option[&Type]
    if index >= params.len() then return None
    c.lowers.get(bound_key(owner, index, params[index]))

/** Whether a type parameter in scope has a lower bound, so values of the scope's type parameters may
 * be seen as one another's. */
private scope_has_lowers(c: *Checker) -> bool
    val scope = c.generic match
        Some(s) -> s
        None -> return false
    for i in 0..<scope.params.len()
        if c.lowers.get(bound_key(scope.owner, i, scope.params[i])) is Some(_) then return true
    false

// Whether a value of type `x` is one of type parameter `to` through `to`'s lower bound, with no
// conversion: `x` is the bound, or is seen as it as a covariant part is.
private below_lower(f: Conformances, x: &Type, to: &Type) -> bool = type_var_lower(f, to) match
    Some(l) -> conforms(x, l) || conforms(view_part(f, x, l), l)
    None -> false

/** What deciding a conformance reads: the types, the conformances their impls state, and the bounds
 * of the type parameters in scope where the question is asked. Lowering asks only of concrete types,
 * so it gives no scope. */
struct Conformances
    classes: Buf[ClassSymbol]
    data: Buf[DataSymbol]
    builtins: Buf[BuiltinConformance]
    conditional: Buf[ConditionalConformance]
    core: CoreTraits
    bounds: Map[string, Buf[&Type]]
    generic: Option[GenericScope]
    lowers: Map[string, &Type]

/** The conformances as the code being checked sees them. */
private conformances(c: *Checker) -> Conformances = Conformances(c.classes, c.data, c.builtins, c.conditional, c.core, c.bounds, c.generic, c.lowers)

/** Whether a value of type `t` conforms to `bound`, a trait or a class: a type parameter does through
 * its own bounds. */
private conforms_to_bound(c: *Checker, t: &Type, bound: &Type) -> bool = meets_bound(conformances(c), zonk(c, t), zonk(c, bound))

/** Whether a value of type `x` conforms to `bound`, a trait or a class, where both are solved: a
 * type parameter through its bounds, a built-in type through its impls, and a class or data type
 * through the conformances that hold at its type arguments. Every type compares and hashes. */
meets_bound(f: Conformances, x: &Type, bound: &Type) -> bool
    val k = *bound match
        Class(k, _, _) -> k
        _ -> return true
    // Every type compares and hashes, a type parameter without a bound too.
    if names_core_trait(f.core, k, "Eq") || names_core_trait(f.core, k, "Hash") then return true
    if rendered_at_run_time(f.classes, x) && names_rendering_trait(f.core, k) then return true
    *x match
        ErrorType -> true
        Nothing -> true
        Var(_) -> true
        TypeVar(_, _, _) ->
            for b in type_var_bounds(f, x)
                if holding_ancestor(f, b, k) is Some(up)
                    if conforms(up, bound) then return true
            false
        _ ->
            if names_core_trait(f.core, k, "Eq") || names_core_trait(f.core, k, "Hash") then return true
            if is_builtin(x) || *x is Tuple(_)
                // Every integer is a member of `Integer`, and has what it requires.
                if *x is Int(_)
                    if f.core.trait_named("Integer") is Some(integer)
                        if ancestor_type(f.classes, f.data, own_class_type(f.classes[integer], integer), k) is Some(up)
                            if conforms(up, bound) then return true
                for b in f.builtins
                    if builtin_covers(b.ty, x) && tuple_parts_hold(f, b.owner, b.params, x)
                        if ancestor_type(f.classes, f.data, b.trait_type, k) is Some(up)
                            if conforms(up, bound) then return true
                return false
            for up in holding_ancestors(f, x, k)
                if conforms(up, bound) then return true
            false

private names_core_trait(core: CoreTraits, k: usize, name: string) -> bool = core.trait_named(name) match
    Some(t) -> t == k
    None -> false

/** Whether `k` is the core library's `Display` or `Debug`. */
names_rendering_trait(core: CoreTraits, k: usize) -> bool = names_core_trait(core, k, "Display") || names_core_trait(core, k, "Debug")

/** Whether a value of type `t` is shown by the type it has at run time: a value of `Any` or of a
 * trait. Such a value has `Display` and `Debug` whatever its static type declares, rendered by its
 * own type's implementation, or as its type's name where that type has none. */
rendered_at_run_time(classes: Buf[ClassSymbol], t: &Type) -> bool = *t match
    AnyType -> true
    Class(k, _, _) -> classes[k].decl.modifier == "trait"
    _ -> false

/** `t` as an instance of the class or trait `target`, as `ancestor_type` finds it, through only the
 * conformances that hold at `t`'s type arguments: one an impl with bounds of its own states holds
 * where the arguments meet them. */
holding_ancestor(f: Conformances, t: &Type, target: usize) -> Option[&Type]
    if *t is Data(d, _, xs)
        for required in f.data[d].traits
            if !conformance_holds(f, data_owner(d), required, xs) then continue
            if holding_ancestor(f, substitute(required, data_owner(d), xs), target) is Some(found) then return Some(found)
        return None
    val k = *t match
        Class(k, _, _) -> k
        _ -> return None
    if k == target then return Some(t)
    val args = *t match
        Class(_, _, a) -> a
        _ -> buf()
    for required in f.classes[k].traits
        if !conformance_holds(f, class_owner(k), required, args) then continue
        if holding_ancestor(f, substitute(required, class_owner(k), args), target) is Some(found) then return Some(found)
    holding_ancestor(f, substitute(f.classes[k].superclass?, class_owner(k), args), target)

/** Every instance of the class or trait `target` that `t` is through the conformances holding at its
 * type arguments: one at most, except for a trait a type implements at several type arguments. */
holding_ancestors(f: Conformances, t: &Type, target: usize) -> Buf[&Type]
    var out: Buf[&Type] = buf()
    collect_ancestors(f, t, target, &out, 0)
    out

private collect_ancestors(f: Conformances, t: &Type, target: usize, out: *Buf[&Type], depth: usize)
    if depth > f.classes.len() then return
    if *t is Data(d, _, xs)
        for required in f.data[d].traits
            if conformance_holds(f, data_owner(d), required, xs) then collect_ancestors(f, substitute(required, data_owner(d), xs), target, out, depth + 1)
        return
    val k = *t match
        Class(k, _, _) -> k
        _ -> return
    if k == target
        for i in 0..<out.len()
            if same_type(out[i], t) then return
        out.push(t)
        return
    val args = *t match
        Class(_, _, a) -> a
        _ -> buf()
    for required in f.classes[k].traits
        if conformance_holds(f, class_owner(k), required, args) then collect_ancestors(f, substitute(required, class_owner(k), args), target, out, depth + 1)
    if f.classes[k].superclass is Some(sup) then collect_ancestors(f, substitute(sup, class_owner(k), args), target, out, depth + 1)

/** Whether the type whose parameters `owner` owns, at type arguments `args`, has the conformance to
 * `required` its declaration or an impl states: at once, unless an impl with bounds of its own
 * states it and `args` miss them. */
conformance_holds(f: Conformances, owner: usize, required: &Type, args: Buf[&Type]) -> bool
    val id = *required match
        Class(id, _, _) -> id
        _ -> return true
    for x in f.conditional
        if x.owner == owner && x.trait_id == id then return conditions_met(f, x, args)
    true

/** Whether type arguments `args` meet the bounds of conditional conformance `x`. */
conditions_met(f: Conformances, x: ConditionalConformance, args: Buf[&Type]) -> bool = unmet_condition(f, x.owner, x.conditions, args) is None

/** The first type parameter, by position, and bound of `conditions` that type arguments `args` of the
 * type `owner` owns miss; `None` where they meet them all. */
unmet_condition(f: Conformances, owner: usize, conditions: Buf[Buf[&Type]], args: Buf[&Type]) -> Option[(usize, &Type)]
    for i in 0..<conditions.len()
        if i >= args.len() then break
        for b in conditions[i]
            if !meets_bound(f, args[i], substitute(b, owner, args)) then return Some((i, b))
    None

/** The core library's operator and equality traits and their methods, by name. */
private find_core_traits(c: *Checker)
    var traits: Map[string, usize] = map()
    var methods: Map[string, usize] = map()
    for name in ["Eq", "Hash", "Ord", "Add", "Sub", "Mul", "Div", "Rem", "Neg", "Integer", "Display", "Debug"]
        if c.class_types.get(qualified(CoreModule, name)) is Some(k)
            if is_trait(c, k)
                traits.put(name, k)
                for m in c.classes[k].methods
                    methods.put(c.symbols[m].decl.name, m)
    c.core = CoreTraits(traits, methods)

/** Whether class `k` is the core trait `name`. */
private is_core_trait(c: *Checker, k: usize, name: string) -> bool = c.core.trait_named(name) match
    Some(t) -> t == k
    None -> false

/** Whether `m` is `Eq`'s `equals` or `Hash`'s `hash`, which every type has: its own where it
 * implements the trait, and otherwise by value or by identity. */
private is_universal(c: *Checker, m: usize) -> bool = c.core.is(m, "equals") || c.core.is(m, "hash")

/** The type of the core trait `name`, when the core library declares it. */
private core_trait_type(c: *Checker, name: string) -> Option[&Type]
    val k = c.core.trait_named(name)?
    Some(own_class_type(c.classes[k], k))

// Holds each field of a type deriving a trait to the trait, which the derived method calls on it: a
// class's constructor parameters, a data type's variants' fields, seen with the bounds the type's
// parameters have there. A field that falls short is reported by name, and the derived method is
// then left unchecked, since each of its failures would be that one again. A data type's automatic
// `Display` or `Debug` is not reported: the type is left without the trait (`withdraw_derivation`).
// Whether one failed is the result.
private check_derivation(c: *Checker, dv: Derivation) -> bool
    val k = c.class_types.get(qualified(CoreModule, dv.trait_name)) match
        Some(k) -> k
        None -> return false
    val bound = own_class_type(c.classes[k], k)
    val key = qualified(c.units[dv.unit].file.module_name, dv.type_name)
    var names: Buf[string] = buf()
    var types: Buf[&Type] = buf()
    var scope: Option[GenericScope] = None
    var data_id: Option[usize] = None
    if dv.data
        val id = c.types.get(key) match
            Some(id) -> id
            None -> return false
        data_id = Some(id)
        for block in c.impls
            if made_for(block.decl, dv)
                scope = Some(GenericScope(data_owner(id), block.decl.type_params))
        if scope is None then return false
        val d = c.data[id]
        for v in d.variants
            for i in 0..<v.fields.len()
                names.push(if d.variants.len() == 1 then v.field_names[i] else s"${v.name}.${v.field_names[i]}")
                types.push(v.fields[i])
    else
        val id = c.class_types.get(key) match
            Some(id) -> id
            None -> return false
        scope = Some(GenericScope(class_owner(id), c.classes[id].decl.type_params))
        // A generic class's derived impl bounds its parameters by the trait.
        for block in c.impls
            if made_for(block.decl, dv)
                scope = Some(GenericScope(class_owner(id), block.decl.type_params))
        for f in c.classes[id].fields
            if f.param && f.owner == id && f.ty is Some(t)
                names.push(f.name)
                types.push(t)
    val outer_generic = c.generic
    c.generic = scope
    var failed = false
    for i in 0..<types.len()
        if conforms_to_bound(c, types[i], bound) then continue
        failed = true
        val shown = type_name(zonk(c, types[i]))
        if dv.automatic
            c.underived.push(Underived(data_id.unwrap_or(0), dv.trait_name, names[i], shown))
            break
        val hint = if *types[i] is TypeVar(_, _, _) then s"; bound the parameter, as in `[$shown: ${dv.trait_name}]`" else ""
        c.note(dv.unit, dv.span, s"`${dv.type_name}` cannot derive `${dv.trait_name}`: its field `${names[i]}` has type `$shown`, which does not implement `${dv.trait_name}`$hint")
    c.generic = outer_generic
    if !failed then return false
    // The impl made from the template is left unchecked, and has nothing more to report: its every
    // failure would be the field's again.
    var made: Buf[usize] = buf()
    for x in 0..<c.derived.len()
        if !made_for(c.impls[c.derived[x].impl_index].decl, dv) then continue
        c.derived[x].notes = buf()
        for id in 0..<c.symbols.len()
            if c.derived_symbols.get(s"$id") is Some(y)
                if y == x
                    c.states.set(id, 2)
                    made.push(id)
    if dv.automatic
        if data_id is Some(id) then withdraw_derivation(c, id, k, made)
    true

/** A data type's `Display` or `Debug` that a field of it does not implement: the field's name, as a
 * variant's when the type has several, and its type as written. */
struct Underived
    data: usize
    trait_name: string
    field: string
    field_type: string

// Holds every data type's automatic `Display` and `Debug` to its fields until none changes: a type
// left without one may leave another, whose field it is, without it too. A type that holds itself
// through its own fields, a list's tail, keeps the trait.
private settle_automatic_derivations(c: *Checker)
    var done: Buf[bool] = buf()
    for _ in c.derivations do done.push(false)
    var changed = true
    while changed
        changed = false
        for i in 0..<c.derivations.len()
            if done[i] || !c.derivations[i].automatic then continue
            if check_derivation(c, c.derivations[i])
                done.set(i, true)
                changed = true

// Leaves data type `id` without trait `k` and without `made`, the methods its automatic derivation
// declared: the conformance, the trait's positions of its method table and the methods go.
private withdraw_derivation(c: *Checker, id: usize, k: usize, made: Buf[usize])
    var traits: Buf[&Type] = buf()
    for t in c.data[id].traits
        if *t is Class(x, _, _)
            if x == k then continue
        traits.push(t)
    c.data[id].traits = traits
    var table = c.data[id].table
    for j in 0..<c.classes[k].methods.len()
        if c.classes[k].base + j < table.len() then table.set(c.classes[k].base + j, None)
    c.data[id].table = table
    var methods: Buf[usize] = buf()
    var implementing: Buf[bool] = buf()
    for j in 0..<c.data[id].methods.len()
        var dropped = false
        for m in made
            if c.data[id].methods[j] == m then dropped = true
        if dropped then continue
        methods.push(c.data[id].methods[j])
        implementing.push(c.data[id].implementing[j])
    c.data[id].methods = methods
    c.data[id].implementing = implementing
    var withdrawn = c.data[id].withdrawn
    for m in made
        withdrawn.push(m)
    c.data[id].withdrawn = withdrawn
    var conditional: Buf[ConditionalConformance] = buf()
    for x in c.conditional
        if x.owner == data_owner(id) && x.trait_id == k then continue
        conditional.push(x)
    c.conditional = conditional

/** Whether impl `decl` is the one derivation `dv` made from the core library's template. */
private made_for(decl: &ImplDecl, dv: Derivation) -> bool = decl.derived match
    Some(site) -> site.unit == dv.unit && site.at.start == dv.span.start && site.at.end == dv.span.end && site.trait_text == dv.trait_name
    None -> false

// The reason a data type that has no `trait_name` lacks it, where it would have had it without asking
// but for a field: appended to a diagnostic saying `t` does not implement the trait.
private underived_reason(c: *Checker, t: &Type, trait_name: string) -> string
    val id = *t match
        Data(id, _, _) -> id
        _ -> return ""
    for u in c.underived
        if u.data == id && u.trait_name == trait_name
            return s"; `${c.data[id].name}` has no `$trait_name` because its field `${u.field}` has type `${u.field_type}`, which does not implement `$trait_name`"
    ""

// Holds type arguments written on a type to the bounds of its parameters: at once when every
// conformance is known, and otherwise once it is.
private check_type_args(c: *Checker, unit: usize, at: Span, what: string, owner: usize, params: Buf[TypeParam], args: Buf[&Type])
    if !c.conformances_known
        c.pending.push(PendingBound(unit, at, what, owner, params, args, c.generic))
        return
    hold_to_bounds(c, unit, at, what, owner, params, args, 0)

// Reports each of `args`, from position `from` on, that does not conform to a bound of its
// parameter, the bound seen with these type arguments.
private hold_to_bounds(c: *Checker, unit: usize, at: Span, what: string, owner: usize, params: Buf[TypeParam], args: Buf[&Type], from: usize)
    for i in from..<params.len()
        if i >= args.len() then break
        for b in bounds_at(c, owner, params, i)
            val bound = substitute(b, owner, args)
            if !conforms_to_bound(c, args[i], bound)
                val arg = zonk(c, args[i])
                c.note(unit, at, s"`${type_name(arg)}` does not conform to `${type_name(bound)}`, the bound of `${params[i].name}` in $what${underived_reason(c, arg, type_name(bound))}")
        if lower_at(c, owner, params, i) is Some(l)
            val lower = zonk(c, substitute(l, owner, args))
            val arg = zonk(c, args[i])
            if *arg is ErrorType || *lower is ErrorType then continue
            // One still open is held to the bound where a later use settles it, and the view is
            // read once the program is solved.
            if has_unknowns(arg) || has_unknowns(lower)
                c.views.push(TypeView(one_part(lower), one_part(arg)))
                continue
            // The generic code passes a value of the bound as one of the parameter with no
            // conversion, as a part of a tuple is.
            if conforms(lower, arg) || conforms(view_part(conformances(c), lower, arg), arg)
                if !same_type(lower, arg) then c.views.push(TypeView(one_part(lower), one_part(arg)))
            else c.note(unit, at, s"`${type_name(arg)}` is not a supertype of `${type_name(lower)}`, the lower bound of `${params[i].name}` in $what")

/** Whether each of `args` decided so far, from position `from` on, is a supertype of its parameter's
 * lower bound as `hold_to_bounds` requires; one not yet known, or whose bound is not, passes. */
private admits_lowers(c: *Checker, owner: usize, params: Buf[TypeParam], from: usize, args: Buf[&Type]) -> bool
    for i in from..<params.len()
        if i >= args.len() then break
        if lower_at(c, owner, params, i) is Some(l)
            val lower = zonk(c, substitute(l, owner, args))
            val arg = zonk(c, args[i])
            if *arg is ErrorType || *lower is ErrorType then continue
            // One still open is held to the bound where a later use settles it, and the view is
            // read once the program is solved.
            if has_unknowns(arg) || has_unknowns(lower)
                c.views.push(TypeView(one_part(lower), one_part(arg)))
                continue
            if !conforms(lower, arg) && !conforms(view_part(conformances(c), lower, arg), arg) then return false
    true

/** Whether trait `k`'s methods, or those of a trait it requires, mention `Self` other than as the
 * receiver: such a trait is only a bound. */
private mentions_self(c: *Checker, k: usize, depth: usize) -> bool
    if depth > c.classes.len() then return false
    for m in c.classes[k].decl.members
        m match
            // A static member is the implementing type's, which a value of the trait's type has none of.
            MethodMember(f, _, _, static_member) ->
                if static_member then return true
                for p in f.params
                    if names_self(p.ty) then return true
                if f.result is Some(r)
                    if names_self(r) then return true
            AbstractFieldMember(f) -> if names_self(f.declared) then return true
            _ -> ()
    for parent in c.classes[k].decl.parents
        if parent_trait(c, c.classes[k].unit, parent) is Some(t)
            if mentions_self(c, t, depth + 1) then return true
    false

private names_self(t: &TypeExpr) -> bool
    t.kind match
        Named(path, args) ->
            if path == "Self" then return true
            for a in args
                if names_self(a) then return true
        Tuple(items) ->
            for item in items
                if names_self(item) then return true
        Function(params, result) ->
            for p in params
                if names_self(p.ty) then return true
            return names_self(result)
        InvalidType -> ()
        ResolvedType(_) -> ()
    false

/** The Sysl function a binding names: the string of its `@sysl` annotation, when it has one. */
binding_target(f: &Function) -> Option[string]
    for a in f.annotations
        if a.name == "sysl" && a.args.len() >= 1 && a.args[0].name is None
            if a.args[0].value.kind is StringLit(path) then return Some(path)
    None

/** Whether a binding's `@sysl` says its Sysl function may block, with the word `blocking` after the
 * function's name: its shim marks the thread safe for the collector around the call. */
is_blocking_binding(f: &Function) -> bool
    for a in f.annotations
        if a.name != "sysl" then continue
        for arg in a.args
            if is_blocking_word(arg) then return true
    false

private is_blocking_word(arg: AnnotationArg) -> bool
    if arg.name is Some(_) then return false
    arg.value.kind match
        Name(word) -> word == "blocking"
        _ -> false

// The arguments of a function's `@sysl` after the Sysl function's name, or after none on a handle's
// method bound by its own name: `blocking`, once and alone, and nothing else.
private check_binding_flags(c: *Checker, unit: usize, a: Annotation, first: usize)
    var blocking = false
    for i in first..<a.args.len()
        val arg = a.args[i]
        if is_blocking_word(arg)
            if blocking then c.note(unit, arg.value.span, "`@sysl` takes `blocking` once")
            blocking = true
        elif arg.name is Some(k) && k == "blocking"
            c.note(unit, arg.value.span, "`blocking` is written alone, after the Sysl function's name: `@sysl(\"sysl.net.accept\", blocking)`")
        else c.note(unit, arg.value.span, "`@sysl` takes the Sysl function's module and name, and after it only `blocking`, for a call that may wait: `@sysl(\"sysl.net.accept\", blocking)`")

// A binding is a top-level function without a body whose `@sysl("module.path.name")` names a Sysl
// function, followed by `blocking` where the call may wait. Its parameters and result are boundary
// types, which the generated shim converts; a binding with a wrong type is caught when Sysl checks
// the shim.
private check_binding(c: *Checker, unit: usize, f: &Function, params: Buf[&Type], result: Option[&Type], intrinsic: bool)
    for a in f.annotations
        if a.name != "sysl" then continue
        var path: Option[string] = None
        if a.args.len() >= 1 && a.args[0].name is None
            if a.args[0].value.kind is StringLit(p) then path = Some(p)
        if path is Some(_) then check_binding_flags(c, unit, a, 1)
        path match
            Some(p) ->
                if !is_sysl_path(p) then c.note(unit, a.span, s"`@sysl` names a Sysl function by its module and name, as in `sysl.text.to_upper`; `$p` is not one")
            None -> c.note(unit, a.span, "`@sysl` takes one string, the module and name of the Sysl function, as in `@sysl(\"sysl.text.to_upper\")`")
        if intrinsic then c.note(unit, a.span, "a function is an intrinsic or a Sysl binding, not both")
        if f.body is Some(_) || f.clauses.len() > 0 then c.note(unit, a.span, "a Sysl binding has no body: the Sysl function it names is its body")
        if f.type_params.len() > 0
            c.note(unit, f.name_span, "generic Sysl bindings are not implemented")
            continue
        check_crossings(c, unit, f, params, 0, result)

// A binding's parameters, from `first` on, cross into Sysl, and its result out of Sysl.
private check_crossings(c: *Checker, unit: usize, f: &Function, params: Buf[&Type], first: usize, result: Option[&Type])
    for i in 0..<f.params.len()
        val p = f.params[i]
        val t = params[first + i]
        if p.by_name then c.note(unit, p.pattern.span, "a by-name parameter cannot cross to Sysl")
        elif holds_handle(c, t) then c.note(unit, p.ty.span, s"`${type_name(t)}` cannot cross to Sysl: a Sysl handle goes back into Sysl only as the receiver of its own methods")
        elif !crosses_to_sysl(c, t) then c.note(unit, p.ty.span, s"`${type_name(t)}` cannot cross to Sysl; ${BoundaryTypes}")
    if result is Some(r)
        if !crosses_out_of_sysl(c, r)
            val at = if f.result is Some(t) then t.span else f.name_span
            if holds_handle(c, r) then c.note(unit, at, s"`${type_name(r)}` cannot cross out of Sysl: a Sysl handle is a binding's result, the value of its `Option` or `Result`, or a part of a tuple that is one of these")
            else c.note(unit, at, s"`${type_name(r)}` cannot cross to Sysl; ${BoundaryTypes}")

const BoundaryTypes: string = "a binding's parameters and result are integers of 8, 16, 32 or 64 bits, `byte`, `real`, `char`, `bool`, `unit`, `string`, data types declared with `@sysl` to mirror a Sysl enum or struct, and `Array`, `Vector`, `Option`, `Result` and tuples of these"

/** Whether a value of type `t` crosses between Avin and Sysl, converted by a binding's shim. A Sysl
 * handle crosses only out of Sysl, as a binding's result or the payload of its `Option` or
 * `Result`, which is what `crosses_out_of_sysl` asks. */
crosses_to_sysl(c: *Checker, t: &Type) -> bool = crosses(c, t, false)

/** Whether a value of type `t` crosses out of Sysl as a binding's result. */
crosses_out_of_sysl(c: *Checker, t: &Type) -> bool = crosses(c, t, true)

private crosses(c: *Checker, t: &Type, handles: bool) -> bool = *t match
    ErrorType -> true
    Unit -> true
    Bool -> true
    Char -> true
    Real -> true
    Str -> true
    Byte -> true
    Int(bits) -> bits == 8 || bits == 16 || bits == 32 || bits == 64
    Data(id, _, args) ->
        val d = c.data[id]
        if mirror_target(d.decl) is Some(_) then return true
        if d.module_name != CoreModule then return false
        if d.name == "Option" && args.len() == 1 then return crosses(c, args[0], handles)
        d.name == "Result" && args.len() == 2 && crosses(c, args[0], handles) && crosses(c, args[1], handles)
    Class(k, _, args) ->
        if handle_target(c.classes[k].decl) is Some(_) then return handles
        (is_array_class(c.classes[k]) || is_vector_class(c.classes[k])) && args.len() == 1 && crosses_to_sysl(c, args[0])
    Tuple(items) ->
        for item in items
            if !crosses(c, item, handles) then return false
        true
    _ -> false

/** Whether `t` is a Sysl handle, or a collection, `Option`, `Result` or tuple that holds one. */
private holds_handle(c: *Checker, t: &Type) -> bool = *t match
    Tuple(items) ->
        for item in items
            if holds_handle(c, item) then return true
        false
    Data(id, _, args) ->
        if c.data[id].module_name != CoreModule then return false
        for a in args
            if holds_handle(c, a) then return true
        false
    Class(k, _, args) ->
        if handle_target(c.classes[k].decl) is Some(_) then return true
        for a in args
            if holds_handle(c, a) then return true
        false
    _ -> false

/** The Sysl type a class declared with `@sysl` is a handle on: the string of its annotation, when it
 * has one. */
handle_target(d: &ClassDecl) -> Option[string]
    if d.object then return None
    for a in d.annotations
        if a.name == "sysl" && a.args.len() == 1
            if a.args[0].value.kind is StringLit(path) then return Some(path)
    None

// A class declared with `@sysl("module.Name")` is a handle on that Sysl type: its objects are made by
// the bindings that return one and hold the Sysl value and nothing else, so the class has no
// parameters, fields or statements, no type parameters and no parents, and is final. Its methods
// without a body are bound to the Sysl type's methods.
private check_handle_declaration(c: *Checker, unit: usize, d: &ClassDecl)
    var annotated = false
    for a in d.annotations
        if a.name != "sysl" then continue
        annotated = true
        var target: Option[string] = None
        if a.args.len() == 1 && a.args[0].name is None
            if a.args[0].value.kind is StringLit(p) then target = Some(p)
        target match
            Some(p) ->
                if !is_sysl_path(p) then c.note(unit, a.span, s"`@sysl` on a class names the Sysl type it is a handle on, by its module and name, as in `sysl.checksum.Crc32`; `$p` is not one")
            None -> c.note(unit, a.span, "`@sysl` on a class takes one string, the module and name of the Sysl type it is a handle on, as in `@sysl(\"sysl.checksum.Crc32\")`")
    if !annotated then return
    if d.type_params.len() > 0 then c.note(unit, d.type_params[0].span, "a Sysl handle has no type parameters: it holds one Sysl type")
    if d.params.len() > 0 then c.note(unit, d.params[0].param.pattern.span, "a Sysl handle has no parameters: the bindings that return one make it")
    if d.modifier != "" then c.note(unit, d.modifier_span, s"a Sysl handle is final, so it cannot be `${d.modifier}`")
    if d.parents.len() > 0 then c.note(unit, d.parents[0].span, "a Sysl handle has no parents; an `impl` makes it conform to a trait")
    if d.derives.len() > 0 then c.note(unit, d.derives[0].span, "a Sysl handle derives nothing: it compares by identity, and an `impl` gives it `Display`")
    for m in d.members
        m match
            FieldMember(f) -> c.note(unit, f.span, "a Sysl handle holds its Sysl value and nothing else, so its body declares only methods")
            AbstractFieldMember(f) -> c.note(unit, f.span, "a Sysl handle holds its Sysl value and nothing else, so its body declares only methods")
            StatementMember(s) -> c.note(unit, s.span, "a Sysl handle holds its Sysl value and nothing else, so its body declares only methods")
            MethodMember(f, _, _, static_member) ->
                if f.name == "close" then c.note(unit, f.name_span, "every Sysl handle has `close()`, which gives back its Sysl value; bind the Sysl type's own `close` under another name, with `@sysl(\"close\")`")
                val bodyless = f.body is None && f.clauses.len() == 0
                if bodyless && static_member then c.note(unit, f.name_span, s"`${f.name}` is static, so it needs a body: a handle's methods without one are bound to its Sysl value's")
                for a in f.annotations
                    if a.name != "sysl"
                        c.note(unit, a.span, s"unknown annotation `@${a.name}` on a method of a Sysl handle")
                        continue
                    if !bodyless then c.note(unit, a.span, "a method with a body is not bound to Sysl, so it takes no `@sysl`")
                    var name: Option[string] = None
                    if a.args.len() >= 1 && a.args[0].name is None
                        if a.args[0].value.kind is StringLit(p) then name = Some(p)
                    // `@sysl(blocking)` binds a method that may wait to the Sysl method of its own
                    // name's words.
                    val own_name = name is None && a.args.len() >= 1 && (is_blocking_word(a.args[0]) || a.args[0].name is Some(_))
                    if name is Some(_) then check_binding_flags(c, unit, a, 1)
                    elif own_name then check_binding_flags(c, unit, a, 0)
                    name match
                        Some(p) ->
                            if !is_sysl_path("x." + p) || p.contains(".") then c.note(unit, a.span, s"`@sysl` on a handle's method names the Sysl method it is bound to, as in `@sysl(\"close\")`; `$p` is not one")
                        None ->
                            if !own_name then c.note(unit, a.span, "`@sysl` on a handle's method takes one string, the name of the Sysl method it is bound to, as in `@sysl(\"close\")`, or `blocking` alone where the method may wait")

/** The Sysl method a bound method of a handle calls: the one its `@sysl("name")` names, or the one of
 * its own name's words in snake_case. */
handle_method_name(f: &Function) -> string
    for a in f.annotations
        if a.name == "sysl" && a.args.len() >= 1 && a.args[0].name is None
            if a.args[0].value.kind is StringLit(name) then return name
    sysl_field_of(f.name)

/** Whether a method of a Sysl handle is its built-in `close()`, which gives back the handle's Sysl
 * value: the checker declares it for every handle, marked so. */
is_handle_release(f: &Function) -> bool
    for a in f.annotations
        if a.name == HandleRelease then return true
    false

// The mark of a handle's built-in `close()`. No annotation written in source has this name.
private const HandleRelease: string = "<release>"

/** The Sysl enum or struct a data type mirrors: the string of its `@sysl` annotation, when it has
 * one. */
mirror_target(d: &DataDecl) -> Option[string]
    for a in d.annotations
        if a.name == "sysl" && a.args.len() == 1
            if a.args[0].value.kind is StringLit(path) then return Some(path)
    None

// A data type declared with `@sysl("module.Name")` mirrors a Sysl enum or struct: each variant is
// the Sysl variant of its name, and its fields are the variant's payload in order, of boundary
// types. A mirror of one variant named as the type mirrors a struct, whose fields it names. Sysl
// checks the correspondence when it checks a shim that converts one.
private check_mirror(c: *Checker, id: usize)
    val d = c.data[id]
    if mirror_target(d.decl) is None || d.decl.type_params.len() > 0 then return
    val structure = d.variants.len() == 1 && d.variants[0].name == d.name
    for v in 0..<d.variants.len()
        val variant = d.variants[v]
        for k in 0..<variant.fields.len()
            val t = variant.fields[k]
            val at = d.decl.variants[v].fields[k].ty.span
            if structure && has_underscore(variant.field_names[k])
                c.note(d.unit, d.decl.variants[v].fields[k].span, s"a Sysl mirror's field is written in lowerCamelCase, and the compiler matches it to the Sysl field of the same words in snake_case: write `${camel_of_sysl(variant.field_names[k])}`, not `${variant.field_names[k]}`")
            if !crosses_to_sysl(c, t)
                c.note(d.unit, at, s"`${type_name(t)}` cannot cross to Sysl, so a Sysl mirror's field cannot be one; ${BoundaryTypes}")
            else
                var seen: Buf[usize] = buf()
                if holds_mirror(c, t, id, &seen) then c.note(d.unit, at, s"a Sysl mirror cannot hold itself: `${type_name(t)}` holds `${d.name}`")

private has_underscore(name: string) -> bool
    for b in name.bytes
        if b == u8('_') then return true
    false

/** The Sysl field a mirror's field `name` stands for: each uppercase letter becomes an underscore
 * and its lowercase, and digits stay, so `restArePositional` is `rest_are_positional` and
 * `utf8Offset` is `utf8_offset`. */
sysl_field_of(name: string) -> string
    var out = str_builder()
    for b in name.bytes
        if b >= u8('A') && b <= u8('Z')
            out.push_char('_')
            out.push_char(char(b + u8(32)))
        else
            out.push_char(char(b))
    out.finish()

// The lowerCamelCase spelling of a snake_case name: an underscore before a letter is dropped and
// the letter capitalized.
private camel_of_sysl(name: string) -> string
    var out = str_builder()
    var upper = false
    for b in name.bytes
        if b == u8('_')
            upper = true
        elif upper && b >= u8('a') && b <= u8('z')
            out.push_char(char(b - u8(32)))
            upper = false
        else
            out.push_char(char(b))
            upper = false
    out.finish()

// Whether a value of boundary type `t` holds a value of the mirror `target`, through the fields of
// the mirrors, the type arguments of the `Option` and `Result` it holds and the parts of its tuples.
private holds_mirror(c: *Checker, t: &Type, target: usize, seen: *Buf[usize]) -> bool
    var id = 0usize
    *t match
        Data(d, _, args) ->
            if d == target then return true
            for a in args
                if holds_mirror(c, a, target, seen) then return true
            id = d
        Class(_, _, args) ->
            for a in args
                if holds_mirror(c, a, target, seen) then return true
            return false
        Tuple(items) ->
            for a in items
                if holds_mirror(c, a, target, seen) then return true
            return false
        _ -> return false
    if mirror_target(c.data[id].decl) is None then return false
    for i in 0..<seen.len()
        if seen[i] == id then return false
    seen.push(id)
    for v in c.data[id].variants
        for f in v.fields
            if holds_mirror(c, f, target, seen) then return true
    false

// A module path and a name: two or more identifiers joined by dots.
private is_sysl_path(p: string) -> bool
    var parts = 0
    var start = true
    for b in p.bytes
        if b == u8('.')
            if start then return false
            start = true
            continue
        val letter = b >= u8('a') && b <= u8('z') || b >= u8('A') && b <= u8('Z') || b == u8('_')
        val digit = b >= u8('0') && b <= u8('9')
        if !letter && !(digit && !start) then return false
        if start then parts += 1
        start = false
    !start && parts >= 2

private has_annotation(f: &Function, name: string) -> bool
    for a in f.annotations
        if a.name == name then return true
    false

resolve_type(c: *Checker, unit: usize, t: &TypeExpr) -> &Type = t.kind match
    InvalidType -> ErrorType
    Named(path, args) ->
        if completing_type(c, unit, path) then return ErrorType
        // In an impl made from a template, the template's `T` is the deriving type.
        if args.len() == 0 && c.unit_override is None
            if c.derived_context is Some(x)
                if c.derived[x].site.alias == path then return c.derived[x].target
        // The type arguments of a bound are types, so only the outermost name may be a trait that
        // mentions `Self`.
        val as_bound = c.bound_context
        c.bound_context = false
        if c.generic is Some(scope)
            for i in 0..<scope.params.len()
                if scope.params[i].name == path
                    if args.len() > 0 then c.note(unit, t.span, s"`$path` takes no type arguments")
                    index_type_param(c, unit, Span(t.span.start, t.span.start + path.bytes.len), scope.params[i])
                    return TypeVar(scope.owner, i, path)
        if path == "Self"
            if args.len() > 0 then c.note(unit, t.span, "`Self` takes no type arguments")
            if c.self_trait is Some(k) then return TypeVar(self_owner(k), 0, "Self")
            c.note(unit, t.span, "`Self` is the type implementing a trait, so it is written only in a trait's methods")
            return ErrorType
        val key = resolve_name(c, unit, path)
        if c.types.get(key) is Some(id)
            val d = c.data[id]
            var resolved: Buf[&Type] = buf()
            for a in args
                resolved.push(resolve_type(c, unit, a))
            if resolved.len() != d.decl.type_params.len()
                c.note(unit, t.span, s"`$path` takes ${count(d.decl.type_params.len(), "type argument")}, not ${resolved.len()}")
                return ErrorType
            check_type_args(c, unit, t.span, s"`$path`", data_owner(id), d.decl.type_params, resolved)
            index_data(c, unit, Span(t.span.start, t.span.start + path.bytes.len), id)
            return Data(id, d.name, resolved)
        if c.class_types.get(key) is Some(id)
            val k = c.classes[id]
            var resolved: Buf[&Type] = buf()
            for a in args
                resolved.push(resolve_type(c, unit, a))
            if resolved.len() != k.decl.type_params.len()
                c.note(unit, t.span, s"`$path` takes ${count(k.decl.type_params.len(), "type argument")}, not ${resolved.len()}")
                return ErrorType
            if !as_bound && is_trait(c, id) && mentions_self(c, id, 0)
                c.note(unit, t.span, s"`$path` mentions `Self`, so it is a bound, as in `[T: $path]`, and not a type")
                return ErrorType
            check_type_args(c, unit, t.span, s"`$path`", class_owner(id), k.decl.type_params, resolved)
            index_class(c, unit, Span(t.span.start, t.span.start + path.bytes.len), id)
            return Class(id, k.name, resolved)
        builtin_type(path) match
            Some(ty) ->
                if args.len() > 0
                    c.note(unit, t.span, s"`$path` takes no type arguments")
                    return ErrorType
                ty
            None ->
                if path == "Nothing" && args.len() == 0 then return Nothing
                c.variants.get(key) match
                    Some(v) -> c.note(unit, t.span, s"`$path` is a variant of `${c.data[v.data].name}`, not a type")
                    None -> c.note(unit, t.span, unknown_type_message(c, unit, path))
                ErrorType
    Tuple(items) ->
        var types: Buf[&Type] = buf()
        for item in items
            types.push(resolve_type(c, unit, item))
        Tuple(types)
    Function(params, result) ->
        var types: Buf[&Type] = buf()
        for p in params
            val ty = resolve_type(c, unit, p.ty)
            if p.by_name then types.push(ByName(ty)) else types.push(ty)
        Function(types, resolve_type(c, unit, result))
    ResolvedType(slot) -> c.type_slots[slot]

// What is said of a type name that names no type. Written through a module the file imports whole,
// `m.X`, it names what the module lacks: a declaration `X`, or a public one.
private unknown_type_message(c: *Checker, unit: usize, path: string) -> string
    var dot: Option[usize] = None
    for k in 0..<path.bytes.len
        if dot is None && path.bytes[k] == u8('.') then dot = Some(k)
    if dot is Some(k)
        if c.files[unit].modules.get(path[0..<k]) is Some(module_path)
            val name = path[k + 1..]
            val key = qualified(module_path, name)
            if !declared(c, key) then return s"module `$module_path` declares no type `$name`"
            if !exported(c, key) then return s"`$name` is private to module `$module_path`"
    s"unknown type `$path`"

private check_function(c: *Checker, id: usize)
    if c.states[id] != 0 then return
    c.states.set(id, 1)
    val symbol = c.symbols[id]
    if symbol.decl.body is Some(_) || symbol.decl.clauses.len() > 0 || symbol.constructor
        val previous = c.current
        val outer = c.body
        c.current = id
        c.body = fresh_body(id)
        val outer_generic = c.generic
        c.generic = if symbol.type_params.len() > 0 then Some(GenericScope(symbol.type_owner, symbol.type_params)) else None
        val outer_trait = c.self_trait
        c.self_trait = None
        if symbol.owner_class is Some(k)
            if is_trait(c, k) then c.self_trait = Some(k)
        val outer_derived = c.derived_context
        val outer_unit = c.unit_override
        c.derived_context = c.derived_symbols.get(s"${symbol.root.unwrap_or(id)}")
        c.unit_override = None
        var subjects: Buf[&TExpr] = buf()
        for i in 0..<symbol.params.len()
            subjects.push(TExpr(symbol.decl.name_span, symbol.params[i], Param(i)))
        val mark = c.unknowns.len()
        if symbol.constructor then check_constructor(c, id, None)
        else check_definition(c, id, subjects)
        // The body is over, so what its uses did not settle cannot be inferred.
        settle_unknowns(c, mark)
        c.derived_context = outer_derived
        c.unit_override = outer_unit
        c.generic = outer_generic
        c.self_trait = outer_trait
        finish_captures(c)
        c.locals.set(id, c.body.locals)
        for f in local_functions_of(c, id)
            c.locals.set(f, c.body.locals)
        c.current = previous
        c.body = outer
    c.states.set(id, 2)

// Checks class `k`'s body as far as its field `index`, in the middle of checking some other
// function: the body is its initializer's, with that function's state set aside meanwhile.
private check_class_body_upto(c: *Checker, k: usize, index: usize)
    val id = c.classes[k].initializer
    val symbol = c.symbols[id]
    val previous = c.current
    val outer = c.body
    val outer_generic = c.generic
    val outer_binds = c.binds_var
    val outer_super = c.super_args
    c.current = id
    c.body = fresh_body(id)
    c.generic = if symbol.type_params.len() > 0 then Some(GenericScope(symbol.type_owner, symbol.type_params)) else None
    c.binds_var = false
    c.super_args = false
    c.states.set(id, 1)
    check_constructor(c, id, Some(index))
    c.states.set(id, 0)
    c.current = previous
    c.body = outer
    c.generic = outer_generic
    c.binds_var = outer_binds
    c.super_args = outer_super

// Checks a function's body or clauses; `subjects` are its parameters' values, which its clauses
// match.
private check_definition(c: *Checker, id: usize, subjects: Buf[&TExpr])
    val decl = c.symbols[id].decl
    if decl.body is Some(body) then check_body(c, id, body, None)
    elif decl.clauses.len() > 0 then check_clauses(c, id, subjects)

// Each clause is checked like a match arm over all the parameters at once: its pattern names are
// scoped to the clause, its bodies must agree with the result, and the clauses that can always be
// taken once their patterns match must together cover every combination of arguments.
private check_clauses(c: *Checker, id: usize, subjects: Buf[&TExpr])
    val symbol = c.symbols[id]
    val decl = symbol.decl
    val unit = symbol.unit
    // A method's clauses match its arguments, not its receiver.
    val skip = if symbol.owner_class is Some(_) then 1usize else 0usize
    var params: Buf[&Type] = buf()
    var matched: Buf[&TExpr] = buf()
    for i in skip..<symbol.params.len()
        params.push(symbol.params[i])
        matched.push(subjects[i])
    var typed: Buf[TClause] = buf()
    var ty: &Type = Nothing
    var agreed = true
    for clause in decl.clauses
        if clause.patterns.len() != params.len()
            c.note(unit, clause.span, s"`${decl.name}` takes ${count(params.len(), "argument")}, but this clause matches ${clause.patterns.len()}")
            continue
        val mark = c.body.visible.len()
        val outer_start = c.body.block_start
        c.body.block_start = mark
        var patterns: Buf[&TPattern] = buf()
        for i in 0..<clause.patterns.len()
            val pattern = check_pattern(c, clause.patterns[i], params[i], "")
            // A type pattern naming the parameter's own type tests nothing: it is the signature's.
            if pattern.kind is PType(target, _, _)
                if same_type(target, params[i]) then c.note(unit, pattern.span, "a clause's arguments are patterns; their types are in the signature")
            patterns.push(pattern)
        var bodies: Buf[TGuarded] = buf()
        for b in clause.bodies
            var guard: Option[&TExpr] = None
            if b.guard is Some(g)
                val t = check_expr(c, g, Some(Bool))
                expect_bool(c, t)
                guard = Some(t)
            val body = check_expr(c, b.body, symbol.result)
            symbol.result match
                Some(declared) ->
                    if !fits(c,body.ty, declared) && !(*declared is Unit)
                        c.note(unit, b.body.span, s"${described(symbol)} yields ${type_name(body.ty)}, not ${type_name(declared)}")
                None ->
                    if agreed
                        join(c, ty, body.ty) match
                            Some(t) -> ty = t
                            None ->
                                c.note(unit, b.body.span, s"this clause yields ${type_name(body.ty)}, but the clauses before it yield ${type_name(ty)}")
                                agreed = false
            bodies.push(TGuarded(guard, body))
        c.body.visible.truncate(mark)
        c.body.block_start = outer_start
        typed.push(TClause(patterns, bodies))
    if symbol.result is None then c.symbols[id].result = Some(if agreed then ty else ErrorType)
    var settled_params = true
    for t in params
        if !settled(t) then settled_params = false
    if settled_params && typed.len() == decl.clauses.len() && !clauses_cover(typed, params, c.data)
        var blanks = ""
        for i in 0..<params.len()
            blanks = blanks + (if i == 0 then "_" else ", _")
        c.note(unit, decl.name_span, s"the clauses of `${decl.name}` do not cover every argument; add a clause for the rest, such as `${decl.name}($blanks)`")
    val result = c.symbols[id].result.unwrap_or(ErrorType)
    c.bodies.set(id, Some(TExpr(decl.span, result, Clauses(matched, typed))))

// Checks a function's body against its declared result, or infers the result from it.
// `hint` is the shape a body whose result is inferred is expected to have, such as the `Iterable[U]`
// a lambda passed to `flatMap` yields while `U` is still unknown: branches that agree on no type of
// their own are taken as that shape where both fit it.
private check_body(c: *Checker, id: usize, body: &Expr, hint: Option[&Type])
    val symbol = c.symbols[id]
    // The default of a by-name parameter is checked as an argument to it is: a delayed expression.
    if symbol.default_param is Some(_) && symbol.result is Some(r)
        if *r is ByName(inner)
            val expected: &Type = Function(buf(), inner)
            val delayed = lambda_expr(c, body, buf(), body, Some(expected), true)
            c.bodies.set(id, Some(TExpr(body.span, r, delayed.kind)))
            return
    val typed = check_expr(c, body, if symbol.result is Some(_) then symbol.result else hint)
    symbol.result match
        Some(declared) ->
            if !fits(c,typed.ty, declared) && !(*declared is Unit)
                c.note(symbol.unit, body.span, s"${described(symbol)} yields ${type_name(typed.ty)}, not ${type_name(declared)}")
        None -> c.symbols[id].result = Some(typed.ty)
    c.bodies.set(id, Some(typed))

// A constructor makes the object, runs the superclass's initializer on it, stores its parameters
// into their fields, then runs the class body top to bottom: each statement, and each field's
// initializer where the field is declared. It yields the object. `self` is a local holding the
// object, so code in the body that captures it captures it as it would any local. An open or
// abstract class does all but the allocation in its initializer, which is given the object, and its
// constructor allocates the object and calls the initializer.
//
// With `upto`, the class body is checked only until that field's type is known, and kept to be
// resumed: a function that reads an inferred field needs the code before the field, never the code
// after it, which may call that very function.
private check_constructor(c: *Checker, id: usize, upto: Option[usize])
    val symbol = c.symbols[id]
    val k = symbol.owner_class.unwrap()
    val cls = c.classes[k]
    if cls.initializer == id && c.building[k] == 2
        construct(c, k, upto)
        return
    val decl = cls.decl
    val self_type = own_class_type(cls, k)
    val self_local = c.body.locals.len()
    c.body.locals.push(TLocal("self", self_type, false, id))
    c.body.visible.push(self_local)
    val receiver = TExpr(decl.name_span, self_type, Local(self_local))
    var items: Buf[&TExpr] = buf()
    val made = TExpr(decl.name_span, self_type, New)
    if cls.initializer != id
        items.push(TExpr(decl.span, Unit, Let(self_local, made)))
        var args: Buf[&TExpr] = buf()
        args.push(receiver)
        for i in 0..<symbol.params.len()
            args.push(TExpr(decl.name_span, symbol.params[i], Param(i)))
        var type_args: Buf[&Type] = buf()
        if *self_type is Class(_, _, a) then type_args = a
        items.push(TExpr(decl.span, Unit, Call(cls.initializer, args, type_args)))
        items.push(receiver)
        c.bodies.set(id, Some(TExpr(decl.span, self_type, Block(items))))
        return
    // An initializer's object is its first parameter, and the class's parameters follow it.
    val first = if cls.constructor == id then 0usize else 1usize
    items.push(TExpr(decl.span, Unit, Let(self_local, if first == 0 then made else TExpr(decl.name_span, self_type, Param(0)))))
    c.classes[k].ready = 0
    var finishes = true
    if cls.superclass is Some(sup)
        val parent = decl.parents[0]
        val call = super_initialization(c, receiver, sup, parent)
        if *call.ty is Nothing then finishes = false
        items.push(call)
    val count_params = symbol.params.len() - first
    for i in 0..<count_params
        items.push(TExpr(decl.span, Unit, StoreField(receiver, cls.inherited + i, TExpr(decl.name_span, symbol.params[first + i], Param(first + i)), false)))
    // Then the fields of the traits the class stores, each computed by its trait's function of the
    // object, in the order the class stores them.
    var index = cls.inherited + count_params
    for m in cls.mixed
        val s = c.classes[m.trait_id].state[m.state]
        val args = *m.trait_type match
            Class(_, _, a) -> a
            _ -> buf()
        val ty = cls.fields[index].ty.unwrap_or(ErrorType)
        var call_args: Buf[&TExpr] = buf()
        call_args.push(receiver)
        val value = TExpr(decl.name_span, ty, Call(s.init, call_args, args))
        items.push(TExpr(decl.span, Unit, StoreField(receiver, index, value, false)))
        index += 1
    c.classes[k].ready = index
    c.constructions.set(k, Some(Construction(c.body, items, receiver, 0, index, finishes)))
    construct(c, k, upto)

// Checks class `k`'s body from where it stopped: to its end, or with `upto` until that field's type
// is known, keeping the rest for later.
private construct(c: *Checker, k: usize, upto: Option[usize])
    var made = c.constructions[k].unwrap()
    c.constructions.set(k, None)
    c.body = made.body
    c.building.set(k, 1)
    val decl = c.classes[k].decl
    val unit = c.classes[k].unit
    while made.member < decl.members.len()
        if upto is Some(field) && made.index > field then break
        val m = decl.members[made.member]
        made.member += 1
        m match
            FieldMember(f) ->
                // A trait's field is computed by the constructor of each class that stores it.
                if is_trait(c, k) then continue
                if f.lazy
                    lazy_field(c, k, &made, f)
                    continue
                val index = made.index
                val declared = c.classes[k].fields[index].ty
                val mark = c.unknowns.len()
                val typed = check_expr(c, f.value, declared)
                // A field's type is known where it is declared, since any function may read it.
                if declared is None then settle_unknowns(c, mark)
                declared match
                    Some(want) ->
                        if !fits(c,typed.ty, want) then c.note(unit, f.value.span, s"expected ${type_name(want)}, found ${type_name(typed.ty)}")
                    None ->
                        val inferred = zonk(c, typed.ty)
                        if has_unknowns(inferred)
                            c.note(unit, f.span, s"cannot infer the type of the field `${f.name}`; declare it, as in `val ${f.name}: int = …`")
                            c.classes[k].fields[index].ty = Some(ErrorType)
                        else c.classes[k].fields[index].ty = Some(if *inferred is Nothing then ErrorType else inferred)
                if *typed.ty is Nothing then made.finishes = false
                made.items.push(TExpr(f.span, Unit, StoreField(made.receiver, index, typed, false)))
                made.index = index + 1
                c.classes[k].ready = made.index
            StatementMember(s) ->
                val t = check_statement(c, s)
                if *t.ty is Nothing then made.finishes = false
                made.items.push(t)
            AbstractFieldMember(_) -> ()
            MethodMember(_, _, _, _) -> ()
    if upto is Some(_)
        made.body = c.body
        c.constructions.set(k, Some(made))
        c.building.set(k, 2)
        return
    c.building.set(k, 3)
    val id = c.classes[k].initializer
    var items = made.items
    if c.classes[k].constructor == id
        items.push(made.receiver)
        c.bodies.set(id, Some(TExpr(decl.span, if made.finishes then made.receiver.ty else Nothing, Block(items))))
    else
        items.push(TExpr(decl.span, Unit, UnitConst))
        c.bodies.set(id, Some(TExpr(decl.span, if made.finishes then Unit else Nothing, Block(items))))

// A `lazy val` field's initializer is checked as a lambda with no parameters, which the constructor
// stores in the field's initializer slot and the first read runs. Like any lambda in the class body it
// may read every field and call every method, since it runs only once the object is complete: a read
// of the field in the body itself is checked as a call of a method is.
private lazy_field(c: *Checker, k: usize, made: *Construction, f: FieldDecl)
    val index = made.index
    val unit = c.classes[k].unit
    val declared = c.classes[k].fields[index].ty
    val mark = c.unknowns.len()
    val typed = check_expr(c, Expr(f.value.span, Lambda(buf(), f.value)), lazy_initializer_type(declared))
    if declared is None
        settle_unknowns(c, mark)
        val result: &Type = *zonk(c, typed.ty) match
            Function(_, r) -> r
            _ -> ErrorType
        if has_unknowns(result)
            c.note(unit, f.span, s"cannot infer the type of the field `${f.name}`; declare it, as in `lazy val ${f.name}: int = …`")
            c.classes[k].fields[index].ty = Some(ErrorType)
        else c.classes[k].fields[index].ty = Some(if *result is Nothing then ErrorType else result)
    c.classes[k].fields[index + 2].ty = lazy_initializer_type(c.classes[k].fields[index].ty)
    made.items.push(TExpr(f.span, Unit, StoreField(made.receiver, index + 2, typed, false)))
    made.index = index + 3
    c.classes[k].ready = made.index

/** The type of the closure that computes a `lazy val` of type `t`, where `t` is known. */
private lazy_initializer_type(t: Option[&Type]) -> Option[&Type] = t match
    Some(x) ->
        val f: &Type = Function(buf(), x)
        Some(f)
    None -> None

// The call of the superclass's initializer on the object, with the arguments written after the
// superclass's name. They are checked before the class stores its parameters, so a parameter's name
// reads the argument passed for it, and no field of the object is ready yet.
private super_initialization(c: *Checker, receiver: &TExpr, sup: &Type, parent: &Expr) -> &TExpr
    val sid = *sup match
        Class(s, _, _) -> s
        _ -> 0usize
    val sargs = *sup match
        Class(_, _, a) -> a
        _ -> buf()
    var args: Buf[Argument] = buf()
    var name_span = parent.span
    if parent.kind is Call(callee, a)
        args = a
        name_span = callee.span
    val s = c.classes[sid]
    val constructor = c.symbols[s.constructor]
    val signature = Signature(s.name, true, constructor.type_params, class_owner(sid), constructor.params, constructor.param_names, constructor.defaults, Unit, sargs, None, declares_variadic(constructor.decl), function_sites(c, s.constructor, 0))
    val outer = c.super_args
    c.super_args = true
    val applied = apply(c, parent.span, name_span, signature, args, None, None, buf())
    c.super_args = outer
    var call_args: Buf[&TExpr] = buf()
    call_args.push(receiver)
    for a in applied.args
        call_args.push(a)
    applied.wrap(parent.span, Call(s.initializer, call_args, applied.type_args))

private local_functions_of(c: *Checker, root: usize) -> Buf[usize]
    var out: Buf[usize] = buf()
    for i in 0..<c.symbols.len()
        if c.symbols[i].root == Some(root) then out.push(i)
    out

// Gives each local function of the top-level function just checked the locals and parameters it
// captures: those it uses itself, and those used by the local functions it calls that it does not
// own. Then checks each call made before its callee's declaration: everything the callee captures
// must already be initialized there.
private finish_captures(c: *Checker)
    for u in c.body.uses
        var captured = if u.param then c.symbols[u.function].captured_params else c.symbols[u.function].captured_locals
        if !contains_index(captured, u.index)
            captured.push(u.index)
            if u.param then c.symbols[u.function].captured_params = captured else c.symbols[u.function].captured_locals = captured
    var changed = true
    while changed
        changed = false
        for call in c.body.calls
            if call.caller == c.body.root then continue
            var locals = c.symbols[call.caller].captured_locals
            for x in c.symbols[call.callee].captured_locals
                if c.body.locals[x].owner != call.caller && !contains_index(locals, x)
                    locals.push(x)
                    changed = true
            c.symbols[call.caller].captured_locals = locals
            var params = c.symbols[call.caller].captured_params
            for x in c.symbols[call.callee].captured_params
                if !contains_index(params, x)
                    params.push(x)
                    changed = true
            c.symbols[call.caller].captured_params = params
    for call in c.body.early
        val callee = c.symbols[call.callee]
        for x in callee.captured_locals
            if !contains_index(call.initialized, x)
                c.note(callee.unit, call.span, s"`${callee.name}` uses `${c.body.locals[x].name}`, which is not initialized where `${callee.name}` is used here")
                break

private contains_index(items: Buf[usize], x: usize) -> bool
    for i in items
        if i == x then return true
    false

// Declares the local functions of a block before its items are checked, so they may call one
// another in any order.
private declare_local_functions(c: *Checker, items: Buf[&Expr])
    val start = c.body.functions.len()
    for item in items
        if item.kind is LocalFunction(decl)
            val enclosing = c.symbols[c.current]
            var set: Buf[usize] = buf()
            for i in start..<c.body.functions.len()
                if c.symbols[c.body.functions[i]].name == decl.name then set.push(c.body.functions[i])
            val id = c.symbols.len()
            // A generic local function's type parameters follow those in scope where it is declared,
            // all owned by the owner of the top-level function's, so each copy of it is a copy of
            // that function's with type arguments of its own added.
            var owner = id
            var type_params: Buf[TypeParam] = buf()
            if decl.type_params.len() > 0
                owner = c.symbols[c.body.root].type_owner
                if c.generic is Some(scope)
                    owner = scope.owner
                    for tp in scope.params
                        type_params.push(tp)
                var clash = false
                for tp in decl.type_params
                    if names_type_param(type_params, tp.name)
                        c.note(unit_of(c), tp.span, s"`${tp.name}` is already a type parameter where `${decl.name}` is declared; name this one differently")
                        clash = true
                if clash then continue
                for tp in decl.type_params
                    type_params.push(tp)
            var symbol = signature(c, enclosing.unit, enclosing.module_name, decl, owner, type_params, false, None)
            symbol.root = Some(c.body.root)
            if same_as_overload(c, symbol, set)
                c.note(unit_of(c), decl.name_span, s"`${decl.name}` is declared more than once in this block with the same parameter types")
                continue
            c.symbols.push(symbol)
            c.states.push(0)
            c.bodies.push(None)
            c.locals.push(buf())
            c.body.functions.push(id)
            c.body.function_starts.push(start)
            c.body.function_marks.push(c.body.visible.len())
            declare_defaults(c, id)
            set.push(id)
            if set.len() > 1 then mark_overloads(c, set)

// The functions a name refers to: the local functions of that name in the innermost block that
// declares any, or else the top-level ones. A block's functions of a name hide every outer one of the
// same name, whatever their parameter types.
private lookup_functions(c: *Checker, name: string) -> Buf[usize]
    var found: Buf[usize] = buf()
    var i = c.body.functions.len()
    while i > 0
        i -= 1
        if c.symbols[c.body.functions[i]].name == name
            for k in c.body.function_starts[i]..<i + 1
                if c.symbols[c.body.functions[k]].name == name then found.push(c.body.functions[k])
            return found
    top_level_functions(c, unit_of(c), name)

// The top-level functions a bare name refers to in a file: those of the module it resolves to, and
// of another module only the public ones.
private top_level_functions(c: *Checker, unit: usize, name: string) -> Buf[usize]
    var found: Buf[usize] = buf()
    val key = resolve_name(c, unit, name)
    val ids = c.scope.get(key) match
        Some(ids) -> ids
        None -> return found
    if key == qualified(c.files[unit].module_name, name) then return ids
    for id in ids
        if c.symbols[id].public then found.push(id)
    found

/** The innermost function a name refers to, when it refers to any. */
private lookup_function(c: *Checker, name: string) -> Option[usize]
    val ids = lookup_functions(c, name)
    if ids.len() == 0 then None else Some(ids[0])

// `m.X` where `m` is a module the file imports whole and no local, parameter, local function or
// member of the enclosing class hides it: the declaration `X` of that module, written as the name
// `m.X`. A module without a public `X` is reported, and the use is left invalid.
private module_use(c: *Checker, e: &Expr) -> Option[&Expr]
    val unit = unit_of(c)
    if e.kind is Member(target, name)
        if target.kind is Name(m)
            if lookup_local(c, m) is Some(_) || param_index(c, m) is Some(_) || class_member(c, m) is Some(_) || local_function(c, m) is Some(_) then return None
            if c.files[unit].modules.get(m) is Some(module_path)
                val key = qualified(module_path, name)
                if !declared(c, key)
                    c.note(unit, e.span, s"module `$module_path` declares no `$name`")
                    return Some(Expr(e.span, Invalid))
                if !exported(c, key)
                    c.note(unit, e.span, s"`$name` is private to module `$module_path`")
                    return Some(Expr(e.span, Invalid))
                return Some(Expr(e.span, Name(m + "." + name)))
    None

local_function(c: *Checker, name: string) -> Option[usize]
    var i = c.body.functions.len()
    while i > 0
        i -= 1
        if c.symbols[c.body.functions[i]].name == name then return Some(c.body.functions[i])
    None

/** The class whose constructor or method the code being checked belongs to. */
enclosing_class(c: *Checker) -> Option[usize] = c.symbols[c.body.root].owner_class

/** The class whose fields a bare name reaches: the enclosing class, or the class of the receiver of
 * a method an impl adds to a type built from a class's parameters or to another module's class. */
private fields_class(c: *Checker) -> Option[usize]
    if enclosing_class(c) is Some(k) then return Some(k)
    val t = c.symbols[c.body.root].receiver?
    *t match
        Class(k, _, _) -> if is_trait(c, k) then None else Some(k)
        _ -> None

/** A member of the enclosing class named by its bare name: a field or a method. */
enum MemberRef
    FieldOf(index: usize)
    /** A field of the one variant of the data type an impl's method works on. */
    DataFieldOf(index: usize)
    MethodOf(id: usize)
    /** A `val` of a trait the enclosing trait or class conforms to, which no field of its own
     * supplies here: it is read through the method table. */
    TraitFieldOf(id: usize)

// Inside a class, its fields and methods are in scope by bare name, behind the locals, parameters
// and local functions, and ahead of top-level declarations.
class_member(c: *Checker, name: string) -> Option[MemberRef]
    val k = enclosing_class(c) match
        Some(k) -> k
        None -> return impl_member(c, name)
    if local_function(c, name) is Some(_) then return None
    // An ancestor's private member is not the subclass's to name.
    if class_field(c, k, name) is Some(i)
        if field_visible(c, c.classes[k].fields[i]) then return Some(FieldOf(i))
    if method_named(c, k, name) is Some(m)
        if method_visible(c, m) then return Some(MethodOf(m))
    if trait_field_named(c, k, name) is Some(m) then return Some(TraitFieldOf(m))
    val added = with_trait_methods(c, own_class_type(c.classes[k], k), name, buf())
    if added.len() > 0 then return Some(MethodOf(added[0]))
    None

/** The `val` named `name` of a trait that class or trait `k` conforms to or requires. */
trait_field_named(c: *Checker, k: usize, name: string) -> Option[usize]
    val m = any_method_named(c, k, name)?
    if is_trait_field(c, m) then Some(m) else None

// A read of a trait's `val` `m` on `object`, which calls what the object's method table holds for it:
// for a class or a data type with the field, a method that yields the field.
private trait_field_read(c: *Checker, at: Span, object: &TExpr, m: usize, expected: Option[&Type]) -> &TExpr = method_call(c, at, at, object, m, buf(), None, expected, false, buf())

// Inside a method an impl adds to a data type or a built-in type, the type's methods are in scope by
// bare name, as in a class, and so are the fields of a data type with one variant: whatever
// `self.name` reaches.
private impl_member(c: *Checker, name: string) -> Option[MemberRef]
    val t = c.symbols[c.body.root].receiver?
    if local_function(c, name) is Some(_) then return None
    if *t is Data(id, _, _)
        val d = c.data[id]
        if d.variants.len() == 1
            val names = d.variants[0].field_names
            for i in 0..<names.len()
                if names[i] == name then return Some(DataFieldOf(i))
    // Adding to a class built from its parameters, or to another module's class, the class's
    // visible fields and methods are in scope as in its own body.
    if fields_class(c) is Some(k)
        if class_field(c, k, name) is Some(i)
            if field_visible(c, c.classes[k].fields[i]) then return Some(FieldOf(i))
        val own = methods_named(c, k, name)
        if own.len() > 0 then return Some(MethodOf(own[0]))
    if receiver_method(c, t, name) is Some(m)
        if method_visible(c, m) then return Some(MethodOf(m))
    // Inside a method an impl adds to a trait, the receiver is a `Self`: the trait's `val`s and
    // methods are in scope, and those impls add to it.
    if is_trait_self(t)
        if bound_field(c, t, name) is Some(m) then return Some(TraitFieldOf(m))
    val added = bare_methods(c, name)
    if added.len() > 0 then return Some(MethodOf(added[0]))
    None

/** The methods of `name` a bare name reaches inside a class or an impl's method, one for each list of
 * parameter types, which a call of the name chooses among. */
private bare_methods(c: *Checker, name: string) -> Buf[usize]
    if enclosing_class(c) is Some(k) then return with_trait_methods(c, own_class_type(c.classes[k], k), name, methods_named(c, k, name))
    c.symbols[c.body.root].receiver match
        Some(t) ->
            var own = if is_trait_self(t) then bound_methods(c, t, name) else visible_methods(c, receiver_methods(c, t, name))
            if fields_class(c) is Some(k) then own = methods_named(c, k, name)
            with_trait_methods(c, t, name, own)
        None -> buf()

/** Whether receiver type `t` is the `Self` of a method an impl adds to a trait: a type parameter, but
 * not the integer family's. */
private is_trait_self(t: &Type) -> bool = *t is TypeVar(_, _, _) && !is_integer_family(t)

/** `self`, the instance the enclosing constructor or method works on. A static member works on no
 * instance, so there the receiver's members are an error. */
private self_ref(c: *Checker, at: Span) -> &TExpr
    if refuse_static_self(c, at, " and cannot use the members of a value") then return TExpr(at, ErrorType, UnitConst)
    binding_ref(c, at, "self").unwrap()

/** Whether the code being checked is a static member's, or a lambda or local function within one. */
private in_static(c: *Checker) -> bool = c.symbols[c.body.root].static_member

private refuse_static_self(c: *Checker, at: Span, what: string) -> bool
    if !in_static(c) then return false
    val name = c.symbols[c.body.root].decl.name
    c.note(unit_of(c), at, s"`$name` is static: it belongs to the type, not to a value, so it has no `self`$what")
    true

// A local function is checked where it is declared, seeing the locals declared before it. Its
// parameters become locals of its own, and loops outside it are not its loops.
private check_local_function(c: *Checker, decl: &Function) -> usize
    // The block's own local functions were declared last, so the innermost one declared here is it;
    // a duplicate was never declared and is not checked.
    var id = 0usize
    var found = false
    var i = c.body.functions.len()
    while i > 0 && !found
        i -= 1
        val span = c.symbols[c.body.functions[i]].decl.name_span
        if span.start == decl.name_span.start && span.end == decl.name_span.end
            id = c.body.functions[i]
            found = true
    if !found || c.states[id] != 0 then return id
    check_local_symbol(c, id)
    // Its defaults are checked where it is declared too, seeing what it sees.
    for d in c.symbols[id].defaults
        if d is Some(default) then check_local_symbol(c, default)
    id

private check_local_symbol(c: *Checker, id: usize)
    c.states.set(id, 1)
    val symbol = c.symbols[id]
    val decl = symbol.decl
    val previous = c.current
    val loops = c.body.loops
    val outer_start = c.body.block_start
    val mark = c.body.visible.len()
    c.current = id
    c.body.loops = buf()
    c.body.block_start = mark
    // A generic local function's own type parameters are in scope in its body, after the enclosing
    // ones it shares.
    val outer_generic = c.generic
    if decl.type_params.len() > 0 && symbol.type_params.len() > 0 then c.generic = Some(GenericScope(symbol.type_owner, symbol.type_params))
    var param_locals: Buf[usize] = buf()
    for i in 0..<symbol.params.len()
        param_locals.push(declare_local(c, decl.span, symbol.param_names[i], symbol.params[i], false))
    c.symbols[id].param_locals = param_locals
    var subjects: Buf[&TExpr] = buf()
    for i in 0..<param_locals.len()
        subjects.push(TExpr(decl.name_span, symbol.params[i], Local(param_locals[i])))
    check_definition(c, id, subjects)
    c.generic = outer_generic
    c.body.visible.truncate(mark)
    c.body.block_start = outer_start
    c.body.loops = loops
    c.current = previous
    c.states.set(id, 2)

unit_of(c: *Checker) -> usize = c.unit_override.unwrap_or(c.symbols[c.current].unit)

/** A function as diagnostics name it. */
private described(symbol: FunctionSymbol) -> string
    if symbol.delayed then return "this delayed argument"
    if symbol.lambda && symbol.param_names.len() == 1 && symbol.param_names[0].starts_with("yield guard ") then return "this guard"
    if comprehension_part(symbol) then return "this `for` with `yield`"
    if symbol.lambda then return "this lambda"
    if symbol.default_param is Some(p) then return s"the default of `$p`"
    s"`${symbol.name}`"

/** Whether `symbol` is a function a `for` with `yield` makes of a guard or of what follows a
 * generator, which `return`, `break`, `continue` and `?` cannot leave. */
private comprehension_part(symbol: FunctionSymbol) -> bool =
    symbol.lambda && symbol.param_names.len() == 1 && (symbol.param_names[0].starts_with("yield guard ") || symbol.param_names[0].starts_with("yield item "))

private comprehension_exit(word: string) -> string =
    s"`$word` cannot leave a `for` with `yield`, whose guards, value definitions and yielded value are functions passed to its sources' methods"

/** Checks an expression whose value is used. */
check_expr(c: *Checker, e: &Expr, expected: Option[&Type]) -> &TExpr = check_value(c, e, expected, true)

/** Checks an expression whose value is discarded, so the branches of an `if` need not agree. */
private check_statement(c: *Checker, e: &Expr) -> &TExpr = check_value(c, e, None, false)

// A value expected as `Any` converts to it where it is written. Only the forms that yield one of
// their parts (a block, `if`, `match`, a loop) pass `Any` on to those parts, so each converts its
// own; for any other the expected `Any` says nothing about how to check it.
private check_value(c: *Checker, e: &Expr, expected: Option[&Type], used: bool) -> &TExpr
    val want = expected match
        Some(w) -> w
        None -> return check_form(c, e, None, used)
    if !(*zonk(c, want) is AnyType) then return to_trait(c, none_as(c, check_form(c, e, expected, used), want), zonk(c, want))
    val passes = e.kind is Block(_, _) || e.kind is If(_, _, _) || e.kind is Match(_, _) || e.kind is While(_, _, _) || e.kind is Loop(_) || e.kind is DoWhile(_, _, _)
    to_any(c, check_form(c, e, if passes then expected else None, used))

/** `typed` as an `Any`: put in a box where its type needs one. An unknown type is decided as
 * `Any`. */
private to_any(c: *Checker, typed: &TExpr) -> &TExpr
    val t = zonk(c, typed.ty)
    if *t is Var(_)
        unify(c, t, AnyType)
        return typed
    if *t is AnyType || *t is Nothing || *t is ErrorType || *t is ByName(_) then return typed
    TExpr(typed.span, AnyType, Box(typed))

// An `Option[Nothing]` used where another option is expected converts to it where it is written, as
// `None` would have been written at that type: an option kept as a pointer is null for `None`, and
// one of `Nothing` is not (see `representation.sysl`). Only where the expected argument is settled,
// so that what the value would have told inference it still tells.
private none_as(c: *Checker, typed: &TExpr, want: &Type) -> &TExpr =
    if converts_none(c, typed.ty, want) then TExpr(typed.span, zonk(c, want), NoneAs(typed)) else typed

/** Whether a value of type `t` converts to `want` as `none_as` converts it. */
private converts_none(c: *Checker, t: &Type, want: &Type) -> bool
    if !nothing_option(c, t) then return false
    *zonk(c, want) match
        Data(d, _, args) ->
            if !is_option_data(c, d) || args.len() != 1 then return false
            val arg = zonk(c, args[0])
            !(*arg is Nothing || *arg is ErrorType || has_unknowns(arg))
        _ -> false

/** Whether `t` is `Option[Nothing]`, whose every value is `None`. */
private nothing_option(c: *Checker, t: &Type) -> bool = *zonk(c, t) match
    Data(d, _, args) -> is_option_data(c, d) && args.len() == 1 && *zonk(c, args[0]) is Nothing
    _ -> false

private is_option_data(c: *Checker, d: usize) -> bool = core_data(c, "Option") match
    Some(id) -> id == d
    None -> false

// A built-in value or a tuple expected as a trait it conforms to converts to it where it is written:
// it is put in a box, as for `Any`, whose method table holds the type's implementations. A data value
// and an object already are values of every trait they conform to.
private to_trait(c: *Checker, typed: &TExpr, want: &Type) -> &TExpr
    if !is_trait_type(c, want) then return typed
    val t = zonk(c, typed.ty)
    if !(is_builtin(t) || *t is Tuple(_)) then return typed
    if !conforms_to_bound(c, t, want) then return typed
    TExpr(typed.span, want, Box(typed))

/** Whether a value of type `t` converts to `want` by being boxed as a trait's value: see `to_trait`. */
private boxes_to(c: *Checker, t: &Type, want: &Type) -> bool
    val x = zonk(c, t)
    val w = zonk(c, want)
    is_trait_type(c, w) && (is_builtin(x) || *x is Tuple(_)) && conforms_to_bound(c, x, w)

private check_form(c: *Checker, e: &Expr, expected: Option[&Type], used: bool) -> &TExpr
    if completing_expr(c, e) then return TExpr(e.span, ErrorType, UnitConst)
    val t = check_kind(c, e, expected, used)
    if c.index is Some(_) then index_expr(c, e, t)
    t

private check_kind(c: *Checker, e: &Expr, expected: Option[&Type], used: bool) -> &TExpr = e.kind match
    IntLit(spelling) -> integer_literal(c, e.span, spelling, false, expected)
    Unary(op, operand) -> unary_expr(c, e, op, operand, expected)
    BoolLit(value) -> TExpr(e.span, Bool, BoolConst(value))
    CharLit(value) -> TExpr(e.span, Char, CharConst(u32(value)))
    RealLit(value) -> TExpr(e.span, Real, RealConst(value))
    StringLit(value) -> TExpr(e.span, Str, StrConst(value))
    Interpolate(prefix, chunks, parts, holes) -> interpolate_expr(c, e, prefix, chunks, parts, holes, expected)
    UnitLit -> TExpr(e.span, Unit, UnitConst)
    Name(name) -> name_expr(c, e.span, name, expected)
    TypeApply(target, types) -> type_apply(c, e, target, types, expected)
    TypeParent(_) ->
        c.note(unit_of(c), e.span, "a type is not a value")
        TExpr(e.span, ErrorType, UnitConst)
    Checked(slot) -> c.checked_slots[slot]
    Member(target, name) ->
        if module_use(c, e) is Some(q) then check_form(c, q, expected, used)
        elif limit_constant(c, e.span, target, name) is Some(k) then k
        elif static_value(c, e.span, target, name, expected) is Some(v) then v
        else member_expr(c, e, target, name, expected)
    Call(callee, args) -> call_expr(c, e.span, callee, args, expected)
    InfixCall(target, name, name_span, arg) -> infix_call(c, e.span, target, name, name_span, arg, expected)
    Block(items, discard) -> block_expr(c, e, items, discard, expected, used)
    Binding(name, declared, value, mutable) -> binding_expr(c, e, name, declared, value, mutable)
    Destructure(pattern, declared, value, mutable) -> destructure_expr(c, e, pattern, declared, value, mutable)
    Assign(target, op, value, yields, op_span) -> assign_expr(c, e, target, op, value, yields, op_span)
    SymbolAssign(target, spelling, value, op_span) -> compound_assign(c, e, target, spelling, None, value, op_span)
    MultiAssign(targets, op, value, op_span) -> multi_assign_expr(c, e, targets, op, value, op_span)
    Tuple(items) -> tuple_expr(c, e, items, expected)
    TupleIndex(target, index) -> tuple_index(c, e, target, index)
    Update(target, increment, postfix, op_span) -> update_expr(c, e, target, increment, postfix, op_span)
    Binary(op, left, right, op_span) -> binary_expr(c, e, op, left, right, op_span, expected)
    Compare(operands, ops) -> compare_expr(c, e, operands, ops)
    If(condition, yes, no) -> if_expr(c, e, condition, yes, no, expected, used)
    While(condition, body, otherwise) -> while_expr(c, e, condition, body, otherwise, expected, used)
    Loop(body) -> loop_expr(c, e, body, expected, used)

    DoWhile(body, condition, otherwise) -> check_form(c, do_while_form(e, body, condition, otherwise), expected, used)
    For(pattern, source, body) -> for_expr(c, e, pattern, source, body)
    ForYield(generators, body) -> for_yield_expr(c, e, generators, body, expected)
    Range(lower, upper, inclusive) -> range_expr(c, e, lower, upper, inclusive)
    Cons(head, tail, op_span) -> cons_expr(c, e, head, tail, op_span, expected)
    ListLit(items) -> collection_literal(c, e, "sequence", items, buf(), expected)
    SetLit(items) -> collection_literal(c, e, "set", items, buf(), expected)
    MapLit(keys, values) -> collection_literal(c, e, "map", keys, values, expected)
    Break(value) -> break_expr(c, e, value)
    Continue -> continue_expr(c, e)
    Return(value) -> return_expr(c, e, value)
    Propagate(value) -> propagate_expr(c, e, value)
    Splice(value) ->
        c.note(unit_of(c), e.span, "`*` after an argument passes a sequence as a repeated parameter's arguments; it is written only as the last argument of a call to a function with one")
        check_statement(c, value)
        TExpr(e.span, ErrorType, UnitConst)
    Match(subject, arms) -> match_expr(c, e, subject, arms, expected, used)
    Is(_, _, _) -> check_condition(c, e).expr
    Lambda(params, body) -> lambda_expr(c, e, params, body, expected, false)
    MatchFunction(arms) -> match_function_expr(c, e, arms, expected)
    LocalFunction(decl) ->
        check_local_function(c, decl)
        TExpr(e.span, Unit, UnitConst)
    Invalid -> TExpr(e.span, ErrorType, UnitConst)
    _ -> unsupported(c, e, "this expression")

private unsupported(c: *Checker, e: &Expr, what: string) -> &TExpr
    c.note(unit_of(c), e.span, s"$what is not implemented")
    TExpr(e.span, ErrorType, UnitConst)

lookup_local(c: *Checker, name: string) -> Option[usize]
    if name == "_" then return None
    var i = c.body.visible.len()
    while i > 0
        i -= 1
        val index = c.body.visible[i]
        if c.body.locals[index].name == name
            if function_hides(c, name, i) then return None
            return Some(index)
    None

/** Whether the innermost local function of `name` is declared in a block nested inside the scope of
 * the local at position `at` of `visible`, and so hides it: the innermost declaration of a name
 * wins, whichever kind each is. A parameter of the top-level function encloses every block, so any
 * local function of its name hides it (see `param_index`). */
private function_hides(c: *Checker, name: string, at: usize) -> bool
    var i = c.body.functions.len()
    while i > 0
        i -= 1
        if c.symbols[c.body.functions[i]].name == name then return c.body.function_marks[i] > at
    false

// Parameters of the top-level function; a local function's own parameters are locals. A
// constructor's parameters are only stored into their fields, so a class's parameter is named
// through its field, which a `var` field's assignments change.
param_index(c: *Checker, name: string) -> Option[usize]
    if local_function(c, name) is Some(_) then return None
    val symbol = c.symbols[c.body.root]
    if symbol.constructor
        // A superclass's arguments read the parameters themselves; an initializer's object is not
        // one of them.
        if !c.super_args then return None
        val first = if c.classes[symbol.owner_class.unwrap()].constructor == c.body.root then 0usize else 1usize
        for i in first..<symbol.param_names.len()
            if symbol.param_names[i] == name then return Some(i)
        return None
    for i in 0..<symbol.param_names.len()
        if symbol.param_names[i] == name then return Some(i)
    None

private name_expr(c: *Checker, at: Span, name: string, expected: Option[&Type]) -> &TExpr
    if name == "_"
        c.note(unit_of(c), at, "`_` is not a value; it stands for a binding that is never read")
        return TExpr(at, ErrorType, UnitConst)
    if c.super_args && name == "self"
        c.note(unit_of(c), at, "`self` cannot be used in a superclass's arguments, which run before the object is initialized")
        return TExpr(at, ErrorType, UnitConst)
    if name == "self" && refuse_static_self(c, at, "") then return TExpr(at, ErrorType, UnitConst)
    if binding_ref(c, at, name) is Some(t) then return evaluated(t)
    val symbol = c.symbols[c.current]
    if name == "super" && enclosing_class(c) is Some(_)
        c.note(symbol.unit, at, "`super` calls a superclass's method, as in `super.describe()`")
        return TExpr(at, ErrorType, UnitConst)
    class_member(c, name) match
        Some(FieldOf(i)) -> return field_read(c, at, at, self_ref(c, at), fields_class(c).unwrap(), i, true)
        Some(DataFieldOf(i)) -> return data_field_read(c, at, self_ref(c, at), i)
        Some(MethodOf(m)) ->
            var ms = bare_methods(c, name)
            if ms.len() == 0 then ms.push(m)
            return overloaded_method_value(c, at, self_ref(c, at), name, ms, None, expected)
        Some(TraitFieldOf(m)) -> return trait_field_read(c, at, self_ref(c, at), m, expected)
        None -> ()
    if global_named(c, name) is Some(g)
        // An object that declares `apply`, where a function is expected, is that function, unless
        // the object is of a function type and so a function value itself.
        if expected is Some(t)
            if *zonk(c, t) is Function(ps, _)
                val ids = lookup_functions(c, name)
                if applying_object(c, name, ids) is Some(o)
                    var found: Buf[&Type] = buf()
                    function_ancestors(c.classes, c.data, own_class_type(c.classes[o], o), &found, 0)
                    if found.len() == 0 then return apply_value(c, at, name, o, ids, ps, expected)
        return global_read(c, at, g)
    if lookup_function(c, name) is Some(id)
        if abstract_constructor(c, id, at) then return TExpr(at, ErrorType, UnitConst)
        return named_function_value(c, at, name, None, expected)
    if variant_named(c, name) is Some(v)
        if c.data[v.data].variants[v.index].fields.len() == 0 then return construct(c, at, at, v, buf(), None, expected)
        c.note(symbol.unit, at, s"`$name` has fields; call it, as in `$name(…)`")
    elif tested_named(c, name) then c.note(symbol.unit, at, s"`$name` is bound by an `is` test, and is in scope only where that test is known to hold")
    else c.note(symbol.unit, at, s"`$name` is not defined")
    TExpr(at, ErrorType, UnitConst)

// Reads field `index` of an object of class `k`. Through `self` in the constructor's own code, a
// field must already be initialized: a parameter, or a body field declared above the read.
private field_read(c: *Checker, at: Span, name_span: Span, object: &TExpr, k: usize, index: usize, own: bool) -> &TExpr
    val field = c.classes[k].fields[index]
    if own && c.current == c.classes[k].initializer && index >= c.classes[k].ready
        if c.super_args then c.note(unit_of(c), name_span, s"`${field.name}` is read in a superclass's arguments, which run before the object is initialized")
        else c.note(unit_of(c), name_span, s"`${field.name}` is read before its declaration in the class body initializes it")
        return TExpr(at, ErrorType, UnitConst)
    val ty = field_type(c, k, index, name_span)
    val args = *zonk(c, object.ty) match
        Class(_, _, a) -> a
        _ -> buf()
    val read = substitute(ty, class_owner(k), args)
    if field.lazy then return lazy_field_read(c, at, object, index, read, field.name)
    TExpr(at, read, Field(object, index))

// A `lazy val` field's read: the object is evaluated once, into a hidden local unless it is one
// already, and the read runs the closure in the field's initializer slot when it is the first.
private lazy_field_read(c: *Checker, at: Span, object: &TExpr, index: usize, ty: &Type, name: string) -> &TExpr
    val pure = object.kind is Local(_) || object.kind is Param(_)
    val held: Option[usize] = if pure then None else Some(hidden_local(c, object.ty))
    val target: &TExpr = held match
        Some(h) -> TExpr(object.span, object.ty, Local(h))
        None -> object
    val run: &Type = Function(buf(), ty)
    val initialize = TExpr(at, ty, CallValue(TExpr(at, run, Field(target, index + 2)), buf()))
    val read = TExpr(at, ty, LazyField(target, index, initialize, name))
    held match
        Some(h) ->
            var items: Buf[&TExpr] = buf()
            items.push(TExpr(object.span, Unit, Let(h, object)))
            items.push(read)
            TExpr(at, ty, Block(items))
        None -> read

/** Field `index` of the one variant of `object`'s data type. */
private data_field_read(c: *Checker, at: Span, object: &TExpr, index: usize) -> &TExpr = *zonk(c, object.ty) match
    Data(id, _, args) -> TExpr(at, variant_fields(c.data[id], id, 0, args)[index], Field(object, index))
    _ -> TExpr(at, ErrorType, UnitConst)

// A field declared without a type has its initializer's, so the class body is checked first, as far
// as the field. An inherited field's type is its declaring class's.
private field_type(c: *Checker, k: usize, index: usize, at: Span) -> &Type
    if index < c.classes[k].inherited
        if c.classes[k].superclass is Some(sup)
            if *sup is Class(sid, _, args) then return substitute(field_type(c, sid, index, at), class_owner(sid), args)
    if c.classes[k].fields[index].ty is Some(t) then return t
    if c.building[k] != 1 && c.states[c.classes[k].initializer] == 0
        check_class_body_upto(c, k, index)
        return c.classes[k].fields[index].ty.unwrap_or(ErrorType)
    val name = c.classes[k].fields[index].name
    c.note(unit_of(c), at, s"the type of the field `$name` is needed before its initializer is checked; declare it, as in `val $name: int = …`")
    ErrorType

// The method `name` that a value of type `t` has: its class's, or one an impl adds to its data or
// built-in type.
private method_of(c: *Checker, t: &Type, name: string) -> Option[usize]
    val known = zonk(c, t)
    val found = if *known is Class(k, _, _) then method_named(c, k, name) else receiver_method(c, known, name)
    if found is Some(_) then return found
    val rendering = rendering_methods(c, known, name)
    if rendering.len() > 0 then Some(rendering[0]) else None

// The methods of `Display` and `Debug` named `name` that a value of `Any` or of a trait has without
// declaring them: see `rendered_at_run_time`.
private rendering_methods(c: *Checker, t: &Type, name: string) -> Buf[usize]
    if !rendered_at_run_time(c.classes, t) then return buf()
    for trait_name in ["Display", "Debug"]
        if c.core.trait_named(trait_name) is Some(k)
            val ms = methods_named(c, k, name)
            if ms.len() > 0 then return ms
    buf()

// A method of `name` named without a call, chosen among `ms`, the overloads the receiver's type has
// that the code being checked may call. An overloaded name takes its overload from the expected
// function type, as a function's does: of the overloads whose parameters accept that type's, the
// most specific.
private overloaded_method_value(c: *Checker, at: Span, receiver: &TExpr, name: string, ms: Buf[usize], explicit: Option[Buf[&TypeExpr]], expected: Option[&Type]) -> &TExpr
    if ms.len() == 1 || *receiver.ty is Nothing then return method_value(c, at, receiver, ms[0], explicit, expected)
    if refuse_trait_clash(c, at, receiver.ty, name, ms) then return TExpr(at, ErrorType, UnitConst)
    val unit = unit_of(c)
    var wanted: Option[Buf[&Type]] = None
    if expected is Some(t)
        if *zonk(c, t) is Function(ps, _) then wanted = Some(ps)
    val params = wanted match
        Some(ps) -> ps
        None ->
            c.note(unit, at, s"`$name` is overloaded, so as a value with no expected function type it is ambiguous: ${overload_list(c, ms)} could each be meant")
            return TExpr(at, ErrorType, UnitConst)
    var fitting: Buf[usize] = buf()
    var compared: Buf[Buf[&Type]] = buf()
    for m in ms
        val s = method_signature(c, receiver, m, ErrorType)
        val view = substitute_all(s.params, s.owner, s.known)
        if accepts(c, view, s.owner, s.type_params.len(), params)
            fitting.push(m)
            compared.push(view)
    if fitting.len() == 0
        c.note(unit, at, s"no overload of `$name` has the parameter types of ${type_name(zonk(c, expected.unwrap()))}; the overloads are ${overload_list(c, ms)}")
        return TExpr(at, ErrorType, UnitConst)
    most_specific(c, fitting, compared) match
        Some(m) -> method_value(c, at, receiver, m, explicit, expected)
        None ->
            c.note(unit, at, s"`$name` used as ${type_name(zonk(c, expected.unwrap()))} is ambiguous: ${overload_list(c, fitting)} each accept it")
            TExpr(at, ErrorType, UnitConst)

/** The methods of `name` a value of type `t` has that the code being checked may call, one for each
 * list of parameter types. */
methods_of(c: *Checker, t: &Type, name: string) -> Buf[usize]
    val known = zonk(c, t)
    if *known is TypeVar(_, _, _) then return with_trait_methods(c, known, name, bound_methods(c, known, name))
    val found = if *known is Class(k, _, _) then with_trait_methods(c, known, name, methods_named(c, k, name)) else in_scope_on_context(c, known, with_trait_methods(c, known, name, visible_methods(c, receiver_methods(c, known, name))))
    if found.len() > 0 then found else rendering_methods(c, known, name)

// The methods of `StringContext`, its interpolators, are seen only where their module is: the core
// library's, those of the file's own module and those of the modules it imports.
private in_scope_on_context(c: *Checker, t: &Type, ms: Buf[usize]) -> Buf[usize]
    val core = c.types.get(qualified(CoreModule, "StringContext")) match
        Some(k) -> k
        None -> return ms
    *t match
        Data(k, _, _) -> if k != core then return ms
        _ -> return ms
    var out: Buf[usize] = buf()
    for m in ms
        val home = c.symbols[m].module_name
        if home == CoreModule || sees_module(c, unit_of(c), home) then out.push(m)
    out

/** The methods of `name` a value of type parameter `t` has: those of its bounds, each once. */
bound_methods(c: *Checker, t: &Type, name: string) -> Buf[usize]
    var out: Buf[usize] = buf()
    for b in bounds_of(c, t)
        if *b is Class(k, _, _)
            for m in methods_named(c, k, name)
                if !contains_id(out, m) then out.push(m)
    out

// The bounds of type parameter `t`, as a diagnostic names them.
private bound_names(c: *Checker, t: &Type) -> string
    var text = ""
    for b in bounds_of(c, t)
        if text != "" then text = text + " + "
        text = text + type_name(b)
    text

// `object.name` for a method `m` of the object's type, named without a call: outside the class, or
// the impls, that declare it, a private method cannot be.
private member_method_value(c: *Checker, at: Span, object: &TExpr, m: usize, explicit: Option[Buf[&TypeExpr]], expected: Option[&Type]) -> &TExpr
    if !method_visible(c, m)
        val name = c.symbols[m].decl.name
        c.symbols[m].owner_class match
            Some(k) -> c.note(unit_of(c), at, s"`$name` is private to `${c.classes[k].name}`")
            None -> c.note(unit_of(c), at, s"`$name` is private to the impls of `${impls_owner(c, m)}`")
        return TExpr(at, ErrorType, UnitConst)
    method_value(c, at, object, m, explicit, expected)

// A method named without a call is a function value bound to its receiver: a closure, of the
// method's type without the receiver, that holds the receiver and calls the method on it with its
// arguments. The receiver is evaluated once, where the value is made. Through a trait or an open
// class the closure calls through the object's method table, as a call there would; the object is
// fixed, so that is the implementation its class had when the value was made. The class's type
// arguments come from the receiver's type, and the method's own are written or decided by the
// expected function type.
private method_value(c: *Checker, at: Span, receiver: &TExpr, m: usize, explicit: Option[Buf[&TypeExpr]], expected: Option[&Type]) -> &TExpr
    val unit = unit_of(c)
    if *receiver.ty is Nothing then return receiver
    if refuse_unmet_conformance(c, at, receiver.ty, m) then return TExpr(at, ErrorType, UnitConst)
    if refuse_static_on_value(c, at, receiver, m) then return TExpr(at, ErrorType, UnitConst)
    val target = c.symbols[m]
    val name = target.decl.name
    val known = receiver_type_args(c, receiver.ty, m)
    val result = result_of(c, m, at)
    val type_params = target.type_params
    val first = c.vars.len()
    var type_args: Buf[&Type] = buf()
    for i in 0..<type_params.len()
        type_args.push(if i < known.len() then known[i] else fresh_var(c))
    var failed = false
    if explicit is Some(types)
        val own = type_params.len() - known.len()
        if types.len() > own
            c.note(unit, at, s"`$name` takes ${count(own, "type argument")}, not ${types.len()}")
            failed = true
        else
            for i in 0..<types.len()
                unify(c, type_args[known.len() + i], resolve_type(c, unit, types[i]))
    var params: Buf[&Type] = buf()
    var names: Buf[string] = buf()
    for i in 1..<target.params.len()
        params.push(with_self(c, m, receiver.ty, target.params[i]))
        names.push(target.param_names[i])
    val declared: &Type = Function(substitute_all(params, target.type_owner, type_args), substitute(with_self(c, m, receiver.ty, result), target.type_owner, type_args))
    if expected is Some(want) then unify(c, declared, want)
    var solved: Buf[&Type] = buf()
    for i in 0..<type_args.len()
        val t = zonk(c, type_args[i])
        if *t is Var(v)
            if v >= first
                if !failed then c.note(unit, at, s"cannot infer `${type_params[i].name}` for `$name` used as a value; write it, as in `$name[int]`")
                c.vars.set(v, Some(ErrorType))
                failed = true
        solved.push(zonk(c, t))
    if failed then return TExpr(at, ErrorType, UnitConst)
    val ty = zonk(c, declared)
    var lambda_params: Buf[&Type] = buf()
    var lambda_result: &Type = ErrorType
    if *ty is Function(ps, r)
        lambda_params = ps
        lambda_result = r
    // The receiver is held in a local of the code making the value, which the closure captures; a
    // static member's receiver is its type, which has no value to hold.
    val on_type = receiver.kind is TypeReceiver
    val held = if on_type then 0usize else hidden_local(c, receiver.ty)
    val enclosing = c.symbols[c.current]
    val decl = Function(buf(), at, at, "lambda", buf(), buf(), None, None, buf())
    val id = c.symbols.len()
    c.symbols.push(FunctionSymbol(enclosing.unit, enclosing.module_name, "lambda", decl, lambda_params, names, Some(lambda_result), None, Some(c.body.root), buf(), buf(), buf(), true, false, true, buf(), None, id, buf(), None, false, true, "", None, false))
    c.states.push(2)
    c.bodies.push(None)
    c.locals.push(buf())
    var args: Buf[&TExpr] = buf()
    args.push(if on_type then receiver else TExpr(at, receiver.ty, Local(held)))
    var param_locals: Buf[usize] = buf()
    for i in 0..<lambda_params.len()
        val index = c.body.locals.len()
        c.body.locals.push(TLocal(names[i], lambda_params[i], false, id))
        param_locals.push(index)
        args.push(TExpr(at, lambda_params[i], Local(index)))
    c.symbols[id].param_locals = param_locals
    if !on_type then c.body.uses.push(CaptureUse(id, held, false))
    c.body.calls.push(LocalCall(c.current, id))
    val call = method_call_kind(c, receiver.ty, m, args, solved, false)
    c.bodies.set(id, Some(TExpr(at, lambda_result, call)))
    var items: Buf[&TExpr] = buf()
    if !on_type then items.push(TExpr(receiver.span, Unit, Let(held, receiver)))
    items.push(TExpr(at, ty, FunctionValue(id, buf())))
    TExpr(at, ty, Block(items))

// Whether code that may use the private members of class `k` is being checked: code of the class
// itself, or of its companion; for a data type's companion object, a method an impl adds to the type.
private inside_class(c: *Checker, k: usize) -> bool
    if c.classes[k].companion_data is Some(d) && !in_extension(c)
        if c.symbols[c.body.root].receiver is Some(r)
            if *r is Data(a, _, _)
                if a == d then return true
    val here = enclosing_class(c) match
        Some(h) -> h
        None -> return false
    here == k || c.classes[k].companion == Some(here)

// An abstract class has a constructor its subclasses' constructors run, but cannot be called to make
// an object of its own; reports whether `id` is one.
private abstract_constructor(c: *Checker, id: usize, at: Span) -> bool
    val symbol = c.symbols[id]
    if !symbol.constructor then return false
    val k = symbol.owner_class.unwrap()
    if is_array_class(c.classes[k])
        c.note(unit_of(c), at, "an array is made with every element set, by `Array.fill(n, value)`, `Array.tabulate(n, f)` or `Array.empty()`")
        return true
    if handle_target(c.classes[k].decl) is Some(target)
        c.note(unit_of(c), at, s"`${c.classes[k].name}` is a handle on the Sysl type `$target`, so only a Sysl binding that returns one makes it")
        return true
    if !is_abstract_class(c, k) then return false
    if is_trait(c, k) then c.note(unit_of(c), at, s"`${c.classes[k].name}` is a trait, so it cannot be instantiated; instantiate a class that conforms to it")
    else c.note(unit_of(c), at, s"`${c.classes[k].name}` is abstract, so it cannot be instantiated; instantiate a subclass")
    true

// A local or a parameter by name, as it is stored: a by-name parameter is its delayed expression,
// not yet evaluated.
private binding_ref(c: *Checker, at: Span, name: string) -> Option[&TExpr]
    if lookup_local(c, name) is Some(index)
        if c.body.locals[index].owner != c.current then c.body.uses.push(CaptureUse(c.current, index, false))
        // A local's type may have been settled by a use since it was declared.
        return Some(TExpr(at, zonk(c, c.body.locals[index].ty), Local(index)))
    if param_index(c, name) is Some(i)
        if c.current != c.body.root then c.body.uses.push(CaptureUse(c.current, i, true))
        return Some(TExpr(at, c.symbols[c.body.root].params[i], Param(i)))
    None

// A read of a by-name parameter evaluates its delayed expression, a closure with no parameters,
// every time.
private evaluated(t: &TExpr) -> &TExpr = *t.ty match
    ByName(inner) -> TExpr(t.span, inner, CallValue(t, buf()))
    _ -> t

// Type arguments written on a name that is not called: a function or a method used as a value, or a
// variant with no fields, as in `None[int]`.
private type_apply(c: *Checker, e: &Expr, target: &Expr, types: Buf[&TypeExpr], expected: Option[&Type]) -> &TExpr
    if module_use(c, target) is Some(q) then return type_apply(c, e, q, types, expected)
    if target.kind is Name(name)
        // A method of the enclosing class by bare name, bound to `self`, as in `convert[int]`.
        if lookup_local(c, name) is None && param_index(c, name) is None
            if class_member(c, name) is Some(MethodOf(m)) then return method_value(c, e.span, self_ref(c, target.span), m, Some(types), expected)
        if lookup_function(c, name) is Some(id)
            if abstract_constructor(c, id, target.span) then return TExpr(e.span, ErrorType, UnitConst)
            return named_function_value(c, e.span, name, Some(types), expected)
        if lookup_local(c, name) is None && param_index(c, name) is None
            if variant_named(c, name) is Some(v)
                if c.data[v.data].variants[v.index].fields.len() == 0
                    return construct(c, e.span, target.span, v, buf(), Some(types), expected)
    // A method named without a call, with its own type arguments, as in `box.convert[int]`.
    if target.kind is Member(inner, name)
        val object = check_expr(c, inner, None)
        val ms = methods_of(c, object.ty, name)
        if ms.len() > 1 then return overloaded_method_value(c, e.span, object, name, ms, Some(types), expected)
        if method_of(c, object.ty, name) is Some(m) then return member_method_value(c, e.span, object, m, Some(types), expected)
        if ms.len() == 1 then return member_method_value(c, e.span, object, ms[0], Some(types), expected)
    unsupported(c, e, "a value with type arguments that is not called")

// A field is read by name from a value of a data type with one variant; a type with several is
// taken apart by `match`, since which fields a value has depends on its variant.
// A method named without a call is a function value bound to the value; see `method_value`.
// The limits a built-in scalar type names: `int.MaxValue`, `i8.MinValue`, `byte.MaxValue`,
// `char.MaxValue`, and for `real` the greatest and least finite values, the least positive one, the
// infinities and NaN. Each is a constant. A name written on one of these types that is none of them
// is reported; `None` where `target` is not such a type.
private limit_constant(c: *Checker, at: Span, target: &Expr, name: string) -> Option[&TExpr]
    if !(target.kind is Name(_)) then return None
    if !(name.bytes.len > 0 && name.bytes[0] >= u8('A') && name.bytes[0] <= u8('Z')) then return None
    val ty = static_receiver(c, target, name)?
    val t = zonk(c, ty)
    if !(*t is Int(_) || *t is Byte || *t is Char || *t is Real) then return None
    val least = name == "MinValue"
    val greatest = name == "MaxValue"
    *t match
        Int(bits) ->
            if greatest then return Some(TExpr(at, t, IntConst(max_digits(bits))))
            if least then return Some(TExpr(at, t, IntConst(min_digits(bits))))
        Byte ->
            if greatest then return Some(TExpr(at, t, IntConst("255")))
            if least then return Some(TExpr(at, t, IntConst("0")))
        Char ->
            if greatest then return Some(TExpr(at, t, CharConst(1114111)))
            if least then return Some(TExpr(at, t, CharConst(0)))
        _ ->
            val zero = 0.0
            val infinity = 1.0 / zero
            if greatest then return Some(TExpr(at, t, RealConst(1.7976931348623157e308)))
            if least then return Some(TExpr(at, t, RealConst(-1.7976931348623157e308)))
            if name == "MinPositiveValue" then return Some(TExpr(at, t, RealConst(4.9e-324)))
            if name == "PositiveInfinity" then return Some(TExpr(at, t, RealConst(infinity)))
            if name == "NegativeInfinity" then return Some(TExpr(at, t, RealConst(-infinity)))
            if name == "NaN" then return Some(TExpr(at, t, RealConst(infinity - infinity)))
    c.note(unit_of(c), at, s"`${type_name(t)}` has no member `$name`")
    Some(TExpr(at, ErrorType, UnitConst))

private member_expr(c: *Checker, e: &Expr, target: &Expr, name: string, expected: Option[&Type]) -> &TExpr = member_of(c, e, check_expr(c, target, None), name, expected)

private member_of(c: *Checker, e: &Expr, value: &TExpr, name: string, expected: Option[&Type]) -> &TExpr
    val unit = unit_of(c)
    val ty = zonk(c, value.ty)
    // A field of a data type with one variant comes before a method of the same name.
    if !(*ty is Class(_, _, _)) && !one_variant_field(c, ty, name)
        val ms = methods_of(c, ty, name)
        if ms.len() > 1 then return overloaded_method_value(c, e.span, value, name, ms, None, expected)
        if receiver_method(c, ty, name) is Some(m) then return member_method_value(c, e.span, value, m, None, expected)
        if ms.len() == 1 && trait_method_of(c, ms[0]) is Some(_) then return member_method_value(c, e.span, value, ms[0], None, expected)
    *ty match
        Data(id, _, args) ->
            val d = c.data[id]
            if d.variants.len() > 1
                c.note(unit, e.span, s"`${type_name(ty)}` has several variants, so its fields are reached by `match`")
                return TExpr(e.span, ErrorType, UnitConst)
            if d.variants.len() == 1
                val names = d.variants[0].field_names
                for i in 0..<names.len()
                    if names[i] == name then return TExpr(e.span, variant_fields(d, id, 0, args)[i], Field(value, i))
            c.note(unit, e.span, s"`${type_name(ty)}` has no field `$name`")
        Class(k, _, _) -> return class_member_value(c, e.span, value, k, name, expected)
        TypeVar(_, _, _) -> return bound_member_value(c, e.span, value, ty, name, expected)
        ErrorType -> ()
        Nothing -> return value
        _ -> c.note(unit, e.span, s"${type_name(ty)} has no field `$name`")
    TExpr(e.span, ErrorType, UnitConst)

// `value.name` on a value of type parameter `ty`: a `val` of a trait bounding it, or a method of its
// bounds named without a call.
private bound_member_value(c: *Checker, at: Span, value: &TExpr, ty: &Type, name: string, expected: Option[&Type]) -> &TExpr
    if bound_field(c, ty, name) is Some(m) then return trait_field_read(c, at, value, m, expected)
    // A field of a class bounding it is read as from an instance of that class.
    if bound_class_field(c, ty, name) is Some(b)
        if *b is Class(k, _, _) then return class_member_value(c, at, TExpr(value.span, b, value.kind), k, name, expected)
    val ms = with_trait_methods(c, ty, name, bound_methods(c, ty, name))
    if ms.len() > 0 then return member_method_value(c, at, value, ms[0], None, expected)
    no_bound_member(c, at, ty, name)
    TExpr(at, ErrorType, UnitConst)

/** The `val` named `name` of a trait bounding type parameter `ty`, read with field syntax. */
bound_field(c: *Checker, ty: &Type, name: string) -> Option[usize]
    for b in bounds_of(c, ty)
        if *b is Class(k, _, _)
            if trait_field_named(c, k, name) is Some(m) then return Some(m)
    None

/** The class bounding type parameter `ty` that has a field named `name`. */
private bound_class_field(c: *Checker, ty: &Type, name: string) -> Option[&Type]
    for b in bounds_of(c, ty)
        if *b is Class(k, _, _)
            if !is_trait(c, k) && class_field(c, k, name) is Some(_) then return Some(b)
    None

// Reports that type parameter `ty` has no member `name`: only its bounds give it any.
private no_bound_member(c: *Checker, at: Span, ty: &Type, name: string)
    val t = type_name(ty)
    if bounds_of(c, ty).len() == 0 then c.note(unit_of(c), at, s"`$t` has no bound, so it has no member `$name`; a bound, as in `[$t: Trait]`, gives it the methods of the trait")
    else c.note(unit_of(c), at, s"`$name` is not a member of `${bound_names(c, ty)}`, the bound of `$t`")

// `object.name` on an object of class `k`: a field, which outside the class must be public.
private class_member_value(c: *Checker, at: Span, object: &TExpr, k: usize, name: string, expected: Option[&Type]) -> &TExpr
    val cls = c.classes[k]
    if class_field(c, k, name) is Some(i)
        if !field_visible(c, cls.fields[i])
            c.note(unit_of(c), at, s"`$name` is private to `${c.classes[cls.fields[i].owner].name}`")
            return TExpr(at, ErrorType, UnitConst)
        return field_read(c, at, at, object, k, i, is_self(c, object))
    if trait_field_named(c, k, name) is Some(m) then return trait_field_read(c, at, object, m, expected)
    val ms = with_trait_methods(c, object.ty, name, methods_named(c, k, name))
    if ms.len() > 1 then return overloaded_method_value(c, at, object, name, ms, None, expected)
    if method_named(c, k, name) is Some(m) then return member_method_value(c, at, object, m, None, expected)
    if ms.len() == 1 then return member_method_value(c, at, object, ms[0], None, expected)
    c.note(unit_of(c), at, s"`${cls.name}` has no member `$name`")
    TExpr(at, ErrorType, UnitConst)

/** Whether `t` is a data type with one variant that has a field `name`. */
private one_variant_field(c: *Checker, t: &Type, name: string) -> bool
    if *t is Data(id, _, _)
        val d = c.data[id]
        if d.variants.len() == 1
            for n in d.variants[0].field_names
                if n == name then return true
    false

/** Whether an expression is `self` in a constructor, the object it is still initializing. */
private is_self(c: *Checker, t: &TExpr) -> bool = t.kind match
    Local(i) -> c.body.locals[i].name == "self"
    _ -> false

// A local a statement brought into its block may not share a name with one of the block's own local
// functions, whichever is written first. `before` is where the statement's locals begin in `visible`
// and `first` where the block's local functions begin in `functions`.
private report_clashes_with_functions(c: *Checker, at: Span, before: usize, first: usize)
    for i in before..<c.body.visible.len()
        val name = c.body.locals[c.body.visible[i]].name
        if name == "_" then continue
        for k in first..<c.body.functions.len()
            if c.symbols[c.body.functions[k]].name == name
                val line = c.units[unit_of(c)].src.locate(c.symbols[c.body.functions[k]].decl.name_span.start).line
                c.note(unit_of(c), at, s"`$name` is already declared as a local function in this block, on line $line")
                break

// A block's locals go out of scope at its end. A block that contains an expression which never
// finishes (a `return`, a `break`) never yields, so its type is `Nothing`.
private block_expr(c: *Checker, e: &Expr, items: Buf[&Expr], discard: bool, expected: Option[&Type], used: bool) -> &TExpr
    val mark = c.body.visible.len()
    val function_mark = c.body.functions.len()
    val outer_start = c.body.block_start
    c.body.block_start = mark
    declare_local_functions(c, items)
    var typed: Buf[&TExpr] = buf()
    var finishes = true
    for i in 0..<items.len()
        val item = items[i]
        val before = c.body.visible.len()
        val t = if i + 1 == items.len() && !discard then check_value(c, item, expected, used) else check_statement(c, item)
        report_clashes_with_functions(c, item.span, before, function_mark)
        if *t.ty is Nothing then finishes = false
        typed.push(t)
    c.body.visible.truncate(mark)
    c.body.functions.truncate(function_mark)
    c.body.function_starts.truncate(function_mark)
    c.body.function_marks.truncate(function_mark)
    c.body.block_start = outer_start
    var ty: &Type = Unit
    if !finishes then ty = Nothing
    elif !discard && typed.len() > 0 then ty = typed[typed.len() - 1].ty
    TExpr(e.span, ty, Block(typed))

// Checks a branch of `if` or `while`, whose bindings are not visible after it.
private branch(c: *Checker, e: &Expr, expected: Option[&Type], used: bool) -> &TExpr = tested_branch(c, e, buf(), expected, used)

// Checks a branch that runs where a condition's outcome is known, with the names its `is` tests
// bound for that outcome in scope.
private tested_branch(c: *Checker, e: &Expr, names: Buf[usize], expected: Option[&Type], used: bool) -> &TExpr
    val mark = c.body.visible.len()
    for x in names do c.body.visible.push(x)
    val t = check_value(c, e, expected, used)
    c.body.visible.truncate(mark)
    t

private binding_expr(c: *Checker, e: &Expr, name: string, declared: Option[&TypeExpr], value: &Expr, mutable: bool) -> &TExpr
    val unit = unit_of(c)
    var want: Option[&Type] = None
    if declared is Some(d) then want = Some(resolve_type(c, unit, d))
    val typed = check_expr(c, value, want)
    var ty = typed.ty
    if want is Some(w)
        if !fits(c,typed.ty, w) then c.note(unit, value.span, s"expected ${type_name(w)}, found ${type_name(typed.ty)}")
        ty = w
    val index = declare_local(c, e.span, name, ty, mutable)
    // A binding whose value never finishes does not finish either.
    TExpr(e.span, if *typed.ty is Nothing then Nothing else Unit, Let(index, typed))

/** Brings a new local into scope; a name may be declared once per block. */
private declare_local(c: *Checker, at: Span, name: string, ty: &Type, mutable: bool) -> usize
    if name == "self" then c.note(unit_of(c), at, "`self` names the instance a method works on; it cannot be declared")
    for i in c.body.block_start..<c.body.visible.len()
        if name != "_" && c.body.locals[c.body.visible[i]].name == name
            c.note(unit_of(c), at, s"`$name` is already defined in this block")
    val index = c.body.locals.len()
    c.body.locals.push(TLocal(name, ty, mutable, c.current))
    c.body.visible.push(index)
    if c.index is Some(_) then index_declared_local(c, at, name, index, ty)
    index

// The mutable local an assignment or update writes, after reporting why anything else cannot be
// written.
private assignable(c: *Checker, target: &Expr) -> Option[usize]
    val unit = unit_of(c)
    val name = target.kind match
        Name(n) -> n
        _ ->
            c.note(unit, target.span, "only a local `var` can be assigned")
            return None
    lookup_local(c, name) match
        Some(index) ->
            if c.body.locals[index].mutable
                if c.body.locals[index].owner != c.current then c.body.uses.push(CaptureUse(c.current, index, false))
                return Some(index)
            c.note(unit, target.span, s"`$name` is a `val`; only a `var` can be assigned")
        None ->
            if param_index(c, name) is Some(_) then c.note(unit, target.span, s"`$name` is a parameter, which cannot be assigned")
            elif global_named(c, name) is Some(_) then c.note(unit, target.span, "assigning a module-level value in a multiple assignment is not implemented")
            elif lookup_function(c, name) is Some(_) then c.note(unit, target.span, s"`$name` is a function, which cannot be assigned")
            else c.note(unit, target.span, s"`$name` is not defined")
    None

/** A field an assignment writes: the object, read once, and the field's index and type. `setup`
 * holds the object in a hidden local when it is computed rather than named. A trait's `var` field
 * seen through the trait, or through a type parameter it bounds, is read through its `val`,
 * `getter`, and assigned through `setter`, which reach the field of the object's own class. */
private struct FieldPlace
    setup: Option[&TExpr]
    object: &TExpr
    index: usize
    ty: &Type
    getter: usize
    setter: Option[usize]

    /** `body`, after the object is held. */
    wrap(self, at: Span, body: &TExpr) -> &TExpr = self.setup match
        Some(s) ->
            var items: Buf[&TExpr] = buf()
            items.push(s)
            items.push(body)
            TExpr(at, body.ty, Block(items))
        None -> body
end FieldPlace

// Whether an assignment's target is a field: `object.name`, or inside a class a bare name that no
// local or parameter hides.
private targets_field(c: *Checker, target: &Expr) -> bool = target.kind match
    Member(_, _) -> true
    Name(n) ->
        if lookup_local(c, n) is Some(_) || param_index(c, n) is Some(_) then return false
        class_member(c, n) match
            Some(FieldOf(_)) -> true
            Some(TraitFieldOf(m)) -> state_of_getter(c, m) is Some(_)
            _ -> false
    _ -> false

/** For the `val` a trait's field with a value is read through, the field. */
private state_of_getter(c: *Checker, m: usize) -> Option[TraitState]
    if !is_trait_field(c, m) then return None
    for s in c.classes[c.symbols[m].owner_class?].state
        if s.getter == m then return Some(s)
    None

// A trait's field assigned through the trait's type or a type parameter it bounds: through the
// method that assigns it in the object's own class. Only a `var` one is assigned; a `val` without a
// value is never assigned through the trait.
private trait_field_place(c: *Checker, target: &Expr, object: &TExpr, m: usize, name: string, through: string) -> Option[FieldPlace]
    val unit = unit_of(c)
    val owner = c.classes[c.symbols[m].owner_class.unwrap()].name
    val state = state_of_getter(c, m) match
        Some(s) -> s
        None ->
            c.note(unit, target.span, s"`$name` is a `val` of `$owner`, which is read through $through and never assigned")
            return None
    val setter = state.setter match
        Some(s) -> s
        None ->
            c.note(unit, target.span, s"`$name` is a `val` field of `$owner`; only a `var` field can be assigned")
            return None
    val ty = substitute(c.symbols[m].result.unwrap_or(ErrorType), class_owner(c.symbols[m].owner_class.unwrap()), receiver_type_args(c, object.ty, m))
    if object.kind is Local(_) || object.kind is Param(_) then return Some(FieldPlace(None, object, 0, ty, m, Some(setter)))
    val held = hidden_local(c, object.ty)
    Some(FieldPlace(Some(TExpr(object.span, Unit, Let(held, object))), TExpr(object.span, object.ty, Local(held)), 0, ty, m, Some(setter)))

/** The value a place holds now: its field, or for a trait's field seen through the trait, its
 * `val`. */
private place_read(c: *Checker, place: FieldPlace, at: Span) -> &TExpr
    if place.setter is None then return TExpr(at, place.ty, Field(place.object, place.index))
    var args: Buf[&TExpr] = buf()
    args.push(place.object)
    TExpr(at, place.ty, method_call_kind(c, place.object.ty, place.getter, args, receiver_type_args(c, place.object.ty, place.getter), false))

/** Stores `value` into a place; with `yields`, the store yields the value stored. */
private place_store(c: *Checker, place: FieldPlace, at: Span, value: &TExpr, yields: bool) -> &TExpr
    val ty: &Type = if *value.ty is Nothing then Nothing elif yields then place.ty else Unit
    val setter = place.setter match
        Some(s) -> s
        None -> return TExpr(at, ty, StoreField(place.object, place.index, value, yields))
    var items: Buf[&TExpr] = buf()
    var stored = value
    if yields
        val held = hidden_local(c, place.ty)
        items.push(TExpr(at, Unit, Let(held, value)))
        stored = TExpr(at, place.ty, Local(held))
    var args: Buf[&TExpr] = buf()
    args.push(place.object)
    args.push(stored)
    val call = TExpr(at, Unit, method_call_kind(c, place.object.ty, setter, args, receiver_type_args(c, place.object.ty, setter), false))
    if !yields then return TExpr(at, ty, call.kind)
    items.push(call)
    items.push(stored)
    TExpr(at, ty, Block(items))

// The field an assignment writes, after reporting why it cannot be written: it must be a `var`
// field, public unless the code is in its own class.
private field_place(c: *Checker, target: &Expr) -> Option[FieldPlace]
    val unit = unit_of(c)
    var object: &TExpr = TExpr(target.span, ErrorType, UnitConst)
    var k = 0usize
    var name = ""
    target.kind match
        Name(n) ->
            name = n
            object = self_ref(c, target.span)
            k = fields_class(c) match
                Some(x) -> x
                // In a method an impl adds to a trait, `self` is a `Self` the trait bounds.
                None -> return trait_field_place(c, target, object, bound_field(c, object.ty, n).unwrap(), n, "the trait")
        Member(t, n) ->
            name = n
            object = check_expr(c, t, None)
            *zonk(c, object.ty) match
                Class(id, _, _) -> k = id
                TypeVar(_, _, _) ->
                    if bound_field(c, object.ty, n) is Some(m) then return trait_field_place(c, target, object, m, n, s"`${type_name(object.ty)}`")
                    c.note(unit, target.span, s"${type_name(object.ty)} has no field `$n`")
                    return None
                ErrorType -> return None
                Nothing -> return None
                Data(_, _, _) ->
                    c.note(unit, target.span, "a field of a data value cannot be assigned; data values are immutable")
                    return None
                Tuple(_) ->
                    c.note(unit, target.span, "a part of a tuple cannot be assigned; tuples are immutable")
                    return None
                _ ->
                    c.note(unit, target.span, s"${type_name(object.ty)} has no field `$n`")
                    return None
        _ -> return None
    val cls = c.classes[k]
    val index = class_field(c, k, name) match
        Some(i) -> i
        None ->
            if trait_field_named(c, k, name) is Some(m) then return trait_field_place(c, target, object, m, name, s"`${cls.name}`")
            elif method_named(c, k, name) is Some(_) then c.note(unit, target.span, s"`$name` is a method of `${cls.name}`, which cannot be assigned")
            else c.note(unit, target.span, s"`${cls.name}` has no member `$name`")
            return None
    val field = cls.fields[index]
    if !field_visible(c, field)
        c.note(unit, target.span, s"`$name` is private to `${c.classes[field.owner].name}`")
        return None
    if !field.mutable
        if field.param then c.note(unit, target.span, s"`$name` is a class parameter, which cannot be assigned; declare it `var` to make it a mutable field")
        else c.note(unit, target.span, s"`$name` is a `val` field; only a `var` field can be assigned")
        return None
    if is_self(c, object) && c.current == cls.initializer && index >= cls.ready
        c.note(unit, target.span, s"`$name` is assigned before its declaration in the class body initializes it")
        return None
    val args = *zonk(c, object.ty) match
        Class(_, _, a) -> a
        _ -> buf()
    val ty = substitute(field_type(c, k, index, target.span), class_owner(k), args)
    if object.kind is Local(_) || object.kind is Param(_) then return Some(FieldPlace(None, object, index, ty, 0, None))
    val held = hidden_local(c, object.ty)
    Some(FieldPlace(Some(TExpr(object.span, Unit, Let(held, object))), TExpr(object.span, object.ty, Local(held)), index, ty, 0, None))

private assign_field(c: *Checker, e: &Expr, target: &Expr, op: Option[BinaryOp], value: &Expr, yields: bool, op_span: Span) -> &TExpr
    val place = field_place(c, target) match
        Some(p) -> p
        None ->
            check_statement(c, value)
            return TExpr(e.span, ErrorType, UnitConst)
    val current = place_read(c, place, target.span)
    if c.index is Some(_) then index_expr(c, target, current)
    val stored = op match
        Some(o) -> operate(c, e.span, op_span, o, binary_spelling(o) + (if yields then ":=" else "="), current, check_expr(c, value, Some(place.ty)))
        None ->
            val typed = check_expr(c, value, Some(place.ty))
            if !fits(c,typed.ty, place.ty)
                c.note(unit_of(c), value.span, s"expected ${type_name(place.ty)}, found ${type_name(typed.ty)}")
            typed
    place.wrap(e.span, place_store(c, place, e.span, stored, yields))

// `++` and `--` on a field: the field is read, stepped with the usual overflow check, and stored.
private update_field(c: *Checker, e: &Expr, target: &Expr, increment: bool, postfix: bool, op_span: Span) -> &TExpr
    val place = field_place(c, target) match
        Some(p) -> p
        None -> return TExpr(e.span, ErrorType, UnitConst)
    val ty = place.ty
    if !(*ty is Int(_) || *ty is ErrorType)
        c.note(unit_of(c), e.span, s"`${if increment then "++" else "--"}` needs an integer, not ${type_name(ty)}")
        return TExpr(e.span, ErrorType, UnitConst)
    val op = if increment then Add else Subtract
    val one = TExpr(op_span, ty, IntConst("1"))
    val current = place_read(c, place, target.span)
    if !postfix
        return place.wrap(e.span, place_store(c, place, e.span, TExpr(e.span, ty, Arith(op, current, one, op_span)), true))
    val old = hidden_local(c, ty)
    val previous = TExpr(target.span, ty, Local(old))
    var items: Buf[&TExpr] = buf()
    items.push(TExpr(e.span, Unit, Let(old, current)))
    items.push(place_store(c, place, e.span, TExpr(e.span, ty, Arith(op, previous, one, op_span)), false))
    items.push(previous)
    place.wrap(e.span, TExpr(e.span, ty, Block(items)))

// A module-level value or object named by a bare name, unless a local function of that name hides
// it or a declaration of a nearer module, the file's own over the core library's, shadows it.
global_named(c: *Checker, name: string) -> Option[usize]
    if local_function(c, name) is Some(_) then return None
    c.global_names.get(resolve_name(c, unit_of(c), name))

/** The variant a bare name refers to in the code being checked, if it refers to one. */
private variant_named(c: *Checker, name: string) -> Option[VariantRef] = c.variants.get(resolve_name(c, unit_of(c), name))

// A module-level value's type is its initializer's result: declared, or inferred by checking the
// initializer first, which is not possible while that initializer is itself being checked.
private global_type(c: *Checker, g: usize, at: Span) -> &Type
    val init = c.globals[g].init
    if c.symbols[init].result is Some(t) then return t
    if c.states[init] == 0
        check_function(c, init)
        return c.symbols[init].result.unwrap_or(ErrorType)
    val name = c.globals[g].name
    c.note(unit_of(c), at, s"the type of `$name` is needed while its initializer is checked; declare it, as in `val $name: int = …`")
    ErrorType

// A `lazy val` is read through its initializer's call, which the read makes when it is the first.
private global_read(c: *Checker, at: Span, g: usize) -> &TExpr
    val ty = global_type(c, g, at)
    val global = c.globals[g]
    if !global.lazy then return TExpr(at, ty, Global(g))
    TExpr(at, ty, LazyGlobal(g, TExpr(at, ty, Call(global.init, buf(), buf())), global.name))

// A value declared without a type takes its initializer's, which must be fully known.
private settle_global(c: *Checker, g: usize)
    val global = c.globals[g]
    if global.object is Some(_) then return
    val t = zonk(c, c.symbols[global.init].result.unwrap_or(ErrorType))
    if has_unknowns(t)
        c.note(global.unit, global.span, s"cannot infer the type of `${global.name}`; declare it, as in `val ${global.name}: int = …`")
        c.symbols[global.init].result = Some(ErrorType)
    else c.symbols[global.init].result = Some(t)

// Whether an assignment's target is a module-level value: a bare name that no local, parameter or
// member of the enclosing class hides.
private targets_global(c: *Checker, target: &Expr) -> Option[usize] = target.kind match
    Name(n) -> if lookup_local(c, n) is None && param_index(c, n) is None && class_member(c, n) is None then global_named(c, n) else None
    _ -> None

// Only a module-level `var` can be assigned.
private writable_global(c: *Checker, at: Span, g: usize) -> bool
    val global = c.globals[g]
    if global.object is Some(_) then c.note(unit_of(c), at, s"`${global.name}` is an object, which cannot be assigned")
    elif global.lazy then c.note(unit_of(c), at, s"`${global.name}` is a `lazy val`, computed once on its first read, which cannot be assigned")
    elif !global.mutable then c.note(unit_of(c), at, s"`${global.name}` is a module-level `val`; only a `var` can be assigned")
    else return true
    false

private assign_global(c: *Checker, e: &Expr, target: &Expr, g: usize, op: Option[BinaryOp], value: &Expr, yields: bool, op_span: Span) -> &TExpr
    if !writable_global(c, target.span, g)
        check_statement(c, value)
        return TExpr(e.span, ErrorType, UnitConst)
    val ty = global_type(c, g, target.span)
    val current = TExpr(target.span, ty, Global(g))
    if c.index is Some(_) then index_expr(c, target, current)
    val stored = op match
        Some(o) -> operate(c, e.span, op_span, o, binary_spelling(o) + (if yields then ":=" else "="), current, check_expr(c, value, Some(ty)))
        None ->
            val typed = check_expr(c, value, Some(ty))
            if !conforms(typed.ty, ty)
                c.note(unit_of(c), value.span, s"expected ${type_name(ty)}, found ${type_name(typed.ty)}")
            typed
    val result: &Type = if *stored.ty is Nothing then Nothing elif yields then ty else Unit
    TExpr(e.span, result, StoreGlobal(g, stored, yields))

// `++` and `--` on a module-level `var`: read, stepped with the usual overflow check, and stored.
private update_global(c: *Checker, e: &Expr, target: &Expr, g: usize, increment: bool, postfix: bool, op_span: Span) -> &TExpr
    if !writable_global(c, target.span, g) then return TExpr(e.span, ErrorType, UnitConst)
    val ty = global_type(c, g, target.span)
    if !(*ty is Int(_) || *ty is ErrorType)
        c.note(unit_of(c), e.span, s"`${if increment then "++" else "--"}` needs an integer, not ${type_name(ty)}")
        return TExpr(e.span, ErrorType, UnitConst)
    val op = if increment then Add else Subtract
    val one = TExpr(op_span, ty, IntConst("1"))
    val current = TExpr(target.span, ty, Global(g))
    if c.index is Some(_) then index_expr(c, target, current)
    if !postfix then return TExpr(e.span, ty, StoreGlobal(g, TExpr(e.span, ty, Arith(op, current, one, op_span)), true))
    val old = hidden_local(c, ty)
    val previous = TExpr(target.span, ty, Local(old))
    var items: Buf[&TExpr] = buf()
    items.push(TExpr(e.span, Unit, Let(old, current)))
    items.push(TExpr(e.span, Unit, StoreGlobal(g, TExpr(e.span, ty, Arith(op, previous, one, op_span)), false)))
    items.push(previous)
    TExpr(e.span, ty, Block(items))

/** One step of ordering the module-level values: what each value's initializer needs, and the
 * search's progress. `state` is 0 for a value not yet reached, 1 while the values it needs are being
 * ordered, and 2 once it has its place. */
private struct InitOrder
    needs: Buf[Buf[usize]]
    state: Buf[u8]
    path: Buf[usize]
    order: Buf[usize]

// Module-level values initialize before `main`, each after every value its initializer uses:
// directly, or in the functions it calls and the closures it makes, however deeply. Otherwise they
// keep their declaration order. A value that needs itself is a cycle, reported with the values it
// passes through.
// A call through a method table reaches the method the call names or any override of it: the method
// of that name in the same slot of any class's table. Every one counts as called.
private with_implementations(c: *Checker, uses: Uses) -> Uses
    var u = uses
    for i in 0..<u.dispatched.len()
        val name = c.symbols[u.dispatched[i]].decl.name
        val slot = u.dispatched_slots[i]
        for k in c.classes
            if slot < k.table.len()
                if k.table[slot] is Some(m)
                    if c.symbols[m].decl.name == name then add_function(&u, m)
        // A method table of a data type is called through a bound as well.
        for d in c.data
            if slot < d.table.len()
                if d.table[slot] is Some(m)
                    if c.symbols[m].decl.name == name then add_function(&u, m)
    // An operator on a data type or a class calls the core trait method in the type's table. A data
    // type's own operator is found in its table; the rest, which may be a class with subclasses, a
    // type parameter, `Any`, or an equality that compares fields and elements by their own methods,
    // reaches every method of that name.
    for i in 0..<u.operators.len()
        val name = u.operators[i]
        var own: Option[usize] = None
        if name != "equals"
            if *u.operator_types[i] is Data(id, _, _) then own = Some(id)
        if own is Some(d)
            add_named(c, &u, c.data[d].table, name)
        else
            for k in c.classes
                add_named(c, &u, k.table, name)
            for d in c.data
                add_named(c, &u, d.table, name)
    u

/** Records that the code may call each method of `table` named `name`. */
private add_named(c: *Checker, u: *Uses, table: Buf[Option[usize]], name: string)
    for entry in table
        if entry is Some(m)
            if c.symbols[m].decl.name == name then add_function(u, m)

private initialization_order(c: *Checker) -> Buf[usize]
    var direct: Buf[Option[Uses]] = buf()
    for b in c.bodies
        direct.push(b match
            Some(body) -> Some(with_implementations(c, uses_of(body)))
            None -> None)
    var o = InitOrder(buf(), buf(), buf(), buf())
    for g in c.globals
        o.needs.push(globals_reached(direct, g.init))
        o.state.push(0)
    // A `lazy val` has no place in the order: nothing reads it as a module-level value, since its
    // reads call its initializer, so the values that initializer needs are needed by its readers.
    for g in 0..<c.globals.len()
        if o.state[g] == 0 && !c.globals[g].lazy then order_global(c, &o, g)
    o.order

private order_global(c: *Checker, o: *InitOrder, g: usize)
    o.state.set(g, 1)
    o.path.push(g)
    for need in o.needs[g]
        if o.state[need] == 1 then report_cycle(c, o, need)
        elif o.state[need] == 0 then order_global(c, o, need)
    o.path.truncate(o.path.len() - 1)
    o.state.set(g, 2)
    o.order.push(g)

// The cycle runs from `start`, where it is on the path being ordered, to the path's end and back.
private report_cycle(c: *Checker, o: *InitOrder, start: usize)
    val first = c.globals[start]
    if o.path[o.path.len() - 1] == start
        c.note(first.unit, first.span, s"`${first.name}` is needed by its own initializer, directly or through the functions it calls")
        return
    var cycle = ""
    var on = false
    for g in o.path
        if g == start then on = true
        if on then cycle = cycle + s"`${c.globals[g].name}` → "
    c.note(first.unit, first.span, s"module-level values need one another to initialize: $cycle`${first.name}`")

// One function initializes every module-level value in order, storing each initializer's result.
// The program's `main` runs it before the entry.
private initializer(c: *Checker, all: Buf[usize], testing: bool) -> Option[usize]
    // A `@tests` file's values are the tests', and only a program built for its tests has them.
    var order: Buf[usize] = buf()
    for g in all
        if testing || !c.units[c.globals[g].unit].file.tests_only then order.push(g)
    if order.len() == 0 then return None
    val unit = c.units.len() - 1
    val module_name = c.units[unit].file.module_name
    val at = Span(0, 0)
    val id = c.symbols.len()
    val decl = Function(buf(), at, at, "<init>", buf(), buf(), None, None, buf())
    c.symbols.push(FunctionSymbol(unit, module_name, "<init>", decl, buf(), buf(), Some(Unit), None, None, buf(), buf(), buf(), false, false, false, buf(), None, id, buf(), None, false, true, "", None, false))
    var items: Buf[&TExpr] = buf()
    for g in order
        val init = c.globals[g].init
        val value = TExpr(at, c.symbols[init].result.unwrap_or(ErrorType), Call(init, buf(), buf()))
        items.push(TExpr(at, Unit, StoreGlobal(g, value, false)))
    c.states.push(2)
    c.bodies.push(Some(TExpr(at, Unit, Block(items))))
    c.locals.push(buf())
    Some(id)

private assign_expr(c: *Checker, e: &Expr, target: &Expr, op: Option[BinaryOp], value: &Expr, yields: bool, op_span: Span) -> &TExpr
    if op is Some(o)
        if !yields then return compound_assign(c, e, target, binary_spelling(o) + "=", op, value, op_span)
    assign_place(c, e, target, op, value, yields, op_span)

// `x op= y` calls `x`'s method named `op=` when the target's type has one, so `buffer += 3` adds to
// the buffer, which need not be a `var`. Otherwise it assigns: `op` is the language's operator
// (`n += 1`), or a method named by a symbol, and `xs ++= ys` is `xs = xs ++ ys`. The target's object
// and indices are evaluated once, before the method is chosen by the target's type.
private compound_assign(c: *Checker, e: &Expr, target: &Expr, spelling: string, op: Option[BinaryOp], value: &Expr, op_span: Span) -> &TExpr
    val unit = unit_of(c)
    var items: Buf[&Expr] = buf()
    var place = target
    target.kind match
        Name(_) -> ()
        Member(object, field) ->
            if !(object.kind is Name(_))
                val held = s"compound object ${op_span.start}"
                items.push(Expr(object.span, Binding(held, None, object, false)))
                place = Expr(target.span, Member(Expr(object.span, Name(held)), field))
        Call(callee, args) ->
            val h = held_element(Expr(op_span, UnitLit), callee, args, &items)
            place = Expr(target.span, Call(h.callee, h.args))
        _ -> return assign_place(c, e, target, op, value, false, op_span)
    val mark = c.body.visible.len()
    var typed: Buf[&TExpr] = buf()
    for item in items
        typed.push(check_statement(c, item))
    val before = c.units[unit].report.len()
    val current = check_expr(c, place, None)
    var result: &TExpr = TExpr(e.span, ErrorType, UnitConst)
    if c.units[unit].report.len() > before || *zonk(c, current.ty) is ErrorType
        check_statement(c, value)
    else
        val ms = methods_of(c, current.ty, spelling)
        if ms.len() > 0
            var args: Buf[Argument] = buf()
            args.push(Argument(value.span, None, value, false))
            if !takes_one_argument(c, ms) then result = infix_arity_error(c, e.span, op_span, target, spelling, ms, args)
            else result = call_method(c, e.span, op_span, current, spelling, ms, args, None, None, false)
        elif op is Some(o)
            // `x |= y` on a type with a method `|` and none `|=` is `x = x | y`, and `x <<= y` and
            // `x += y` are `x = x << y` and `x = x + y` the same way.
            if operator_method(c, o, current.ty) then result = assign_place(c, e, place, None, Expr(e.span, Binary(o, place, value, op_span)), false, op_span)
            else result = assign_place(c, e, place, op, value, false, op_span)
        else
            val name = spelling[0..<spelling.bytes.len - 1]
            if language_operator(name) || groups_right(name)
                c.note(unit, op_span, s"`${type_name(current.ty)}` has no method `$spelling`, and `$name` is not a method that `$spelling` can assign through")
                check_statement(c, value)
            else
                val combined = Expr(e.span, InfixCall(place, name, op_span, value))
                result = assign_place(c, e, place, None, combined, false, op_span)
    c.body.visible.truncate(mark)
    if typed.len() == 0 then return result
    typed.push(result)
    TExpr(e.span, result.ty, Block(typed))

private assign_place(c: *Checker, e: &Expr, target: &Expr, op: Option[BinaryOp], value: &Expr, yields: bool, op_span: Span) -> &TExpr
    if target.kind is Call(callee, args) then return check_form(c, element_assignment(e, callee, args, op, value, yields, op_span), None, yields)
    if targets_field(c, target) then return assign_field(c, e, target, op, value, yields, op_span)
    if targets_global(c, target) is Some(g) then return assign_global(c, e, target, g, op, value, yields, op_span)
    val unit = unit_of(c)
    val index = assignable(c, target) match
        Some(i) -> i
        None ->
            check_statement(c, value)
            return TExpr(e.span, ErrorType, UnitConst)
    val local = c.body.locals[index]
    val current = TExpr(target.span, local.ty, Local(index))
    if c.index is Some(_) then index_expr(c, target, current)
    val stored = op match
        Some(o) -> operate(c, e.span, op_span, o, binary_spelling(o) + (if yields then ":=" else "="), current, check_expr(c, value, Some(local.ty)))
        None ->
            val typed = check_expr(c, value, Some(local.ty))
            if !fits(c,typed.ty, local.ty)
                c.note(unit, value.span, s"expected ${type_name(local.ty)}, found ${type_name(typed.ty)}")
            typed
    val ty: &Type = if *stored.ty is Nothing then Nothing elif yields then local.ty else Unit
    TExpr(e.span, ty, Store(index, stored, yields))

// `xs(i) = v` calls `xs.update(i, v)`, as `xs(i)` calls `xs.apply(i)`. The compound forms, and the
// `:=` forms that yield the stored element, evaluate the sequence and the indices once each, into
// locals named so that no source name can equal them, then read the element, store, and for `:=`
// read the element back.
private element_assignment(e: &Expr, callee: &Expr, args: Buf[Argument], op: Option[BinaryOp], value: &Expr, yields: bool, op_span: Span) -> &Expr
    if op is None && !yields
        var all: Buf[Argument] = buf()
        for a in args do all.push(a)
        all.push(Argument(value.span, None, value, false))
        return Expr(e.span, Call(Expr(callee.span, Member(callee, "update")), all))
    var items: Buf[&Expr] = buf()
    val held = held_element(e, callee, args, &items)
    val current = Expr(held.callee.span, Call(held.callee, held.args))
    val stored: &Expr = op match
        Some(o) -> Expr(e.span, Binary(o, current, value, op_span))
        None -> value
    var all: Buf[Argument] = buf()
    for a in held.args do all.push(a)
    all.push(Argument(value.span, None, stored, false))
    items.push(Expr(e.span, Call(Expr(callee.span, Member(held.callee, "update")), all)))
    if yields then items.push(current)
    Expr(e.span, Block(items, !yields))

// `xs(i)++` and `xs(i)--`, as `xs(i) += 1` and `xs(i) -= 1`; the prefix form yields the new element
// and the postfix form the old one.
private element_update(e: &Expr, callee: &Expr, args: Buf[Argument], increment: bool, postfix: bool, op_span: Span) -> &Expr
    val op: BinaryOp = if increment then Add else Subtract
    val one = Expr(op_span, IntLit("1"))
    if !postfix then return element_assignment(e, callee, args, Some(op), one, true, op_span)
    var items: Buf[&Expr] = buf()
    val held = held_element(e, callee, args, &items)
    val old = s"element old ${e.span.start}"
    items.push(Expr(e.span, Binding(old, None, Expr(e.span, Call(held.callee, held.args)), false)))
    var all: Buf[Argument] = buf()
    for a in held.args do all.push(a)
    all.push(Argument(op_span, None, Expr(e.span, Binary(op, Expr(e.span, Name(old)), one, op_span)), false))
    items.push(Expr(e.span, Call(Expr(callee.span, Member(held.callee, "update")), all)))
    items.push(Expr(e.span, Name(old)))
    Expr(e.span, Block(items, false))

/** A sequence and its indices, each named by a hidden local. */
private struct HeldElement
    callee: &Expr
    args: Buf[Argument]

// Binds the sequence and each index to a hidden local, adding the bindings to `items`.
private held_element(e: &Expr, callee: &Expr, args: Buf[Argument], items: *Buf[&Expr]) -> HeldElement
    val seq = s"element seq ${e.span.start}"
    items.push(Expr(callee.span, Binding(seq, None, callee, false)))
    var held: Buf[Argument] = buf()
    for i in 0..<args.len()
        val name = s"element index ${e.span.start} $i"
        items.push(Expr(args[i].span, Binding(name, None, args[i].value, false)))
        held.push(Argument(args[i].span, args[i].name, Expr(args[i].span, Name(name)), args[i].block))
    HeldElement(Expr(callee.span, Name(seq)), held)

// The keys or the values of a map literal: each checked against `want`, the part of the pair the
// builder takes, or, where that is still open, checked on its own, all agreeing on one type as the
// branches of an `if` do, which then settles `want`.
private literal_parts(c: *Checker, exprs: Buf[&Expr], want: &Type, what: string) -> Buf[&TExpr]
    val unit = unit_of(c)
    var typed: Buf[&TExpr] = buf()
    val wanted = zonk(c, want)
    if !(*wanted is Var(_))
        for x in exprs
            val t = to_trait(c, check_expr(c, x, Some(wanted)), wanted)
            if !(*t.ty is Nothing) && !(*t.ty is ErrorType) && !fits(c, t.ty, wanted)
                c.note(unit, x.span, mismatch(c, wanted, t.ty))
                typed.push(TExpr(t.span, ErrorType, t.kind))
            else typed.push(t)
        return typed
    var agreed: Option[&Type] = None
    for x in exprs
        val t = check_expr(c, x, None)
        typed.push(t)
        agreed = agreed match
            None -> Some(t.ty)
            Some(so_far) -> join(c, so_far, t.ty) match
                Some(j) -> Some(j)
                None ->
                    c.note(unit, x.span, s"the $what of a map literal need a common type; ${type_name(zonk(c, so_far))} and ${type_name(zonk(c, t.ty))} have none")
                    Some(ErrorType)
    if agreed is Some(t) then unify(c, want, t)
    // A part of a narrower reference type is the agreed type as it is.
    val agreed_type = zonk(c, want)
    var out: Buf[&TExpr] = buf()
    for t in typed
        val same = same_type(zonk(c, t.ty), agreed_type) || *t.ty is Nothing || *t.ty is ErrorType
        out.push(if same then t else TExpr(t.span, agreed_type, t.kind))
    out

private is_collection_literal(e: &Expr) -> bool =e.kind is ListLit(_) || e.kind is SetLit(_) || e.kind is MapLit(_, _)

const MutableModule: string = "avin.collections.mutable"

// Which literal the library's collection `t` is written as: "sequence" for every `Seq`, "set" for
// the sets, immutable and mutable, the `Set` and `SortedSet` traits and the hash-based and tree sets
// among them, "map" for the maps likewise, and "" for any other
// type, a program's own collection included, which any literal its builder takes can build.
private collection_shape(c: *Checker, t: &Type) -> string
    if seq_element(c, t) is Some(_) then return "sequence"
    var module_name = ""
    var name = ""
    *t match
        Class(k, _, _) ->
            module_name = c.classes[k].module_name
            name = c.classes[k].name
        Data(d, _, _) ->
            module_name = c.data[d].module_name
            name = c.data[d].name
        _ -> return ""
    if module_name != CoreModule && module_name != MutableModule then return ""
    val core = module_name == CoreModule
    if name == "Set" || (core && (name == "HashSet" || name == "SortedSet" || name == "TreeSet")) then return "set"
    if name == "Map" || (core && (name == "HashMap" || name == "SortedMap" || name == "TreeMap")) then return "map"
    ""

// A collection literal is built with a builder, except where a `List` is expected (see
// `list_literal`): the collection the expected type names supplies one when its companion object has
// a `newBuilder` method, and otherwise the literal is the core library's `Vector` for a sequence
// literal `[a, b]`, its `Set` for a set literal `{a, b}` and its `Map` for a map literal
// `{k: v}`, whatever a collection of the program's own is called. A library collection is built only
// by the literal of its own shape, so `[1, 2]` where a `Set` is expected is reported; `{}` is the
// empty set or the empty map, as expected. The builder is held in a hidden local, given each element
// in order with `addOne` (a map literal's entries as `(key, value)` pairs), and its `result()` is the
// literal's value. The result is matched with the expected type first, directly or as the instance
// of it the collection is, so `val b: Buffer[byte] = [1, 2]` gives each element the expected type
// `byte`; without one, the elements are checked on their own and agree on a type as an `if`'s
// branches do, and a map literal's keys and its values each agree on theirs.
private collection_literal(c: *Checker, e: &Expr, shape: string, items: Buf[&Expr], values: Buf[&Expr], expected: Option[&Type]) -> &TExpr
    val unit = unit_of(c)
    val at = e.span
    var want: Option[&Type] = None
    if expected is Some(t) then want = Some(zonk(c, t))
    // A `List` is a data type, built from the back with `::`, which needs no builder.
    if want is Some(t)
        if is_list_type(c, t) && shape == "sequence" then return list_literal(c, e, items, expected)
    var collection: Option[usize] = None
    if want is Some(t)
        val companion = *t match
            Class(k, _, _) -> c.classes[k].companion
            Data(d, _, _) -> c.data[d].companion
            _ -> None
        if companion is Some(o)
            if methods_named(c, o, "newBuilder").len() > 0 then collection = Some(o)
        val wanted_shape = collection_shape(c, t)
        // `{}` is a set literal with nothing in it, and as such the empty map too.
        val fitting = wanted_shape == "" || wanted_shape == shape || (shape == "set" && items.len() == 0 && wanted_shape == "map")
        if !fitting
            val written = if wanted_shape == "sequence" then "`[a, b]`" elif wanted_shape == "set" then "`{a, b}`" else "`{k: v}`"
            c.note(unit, at, s"${type_name(t)} is a $wanted_shape, written as a $wanted_shape literal, $written, not a $shape literal")
            for item in items
                check_statement(c, item)
            for value in values
                check_statement(c, value)
            return TExpr(at, ErrorType, UnitConst)
    val from_expected = collection is Some(_)
    if collection is None
        val default_name = if shape == "sequence" then "Vector" elif shape == "set" then "Set" else "Map"
        if c.class_types.get(qualified(CoreModule, default_name)) is Some(k) then collection = c.classes[k].companion
        elif c.types.get(qualified(CoreModule, default_name)) is Some(d) then collection = c.data[d].companion
    val o = collection match
        Some(o) -> o
        None ->
            for item in items
                check_statement(c, item)
            for value in values
                check_statement(c, value)
            c.note(unit, at, s"a $shape literal needs the core library's `${if shape == "sequence" then "Vector" elif shape == "set" then "Set" else "Map"}`")
            return TExpr(at, ErrorType, UnitConst)
    val companion = global_read(c, at, c.classes[o].global.unwrap())
    // A `newBuilder` declared to return a `Builder` of the expected collection takes its type
    // arguments from it at the call, where bounds on them are checked: `Set.newBuilder[A: Eq + Hash]`
    // learns `A` from the `Set[int]` expected.
    var wanted_builder: Option[&Type] = None
    if want is Some(w)
        if from_expected
            if c.class_types.get(qualified(CoreModule, "Builder")) is Some(b)
                var args: Buf[&Type] = buf()
                args.push(fresh_var(c))
                args.push(w)
                wanted_builder = Some(Class(b, "Builder", args))
    // The builder's element type is open until the expected type or the elements settle it; an
    // empty literal with neither is reported as one.
    val first_unknown = c.unknowns.len()
    val builder = call_method(c, at, at, companion, "newBuilder", methods_named(c, o, "newBuilder"), buf(), None, wanted_builder, false)
    val example = if shape == "sequence" then "`val xs: Vector[int] = []`" elif shape == "set" then "`val s: Set[int] = {}`" else "`val m: Map[string, int] = {}`"
    for i in first_unknown..<c.unknowns.len()
        c.unknowns[i].message = s"cannot infer the element type of an empty collection literal; give it a type, as in $example"
    if *builder.ty is ErrorType
        for item in items
            check_statement(c, item)
        for value in values
            check_statement(c, value)
        return builder
    val held = hidden_local(c, builder.ty)
    val receiver = TExpr(at, builder.ty, Local(held))
    var steps: Buf[&TExpr] = buf()
    steps.push(TExpr(at, Unit, Let(held, builder)))
    val result = call_method(c, at, at, receiver, "result", methods_of(c, builder.ty, "result"), buf(), None, None, false)
    // The builder takes elements in, but the literal is only the collection it yields: an element
    // type that collection holds only where a value is read out is `Nothing` if nothing settles it,
    // so `[]` alone is a `Vector[Nothing]`, as `Vector.empty()` is, and `{}` alone, a `Set`, is not.
    for i in first_unknown..<c.unknowns.len()
        c.unknowns[i].covariant = occurrence(c, result.ty, c.unknowns[i].var_id, true) == 1
    if want is Some(w)
        if !unify(c, result.ty, w)
            if *w is Class(k, _, _)
                if ancestor_type(c.classes, c.data, zonk(c, result.ty), k) is Some(up) then unify(c, up, w)
    val adds = methods_of(c, builder.ty, "addOne")
    if adds.len() == 0
        c.note(unit, at, s"${type_name(builder.ty)} has no `addOne` method to take the literal's elements")
        return TExpr(at, ErrorType, UnitConst)
    val adding = method_signature(c, receiver, adds[0], ErrorType)
    if adding.params.len() != 1 || adding.known.len() != adding.type_params.len()
        c.note(unit, at, s"the `addOne` method of ${type_name(builder.ty)} does not take one element, so it cannot build a literal")
        return TExpr(at, ErrorType, UnitConst)
    val element = zonk(c, substitute(adding.params[0], adding.owner, adding.known))
    if shape == "map"
        val parts: Buf[&Type] = *element match
            Tuple(types) -> types
            _ -> buf()
        if parts.len() != 2
            c.note(unit, at, s"${type_name(builder.ty)} takes elements of type ${type_name(element)}, not `(key, value)` pairs, so a map literal cannot build it")
            for item in items
                check_statement(c, item)
            for value in values
                check_statement(c, value)
            return TExpr(at, ErrorType, UnitConst)
        val typed_keys = literal_parts(c, items, parts[0], "keys")
        val typed_values = literal_parts(c, values, parts[1], "values")
        var pair_types: Buf[&Type] = buf()
        pair_types.push(zonk(c, parts[0]))
        pair_types.push(zonk(c, parts[1]))
        val pair: &Type = Tuple(pair_types)
        for i in 0..<items.len()
            val span = items[i].span.to(values[i].span)
            var pair_parts: Buf[&Expr] = buf()
            pair_parts.push(items[i])
            pair_parts.push(values[i])
            var args: Buf[Argument] = buf()
            args.push(Argument(span, None, Expr(span, Tuple(pair_parts)), false))
            var typed_parts: Buf[&TExpr] = buf()
            typed_parts.push(typed_keys[i])
            typed_parts.push(typed_values[i])
            val failed = *typed_keys[i].ty is ErrorType || *typed_values[i].ty is ErrorType
            val never = *typed_keys[i].ty is Nothing || *typed_values[i].ty is Nothing
            var given: Buf[Option[&TExpr]] = buf()
            if never && !failed then given.push(Some(never_made(span, typed_parts)))
            else given.push(Some(TExpr(span, if failed then ErrorType else pair, Construct(0, typed_parts))))
            steps.push(method_call(c, span, span, receiver, adds[0], args, None, None, false, given))
    elif *element is Var(_)
        // No element type is expected, so the elements decide it.
        var typed: Buf[&TExpr] = buf()
        var agreed: Option[&Type] = None
        for item in items
            var t = check_expr(c, item, None)
            // An element that is an `Option[Nothing]` converts to the other elements' option, and the
            // elements before one of another option, to that, as the arms of a `match` do.
            if agreed is Some(so_far)
                t = none_as(c, t, so_far)
                if converts_none(c, so_far, t.ty)
                    for i in 0..<typed.len()
                        typed.set(i, none_as(c, typed[i], t.ty))
                    agreed = Some(t.ty)
            typed.push(t)
            agreed = agreed match
                None -> Some(t.ty)
                Some(so_far) -> join(c, so_far, t.ty) match
                    Some(j) -> Some(j)
                    None ->
                        c.note(unit, item.span, s"the elements of a collection literal need a common type; ${type_name(zonk(c, so_far))} and ${type_name(zonk(c, t.ty))} have none")
                        Some(ErrorType)
        if agreed is Some(t) then unify(c, element, t)
        for i in 0..<items.len()
            var args: Buf[Argument] = buf()
            args.push(Argument(items[i].span, None, items[i], false))
            var given: Buf[Option[&TExpr]] = buf()
            // An element of a narrower reference type is the agreed type as it is.
            val t = typed[i]
            val agreed_type = zonk(c, element)
            val same = same_type(zonk(c, t.ty), agreed_type) || *t.ty is Nothing || *t.ty is ErrorType
            given.push(Some(if same then t else TExpr(t.span, agreed_type, t.kind)))
            steps.push(method_call(c, items[i].span, items[i].span, receiver, adds[0], args, None, None, false, given))
    else
        for item in items
            var args: Buf[Argument] = buf()
            args.push(Argument(item.span, None, item, false))
            steps.push(call_method(c, item.span, item.span, receiver, "addOne", adds, args, None, None, false))
    // An element that never finishes means the collection is never made: the builder is made and
    // given the elements before it, and nothing after it is reached.
    for i in 1..<steps.len()
        if *steps[i].ty is Nothing
            steps.truncate(i + 1)
            return TExpr(at, Nothing, Block(steps))
    steps.push(result)
    val built = TExpr(at, zonk(c, result.ty), Block(steps))
    // Each step between making the builder and taking its result adds one element, its last
    // argument.
    var elements: Buf[&TExpr] = buf()
    for i in 1..<steps.len() - 1
        val args = steps[i].kind match
            Call(_, a, _) -> a
            Dispatch(_, _, a, _) -> a
            BoundCall(_, _, a, _) -> a
            _ -> return built
        if args.len() == 0 then return built
        elements.push(args[args.len() - 1])
    TExpr(at, built.ty, Collection(elements, built))

// A tuple's parts take their expected types from an expected tuple of the same size. A part that
// never finishes means the tuple is never made.
private tuple_expr(c: *Checker, e: &Expr, items: Buf[&Expr], expected: Option[&Type]) -> &TExpr
    var wants: Buf[&Type] = buf()
    if expected is Some(t)
        if *zonk(c, t) is Tuple(types)
            if types.len() == items.len() then wants = types
    var typed: Buf[&TExpr] = buf()
    var types: Buf[&Type] = buf()
    var never = false
    var failed = false
    for i in 0..<items.len()
        val t = check_expr(c, items[i], if wants.len() > 0 then Some(wants[i]) else None)
        if *t.ty is Nothing then never = true
        if *t.ty is ErrorType then failed = true
        typed.push(t)
        types.push(t.ty)
    if never && !failed then return never_made(e.span, typed)
    TExpr(e.span, if failed then ErrorType else Tuple(types), Construct(0, typed))

// A value that is never made, since one of its parts never finishes: the parts are evaluated in
// order up to that one, and nothing after it is reached.
private never_made(at: Span, parts: Buf[&TExpr]) -> &TExpr
    var run: Buf[&TExpr] = buf()
    for p in parts
        run.push(p)
        if *p.ty is Nothing then break
    TExpr(at, Nothing, Block(run))

// `t.0` reads a part of a tuple by its position.
private tuple_index(c: *Checker, e: &Expr, target: &Expr, index: usize) -> &TExpr
    val t = check_expr(c, target, None)
    *zonk(c, t.ty) match
        Tuple(types) ->
            if index < types.len() then return TExpr(e.span, types[index], Field(t, index))
            c.note(unit_of(c), e.span, s"${type_name(t.ty)} has ${count(types.len(), "part")}, numbered from 0, so it has no part $index")
        ErrorType -> ()
        Nothing -> return t
        _ -> c.note(unit_of(c), e.span, s"`.$index` reads a part of a tuple, and ${type_name(t.ty)} is not one")
    TExpr(e.span, ErrorType, UnitConst)

// `val a, b = value`: the pattern must match every value of the value's type, since a binding has
// no other way to go. A `var` makes every name it binds assignable.
private destructure_expr(c: *Checker, e: &Expr, pattern: &Pattern, declared: Option[&TypeExpr], value: &Expr, mutable: bool) -> &TExpr
    val unit = unit_of(c)
    var want: Option[&Type] = None
    if declared is Some(d) then want = Some(resolve_type(c, unit, d))
    val typed = check_expr(c, value, want)
    var ty = typed.ty
    if want is Some(w)
        if !fits(c,typed.ty, w) then c.note(unit, value.span, s"expected ${type_name(w)}, found ${type_name(typed.ty)}")
        ty = w
    val outer = c.binds_var
    c.binds_var = mutable
    val shape = check_pattern(c, pattern, ty, "")
    c.binds_var = outer
    if settled(ty) && settled(shape.ty)
        var arms: Buf[TArm] = buf()
        arms.push(TArm(shape, None, TExpr(e.span, Unit, UnitConst)))
        if !match_covers(arms, ty, c.data)
            c.note(unit, pattern.span, s"a binding's pattern must match every ${type_name(ty)} value; take the value apart with `match`")
    TExpr(e.span, if *typed.ty is Nothing then Nothing else Unit, LetPattern(shape, typed))

// `a, b = x, y` and its compound forms. Every place is read, then the whole value is made, and only
// then is anything stored, so `a, b = b, a` swaps. A target `_` discards its part.
private multi_assign_expr(c: *Checker, e: &Expr, targets: Buf[&Expr], op: Option[BinaryOp], value: &Expr, op_span: Span) -> &TExpr
    val unit = unit_of(c)
    var locals: Buf[Option[usize]] = buf()
    var types: Buf[Option[&Type]] = buf()
    // A field is stored through a hidden local the multiple store writes, then copied into the field;
    // the object it belongs to is held first, before anything is read.
    var fields: Buf[Option[FieldPlace]] = buf()
    var block: Buf[&TExpr] = buf()
    var ok = true
    for t in targets
        if t.kind is Name("_")
            if op is Some(o)
                c.note(unit, t.span, s"`${binary_spelling(o)}=` reads every place before writing it, and `_` has nothing to read")
                ok = false
            locals.push(None)
            types.push(None)
            fields.push(None)
            continue
        if targets_field(c, t)
            field_place(c, t) match
                Some(place) ->
                    if place.setup is Some(s) then block.push(s)
                    locals.push(Some(hidden_local(c, place.ty)))
                    types.push(Some(place.ty))
                    fields.push(Some(place))
                None ->
                    ok = false
                    locals.push(None)
                    types.push(None)
                    fields.push(None)
            continue
        fields.push(None)
        assignable(c, t) match
            Some(i) ->
                locals.push(Some(i))
                types.push(Some(c.body.locals[i].ty))
            None ->
                ok = false
                locals.push(None)
                types.push(None)
    // Each place's current value, read before anything on the right is evaluated.
    var olds: Buf[Option[usize]] = buf()
    if op is Some(_)
        for i in 0..<locals.len()
            locals[i] match
                Some(local) ->
                    val ty = c.body.locals[local].ty
                    val old = hidden_local(c, ty)
                    val current: &TExpr = fields[i] match
                        Some(place) -> place_read(c, place, targets[i].span)
                        None -> TExpr(targets[i].span, ty, Local(local))
                    block.push(TExpr(e.span, Unit, Let(old, current)))
                    olds.push(Some(old))
                None -> olds.push(None)
    // The parts of the value: checked one by one against their places when it is written as a tuple,
    // and otherwise read from the tuple it makes.
    var parts: Buf[&TExpr] = buf()
    var never = false
    if value.kind is Tuple(items)
        if items.len() != targets.len()
            c.note(unit, value.span, s"this assigns ${count(targets.len(), "place")} from ${count(items.len(), "value")}")
            ok = false
        for i in 0..<items.len()
            val want = if i < types.len() then types[i] else None
            val t = check_expr(c, items[i], want)
            if *t.ty is Nothing then never = true
            if op is Some(_)
                val part = hidden_local(c, t.ty)
                block.push(TExpr(t.span, Unit, Let(part, t)))
                parts.push(TExpr(t.span, t.ty, Local(part)))
            else parts.push(t)
    else
        val whole = check_expr(c, value, None)
        if *whole.ty is Nothing then never = true
        *zonk(c, whole.ty) match
            Tuple(item_types) ->
                if item_types.len() != targets.len()
                    c.note(unit, value.span, s"this assigns ${count(targets.len(), "place")} from a tuple of ${item_types.len()}")
                    ok = false
                else
                    val held = hidden_local(c, whole.ty)
                    block.push(TExpr(value.span, Unit, Let(held, whole)))
                    for i in 0..<item_types.len()
                        parts.push(TExpr(value.span, item_types[i], Field(TExpr(value.span, whole.ty, Local(held)), i)))
            ErrorType -> ok = false
            Nothing -> ()
            _ ->
                c.note(unit, value.span, s"a multiple assignment takes its values from a tuple, not ${type_name(whole.ty)}")
                ok = false
    if !ok then return TExpr(e.span, ErrorType, UnitConst)
    if never then return TExpr(e.span, Nothing, Block(block))
    // Each stored value: the part itself, or the place's old value combined with it.
    var stored: Buf[&TExpr] = buf()
    var stored_types: Buf[&Type] = buf()
    for i in 0..<parts.len()
        val part = parts[i]
        var result = part
        types[i] match
            Some(ty) ->
                op match
                    Some(o) ->
                        val old = TExpr(targets[i].span, ty, Local(olds[i].unwrap()))
                        result = operate(c, targets[i].span, op_span, o, binary_spelling(o) + "=", old, part)
                    None ->
                        if !fits(c,part.ty, ty) then c.note(unit, part.span, s"expected ${type_name(ty)}, found ${type_name(part.ty)}")
            None -> ()
        stored.push(result)
        stored_types.push(result.ty)
    block.push(TExpr(e.span, Unit, MultiStore(locals, TExpr(value.span, Tuple(stored_types), Construct(0, stored)))))
    for i in 0..<fields.len()
        if fields[i] is Some(place)
            val held = TExpr(targets[i].span, place.ty, Local(locals[i].unwrap()))
            block.push(place_store(c, place, targets[i].span, held, false))
    TExpr(e.span, Unit, Block(block))

/** A local the compiler introduces to hold a value for a moment; no name reaches it. */
private hidden_local(c: *Checker, ty: &Type) -> usize
    val index = c.body.locals.len()
    c.body.locals.push(TLocal("", ty, false, c.current))
    index

private update_expr(c: *Checker, e: &Expr, target: &Expr, increment: bool, postfix: bool, op_span: Span) -> &TExpr
    if target.kind is Call(callee, args) then return check_form(c, element_update(e, callee, args, increment, postfix, op_span), None, true)
    if targets_field(c, target) then return update_field(c, e, target, increment, postfix, op_span)
    if targets_global(c, target) is Some(g) then return update_global(c, e, target, g, increment, postfix, op_span)
    val index = assignable(c, target) match
        Some(i) -> i
        None -> return TExpr(e.span, ErrorType, UnitConst)
    val ty = c.body.locals[index].ty
    if !(*ty is Int(_) || *ty is ErrorType)
        c.note(unit_of(c), e.span, s"`${if increment then "++" else "--"}` needs an integer, not ${type_name(ty)}")
        return TExpr(e.span, ErrorType, UnitConst)
    TExpr(e.span, ty, Step(index, increment, postfix, op_span))

// An integer literal, possibly negated, takes its type from context rather than giving one.
private is_literal(e: &Expr) -> bool = e.kind match
    IntLit(_) -> true
    Unary(Negate, operand) -> operand.kind is IntLit(_)
    _ -> false

private settled(t: &Type) -> bool = !(*t is ErrorType || *t is Nothing)

private expect_bool(c: *Checker, t: &TExpr)
    if !fits(c,t.ty, Bool) then c.note(unit_of(c), t.span, s"expected bool, found ${type_name(t.ty)}")

// The type an operator's operands are checked against: the type the operation is expected to have,
// except where that is a trait or `Any`. A value is converted to those after it is computed, so an
// operand written for `println(1 + 2, 3)` is an integer, not a `Display`.
private operand_hint(c: *Checker, expected: Option[&Type]) -> Option[&Type]
    if expected is Some(t)
        val w = zonk(c, t)
        if is_trait_type(c, w) || *w is AnyType then return None
    expected

private unary_expr(c: *Checker, e: &Expr, op: UnaryOp, operand: &Expr, wanted: Option[&Type]) -> &TExpr
    val expected = operand_hint(c, wanted)
    if op is Not then return check_condition(c, e).expr
    if op is Negate && operand.kind is IntLit(spelling)
        return integer_literal(c, e.span, spelling, true, expected)
    if op is Negate && operand.kind is RealLit(value) then return TExpr(e.span, Real, RealConst(-value))
    val x = check_expr(c, operand, expected)
    // On a data type, a class or a type parameter with a method `-` taking no argument, `-a` calls it.
    if op is Negate && has_operator_traits(zonk(c, x.ty)) && settled(zonk(c, x.ty))
        val ms = methods_of(c, zonk(c, x.ty), "-")
        if takes_no_argument(c, ms) then return call_method(c, e.span, e.span, x, "-", ms, buf(), None, wanted, false)
    // Otherwise `-` is `Neg`'s `negate` there.
    if op is Negate && has_operator_traits(zonk(c, x.ty))
        if !operator_conforms(c, e.span, "-", zonk(c, x.ty), "Neg") then return TExpr(e.span, ErrorType, UnitConst)
        return TExpr(e.span, zonk(c, x.ty), Negate(x))
    // `-` and `+` apply to integers and reals, `~` to integers and bytes.
    val fits_op = *x.ty match
        Int(_) -> true
        Real -> !(op is Complement)
        Byte -> op is Complement
        _ -> !settled(x.ty)
    if !fits_op
        val wanted = if op is Complement then "an integer or a byte" else "a number"
        c.note(unit_of(c), e.span, s"`${unary_spelling(op)}` needs $wanted, not ${type_name(x.ty)}")
        return TExpr(e.span, ErrorType, UnitConst)
    op match
        Negate -> TExpr(e.span, x.ty, Negate(x))
        Complement -> TExpr(e.span, x.ty, Complement(x))
        _ -> x

// The operand that is not a bare literal is checked first, so a literal on either side takes the
// other operand's type: in `1 + x` with `x: i8`, the `1` is an `i8`.
private binary_expr(c: *Checker, e: &Expr, op: BinaryOp, left: &Expr, right: &Expr, op_span: Span, wanted: Option[&Type]) -> &TExpr
    if op is And || op is Or then return check_condition(c, e).expr
    val expected = operand_hint(c, wanted)
    if is_literal(left) && !is_literal(right)
        val r = check_expr(c, right, expected)
        return operate(c, e.span, op_span, op, binary_spelling(op), check_expr(c, left, Some(r.ty)), r)
    val l = check_expr(c, left, expected)
    if operator_method(c, op, l.ty) then return operator_method_call(c, e.span, op_span, left, l, binary_spelling(op), right, expected)
    operate(c, e.span, op_span, op, binary_spelling(op), l, check_expr(c, right, Some(l.ty)))

/** Whether `a op b` with `a` of type `t` calls `a`'s method named `op`. `op` is `&`, `^`, `|`, `<<` or
 * `>>`, and `t` is not an integer or a byte, whose bitwise and shift operators are the machine's, but
 * has such a method; or `op` is `+`, `-`, `*`, `/` or `%`, and `t` is a data type, a class or a type
 * parameter with a method of that name taking one argument. Where it has none, the operator is its
 * core trait's. */
private operator_method(c: *Checker, op: BinaryOp, t: &Type) -> bool
    val known = zonk(c, t)
    if !settled(known) then return false
    val name = binary_spelling(op)
    if op is BitAnd || op is BitOr || op is BitXor || op is ShiftLeft || op is ShiftRight
        if *known is Int(_) || *known is Byte then return false
        return methods_of(c, known, name).len() > 0
    if !arithmetic_method_name(name) || !has_operator_traits(known) then return false
    takes_one_argument(c, methods_of(c, known, name))

// `a | b` on a type with a method `|` is the call `a.|(b)`, as a symbol method's infix call is, and
// `a + b` on a type with a method `+` is `a.+(b)`.
private operator_method_call(c: *Checker, at: Span, op_span: Span, left: &Expr, receiver: &TExpr, name: string, right: &Expr, expected: Option[&Type]) -> &TExpr
    val ms = methods_of(c, receiver.ty, name)
    var args: Buf[Argument] = buf()
    args.push(Argument(right.span, None, right, false))
    if !takes_one_argument(c, ms) then return infix_arity_error(c, at, op_span, left, name, ms, args)
    call_method(c, at, op_span, receiver, name, ms, args, None, expected, false)

// Arithmetic, bitwise and shift operators take two operands of one type and yield that type.
// Integers have them all; reals have arithmetic; bytes have bitwise operators and shifts. `at` is
// the whole operation, which diagnostics point at; `op_at` is its operator, where a trap is reported.
private operate(c: *Checker, at: Span, op_at: Span, op: BinaryOp, spelling: string, left: &TExpr, right: &TExpr) -> &TExpr
    val l = settle_operand(c, left, right)
    val r = settle_operand(c, right, l)
    if !settled(l.ty) || !settled(r.ty)
        // An operand that never finishes means the operation never finishes.
        val ty: &Type = if *l.ty is ErrorType || *r.ty is ErrorType then ErrorType else Nothing
        return TExpr(at, ty, Arith(op, l, r, op_at))
    if *l.ty is Str && *r.ty is Str
        if op is Add then return TExpr(at, Str, Arith(op, l, r, op_at))
        c.note(unit_of(c), at, s"`$spelling` is not defined on strings; `+` joins two strings")
        return TExpr(at, ErrorType, UnitConst)
    if *l.ty is Str && op is Add || *r.ty is Str && op is Add
        val other = if *l.ty is Str then r.ty else l.ty
        c.note(unit_of(c), at, s"`+` joins two strings, not a string and ${type_name(other)}")
        return TExpr(at, ErrorType, UnitConst)
    val numeric = *l.ty is Int(_) || *l.ty is Real || *l.ty is Byte
    // On a type parameter, a data type or a class, an arithmetic operator is its core trait's method.
    if !numeric && has_operator_traits(zonk(c, l.ty))
        if binary_operator_method(op) is Some(om)
            if !same_type(zonk(c, l.ty), zonk(c, r.ty))
                c.note(unit_of(c), at, s"`$spelling` needs two values of one type, not ${type_name(l.ty)} and ${type_name(r.ty)}")
                return TExpr(at, ErrorType, UnitConst)
            if !operator_conforms(c, at, spelling, zonk(c, l.ty), om.trait_name) then return TExpr(at, ErrorType, UnitConst)
            return TExpr(at, zonk(c, l.ty), Arith(op, l, r, op_at))
        // `&`, `^`, `|`, `<<` and `>>` on such a type are methods of those names, which this one lacks.
        if op is BitAnd || op is BitOr || op is BitXor || op is ShiftLeft || op is ShiftRight
            c.note(unit_of(c), at, s"`${type_name(zonk(c, l.ty))}` has no method `$spelling`")
            return TExpr(at, ErrorType, UnitConst)
    if !numeric || !same_type(l.ty, r.ty)
        c.note(unit_of(c), at, s"`$spelling` needs two numbers of one type, not ${type_name(l.ty)} and ${type_name(r.ty)}")
        return TExpr(at, ErrorType, UnitConst)
    val bitwise = op is BitAnd || op is BitOr || op is BitXor || op is ShiftLeft || op is ShiftRight
    val arithmetic = op is Add || op is Subtract || op is Multiply || op is Divide || op is Remainder
    if *l.ty is Byte && !bitwise
        c.note(unit_of(c), at, s"`$spelling` is not defined on byte, which has bitwise operators and no arithmetic")
        return TExpr(at, ErrorType, UnitConst)
    if *l.ty is Real && !arithmetic
        c.note(unit_of(c), at, s"`$spelling` is not defined on real")
        return TExpr(at, ErrorType, UnitConst)
    TExpr(at, l.ty, Arith(op, l, r, op_at))

/** Whether a value of type `t` takes its operators from the core traits rather than the machine: a
 * type parameter, a data type or a class. */
private has_operator_traits(t: &Type) -> bool = *t match
    TypeVar(_, _, _) -> true
    Data(_, _, _) -> true
    Class(_, _, _) -> true
    _ -> false

private compare_expr(c: *Checker, e: &Expr, operands: Buf[&Expr], ops: Buf[CompareOp]) -> &TExpr
    var early: Buf[Option[&TExpr]] = buf()
    var anchor: Option[&Type] = None
    // `a < b` alone, on a type with a method `<` taking one argument, calls it, whatever it yields.
    var first: Option[&TExpr] = None
    if ops.len() == 1 && ordering_op(ops[0]) && !is_literal(operands[0]) && !is_collection_literal(operands[0])
        val l = check_expr(c, operands[0], None)
        if ordering_method(c, ops[0], l.ty) then return operator_method_call(c, e.span, e.span, operands[0], l, compare_spelling(ops[0]), operands[1], None)
        first = Some(l)
    // A number or collection literal takes its type from another operand: `xs == [1, 2]` builds the
    // collection `xs` is.
    for o in operands
        if is_literal(o) || is_collection_literal(o) then early.push(None)
        else
            val t = if early.len() == 0 && first is Some(_) then first.unwrap() else check_expr(c, o, None)
            if anchor is None && settled(t.ty) then anchor = Some(t.ty)
            early.push(Some(t))
    var typed: Buf[&TExpr] = buf()
    for i in 0..<operands.len()
        early[i] match
            Some(t) -> typed.push(t)
            None -> typed.push(check_expr(c, operands[i], anchor))
    // `==` between an `Any` and a value of another type compares the value as an `Any`.
    if ops.len() == 1 && (ops[0] is Equal || ops[0] is NotEqual)
        val x = zonk(c, typed[0].ty)
        val y = zonk(c, typed[1].ty)
        if *x is AnyType && settled(y) && !(*y is AnyType) then typed.set(1, to_any(c, typed[1]))
        elif *y is AnyType && settled(x) && !(*x is AnyType) then typed.set(0, to_any(c, typed[0]))
        // and between a trait's value and a built-in value or a tuple implementing it, as the trait's.
        elif settled(y) then typed.set(1, to_trait(c, typed[1], x))
        if settled(x) then typed.set(0, to_trait(c, typed[0], zonk(c, typed[1].ty)))
        // and between an `Option[Nothing]` and another option, as the other.
        typed.set(0, none_as(c, typed[0], typed[1].ty))
        typed.set(1, none_as(c, typed[1], typed[0].ty))
    for i in 0..<ops.len()
        compare_link(c, ops[i], typed[i], typed[i + 1])
    var ty: &Type = Bool
    for t in typed
        if *t.ty is Nothing then ty = Nothing
    TExpr(e.span, ty, Compare(typed, ops))

private ordering_op(op: CompareOp) -> bool = op is Less || op is LessEqual || op is Greater || op is GreaterEqual

/** Whether `a op b` with `a` of type `t` calls `a`'s method named `op`: `op` is `<`, `<=`, `>` or
 * `>=`, and `t` is a data type, a class or a type parameter with a method of that name taking one
 * argument. Where it has none, the comparison is `Ord`'s. */
private ordering_method(c: *Checker, op: CompareOp, t: &Type) -> bool
    val known = zonk(c, t)
    settled(known) && has_operator_traits(known) && takes_one_argument(c, methods_of(c, known, compare_spelling(op)))

private is_trait_type(c: *Checker, t: &Type) -> bool = *t match
    Class(id, _, _) -> is_trait(c, id)
    _ -> false

/** `operand` with its type as known now. An operand whose type is still unknown, such as the value
 * a `Some(n)` pattern binds from a `var best = None`, takes the other operand's type: an operator
 * is a use that settles it. */
private settle_operand(c: *Checker, operand: &TExpr, other: &TExpr) -> &TExpr
    val t = zonk(c, operand.ty)
    if !(*t is Var(_)) then return if same_type(t, operand.ty) then operand else TExpr(operand.span, t, operand.kind)
    val o = zonk(c, other.ty)
    if *o is Var(_) || !settled(o) then return operand
    unify(c, t, o)
    TExpr(operand.span, o, operand.kind)

private compare_link(c: *Checker, op: CompareOp, left: &TExpr, right: &TExpr)
    val a = settle_operand(c, left, right)
    val b = settle_operand(c, right, a)
    if !settled(a.ty) || !settled(b.ty) then return
    val at = a.span.to(b.span)
    val spelling = compare_spelling(op)
    val identity = op is Same || op is NotSame
    if op is Equal || op is NotEqual then return equality_link(c, at, spelling, zonk(c, a.ty), zonk(c, b.ty))
    if !identity then return ordering_link(c, at, spelling, zonk(c, a.ty), zonk(c, b.ty))
    // An `Any` may hold a value with no identity; a type pattern recovers its type.
    if *a.ty is AnyType || *b.ty is AnyType
        c.note(unit_of(c), at, s"`$spelling` on Any is not implemented; match the value by its type first, as in `s: string`")
        return
    // A function value is a closure and an object of a class is a heap object: both are
    // references, which `===` compares by identity.
    if (*a.ty is Function(_, _) || *a.ty is Class(_, _, _)) && same_type(a.ty, b.ty) then return
    // An instance of a subclass may be the very object a superclass-typed value holds.
    if *a.ty is Class(_, _, _) && *b.ty is Class(_, _, _)
        if same_type(upcast(c, a.ty, b.ty), b.ty) || same_type(upcast(c, b.ty, a.ty), a.ty) then return
        c.note(unit_of(c), at, s"`$spelling` cannot compare ${type_name(a.ty)} with ${type_name(b.ty)}")
        return
    if *a.ty is Function(_, _) || *a.ty is Class(_, _, _)
        c.note(unit_of(c), at, s"`$spelling` cannot compare ${type_name(a.ty)} with ${type_name(b.ty)}")
        return
    c.note(unit_of(c), at, s"`$spelling` compares identities, and ${type_name(a.ty)} values have none")

// Every type has `==`, so two values compare when they have a common type: one type, or a class or
// trait one is an instance of, or two sequences of one element type. On `Any` and on trait types the comparison is decided at run time by
// the values' own types. A value of a type parameter compares through a bound that is `Eq` or
// requires it.
private equality_link(c: *Checker, at: Span, spelling: string, x: &Type, y: &Type)
    if *x is AnyType && *y is AnyType then return
    // A value of a type parameter's lower bound is a value of the parameter, so `v == x` compares an
    // option's `T` with a `T1 >: T`.
    if *x is TypeVar(_, _, _) || *y is TypeVar(_, _, _)
        if !same_type(x, y) && !fits(c, x, y) && !fits(c, y, x)
            c.note(unit_of(c), at, s"`$spelling` cannot compare ${type_name(x)} with ${type_name(y)}")
            return
        operator_conforms(c, at, spelling, x, "Eq")
        return
    if *x is AnyType || *y is AnyType
        c.note(unit_of(c), at, s"`$spelling` cannot compare ${type_name(x)} with ${type_name(y)} in a chain; compare them on their own")
        return
    if same_type(x, y) || fits(c, x, y) || fits(c, y, x) then return
    // Two sequences of one element type compare by their elements, whichever kinds they are.
    if seq_element(c, x) is Some(a)
        if seq_element(c, y) is Some(b)
            if same_type(zonk(c, a), zonk(c, b)) then return
    c.note(unit_of(c), at, s"`$spelling` cannot compare ${type_name(x)} with ${type_name(y)}")

// `<`, `<=`, `>` and `>=` are `Ord`'s: the numbers, chars, bytes and strings have them, and a type
// parameter, a data type or a class through `Ord`.
private ordering_link(c: *Checker, at: Span, spelling: string, x: &Type, y: &Type)
    // A method `<` is a call of its own, which may yield anything, and so is not a link of a chain.
    if has_operator_traits(x) && takes_one_argument(c, methods_of(c, x, spelling))
        c.note(unit_of(c), at, s"`$spelling` is a method of ${type_name(x)}, and a comparison by a method does not chain; join the comparisons with `&&`")
        return
    if !same_type(x, y)
        c.note(unit_of(c), at, s"`$spelling` cannot compare ${type_name(x)} with ${type_name(y)}")
        return
    *x match
        Int(_) -> ()
        Byte -> ()
        Char -> ()
        Real -> ()
        Str -> ()
        TypeVar(_, _, _) -> operator_conforms(c, at, spelling, x, "Ord")
        Data(_, _, _) -> operator_conforms(c, at, spelling, x, "Ord")
        Class(_, _, _) -> operator_conforms(c, at, spelling, x, "Ord")
        Tuple(_) -> operator_conforms(c, at, spelling, x, "Ord")
        _ -> c.note(unit_of(c), at, s"`$spelling` cannot compare ${type_name(x)} values")

// Whether a value of type `t` has an operator through the core trait `trait_name`: its type conforms
// to the trait, or for a type parameter, one of its bounds does. Reports it where it does not.
private operator_conforms(c: *Checker, at: Span, spelling: string, t: &Type, trait_name: string) -> bool
    val bound = core_trait_type(c, trait_name) match
        Some(b) -> b
        None ->
            c.note(unit_of(c), at, s"`$spelling` on ${type_name(t)} needs the core library's `$trait_name`")
            return false
    if conforms_to_bound(c, t, bound) then return true
    // Every type has `==` and a hash, so a type parameter and a trait's `Self` have them without a bound.
    if *t is TypeVar(_, _, _)
        if trait_name == "Eq" || trait_name == "Hash" then return true
    if *t is TypeVar(_, _, name)
        c.note(unit_of(c), at, s"`$spelling` on `$name` needs a bound that is `$trait_name` or requires it, as in `[$name: $trait_name]`")
    else c.note(unit_of(c), at, s"`$spelling` needs ${type_name(t)} to implement `$trait_name`")
    false

// `p"a${x}b"` is the method call `StringContext(["a", "b"]).p(x)`, the parts as written. `s"…"` and
// `f"…"` are written out directly instead, to the text that call makes (see `formatted_text`).
private interpolate_expr(c: *Checker, e: &Expr, prefix: string, chunks: Buf[string], parts: Buf[string], holes: Buf[&Expr], expected: Option[&Type]) -> &TExpr
    val unit = unit_of(c)
    if prefix != "s" && prefix != "f"
        c.hidden_module = ""
        val found = interpolators_named(c, e.span, prefix)
        val hidden = c.hidden_module
        if found.len() == 0
            for h in holes
                check_statement(c, h)
            return TExpr(e.span, ErrorType, UnitConst)
        val before = c.reported_count
        val result = check_expr(c, interpolator_call(e.span, prefix, parts, holes), expected)
        // Where a call fails and another module also declares an interpolator of the name, which
        // the file does not import, the error is followed by the module that would be imported.
        if hidden != "" && c.reported_count > before
            c.note(unit, e.span, s"another interpolator `$prefix\"…\"` is declared in ${module_label(hidden)}, which this file does not import; add `import $hidden`")
        return result
    formatted_text(c, e, prefix == "f", chunks, holes)

/** What an `f"…"` specifier writes after its hole's `%`: the flags, the width and the precision, each
 * as digits or as a hole of its own, and the conversion, the character after them, empty when the
 * text ends first. */
struct Specifier
    left: bool
    plus: bool
    space: bool
    zero: bool
    alternate: bool
    width: string
    width_hole: Option[&TExpr]
    precision: string
    precision_hole: Option[&TExpr]
    conversion: string

// `s"…"` and `f"…"` are written out to calls on one `StringWriter`, made for the literal: each
// decoded piece of text is written to it, each hole is rendered into it by its `display` (by its
// `debug` under `%?`) in the field its specifier describes, and its text is the value. A string hole
// with no specifier is written as it is. Each hole is evaluated once, left to right, just before it
// is rendered; a hole that never finishes leaves the literal never finishing. In an `f"…"` literal, a
// `%` right after a hole begins that hole's specifier, checked here against the hole's type; any
// other `%` is text.
private formatted_text(c: *Checker, e: &Expr, specifiers: bool, chunks: Buf[string], holes: Buf[&Expr]) -> &TExpr
    val at = e.span
    var typed: Buf[&TExpr] = buf()
    for h in holes
        typed.push(check_expr(c, h, None))
    val writer = check_expr(c, Expr(at, Call(Expr(at, Name(core_path("StringWriter"))), buf())), None)
    if *writer.ty is ErrorType then return writer
    val held = hidden_local(c, writer.ty)
    var items: Buf[&Expr] = buf()
    items.push(checked_slot(c, TExpr(at, Unit, Let(held, writer))))
    var ok = true
    var text = chunks[0]
    var k = 0usize
    while k < typed.len()
        val value = typed[k]
        var rest = chunks[k + 1]
        k += 1
        if text != "" then items.push(writer_call(c, at, held, writer.ty, "write", Expr(at, StringLit(text)), None))
        var spec: Option[Specifier] = None
        if specifiers && rest.bytes.len > 0 && rest.bytes[0] == u8('%')
            var p = Specifier(false, false, false, false, false, "", None, "", None, "")
            var b = rest.bytes
            var i = 1usize
            while i < b.len && is_format_flag(b[i])
                if b[i] == u8('-') then p.left = true
                if b[i] == u8('+') then p.plus = true
                if b[i] == u8(' ') then p.space = true
                if b[i] == u8('0') then p.zero = true
                if b[i] == u8('#') then p.alternate = true
                i += 1
            if i == b.len && k < typed.len()
                p.width_hole = Some(typed[k])
                rest = chunks[k + 1]
                k += 1
                b = rest.bytes
                i = 0
            else
                val from = i
                while i < b.len && b[i] >= u8('0') && b[i] <= u8('9') do i += 1
                p.width = from_utf8_unchecked(b[from..<i])
            if i < b.len && b[i] == u8('.')
                i += 1
                if i == b.len && k < typed.len()
                    p.precision_hole = Some(typed[k])
                    rest = chunks[k + 1]
                    k += 1
                    b = rest.bytes
                    i = 0
                else
                    val from = i
                    while i < b.len && b[i] >= u8('0') && b[i] <= u8('9') do i += 1
                    p.precision = if i == from then "0" else from_utf8_unchecked(b[from..<i])
            if i < b.len
                val from = i
                i += 1
                while i < b.len && b[i] & u8(0xC0) == u8(0x80) do i += 1
                p.conversion = from_utf8_unchecked(b[from..<i])
            rest = from_utf8_unchecked(b[i..<b.len])
            spec = Some(p)
        text = rest
        if *value.ty is ErrorType
            ok = false
            continue
        if *value.ty is Nothing
            items.push(checked_slot(c, value))
            continue
        spec match
            None ->
                if *value.ty is Str
                    items.push(writer_call(c, at, held, writer.ty, "write", checked_slot(c, value), None))
                elif implements_display(c, value)
                    items.push(rendered(c, at, held, writer.ty, value, "display", Expr(at, Call(Expr(at, Name(core_path("FormatSpec"))), buf()))))
                else ok = false
            Some(p) -> specified(c, value, p) match
                Some(layout) -> items.push(rendered(c, at, held, writer.ty, value, if p.conversion == "?" then "debug" else "display", layout))
                None -> ok = false
    if text != "" then items.push(writer_call(c, at, held, writer.ty, "write", Expr(at, StringLit(text)), None))
    if !ok then return TExpr(at, ErrorType, UnitConst)
    items.push(Expr(at, Call(Expr(at, Member(checked_slot(c, TExpr(at, writer.ty, Local(held))), "text")), buf())))
    check_expr(c, block_of(at, items), None)

private is_format_flag(b: u8) -> bool = b == u8('-') || b == u8('+') || b == u8(' ') || b == u8('0') || b == u8('#')

// Written code that stands for `t`, already checked.
private checked_slot(c: *Checker, t: &TExpr) -> &Expr
    val slot = Expr(t.span, Checked(c.checked_slots.len()))
    c.checked_slots.push(t)
    slot

// `out.name(arg)` on the literal's writer, held in local `held`.
private writer_call(c: *Checker, at: Span, held: usize, ty: &Type, name: string, arg: &Expr, second: Option[&Expr]) -> &Expr
    var args: Buf[Argument] = buf()
    args.push(Argument(at, None, arg, false))
    if second is Some(s) then args.push(Argument(at, None, s, false))
    Expr(at, Call(Expr(at, Member(checked_slot(c, TExpr(at, ty, Local(held))), name)), args))

// `value.method(out, layout)`: the hole rendered into the literal's writer.
private rendered(c: *Checker, at: Span, held: usize, ty: &Type, value: &TExpr, method: string, layout: &Expr) -> &Expr
    var args: Buf[Argument] = buf()
    args.push(Argument(at, None, checked_slot(c, TExpr(at, ty, Local(held))), false))
    args.push(Argument(at, None, layout, false))
    Expr(at, Call(Expr(at, Member(checked_slot(c, value), method)), args))

// Whether the hole's type implements `Display`, reporting why not when it does not.
private implements_display(c: *Checker, h: &TExpr) -> bool
    val t = zonk(c, h.ty)
    core_trait(c, "Display") match
        Some(display) ->
            if conforms_to_bound(c, t, display) then return true
            c.note(unit_of(c), h.span, s"`${type_name(t)}` does not implement `Display`, so it cannot be interpolated${underived_reason(c, t, "Display")}")
            false
        None ->
            c.note(unit_of(c), h.span, "the core library declares no `Display`")
            false

private core_trait(c: *Checker, name: string) -> Option[&Type]
    val id = c.class_types.get(qualified(CoreModule, name))?
    Some(Class(id, name, buf()))

// Whether `t` is an integer: one of the integer widths, or a type parameter bounded by `Integer`.
private integer_type(c: *Checker, t: &Type) -> bool = *t match
    Int(_) -> true
    TypeVar(_, _, _) -> core_trait(c, "Integer") match
        Some(integer) -> conforms_to_bound(c, t, integer)
        None -> false
    _ -> false

// The `FormatSpec` an `f"…"` specifier describes, after checking it against the hole it follows: the
// conversion is one the hole's type takes, each flag has an effect under it, and a width or precision
// written as a hole is an integer. `None` when it has been reported.
private specified(c: *Checker, value: &TExpr, p: Specifier) -> Option[&Expr]
    val unit = unit_of(c)
    val at = value.span
    val t = zonk(c, value.ty)
    val letter = p.conversion
    if letter == ""
        c.note(unit, at, "this format specifier has no conversion: a `%` right after a hole begins one, such as `%d` or `%s`")
        return None
    // The flags each conversion has a use for, beside `-`, which every one takes.
    var signs = false
    var zeros = false
    var alternate = false
    var wanted = ""
    var fits = false
    if letter == "d" || letter == "i"
        signs = true
        zeros = true
        wanted = "an integer"
        fits = integer_type(c, t) || *t is Byte
    elif letter == "x" || letter == "X" || letter == "o" || letter == "b"
        signs = true
        zeros = true
        alternate = true
        wanted = "an integer"
        fits = integer_type(c, t) || *t is Byte
    elif letter == "f" || letter == "e" || letter == "g" || letter == "E" || letter == "G"
        signs = true
        zeros = true
        alternate = true
        wanted = "a real"
        fits = *t is Real
    elif letter == "c"
        wanted = "a char"
        fits = *t is Char
    elif letter == "s"
        wanted = "a string or another value that is not a number"
        fits = !(integer_type(c, t) || *t is Byte || *t is Real)
    elif letter == "?"
        fits = true
    elif letter == "u"
        c.note(unit, at, "`%u` is not a format conversion: integers are signed, so `%d` writes every one")
        return None
    else
        c.note(unit, at, s"`%$letter` is not a format conversion: the conversions are `d`, `i`, `x`, `X`, `o`, `b`, `f`, `e`, `g`, `E`, `G`, `c`, `s` and `?`")
        return None
    if !fits
        c.note(unit, at, s"format `%$letter` expects $wanted, but the value has type `${type_name(t)}`")
        return None
    var ok = true
    if p.plus && !signs then ok = no_effect(c, at, "the flag `+`", letter)
    if p.space && !signs then ok = no_effect(c, at, "the space flag", letter)
    if p.zero && !zeros then ok = no_effect(c, at, "the flag `0`", letter)
    if p.alternate && !alternate then ok = no_effect(c, at, "the flag `#`", letter)
    if letter == "c" && (p.precision != "" || p.precision_hole is Some(_))
        c.note(unit, at, "`%c` takes no precision")
        ok = false
    if letter == "?"
        core_trait(c, "Debug") match
            Some(debug) ->
                if !conforms_to_bound(c, t, debug)
                    c.note(unit, at, s"`${type_name(t)}` does not implement `Debug`, so `%?` cannot show it${underived_reason(c, t, "Debug")}")
                    ok = false
            None -> ok = false
    elif !implements_display(c, value) then ok = false
    if !count_fits(c, at, p.width, "width") then ok = false
    if !count_fits(c, at, p.precision, "precision") then ok = false
    if !count_hole_fits(c, p.width_hole) then ok = false
    if !count_hole_fits(c, p.precision_hole) then ok = false
    if !ok then return None
    var args: Buf[Argument] = buf()
    if p.width != "" then args.push(Argument(at, Some("width"), Expr(at, IntLit(p.width)), false))
    if p.precision != "" then args.push(Argument(at, Some("precision"), Expr(at, IntLit(p.precision)), false))
    if p.left then args.push(Argument(at, Some("left"), Expr(at, BoolLit(true)), false))
    if p.zero then args.push(Argument(at, Some("zeroPad"), Expr(at, BoolLit(true)), false))
    if p.plus then args.push(Argument(at, Some("plus"), Expr(at, BoolLit(true)), false))
    if p.space then args.push(Argument(at, Some("space"), Expr(at, BoolLit(true)), false))
    if p.alternate then args.push(Argument(at, Some("alternate"), Expr(at, BoolLit(true)), false))
    args.push(Argument(at, Some("conversion"), Expr(at, CharLit(char(u32(letter.bytes[0])))), false))
    var layout = Expr(at, Call(Expr(at, Name(core_path("FormatSpec"))), args))
    if p.width_hole is Some(h)
        var counted: Buf[Argument] = buf()
        counted.push(Argument(h.span, None, checked_slot(c, h), false))
        layout = Expr(at, Call(Expr(at, Member(layout, "withWidth")), counted))
    if p.precision_hole is Some(h)
        var counted: Buf[Argument] = buf()
        counted.push(Argument(h.span, None, checked_slot(c, h), false))
        layout = Expr(at, Call(Expr(at, Member(layout, "withPrecision")), counted))
    Some(layout)

private no_effect(c: *Checker, at: Span, flag: string, letter: string) -> bool
    c.note(unit_of(c), at, s"$flag has no effect under `%$letter`")
    false

// Whether a width or precision written in digits fits an `int`, reporting it when it does not.
private count_fits(c: *Checker, at: Span, digits: string, what: string) -> bool
    var n: long = 0
    for d in digits.bytes
        n = n * 10 + long(d - u8('0'))
        if n > 2147483647
            c.note(unit_of(c), at, s"a format $what is at most 2147483647")
            return false
    true

// Whether a width or precision written as a hole is an integer, reporting it when it is not.
private count_hole_fits(c: *Checker, hole: Option[&TExpr]) -> bool
    val h = hole match
        Some(x) -> x
        None -> return true
    val t = zonk(c, h.ty)
    if integer_type(c, t) || *t is ErrorType || *t is Nothing then return true
    c.note(unit_of(c), h.span, s"a width or precision written as a hole is a count, so it has to be an integer, but this one has type `${type_name(t)}`")
    false

// The interpolators `name` this unit may use: the methods of `StringContext` called `name` that are
// the core library's, or are declared in this file's module or one it imports, whole or by a name. Where
// there are none, the error is reported here, naming the module to import where one declares it, and
// the list is empty.
private interpolators_named(c: *Checker, at: Span, name: string) -> Buf[usize]
    var seen: Buf[usize] = buf()
    val id = c.types.get(qualified(CoreModule, "StringContext")) match
        Some(k) -> k
        None -> return seen
    val ty = Data(id, "StringContext", buf())
    val unit = unit_of(c)
    var elsewhere: Buf[string] = buf()
    for m in with_trait_methods(c, ty, name, visible_methods(c, receiver_methods(c, ty, name)))
        val home = c.symbols[m].module_name
        if home == CoreModule || sees_module(c, unit, home) then seen.push(m)
        else
            var known = false
            for h in elsewhere
                if h == home then known = true
            if !known then elsewhere.push(home)
    if seen.len() > 0
        if elsewhere.len() > 0 then c.hidden_module = elsewhere[0]
        return seen
    if elsewhere.len() > 0
        c.note(unit, at, s"the interpolator `$name\"…\"` is declared in ${module_label(elsewhere[0])}, which this file does not import; add `import ${elsewhere[0]}`")
    else c.note(unit, at, s"`$name\"…\"` names no interpolator: `StringContext` has no method `$name` here")
    seen

// `StringContext([parts…]).prefix(holes…)`, naming the core library's `StringContext` whatever the
// file calls its own declarations.
private interpolator_call(at: Span, prefix: string, parts: Buf[string], holes: Buf[&Expr]) -> &Expr
    var texts: Buf[&Expr] = buf()
    for part in parts
        texts.push(Expr(at, StringLit(part)))
    var made: Buf[Argument] = buf()
    made.push(Argument(at, None, Expr(at, ListLit(texts)), false))
    val context = Expr(at, Call(Expr(at, Name(core_path("StringContext"))), made))
    var args: Buf[Argument] = buf()
    for h in holes
        args.push(Argument(h.span, None, h, false))
    Expr(at, Call(Expr(at, Member(context, prefix)), args))

// The type two branches agree on; where they have none (see `join`), the type expected of them,
// when both conform to it: two classes sharing several unrelated traits agree on one of them only
// where it is asked for.
private join_expected(c: *Checker, a: &Type, b: &Type, expected: Option[&Type]) -> Option[&Type]
    if join(c, a, b) is Some(t) then return Some(t)
    val want = expected?
    if fits(c, a, want) && fits(c, b, want) then Some(want) else None

// The type two branches, or two arguments given one type parameter, agree on, where one that never
// finishes agrees with anything. Two instances of classes agree on their nearest common ancestor
// class; where they have none, on the one trait they share that is more specific than every other
// they share (see `shared_traits`). Two instances of one generic type agree on the instance whose
// covariant arguments are their arguments' agreement.
private join(c: *Checker, a: &Type, b: &Type) -> Option[&Type]
    val t = joined(c, a, b)?
    // Each side is taken as the type they agree on with no conversion, as an upcast is.
    if !same_type(zonk(c, a), zonk(c, t)) && !through_lowers(c, zonk(c, a), zonk(c, t)) then c.views.push(TypeView(a, t))
    if !same_type(zonk(c, b), zonk(c, t)) && !through_lowers(c, zonk(c, b), zonk(c, t)) then c.views.push(TypeView(b, t))
    Some(t)

private joined(c: *Checker, a: &Type, b: &Type) -> Option[&Type]
    if *a is Nothing || *a is ErrorType then return Some(b)
    if *b is Nothing || *b is ErrorType then return Some(a)
    if same_type(a, b) then return Some(a)
    var current = zonk(c, a)
    // An unknown branch, such as a `None` whose type argument is still open, takes the other's type.
    if *current is Var(_) || *zonk(c, b) is Var(_)
        return if unify(c, current, b) then Some(zonk(c, current)) else None
    // A type parameter with a lower bound agrees with what the bound admits, as the parameter.
    if lower_join(c, current, zonk(c, b)) is Some(t) then return Some(t)
    if *current is Data(_, _, _) then return join_args(c, current, zonk(c, b))
    val start = current
    var climbing = true
    while climbing
        val k = *current match
            Class(k, _, args) -> k
            _ -> return None
        if ancestor_type(c.classes, c.data, zonk(c, b), k) is Some(up)
            if same_type(up, current) then return Some(current)
            if join_args(c, current, up) is Some(t) then return Some(t)
        ancestor_parent(c, current) match
            Some(up) -> current = up
            None -> climbing = false
    val traits = shared_traits(c, start, zonk(c, b))
    if traits.len() == 1 then Some(traits[0]) else None

// The traits two instances of classes both conform to, each as the instance they agree on, less
// those another of them conforms to: of `Named` and `Pet: Named`, only `Pet`. Two classes with no
// common superclass join to the trait when exactly one remains; where several unrelated ones
// remain, no single one is the answer, and the type has to be written.
private shared_traits(c: *Checker, a: &Type, b: &Type) -> Buf[&Type]
    var shared: Buf[&Type] = buf()
    if !(*a is Class(_, _, _)) || !(*b is Class(_, _, _)) then return shared
    var mine: Buf[&Type] = buf()
    if *a is Class(k, _, _)
        if is_trait(c, k) then mine.push(a)
    collect_traits(c, a, &mine)
    for r in mine
        if *r is Class(k, _, _)
            if ancestor_type(c.classes, c.data, b, k) is Some(up)
                if same_type(up, r) then shared.push(r)
                elif join_args(c, r, up) is Some(t) then shared.push(t)
    var nearest: Buf[&Type] = buf()
    for i in 0..<shared.len()
        var wider = false
        if *shared[i] is Class(k, _, _)
            for j in 0..<shared.len()
                if j != i
                    if ancestor_type(c.classes, c.data, shared[j], k) is Some(_) then wider = true
        if !wider then nearest.push(shared[i])
    nearest

// The instance of one generic type that two of its instances agree on: equal invariant arguments,
// and covariant arguments that are references agreeing on a type.
private join_args(c: *Checker, a: &Type, b: &Type) -> Option[&Type]
    val (params, xs, ys) = *a match
        Data(d, _, xs) -> *b match
            Data(e, _, ys) -> if d == e then (c.data[d].decl.type_params, xs, ys) else return None
            _ -> return None
        Class(k, _, xs) -> *b match
            Class(j, _, ys) -> if k == j then (c.classes[k].decl.type_params, xs, ys) else return None
            _ -> return None
        _ -> return None
    if xs.len() != ys.len() || xs.len() != params.len() then return None
    var args: Buf[&Type] = buf()
    for i in 0..<xs.len()
        if same_type(xs[i], ys[i])
            args.push(xs[i])
            continue
        // An argument still unknown on one side is settled as the other side's: the branches of
        // `if c then Some(dog) else None` agree on `Option[Dog]`.
        if *zonk(c, xs[i]) is Var(_) || *zonk(c, ys[i]) is Var(_)
            if !unify(c, xs[i], ys[i]) then return None
            args.push(zonk(c, xs[i]))
            continue
        if params[i].variance is Covariant
            // No value has type `Nothing`, so `Option[Nothing]` and `Option[Dog]` agree on the latter.
            if *zonk(c, xs[i]) is Nothing
                args.push(ys[i])
                continue
            if *zonk(c, ys[i]) is Nothing
                args.push(xs[i])
                continue
            if lower_join(c, zonk(c, xs[i]), zonk(c, ys[i])) is Some(t)
                args.push(t)
                continue
        if !(params[i].variance is Covariant) || !is_reference(xs[i]) || !is_reference(ys[i]) then return None
        args.push(join(c, xs[i], ys[i])?)
    *a match
        Data(d, name, _) -> Some(Data(d, name, args))
        Class(k, name, _) -> Some(Class(k, name, args))
        _ -> None

// The type parameter of `a` and `b` that the other is a value of through its lower bound, if either
// is: `W` for `W >: T` and `T`.
private lower_join(c: *Checker, a: &Type, b: &Type) -> Option[&Type]
    val f = conformances(c)
    if *a is TypeVar(_, _, _) && below_lower(f, b, a) then return Some(a)
    if *b is TypeVar(_, _, _) && below_lower(f, a, b) then return Some(b)
    None

/** The superclass of an instance's class, as the instance's type, if it has one. */
private ancestor_parent(c: *Checker, t: &Type) -> Option[&Type] = *t match
    Class(k, _, args) -> Some(substitute(c.classes[k].superclass?, class_owner(k), args))
    _ -> None

/** `from` as the type `to` asks for, where a value of `from` is one of `to` (see `view_as`);
 * otherwise `from` itself, or a type that differs from `to`. */
private upcast(c: *Checker, from: &Type, to: &Type) -> &Type
    val x = zonk(c, from)
    val up = viewed(c, x, to)
    if !same_type(x, zonk(c, up)) && !through_lowers(c, x, zonk(c, up)) then c.views.push(TypeView(x, up))
    up

// Whether `up` differs from `x` only where a type parameter's lower bound is seen as the parameter,
// as `self`, an `Option[T]`, is returned as an `Option[B]` for `B >: T`. Each call states that view
// at the type arguments it gives (see `hold_to_bounds`), so the generic code's own view says nothing
// more about what values meet.
private through_lowers(c: *Checker, x: &Type, up: &Type) -> bool
    if same_type(x, up) then return true
    if *up is TypeVar(_, _, _)
        return type_var_lower(conformances(c), up) match
            Some(l) -> same_type(x, l)
            None -> false
    *up match
        Data(d, _, ys) -> *x match
            Data(e, _, xs) -> d == e && all_through_lowers(c, xs, ys)
            _ -> false
        Class(k, _, ys) -> *x match
            Class(j, _, xs) -> k == j && all_through_lowers(c, xs, ys)
            _ -> false
        Tuple(ys) -> *x match
            Tuple(xs) -> all_through_lowers(c, xs, ys)
            _ -> false
        _ -> false

private all_through_lowers(c: *Checker, xs: Buf[&Type], ys: Buf[&Type]) -> bool
    if xs.len() != ys.len() then return false
    for i in 0..<xs.len()
        if !through_lowers(c, zonk(c, xs[i]), zonk(c, ys[i])) then return false
    true

private viewed(c: *Checker, x: &Type, to: &Type) -> &Type
    // Every value converts to `Any`, by boxing where it is written; never inside a tuple or as a
    // type argument, whose parts are already laid out.
    if *zonk(c, to) is AnyType && !(*x is Var(_) || *x is ByName(_)) then return AnyType
    // A value of a type parameter is an instance of its bounds.
    if *x is TypeVar(_, _, _)
        if *zonk(c, to) is Class(k, _, _)
            for b in bounds_of(c, x)
                if holding_ancestor(conformances(c), b, k) is Some(_) then return view_as(conformances(c), b, zonk(c, to))
        if *zonk(c, to) is Function(_, _)
            for b in bounds_of(c, x)
                if function_ancestor(c.classes, c.data, b) is Some(_) then return view_as(conformances(c), b, zonk(c, to))
    view_as(conformances(c), x, zonk(c, to))

/** Whether a value of type `from` may be used where `to` is expected: an instance of a subclass is an
 * instance of its superclass, and an instance of a generic type one of another instance as its
 * parameters' variance allows, also inside a tuple or a function type. */
private fits(c: *Checker, from: &Type, to: &Type) -> bool
    val up = upcast(c, from, to)
    if conforms(up, zonk(c, to)) then return true
    // A use settles what is still unknown: an `Option[_]` stored where an `Option[int]` is
    // expected is one.
    if has_unknowns(zonk(c, up)) || has_unknowns(zonk(c, to)) then unify(c, up, to) else false

private if_expr(c: *Checker, e: &Expr, condition: &Expr, yes: &Expr, no: Option[&Expr], expected: Option[&Type], used: bool) -> &TExpr
    val tested = check_condition(c, condition)
    val cond = tested.expr
    expect_bool(c, cond)
    val other = no match
        Some(n) -> n
        None ->
            // Without `else` the branch's value is discarded and the `if` yields unit. After a
            // branch that never finishes, the code that follows runs only where the condition failed.
            val y = tested_branch(c, yes, tested.yes, None, false)
            if *y.ty is Nothing then bring_into_scope(c, condition.span, tested.no)
            return TExpr(e.span, Unit, If(cond, y, None))
    var y = tested_branch(c, yes, tested.yes, expected, used)
    var n = tested_branch(c, other, tested.no, expected, used)
    if used
        // A branch that is an `Option[Nothing]` converts to the other's option.
        y = none_as(c, y, n.ty)
        n = none_as(c, n, y.ty)
    if *y.ty is Nothing && !(*n.ty is Nothing) then bring_into_scope(c, condition.span, tested.no)
    elif *n.ty is Nothing && !(*y.ty is Nothing) then bring_into_scope(c, condition.span, tested.yes)
    var ty: &Type = Unit
    if *y.ty is Nothing && *n.ty is Nothing then ty = Nothing
    elif used
        join_expected(c, y.ty, n.ty, expected) match
            Some(t) -> ty = t
            None ->
                c.note(unit_of(c), e.span, s"the branches of this `if` yield ${type_name(y.ty)} and ${type_name(n.ty)}")
                ty = ErrorType
    TExpr(e.span, ty, If(cond, y, Some(n)))

// A loop yields unit, or with an `else`, the value its `else` and every `break` agree on. A
// `while true` that no `break` leaves never finishes.
private while_expr(c: *Checker, e: &Expr, condition: &Expr, body: &Expr, otherwise: Option[&Expr], expected: Option[&Type], used: bool) -> &TExpr
    val unit = unit_of(c)
    val tested = check_condition(c, condition)
    val cond = tested.expr
    expect_bool(c, cond)
    val label = c.body.labels
    c.body.labels += 1
    // Only a loop with an `else` yields its `break`s' values.
    c.body.loop_expected.push(if otherwise is Some(_) && used then expected else None)
    c.body.loops.push(label)
    val b = tested_branch(c, body, tested.yes, None, false)
    c.body.loops.truncate(c.body.loops.len() - 1)
    var other: Option[&TExpr] = None
    var ty: &Type = Unit
    if otherwise is Some(o)
        // The `else` runs once the test has failed.
        val t = tested_branch(c, o, tested.no, expected, used)
        other = Some(t)
        ty = t.ty
    var broken = false
    for site in c.body.breaks
        if site.label != label then continue
        broken = true
        if other is None
            if !(*site.ty is Unit || *site.ty is ErrorType)
                c.note(unit, site.span, "a `break` with a value needs its loop to have an `else`")
        elif used
            join_expected(c, ty, site.ty, expected) match
                Some(t) -> ty = t
                None -> c.note(unit, site.span, s"this `break` yields ${type_name(site.ty)}, but the loop yields ${type_name(ty)}")
    if !used then ty = Unit
    if !broken && cond.kind is BoolConst(true) then ty = Nothing
    TExpr(e.span, ty, While(label, cond, b, other))

// A `loop` is left only by a `break`, so it yields what its `break`s agree on, and never finishes
// when none exists. It is lowered as a `while` whose condition always holds.
private loop_expr(c: *Checker, e: &Expr, body: &Expr, expected: Option[&Type], used: bool) -> &TExpr
    val label = c.body.labels
    c.body.labels += 1
    c.body.loop_expected.push(if used then expected else None)
    c.body.loops.push(label)
    val b = branch(c, body, None, false)
    c.body.loops.truncate(c.body.loops.len() - 1)
    var ty: &Type = Nothing
    var broken = false
    for site in c.body.breaks
        if site.label != label then continue
        if !broken
            ty = site.ty
            broken = true
        else
            join(c, ty, site.ty) match
                Some(t) -> ty = t
                None -> c.note(unit_of(c), site.span, s"this `break` yields ${type_name(site.ty)}, but the loop yields ${type_name(ty)}")
    TExpr(e.span, ty, While(label, TExpr(e.span, Bool, BoolConst(true)), b, None))

// `do body while test else other` is a `while` whose first test passes without being evaluated, so
// the body runs once before the test and a `continue` in it reaches the test. A flag declared just
// outside the loop, named so that no source name can equal it, is cleared by that first test.
private do_while_form(e: &Expr, body: &Expr, condition: &Expr, otherwise: Option[&Expr]) -> &Expr
    val flag = s"do first ${e.span.start}"
    val here = condition.span
    val clear = Expr(here, Assign(Expr(here, Name(flag)), None, Expr(here, BoolLit(false)), false, here))
    var first: Buf[&Expr] = buf()
    first.push(clear)
    first.push(Expr(here, BoolLit(true)))
    val test = Expr(here, If(Expr(here, Name(flag)), Expr(here, Block(first, false)), Some(condition)))
    var items: Buf[&Expr] = buf()
    items.push(Expr(here, Binding(flag, None, Expr(here, BoolLit(true)), true)))
    items.push(Expr(e.span, While(test, body, otherwise)))
    Expr(e.span, Block(items, false))

// `a..b` and `a..<b` written as values make the core library's `Range` where the bounds are `int`s
// and its `NumericRange` where they are any other integer type, by the constructor, with a step of
// one. Each bound is evaluated once, left to right, and an integer literal takes its type from the
// other bound.
private range_expr(c: *Checker, e: &Expr, lower: &Expr, upper: &Expr, inclusive: bool) -> &TExpr
    val unit = unit_of(c)
    val at = e.span
    val tag = s"${at.start}"
    val mark = c.body.visible.len()
    val literal_first = is_literal(lower) && !is_literal(upper)
    var lo: &TExpr = TExpr(at, ErrorType, UnitConst)
    var hi: &TExpr = TExpr(at, ErrorType, UnitConst)
    if literal_first
        hi = check_expr(c, upper, None)
        lo = check_expr(c, lower, Some(zonk(c, hi.ty)))
    else
        lo = check_expr(c, lower, None)
        hi = check_expr(c, upper, Some(zonk(c, lo.ty)))
    val ty = zonk(c, lo.ty)
    if !(*ty is Int(_))
        if settled(ty) then c.note(unit, e.span, s"a range counts integers, not ${type_name(ty)}")
        return TExpr(at, ErrorType, UnitConst)
    if !fits(c, hi.ty, ty)
        c.note(unit, e.span, s"a range's bounds have one integer type, not ${type_name(ty)} and ${type_name(zonk(c, hi.ty))}")
        return TExpr(at, ErrorType, UnitConst)
    val wide = *ty match
        Int(bits) -> bits != IntBits
        _ -> false
    val k = core_class(c, if wide then "NumericRange" else "Range") match
        Some(k) -> k
        None -> return unsupported(c, e, "a range")
    var lets: Buf[&TExpr] = buf()
    hold(c, at, s"range lo $tag", ty, lo, &lets)
    hold(c, at, s"range hi $tag", ty, hi, &lets)
    var args: Buf[Argument] = buf()
    args.push(Argument(lower.span, None, name_at(lower.span, s"range lo $tag"), false))
    args.push(Argument(upper.span, None, name_at(upper.span, s"range hi $tag"), false))
    args.push(Argument(e.span, None, Expr(e.span, IntLit("1")), false))
    args.push(Argument(e.span, None, Expr(e.span, BoolLit(inclusive)), false))
    val made = call_function(c, e.span, e.span, c.classes[k].constructor, args, None, None, buf())
    c.body.visible.truncate(mark)
    lets.push(made)
    TExpr(at, made.ty, Block(lets))

// `for pattern in source body` runs the body once for each element of `source`, bound by `pattern`,
// as a `while` loop whose `break` and `continue` are the `for`'s. Each kind of source has its own
// loop, and every element is bound before the loop steps, so `continue` goes straight to the test:
//
// - a range written in place, `a..b` or `a..<b`, of any integer type, counts in a local and makes no
//   `Range`; it never steps past its upper bound, so it never overflows;
// - a `Range` value counts from its start by its step;
// - an array is indexed from 0 to the length it has when the loop starts;
// - any other `Iterable` is traversed by the iterator its `iterator()` hands out.
//
// The values the loop keeps are locals named so that no source name can equal them; the source and
// a range's bounds are evaluated once, before the loop, left to right.
private for_expr(c: *Checker, e: &Expr, pattern: &Pattern, source: &Expr, body: &Expr) -> &TExpr
    val unit = unit_of(c)
    val at = e.span
    val tag = s"${at.start}"
    val mark = c.body.visible.len()
    var lets: Buf[&TExpr] = buf()
    var items: Buf[&Expr] = buf()
    source.kind match
        Range(lower, upper, inclusive) ->
            // An integer literal takes its type from the other bound.
            val literal_first = is_literal(lower) && !is_literal(upper)
            var lo: &TExpr = TExpr(at, ErrorType, UnitConst)
            var hi: &TExpr = TExpr(at, ErrorType, UnitConst)
            if literal_first
                hi = check_expr(c, upper, None)
                lo = check_expr(c, lower, Some(zonk(c, hi.ty)))
            else
                lo = check_expr(c, lower, None)
                hi = check_expr(c, upper, Some(zonk(c, lo.ty)))
            val ty = zonk(c, lo.ty)
            var counted = *ty is Int(_)
            if counted && !fits(c, hi.ty, ty)
                c.note(unit, source.span, s"a range's bounds have one integer type, not ${type_name(ty)} and ${type_name(zonk(c, hi.ty))}")
                counted = false
            elif !counted && settled(ty)
                c.note(unit, source.span, s"a range counts integers, not ${type_name(ty)}")
            if !counted
                hold(c, at, s"for item $tag", ErrorType, TExpr(at, ErrorType, UnitConst), &lets)
                items.push(element_binding(pattern, name_at(at, s"for item $tag")))
                items.push(body)
            else
                hold(c, at, s"for lo $tag", ty, lo, &lets)
                hold(c, at, s"for hi $tag", ty, hi, &lets)
                counted_range(at, tag, pattern, body, inclusive, &items)
        _ ->
            val typed = check_expr(c, source, None)
            val ty = zonk(c, typed.ty)
            val seq = s"for source $tag"
            if is_array_type(c, ty)
                hold(c, at, seq, ty, typed, &lets)
                indexed_array(at, tag, pattern, body, &items)
            elif is_range_type(c, ty)
                hold(c, at, seq, ty, typed, &lets)
                stepped_range(at, tag, pattern, body, &items)
            elif iterator_methods(c, ty).len() > 0
                hold(c, at, seq, ty, typed, &lets)
                iterated(at, tag, pattern, body, &items)
            else
                if settled(ty) then c.note(unit, source.span, s"`for` goes over a range, an array or an Iterable, and ${type_name(ty)} is none of them")
                else lets.push(typed)
                hold(c, at, s"for item $tag", ErrorType, TExpr(at, ErrorType, UnitConst), &lets)
                items.push(element_binding(pattern, name_at(at, s"for item $tag")))
                items.push(body)
    val looped = check_statement(c, Expr(at, Block(items, true)))
    c.body.visible.truncate(mark)
    var all: Buf[&TExpr] = buf()
    var finishes = true
    for t in lets
        if *t.ty is Nothing then finishes = false
        all.push(t)
    all.push(looped)
    TExpr(at, if finishes then Unit else Nothing, Block(all))

// A `for` with `yield` is calls on its sources, checked as they would be if written out. The first
// generator's source is evaluated first; each of its guards becomes `withFilter`, which tests an
// element only when the call after it reaches that element; then the last generator's elements are
// passed to `map` with the yielded value, and every earlier generator's to `flatMap` with the rest
// of the comprehension, whose sources are evaluated anew for each element. The pattern binds each
// element in every function made of it, a guard's as well as the one after it.
//
// A value definition after a generator is evaluated once for each element that reaches it. One that
// a guard follows, and every one before it, pairs each element with its value through `map`, so the
// guard and everything after it take the pair apart; the definitions after the last guarded one are
// bound in the function the elements are passed to, beside the element, as `val`s in one block.
private for_yield_expr(c: *Checker, e: &Expr, generators: Buf[Generator], body: &Expr, expected: Option[&Type]) -> &TExpr
    val g = generators[0]
    val item = s"yield item ${g.span.start}"
    var rest = body
    if generators.len() > 1
        var later: Buf[Generator] = buf()
        for i in 1 ..< generators.len() do later.push(generators[i])
        rest = Expr(later[0].span.to(e.span), ForYield(later, body))
    var source = check_expr(c, g.source, None)
    var pattern = g.pattern
    // A guard's function is named apart, so a diagnostic about its result names the guard.
    for guard in g.guards
        source = comprehension_call(c, g.span, g.source.span, source, "withFilter", element_function(pattern, s"yield guard ${g.span.start}", buf(), guard), None)
    var paired = 0
    for i in 0 ..< g.definitions.len()
        if g.definitions[i].guards.len() > 0 then paired = i + 1
    for i in 0 ..< paired
        val d = g.definitions[i]
        val pair = s"yield pair ${d.span.start}"
        var parts: Buf[&Expr] = buf()
        parts.push(name_at(d.span, pair))
        parts.push(d.value)
        source = comprehension_call(c, d.span, g.source.span, source, "map", element_function(pattern, pair, buf(), Expr(d.value.span, Tuple(parts))), None)
        var shapes: Buf[&Pattern] = buf()
        shapes.push(pattern)
        shapes.push(d.pattern)
        pattern = Pattern(g.pattern.span.to(d.pattern.span), Tuple(shapes))
        for guard in d.guards
            source = comprehension_call(c, d.span, g.source.span, source, "withFilter", element_function(pattern, s"yield guard ${d.span.start}", buf(), guard), None)
    var definitions: Buf[&Expr] = buf()
    for i in paired ..< g.definitions.len()
        val d = g.definitions[i]
        definitions.push(element_binding(d.pattern, d.value))
    val name = if generators.len() > 1 then "flatMap" else "map"
    comprehension_call(c, e.span, g.source.span, source, name, element_function(pattern, item, definitions, rest), expected)

/** The function of one element that binds it by `pattern`, then each of `definitions`, and yields
 * `body`. */
private element_function(pattern: &Pattern, item: string, definitions: Buf[&Expr], body: &Expr) -> &Expr
    var params: Buf[LambdaParam] = buf()
    params.push(LambdaParam(pattern.span, item, None))
    var items: Buf[&Expr] = buf()
    items.push(element_binding(pattern, name_at(pattern.span, item)))
    for d in definitions do items.push(d)
    items.push(body)
    Expr(body.span, Lambda(params, Expr(body.span, Block(items, false))))

/** The call `receiver.name(f)` a comprehension makes, reported at the generator's source when the
 * receiver's type has no method of that name. */
private comprehension_call(c: *Checker, at: Span, source_span: Span, receiver: &TExpr, name: string, f: &Expr, expected: Option[&Type]) -> &TExpr
    val ty = zonk(c, receiver.ty)
    if !settled(ty) then return receiver
    var args: Buf[Argument] = buf()
    args.push(Argument(f.span, None, f, false))
    val ms = comprehension_methods(c, ty, name)
    if ms.len() == 0
        val role = if name == "withFilter" then "a guard of a `for` with `yield`" else "a `for` with `yield`"
        c.note(unit_of(c), source_span, s"`${type_name(ty)}` has no method `$name`, which $role calls on its source")
        return TExpr(at, ErrorType, UnitConst)
    call_method(c, at, source_span, receiver, name, ms, args, None, expected, false)

/** The methods of `name` a call on a value of type `t` chooses among, as a call written out sees them. */
private comprehension_methods(c: *Checker, t: &Type, name: string) -> Buf[usize] = methods_of(c, t, name)

/** Evaluates `value` into a new hidden local `name` of type `ty`, adding the binding to `lets`. */
private hold(c: *Checker, at: Span, name: string, ty: &Type, value: &TExpr, lets: *Buf[&TExpr])
    val index = declare_local(c, at, name, ty, false)
    lets.push(TExpr(at, if *value.ty is Nothing then Nothing else Unit, Let(index, value)))

private is_range_type(c: *Checker, t: &Type) -> bool = *t match
    Class(k, _, _) -> c.classes[k].module_name == CoreModule && c.classes[k].name == "Range" && !c.classes[k].decl.object
    _ -> false

/** The core library's `List` variant `name`: `Cons`, a head and a tail, or `Nil`, the empty list. */
private list_variant(c: *Checker, name: string) -> Option[VariantRef]
    val d = core_data(c, "List")?
    Some(VariantRef(d, variant_index(c, d, name)))

/** Whether `t` is an instance of the core library's `List`. */
private is_list_type(c: *Checker, t: &Type) -> bool = *t match
    Data(d, _, _) -> c.data[d].module_name == CoreModule && c.data[d].name == "List"
    _ -> false

// `head :: tail` is the core library's `Cons(head, tail)`, whatever `Cons` names where it is written,
// so the element type is inferred as a call of the variant infers it: from the expected type and from
// both operands, a `List` of their common type.
private cons_expr(c: *Checker, e: &Expr, head: &Expr, tail: &Expr, op_span: Span, expected: Option[&Type]) -> &TExpr
    val v = list_variant(c, "Cons") match
        Some(v) -> v
        None -> return unsupported(c, e, "`::`")
    var args: Buf[Argument] = buf()
    args.push(Argument(head.span, None, head, false))
    args.push(Argument(tail.span, None, tail, false))
    construct(c, e.span, op_span, v, args, None, expected)

// A sequence literal where a `List` is expected builds that list, element by element from the front:
// `[a, b]` is `a :: b :: []`, and `[]` is the empty list.
private list_literal(c: *Checker, e: &Expr, items: Buf[&Expr], expected: Option[&Type]) -> &TExpr
    if items.len() == 0
        val nil = list_variant(c, "Nil").unwrap()
        return construct(c, e.span, e.span, nil, buf(), None, expected)
    var rest: Buf[&Expr] = buf()
    for i in 1..<items.len()
        rest.push(items[i])
    val tail = Expr(Span(if rest.len() > 0 then rest[0].span.start else e.span.end, e.span.end), ListLit(rest))
    var args: Buf[Argument] = buf()
    args.push(Argument(items[0].span, None, items[0], false))
    args.push(Argument(tail.span, None, tail, false))
    construct(c, e.span, items[0].span, list_variant(c, "Cons").unwrap(), args, None, expected)

/** The `iterator` methods a value of type `t` has: those of its class, of its bounds for a type
 * parameter, or of its impls. */
private iterator_methods(c: *Checker, t: &Type) -> Buf[usize] = *t match
    Class(k, _, _) -> methods_named(c, k, "iterator")
    TypeVar(_, _, _) -> bound_methods(c, t, "iterator")
    ErrorType -> buf()
    Nothing -> buf()
    _ -> visible_methods(c, receiver_methods(c, t, "iterator"))

private name_at(at: Span, name: string) -> &Expr = Expr(at, Name(name))

private call_at(at: Span, target: &Expr, method: string) -> &Expr = Expr(at, Call(Expr(at, Member(target, method)), buf()))

private assign_at(at: Span, name: string, value: &Expr) -> &Expr = Expr(at, Assign(name_at(at, name), None, value, false, at))

private compare_at(at: Span, op: CompareOp, a: &Expr, b: &Expr) -> &Expr
    var operands: Buf[&Expr] = buf()
    operands.push(a)
    operands.push(b)
    var ops: Buf[CompareOp] = buf()
    ops.push(op)
    Expr(at, Compare(operands, ops))

/** Binds the loop's element by the `for`'s pattern: a name as a `val`, `_` not at all, and any other
 * pattern by taking the element apart. */
private element_binding(pattern: &Pattern, value: &Expr) -> &Expr = pattern.kind match
    Name(n) -> Expr(pattern.span, Binding(n, None, value, false))
    Wildcard -> value
    _ -> Expr(pattern.span, Destructure(pattern, None, value, false))

/** The loop's body: the element bound, the loop stepped, then the `for`'s own body. */
private loop_body(element: &Expr, steps: Buf[&Expr], body: &Expr) -> &Expr
    var items: Buf[&Expr] = buf()
    items.push(element)
    for s in steps do items.push(s)
    items.push(body)
    Expr(body.span, Block(items, true))

// `lo..hi` and `lo..<hi` count in `i`, while `go` says whether `i` is in the range. The step is taken
// only from below the upper bound, so it never overflows.
private counted_range(at: Span, tag: string, pattern: &Pattern, body: &Expr, inclusive: bool, items: *Buf[&Expr])
    val lo = s"for lo $tag"
    val hi = s"for hi $tag"
    val i = s"for i $tag"
    val go = s"for go $tag"
    val within: CompareOp = if inclusive then LessEqual else Less
    items.push(Expr(at, Binding(i, None, name_at(at, lo), true)))
    items.push(Expr(at, Binding(go, None, compare_at(at, within, name_at(at, lo), name_at(at, hi)), true)))
    val next = Expr(at, Binary(AddWrapping, name_at(at, i), Expr(at, IntLit("1")), at))
    var steps: Buf[&Expr] = buf()
    if inclusive
        steps.push(Expr(at, If(compare_at(at, Equal, name_at(at, i), name_at(at, hi)), assign_at(at, go, Expr(at, BoolLit(false))), Some(assign_at(at, i, next)))))
    else
        steps.push(assign_at(at, i, next))
        steps.push(assign_at(at, go, compare_at(at, Less, name_at(at, i), name_at(at, hi))))
    items.push(Expr(at, While(name_at(at, go), loop_body(element_binding(pattern, name_at(at, i)), steps, body), None)))

// A `Range` value counts from its start by its step. The next value is taken with wrapping
// arithmetic, and the loop ends when it wrapped, having passed the largest or smallest `int`, or when
// it lies past the limit.
private stepped_range(at: Span, tag: string, pattern: &Pattern, body: &Expr, items: *Buf[&Expr])
    val r = name_at(at, s"for source $tag")
    val i = s"for i $tag"
    val go = s"for go $tag"
    val limit = s"for limit $tag"
    val step = s"for step $tag"
    val inclusive = s"for inclusive $tag"
    val next = s"for next $tag"
    items.push(Expr(at, Binding(limit, None, Expr(at, Member(r, "limit")), false)))
    items.push(Expr(at, Binding(step, None, Expr(at, Member(r, "step")), false)))
    items.push(Expr(at, Binding(inclusive, None, Expr(at, Member(r, "inclusive")), false)))
    items.push(Expr(at, Binding(i, None, Expr(at, Member(r, "start")), true)))
    items.push(Expr(at, Binding(go, None, call_at(at, r, "nonEmpty"), true)))
    val zero = Expr(at, IntLit("0"))
    val upward = compare_at(at, Greater, name_at(at, step), zero)
    val n = name_at(at, next)
    val below = Expr(at, If(name_at(at, inclusive), compare_at(at, LessEqual, n, name_at(at, limit)), Some(compare_at(at, Less, n, name_at(at, limit)))))
    val above = Expr(at, If(name_at(at, inclusive), compare_at(at, GreaterEqual, n, name_at(at, limit)), Some(compare_at(at, Greater, n, name_at(at, limit)))))
    val advanced = Expr(at, If(upward, compare_at(at, Greater, n, name_at(at, i)), Some(compare_at(at, Less, n, name_at(at, i)))))
    val within = Expr(at, If(compare_at(at, Greater, name_at(at, step), Expr(at, IntLit("0"))), below, Some(above)))
    var steps: Buf[&Expr] = buf()
    steps.push(Expr(at, Binding(next, None, Expr(at, Binary(AddWrapping, name_at(at, i), name_at(at, step), at)), false)))
    steps.push(assign_at(at, go, Expr(at, Binary(And, advanced, within, at))))
    steps.push(assign_at(at, i, n))
    items.push(Expr(at, While(name_at(at, go), loop_body(element_binding(pattern, name_at(at, i)), steps, body), None)))

// An array is indexed from 0 below its length, read once: an array's length never changes.
private indexed_array(at: Span, tag: string, pattern: &Pattern, body: &Expr, items: *Buf[&Expr])
    val a = name_at(at, s"for source $tag")
    val n = s"for length $tag"
    val i = s"for i $tag"
    items.push(Expr(at, Binding(n, None, call_at(at, a, "length"), false)))
    items.push(Expr(at, Binding(i, None, Expr(at, IntLit("0")), true)))
    var args: Buf[Argument] = buf()
    args.push(Argument(at, None, name_at(at, i), false))
    val element = Expr(at, Call(a, args))
    var steps: Buf[&Expr] = buf()
    steps.push(assign_at(at, i, Expr(at, Binary(AddWrapping, name_at(at, i), Expr(at, IntLit("1")), at))))
    items.push(Expr(at, While(compare_at(at, Less, name_at(at, i), name_at(at, n)), loop_body(element_binding(pattern, element), steps, body), None)))

// Any other `Iterable` hands out an iterator, asked for each element until it has none left.
private iterated(at: Span, tag: string, pattern: &Pattern, body: &Expr, items: *Buf[&Expr])
    val it = s"for iterator $tag"
    items.push(Expr(at, Binding(it, None, call_at(at, name_at(at, s"for source $tag"), "iterator"), false)))
    val element = call_at(at, name_at(at, it), "next")
    items.push(Expr(at, While(call_at(at, name_at(at, it), "hasNext"), loop_body(element_binding(pattern, element), buf(), body), None)))

private innermost_loop(c: *Checker, e: &Expr, word: string) -> Option[usize]
    if c.body.loops.len() == 0
        if c.symbols[c.current].delayed
            c.note(unit_of(c), e.span, s"`$word` cannot leave a delayed argument, which is evaluated where its parameter is read")
        elif comprehension_part(c.symbols[c.current]) then c.note(unit_of(c), e.span, comprehension_exit(word))
        else c.note(unit_of(c), e.span, s"`$word` is outside a loop")
        return None
    Some(c.body.loops[c.body.loops.len() - 1])

private break_expr(c: *Checker, e: &Expr, value: Option[&Expr]) -> &TExpr
    val target = innermost_loop(c, e, "break")
    var typed: Option[&TExpr] = None
    var ty: &Type = Unit
    if value is Some(v)
        val want = target match
            Some(label) -> c.body.loop_expected[label]
            None -> None
        val t = check_expr(c, v, want)
        typed = Some(t)
        ty = t.ty
    target match
        Some(label) ->
            c.body.breaks.push(BreakSite(label, e.span, ty))
            TExpr(e.span, Nothing, Break(label, typed))
        None -> TExpr(e.span, ErrorType, UnitConst)

private continue_expr(c: *Checker, e: &Expr) -> &TExpr = innermost_loop(c, e, "continue") match
    Some(label) -> TExpr(e.span, Nothing, Continue(label))
    None -> TExpr(e.span, ErrorType, UnitConst)

private return_expr(c: *Checker, e: &Expr, value: Option[&Expr]) -> &TExpr
    val unit = unit_of(c)
    val symbol = c.symbols[c.current]
    if symbol.delayed
        c.note(unit, e.span, "`return` cannot leave a delayed argument, which is evaluated where its parameter is read")
        if value is Some(v) then check_statement(c, v)
        return TExpr(e.span, Nothing, UnitConst)
    if comprehension_part(symbol)
        c.note(unit, e.span, comprehension_exit("return"))
        if value is Some(v) then check_statement(c, v)
        return TExpr(e.span, Nothing, UnitConst)
    if symbol.constructor
        c.note(unit, e.span, "`return` cannot leave a class body, which runs to its end to make the object")
        if value is Some(v) then check_statement(c, v)
        return TExpr(e.span, Nothing, UnitConst)
    var typed: Option[&TExpr] = None
    symbol.result match
        Some(r) ->
            value match
                Some(v) ->
                    val t = check_expr(c, v, Some(r))
                    if !fits(c, t.ty, r) && !(*r is Unit)
                        c.note(unit, v.span, s"${described(symbol)} yields ${type_name(r)}, not ${type_name(t.ty)}")
                    typed = Some(t)
                None ->
                    if !(*r is Unit || *r is ErrorType)
                        c.note(unit, e.span, s"`return` needs a value, because ${described(symbol)} yields ${type_name(r)}")
        None ->
            if symbol.lambda then c.note(unit, e.span, "this lambda uses `return`, so its result type must be known where it is written, as in `val f: (int) -> int = …`")
            else c.note(unit, e.span, s"`${symbol.name}` uses `return`, so it needs a declared result type")
            if value is Some(v) then typed = Some(check_expr(c, v, None))
    TExpr(e.span, Nothing, Return(typed))

/** Whether a class is the core library's `Array`: its objects hold their length and then their
 * elements, not fields, and only the library's intrinsics make them. */
is_array_class(k: ClassSymbol) -> bool = k.module_name == CoreModule && k.name == "Array" && !k.decl.object

/** Whether a class is the core library's `Vector`, whose one field is the array of its elements. */
is_vector_class(k: ClassSymbol) -> bool = k.module_name == CoreModule && k.name == "Vector" && !k.decl.object

/** Whether a function's last parameter is repeated, `values: T*`. */
declares_variadic(f: &Function) -> bool = f.params.len() > 0 && f.params[f.params.len() - 1].variadic

/** `Vector[t]`: inside its function, a repeated parameter of element type `t` is a vector. */
private vector_of(c: *Checker, t: &Type) -> &Type = core_class_of(c, "Vector", t)

/** The core library's generic class or trait `name`, of the one type argument `t`. */
private core_class_of(c: *Checker, name: string, t: &Type) -> &Type
    c.class_types.get(qualified(CoreModule, name)) match
        Some(k) ->
            var args: Buf[&Type] = buf()
            args.push(t)
            Class(k, name, args)
        None -> ErrorType

/** The element type of a repeated parameter, from its type `Vector[T]` with the call's type
 * arguments in place. */
private repeated_element(t: &Type) -> &Type = *t match
    Class(_, _, args) -> if args.len() == 1 then args[0] else ErrorType
    _ -> ErrorType

/** Whether `k` is one of the core library's classes whose objects are arrays: `Array`, or the
 * read-only `FrozenArray` a vector keeps its elements in. Their methods may be array intrinsics. */
private is_array_storage(k: ClassSymbol) -> bool =
    k.module_name == CoreModule && (k.name == "Array" || k.name == "FrozenArray") && !k.decl.object

private is_atomic_storage(k: ClassSymbol) -> bool =
    k.module_name == "avin.threads" && k.name == "Atomic" && !k.decl.object

private is_array_type(c: *Checker, t: &Type) -> bool = *t match
    Class(k, _, _) -> is_array_class(c.classes[k])
    _ -> false

/** The core library's class `name`, by its index, unless a program has none. */
private core_class(c: *Checker, name: string) -> Option[usize]
    for i in 0..<c.classes.len()
        if c.classes[i].module_name == CoreModule && c.classes[i].name == name && !c.classes[i].decl.object then return Some(i)
    None

/** The core library's data type `name`, by its index, unless a program has none. */
private core_data(c: *Checker, name: string) -> Option[usize]
    for i in 0..<c.data.len()
        if c.data[i].module_name == "avin" && c.data[i].name == name then return Some(i)
    None

/** The position of the variant `name` among the variants of the data type `d`. */
private variant_index(c: *Checker, d: usize, name: string) -> usize
    for i in 0..<c.data[d].variants.len()
        if c.data[d].variants[i].name == name then return i
    0

// `value?` takes an `Option` or a `Result` apart: a `Some` or an `Ok` yields its value, and a `None`
// or an `Err` returns from the enclosing function, which must yield an `Option` or a `Result` with an
// error type the failure's conforms to. It checks as the `match` it means, whose failure arm makes a
// fresh `None` or an `Err` of the function's own result type, so the error is passed on unchanged.
private propagate_expr(c: *Checker, e: &Expr, value: &Expr) -> &TExpr
    val unit = unit_of(c)
    val s = check_expr(c, value, None)
    val ty = zonk(c, s.ty)
    if *ty is ErrorType then return TExpr(e.span, ErrorType, UnitConst)
    val option = core_data(c, "Option")
    val result = core_data(c, "Result")
    var is_option = false
    var args: Buf[&Type] = buf()
    var d = 0usize
    *ty match
        Data(id, _, xs) ->
            val is_result = result match
                Some(r) -> id == r
                None -> false
            if option is Some(o) && id == o then is_option = true
            elif !is_result
                c.note(unit, value.span, s"`?` takes apart an Option or a Result, not ${type_name(ty)}")
                return TExpr(e.span, ErrorType, UnitConst)
            d = id
            args = xs
        _ ->
            c.note(unit, value.span, s"`?` takes apart an Option or a Result, not ${type_name(ty)}")
            return TExpr(e.span, ErrorType, UnitConst)
    val symbol = c.symbols[c.current]
    if symbol.delayed
        c.note(unit, e.span, "`?` cannot return from a delayed argument, which is evaluated where its parameter is read")
        return TExpr(e.span, ErrorType, UnitConst)
    if comprehension_part(symbol)
        c.note(unit, e.span, comprehension_exit("?"))
        return TExpr(e.span, ErrorType, UnitConst)
    if symbol.constructor
        c.note(unit, e.span, "`?` cannot return from a class body, which runs to its end to make the object")
        return TExpr(e.span, ErrorType, UnitConst)
    val declared = symbol.result match
        Some(r) -> zonk(c, r)
        None ->
            if symbol.lambda then c.note(unit, e.span, "this lambda uses `?`, so its result type must be known where it is written, as in `val f: (string) -> Option[int] = …`")
            else c.note(unit, e.span, s"`${symbol.name}` uses `?`, so it needs a declared result type")
            return TExpr(e.span, ErrorType, UnitConst)
    if *declared is ErrorType then return TExpr(e.span, ErrorType, UnitConst)
    val wanted = if is_option then "an Option" else "a Result"
    var failure: Buf[&Type] = buf()
    *declared match
        Data(id, _, xs) if id == d -> failure = xs
        _ ->
            c.note(unit, e.span, s"`?` on ${type_name(ty)} returns ${if is_option then "`None`" else "the `Err`"} from ${described(symbol)}, which yields ${type_name(declared)}, not $wanted")
            return TExpr(e.span, ErrorType, UnitConst)
    // The value's own local and the failure's are hidden from the program's names.
    val held = c.body.locals.len()
    c.body.locals.push(TLocal("?value", args[0], false, c.current))
    var success: Buf[&TPattern] = buf()
    success.push(TPattern(e.span, args[0], PBind(held)))
    var arms: Buf[TArm] = buf()
    if is_option
        arms.push(TArm(TPattern(e.span, ty, PVariant(variant_index(c, d, "Some"), success)), None, TExpr(e.span, args[0], Local(held))))
        val none = TExpr(e.span, declared, Construct(variant_index(c, d, "None"), buf()))
        arms.push(TArm(TPattern(e.span, ty, PVariant(variant_index(c, d, "None"), buf())), None, TExpr(e.span, Nothing, Return(Some(none)))))
        return TExpr(e.span, args[0], Match(s, arms))
    val error = zonk(c, args[1])
    val passed = zonk(c, failure[1])
    val caught = c.body.locals.len()
    c.body.locals.push(TLocal("?error", error, false, c.current))
    var failed: Buf[&TPattern] = buf()
    failed.push(TPattern(e.span, error, PBind(caught)))
    var fields: Buf[&TExpr] = buf()
    val read = TExpr(e.span, error, Local(caught))
    if fits(c, error, passed) then fields.push(if *passed is AnyType then to_any(c, read) else read)
    else
        val converted = converted_error(c, e, value, read, passed, symbol)
        if *converted.ty is ErrorType then return TExpr(e.span, ErrorType, UnitConst)
        fields.push(converted)
    val err = TExpr(e.span, declared, Construct(variant_index(c, d, "Err"), fields))
    arms.push(TArm(TPattern(e.span, ty, PVariant(variant_index(c, d, "Ok"), success)), None, TExpr(e.span, args[0], Local(held))))
    arms.push(TArm(TPattern(e.span, ty, PVariant(variant_index(c, d, "Err"), failed)), None, TExpr(e.span, Nothing, Return(Some(err)))))
    TExpr(e.span, args[0], Match(s, arms))

// An error `?` passes on to a function yielding errors of another type, `passed`, is converted by
// that type's `from`, through its conformance to `From` at the error's type. Where it has none, the
// conformance at a type the error is a value of serves, if one is more specific than every other.
// On a type parameter the conformances are its bounds', and each instance calls its type
// argument's `from`.
private converted_error(c: *Checker, e: &Expr, value: &Expr, read: &TExpr, passed: &Type, symbol: FunctionSymbol) -> &TExpr
    val unit = unit_of(c)
    val error = read.ty
    val failed = TExpr(e.span, ErrorType, UnitConst)
    val from = c.class_types.get(qualified(CoreModule, "From")) match
        Some(k) -> k
        None ->
            c.note(unit, e.span, s"`?` passes on an error of ${type_name(error)}, but ${described(symbol)} yields errors of ${type_name(passed)}; convert it first with `mapErr`")
            return failed
    val sources = from_sources(c, passed, from)
    var exact: Option[&Type] = None
    var candidates: Buf[&Type] = buf()
    for s in sources
        val source = conformance_arg(s)
        if same_type(source, error) then exact = Some(s)
        elif fits(c, error, source) then candidates.push(s)
    val chosen = exact match
        Some(s) -> s
        None ->
            if candidates.len() == 0
                c.note(unit, e.span, s"`?` passes on an error of ${type_name(error)}, but ${described(symbol)} yields errors of ${type_name(passed)}, which does not implement From[${type_name(error)}]; implement it, or convert the error first with `mapErr`")
                return failed
            var best: Buf[&Type] = buf()
            for x in candidates
                var below_all = true
                for y in candidates
                    if !fits(c, conformance_arg(x), conformance_arg(y)) then below_all = false
                if below_all then best.push(x)
            if best.len() != 1
                var shown = ""
                for i in 0..<candidates.len()
                    if i > 0 then shown = shown + if i + 1 == candidates.len() then " and " else ", "
                    shown = shown + type_name(candidates[i])
                c.note(unit, e.span, s"`?` cannot choose how to convert an error of ${type_name(error)} to ${type_name(passed)}: it implements $shown, and none is more specific than the others")
                return failed
            best[0]
    val source = conformance_arg(chosen)
    val receiver = TExpr(e.span, passed, TypeReceiver)
    var argument = to_trait(c, read, source)
    if *source is AnyType then argument = to_any(c, read)
    var members: Buf[usize] = buf()
    for m in c.classes[from].methods
        if c.symbols[m].decl.name == "from" then members.push(m)
    if members.len() != 1
        c.note(unit, e.span, "the core library's `From` declares one member, `from`")
        return failed
    val member = members[0]
    var call_args: Buf[&TExpr] = buf()
    call_args.push(receiver)
    call_args.push(argument)
    // Each instance calls its type argument's `from` for the source the bound names.
    if *passed is TypeVar(_, _, _)
        var type_args: Buf[&Type] = buf()
        type_args.push(source)
        return TExpr(e.span, passed, BoundCall(member, bound_slot(c, member), call_args, type_args))
    // A known type's own `from` taking the source.
    val statics = *passed match
        Class(k, _, _) -> methods_named(c, k, "from")
        _ -> receiver_methods(c, passed, "from")
    for m in statics
        if !c.symbols[m].static_member then continue
        val s = method_signature(c, receiver, m, c.symbols[m].result.unwrap_or(ErrorType))
        if s.params.len() == 1 && same_type(zonk(c, substitute(s.params[0], s.owner, s.known)), source)
            var written: Buf[Argument] = buf()
            written.push(Argument(e.span, None, value, false))
            var checked: Buf[Option[&TExpr]] = buf()
            checked.push(Some(argument))
            return method_call(c, e.span, e.span, receiver, m, written, None, Some(passed), false, checked)
    c.note(unit, e.span, s"`${type_name(passed)}` implements ${type_name(chosen)} but has no static `from` taking ${type_name(source)}")
    failed

/** The type argument of an instance of `From`. */
private conformance_arg(t: &Type) -> &Type = *t match
    Class(_, _, xs) -> if xs.len() == 1 then xs[0] else ErrorType
    _ -> ErrorType

/** The instances of trait `k` type `t` implements: a type parameter's through its bounds, a built-in
 * type's through its impls, and any other's through the conformances holding at its arguments. */
private from_sources(c: *Checker, t: &Type, k: usize) -> Buf[&Type]
    val f = conformances(c)
    var out: Buf[&Type] = buf()
    if *t is TypeVar(_, _, _)
        for b in bounds_of(c, t)
            for up in holding_ancestors(f, b, k)
                out.push(up)
        return out
    if is_builtin(t) || *t is Tuple(_)
        for b in c.builtins
            if builtin_covers(b.ty, t) && tuple_parts_hold(f, b.owner, b.params, t)
                if ancestor_type(c.classes, c.data, b.trait_type, k) is Some(up) then out.push(up)
        return out
    holding_ancestors(f, t, k)

// A call to a generic function solves for its type arguments: they may be written (`f[int](x)`),
// and otherwise each starts as an unknown that the expected result type and the arguments decide.
// Arguments that are not bare literals are checked first, so a literal takes the type the others
// settle. Every type argument must be decided by the end of the call. A variant of a data type is
// called the same way, with the type's parameters as its type parameters.
private call_expr(c: *Checker, at: Span, callee: &Expr, args: Buf[Argument], expected: Option[&Type]) -> &TExpr
    val unit = unit_of(c)
    var explicit: Option[Buf[&TypeExpr]] = None
    var named = callee
    if callee.kind is TypeApply(inner, types)
        explicit = Some(types)
        named = inner
    if module_use(c, named) is Some(q)
        if explicit is Some(types) then return call_expr(c, at, Expr(callee.span, TypeApply(q, types)), args, expected)
        return call_expr(c, at, q, args, expected)
    if named.kind is Member(target, member) then return member_call(c, at, callee, named.span, target, member, args, explicit, expected, false)
    val name = named.kind match
        Name(n) -> n
        _ -> return value_call(c, at, callee, args)
    // A local or a parameter hides a function of the same name, as it does where it is not called.
    if explicit is None && (lookup_local(c, name) is Some(_) || param_index(c, name) is Some(_))
        return value_call(c, at, callee, args)
    class_member(c, name) match
        Some(MethodOf(m)) ->
            if c.super_args
                c.note(unit, named.span, s"`$name` is a method, which a superclass's arguments cannot call: they run before the object is initialized")
                for a in args
                    check_statement(c, a.value)
                return TExpr(at, ErrorType, UnitConst)
            val receiver = self_ref(c, named.span)
            var ms = bare_methods(c, name)
            if ms.len() == 0 then ms.push(m)
            return call_method(c, at, named.span, receiver, name, ms, args, explicit, expected, false)
        Some(FieldOf(_)) -> if explicit is None then return value_call(c, at, callee, args)
        Some(DataFieldOf(_)) -> if explicit is None then return value_call(c, at, callee, args)
        Some(TraitFieldOf(_)) -> if explicit is None then return value_call(c, at, callee, args)
        None -> ()
    // A module-level value is called as a value; a class's name in call position is its
    // constructor, and a data type's variant of its own name, even where a companion object shares
    // the name. An object that declares `apply` is called through it, and a companion's `apply`
    // methods overload the constructor its name has in call position.
    val ids = lookup_functions(c, name)
    if applying_object(c, name, ids) is Some(o) then return apply_call(c, at, named.span, name, o, ids, args, explicit, expected)
    var global = if explicit is None && ids.len() == 0 then global_named(c, name) else None
    if global is Some(g)
        if c.globals[g].object is Some(k)
            if variant_named(c, name) is Some(v)
                if c.classes[k].companion_data == Some(v.data) then global = None
    if global is Some(g)
        if c.globals[g].object is Some(_)
            c.note(unit, named.span, s"`$name` is an object, made once before `main`; it is called only through an `apply` method it declares")
            for a in args
                check_statement(c, a.value)
            return TExpr(at, ErrorType, UnitConst)
        return value_call(c, at, callee, args)
    if ids.len() == 0
        if variant_named(c, name) is Some(v)
            if c.data[v.data].variants[v.index].fields.len() == 0
                c.note(unit, at, s"`$name` has no fields; write it without parentheses")
                for a in args
                    check_statement(c, a.value)
                return TExpr(at, ErrorType, UnitConst)
            return construct(c, at, named.span, v, args, explicit, expected)
        if explicit is None
            if builtin_type(name) is Some(target) then return conversion(c, at, target, args, false)
            if integer_param_named(c, name) is Some(target) then return conversion(c, at, target, args, false)
            if c.generic is Some(scope)
                if names_type_param(scope.params, name)
                    c.note(unit, named.span, s"`$name` is a type parameter, which a call converts to only where it is bounded by `Integer`")
                    for a in args
                        check_statement(c, a.value)
                    return TExpr(at, ErrorType, UnitConst)
        c.note(unit, named.span, s"`$name` is not defined")
        return TExpr(at, ErrorType, UnitConst)
    if ids.len() == 1 then return call_function(c, at, named.span, ids[0], args, explicit, expected, buf())
    val choice = choose_overload(c, at, named.span, name, ids, args, explicit)
    choice.id match
        Some(id) -> call_function(c, at, named.span, id, args, explicit, expected, choice.typed)
        None -> TExpr(at, ErrorType, UnitConst)

// A call of one function, with `typed` holding the arguments already checked, if any.
private call_function(c: *Checker, at: Span, name_span: Span, id: usize, args: Buf[Argument], explicit: Option[Buf[&TypeExpr]], expected: Option[&Type], typed: Buf[Option[&TExpr]]) -> &TExpr
    if abstract_constructor(c, id, name_span)
        for i in 0..<args.len()
            if i >= typed.len() || typed[i] is None then check_statement(c, args[i].value)
        return TExpr(at, ErrorType, UnitConst)
    local_use(c, id, at)
    val declared = result_of(c, id, at)
    val applied = apply(c, at, name_span, function_signature(c, id, declared), args, explicit, expected, typed)
    applied.wrap(at, Call(id, applied.args, applied.type_args))

// The object a call by `name` reaches through its `apply` methods: the object of that name, where it
// declares `apply` and the name is not a function's, only, if anything, its companion class's
// constructor.
private applying_object(c: *Checker, name: string, ids: Buf[usize]) -> Option[usize]
    for id in ids
        if !c.symbols[id].constructor then return None
    val g = global_named(c, name) match
        Some(g) -> g
        None -> return None
    val o = c.globals[g].object match
        Some(o) -> o
        None -> return None
    if object_applies(c, o).len() == 0 then return None
    Some(o)

/** The constructors of `ids` a call can choose: a class that is abstract, a trait or an array is
 * not made by its name, and leaves the call to the companion's `apply`. */
private callable_constructors(c: *Checker, ids: Buf[usize]) -> Buf[usize]
    var out: Buf[usize] = buf()
    for id in ids
        val k = c.symbols[id].owner_class.unwrap()
        if !is_array_class(c.classes[k]) && !is_abstract_class(c, k) then out.push(id)
    out

/** For a data type's companion `o` named `name`, the type's variant of that name, made by a call. */
private companion_variant(c: *Checker, o: usize, name: string) -> Option[VariantRef]
    val d = c.classes[o].companion_data match
        Some(d) -> d
        None -> return None
    val v = variant_named(c, name) match
        Some(v) -> v
        None -> return None
    if v.data != d || c.data[d].variants[v.index].fields.len() == 0 then return None
    Some(v)

/** The `apply` method `m` of object `o`, for a diagnostic: "`Point.apply(x: int)`". */
private apply_text(c: *Checker, o: usize, m: usize) -> string
    val f = c.symbols[m]
    var names: Buf[string] = buf()
    var params: Buf[&Type] = buf()
    for i in 1..<f.params.len()
        names.push(f.param_names[i])
        params.push(f.params[i])
    candidate_text(c.classes[o].name + ".apply", f.type_params, names, params)

// A call by the name of object `o`, which declares `apply`: `Name(…)` chooses among the object's
// `apply` methods and, for a companion, the constructor its name has in call position, the class's
// or the data type's variant of the type's name, as any overloaded call chooses. Type arguments
// written at the call are the chosen candidate's own: the class's or the data type's for a
// constructor, the method's for an `apply`.
private apply_call(c: *Checker, at: Span, name_span: Span, name: string, o: usize, ids: Buf[usize], args: Buf[Argument], explicit: Option[Buf[&TypeExpr]], expected: Option[&Type]) -> &TExpr
    val receiver = global_read(c, name_span, c.classes[o].global.unwrap())
    val constructors = callable_constructors(c, ids)
    val variant = companion_variant(c, o, name)
    val ms = object_applies(c, o)
    var signatures: Buf[Signature] = buf()
    var labels: Buf[string] = buf()
    for id in constructors
        signatures.push(function_signature(c, id, ErrorType))
        labels.push(overload_text(c, id))
    if variant is Some(v)
        val s = variant_signature(c, v)
        signatures.push(s)
        labels.push(candidate_text(s.name, s.type_params, s.names, s.params))
    val first_method = signatures.len()
    for m in ms
        signatures.push(method_signature(c, receiver, m, ErrorType))
        labels.push(apply_text(c, o, m))
    var typed: Buf[Option[&TExpr]] = buf()
    var chosen = 0usize
    if signatures.len() > 1
        val choice = choose_among(c, at, name_span, name, signatures, labels, args, explicit)
        typed = choice.typed
        chosen = choice.id match
            Some(i) -> i
            None -> return TExpr(at, ErrorType, UnitConst)
    if chosen < constructors.len() then return call_function(c, at, name_span, constructors[chosen], args, explicit, expected, typed)
    if chosen < first_method then return construct_checked(c, at, name_span, variant.unwrap(), args, explicit, expected, typed)
    method_call(c, at, name_span, receiver, ms[chosen - first_method], args, explicit, expected, false, typed)

// The name of object `o`, which declares `apply`, where a function type is expected: of its `apply`
// methods and its companion class's constructor, the one whose parameters accept the expected
// type's, as for any overloaded function used as a value.
private apply_value(c: *Checker, at: Span, name: string, o: usize, ids: Buf[usize], params: Buf[&Type], expected: Option[&Type]) -> &TExpr
    val unit = unit_of(c)
    val receiver = global_read(c, at, c.classes[o].global.unwrap())
    val constructors = callable_constructors(c, ids)
    val ms = object_applies(c, o)
    var labels: Buf[string] = buf()
    var fitting: Buf[usize] = buf()
    var fitting_labels: Buf[string] = buf()
    var owners: Buf[usize] = buf()
    var counts: Buf[usize] = buf()
    var compared: Buf[Buf[&Type]] = buf()
    for k in 0..<constructors.len() + ms.len()
        val s = if k < constructors.len() then function_signature(c, constructors[k], ErrorType) else method_signature(c, receiver, ms[k - constructors.len()], ErrorType)
        val label = if k < constructors.len() then overload_text(c, constructors[k]) else apply_text(c, o, ms[k - constructors.len()])
        labels.push(label)
        val view = substitute_all(s.params, s.owner, s.known)
        if accepts(c, view, s.owner, s.type_params.len(), params)
            fitting.push(k)
            fitting_labels.push(label)
            owners.push(s.owner)
            counts.push(s.type_params.len())
            compared.push(view)
    if fitting.len() == 0
        c.note(unit, at, s"no overload of `$name` has the parameter types of ${type_name(zonk(c, expected.unwrap()))}; the overloads are ${joined_labels(labels)}")
        return TExpr(at, ErrorType, UnitConst)
    val k = most_specific_of(c, owners, counts, compared) match
        Some(i) -> fitting[i]
        None ->
            c.note(unit, at, s"`$name` used as ${type_name(zonk(c, expected.unwrap()))} is ambiguous: ${joined_labels(fitting_labels)} each accept it")
            return TExpr(at, ErrorType, UnitConst)
    if k < constructors.len() then function_value(c, at, constructors[k], None, expected)
    else method_value(c, at, receiver, ms[k - constructors.len()], None, expected)

private function_signature(c: *Checker, id: usize, result: &Type) -> Signature
    val f = c.symbols[id]
    Signature(f.name, true, f.type_params, f.type_owner, f.params, f.param_names, f.defaults, result, enclosing_type_args(f), None, declares_variadic(f.decl), function_sites(c, id, 0))

/** A generic local function's type arguments for the type parameters it shares with the code it is
 * declared in: those parameters themselves, as every call it can be named from sees them. */
private enclosing_type_args(f: FunctionSymbol) -> Buf[&Type]
    var out: Buf[&Type] = buf()
    if f.root is None || f.decl.type_params.len() == 0 || f.type_params.len() <= f.decl.type_params.len() then return out
    for i in 0..<f.type_params.len() - f.decl.type_params.len()
        out.push(TypeVar(f.type_owner, i, f.type_params[i].name))
    out

/** The overload a call chooses, if it chooses one, and its arguments as checked while choosing: one
 * entry per written argument, `None` for one left to be checked against the chosen parameter. */
private struct Choice
    id: Option[usize]
    typed: Buf[Option[&TExpr]]

// Chooses among the functions `ids` of one name for a call, or reports why none is chosen.
//
// The candidates are the overloads the arguments can be bound to, by number and by name. The arguments
// are then checked once, on their own, except the ones whose type comes from their parameter: an
// integer literal, a lambda, and an argument some candidate takes by name, which is delayed rather
// than evaluated. An argument that every candidate gives the same type is checked against that type.
// Each candidate is tried against the arguments' types with inference variables of its own, which
// are discarded after, so nothing one candidate decides reaches another; a literal fits a candidate
// whose parameter it can become, and a lambda one whose parameter is a function of as many
// parameters. Of the candidates that fit, the one more specific than each other is chosen: the one
// whose parameter types, for the parameters the arguments are given to, the other accepts.
private choose_overload(c: *Checker, at: Span, name_span: Span, name: string, ids: Buf[usize], args: Buf[Argument], explicit: Option[Buf[&TypeExpr]]) -> Choice
    var signatures: Buf[Signature] = buf()
    for id in ids
        signatures.push(function_signature(c, id, ErrorType))
    choose(c, at, name_span, name, ids, signatures, args, explicit)

// Chooses among the functions `ids`, called through `signatures`: a function's own, or a method's
// past its receiver, with the type arguments its receiver decides already known.
private choose(c: *Checker, at: Span, name_span: Span, name: string, ids: Buf[usize], signatures: Buf[Signature], args: Buf[Argument], explicit: Option[Buf[&TypeExpr]]) -> Choice
    var labels: Buf[string] = buf()
    for id in ids
        labels.push(overload_text(c, id))
    val choice = choose_among(c, at, name_span, name, signatures, labels, args, explicit)
    choice.id match
        Some(i) -> Choice(Some(ids[i]), choice.typed)
        None -> choice

// Chooses among the candidates `signatures`, which a diagnostic names as `labels`: the chosen one's
// position among them, and the arguments as checked while choosing.
private choose_among(c: *Checker, at: Span, name_span: Span, name: string, signatures: Buf[Signature], labels: Buf[string], args: Buf[Argument], explicit: Option[Buf[&TypeExpr]]) -> Choice
    val unit = unit_of(c)
    var written: Buf[&Type] = buf()
    if explicit is Some(types)
        for t in types
            written.push(resolve_type(c, unit, t))
    var bound: Buf[usize] = buf()
    var bound_signatures: Buf[Signature] = buf()
    // Each bound candidate's parameter types with the known type arguments in place.
    var views: Buf[Buf[&Type]] = buf()
    var bindings: Buf[Binding] = buf()
    for i in 0..<signatures.len()
        val s = signatures[i]
        if s.type_params.len() - s.known.len() < written.len() then continue
        val binding = bind_arguments(c, at, s, args, false)
        if binding.fits
            bound.push(i)
            bound_signatures.push(s)
            views.push(substitute_all(s.params, s.owner, s.known))
            bindings.push(binding)
    var typed: Buf[Option[&TExpr]] = buf()
    if bound.len() == 0
        c.note(unit, name_span, s"no overload of `$name` accepts these arguments; the overloads are ${joined_labels(labels)}")
        return Choice(None, typed)
    for j in 0..<args.len()
        val value = argument_value(args[j])
        var delayed = false
        var agree = true
        val shared = argument_type(c, bound_signatures[0], views[0], bindings[0], args, j).unwrap()
        for k in 0..<bound.len()
            val p = argument_type(c, bound_signatures[k], views[k], bindings[k], args, j).unwrap()
            if *p is ByName(_) then delayed = true
            if bound_signatures[k].type_params.len() > bound_signatures[k].known.len() || !same_type(p, shared) then agree = false
        if takes_parameter_type(value) || is_literal(value) then typed.push(None)
        elif delayed then typed.push(Some(delayed_unchosen(c, args[j], if agree then Some(strict(shared)) else None)))
        else typed.push(Some(check_expr(c, value, if agree then Some(shared) else None)))
    var fitting: Buf[usize] = buf()
    var compared: Buf[Buf[&Type]] = buf()
    // A candidate with a repeated parameter is chosen only where no candidate without one fits.
    var fixed_fits = false
    for k in 0..<bound.len()
        if !bound_signatures[k].variadic && fits_call(c, bound_signatures[k], bindings[k], args, typed, written) then fixed_fits = true
    for k in 0..<bound.len()
        if fixed_fits && bound_signatures[k].variadic then continue
        if !fits_call(c, bound_signatures[k], bindings[k], args, typed, written) then continue
        fitting.push(bound[k])
        var params: Buf[&Type] = buf()
        for j in 0..<args.len()
            params.push(argument_type(c, bound_signatures[k], views[k], bindings[k], args, j).unwrap())
        compared.push(params)
    if fitting.len() == 0
        c.note(unit, name_span, s"no overload of `$name` accepts these arguments; the overloads are ${joined_labels(labels)}")
        return Choice(None, typed)
    var owners: Buf[usize] = buf()
    var counts: Buf[usize] = buf()
    var fitting_labels: Buf[string] = buf()
    for i in fitting
        owners.push(signatures[i].owner)
        counts.push(signatures[i].type_params.len())
        fitting_labels.push(labels[i])
    most_specific_of(c, owners, counts, compared) match
        Some(k) -> Choice(Some(fitting[k]), typed)
        None ->
            literal_preferred(c, owners, counts, compared, args) match
                Some(k) -> Choice(Some(fitting[k]), typed)
                None ->
                    c.note(unit, name_span, s"this call to `$name` is ambiguous: ${joined_labels(fitting_labels)} each accept it, and none is more specific than the others")
                    Choice(None, typed)

// Where no overload is the most specific, the one that takes each integer literal argument as the
// literal's own type: `int`, or `long` for a literal too large for `int`. It must also be the most
// specific one by the arguments that are not literals alone, so the literals break only the ties
// they cause. None when there is no such overload, or more than one.
private literal_preferred(c: *Checker, owners: Buf[usize], counts: Buf[usize], compared: Buf[Buf[&Type]], args: Buf[Argument]) -> Option[usize]
    var own: Buf[Option[&Type]] = buf()
    var any_literal = false
    for a in args
        if is_literal(a.value)
            own.push(Some(literal_own_type(a.value)))
            any_literal = true
        else
            own.push(None)
    if !any_literal then return None
    var rest: Buf[Buf[&Type]] = buf()
    var preferred: Buf[usize] = buf()
    for k in 0..<compared.len()
        var others: Buf[&Type] = buf()
        var takes_own = true
        for j in 0..<args.len()
            if own[j] is Some(t)
                if !same_type(strict(compared[k][j]), t) then takes_own = false
            else others.push(compared[k][j])
        rest.push(others)
        if takes_own then preferred.push(k)
    if preferred.len() != 1 then return None
    val a = preferred[0]
    for b in 0..<compared.len()
        if a != b
            if !accepts_conforming(c, rest[b], owners[b], counts[b], rest[a]) then return None
    Some(a)

// The type an integer literal, possibly negated, has where nothing else decides it.
private literal_own_type(e: &Expr) -> &Type
    var negative = false
    var spelling = ""
    e.kind match
        IntLit(s) -> spelling = s
        Unary(_, operand) ->
            negative = true
            if operand.kind is IntLit(s) then spelling = s
        _ -> ()
    val digits = literal_magnitude(spelling) match
        Some(d) -> d
        None -> return int_type()
    if fits(digits, IntBits, negative) then int_type() else Int(64)

// An argument that some candidate takes by name, checked before the overload is chosen: delayed, as
// that candidate needs it, with the type `inner` when every candidate agrees on it. A candidate that
// takes it strictly evaluates it once, at the call.
private delayed_unchosen(c: *Checker, arg: Argument, inner: Option[&Type]) -> &TExpr
    if inner is Some(t) then return delayed_argument(c, arg, ByName(t), t)
    if arg.value.kind is Name(n)
        if binding_ref(c, arg.value.span, n) is Some(t)
            if *t.ty is ByName(_) then return t
    val delayed = lambda_expr(c, arg.value, buf(), arg.value, None, true)
    val yields: &Type = *delayed.ty match
        Function(_, r) -> r
        _ -> ErrorType
    TExpr(arg.value.span, ByName(yields), delayed.kind)

// The one of `ids` more specific than each other one: its parameter types `compared[k]` are accepted
// by every other's. None when no single one is: when none is, or when two accept each other's.
private most_specific(c: *Checker, ids: Buf[usize], compared: Buf[Buf[&Type]]) -> Option[usize]
    var owners: Buf[usize] = buf()
    var counts: Buf[usize] = buf()
    for id in ids
        owners.push(c.symbols[id].type_owner)
        counts.push(c.symbols[id].type_params.len())
    most_specific_of(c, owners, counts, compared) match
        Some(k) -> Some(ids[k])
        None -> None

// The position of the candidate more specific than each other one, where candidate `k` takes the
// parameter types `compared[k]`, written in the `counts[k]` type parameters of `owners[k]`.
private most_specific_of(c: *Checker, owners: Buf[usize], counts: Buf[usize], compared: Buf[Buf[&Type]]) -> Option[usize]
    var best: Buf[usize] = buf()
    for a in 0..<compared.len()
        var wins = true
        for b in 0..<compared.len()
            if a != b && wins
                if !accepts_conforming(c, compared[b], owners[b], counts[b], compared[a]) then wins = false
        if wins then best.push(a)
    if best.len() == 1 then Some(best[0]) else None

// Whether one candidate of an overloaded call accepts its arguments: those already typed, then the
// literals and lambdas, by what their parameter types allow.
private fits_call(c: *Checker, s: Signature, binding: Binding, args: Buf[Argument], typed: Buf[Option[&TExpr]], written: Buf[&Type]) -> bool
    val saved = save_vars(c)
    var type_args: Buf[&Type] = buf()
    for i in 0..<s.type_params.len()
        type_args.push(if i < s.known.len() then s.known[i] else fresh_var(c))
    for i in 0..<written.len()
        unify(c, type_args[s.known.len() + i], written[i])
    var open = open_type_args(c, type_args, s.known.len())
    constrain_lowers(c, s.owner, s.type_params, s.known.len(), type_args, &open)
    var ok = true
    val params = substitute_all(s.params, s.owner, type_args)
    for j in 0..<args.len()
        if typed[j] is Some(t)
            val p = strict(argument_type(c, s, params, binding, args, j).unwrap())
            // A sequence spliced into a repeated parameter is any `Iterable` of its elements.
            val spliced = args[j].value.kind is Splice(_)
            if ok && !(*t.ty is Nothing)
                // An argument of a subtype, or of a covariant instance, fits as it would the call.
                val agrees = if converts_none(c, t.ty, p) then true elif mentions_open(p, &open) || spliced then constrain(c, p, strict(t.ty), &open, true) else fits(c, strict(t.ty), p) || boxes_to(c, strict(t.ty), p)
                if !agrees then ok = false
    for j in 0..<args.len()
        if ok && typed[j] is None
            val p = zonk(c, strict(argument_type(c, s, params, binding, args, j).unwrap()))
            val value = argument_value(args[j])
            val boxed = is_literal(value) && boxes_to(c, literal_own_type(value), p)
            if !boxed && !open_argument_fits(value, p) then ok = false
    restore_vars(c, saved)
    ok

// Whether a literal or a lambda, which takes its type from its parameter, can be given one of type
// `p`.
private open_argument_fits(value: &Expr, p: &Type) -> bool
    if *p is Var(_) || *p is ErrorType then return true
    if is_literal(value) then return literal_fits(value, p)
    value.kind match
        Lambda(params, _) -> *p match
            Function(ps, _) -> ps.len() == params.len()
            _ -> false
        MatchFunction(_) -> *p match
            Function(ps, _) -> ps.len() == 1
            Class(_, name, _) -> name == "PartialFunction"
            _ -> false
        _ -> true

/** Whether an argument takes its type from its parameter, and so is checked after the others: a
 * lambda, or a `match` with nothing before it. */
private takes_parameter_type(value: &Expr) -> bool = value.kind is Lambda(_, _) || value.kind is MatchFunction(_)

// Whether an integer literal, possibly negated, can be a value of type `t`, as `integer_literal`
// would make it.
private literal_fits(e: &Expr, t: &Type) -> bool
    var negative = false
    var spelling = ""
    e.kind match
        IntLit(s) -> spelling = s
        Unary(_, operand) ->
            negative = true
            if operand.kind is IntLit(s) then spelling = s
        _ -> return true
    val digits = literal_magnitude(spelling) match
        Some(d) -> d
        None -> return true
    *t match
        Int(bits) -> fits(digits, bits, negative)
        Byte -> !(negative && digits != "0") && compare_decimal(digits, "255") <= 0
        Real -> compare_decimal(digits, "9007199254740992") <= 0
        AnyType -> true
        _ -> false

/** The overloads `ids` as written, for a diagnostic: "`f(x: int)`, `f(s: string)`". */
private overload_list(c: *Checker, ids: Buf[usize]) -> string
    var labels: Buf[string] = buf()
    for id in ids
        labels.push(overload_text(c, id))
    joined_labels(labels)

/** Candidates' labels joined for a diagnostic. */
private joined_labels(labels: Buf[string]) -> string
    var out = ""
    for k in 0..<labels.len()
        if k > 0 then out = out + ", "
        out = out + labels[k]
    out

/** One overload `id` as written, for a diagnostic: "`f(x: int)`". */
private overload_text(c: *Checker, id: usize) -> string
    val f = c.symbols[id]
    // A method's receiver is not written among its parameters.
    val first = if is_method(f) then 1usize else 0usize
    var names: Buf[string] = buf()
    var params: Buf[&Type] = buf()
    for i in first..<f.params.len()
        names.push(f.param_names[i])
        params.push(f.params[i])
    // A local function shows its own type parameters, not those it shares with the enclosing code.
    candidate_text(f.name, if f.root is Some(_) then f.decl.type_params else f.type_params, names, params)

/** A candidate of a call as written, for a diagnostic: "`f[T](x: T)`". */
private candidate_text(name: string, type_params: Buf[TypeParam], names: Buf[string], params: Buf[&Type]) -> string
    var text = name
    if type_params.len() > 0
        text = text + "["
        for i in 0..<type_params.len()
            if i > 0 then text = text + ", "
            text = text + type_params[i].name
        text = text + "]"
    text = text + "("
    for i in 0..<params.len()
        if i > 0 then text = text + ", "
        text = text + names[i] + ": " + type_name(params[i])
    "`" + text + ")`"

// The type `target` names where it is the receiver of a call, as `int` in `int.zero()`, `T` in
// `T.zero()` and `Box[int]` in `Box[int].zero()`; `None` where it is a value, a value of the name
// hiding the type. A trait names no type with static members of its own, which is reported.
static_receiver(c: *Checker, target: &Expr, member: string) -> Option[&Type]
    var name = ""
    var written: Buf[&TypeExpr] = buf()
    target.kind match
        Name(n) -> name = n
        TypeApply(inner, types) ->
            if inner.kind is Name(n)
                name = n
                written = types
            else return None
        _ -> return None
    if name == "self" || name == "super" || name == "_" then return None
    if lookup_local(c, name) is Some(_) || param_index(c, name) is Some(_) then return None
    if class_member(c, name) is Some(_) || global_named(c, name) is Some(_) then return None
    // A class's name is also its constructor's, which a call on the name does not mean.
    for f in lookup_functions(c, name)
        if !c.symbols[f].constructor then return None
    val unit = unit_of(c)
    var names_type = builtin_type(name) is Some(_) || (name == "Self" && c.self_trait is Some(_)) || derived_alias(c, name)
    if c.generic is Some(scope)
        if names_type_param(scope.params, name) then names_type = true
    val key = resolve_name(c, unit, name)
    if c.types.get(key) is Some(_) then names_type = true
    if c.class_types.get(key) is Some(k)
        if is_trait(c, k)
            c.note(unit, target.span, s"`$name` is a trait, which has no static members of its own: call one on a type implementing it, as in `T.$member()` with `T: $name`")
            return Some(ErrorType)
        names_type = true
    if !names_type then return None
    Some(resolve_type(c, unit, TypeExpr(target.span, Named(name, written))))

// A call of the static member `name` of type `ty`: the type's own where the type is known, and its
// type argument's in each instance where it is a type parameter.
/** The members named `name` of known type `t`, static or not, as a call on the type's name finds
 * them; a built-in type's include those an extension the file sees adds. */
private members_of_type(c: *Checker, t: &Type, name: string) -> Buf[usize] = *t match
    Class(k, _, _) -> methods_named(c, k, name)
    _ ->
        val own = visible_methods(c, receiver_methods(c, t, name))
        if scalar_builtin(t) then with_trait_methods(c, t, name, own) else own

// `Type.name` without a call, where the type's static member `name` is meant: a function value of
// it, which takes the member's parameters. Where the member is overloaded the expected function
// type picks the one whose parameter types it has. `None` where `target` names no known type with
// a static member `name`, so the expression is read as any other member.
private static_value(c: *Checker, at: Span, target: &Expr, name: string, expected: Option[&Type]) -> Option[&TExpr]
    if !(target.kind is Name(_) || target.kind is TypeApply(_, _)) then return None
    val ty = static_receiver(c, target, name)?
    val t = zonk(c, ty)
    if *t is TypeVar(_, _, _) || *t is ErrorType then return None
    var statics: Buf[usize] = buf()
    for m in members_of_type(c, t, name)
        if c.symbols[m].static_member then statics.push(m)
    if statics.len() == 0 then return None
    val receiver = TExpr(target.span, t, TypeReceiver)
    if statics.len() == 1 then return Some(method_value(c, at, receiver, statics[0], None, expected))
    if expected is Some(want)
        if *zonk(c, want) is Function(ps, _)
            for m in statics
                val params = c.symbols[m].params
                if params.len() == ps.len() + 1 && c.symbols[m].type_params.len() == 0
                    var fits = true
                    for i in 0..<ps.len()
                        if !same_type(zonk(c, ps[i]), params[i + 1]) then fits = false
                    if fits then return Some(method_value(c, at, receiver, m, None, expected))
    c.note(unit_of(c), at, s"`${type_name(t)}.$name` has several overloads, and nothing here says which is meant; give it a function type, as in `val f: (…) -> … = ${type_name(t)}.$name`")
    Some(TExpr(at, ErrorType, UnitConst))

private static_call(c: *Checker, at: Span, name_span: Span, target: &Expr, ty: &Type, name: string, args: Buf[Argument], explicit: Option[Buf[&TypeExpr]], expected: Option[&Type]) -> &TExpr
    // In an impl made from a template, `T`'s shape and the code over its fields are written here,
    // for the deriving type.
    if target.kind is Name(n)
        if derived_alias(c, n) && is_shaped_member(name) then return shaped_call(c, at, name_span, name, args, expected)
    val unit = unit_of(c)
    val t = zonk(c, ty)
    var ms: Buf[usize] = buf()
    var reported = *t is ErrorType
    *t match
        ErrorType -> ()
        TypeVar(owner, _, _) ->
            // A trait's default body is shared by every type implementing it, so its `Self` is no
            // one type whose static member it could call.
            if c.self_trait is Some(k)
                if owner == self_owner(k)
                    c.note(unit, target.span, s"`Self.$name()` cannot be called in a trait's default body, which every type implementing the trait shares; a function bounded by the trait calls it, as `T.$name()`")
                    reported = true
            if !reported then ms = bound_methods(c, t, name)
        _ -> ms = members_of_type(c, t, name)
    var statics: Buf[usize] = buf()
    for m in ms
        if c.symbols[m].static_member then statics.push(m)
    if statics.len() == 0
        if !reported
            if ms.len() > 0 then c.note(unit, name_span, s"`$name` is a method of a value of `${type_name(t)}`, not of the type; call it on a value")
            elif !(scalar_builtin(t) && refuse_private_trait_method(c, name_span, t, name)) then c.note(unit, name_span, s"`${type_name(t)}` has no static member `$name`")
        for a in args
            check_statement(c, a.value)
        return TExpr(at, ErrorType, UnitConst)
    // The width `i1` holds 0 and -1 only, so it has no `1` for `one()` to give, as `val x: i1 = 1`
    // has no value. Reached through a generic, `one()` at `i1` traps instead.
    if *t is Int(1) && name == "one" && args.len() == 0
        c.note(unit, name_span, "`i1` has no `1`, so `i1.one()` does not exist")
        return TExpr(at, ErrorType, UnitConst)
    if *t is TypeVar(_, _, _) && statics.len() == 1 && explicit is None
        if c.symbols[statics[0]].owner_class is Some(k)
            if implemented_several_times(c, k) && c.symbols[statics[0]].decl.type_params.len() == 0
                val instances = from_sources(c, t, k)
                if instances.len() > 1 then return several_bound_call(c, at, name_span, TExpr(target.span, t, TypeReceiver), statics[0], instances, args)
    call_method(c, at, name_span, TExpr(target.span, t, TypeReceiver), name, statics, args, explicit, expected, false)

// A static member of a trait a type parameter is bounded by at several type arguments,
// `T: Make[int] + Make[string]`: the arguments decide which instance's member is called, the one
// whose parameter types they fit. Each instance of the code calls its type argument's member for it.
private several_bound_call(c: *Checker, at: Span, name_span: Span, receiver: &TExpr, m: usize, instances: Buf[&Type], args: Buf[Argument]) -> &TExpr
    val unit = unit_of(c)
    val symbol = c.symbols[m]
    var typed: Buf[&TExpr] = buf()
    for a in args
        typed.push(check_expr(c, a.value, None))
    for a in args
        if a.name is Some(_)
            c.note(unit, a.span, s"`${symbol.decl.name}` is called on a type parameter bounded by several instances of its trait, so its arguments are passed by position")
            return TExpr(at, ErrorType, UnitConst)
    var chosen: Buf[&Type] = buf()
    for instance in instances
        if typed.len() + 1 != symbol.params.len() then break
        val instance_args = *instance match
            Class(_, _, xs) -> xs
            _ -> buf()
        var accepts = true
        for i in 0..<typed.len()
            val wanted = substitute(with_self(c, m, receiver.ty, symbol.params[i + 1]), symbol.type_owner, instance_args)
            if !fits(c, typed[i].ty, wanted) && !boxes_to(c, typed[i].ty, wanted) then accepts = false
        if accepts then chosen.push(instance)
    if chosen.len() != 1
        var shown = ""
        for i in 0..<instances.len()
            if i > 0 then shown = shown + if i + 1 == instances.len() then " and " else ", "
            shown = shown + type_name(instances[i])
        var given = ""
        for i in 0..<typed.len()
            if i > 0 then given = given + ", "
            given = given + type_name(zonk(c, typed[i].ty))
        val problem = if chosen.len() == 0 then "none of them takes" else "more than one takes"
        c.note(unit, name_span, s"`${type_name(receiver.ty)}` is bounded by $shown, and $problem `${symbol.decl.name}($given)`")
        return TExpr(at, ErrorType, UnitConst)
    val instance_args = *chosen[0] match
        Class(_, _, xs) -> xs
        _ -> buf()
    var call_args: Buf[&TExpr] = buf()
    call_args.push(receiver)
    for i in 0..<typed.len()
        val wanted = substitute(with_self(c, m, receiver.ty, symbol.params[i + 1]), symbol.type_owner, instance_args)
        call_args.push(to_trait(c, typed[i], zonk(c, wanted)))
    val result = substitute(with_self(c, m, receiver.ty, symbol.result.unwrap_or(ErrorType)), symbol.type_owner, instance_args)
    TExpr(at, result, BoundCall(m, bound_slot(c, m), call_args, instance_args))

// A static member belongs to its type, so it is called on the type and never on a value.
private refuse_static_on_value(c: *Checker, at: Span, receiver: &TExpr, m: usize) -> bool
    val target = c.symbols[m]
    if !target.static_member || receiver.kind is TypeReceiver then return false
    // A receiver already reported, as `self` in a static member's body is, names no type to show.
    if *zonk(c, receiver.ty) is ErrorType then return true
    val shown = type_name(zonk(c, receiver.ty))
    c.note(unit_of(c), at, s"`${target.decl.name}` is static: it belongs to the type, so it is called on the type, as in `$shown.${target.decl.name}()`, not on a value")
    true

// `object.name(args)`: a method of the object's class, or a field holding a function, which is
// called as a value.
private member_call(c: *Checker, at: Span, callee: &Expr, name_span: Span, target: &Expr, name: string, args: Buf[Argument], explicit: Option[Buf[&TypeExpr]], expected: Option[&Type], infix: bool) -> &TExpr
    val unit = unit_of(c)
    if target.kind is Name("super")
        if lookup_local(c, "super") is None && enclosing_class(c) is Some(_)
            return super_call(c, at, name_span, target.span, name, args, explicit, expected)
    // `i8.wrap(x)` converts an integer keeping the low bits, where `i8(x)` traps on a value that does
    // not fit; a value of the name hides the type.
    if !infix && name == "wrap" && explicit is None && target.kind is Name(type_name_written)
        if lookup_local(c, type_name_written) is None && param_index(c, type_name_written) is None
            if builtin_type(type_name_written) is Some(to) then return conversion(c, at, to, args, true)
            if integer_param_named(c, type_name_written) is Some(to) then return conversion(c, at, to, args, true)
    if !infix
        if static_receiver(c, target, name) is Some(ty) then return static_call(c, at, name_span, target, ty, name, args, explicit, expected)
    val object = check_expr(c, target, None)
    if *zonk(c, object.ty) is Class(k, _, _)
        val ms = with_trait_methods(c, object.ty, name, methods_named(c, k, name))
        if ms.len() > 0
            if infix && !takes_one_argument(c, ms) then return infix_arity_error(c, at, name_span, target, name, ms, args)
            return call_method(c, at, name_span, object, name, ms, args, explicit, expected, false)
        if method_named(c, k, name) is Some(m)
            c.note(unit, name_span, s"`$name` is private to `${c.classes[c.symbols[m].owner_class.unwrap()].name}`")
            for a in args
                check_statement(c, a.value)
            return TExpr(at, ErrorType, UnitConst)
    if methods_of(c, object.ty, name).len() == 0 && refuse_private_trait_method(c, name_span, object.ty, name)
        for a in args
            check_statement(c, a.value)
        return TExpr(at, ErrorType, UnitConst)
    // A value of a type parameter has the methods of its bounds, and no others but the `equals` and
    // `hash` every value has.
    if *zonk(c, object.ty) is TypeVar(_, _, _)
        val ty = zonk(c, object.ty)
        val ms = with_trait_methods(c, ty, name, bound_methods(c, ty, name))
        if ms.len() > 0
            if infix && !takes_one_argument(c, ms) then return infix_arity_error(c, at, name_span, target, name, ms, args)
            return call_method(c, at, name_span, object, name, ms, args, explicit, expected, false)
        val universal = c.core.method_named(name) match
            Some(m) -> is_universal(c, m)
            None -> false
        if !universal && bound_field(c, ty, name) is None && bound_class_field(c, ty, name) is None
            no_bound_member(c, name_span, ty, name)
            for a in args
                check_statement(c, a.value)
            return TExpr(at, ErrorType, UnitConst)
    val all = in_scope_on_context(c, zonk(c, object.ty), receiver_methods(c, zonk(c, object.ty), name))
    val ms = in_scope_on_context(c, zonk(c, object.ty), with_trait_methods(c, object.ty, name, visible_methods(c, all)))
    if all.len() > 0 || ms.len() > 0
        if ms.len() == 0
            c.note(unit, name_span, s"`$name` is private to the impls of `${type_name(c.symbols[all[0]].receiver.unwrap())}`")
            for a in args
                check_statement(c, a.value)
            return TExpr(at, ErrorType, UnitConst)
        if infix && !takes_one_argument(c, ms) then return infix_arity_error(c, at, name_span, target, name, ms, args)
        return call_method(c, at, name_span, object, name, ms, args, explicit, expected, false)
    // Every value has `Eq`'s `equals` and `Hash`'s `hash`, its own or by value or identity.
    if c.core.method_named(name) is Some(m)
        if is_universal(c, m) && !(*zonk(c, object.ty) is ErrorType)
            val ms = buf1u(m)
            if infix && !takes_one_argument(c, ms) then return infix_arity_error(c, at, name_span, target, name, ms, args)
            return call_method(c, at, name_span, object, name, ms, args, explicit, expected, false)
    // A value of `Any` or of a trait has `Display`'s and `Debug`'s methods, which its own type answers.
    val rendering = rendering_methods(c, zonk(c, object.ty), name)
    if rendering.len() > 0
        if infix && !takes_one_argument(c, rendering) then return infix_arity_error(c, at, name_span, target, name, rendering, args)
        return call_method(c, at, name_span, object, name, rendering, args, explicit, expected, false)
    if infix
        if !(*zonk(c, object.ty) is ErrorType)
            c.note(unit, name_span, s"`${type_name(zonk(c, object.ty))}` has no method `$name` to call infix" + split_hint(name))
        for a in args
            check_statement(c, a.value)
        return TExpr(at, ErrorType, UnitConst)
    if explicit is Some(_)
        for a in args
            check_statement(c, a.value)
        return unsupported(c, callee, "type arguments on a call of a field")
    call_checked(c, at, name_span, member_of(c, callee, object, name, None), args)

// `a m b` is the call `a.m(b)`. It names a method of `a`'s type: a field holding a function and a
// function `m` of two parameters are not called infix.
private infix_call(c: *Checker, at: Span, target: &Expr, name: string, name_span: Span, arg: &Expr, expected: Option[&Type]) -> &TExpr
    var args: Buf[Argument] = buf()
    args.push(Argument(arg.span, None, arg, false))
    var callee_span = target.span.to(name_span)
    if groups_right(name)
        c.operand_first.push(name_span)
        callee_span = name_span.to(target.span)
    val callee = Expr(callee_span, Member(target, name))
    member_call(c, at, callee, name_span, target, name, args, None, expected, true)

// An operator is the longest run of operator characters, so `x=-1` reads `=-` as one name. When a
// name is an operator of the language followed by a prefix operator, the message says so.
private split_hint(name: string) -> string
    val n = name.bytes.len
    if n < 2 || !is_operator_spelling(name) || name == "++" || name == "--" then return ""
    val last = name[(n - 1)..<n]
    val head = name[0..<n - 1]
    if (last == "-" || last == "+" || last == "!" || last == "~") && (language_operator(head) || compound_operator(head))
        return s"; `$head` followed by a prefix `$last` needs a space between them"
    ""

// Whether one of the methods `ms` can be called with exactly one argument.
private takes_one_argument(c: *Checker, ms: Buf[usize]) -> bool
    for m in ms
        val s = c.symbols[m]
        var required = 0usize
        // A repeated parameter takes zero arguments or more, so it is never required.
        val repeated = declares_variadic(s.decl)
        for i in 1..<s.params.len()
            if repeated && i + 1 == s.params.len() then continue
            if i >= s.defaults.len() || s.defaults[i] is None then required += 1
        if required <= 1 && s.params.len() >= 2 then return true
    false

// Whether one of the methods `ms` can be called with no argument: the method `-` a prefix `-` calls.
private takes_no_argument(c: *Checker, ms: Buf[usize]) -> bool
    for m in ms
        val s = c.symbols[m]
        var required = 0usize
        val repeated = declares_variadic(s.decl)
        for i in 1..<s.params.len()
            if repeated && i + 1 == s.params.len() then continue
            if i >= s.defaults.len() || s.defaults[i] is None then required += 1
        if required == 0 then return true
    false

// An infix call of a method that takes some other number of arguments. A tuple written as the
// argument is spelled back as the arguments of a dotted call.
private infix_arity_error(c: *Checker, at: Span, name_span: Span, target: &Expr, name: string, ms: Buf[usize], args: Buf[Argument]) -> &TExpr
    val unit = unit_of(c)
    val count = c.symbols[ms[0]].params.len() - 1
    val src = c.units[unit].src
    val receiver = from_utf8_unchecked(src.text(target.span))
    var inner = "…"
    if args[0].value.kind is Tuple(items)
        inner = ""
        for i in 0..<items.len()
            if i > 0 then inner = inner + ", "
            inner = inner + from_utf8_unchecked(src.text(items[i].span))
    elif count == 0 then inner = ""
    val counted = if count == 1 then "1 argument" else s"$count arguments"
    c.note(unit, name_span, s"`$name` takes $counted, and only a method of one argument is called infix; write `$receiver.$name($inner)`")
    for a in args
        check_statement(c, a.value)
    TExpr(at, ErrorType, UnitConst)

// `super.name(args)` calls the superclass's implementation of a method on `self`, directly, even where
// the class overrides it.
private super_call(c: *Checker, at: Span, name_span: Span, super_span: Span, name: string, args: Buf[Argument], explicit: Option[Buf[&TypeExpr]], expected: Option[&Type]) -> &TExpr
    val unit = unit_of(c)
    val k = enclosing_class(c).unwrap()
    var ms: Buf[usize] = buf()
    var sup: &Type = ErrorType
    if c.classes[k].superclass is Some(t)
        sup = t
        if *t is Class(s, _, _)
            ms = methods_named(c, s, name)
            if ms.len() == 0 then c.note(unit, name_span, s"`${c.classes[s].name}` has no method `$name` for `super` to call")
    else c.note(unit, super_span, s"`${c.classes[k].name}` has no superclass for `super` to name")
    if c.super_args
        c.note(unit, super_span, "a superclass's arguments cannot call a method: they run before the object is initialized")
        ms = buf()
    if ms.len() == 0
        for a in args
            check_statement(c, a.value)
        return TExpr(at, ErrorType, UnitConst)
    val self_value = self_ref(c, super_span)
    val receiver = TExpr(super_span, sup, self_value.kind)
    val choice = pick_method(c, at, name_span, receiver, name, ms, args, explicit)
    val m = choice.id match
        Some(m) -> m
        None -> return TExpr(at, ErrorType, UnitConst)
    if is_abstract_method(c.symbols[m])
        c.note(unit, name_span, s"`${c.symbols[m].name}` is abstract, so `super` cannot call it")
        for i in 0..<args.len()
            if i >= choice.typed.len() || choice.typed[i] is None then check_statement(c, args[i].value)
        return TExpr(at, ErrorType, UnitConst)
    method_call(c, at, name_span, receiver, m, args, explicit, expected, true, choice.typed)

// The method of `ms`, the methods of `name` the receiver's type has, that a call chooses, and its
// arguments as checked while choosing. One method is chosen without looking at the arguments.
private pick_method(c: *Checker, at: Span, name_span: Span, receiver: &TExpr, name: string, ms: Buf[usize], args: Buf[Argument], explicit: Option[Buf[&TypeExpr]]) -> Choice
    if ms.len() == 1 || *receiver.ty is Nothing then return Choice(Some(ms[0]), buf())
    var signatures: Buf[Signature] = buf()
    for m in ms
        signatures.push(method_signature(c, receiver, m, ErrorType))
    choose(c, at, name_span, name, ms, signatures, args, explicit)

// A call of a method of `name` on `receiver`, chosen among the overloads `ms` its type has.
private call_method(c: *Checker, at: Span, name_span: Span, receiver: &TExpr, name: string, ms: Buf[usize], args: Buf[Argument], explicit: Option[Buf[&TypeExpr]], expected: Option[&Type], direct: bool) -> &TExpr
    if refuse_trait_clash(c, name_span, receiver.ty, name, ms)
        for a in args
            check_statement(c, a.value)
        return TExpr(at, ErrorType, UnitConst)
    val choice = pick_method(c, at, name_span, receiver, name, ms, args, explicit)
    choice.id match
        Some(m) -> method_call(c, at, name_span, receiver, m, args, explicit, expected, direct, choice.typed)
        None -> TExpr(at, ErrorType, UnitConst)

// A method's signature as a call on `receiver` sees it: its parameters past the receiver, and the
// type arguments of its class, or of the data type its impl adds it to, known from the receiver's
// type. An inherited method's types name its own class's parameters, so the receiver is seen as an
// instance of that class. Its defaults are computed from the receiver, which is passed to each.
private method_signature(c: *Checker, receiver: &TExpr, m: usize, result: &Type) -> Signature
    val target = c.symbols[m]
    val known = receiver_type_args(c, receiver.ty, m)
    var params: Buf[&Type] = buf()
    var names: Buf[string] = buf()
    var defaults: Buf[Option[usize]] = buf()
    for i in 1..<target.params.len()
        params.push(with_self(c, m, receiver.ty, target.params[i]))
        names.push(target.param_names[i])
        defaults.push(if i < target.defaults.len() then target.defaults[i] else None)
    Signature(target.decl.name, true, target.type_params, target.type_owner, params, names, defaults, with_self(c, m, receiver.ty, result), known, Some(receiver), declares_variadic(target.decl), function_sites(c, m, 1))

/** Type `t` of method `m` with the `Self` of a trait declaring `m` as the receiver's type. */
private with_self(c: *Checker, m: usize, receiver_type: &Type, t: &Type) -> &Type
    val k = c.symbols[m].owner_class match
        Some(k) -> k
        None -> return t
    if !is_trait(c, k) then return t
    var implementer: Buf[&Type] = buf()
    implementer.push(zonk(c, receiver_type))
    substitute(t, self_owner(k), implementer)

// Reports a call of method `m` on a receiver of type `receiver_type` that has the method only through
// a conformance that does not hold at its type arguments: a method of an impl with bounds of its own
// the arguments miss, or a trait's method the type reaches only through such an impl. A method a
// class's subclass inherits is decided at the type arguments the subclass gives that class.
private refuse_unmet_conformance(c: *Checker, at: Span, receiver_type: &Type, m: usize) -> bool
    val t = zonk(c, receiver_type)
    val symbol = c.symbols[m]
    // A method an impl with bounds of its own adds to a trait needs the trait's arguments, as the
    // receiver has them, to meet those bounds.
    if trait_method_of(c, m) is Some(tm)
        // One an impl adds to a type built from its parameters needs the receiver to match it.
        if added_args(c, t, tm) is None
            c.note(unit_of(c), at, s"`${symbol.decl.name}` is for ${added_target_phrase(tm)}; this is `${type_name(t)}`")
            return true
        val known = receiver_type_args(c, t, m)
        val f = conformances(c)
        for i in 0..<tm.impl_params
            for b in bounds_at(c, symbol.type_owner, symbol.type_params, i)
                if !meets_bound(f, zonk(c, known[i]), zonk(c, substitute(b, symbol.type_owner, known)))
                    c.note(unit_of(c), at, s"`${symbol.decl.name}` needs `${symbol.type_params[i].name}: ${type_name(b)}`, which ${type_name(t)} does not meet")
                    return true
        return false
    var declaring = t
    if symbol.owner_class is Some(k)
        if !is_trait(c, k) then declaring = ancestor_type(c.classes, c.data, t, k).unwrap_or(t)
    val owner = *declaring match
        Class(k, _, _) -> class_owner(k)
        Data(d, _, _) -> data_owner(d)
        _ -> return false
    val args = *declaring match
        Class(_, _, a) -> a
        Data(_, _, a) -> a
        _ -> buf()
    val f = conformances(c)
    for x in c.conditional_methods
        if x.owner != owner || x.params.len() == 0 || symbol.unit != x.unit then continue
        if symbol.type_params.len() < x.params.len() || symbol.type_params[0].site != x.params[0].site then continue
        if unmet_condition(f, x.owner, x.conditions, args) is Some((i, b))
            c.note(unit_of(c), at, s"`${symbol.decl.name}` needs `${x.params[i].name}: ${type_name(b)}`, which ${type_name(t)} does not meet")
            return true
    var missing: Option[usize] = None
    for x in c.conditional
        if x.owner != owner || x.params.len() == 0 || symbol.unit != x.unit then continue
        if symbol.type_params.len() < x.params.len() || symbol.type_params[0].site != x.params[0].site then continue
        if !conditions_met(f, x, args) then missing = Some(x.trait_id)
    if missing is None
        if symbol.owner_class is Some(k)
            if is_trait(c, k) && ancestor_type(c.classes, c.data, t, k) is Some(_) && holding_ancestor(f, t, k) is None then missing = Some(k)
    val k = missing match
        Some(k) -> k
        None -> return false
    c.note(unit_of(c), at, s"`${symbol.decl.name}` is a method of `${c.classes[k].name}`, which ${type_name(t)} does not implement")
    true

// A method call passes the receiver first. The class's type arguments come from the receiver's
// type, and the method's own, which follow them, are written or inferred as for a function.
private method_call(c: *Checker, at: Span, name_span: Span, receiver: &TExpr, m: usize, args: Buf[Argument], explicit: Option[Buf[&TypeExpr]], expected: Option[&Type], direct: bool, checked: Buf[Option[&TExpr]]) -> &TExpr
    val target = c.symbols[m]
    val unmet = refuse_unmet_conformance(c, name_span, receiver.ty, m) || refuse_static_on_value(c, name_span, receiver, m)
    if *receiver.ty is Nothing || unmet
        for i in 0..<args.len()
            if i >= checked.len() || checked[i] is None then check_statement(c, args[i].value)
        return if unmet then TExpr(at, ErrorType, UnitConst) else receiver
    // The receiver is evaluated before the arguments, so one that is computed is held while they are.
    var setup: Option[&TExpr] = None
    var object = receiver
    if !(receiver.kind is Local(_) || receiver.kind is Param(_) || receiver.kind is TypeReceiver)
        val held = hidden_local(c, receiver.ty)
        setup = Some(TExpr(receiver.span, Unit, Let(held, receiver)))
        object = TExpr(receiver.span, receiver.ty, Local(held))
    var applied = apply(c, at, name_span, method_signature(c, object, m, result_of(c, m, at)), args, explicit, expected, checked)
    // A call written `x +: xs` evaluates `x`, written first, before the receiver `xs`.
    var first: Option[&TExpr] = None
    if !applied.cut && applied.args.len() > 0 && operand_first(c, name_span)
        if applied.prelude.len() > 0
            first = Some(applied.prelude[0])
            var rest: Buf[&TExpr] = buf()
            for i in 1..<applied.prelude.len()
                rest.push(applied.prelude[i])
            applied.prelude = rest
        else
            val a = applied.args[0]
            if !(a.kind is Local(_) || a.kind is Param(_) || a.kind is IntConst(_) || a.kind is BoolConst(_) || a.kind is CharConst(_) || a.kind is RealConst(_) || a.kind is StrConst(_))
                val held = hidden_local(c, a.ty)
                first = Some(TExpr(a.span, Unit, Let(held, a)))
                applied.args.set(0, TExpr(a.span, a.ty, Local(held)))
    var typed: Buf[&TExpr] = buf()
    typed.push(object)
    for a in applied.args
        typed.push(a)
    val call = applied.wrap(at, method_call_kind(c, receiver.ty, m, typed, applied.type_args, direct))
    if setup is None && first is None then return call
    var items: Buf[&TExpr] = buf()
    if first is Some(f) then items.push(f)
    if setup is Some(s) then items.push(s)
    items.push(call)
    TExpr(at, call.ty, Block(items))

// Whether the call whose method name is at `name_span` is written with its receiver on the right.
private operand_first(c: *Checker, name_span: Span) -> bool
    for s in c.operand_first
        if s.start == name_span.start && s.end == name_span.end then return true
    false

// The type arguments of method `m`'s class, or of the data type an impl adds it to, as a receiver of
// type `receiver_type` has them. An inherited method's types name its own class's parameters, so the
// receiver is seen as an instance of that class.
private receiver_type_args(c: *Checker, receiver_type: &Type, m: usize) -> Buf[&Type]
    val t = zonk(c, receiver_type)
    // A method an impl adds to a trait takes the impl's arguments as the receiver's type gives them
    // in the type the impl adds to, then the receiver's own type as `Self`; one an impl adds to a
    // data type, a class or a built-in type built from its parameters has no `Self`.
    if trait_method_of(c, m) is Some(tm)
        var args: Buf[&Type] = buf()
        if added_args(c, t, tm) is Some(found)
            for x in found
                args.push(x)
        while args.len() < tm.impl_params
            args.push(ErrorType)
        if tm.on_trait then args.push(t)
        return args
    // A method of an impl for every integer width takes the receiver's width as its parameter.
    if c.symbols[m].type_owner == integer_owner()
        var width: Buf[&Type] = buf()
        width.push(t)
        return width
    // One of an impl for every tuple of an arity takes the receiver's parts as its parameters.
    if is_tuple_owner(c.symbols[m].type_owner)
        if *t is Tuple(parts) then return parts
    // A type parameter has the methods of its bounds, as an instance of them.
    if *t is TypeVar(_, _, _)
        if c.symbols[m].owner_class is Some(k)
            for b in bounds_of(c, t)
                if ancestor_type(c.classes, c.data, b, k) is Some(up)
                    if *up is Class(_, _, a) then return a
        return buf()
    c.symbols[m].owner_class match
        Some(k) -> *ancestor_type(c.classes, c.data, t, k).unwrap_or(t) match
            Class(_, _, a) -> a
            _ -> buf()
        None -> *t match
            Data(_, _, a) -> a
            _ -> buf()

// A method a subclass may override is called through the object's method table, unless the
// receiver's class is final, so the method is known. Through a trait, the method is at the trait's
// position in the table of whatever class the object has.
private dispatch_slot(c: *Checker, receiver_type: &Type, m: usize) -> Option[usize]
    if *zonk(c, receiver_type) is Class(r, _, _)
        if is_trait(c, r) then return Some(trait_slot(c, m))
        if is_open(c, r) then return table_position(c, r, m)
    // `Any` has the methods of `Display` and `Debug`, which its value's own type answers.
    if *zonk(c, receiver_type) is AnyType
        if c.symbols[m].owner_class is Some(k)
            if is_trait(c, k) then return Some(trait_slot(c, m))
    None

// How a call of method `m` on a receiver of type `receiver_type` is made, with `args` the receiver
// and the arguments. A `super` call names its method directly, even where the class overrides it.
// On a type parameter the call goes to the method of whatever type each instance has: it is placed
// at the position the method has in every table that holds it.
private method_call_kind(c: *Checker, receiver_type: &Type, m: usize, args: Buf[&TExpr], type_args: Buf[&Type], direct: bool) -> TExprKind
    // A method an impl adds to a trait is in no method table: its instance for the receiver's type
    // is called.
    if direct || trait_method_of(c, m) is Some(_) then return Call(m, args, type_args)
    // A static member called on a type that is known is that type's own; on a type parameter, each
    // instance calls its type argument's.
    if c.symbols[m].static_member && !(*zonk(c, receiver_type) is TypeVar(_, _, _)) then return Call(m, args, type_args)
    // `equals` and `hash` are decided by the receiver's type in every instance: its own, or by value
    // or identity.
    if is_universal(c, m) then return BoundCall(m, Some(trait_slot(c, m)), args, type_args)
    if *zonk(c, receiver_type) is TypeVar(_, _, _) then return BoundCall(m, bound_slot(c, m), args, type_args)
    dispatch_slot(c, receiver_type, m) match
        Some(s) -> Dispatch(m, s, args, type_args)
        None -> Call(m, args, type_args)

// The table position of a method reached through a bound: a trait's, or an open class's when the
// method may be overridden. A final class's method is the one called.
private bound_slot(c: *Checker, m: usize) -> Option[usize]
    val k = c.symbols[m].owner_class?
    if is_trait(c, k) then return Some(trait_slot(c, m))
    if is_open(c, k) then return table_position(c, k, m)
    None

/** A value made by a variant: a call of the variant with its fields, or the variant's bare name
 * when it has none. */
private construct(c: *Checker, at: Span, name_span: Span, v: VariantRef, args: Buf[Argument], explicit: Option[Buf[&TypeExpr]], expected: Option[&Type]) -> &TExpr
    construct_checked(c, at, name_span, v, args, explicit, expected, buf())

// A variant made by a call, with `typed` holding the arguments already checked, if any.
private construct_checked(c: *Checker, at: Span, name_span: Span, v: VariantRef, args: Buf[Argument], explicit: Option[Buf[&TypeExpr]], expected: Option[&Type], typed: Buf[Option[&TExpr]]) -> &TExpr
    val applied = apply(c, at, name_span, variant_signature(c, v), args, explicit, expected, typed)
    applied.wrap(at, Construct(v.index, applied.args))

/** What a call of variant `v` is checked against: its fields, in the type parameters of its type. */
private variant_signature(c: *Checker, v: VariantRef) -> Signature
    val d = c.data[v.data]
    val variant = d.variants[v.index]
    val called = variant.fields.len() > 0
    Signature(variant.name, called, d.decl.type_params, data_owner(v.data), variant.fields, variant.field_names, variant.defaults, own_type(d, v.data), buf(), None, false, variant_sites(c, v))

/** What a call is checked against: a function's or a variant's parameters and result, written in
 * terms of the type parameters `type_params` that belong to `owner`. `called` is false for a variant
 * with no fields, which is written without parentheses. `defaults` names, for each parameter with a
 * default, the function that computes it. */
private struct Signature
    name: string
    called: bool
    type_params: Buf[TypeParam]
    owner: usize
    params: Buf[&Type]
    names: Buf[string]
    defaults: Buf[Option[usize]]
    result: &Type
    /** Leading type arguments already decided, a method's class's from its receiver; written type
     * arguments follow them. */
    known: Buf[&Type]
    /** A method's receiver, as the call holds it: its defaults take it before the parameters. */
    receiver: Option[&TExpr]
    /** Whether the last parameter is repeated: its type is `Vector[T]`, and the call gives it any
     * number of `T`s, or one sequence spliced with `xs*`. */
    variadic: bool
    /** Where each parameter is declared, for an argument written with its name; empty unless the
     * check is recording references. */
    sites: Buf[Option[ParamSite]]

/** A call's arguments, one per parameter in parameter order, its solved type arguments, and its
 * result type. `prelude` evaluates what the call needs first: the written arguments in the order
 * written, then the omitted ones' defaults; when an argument never finishes, the prelude ends with it
 * and there is no call. */
private struct Applied
    args: Buf[&TExpr]
    type_args: Buf[&Type]
    result: &Type
    prelude: Buf[&TExpr]
    cut: bool

    /** The call made by `kind`, after the prelude. */
    wrap(self, at: Span, kind: TExprKind) -> &TExpr
        if self.cut then return TExpr(at, Nothing, Block(self.prelude))
        val call = TExpr(at, self.result, kind)
        if self.prelude.len() == 0 then return call
        var items: Buf[&TExpr] = buf()
        for p in self.prelude
            items.push(p)
        items.push(call)
        TExpr(at, self.result, Block(items))
end Applied

/** Whether a parameter of this type takes a trailing block: it is by-name, and the block is its delayed
 * expression, or a function, and the block is a lambda's body. */
private takes_block(t: &Type) -> bool = *t is ByName(_) || *t is Function(_, _)

// Why a trailing block cannot be given to the parameter `name` of `callee`, of type `t`.
private block_refused(name: string, noun: string, callee: string, t: &Type) -> string =
    s"the indented block after the call is given to `$name`, the last $noun of `$callee`, which is ${type_name(t)}: a trailing block is given only to a by-name parameter (`-> T`) or a function"

/** Which written argument each parameter takes. `slots` has one entry per parameter: the index of
 * its argument, or `None` when it is left to its default. `targets` has one per written argument:
 * the parameter it is given to, or `None` when it fits none. `fits` is false when the call cannot be
 * made, already reported. */
private struct Binding
    slots: Buf[Option[usize]]
    targets: Buf[Option[usize]]
    fits: bool

// Matches a call's arguments to a signature's parameters: positional arguments first, in order, then
// named ones, each naming a parameter not already given; a parameter given nothing must have a
// default. This is the step that decides whether a call fits a signature; with `report` false it
// only answers, which is how a candidate overload is tried.
private bind_arguments(c: *Checker, at: Span, s: Signature, args: Buf[Argument], report: bool) -> Binding
    val unit = unit_of(c)
    val noun = if s.owner >= data_owner(0) then "field" else "parameter"
    var slots: Buf[Option[usize]] = buf()
    for _ in s.params
        slots.push(None)
    var targets: Buf[Option[usize]] = buf()
    var fits = true
    var named = false
    var positional = 0usize
    // A repeated parameter takes every positional argument from its position on, or one sequence
    // spliced with `xs*` as the only one.
    val repeated: Option[usize] = if s.variadic then Some(s.params.len() - 1) else None
    for j in 0..<args.len()
        val a = args[j]
        if a.block
            // An indented block after the call's line is given to the last parameter, which takes
            // a delayed expression or a function.
            val last = s.params.len()
            if last == 0 || slots[last - 1] is Some(_)
                if report
                    if last == 0 then c.note(unit, a.span, s"`${s.name}` takes no arguments, so the indented block after the call has no $noun to be given to")
                    else c.note(unit, a.span, s"the indented block after the call is given to the last $noun of `${s.name}`, `${s.names[last - 1]}`, which is already given")
                fits = false
                targets.push(None)
                continue
            if !takes_block(s.params[last - 1]) || repeated == Some(last - 1)
                if report then c.note(unit, a.span, block_refused(s.names[last - 1], noun, s.name, s.params[last - 1]))
                fits = false
                targets.push(None)
                continue
            slots.set(last - 1, Some(j))
            targets.push(Some(last - 1))
            continue
        val spliced = a.value.kind is Splice(_)
        a.name match
            None ->
                if named
                    if report then c.note(unit, a.span, "a positional argument cannot follow a named one")
                    fits = false
                    targets.push(None)
                    continue
                positional += 1
                if repeated is Some(r)
                    if j >= r
                        if spliced && (j != r || j + 1 < args.len())
                            if report then c.note(unit, a.span, s"a spliced sequence is the only argument of the repeated parameter `${s.names[r]}`; write the other elements into the sequence")
                            fits = false
                        elif !spliced && j > r && args[r].value.kind is Splice(_)
                            fits = false
                        if slots[r] is None then slots.set(r, Some(j))
                        targets.push(Some(r))
                        continue
                if spliced
                    if report
                        val given = if j < s.params.len() then s"`${s.names[j]}`, which is not repeated" else "no parameter"
                        c.note(unit, a.span, s"`*` passes a sequence to a repeated parameter, but this argument of `${s.name}` is given to $given")
                    fits = false
                    targets.push(None)
                    continue
                if j < s.params.len()
                    slots.set(j, Some(j))
                    targets.push(Some(j))
                else targets.push(None)
            Some(n) ->
                named = true
                var k: Option[usize] = None
                for i in 0..<s.names.len()
                    if s.names[i] == n && n != "_" then k = Some(i)
                if k is Some(i) && repeated == Some(i)
                    if report then c.note(unit, a.span, s"`$n` is a repeated parameter, given its arguments by position: `${s.name}(…, a, b)` or `${s.name}(…, xs*)`")
                    fits = false
                    targets.push(None)
                    continue
                if spliced
                    if report then c.note(unit, a.span, "`*` passes a sequence to a repeated parameter, by position, not to a named argument")
                    fits = false
                k match
                    None ->
                        if report then c.note(unit, a.span, s"`${s.name}` has no $noun `$n`")
                        fits = false
                        targets.push(None)
                    Some(i) ->
                        if slots[i] is Some(_)
                            if report then c.note(unit, a.span, s"`$n` is given more than once")
                            fits = false
                            targets.push(None)
                        else
                            slots.set(i, Some(j))
                            targets.push(Some(i))
    var has_defaults = false
    for d in s.defaults
        if d is Some(_) then has_defaults = true
    if positional > s.params.len() && !s.variadic
        if report then c.note(unit, at, s"`${s.name}` takes ${count(s.params.len(), "argument")}, not $positional")
        return Binding(slots, targets, false)
    // A call already reported for a misplaced or misnamed argument is not also reported for the
    // parameter that argument was probably meant for.
    if !fits then return Binding(slots, targets, false)
    var missing: Buf[string] = buf()
    for i in 0..<s.params.len()
        if slots[i] is None && s.defaults[i] is None && repeated != Some(i) then missing.push(s.names[i])
    if missing.len() > 0
        fits = false
        if !report then return Binding(slots, targets, false)
        if !named && !has_defaults && s.variadic
            c.note(unit, at, s"`${s.name}` takes at least ${count(s.params.len() - 1, "argument")}, not ${args.len()}")
        elif !named && !has_defaults
            c.note(unit, at, s"`${s.name}` takes ${count(s.params.len(), "argument")}, not ${args.len()}")
        else
            for m in missing
                c.note(unit, at, s"`${s.name}` needs an argument for `$m`, which has no default")
    Binding(slots, targets, fits)

// Records each name written in an argument (`width = 3`) as a reference to the parameter it names.
private index_argument_names(c: *Checker, unit: usize, s: Signature, args: Buf[Argument], binding: Binding)
    if c.index is None then return
    for j in 0..<args.len()
        if j >= binding.targets.len() then break
        val n = args[j].name match
            Some(n) -> n
            None -> continue
        val i = binding.targets[j] match
            Some(i) -> i
            None -> continue
        if i >= s.sites.len() || i >= s.params.len() then continue
        if s.sites[i] is Some(site)
            index_argument_name(c, unit, Span(args[j].span.start, args[j].span.start + n.bytes.len), site, s.params[i])

// Checks a call against a signature: binds its arguments to the parameters, solves the type
// arguments, and checks each argument against its parameter's type. `checked` holds, for an
// overloaded call, the arguments checked while its overload was chosen; it is empty otherwise.
private apply(c: *Checker, at: Span, name_span: Span, s: Signature, args: Buf[Argument], explicit: Option[Buf[&TypeExpr]], expected: Option[&Type], checked: Buf[Option[&TExpr]]) -> Applied
    val unit = unit_of(c)
    val name = s.name
    val called = s.called
    val type_params = s.type_params
    val owner = s.owner
    val params = s.params
    val result = s.result
    val known = s.known
    var binding = bind_arguments(c, at, s, args, true)
    index_argument_names(c, unit, s, args, binding)
    val first = c.vars.len()
    var type_args: Buf[&Type] = buf()
    for i in 0..<type_params.len()
        type_args.push(if i < known.len() then known[i] else fresh_var(c))
    // Written type arguments may be a leading prefix, with the rest inferred.
    if explicit is Some(types)
        val unknown = type_params.len() - known.len()
        if types.len() > unknown
            c.note(unit, name_span, s"`$name` takes ${count(unknown, "type argument")}, not ${types.len()}")
        else
            for i in 0..<types.len()
                unify(c, type_args[known.len() + i], resolve_type(c, unit, types[i]))
    val wanted = substitute_all(params, owner, type_args)
    val declared = substitute(result, owner, type_args)
    // The expected type decides a type argument only where it admits that argument's lower bound: a
    // `getOrElse[W >: V]` of `string` values passed where a `Display` is expected takes `W` from its
    // bound, and its `string` result is then passed as a `Display` is.
    if expected is Some(want)
        val saved = save_vars(c)
        unify(c, declared, want)
        if !admits_lowers(c, owner, type_params, known.len(), type_args) then restore_vars(c, saved)
    var targets: Buf[Option[&Type]] = buf()
    for j in 0..<binding.targets.len()
        targets.push(argument_type(c, s, wanted, binding, args, j))
    var open = open_type_args(c, type_args, known.len())
    constrain_lowers(c, owner, type_params, known.len(), type_args, &open)
    // Binding has placed, or reported, each spliced sequence, which is checked as the sequence it is.
    var passed_args: Buf[Argument] = buf()
    for a in args
        passed_args.push(Argument(a.span, a.name, argument_value(a), a.block))
    var typed = check_arguments(c, passed_args, targets, checked, &open)
    // A type argument the arguments settled settles those its bounds name: `[S: Source[A], A]`
    // takes `A` from the source `S` is.
    for i in known.len()..<type_params.len()
        val arg = zonk(c, type_args[i])
        if *arg is Var(_) then continue
        for b in bounds_at(c, owner, type_params, i)
            val bound = substitute(b, owner, type_args)
            if *bound is Class(bk, _, _)
                if ancestor_type(c.classes, c.data, arg, bk) is Some(up) then unify(c, up, bound)
    // An argument of type `Nothing` never produces a value, so the call is never made and constrains
    // nothing: a type argument it alone would have decided is `Nothing`, the least type, as in
    // `identity(break 42)` or `println(fail("unreachable"))`.
    var never = false
    for t in typed
        if *zonk(c, t.ty) is Nothing then never = true
    var solved: Buf[&Type] = buf()
    for i in 0..<type_args.len()
        val t = zonk(c, type_args[i])
        // An unknown that belongs to an enclosing call, as in `f(None, 'z')`, is that call's to
        // settle, and code generation reads its final solution. One of this call's own is left
        // open for a later use in the body to settle, as `best = Some(3)` settles `var best = None`,
        // unless its parameter has bounds, which the type argument is held to here.
        var mine = false
        if *t is Var(v) then mine = v >= first
        if mine && never && *t is Var(v)
            c.vars.set(v, Some(Nothing))
            solved.push(Nothing)
        elif mine && *t is Var(v)
            val subject = if called then s"this call to `$name`" else s"this `$name`"
            // Written type arguments fill a leading prefix, so the example spells every one up to
            // the unsettled parameter: those already settled by their types, the others by name.
            var written = ""
            for j in known.len()..<i
                val before = zonk(c, type_args[j])
                val text = if *before is Var(_) then type_params[j].name else type_name(before)
                written = written + text + ", "
            val example = if called then s"`$name[${written}int](…)`" else s"`$name[${written}int]`"
            val message = s"cannot infer `${type_params[i].name}` for $subject; write it, as in $example"
            if bounds_at(c, owner, type_params, i).len() == 0
                // Named only where a value is read out, by the parameters and the result, it has
                // no constraint but lower bounds, and with none it is the least type, `Nothing`.
                val reads = occurrences(c, wanted, v, true)
                val gives = occurrence(c, declared, v, true)
                val covariant = reads <= 1 && gives <= 1 && reads + gives > 0
                c.unknowns.push(Unknown(v, unit, name_span, message, covariant))
                solved.push(t)
            else
                c.note(unit, name_span, message)
                c.vars.set(v, Some(ErrorType))
                solved.push(ErrorType)
        else solved.push(t)
    // The type arguments written or inferred conform to their parameters' bounds; those the receiver
    // gives were held to them where its type was made.
    hold_to_bounds(c, unit, name_span, s"`$name`", owner, type_params, solved, known.len())
    var ty = zonk(c, declared)
    for t in typed
        if *t.ty is Nothing then ty = Nothing
    // The arguments of a repeated parameter become one vector, made where the first of them is
    // written, or after the others when there are none.
    if s.variadic && binding.fits
        val packed = pack_repeated(c, at, wanted, binding, args, typed)
        typed = packed.typed
        binding = packed.binding
    // Arguments written in parameter order with none omitted are passed as they are; otherwise each
    // written argument is held in a local, in the order written, and the omitted ones' defaults are
    // computed after them, in parameter order, each from the parameters before it.
    var direct = binding.fits
    for i in 0..<binding.slots.len()
        binding.slots[i] match
            Some(j) -> if j != i then direct = false
            None -> direct = false
    if direct || !binding.fits then return Applied(typed, solved, ty, buf(), false)
    var prelude: Buf[&TExpr] = buf()
    var held: Buf[Option[&TExpr]] = buf()
    for _ in params
        held.push(None)
    for j in 0..<typed.len()
        val t = typed[j]
        prelude.push(t)
        if *t.ty is Nothing then return Applied(buf(), solved, Nothing, prelude, true)
        val local = hidden_local(c, t.ty)
        prelude.set(prelude.len() - 1, TExpr(t.span, Unit, Let(local, t)))
        held.set(binding.targets[j].unwrap(), Some(TExpr(t.span, t.ty, Local(local))))
    var passed: Buf[&TExpr] = buf()
    for i in 0..<params.len()
        held[i] match
            Some(value) -> passed.push(value)
            None ->
                val default = s.defaults[i].unwrap()
                // A default written as a literal is the literal itself, with nothing to call.
                if literal_default(c, default) is Some(written)
                    passed.push(check_expr(c, written, Some(zonk(c, wanted[i]))))
                    continue
                local_use(c, default, at)
                var before: Buf[&TExpr] = buf()
                if s.receiver is Some(r) then before.push(r)
                for k in 0..<i
                    before.push(passed[k])
                val wanted_ty = zonk(c, wanted[i])
                val local = hidden_local(c, wanted_ty)
                prelude.push(TExpr(at, Unit, Let(local, TExpr(at, wanted_ty, Call(default, before, default_type_args(c, s, default, solved))))))
                passed.push(TExpr(at, wanted_ty, Local(local)))
    Applied(passed, solved, ty, prelude, false)

/** The body of default function `id` when it is a literal of a built-in type (a number, which may
 * be negated, a char, a bool or a string), whose value is the same wherever it is written. */
private literal_default(c: *Checker, id: usize) -> Option[&Expr]
    val body = c.symbols[id].decl.body?
    body.kind match
        IntLit(_) -> Some(body)
        RealLit(_) -> Some(body)
        CharLit(_) -> Some(body)
        BoolLit(_) -> Some(body)
        StringLit(_) -> Some(body)
        Unary(op, operand) -> if op is Negate && (operand.kind is IntLit(_) || operand.kind is RealLit(_)) then Some(body) else None
        _ -> None

/** The type written argument `j` is checked against, of the parameter types `params` (with the
 * call's type arguments in place): its parameter's, or for an argument of a repeated parameter of
 * type `Vector[T]`, the element type `T`; a sequence spliced into it is any `Iterable[T]`. None for
 * an argument that fits no parameter. */
private argument_type(c: *Checker, s: Signature, params: Buf[&Type], binding: Binding, args: Buf[Argument], j: usize) -> Option[&Type]
    val i = binding.targets[j] match
        Some(i) -> i
        None -> return None
    if !s.variadic || i + 1 != params.len() then return Some(params[i])
    val element = repeated_element(params[i])
    if args[j].value.kind is Splice(_) then Some(core_class_of(c, "Iterable", element)) else Some(element)

/** The expression an argument passes: the sequence itself for one spliced with `xs*`. */
private argument_value(a: Argument) -> &Expr = a.value.kind match
    Splice(inner) -> inner
    _ -> a.value

/** A call's checked arguments and their binding after a repeated parameter's are made one vector. */
private struct Packed
    typed: Buf[&TExpr]
    binding: Binding

// Replaces the arguments of the repeated parameter, the last of `params`, with the vector they make,
// at the place of the first of them; with none, an empty vector follows the other arguments.
private pack_repeated(c: *Checker, at: Span, params: Buf[&Type], binding: Binding, args: Buf[Argument], typed: Buf[&TExpr]) -> Packed
    val r = params.len() - 1
    val element = zonk(c, repeated_element(params[r]))
    var out: Buf[&TExpr] = buf()
    var targets: Buf[Option[usize]] = buf()
    var items: Buf[&TExpr] = buf()
    var spliced: Option[&TExpr] = None
    var place: Option[usize] = None
    for j in 0..<typed.len()
        if binding.targets[j] == Some(r)
            if place is None
                place = Some(out.len())
                out.push(typed[j])
                targets.push(Some(r))
            if args[j].value.kind is Splice(_) then spliced = Some(typed[j]) else items.push(typed[j])
        else
            out.push(typed[j])
            targets.push(binding.targets[j])
    val vector = repeated_vector(c, at, element, items, spliced)
    place match
        Some(k) -> out.set(k, vector)
        None ->
            out.push(vector)
            targets.push(Some(r))
    var slots: Buf[Option[usize]] = buf()
    for _ in params
        slots.push(None)
    for k in 0..<targets.len()
        if targets[k] is Some(i) then slots.set(i, Some(k))
    Packed(out, Binding(slots, targets, true))

// The vector a repeated parameter of element type `element` receives: `items` in order, through the
// core library's vector builder, or the sequence `spliced` as a vector. A spliced vector of that very
// type is passed as it is; any other sequence is copied.
private repeated_vector(c: *Checker, at: Span, element: &Type, items: Buf[&TExpr], spliced: Option[&TExpr]) -> &TExpr
    val unit = unit_of(c)
    val vector = vector_of(c, element)
    if spliced is Some(xs)
        if same_type(zonk(c, xs.ty), vector) || *xs.ty is Nothing || *xs.ty is ErrorType then return xs
    val o = c.class_types.get(qualified(CoreModule, "Vector")) match
        Some(k) -> c.classes[k].companion
        None -> None
    val companion = o match
        Some(o) -> o
        None ->
            c.note(unit, at, "a repeated parameter needs the core library's `Vector`")
            return TExpr(at, ErrorType, UnitConst)
    val builder = call_method(c, at, at, global_read(c, at, c.classes[companion].global.unwrap()), "newBuilder", methods_named(c, companion, "newBuilder"), buf(), None, None, false)
    *zonk(c, builder.ty) match
        Class(_, _, a) -> if a.len() == 1 then unify(c, a[0], element)
        _ -> return TExpr(at, ErrorType, UnitConst)
    val held = hidden_local(c, builder.ty)
    val receiver = TExpr(at, builder.ty, Local(held))
    var steps: Buf[&TExpr] = buf()
    steps.push(TExpr(at, Unit, Let(held, builder)))
    val adding = if spliced is Some(_) then "addAll" else "addOne"
    val ms = methods_of(c, builder.ty, adding)
    if ms.len() != 1
        c.note(unit, at, s"${type_name(builder.ty)} has no one `$adding` method to take a repeated parameter's arguments")
        return TExpr(at, ErrorType, UnitConst)
    val type_args = receiver_type_args(c, builder.ty, ms[0])
    var given = items
    if spliced is Some(xs)
        given = buf()
        given.push(xs)
    for item in given
        var call_args: Buf[&TExpr] = buf()
        call_args.push(receiver)
        call_args.push(item)
        steps.push(TExpr(item.span, Unit, method_call_kind(c, builder.ty, ms[0], call_args, type_args, false)))
    val result = call_method(c, at, at, receiver, "result", methods_of(c, builder.ty, "result"), buf(), None, None, false)
    steps.push(result)
    TExpr(at, zonk(c, result.ty), Block(steps))

// The type arguments of a call of `default`, a default of the function `s` describes, made by a call
// that solved `solved`. A method that overrides another takes that one's defaults, which belong to the
// overridden method's class or trait, so they take the type arguments the receiver has as an instance
// of that class.
private default_type_args(c: *Checker, s: Signature, default: usize, solved: Buf[&Type]) -> Buf[&Type]
    if s.receiver is Some(r)
        if c.symbols[default].type_owner != s.owner then return receiver_type_args(c, r.ty, default)
    solved

// Gives each open type argument with a lower bound that bound as its first lower bound, so the
// arguments widen it to their join with the bound: `cats.prepended(dog)` takes `W >: Cat` as
// `Animal`, and with no nearer common type, two references join to `Any`. One decided already, by
// a written type argument or the expected type, is held to its bound once the call is solved.
private constrain_lowers(c: *Checker, owner: usize, type_params: Buf[TypeParam], from: usize, type_args: Buf[&Type], open: *Buf[usize])
    for i in from..<type_params.len()
        val l = lower_at(c, owner, type_params, i) match
            Some(l) -> l
            None -> continue
        if *type_args[i] is Var(v)
            if open_index(open, v) is Some(_)
                c.widening.push(v)
                constrain(c, type_args[i], substitute(l, owner, type_args), open, true)

/** The inference variables among `type_args`, from `from` on, that nothing has decided yet: those
 * the arguments of a call decide by their join. */
private open_type_args(c: *Checker, type_args: Buf[&Type], from: usize) -> Buf[usize]
    var open: Buf[usize] = buf()
    for i in from..<type_args.len()
        if *type_args[i] is Var(v)
            if *zonk(c, type_args[i]) is Var(_) then open.push(v)
    open

// Checks a call's arguments against their parameters' types, in an order that lets each argument use
// what the others decide: first the arguments that are neither bare literals nor lambdas, then the
// literals, which take the types the others settle, and last the lambdas, whose parameter types
// come from all of them. `wanted` has an entry per argument, `None` for one that fits no parameter.
// An argument with an entry in `checked` was checked already, and only its type is matched here.
private check_arguments(c: *Checker, args: Buf[Argument], wanted: Buf[Option[&Type]], checked: Buf[Option[&TExpr]], open: *Buf[usize]) -> Buf[&TExpr]
    var early: Buf[Option[&TExpr]] = buf()
    for _ in args
        early.push(None)
    for pass in 0..<3
        for i in 0..<args.len()
            val value = args[i].value
            val param = if i < wanted.len() then wanted[i] else None
            if i < checked.len()
                if checked[i] is Some(given)
                    if pass == 0
                        var t = given
                        // An argument delayed for a candidate that takes it by name is evaluated
                        // once, at the call, by one that takes it strictly.
                        if param is Some(p)
                            if *given.ty is ByName(_) && !(*zonk(c, p) is ByName(_)) then t = evaluated(given)
                            t = to_trait(c, t, zonk(c, p))
                            if converts_none(c, t.ty, p) then t = TExpr(t.span, p, NoneAs(t))
                            val agrees = *t.ty is Nothing || same_type(t.ty, p) || constrain(c, p, t.ty, open, true)
                            if !agrees
                                c.note(unit_of(c), value.span, mismatch(c, zonk(c, p), t.ty))
                        early.set(i, Some(t))
                    continue
            val rank = if takes_parameter_type(value) then 2 elif is_literal(value) then 1 else 0
            if rank != pass then continue
            early.set(i, Some(call_argument(c, args[i], param, open)))
    var typed: Buf[&TExpr] = buf()
    for t in early
        typed.push(t.unwrap())
    typed

// A use of a local function, by a call or as a value, needs what the function captures where it is
// used; a use before the function's declaration needs those captures initialized already.
private local_use(c: *Checker, id: usize, at: Span)
    if c.symbols[id].root is None then return
    c.body.calls.push(LocalCall(c.current, id))
    if c.states[id] == 0
        var initialized: Buf[usize] = buf()
        for v in c.body.visible
            initialized.push(v)
        c.body.early.push(EarlyCall(id, at, initialized))

// A function used as a value by name. An overloaded name takes its overload from the expected
// function type: of the overloads whose parameters accept that type's, the most specific.
private named_function_value(c: *Checker, at: Span, name: string, explicit: Option[Buf[&TypeExpr]], expected: Option[&Type]) -> &TExpr
    var ids = lookup_functions(c, name)
    // Type arguments written on the name choose among the overloads with that many type parameters.
    if explicit is Some(written)
        var taking: Buf[usize] = buf()
        for id in ids
            if c.symbols[id].decl.type_params.len() == written.len() then taking.push(id)
        if taking.len() > 0 then ids = taking
    if ids.len() == 1 then return function_value(c, at, ids[0], explicit, expected)
    val unit = unit_of(c)
    var wanted: Option[Buf[&Type]] = None
    if expected is Some(t)
        if *zonk(c, t) is Function(ps, _) then wanted = Some(ps)
    val params = wanted match
        Some(ps) -> ps
        None ->
            c.note(unit, at, s"`$name` is overloaded, so it is used as a value only where a function type is expected, which chooses among ${overload_list(c, ids)}")
            return TExpr(at, ErrorType, UnitConst)
    var fitting: Buf[usize] = buf()
    var compared: Buf[Buf[&Type]] = buf()
    for id in ids
        val f = c.symbols[id]
        if accepts(c, f.params, f.type_owner, f.type_params.len(), params)
            fitting.push(id)
            compared.push(f.params)
    if fitting.len() == 0
        c.note(unit, at, s"no overload of `$name` has the parameter types of ${type_name(zonk(c, expected.unwrap()))}; the overloads are ${overload_list(c, ids)}")
        return TExpr(at, ErrorType, UnitConst)
    most_specific(c, fitting, compared) match
        Some(id) -> function_value(c, at, id, explicit, expected)
        None ->
            c.note(unit, at, s"`$name` used as ${type_name(zonk(c, expected.unwrap()))} is ambiguous: ${overload_list(c, fitting)} each accept it")
            TExpr(at, ErrorType, UnitConst)

// A named function used as a value. A generic one is instantiated as a call would be, with its type
// arguments written or decided by the expected function type.
private function_value(c: *Checker, at: Span, id: usize, explicit: Option[Buf[&TypeExpr]], expected: Option[&Type]) -> &TExpr
    val unit = unit_of(c)
    val target = c.symbols[id]
    local_use(c, id, at)
    val result = result_of(c, id, at)
    val type_params = target.type_params
    val known = enclosing_type_args(target)
    val first = c.vars.len()
    var type_args: Buf[&Type] = buf()
    for i in 0..<type_params.len()
        type_args.push(if i < known.len() then known[i] else fresh_var(c))
    if explicit is Some(types)
        val own = type_params.len() - known.len()
        if types.len() > own
            c.note(unit, at, s"`${target.name}` takes ${count(own, "type argument")}, not ${types.len()}")
            for i in known.len()..<type_args.len()
                unify(c, type_args[i], ErrorType)
        else
            for i in 0..<types.len()
                unify(c, type_args[known.len() + i], resolve_type(c, unit, types[i]))
    val declared: &Type = Function(target.params, result)
    val ty = substitute(declared, target.type_owner, type_args)
    if expected is Some(want) then unify(c, ty, want)
    var solved: Buf[&Type] = buf()
    for i in 0..<type_args.len()
        val t = zonk(c, type_args[i])
        if *t is Var(v)
            if v >= first
                c.note(unit, at, s"cannot infer `${type_params[i].name}` for `${target.name}` used as a value; write it, as in `${target.name}[int]`")
                c.vars.set(v, Some(ErrorType))
        solved.push(zonk(c, t))
    // The type arguments, written or taken from the expected type, are held to their bounds as a
    // call's are.
    hold_to_bounds(c, unit, at, s"`${target.name}`", target.type_owner, type_params, solved, known.len())
    c.symbols[id].value = true
    TExpr(at, zonk(c, ty), FunctionValue(id, solved))

/** The `apply` methods a value of type `t` may be called through: those of its class, of its bounds
 * for a type parameter, or of its impls. */
private apply_methods(c: *Checker, t: &Type) -> Buf[usize] = *t match
    Class(k, _, _) -> methods_named(c, k, "apply")
    TypeVar(_, _, _) -> bound_methods(c, t, "apply")
    _ -> visible_methods(c, receiver_methods(c, t, "apply"))

// A call of a value of a function type: a local, a parameter, or any expression that yields a
// function.
private value_call(c: *Checker, at: Span, callee: &Expr, args: Buf[Argument]) -> &TExpr = call_checked(c, at, callee.span, check_expr(c, callee, None), args)

private call_checked(c: *Checker, at: Span, callee_span: Span, f: &TExpr, args: Buf[Argument]) -> &TExpr
    val unit = unit_of(c)
    val ty = zonk(c, f.ty)
    // Only a declaration's parameters have names and defaults; a function value is called with its
    // arguments by position.
    for a in args
        if a.name is Some(n) then c.note(unit, a.span, s"a function value takes its arguments by position, so `$n` cannot be named")
    *ty match
        Function(params, result) ->
            var wanted: Buf[Option[&Type]] = buf()
            for p in params
                wanted.push(Some(p))
            var none: Buf[usize] = buf()
            val typed = check_arguments(c, args, wanted, buf(), &none)
            if args.len() != params.len()
                c.note(unit, at, s"this function takes ${count(params.len(), "argument")}, not ${args.len()}")
            elif args.len() > 0 && args[args.len() - 1].block && !takes_block(params[params.len() - 1])
                c.note(unit, args[args.len() - 1].span, s"the indented block after the call is given to the last parameter of this function, which is ${type_name(params[params.len() - 1])}: a trailing block is given only to a by-name parameter (`-> T`) or a function")
            var r = zonk(c, result)
            for t in typed
                if *t.ty is Nothing then r = Nothing
            TExpr(at, r, CallValue(f, typed))
        _ ->
            // A sequence is a function from index to element: calling one calls its `apply`.
            val applies = apply_methods(c, ty)
            if applies.len() > 0 then return call_method(c, at, callee_span, f, "apply", applies, args, None, None, false)
            if settled(ty) then c.note(unit, callee_span, s"a value of type ${type_name(ty)} cannot be called; only a function can")
            for a in args
                check_statement(c, a.value)
            TExpr(at, if *ty is Nothing then Nothing else ErrorType, UnitConst)

// A lambda is an anonymous local function, checked where it is written. Its parameter types are
// written or come from the function type expected there, and its result type comes from that type
// or from its body.
private lambda_expr(c: *Checker, e: &Expr, params: Buf[LambdaParam], body: &Expr, expected: Option[&Type], delayed: bool) -> &TExpr
    val unit = unit_of(c)
    var wanted: Buf[&Type] = buf()
    var wanted_result: Option[&Type] = None
    var mismatched = false
    if expected is Some(want)
        val known = zonk(c, want)
        if *known is Function(ps, r)
            if ps.len() == params.len()
                wanted = ps
                wanted_result = Some(r)
            else
                c.note(unit, e.span, s"expected a function of ${count(ps.len(), "parameter")}, but this lambda takes ${params.len()}")
                mismatched = true
    var types: Buf[&Type] = buf()
    var names: Buf[string] = buf()
    for i in 0..<params.len()
        val p = params[i]
        names.push(p.name)
        var ty: &Type = ErrorType
        p.declared match
            Some(d) ->
                ty = resolve_type(c, unit, d)
                if i < wanted.len()
                    if !unify(c, wanted[i], ty)
                        c.note(unit, p.span, s"`${p.name}` is declared ${type_name(ty)}, but this lambda is expected to take ${type_name(zonk(c, wanted[i]))}")
                        ty = ErrorType
            None ->
                val known: &Type = if i < wanted.len() then zonk(c, wanted[i]) else Var(0)
                if i < wanted.len() && !has_unknowns(known) then ty = known
                elif !mismatched then c.note(unit, p.span, s"cannot infer the type of `${p.name}`; write it, as in `(${p.name}: int) -> …`")
        types.push(ty)
    var result: Option[&Type] = None
    // A result still partly unknown is inferred from the body, which is checked against its known
    // shape; one wholly unknown says nothing.
    var hint: Option[&Type] = None
    if wanted_result is Some(r)
        val known = zonk(c, r)
        if !has_unknowns(known) then result = Some(known)
        elif !(*known is Var(_)) then hint = Some(known)
    val enclosing = c.symbols[c.current]
    val decl = Function(buf(), e.span, e.span, "lambda", buf(), buf(), None, Some(body), buf())
    val id = c.symbols.len()
    c.symbols.push(FunctionSymbol(enclosing.unit, enclosing.module_name, "lambda", decl, types, names, result, None, Some(c.body.root), buf(), buf(), buf(), true, delayed, true, buf(), None, id, buf(), None, false, true, "", None, false))
    c.states.push(1)
    c.bodies.push(None)
    c.locals.push(buf())
    // Checked as a local function is: its parameters are locals of its own, and loops outside it are
    // not its loops.
    val previous = c.current
    val loops = c.body.loops
    val outer_start = c.body.block_start
    val mark = c.body.visible.len()
    c.current = id
    c.body.loops = buf()
    c.body.block_start = mark
    var param_locals: Buf[usize] = buf()
    for i in 0..<params.len()
        param_locals.push(declare_local(c, params[i].span, names[i], types[i], false))
    c.symbols[id].param_locals = param_locals
    check_body(c, id, body, hint)
    c.body.visible.truncate(mark)
    c.body.block_start = outer_start
    c.body.loops = loops
    c.current = previous
    c.states.set(id, 2)
    // Making the closure needs everything the lambda captures where it is written.
    c.body.calls.push(LocalCall(previous, id))
    val yields = c.symbols[id].result.unwrap_or(ErrorType)
    if result is None
        if wanted_result is Some(r) then unify(c, r, yields)
    val ty: &Type = if mismatched then ErrorType else Function(types, yields)
    TExpr(e.span, ty, FunctionValue(id, buf()))

/** The parameter of the lambda a `match` function is checked as: a keyword, so no name written in
 * an arm can refer to it. */
const MatchParam: string = "match"

// A `match` with nothing before it is a function of one value, which its arms match; the value's type
// comes from the expected type. Where a function `(A) -> B` is expected it is the lambda
// `x -> x match …`, so its arms cover every `A`, as any `match`'s do. Where a `PartialFunction[A, B]`
// is expected they need not: it is the core library's `MatchPartialFunction` of two lambdas over the
// same arms, one telling whether an arm matches and one yielding `Some` of the matching arm's value,
// or `None`. A call, `lift` and `applyOrElse` run only the second, so each tests the patterns and
// guards once.
private match_function_expr(c: *Checker, e: &Expr, arms: Buf[Arm], expected: Option[&Type]) -> &TExpr
    val unit = unit_of(c)
    if expected is Some(w)
        val t = zonk(c, w)
        *t match
            Function(ps, _) ->
                if ps.len() != 1
                    c.note(unit, e.span, s"a `match` function takes one value, but a function of ${count(ps.len(), "parameter")} is expected here")
                    return TExpr(e.span, ErrorType, UnitConst)
                if !matched_type_known(c, e, ps[0]) then return TExpr(e.span, ErrorType, UnitConst)
                return lambda_expr(c, e, match_params(e.span), match_body(e.span, arms), expected, false)
            Class(k, _, args) ->
                if core_class(c, "PartialFunction") == Some(k) && args.len() == 2
                    return partial_match(c, e, arms, args[0], args[1])
            _ -> ()
    c.note(unit, e.span, "a `match` with nothing before it is a function, whose type comes from where it is used: write it where a function such as `(int) -> string` or a `PartialFunction[int, string]` is expected, or declare that type")
    TExpr(e.span, ErrorType, UnitConst)

// Whether the type of the value a `match` function matches is known; reports it when not.
private matched_type_known(c: *Checker, e: &Expr, t: &Type) -> bool
    if !has_unknowns(zonk(c, t)) then return true
    c.note(unit_of(c), e.span, "cannot infer the type of the value this `match` matches; declare the function's type, as in `(int) -> string` or `PartialFunction[int, string]`")
    false

private match_params(at: Span) -> Buf[LambdaParam]
    var params: Buf[LambdaParam] = buf()
    params.push(LambdaParam(at, MatchParam, None))
    params

private match_body(at: Span, arms: Buf[Arm]) -> &Expr = Expr(at, Match(Expr(at, Name(MatchParam)), arms))

// A `match` function where `PartialFunction[from, to]` is expected. Its arms are checked twice, once
// in each lambda; the second check is skipped when the first found errors, so each is reported once.
private partial_match(c: *Checker, e: &Expr, arms: Buf[Arm], from: &Type, to: &Type) -> &TExpr
    val unit = unit_of(c)
    if !matched_type_known(c, e, from) then return TExpr(e.span, ErrorType, UnitConst)
    val ids = c.scope.get(qualified(CoreModule, "MatchPartialFunction")) match
        Some(ids) -> ids
        None ->
            c.note(unit, e.span, "the core library has no `MatchPartialFunction` to make a partial function of")
            return TExpr(e.span, ErrorType, UnitConst)
    val at = e.span
    var tests: Buf[Arm] = buf()
    var attempts: Buf[Arm] = buf()
    for arm in arms
        val b = arm.body.span
        var held: Buf[Argument] = buf()
        held.push(Argument(b, None, arm.body, false))
        attempts.push(Arm(arm.pattern, arm.guard, Expr(b, Call(Expr(b, Name(core_path("Some"))), held))))
        tests.push(Arm(arm.pattern, arm.guard, Expr(b, BoolLit(true))))
    attempts.push(Arm(Pattern(at, Wildcard), None, Expr(at, Name(core_path("None")))))
    tests.push(Arm(Pattern(at, Wildcard), None, Expr(at, BoolLit(false))))
    val attempt_body = match_body(at, attempts)
    val test_body = match_body(at, tests)
    var option_args: Buf[&Type] = buf()
    option_args.push(to)
    val option = core_data(c, "Option") match
        Some(d) -> Data(d, "Option", option_args)
        None -> return TExpr(e.span, ErrorType, UnitConst)
    var params: Buf[&Type] = buf()
    params.push(from)
    val before = c.units[unit].report.len()
    val attempt = lambda_expr(c, Expr(at, Lambda(match_params(at), attempt_body)), match_params(at), attempt_body, Some(Function(params, option)), false)
    if c.units[unit].report.len() > before then return TExpr(e.span, ErrorType, UnitConst)
    val test = lambda_expr(c, Expr(at, Lambda(match_params(at), test_body)), match_params(at), test_body, Some(Function(params, Bool)), false)
    var args: Buf[Argument] = buf()
    args.push(Argument(at, None, test_body, false))
    args.push(Argument(at, None, attempt_body, false))
    var typed: Buf[Option[&TExpr]] = buf()
    typed.push(Some(test))
    typed.push(Some(attempt))
    call_function(c, at, at, ids[0], args, None, None, typed)

// Checks one argument against its parameter type, which may still contain unknowns; the argument's
// type decides them. `open` holds the call's own type arguments that only arguments have decided so
// far (see `constrain`): an argument is checked expecting what the others have decided of them only
// where it is decided for good, so `Some(dog)` after a `cat` is an `Option[Dog]`, which widens the
// type argument, rather than an `Option[Cat]` it cannot be.
private call_argument(c: *Checker, arg: Argument, param: Option[&Type], open: *Buf[usize]) -> &TExpr
    val unit = unit_of(c)
    var wanted: Option[&Type] = None
    if param is Some(p)
        val known = loosen(c, p, open, true)
        if !(*known is Var(_)) then wanted = Some(known)
    if param is Some(p)
        if *zonk(c, p) is ByName(inner)
            // A delayed argument widens an open type argument as any other does: `getOrElse(k, dog)`
            // on a map of cats takes `W >: Cat` as `Animal`.
            val raw = if *p is ByName(r) then r else inner
            val loose = loosen(c, raw, open, true)
            if same_type(zonk(c, loose), inner)
                // What the delayed expression yields decides the unknowns `inner` still has, as a strict
                // argument's type does: `byName(Box(x))` for `byName[U >: T, F](o: -> Box[Result[U, F]])`
                // takes `U` and `F` from `x`.
                val before = c.units[unit].report.len()
                val given = delayed_argument(c, arg, p, inner)
                if c.units[unit].report.len() == before && *given.ty is ByName(yields)
                    if !(*yields is Nothing) && !same_type(zonk(c, yields), zonk(c, inner)) && !constrain(c, raw, yields, open, true)
                        c.note(unit, arg.value.span, mismatch(c, zonk(c, raw), yields))
                return given
            val delayed = delayed_argument(c, arg, ByName(loose), loose)
            if *delayed.ty is ByName(yields)
                // One that yields an `Option[Nothing]` converts as the value of the lambda it is
                // checked as, as `call_argument` converts one passed strictly.
                if converts_none(c, yields, raw) && delayed.kind is FunctionValue(id, _)
                    if c.bodies[id] is Some(body)
                        c.bodies.set(id, Some(TExpr(body.span, raw, NoneAs(body))))
                        c.symbols[id].result = Some(raw)
                        return TExpr(delayed.span, ByName(raw), delayed.kind)
                if !(*yields is Nothing) && !constrain(c, raw, yields, open, true)
                    c.note(unit, arg.value.span, mismatch(c, zonk(c, raw), yields))
            return delayed
    val value = check_expr(c, arg.value, wanted)
    if param is Some(p)
        // An `Option[Nothing]` passed as an option whose argument is decided, as a lower bound
        // decides `B` in `orElse[B >: T]`, constrains nothing and converts as `none_as` does. It takes
        // the parameter's own type, which follows the argument wherever a later one widens it.
        if converts_none(c, value.ty, p) then return TExpr(value.span, p, NoneAs(value))
        // Passed as an open type argument, as in `List(none, Some(dog))`, it is taken as a `None` written
        // there would be, an option of an argument the others settle, or `Nothing` if none does.
        if nothing_option(c, value.ty) && *zonk(c, p) is Var(_)
            val element = fresh_var(c)
            if *element is Var(v) then c.unknowns.push(Unknown(v, unit, arg.value.span, "", true))
            val taken = TExpr(value.span, option_of(c, element), NoneAs(value))
            if !constrain(c, p, taken.ty, open, true) then c.note(unit, arg.value.span, mismatch(c, zonk(c, p), value.ty))
            return taken
        if !(*value.ty is Nothing) && !constrain(c, p, value.ty, open, true)
            c.note(unit, arg.value.span, mismatch(c, zonk(c, p), value.ty))
    value

/** "expected T, found U", and why two classes that share several traits do not join to one. */
private mismatch(c: *Checker, wanted: &Type, found: &Type) -> string
    val text = s"expected ${type_name(wanted)}, found ${type_name(found)}"
    val traits = shared_traits(c, wanted, zonk(c, found))
    if traits.len() < 2 then return text
    var names = ""
    for i in 0..<traits.len()
        if i > 0 then names = names + (if i + 1 == traits.len() then " and " else ", ")
        names = names + type_name(traits[i])
    s"$text; they have no common superclass and share the unrelated traits $names, so write the type wanted"

/** The expected type of an argument whose parameter has the type `t`: `t` solved, except that a type
 * argument still open in `open` is left unknown where a value is read out, when what decided it is a
 * reference type that a later argument may widen. A value type is kept, so a literal takes it. */
private loosen(c: *Checker, t: &Type, open: *Buf[usize], covariant: bool) -> &Type = *t match
    Var(i) ->
        val now = zonk(c, t)
        if covariant && open_index(open, i) is Some(_) && is_reference(now) then fresh_var(c) else now
    Tuple(items) ->
        var parts: Buf[&Type] = buf()
        for item in items
            parts.push(loosen(c, item, open, covariant))
        Tuple(parts)
    Function(params, result) ->
        var solved: Buf[&Type] = buf()
        for param in params
            solved.push(zonk(c, param))
        Function(solved, loosen(c, result, open, covariant))
    Data(d, name, args) -> Data(d, name, loosen_args(c, c.data[d].decl.type_params, args, open, covariant))
    Class(k, name, args) -> Class(k, name, loosen_args(c, c.classes[k].decl.type_params, args, open, covariant))
    _ -> zonk(c, t)

private loosen_args(c: *Checker, params: Buf[TypeParam], args: Buf[&Type], open: *Buf[usize], covariant: bool) -> Buf[&Type]
    var out: Buf[&Type] = buf()
    for i in 0..<args.len()
        val reads = covariant && i < params.len() && params[i].variance is Covariant
        out.push(loosen(c, args[i], open, reads))
    out

/** Where the inference variable `v` is in `open`. */
private open_index(open: *Buf[usize], v: usize) -> Option[usize]
    for i in 0..<open.len()
        if open[i] == v then return Some(i)
    None

/** Whether `t`, a parameter's type as the call instantiates it, names a type argument in `open`. */
private mentions_open(t: &Type, open: *Buf[usize]) -> bool = *t match
    Var(i) -> open_index(open, i) is Some(_)
    Tuple(items) -> any_open(items, open)
    Function(params, result) -> any_open(params, open) || mentions_open(result, open)
    ByName(inner) -> mentions_open(inner, open)
    Data(_, _, args) -> any_open(args, open)
    Class(_, _, args) -> any_open(args, open)
    _ -> false

private any_open(types: Buf[&Type], open: *Buf[usize]) -> bool
    for t in types
        if mentions_open(t, open) then return true
    false

// Holds `actual`, an argument's type, to `p`, its parameter's type as the call instantiates it. A
// type argument in `open` that `p` names where a value is read out (the whole parameter, a covariant
// argument of a generic type, a tuple part, a function's result) takes each argument's type there as
// a lower bound and is the join of its lower bounds: `pair(cat, dog)` and `Cons(cat, dogs)` take
// `Animal`. Named anywhere else (an invariant or contravariant argument, a function's parameter) it
// is decided for good and leaves `open`, and every later argument must be an instance of it.
private constrain(c: *Checker, p: &Type, actual: &Type, open: *Buf[usize], covariant: bool) -> bool
    // A delayed argument is a function of no parameters the callee calls at each read, so it is held
    // to a by-name parameter as such a function is to a function type: what it yields may be a
    // subtype of what the parameter yields, `-> Option[Dog]` given for `-> Option[Animal]`.
    if *zonk(c, p) is ByName(pi)
        if *zonk(c, actual) is ByName(ai) then return constrain(c, Function(buf(), pi), Function(buf(), ai), open, covariant)
    if !mentions_open(p, open) then return unify(c, p, upcast(c, actual, p))
    val v = zonk(c, actual)
    *p match
        Var(i) -> return lower_bound(c, i, v, open, covariant)
        Tuple(xs) -> *v match
            Tuple(ys) ->
                if xs.len() != ys.len() then return false
                for k in 0..<xs.len()
                    if !constrain(c, xs[k], ys[k], open, covariant) then return false
                return true
            _ -> ()
        Function(xs, r) -> *v match
            Function(ys, q) ->
                if xs.len() != ys.len() then return false
                for k in 0..<xs.len()
                    if !constrain(c, xs[k], ys[k], open, false) then return false
                return constrain(c, r, q, open, covariant)
            _ -> ()
        Data(d, _, xs) -> *v match
            Data(e, _, ys) -> if d == e then return constrain_args(c, c.data[d].decl.type_params, xs, ys, open, covariant)
            _ -> ()
        Class(k, _, xs) ->
            if ancestor_type(c.classes, c.data, v, k) is Some(up)
                if *up is Class(_, _, ys) then return constrain_args(c, c.classes[k].decl.type_params, xs, ys, open, covariant)
        _ -> ()
    unify(c, p, upcast(c, actual, p))

private constrain_args(c: *Checker, params: Buf[TypeParam], xs: Buf[&Type], ys: Buf[&Type], open: *Buf[usize], covariant: bool) -> bool
    if xs.len() != ys.len() || xs.len() != params.len() then return false
    for i in 0..<xs.len()
        // Variance holds where the arguments are references; `List[int]` is no `List[long]`.
        // So does it where a type parameter in scope has a lower bound, which a value of another may be
        // one of: `Cons(x, self)` for `x: W` and `self: List[T]` takes `W` where `W >: T`.
        val y = zonk(c, ys[i])
        val reads = covariant && params[i].variance is Covariant && (is_reference(y) || *y is TypeVar(_, _, _) && scope_has_lowers(c))
        if !constrain(c, xs[i], ys[i], open, reads) then return false
    true

// One argument's type `v` given to the type argument `i`. Where `i` is open and a value is read out,
// `v` widens it to their join; elsewhere `i` is decided as `v`, or as what it already is when `v` is
// an instance of that, and an open `i` whose lower bounds are all instances of `v` is decided as `v`.
private lower_bound(c: *Checker, i: usize, v: &Type, open: *Buf[usize], covariant: bool) -> bool
    val p: &Type = Var(i)
    val at = open_index(open, i) match
        Some(n) -> n
        None -> return unify(c, p, upcast(c, v, p))
    val now = zonk(c, p)
    if !covariant
        open.set(at, open[open.len() - 1])
        open.truncate(open.len() - 1)
        if !(*now is Var(_)) && !has_unknowns(now) && !has_unknowns(v) && !same_type(now, v)
            if conforms(upcast(c, now, v), v)
                settle(c, i, v)
                return true
        return unify(c, p, v)
    if *now is Var(_) then return unify(c, p, v)
    if !has_unknowns(now) && conforms(upcast(c, v, now), now) then return true
    join(c, now, v) match
        Some(t) ->
            settle(c, i, zonk(c, t))
            true
        None ->
            // A type argument with a lower bound widens as far as `Any`, the top, where its lower
            // bounds are references with no nearer common type. Each is passed as the `Any` with
            // no conversion, as a part of a tuple is.
            if !contains_id(c.widening, i) || !is_reference(now) || !is_reference(zonk(c, v)) then return false
            c.views.push(TypeView(one_part(now), one_part(AnyType)))
            c.views.push(TypeView(one_part(zonk(c, v)), one_part(AnyType)))
            settle(c, i, AnyType)
            true

/** A tuple of one part, `t`. */
private one_part(t: &Type) -> &Type
    var items: Buf[&Type] = buf()
    items.push(t)
    Tuple(items)

/** Re-solves the inference variable `i`, at the end of the chain of variables it is solved as. */
private settle(c: *Checker, i: usize, t: &Type)
    var k = i
    var following = true
    while following
        following = false
        if c.vars[k] is Some(s)
            if *s is Var(j)
                k = j
                following = true
    if !same_type(t, Var(k)) then c.vars.set(k, Some(t))

// An argument to a by-name parameter is not evaluated at the call. It is checked as a lambda with
// no parameters, which the callee evaluates at each read. A by-name parameter passed on to another
// is forwarded as it is, still unevaluated.
private delayed_argument(c: *Checker, arg: Argument, param: &Type, inner: &Type) -> &TExpr
    val unit = unit_of(c)
    if arg.value.kind is Name(n)
        if binding_ref(c, arg.value.span, n) is Some(t)
            if *t.ty is ByName(_)
                if !unify(c, param, t.ty)
                    c.note(unit, arg.value.span, s"expected ${type_name(zonk(c, param))}, found ${type_name(t.ty)}")
                return t
    val expected: &Type = Function(buf(), inner)
    val delayed = lambda_expr(c, arg.value, buf(), arg.value, Some(expected), true)
    val yields: &Type = *delayed.ty match
        Function(_, r) -> r
        _ -> ErrorType
    TExpr(arg.value.span, ByName(yields), delayed.kind)

// A built-in type called with one value converts it. Integers convert among themselves (widening
// sign-extends, narrowing keeps the low bits), to and from `real`, and to `byte` and `char`, which
// trap on a value they cannot hold; `byte` and `char` convert to integers.
private conversion(c: *Checker, at: Span, target: &Type, args: Buf[Argument], wrap: bool) -> &TExpr
    val unit = unit_of(c)
    if wrap && !(*as_integer(c, target) is Int(_))
        c.note(unit, at, s"`wrap` converts to an integer type, which `${type_name(target)}` is not")
        for a in args
            check_statement(c, a.value)
        return TExpr(at, ErrorType, UnitConst)
    if args.len() != 1 || args[0].name is Some(_)
        c.note(unit, at, s"`${type_name(target)}(…)` converts exactly one value")
        for a in args
            check_statement(c, a.value)
        return TExpr(at, ErrorType, UnitConst)
    val arg = args[0].value
    // A literal is read at its own width, which is at least `int`'s, so that `i8(300)` narrows 300.
    // Converted to a type parameter bounded by `Integer`, whose width each instance decides, it is
    // read as a `long`.
    var want: Option[&Type] = None
    if is_literal(arg)
        want = *target match
            Int(bits) -> Some(if bits > IntBits then target else int_type())
            Real -> Some(Real)
            TypeVar(_, _, _) -> Some(Int(64))
            _ -> Some(int_type())
    val x = check_expr(c, arg, want)
    if !settled(x.ty)
        return TExpr(at, if *x.ty is Nothing then Nothing else ErrorType, Convert(x, wrap))
    if !convertible(as_integer(c, x.ty), as_integer(c, target))
        c.note(unit, at, s"cannot convert ${type_name(x.ty)} to ${type_name(target)}")
        return TExpr(at, ErrorType, UnitConst)
    TExpr(at, target, Convert(x, wrap))

/** The type parameter in scope named `name` when it is bounded by `Integer`, so that calling it
 * converts to the width each instance has. */
private integer_param_named(c: *Checker, name: string) -> Option[&Type]
    val scope = c.generic?
    for i in 0..<scope.params.len()
        if scope.params[i].name == name
            val t: &Type = TypeVar(scope.owner, i, name)
            return if is_integer_param(c, t) then Some(t) else None
    None

/** Whether `t` is a type parameter bounded by `Integer`, so every instance has an integer for it. */
private is_integer_param(c: *Checker, t: &Type) -> bool
    if !(*t is TypeVar(_, _, _)) then return false
    core_trait_type(c, "Integer") match
        Some(integer) -> conforms_to_bound(c, t, integer)
        None -> false

/** `t` as a conversion sees it: a type parameter bounded by `Integer` converts as an integer does. */
private as_integer(c: *Checker, t: &Type) -> &Type = if is_integer_param(c, t) then Int(64) else t

convertible(from: &Type, to: &Type) -> bool = *from match
    Int(_) -> *to is Int(_) || *to is Real || *to is Byte || *to is Char
    Byte -> *to is Int(_) || *to is Byte || *to is Char || *to is Real
    Char -> *to is Int(_) || *to is Char
    Real -> *to is Int(_) || *to is Real
    _ -> false

// A function without a declared result type has the type of its body, so its body is checked
// first; a cycle of such functions is reported rather than guessed at.
private result_of(c: *Checker, id: usize, at: Span) -> &Type
    if c.symbols[id].result is Some(r) then return r
    if c.symbols[id].root is Some(_) && c.states[id] == 0
        c.note(unit_of(c), at, s"`${c.symbols[id].name}` is called before its declaration, so it needs a declared result type")
        return ErrorType
    if c.states[id] == 1
        c.note(unit_of(c), at, s"`${c.symbols[id].name}` is recursive, so it needs a declared result type")
        return ErrorType
    check_function(c, id)
    c.symbols[id].result.unwrap_or(ErrorType)

// An integer literal takes its width from the expected type, or is an `int`. `-` applied directly
// to a literal is part of it, so the most negative value of each width can be written.
private integer_literal(c: *Checker, at: Span, spelling: string, negative: bool, expected: Option[&Type]) -> &TExpr
    var bits = IntBits
    var as_byte = false
    var as_real = false
    if expected is Some(t)
        *t match
            Int(b) -> bits = b
            Byte -> as_byte = true
            Real -> as_real = true
            _ -> ()
    val digits = literal_magnitude(spelling) match
        Some(d) -> d
        None ->
            c.note(unit_of(c), at, "malformed integer literal")
            return TExpr(at, ErrorType, UnitConst)
    if as_byte
        if negative && digits != "0" || compare_decimal(digits, "255") > 0
            c.note(unit_of(c), at, "integer literal does not fit in byte, which holds 0 to 255")
            return TExpr(at, ErrorType, UnitConst)
        return TExpr(at, Byte, IntConst(digits))
    if as_real
        // Where a real is expected, an integer literal is that real, provided it is exact.
        if compare_decimal(digits, "9007199254740992") > 0
            c.note(unit_of(c), at, "integer literal is not exact as a real; write it with a fraction or exponent")
            return TExpr(at, ErrorType, UnitConst)
        var value = 0.0
        for b in digits.bytes
            value = value * 10.0 + real(b - u8('0'))
        return TExpr(at, Real, RealConst(if negative then -value else value))
    val ty: &Type = Int(bits)
    if !fits(digits, bits, negative)
        c.note(unit_of(c), at, s"integer literal does not fit in ${type_name(ty)}")
        return TExpr(at, ErrorType, UnitConst)
    TExpr(at, ty, IntConst(if negative && digits != "0" then "-" + digits else digits))

/** The magnitude an integer literal spells, in decimal, whatever its base and size. */
literal_magnitude(spelling: string) -> Option[string]
    val text = spelling.bytes
    var base = 10u32
    var start = 0usize
    if text.len > 2 && text[0] == u8('0')
        val radix = text[1] | 0x20
        if radix == u8('x') then base = 16
        elif radix == u8('o') then base = 8
        elif radix == u8('b') then base = 2
        if base != 10 then start = 2
    // Decimal digits, least significant first, multiplied by the base and added to per digit.
    var digits: Buf[u32] = buf()
    digits.push(0)
    for i in start..<text.len
        val ch = text[i]
        if ch == u8('_') then continue
        val lower = ch | 0x20
        var d = 99u32
        if ch >= u8('0') && ch <= u8('9') then d = u32(ch - u8('0'))
        elif lower >= u8('a') && lower <= u8('f') then d = u32(lower - u8('a')) + 10
        if d >= base then return None
        var carry = d
        for k in 0..<digits.len()
            val v = digits[k] * base + carry
            digits.set(k, v % 10)
            carry = v / 10
        while carry > 0
            digits.push(carry % 10)
            carry = carry / 10
    var end = digits.len()
    while end > 1 && digits[end - 1] == 0 do end -= 1
    var out = ""
    var k = end
    while k > 0
        k -= 1
        out = out + char(u8('0') + u8(digits[k])).to_string()
    Some(out)

/** Whether a decimal magnitude, with its sign, fits a signed integer of `bits` bits. */
fits(digits: string, bits: u32, negative: bool) -> bool
    // Fewer than one decimal digit per 3.33 bits always fits, so huge widths cost nothing.
    if ulong(digits.bytes.len) * 4 < ulong(bits) then return true
    val limit = min_digits(bits)[1..]
    val order = compare_decimal(digits, limit)
    order < 0 || (negative && order == 0)

// Compares two decimal numbers without leading zeros: negative, zero or positive.
private compare_decimal(a: string, b: string) -> int
    if a.bytes.len != b.bytes.len then return if a.bytes.len < b.bytes.len then -1 else 1
    for i in 0..<a.bytes.len
        if a.bytes[i] != b.bytes[i] then return if a.bytes[i] < b.bytes[i] then -1 else 1
    0

// Each arm's pattern names are scoped to that arm, and may shadow names outside it. The arms'
// values must agree when the match's value is used, and together the unguarded arms must cover
// every value of the subject's type.
private match_expr(c: *Checker, e: &Expr, subject: &Expr, arms: Buf[Arm], expected: Option[&Type], used: bool) -> &TExpr
    val unit = unit_of(c)
    val s = check_expr(c, subject, None)
    var typed: Buf[TArm] = buf()
    var ty: &Type = Nothing
    var agreed = true
    var never = true
    for arm in arms
        val mark = c.body.visible.len()
        val outer_start = c.body.block_start
        c.body.block_start = mark
        val pattern = check_pattern(c, arm.pattern, s.ty, "")
        var guard: Option[&TExpr] = None
        if arm.guard is Some(g)
            val t = check_expr(c, g, Some(Bool))
            expect_bool(c, t)
            guard = Some(t)
        var body = check_value(c, arm.body, expected, used)
        c.body.visible.truncate(mark)
        c.body.block_start = outer_start
        if !(*body.ty is Nothing) then never = false
        if used && agreed
            // An arm that is an `Option[Nothing]` converts to the other arms' option, and the arms
            // before an arm of another option, to that.
            body = none_as(c, body, ty)
            if converts_none(c, ty, body.ty)
                for i in 0..<typed.len()
                    val before = typed[i]
                    typed.set(i, TArm(before.pattern, before.guard, none_as(c, before.body, body.ty)))
                ty = body.ty
            join_expected(c, ty, body.ty, expected) match
                Some(t) -> ty = t
                None ->
                    c.note(unit, arm.body.span, s"this arm yields ${type_name(body.ty)}, but the arms before it yield ${type_name(ty)}")
                    agreed = false
        typed.push(TArm(pattern, guard, body))
    if !agreed then ty = ErrorType
    elif !used then ty = if never then Nothing else Unit
    if settled(s.ty)
        if missing_case(typed, s.ty, c.data, false) is Some(_)
            val subject = s"this `match` does not cover every ${type_name(s.ty)} value"
            // A value is named only when no arm can match it whatever the extractors answer, and
            // when there is more to say of it than `_`.
            missing_case(typed, s.ty, c.data, true) match
                Some(case) ->
                    if case == "_" then c.note(unit, e.span, s"$subject; add an arm for the rest, such as `_`")
                    else c.note(unit, e.span, s"$subject, such as `$case`; add an arm for it, or `_` for the rest")
                None -> c.note(unit, e.span, s"$subject, since an extractor may answer that it does not match; add an arm for the rest, such as `_`")
    TExpr(e.span, ty, Match(s, typed))

/** A condition checked, and the locals its `is` tests bound: `yes` where it is known to hold, `no`
 * where it is known to have failed. */
struct Condition
    expr: &TExpr
    yes: Buf[usize]
    no: Buf[usize]

// Checks a condition whose `is` tests may bind names, and leaves none of them in scope: an `if` or
// `while` brings back the ones its branches may use. A name is bound once in a condition, and may
// shadow a local of the enclosing block, as an arm of `match` may.
private check_condition(c: *Checker, e: &Expr) -> Condition
    val outer_start = c.body.block_start
    c.body.block_start = c.body.visible.len()
    val t = condition_parts(c, e)
    c.body.block_start = outer_start
    t

// `a && b` holds where both hold, so the right operand sees what the left one bound for holding,
// and the whole binds both sides' names for holding and none for failing. `a || b` is the mirror
// image, and `!a` swaps the two outcomes.
private condition_parts(c: *Checker, e: &Expr) -> Condition
    val mark = c.body.visible.len()
    if e.kind is Is(value, pattern, negated)
        val v = check_expr(c, value, None)
        val p = check_pattern(c, pattern, v.ty, "")
        var bound: Buf[usize] = buf()
        for i in mark..<c.body.visible.len()
            bound.push(c.body.visible[i])
            c.body.tested.push(c.body.visible[i])
        c.body.visible.truncate(mark)
        val t = TExpr(e.span, if *v.ty is Nothing then Nothing else Bool, Is(v, p, negated))
        return if negated then Condition(t, buf(), bound) else Condition(t, bound, buf())
    if e.kind is Binary(op, left, right, _)
        if op is And || op is Or
            val and = op is And
            val l = condition_parts(c, left)
            expect_bool(c, l.expr)
            for x in (if and then l.yes else l.no) do c.body.visible.push(x)
            val r = condition_parts(c, right)
            expect_bool(c, r.expr)
            c.body.visible.truncate(mark)
            // The right operand may not run, so only the left one decides that the operation never finishes.
            val t = TExpr(e.span, if *l.expr.ty is Nothing then Nothing else Bool, Logic(and, l.expr, r.expr))
            return if and then Condition(t, joined(l.yes, r.yes), buf()) else Condition(t, buf(), joined(l.no, r.no))
    if e.kind is Unary(op, operand)
        if op is Not
            val x = condition_parts(c, operand)
            expect_bool(c, x.expr)
            return Condition(TExpr(e.span, if *x.expr.ty is Nothing then Nothing else Bool, Not(x.expr)), x.no, x.yes)
    Condition(check_expr(c, e, Some(Bool)), buf(), buf())

private joined(a: Buf[usize], b: Buf[usize]) -> Buf[usize]
    var all: Buf[usize] = buf()
    for x in a do all.push(x)
    for x in b do all.push(x)
    all

// Brings the names a condition bound into the enclosing block, after an `if` whose other branch
// never finishes.
private bring_into_scope(c: *Checker, at: Span, names: Buf[usize])
    for x in names
        val name = c.body.locals[x].name
        for i in c.body.block_start..<c.body.visible.len()
            if name != "_" && c.body.locals[c.body.visible[i]].name == name
                c.note(unit_of(c), at, s"`$name` is already defined in this block")
        c.body.visible.push(x)

private tested_named(c: *Checker, name: string) -> bool
    for x in c.body.tested
        if c.body.locals[x].name == name then return true
    false

// Checks a pattern against the type of the value it matches. `no_bind` is empty where the pattern
// may bind names, and otherwise says why it may not.
private check_pattern(c: *Checker, p: &Pattern, ty: &Type, no_bind: string) -> &TPattern
    val t = check_pattern_kind(c, p, ty, no_bind)
    if c.index is Some(_) then index_pattern(c, p, t)
    t

private check_pattern_kind(c: *Checker, p: &Pattern, ty: &Type, no_bind: string) -> &TPattern
    val unit = unit_of(c)
    p.kind match
        Wildcard -> TPattern(p.span, ty, PWildcard)
        InvalidPattern -> TPattern(p.span, ErrorType, PWildcard)
        Name(name) ->
            // A bare name is a variant with no fields when one is in scope, and otherwise binds.
            if variant_named(c, name) is Some(v)
                if c.data[v.data].variants[v.index].fields.len() > 0
                    c.note(unit, p.span, s"`$name` has fields; match them, as in `$name(…)`")
                    return TPattern(p.span, ErrorType, PWildcard)
                return variant_pattern(c, p, v, buf(), ty, no_bind)
            if no_bind != ""
                c.note(unit, p.span, no_bind)
                return TPattern(p.span, ErrorType, PWildcard)
            TPattern(p.span, ty, PBind(declare_local(c, p.span, name, ty, c.binds_var)))
        Named(name, inner) ->
            if no_bind != ""
                c.note(unit, p.span, no_bind)
                return TPattern(p.span, ErrorType, PWildcard)
            val nested = check_pattern(c, inner, ty, no_bind)
            TPattern(p.span, ty, PNamed(declare_local(c, p.span, name, ty, c.binds_var), nested))
        Literal(value) ->
            val t = pattern_constant(c, value, ty)
            if !settled(t.ty) then return TPattern(p.span, ErrorType, PWildcard)
            TPattern(p.span, ty, PLiteral(t))
        Range(lower, upper, inclusive) ->
            val low = pattern_constant(c, lower, ty)
            val high = pattern_constant(c, upper, ty)
            if !settled(low.ty) || !settled(high.ty) then return TPattern(p.span, ErrorType, PWildcard)
            if !(*ty is Int(_) || *ty is Byte || *ty is Char)
                c.note(unit, p.span, s"range patterns match integers, bytes and chars, not ${type_name(ty)}")
                return TPattern(p.span, ErrorType, PWildcard)
            TPattern(p.span, ty, PBounds(None, Some(TBound(low, true)), Some(TBound(high, inclusive))))
        Bounded(binder, lower, upper) ->
            if settled(ty) && !(*ty is Int(_) || *ty is Byte || *ty is Char)
                c.note(unit, p.span, s"comparison patterns match integers, bytes and chars, not ${type_name(ty)}")
                return TPattern(p.span, ErrorType, PWildcard)
            var ok = settled(ty)
            var low: Option[TBound] = None
            if lower is Some(b)
                val t = pattern_constant(c, b.value, ty)
                if settled(t.ty) then low = Some(TBound(t, b.inclusive)) else ok = false
            var high: Option[TBound] = None
            if upper is Some(b)
                val t = pattern_constant(c, b.value, ty)
                if settled(t.ty) then high = Some(TBound(t, b.inclusive)) else ok = false
            val local = binder_local(c, binder, ty, no_bind)
            if !ok then return TPattern(p.span, ErrorType, PWildcard)
            TPattern(p.span, ty, PBounds(local, low, high))
        Successor(binder, amount) ->
            if settled(ty) && !(*ty is Int(_))
                c.note(unit, p.span, s"`n + k` patterns match integers, not ${type_name(ty)}")
                return TPattern(p.span, ErrorType, PWildcard)
            val k = pattern_constant(c, amount, ty)
            val local = binder_local(c, binder, ty, no_bind)
            if !settled(k.ty) then return TPattern(p.span, ErrorType, PWildcard)
            val positive = k.kind match
                IntConst(digits) -> !digits.starts_with("-") && digits != "0"
                _ -> false
            if !positive
                c.note(unit, amount.span, "the amount in `n + k` is a positive integer literal")
                return TPattern(p.span, ErrorType, PWildcard)
            TPattern(p.span, ty, PSuccessor(local, k))
        Alternatives(options) ->
            var typed: Buf[&TPattern] = buf()
            for o in options
                typed.push(check_pattern(c, o, ty, if no_bind == "" then "alternatives bind no names; write `_` for a value that is not used" else no_bind))
            TPattern(p.span, ty, PAlternatives(typed))
        Constructor(path, args) -> variant_named(c, path) match
            Some(v) -> variant_pattern(c, p, v, args, ty, no_bind)
            None -> extractor_pattern(c, p, path, args, ty, no_bind)
        Rest(binder) ->
            c.note(unit, p.span, "`rest*` stands for the rest of a sequence, last in a sequence pattern or in an `unapplySeq` extractor's patterns")
            check_pattern(c, binder, ErrorType, no_bind)
            TPattern(p.span, ErrorType, PWildcard)
        Cons(head, tail) ->
            var parts: Buf[&Pattern] = buf()
            parts.push(head)
            parts.push(tail)
            list_pattern(c, p, "Cons", parts, ty, no_bind, "`::` patterns match a `List`")
        Sequence(items) ->
            val t = zonk(c, ty)
            if !is_list_type(c, t)
                if seq_element(c, t) is Some(element) then return sequence_pattern(c, p, items, t, element, no_bind)
            if items.len() == 0 then return list_pattern(c, p, "Nil", buf(), ty, no_bind, "sequence patterns match a `Seq`")
            // `[rest*]` on a list is the whole list.
            if items.len() == 1 && is_list_type(c, t)
                if items[0].kind is Rest(binder) then return check_pattern(c, binder, t, no_bind)
            // `[a, b, c]` on a list is `a :: [b, c]`.
            var rest: Buf[&Pattern] = buf()
            for i in 1..<items.len()
                rest.push(items[i])
            var parts: Buf[&Pattern] = buf()
            parts.push(items[0])
            parts.push(Pattern(Span(if rest.len() > 0 then rest[0].span.start else p.span.end, p.span.end), Sequence(rest)))
            list_pattern(c, p, "Cons", parts, ty, no_bind, "sequence patterns match a `Seq`")
        Tuple(items) ->
            // A tuple pattern takes apart a tuple of the same size; a tuple is matched as a value
            // with one variant whose fields are its parts.
            var parts: Buf[&Type] = buf()
            var ok = true
            *zonk(c, ty) match
                Tuple(types) ->
                    if types.len() == items.len() then parts = types
                    else
                        c.note(unit, p.span, s"this pattern has ${items.len()} parts, but the tuple it matches, ${type_name(ty)}, has ${types.len()}")
                        ok = false
                ErrorType -> ok = false
                _ ->
                    c.note(unit, p.span, s"a tuple pattern matches a tuple, not ${type_name(ty)}")
                    ok = false
            var typed: Buf[&TPattern] = buf()
            for i in 0..<items.len()
                typed.push(check_pattern(c, items[i], if ok then parts[i] else ErrorType, no_bind))
            if !ok then return TPattern(p.span, ErrorType, PWildcard)
            TPattern(p.span, ty, PVariant(0, typed))
        Typed(binder, written) ->
            val target = resolve_type(c, unit, written)
            val local = binder_local(c, binder, target, no_bind)
            if *target is ErrorType || !settled(zonk(c, ty)) then return TPattern(p.span, ErrorType, PWildcard)
            if !may_match(c, ty, target)
                c.note(unit, p.span, s"a value of type ${type_name(zonk(c, ty))} is never ${type_article(target)}, so this type pattern never matches")
                return TPattern(p.span, ErrorType, PWildcard)
            c.type_tests.push(TypeView(ty, target))
            TPattern(p.span, ty, PType(target, local, !fits(c, ty, target)))

/** A type's name with an article, for a sentence: `an int`, `a Dog`. */
private type_article(t: &Type) -> string
    val name = type_name(t)
    val first = name.bytes[0]
    val vowel = first == u8('a') || first == u8('e') || first == u8('i') || first == u8('o') || first == u8('u') || first == u8('A') || first == u8('E') || first == u8('I') || first == u8('O') || first == u8('U')
    (if vowel then "an " else "a ") + name

// Whether a value of static type `from` may have type `to` at run time. It does where `from` fits
// `to`, where `from` is `Any`, and where `to` is a subclass of the class `from` or conforms to the
// trait `from`; a class and a trait unrelated to it may meet in a subclass, where the class is open.
// A tuple may, part by part, since its parts may be instances of subclasses. Any other value has
// exactly its static type. A type parameter may be any type, so its copies decide.
private may_match(c: *Checker, from: &Type, to: &Type) -> bool
    val x = zonk(c, from)
    val y = zonk(c, to)
    if fits(c, x, y) || *x is AnyType || *x is TypeVar(_, _, _) || *y is TypeVar(_, _, _) then return true
    // A value of a generic type may be an instance whose arguments are subtypes of the static ones,
    // or, for a contravariant parameter, supertypes.
    if !(*y is AnyType) && fits(c, y, x) then return true
    if variant_instances(c, x, y) then return true
    // A class may extend a function type, so a function may be an instance of an open class or a
    // trait, and the other way about.
    if *x is Function(_, _) && *y is Class(j, _, _) then return is_open(c, j)
    if *y is Function(_, _) && *x is Class(k, _, _) then return is_open(c, k)
    // A trait's value may be a built-in value or a tuple that implements it.
    if is_trait_type(c, x) && (is_builtin(y) || *y is Tuple(_)) then return conforms_to_bound(c, y, x)
    *x match
        Class(k, _, _) -> *y match
            Class(j, _, _) ->
                if ancestor_type(c.classes, c.data, y, k) is Some(up)
                    if same_type(up, x) then return true
                (is_trait(c, j) && is_open(c, k)) || (is_trait(c, k) && is_open(c, j))
            _ -> false
        Tuple(xs) -> *y match
            Tuple(ys) ->
                if xs.len() != ys.len() then return false
                for i in 0..<xs.len()
                    if !may_match(c, xs[i], ys[i]) then return false
                true
            _ -> false
        _ -> false

// Whether two instances of one generic type may describe one value: their invariant arguments are
// equal, and their other arguments are references that may describe one value.
private variant_instances(c: *Checker, x: &Type, y: &Type) -> bool
    val (params, xs, ys) = *x match
        Data(d, _, xs) -> *y match
            Data(e, _, ys) -> if d == e then (c.data[d].decl.type_params, xs, ys) else return false
            _ -> return false
        Class(k, _, xs) -> *y match
            Class(j, _, ys) -> if k == j then (c.classes[k].decl.type_params, xs, ys) else return false
            _ -> return false
        _ -> return false
    if xs.len() != ys.len() || xs.len() != params.len() then return false
    for i in 0..<xs.len()
        if same_type(xs[i], ys[i]) then continue
        if params[i].variance is Invariant || !is_reference(xs[i]) || !is_reference(ys[i]) then return false
        if !may_match(c, xs[i], ys[i]) && !may_match(c, ys[i], xs[i]) then return false
    true

// The local a comparison or `n + k` pattern binds: none for `_`. A name that is a variant is not a
// binder there.
private binder_local(c: *Checker, binder: &Pattern, ty: &Type, no_bind: string) -> Option[usize] = binder.kind match
    Name(name) ->
        if variant_named(c, name) is Some(_)
            c.note(unit_of(c), binder.span, s"`$name` is a variant; a comparison binds a name or `_`")
            return None
        if no_bind != ""
            c.note(unit_of(c), binder.span, no_bind)
            return None
        Some(declare_local(c, binder.span, name, ty, c.binds_var))
    _ -> None

// A variant pattern matches a value of the variant's own type, and each field pattern the field's
// type in the matched value's type.
private variant_pattern(c: *Checker, p: &Pattern, v: VariantRef, args: Buf[&Pattern], ty: &Type, no_bind: string) -> &TPattern
    val unit = unit_of(c)
    val d = c.data[v.data]
    val variant = d.variants[v.index]
    var fields: Buf[&Type] = buf()
    var ok = true
    *ty match
        Data(id, _, type_args) ->
            if id == v.data then fields = variant_fields(d, id, v.index, type_args)
            else ok = false
        ErrorType -> ()
        _ -> ok = false
    if !ok then c.note(unit, p.span, s"`${variant.name}` is a variant of `${d.name}`, but the value it matches is ${type_name(ty)}")
    if args.len() != variant.fields.len()
        c.note(unit, p.span, s"`${variant.name}` has ${count(variant.fields.len(), "field")}, not ${args.len()}")
        ok = false
    var typed: Buf[&TPattern] = buf()
    for i in 0..<args.len()
        val field: &Type = if ok && i < fields.len() then fields[i] else ErrorType
        typed.push(check_pattern(c, args[i], field, no_bind))
    if !ok || *ty is ErrorType then return TPattern(p.span, ErrorType, PWildcard)
    TPattern(p.span, ty, PVariant(v.index, typed))

/** The element type of `t` as a `Seq`, when it is one. */
private seq_element(c: *Checker, t: &Type) -> Option[&Type]
    if !(*t is Class(_, _, _) || *t is Data(_, _, _)) then return None
    val seq = c.class_types.get(qualified(CoreModule, "Seq"))?
    val up = holding_ancestor(conformances(c), t, seq)?
    *up match
        Class(_, _, args) -> if args.len() == 1 then Some(args[0]) else None
        _ -> None

// A sequence pattern on a sequence other than a list, `[a, b, c]`, matches one of exactly that many
// elements. The matched sequence is held in a local of its own, through which the pattern asks its
// `length()` once and then reads each element it tests with `apply`, in order, stopping at the first
// that fails; an element matched by `_` is not read. Ending in `rest*`, it matches a sequence of at
// least the elements before it, and binds the rest to `rest` as `drop` gives it.
private sequence_pattern(c: *Checker, p: &Pattern, items: Buf[&Pattern], ty: &Type, element: &Type, no_bind: string) -> &TPattern
    val at = p.span
    val rest = items.len() > 0 && items[items.len() - 1].kind is Rest(_)
    val fixed = if rest then items.len() - 1 else items.len()
    // `[rest*]` is the whole sequence.
    if rest && fixed == 0
        if items[0].kind is Rest(binder) then return check_pattern(c, binder, ty, no_bind)
    val name = s"sequence pattern ${at.start}"
    val local = declare_local(c, at, name, ty, false)
    val length = check_expr(c, compare_at(at, if rest then GreaterEqual else Equal, call_at(at, name_at(at, name), "length"), Expr(at, IntLit(fixed.to_string()))), None)
    var elements: Buf[&TExpr] = buf()
    var typed: Buf[&TPattern] = buf()
    for i in 0..<fixed
        var args: Buf[Argument] = buf()
        args.push(Argument(at, None, Expr(at, IntLit(i.to_string())), false))
        elements.push(check_expr(c, Expr(at, Call(name_at(at, name), args)), None))
        typed.push(check_pattern(c, items[i], element, no_bind))
    if rest
        if items[fixed].kind is Rest(binder)
            var args: Buf[Argument] = buf()
            args.push(Argument(at, None, Expr(at, IntLit(fixed.to_string())), false))
            val dropped = check_expr(c, Expr(at, Call(Expr(at, Member(name_at(at, name), "drop")), args)), None)
            elements.push(dropped)
            typed.push(check_pattern(c, binder, dropped.ty, no_bind))
    TPattern(p.span, ty, PSequence(local, length, elements, typed, rest))

// An extractor pattern, `Name(p1, p2)`, where `Name` is not a variant but a value, an object or a
// local, whose type has an `unapply` or an `unapplySeq` method. The matched value is held in a local
// of its own and passed to the method. An `unapply` answering a `bool` matches where it answers
// `true`, with no patterns; one answering an `Option` matches its `Some`, whose value one pattern
// matches whole and several match part by part, as a tuple of as many parts. An `unapplySeq`
// answers an `Option` of a sequence, which the patterns match as a sequence pattern does, `rest*`
// included. A variant of the name is always the variant.
private extractor_pattern(c: *Checker, p: &Pattern, path: string, args: Buf[&Pattern], ty: &Type, no_bind: string) -> &TPattern
    val unit = unit_of(c)
    val at = p.span
    val target = path_expr(at, path)
    var method = ""
    if extractor_type(c, target) is Some(t)
        if methods_of(c, t, "unapply").len() > 0 then method = "unapply"
        elif methods_of(c, t, "unapplySeq").len() > 0 then method = "unapplySeq"
        else c.note(unit, at, s"`$path` is not a variant, and ${type_name(t)} has no `unapply` or `unapplySeq` to make it an extractor")
    else c.note(unit, at, s"`$path` is not a variant or an extractor")
    if method == "" then return failed_extractor(c, p, args, no_bind)
    val name = s"extractor ${at.start}"
    val local = declare_local(c, at, name, ty, false)
    var call_args: Buf[Argument] = buf()
    call_args.push(Argument(at, None, name_at(at, name), false))
    val view = check_expr(c, Expr(at, Call(Expr(at, Member(target, method)), call_args)), None)
    val result = zonk(c, view.ty)
    if *result is ErrorType then return failed_extractor(c, p, args, no_bind)
    val written = s"`$path.$method`"
    if method == "unapply" && *result is Bool
        if args.len() > 0
            c.note(unit, at, s"$written answers a bool, so it takes no patterns: write `$path()`")
            return failed_extractor(c, p, args, no_bind)
        return TPattern(at, ty, PView(local, view, TPattern(at, result, PLiteral(TExpr(at, result, BoolConst(true))))))
    val option = core_data(c, "Option") match
        Some(d) -> d
        None -> return failed_extractor(c, p, args, no_bind)
    val inner: &Type = *result match
        Data(id, _, type_args) if id == option && type_args.len() == 1 -> type_args[0]
        _ ->
            if method == "unapply" then c.note(unit, at, s"$written answers ${type_name(result)}; an extractor's `unapply` answers an Option or a bool")
            else c.note(unit, at, s"$written answers ${type_name(result)}; an extractor's `unapplySeq` answers an Option of a sequence")
            return failed_extractor(c, p, args, no_bind)
    val some = VariantRef(option, variant_index(c, option, "Some"))
    var part: &Pattern = p
    if method == "unapplySeq"
        val seq = zonk(c, inner)
        if !is_list_type(c, seq) && seq_element(c, seq) is None
            if !(*seq is ErrorType) then c.note(unit, at, s"$written answers ${type_name(result)}; an extractor's `unapplySeq` answers an Option of a sequence")
            return failed_extractor(c, p, args, no_bind)
        part = Pattern(at, Sequence(args))
    elif args.len() == 0
        c.note(unit, at, s"$written answers ${type_name(result)}, so it takes one pattern or more, one for each part of the value it gives")
        return failed_extractor(c, p, args, no_bind)
    elif args.len() == 1 then part = args[0]
    else
        var parts = 0usize
        if *zonk(c, inner) is Tuple(types) then parts = types.len()
        if parts != args.len()
            val gives = if parts == 0 then "one value" else s"$parts values"
            c.note(unit, at, s"$written gives ${type_name(zonk(c, inner))}, $gives, so it takes ${if parts == 0 then "one pattern" else s"$parts patterns"}, not ${args.len()}")
            return failed_extractor(c, p, args, no_bind)
        part = Pattern(at, Tuple(args))
    var fields: Buf[&Pattern] = buf()
    fields.push(part)
    TPattern(at, ty, PView(local, view, variant_pattern(c, p, some, fields, result, no_bind)))

// An extractor pattern that could not be checked: its patterns are checked against nothing, so that
// the names they bind are declared, and it reports no gap in coverage.
private failed_extractor(c: *Checker, p: &Pattern, args: Buf[&Pattern], no_bind: string) -> &TPattern
    for a in args
        check_pattern(c, a, ErrorType, no_bind)
    TPattern(p.span, ErrorType, PWildcard)

// `a.b.c` as an expression: the name `a` and its members.
private path_expr(at: Span, path: string) -> &Expr
    var e: &Expr = Expr(at, Invalid)
    var first = true
    for part in path.split(".")
        e = if first then name_at(at, part) else Expr(at, Member(e, part))
        first = false
    e

// The type of the value `target` names, as the receiver of a call; `None`, with nothing reported,
// where it names none.
private extractor_type(c: *Checker, target: &Expr) -> Option[&Type]
    c.muted = c.muted + 1
    val before = c.muted_notes
    var found: Option[&Type] = None
    if static_receiver(c, target, "unapply") is Some(t) then found = Some(t)
    else
        val typed = check_expr(c, target, None)
        found = Some(zonk(c, typed.ty))
    c.muted = c.muted - 1
    if c.muted_notes != before then return None
    if found is Some(t)
        if *t is ErrorType then return None
    found

// A list pattern is the core library's `List` variant `name` with the patterns `parts` for its
// fields, whatever `Cons` and `Nil` name where it is written. On any other type it is reported with
// `what`.
private list_pattern(c: *Checker, p: &Pattern, name: string, parts: Buf[&Pattern], ty: &Type, no_bind: string, what: string) -> &TPattern
    val t = zonk(c, ty)
    val v = list_variant(c, name)
    if v is Some(found)
        if is_list_type(c, t) then return variant_pattern(c, p, found, parts, t, no_bind)
    if !(*t is ErrorType) then c.note(unit_of(c), p.span, s"$what, not ${type_name(t)}")
    for part in parts
        check_pattern(c, part, ErrorType, no_bind)
    TPattern(p.span, ErrorType, PWildcard)

// A literal in a pattern takes the matched value's type, as it would beside it in `==`.
private pattern_constant(c: *Checker, value: &Expr, ty: &Type) -> &TExpr
    val unit = unit_of(c)
    if *zonk(c, ty) is AnyType
        c.note(unit, value.span, "a literal does not match an Any; match the value by its type first, as in `n: int`")
        check_expr(c, value, None)
        return TExpr(value.span, ErrorType, UnitConst)
    val t = check_expr(c, value, Some(ty))
    if !settled(t.ty) || !settled(ty) then return TExpr(t.span, ErrorType, UnitConst)
    // Matching a value whose type is still unknown against a literal settles it as the literal's.
    if *zonk(c, ty) is Var(_) then unify(c, ty, t.ty)
    if !same_type(t.ty, zonk(c, ty))
        c.note(unit, value.span, s"this pattern is ${type_name(t.ty)}, but the value it matches is ${type_name(ty)}")
        return TExpr(t.span, ErrorType, UnitConst)
    t

/** A fresh inference variable. */
private fresh_var(c: *Checker) -> &Type
    val id = c.vars.len()
    c.vars.push(None)
    Var(id)

/** `t` with every solved variable replaced by its solution. */
zonk(c: *Checker, t: &Type) -> &Type = solve(c.vars, t)

// Makes two types equal by solving variables, and reports whether they can be. A value that never
// finishes, or one whose type already failed, fits anything without deciding a variable.
private unify(c: *Checker, a: &Type, b: &Type) -> bool
    val x = zonk(c, a)
    val y = zonk(c, b)
    // An unknown meeting a type that already failed takes that type, so it is not reported again as
    // one that could not be inferred.
    if *x is ErrorType || *y is ErrorType
        poison(c, x)
        poison(c, y)
        return true
    if *x is Var(i)
        if !same_type(x, y) then c.vars.set(i, Some(y))
        return true
    if *y is Var(j)
        c.vars.set(j, Some(x))
        return true
    *x match
        Tuple(xs) -> *y match
            Tuple(ys) -> unify_all(c, xs, ys)
            _ -> false
        Function(xs, r) -> *y match
            Function(ys, q) -> unify_all(c, xs, ys) && unify(c, r, q)
            _ -> false
        ByName(r) -> *y match
            ByName(q) -> unify(c, r, q)
            _ -> false
        Data(i, _, xs) -> *y match
            Data(j, _, ys) -> i == j && unify_all(c, xs, ys)
            _ -> false
        Class(i, _, xs) -> *y match
            Class(j, _, ys) -> i == j && unify_all(c, xs, ys)
            _ -> false
        _ -> same_type(x, y)

/** Settles each unknown left open since `mark` that no use has settled: as `Nothing` where the call's
 * result names it only where a value is read out, and otherwise by reporting it at the call that
 * made it and settling it as the error type, so nothing reports it again. */
private settle_unknowns(c: *Checker, mark: usize)
    // `Nothing` first, so an unknown another call shares, as `show(None)` shares `show`'s `T`, is
    // settled whichever call recorded it first.
    for i in mark..<c.unknowns.len()
        val u = c.unknowns[i]
        if u.covariant && *zonk(c, Var(u.var_id)) is Var(v) then c.vars.set(v, Some(Nothing))
    for i in mark..<c.unknowns.len()
        val u = c.unknowns[i]
        if *zonk(c, Var(u.var_id)) is Var(v)
            c.note(u.unit, u.at, u.message)
            c.vars.set(v, Some(ErrorType))
    c.unknowns.truncate(mark)

/** Where the unknown `v` occurs in `t`: 0 nowhere, 1 only where a value is read out (the whole
 * type, a covariant argument, a tuple part, a function's result), 2 somewhere else as well. */
private occurrence(c: *Checker, t: &Type, v: usize, covariant: bool) -> i32 = *zonk(c, t) match
    Var(i) -> if i != v then 0 elif covariant then 1 else 2
    Tuple(items) -> occurrences(c, items, v, covariant)
    Function(params, result) ->
        val ps = occurrences(c, params, v, false)
        val r = occurrence(c, result, v, covariant)
        if ps > r then ps else r
    ByName(inner) -> occurrence(c, inner, v, covariant)
    Data(d, _, args) -> occurrence_args(c, c.data[d].decl.type_params, args, v, covariant)
    Class(k, _, args) -> occurrence_args(c, c.classes[k].decl.type_params, args, v, covariant)
    _ -> 0

private occurrences(c: *Checker, types: Buf[&Type], v: usize, covariant: bool) -> i32
    var most = 0
    for t in types
        val o = occurrence(c, t, v, covariant)
        if o > most then most = o
    most

private occurrence_args(c: *Checker, params: Buf[TypeParam], args: Buf[&Type], v: usize, covariant: bool) -> i32
    var most = 0
    for i in 0..<args.len()
        val reads = covariant && i < params.len() && params[i].variance is Covariant
        val o = occurrence(c, args[i], v, reads)
        if o > most then most = o
    most

/** Settles every unknown in `t` as the error type. */
private poison(c: *Checker, t: &Type)
    *zonk(c, t) match
        Var(i) -> c.vars.set(i, Some(ErrorType))
        Tuple(items) ->
            for item in items
                poison(c, item)
        Function(params, result) ->
            for p in params
                poison(c, p)
            poison(c, result)
        ByName(inner) -> poison(c, inner)
        Data(_, _, args) ->
            for a in args
                poison(c, a)
        Class(_, _, args) ->
            for a in args
                poison(c, a)
        _ -> ()

private unify_all(c: *Checker, xs: Buf[&Type], ys: Buf[&Type]) -> bool
    if xs.len() != ys.len() then return false
    for i in 0..<xs.len()
        if !unify(c, xs[i], ys[i]) then return false
    true

// Initialization: no field of an object is observed before the class body sets it. Until a class
// body has initialized its last field, `self` may only read a field already initialized and assign
// a field: it may not call a method, by any spelling, nor be passed, stored, returned or captured.
// An open or abstract class's body runs before a subclass's fields are initialized, so all of it
// keeps those limits, except that it may call a method that cannot be overridden and that is
// itself safe: one whose body uses `self` only to read and assign fields and to call other safe
// methods. Every function is checked first, so the bodies and the closures' captures are known.

/** How one body's uses of `self` are judged. `self` is the local `self_local`, or the first
 * parameter where that is absent. `last` names the class body's last field while it is not yet
 * initialized, and is empty after it. `kind` is `open` or `abstract` for the body of such a class.
 * With `report` false, nothing is reported: the scan only answers whether the body is safe. */
struct InitScan
    unit: usize
    self_local: Option[usize]
    last: string
    kind: string
    report: bool
    /** For the function computing a trait's field, the names of the fields the class has
     * initialized before it, which it may read through the trait's `val`s; empty otherwise. */
    ready: Buf[string]
    /** Whether the body scanned computes a trait's field, so its receiver is the object even where
     * its type is the trait's `Self`. */
    trait_init: bool

/** Checks every class body's uses of `self`. */
private check_initialization(c: *Checker)
    var unsafe = unsafe_methods(c)
    var reported: Buf[usize] = buf()
    for k in 0..<c.classes.len()
        check_class_initialization(c, k, &unsafe, &reported)

// The functions computing the fields of the traits a class stores run before the class body, each
// on the object, so each may read only the fields initialized before its own and may not otherwise
// use `self`, as the class body may not before its last field. One that does is reported once, at
// the trait, in `reported`.
private check_mixed_initialization(c: *Checker, k: usize, kind: string, unsafe: *Buf[bool], reported: *Buf[usize])
    val cls = c.classes[k]
    val first = cls.inherited + cls.decl.params.len()
    for j in 0..<cls.mixed.len()
        val init = c.classes[cls.mixed[j].trait_id].state[cls.mixed[j].state].init
        if contains_id(*reported, init) then continue
        val body = c.bodies[init] match
            Some(b) -> b
            None -> continue
        var ready: Buf[string] = buf()
        for i in 0..<first + j
            if cls.fields[i].public then ready.push(cls.fields[i].name)
        if !scan_init(c, InitScan(c.symbols[init].unit, None, cls.fields[first + j].name, kind, true, ready, true), body, unsafe) then reported.push(init)

private check_class_initialization(c: *Checker, k: usize, unsafe: *Buf[bool], reported: *Buf[usize])
    val cls = c.classes[k]
    if is_trait(c, k) then return
    val body = c.bodies[cls.initializer] match
        Some(b) -> b
        None -> return
    val items = body.kind match
        Block(xs) -> xs
        _ -> return
    val self_local = items[0].kind match
        Let(l, _) -> l
        _ -> return
    // The body's statements and field initializers are its items after the object is made, the
    // superclass initialized and the parameters stored, and before the result.
    var count = 0usize
    var last = 0usize
    var last_name = ""
    // A `lazy val`'s item stores the closure that computes it, which runs only when it is read.
    var deferred: Buf[bool] = buf()
    for m in cls.decl.members
        m match
            FieldMember(f) ->
                count += 1
                last = count
                last_name = f.name
                deferred.push(f.lazy)
            StatementMember(_) ->
                count += 1
                deferred.push(false)
            AbstractFieldMember(_) -> ()
            MethodMember(_, _, _, _) -> ()
    if items.len() < count + 1 then return
    val start = items.len() - 1 - count
    val kind = if is_open(c, k) then cls.decl.modifier else ""
    check_mixed_initialization(c, k, kind, unsafe, reported)
    for i in 0..<count
        val early = i < last
        if !early && kind == "" then return
        if deferred[i] then continue
        val scan = InitScan(cls.unit, Some(self_local), if early then last_name else "", kind, true, buf(), false)
        val item = items[start + i]
        // A field's initializer is checked as it is stored.
        val e = item.kind match
            StoreField(_, _, value, _) -> value
            _ -> item
        scan_init(c, scan, e, unsafe)

/** The methods that cannot be called from an open or abstract class's body, which runs before a
 * subclass's fields are initialized: those that use `self` for more than reading and assigning its
 * fields and calling methods that can be. Every method is taken as safe until its body shows
 * otherwise, and a method that calls an unsafe one is unsafe, so calls among methods settle. */
private unsafe_methods(c: *Checker) -> Buf[bool]
    var unsafe: Buf[bool] = buf()
    for _ in c.symbols
        unsafe.push(false)
    var changed = true
    while changed
        changed = false
        for m in 0..<c.symbols.len()
            if !unsafe[m] && is_class_method(c, m)
                val safe = c.bodies[m] match
                    Some(b) -> scan_init(c, InitScan(c.symbols[m].unit, None, "", "", false, buf(), false), b, &unsafe)
                    None -> false
                if !safe
                    unsafe.set(m, true)
                    changed = true
    unsafe

private is_class_method(c: *Checker, f: usize) -> bool
    val symbol = c.symbols[f]
    symbol.owner_class is Some(_) && !symbol.constructor && symbol.root is None && !symbol.lambda

private is_init_self(s: InitScan, e: &TExpr) -> bool = s.self_local match
    Some(l) -> e.kind match
        Local(x) -> x == l
        _ -> false
    None -> e.kind match
        Param(i) -> i == 0
        _ -> false

private captures_init_self(c: *Checker, s: InitScan, f: usize) -> bool = s.self_local match
    Some(l) -> contains_index(c.symbols[f].captured_locals, l)
    None -> contains_index(c.symbols[f].captured_params, 0)

/** Reports a use of `self` the body may not make: `early` describes it before the last field is
 * initialized, `open` in an open or abstract class's body. Yields false, the scan's verdict. */
private init_violation(c: *Checker, s: InitScan, at: Span, early: string, open: string) -> bool
    if s.report
        if s.trait_init then c.note(s.unit, at, s"$early in the value of the trait's field `${s.last}`, which a class computes before its body: it may read only the fields initialized before it, and use `self` for nothing else")
        elif s.last != "" then c.note(s.unit, at, s"$early before `${s.last}` is initialized; a class body uses `self` for more than reading and assigning its fields only once every field is")
        else c.note(s.unit, at, s"$open in the body of an ${s.kind} class, which runs before a subclass's fields are initialized")
    false

/** Scans `e` for the uses of `self` that `s` forbids; yields whether there are none. */
private scan_init(c: *Checker, s: InitScan, e: &TExpr, unsafe: *Buf[bool]) -> bool
    if is_init_self(s, e) then return init_violation(c, s, e.span, "`self` is passed, stored or returned", "`self` cannot be passed, stored or returned")
    e.kind match
        Call(f, args, _) ->
            var ok = true
            var from = 0usize
            val name = c.symbols[f].decl.name
            if args.len() > 0 && is_class_method(c, f) && is_init_self(s, args[0])
                from = 1
                if s.last != "" then ok = init_violation(c, s, e.span, s"`$name` is called", "")
                elif (*unsafe)[f] then ok = init_violation(c, s, e.span, "", s"`$name` uses `self` for more than its fields, so it cannot be called")
            elif c.symbols[f].root is Some(_) && captures_init_self(c, s, f)
                ok = init_violation(c, s, e.span, s"`$name`, which uses `self`, is called", s"`$name` uses `self`, so it cannot be called")
            for i in from..<args.len()
                if !scan_init(c, s, args[i], unsafe) then ok = false
            ok
        Dispatch(f, _, args, _) -> scan_dispatch(c, s, e, f, args, unsafe)
        // The receiver's type is a type parameter, so it is never the object being initialized,
        // except in the function computing a field of a trait whose methods take a `Self`.
        BoundCall(f, _, args, _) ->
            if s.trait_init then scan_dispatch(c, s, e, f, args, unsafe) else scan_init_all(c, s, args, unsafe)
        FunctionValue(f, _) ->
            if !captures_init_self(c, s, f) then return true
            val symbol = c.symbols[f]
            if symbol.delayed then init_violation(c, s, e.span, "an argument passed by name uses `self`", "an argument passed by name cannot use `self`")
            elif symbol.lambda then init_violation(c, s, e.span, "a lambda that captures `self` is made", "a lambda cannot capture `self`")
            else init_violation(c, s, e.span, s"`${symbol.decl.name}`, which uses `self`, is used as a value", s"`${symbol.decl.name}` uses `self`, so it cannot be used as a value")
        Field(value, _) -> is_init_self(s, value) || scan_init(c, s, value, unsafe)
        // A lazy field's first read runs its initializer, which may use `self` as a method does.
        LazyField(object, _, _, name) ->
            if is_init_self(s, object) then return init_violation(c, s, e.span, s"the `lazy val` `$name`, whose initializer may use `self`, is read", s"the `lazy val` `$name` may use `self`, so it cannot be read")
            scan_init(c, s, object, unsafe)
        LazyGlobal(_, initialize, _) -> scan_init(c, s, initialize, unsafe)
        StoreField(object, _, value, _) ->
            val target = is_init_self(s, object) || scan_init(c, s, object, unsafe)
            scan_init(c, s, value, unsafe) && target
        StoreGlobal(_, value, _) -> scan_init(c, s, value, unsafe)
        CallValue(callee, args) ->
            // An argument delayed for an overload that takes it by name, evaluated at the call by the
            // one chosen, which takes it strictly: its uses of `self` are the expression's own, made
            // now, and the expression is scanned as if written in place.
            if args.len() == 0 && callee.kind is FunctionValue(f, _)
                if c.symbols[f].delayed && c.bodies[f] is Some(body) then return scan_init(c, s, body, unsafe)
            val ok = scan_init(c, s, callee, unsafe)
            scan_init_all(c, s, args, unsafe) && ok
        Construct(_, args) -> scan_init_all(c, s, args, unsafe)
        Collection(_, built) -> scan_init(c, s, built, unsafe)
        Block(items) ->
            if method_value_of_self(c, s, items) is Some(name) then return init_violation(c, s, e.span, s"`$name` is used as a value", s"`$name` cannot be used as a value")
            scan_init_all(c, s, items, unsafe)
        Let(_, value) -> scan_init(c, s, value, unsafe)
        LetPattern(_, value) -> scan_init(c, s, value, unsafe)
        Store(_, value, _) -> scan_init(c, s, value, unsafe)
        MultiStore(_, value) -> scan_init(c, s, value, unsafe)
        Negate(x) -> scan_init(c, s, x, unsafe)
        Not(x) -> scan_init(c, s, x, unsafe)
        Complement(x) -> scan_init(c, s, x, unsafe)
        Convert(x, _) -> scan_init(c, s, x, unsafe)
        Box(x) -> scan_init(c, s, x, unsafe)
        NoneAs(x) -> scan_init(c, s, x, unsafe)
        Arith(_, a, b, _) ->
            val ok = scan_init(c, s, a, unsafe)
            scan_init(c, s, b, unsafe) && ok
        Logic(_, a, b) ->
            val ok = scan_init(c, s, a, unsafe)
            scan_init(c, s, b, unsafe) && ok
        Compare(operands, _) -> scan_init_all(c, s, operands, unsafe)
        If(condition, yes, no) ->
            var ok = scan_init(c, s, condition, unsafe)
            if !scan_init(c, s, yes, unsafe) then ok = false
            if no is Some(x) && !scan_init(c, s, x, unsafe) then ok = false
            ok
        While(_, condition, body, otherwise) ->
            var ok = scan_init(c, s, condition, unsafe)
            if !scan_init(c, s, body, unsafe) then ok = false
            if otherwise is Some(x) && !scan_init(c, s, x, unsafe) then ok = false
            ok
        Break(_, value) -> value match
            Some(x) -> scan_init(c, s, x, unsafe)
            None -> true
        Return(value) -> value match
            Some(x) -> scan_init(c, s, x, unsafe)
            None -> true
        Match(subject, arms) ->
            var ok = scan_init(c, s, subject, unsafe)
            for arm in arms
                if arm.guard is Some(g) && !scan_init(c, s, g, unsafe) then ok = false
                if !scan_init(c, s, arm.body, unsafe) then ok = false
            ok
        Is(value, _, _) -> scan_init(c, s, value, unsafe)
        Clauses(subjects, clauses) ->
            var ok = scan_init_all(c, s, subjects, unsafe)
            for clause in clauses
                for b in clause.bodies
                    if b.guard is Some(g) && !scan_init(c, s, g, unsafe) then ok = false
                    if !scan_init(c, s, b.body, unsafe) then ok = false
            ok
        _ -> true

/** Scans a call of method `f` through a method table, `e`: on `self`, it reads a trait's `val`, which
 * a field initialized already may supply, assigns a trait's `var` field, or calls a method that may be
 * overridden. */
private scan_dispatch(c: *Checker, s: InitScan, e: &TExpr, f: usize, args: Buf[&TExpr], unsafe: *Buf[bool]) -> bool
    var ok = true
    var from = 0usize
    val name = c.symbols[f].decl.name
    if args.len() > 0 && is_init_self(s, args[0])
        from = 1
        // A trait's `val` is read through the method table, from a field a subclass may set.
        if is_trait_field(c, f)
            if !contains_name(s.ready, name) then ok = init_violation(c, s, e.span, s"`$name` is read", s"`$name` is a trait's `val`, which a subclass may supply, so it cannot be read")
        elif setter_field(c, f) is Some(field) then ok = init_violation(c, s, e.span, s"`$field` is assigned", s"`$field` cannot be assigned")
        else ok = init_violation(c, s, e.span, s"`$name` is called", s"`$name` may be overridden, so it cannot be called")
    for i in from..<args.len()
        if !scan_init(c, s, args[i], unsafe) then ok = false
    ok

/** For the method that assigns a trait's `var` field through the trait, the field's name. */
private setter_field(c: *Checker, m: usize) -> Option[string]
    if !contains_id(c.trait_setters, m) then return None
    for s in c.classes[c.symbols[m].owner_class?].state
        if s.setter is Some(x)
            if x == m then return Some(s.field.name)
    None

/** The method's name when `items` make a method of `self` a value: the receiver held in a local,
 * then a closure over that local that calls the method. */
private method_value_of_self(c: *Checker, s: InitScan, items: Buf[&TExpr]) -> Option[string]
    if items.len() != 2 then return None
    val held = items[0].kind match
        Let(l, value) -> if is_init_self(s, value) then l else return None
        _ -> return None
    val f = items[1].kind match
        FunctionValue(f, _) -> f
        _ -> return None
    if !contains_index(c.symbols[f].captured_locals, held) then return None
    val body = c.bodies[f] match
        Some(b) -> b
        None -> return None
    body.kind match
        Call(m, _, _) -> Some(c.symbols[m].decl.name)
        Dispatch(m, _, _, _) -> Some(c.symbols[m].decl.name)
        _ -> None

private scan_init_all(c: *Checker, s: InitScan, items: Buf[&TExpr], unsafe: *Buf[bool]) -> bool
    var ok = true
    for item in items
        if !scan_init(c, s, item, unsafe) then ok = false
    ok

// Derivation through templates. A template, `derive Trait for T`, is checked once as an impl over its
// `T`, bounded by the trait and by `Shaped`; there `T.walk(…)` and the other members of `Shaped` are
// ordinary static calls through the bound. Each `derives` entry naming the trait makes an impl from
// the template's body for the deriving type, declared in the template's file. In it `T` is the type,
// and each call of a member of `Shaped` on `T` is replaced by code written for the type's own
// variants and fields, checked in the type's file: a `match` over the variants calling the visitor's
// `field` once per field at the field's own type, or a loop reading fields from a builder in any
// order. The visitor's `field` hook is found there, for the visitor type the template names, and
// each field's type is held to its bound, a failure reported at the `derives` entry naming the field.

/** Whether `name`, in the code being checked, is the `T` of the template an impl was made from. */
private derived_alias(c: *Checker, name: string) -> bool
    if c.unit_override is Some(_) then return false
    c.derived_context match
        Some(x) -> c.derived[x].site.alias == name
        None -> false

/** The static members `Shaped` gives a template's `T`. */
private is_shaped_member(name: string) -> bool =
    name == "shape" || name == "variantOf" || name == "walk" || name == "walkPair" || name == "build"

/** Records `message` for the `derives` entry of the impl at `x` in `derived`, once. */
private derived_note(c: *Checker, x: usize, message: string)
    for r in c.derived[x].reported
        if r == message then return
    var reported = c.derived[x].reported
    reported.push(message)
    c.derived[x].reported = reported

// What went wrong in each impl made from a template, at its `derives` entry: nothing where the
// template itself has errors, which are the same ones; otherwise what the derivation recorded, or
// the first thing that went wrong checking the template's body for the type.
private report_derived(c: *Checker)
    for dv in c.derived
        if dv.reported.len() == 0 && dv.notes.len() == 0 then continue
        var template_failed = false
        for d in c.units[dv.template_unit].report.items
            if d.span.start >= dv.site.template_span.start && d.span.end <= dv.site.template_span.end then template_failed = true
        if template_failed then continue
        for message in dv.reported
            c.units[dv.site.unit].report.add(error(dv.site.at, message))
        if dv.reported.len() == 0 then c.units[dv.site.unit].report.add(error(dv.site.at, s"`${dv.site.type_name}` cannot derive `${dv.site.trait_text}`: ${dv.notes[0]}"))

/** One field of a deriving type, as the code written for it reads it. */
private struct ShapeField
    name: string
    ty: &Type
    default: Option[&Expr]
    variadic: bool

private struct ShapeVariant
    name: string
    fields: Buf[ShapeField]

// The deriving type's variants and fields: a data type's, or a class's one variant of its name,
// whose fields are its constructor parameters.
private shape_variants(c: *Checker, target: &Type) -> Buf[ShapeVariant]
    var out: Buf[ShapeVariant] = buf()
    *target match
        Data(id, _, _) ->
            val d = c.data[id]
            for k in 0..<d.variants.len()
                val v = d.variants[k]
                var fields: Buf[ShapeField] = buf()
                for j in 0..<v.fields.len()
                    var default: Option[&Expr] = None
                    if k < d.decl.variants.len() && j < d.decl.variants[k].fields.len() then default = d.decl.variants[k].fields[j].default
                    fields.push(ShapeField(v.field_names[j], v.fields[j], default, false))
                out.push(ShapeVariant(v.name, fields))
        Class(k, _, _) ->
            val cls = c.classes[k]
            var fields: Buf[ShapeField] = buf()
            var position = 0usize
            for f in cls.fields
                if f.param && f.owner == k && f.ty is Some(t)
                    var default: Option[&Expr] = None
                    var variadic = false
                    if position < cls.decl.params.len()
                        default = cls.decl.params[position].param.default
                        variadic = cls.decl.params[position].param.variadic
                    fields.push(ShapeField(f.name, t, default, variadic))
                    position += 1
            out.push(ShapeVariant(cls.name, fields))
        _ -> ()
    out

// A call of a member of `Shaped` on `T` in an impl made from a template: its arguments are checked
// where they are written, then the code standing for the call is written for the deriving type and
// checked in the type's file.
private shaped_call(c: *Checker, at: Span, name_span: Span, name: string, args: Buf[Argument], expected: Option[&Type]) -> &TExpr
    val x = c.derived_context.unwrap()
    val target = zonk(c, c.derived[x].target)
    var typed: Buf[&TExpr] = buf()
    for a in args
        typed.push(check_expr(c, a.value, None))
    val wanted: usize = if name == "shape" then 0 elif name == "variantOf" || name == "build" then 1 elif name == "walk" then 2 else 3
    if typed.len() != wanted || *target is ErrorType
        c.note(unit_of(c), name_span, s"`$name` takes ${count(wanted, "argument")}")
        return TExpr(at, ErrorType, UnitConst)
    var slots: Buf[&Expr] = buf()
    for t in typed
        slots.push(Expr(at, Checked(c.checked_slots.len())))
        c.checked_slots.push(t)
    val variants = shape_variants(c, target)
    val type_name_written = c.derived[x].site.type_name
    var written: Option[&Expr] = None
    if name == "shape" then written = Some(Expr(at, Name(shape_value_name(type_name_written))))
    elif name == "variantOf" then written = Some(variant_of_code(at, c.derived[x].site.data, type_name_written, variants, slots[0]))
    elif name == "walk" then written = walk_code(c, x, at, target, variants, slots[0], slots[1], typed[1].ty)
    elif name == "walkPair" then written = walk_pair_code(c, x, at, target, variants, slots[0], slots[1], slots[2], typed[2].ty)
    else written = build_code(c, x, at, target, variants, slots[0], typed[0].ty)
    val code = written match
        Some(e) -> e
        None -> return TExpr(at, ErrorType, UnitConst)
    val outer = c.unit_override
    c.unit_override = Some(c.derived[x].site.unit)
    val result = check_expr(c, code, expected)
    c.unit_override = outer
    result

private shape_name_expr(at: Span, type_name: string, variant: Option[usize], field: Option[usize]) -> &Expr = variant match
    None -> Expr(at, Name(shape_value_name(type_name)))
    Some(v) -> field match
        None -> Expr(at, Name(variant_shape_name(type_name, v)))
        Some(f) -> Expr(at, Name(field_shape_name(type_name, v, f)))

private block_of(at: Span, items: Buf[&Expr]) -> &Expr = Expr(at, Block(items, false))

private bind(at: Span, name: string, value: &Expr) -> &Expr = Expr(at, Binding(name, None, value, false))

private local(at: Span, name: string) -> &Expr = Expr(at, Name(name))

private method_call(at: Span, target: &Expr, name: string, args: Buf[&Expr], type_arg: Option[&TypeExpr]) -> &Expr
    var written: Buf[Argument] = buf()
    for a in args
        written.push(Argument(at, None, a, false))
    var callee = Expr(at, Member(target, name))
    if type_arg is Some(t)
        var types: Buf[&TypeExpr] = buf()
        types.push(t)
        callee = Expr(at, TypeApply(callee, types))
    Expr(at, Call(callee, written))

private plain_call(at: Span, name: string, args: Buf[&Expr]) -> &Expr
    var written: Buf[Argument] = buf()
    for a in args
        written.push(Argument(at, None, a, false))
    Expr(at, Call(Expr(at, Name(name)), written))

private one(e: &Expr) -> Buf[&Expr]
    var out: Buf[&Expr] = buf()
    out.push(e)
    out

private two(a: &Expr, b: &Expr) -> Buf[&Expr]
    var out: Buf[&Expr] = buf()
    out.push(a)
    out.push(b)
    out

private three(a: &Expr, b: &Expr, d: &Expr) -> Buf[&Expr]
    var out = two(a, b)
    out.push(d)
    out

/** A variant's pattern binding its fields to `prefix0`, `prefix1`, …, or matching them with `_`. */
private shape_pattern(at: Span, v: ShapeVariant, prefix: string) -> &Pattern
    if v.fields.len() == 0 then return Pattern(at, Name(v.name))
    var args: Buf[&Pattern] = buf()
    for i in 0..<v.fields.len()
        args.push(if prefix == "" then Pattern(at, Wildcard) else Pattern(at, Name(s"$prefix$i")))
    Pattern(at, Constructor(v.name, args))

/** Field `i` of `value`: bound by the pattern for a data type, read from the object for a class. */
private field_value(at: Span, data: bool, value: &Expr, prefix: string, f: ShapeField, i: usize) -> &Expr =
    if data then Expr(at, Name(s"$prefix$i")) else Expr(at, Member(value, f.name))

// `T.variantOf(x)`: the shape of the variant `x` is.
private variant_of_code(at: Span, data: bool, type_name: string, variants: Buf[ShapeVariant], value: &Expr) -> &Expr
    if !data
        var items: Buf[&Expr] = buf()
        items.push(bind(at, "__shape_value", value))
        items.push(shape_name_expr(at, type_name, Some(0), None))
        return block_of(at, items)
    var arms: Buf[Arm] = buf()
    for i in 0..<variants.len()
        arms.push(Arm(shape_pattern(at, variants[i], ""), None, shape_name_expr(at, type_name, Some(i), None)))
    Expr(at, Match(value, arms))

// The method `name` that the visitor or builder type `t` declares with one type parameter of its own,
// the hook the code written for each field calls: found where the template names the type, and
// reported at the `derives` entry where it has none.
private shape_hook(c: *Checker, x: usize, t: &Type, name: string, role: string, signature: string) -> Option[usize]
    val methods = *t match
        Data(_, _, _) -> receiver_methods(c, t, name)
        Class(k, _, _) -> methods_named(c, k, name)
        _ -> buf()
    for m in methods
        if !c.symbols[m].static_member && c.symbols[m].decl.type_params.len() == 1 then return Some(m)
    val site = c.derived[x].site
    derived_note(c, x, s"`${site.type_name}` cannot derive `${site.trait_text}`: the $role `${type_name(t)}` the template names declares no method `$signature`, with one type parameter of its own")
    None

// Holds each field of the deriving type to the bounds of the hook's type parameter, reporting each
// that falls short at the `derives` entry, by name. Whether every field meets them is the result.
private fields_meet_hook(c: *Checker, x: usize, variants: Buf[ShapeVariant], hook: usize) -> bool
    val s = c.symbols[hook]
    val bounds = bounds_at(c, s.type_owner, s.type_params, s.type_params.len() - 1)
    val site = c.derived[x].site
    var ok = true
    for v in variants
        for f in v.fields
            for b in bounds
                if conforms_to_bound(c, f.ty, b) then continue
                ok = false
                val named = if variants.len() == 1 then f.name else s"${v.name}.${f.name}"
                val shown = type_name(zonk(c, f.ty))
                val hint = if *f.ty is TypeVar(_, _, _) then s"; bound the parameter, as in `[$shown: ${type_name(b)}]`" else ""
                derived_note(c, x, s"`${site.type_name}` cannot derive `${site.trait_text}`: field `$named` has type `$shown`, which does not implement `${type_name(b)}`$hint")
    ok

// `T.walk(value, visitor)`: the visitor's `variant` with the value's variant, then its `field` once
// per field of that variant, in order, then its `finish` with the variant, each call on what the one
// before returned. Each variant's arm passes its own shape as written, so code reading it is compiled
// for that variant.
private walk_code(c: *Checker, x: usize, at: Span, target: &Type, variants: Buf[ShapeVariant], value: &Expr, visitor: &Expr, visitor_type: &Type) -> Option[&Expr]
    val hook = shape_hook(c, x, zonk(c, visitor_type), "field", "visitor", "field[F: Bound](f: FieldShape, value: F)")?
    if !fields_meet_hook(c, x, variants, hook) then return None
    val site = c.derived[x].site
    val subject = local(at, "__shape_value")
    var items: Buf[&Expr] = buf()
    items.push(bind(at, "__shape_value", value))
    items.push(bind(at, "__shape_visitor", visitor))
    var arms: Buf[Arm] = buf()
    for i in 0..<variants.len()
        val v = variants[i]
        var chain = method_call(at, local(at, "__shape_visitor"), "variant", one(shape_name_expr(at, site.type_name, Some(i), None)), None)
        for j in 0..<v.fields.len()
            chain = method_call(at, chain, "field", two(shape_name_expr(at, site.type_name, Some(i), Some(j)), field_value(at, site.data, subject, "__shape_f", v.fields[j], j)), None)
        chain = method_call(at, chain, "finish", one(shape_name_expr(at, site.type_name, Some(i), None)), None)
        if !site.data
            items.push(chain)
            return Some(block_of(at, items))
        arms.push(Arm(shape_pattern(at, v, "__shape_f"), None, chain))
    items.push(Expr(at, Match(subject, arms)))
    Some(block_of(at, items))

// `T.walkPair(a, b, visitor)`: the visitor's `variants` with both values' variants, then, where they
// are the same variant, its `field` once per field with both values' fields. Where they are, that
// variant's shape is passed as written, so code reading it is compiled for that variant; only values
// of different variants look theirs up.
private walk_pair_code(c: *Checker, x: usize, at: Span, target: &Type, variants: Buf[ShapeVariant], a: &Expr, b: &Expr, visitor: &Expr, visitor_type: &Type) -> Option[&Expr]
    val hook = shape_hook(c, x, zonk(c, visitor_type), "field", "visitor", "field[F: Bound](f: FieldShape, a: F, b: F)")?
    if !fields_meet_hook(c, x, variants, hook) then return None
    val site = c.derived[x].site
    val first = local(at, "__shape_a")
    val second = local(at, "__shape_b")
    var items: Buf[&Expr] = buf()
    items.push(bind(at, "__shape_a", a))
    items.push(bind(at, "__shape_b", b))
    items.push(bind(at, "__shape_visitor", visitor))
    var arms: Buf[Arm] = buf()
    for i in 0..<variants.len()
        val v = variants[i]
        val shape = shape_name_expr(at, site.type_name, Some(i), None)
        var chain = method_call(at, local(at, "__shape_visitor"), "variants", two(shape, shape_name_expr(at, site.type_name, Some(i), None)), None)
        for j in 0..<v.fields.len()
            val mine = field_value(at, site.data, first, "__shape_a", v.fields[j], j)
            val theirs = field_value(at, site.data, second, "__shape_b", v.fields[j], j)
            chain = method_call(at, chain, "field", three(shape_name_expr(at, site.type_name, Some(i), Some(j)), mine, theirs), None)
        if !site.data
            items.push(chain)
            return Some(block_of(at, items))
        var pair: Buf[&Pattern] = buf()
        pair.push(shape_pattern(at, v, "__shape_a"))
        pair.push(shape_pattern(at, v, "__shape_b"))
        arms.push(Arm(Pattern(at, Tuple(pair)), None, chain))
    if variants.len() > 1
        val variant_a = variant_of_code(at, site.data, site.type_name, variants, first)
        val variant_b = variant_of_code(at, site.data, site.type_name, variants, second)
        arms.push(Arm(Pattern(at, Wildcard), None, method_call(at, local(at, "__shape_visitor"), "variants", two(variant_a, variant_b), None)))
    items.push(Expr(at, Match(Expr(at, Tuple(two(first, second))), arms)))
    Some(block_of(at, items))

/** A type already resolved, written where code expects a type expression. */
private resolved(c: *Checker, at: Span, t: &Type) -> &TypeExpr
    c.type_slots.push(t)
    TypeExpr(at, ResolvedType(c.type_slots.len() - 1))

// `T.build(builder)`: a function local to the call, so the builder's errors can return from it. It
// asks the builder for the variant, then for fields in any order until it has no more, each read at
// its own type into a slot of its own; a field supplied twice is the builder's `duplicate`. A field
// never supplied takes its default, evaluated as the constructor would, seeing the fields before
// it, and otherwise the builder's `missing` decides. An index out of range is a fault of the
// builder, and traps.
private build_code(c: *Checker, x: usize, at: Span, target: &Type, variants: Buf[ShapeVariant], builder: &Expr, builder_type: &Type) -> Option[&Expr]
    val site = c.derived[x].site
    if *target is Class(k, _, _)
        val modifier = c.classes[k].decl.modifier
        if modifier == "open" || modifier == "abstract"
            derived_note(c, x, s"`${site.type_name}` cannot derive `${site.trait_text}`: its template builds values, and `${site.type_name}` is $modifier, so a value of its type could be of any subclass")
            return None
    val b = zonk(c, builder_type)
    val error_type = builder_error(c, b) match
        Some(e) -> e
        None ->
            derived_note(c, x, s"`${site.type_name}` cannot derive `${site.trait_text}`: the builder `${type_name(b)}` the template names does not implement `ShapeBuilder`")
            return None
    val field_hook = shape_hook(c, x, b, "field", "builder", "field[F: Bound](f: FieldShape) -> Result[F, E]")?
    val missing_hook = shape_hook(c, x, b, "missing", "builder", "missing[F: Bound](f: FieldShape) -> Result[F, E]")?
    if !fields_meet_hook(c, x, variants, field_hook) then return None
    if !fields_meet_hook(c, x, variants, missing_hook) then return None
    val result_id = c.types.get(qualified(CoreModule, "Result")) match
        Some(id) -> id
        None -> return None
    var result_args: Buf[&Type] = buf()
    result_args.push(target)
    result_args.push(error_type)
    val result_type = Data(result_id, "Result", result_args)
    val builder_local = local(at, "__shape_builder")
    var dispatch: &Expr = Expr(at, UnitLit)
    val chosen = Expr(at, Propagate(method_call(at, builder_local, "variant", one(shape_name_expr(at, site.type_name, None, None)), None)))
    if variants.len() == 1
        var items: Buf[&Expr] = buf()
        items.push(chosen)
        items.push(variant_build(c, at, site, variants[0], 0, error_type))
        dispatch = block_of(at, items)
    else
        var arms: Buf[Arm] = buf()
        for i in 0..<variants.len()
            arms.push(Arm(Pattern(at, Literal(Expr(at, IntLit(s"$i")))), None, variant_build(c, at, site, variants[i], i, error_type)))
        arms.push(Arm(Pattern(at, Wildcard), None, plain_call(at, "fail", one(Expr(at, StringLit(s"a builder chose a variant `${site.type_name}` does not have"))))))
        dispatch = Expr(at, Match(chosen, arms))
    val function = Function(buf(), at, at, "__shape_build", buf(), buf(), Some(resolved(c, at, result_type)), Some(dispatch), buf())
    var items: Buf[&Expr] = buf()
    items.push(bind(at, "__shape_builder", builder))
    items.push(Expr(at, LocalFunction(function)))
    items.push(plain_call(at, "__shape_build", buf()))
    Some(block_of(at, items))

/** The `E` of `ShapeBuilder[E]` that builder type `b` implements. */
private builder_error(c: *Checker, b: &Type) -> Option[&Type]
    val k = c.class_types.get(qualified(CoreModule, "ShapeBuilder"))?
    val seen = trait_view(c, b, k)?
    *seen match
        Class(_, _, args) -> if args.len() == 1 then Some(args[0]) else None
        _ -> None

// One variant's fields read from the builder, then the value made of them.
private variant_build(c: *Checker, at: Span, site: DeriveSite, v: ShapeVariant, i: usize, error_type: &Type) -> &Expr
    val builder_local = local(at, "__shape_builder")
    var items: Buf[&Expr] = buf()
    for j in 0..<v.fields.len()
        val slot_type = resolved(c, at, option_of(c, v.fields[j].ty))
        items.push(Expr(at, Binding(s"__shape_slot$j", Some(slot_type), Expr(at, Name("None")), true)))
    var field_arms: Buf[Arm] = buf()
    for j in 0..<v.fields.len()
        val f = v.fields[j]
        val shape = shape_name_expr(at, site.type_name, Some(i), Some(j))
        val slot = local(at, s"__shape_slot$j")
        val twice = Expr(at, Return(Some(plain_call(at, "Err", one(method_call(at, builder_local, "duplicate", one(shape), None))))))
        val read = Expr(at, Propagate(method_call(at, builder_local, "field", one(shape), Some(resolved(c, at, f.ty)))))
        val store = Expr(at, Assign(slot, None, plain_call(at, "Some", one(read)), false, at))
        var some_args: Buf[&Pattern] = buf()
        some_args.push(Pattern(at, Wildcard))
        val given = Expr(at, Is(slot, Pattern(at, Constructor("Some", some_args)), false))
        field_arms.push(Arm(Pattern(at, Literal(Expr(at, IntLit(s"$j")))), None, Expr(at, If(given, twice, Some(store)))))
    field_arms.push(Arm(Pattern(at, Wildcard), None, plain_call(at, "fail", one(Expr(at, StringLit(s"a builder named a field `${v.name}` does not have"))))))
    var index_args: Buf[&Pattern] = buf()
    index_args.push(Pattern(at, Name("__shape_index")))
    var next_arms: Buf[Arm] = buf()
    next_arms.push(Arm(Pattern(at, Name("None")), None, Expr(at, Break(None))))
    next_arms.push(Arm(Pattern(at, Constructor("Some", index_args)), None, Expr(at, Match(local(at, "__shape_index"), field_arms))))
    val next = Expr(at, Propagate(method_call(at, builder_local, "next", one(shape_name_expr(at, site.type_name, Some(i), None)), None)))
    items.push(Expr(at, Loop(Expr(at, Match(next, next_arms)))))
    // Each field under its own name, so a default sees the fields before it as the constructor's does.
    var made: Buf[Argument] = buf()
    for j in 0..<v.fields.len()
        val f = v.fields[j]
        val shape = shape_name_expr(at, site.type_name, Some(i), Some(j))
        var absent: &Expr = Expr(at, Propagate(method_call(at, builder_local, "missing", one(shape), Some(resolved(c, at, f.ty)))))
        if f.default is Some(d) then absent = d
        var given_args: Buf[&Pattern] = buf()
        given_args.push(Pattern(at, Name("__shape_given")))
        var arms: Buf[Arm] = buf()
        arms.push(Arm(Pattern(at, Constructor("Some", given_args)), None, local(at, "__shape_given")))
        arms.push(Arm(Pattern(at, Name("None")), None, absent))
        items.push(Expr(at, Binding(f.name, Some(resolved(c, at, f.ty)), Expr(at, Match(local(at, s"__shape_slot$j"), arms)), false)))
        var passed = local(at, f.name)
        if f.variadic then passed = Expr(at, Splice(local(at, f.name)))
        made.push(Argument(at, None, passed, false))
    val value = if v.fields.len() == 0 && site.data then Expr(at, Name(v.name)) else Expr(at, Call(Expr(at, Name(v.name)), made))
    items.push(plain_call(at, "Ok", one(value)))
    block_of(at, items)

/** `Option[t]`, the core library's. */
private option_of(c: *Checker, t: &Type) -> &Type
    val id = c.types.get(qualified(CoreModule, "Option")).unwrap()
    var args: Buf[&Type] = buf()
    args.push(t)
    Data(id, "Option", args)
