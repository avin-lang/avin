module dev.avinlang.compiler
@tests

import sh.sysl.parsing.{Source, source_of}
import sysl.buf.{Buf, buf}
import sysl.fs.{entries, is_dir, make_temp_dir, read_text, remove_dir_all, write_text}
import sysl.process.Stdio

// The formatter: the spaces between tokens, indentation, blank lines and comments, lines broken at
// the width limit, literate files, the refusals, `avin fmt` and every source file of the
// repository formatted without a change of meaning.

// The text formatted, which must be formatted already when formatted again.
private formatted(text: string) -> string = formatted_as("probe.avin", text)

private formatted_as(name: string, text: string) -> string
    val once = format_text(name, text) match
        Ok(t) -> t
        Err(why) -> panic(s"not formatted: $why")
    assert_eq(format_text(name, once).unwrap(), once)
    once

// ---- spaces ----

@test("fmt: a member declared without a parameter list keeps its shape, and its calls stay without parentheses")
fmt_parameterless()
    assert_eq(formatted("class A\n  head->int=1\n  tail ->A=self\n  clear() -> int = 0\n"), "class A\n  head -> int = 1\n  tail -> A = self\n  clear() -> int = 0\n")
    assert_eq(formatted("val x = a.tail.head+a.clear()\n"), "val x = a.tail.head + a.clear()\n")

@test("fmt: spaces around binary operators, `=` and `->`, after `,` and `:`, none inside brackets")
fmt_spaces_between_tokens()
    assert_eq(formatted("f( a:int,b :int )->int=a+b*2\n"), "f(a: int, b: int) -> int = a + b * 2\n")
    assert_eq(formatted("val xs = [ 1,2 ]\nval m = { \"a\":1 }\n"), "val xs = [1, 2]\nval m = {\"a\": 1}\n")
    assert_eq(formatted("val r = 0..<n\nval s = 1..10\n"), "val r = 0 ..< n\nval s = 1 .. 10\n")
    assert_eq(formatted("val ok = a&& !b||c==d\n"), "val ok = a && !b || c == d\n")
    assert_eq(formatted("val ys = xs ++ ys :+ 3\n"), "val ys = xs ++ ys :+ 3\n")
    // `#` is an operator character, so `#::` is one token, spaced as any symbol method is.
    assert_eq(formatted("val zs = 0 #::  1#::xs\nval v = a##b\n"), "val zs = 0 #:: 1 #:: xs\nval v = a ## b\n")

@test("fmt: a type parameter's bounds joined by `&` are spaced as a binary operator, the lower bound and variance kept")
fmt_intersection_bounds()
    assert_eq(formatted("f[T:Ord&Display](x:T)->T=x\n"), "f[T: Ord & Display](x: T) -> T = x\n")
    assert_eq(formatted("f[T: Ord  &  Display & Hash, U](x: T) = x\n"), "f[T: Ord & Display & Hash, U](x: T) = x\n")
    assert_eq(formatted("g[W >: T:Display&Ord](x: W) -> W = x\n"), "g[W >: T: Display & Ord](x: W) -> W = x\n")
    assert_eq(formatted("class Box[+T: Named&Source[int]](val v: T)\n"), "class Box[+T: Named & Source[int]](val v: T)\n")
    assert_eq(formatted("impl[T:Ord&Display] Display for Box[T]\n  display(out: Writer, spec: FormatSpec) = ()\n"), "impl[T: Ord & Display] Display for Box[T]\n  display(out: Writer, spec: FormatSpec) = ()\n")

@test("fmt: a prefix operator stays against its operand, and two signs keep apart")
fmt_prefix_operators()
    assert_eq(formatted("val a = - x\nval b = f(-1, ! ok)\nval c = a- -b\n"), "val a = -x\nval b = f(-1, !ok)\nval c = a - -b\n")
    assert_eq(formatted("f() -> int\n    return -1\n"), "f() -> int\n  return -1\n")
    assert_eq(formatted("main()\n    for x in 10..0 by -4 do println(x)\n"), "main()\n  for x in 10 .. 0 by -4 do println(x)\n")

@test("fmt: `end` used as a name is an operand, so an operator after it stays binary, and `end name` still closes")
fmt_end_as_a_name()
    assert_eq(formatted("f(end: int) -> int = end - 1\n"), "f(end: int) -> int = end - 1\n")
    assert_eq(formatted("f(end: int) -> int = end-1\n"), "f(end: int) -> int = end - 1\n")
    assert_eq(formatted("f(end: int) -> int = end * 2 + end % 4\n"), "f(end: int) -> int = end * 2 + end % 4\n")
    assert_eq(formatted("f(end: int) -> bool = end < 3 && -end > -9\n"), "f(end: int) -> bool = end < 3 && -end > -9\n")
    assert_eq(formatted("f(x: int) -> int\n  val end = x\n  g(end - 1, -end)\n"), "f(x: int) -> int\n  val end = x\n  g(end - 1, -end)\n")
    assert_eq(formatted("f(x: int)\n  while x > 0\n    g(x)\n  end while\n"), "f(x: int)\n  while x > 0\n    g(x)\n  end while\n")

@test("fmt: members, calls, type arguments, `?`, splices and annotations keep their tokens together")
fmt_tight_tokens()
    assert_eq(formatted("val n = xs . size()\n"), "val n = xs.size()\n")
    assert_eq(formatted("f(xs: int*) -> int = g(xs*)?\n"), "f(xs: int*) -> int = g(xs*)?\n")
    assert_eq(formatted("val m: Map[string, int] = Map()\n"), "val m: Map[string, int] = Map()\n")
    assert_eq(formatted("@test( \"x\" )\nt() = ()\n"), "@test(\"x\")\nt() = ()\n")
    assert_eq(formatted("val s = s\"a ${ x+1 } b\"\n"), "val s = s\"a ${ x+1 } b\"\n")
    assert_eq(formatted("f(x: int) -> int = x match\n    small@1..5 -> small\n    _ -> 0\n"), "f(x: int) -> int = x match\n  small @ 1 .. 5 -> small\n  _ -> 0\n")

@test("fmt: names in any script are spaced as ASCII names are, and a name never runs into the next")
fmt_unicode_names()
    assert_eq(formatted("fläche( breite:int,höhe :int )->int=breite*höhe\n"), "fläche(breite: int, höhe: int) -> int = breite * höhe\n")
    assert_eq(formatted("val 名前 = größe . size()+Δ\n"), "val 名前 = größe.size() + Δ\n")
    assert_eq(formatted("val s = s\"$ü ${ ü+1 }\"\n"), "val s = s\"$ü ${ ü+1 }\"\n")
    assert_eq(formatted("val v\u{20D7} = x\u{663}\n"), "val v\u{20D7} = x\u{663}\n")

@test("fmt: a dot after a number keeps its space, since `1 .5` is not `1.5`")
fmt_number_dot()
    assert_eq(formatted("val a = 1.toString()\n"), "val a = 1.toString()\n")

// ---- indentation ----

@test("fmt: every block level is two columns, whatever the source used")
fmt_indentation()
    val src = "main()\n    if a\n        b()\n    else\n            c()\n    d()\n"
    assert_eq(formatted(src), "main()\n  if a\n    b()\n  else\n    c()\n  d()\n")
    assert_eq(formatted("f(x: int) -> int = x match\n   0 -> 1\n   _ -> 2\n"), "f(x: int) -> int = x match\n  0 -> 1\n  _ -> 2\n")

@test("fmt: continuation lines stay continuation lines, two columns in")
fmt_continuation_lines()
    val src = "main()\n    val total = a\n          + b * c\n          - d\n    println(total)\n"
    assert_eq(formatted(src), "main()\n  val total = a\n    + b * c\n    - d\n  println(total)\n")

@test("fmt: a method chain's `.` lines stay one call per line, two columns in")
fmt_dot_lines()
    val src = "main()\n    val ys = xs\n          .map(f)\n          .filter(g)\n    xs\n        .foreach x ->\n            println(x)\n        .length\n"
    assert_eq(formatted(src), "main()\n  val ys = xs\n    .map(f)\n    .filter(g)\n  xs\n    .foreach x ->\n      println(x)\n    .length\n")

@test("fmt: a block opened inside brackets is indented from the line that opens it")
fmt_block_in_brackets()
    val src = "main()\n    foo(xs, x ->\n            val y = x\n            y)\n"
    assert_eq(formatted(src), "main()\n  foo(xs, x ->\n    val y = x\n    y)\n")

@test("fmt: a trailing block and a lambda's block keep their places")
fmt_trailing_blocks()
    val src = "main()\n    retry(3)\n        fetch()\n    xs.foreach x ->\n        println(x)\n"
    assert_eq(formatted(src), "main()\n  retry(3)\n    fetch()\n  xs.foreach x ->\n    println(x)\n")

// ---- comments and blank lines ----

@test("fmt: comments are kept exactly, a trailing one a space after the code, a lone one at its block")
fmt_comments()
    val src = "// head  comment\nmain()\n        //   inside\n    a()   // after a\n    if b\n        c()\n            // deeper than c\n    d()\n"
    assert_eq(formatted(src), "// head  comment\nmain()\n  //   inside\n  a() // after a\n  if b\n    c()\n    // deeper than c\n  d()\n")

@test("fmt: at most one blank line, none at the ends of the file")
fmt_blank_lines()
    val src = "\n\nmain()\n    a()\n\n\n\n    b()\n\n\n"
    assert_eq(formatted(src), "main()\n  a()\n\n  b()\n")

@test("fmt: a blank line between top-level declarations, except between one-line ones")
fmt_blank_between_declarations()
    val src = "import a.b\nimport a.c\nval x: int = 1\nf() -> int\n    1\ng() = 2\nh() = 3\n"
    assert_eq(formatted(src), "import a.b\nimport a.c\nval x: int = 1\n\nf() -> int\n  1\n\ng() = 2\nh() = 3\n")

@test("fmt: the blank line goes before a declaration's comments and annotations, never inside them")
fmt_blank_before_comments()
    val src = "f() -> int\n    1\n// about g\n@test(\"g\")\ng()\n    assert(true)\n"
    assert_eq(formatted(src), "f() -> int\n  1\n\n// about g\n@test(\"g\")\ng()\n  assert(true)\n")
    assert_eq(formatted("f() -> int\n    1\n\n// about g\ng() = 2\n"), "f() -> int\n  1\n\n// about g\ng() = 2\n")

@test("fmt: the clauses of an annotated function stay with its signature, and the next declaration is apart")
fmt_annotated_clauses()
    val src = "@tailrec\ngcd(a: int, b: int) -> int\ngcd(a, 0) = a\ngcd(a, b) = gcd(b, a % b)\ng() = 2\nh() = 3\n"
    assert_eq(formatted(src), "@tailrec\ngcd(a: int, b: int) -> int\ngcd(a, 0) = a\ngcd(a, b) = gcd(b, a % b)\n\ng() = 2\nh() = 3\n")
    // Blank lines written between them are dropped too.
    assert_eq(formatted("@tailrec\ngcd(a: int, b: int) -> int\n\ngcd(a, 0) = a\n\ngcd(a, b) = gcd(b, a % b)\n"), "@tailrec\ngcd(a: int, b: int) -> int\ngcd(a, 0) = a\ngcd(a, b) = gcd(b, a % b)\n")

@test("fmt: one-line clauses stay with their signature and each other, written with blank lines or without")
fmt_one_line_clauses()
    val want = "fib(n: int) -> int\nfib(n < 2) = n\nfib(n) = fib(n - 1) + fib(n - 2)\n"
    assert_eq(formatted("fib(n: int) -> int\nfib(n < 2) = n\nfib(n) = fib(n - 1) + fib(n - 2)\n"), want)
    assert_eq(formatted("fib(n: int) -> int\n\nfib(n < 2) = n\n\n\nfib(n) = fib(n - 1) + fib(n - 2)\n"), want)
    // Type parameters, a guard on the clause's line, and modifiers before the signature.
    val generic = "private pick[T](o: Option[T], d: T) -> T\npick(Some(x), _) | true = x\npick(_, d) = d\n"
    assert_eq(formatted("private pick[T](o: Option[T], d: T) -> T\n\npick(Some(x), _) | true = x\n\npick(_, d) = d\n"), generic)

@test("fmt: a multi-line clause stays with its signature and the clauses beside it, with no blank line anywhere between")
fmt_multi_line_clauses()
    val want = "classify(n: int) -> string\nclassify(0) = \"zero\"\nclassify(n)\n  | n < 0 = \"negative\"\n  | _ = \"positive\"\nclassify(n) =\n  val s = \"never\"\n  s\n"
    assert_eq(formatted("classify(n: int) -> string\nclassify(0) = \"zero\"\nclassify(n)\n    | n < 0 = \"negative\"\n    | _ = \"positive\"\nclassify(n) =\n    val s = \"never\"\n    s\n"), want)
    assert_eq(formatted("classify(n: int) -> string\n\nclassify(0) = \"zero\"\n\nclassify(n)\n    | n < 0 = \"negative\"\n    | _ = \"positive\"\n\nclassify(n) =\n    val s = \"never\"\n    s\n"), want)
    // A blank line inside a clause's body is the body's own, and stays.
    val inside = "f(n: int) -> int\nf(0) =\n  val a = 1\n\n  a\nf(n) = n\n"
    assert_eq(formatted(inside), inside)

@test("fmt: the next, different declaration after a function written as clauses keeps its blank line")
fmt_clauses_then_declaration()
    val src = "sign(n: int) -> int\nsign(0) = 0\nsign(n)\n    | n < 0 = -1\n    | _ = 1\ng() = 2\n// h\nh(n: int) -> int\nh(n) = n\n"
    assert_eq(formatted(src), "sign(n: int) -> int\nsign(0) = 0\nsign(n)\n  | n < 0 = -1\n  | _ = 1\n\ng() = 2\n\n// h\nh(n: int) -> int\nh(n) = n\n")
    // One-line clauses after one-line declarations make a multi-line declaration, set apart.
    assert_eq(formatted("val x = 1\nf(n: int) -> int\nf(n) = n\nval y = 2\n"), "val x = 1\n\nf(n: int) -> int\nf(n) = n\n\nval y = 2\n")
    // Two overloads without bodies are two declarations, and a blank line between them stays.
    val overloads = "trait T\n  f(a: int) -> int\n\n  f(s: string) -> string\n"
    assert_eq(formatted(overloads), overloads)

@test("fmt: clauses inside a class, an object and a function stay together, and other members keep their blank lines")
fmt_nested_clauses()
    val cls = "class C\n  f(n: int) -> int\n\n  f(0) = 1\n\n  f(n) =\n    n\n\n  g() = 2\n"
    assert_eq(formatted(cls), "class C\n  f(n: int) -> int\n  f(0) = 1\n  f(n) =\n    n\n\n  g() = 2\n")
    val obj = "object O\n    f(n: int) -> int\n\n    f(0) = 1\n\n    f(n) = n\n"
    assert_eq(formatted(obj), "object O\n  f(n: int) -> int\n  f(0) = 1\n  f(n) = n\n")
    val local = "main()\n    f(n: int) -> int\n\n    f(0) = 1\n\n    f(n) = n\n\n    println(f(2))\n"
    assert_eq(formatted(local), "main()\n  f(n: int) -> int\n  f(0) = 1\n  f(n) = n\n\n  println(f(2))\n")

@test("fmt: a comment between clauses stays, with no blank line around it")
fmt_comment_between_clauses()
    val want = "f(n: int) -> int\n// the base case\nf(0) = 1\n// every other\nf(n) = n\n"
    assert_eq(formatted("f(n: int) -> int\n\n// the base case\n\nf(0) = 1\n\n// every other\nf(n) = n\n"), want)
    assert_eq(formatted(want), want)

@test("fmt: the arms of a `match` are no clauses, and a blank line between them stays")
fmt_match_arms_not_clauses()
    val src = "f(o: Option[int]) -> int = o match\n  Some(1) -> 1\n\n  Some(2) | Some(3) -> 2\n\n  Some(n) -> n\n  None -> 0\n"
    assert_eq(formatted(src), src)

@test("fmt: a `select`'s arms are indented a level under it, inside parentheses too, and `end select` closes no block")
fmt_select_arms()
    val src = "f(c: C) = select\n      c.receive() as Some(x) -> x\n      else 0\n"
    assert_eq(formatted(src), "f(c: C) = select\n  c.receive() as Some(x) -> x\n  else 0\n")
    val inside = "main()\n  println(1, select\n    c.receive() -> 1\n    after d -> 2)\n"
    assert_eq(formatted(inside), inside)
    val ended = "main()\n  select\n    c.receive() -> 1\n  end select\n  x()\n"
    assert_eq(formatted(ended), ended)

@test("fmt: a `select` the formatter moves means what it meant: a shorter line before it, an item shifted in a list, one nested in another's arm")
fmt_select_moved()
    val earlier = "main()\n  val   a  =  1\n  select\n    c.receive() as Some(x) -> x\n  a\n"
    assert_eq(formatted(earlier), "main()\n  val a = 1\n  select\n    c.receive() as Some(x) -> x\n  a\n")
    val listed = "main()\n  val ts = [\n    f(() ->\n      select\n        a.receive() as Some(x) -> g(x)\n      g(1)),\n    f(() ->\n      select\n        a.receive() as Some(x) -> g(x)\n      g(2))]\n"
    assert_eq(formatted(listed), "main()\n  val ts = [\n    f(() ->\n      select\n        a.receive() as Some(x) -> g(x)\n      g(1)),\n      f(() ->\n        select\n          a.receive() as Some(x) -> g(x)\n        g(2))]\n")
    val nested = "main()\n    select\n        a.receive() as Some(x) ->\n            select\n                b.send(x) -> 1\n                else 2\n        after d -> 3\n"
    assert_eq(formatted(nested), "main()\n  select\n    a.receive() as Some(x) ->\n      select\n        b.send(x) -> 1\n        else 2\n    after d -> 3\n")

@test("fmt: in a literate file, prose between a signature and its clauses keeps its blank lines")
fmt_literate_clauses()
    val src = "# Title\n\n    f(n: int) -> int\n\n    f(0) = 1\n\nThe rest.\n\n    f(n) = n\n"
    assert_eq(formatted_as("doc.lavin", src), "# Title\n\n    f(n: int) -> int\n    f(0) = 1\n\nThe rest.\n\n    f(n) = n\n")

@test("fmt: the `yield` line closing a top-level `for` of generator lines belongs to it, with no blank line before it")
fmt_top_level_for_yield()
    val src = "val grid = for\n    row in 0 ..< 3\n    col in 0 ..< 2\nyield row * 2 + col\nmain() = println(grid)\n"
    assert_eq(formatted(src), "val grid = for\n  row in 0 ..< 3\n  col in 0 ..< 2\nyield row * 2 + col\n\nmain() = println(grid)\n")
    val single = "val pairs = for x in [1, 2] yield x\nmain() = println(pairs)\n"
    assert_eq(formatted(single), single)
    val inside = "main()\n    val grid = for\n        row in 0 ..< 3\n    yield row\n    println(grid)\n"
    assert_eq(formatted(inside), "main()\n  val grid = for\n    row in 0 ..< 3\n  yield row\n  println(grid)\n")

// ---- the width limit ----

@test("fmt: a call too long for the line takes one argument per line, two columns in")
fmt_breaks_a_long_call()
    val short = "longArgumentName"
    val other = "anotherQuiteLongArgumentTooLong"
    val src = s"main()\n    println(compute(${short}1, ${short}2, ${short}3, ${short}4), $other)\n"
    assert_eq(formatted(src), s"main()\n  println(\n    compute(${short}1, ${short}2, ${short}3, ${short}4),\n    $other\n  )\n")
    val arg = "aVeryLongArgumentNameNumber"
    val deeper = s"main()\n    println(compute(${arg}1, ${arg}2, ${arg}3, ${arg}4, ${arg}5))\n"
    assert_eq(formatted(deeper), s"main()\n  println(\n    compute(\n      ${arg}1,\n      ${arg}2,\n      ${arg}3,\n      ${arg}4,\n      ${arg}5\n    )\n  )\n")

@test("fmt: a parameter list too long for the line takes one parameter per line, four columns in")
fmt_breaks_a_long_parameter_list()
    val src = "combine(firstParameter: int, secondParameter: string, thirdParameter: Vector[int], fourth: bool, fifth: Option[string]) -> int\n    1\n"
    assert_eq(formatted(src), "combine(\n    firstParameter: int,\n    secondParameter: string,\n    thirdParameter: Vector[int],\n    fourth: bool,\n    fifth: Option[string]\n) -> int\n  1\n")

@test("fmt: a list written one item per line stays so, and one broken any other way is joined")
fmt_keeps_one_item_per_line()
    assert_eq(formatted("val xs = [\n    f(1),\n        2\n]\n"), "val xs = [\n  f(1),\n  2\n]\n")
    assert_eq(formatted("val xs = [1,\n          2]\n"), "val xs = [1, 2]\n")
    assert_eq(formatted("main()\n    f(a,\n      b)\n"), "main()\n  f(a, b)\n")

@test("fmt: a binding's value too long for the line, holding no list, breaks before its loosest operators")
fmt_breaks_a_long_value()
    val name = "someRatherLongOperandName"
    val src = s"main()\n    val total = ${name}1 * 2 + ${name}2 * 3 + ${name}3 * 4 + ${name}4 * 5 + ${name}5\n    println(total)\n"
    assert_eq(formatted(src), s"main()\n  val total = ${name}1 * 2\n    + ${name}2 * 3\n    + ${name}3 * 4\n    + ${name}4 * 5\n    + ${name}5\n  println(total)\n")

@test("fmt: a line with nothing that may be broken stays long")
fmt_leaves_an_unbreakable_line()
    val long = "x" + "y".repeat(130)
    assert_eq(formatted(s"val $long = 1\n"), s"val $long = 1\n")

// The text laid out afresh with its lines re-broken, which must not fall back to the source's breaks.
private reflowed(text: string) -> string = format_reflowed(source_of("probe.avin", text)) match
    Ok(t) -> t
    Err(why) -> panic(s"not reflowed: $why")

@test("fmt: a long one-line `if` is never broken in a test or a branch before its last, where a line would open the `if`'s block")
fmt_keeps_if_tests_whole()
    val name = "someRatherLongOperandName"
    // Operators only in the tests and the branches before the last: nothing may be broken.
    val tests = s"main()\n  val whole = if span > 0 && ${name}1 < ${name}2 then span - 1 elif span < 0 && ${name}3 > ${name}4 then span + 1 else span\n  println(whole)\n"
    assert_eq(reflowed(tests), tests)
    val branch = s"main()\n  val whole = if ready then ${name}1 * 2 + ${name}2 * 3 + ${name}3 * 4 + ${name}4 else span\n  println(whole)\n"
    assert_eq(reflowed(branch), branch)
    val chain = s"main()\n  val whole = if a == b then 1 elif ${name}1 + ${name}2 + ${name}3 > ${name}4 + 2 then 2 else 3\n  println(whole)\n"
    assert_eq(reflowed(chain), chain)
    // A `while` test and a statement `if` are headers with blocks and are left as they are.
    val header = s"main()\n  while ${name}1 > 0 && ${name}2 > 0 && ${name}3 > 0 && ${name}4 > 0\n    step()\n"
    assert_eq(reflowed(header), header)

@test("fmt: a long one-line `if` breaks only in its last branch, so operators before the `if` keep their line")
fmt_breaks_an_if_in_its_last_branch()
    val name = "someRatherLongOperandName"
    val last = s"main()\n  val x = if ready && done then first else ${name}1 * 2 + ${name}2 * 3 + ${name}3\n  println(x)\n"
    assert_eq(reflowed(last), s"main()\n  val x = if ready && done then first else ${name}1 * 2\n    + ${name}2 * 3\n    + ${name}3\n  println(x)\n")
    val nested = s"main()\n  val x = if a then b else if c && d then e else ${name}1 + ${name}2 + ${name}3 + ${name}4\n  println(x)\n"
    assert_eq(reflowed(nested), s"main()\n  val x = if a then b else if c && d then e else ${name}1\n    + ${name}2\n    + ${name}3\n    + ${name}4\n  println(x)\n")
    val after = s"main()\n  val y = ${name}1 * 2 + ${name}2 * 3 + ${name}3 * 4 + if a && b then 1 else 2\n  println(y)\n"
    assert_eq(reflowed(after), after)

@test("fmt: a comment inside brackets keeps the lines it is on")
fmt_comment_in_brackets()
    val src = "val xs = [1, // one\n           2]\n"
    assert_eq(formatted(src), "val xs = [1, // one\n  2]\n")

// ---- literals of short, simple items, filled ----

// The characters of `text`, the measure of a line's width.
private fmt_width_of(text: string) -> usize
    var n = 0usize
    for b in text.bytes
        if b < 0x80 || b >= 0xC0 then n += 1
    n

@test("fmt: a broken literal of numbers, characters, strings, booleans and names fills each line with as many items as fit")
fmt_packs_a_table_of_literals()
    val src = "val table = ['a', 'b', '\\n', \"one\", \"two\", \"three\", true, false, -1, +2, 3.5, -0.25, limit, 0xff, 1_000, 'z', \"four\", \"five\", \"six\", 42, 43]\n"
    assert_eq(formatted(src), "val table = [\n  'a', 'b', '\\n', \"one\", \"two\", \"three\", true, false, -1, +2, 3.5, -0.25, limit, 0xff, 1_000, 'z', \"four\", \"five\",\n  \"six\", 42, 43\n]\n")
    // A literal that fits on its line stays on it.
    assert_eq(formatted("val xs = [1,2,  3]\n"), "val xs = [1, 2, 3]\n")
    assert_eq(formatted("val xs = []\n"), "val xs = []\n")
    // Brackets after an operand hold type arguments or an index, and are no literal.
    val types = "val x = convert[FirstLongerTypeName, SecondLongerTypeName, ThirdLongerTypeName, FourthLongerTypeName, FifthLongerTypeName](value)\n"
    assert_eq(formatted(types), "val x = convert[\n  FirstLongerTypeName,\n  SecondLongerTypeName,\n  ThirdLongerTypeName,\n  FourthLongerTypeName,\n  FifthLongerTypeName\n](value)\n")

@test("fmt: a table written one item per line is filled, as a generated table of code points is")
fmt_packs_a_one_per_line_table()
    var src = "private val ranges: Array[int] = [\n"
    for i in 0..<40
        src = src + s"  0x${1000 + i},\n"
    src = src + "  0x9999\n]\n"
    var row1 = "  0x1000"
    for i in 1..<14
        row1 = row1 + s", 0x${1000 + i}"
    var row2 = "  0x1014"
    for i in 15..<28
        row2 = row2 + s", 0x${1000 + i}"
    var row3 = "  0x1028"
    for i in 29..<40
        row3 = row3 + s", 0x${1000 + i}"
    // Fourteen items of seven columns and their spaces take 111 of the 118 after the indentation,
    // and a fifteenth would take 119.
    assert_eq(fmt_width_of(row1 + ","), 113)
    assert_eq(formatted(src), s"private val ranges: Array[int] = [\n$row1,\n$row2,\n$row3, 0x9999\n]\n")
    // A short list the source broke stays broken, its items filled onto one line.
    assert_eq(formatted("val xs = [\n    1,\n        2\n]\n"), "val xs = [\n  1, 2\n]\n")

@test("fmt: a broken literal holding a call, or an item wider than 32 columns, keeps one item per line")
fmt_keeps_complex_items_one_per_line()
    val src = "val mixed = [first, second(1), third, fourth, fifth, sixth, seventh, eighth, ninth, tenth, eleventh, twelfth, thirteenth]\n"
    assert_eq(formatted(src), "val mixed = [\n  first,\n  second(1),\n  third,\n  fourth,\n  fifth,\n  sixth,\n  seventh,\n  eighth,\n  ninth,\n  tenth,\n  eleventh,\n  twelfth,\n  thirteenth\n]\n")
    val interpolated = "val lines = [s\"a$x\", \"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\", \"cccccccccccccccccccccccccccccccccccccccccccccccccccccc\"]\n"
    assert_eq(formatted(interpolated), "val lines = [\n  s\"a$x\",\n  \"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\n  \"cccccccccccccccccccccccccccccccccccccccccccccccccccccc\"\n]\n")
    val pairs = "val pairs = [(1000, 2000), (3000, 4000), (5000, 6000), (7000, 8000), (9000, 10000), (11000, 12000), (13000, 14000), (1, 2)]\n"
    assert_eq(formatted(pairs), "val pairs = [\n  (1000, 2000),\n  (3000, 4000),\n  (5000, 6000),\n  (7000, 8000),\n  (9000, 10000),\n  (11000, 12000),\n  (13000, 14000),\n  (1, 2)\n]\n")
    // Items of 32 columns are filled; one of 33 is not short.
    val v = "v".repeat(30)
    val fill = s"val xs = [${v}01, ${v}02, ${v}03, ${v}04, ${v}05]\n"
    assert_eq(formatted(fill), s"val xs = [\n  ${v}01, ${v}02, ${v}03,\n  ${v}04, ${v}05\n]\n")
    val wide = s"val xs = [${v}001, ${v}002, ${v}003, ${v}004]\n"
    assert_eq(formatted(wide), s"val xs = [\n  ${v}001,\n  ${v}002,\n  ${v}003,\n  ${v}004\n]\n")

@test("fmt: a call's arguments are never filled, however simple, and a map literal's entries take a line each, two columns in")
fmt_packs_only_sequence_and_set_literals()
    val call = "main()\n  compute(1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 11000, 12000, 13000, 14000, 15000, 16000, 17000, 18000)\n"
    assert_eq(formatted(call), "main()\n  compute(\n    1000,\n    2000,\n    3000,\n    4000,\n    5000,\n    6000,\n    7000,\n    8000,\n    9000,\n    10000,\n    11000,\n    12000,\n    13000,\n    14000,\n    15000,\n    16000,\n    17000,\n    18000\n  )\n")
    val set = "val set = {1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 11000, 12000, 13000, 14000, 15000, 16000, 17000, 18000}\n"
    assert_eq(formatted(set), "val set = {\n  1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 11000, 12000, 13000, 14000, 15000, 16000, 17000, 18000\n}\n")
    val map = "val map = {1000: 1, 2000: 2, 3000: 3, 4000: 4, 5000: 5, 6000: 6, 7000: 7, 8000: 8, 9000: 9, 10000: 10, 11000: 11, 12000: 12}\n"
    assert_eq(formatted(map), "val map = {\n  1000: 1,\n  2000: 2,\n  3000: 3,\n  4000: 4,\n  5000: 5,\n  6000: 6,\n  7000: 7,\n  8000: 8,\n  9000: 9,\n  10000: 10,\n  11000: 11,\n  12000: 12\n}\n")

@test("fmt: a filled literal keeps its trailing comma, and a comment among its items keeps its lines")
fmt_packing_trailing_comma_and_comments()
    assert_eq(formatted("val xs = [\n    1,\n    2,\n    3,\n]\n"), "val xs = [\n  1, 2, 3,\n]\n")
    val commented = "val xs = [\n    1, 2, // small\n    1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 11000, 12000, 13000, 14000, 15000, 16000, 17000\n]\n"
    assert_eq(formatted(commented), "val xs = [\n  1, 2, // small\n  1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 11000, 12000, 13000, 14000, 15000, 16000, 17000\n]\n")
    assert_eq(formatted("val xs = [\n    1,\n    2, // two\n    3\n]\n"), "val xs = [\n  1,\n  2, // two\n  3\n]\n")

@test("fmt: a literal of literals inside another is filled while the outer one takes a line an item")
fmt_packing_nested()
    val n = "1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 11000, 12000, 13000, 14000, 15000, 16000, 17000, 18000, 19000"
    val src = s"val nested = [[$n, 20000], [1, 2]]\n"
    // At four columns in, the items through 18000 fill the line to exactly 120 columns.
    val row = "1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 11000, 12000, 13000, 14000, 15000, 16000, 17000, 18000,"
    assert_eq(fmt_width_of(s"    $row"), 120)
    assert_eq(formatted(src), s"val nested = [\n  [\n    $row\n    19000, 20000\n  ],\n  [1, 2]\n]\n")
    val inCall = s"val x = compute(someArgument, [$n])\n"
    assert_eq(formatted(inCall), s"val x = compute(\n  someArgument,\n  [\n    $row\n    19000\n  ]\n)\n")

@test("fmt: a filled line takes exactly 120 columns, and an item that would make it 121 starts the next")
fmt_packing_width_boundary()
    val w = "a".repeat(26)
    val fits = s"val xs = [${w}01, ${w}02, ${w}03, ${w}0, z]\n"
    assert_eq(fmt_width_of(s"  ${w}01, ${w}02, ${w}03, ${w}0,"), 120)
    assert_eq(formatted(fits), s"val xs = [\n  ${w}01, ${w}02, ${w}03, ${w}0,\n  z\n]\n")
    val over = s"val xs = [${w}01, ${w}02, ${w}03, ${w}04, z]\n"
    assert_eq(formatted(over), s"val xs = [\n  ${w}01, ${w}02, ${w}03,\n  ${w}04, z\n]\n")
    // Deeper in, the indentation counts toward the width.
    val deeper = s"main()\n  val xs = [${w}01, ${w}02, ${w}03, ${w}0, z]\n  println(xs)\n"
    assert_eq(formatted(deeper), s"main()\n  val xs = [\n    ${w}01, ${w}02, ${w}03,\n    ${w}0, z\n  ]\n  println(xs)\n")

@test("fmt: a filled line is measured in characters, so strings of accented and CJK letters fill as ASCII ones do")
fmt_packing_unicode()
    val e = "é".repeat(26)
    val shorter = "é".repeat(25)
    val src = s"val xs = [\"$e\", \"$e\", \"$e\", \"$shorter\", \"日\"]\n"
    assert_eq(formatted(src), s"val xs = [\n  \"$e\", \"$e\", \"$e\", \"$shorter\",\n  \"日\"\n]\n")
    val cjk = "日本語".repeat(9)
    val over = s"val xs = [\"$cjk\", \"$cjk\", \"$cjk\", \"$cjk\", \"ü\"]\n"
    assert_eq(formatted(over), s"val xs = [\n  \"$cjk\", \"$cjk\", \"$cjk\",\n  \"$cjk\", \"ü\"\n]\n")

@test("fmt: in a literate file a filled literal's lines sit inside the four-column margin")
fmt_packing_literate()
    val w = "a".repeat(26)
    val src = s"# Table\n\n    val xs = [${w}01, ${w}02, ${w}03, ${w}04, z]\n"
    assert_eq(formatted_as("doc.lavin", src), s"# Table\n\n    val xs = [\n      ${w}01, ${w}02, ${w}03,\n      ${w}04, z\n    ]\n")

// ---- literate files and refusals ----

@test("fmt: in a literate file only the program is formatted, four columns in and two a level")
fmt_literate()
    val src = "# Title\n\nSome  prose,   kept.\n\n    main()\n            println(1+2)\n\nMore prose.\n\n    f() = 1\n"
    assert_eq(formatted_as("doc.lavin", src), "# Title\n\nSome  prose,   kept.\n\n    main()\n      println(1 + 2)\n\nMore prose.\n\n    f() = 1\n")

// The three quotes of a text block, spliced into the sources below.
private val Q = "\"\"\""

@test("fmt: a text block comes out byte for byte while the code around it is re-indented")
fmt_text_blocks()
    // Its lines keep their columns, its trailing blanks stay, and a `//` inside it is text.
    val block = s"$Q\n        one  \n          // two\n\n      three\\\n        $Q"
    assert_eq(formatted(s"main()\n    val t = $block\n    println( t )\n"), s"main()\n  val t = $block\n  println(t)\n")
    // Tokens after the closing delimiter, and a comment after them, stay on its line.
    val call = s"f(x: string) = x\nmain()\n    println(f( s$Q\n        a $$x\n        $Q )+\"!\") // done\n"
    assert_eq(formatted(call), s"f(x: string) = x\n\nmain()\n  println(f(s$Q\n        a $$x\n        $Q) + \"!\") // done\n")
    // A block inside brackets broken over lines, with the lines after it formatted as usual.
    val list = s"main()\n    val xs = [\n        $Q\n        a\n        $Q,\n        \"b\" ]\n    println( xs )\n"
    assert_eq(formatted(list), s"main()\n  val xs = [\n    $Q\n        a\n        $Q,\n    \"b\"]\n  println(xs)\n")

@test("fmt: a text block in a literate file keeps its lines")
fmt_literate_text_block()
    val src = s"# Title\n\n    main()\n            val t = $Q\n              x\n            $Q\n            println(t)\n"
    assert_eq(formatted_as("doc.lavin", src), s"# Title\n\n    main()\n      val t = $Q\n              x\n            $Q\n      println(t)\n")

@test("fmt: a file that does not parse is refused with its diagnostics")
fmt_refuses_a_broken_file()
    val why = format_text("broken.avin", "main(\n") match
        Ok(_) -> panic("formatted a broken file")
        Err(w) -> w
    assert(why.contains("broken.avin"))

// ---- `avin fmt` ----

private struct FmtRun
    status: int
    said: string
    noted: string

private fmt_avin(dir: string, args: []const string) -> FmtRun
    var said = ""
    var noted = ""
    val status = run_cli_with(args, Some(repository_toolchain()), s -> said = said + s + "\n", s -> noted = noted + s + "\n", Stdio.ToPath(dir + "/run.out"), Stdio.ToPath(dir + "/run.err"))
    FmtRun(status, said, noted)

@test("fmt: `avin fmt --check` lists the files not formatted and fails; `avin fmt` rewrites them")
fmt_command_checks_and_rewrites()
    val dir = make_temp_dir("avin-fmt").unwrap()
    defer _ = remove_dir_all(dir)
    write_text(dir + "/a.avin", "main()\n    println(1+2)\n").unwrap()
    write_text(dir + "/b.avin", "f() = 1\n").unwrap()
    write_text(dir + "/.hidden.avin", "f( ) = 1\n").unwrap()
    val checked = fmt_avin(dir, ["avin", "fmt", "--check", dir])
    assert_eq(checked.status, 1)
    assert_eq(checked.said, dir + "/a.avin\n")
    assert(checked.noted.contains("1 file is not formatted"))
    val rewritten = fmt_avin(dir, ["avin", "fmt", dir])
    assert_eq(rewritten.status, 0)
    assert_eq(read_text(dir + "/a.avin").unwrap(), "main()\n  println(1 + 2)\n")
    assert_eq(read_text(dir + "/.hidden.avin").unwrap(), "f( ) = 1\n")
    assert_eq(fmt_avin(dir, ["avin", "fmt", "--check", dir + "/a.avin", dir + "/b.avin"]).status, 0)

@test("fmt: `avin fmt` fails on a file that does not parse and on a path that does not exist")
fmt_command_failures()
    val dir = make_temp_dir("avin-fmt").unwrap()
    defer _ = remove_dir_all(dir)
    write_text(dir + "/bad.avin", "main(\n").unwrap()
    val bad = fmt_avin(dir, ["avin", "fmt", dir + "/bad.avin"])
    assert_eq(bad.status, 1)
    assert(bad.noted.contains("bad.avin"))
    assert_eq(read_text(dir + "/bad.avin").unwrap(), "main(\n")
    assert_eq(fmt_avin(dir, ["avin", "fmt", dir + "/missing.avin"]).status, 1)
    assert_eq(fmt_avin(dir, ["avin", "fmt", "--wrong"]).status, 2)

// ---- the repository ----

private fmt_sources(dir: string, out: *Buf[string])
    for name in entries(dir).unwrap_or(buf())
        if name.starts_with(".") then continue
        val full = dir + "/" + name
        if is_dir(full) then fmt_sources(full, out)
        elif is_source_name(name) then out.push(full)

@test("fmt: every source file of the tests and the library that parses formats to the same program, once and for all")
fmt_repository_sources()
    val tc = repository_toolchain()
    var files: Buf[string] = buf()
    fmt_sources(tc.root + "/tests", &files)
    fmt_sources(tc.root + "/library", &files)
    var parsed = 0
    var already = 0
    for file in files
        val text = read_text(file).unwrap()
        val doc = source_of(file, text)
        if parse(doc).report.has_errors() then continue
        parsed += 1
        // Re-breaking lines must keep the meaning by itself, without falling back to the source's
        // line breaks.
        val once = format_reflowed(doc) match
            Ok(t) -> t
            Err(why) -> panic(why)
        if once == text then already += 1
        val twice = format_text(file, once).unwrap()
        if twice != once then panic(s"$file: formatting is not stable")
    print(s"fmt: $parsed of ${files.len()} source files parse; $already are formatted already")
    assert(parsed > 700)
