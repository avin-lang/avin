module dev.avinlang.compiler

import sh.sysl.parsing.{Source, Span, error, report}
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.fs.{exists, make_dir_all, make_temp_dir, pending_name, publish_file, read_bytes, remove_dir_all, remove_file, write_text}
import sysl.process.capture
import sysl.text.{StrBuilder, str_builder}

// The C unit. Every program with C bindings is built with one generated C file, compiled by clang
// with the include flags of the program's C libraries. For each binding it holds a `_Static_assert`
// that the function the headers declare has exactly the type the prototype says, and a declaration
// of the function as the prototype says it, whose conflict with the header's names the header; for
// each typedef a prototype names, a `_Static_assert` that it is the kind of type its Avin type needs;
// and one table of constant bytes measuring each integer type a prototype names, its width and sign,
// and each typedef in a `real` position, its width. The driver reads the table out of the object
// file's bytes, so nothing is run and a build for another machine measures that machine. A clang
// diagnostic is placed back at the binding by the line the unit gave it.
//
// The object is cached under `cunit/` in the user's cache, by a key over the unit's source, what
// `pkg-config` answers for the libraries, and `clang --version`.

/** A C binding as the C unit checks it: its name, its prototype, the Avin types of its parameters and
 * result, the unit and span that place it, the package it belongs to, "" for a program with no
 * manifest, how each position carries a string (the result first, then the parameters), and the
 * function its `free:` names. */
struct CUnitBinding
    name: string
    prototype: CPrototype
    params: Buf[&Type]
    result: &Type
    unit: usize
    span: Span
    package: string
    forms: Buf[CTextForm]
    free: Option[string]
    /** The packages of the handle classes it takes or answers, whose headers come before its own. */
    uses: Buf[string]

/** A handle class as the C unit compiles its glue: its name and index, which name its glue
 * functions, the C type it is on as `parse_c_type` reads it and whether that is a typedef, whose
 * kind is checked, its `release:` and `retain:`, what its `kept:` names, the unit and span that place
 * it, and its package. */
struct CUnitHandle
    name: string
    index: usize
    ty: string
    typedef: bool
    release: string
    retain: Option[string]
    kept: Option[CUnitKept]
    unit: usize
    span: Span
    package: string
    /** The other C types it is passed as, and how each is made. */
    conversions: Buf[CAs]
    /** Its field accessors. */
    fields: Buf[CUnitField]

/** A field accessor as the C unit compiles its glue: the method's name, the index of its symbol, which
 * names its glue, the field, the names of its indices and the bound of each, whether it writes the
 * field, the kind of C type the field must be for the Avin type it reads or writes, or for a handle
 * read the handle's class, that Avin type, and the unit and span that place the accessor. */
struct CUnitField
    name: string
    symbol: usize
    expr: string
    indices: Buf[string]
    bounds: Buf[string]
    writer: bool
    kind: Option[CKind]
    handle: Option[usize]
    avin: &Type
    unit: usize
    span: Span

/** The handle a class's `kept:` names: the name `release:` gives its pointer, the kept class's index
 * and its C type. */
struct CUnitKept
    name: string
    index: usize
    ty: string

/** What building a program's C unit gave: the object, when the program has C bindings; whether this
 * build compiled it rather than finding it cached; what it measured, by `c_measure_key`; and the
 * flags that link the program's C libraries. */
struct CUnit
    object: Option[string]
    built: bool
    measures: Map[string, CMeasure]
    link: Buf[string]

/** The name the C unit is written under, which clang's diagnostics name. */
const CUnitFile: string = "avin-c-unit.c"

/** What the measurement table begins with, which finds it among the object's bytes. */
const MeasureMarker: string = "avin.c-unit.measurements:"

/** The C bindings of a checked program, in the order of their symbols. `files` are the program's own
 * files, the units from `library` on. */
c_unit_bindings(program: TProgram, files: Buf[ProgramFile], library: usize) -> Buf[CUnitBinding]
    var out: Buf[CUnitBinding] = buf()
    for s in program.symbols
        if s.root is Some(_) || s.receiver is Some(_) then continue
        // A method is a binding only on a C handle, and its receiver, the first of its parameters,
        // is the prototype's first.
        if s.owner_class is Some(k)
            if c_handle_type(program.classes[k].decl) is None || s.constructor then continue
        val p = c_prototype_of(s.decl) match
            Some(p) -> p
            None -> continue
        val params = s.params
        val package = package_of(s.unit, files, library)
        // A status is measured as the integer its code is.
        var result = s.result.unwrap_or(Unit)
        if c_status_error(result, program.data) is Some(e) then result = e
        var forms: Buf[CTextForm] = buf()
        forms.push(c_text_form(result, program.data, program.classes))
        for t in params
            forms.push(c_text_form(t, program.data, program.classes))
        var uses: Buf[string] = buf()
        var positions: Buf[&Type] = buf()
        positions.push(s.result.unwrap_or(Unit))
        for t in params
            positions.push(t)
        for t in positions
            if c_handle_form(t, program.data, program.classes) is Some(h)
                val used = package_of(program.classes[h.class_index].unit, files, library)
                if used != package && !contains_text(uses, used) then uses.push(used)
        out.push(CUnitBinding(s.name, p, params, result, s.unit, s.decl.name_span, package, forms, c_free_text(s.decl), uses))
    out

private package_of(unit: usize, files: Buf[ProgramFile], library: usize) -> string = if unit >= library && unit - library < files.len() then files[unit - library].package else ""

/** The handle classes of a checked program, whose glue the C unit compiles, in the order of the
 * program's classes. */
c_unit_handles(program: TProgram, files: Buf[ProgramFile], library: usize) -> Buf[CUnitHandle]
    var out: Buf[CUnitHandle] = buf()
    for k in 0..<program.classes.len()
        val d = program.classes[k].decl
        val written = c_handle_type(d) match
            Some(t) -> t
            None -> continue
        val ty = parse_c_type(written) match
            Ok(t) -> t
            Err(_) -> continue
        var kept: Option[CUnitKept] = None
        if c_class_kept(d) is Some(name)
            if c_kept_class(program.classes, k) is Some(j)
                val kd = program.classes[j].decl
                if c_handle_type(kd) is Some(kt) && c_class_text(kd, "retain") is Some(_) && c_class_kept(kd) is None
                    kept = Some(CUnitKept(name.name, j, kt))
        out.push(CUnitHandle(program.classes[k].name, k, ty.text, ty.ty is CTypedef(_), c_class_text(d, "release").unwrap_or(""), c_class_text(d, "retain"), kept, program.classes[k].unit, d.name_span, package_of(program.classes[k].unit, files, library), c_class_as(d), c_unit_fields(program, k)))
    out

// The kind of C type a field read or written as the scalar `avin` is.
private c_field_kind(avin: &Type) -> Option[CKind] = *avin match
    Int(_) -> Some(KindInteger)
    Byte -> Some(KindByte)
    Bool -> Some(KindBool)
    Real -> Some(KindReal)
    _ -> None

// The field accessors of the handle class `k`, in the order of the program's symbols.
private c_unit_fields(program: TProgram, k: usize) -> Buf[CUnitField]
    var out: Buf[CUnitField] = buf()
    for n in 0..<program.symbols.len()
        val s = program.symbols[n]
        if s.root is Some(_) || s.receiver is Some(_) || s.constructor || s.owner_class != Some(k) then continue
        val field = c_field_of(s.decl) match
            Some(f) -> f
            None -> continue
        // The receiver is the first parameter; the value written, for a writer, the last.
        val result = s.result.unwrap_or(Unit)
        val writer = *result is Unit
        if s.params.len() < 1 || writer && s.params.len() < 2 then continue
        val last = if writer then s.params.len() - 1 else s.params.len()
        var indices: Buf[string] = buf()
        for i in 1..<last
            val name = s.decl.params[i - 1].pattern.kind match
                Name(name) -> name
                _ -> "_"
            indices.push(name)
        val avin = if writer then s.params[last] else result
        var kind: Option[CKind] = None
        var handle: Option[usize] = None
        if c_handle_form(avin, program.data, program.classes) is Some(h) then handle = Some(h.class_index)
        elif !(c_text_form(avin, program.data, program.classes) is NoText) then kind = Some(KindText)
        else kind = c_field_kind(avin)
        if kind is None && handle is None then continue
        out.push(CUnitField(s.name, n, field.expr, indices, field.bounds, writer, kind, handle, avin, s.unit, s.decl.name_span))
    out

/** The C unit of a program whose C bindings are `bindings` and whose packages name `libraries`. Each
 * library's `pkg-config` module is asked for its flags; with no bindings there is no unit, and only
 * the link flags are answered. A binding the headers do not declare as its prototype says, or whose
 * package names no header, is reported at the binding, rendered with `sources`. */
ensure_c_unit(tc: Toolchain, bindings: Buf[CUnitBinding], handles: Buf[CUnitHandle], libraries: Buf[CLibrary], sources: Buf[Source]) -> Result[CUnit, string]
    if bindings.len() == 0 && handles.len() == 0 && libraries.len() == 0 then return Ok(CUnit(None, false, map(), buf()))
    // A binding is checked against a header, always, and a handle's glue compiled against one.
    var refused = ""
    for b in bindings
        var headers = 0usize
        for library in libraries
            if library.package == b.package then headers += library.headers.len()
        if headers > 0 then continue
        val why = if b.package == "" then s"the C binding `${b.name}` is checked against the headers a package's manifest names under `c-libraries`, and this program has no avin.hocon" else s"the C binding `${b.name}` has no header to be checked against: name the one that declares `${b.prototype.symbol}` in a `headers` list of the `c-libraries` of package `${b.package}`"
        var r = report()
        r.add(error(b.span, why))
        refused = refused + r.render(sources[b.unit])
    for h in handles
        var headers = 0usize
        for library in libraries
            if library.package == h.package then headers += library.headers.len()
        if headers > 0 then continue
        val why = if h.package == "" then s"the C handle `${h.name}` is compiled against the headers a package's manifest names under `c-libraries`, and this program has no avin.hocon" else s"the C handle `${h.name}` has no header to be compiled against: name the one that declares `${h.ty}` in a `headers` list of the `c-libraries` of package `${h.package}`"
        var r = report()
        r.add(error(h.span, why))
        refused = refused + r.render(sources[h.unit])
    if refused != "" then return Err(refused)
    var cflags: Buf[string] = buf()
    var link: Buf[string] = buf()
    var answered = ""
    for library in libraries
        library.pkg_config match
            Some(m) ->
                val c = ask_pkg_config(tc, library, m, "--cflags")?
                val l = ask_pkg_config(tc, library, m, "--libs")?
                answered = answered + m + "\n" + c + "\n" + l + "\n"
                for flag in c.fields()
                    add_flag(&cflags, flag)
                for flag in l.fields()
                    add_flag(&link, flag)
            None ->
                for name in library.link
                    add_flag(&link, "-l" + name)
    if bindings.len() == 0 && handles.len() == 0 then return Ok(CUnit(None, false, map(), link))
    val unit = c_unit_source(bindings, handles, libraries)
    val version = capture(tc.clang, ["--version"], timeout = 60000) match
        Ok(r) -> r.text
        Err(e) -> return Err("avin: " + missing_tool(tc.clang, e.to_string()) + "\n")
    var flags_text = ""
    for f in cflags
        flags_text = flags_text + f + "\n"
    val object = tc.c_unit_cache() + "/" + content_key(unit.text + "\n" + flags_text + answered + version) + ".o"
    var built = false
    if !exists(object)
        compile_c_unit(tc, unit, cflags, object, bindings, handles, libraries, sources)?
        built = true
    val bytes = read_bytes(object).map_err(e -> s"avin: $object: ${e.to_string()}\n")?
    val measures = read_measures(bytes, unit.measured) match
        Some(m) -> m
        None -> return Err(s"avin: the C unit $object holds no measurements\n")
    Ok(CUnit(Some(object), built, measures, link))

private add_flag(flags: *Buf[string], flag: string)
    for f in *flags
        if f == flag then return
    flags.push(flag)

// What `pkg-config <question> <module>` prints, or the error a build that cannot find the library
// gives, with what the manifest says to do.
private ask_pkg_config(tc: Toolchain, library: CLibrary, module_name: string, question: string) -> Result[string, string]
    val tail = if library.install == "" then "" else " " + library.install
    val asked = s"`pkg-config $question $module_name`"
    val result = capture(tc.pkg_config, [question, module_name], stderr = true, timeout = 60000) match
        Ok(r) -> r
        Err(e) -> return Err(s"error: the C library `${library.label}` of package `${library.package}` was not found: $asked could not run (${e.to_string()}).$tail\n")
    if !result.status.ok() then return Err(s"error: the C library `${library.label}` of package `${library.package}` was not found: $asked failed.$tail\n")
    Ok(result.text.trim())

/** What one line of the C unit is for, which places a diagnostic clang gives at it. */
enum CUnitLine
    /** Nothing a diagnostic is placed by. */
    Plain
    /** The `#include` of a header of `libraries[library]`. */
    IncludeLine(library: usize, header: string)
    /** The header check of `bindings[binding]`. */
    AssertLine(binding: usize)
    /** A pointer of the prototype's type set to the header's function, whose diagnostic writes both
     * types with their typedefs' names. */
    PointerLine(binding: usize)
    /** The declaration of `bindings[binding]`'s function as its prototype says it. */
    DeclareLine(binding: usize)
    /** The check that the typedef `name`, parameter `position` of `bindings[binding]` (0 for the
     * result), is the kind `kind` needs. */
    KindLine(binding: usize, position: usize, name: string, kind: CKind)
    /** The check that `free`, which `bindings[binding]`'s `free:` names, frees a string. */
    FreeLine(binding: usize, free: string)
    /** A line of the glue of `handles[handle]` compiling what its `@c` says under `part`: `type`,
     * `release`, `retain` or `kept`. */
    GlueLine(handle: usize, part: string)
    /** A line of the glue of `handles[handle]`'s `as:` conversion `entry`. */
    AsLine(handle: usize, entry: usize)
    /** A line of the glue of the field accessor `handles[handle].fields[field]`: `field` reads its
     * field and names its type, `kind` checks that type, `bound` with the index's position compiles
     * its bound, and `write` writes the field. */
    FieldLine(handle: usize, field: usize, part: string)

/** A C unit's text, what each of its lines is for, counting from 1, and the measurement keys of its
 * table, in order. */
struct CUnitSource
    text: string
    lines: Buf[CUnitLine]
    measured: Buf[string]

/** The C unit for `bindings` and the glue of `handles`, including every header of `libraries`, in
 * `header_order`, so a binding naming another package's handle is checked with that package's
 * headers before its own. Each package's headers keep their order, and a header that is a C
 * identifier is a macro an earlier header defines, included as `#include NAME`. */
c_unit_source(bindings: Buf[CUnitBinding], handles: Buf[CUnitHandle], libraries: Buf[CLibrary]) -> CUnitSource
    var out = str_builder()
    var lines: Buf[CUnitLine] = buf()
    // Line 0 does not exist; lines count from 1.
    lines.push(Plain)
    out.push("/* The C unit of an Avin program: written by the compiler. */\n")
    lines.push(Plain)
    out.push("#include <stdbool.h>\n")
    lines.push(Plain)
    if handles.len() > 0
        out.push("#include <stdlib.h>\n")
        lines.push(Plain)
    var included: Buf[string] = buf()
    for package in header_order(bindings, libraries)
        for i in 0..<libraries.len()
            if libraries[i].package != package then continue
            for h in libraries[i].headers
                if contains_text(included, h) then continue
                included.push(h)
                val spelled = if h.starts_with("<") || h.starts_with("\"") || is_c_identifier(h) then h else "<" + h + ">"
                out.push("#include " + spelled + "\n")
                lines.push(IncludeLine(i, h))
    if handles.len() > 0 then handle_glue(&out, &lines, handles)
    var kinds: Buf[string] = buf()
    var measured: Buf[string] = buf()
    var measured_types: Buf[string] = buf()
    // The type of each field read or written as an integer, a truth value or a `real` is measured.
    for h in handles
        for f in h.fields
            val kind = f.kind match
                Some(kind) -> kind
                None -> continue
            if !c_kind_measured(kind) then continue
            val name = c_field_type_name(f.symbol)
            measured.push(c_measure_key(CTypedef(name), kind))
            measured_types.push(name)
    for i in 0..<bindings.len()
        val b = bindings[i]
        val p = b.prototype
        var params = ""
        for k in 0..<p.params.len()
            params = params + (if k > 0 then ", " else "") + p.params[k].text
        if params == "" then params = "void"
        out.push(s"_Static_assert(__builtin_types_compatible_p(__typeof__(&${p.symbol}), ${p.result_text} (*)($params)), \"avin: the C binding ${b.name}\");\n")
        lines.push(AssertLine(i))
        out.push(s"static ${p.result_text} (*const avin_c_binding_$i)($params) = &${p.symbol};\n")
        lines.push(PointerLine(i))
        out.push(s"${p.result_text} ${p.symbol}($params);\n")
        lines.push(DeclareLine(i))
        // The function `free:` names takes the string C answered, or any pointer, and answers nothing.
        if b.free is Some(f)
            val fp = s"__typeof__(&$f)"
            var takes = ""
            for arg in ["void *", "char *", "const char *", p.result_text]
                takes = takes + (if takes == "" then "" else " || ") + s"__builtin_types_compatible_p($fp, void (*)($arg))"
            out.push(s"_Static_assert($takes, \"avin: the free function $f\");\n")
            lines.push(FreeLine(i, f))
        // Each named type at each position: the result first, then the parameters.
        for k in 0..<p.params.len() + 1
            val c = if k == 0 then p.result else p.params[k - 1].ty
            val avin = if k == 0 then b.result else b.params[k - 1]
            val kind = c_kind_needed(c, avin, b.forms[k], k == 0) match
                Some(kind) -> kind
                None -> continue
            val spelled = c_spelling(c)
            if c is CTypedef(name)
                val tag = kind_tag(kind) + " " + name
                if !contains_text(kinds, tag)
                    kinds.push(tag)
                    out.push(s"_Static_assert(${kind_test(kind, name)}, \"avin: the C type $name\");\n")
                    lines.push(KindLine(i, k, name, kind))
            if !c_kind_measured(kind) then continue
            val key = c_measure_key(c, kind)
            if !contains_text(measured, key)
                measured.push(key)
                measured_types.push(spelled)
    // The measurements: the marker, the count, then two bytes for each measured type.
    out.push("__attribute__((used)) const unsigned char avin_c_unit_measurements[] = {\n")
    lines.push(Plain)
    var marker = "   "
    for byte in MeasureMarker.bytes
        marker = marker + s" $byte,"
    out.push(marker + "\n")
    lines.push(Plain)
    out.push(s"    ${measured.len() % 256}, ${measured.len() / 256},\n")
    lines.push(Plain)
    for j in 0..<measured.len()
        val t = measured_types[j]
        if measured[j].starts_with("real ") then out.push(s"    (unsigned char)sizeof($t), 0,\n")
        else out.push(s"    (unsigned char)sizeof($t), (unsigned char)(($t)-1 < ($t)0),\n")
        lines.push(Plain)
    out.push("};\n")
    lines.push(Plain)
    CUnitSource(out.finish(), lines, measured)

// The glue of the handle classes. A handle's object is four words: its C pointer, null once given
// back; its owner; the C references it holds to what it keeps, a list off the heap; and the Avin
// objects it keeps, which the collector traces. For each class `i` the unit defines
// `avin_c_give_back_i`, which gives the object's reference back through `release:` and then each C
// reference it holds, in the order they were taken, and `avin_c_finalize_i`, the collector's
// finalizer of its objects, which does the same; with `retain:`, `avin_c_retain_i`, which takes a
// reference to a pointer C lent; and for a class whose handles another keeps by a C reference (one
// with `retain:` and no `kept:`), `avin_c_keep_i`, which takes one for a holder, `avin_c_take_i` and
// `avin_c_drop_i`, which take and give back one. A holder keeping a handle by a C reference also
// takes one to everything that handle so holds, after it, so what the kept object needs outlives it
// whichever finalizer runs first: a face's library outlives the face, though the face's own handle
// is gone. A name `kept:` gives is the pointer of the one handle of its class the object holds a
// reference to.
private handle_glue(out: *StrBuilder, lines: *Buf[CUnitLine], handles: Buf[CUnitHandle])
    glue(out, lines, "struct avin_c_kept { void *pointer; void (*take)(void *); void (*drop)(void *); struct avin_c_kept *next; };", Plain)
    glue(out, lines, "static void avin_c_hold(void **o, void *p, void (*take)(void *), void (*drop)(void *)) { struct avin_c_kept *k = malloc(sizeof *k); struct avin_c_kept **at = (struct avin_c_kept **)&o[2]; if (!k) abort(); k->pointer = p; k->take = take; k->drop = drop; k->next = 0; while (*at) at = &(*at)->next; *at = k; }", Plain)
    glue(out, lines, "static void avin_c_hold_all(void **o, void **kept) { for (struct avin_c_kept *k = kept[2]; k; k = k->next) { k->take(k->pointer); avin_c_hold(o, k->pointer, k->take, k->drop); } }", Plain)
    glue(out, lines, "static void *avin_c_held(void **o, void (*drop)(void *)) { for (struct avin_c_kept *k = o[2]; k; k = k->next) if (k->drop == drop) return k->pointer; return 0; }", Plain)
    glue(out, lines, "static void avin_c_drain(void **o) { struct avin_c_kept *k = o[2]; o[2] = 0; while (k) { struct avin_c_kept *next = k->next; k->drop(k->pointer); free(k); k = next; } }", Plain)
    for h in handles
        if kept_by_reference(h) then glue(out, lines, s"void avin_c_drop_${h.index}(void *p);", Plain)
    // Each type is checked first, by a name of the unit's own, which only the check uses: a
    // diagnostic of the glue names the types as the headers do.
    for i in 0..<handles.len()
        val h = handles[i]
        glue(out, lines, s"typedef ${h.ty} avin_c_type_${h.index};", GlueLine(i, "type"))
        if h.typedef then glue(out, lines, s"_Static_assert(__builtin_classify_type(*(avin_c_type_${h.index} *)0) == 5, \"avin: the C handle ${h.name}\");", GlueLine(i, "pointer"))
    for i in 0..<handles.len()
        val h = handles[i]
        val n = h.index
        val t = h.ty
        val release = c_call_text(h.release)
        if h.retain is Some(r)
            glue(out, lines, s"void avin_c_retain_$n(void *p, void *k) {", Plain)
            glue(out, lines, s"    $t self = ($t)p;", Plain)
            if h.kept is Some(k) then glue(out, lines, s"    ${k.ty} ${k.name} = (${k.ty})k;", GlueLine(i, "kept"))
            glue(out, lines, s"    (void)(${c_call_text(r)});", GlueLine(i, "retain"))
            glue(out, lines, "}", Plain)
        if kept_by_reference(h)
            glue(out, lines, s"void avin_c_drop_$n(void *p) {", Plain)
            glue(out, lines, s"    $t self = ($t)p;", Plain)
            glue(out, lines, s"    (void)($release);", GlueLine(i, "release"))
            glue(out, lines, "}", Plain)
            glue(out, lines, s"void avin_c_take_$n(void *p) { avin_c_retain_$n(p, 0); }", Plain)
            glue(out, lines, s"void avin_c_keep_$n(void **o, void *p, void **kept) { avin_c_take_$n(p); avin_c_hold(o, p, avin_c_take_$n, avin_c_drop_$n); avin_c_hold_all(o, kept); }", Plain)
        glue(out, lines, s"void avin_c_give_back_$n(void **o) {", Plain)
        glue(out, lines, "    if (o[0]) {", Plain)
        glue(out, lines, s"        $t self = ($t)o[0];", Plain)
        if h.kept is Some(k) then glue(out, lines, s"        ${k.ty} ${k.name} = (${k.ty})avin_c_held(o, avin_c_drop_${k.index});", GlueLine(i, "kept"))
        glue(out, lines, "        o[0] = 0;", Plain)
        glue(out, lines, s"        (void)($release);", GlueLine(i, "release"))
        glue(out, lines, "    }", Plain)
        glue(out, lines, "    avin_c_drain(o);", Plain)
        glue(out, lines, "}", Plain)
        glue(out, lines, s"void avin_c_finalize_$n(void *o, void *heap) { (void)heap; avin_c_give_back_$n((void **)o); }", Plain)
    // Each `as:` conversion, `avin_c_as_<class>_<entry>`, makes the other pointer from the handle's,
    // and passes null on as null; its type is checked to be the one the entry names.
    for i in 0..<handles.len()
        val h = handles[i]
        val n = h.index
        for j in 0..<h.conversions.len()
            val entry = h.conversions[j]
            val made = c_call_text(entry.expr)
            glue(out, lines, s"typedef ${entry.ty} avin_c_as_type_${n}_$j;", AsLine(i, j))
            glue(out, lines, s"void *avin_c_as_${n}_$j(void *avin_p) {", Plain)
            glue(out, lines, "    if (!avin_p) return 0;", Plain)
            glue(out, lines, s"    avin_c_type_$n self = (avin_c_type_$n)avin_p;", Plain)
            glue(out, lines, s"    _Static_assert(__builtin_types_compatible_p(__typeof__($made), avin_c_as_type_${n}_$j), \"avin: the conversion of ${h.name} to ${entry.ty}\");", AsLine(i, j))
            glue(out, lines, s"    return (void *)($made);", AsLine(i, j))
            glue(out, lines, "}", Plain)
    // Each field accessor names its field's type, `avin_c_field_type_<symbol>`, checks it is the kind
    // its Avin type needs, and reads or writes the field through `avin_c_field_get_<symbol>` or
    // `avin_c_field_set_<symbol>`, taking each index as a `long long`, whose bounds are answered by
    // `avin_c_field_bound<position>_<symbol>`.
    for i in 0..<handles.len()
        val h = handles[i]
        for j in 0..<h.fields.len()
            val f = h.fields[j]
            val t = s"avin_c_type_${h.index}"
            val ft = c_field_type_name(f.symbol)
            var indices = ""
            for name in f.indices
                indices = indices + s", long long $name"
            // The type is the field's at any index: an unevaluated operand reads no memory.
            glue(out, lines, s"typedef __typeof__((($t)0)->${c_replace_names(f.expr, f.indices, "0")}) $ft;", FieldLine(i, j, "field"))
            val test = f.handle match
                Some(k) -> s"__builtin_types_compatible_p($ft, avin_c_type_$k)"
                None -> kind_test(f.kind.unwrap(), ft)
            glue(out, lines, s"_Static_assert($test, \"avin: the field ${f.name}\");", FieldLine(i, j, "kind"))
            for b in 0..<f.bounds.len()
                val part = "bound" + b.to_string()
                val bound = c_field_glue(f.symbol, part)
                glue(out, lines, s"long long $bound(void *avin_p$indices) {", Plain)
                glue(out, lines, s"    $t self = ($t)avin_p;", Plain)
                glue(out, lines, s"    return (long long)(${f.bounds[b]});", FieldLine(i, j, part))
                glue(out, lines, "}", Plain)
            if f.writer
                val set = c_field_glue(f.symbol, "set")
                glue(out, lines, s"void $set(void *avin_p$indices, $ft avin_value) {", Plain)
                glue(out, lines, s"    $t self = ($t)avin_p;", Plain)
                glue(out, lines, s"    self->${f.expr} = avin_value;", FieldLine(i, j, "write"))
                glue(out, lines, "}", Plain)
            else
                val get = c_field_glue(f.symbol, "get")
                glue(out, lines, s"$ft $get(void *avin_p$indices) {", Plain)
                glue(out, lines, s"    $t self = ($t)avin_p;", Plain)
                glue(out, lines, s"    return self->${f.expr};", FieldLine(i, j, "field"))
                glue(out, lines, "}", Plain)

/** The packages of `libraries` in the order their headers are included: each after every package
 * whose handle classes its bindings name, and otherwise in the order the libraries are listed. A
 * cycle, which dependencies cannot make, leaves the rest in that order. */
header_order(bindings: Buf[CUnitBinding], libraries: Buf[CLibrary]) -> Buf[string]
    var listed: Buf[string] = buf()
    for library in libraries
        if !contains_text(listed, library.package) then listed.push(library.package)
    var placed: Buf[string] = buf()
    while placed.len() < listed.len()
        var next: Option[string] = None
        for p in listed
            if contains_text(placed, p) then continue
            var ready = true
            for b in bindings
                if b.package != p then continue
                for used in b.uses
                    if contains_text(listed, used) && !contains_text(placed, used) then ready = false
            if ready
                next = Some(p)
                break
        next match
            Some(p) -> placed.push(p)
            None ->
                for p in listed
                    if !contains_text(placed, p) then placed.push(p)
    placed

private glue(out: *StrBuilder, lines: *Buf[CUnitLine], text: string, line: CUnitLine)
    out.push(text + "\n")
    lines.push(line)

/** Whether a holder keeps a handle of `h`'s class by a C reference of its own: the class declares
 * `retain:`, and no `kept:`, whose names only its own object holds. */
kept_by_reference(h: CUnitHandle) -> bool = h.retain is Some(_) && h.kept is None

// A `release:` or `retain:` as the C expression it compiles to: a function's name is called with the
// handle's pointer.
private c_call_text(text: string) -> string = if is_c_identifier(text.trim()) then text.trim() + "(self)" else text

private c_spelling(c: CType) -> string = c match
    CKeyword(n) -> n
    CTypedef(n) -> n
    _ -> ""

private kind_tag(kind: CKind) -> string = kind match
    KindInteger -> "integer"
    KindByte -> "byte"
    KindBool -> "bool"
    KindReal -> "real"
    KindText -> "text"
    KindConstText -> "const text"

// The constant expression that holds where the typedef `name` is the kind `kind` asks for, by the
// class of type clang gives it: 1 an integer or enumeration, 4 a bool, 8 a floating-point type; a
// string is one of the two pointers to `char`.
private kind_test(kind: CKind, name: string) -> string
    val class = s"__builtin_classify_type(*($name *)0)"
    val constant = s"__builtin_types_compatible_p($name, const char *)"
    kind match
        KindInteger -> s"$class == 1"
        KindByte -> s"$class == 1 && sizeof($name) == 1"
        KindBool -> s"$class == 4 || $class == 1"
        KindReal -> s"$class == 8"
        KindText -> s"__builtin_types_compatible_p($name, char *) || $constant"
        KindConstText -> constant

private contains_text(xs: Buf[string], x: string) -> bool
    for y in xs
        if y == x then return true
    false

// Compiles the C unit into `object`, published by rename, or renders why it did not compile.
private compile_c_unit(tc: Toolchain, unit: CUnitSource, cflags: Buf[string], object: string, bindings: Buf[CUnitBinding], handles: Buf[CUnitHandle], libraries: Buf[CLibrary], sources: Buf[Source]) -> Result[unit, string]
    make_dir_all(tc.c_unit_cache()).map_err(e -> s"avin: ${tc.c_unit_cache()}: ${e.to_string()}\n")?
    val dir = make_temp_dir("avin-c-unit").map_err(e -> s"avin: ${e.to_string()}\n")?
    defer _ = remove_dir_all(dir)
    val file = dir + "/" + CUnitFile
    write_text(file, unit.text).map_err(e -> s"avin: $file: ${e.to_string()}\n")?
    val pending = pending_name(object)
    defer _ = remove_file(pending)
    var args: Buf[string] = buf()
    for a in ["-c", "-x", "c", "-w", "-fno-color-diagnostics", file, "-o", pending]
        args.push(a)
    for f in cflags
        args.push(f)
    val result = capture(tc.clang, args.view(), stderr = true, timeout = 120000).map_err(e -> "avin: " + missing_tool(tc.clang, e.to_string()) + "\n")?
    if !result.status.ok() then return Err(c_unit_diagnostics(result.err.unwrap_or("") + result.text, unit, bindings, handles, libraries, sources))
    publish_file(pending, object).map_err(e -> s"avin: $object: ${e.to_string()}\n")?
    Ok(())

/** What one binding's diagnostics from the C unit said. */
private struct BindingTrouble
    declared: string
    written: string
    undeclared: bool
    header: string
    other: string
    /** The typedefs found the wrong kind, and what each diagnostic says of one. */
    kind_names: Buf[string]
    kinds: Buf[string]
    /** What is wrong with the function its `free:` names. */
    frees: Buf[string]

/** Clang's diagnostics of the C unit `unit`, placed back at the bindings and the libraries they came
 * from; anything clang said that no line of the unit accounts for is passed on as it was. */
c_unit_diagnostics(output: string, unit: CUnitSource, bindings: Buf[CUnitBinding], handles: Buf[CUnitHandle], libraries: Buf[CLibrary], sources: Buf[Source]) -> string
    var troubles: Buf[BindingTrouble] = buf()
    for _ in bindings
        troubles.push(BindingTrouble("", "", false, "", "", buf(), buf(), buf()))
    // What each handle's glue said, one message for each part of its `@c`.
    var glue_parts: Buf[Buf[string]] = buf()
    var glue_messages: Buf[Buf[string]] = buf()
    for _ in handles
        glue_parts.push(buf())
        glue_messages.push(buf())
    var unplaced = ""
    var libraries_text = ""
    // What the field accessors' glue said, placed at each accessor.
    var fields_text = ""
    var placed_any = false
    // The binding whose declaration conflicted with the header's last, whose note names the header.
    var conflicting: Option[usize] = None
    for text in output.split("\n")
        val d = c_diagnostic(text) match
            Some(d) -> d
            None -> continue
        if d.severity == "note"
            if conflicting is Some(i) && d.message.starts_with("previous declaration is here") && troubles[i].header == ""
                troubles[i].header = header_named(d.file, libraries)
            continue
        conflicting = None
        if !d.file.ends_with("/" + CUnitFile) || d.line >= unit.lines.len()
            unplaced = unplaced + text + "\n"
            continue
        unit.lines[d.line] match
            IncludeLine(k, header) ->
                val library = libraries[k]
                val tail = if library.install == "" then "" else " " + library.install
                // A header named by a macro no earlier header defines is no header at all.
                if is_c_identifier(header) && d.message.contains("\"FILENAME\" or <FILENAME>")
                    libraries_text = libraries_text + s"error: the header `$header` of the C library `${library.label}` of package `${library.package}` is not a macro any earlier header defines: clang says '${d.message}'\n"
                else libraries_text = libraries_text + s"error: the header `$header` of the C library `${library.label}` of package `${library.package}` was not found: ${d.message}.$tail\n"
                placed_any = true
            GlueLine(i, part) ->
                placed_any = true
                // A type the headers do not declare makes every later line of its glue wrong too.
                if contains_text(glue_parts[i], part) || contains_text(glue_parts[i], "type") || contains_text(glue_parts[i], "pointer") then continue
                glue_parts[i].push(part)
                val h = handles[i]
                var m = s"the `$part:` of the C handle `${h.name}` does not compile against its headers: clang says '${d.message}'"
                if part == "type" then m = s"the C handle `${h.name}` is on `${h.ty}`, which its headers do not declare as a type: clang says '${d.message}'"
                elif part == "pointer" then m = s"the C handle `${h.name}` is on `${h.ty}`, which is not a pointer in its headers"
                glue_messages[i].push(m)
            AsLine(i, j) ->
                placed_any = true
                val key = "as " + j.to_string()
                if contains_text(glue_parts[i], key) || contains_text(glue_parts[i], "type") || contains_text(glue_parts[i], "pointer") then continue
                glue_parts[i].push(key)
                val h = handles[i]
                val entry = h.conversions[j]
                if d.message.starts_with("static assertion failed")
                    glue_messages[i].push(s"the `as:` conversion of the C handle `${h.name}` to `${entry.ty}` makes another type: `${c_call_text(entry.expr)}` is not a `${entry.ty}` in its headers")
                else glue_messages[i].push(s"the `as:` conversion of the C handle `${h.name}` to `${entry.ty}` does not compile against its headers: clang says '${d.message}'")
            FieldLine(i, j, part) ->
                placed_any = true
                val key = "field " + j.to_string()
                if contains_text(glue_parts[i], key) || contains_text(glue_parts[i], "type") || contains_text(glue_parts[i], "pointer") then continue
                glue_parts[i].push(key)
                val h = handles[i]
                val f = h.fields[j]
                val verb = if f.writer then "write" else "read"
                var m = s"the field `${f.expr}` of the C handle `${h.name}`, which `${f.name}` ${verb}s, does not compile against its headers: clang says '${d.message}'"
                if part == "kind"
                    var what = ""
                    f.handle match
                        Some(k) ->
                            for other in handles
                                if other.index == k then what = s"`${other.ty}`, the C type of `${other.name}`"
                        None -> what = field_kind_text(f.kind.unwrap())
                    m = s"the field `${f.expr}` of the C handle `${h.name}` is not $what in the headers, so `${f.name}` cannot $verb it as `${type_name(f.avin)}`"
                elif part == "write" then m = s"the field `${f.expr}` of the C handle `${h.name}` cannot be written by `${f.name}`: clang says '${d.message}'"
                elif part.starts_with("bound")
                    var position = 0usize
                    for x in part[5..].bytes
                        position = position * 10 + usize(x - u8('0'))
                    val b = f.bounds[position]
                    m =s"the `bound:` `$b` of the field accessor `${f.name}` does not compile against the headers of the C handle `${h.name}`: clang says '${d.message}'"
                var r = report()
                r.add(error(f.span, m))
                fields_text = fields_text + r.render(sources[f.unit])
            AssertLine(i) ->
                placed_any = true
                val requirement = "static assertion failed due to requirement '__builtin_types_compatible_p("
                if d.message.starts_with(requirement)
                    val inner = d.message[requirement.bytes.len..]
                    val end = inner.index_of(")':") match
                        Some(e) -> e
                        None -> inner.bytes.len
                    val pair = split_top_level(inner[..<end])
                    // The pointer's diagnostic, where clang gives one, names the typedefs.
                    if pair.len() == 2 && troubles[i].declared == ""
                        troubles[i].declared = function_type_text(pair[0])
                        troubles[i].written = function_type_text(pair[1])
                elif d.message.starts_with("use of undeclared identifier") then troubles[i].undeclared = true
                elif troubles[i].other == "" then troubles[i].other = d.message
            PointerLine(i) ->
                placed_any = true
                val initializing = "incompatible function pointer types initializing '"
                val expression = " with an expression of type '"
                if d.message.starts_with(initializing) && d.message.contains(expression)
                    val rest = d.message[initializing.bytes.len..]
                    val parts = rest.split(expression)
                    troubles[i].written = function_type_text(before_quote(parts[0]))
                    troubles[i].declared = function_type_text(before_quote(parts[1]))
            DeclareLine(i) ->
                placed_any = true
                if d.message.starts_with("conflicting types for") then conflicting = Some(i)
                elif troubles[i].other == "" then troubles[i].other = d.message
            KindLine(i, position, name, kind) ->
                placed_any = true
                val where = if position == 0 then "the result" else s"parameter $position"
                val avin = if position == 0 then bindings[i].result else bindings[i].params[position - 1]
                val what = field_kind_text(kind)
                // A type the headers do not declare at all is reported by the header check.
                if d.message.starts_with("static assertion failed") && !contains_text(troubles[i].kind_names, name)
                    troubles[i].kind_names.push(name)
                    troubles[i].kinds.push(s"the C type `$name` of $where is not $what in the headers, so it cannot cross as `${type_name(avin)}`")
            FreeLine(i, name) ->
                placed_any = true
                if troubles[i].frees.len() > 0 then continue
                if d.message.starts_with("use of undeclared identifier")
                    troubles[i].frees.push(s"the C binding `${bindings[i].name}` frees its result with `$name`, which no header of its package declares")
                elif d.message.starts_with("static assertion failed")
                    troubles[i].frees.push(s"the C binding `${bindings[i].name}` frees its result with `$name`, which the headers do not declare as a function taking the string and answering nothing, `void $name(void *)` or `void $name(char *)`")
            Plain -> unplaced = unplaced + text + "\n"
    var rendered = libraries_text
    for i in 0..<handles.len()
        if glue_messages[i].len() == 0 then continue
        var r = report()
        for m in glue_messages[i]
            r.add(error(handles[i].span, m))
        rendered = rendered + r.render(sources[handles[i].unit])
    rendered = rendered + fields_text
    for i in 0..<bindings.len()
        val b = bindings[i]
        val t = troubles[i]
        val symbol = b.prototype.symbol
        var messages: Buf[string] = buf()
        if t.undeclared
            var names = ""
            for library in libraries
                if library.package != b.package then continue
                for h in library.headers
                    names = names + (if names == "" then "" else ", ") + h
            messages.push(s"the C binding `${b.name}` names `$symbol`, which no header of its package declares: $names")
        elif t.declared != ""
            val place = if t.header == "" then "" else " in " + t.header
            messages.push(s"the C binding `${b.name}` does not match `$symbol`$place: the header declares '${t.declared}', but the binding says '${t.written}'")
        elif t.other != "" then messages.push(s"the C binding `${b.name}` does not compile against its headers: ${t.other}")
        for k in t.kinds
            messages.push(s"the C binding `${b.name}` does not fit its headers: $k")
        for m in t.frees
            messages.push(m)
        if messages.len() == 0 then continue
        var r = report()
        for m in messages
            r.add(error(b.span, m))
        rendered = rendered + r.render(sources[b.unit])
    if !placed_any || (rendered == "" && unplaced != "") then return "avin: the C unit did not compile:\n" + output
    rendered

// What a C type checked as `kind` must be, as a diagnostic says it.
private field_kind_text(kind: CKind) -> string = kind match
    KindInteger -> "an integer type"
    KindByte -> "an integer type one byte wide"
    KindBool -> "a bool or an integer type"
    KindReal -> "a floating-point type"
    KindText -> "`char *` or `const char *`"
    KindConstText -> "`const char *`"

/** One diagnostic line of clang's: the file, line and severity, and the message. */
private struct CDiagnostic
    file: string
    line: usize
    severity: string
    message: string

private c_diagnostic(text: string) -> Option[CDiagnostic]
    for severity in ["fatal error", "error", "note", "warning"]
        val marker = ": " + severity + ": "
        val at = text.index_of(marker) match
            Some(a) -> a
            None -> continue
        // `file:line:col` before the marker.
        val place = text[..<at].split(":")
        if place.len < 3 then return None
        var line = 0usize
        for b in place[place.len - 2].bytes
            if b < u8('0') || b > u8('9') then return None
            line = line * 10 + usize(b - u8('0'))
        var file = ""
        for i in 0..<place.len - 2
            file = if i == 0 then place[i] else file + ":" + place[i]
        return Some(CDiagnostic(file, line, if severity == "fatal error" then "error" else severity, text[at + marker.bytes.len..]))
    None

// The two types of `a, b`, split at the comma outside every parenthesis.
private split_top_level(text: string) -> Buf[string]
    var out: Buf[string] = buf()
    var depth = 0
    var from = 0usize
    for i in 0..<text.bytes.len
        val b = text.bytes[i]
        if b == u8('(') then depth += 1
        elif b == u8(')') then depth -= 1
        elif b == u8(',') && depth == 0
            out.push(text[from..<i].trim())
            from = i + 1
    out.push(text[from..].trim())
    out

// A pointer to a function type as clang writes it, `int (*)(long)`, as the function type,
// `int (long)`.
private function_type_text(pointer: string) -> string = pointer.replace_all("(*const)", "").replace_all("(*)", "").replace_all("  ", " ")

// What a diagnostic quotes, up to the quote that ends it.
private before_quote(text: string) -> string = text.index_of("'") match
    Some(end) -> text[..<end]
    None -> text

// The header a diagnostic's file is, as the manifest wrote it when it is one of `libraries`', and
// otherwise as the file's path from its include directory.
private header_named(file: string, libraries: Buf[CLibrary]) -> string
    for library in libraries
        for h in library.headers
            val bare = if h.starts_with("<") || h.starts_with("\"") then h[1..<h.bytes.len - 1] else h
            if file == bare || file.ends_with("/" + bare) then return h
    val parts = file.split("/include/")
    if parts.len > 1 then return parts[parts.len - 1]
    val names = file.split("/")
    names[names.len - 1]

/** The measurements in a C unit's object, by key, or `None` where the object holds no table of
 * `keys.len()` entries. */
read_measures(bytes: []const u8, keys: Buf[string]) -> Option[Map[string, CMeasure]]
    val marker = MeasureMarker.bytes
    var at: Option[usize] = None
    var i = 0usize
    while i + marker.len <= bytes.len
        var same = true
        for k in 0..<marker.len
            if bytes[i + k] != marker[k]
                same = false
                break
        if same
            at = Some(i + marker.len)
            break
        i += 1
    val start = at?
    if start + 2 > bytes.len then return None
    val count = usize(bytes[start]) + usize(bytes[start + 1]) * 256
    if count != keys.len() || start + 2 + 2 * count > bytes.len then return None
    var out: Map[string, CMeasure] = map()
    for j in 0..<count
        val size = u32(bytes[start + 2 + 2 * j])
        val signed = bytes[start + 3 + 2 * j] != 0u8
        out.put(keys[j], CMeasure(size * 8, signed))
    Some(out)
