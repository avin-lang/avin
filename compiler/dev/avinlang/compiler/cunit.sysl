module dev.avinlang.compiler

import sh.sysl.parsing.{Source, Span, error, report}
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.fs.{exists, make_dir_all, make_temp_dir, pending_name, publish_file, read_bytes, remove_dir_all, remove_file, write_text}
import sysl.process.capture
import sysl.text.{StrBuilder, from_utf8, str_builder}

// The C unit. Every program with C bindings is built with one generated C file, compiled by clang
// with the include flags of the program's C libraries. For each binding it holds a `_Static_assert`
// that the function the headers declare has exactly the type the prototype says, and a declaration
// of the function as the prototype says it, whose conflict with the header's names the header; for
// each typedef a prototype names, a `_Static_assert` that it is the kind of type its Avin type needs;
// and one table of constant bytes measuring each integer type a prototype names, its width and sign,
// and each typedef in a `real` position, its width. A second table holds the value of every
// enumerator an enum mirror holds and every constant a `@c(const:)` value is, after checks that each
// mirror's type is an integer type and each value the kind its Avin type asks for. The driver reads
// both tables out of the object file's bytes, so nothing is run and a build for another machine
// measures that machine. A clang diagnostic is placed back at the binding, the mirror or the constant
// by the line the unit gave it.
//
// The object is cached under `cunit/` in the user's cache, by a key over the unit's source, what
// `pkg-config` answers for the libraries, and `clang --version`.

/** A C binding as the C unit checks it: its name, its prototype, the Avin types of its parameters and
 * result, the unit and span that place it, the package it belongs to, "" for a program with no
 * manifest, how each position carries a string (the result first, then the parameters), and the
 * function its `free:` names. */
struct CUnitBinding
    name: string
    prototype: CPrototype
    params: Buf[&Type]
    result: &Type
    unit: usize
    span: Span
    package: string
    forms: Buf[CTextForm]
    free: Option[string]
    /** The packages of the handle classes it takes or answers, whose headers come before its own. */
    uses: Buf[string]
    /** The index of its symbol, which names its glue. */
    symbol: usize
    /** Whether it is called through glue, which passes and answers its structs by value through
     * pointers and computes the length of the array C answers; and for each position, the result
     * first, whether a struct crosses there by value. */
    glued: bool
    by_value: Buf[bool]
    /** The array C answers through an `out` pointer, copied after the call, or the memory it lends as
     * a view, when it answers one. */
    array_out: Option[CUnitArrayOut]
    /** The prototype's indices of the parameters a `ByteBlock` is passed to. */
    blocks: Buf[usize]

/** An array a binding's `array:` or `bytes:` names, or the memory its `view:` or bare `view` lends:
 * the prototype's index of the `out` parameter it is answered through, or the number of parameters
 * for the C result; the C type of its elements; the Avin type of an element; the C expression its
 * length is; how an array is freed; and whether it is a view, which nothing frees. */
struct CUnitArrayOut
    param: usize
    element_text: string
    element: &Type
    length: string
    free: Option[string]
    view: bool

/** A struct mirror as the C unit checks and measures it: its name and data type's index, which names
 * its typedefs, the C struct it mirrors, its fields, and the unit, span and package that place it. */
struct CUnitStruct
    name: string
    index: usize
    ty: string
    fields: Buf[CUnitStructField]
    unit: usize
    span: Span
    package: string

/** A field of a struct mirror: its Avin name, the C field it mirrors and whether its `@c` names it,
 * its Avin type, the kind of C type it must be, or for another mirror that mirror's data type and C
 * struct, and its span. */
struct CUnitStructField
    name: string
    c_name: string
    named: bool
    avin: &Type
    kind: Option[CKind]
    nested: Option[usize]
    nested_ty: string
    span: Span

/** An opaque value class as the C unit checks and measures it: its name and class index, the C type
 * it holds a copy of, and the unit, span and package that place it. */
struct CUnitValue
    name: string
    index: usize
    ty: string
    unit: usize
    span: Span
    package: string

/** A handle class as the C unit compiles its glue: its name and index, which name its glue
 * functions, the C type it is on as `parse_c_type` reads it and whether that is a typedef, whose
 * kind is checked, its `release:` and `retain:`, what its `kept:` names, the unit and span that place
 * it, and its package. */
struct CUnitHandle
    name: string
    index: usize
    ty: string
    typedef: bool
    release: string
    retain: Option[string]
    kept: Option[CUnitKept]
    unit: usize
    span: Span
    package: string
    /** The other C types it is passed as, and how each is made. */
    conversions: Buf[CAs]
    /** Its field accessors. */
    fields: Buf[CUnitField]
    /** Its `forget:`, the C expression in `self` and `userdata` that stops C calling a callback it
     * keeps. */
    forget: Option[string]
    /** Its `attach:`, the C expression in `self`, `key`, `data` and `destroy` that ties the record of
     * what it keeps to the C object, and `key:`, the type of the static object whose address keys it. */
    attach: Option[string]
    key: Option[string]

/** A field accessor as the C unit compiles its glue: the method's name, the index of its symbol, which
 * names its glue, the field, the names of its indices and the bound of each, whether it writes the
 * field, the kind of C type the field must be for the Avin type it reads or writes, or for a handle
 * read the handle's class, that Avin type, the unit and span that place the accessor, and for a field
 * lent as a view, whether it is lent `writable` and the C expression its length is ("" for no view). */
struct CUnitField
    name: string
    symbol: usize
    expr: string
    indices: Buf[string]
    bounds: Buf[string]
    writer: bool
    kind: Option[CKind]
    handle: Option[usize]
    avin: &Type
    unit: usize
    span: Span
    writable: bool
    length: string

/** The handle a class's `kept:` names: the name `release:` gives its pointer, the kept class's index
 * and its C type. */
struct CUnitKept
    name: string
    index: usize
    ty: string

/** An enum mirror as the C unit checks it: its name, the C type it mirrors, the enumerator of each
 * variant, in order, whether the variant names its own with `@c`, the variants' names and spans,
 * and the unit, span and package that place the mirror. */
struct CUnitEnum
    name: string
    ty: string
    enumerators: Buf[string]
    named: Buf[bool]
    variants: Buf[string]
    variant_spans: Buf[Span]
    unit: usize
    span: Span
    package: string

/** A module-level `@c(const:)` value as the C unit measures it: its name, the C constant, the kind of
 * value it is, its Avin type, and the unit, span and package that place it. */
struct CUnitConstant
    name: string
    constant: string
    kind: CConstKind
    avin: &Type
    unit: usize
    span: Span
    package: string

/** What building a program's C unit gave: the object, when the program has C bindings; whether this
 * build compiled it rather than finding it cached; what it measured, by `c_measure_key`, and the
 * values of its constants and enumerators, by `c_value_key`; and the flags that link the program's C
 * libraries. */
struct CUnit
    object: Option[string]
    built: bool
    measures: Map[string, CMeasure]
    values: Map[string, CValue]
    link: Buf[string]

/** The enum mirrors of a checked program, in the order of its data types. */
c_unit_enums(program: TProgram, files: Buf[ProgramFile], library: usize) -> Buf[CUnitEnum]
    var out: Buf[CUnitEnum] = buf()
    for d in program.data
        val e = c_enum_of(d.decl) match
            Some(e) -> e
            None -> continue
        var enumerators: Buf[string] = buf()
        var named: Buf[bool] = buf()
        var variants: Buf[string] = buf()
        var spans: Buf[Span] = buf()
        for v in d.decl.variants
            enumerators.push(c_enumerator(e, v))
            named.push(c_variant_text(v) is Some(_))
            variants.push(v.name)
            spans.push(v.span)
        out.push(CUnitEnum(d.name, e.ty, enumerators, named, variants, spans, d.unit, d.decl.span, package_of(d.unit, files, library)))
    out

/** The module-level `@c(const:)` values of a checked program, in the order they are declared. */
c_unit_constants(program: TProgram, files: Buf[ProgramFile], library: usize) -> Buf[CUnitConstant]
    var out: Buf[CUnitConstant] = buf()
    for g in program.globals
        val f = program.symbols[g.init]
        val body = f.decl.body match
            Some(b) -> b
            None -> continue
        val name = if body.kind is CConstant(n) then n else continue
        if name == "" then continue
        val t = f.result.unwrap_or(Unit)
        val kind = *t match
            Int(_) -> CConstInteger
            Real -> CConstReal
            Str -> CConstString
            _ -> continue
        out.push(CUnitConstant(g.name, name, kind, t, g.unit, g.span, package_of(g.unit, files, library)))
    out

/** The name the C unit is written under, which clang's diagnostics name. */
const CUnitFile: string = "avin-c-unit.c"

/** What the measurement table begins with, which finds it among the object's bytes. */
const MeasureMarker: string = "avin.c-unit.measurements:"

/** The C bindings of a checked program, in the order of their symbols. `files` are the program's own
 * files, the units from `library` on. */
c_unit_bindings(program: TProgram, files: Buf[ProgramFile], library: usize) -> Buf[CUnitBinding]
    var out: Buf[CUnitBinding] = buf()
    for n in 0..<program.symbols.len()
        val s = program.symbols[n]
        if s.root is Some(_) || s.receiver is Some(_) then continue
        // A method is a binding only on a C handle or an opaque value, and its receiver, the first
        // of its parameters, is the prototype's first.
        if s.owner_class is Some(k)
            if c_handle_type(program.classes[k].decl) is None && c_value_type(program.classes[k].decl) is None || s.constructor then continue
        val p = c_prototype_of(s.decl) match
            Some(p) -> p
            None -> continue
        val package = package_of(s.unit, files, library)
        val parts = c_result_parts(p, s.result.unwrap_or(Unit), program.data) match
            Ok(parts) -> parts
            Err(_) -> continue
        // Each of the prototype's positions has the Avin type crossing there: an `out` or `inout`
        // parameter its out value's, and a status the integer or the mirror its code is. A mirror is
        // measured as the integer it is.
        var result = parts.result
        if c_status_error(result, program.data) is Some(e) then result = e
        // Each position a struct crosses by value at, which the glue passes through a pointer.
        var by_value: Buf[bool] = buf()
        by_value.push(c_by_value(p.result, result, program.data, program.classes))
        var glue_params: Buf[&Type] = buf()
        var params: Buf[&Type] = buf()
        var out_at = 0usize
        var in_at = 0usize
        // A length passed in is the array's, an `int`; an array's position has its element type,
        // which the C unit checks the pointer points at.
        for i in 0..<p.params.len()
            val q = p.params[i]
            if q.mode is CIn && q.length_of != "" then params.push(Int(32))
            elif q.userdata then params.push(Unit)
            elif q.callback.len() > 0
                // A callback's function type, a mirror among its parameters and its answer measured
                // as the integer it is.
                val t: &Type = if in_at < s.params.len() then s.params[in_at] else Unit
                params.push(c_callback_measured(t, program.data))
            elif q.mode is CIn
                var t: &Type = if in_at < s.params.len() then s.params[in_at] else Unit
                if c_is_array_param(p, i)
                    if c_array_form(t, program.data, program.classes) is Some(form) then t = form.element
                params.push(t)
            else
                params.push(if out_at < parts.outs.len() then parts.outs[out_at] else Unit)
                out_at += 1
            if c_is_avin_param(q) then in_at += 1
        for i in 0..<p.params.len()
            val q = p.params[i]
            by_value.push(q.mode is CIn && c_by_value(q.ty, params[i], program.data, program.classes))
            if c_is_avin_param(q) then glue_params.push(params[i])
        var array_out: Option[CUnitArrayOut] = None
        if c_array_out_of(s.decl) is Some(a)
            // A view's bytes are checked through the pointer C lends them by: the C result's type for
            // a bare `view`, which the out parameters' indices do not reach.
            if a.view && a.name == ""
                array_out = Some(CUnitArrayOut(p.params.len(), s"__typeof__(*(${p.result_text})0)", Byte, a.length, None, true))
            elif c_array_out_index(p, a) is Some(k)
                if a.view then array_out = Some(CUnitArrayOut(k, s"__typeof__(**(${p.params[k].pointee_text} *)0)", Byte, a.length, None, true))
                elif c_array_form(params[k], program.data, program.classes) is Some(form)
                    array_out = Some(CUnitArrayOut(k, c_array_out_element(p.params[k]), form.element, a.length, a.free, false))
        // The parameters a `ByteBlock` is passed to, a pointer to its bytes.
        var blocks: Buf[usize] = buf()
        for k in 0..<p.params.len()
            if p.params[k].mode is CIn && c_memory_form(params[k], program.data, program.classes) is Some(_) then blocks.push(k)
        val glued = c_binding_glued(s.decl, p, glue_params, result, program.data, program.classes)
        if c_mirror_of(result, program.data) is Some(_) then result = Int(64)
        for i in 0..<params.len()
            if c_mirror_of(params[i], program.data) is Some(_) then params[i] = Int(64)
        var forms: Buf[CTextForm] = buf()
        forms.push(c_text_form(result, program.data, program.classes))
        for t in params
            forms.push(c_text_form(t, program.data, program.classes))
        var uses: Buf[string] = buf()
        var positions: Buf[&Type] = buf()
        positions.push(result)
        for t in params
            positions.push(t)
        for t in positions
            if c_handle_form(t, program.data, program.classes) is Some(h)
                val used = package_of(program.classes[h.class_index].unit, files, library)
                if used != package && !contains_text(uses, used) then uses.push(used)
        out.push(CUnitBinding(s.name, p, params, result, s.unit, s.decl.name_span, package, forms, c_free_text(s.decl), uses, n, glued, by_value, array_out, blocks))
    out

/** The struct mirrors of a checked program, in the order of its data types. */
c_unit_structs(program: TProgram, files: Buf[ProgramFile], library: usize) -> Buf[CUnitStruct]
    var out: Buf[CUnitStruct] = buf()
    for id in 0..<program.data.len()
        val d = program.data[id]
        if c_struct_type(d.decl) is None || d.variants.len() != 1 || d.decl.variants.len() != 1 then continue
        val ty = c_struct_text(d.decl)
        if ty == "" then continue
        var fields: Buf[CUnitStructField] = buf()
        val v = d.variants[0]
        for j in 0..<v.fields.len()
            val decl = d.decl.variants[0].fields[j]
            val t = v.fields[j]
            var nested: Option[usize] = None
            var nested_ty = ""
            if c_struct_of(t, program.data) is Some(e)
                nested = Some(e)
                nested_ty = c_struct_text(program.data[e].decl)
            var named = false
            for a in decl.annotations
                if a.name == "c" then named = true
            fields.push(CUnitStructField(v.field_names[j], c_struct_field_name(decl), named, t, c_struct_field_kind(t, program.data, program.classes), nested, nested_ty, decl.span))
        out.push(CUnitStruct(d.name, id, ty, fields, d.unit, d.decl.span, package_of(d.unit, files, library)))
    out

/** The opaque value classes of a checked program, in the order of its classes. */
c_unit_values(program: TProgram, files: Buf[ProgramFile], library: usize) -> Buf[CUnitValue]
    var out: Buf[CUnitValue] = buf()
    for k in 0..<program.classes.len()
        val d = program.classes[k].decl
        if c_value_type(d) is None then continue
        val ty = c_value_text(d)
        if ty == "" then continue
        out.push(CUnitValue(program.classes[k].name, k, ty, program.classes[k].unit, d.name_span, package_of(program.classes[k].unit, files, library)))
    out

private package_of(unit: usize, files: Buf[ProgramFile], library: usize) -> string = if unit >= library && unit - library < files.len() then files[unit - library].package else ""

/** The handle classes of a checked program, whose glue the C unit compiles, in the order of the
 * program's classes. */
c_unit_handles(program: TProgram, files: Buf[ProgramFile], library: usize) -> Buf[CUnitHandle]
    var out: Buf[CUnitHandle] = buf()
    for k in 0..<program.classes.len()
        val d = program.classes[k].decl
        val written = c_handle_type(d) match
            Some(t) -> t
            None -> continue
        val ty = parse_c_type(written) match
            Ok(t) -> t
            Err(_) -> continue
        var kept: Option[CUnitKept] = None
        if c_class_kept(d) is Some(name)
            if c_kept_class(program.classes, k) is Some(j)
                val kd = program.classes[j].decl
                if c_handle_type(kd) is Some(kt) && c_class_text(kd, "retain") is Some(_) && c_class_kept(kd) is None
                    kept = Some(CUnitKept(name.name, j, kt))
        out.push(CUnitHandle(program.classes[k].name, k, ty.text, ty.ty is CTypedef(_), c_class_text(d, "release").unwrap_or(""), c_class_text(d, "retain"), kept, program.classes[k].unit, d.name_span, package_of(program.classes[k].unit, files, library), c_class_as(d), c_unit_fields(program, k), c_class_text(d, "forget"), c_class_text(d, "attach"), c_class_text(d, "key")))
    out

// The kind of C type a field read or written as the scalar `avin` is.
private c_field_kind(avin: &Type) -> Option[CKind] = *avin match
    Int(_) -> Some(KindInteger)
    Byte -> Some(KindByte)
    Bool -> Some(KindBool)
    Real -> Some(KindReal)
    _ -> None

// The field accessors of the handle class `k`, in the order of the program's symbols.
private c_unit_fields(program: TProgram, k: usize) -> Buf[CUnitField]
    var out: Buf[CUnitField] = buf()
    for n in 0..<program.symbols.len()
        val s = program.symbols[n]
        if s.root is Some(_) || s.receiver is Some(_) || s.constructor || s.owner_class != Some(k) then continue
        val field = c_field_of(s.decl) match
            Some(f) -> f
            None -> continue
        // The receiver is the first parameter; the value written, for a writer, the last.
        val result = s.result.unwrap_or(Unit)
        val writer = *result is Unit
        if s.params.len() < 1 || writer && s.params.len() < 2 then continue
        val last = if writer then s.params.len() - 1 else s.params.len()
        var indices: Buf[string] = buf()
        for i in 1..<last
            val name = s.decl.params[i - 1].pattern.kind match
                Name(name) -> name
                _ -> "_"
            indices.push(name)
        val avin = if writer then s.params[last] else result
        var kind: Option[CKind] = None
        var handle: Option[usize] = None
        val lent = field.view && !writer && field.length != ""
        if lent then ()
        elif c_handle_form(avin, program.data, program.classes) is Some(h) then handle = Some(h.class_index)
        elif !(c_text_form(avin, program.data, program.classes) is NoText) then kind = Some(KindText)
        else kind = c_field_kind(avin)
        if kind is None && handle is None && !lent then continue
        out.push(CUnitField(s.name, n, field.expr, indices, field.bounds, writer, kind, handle, avin, s.unit, s.decl.name_span, field.writable, if lent then field.length else ""))
    out

/** The C unit of a program whose C bindings are `bindings` and whose packages name `libraries`. Each
 * library's `pkg-config` module is asked for its flags; with no bindings there is no unit, and only
 * the link flags are answered. A binding the headers do not declare as its prototype says, or whose
 * package names no header, is reported at the binding, rendered with `sources`. */
ensure_c_unit(tc: Toolchain, bindings: Buf[CUnitBinding], handles: Buf[CUnitHandle], libraries: Buf[CLibrary], sources: Buf[Source]) -> Result[CUnit, string] = ensure_c_unit_of(tc, CUnitParts(bindings, handles, buf(), buf(), buf(), buf()), libraries, sources)

/** What a program's C unit is made of: its bindings, its handles' glue, its enum mirrors and its
 * constants. */
struct CUnitParts
    bindings: Buf[CUnitBinding]
    handles: Buf[CUnitHandle]
    enums: Buf[CUnitEnum]
    constants: Buf[CUnitConstant]
    structs: Buf[CUnitStruct]
    values: Buf[CUnitValue]

/** The diagnostics of each C binding, handle, enum mirror, struct mirror, opaque value and constant of
 * `parts` that names no header to be checked, compiled or measured against, or "" for none. It needs
 * no C compiler, so `avin check` reports it without building the C unit. */
headerless(parts: CUnitParts, libraries: Buf[CLibrary], sources: Buf[Source]) -> string
    val bindings = parts.bindings
    val handles = parts.handles
    // A binding is checked against a header, always, and a handle's glue compiled against one.
    var refused = ""
    for b in bindings
        var headers = 0usize
        for library in libraries
            if library.package == b.package then headers += library.headers.len()
        if headers > 0 then continue
        val why = if b.package == "" then s"the C binding `${b.name}` is checked against the headers a package's manifest names under `c-libraries`, and this program has no avin.hocon" else s"the C binding `${b.name}` has no header to be checked against: name the one that declares `${b.prototype.symbol}` in a `headers` list of the `c-libraries` of package `${b.package}`"
        var r = report()
        r.add(error(b.span, why))
        refused = refused + r.render(sources[b.unit])
    for h in handles
        var headers = 0usize
        for library in libraries
            if library.package == h.package then headers += library.headers.len()
        if headers > 0 then continue
        val why = if h.package == "" then s"the C handle `${h.name}` is compiled against the headers a package's manifest names under `c-libraries`, and this program has no avin.hocon" else s"the C handle `${h.name}` has no header to be compiled against: name the one that declares `${h.ty}` in a `headers` list of the `c-libraries` of package `${h.package}`"
        var r = report()
        r.add(error(h.span, why))
        refused = refused + r.render(sources[h.unit])
    for e in parts.enums
        if package_headers(libraries, e.package) > 0 then continue
        val why = if e.package == "" then s"the C enum mirror `${e.name}` is measured against the headers a package's manifest names under `c-libraries`, and this program has no avin.hocon" else s"the C enum mirror `${e.name}` has no header to be measured against: name the one that declares `${e.ty}` in a `headers` list of the `c-libraries` of package `${e.package}`"
        var r = report()
        r.add(error(e.span, why))
        refused = refused + r.render(sources[e.unit])
    for m in parts.structs
        if package_headers(libraries, m.package) > 0 then continue
        val why = if m.package == "" then s"the C struct mirror `${m.name}` is checked against the headers a package's manifest names under `c-libraries`, and this program has no avin.hocon" else s"the C struct mirror `${m.name}` has no header to be checked against: name the one that declares `${m.ty}` in a `headers` list of the `c-libraries` of package `${m.package}`"
        var r = report()
        r.add(error(m.span, why))
        refused = refused + r.render(sources[m.unit])
    for v in parts.values
        if package_headers(libraries, v.package) > 0 then continue
        val why = if v.package == "" then s"the opaque value `${v.name}` is measured against the headers a package's manifest names under `c-libraries`, and this program has no avin.hocon" else s"the opaque value `${v.name}` has no header to be measured against: name the one that declares `${v.ty}` in a `headers` list of the `c-libraries` of package `${v.package}`"
        var r = report()
        r.add(error(v.span, why))
        refused = refused + r.render(sources[v.unit])
    for k in parts.constants
        if package_headers(libraries, k.package) > 0 then continue
        val why = if k.package == "" then s"the C constant `${k.name}` is measured against the headers a package's manifest names under `c-libraries`, and this program has no avin.hocon" else s"the C constant `${k.name}` has no header to be measured against: name the one that defines `${k.constant}` in a `headers` list of the `c-libraries` of package `${k.package}`"
        var r = report()
        r.add(error(k.span, why))
        refused = refused + r.render(sources[k.unit])
    refused

/** The C unit of a program made of `parts`, as `ensure_c_unit` builds one; each enumerator and
 * constant is measured, and a constant its Avin type cannot hold, or a string constant that is not
 * UTF-8, is reported at the constant. */
ensure_c_unit_of(tc: Toolchain, parts: CUnitParts, libraries: Buf[CLibrary], sources: Buf[Source]) -> Result[CUnit, string]
    val bindings = parts.bindings
    val handles = parts.handles
    if bindings.len() == 0 && handles.len() == 0 && parts.enums.len() == 0 && parts.constants.len() == 0 && parts.structs.len() == 0 && parts.values.len() == 0 && libraries.len() == 0 then return Ok(CUnit(None, false, map(), map(), buf()))
    val refused = headerless(parts, libraries, sources)
    if refused != "" then return Err(refused)
    var cflags: Buf[string] = buf()
    var link: Buf[string] = buf()
    var answered = ""
    for library in libraries
        library.pkg_config match
            Some(m) ->
                val c = ask_pkg_config(tc, library, m, "--cflags")?
                val l = ask_pkg_config(tc, library, m, "--libs")?
                answered = answered + m + "\n" + c + "\n" + l + "\n"
                for flag in c.fields()
                    add_flag(&cflags, flag)
                for flag in l.fields()
                    add_flag(&link, flag)
            None ->
                for name in library.link
                    add_flag(&link, "-l" + name)
    if bindings.len() == 0 && handles.len() == 0 && parts.enums.len() == 0 && parts.constants.len() == 0 && parts.structs.len() == 0 && parts.values.len() == 0 then return Ok(CUnit(None, false, map(), map(), link))
    val unit = c_unit_source_of(parts, libraries)
    val version = capture(tc.clang, ["--version"], timeout = 60000) match
        Ok(r) -> r.text
        Err(e) -> return Err("avin: " + missing_tool(tc.clang, e.to_string()) + "\n")
    var flags_text = ""
    for f in cflags
        flags_text = flags_text + f + "\n"
    val object = tc.c_unit_cache() + "/" + content_key(unit.text + "\n" + flags_text + answered + version) + ".o"
    var built = false
    if !exists(object)
        compile_c_unit(tc, unit, cflags, object, parts, libraries, sources)?
        built = true
    val bytes = read_bytes(object).map_err(e -> s"avin: $object: ${e.to_string()}\n")?
    val measures = read_measures(bytes, unit.measured) match
        Some(m) -> m
        None -> return Err(s"avin: the C unit $object holds no measurements\n")
    val values = read_values(bytes, unit.values) match
        Some(v) -> v
        None -> return Err(s"avin: the C unit $object holds no values\n")
    val troubles = c_constant_troubles(parts.constants, values, sources)
    if troubles != "" then return Err(troubles)
    Ok(CUnit(Some(object), built, measures, values, link))

private package_headers(libraries: Buf[CLibrary], package: string) -> usize
    var headers = 0usize
    for library in libraries
        if library.package == package then headers += library.headers.len()
    headers

// What is wrong with the measured constants: an integer its Avin type cannot hold, which names the
// value and the type, and a string that is not UTF-8.
private c_constant_troubles(constants: Buf[CUnitConstant], values: Map[string, CValue], sources: Buf[Source]) -> string
    var out = ""
    for k in constants
        val v = values.get(c_value_key(k.kind, k.constant)) match
            Some(v) -> v
            None -> continue
        var why = ""
        k.kind match
            CConstInteger ->
                val bits = *k.avin match
                    Int(b) -> b
                    _ -> 64u32
                if !v.negative && v.integer < 0i64 then why = s"the C constant `${k.constant}` is greater than any `long` holds, so `${k.name}` cannot be `${type_name(k.avin)}`"
                elif bits < 64u32
                    val greatest = (1i64 << i64(bits - 1u32)) - 1i64
                    if v.integer > greatest || v.integer < -greatest - 1i64 then why = s"the C constant `${k.constant}` is ${v.integer}, which `${type_name(k.avin)}` cannot hold, so `${k.name}` is a wider integer type"
            CConstString -> if v.text is None then why = s"the C constant `${k.constant}` is a string that is not UTF-8, so `${k.name}` cannot be a `string`"
            CConstReal -> ()
        if why == "" then continue
        var r = report()
        r.add(error(k.span, why))
        out = out + r.render(sources[k.unit])
    out

private add_flag(flags: *Buf[string], flag: string)
    for f in *flags
        if f == flag then return
    flags.push(flag)

// What `pkg-config <question> <module>` prints, or the error a build that cannot find the library
// gives, with what the manifest says to do.
private ask_pkg_config(tc: Toolchain, library: CLibrary, module_name: string, question: string) -> Result[string, string]
    val tail = if library.install == "" then "" else " " + library.install
    val asked = s"`pkg-config $question $module_name`"
    val result = capture(tc.pkg_config, [question, module_name], stderr = true, timeout = 60000) match
        Ok(r) -> r
        Err(e) -> return Err(s"error: the C library `${library.label}` of package `${library.package}` was not found: $asked could not run (${e.to_string()}).$tail\n")
    if !result.status.ok() then return Err(s"error: the C library `${library.label}` of package `${library.package}` was not found: $asked failed.$tail\n")
    Ok(result.text.trim())

/** What one line of the C unit is for, which places a diagnostic clang gives at it. */
enum CUnitLine
    /** Nothing a diagnostic is placed by. */
    Plain
    /** The `#include` of a header of `libraries[library]`. */
    IncludeLine(library: usize, header: string)
    /** The header check of `bindings[binding]`. */
    AssertLine(binding: usize)
    /** A pointer of the prototype's type set to the header's function, whose diagnostic writes both
     * types with their typedefs' names. */
    PointerLine(binding: usize)
    /** The declaration of `bindings[binding]`'s function as its prototype says it. */
    DeclareLine(binding: usize)
    /** The check that the typedef `name`, parameter `position` of `bindings[binding]` (0 for the
     * result), is the kind `kind` needs. */
    KindLine(binding: usize, position: usize, name: string, kind: CKind)
    /** The check that the type parameter `position` of `bindings[binding]` points at is the element
     * type of the Avin array passed there, as it is, by kind, size and sign. */
    ElementLine(binding: usize, position: usize)
    /** The check that the pointer `name`, which the function `bindings[binding]` passes for its
     * parameter `param` is called with, points at bytes one byte wide, lent as a view. */
    CallbackBytesLine(binding: usize, param: usize, name: string)
    /** The check that `free`, which `bindings[binding]`'s `free:` names, frees a string. */
    FreeLine(binding: usize, free: string)
    /** A line of the glue of `handles[handle]` compiling what its `@c` says under `part`: `type`,
     * `release`, `retain` or `kept`. */
    GlueLine(handle: usize, part: string)
    /** A line of the glue of `handles[handle]`'s `as:` conversion `entry`. */
    AsLine(handle: usize, entry: usize)
    /** The check of the C type the enum mirror `enums[mirror]` names, `type` declaring it and
     * `kind` checking it is an integer type. */
    EnumLine(mirror: usize, part: string)
    /** A line of the measurement of `values[entry]`: `kind` checks its kind, `value` measures it. */
    ValueLine(entry: usize, part: string)
    /** A line of the glue of the field accessor `handles[handle].fields[field]`: `field` reads its
     * field and names its type, `kind` checks that type, `bound` with the index's position compiles
     * its bound, and `write` writes the field. */
    FieldLine(handle: usize, field: usize, part: string)
    /** A line of the glue `bindings[binding]` is called through: `call` makes the call, `length`
     * computes the length of the array it answers, `element` checks that array's elements and `free`
     * frees it. */
    BindingGlueLine(binding: usize, part: string)
    /** A line of the check of the struct mirror `structs[mirror]`: `type` declaring its struct and
     * `kind` checking it is one, and for its field `field` `field` naming the field's type, `kind`
     * checking it, `nested` checking it is the struct another mirror mirrors, and `order` its offset;
     * `size` checks no field follows the last, and `full` that the mirror names every field. */
    StructLine(mirror: usize, field: usize, part: string)
    /** A line of the check of the opaque value `values[value]`'s C type: `type` declaring it and
     * `kind` checking it is a struct or a union. */
    ValueTypeLine(value: usize, part: string)

/** A C unit's text, what each of its lines is for, counting from 1, and the measurement keys of its
 * table, in order. */
struct CUnitSource
    text: string
    lines: Buf[CUnitLine]
    measured: Buf[string]
    /** The constants and enumerators of its table of values, in order. */
    values: Buf[CValueEntry]

/** One value the C unit measures: the key it is kept under, its kind, the C constant or enumerator,
 * and what it is measured for, a constant by its index or the variant `variant` of an enum mirror. */
struct CValueEntry
    key: string
    kind: CConstKind
    expr: string
    constant: Option[usize]
    mirror: Option[usize]
    variant: usize
    /** Whether it is a struct's size or a field's offset, which the checks of the struct mirrors and
     * opaque values before it place a diagnostic of at the mirror or the value. */
    layout: bool

/** The C unit for `bindings` and the glue of `handles`, including every header of `libraries`, in
 * `header_order`, so a binding naming another package's handle is checked with that package's
 * headers before its own. Each package's headers keep their order, and a header that is a C
 * identifier is a macro an earlier header defines, included as `#include NAME`. */
c_unit_source(bindings: Buf[CUnitBinding], handles: Buf[CUnitHandle], libraries: Buf[CLibrary]) -> CUnitSource = c_unit_source_of(CUnitParts(bindings, handles, buf(), buf(), buf(), buf()), libraries)

/** The C unit of `parts`, as `c_unit_source` writes one, with the check of each enum mirror's type
 * and the values of its enumerators and of the constants: a table of their own, after the
 * measurements. */
c_unit_source_of(parts: CUnitParts, libraries: Buf[CLibrary]) -> CUnitSource
    val bindings = parts.bindings
    val handles = parts.handles
    var out = str_builder()
    var lines: Buf[CUnitLine] = buf()
    // Line 0 does not exist; lines count from 1.
    lines.push(Plain)
    out.push("/* The C unit of an Avin program: written by the compiler. */\n")
    lines.push(Plain)
    // No warning of the headers' or the unit's is reported, and the one the struct mirrors' checks
    // need is made an error where they need it.
    out.push("#pragma clang diagnostic ignored \"-Weverything\"\n")
    lines.push(Plain)
    // What clang refuses by default stays refused: the header check's mismatches and the glue's
    // undeclared functions are these.
    for group in ["implicit-function-declaration", "implicit-int", "int-conversion", "incompatible-function-pointer-types"]
        out.push(s"#pragma clang diagnostic error \"-W$group\"\n")
        lines.push(Plain)
    out.push("#include <stdbool.h>\n")
    lines.push(Plain)
    // The glue gives back handles and frees arrays, often with `free`.
    var frees = handles.len() > 0
    for b in bindings
        if b.array_out is Some(_) then frees = true
    if frees
        out.push("#include <stdlib.h>\n")
        lines.push(Plain)
    var included: Buf[string] = buf()
    for package in header_order(bindings, libraries)
        for i in 0..<libraries.len()
            if libraries[i].package != package then continue
            for h in libraries[i].headers
                if contains_text(included, h) then continue
                included.push(h)
                val spelled = if h.starts_with("<") || h.starts_with("\"") || is_c_identifier(h) then h else "<" + h + ">"
                out.push("#include " + spelled + "\n")
                lines.push(IncludeLine(i, h))
    if handles.len() > 0 then handle_glue(&out, &lines, handles)
    var kinds: Buf[string] = buf()
    var measured: Buf[string] = buf()
    var measured_types: Buf[string] = buf()
    struct_checks(&out, &lines, parts)
    // The type of each struct mirror's field that is an integer, a truth value or a `real` is
    // measured.
    for m in parts.structs
        for j in 0..<m.fields.len()
            val kind = m.fields[j].kind match
                Some(kind) -> kind
                None -> continue
            if !c_kind_measured(kind) then continue
            val name = c_struct_field_type(m.index, j)
            measured.push(c_measure_key(CTypedef(name), kind))
            measured_types.push(name)
    // The type of each field read or written as an integer, a truth value or a `real` is measured.
    for h in handles
        for f in h.fields
            val kind = f.kind match
                Some(kind) -> kind
                None -> continue
            if !c_kind_measured(kind) then continue
            val name = c_field_type_name(f.symbol)
            measured.push(c_measure_key(CTypedef(name), kind))
            measured_types.push(name)
    for i in 0..<bindings.len()
        val b = bindings[i]
        val p = b.prototype
        var params = ""
        for k in 0..<p.params.len()
            params = params + (if k > 0 then ", " else "") + p.params[k].text
        if params == "" then params = "void"
        out.push(s"_Static_assert(__builtin_types_compatible_p(__typeof__(&${p.symbol}), ${p.result_text} (*)($params)), \"avin: the C binding ${b.name}\");\n")
        lines.push(AssertLine(i))
        out.push(s"static ${p.result_text} (*const avin_c_binding_$i)($params) = &${p.symbol};\n")
        lines.push(PointerLine(i))
        out.push(s"${p.result_text} ${p.symbol}($params);\n")
        lines.push(DeclareLine(i))
        if b.glued then binding_glue(&out, &lines, b, i)
        // The function `free:` names takes the string C answered, or any pointer, and answers nothing.
        if b.free is Some(f)
            val fp = s"__typeof__(&$f)"
            var takes = ""
            for arg in ["void *", "char *", "const char *", p.result_text]
                takes = takes + (if takes == "" then "" else " || ") + s"__builtin_types_compatible_p($fp, void (*)($arg))"
            out.push(s"_Static_assert($takes, \"avin: the free function $f\");\n")
            lines.push(FreeLine(i, f))
        // What each array parameter points at is its elements' type, as it is.
        for k in 0..<p.params.len()
            // An array of a struct mirror is converted into the struct the pointer names.
            if !c_is_array_param(p, k) || c_array_element_size(b.params[k]) == 0 then continue
            out.push(s"_Static_assert(${element_test(b.params[k], p.params[k].pointee_text)}, \"avin: the elements of parameter ${k + 1} of ${b.name}\");\n")
            lines.push(ElementLine(i, k + 1))
        // A `ByteBlock` is passed as a pointer to its bytes, which are one byte wide.
        for k in b.blocks
            val bytes = "__typeof__(*(" + p.params[k].text + ")0)"
            out.push(s"_Static_assert(${element_test(Byte, bytes)}, \"avin: the bytes of parameter ${k + 1} of ${b.name}\");\n")
            lines.push(ElementLine(i, k + 1))
        // Each named type at each position: the result first, then the parameters.
        for k in 0..<p.params.len() + 1
            // An `out` or `inout` parameter's value is the type its pointer points at, answered.
            val written = k > 0 && !(p.params[k - 1].mode is CIn)
            val c = if k == 0 then p.result elif written then p.params[k - 1].pointee else p.params[k - 1].ty
            val avin = if k == 0 then b.result else b.params[k - 1]
            val kind = c_kind_needed(c, avin, b.forms[k], k == 0 || written) match
                Some(kind) -> kind
                None -> continue
            val spelled = c_spelling(c)
            if c is CTypedef(name)
                val tag = kind_tag(kind) + " " + name
                if !contains_text(kinds, tag)
                    kinds.push(tag)
                    out.push(s"_Static_assert(${kind_test(kind, name)}, \"avin: the C type $name\");\n")
                    lines.push(KindLine(i, k, name, kind))
            if !c_kind_measured(kind) then continue
            val key = c_measure_key(c, kind)
            if !contains_text(measured, key)
                measured.push(key)
                measured_types.push(spelled)
        // A callback's parameters are what C calls it with, crossing as results do, and its answer
        // crosses as a parameter does: each named type is checked and measured as at a binding.
        for k in 0..<p.params.len()
            if p.params[k].callback.len() == 0 then continue
            val f = p.params[k].callback[0]
            val (ps, r) = *b.params[k] match
                Function(ps, r, _) -> (ps, r)
                _ -> continue
            val positions = c_callback_positions(f)
            for j in 0..<positions.len() + 1
                val c = if j == 0 then f.result else f.params[positions[j - 1]].ty
                if j > 0 && j - 1 >= ps.len() then continue
                val avin = if j == 0 then r else ps[j - 1]
                val form = if *avin is Str then TextString(false) else NoText
                val kind = c_kind_needed(c, avin, form, j > 0) match
                    Some(kind) -> kind
                    None -> continue
                if c is CTypedef(name)
                    val tag = kind_tag(kind) + " " + name
                    if !contains_text(kinds, tag)
                        kinds.push(tag)
                        out.push(s"_Static_assert(${kind_test(kind, name)}, \"avin: the C type $name\");\n")
                        lines.push(KindLine(i, k + 1, name, kind))
                if !c_kind_measured(kind) then continue
                val key = c_measure_key(c, kind)
                if !contains_text(measured, key)
                    measured.push(key)
                    measured_types.push(c_spelling(c))
            // Memory C lends the function is a pointer to bytes one byte wide, and its length an
            // integer, measured as any is.
            for r in f.params
                if r.length_of == "" then continue
                for q in f.params
                    if q.name != r.length_of then continue
                    out.push(s"_Static_assert(${element_test(Byte, "__typeof__(*(" + q.text + ")0)")}, \"avin: the bytes ${q.name} lends ${b.name}'s function\");\n")
                    lines.push(CallbackBytesLine(i, k, q.name))
                val c = r.ty
                val kind = c_kind_needed(c, Int(64), NoText, true) match
                    Some(kind) -> kind
                    None -> continue
                if c is CTypedef(name)
                    val tag = kind_tag(kind) + " " + name
                    if !contains_text(kinds, tag)
                        kinds.push(tag)
                        out.push(s"_Static_assert(${kind_test(kind, name)}, \"avin: the C type $name\");\n")
                        lines.push(KindLine(i, k + 1, name, kind))
                if !c_kind_measured(kind) then continue
                val key = c_measure_key(c, kind)
                if !contains_text(measured, key)
                    measured.push(key)
                    measured_types.push(c_spelling(c))
    // The measurements: the marker, the count, then two bytes for each measured type.
    out.push("__attribute__((used)) const unsigned char avin_c_unit_measurements[] = {\n")
    lines.push(Plain)
    var marker = "   "
    for byte in MeasureMarker.bytes
        marker = marker + s" $byte,"
    out.push(marker + "\n")
    lines.push(Plain)
    out.push(s"    ${measured.len() % 256}, ${measured.len() / 256},\n")
    lines.push(Plain)
    for j in 0..<measured.len()
        val t = measured_types[j]
        if measured[j].starts_with("real ") then out.push(s"    (unsigned char)sizeof($t), 0,\n")
        else out.push(s"    (unsigned char)sizeof($t), (unsigned char)(($t)-1 < ($t)0),\n")
        lines.push(Plain)
    out.push("};\n")
    lines.push(Plain)
    val values = value_table(&out, &lines, parts)
    CUnitSource(out.finish(), lines, measured, values)

// The glue of the handle classes. A handle's object is six words: its C pointer, null once given
// back; its owner; the C references it holds to what it keeps, a list off the heap; the Avin objects
// it keeps and the view it lent last, which the collector traces; and for a class with `attach:`, the
// number of the runtime's record of what it keeps, which C holds too. For each class `i` the unit defines
// `avin_c_give_back_i`, which gives the object's reference back through `release:` and then each C
// reference it holds, in the order they were taken, and `avin_c_finalize_i`, the collector's
// finalizer of its objects, which does the same; with `retain:`, `avin_c_retain_i`, which takes a
// reference to a pointer C lent; and for a class whose handles another keeps by a C reference (one
// with `retain:` and no `kept:`), `avin_c_keep_i`, which takes one for a holder, `avin_c_take_i` and
// `avin_c_drop_i`, which take and give back one. A holder keeping a handle by a C reference also
// takes one to everything that handle so holds, after it, so what the kept object needs outlives it
// whichever finalizer runs first: a face's library outlives the face, though the face's own handle
// is gone. A name `kept:` gives is the pointer of the one handle of its class the object holds a
// reference to.
private handle_glue(out: *StrBuilder, lines: *Buf[CUnitLine], handles: Buf[CUnitHandle])
    glue(out, lines, "struct avin_c_kept { void *pointer; void (*take)(void *); void (*drop)(void *); struct avin_c_kept *next; };", Plain)
    glue(out, lines, "static void avin_c_hold(void **o, void *p, void (*take)(void *), void (*drop)(void *)) { struct avin_c_kept *k = malloc(sizeof *k); struct avin_c_kept **at = (struct avin_c_kept **)&o[2]; if (!k) abort(); k->pointer = p; k->take = take; k->drop = drop; k->next = 0; while (*at) at = &(*at)->next; *at = k; }", Plain)
    glue(out, lines, "void avin_rt_c_callback_drop(void *record);", Plain)
    glue(out, lines, "void avin_rt_c_attach_destroy(void *data);", Plain)
    glue(out, lines, "void avin_rt_c_attach_drop(void *id);", Plain)
    glue(out, lines, "static void avin_c_hold_all(void **o, void **kept) { for (struct avin_c_kept *k = kept[2]; k; k = k->next) { if (k->drop == avin_rt_c_callback_drop) continue; k->take(k->pointer); avin_c_hold(o, k->pointer, k->take, k->drop); } }", Plain)
    glue(out, lines, "static void avin_c_no_take(void *p) { (void)p; }", Plain)
    glue(out, lines, "void avin_c_keep_callback(void **o, void *record) { avin_c_hold(o, record, avin_c_no_take, avin_rt_c_callback_drop); }", Plain)
    glue(out, lines, "static void *avin_c_held(void **o, void (*drop)(void *)) { for (struct avin_c_kept *k = o[2]; k; k = k->next) if (k->drop == drop) return k->pointer; return 0; }", Plain)
    glue(out, lines, "static void avin_c_drain(void **o) { struct avin_c_kept *k = o[2]; o[2] = 0; while (k) { struct avin_c_kept *next = k->next; k->drop(k->pointer); free(k); k = next; } }", Plain)
    for h in handles
        if kept_by_reference(h) then glue(out, lines, s"void avin_c_drop_${h.index}(void *p);", Plain)
    // Each type is checked first, by a name of the unit's own, which only the check uses: a
    // diagnostic of the glue names the types as the headers do.
    for i in 0..<handles.len()
        val h = handles[i]
        glue(out, lines, s"typedef ${h.ty} avin_c_type_${h.index};", GlueLine(i, "type"))
        if h.typedef then glue(out, lines, s"_Static_assert(__builtin_classify_type(*(avin_c_type_${h.index} *)0) == 5, \"avin: the C handle ${h.name}\");", GlueLine(i, "pointer"))
    for i in 0..<handles.len()
        val h = handles[i]
        val n = h.index
        val t = h.ty
        val release = c_call_text(h.release)
        if h.retain is Some(r)
            glue(out, lines, s"void avin_c_retain_$n(void *p, void *k) {", Plain)
            glue(out, lines, s"    $t self = ($t)p;", Plain)
            if h.kept is Some(k) then glue(out, lines, s"    ${k.ty} ${k.name} = (${k.ty})k;", GlueLine(i, "kept"))
            glue(out, lines, s"    (void)(${c_call_text(r)});", GlueLine(i, "retain"))
            glue(out, lines, "}", Plain)
        if kept_by_reference(h)
            glue(out, lines, s"void avin_c_drop_$n(void *p) {", Plain)
            glue(out, lines, s"    $t self = ($t)p;", Plain)
            glue(out, lines, s"    (void)($release);", GlueLine(i, "release"))
            glue(out, lines, "}", Plain)
            glue(out, lines, s"void avin_c_take_$n(void *p) { avin_c_retain_$n(p, 0); }", Plain)
            glue(out, lines, s"void avin_c_keep_$n(void **o, void *p, void **kept) { avin_c_take_$n(p); avin_c_hold(o, p, avin_c_take_$n, avin_c_drop_$n); avin_c_hold_all(o, kept); }", Plain)
        glue(out, lines, s"void avin_c_give_back_$n(void **o) {", Plain)
        glue(out, lines, "    if (o[0]) {", Plain)
        glue(out, lines, s"        $t self = ($t)o[0];", Plain)
        if h.kept is Some(k) then glue(out, lines, s"        ${k.ty} ${k.name} = (${k.ty})avin_c_held(o, avin_c_drop_${k.index});", GlueLine(i, "kept"))
        glue(out, lines, "        o[0] = 0;", Plain)
        // C is told to stop calling each callback the handle keeps before the object goes back.
        if h.forget is Some(f)
            glue(out, lines, "        for (struct avin_c_kept *k = o[2]; k; k = k->next) {", Plain)
            glue(out, lines, "            if (k->drop != avin_rt_c_callback_drop) continue;", Plain)
            glue(out, lines, "            void *userdata = k->pointer;", Plain)
            val forget = if is_c_identifier(f.trim()) then f.trim() + "(self, userdata)" else f
            glue(out, lines, s"            (void)($forget);", GlueLine(i, "forget"))
            glue(out, lines, "        }", Plain)
        glue(out, lines, s"        (void)($release);", GlueLine(i, "release"))
        glue(out, lines, "    }", Plain)
        glue(out, lines, "    avin_c_drain(o);", Plain)
        // The handle lets go of the record `attach:` gave C, which C holds until its own destroy.
        if h.attach is Some(_) then glue(out, lines, "    if (o[5]) { avin_rt_c_attach_drop(o[5]); o[5] = 0; }", Plain)
        glue(out, lines, "}", Plain)
        // `avin_c_attach_i` gives C the record numbered `data` through the class's `attach:`, keyed by
        // the address of a static object of the type `key:` names, and answers what it answers.
        if h.attach is Some(a)
            val key = h.key.unwrap_or("char")
            glue(out, lines, s"static $key avin_c_key_$n;", GlueLine(i, "key"))
            glue(out, lines, s"long long avin_c_attach_$n(void *p, long long avin_id) {", Plain)
            glue(out, lines, s"    $t self = ($t)p;", Plain)
            glue(out, lines, "    void *data = (void *)(__INTPTR_TYPE__)avin_id;", Plain)
            glue(out, lines, s"    $key *key = &avin_c_key_$n;", GlueLine(i, "key"))
            glue(out, lines, "    void (*destroy)(void *) = avin_rt_c_attach_destroy;", Plain)
            glue(out, lines, "    (void)key; (void)destroy;", Plain)
            glue(out, lines, s"    return (long long)($a);", GlueLine(i, "attach"))
            glue(out, lines, "}", Plain)
        glue(out, lines, s"void avin_c_finalize_$n(void *o, void *heap) { (void)heap; avin_c_give_back_$n((void **)o); }", Plain)
    // Each `as:` conversion, `avin_c_as_<class>_<entry>`, makes the other pointer from the handle's,
    // and passes null on as null; its type is checked to be the one the entry names.
    for i in 0..<handles.len()
        val h = handles[i]
        val n = h.index
        for j in 0..<h.conversions.len()
            val entry = h.conversions[j]
            val made = c_call_text(entry.expr)
            glue(out, lines, s"typedef ${entry.ty} avin_c_as_type_${n}_$j;", AsLine(i, j))
            glue(out, lines, s"void *avin_c_as_${n}_$j(void *avin_p) {", Plain)
            glue(out, lines, "    if (!avin_p) return 0;", Plain)
            glue(out, lines, s"    avin_c_type_$n self = (avin_c_type_$n)avin_p;", Plain)
            glue(out, lines, s"    _Static_assert(__builtin_types_compatible_p(__typeof__($made), avin_c_as_type_${n}_$j), \"avin: the conversion of ${h.name} to ${entry.ty}\");", AsLine(i, j))
            glue(out, lines, s"    return (void *)($made);", AsLine(i, j))
            glue(out, lines, "}", Plain)
    // Each field accessor names its field's type, `avin_c_field_type_<symbol>`, checks it is the kind
    // its Avin type needs, and reads or writes the field through `avin_c_field_get_<symbol>` or
    // `avin_c_field_set_<symbol>`, taking each index as a `long long`, whose bounds are answered by
    // `avin_c_field_bound<position>_<symbol>`.
    for i in 0..<handles.len()
        val h = handles[i]
        for j in 0..<h.fields.len()
            val f = h.fields[j]
            val t = s"avin_c_type_${h.index}"
            val ft = c_field_type_name(f.symbol)
            var indices = ""
            for name in f.indices
                indices = indices + s", long long $name"
            // The type is the field's at any index: an unevaluated operand reads no memory.
            glue(out, lines, s"typedef __typeof__((($t)0)->${c_replace_names(f.expr, f.indices, "0")}) $ft;", FieldLine(i, j, "field"))
            // A field lent as a view points at bytes one byte wide.
            val test = if f.length != "" then element_test(Byte, s"__typeof__(*($ft)0)") else f.handle match
                Some(k) -> s"__builtin_types_compatible_p($ft, avin_c_type_$k)"
                None -> kind_test(f.kind.unwrap(), ft)
            glue(out, lines, s"_Static_assert($test, \"avin: the field ${f.name}\");", FieldLine(i, j, "kind"))
            if f.length != ""
                // The view's length, a C expression in `self` and the indices.
                val length = c_field_glue(f.symbol, "length")
                glue(out, lines, s"long long $length(void *avin_p$indices) {", Plain)
                glue(out, lines, s"    $t self = ($t)avin_p;", Plain)
                glue(out, lines, s"    return (long long)(${f.length});", FieldLine(i, j, "length"))
                glue(out, lines, "}", Plain)
                // Memory lent `writable` is assigned through, which a `const` pointer refuses.
                if f.writable then glue(out, lines, s"void ${c_field_glue(f.symbol, "writable")}($ft avin_w) { *avin_w = *avin_w; }", FieldLine(i, j, "writable"))
            for b in 0..<f.bounds.len()
                val part = "bound" + b.to_string()
                val bound = c_field_glue(f.symbol, part)
                glue(out, lines, s"long long $bound(void *avin_p$indices) {", Plain)
                glue(out, lines, s"    $t self = ($t)avin_p;", Plain)
                glue(out, lines, s"    return (long long)(${f.bounds[b]});", FieldLine(i, j, part))
                glue(out, lines, "}", Plain)
            if f.writer
                val set = c_field_glue(f.symbol, "set")
                glue(out, lines, s"void $set(void *avin_p$indices, $ft avin_value) {", Plain)
                glue(out, lines, s"    $t self = ($t)avin_p;", Plain)
                glue(out, lines, s"    self->${f.expr} = avin_value;", FieldLine(i, j, "write"))
                glue(out, lines, "}", Plain)
            elif f.length != ""
                val get = c_field_glue(f.symbol, "get")
                glue(out, lines, s"void *$get(void *avin_p$indices) {", Plain)
                glue(out, lines, s"    $t self = ($t)avin_p;", Plain)
                glue(out, lines, s"    return (void *)self->${f.expr};", FieldLine(i, j, "field"))
                glue(out, lines, "}", Plain)
            else
                val get = c_field_glue(f.symbol, "get")
                glue(out, lines, s"$ft $get(void *avin_p$indices) {", Plain)
                glue(out, lines, s"    $t self = ($t)avin_p;", Plain)
                glue(out, lines, s"    return self->${f.expr};", FieldLine(i, j, "field"))
                glue(out, lines, "}", Plain)

// The glue a binding is called through, `avin_c_call_<symbol>`. A struct passed by value is passed to
// it as a pointer to the struct, and one answered by value is written through a pointer passed first;
// everything else is passed as the prototype says, so clang classifies each struct for the target.
// For an array C answers through an `out` pointer, the glue also writes the array's length, its
// `length:` evaluated after the call over the parameters and the out values by their names, through
// a pointer passed last; and `avin_c_array_free_<symbol>` frees the array, once copied, by its
// `free:`, where it is not null.
private binding_glue(out: *StrBuilder, lines: *Buf[CUnitLine], b: CUnitBinding, i: usize)
    val p = b.prototype
    val answered_by_value = b.by_value[0]
    var params = ""
    var args = ""
    var locals = ""
    if answered_by_value then params = s"${p.result_text} *avin_r"
    for k in 0..<p.params.len()
        val q = p.params[k]
        var param = ""
        var arg = ""
        if b.by_value[k + 1]
            param = s"${q.text} *avin_s$k"
            arg = s"*avin_s$k"
        elif !(q.mode is CIn)
            param = s"${q.text} avin_o$k"
            arg = s"avin_o$k"
            if q.name != "" then locals = locals + s" __typeof__(*avin_o$k) ${q.name} = *avin_o$k;"
        else
            val name = if q.name == "" then s"avin_a$k" else q.name
            param = s"${q.text} $name"
            arg = name
        params = params + (if params == "" then "" else ", ") + param
        args = args + (if args == "" then "" else ", ") + arg
    if b.array_out is Some(_) then params = params + (if params == "" then "" else ", ") + "long long *avin_length"
    if params == "" then params = "void"
    val returns = !answered_by_value && !(p.result is CVoidType)
    val result = if returns then p.result_text else "void"
    glue(out, lines, s"$result ${c_call_glue(b.symbol)}($params) {", BindingGlueLine(i, "call"))
    val call = s"${p.symbol}($args)"
    if answered_by_value then glue(out, lines, s"    *avin_r = $call;", BindingGlueLine(i, "call"))
    elif returns then glue(out, lines, s"    ${p.result_text} avin_v = $call;", BindingGlueLine(i, "call"))
    else glue(out, lines, s"    $call;", BindingGlueLine(i, "call"))
    if b.array_out is Some(a)
        glue(out, lines, s"   $locals", BindingGlueLine(i, "call"))
        glue(out, lines, s"    *avin_length = (long long)(${a.length});", BindingGlueLine(i, "length"))
    if returns then glue(out, lines, "    return avin_v;", BindingGlueLine(i, "call"))
    glue(out, lines, "}", BindingGlueLine(i, "call"))
    if b.array_out is Some(a)
        if a.view
            glue(out, lines, s"_Static_assert(${element_test(a.element, a.element_text)}, \"avin: the bytes ${b.name} lends\");", BindingGlueLine(i, "bytes"))
            return
        val name = p.params[a.param].name
        if c_array_element_size(a.element) > 0
            glue(out, lines, s"_Static_assert(${element_test(a.element, a.element_text)}, \"avin: the elements of the array ${b.name} answers\");", BindingGlueLine(i, "element"))
        glue(out, lines, s"void ${c_array_free_glue(b.symbol)}(${a.element_text} *$name) {", BindingGlueLine(i, "free"))
        a.free match
            Some(f) ->
                val freed = if is_c_identifier(f.trim()) then s"${f.trim()}((void *)$name)" else f
                glue(out, lines, s"    if ($name) { $freed; }", BindingGlueLine(i, "free"))
            None -> ()
        glue(out, lines, "}", BindingGlueLine(i, "free"))

// The checks of each struct mirror against its struct and of each opaque value's C type. A mirror's
// struct is a struct, and each field's C type the kind its Avin type asks for, or the struct another
// mirror mirrors; the fields come in the header's order, each at the offset C's alignment gives it
// after the one before, the first at zero and nothing after the last; and the mirror names every
// field, which an initializer of the struct by position, one value for each field, checks: one too
// few is an error here, so a field hidden in the padding between two others is found too. Each
// field's offset and the struct's size are measured in the table of values, as is each opaque value's
// size.
private struct_checks(out: *StrBuilder, lines: *Buf[CUnitLine], parts: CUnitParts)
    for i in 0..<parts.structs.len()
        val m = parts.structs[i]
        val own = c_struct_own(m.index)
        glue(out, lines, s"typedef ${m.ty} $own;", StructLine(i, 0, "type"))
        glue(out, lines, s"_Static_assert(__builtin_classify_type(*($own *)0) == 12, \"avin: the C struct mirror ${m.name}\");", StructLine(i, 0, "struct"))
        for j in 0..<m.fields.len()
            val f = m.fields[j]
            val name = c_struct_field_type(m.index, j)
            glue(out, lines, s"typedef __typeof__((($own *)0)->${f.c_name}) $name;", StructLine(i, j, "field"))
            f.kind match
                Some(kind) -> glue(out, lines, s"_Static_assert(${kind_test(kind, name)}, \"avin: the field ${f.name} of ${m.name}\");", StructLine(i, j, "kind"))
                None -> glue(out, lines, s"_Static_assert(__builtin_types_compatible_p($name, ${f.nested_ty}), \"avin: the field ${f.name} of ${m.name}\");", StructLine(i, j, "nested"))
            val offset = c_offset_expr(own, f.c_name)
            var wanted = "0"
            if j > 0
                val align = s"_Alignof($name)"
                wanted = s"(${c_offset_expr(own, m.fields[j - 1].c_name)} + sizeof(${c_struct_field_type(m.index, j - 1)}) + $align - 1) / $align * $align"
            glue(out, lines, s"_Static_assert($offset == $wanted, \"avin: the order of ${m.name}\");", StructLine(i, j, "order"))
        val n = m.fields.len()
        var end = "0"
        if n > 0 then end = s"(${c_offset_expr(own, m.fields[n - 1].c_name)} + sizeof(${c_struct_field_type(m.index, n - 1)}) + _Alignof($own) - 1) / _Alignof($own) * _Alignof($own)"
        glue(out, lines, s"_Static_assert(sizeof($own) == $end, \"avin: the fields of ${m.name}\");", StructLine(i, n, "size"))
        glue(out, lines, "#pragma clang diagnostic push", Plain)
        glue(out, lines, "#pragma clang diagnostic error \"-Wmissing-field-initializers\"", Plain)
        glue(out, lines, s"static const $own avin_c_struct_full_${m.index} = ${zero_initializer(parts.structs, i)};", StructLine(i, n, "full"))
        glue(out, lines, "#pragma clang diagnostic pop", Plain)
    for i in 0..<parts.values.len()
        val v = parts.values[i]
        val own = c_value_own(v.index)
        glue(out, lines, s"typedef ${v.ty} $own;", ValueTypeLine(i, "type"))
        glue(out, lines, s"_Static_assert(__builtin_classify_type(*($own *)0) == 12 || __builtin_classify_type(*($own *)0) == 13, \"avin: the opaque value ${v.name}\");", ValueTypeLine(i, "kind"))

// An initializer of the struct mirror `structs[i]`'s struct by position, a zero for each field and
// an initializer of its own for each field another mirror mirrors.
private zero_initializer(structs: Buf[CUnitStruct], i: usize) -> string
    var items = ""
    for f in structs[i].fields
        var item = "0"
        if f.nested is Some(e)
            for k in 0..<structs.len()
                if structs[k].index == e then item = zero_initializer(structs, k)
        items = items + (if items == "" then "" else ", ") + item
    if items == "" then "{ }" else "{ " + items + " }"

/** The packages of `libraries` in the order their headers are included: each after every package
 * whose handle classes its bindings name, and otherwise in the order the libraries are listed. A
 * cycle, which dependencies cannot make, leaves the rest in that order. */
header_order(bindings: Buf[CUnitBinding], libraries: Buf[CLibrary]) -> Buf[string]
    var listed: Buf[string] = buf()
    for library in libraries
        if !contains_text(listed, library.package) then listed.push(library.package)
    var placed: Buf[string] = buf()
    while placed.len() < listed.len()
        var next: Option[string] = None
        for p in listed
            if contains_text(placed, p) then continue
            var ready = true
            for b in bindings
                if b.package != p then continue
                for used in b.uses
                    if contains_text(listed, used) && !contains_text(placed, used) then ready = false
            if ready
                next = Some(p)
                break
        next match
            Some(p) -> placed.push(p)
            None ->
                for p in listed
                    if !contains_text(placed, p) then placed.push(p)
    placed

private glue(out: *StrBuilder, lines: *Buf[CUnitLine], text: string, line: CUnitLine)
    out.push(text + "\n")
    lines.push(line)

// The values: each enum mirror's C type checked to be an integer type, each constant and enumerator
// checked to be the kind its Avin type asks for, an integer, a floating-point or integer value, or a
// string literal, and then one packed struct holding the marker, the count and each value in order: an
// integer as a `long long` and a byte saying whether it is negative, a `real` as a `double`, and a
// string as its length, a `long long`, and its bytes with the NUL after them. The driver reads the
// struct out of the object as the measurements are, in the target's byte order, which is little-endian
// on every target Avin builds for.
private value_table(out: *StrBuilder, lines: *Buf[CUnitLine], parts: CUnitParts) -> Buf[CValueEntry]
    var entries: Buf[CValueEntry] = buf()
    var keys: Buf[string] = buf()
    for i in 0..<parts.enums.len()
        val e = parts.enums[i]
        glue(out, lines, s"typedef ${e.ty} avin_c_enum_type_$i;", EnumLine(i, "type"))
        glue(out, lines, s"_Static_assert(__builtin_classify_type(*(avin_c_enum_type_$i *)0) == 1, \"avin: the C enum mirror ${e.name}\");", EnumLine(i, "kind"))
        for v in 0..<e.enumerators.len()
            val key = c_value_key(CConstInteger, e.enumerators[v])
            if contains_text(keys, key) then continue
            keys.push(key)
            entries.push(CValueEntry(key, CConstInteger, e.enumerators[v], None, Some(i), v, false))
    for i in 0..<parts.constants.len()
        val k = parts.constants[i]
        val key = c_value_key(k.kind, k.constant)
        if contains_text(keys, key) then continue
        keys.push(key)
        entries.push(CValueEntry(key, k.kind, k.constant, Some(i), None, 0, false))
    // Each struct mirror's size and its fields' offsets, and each opaque value's size.
    var layouts: Buf[string] = buf()
    for m in parts.structs
        layouts.push(c_size_expr(c_struct_own(m.index)))
        for f in m.fields
            layouts.push(c_offset_expr(c_struct_own(m.index), f.c_name))
    for v in parts.values
        layouts.push(c_size_expr(c_value_own(v.index)))
    for x in layouts
        val key = c_value_key(CConstInteger, x)
        if contains_text(keys, key) then continue
        keys.push(key)
        entries.push(CValueEntry(key, CConstInteger, x, None, None, 0, true))
    for j in 0..<entries.len()
        val x = entries[j].expr
        val class = s"__builtin_classify_type($x)"
        val test = entries[j].kind match
            CConstInteger -> s"$class == 1"
            CConstReal -> s"$class == 8 || $class == 1"
            CConstString -> s"__builtin_types_compatible_p(__typeof__($x), char[sizeof($x)])"
        glue(out, lines, s"_Static_assert($test, \"avin: the C constant $x\");", ValueLine(j, "kind"))
    glue(out, lines, "struct __attribute__((packed)) avin_c_unit_values {", Plain)
    glue(out, lines, s"    unsigned char marker[${ValueMarker.bytes.len}];", Plain)
    glue(out, lines, "    unsigned char count[2];", Plain)
    for j in 0..<entries.len()
        val x = entries[j].expr
        val member = entries[j].kind match
            CConstInteger -> s"    long long v$j; unsigned char n$j;"
            CConstReal -> s"    double v$j;"
            CConstString -> s"    long long v$j; char s$j[sizeof($x)];"
        glue(out, lines, member, ValueLine(j, "value"))
    glue(out, lines, "};", Plain)
    glue(out, lines, "__attribute__((used)) const struct avin_c_unit_values avin_c_unit_values = {", Plain)
    var marker = "    {"
    for byte in ValueMarker.bytes
        marker = marker + s" $byte,"
    glue(out, lines, marker + " },", Plain)
    glue(out, lines, s"    { ${entries.len() % 256}, ${entries.len() / 256} },", Plain)
    for j in 0..<entries.len()
        val x = entries[j].expr
        val value = entries[j].kind match
            CConstInteger -> s"    (long long)($x), ($x) < 0,"
            CConstReal -> s"    (double)($x),"
            CConstString -> s"    (long long)sizeof($x) - 1, $x,"
        glue(out, lines, value, ValueLine(j, "value"))
    glue(out, lines, "};", Plain)
    entries

/** What the table of values begins with, which finds it among the object's bytes. */
const ValueMarker: string = "avin.c-unit.values:"

/** The values in a C unit's object, by key, or `None` where the object holds no table of
 * `entries.len()` values. */
read_values(bytes: []const u8, entries: Buf[CValueEntry]) -> Option[Map[string, CValue]]
    val marker = ValueMarker.bytes
    var at: Option[usize] = None
    var i = 0usize
    while i + marker.len <= bytes.len
        var same = true
        for k in 0..<marker.len
            if bytes[i + k] != marker[k]
                same = false
                break
        if same
            at = Some(i + marker.len)
            break
        i += 1
    var p = at?
    if p + 2 > bytes.len then return None
    val count = usize(bytes[p]) + usize(bytes[p + 1]) * 256
    if count != entries.len() then return None
    p += 2
    var out: Map[string, CValue] = map()
    for e in entries
        if p + 8 > bytes.len then return None
        var word = 0u64
        for k in 0..<8usize
            word = word | (u64(bytes[p + k]) << u64(8 * k))
        p += 8
        e.kind match
            CConstInteger ->
                if p + 1 > bytes.len then return None
                // The word's top bit is the sign of the `long long`.
                val high = 9223372036854775808u64
                val value = if word < high then i64(word) else i64(word - high) + (-9223372036854775807i64 - 1i64)
                out.put(e.key, CValue(value, bytes[p] != 0u8, 0.0, None))
                p += 1
            CConstReal -> out.put(e.key, CValue(0i64, false, real.from_bits(word), None))
            CConstString ->
                val length = usize(word)
                if p + length + 1 > bytes.len then return None
                val text = from_utf8(bytes[p..<p + length]) match
                    Ok(t) -> Some(t)
                    Err(_) -> None
                out.put(e.key, CValue(0i64, false, 0.0, text))
                p += length + 1
    Some(out)

/** Whether a holder keeps a handle of `h`'s class by a C reference of its own: the class declares
 * `retain:`, and no `kept:`, whose names only its own object holds. */
kept_by_reference(h: CUnitHandle) -> bool = h.retain is Some(_) && h.kept is None

// A `release:` or `retain:` as the C expression it compiles to: a function's name is called with the
// handle's pointer.
private c_call_text(text: string) -> string = if is_c_identifier(text.trim()) then text.trim() + "(self)" else text

private c_spelling(c: CType) -> string = c match
    CKeyword(n) -> n
    CTypedef(n) -> n
    _ -> ""

private kind_tag(kind: CKind) -> string = kind match
    KindInteger -> "integer"
    KindByte -> "byte"
    KindBool -> "bool"
    KindReal -> "real"
    KindText -> "text"
    KindConstText -> "const text"

// The constant expression that holds where the typedef `name` is the kind `kind` asks for, by the
// class of type clang gives it: 1 an integer or enumeration, 4 a bool, 8 a floating-point type; a
// string is one of the two pointers to `char`.
private kind_test(kind: CKind, name: string) -> string
    val class = s"__builtin_classify_type(*($name *)0)"
    val constant = s"__builtin_types_compatible_p($name, const char *)"
    kind match
        KindInteger -> s"$class == 1"
        KindByte -> s"$class == 1 && sizeof($name) == 1"
        KindBool -> s"$class == 4 || $class == 1"
        KindReal -> s"$class == 8"
        KindText -> s"__builtin_types_compatible_p($name, char *) || $constant"
        KindConstText -> constant

// The constant expression that holds where the C type `e` holds the elements of an Avin array of
// `element` as they are: an integer type of its size, signed for an `int` or a `long`, or a
// floating-point type eight bytes wide for a `real`.
private element_test(element: &Type, e: string) -> string
    val class = s"__builtin_classify_type(*($e *)0)"
    val size = c_array_element_size(element)
    if *element is Real then return s"$class == 8 && sizeof($e) == 8"
    val signed = if *element is Byte then "" else s" && ($e)-1 < ($e)0"
    s"$class == 1 && sizeof($e) == $size$signed"

// What the elements of an Avin array of `element` are in C, as a diagnostic says it.
private element_text(element: &Type) -> string = *element match
    Byte -> "an integer type one byte wide"
    Real -> "a floating-point type eight bytes wide"
    _ -> s"a signed integer type ${c_array_element_size(element)} bytes wide"

private contains_text(xs: Buf[string], x: string) -> bool
    for y in xs
        if y == x then return true
    false

// Compiles the C unit into `object`, published by rename, or renders why it did not compile.
private compile_c_unit(tc: Toolchain, unit: CUnitSource, cflags: Buf[string], object: string, parts: CUnitParts, libraries: Buf[CLibrary], sources: Buf[Source]) -> Result[unit, string]
    make_dir_all(tc.c_unit_cache()).map_err(e -> s"avin: ${tc.c_unit_cache()}: ${e.to_string()}\n")?
    val dir = make_temp_dir("avin-c-unit").map_err(e -> s"avin: ${e.to_string()}\n")?
    defer _ = remove_dir_all(dir)
    val file = dir + "/" + CUnitFile
    write_text(file, unit.text).map_err(e -> s"avin: $file: ${e.to_string()}\n")?
    val pending = pending_name(object)
    defer _ = remove_file(pending)
    var args: Buf[string] = buf()
    for a in ["-c", "-x", "c", "-fno-color-diagnostics", file, "-o", pending]
        args.push(a)
    for f in cflags
        args.push(f)
    val result = capture(tc.clang, args.view(), stderr = true, timeout = 120000).map_err(e -> "avin: " + missing_tool(tc.clang, e.to_string()) + "\n")?
    if !result.status.ok() then return Err(c_unit_diagnostics_of(result.err.unwrap_or("") + result.text, unit, parts, libraries, sources))
    publish_file(pending, object).map_err(e -> s"avin: $object: ${e.to_string()}\n")?
    Ok(())

/** What one binding's diagnostics from the C unit said. */
private struct BindingTrouble
    declared: string
    written: string
    undeclared: bool
    header: string
    other: string
    /** The typedefs found the wrong kind, and what each diagnostic says of one. */
    kind_names: Buf[string]
    kinds: Buf[string]
    /** What is wrong with the function its `free:` names. */
    frees: Buf[string]
    /** What its glue said, one message for each part of it. */
    glue_parts: Buf[string]
    glue: Buf[string]

/** Clang's diagnostics of the C unit `unit`, placed back at the bindings and the libraries they came
 * from; anything clang said that no line of the unit accounts for is passed on as it was. */
c_unit_diagnostics(output: string, unit: CUnitSource, bindings: Buf[CUnitBinding], handles: Buf[CUnitHandle], libraries: Buf[CLibrary], sources: Buf[Source]) -> string = c_unit_diagnostics_of(output, unit, CUnitParts(bindings, handles, buf(), buf(), buf(), buf()), libraries, sources)

/** Clang's diagnostics of the C unit of `parts`, as `c_unit_diagnostics` places them, with those of
 * the enum mirrors and the constants placed at each. */
c_unit_diagnostics_of(output: string, unit: CUnitSource, parts: CUnitParts, libraries: Buf[CLibrary], sources: Buf[Source]) -> string
    val bindings = parts.bindings
    val handles = parts.handles
    // What each enum mirror's check and each value's measurement said: one message each.
    var enum_said: Buf[bool] = buf()
    for _ in parts.enums
        enum_said.push(false)
    var value_said: Buf[bool] = buf()
    for _ in unit.values
        value_said.push(false)
    var values_text = ""
    // What each struct mirror's checks said, by field or by the whole, and each opaque value's.
    var struct_said: Buf[Buf[string]] = buf()
    for _ in parts.structs
        struct_said.push(buf())
    var value_type_said: Buf[bool] = buf()
    for _ in parts.values
        value_type_said.push(false)
    var structs_text = ""
    var troubles: Buf[BindingTrouble] = buf()
    for _ in bindings
        troubles.push(BindingTrouble("", "", false, "", "", buf(), buf(), buf(), buf(), buf()))
    // What each handle's glue said, one message for each part of its `@c`.
    var glue_parts: Buf[Buf[string]] = buf()
    var glue_messages: Buf[Buf[string]] = buf()
    for _ in handles
        glue_parts.push(buf())
        glue_messages.push(buf())
    var unplaced = ""
    var libraries_text = ""
    // What the field accessors' glue said, placed at each accessor.
    var fields_text = ""
    var placed_any = false
    // The binding whose declaration conflicted with the header's last, whose note names the header.
    var conflicting: Option[usize] = None
    for text in output.split("\n")
        val d = c_diagnostic(text) match
            Some(d) -> d
            None -> continue
        if d.severity == "note"
            if conflicting is Some(i) && d.message.starts_with("previous declaration is here") && troubles[i].header == ""
                troubles[i].header = header_named(d.file, libraries)
            continue
        conflicting = None
        if !d.file.ends_with("/" + CUnitFile) || d.line >= unit.lines.len()
            unplaced = unplaced + text + "\n"
            continue
        unit.lines[d.line] match
            IncludeLine(k, header) ->
                val library = libraries[k]
                val tail = if library.install == "" then "" else " " + library.install
                // A header named by a macro no earlier header defines is no header at all.
                if is_c_identifier(header) && d.message.contains("\"FILENAME\" or <FILENAME>")
                    libraries_text = libraries_text + s"error: the header `$header` of the C library `${library.label}` of package `${library.package}` is not a macro any earlier header defines: clang says '${d.message}'\n"
                else libraries_text = libraries_text + s"error: the header `$header` of the C library `${library.label}` of package `${library.package}` was not found: ${d.message}.$tail\n"
                placed_any = true
            GlueLine(i, part) ->
                placed_any = true
                // A type the headers do not declare makes every later line of its glue wrong too.
                if contains_text(glue_parts[i], part) || contains_text(glue_parts[i], "type") || contains_text(glue_parts[i], "pointer") then continue
                glue_parts[i].push(part)
                val h = handles[i]
                var m = s"the `$part:` of the C handle `${h.name}` does not compile against its headers: clang says '${d.message}'"
                if part == "type" then m = s"the C handle `${h.name}` is on `${h.ty}`, which its headers do not declare as a type: clang says '${d.message}'"
                elif part == "pointer" then m = s"the C handle `${h.name}` is on `${h.ty}`, which is not a pointer in its headers"
                glue_messages[i].push(m)
            AsLine(i, j) ->
                placed_any = true
                val key = "as " + j.to_string()
                if contains_text(glue_parts[i], key) || contains_text(glue_parts[i], "type") || contains_text(glue_parts[i], "pointer") then continue
                glue_parts[i].push(key)
                val h = handles[i]
                val entry = h.conversions[j]
                if d.message.starts_with("static assertion failed")
                    glue_messages[i].push(s"the `as:` conversion of the C handle `${h.name}` to `${entry.ty}` makes another type: `${c_call_text(entry.expr)}` is not a `${entry.ty}` in its headers")
                else glue_messages[i].push(s"the `as:` conversion of the C handle `${h.name}` to `${entry.ty}` does not compile against its headers: clang says '${d.message}'")
            FieldLine(i, j, part) ->
                placed_any = true
                val key = "field " + j.to_string()
                if contains_text(glue_parts[i], key) || contains_text(glue_parts[i], "type") || contains_text(glue_parts[i], "pointer") then continue
                glue_parts[i].push(key)
                val h = handles[i]
                val f = h.fields[j]
                val verb = if f.writer then "write" else "read"
                var m = s"the field `${f.expr}` of the C handle `${h.name}`, which `${f.name}` ${verb}s, does not compile against its headers: clang says '${d.message}'"
                if part == "kind" && f.length != ""
                    m = s"the field `${f.expr}` of the C handle `${h.name}` is not a pointer to an integer type one byte wide in the headers, so `${f.name}` cannot lend the memory it points at as `${type_name(f.avin)}`"
                elif part == "length" then m = s"the field accessor `${f.name}` gives the length of the memory `${f.expr}` points at as `${f.length}`, which does not compile against the headers of the C handle `${h.name}`: clang says '${d.message}'"
                elif part == "writable" then m = s"the field `${f.expr}` of the C handle `${h.name}` points at `const` memory in the headers, so `${f.name}` cannot lend it `writable`"
                elif part == "kind"
                    var what = ""
                    f.handle match
                        Some(k) ->
                            for other in handles
                                if other.index == k then what = s"`${other.ty}`, the C type of `${other.name}`"
                        None -> what = field_kind_text(f.kind.unwrap())
                    m = s"the field `${f.expr}` of the C handle `${h.name}` is not $what in the headers, so `${f.name}` cannot $verb it as `${type_name(f.avin)}`"
                elif part == "write" then m = s"the field `${f.expr}` of the C handle `${h.name}` cannot be written by `${f.name}`: clang says '${d.message}'"
                elif part.starts_with("bound")
                    var position = 0usize
                    for x in part[5..].bytes
                        position = position * 10 + usize(x - u8('0'))
                    val b = f.bounds[position]
                    m =s"the `bound:` `$b` of the field accessor `${f.name}` does not compile against the headers of the C handle `${h.name}`: clang says '${d.message}'"
                var r = report()
                r.add(error(f.span, m))
                fields_text = fields_text + r.render(sources[f.unit])
            AssertLine(i) ->
                placed_any = true
                val requirement = "static assertion failed due to requirement '__builtin_types_compatible_p("
                if d.message.starts_with(requirement)
                    val inner = d.message[requirement.bytes.len..]
                    val end = inner.index_of(")':") match
                        Some(e) -> e
                        None -> inner.bytes.len
                    val pair = split_top_level(inner[..<end])
                    // The pointer's diagnostic, where clang gives one, names the typedefs.
                    if pair.len() == 2 && troubles[i].declared == ""
                        troubles[i].declared = function_type_text(pair[0])
                        troubles[i].written = function_type_text(pair[1])
                elif d.message.starts_with("use of undeclared identifier") then troubles[i].undeclared = true
                elif troubles[i].other == "" then troubles[i].other = d.message
            PointerLine(i) ->
                placed_any = true
                val initializing = "incompatible function pointer types initializing '"
                val expression = " with an expression of type '"
                if d.message.starts_with(initializing) && d.message.contains(expression)
                    val rest = d.message[initializing.bytes.len..]
                    val parts = rest.split(expression)
                    troubles[i].written = function_type_text(before_quote(parts[0]))
                    troubles[i].declared = function_type_text(before_quote(parts[1]))
            DeclareLine(i) ->
                placed_any = true
                if d.message.starts_with("conflicting types for") then conflicting = Some(i)
                elif troubles[i].other == "" then troubles[i].other = d.message
            KindLine(i, position, name, kind) ->
                placed_any = true
                val where = if position == 0 then "the result" else s"parameter $position"
                val avin = if position == 0 then bindings[i].result else bindings[i].params[position - 1]
                val what = field_kind_text(kind)
                // A type the headers do not declare at all is reported by the header check.
                if d.message.starts_with("static assertion failed") && !contains_text(troubles[i].kind_names, name)
                    troubles[i].kind_names.push(name)
                    troubles[i].kinds.push(s"the C type `$name` of $where is not $what in the headers, so it cannot cross as `${type_name(avin)}`")
            ElementLine(i, position) ->
                placed_any = true
                val q = bindings[i].prototype.params[position - 1]
                val element = bindings[i].params[position - 1]
                var block = false
                for k in bindings[i].blocks
                    if k == position - 1 then block = true
                // A type the headers do not declare at all is reported by the header check.
                if !d.message.starts_with("static assertion failed") then ()
                elif block then troubles[i].kinds.push(s"parameter $position of `${bindings[i].name}`, `${q.text}`, is not a pointer to an integer type one byte wide in the headers, so a `ByteBlock` cannot be passed to it")
                else
                    troubles[i].kinds.push(s"the C type `${q.pointee_text}` parameter $position points at is not ${element_text(element)} in the headers, so it cannot hold the elements of an `Array[${type_name(element)}]` as they are")
            CallbackBytesLine(i, k, name) ->
                placed_any = true
                val q = bindings[i].prototype.params[k]
                troubles[i].kinds.push(s"the function `${bindings[i].name}` passes for `${q.name}` is lent the memory `$name` points at as a view, and `$name` is not a pointer to an integer type one byte wide in the headers")
            FreeLine(i, name) ->
                placed_any = true
                if troubles[i].frees.len() > 0 then continue
                if d.message.starts_with("use of undeclared identifier")
                    troubles[i].frees.push(s"the C binding `${bindings[i].name}` frees its result with `$name`, which no header of its package declares")
                elif d.message.starts_with("static assertion failed")
                    troubles[i].frees.push(s"the C binding `${bindings[i].name}` frees its result with `$name`, which the headers do not declare as a function taking the string and answering nothing, `void $name(void *)` or `void $name(char *)`")
            EnumLine(i, part) ->
                placed_any = true
                if enum_said[i] then continue
                enum_said[i] = true
                val e = parts.enums[i]
                val m = if part == "kind" then s"the C enum mirror `${e.name}` mirrors `${e.ty}`, which is not an enumeration or an integer type in its headers" else s"the C enum mirror `${e.name}` mirrors `${e.ty}`, which its headers do not declare as a type: clang says '${d.message}'"
                var r = report()
                r.add(error(e.span, m))
                values_text = values_text + r.render(sources[e.unit])
            ValueLine(j, part) ->
                placed_any = true
                if value_said[j] then continue
                value_said[j] = true
                val entry = unit.values[j]
                // A struct's size or a field's offset fails where its check before it does.
                if entry.layout then continue
                val undeclared = d.message.starts_with("use of undeclared identifier")
                var m = ""
                var span = Span(0, 0)
                var at_unit = 0usize
                entry.constant match
                    Some(k) ->
                        val c = parts.constants[k]
                        span = c.span
                        at_unit = c.unit
                        val what = c.kind match
                            CConstInteger -> "an integer"
                            CConstReal -> "a number"
                            CConstString -> "a string literal"
                        if undeclared then m = s"the C constant `${c.constant}` of `${c.name}` is not defined by any header of its package"
                        elif part == "kind" && d.message.starts_with("static assertion failed") then m = s"the C constant `${c.constant}` is not $what in its headers, so `${c.name}` cannot be `${type_name(c.avin)}`"
                        else m = s"the C constant `${c.constant}` of `${c.name}` is not a constant its headers define: clang says '${d.message}'"
                    None ->
                        // A mirror whose type the headers do not declare is reported once, at the
                        // mirror, and not again at each of its variants.
                        if enum_said[entry.mirror.unwrap()] then continue
                        val e = parts.enums[entry.mirror.unwrap()]
                        val v = entry.variant
                        span = e.variant_spans[v]
                        at_unit = e.unit
                        val enumerator = e.enumerators[v]
                        if undeclared
                            m = s"the variant `${e.variants[v]}` of the C enum mirror `${e.name}` mirrors `$enumerator`, which no header of its package declares"
                            if !e.named[v] then m = m + s"; a variant whose enumerator is not the prefix and its words names it with `@c(\"<enumerator>\")` before the variant"
                        elif part == "kind" && d.message.starts_with("static assertion failed") then m = s"the variant `${e.variants[v]}` of the C enum mirror `${e.name}` mirrors `$enumerator`, which is not an integer constant in its headers"
                        else m = s"the variant `${e.variants[v]}` of the C enum mirror `${e.name}` mirrors `$enumerator`, which does not compile against its headers: clang says '${d.message}'"
                var r = report()
                r.add(error(span, m))
                values_text = values_text + r.render(sources[at_unit])
            BindingGlueLine(i, part) ->
                placed_any = true
                if contains_text(troubles[i].glue_parts, part) then continue
                troubles[i].glue_parts.push(part)
                val b = bindings[i]
                val a = b.array_out
                val array = a match
                    Some(x) -> if x.param < b.prototype.params.len() then b.prototype.params[x.param].name else ""
                    None -> ""
                val lent = if array == "" then "the memory its result points at" else s"the memory `$array` points at"
                if part == "bytes" then troubles[i].kinds.push(s"the C binding `${b.name}` lends $lent as a view, and its bytes are not of an integer type one byte wide in the headers")
                elif part == "length" && a.unwrap().view then troubles[i].glue.push(s"the C binding `${b.name}` gives the length of $lent as `${a.unwrap().length}`, which does not compile against its headers: clang says '${d.message}'")
                elif part == "length" then troubles[i].glue.push(s"the C binding `${b.name}` gives the length of the array `$array` as `${a.unwrap().length}`, which does not compile against its headers: clang says '${d.message}'")
                elif part == "free" then troubles[i].glue.push(s"the C binding `${b.name}` frees the array `$array` with `${a.unwrap().free.unwrap_or("")}`, which does not compile against its headers: clang says '${d.message}'")
                elif part == "element" then troubles[i].kinds.push(s"the C type `${a.unwrap().element_text}` the array `$array` points at is not ${element_text(a.unwrap().element)} in the headers, so it cannot hold the elements of an `Array[${type_name(a.unwrap().element)}]` as they are")
                else troubles[i].glue.push(s"the C binding `${b.name}` cannot be called through its glue: clang says '${d.message}'")
            StructLine(i, j, part) ->
                placed_any = true
                val m = parts.structs[i]
                val whole = part == "size" || part == "full" || part == "type" || part == "struct"
                val key = if whole then part else s"field $j"
                if contains_text(struct_said[i], "type") || contains_text(struct_said[i], "struct") || contains_text(struct_said[i], key) then continue
                // A field that does not compile makes the order of the next one fail too, and a
                // misplaced field the size.
                if part == "order" && j > 0 && contains_text(struct_said[i], s"field ${j - 1}") then continue
                if (part == "size" || part == "full") && struct_said[i].len() > 0 then continue
                struct_said[i].push(key)
                var msg = ""
                if part == "type" then msg = s"the C struct mirror `${m.name}` mirrors `${m.ty}`, which its headers do not declare as a type: clang says '${d.message}'"
                elif part == "struct" then msg = s"the C struct mirror `${m.name}` mirrors `${m.ty}`, which is not a struct in its headers"
                elif part == "size"
                    msg = if m.fields.len() == 0 then s"`${m.ty}` has fields in its headers, and the C struct mirror `${m.name}` mirrors none: a struct mirror mirrors every field of its struct" else s"`${m.ty}` has fields after `${m.fields[m.fields.len() - 1].c_name}` in its headers that the C struct mirror `${m.name}` does not mirror: a struct mirror mirrors every field of its struct"
                elif part == "full" then msg = s"`${m.ty}` has a field in its headers that the C struct mirror `${m.name}` does not mirror, in the padding between two it does: a struct mirror mirrors every field of its struct"
                else
                    val f = m.fields[j]
                    if d.message.contains("bit-field") then msg = s"the field `${f.c_name}` of `${m.ty}` is a bit-field, which no mirror holds: a struct with one crosses as an opaque value, a class declared `@c(value: \"${m.ty}\")`"
                    elif part == "field"
                        msg = s"the field `${f.name}` of the C struct mirror `${m.name}` mirrors `${f.c_name}`, which is not a field of `${m.ty}` in its headers"
                        if !f.named then msg = msg + s"; a field whose C name is not its words in snake_case names it with `@c(\"<name>\")` before the field"
                    elif part == "kind" then msg = s"the field `${f.c_name}` of `${m.ty}` is not ${field_kind_text(f.kind.unwrap())} in the headers, so the field `${f.name}` of the C struct mirror `${m.name}` cannot be `${type_name(f.avin)}`"
                    elif part == "nested" then msg = s"the field `${f.c_name}` of `${m.ty}` is not `${f.nested_ty}` in the headers, so the field `${f.name}` of the C struct mirror `${m.name}` cannot be `${type_name(f.avin)}`, which mirrors it"
                    elif j == 0 then msg = s"the field `${f.c_name}` is not the first field of `${m.ty}` in its headers: a struct mirror lists its struct's fields in the header's order"
                    else msg = s"the field `${f.c_name}` of `${m.ty}` does not follow `${m.fields[j - 1].c_name}` in its headers: a struct mirror lists its struct's fields in the header's order"
                var r = report()
                r.add(error(if whole then m.span else m.fields[j].span, msg))
                structs_text = structs_text + r.render(sources[m.unit])
            ValueTypeLine(i, part) ->
                placed_any = true
                if value_type_said[i] then continue
                value_type_said[i] = true
                val v = parts.values[i]
                val msg = if part == "kind" then s"the opaque value `${v.name}` holds a copy of `${v.ty}`, which is not a struct or a union in its headers: a scalar crosses as itself" else s"the opaque value `${v.name}` holds a copy of `${v.ty}`, which its headers do not declare as a type: clang says '${d.message}'"
                var r = report()
                r.add(error(v.span, msg))
                structs_text = structs_text + r.render(sources[v.unit])
            Plain -> unplaced = unplaced + text + "\n"
    var rendered = libraries_text + values_text + structs_text
    for i in 0..<handles.len()
        if glue_messages[i].len() == 0 then continue
        var r = report()
        for m in glue_messages[i]
            r.add(error(handles[i].span, m))
        rendered = rendered + r.render(sources[handles[i].unit])
    rendered = rendered + fields_text
    for i in 0..<bindings.len()
        val b = bindings[i]
        val t = troubles[i]
        val symbol = b.prototype.symbol
        var messages: Buf[string] = buf()
        if t.undeclared
            var names = ""
            for library in libraries
                if library.package != b.package then continue
                for h in library.headers
                    names = names + (if names == "" then "" else ", ") + h
            messages.push(s"the C binding `${b.name}` names `$symbol`, which no header of its package declares: $names")
        elif t.declared != ""
            val place = if t.header == "" then "" else " in " + t.header
            messages.push(s"the C binding `${b.name}` does not match `$symbol`$place: the header declares '${t.declared}', but the binding says '${t.written}'")
        elif t.other != "" then messages.push(s"the C binding `${b.name}` does not compile against its headers: ${t.other}")
        for k in t.kinds
            messages.push(s"the C binding `${b.name}` does not fit its headers: $k")
        for m in t.frees
            messages.push(m)
        // A call the header check already refuses does not compile in its glue either.
        for m in t.glue
            if messages.len() == 0 || !m.contains("cannot be called through its glue") then messages.push(m)
        if messages.len() == 0 then continue
        var r = report()
        for m in messages
            r.add(error(b.span, m))
        rendered = rendered + r.render(sources[b.unit])
    if !placed_any || (rendered == "" && unplaced != "") then return "avin: the C unit did not compile:\n" + output
    rendered

// What a C type checked as `kind` must be, as a diagnostic says it.
private field_kind_text(kind: CKind) -> string = kind match
    KindInteger -> "an integer type"
    KindByte -> "an integer type one byte wide"
    KindBool -> "a bool or an integer type"
    KindReal -> "a floating-point type"
    KindText -> "`char *` or `const char *`"
    KindConstText -> "`const char *`"

/** One diagnostic line of clang's: the file, line and severity, and the message. */
private struct CDiagnostic
    file: string
    line: usize
    severity: string
    message: string

private c_diagnostic(text: string) -> Option[CDiagnostic]
    for severity in ["fatal error", "error", "note", "warning"]
        val marker = ": " + severity + ": "
        val at = text.index_of(marker) match
            Some(a) -> a
            None -> continue
        // `file:line:col` before the marker.
        val place = text[..<at].split(":")
        if place.len < 3 then return None
        var line = 0usize
        for b in place[place.len - 2].bytes
            if b < u8('0') || b > u8('9') then return None
            line = line * 10 + usize(b - u8('0'))
        var file = ""
        for i in 0..<place.len - 2
            file = if i == 0 then place[i] else file + ":" + place[i]
        return Some(CDiagnostic(file, line, if severity == "fatal error" then "error" else severity, text[at + marker.bytes.len..]))
    None

// The two types of `a, b`, split at the comma outside every parenthesis.
private split_top_level(text: string) -> Buf[string]
    var out: Buf[string] = buf()
    var depth = 0
    var from = 0usize
    for i in 0..<text.bytes.len
        val b = text.bytes[i]
        if b == u8('(') then depth += 1
        elif b == u8(')') then depth -= 1
        elif b == u8(',') && depth == 0
            out.push(text[from..<i].trim())
            from = i + 1
    out.push(text[from..].trim())
    out

// A pointer to a function type as clang writes it, `int (*)(long)`, as the function type,
// `int (long)`.
private function_type_text(pointer: string) -> string = pointer.replace_all("(*const)", "").replace_all("(*)", "").replace_all("  ", " ")

// What a diagnostic quotes, up to the quote that ends it.
private before_quote(text: string) -> string = text.index_of("'") match
    Some(end) -> text[..<end]
    None -> text

// The header a diagnostic's file is, as the manifest wrote it when it is one of `libraries`', and
// otherwise as the file's path from its include directory.
private header_named(file: string, libraries: Buf[CLibrary]) -> string
    for library in libraries
        for h in library.headers
            val bare = if h.starts_with("<") || h.starts_with("\"") then h[1..<h.bytes.len - 1] else h
            if file == bare || file.ends_with("/" + bare) then return h
    val parts = file.split("/include/")
    if parts.len > 1 then return parts[parts.len - 1]
    val names = file.split("/")
    names[names.len - 1]

/** The measurements in a C unit's object, by key, or `None` where the object holds no table of
 * `keys.len()` entries. */
read_measures(bytes: []const u8, keys: Buf[string]) -> Option[Map[string, CMeasure]]
    val marker = MeasureMarker.bytes
    var at: Option[usize] = None
    var i = 0usize
    while i + marker.len <= bytes.len
        var same = true
        for k in 0..<marker.len
            if bytes[i + k] != marker[k]
                same = false
                break
        if same
            at = Some(i + marker.len)
            break
        i += 1
    val start = at?
    if start + 2 > bytes.len then return None
    val count = usize(bytes[start]) + usize(bytes[start + 1]) * 256
    if count != keys.len() || start + 2 + 2 * count > bytes.len then return None
    var out: Map[string, CMeasure] = map()
    for j in 0..<count
        val size = u32(bytes[start + 2 + 2 * j])
        val signed = bytes[start + 3 + 2 * j] != 0u8
        out.put(keys[j], CMeasure(size * 8, signed))
    Some(out)
