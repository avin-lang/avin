module dev.avinlang.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}

// Polymorphic recursion: a generic function, method or type whose instances need instances at ever
// larger type arguments, as `depth[T]` calling `depth(Nest(x), n - 1)` needs `depth[Nest[T]]`, then
// `depth[Nest[Nest[T]]]`, and so on. Generics are compiled once per list of type arguments, so such
// code has no finite set of copies, and it is rejected where it is checked.
//
// The check follows how type arguments flow. Every type parameter of a generic function, method,
// data type or class is a node. An edge from `P` to `Q` says that an instance with some type `X` for
// `P` needs an instance whose type for `Q` holds `X`, and its weight is how much deeper: `Nest[T]`
// for `Q` from `T` is 1, `T` itself 0. An edge of negative weight takes `X` apart instead: a type
// argument `Box[U]` reaching a method of `Box` at `U` is -1. Edges come from:
//
// - each call, function value, call through a bound and call through a method table in generic
//   code: from the caller's parameters to the callee's, through the type arguments the call gives,
//   which are the type arguments of the callee's class or trait as the receiver's static type has
//   them;
// - each type the code names: from the code's parameters to the type's, since an instance of the
//   type has a type record and its structural equality and hash;
// - each data type's fields: from the type's parameters to those of the types they name, since a
//   data value is compared, hashed and shown field by field;
// - each type's parameters to the methods its instances compile with the type's own type arguments
//   rather than the caller's: its operator and equality methods, and each implementation a call
//   through a method table reaches where the method called is another one (a trait's, which the
//   type implements) and the receiver's static type does not decide the implementation's type
//   arguments, as a trait with fewer parameters than the class does not;
// - each call through a bound on a value of a type parameter: from that parameter to the
//   implementation at the call's position in the method table of each data type or class some
//   generic code passes as that parameter, taking the type argument apart. The edge leaves the
//   parameter as it holds that type, a node of its own which only the paths bringing the type
//   reach: `Chain[T]` passing `Option[Chain[T]]` to `F` reaches `Option`'s implementation from it,
//   and not `Chain`'s, whose `Chain[T]` arrives at `F` by another path, one level shallower.
//
// A local function or lambda with no type parameters of its own is copied with the code it is
// declared in, so its types are that code's.
//
// The instances are infinite exactly when a cycle's weights add up to more than zero: each round of
// it nests the type arguments deeper. Each strongly connected set of nodes holding such a cycle is
// reported once, naming the cycle, at its growing edge.

private struct FlowEdge
    from: usize
    to: usize
    weight: i64
    unit: usize
    span: Span
    arg: &Type

/** The flow graph: each node by its key (see `function_base`), the edges and each node's outgoing
 * ones, and what the program's calls through method tables and bounds use. */
private struct Flow
    keys: Buf[usize]
    nodes: Map[usize, usize]
    edges: Buf[FlowEdge]
    /** Each edge's index, by its two nodes: two edges between the same nodes keep the heavier. */
    edge_index: Map[usize, usize]
    out: Buf[Buf[usize]]
    /** The methods called through each method table position. */
    sites: Map[usize, Buf[usize]]
    /** The methods with type parameters of their own called through a table, which are at no
     * position: each reaches the methods of its name. */
    generic_sites: Buf[usize]
    /** Each call through a bound on a value of a type parameter: the parameter's node key and the
     * method table position. */
    bound_keys: Buf[usize]
    bound_slots: Buf[usize]
    /** For each node, the data types and classes (by `data_base` or `class_base`) some code passes
     * to it as the outermost type of its type argument, directly or through other parameters. */
    heads: Map[usize, Buf[usize]]
    /** For each node and outermost type passed to it, by `"key/head"`, the node that stands for the
     * parameter holding that type: an instance of the type reaches it, and a call through a bound
     * on the parameter reaches the type's implementation from it, not from the parameter as a whole,
     * whose other outermost types arrive by other paths. Its key is the parameter's own. */
    head_nodes: Map[string, usize]
    /** The methods of types, by `name/n`, with `n` type parameters of their own. */
    methods_by_name: Map[string, Buf[usize]]
    /** The generic local functions of each top-level function. */
    generic_locals: Map[usize, Buf[usize]]
    /** The edges from a type's parameters to a method that a conformance or an impl with bounds of
     * its own brings, connected once every type argument the program passes the type is known. */
    guarded: Buf[GuardedEdge]

/** An edge from the type parameter with node key `key` to the node with key `to_key`, of `weight`,
 * which holds only where the parameter's type argument meets `bounds` (their own parameters taken as
 * any type): the edge of a method an impl with bounds of its own adds. It is connected from each
 * place that passes the parameter a type argument that may meet them, rather than from the
 * parameter, so a type argument that cannot does not reach the method. `pass` says whether the
 * method's parameter is the type's parameter itself, so it holds the very type argument passed. */
private struct GuardedEdge
    key: usize
    bounds: Buf[&Type]
    to_key: usize
    weight: i64
    pass: bool
    arg: &Type

/** Where code is: the key of its first type parameter's node, the owner its types name those
 * parameters by, its unit, and whether it has type parameters at all. */
private struct Site
    base: usize
    owner: usize
    unit: usize
    generic: bool

// Node keys: a function's type parameter `i` is `function * 256 + i`; a data type's and a class's
// are tagged above every function's. A data type's keys leave room after its own parameters for the
// parameters of each of its refined variants, 256 to a variant.
private function_base(id: usize) -> usize = id * 256

private data_base(id: usize) -> usize = (1usize << 62) + (id << 20)

/** The key of parameter 0 of variant `index` of data type `id`: its type's parameters, then its own. */
private variant_base(id: usize, index: usize) -> usize = data_base(id) + 256 * (index + 1)

/** The data type a data key belongs to. */
private data_of_key(key: usize) -> usize = (key - (1usize << 62)) >> 20

/** A data key's place within its type: its parameter's index, plus 256 for each variant before it. */
private data_slot(key: usize) -> usize = (key - (1usize << 62)) & ((1usize << 20) - 1)

private class_base(id: usize) -> usize = (1usize << 61) + id * 256

/** Rejects every generic call cycle of the program whose type arguments grow. */
check_expansion(c: *Checker)
    var f = Flow(buf(), map(), buf(), map(), buf(), map(), buf(), buf(), buf(), map(), map(), map(), map(), buf())
    index_symbols(c, &f)
    for id in 0..<c.symbols.len()
        c.bodies[id] match
            Some(body) -> walk(c, &f, code_site(c, &f, id), body)
            None -> ()
    for d in 0..<c.data.len()
        val data = c.data[d]
        val site = Site(data_base(d), data_owner(d), data.unit, data.decl.type_params.len() > 0)
        for vi in 0..<data.variants.len()
            val v = data.variants[vi]
            if v.result is Some(_) || v.params.len() > data.decl.type_params.len() then refined_edges(c, &f, d, vi)
            else
                for t in v.fields
                    mention(c, &f, site, v.span, t)
    connect_methods(c, &f)
    connect_bounds(c, &f)
    report_cycles(c, &f)

// A refined variant's parameters are nodes of their own, since its `T` need not be its type's `T`.
// An instance of the type reaches them through the variant's result: an instance `Expr[X]` holding
// a `Pair[A, B]`, whose result is `Expr[(A, B)]`, has `X = (A, B)`, so `A` and `B` each hold a part
// of `X` one level down, an edge of weight -1 from the type's `T`. The fields then reach the types
// they name from the variant's parameters, as a plain variant's do from its type's. A parameter the
// result does not name is hidden: each value carries its own, so an instance a field names through
// one is not one every value of the type needs, and the field adds no edge for it.
private refined_edges(c: *Checker, f: *Flow, d: usize, vi: usize)
    val data = c.data[d]
    val v = data.variants[vi]
    val owner = data_owner(d)
    val base = variant_base(d, vi)
    val site = Site(base, owner, data.unit, true)
    var args: Buf[&Type] = buf()
    v.result match
        Some(r) ->
            if *r is Data(_, _, made) then args = made
        None ->
            for i in 0..<data.decl.type_params.len()
                args.push(TypeVar(owner, i, data.decl.type_params[i].name))
    var hidden: Buf[usize] = buf()
    for i in 0..<v.params.len()
        var shown = false
        for a in args
            if names_type_var(a, owner, i) then shown = true
        if !shown then hidden.push(i)
    for i in 0..<args.len()
        if i >= 256 then break
        var params: Buf[usize] = buf()
        params_in(c, args[i], owner, &params)
        for p in params
            if p < 256 then connect(f, data_base(d) + i, base + p, 0 - depth_of(c, args[i], owner, p), data.unit, v.span, args[i])
    var decl_fields: Buf[Param] = buf()
    for written in data.decl.variants
        if written.name == v.name
            decl_fields = written.fields
            break
    for j in 0..<v.fields.len()
        val at = if j < decl_fields.len() then decl_fields[j].span else v.span
        variant_mention(c, f, site, at, v.fields[j], hidden)

/** The edges of the types a refined variant's field `t` names, leaving out each type argument that
 * names one of the variant's hidden parameters. */
private variant_mention(c: *Checker, f: *Flow, site: Site, span: Span, t: &Type, hidden: Buf[usize])
    *resolved(c, t) match
        Data(id, _, args) -> variant_args(c, f, site, span, args, data_base(id), hidden)
        Class(id, _, args) -> variant_args(c, f, site, span, args, class_base(id), hidden)
        Tuple(items) ->
            for x in items
                variant_mention(c, f, site, span, x, hidden)
        Function(params, result, _) ->
            for x in params
                variant_mention(c, f, site, span, x, hidden)
            variant_mention(c, f, site, span, result, hidden)
        ByName(inner) -> variant_mention(c, f, site, span, inner, hidden)
        _ -> ()

private variant_args(c: *Checker, f: *Flow, site: Site, span: Span, args: Buf[&Type], target: usize, hidden: Buf[usize])
    for j in 0..<args.len()
        var hides = false
        for i in hidden
            if names_type_var(args[j], site.owner, i) then hides = true
        if hides then continue
        var one: Buf[&Type] = buf()
        one.push(args[j])
        flow_into(c, f, site, span, one, target, j)

// The methods by name and the generic local functions by top-level function, read once.
private index_symbols(c: *Checker, f: *Flow)
    for id in 0..<c.symbols.len()
        val symbol = c.symbols[id]
        if symbol.root is Some(root)
            if symbol.decl.type_params.len() > 0
                var locals = f.generic_locals.get(root).unwrap_or(buf())
                locals.push(id)
                f.generic_locals.put(root, locals)
        elif (symbol.owner_class is Some(_) && !symbol.constructor) || symbol.receiver is Some(_)
            val key = s"${symbol.decl.name}/${symbol.decl.type_params.len()}"
            var same = f.methods_by_name.get(key).unwrap_or(buf())
            same.push(id)
            f.methods_by_name.put(key, same)

/** The code whose type parameters a function's types name: its own, or for a local function or
 * lambda with none of its own, the innermost generic local function it is declared in, else its
 * top-level function. */
private code_owner(c: *Checker, f: *Flow, id: usize) -> usize
    val symbol = c.symbols[id]
    val root = symbol.root match
        Some(r) -> r
        None -> return id
    if symbol.decl.type_params.len() > 0 then return id
    var best = root
    var best_count = c.symbols[root].type_params.len()
    if f.generic_locals.get(root) is Some(locals)
        for g in locals
            val s = c.symbols[g]
            if s.unit == symbol.unit && s.decl.span.start <= symbol.decl.span.start && symbol.decl.span.end <= s.decl.span.end && s.type_params.len() > best_count
                best = g
                best_count = s.type_params.len()
    best

private code_site(c: *Checker, f: *Flow, id: usize) -> Site
    val code = code_owner(c, f, id)
    val symbol = c.symbols[id]
    val owner = c.symbols[symbol.root.unwrap_or(id)].type_owner
    Site(function_base(code), owner, symbol.unit, c.symbols[code].type_params.len() > 0)

private node(f: *Flow, key: usize) -> usize
    if f.nodes.get(key) is Some(n) then return n
    val n = f.keys.len()
    f.keys.push(key)
    f.out.push(buf())
    f.nodes.put(key, n)
    n

/** The node for the parameter with node key `key` holding an instance of the type `head` (a
 * `data_base` or `class_base`), which leads to the parameter's own node; the edge that first
 * reaches it, at `unit` and `span` passing `arg`, names that one too. */
private head_node(f: *Flow, key: usize, head: usize, unit: usize, span: Span, arg: &Type) -> usize
    val name = s"$key/$head"
    if f.head_nodes.get(name) is Some(n) then return n
    val n = f.keys.len()
    f.keys.push(key)
    f.out.push(buf())
    f.head_nodes.put(name, n)
    connect_nodes(f, n, node(f, key), 0, unit, span, arg)
    n

private connect(f: *Flow, from_key: usize, to_key: usize, weight: i64, unit: usize, span: Span, arg: &Type)
    connect_nodes(f, node(f, from_key), node(f, to_key), weight, unit, span, arg)

private connect_nodes(f: *Flow, from: usize, to: usize, weight: i64, unit: usize, span: Span, arg: &Type)
    if from == to && weight <= 0 then return
    val key = (from << 32) + to
    if f.edge_index.get(key) is Some(index)
        if weight > f.edges[index].weight then f.edges[index] = FlowEdge(from, to, weight, unit, span, arg)
        return
    val index = f.edges.len()
    f.edges.push(FlowEdge(from, to, weight, unit, span, arg))
    f.edge_index.put(key, index)
    var list = f.out[from]
    list.push(index)
    f.out[from] = list

private resolved(c: *Checker, t: &Type) -> &Type = *t match
    Var(id) -> c.vars[id] match
        Some(bound) -> resolved(c, bound)
        None -> t
    // An application whose constructor is known is the type it makes.
    Applied(head, args) -> *resolved(c, head) match
        Constructor(body, _) -> resolved(c, substitute(body, hole_owner(), args))
        _ -> t
    _ -> t

/** The indices of the type parameters of `owner` that `t` names. */
private params_in(c: *Checker, t: &Type, owner: usize, out: *Buf[usize])
    *resolved(c, t) match
        TypeVar(o, i, _) ->
            if o != owner then return
            for x in *out
                if x == i then return
            out.push(i)
        Tuple(items) ->
            for x in items
                params_in(c, x, owner, out)
        Function(params, result, _) ->
            for x in params
                params_in(c, x, owner, out)
            params_in(c, result, owner, out)
        ByName(inner) -> params_in(c, inner, owner, out)
        Data(_, _, args) ->
            for x in args
                params_in(c, x, owner, out)
        Class(_, _, args) ->
            for x in args
                params_in(c, x, owner, out)
        Opaque(_, _, args, _) ->
            for x in args
                params_in(c, x, owner, out)
        Constructor(body, _) -> params_in(c, body, owner, out)
        Applied(head, args) ->
            params_in(c, head, owner, out)
            for x in args
                params_in(c, x, owner, out)
        _ -> ()

/** How deep in `t` its deepest mention of type parameter `i` of `owner` is: 0 for the parameter
 * itself, one more for each type around it; -1 where `t` does not name it. A constructor is as deep
 * as the type it makes, so a constructor parameter passed bare, `F`, is at 0, and `Wrap[F, _]` at 1;
 * the head of an application `F[A]` is at the application's own depth, its arguments one deeper. */
private depth_of(c: *Checker, t: &Type, owner: usize, i: usize) -> i64
    val parts: Buf[&Type] = *resolved(c, t) match
        TypeVar(o, j, _) -> return if o == owner && j == i then 0 else -1
        Constructor(body, _) -> return depth_of(c, body, owner, i)
        Applied(head, args) ->
            var deepest = depth_of(c, head, owner, i)
            for x in args
                val d = depth_of(c, x, owner, i)
                if d >= 0 && d + 1 > deepest then deepest = d + 1
            return deepest
        Tuple(items) -> items
        Function(params, result, _) ->
            var all: Buf[&Type] = buf()
            for p in params
                all.push(p)
            all.push(result)
            all
        ByName(inner) ->
            var one: Buf[&Type] = buf()
            one.push(inner)
            one
        Data(_, _, args) -> args
        Class(_, _, args) -> args
        Opaque(_, _, args, _) -> args
        _ -> return -1
    var deepest: i64 = -1
    for x in parts
        val d = depth_of(c, x, owner, i)
        if d >= 0 && d + 1 > deepest then deepest = d + 1
    deepest

/** The deepest mention in `t` of any type parameter of `owner`, or -1. */
private deepest_param(c: *Checker, t: &Type, owner: usize) -> i64
    var params: Buf[usize] = buf()
    params_in(c, t, owner, &params)
    var deepest: i64 = -1
    for i in params
        val d = depth_of(c, t, owner, i)
        if d > deepest then deepest = d
    deepest

/** Edges from the code at `site` to the type parameters from `offset` on of the code or type whose
 * parameter 0 has key `target`, given `args`; and the edges of the types `args` name. */
private flow_into(c: *Checker, f: *Flow, site: Site, span: Span, args: Buf[&Type], target: usize, offset: usize)
    if !site.generic then return
    for j in 0..<args.len()
        if offset + j >= 256 then break
        var params: Buf[usize] = buf()
        params_in(c, args[j], site.owner, &params)
        val head: usize = *resolved(c, args[j]) match
            Data(id, _, _) -> data_base(id)
            Class(id, _, _) -> class_base(id)
            _ -> 0
        for i in params
            if i < 256
                val weight = depth_of(c, args[j], site.owner, i)
                connect(f, site.base + i, target + offset + j, weight, site.unit, span, args[j])
                if head != 0 then connect_nodes(f, node(f, site.base + i), head_node(f, target + offset + j, head, site.unit, span, args[j]), weight, site.unit, span, args[j])
        if params.len() > 0 && head != 0 then add_head(f, target + offset + j, head)
        mention(c, f, site, span, args[j])

private add_head(f: *Flow, key: usize, head: usize) -> bool
    var heads = f.heads.get(key).unwrap_or(buf())
    for h in heads
        if h == head then return false
    heads.push(head)
    f.heads.put(key, heads)
    true

/** The edges of the data types and classes `t` names, from the code at `site`. */
private mention(c: *Checker, f: *Flow, site: Site, span: Span, t: &Type)
    if !site.generic then return
    *resolved(c, t) match
        Data(id, _, args) -> flow_into(c, f, site, span, args, data_base(id), 0)
        Class(id, _, args) -> flow_into(c, f, site, span, args, class_base(id), 0)
        Tuple(items) ->
            for x in items
                mention(c, f, site, span, x)
        Function(params, result, _) ->
            for x in params
                mention(c, f, site, span, x)
            mention(c, f, site, span, result)
        ByName(inner) -> mention(c, f, site, span, inner)
        // An opaque type's code is its representation's.
        Opaque(_, _, _, repr) -> mention(c, f, site, span, repr)
        Constructor(body, _) -> mention(c, f, site, span, body)
        Applied(_, args) ->
            for x in args
                mention(c, f, site, span, x)
        _ -> ()

/** A direct call or function value of `id`. A local function or lambda with no type parameters of
 * its own is part of the code it is declared in, so calling it adds nothing. */
private call_edges(c: *Checker, f: *Flow, site: Site, span: Span, id: usize, type_args: Buf[&Type])
    val symbol = c.symbols[id]
    if symbol.root is Some(_) && symbol.decl.type_params.len() == 0 then return
    flow_into(c, f, site, span, type_args, function_base(id), 0)

/** A call through a method table: the method called, as a direct call would, and the position,
 * whose implementations `connect_methods` reaches. */
private dispatch_edges(c: *Checker, f: *Flow, site: Site, span: Span, id: usize, slot: usize, type_args: Buf[&Type])
    flow_into(c, f, site, span, type_args, function_base(id), 0)
    var called = f.sites.get(slot).unwrap_or(buf())
    var seen = false
    for g in called
        if g == id then seen = true
    if !seen
        called.push(id)
        f.sites.put(slot, called)
    if own_generic_edges(c, f, site, span, id, type_args)
        var known = false
        for g in f.generic_sites
            if g == id then known = true
        if !known then f.generic_sites.push(id)

/** A call through a bound: the method called, as a direct call would, and, where the receiver is
 * a value of one of the code's type parameters, the implementation at the position in the method
 * table of whichever type that parameter is, its type arguments taken apart from the parameter's. */
private bound_edges(c: *Checker, f: *Flow, site: Site, span: Span, id: usize, slot: usize, args: Buf[&TExpr], type_args: Buf[&Type])
    flow_into(c, f, site, span, type_args, function_base(id), 0)
    own_generic_edges(c, f, site, span, id, type_args)
    if !site.generic || args.len() == 0 then return
    *resolved(c, args[0].ty) match
        TypeVar(o, i, _) ->
            if o == site.owner && i < 256
                f.bound_keys.push(site.base + i)
                f.bound_slots.push(slot)
        _ -> ()

// The type arguments a call gives a method's own type parameters reach every method of its name
// that may implement it. Whether the method has any is the result.
private own_generic_edges(c: *Checker, f: *Flow, site: Site, span: Span, id: usize, type_args: Buf[&Type]) -> bool
    val symbol = c.symbols[id]
    val own = symbol.decl.type_params.len()
    if own == 0 || type_args.len() < own then return false
    var own_args: Buf[&Type] = buf()
    for i in type_args.len() - own..<type_args.len()
        own_args.push(type_args[i])
    if f.methods_by_name.get(s"${symbol.decl.name}/$own") is Some(methods)
        for m in methods
            if m != id && may_implement(c, m, id) then flow_into(c, f, site, span, own_args, function_base(m), c.symbols[m].type_params.len() - own)
    true

// Whether method `m` can stand in for `id` in a call through a table or a bound: it belongs to a
// class, trait or data type that has the class or trait `id` belongs to among its ancestors. A method
// of an unrelated type that merely shares the name is never what such a call runs.
private may_implement(c: *Checker, m: usize, id: usize) -> bool
    val target = c.symbols[id].owner_class match
        Some(k) -> k
        None -> return true
    val self_type = c.symbols[m].owner_class match
        Some(k) -> class_type_of(c, k)
        None -> c.symbols[m].receiver match
            Some(r) -> *r match
                Data(d, _, _) -> data_type_of(c, d)
                Class(k, _, _) -> class_type_of(c, k)
                _ -> return true
            None -> return true
    ancestor_type(c.classes, c.data, self_type, target) is Some(_)

private walk_all(c: *Checker, f: *Flow, site: Site, items: Buf[&TExpr])
    for e in items
        walk(c, f, site, e)

private walk_option(c: *Checker, f: *Flow, site: Site, e: Option[&TExpr])
    if e is Some(x) then walk(c, f, site, x)

private walk(c: *Checker, f: *Flow, site: Site, e: &TExpr)
    mention(c, f, site, e.span, e.ty)
    e.kind match
        Call(id, args, type_args) ->
            call_edges(c, f, site, e.span, id, type_args)
            walk_all(c, f, site, args)
        Dispatch(id, slot, args, type_args) ->
            dispatch_edges(c, f, site, e.span, id, slot, type_args)
            walk_all(c, f, site, args)
        BoundCall(id, slot, args, type_args) ->
            if slot is Some(p) then bound_edges(c, f, site, e.span, id, p, args, type_args)
            else call_edges(c, f, site, e.span, id, type_args)
            walk_all(c, f, site, args)
        FunctionValue(id, type_args) -> call_edges(c, f, site, e.span, id, type_args)
        Construct(_, args) -> walk_all(c, f, site, args)
        Collection(elements, built) ->
            walk_all(c, f, site, elements)
            walk(c, f, site, built)
        CallValue(callee, args) ->
            walk(c, f, site, callee)
            walk_all(c, f, site, args)
        Field(value, _) -> walk(c, f, site, value)
        StoreField(object, _, value, _) ->
            walk(c, f, site, object)
            walk(c, f, site, value)
        LazyGlobal(_, initialize, _) -> walk(c, f, site, initialize)
        LazyField(object, _, initialize, _) ->
            walk(c, f, site, object)
            walk(c, f, site, initialize)
        LazyLocal(cell, initialize, _, _) ->
            walk(c, f, site, cell)
            walk(c, f, site, initialize)
        StoreGlobal(_, value, _) -> walk(c, f, site, value)
        Block(items) -> walk_all(c, f, site, items)
        Let(_, value) -> walk(c, f, site, value)
        LetPattern(pattern, value) ->
            walk_pattern(c, f, site, pattern)
            walk(c, f, site, value)
        Store(_, value, _) -> walk(c, f, site, value)
        MultiStore(_, value) -> walk(c, f, site, value)
        Negate(x) -> walk(c, f, site, x)
        Not(x) -> walk(c, f, site, x)
        Complement(x) -> walk(c, f, site, x)
        Convert(x, _) -> walk(c, f, site, x)
        Box(x) -> walk(c, f, site, x)
        NoneAs(x) -> walk(c, f, site, x)
        Reveal(x) -> walk(c, f, site, x)
        Arith(_, a, b, _) ->
            walk(c, f, site, a)
            walk(c, f, site, b)
        Logic(_, a, b) ->
            walk(c, f, site, a)
            walk(c, f, site, b)
        Compare(operands, _) -> walk_all(c, f, site, operands)
        If(condition, yes, no) ->
            walk(c, f, site, condition)
            walk(c, f, site, yes)
            walk_option(c, f, site, no)
        While(_, condition, body, otherwise) ->
            walk(c, f, site, condition)
            walk(c, f, site, body)
            walk_option(c, f, site, otherwise)
        Break(_, value) -> walk_option(c, f, site, value)
        Return(value) -> walk_option(c, f, site, value)
        Defer(body) -> walk(c, f, site, body)
        Match(subject, arms) ->
            walk(c, f, site, subject)
            for arm in arms
                walk_pattern(c, f, site, arm.pattern)
                walk_option(c, f, site, arm.guard)
                walk(c, f, site, arm.body)
        Is(value, pattern, _) ->
            walk(c, f, site, value)
            walk_pattern(c, f, site, pattern)
        Clauses(subjects, clauses) ->
            walk_all(c, f, site, subjects)
            for clause in clauses
                for p in clause.patterns
                    walk_pattern(c, f, site, p)
                for b in clause.bodies
                    walk_option(c, f, site, b.guard)
                    walk(c, f, site, b.body)
        _ -> ()

private walk_pattern(c: *Checker, f: *Flow, site: Site, p: &TPattern)
    mention(c, f, site, p.span, p.ty)
    p.kind match
        PLiteral(value) -> walk(c, f, site, value)
        PBounds(_, lower, upper) ->
            if lower is Some(b) then walk(c, f, site, b.value)
            if upper is Some(b) then walk(c, f, site, b.value)
        PSuccessor(_, amount) -> walk(c, f, site, amount)
        PAlternatives(options) ->
            for x in options
                walk_pattern(c, f, site, x)
        PNamed(_, inner) -> walk_pattern(c, f, site, inner)
        PVariant(_, fields, _) ->
            for x in fields
                walk_pattern(c, f, site, x)
        PType(target, _, _) -> mention(c, f, site, p.span, target)
        PSequence(_, test, elements, items, _) ->
            walk(c, f, site, test)
            walk_all(c, f, site, elements)
            for x in items
                walk_pattern(c, f, site, x)
        PView(_, view, inner) ->
            walk(c, f, site, view)
            walk_pattern(c, f, site, inner)
        PUnion(parts) ->
            for x in parts
                mention(c, f, site, x.span, x.ty)
                walk_pattern(c, f, site, x)
        _ -> ()


/** Whether a method is called on the type's instances without a call naming it: the operator and
 * equality methods. */
private implicit_method(name: string) -> bool =
    name == "equals" || name == "hash" || name == "compare" || name == "add" || name == "subtract" || name == "multiply" ||
        name == "divide" || name == "remainder" || name == "negate" || name == "less" || name == "lessOrEqual" ||
        name == "greater" || name == "greaterOrEqual"

/** Edges from each type's parameters to the methods its instances compile with its own type
 * arguments, once every call through a bound or a table is known. */
private connect_methods(c: *Checker, f: *Flow)
    for k in 0..<c.classes.len()
        val class = c.classes[k]
        if class.decl.type_params.len() == 0 then continue
        val self_type = class_type_of(c, k)
        val site = Site(class_base(k), class_owner(k), class.unit, true)
        connect_table(c, f, self_type, site, class.decl.name_span, class.table)
        for m in class.methods
            if implicit_method(c.symbols[m].decl.name) || reached_by_name(c, f, self_type, site.owner, m) then view_edges(c, f, self_type, site, class.decl.name_span, m)
    for d in 0..<c.data.len()
        val data = c.data[d]
        if data.decl.type_params.len() == 0 then continue
        val self_type = data_type_of(c, d)
        val site = Site(data_base(d), data_owner(d), data.unit, true)
        connect_table(c, f, self_type, site, data.decl.span, data.table)
        for m in data.methods
            if implicit_method(c.symbols[m].decl.name) || reached_by_name(c, f, self_type, site.owner, m) then view_edges(c, f, self_type, site, data.decl.span, m)

private class_type_of(c: *Checker, k: usize) -> &Type
    var args: Buf[&Type] = buf()
    val params = c.classes[k].decl.type_params
    for i in 0..<params.len()
        args.push(TypeVar(class_owner(k), i, params[i].name))
    Class(k, c.classes[k].name, args)

private data_type_of(c: *Checker, d: usize) -> &Type
    var args: Buf[&Type] = buf()
    val params = c.data[d].decl.type_params
    for i in 0..<params.len()
        args.push(TypeVar(data_owner(d), i, params[i].name))
    Data(d, c.data[d].name, args)

// The implementations in a type's method table that a call through their position reaches with the
// type's own type arguments.
private connect_table(c: *Checker, f: *Flow, self_type: &Type, site: Site, span: Span, table: Buf[Option[usize]])
    for p in 0..<table.len()
        val m = table[p] match
            Some(m) -> m
            None -> continue
        val called = f.sites.get(p) match
            Some(x) -> x
            None -> continue
        for g in called
            if g != m && undecided(c, self_type, site.owner, g)
                view_edges(c, f, self_type, site, span, m)
                break

/** Whether some call through a bound or a table of a method with type parameters of its own reaches
 * method `m`, of the same name, of a value of type `self_type` with that type's own type arguments. */
private reached_by_name(c: *Checker, f: *Flow, self_type: &Type, owner: usize, m: usize) -> bool
    val symbol = c.symbols[m]
    val own = symbol.decl.type_params.len()
    if own == 0 then return false
    for g in f.generic_sites
        val called = c.symbols[g]
        if g != m && called.decl.name == symbol.decl.name && called.decl.type_params.len() == own && undecided(c, self_type, owner, g) then return true
    false

// Whether a call of `g` through a bound or a table may reach a value of type `self_type` without
// deciding its type arguments: the type is an instance of the class or trait `g` belongs to, and as
// that instance it leaves some of its own type parameters unnamed, as an instance of a trait with
// none does. Where it names them all, the receiver's type arguments decide them, and the
// implementation's are taken apart from those.
private undecided(c: *Checker, self_type: &Type, owner: usize, g: usize) -> bool
    val k = c.symbols[g].owner_class match
        Some(k) -> k
        None -> return false
    val view = ancestor_type(c.classes, c.data, self_type, k) match
        Some(v) -> v
        None -> return false
    val count = *self_type match
        Data(_, _, a) -> a.len()
        Class(_, _, a) -> a.len()
        Opaque(_, _, a, _) -> a.len()
        _ -> 0
    var named: Buf[usize] = buf()
    params_in(c, view, owner, &named)
    named.len() < count

// Edges from the type `self_type`'s parameters to method `m`'s, through the type `m` belongs to as
// `self_type` has it: the type itself, a superclass, or a trait it implements. A method an impl adds
// names the impl's own type parameters in its receiver's type, each standing for the type's
// parameter at its position.
//
// Where an impl with bounds of its own brings `m`, an edge from a parameter the bounds constrain is
// guarded: it holds only for the type arguments that meet them.
private view_edges(c: *Checker, f: *Flow, self_type: &Type, site: Site, span: Span, m: usize)
    val symbol = c.symbols[m]
    val conditions = impl_conditions(c, self_type, site.owner, m)
    if symbol.owner_class is None
        val receiver_args = symbol.receiver match
            Some(r) -> *r match
                Data(_, _, args) -> args
                Class(_, _, args) -> args
                Opaque(_, _, args, _) -> args
                _ -> return
            None -> return
        for j in 0..<receiver_args.len()
            if j >= 256 then break
            var params: Buf[usize] = buf()
            params_in(c, receiver_args[j], symbol.type_owner, &params)
            for i in params
                if i >= 256 then continue
                val weight = 0 - depth_of(c, receiver_args[j], symbol.type_owner, i)
                if j < conditions.len() && conditions[j].len() > 0
                    val pass = *resolved(c, receiver_args[j]) is TypeVar(_, _, _)
                    f.guarded.push(GuardedEdge(site.base + j, conditions[j], function_base(m) + i, weight, pass, receiver_args[j]))
                else connect(f, site.base + j, function_base(m) + i, weight, site.unit, span, receiver_args[j])
        return
    val k = symbol.owner_class.unwrap()
    val view = ancestor_type(c.classes, c.data, self_type, k) match
        Some(v) -> v
        None -> return
    val args = *view match
        Class(_, _, a) -> a
        _ -> return
    if conditions.len() == 0
        flow_into(c, f, site, span, args, function_base(m), 0)
        return
    // A trait's default body the conformance brings: as `flow_into`, with each constrained
    // parameter's edges guarded.
    for j in 0..<args.len()
        if j >= 256 then break
        var params: Buf[usize] = buf()
        params_in(c, args[j], site.owner, &params)
        for i in params
            if i >= 256 then continue
            val weight = depth_of(c, args[j], site.owner, i)
            if i < conditions.len() && conditions[i].len() > 0
                val pass = *resolved(c, args[j]) is TypeVar(_, _, _)
                f.guarded.push(GuardedEdge(site.base + i, conditions[i], function_base(m) + j, weight, pass, args[j]))
            else
                connect(f, site.base + i, function_base(m) + j, weight, site.unit, span, args[j])
                val head = head_of(c, args[j])
                if head != 0 then connect_nodes(f, node(f, site.base + i), head_node(f, function_base(m) + j, head, site.unit, span, args[j]), weight, site.unit, span, args[j])
        if params.len() > 0
            val head = head_of(c, args[j])
            if head != 0 then add_head(f, function_base(m) + j, head)
        mention(c, f, site, span, args[j])

/** The outermost type of `t` as a head (see `Flow.heads`): its `data_base` or `class_base`, or 0. */
private head_of(c: *Checker, t: &Type) -> usize = *resolved(c, t) match
    Data(id, _, _) -> data_base(id)
    Class(id, _, _) -> class_base(id)
    _ -> 0

/** The bounds an impl with bounds of its own puts on the parameters of the type `self_type`, whose
 * parameters `owner` owns, where it brings method `m`: the impl's own method, or a default body of
 * the trait the impl implements. Each is a bound by the type's parameter's position, with the type's
 * parameters in it taken as any type. Empty where no such impl brings `m`. */
private impl_conditions(c: *Checker, self_type: &Type, owner: usize, m: usize) -> Buf[Buf[&Type]]
    val symbol = c.symbols[m]
    var found: Option[Buf[Buf[&Type]]] = None
    if symbol.owner_class is Some(k)
        for x in c.conditional
            if x.owner == owner && x.trait_id == k then found = Some(x.conditions)
    elif symbol.type_params.len() > 0
        for x in c.conditional_methods
            if x.owner == owner && x.params.len() > 0 && x.unit == symbol.unit && symbol.type_params.len() >= x.params.len() && symbol.type_params[0].site == x.params[0].site then found = Some(x.conditions)
        for x in c.conditional
            if x.owner == owner && x.params.len() > 0 && x.unit == symbol.unit && symbol.type_params.len() >= x.params.len() && symbol.type_params[0].site == x.params[0].site then found = Some(x.conditions)
    val conditions = found match
        Some(x) -> x
        None -> return buf()
    var any: Buf[&Type] = buf()
    val count = *self_type match
        Data(_, _, a) -> a.len()
        Class(_, _, a) -> a.len()
        Opaque(_, _, a, _) -> a.len()
        _ -> 0
    for _ in 0..<count do any.push(ErrorType)
    var out: Buf[Buf[&Type]] = buf()
    for bounds in conditions
        var each: Buf[&Type] = buf()
        for b in bounds do each.push(substitute(b, owner, any))
        out.push(each)
    out

// Each edge into a parameter that brings a value whose outermost type no head stands for: a tuple, a
// function, a part taken apart from a larger type, or what a call through a bound passes. Its source
// reaches the parameter as it holds an unknown type, `unknown_head`, too, so that every value a
// parameter holds reaches it through one of its heads.
private mark_unknown(c: *Checker, f: *Flow)
    val count = f.edges.len()
    for x in 0..<count
        val e = f.edges[x]
        if !plain(f, e.to) then continue
        val key = f.keys[e.to]
        if plain(f, e.from)
            if e.weight == 0 && *resolved(c, e.arg) is TypeVar(_, _, _) then continue
        elif f.keys[e.from] == key then continue
        val head = head_of(c, e.arg)
        if head != 0
            if f.head_nodes.get(s"$key/$head") is Some(n)
                if f.edge_index.get((e.from << 32) + n) is Some(_) then continue
        connect_nodes(f, e.from, head_node(f, key, unknown_head(), e.unit, e.span, e.arg), e.weight, e.unit, e.span, e.arg)
        add_head(f, key, unknown_head())

/** The head standing for a value whose outermost type the flow does not know: no type's base. */
private unknown_head() -> usize = 1

// The guarded edges, from the parameter as it holds each outermost type that may meet the bounds,
// so a type argument reaches the method only by the paths that bring such a type. A value of
// unknown outermost type may meet them. Where the method's parameter is the type's parameter
// itself, it holds the same outermost type.
private connect_guarded(c: *Checker, f: *Flow, conformances: Conformances)
    for g in f.guarded
        val heads = f.heads.get(g.key) match
            Some(h) -> h
            None -> continue
        for h in heads
            if !head_may_meet(c, conformances, h, g.bounds) then continue
            val from = f.head_nodes.get(s"${g.key}/$h") match
                Some(n) -> n
                None -> continue
            // The edge that first brought the head names the place.
            val e = f.edges[f.out[from][0]]
            if g.pass
                connect_nodes(f, from, head_node(f, g.to_key, h, e.unit, e.span, g.arg), g.weight, e.unit, e.span, g.arg)
                add_head(f, g.to_key, h)
            else
                connect_nodes(f, from, node(f, g.to_key), g.weight, e.unit, e.span, g.arg)
                val head = head_of(c, g.arg)
                if head != 0
                    connect_nodes(f, from, head_node(f, g.to_key, head, e.unit, e.span, g.arg), g.weight, e.unit, e.span, g.arg)
                    add_head(f, g.to_key, head)

/** Whether a value whose outermost type is head `h`, its type arguments taken as any types, may
 * meet every one of `bounds`. */
private head_may_meet(c: *Checker, f: Conformances, h: usize, bounds: Buf[&Type]) -> bool
    if h == unknown_head() then return true
    val t = if h >= (1usize << 62) then data_type_of(c, data_of_key(h)) else class_type_of(c, (h - (1usize << 61)) / 256)
    may_meet(c, f, t, bounds)

/** Whether a type argument `t`, its type parameters taken as any type, may meet every one of
 * `bounds`. */
private may_meet(c: *Checker, f: Conformances, t: &Type, bounds: Buf[&Type]) -> bool
    val x = any_params(c, t)
    for b in bounds
        if *b is Class(k, _, _)
            if c.core.trait_named("Sendable") is Some(s)
                if s == k then continue
        if !meets_bound(f, x, b) then return false
    true

/** `t` with each type parameter and unsolved unknown in it as `ErrorType`, which conforms to
 * everything. */
private any_params(c: *Checker, t: &Type) -> &Type = *resolved(c, t) match
    TypeVar(_, _, _) -> ErrorType
    Var(_) -> ErrorType
    Tuple(items) -> Tuple(all_any(c, items))
    Function(params, result, sendable) -> Function(all_any(c, params), any_params(c, result), sendable)
    ByName(inner) -> ByName(any_params(c, inner))
    Data(id, name, args) -> Data(id, name, all_any(c, args))
    Class(id, name, args) -> Class(id, name, all_any(c, args))
    Opaque(id, name, args, repr) -> Opaque(id, name, all_any(c, args), any_params(c, repr))
    _ -> resolved(c, t)

private all_any(c: *Checker, items: Buf[&Type]) -> Buf[&Type]
    var out: Buf[&Type] = buf()
    for x in items do out.push(any_params(c, x))
    out

// The calls through bounds: each type parameter's outermost types reach the parameters it is passed
// on to unchanged, and each call on a value of it reaches each such type's implementation.
//
// The guarded edges are connected here too, from the outermost types that reach them, and each
// step can bring another a new one, so the steps repeat until none adds a node or an edge.
private connect_bounds(c: *Checker, f: *Flow)
    val conformances = Conformances(c.classes, c.data, c.builtins, c.conditional, c.core, c.bounds, None, c.lowers, None)
    var size = 0usize
    while f.edges.len() + f.keys.len() != size
        size = f.edges.len() + f.keys.len()
        mark_unknown(c, f)
        pass_heads(c, f)
        connect_guarded(c, f, conformances)
        bound_targets(c, f)

/** A parameter passed on unchanged passes on each outermost type it holds, along the path that type
 * takes. */
private pass_heads(c: *Checker, f: *Flow)
    var changed = true
    while changed
        changed = false
        val count = f.edges.len()
        for x in 0..<count
            val e = f.edges[x]
            if e.weight != 0 then continue
            if !(*resolved(c, e.arg) is TypeVar(_, _, _)) then continue
            if !plain(f, e.from) || !plain(f, e.to) then continue
            if f.heads.get(f.keys[e.from]) is Some(heads)
                for h in heads
                    if add_head(f, f.keys[e.to], h) then changed = true
                    val from = head_node(f, f.keys[e.from], h, e.unit, e.span, e.arg)
                    connect_nodes(f, from, head_node(f, f.keys[e.to], h, e.unit, e.span, e.arg), 0, e.unit, e.span, e.arg)

/** Each call on a value of a type parameter reaches the implementation of each outermost type the
 * parameter holds. */
private bound_targets(c: *Checker, f: *Flow)
    for x in 0..<f.bound_keys.len()
        val key = f.bound_keys[x]
        val slot = f.bound_slots[x]
        val heads = f.heads.get(key) match
            Some(h) -> h
            None -> continue
        for h in heads
            if h == unknown_head() then continue
            // The parameter as it holds this type, so only the paths that bring the type reach
            // its implementation.
            val from = f.head_nodes.get(s"$key/$h").unwrap_or(node(f, key))
            if h >= (1usize << 62)
                val d = data_of_key(h)
                bound_target(c, f, from, data_type_of(c, d), data_owner(d), c.data[d].table, slot)
            else
                val k = (h - (1usize << 61)) / 256
                bound_target(c, f, from, class_type_of(c, k), class_owner(k), c.classes[k].table, slot)

/** Whether node `n` is a parameter's own node rather than one for an outermost type it holds. */
private plain(f: *Flow, n: usize) -> bool = f.nodes.get(f.keys[n]).unwrap_or(n + 1) == n

private bound_target(c: *Checker, f: *Flow, from: usize, self_type: &Type, owner: usize, table: Buf[Option[usize]], slot: usize)
    if slot < table.len()
        if table[slot] is Some(m) then bound_target_edges(c, f, from, self_type, owner, m)

// Edges from node `from`, a type parameter holding an instance of `self_type`, to method
// `m`, that type's implementation: each of `m`'s type parameters is a part of the type argument, or
// holds parts of it as deep as the view of `self_type` it belongs to puts them, so the weight is that
// depth less the one the type adds.
private bound_target_edges(c: *Checker, f: *Flow, from: usize, self_type: &Type, owner: usize, m: usize)
    val symbol = c.symbols[m]
    if symbol.owner_class is None
        val receiver_args = symbol.receiver match
            Some(r) -> *r match
                Data(_, _, args) -> args
                Class(_, _, args) -> args
                Opaque(_, _, args, _) -> args
                _ -> return
            None -> return
        for j in 0..<receiver_args.len()
            var params: Buf[usize] = buf()
            params_in(c, receiver_args[j], symbol.type_owner, &params)
            for i in params
                if i < 256 then connect_nodes(f, from, node(f, function_base(m) + i), -1 - depth_of(c, receiver_args[j], symbol.type_owner, i), symbol.unit, symbol.decl.name_span, receiver_args[j])
        return
    val k = symbol.owner_class.unwrap()
    val view = ancestor_type(c.classes, c.data, self_type, k) match
        Some(v) -> v
        None -> return
    val args = *view match
        Class(_, _, a) -> a
        _ -> return
    for i in 0..<args.len()
        if i >= 256 then break
        val d = deepest_param(c, args[i], owner)
        if d >= 0 then connect_nodes(f, from, node(f, function_base(m) + i), d - 1, symbol.unit, symbol.decl.name_span, args[i])

/** Reports each strongly connected set of nodes that holds a cycle of positive weight, naming the
 * cycle. */
private report_cycles(c: *Checker, f: *Flow)
    val component = components(f)
    // The edges within each component that holds a growing one.
    var inner: Map[usize, Buf[usize]] = map()
    for x in 0..<f.edges.len()
        val e = f.edges[x]
        if e.weight > 0 && component[e.from] == component[e.to] then inner.put(component[e.from], buf())
    var order: Buf[usize] = buf()
    for x in 0..<f.edges.len()
        val e = f.edges[x]
        if component[e.from] != component[e.to] then continue
        if inner.get(component[e.from]) is Some(list)
            if list.len() == 0 then order.push(component[e.from])
            var more = list
            more.push(x)
            inner.put(component[e.from], more)
    var cycles: Buf[Buf[usize]] = buf()
    // A component holding a growing cycle among data types' fields alone is that nested data type,
    // even where code written for the types closes other cycles through it.
    for k in order
        val all = inner.get(k).unwrap()
        var fields: Buf[usize] = buf()
        for x in all
            if f.keys[f.edges[x].from] >= (1usize << 62) && f.keys[f.edges[x].to] >= (1usize << 62) then fields.push(x)
        var cycle = positive_cycle(f, fields)
        if cycle.len() == 0 then cycle = positive_cycle(f, all)
        if cycle.len() > 0 then cycles.push(cycle)
    // A nested data type is reported at the type, and not again through the code written for it,
    // its derived and structural methods.
    var nested: Map[usize, bool] = map()
    for cycle in cycles
        if !only_data(f, cycle) then continue
        for x in cycle
            nested.put(data_of_key(f.keys[f.edges[x].from]), true)
        report_cycle(c, f, cycle)
    for cycle in cycles
        if only_data(f, cycle) then continue
        var through_nested = false
        for x in cycle
            if names_data(c, f.edges[x].arg, &nested) then through_nested = true
        if !through_nested then report_cycle(c, f, cycle)

private only_data(f: *Flow, cycle: Buf[usize]) -> bool
    for x in cycle
        if f.keys[f.edges[x].from] < (1usize << 62) then return false
    true

private names_data(c: *Checker, t: &Type, ids: *Map[usize, bool]) -> bool = *resolved(c, t) match
    Data(id, _, args) -> ids.get(id) is Some(_) || any_names_data(c, args, ids)
    Class(_, _, args) -> any_names_data(c, args, ids)
    Opaque(_, _, args, repr) -> any_names_data(c, args, ids) || names_data(c, repr, ids)
    Tuple(items) -> any_names_data(c, items, ids)
    Function(params, result, _) -> any_names_data(c, params, ids) || names_data(c, result, ids)
    ByName(inner) -> names_data(c, inner, ids)
    _ -> false

private any_names_data(c: *Checker, items: Buf[&Type], ids: *Map[usize, bool]) -> bool
    for x in items
        if names_data(c, x, ids) then return true
    false

/** Reports a cycle at its heaviest edge in the program's own code, else in the library's. */
private report_cycle(c: *Checker, f: *Flow, cycle: Buf[usize])
    var best = 0usize
    for i in 1..<cycle.len()
        val a = f.edges[cycle[best]]
        val b = f.edges[cycle[i]]
        val better_place = in_library(c, a.unit) && !in_library(c, b.unit)
        val same_place = in_library(c, a.unit) == in_library(c, b.unit)
        if better_place || (same_place && b.weight > a.weight) then best = i
    val e = f.edges[cycle[best]]
    var path: Buf[usize] = buf()
    for i in 0..<cycle.len()
        path.push(f.edges[cycle[(best + i) % cycle.len()]].from)
    path.push(e.from)
    val shown = type_name(solve(c.vars, e.arg))
    c.note(e.unit, e.span, s"polymorphic recursion: each round of the cycle ${cycle_text(c, f, path)} passes `$shown` for `${param_name(c, f, e.to)}`, so its type arguments grow without end and the code has no finite set of copies${refined_field_text(c, f, e)}")

// Where a cycle grows through a refined variant's field, the field and the variant's result, which
// the growth is measured against.
private refined_field_text(c: *Checker, f: *Flow, e: FlowEdge) -> string
    val key = f.keys[e.from]
    if key < (1usize << 62) then return ""
    val d = c.data[data_of_key(key)]
    val block = data_slot(key) / 256
    if block == 0 || block - 1 >= d.variants.len() then return ""
    val v = d.variants[block - 1]
    val made = v.result match
        Some(r) -> type_name(r)
        None -> type_name(data_type_of(c, data_of_key(key)))
    for written in d.decl.variants
        if written.name != v.name then continue
        for j in 0..<written.fields.len()
            if j < v.fields.len() && written.fields[j].span.start == e.span.start && written.fields[j].span.end == e.span.end
                return s": the field `${v.field_names[j]}` of `${v.name}` has type `${type_name(v.fields[j])}`, and `${v.name}` makes `$made`"
    ""

private in_library(c: *Checker, unit: usize) -> bool
    val m = c.units[unit].file.module_name
    m == "avin" || m.starts_with("avin.")

/** A cycle of positive total weight among `edges`, as its edges in order, or none: the longest
 * paths are relaxed once per node, and an edge still relaxing after that lies on such a cycle's
 * way. */
private positive_cycle(f: *Flow, edges: Buf[usize]) -> Buf[usize]
    var dist: Map[usize, i64] = map()
    var pred: Map[usize, usize] = map()
    for x in edges
        dist.put(f.edges[x].from, 0)
        dist.put(f.edges[x].to, 0)
    var rounds = 0usize
    var changed = true
    var last = 0usize
    // Every node of the component is an end of one of its edges.
    val count = node_count(f, edges)
    while changed && rounds <= count
        changed = false
        rounds += 1
        for x in edges
            val e = f.edges[x]
            val through = dist.get(e.from).unwrap() + e.weight
            if through > dist.get(e.to).unwrap()
                dist.put(e.to, through)
                pred.put(e.to, x)
                changed = true
                last = e.to
    var out: Buf[usize] = buf()
    if !changed then return out
    // Walking back as many steps as there are nodes ends inside the cycle.
    var v = last
    for _ in 0..<count
        v = f.edges[pred.get(v).unwrap()].from
    val start = v
    var reversed: Buf[usize] = buf()
    var done = false
    while !done
        val x = pred.get(v).unwrap()
        reversed.push(x)
        v = f.edges[x].from
        done = v == start
    var i = reversed.len()
    while i > 0
        i -= 1
        out.push(reversed[i])
    out

private node_count(f: *Flow, edges: Buf[usize]) -> usize
    var seen: Map[usize, bool] = map()
    var count = 0usize
    for x in edges
        val e = f.edges[x]
        if seen.get(e.from) is None
            seen.put(e.from, true)
            count += 1
        if seen.get(e.to) is None
            seen.put(e.to, true)
            count += 1
    count

/** Each node's strongly connected component, by Tarjan's algorithm without recursion. */
private components(f: *Flow) -> Buf[usize]
    val n = f.keys.len()
    var index: Buf[usize] = buf()
    var low: Buf[usize] = buf()
    var on_stack: Buf[bool] = buf()
    var component: Buf[usize] = buf()
    for _ in 0..<n
        index.push(n)
        low.push(n)
        on_stack.push(false)
        component.push(n)
    var stack: Buf[usize] = buf()
    var counter = 0usize
    var count = 0usize
    for root in 0..<n
        if index[root] != n then continue
        var frames: Buf[usize] = buf()
        var positions: Buf[usize] = buf()
        index[root] = counter
        low[root] = counter
        counter += 1
        stack.push(root)
        on_stack[root] = true
        frames.push(root)
        positions.push(0)
        while frames.len() > 0
            val top = frames.len() - 1
            val v = frames[top]
            val p = positions[top]
            if p < f.out[v].len()
                positions[top] = p + 1
                val w = f.edges[f.out[v][p]].to
                if index[w] == n
                    index[w] = counter
                    low[w] = counter
                    counter += 1
                    stack.push(w)
                    on_stack[w] = true
                    frames.push(w)
                    positions.push(0)
                elif on_stack[w] && index[w] < low[v]
                    low[v] = index[w]
            else
                frames.truncate(top)
                positions.truncate(top)
                if top > 0
                    val u = frames[top - 1]
                    if low[v] < low[u] then low[u] = low[v]
                if low[v] == index[v]
                    var done = false
                    while !done
                        val w = stack[stack.len() - 1]
                        stack.truncate(stack.len() - 1)
                        on_stack[w] = false
                        component[w] = count
                        done = w == v
                    count += 1
    component


/** The code or type each node of `path` belongs to, in order, each named once per stretch. */
private cycle_text(c: *Checker, f: *Flow, path: Buf[usize]) -> string
    var out = ""
    var last = ""
    var count = 0
    for n in path
        val label = node_label(c, f, n)
        if label == "" || label == last then continue
        if out != "" then out = out + " -> "
        out = out + s"`$label`"
        last = label
        count += 1
    // A cycle within one function or type still names it at both ends.
    if count == 1 then out = out + s" -> `$last`"
    out

private node_label(c: *Checker, f: *Flow, n: usize) -> string
    val key = f.keys[n]
    if key >= (1usize << 62)
        val d = c.data[data_of_key(key)]
        val block = data_slot(key) / 256
        // A refined variant's parameters are its own nodes, named by the variant.
        if block > 0 && block - 1 < d.variants.len() then return d.variants[block - 1].name
        return d.name
    if key >= (1usize << 61) then return c.classes[(key - (1usize << 61)) / 256].name
    val symbol = c.symbols[key / 256]
    if symbol.owner_class is Some(k)
        if symbol.constructor then return c.classes[k].name
        return s"${c.classes[k].name}.${symbol.decl.name}"
    if symbol.receiver is Some(r)
        return *r match
            Data(_, name, _) -> s"$name.${symbol.decl.name}"
            Class(_, name, _) -> s"$name.${symbol.decl.name}"
            _ -> s"${type_name(r)}.${symbol.decl.name}"
    symbol.decl.name

private param_name(c: *Checker, f: *Flow, n: usize) -> string
    val key = f.keys[n]
    if key >= (1usize << 62)
        val d = c.data[data_of_key(key)]
        val block = data_slot(key) / 256
        val i = data_slot(key) % 256
        val params = if block > 0 && block - 1 < d.variants.len() then d.variants[block - 1].params else d.decl.type_params
        return if i < params.len() then params[i].name else "_"
    if key >= (1usize << 61)
        val k = (key - (1usize << 61)) / 256
        val i = (key - (1usize << 61)) % 256
        val params = c.classes[k].decl.type_params
        return if i < params.len() then params[i].name else "_"
    val params = c.symbols[key / 256].type_params
    val i = key % 256
    if i < params.len() then params[i].name else "_"
