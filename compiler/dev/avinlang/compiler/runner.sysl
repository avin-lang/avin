module dev.avinlang.compiler

import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.env.current_exe
import sysl.fs.{canonicalize, exists, is_dir, make_dir_all, metadata, read_text, write_text_atomic}
import sysl.path.{file_name, parent, stem}
import sysl.process.{Exited, Signalled, Status, Stdio, TimedOut, capture, run}
import sysl.text.{StrBuilder, from_utf8_unchecked, parse_int, str_builder}
import sysl.time.monotonic

// `avin run` and `avin test` build into a cache beside the program, so running a program that has not
// changed starts it at once. A cached executable is kept with a record of what it was built from: a
// key over every input to the build, and for a test executable the tests it holds, which the runner
// reports without compiling the program again.

/** An executable built for `avin run` or `avin test`. */
struct Built
    path: string
    tests: Buf[TestEntry]
    /** Whether this call built it, rather than finding it in the cache built from the same inputs. */
    built: bool

/** Where the executables built for the program at `program` are kept: `.avin/build` in its root
 * directory, or for a program of one file in the directory that holds the file. */
build_cache(program: string) -> string
    if is_dir(program) then return program + "/.avin/build"
    parent(program).unwrap_or(".") + "/.avin/build"

/** The executable of the program at `program`, made of `files`: the program itself, or with
 * `testing` the executable that runs its tests, at `optimization` (`-O0` or `-O2`). It is taken from
 * the cache when one there was built from the same inputs, and otherwise built and kept there. An
 * error is the program's diagnostics, rendered, or a message saying why it could not be built. */
cached_build(tc: Toolchain, program: string, files: Buf[ProgramFile], testing: bool, optimization: string, sysl: Buf[SyslPackage]) -> Result[Built, string]
    val cache = build_cache(program)
    val kind = if testing then "-tests" else ""
    // A program named `.` is named by the directory it is.
    val name = stem(canonicalize(program).unwrap_or(program)).unwrap_or("program")
    val binary = cache + "/" + name + kind + optimization
    val record = binary + ".key"
    val key = build_key(tc, files, testing, optimization, sysl)
    if exists(binary)
        if read_text(record) is Ok(text)
            if read_record(text, key) is Some(tests) then return Ok(Built(binary, tests, false))
    val compiled = compile_program(tc, files, testing, sysl)
    if compiled.diagnostics != "" then return Err(compiled.diagnostics)
    make_dir_all(cache).map_err(e -> s"avin: $cache: ${e.to_string()}")?
    link(tc, compiled.llvm.unwrap_or(""), compiled.archive, binary, optimization).map_err(message -> "avin: " + message)?
    write_text_atomic(record, write_record(key, compiled.tests)).map_err(e -> s"avin: $record: ${e.to_string()}")?
    Ok(Built(binary, compiled.tests, true))

// Everything an executable is built from: the compiler, which a version names and the compiler's own
// executable stamps, the kind of executable and its optimization, the runtime's sources, the
// standard library's, the Sysl packages its bindings reach, and the program's.
private build_key(tc: Toolchain, files: Buf[ProgramFile], testing: bool, optimization: string, sysl: Buf[SyslPackage]) -> string
    var text = str_builder()
    text.push("avin " + Version + "\n")
    if current_exe() is Some(exe)
        text.push(exe + "\n")
        if metadata(exe) is Ok(m) then text.push(m.modified.us.to_string() + "\n")
    text.push((if testing then "tests " else "program ") + optimization + "\n")
    text.push(runtime_fingerprint(tc))
    text.push(shim_manifest(tc.runtime_dir(), sysl) + sysl_fingerprint(sysl))
    library_files(tc.library_dir()) match
        Ok(library) -> push_files(&text, library)
        Err(message) -> text.push(message + "\n")
    push_files(&text, files)
    content_key(text.finish())

private push_files(text: *StrBuilder, files: Buf[ProgramFile])
    for f in files
        text.push(f.src.name + "\n" + f.module_name.unwrap_or("") + "\n")
        text.push(from_utf8_unchecked(f.src.bytes) + "\n")

// The record kept beside a cached executable: its key on the first line, then a line for each test,
// its fields separated by tabs, each with its backslashes, tabs and line breaks escaped: the line
// number, file, module, `should_trap`, `ignore` and `timeout` (empty for none, and otherwise the
// value after `=`), the module's four hooks, and the name.
private write_record(key: string, tests: Buf[TestEntry]) -> string
    var out = str_builder()
    out.push(key + "\n")
    for t in tests
        val fields = [t.line.to_string(), t.file, t.module_name, optional(t.should_trap), optional(t.ignore), optional(seconds_of(t.timeout)),t.setup, t.teardown, t.setup_all, t.teardown_all, t.name]
        for j in 0..<fields.len
            if j > 0 then out.push("\t")
            out.push(escaped(fields[j]))
        out.push("\n")
    out.finish()

private seconds_of(timeout: Option[int]) -> Option[string] = timeout match
    Some(s) -> Some(s.to_string())
    None -> None

private optional(value: Option[string]) -> string = value match
    Some(v) -> "=" + v
    None -> ""

private escaped(text: string) -> string = text.replace_all("\\", "\\\\").replace_all("\t", "\\t").replace_all("\n", "\\n")

private unescaped(text: string) -> string
    var out = str_builder()
    var escaping = false
    for b in text.bytes
        if escaping
            out.push_char(if b == u8('t') then '\t' elif b == u8('n') then '\n' else char(b))
            escaping = false
        elif b == u8('\\') then escaping = true
        else out.push_char(char(b))
    out.finish()

// The value of a field `optional` wrote.
private read_optional(field: string) -> Option[string] = if field.starts_with("=") then Some(field[1..]) else None

// The tests a record holds, when its key is `key`.
private read_record(text: string, key: string) -> Option[Buf[TestEntry]]
    val lines = text.lines()
    if lines.len == 0 || lines[0] != key then return None
    var tests: Buf[TestEntry] = buf()
    for i in 1..<lines.len
        val raw = lines[i].split("\t")
        if raw.len != 11 then return None
        var f: Buf[string] = buf()
        for field in raw
            f.push(unescaped(field))
        val line = parse_int(f[0]) match
            Ok(n) -> usize(n)
            Err(_) -> return None
        var timeout: Option[int] = None
        if read_optional(f[5]) is Some(seconds)
            timeout = parse_int(seconds) match
                Ok(n) -> Some(int(n))
                Err(_) -> return None
        tests.push(TestEntry(f[10], f[1], line, f[2], read_optional(f[3]), read_optional(f[4]), timeout, f[6], f[7], f[8], f[9]))
    Some(tests)

/** Runs `binary` with `args`, its output going where `stdout` and `stderr` say, and answers the
 * status `avin run` exits with: the program's own, or for a program a signal stopped, a trap among
 * them, 128 and the signal's number, as a shell reports it. */
run_binary(binary: string, args: []const string, stdout: Stdio, stderr: Stdio) -> Result[int, string]
    val state = run(binary, args, stdout = stdout, stderr = stderr).map_err(e -> s"avin: could not run $binary: ${e.to_string()}")?
    Ok(state match
        Exited(code) -> code
        Signalled(signal) -> 128 + signal
        TimedOut -> 1)

/** How long one test may run, in milliseconds, before the runner stops it and reports it failed,
 * unless the test gives a limit of its own; and how long each test hook may run. */
const TestTimeout: int = 60000

/** Runs the tests of `built` whose name, or the file they are written in, contains `filter`, each in
 * a process of its own, so a test that traps stops only itself. The report goes through `say`: the
 * tests grouped by file, in the order they are declared, each `ok` or `FAIL` with its name and how
 * long it took, or `skip` with the reason an ignored test is not run; under a failure, why it failed
 * and everything it printed, each line after `> `; a hook that failed on a row of its own; then how
 * many passed, failed and were ignored. Files are named from `root`, the program's directory, when
 * it is one. Answers 0 when every test that ran passed and every hook succeeded, and 1 otherwise. */
run_tests(built: Built, root: string, filter: string, say: string -> unit) -> int
    var selected: Buf[usize] = buf()
    for i in 0..<built.tests.len()
        val t = built.tests[i]
        if filter == "" || t.name.contains(filter) || shown_file(t.file, root).contains(filter) then selected.push(i)
    val total = built.tests.len()
    val count = selected.len()
    val noun = if total == 1 then "test" else "tests"
    say(if count == total then s"running $count $noun" else s"running $count of $total $noun")
    var width = 0usize
    for i in selected
        if built.tests[i].name.len > width then width = built.tests[i].name.len
    // The last test each module runs, after which its `@teardown_all` runs. An ignored test runs
    // nothing, not even its module's hooks.
    var last: Map[string, usize] = map()
    for i in selected
        if built.tests[i].ignore is None then last.put(built.tests[i].module_name, i)
    // Each module whose `@setup_all` has run, and how it ended: "" when it succeeded.
    var set_up: Map[string, string] = map()
    var passed = 0usize
    var failed = 0usize
    var ignored = 0usize
    var file = ""
    val started = monotonic()
    for i in selected
        val t = built.tests[i]
        val shown = shown_file(t.file, root)
        if shown != file
            say("")
            say(shown)
            file = shown
        val padded = t.name + " ".repeat(width - t.name.len)
        if t.ignore is Some(reason)
            ignored += 1
            say(s"  skip  $padded  ignored: $reason")
            continue
        if t.setup_all != "" && set_up.get(t.module_name) is None
            val ran = run_part(built, i, "a", TestTimeout)
            set_up.put(t.module_name, if ran.status == Exited(0) then "" else ran.reason)
            if ran.status != Exited(0)
                failed += 1
                say(s"  FAIL  @setup_all ${t.setup_all}")
                report(ran, say)
        if set_up.get(t.module_name) is Some(fault)
            if fault != ""
                failed += 1
                say(s"  FAIL  ${t.name}")
                say(s"        not run: `@setup_all` `${t.setup_all}` failed")
                continue
        val limit = t.timeout match
            Some(seconds) -> seconds * 1000
            None -> TestTimeout
        val began = monotonic()
        val ran = run_part(built, i, "", limit)
        val ms = (monotonic() - began).us / 1000
        // Why the test failed, or "" when it passed; whether its process ended before the module's
        // `@teardown` could run in it; and whether that teardown, run in the test's process, failed.
        var verdict = ""
        var teardown_apart = false
        var teardown_failed = false
        if ran.status == Exited(0)
            if t.should_trap is Some(_) then verdict = "returned, and should have trapped"
        elif ran.status is TimedOut
            verdict = ran.reason
            teardown_apart = ran.ready && !ran.returned
        elif !ran.ready
            verdict = if t.setup != "" && !ran.reason.starts_with(CouldNotRun) then s"not run: `@setup` `${t.setup}` failed: ${ran.reason}" else ran.reason
        elif !ran.returned
            teardown_apart = true
            verdict = ran.reason
            if t.should_trap is Some(text)
                if ran.status is Signalled(_)
                    verdict = if text == "" || ran.everything.contains(text) then "" else s"trapped without printing \"$text\": ${ran.reason}"
        elif t.teardown != ""
            teardown_failed = true
            if t.should_trap is Some(_) then verdict = "returned, and should have trapped"
        else verdict = ran.reason
        if verdict == ""
            passed += 1
            say(s"  ok    $padded  ${ms}ms")
        else
            failed += 1
            say(s"  FAIL  $padded  ${ms}ms")
            say("        " + verdict)
            if !teardown_failed then printed(ran, say)
        if teardown_failed
            failed += 1
            say(s"  FAIL  @teardown ${t.teardown}")
            report(ran, say)
        if teardown_apart && t.teardown != ""
            val apart = run_part(built, i, "t", TestTimeout)
            if apart.status != Exited(0)
                failed += 1
                say(s"  FAIL  @teardown ${t.teardown}")
                report(apart, say)
        if t.teardown_all != "" && last.get(t.module_name) is Some(final)
            if final == i
                val ran_last = run_part(built, i, "z", TestTimeout)
                if ran_last.status != Exited(0)
                    failed += 1
                    say(s"  FAIL  @teardown_all ${t.teardown_all}")
                    report(ran_last, say)
    say("")
    val elapsed = (monotonic() - started).us / 1000
    say(if ignored > 0 then s"$passed passed, $failed failed, $ignored ignored — ${elapsed}ms" else s"$passed passed, $failed failed — ${elapsed}ms")
    if failed > 0 then 1 else 0
end run_tests

/** One process of a test's run: how it ended; whether the module's `@setup` and then the test had
 * returned in it; why it stopped, for one that did not exit 0; what it printed, standard output then
 * standard error without the trap's report; and everything it wrote, the trap's report included. */
private struct Ran
    status: Status
    ready: bool
    returned: bool
    reason: string
    printed: Buf[string]
    everything: string

/** The reason given for a process that could not be started. */
private const CouldNotRun: string = "could not be run"

// Runs one part of test `i` in a process of its own: the module's setup, the test and the module's
// teardown for `part` "", or one hook (`part` "t", "a" or "z"), stopping it after `limit` milliseconds
// unless `limit` is 0. A test reads no input: it never waits on the terminal `avin test` was started
// from.
private run_part(built: Built, i: usize, part: string, limit: int) -> Ran
    var args: Buf[string] = buf()
    args.push(i.to_string())
    if part != "" then args.push(part)
    val output = capture(built.path, args.view(), stderr = true, timeout = limit, stdin = Stdio.FromPath("/dev/null")) match
        Ok(o) -> o
        Err(e) -> return Ran(Exited(1), false, false, s"$CouldNotRun: ${e.to_string()}", buf(), "")
    val err = output.err.unwrap_or("")
    var reason = output.status match
        Exited(code) -> s"exited with status $code"
        Signalled(signal) -> s"stopped by signal $signal"
        TimedOut -> s"timed out after ${limit / 1000}s"
    var printed: Buf[string] = buf()
    for line in output.text.lines()
        printed.push(line)
    var ready = false
    var returned = false
    var trapped = false
    for line in err.lines()
        if line == TestReady then ready = true
        elif line == TestReturned then returned = true
        elif !trapped && line.starts_with(TrapPrefix)
            reason = line[TrapPrefix.len..]
            trapped = true
        else printed.push(line)
    Ran(output.status, ready, returned, reason, printed, output.text + err)

// A failed hook's report: why it stopped, then what it printed.
private report(ran: Ran, say: string -> unit)
    say("        " + ran.reason)
    printed(ran, say)

private printed(ran: Ran, say: string -> unit)
    for line in ran.printed
        say("        > " + line)

/** How the runtime begins its report of a trap on standard error. */
private const TrapPrefix: string = "avin: trap: "

// A test's file as the report names it: its path under the program's root directory, or for a
// program of one file, its name.
private shown_file(file: string, root: string) -> string
    if is_dir(root) && file.starts_with(root + "/") then return file[root.len + 1..]
    file_name(file).unwrap_or(file)
