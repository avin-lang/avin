module dev.avinlang.compiler

import sh.sysl.hocon.{Field, Value, parse as parse_hocon}
import sh.sysl.parsing.{Diagnostic, Source, Span, error, source_of}
import sysl.buf.{Buf, buf}
import sysl.crypto.sha256
import sysl.encoding.hex_string
import sysl.fs.{cache_dir, canonicalize, copy_file, current_dir, entries, exists, is_dir, make_dir_all, pending_name, publish_dir, read_bytes, read_text, remove_dir_all, remove_file, walk, write_text, write_text_atomic}
import sysl.path.{is_absolute, normalize, parent}
import sysl.process.capture
import sysl.slices.sort
import sysl.text.{parse_long, str_builder}

// Packages. A directory holding an `avin.hocon` is a package: the manifest names it, gives its
// version, and lists the packages it depends on. The directory is the package's program root, so its
// subdirectories are its modules, exactly as for a program without a manifest. A dependency is a git
// repository read at a release tag, a directory beside the package, or another member of the
// workspace the package is in. A dependency's modules come in under their own names; its root
// directory's files and its `tests` directory are its own and do not.
//
// Fetched packages are kept in the machine's cache, one directory per coordinate and version, with
// the hash of the tree recorded beside it when it was fetched. `avin.sum`, beside the manifest,
// records that hash for every fetched package the project has read, and a package whose hash differs
// from its line is refused.

/** The file that makes a directory a package. */
const ManifestName: string = "avin.hocon"

/** The file, beside a manifest, that records what each fetched package hashed to. */
const SumName: string = "avin.sum"

/** How a recorded hash begins: the algorithm that made it. */
const DigestPrefix: string = "sha256:"

/** Where a dependency's source comes from. */
enum Origin
    /** A git repository, by its package's coordinate, at the tag of `version`. The coordinate is the
     * repository's (`github.com/owner/name`) for the package at its root, and the repository's, `//`
     * and a directory (`github.com/owner/name//solid`) for a member of it. */
    Git(coordinate: string, version: string)
    /** A git repository, by its package's coordinate, at the commit `rev` names: a full or
     * abbreviated lowercase hexadecimal id. */
    Rev(coordinate: string, rev: string)
    /** A directory, as the manifest wrote it, for a package developed beside the one using it. */
    Local(dir: string)
    /** The member of the package's workspace whose package has the dependency's name. */
    Member

/** A dependency as a manifest lists it: its name there, where it comes from, and where it was written;
 * whether it is taken only while a feature turns it on; and which of its package's features it asks
 * for: its defaults unless `default_features` is false, less those in `without`, and `features`. */
struct Dependency
    label: string
    origin: Origin
    span: Span
    optional: bool
    default_features: bool
    features: Buf[string]
    without: Buf[string]

/** A package's manifest, read and checked. Its `sysl-dependencies` block names the Sysl packages,
 * other than Sysl's standard library, its bindings reach; they are written as Avin dependencies are,
 * and Sysl fetches and checks them when it builds the bindings' shims. */
struct Manifest
    dir: string
    src: Source
    /** Whether the manifest has a `package` block; a workspace's root may have none. */
    has_package: bool
    name: string
    version: string
    description: string
    /** The least Avin the package builds with, as `avin` in its `package` block writes it, or empty
     * where it names none; and where the value is written. */
    avin: string
    avin_span: Span
    dependencies: Buf[Dependency]
    /** The Sysl packages the package's bindings reach beyond Sysl's standard library. A `Member`
     * origin is never among them: a workspace's members are Avin packages. */
    sysl_dependencies: Buf[Dependency]
    /** Whether the manifest lists a workspace, and the directories it lists, as written. */
    has_workspace: bool
    workspace: Buf[string]
    /** The features the package declares. */
    features: Buf[Feature]
    /** The C libraries the package's C bindings call, in the order its `c-libraries` block lists
     * them. */
    c_libraries: Buf[CLibrary]

/** A C library a package's manifest names under `c-libraries`: its name there; the `pkg-config`
 * module that finds it, or the libraries `link` names directly; the headers the package's bindings
 * are checked against, as written; and what a build that cannot find it says to do. `package` is the
 * name of the package whose manifest names it. */
struct CLibrary
    package: string
    label: string
    pkg_config: Option[string]
    link: Buf[string]
    headers: Buf[string]
    install: string

/** The file that makes a directory a Sysl package. */
const SyslManifestName: string = "sysl.hocon"

/** The manifest of the package at `dir`, or the first thing wrong with it, rendered with its place. */
read_manifest(dir: string) -> Result[Manifest, string] = read_manifest_named(dir, ManifestName)

/** The manifest in the file `name` of `dir`, read and checked as `read_manifest` reads a package's. */
read_manifest_named(dir: string, name: string) -> Result[Manifest, string]
    val file = dir + "/" + name
    val text = read_text(file).map_err(e -> s"avin: $file: ${e.to_string()}")?
    val src = source_of(file, text)
    manifest_from(dir, src, Version).map_err(d -> d.render(src))

/** The manifest `src` holds, for the package at `dir`, as the Avin whose version is `running` reads
 * it, or the first thing wrong with it. A package needing a later Avin than `running` is refused at
 * its `avin` key before anything else in it is read: a manifest written for a later Avin may hold
 * what this one does not know, and the upgrade is what it needs. */
manifest_from(dir: string, src: Source, running: string) -> Result[Manifest, Diagnostic]
    val doc = parse_hocon(src)?
    if later_avin_required(doc.root, running) is Some(d) then return Err(d)
    var m = Manifest(dir, src, false, "", "", "", "", Span(0, 0), buf(), buf(), false, buf(), buf(), buf())
    read_fields(&m, doc.root)?
    Ok(m)

/** Whether the Avin whose version is `running` builds a package that needs at least `required`:
 * versions are compared number by number, so `0.0.9` comes before `0.0.18`. */
avin_satisfies(running: string, required: string) -> bool = !version_after(required, running)

// The error for a manifest at `root` whose `package` block asks, in a well-formed `avin`, for a later
// Avin than `running`: at the value, naming the package, what it needs and what is running.
private later_avin_required(root: Value, running: string) -> Option[Diagnostic]
    for f in root.fields()
        if f.key != "package" || !f.value.is_obj() then continue
        var name = ""
        var version = ""
        var required = ""
        var at = Span(0, 0)
        for g in f.value.fields()
            val text = g.value.as_text().unwrap_or("")
            if g.key == "name"
                name = text
            elif g.key == "version"
                version = text
            elif g.key == "avin"
                required = text
                at = g.value.span
        if required == "" || !valid_version(required) || avin_satisfies(running, required) then continue
        val who = if name == "" then "this package" elif version == "" then s"`$name`" else s"`$name` $version"
        return Some(error(at, s"$who needs Avin $required or later, and this is Avin $running: upgrade Avin to $required or later to build it"))
    None

private read_fields(m: *Manifest, root: Value) -> Result[unit, Diagnostic]
    var dependencies = Span(0, 0)
    var sysl_dependencies = Span(0, 0)
    var features = Span(0, 0)
    var c_libraries = Span(0, 0)
    for f in root.fields()
        if f.key == "package"
            m.has_package = true
            read_package(m, f)?
        elif f.key == "dependencies"
            dependencies = f.key_span
            read_dependencies(f, false, &m.dependencies)?
        elif f.key == "sysl-dependencies"
            sysl_dependencies = f.key_span
            read_dependencies(f, true, &m.sysl_dependencies)?
        elif f.key == "c-libraries"
            c_libraries = f.key_span
            read_c_libraries(f, &m.c_libraries)?
        elif f.key == "workspace"
            read_workspace(m, f)?
        elif f.key == "features"
            features = f.key_span
            read_features(f, &m.features)?
        else
            return Err(error(f.key_span, s"`${f.key}` is not a key of $ManifestName, which holds `package`, `dependencies`, `sysl-dependencies`, `c-libraries`, `features` and `workspace`"))
    if !m.has_package && !m.has_workspace
        return Err(error(Span(0, 0), s"$ManifestName has no `package` block: a package is named and versioned, `package { name = \"geom\", version = \"0.1.0\" }`"))
    if !m.has_package && m.dependencies.len() > 0
        return Err(error(dependencies, "a workspace with no `package` block compiles nothing of its own, so its dependencies would reach nothing: name each in the member that imports it"))
    if !m.has_package && m.sysl_dependencies.len() > 0
        return Err(error(sysl_dependencies, "a workspace with no `package` block compiles nothing of its own, so its Sysl dependencies would reach nothing: name each in the member whose bindings reach it"))
    if !m.has_package && m.c_libraries.len() > 0
        return Err(error(c_libraries, "a workspace with no `package` block compiles nothing of its own, so it has no C bindings to call its C libraries: name each in the member whose bindings call it"))
    for i in 0..<m.c_libraries.len()
        m.c_libraries[i].package = m.name
    if !m.has_package && m.features.len() > 0
        return Err(error(features, "a workspace with no `package` block compiles nothing of its own, so it has no features: declare each in the member it belongs to"))
    check_features(m.dir, m.features, m.dependencies)?
    Ok(())

private read_package(m: *Manifest, f: Field) -> Result[unit, Diagnostic]
    if !f.value.is_obj() then return Err(error(f.value.span, "`package` is a block, `package { name = \"geom\", version = \"0.1.0\" }`"))
    var named = false
    var versioned = false
    for g in f.value.fields()
        if g.key == "name"
            m.name = text_of(g)?
            if !valid_package_name(m.name) then return Err(error(g.value.span, s"`${m.name}` is not a package name: ${PackageNameRule}"))
            named = true
        elif g.key == "version"
            m.version = text_of(g)?
            if !valid_version(m.version) then return Err(error(g.value.span, bad_version(m.version)))
            versioned = true
        elif g.key == "description"
            m.description = text_of(g)?
        elif g.key == "avin"
            m.avin = text_of(g)?
            if !valid_version(m.avin) then return Err(error(g.value.span, s"`${m.avin}` is not a version of Avin: `avin` names the least Avin the package builds with, three numbers such as `$Version`"))
            m.avin_span = g.value.span
        else
            return Err(error(g.key_span, s"`${g.key}` is not a key of `package`, which holds `name`, `version`, `description` and `avin`"))
    if !named then return Err(error(f.key_span, "the `package` block has no `name`: every package is named, `name = \"geom\"`"))
    if !versioned then return Err(error(f.key_span, "the `package` block has no `version`: every package has one, `version = \"0.1.0\"`"))
    Ok(())

// The dependencies a `dependencies` block lists, or with `sysl` a `sysl-dependencies` block, whose
// entries are written the same way except that a workspace holds no Sysl package.
private read_dependencies(f: Field, sysl: bool, into: *Buf[Dependency]) -> Result[unit, Diagnostic]
    if !f.value.is_obj() then return Err(error(f.value.span, s"`${f.key}` is a block naming each dependency, `json { git = \"github.com/owner/json\", version = \"1.0.0\" }`"))
    for d in f.value.fields()
        if !valid_package_name(d.key) then return Err(error(d.key_span, s"`${d.key}` is not a dependency's name: ${PackageNameRule}"))
        if sysl && !d.value.is_obj()
            return Err(error(d.value.span, s"the Sysl dependency `${d.key}` is a block saying where it comes from: `{ git = \"github.com/owner/name\", version = \"1.0.0\" }` or `{ path = \"../name\" }`"))
        if !d.value.is_obj()
            return Err(error(d.value.span, s"the dependency `${d.key}` is a block saying where it comes from: `{ git = \"github.com/owner/name\", version = \"1.0.0\" }`, `{ path = \"../name\" }` or `{ workspace = true }`"))
        var git: Option[string] = None
        var version: Option[string] = None
        var rev: Option[string] = None
        var local: Option[string] = None
        var in_workspace = false
        var member: Option[string] = None
        var optional = false
        var default_features = true
        var features: Buf[string] = buf()
        var without: Buf[string] = buf()
        var without_spans: Buf[Span] = buf()
        for g in d.value.fields()
            if g.key == "git"
                val c = text_of(g)?
                if !valid_coordinate(c) then return Err(error(g.value.span, s"`$c` is not a git coordinate: a coordinate names a repository as `host/owner/name`, such as `github.com/owner/json`, with no `https://` and no `.git`"))
                git = Some(c)
            elif g.key == "version"
                val v = text_of(g)?
                if !valid_version(v) then return Err(error(g.value.span, bad_version(v)))
                version = Some(v)
            elif g.key == "rev"
                val v = text_of(g)?
                if !valid_rev(v) then return Err(error(g.value.span, bad_rev(v)))
                rev = Some(v)
            elif g.key == "path"
                val p = text_of(g)?
                if p == "" then return Err(error(g.value.span, "a dependency's `path` names a directory"))
                local = Some(p)
            elif g.key == "workspace" && sysl
                return Err(error(g.key_span, s"`workspace` is not a key of a Sysl dependency, which holds `git` with `version` or `rev`, or `path`: a workspace's members are Avin packages"))
            elif g.key == "workspace"
                g.value.as_bool() match
                    Some(true) -> in_workspace = true
                    _ -> return Err(error(g.value.span, "a dependency's `workspace` is `true`: the dependency is the member of the workspace with its name"))
            elif sysl
                return Err(error(g.key_span, s"`${g.key}` is not a key of a Sysl dependency, which holds `git` with `version` or `rev`, or `path`"))
            elif g.key == "member"
                val dir = text_of(g)?
                if !valid_member(dir) then return Err(error(g.value.span, s"`$dir` is not a member's directory: ${MemberRule}"))
                member = Some(dir)
            elif g.key == "optional"
                optional = g.value.as_bool() match
                    Some(b) -> b
                    None -> return Err(error(g.value.span, "a dependency's `optional` is `true` or `false`: an optional dependency is taken only while a feature turns it on"))
            elif g.key == "default_features"
                default_features = g.value.as_bool() match
                    Some(b) -> b
                    None -> return Err(error(g.value.span, "a dependency's `default_features` is `true` or `false`"))
            elif g.key == "features"
                if !g.value.is_arr() then return Err(error(g.value.span, "a dependency's `features` is a list of the package's features it asks for, `features = [desktop, -colour]`"))
                for v in g.value.items()
                    val name = v.as_text() match
                        Some(s) -> s
                        None -> return Err(error(v.span, "a member of a dependency's `features` is a feature's name, or `-` and one"))
                    val bare = if name.starts_with("-") then name[1..] else name
                    if !valid_feature_name(bare) then return Err(error(v.span, s"`$name` is not a feature's name, or `-` and one"))
                    if name.starts_with("-")
                        without.push(bare)
                        without_spans.push(v.span)
                    else features.push(name)
            else
                return Err(error(g.key_span, s"`${g.key}` is not a key of a dependency, which holds `git` with `version` or `rev` and optionally `member`, `path`, or `workspace`, and `optional`, `features` and `default_features`"))
        if !default_features && without.len() > 0
            return Err(error(without_spans[0], s"`-${without[0]}` takes away a default, and `default_features = false` leaves every default off already"))
        var sources = 0
        if git is Some(_) then sources += 1
        if local is Some(_) then sources += 1
        if in_workspace then sources += 1
        if sources != 1 && sysl
            return Err(error(d.key_span, s"the Sysl dependency `${d.key}` says once where it comes from: `git` with a `version` or a `rev`, or `path`"))
        if sources != 1
            return Err(error(d.key_span, s"the dependency `${d.key}` says once where it comes from: `git` with a `version` or a `rev`, `path`, or `workspace = true`"))
        if member is Some(_) && git is None
            return Err(error(d.key_span, s"the dependency `${d.key}` has a `member`, which belongs with `git`: a member is a package in a directory of a fetched repository"))
        if git is Some(repository)
            // A member is a package of its own, named by the repository's coordinate, `//` and its directory.
            val c = member match
                Some(dir) -> repository + "//" + dir
                None -> repository
            if version is Some(_) && rev is Some(_)
                return Err(error(d.key_span, s"the dependency `${d.key}` has a `version` and a `rev`: a git dependency is read at a release or at a commit, not both"))
            if rev is Some(x)
                into.push(Dependency(d.key, Rev(c, x), d.key_span, optional, default_features, features, without))
                continue
            version match
                Some(v) -> into.push(Dependency(d.key, Git(c, v), d.key_span, optional, default_features, features, without))
                None -> return Err(error(d.key_span, s"the dependency `${d.key}` names a repository and no version: a git dependency is read at a release, `version = \"1.0.0\"` being the tag `v1.0.0`, or at a commit, `rev = \"3f9a2c1\"`"))
            continue
        if rev is Some(_) then return Err(error(d.key_span, s"the dependency `${d.key}` has a `rev`, which belongs with `git`: a directory is read as it stands"))
        if version is Some(_) then return Err(error(d.key_span, s"the dependency `${d.key}` has a `version`, which belongs with `git`: a directory is read as it stands"))
        if local is Some(p) then into.push(Dependency(d.key, Local(p), d.key_span, optional, default_features, features, without))
        else into.push(Dependency(d.key, Member, d.key_span, optional, default_features, features, without))
    Ok(())

// The C libraries a `c-libraries` block names: each a block with `pkg-config` or `link`, or neither
// for the C library itself, `headers` and `install`.
private read_c_libraries(f: Field, into: *Buf[CLibrary]) -> Result[unit, Diagnostic]
    if !f.value.is_obj() then return Err(error(f.value.span, "`c-libraries` is a block naming each C library, `zlib { pkg-config = \"zlib\", headers = [\"zlib.h\"] }`"))
    for d in f.value.fields()
        if !valid_package_name(d.key) then return Err(error(d.key_span, s"`${d.key}` is not a C library's name: ${PackageNameRule}"))
        if !d.value.is_obj() then return Err(error(d.value.span, s"the C library `${d.key}` is a block saying how to find it and which headers declare it: `{ pkg-config = \"zlib\", headers = [\"zlib.h\"] }`"))
        var library = CLibrary("", d.key, None, buf(), buf(), "")
        var linked = false
        for g in d.value.fields()
            if g.key == "pkg-config"
                val module_name = text_of(g)?
                if module_name == "" || module_name.contains(" ") then return Err(error(g.value.span, "`pkg-config` names one module, as `pkg-config --list-all` lists it"))
                library.pkg_config = Some(module_name)
            elif g.key == "link"
                linked = true
                library.link = word_list(g, "`link` is a list of the libraries passed to the linker, each as `-l` would name it, `link = [\"z\"]`")?
            elif g.key == "headers"
                library.headers = word_list(g, "`headers` is a list of the headers the bindings are checked against, `headers = [\"zlib.h\"]` or `[\"<stdlib.h>\"]`")?
            elif g.key == "install"
                library.install = text_of(g)?
            else return Err(error(g.key_span, s"`${g.key}` is not a key of a C library, which holds `pkg-config` or `link`, `headers` and `install`"))
        if library.pkg_config is Some(_) && linked
            return Err(error(d.key_span, s"the C library `${d.key}` names both `pkg-config` and `link`: `pkg-config` answers the flags it links with, so it is one or the other"))
        into.push(library)
    Ok(())

// A list of strings none of which is empty or holds a space, or `wrong` at the list.
private word_list(f: Field, wrong: string) -> Result[Buf[string], Diagnostic]
    if !f.value.is_arr() then return Err(error(f.value.span, wrong))
    var out: Buf[string] = buf()
    for v in f.value.items()
        val word = v.as_text() match
            Some(t) -> t
            None -> return Err(error(v.span, wrong))
        if word == "" || word.contains(" ") then return Err(error(v.span, wrong))
        out.push(word)
    Ok(out)

private read_workspace(m: *Manifest, f: Field) -> Result[unit, Diagnostic]
    val wrong = error(f.value.span, "`workspace` is a list of the members' directories, each relative to this file, `workspace = [\"app\", \"libs/*\"]`")
    val dirs = f.value.as_text_list() match
        Some(d) -> d
        None -> return Err(wrong)
    if !f.value.is_arr() then return Err(wrong)
    for d in dirs
        if d == "" || is_absolute(d) then return Err(wrong)
        for segment in d.split("/")
            if segment == "" || segment == "." || segment == ".." || segment.contains("**")
                return Err(error(f.value.span, s"`$d` is not a member's directory: an entry is a relative path with no `.` or `..`, and `*` stands for part of one directory's name"))
        m.workspace.push(d)
    m.has_workspace = true
    Ok(())

private text_of(f: Field) -> Result[string, Diagnostic] = f.value.as_text() match
    Some(s) -> Ok(s)
    None -> Err(error(f.value.span, s"`${f.key}` is written as a string, in quotes"))

private const PackageNameRule: string = "a name begins with a lowercase letter, and holds lowercase letters, digits, `_` and `-`"

private bad_version(v: string) -> string = s"`$v` is not a version: a version is three numbers, `major.minor.patch`, such as `0.1.0`"

/** Whether `name` names a package: a lowercase letter, then lowercase letters, digits, `_` and `-`. */
valid_package_name(name: string) -> bool
    if name.bytes.len == 0 then return false
    for i in 0..<name.bytes.len
        val b = name.bytes[i]
        val lower = b >= u8('a') && b <= u8('z')
        val other = b >= u8('0') && b <= u8('9') || b == u8('_') || b == u8('-')
        if !lower && !(other && i > 0) then return false
    true

private bad_rev(v: string) -> string = s"`$v` is not a revision: a revision is a commit's id in lowercase hexadecimal, seven to forty digits, such as `3f9a2c1`"

/** Whether `v` names a commit: seven to forty lowercase hexadecimal digits. */
valid_rev(v: string) -> bool = v.bytes.len >= 7 && v.bytes.len <= 40 && all_hex(v)

private valid_full_rev(v: string) -> bool = v.bytes.len == 40 && all_hex(v)

private all_hex(v: string) -> bool
    for b in v.bytes
        if !(b >= u8('0') && b <= u8('9') || b >= u8('a') && b <= u8('f')) then return false
    true

/** Whether `v` is a version: three numbers separated by dots, none with a leading zero. */
valid_version(v: string) -> bool = version_numbers(v) is Some(_)

private version_numbers(v: string) -> Option[Buf[long]]
    val parts = v.split(".")
    if parts.len != 3 then return None
    var out: Buf[long] = buf()
    for p in parts
        if p.bytes.len == 0 || p.bytes.len > 9 || p.bytes.len > 1 && p.bytes[0] == u8('0') then return None
        for b in p.bytes
            if b < u8('0') || b > u8('9') then return None
        out.push(parse_long(p).unwrap_or(0))
    Some(out)

/** Whether version `a` is after version `b`. */
version_after(a: string, b: string) -> bool
    val x = version_numbers(a).unwrap_or(buf())
    val y = version_numbers(b).unwrap_or(buf())
    if x.len() < 3 || y.len() < 3 then return false
    for i in 0..<3
        if x[i] != y[i] then return x[i] > y[i]
    false

/** Whether `c` is a git coordinate: `host/owner/name` and deeper, each segment of letters, digits,
 * `.`, `_` and `-`, with no scheme and no `.git`. */
valid_coordinate(c: string) -> bool
    if c.contains("://") || c.ends_with(".git") then return false
    val segments = c.split("/")
    if segments.len < 3 then return false
    for s in segments
        if s.bytes.len == 0 || s == "." || s == ".." then return false
        for b in s.bytes
            val ok = b >= u8('a') && b <= u8('z') || b >= u8('A') && b <= u8('Z') || b >= u8('0') && b <= u8('9') || b == u8('.') || b == u8('_') || b == u8('-')
            if !ok then return false
    true

private const MemberRule: string = "a member is a directory of the repository relative to its root, with no `.`, `..` or `*`, such as `solid` or `tools/probe`"

/** Whether `dir` names a member of a repository: a relative directory with no empty, `.` or `..`
 * segment and no `*`. */
valid_member(dir: string) -> bool
    if dir == "" || is_absolute(dir) || dir.contains("*") then return false
    for segment in dir.split("/")
        if segment == "" || segment == "." || segment == ".." then return false
    true

/** The repository a package's coordinate names: all of it for the package at the repository's root,
 * and what comes before `//` for a member. */
repository_of(coordinate: string) -> string = coordinate.split("//")[0]

/** The directory of the member a package's coordinate names, relative to its repository's root; empty
 * for the package at the root. */
member_of(coordinate: string) -> string
    val parts = coordinate.split("//")
    if parts.len == 2 then parts[1] else ""

/** The coordinate of the package in the directory `dir` of `repository`: the repository's own for its
 * root, empty `dir`. */
member_coordinate(repository: string, dir: string) -> string = if dir == "" then repository else repository + "//" + dir

/** Whether `c` is a package's coordinate: a git coordinate, optionally followed by `//` and a member's
 * directory. */
valid_package_coordinate(c: string) -> bool
    val parts = c.split("//")
    if parts.len == 1 then return valid_coordinate(c)
    parts.len == 2 && valid_coordinate(parts[0]) && valid_member(parts[1])

// Workspaces.

/** A workspace: its root directory, and its members' directories and package names. */
struct Workspace
    root: string
    members: Buf[string]
    names: Buf[string]

/** The workspace the manifest `m` declares: its member directories, the root first when the root is a
 * package too, and each one's package name. A member is a directory holding a manifest; `*` in an
 * entry stands for part of one directory's name, and an entry with none must name a member. */
workspace_of(m: Manifest) -> Result[Workspace, string]
    var ws = Workspace(m.dir, buf(), buf())
    if m.has_package
        ws.members.push(m.dir)
        ws.names.push(m.name)
    for entry in m.workspace
        var found: Buf[string] = buf()
        expand_members(m.dir, entry.split("/"), 0, &found)
        if found.len() == 0 && !entry.contains("*")
            return Err(s"avin: ${m.src.name}: the workspace lists `$entry`, and ${m.dir}/$entry holds no $ManifestName")
        for dir in found
            if contains(ws.members, dir) then continue
            val member = read_manifest(dir)?
            if !member.has_package then return Err(s"avin: $dir: a workspace's member is a package, and its $ManifestName has no `package` block")
            val i = index_of(ws.names, member.name)
            if i is Some(k) then return Err(s"avin: ${m.src.name}: two members of the workspace are named `${member.name}`, ${ws.members[k]} and $dir")
            ws.members.push(dir)
            ws.names.push(member.name)
    Ok(ws)

private expand_members(dir: string, segments: []string, i: usize, found: *Buf[string])
    if i == segments.len
        if exists(dir + "/" + ManifestName) then found.push(dir)
        return
    val segment = segments[i]
    if !segment.contains("*")
        val next = dir + "/" + segment
        if is_dir(next) then expand_members(next, segments, i + 1, found)
        return
    val names = entries(dir) match
        Ok(n) -> n
        Err(_) -> return
    val sorted = names.view()
    sort(sorted)
    for name in sorted
        if name.starts_with(".") then continue
        if glob_matches(segment.bytes, 0, name.bytes, 0) && is_dir(dir + "/" + name)
            expand_members(dir + "/" + name, segments, i + 1, found)

// Whether `name` from `j` matches `pattern` from `i`, where `*` matches any run of bytes.
private glob_matches(pattern: []const u8, i: usize, name: []const u8, j: usize) -> bool
    if i == pattern.len then return j == name.len
    if pattern[i] == u8('*')
        for k in j..name.len
            if glob_matches(pattern, i + 1, name, k) then return true
        return false
    j < name.len && pattern[i] == name[j] && glob_matches(pattern, i + 1, name, j + 1)

/** The workspace the package at `dir` is in: its own, when its manifest lists one, or that of the
 * nearest directory above it whose manifest lists it as a member. */
workspace_containing(m: Manifest) -> Result[Option[Workspace], string]
    if m.has_workspace then return Ok(Some(workspace_of(m)?))
    var at = parent(m.dir)
    loop
        val dir = at match
            Some(d) -> d
            None -> return Ok(None)
        if exists(dir + "/" + ManifestName)
            val above = read_manifest(dir)?
            if above.has_workspace
                val ws = workspace_of(above)?
                if contains(ws.members, m.dir) then return Ok(Some(ws))
        if dir == "/" || dir == "" then return Ok(None)
        at = parent(dir)

// Finding a package.

/** The directory of the package `path` is in: the nearest directory at or above it holding a manifest
 * with a `package` block, or `None` when there is none. A manifest with no `package` block, a
 * workspace's root, is passed over, unless it is `path` itself, which is refused with the members it
 * lists. */
enclosing_package(path: string) -> Result[Option[string], string]
    val absolute = absolute_path(path)
    var at = if is_dir(absolute) then absolute else parent(absolute).unwrap_or("/")
    loop
        if exists(at + "/" + ManifestName)
            val m = read_manifest(at)?
            if m.has_package then return Ok(Some(at))
            if at == absolute
                val ws = workspace_of(m)?
                var listed = ""
                for d in ws.members
                    listed = listed + "\n  " + d
                return Err(s"avin: $path is a workspace, which compiles nothing of its own; name one of its members:$listed")
        val up = parent(at) match
            Some(d) -> d
            None -> return Ok(None)
        if up == at then return Ok(None)
        at = up

/** `path` made absolute against the working directory, with `.` and `..` resolved by name. */
absolute_path(path: string) -> string
    if is_absolute(path) then return normalize(path)
    val here = current_dir() match
        Ok(d) -> d
        Err(_) -> return normalize(path)
    normalize(here + "/" + path)

// Fetching.

/** Where fetched packages are kept, and where they are fetched from. */
struct Fetching
    /** The directory fetched packages are kept in, one directory per coordinate and version; empty
     * when this machine has none. */
    cache: string
    /** What a coordinate's clone URL begins with: `https://`, or a mirror's own prefix. The URL is
     * this, the coordinate, and `.git`. */
    base: string
    /** Whether a package missing from the cache is fetched, rather than refused. */
    online: bool

/** Fetching into the machine's cache from each repository's own host. */
default_fetching() -> Fetching
    cache_dir() match
        Some(d) -> Fetching(d + "/avin/pkg", "https://", true)
        None -> Fetching("", "https://", true)

/** A line of `avin.sum`: a fetched package, its version, and what its tree hashed to. */
struct SumLine
    coordinate: string
    version: string
    hash: string

/** The lines of the sum file at `file`; none when there is no file. */
read_sums(file: string) -> Result[Buf[SumLine], string]
    var out: Buf[SumLine] = buf()
    if !exists(file) then return Ok(out)
    val text = read_text(file).map_err(e -> s"avin: $file: ${e.to_string()}")?
    var n = 0
    for line in text.lines()
        n += 1
        if line == "" then continue
        val fields = line.split(" ")
        val release = fields.len == 3 && fields[1].starts_with("v") && valid_version(fields[1][1..])
        val commit = fields.len == 3 && fields[1].starts_with("r") && valid_full_rev(fields[1][1..])
        if fields.len != 3 || !(release || commit) || !fields[2].starts_with(DigestPrefix)
            return Err(s"avin: $file:$n: a line is a coordinate, a version or a commit, and a hash, `github.com/owner/name v1.0.0 sha256:…`")
        // A release is kept as its number, a commit as `r` and its full id.
        out.push(SumLine(fields[0], if commit then fields[1] else fields[1][1..], fields[2]))
    Ok(out)

private render_sums(lines: Buf[SumLine]) -> string
    var out = str_builder()
    for l in lines
        out.push(s"${l.coordinate} ${sum_label(l.version)} ${l.hash}\n")
    out.finish()

/** How a sum line's version key is written: a release as `v1.4.0`, a commit as `r` and its id. */
private sum_label(key: string) -> string = if key.starts_with("r") then key else "v" + key

/** The sum key of a commit: `r` and its full id. */
private rev_key(sha: string) -> string = "r" + sha

private find_sum(lines: Buf[SumLine], coordinate: string, version: string) -> Option[SumLine]
    for l in lines
        if l.coordinate == coordinate && l.version == version then return Some(l)
    None

/** The hash of the package tree at `root`: SHA-256 of a listing of its files, one line each, the
 * file's own SHA-256 in lowercase hexadecimal, two spaces and its path from the root, sorted by
 * path. A `.git` anywhere and the root's own `.avin` are left out: they are what fetching and building
 * leave, not the package. */
tree_hash(root: string) -> Result[string, string]
    var paths: Buf[string] = buf()
    var walker = walk(root)
    loop
        val entry = walker.next() match
            Some(Ok(e)) -> e
            Some(Err(e)) -> return Err(s"avin: $root: ${e.to_string()}")
            None -> break
        if entry.path.bytes.len <= root.bytes.len then continue
        val rel = entry.path[root.bytes.len + 1..]
        if entry.is_dir()
            if rel == ".avin" || rel == ".git" || rel.ends_with("/.git") then walker.skip_dir()
            continue
        if entry.is_link() then continue
        paths.push(rel)
    val sorted = paths.view()
    sort(sorted)
    var listing = str_builder()
    for rel in sorted
        val bytes = read_bytes(root + "/" + rel).map_err(e -> s"avin: $root/$rel: ${e.to_string()}")?
        listing.push(digest(bytes) + "  " + rel + "\n")
    Ok(DigestPrefix + digest(listing.finish().bytes))

private digest(bytes: []const u8) -> string
    val d = sha256(bytes)
    hex_string(d[0..<32])

// Resolution.

/** A package a program is made of: its name, its directory, its manifest, and whether it was fetched
 * or reached through a package that was. */
struct ResolvedPackage
    name: string
    dir: string
    manifest: Manifest
    fetched: bool
    /** The features it is built with. */
    features: Buf[string]
    /** The labels of the optional dependencies a feature of it turned on, and each one's directory. */
    optional: Buf[string]
    optional_dirs: Buf[string]

/** What resolving a package found: the packages, the one resolved first and then every package it
 * depends on, directly or through another; the sum file; the lines it holds; and a line for every
 * fetched package and version that resolution read, in the order first read. */
struct Resolution
    packages: Buf[ResolvedPackage]
    sum_file: string
    sums: Buf[SumLine]
    read: Buf[SumLine]
    /** Each repository cloned into the cache while resolving, as its coordinate and its version or `r`
     * and commit, `github.com/owner/json v1.4.0`. */
    cloned: Buf[string]

private struct Selected
    coordinate: string
    version: string

private struct Resolver
    fetching: Fetching
    workspace: Option[Workspace]
    sums: Buf[SumLine]
    read: Buf[SumLine]
    selected: Buf[Selected]
    /** The commit, by full id, each coordinate asked for at a `rev` is pinned to. */
    pinned: Buf[Selected]
    changed: bool
    /** Whether the packages are read from the project's `vendor/` rather than the machine's cache. */
    vendored: bool
    cloned: Buf[string]
    /** Every request for a package's features made so far, each once. */
    requests: Buf[FeatureRequest]
    request_keys: Buf[string]

/** A request for features of the package `key` names (its coordinate, or a directory), made at
 * `place` in `src` or, with no place, by the command line: every feature, or the defaults unless
 * `defaults` is false, less `without`, and `names`. */
private struct FeatureRequest
    key: string
    all: bool
    defaults: bool
    names: Buf[string]
    without: Buf[string]
    place: Option[Span]
    src: Source

// Adds a request unless an identical one was made, and notes that resolution has changed when it does.
private add_request(r: *Resolver, q: FeatureRequest)
    var text = q.key + (if q.all then "|all|" else "|") + (if q.defaults then "defaults|" else "|")
    for n in q.names
        text = text + n + ","
    text = text + "|"
    for n in q.without
        text = text + n + ","
    text = text + "|" + q.src.name + "|"
    if q.place is Some(s) then text = text + s.start.to_string()
    if contains(r.request_keys, text) then return
    r.request_keys.push(text)
    r.requests.push(q)
    r.changed = true

// The features the package `key` names, whose manifest is `m`, is built with: what every request for
// it adds, with what those turn on.
private selected_features(r: Resolver, key: string, m: Manifest) -> Result[Buf[string], string]
    var on: Buf[string] = buf()
    for q in r.requests
        if q.key != key then continue
        val added = requested_features(m.features, q.all, q.defaults, q.names, q.without) match
            Ok(a) -> a
            Err(asked) ->
                val message = refused_feature(m.name, m.features, asked)
                return Err(q.place match
                    Some(s) -> error(s, message).render(q.src)
                    None -> "avin: " + message)
        for n in added
            if !contains(on, n) then on.push(n)
    Ok(feature_closure(m.features, on))

// The key a dependency's feature requests are made under: its coordinate, or its directory.
private package_key(origin: Origin, dir: string) -> string = origin match
    Git(c, _) -> c
    Rev(c, _) -> c
    _ -> dir

/** The directory, beside a project's manifest or at its workspace's root, holding the packages it
 * resolves to, in the cache's layout. */
const VendorName: string = "vendor"

/** The repository a fetched package was read from: its coordinate, the version or `r` and commit it
 * was read at, and the directory its clone is kept in. */
private struct Clone
    repository: string
    key: string
    root: string

/** Where a dependency led: its package's directory, and for a fetched one the clone it is in. */
private struct Reached
    dir: string
    clone: Option[Clone]

/** Resolves the package at `dir` and everything it depends on, fetching what the cache has not got
 * and checking each fetched package against the sum file. With `whole`, and `dir` a workspace's root,
 * every member is resolved.
 *
 * The version of a git dependency is the highest any manifest in the graph asks for: a version that
 * some manifest names, never a newer one nobody named. In a workspace the versions are chosen over
 * every member's dependencies, so no two members are built against two versions of one package.
 *
 * A project with a `vendor/` directory resolves from it in place of the cache, and fetches nothing. */
resolve(dir: string, fetching: Fetching, whole: bool) -> Result[Resolution, string] = resolve_from(dir, fetching, whole, true, default_features())

/** Resolves as `resolve` does, the root package's features chosen by `choice`: with `whole`, every
 * member's, each taking the names in `choice` that it declares. Each dependency is built with every
 * feature any manifest in the graph asks of it, and an optional dependency is taken only while a
 * feature turns it on. */
resolve_with(dir: string, fetching: Fetching, whole: bool, choice: FeatureChoice) -> Result[Resolution, string] = resolve_from(dir, fetching, whole, true, choice)

// Resolves as `resolve_with` does; without `vendored`, from the cache even where the project has a
// `vendor/`.
private resolve_from(dir: string, fetching: Fetching, whole: bool, vendored: bool, choice: FeatureChoice) -> Result[Resolution, string]
    val home = canonicalize(dir).map_err(e -> s"avin: $dir: ${e.to_string()}")?
    val m = read_manifest(home)?
    val ws = workspace_containing(m)?
    var roots: Buf[string] = buf()
    var sum_dir = home
    ws match
        Some(w) ->
            sum_dir = w.root
            for d in w.members
                roots.push(d)
        None -> roots.push(home)
    val sum_file = sum_dir + "/" + SumName
    val sums = read_sums(sum_file)?
    val vendor = sum_dir + "/" + VendorName
    val from_vendor = vendored && is_dir(vendor)
    val source = if from_vendor then Fetching(vendor, "", false) else fetching
    var r = Resolver(source, ws, sums, buf(), buf(), buf(), false, from_vendor, buf(), buf(), buf())
    val all_roots = whole && (m.has_workspace || !m.has_package)
    // The command line chooses the root's features; in a whole workspace, each member takes the names
    // it declares, and a name no member declares is refused.
    var declared: Buf[string] = buf()
    for root in roots
        val rm = read_manifest(root)?
        var names: Buf[string] = buf()
        for n in choice.names
            if !all_roots || feature_index(rm.features, n) is Some(_) then names.push(n)
            if feature_index(rm.features, n) is Some(_) then declared.push(n)
        val chosen = all_roots || root == home
        if chosen then add_request(&r, FeatureRequest(root, choice.all, choice.defaults, names, buf(), None, rm.src))
        else add_request(&r, FeatureRequest(root, choice.all, true, buf(), buf(), None, rm.src))
    if !contains(roots, home)
        add_request(&r, FeatureRequest(home, choice.all, choice.defaults, choice.names, buf(), None, m.src))
    if all_roots
        for n in choice.names
            if !contains(declared, n) then return Err(s"avin: no member of the workspace at ${home} has a feature `$n`")
    // A version raised can name dependencies of its own, which can raise another, and a feature turned
    // on can take a dependency or ask for another's features: walk again until a walk changes nothing.
    loop
        r.changed = false
        var seen: Buf[string] = buf()
        var reached: Buf[ResolvedPackage] = buf()
        for root in roots
            visit(&r, root, None, root, &seen, &reached)?
        if !r.changed then break
    var seen: Buf[string] = buf()
    var packages: Buf[ResolvedPackage] = buf()
    if all_roots
        for root in roots
            visit(&r, root, None, root, &seen, &packages)?
    else
        visit(&r, home, None, home, &seen, &packages)?
    for p in packages
        if unmet_requirement(p.manifest.features, p.features) is Some(d) then return Err(d.render(p.manifest.src))
    Ok(Resolution(packages, sum_file, r.sums, r.read, r.cloned))

// Visits the package at `dir`, which was fetched from `from` when that is given and whose feature
// requests are made under `key`, and every package it depends on that its features take.
private visit(r: *Resolver, dir: string, from: Option[Clone], key: string, seen: *Buf[string], out: *Buf[ResolvedPackage]) -> Result[unit, string]
    if contains(*seen, dir) then return Ok(())
    seen.push(dir)
    val m = read_manifest(dir)?
    if !m.has_package then return Err(s"avin: $dir is a workspace's root with no `package` block, which no package can depend on")
    val on = selected_features(*r, key, m)?
    val at = out.len()
    out.push(ResolvedPackage(m.name, dir, m, from is Some(_), on, buf(), buf()))
    var optional: Buf[string] = buf()
    var optional_dirs: Buf[string] = buf()
    for d in m.dependencies
        if d.optional && !dependency_turned_on(m.features, on, d.label) then continue
        // A fetched package's path and workspace dependencies are other packages of its repository,
        // read at the version it was read at.
        val origin = from match
            Some(c) -> sibling_origin(c, dir, d, m)?
            None -> d.origin
        val reached = origin match
            Git(coordinate, version) ->
                if pinned_sha(*r, coordinate) != ""
                    return Err(error(d.span, s"`${d.label}` asks for $coordinate at the release v$version, and another dependency pins it to the commit ${pinned_sha(*r, coordinate)}: a package is read at one release or at one commit, so make them agree").render(m.src))
                select(r, coordinate, version)
                val chosen = selected_version(*r, coordinate)
                val got = fetch_package(r, coordinate, chosen)?
                Reached(got, Some(Clone(repository_of(coordinate), chosen, normalize(cached_package_dir(r.fetching.cache, repository_of(coordinate), chosen)))))
            Rev(coordinate, rev) ->
                if selected_version(*r, coordinate) != ""
                    return Err(error(d.span, s"`${d.label}` pins $coordinate to the commit $rev, and another dependency asks for it at the release v${selected_version(*r, coordinate)}: a package is read at one release or at one commit, so make them agree").render(m.src))
                val got = fetch_revision(r, coordinate, rev)?
                if pinned_sha(*r, coordinate) == ""
                    r.pinned.push(Selected(coordinate, got.sha))
                elif pinned_sha(*r, coordinate) != got.sha
                    return Err(error(d.span, s"`${d.label}` pins $coordinate to the commit ${got.sha}, and another dependency pins it to ${pinned_sha(*r, coordinate)}: a package is read at one commit, so make them agree").render(m.src))
                Reached(got.dir, Some(Clone(repository_of(coordinate), rev_key(got.sha), normalize(cached_revision_dir(r.fetching.cache, repository_of(coordinate), got.sha)))))
            Local(p) ->
                val full = if is_absolute(p) then p else dir + "/" + p
                val c = canonicalize(full) match
                    Ok(c) -> c
                    Err(_) -> return Err(error(d.span, s"`${d.label}` is a path dependency, and `$p` is not a directory").render(m.src))
                if !is_dir(c) then return Err(error(d.span, s"`${d.label}` is a path dependency, and `$p` is not a directory").render(m.src))
                if !exists(c + "/" + ManifestName) then return Err(error(d.span, s"`${d.label}` is a path dependency, and `$p` holds no $ManifestName, so it is not a package").render(m.src))
                Reached(c, None)
            Member ->
                r.workspace match
                    Some(w) ->
                        index_of(w.names, d.label) match
                            Some(i) -> Reached(w.members[i], None)
                            None -> return Err(error(d.span, s"`${d.label}` is a workspace dependency, and no member of the workspace at ${w.root} is named `${d.label}`").render(m.src))
                    None -> return Err(error(d.span, s"`${d.label}` is a workspace dependency, and this package is in no workspace: a workspace's root lists its members, `workspace = [\"app\", \"${d.label}\"]`").render(m.src))
        val dep_key = package_key(origin, reached.dir)
        add_request(r, FeatureRequest(dep_key, false, d.default_features, d.features, d.without, Some(d.span), m.src))
        var asked: Buf[string] = buf()
        var places: Buf[Span] = buf()
        dependency_features_asked(m.features, on, d.label, &asked, &places)
        for i in 0..<asked.len()
            var one: Buf[string] = buf()
            one.push(asked[i])
            add_request(r, FeatureRequest(dep_key, false, false, one, buf(), Some(places[i]), m.src))
        if d.optional
            optional.push(d.label)
            optional_dirs.push(reached.dir)
        visit(r, reached.dir, reached.clone, dep_key, seen, out)?
    out[at].optional = optional
    out[at].optional_dirs = optional_dirs
    Ok(())

// The origin of the dependency `d` of the fetched package at `dir`, read from the clone `c`: a path or
// workspace dependency is the package of the same repository it names, at the version or commit the
// clone was read at; a git dependency is itself.
private sibling_origin(c: Clone, dir: string, d: Dependency, m: Manifest) -> Result[Origin, string]
    var sibling = ""
    d.origin match
        Local(p) ->
            val target = normalize(if is_absolute(p) then p else dir + "/" + p)
            if target != c.root && !target.starts_with(c.root + "/")
                return Err(error(d.span, s"`${d.label}` is a path dependency of a fetched package that leaves its repository, ${c.repository}: a directory outside it is only where it is on the machine that published it").render(m.src))
            sibling = if target == c.root then "" else target[c.root.bytes.len + 1..]
            if !exists(target + "/" + ManifestName)
                return Err(error(d.span, s"`${d.label}` is a path dependency, and `$p` holds no $ManifestName in ${c.repository} ${sum_label(c.key)}, so it is not a package").render(m.src))
        Member ->
            var in_workspace = false
            if exists(c.root + "/" + ManifestName) then in_workspace = read_manifest(c.root)?.has_workspace
            if !in_workspace
                return Err(error(d.span, s"`${d.label}` is a workspace dependency of a fetched package, which is in no workspace").render(m.src))
            val ws = workspace_of(read_manifest(c.root)?)?
            val i = index_of(ws.names, d.label) match
                Some(i) -> i
                None -> return Err(error(d.span, s"`${d.label}` is a workspace dependency, and no member of the workspace of ${c.repository} ${sum_label(c.key)} is named `${d.label}`").render(m.src))
            val at = ws.members[i]
            sibling = if at == c.root then "" else at[c.root.bytes.len + 1..]
        _ -> return Ok(d.origin)
    val coordinate = member_coordinate(c.repository, sibling)
    Ok(if c.key.starts_with("r") then Rev(coordinate, c.key[1..]) else Git(coordinate, c.key))

private select(r: *Resolver, coordinate: string, version: string)
    for i in 0..<r.selected.len()
        if r.selected[i].coordinate == coordinate
            if version_after(version, r.selected[i].version)
                r.selected[i].version = version
                r.changed = true
            return
    r.selected.push(Selected(coordinate, version))
    r.changed = true

private selected_version(r: Resolver, coordinate: string) -> string
    for s in r.selected
        if s.coordinate == coordinate then return s.version
    ""

/** Where `coordinate` at `version` is kept in the cache `cache`. */
cached_package_dir(cache: string, coordinate: string, version: string) -> string = s"$cache/$coordinate/@v$version"

// The fetched package's directory: from the cache, checked by the hash recorded when it was
// fetched, or cloned at its tag and hashed. Either way the hash is held to the sum file's line. A
// member's directory is in the clone of its repository, which every member at the version shares,
// and its line carries the clone's hash.
private fetch_package(r: *Resolver, coordinate: string, version: string) -> Result[string, string]
    if r.fetching.cache == "" then return Err(s"avin: cannot fetch $coordinate v$version: this machine has no cache directory to keep packages in; set XDG_CACHE_HOME")
    val repository = repository_of(coordinate)
    val member = member_of(coordinate)
    val dir = cached_package_dir(r.fetching.cache, repository, version)
    val hash_file = dir + ".hash"
    var hash = ""
    if is_dir(dir)
        hash = read_text(hash_file) match
            Ok(t) -> t.trim()
            Err(_) -> return Err(s"avin: $dir holds $repository v$version and no record of what it hashed to, so $SumName cannot be checked against it; remove that directory and build again")
    elif !r.fetching.online
        return Err(not_fetched(*r, s"$coordinate v$version"))
    else
        hash = clone_package(r.fetching, repository, version, dir, member == "")?
        r.cloned.push(s"$repository v$version")
    val at = package_in(dir, coordinate, s"v$version")?
    check_sum(r, coordinate, version, hash)?
    Ok(at)

// Why a package missing from where packages are read is not fetched.
private not_fetched(r: Resolver, what: string) -> string
    if r.vendored then return s"avin: $what is not in ${VendorName}/, and a project with a ${VendorName}/ fetches nothing; `avin vendor` adds it"
    s"avin: $what is not fetched yet; `avin build` fetches it"

// The directory of the package `coordinate` names in the clone at `dir`, read at `shown`: the clone
// itself for the package at the repository's root, or its member's directory, which must hold a
// manifest.
private package_in(dir: string, coordinate: string, shown: string) -> Result[string, string]
    val member = member_of(coordinate)
    if member == ""
        if !exists(dir + "/" + ManifestName) then return Err(s"avin: $coordinate $shown holds no $ManifestName, so it is not an Avin package")
        return Ok(dir)
    val at = dir + "/" + member
    if !is_dir(at) then return Err(s"avin: $coordinate $shown: the repository has no directory `$member` at that version, so it has no such member")
    if !exists(at + "/" + ManifestName) then return Err(s"avin: $coordinate $shown: `$member` holds no $ManifestName, so it is not a package")
    Ok(at)

// Holds a fetched package's hash to the sum file's line for it, and notes that resolution read it.
// `key` is the version, or `r` and the commit.
private check_sum(r: *Resolver, coordinate: string, key: string, hash: string) -> Result[unit, string]
    if find_sum(r.sums, coordinate, key) is Some(line)
        if line.hash != hash
            return Err(s"avin: $SumName records $coordinate ${sum_label(key)} as ${line.hash}, and the package hashes to $hash: the tag may have moved or the repository been rewritten. If the new contents are the ones you want, remove the line and build again")
    if find_sum(r.read, coordinate, key) is None then r.read.push(SumLine(coordinate, key, hash))
    Ok(())

/** A package fetched at a commit: where it is kept, and the commit's full id. */
struct FetchedRevision
    dir: string
    sha: string

/** Where `coordinate` at the commit `sha` (a full id) is kept in the cache `cache`. */
cached_revision_dir(cache: string, coordinate: string, sha: string) -> string = s"$cache/$coordinate/@r$sha"

private pinned_sha(r: Resolver, coordinate: string) -> string
    for s in r.pinned
        if s.coordinate == coordinate then return s.version
    ""

// The cache entries of `coordinate` whose commit begins with `rev`, as full ids.
private cached_commits(cache: string, coordinate: string, rev: string) -> Buf[string]
    var out: Buf[string] = buf()
    for name in entries(cache + "/" + coordinate).unwrap_or(buf())
        if name.starts_with("@r" + rev) && !name.ends_with(".hash") then out.push(name[2..])
    out

// A package at a commit, by a full or abbreviated id: from the cache when an entry's commit begins
// with it, or cloned and resolved to the commit's full id. The cache and the sum file are keyed by the
// full id, so two spellings of one commit are one package.
private fetch_revision(r: *Resolver, coordinate: string, rev: string) -> Result[FetchedRevision, string]
    if r.fetching.cache == "" then return Err(s"avin: cannot fetch $coordinate at $rev: this machine has no cache directory to keep packages in; set XDG_CACHE_HOME")
    val repository = repository_of(coordinate)
    var sha = ""
    val have = cached_commits(r.fetching.cache, repository, rev)
    if have.len() > 1 then return Err(s"avin: `$rev` is the start of more than one commit of $repository the cache holds: write more of it")
    if have.len() == 1 then sha = have[0]
    if sha == "" && !r.fetching.online then return Err(not_fetched(*r, s"$coordinate at $rev"))
    var hash = ""
    if sha != ""
        val dir = cached_revision_dir(r.fetching.cache, repository, sha)
        hash = read_text(dir + ".hash") match
            Ok(t) -> t.trim()
            Err(_) -> return Err(s"avin: $dir holds $repository at $sha and no record of what it hashed to, so $SumName cannot be checked against it; remove that directory and build again")
    else
        val cloned = clone_revision(r.fetching, repository, rev, member_of(coordinate) == "")?
        sha = cloned.sha
        r.cloned.push(s"$repository ${rev_key(sha)}")
        hash = read_text(cached_revision_dir(r.fetching.cache, repository, sha) + ".hash").map_err(e -> s"avin: ${e.to_string()}")?.trim()
    val at = package_in(cached_revision_dir(r.fetching.cache, repository, sha), coordinate, s"at $sha")?
    check_sum(r, coordinate, rev_key(sha), hash)?
    Ok(FetchedRevision(at, sha))

// Clones the repository, finds the commit `rev` names (fetching it by its full id when no branch or
// tag reaches it), checks it out, and files the tree in the cache under the commit's full id with its
// hash beside it. A commit already filed by another build is the same tree. With `root_package`, a
// repository with no manifest at its root is refused before it is filed.
private clone_revision(fetching: Fetching, coordinate: string, rev: string, root_package: bool) -> Result[FetchedRevision, string]
    val above = fetching.cache + "/" + coordinate
    make_dir_all(above).map_err(e -> s"avin: $above: ${e.to_string()}")?
    val partial = pending_name(above + "/@r" + rev)
    defer _ = remove_dir_all(partial)
    val url = fetching.base + coordinate + ".git"
    val cloned = capture("git", ["clone", "--quiet", url, partial], stderr = true, timeout = 600000).map_err(e -> s"avin: cannot fetch $coordinate at $rev: could not run git: ${e.to_string()}")?
    if !cloned.status.ok()
        return Err(s"avin: cannot fetch $coordinate at $rev from $url:\n${cloned.err.unwrap_or("")}${cloned.text}")
    var found = capture("git", ["-C", partial, "rev-parse", "--verify", "--quiet", rev + "^{commit}"], stderr = true, timeout = 600000).map_err(e -> s"avin: cannot fetch $coordinate at $rev: could not run git: ${e.to_string()}")?
    if !found.status.ok() && valid_full_rev(rev)
        // No branch or tag reaches it: ask the host for the commit itself.
        // The clone's `.git` is removed once checked out, so the fetch starts no background
        // maintenance that would still be writing into it.
        val asked = capture("git", ["-C", partial, "-c", "maintenance.auto=false", "-c", "gc.auto=0", "fetch", "--quiet", "origin", rev], stderr = true, timeout = 600000).map_err(e -> s"avin: cannot fetch $coordinate at $rev: could not run git: ${e.to_string()}")?
        found = capture("git", ["-C", partial, "rev-parse", "--verify", "--quiet", rev + "^{commit}"], stderr = true, timeout = 600000).map_err(e -> s"avin: cannot fetch $coordinate at $rev: could not run git: ${e.to_string()}")?
    val sha = found.text.trim()
    if !found.status.ok() || !valid_full_rev(sha)
        val hint = if valid_full_rev(rev) then "" else s", or `$rev` starts more than one commit; a commit no branch or tag reaches is found only by its full id"
        return Err(s"avin: $coordinate has no commit `$rev`$hint")
    val checkout = capture("git", ["-C", partial, "checkout", "--quiet", "--detach", sha], stderr = true, timeout = 600000).map_err(e -> s"avin: cannot fetch $coordinate at $rev: could not run git: ${e.to_string()}")?
    if !checkout.status.ok()
        return Err(s"avin: cannot check out $coordinate at $sha:\n${checkout.err.unwrap_or("")}${checkout.text}")
    remove_dir_all(partial + "/.git").map_err(e -> s"avin: $partial/.git: ${e.to_string()}")?
    if root_package && !exists(partial + "/" + ManifestName) then return Err(s"avin: $coordinate at $sha holds no $ManifestName, so it is not an Avin package")
    val hash = tree_hash(partial)?
    val dir = cached_revision_dir(fetching.cache, coordinate, sha)
    write_text_atomic(dir + ".hash", hash + "\n").map_err(e -> s"avin: $dir.hash: ${e.to_string()}")?
    if publish_dir(partial, dir) is Err(e)
        if !is_dir(dir) then return Err(s"avin: $dir: ${e.to_string()}")
    Ok(FetchedRevision(dir, sha))

// Clones the tag into a directory of this fetch's own beside the cache entry, hashes it, records the
// hash and then moves it into place, so nothing ever reads a package half fetched. With
// `root_package`, a repository with no manifest at its root is refused before it is filed.
private clone_package(fetching: Fetching, coordinate: string, version: string, dir: string, root_package: bool) -> Result[string, string]
    val above = parent(dir).unwrap_or(".")
    make_dir_all(above).map_err(e -> s"avin: $above: ${e.to_string()}")?
    val partial = pending_name(dir)
    defer _ = remove_dir_all(partial)
    val url = fetching.base + coordinate + ".git"
    val tag = "v" + version
    val result = capture("git", ["clone", "--quiet", "--depth", "1", "--branch", tag, url, partial], stderr = true, timeout = 600000).map_err(e -> s"avin: cannot fetch $coordinate $tag: could not run git: ${e.to_string()}")?
    if !result.status.ok()
        return Err(s"avin: cannot fetch $coordinate $tag from $url:\n${result.err.unwrap_or("")}${result.text}")
    remove_dir_all(partial + "/.git").map_err(e -> s"avin: $partial/.git: ${e.to_string()}")?
    if root_package && !exists(partial + "/" + ManifestName) then return Err(s"avin: $coordinate $tag holds no $ManifestName, so it is not an Avin package")
    val hash = tree_hash(partial)?
    write_text_atomic(dir + ".hash", hash + "\n").map_err(e -> s"avin: $dir.hash: ${e.to_string()}")?
    if publish_dir(partial, dir) is Err(e)
        // Another build fetched the same tag first: the same tag is the same tree.
        if !is_dir(dir) then return Err(s"avin: $dir: ${e.to_string()}")
    Ok(hash)

/** Adds to the sum file a line for every fetched package resolution read that it has none for. A
 * build only adds lines; `avin tidy` is what removes them. */
record_sums(res: Resolution) -> Result[unit, string]
    var lines = res.sums
    var added = false
    for l in res.read
        if find_sum(lines, l.coordinate, l.version) is None
            lines.push(l)
            added = true
    if !added then return Ok(())
    write_text_atomic(res.sum_file, render_sums(lines)).map_err(e -> s"avin: ${res.sum_file}: ${e.to_string()}")

/** Rewrites the sum file of the package or workspace at `dir` to exactly the fetched packages its
 * whole resolution reads, keeping each line that stays where it was, and says through `say` what it
 * removed and added. With `check`, it writes nothing and fails when the file is not already that.
 * Answers whether the file was tidy. The resolution, with every feature of the root on, is read from
 * the cache, whatever the project's `vendor/` holds. */
tidy(dir: string, fetching: Fetching, check: bool, say: string -> unit) -> Result[bool, string]
    val res = resolve_from(dir, fetching, true, false, every_feature())?
    var lines: Buf[SumLine] = buf()
    var changed = false
    for l in res.sums
        if find_sum(res.read, l.coordinate, l.version) is Some(_)
            lines.push(l)
        else
            say(s"${if check then "would remove" else "removed"} ${l.coordinate} ${sum_label(l.version)}")
            changed = true
    for l in res.read
        if find_sum(lines, l.coordinate, l.version) is None
            say(s"${if check then "would add" else "added"} ${l.coordinate} ${sum_label(l.version)}")
            lines.push(l)
            changed = true
    if check || !changed then return Ok(!changed)
    if lines.len() == 0
        remove_file(res.sum_file).map_err(e -> s"avin: ${res.sum_file}: ${e.to_string()}")?
    else
        write_text_atomic(res.sum_file, render_sums(lines)).map_err(e -> s"avin: ${res.sum_file}: ${e.to_string()}")?
    Ok(false)

// Vendoring.

// A cache entry to copy into `vendor/`: its path from the cache, `<coordinate>/@v<version>`, and the
// hash it was checked to.
private struct VendorCopy
    entry: string
    hash: string

/** Copies every fetched package the whole resolution of the package or workspace at `dir` reads into
 * `vendor/` beside its sum file, in the cache's layout: one directory per repository and version or
 * commit, with its hash beside it. Each package is fetched into the cache first if it is not there and
 * gets a line in the sum file if it has none, and the cache's copy is hashed and held to that line
 * before it is copied, `.git` and the root's `.avin` left out. A copy already in place and hashing as
 * recorded is left alone; one the resolution no longer reads is removed. Says through `say` what it
 * fetched and removed, and how many packages it vendored. */
vendor(dir: string, fetching: Fetching, say: string -> unit) -> Result[unit, string] = vendor_with(dir, fetching, every_feature(), say)

/** Vendors as `vendor` does, the root package's features chosen by `choice`. */
vendor_with(dir: string, fetching: Fetching, choice: FeatureChoice, say: string -> unit) -> Result[unit, string]
    val res = resolve_from(dir, fetching, true, false, choice)?
    record_sums(res)?
    for c in res.cloned
        say(s"fetching $c")
    val into = parent(res.sum_file).unwrap_or(".") + "/" + VendorName
    // Every copy is checked before anything is written, so a refusal leaves `vendor/` as it was.
    var kept: Buf[string] = buf()
    var copies: Buf[VendorCopy] = buf()
    for l in res.read
        val entry = repository_of(l.coordinate) + "/" + entry_name(l.version)
        if contains(kept, entry) then continue
        kept.push(entry)
        val target = into + "/" + entry
        if is_dir(target) && read_text(target + ".hash").unwrap_or("").trim() == l.hash && tree_hash(target)? == l.hash then continue
        val from = fetching.cache + "/" + entry
        val actual = tree_hash(from)?
        if actual != l.hash
            return Err(s"avin: the cache's copy of ${repository_of(l.coordinate)} ${sum_label(l.version)}, $from, hashes to $actual, and $SumName records ${l.hash}: it was changed after it was fetched. Remove that directory and run `avin vendor` again")
        copies.push(VendorCopy(entry, l.hash))
    make_dir_all(into).map_err(e -> s"avin: $into: ${e.to_string()}")?
    for c in copies
        copy_package(fetching.cache + "/" + c.entry, into + "/" + c.entry, c.hash)?
    for entry in vendored_entries(into)?
        if contains(kept, entry) then continue
        remove_dir_all(into + "/" + entry).map_err(e -> s"avin: $into/$entry: ${e.to_string()}")?
        if exists(into + "/" + entry + ".hash")
            remove_file(into + "/" + entry + ".hash").map_err(e -> s"avin: $into/$entry.hash: ${e.to_string()}")?
        remove_empty_parents(into, parent(into + "/" + entry).unwrap_or(into))
        say(s"removed ${entry_label(entry)}")
    val n = res.read.len()
    say(s"vendored $n ${if n == 1 then "package" else "packages"} into ${VendorName}/")
    Ok(())

// The name of a repository's directory in the cache at a sum key: `@v` and the version, or `@r` and
// the commit.
private entry_name(key: string) -> string = if key.starts_with("r") then "@" + key else "@v" + key

// A vendored entry, `<coordinate>/@v<version>`, as the command names it: `<coordinate> v<version>`.
private entry_label(entry: string) -> string
    val parts = entry.split("/@")
    if parts.len != 2 then return entry
    parts[0] + " " + parts[1]

// The entries of the vendor directory `into`, each as its path from it: every directory whose name
// begins with `@v` or `@r`.
private vendored_entries(into: string) -> Result[Buf[string], string]
    var out: Buf[string] = buf()
    var walker = walk(into)
    loop
        val entry = walker.next() match
            Some(Ok(e)) -> e
            Some(Err(e)) -> return Err(s"avin: $into: ${e.to_string()}")
            None -> break
        if entry.path.bytes.len <= into.bytes.len || !entry.is_dir() then continue
        val rel = entry.path[into.bytes.len + 1..]
        val segments = rel.split("/")
        val name = segments[segments.len - 1]
        if name.starts_with("@v") || name.starts_with("@r")
            out.push(rel)
            walker.skip_dir()
    Ok(out)

// Removes each empty directory from `dir` up to, and not including, `top`.
private remove_empty_parents(top: string, dir: string)
    var at = dir
    while at != top && at.starts_with(top + "/")
        if entries(at).unwrap_or(buf()).len() > 0 then return
        if remove_dir_all(at) is Err(_) then return
        at = parent(at).unwrap_or(top)

// Copies the package tree at `from` to `to`, `.git` anywhere and the root's `.avin` left out, with
// `hash` recorded beside it: into a directory of this copy's own, then moved into place.
private copy_package(from: string, to: string, hash: string) -> Result[unit, string]
    val above = parent(to).unwrap_or(".")
    make_dir_all(above).map_err(e -> s"avin: $above: ${e.to_string()}")?
    if is_dir(to) then remove_dir_all(to).map_err(e -> s"avin: $to: ${e.to_string()}")?
    val partial = pending_name(to)
    defer _ = remove_dir_all(partial)
    make_dir_all(partial).map_err(e -> s"avin: $partial: ${e.to_string()}")?
    var walker = walk(from)
    loop
        val entry = walker.next() match
            Some(Ok(e)) -> e
            Some(Err(e)) -> return Err(s"avin: $from: ${e.to_string()}")
            None -> break
        if entry.path.bytes.len <= from.bytes.len then continue
        val rel = entry.path[from.bytes.len + 1..]
        if entry.is_dir()
            if rel == ".avin" || rel == ".git" || rel.ends_with("/.git")
                walker.skip_dir()
                continue
            make_dir_all(partial + "/" + rel).map_err(e -> s"avin: $partial/$rel: ${e.to_string()}")?
            continue
        if entry.is_link() then continue
        copy_file(entry.path, partial + "/" + rel).map_err(e -> s"avin: $to/$rel: ${e.to_string()}")?
    write_text_atomic(to + ".hash", hash + "\n").map_err(e -> s"avin: $to.hash: ${e.to_string()}")?
    publish_dir(partial, to).map_err(e -> s"avin: $to: ${e.to_string()}")

// Adding a dependency.

/** The highest version the repository at `coordinate` has a release tag for, read from the tags the
 * host lists: a tag `v` and a version, such as `v1.4.0`; any other tag is not a release. */
latest_version(fetching: Fetching, coordinate: string) -> Result[string, string]
    val url = fetching.base + coordinate + ".git"
    val result = capture("git", ["ls-remote", "--tags", url], stderr = true, timeout = 600000).map_err(e -> s"avin: cannot list the releases of $coordinate: could not run git: ${e.to_string()}")?
    if !result.status.ok()
        return Err(s"avin: cannot list the releases of $coordinate at $url:\n${result.err.unwrap_or("")}${result.text}")
    var best = ""
    for line in result.text.lines()
        val fields = line.split("\t")
        if fields.len != 2 || !fields[1].starts_with("refs/tags/v") then continue
        var tag = fields[1]["refs/tags/v".bytes.len..]
        if tag.ends_with("^{}") then tag = tag[0..<tag.bytes.len - 3]
        if !valid_version(tag) then continue
        if best == "" || version_after(tag, best) then best = tag
    if best == "" then return Err(s"avin: $coordinate has no release tag, `v1.0.0` being the tag of version 1.0.0; name a version, `avin add $coordinate@1.0.0`")
    Ok(best)

/** Records the dependency `source`, a coordinate with an optional `@version` (the highest release
 * when none is given), in the manifest of the package at `dir`, fetches it, and adds what it and its
 * own dependencies hashed to to the sum file. A coordinate followed by `//` and a directory names the
 * member of the repository in that directory, and is written with `member`. The resolution is read
 * from the cache, whatever the project's `vendor/` holds. A dependency already listed, under its coordinate or
 * under the name the added package gives itself, has its version changed in place. Everything else
 * in the manifest, its comments and layout included, is left as written; where the dependency cannot
 * be fetched or is not a package, the manifest is as it was. Says through `say` what it did. */
add_dependency(dir: string, source: string, fetching: Fetching, say: string -> unit) -> Result[unit, string]
    val home = canonicalize(dir).map_err(e -> s"avin: $dir: ${e.to_string()}")?
    val m = read_manifest(home)?
    if !m.has_package then return Err(s"avin: $home is a workspace's root with no `package` block, which takes no dependencies: add to one of its members")
    val parts = source.split("@")
    if parts.len > 2 then return Err(s"avin: `$source` is not a source: a coordinate and optionally a version, `github.com/owner/name@1.0.0`")
    val coordinate = parts[0]
    if !valid_coordinate(repository_of(coordinate))
        return Err(s"avin: `${repository_of(coordinate)}` is not a git coordinate: a coordinate names a repository as `host/owner/name`, such as `github.com/owner/json`, with no `https://` and no `.git`")
    if !valid_package_coordinate(coordinate)
        return Err(s"avin: `$coordinate` does not name a member of ${repository_of(coordinate)}: after `//`, ${MemberRule}")
    val repository = repository_of(coordinate)
    val member = member_of(coordinate)
    var version = ""
    var rev = ""
    if parts.len == 2
        if valid_version(parts[1]) then version = parts[1]
        elif valid_rev(parts[1]) then rev = parts[1]
        else return Err(s"avin: `${parts[1]}` is neither a version nor a revision: " + bad_version(parts[1]))
    else
        version = latest_version(fetching, repository)?
    // Fetch it alone first: the name it gives itself is what the manifest lists it under.
    var fetcher = Resolver(fetching, None, buf(), buf(), buf(), buf(), false, false, buf(), buf(), buf())
    var fetched = ""
    var shown = s"v$version"
    val within = if member == "" then "" else s", member = \"$member\""
    var entry = ""
    if rev != ""
        val got = fetch_revision(&fetcher, coordinate, rev)?
        fetched = got.dir
        shown = rev_key(got.sha)
        entry = s"{ git = \"$repository\"$within, rev = \"${got.sha}\" }"
    else
        fetched = fetch_package(&fetcher, coordinate, version)?
        entry = s"{ git = \"$repository\"$within, version = \"$version\" }"
    val added = read_manifest(fetched)?
    if !added.has_package then return Err(s"avin: $coordinate $shown is a workspace's root with no `package` block, which no package can depend on")
    var label = added.name
    var existing: Option[Dependency] = None
    for d in m.dependencies
        if existing is None
            d.origin match
                Git(c, _) -> if c == coordinate then existing = Some(d)
                Rev(c, _) -> if c == coordinate then existing = Some(d)
                _ -> ()
    if existing is None
        for d in m.dependencies
            if d.label == label then existing = Some(d)
    if existing is Some(d) then label = d.label
    if label == m.name then return Err(s"avin: $coordinate is this package, `$label`, which cannot depend on itself")
    val file = m.dir + "/" + ManifestName
    val text = read_text(file).map_err(e -> s"avin: $file: ${e.to_string()}")?
    val doc = parse_hocon(m.src).map_err(d -> d.render(m.src))?
    var edited = ""
    var block: Option[Value] = None
    for f in doc.root.fields()
        if f.key == "dependencies" then block = Some(f.value)
    if existing is Some(d)
        var target: Option[Value] = None
        if block is Some(b)
            for f in b.fields()
                if f.key == d.label then target = Some(f.value)
        val t = target match
            Some(t) -> t
            None -> return Err(s"avin: ${m.dir}/$ManifestName: cannot find where `${d.label}` is written")
        // What the entry asks of the package's features stays as written; only where it comes from changes.
        var kept = ""
        for g in t.fields()
            if g.key == "optional" || g.key == "features" || g.key == "default_features"
                kept = kept + s", ${g.key} = " + text[g.value.span.start..<g.value.span.end]
        if kept != "" then entry = entry[0..<entry.bytes.len - 2] + kept + " }"
        edited = text[0..<t.span.start] + entry + text[t.span.end..]
    elif block is Some(b)
        edited = insert_entry(text, b.span, s"$label $entry")?
    else
        var out = str_builder()
        out.push(text)
        if !text.ends_with("\n") then out.push("\n")
        out.push(s"\ndependencies {\n  $label $entry\n}\n")
        edited = out.finish()
    write_text_atomic(file, edited).map_err(e -> s"avin: $file: ${e.to_string()}")?
    val outcome = resolve_from(m.dir, fetching, false, false, every_feature())
    if outcome is Err(message)
        write_text_atomic(file, text).map_err(e -> s"avin: $file: ${e.to_string()}")?
        return Err(message)
    record_sums(outcome.unwrap())?
    if existing is Some(d)
        say(s"updated $label to $coordinate $shown")
    else
        say(s"added $label: $coordinate $shown")
    Ok(())

// `entry` written as the last line of the dependencies block at `block`, which is the braces and what
// they hold.
private insert_entry(text: string, block: Span, entry: string) -> Result[string, string]
    if block.end < 2 || text.bytes[block.end - 1] != 125u8
        return Err("avin: cannot find where the dependencies block ends")
    val close = block.end - 1
    var at = close
    while at > block.start + 1 && is_blank_byte(text.bytes[at - 1])
        at -= 1
    var out = str_builder()
    out.push(text[0..<at])
    out.push("\n  " + entry)
    val gap = text[at..<close]
    out.push(if gap.contains("\n") then gap else "\n")
    out.push(text[close..])
    Ok(out.finish())

private is_blank_byte(b: u8) -> bool = b == 32u8 || b == 10u8 || b == 13u8 || b == 9u8

// Loading a program.

/** A program the command line or the editor names, with its files. */
struct LoadedProgram
    /** The program's root: the package's directory, the directory of a program without a manifest,
     * or the file of a program of one file. */
    root: string
    files: Buf[ProgramFile]
    /** The package's name, when the program is a package. */
    package: Option[string]
    /** The Sysl packages its bindings may reach beyond Sysl's standard library. */
    sysl: Buf[SyslPackage]
    /** The C libraries of every package in it, which its C bindings call. */
    c: Buf[CLibrary]

/** A Sysl package a program's bindings may reach: its name in the shim package's manifest, and where
 * it comes from, a directory made absolute. */
struct SyslPackage
    label: string
    origin: Origin

/** The Sysl packages every package of a resolution names, each once. Two packages naming one Sysl
 * package at two releases take the higher, as for an Avin package; one name given two different
 * origins is refused, and so is a path dependency of a fetched package or a path holding no Sysl
 * package. */
sysl_packages(res: Resolution) -> Result[Buf[SyslPackage], string]
    var out: Buf[SyslPackage] = buf()
    var named_by: Buf[string] = buf()
    for p in res.packages
        for d in p.manifest.sysl_dependencies
            val origin = d.origin match
                Local(dir) ->
                    if p.fetched then return Err(error(d.span, s"`${d.label}` is a Sysl path dependency of a fetched package: a directory is only where it is on the machine that published it").render(p.manifest.src))
                    val full = if is_absolute(dir) then dir else p.dir + "/" + dir
                    val c = canonicalize(full) match
                        Ok(c) -> c
                        Err(_) -> return Err(error(d.span, s"`${d.label}` is a Sysl path dependency, and `$dir` is not a directory").render(p.manifest.src))
                    if !is_dir(c) then return Err(error(d.span, s"`${d.label}` is a Sysl path dependency, and `$dir` is not a directory").render(p.manifest.src))
                    if !exists(c + "/" + SyslManifestName) then return Err(error(d.span, s"`${d.label}` is a Sysl path dependency, and `$dir` holds no $SyslManifestName, so it is not a Sysl package").render(p.manifest.src))
                    Local(c)
                o -> o
            var found: Option[usize] = None
            for i in 0..<out.len()
                if out[i].label == d.label then found = Some(i)
            val i = found match
                Some(i) -> i
                None ->
                    out.push(SyslPackage(d.label, origin))
                    named_by.push(p.name)
                    continue
            if same_origin(out[i].origin, origin) then continue
            if out[i].origin is Git(c, v)
                if origin is Git(c2, v2)
                    if c == c2
                        if version_after(v2, v) then out[i].origin = origin
                        continue
            return Err(error(d.span, s"the Sysl dependency `${d.label}` is ${origin_text(origin)} here and ${origin_text(out[i].origin)} in `${named_by[i]}`: one name is one Sysl package, so make them agree").render(p.manifest.src))
    Ok(out)

/** The file of the standard library's directory naming the Sysl packages the library's own bindings
 * reach beyond Sysl's standard library and the runtime, in a manifest's `sysl-dependencies` block. */
const LibraryManifestName: string = "library.hocon"

/** The Sysl packages a program's bindings reach: `sysl`, those its manifests name, with each Sysl
 * package the standard library at `library` names that one of the Sysl names in `targets` (the
 * bindings' and handles' targets) is inside, a name having the package's name as one of the
 * segments before its last. A program naming the same package keeps its own, unless both are
 * releases of one repository, where the higher is taken. */
with_library_sysl(library: string, sysl: Buf[SyslPackage], targets: []const string) -> Result[Buf[SyslPackage], string]
    if !exists(library + "/" + LibraryManifestName) then return Ok(sysl)
    val m = read_manifest_named(library, LibraryManifestName)?
    var out = sysl
    for d in m.sysl_dependencies
        if !reaches_package(targets, d.label) then continue
        val origin = d.origin match
            Local(dir) ->
                val full = if is_absolute(dir) then dir else library + "/" + dir
                Local(canonicalize(full).unwrap_or(full))
            o -> o
        var found: Option[usize] = None
        for i in 0..<out.len()
            if out[i].label == d.label then found = Some(i)
        found match
            None -> out.push(SyslPackage(d.label, origin))
            Some(i) ->
                if out[i].origin is Git(c, v)
                    if origin is Git(c2, v2)
                        if c == c2 && version_after(v2, v) then out[i].origin = origin
    Ok(out)

/** Whether one of the Sysl names `targets` is inside the package `label`: has it as a segment before
 * its last. */
reaches_package(targets: []const string, label: string) -> bool
    for t in targets
        val segments = t.split(".")
        if segments.len < 2 then continue
        for k in 0..<segments.len - 1
            if segments[k] == label then return true
    false

private same_origin(a: Origin, b: Origin) -> bool = origin_text(a) == origin_text(b)

private origin_text(o: Origin) -> string = o match
    Git(c, v) -> s"$c v$v"
    Rev(c, r) -> s"$c at the commit $r"
    Local(d) -> s"the directory $d"
    Member -> "a workspace member"

/** The program `path` names. A path at or under a package's directory is that package, compiled with
 * every package it depends on; any other directory is a program of many files, and a file a program
 * by itself. */
load_program(path: string, fetching: Fetching) -> Result[LoadedProgram, string] = load_program_with(path, fetching, default_features())

/** The program `path` names, as `load_program` reads it, a package with the features `choice` turns on. */
load_program_with(path: string, fetching: Fetching, choice: FeatureChoice) -> Result[LoadedProgram, string]
    if enclosing_package(path)? is Some(dir)
        // The package's directory is named as it was given, when it was given.
        val root = if dir == absolute_path(path) then path else dir
        return load_package_with(root, fetching, choice)
    if choice.names.len() > 0
        return Err(s"avin: `--features` names features of a package, and $path is in none")
    if is_dir(path)
        val files = program_files(path).map_err(message -> "avin: " + message)?
        if files.len() == 0 then return Err(s"avin: $path: no `.avin` or `.lavin` files in the program")
        return Ok(LoadedProgram(path, files, None, buf(), buf()))
    val text = read_text(path).map_err(e -> s"avin: $path: ${e.to_string()}")?
    Ok(LoadedProgram(path, single_file(source_of(path, text)), None, buf(), buf()))

/** The package at `root` with every package it depends on: each dependency's modules first, then the
 * package's own files. The sum file gains a line for any package fetched for the first time. A module
 * two packages both hold is refused. */
load_package(root: string, fetching: Fetching) -> Result[LoadedProgram, string] = load_package_with(root, fetching, default_features())

/** The package at `root` as `load_package` reads it, with the features `choice` turns on. A module a
 * feature that is off lists is not read, and each file carries the imports its gate does not allow. */
load_package_with(root: string, fetching: Fetching, choice: FeatureChoice) -> Result[LoadedProgram, string]
    val res = resolve_with(root, fetching, false, choice)?
    record_sums(res)?
    // Each package's files, read without the modules its features that are off list, then the modules
    // each holds, which are what an import of an optional dependency is checked against.
    var each: Buf[Buf[ProgramFile]] = buf()
    var each_modules: Buf[Buf[string]] = buf()
    for i in 0..<res.packages.len()
        val p = res.packages[i]
        val read = package_files_skipping(if i == 0 then root else p.dir, i > 0, gated_off(p.manifest.features, p.features)).map_err(message -> "avin: " + message)?
        var names: Buf[string] = buf()
        for f in read
            val n = f.module_name.unwrap_or("")
            if n != "" && !contains(names, n) then names.push(n)
        each.push(read)
        each_modules.push(names)
    if each[0].len() == 0 then return Err(s"avin: $root: no `.avin` or `.lavin` files in the package")
    var files: Buf[ProgramFile] = buf()
    var owners: Buf[string] = buf()
    // Dependencies' modules first, then the package's own files.
    for step in 0..<res.packages.len()
        val i = if step + 1 == res.packages.len() then 0usize else step + 1
        val p = res.packages[i]
        var optional_modules: Buf[Buf[string]] = buf()
        for d in p.optional_dirs
            var found: Buf[string] = buf()
            for k in 0..<res.packages.len()
                if res.packages[k].dir == d then found = each_modules[k]
            optional_modules.push(found)
        for f in each[i]
            var file = f
            file.fences = fences_of(p.manifest.features, f.module_name.unwrap_or(""), p.optional, optional_modules)
            file.package = p.name
            files.push(file)
            owners.push(p.name)
    var modules: Buf[string] = buf()
    var holders: Buf[string] = buf()
    for i in 0..<files.len()
        val module_name = files[i].module_name.unwrap_or("")
        if module_name == "" then continue
        index_of(modules, module_name) match
            Some(k) ->
                if holders[k] != owners[i]
                    return Err(s"avin: the module `$module_name` is in two packages, `${holders[k]}` and `${owners[i]}`: a module belongs to one package")
            None ->
                modules.push(module_name)
                holders.push(owners[i])
    val sysl = sysl_packages(res)?
    // Every package's C libraries, the package's own first, are the program's.
    var c: Buf[CLibrary] = buf()
    for p in res.packages
        for library in p.manifest.c_libraries
            c.push(library)
    Ok(LoadedProgram(root, files, Some(res.packages[0].name), sysl, c))

/** The files of the program tree at `root` as `program_files` finds them, or, when `root` holds a
 * manifest, of the package with every feature on and its dependencies without fetching any: what the
 * language server reads. */
program_tree_files(root: string) -> Result[Buf[ProgramFile], string]
    if !exists(root + "/" + ManifestName) then return program_files(root)
    val fetching = default_fetching()
    val offline = Fetching(fetching.cache, fetching.base, false)
    load_package_with(root, offline, every_feature()) match
        Ok(p) -> Ok(p.files)
        Err(message) -> Err(message.trim())

// Scaffolding.

/** Writes a new package at `dir`, named by the directory's last segment: its manifest, a module of
 * that name with one function, a test of it, a `.gitignore`, and without `library` a `main.avin`
 * using the module. Answers the package's name. */
new_package(dir: string, library: bool) -> Result[string, string]
    val name = absolute_path(dir).split("/")
    val package_name = if name.len > 0 then name[name.len - 1] else ""
    if !valid_package_name(package_name) then return Err(s"avin: `$package_name` is not a package name: $PackageNameRule")
    val module_name = package_name.replace_all("-", "_")
    if module_name == CoreModule then return Err(s"avin: a package is not named `$package_name`: its module would be `$CoreModule`, which is the standard library's")
    if module_name == "tests" then return Err("avin: a package is not named `tests`: its module would be its own tests' directory")
    if exists(dir) then return Err(s"avin: $dir already exists")
    make_dir_all(dir + "/" + module_name).map_err(e -> s"avin: $dir: ${e.to_string()}")?
    make_dir_all(dir + "/tests").map_err(e -> s"avin: $dir: ${e.to_string()}")?
    val files = [
        (ManifestName, s"package {\n  name = \"$package_name\"\n  version = \"0.1.0\"\n  avin = \"$Version\"\n}\n\ndependencies {\n}\n"),
        (".gitignore", ".avin/\n"),
        (s"$module_name/$module_name.avin", s"module $module_name\n\n// The greeting for `name`.\ngreeting(name: string) -> string = \"Hello, \" + name + \"!\"\n"),
        (s"tests/${module_name}_tests.avin", s"module tests\n\nimport $module_name.greeting\n\n@test(\"the greeting names whom it greets\")\ngreetsByName()\n    assertEq(greeting(\"Avin\"), \"Hello, Avin!\")\n"),
    ]
    for (file, text) in files
        write_text(dir + "/" + file, text).map_err(e -> s"avin: $dir/$file: ${e.to_string()}")?
    if !library
        write_text(dir + "/main.avin", s"import $module_name.greeting\n\nmain()\n    println(greeting(\"world\"))\n").map_err(e -> s"avin: $dir/main.avin: ${e.to_string()}")?
    Ok(package_name)

// Small helpers.

private contains(items: Buf[string], item: string) -> bool = index_of(items, item) is Some(_)

private index_of(items: Buf[string], item: string) -> Option[usize]
    for i in 0..<items.len()
        if items[i] == item then return Some(i)
    None
