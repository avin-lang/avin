module dev.avinlang.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}

// Exhaustiveness. The patterns of a match form a matrix: one row per unguarded arm, one column per
// value being matched. The matrix covers its columns when every combination of values matches some
// row. A column is decided by splitting it on the cases its type enumerates: `true` and `false` for
// `bool`, and the variants of a data type, whose fields become columns of their own. An integer,
// byte or char column is split into the stretches of values that no pattern's bounds divide, so
// literals, ranges, comparisons and `n + k` together cover it when every stretch is matched. A
// column of sequence patterns is split on the sequence's length. Rows with a guard are left out,
// since a guard may always fail, and an extractor pattern matches no case, since it may answer that
// it does not match.

private struct Row
    items: Buf[&TPattern]

/** Whether the clauses of a function cover every combination of arguments of the parameter
 * types; a clause counts when one of its bodies has no guard. */
clauses_cover(clauses: Buf[TClause], params: Buf[&Type], data: Buf[DataSymbol]) -> bool
    var rows: Buf[Row] = buf()
    for clause in clauses
        var always = false
        for b in clause.bodies
            if b.guard is None then always = true
        if always then rows.push(Row(clause.patterns))
    if params.len() == 0 then return rows.len() > 0
    covers(rows, params, data)

/** Whether the unguarded arms of a match on a value of type `ty` cover every value. */
match_covers(arms: Buf[TArm], ty: &Type, data: Buf[DataSymbol]) -> bool
    var rows: Buf[Row] = buf()
    for arm in arms
        if arm.guard is Some(_) then continue
        var items: Buf[&TPattern] = buf()
        items.push(arm.pattern)
        rows.push(Row(items))
    var types: Buf[&Type] = buf()
    types.push(ty)
    covers(rows, types, data)

/** The cases a type enumerates for coverage, or none for a type with too many values. */
private enum Case
    BoolCase(value: bool)
    /** A variant, with the types of its fields in the matched type. */
    VariantCase(index: usize, fields: Buf[&Type])

private cases_of(t: &Type, data: Buf[DataSymbol]) -> Buf[Case]
    var out: Buf[Case] = buf()
    *t match
        Bool ->
            out.push(BoolCase(true))
            out.push(BoolCase(false))
        Data(id, _, args) ->
            val d = data[id]
            for i in 0..<d.variants.len()
                out.push(VariantCase(i, variant_fields(d, id, i, args)))
        // A tuple has one shape, whose parts become columns.
        Tuple(items) -> out.push(VariantCase(0, items))
        _ -> ()
    out

// A pattern that matches every value of its type: a wildcard, a binding, a type pattern naming a
// type the value's type already conforms to, `()` for unit, and any pattern that already failed to
// check, so that one error is not reported again as a gap. With `views`, an extractor pattern is
// taken to match every value too: the gaps left then are values no extractor could have taken.
private unconstrained(p: &TPattern, views: bool) -> bool = p.kind match
    PWildcard -> true
    PBind(_) -> true
    PType(_, _, tested) -> !tested || *p.ty is ErrorType
    PLiteral(_) -> *p.ty is Unit || *p.ty is ErrorType
    PView(_, _, _) -> views || *p.ty is ErrorType
    _ -> *p.ty is ErrorType

private matches_case(p: &TPattern, case: Case) -> bool = case match
    BoolCase(value) -> p.kind match
        PLiteral(constant) -> constant.kind match
            BoolConst(b) -> b == value
            _ -> false
        _ -> false
    VariantCase(index, _) -> p.kind match
        PVariant(i, _) -> i == index
        _ -> false

// A row specialized to a case: its first pattern is replaced by the patterns of the case's fields,
// which are wildcards when the first pattern matched anything.
private specialize(row: Row, case: Case) -> Row
    var items: Buf[&TPattern] = buf()
    val head = row.items[0]
    case match
        VariantCase(_, fields) -> head.kind match
            PVariant(_, inner) ->
                for p in inner
                    items.push(p)
            _ ->
                for t in fields
                    items.push(TPattern(Span(0, 0), t, PWildcard))
        BoolCase(_) -> ()
    for i in 1..<row.items.len()
        items.push(row.items[i])
    Row(items)

// Integer, byte and char values are written as signed decimal strings, so integers of any width
// compare exactly.

/** An inclusive stretch of values. */
private struct Interval
    low: string
    high: string

// The values of an ordered scalar type, as stretches in increasing order; empty for any other type.
// A char is a Unicode scalar, so the surrogates are not among its values.
private domain_of(t: &Type) -> Buf[Interval]
    var out: Buf[Interval] = buf()
    *t match
        Int(bits) ->
            val minimum = min_digits(bits)
            out.push(Interval(minimum, decrement(minimum[1..])))
        Byte -> out.push(Interval("0", "255"))
        Char ->
            out.push(Interval("0", "55295"))
            out.push(Interval("57344", "1114111"))
        _ -> ()
    out

private constant_value(e: &TExpr) -> string = e.kind match
    IntConst(digits) -> digits
    CharConst(code) -> code.to_string()
    _ -> "0"

// The values a pattern matches in an ordered column, given the type's least and greatest values;
// none for a pattern that does not constrain the column by order.
private interval_of(p: &TPattern, least: string, greatest: string) -> Option[Interval] = p.kind match
    PLiteral(value) ->
        val v = constant_value(value)
        Some(Interval(v, v))
    PBounds(_, lower, upper) ->
        var low = least
        var high = greatest
        if lower is Some(b) then low = if b.inclusive then constant_value(b.value) else successor(constant_value(b.value))
        if upper is Some(b) then high = if b.inclusive then constant_value(b.value) else predecessor(constant_value(b.value))
        Some(Interval(low, high))
    PSuccessor(_, amount) -> Some(Interval(constant_value(amount), greatest))
    _ -> None

// Every boundary of every row's stretch and of the domain cuts the values into pieces that each row
// either matches entirely or not at all; each piece inside the domain must be covered by the rows
// that match it, on the remaining columns.
private witness_ordered(rows: Buf[Row], domain: Buf[Interval], t: &Type, rest: Buf[&Type], data: Buf[DataSymbol], views: bool) -> Option[Buf[string]]
    val least = domain[0].low
    val greatest = domain[domain.len() - 1].high
    var cuts: Buf[string] = buf()
    for d in domain
        add_cut(cuts, d.low)
        add_cut(cuts, successor(d.high))
    for row in rows
        if interval_of(row.items[0], least, greatest) is Some(i)
            if compare_signed(i.low, i.high) <= 0
                add_cut(cuts, i.low)
                add_cut(cuts, successor(i.high))
    for k in 0..<cuts.len() - 1
        val start = cuts[k]
        var inside = false
        for d in domain
            if compare_signed(d.low, start) <= 0 && compare_signed(start, d.high) <= 0 then inside = true
        if !inside then continue
        var specialized: Buf[Row] = buf()
        for row in rows
            val head = row.items[0]
            var matched = unconstrained(head, views)
            if interval_of(head, least, greatest) is Some(i)
                matched = compare_signed(i.low, start) <= 0 && compare_signed(start, i.high) <= 0
            if matched then specialized.push(tail_of(row))
        if witness(specialized, rest, data, views) is Some(parts)
            val example = if *t is Char then printable_in(start, predecessor(cuts[k + 1])) else example_in(start, predecessor(cuts[k + 1]))
            return in_front(spell_value(t, example), Some(parts))
    None

// The value of a stretch of integers to name as an example: zero, or the one nearest it.
private example_in(low: string, high: string) -> string
    if compare_signed(low, "0") <= 0 && compare_signed("0", high) <= 0 then return "0"
    if compare_signed(high, "0") < 0 then return high
    low

// The char of a stretch to name as an example: `a` when it is there, else the first printable one.
private printable_in(low: string, high: string) -> string
    if compare_signed(low, "97") <= 0 && compare_signed("97", high) <= 0 then return "97"
    if compare_signed(low, "126") <= 0 && compare_signed("32", high) <= 0
        return if compare_signed(low, "32") < 0 then "32" else low
    low

// A value of an ordered scalar type written as a literal pattern.
private spell_value(t: &Type, value: string) -> string
    if !(*t is Char) then return value
    var code = 0u32
    for b in value.bytes
        code = code * 10 + u32(b - u8('0'))
    if code == 39 then return "'\\''"
    if code == 92 then return "'\\\\'"
    if code >= 32 && code < 127 then return "'" + char(u8(code)).to_string() + "'"
    s"'\\u{${hex(code)}}'"

private hex(n: u32) -> string
    if n == 0 then return "0"
    val digits = "0123456789abcdef"
    var out = ""
    var m = n
    while m > 0
        out = char(digits.bytes[usize(m % 16)]).to_string() + out
        m = m / 16
    out

// Inserts a value into a sorted list of distinct values.
private add_cut(cuts: Buf[string], value: string)
    var at = 0usize
    while at < cuts.len()
        val order = compare_signed(cuts[at], value)
        if order == 0 then return
        if order > 0 then break
        at += 1
    cuts.push(value)
    var i = cuts.len() - 1
    while i > at
        cuts.set(i, cuts[i - 1])
        i -= 1
    cuts.set(at, value)

/** Compares two signed decimal integers: negative, zero or positive. */
compare_signed(a: string, b: string) -> int
    val a_negative = a.starts_with("-")
    val b_negative = b.starts_with("-")
    if a_negative != b_negative then return if a_negative then -1 else 1
    if a_negative then return compare_magnitude(b[1..], a[1..])
    compare_magnitude(a, b)

private compare_magnitude(a: string, b: string) -> int
    if a.bytes.len != b.bytes.len then return if a.bytes.len < b.bytes.len then -1 else 1
    for i in 0..<a.bytes.len
        if a.bytes[i] != b.bytes[i] then return if a.bytes[i] < b.bytes[i] then -1 else 1
    0

/** The signed decimal integer one greater. */
successor(a: string) -> string
    if a.starts_with("-")
        val m = decrement(a[1..])
        return if m == "0" then "0" else "-" + m
    increment(a)

/** The signed decimal integer one less. */
predecessor(a: string) -> string
    if a == "0" then return "-1"
    if a.starts_with("-") then return "-" + increment(a[1..])
    decrement(a)

// One more than a decimal magnitude.
private increment(m: string) -> string
    var digits: Buf[u8] = buf()
    for b in m.bytes
        digits.push(b)
    var i = digits.len()
    loop
        if i == 0 then return "1" + digits_text(digits)
        i -= 1
        if digits[i] == u8('9') then digits.set(i, u8('0'))
        else
            digits.set(i, digits[i] + 1)
            return digits_text(digits)

// One less than a positive decimal magnitude, without a leading zero.
private decrement(m: string) -> string
    var digits: Buf[u8] = buf()
    for b in m.bytes
        digits.push(b)
    var i = digits.len()
    while i > 0
        i -= 1
        if digits[i] == u8('0') then digits.set(i, u8('9'))
        else
            digits.set(i, digits[i] - 1)
            break
    val text = digits_text(digits)
    if text.bytes.len > 1 && text.bytes[0] == u8('0') then return text[1..]
    text

private digits_text(digits: Buf[u8]) -> string
    var out = ""
    for d in digits
        out = out + char(d).to_string()
    out

private with_head(row: Row, head: &TPattern) -> Row
    var items: Buf[&TPattern] = buf()
    items.push(head)
    for i in 1..<row.items.len()
        items.push(row.items[i])
    Row(items)

private tail_of(row: Row) -> Row
    var items: Buf[&TPattern] = buf()
    for i in 1..<row.items.len()
        items.push(row.items[i])
    Row(items)

private covers(rows: Buf[Row], types: Buf[&Type], data: Buf[DataSymbol]) -> bool = witness(rows, types, data, false) is None

/** A value the unguarded arms of a match on a value of type `ty` leave out, written as a pattern,
 * such as `Rect(_, _)` or `-1`; `None` when they cover every value. With `views`, an extractor
 * pattern is taken to match every value, so a value found is one no arm can match, whatever its
 * extractors answer. */
missing_case(arms: Buf[TArm], ty: &Type, data: Buf[DataSymbol], views: bool) -> Option[string]
    var rows: Buf[Row] = buf()
    for arm in arms
        if arm.guard is Some(_) then continue
        var items: Buf[&TPattern] = buf()
        items.push(arm.pattern)
        rows.push(Row(items))
    var types: Buf[&Type] = buf()
    types.push(ty)
    witness(rows, types, data, views) match
        Some(parts) -> if parts.len() > 0 then Some(parts[0]) else None
        None -> None

// The columns of one combination of values that no row matches, each written as a pattern, or `None`
// when the rows cover every combination. It decides as `covers` describes: split the first column on
// its cases, on the lengths of a sequence, or on the stretches of its ordered values, and look for a
// gap in each.
private witness(rows: Buf[Row], types: Buf[&Type], data: Buf[DataSymbol], views: bool) -> Option[Buf[string]]
    if rows.len() == 0
        var all: Buf[string] = buf()
        for t in types
            all.push("_")
        return Some(all)
    if types.len() == 0 then return None
    // Alternatives become one row per option, and a named pattern is its inner pattern; both only in
    // the first column, so a row keeps its other columns' patterns together.
    var expanded: Buf[Row] = buf()
    var changed = false
    for row in rows
        val head = row.items[0]
        head.kind match
            PNamed(_, inner) ->
                changed = true
                expanded.push(with_head(row, inner))
            PAlternatives(options) ->
                changed = true
                for o in options
                    expanded.push(with_head(row, o))
            _ -> expanded.push(row)
    if changed then return witness(expanded, types, data, views)
    var rest: Buf[&Type] = buf()
    for i in 1..<types.len()
        rest.push(types[i])
    var defaults: Buf[Row] = buf()
    var sequence = false
    for row in rows
        if unconstrained(row.items[0], views) then defaults.push(tail_of(row))
        elif row.items[0].kind is PSequence(_, _, _, _, _) then sequence = true
    if sequence then return witness_sequence(rows, rest, data, views)
    if defaults.len() < rows.len()
        val domain = domain_of(types[0])
        if domain.len() > 0 then return witness_ordered(rows, domain, types[0], rest, data, views)
    val cases = cases_of(types[0], data)
    if defaults.len() == rows.len() || cases.len() == 0 then return in_front("_", witness(defaults, rest, data, views))
    for case in cases
        var specialized: Buf[Row] = buf()
        for row in rows
            val head = row.items[0]
            if unconstrained(head, views) || matches_case(head, case) then specialized.push(specialize(row, case))
        var columns: Buf[&Type] = buf()
        if case is VariantCase(_, fields)
            for t in fields
                columns.push(t)
        for t in rest
            columns.push(t)
        if witness(specialized, columns, data, views) is Some(parts) then return Some(spell_case(types[0], case, parts, data))
    None

// A column of a sequence other than a list, split on its length. With `longest` the most elements
// any sequence pattern names, every length up to it is a case of its own, and every longer length is
// one more case, written with `_*`. A case of `n` elements has a column for each: a pattern of that
// many elements gives its own, one with a rest gives its own and wildcards for the elements its rest
// takes, and a pattern matching any sequence gives wildcards. A rest that constrains what it takes,
// and any other pattern, matches no case.
private witness_sequence(rows: Buf[Row], rest: Buf[&Type], data: Buf[DataSymbol], views: bool) -> Option[Buf[string]]
    var longest = 0usize
    var element: &Type = ErrorType
    for row in rows
        if row.items[0].kind is PSequence(_, _, elements, items, open)
            val fixed = if open then items.len() - 1 else items.len()
            if fixed > longest then longest = fixed
            if fixed > 0 then element = elements[0].ty
    for n in 0..<longest + 2
        val longer = n == longest + 1
        var specialized: Buf[Row] = buf()
        for row in rows
            val head = row.items[0]
            var items: Buf[&TPattern] = buf()
            var matched = false
            if unconstrained(head, views)
                matched = true
            elif head.kind is PSequence(_, _, _, parts, open)
                val fixed = if open then parts.len() - 1 else parts.len()
                matched = if open then fixed <= n && unconstrained(parts[fixed], views) else fixed == n && !longer
                if matched
                    for i in 0..<fixed
                        items.push(parts[i])
            if !matched then continue
            while items.len() < n
                items.push(TPattern(Span(0, 0), element, PWildcard))
            for i in 1..<row.items.len()
                items.push(row.items[i])
            specialized.push(Row(items))
        var columns: Buf[&Type] = buf()
        for i in 0..<n
            columns.push(element)
        for t in rest
            columns.push(t)
        if witness(specialized, columns, data, views) is Some(parts)
            var inner = ""
            for i in 0..<n
                if i > 0 then inner = inner + ", "
                inner = inner + parts[i]
            if longer then inner = inner + ", _*"
            var out: Buf[string] = buf()
            out.push("[" + inner + "]")
            for i in n..<parts.len()
                out.push(parts[i])
            return Some(out)
    None

private in_front(head: string, found: Option[Buf[string]]) -> Option[Buf[string]] = found match
    Some(parts) ->
        var out: Buf[string] = buf()
        out.push(head)
        for p in parts
            out.push(p)
        Some(out)
    None -> None

// Columns that start with a case's fields, as one column holding the case written as a pattern:
// `Rect(_, _)`, `(1, _)`, `true`, and a list's cases as `[]` and `_ :: _`.
private spell_case(t: &Type, case: Case, parts: Buf[string], data: Buf[DataSymbol]) -> Buf[string]
    var k = 0usize
    if case is VariantCase(_, fields) then k = fields.len()
    var inner = ""
    for i in 0..<k
        if i > 0 then inner = inner + ", "
        inner = inner + parts[i]
    val head = case match
        BoolCase(value) -> if value then "true" else "false"
        VariantCase(index, _) -> *t match
            Data(id, _, _) ->
                val d = data[id]
                val name = d.variants[index].name
                if d.module_name == "avin" && d.name == "List" && name == "Nil" then "[]"
                elif d.module_name == "avin" && d.name == "List" && name == "Cons" && k == 2
                    val first = if parts[0].contains(" :: ") then "(" + parts[0] + ")" else parts[0]
                    first + " :: " + parts[1]
                elif k == 0 then name
                else name + "(" + inner + ")"
            _ -> "(" + inner + ")"
    var out: Buf[string] = buf()
    out.push(head)
    for i in k..<parts.len()
        out.push(parts[i])
    out
