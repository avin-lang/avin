module dev.avinlang.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.fs.{current_dir, entries, exists, make_dir_all, make_temp_dir, metadata, read_text, remove_dir_all, remove_file, set_modified, write_text}
import sysl.process.{Exited, Stdio, Var, capture, spawn}
import sysl.slices.sort
import sysl.text.parse_int
import sysl.time.{micros, now}

// The instance cache: a build keeps what lowering and emission made of each instance under its key,
// and the next build takes an unchanged instance's code and text from it. Each test builds a program,
// changes it or the cache, builds again with the cache, and holds the second build to two things:
// it lowered exactly the instances whose own keys are new, and its text is a clean build's.

private const Geo: string = "module geo\n\ndata Shape\n    Circle(r: int)\n    Square(side: int)\n\nclass Box(val w: int, val h: int)\n    area() -> int = w * h\n\ntrait Named\n    name() -> string\n\nclass Cat(val n: string): Named\n    override name() -> string = \"cat \" + n\n\nval limit = 10\n\nscale(x: int, by: int = 2) -> int = x * by\n\narea(s: Shape) -> int = s match\n    Circle(r) -> 3 * r * r\n    Square(a) -> a * a\n"

private const Extra: string = "module extra\n\nhelper(n: int) -> int = n + 100\n\nhalf(n: int) -> int = 100 / n\n\nthird(n: int) = n / 3\n"

private const Main: string = "import geo.{Shape, Circle, Square, Box, Named, Cat, area, scale, limit}\nimport extra.{helper, half, third}\n\ndata Pair(a: int, b: int)\n\ntwice[T](x: T) -> (T, T) = (x, x)\n\ndescribe(n: Named) -> string = n.name()\n\nshown(x: Any) -> string = x match\n    n: Named -> n.name()\n    _ -> \"other\"\n\ntotal(xs: Vector[int]) -> int\n    var sum = 0\n    for x in xs\n        sum = sum + x\n    sum\n\nmain()\n    println(area(Circle(2)) + area(Square(3)))\n    println(twice(1))\n    println(twice(\"a\"))\n    println(twice(Pair(1, 2)))\n    val k = 3\n    val add = (x: int) -> x + k\n    println(add(4))\n    println(describe(Cat(\"tom\")))\n    println(shown(Cat(\"x\")))\n    println(Box(2, 3).area())\n    println(scale(5))\n    println(limit)\n    println(Pair(1, 2) == Pair(1, 2))\n    println(total([1, 2, 3]))\n    println(helper(1))\n    println(half(4))\n    println(third(9))\n    println(1.5 * 2.0)\n"

/** The program's three files, under directory `dir`. */
private program_of(dir: string, main: string, geo: string, extra: string) -> Buf[ProgramFile]
    var files: Buf[ProgramFile] = buf()
    files.push(ProgramFile(source_of(dir + "/geo/geo.avin", geo), Some("geo"), false, buf(), ""))
    files.push(ProgramFile(source_of(dir + "/extra/extra.avin", extra), Some("extra"), false, buf(), ""))
    files.push(ProgramFile(source_of(dir + "/main.avin", main), None, false, buf(), ""))
    files

/** `text` with its one `old` replaced by `new`. */
private edited(text: string, old: string, new: string) -> string
    assert(text.contains(old), "the edit's text is not in the program: " + old)
    text.replace_all(old, new)

/** A build of `files` with the instance cache in `cache`. */
private cached(files: Buf[ProgramFile], cache: string) -> CachedLowering = cached_lowering(repository_toolchain(), files, cache) match
    Ok(c) -> c
    Err(d) -> panic(d)

/** A build of `files` with no instance cache: the oracle. */
private clean(files: Buf[ProgramFile]) -> string
    val compiled = compile_files(repository_toolchain(), files)
    assert_eq(compiled.diagnostics, "")
    compiled.llvm.unwrap()

/** The symbols of the functions a build lowered that an entry could have held, and the own keys of
 * those it made an entry for or read one from. */
private struct Lowered
    fresh: Buf[string]
    reused: Buf[string]
    keys: Map[string, bool]

private lowered_of(c: CachedLowering) -> Lowered
    val p = c.program
    var fresh: Buf[string] = buf()
    var reused: Buf[string] = buf()
    var keys: Map[string, bool] = map()
    for i in 0..<p.functions.len()
        if p.stored[i] == "" then continue
        keys.put(p.key_inputs.own[i], true)
        if p.reused[i] then reused.push(p.functions[i].symbol) else fresh.push(p.functions[i].symbol)
    Lowered(fresh, reused, keys)

/** Builds the program, then the edited one with the same cache, and holds the second build to its
 * two rules: an instance is lowered exactly where no earlier build made an entry for its own key, and
 * the text is a clean build's. Answers the symbols the second build lowered. */
private edit_lowers(main: string, geo: string, extra: string) -> Buf[string]
    val dir = make_temp_dir("avin-ic").unwrap()
    defer _ = remove_dir_all(dir)
    val cache = dir + "/cache"
    val first = cached(program_of(dir, Main, Geo, Extra), cache)
    assert_eq(first.llvm, clean(program_of(dir, Main, Geo, Extra)))
    val before = lowered_of(first)
    assert_eq(before.reused.len(), 0)
    val files = program_of(dir, main, geo, extra)
    val second = cached(files, cache)
    val p = second.program
    for i in 0..<p.functions.len()
        val had = before.keys.get(p.key_inputs.own[i]) is Some(_)
        if p.stored[i] != "" then assert_eq(p.reused[i], had, p.functions[i].symbol)
        else assert(!p.reused[i], p.functions[i].symbol)
    assert_eq(second.llvm, clean(files))
    lowered_of(second).fresh

private holds(symbols: Buf[string], name: string) -> bool
    for s in symbols
        if s == name then return true
    false

@test("a second build of an unchanged program lowers nothing an entry holds and emits nothing again")
unchanged_program_reuses_everything()
    val dir = make_temp_dir("avin-ic").unwrap()
    defer _ = remove_dir_all(dir)
    val files = program_of(dir, Main, Geo, Extra)
    val first = cached(files, dir + "/cache")
    val made = lowered_of(first)
    assert(made.fresh.len() > 10)
    assert_eq(first.texts_reused, 0)
    val second = cached(files, dir + "/cache")
    val again = lowered_of(second)
    assert_eq(again.fresh.len(), 0)
    assert_eq(again.reused.len(), made.fresh.len())
    assert_eq(second.texts_reused, second.program.functions.len())
    assert_eq(second.llvm, first.llvm)
    assert_eq(second.llvm, clean(files))

@test("a body edited in one module lowers that function alone")
body_edit_lowers_its_function()
    val fresh = edit_lowers(Main, Geo, edited(Extra, "n + 100", "n + 101"))
    assert_eq(fresh.len(), 1)
    assert(holds(fresh, "extra.helper"))

@test("a default argument changed lowers what reads it and none of the other module's functions")
default_argument_edit_lowers_callers()
    val fresh = edit_lowers(Main, edited(Geo, "by: int = 2", "by: int = 3"), Extra)
    assert(fresh.len() >= 1)
    assert(!holds(fresh, "extra.helper"))

@test("a signature changed lowers the function and its callers")
signature_edit_lowers_callers()
    val fresh = edit_lowers(edited(Main, "println(helper(1))", "println(helper(long(1)))"), Geo, edited(Extra, "helper(n: int) -> int = n + 100", "helper(n: long) -> long = n + 100"))
    assert(holds(fresh, "extra.helper"))
    assert(holds(fresh, "<program>.main"))
    assert(!holds(fresh, "extra.half"))

@test("a field added to a class lowers every function that lays it out or reads it")
field_edit_lowers_users()
    val fresh = edit_lowers(Main, edited(Geo, "class Box(val w: int, val h: int)", "class Box(val w: int, val h: int, val d: int = 1)"), Extra)
    assert(holds(fresh, "geo.Box.area"))
    assert(!holds(fresh, "extra.helper"))

@test("a class added that implements a trait keeps every other function's code and gives a clean build's text")
implementing_class_added()
    val fresh = edit_lowers(Main, Geo + "\nclass Dog(val n: string): Named\n    override name() -> string = \"dog \" + n\n", Extra)
    assert(!holds(fresh, "extra.helper"))

@test("a generic function's body edited lowers every instance of it")
generic_edit_lowers_every_instance()
    val fresh = edit_lowers(edited(Main, "twice[T](x: T) -> (T, T) = (x, x)", "twice[T](x: T) -> (T, T) = (x, x) match\n    p -> p"), Geo, Extra)
    var instances = 0
    for s in fresh
        if s.starts_with("<program>.twice[") then instances += 1
    assert_eq(instances, 3)

@test("a lambda's captures changed lowers its function and the function it is in")
lambda_captures_edit()
    val fresh = edit_lowers(edited(Main, "val add = (x: int) -> x + k", "val add = (x: int) -> x + k + limit"), Geo, Extra)
    assert(holds(fresh, "<program>.main"))
    assert(!holds(fresh, "extra.helper"))

@test("lines added above every function lower nothing, and the trap sites below them report their new lines")
lines_added_above_lower_nothing()
    val moved = "module extra\n\n// A helper.\n\n\n" + Extra["module extra\n\n".bytes.len..]
    val fresh = edit_lowers(Main, Geo, moved)
    assert_eq(fresh.len(), 0)

@test("a comment inside a function lowers that function")
comment_inside_lowers_it()
    val fresh = edit_lowers(Main, Geo, edited(Extra, "half(n: int) -> int = 100 / n", "half(n: int) -> int =\n    // the half\n    100 / n"))
    assert(holds(fresh, "extra.half"))
    assert(!holds(fresh, "extra.helper"))

@test("a module-level constant changed lowers what reads it and none of the other module's functions")
constant_edit_lowers_readers()
    val fresh = edit_lowers(Main, edited(Geo, "val limit = 10", "val limit = 11"), Extra)
    assert(holds(fresh, "<program>.main"))
    assert(!holds(fresh, "extra.helper"))
    assert(!holds(fresh, "geo.area"))

@test("an overload added renames the overloaded function and lowers it and its callers, nothing else of its module")
overload_added_lowers_the_renamed_and_callers()
    val fresh = edit_lowers(Main, Geo, Extra + "\nhelper(s: string) -> string = s + \"!\"\n")
    assert(holds(fresh, "extra.helper(int)"))
    assert(holds(fresh, "<program>.main"))
    assert(!holds(fresh, "extra.half"))
    assert(!holds(fresh, "geo.area"))

@test("an impl of a trait added for a data type gives a clean build's text and keeps the other module's code")
data_impl_added()
    val fresh = edit_lowers(Main, Geo + "\nimpl Named for Shape\n    name() -> string = \"shape\"\n", Extra)
    assert(!holds(fresh, "extra.helper"))
    assert(!holds(fresh, "extra.half"))

@test("a data type's field renamed lowers what lays it out and none of the other modules' functions")
data_field_renamed()
    val fresh = edit_lowers(edited(Main, "data Pair(a: int, b: int)", "data Pair(first: int, b: int)"), Geo, Extra)
    assert(fresh.len() >= 1)
    assert(!holds(fresh, "extra.helper"))
    assert(!holds(fresh, "geo.area"))

@test("a callee's inferred result changed lowers the callee and its caller")
inferred_result_edit_lowers_callers()
    val fresh = edit_lowers(Main, Geo, edited(Extra, "third(n: int) = n / 3", "third(n: int) = long(n) / long(3)"))
    assert(holds(fresh, "extra.third"))
    assert(holds(fresh, "<program>.main"))
    assert(!holds(fresh, "extra.helper"))

// A recursive function yielding a tuple, and a caller taking it apart, which calls its copy answering
// with the tuple's parts as words.
private const WordsExtra: string = "module extra\n\nhelper(n: int) -> int = n + 100\n\nsplit(n: int) -> (int, string)\n    if n == 0 then return (0, \"z\")\n    val (a, b) = split(n - 1)\n    (a + 1, b + \"y\")\n"

private const WordsMain: string = "import extra.{helper, split}\n\nmain()\n    val (a, b) = split(3)\n    println(a)\n    println(b)\n    println(helper(1))\n"

@test("a copy answering with words, and its callers, are read back from the cache with a clean build's text, and an edit to the function lowers its copy")
words_copies_cached()
    val dir = make_temp_dir("avin-ic").unwrap()
    defer _ = remove_dir_all(dir)
    val files = program_of(dir, WordsMain, Geo, WordsExtra)
    val first = cached(files, dir + "/cache")
    assert(holds(lowered_of(first).fresh, "extra.split#words"))
    assert_eq(first.llvm, clean(files))
    val second = cached(files, dir + "/cache")
    val again = lowered_of(second)
    assert_eq(again.fresh.len(), 0)
    assert(holds(again.reused, "extra.split#words"))
    assert(holds(again.reused, "<program>.main"))
    assert_eq(second.llvm, clean(files))
    val changed = program_of(dir, WordsMain, Geo, edited(WordsExtra, "b + \"y\"", "b + \"w\""))
    val third = cached(changed, dir + "/cache")
    val fresh = lowered_of(third).fresh
    assert(holds(fresh, "extra.split#words"))
    assert(!holds(fresh, "extra.helper"))
    assert(!holds(fresh, "<program>.main"))
    assert_eq(third.llvm, clean(changed))

@test("a lambda's body edited lowers the lambda and none of the other modules' functions")
lambda_body_edit()
    val fresh = edit_lowers(edited(Main, "val add = (x: int) -> x + k", "val add = (x: int) -> x * k"), Geo, Extra)
    assert(fresh.len() >= 1)
    assert(!holds(fresh, "extra.helper"))
    assert(!holds(fresh, "geo.area"))

@test("a function moved below another lowers nothing")
function_moved_lowers_nothing()
    val moved = edited(Extra, "helper(n: int) -> int = n + 100\n\nhalf(n: int) -> int = 100 / n\n", "half(n: int) -> int = 100 / n\n\nhelper(n: int) -> int = n + 100\n")
    val fresh = edit_lowers(Main, Geo, moved)
    assert_eq(fresh.len(), 0)

@test("a function no longer called is gone from the text and a string added is in it")
instance_dropped_and_string_added()
    val fresh = edit_lowers(edited(Main, "    println(helper(1))\n", "    println(\"new\")\n"), Geo, Extra)
    assert(holds(fresh, "<program>.main"))

// --- the cache's files -----------------------------------------------------------------------------

/** The module files of the cache in `dir`, by full path. */
private module_files(dir: string) -> Buf[string]
    var out: Buf[string] = buf()
    for name in entries(dir).unwrap()
        if name.ends_with(".mod") then out.push(dir + "/" + name)
    val sorted = out.view_mut()
    sort(sorted)
    var files: Buf[string] = buf()
    for f in sorted
        files.push(f)
    files

@test("a truncated module file is passed over, its instances lowered again, and replaced")
truncated_file_is_a_miss()
    val dir = make_temp_dir("avin-ic").unwrap()
    defer _ = remove_dir_all(dir)
    val files = program_of(dir, Main, Geo, Extra)
    val cache = dir + "/cache"
    val first = cached(files, cache)
    val made = lowered_of(first).fresh.len()
    val store = read_instance_store(cache)
    assert_eq(store.damaged, 0)
    for f in module_files(cache)
        val text = read_text(f).unwrap()
        write_text(f, text[0..<text.bytes.len - 7]).unwrap()
    val damaged = read_instance_store(cache)
    assert_eq(damaged.damaged, damaged.files)
    assert_eq(damaged.lowered.len(), 0)
    val second = cached(files, cache)
    assert_eq(lowered_of(second).fresh.len(), made)
    assert_eq(second.texts_reused, 0)
    assert_eq(second.llvm, clean(files))
    // The build wrote whole files again, which the next one reads.
    val third = cached(files, cache)
    assert_eq(lowered_of(third).fresh.len(), 0)
    assert_eq(third.llvm, clean(files))

@test("a module file with one byte changed fails its checksum and is never trusted")
damaged_file_is_never_trusted()
    val dir = make_temp_dir("avin-ic").unwrap()
    defer _ = remove_dir_all(dir)
    val files = program_of(dir, Main, Geo, Extra)
    val cache = dir + "/cache"
    _ = cached(files, cache)
    // Make every `ret` of the text entries a `rex`: the lengths still match, the checksum does not.
    for f in module_files(cache)
        write_text(f, read_text(f).unwrap().replace_all("  ret ", "  rex ")).unwrap()
    val store = read_instance_store(cache)
    assert(store.damaged > 0)
    for (_, payload) in store.texts
        assert(!payload.contains("  rex "))
    val second = cached(files, cache)
    assert(!second.llvm.contains("  rex "))
    assert_eq(second.llvm, clean(files))

@test("a missing manifest or module file is an empty cache, not an error")
missing_files_are_misses()
    val dir = make_temp_dir("avin-ic").unwrap()
    defer _ = remove_dir_all(dir)
    val files = program_of(dir, Main, Geo, Extra)
    val cache = dir + "/cache"
    val empty = read_instance_store(cache)
    assert_eq(empty.files, 0)
    assert_eq(empty.lowered.len(), 0)
    _ = cached(files, cache)
    for f in module_files(cache)
        remove_file(f).unwrap()
    val gone = read_instance_store(cache)
    assert_eq(gone.damaged, gone.files)
    val second = cached(files, cache)
    assert_eq(lowered_of(second).reused.len(), 0)
    assert_eq(second.llvm, clean(files))

@test("a manifest naming anything but a module file of its directory has that name passed over, never read")
manifest_names_only_module_files()
    assert(is_module_file_name("6d0d4281df094b2437783940fb8deb16.mod"))
    assert(!is_module_file_name(".mod"))
    assert(!is_module_file_name("../6d0d4281df094b2437783940fb8deb16.mod"))
    assert(!is_module_file_name("sub/6d0d.mod"))
    assert(!is_module_file_name("6D0D.mod"))
    assert(!is_module_file_name("6d0d.mod.pending-1-1"))
    assert(!is_module_file_name("manifest"))
    val dir = make_temp_dir("avin-ic").unwrap()
    defer _ = remove_dir_all(dir)
    val files = program_of(dir, Main, Geo, Extra)
    val cache = dir + "/cache"
    _ = cached(files, cache)
    // A whole module file moved one directory up is still whole, but the manifest may not reach it.
    val moved = module_files(cache)
    val name = moved[0][cache.bytes.len + 1..]
    write_text(dir + "/" + name, read_text(moved[0]).unwrap()).unwrap()
    write_text(cache + "/manifest", "../" + name + "\n").unwrap()
    val store = read_instance_store(cache)
    assert_eq(store.files, 1)
    assert_eq(store.damaged, 1)
    assert_eq(store.lowered.len(), 0)
    assert_eq(store.texts.len(), 0)
    assert_eq(cached(files, cache).llvm, clean(files))

@test("another compiler's entries are never used: its keys name another stamp")
compiler_change_invalidates()
    val dir = make_temp_dir("avin-ic").unwrap()
    defer _ = remove_dir_all(dir)
    defer stand_in_compiler("")
    val files = program_of(dir, Main, Geo, Extra)
    val cache = dir + "/cache"
    stand_in_compiler("a compiler of yesterday")
    val first = cached(files, cache)
    val made = lowered_of(first).fresh.len()
    stand_in_compiler("a compiler of today")
    val second = cached(files, cache)
    assert_eq(lowered_of(second).reused.len(), 0)
    assert_eq(lowered_of(second).fresh.len(), made)
    assert_eq(second.texts_reused, 0)
    assert_eq(second.llvm, clean(files))
    val third = cached(files, cache)
    assert_eq(lowered_of(third).fresh.len(), 0)

@test("a module file no manifest names is trimmed once an hour old, and the other level's directory is never touched")
trimming_spares_fresh_files_and_the_other_level()
    val dir = make_temp_dir("avin-ic").unwrap()
    defer _ = remove_dir_all(dir)
    val files = program_of(dir, Main, Geo, Extra)
    val o0 = instance_cache_dir(dir + "/.avin/build", false, "-O0")
    val o2 = instance_cache_dir(dir + "/.avin/build", false, "-O2")
    assert(o0 != o2)
    _ = cached(files, o0)
    _ = cached(files, o2)
    val other = module_files(o0)
    val old = now() - micros(InstanceCacheFresh + 60000000)
    for f in other
        set_modified(f, old).unwrap()
    // A stale file in the level being built, one fresh, and a write left behind.
    make_dir_all(o2).unwrap()
    write_text(o2 + "/0123456789abcdef0123456789abcdef.mod", "stale").unwrap()
    set_modified(o2 + "/0123456789abcdef0123456789abcdef.mod", old).unwrap()
    write_text(o2 + "/fedcba9876543210fedcba9876543210.mod", "fresh").unwrap()
    write_text(o2 + "/manifest.pending-1-1", "left").unwrap()
    set_modified(o2 + "/manifest.pending-1-1", old).unwrap()
    _ = cached(program_of(dir, edited(Main, "println(limit)", "println(limit + 1)"), Geo, Extra), o2)
    assert(!exists(o2 + "/0123456789abcdef0123456789abcdef.mod"))
    assert(exists(o2 + "/fedcba9876543210fedcba9876543210.mod"))
    assert(!exists(o2 + "/manifest.pending-1-1"))
    for f in other
        assert(exists(f), f)
    assert_eq(read_instance_store(o0).damaged, 0)

@test("verify names the function whose cached text differs from a clean build's")
verify_names_a_stale_text()
    val dir = make_temp_dir("avin-ic").unwrap()
    defer _ = remove_dir_all(dir)
    val files = program_of(dir, Main, Geo, Extra)
    val cache = dir + "/cache"
    _ = cached(files, cache)
    // Rewrite the cache with helper's text changed, as a key that missed a dependency would leave it.
    val store = read_instance_store(cache)
    var tampered = instance_store_at(cache)
    var changed = 0
    for (key, payload) in store.texts
        var text = payload
        if payload.contains(" @\"extra.helper\"(ptr %ctx, i32 %v0) {")
            text = payload.replace_all("i32 100", "i32 999")
            changed += 1
        keep_entry(&tampered, "all", CacheEntry(TextEntry, key, text))
    for (key, payload) in store.lowered
        keep_entry(&tampered, "all", CacheEntry(LoweredEntry, key, payload))
    assert_eq(changed, 1)
    for f in module_files(cache)
        remove_file(f).unwrap()
    _ = write_instance_store(tampered)
    open_incremental(cache, IncrementalVerify)
    defer close_incremental()
    val compiled = compile_program(repository_toolchain(), files, false, buf(), buf())
    assert(compiled.diagnostics.contains("AVIN_INCREMENTAL=verify: the function `extra.helper`"), compiled.diagnostics)
    close_incremental()
    open_incremental(cache, IncrementalOn)
    val trusting = compile_program(repository_toolchain(), files, false, buf(), buf())
    assert(trusting.llvm.unwrap().contains("i32 999"))

@test("verify passes where the cache is right, at every edit")
verify_passes_a_right_cache()
    val dir = make_temp_dir("avin-ic").unwrap()
    defer _ = remove_dir_all(dir)
    val cache = dir + "/cache"
    open_incremental(cache, IncrementalVerify)
    defer close_incremental()
    for extra in [Extra, edited(Extra, "n + 100", "n + 7"), Extra]
        val compiled = compile_program(repository_toolchain(), program_of(dir, Main, Geo, extra), false, buf(), buf())
        assert_eq(compiled.diagnostics, "")
    assert(read_instance_store(cache).texts.len() > 0)

/** The phases of a build log, in order, and each one's counts. */
private logged_phases(file: string) -> Buf[string]
    var out: Buf[string] = buf()
    for line in read_text(file).unwrap().split("\n")
        if line != "" then out.push(line)
    out

private phase_names(lines: Buf[string]) -> string
    var out = ""
    for line in lines
        out = out + line.split(" ")[0][6..] + " "
    out

private count_in(lines: Buf[string], phase: string, key: string) -> int
    for line in lines
        if line.split(" ")[0] != "phase=" + phase then continue
        for word in line.split(" ")
            if word.starts_with(key + "=") then return parse_int(word[key.bytes.len + 1..]).unwrap()
    panic(s"no `$key` on the `$phase` line")

@test("the build log counts what the cache gave: entries read, instances and texts reused, files written")
build_log_counts_the_cache()
    val dir = make_temp_dir("avin-ic").unwrap()
    defer _ = remove_dir_all(dir)
    val files = program_of(dir, Main, Geo, Extra)
    val log = dir + "/build.log"
    defer close_build_log()
    open_build_log(Some(log)).unwrap()
    _ = compile_program(repository_toolchain(), files, false, buf(), buf())
    val off = logged_phases(log)
    assert_eq(phase_names(off), "load check cunit lower keys shims emit ")
    assert_eq(count_in(off, "lower", "reused"), 0)
    assert_eq(count_in(off, "emit", "reused"), 0)
    open_incremental(dir + "/cache", IncrementalOn)
    defer close_incremental()
    open_build_log(Some(log)).unwrap()
    _ = compile_program(repository_toolchain(), files, false, buf(), buf())
    val cold = logged_phases(log)
    assert_eq(phase_names(cold), "load check cunit cache lower keys shims emit store ")
    assert_eq(count_in(cold, "cache", "files"), 0)
    assert_eq(count_in(cold, "cache", "lowered"), 0)
    assert_eq(count_in(cold, "lower", "reused"), 0)
    assert_eq(count_in(cold, "emit", "reused"), 0)
    assert(count_in(cold, "store", "written") >= 3)
    assert_eq(count_in(cold, "store", "kept"), 0)
    open_build_log(Some(log)).unwrap()
    _ = compile_program(repository_toolchain(), files, false, buf(), buf())
    val warm = logged_phases(log)
    val modules = count_in(cold, "store", "written")
    assert_eq(count_in(warm, "cache", "files"), modules)
    assert_eq(count_in(warm, "cache", "damaged"), 0)
    assert_eq(count_in(warm, "lower", "reused"), count_in(warm, "cache", "lowered"))
    assert_eq(count_in(warm, "emit", "reused"), count_in(warm, "lower", "functions"))
    assert_eq(count_in(warm, "cache", "texts"), count_in(warm, "lower", "functions"))
    assert_eq(count_in(warm, "store", "written"), 0)
    assert_eq(count_in(warm, "store", "kept"), modules)
    assert_eq(count_in(warm, "store", "trimmed"), 0)

@test("AVIN_INCREMENTAL is on, verify, off or unset, unset and empty meaning on; anything else is an error naming it")
incremental_modes()
    assert_eq(incremental_mode_of(None).unwrap(), IncrementalOn)
    assert_eq(incremental_mode_of(Some("")).unwrap(), IncrementalOn)
    assert_eq(incremental_mode_of(Some("off")).unwrap(), IncrementalOff)
    assert(incremental_mode_of(Some("OFF")) is Err(_))
    assert(incremental_mode_of(Some(" off")) is Err(_))
    assert_eq(incremental_mode_of(Some("on")).unwrap(), IncrementalOn)
    assert_eq(incremental_mode_of(Some("verify")).unwrap(), IncrementalVerify)
    assert(incremental_mode_of(Some("yes")).unwrap_err().contains("AVIN_INCREMENTAL is `yes`"))
    assert(incremental_mode_of(Some("On")) is Err(_))
    assert_eq(incremental_now(), IncrementalOff)
    open_incremental("/nowhere", IncrementalOn)
    assert_eq(incremental_now(), IncrementalOn)
    assert_eq(incremental_directory(), "/nowhere")
    close_incremental()
    assert_eq(incremental_now(), IncrementalOff)
    assert_eq(incremental_directory(), "")

@test("each kind and level has its own directory beside the executables")
directories_by_kind_and_level()
    assert_eq(instance_cache_dir("p/.avin/build", false, "-O2"), "p/.avin/build/incremental/program-O2")
    assert_eq(instance_cache_dir("p/.avin/build", true, "-O0"), "p/.avin/build/incremental/tests-O0")

@test("a program of one file has directories named after it, so two files of one directory keep apart")
directories_of_one_file_programs()
    val dir = make_temp_dir("avin-ic").unwrap()
    defer _ = remove_dir_all(dir)
    write_text(dir + "/one.avin", "main() = 0\n").unwrap()
    write_text(dir + "/two.lavin", "main() = 0\n").unwrap()
    assert_eq(program_instance_cache(dir, false, "-O2"), dir + "/.avin/build/incremental/program-O2")
    assert_eq(program_instance_cache(dir, true, "-O0"), dir + "/.avin/build/incremental/tests-O0")
    assert_eq(program_instance_cache(dir + "/one.avin", false, "-O2"), dir + "/.avin/build/incremental/one-program-O2")
    assert_eq(program_instance_cache(dir + "/one.avin", true, "-O2"), dir + "/.avin/build/incremental/one-tests-O2")
    assert_eq(program_instance_cache(dir + "/two.lavin", false, "-O0"), dir + "/.avin/build/incremental/two-program-O0")
    // A file whose name is a directory's own name for its caches still gets a directory of its own.
    write_text(dir + "/program.avin", "main() = 0\n").unwrap()
    assert_eq(program_instance_cache(dir + "/program.avin", false, "-O2"), dir + "/.avin/build/incremental/program-program-O2")

// --- the entries' text -----------------------------------------------------------------------------

/** The typed program of `files`. */
private checked_program(files: Buf[ProgramFile]) -> TProgram
    val loaded = load_units(repository_toolchain().library_dir(), files, false, src -> src) match
        Ok(l) -> l
        Err(m) -> panic(m)
    val result = check_program(loaded.units, loaded.root_module, false)
    if result.has_errors() then panic(result.render())
    result.program.unwrap()

@test("an entry's numbers, words, flags and text read back as written, text of any bytes")
entry_text_round_trips()
    var w = entry_writer()
    w.num(0)
    w.num(18446744073709551615)
    w.word("abc")
    w.flag(true)
    w.flag(false)
    w.opt(None)
    w.opt(Some(7))
    w.text("")
    w.text("two words\nand a line: 5:x ")
    w.text("é 字 🎉")
    val written = w.finish()
    var r = entry_reader(written)
    assert_eq(r.num(), 0)
    assert_eq(r.num(), 18446744073709551615)
    assert_eq(r.word(), "abc")
    assert(r.flag())
    assert(!r.flag())
    assert(r.opt() is None)
    assert_eq(r.opt().unwrap(), 7)
    assert_eq(r.text(), "")
    assert_eq(r.text(), "two words\nand a line: 5:x ")
    assert_eq(r.text(), "é 字 🎉")
    assert(!r.failed)
    assert(r.at_end())

@test("a short or malformed entry fails rather than reading garbage")
entry_text_failures()
    var short = entry_reader("12:abc ")
    assert_eq(short.text(), "")
    assert(short.failed)
    var letters = entry_reader("x ")
    _ = letters.num()
    assert(letters.failed)
    var unended = entry_reader("12")
    _ = unended.num()
    assert(unended.failed)
    var empty = entry_reader("")
    _ = empty.word()
    assert(empty.failed)
    assert(empty.at_end())

@test("every kind of type an entry names reads back as the same type")
types_round_trip()
    val checked = checked_program(program_of("/p", Main, Geo, Extra))
    val names = type_names(checked)
    var samples: Buf[&Type] = buf()
    samples.push(Unit)
    samples.push(Bool)
    samples.push(Char)
    samples.push(Real)
    samples.push(Str)
    samples.push(Byte)
    samples.push(Int(7))
    samples.push(Nothing)
    samples.push(AnyType)
    var parts: Buf[&Type] = buf()
    parts.push(Int(32))
    parts.push(Str)
    samples.push(Tuple(parts))
    samples.push(Function(parts, Bool, true))
    samples.push(ByName(Real))
    samples.push(Union(parts))
    for id in 0..<checked.data.len()
        var args: Buf[&Type] = buf()
        for _ in checked.data[id].decl.type_params
            args.push(Int(64))
        samples.push(Data(id, checked.data[id].name, args))
    for id in 0..<checked.classes.len()
        var args: Buf[&Type] = buf()
        for _ in checked.classes[id].decl.type_params
            args.push(Str)
        samples.push(Class(id, checked.classes[id].name, args))
    for t in samples
        var w = entry_writer()
        assert(write_type(&w, checked, t), type_name(t))
        val text = w.finish()
        var r = entry_reader(text)
        val back = read_type(&r, names).unwrap()
        assert(same_type(back, t), type_name(t))
        assert_eq(stable_type_key(checked, back), stable_type_key(checked, t))
        assert(r.at_end())
    var w = entry_writer()
    assert(!write_type(&w, checked, TypeVar(0, 0, "T")))
    assert(!write_type(&w, checked, ErrorType))

@test("a type naming a declaration the program no longer has does not read back")
type_of_a_removed_declaration()
    val checked = checked_program(program_of("/p", Main, Geo, Extra))
    var r = entry_reader("D 12:geo\nNoSuchType 4:Gone 0 ")
    assert(read_type(&r, type_names(checked)) is None)
    var c = entry_reader("C 8:geo\nNope 4:Nope 0 ")
    assert(read_type(&c, type_names(checked)) is None)

// --- corpus programs and builds at once ------------------------------------------------------------

@test("a sample of the corpus builds warm to a clean build's text, reusing what it lowered cold")
corpus_sample_warm_equals_clean()
    val dir = make_temp_dir("avin-ic").unwrap()
    defer _ = remove_dir_all(dir)
    var names: Buf[string] = buf()
    for name in entries("tests/run").unwrap()
        if name.ends_with(".avin") && !name.starts_with(".") then names.push(name)
    val sorted = names.view_mut()
    sort(sorted)
    var checked = 0
    var i = 0usize
    while i < sorted.len
        val name = sorted[i]
        i += 47
        val files = single_file(source_of(name, read_text("tests/run/" + name).unwrap()))
        val compiled = compile_files(repository_toolchain(), files)
        if compiled.diagnostics != "" then continue
        val cache = dir + "/" + name
        val cold = cached(files, cache)
        val warm = cached(files, cache)
        assert_eq(cold.llvm, compiled.llvm.unwrap(), name)
        assert_eq(warm.llvm, compiled.llvm.unwrap(), name)
        assert_eq(lowered_of(warm).fresh.len(), 0, name)
        assert_eq(lowered_of(warm).reused.len(), lowered_of(cold).fresh.len(), name)
        assert_eq(warm.texts_reused, warm.program.functions.len(), name)
        checked += 1
    assert(checked * 2 >= sorted.len / 47, s"only $checked of the sample compiled")

/** `files` with a file of one function nobody calls put first, so every declaration after it, the C
 * bindings' included, is numbered one later by the checker. */
private declaration_first(files: Buf[ProgramFile], dir: string) -> Buf[ProgramFile]
    var out: Buf[ProgramFile] = buf()
    out.push(ProgramFile(source_of(dir + "/a0.avin", "firstOfAll() -> int = 1\n"), None, false, buf(), files[0].package))
    for f in files
        out.push(f)
    out

@test("a program of C bindings, edited so its bindings, fields and callbacks are numbered anew, builds warm to a clean build's text")
c_bindings_renumbered_build_warm_to_clean()
    val scratch = make_temp_dir("avin-ic-c").unwrap()
    defer _ = remove_dir_all(scratch)
    val tc = fixture_toolchain(repository_toolchain(), scratch)
    // Calls through the C unit's glue, a view field and a field of a mirror, two bindings' callbacks
    // each named `callback#1`, and a callback's finalizers.
    for name in ["c_buffer_collects", "c_view_field_closed_trap", "c_field_mirror_collects", "c_callback_body_trap", "c_callback_finalizers", "c_struct_blocking_collects"]
        val root = current_dir().unwrap() + "/tests/programs/run/" + name
        val fetching = default_fetching()
        val p = load_package(root, Fetching(fetching.cache, fetching.base, false)).unwrap()
        for edit in 0..<2
            val cache = scratch + "/" + name + edit.to_string()
            open_incremental(cache, IncrementalOn)
            val cold = compile_program(tc, p.files, false, p.sysl, p.c)
            assert_eq(cold.diagnostics, "", name)
            val files = if edit == 0 then warm_edit(p.files) else declaration_first(p.files, root)
            open_incremental(cache, IncrementalVerify)
            val warm = compile_program(tc, files, false, p.sysl, p.c)
            close_incremental()
            assert_eq(warm.diagnostics, "", s"$name, edit $edit")
            // And back: the cache now holds the edited program's entries too.
            open_incremental(cache, IncrementalVerify)
            val back = compile_program(tc, p.files, false, p.sysl, p.c)
            close_incremental()
            assert_eq(back.diagnostics, "", s"$name, edit $edit and back")
            assert_eq(back.llvm, cold.llvm, name)

@test("two builds of one program at once both succeed, and leave a cache a third build verifies")
two_builds_at_once()
    val dir = make_temp_dir("avin-ic-twice").unwrap()
    defer _ = remove_dir_all(dir)
    val bin = compiler_in(dir)
    val program = dir + "/prog"
    write_program(program)
    var env: Buf[Var] = buf()
    env.push(Var("AVIN_ROOT", current_dir().unwrap()))
    env.push(Var("AVIN_INCREMENTAL", "on"))
    for round in 0..<2
        val a = spawn(bin, ["build", program, "-O0", "-o", dir + "/a"], env = env.view(), stdout = Stdio.ToPath(dir + "/a.out"), stderr = Stdio.ToPath(dir + "/a.err")).unwrap()
        val b = spawn(bin, ["build", program, "-O0", "-o", dir + "/b"], env = env.view(), stdout = Stdio.ToPath(dir + "/b.out"), stderr = Stdio.ToPath(dir + "/b.err")).unwrap()
        val ea = a.wait().unwrap()
        val eb = b.wait().unwrap()
        assert(ea is Exited(0), s"round $round: " + read_text(dir + "/a.err").unwrap_or(""))
        assert(eb is Exited(0), s"round $round: " + read_text(dir + "/b.err").unwrap_or(""))
        val ra = capture(dir + "/a", [], timeout = 60000).unwrap()
        val rb = capture(dir + "/b", [], timeout = 60000).unwrap()
        assert_eq(ra.text, rb.text)
        assert(ra.text.starts_with("21\n"), ra.text)
    var verify: Buf[Var] = buf()
    verify.push(Var("AVIN_ROOT", current_dir().unwrap()))
    verify.push(Var("AVIN_INCREMENTAL", "verify"))
    val checked = spawn(bin, ["build", program, "-O0", "-o", dir + "/c"], env = verify.view(), stdout = Stdio.ToPath(dir + "/c.out"), stderr = Stdio.ToPath(dir + "/c.err")).unwrap()
    assert(checked.wait().unwrap() is Exited(0), read_text(dir + "/c.err").unwrap_or(""))
    val cache = instance_cache_dir(program + "/.avin/build", false, "-O0")
    for name in entries(cache).unwrap()
        assert(!name.contains(".pending-"), name)
    assert_eq(read_instance_store(cache).damaged, 0)

@test("a program built at -O0 and at -O2 with the cache runs the same, each level from its own entries")
both_levels()
    val dir = make_temp_dir("avin-ic").unwrap()
    defer _ = remove_dir_all(dir)
    val files = program_of(dir, Main, Geo, Extra)
    val tc = repository_toolchain()
    var outputs: Buf[string] = buf()
    for level in ["-O0", "-O2"]
        val cache = instance_cache_dir(dir + "/.avin/build", false, level)
        open_incremental(cache, IncrementalOn)
        for round in 0..<2
            val compiled = compile_program(tc, files, false, buf(), buf())
            assert_eq(compiled.diagnostics, "")
            val exe = dir + s"/run$level$round"
            link(tc, compiled.llvm.unwrap(), compiled.archive, exe, level, compiled.c_link).unwrap()
            outputs.push(capture(exe, [], timeout = 60000).unwrap().text)
        close_incremental()
        assert(read_instance_store(cache).texts.len() > 0)
    for o in outputs
        assert_eq(o, outputs[0])
    assert(outputs[0].contains("cat tom"))

// --- slots of methods with type parameters of their own ---------------------------------------------
//
// Such a method has a table slot for each list of its own type arguments, numbered in the order the
// program's calls make them. An entry names the slot of each of its calls by the method and type
// arguments, so an edit that makes the slots in another order, or makes one more or one fewer, leaves
// every reused call reaching the method it reached in a clean build.

private const Show: string = "show(rs: Vector[Vector[string]]) -> string = rs.map(r -> \"[\" + r.map(f -> s\"<$f>\").mkString(\"|\") + \"]\").mkString(\" \")\n"

private const Count: string = "count(xs: Vector[string]) -> int = xs.map(s -> s.toInt()).sum\n"

private const ShowMain: string = Show + "\nmain()\n    println(show([[\"x\", \"y\"]]))\n"

private const PlainGeo: string = "module geo\n\nnothing() -> int = 0\n"

private const PlainExtra: string = "module extra\n\nnone() -> int = 0\n"

private const Mappers: string = "module geo\n\ntrait Mapper\n    mapTo[B](f: (int) -> B) -> B\n\nclass Holder(val n: int): Mapper\n    override mapTo[B](f: (int) -> B) -> B = f(n)\n\nclass Other(val n: int): Mapper\n    override mapTo[B](f: (int) -> B) -> B = f(n + 1)\n"

private const Label: string = "import geo.{Mapper, Holder, Other}\n\nlabel(m: Mapper) -> string = m.mapTo(n -> s\"<$n>\")\n\nmain()\n"

/** Builds the program of `main0`, `geo0` and `extra0`, then the edited one of `main1`, `geo1` and
 * `extra1` with the same cache, at -O0 and at -O2, each level with a cache of its own. The edited
 * build reuses the entry of the function `kept` (unless it is empty), its text is a clean build's, and its program prints
 * `want`. */
private rebuild_prints(main0: string, geo0: string, extra0: string, main1: string, geo1: string, extra1: string, kept: string, want: string)
    val dir = make_temp_dir("avin-ic-slots").unwrap()
    defer _ = remove_dir_all(dir)
    val tc = repository_toolchain()
    val after = program_of(dir, main1, geo1, extra1)
    val oracle = clean(after)
    _ = cached(program_of(dir, main0, geo0, extra0), dir + "/cache")
    val second = cached(after, dir + "/cache")
    val reused = lowered_of(second).reused
    var named = ""
    for s in reused
        if s.starts_with("<program>") then named = named + s + " "
    if kept != "" then assert(holds(reused, kept), s"`$kept` was lowered again; reused: $named")
    assert_eq(second.llvm, oracle)
    for level in ["-O0", "-O2"]
        val cache = instance_cache_dir(dir + "/.avin/build", false, level)
        open_incremental(cache, IncrementalOn)
        val first = compile_program(tc, program_of(dir, main0, geo0, extra0), false, buf(), buf())
        assert_eq(first.diagnostics, "")
        val compiled = compile_program(tc, after, false, buf(), buf())
        close_incremental()
        assert_eq(compiled.diagnostics, "")
        val llvm = compiled.llvm.unwrap()
        assert_eq(llvm, oracle)
        val exe = dir + s"/run$level"
        link(tc, llvm, compiled.archive, exe, level, compiled.c_link).unwrap()
        assert_eq(capture(exe, [], timeout = 60000).unwrap().text, want)

@test("a reused lambda's call of a library method with its own type parameter reaches its own slot after an edit makes another slot first")
reused_generic_slot_after_new_slot()
    rebuild_prints(ShowMain, PlainGeo, PlainExtra, ShowMain + "    println([\"1\"].map(p -> p.toInt()).sum)\n", PlainGeo, PlainExtra, "<program>.show.lambda#1", "[<x>|<y>]\n1\n")

@test("a reused call of a program's own method with a type parameter reaches its own slot after a new instance of the method")
reused_own_generic_slot_after_new_instance()
    val before = Label + "    println(label(Holder(1)))\n    println(label(Other(1)))\n"
    val after = Label + "    val m: Mapper = Holder(5)\n    println(m.mapTo(n -> n * 2))\n    println(label(Holder(1)))\n    println(label(Other(1)))\n"
    rebuild_prints(before, Mappers, PlainExtra, after, Mappers, PlainExtra, "<program>.label", "10\n<1>\n<2>\n")

@test("a method added to a trait ahead of one with its own type parameter moves its slot, and a call kept in the program reaches it")
generic_method_moved_in_its_trait()
    val main = Label + "    val m: Mapper = Holder(5)\n    println(m.mapTo(n -> n * 2))\n    println(label(Holder(1)))\n    println(label(Other(1)))\n"
    val moved = Mappers.replace_all("trait Mapper\n", "trait Mapper\n    first() -> int = 0\n")
    rebuild_prints(main, Mappers, PlainExtra, main, moved, PlainExtra, "", "10\n<1>\n<2>\n")

@test("a new lambda calling a generic method ahead of a reused one leaves the reused one's slot its own")
reused_generic_slot_after_new_lambda()
    val after = Show + "\nmain()\n    println([3, 4].map(n -> n + 1).mkString(\",\"))\n    println(show([[\"x\", \"y\"]]))\n"
    rebuild_prints(ShowMain, PlainGeo, PlainExtra, after, PlainGeo, PlainExtra, "<program>.show.lambda#1", "4,5\n[<x>|<y>]\n")

@test("a new string literal ahead of a reused function leaves its strings and slots its own")
reused_generic_slot_after_new_string()
    val after = Show + "\nmain()\n    println(\"fresh\")\n    println(show([[\"x\", \"y\"], [\"fresh\"]]))\n"
    rebuild_prints(ShowMain, PlainGeo, PlainExtra, after, PlainGeo, PlainExtra, "<program>.show.lambda#1", "fresh\n[<x>|<y>] [<fresh>]\n")

@test("a function removed with the slot it made leaves a reused call reaching its own slot, now numbered lower")
reused_generic_slot_after_removed_function()
    val before = Count + "\n" + Show + "\nmain()\n    println(count([\"2\"]))\n    println(show([[\"x\", \"y\"]]))\n"
    rebuild_prints(before, PlainGeo, PlainExtra, ShowMain, PlainGeo, PlainExtra, "<program>.show.lambda#1", "[<x>|<y>]\n")

@test("a signature changed in another module, whose new body makes a slot first, leaves a reused call's slot its own")
reused_generic_slot_after_signature_change()
    val main = "import extra.tag\n\n" + Show + "\nmain()\n    println(tag(7))\n    println(show([[\"x\", \"y\"]]))\n"
    rebuild_prints(main, PlainGeo, "module extra\n\ntag(n: int) -> int = n\n", main, PlainGeo, "module extra\n\ntag(n: int) -> long = [n].map(x -> long(x) * 2).sum\n", "<program>.show.lambda#1", "14\n[<x>|<y>]\n")

@test("a new instance in another module, made first, leaves a reused call's slot its own")
reused_generic_slot_after_instance_in_another_module()
    val main = "import extra.twice\n\n" + Show + "\nmain()\n    println(twice(3))\n    println(show([[\"x\", \"y\"]]))\n"
    rebuild_prints(main, PlainGeo, "module extra\n\ntwice(n: int) -> int = n * 2\n", main, PlainGeo, "module extra\n\ntwice(n: int) -> int = [n, n].map(x -> x).sum\n", "<program>.show.lambda#1", "6\n[<x>|<y>]\n")

@test("two reused functions whose calls make their slots in the other order each reach their own")
reused_generic_slots_in_the_other_order()
    val before = Count + "\n" + Show + "\nmain()\n    println(show([[\"x\", \"y\"]]))\n    println(count([\"2\"]))\n"
    val after = Count + "\n" + Show + "\nmain()\n    println(count([\"2\"]))\n    println(show([[\"x\", \"y\"]]))\n"
    rebuild_prints(before, PlainGeo, PlainExtra, after, PlainGeo, PlainExtra, "<program>.count", "2\n[<x>|<y>]\n")

// --- the commands -----------------------------------------------------------------------------------

/** The compiler of this tree, built into `dir`, for the tests that start it as a person would. */
private compiler_in(dir: string) -> string
    val bin = dir + "/avin"
    val built = capture(repository_toolchain().sysl, ["build", "compiler", "-o", bin], stderr = true, timeout = 900000).unwrap()
    assert(built.status.ok(), built.err.unwrap_or(""))
    bin

/** The program of three modules at `dir`, with a file of one test beside its main module. */
private write_program(dir: string)
    make_dir_all(dir + "/geo").unwrap()
    make_dir_all(dir + "/extra").unwrap()
    write_text(dir + "/geo/geo.avin", Geo).unwrap()
    write_text(dir + "/extra/extra.avin", Extra).unwrap()
    write_text(dir + "/main.avin", Main).unwrap()
    write_text(dir + "/checks.avin", "import extra.helper\n\n@test\nhelps()\n    assert(helper(1) > 100)\n").unwrap()

/** What a command printed, its exit status, and the build log it wrote, empty if it wrote none. */
private struct Ran
    status: int
    text: string
    log: Buf[string]

/** `avin <args>` with `AVIN_INCREMENTAL` set to `mode` ("" is the default) and its build log in `dir`. */
private avin_in(bin: string, dir: string, mode: string, args: []const string) -> Ran
    val log = dir + "/build.log"
    _ = remove_file(log)
    var env: Buf[Var] = buf()
    env.push(Var("AVIN_ROOT", current_dir().unwrap()))
    env.push(Var("AVIN_INCREMENTAL", mode))
    env.push(Var("AVIN_BUILD_LOG", log))
    val out = capture(bin, args, env = env.view(), stderr = true, timeout = 600000).unwrap()
    val code = out.status match
        Exited(c) -> c
        _ -> -1
    Ran(code, out.text + out.err.unwrap_or(""), if exists(log) then logged_phases(log) else buf())

/** What the executable at `exe` prints. */
private output_of(exe: string) -> string = capture(exe, [], timeout = 60000).unwrap().text

/** The module files of every directory of the instance cache under `caches`, by directory. */
private names_in(dir: string) -> Map[string, bool]
    var out: Map[string, bool] = map()
    for f in module_files(dir)
        out.put(f[dir.bytes.len..], true)
    out

@test("build, run and test keep the instance cache by default, each kind and level apart, and rebuild an edit to a clean build's program")
commands_use_the_cache_by_default()
    val dir = make_temp_dir("avin-ic-commands").unwrap()
    defer _ = remove_dir_all(dir)
    val bin = compiler_in(dir)
    val prog = dir + "/prog"
    write_program(prog)
    val caches = prog + "/.avin/build/incremental"
    // Cold: each command writes its own kind's and level's directory and reuses nothing.
    val run1 = avin_in(bin, dir, "", ["run", prog])
    assert_eq(run1.status, 0, run1.text)
    assert(run1.text.contains("\n101\n"), run1.text)
    assert_eq(count_in(run1.log, "lower", "reused"), 0)
    assert(count_in(run1.log, "store", "written") >= 3)
    val test1 = avin_in(bin, dir, "", ["test", prog])
    assert_eq(test1.status, 0, test1.text)
    assert(test1.text.contains("1 passed, 0 failed"), test1.text)
    assert_eq(count_in(test1.log, "lower", "reused"), 0)
    val build1 = avin_in(bin, dir, "", ["build", prog, "-O0", "-o", dir + "/built"])
    assert_eq(build1.status, 0, build1.text)
    assert_eq(count_in(build1.log, "lower", "reused"), 0)
    val program = names_in(caches + "/program-O2")
    val tests = names_in(caches + "/tests-O2")
    assert(program.len() >= 3)
    assert(tests.len() >= 3)
    assert(names_in(caches + "/program-O0").len() >= 3)
    for (name, _) in tests
        assert(program.get(name) is None, "the tests' build and the program's share " + name)
    // The edit; each command then reuses what it left alone and makes a clean build's program.
    write_text(prog + "/extra/extra.avin", edited(Extra, "n + 100", "n + 200")).unwrap()
    val clean = avin_in(bin, dir, "off", ["build", prog, "-o", dir + "/clean"])
    assert_eq(clean.status, 0, clean.text)
    val want = output_of(dir + "/clean")
    assert(want.contains("\n201\n"), want)
    val run2 = avin_in(bin, dir, "", ["run", prog])
    assert_eq(run2.status, 0, run2.text)
    assert_eq(run2.text, want)
    assert(count_in(run2.log, "lower", "reused") > 0)
    assert(count_in(run2.log, "emit", "reused") > 0)
    val test2 = avin_in(bin, dir, "", ["test", prog])
    assert_eq(test2.status, 0, test2.text)
    assert(test2.text.contains("1 passed, 0 failed"), test2.text)
    assert(count_in(test2.log, "lower", "reused") > 0)
    val build2 = avin_in(bin, dir, "", ["build", prog, "-O0", "-o", dir + "/built"])
    assert_eq(build2.status, 0, build2.text)
    assert(count_in(build2.log, "lower", "reused") > 0)
    assert_eq(output_of(dir + "/built"), want)
    // The text, against a clean build's.
    val warm_ll = avin_in(bin, dir, "", ["emit-llvm", prog, "-o", dir + "/warm.ll"])
    assert_eq(warm_ll.status, 0, warm_ll.text)
    assert_eq(count_in(warm_ll.log, "emit", "reused"), count_in(warm_ll.log, "lower", "functions"))
    assert_eq(avin_in(bin, dir, "off", ["emit-llvm", prog, "-o", dir + "/clean.ll"]).status, 0)
    assert_eq(read_text(dir + "/warm.ll").unwrap(), read_text(dir + "/clean.ll").unwrap())
    // `verify` for each command: the executables are made again, so each builds twice and compares.
    remove_file(prog + "/.avin/build/prog-O2.key").unwrap()
    remove_file(prog + "/.avin/build/prog-tests-O2.key").unwrap()
    val run3 = avin_in(bin, dir, "verify", ["run", prog])
    assert_eq(run3.status, 0, run3.text)
    assert_eq(run3.text, want)
    val test3 = avin_in(bin, dir, "verify", ["test", prog])
    assert_eq(test3.status, 0, test3.text)
    assert(test3.text.contains("1 passed, 0 failed"), test3.text)
    assert_eq(avin_in(bin, dir, "verify", ["build", prog, "-O0", "-o", dir + "/built"]).status, 0)
    // A run that finds its executable built compiles nothing and reads no cache.
    val again = avin_in(bin, dir, "", ["run", prog])
    assert_eq(again.text, want)
    assert_eq(phase_names(again.log), "cached ")

@test("off keeps no cache and reads none; a damaged cache, another compiler's and a stale one are survived")
off_and_damage()
    val dir = make_temp_dir("avin-ic-off").unwrap()
    defer _ = remove_dir_all(dir)
    val bin = compiler_in(dir)
    val prog = dir + "/prog"
    write_program(prog)
    val cache = prog + "/.avin/build/incremental/program-O2"
    val off = avin_in(bin, dir, "off", ["run", prog])
    assert_eq(off.status, 0, off.text)
    val want = off.text
    assert(want.contains("\n101\n"), want)
    assert_eq(phase_names(off.log), "load check cunit lower keys shims emit split units link ")
    assert(!exists(prog + "/.avin/build/incremental"))
    assert_eq(avin_in(bin, dir, "off", ["test", prog]).status, 0)
    assert_eq(avin_in(bin, dir, "off", ["build", prog, "-o", dir + "/x"]).status, 0)
    assert(!exists(prog + "/.avin/build/incremental"))
    // Made by the default, then damaged: `off` never reads it, and the default passes over it.
    assert_eq(avin_in(bin, dir, "", ["build", prog, "-o", dir + "/x"]).status, 0)
    val files = module_files(cache)
    assert(files.len() >= 3)
    for f in files
        write_text(f, "avin instances 1\nnot what the header says\n").unwrap()
    val ignored = avin_in(bin, dir, "off", ["build", prog, "-o", dir + "/x"])
    assert_eq(phase_names(ignored.log), "load check cunit lower keys shims emit split units link ")
    for f in files
        assert_eq(read_text(f).unwrap(), "avin instances 1\nnot what the header says\n")
    val damaged = avin_in(bin, dir, "", ["build", prog, "-o", dir + "/x"])
    assert_eq(damaged.status, 0, damaged.text)
    assert_eq(count_in(damaged.log, "cache", "damaged"), int(files.len()))
    assert_eq(count_in(damaged.log, "lower", "reused"), 0)
    assert_eq(output_of(dir + "/x"), want)
    // A manifest of nonsense, naming files that are not there and one outside the directory.
    write_text(cache + "/manifest", "\u{1}\u{2}nonsense\nmissing.mod\n../../main.avin\n\n").unwrap()
    val nonsense = avin_in(bin, dir, "", ["build", prog, "-o", dir + "/x"])
    assert_eq(nonsense.status, 0, nonsense.text)
    assert_eq(output_of(dir + "/x"), want)
    assert_eq(read_text(prog + "/main.avin").unwrap(), Main)
    assert_eq(avin_in(bin, dir, "verify", ["build", prog, "-o", dir + "/x"]).status, 0)
    // Another compiler: the same executable at another time makes keys of its own and reuses nothing.
    val warm = avin_in(bin, dir, "", ["build", prog, "-o", dir + "/x"])
    assert(count_in(warm.log, "lower", "reused") > 0)
    val before = names_in(cache)
    set_modified(bin, now() - micros(7200000000)).unwrap()
    val other = avin_in(bin, dir, "", ["build", prog, "-o", dir + "/x"])
    assert_eq(other.status, 0, other.text)
    assert_eq(count_in(other.log, "lower", "reused"), 0)
    assert_eq(count_in(other.log, "emit", "reused"), 0)
    assert_eq(count_in(other.log, "store", "trimmed"), 0)
    assert_eq(output_of(dir + "/x"), want)
    // The older compiler's files, used within the hour, are kept; once an hour old they are trimmed.
    for (name, _) in before
        assert(exists(cache + name), name)
    val old = now() - micros(InstanceCacheFresh + 60000000)
    for f in module_files(cache)
        set_modified(f, old).unwrap()
    val trimmed = avin_in(bin, dir, "", ["build", prog, "-o", dir + "/x"])
    assert_eq(trimmed.status, 0, trimmed.text)
    assert_eq(count_in(trimmed.log, "store", "trimmed"), int(before.len()))
    assert(count_in(trimmed.log, "lower", "reused") > 0)
    for (name, _) in before
        assert(!exists(cache + name), name)
    assert_eq(output_of(dir + "/x"), want)
    assert_eq(avin_in(bin, dir, "verify", ["build", prog, "-o", dir + "/x"]).status, 0)

@test("two avin test runs of one program at once both pass, cold and warm, and so do a run and a test at once")
two_tests_at_once()
    val dir = make_temp_dir("avin-ic-tests").unwrap()
    defer _ = remove_dir_all(dir)
    val bin = compiler_in(dir)
    val prog = dir + "/prog"
    write_program(prog)
    var env: Buf[Var] = buf()
    env.push(Var("AVIN_ROOT", current_dir().unwrap()))
    env.push(Var("AVIN_INCREMENTAL", ""))
    for round in 0..<2
        if round == 1 then write_text(prog + "/extra/extra.avin", edited(Extra, "n + 100", "n + 200")).unwrap()
        val a = spawn(bin, ["test", prog], env = env.view(), stdout = Stdio.ToPath(dir + "/a.out"), stderr = Stdio.ToPath(dir + "/a.err")).unwrap()
        val b = spawn(bin, ["test", prog], env = env.view(), stdout = Stdio.ToPath(dir + "/b.out"), stderr = Stdio.ToPath(dir + "/b.err")).unwrap()
        val ea = a.wait().unwrap()
        val eb = b.wait().unwrap()
        assert(ea is Exited(0), s"round $round: " + read_text(dir + "/a.err").unwrap_or("") + read_text(dir + "/a.out").unwrap_or(""))
        assert(eb is Exited(0), s"round $round: " + read_text(dir + "/b.err").unwrap_or("") + read_text(dir + "/b.out").unwrap_or(""))
        assert(read_text(dir + "/a.out").unwrap().contains("1 passed, 0 failed"))
        assert(read_text(dir + "/b.out").unwrap().contains("1 passed, 0 failed"))
    // A run and a test at once, after another edit: two kinds, two directories, both right.
    write_text(prog + "/extra/extra.avin", edited(Extra, "n + 100", "n + 300")).unwrap()
    val r = spawn(bin, ["run", prog], env = env.view(), stdout = Stdio.ToPath(dir + "/r.out"), stderr = Stdio.ToPath(dir + "/r.err")).unwrap()
    val t = spawn(bin, ["test", prog], env = env.view(), stdout = Stdio.ToPath(dir + "/t.out"), stderr = Stdio.ToPath(dir + "/t.err")).unwrap()
    assert(r.wait().unwrap() is Exited(0), read_text(dir + "/r.err").unwrap_or(""))
    assert(t.wait().unwrap() is Exited(0), read_text(dir + "/t.err").unwrap_or(""))
    assert(read_text(dir + "/r.out").unwrap().contains("\n301\n"))
    assert(read_text(dir + "/t.out").unwrap().contains("1 passed, 0 failed"))
    // What they left verifies, with no write half done and no file damaged.
    for kind in ["program-O2", "tests-O2"]
        val cache = prog + "/.avin/build/incremental/" + kind
        for name in entries(cache).unwrap()
            assert(!name.contains(".pending-"), name)
        assert_eq(read_instance_store(cache).damaged, 0)
    remove_file(prog + "/.avin/build/prog-tests-O2.key").unwrap()
    remove_file(prog + "/.avin/build/prog-O2.key").unwrap()
    val verified = avin_in(bin, dir, "verify", ["test", prog])
    assert_eq(verified.status, 0, verified.text)
    assert(count_in(verified.log, "lower", "reused") > 0)
    val ran = avin_in(bin, dir, "verify", ["run", prog])
    assert_eq(ran.status, 0, ran.text)
    assert(ran.text.contains("\n301\n"), ran.text)
