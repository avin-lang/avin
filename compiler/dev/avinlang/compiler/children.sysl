module dev.avinlang.compiler

import sysl.fs.IoError
import sysl.buf.{Buf, buf}
import sysl.process.{Group, Output, Status, Stdio, Var, foreground_group, pid, process_group, spawn, start}
import sysl.signal
import sysl.sync.SpinLock
import sysl.time.{millis, monotonic, sleep}

// The programs the runners start -- a test of `avin test`, a program of the execution corpus -- and
// how none of them outlives its runner. Each is started as the leader of a process group of its own,
// so whatever it starts in turn (a server's workers, a child it spawns) is in that group too and is
// reached by one signal to the group. Once the leader has been waited for, whatever is left of its
// group is stopped; and a runner asked to stop by `SIGINT`, `SIGTERM` or `SIGHUP` kills every group
// still running before it exits.

/** How long, in milliseconds, what is left of a group after its leader ended has to stop once asked
 * with `SIGTERM`, before `SIGKILL` makes it. */
const GroupGrace: int = 200

/** How many groups can be recorded as running at once. */
const GroupSlots: int = 64

private var group_guard: SpinLock = SpinLock(0)
private var running_groups: [64]int

/** Records process group `pgid` as running, so that `kill_running_groups` reaches it. Answers the slot
 * to forget it with, or -1 when `pgid` names no group or every slot is taken. */
track_group(pgid: int) -> int
    if pgid <= 0 then return -1
    group_guard.lock()
    var slot = -1
    for i in 0..<GroupSlots
        if running_groups[i] == 0
            running_groups[i] = pgid
            slot = i
            break
    group_guard.unlock()
    slot

/** Forgets the group recorded in `slot`; -1 is no slot, and does nothing. */
untrack_group(slot: int)
    if slot < 0 || slot >= GroupSlots then return
    group_guard.lock()
    running_groups[slot] = 0
    group_guard.unlock()

/** How many groups are recorded as running. */
running_group_count() -> int
    group_guard.lock()
    var n = 0
    for i in 0..<GroupSlots
        if running_groups[i] != 0 then n += 1
    group_guard.unlock()
    n

/** Sends `SIGKILL` to every group recorded as running and forgets them: what a runner does on its way
 * out, when there is no time left for a grace. */
kill_running_groups()
    group_guard.lock()
    for i in 0..<GroupSlots
        if running_groups[i] > 0
            _ = signal.send(-i64(running_groups[i]), signal.KILL)
            running_groups[i] = 0
    group_guard.unlock()

/** Whether process group `pgid` still has a process in it. */
group_alive(pgid: int) -> bool = pgid > 0 && signal.send(-i64(pgid), 0) is Ok(_)

/** Stops whatever is left of process group `pgid`: `SIGTERM` to the group, up to `GroupGrace`
 * milliseconds for it to empty, then `SIGKILL`. Answers whether anything was left to stop. Called once
 * the group's leader has been waited for, so that a process it started and left behind ends too. */
stop_group(pgid: int) -> bool
    if !group_alive(pgid) then return false
    _ = signal.send(-i64(pgid), signal.TERM)
    var waited = 0
    while waited < GroupGrace && group_alive(pgid)
        sleep(millis(5))
        waited += 5
    if group_alive(pgid) then _ = signal.send(-i64(pgid), signal.KILL)
    true

/** Runs `program` with `args` and `env`, reading `stdin`, as the leader of a process group of its own,
 * and captures its standard output and error as `capture` does. A program still running after
 * `timeout` milliseconds (0 for no limit) is stopped and `TimedOut`; once it has ended, anything it
 * started that is still running is stopped with `stop_group`. While it runs its group is recorded, so
 * a runner that is interrupted kills it. */
run_contained(program: string, args: []const string, env: []const Var, stdin: Stdio, timeout: int) -> Result[Output, IoError]
    val watched = runner_env(env)
    var child = start(program, args, env = watched.view(), stderr = true, timeout = timeout, stdin = stdin, group = Group.New)?
    val pgid = child.group()
    val slot = track_group(pgid)
    val waited = child.wait()
    _ = stop_group(pgid)
    untrack_group(slot)
    waited

/** The variable a runner names itself in, by process id, for the programs it starts. An Avin program
 * started with it, by the process it names, watches that process and ends -- with everything in its
 * process group, when it leads one -- as soon as it is gone, even killed by `SIGKILL`, which the runner
 * cannot answer. The program takes the variable out of its environment as it starts, so what it starts
 * in turn does not watch a process that is not its parent; and one started with it by any other
 * process does not watch at all. */
const RunnerVariable: string = "AVIN_RUNNER_PID"

/** `env` with `RunnerVariable` naming this process added. */
runner_env(env: []const Var) -> Buf[Var]
    var out: Buf[Var] = buf()
    for v in env do out.push(v)
    out.push(Var(RunnerVariable, pid().to_string()))
    out

/** How long, in milliseconds, a program `avin run` is running has to end once the signal that stopped
 * `avin run` has been passed on to it, before it is killed. */
const RunGrace: int = 2000

/** Runs `program` with `args` for `avin run`, its output going where `stdout` and `stderr` say, and
 * answers how it ended. Started from a terminal, as the terminal's foreground job, it stays in that job,
 * so the terminal's keys and the shell's job control reach it as they reach `avin run`; started any
 * other way it leads a process group of its own. Either way it watches this process
 * (`RunnerVariable`). `SIGTERM` or `SIGHUP` sent to `avin run` is passed on to it -- to its whole
 * group, when it leads one -- and so is `SIGINT` away from the terminal (at it, Ctrl-C reaches the
 * program already, and `avin run` waits for it); a program still running `RunGrace` milliseconds after
 * the first is killed. Once it has ended, whatever is left of a group it led is stopped with
 * `stop_group`. */
run_attended(program: string, args: []const string, stdout: Stdio, stderr: Stdio) -> Result[Status, IoError]
    val own_group = !at_the_terminal()
    val term = signal.watch(signal.TERM)
    val interrupt = signal.watch(signal.INT)
    val hangup = signal.watch(signal.HUP)
    if term is Err(e) then return Err(e)
    if interrupt is Err(e) then return Err(e)
    if hangup is Err(e) then return Err(e)
    var t = term.unwrap()
    var i = interrupt.unwrap()
    var h = hangup.unwrap()
    val env = runner_env([])
    var child = spawn(program, args, env = env.view(), stdout = stdout, stderr = stderr, group = if own_group then Group.New else Group.Inherit)?
    val target = if own_group then -i64(child.group()) else i64(child.pid())
    var asked_at = monotonic().us / 1000
    var asked = false
    loop
        child.try_wait() match
            Ok(Some(status)) ->
                if own_group then _ = stop_group(child.group())
                return Ok(status)
            Ok(None) -> ()
            Err(e) -> return Err(e)
        val now = monotonic().us / 1000
        var sig = 0
        if t.take() then sig = signal.TERM
        // At the terminal, Ctrl-C reaches the program from the terminal itself, and the program decides
        // what it means.
        if i.take() && own_group then sig = signal.INT
        if h.take() then sig = signal.HUP
        if sig != 0
            _ = signal.send(target, sig)
            if !asked
                asked = true
                asked_at = now
        if asked && now - asked_at >= RunGrace then _ = signal.send(target, signal.KILL)
        sleep(millis(5))
end run_attended

// Whether this program is the foreground job of the terminal it belongs to.
private at_the_terminal() -> bool = foreground_group() match
    Ok(g) -> g == process_group()
    Err(_) -> false
