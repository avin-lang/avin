module dev.avinlang.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}

// What a program carries of the methods a data type has without asking. A method reached only
// through method tables is compiled only once a call goes through its position, so every data type's
// `Display` and `Debug` cost nothing in a program that never shows a value.

/** The compiled functions of `text` whose symbols name `method`, one per line. */
private compiled(text: string, method: string) -> string
    val program = lower_source(repository_toolchain(), source_of("probe.avin", text)) match
        Ok(p) -> p
        Err(d) -> panic(d)
    var names: Buf[string] = buf()
    for f in program.functions
        if f.symbol.contains("." + method) then names.push(f.symbol)
    var out = ""
    for n in names
        out = out + n + "\n"
    out

private const Shapes: string = "data Point(x: int, y: int)\n\ndata Shape\n    Circle(radius: int)\n    Square(side: int)\n\nclass Plain\n\ndata Wrapper(plain: Plain)\n\n"

@test("a program that never shows a data value compiles none of its Display or Debug")
unshown_data_costs_nothing()
    val text = Shapes + "main() -> int\n    val p = Point(1, 2)\n    val s: Shape = Circle(3)\n    val o: Option[int] = Some(4)\n    val w = Wrapper(Plain())\n    val n = s match\n        Circle(r) -> r\n        Square(x) -> x\n    p.x + n + o.getOrElse(0)\n"
    assert_eq(compiled(text, "display"), "")
    assert_eq(compiled(text, "debug"), "")
    assert_eq(compiled(text, "toString"), "")

@test("showing one data type compiles its Display and no other type's")
shown_data_compiles_its_own()
    val text = Shapes + "main()\n    val s: Shape = Circle(3)\n    val p = Point(1, 2)\n    println(p)\n    s match\n        Circle(r) -> println(r)\n        Square(x) -> println(x)\n"
    val shown = compiled(text, "display")
    assert(shown.contains("<program>.Point.display\n"), shown)
    assert(!shown.contains("Shape") && !shown.contains("Wrapper"), shown)
    assert_eq(compiled(text, "debug"), "")

@test("a call through `Display` as a type fills its position for the types the program makes, except one a field leaves without it")
shown_through_trait()
    val text = Shapes + "show(d: Display) -> string = d.toString()\n\nmain()\n    println(show(Point(1, 2)))\n    val w = Wrapper(Plain())\n    println(w == w)\n"
    val shown = compiled(text, "display")
    assert(shown.contains("<program>.Point.display\n"), shown)
    assert(!shown.contains("<program>.Wrapper") && !shown.contains("<program>.Shape"), shown)
    assert_eq(compiled(text, "debug"), "")

@test("showing a value of Any gives every type record a display entry, the type's own or its name, and no debug entry")
shown_through_any()
    val text = Shapes + "main()\n    val a: Any = Point(1, 2)\n    println(a)\n    val w = Wrapper(Plain())\n    println(w == w)\n"
    val shown = compiled(text, "display")
    assert(shown.contains("avin.any.display\n"), shown)
    assert(shown.contains("avin.record.display.Point"), shown)
    assert(shown.contains("<program>.Point.display\n"), shown)
    assert(!shown.contains("<program>.Wrapper.display"), shown)
    assert_eq(compiled(text, "debug"), "")

@test("a trait that requires Display is shown through its method table, with no record entries")
shown_through_requiring_trait()
    val text = Shapes + "trait Named: Display\n\nimpl Named for Point\n\nmain()\n    val n: Named = Point(1, 2)\n    println(n)\n"
    val shown = compiled(text, "display")
    assert(shown.contains("<program>.Point.display\n"), shown)
    assert(!shown.contains("avin.record.display"), shown)
