module dev.avinlang.compiler
@tests

import sh.sysl.parsing.source_of

// Calls through a bound, as lowering makes them. Each instance of a bounded generic knows its type
// argument, so a call on a value of a bounded parameter reaches that type's method directly; only
// where the type argument is itself a trait or an open class does the call go through a method
// table.

/** How many method table loads the instances of `name` in `text` make, one count per instance, in
 * the order the instances were made. */
private table_loads(text: string, name: string) -> string
    val program = lower_source(repository_toolchain(), source_of("probe.avin", text)) match
        Ok(p) -> p
        Err(d) -> panic(d)
    var out = ""
    for f in program.functions
        if !f.symbol.starts_with("<program>." + name + "[") then continue
        var loads = 0
        for b in f.blocks
            for inst in b.insts
                if inst is MethodSlot(_, _, _) then loads = loads + 1
        out = out + s"$loads "
    out

/** How many calls of the program's functions the instances of `name` in `text` make, one count per
 * instance, in the order the instances were made. */
private direct_calls(text: string, name: string) -> string
    val program = lower_source(repository_toolchain(), source_of("probe.avin", text)) match
        Ok(p) -> p
        Err(d) -> panic(d)
    var out = ""
    for f in program.functions
        if !f.symbol.starts_with("<program>." + name + "[") then continue
        var calls = 0
        for b in f.blocks
            for inst in b.insts
                if inst is Call(_, Direct(_), _) then calls = calls + 1
        out = out + s"$calls "
    out

@test("an operator through a bound is the machine's operation in an instance at a built-in type")
operators_on_builtins_are_direct()
    val text = "data Vector2(x: int, y: int)\n\nimpl Add for Vector2\n    add(other: Vector2) -> Vector2 = Vector2(x + other.x, y + other.y)\n\ntotal[T: Add](a: T, b: T) -> T = a + b\n\nmain()\n    total(1, 2)\n    total(Vector2(1, 2), Vector2(3, 4))\n    total(1.5, 2.5)\n"
    assert_eq(direct_calls(text, "total"), "0 1 0 ")

@test("a comparison and `==` through a bound are machine comparisons at a built-in type")
comparisons_on_builtins_are_direct()
    val text = "data Size(n: int)\n\nimpl Ord for Size\n    compare(other: Size) -> int = n - other.n\n\nbigger[T: Ord](a: T, b: T) -> bool = a > b && a != b\n\nmain()\n    bigger(1, 2)\n    bigger('a', 'b')\n    bigger(Size(1), Size(2))\n"
    assert_eq(direct_calls(text, "bigger"), "0 0 2 ")

@test("an operator on a parameter bounded by `Integer` is the machine's operation at every width")
operators_on_integer_params_are_direct()
    val text = "scale[T: Integer](a: T, b: T) -> T = a * b + a / b - a % b - -a\n\nfits[T: Integer](a: T, b: T) -> bool = a < b && a != b && T(long(a)) == a\n\nmain()\n    scale(i5(3), i5(2))\n    scale(1, 2)\n    scale(i128(3), i128(2))\n    fits(i5(3), i5(2))\n    fits(i257(3), i257(2))\n"
    assert_eq(direct_calls(text, "scale"), "0 0 0 ")
    assert_eq(direct_calls(text, "fits"), "0 0 ")

@test("a call through a bound reaches the integer family's method directly at every width")
family_calls_are_direct()
    val text = "shown[T: Display](x: T) -> string = x.toString()\n\nmain()\n    shown(i5(3))\n    shown(7)\n    shown(i128(3))\n"
    assert_eq(table_loads(text, "shown"), "0 0 0 ")
    assert_eq(direct_calls(text, "shown"), "1 1 1 ")

const OrderedText: string = "trait Ordered\n    less(other: Self) -> bool\n    greater(other: Self) -> bool = other.less(self)\n\nmax[T: Ordered](a: T, b: T) -> T = if a.greater(b) then a else b\n\n"

@test("a call through a bound is direct in an instance for a class, a data type and an impl")
bound_calls_are_direct()
    val text = OrderedText + "class Money(val cents: int): Ordered\n    override less(other: Money) -> bool = cents < other.cents\n\ndata Size(n: int)\n\nimpl Ordered for Size\n    less(other: Size) -> bool = n < other.n\n\nmain()\n    max(Money(1), Money(2))\n    max(Size(1), Size(2))\n"
    assert_eq(table_loads(text, "max"), "0 0 ")

@test("a call through a bound dispatches in an instance for a trait type or an open class")
bound_calls_dispatch_on_open_types()
    val text = "trait Named\n    name() -> string\n\nopen class Animal: Named\n    override name() -> string = \"animal\"\n\nclass Cat: Animal\n    override name() -> string = \"cat\"\n\ntitle[T: Named](x: T) -> string = x.name()\n\nmain()\n    title(Cat())\n    title[Animal](Cat())\n    val n: Named = Cat()\n    title(n)\n"
    assert_eq(table_loads(text, "title"), "0 1 1 ")
