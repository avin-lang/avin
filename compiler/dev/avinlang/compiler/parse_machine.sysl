module dev.avinlang.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// A machine declaration, `machine Door(params) receives DoorEvent` and a body of fields, methods,
// statements, `state` blocks and a shared `receive` block. It is read into the two declarations it
// means: a `data` type `Door.State`, with a variant for each state holding that state's
// parameters, and a final class `Door` holding the machine's own fields and parameters, the current
// state, and the methods `state()` and `handle(event)`.
//
// `handle` matches the current state, and in it the event, against the state's own arms followed by
// the shared ones, so each state's arms are one `match` the checker checks for coverage as any
// other, naming the state when it falls short. What the arm yields is the next state; `stay`, as an
// arm's value, marks the event as handled without a transition and yields the current state. On a
// transition the current state's `leave` runs, then the new state is current and its `enter` runs.
// A machine handling an event marks itself busy until it is done, so a `handle` from inside its own
// arms, `enter` or `leave` traps.

/** The two declarations a machine is read into, and its states' places for the coverage check. */
struct Machine
    states: &DataDecl
    decl: &ClassDecl
    sites: Buf[MachineSite]

/** A `state` block of a machine or an actor: its name and parameters, its `enter` and `leave`
 * blocks and its own arms. */
struct StateBlock
    span: Span
    name: string
    params: Buf[Param]
    enter: Option[&Expr]
    leave: Option[&Expr]
    arms: Buf[Arm]

/** Whether a machine declaration starts here: `machine` before the name it declares. Elsewhere
 * `machine` is an ordinary name. */
machine_ahead(p: *Parser) -> bool
    if !p.at("machine") then return false
    val next = p.toks.peek_at(1) match
        Some(t) -> t
        None -> return false
    next.value == Word && p.ahead(1) != "("

// The hidden members a machine's class holds; no name a program writes has a `$`.
const MachineCurrent: string = "machine$state"
const MachineBusy: string = "machine$busy"
const MachineStayed: string = "machine$stayed"
const MachineEvent: string = "machine$event"
const MachineNext: string = "machine$next"
const MachineArm: string = "machine$arm"

parse_machine(p: *Parser, start: Span, annotations: Buf[Annotation]) -> Machine
    p.expect("machine")
    val name_start = p.toks.here()
    val name = declared_name(p, "a type")
    val name_span = name_start.to(p.ended())
    val type_params = parse_type_params(p)
    var params: Buf[ClassParam] = buf()
    if p.at("(") then params = parse_class_params(p)
    var event: &TypeExpr = TypeExpr(p.toks.here(), InvalidType)
    if p.accept("receives") then event = parse_type(p)
    else p.report.add(error(p.toks.here(), s"a machine names the type of the events it handles: `machine $name receives Event`"))
    var members: Buf[ClassMember] = buf()
    var states: Buf[StateBlock] = buf()
    var shared: Buf[Arm] = buf()
    var shared_seen = false
    if p.accept_kind(Indent)
        loop
            if p.toks.at_end() || p.accept_kind(Dedent) then break
            if p.accept_kind(Newline) then continue
            val before = p.toks.position
            if state_member(p, name, &states) then ()
            elif p.at("receive") && next_is(p, Indent)
                val at = p.toks.here()
                p.toks.advance()
                if shared_seen then p.report.add(error(at, s"`$name` has one `receive` block, holding the arms every state shares"))
                shared_seen = true
                p.expect_kind(Indent, "expected indented arms after `receive`")
                for arm in machine_arms(p)
                    shared.push(arm)
            else members.push(parse_class_member(p))
            if p.toks.position == before then p.toks.advance()
            if !p.toks.at_end() && !p.at_kind(Newline) && !p.at_kind(Dedent) && !after_block(p)
                p.report.add(error(p.toks.here(), "expected a new line between a machine's members"))
                skip_line(p)
        optional_end(p, name, true)
    val span = start.to(p.ended())
    if states.len() == 0 then p.report.add(error(name_span, s"a machine declares its states: `$name` has no `state` block"))
    else first_state_plain(p, name, states)
    machine_declarations(annotations, span, name_span, name, type_params, params, event, members, states, shared)

/** Reads a member of a machine's or an actor's body that belongs to its states, if one starts here:
 * a `state` block, added to `states` unless one of its name is there already, or an `enter` or
 * `leave` block written outside a state, which is reported. */
state_member(p: *Parser, name: string, states: *Buf[StateBlock]) -> bool
    if state_ahead(p)
        val state = parse_state(p)
        var again = false
        for i in 0..<states.len()
            if states[i].name == state.name then again = true
        if again then p.report.add(error(state.span, s"`$name` declares the state `${state.name}` more than once"))
        else states.push(state)
        return true
    if (p.at("enter") || p.at("leave")) && next_is(p, Indent)
        p.report.add(error(p.toks.here(), s"`${p.ahead(0)}` belongs to a state: write it inside the `state` block it runs for"))
        p.toks.advance()
        parse_body(p, true)
        return true
    false

/** Reports a first state with parameters: it is where the machine or actor `name` starts. */
first_state_plain(p: *Parser, name: string, states: Buf[StateBlock])
    if states.len() > 0 && states[0].params.len() > 0
        p.report.add(error(states[0].span, s"the first state is where `$name` starts, so it takes no parameters"))

// `state Name` or `state Name(params)` at the start of a line; `state` followed by anything else is
// an ordinary name, as in `state = 3` or `state()`.
private state_ahead(p: *Parser) -> bool
    if !p.at("state") then return false
    val next = p.toks.peek_at(1) match
        Some(t) -> t
        None -> return false
    if next.value != Word then return false
    val after = p.toks.peek_at(2) match
        Some(t) -> t
        None -> return true
    p.ahead(2) == "(" || after.value == Indent || after.value == Newline || after.value == Dedent

next_is(p: *Parser, kind: Token) -> bool = p.toks.peek_at(1) match
    Some(t) -> t.value == kind
    None -> false

// `state Name(params)` and an optional indented block of `enter` and `leave` blocks and arms.
private parse_state(p: *Parser) -> StateBlock
    val at = p.toks.here()
    p.expect("state")
    val name = declared_name(p, "a state")
    var params: Buf[Param] = buf()
    if p.at("(") then params = parse_params(p, false)
    var block = StateBlock(at.to(p.ended()), name, params, None, None, buf())
    if !p.accept_kind(Indent) then return block
    loop
        if p.toks.at_end() || p.accept_kind(Dedent) then break
        if p.accept_kind(Newline) then continue
        val before = p.toks.position
        if (p.at("enter") || p.at("leave")) && next_is(p, Indent)
            val word_at = p.toks.here()
            val word = p.ahead(0)
            p.toks.advance()
            val body = parse_body(p, true)
            if word == "enter"
                if block.enter is Some(_) then p.report.add(error(word_at, s"state `$name` has one `enter` block"))
                block.enter = Some(body)
            else
                if block.leave is Some(_) then p.report.add(error(word_at, s"state `$name` has one `leave` block"))
                block.leave = Some(body)
        else
            val fallback = p.accept("else")
            block.arms.push(match_arm(p, fallback, false))
        if p.toks.position == before then p.toks.advance()
    optional_end(p, "state", true)
    block

// The arms of an indented block whose Indent is consumed, through its Dedent.
machine_arms(p: *Parser) -> Buf[Arm]
    var arms: Buf[Arm] = buf()
    loop
        if p.toks.at_end() || p.accept_kind(Dedent) then break
        if p.accept_kind(Newline) then continue
        val before = p.toks.position
        val fallback = p.accept("else")
        arms.push(match_arm(p, fallback, false))
        if p.toks.position == before then break
    optional_end(p, "receive", true)
    arms

private name_expr(at: Span, name: string) -> &Expr = Expr(at, Name(name))

private assign_expr(at: Span, target: string, value: &Expr) -> &Expr = Expr(at, Assign(name_expr(at, target), None, value, false, at))

private flag(at: Span, target: string, value: bool) -> &Expr = assign_expr(at, target, Expr(at, BoolLit(value)))

private type_named(at: Span, name: string, args: Buf[&TypeExpr]) -> &TypeExpr = TypeExpr(at, Named(name, args))

// The pattern a state is matched by, binding its parameters by their names.
private state_pattern(state: StateBlock) -> &Pattern
    if state.params.len() == 0 then return Pattern(state.span, Name(state.name))
    var args: Buf[&Pattern] = buf()
    for param in state.params
        args.push(param.pattern)
    Pattern(state.span, Constructor(state.name, args, true))

// `stay`, as an arm's value: it records that no transition happens and yields the current state.
// An arm's value is the last item of a block and each branch of an `if` or a `match`.
private replace_stay(e: &Expr) -> &Expr = e.kind match
    Name(n) ->
        if n != "stay" then return e
        var items: Buf[&Expr] = buf()
        items.push(flag(e.span, MachineStayed, true))
        items.push(name_expr(e.span, MachineCurrent))
        Expr(e.span, Block(items, false))
    Block(items, discard) ->
        if items.len() == 0 || discard then return e
        var copy: Buf[&Expr] = buf()
        for i in 0..<items.len() - 1
            copy.push(items[i])
        copy.push(replace_stay(items[items.len() - 1]))
        Expr(e.span, Block(copy, discard))
    If(condition, yes, no) ->
        val otherwise: Option[&Expr] = no match
            Some(n) -> Some(replace_stay(n))
            None -> None
        Expr(e.span, If(condition, replace_stay(yes), otherwise))
    Match(subject, arms) ->
        var out: Buf[Arm] = buf()
        for arm in arms
            out.push(Arm(arm.pattern, arm.guard, replace_stay(arm.body)))
        Expr(e.span, Match(subject, out))
    _ -> e

// Each arm's value is bound as the state type, so an arm yielding anything else is reported at the
// arm, as the state type expected.
private stay_arms(arms: Buf[Arm], state_type: &TypeExpr) -> Buf[Arm]
    var out: Buf[Arm] = buf()
    for arm in arms
        val at = arm.body.span
        var items: Buf[&Expr] = buf()
        items.push(Expr(at, Binding(MachineArm, Some(state_type), replace_stay(arm.body), false)))
        items.push(name_expr(at, MachineArm))
        out.push(Arm(arm.pattern, arm.guard, Expr(at, Block(items, false))))
    out

// A match of the state `subject` names, running each state's block where it has one.
private run_blocks(at: Span, subject: string, states: Buf[StateBlock], enter: bool) -> Option[&Expr]
    var arms: Buf[Arm] = buf()
    for state in states
        val body = if enter then state.enter else state.leave
        if body is Some(b) then arms.push(Arm(state_pattern(state), None, b))
    if arms.len() == 0 then return None
    if arms.len() < states.len() then arms.push(Arm(Pattern(at, Wildcard), None, Expr(at, UnitLit)))
    Some(Expr(at, Match(name_expr(at, subject), arms)))

/** The `State` type of a machine or an actor with states: its `data` declaration, the type as the
 * declarations it is read into write it, and its states' places for the coverage check. */
struct StateType
    data: &DataDecl
    ty: &TypeExpr
    sites: Buf[MachineSite]

/** The `data` type `Name.State` of the machine or actor `name`, with a variant for each state holding
 * that state's parameters. It takes the declaration's type parameters, so a state may hold values of
 * them. */
state_type(span: Span, at: Span, name: string, type_params: Buf[TypeParam], states: Buf[StateBlock]) -> StateType
    val states_name = name + ".State"
    var state_params: Buf[TypeParam] = buf()
    var state_args: Buf[&TypeExpr] = buf()
    for tp in type_params
        state_params.push(TypeParam(tp.span, tp.name, tp.variance, tp.bounds, tp.site + ".State", tp.lower))
        state_args.push(type_named(tp.span, tp.name, buf()))
    var variants: Buf[Variant] = buf()
    var sites: Buf[MachineSite] = buf()
    for state in states
        variants.push(Variant(state.span, state.name, state.params, buf()))
        sites.push(MachineSite(state.span, name, state.name, state.arms.len()))
    StateType(DataDecl(buf(), span, states_name, state_params, variants, buf()), type_named(at, states_name, state_args), sites)

/** The fields holding the current state, which starts as the first, and whether the event being
 * handled stays in it; and the method `state()` answering the current state. */
state_members(at: Span, states: Buf[StateBlock], state_type: &TypeExpr, members: *Buf[ClassMember], public_state: bool)
    val first: &Expr = if states.len() > 0 then name_expr(states[0].span, states[0].name) else Expr(at, Invalid)
    members.push(FieldMember(FieldDecl(at, MachineCurrent, Some(state_type), first, true, false, false)))
    members.push(FieldMember(FieldDecl(at, MachineStayed, None, Expr(at, BoolLit(false)), true, false, false)))
    members.push(MethodMember(Function(buf(), at, at, "state", buf(), buf(), Some(state_type), Some(name_expr(at, MachineCurrent)), buf()), public_state, false, false))

/** The statements handling the event the local `event` holds in the current state: the current
 * state matched, and in it the event against the state's own arms followed by the shared ones, each
 * arm's value the next state; then, unless the arm yielded `stay`, the current state's `leave`, the
 * next state made current and its `enter`. */
state_handling(at: Span, states: Buf[StateBlock], shared: Buf[Arm], state_type: &TypeExpr, event: string) -> Buf[&Expr]
    var body: Buf[&Expr] = buf()
    body.push(flag(at, MachineStayed, false))
    var state_arms: Buf[Arm] = buf()
    for state in states
        var arms: Buf[Arm] = buf()
        for arm in state.arms
            arms.push(arm)
        for arm in shared
            arms.push(arm)
        val events = Expr(state.span, Match(name_expr(state.span, event), stay_arms(arms, state_type)))
        state_arms.push(Arm(state_pattern(state), None, events))
    body.push(Expr(at, Binding(MachineNext, Some(state_type), Expr(at, Match(name_expr(at, MachineCurrent), state_arms)), false)))
    var transition: Buf[&Expr] = buf()
    if run_blocks(at, MachineCurrent, states, false) is Some(leave) then transition.push(leave)
    transition.push(assign_expr(at, MachineCurrent, name_expr(at, MachineNext)))
    if run_blocks(at, MachineNext, states, true) is Some(enter) then transition.push(enter)
    body.push(Expr(at, If(Expr(at, Unary(Not, name_expr(at, MachineStayed))), Expr(at, Block(transition, true)), None)))
    body

private machine_declarations(annotations: Buf[Annotation], span: Span, name_span: Span, name: string, type_params: Buf[TypeParam], params: Buf[ClassParam], event: &TypeExpr, written: Buf[ClassMember], states: Buf[StateBlock], shared: Buf[Arm]) -> Machine
    val at = name_span
    val st = state_type(span, at, name, type_params, states)
    val state_type = st.ty
    var members: Buf[ClassMember] = buf()
    state_members(at, states, state_type, &members, true)
    members.push(FieldMember(FieldDecl(at, MachineBusy, None, Expr(at, BoolLit(false)), true, false, false)))
    for m in written
        members.push(m)
    // The first state's `enter` runs when the machine is made, after the body.
    if states.len() > 0
        if states[0].enter is Some(body)
            var items: Buf[&Expr] = buf()
            items.push(flag(at, MachineBusy, true))
            items.push(body)
            items.push(flag(at, MachineBusy, false))
            members.push(StatementMember(Expr(at, Block(items, true))))
    // `handle(event: Event) -> Door.State`
    var body: Buf[&Expr] = buf()
    var fail_args: Buf[Argument] = buf()
    fail_args.push(Argument(at, None, Expr(at, StringLit(s"`$name` handles an event from inside one of its own arms, `enter` or `leave` blocks")), false))
    val trap = Expr(at, Call(name_expr(at, "avin::fail"), fail_args))
    body.push(Expr(at, If(name_expr(at, MachineBusy), trap, None)))
    body.push(flag(at, MachineBusy, true))
    for item in state_handling(at, states, shared, state_type, MachineEvent)
        body.push(item)
    body.push(flag(at, MachineBusy, false))
    body.push(name_expr(at, MachineCurrent))
    var handle_params: Buf[Param] = buf()
    handle_params.push(Param(at, Pattern(at, Name(MachineEvent)), event, None, false, false, buf()))
    members.push(MethodMember(Function(buf(), at, at, "handle", buf(), handle_params, Some(state_type), Some(Expr(at, Block(body, false))), buf()), true, false, false))
    val decl = ClassDecl(annotations, span, name_span, name, "", at, type_params, params, buf(), buf(), members, false)
    Machine(st.data, decl, st.sites)
