module dev.avinlang.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}

// Which calls through a method table become direct: one where only one method can run, or where the
// receiver's descriptor is known; a guarded one where a few small methods can; and none where many
// methods, or large ones, can.

private lowered(text: string) -> MirProgram = lower_source(repository_toolchain(), source_of("probe.avin", text)) match
    Ok(p) -> p
    Err(d) -> panic(d)

private function_of(program: MirProgram, name: string) -> MirFunction
    for f in program.functions
        if f.symbol == "<program>." + name then return f
    panic("no function " + name)

/** How the calls of the program's function `name` are made: through a table, directly to the
 * program's functions, and how many descriptors are compared. */
private struct Calls
    through_tables: int
    direct: Buf[string]
    compared: int

private calls_of(text: string, name: string) -> Calls
    val program = lowered(text)
    var tables = 0
    var direct: Buf[string] = buf()
    var compared = 0
    for block in function_of(program, name).blocks
        for inst in block.insts
            inst match
                MethodSlot(_, _, _) -> tables = tables + 1
                Call(_, Direct(g), _) -> direct.push(program.functions[g].symbol)
                Compare(_, CmpEq, _, DescriptorAddress(_)) -> compared = compared + 1
                _ -> ()
    Calls(tables, direct, compared)

private calls(c: Calls, symbol: string) -> bool
    for d in c.direct
        if d == "<program>." + symbol then return true
    false

private const Shapes: string = "trait Shape\n    area() -> int\n\nclass Square(val side: int): Shape\n    override area() -> int = side * side\n\n"

@test("a call through a trait with one implementation is a direct call")
one_implementation_is_direct()
    val c = calls_of(Shapes + "total(s: Shape) -> int = s.area()\n\nmain()\n    print(total(Square(2)))\n", "total")
    assert_eq(c.through_tables, 0)
    assert_eq(c.compared, 0)
    assert(calls(c, "Square.area"))

private const TwoShapes: string = Shapes + "class Rect(val w: int, val h: int): Shape\n    override area() -> int = w * h\n\n"

@test("a call through a trait with two small implementations tests the receiver's descriptor for each")
two_implementations_are_guarded()
    val c = calls_of(TwoShapes + "total(s: Shape) -> int = s.area()\n\nmain()\n    print(total(Square(2)) + total(Rect(2, 3)))\n", "total")
    assert_eq(c.compared, 2)
    assert(calls(c, "Square.area"))
    assert(calls(c, "Rect.area"))
    // An object of neither type still takes the method from its table.
    assert_eq(c.through_tables, 1)

@test("a guarded call compares the descriptor the receiver's header holds")
guard_compares_descriptor()
    val ir = emit_llvm(lowered(TwoShapes + "total(s: Shape) -> int = s.area()\n\nmain()\n    print(total(Square(2)) + total(Rect(2, 3)))\n"))
    assert(ir.contains("icmp eq ptr %v"))
    assert(ir.contains(", @avin.desc."))

@test("a call on an object made in the function is direct, whatever else implements its trait")
made_here_is_direct()
    // The object is kept in a module-level value, so it stays an object and its call stays a call.
    val c = calls_of(TwoShapes + "var kept: Any = 0\n\nlocal() -> int\n    val s: Shape = Rect(2, 3)\n    kept = s\n    s.area()\n\nmain()\n    print(local() + Square(1).area())\n", "local")
    assert_eq(c.through_tables, 0)
    assert_eq(c.compared, 0)
    assert(calls(c, "Rect.area"))

@test("a call on what a function that always makes one class returns is direct")
returned_is_direct()
    val c = calls_of(TwoShapes + "var kept: Any = 0\n\nmake() -> Shape = Rect(2, 3)\n\nlocal() -> int\n    val s = make()\n    kept = s\n    s.area()\n\nmain()\n    print(local() + Square(1).area())\n", "local")
    assert_eq(c.through_tables, 0)
    assert(calls(c, "Rect.area"))

@test("a local that holds objects of two classes in turn keeps its calls guarded")
reassigned_local_stays_guarded()
    val c = calls_of(TwoShapes + "local() -> int\n    var s: Shape = Rect(2, 3)\n    val a = s.area()\n    s = Square(1)\n    a + s.area()\n\nmain()\n    print(local())\n", "local")
    assert_eq(c.through_tables, 2)
    assert_eq(c.compared, 4)

@test("a call on an open class with an override is never made a plain direct call")
open_override_stays_dynamic()
    val c = calls_of("open class Counter\n    step() -> int = 1\n\nclass Doubler: Counter\n    override step() -> int = 2\n\nsteps(c: Counter) -> int = c.step()\n\nmain()\n    print(steps(Counter()) + steps(Doubler()))\n", "steps")
    assert_eq(c.through_tables, 1)
    assert_eq(c.compared, 2)

@test("a call an open class's subclasses never override is a direct call")
open_without_override_is_direct()
    val c = calls_of("open class Counter\n    step() -> int = 1\n\nclass Quiet: Counter\n\nsteps(c: Counter) -> int = c.step()\n\nmain()\n    print(steps(Counter()) + steps(Quiet()))\n", "steps")
    assert_eq(c.through_tables, 0)
    assert(calls(c, "Counter.step"))

@test("a call through a trait with more implementations than a call tests for stays through the table")
many_implementations_stay_dynamic()
    var text = "trait Digit\n    value() -> int\n\n"
    var made = ""
    for i in 1..<10
        text = text + s"class D$i: Digit\n    override value() -> int = $i\n\n"
        made = made + s" + get(D$i())"
    text = text + "get(d: Digit) -> int = d.value()\n\nmain()\n    print(0" + made + ")\n"
    val c = calls_of(text, "get")
    assert_eq(c.through_tables, 1)
    assert_eq(c.compared, 0)

@test("a call whose methods are too large to inline stays through the table")
large_methods_stay_dynamic()
    var body = "0"
    for i in 0..<40
        body = s"($body + k * $i) % 1000"
    val text = s"trait Big\n    run(k: int) -> int\n\nclass A: Big\n    override run(k: int) -> int = $body\n\nclass B: Big\n    override run(k: int) -> int = $body\n\ncall(b: Big) -> int = b.run(3)\n\nmain()\n    print(call(A()) + call(B()))\n"
    val c = calls_of(text, "call")
    assert_eq(c.through_tables, 1)
    assert_eq(c.compared, 0)

@test("an override that returns nothing, where the method it overrides returns a value, stays through the table")
nothing_override_stays_dynamic()
    val c = calls_of("import avin.process.exit\n\nopen class Base\n    size() -> int = 1\n\nclass Failing: Base\n    override size() -> Nothing = exit(1)\n\nlocal() -> int\n    val f: Base = Failing()\n    f.size()\n\nmain()\n    print(local())\n", "local")
    assert_eq(c.through_tables, 1)
    assert_eq(c.direct.len(), 1usize)

@test("a trait's default body and an impl's own method are each the one their type's calls reach")
default_and_impl_are_guarded()
    val c = calls_of("trait Greeter\n    greet() -> string = \"hello\"\n\ndata Plain(n: int)\ndata Fancy(n: int)\n\nimpl Greeter for Plain\n\nimpl Greeter for Fancy\n    greet() -> string = \"good day\"\n\nwelcome(g: Greeter) -> string = g.greet()\n\nmain()\n    print(welcome(Plain(1)) + welcome(Fancy(2)))\n", "welcome")
    assert(calls(c, "Greeter.greet"))
    assert(calls(c, "Fancy.greet"))
