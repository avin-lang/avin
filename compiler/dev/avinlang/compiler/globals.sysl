module dev.avinlang.compiler

import sysl.buf.{Buf, buf}

// What a function's checked code needs of the rest of the program, which orders the initialization
// of module-level values: each value is computed after every value its initializer reaches.

/** What one function's code uses directly: the module-level values it reads or writes, and the
 * functions it calls or makes closures of. Each is listed once, in the order first used. */
struct Uses
    globals: Buf[usize]
    functions: Buf[usize]
    /** The method and the method table slot of each call made through a method table. Which
     * functions such a call may reach depends on the classes of the program, so the caller adds
     * them to `functions`. */
    dispatched: Buf[usize]
    dispatched_slots: Buf[usize]
    /** The core trait method (`add`, `less`, `equals`, `negate`, ...) and the operand type of each
     * operator applied to values that are not built-in scalars. Which impl method it calls is
     * decided when the program is lowered, so the caller adds the candidates to `functions`. */
    operators: Buf[string]
    operator_types: Buf[&Type]

uses_of(body: &TExpr) -> Uses
    var u = Uses(buf(), buf(), buf(), buf(), buf(), buf())
    collect(&u, body)
    u

/** Records that the code applies the core trait method `name` to values of type `t`, unless they are
 * built-in scalars, whose operators are the machine's own. */
private add_operator(u: *Uses, name: string, t: &Type)
    val scalar = *t match
        Int(_) -> true
        Real -> true
        Byte -> true
        Char -> true
        Bool -> true
        Unit -> true
        Str -> true
        _ -> false
    if scalar then return
    u.operators.push(name)
    u.operator_types.push(t)

private compare_method(op: CompareOp) -> Option[string] = op match
    Equal -> Some("equals")
    NotEqual -> Some("equals")
    Less -> Some("less")
    LessEqual -> Some("lessOrEqual")
    Greater -> Some("greater")
    GreaterEqual -> Some("greaterOrEqual")
    _ -> None

/** Records that the code may call `f`. */
add_function(u: *Uses, f: usize)
    add(&u.functions, f)

/** The module-level values `start` uses, directly or through every function it reaches, in the
 * order they are first found. */
globals_reached(direct: Buf[Option[Uses]], start: usize) -> Buf[usize]
    var seen: Buf[bool] = buf()
    for _ in direct
        seen.push(false)
    var pending: Buf[usize] = buf()
    pending.push(start)
    seen.set(start, true)
    var out: Buf[usize] = buf()
    var next = 0usize
    while next < pending.len()
        val f = pending[next]
        next += 1
        if direct[f] is Some(u)
            for g in u.globals
                add(&out, g)
            for callee in u.functions
                if !seen[callee]
                    seen.set(callee, true)
                    pending.push(callee)
    out

private add(items: *Buf[usize], x: usize)
    for item in *items
        if item == x then return
    items.push(x)

private collect_all(u: *Uses, items: Buf[&TExpr])
    for item in items
        collect(u, item)

private collect_option(u: *Uses, e: Option[&TExpr])
    if e is Some(x) then collect(u, x)

private collect(u: *Uses, e: &TExpr)
    e.kind match
        Global(g) -> add(&u.globals, g)
        // A lazy value's read may run its initializer, so it uses what the initializer uses.
        LazyGlobal(_, initialize, _) -> collect(u, initialize)
        LazyField(object, _, initialize, _) ->
            collect(u, object)
            collect(u, initialize)
        StoreGlobal(g, value, _) ->
            add(&u.globals, g)
            collect(u, value)
        Call(f, args, _) ->
            add(&u.functions, f)
            collect_all(u, args)
        Dispatch(f, slot, args, _) ->
            add(&u.functions, f)
            u.dispatched.push(f)
            u.dispatched_slots.push(slot)
            collect_all(u, args)
        // A call through a bound reaches the implementation of whichever type an instance has.
        BoundCall(f, slot, args, _) ->
            add(&u.functions, f)
            if slot is Some(s)
                u.dispatched.push(f)
                u.dispatched_slots.push(s)
            collect_all(u, args)
        FunctionValue(f, _) -> add(&u.functions, f)
        CallValue(callee, args) ->
            collect(u, callee)
            collect_all(u, args)
        Construct(_, args) -> collect_all(u, args)
        Collection(_, built) -> collect(u, built)
        Field(value, _) -> collect(u, value)
        StoreField(object, _, value, _) ->
            collect(u, object)
            collect(u, value)
        Block(items) -> collect_all(u, items)
        Let(_, value) -> collect(u, value)
        LetPattern(_, value) -> collect(u, value)
        Store(_, value, _) -> collect(u, value)
        MultiStore(_, value) -> collect(u, value)
        Negate(x) ->
            add_operator(u, "negate", x.ty)
            collect(u, x)
        Not(x) -> collect(u, x)
        Complement(x) -> collect(u, x)
        Convert(x) -> collect(u, x)
        Render(x) -> collect(u, x)
        Box(x) -> collect(u, x)
        Arith(op, a, b, _) ->
            if binary_operator_method(op) is Some(om) then add_operator(u, om.method, a.ty)
            collect(u, a)
            collect(u, b)
        Logic(_, a, b) ->
            collect(u, a)
            collect(u, b)
        Compare(operands, ops) ->
            for i in 0..<ops.len()
                if compare_method(ops[i]) is Some(name) then add_operator(u, name, operands[i].ty)
            collect_all(u, operands)
        If(condition, yes, no) ->
            collect(u, condition)
            collect(u, yes)
            collect_option(u, no)
        While(_, condition, body, otherwise) ->
            collect(u, condition)
            collect(u, body)
            collect_option(u, otherwise)
        Break(_, value) -> collect_option(u, value)
        Return(value) -> collect_option(u, value)
        Match(subject, arms) ->
            collect(u, subject)
            for arm in arms
                collect_option(u, arm.guard)
                collect(u, arm.body)
        Is(value, _, _) -> collect(u, value)
        Clauses(subjects, clauses) ->
            collect_all(u, subjects)
            for clause in clauses
                for b in clause.bodies
                    collect_option(u, b.guard)
                    collect(u, b.body)
        _ -> ()
