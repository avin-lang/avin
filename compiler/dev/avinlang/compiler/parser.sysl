module dev.avinlang.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.from_utf8_unchecked

struct Parser
    src: Source
    toks: Tokens[Token]
    report: Report
    /** The token position of the `->` that ends a match guard, so the guard does not read it as a
     * lambda arrow. */
    lambda_boundary: Option[usize]
    /** Whether the parser is inside brackets whose commas separate items (call arguments, tuple and
     * collection literals): a `return` or `break` value stops at the comma there, instead of making a
     * tuple. An indented block starts a new line context and clears it. */
    in_list: bool
    /** The spans of the expressions written in parentheses of their own, which the rule against
     * mixing left- and right-grouping infix calls lets through. */
    grouped: Buf[Span]
    /** Whether the parser is in the header of a form whose indented body follows: an `if` or `while`
     * test, a `for` source, a class's parents. An indented block there is the form's body, never a
     * call's trailing block. A block's own lines clear it. */
    in_header: bool
    /** The continuation lines an expression has entered and not yet left in the current block: each
     * line that starts with a binary operator and is indented deeper than the one above it opens
     * one. A block's own lines start again from none. */
    open_lines: usize
    /** The most parts of any tuple written in the file so far, as a type, a value or a pattern. */
    widest_tuple: usize
    /** How many `select`s the file has read so far: each one's hidden names carry its number, which,
     * unlike its position, stays the same when the formatter moves it. */
    selects: usize

    spelling(self, t: Spanned[Token]) -> string = from_utf8_unchecked(self.src.text(t.span))

    at(self, word: string) -> bool = self.toks.peek() match
        Some(t) -> self.spelling(t) == word
        None -> false

    at_kind(self, kind: Token) -> bool = self.toks.peek() match
        Some(t) -> t.value == kind
        None -> false

    accept(*self, word: string) -> bool
        if !self.at(word) then return false
        self.toks.advance()
        true

    expect(*self, word: string)
        if !self.accept(word)
            self.report.add(expected(self.toks.here(), s"`$word`", found_at(self.src, self.toks.here())))

    accept_kind(*self, kind: Token) -> bool
        if !self.at_kind(kind) then return false
        self.toks.advance()
        true

    expect_kind(*self, kind: Token, message: string)
        if !self.accept_kind(kind) then self.report.add(error(self.toks.here(), message))

    /** The span of the last token consumed that is written in the source: the layout tokens a line
     * break or a closed block adds are skipped, so a construct that ends there ends at its own last
     * word or bracket and not at the start of whatever follows. */
    ended(self) -> Span
        var i = self.toks.position
        while i > 0
            val t = self.toks.items[i - 1]
            if t.value != Newline && t.value != Indent && t.value != Dedent then return t.span
            i -= 1
        self.toks.here()

    /** The spelling of the token `offset` places ahead, or "" past the end. */
    ahead(self, offset: usize) -> string = self.toks.peek_at(offset) match
        Some(t) -> self.spelling(t)
        None -> ""

    /** Whether the parser is at the end of a line or of the enclosing form. */
    at_line_end(self) -> bool =
        self.toks.at_end() || self.at_kind(Newline) || self.at_kind(Dedent) || self.at(")") ||
            self.at("]") || self.at("}") || self.at(",") || self.at("else") || self.at("elif")

    /** How many layout tokens stand between a complete operand and a binary operator that starts a
     * continuation line: one line indented deeper than the line above it, or another line of a
     * continuation already entered, at its depth or back at a shallower one it entered. `None`
     * when the next line does not continue the expression, and always in the header of a form,
     * whose indented lines are its body. */
    continues_line(self) -> Option[usize]
        if self.in_header then return None
        val next = self.toks.peek() match
            Some(t) -> t
            None -> return None
        var skipped = 0usize
        if next.value == Indent then skipped = 1
        elif next.value == Newline
            if self.open_lines == 0 then return None
            skipped = 1
        elif next.value == Dedent
            loop
                val closing = self.toks.peek_at(skipped) match
                    Some(t) -> t.value == Dedent
                    None -> false
                if !closing then break
                skipped += 1
            if skipped >= self.open_lines then return None
        // After an indented block that closed inside a continuation, the next continuation line
        // follows the block's last line with no layout token of its own.
        elif self.open_lines == 0 || !after_dedent(self) then return None
        if starts_continuation(self, skipped) then Some(skipped) else None
end Parser

impl TokenStream for Parser
    type Token = Spanned[Token]
    look(self) -> Option[Spanned[Token]]
        var offset = 0usize
        if self.continues_line() is Some(skipped) then offset = skipped
        // A dedent closes an expression's indented body. The next line may begin with `-` or `(`,
        // which must not attach to the closed expression as an infix or postfix operator.
        elif after_dedent(self) then return None
        self.toks.peek_at(offset) match
            Some(t) -> Some(as_infix(self, t, offset))
            None -> None
    take(*self) -> Option[Spanned[Token]]
        if operand_ended(self) && self.continues_line() is Some(skipped)
            for i in 0..<skipped
                val layout = self.toks.advance().unwrap()
                if layout.value == Indent then self.open_lines += 1
                if layout.value == Dedent then self.open_lines -= 1
        self.toks.advance()

parser_for(src: Source) -> Parser
    val lexed = lex(src)
    Parser(src, lexed.items, lexed.report, None, false, buf(), false, 0, 0, 0)

private after_dedent(p: Parser) -> bool = p.toks.position > 0 && p.toks.items[p.toks.position - 1].value == Dedent

// Whether the token at `index` starts its line: it is the first, or a line break, an indent or a
// dedent comes right before it.
private starts_line(p: *Parser, index: usize) -> bool
    if index == 0 then return true
    val before = p.toks.items[index - 1].value
    before == Newline || before == Indent || before == Dedent

// The token `t`, `offset` places ahead, as the operator loop sees it after a complete operand. A name
// there is an infix method call; inside brackets, where a line break makes no token, the name may be
// on a later line, which `infix_call` rejects. A method named by a symbol binds at the level its
// name gives it, and `~` is the method `~`, binding tightest. `++` and `--` with an operand after
// them on the line call a method of that name, `xs ++ ys`; otherwise they update the operand before
// them, `i++`.
private as_infix(p: Parser, t: Spanned[Token], offset: usize) -> Spanned[Token]
    if p.toks.position == 0 then return t
    // `with` right before a brace is the update tail of a data value, binding as a postfix operator.
    if t.value == Word && p.spelling(t) == "with" && p.ahead(offset + 1) == "{" then return Spanned(Postfix, t.span)
    if t.value == Word && !is_keyword(p.spelling(t)) then return Spanned(InfixName, t.span)
    if t.value == SymbolOp then return Spanned(symbol_token(p.spelling(t)), t.span)
    if t.value == Symbol && p.spelling(t) == "~" then return Spanned(SymbolTight, t.span)
    if t.value == Postfix && operand_follows(p, t, offset) then return Spanned(SymbolAdd, t.span)
    t

// Whether the token `offset` places ahead can start a continuation line: an operator that can stand
// between two operands (every operator of the language's binary families, a method named by a
// symbol, `~`, and `++` or `--` with an operand after it), or the `.` of a member, which goes on with
// the operand the line above ended on. `!`, `=` and the compound assignments, `?` and brackets cannot.
private starts_continuation(p: Parser, offset: usize) -> bool
    val t = p.toks.peek_at(offset) match
        Some(t) -> t
        None -> return false
    t.value match
        AddOp | MultiplyOp | CompareOp | RangeOp | ConsOp | BitOrOp | BitXorOp | BitAndOp | AndOp | OrOp | SymbolOp -> true
        Symbol -> p.spelling(t) == "~"
        Postfix -> p.spelling(t) == "." || operand_follows(p, t, offset)
        _ -> false

// Whether the last token taken completes an operand, so that a continuation line may follow it: a
// name, a literal, a closing bracket, a postfix operator, or the end of a block inside a continuation.
private operand_ended(p: *Parser) -> bool
    if p.toks.position == 0 then return false
    val last = p.toks.items[p.toks.position - 1]
    last.value match
        Word ->
            val w = p.spelling(last)
            if w == "not" && p.toks.position >= 2 && p.toks.items[p.toks.position - 2].value == IsKeyword then return false
            !is_keyword(w) || w == "self" || w == "true" || w == "false"
        Number | RealNumber | Quoted | Interpolated | CharQuoted | Postfix -> true
        Dedent -> p.open_lines > 0
        _ ->
            val w = p.spelling(last)
            w == ")" || w == "]" || w == "}"

/** Leaves the continuation lines an expression entered beyond `base`, when no operator continues it:
 * the lines that follow are back at the depth the expression began on. A line inside the
 * continuation that does not start with an operator is reported, and skipped with any block nested
 * under it. */
private leave_lines(p: *Parser, base: usize)
    if p.open_lines <= base then return
    if p.look() is Some(t) && binding(t) > 0 then return
    var reported = false
    while p.open_lines > base
        val t = p.toks.advance() match
            Some(t) -> t
            None ->
                p.open_lines = base
                return
        if t.value == Dedent then p.open_lines -= 1
        elif t.value == Indent then p.open_lines += 1
        elif !reported && t.value != Newline
            p.report.add(error(t.span, "a line indented under a continued expression continues it, so it starts with a binary operator or `.`"))
            reported = true

// Whether the `++` or `--` token `t`, `offset` places ahead, is followed on its own line by something
// that begins an operand and is not itself an operator: a name, a literal or an opening bracket, or
// an indented block on the next line.
private operand_follows(p: Parser, t: Spanned[Token], offset: usize) -> bool
    val word = p.spelling(t)
    if word != "++" && word != "--" then return false
    val next = p.toks.peek_at(offset + 1) match
        Some(n) -> n
        None -> return false
    if next.value == Indent then return true
    for b in p.src.text(Span(t.span.end, next.span.start))
        if b == u8('\n') then return false
    next.value match
        Word ->
            val w = p.spelling(next)
            !is_keyword(w) || w == "self" || w == "true" || w == "false"
        Number | RealNumber | Quoted | Interpolated | CharQuoted -> true
        _ ->
            val w = p.spelling(next)
            w == "(" || w == "[" || w == "{"

struct ParsedExpr
    tree: &Expr
    report: Report

/** Parses one expression; used by tests and tools. */
parse_expression(src: Source) -> ParsedExpr
    var p = parser_for(src)
    val tree = expression(&p, 0)
    if !p.toks.at_end() then p.report.add(error(p.toks.here(), "unexpected input after expression"))
    ParsedExpr(tree, p.report)

expression(p: *Parser, minimum: u16) -> &Expr
    val base = p.open_lines
    pratt(p, minimum, prefix, infix, binding) match
        Some(e) ->
            leave_lines(p, base)
            e
        None ->
            val at = p.toks.here()
            p.report.add(expected(at, "an expression", found_at(p.src, at)))
            Expr(at, Invalid)

// Binding powers, loosest first. Bitwise operators bind more tightly than comparisons, and shifts
// bind with multiplication.
private binding(t: Spanned[Token]) -> u16
    t.value match
        AssignOp -> 2
        MatchKeyword -> 5
        OrOp -> 10
        AndOp -> 20
        CompareOp -> 30
        IsKeyword -> 30
        SymbolCompare -> 30
        InfixName -> InfixBinding
        RangeOp -> 34
        ConsOp -> 35
        SymbolCons -> 35
        BitOrOp -> 36
        SymbolBitOr -> 36
        BitXorOp -> 37
        SymbolBitXor -> 37
        BitAndOp -> 38
        SymbolBitAnd -> 38
        AddOp -> 40
        SymbolAdd -> 40
        MultiplyOp -> 50
        SymbolMultiply -> 50
        SymbolTight -> 55
        Postfix -> 80
        _ -> 0

private const PrefixBinding: u16 = 60

// A method called infix by its name binds more loosely than ranges and every arithmetic operator,
// and more tightly than comparisons.
private const InfixBinding: u16 = 32

/** The level a method named by a symbol binds at: that of the language's operator its first
 * character belongs to. Names starting `<<` or `>>` bind with the shifts, at the multiplicative
 * level; `<`, `>`, `=` and `!` with the comparisons; any character that starts no operator of a level,
 * `~` and `?` among them, binds tightest of all. A name with `~` anywhere in it binds tightest too,
 * so a grammar's `~`, `~>`, `<~` and `^~` read together. A leading `#` is passed over, so `#::`
 * binds as `::` and `#+` as `+`, and a name of `#` alone binds tightest. A name ending in `=` is an
 * assignment, and never reaches here. */
symbol_token(whole: string) -> Token
    for b in whole.bytes
        if b == u8('~') then return SymbolTight
    var skipped = 0usize
    while skipped < whole.bytes.len && whole.bytes[skipped] == u8('#') do skipped += 1
    if skipped == whole.bytes.len then return SymbolTight
    val name = whole[skipped..]
    if name.starts_with("<<") || name.starts_with(">>") then return SymbolMultiply
    val first = name[0..<1]
    if first == "*" || first == "/" || first == "%" then SymbolMultiply
    elif first == "+" || first == "-" then SymbolAdd
    elif first == "&" then SymbolBitAnd
    elif first == "^" then SymbolBitXor
    elif first == "|" then SymbolBitOr
    elif first == ":" then SymbolCons
    elif first == "<" || first == ">" || first == "=" || first == "!" then SymbolCompare
    else SymbolTight

/** The binding power of a method named by a symbol, or of one named by a word. */
private call_level(name: string) -> u16 =
    if is_operator_spelling(name) then binding(Spanned(symbol_token(name), Span(0, 0))) else InfixBinding

// Words that keep their meaning after an operand, and so never name a method called infix. `not` is
// not among them: it is a keyword only directly after `is`, and an ordinary name everywhere else.
is_keyword(word: string) -> bool
    for k in ["abstract", "as", "break", "class", "continue", "data", "def", "defer", "derives", "do", "elif", "else", "end", "false", "for", "if", "impl", "import", "is", "loop", "match", "module", "object", "open", "override", "private", "return", "self", "static", "super", "then", "trait", "true", "val", "var", "while", "yield"]
        if word == k then return true
    false

// An interpolated string's holes are expressions in the file, each parsed on its own from the
// source with everything outside the hole blanked, so its spans point into the file.
private interpolation(p: *Parser, t: Spanned[Token]) -> &Expr
    val text = p.spelling(t)
    var quote = 0usize
    while text.bytes[quote] != u8('"') do quote += 1
    val prefix = from_utf8_unchecked(text.bytes[0..<quote])
    var s = scan(p.src)
    s.reset(t.span.start + quote)
    if opens_text_block(&s)
        val block = read_text_block(&s, prefix == "s" || prefix == "f", true) match
            Ok(v) -> v
            Err(_) -> return Expr(t.span, Invalid)
        var inner: Buf[&Expr] = buf()
        for span in block.holes
            inner.push(hole(p, span))
        return Expr(t.span, Interpolate(prefix, block.chunks, block.parts, inner))
    val parts = read_interpolated_literal(&s, prefix) match
        Ok(v) -> v
        Err(_) -> return Expr(t.span, Invalid)
    var holes: Buf[&Expr] = buf()
    for span in parts.holes
        holes.push(hole(p, span))
    val written = written_parts(p.src, t.span.start + quote + 1, t.span.end - 1, parts.holes)
    Expr(t.span, Interpolate(prefix, parts.chunks, written, holes))

// The literal text between an interpolation's holes as written, from `start` (just past the
// opening quote) to `end` (the closing quote): escapes are left as they are and only `$$` and `$"`, which
// are how a dollar sign and a double quote are written, become `$` and `"`. A braced hole's span is its
// expression, between `${` and `}`; a bare one's is its name, after `$`.
private written_parts(src: Source, start: usize, end: usize, holes: Buf[Span]) -> Buf[string]
    var out: Buf[string] = buf()
    var from = start
    for h in holes
        val braced = src.bytes[h.start - 1] == u8('{')
        out.push(undoubled(src, from, if braced then h.start - 2 else h.start - 1))
        from = if braced then h.end + 1 else h.end
    out.push(undoubled(src, from, end))
    out

private undoubled(src: Source, from: usize, until: usize) -> string
    var b: Buf[u8] = buf()
    var i = from
    while i < until
        if src.bytes[i] == u8('$') && i + 1 < until && (src.bytes[i + 1] == u8('$') || src.bytes[i + 1] == u8('"'))
            i += 1
        b.push(src.bytes[i])
        i += 1
    from_utf8_unchecked(b.view())

private hole(p: *Parser, span: Span) -> &Expr
    if span.start == span.end
        p.report.add(error(span, "an interpolation hole needs an expression"))
        return Expr(span, Invalid)
    val lexed = lex_hole(p.src, span)
    var inner = Parser(p.src, lexed.items, lexed.report, None, false, buf(), false, 0, 0, p.selects)
    val e = expression(&inner, 0)
    saw_tuple(p, inner.widest_tuple)
    p.selects = inner.selects
    if !inner.toks.at_end() then inner.report.add(error(inner.toks.here(), "unexpected input after the expression in this hole"))
    p.report.absorb(inner.report)
    e

private prefix(t: Spanned[Token], p: *Parser) -> &Expr
    val text = p.spelling(t)
    t.value match
        Number -> Expr(t.span, IntLit(text))
        RealNumber ->
            var s = scanner_of(text)
            read_number(&s) match
                Ok(Real(v)) -> Expr(t.span, RealLit(v, text))
                Ok(Int(_)) -> Expr(t.span, IntLit(text))
                Err(e) ->
                    p.report.add(error(t.span, e.to_string()))
                    Expr(t.span, Invalid)
        CharQuoted ->
            var s = scanner_of(text)
            read_char_literal(&s, u8('\'')) match
                Ok(v) -> Expr(t.span, CharLit(v))
                Err(_) -> Expr(t.span, Invalid)
        Quoted ->
            var s = scanner_of(text)
            if opens_text_block(&s)
                return read_text_block(&s, true, false) match
                    Ok(v) -> Expr(t.span, StringLit(v.chunks[0]))
                    Err(_) -> Expr(t.span, Invalid)
            read_quoted(&s, u8('"')) match
                Ok(v) -> Expr(t.span, StringLit(v))
                Err(_) -> Expr(t.span, Invalid)
        Interpolated -> interpolation(p, t)
        MatchKeyword -> match_function(p, t.span)
        Word -> word_prefix(t, text, p)
        SymbolOp ->
            p.report.add(error(t.span, s"`$text` is a method's name, called between its two operands; a symbol method has no prefix form, and a prefix operator written right before another needs a space between them"))
            val operand = expression(p, PrefixBinding)
            Expr(t.span.to(operand.span), Invalid)
        _ ->
            if text == "++" || text == "--"
                val target = expression(p, PrefixBinding)
                return Expr(t.span.to(target.span), Update(target, text == "++", false, t.span))
            unary_op(text) match
                Some(op) ->
                    val operand = expression(p, PrefixBinding)
                    return Expr(t.span.to(operand.span), Unary(op, operand))
                None -> ()
            if text == "[" then return collection(p, t.span, false)
            if text == "{" then return collection(p, t.span, true)
            if text == "(" then return parenthesized(p, t.span)
            if text == "." && starts_line(p, p.toks.position - 1)
                // A `.` that starts a line here continues nothing: the member after it is passed
                // over with it, so the one mistake is reported once.
                p.report.add(error(t.span, "a line starting with `.` continues the expression above only when it is indented deeper than the line that expression began on, and not in the header of a form whose body follows"))
                if p.at_kind(Word) then p.toks.advance()
                return Expr(t.span, Invalid)
            p.report.add(expected(t.span, "an expression", found_at(p.src, t.span)))
            Expr(t.span, Invalid)

private word_prefix(t: Spanned[Token], text: string, p: *Parser) -> &Expr
    if p.lambda_boundary != Some(p.toks.position) && p.accept("->")
        var params: Buf[LambdaParam] = buf()
        params.push(LambdaParam(t.span, text, None))
        val body = parse_body(p, false)
        return Expr(t.span.to(body.span), Lambda(params, body))
    if text == "true" then return Expr(t.span, BoolLit(true))
    if text == "false" then return Expr(t.span, BoolLit(false))
    if text == "if" then return parse_if(p, t.span)
    if text == "while" then return parse_while(p, t.span)
    if text == "loop" then return parse_loop(p, t.span)
    if text == "for" then return parse_for(p, t.span)
    if text == "select" && select_ahead(p) then return parse_select(p, t.span)

    if text == "do" then return parse_do(p, t.span)
    if text == "val" || text == "var" then return parse_binding(p, t.span, text == "var")
    if text == "lazy" && (p.at("val") || p.at("var"))
        p.report.add(error(t.span, "a local is computed where it is declared, so it cannot be `lazy`; a `lazy val` is a module-level value or a field"))
        val mutable = p.at("var")
        p.toks.advance()
        return parse_binding(p, t.span, mutable)
    if text == "break" || text == "return"
        var value: Option[&Expr] = None
        if !p.at_line_end() then value = Some(if p.in_list then expression(p, 0) else line_value(p))
        val kind: ExprKind = if text == "return" then Return(value) else Break(value)
        return Expr(t.span.to(p.ended()), kind)
    if text == "continue" then return Expr(t.span, Continue)
    if text == "defer"
        if p.at_line_end() && !p.at_kind(Indent)
            p.report.add(error(t.span, "`defer` needs the statement it runs when its block is left, on the same line or in an indented block"))
            return Expr(t.span, Invalid)
        val indented = p.at_kind(Indent)
        val body = parse_body(p, true)
        optional_end(p, "defer", indented)
        return Expr(t.span.to(p.ended()), Defer(body))
    if is_keyword(text) then return Expr(t.span, Name(text))
    bare_call(p, Expr(t.span, Name(text)))

/** A value that fills the rest of a line: an expression, or several separated by commas, which
 * make a tuple without parentheses. */
line_value(p: *Parser) -> &Expr
    val first = expression(p, 0)
    if !p.at(",") then return first
    var items: Buf[&Expr] = buf()
    items.push(first)
    while p.accept(",")
        items.push(expression(p, 0))
    saw_tuple(p, items.len())
    Expr(first.span.to(items[items.len() - 1].span), Tuple(items))

/** A statement that fills a line: a value or a tuple, an assignment whose value may be a tuple, or a
 * multiple assignment, `a, b = b, a`, which is a statement and not an expression. */
line_statement(p: *Parser) -> &Expr
    val first = expression(p, 3)
    var items: Buf[&Expr] = buf()
    items.push(first)
    while p.accept(",")
        items.push(expression(p, 3))
    val last = items[items.len() - 1]
    if !p.at_kind(AssignOp)
        if items.len() == 1 then return first
        saw_tuple(p, items.len())
        return Expr(first.span.to(last.span), Tuple(items))
    val at = p.toks.here()
    val spelling = p.spelling(p.toks.advance().unwrap())
    val value = if p.at_kind(Indent) then parse_body(p, false) else line_statement(p)
    if !language_assignment(spelling)
        if items.len() == 1 && !(first.kind is Tuple(_)) then return Expr(first.span.to(value.span), SymbolAssign(first, spelling, value, at))
        p.report.add(error(at, s"`$spelling` calls a method of one target, so a multiple assignment cannot use it"))
        return Expr(first.span.to(value.span), Invalid)
    val (compound, yields) = assign_op(spelling)
    // The places may be written in parentheses: `(a, b) = (b, a)`.
    if items.len() == 1
        if first.kind is Tuple(places)
            items = places
        else return Expr(first.span.to(value.span), Assign(first, compound, value, yields, at))
    if yields then p.report.add(error(at, "a multiple assignment has no `:=` form, since it is a statement and yields nothing"))
    // `while c do a, b = …` would assign to the loop: a list fills a whole line.
    if items[0].kind is While(_, _, _) || items[0].kind is Loop(_) || items[0].kind is If(_, _, _) || items[0].kind is DoWhile(_, _, _) || items[0].kind is For(_, _, _)
        p.report.add(error(items[0].span, "a multiple assignment fills a whole line, so it cannot be the body of a one-line `if` or `while`; indent it on the next line"))
    Expr(first.span.to(value.span), MultiAssign(items, compound, value, at))

// `()` is unit, `(e)` groups, `(a, b)` is a tuple, and `(x, y) -> body` is a lambda.
private parenthesized(p: *Parser, start: Span) -> &Expr
    if lambda_params_ahead(p) then return parse_lambda(p, start)
    if p.accept(")") then return Expr(start.to(p.ended()), UnitLit)
    val outer = p.in_list
    p.in_list = true
    var reported = p.report.len()
    val first = expression(p, 0)
    if !p.at(",")
        if !p.at(")") && !p.toks.at_end() then misread_item(p, None, first, reported)
        p.in_list = outer
        p.expect(")")
        p.grouped.push(first.span)
        return first
    var items: Buf[&Expr] = buf()
    items.push(first)
    while p.accept(",")
        if p.at(")") then break
        reported = p.report.len()
        val item = expression(p, 0)
        items.push(item)
        if !p.at(",") && !p.at(")") && !p.toks.at_end()
            misread_item(p, None, item, reported)
            break
    p.in_list = outer
    val end = p.toks.here()
    p.expect(")")
    saw_tuple(p, items.len())
    Expr(start.to(end), Tuple(items))

/** Notes a tuple of `parts` parts written in the file. */
saw_tuple(p: *Parser, parts: usize)
    if parts > p.widest_tuple then p.widest_tuple = parts

private infix(left: &Expr, t: Spanned[Token], p: *Parser) -> &Expr
    val op = p.spelling(t)
    t.value match
        AssignOp ->
            val value = if p.at_kind(Indent) then parse_body(p, false) else expression(p, 1)
            if !language_assignment(op) then return Expr(left.span.to(value.span), SymbolAssign(left, op, value, t.span))
            val (compound, yields) = assign_op(op)
            Expr(left.span.to(value.span), Assign(left, compound, value, yields, t.span))
        RangeOp ->
            if left.kind is Range(_, _, _)
                p.report.add(error(t.span, "range operators do not chain; parenthesize the intended range"))
            val upper = expression(p, 34)
            Expr(left.span.to(upper.span), Range(left, upper, op == ".."))
        ConsOp ->
            // `::` groups to the right: its right operand takes in a following `::`.
            mixed_grouping(p, left, true, 35, t.span)
            val tail = expression(p, 34)
            mixed_grouping(p, tail, true, 35, t.span)
            Expr(left.span.to(tail.span), Cons(left, tail, t.span))
        CompareOp ->
            var operands: Buf[&Expr] = buf()
            var ops: Buf[CompareOp] = buf()
            operands.push(left)
            ops.push(compare_op(op))
            operands.push(expression(p, 30))
            // A chain goes on across a continuation line: `a < b` then `    < c` is `a < b < c`.
            loop
                val more = p.look() match
                    Some(t) -> t.value == CompareOp
                    None -> false
                if !more then break
                val next = p.take().unwrap()
                ops.push(compare_op(p.spelling(next)))
                operands.push(expression(p, 30))
            Expr(left.span.to(operands[operands.len() - 1].span), Compare(operands, ops))
        IsKeyword ->
            // Directly after `is`, `not` is always the keyword: `x is not(y)` negates the pattern `(y)`.
            val negated = p.accept("not")
            val pattern = parse_pattern(p)
            Expr(left.span.to(pattern.span), Is(left, pattern, negated))
        MatchKeyword -> match_expression(p, left)
        InfixName -> infix_call(left, t, op, p)
        SymbolTight | SymbolMultiply | SymbolAdd | SymbolBitAnd | SymbolBitXor | SymbolBitOr | SymbolCons | SymbolCompare -> symbol_call(left, t, op, p)
        Postfix -> postfix(left, t, op, p)
        _ ->
            // `xs*` with nothing after the `*` in an argument list is a splice, which the checker
            // accepts only as the last argument of a call to a function with a repeated parameter.
            if op == "*" && (p.at(")") || p.at(",")) then return Expr(left.span.to(t.span), Splice(left))
            val right = expression(p, binding(t))
            Expr(left.span.to(right.span), Binary(binary_op(op), left, right, t.span))

// `a max b` calls `max` on `a` with `b`. The argument follows on the same line, or, when the line
// ends with the method's name, as an indented block on the next. There is no postfix form, so a name
// with nothing that can start an argument after it is an error.
private infix_call(left: &Expr, t: Spanned[Token], name: string, p: *Parser) -> &Expr
    for b in p.src.text(Span(left.span.end, t.span.start))
        if b == u8('\n')
            p.report.add(error(t.span, s"an infix call starts on its receiver's line: end that line with `$name` to put the argument on the next"))
            break
    if !p.at_kind(Indent) && (p.at_line_end() || argument_cannot_start(p))
        val receiver = from_utf8_unchecked(p.src.text(left.span))
        p.report.add(error(t.span, s"`$name` has no argument: an infix call takes one, and there is no postfix form; a member is reached with a dot, as `$receiver.$name`, or `$receiver.$name()` for a method declared with an empty parameter list"))
        return Expr(left.span.to(t.span), Invalid)
    val arg = if p.at_kind(Indent) then parse_body(p, false) else expression(p, InfixBinding)
    Expr(left.span.to(arg.span), InfixCall(left, name, t.span, arg))

// `xs ++ ys` calls the method `++` of `xs` with `ys`, with the rules of `a max b`, at the level its
// name gives it (`symbol_token`). Unlike a name, a symbol may start a line, which continues the
// expression above it as any binary operator does. A name ending in `:` groups to the right and
// takes its receiver on the right: `x +: xs` is `xs.+:(x)`, and `a +: b +: xs` is `a +: (b +: xs)`.
// Left- and right-grouping operators do not mix at one level without parentheses.
private symbol_call(left: &Expr, t: Spanned[Token], name: string, p: *Parser) -> &Expr
    if !p.at_kind(Indent) && (p.at_line_end() || argument_cannot_start(p))
        p.report.add(error(t.span, s"`$name` has no right operand: a method named by a symbol is called between two operands, and has no postfix form"))
        return Expr(left.span.to(t.span), Invalid)
    val right = groups_right(name)
    val level = binding(t)
    mixed_grouping(p, left, right, level, t.span)
    val arg = if p.at_kind(Indent) then parse_body(p, false) else expression(p, if right then level - 1 else level)
    if !right then return Expr(left.span.to(arg.span), InfixCall(left, name, t.span, arg))
    mixed_grouping(p, arg, right, level, t.span)
    Expr(left.span.to(arg.span), InfixCall(arg, name, t.span, left))

/** Whether an infix method of this name groups to the right: a symbol ending in `:`. */
groups_right(name: string) -> bool = name.ends_with(":") && is_operator_spelling(name)

// Reports an operand written without parentheses that is an operation at the same level as the
// operator at `at` but grouping the other way: `a ++ b +: c` and `1 :: xs :+ 2` could mean either
// grouping.
private mixed_grouping(p: *Parser, operand: &Expr, right: bool, level: u16, at: Span)
    val (other, other_level, other_right) = operand.kind match
        InfixCall(_, name, _, _) -> (name, call_level(name), groups_right(name))
        Cons(_, _, _) -> ("::", 35u16, true)
        Binary(_, _, _, op_span) ->
            val spelled = from_utf8_unchecked(p.src.text(op_span))
            (spelled, binding(Spanned(operator_token(spelled), op_span)), false)
        _ -> return
    if other_level != level || other_right == right then return
    for g in p.grouped
        if g.start == operand.span.start && g.end == operand.span.end then return
    val own = p.spelling(Spanned(SymbolOp, at))
    val (l, r) = if right then (other, own) else (own, other)
    p.report.add(error(at, s"`$l` groups to the left and `$r` to the right, so they cannot be mixed at one level: add parentheses"))

// Whether the next token only continues an expression, as `==` or `then` does, and cannot begin one.
private argument_cannot_start(p: *Parser) -> bool
    p.toks.peek() match
        Some(next) -> next.value match
            CompareOp | MultiplyOp | AssignOp | AndOp | OrOp | BitOrOp | BitXorOp | BitAndOp | RangeOp | ConsOp | SymbolOp | IsKeyword -> true
            _ -> p.at("then") || p.at("do")
        None -> true

private postfix(left: &Expr, t: Spanned[Token], op: string, p: *Parser) -> &Expr
    if op == "++" || op == "--" then return Expr(left.span.to(t.span), Update(left, op == "++", true, t.span))
    if op == "?" then return Expr(left.span.to(t.span), Propagate(left))
    if op == "[" then return type_application(left, p)
    if op == "(" then return call(left, p)
    if op == "with" then return with_update(left, p)
    member(left, t, p)

// `base with { pos.x = 3, name = "a" }`: the changes, each a path of field names, `=` and a value,
// separated by commas, the last of which may carry one. A brace suspends the off-side rule, so the
// changes may stand one per line.
private with_update(left: &Expr, p: *Parser) -> &Expr
    val open = p.toks.advance().unwrap()
    var changes: Buf[FieldChange] = buf()
    val outer = p.in_list
    p.in_list = true
    var written = false
    loop
        if p.at("}") || p.toks.at_end() then break
        written = true
        if !p.at_kind(Word)
            p.report.add(expected(p.toks.here(), "a field name", found_at(p.src, p.toks.here())))
            skip_change(p)
            if !p.accept(",") then break
            continue
        var path: Buf[string] = buf()
        var spans: Buf[Span] = buf()
        val first = p.toks.advance().unwrap()
        path.push(p.spelling(first))
        spans.push(first.span)
        var broken = false
        while p.accept(".")
            if !p.at_kind(Word)
                p.report.add(expected(p.toks.here(), "a field name after `.`", found_at(p.src, p.toks.here())))
                broken = true
                break
            val name = p.toks.advance().unwrap()
            path.push(p.spelling(name))
            spans.push(name.span)
        if !broken && (p.at("(") || p.at("["))
            val written = from_utf8_unchecked(p.src.text(first.span.to(spans[spans.len() - 1])))
            p.report.add(error(p.toks.here(), s"`with` changes fields, and an element is not a field: replace the whole field, `$written = value`"))
            broken = true
        if !broken && !p.at("=")
            if p.at_kind(AssignOp)
                p.report.add(error(p.toks.here(), s"a change in `with` is written `field = value`, and `${p.ahead(0)}` is not `=`"))
            else p.report.add(expected(p.toks.here(), "`=` after the field's name", found_at(p.src, p.toks.here())))
            broken = true
        if broken
            skip_change(p)
            if !p.accept(",") then break
            continue
        p.toks.advance()
        val value = expression(p, 0)
        changes.push(FieldChange(first.span.to(value.span), path, spans, value))
        if !p.accept(",") then break
    p.in_list = outer
    val end = p.toks.here()
    if !written && p.at("}") then p.report.add(error(open.span.to(end), "`with` changes at least one field: name it, as in `with { x = 1 }`"))
    p.expect("}")
    Expr(left.span.to(end), With(left, changes))

// Skips the rest of a change that could not be read, up to the comma or brace that ends it.
private skip_change(p: *Parser)
    var depth = 0
    loop
        if p.toks.at_end() then return
        val word = p.ahead(0)
        if depth == 0 && (word == "," || word == "}") then return
        if word == "(" || word == "[" || word == "{" then depth += 1
        if word == ")" || word == "]" || word == "}" then depth -= 1
        p.toks.advance()

private type_application(left: &Expr, p: *Parser) -> &Expr
    var args: Buf[&TypeExpr] = buf()
    if p.at("]") then p.report.add(error(p.toks.here(), "expected at least one type argument"))
    else
        loop
            args.push(parse_type(p))
            if !p.accept(",") || p.at("]") then break
    // Without its `]` the application ends at its last argument, so the token the bracket was
    // expected at stays outside it, as the next expression's part.
    val end = if p.at("]") then p.toks.here() else if args.len() > 0 then args[args.len() - 1].span else left.span
    p.expect("]")
    bare_call(p, Expr(left.span.to(end), TypeApply(left, args)))

private call(left: &Expr, p: *Parser) -> &Expr
    var args: Buf[Argument] = buf()
    val outer = p.in_list
    p.in_list = true
    if !p.at(")")
        loop
            val start = p.toks.here()
            var name: Option[string] = None
            if p.at_kind(Word) && p.ahead(1) == "="
                reject_keyword(p, p.toks.here(), p.ahead(0), "an argument")
                name = Some(p.spelling(p.toks.advance().unwrap()))
                p.toks.advance()
            val reported = p.report.len()
            val value = placeholder_scope(p, expression(p, 0))
            args.push(Argument(start.to(value.span), name, value, false))
            if !p.at(",") && !p.at(")") && !p.toks.at_end()
                misread_item(p, Some(callee_name(left)), value, reported)
                break
            if !p.accept(",") || p.at(")") then break
    p.in_list = outer
    var end = p.toks.here()
    p.expect(")")
    trailing_block(p, true) match
        Some(block) ->
            args.push(Argument(block.span, None, block, true))
            end = block.span
        None -> ()
    Expr(left.span.to(end), Call(left, args))

// An item of a parenthesized list, a call's argument (`callee` is the name the call is written
// with, or empty) or a part of a group or tuple (`None`), followed by something other than `,` or
// `)`. The mistake is reported once, saying what was meant where the token shows it, and the rest
// of the list is skipped up to its `)`, so the expression and the statement around it are read on
// as written. An item that already reported an error, or a `=>` the lexer reported, adds nothing.
private misread_item(p: *Parser, callee: Option[string], value: &Expr, reported: usize)
    val at = p.toks.here()
    if p.report.len() > reported || p.at("=>") then ()
    elif p.at("->")
        val message = if callee is Some(name) && name.ends_with("Map")
            s"write a map as `{\"a\": 1}`: a key and its value are joined by `:` inside braces, not by `->`"
        else "`->` does not pair two values: write a pair as `(a, b)`, and a map as `{\"a\": 1}`"
        p.report.add(error(at, message))
    elif p.at(":") && value.kind is Name(_) && lambda_arrow_ahead(p) is Some(arrow)
        // `x: int -> body`: a lambda whose typed parameter lacks its parentheses.
        val item = from_utf8_unchecked(p.src.text(value.span))
        val first = p.toks.peek_at(1).unwrap().span
        val last = p.toks.peek_at(arrow - 1).unwrap().span
        val shown = from_utf8_unchecked(p.src.text(first.to(last)))
        if p.report.len() == reported then p.report.add(error(at.to(last), s"a lambda's parameter with a type is written in parentheses: `($item: $shown) -> …`"))
    elif p.at(":")
        p.toks.advance()
        val written = parse_type(p)
        val item = from_utf8_unchecked(p.src.text(value.span))
        val shown = from_utf8_unchecked(p.src.text(written.span))
        val rest = if p.at(",") then ", …" else ""
        val message = callee match
            Some(name) ->
                if name == "" then s"an argument is not given a type: give the type argument of the function it is passed to, `[$shown]`"
                else s"an argument is not given a type: give the type argument instead, as in `$name[$shown]($item$rest)`"
            None -> s"an expression is not given a type: declare the value with it, as in `val x: $shown = $item`"
        if p.report.len() == reported then p.report.add(error(at.to(written.span), message))
    else p.report.add(expected(at, "`)`", found_at(p.src, at)))
    var depth = 0
    loop
        if p.toks.at_end() then return
        val word = p.ahead(0)
        if depth == 0 && word == ")" then return
        if word == "(" || word == "[" || word == "{" then depth += 1
        if word == ")" || word == "]" || word == "}" then depth -= 1
        p.toks.advance()

// How many tokens ahead of the `:` the parser is at stands the `->` (or `=>`) of a lambda whose
// typed parameter was written without parentheses, `x: int -> body`: an arrow at the list's own
// bracket depth, after at least one token of the type, before the `,` or `)` that ends the item.
private lambda_arrow_ahead(p: *Parser) -> Option[usize]
    var depth = 0
    var i = 1usize
    loop
        val word = p.toks.peek_at(i) match
            Some(t) -> p.spelling(t)
            None -> return None
        if depth == 0 && (word == "," || word == ")") then return None
        if depth == 0 && i > 1 && (word == "->" || word == "=>") then return Some(i)
        if word == "(" || word == "[" || word == "{" then depth += 1
        if word == ")" || word == "]" || word == "}" then depth -= 1
        i += 1

// The name a call's callee is written with: `f` in `f(x)` and `f[T](x)`, `foldLeft` in
// `xs.foldLeft(…)`; empty for a callee that is not a name.
private callee_name(callee: &Expr) -> string = callee.kind match
    Name(name) -> name
    Member(_, name) -> name
    TypeApply(target, _) -> callee_name(target)
    _ -> ""

/** A placeholder lambda: where `value` holds `_`, each `_` is a parameter of its own, in the order
 * written, and `value` is the body of a lambda of them, so `_ + _` is `(a, b) -> a + b`. A `_` is
 * found through operators, member access, tuple parts, `is`, `with`'s base and a call's callee, and
 * through a call's argument that is `_` alone, which is left for the expression around that call:
 * `f(_, 2) + 1` is `x -> f(x, 2) + 1`. Every other argument and every lambda, block, `if` and
 * `match` keeps its own `_`. A value that is `_` alone is no lambda of its own. Where the lambda
 * would only call a named function with its parameters in order, `f(_)`, it is that function, which
 * is passed as `f`. */
placeholder_scope(p: *Parser, value: &Expr) -> &Expr
    if value.kind is Name("_") then return value
    var params: Buf[LambdaParam] = buf()
    val body = with_placeholders(value, &params)
    if params.len() == 0 then return value
    if forwarding_name(body, params.len()) is Some(name)
        var blanks = "_"
        for _ in 1..<params.len()
            blanks = blanks + ", _"
        p.report.add(error(value.span, s"`$name($blanks)` is the function `$name` itself; pass it as `$name`"))
        return Expr(value.span, Invalid)
    Expr(value.span, Lambda(params, body))

// The name of the function a placeholder lambda's body only calls, with all of its `count`
// parameters as the arguments in order and nothing else: a lowercase name, as functions are named.
private forwarding_name(body: &Expr, count: usize) -> Option[string]
    val (callee, args) = body.kind match
        Call(f, a) -> (f, a)
        _ -> return None
    val name = callee.kind match
        Name(n) -> n
        _ -> return None
    if name.starts_with("_$") || args.len() != count then return None
    val first = name.bytes[0]
    if !(u8('a') <= first <= u8('z')) then return None
    for a in args
        if a.block || a.name is Some(_) then return None
    Some(name)

// `e` with each `_` it holds, through the forms `placeholder_scope` names, made a reference to a
// fresh parameter added to `params`.
private with_placeholders(e: &Expr, params: *Buf[LambdaParam]) -> &Expr
    e.kind match
        Name(n) ->
            if n != "_" then return e
            val name = "_$" + (params.len() + 1).to_string()
            params.push(LambdaParam(e.span, name, None))
            Expr(e.span, Name(name))
        Unary(op, operand) -> Expr(e.span, Unary(op, with_placeholders(operand, params)))
        Binary(op, left, right, at) ->
            val l = with_placeholders(left, params)
            val r = with_placeholders(right, params)
            Expr(e.span, Binary(op, l, r, at))
        Compare(operands, ops) ->
            var items: Buf[&Expr] = buf()
            for x in operands
                items.push(with_placeholders(x, params))
            Expr(e.span, Compare(items, ops))
        Range(lower, upper, inclusive) ->
            val l = with_placeholders(lower, params)
            val u = with_placeholders(upper, params)
            Expr(e.span, Range(l, u, inclusive))
        Cons(head, tail, at) ->
            val h = with_placeholders(head, params)
            val t = with_placeholders(tail, params)
            Expr(e.span, Cons(h, t, at))
        Is(value, pattern, negated) -> Expr(e.span, Is(with_placeholders(value, params), pattern, negated))
        Propagate(value) -> Expr(e.span, Propagate(with_placeholders(value, params)))
        Member(target, name) -> Expr(e.span, Member(with_placeholders(target, params), name))
        TupleIndex(target, index) -> Expr(e.span, TupleIndex(with_placeholders(target, params), index))
        TypeApply(target, args) -> Expr(e.span, TypeApply(with_placeholders(target, params), args))
        With(base, changes) -> Expr(e.span, With(with_placeholders(base, params), changes))
        Tuple(items) ->
            var parts: Buf[&Expr] = buf()
            for x in items
                parts.push(with_placeholders(x, params))
            Expr(e.span, Tuple(parts))
        // A name ending in `:` is written after its argument, so that argument's `_` comes first.
        InfixCall(target, name, at, arg) ->
            if groups_right(name)
                val a = with_placeholders(arg, params)
                return Expr(e.span, InfixCall(with_placeholders(target, params), name, at, a))
            val t = with_placeholders(target, params)
            Expr(e.span, InfixCall(t, name, at, with_placeholders(arg, params)))
        Call(callee, args) ->
            val f = with_placeholders(callee, params)
            var rewritten: Buf[Argument] = buf()
            for a in args
                if !a.block && a.value.kind is Name("_")
                    rewritten.push(Argument(a.span, a.name, with_placeholders(a.value, params), false))
                else rewritten.push(a)
            Expr(e.span, Call(f, rewritten))
        _ -> e

// A name, a member or a type application with no parentheses after it is called with a trailing
// block alone: `scope` and an indented block, or `scope s ->` and one.
private bare_call(p: *Parser, callee: &Expr) -> &Expr
    val block = trailing_block(p, false) match
        Some(b) -> b
        None -> return callee
    var args: Buf[Argument] = buf()
    args.push(Argument(block.span, None, block, true))
    Expr(callee.span.to(block.span), Call(callee, args))

/** A trailing block: the call's line ends, and an indented block on the lines after it is the call's
 * last argument. The line may instead end with a lambda's parameters and `->`, one name or, after a
 * call's parentheses, a parenthesized list, and the block is that lambda's body. Nothing is taken in
 * the header of a form whose body follows, or where the indented line reads as the method and
 * argument of an infix call continued from the line above. */
private trailing_block(p: *Parser, parenthesized: bool) -> Option[&Expr]
    if p.in_header then return None
    if p.at_kind(Indent)
        if infix_line_ahead(p) || p.continues_line() is Some(_) then return None
        return Some(parse_body(p, false))
    if p.at_kind(Word) && !is_keyword(p.ahead(0)) && p.ahead(1) == "->" && arrow_ends_line(p, 1)
        val name = p.toks.advance().unwrap()
        p.toks.advance()
        var params: Buf[LambdaParam] = buf()
        params.push(LambdaParam(name.span, p.spelling(name), None))
        val body = parse_body(p, false)
        return Some(Expr(name.span.to(body.span), Lambda(params, body)))
    if parenthesized && p.at("(")
        var depth = 0
        var i = 0usize
        loop
            val token = p.toks.peek_at(i) match
                Some(t) -> t
                None -> return None
            if token.value == Newline || token.value == Dedent || token.value == Indent then return None
            val word = p.spelling(token)
            if word == "(" then depth += 1
            elif word == ")"
                depth -= 1
                if depth == 0 then break
            i += 1
        if p.ahead(i + 1) != "->" || !arrow_ends_line(p, i + 1) then return None
        val open = p.toks.advance().unwrap()
        return Some(parse_lambda(p, open.span))
    None

// Whether the `->` at `offset` ends its line, an indented block after it, and is not the arrow that
// ends a match guard.
private arrow_ends_line(p: *Parser, offset: usize) -> bool
    if p.lambda_boundary == Some(p.toks.position + offset) then return false
    p.toks.peek_at(offset + 1) match
        Some(t) -> t.value == Indent
        None -> false

// Whether the indented line ahead is only a name and one operand, `add 2`: the method and argument
// of an infix call that should have been continued from the line above, which is reported as that.
private infix_line_ahead(p: *Parser) -> bool
    val name = p.toks.peek_at(1) match
        Some(t) -> t
        None -> return false
    if name.value != Word || is_keyword(p.spelling(name)) then return false
    val operand = p.toks.peek_at(2) match
        Some(t) -> t
        None -> return false
    val single = operand.value match
        Word -> !is_keyword(p.spelling(operand))
        Number | RealNumber | Quoted | Interpolated | CharQuoted -> true
        _ -> false
    if !single then return false
    p.toks.peek_at(3) match
        Some(t) -> t.value == Newline || t.value == Dedent
        None -> true

/** An expression in the header of a form whose indented body follows it, which no trailing block
 * attaches to. */
header_expression(p: *Parser) -> &Expr
    val outer = p.in_header
    p.in_header = true
    val e = expression(p, 0)
    p.in_header = outer
    e

// `t.name` is a member; `t.0` is a tuple element. The lexer reads `t.0.1` as `t` `.` `0.1`, so a
// real-number spelling after a dot is split back into two element indices.
private member(left: &Expr, t: Spanned[Token], p: *Parser) -> &Expr
    val next = p.toks.advance() match
        Some(n) -> n
        None ->
            p.report.add(expected(p.toks.here(), "a member name", "the end of input"))
            return Expr(left.span.to(t.span), Invalid)
    val text = p.spelling(next)
    next.value match
        Word -> bare_call(p, Expr(left.span.to(next.span), Member(left, text)))
        Number -> Expr(left.span.to(next.span), TupleIndex(left, element_index(p, next.span, text)))
        RealNumber ->
            var target = left
            var start = 0usize
            for i in 0..text.bytes.len
                if i == text.bytes.len || text.bytes[i] == u8('.')
                    target = Expr(left.span.to(next.span), TupleIndex(target, element_index(p, next.span, text[start..<i])))
                    start = i + 1
            target
        _ ->
            // A method named by a symbol is reached as any other: `xs.++(ys)`.
            if is_operator_spelling(text) then return Expr(left.span.to(next.span), Member(left, text))
            p.report.add(expected(next.span, "a member name", found_at(p.src, next.span)))
            Expr(left.span.to(next.span), Invalid)

private element_index(p: *Parser, at: Span, digits: string) -> usize
    var value = 0usize
    if digits.bytes.len == 0 then p.report.add(error(at, "expected a tuple element index"))
    for b in digits.bytes
        if b < u8('0') || b > u8('9')
            p.report.add(error(at, "a tuple element index is a decimal number"))
            return 0
        value = value * 10 + usize(b - u8('0'))
    value

// Only an unparenthesized name directly followed by `:` is a map-key shorthand: `{a: 1}` means
// `{"a": 1}`.
private collection_key(p: *Parser, braces: bool) -> &Expr
    if braces && p.at_kind(Word) && p.ahead(1) == ":"
        val key = p.toks.advance().unwrap()
        return Expr(key.span, StringLit(p.spelling(key)))
    expression(p, 0)

private collection(p: *Parser, start: Span, braces: bool) -> &Expr
    val close = if braces then "}" else "]"
    var keys: Buf[&Expr] = buf()
    var values: Buf[&Expr] = buf()
    var map = false
    val outer = p.in_list
    p.in_list = true
    if !p.at(close)
        loop
            val before = p.toks.position
            val key = collection_key(p, braces)
            val entry = braces && p.accept(":")
            if keys.len() == 0 then map = entry
            elif map != entry then p.report.add(error(key.span, "a collection literal cannot mix set elements and map entries"))
            keys.push(key)
            if entry then values.push(expression(p, 0))
            if p.toks.position == before then break
            if !p.accept(",") || p.at(close) then break
    p.in_list = outer
    val end = p.toks.here()
    p.expect(close)
    val span = start.to(end)
    if !braces then Expr(span, ListLit(keys))
    elif map then Expr(span, MapLit(keys, values))
    else Expr(span, SetLit(keys))
end collection

// The opening parenthesis has been consumed. Only a matching `)` followed by `->` makes a
// parameter list; grouped expressions and tuples stay expressions.
private lambda_params_ahead(p: *Parser) -> bool
    var depth = 1
    var i = 0usize
    loop
        val token = p.toks.peek_at(i) match
            Some(t) -> t
            None -> return false
        val word = p.spelling(token)
        if word == "(" then depth += 1
        elif word == ")"
            depth -= 1
            if depth == 0
                if p.lambda_boundary == Some(p.toks.position + i + 1) then return false
                return p.ahead(i + 1) == "->"
        if token.value == Dedent || token.value == Newline then return false
        i += 1
    false

private parse_lambda(p: *Parser, at: Span) -> &Expr
    var params: Buf[LambdaParam] = buf()
    if !p.accept(")")
        loop
            val start = p.toks.here()
            val name = declared_name(p, "a parameter")
            var declared: Option[&TypeExpr] = None
            if p.accept(":") then declared = Some(parse_type(p))
            params.push(LambdaParam(start.to(p.ended()), name, declared))
            if !p.accept(",") || p.at(")") then break
        p.expect(")")
    p.expect("->")
    val body = parse_body(p, false)
    Expr(at.to(body.span), Lambda(params, body))

// The top-level arrow ends a match guard; arrows inside brackets or nested blocks can still
// introduce lambdas.
match_guard_boundary(p: *Parser) -> Option[usize]
    var depth = 0
    var i = 0usize
    loop
        val token = p.toks.peek_at(i) match
            Some(t) -> t
            None -> return None
        val word = p.spelling(token)
        if depth == 0
            if word == "->" then return Some(p.toks.position + i)
            if token.value == Newline || token.value == Dedent then return None
        if word == "(" || word == "[" || word == "{" || token.value == Indent then depth += 1
        elif word == ")" || word == "]" || word == "}" || token.value == Dedent
            if depth == 0 then return None
            depth -= 1
        i += 1
    None

private unary_op(text: string) -> Option[UnaryOp]
    if text == "-" then Some(Negate)
    elif text == "+" then Some(Plus)
    elif text == "!" then Some(Not)
    elif text == "~" then Some(Complement)
    else None

private binary_op(text: string) -> BinaryOp
    if text == "+" then Add
    elif text == "-" then Subtract
    elif text == "*" then Multiply
    elif text == "/" then Divide
    elif text == "%" then Remainder
    elif text == "<<" then ShiftLeft
    elif text == ">>" then ShiftRight
    elif text == "+%" then AddWrapping
    elif text == "-%" then SubtractWrapping
    elif text == "*%" then MultiplyWrapping
    elif text == "+|" then AddSaturating
    elif text == "-|" then SubtractSaturating
    elif text == "*|" then MultiplySaturating
    elif text == "&" then BitAnd
    elif text == "|" then BitOr
    elif text == "^" then BitXor
    elif text == "&&" then And
    else Or

private compare_op(text: string) -> CompareOp
    if text == "==" then Equal
    elif text == "!=" then NotEqual
    elif text == "===" then Same
    elif text == "!==" then NotSame
    elif text == "<" then Less
    elif text == "<=" then LessEqual
    elif text == ">" then Greater
    else GreaterEqual

/** Whether `name` is one of the integers' bitwise or shift operators that a method of another type
 * may be named: `&`, `^`, `|`, `~` between two operands, `<<` and `>>`. */
bitwise_method_name(name: string) -> bool = name == "&" || name == "^" || name == "|" || name == "~" || name == "<<" || name == ">>"

/** Whether `name` is one of the arithmetic or ordering operators that a method of a data type, a
 * class or a trait may be named: `+`, `-`, `*`, `/`, `%`, `<`, `<=`, `>` and `>=`. */
arithmetic_method_name(name: string) -> bool
    for op in ["+", "-", "*", "/", "%", "<", "<=", ">", ">="]
        if name == op then return true
    false

/** The operators of the language that have compound assignment forms, `+=` and `+:=`. */
compound_operator(text: string) -> bool
    for op in ["+", "-", "*", "/", "%", "<<", ">>", "+%", "-%", "*%", "+|", "-|", "*|", "&", "|", "^"]
        if text == op then return true
    false

// Whether an assignment's spelling is the language's own: `=`, `:=`, or one of them after an
// operator that has compound forms. Any other spelling is a method's name (`++=`).
private language_assignment(text: string) -> bool
    if text == "=" || text == ":=" then return true
    if text.ends_with(":=") && compound_operator(text[0..<text.bytes.len - 2]) then return true
    compound_operator(text[0..<text.bytes.len - 1])

// `=` and `:=` assign plainly; any other spelling is an operator followed by `=` or `:=`.
private assign_op(text: string) -> (Option[BinaryOp], bool)
    val yields = text.ends_with(":=")
    val operator = if yields then text[0..<text.bytes.len - 2] else text[0..<text.bytes.len - 1]
    if operator == "" then (None, yields) else (Some(binary_op(operator)), yields)
