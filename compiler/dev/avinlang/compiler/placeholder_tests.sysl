module dev.avinlang.compiler
@tests

import sh.sysl.parsing.source_of

// A placeholder lambda written where no function is expected is reported once, as a `_` whose type
// nothing gives, and is no function of errors meeting the type expected; a branch of an `if` or a
// `match` in a placeholder's place checks as a lambda written there does.

/** The diagnostics `avin check` renders for `text`, or "" when it compiles. */
private placeholder_diagnostics(text: string) -> string = lower_source(repository_toolchain(), source_of("probe.avin", text)) match
    Ok(_) -> ""
    Err(d) -> d

@test("a placeholder lambda where no function is expected is reported once, with no function of errors")
placeholder_without_function()
    val declared = placeholder_diagnostics("main() -> int\n  val n: int = _ + 1\n  n\n")
    assert(declared.contains("cannot infer the type of this `_`"))
    assert(!declared.contains("<error>"))
    val branch = placeholder_diagnostics("count(c: bool) -> int = if c then _ + 1 else 0\n\nmain() -> int = count(true)\n")
    assert(branch.contains("cannot infer the type of this `_`"))
    assert(!branch.contains("<error>"))
    assert(!branch.contains("agree on no type"))
    val arm = placeholder_diagnostics("pick(n: int) -> string = n match\n  0 -> _.toString()\n  _ -> \"x\"\n\nmain() -> int = pick(0).byteLength\n")
    assert(arm.contains("cannot infer the type of this `_`"))
    assert(!arm.contains("<error>"))

@test("a branch in a placeholder's place checks as a lambda written there")
placeholder_branches_check()
    assert_eq(placeholder_diagnostics("main() -> int\n  val f: (int) -> int = if true then _ + 1 else _ - 1\n  f(1) - 2\n"), "")
    assert_eq(placeholder_diagnostics("inc(n: int) -> (int) -> int = n match\n  0 -> _ + 1\n  _ -> _ + n\n\nmain() -> int = inc(0)(-1)\n"), "")
    // An arm yielding no function meets the declared type as any value does.
    assert(placeholder_diagnostics("main() -> int\n  val f: (int) -> int = 1 match\n    1 -> _ + 1\n    _ -> 5\n  0\n").contains("this arm yields int"))
