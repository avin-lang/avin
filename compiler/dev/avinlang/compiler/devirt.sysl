module dev.avinlang.compiler

import sysl.buf.{Buf, buf}

// Calls through a method table made direct where the whole program shows which method runs.
//
// It runs on the finished program, once every descriptor and every method table is known. A call
// through a table is rewritten in one of two ways, each of which runs exactly the method the table
// would have given:
//
// - A direct call, when the receiver's descriptor is known where the call is made, or when every
//   descriptor of every type that conforms to the receiver's static type holds one and the same method
//   at the call's position. The receiver's descriptor is known for an object made in the function, one
//   read back from a local slot that only ever holds objects of one descriptor, and one returned by a
//   function that only ever returns objects of one descriptor.
// - A guarded call, when the types the receiver's static type admits hold a few different methods: the
//   receiver's descriptor is compared with each of theirs, a match calls its method directly, and any
//   other object takes the method from its table as before. A direct call can be inlined, and a test of
//   a descriptor that does not change in a loop can be taken out of it.

/** A call through a method table that lowering made, in the function at index `function`, whose code
 * is the value `code`: what the whole program shows of the objects it can reach. `single` is the one
 * method every possible receiver runs, if there is one. `guards` pairs each descriptor of a type the
 * call's static receiver type admits with the method its table holds at the call's position. */
struct DispatchSite
    function: usize
    code: usize
    single: Option[usize]
    guards: Buf[DispatchGuard]

struct DispatchGuard
    descriptor: usize
    function: usize

/** The most methods, and the most descriptors, a guarded call tests for. */
const MaxGuardedMethods: usize = 8
const MaxGuards: usize = 16
/** The most instructions, terminators included, a method a guarded call calls directly may have: a
 * larger one would not be inlined, and a test before a call that stays a call costs about what the
 * load from the table it replaces does. */
const MaxGuardedSize: usize = 40

// What is known of a value's object: not yet determined, unknown, or the descriptor `d`, held as
// `d + Known`. A value starts undetermined and only moves down: to one descriptor, then to unknown.
private const Undetermined: usize = 0
private const Unknown: usize = 1
private const Known: usize = 2

private meet(a: usize, b: usize) -> usize
    if a == Undetermined then return b
    if b == Undetermined || a == b then return a
    Unknown

/** The program's functions with their calls through method tables made direct or guarded where they
 * can be. `sites` is ordered by function. */
//
// What it decided at each call through a table is all its rewriting of a function depends on beyond
// the function's own code: `facts` gets that, for each function in order, one line per call, so the
// function's instance key can name it.
devirtualize(functions: Buf[MirFunction], descriptors: Buf[Descriptor], sites: Buf[DispatchSite], facts: *Buf[string]) -> Buf[MirFunction]
    var summaries: Buf[DevirtSummary] = buf()
    for f in functions
        summaries.push(devirt_summary(f))
    val n = functions.len()
    // What each function returns, from what the functions it calls return, until nothing changes.
    var returns: Buf[usize] = buf()
    for _ in 0..<n do returns.push(Undetermined)
    var changed = true
    while changed
        changed = false
        for i in 0..<n
            val r = atoms_state(summaries[i].returns, returns)
            if r != returns[i]
                returns[i] = r
                changed = true
    val callees = callees_of(functions)
    var out: Buf[MirFunction] = buf()
    var s = 0usize
    for i in 0..<n
        var own: Buf[DispatchSite] = buf()
        while s < sites.len() && sites[s].function == i
            own.push(sites[s])
            s += 1
        // A function that calls through no table is left as it is.
        if summaries[i].receivers.len() == 0
            out.push(functions[i])
            facts.push("")
            continue
        var decided = ""
        out.push(rewrite(functions[i], receiver_states(functions[i], summaries[i], returns), own, descriptors, callees, &decided))
        facts.push(decided)
    out

// What is known of a value's object, as the function alone shows it: the meet of a set of atoms, each
// an object of one descriptor, what one function returns, or unknown. An empty set is not yet
// determined. A parameter is unknown; an allocation is its descriptor's object; a call's result is
// what its callee returns; a slot is followed only while its address is used for nothing but loading
// and storing it (an address passed on lets another function store to it), and a value loaded from it
// is whatever was stored there; anything else is unknown. Given what every function returns, the
// meet of a value's set is what is known of it; so a function's summary is found once, and the whole
// program's fixed point is found over the summaries.

/** The atom of what is unknown. */
private const UnknownAtom: usize = 1

/** The atom of an object of descriptor `d`. */
private descriptor_atom(d: usize) -> usize = 2 + 2 * d

/** The atom of what function `g` returns. */
private returned_atom(g: usize) -> usize = 3 + 2 * g

/** A function's summary: the atoms of what it returns, and of the object of each of its calls through
 * a method table, in the order of its `MethodSlot` instructions. */
private struct DevirtSummary
    returns: Buf[usize]
    receivers: Buf[Buf[usize]]

/** The meet of `atoms`, given what each function returns. */
private atoms_state(atoms: Buf[usize], returns: Buf[usize]) -> usize
    var state = Undetermined
    for a in atoms
        val s = if a == UnknownAtom then Unknown elif a % 2 == 0 then (a - 2) / 2 + Known else returns[(a - 3) / 2]
        state = meet(state, s)
        if state == Unknown then return Unknown
    state

/** Adds the atoms of `more` to `set`, keeping each once and only the unknown atom once it is there;
 * answers whether `set` grew. */
private join_atoms(set: *Buf[usize], more: Buf[usize]) -> bool
    if set.len() == 1 && (*set)[0] == UnknownAtom then return false
    var grew = false
    for a in more
        if a == UnknownAtom
            set.clear()
            set.push(UnknownAtom)
            return true
        var seen = false
        for x in *set
            if x == a then seen = true
        if !seen
            set.push(a)
            grew = true
    grew

/** The set holding the one atom `a`. */
private atom_set(a: usize) -> Buf[usize]
    var set: Buf[usize] = buf()
    set.push(a)
    set

private operand_atoms(atoms: Buf[Buf[usize]], o: Operand) -> Buf[usize] = o match
    Value(id) -> atoms[id]
    ConstObject(d) -> atom_set(descriptor_atom(d))
    ConstData(_, d) -> atom_set(descriptor_atom(d))
    _ -> atom_set(UnknownAtom)

/** `f`'s summary: each value's atoms, found until nothing changes. */
private devirt_summary(f: MirFunction) -> DevirtSummary
    var atoms: Buf[Buf[usize]] = buf()
    for _ in 0..<f.value_types.len() do atoms.push(buf())
    for i in 0..<f.signature.params.len()
        atoms[i] = atom_set(UnknownAtom)
    var slots: Buf[Buf[usize]] = buf()
    for _ in 0..<f.slots.len() do slots.push(buf())
    for block in f.blocks
        for inst in block.insts
            val operands = inst_operands(inst)
            for k in 0..<operands.len()
                if operands[k] is SlotAddress(x)
                    if !(k == 0 && (inst is Load(_, _) || inst is Store(_, _))) then slots[x] = atom_set(UnknownAtom)
        block.term match
            Return(Some(SlotAddress(x))) -> slots[x] = atom_set(UnknownAtom)
            Branch(SlotAddress(x), _, _) -> slots[x] = atom_set(UnknownAtom)
            _ -> ()
    var changed = true
    while changed
        changed = false
        for block in f.blocks
            for inst in block.insts
                if inst is Store(SlotAddress(x), v)
                    var set = slots[x]
                    if join_atoms(&set, operand_atoms(atoms, v))
                        slots[x] = set
                        changed = true
                    continue
                val dest = inst_dest(inst) match
                    Some(d) -> d
                    None -> continue
                val more: Buf[usize] = inst match
                    Alloc(_, d) -> atom_set(descriptor_atom(d))
                    Call(_, Direct(g), _) -> atom_set(returned_atom(g))
                    Load(_, SlotAddress(x)) -> slots[x]
                    _ -> atom_set(UnknownAtom)
                var set = atoms[dest]
                if join_atoms(&set, more)
                    atoms[dest] = set
                    changed = true
    var returned: Buf[usize] = buf()
    var receivers: Buf[Buf[usize]] = buf()
    for block in f.blocks
        for inst in block.insts
            if inst is MethodSlot(_, object, _) then receivers.push(operand_atoms(atoms, object))
        if block.term is Return(Some(v)) then _ = join_atoms(&returned, operand_atoms(atoms, v))
    DevirtSummary(returned, receivers)

/** The states `rewrite` reads of `f`: each object of a call through a table, from its atoms. */
private receiver_states(f: MirFunction, s: DevirtSummary, returns: Buf[usize]) -> Buf[usize]
    var states: Buf[usize] = buf()
    for _ in 0..<f.value_types.len() do states.push(Undetermined)
    var k = 0usize
    for block in f.blocks
        for inst in block.insts
            if inst is MethodSlot(_, Value(id), _) then states[id] = atoms_state(s.receivers[k], returns)
            if inst is MethodSlot(_, _, _) then k += 1
    states

/** The number of instructions of each function, and its signature. */
private callees_of(functions: Buf[MirFunction]) -> Callees
    var sizes: Buf[usize] = buf()
    var signatures: Buf[MirSignature] = buf()
    var symbols: Buf[string] = buf()
    for f in functions
        var n = 0usize
        for block in f.blocks
            n += block.insts.len() + 1
        sizes.push(n)
        signatures.push(f.signature)
        symbols.push(f.symbol)
    Callees(sizes, signatures, symbols)

private operand_state(states: Buf[usize], o: Operand) -> usize = o match
    Value(id) -> states[id]
    ConstObject(d) -> d + Known
    ConstData(_, d) -> d + Known
    _ -> Unknown

/** How a call through a method table is made: unchanged, directly, or guarded by its receiver's
 * descriptor. */
private enum Target
    Unchanged
    DirectTo(function: usize)
    Guarded(guards: Buf[DispatchGuard])

/** What the program knows of each function: its size and its signature. */
private struct Callees
    sizes: Buf[usize]
    signatures: Buf[MirSignature]
    symbols: Buf[string]

private machine_key(t: MirType) -> string = t match
    MInt(bits) -> s"i$bits"
    MBool -> "bool"
    MReal -> "real"
    MPtr -> "address"
    MRef -> "reference"

/** Whether a function of signature `s` can be called where the call was spelled with `wanted`. An
 * override whose result is `Nothing` returns nothing, where the method it overrides returns a value;
 * such a call stays through the table. */
private fits(s: MirSignature, wanted: MirSignature) -> bool
    if s.params.len() != wanted.params.len() then return false
    for i in 0..<s.params.len()
        if machine_key(s.params[i]) != machine_key(wanted.params[i]) then return false
    s.result match
        Some(a) -> wanted.result match
            Some(b) -> machine_key(a) == machine_key(b)
            None -> false
        None -> wanted.result is None

private target_of(object: Operand, position: usize, code: usize, wanted: MirSignature, states: Buf[usize], sites: Buf[DispatchSite], descriptors: Buf[Descriptor], callees: Callees) -> Target
    val known = operand_state(states, object)
    if known >= Known
        val methods = descriptors[known - Known].methods
        if position < methods.len()
            if methods[position] is Some(g)
                if fits(callees.signatures[g], wanted) then return DirectTo(g)
                return Unchanged
    for site in sites
        if site.code != code then continue
        if site.single is Some(g)
            if fits(callees.signatures[g], wanted) then return DirectTo(g)
            return Unchanged
        if site.guards.len() == 0 || site.guards.len() > MaxGuards then return Unchanged
        var methods: Buf[usize] = buf()
        for guard in site.guards
            var seen = false
            for m in methods
                if m == guard.function then seen = true
            if !seen then methods.push(guard.function)
        if methods.len() > MaxGuardedMethods then return Unchanged
        for m in methods
            if callees.sizes[m] > MaxGuardedSize || !fits(callees.signatures[m], wanted) then return Unchanged
        return Guarded(site.guards)
    Unchanged

/** What was decided at a call through table position `position`, one line naming the methods and
 * descriptors by their symbols. */
private decision_text(position: usize, target: Target, descriptors: Buf[Descriptor], callees: Callees) -> string = target match
    Unchanged -> s"$position table\n"
    DirectTo(g) -> s"$position direct ${callees.symbols[g]}\n"
    Guarded(guards) ->
        var out = s"$position guarded"
        for guard in guards
            out = out + s" ${descriptors[guard.descriptor].name}=${callees.symbols[guard.function]}"
        out + "\n"

/** The index of the call in `insts`, after `from`, of the code value `code`. */
private call_of(insts: Buf[Inst], from: usize, code: usize) -> Option[usize]
    for j in from + 1..<insts.len()
        if insts[j] is Call(_, Indirect(Value(c), _), _)
            if c == code then return Some(j)
    None

private rewrite(f: MirFunction, states: Buf[usize], sites: Buf[DispatchSite], descriptors: Buf[Descriptor], callees: Callees, decided: *string) -> MirFunction
    var values: Buf[MirType] = buf()
    for t in f.value_types do values.push(t)
    var slots: Buf[MirType] = buf()
    for t in f.slots do slots.push(t)
    var blocks: Buf[MirBlock] = buf()
    for block in f.blocks do blocks.push(block)
    // The code values whose call becomes a direct call of the paired function.
    var direct_codes: Buf[usize] = buf()
    var direct_functions: Buf[usize] = buf()
    // The blocks that take the method from the table when no guard matched, which stay as they are.
    var fallbacks: Buf[usize] = buf()
    var b = 0usize
    while b < blocks.len()
        var fallback = false
        for x in fallbacks
            if x == b then fallback = true
        if fallback
            b += 1
            continue
        val block = blocks[b]
        var insts: Buf[Inst] = buf()
        var i = 0usize
        var split = false
        while i < block.insts.len()
            val inst = block.insts[i]
            if inst is MethodSlot(code, object, position)
                if call_of(block.insts, i, code) is Some(j)
                    val wanted = block.insts[j] match
                        Call(_, Indirect(_, s), _) -> s
                        _ -> panic("a call through a method table that is not an indirect call")
                    val target = target_of(object, position, code, wanted, states, sites, descriptors, callees)
                    *decided = *decided + decision_text(position, target, descriptors, callees)
                    target match
                        DirectTo(g) ->
                            direct_codes.push(code)
                            direct_functions.push(g)
                            i += 1
                            continue
                        Guarded(guards) ->
                            for k in i + 1..<j
                                insts.push(block.insts[k])
                            fallbacks.push(guard_call(&values, &slots, &blocks, b, insts, block, i, j, guards))
                            split = true
                            break
                        Unchanged -> ()
            if inst is Call(dest, Indirect(Value(c), _), args)
                var redirected = false
                for k in 0..<direct_codes.len()
                    if direct_codes[k] == c
                        insts.push(Call(dest, Direct(direct_functions[k]), args))
                        redirected = true
                        break
                if redirected
                    i += 1
                    continue
            insts.push(inst)
            i += 1
        if !split then blocks[b] = MirBlock(insts, block.term)
        b += 1
    MirFunction(f.symbol, f.signature, values, slots, blocks)

// Replaces the call at `j` of block `b`, through the method table entry made at `i`, with a test of
// the receiver's descriptor against each guard's, in turn: a match calls the guard's method directly;
// no match takes the method from the table. The result is kept in a slot of its own, which the block
// after the call reads, and that block goes on with the rest of the original one. A call whose value
// the block returns at once, a call in tail position, returns from each of its calls instead, so each
// stays a tail call (see `tail_call_at` in `emit.sysl`). Answers the block that calls through the
// table.
private guard_call(values: *Buf[MirType], slots: *Buf[MirType], blocks: *Buf[MirBlock], b: usize, before: Buf[Inst], block: MirBlock, i: usize, j: usize, guards: Buf[DispatchGuard]) -> usize
    val (code, object, position) = block.insts[i] match
        MethodSlot(c, o, p) -> (c, o, p)
        _ -> panic("a guarded call that is not through a method table")
    val (dest, signature, args) = block.insts[j] match
        Call(d, Indirect(_, s), a) -> (d, s, a)
        _ -> panic("a guarded call that is not an indirect call")
    var methods: Buf[usize] = buf()
    for guard in guards
        var seen = false
        for m in methods
            if m == guard.function then seen = true
        if !seen then methods.push(guard.function)
    val result: Option[usize] = dest match
        Some(d) ->
            val s = slots.len()
            slots.push((*values)[d])
            Some(s)
        None -> None
    // The blocks this makes, in order: a test for each guard after the first, a call of each method,
    // the call through the table, and the rest of the original block.
    val base = blocks.len()
    val tests = base
    val calls = tests + guards.len() - 1
    val fallback = calls + methods.len()
    val join = fallback + 1
    var head = before
    val descriptor = values.len()
    values.push(MPtr)
    head.push(DescriptorOf(descriptor, object))
    var heads: Buf[MirBlock] = buf()
    for k in 0..<guards.len()
        val cond = values.len()
        values.push(MBool)
        var insts: Buf[Inst] = if k == 0 then head else buf()
        insts.push(Compare(cond, CmpEq, Value(descriptor), DescriptorAddress(guards[k].descriptor)))
        var call = calls
        for m in 0..<methods.len()
            if methods[m] == guards[k].function then call = calls + m
        val next = if k + 1 < guards.len() then tests + k else fallback
        heads.push(MirBlock(insts, Branch(Value(cond), call, next)))
    (*blocks)[b] = heads[0]
    for k in 1..<heads.len()
        blocks.push(heads[k])
    val returns_value = block.term match
        Return(Some(Value(v))) -> dest == Some(v)
        Return(None) -> dest is None
        _ -> false
    val returned = returns_value && j + 1 == block.insts.len()
    for m in methods
        var insts: Buf[Inst] = buf()
        if returned then blocks.push(returning_call(values, insts, dest, Direct(m), args))
        else
            result_call(values, &insts, dest, result, Direct(m), args)
            blocks.push(MirBlock(insts, Jump(join)))
    var insts: Buf[Inst] = buf()
    insts.push(MethodSlot(code, object, position))
    if returned
        blocks.push(returning_call(values, insts, dest, Indirect(Value(code), signature), args))
        return fallback
    result_call(values, &insts, dest, result, Indirect(Value(code), signature), args)
    blocks.push(MirBlock(insts, Jump(join)))
    var rest: Buf[Inst] = buf()
    if dest is Some(d) && result is Some(s) then rest.push(Load(d, SlotAddress(s)))
    for k in j + 1..<block.insts.len()
        rest.push(block.insts[k])
    blocks.push(MirBlock(rest, block.term))
    fallback

/** A block of `insts` and then a call of `callee`, which returns what the call returns. */
private returning_call(values: *Buf[MirType], insts: Buf[Inst], dest: Option[usize], callee: Callee, args: Buf[Operand]) -> MirBlock
    var out = insts
    dest match
        Some(d) ->
            val v = values.len()
            values.push((*values)[d])
            out.push(Call(Some(v), callee, args))
            MirBlock(out, Return(Some(Value(v))))
        None ->
            out.push(Call(None, callee, args))
            MirBlock(out, Return(None))

/** A call of `callee` whose result, if it has one, is stored in slot `result`. */
private result_call(values: *Buf[MirType], insts: *Buf[Inst], dest: Option[usize], result: Option[usize], callee: Callee, args: Buf[Operand])
    dest match
        Some(d) ->
            val v = values.len()
            values.push((*values)[d])
            insts.push(Call(Some(v), callee, args))
            insts.push(Store(SlotAddress(result.unwrap()), Value(v)))
        None -> insts.push(Call(None, callee, args))
