module dev.avinlang.compiler
@tests

import sysl.fs.{entries, exists, is_link, make_dir_all, make_temp_dir, read_text, remove_dir_all, symlink, write_bytes, write_text}
import sysl.buf.{Buf, buf}
import sysl.process.{Exited, capture}
import sysl.time.now

private struct Run
    status: int
    said: string
    noted: string

private avin(args: []const string) -> Run
    var said = ""
    var noted = ""
    val status = run_cli(args, Some(repository_toolchain()), s -> said = said + s + "\n", s -> noted = noted + s + "\n")
    Run(status, said, noted)

@test("help and version go to the output channel and succeed")
help_and_version()
    val help = avin(["avin", "--help"])
    assert_eq(help.status, 0)
    assert(help.said.starts_with("usage: avin "))
    assert_eq(help.noted, "")
    val version = avin(["avin", "--version"])
    assert_eq(version.status, 0)
    assert_eq(version.said, "avin " + Version + "\n")

@test("an incorrect invocation prints the usage to the error channel and exits 2")
usage_errors()
    refused(["avin", "emit-llvm", "x.avin"])
    refused(["avin", "emit-llvm"])
    refused(["avin", "build", "x.avin", "-o"])
    refused(["avin", "build", "x.avin", "--bad", "out"])
    refused(["avin", "check", "x.avin", "-o", "out"])

private refused(args: []const string)
    val run = avin(args)
    assert_eq(run.status, 2)
    assert_eq(run.said, "")
    assert(run.noted.starts_with("usage: avin "))

@test("parse and check report success, and source errors exit 1 with diagnostics")
front_end_commands()
    val dir = make_temp_dir("avin-cli").unwrap()
    defer _ = remove_dir_all(dir)
    val good = dir + "/good.avin"
    write_text(good, "main() = 42\n").unwrap()
    assert_eq(avin(["avin", "parse", good]).said, "parsed 1 declarations\n")
    assert_eq(avin(["avin", "check", good]).said, "checked " + good + "\n")
    val bad = dir + "/bad.avin"
    write_text(bad, "main() = missing\n").unwrap()
    val failed = avin(["avin", "check", bad])
    assert_eq(failed.status, 1)
    assert_eq(failed.said, "")
    assert(failed.noted.contains("`missing` is not defined"))
    val absent = avin(["avin", "check", dir + "/absent.avin"])
    assert_eq(absent.status, 1)
    assert(absent.noted.contains("absent.avin"))
    val invalid = dir + "/invalid.avin"
    write_bytes(invalid, [u8(0xff)]).unwrap()
    assert_eq(avin(["avin", "check", invalid]).status, 1)

@test("without a toolchain, commands that compile say how to provide one")
missing_toolchain()
    val dir = make_temp_dir("avin-cli").unwrap()
    defer _ = remove_dir_all(dir)
    val good = dir + "/good.avin"
    write_text(good, "main() = 42\n").unwrap()
    var noted = ""
    val status = run_cli(["avin", "check", good], None, s -> (), s -> noted = noted + s)
    assert_eq(status, 1)
    assert(noted.contains("AVIN_ROOT"))
    assert_eq(run_cli(["avin", "parse", good], None, s -> (), s -> ()), 0)

@test("build writes a runnable executable to a path with spaces and shell characters")
build_and_run()
    val dir = make_temp_dir("avin-cli").unwrap()
    defer _ = remove_dir_all(dir)
    val source = dir + "/source with spaces; $x.avin"
    write_text(source, "main() -> int\n    println(\"built\")\n    42\n").unwrap()
    val binary = dir + "/out put; $y"
    val built = avin(["avin", "build", source, "-o", binary])
    assert_eq(built.noted, "")
    assert_eq(built.status, 0)
    val run = capture(binary, stderr = true, timeout = 10000).unwrap()
    assert(run.status == Exited(42))
    assert_eq(run.text, "built\n")
    val ir = dir + "/program.ll"
    assert_eq(avin(["avin", "emit-llvm", source, "-o", ir]).status, 0)
    assert(read_text(ir).unwrap().contains("define i32 @main(i32 %argc, ptr %argv)"))

// The text of the program's function `name` in `ir`, from its `define` to its closing brace.
private function_text(ir: string, name: string) -> string = definition_text(ir, "<program>." + name)

// The text of the function whose symbol is `symbol` in `ir`. A call of the function names it the
// same way, so the definition is the mention whose line opens a body.
private definition_text(ir: string, symbol: string) -> string
    val key = "@\"" + symbol + "\"("
    var from = 0usize
    var start = 0usize
    var found = false
    while !found
        start = ir.index_of_from(key, from) match
            Some(i) -> i
            None -> return ""
        ir.index_of_from("\n", start) match
            Some(e) -> found = ir.bytes[e - 1] == u8('{')
            None -> return ""
        from = start + 1
    val end = ir.index_of_from("\n}\n", start) match
        Some(e) -> e
        None -> ir.bytes.len
    ir.slice(start, end)

private polls_in(text: string) -> usize = text.count_of("call void @avin_rt_safepoint(ptr %ctx)")

@test("safepoint polls sit on every back edge and before the calls that may recur, and nowhere else")
safepoint_polls()
    val dir = make_temp_dir("avin-cli").unwrap()
    defer _ = remove_dir_all(dir)
    val source = dir + "/polls.avin"
    write_text(source, "count(n: int) -> int\n    var i = 0\n    var s = 0\n    while i < n\n        s = s + i\n        i = i + 1\n    s\n\nnested(n: int) -> int\n    var t = 0\n    var i = 0\n    while i < n\n        var j = 0\n        do\n            t = t + j\n            j = j + 1\n        while j < i\n        i = i + 1\n    t\n\nleaf(x: int) -> int = if x > 0 then x + 1 else x - 1\n\nfib(n: int) -> int = if n < 2 then n else fib(n - 1) + fib(n - 2)\n\nisEven(n: int) -> bool = if n == 0 then true else isOdd(n - 1)\n\nisOdd(n: int) -> bool = if n == 0 then false else isEven(n - 1)\n\napply(f: (int) -> int, x: int) -> int = f(x)\n\ndown(n: int) -> int = if n <= 0 then 0 else apply(down, n - 1) + 1\n\ninc(x: int) -> int = x + 1\n\ntwice(g: (int) -> int) -> int = g(g(1))\n\nmain() -> int = count(leaf(3)) + nested(4) + fib(10) - 55 + (if isEven(6) then 0 else 1) + apply(down, 5) - 5 + twice(inc) - 3\n").unwrap()
    val out = dir + "/polls.ll"
    val emitted = avin(["avin", "emit-llvm", source, "-o", out])
    assert_eq(emitted.noted, "")
    val ir = read_text(out).unwrap()
    assert(ir.contains("@avin_rt_requested = external global i32"))
    assert(ir.contains("declare void @avin_rt_safepoint(ptr) cold"))
    assert(ir.contains("load atomic i32, ptr @avin_rt_requested monotonic"))
    // The slow path is weighted as almost never taken, so the poll falls through.
    assert(ir.contains(", !prof !0\n"))
    assert(ir.contains("!0 = !{!\"branch_weights\", i32 1, i32 1048575}"))
    // A loop with no call polls on its back edge only; two nested loops poll on each back edge.
    assert_eq(polls_in(function_text(ir, "count")), 1usize)
    assert_eq(polls_in(function_text(ir, "nested")), 2usize)
    // A caller that cannot be called back never polls, nor does a function with neither calls nor
    // loops.
    assert_eq(polls_in(function_text(ir, "main")), 0usize)
    assert_eq(polls_in(function_text(ir, "leaf")), 0usize)
    // A recursion polls once per level: before the first recursive call, which every path to the
    // second passes, and in each function of a mutual recursion.
    assert_eq(polls_in(function_text(ir, "fib")), 1usize)
    assert_eq(polls_in(function_text(ir, "isEven")), 1usize)
    assert_eq(polls_in(function_text(ir, "isOdd")), 1usize)
    // A function reached only as a value, which recurses through a call of that value: both the
    // call through the value and the call that passes it may recur.
    assert_eq(polls_in(function_text(ir, "down")), 1usize)
    assert_eq(polls_in(function_text(ir, "apply")), 1usize)
    // A call through a value polls only when some function that is a value can call back.
    assert_eq(polls_in(function_text(ir, "twice")), 0usize)
    val binary = dir + "/polls"
    assert_eq(avin(["avin", "build", source, "-o", binary]).status, 0)
    assert(capture(binary, stderr = true, timeout = 10000).unwrap().status == Exited(10))

@test("a call sets the caller site only where it may enter the core library, which keeps it across calls out")
caller_sites()
    val dir = make_temp_dir("avin-cli").unwrap()
    defer _ = remove_dir_all(dir)
    val source = dir + "/sites.avin"
    write_text(source, "inc(n: int) -> int = n + 1\n\ntwiceInc(n: int) -> int = inc(inc(n))\n\nmake(n: int) -> int = Array.fill(n, 0).length()\n\napply(f: (int) -> int, x: int) -> int = f(x)\n\nsquares(n: int) -> int = Array.tabulate(n, i -> i * i).length()\n\nmain() -> int = twiceInc(1) + make(2) + apply(inc, 3) + squares(3) - 12\n").unwrap()
    val out = dir + "/sites.ll"
    val emitted = avin(["avin", "emit-llvm", source, "-o", out])
    assert_eq(emitted.noted, "")
    val ir = read_text(out).unwrap()
    // The program's functions take no parameter beyond the context and their own.
    assert(ir.contains("define internal tailcc i32 @\"<program>.inc\"(ptr %ctx, i32 %v0) {"))
    assert(ir.contains("define internal tailcc i32 @\"<program>.apply\"(ptr %ctx, ptr %v0, i32 %v1) {"))
    // A call between the program's own functions touches no caller site.
    assert(!function_text(ir, "twiceInc").contains("%caller.site"))
    // A direct call into the library sets the site to the call's place, as does a call of a value,
    // which may be the library's.
    assert_eq(function_text(ir, "make").count_of(", ptr %caller.site\n"), 1usize)
    assert(function_text(ir, "make").contains("store ptr @avin.trap."))
    assert_eq(function_text(ir, "apply").count_of(", ptr %caller.site\n"), 1usize)
    // The library traps at its caller, and a library call of the library leaves the site alone.
    val fill = definition_text(ir, "avin.object Array.fill[int]")
    assert(fill.contains("call void @avin_rt_caller_trap(ptr %ctx, "))
    assert(!fill.contains("@avin_rt_trap("))
    assert(!fill.contains("%caller.site"))
    // A library call of a function value, which may be the program's, keeps the site across it.
    val tabulate = definition_text(ir, "avin.object Array.tabulate[int]")
    assert_eq(tabulate.count_of(" = load ptr, ptr %caller.site\n"), 1usize)
    assert_eq(tabulate.count_of(", ptr %caller.site\n"), 2usize)
    assert(!tabulate.contains("store ptr @avin.trap."))
    // A trap in the program's own code reports its own place.
    assert(function_text(ir, "inc").contains("call void @avin_rt_trap(ptr %ctx, "))

@test("a failed build leaves existing output untouched and never overwrites the source")
output_protection()
    val dir = make_temp_dir("avin-cli").unwrap()
    defer _ = remove_dir_all(dir)
    val artifact = dir + "/previous"
    write_text(artifact, "previous output").unwrap()
    val bad = dir + "/bad.avin"
    write_text(bad, "main() = missing\n").unwrap()
    assert_eq(avin(["avin", "build", bad, "-o", artifact]).status, 1)
    assert_eq(avin(["avin", "emit-llvm", bad, "-o", artifact]).status, 1)
    assert_eq(read_text(artifact).unwrap(), "previous output")
    val good = dir + "/good.avin"
    write_text(good, "main() = 42\n").unwrap()
    val alias = dir + "/alias.avin"
    symlink(good, alias).unwrap()
    for command in ["build", "emit-llvm"]
        assert_eq(avin(["avin", command, good, "-o", good]).status, 2)
        assert_eq(avin(["avin", command, good, "-o", alias]).status, 2)
        assert(is_link(alias))
        assert_eq(read_text(good).unwrap(), "main() = 42\n")
    assert_eq(avin(["avin", "build", good, "-o", dir]).status, 1)

@test("a directory is a program's root: every file under it is compiled, each in its directory's module")
build_directory()
    val dir = make_temp_dir("avin-cli").unwrap()
    defer _ = remove_dir_all(dir)
    val root = dir + "/program"
    make_dir_all(root + "/tools/sharp").unwrap()
    make_dir_all(root + "/.hidden").unwrap()
    write_text(root + "/main.avin", "import tools.sharp.edge\nmain() -> int = edge() + 1\n").unwrap()
    write_text(root + "/tools/sharp/edge.avin", "module tools.sharp\nedge() -> int = blade\n").unwrap()
    write_text(root + "/tools/sharp/blade.avin", "module tools.sharp\nprivate val blade = 41\n").unwrap()
    // A directory whose name begins with `.` is not part of the program.
    write_text(root + "/.hidden/broken.avin", "this is not Avin\n").unwrap()
    write_text(root + "/notes.txt", "not a source file\n").unwrap()
    assert_eq(avin(["avin", "parse", root]).said, "parsed 3 declarations\n")
    assert_eq(avin(["avin", "check", root]).said, "checked " + root + "\n")
    val binary = dir + "/program.out"
    val built = avin(["avin", "build", root, "-o", binary])
    assert_eq(built.noted, "")
    assert_eq(built.status, 0)
    val run = capture(binary, stderr = true, timeout = 10000).unwrap()
    assert(run.status == Exited(42))
    val empty = dir + "/empty"
    make_dir_all(empty).unwrap()
    val nothing = avin(["avin", "check", empty])
    assert_eq(nothing.status, 1)
    assert(nothing.noted.contains("no `.avin` or `.lavin` files"))
    assert_eq(default_output("/tmp/a/program"), "program")

@test("the default output is the source's name without its extension, in the working directory")
default_output_name()
    assert_eq(default_output("examples/hello.avin"), "hello")
    assert_eq(default_output("/tmp/a/hello.world.avin"), "hello.world")

// The names in the toolchain's shim cache, or none where it does not exist yet.
private shim_archives() -> Buf[string]
    var names: Buf[string] = buf()
    if entries(repository_toolchain().shim_cache()) is Ok(found)
        for n in found do names.push(n)
    names

@test("check builds no shim archive for a valid Sysl binding, and check --bindings builds it")
check_builds_no_shims()
    val dir = make_temp_dir("avin-cli").unwrap()
    defer _ = remove_dir_all(dir)
    val file = dir + "/bound.avin"
    // Archives are keyed by their shim's text, so a name no earlier run used keeps the archive from existing already.
    val name = s"checkStopsEarlyLower${now().us}"
    write_text(file, "@sysl(\"sysl.text.to_lower\")\n" + name + "(s: string) -> string\n\nmain() = 0\n").unwrap()
    val before = shim_archives().len()
    val checked = avin(["avin", "check", file])
    assert_eq(checked.status, 0)
    assert_eq(checked.said, "checked " + file + "\n")
    assert_eq(shim_archives().len(), before)
    val deep = avin(["avin", "check", file, "--bindings"])
    assert_eq(deep.status, 0)
    assert_eq(deep.said, "checked " + file + "\n")
    assert(shim_archives().len() > before)

@test("check accepts a Sysl binding Sysl would reject, and check --bindings reports it")
check_bindings_flag_reports_sysl_rejection()
    val dir = make_temp_dir("avin-cli").unwrap()
    defer _ = remove_dir_all(dir)
    val file = dir + "/mismatch.avin"
    write_text(file, "main() = 0\n\n@sysl(\"sysl.text.to_upper\")\ncheckStopsEarlyShout(s: char) -> string\n").unwrap()
    val before = shim_archives().len()
    assert_eq(avin(["avin", "check", file]).status, 0)
    assert_eq(shim_archives().len(), before)
    val deep = avin(["avin", "check", file, "--bindings"])
    assert_eq(deep.status, 1)
    assert_eq(deep.said, "")
    assert(deep.noted.contains("the Sysl binding `checkStopsEarlyShout` does not match `sysl.text.to_upper`"))
    assert_eq(shim_archives().len(), before)

@test("check reports a C binding that names no header, with or without --bindings")
check_reports_headerless_c_binding()
    val dir = make_temp_dir("avin-cli").unwrap()
    defer _ = remove_dir_all(dir)
    val file = dir + "/c.avin"
    write_text(file, "@c(\"int abs(int)\")\nabs(n: int) -> int\n\nmain()\n    println(abs(-1))\n").unwrap()
    val plain = avin(["avin", "check", file])
    val deep = avin(["avin", "check", file, "--bindings"])
    for run in [plain, deep]
        assert_eq(run.status, 1)
        assert_eq(run.said, "")
        assert(run.noted.contains("the C binding `abs` is checked against the headers a package's manifest names under `c-libraries`"))

@test("check still reports type errors with --bindings, and the flag belongs to check alone")
check_bindings_flag_scope()
    val dir = make_temp_dir("avin-cli").unwrap()
    defer _ = remove_dir_all(dir)
    val bad = dir + "/bad.avin"
    write_text(bad, "main() = missing\n").unwrap()
    val run = avin(["avin", "check", bad, "--bindings"])
    assert_eq(run.status, 1)
    assert(run.noted.contains("`missing` is not defined"))
    refused(["avin", "build", bad, "--bindings"])
    refused(["avin", "check", bad, "--bindings", "--bindings"])
