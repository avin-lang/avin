module dev.avinlang.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}

// An option of a type whose values are references is one pointer: `Some(x)` is `x` and `None` is
// null, so neither allocates. A program that takes such an option as another type with no conversion
// keeps every option an object, whose `Some` is allocated.

private const Pick: string = "class Dog(val name: string) derives Display\n\npick(n: int, d: Dog) -> Option[Dog] = if n > 0 then Some(d) else None\n\nboxed(o: Option[Dog]) -> Any = o\n\nmain()\n    val d = Dog(\"rex\")\n    val o = pick(1, d)\n    println(o.map(x -> x.name).getOrElse(\"none\"))\n    println(boxed(o) == boxed(o))\n"

/** The module a program compiles to. */
private ir_of(text: string) -> string
    val program = lower_source(repository_toolchain(), source_of("probe.avin", text)) match
        Ok(p) -> p
        Err(d) -> panic(d)
    emit_llvm(program)

/** The body of the function whose symbol is `symbol`. */
private body(ir: string, symbol: string) -> string
    var out = ""
    var inside = false
    for line in ir.split("\n")
        if line.starts_with("define ") && line.contains("@\"" + symbol + "\"(") then inside = true
        elif inside
            if line == "}" then return out
            out = out + line + "\n"
    out

/** Whether `pick` of the program `Pick` followed by `extra` makes its `Some` as an object. */
private allocates(extra: string) -> bool = body(ir_of(Pick + extra), "<program>.pick").contains("avin_rt_alloc")

@test("Some of an object is the object itself and None is null, so neither allocates")
some_allocates_nothing()
    val pick = body(ir_of(Pick), "<program>.pick")
    assert(!pick.contains("avin_rt_alloc"), pick)
    assert(!pick.contains("@\"avin.obj:"), pick)
    assert(pick.contains("null"), pick)

@test("an option boxed into an Any becomes the object it stands for")
boxing_makes_the_object()
    val boxed = body(ir_of(Pick), "<program>.boxed")
    assert(boxed.contains("avin_rt_alloc"), boxed)
    assert(boxed.contains("@\"avin.obj:"), boxed)

@test("an option of an int and an option of an option stay objects")
value_options_are_objects()
    val ir = ir_of("first(n: int) -> Option[int] = if n > 0 then Some(n) else None\n\nnested(n: int) -> Option[Option[string]] = if n > 0 then Some(Some(s\"x$n\")) else Some(None)\n\nmain()\n    println(first(1).getOrElse(0))\n    println(nested(1).isDefined())\n")
    assert(body(ir, "<program>.first").contains("avin_rt_alloc"), ir)
    val nested = body(ir, "<program>.nested")
    assert(nested.contains("avin_rt_alloc"), nested)

@test("an option inside a list seen as a list of Any keeps every option an object")
list_view_keeps_objects()
    assert(allocates("\nwide(xs: List[Option[Dog]]) -> List[Any] = xs\n"))

@test("an option of an option seen as an option of Any keeps every option an object")
nested_view_keeps_objects()
    assert(allocates("\nwide(o: Option[Option[Dog]]) -> Option[Any] = o\n"))

@test("an option seen as a trait keeps every option an object")
trait_view_keeps_objects()
    assert(allocates("\nshown(o: Option[Dog]) -> Display = o\n"))

@test("a function yielding an option seen as one yielding Any keeps every option an object")
function_view_keeps_objects()
    assert(allocates("\nwide(f: () -> Option[Dog]) -> () -> Any = f\n"))

@test("a type pattern on Any that may find an option inside an object keeps every option an object")
open_pattern_keeps_objects()
    assert(allocates("\ncount(a: Any) -> int = a match\n    l: List[Any] -> l.length\n    _ -> 0\n"))

@test("an option of a subclass seen as one of its superclass, and a pattern on an option's own type, keep pointers")
pointer_views_keep_pointers()
    assert(!allocates("\nopen class Animal\nclass Cat : Animal\n\nwide(o: Option[Cat]) -> Option[Animal] = o\n\nfind(a: Any) -> bool = a match\n    o: Option[Dog] -> o.isDefined()\n    _ -> false\n"))

@test("an option's own lower-bounded methods keep pointers where every call widens a pointer to a pointer")
lower_bounds_keep_pointers()
    assert(!allocates("\nopen class Animal\nclass Cat : Animal\n\nwiden(o: Option[Cat], a: Animal) -> Animal = o.orElse(Some(a)).getOrElse(a)\n\nhas(o: Option[Cat], a: Animal) -> bool = o.contains(a)\n"))

// An `Option[Nothing]` is always `None`, so where it meets an option kept as a pointer it converts to
// null, and no view of it keeps the program's options objects.

@test("a module value None used as an option of a class keeps pointers")
module_none_keeps_pointers()
    assert(!allocates("\nval none = None\n\nfirst(n: int, d: Dog) -> Option[Dog] = if n > 0 then Some(d) else none\n\nnamed(o: Option[Dog]) -> string = o.map(x -> x.name).getOrElse(\"none\")\n\npassed() -> string = named(none)\n\nheld() -> bool\n    var o: Option[Dog] = none\n    o = none\n    o.isEmpty()\n"))

@test("a function returning Option[Nothing] used as an option of a class or a string keeps pointers")
nothing_function_keeps_pointers()
    assert(!allocates("\nnothing() -> Option[Nothing] = None\n\nlater() -> Option[Dog] = nothing()\n\nchosen(n: int, d: Dog) -> Option[Dog] = n match\n    0 -> nothing()\n    _ -> Some(d)\n\nkept(o: Option[Dog]) -> Option[Dog] = o.orElse(nothing())\n\nstrict(o: Option[string]) -> bool = o.contains(\"x\") || o == nothing()\n\njoined(n: int, d: Dog) -> Option[Dog]\n    val x = if n > 0 then nothing() else Some(d)\n    x\n"))

@test("an Option[Nothing] inside an Either or a Result keeps pointers where it is written as the option wanted")
nothing_in_either_keeps_pointers()
    assert(!allocates("\nval none = None\n\nwrapped() -> Result[Option[Dog], string] = Ok(none)\n\nside() -> Either[Option[Dog], int] = Left(none)\n"))

@test("an Option[Nothing] among the elements of a collection of options of a class keeps pointers")
nothing_elements_keep_pointers()
    assert(!allocates("\nval none = None\n\nmany(d: Dog) -> Vector[Option[Dog]] = [Some(d), none]\n\nfirstNone(d: Dog) -> Vector[Option[Dog]] = [none, Some(d)]\n\nlisted(d: Dog) -> List[Option[Dog]] = List(none, Some(d))\n\nsettled(d: Dog) -> int = List(none, Some(d), none).length + List(none, none).length()\n"))

// Inside another value an `Option[Nothing]` cannot be converted, so it takes the form of the options
// it is seen as there: null where they are pointers, an object where they are objects.

@test("a collection of Option[Nothing] seen as one of options of a class or a string keeps pointers")
nothing_inside_collection_keeps_pointers()
    assert(!allocates("\nval nones = [None, None]\n\nall() -> Vector[Option[Dog]] = nones\n\ntexts() -> List[Option[string]] = List(None)\n\nlisted() -> List[Option[Dog]] = texts().map(o -> None)\n"))

@test("a Result of Option[Nothing] seen as a Result of an option of a class keeps pointers")
nothing_inside_result_keeps_pointers()
    assert(!allocates("\nnothingOk() -> Result[Option[Nothing], string] = Ok(None)\n\nwide() -> Result[Option[Dog], string] = nothingOk()\n\nnothingErr() -> Result[int, Option[Nothing]] = Ok(1)\n\nwideErr() -> Result[int, Option[string]] = nothingErr()\n"))

@test("a function yielding or taking Option[Nothing] seen as one yielding or taking an option of a class keeps pointers")
nothing_function_value_keeps_pointers()
    assert(!allocates("\nnothing() -> Option[Nothing] = None\n\nmaker() -> () -> Option[Dog] = nothing\n\nnamed(o: Option[Dog]) -> int = 0\n\ntaker() -> (Option[Nothing]) -> int = named\n"))

@test("an Option[Nothing] nested deeper, in an option, a data field, a tuple, a map value or a vector of vectors, keeps pointers")
nothing_nested_deeper_keeps_pointers()
    assert(!allocates("\ndata Box[+T](item: T)\n\ninner() -> Option[Option[Nothing]] = Some(None)\n\ninnerDog() -> Option[Option[Dog]] = inner()\n\nboxed() -> Box[Option[Dog]] = Box[Option[Nothing]](None)\n\npair() -> (Option[Nothing], int) = (None, 1)\n\npairDog() -> (Option[Dog], int) = pair()\n\ntable() -> Map[string, Option[Nothing]] = {\"a\": None}\n\ntableDog() -> Map[string, Option[Dog]] = table()\n\ndeeper() -> Vector[Vector[Option[Nothing]]] = [[None]]\n\ndeeperDog() -> Vector[Vector[Option[string]]] = deeper()\n"))

@test("Option[Nothing] kept as a pointer is null, and making one allocates nothing")
nothing_is_null()
    val ir = ir_of("class Dog(val name: string)\n\nnothing() -> Option[Nothing] = None\n\nall() -> Vector[Option[Dog]] = [nothing()]\n\nmain()\n    println(all().length)\n")
    val made = body(ir, "<program>.nothing")
    assert(!made.contains("@\"avin.obj:"), made)
    assert(made.contains("null"), made)

@test("an Option[Nothing] seen inside another value as an option of an int keeps it an object and options of classes pointers")
nothing_as_value_option_keeps_pointers()
    assert(!allocates("\nval nones = [None, None]\n\ncounts() -> Vector[Option[int]] = nones\n\nlayered() -> Result[Option[Option[Dog]], string] = Ok(None)\n\nwrapped() -> Result[Option[Nothing], string] = Ok(None)\n\nwide() -> Result[Option[real], string] = wrapped()\n"))

@test("an Option[Nothing] seen inside other values both as an option of a class and as one of an int keeps every option an object")
nothing_seen_both_ways_keeps_objects()
    assert(allocates("\nval nones = [None, None]\n\ndogs() -> Vector[Option[Dog]] = nones\n\ncounts() -> Vector[Option[int]] = nones\n"))
    assert(allocates("\nnothingOk() -> Result[Option[Nothing], string] = Ok(None)\n\nwide() -> Result[Option[Dog], string] = nothingOk()\n\ninner() -> Option[Option[Nothing]] = Some(None)\n\nnested() -> Option[Option[int]] = inner()\n"))

@test("an Option[Nothing] inside another value seen as an option of a type parameter keeps every option an object")
nothing_as_type_parameter_option_keeps_objects()
    assert(allocates("\nwidened[T](xs: Vector[Option[Nothing]]) -> Vector[Option[T]] = xs\n\nused() -> int = widened[Dog]([None]).length\n"))

@test("a lower-bounded call that widens an option inside an option to Any keeps every option an object")
lower_bound_to_any_keeps_objects()
    assert(allocates("\nwiden(o: Option[Option[Dog]], a: Any) -> Any = o.getOrElse(a)\n"))
