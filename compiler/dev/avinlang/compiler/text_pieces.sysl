module dev.avinlang.compiler

import sysl.buf.{Buf, buf}
import sysl.slices.copy
import sysl.text.str_view

/** **Text gathered as the strings it is made of, and joined once at its exact length.** A builder
 * that grows by doubling holds up to twice the text while it grows, and its `finish` copies the whole
 * of it again; a module's text runs to hundreds of megabytes, so that is paid in hundreds of
 * megabytes. Here a piece is held as the string it already is (a slice of a larger string shares its
 * bytes), and `finish` makes one buffer of the sum of their lengths, copies each piece in, and hands
 * that buffer out as the string without copying it again. */
struct TextPieces
    parts: Buf[string]
    size: usize

    /** Adds `s` after what is there; an empty string adds nothing. */
    push(*self, s: string)
        if s.bytes.len == 0 then return
        self.parts.push(s)
        self.size += s.bytes.len

    /** The length in bytes of the text gathered so far. */
    len(self) -> usize = self.size

    /** The pieces joined, in the order they were pushed. */
    finish(self) -> string
        if self.size == 0 then return ""
        var bytes: []u8 = [0; self.size]
        var at: usize = 0
        for p in self.parts
            val n = p.bytes.len
            _ = copy(bytes[at..<at + n], p.bytes)
            at += n
        // Every piece is a whole string, so the bytes are UTF-8, and nothing writes them once the
        // string is made: the buffer is this function's alone.
        str_view(bytes)

text_pieces() -> TextPieces = TextPieces(buf(), 0)
