module dev.avinlang.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}

// What a method derived through a template costs: the code written for the type's fields calls the
// visitor's hooks directly, each compiled for one field type, with no call through a method table,
// no lookup and no boxing. The visitor, a data value that never leaves the method, is kept as its
// fields once the walk and the hooks are inlined, so the derived method allocates nothing, as a
// hand-written encoder does not.

private lowered(text: string) -> MirProgram = lower_source(repository_toolchain(), source_of("probe.avin", text)) match
    Ok(p) -> p
    Err(d) -> panic(d)

private function_of(program: MirProgram, name: string) -> MirFunction
    for f in program.functions
        if f.symbol == "<program>." + name then return f
    panic("no function " + name)

/** How a function's calls are made and what it allocates. */
private struct Cost
    through_tables: int
    entries: int
    compared: int
    allocations: int
    direct: Buf[string]

private cost_of(program: MirProgram, name: string) -> Cost = cost_of_function(program, function_of(program, name))

private cost_of_function(program: MirProgram, f: MirFunction) -> Cost
    var tables = 0
    var entries = 0
    var compared = 0
    var allocations = 0
    var direct: Buf[string] = buf()
    for block in f.blocks
        for inst in block.insts
            inst match
                MethodSlot(_, _, _) -> tables = tables + 1
                CallEntry(_, _) -> entries = entries + 1
                Compare(_, CmpEq, _, DescriptorAddress(_)) -> compared = compared + 1
                Alloc(_, _) -> allocations = allocations + 1
                Call(_, Direct(g), _) -> direct.push(program.functions[g].symbol)
                Call(_, Runtime(entry, _), _) -> if entry == "avin_rt_alloc" then allocations = allocations + 1
                _ -> ()
    Cost(tables, entries, compared, allocations, direct)

private calls(c: Cost, symbol: string) -> bool
    for d in c.direct
        if d == "<program>." + symbol then return true
    false

private const Encoder: string = "class Out\n    var text = \"\"\n    key(k: string) = text = text + k + \":\"\n    value(v: string) = text = text + v + \";\"\n\ntrait Encode\n    encode(out: Out)\n\nimpl Encode for int\n    encode(out: Out) = out.value(s\"$self\")\n\nimpl Encode for string\n    encode(out: Out) = out.value(self)\n\nderive Encode for T\n    encode(out: Out)\n        T.walk(self, FieldWriter(out))\n        ()\n\ndata FieldWriter(out: Out)\n\nimpl ShapeVisitor for FieldWriter\n    variant(v: VariantShape) -> FieldWriter = self\n\nimpl FieldWriter\n    field[F: Encode](f: FieldShape, value: F) -> FieldWriter =\n        out.key(f.name)\n        value.encode(out)\n        self\n\ndata Person(name: string, age: int) derives Encode\n\ndata Hand(name: string, age: int)\n\nimpl Hand\n    encode(out: Out) =\n        out.key(\"name\")\n        name.encode(out)\n        out.key(\"age\")\n        age.encode(out)\n\nmain()\n    val out = Out()\n    Person(\"Ada\", 36).encode(out)\n    Hand(\"Ada\", 36).encode(out)\n    println(out.text)\n"

@test("a derived method inlines the visitor's hooks, one for each field's type, and calls each field's own method directly")
derived_calls_are_direct()
    val c = cost_of(lowered(Encoder), "Person.encode")
    assert_eq(c.through_tables, 0)
    assert_eq(c.entries, 0)
    assert_eq(c.compared, 0)
    assert(!calls(c, "FieldWriter.variant"))
    assert(!calls(c, "FieldWriter.field[string]"))
    assert(!calls(c, "FieldWriter.field[int]"))
    assert(calls(c, "Out.key"))
    assert(calls(c, "string.encode"))
    assert(calls(c, "int.encode"))

@test("a derived method allocates no more than the hand-written one: its visitor is kept as its fields")
derived_allocates_no_visitor()
    val program = lowered(Encoder)
    val derived = cost_of(program, "Person.encode")
    val hand = cost_of(program, "Hand.encode")
    assert_eq(hand.allocations, 0)
    assert_eq(derived.allocations, hand.allocations)

@test("each hook is compiled for one field type and calls its field's own method directly")
hooks_are_direct()
    val program = lowered(Encoder)
    val text = cost_of(program, "FieldWriter.field[string]")
    assert_eq(text.through_tables, 0)
    assert_eq(text.allocations, 0)
    assert(calls(text, "string.encode"))
    val number = cost_of(program, "FieldWriter.field[int]")
    assert_eq(number.through_tables, 0)
    assert_eq(number.allocations, 0)
    assert(calls(number, "int.encode"))

private const Builtins: string = "data Record(id: int, name: string) derives Ord\n\ndata Level derives Ord\n    Low\n    High(n: int)\n\nclass Key(val id: int, val name: string) derives Eq, Hash\n\nmain()\n    println(Record(1, \"a\").compare(Record(1, \"b\")))\n    println(High(1) < Low)\n    println(Key(1, \"a\") == Key(1, \"a\"))\n    println(Record(1, \"a\"))\n"

/** The cost of a function of `program` whose symbol is `symbol` exactly. */
private cost_named(program: MirProgram, symbol: string) -> Cost
    for f in program.functions
        if f.symbol == symbol then return cost_of_function(program, f)
    panic("no function " + symbol)

@test("the core library's derived Ord, Eq and Display allocate nothing of their own")
builtin_derivations_cost()
    val program = lowered(Builtins)
    for name in ["<program>.Record.compare", "<program>.Level.compare", "<program>.Key.equals", "avin.OrderFields.field[int]", "avin.OrderFields.field[string]", "avin.OrderFields.variants", "avin.EqualFields.field[int]"]
        val c = cost_named(program, name)
        assert_eq(c.through_tables, 0)
        assert_eq(c.allocations, 0)
    // `display` allocates nothing of its own: its visitor never leaves it, its hooks inlined, so it is
    // kept as its field, and the `FormatSpec()` each field is handed, its defaults all literals, is a
    // constant. The writer a field width renders the whole into is made by its constructor.
    val shown = cost_named(program, "<program>.Record.display")
    assert_eq(shown.allocations, 0)

@test("a derived Display of several variants keeps its visitor as its field, the variant without fields first or last")
several_variants_display()
    for order in ["    Dot\n    Circle(r: int)\n    Rect(w: int, h: int)\n", "    Rect(w: int, h: int)\n    Circle(r: int)\n    Dot\n"]
        val program = lowered("data Shape\n" + order + "\nmain()\n    println(Rect(1, 2))\n    println(Dot)\n")
        val shown = cost_named(program, "<program>.Shape.display")
        assert_eq(shown.allocations, 0)

@test("a field named like a derived method leaves the derived method as cheap as on any other type")
field_named_like_derived_method()
    val program = lowered("data R(display: int, debug: string, compare: int) derives Ord\n\ndata P(shown: int, text: string, rank: int) derives Ord\n\nmain()\n    println(R(1, \"a\", 2))\n    println(debug(R(1, \"a\", 2)))\n    println(R(1, \"a\", 2) < R(1, \"a\", 3))\n    println(P(1, \"a\", 2))\n    println(debug(P(1, \"a\", 2)))\n    println(P(1, \"a\", 2) < P(1, \"a\", 3))\n")
    for name in ["display", "debug", "compare"]
        val named = cost_named(program, "<program>.R." + name)
        val plain = cost_named(program, "<program>.P." + name)
        assert_eq(named.through_tables, plain.through_tables)
        assert_eq(named.entries, plain.entries)
        assert_eq(named.allocations, plain.allocations)

/** The diagnostics `avin check` renders for `text`, or "" when it compiles. */
private derive_diagnostics(text: string) -> string = lower_source(repository_toolchain(), source_of("probe.avin", text)) match
    Ok(_) -> ""
    Err(d) -> d

@test("a member that really clashes with a field is reported at the program's declaration, never in the library")
field_clashes_point_at_the_program()
    // The library's own uses of the names compile.
    assert_eq(derive_diagnostics("data R(display: int, debug: int)\n\nmain() = println(R(1, 2))\n"), "")
    // A method of no trait shares no name with a field: reported at the program's impl.
    val own = derive_diagnostics("data R(display: int)\n\nimpl R\n    display(out: Writer, spec: FormatSpec) = out.write(\"own\")\n\nmain() = println(R(1))\n")
    assert(own.contains("`display` is already a field of `R`"))
    assert(own.contains("probe.avin:4:5"))
    assert(!own.contains("library/"))
    // A template's method of no parameter list leaves its name to a field, which implements it: the
    // derivation is refused at the `derives` entry.
    val template = derive_diagnostics("trait Named\n    title -> string\n\nderive Named for T\n    title -> string = \"t\"\n\ndata D(title: string) derives Named\n\nmain() = println(D(\"a\").title)\n")
    assert(template.contains("`D` cannot derive `Named`: `title` is already a field of `D`"))
    assert(template.contains("probe.avin:7:31"))
    assert(!template.contains("library/"))
