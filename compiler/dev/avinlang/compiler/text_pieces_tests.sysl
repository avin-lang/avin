module dev.avinlang.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.text.str_builder

// Text gathered as pieces and joined once at its exact length.

@test("nothing pushed, or only empty strings, joins to the empty string")
pieces_empty()
    assert_eq(text_pieces().finish(), "")
    var p = text_pieces()
    p.push("")
    p.push("")
    assert_eq(p.len(), 0)
    assert_eq(p.finish(), "")

@test("one piece joins to itself, and empty pieces around others add nothing")
pieces_one()
    var p = text_pieces()
    p.push("define void @f() {\n}\n")
    assert_eq(p.finish(), "define void @f() {\n}\n")
    var q = text_pieces()
    q.push("")
    q.push("a")
    q.push("")
    q.push("b")
    q.push("")
    assert_eq(q.len(), 2)
    assert_eq(q.finish(), "ab")

@test("pieces join in the order pushed, at the sum of their lengths in bytes, Unicode included")
pieces_order_and_length()
    var p = text_pieces()
    for s in ["; é\n", "@\"<program>.ünï\" = private constant i64 1\n", "日本", "\n", "🎉"]
        p.push(s)
    val joined = p.finish()
    assert_eq(joined, "; é\n@\"<program>.ünï\" = private constant i64 1\n日本\n🎉")
    assert_eq(joined.bytes.len, p.len())

@test("slices of a larger string join to the same text a builder makes of them")
pieces_of_slices()
    val whole = "declare i32 @puts(ptr)\n@count = private global i64 0\ndefine void @f() {\nb0:\n  ret void\n}\n"
    var p = text_pieces()
    var b = str_builder()
    var at: usize = 0
    for cut in [23usize, 52, 70, whole.bytes.len]
        p.push(whole[at..<cut])
        b.push(whole[at..<cut])
        at = cut
    assert_eq(p.finish(), b.finish())
    assert_eq(p.finish(), whole)

@test("finishing twice gives the same text, and pushing after a finish extends it")
pieces_finish_twice()
    var p = text_pieces()
    p.push("ab")
    val first = p.finish()
    assert_eq(p.finish(), first)
    p.push("c")
    assert_eq(p.finish(), "abc")
    assert_eq(first, "ab")

@test("a joined text outlives its pieces and the gatherer, and is unchanged by later work")
pieces_outlive()
    val joined = joined_of_temporaries(1000)
    var churn: Buf[string] = buf()
    for i in 0..<1000
        churn.push(s"churn $i")
    assert_eq(joined.bytes.len, 1000 * 6)
    for i in 0..<1000
        assert_eq(joined[i * 6..<i * 6 + 6], "line\n" + (if i % 2 == 0 then "x" else "y"))

private joined_of_temporaries(n: int) -> string
    var p = text_pieces()
    for i in 0..<n
        p.push("line\n" + (if i % 2 == 0 then "x" else "y"))
    p.finish()

@test("many pieces join to megabytes exactly")
pieces_large()
    var p = text_pieces()
    var b = str_builder()
    for i in 0..<20000
        val s = s"  %v$i = add i64 %v${i + 1}, $i\n"
        p.push(s)
        b.push(s)
    val joined = p.finish()
    assert_eq(joined.bytes.len, p.len())
    assert_eq(joined, b.finish())
