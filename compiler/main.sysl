import dev.avinlang.compiler.{locate_toolchain, run_cli, toolchain_cache, watch_for_interrupts}
import sysl.env.{current_exe, get}
import sysl.fs.cache_dir

main(args: []string)
    if args.len >= 2 && args[1] == "test" then _ = watch_for_interrupts()
    val cache =toolchain_cache(get("AVIN_CACHE"), cache_dir(), get("TMPDIR"))
    exit(run_cli(args, locate_toolchain(get("AVIN_ROOT"), current_exe(), cache), line -> print(line), line -> eprints(line + "\n")))
