import dev.avinlang.compiler.{run_cli, toolchain_at}
import sysl.env.{current_exe, get}
import sysl.path.parent

main(args: []string)
    exit(run_cli(args, installed_toolchain(), line -> print(line), line -> eprints(line + "\n")))

// AVIN_ROOT names the toolchain; otherwise it is the directory above the one the compiler is in,
// which is where a source checkout keeps `compiler/avin`.
installed_toolchain() -> Option[dev.avinlang.compiler.Toolchain]
    if get("AVIN_ROOT") is Some(root) then return toolchain_at(root)
    val exe = current_exe() match
        Some(e) -> e
        None -> return None
    toolchain_at(parent(parent(exe).unwrap_or("/")).unwrap_or("/"))
