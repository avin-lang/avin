import dev.avinlang.compiler.{Toolchain, build_root, forget_handed, handoff_split, locate_toolchain, run_cli, start_link_handoff, toolchain_cache, watch_for_interrupts}
import sysl.env.{current_exe, get}
import sysl.fs.cache_dir

main(args: []string)
    // A compiler handed a build to link is run with the command of the one that compiled it
    // (`link_handoff.sysl`), and carries out that command.
    val (command, handed) = handoff_split(args)
    start_link_handoff(command.view(), handed)
    if command.len() >= 2 && command[1] == "test" then _ = watch_for_interrupts()
    val cache = toolchain_cache(get("AVIN_CACHE"), cache_dir(), get("TMPDIR"))
    val builds = build_root(get("AVIN_CACHE"), cache_dir(), cache)
    val tc: Option[Toolchain] = locate_toolchain(get("AVIN_ROOT"), current_exe(), cache) match
        Some(t) -> Some(t.building_in(builds))
        None -> None
    val code = run_cli(command.view(), tc, line -> print(line), line -> eprints(line + "\n"))
    forget_handed()
    exit(code)
