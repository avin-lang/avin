import dev.avinlang.compiler.{Toolchain, build_root, locate_toolchain, run_cli, toolchain_cache, watch_for_interrupts}
import sysl.env.{current_exe, get}
import sysl.fs.cache_dir

main(args: []string)
    if args.len >= 2 && args[1] == "test" then _ = watch_for_interrupts()
    val cache = toolchain_cache(get("AVIN_CACHE"), cache_dir(), get("TMPDIR"))
    val builds = build_root(get("AVIN_CACHE"), cache_dir(), cache)
    val tc: Option[Toolchain] = locate_toolchain(get("AVIN_ROOT"), current_exe(), cache) match
        Some(t) -> Some(t.building_in(builds))
        None -> None
    exit(run_cli(args, tc, line -> print(line), line -> eprints(line + "\n")))
