module zlibtools

// An Avin API over zlib's scalar C functions, whose C bindings are private to this library.

@c("uLong compressBound(uLong sourceLen)")
private cCompressBound(n: long) -> long

@c("uLong zlibCompileFlags(void)")
private cCompileFlags() -> long

@c("uLong crc32_combine(uLong crc1, uLong crc2, z_off_t len2)")
private cCrcCombine(a: long, b: long, length: long) -> long

@c("uLong adler32_combine(uLong, uLong, z_off_t)")
private cAdlerCombine(a: long, b: long, length: long) -> long

/// The most bytes compressing `n` bytes can take.
compressBound(n: long) -> long = cCompressBound(n)

/// Whether zlib was built with `uInt` 32 bits wide, which its compile flags say in their two lowest bits.
uIntIs32Bits() -> bool = cCompileFlags() % 4 == 1

/// The CRC-32 of two pieces joined, from each one's and the second's length.
crcCombine(a: long, b: long, length: long) -> long = cCrcCombine(a, b, length)

/// The Adler-32 of two pieces joined, from each one's and the second's length.
adlerCombine(a: long, b: long, length: long) -> long = cAdlerCombine(a, b, length)
