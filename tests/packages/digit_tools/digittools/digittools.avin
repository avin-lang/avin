module digittools

// An Avin API over the Sysl package `digits`, whose bindings are private to this library.

@sysl("avintest.digits.digit_count")
private syslDigitCount(n: long) -> int

@sysl("avintest.digits.without_digits")
private syslWithoutDigits(text: string) -> string

/// The number of decimal digits of `n`, its sign not counted.
digits(n: long) -> int = syslDigitCount(n)

/// `text` with every decimal digit removed and its ends trimmed.
letters(text: string) -> string = syslWithoutDigits(text).trim
