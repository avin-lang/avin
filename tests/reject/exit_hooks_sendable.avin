// error: what is passed for `body` of `onExit` may use only sendable values from around it, but it uses `lines`, a `Buffer[string]`
// error: what is passed for `body` of `onExit` may use only sendable values from around it, but it uses `shout`, a `(string) -> string`, which is a function value
// error: what is passed for `body` of `onExit` may use only sendable values from around it, but it uses `screen`, a `Screen`
// A hook may run on whichever thread ends the program, while the others still run, so what it
// captures must be sendable: a mutable buffer, a plain function value and a class with a `var` are
// refused where the hook is registered.
import avin.process

class Screen()
  var open = true

main()
  val lines = Buffer[string]()
  val shout: (string) -> string = s -> s + "!"
  val screen = Screen()
  process.onExit(() -> println(lines.size))
  process.onExit(() -> println(shout("x")))
  process.onExit(() -> println(screen.open))
