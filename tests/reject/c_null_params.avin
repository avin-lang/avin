// `null` marks a pointer the binding passes null: a pointer, neither `out` nor `userdata` besides,
// never the array a length is filled in from, and never a callback's parameter.
// error: `@c` takes the C function's prototype as the header writes it, as in `@c("int abs(int)")`, and this one is not: `null` marks a pointer the binding passes null, as in `null int *num_clusters`, and `int` is not one
// error: and this one is not: `null` marks a pointer the binding passes null, which is neither read nor written, so it is not `out` too
// error: and this one is not: `p` is passed `null`, so it is no array
// error: and this one is not: a callback's parameter is what C calls it with, so it is never `null`
// error: and this one is not: a length is filled in from its array, so it is not passed `null`

@c("void f(null int n)")
scalar()

@c("void f(null out int *n)")
nulledOut()

@c("void f(null const uint8_t *p, length(p) int n)")
nulledArray()

@c("void f(void (*cb)(null int *x, userdata void *d), userdata void *d)")
nulledCallback(cb: (int) -> unit)

@c("void f(const uint8_t *p, length(p) null int *n)")
nulledLength(p: Array[byte])

main() = 0
