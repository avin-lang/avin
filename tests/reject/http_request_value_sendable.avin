// error: `Array[int]` does not conform to `Sendable`, the bound of `T` in `withValue`: it is mutable; an immutable copy (`toVector`) is sendable
// error: `Buffer[string]` does not conform to `Sendable`, the bound of `T` in `withValue`: it is mutable; an immutable copy (`toVector`) is sendable
// error: `Counter` does not conform to `Sendable`, the bound of `T` in `withValue`: its field `n` is a `var`; make it a `val`
// error: `Array[int]` does not conform to `Sendable`, the bound of `T` in `value`: it is mutable; an immutable copy (`toVector`) is sendable
// error: `Counter` does not conform to `Sendable`, the bound of `T` in `value`: its field `n` is a `var`; make it a `val`
// A request may be answered on any thread, so a value it carries is sendable: a mutable array, a
// buffer and a class with a `var` are refused where they are handed on and where they are asked for.
import avin.net.http.ServerRequest

class Counter()
  var n: int = 0

main()
  val r = ServerRequest("GET", "/")
  _ = r.withValue(Array.empty[int]())
  _ = r.withValue(Buffer[string]())
  _ = r.withValue(Counter())
  _ = r.value[Array[int]]()
  _ = r.value[Counter]()
