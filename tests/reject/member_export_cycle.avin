// error: the exports of `ping` lead round without reaching a member: `Left` exports `ping` from `Right` and `Right` exports `ping` from `Left`
// error: the exports of `ping` lead round without reaching a member: `Right` exports `ping` from `Left` and `Left` exports `ping` from `Right`
// error: the exports of `pong` lead round without reaching a member: `Loop` exports `pong` from `Loop`
// error: `Left` has no member `ping`
// error: `WildB` has no member `zing`
// Exports by name that lead round to one another without reaching a member are an error at each of
// them, and none is followed; wildcards that lead round present nothing.
class Left(r: Right)
  export r.ping

class Right(l: Left)
  export l.ping

class Loop(n: int)
  me -> Loop = self
  export me.pong

class WildA(n: int)
  other -> WildB = WildB(self)
  export other.*

class WildB(a: WildA)
  export a.*

use(l: Left, w: WildB)
  println(l.ping)
  println(w.zing)

main() = ()
