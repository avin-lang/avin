// error: `<` on `V` needs a bound that is `Ord` or requires it, as in `[V: Ord]`
// error: `min` needs `T: Ord`, which Vector[Thing] does not meet
// error: `Buffer[string]` does not conform to `Sendable`, the bound of `R` in `Ask`
// error: `R` does not conform to `Sendable`, the bound of `R` in `Ask`
// error: `Msg[string]` does not conform to `Sendable`, so the actor `Logger` cannot receive it: its variant `Log` holds a `Buffer[string]`
// A parameter equated with only a part of a bounded one (`V` with `Vector[V]`) gains nothing, and at
// a concrete type without the bound an arm's code is checked at that type. `Ask` with a reply type
// that is not `Sendable` is an error where it is made. Whether a refined type is sendable is decided
// at its instance: `Msg[string]` holds `Log`'s `Buffer`.
import avin.actors.{spawn}

data Coll[T]
  Plain(items: Vector[T])
  Sorted[A: Ord](items: Vector[A]) -> Coll[A]

data Query[R]
  Balance -> Query[long]
  History -> Query[Buffer[string]]

data AccountMsg
  Ask[R: Sendable](query: Query[R], reply: (R) -> unit)

data Msg[T]
  Num(n: int) -> Msg[int]
  Log(lines: Buffer[string]) -> Msg[string]

class Thing(val n: int)

part[V](c: Coll[Vector[V]], u: V, w: V) -> bool = c match
  Plain(_) -> false
  Sorted(_) -> u < w

concrete(c: Coll[Thing]) -> int = c match
  Plain(_) -> 0
  Sorted(items) -> items.min.n

asked[R](q: Query[R], reply: (R) -> unit) -> AccountMsg = Ask(q, reply)

actor Logger() receives Msg[string]
  receive
    Log(lines) -> println(lines.length)

main()
  val d = Ask(History, (lines: Buffer[string]) -> ())
  val e = Ask(Balance, (n: long) -> ())
