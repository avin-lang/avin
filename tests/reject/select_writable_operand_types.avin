// error: expected Writability, found int
// error: expected Writability, found Channel[int]
// error: expected Writability, found StreamReader
// error: this arm yields string, but the arms before it yield int
// A `writable()` arm names a sink, anything that is a `Writability`: an int, a channel or the reading
// half of a split connection is reported as a call's argument of the wrong type is; and its body's
// type unifies with the other arms' as a match's does.
import avin.net.{StreamReader, StreamWriter}
import avin.threads.Channel

f(r: StreamReader, w: StreamWriter)
  val n = 3
  val ch = Channel[int]()
  select
    n.writable() -> ()
  select
    ch.writable() -> ()
  select
    r.writable() -> ()
  val x = select
    w.writable() -> 1
    ch.receive() -> "two"

main() = ()
