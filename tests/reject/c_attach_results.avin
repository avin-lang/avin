// A handle answered in a `Result` is of a class with `attach:`, made by a binding that keeps
// something, its error an integer or an enum mirror, and the C result the class's own type.
// error: `Plain` has no `attach:`, so nothing fails once C has answered it
// error: the error is what `attach:` of `Tied` answers when what the call keeps cannot be kept, and `keepsNothing` keeps nothing
// error: the error is what `attach:` of `Tied` answered, an integer or an enum mirror
// error: the result of the C binding `notHandle` is `Result[Tied, int]` in Avin and `int` in C
import avin.c.ByteBlock

@c(type: "struct s *", release: "free",
   attach: "set_data(self, key, data, destroy)")
class Tied

@c(type: "struct s *", release: "free")
class Plain

@c("struct s *make(unsigned char *p, int n)", keeps: "p")
plain(p: ByteBlock, n: int) -> Result[Plain, int]

@c("struct s *make(unsigned char *p, int n)")
keepsNothing(p: ByteBlock, n: int) -> Result[Tied, int]

@c("struct s *make(unsigned char *p, int n)", keeps: "p")
stringError(p: ByteBlock, n: int) -> Result[Tied, string]

@c("int make(unsigned char *p, int n)", keeps: "p")
notHandle(p: ByteBlock, n: int) -> Result[Tied, int]

main() = 0
