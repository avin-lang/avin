// error: `OneBag[int]` does not conform to `Make[int]`, the bound of `C` in `build`
// error: `OneBag[int]` has no static member `make`
// error: `U` has no static member `make`
// error: `U` does not conform to `Make[int]`, the bound of `C` in `build`
// A trait type's impl of a trait is its own conformance: a type implementing the trait does not get
// it, and a type parameter bounded by the trait type does not reach it, since its argument may be
// any type implementing the trait.
trait Make[A]
  static make(x: A) -> Self

trait Bag[A]
  first -> A

class OneBag[A](val a: A): Bag[A]
  override first -> A = a

impl[A] Make[A] for Bag[A]
  static make(x: A) -> Bag[A] = OneBag(x)

build[C: Make[A], A](x: A) -> C = C.make(x)

viaTrait[U: Bag[int]]() -> U = U.make(1)

viaTraitBound[U: Bag[int]]() -> U = build[U, int](1)

main()
  val a = build[OneBag[int], int](1)
  val b = OneBag[int].make(1)
