// error: this arm's result is an `A`, a type `Hold` hides in the value matched, which is not known outside the arm
// error: this arm's result is a `Vector[A]`, and `A` is a type `Hold` hides in the value matched, which is not known outside the arm
// error: a type declared outside this arm cannot be settled to an `A`: `A` is a type `Hold` hides in the value matched, which is not known outside the arm
// error: expected A of `Hold` on line 34, found A of `Hold` on line 33
// error: expected R, found long
// A type a variant hides never leaves the arm taking the value apart: an arm's result naming it,
// bare or inside another type, a variable declared outside settled to it, another value's hidden
// type and a value of a type outside it given where the hidden type is expected are all errors.
import avin.actors.{ActorRef}

data Query[R]
  Balance -> Query[long]

data AccountMsg
  Ask[R: Sendable](query: Query[R], replyTo: ActorRef[R])

data Box
  Hold[A](value: A, show: (A) -> string)

leak(b: Box) = b match
  Hold(v, _) -> v

leakVector(b: Box) = b match
  Hold(v, _) -> [v]

settled(b: Box) -> int
  var out = None
  b match
    Hold(v, _) -> out = Some(v)
  0

mixed(a: Box, b: Box) -> string = a match
  Hold(v, _) -> b match
    Hold(_, f) -> f(v)

wrongReply(m: AccountMsg, balance: long) = m match
  Ask(_, replyTo) -> replyTo.tell(balance)

main()
  println(0)
