// error: `describe` may be overridden, so it cannot be called in the body of an open class, which runs before a subclass's fields are initialized
// error: `area` may be overridden, so it cannot be called in the body of an abstract class
// error: `report` uses `self` for more than its fields, so it cannot be called in the body of an open class
// error: `self` cannot be passed, stored or returned in the body of an open class
// error: a lambda cannot capture `self` in the body of an open class
open class Animal(val name: string)
    val sound = "noise"
    print(describe())
    print(report())
    keep(self)
    print((() -> name)())

    describe() -> string = s"$name makes a $sound"

    private report() -> string = "reported: " + describe()

abstract class Shape(val label: string)
    var cached = 0
    cached = area()

    area() -> int

keep(a: Animal) = ()

main() = ()
