// error: the `lazy val` `itself` needs its own value to initialize: `itself` → `itself`
// error: the `lazy val` `first` needs its own value to initialize: `first` → `second` → `first`
// error: the `lazy val` `counted` needs its own value to initialize: `counted` → `counted`
// error: the `lazy val` `viaSelf` needs its own value to initialize: `viaSelf` → `viaSelf`
// error: the `lazy val` `area` needs its own value to initialize: `area` → `area`
// A field's `lazy val` whose initializer's own code reads the same field of the same object would
// read it while it is being initialized, so it is refused: directly, through another lazy field,
// through a method called on the object, through `self.`, and through a subclass's override a
// call through the method table may reach.
class Direct
  lazy val itself: int = itself + 1

class Chain
  lazy val first: int = second + 1
  lazy val second: int = first * 2

class Counter
  lazy val counted: int = count()

  count() -> int = counted + 1

class Explicit
  lazy val viaSelf: int = self.viaSelf + 1

open class Shape
  lazy val area: int = measure()

  measure() -> int = 1

class Square: Shape
  override measure() -> int = area + 1

main() = ()
