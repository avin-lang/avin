// error: what is passed for `body` of `spawn` may run on another thread, which shares the program's module-level state, but through `total` → `Ones.fold` it reaches `count`, a module-level `var`, which every thread would share; share it through an `Atomic` or a `Mutex` held in a `val`
// The code a body runs without naming a function: an extractor a pattern calls, an operator's
// implementation, a body started from a scope or an executor, and a method reached through a bound
// on a type parameter.
import avin.threads.{spawn, scope, Executor}

var count = 0

work() -> int = count

object Half
    unapply(n: int) -> Option[int] = if count > 0 then Some(n / 2) else None

data Money(cents: int)

impl Sub for Money
    subtract(other: Money) -> Money = Money(cents - other.cents - count)

trait Fold
    fold() -> int

data Ones(n: int)

impl Fold for Ones
    fold() -> int = n + count

total[T: Fold](x: T) -> int = x.fold()

main()
    spawn(() -> 8 match
        Half(h) -> h
        _ -> 0).join()
    spawn(() -> (Money(3) - Money(2)).cents).join()
    scope(s -> s.spawn(() -> work()).join())
    val ex = Executor.fixed(1)
    println(ex.future(work()).await())
    spawn(() -> total(Ones(1))).join()
