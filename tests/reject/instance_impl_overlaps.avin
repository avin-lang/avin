// error: `impl Show for Box[int]` overlaps `impl[T: Show] Show for Box[T]` at
// error: `Box[int]` meets its bounds, so both hold for it, and a type conforms to a trait through one impl
// error: `impl Show for Bag[int]` overlaps `impl Show for Bag[int]`: both hold for `Bag[int]`, and a type conforms to a trait through one impl; the other is at
// error: `impl[V] Show for Pair[string, V]` overlaps `impl[K] Show for Pair[K, int]`: both hold for `Pair[string, int]`
// error: `Cell[string]` is a `Show` through it already, and a type conforms to a trait through one impl
// Two impls of one trait may not both hold of an instance: an instance impl beside the type's own
// whose bound the instance meets, the same instance twice, two partly applied instances some type
// matches both of, and an instance beside an impl with no bounds at all. No impl is preferred to
// another, the more specific one included.

trait Show
  show() -> string

impl Show for int
  show() -> string = "int"

data Box[T](value: T)

impl[T: Show] Show for Box[T]
  show() -> string = value.show()

impl Show for Box[int]
  show() -> string = "a box of int"

data Bag[T](value: T)

impl Show for Bag[int]
  show() -> string = "one"

impl Show for Bag[int]
  show() -> string = "two"

data Pair[A, B](first: A, second: B)

impl[K] Show for Pair[K, int]
  show() -> string = "int second"

impl[V] Show for Pair[string, V]
  show() -> string = "string first"

data Cell[T](value: T)

impl[T] Show for Cell[T]
  show() -> string = "any cell"

impl Show for Cell[string]
  show() -> string = "a string cell"

main()
  println(Box(1).show())
