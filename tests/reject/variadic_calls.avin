// error: expected int, found string
// error: expected Iterable[int], found Vector[string]
// error: `*` passes a sequence to a repeated parameter, but this argument of `fixed` is given to `n`, which is not repeated
// error: a spliced sequence is the only argument of the repeated parameter `values`; write the other elements into the sequence
// error: `values` is a repeated parameter, given its arguments by position: `total(first, a, b)` or `total(first, xs*)`
total(values: int*) -> int = values.length

fixed(n: int, more: int*) -> int = n

main()
    val v = [1, 2]
    val words = ["a"]
    total(1, "two")
    total(words*)
    fixed(v*)
    total(1, v*)
    total(values = v)
