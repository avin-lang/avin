// error: `++` groups to the left and `+:` to the right, so they cannot be mixed at one level: add parentheses
// error: `:+` groups to the left and `::` to the right, so they cannot be mixed at one level: add parentheses
// error: `+` groups to the left and `+:` to the right, so they cannot be mixed at one level: add parentheses
// error: `:+` has no right operand: a method named by a symbol is called between two operands, and has no postfix form
// error: `:+` is a method's name, called between its two operands; a symbol method has no prefix form
class Bag(val items: Vector[int])
    ++(other: Bag) -> Bag = self
    +:(x: int) -> Bag = self
    :+(x: int) -> Bag = self
    max(other: Bag) -> Bag = self

main()
    val a = Bag([1])
    val b = a ++ a +: a
    val c = 1 :: a :+ 2
    val d = 1 +: a + a
    val e = a :+
    val f = :+ a
    // Parentheses settle the grouping, and operators of different levels need none.
    val g = (a ++ a) :+ 1
    val h = 1 +: (a :+ 2)
    val i = 1 +: a :+ 2
    val j = 1 +: a max a
