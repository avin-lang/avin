// Where a function is expected, a parameterless method of a generic class or trait is judged by what
// it yields at the receiver's type arguments: `int` for `xs.head` on a `Vector[int]`, so the error
// names the lambda there as it does for a method of a plain class.
// error: `head` takes no parameter list, so it has no function value: naming it calls it; for a function, write a lambda, as in `() -> x.head`
// error: `item` takes no parameter list, so it has no function value: naming it calls it; for a function, write a lambda, as in `() -> x.item`
// error: `isEmpty` takes no parameter list, so it has no function value: naming it calls it; for a function, write a lambda, as in `() -> x.isEmpty`
// error: `size` takes no parameter list, so it has no function value: naming it calls it; for a function, write a lambda, as in `() -> x.size`
// error: `keys` takes no parameter list, so it has no function value: naming it calls it; for a function, write a lambda, as in `() -> x.keys`

class Box[T](x: T)
  item -> T = x

counted(xs: Iterable[int]) -> () -> int = xs.size

main()
  val v = [1, 2]
  val f: () -> int = v.head
  val g: () -> string = Box("a").item
  val h: () -> bool = List(1).isEmpty
  val k: () -> Vector[string] = Map(("a", 1)).keys
