// error: a writable arm binds nothing, so it has no `as` pattern; its body writes the stream
// error: a select arm is a channel's `receive()` or `send(x)`, a stream's `readable()` or `writable()`, `after` a duration, or `else`
// error: a select arm is a channel's `receive()` or `send(x)`, a stream's `readable()` or `writable()`, `after` a duration, or `else`
// A `writable()` arm binds nothing, so an `as` pattern is an error, and `writable` with an argument,
// or one named, is no arm at all.
import avin.net.StreamWriter

f(w: StreamWriter)
  select
    w.writable() as x -> ()
  select
    w.writable(1) -> ()
  select
    w.writable(x = 1) -> ()

main() = ()
