// error: `t.size` (`Text.size -> string`), exported as `size`, implements `Sized.size -> int` but yields string, not int
// error: `c.label` (`Counter.label(string) -> string`), exported as `label`, implements `Labelled.label(int) -> string` but does not take its parameters, (int)
// error: `c.pair` (`Counter.pair(int) -> int`), exported as `pair`, implements `Paired.pair(int, int) -> int` but does not take its parameters, (int, int)
// error: `c.count` (`var count: int`), exported as `count`, implements `Counted.count(int) -> int` but is not a method, so it takes no parameters (int)
// error: `c.wrap` (`Counter.wrap[T](T) -> Vector[T]`), exported as `wrap`, implements `Wrapping.wrap(int) -> Vector[string]` but yields Vector[int], not Vector[string]
// A member that does not fit the trait's method an export implements with it is reported once, at the
// export, with the export, the trait's method and both signatures: a result of another type, a
// parameter of another type, another number of parameters, a field where a method is wanted, and a
// generic member whose instance yields another type.
trait Sized
  size -> int

trait Labelled
  label(n: int) -> string

trait Paired
  pair(a: int, b: int) -> int

trait Counted
  count(n: int) -> int

trait Wrapping
  wrap(x: int) -> Vector[string]

class Text(s: string)
  size -> string = s

class Counter(var count: int)
  label(s: string) -> string = s
  pair(a: int) -> int = a
  wrap[T](x: T) -> Vector[T] = [x]

class Measured(t: Text): Sized
  export t.size

class Tagged(c: Counter): Labelled
  export c.label

class Twin(c: Counter): Paired
  export c.pair

class Tally(c: Counter): Counted
  export c.count

class Wrapper(c: Counter): Wrapping
  export c.wrap

main() = ()
