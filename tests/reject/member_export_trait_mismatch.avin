// error: `Datum` does not implement `bump` from `Bumpable`
// error: expected string, found int
// error: yields string, not int
// A data type's exports serve its uses, and its impls of a trait write the trait's methods; a member
// that cannot be called with the parameters of the trait's method it would implement is reported at
// the export.
trait Bumpable
  bump() -> unit

trait Labelled
  label(n: int) -> string

class Counter(var count: int)
  bump() = count += 1
  label(s: string) -> string = s

data Datum(c: Counter)

impl Datum
  export c.bump

impl Bumpable for Datum

class Tagged(c: Counter): Labelled
  export c.label

trait Sized
  size -> int

class Text(s: string)
  size -> string = s

class Measured(t: Text): Sized
  export t.size

main() = ()
