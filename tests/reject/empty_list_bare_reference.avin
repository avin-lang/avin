// A method declared with an empty parameter list, named without a call where no function type is
// expected, is an error naming the call and the lambda: printed, interpolated, compared with `==`,
// bound by a `val` with no type, and a static member through its type.
// error: `bump` is called with `()`: write `c.bump()`, or `() -> c.bump()` for a function value
// error: `peek` is called with `()`: write `c.peek()`, or `() -> c.peek()` for a function value
// error: `look` is called with `()`: write `c.look()`, or `() -> c.look()` for a function value
// error: `read` is called with `()`: write `c.read()`, or `() -> c.read()` for a function value
// error: `zero` is called with `()`: write `Counter.zero()`, or `() -> Counter.zero()` for a function value

trait Zero
    static zero() -> Self

class Counter(var n: int): Zero
    override static zero() -> Counter = Counter(0)
    bump() -> int = n
    peek() -> int = n
    look() -> int = n
    read() -> int = n

main()
    val c = Counter(0)
    println(c.bump)
    println(s"${c.peek}")
    println(c.look == 0)
    val v = c.read
    println(Counter.zero)
