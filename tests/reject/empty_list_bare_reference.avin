// A method declared with an empty parameter list, named without a call where no function type is
// expected, is an error naming the call and the lambda: printed, interpolated, compared with `==`,
// bound by a `val` with no type, and a static member through its type.
// error: `bump` is declared with an empty parameter list, so naming it without a call makes a function value, which is allowed only where a function type is expected: call it, as in `x.bump()`, or for a function write a lambda, as in `() -> x.bump()`
// error: `peek` is declared with an empty parameter list, so naming it without a call makes a function value, which is allowed only where a function type is expected: call it, as in `x.peek()`, or for a function write a lambda, as in `() -> x.peek()`
// error: `look` is declared with an empty parameter list, so naming it without a call makes a function value, which is allowed only where a function type is expected: call it, as in `x.look()`, or for a function write a lambda, as in `() -> x.look()`
// error: `read` is declared with an empty parameter list, so naming it without a call makes a function value, which is allowed only where a function type is expected: call it, as in `x.read()`, or for a function write a lambda, as in `() -> x.read()`
// error: `zero` is declared with an empty parameter list, so naming it without a call makes a function value, which is allowed only where a function type is expected: call it, as in `Counter.zero()`, or for a function write a lambda, as in `() -> Counter.zero()`

trait Zero
    static zero() -> Self

class Counter(var n: int): Zero
    override static zero() -> Counter = Counter(0)
    bump() -> int = n
    peek() -> int = n
    look() -> int = n
    read() -> int = n

main()
    val c = Counter(0)
    println(c.bump)
    println(s"${c.peek}")
    println(c.look == 0)
    val v = c.read
    println(Counter.zero)
