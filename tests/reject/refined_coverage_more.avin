// error: `Same[int, string]` has no values: no variant of `Same` makes one
// error: `Same[int, bool]` has no values: no variant of `Same` makes one
// error: this pattern never matches: `BoolLit` makes an `Expr[bool]`, and the value matched is an `Expr[int]`
// error: this arm is never reached: `Pair` needs `T` to be `(A, B)`, and `IntLit` in the same pattern needs it to be `int`
// error: this `match` does not cover every Expr[int] value, such as `IntLit(_)`; add an arm for it, or `_` for the rest
// More of coverage over refined variants: a `match` on an instance with no values is an error
// whatever its arms, as is a binding taking one apart; the right operand of `&&` holds the left one's
// equalities; a pattern needing a type parameter to be a pair of fresh types and an `int` is a
// contradiction; and a guarded arm leaves its variant to be covered.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  BoolLit(value: bool) -> Expr[bool]
  Add(a: Expr[int], b: Expr[int]) -> Expr[int]
  Pair[A, B](first: Expr[A], second: Expr[B]) -> Expr[(A, B)]

data Same[A, B]
  Refl -> Same[A, A]

anything(p: Same[int, string]) -> int = p match
  _ -> 0

bound(p: Same[int, bool]) -> int =
  val Refl = p
  0

andTest[T](a: Expr[T], b: Expr[T]) -> int = if a is IntLit(_) && b is BoolLit(_) then 1 else 0

pairAndInt[T](a: Expr[T], b: Expr[T]) -> int = (a, b) match
  (Pair(_, _), IntLit(_)) -> 0
  _ -> 1

guarded(e: Expr[int]) -> int = e match
  IntLit(n) if n > 0 -> n
  Add(_, _) -> 0

main()
  ()
