// error: write a map as `{"a": 1}`: a key and its value are joined by `:` inside braces, not by `->`
// error: `->` does not pair two values: write a pair as `(a, b)`, and a map as `{"a": 1}`
// error: a lambda's parameter with a type is written in parentheses: `(x: int) -> …`
// error: expected a new line between block items
data Tree[T]
    Leaf
    Node(left: Tree[T], value: T, right: Tree[T])

insert(t: Tree[int], x: int) -> Tree[int] = Node(t, x, Leaf)

main()
    val m = Map("a" -> 1, "b" -> 2)
    val t = [3, 1, 2].foldLeft(Leaf: Tree[int], insert)
    println(1 -> 2)
    val ys = [1].map(x: int -> x + 1)
    val a = 1 2 3 4
    println(m, t, ys, a)
