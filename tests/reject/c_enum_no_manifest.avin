// An enum mirror and a C constant are measured against the headers a manifest names, so a program
// with no avin.hocon refuses both, each at its declaration.
// error: the C enum mirror `Format` is measured against the headers a package's manifest names under `c-libraries`, and this program has no avin.hocon
// error: the C constant `version` is measured against the headers a package's manifest names under `c-libraries`, and this program has no avin.hocon

@c(enum: "cairo_format_t", prefix: "CAIRO_FORMAT_")
data Format
  Argb32
  A8

@c(const: "CAIRO_VERSION")
val version: int

main() = version
