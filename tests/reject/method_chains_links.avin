// error: `<` on `T` needs a bound that is `Ord` or requires it, as in `[T: Ord]`
// error: `<` on `T` needs a bound that is `Ord` or requires it, as in `[T: Ord]`
// error: expected Meter, found string
// error: `<=` needs Meter to implement `Ord`
// Each link of a chain resolves on its own: a link calling a method takes an argument one of its
// overloads accepts, and a link the left operand's type has no method for is `Ord`'s, which the type
// must implement. A type parameter whose bound declares no such method compares through `Ord`.
data Meter(n: int)

impl Meter
  <(other: Meter) -> bool = n < other.n

trait Sized
  size() -> int

has[T: Sized](a: T, b: T, c: T) -> bool = a < b < c

main()
  val m = Meter(5)
  println(Meter(1) < m < "x")
  println(Meter(1) < m <= Meter(3))
