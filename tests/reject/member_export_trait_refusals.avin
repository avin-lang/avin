// error: `Wild` does not implement `bump` from `Bumpable`; implement it, or declare `Wild` abstract
// error: `bump` implements `Bumpable`'s method, which is public, so it is not exported privately
// error: `Hidden` does not implement `bump` from `Bumpable`
// error: `Mapper`'s `convert` has type parameters of its own, which an export does not implement; declare `convert` in `Conv`
// error: `Conv` does not implement `convert` from `Mapper`
// A wildcard implements no trait's method, nor does a private export, which is refused, nor an export
// of a method with type parameters of its own.
trait Bumpable
  bump() -> unit

trait Mapper
  convert[U](f: (int) -> U) -> U

class Counter(var count: int)
  bump() = count += 1
  convert[U](f: (int) -> U) -> U = f(count)

class Wild(c: Counter): Bumpable
  export c.*

class Hidden(c: Counter): Bumpable
  private export c.bump

class Conv(c: Counter): Mapper
  export c.convert

main() = ()
