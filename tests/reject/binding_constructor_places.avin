// error: a module-level declaration names one value
// error: a field declaration names one field
// error: a `lazy val` names one value; take the value apart where it is read
// A module-level declaration, a field and a `lazy val` each name one value, so a constructor
// pattern there is refused as a tuple pattern is.

data Point(x: int, y: int)

val Point(mx, my) = Point(1, 2)

class Holder
  val Point(fx, fy) = Point(3, 4)

main() -> int
  lazy val Point(g, h) = Point(1, 2)
  0
