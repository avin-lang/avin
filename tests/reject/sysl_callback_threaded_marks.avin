// `@threaded` marks a Sysl binding's parameter that takes a function; on a parameter of another type,
// or of a function that is no binding, it is refused.
// error: `@threaded` marks a parameter that takes a function, which Sysl may call from any thread
// error: `@threaded` marks a Sysl binding's parameter, whose function Sysl may call from any thread

@sysl("avintest.callbacks.apply")
notFunction(@threaded x: int)

ordinary(@threaded f: (int) -> int) -> int = f(1)

main() = ()
