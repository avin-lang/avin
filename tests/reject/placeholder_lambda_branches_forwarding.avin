// error: `double(_)` is the function `double` itself; pass it as `double`
// error: `add(_, _)` is the function `add` itself; pass it as `add`
// A branch's lambda that only forwards to a named function is that function, as a call argument's
// is: a branch of a declared value and a clause of a function with a declared result each say to
// pass it by name.

double(x: int) -> int = x * 2
add(a: int, b: int) -> int = a + b

pick(name: string) -> (int, int) -> int
pick("add") = add(_, _)
pick(_) = _ * _

main() -> int
  val c = true
  val g: (int) -> int = if c then double(_) else _ + 1
  0
