// error: `/` needs two numbers of one type, not real and int; write `real(xs.length)`
// error: `*` needs two numbers of one type, not int and real; write `real(n)`
// error: `-` needs two numbers of one type, not real and long; write `real(big)`
// error: `+` needs two numbers of one type, not real and byte; write `real(b)`
// error: `*` needs two numbers of one type, not real and int; convert the int with a call of `real`
// An integer beside a `real` converts to `real`, and so does a byte. An operand too long to quote,
// or written over several lines, is named by its type.

main()
    val xs = [1.5, 2.5, 3.0]
    val n = 4
    val big: long = 10
    val b = byte(2)
    val rate = 0.5
    println(xs.sum / xs.length)
    println(n * rate)
    println(rate - big)
    println(rate + b)
    println(rate * (xs.length + n + xs.length + n + xs.length + n + xs.length))
