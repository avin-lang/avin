// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it uses `make`, a `() -> int`, which is a function value, whose type does not say what it captures; mark the parameter `@sendable`, and what is passed for it is checked in turn
// error: `run` overrides `Base.run`, which marks its parameter `f` `@isolating` where the method it overrides does not; a call through that method would not check what is passed for it
// `@isolating` sits between `@isolated` and `@sendable`: a parameter so marked holding a function may
// be passed on for an `@isolating` or an `@isolated` one, and one marked `@sendable` for an
// `@isolating` one, but not the other way: what an `@isolating` argument captures may be a `var`, so
// it may not run on another thread. A method may not mark its parameter `@isolating` where the
// method it overrides does not.
import avin.actors.isolate
import avin.threads.{Mutex, spawn}

viaSendable(@sendable make: () -> Buffer[int]) = isolate(make())

viaIsolating(m: Mutex[Buffer[int]], @isolating make: () -> int) -> int
  m.with(b -> make())

toThread(@isolating make: () -> int) = spawn(make)

open class Base
  run(f: () -> int) -> int = f()

class Derived(): Base
  override run(@isolating f: () -> int) -> int = f()

main()
  var count = 0
  println(viaIsolating(Mutex(Buffer[int]()), () ->
    count += 1
    count))
