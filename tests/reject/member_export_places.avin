// error: a trait holds no value to export members of; a class conforming to it may, and an export it names implements the trait's method of that name
// error: an export goes in a type's own body, or in a plain `impl` of a data type, not in an impl of a trait; one it names there implements the trait's method of that name
// error: a class declares its exports in its own body
// error: an export in an impl presents members on a data type the impl's module declares
// An export stands in the body of a class or an object, or in a plain impl of a data type of the
// impl's module: not in a trait, an impl of a trait, an impl of a class, or an impl of a built-in type.
class Counter(var count: int)
  bump() = count += 1

trait Shown
  export inner.count

data Point(c: Counter)

impl Display for Point
  export c.count
  display(out: Writer, spec: FormatSpec) = out.write("p")

class Plain(c: Counter)

impl Plain
  export c.bump

impl string
  export bytes.length

main() = ()
