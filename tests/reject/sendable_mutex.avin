// error: `get` needs `T: Sendable`, which Mutex[Buffer[int]] does not meet
// A mutex's value is made in its argument, which may use only sendable values from around it; a
// `with` body gives back only a sendable value and may use nothing from around it that is not
// sendable, so the guarded buffer cannot be returned, stored in an outer `var`, or fed an outer buffer.
// `get` exists only for a sendable value.
import avin.threads.Mutex

main()
    val b = Buffer[int]()
    val m = Mutex(b)
    val fresh = Mutex(Buffer[int]())
    val out = fresh.with(x -> x)
    var leak = Buffer[int]()
    fresh.with(x ->
        leak = x
        0)
    val extra = Buffer[int]()
    fresh.with(x -> x.addAll(extra))
    val g = fresh.get()
