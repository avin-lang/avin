// error: a lambda that captures `self` is made before `limit` is initialized
// error: a lambda that captures `self` is made before `end` is initialized
// error: `peek`, which uses `self`, is called before `stop` is initialized
// error: an argument passed by name uses `self` before `after` is initialized
twice(f: () -> int) -> int = f() + f()

lazily(x: -> int) -> int = x

class Watch(start: int)
  val reader = () -> start
  val limit = 10

class Nested(start: int)
  println(s"${twice(() -> twice(() -> start))}")
  val end = 1

class Local(start: int)
  if start > 0
    peek() -> int = start + 1
    println(s"${peek()}")
  val stop = 2

class Delay(start: int)
  println(s"${lazily(start)}")
  val after = 3

main() = ()
