// error: a range's bounds have one integer type, not i8 and long
// error: a range counts integers, not string
// error: expected NumericRange[i8], found NumericRange[long]
// error: integer literal does not fit in i8
// error: expected Range, found NumericRange[long]
// What a range written as a value cannot be: bounds of two integer types, bounds that are not
// integers, a range of one integer type used as another, a step of another type, and a range of
// `long`s where the `int` range is asked for.

big() -> long = 5

main()
  val small: i8 = 1
  val a = small .. big()
  val b = "a" .. "b"
  val c: NumericRange[i8] = big() .. 9
  val d = (small .. 3) by 2000
  val e: Range = 1 .. big()
