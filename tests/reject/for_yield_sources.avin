// error: `int` has no method `map`, which a `for` with `yield` calls on its source
// error: `Bag` has no method `flatMap`, which a `for` with `yield` calls on its source
// error: `Bag` has no method `withFilter` or `filter`, which a guard of a `for` with `yield` calls on its source
// error: this guard yields string, not bool
// error: a binding's pattern must match every Option[int] value; take the value apart with `match`
// A `for` with `yield` calls `map`, `flatMap` and `withFilter` on its sources, so each source needs
// the ones it is asked for; a guard is a `bool`; and a generator's pattern matches every element.

class Bag(val n: int)
  map[U](f: (int) -> U) -> Option[U] = Some(f(n))

main()
  val xs: List[int] = [1, 2]
  val a = for x in 5 yield x
  val b = for x in Bag(1), y in xs yield x + y
  val c = for x in Bag(1) if x > 0 yield x
  val d = for x in xs if "yes" yield x
  val options: List[Option[int]] = [Some(1), None]
  val e = for Some(y) in options yield y
