// error: this source is an `int`, which is neither an `Iterable` nor a `Functor`, and the last generator draws only from those
// error: this source is a `Bag`, which is neither an `Iterable` nor a `Monad`, and a generator followed by another draws only from those; a type of no parameters is a source only as an `Iterable` (`impl Iterable[…] for Bag`)
// error: this source is a `Bag`, which is neither an `Iterable` nor a `Functor`, and the last generator draws only from those
// error: this guard yields string, not bool
// error: a binding's pattern must match every Option[int] value; take the value apart with `match`
// A `for` with `yield` admits each source by conformance, whatever methods it has; a guard is a
// `bool`; and a generator's pattern matches every element.

class Bag(val n: int)
  map[U](f: (int) -> U) -> Option[U] = Some(f(n))

main()
  val xs: List[int] = [1, 2]
  val a = for x in 5 yield x
  val b = for x in Bag(1), y in xs yield x + y
  val c = for x in Bag(1) if x > 0 yield x
  val d = for x in xs if "yes" yield x
  val options: List[Option[int]] = [Some(1), None]
  val e = for Some(y) in options yield y
