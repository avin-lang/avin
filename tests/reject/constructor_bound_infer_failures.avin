// error: cannot infer `F` from `Box[int]`: `Box` does not implement `Mappable`, the bound of the constructor; a type is one only where its declaration or an impl says so
// error: cannot infer `F` from `Crate[int]`: neither `Crate` nor a superclass of it implements `Mappable`, the bound of the constructor; a type is one only where its declaration or an impl says so
// error: cannot infer `F` from `Pair[int, int]`: `Pair` implements `Mappable` as `Pair[int, _]` and `Lefty` as `Pair[_, int]`, so no one constructor is both; write it, as in `both[Pair[int, _]](arguments)`
// error: expected Option[int], found List[int]
// error: cannot infer `F` from `Tagged[int, string]`: `Tagged` does not implement `Mappable`, the bound of the constructor; a type is one only where its declaration or an impl says so
// A bounded constructor is inferred only through a conformance: a type with none, of its own or of a
// superclass, is reported naming the bound; two bounds whose conformances leave different arguments
// open are reported naming both; the types two arguments give one `F` must name one type, never
// joined to a type they share; and a type of two parameters is never taken bare by arity.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

trait Lefty[A]
  again() -> Self[A]

impl Mappable for Option

impl Mappable for List

data Box[A](value: A)

open class Base[A](val a: A)

class Crate[A](x: A): Base[A](x)

data Pair[L, R](l: L, r: R)

impl[L, R] Mappable[R] for Pair[L, R]
  map[B](f: (R) -> B) -> Pair[L, B] = Pair(l, f(r))

impl[L, R] Lefty[L] for Pair[L, R]
  again() -> Pair[L, R] = self

data Tagged[A, B](a: A, b: B)

incr[F[_]: Mappable](x: F[int]) -> F[int] = x.map(n -> n + 1)

both[F[_]: Mappable & Lefty](x: F[int]) -> F[int] = x.again()

second[F[_]: Mappable](x: F[int], y: F[int]) -> F[int] = y

main()
  println(incr(Box(1)))
  println(incr(Crate(1)))
  println(both(Pair(1, 2)))
  println(second(Some(1), List(2)))
  println(incr(Tagged(1, "t")))
