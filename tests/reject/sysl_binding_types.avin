// A binding's parameters and result are the types that cross to Sysl, a type parameter where it is
// bounded by `Boundary`.
// error: `T` cannot cross to Sysl; a type parameter crosses as the type it is given, which its bound holds to one Sysl type, as in `[T: Boundary]`
// error: a by-name parameter cannot cross to Sysl
// error: `i24` cannot cross to Sysl; a binding's parameters and result are integers of 8, 16, 32 or 64 bits, `byte`, `real`, `char`, `bool`, `unit`, `string`, data types declared with `@sysl` to mirror a Sysl enum or struct, and `Array`, `Vector`, `Option`, `Result` and tuples of these
// error: `Shape` cannot cross to Sysl
// error: `(int, i24)` cannot cross to Sysl

data Shape
  Circle(r: int)
  Square(side: int)

@sysl("sysl.text.to_upper")
generic[T](s: T) -> string

@sysl("sysl.text.to_upper")
delayed(s: -> string) -> string

@sysl("sysl.text.to_upper")
odd(n: i24) -> string

@sysl("sysl.text.to_upper")
shaped(s: Shape) -> string

@sysl("sysl.text.to_upper")
paired(s: string) -> (int, i24)

main() = 0
