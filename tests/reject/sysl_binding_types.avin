// A binding's parameters and result are the types that cross to Sysl, and it is not generic yet.
// error: generic Sysl bindings are not implemented
// error: a by-name parameter cannot cross to Sysl
// error: `i24` cannot cross to Sysl; a binding's parameters and result are integers of 8, 16, 32 or 64 bits
// error: `Shape` cannot cross to Sysl
// error: `(int, int)` cannot cross to Sysl

data Shape
    Circle(r: int)
    Square(side: int)

@sysl("sysl.text.to_upper")
generic[T](s: T) -> string

@sysl("sysl.text.to_upper")
delayed(s: -> string) -> string

@sysl("sysl.text.to_upper")
odd(n: i24) -> string

@sysl("sysl.text.to_upper")
shaped(s: Shape) -> string

@sysl("sysl.text.to_upper")
paired(s: string) -> (int, int)

main() = 0
