// error: `Box.make` implements `Maker.make`, whose type parameter `T` is not bounded by Display
// error: `Box.fallback` implements `Maker.fallback`, whose type parameter `T` is not bounded by Ord
// error: `convert` overrides `Source.convert`, whose type parameter `U` is not bounded by Into[string]
// error: `held` overrides `Holder.held`, whose type parameter `W` is not bounded by Into[T]
// A static method an impl implements and a default method an impl replaces add no bound either; a
// generic bound is implied only at the same type arguments, the class's own parameters substituted.
trait Maker
  static make[T](x: T) -> int
  fallback[T](x: T) -> int = 0

data Box(n: int)

impl Maker for Box
  static make[T: Display](x: T) -> int = 1
  override fallback[T: Ord](x: T) -> int = 2

trait Into[R]
  into() -> R

open class Source
  convert[U: Into[int]](x: U) -> int = x.into()

class Narrow: Source
  override convert[U: Into[string]](x: U) -> int = 0

open class Holder[T]
  held[W: Into[T]](x: W) -> int = 0

class Ints: Holder[int]
  override held[W: Into[int]](x: W) -> int = 1

class Mixed[T]: Holder[string]
  override held[W: Into[T]](x: W) -> int = 2

main() -> int = 0
