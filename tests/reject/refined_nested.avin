// error: polymorphic recursion: each round of the cycle `Lift` -> `Expr` -> `Lift` passes `Vector[A]` for `T`, so its type arguments grow without end and the code has no finite set of copies: the field `x` of `Lift` has type `Expr[Vector[A]]`, and `Lift` makes `Expr[A]`
// error: the field `x` of `Deeper` has type `Option[Wrapped[(A, A)]]`, and `Deeper` makes `Wrapped[A]`
// error: each round of the cycle `Pairs` -> `Pairs` passes `(T, T)` for `T`
// error: the field `back` of `Back` has type `Outer[Nest[A]]`, and `Back` makes `Inner[A]`
// A field may not name its type at a larger instance than the variant makes, also inside another
// type or through a second data type, as a nested data type may not; a variant whose result is
// written as the type at its own parameters is a plain one, reported as before. Growth measured against the result is allowed where it shrinks (`Pair`), and a
// larger part made of a hidden parameter is allowed (`First`, `Hide`): its instances exist only where
// the program makes a value.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  Lift[A](x: Expr[Vector[A]]) -> Expr[A]
  First[A, B](pair: Expr[(A, B)]) -> Expr[A]
  Hide[A](x: Expr[Vector[A]]) -> Expr[int]
  Pair[A, B](first: Expr[A], second: Expr[B]) -> Expr[(A, B)]
  Same(inner: Expr[T]) -> Expr[T]

data Wrapped[T]
  Done(value: T)
  Deeper[A](x: Option[Wrapped[(A, A)]]) -> Wrapped[A]

data Pairs[T]
  Stop(value: T)
  Grow(value: T, rest: Pairs[(T, T)]) -> Pairs[T]

data Nest[T](x: T)

data Outer[T]
  Leaf(value: T)
  Via[A](inner: Inner[A]) -> Outer[A]

data Inner[T]
  Back[A](back: Outer[Nest[A]]) -> Inner[A]

main() = ()
