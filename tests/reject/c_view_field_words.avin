// A field accessor lends the memory its field points at only when it says `view`, with `length:`, and
// `writable` and `length:` mark such an accessor; a writer lends nothing.
// error: C keeps no length with the memory the field of `noLength` points at, so the accessor says it with `length:`, a C expression in `self`, as in `length: "self->size"`
// error: `length:` is the length of the memory a field accessor marked `view` lends, and this one lends none
// error: `writable` marks a field accessor that lends a `MutByteView`, with `view`
// error: the field accessor `setBuffer` answers `unit`, so it writes its field, and `view` lends the memory a field points at, which only a reader answers
// error: `view` is said once
import avin.c.ByteView

@c(type: "struct face *", release: "free")
class Face
  @c(field: "buffer", view)
  noLength() -> ByteView

  @c(field: "rows", length: "4")
  lengthAlone() -> int

  @c(field: "rows", writable)
  writableAlone() -> int

  @c(field: "rows", view, length: "4")
  setBuffer(b: byte)

  @c(field: "buffer", view, view, length: "4")
  twice() -> ByteView

main() = 0
