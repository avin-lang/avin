// error: `<` needs (bool, int) to implement `Ord`
// error: `<` needs (unit, int) to implement `Ord`
// error: `Either[bool, int]` does not conform to `Ord`, the bound of `T` in `smaller`
// A tuple, an either or a result is ordered only when every part is, and `bool` and `unit` have no order.
smaller[T: Ord](a: T, b: T) -> T = a

main()
  println((false, 1) < (true, 0))
  println(((), 1) < ((), 2))
  val a: Either[bool, int] = Left(true)
  println(smaller(a, a).isLeft)
