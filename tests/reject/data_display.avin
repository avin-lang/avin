// error: `Inner` does not conform to `Display`, the bound of `T` in `shown`; `Inner` has no `Display` because its field `plain` has type `Plain`, which does not implement `Display`
// error: `Outer` does not implement `Display`, so it cannot be interpolated; `Outer` has no `Display` because its field `inner` has type `Inner`, which does not implement `Display`
// error: `Pick` does not conform to `Debug`, the bound of `T` in `debug`; `Pick` has no `Debug` because its field `Two.p` has type `Plain`, which does not implement `Debug`
// error: `Option[Plain]` does not conform to `Debug`, the bound of `T` in `assertEq`
// error: `Named` does not conform to `Display`, the bound of `T` in `shown`
// A data type has `Display` and `Debug` without asking only where every field has them; a field
// without one leaves the type without it, and a use that needs it names the field. A type whose own
// impl declares the method has no automatic one.
class Plain

data Inner(plain: Plain, n: int)

data Outer(inner: Inner)

data Pick
    One(n: int)
    Two(p: Plain)

data Named(n: int)

impl Named
    display() -> string = "named"

shown[T: Display](value: T) -> string = value.toString()

main()
    println(shown(Inner(Plain(), 1)))
    println(s"${Outer(Inner(Plain(), 1))}")
    println(debug(One(1)))
    assertEq(Some(Plain()), Some(Plain()))
    println(shown(Named(1)))
