// Each operand of a type parameter's bounds is a trait or a class, with at most one class among
// them, whether the other class is unrelated or a subclass.
// error: a bound is a trait or a class, not int
// error: a bound is a trait or a class, not Box
// error: `T` has one class among its bounds, and `Animal` and `Plant` are both classes; the others are traits
// error: `T` has one class among its bounds, and `Animal` and `Dog` are both classes; the others are traits
trait Named
  name() -> string

trait Sized
  size() -> int

open class Animal
open class Plant
class Dog: Animal

data Box(n: int)

builtin[T: Named & int](x: T) -> int = 1

datum[T: Box & Sized](x: T) -> int = 1

classes[T: Animal & Named & Plant](x: T) -> int = 1

subclass[T: Animal & Dog](x: T) -> int = 1

main()
  println(1)
