// A public field implements an abstract method declared with no parameter list, so its type is the
// method's result; a private one does not.
// error: the field `name` is int, but `Named`'s `name`, which it implements, yields string
// error: `sound` overrides `Animal.sound`, which yields string, not int
// error: `Q` does not implement `name` from `Named`: its field `name` is private, and only a public field implements a method; make the field public

trait Named
  name -> string

class P: Named
  val name = 3

abstract class Animal
  sound -> string

class D: Animal
  val sound = 4

class Q: Named
  private val name = "x"

main() = 0
