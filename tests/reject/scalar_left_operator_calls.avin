// error: expected Vec, found Money
// error: `+` needs two numbers of one type, not real and Vec
// error: `*=` needs two numbers of one type, not real and Vec
// error: this call to `*` is ambiguous: `int.*(s: Shape)`, `int.*(s: Solid)` each accept it, and none is more specific than the others
// error: `<` is a method of int yielding Vec, and a link of a comparison chain must yield `bool`; join the comparisons with `&&`, or parenthesize one
// A built-in value on an operator's left calls a method its type was added only where one takes the
// right operand: another operand is an argument error, an operator with no method stays the
// machine's, a compound assignment keeps its target's type, overloads one operand fits equally are
// ambiguous, and a chain's link through such a method must yield `bool`.
data Vec(x: real, y: real)

data Money(cents: long)

trait Shape
  area() -> real

trait Solid
  volume() -> real

class Cube(val s: real) : Shape, Solid
  override area() -> real = s * s
  override volume() -> real = s * s * s

impl real
  *(v: Vec) -> Vec = v

impl int
  *(s: Shape) -> real = 1.0
  *(s: Solid) -> real = 2.0
  <(v: Vec) -> Vec = v

main()
  var k = 2.0
  val v = Vec(1.0, 2.0)
  val m = Money(3)
  println(k * m)
  println(k + v)
  k *= v
  println(3 * Cube(1.0))
  println(1 < 2 < v)
