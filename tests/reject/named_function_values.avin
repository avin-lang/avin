data Point(x: int, y: int)

main()
    val f = (x: int) -> x + 1
    f(x = 1)
    Point(x = 1, z = 2)
    Point(x = 1)

    // A local function's default sees what is declared before it, not after.
    sized(n: int = size) -> int = n
    val size = 3
    sized()
