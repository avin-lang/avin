// error: a method takes no `open`: every public method of an `open` or `abstract` class, and every method of a trait, may be overridden already; remove `open`
// error: a method takes no `abstract`: one declared without a body, `name() -> T`, is abstract already, which only an `abstract` class or a trait allows; remove `abstract`
// error: a method takes no `open`: every public method of an `open` or `abstract` class, and every method of a trait, may be overridden already; remove `open`
// error: a method takes no `open`: every public method of an `open` or `abstract` class, and every method of a trait, may be overridden already; remove `open`
// error: a method takes no `abstract`: one declared without a body, `name() -> T`, is abstract already, which only an `abstract` class or a trait allows; remove `abstract`
// The same holds in a trait, an object, an impl, a method written with `def`, a static method, and
// a generic method.

trait Named
    open name() -> string

object Registry
    abstract count() -> int = 0

impl Display for int
    open display(out: Writer, spec: FormatSpec) = out.write("n")

class Box[T](item: T)
    open def peek -> T = item
    static abstract make[U](u: U) -> Box[U] = Box(u)

main() = ()
