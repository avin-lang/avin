// error: uses `it`, a `MatchIterator`
// error: `Buffer[Regex]` does not conform to `Sendable`
// A compiled `Regex` and a `Match` are sendable, but a `MatchIterator` is a search in progress and
// is not, and a mutable collection of regexes is not either.
import avin.regex.Regex
import avin.threads.spawn

hold[T: Sendable](value: T) -> int = 0

main()
  val word = Regex("[a-z]+")
  val it = word.findAllIn("a b c")
  spawn(() -> it.hasNext()).join()
  hold(Buffer[Regex]())
