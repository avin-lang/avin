// error: `updated` overrides `Bag.updated`, whose type parameter `W` has the lower bound V, not K
// error: `removed` overrides `Bag.removed`, whose parameter `key` is K, not int
// error: `removed` overrides `Bag.removed`, which yields Bag[K, V], not Any
// error: `size` overrides `Bag.size`, which takes 0 parameters, not 1
// error: the covariant type parameter `+V` appears in a contravariant position, the result of `label`
// A trait's override without a body takes the parameters of the method it overrides and yields its
// result or a type conforming to it, and its result is checked against the trait's variance.
trait Marker

trait Hook[-T]: Marker
    call(x: T)

trait Bag[K, +V]
    size() -> int
    updated[W >: V](key: K, value: W) -> Bag[K, W]
    removed(key: K) -> Bag[K, V]
    label() -> Marker

trait Bound[K, +V]: Bag[K, V]
    override updated[W >: K](key: K, value: W) -> Bound[K, W]

trait Params[K, +V]: Bag[K, V]
    override removed(key: int) -> Params[K, V]

trait Wider[K, +V]: Bag[K, V]
    override removed(key: K) -> Any

trait Count[K, +V]: Bag[K, V]
    override size(limit: int) -> int

trait Variant[K, +V]: Bag[K, V]
    override label() -> Hook[V]

main() = ()
