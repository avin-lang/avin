// A field is read as an integer type, `byte`, `bool`, `real`, a string or a lent handle of a class
// declaring `retain`, and written as a scalar; `bound:` gives one bound for each index.
// error: the field accessor `setName` writes `string`, and a field is written as an integer type, `byte`, `bool`, `real` or an enum mirror; a string or handle field is only read
// error: the field accessor `maybeWidth` answers `Option[int]`, and a field is read as an integer type, `byte`, `bool`, `real`, an enum mirror, a string or a handle
// error: the field accessor `plain` reads a `Plain`, and `Plain` declares no `retain`: a handle read from a field is lent, and kept only by a reference of its own
// error: the field accessor `grid` takes 2 indices and `bound:` gives 1 bound: one for each, in order
// error: the field accessor `setNothing` answers `unit`, so it writes its field, and takes the value written as its last parameter

@c(type: "struct plain *", release: "free")
class Plain

@c(type: "struct thing *", release: "free")
class Thing
    @c(field: "name")
    setName(value: string)

    @c(field: "width")
    maybeWidth() -> Option[int]

    @c(field: "plain")
    plain() -> Plain

    @c(field: "grid[r][c]", bound: "self->rows")
    grid(r: int, c: int) -> int

    @c(field: "width")
    setNothing()

main() = 0
