// A contextual parameter of a tuple or a union is refused as one of a built-in type is, and a trait
// that is only a bound, naming `Self`, is no contextual parameter's type. Each refusal is reported
// on a method, a top-level function, an impl's method and a local function alike.
// error: a contextual parameter is of a class, object, trait or data type: `(int, string)` would be given
// error: a contextual parameter is of a class, object, trait or data type: `int | string` would be given
// error: a contextual parameter is of a class, object, trait or data type: `string` would be given
// error: a contextual parameter is of a class, object, trait or data type: `bool` would be given

class Pair
  both(using p: (int, string)) -> int = 0

either(using u: int | string) -> int = 0

impl int
  named(using label: string) -> int = 0

main()
  local(using flag: bool) -> int = 0
  println(local(flag = true))
