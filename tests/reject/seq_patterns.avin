// error: this `match` does not cover every Vector[int] value, such as `[_, _, _, _*]`; add an arm for it, or `_` for the rest
// error: this pattern is string, but the value it matches is int
// error: sequence patterns match a `Seq`, not Option[int]

// A sequence pattern matches one length only, so a match of nothing but them needs a catch-all; its
// elements are matched as the sequence's element type; and it takes apart sequences alone.

main()
    val v = [1, 2]
    v match
        [] -> println(0)
        [a] -> println(a)
        [a, b] -> println(a + b)
    v match
        ["one", _] -> ()
        _ -> ()
    val o: Option[int] = Some(1)
    o match
        [x] -> ()
        _ -> ()
