// A field accessor has no prototype and takes only `field:`, `bound:`, `length:`, `view` and
// `writable`, its field written; and it keeps nothing, so it reads no handle of a class that names
// what it keeps.
// error: a field accessor names its field with `field:` and has no prototype: the field's type is the header's
// error: `borrowed` is not a word of a field accessor, which takes `field:`, `bound:`, `length:`, `view` and `writable`; a handle it reads is always lent, and takes a reference of its own
// error: `free:` is not a word of a field accessor, which takes `field:`, `bound:`, `length:`, `view` and `writable`
// error: `field:` names the field, a C lvalue in the struct `self` points at, as in `field: "width"`
// error: `MMVar` names what it keeps with `kept:`, so only a binding keeping one makes it, and the field accessor `mm` keeps nothing

@c(type: "struct face *", release: "free", retain: "face_ref")
class Face

@c(type: "struct mm *", kept: "face: Face", release: "mm_free(face, self)", retain: "mm_ref(face, self)")
class MMVar

@c(type: "struct thing *", release: "free")
class Thing
    @c("int width(struct thing *self)", field: "width")
    prototyped() -> int

    @c(field: "width", borrowed)
    lent() -> int

    @c(field: "name", free: "free")
    freed() -> string

    @c(field: " ")
    blank() -> int

    @c(field: "mm")
    mm() -> MMVar

main() = 0
