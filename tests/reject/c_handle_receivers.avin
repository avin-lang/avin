// A C handle's method takes its receiver first, named `self`, of the class's own C type, and every
// handle crosses as its class's C type.
// error: the prototype of a C handle's method takes the receiver first, named `self`, as in `int cairo_status(cairo_t *self)`
// error: the receiver `self` of `other` is a `Counted`, whose C type is `struct thing *`, and the prototype says `struct other *`
// error: parameter 1 of the C binding `add` is `Counted` in Avin and `struct other *` in C: a `Counted` crosses as its C type, `struct thing *`
// error: the result of the C binding `parent` is `Counted` in Avin and `struct other *` in C: a `Counted` crosses as its C type, `struct thing *`
// error: `keeps: "self"` makes the handle a method answers keep its receiver, and `both` answers no handle

@c(type: "struct thing *", release: "thing_free", retain: "thing_ref")
class Counted
  @c("int thing_size(int n, struct thing *self)")
  size(n: int) -> int
  @c("int thing_size(struct other *self)")
  other() -> int
  @c("int thing_add(struct thing *self, struct other *t)")
  add(t: Counted) -> int
  @c("struct other *thing_parent(struct thing *self)")
  parent() -> Counted
  @c("int thing_size(struct thing *self)", keeps: "self")
  both() -> int

main() = 0
