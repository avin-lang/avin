// error: a lambda that captures `self` is made in a superclass's arguments, which run before the object is initialized
// error: a lambda that captures `self` is made in a superclass's arguments, which run before the object is initialized
// error: `describe` is a method, which a superclass's arguments cannot call: they run before the object is initialized
// error: a lambda that captures `self` is made in a superclass's arguments, which run before the object is initialized
// error: a lambda that captures `self` is made in a superclass's arguments, which run before the object is initialized
open class Base[T](f: () -> T)
  val got: T = f()

// A generic superclass, at a reference type whose field would be read unset.
class Names: Base[Vector[string]](() -> names)
  val names: Vector[string] = ["a"]

// A lambda made inside a lambda: the outer one captures `self` for the inner one.
twice(f: () -> long) -> long = f() + f()
class Nested: Base[long](() -> twice(() -> n))
  val n: long = 3

// A lambda calling a method of the object.
class Calls: Base[string](() -> describe())
  val label: string = "calls"
  describe() -> string = label

open class Pair(p: (() -> long, long))
  val got: long = p.0()

// A lambda in a tuple argument.
class InTuple: Pair((() -> t, 1))
  val t: long = 5

// A lambda through two levels of superclass: `Middle` passes it on to `Base`.
open class Middle(g: () -> long): Base[long](g)
class Deep: Middle(() -> d)
  val d: long = 8

main()
  println(Names().got.size)
  println(Nested().got)
  println(Calls().got)
  println(InTuple().got)
  println(Deep().got)
