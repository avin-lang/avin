// error: `shipped` is for a `@sendable` function of 1 parameter; this is `(int) -> int`
// error: `shipped` is for a `@sendable` function of 1 parameter; this is `Lengths`
// error: an impl of a trait is for a data type, a class, an object or a built-in type
// Methods added to a `@sendable` function type reach only `@sendable` functions, not a plain one,
// nor a value of a type naming a plain function type; and no impl of a trait is for a function type.
trait Named
    name() -> string

data Lengths(extra: int)

impl (string) -> int for Lengths
    apply(s: string) -> int = s.charCount() + extra

impl[A, B] @sendable (A) -> B
    shipped() -> string = "sendable"

impl Named for @sendable (int) -> int
    name() -> string = "function"

main()
    val plain: (int) -> int = x -> x
    println(plain.shipped())
    println(Lengths(0).shipped())
