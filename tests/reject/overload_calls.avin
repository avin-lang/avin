// error: this call to `wide` is ambiguous: `wide(n: int)`, `wide(n: long)` each accept it
// error: this call to `measure` is ambiguous: `measure(n: int)`, `measure(r: real)` each accept it
// error: no overload of `describe` accepts these arguments; the overloads are `describe(n: int)`, `describe(s: string)`
// error: this call to `sized` is ambiguous: `sized(n: int)`, `sized(n: int, scale: int)` each accept it
// error: no overload of `describe` accepts these arguments
// A literal fits every overload whose parameter it can become, and neither of `int` and `long`, nor
// of `int` and `real`, is more specific than the other. A default that lets two overloads accept the
// same arguments makes the call ambiguous.
wide(n: int) -> string = "int"
wide(n: long) -> string = "long"

measure(n: int) -> string = "int"
measure(r: real) -> string = "real"

describe(n: int) -> string = "int"
describe(s: string) -> string = "string"

sized(n: int) -> int = n
sized(n: int, scale: int = 2) -> int = n * scale

main()
    print(wide(1))
    print(measure(1))
    print(describe(true))
    print(s"${sized(1)}")
    print(describe(text = "x"))
