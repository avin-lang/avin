// error: this call to `wide` is ambiguous: `wide(n: long)`, `wide(r: real)` each accept it
// error: this call to `leaning` is ambiguous: `leaning[T](n: int, x: T)`, `leaning(n: long, s: string)` each accept it
// error: no overload of `describe` accepts these arguments; the overloads are `describe(n: int)`, `describe(s: string)`
// error: this call to `sized` is ambiguous: `sized(n: int)`, `sized(n: int, scale: int)` each accept it
// error: no overload of `describe` accepts these arguments
// A literal fits every overload whose parameter it can become. It prefers `int`, but where neither
// overload takes the literal's own type the call is ambiguous, and so it is where an argument that is
// not a literal makes another overload the more specific. A default that lets two overloads accept the
// same arguments makes the call ambiguous.
wide(n: long) -> string = "long"
wide(r: real) -> string = "real"

leaning[T](n: int, x: T) -> string = "int T"
leaning(n: long, s: string) -> string = "long string"

describe(n: int) -> string = "int"
describe(s: string) -> string = "string"

sized(n: int) -> int = n
sized(n: int, scale: int = 2) -> int = n * scale

main()
    print(wide(1))
    print(leaning(1, "a"))
    print(describe(true))
    print(s"${sized(1)}")
    print(describe(text = "x"))
