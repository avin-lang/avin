// The words of a binding that lends memory: `writable` only with a view, a view lent only by a method
// of a C handle, which is its lender, given a `length:`, never freed by `free:`, and one view or array
// to a binding.
// error: `writable` marks a binding that lends a `MutByteView`, with `view` or `view:`
// error: a view is valid until the handle that lent it is used again, so it is lent by a method of a C handle, its lender
// error: C answers the memory a `view` lends with no length of its own, so the binding says it with `length:`, a C expression over the call's parameters, as in `length: "stride * height"`
// error: a view lends memory C owns and frees itself; `free:` frees an array C answers and the binding copies
// error: `view` lends the memory C answers as its result, and `view:` names an out parameter too; a binding answers one array or view
import avin.c.{ByteView, MutByteView}

@c(type: "struct frame *", release: "free")
class Frame
    @c("int frame_size(struct frame *self)", writable)
    size() -> int

    @c("unsigned char *frame_data(struct frame *self)", view)
    noLength() -> ByteView

    @c("unsigned char *frame_data(struct frame *self)", view, length: "4", free: "free")
    freed() -> ByteView

    @c("unsigned char *frame_image(struct frame *self, out unsigned char **buffer)", view, view: "buffer", length: "4")
    both() -> (ByteView, ByteView)

@c("unsigned char *frame_data(struct frame *f)", view, length: "4")
topLevel(f: Frame) -> ByteView

main() = 0
