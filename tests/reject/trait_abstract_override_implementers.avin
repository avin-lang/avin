// error: `Row.updated` implements `SortedBag.updated`, which yields SortedBag[int, W], not Bag[int, W]
// error: `Tree` does not implement `describe` from `SortedBag`; implement it, or declare `Tree` abstract
// error: `Tree.updated` implements `SortedBag.updated`, which yields SortedBag[int, W], not Bag[int, W]
// error: `Plain.updated` implements `SortedBag.updated`, which yields SortedBag[int, W], not Bag[int, W]
// A type implementing a trait that re-declares a method without a body implements the narrowest
// declaration: its method yields the narrower result, and a default the re-declaration replaced is not
// inherited. A method inherited from a superclass that yields only the wider result does not
// implement it either.
trait Bag[K, +V]
  size() -> int
  updated[W >: V](key: K, value: W) -> Bag[K, W]
  describe() -> string = "bag"

trait SortedBag[K, +V]: Bag[K, V]
  override updated[W >: V](key: K, value: W) -> SortedBag[K, W]
  override describe() -> string

data Row[+V](n: int)

impl[V] SortedBag[int, V] for Row[V]
  size() -> int = n
  updated[W >: V](key: int, value: W) -> Bag[int, W] = Row(n + 1)

class Tree[V](n: int): SortedBag[int, V]
  override size() -> int = n
  override updated[W >: V](key: int, value: W) -> Bag[int, W] = Tree(n + 1)

open class Plain[V](n: int): Bag[int, V]
  override size() -> int = n
  override updated[W >: V](key: int, value: W) -> Bag[int, W] = Plain(n + 1)

class Sorted[V](n: int): Plain[V](n), SortedBag[int, V]
  override describe() -> string = "sorted"

main() = ()
