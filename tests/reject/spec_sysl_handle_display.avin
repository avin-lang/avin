// A Sysl handle has no `Display` of its own.
// error: `Crc32` does not implement `Display`, so it cannot be interpolated
// error: expected Display, found Crc32
@sysl("sysl.checksum.Crc32")
class Crc32
  finish() -> long

@sysl("sysl.checksum.new_crc32")
newCrc32() -> Crc32

main()
  val c = newCrc32()
  println(s"$c")
  val shown: Display = c
