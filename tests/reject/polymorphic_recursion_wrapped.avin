// error: each round of the cycle `Nest` -> `Nest` passes `List[T]` for `T`, so its type arguments grow without end
// error: each round of the cycle `Grow` -> `Grow` passes `(T, T)` for `T`
// error: each round of the cycle `Up` -> `Down` -> `Up` passes `Vector[T]` for `T`
// error: each round of the cycle `Cell.size` -> `hop` -> `viaBound` -> `Cell.size` passes `Cell[Option[T]]` for `S`
// A data type naming itself at a larger instance inside another type, as `Option[Nest[List[T]]]`, is
// still nested, directly or through a second type, and each such type is reported at the type even
// where its derived methods close cycles through it too; and growth that reaches an implementation
// through a bound after passing through other generic code unchanged is still found.

data Nest[T](x: T, inner: Option[Nest[List[T]]])

data Grow[T](x: T, kids: Vector[Grow[(T, T)]])

data Up[T](x: T, down: Option[Down[Vector[T]]])

data Down[T](x: T, up: Either[string, Up[T]])

trait Sized
  size(n: int) -> int

class Cell[T](val x: T): Sized
  override size(n: int) -> int = if n == 0 then 0 else hop(Cell(Some(x)), n - 1)

hop[S: Sized](s: S, n: int) -> int = viaBound(s, n)

viaBound[R: Sized](r: R, n: int) -> int = r.size(n)

main() -> int
  val n: Nest[int] = Nest(1, None)
  val g: Grow[int] = Grow(1, [])
  val u: Up[int] = Up(1, None)
  println(n)
  hop(Cell(1), 3)
