// error: this arm yields string, but the arms before it yield List[int]
// error: the branches of this `if` agree on no type: `Apple` and `string`
// error: the branches of this `if` agree on no type: `List[int]` and `List[string]`
// error: this `break` yields int, but the loop yields Vector[int]

// The type expected of branches joins them only where every branch fits it: a value that is no
// `Iterable` at all, or an `Iterable` of another element type, still has no common type with the
// others, even while the expected type's arguments are being inferred.

trait Source[T]
    item() -> T

class Apple(val n: int) : Source[int]
    override item() -> int = n

fromSource[U](f: () -> Source[U]) -> U = f().item()

main()
    val v: Vector[int] = [1, 2, 3]
    val l = List.empty[int]()
    println(v.flatMap(n -> if n == 2 then l else 5))
    println(v.flatMap(n -> n match
        1 -> l
        _ -> "no"))
    println(fromSource(() -> if v.length == 3 then Apple(4) else "pear"))
    println(v.flatMap(n -> if n == 2 then l else List.empty[string]()))
    println(v.flatMap(n ->
        while n > 0
            break 7
        else v))
