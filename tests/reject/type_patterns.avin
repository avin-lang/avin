// error: a value of type int is never a string, so this type pattern never matches
// error: this `match` does not cover every Any value; add an arm for the rest, such as `_`
// error: `===` is undefined on Any and Any, which may hold values with no identity; compare with `==`, or give one side a class type
// error: `Circle` is a variant of `Shape`, not a type
// error: a value of type Dog is never a Bird, so this type pattern never matches
// Type patterns that can never match, a match on `Any` with no catch-all, and comparisons of `Any`.

data Shape
  Circle(r: int)
  Square(side: int)

open class Animal()
class Dog(): Animal()
class Bird(): Animal()

impossible(n: int) -> string = n match
  s: string -> s
  _ -> "int"

uncovered(x: Any) -> int = x match
  n: int -> n
  _: string -> 0

compared(x: Any, y: Any) -> bool = x === y

variant(x: Any) -> int = x match
  c: Circle -> 1
  _ -> 0

unrelated(d: Dog) -> int = d match
  b: Bird -> 1
  _ -> 0

main() -> int = 0
