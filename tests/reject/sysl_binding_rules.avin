// A binding is a function with no body whose `@sysl` names a Sysl function by its module and name.
// error: `@sysl` takes one string, the module and name of the Sysl function
// error: `@sysl` names a Sysl function by its module and name, as in `sysl.text.to_upper`; `to_upper` is not one
// error: `sysl..text` is not one
// error: a Sysl binding has no body: the Sysl function it names is its body
// error: a function is an intrinsic or a Sysl binding, not both

@sysl(42)
notAString(s: string) -> string

@sysl("to_upper")
unqualified(s: string) -> string

@sysl("sysl..text")
emptyPart(s: string) -> string

@sysl("sysl.text.to_upper")
withBody(s: string) -> string = s

@intrinsic("print_line")
@sysl("sysl.prints")
both(s: string)

main() = 0
