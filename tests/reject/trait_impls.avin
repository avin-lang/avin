// error: `mkString` needs `T: Display`, which Vector[Opaque] does not meet
// error: `max` needs `T: Ord`, which Seq[Opaque] does not meet
// error: `label` is ambiguous on Both: impls of `Named` and of `Titled` each add it with the same parameter types
// error: `secret` is private to the impls of `Named`
// error: `label` is ambiguous on Other: impls of `Named` and of `Titled` each add it with the same parameter types
class Opaque

trait Named
    size() -> int

trait Titled
    size() -> int

impl Named
    label() -> string = "named"
    private secret() -> int = 1

impl Titled
    label() -> string = "titled"

class Both: Named, Titled
    override size() -> int = 1

class Other: Named, Titled
    override size() -> int = 2

main()
    val opaque: Vector[Opaque] = [Opaque()]
    println(opaque.mkString())
    val seen: Seq[Opaque] = opaque
    println(seen.max().isSome())
    println(Both().label())
    println(Both().secret())
    val f: () -> string = Other().label
    println(f())
