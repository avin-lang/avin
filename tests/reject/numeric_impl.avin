// error: `Cents` does not implement `toReal` from `Numeric`
// error: `Integer` is closed: its members are the integer types, and nothing else implements it
// error: byte has no field `toReal`
// error: bool has no field `average`
// A type of a program's own implements `Numeric` in full, `toReal` included; `Integer` stays the
// integers' own. A byte is not a number, and a value that is not a collection has no mean.

data Cents(n: long)

impl Add for Cents
  add(o: Cents) -> Cents = Cents(n + o.n)
  static zero() -> Cents = Cents(0)

impl Sub for Cents
  subtract(o: Cents) -> Cents = Cents(n - o.n)

impl Mul for Cents
  multiply(o: Cents) -> Cents = Cents(n * o.n)
  static one() -> Cents = Cents(1)

impl Div for Cents
  divide(o: Cents) -> Cents = Cents(n / o.n)

impl Rem for Cents
  remainder(o: Cents) -> Cents = Cents(n % o.n)

impl Neg for Cents
  negate() -> Cents = Cents(-n)

impl Ord for Cents
  compare(o: Cents) -> int = n.compare(o.n)

impl Display for Cents
  display(out: Writer, spec: FormatSpec) = out.writeField(s"$n", spec)

impl Debug for Cents
  debug(out: Writer, spec: FormatSpec) = out.writeField(s"Cents($n)", spec)

impl Numeric for Cents

data Fake(n: int)
impl Integer for Fake

main()
  println(byte(1).toReal)
  println(true.average)
