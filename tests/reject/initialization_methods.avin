// error: `describe` is called before `label` is initialized
// error: `size` is called before `label` is initialized
// error: `measure` is called before `total` is initialized
// error: `kind` is called before `tag` is initialized
class Item(n: int)
    describe()
    val count = self.size()
    val label: string = s"item $n"

    describe() = print(label)

    size() -> int = n

class Sum(n: int)
    val total = measure()

    measure() -> int = n * total

open class Shape(n: int)
    kind() -> string = "shape"

class Square(n: int): Shape(n)
    print(super.kind())
    val tag = "square"

main() = ()
