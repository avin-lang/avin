// Only a member of a class, trait, object or impl is declared with no parameter list: a function at
// the top level or in a block takes one, and a parameterless member takes no type parameters, since
// `name[T]` would read as indexing its result.
// error: a function at the top level takes a parameter list, as in `answer() -> body`
// error: a local function takes a parameter list, as in `local() -> body`
// error: `first` has no parameter list, so it takes no type parameters

answer -> int = 42

class A
    first[T] -> int = 1

main() =
    local -> int = 1
    local
