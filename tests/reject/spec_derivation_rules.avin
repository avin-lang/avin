// A trait has one derive template. A value implementing `Annotation` annotates a data type, a class,
// a variant, a field or a class parameter; a trait, an object and a function take none.
// error: `Describe` already has a derive template; a trait has one
// error: `@Tag` cannot annotate a trait; an annotation implementing `Annotation` goes on a data type, a class, a variant, a field or a class parameter
// error: `@Tag` cannot annotate an object; an annotation implementing `Annotation` goes on a data type, a class, a variant, a field or a class parameter
// error: `@Tag` cannot annotate a function; an annotation implementing `Annotation` goes on a data type, a class, a variant, a field or a class parameter

trait Describe
  describe() -> string

derive Describe for T
  describe() -> string = "one"

derive Describe for T
  describe() -> string = "two"

data Tag(text: string)
impl Annotation for Tag

@Tag("t")
trait Marked
  mark() -> int

@Tag("o")
object Single

@Tag("f")
helper() -> int = 1

main() = 0
