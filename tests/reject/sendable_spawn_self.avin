// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it uses `self`, a `Counter`, whose field `n` is a `var`; make it a `val`
// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it uses `self`, a `Counter`, whose field `n` is a `var`; make it a `val`
// error: `run` overrides `Runner.run`, which marks its parameter `body` `@sendable` where the method it overrides does not; a call through that method would not check what is passed for it
// error: `Buffer[int]` does not conform to `Sendable`, the bound of `T` in `spawn`: it is mutable; an immutable copy (`toVector`) is sendable
// error: what is passed for `body` of `Scope.spawn` may use only sendable values from around it, but it uses `s`, a `Scope`, which is not made to be shared between threads
// A method's closure that uses a field of a mutable object captures `self`, by a lambda or as a method
// value, and is rejected. An override may not mark a parameter `@sendable` that the method it
// overrides does not; a thread's result must be sendable; and a scope is not sendable, so a thread it
// started cannot reach it.
import avin.threads.{scope, spawn}

class Counter()
    var n = 0
    tick() -> int
        n += 1
        n
    start() -> int = spawn(() -> tick()).join()
    startValue() -> int = spawn(tick).join()

open class Runner()
    run(body: () -> int) -> int = body()

class Threaded(): Runner
    override run(@sendable body: () -> int) -> int = spawn(body).join()

main()
    println(Counter().start() + Counter().startValue())
    println(spawn(() -> Buffer[int]()).join().length)
    scope(s -> s.spawn(() -> s.spawn(() -> 1).join()).join())
    ()
