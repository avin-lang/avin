// error: `G` does not implement `Mappable`, the bound of `F` in `incr`; bound it, as in `G[_]: Mappable`
// error: `Box` does not implement `Mappable`, the bound of `F` in `incr`; a type is a `Mappable` only where an impl says so, as in `impl Mappable for Box`
// error: `Sub` does not implement `Mappable`, the bound of `F` in `incr`: its superclass `Base` does, and a constructor trait's conformance is a type's own, which a subclass does not inherit; implement it for `Sub` too
// error: `Either[_, string]` does not implement `Mappable`, the bound of `F` in `incr`: `Either` implements `Mappable` as `Either[L, _]`, leaving those arguments open
// error: `Report[_, Opaque]` does not implement `Mappable`, the bound of `F` in `incr`: its impl holds only where `E` conforms to `Display`, and `Opaque` does not
// A constructor conforms to a constructor trait only by its own impl, nominally: a type with a
// matching method and no impl does not, a subclass does not inherit its superclass's conformance, a
// partial application must leave open the holes the impl does, the arguments written out meet the
// impl's bounds, and a constructor parameter passed on conforms only through its own bounds.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

incr[F[_]: Mappable](x: F[int]) -> F[int] = x.map(n -> n + 1)

data Box[T](value: T)

impl[T] Box[T]
  map[B](f: (T) -> B) -> Box[B] = Box(f(value))

open class Base[A](val item: A)
  map[B](f: (A) -> B) -> Base[B] = Base(f(item))

impl Mappable for Base

class Sub[A](item: A): Base[A](item)

impl[L, R] Mappable[R] for Either[L, R]

data Report[T, E](value: T, note: E)

impl[T, E: Display] Mappable[T] for Report[T, E]
  map[B](f: (T) -> B) -> Report[B, E] = Report(f(value), note)

class Opaque

unbounded[G[_]](x: G[int]) -> G[int] = incr[G](x)

main()
  println(incr[Box](Box(1)).value)
  println(incr[Sub](Sub(1)).item)
  println(incr[Either[_, string]](Left(1)))
  println(incr[Report[_, Opaque]](Report(1, Opaque())).value)
