// A Sysl mirror's fields are boundary types, and none of them holds the mirror itself, directly,
// in an `Option` or a `Result`, or through another mirror.
// error: `(int, Plain)` cannot cross to Sysl, so a Sysl mirror's field cannot be one
// error: `Plain` cannot cross to Sysl, so a Sysl mirror's field cannot be one
// error: a Sysl mirror cannot hold itself: `Option[Nested]` holds `Nested`
// error: a Sysl mirror cannot hold itself: `Inner` holds `Outer`
// error: a Sysl mirror cannot hold itself: `Result[Outer, int]` holds `Inner`

data Plain
    Plain(n: int)

@sysl("sysl.fs.Fields")
data Fields
    Paired(p: (int, Plain))
    Wrapped(p: Plain)

@sysl("sysl.fs.Nested")
data Nested
    Leaf
    Node(next: Option[Nested])

@sysl("sysl.fs.Outer")
data Outer
    Outer(inner: Inner)

@sysl("sysl.fs.Inner")
data Inner
    Inner(outer: Result[Outer, int])

main() = 0
