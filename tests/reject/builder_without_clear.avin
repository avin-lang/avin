// error: `BagBuilder` does not implement `clear` from `Builder`; implement it, or declare `BagBuilder` abstract

// A program's own builder defines `clear` beside `addOne` and `result`, since the trait does not; it
// may leave `sizeHint` and `knownSize` to the trait.

data Bag(items: List[int])

class BagBuilder: Builder[int, Bag]
    private var items: List[int] = Nil

    override addOne(element: int)
        items = element :: items

    override result() -> Bag = Bag(items)

main()
    val b = BagBuilder()
    b.addOne(1)
    println(b.result())
