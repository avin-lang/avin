// error: the `lazy val` `first` needs its own value to initialize: `first` → `second` → `first`
// A `lazy val` whose initializer needs its own value, here through another lazy value and the
// function its initializer calls, would wait for itself for ever: the cycle is in the code, so the
// compiler refuses it rather than leave it to a trap at run time.
lazy val first: int = second + 1

lazy val second: int = later()

later() -> int
  println("computing second")
  first * 2

main() -> int
  println("before")
  println(first)
  println("after")
  0
