// error: what is passed for `f` of `pick` may use only sendable values from around it, but it uses `f`, a `PartialFunction[char, U]`, which is a trait that does not promise to be sendable; declare it `trait PartialFunction: Sendable`, and every type implementing it is checked to be; or mark the parameter `@sendable`, and what is passed for it is checked in turn
// error: a `@sendable (char) -> Option[U]` may use only sendable values from around it, but it uses `f`, a `PartialFunction[char, U]`, which is a trait that does not promise to be sendable; declare it `trait PartialFunction: Sendable`, and every type implementing it is checked to be; or mark the parameter `@sendable`, and what is passed for it is checked in turn
// error: a `@sendable (char) -> Option[int]` may use only sendable values from around it, but it uses `h`, a `Holder`, whose field `pf` holds a `PartialFunction[char, int]`, which is a trait that does not promise to be sendable; declare it `trait PartialFunction: Sendable`, and every type implementing it is checked to be
// error: what is passed for `f` of `pick` may use only sendable values from around it, but it uses `g`, a `PartialFunction[char, int]`, which is a trait that does not promise to be sendable; declare it `trait PartialFunction: Sendable`, and every type implementing it is checked to be
// A `@sendable` parameter is sendable inside its function; an unmarked one of a trait that does not
// promise `Sendable` is not, so it is neither passed on for a `@sendable` parameter nor captured by a
// `@sendable` lambda, and the error says to mark it. A marked one stored in a data field typed as the
// trait, or copied into a local, is a value of that type again, which is not sendable.
data Rule[T](run: @sendable (char) -> Option[T])
data Holder(pf: PartialFunction[char, int])

class Counting(var n: int): PartialFunction[char, int]
  override isDefinedAt(c: char) -> bool = true
  override lift() -> char -> Option[int] = c -> Some(n)

pick[U](@sendable f: PartialFunction[char, U]) -> Rule[U] = Rule(c -> if f.isDefinedAt(c) then Some(f(c)) else None)
plain[U](f: PartialFunction[char, U]) -> Rule[U] = pick(f)
captured[U](f: PartialFunction[char, U]) -> Rule[U] = Rule(c -> f.lift()(c))

stored(@sendable f: PartialFunction[char, int]) -> Rule[int] =
  val h = Holder(f)
  Rule(c -> Some(h.pf(c)))

copied(@sendable f: PartialFunction[char, int]) -> Rule[int] =
  val g = f
  pick(g)

main() =
  println(plain(match 'a' -> 1).run('a'))
