// error: this source is a `Wrap[int]`, which is neither an `Iterable` nor a `Monad`, and a generator followed by a definition with a guard draws only from those: declare `impl Monad for Wrap`
// error: this guard filters a source that is neither an `Iterable` nor a `Filter`: this source is an `Ident[int]`: declare `impl Filter for Ident`
// error: `fa` is a `F[int]`, which is neither an `Iterable` nor a `Monad`, and a generator followed by another draws only from those: add `Monad` to the bounds of `F`
// error: this guard filters a source that is neither an `Iterable` nor a `Filter`: `fa` is a `G[int]`: add `Filter` to the bounds of `G`
// Each source of a `for` with `yield` is admitted for its role by conformance: a `Functor` only as
// the last generator, a `Monad` without a `Filter` only where no guard filters it, and, in generic
// code, by the bounds of the constructor parameter.

class Wrap[T](val value: T)
  map[U](f: (T) -> U) -> Wrap[U] = Wrap(f(value))
  flatMap[U](f: (T) -> Wrap[U]) -> Wrap[U] = f(value)

impl Functor for Wrap

data Ident[A](value: A)

impl Monad for Ident
  static pure[X](value: X) -> Ident[X] = Ident(value)

  flatMap[B](f: (A) -> Ident[B]) -> Ident[B] = f(value)

twice[F[_]: Functor](fa: F[int]) -> F[int] = for a in fa, b in fa yield a + b

small[G[_]: Monad](fa: G[int]) -> G[int] = for a in fa if a < 3 yield a

main()
  val w = Wrap(1)
  val a = for x in w, y in Wrap(2) yield x + y
  val b = for x in Wrap(1), y = x if y > 0 yield y
  val c = for x in Ident(1) if x > 0 yield x
