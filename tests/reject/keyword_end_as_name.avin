// `end = at` after a statement that has an indented body is the word `end` used as a name: one error
// naming it, never an `end` closer that swallows the line and a cascade quoting the enclosing body.

inWhile(at: int) -> int
  var i = 0
  while i < 3
    val r = if i > 1
      1
    else
      2
    end = at
    i += 1
  i

inFor(at: int) -> int
  for i in [1, 2, 3]
    val r = at match
      0 -> 1
      _ -> 2
    end = at
  at

inIf(at: int) -> int
  if at > 0
    val r =
      val z = 1
      z
    end = at
  at

inBlock(at: int) -> int
  val r = if at > 0
    1
  else
    2
  end = at
  r

inLoop(at: int) -> int
  loop
    val r = if at > 0
      1
    else
      2
    end = at
    break
  at

main() -> int = 0
