// The length of a view lent a callback is C's, so it is no parameter of the Avin function; a callback
// answers no view, which would outlive the call; and a view is never passed back to C.
// error: parameter 2 of the C binding `lengthTaken` takes the function C calls through `f`, and `(ByteView, int) -> int` cannot be it: C calls it with 1 parameter besides its `userdata` and the lengths of its views, and the function takes 2; they correspond by position
// error: parameter 2 of the C binding `answersView` takes the function C calls through `f`, and `(int) -> ByteView` cannot be it: it answers `ByteView` in Avin and `int` in C: a callback answers a scalar or an enum mirror, and no view or block: memory goes back to C only as a binding's `ByteBlock` parameter
// error: parameter 1 of the C binding `passedBack` is `ByteView` in Avin and `const unsigned char *` in C: a view is memory C lends, never passed back to C; memory C reads, writes or keeps is a `ByteBlock`
// error: `@c` takes the C function's prototype as the header writes it, as in `@c("int abs(int)")`, and this one is not: `data` is `int`, and an array is passed as a pointer to its elements, as in `uint8_t *data`
import avin.c.ByteView

@c(
  "int w(int n, int (*f)(userdata void *ud, const unsigned char *data, length(data) unsigned int length), userdata void *ud)"
)
lengthTaken(n: int, f: (ByteView, int) -> int) -> int

@c("int w(int n, int (*f)(userdata void *ud, int x), userdata void *ud)")
answersView(n: int, f: int -> ByteView) -> int

@c("long bf_sum(const unsigned char *bytes, length(bytes) int n)")
passedBack(bytes: ByteView) -> long

@c("int w(int n, int (*f)(userdata void *ud, int data, length(data) unsigned int length), userdata void *ud)")
notPointer(n: int, f: int -> int) -> int

main() = 0
