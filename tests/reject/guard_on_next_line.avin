// error: a guard on a line of its own continues the line above, not a second guard; write the guards in an indented block below the clause: `typed(…)` then `    | condition = body` for each, ending with `| _ = body`
// error: a guard on a line of its own continues the line above, not a second guard; write the guards in an indented block below the clause: `plain(…)` then `    | condition = body` for each, ending with `| _ = body`
// error: a guard on a line of its own continues the line above, not a second guard; write the guards in an indented block below the clause: `three(…)` then `    | condition = body` for each, ending with `| _ = body`
// error: a guard on a line of its own continues the line above, not a second guard; write the guards in an indented block below the clause: `inner(…)` then `    | condition = body` for each, ending with `| _ = body`
// A guard that starts a line continues the expression above it, so a second guard written on its
// own line after a one-line guard is not one; the diagnostic points at the indented block.
typed(n: int) -> int
typed(n) | n < 0 = 1
         | _ = 2

plain(n: int)
plain(n) | n < 0 = 1
         | _ = 2

three(n: int) -> int
three(n) | n < 0 = 1
         | n < 10 = 2
         | _ = 3

class Holder
    inner(n: int) -> int
    inner(n) | n < 0 = 1
             | _ = 2

main()
    ()
