// A view C lends through an out pointer is named with `view:` and given a length.
// error: out value 1 of the C binding `unnamed`, `buffer`, is `ByteView` in Avin and `unsigned char *` in C: a view C lends through `buffer` is named with `view:`, its length given with `length:`, as in `view: "buffer", length: "size"`
// error: out value 1 of the C binding `block`, `buffer`, is `ByteBlock` in Avin and `unsigned char *` in C: a `ByteBlock` is memory Avin gives C, made by `ByteBlock(length)`, never answered by C
import avin.c.{ByteBlock, ByteView}

@c(type: "struct frame *", release: "free")
class Frame
  @c("void frame_image(struct frame *self, out unsigned char **buffer)")
  unnamed() -> ByteView

  @c("void frame_image(struct frame *self, out unsigned char **buffer)")
  block() -> ByteBlock

main() = 0
