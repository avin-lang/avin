// error: `type` is not defined
// error: `type` is not defined
// error: `type` is not defined
// error: `type` is not defined
// `type` is a keyword only where a declaration begins, so on the left of `=` in a body it is an
// undefined name, once, in every body.

in_while(at: int) -> int
  var i = 0
  while i < 3
    type = at
    i += 1
  i

in_for(at: int) -> int
  for i in [1, 2, 3]
    type = at
  at

in_if(at: int) -> int
  if at > 0
    type = at
  at

in_body(at: int) -> int
  type = at
  at

main() -> int = 0
