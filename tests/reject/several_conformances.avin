// error: `Twice` already conforms to `From[int]`; a conformance is stated once
// error: `Shown` already conforms to `Show`; a type implements a trait at several type arguments only where the trait's members are all static
// error: `Half` implements `From[string]` without `static from(value: string)`
// error: `from` implements `from` of From[string], which yields Wrong, not int
// error: `T` is bounded by Make[int] and Make[long], and none of them takes `make(bool)`
// A type implements a trait at several type arguments only where the trait's members are all static,
// once for each; each conformance needs its own members, with the results the trait gives them; and
// a call on a type parameter bounded by several instances needs one whose member takes its arguments.

trait Show[T]
  show(x: T) -> string

data Twice
  Twice(n: int)

impl From[int] for Twice
  static from(value: int) -> Twice = Twice(value)

impl From[int] for Twice
  static from(value: int) -> Twice = Twice(value + 1)

data Shown
  Shown(n: int)

impl Show[int] for Shown
  show(x: int) -> string = "int"

impl Show[string] for Shown
  show(x: string) -> string = x

class Half(val n: int): From[int], From[string]
  override static from(value: int) -> Half = Half(value)

class Wrong(val n: int): From[int], From[string]
  override static from(value: int) -> Wrong = Wrong(value)
  override static from(value: string) -> int = 0

trait Make[E]
  static make(source: E) -> Self

class Pick(val n: int): Make[int], Make[long]
  override static make(source: int) -> Pick = Pick(source)
  override static make(source: long) -> Pick = Pick(0)

both[T: Make[int] + Make[long]](flag: bool) -> T = T.make(flag)

main()
  println(Twice.from(1))
