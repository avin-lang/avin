// error: a clause's arguments are patterns; their types are in the signature
// error: a guard belongs to a clause; write the clauses on the lines after the signature
// error: a comparison pattern that starts with its bound uses `<` or `<=`, as in `0 <= n < 10`
// error: a comparison pattern with two bounds puts the name between them, as in `0 <= n < 10`
// error: expected a guard, as in `| n > 0 = value`, or `| _ = value` for the rest
// The spelling of clauses, their guards, and comparison patterns.

typed(n: int) -> int
typed(n: int) = n

guarded(n: int) -> int | n > 0 = n

backwards(n: int) -> int = n match
    5 > n -> 0
    _ -> 1

chained(n: int) -> int = n match
    n < 1 < 2 -> 0
    _ -> 1

block(n: int) -> int
block(n)
    n > 0 = 1
    | _ = 0

main() -> int = 0
