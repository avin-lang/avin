// A contextual parameter is passed explicitly only by name: a positional argument written for one is
// an error saying to name it, at a function, a method, a constructor and after a repeated parameter's
// arguments, where every positional argument is the repeated parameter's.
// error: `tx` is a contextual parameter of `tag`, passed by name: `tx = …`
// error: `tx` is a contextual parameter of `put`, passed by name: `tx = …`
// error: `tx` is a contextual parameter of `Service`, passed by name: `tx = …`
// error: expected int, found Tx

data Tx(id: int)

tag(using tx: Tx) -> int = tx.id

total(xs: int*, using tx: Tx) -> int = tx.id

class Service(label: string, using tx: Tx)

class Store
  put(key: string, using tx: Tx) -> int = tx.id

main()
  val tx = Tx(1)
  println(tag(tx))
  println(Store().put("k", tx))
  val _ = Service("s", tx)
  println(total(1, 2, tx))
