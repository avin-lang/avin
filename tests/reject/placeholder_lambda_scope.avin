// error: `_` is not a value here: it stands for a lambda's parameter only within a call's argument
// error: `_` alone as an argument makes the call around it a lambda, which stands only as another call's argument or a declared `val`'s value
// error: cannot infer the type of this `_`; write the lambda out with the type, as in `(x: int) -> …`
// A `_` outside any call's argument and any declared value is no placeholder; a `_` that is a whole
// argument of a call that is itself no argument makes nothing; and an undeclared value gives its
// placeholder no type.

scale(x: int, by: int) -> int = x * by

main() -> int
    val y = 1
    val z = y + _
    scale(_, 2)
    println(take(_ + 1))
    println(y + _)
    0

take[T](f: (T) -> T) -> int = 0
