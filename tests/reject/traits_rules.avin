// error: `Blank` does not implement `area` from `Shape`; implement it, or declare `Blank` abstract
// error: `Both` inherits two implementations of `describe`, `Shape.describe` and `Labelled.describe`; override it
// error: a trait holds no state, so it cannot declare the field `count`
// error: `Shape` is a trait, so it cannot be instantiated; instantiate a class that conforms to it
// error: `Shape` has no member `side`
trait Shape
    area() -> int
    describe() -> string = "shape"

trait Labelled
    describe() -> string = "labelled"

class Blank: Shape

class Both: Shape, Labelled
    override area() -> int = 1

trait Stateful
    var count = 0

class Square: Shape
    override area() -> int = 4
    side() -> int = 2

main()
    val s = Shape()
    val q: Shape = Square()
    println(s"${q.side()}")
