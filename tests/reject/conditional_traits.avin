// error: `show` yields Box[T], not Display
// error: `Box[Plain]` does not implement `Display`, so it cannot be interpolated
// error: expected Named, found Tagged[Plain]
// error: `name` is a method of `Named`, which Tagged[Plain] does not implement
// error: expected Ro[Display], found Ro[Box[Plain]]
// A conformance through an impl with bounds of its own needs them met: in generic code by the
// parameter's own bounds, and inside a collection's element type or a covariant argument as
// anywhere else.
class Box[T](val item: T)

impl[T: Display] Display for Box[T]
    display(out: Writer, spec: FormatSpec) = item.display(out, spec)

class Plain

show[T](x: Box[T]) -> Display = x

data Tagged[T](value: T)

trait Named
    name() -> string

impl[T: Display] Named for Tagged[T]
    name() -> string = value.toString()

class Ro[+T](val item: T)

main()
    print(s"${Box(Plain())}")
    val r: Ro[Box[Plain]] = Ro(Box(Plain()))
    val s: Ro[Display] = r
    val items: Array[Named] = Array.fill(1, Tagged(Plain()))
    print(Tagged(Plain()).name())
