// error: the state `Idle` of `First` has the name of another variant of its module; a state is a variant of `First.State`, named on its own as every variant is, so it needs a name of its own
// error: expected First.State, found Ev
// error: `Idle` is a variant of `Ev`, but the value it matches is First.State
// error: the state `Ready` of `Third` has the name of another variant of its module; a state is a variant of `Third.State`, named on its own as every variant is, so it needs a name of its own
// error: `Ready` is a variant of `Second.State`, but the value it matches is Third.State
// A state is a variant of its machine's `State` type and a name of its module, so it may share its
// name with no other variant there: neither an event's nor another machine's state.
data Ev
    A
    Idle

machine First receives Ev
    state Idle
        _ -> stay
    state Running
        _ -> stay

machine Second receives Ev
    state Waiting
        _ -> Ready
    state Ready
        _ -> stay

machine Third receives Ev
    state Done
        _ -> stay
    state Ready
        _ -> stay

main() -> int = 0
