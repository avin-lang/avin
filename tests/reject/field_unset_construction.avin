// error: `LazyList` keeps fields its own code fills in, so only the class and its companion make one
// error: `LazyList` keeps fields its own code fills in, so only the class and its companion make one
// error: `LazyList` keeps fields its own code fills in, so only the class and its companion make one

// A class whose fields the core library leaves unset is made only by its own code and its
// companion's, since a cell made any other way would be read before anything is stored in it: not
// by a program, a method an impl adds to the class, or a generic function.

impl[T] LazyList[T]
  fresh() -> LazyList[T] = LazyList[T]()

made[T]() -> LazyList[T] = LazyList[T]()

main()
  val l = LazyList[string]()
  println(LazyList.from(1).take(2).toList)
