// error: `DateTime` has no field `onOrAfter`
// error: `DateTime` has no field `daysUntil`
// error: `Time` has no field `withDay`
// error: `Date` has no field `withHour`
// error: `Time` has no field `startOfDay`
// The searches and the day count are a date's alone; a time of day has no date to replace, and a
// date no hour.
import avin.time.{date, time, dateTime, Weekday}

main()
    println(dateTime(2026, 1, 1, 0, 0).onOrAfter(Weekday.Monday))
    println(dateTime(2026, 1, 1, 0, 0).daysUntil(dateTime(2026, 1, 2, 0, 0)))
    println(time(9, 0).withDay(1))
    println(date(2026, 1, 1).withHour(1))
    println(time(9, 0).startOfDay)
