// error: expected Supervision, found Executor
// error: `Restart` takes 2 arguments, not 1
// error: expected Duration, found int
// error: expected Supervision, found string
// error: `spawn` takes 3 arguments, not 4
// `spawn`'s second parameter is the supervision, so an executor is given by name; `Restart` takes a
// limit and a window, the window a `Duration`; and the supervision is one of the `Supervision`
// variants, nothing else.
import avin.actors.{Restart, Stop, spawn}
import avin.threads.Executor
import avin.time

actor Idle receives int
    receive
        _ -> ()

main()
    val ex = Executor.fixed(1)
    spawn(Idle(), ex)
    spawn(Idle(), onFailure = Restart(1))
    spawn(Idle(), onFailure = Restart(1, 5))
    spawn(Idle(), onFailure = "stop")
    spawn(Idle(), Stop, ex, 3)
