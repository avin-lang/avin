// error: expected Channel[_], found string
// error: expected int, found string; a type argument is never inferred as a union: to take either, write it, as in `[string | int]`
// error: expected Duration, found int
// error: this arm yields string, but the arms before it yield int; to keep either, declare the type it yields, such as `int | string`
// A select's operands are checked as calls are: a receive or send on what is not a channel, a value
// of the wrong type sent, an `after` that is not a duration; and its arms' types unify as a match's.
import avin.threads.Channel
import avin.time.millis

main()
  val c = Channel[int]()
  val n = 3
  select
    n.receive() as Some(x) -> println(x)
  select
    "s".send(1) -> ()
  select
    c.send("no") -> ()
  select
    c.receive() -> ()
    after 5 -> ()
  val v: string = select
    c.receive() as Some(x) -> x
    else "a"
