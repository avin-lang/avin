// error: int is neither a class nor a trait
// error: `string` is declared in another module; an impl making it a function belongs in that module
// A type after `:` that is not a function type is no parent, and a built-in type is made a function
// by no impl outside its module.

class Pair: (int)
    apply(x: int) -> int = x

impl (int) -> int for string

main()
    println(Pair()(1))
