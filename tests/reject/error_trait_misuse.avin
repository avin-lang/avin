// error: `NoMessage` does not implement `message` from `Error`; implement it in an impl of `Error`
// error: `message` takes no parameter list, so it is called without parentheses: write `message`, not `message()`
// error: `context` needs `E: Error`, which Result[int, Plain] does not meet
// error: `NotFound` is a variant of `ErrorKind`, but the value it matches is IoError
// error: `IoError` is a variant of `IoError`, but the value it matches is Error
import avin.fs
import avin.io.{IoError, NotFound}

data Plain(n: int)

data NoMessage(n: int)

impl Error for NoMessage

main()
    fs.readText("x") match
        Err(e) -> println(e.message())
        Ok(_) -> ()
    println(Err[int, Plain](Plain(1)).context("x"))
    fs.readText("x") match
        Err(NotFound) -> println("gone")
        _ -> ()
    val e: Error = IoError(NotFound)
    e match
        IoError(NotFound, _, _) -> ()
        _ -> ()
