// error: a line cannot start with the method of an infix call: end the line above with `add` and indent its argument
// A method's name that starts an indented line does not continue the line above as an infix call:
// the line has to end with the name instead.

class Bag(val n: int)
    add(k: int) -> int = n + k

indented(b: Bag) -> int
    val s = b
        add 2
    s

main() -> int = 0
