// error: this arm is never reached: `Eq` makes an `Expr[bool]`, and the value matched is an `Expr[int]`
// error: this arm is never reached: `IntLit` needs `T` to be `int`, and `BoolLit` in the same pattern needs it to be `bool`
// error: this arm is never reached: `Wrap` needs `T` to be `Vector[T]`, which no type is
// error: `Same[int, string]` has no values: no variant of `Same` makes one
// error: this `match` does not cover every Expr[int] value, such as `If(_, _, _)`; add an arm for it, or `_` for the rest
// What no value of the type matched can be is an error to match. An arm on a variant that makes
// another instance names the instance; a row whose patterns need one type parameter to be two types
// names both; a cyclic equality says no type satisfies it; an instance no variant makes has no
// values; and a missing case is named by a variant possible at the instance.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  BoolLit(value: bool) -> Expr[bool]
  Add(a: Expr[int], b: Expr[int]) -> Expr[int]
  Eq(a: Expr[int], b: Expr[int]) -> Expr[bool]
  If(cond: Expr[bool], yes: Expr[T], no: Expr[T])

data Twice[A, B]
  Wrap -> Twice[A, Vector[A]]

data Same[A, B]
  Refl -> Same[A, A]

isZero(e: Expr[int]) -> bool = e match
  IntLit(n) -> n == 0
  Eq(_, _) -> false
  _ -> false

both[T](a: Expr[T], b: Expr[T]) -> int = (a, b) match
  (IntLit(_), BoolLit(_)) -> 0
  _ -> 1

cyclic[T](t: Twice[T, T]) -> int = t match
  Wrap -> 0

never(p: Same[int, string]) -> int = p match
  Refl -> 0

missing(e: Expr[int]) -> int = e match
  IntLit(n) -> n
  Add(_, _) -> 0

main()
  ()
