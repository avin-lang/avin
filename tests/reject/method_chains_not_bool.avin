// error: `<` is a method of Column yielding string, and a link of a comparison chain must yield `bool`; join the comparisons with `&&`, or parenthesize one
// error: `<` is a method of Column yielding string, and a link of a comparison chain must yield `bool`; join the comparisons with `&&`, or parenthesize one
// error: `<` is a method of Column yielding string, and a link of a comparison chain must yield `bool`; join the comparisons with `&&`, or parenthesize one
// error: `>` is a method of Column yielding Condition, and a link of a comparison chain must yield `bool`; join the comparisons with `&&`, or parenthesize one
// A link of a chain calling a method that yields something other than `bool` is an error, in the
// first, a middle or the last place, whatever the other links are; the same comparison alone is a
// call yielding what the method yields.
data Condition(text: string)

data Column(name: string)

impl Column
  <(other: Column) -> string = s"$name < ${other.name}"
  <=(other: Column) -> bool = name <= other.name
  >(other: Column) -> Condition = Condition(s"$name > ${other.name}")

main()
  val a = Column("a")
  val b = Column("b")
  val first = a < b <= b
  val middle = a <= b < a <= b
  val last = a <= b < a
  val mixed = a <= b == b > a
  val lone: string = a < b
  val alone: Condition = a > b
  val grouped = (a < b) == "a < b"
