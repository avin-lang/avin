// error: `Pair` takes 2 type arguments, not 3
// error: `IntLit` takes 0 type arguments, not 1
// error: `Expr` takes 1 type argument, not 2
// error: a variant's type arguments are written once, on its type or on the variant
// error: `IntLit(2)` is an `Expr[int]`, and the field `second` of `Pair` is an `Expr[bool]`
// A refined variant's written type arguments are its parameters that a field or its result names,
// the type's it names nowhere left out; the type's arguments, written on the type, are the instance
// the value makes.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  BoolLit(value: bool) -> Expr[bool]
  Pair[A, B](first: Expr[A], second: Expr[B]) -> Expr[(A, B)]

main()
  val a = Pair[int, bool, int](IntLit(1), BoolLit(true))
  val b = IntLit[int](1)
  val c = Expr[int, int].IntLit(1)
  val d = Expr[(int, int)].Pair[int, int](IntLit(1), IntLit(1))
  val e = Pair[int, bool](IntLit(1), IntLit(2))
