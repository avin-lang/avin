// error: `IntLit(1)` is an `Expr[int]`, and an `Expr[bool]` is expected here
// error: `BoolLit(false)` is an `Expr[bool]`, and the field `b` of `Add` is an `Expr[int]`
// error: `Balance` is a `Query[long]`, and a `Query[string]` is expected here
// error: `Query[string].Balance` is a `Query[long]`, and a `Query[string]` is expected here
// error: `IntLit(1)` is an `Expr[int]`, and an `Expr[T]` is expected here
// A variant name two types share is decided by the type expected, whatever instance its result is,
// and the refined variant chosen is then held to the instance: the other type's variant of the name
// is not chosen instead. A named argument is reported as its field. A generic function's `Expr[T]`
// is no `Expr[int]`, whatever `T` is.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  BoolLit(value: bool) -> Expr[bool]
  Add(a: Expr[int], b: Expr[int]) -> Expr[int]

data Other
  IntLit(n: int)

data Query[R]
  Balance -> Query[long]
  Owner -> Query[string]

lit[T]() -> Expr[T] = IntLit(1)

main()
  val o: Other = IntLit(1)
  val e: Expr[bool] = IntLit(1)
  val sum = Add(a = IntLit(1), b = BoolLit(false))
  val q: Query[string] = Balance
  val r = Query[string].Balance
