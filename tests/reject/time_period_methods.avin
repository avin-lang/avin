// error: expected Date, found DateTime
// error: `DateTime` has no field `until`
// error: `Period` has no field `toDays`
// error: `Instant` has no field `plusMonths`
// error: expected int, found long
// Between dates only: a date takes no reading in `until`, a reading has no `until`, months and days
// never convert, an instant has no calendar steps, and the makers count months in an `int`.
import avin.time.{date, dateTime, months, now}

main()
  println(date(2026, 1, 1).until(dateTime(2026, 2, 1, 0, 0)))
  println(dateTime(2026, 1, 1, 0, 0).until(dateTime(2026, 2, 1, 0, 0)))
  println(months(1).toDays)
  println(now().plusMonths(1))
  println(months(date(2026, 1, 1).year))
