// error: a `@sendable (int) -> int` may use only sendable values from around it, but it uses `counts`, an `Array[int]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: a `@sendable (int) -> string` may use only sendable values from around it, but it uses `counts`, an `Array[int]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: a `@sendable (int) -> int` may run on another thread, which shares the program's module-level state, but through `bump` it reaches `hits`, a module-level `var`, which every thread would share; share it through an `Atomic` or a `Mutex` held in a `val`
// error: a `@sendable (int) -> int` may use only sendable values from around it, but it uses `b`, a `Box`, whose field `n` is a `var`; make it a `val`
// A lambda, a function named as a value and a method value given for an overloaded function's
// `@sendable` parameter are held to the rules for one, whichever overload is chosen.
var hits = 0

class Box(var n: int)
  get(k: int) -> int = n + k

pick(f: @sendable (int) -> int) -> int = f(1)
pick(f: @sendable (int) -> string) -> int = f(1).byteLength

bump(k: int) -> int
  hits += k
  hits

main()
  val counts = Array.fill(3, 1)
  val b = Box(3)
  println(pick(k -> counts(k)))
  println(pick(k -> s"${counts(k)}"))
  println(pick(bump))
  println(pick(b.get))
