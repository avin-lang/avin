// error: `(int, Cell)` does not conform to `Display`, the bound of `T` in `shown`
// error: `(Cell, int)` does not conform to `Display`, the bound of `T` in `shown`
// error: `<` needs (Cell, int) to implement `Ord`
// error: `(int, Cell)` does not implement `Display`, so it cannot be interpolated
// error: (int, Cell) has no field `compare`
// A tuple has a trait only where every part does.
class Cell(n: int)

shown[T: Display](value: T) -> string = value.toString()

main()
  println(shown((1, Cell(2))))
  println(shown((Cell(1), 2)))
  val less = (Cell(1), 1) < (Cell(2), 2)
  val text = s"${(1, Cell(3))}"
  val compared = (1, Cell(1)).compare((1, Cell(1)))
