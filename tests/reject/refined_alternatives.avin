// error: `inArm` yields int, not T
// error: `+` needs two values of one type, not T and int
// error: `+` needs two values of one type, not T and int
// error: `+` needs two values of one type, not T and int
// Each of a set of alternatives matches a value on its own, so the equalities one learns hold
// neither in the next alternative nor in the arm, which runs whichever matched: here `T` is not
// known to be `int` in the arm, the clause, the `is` branch or the nested pattern's arm.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  BoolLit(value: bool) -> Expr[bool]
  If(cond: Expr[bool], yes: Expr[T], no: Expr[T])

inArm[T](e: Expr[T]) -> T = e match
  IntLit(_) | BoolLit(_) -> 5
  If(_, _, _) -> 6

inClause[T](e: Expr[T], x: T) -> T
inClause(IntLit(_) | BoolLit(_), x) = x + 1
inClause(_, x) = x

inTest[T](e: Expr[T], x: T) -> T = if e is IntLit(_) | BoolLit(_) then x + 1 else x

nested[T](e: Expr[T], x: T) -> T = e match
  If(_, IntLit(_) | BoolLit(_), _) -> x + 1
  _ -> x

main()
  ()
