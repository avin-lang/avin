// error: `undefinedCleanup` is not defined
// error: `later` is not defined
// error: expected int, found string
// A deferred statement is checked as any statement is, where it is written: a name declared after
// the `defer` is not in scope in it, even though it runs later.

main()
    defer undefinedCleanup()
    defer println(later)
    val later = 1
    var n = 0
    defer n = "text"
    println(later + n)
