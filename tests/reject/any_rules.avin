// error: `===` is undefined on Any and Any, which may hold values with no identity; compare with `==`, or give one side a class type
// error: a literal does not match an Any; match the value by its type first, as in `n: int`
// error: a value of type (int) -> int is never a (string) -> int, so this type pattern never matches
// error: a clause's arguments are patterns; their types are in the signature
// error: a value of type (int, string) is never a (string, int), so this type pattern never matches
// What `Any` and type patterns do not allow: identity on `Any`, a literal against an `Any`, a
// function type pattern its value can never meet, a clause repeating its parameter's type, and a tuple whose
// parts can never match.

same(x: Any, y: Any) -> bool = x === y

literal(x: Any) -> int = x match
  5 -> 1
  _ -> 0

function(x: (int) -> int) -> int = x match
  _: ((string) -> int) -> 1
  _ -> 0

twice(n: int) -> int
twice(n: int) = n * 2

swapped(t: (int, string)) -> int = t match
  _: (string, int) -> 1
  _ -> 0

main() -> int = 0
