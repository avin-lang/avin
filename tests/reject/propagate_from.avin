// error: `?` cannot choose how to convert an error of Both to Failure: it implements From[Coded] and From[Named], and none is more specific than the others
// error: `?` passes on an error of string, but `missing` yields errors of Plain, which does not implement From[string]; implement it, or convert the error first with `mapErr`
// error: `?` passes on an error of string, but `generic` yields errors of F, which does not implement From[string]; implement it, or convert the error first with `mapErr`
// `?` converts an error through the enclosing function's error type's conformance to `From` at the
// error's type, or at a type the error is a value of where one such conformance is more specific
// than the others; a type parameter's conformances are its bounds'.

trait Coded
  code() -> int

trait Named
  name() -> string

class Both(val n: int): Coded, Named
  override code() -> int = n
  override name() -> string = "both"

data Failure
  FromCoded(n: int)
  FromNamed(s: string)

impl From[Coded] for Failure
  static from(value: Coded) -> Failure = FromCoded(value.code())

impl From[Named] for Failure
  static from(value: Named) -> Failure = FromNamed(value.name())

data Plain
  Plain(n: int)

both(n: int) -> Result[int, Both] = Err(Both(n))

text(n: int) -> Result[int, string] = Err("no")

ambiguous(n: int) -> Result[int, Failure]
  val x = both(n)?
  Ok(x)

missing(n: int) -> Result[int, Plain]
  val x = text(n)?
  Ok(x)

generic[F: From[int]](n: int) -> Result[int, F]
  val x = text(n)?
  Ok(x)

main()
  println(ambiguous(1))
