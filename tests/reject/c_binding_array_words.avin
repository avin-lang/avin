// An array is passed in, never `inout`; a pointer with no name has no `length(…)` to name it; an
// array is no `keeps:`, C holding it for the call alone; a length C writes back is an integer; and
// `blocking` is said once.
// error: parameter 1 of the C binding `inoutArray` is `Array[int]` in Avin and `int *` in C, `inout`: an array is passed in, a pointer to its elements, and never `inout`
// error: parameter 1 of the C binding `unnamed` is `Array[i16]` in Avin and `const short *` in C: C could read past the end of an array whose length nothing carries: name the pointer, and mark the integer parameter that carries its length `length(name)`
// error: `keeps:` names the array `p`, which C holds for the call alone; memory C keeps is a `ByteBlock`, which is never copied
// error: out value 1 of the C binding `realLength`, `n`, is `real` in Avin and `size_t` in C: the length C writes back through `n`, how much of `p` it used, is an integer
// error: `blocking` is said once

@c("void f(inout int *p)")
inoutArray(p: Array[int]) -> int

@c("int f(const short *, int)")
unnamed(p: Array[i16], n: int) -> int

@c(type: "fx_thing *", release: "fx_thing_free")
class Thing

@c("fx_thing *f(const uint8_t *p, length(p) size_t n)", keeps: "p")
kept(p: Array[byte]) -> Thing

@c("void f(uint8_t *p, length(p) inout size_t *n)")
realLength(p: Array[byte]) -> real

@c("int f(const int *p, length(p) int n)", blocking, blocking)
twice(p: Array[int]) -> int

main() = 0
