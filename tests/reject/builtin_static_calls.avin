// error: `twice` is static: it belongs to the type, so it is called on the type, as in `string.twice()`, not on a value
// error: `shouted` is a method of a value of `string`, not of the type; call it on a value
// error: `string` has no static member `thrice`
// error: `selfish` is static: it belongs to the type, not to a value, so it has no `self`
// error: `string.pair` has several overloads, and nothing here says which is meant; give it a function type, as in `val f: (int) -> int = string.pair`
// A built-in type's static member is called on the type and never on a value, a method of a value
// never on the type, and its body has no `self`; an overloaded one named as a value needs a
// function type to say which.

impl string
  static twice(s: string) -> string = s + s
  static pair(a: int, b: int) -> string = s"$a,$b"
  static pair(a: char, b: char) -> string = s"$a$b"
  static selfish() -> string = self
  shouted() -> string = self + "!"

main()
  println("a".twice("b"))
  println(string.shouted())
  println(string.thrice("c"))
  val p = string.pair
