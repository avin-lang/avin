// Each C type crosses as the Avin types its kind allows, and a binding naming another is refused at
// the type: a C integer as an integer type, a C `char` as `byte`, `double` as `real`, and a function
// answering nothing as `unit`.
// error: parameter 1 of the C binding `upper` is `string` in Avin and `int` in C: a C integer crosses as an integer type
// error: parameter 1 of the C binding `letter` is `int` in Avin and `char` in C: a C `char` crosses as `byte`
// error: parameter 2 of the C binding `power` is `long` in Avin and `double` in C: a C `double` crosses as `real`
// error: the result of the C binding `nothing` is `int` in Avin and `void` in C: the C function answers nothing, so the binding's result is `unit`
// error: the result of the C binding `flag` is `int` in Avin and `bool` in C: a C `bool` crosses as `bool`

@c("int toupper(int)")
upper(c: string) -> int

@c("int fixture_echo_char(char)")
letter(c: int) -> int

@c("double pow(double, double)")
power(x: real, y: long) -> real

@c("void srand(unsigned int)")
nothing(seed: long) -> int

@c("bool fixture_true(void)")
flag() -> int

main() = 0
