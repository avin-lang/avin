// error: `_` is not a value here
// A `match` and a block keep their own `_`, as a lambda and an `if` do: neither is searched for a
// placeholder, so each `_` below is reported, and no lambda is made.

main() -> int
  val xs = [1, 2, 3]
  println(xs.map(_ match
    1 -> "one"
    _ -> "other"))
  val total = xs.foldLeft(0)
    _ + 1
  0
