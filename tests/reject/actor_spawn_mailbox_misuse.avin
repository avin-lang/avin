// error: expected Mailbox, found int
// error: expected Mailbox, found string
// error: expected Overflow, found int
// error: `Bounded` takes 2 arguments, not 1
// `spawn`'s fourth parameter is the mailbox: a number after the executor is not a capacity, a
// mailbox is `Unbounded` or `Bounded` with a capacity and an overflow policy, and the policy is one
// of the `Overflow` variants.
import avin.actors.{Bounded, Stop, spawn}
import avin.threads.Executor

actor Idle receives int
  receive
    _ -> ()

main()
  val ex = Executor.fixed(1)
  spawn(Idle(), Stop, ex, 3)
  spawn(Idle(), mailbox = "bounded")
  spawn(Idle(), mailbox = Bounded(8, 1))
  spawn(Idle(), mailbox = Bounded(8))
