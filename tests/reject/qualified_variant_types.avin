// error: this `match` does not cover every Color value, such as `Blue`; add an arm for it, or `_` for the rest
// error: `Red` is a variant of `Color`, but the value it matches is Shape
// error: expected Shape, found Color
// error: expected real, found string
// A match mixing bare and qualified arms is still checked for coverage, and a qualified variant is
// typed as its bare name is: a variant of another type matches nothing of this one, and its fields
// take their own types.

data Color
  Red
  Green
  Blue

data Shape
  Circle(radius: real)
  Empty

name(c: Color) -> string = c match
  Red -> "red"
  Color.Green -> "green"

wrong(s: Shape) -> int = s match
  Color.Red -> 1
  _ -> 0

main()
  val s: Shape = Color.Red
  println(Shape.Circle("wide"))
