// error: format `%f` expects a real, but the value has type `T`
// error: format `%d` expects an integer, but the value has type `T`
// error: `T` does not implement `Display`, so it cannot be interpolated
// error: `Opaque` does not implement `Debug`, so `%?` cannot show it
// error: `Opaque` does not implement `Display`, so it cannot be interpolated
class Opaque

show[T: Integer](x: T) -> string = f"${x}%f"

any[T](x: T) -> string = f"${x}%d ${x}%s"

main()
  println(f"${Opaque()}%? ${Opaque()}")
