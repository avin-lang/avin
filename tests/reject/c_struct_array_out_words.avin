// `array:` names the `out` parameter C answers an array through, `length:` gives its length and is
// given only with `array:`, and `free:` is a C function or a C expression in the array's name.
// error: `length:` is the length of the array C answers through the `out` parameter `array:` names, and the binding names none
// error: C answers the array `glyphs` with no length of its own, so the binding says it with `length:`, a C expression over the call's parameters and out values, as in `length: "num_glyphs"`
// error: out value 1 of the C binding `notOut`, `glyphs`, is `Array[Glyph]` in Avin and `as_glyph *` in C: an array C answers through `glyphs` is named with `array:`, its length given with `length:`, as in `array: "glyphs", length: "count"`
// error: `array:` names the `out` parameter C answers an array through, and `n` is no `out` parameter of the prototype
// error: `free:` names the C function that frees the array `glyphs`, or is a C expression in `glyphs`, and `1 + 2` is neither

@c(struct: "as_glyph")
data Glyph(index: long, x: real, y: real)

@c("int as_count(int n)", length: "n")
lengthAlone(n: int) -> int

@c("void as_glyphs(out as_glyph **glyphs)", array: "glyphs")
noLength() -> Array[Glyph]

@c("void as_glyphs_n(int n, out as_glyph **glyphs, out int *count)", array: "n", length: "count")
notOut(n: int) -> (Array[Glyph], int)

@c("void as_glyphs(out as_glyph **glyphs, out int *count)", array: "glyphs", length: "count", free: "1 + 2")
badFree() -> (Array[Glyph], int)

main() = 0
