// error: `Buffer[int]` does not conform to `Sendable`, so the actor `Buffers` cannot receive it: it is mutable; an immutable copy (`toVector`) is sendable
// error: `Tally` does not conform to `Sendable`, so the actor `Tallies` cannot receive it: its field `n` is a `var`; make it a `val`
// error: `(int) -> int` does not conform to `Sendable`, so the actor `Functions` cannot receive it: it is a function value, whose type does not say what it captures
// error: `JobMsg` does not conform to `Sendable`, so the actor `Jobs` cannot receive it: its variant `Fill` holds a `Buffer[byte]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: `T` does not conform to `Sendable`, so the actor `Generic` cannot receive it: it is a type parameter that may stand for any type; bound it, as in `[T: Sendable]`
// An actor's message type is held to `Sendable` where it is named after `receives`, and reported
// there once, though the actor's behaviour and its reference both carry it: a mutable collection, a
// class with a `var`, a plain function value, a data type with a variant holding a buffer, and an
// unbounded type parameter of a generic actor.
class Tally()
    var n = 0

data JobMsg
    Run(id: int)
    Fill(bytes: Buffer[byte])

actor Buffers receives Buffer[int]
    receive
        _ -> ()

actor Tallies receives Tally
    receive
        _ -> ()

actor Functions receives (int) -> int
    receive
        _ -> ()

actor Jobs receives JobMsg
    receive
        _ -> ()

actor Generic[T] receives T
    receive
        _ -> ()

main() = ()
