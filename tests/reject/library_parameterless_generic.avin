// error: `get` takes no parameter list, so it is called without parentheses: write `get`, not `get()`
// error: `ok` takes no parameter list, so it is called without parentheses: write `ok`, not `ok()`
// error: `head` takes no parameter list, so it is called without parentheses: write `head`, not `head()`
// error: `year` takes no parameter list, so it has no function value: naming it calls it; for a function, write a lambda, as in `() -> x.year`
// error: `trim` takes no parameter list, so it has no function value: naming it calls it; for a function, write a lambda, as in `() -> x.trim`
// Through generic instances the accessors are the same parameterless methods, and one has no
// function value: a lambda gives one.
import avin.time

firstOf[T](o: Option[Vector[T]]) -> T = o.get().head

okOf[E](r: Result[string, E]) -> Option[string] = r.ok()

main()
    println(firstOf(Some([1])), okOf[int](Ok("a")), "ab".head())
    val y: () -> long = time.date(2024, 1, 1).year
    val f: () -> string = " a ".trim
    println(y(), f())
