// A `Result` made by a statement and dropped is an error wherever the statement is: a function's
// call, a method's, a generic function's at any instance, a chained call whose last link answers a
// `Result`, and the last line of a function that yields `unit`. Each is reported once, at the
// expression that made it.
class Store
    var saved = 0
    save(n: int) -> Result[unit, string] =
        saved = n
        Ok(())

fails(k: int) -> Result[int, string] = if k > 0 then Ok(k) else Err("no")

wrap[T](x: T) -> Result[T, string] = Ok(x)

tail()
    fails(1)

main()
    val s = Store()
    s.save(3)
    wrap("ключ ✓")
    fails(2).map(x -> x + 1)
    fails(4)
    tail()
    println(s.saved)
