// error: `children` is one of every actor's own methods, `ActorContext.children`; name the field something else
// error: `stop` is one of every actor's own methods, `ActorContext.stop`; name this one something else
// error: expected int, found string
// error: no overload of `watch` accepts these arguments; the overloads are `ActorContext.watch[M](actor: ActorRef[Nothing], message: M)`, `ActorContext.watch[M](actor: ActorRef[Nothing], f: @sendable (Ending) -> M)`
// An actor's own methods (`stop`,`children`, `parent`, `after` and the rest) are every actor's, so
// a field or method of the same name and parameters is refused, and a timer's or a watch's message
// is of the actor's message type.
import avin.actors.{ActorRef, spawn}
import avin.time as time

actor Clash receives int
    val children = 3
    receive
        _ -> ()
    stop() = ()

actor Typed(other: ActorRef[Nothing]) receives int
    after(time.seconds(1), "one")
    watch(other, message = "gone")
    receive
        _ -> ()

main()
    spawn(Clash())
