// error: `-` needs two values of one type, not Duration and Instant
// error: expected Duration, found Instant
// error: expected Instant, found Duration
// error: `<` cannot compare Instant with Duration
// error: `==` cannot compare Instant with Duration
// The two clocks never mix: a monotonic reading is a `Duration`, a wall reading an `Instant`, and
// neither converts to, subtracts from or compares with the other.
import avin.time.{Duration, Instant, monotonic, now}

main()
  println(monotonic() - now())
  val d: Duration = now() - monotonic()
  val i: Instant = monotonic()
  println(now() < monotonic())
  println(now() == monotonic())
