// error: `describe` overrides a method, so it takes that method's default for `width`; an override cannot declare a default
// error: `greet` overrides a method, so it takes that method's default for `who`; an override cannot declare a default
// error: `later` is not defined
// error: `self` is not defined
// error: `pick` is ambiguous
open class Shape()
  describe(width: int = 10) -> string = s"$width"

class Circle(): Shape()
  override describe(width: int = 20) -> string = s"circle $width"

trait Greeter
  greet(who: string = "world") -> string

class English(): Greeter
  override greet(who: string = "you") -> string = s"hello, $who"

// A method's default sees only the parameters before it.
class Early()
  run(first: int = later, later: int = 0) -> int = first

// A constructor's default runs before the object exists.
class Account(owner: string, label: string = self.owner)

class Chooser()
  pick(a: int) -> int = a
  pick(a: int, b: int = 2) -> int = a + b

main()
  println(s"${Chooser().pick(1)}")
