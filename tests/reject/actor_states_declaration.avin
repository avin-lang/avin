// error: the first state is where `Starts` starts, so it takes no parameters
// error: `Dup` declares the state `S` more than once
// error: state `S` has one `enter` block
// error: `leave` belongs to a state: write it inside the `state` block it runs for
// error: `Plain` has one `receive` block, holding the arms that handle its messages
// The shape of an actor's states, as a machine's: a first state without parameters, each state one
// name, one `enter` and one `leave` per state and none outside a state; and an actor with states
// still has at most one shared `receive` block.
data Msg
    A

actor Starts receives Msg
    state First(n: int)
        A -> stay

actor Dup receives Msg
    state S
        A -> stay
    state S
        A -> stay

actor Twice receives Msg
    state S
        enter
            println("a")
        enter
            println("b")
        A -> stay

actor Outside receives Msg
    leave
        println("x")
    state S
        A -> stay

actor Plain receives Msg
    state S
        A -> stay
    receive
        _ -> stay
    receive
        _ -> stay

main() = ()
