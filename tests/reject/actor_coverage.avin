// error: actor `Partial` does not handle `C`; a message it ignores is handled by an arm that does nothing, as `_ -> ()`
// error: actor `Guarded` does not handle `B(_)` where the guard is false; a message it ignores is handled by an arm that does nothing, as `_ -> ()`
// error: actor `Flags` does not handle `false`; a message it ignores is handled by an arm that does nothing, as `_ -> ()`
// error: actor `Numbers` does not handle `0` where the guard is false; a message it ignores is handled by an arm that does nothing, as `_ -> ()`
// error: actor `Nested` does not handle `Both(true, None)`; a message it ignores is handled by an arm that does nothing, as `_ -> ()`
// `receive` is checked for exhaustiveness as a match is, guarded arms not counting, and the error
// names the actor and every case left out: a variant, one a guarded arm could have taken, a value of
// a type without variants, one past a guarded comparison, and a nested case.
data Msg
    A
    B(n: int)
    C

data Pair
    Both(flag: bool, value: Option[int])

actor Partial receives Msg
    receive
        A -> ()
        B(_) -> ()

actor Guarded receives Msg
    receive
        A -> ()
        B(n) if n > 0 -> ()
        C -> ()

actor Flags receives bool
    receive
        true -> ()

actor Numbers receives int
    receive
        n if n > -1 -> ()
        n < -1 -> ()

actor Nested receives Pair
    receive
        Both(false, _) -> ()
        Both(true, Some(_)) -> ()

main() = ()
