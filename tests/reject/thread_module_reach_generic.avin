// error: what is passed for `body` of `spawn` may run on another thread, which shares the program's module-level state, but through `twice` → `Money.add` it reaches `count`
// error: what is passed for `body` of `spawn` may run on another thread, which shares the program's module-level state, but through `Iterable.sum` → `Money.add` it reaches `count`
// error: what is passed for `body` of `spawn` may run on another thread, which shares the program's module-level state, but through `Square.area` it reaches `count`
// error: what is passed for `body` of `spawn` may run on another thread, which shares the program's module-level state, but through `Loud.add` it reaches `count`
// error: what is passed for `body` of `spawn` may run on another thread, which shares the program's module-level state, but through `Bag.size` it reaches `count`
// errors: exactly
// Where a thread's body really may reach a program's method that reads a module-level `var`, it is
// reported, however the call gets there: a generic function of the program or of the standard library
// called at the program's type, a method of an open class overridden by a subclass, an operator on an
// open class whose subclass overrides it, and a method of a generic class called on an instance of it.
import avin.threads.spawn

var count = 0

data Money(cents: int)

impl Add for Money
  static zero() -> Money = Money(0)
  add(other: Money) -> Money = Money(cents + other.cents + count)

twice[T: Add](x: T) -> T = x + x

open class Shape
  area() -> int = 0

class Square(side: int) : Shape
  override area() -> int = side * side + count

pick(n: int) -> Shape = if n > 0 then Square(n) else Shape()

open class Sound(val level: int)

impl Add for Sound
  static zero() -> Sound = Sound(0)
  add(other: Sound) -> Sound = Sound(level + other.level)

class Loud(l: int) : Sound(l)
  override add(other: Sound) -> Sound = Sound(level + other.level + count)

louder() -> Sound = Loud(1)

class Bag[T](item: T)
  size() -> int = count

main()
  spawn(() -> twice(Money(1)).cents).join()
  spawn(() -> [Money(1), Money(2)].sum.cents).join()
  spawn(() -> pick(2).area()).join()
  spawn(() -> (louder() + Sound(2)).level).join()
  spawn(() -> Bag("x").size()).join()
