// error: `T` has no method `+%`
// error: `T` has no method `*|`
// error: `-%` needs two values of one type, not T and int
// error: `+|` needs two values of one type, not T and U
// The wrapping and saturating operators of a type parameter exist only where the bound is `Integer`:
// `Ord` and an unbounded parameter give none, and the operands share one type.

unbounded[T](a: T, b: T) -> T = a +% b
ordered[T: Ord](a: T, b: T) -> T = a *| b
mixed[T: Integer](a: T) -> T = a -% 3
two[T: Integer, U: Integer](a: T, b: U) -> T = a +| b

main()
  println(unbounded(1, 2))
