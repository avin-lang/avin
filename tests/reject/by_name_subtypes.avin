// error: expected -> Option[Animal], found -> Option[string]
// error: expected -> Option[Cat], found -> Option[int]
// error: this delayed argument yields Cell[Result[string, string]], not Cell[Result[Cat, string]]
trait Animal
  name() -> string

class Cat(): Animal
  override name() -> string = "cat"

class Box[T](val v: T, val n: int)

object Box
  apply[T](body: -> T) -> Box[T] = Box(body, 1)

class Cell[T](val v: T)

impl[T, E] Cell[Result[T, E]]
  lazily[U >: T, F](other: -> Cell[Result[U, F]]) -> Cell[Result[U, F]] = other

main() -> int
  val a: Box[Option[Animal]] = Box(Some("text"))
  val b: Box[Option[Cat]] = Box(Some(3))
  val cats: Cell[Result[Cat, string]] = Cell(Err("no cat"))
  val texts: Cell[Result[string, string]] = Cell(Ok("x"))
  val c: Cell[Result[Cat, string]] = cats.lazily(texts)
  0
