// Only a `string`, an `Array[byte]` and those in an `Option` carry a C string: another Avin type at a
// `const char *` or `char *` is refused, as is an `Option` of anything else.
// error: parameter 1 of the C binding `length` is `Option[int]` in Avin and `const char *` in C: a C string crosses as `string` or `Option[string]`
// error: the result of the C binding `name` is `Array[int]` in Avin and `const char *` in C: a C string crosses as `string`, `Array[byte]`, or either in an `Option`
// error: the result of the C binding `dup` is `Option[Option[string]]` in Avin and `char *` in C: a C string crosses as `string`, `Array[byte]`, or either in an `Option`
// error: parameter 1 of the C binding `upper` is `Option[string]` in Avin and `int` in C: a string crosses as a C `const char *`
// error: the result of the C binding `nothing` is `string` in Avin and `void` in C: the C function answers nothing, so the binding's result is `unit`

@c("size_t strlen(const char *s)")
length(s: Option[int]) -> long

@c("const char *fixture_name(void)")
name() -> Array[int]

@c("char *strdup(const char *s)")
dup(s: string) -> Option[Option[string]]

@c("int toupper(int)")
upper(c: Option[string]) -> int

@c("void fixture_store(int x)")
nothing(x: int) -> string

main() = 0
