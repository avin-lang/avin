// error: an infix call starts on its receiver's line: end that line with `size` to put the argument on the next
// error: `size` has no argument: an infix call takes one, and there is no postfix form; a member is reached with a dot, as `….size`, or `….size()` for a method declared with an empty parameter list
// A receiver that spans lines is quoted as `…` in the suggestion, never pasted whole.

f(xs: Vector[int]) -> int
  val n = (
    val a = xs
    a
  ) size
  n

main() -> int = 0
