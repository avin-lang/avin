// error: `Conn` does not conform to `Sendable`, the bound of `R` in `use`: its field `uses` is a `var`; make it a `val`
// error: `Lease[Conn]` does not conform to `Sendable`, the bound of `R` in `lease`: it is not made to be shared between threads
// error: a `@sendable () -> Result[Conn, string]` may use only sendable values from around it, but it uses `shared`, a `Conn`, whose field `uses` is a `var`; make it a `val`
// error: a `@sendable (Conn) -> bool` may use only sendable values from around it, but it uses `seen`, a `Buffer[Conn]`, which is mutable; an immutable copy (`toVector`) is sendable
// A pool's resource does not leave the call it is lent to: a body gives back only a sendable value,
// so neither the resource nor its lease is returned. Nor is it shared from the start: `create` makes
// each resource from sendable values alone, and `validate` and `destroy` are `@sendable` too.
import avin.threads.Pool

class Conn()
  var uses = 0

main()
  val pool = Pool[Conn, string](() -> Ok(Conn()), maxSize = 1)
  val kept = pool.use(c -> c)
  _ = pool.lease(l -> l)
  val shared = Conn()
  val leaky = Pool[Conn, string](() -> Ok(shared), maxSize = 1)
  val seen = Buffer[Conn]()
  val checked = Pool[Conn, string](() -> Ok(Conn()), maxSize = 1, validate = Some(c ->
    seen.addOne(c)
    true))
