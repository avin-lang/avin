// error: BagBuilder takes elements of type int, not `(key, value)` pairs, so a map literal cannot build it
// error: expected (int) -> bool, found Set[string]
// error: expected Map[string, long], found Map[string, int]

// A program's collection is built by a map literal only when its builder takes pairs, and a literal
// passed where a function is expected is the default set or map, held to the parameter's type.

data Bag(items: List[int])

object Bag
    newBuilder() -> BagBuilder = BagBuilder()

class BagBuilder: Builder[int, Bag]
    private var items: List[int] = Nil

    override addOne(element: int)
        items = element :: items

    override result() -> Bag = Bag(items)

    override clear()
        items = Nil

test(p: (int) -> bool) -> bool = p(1)

main()
    val bag: Bag = {a: 1}
    test({"x"})
    val ints = {a: 1}
    val longs: Map[string, long] = ints
