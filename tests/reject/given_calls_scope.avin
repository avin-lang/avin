// A given is in scope from its declaration to the end of its block: not in a call before it, not in
// its own value, not after its block ends, and not in another function, which a block's given does not
// reach.
// error: `tag` needs a `Tx` for `tx`, and no given
// error: `stamp` needs a `Tx` for `tx`, and no given
// error: `time` needs a `Clock` for `clock`, and no given
// error: `other` needs a `Tx` for `tx`, and no given

data Tx(id: int)

data Clock(at: int)

tag(using tx: Tx) -> int = tx.id

stamp(using tx: Tx) -> int = tx.id

time(using clock: Clock) -> int = clock.at

other(using tx: Tx) -> int = tx.id

later() -> int = other()

main()
  val early = tag()
  given t = Tx(stamp())
  if t.id > 0
    given c = Clock(2)
    println(time())
  println(time())
  println(early + later())
