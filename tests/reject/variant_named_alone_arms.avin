// error: this arm is never reached: the arm `Shipped` on line 17 already matches every value it would
// error: this `match` does not cover every Status value, such as `Lost(_)`
// error: `Shipped` has 2 fields, not 0
// error: `Shipped` is a variant of `Status`, but the value it matches is int
// error: this arm is never reached: the arm `Status.Lost` on line 32 already matches every value it would
// A variant with fields named alone matches every value of the variant, so an arm with its fields
// after it is never reached, and a `match` it leaves a variant out of names the variant with a `_`
// per field. `Shipped()`, with parentheses, is matched against the fields by number, and the name
// still tests only a value of its own data type.

data Status
    Pending
    Shipped(carrier: string, days: int)
    Lost(reason: string)

after(s: Status) -> int = s match
    Shipped -> 1
    Shipped(_, d) -> d
    _ -> 0

missing(s: Status) -> int = s match
    Shipped -> 1
    Pending -> 2

empty(s: Status) -> int = s match
    Shipped() -> 1
    _ -> 0

wrong(n: int) -> bool = n is Shipped

qualified(s: Status) -> int = s match
    Status.Lost -> 1
    Lost("x") -> 2
    _ -> 0

main() = ()
