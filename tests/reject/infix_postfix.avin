// error: `size` has no argument: an infix call takes one, and there is no postfix form; a method without arguments is called `b.size()`
// error: `size` has no argument: an infix call takes one, and there is no postfix form; a method without arguments is called `Bag(2).size()`
// error: `add` has no argument
// A method name after its receiver with no argument is not a postfix call, whether the line ends
// there, a comparison follows, or a bracket closes.

class Bag(val n: int)
    size() -> int = n
    add(k: int) -> int = n + k

ends(b: Bag) -> int
    val s = b size
    s

compared(b: Bag) -> bool = b size == 1

closed() -> int = ((Bag(2)) size)

listed(b: Bag) -> (int, int) = (b add, 1)

main() -> int = 0
