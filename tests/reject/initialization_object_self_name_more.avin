// error: a lambda that captures `self` is made before `last` is initialized
// error: `m` is used as a value before `last` is initialized
// error: the `lazy val` `l`, whose initializer may use `self`, is read before `last` is initialized
// error: an argument passed by name uses `self` before `last` is initialized
// error: `Reached` is needed by its own initializer, directly or through the functions it calls
// The object's name before the last field: captured in a lambda, a method named as a value, a
// `lazy val` read, and the name in an argument passed by name are each a use of `self`. A function
// outside the body that reads the object, called while the object is made, still needs the object
// itself: that is a real cycle, not a use of the name.
later(v: -> int) -> int = v

object Lambda
  val f: () -> int = () -> Lambda.last
  val last: int = 1

object Value
  val g: () -> int = Value.m
  val last: int = 1
  m() -> int = last

object Lazily
  lazy val l: int = Lazily.last + 1
  val first: int = Lazily.l
  val last: int = 1

object ByName
  val first: int = later(ByName.last)
  val last: int = 1

peek() -> int = Reached.k

object Reached
  val k: int = 1
  println(peek())

main() = ()
