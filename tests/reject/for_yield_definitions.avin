// error: a binding's pattern must match every Option[int] value; take the value apart with `match`
// error: this guard yields string, not bool
// error: `y` is not defined
// error: `z` is not defined
// error: `Bag` has no method `map`, which a `for` with `yield` calls on its source
// A value definition's pattern matches every value, as a `val`'s does; a guard after it is a `bool`;
// a definition is visible after it, not in the guards before it nor outside the comprehension; and
// one a guard follows pairs the elements with its value through the source's `map`.

class Bag(val n: int)
    flatMap[U](f: (int) -> Option[U]) -> Option[U] = f(n)
    withFilter(p: (int) -> bool) -> Bag = self

main()
    val xs: List[int] = [1, 2, 3]
    val a = for x in xs, Some(y) = Some(x) yield y
    val b = for x in xs, y = x if "no" yield y
    val c = for x in xs if y > 0, y = x yield y
    val d = for x in xs, z = x yield z
    print(z)
    val e = for x in Bag(1), y = x if y > 0, z in Some(y) yield z
