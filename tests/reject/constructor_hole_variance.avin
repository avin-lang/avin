// error: `Array` is invariant in its parameter `T`, and `F[+_]` takes only a constructor covariant there
// error: `G` is invariant at that argument, as `G[_]` is declared, and `F[+_]` takes only a constructor covariant there
// error: `Option` is covariant in its parameter `T`, and `F[-_]` takes only a constructor contravariant there
// error: `plain` yields F[Dog], not F[Animal]
// error: `G` is covariant at that argument, as `G[+_]` is declared, and `F[-_]` takes only a constructor contravariant there
// A hole's variance is a demand on the constructor passed, written or inferred: `+_` takes only a
// constructor covariant at that argument and `-_` only one contravariant there, a constructor
// parameter by the variance its own hole declares; at a plain `_`, `F[Dog]` is no `F[Animal]`.
open class Animal(val name: string)

class Dog(name: string): Animal(name)

widen[F[+_]](d: F[Dog]) -> F[Animal] = d

narrow[F[-_]](x: F[Animal]) -> F[Dog] = x

plain[F[_]](d: F[Dog]) -> F[Animal] = d

relay[G[_]](d: G[Dog]) -> G[Animal] = widen[G](d)

flip[G[+_]](x: G[Animal]) -> G[Dog] = narrow(x)

main()
  val a: Array[Dog] = Array.fill(1, Dog("x"))
  println(widen(a))
  println(narrow(Some(Dog("y"))))
