// error: a value of type (int, bool) is never a (int | string, bool), so this type pattern never matches
// error: a value of type (int, int) is never a (Any, int), so this type pattern never matches
// error: a value of type (string, int) is never a (int | string, int), so this type pattern never matches
// error: a value of type (Any, int) is never a (int, int), so this type pattern never matches
// error: a value of type ((bool, int), int) is never a ((Any, int), int), so this type pattern never matches
// A tuple is of the type it was made with, seen as another only where each part keeps its layout, so a
// type pattern on a tuple whose part is no reference, or whose target part is none, matches only that
// very part: such a pattern that could never match is refused.

main()
    val a: (int, bool) = (1, true)
    println(a match
        _: (int | string, bool) -> "union"
        _ -> "no")
    val b: (int, int) = (1, 2)
    println(b match
        _: (Any, int) -> "any"
        _ -> "no")
    val c: (string, int) = ("s", 1)
    println(c match
        _: (int | string, int) -> "union"
        _ -> "no")
    val d: (Any, int) = (1, 2)
    println(d match
        _: (int, int) -> "ints"
        _ -> "no")
    val e: ((bool, int), int) = ((true, 1), 2)
    println(e match
        _: ((Any, int), int) -> "nested"
        _ -> "no")
