// error: a sequence literal cannot build Count[string], which does not implement `Buildable`
// error: expected int, found string
// error: `Shape.newBuilder` implements `Buildable.newBuilder`, which yields Builder[int, Shape], not CountBuilder
// error: a set literal cannot build Count[string], which does not implement `Buildable`
// A literal is built through a conformance that holds of the expected type itself: an impl for one
// instance of a generic type builds no other instance, and the builder's element is the literal's.
class Count[T](val n: int)

class CountBuilder: Builder[int, Count[int]]
  private var n = 0

  override addOne(element: int)
    n += element

  override result() -> Count[int] = Count[int](n)

  override clear()
    n = 0

impl Buildable[int] for Count[int]
  static newBuilder() -> CountBuilder = CountBuilder()

trait Shape

impl Buildable[int] for Shape
  static newBuilder() -> CountBuilder = CountBuilder()

main()
  val c: Count[string] = [1, 2, 3]
  val d: Count[int] = ["x"]
  val e: Count[string] = {}
  println(c.n + d.n + e.n)
