// error: the contravariant type parameter `-T` appears in a covariant position, the lower bound of `W` in `take`
// error: the covariant type parameter `+V` appears in a contravariant position, the parameter `value` of `put`
// error: a lower bound is written on a function's or a method's own type parameter, not on `W`
// error: `Dog` is not a supertype of `Cat`, the lower bound of `W` in `prepended`
// error: expected int, found string
// A lower bound is a covariant position, so a `-T` may not be one. A `+V` in a parameter is still
// refused where no lower bound widens it. A written type argument is held to its lower bound, and
// two value types have no join a lower bound could widen to.
open class Animal(val label: string)
class Cat(label: string) : Animal(label)
class Dog(label: string) : Animal(label)

data Chain[+A]
    Link(head: A, tail: Chain[A])
    End

impl[A] Chain[A]
    prepended[W >: A](x: W) -> Chain[W] = Link(x, self)

class Sink[-T]
    take[W >: T](x: W) = ()

trait Bag[K, +V]
    put(key: K, value: V) -> Bag[K, V]

class Cell[W >: int](val v: W)

main()
    val cats: Chain[Cat] = Link(Cat("tom"), End)
    val dogs = cats.prepended[Dog](Dog("rex"))
    val ints: Chain[int] = Link(1, End)
    val mixed = ints.prepended("one")
