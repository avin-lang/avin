// `@c` takes one string, on a top-level function without a body whose parameters are as many as the
// prototype's, matched by position.
// error: `@c` takes the C function's prototype as one string, as the header writes it: `@c("int abs(int)")`
// error: the C binding `twoParameters` has 2 parameters and its prototype 1 parameter: they correspond by position
// error: the C binding `none` has 0 parameters and its prototype 1 parameter: they correspond by position
// error: a C binding has no body: the C function its prototype names is its body
// error: a C binding has one `@c`

@c(prototype: "int abs(int)")
named(n: int) -> int

@c("int abs(int)")
twoParameters(n: int, m: int) -> int

@c("int abs(int)")
none() -> int

@c("int abs(int)")
bodied(n: int) -> int = n

@c("int abs(int)")
@c("int abs(int)")
twice(n: int) -> int

main() = 0
