// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it captures `n`, a `var`, which the closure would share with the code that made it; copy it into a `val`, or share it through an `Atomic` or a `Mutex`
// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it uses `b`, a `Buffer[int]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it uses `h`, a `Holder`, whose field `f` holds a `() -> int`, which is a function value, whose type does not say what it captures
// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it uses `f`, a `() -> int`, which is a function value, whose type does not say what it captures
// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it uses `b`, a `Buffer[int]`, which is mutable; an immutable copy (`toVector`) is sendable
// The less direct routes: a `var` reached through a local function the body calls, a body given by
// name beside an explicit stack size, a function held in a data value's field, a function value from
// a loop, and an argument that is not a closure, which may read only sendable values.
import avin.threads.spawn

data Holder(f: () -> int)

main()
    var n = 0
    bump() -> int
        n += 1
        n
    spawn(() -> bump()).join()
    val b = Buffer[int]()
    spawn(body = () -> b.length, stack = 1048576).join()
    val h = Holder(() -> 1)
    spawn(h.f).join()
    val fs: Vector[() -> int] = [() -> 2]
    for f in fs do spawn(f).join()
    spawn(if b.isEmpty then () -> 1 else () -> 2).join()
    ()
