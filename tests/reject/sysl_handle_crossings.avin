// A Sysl handle crosses out of Sysl as a binding's result or held in its `Array`, `Vector`, `Option`
// or `Result`, and goes back by itself, as a parameter or the receiver of its own methods: not in an
// `Option` or a collection, and never in a mirror or a collection the boundary does not convert.
// error: `Option[Crc32]` cannot cross to Sysl: a Sysl handle goes back into Sysl only by itself, as a parameter or the receiver of its own methods
// error: `List[Crc32]` cannot cross out of Sysl: a Sysl handle is a binding's result, held in its `Array`, `Vector`, `Option` or `Result`, or a part of a tuple that is one of these
// error: `Vector[Crc32]` cannot cross to Sysl: a Sysl handle goes back into Sysl only by itself, as a parameter or the receiver of its own methods
// error: `Array[Option[Crc32]]` cannot cross to Sysl: a Sysl handle goes back into Sysl only by itself, as a parameter or the receiver of its own methods
// error: `Crc32` cannot cross to Sysl, so a Sysl mirror's field cannot be one

@sysl("sysl.checksum.Crc32")
class Crc32
    finish() -> long
    // A bound method's other parameters cross as a binding's do: a handle by itself does.
    combine(other: Crc32) -> long
    absorb(others: Vector[Crc32])

@sysl("sysl.hint.black_box")
keep(c: Option[Crc32]) -> long

@sysl("sysl.hint.black_box")
many(n: long) -> List[Crc32]

@sysl("sysl.hint.black_box")
some(n: long, all: Array[Option[Crc32]]) -> Result[Vector[Option[Crc32]], string]

@sysl("sysl.time.LocalDate")
data Dated
    Dated(day: Crc32)

main() = ()
