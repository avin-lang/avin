// A Sysl handle crosses out of Sysl as a binding's result or the value of its `Option` or `Result`,
// and goes back only as the receiver of its own methods: not in an `Option`, a collection or a
// mirror.
// error: `Option[Crc32]` cannot cross to Sysl: a Sysl handle goes back into Sysl only as the receiver of its own methods
// error: `Vector[Crc32]` cannot cross out of Sysl: a Sysl handle is a binding's result, or the value of its `Option` or `Result`
// error: `Crc32` cannot cross to Sysl: a Sysl handle goes back into Sysl only as the receiver of its own methods
// error: `Crc32` cannot cross to Sysl, so a Sysl mirror's field cannot be one

@sysl("sysl.checksum.Crc32")
class Crc32
    finish() -> long
    // A bound method's other parameters cross as a binding's do.
    combine(other: Crc32) -> long

@sysl("sysl.hint.black_box")
keep(c: Option[Crc32]) -> long

@sysl("sysl.hint.black_box")
many(n: long) -> Vector[Crc32]

@sysl("sysl.time.LocalDate")
data Dated
    Dated(day: Crc32)

main() = ()
