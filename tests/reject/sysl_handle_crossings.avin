// A Sysl handle crosses out of Sysl as a binding's result or held in its `Array`, `Vector`, `Option`
// or `Result`, and goes back by itself, as a parameter or the receiver of its own methods, or as the
// elements of an `Array` or a `Vector` that is a parameter: not in an `Option` or a collection of
// options, and a mirror's field only by itself, never in a collection the boundary does not convert.
// error: `Option[Crc32]` cannot cross to Sysl: a Sysl handle goes back into Sysl by itself, as a parameter or the receiver of its own methods, or as the elements of an `Array` or a `Vector` that is a parameter
// error: `List[Crc32]` cannot cross out of Sysl: a Sysl handle is a binding's result, held in its `Array`, `Vector`, `Option` or `Result`, or a part of a tuple that is one of these
// error: `Array[Option[Crc32]]` cannot cross to Sysl: a Sysl handle goes back into Sysl by itself, as a parameter or the receiver of its own methods, or as the elements of an `Array` or a `Vector` that is a parameter
// error: `Option[Crc32]` cannot be a Sysl mirror's field: a Sysl handle is one only by itself

@sysl("sysl.checksum.Crc32")
class Crc32
    finish() -> long
    // A bound method's other parameters cross as a binding's do: a handle by itself does, and so
    // does a vector of them.
    combine(other: Crc32) -> long
    absorb(others: Vector[Crc32])

@sysl("sysl.hint.black_box")
keep(c: Option[Crc32]) -> long

@sysl("sysl.hint.black_box")
many(n: long) -> List[Crc32]

@sysl("sysl.hint.black_box")
some(n: long, all: Array[Option[Crc32]]) -> Result[Vector[Option[Crc32]], string]

@sysl("sysl.time.Date")
data Dated
    Dated(day: Option[Crc32])

main() = ()
