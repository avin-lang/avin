// error: `?` passes on an error of string, but this lambda yields errors of int, which does not implement From[string]; implement it, or convert the error first with `mapErr`
// error: `?` on Option[int] returns `None` from this lambda, which yields Result[_, string], not an Option
// error: this lambda uses `?`, so its result type must be known where it is written, as in `val f: (string) -> Option[int] = body`
// error: this lambda uses `?`, so its result type must be known where it is written, as in `val f: (string) -> Option[int] = body`
// error: this lambda uses `?`, so its result type must be known where it is written, as in `val f: (string) -> Option[int] = body`
// A lambda using `?` checks against a result known only in shape where that shape is an `Option`, or a
// `Result` whose error type is known: an error of another type that does not convert, and an `Option`
// taken apart in a `Result`, are refused as in any function; a `Result` whose error type is itself
// still unknown, and a result that is no `Option` or `Result` at all, stay refused as unknown.

half(n: int) -> Result[int, string] = if n % 2 == 0 then Ok(n / 2) else Err("odd")

positive(n: int) -> Option[int] = if n > 0 then Some(n) else None

coded[T](f: (int) -> Result[T, int]) -> Result[T, int] = f(1)

inside[T](f: (int) -> Result[T, string]) -> Result[T, string] = f(1)

anyError[T, E](f: (int) -> Result[T, E]) -> Result[T, E] = f(1)

listed[T](f: (int) -> Vector[T]) -> Vector[T] = f(1)

bare[T](f: (int) -> T) -> T = f(1)

main()
  _ = coded(n -> Ok(half(n)?))
  _ = inside(n -> Ok(positive(n)?))
  _ = anyError(n -> Ok(half(n)?))
  _ = listed(n -> [half(n)?])
  _ = bare(n -> Ok(half(n)?))
