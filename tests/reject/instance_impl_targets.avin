// error: `Plain` takes 0 type arguments, not 1
// error: `Named` is a type alias, for `Bag[T]`; an impl names the type itself
// error: `Integer` is closed: its members are the integer types, and nothing else implements it
// error: Bag[int] is not a trait; an impl names a trait before `for`
// What an impl of a trait for an instance is for: an instance of a generic data type or class, named
// as itself rather than through an alias, implementing a trait that is open to impls.

trait Show
  show() -> string

data Plain(x: int)

data Bag[T](value: T)

type Named[T] = Bag[T]

impl Show for Plain[int]
  show() -> string = "plain"

impl Show for Named[int]
  show() -> string = "named"

impl Integer for Bag[int]
  show() -> string = "integer"

impl Bag[int] for Bag[string]
  show() -> string = "bag"

main()
  println(Plain(1).x)
