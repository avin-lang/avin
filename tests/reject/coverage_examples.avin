// error: this `match` does not cover every List[int] value, such as `_ :: _ :: _`; add an arm for it, or `_` for the rest
// error: this `match` does not cover every Option[bool] value, such as `Some(false)`; add an arm for it, or `_` for the rest
// error: this `match` does not cover every char value, such as `' '`; add an arm for it, or `_` for the rest
// error: this `match` does not cover every int value, such as `10`; add an arm for it, or `_` for the rest
// error: this `match` does not cover every (bool, Option[int]) value, such as `(false, None)`; add an arm for it, or `_` for the rest
// A `match` that leaves values out names one of them, written as a pattern.

shortList(xs: List[int]) -> int = xs match
  [] -> 0
  [_] -> 1

option(o: Option[bool]) -> int = o match
  Some(true) -> 1
  None -> 0

digit(c: char) -> int = c match
  '0' .. '9' -> 1

below(n: int) -> int = n match
  k < 10 -> 1

pair(p: (bool, Option[int])) -> int = p match
  (true, _) -> 1
  (false, Some(_)) -> 2

main() = 0
