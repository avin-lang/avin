// error: `Point` does not implement `zero` from `Add`; implement it in an impl of `Add`
// error: `Money` does not implement `zero` from `Add`; implement it, or declare `Money` abstract
// error: `Base` does not implement the static member `zero` from `Add`; implement it: it belongs to the type, so an abstract class gives it too
// error: `zero` is static, so it needs a body: it belongs to `Coin` itself
// A static member is declared by a trait and given by every type implementing it, an abstract class
// included, always with a body.

data Point(x: int, y: int)

impl Add for Point
  add(other: Point) -> Point = Point(x + other.x, y + other.y)

class Money(val cents: int): Add
  override add(other: Money) -> Money = Money(cents + other.cents)

abstract class Base: Add
  override add(other: Base) -> Base = other

class Coin(val cents: int): Add
  override add(other: Coin) -> Coin = Coin(cents + other.cents)
  override static zero() -> Coin

main() = ()
