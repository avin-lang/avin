// error: the `lazy val` `first` needs its own value to initialize: `first` → `second` → `first`
// A field's `lazy val` whose initializer needs its own value through another lazy field and a
// method called on the object is refused, whichever thread would first read it: run on two
// threads, one would trap at the read and the other wait for it.
import avin.threads.{sleep, scope}
import avin.time.millis

class Graph[T](seed: T)
  lazy val first: Vector[T] = second :+ seed

  lazy val second: Vector[T] = later()

  later() -> Vector[T]
    sleep(millis(20))
    first

main() -> int
  println("before")
  val g = Graph("x")
  scope(s ->
    s.spawn(() -> println(g.first.length))
    sleep(millis(5))
    s.spawn(() -> println(g.first.length)))
  println("after")
  0
