// error: (A, B) has no field `_1`; a tuple's parts are numbered from 0, so write `.0`
// error: (bool, char) has no field `_2`; a tuple's parts are numbered from 0, so write `.1`
// error: (int, (bool, char), real) has no field `_3`; a tuple's parts are numbered from 0, so write `.2`
// error: (string, int) has no field `_1`; a tuple's parts are numbered from 0, so write `.0`
// error: (string, int) has no field `_99999999999999999999`; a tuple's parts are numbered from 0 and read as `.0` to `.1`
firstOf[A, B](t: (A, B)) -> A = t._1

main()
  val q = (1, (true, 'c'), 2.0)
  println(q.1._2)
  println(q._3)
  val ps = [("a", 1), ("b", 2)]
  println(ps.map(p -> p._1))
  println(ps(0)._99999999999999999999)
