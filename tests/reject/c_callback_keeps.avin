// A function C keeps is named by `keeps:` and held by the handle that keeps it, whose class declares
// `forget:`; `consumes:` never names one; a C function names `forget:` or an expression in `self` and
// `userdata` writes it; and `@threaded` marks a parameter taking a function.
// error: `forget:` names the C function that stops C calling a callback, taking the handle's pointer and the callback's `userdata`, or a C expression in `self` and `userdata`; `1 + 2` is neither
// error: `listen` keeps the function `listener`, so `Unforgetting`, which keeps it, declares `forget:`, the C call that stops C calling it before the object goes back
// error: `consumes:` names the function `listener`: C keeps a function, with `keeps:`, or calls it during the call alone
// error: `keeps:` makes the handle a binding answers keep what it names, and `listenTop` answers no handle and is no method of one
// error: `@threaded` marks a parameter that takes a function, which C may call from any thread

@c(type: "cb_registry *", release: "cb_registry_unref", forget: "1 + 2")
class BadForget

@c(type: "cb_registry *", release: "cb_registry_unref")
class Unforgetting
    @c("int cb_registry_listen(cb_registry *self, void (*listener)(userdata void *ud, int value), userdata void *ud)", keeps: "listener")
    listen(listener: int -> unit) -> int

    @c("int cb_registry_listen(cb_registry *self, void (*listener)(userdata void *ud, int value), userdata void *ud)", consumes: "listener")
    consume(listener: int -> unit) -> int

@c("int cb_registry_listen(cb_registry *r, void (*listener)(userdata void *ud, int value), userdata void *ud)", keeps: "listener")
listenTop(r: Unforgetting, listener: int -> unit) -> int

@c("int abs(int x)")
threadedScalar(@threaded x: int) -> int

main() = 0
