// error: the `lazy val` `alpha` needs its own value to initialize: `alpha` → `beta` → `gamma` → `alpha`
// error: the `lazy val` `viaField` needs its own value to initialize: `viaField` → `viaField`
// error: the `lazy val` `counting` needs its own value to initialize: `counting` → `counting`
// error: the `lazy val` `local` needs its own value to initialize: `local` → `local`
// error: the `lazy val` `inThreads` needs its own value to initialize: `inThreads` → `inOther` → `inThreads`
// A chain is named from its earliest-declared member whichever member the check meets first; a
// field's `lazy val` read by the initializer is followed into its own initializer; so is an
// iterator's `next` a `for` loop calls, and a local `lazy val` the called code reads. Two values
// needing each other are refused even when two threads read them.
import avin.threads.scope

// The check meets `entry` first, then `gamma`; `entry` is outside the cycle and not named.
lazy val entry: int = gamma + 0

lazy val alpha: int = beta + 1

lazy val gamma: int = alpha + 1

lazy val beta: int = gamma + 1

class Holder
  lazy val v: int = viaField + 1

lazy val viaField: int = Holder().v

class Upto(val n: int): Iterable[int]
  override iterator() -> Iterator[int] = UptoIterator(n)

class UptoIterator(var at: int): Iterator[int]
  override hasNext() -> bool = at > 0
  override next() -> int
    at -= 1
    counting + at

sumUpto(n: int) -> int
  var total = 0
  for x in Upto(n)
    total += x
  total

lazy val counting: int = sumUpto(3)

helper() -> int
  lazy val inner: int = local * 2
  inner

lazy val local: int = helper()

lazy val inThreads: int = inOther + 1

lazy val inOther: int = inThreads + 1

main()
  scope(s ->
    s.spawn(() -> println(inThreads))
    s.spawn(() -> println(inOther)))
