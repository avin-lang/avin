var latest: Any = 0

class Box(var held: Any)

measure(n: Node) -> int = n.size

class Node(n: int)
  val first = measure(self)
  val size = n

class Linked(n: int)
  latest = self
  val last = n

class Holder(box: Box)
  box.held = self
  val tail = 1

class Alias(n: int)
  val me = self
  val end = n

class Equal(n: int)
  if self === self then println("same")
  val id = n

main() = ()
