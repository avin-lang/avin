// error: module-level values need one another to initialize: `sum` → `bonus` → `sum`
// error: module-level values need one another to initialize: `ordered` → `bar` → `ordered`
// error: module-level values need one another to initialize: `equal` → `mark` → `equal`
data Coin(cents: int)

impl Add for Coin
    add(other: Coin) -> Coin = Coin(cents + other.cents + bonus.cents)

impl Ord for Coin
    compare(other: Coin) -> int = cents + (if bar then 1 else 0) - other.cents

impl Eq for Coin
    equals(other: Coin) -> bool = cents + (if mark then 1 else 0) == other.cents

val sum = Coin(1) + Coin(2)

val bonus = sum

val ordered = Coin(1) < Coin(2)

val bar = ordered

val equal = Coin(1) == Coin(2)

val mark = equal

main() = ()
