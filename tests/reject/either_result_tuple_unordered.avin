// error: `<` needs Either[int, Plain] to implement `Ord`
// error: `Result[Plain, int]` does not conform to `Ord`, the bound of `T` in `smaller`
// error: `<` needs (int, Plain) to implement `Ord`
// error: `sorted` needs `T: Ord`, which Vector[(int, Plain)] does not meet
// error: `compare` is a method of `Ord`, which Either[int, Plain] does not implement
// Either, Result and tuples are ordered only when their parts are: with a part of a type without `Ord`
// there are no comparison operators, no sorting, and no `Ord` for a generic bound.
class Plain(val n: int)

smaller[T: Ord](a: T, b: T) -> T = a

main()
    val e: Either[int, Plain] = Left(1)
    val f: Either[int, Plain] = Left(2)
    println(e < f)
    val r: Result[Plain, int] = Ok(Plain(1))
    val s: Result[Plain, int] = Err(2)
    println(smaller(r, s).isOk)
    val t = (1, Plain(1))
    val u = (1, Plain(2))
    println(t < u)
    println(Vector(t, u).sorted().length())
    println(e.compare(f))
