// error: `+` needs two values of one type, not T and int; write `T(n)`
// error: `*` needs two values of one type, not T and real; write `x.toReal`
// error: `/` needs two values of one type, not T and real; write `(x + y).toReal`
// error: `<` cannot compare T with long; write `T(limit)`
// error: `-` needs two values of one type, not U and int
// A type parameter bounded by `Integer` converts from an integer by a call of itself, and one bounded
// by `Numeric` reaches `real` by `toReal`; one bounded only by `Numeric` has no conversion from an
// integer, so that message names none.

grow[T: Integer](x: T, n: int) -> T = x + n
scale[T: Numeric](x: T, rate: real) -> real = x * rate
mean2[T: Numeric](x: T, y: T) -> real = (x + y) / 2.0
under[T: Integer](x: T, limit: long) -> bool = x < limit
less[U: Numeric](x: U, n: int) -> U = x - n

main()
  println(grow(1, 2))
  println(scale(3, 0.5))
  println(mean2(1, 2))
  println(under(1, 2))
  println(less(1, 2))
