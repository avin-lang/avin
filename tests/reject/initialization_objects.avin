// error: `describe` is called before `port` is initialized
// error: `self` is passed, stored or returned before `port` is initialized
// error: a lambda that captures `self` is made before `port` is initialized
// error: `size` is called before `port` is initialized
show(c: Config) -> unit = println(c.name)

object Config
  val name = "server"
  println(describe())
  show(self)
  val reader = () -> name
  var port = 1 + size()

  describe() -> string = s"$name on $port"

  size() -> int = port

main() = ()
