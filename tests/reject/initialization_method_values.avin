// error: `size` is used as a value before `label` is initialized
// error: `describe` cannot be used as a value in the body of an open class
// error: `measure` cannot be used as a value in the body of an open class
class Item(n: int)
    val show: () -> string = describe
    val count: () -> int = self.size
    val label = s"item $n"

    describe() -> string = label

    size() -> int = n

open class Shape(n: int)
    val name = "shape"
    var g: () -> string = () -> "x"
    var h: () -> int = () -> 0
    g = describe
    h = measure

    describe() -> string = name

    private measure() -> int = n

