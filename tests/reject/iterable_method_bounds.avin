// error: `minOption` needs `T: Ord`, which Vector[Plain] does not meet
// error: `maxOption` needs `T: Ord`, which Iterable[Plain] does not meet
// error: `Plain` does not conform to `Ord`, the bound of `K` in `minByOption`
// error: `Plain` does not conform to `Ord`, the bound of `K` in `maxBy`
// error: `max` needs `T: Ord`, which List[Plain] does not meet
// The methods every `Iterable` has that need more of its elements than traversal: `min`, `max` and
// their `Option` forms need `Ord` elements, and `minBy`, `maxBy` and theirs an `Ord` key.
data Plain(n: int)

main()
    val ps: Vector[Plain] = [Plain(1), Plain(2)]
    println(ps.minOption().isDefined)
    val seen: Iterable[Plain] = ps
    println(seen.maxOption().isDefined)
    println(ps.minByOption(p -> p).isDefined)
    println(seen.iterator().maxBy(p -> p).n)
    val list: List[Plain] = [Plain(3)]
    println(list.max().n)
