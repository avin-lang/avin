// error: `min` needs `T: Ord`, which Vector[Plain] does not meet
// error: `max` needs `T: Ord`, which Iterable[Plain] does not meet
// error: `Plain` does not conform to `Ord`, the bound of `K` in `minBy`
// error: `Plain` does not conform to `Ord`, the bound of `K` in `maxBy`
// The methods every `Iterable` has that need more of its elements than traversal: `min` and `max`
// need `Ord` elements, and `minBy` and `maxBy` an `Ord` key.
data Plain(n: int)

main()
    val ps: Vector[Plain] = [Plain(1), Plain(2)]
    println(ps.min().isSome())
    val seen: Iterable[Plain] = ps
    println(seen.max().isSome())
    println(ps.minBy(p -> p).isSome())
    println(seen.iterator().maxBy(p -> p).isSome())
