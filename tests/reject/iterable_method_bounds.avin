// error: `toSet` needs `T: Eq`, which Iterable[U] does not meet
// error: `min` needs `T: Ord`, which Vector[Plain] does not meet
// error: `max` needs `T: Ord`, which Iterable[Plain] does not meet
// error: `Plain` does not conform to `Ord`, the bound of `K` in `minBy`
// The methods every `Iterable` has that need more of its elements than traversal: `min`, `max` and
// `minBy`'s key need `Ord`, and `toSet` needs `Eq` and `Hash`.
data Plain(n: int)

unbounded[U](xs: Iterable[U]) -> int = xs.toSet().size()

main()
    val ps: Vector[Plain] = [Plain(1), Plain(2)]
    print(ps.min().isSome())
    val seen: Iterable[Plain] = ps
    print(seen.max().isSome())
    print(ps.minBy(p -> p).isSome())
