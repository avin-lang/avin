// error: a select arm is a channel's `receive()` or `send(x)`, a stream's `readable()` or `writable()`, `after` a duration, or `else`; a guard follows the arm's operation
// An arm takes one guard; a guard does not make a malformed arm well formed; a guard with no
// operation before it is reported.
import avin.threads.Channel

main()
  val c = Channel[int]()
  select
    c.send(1) if true if false -> ()
    c.close() if true -> ()
    if true -> ()
    c.receive() -> ()
