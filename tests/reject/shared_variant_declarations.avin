// error: `Normal` is already a variant of `Slant` and `Weight`
// error: `Bold` is already a variant of `Weight` and `Two`
// error: `Oblique` is a variant of `Slant` and `Mark`, not a type
// error: the variant `Italic` is declared more than once
// error: `Spare` is already a variant of `Lone` and `Other`
// A variant's name may be shared between types of a module, but not with the module's functions,
// values or objects, and is still not a type; within one type each variant has a name of its own.
data Slant
    Normal
    Italic
    Oblique
    Italic

data Weight
    Normal
    Bold

data Mark
    Circle(label: string)
    Oblique

data Two
    Bold

data Lone
    Spare

data Other
    Spare

Normal() -> int = 1

val Bold = 2

object Spare
    val n = 1

lean(o: Oblique) -> int = 0

main() = ()
