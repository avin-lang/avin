// Memory C lends a callback, its length beside it, crosses as a `ByteView` where it is `const` and a
// `MutByteView` where it is not; only such a pointer crosses as a view, and a block never does.
// error: parameter 2 of the C binding `constMutable` takes the function C calls through `f`, and `(MutByteView) -> int` cannot be it: its parameter 1 is `MutByteView` in Avin and `const unsigned char *` in C: C lends this memory `const`, so it crosses as a `ByteView`
// error: parameter 2 of the C binding `mutableRead` takes the function C calls through `f`, and `(ByteView) -> int` cannot be it: its parameter 1 is `ByteView` in Avin and `unsigned char *` in C: C lends this memory to be written, as it is not `const`, so it crosses as a `MutByteView`
// error: parameter 2 of the C binding `asArray` takes the function C calls through `f`, and `(Array[byte]) -> int` cannot be it: its parameter 1 is `Array[byte]` in Avin and `const unsigned char *` in C: memory C lends a callback, its length beside it, crosses as a view: a `ByteView` where it is `const` and a `MutByteView` where it is not, perhaps in an `Option` for null
// error: parameter 2 of the C binding `asBlock` takes the function C calls through `f`, and `(ByteBlock) -> int` cannot be it: its parameter 1 is `ByteBlock` in Avin and `const unsigned char *` in C: a `ByteBlock` is memory Avin gives C; memory C lends a callback is a `ByteView`, or a `MutByteView` where it is not `const`
// error: parameter 2 of the C binding `noLength` takes the function C calls through `f`, and `(ByteView) -> int` cannot be it: its parameter 1 is `ByteView` in Avin and `const unsigned char *` in C: memory C lends a callback is a view, its length given by a parameter of C's function marked `length(data)`
import avin.c.{ByteBlock, ByteView, MutByteView}

@c(
  "int w(int n, int (*f)(userdata void *ud, const unsigned char *data, length(data) unsigned int length), userdata void *ud)"
)
constMutable(n: int, f: (MutByteView) -> int) -> int

@c(
  "int w(int n, int (*f)(userdata void *ud, unsigned char *data, length(data) unsigned int length), userdata void *ud)"
)
mutableRead(n: int, f: (ByteView) -> int) -> int

@c(
  "int w(int n, int (*f)(userdata void *ud, const unsigned char *data, length(data) unsigned int length), userdata void *ud)"
)
asArray(n: int, f: (Array[byte]) -> int) -> int

@c(
  "int w(int n, int (*f)(userdata void *ud, const unsigned char *data, length(data) unsigned int length), userdata void *ud)"
)
asBlock(n: int, f: (ByteBlock) -> int) -> int

@c("int w(int n, int (*f)(userdata void *ud, const unsigned char *data), userdata void *ud)")
noLength(n: int, f: (ByteView) -> int) -> int

main() = 0
