// error: what is passed for `f` of `pick` is sendable inside it, so it is a `match` function written in place, a value of a sendable type or a parameter marked `@sendable`, but it is a `PartialFunction[char, int]`, which is a trait that does not promise to be sendable; declare it `trait PartialFunction: Sendable`, and every type implementing it is checked to be
// error: what is passed for `f` of `pick` may use only sendable values from around it, but it uses `arr`, an `Array[int]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: what is passed for `f` of `pick` may use only sendable values from around it, but it uses `pf`, a `PartialFunction[char, int]`, which is a trait that does not promise to be sendable; declare it `trait PartialFunction: Sendable`, and every type implementing it is checked to be
// A class's `@sendable` `var` parameter may be assigned anything later, so it is not sendable. A `match`
// function's arms that use a mutable local are refused; a partial function held in a local, or made
// by `orElse` of two marked parameters, is a `PartialFunction`, which does not promise `Sendable`.
data Rule[T](run: @sendable (char) -> Option[T])
pick[U](@sendable f: PartialFunction[char, U]) -> Rule[U] = Rule(c -> if f.isDefinedAt(c) then Some(f(c)) else None)
class Mutable(@sendable var f: PartialFunction[char, int])
    rule() -> Rule[int] = pick(f)
both(@sendable f: PartialFunction[char, int], @sendable g: PartialFunction[char, int]) -> Rule[int] = pick(f.orElse(g))
main() =
    val arr = Array.fill(2, 0)
    val h = pick(match 'a' -> arr.length())
    val pf: PartialFunction[char, int] = match 'a' -> 1
    val i = pick(pf)
    println(both(match 'a' -> 1, match 'b' -> 2).run('a'))
