// error: a line indented under a continued expression continues it, so it starts with a binary operator or `.`
// A line indented under a continuation line goes on with the expression, so it starts with an
// operator or a member's `.`; one that does not is neither a continuation nor a block.

sum(a: int, b: int) -> int
    val total = a
        + b
        b
    total

main() -> int = sum(1, 2)
