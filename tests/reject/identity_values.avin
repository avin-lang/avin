// error: `===` compares identities, and Tile values have none
// error: `===` compares identities, and string values have none
// error: `===` compares identities, and (int, int) values have none
// error: `!==` compares identities, and Option[Sq] values have none
// error: `===` is undefined on Any and Any, which may hold values with no identity

// Value types have no identity, whatever they hold, and two `Any`s may each hold one.

class Sq(s: int)

data Tile(s: int)

tiles(a: Tile, b: Tile) -> bool = a === b

strings(a: string, b: string) -> bool = a === b

tuples(a: (int, int), b: (int, int)) -> bool = a === b

options(a: Option[Sq], b: Option[Sq]) -> bool = a !== b

anys(a: Any, b: Any) -> bool = a === b

main()
    println(anys(1, 1))
