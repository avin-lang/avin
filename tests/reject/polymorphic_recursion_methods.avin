// error: each round of the cycle `Box.grow` -> `Box.grow` passes `Nest[T]` for `T`
// error: each round of the cycle `Shell.depth` -> `Shell` -> `Shell.depth` passes `(T, int)` for `T`
// error: each round of the cycle `Cell.size` -> `viaBound` -> `Cell.size` passes `Cell[Vector[T]]` for `S`
// error: each round of the cycle `Pair.nest` -> `Pair.nest` passes `Pair[B]` for `B`
// Methods whose type arguments grow: a class's own method on a new object of a larger instance,
// an override reached through a trait-typed value and through a bounded type parameter, so the
// growth runs through the class's method table, and a method's own type parameter.

data Nest[T](x: T)

trait Deep
    depth(n: int) -> int

trait Sized
    size(n: int) -> int

class Box[T](val x: T)
    grow(n: int) -> int = if n == 0 then 0 else Box(Nest(x)).grow(n - 1)

class Shell[T](val x: T) : Deep
    override depth(n: int) -> int = if n == 0 then 0 else viaTrait(Shell((x, 1)), n - 1)

viaTrait(d: Deep, n: int) -> int = d.depth(n)

class Cell[T](val x: T) : Sized
    override size(n: int) -> int = if n == 0 then 0 else viaBound(Cell([x]), n - 1)

viaBound[S: Sized](s: S, n: int) -> int = s.size(n)

class Pair[A](val a: A)
    nest[B](b: B, n: int) -> int = if n == 0 then 0 else nest(Pair(b), n - 1)

main() -> int
    Box(1).grow(3) + viaTrait(Shell(1), 3) + viaBound(Cell(1), 3) + Pair(1).nest(2, 3)
