// error: expected bool, found Plain
// error: `~` needs an integer or a byte, not Plain
// error: `+` needs a number, not Plain
// error: expected bool, found Cond
// error: `~` needs an integer or a byte, not Twice
// A type with no method of a prefix operator's name keeps the operator's own meaning, which it does
// not have; a `!` yielding a `Cond` is no operand of `&&`; and a method `~` taking an argument is the
// binary `~`, which a prefix `~` does not call.
data Plain(n: int)

data Cond(text: string)

impl Cond
  !() -> Cond = Cond(s"NOT $text")

data Twice(n: int)

impl Twice
  ~(other: Twice) -> Twice = other

main()
  val p = Plain(1)
  val a = !p
  val b = ~p
  val d = +p
  val e = !Cond("x") && true
  val f = ~Twice(1)
