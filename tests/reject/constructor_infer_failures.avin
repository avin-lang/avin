// error: cannot infer `F` from `Result[int, ParseError]`: `Result` takes two arguments and `F` one, and nothing says which is left open; write it, as in `same[Result[_, ParseError]](arguments)`
// error: cannot infer `F` from `Either[string, int]`: `Either` takes two arguments and `F` one, and nothing says which is left open; write it, as in `ints[Either[string, _]](arguments)`
// error: cannot infer `F` from `IntBox`: `F[_]` takes a constructor of one argument, such as `Option`, and `IntBox` takes no type arguments
// error: cannot infer `G` from `Option[int]`: `G[_, _]` takes a constructor of two arguments, such as `Either`, and `Option` takes one argument
// error: cannot infer `F` from `(int, int)`: `F[_]` takes a constructor of one argument, such as `Option`, and `(int, int)` is no data type, class or trait; write it, as in `same[Option](arguments)`
// Without a bound, a constructor parameter is inferred only from a type of exactly as many type
// parameters as it has holes; a type of more says nothing of which are left open, and each failure
// is reported once, for the constructor, and not again for the arguments it is applied to.
data ParseError(message: string)

class IntBox(val n: int)

same[F[_], A](x: F[A]) -> F[A] = x

ints[F[_]](x: F[int]) -> F[int] = x

pair[G[_, _], A, B](x: G[A, B]) -> G[A, B] = x

main()
  val r: Result[int, ParseError] = Ok(1)
  println(same(r))
  val e: Either[string, int] = Right(2)
  println(ints(e))
  println(same(IntBox(1)))
  println(pair(Some(1)))
  println(same((1, 2)))
