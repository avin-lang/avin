// The array `array:` names is answered through `out T **`, or filled through `out T *`, copied into
// an `Array` of a struct mirror of `T` or of an element type an array crosses as, perhaps in an
// `Option`, and never `inout`.
// error: out value 1 of the C binding `updated`, `glyphs`, is `Array[Glyph]` in Avin and `as_glyph *` in C: C answers the array `glyphs`, so it is `out`, not `inout`
// error: out value 1 of the C binding `onePointer`, `glyphs`, is `Array[Glyph]` in Avin and `as_point` in C: `Glyph` mirrors `as_glyph`, so an array of it is answered as `out as_glyph *glyphs`
// error: out value 1 of the C binding `otherStruct`, `glyphs`, is `Array[Glyph]` in Avin and `as_point *` in C: `Glyph` mirrors `as_glyph`, so an array of it is answered as `out as_glyph **glyphs`
// error: out value 1 of the C binding `bools`, `flags`, is `Array[bool]` in Avin and `bool *` in C: an array C answers is copied into an `Array[byte]`, `Array[int]`, `Array[long]`, `Array[real]` or an `Array` of a struct mirror
// error: parameter 1 of the C binding `updated` is `Array[Glyph]` in Avin and `as_glyph * *` in C, `inout`: an array is passed in, a pointer to its elements, and never `inout`

@c(struct: "as_glyph")
data Glyph(index: long, x: real, y: real)

@c("void as_update(inout as_glyph **glyphs, out int *count)", array: "glyphs", length: "count")
updated(glyphs: Array[Glyph]) -> (Array[Glyph], int)

@c("void as_one(int count, out as_point *glyphs)", array: "glyphs", length: "count")
onePointer(count: int) -> Array[Glyph]

@c("void as_points(out as_point **glyphs, out int *count)", array: "glyphs", length: "count")
otherStruct() -> (Array[Glyph], int)

@c("void as_flags(out bool **flags, out int *count)", array: "flags", length: "count")
bools() -> (Array[bool], int)

main() = 0
