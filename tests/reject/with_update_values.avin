// error: expected int, found string
// error: expected string, found int
// error: expected Option[int], found real
// error: expected Point, found Sprite
// error: expected bool, found int

data Box[T](v: T, label: string)

data Point(x: int, y: int)

data Sprite(pos: Point, flag: bool)

main()
    // The type stays the base's: a change cannot turn a `Box[int]` into a `Box[string]`.
    val a = Box(1, "a") with { v = "s" }
    val b = Box(1, "a") with { label = 2 }
    val c = Box(Some(1), "o") with { v = 1.5 }
    val s = Sprite(Point(1, 2), false)
    val d = s with { pos = s }
    val e = s with { pos.x = 1, flag = 0 }
