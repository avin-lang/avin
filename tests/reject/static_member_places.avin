// error: `origin` is static, which only a trait's member, its implementations and a built-in type's own members are; an impl of `Plain` without a trait adds methods of values, and its companion object holds what belongs to the type
// error: `origin` is static, which only a trait's member and its implementations are; `Spot` conforms to no trait with a static `origin`
// error: `Tag` mentions `Self`, so it is a bound, as in `[T: Tag]`, and not a type
// error: `zero` is static, so no trait overrides it: each type implementing the trait gives its own
// error: `make` is a static member of `Maker`, so it has no default body: each type implementing `Maker` gives its own
// A static member is a trait's, implements one, or is a built-in type's own; a trait with one is a bound and not a type, since
// a value of the trait's type would have no type to give it; and a trait neither overrides one nor
// gives it a default body.

data Plain(n: int)

impl Plain
    static origin() -> Plain = Plain(0)

class Spot
    static origin() -> Spot = Spot()

trait Tag
    static tag() -> string

keep(t: Tag) -> int = 0

trait Summable: Add
    override static zero() -> Self

trait Maker
    static make() -> Self = make()

main() = ()
