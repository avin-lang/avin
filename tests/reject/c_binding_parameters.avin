// A C binding's parameters are values, one per C parameter: a by-name parameter, evaluated at each
// read, and a repeated one, any number of values, cannot cross.
// error: a by-name parameter cannot cross a C binding
// error: a repeated parameter cannot cross a C binding

@c("int abs(int)")
lazy(n: -> int) -> int

@c("int abs(int)")
many(n: int*) -> int

main() = 0
