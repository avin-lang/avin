// error: `int` does not implement Grow's `+`; a built-in type takes no default bodies, so its impl implements every method of the trait
// error: `+` is the language's operator on int, and no method can redefine it
// A trait may declare a method `+`, but a built-in type cannot implement it: its `+` stays the
// machine's.
trait Grow
    +(n: int) -> Grow

impl Grow for int
    +(n: int) -> Grow = self

main()
    println(1)
