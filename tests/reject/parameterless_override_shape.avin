// The parameter-list shape is part of a method's signature: an override, or an implementation of a
// trait's method in a class or a data type's impl, is declared with no parameter list exactly where
// the method it overrides is.
// error: `a` overrides `T.a`, which is declared without a parameter list; declare this one `a -> …` too
// error: `b` overrides `T.b`, which is declared with a parameter list, `b()`; declare this one `b() -> …` too
// error: `sound` overrides `Animal.sound`, which is declared without a parameter list; declare this one `sound -> …` too
// error: `a` implements `T.a`, which is declared without a parameter list; declare this one `a -> …` too

trait T
    a -> int
    b() -> int

class C : T
    override a() -> int = 1
    override b -> int = 2

abstract class Animal
    sound -> string

class Dog : Animal
    override sound() -> string = "woof"

data P(x: int)

impl T for P
    override a() -> int = 1
    override b() -> int = 2

main() = 0
