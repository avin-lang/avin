// A struct mirror crosses as its struct by value, through a `const` pointer to it, which an `Option`
// passes null to, or `inout` through a pointer to it; a pointer C may write takes no mirror passed in.
// error: parameter 1 of the C binding `writes` is `Point` in Avin and `as_point *` in C: C may write through `as_point *`, so a mirror passed in goes to `const as_point *`, and one C fills or updates is `out` or `inout`
// error: parameter 1 of the C binding `optional` is `Option[Point]` in Avin and `as_point` in C: `None` is null, so an `Option` of a mirror is passed as `const as_point *`
// error: parameter 1 of the C binding `wrong` is `Point` in Avin and `as_rect` in C: `Point` mirrors `as_point`, so it crosses as `as_point` by value or `const as_point *`
// error: parameter 1 of the C binding `inoutNone` is `Option[Point]` in Avin and `as_point *` in C, `inout`: an `inout` value is read and written by C, so it is never `None`
// error: out value 1 of the C binding `inoutNone`, `p`, is `Option[Point]` in Avin and `as_point` in C: C fills an out value, so it is never `None`

@c(struct: "as_point")
data Point(x: real, y: real)

@c("double as_write(as_point *p)")
writes(p: Point) -> real

@c("double as_by_value(as_point p)")
optional(p: Option[Point]) -> real

@c("double as_rect_area(as_rect r)")
wrong(r: Point) -> real

@c("void as_update(inout as_point *p)")
inoutNone(p: Option[Point]) -> Option[Point]

main() = 0
