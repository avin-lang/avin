// error: a `lazy` value is computed once and never assigned, so it is declared `lazy val`
// error: a `lazy val` is computed from its initializer, so it needs one
// error: a `lazy val` names one value; take the value apart where it is read
// A local `lazy val` is one name with an initializer: `lazy var`, one without an initializer and one
// that takes a value apart are refused where they are declared.
main()
  lazy var counter = 0
  lazy val missing: int
  lazy val (a, b) = (1, 2)
  lazy val first, second = (1, 2)
