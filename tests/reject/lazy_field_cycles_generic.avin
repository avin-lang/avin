// error: the `lazy val` `again` needs its own value to initialize: `again` → `again`
// error: the `lazy val` `head` needs its own value to initialize: `head` → `rest` → `head`
// error: the `lazy val` `size` needs its own value to initialize: `size` → `size`
// error: the `lazy val` `shown` needs its own value to initialize: `shown` → `shown`
// error: the `lazy val` `total` needs its own value to initialize: `total` → `total`
// The field rule holds for a generic class as for any other: the initializer is checked once for
// every instance, directly, through another lazy field, through a generic method, through a generic
// subclass's override, and through a generic function given the object.
class Cell[T](seed: T)
  lazy val again: Vector[T] = again :+ seed

class Pair[A, B](a: A, b: B)
  lazy val head: Vector[A] = rest.map(_ -> a)
  lazy val rest: Vector[B] = if head.length > 0 then [b] else []

class Holder[T](items: Vector[T])
  lazy val size: int = count[T]()

  count[U]() -> int = items.length + size

open class Base[T](value: T)
  lazy val shown: string = describe()

  describe() -> string = "base"

class Derived[T](value: T): Base[T](value)
  override describe() -> string = shown + "!"

class Bag[T](items: Vector[T])
  lazy val total: int = measure(self)

measure[T](bag: Bag[T]) -> int = bag.items.length + bag.total

main() = ()
