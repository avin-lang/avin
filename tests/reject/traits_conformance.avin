// error: `size` is already a method of `Sized`, which `Measured` requires; mark it `override` to replace its default
// error: `Sized` is a trait, which has no constructor; name it without arguments
// error: `Yields.size` implements `Sized.size`, which yields int, not string
// error: a trait may require only traits, not a class
// error: `Loop` requires itself
trait Sized
  size() -> int

trait Measured: Sized
  size() -> int = 1

class Called: Sized()

class Yields: Sized
  override size() -> string = "big"

open class Base

trait Bad: Base

trait Loop: Loop

main() = ()
