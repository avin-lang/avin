// error: `T` has no member `MaxValu`
// error: `T` has no member `Bits`
// error: `T` has no member `MaxValue`: a type parameter has the integer limits where it is bounded by `Integer`, as in `[T: Integer]`
// error: `T` has no member `MinValue`: a type parameter has the integer limits where it is bounded by `Integer`, as in `[T: Integer]`
// error: `T` has no member `MaxValue`: a type parameter has the integer limits where it is bounded by `Integer`, as in `[T: Integer]`
misspelled[T: Integer](x: T) -> T = T.MaxValu
other[T: Integer](x: T) -> T = T.Bits
unbounded[T](x: T) -> T = T.MaxValue
ordered[T: Ord](x: T) -> T = T.MinValue
defaulted[T](x: T, y: T = T.MaxValue) -> T = y

main() -> int
    0
