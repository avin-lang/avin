// A template is checked once, where it is declared, and its errors are reported there rather than at
// each type deriving it. `Shaped` is the bound only a template's `T` has. An annotation names a type
// or an object implementing `Annotation`. A visitor the template names declares a `field` hook.
// error: `nothingHere` is not a member of `Broken + Shaped`, the bound of `T`
// error: `Shaped` is the bound a derive template's type has, and no other
// error: unknown annotation `@Missing`; an annotation is a value of a type or an object implementing `Annotation`
// error: expected Annotation, found Plain
// error: `Item` cannot derive `Shown`: the visitor `Plain` the template names declares no method `field[F: Bound](f: FieldShape, value: F)`, with one type parameter of its own

trait Broken
  broken() -> int

derive Broken for T
  broken() -> int = self.nothingHere()

data Fine(n: int) derives Broken

shaped[T: Shaped](x: T) -> int = 0

data Plain(text: string)

impl ShapeVisitor for Plain
  variant(v: VariantShape) -> Plain = self

data Tagged(@Missing n: int, @Plain("x") m: int)

trait Shown
  shown() -> string

derive Shown for T
  shown() -> string = T.walk(self, Plain("")).text

data Item(n: int) derives Shown

main() = 0
