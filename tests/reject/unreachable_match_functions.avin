// error: this arm is never reached: the arms before it already match every value it would
// error: this arm is never reached: the arm `n` on line 16 already matches every value it would
// error: this arm is never reached: the arm `_` on line 19 already matches every value it would
// A `match` function's arms, and a `match` inside a lambda, are held to the same rule.
data Shape
    Circle(r: real)
    Dot

main()
    val shapes = [Circle(1.0), Dot]
    val radii = shapes.map(match
        Circle(r) -> r
        Dot -> 0.0
        _ -> -1.0)
    val f: (int) -> int = match
        n -> n
        0 -> 1
    val g = (n: int) -> n match
        _ -> 0
        5 -> 5
    println(radii.size + f(1) + g(2))
