// error: `Thing` does not conform to `Ord`, the bound of `A` in `Sorted`
// error: `Gadget` does not conform to `Ord`, the bound of `A` in `Sorted`
// error: `Widget` does not conform to `Ord`, the bound of `A` in `Sorted`
// error: `T` does not conform to `Ord`, the bound of `A` in `Sorted`
// error: `Note` does not conform to `Display`, the bound of `B` in `Titled`
// A variant parameter's bounds are checked where a value is made, as a call's are: inferred from the
// fields, written on the variant, written on the type, and in generic code, where a type parameter
// without the bound is refused; a hidden parameter beside it is checked the same way.

data Coll[T]
  Plain(items: Vector[T])
  Sorted[A: Ord](items: Vector[A]) -> Coll[A]
  Titled[A: Ord, B: Display](items: Vector[A], label: B) -> Coll[A]

class Thing(val n: int)
class Gadget(val n: int)
class Widget(val n: int)
class Note(val text: string)

sorted[T](items: Vector[T]) -> Coll[T] = Sorted(items)

main()
  val a = Sorted([Thing(1)])
  val b = Coll[Gadget].Sorted([Gadget(2)])
  val c = Sorted[Widget]([])
  val d = Titled([1], Note("n"))
  val e = Titled(["ok"], 2)
