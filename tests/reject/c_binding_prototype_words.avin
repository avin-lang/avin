// The words a prototype may not hold: storage classes, a parameter of type `void`, one declared with
// brackets, the marker word `out` on a parameter that is no pointer, and keywords that make no type.
// error: and this one is not: `static` is not part of a function's prototype
// error: and this one is not: a parameter cannot be `void`; a function taking nothing is written `(void)`
// error: and this one is not: a parameter declared with brackets is written as the pointer C passes, as in `int *values`, its length carried by a parameter marked `length(values)`
// error: and this one is not: an `out` parameter is a pointer C writes the value through, as in `out int *x`, and `int` is not one
// error: and this one is not: `signed` and `unsigned` do not combine

@c("static int abs(int)")
storage(n: int) -> int

@c("int abs(void, int)")
voidParameter(n: int) -> int

@c("int sum(int values[4])")
array(n: int) -> int

@c("int fill(out int n)")
filled() -> int

@c("signed unsigned abs(int)")
contradiction(n: int) -> int

main() = 0
