// The words a prototype may not hold: storage classes, a parameter of type `void`, an array, the
// marker words of out parameters, which are not implemented, and keywords that make no type.
// error: and this one is not: `static` is not part of a function's prototype
// error: and this one is not: a parameter cannot be `void`; a function taking nothing is written `(void)`
// error: and this one is not: an array parameter cannot cross a C binding: arrays are not implemented
// error: and this one is not: `out` parameters are not implemented
// error: and this one is not: `signed` and `unsigned` do not combine

@c("static int abs(int)")
storage(n: int) -> int

@c("int abs(void, int)")
voidParameter(n: int) -> int

@c("int sum(int values[4])")
array(n: int) -> int

@c("int fill(out int *n)")
filled() -> int

@c("signed unsigned abs(int)")
contradiction(n: int) -> int

main() = 0
