// A C binding is a top-level function, or a method of a C handle: a method bound to C on any other
// class is refused.
// error: `@c` on a method binds a method of a C handle, a class declared with `@c(type: …)`, or of an opaque value, one declared with `@c(value: …)`; a C binding is otherwise a top-level function

class Counter
    @c("int abs(int)")
    abs(n: int) -> int

main() = 0
