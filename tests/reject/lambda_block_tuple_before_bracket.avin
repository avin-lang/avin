// error: `pair` takes 1 argument, not 2
// error: this lambda yields int, not (int, string)
// A block's last line that closes a bracket opened before the block ends at its comma, so a tuple the
// lambda means to yield there is written in parentheses; without them the items are the call's.

pair(f: () -> (int, string)) -> string
  val t = f()
  s"${t.0} ${t.1}"

main()
  println(pair(() ->
    val k = 8
    k, "eight"))
