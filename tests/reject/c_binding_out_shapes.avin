// The result of a binding with `out` parameters is the C result followed by the out values, or the out
// values alone, one alone no tuple, or a status holding them; the Avin parameters are the rest. A
// handle is never passed `inout`.
// error: the C binding `tooMany` has 2 parameters and its prototype 1 parameter, besides its 1 `out` parameter, which are part of the result: they correspond by position
// error: the result of the C binding `notATuple` is `int`: the C function answers nothing, so the binding answers its 2 out values, a tuple of 2
// error: the result of the C binding `wrongArity` is `(int, int, int)`: the binding answers the C result followed by its one out value, a tuple of 2, or its one out value alone
// error: the result of the C binding `okArity` is `Result[int, int]`: the `Ok` of a status holds the 2 out values of the call, a tuple of 2
// error: parameter 1 of the C binding `inoutHandle` is `Thing` in Avin and `struct thing * *` in C, `inout`: a handle is not passed `inout`: whether C keeps the reference it is passed or replaces it, the binding cannot say

@c(type: "struct thing *", release: "thing_free")
class Thing

@c("int count(int a, out int *b)")
tooMany(a: int, b: int) -> int

@c("void two(out int *a, out int *b)")
notATuple() -> int

@c("int sum(int a, out int *b)")
wrongArity(a: int) -> (int, int, int)

@c("int split(out int *a, out int *b)")
okArity() -> Result[int, int]

@c("void swap(inout struct thing **t)")
inoutHandle(t: Thing) -> Thing

main() = 0
