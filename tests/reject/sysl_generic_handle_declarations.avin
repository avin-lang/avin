// A generic handle's type parameters are the Sysl type's own: invariant, and not beside type
// arguments in its `@sysl`. `Boundary` is decided from a type's structure, so it is only a bound:
// not a type, an impl's trait or a trait's parent.
// error: a Sysl handle's type parameters are invariant, as the Sysl type's are
// error: a Sysl handle names an instance of a generic Sysl type or has type parameters, the Sysl type's own, but not both
// error: `Boundary` is a bound, as in `[T: Boundary]`, and not a type
// error: `Boundary` is decided from a type's structure, so it is a bound, as in `[T: Boundary]`, and no declaration promises it

@sysl("pkg.values.Signal")
class Covariant[+T: Boundary]
    read() -> T

@sysl("pkg.values.Signal[int]")
class Both[T: Boundary]
    read() -> int

data Wrapped(n: int)

impl Boundary for Wrapped

trait Crossing: Boundary

main()
    val b: Boundary = 3
