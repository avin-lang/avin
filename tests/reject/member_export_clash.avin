// error: `count` is exported twice by `Two`, by `export a.count` and by `export b.count`
// error: `Own` declares `count` itself, so it does not export one
// error: `Field` has a field `count` of its own, so it does not export one
// error: `bump` is already a method of `Base`, which `Sub` extends, so it does not export one
// error: every value has its own `equals`, so `equals` is not exported
// A name an export presents is new to its type: not presented twice, not a member the type declares,
// not a field, not a superclass's method, and never `equals`.
class Counter(var count: int)
  bump() = count += 1

class Two(a: Counter, b: Counter)
  export a.count
  export b.count

class Own(c: Counter)
  export c.count
  count -> int = 0

class Field(count: int, c: Counter)
  export c.count

open class Base
  bump() = ()

class Sub(c: Counter): Base
  export c.bump
  export c.equals

main() = ()
