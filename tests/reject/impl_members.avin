// error: an impl adds methods, not state, so it cannot declare the field `count`
// error: `label` implements `Named.label`, so it belongs in an impl of `Named` for `Word`
// error: `shout` is not a method of `Named`; an impl of a trait implements the trait's methods, and `impl Word` adds others
// error: `string` is declared in another module; an impl adding methods to it belongs in that module
// error: the type an impl adds to takes the impl's type parameters, in order, as in `impl[T] Box[T]`
trait Named
    label() -> string

data Word(text: string)

impl Word
    var count = 0
    label() -> string = text

impl Named for Word
    shout() -> string = text + "!"

impl string
    loud() -> string = self + "!"

data Box[T](value: T)

impl[T] Box[int]
    get() -> int = value

main() = ()
