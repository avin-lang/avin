// error: an impl adds methods, not state, so it cannot declare the field `count`
// error: `label` implements `Named.label`, so it belongs in an impl of `Named` for `Word`
// error: `shout` is not a method of `Named`; an impl of a trait implements the trait's methods, and `impl Word` adds others
// error: `T` is not part of `Box[int]`; each of an impl's type parameters is, so a call learns it from the receiver's type
trait Named
    label() -> string

data Word(text: string)

impl Word
    var count = 0
    label() -> string = text

impl Named for Word
    shout() -> string = text + "!"

data Box[T](value: T)

impl[T] Box[int]
    get() -> int = value

main() = ()
