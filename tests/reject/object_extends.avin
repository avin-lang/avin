class Final(x: int)

object Bad: Final(1)

abstract class Needy(val n: int)

object Missing: Needy()

abstract class Shape
    area() -> int

object Lazy: Shape()

open class Logged(name: string)
    val tag = name

object Loop: Logged(s"loop-$after")

val after = Loop.tag

object Clash: Logged("c")
    override tag() -> string = "x"

main()
    println("unreached")
