// error: expected string, found int
// error: `Box[Plain]` does not conform to `JsonEncoder`, the bound of `A` in `encode`
// error: `Box[Plain]` does not conform to `JsonDecoder`, the bound of `A` in `decode`
// error: `Plain` does not conform to `JsonEncoder`, the bound of `A` in `encode`
// A generic type derives the JSON traits conditionally, so an instance at a type argument without
// them has none; `json.encode` and `json.decode` take only types that have them; and an annotation
// is a call of its type, its arguments checked as any call's.
import avin.json
import avin.json.JsonEncoder
import avin.json.JsonDecoder
import avin.json.JsonKey

data Plain(n: int)

data Box[A](item: A) derives JsonEncoder, JsonDecoder

data Named(@JsonKey(1) name: string) derives JsonEncoder

main()
    println(json.encode(Box(Plain(1))))
    println(json.decode[Box[Plain]]("{}"))
    println(json.encode(Plain(2)))
