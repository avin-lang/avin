// error: this `match` does not cover every int value, since an extractor may answer that it does not match; add an arm for the rest, such as `_`
// error: this `match` does not cover every Option[int] value, since an extractor may answer that it does not match; add an arm for the rest, such as `_`
// error: this `match` does not cover every Option[int] value, such as `None`; add an arm for it, or `_` for the rest
// error: this `match` does not cover every int value, such as `-1`; add an arm for it, or `_` for the rest
// error: this `match` does not cover every Vector[int] value, such as `[]`; add an arm for it, or `_` for the rest
object Twice
  unapply(n: int) -> Option[int] = if n % 2 == 0 then Some(n / 2) else None

// An extractor may take any value the literals leave, so no value is named as one it misses.
withLiterals(n: int) -> int = n match
  1 -> 1
  3 -> 3
  Twice(h) -> h

nested(o: Option[int]) -> int = o match
  Some(Twice(h)) -> h
  None -> 0

// A value no arm can match, whatever the extractor answers, is named as before.
missingNone(o: Option[int]) -> int = o match
  Some(Twice(h)) -> h

// A guarded arm never counts, so its literal values are among those left.
guarded(n: int) -> int = n match
  k >= 0 if k > 100 -> 1
  k >= 0 -> 2
  Twice(h) if h > 0 -> h

sequenceOfExtractors(xs: Vector[int]) -> int = xs match
  [Twice(h), _*] -> h

main() = 0
