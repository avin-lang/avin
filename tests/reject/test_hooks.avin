// error: a `@setup` function takes no parameters, and `takesOne` takes 1 parameter: `avin test` calls it with nothing
// error: a `@teardown` function yields unit, and `givesBack` yields int: the runner reads nothing from it
// error: a module declares at most one `@setup_all`, and this one already has `first`
// error: `@teardown_all` takes no arguments
// error: `ignore` is said of a test, as an argument of `@test`: `@test(ignore: "why")`
// A test hook is a top-level function the runner calls with nothing and reads nothing from, and a
// module declares at most one of each kind. What a test is told is said in its `@test`.

@setup
takesOne(n: int)
    print(n)

@teardown
givesBack() -> int = 1

@setup_all
first()
    print("first")

@setup_all
second()
    print("second")

@teardown_all("now")
closes()
    print("closing")

@ignore("why")
@test
waits()
    assert(true)

main() = 0
