// A binding's integer result takes any Sysl integer, and nothing else: a Sysl value of another type
// is not converted into it, whether the binding is a function or a handle's method.
// error: the Sysl binding `unitInLastPlace` does not match `sysl.math.ulp`: an integer is made from a Sysl integer, but the value is real
// error: the Sysl binding `upperCode` does not match `sysl.unicode.to_upper`: an integer is made from a Sysl integer, but the value is char
// error: the Sysl binding `upperCount` does not match `sysl.text.to_upper`: an integer is made from a Sysl integer, but the value is string
// error: the Sysl binding `BigInt.zeroCount` does not match `sysl.math.bigint.BigInt`: an integer is made from a Sysl integer, but the value is bool
// error: the Sysl mirror `Utf8Error` does not match `sysl.text.Utf8Error`: an integer is made from a Sysl integer, but the value is bool

@sysl("sysl.math.ulp")
unitInLastPlace(x: real) -> long

@sysl("sysl.unicode.to_upper")
upperCode(c: char) -> int

@sysl("sysl.text.to_upper")
upperCount(s: string) -> int

@sysl("sysl.math.bigint.BigInt")
class BigInt
  @sysl("is_zero")
  zeroCount() -> int

@sysl("sysl.math.bigint.parse")
parseBigInt(s: string) -> Option[BigInt]

// A mirror's integer field is held to the same rule.
@sysl("sysl.text.Utf8Error")
data Utf8Error
  Utf8Error(offset: long, truncated: int)

@sysl("sysl.io.line_text")
lineText(b: Array[byte]) -> Result[string, Utf8Error]

main()
  println(lineText(Array.fill(1, byte(0xff))))
  println(unitInLastPlace(1.0))
  println(upperCode('a'))
  println(upperCount("x"))
  println(parseBigInt("7").get.zeroCount())
