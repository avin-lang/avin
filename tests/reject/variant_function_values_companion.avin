// error: no overload of `Stamp` has the parameter types of (bool) -> Stamp; the overloads are `Stamp(label: string)`, `Stamp.apply(n: int)`
// Where a data type's companion of a variant's name declares `apply`, the variant is one of the
// overloads the name offers as a function value, and an expected type none fits names every one.

data Stamp(label: string)

object Stamp
  apply(n: int) -> Stamp = Stamp(s"#$n")

main()
  val f: (bool) -> Stamp = Stamp
