// What an `Option` or a `Result` holds is held to the boundary types however deep it is.
// error: `Option[Array[int]]` cannot cross to Sysl
// error: `Option[i24]` cannot cross to Sysl
// error: `Result[Option[string], Option[Option[(int, int)]]]` cannot cross to Sysl

@sysl("sysl.hint.black_box")
maybeInts(s: string) -> Option[Array[int]]

@sysl("sysl.hint.black_box")
maybeOdd(o: Option[i24]) -> string

@sysl("sysl.hint.black_box")
deep(r: Result[Option[string], Option[Option[(int, int)]]]) -> string

main() = 0
