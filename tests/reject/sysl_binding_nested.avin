// What an `Option`, a `Result` or a collection holds is held to the boundary types however deep it
// is.
// error: `Option[Vector[Array[i24]]]` cannot cross to Sysl
// error: `Option[i24]` cannot cross to Sysl
// error: `Result[Option[string], Option[Option[(int, i24)]]]` cannot cross to Sysl

@sysl("sysl.hint.black_box")
maybeInts(s: string) -> Option[Vector[Array[i24]]]

@sysl("sysl.hint.black_box")
maybeOdd(o: Option[i24]) -> string

@sysl("sysl.hint.black_box")
deep(r: Result[Option[string], Option[Option[(int, i24)]]]) -> string

main() = 0
