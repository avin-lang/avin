// A generic binding's type parameters cross as the types they are given, so each is bounded by
// `Boundary`, in a parameter, a result, a callback's parameter and a generic handle's parameters;
// and a generic function passes its own type parameter on to one only where it is bounded so too.
// error: `T` cannot cross to Sysl; a type parameter crosses as the type it is given, which its bound holds to one Sysl type, as in `[T: Boundary]`
// error: `Option[U]` cannot cross to Sysl; a type parameter crosses as the type it is given, which its bound holds to one Sysl type, as in `[U: Boundary]`
// error: `V` cannot be a callback's parameter, which Sysl gives it; a type parameter crosses as the type it is given, which its bound holds to one Sysl type, as in `[V: Boundary]`
// error: a Sysl handle's type parameter is a type argument of the Sysl type, which is one Sysl type, so it is bounded by `Boundary`, as in `[B: Boundary]`
// error: `W` does not conform to `Boundary`, the bound of `T` in `same`; a type parameter is `Boundary` where it is bounded by it, as in `[W: Boundary]`

@sysl("pkg.values.same")
same[T: Boundary](x: T) -> T

@sysl("pkg.values.same")
unbounded[T](x: T) -> int

@sysl("pkg.values.none")
nothing[U](x: int) -> Option[U]

@sysl("pkg.values.applied")
applied[V](f: V -> int) -> int

@sysl("pkg.values.Box")
class Box[A: Boundary, B]
  read() -> A

passOn[W](x: W) -> W = same(x)

main() = ()
