// A mirror crosses only as the C type it mirrors: as a parameter, a result, a status and an out value
// of another type it is refused, and an `Option` of one does not cross.
// error: parameter 1 of the C binding `asInt` is `Mirror` in Avin and `int` in C: `Mirror` mirrors `e_t`, so it crosses as that type
// error: the result of the C binding `asOther` is `Mirror` in Avin and `other_t` in C: `Mirror` mirrors `e_t`, so it crosses as that type
// error: the result of the C binding `status` is `Result[unit, Mirror]` in Avin and `int` in C: `Mirror` mirrors `e_t`, so it crosses as that type
// error: out value 1 of the C binding `outOther`, `m`, is `Mirror` in Avin and `other_t` in C: `Mirror` mirrors `e_t`, so it crosses as that type
// error: parameter 1 of the C binding `optional` is `Option[Mirror]` in Avin and `e_t` in C: a typedef crosses as an integer type, `byte`, `bool`, `real` or a string, as the header's type is

@c(enum: "e_t", prefix: "E_")
data Mirror
  Zero
  One

@c("int f(int x)")
asInt(m: Mirror) -> int

@c("other_t g(void)")
asOther() -> Mirror

@c("int h(void)")
status() -> Result[unit, Mirror]

@c("void k(out other_t *m)")
outOther() -> Mirror

@c("void n(e_t x)")
optional(m: Option[Mirror])

main() = 0
