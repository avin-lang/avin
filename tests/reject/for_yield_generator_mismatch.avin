// error: the generator of `n` makes `Option[int]`, which the generator before it cannot go on with: the `flatMap` of `Parser[int]` takes a function answering `Parser[B]`
// error: the generator of `y` makes `Ident[int]`, which the generator before it cannot go on with: the `flatMap` of `Option[int]` takes a function answering `Option[U]` or `Iterable[U]`
// A source admitted for its role whose call still fails is reported at the generator that gives the
// `flatMap` before it what it cannot take.

data Parser[A](run: (string) -> Option[(A, string)])

impl Monad for Parser
  static pure[X](value: X) -> Parser[X] = Parser(s -> Some((value, s)))

  flatMap[B](f: (A) -> Parser[B]) -> Parser[B] =
    Parser(s -> run(s).flatMap(match (a, rest) -> f(a).run(rest)))

data Ident[A](value: A)

impl Monad for Ident
  static pure[X](value: X) -> Ident[X] = Ident(value)

  flatMap[B](f: (A) -> Ident[B]) -> Ident[B] = f(value)

main()
  val parser = Parser.pure(1)
  val maybeInt: Option[int] = Some(2)
  val a = for p in parser, n in maybeInt yield p + n
  val b = for x in maybeInt, y in Ident(x) yield y
