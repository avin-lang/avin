// error: this recursive call of `viaLambda` is not in tail position: it is inside a lambda
// error: this recursive call of `viaByName` is not in tail position: it is inside a by-name argument
// error: this recursive call of `viaLocal` is not in tail position: it is inside local function `helper`
// error: this recursive call of `inGuard` is not in tail position: it is in a guard
// error: this recursive call of `inCondition` is not in tail position: its result is the condition of an `if`
// A recursive call inside a lambda, a by-name argument or a local function runs later or from
// another function, so it is never in tail position; nor is one whose result a guard or a condition
// tests. A lambda's own `return` leaves the lambda, not the function.

@tailrec
viaLambda(n: int) -> int
  val f = (x: int) -> viaLambda(x)
  if n == 0 then 0 else f(n - 1)

twice(x: -> int) -> int = x + x

@tailrec
viaByName(n: int) -> int = if n == 0 then 0 else twice(viaByName(n - 1))

@tailrec
viaLocal(n: int) -> int
  helper(x: int) -> int = viaLocal(x)
  if n == 0 then 0 else helper(n - 1)

@tailrec
inGuard(n: int) -> bool = n match
  0 -> true
  _ if inGuard(n - 1) -> false
  _ -> true

@tailrec
inCondition(n: int) -> bool = if inCondition(n - 1) then true else false

main() -> int = 0
