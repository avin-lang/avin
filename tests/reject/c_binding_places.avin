// A C binding is a function of its own: not generic, and not also a Sysl binding or an intrinsic.
// error: a C binding is not generic: the C function has one signature
// error: a function is an intrinsic or a C binding, not both
// error: a function is a Sysl binding or a C binding, not both

@c("int abs(int)")
generic[T](n: int) -> int

@sysl("sysl.math.abs")
@c("int abs(int)")
both(n: int) -> int

@intrinsic("int_abs")
@c("int abs(int)")
intrinsic(n: int) -> int

main() = 0
