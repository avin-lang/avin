// error: `==` cannot compare Item with Other
// error: `==` cannot compare Item with int
// error: `!=` cannot compare Shape with int
// error: `<` cannot compare Any values
class Item(n: int)
class Other(n: int)

trait Shape
  area() -> int

same(s: Shape) = if s != 1 then println("no")

main()
  val a = Item(1)
  if a == Other(1) then println("no")
  if a == 1 then println("no")
  val x: Any = 1
  if x == 1 < 2 then println("no")
