// error: `==` cannot compare Item with Other
// error: `==` cannot compare Item with int
// error: `!=` on the trait type Shape is not implemented
// error: `==` on Any is not implemented
class Item(n: int)
class Other(n: int)
trait Shape
    area() -> int

same(s: Shape) = if s != s then print("no")

main()
    val a = Item(1)
    if a == Other(1) then print("no")
    if a == 1 then print("no")
    same(a)
    val x: Any = 1
    if x == x then print("no")
