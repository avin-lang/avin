// error: `Scores` does not conform to `Sendable`, the bound of `U` in `take`: its representation is an `Array[int]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: `Box[Array[int]]` does not conform to `Sendable`, the bound of `U` in `take`: its representation is a `Vector[Array[int]]`, whose type argument `Array[int]` is mutable; an immutable copy (`toVector`) is sendable
// An opaque type is sendable where its representation is: one over a mutable array, or over a
// vector of them, is not; one over an immutable vector of sendable values is.
opaque type Scores = Array[int]
opaque type Ids = Vector[long]
opaque type Box[T] = Vector[T]

take[U: Sendable](value: U) -> U = value

main()
  val a = take(Scores(Array.fill(2, 0)))
  val b = take(Ids([long(1)]))
  val c = take(Box[Array[int]]([Array.fill(1, 0)]))
  val d = take(Box[int]([1]))
