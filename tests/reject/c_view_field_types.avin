// A field accessor marked `view` answers a `ByteView`, or with `writable` a `MutByteView`, perhaps in an
// `Option` for null; one answering a view says `view`; and a `shared` handle lends no view, since
// another thread may use it while the view is read.
// error: the field accessor `writableRead` answers `ByteView` and lends the memory its field points at: a `writable` binding lends a `MutByteView`
// error: the field accessor `readMutable` answers `MutByteView` and lends the memory its field points at: a `MutByteView` is lent by a binding marked `writable`
// error: the field accessor `asInt` answers `int` and lends the memory its field points at: the memory a binding lends is a `ByteView`, or with `writable` a `MutByteView`, perhaps in an `Option` for null
// error: the field accessor `unmarked` answers `ByteView`: a field accessor lends the memory its field points at when it says `view`, its length given with `length:`
// error: `Shared` is `shared`, so another thread may use it while a view it lent is read; a view is lent only by a handle that belongs to one thread at a time
import avin.c.{ByteView, MutByteView}

@c(type: "struct face *", release: "free")
class Face
    @c(field: "buffer", view, writable, length: "4")
    writableRead() -> ByteView

    @c(field: "buffer", view, length: "4")
    readMutable() -> MutByteView

    @c(field: "buffer", view, length: "4")
    asInt() -> int

    @c(field: "buffer")
    unmarked() -> ByteView

@c(type: "struct face *", release: "free", shared)
class Shared
    @c(field: "buffer", view, length: "4")
    bitmap() -> Option[ByteView]

main() = 0
