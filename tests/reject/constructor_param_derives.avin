// error: `Cell` cannot derive `Eq`: its parameter `F` is a constructor, and the derived impl would bound it by `Eq`, a bound for a type
// error: `Cell` cannot derive `Hash`: its parameter `F` is a constructor, and the derived impl would bound it by `Hash`, a bound for a type
// error: `Ordered` cannot derive `Ord`: its parameter `F` is a constructor, and the derived impl would bound it by `Ord`, a bound for a type
// A derived impl bounds each of the type's parameters by the trait, which no constructor parameter
// takes, so a type with one derives nothing through a template.
class Cell[F[_]](val x: F[int]) derives Eq, Hash
data Ordered[F[_], A](x: F[A]) derives Ord

main()
  println(0)
