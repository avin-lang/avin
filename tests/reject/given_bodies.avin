// A given is declared in a block, at a module's top level or in an object's body: a class, an
// actor, a trait and an impl declare none, a class and an actor taking their context as `using`
// parameters of their constructors. A module-level given is held to the types a given may have.
// error: a class or an actor declares no givens in its body: it takes its context as `using` parameters of its constructor
// error: a trait declares no givens
// error: an impl adds methods, so it declares no given; declare `tx` at the module's top level or in an object
// error: a given is of a class, object, trait or data type: `string` would be given wherever a `string` is asked for
// error: a given is of a class, object, trait or data type: `bool` would be given wherever a `bool` is asked for

data Tx(id: int)

class Service
  given tx = Tx(1)

trait Store
  given tx: Tx = Tx(2)

impl Tx
  given tx = Tx(3)

given name = "app"

object Flags
  given verbose = true

main() = 0
