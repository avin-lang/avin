// error: `toLong` is not a member of `Integer`, the bound of `T`
// error: `toInt` is not a member of `Numeric`, the bound of `U`
// error: byte has no field `toInt`
// error: char has no field `toLong`
// `toInt` and `toLong` are members of each number type, not of `Integer` or `Numeric`: generic code
// converts an `Integer` parameter by a call, `long(x)`. A byte and a char are no numbers and convert
// by a call too, `int(b)`.

widen[T: Integer](x: T) -> long = x.toLong
narrow[U: Numeric](x: U) -> int = x.toInt

main()
  println(widen(1))
  println(narrow(2))
  println(byte(3).toInt)
  println('a'.toLong)
