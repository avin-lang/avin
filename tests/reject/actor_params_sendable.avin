// error: `Buffer[int]` does not conform to `Sendable`, so the actor `Hoard` cannot take it as its parameter `b`: it is mutable; an immutable copy (`toVector`) is sendable
// error: `(int) -> int` does not conform to `Sendable`, so the actor `Hoard` cannot take it as its parameter `f`: it is a function value, whose type does not say what it captures
// error: `Tally` does not conform to `Sendable`, so the actor `Hoard` cannot take it as its parameter `t`: its field `n` is a `var`; make it a `val`
// error: `T` does not conform to `Sendable`, so the actor `Unbound` cannot take it as its parameter `v`: it is a type parameter that may stand for any type; bound it, as in `[T: Sendable]`
// error: `Any` does not conform to `Sendable`, so the actor `Anything` cannot take it as its parameter `x`: it may hold a value of any type
// An actor's parameters are carried to it by its behaviour, so each one's type is held to `Sendable`
// where the actor is declared, once, and named in the error: a buffer, a plain function value, a
// class with a `var`, an unbounded type parameter and `Any`. The sendable ones beside them, an int,
// a `@sendable` function, a type parameter bounded by `Sendable` and a parameter the program marks
// `@sendable` itself, are accepted, and a call passing a value read from a `var` is not refused.
class Tally()
    var n = 0

trait Shape
    area() -> int

actor Hoard(b: Buffer[int], f: (int) -> int, t: Tally, ok: int, g: @sendable (int) -> int) receives int
    receive
        n -> ()

actor Unbound[T](v: T) receives int
    receive
        _ -> ()

actor Bounded[T: Sendable](v: T) receives int
    receive
        _ -> ()

actor Anything(x: Any) receives int
    receive
        _ -> ()

actor Marked(@sendable s: Shape) receives int
    receive
        _ -> ()

main()
    var n = 3
    n += 1
    val b = Bounded(n)
