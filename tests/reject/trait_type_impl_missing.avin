// error: `impl[K, A] Show for Map[K, A]` overlaps `impl[A] Show for Map[string, A]`: both hold for `Map[string, A]`, and a type conforms to a trait through one impl; the other is at
// error: `TreeMap[string, int]` does not conform to `Show`, the bound of `T` in `shown`
// error: `Plain` does not conform to `Show`, the bound of `T` in `shown`
// error: `Vector[int]` does not conform to `Show`, the bound of `T` in `shown`
// error: `Seq[Plain]` does not conform to `Show`, the bound of `T` in `shown`
// Two impls of a trait for one trait type overlap as two for any type do. A type implementing the
// trait type has no impl through it, and the error names that type; neither has a trait type whose
// arguments miss the impl's bounds.
trait Show
  show() -> string

class Plain(n: int)

impl[A] Show for Map[string, A]
  show() -> string = "string map"

impl[K, A] Show for Map[K, A]
  show() -> string = "map"

impl[A: Show] Show for Seq[A]
  show() -> string = "seq"

shown[T: Show](x: T) -> string = x.show()

main()
  val t: TreeMap[string, int] = TreeMap(("a", 1))
  println(shown(t))
  println(shown(Plain(1)))
  println(shown([1, 2]))
  val rows: Seq[Plain] = [Plain(1)]
  println(shown(rows))
