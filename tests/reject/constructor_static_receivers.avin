// error: `pure` is a static member of `Pointed`, which `G[int, _]` does not implement; a constructor parameter conforms to its bounds only with all its arguments open
// error: `Pointed` is a trait, which has no static members of its own: call one on a constructor implementing it, as in `F.pure(…)` with `F[_]: Pointed`
// error: `Box` is a constructor, and `make` is a static member of the type, not of a constructor trait it implements; give it its type arguments, as in `Box[A].make(…)`
// error: `Twice` is no constructor: it stands for `Result[T, T]`, and an alias is a constructor only where each of its parameters is one argument of the type it names, once
// error: `Box` has no static member `missing`: no constructor trait it implements declares one
// What a static member's receiver may not be: a constructor trait itself, a partial application of
// a constructor parameter, which conforms only with all its arguments open; a type named bare whose
// static member is its own and not a constructor trait's; an alias that is no constructor; and a
// constructor no trait it implements gives the member.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

trait Pointed[A]: Mappable[A]
  static pure[X](value: X) -> Self[X]

trait Mappable2[A, B]
  bimap[C, D](f: (A) -> C, g: (B) -> D) -> Self[C, D]

trait Make
  static make() -> Self

data Box[T](value: T)

impl Pointed for Box
  static pure[X](value: X) -> Box[X] = Box(value)
  map[B](f: (T) -> B) -> Box[B] = Box(f(value))

impl[T] Make for Box[T]
  static make() -> Box[T] = todo()

type Twice[T] = Result[T, T]

partial[G[_, _]: Mappable2](n: int) -> int
  val g = G[int, _].pure(n)
  0

main()
  val a = Pointed.pure(1)
  val c = Box.make()
  val d = Twice.pure(1)
  val e = Box.missing(1)
  println(Box[_].pure(1).value)
