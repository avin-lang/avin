// error: `whenMissing` is already a method of `int` with the same parameter types; a method's overloads differ in their parameter types
// errors: exactly
// A format's decoder trait that declares its own `whenMissing` beside the core's `Missable` gives a
// type two methods of one name and parameter types, which the language refuses: a type has one, and
// it serves every trait declaring it. Requiring `Missable` instead, as every format's decoder does, is
// what lets two formats be imported together.

trait OldDecoder
  static decode(text: string) -> Self
  static whenMissing() -> Option[Self]

impl OldDecoder for int
  static decode(text: string) -> int = text.toInt()
  static whenMissing() -> Option[int] = None

main() = ()
