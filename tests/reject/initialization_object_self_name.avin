// error: `y` is read before its declaration in the class body initializes it
// error: `self` is passed, stored or returned before `y` is initialized
// error: `m` is called before `y` is initialized
// error: `k` is read in a superclass's arguments, which run before the object is initialized
// error: a lambda that captures `self` is made in a superclass's arguments, which run before the object is initialized
// In an object's own body its name is `self`, so before the last field it obeys the rules `self`
// does, and in the arguments the object passes to its superclass it may not be used at all.
show(x: Any) -> unit = println("shown")

open class Holder(val got: int)

open class Lazy(f: () -> int)
  val got: int = f()

object Above
  val x: int = Above.y
  val y: int = 2

object Passed
  show(Passed)
  val y: int = 2

object Called
  val z: int = Called.m()
  val y: int = 2
  m() -> int = y

object Argument: Holder(Argument.k)
  val k: int = 3

object Captured: Lazy(() -> Captured.k)
  val k: int = 3

main() = ()
