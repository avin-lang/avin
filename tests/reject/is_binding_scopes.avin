// A name bound by `is` is in scope only where its test is known to hold: not in the `else`, not
// after an `if` whose branches both finish, not across `||`, and once per block.

inElse(o: Option[int]) -> int
    if o is Some(v) then v else v

afterIf(o: Option[int]) -> int
    if o is Some(w) then println("some")
    w

acrossOr(a: Option[int], b: bool) -> bool
    a is Some(x) || x > 0

afterOr(a: Option[int], b: Option[int]) -> int
    if a is Some(y) || b is Some(y) then y else 0

twice(o: Option[int]) -> int
    val n = 1
    if o is not Some(n) then return 0
    n

