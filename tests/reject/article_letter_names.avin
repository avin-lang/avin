// error: `fa` is an `H[int]`, which is neither an `Iterable` nor a `Monad`, and a generator followed by another draws only from those: add `Monad` to the bounds of `H`
// error: `fa` is an `M[int]`, which is neither an `Iterable` nor a `Monad`, and a generator followed by another draws only from those: add `Monad` to the bounds of `M`
// error: `fa` is an `S[int]`, which is neither an `Iterable` nor a `Monad`, and a generator followed by another draws only from those: add `Monad` to the bounds of `S`
// error: `fa` is a `U[int]`, which is neither an `Iterable` nor a `Monad`, and a generator followed by another draws only from those: add `Monad` to the bounds of `U`
// error: `fa` is a `Fx[int]`, which is neither an `Iterable` nor a `Monad`, and a generator followed by another draws only from those: add `Monad` to the bounds of `Fx`
// A constructor parameter named by a letter is read as the letter, so the article is the letter
// name's: `an H`, `an M`, `an S`, `a U`. A longer name is read as a word: `a Fx`.

hName[H[_]: Functor](fa: H[int]) -> H[int] = for a in fa, b in fa yield a + b

mName[M[_]: Functor](fa: M[int]) -> M[int] = for a in fa, b in fa yield a + b

sName[S[_]: Functor](fa: S[int]) -> S[int] = for a in fa, b in fa yield a + b

uName[U[_]: Functor](fa: U[int]) -> U[int] = for a in fa, b in fa yield a + b

wordName[Fx[_]: Functor](fa: Fx[int]) -> Fx[int] = for a in fa, b in fa yield a + b

main() -> int = 0
