data Pair[A, B](first: A, second: B)

class Box[T](val value: T)
  map[U](f: (T) -> U) -> Box[U] = Box(f(value))
  flatMap[U](f: (T) -> Box[U]) -> Box[U] = f(value)
  withFilter(p: (T) -> bool) -> Box[T] = self

main()
