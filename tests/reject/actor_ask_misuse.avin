// error: `ask` takes 2 arguments, not 1
// error: `Array[int]` does not conform to `Sendable`, the bound of `R` in `ask`: it is mutable; an immutable copy (`toVector`) is sendable
// error: cannot infer the type of `r`; write it, as in `(r: int) -> …`
// error: cannot infer the type of `r`; write it, as in `(r: int) -> …`
// error: this lambda yields int, not Msg
// An ask always has a timeout; what it carries back is sendable; its reply type comes from the
// message the lambda builds around the reply reference, so a message that does not use it leaves the
// type open; and the lambda builds a message of the actor's own type.
import avin.actors.{ActorRef, spawn}
import avin.time

data Msg
    Get(reply: ActorRef[int])
    Quiet

actor Counter receives Msg
    receive
        Get(reply) -> reply.tell(0)
        Quiet -> ()

main()
    val c = spawn(Counter())
    val a = c.ask(r -> Get(r))
    val b = c.ask[Array[int]](r -> Quiet, time.seconds(1))
    val d = c.ask(r -> Quiet, time.seconds(1))
    val e = c.ask(r -> 5, time.seconds(1))
