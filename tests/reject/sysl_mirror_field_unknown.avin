// A Sysl mirror's lowerCamelCase field with no Sysl field of the same words in snake_case is
// reported at the mirror, naming the Sysl field it looked for.
// error: the Sysl mirror `Civil` does not match `sysl.time.YearMonthDay`
// error: day_of_month

@sysl("sysl.time.YearMonthDay")
data Civil
    Civil(year: int, month: int, dayOfMonth: int)

@sysl("sysl.hint.black_box")
same(c: Civil) -> Civil

main()
    println(s"${same(Civil(1970, 1, 1))}")
