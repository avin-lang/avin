// error: expected `]`
// error: `x` has no argument: an infix call takes one, and there is no postfix form; a member is reached with a dot, as `f[int.x`, or `f[int.x()` for a method declared with an empty parameter list
// A type application missing its `]` ends at its last type argument, so the name after it is reported
// as the infix call it starts, rather than the report reading a span that runs backwards.
f(xs: Vector[int]) -> int = xs.length()

main()
    val a = f[int x]
