// error: `@tailrec` method `walk` can be overridden, so a call of it may run another body; make it private, or its class final
// error: `@tailrec` method `step` can be overridden, so a call of it may run another body; make it private, or its class final
// error: `@tailrec` function `plain` has no recursive call
// error: `@tailrec` takes no arguments
// error: this recursive call of `other` gives it other type arguments, so it is a call of another instance rather than a loop
// `@tailrec` holds only of a function whose every recursive call can be a loop: not of a method a
// subclass or a conforming type may replace, nor of a function that never calls itself, nor of a
// call of another instance of a generic function.

open class Walker
    @tailrec
    walk(n: int) -> int = if n == 0 then 0 else walk(n - 1)

    // A private method of an open class is never overridden.
    @tailrec
    private hidden(n: int) -> int = if n == 0 then 0 else hidden(n - 1)

trait Stepper
    @tailrec
    step(n: int) -> int = if n == 0 then 0 else step(n - 1)

@tailrec
plain(n: int) -> int = n + 1

@tailrec(always)
argued(n: int) -> int = if n == 0 then 0 else argued(n - 1)

@tailrec
other[T](x: T, n: int) -> int = if n == 0 then 0 else other("text", n - 1)

main() -> int = 0
