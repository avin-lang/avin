// A binding's parameter may take a function whose parameters cross out of Sysl and whose result
// crosses into it. A type that crosses neither way, a function inside a callback, and a handle held
// in a callback's result are refused at the binding's parameter, as a function as a binding's
// result is.
// error: `List[int]` cannot be a callback's parameter, which Sysl gives it; a binding's parameters and result are integers of 8, 16, 32 or 64 bits, `byte`, `real`, `char`, `bool`, `unit`, `string`, data types declared with `@sysl` to mirror a Sysl enum or struct, and `Array`, `Vector`, `Option`, `Result` and tuples of these
// error: `List[string]` cannot be a callback's result, which goes into Sysl; a binding's parameters and result are integers of 8, 16, 32 or 64 bits, `byte`, `real`, `char`, `bool`, `unit`, `string`, data types declared with `@sysl` to mirror a Sysl enum or struct, and `Array`, `Vector`, `Option`, `Result` and tuples of these
// error: `(int) -> int` cannot be a callback's parameter: a function crosses to Sysl only as a binding's own parameter
// error: `Option[Box]` cannot be a callback's result: a Sysl handle goes back into Sysl only by itself
// error: `(int) -> int` cannot cross to Sysl; a binding's parameters and result are integers of 8, 16, 32 or 64 bits, `byte`, `real`, `char`, `bool`, `unit`, `string`, data types declared with `@sysl` to mirror a Sysl enum or struct, and `Array`, `Vector`, `Option`, `Result` and tuples of these

@sysl("sysl.checksum.Crc32")
class Box
    finish() -> long

@sysl("avintest.callbacks.apply")
listed(f: (List[int]) -> int)

@sysl("avintest.callbacks.apply")
listing(f: (int) -> List[string])

@sysl("avintest.callbacks.apply")
nested(f: ((int) -> int) -> int)

@sysl("avintest.callbacks.apply")
boxed(f: (int) -> Option[Box])

@sysl("avintest.callbacks.apply")
answered() -> (int) -> int

main() = ()
