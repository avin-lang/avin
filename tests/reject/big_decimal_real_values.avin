// error: expected BigDecimal, found real
// error: `==` cannot compare real with BigDecimal
// error: `-` needs two values of one type, not BigDecimal and real
// error: a decimal literal does not match a BigDecimal as a pattern
// A `real` value is no `BigDecimal` where one is expected, nor beside one under `==` or `-`, and a
// negated decimal literal is no pattern for one either.
take(x: BigDecimal) -> BigDecimal = x

main()
  val r = 0.1
  val d: BigDecimal = r
  println(r == take(1))
  println(d - r)
  d match
    -0.5 -> println("minus a half")
    _ -> println("other")
