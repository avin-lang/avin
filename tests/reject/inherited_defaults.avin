// error: `Base.count` implements `Counter.count` for `Ticker`, and their defaults differ; a method can take the defaults of only one
// error: `Plain.count` implements `Counter.count` for `Bare`, which has defaults `Plain.count` lacks; override `count` to take them
// error: `Tally.count` implements `Counter.count` for `Clicker`, and their defaults differ; a method can take the defaults of only one
// error: `Both.count` overrides methods with different defaults, `Counter.count` among them; it can take the defaults of only one
// error: `count` takes 1 argument, not 0
trait Counter
  count(step: int = 2) -> int

// An inherited method keeps its own defaults, so it cannot also implement a trait's method that
// declares others: a call would omit different arguments through each type.
open class Base()
  count(step: int = 1) -> int = step

class Ticker(): Base(), Counter

open class Plain()
  count(step: int) -> int = step

class Bare(): Plain(), Counter

// A trait's default body implementing another trait's method is inherited the same way.
trait Tally
  count(step: int = 3) -> int = step

class Clicker(): Tally, Counter

// An override takes the defaults of every method it overrides, which must be the same.
class Both(): Base(), Counter
  override count(step: int) -> int = step

// A trait's method without defaults cannot omit an argument, whatever the method it runs has.
trait Steps
  count(step: int) -> int

class Walker(): Base(), Steps

main()
  val s: Steps = Walker()
  println(s"${s.count()}")
