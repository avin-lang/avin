// error: expected Named, found real
// error: expected Display, found (int, Cell)
// error: expected Named, found (int, int)
// A built-in value or a tuple is a trait's value only where it implements the trait.
trait Named
  name() -> string

impl Named for int
  name() -> string = "int"

class Cell(n: int)

main()
  val a: Named = 2.5
  val b: Display = (1, Cell(2))
  val c: Named = (1, 2)
