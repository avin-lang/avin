// error: a `Future` is discarded here; `await` it, or write `_ = …` to drop it on purpose
// error: discarded_future.avin:15:3
// error: discarded_future.avin:16:3
// error: discarded_future.avin:17:3
// error: discarded_future.avin:18:23
// A `Future` dropped by a statement is an error as a `Result` is, at any type argument: one made by
// `Future`, one a `map` makes from another, one answering a `Result`, and one dropped in each turn
// of a `for` loop. Awaiting it, or keeping it, is no discard.
import avin.threads.Future

ask(n: int) -> Future[Result[int, string]] = Future(if n > 0 then Ok(n) else Err("no"))

main()
  val kept = Future(1)
  Future(2)
  kept.map(x -> x + 1)
  ask(3)
  for i in 0 ..< 2 do Future(i)
  println(kept.await())
  println(ask(4).await())
