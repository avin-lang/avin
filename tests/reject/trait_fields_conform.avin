// error: `Positional` holds state, the field `pos` of `Positional`, which only a class or an object stores; Point cannot conform to it
// error: `Tracked` holds state, the field `pos` of `Positional`, which only a class or an object stores; int cannot conform to it
// error: `Positional` holds state, the field `pos` of `Positional`, which only a class or an object stores; Wrapper[T] cannot conform to it
// error: `pos` is a field of `Positional`, which `Clash` stores; a class does not declare a field of a trait's name
// error: `Both` conforms to `Positional` and `Other`, which both declare the field `pos`; one class cannot store both
trait Positional
  var pos: int = 0

trait Tracked: Positional
  describe() -> string = "tracked"

data Point(x: int)
impl Positional for Point

impl Tracked for int

data Wrapper[T](value: T)
impl[T] Positional for Wrapper[T]

class Clash(val pos: int): Positional

trait Other
  var pos: int = 1

class Both: Positional, Other

main() = ()
