// A method declared with an empty parameter list, named bare where a value is expected, is reported
// with the call that fixes it, written on the receiver the program used: a local at the head of a
// chain, a local a lambda captures, a placeholder (whose `_` no lambda of its own could hold, so only
// the call is named), a parameter whose type is a type parameter, and `self`.
// error: `iterator` is called with `()`: write `xs.iterator()`, or `() -> xs.iterator()` for a function value
// error: `bump` is called with `()`: write `c.bump()`, or `() -> c.bump()` for a function value
// error: `toInt` is called with `()`: write `_.toInt()`
// error: `iterator` is called with `()`: write `t.iterator()`, or `() -> t.iterator()` for a function value
// error: `total` is called with `()`: write `self.total()`, or `() -> self.total()` for a function value
// error: empty_list_call_fix.avin:23:13
// error: empty_list_call_fix.avin:26:28
// error:    |                            ^^^^^^^

class Counter(var n: int)
    bump() -> bool
        n = n + 1
        n > 2
    total() -> int = n
    thrice() -> int = self.total * 3

firstOf[T: Iterable[int]](t: T) -> int = t.iterator.next()

main()
    val xs = [1, 2, 3]
    println(xs.iterator.next())
    val c = Counter(0)
    println(xs.filter(_ -> c.bump))
    println(["1", "2"].map(_.toInt).sum)
    println(firstOf(xs))
