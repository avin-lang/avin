// error: `x` is already bound in this `for`, by the generator before it or a definition after that generator; a value definition binds a new name
// error: `y` is already bound in this `for`, by the generator before it or a definition after that generator; a value definition binds a new name
// error: `a` is already bound in this `for`, by the generator before it or a definition after that generator; a value definition binds a new name
// error: a `for` starts with a generator, `pattern in source`; a value definition follows one
// error: a value definition between generators needs `yield`; a `for` without it binds the value in its body
// A value definition binds in its generator's scope, as a `val` in a block does, so it cannot rebind
// a name the generator or an earlier definition after it binds, nor one of its own pattern's twice;
// a comprehension starts with a generator; and a `for` without `yield` takes no definitions.

main()
    val xs: List[int] = [1, 2, 3]
    val a = for x in xs, x = x + 1 yield x
    val b = for x in xs, y = x if y > 0, y = 2 yield y
    val c = for x in xs, (a, a) = (x, x) yield a
    val d = for y = 1, x in xs yield x + y
    for x in xs, y = x * 2 do println(y)
