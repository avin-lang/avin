// error: a lower bound is written on a function's or a method's own type parameter, not on `A`
// error: the lower bound of `B` leads back to `B`
// error: `keep` overrides `Base.keep`, whose type parameter `W` has the lower bound T, not string
// error: `plain` overrides `Base.plain`, whose type parameter `W` has no lower bound
// error: `Any` is not a supertype of `long`, the lower bound of `W` in `prepended`
// An impl's parameters are its type's and take no lower bound; lower bounds may not form a cycle; an
// override may not assume more of its type arguments than the method it overrides; and a value of a
// value type is no `Any` without a conversion, which a lower bound never makes.
data Chain[+A]
    Link(head: A, tail: Chain[A])
    End

impl[A >: int] Chain[A]
    first() -> int = 1

impl[A] Chain[A]
    prepended[W >: A](x: W) -> Chain[W] = Link(x, self)

cycle[A >: B, B >: A](a: A, b: B) = ()

open class Base[+T](val item: T)
    keep[W >: T](x: W) -> W = x
    plain[W](x: W) -> W = x

class Derived[+T](item: T) : Base[T](item)
    override keep[W >: string](x: W) -> W = x
    override plain[W >: T](x: W) -> W = x

main()
    val longs: Chain[long] = Link(5, End)
    val boxed = longs.prepended[Any](3)
