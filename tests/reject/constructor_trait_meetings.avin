// error: `Wide.map` does not implement `Mappable.map` for `Wide`, which yields Wide[Any], and Wide[B] is wanted, which it is not without a conversion
// error: `Picky.map` does not implement `Mappable.map` for `Picky`, whose type parameter `B` is bounded by Ord, which `Mappable.map` does not promise
// error: `Loose.map` does not implement `Mappable.map` for `Loose`, whose type parameter `C` a call of `Mappable.map` does not decide
// error: `Extra.map` does not implement `Mappable.map` for `Extra`, which takes 2 parameters, and `Mappable.map` 1 parameter
// error: two overloads of `flatMap` both meet `Listing.flatMap` for `Both`, so a call through the trait would have two methods to call; exactly one of the name meets it
// The type's method meeting a trait's takes its parameter types and yields its result with no
// conversion, has every type parameter of its own decided by the call, adds no bound, takes as many
// parameters, and is the only overload of its name that meets it.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

trait Listing[A]
  flatMap[B](f: (A) -> List[B]) -> Self[B]

data Wide[T](value: T)

impl Mappable for Wide
  map[B](f: (T) -> B) -> Wide[Any] = Wide(f(value))

data Picky[T](value: T)

impl Mappable for Picky
  map[B: Ord](f: (T) -> B) -> Picky[B] = Picky(f(value))

data Loose[T](value: T)

impl Mappable for Loose
  map[B, C](f: (T) -> B) -> Loose[B] = Loose(f(value))

data Extra[T](value: T)

impl Mappable for Extra
  map[B](f: (T) -> B, times: int) -> Extra[B] = Extra(f(value))

data Both[T](value: T)

impl[T] Both[T]
  flatMap[U](f: (T) -> Seq[U]) -> Both[U] = todo()
  flatMap[U](f: (T) -> Iterable[U]) -> Both[U] = todo()

impl Listing for Both

main()
  println(1)
