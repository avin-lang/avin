// An opaque value is made only by a C binding that answers one, and crosses by value alone: never in
// an `Option`, never `inout` or `out`, and only as the C type it is a copy of.
// error: `Event` is a copy of the C value `as_event`, so only a C binding that answers one makes it
// error: parameter 1 of the C binding `optional` is `Option[Event]` in Avin and `as_event` in C: an opaque value is passed by value, which is never null, so it is not in an `Option`
// error: parameter 1 of the C binding `updated` is `Event` in Avin and `as_event *` in C, `inout`: an opaque value is passed by value, and never `inout`
// error: out value 1 of the C binding `updated`, `e`, is `Event` in Avin and `as_event` in C: an opaque value is passed and answered by value, and never through a pointer
// error: parameter 1 of the C binding `other` is `Event` in Avin and `as_flags` in C: `Event` is a copy of `as_event`, so it is passed by value, as `as_event`

@c(value: "as_event")
class Event

@c("int as_optional(as_event e)")
optional(e: Option[Event]) -> int

@c("void as_update(inout as_event *e)")
updated(e: Event) -> Event

@c("int as_flags_bits(as_flags e)")
other(e: Event) -> int

main()
  val e = Event()
