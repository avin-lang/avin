same(a: int, b: int) -> int
same(x, x) = 1
same(_, _) = 0

apart(n: int) -> int
apart(m + 1) = 1
apart(_) = m

typed(n: int) -> int
typed("zero") = 0
typed(_) = 1

wide(n: int) -> int
wide(0) = 0
wide(_) = false

main() -> int = 0
