// error: the contravariant type parameter `-T` appears in a covariant position, the field `value` of `Some`
// error: the covariant type parameter `+T` appears in a contravariant position, the field `reader` of `Box`
// error: the covariant type parameter `+T` appears in an invariant position, the trait Store[T]
// error: the covariant type parameter `+T` appears in an invariant position, the superclass Holder[T]
// error: the covariant type parameter `+T` appears in a contravariant position, the parameter `f` of `each`

// A data type's fields are read out, so a `-T` cannot be one.
data Option[-T]
    Some(value: T)
    None

trait Store[T]
    keep(x: T) -> int

// A function type's parameters flip the position: a function taking a `T`, handed out, takes one in.
// An impl's trait is a parent, so its arguments follow the trait's variance.
data Box[+T](item: T, reader: (T) -> int)

impl[T] Store[T] for Box[T]
    keep(x: T) -> int = 0

open class Holder[T](var item: T)

class View[+T](item: T) : Holder[T](item)

// A parameter's own parameters flip the position again: the `T` of `(T) -> int` as a parameter is in
// a covariant position, and that of `((T) -> int) -> int` in a contravariant one.
class Walker[+T]()
    visit(f: (T) -> int) -> int = 0
    each(f: ((T) -> int) -> int) -> int = 0

main() = ()
