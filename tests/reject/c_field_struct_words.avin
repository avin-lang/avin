// A field accessor answers or writes a struct mirror itself, never one in an `Option`, since a field
// is never null; and it never writes a mirror holding a string, in a field of its own or of a mirror
// it holds, since C would be left holding memory no one gives back.
// error: the field accessor `maybeBox` answers `Option[Box]`, and a field is read as an integer type, `byte`, `bool`, `real`, an enum mirror, a struct mirror, a string or a handle
// error: the field accessor `setMaybeBox` writes `Option[Box]`, and a field is written as an integer type, `byte`, `bool`, `real`, an enum mirror or a struct mirror; a string or handle field is only read
// error: the field accessor `setLabelled` writes `Labelled`, which holds a string: a string stored into a struct would leave C holding memory no one gives back, so a field holding one is only read
// error: the field accessor `setTagged` writes `Tagged`, which holds a string: a string stored into a struct would leave C holding memory no one gives back, so a field holding one is only read
// error: the field accessor `setOuter` writes `Outer`, which holds a string: a string stored into a struct would leave C holding memory no one gives back, so a field holding one is only read

@c(struct: "struct box")
data Box(x: int, y: int)

@c(struct: "struct labelled")
data Labelled(label: string, id: int)

@c(struct: "struct tagged")
data Tagged(tag: Option[string], id: int)

@c(struct: "struct outer")
data Outer(box: Box, inner: Labelled)

@c(type: "struct thing *", release: "free")
class Thing
  @c(field: "box")
  maybeBox() -> Option[Box]
  @c(field: "box")
  setMaybeBox(b: Option[Box])
  @c(field: "labelled")
  setLabelled(l: Labelled)
  @c(field: "tagged")
  setTagged(t: Tagged)
  @c(field: "outer")
  setOuter(o: Outer)
  // Read, each is a copy, and a box is written: none of these is refused.
  @c(field: "box")
  box() -> Box
  @c(field: "box")
  setBox(b: Box)
  @c(field: "labelled")
  labelled() -> Labelled
  @c(field: "outer")
  outer() -> Outer

main() = 0
