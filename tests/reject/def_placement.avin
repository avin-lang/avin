// `def` is written once, after the modifiers, and before a function or a method only: a value is
// declared with `val`, `var` or `lazy val` alone.
// error: `def` declares a function or a method, and a value is declared with `val` alone: remove `def`
// error: `def` is written once before a declaration
// error: `def` comes after the modifiers, as in `private def g`
// error: `def` declares a function or a method, and a value is declared with `var` alone: remove `def`
// error: `def` comes after the modifiers, as in `override def h`

def val x = 1
def def f() -> int = 1
def private g() -> int = 1

open class K
    def var y = 2
    h() -> int = 1

class L: K
    def override h() -> int = 2

main() =
    println(x)
