// error: unknown annotation `@trapsAtCaller`
// error: the covariant type parameter `+T` appears in a contravariant position, the parameter `x` of `with`

// The methods an impl adds to a class are variance positions when the class has a mutable field.
// No annotation moves where a program's own function traps: only the core library's traps report
// their caller.

@trapsAtCaller
check(n: int) = if n < 0 then ()

class Cell[+T](private val item: T)
  private var uses = 0

impl[T] Cell[T]
  with(x: T) -> Cell[T] = Cell(x)

main()
  check(1)
