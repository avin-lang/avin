// error: and Bag is none of them; to loop over it, Bag must implement `Iterable` (`impl Iterable[…] for Bag`)
// error: and Cells is none of them; to loop over it, Cells must implement `Iterable`
// error: and Option[int] is none of them; an option is not an Iterable, and `toList` makes one of its value
// error: and T is none of them
// error: and Wrapper[string] is none of them
// Conformance to `Iterable` is by name: a class, a data type or a generic class with an
// `iterator()` method of the right shape is not a `for` source until it conforms, and neither is an
// option, which has `iterator()` but is not an `Iterable`, nor a type parameter bounded by a trait
// that declares `iterator()` without requiring `Iterable`.
class Bag
  iterator() -> Iterator[int] = Vector(1, 2).iterator()
  foreach(f: (int) -> unit) -> unit = f(1)
  map(f: (int) -> int) -> Vector[int] = Vector(f(1))
  flatMap(f: (int) -> Vector[int]) -> Vector[int] = f(1)
  withFilter(p: (int) -> bool) -> Bag = self

data Cells(a: int, b: int)

impl Cells
  iterator() -> Iterator[int] = [a, b].iterator()

class Wrapper[T](val x: T)
  iterator() -> Iterator[T] = [x].iterator()

trait Walks
  iterator() -> Iterator[int]

walk[T: Walks](t: T)
  for x in t do println(x)

main()
  for x in Bag() do println(x)
  for x in Cells(1, 2) do println(x)
  for x in Some(3) do println(x)
  for x in Wrapper("w") do println(x)
