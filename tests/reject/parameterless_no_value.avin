// A method declared with no parameter list has no function value: naming it calls it, so where a
// function is expected one writes a lambda. It is no field either, so it is not assigned, and its
// name cannot also name a field of its class. A field implements only an abstract one; `super.name`
// with no call reads only such a method.
// error: `head` takes no parameter list, so it has no function value: naming it calls it; for a function, write a lambda, as in `() -> x.head`
// error: `head` is a method of `D`, which cannot be assigned
// error: `v` is already a field of `E`
// error: `t` is already a method of `T`
// error: `super` calls a superclass's method, as in `super.bump()`

class D(x: int)
    head -> int = x

class E
    val v = 1
    v -> int = 2

trait T
    t -> int = 1

class F : T
    val t = 2

open class G
    bump() -> int = 1

class H : G
    twice() -> int = super.bump * 2

main() =
    val f: () -> int = D(1).head
    D(1).head = 4
