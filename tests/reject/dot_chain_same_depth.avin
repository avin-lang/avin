// error: a line starting with `.` continues the expression above only when it is indented deeper than the line that expression began on
// A `.` line continues only an expression that began on a shallower line: at the depth the
// expression began on, it starts a new statement, and a statement cannot start with `.`.

main() -> int
    val xs = [3, 1, 2]
    .map(_ * 2)
    xs.length
