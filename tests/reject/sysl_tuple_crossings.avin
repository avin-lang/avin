// A tuple crosses where each of its parts does: a handle part only out of Sysl, as a binding's result
// or the value of its `Option` or `Result`, never in a collection or into Sysl; and a mirror holding
// itself through a tuple's part is a mirror holding itself.
// error: `(Crc32, int)` cannot cross to Sysl: a Sysl handle goes back into Sysl only as the receiver of its own methods
// error: `Vector[(string, Crc32)]` cannot cross out of Sysl: a Sysl handle is a binding's result, the value of its `Option` or `Result`, or a part of a tuple that is one of these
// error: `Option[(int, Crc32)]` cannot cross to Sysl: a Sysl handle goes back into Sysl only as the receiver of its own methods
// error: `(int, (string, i24))` cannot cross to Sysl
// error: a Sysl mirror cannot hold itself: `Option[(int, Looped)]` holds `Looped`

@sysl("sysl.checksum.Crc32")
class Crc32
    finish() -> long

@sysl("sysl.hint.black_box")
keepPair(p: (Crc32, int)) -> long

@sysl("sysl.hint.black_box")
pairs(n: long) -> Vector[(string, Crc32)]

@sysl("sysl.hint.black_box")
maybePair(p: Option[(int, Crc32)]) -> long

@sysl("sysl.hint.black_box")
nested(n: long) -> (int, (string, i24))

@sysl("sysl.fs.Looped")
data Looped
    Looped(next: Option[(int, Looped)])

main() = ()
