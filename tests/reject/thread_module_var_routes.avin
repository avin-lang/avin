// error: what is passed for `body` of `spawn` may run on another thread, which shares the program's module-level state, but it reaches `total`, a module-level `var`, which every thread would share; share it through an `Atomic` or a `Mutex` held in a `val`
// error: what is passed for `body` of `spawn` may run on another thread, which shares the program's module-level state, but it reaches the object `Tally`, whose field `n` is a `var`; make it a `val`
// error: what is passed for `body` of `spawn` may run on another thread, which shares the program's module-level state, but through `Up.step` it reaches `total`, a module-level `var`, which every thread would share; share it through an `Atomic` or a `Mutex` held in a `val`
// error: what is passed for `body` of `spawn` may run on another thread, which shares the program's module-level state, but through `pick` it reaches `total`, a module-level `var`, which every thread would share; share it through an `Atomic` or a `Mutex` held in a `val`
// error: what is passed for `body` of `spawn` may run on another thread, which shares the program's module-level state, but through `down` it reaches `total`, a module-level `var`, which every thread would share; share it through an `Atomic` or a `Mutex` held in a `val`
// The less direct routes to a module-level `var`: a closure the body makes and calls, an object's
// method, a trait method through a value whose class is not known where the body is written, a
// generic function instantiated inside the body, and a function that reaches it only once its
// recursion ends.
import avin.threads.spawn

var total = 0

object Tally
  var n = 0
  tick() = n += 1

trait Step: Sendable
  step() -> int

class Up(): Step
  override step() = total

class Flat(): Step
  override step() = 0

pick[T](x: T) -> T
  total += 1
  x

down(n: int) -> int = if n == 0 then total else down(n - 1)

apply(f: () -> int) -> int = f()

main()
  val s: Step = Flat()
  spawn(() -> apply(() -> total)).join()
  spawn(() -> Tally.tick()).join()
  spawn(() -> s.step()).join()
  spawn(() -> pick(Some(1)).isEmpty).join()
  spawn(() -> down(3)).join()
  ()
