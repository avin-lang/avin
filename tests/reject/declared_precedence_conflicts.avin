// error: every method named `<|>` binds alike, but this one binds at the level of `==`, grouping to the left and the one at
// error: every method named `^^` binds alike, but this one binds at the level of `^`, grouping to the left and the one at
// error: every method named `|>` binds alike, but this one binds at the level of `&&`, grouping to the left and the one at
// error: every method named `:+` binds alike, but this one binds at the level of `*`, grouping to the left and the one at
// The methods of one name across a program bind alike: another type's method, an overload left
// undeclared, an impl and a trait's implementation each disagree here with the first declaration
// of its name, and a declaration that moves a name the library's own methods already have (`:+`)
// disagrees with them. A method left undeclared agrees where the declaration changes nothing.
class A(val n: int)
  @precedence("|")
  <|>(o: A) -> A = o
  @groupsRight
  ^^(o: A) -> A = o
  @precedence("+")
  +>(o: A) -> A = o
  @precedence("*")
  :+(o: A) -> A = o

class B(val n: int)
  <|>(o: B) -> B = o
  // `+` is what `+>`'s name gives, so a method of that name declaring nothing agrees.
  +>(o: B) -> B = o

impl A
  ^^(n: int) -> A = self

trait Pipe
  @precedence("||")
  |>(o: A) -> A

impl Pipe for B
  @precedence("&&")
  |>(o: A) -> A = o

main() = ()
