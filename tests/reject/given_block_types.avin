// A given in a block is of a class, object, trait or data type, closed: a built-in type, a tuple,
// a function type, a union or a type naming a type parameter would be given wherever any value of
// it is asked for.
// error: a given is of a class, object, trait or data type: `int` would be given wherever an `int` is asked for; give it a type of its own (`data Retries(count: int)`)
// error: a given is of a class, object, trait or data type: `(int, string)` would be given
// error: a given is of a class, object, trait or data type: `(int) -> int` would be given
// error: a given is of a class, object, trait or data type: `int | string` would be given
// error: `Box[T]` names the type parameter `T`, and a given's type is fixed where it is declared

data Box[T](value: T)

generic[T](x: T) -> int
  given box = Box(x)
  0

main()
  given retries = 3
  given pair = (1, "a")
  given inc: (int) -> int = n -> n + 1
  given either: int | string = 1
  println(generic(1))
