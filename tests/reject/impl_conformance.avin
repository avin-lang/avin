// error: `Rope` already conforms to `Sized`; a conformance is stated once
// error: `Pile.size` implements `Sized.size`, whose parameter `scale` is int, not string
// error: `height` is already a field of `Pile`
// error: an impl's body declares only methods
// error: `int` does not implement Measured's `doubled`; a built-in type takes no default bodies, so its impl implements every method of the trait
trait Sized
    size(scale: int) -> int

trait Measured
    measure() -> int
    doubled() -> int = measure() * 2

data Rope(length: int)

impl Sized for Rope
    size(scale: int) -> int = length * scale

impl Sized for Rope
    size(scale: int) -> int = length

data Pile(height: int)

impl Sized for Pile
    size(scale: string) -> int = height

impl Pile
    height() -> int = 1
    println("in the body")

impl Sized for int
    size(scale: int) -> int = scale

impl Measured for int
    measure() -> int = self

main() = ()
