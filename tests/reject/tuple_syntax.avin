// error: a multiple assignment has no `:=` form, since it is a statement and yields nothing
// error: a multiple assignment fills a whole line, so it cannot be the body of a one-line `if` or `while`; indent it on the next line
// The spelling of multiple assignment.

main() -> int
    var x = 0
    var y = 1
    x, y := y, x
    while y != 0 do x, y = y, x % y
    0
