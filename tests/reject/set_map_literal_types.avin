// error: the elements of a collection literal need a common type; int and string have none
// error: the values of a map literal need a common type; int and string have none
// error: cannot infer the element type of an empty collection literal; give it a type, as in `val s: Set[int] = {}`
// error: expected int, found string

// A set literal's elements and a map literal's keys and values each agree on one type, an empty
// literal needs one from its context, and the expected type holds every key and value to its own.

main()
    val mixed = {1, "two"}
    val values = {a: 1, b: "two"}
    val empty = {}
    val typed: Map[string, int] = {a: 1, b: "two"}
