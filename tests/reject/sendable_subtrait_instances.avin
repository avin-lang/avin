// error: `Tag` promises to be `Sendable`, so an impl of it for `Slot[int]` requires `Slot[int]` to be `Sendable` already, but its field `value` is a `var`; make it a `val`
// error: `Tag` promises to be `Sendable`, so an impl of it for `Buffer[int]` requires `Buffer[int]` to be `Sendable` already, but it is mutable; an immutable copy (`toVector`) is sendable
// error: `Tag` promises to be `Sendable`, so an impl of it for `Pair[Buffer[T]]` requires `Pair[Buffer[T]]` to be `Sendable` already, but its type argument `Buffer[T]` is mutable; an immutable copy (`toVector`) is sendable
// error: `Tag` promises to be `Sendable`, so an impl of it for `Vector[Slot[int]]` requires `Vector[Slot[int]]` to be `Sendable` already, but its type argument is `Slot[int]`, whose field `value` is a `var`; make it a `val`
// An impl of a trait that promises `Sendable` for one instance of a type does not make that instance
// `Sendable`, which holds of a type at every instance alike: the instance must be `Sendable` already,
// by its structure or the impl that makes its type so, at concrete and at generic arguments.
trait Tag: Sendable
  tag -> string

class Slot[A](var value: A)

impl Tag for Slot[int]
  tag -> string = "slot"

impl Tag for Buffer[int]
  tag -> string = "buffer"

data Pair[A](first: A, second: A)

impl[A: Sendable] Sendable for Pair[A]

impl[T] Tag for Pair[Buffer[T]]
  tag -> string = "pair"

impl Tag for Vector[Slot[int]]
  tag -> string = "slots"

main()
  println("x")
