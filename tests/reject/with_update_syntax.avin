// error: `with` changes fields, and an element is not a field: replace the whole field, `xs = …`
// error: `with` changes fields, and an element is not a field: replace the whole field, `inner.xs = …`
// error: a change in `with` is written `field = value`, and `+=` is not `=`
// error: `with` changes at least one field: name it, as in `with { x = 1 }`
// error: expected `=` after the field's name

data Inner(xs: Vector[int])

data Outer(xs: Vector[int], inner: Inner, n: int)

main()
    val o = Outer([1], Inner([2]), 0)
    val a = o with { xs(0) = 1 }
    val b = o with { inner.xs(0) = 1, n = 2 }
    val c = o with { n += 1 }
    val d = o with { }
    val e = o with { n, xs = [] }
