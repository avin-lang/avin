// error: the covariant type parameter `+T` appears in an invariant position, the trait MakeSized[T]
// error: the covariant type parameter `+A` appears in a contravariant position, the parameter `x` of `take`
// error: the covariant type parameter `+A` appears in an invariant position, the trait Make[A]
// The exemption is for a conformance to a trait whose members are ALL static, on a class or data
// type. A trait with an instance member keeps its arguments a position; a trait's own static member
// is a position of the trait's parameters, since a type conforming at one argument conforms at a
// wider one through the trait's variance; and a trait requiring a static trait keeps it one too.
trait Make[A]
  static make(x: A) -> Self

trait MakeSized[A]
  static make(x: A) -> Self
  size() -> int

abstract class Box[+T]
  item -> T

class Full[+T](val value: T): Box[T]
  override item -> T = value

impl[T] MakeSized[T] for Box[T]
  static make(x: T) -> Box[T] = Full(x)
  size() -> int = 1

trait Take[+A]
  static take(x: A) -> Self

trait Coll[+A]: Make[A]
  head -> A

main()
  ()
