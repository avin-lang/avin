// error: `<` needs Item to implement `Ord`
// error: `+` needs Size to implement `Add`
// error: `+` on `T` needs a bound that is `Add` or requires it, as in `[T: Add]`
// error: `-` needs Size to implement `Neg`
// error: `<` on `U` needs a bound that is `Ord` or requires it, as in `[U: Ord]`
// An operator on a data type, a class or a type parameter needs the core trait that supplies it.
class Item(n: int)

data Size(n: int)

impl Sub for Size
    subtract(other: Size) -> Size = Size(n - other.n)

double[T: Ord](x: T) -> T = x + x

less[U: Eq](a: U, b: U) -> bool = a < b

main()
    if Item(1) < Item(2) then println("no")
    val s = Size(1) + Size(2)
    val t = -(Size(3) - Size(1))
