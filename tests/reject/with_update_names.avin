data Point(x: int, y: int)

data Sprite(pos: Point, name: string)

data Rect(w: int, h: int)

impl Rect
    area() -> int = w * h
    corner() -> Point = Point(w, h)

main()
    val s = Sprite(Point(1, 2), "s")
    val a = s with { nmae = "t" }
    val b = s with { colour = "red" }
    val c = s with { pos.yy = 1 }
    val r = Rect(1, 2)
    val d = r with { area = 4 }
    val e = r with { corner.x = 4 }
