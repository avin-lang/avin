// A function crosses to C only for a parameter of function-pointer type, and that parameter takes
// only a function: one taking what C calls it with but for the `userdata`, by position, each crossing
// as a binding's result does, and answering what C's function answers.
// error: parameter 1 of the C binding `notPointer` is a function in Avin and `int` in C: a function crosses to C only for a parameter of function-pointer type, as in `void (*listener)(userdata void *data, int value)`
// error: parameter 2 of the C binding `notFunction` takes the function C calls through `f`, and `long` cannot be it: the parameter takes a function, an Avin function of a matching type, as in `(int, int) -> int`
// error: parameter 2 of the C binding `tooMany` takes the function C calls through `f`, and `(int, int) -> int` cannot be it: C calls it with 1 parameter besides its `userdata`, and the function takes 2; they correspond by position
// error: parameter 2 of the C binding `wrongParameter` takes the function C calls through `f`, and `(string) -> int` cannot be it: its parameter 1 is `string` in Avin and `int` in C: a string crosses as a C `const char *` or `char *`
// error: parameter 2 of the C binding `wrongAnswer` takes the function C calls through `f`, and `(int) -> unit` cannot be it: C's function answers `int`, so the Avin function answers a value of its own

@c("int abs(int x)")
notPointer(x: int -> int) -> int

@c("long long cb_repeat(int n, int (*f)(userdata void *ud, int i), userdata void *ud)")
notFunction(n: int, f: long) -> long

@c("long long cb_repeat(int n, int (*f)(userdata void *ud, int i), userdata void *ud)")
tooMany(n: int, f: (int, int) -> int) -> long

@c("long long cb_repeat(int n, int (*f)(userdata void *ud, int i), userdata void *ud)")
wrongParameter(n: int, f: string -> int) -> long

@c("long long cb_repeat(int n, int (*f)(userdata void *ud, int i), userdata void *ud)")
wrongAnswer(n: int, f: int -> unit) -> long

main() = 0
