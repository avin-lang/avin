// error: `Blob` promises to be `Sendable`, but its field `size` is a `var`; make it a `val`
// error: `Tally` promises to be `Sendable`, but its field `items` holds a `Buffer[int]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: `Packet` promises to be `Sendable`, but its field `bytes` holds an `Array[byte]`, which is mutable
// error: `Draft` promises to be `Sendable`, but its field `text` is a `var`; make it a `val`
// error: `Leaky[T, U]` promises to be `Sendable`, but its field `extra` holds a `U`, which is a type parameter that may stand for any type; bound it, as in `[U: Sendable]`
// A declaration that promises `Sendable` is held to it: a class implementing a trait that promises
// it, a class whose header does, a data type an impl makes sendable, a subclass of an abstract class
// that promises it, and an implementor of a generic trait whose parameter the trait does not take.
trait Shape: Sendable
    area() -> real

class Blob(var size: real): Shape
    override area() -> real = size

class Tally: Sendable
    val items = Buffer[int]()

data Packet(bytes: Array[byte])

impl Sendable for Packet

abstract class Message: Sendable

class Draft(var text: string): Message

trait Envelope[T]: Sendable
    contents() -> T

class Leaky[T, U](val body: T, val extra: U): Envelope[T]
    override contents() -> T = body

main() -> int = 0
