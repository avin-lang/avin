// error: the branches of this `if` agree on no type: `Wrong.State` and `string`
// error: `Elsewhere` is not defined
// error: expected Shared.State, found unit
// error: `stay` is not defined
// An actor with states is a machine driven by its mailbox, so each arm's value is the next state:
// an arm of a state, or of the shared `receive`, yielding anything else is refused at the arm, and
// a state is named by the actor's own states only. An actor without states has arms that yield
// nothing, and `stay` is not a name there.
data Ev
  A
  B

actor Wrong receives Ev
  state S
    A -> 3
    B ->
      if true then T else "no"

  state T
    _ -> Elsewhere

actor Shared receives Ev
  state U
    A -> stay
  receive
    B -> println("b")

actor Plain receives Ev
  receive
    _ -> stay

main() = ()
