// error: `break` cannot leave a delayed argument, which is evaluated where its parameter is read
// error: `continue` cannot leave a delayed argument, which is evaluated where its parameter is read
// error: `return` cannot leave a delayed argument, which is evaluated where its parameter is read
// error: expected -> int, found -> string
// error: a value of type int cannot be called; only a function can
once(value: -> int) -> int = value

run(action: -> unit) = action

passed(text: -> string) -> int = once(text)

forced(value: -> int) -> int = value()

main() -> int
  var i = 0
  while i < 3
    i += 1
    run(break)
    run(continue)
    once(return 1)
  0
