// error: and Vector[int] | Bag is none of them
// error: and Either[string, int] is none of them
// error: and Plain is none of them
// error: and U is none of them
// A union is a `for` source only where every member conforms to `Iterable`; an `Either`, which
// has `iterator()` but is not an `Iterable`, is not one; neither is a subclass that gives an
// `iterator()` of its own to a parent that does not conform, nor a type parameter with no bound.
class Bag
  iterator() -> Iterator[int] = [9].iterator()

open class Base

class Plain: Base
  iterator() -> Iterator[int] = [1].iterator()

either(b: bool) -> Vector[int] | Bag = if b then Vector(1) else Bag()

unbounded[U](u: U)
  for x in u do println("x")

main()
  for x in either(true) do println(x)
  val e: Either[string, int] = Right(1)
  for x in e do println(x)
  for x in Plain() do println(x)
