// A C enum mirror's `@c` takes `enum:`, a string naming the C enum, and `prefix:`, each once: a
// number, a missing `enum:`, an unknown word, a positional argument and a repeated word are refused.
// error: `enum:` takes a string, as in `enum: "cairo_format_t"`
// error: a C enum mirror names the enum it mirrors with `enum:`, as in `@c(enum: "cairo_format_t", prefix: "CAIRO_FORMAT_")`
// error: `flags:` is not a word of `@c` on a data type, which takes `enum:` and `prefix:`
// error: `@c` on a data type mirrors a C enum: `@c(enum: "cairo_format_t", prefix: "CAIRO_FORMAT_")`
// error: `enum:` is given once

@c(enum: 3)
data NumberType
  One

@c(prefix: "X_")
data NoEnum
  One

@c(enum: "e_t", flags: "x")
data UnknownWord
  One

@c("e_t")
data Positional
  One

@c(enum: "e_t", enum: "f_t")
data Twice
  One

main() = 0
