// error: a value of type int cannot be called; only a function can
// error: `f` is a function, which cannot be assigned
// error: `+` needs two numbers of one type, not () -> int and int
// A local function hides the enclosing value only inside its own block, and the value is not
// callable or assignable there.

afterBlock() -> int
  val f = 3
  if true
    f() -> int = 4
    f()
  else 0
  f()

assignsFunction() -> unit
  var f = 1
  if true
    f() -> int = 4
    f = 2

usedAsValue() -> int
  val f = 3
  if true
    f() -> int = 4
    f + 1
  else 0

main() -> int = 0
