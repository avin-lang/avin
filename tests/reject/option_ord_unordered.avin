// error: `<` needs Option[Plain] to implement `Ord`
// error: `sorted` needs `T: Ord`, which Vector[Option[Plain]] does not meet
// error: `Option[Plain]` does not conform to `Ord`, the bound of `T` in `smaller`
// error: `compare` is a method of `Ord`, which Option[Plain] does not implement
// An option is ordered only when its value is: an option of a type without `Ord` has no comparison
// operators, does not sort, and is not an `Ord` for a generic bound.
class Plain(val n: int)

smaller[T: Ord](a: T, b: T) -> T = a

main()
    val a: Option[Plain] = None
    val b: Option[Plain] = Some(Plain(1))
    println(a < b)
    val xs: Vector[Option[Plain]] = [a, b]
    println(xs.sorted().length())
    println(smaller(a, b).isEmpty())
    println(a.compare(b))
