// A binding says its call may wait with `blocking`, written alone and once, after the Sysl
// function's name; `@sysl` takes nothing else.
// error: `blocking` is written alone, after the Sysl function's name: `@sysl("sysl.net.accept", blocking)`
// error: `@sysl` takes `blocking` once
// error: `@sysl` takes the Sysl function's module and name, and after it only `blocking`, for a call that may wait: `@sysl("sysl.net.accept", blocking)`
// error: `@sysl` takes one string, the module and name of the Sysl function
// error: `@sysl` takes the Sysl function's module and name, and after it only `blocking`, for a call that may wait: `@sysl("sysl.net.accept", blocking)`

@sysl("sysl.text.to_upper", blocking: true)
named(s: string) -> string

@sysl("sysl.text.to_upper", blocking, blocking)
twice(s: string) -> string

@sysl("sysl.text.to_upper", waits)
otherWord(s: string) -> string

// A top-level binding names its Sysl function: `blocking` alone is not one.
@sysl(blocking)
noName(s: string) -> string

@sysl("sysl.text.to_upper", "sysl.text.to_lower")
twoNames(s: string) -> string

main() = 0
