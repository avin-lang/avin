// error: no overload of `++` accepts these arguments
// error: no overload of `++` accepts these arguments
// error: no overload of `++` accepts these arguments
// error: no overload of `pick` accepts these arguments
// A collection literal given to an overloaded method takes its numbers from the parameter only where
// its elements can be them: strings, a fraction where integers are wanted, and an integer out of a
// byte's range stay refused.

pick(a: Vector[long], b: Vector[long]) -> int = 1
pick(a: Vector[bool], b: Vector[bool]) -> int = 2

main() =
  val v: Vector[long] = [1, 2]
  val bytes: Vector[byte] = [1]
  println(v ++ ["a"])
  println(v ++ [1.5])
  println(bytes ++ [256])
  println(pick(v, ["a"]))
