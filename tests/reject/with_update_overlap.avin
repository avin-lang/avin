// error: `bg` is changed twice in one `with`
// error: `pos.x` is changed twice in one `with`
// error: `pos` is changed whole and `pos.x` inside it in one `with`: change one or the other
// error: `at.pos` is changed whole and `at.pos.y` inside it in one `with`: change one or the other
// error: `at` is changed whole and `at.pos.x` inside it in one `with`: change one or the other

data Point(x: int, y: int)

data Style(fg: int, bg: int)

data Sprite(pos: Point, name: string)

data Holder(at: Sprite)

main()
  val a = Style(1, 2) with {bg = 9, bg = 8}
  val s = Sprite(Point(1, 2), "s")
  val b = s with {pos.x = 1, name = "n", pos.x = 2}
  val c = s with {pos = Point(0, 0), pos.x = 3}
  val h = Holder(s)
  val d = h with {at.pos.y = 1, at.pos = Point(0, 0)}
  val e = h with {at.pos.x = 1, at = s}
