// error: cannot convert T to long
// error: `T` is a type parameter, which a call converts to only where it is bounded by `Integer`
// error: `byte` does not conform to `Integer`, the bound of `T` in `wider`
// error: `real` does not conform to `Integer`, the bound of `T` in `wider`
// Only a type parameter bounded by `Integer` converts to and from the integer types, and only the
// integer types meet that bound: `byte` is binary data, not a member.
widen[T](x: T) -> long = long(x)

make[T](n: long) -> T = T(n)

wider[T: Integer](x: T) -> long = long(x)

main()
    print(wider(byte(1)))
    print(wider(1.5))
