// error: `Ranked` cannot derive `Ord`: its field `plain` has type `Plain`, which does not implement `Ord`
// error: `Shown` cannot derive `Display`: its field `pair` has type `(int, Plain)`, which does not implement `Display`
// error: `Flags` cannot derive `Ord`: its field `On.set` has type `bool`, which does not implement `Ord`
// error: `Box` cannot derive `Display`: its field `plain` has type `Plain`, which does not implement `Display`
// error: `Sorted[Plain]` does not conform to `Ord`, the bound of `T` in `largest`
class Plain(n: int)

class Ranked(val plain: Plain, val n: int) derives Eq, Hash, Ord

// A tuple has `Display` only where its parts do.
class Shown(pair: (int, Plain)) derives Display

data Flags derives Ord
    Off
    On(set: bool)

data Box[T](item: T, plain: Plain) derives Display

// A generic class's derived `Ord` holds only where its type argument is ordered.
class Sorted[T](item: T) derives Eq, Hash, Ord

largest[T: Ord](a: T, b: T) -> T = if a < b then b else a

main()
    print(largest(Sorted(Plain(1)), Sorted(Plain(2))).item.n)
