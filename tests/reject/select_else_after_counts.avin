// error: a select has at most one `else`
// error: a select has at most one `after`
// error: a select with `else` never waits, so it has no `after`
// A select has at least one arm, at most one `else` and one `after`, and not both.
import avin.threads.Channel
import avin.time.millis

main()
  val c = Channel[int]()
  select
    c.receive() -> ()
    else ()
    else ()
  select
    c.receive() -> ()
    after 1.millis -> ()
    after 2.millis -> ()
  select
    c.receive() -> ()
    after 1.millis -> ()
    else ()
