// A class whose `kept:` names what it keeps is made only by bindings keeping exactly one handle of
// that class, which is a C handle of its module holding its object by a reference of its own.
// error: `MM` names the `Face` it keeps, `face`, so every binding that makes one keeps exactly one `Face`; `keepsNone` keeps 0
// error: `MM` names the `Face` it keeps, `face`, so every binding that makes one keeps exactly one `Face`; `keepsTwo` keeps 2
// error: `OnPlain` keeps a `Plain` it names `plain`, which is a C pointer only while a C reference holds it: `Plain` is a C handle declaring `retain` and no `kept:` of its own
// error: `Lost`'s `kept:` names the class `Nowhere`, which is not a class of its module

@c(type: "struct face *", release: "face_free", retain: "face_ref")
class Face

@c(type: "struct plain *", release: "plain_free")
class Plain

@c(type: "struct mm *", kept: "face: Face", release: "mm_free(face, self)")
class MM

@c(type: "struct mm *", kept: "plain: Plain", release: "mm_free(plain, self)")
class OnPlain

@c(type: "struct mm *", kept: "face: Nowhere", release: "mm_free(face, self)")
class Lost

@c("struct mm *mm_new(struct face *face)")
keepsNone(face: Face) -> MM

@c("struct mm *mm_new(struct face *a, struct face *b)", keeps: ["a", "b"])
keepsTwo(a: Face, b: Face) -> MM

@c("struct mm *mm_new(struct plain *p)", keeps: "p")
onPlain(p: Plain) -> OnPlain

@c("struct mm *mm_new(void)")
lost() -> Lost

main() = 0
