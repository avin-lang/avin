// `def` belongs to a function's signature, never to its clauses: a clause written with it is
// reported and read as the clause it is, at the top level, in a class and in a block, and so is a
// clause with no signature before it. A name after `def` with neither a parameter list nor a result
// type is refused: a body run for its effect is declared with `()`.
// error: `def` begins a function's signature, and its clauses are written without it, as in `fib(parameters) = body`
// error: `def` begins a function's signature, and its clauses are written without it, as in `pick(parameters) = body`
// error: `def` begins a function's signature, and its clauses are written without it, as in `go(parameters) = body`
// error: `def` begins a function's signature, and its clauses are written without it, as in `stray(parameters) = body`
// error: `run` has neither a parameter list nor a result type: write `def run -> int = value` or `def run = value` for a function read by its name, or `run()` for one called for its effect

def fib(n: int) -> int
def fib(0) = 0
fib(n) = n

class K
    def pick(n: int) -> string
    def pick(0) = "zero"
    pick(_) = "other"

def stray(0) = 1

def run
    println(1)

main() =
    def go(n: int) -> int
    def go(0) = 0
    go(n) = n
    go(1)
