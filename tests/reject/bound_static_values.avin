// A static member taken as a value through a type parameter's bound is refused where a call of it
// would be, and where the value cannot say which member is meant: a name no bound declares, a method
// of a value, an overloaded name with no function type expected or none fitting it, a member
// declared with `()` and no function type expected.
// error: `T` has no static member `missing`
// error: `show` is a method of a value of `T`, not of the type; call it on a value
// error: `pick` is overloaded, so as a value with no expected function type it is ambiguous
// error: no overload of `pick` has the parameter types of (bool) -> string
// error: `unit` is called with `()`: write `T.unit()`, or `() -> T.unit()` for a function value

trait Parse
  static pick(x: int) -> string
  static pick(s: string) -> string
  static unit() -> Self
  show() -> string

missing[T: Parse]() = T.missing

method[T: Parse]() = T.show

ambiguous[T: Parse]() = T.pick

unfit[T: Parse]()
  val f: (bool) -> string = T.pick

bare[T: Parse]() = T.unit

main() = ()
