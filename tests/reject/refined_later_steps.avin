// error: `First` hides `B`, named by its fields and not by its result: a pattern cannot take apart a value of a variant with hidden type parameters yet
// error: `First` hides `B`, named by its fields and not by its result: a value of a variant with hidden type parameters cannot be made yet
// error: `Then` hides `Mid`, named by its fields and not by its result: a value of a variant with hidden type parameters cannot be made yet
// error: `Node` bounds its own parameter `A`: a value of a variant whose own parameters have bounds cannot be made yet
// error: `Then` hides `Mid`, named by its fields and not by its result: a pattern cannot take apart a value of a variant with hidden type parameters yet
// What hidden parameters and bounds on a variant's parameters bring is refused until it is built: a
// pattern on a variant that hides a parameter, and a value of a variant that hides a parameter or
// bounds one of its own. A pattern on any other variant of the type refines.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  If(cond: Expr[bool], yes: Expr[T], no: Expr[T])
  First[A, B](pair: Expr[(A, B)]) -> Expr[A]

data Plan[From, To]
  Done -> Plan[From, From]
  Then[Mid](step: Plan[From, Mid], rest: Plan[Mid, To])

data Sorted[T]
  Empty
  Node[A: Ord](items: Vector[A]) -> Sorted[A]

value(e: Expr[int]) -> int = e match
  IntLit(n) -> n
  If(_, _, _) -> 0
  First(_) -> 1

steps[A, B](p: Plan[A, B]) -> int = p match
  Done -> 0
  Then(_, _) -> 1

main()
  val f = First(IntLit(1))
  val done: Plan[int, int] = Done
  val p = Then(done, done)
  val s = Node([1])
