// error: `Node` bounds its own parameter `A`: a value of a variant whose own parameters have bounds cannot be made yet
// error: `Tree` bounds its own parameter `A`: a value of a variant whose own parameters have bounds cannot be made yet
// What bounds on a variant's parameters bring to the enclosing code is refused until it is built: a
// value of a variant bounding one of its own parameters that its result names, even beside a bounded
// hidden one. A hidden parameter's bounds are allowed, and patterns and values of variants hiding
// types are made and taken apart beside them.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  If(cond: Expr[bool], yes: Expr[T], no: Expr[T])
  Pair[A, B](first: Expr[A], second: Expr[B]) -> Expr[(A, B)]
  First[A, B](pair: Expr[(A, B)]) -> Expr[A]

data Plan[From, To]
  Done -> Plan[From, From]
  Then[Mid](step: Plan[From, Mid], rest: Plan[Mid, To])

data Sorted[T]
  Empty
  Node[A: Ord](items: Vector[A]) -> Sorted[A]
  Tree[A: Ord, B: Display](items: Vector[A], label: B) -> Sorted[A]

value(e: Expr[int]) -> int = e match
  IntLit(n) -> n
  If(_, _, _) -> 0
  First(_) -> 1

steps[A, B](p: Plan[A, B]) -> int = p match
  Done -> 0
  Then(_, _) -> 1

main()
  val f = First(Pair(IntLit(1), IntLit(2)))
  val done: Plan[int, int] = Done
  val p = Then(done, done)
  val s = Node([1])
  val t = Tree([1], "one")
