// error: module-level values need one another to initialize: `first` → `third` → `second` → `first`
// error: module-level values need one another to initialize: `alpha` → `beta` → `alpha`
// error: module-level values need one another to initialize: `low` → `high` → `low`
val entry: int = later + 1
val earlier: int = later + 1
val later: int = earlier + 1

val reach: int = third * 2
val first: int = third + 1
val second: int = first + 1
val third: int = second + 1

val opener: int = readBeta()
readBeta() -> int = beta
val alpha: int = beta - 1
val beta: int = readAlpha() + 1
readAlpha() -> int = alpha

