// error: expected int, found string

// A literal's elements agree on one type, an empty literal needs one from its context, and a buffer,
// being mutable, is not covariant.

open class Animal(val name: string)
class Dog(n: string): Animal(n)

main()
    val mixed = [1, "two"]
    val empty = []
    val dogs: Buffer[Dog] = [Dog("rex")]
    val animals: Buffer[Animal] = dogs
    val wrong: Option[int] = [1]
    val ints: Array[int] = [1, "x"]
