// error: `Loud` cannot derive `Display`: its variant `Yell` hides `A` in its field `value`, which a value may hold at any type; bound the parameter, as in `[A: Display]`
// error: `A` has no bound, so it has no member `toString`; a bound, as in `[A: Trait]`, gives it the methods of the trait
// error: `Plain` does not conform to `Sendable`, so the actor `Sink` cannot receive it: its variant `Keep` hides `A`, which a value may hold at any type; bound it, as in `[A: Sendable]`
// error: `Quiet` does not conform to `Display`, the bound of `A` in `Show`
// error: `Tagged[int]` does not implement `Display`, so it cannot be interpolated; `Tagged` has no `Display` because its field `Hide.value` names `T`, which the variant hides and a value may hold at any type; bound it, as in `[T: Display]`
// A hidden parameter has exactly the bounds its variant declares, `A: Display & Eq` both: they are
// checked where a value is made and held in the arm, and nothing else is known of it there. A trait
// derived for the type, `Sendable` included, holds of a hidden parameter only by those bounds, since
// each value may hold another type there; a parameter of the type a refined variant hides is the
// value's own, not the instance's.
import avin.actors.{ActorRef, spawn}

class Counter()
  var n = 0

class Quiet(val n: int)

data Shown
  Show[A: Display & Eq](value: A)

data Plain
  Keep[A](value: A)

data Loud derives Display
  Yell[A](value: A)

data Tagged[T]
  Hide(value: T) -> Tagged[int]

say(p: Plain) -> string = p match
  Keep(v) -> v.toString()

actor Sink() receives Plain
  receive
    Keep(_) -> println("got")

main()
  val s = Show(Quiet(1))
  val t: Tagged[int] = Hide(Counter())
  println(s"$t")
