// error: `shown` is already a method of `Box` with the same parameter types; a method's overloads differ in their parameter types
// error: `named` is already a method of `Pair` with the same parameter types; a method's overloads differ in their parameter types
class Box[T](value: T)

impl[T] Box[T]
  shown() -> string = "plain"

impl[T: Display] Box[T]
  shown() -> string = value.toString()

data Pair[A, B](first: A, second: B)

impl[A: Display, B] Pair[A, B]
  named() -> string = first.toString()

impl[A, B: Display] Pair[A, B]
  named() -> string = second.toString()

main() = ()
