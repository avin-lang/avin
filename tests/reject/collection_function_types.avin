// error: expected (string) -> bool, found Set[int]
// error: expected (int) -> string, found Map[int, int]
// A set is the function `(A) -> bool` of its own element type and a map `(K) -> V` of its own key
// and value types: a function type with other parameters or another result is no supertype, and a
// sequence's element is held to the result as its variance allows.

open class Animal
class Dog: Animal()

main()
    val s = Set[int]().incl(1)
    val p: (string) -> bool = s
    val m = Map[string, int]()
    val q: (string) -> string = m
    val xs: Vector[Animal] = [Dog()]
    val r: (int) -> Dog = xs
    val words = ["a"]
    println(words.filter(s))
    val squares = Map[int, int]().updated(2, 4)
    println([1, 2].map[string](squares))
