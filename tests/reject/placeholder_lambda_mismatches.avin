// error: expected a function of 2 parameters, but this lambda has 1 placeholder, and each `_` is a parameter of its own; to leave a parameter unused, write the lambda out, as in `(a, _) -> a`
// error: expected a function of 3 parameters, but this lambda has 2 placeholders
// error: int has no field `name`
// error: cannot infer the type of this `_`; write the lambda out with the type
// The number of `_`s is the lambda's parameter count, checked against the function expected, and
// each takes the type the expected function gives it. A by-name `int` parameter expects no function,
// so the placeholder has no type.

apply2(f: (int, int) -> int) -> int = f(1, 2)

apply3(f: (int, int, int) -> int) -> int = f(1, 2, 3)

twice(value: -> int) -> int = value + value

main() -> int
    val xs = [1, 2, 3]
    println(xs.map(_ * _))
    println(apply2(_ + 1))
    println(apply3(_ + _))
    println(xs.map(_.name))
    println(twice(_ + 1))
    0
