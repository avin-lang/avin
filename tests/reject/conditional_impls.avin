// error: `Box[Plain]` does not conform to `Ord`, the bound of `T` in `largest`
// error: an impl with bounds of its own is implemented for traits that are only bounds, which mention `Self`; `Named` is also a type
// error: an impl with bounds of its own is implemented for data types only
// error: every type compares and hashes, so an impl of `Hash` holds for every type argument; its bounds may be `Eq` and `Hash` only
// error: `<` needs Box[Plain] to implement `Ord`
// An impl with bounds of its own makes its type conform only where the type arguments meet them.
data Box[T](item: T)

impl[T: Ord] Ord for Box[T]
    compare(other: Box[T]) -> int = item.compare(other.item)

trait Named
    name() -> string

impl[T: Ord] Named for Box[T]
    name() -> string = "box"

class Cell[T](item: T)

impl[T: Ord] Ord for Cell[T]
    compare(other: Cell[T]) -> int = 0

impl[T: Ord] Hash for Box[T]
    hash() -> long = 0

class Plain

largest[T: Ord](a: T, b: T) -> T = if a < b then b else a

main()
    val b = largest(Box(Plain()), Box(Plain()))
    if Box(Plain()) < Box(Plain()) then print("no")
