// error: `Box[Plain]` does not conform to `Ord`, the bound of `T` in `largest`
// error: every type compares and hashes, so an impl of `Hash` holds for every type argument; its bounds may be `Eq` and `Hash` only
// error: `<` needs Box[Plain] to implement `Ord`
// error: `compare` is a method of `Ord`, which Box[Plain] does not implement
// error: expected Display, found List[Plain]
// An impl with bounds of its own makes its type conform only where the type arguments meet them, and
// its methods are called only there.
data Box[T](item: T)

impl[T: Ord] Ord for Box[T]
  compare(other: Box[T]) -> int = item.compare(other.item)

impl[T: Ord] Hash for Box[T]
  hash() -> long = 0

class Plain

largest[T: Ord](a: T, b: T) -> T = if a < b then b else a

main()
  val b = largest(Box(Plain()), Box(Plain()))
  if Box(Plain()) < Box(Plain()) then println("no")
  println(s"${Box(Plain()).compare(Box(Plain()))}")
  val plain: List[Plain] = [Plain()]
  val shown: Display = plain
