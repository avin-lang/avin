// A method declared with no parameter list is the only method of its name: in its class, through
// inheritance, and among the methods impls add to a data type or a built-in type.
// error: `head` is declared both with and without a parameter list
// error: `size` is declared both with and without a parameter list
// error: `shout` is declared both with and without a parameter list
// error: `total` is declared both with and without a parameter list

class D(x: int)
  head -> int = x
  head(n: int) -> int = n

open class Base
  size -> int = 0

class Sub: Base
  size(scale: int) -> int = scale

impl string
  shout -> string = self
  shout(times: int) -> string = self.repeat(times)

data P(x: int)

impl P
  total(n: int) -> int = x + n
  total -> int = x

main() = 0
