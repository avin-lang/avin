// error: module-level values need one another to initialize: `first` → `second` → `first`
// error: module-level values need one another to initialize: `viaTrait` → `late` → `viaTrait`
open class Base
  name() -> string = "base"

class Derived: Base
  override name() -> string = "derived " + second

trait Namer
  label() -> string

class Impl: Namer
  override label() -> string = late

val first = make().name()

val second = first + "!"

val viaTrait: string = namer().label()

val late: string = viaTrait + "?"

make() -> Base = Derived()

namer() -> Namer = Impl()

main() = ()
