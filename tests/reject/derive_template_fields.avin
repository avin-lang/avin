// A type derives a trait through its template only where each field's type meets the bound of the
// visitor's hook: a field that falls short is reported at the `derives` entry, by name, a variant's
// field with its variant. A trait derived and also implemented is a conformance stated twice.
// error: `Bad` cannot derive `Describe`: field `ratio` has type `real`, which does not implement `Describe`
// error: `Many` cannot derive `Describe`: field `Two.flag` has type `bool`, which does not implement `Describe`
// error: `Twice` cannot derive `Describe`: `Twice` already conforms to `Describe`; a conformance is stated once
// error: `Pocket` cannot derive `Describe`: field `items` has type `List[Coin]`, which does not implement `Describe`

trait Describe
  describe() -> string

impl Describe for int
  describe() -> string = s"$self"

impl[A: Describe] Describe for List[A]
  describe() -> string = map(a -> a.describe()).mkString(", ")

derive Describe for T
  describe() -> string = T.walk(self, Describer("")).text

data Describer(text: string)

impl ShapeVisitor for Describer
  variant(v: VariantShape) -> Describer = Describer(v.name)

impl Describer
  field[F: Describe](f: FieldShape, value: F) -> Describer = Describer(text + value.describe())

data Bad(count: int, ratio: real) derives Describe

data Many derives Describe
  One(a: int)
  Two(flag: bool)

data Twice(n: int) derives Describe

impl Describe for Twice
  describe() -> string = "twice"

data Coin(cents: int)

data Pocket(items: List[Coin]) derives Describe

main() = 0
