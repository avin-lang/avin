// error: state `Idle` of `Conn` does not handle `Connect(_)` or `Connected(_)`
// error: state `Connecting` of `Conn` does not handle `Connect(_)`
// error: state `Ready` of `Conn` does not handle `Connect(_)` where the guard is false or `Connected(_)`
// error: state `Up` of `Flag` does not handle `false`
// error: state `Any` of `Count` does not handle `-1` where the guard is false
// An actor's states are checked as a machine's are: state by state, its own arms and the shared
// `receive` arms together must handle every message, guarded arms not counting, and the error names
// the state and the actor rather than the actor's `receive`. A state with no arms of its own is
// checked on the shared ones alone, and an actor with states needs no `receive` block.
data ConnMsg
  Connect(host: string)
  Connected(id: int)
  Send(n: int)
  Closed

actor Conn receives ConnMsg
  state Idle
  state Connecting
    Connected(id) -> Ready(id)
  state Ready(id: int)
    Connect(h) if h == "" -> stay
  receive
    Send(_) | Closed -> stay

actor Flag receives bool
  state Up
    true -> stay

actor Count receives int
  state Any
    n if n > 0 -> stay
    0 -> stay

main() = ()
