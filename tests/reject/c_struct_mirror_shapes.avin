// A C struct mirror is a data type with one variant named as the type, no type parameters, and
// `struct:` alone in its `@c`; a variant's `@c` belongs to enum mirrors.
// error: a C struct mirror has one variant, named as the type, whose fields are the struct's: `Two(fields)`
// error: a C struct mirror has one variant, named as the type, whose fields are the struct's: `Other(fields)`
// error: a C struct mirror has no type parameters: it mirrors one C struct
// error: `prefix:` is not a word of `@c` on a C struct mirror, which takes `struct:` alone
// error: `@c` on a variant names an enumerator of a C enum mirror; a struct mirror's fields name their C fields with `@c("name")`

@c(struct: "as_point")
data Two
    Two(x: real)
    Three(y: real)

@c(struct: "as_point")
data Other
    Point(x: real, y: real)

@c(struct: "as_point")
data Generic[T](x: real)

@c(struct: "as_point", prefix: "AS_")
data Prefixed(x: real, y: real)

@c(struct: "as_point")
data Annotated
    @c("as_point")
    Annotated(x: real, y: real)

main() = 0
