// error: `Box` cannot derive `Enumerable`: it is a class, and an enumeration is a data type whose variants have no fields
// error: `Plain` does not conform to `Enumerable`, the bound of `E` in `names`
// error: expected string, found int
// error: expected int, found string
// error: `name` is already a method of `Named` with the same parameter types; a method's overloads differ in their parameter types
data Color derives Enumerable
    Red
    Green

data Plain
    A
    B

// A method of the type's own with the name of a derived one is a second method of that name.
data Named derives Enumerable
    One

impl Named
    name() -> string = "mine"

open class Box() derives Enumerable

names[E: Enumerable]() -> Vector[string] = E.values.map(e -> e.name)

main()
    println(names[Plain]())
    println(Color.valueOf(1))
    val n: int = Red.name
    println(n)
