// error: `Cell.traverse` does not implement `Walk.traverse` for `Cell`, whose type parameter `G` is bounded by Chain[_], which `Walk.traverse` does not promise
// error: `Pair.traverse` does not implement `Walk.traverse` for `Pair`, whose type parameter `H` a call of `Walk.traverse` does not decide
// error: `Solo.traverse` does not implement `Walk.traverse` for `Solo`, which yields G[Option[B]], and G[Solo[B]] is wanted, which it is not without a conversion
// A method with a constructor parameter of its own meets a trait method only where the trait's
// call decides it, with no bound the trait does not give, and the result is the trait's.
trait Pointed[A]
  static pure[X](value: X) -> Self[X]
  map[B](f: (A) -> B) -> Self[B]

trait Chain[A]: Pointed[A]
  flatMap[B](f: (A) -> Self[B]) -> Self[B]

trait Walk[A]
  traverse[G[_]: Pointed, B](f: (A) -> G[B]) -> G[Self[B]]

data Cell[T](value: T)

impl Walk for Cell
  traverse[G[_]: Chain, B](f: (T) -> G[B]) -> G[Cell[B]] = f(value).map(b -> Cell(b))

data Pair[T](value: T)

impl Walk for Pair
  traverse[G[_]: Pointed, H[_], B](f: (T) -> G[B]) -> G[Pair[B]] = f(value).map(b -> Pair(b))

data Solo[T](value: T)

impl Walk for Solo
  traverse[G[_]: Pointed, B](f: (T) -> G[B]) -> G[Option[B]] = f(value).map(b -> Some(b))

main()
  ()
