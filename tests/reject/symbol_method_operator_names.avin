// error: `+%` is an operator of the language and cannot name a method
// error: `&&` is an operator of the language and cannot name a method
// error: `||` is an operator of the language and cannot name a method
class Bits(val n: int)
    +%(other: Bits) -> Bits = self
    &&(other: Bits) -> Bits = self
    ||(other: Bits) -> Bits = self
    |(other: Bits) -> Bits = self

main()
    val b = Bits(1) | Bits(2)
