// error: `rewrap` is for `F[A]` where `F` implements `Pointed`; this is `F[int]`, whose constructor is bounded by no `Pointed`
// error: `twice` is for `F[A]` where `F` implements `Mappable`; this is `Plain[int]`, and `Plain` does not implement `Mappable`, the bound of the constructor; a type is one only where its declaration or an impl says so
// error: `twice` is ambiguous on Option[Option[int]]: impls of `F[A]` and of `F[Option[A]]` each add it with the same parameter types
// error: `labelled` needs `A: Display`, which Option[Gadget] does not meet
// error: `depth` is for `F[F[A]]` where `F` implements `Mappable`; this is `Option[Plain[int]]`
// A method added to the applications of a bounded constructor parameter is called only on a value
// whose type matches: a constructor parameter in generic code must be bounded by the impl's trait,
// a type must implement it, a further bound on the element must hold, and a constructor named twice
// takes one constructor. Two impls whose types both match a receiver, adding one name and parameter
// types, make a call of it ambiguous.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

trait Pointed[A]: Mappable[A]
  static pure[X](value: X) -> Self[X]

impl Pointed for Option
  static pure[X](value: X) -> Option[X] = Some(value)

class Gadget(val n: int)

data Plain[T](value: T)

impl[F[_]: Mappable, A] F[A]
  twice(f: (A) -> A) -> F[A] = map(f).map(f)

impl[F[_]: Mappable, A] F[Option[A]]
  twice(f: (Option[A]) -> Option[A]) -> F[Option[A]] = map(f)

impl[F[_]: Pointed, A] F[A]
  rewrap() -> F[F[A]] = F.pure(self)

impl[F[_]: Mappable, A: Display] F[A]
  labelled(name: string) -> F[string] = map(a -> s"$name=$a")

impl[F[_]: Mappable, A] F[F[A]]
  depth() -> int = 2

shallow[F[_]: Mappable](x: F[int]) -> F[F[int]] = x.rewrap()

main()
  println(Plain(1).twice((n: int) -> n))
  println(Some(Some(1)).twice((o: Option[int]) -> o))
  println(Some(Gadget(1)).labelled("p"))
  println(Some(Plain(1)).depth())
