// error: a data type has exactly the variants it declares and cannot be extended, so it takes no `open`: remove it
// error: a data type has exactly the variants it declares and cannot be extended, so it takes no `abstract`: remove it
// error: an object is the one value of its own class and cannot be extended, so it takes no `open`: remove it
// error: an object is the one value of its own class and cannot be extended, so it takes no `abstract`: remove it
// A trait, a data type and an object take neither `open` nor `abstract`.

abstract trait T
    t() -> int

open data D
    A
    B

abstract data Point(x: int)

open object O
    o() -> int = 1

abstract object P
    p() -> int = 1

main() = ()
