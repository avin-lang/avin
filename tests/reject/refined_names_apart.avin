// error: `==` cannot compare Expr[A of `Pair` on line 20] with Expr[A of `Pair` on line 21]
// error: `==` cannot compare Expr[A of `Pair` on line 26, column 4] with Expr[A of `Pair` on line 26, column 16]
// Two fresh types that read the same are named apart by the patterns they come from, by line, and by
// line and column where both patterns are on one line.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  Pair[A, B](first: Expr[A], second: Expr[B]) -> Expr[(A, B)]

same[T](x: Expr[T], y: Expr[T]) -> int = 0

differ[T, U](a: Expr[T], b: Expr[U]) -> int = a match
  Pair(x, _) -> b match
    Pair(y, _) -> same(x, y)
    _ -> 0
  _ -> 0

values[T, U](a: Expr[T], b: Expr[U]) -> bool = a match
  Pair(x, _) -> b match
    Pair(y, _) -> x == y
    _ -> false
  _ -> false

oneLine[T, U](a: Expr[T], b: Expr[U]) -> bool = (a, b) match
  (Pair(x, _), Pair(y, _)) -> x == y
  _ -> false

main()
  ()
