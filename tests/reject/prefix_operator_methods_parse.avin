// error: a method `!` is what a prefix `!` calls, so it takes no argument: write `!() -> T`
// error: a method `!` is what a prefix `!` calls, so it takes no argument: write `!() -> T`
// error: `!!` is a method's name, called between its two operands; a symbol method has no prefix form, and a prefix operator written right before another needs a space between them
// error: `-~` is a method's name, called between its two operands; a symbol method has no prefix form, and a prefix operator written right before another needs a space between them
// A method `!` takes no argument, a defaulted one included; and two prefix operators written together
// are one name, so nested prefixes are written apart: `! !x`, `- ~x`.
data Cond(text: string)

impl Cond
  !(other: Cond) -> Cond = other
  !(n: int = 0) -> Cond = self

main()
  val c = Cond("x")
  val a = !!c
  val b = -~c
