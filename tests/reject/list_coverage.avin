// error: this `match` does not cover every List[int] value
// error: this `match` does not cover every List[string] value
// error: this `match` does not cover every List[bool] value
// error: the clauses of `clauses` do not cover every argument
// error: a binding's pattern must match every List[int] value

// `[]` and `head :: tail` together cover a list; fixed-length patterns cover only their lengths.

noEmpty(xs: List[int]) -> int = xs match
    x :: _ -> x

fixed(xs: List[string]) -> int = xs match
    [] -> 0
    [_] -> 1
    [_, _] -> 2

nested(xs: List[bool]) -> int = xs match
    [] -> 0
    true :: _ -> 1
    false :: [] -> 2

clauses(xs: List[int]) -> int
clauses([]) = 0
clauses([x]) = x

// A `for` binds each element by a pattern every element matches.
main()
    val xss: List[List[int]] = [[1, 2], [3]]
    for x :: _ in xss do print(x)
