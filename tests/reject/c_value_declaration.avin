// An opaque value is a class declared `@c(value: …)` naming a struct or a union, with no parameters,
// type parameters or fields, and no other word in its `@c`: nothing gives a copy back.
// error: `release:` is not a word of `@c` on an opaque value, which takes `value:` alone: it holds a copy of the C value, which nothing gives back
// error: `value:` names the C struct or union the class holds a copy of, and `as_event *` is a pointer, which is a handle, a class declared `@c(type: "int *")`
// error: an opaque value has no parameters: the C bindings that answer one make it
// error: an opaque value holds its C value and nothing else, so its body declares only methods
// error: an opaque value has no type parameters: it holds one C value

@c(value: "as_event", release: "free")
class Released

@c(value: "as_event *")
class Pointer

@c(value: "as_event")
class Parameters(x: int)

@c(value: "as_event")
class Fields
  val x = 1

@c(value: "as_event")
class Generic[T]

main() = 0
