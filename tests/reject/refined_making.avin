// error: `IntLit(1)` is an `Expr[int]`, and an `Expr[bool]` is expected here
// error: `BoolLit(true)` is an `Expr[bool]`, and the field `b` of `Add` is an `Expr[int]`
// error: `IntLit(1)` is an `Expr[int]`, and the field `cond` of `If` is an `Expr[bool]`
// error: `Expr[bool].IntLit(1)` is an `Expr[int]`, and an `Expr[bool]` is expected here
// error: `IntLit(2)` is an `Expr[int]`, and an `Expr[bool]` is expected here
// A refined variant makes the instance its result declares, and is refused where another instance
// of its type is expected: by a declared type, by a field of a refined variant or of a plain one, by
// the instance written on the type, and by a parameter.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  BoolLit(value: bool) -> Expr[bool]
  Add(a: Expr[int], b: Expr[int]) -> Expr[int]
  If(cond: Expr[bool], yes: Expr[T], no: Expr[T])

test(e: Expr[bool]) -> int = 0

main()
  val bad: Expr[bool] = IntLit(1)
  val worse = Add(IntLit(1), BoolLit(true))
  val c = If(IntLit(1), IntLit(2), IntLit(3))
  val d = Expr[bool].IntLit(1)
  println(test(IntLit(2)))
