// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it uses `b`, a `Buffer[int]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it uses `a`, an `Array[int]`, which is mutable; an immutable copy (`toVector`) is sendable
// A thread's body may capture only sendable values and no `var`: a mutable buffer, a `var` (whose box
// the two threads would share), a buffer reached through a nested closure or a local function the
// body calls, and a method value of a mutable array are each rejected, naming what is captured.
import avin.threads.spawn

main()
    val b = Buffer[int]()
    spawn(() -> b.length()).join()
    var n = 0
    spawn(() -> n + 1).join()
    spawn(() ->
        val g = () -> b.length()
        g()).join()
    countIt() -> int = b.length()
    spawn(() -> countIt()).join()
    val a = Array.fill(2, 0)
    spawn(a.length).join()
    ()
