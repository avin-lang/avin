// A function declared with `def` and no parameter list has no function value: naming it calls it, so
// where a function is wanted the error names the lambda, at the top level and in a block. It takes no
// type arguments, at a read or before parentheses.
// error: `now` takes no parameter list, so it has no function value: naming it calls it; for a function, write a lambda, as in `() -> now`
// error: `here` takes no parameter list, so it has no function value: naming it calls it; for a function, write a lambda, as in `() -> here`
// error: `now` takes no type parameters: it is declared without a parameter list
// error: `adder` takes no type parameters: it is declared without a parameter list

def now -> int = 1
def adder -> (int) -> int = x -> x

later(f: () -> int) -> int = f()

main() =
    val f: () -> int = now
    def here -> string = "x"
    val g: () -> string = here
    println(later(now))
    println(now[int])
    println(adder[int](1))
