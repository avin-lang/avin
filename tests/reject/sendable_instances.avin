// error: `Late` does not conform to `Sendable`, the bound of `T` in `Box`: its field `items` holds a `Buffer[int]`, which is mutable
// error: `Sendable` is a bound, as in `[T: Sendable]`, or a promise a declaration makes, as in `trait Shape: Sendable`, and not a type
// error: `Envelope[Buffer[int]]` does not conform to `Sendable`, the bound of `T` in `send`: its type argument `Buffer[int]` is mutable
// error: `Chain[Log]` does not conform to `Sendable`, the bound of `T` in `send`: its variant `Link` holds a `Log`, whose field `count` is a `var`
// error: `Wrapped[Log]` does not conform to `Sendable`, the bound of `T` in `Box`: its field `value` holds a `Log`, whose field `count` is a `var`
// Generic types are held to `Sendable` at each instance: a bounded parameter where the type is named,
// before the class's field types are known and once they are; a generic trait that promises it, at a
// mutable argument; a recursive data type; and a generic data type wrapping a mutable class.
// `Sendable` itself is only a bound.
class Late
  val items = Buffer[int]()

class Log
  var count = 0

data Box[T: Sendable](value: T)

data Wrapped[T](value: T)

val held: Option[Box[Late]] = None

carry(value: Sendable) -> int = 0

trait Envelope[T]: Sendable
  contents() -> T

class Letter[T](val body: T): Envelope[T]
  override contents() -> T = body

data Chain[T]
  End
  Link(item: T, rest: Chain[T])

send[T: Sendable](value: T) -> string = "sent"

main()
  val letter: Envelope[Buffer[int]] = Letter(Buffer[int]())
  println(send(letter))
  println(send(Link(Log(), End)))
  val boxed = Box(Wrapped(Log()))
