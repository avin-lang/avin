// error: `flatten` is for an `Option` of an `Option`; this is `Option[int]`
// error: `flatten` is for a `Seq` of a `Seq`; this is `Vector[int]`
// error: `toMap` is for an `Iterable` of a pair; this is `List[int]`
// error: `flatten` is for a `Result` of a `Result`; this is `Result[Result[int, string], bool]`
// error: `unzip` is for a `Seq` of a pair; this is `Vector[(int, int, int)]`
// A method an impl adds to a type built from its parameters is called only on a receiver whose
// static type matches that type.
main()
  println(Some(1).flatten)
  val v: Vector[int] = [1, 2]
  println(v.flatten)
  val l: List[int] = [1]
  println(l.toMap())
  // The error types differ, so the inner result is not one the outer's error could join.
  val r: Result[Result[int, string], bool] = Ok(Ok(1))
  println(r.flatten)
  val triples: Vector[(int, int, int)] = [(1, 2, 3)]
  println(triples.unzip)
