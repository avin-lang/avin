// error: `total` is a `lazy val`, computed once on its first read, which cannot be assigned
// error: `added` is a `lazy val`, computed once on its first read, which cannot be assigned
// error: `stepped` is a `lazy val`, computed once on its first read, which cannot be assigned
// error: the initializer of `n` yields string, not int
// error: cannot infer the type of `again`; declare it, as in `lazy val again: int = 0`
// A local `lazy val` is never assigned, and its type is its declared one or its initializer's,
// settled where it is declared: an assignment, a compound one and a step are refused, as are an
// initializer of another type and one whose type needs the value's own.
main()
  lazy val total = 3
  lazy val added = 3
  lazy val stepped = 3
  total = 4
  added += 1
  stepped++
  lazy val n: int = "seven"
  lazy val again = again
  println(n + total + added + stepped)
