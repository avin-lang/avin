// error: `<` cannot compare bool with int
// error: `>=` cannot compare int with bool
// error: `<=` cannot compare bool with Option[bool]
// error: `<` needs (bool, Plain) to implement `Ord`
// A bool is ordered only against a bool: never against an integer, nor an option of a bool.
data Plain(n: int)

main()
  val b = true
  println(b < 1)
  println(0 >= b)
  println(b <= Some(b))
  println((b, Plain(1)) < (b, Plain(2)))
