// What a `@threaded` parameter of a C binding is given is checked where the binding is called, as a
// Sysl binding's is: its captures are what any thread may share, and the binding is called by name.
// error: the function passed to `f` of `onThread`, which C may call from any thread, captures `count`, a `var`, which that thread would share with the code here; capture a `val` holding its value
// error: `onThread` has a `@threaded` parameter, so it is called by name, where the function it is given is checked, and is not a value

@c("int cb_on_thread(int (*f)(userdata void *ud, int x), userdata void *ud, int x)")
onThread(@threaded f: int -> int, x: int) -> int

main()
    var count = 0
    onThread(x -> x + count, 1)
    val g = onThread
    0
