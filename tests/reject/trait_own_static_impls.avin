// error: `impl[A] Make[A] for Bag[A]` overlaps `impl[A] Make[A] for Bag[A]`: both hold for `Bag[A]`, and a type conforms to a trait through one impl
// error: `A` is not part of `Empty`; each of an impl's type parameters is, so an instance of the type gives it
// error: `Bag[A]` does not implement Other's `other`
// error: `make` is not a member of `Other`; an impl of a trait implements the trait's members, and an impl without a trait adds others
// A trait type's own conformance is held to what any impl of a trait is: one per trait, each of the
// impl's parameters part of the type, and every static member given, none other.
trait Make[A]
  static make(x: A) -> Self

trait Bag[A]
  first -> A

class OneBag[A](val a: A): Bag[A]
  override first -> A = a

impl[A] Make[A] for Bag[A]
  static make(x: A) -> Bag[A] = OneBag(x)

impl[A] Make[A] for Bag[A]
  static make(x: A) -> Bag[A] = OneBag(x)

trait Empty

impl[A] Make[A] for Empty

trait Other[A]
  static other(x: A) -> Self

impl[A] Other[A] for Bag[A]
  static make(x: A) -> Bag[A] = OneBag(x)

main()
  ()
