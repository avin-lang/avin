// error: comparison patterns match integers, bytes and chars, not real
// error: the amount in `n + k` is a positive integer literal
// error: `n + k` patterns match integers, not byte
// error: this `match` does not cover every int value, such as `0`; add an arm for it, or `_` for the rest
// error: `None` is a variant; a comparison binds a name or `_`
// Comparison and `n + k` patterns: the types they match, their amounts, their binders, and a gap
// between bounds.

data Option
  Some(value: int)
  None

measure(x: real) -> int = x match
  x < 1.0 -> 0
  _ -> 1

zero(n: int) -> int = n match
  m + 0 -> m
  _ -> 0

octet(b: byte) -> int = b match
  c + 1 -> 1
  _ -> 0

gap(n: int) -> int = n match
  n < 0 -> -1
  n > 0 -> 1

variant(n: int) -> int = n match
  None < 3 -> 0
  _ -> 1

main() -> int = 0
