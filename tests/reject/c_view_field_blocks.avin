// A `ByteBlock` is memory Avin gives C, so a field accessor neither lends one as a view nor reads one.
// error: the field accessor `lentBlock` answers `ByteBlock` and lends the memory its field points at: a `ByteBlock` is memory Avin gives C; the memory a binding lends is a `ByteView`, or with `writable` a `MutByteView`
// error: the field accessor `readBlock` answers `ByteBlock`: a `ByteBlock` is memory Avin gives C, made by `ByteBlock(length)`, never read from a field
import avin.c.ByteBlock

@c(type: "struct face *", release: "free")
class Face
    @c(field: "buffer", view, length: "4")
    lentBlock() -> ByteBlock

    @c(field: "buffer")
    readBlock() -> ByteBlock

main() = 0
