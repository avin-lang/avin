// `@threaded`, `@sendable` and `@isolated` take no arguments, and no other annotation is a function
// parameter's.
// error: a function's parameter takes no annotation but `@sendable`, `@isolating` or `@isolated`; a data field or a class parameter does, and a Sysl binding's parameter taking a function may be `@threaded`
// error: a function's parameter takes no annotation but `@sendable`, `@isolating` or `@isolated`; a data field or a class parameter does, and a Sysl binding's parameter taking a function may be `@threaded`
// error: a function's parameter takes no annotation but `@sendable`, `@isolating` or `@isolated`; a data field or a class parameter does, and a Sysl binding's parameter taking a function may be `@threaded`

@sysl("avintest.callbacks.apply")
withArgument(@threaded(always) f: (int) -> int)

other(@Key("x") n: int) = ()

marked(@sendable(now) f: () -> int) = f()

main() = ()
