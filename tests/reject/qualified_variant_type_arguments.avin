// error: `Leaf` takes 1 type argument, not 2
// error: cannot infer `B` for this `Neither`; write it, as in `Neither[int, int]`
// error: a variant's type arguments are written once, on its type or on the variant
// error: `Heap.Node` has fields; call it, as in `Heap.Node(arguments)`
// error: expected int, found string
// A variant's type arguments are written once, on its type or on the variant, and as many as the type
// has parameters; a variant with fields written with them is still called.

data Heap[T]
  Leaf
  Node(value: T, left: Heap[T], right: Heap[T])

data Pair[A, B]
  Neither
  Both(a: A, b: B)

main()
  println(Heap.Leaf[int, string])
  println(Pair.Neither[int])
  println(Heap[int].Leaf[int])
  println(Heap.Node[int])
  println(Pair.Both[int, string]("one", "two"))
