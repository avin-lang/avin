// error: `Entry` does not conform to `Sendable`, the bound of `T` in `send`: its field `log` holds a `Log`, whose field `count` is a `var`; make it a `val`
// error: `Base` does not conform to `Sendable`, the bound of `T` in `send`: it is `open`, so a subclass could add a `var`; make it final, or declare it `: Sendable`, and every subclass is checked to be sendable
// error: `Animal` does not conform to `Sendable`, the bound of `T` in `send`: it is `abstract`, so a subclass could add a `var`
// error: `Holder` does not conform to `Sendable`, the bound of `T` in `send`: its field `f` holds a `(int) -> int`, which is a function value, whose type does not say what it captures
// error: `Plain` does not conform to `Sendable`, the bound of `T` in `send`: it is a trait that does not promise to be sendable; declare it `trait Plain: Sendable`, and every type implementing it is checked to be
// Classes that are not sendable, each with the part the error names: a `var` field in a class a
// data type holds, an `open` class, an `abstract` one, a function value in a field and a trait that
// makes no promise.
class Log
  var count = 0

data Entry(log: Log)

open class Base(val n: int)

abstract class Animal
  name() -> string

class Cat: Animal
  override name() -> string = "cat"

class Holder(val f: (int) -> int)

trait Plain
  name() -> string

class Named: Plain
  override name() -> string = "named"

send[T: Sendable](value: T) -> string = "sent"

main()
  println(send(Entry(Log())))
  println(send(Base(1)))
  val animal: Animal = Cat()
  println(send(animal))
  println(send(Holder(x -> x)))
  val plain: Plain = Named()
  println(send(plain))
