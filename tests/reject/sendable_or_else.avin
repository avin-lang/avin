// error: what is passed for `f` of `pick` may use only sendable values from around it, but it uses `g`, a `PartialFunction[char, int]`, which is a trait that does not promise to be sendable; declare it `trait PartialFunction: Sendable`, and every type implementing it is checked to be; or mark the parameter `@sendable`, and what is passed for it is checked in turn
// error: what is passed for `f` of `pick` is sendable inside it, so it is a `match` function written in place, a value of a sendable type, a parameter marked `@sendable` or a combination of them such as `f.orElse(g)`, but it is a `PartialFunction[char, int]`, which is a trait that does not promise to be sendable; declare it `trait PartialFunction: Sendable`, and every type implementing it is checked to be
// `orElse` of two sendable partial functions is sendable, and no other combination is: a local
// partial function as the argument or as the receiver, the combination held in a local and passed
// later, an unmarked parameter, and a function of the program's own that only passes its marked
// arguments back, which nothing promises is all it does.
data Rule[T](run: @sendable (char) -> Option[T])
pick[U](@sendable f: PartialFunction[char, U]) -> Rule[U] = Rule(c -> if f.isDefinedAt(c) then Some(f(c)) else None)

local(@sendable f: PartialFunction[char, int]) -> Rule[int] =
  val pf: PartialFunction[char, int] = match 'z' -> 26
  pick(f.orElse(pf))

receiver(@sendable f: PartialFunction[char, int]) -> Rule[int] =
  val pf: PartialFunction[char, int] = match 'z' -> 26
  pick(pf.orElse(f))

held(@sendable f: PartialFunction[char, int], @sendable g: PartialFunction[char, int]) -> Rule[int] =
  val h = f.orElse(g)
  pick(h)

unmarked(@sendable f: PartialFunction[char, int], g: PartialFunction[char, int]) -> Rule[int] = pick(f.orElse(g))
first(a: PartialFunction[char, int], b: PartialFunction[char, int]) -> PartialFunction[char, int] = a
own(@sendable f: PartialFunction[char, int], @sendable g: PartialFunction[char, int]) -> Rule[int] = pick(first(f, g))
main() = ()
