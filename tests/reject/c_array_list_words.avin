// A list of arrays is of strings, none empty; a list's `free:` for an array C fills is empty, as the
// binding frees it; and `free:` is a list only beside a list of arrays.
// error: `array:` names its arrays as a list of strings, none empty, as in `array: ["glyphs", "clusters"]`
// error: out value 1 of the C binding `emptyName`, `a`, is `Array[real]` in Avin and `double *` in C: an array C answers through `a` is named with `array:`
// error: out value 2 of the C binding `filledFreed`, `b`, is `Array[real]` in Avin and `double` in C: the binding makes the array C fills through `b`, and frees it once copied
// error: `free:` is a list only where `array:` names a list of arrays, one for each

@c("void e(out double **a, out int *na)", array: ["a", ""])
emptyName() -> (Array[real], int)

@c("void f(int n, out double *a, out double *b)", array: ["a", "b"], length: ["n", "n"], free: ["", "free"])
filledFreed(n: int) -> (Array[real], Array[real])

@c("void g(out double **a, out int *na)", array: "a", length: "na", free: ["free"])
freeList() -> (Array[real], int)

main() = 0
