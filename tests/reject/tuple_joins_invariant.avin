// error: expected (Array[Dog], long), found (Array[Cat], long)
// error: expected Option[(Buffer[Dog], long)], found Option[(Buffer[Cat], long)]
// error: expected (Dog, long), found (Cat, int)
// error: expected (Dog, long), found (Cat, long, long)
// error: the branches of this `if` yield (Array[Dog], long) and (Array[Cat], long)

// A tuple's parts join only where the parts do: an invariant `Array` or `Buffer` part keeps its
// element type, value parts of different types have none, and tuples of different sizes are
// different types, so each of these is an error.

open class Animal(val name: string)
class Dog(n: string) : Animal(n)
class Cat(n: string) : Animal(n)

same[T](a: T, b: T) -> T = b

main(args: Vector[string])
    val x: long = 7
    val ad: Array[Dog] = [Dog("d")]
    val ac: Array[Cat] = [Cat("c")]
    val bd: Buffer[Dog] = [Dog("d")]
    val bc: Buffer[Cat] = [Cat("c")]
    val a = same((ad, x), (ac, x))
    val b = same(Some((bd, x)), Some((bc, x)))
    val i: int = 1
    val c = same((Dog("d"), x), (Cat("c"), i))
    val d = same((Dog("d"), x), (Cat("c"), x, x))
    val e = if args.size() > 0 then (ad, x) else (ac, x)
