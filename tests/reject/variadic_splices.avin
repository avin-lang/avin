// error: `*` after an argument passes a sequence as a repeated parameter's arguments; it is written only as the last argument of a call to a function with one
// error: `*` passes a sequence to a repeated parameter, but this argument of `one` is given to no parameter
// error: `labelled` takes at least 1 argument, not 0
// error: a spliced sequence is the only argument of the repeated parameter `values`; write the other elements into the sequence
total(values: int*) -> int = values.length()

one(n: int) -> int = n

labelled(label: string, values: int*) -> int = values.length()

main()
    val v = [1, 2]
    // A function value takes the vector itself, so nothing is spliced into it.
    val f: (Vector[int]) -> int = total
    f(v*)
    one(1, v*)
    labelled()
    total(v*, 1)
