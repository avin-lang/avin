// error: a value of type (int) -> int is never a (string) -> int, so this type pattern never matches
// error: a value of type (Dog) -> Animal is never a (Dog) -> int, so this type pattern never matches
// error: a value of type (int) -> int is never a Dog, so this type pattern never matches
// error: a value of type Box[(int) -> int] is never a Box[(string) -> int], so this type pattern never matches
// error: a value of type ((int) -> int, int) is never a ((string) -> int, int), so this type pattern never matches
// A type pattern on a function type that the value matched can never meet is an error: parameters
// or results of different types, a value type where the pattern needs a reference, a final class that
// is no function, an invariant argument that differs, and a tuple whose function part never matches.

open class Animal(val name: string)

class Dog(name: string) : Animal(name)

class Box[T](val item: T)

params(f: (int) -> int) -> int = f match
    _: ((string) -> int) -> 1
    _ -> 0

results(f: (Dog) -> Animal) -> int = f match
    _: ((Dog) -> int) -> 1
    _ -> 0

notAClass(f: (int) -> int) -> int = f match
    _: Dog -> 1
    _ -> 0

invariant(b: Box[(int) -> int]) -> int = b match
    _: Box[(string) -> int] -> 1
    _ -> 0

parts(t: ((int) -> int, int)) -> int = t match
    _: ((string) -> int, int) -> 1
    _ -> 0

main() -> int = 0
