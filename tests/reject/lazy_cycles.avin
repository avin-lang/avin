// error: the `lazy val` `itself` needs its own value to initialize: `itself` → `itself`
// error: the `lazy val` `first` needs its own value to initialize: `first` → `second` → `first`
// error: the `lazy val` `counted` needs its own value to initialize: `counted` → `counted`
// error: the `lazy val` `viaTrait` needs its own value to initialize: `viaTrait` → `viaTrait`
// error: the `lazy val` `sum` needs its own value to initialize: `sum` → `sum`
// A module-level `lazy val` whose initializer's own code reads the value would read it while it is
// being initialized, so it is refused: directly, through another lazy value, through a function it
// calls, through a trait's implementation a call may reach, and through an operator's method.
lazy val itself: int = itself + 1

lazy val first: int = second + 1

lazy val second: int = first * 2

lazy val counted: int = count()

count() -> int = counted + 1

trait Shape
  area() -> int

class Square: Shape
  override area() -> int = viaTrait + 1

shape() -> Shape = Square()

lazy val viaTrait: int = shape().area()

data Coin(cents: int)

impl Add for Coin
  add(other: Coin) -> Coin = Coin(cents + other.cents + sum.cents)
  static zero() -> Coin = Coin(0)

lazy val sum: Coin = Coin(1) + Coin(2)

main() = ()
