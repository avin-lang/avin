// error: this arm is never reached: the arm `_` on line 11 already matches every value it would
// error: this arm is never reached: the arm `int` on line 15 already matches every value it would
// error: this `match` does not cover every `int | string` value, such as `_: string`
// error: a value of type int is never a string, so this type pattern never matches
// error: `bool` is no member of `int | string`, so this pattern can never match
// A built-in type's name as a pattern is a type pattern, and coverage and reachability treat it as
// one: an arm after `_` or after the same type is never reached, a union needs every member, and a
// type no value can have is an error.

late(x: Any) -> string = x match
  _ -> "any"
  int -> "int"

twice(v: int | string) -> string = v match
  int -> "int"
  int -> "again"
  string -> "string"

partial(v: int | string) -> string = v match
  int -> "int"

never(n: int) -> bool = n is string

member(v: int | string) -> bool = v is bool

main() = 0
