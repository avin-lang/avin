// error: `TwoReceives` has one `receive` block, holding the arms every state shares
// error: state `S` has one `leave` block
// error: `Dup` declares the state `S` more than once
// A machine has one shared `receive` block, a state one `leave` block, and each state one name.
data Ev
    A

machine TwoReceives receives Ev
    state S
        A -> stay
    receive
        _ -> stay
    receive
        _ -> stay

machine TwoLeaves receives Ev
    state S
        leave
            println("a")
        leave
            println("b")
        A -> stay

machine Dup receives Ev
    state S
        A -> stay
    state S
        A -> stay

main() -> int = 0
