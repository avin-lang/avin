// The mutable collections, an array and a lazy list read their accessors without parentheses too.
// error: `length` takes no parameter list, so it is called without parentheses: write `length`, not `length()`
// error: `values` takes no parameter list, so it is called without parentheses: write `values`, not `values()`
// error: `last` takes no parameter list, so it is called without parentheses: write `last`, not `last()`
// error: `nonEmpty` takes no parameter list, so it is called without parentheses: write `nonEmpty`, not `nonEmpty()`
// error: `headOption` takes no parameter list, so it is called without parentheses: write `headOption`, not `headOption()`

import avin.collections.mutable

main()
  println(Buffer.from([1]).length())
  println(mutable.Map[string, int]().values())
  println(mutable.TreeSet.from([1]).last())
  println(Array.fill(2, 0).nonEmpty())
  println(LazyList.iterate(0, x -> x + 1).headOption())
