// error: `_` leaves a type argument open, making a constructor, so it is written only where a constructor is taken, as in `Result[_, E]` for a parameter `F[_]`
// error: `Vector[int]` is a type; `F[_]` takes a constructor of one argument, such as `Option`
// error: `Sorted` bounds its parameter `A`, and `F` may be applied to any type, so `Sorted` is no constructor for `F[_]`
// error: `_` alone names no type; `F[_]` takes a constructor of one argument, such as `Option`, named bare or with the arguments it leaves open written `_`
// error: `_` leaves a type argument open, making a constructor, so it is written only where a constructor is taken, as in `Result[_, E]` for a parameter `F[_]`
// A `_` is written only as a direct argument where a constructor is taken; an alias of a full type
// is no constructor; a type whose parameter is bounded other than by `Eq` or `Hash` is none for an
// unbounded hole; `_` alone is no constructor; and `_` is no argument for a type parameter.
type Ints = Vector[int]

data Sorted[A: Ord](items: Vector[A])

same[F[_], A](x: F[A]) -> F[A] = x
id[A](x: A) -> A = x

nested(x: Vector[Option[_]]) -> int = 0

main()
  println(same[Ints, int]([1]))
  println(same[Sorted, int](Sorted([1])))
  println(same[_, int](3))
  println(id[_](3))
