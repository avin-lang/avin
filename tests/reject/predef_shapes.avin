// error: `swap` is for a pair; this is `(int, int, int)`
// error: `andThen` is for a function of 1 parameter; this is `(int, int) -> int`
// error: `tupled` is for a function of 2 parameters; this is `(int) -> int`
// error: `compose` is for a function of 1 parameter; this is `() -> int`
// error: int has no field `swap`
// A method added to pairs or to functions of one shape, called on a tuple or a function of another,
// says what the receiver would need to be; a value that is neither has no such method.
main()
  println((1, 2, 3).swap())
  val add = (a: int, b: int) -> a + b
  println(add.andThen((n: int) -> n)(1, 2))
  println(((x: int) -> x).tupled())
  val make: () -> int = () -> 1
  println(make.compose((n: int) -> n))
  println(3.swap())
