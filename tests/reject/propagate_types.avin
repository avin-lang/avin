// error: `?` on Option[int] returns `None` from `plain`, which yields int, not an Option
// error: `?` passes on an error of string, but `mismatched` yields errors of int; convert it first with `mapErr`
// error: `?` takes apart an Option or a Result, not int
// error: `?` on Option[int] returns `None` from `optionInResult`, which yields Result[int, string], not an Option
// error: `?` on Result[int, string] returns the `Err` from `resultInOption`, which yields Option[int], not a Result
// `?` needs an `Option` or a `Result`, inside a function yielding the same kind, whose error type the
// failure's conforms to.

half(n: int) -> Option[int] = if n % 2 == 0 then Some(n / 2) else None

parse(s: string) -> Result[int, string] = Ok(1)

plain(n: int) -> int = half(n)? + 1

mismatched(s: string) -> Result[int, int] = Ok(parse(s)?)

onInt(n: int) -> Option[int] = Some(n?)

optionInResult(n: int) -> Result[int, string] = Ok(half(n)?)

resultInOption(s: string) -> Option[int] = Some(parse(s)?)

main() = ()
