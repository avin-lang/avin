// `named` is written once and alone after the Sysl function's name, and a `named` binding names
// every parameter, since each argument is passed by its parameter's name.
// error: `@sysl` takes `named` once
// error: `named` is written alone, after the Sysl function's name: `@sysl("sysl.net.accept", named)`
// error: a `named` binding passes each argument by its parameter's name, so every parameter has one
// error: `@sysl` takes the Sysl function's module and name, and after it only `blocking`, for a call that may wait, and `named`, for arguments passed by name: `@sysl("sysl.net.accept", blocking)`

@sysl("sysl.text.to_upper", named, named)
upperTwice(s: string) -> string

@sysl("sysl.text.to_upper", named: true)
upperValued(s: string) -> string

@sysl("sysl.text.to_upper", named)
upperUnnamed(_: string) -> string

@sysl("sysl.text.to_upper", byName)
upperOtherWord(s: string) -> string

main()
  println(upperTwice("a"))
  println(upperValued("a"))
  println(upperUnnamed("a"))
  println(upperOtherWord("a"))
