// error: a method takes no `open`: every public method of an `open` or `abstract` class, and every method of a trait, may be overridden already; remove `open`
// error: a method takes no `abstract`: one declared without a body, `name() -> T`, is abstract already, which only an `abstract` class or a trait allows; remove `abstract`
// error: a field cannot be overridden, so it takes no `open`: remove it
// error: a field takes no `abstract`: one declared without a value, `val name: T`, is abstract already; remove `abstract`
// error: a method takes no `open`: every public method of an `open` or `abstract` class, and every method of a trait, may be overridden already; remove `open`
// `open` and `abstract` mark a class, never a member: each misplaced word is one error, after
// `override` as well as before it, and the member then parses as written, so its
// result type and the override below it report nothing.

open class Animal
    open sound() -> string = "..."
    open val legs: int = 4

abstract class Shape
    abstract area() -> int
    abstract val sides: int

class Dog : Animal
    override open sound() -> string = "woof"

main() = ()
