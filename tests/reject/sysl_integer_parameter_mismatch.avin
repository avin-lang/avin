// An integer parameter goes into whatever integer the Sysl parameter is, and only into an integer:
// a Sysl parameter of any other type rejects the binding, naming the parameter by its place.
// error: the Sysl binding `digitCode` does not match `sysl.unicode.is_digit`: parameter 1 is an integer, which goes into Sysl only as an integer, but the Sysl parameter is char
// error: the Sysl binding `joinNumber` does not match `sysl.path.join`: parameter 2 is an integer, which goes into Sysl only as an integer, but the Sysl parameter is string
// error: the Sysl binding `repeatSmall` does not match `sysl.text.repeat`: parameter 1 is an integer, which goes into Sysl only as an integer, but the Sysl parameter is string

@sysl("sysl.unicode.is_digit")
digitCode(c: int) -> bool

@sysl("sysl.path.join")
joinNumber(a: string, b: long) -> string

// The second parameter, a `usize`, takes the `int`; the first does not.
@sysl("sysl.text.repeat")
repeatSmall(s: i16, n: int) -> string

main() = 0
