// A clause no argument can reach is an error, as an arm is, in a function and in a local function;
// a body after one with no guard is never tried. A name spelled as a variant binds here too.
data Light
  Red
  Green

describe(n: int) -> string
describe(_) = "any"
describe(0) = "zero"

combine(a: bool, b: bool) -> int
combine(true, _) = 1
combine(_, true) = 2
combine(false, false) = 3
combine(false, true) = 4

lit(l: Light) -> int
lit(Amber) = 1
lit(Red) = 2

guarded(n: int) -> int

guarded(n)
  | n > 0 = 1
  | _ = 0
  | n < 0 = -1

main()
  local(n: int) -> int
  local(n) = n
  local(1) = 1
  println(local(2))
