// error: `Vector.flatMap[T, U](f: (T) -> Option[U])`; the function given is (int) -> int
// error: `Option.flatMap[T, U](f: (T) -> Iterable[U])`; the function given is (int) -> int
// error: the function given is ((string, int)) -> int
// error: `+` joins two strings, not a string and int
// error: no overload of `map` accepts these arguments
// A function whose result no overload takes is still refused: `flatMap` needs a collection or an
// option from it, and a map's `map` checks its function's body whichever result it makes.
main()
  val m: Map[string, int] = {"a": 1}
  val xs = [1, 2]
  val o: Option[int] = Some(1)
  println(xs.flatMap(x -> x + 1))
  println(o.flatMap(x -> x + 1))
  println(m.flatMap(e -> e.1))
  println(m.map((k, v) -> k + v))
  println(m.map((k, v, w) -> k))
