// error: expected Box[A, _], found Box[B, int]
// error: expected Cell[B, _], found Cell[A, int]
// error: expected (A) -> _, found (B) -> int
// error: expected Box[A, int], found Box[B, int]
// A contravariant argument takes a supertype of the parameter's, never a subtype: a box taking only
// `B`s is no box taking any `A`, nor is a function of `B`s one of `A`s. An invariant argument takes
// the parameter's type alone, a supertype included. A type argument an earlier argument widened to
// `A` is no `B`, which is all a box of `B`s takes.
open class A(val tag: string)
class B: A("b")

class Box[-I, +T](val f: (I) -> T)

class Cell[I, +T](val f: (I) -> T)

takeA[T](b: Box[A, T]) -> T = b.f(B())

takeCell[T](c: Cell[B, T]) -> T = c.f(B())

applyA[T](f: (A) -> T) -> T = f(B())

feed[T](x: T, b: Box[T, int]) -> int = b.f(x)

main()
  val onlyB: Box[B, int] = Box(b -> 1)
  println(takeA(onlyB))
  val cell: Cell[A, int] = Cell(a -> 2)
  println(takeCell(cell))
  val g: (B) -> int = b -> 3
  println(applyA(g))
  println(feed(A("a"), onlyB))
