// error: expected (string) -> Option[string], found (string) -> Option[long]
// error: this lambda yields Option[int], not Option[real]
// error: integer literal does not fit in i8
// error: this lambda yields string, not long
// error: this lambda yields Option[long], not Option[bool]

// A lambda's result decides a literal beside it only where the literal fits what it decides: a
// string or a real has a type of its own, which is checked first and conflicts with the lambda's; a
// number literal too wide for the type a lambda decides does not fit it; and two lambdas yielding
// different types conflict at the second.

pick[T](text: string, read: (string) -> Option[T], absent: T) -> T = read(text) match
  Some(v) -> v
  None -> absent

both[T](first: (string) -> T, second: (string) -> T, absent: T) -> T = absent

main()
  val a = pick("x", s -> s.toLongOption(), "none")
  val b = pick("x", s -> s.toIntOption(), 1.5)
  val c = pick("x", s -> Some(i8(1)), 300)
  val d = both(s -> long(1), s -> "x", 0)
  val e = pick("x", s -> s.toLongOption(), 0 == 0)
