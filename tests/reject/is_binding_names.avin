// error: `v` is already defined in this block
// error: `h` is bound by an `is` test, and is in scope only where that test is known to hold
// A condition binds a name once, though its names may shadow the enclosing block's.

twice(a: Option[int], b: Option[int]) -> int
    if a is Some(v) && b is Some(v) then v else 0

shadows(a: Option[int]) -> int
    val v = 1
    if a is Some(v) then v else 0

// The test of `do … while` comes after the body, so its names are in scope nowhere.
tested(xs: List[int]) -> int
    var rest = xs
    do rest = rest.drop(1) while rest is h :: _
    h

main() -> int = 0
