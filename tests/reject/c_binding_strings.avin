// A C string crosses as a `string` into a `const char *`, and out of either pointer to `char` as a
// `string` or an `Array[byte]`, each perhaps in an `Option`. C may write through a `char *`
// parameter, and an `Array[byte]` parameter is an array, so neither takes these; a string where the
// prototype says `int`, or a pointer other than to `char`, is refused, as is any other Avin type
// for a C string.
// error: parameter 1 of the C binding `fill` is `string` in Avin and `char *` in C: C may write through a `char *`, so it takes an array rather than a `string`, and arrays are not implemented
// error: parameter 1 of the C binding `measure` is `Array[byte]` in Avin and `const char *` in C: an `Array[byte]` parameter is an array, and arrays are not implemented
// error: parameter 1 of the C binding `asInt` is `string` in Avin and `int` in C: a string crosses as a C `const char *`
// error: the result of the C binding `fromInt` is `Option[string]` in Avin and `int` in C: a string crosses as a C `const char *` or `char *`
// error: the result of the C binding `unsignedText` is `string` in Avin and `const unsigned char *` in C: a string crosses as a C `const char *` or `char *`

@c("char *strcpy(char *to, const char *from)")
fill(to: string, from: string) -> string

@c("size_t strlen(const char *s)")
measure(s: Array[byte]) -> long

@c("int abs(int)")
asInt(n: string) -> int

@c("int abs(int)")
fromInt(n: int) -> Option[string]

@c("const unsigned char *fixture_unsigned(void)")
unsignedText() -> string

main() = 0
