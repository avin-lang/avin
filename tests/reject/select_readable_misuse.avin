// error: a readable arm binds nothing, so it has no `as` pattern; its body reads the stream
// error: a select arm is a channel's `receive()` or `send(x)`, a stream's `readable()`, `after` a duration, or `else`
// error: a select arm is a channel's `receive()` or `send(x)`, a stream's `readable()`, `after` a duration, or `else`
// A `readable()` arm binds nothing, so an `as` pattern is an error, and `readable` with an argument,
// or called with a block, is no arm at all.
import avin.net.TcpStream

f(c: TcpStream)
  select
    c.readable() as x -> ()
  select
    c.readable(1) -> ()
  select
    c.readable(x = 1) -> ()

main() = ()
