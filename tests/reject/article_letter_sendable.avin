// error: what is passed for `f` of `pick` is sendable inside it, so it is a `match` function written in place, a value of a sendable type, a parameter marked `@sendable` or a combination of them such as `f.orElse(g)`, but it is an `M`, whose field `n` is a `var`; make it a `val`
// error: what is passed for `f` of `pick` is sendable inside it, so it is a `match` function written in place, a value of a sendable type, a parameter marked `@sendable` or a combination of them such as `f.orElse(g)`, but it is a `T`, whose field `n` is a `var`; make it a `val`
// The article before a type a sendability diagnostic names: `an M` and `a T`, each read as its
// letter.

class M(var n: int): PartialFunction[char, int]
  override isDefinedAt(c: char) -> bool = true
  override lift() -> char -> Option[int] = c -> Some(n)

class T(var n: int): PartialFunction[char, int]
  override isDefinedAt(c: char) -> bool = true
  override lift() -> char -> Option[int] = c -> Some(n)

pick[U](@sendable f: PartialFunction[char, U]) -> int = 0

main() =
  val a = pick(M(0))
  val b = pick(T(0))
