// error: `total` is a `lazy val`, computed once on its first read, which cannot be assigned
// error: `label` is a `val` field; only a `var` field can be assigned
// error: the `lazy val` `label`, whose initializer may use `self`, is read before `size` is initialized
// error: the `lazy val` `name` may use `self`, so it cannot be read in the body of an open class
// error: `eager` is needed by its own initializer, directly or through the functions it calls
// A `lazy val` is never assigned. Its first read runs its initializer, which may use `self` as a
// method does, so a class body reads it only once every field is initialized, and an open class's
// body not at all. An eager value whose initializer reads a lazy one needs what that lazy value's
// initializer needs, itself included.
lazy val total: int = 1

class Tag()
    lazy val label: string = "tag"
    val copy = label
    val size: int = 2

open class Base()
    lazy val name: string = "base"
    println(name)

val eager: int = later + 1

lazy val later: int = eager

main() -> int
    total = 2
    val t = Tag()
    t.label = "other"
    0
