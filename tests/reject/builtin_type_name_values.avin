// error: `unit` is a built-in type, so it cannot name a field
// error: `string` is a built-in type, so it cannot name a parameter
// error: `int` is a built-in type, so it cannot name a value
// error: `bool` is a built-in type, so it cannot name a parameter
// error: `real` is a built-in type, so it cannot name a parameter
// A built-in type's name never names a value, since in a pattern it tests for the type: not a local,
// a parameter, a lambda's parameter or a field.

data Measure(unit: string)

scaled(string: int) -> int = string * 2

main()
  val int = 3
  val flags = [true, false].map(bool -> !bool)
  val add = (real: real, b: real) -> real + b
  println(int, flags, add(1.0, 2.0), scaled(1))
