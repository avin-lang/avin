// error: `A` is declared by `Unused` but named by none of its fields and not by its result
// error: `B` is declared by `Fieldless` but named by none of its fields and not by its result
// error: `T` is already a parameter of `Expr`, and stands for the same type in each of its variants
// error: the type parameter `A` is declared more than once
// error: variance is written on the parameters of a type, not on a variant's own: write `A` in `Marked`
// A variant's own type parameters are each named by a field or by its result, none reuses a name of
// its type's parameters or of another of its own, and none takes a variance. A parameter named by a
// field alone is hidden, and one named by the result alone is fixed by it: both are used.

data Expr[T]
  Unused[A](value: int) -> Expr[int]
  Fieldless[A, B] -> Expr[A]
  Again[T](value: T) -> Expr[T]
  Twice[A, A](value: A) -> Expr[A]
  Marked[+A](value: A) -> Expr[A]
  Hidden[A](value: A, show: (A) -> string) -> Expr[string]
  Fixed[A] -> Expr[Vector[A]]

main() = ()
