// error: `===` is undefined on Dog | int and Dog | int, which may hold values with no identity; compare with `==`, or give one side a class type
// error: `Msg` does not conform to `Sendable`, so the actor `Sink` cannot receive it: its field `v` holds a `Counter | int`, whose member is a `Counter`, whose field `n` is a `var`; make it a `val`
// `===` is defined on a union whose members are all classes or function types, and a union is
// sendable only where every member is.
import avin.actors.spawn

class Dog
class Counter(var n: int)

data Msg(v: Counter | int)

actor Sink receives Msg
  receive
    Msg(_) -> ()

main()
  val b: Dog | int = Dog()
  println(b === b)
