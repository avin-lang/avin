// error: `Ruler.measure` implements `Gauge.measure` for `Stick`, and their defaults differ; a method can take the defaults of only one
// error: `Plain.measure` implements `Gauge.measure` for `Rod`, which has defaults `Plain.measure` lacks; implement `measure` in an impl to take them
trait Gauge
  measure(by: int = 5) -> int

// A trait's default body that a data type inherits, and that implements another trait's method,
// keeps its own defaults, which must be that method's.
trait Ruler
  measure(by: int = 4) -> int = by

data Stick(length: int)

impl Ruler for Stick
impl Gauge for Stick

trait Plain
  measure(by: int) -> int = by

data Rod(length: int)

impl Plain for Rod
impl Gauge for Rod

main()
  println("unreachable")
