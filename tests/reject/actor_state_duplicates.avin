// error: `Sole` declares the state `S` more than once
// error: `Named` declares the state `State` more than once
// error: `Among` declares the state `B` more than once
// A repeated state name in an actor is one error: as its only state, named `State`, or among others.
data Msg
    A

actor Sole receives Msg
    state S
        A -> stay
    state S
        A -> stay

actor Named receives Msg
    state State
        A -> stay
    state State
        A -> stay

actor Among receives Msg
    state First
        A -> stay
    state B(x: int)
        A -> stay
    state B(x: int)
        A -> stay

main() -> int = 0
