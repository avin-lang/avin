// The empty-list rule reaches every shape of a method value: an argument whose parameter is a type
// parameter or `Any`, an overload of no parameters with no expected function type (the call is the
// likelier intent than an ambiguous value), a bare name inside the class, and a trait method through
// the trait.
// error: `bump` is called with `()`: write `c.bump()`, or `() -> c.bump()` for a function value
// error: `peek` is called with `()`: write `c.peek()`, or `() -> c.peek()` for a function value
// error: `over` is called with `()`: write `c.over()`, or `() -> c.over()` for a function value
// error: `bump` is called with `()`: write `bump()`, or `() -> bump()` for a function value
// error: `name` is called with `()`: write `named.name()`, or `() -> named.name()` for a function value

trait Named
    name() -> string

class Counter(var n: int)
    bump() -> int = n
    peek() -> int = n
    over() -> int = n
    over(k: int) -> int = n + k
    positive() -> bool = bump > 0

id[T](x: T) -> T = x
show(x: Any) = println(x)
greet(named: Named) = println(s"${named.name}")

main()
    val c = Counter(0)
    id(c.bump)
    show(c.peek)
    println(c.over)
