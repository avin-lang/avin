// The empty-list rule reaches every shape of a method value: an argument whose parameter is a type
// parameter or `Any`, an overload of no parameters with no expected function type (the call is the
// likelier intent than an ambiguous value), a bare name inside the class, and a trait method through
// the trait.
// error: `bump` is declared with an empty parameter list, so naming it without a call makes a function value, which is allowed only where a function type is expected: call it, as in `x.bump()`, or for a function write a lambda, as in `() -> x.bump()`
// error: `peek` is declared with an empty parameter list, so naming it without a call makes a function value, which is allowed only where a function type is expected: call it, as in `x.peek()`, or for a function write a lambda, as in `() -> x.peek()`
// error: `over` is declared with an empty parameter list, so naming it without a call makes a function value, which is allowed only where a function type is expected: call it, as in `x.over()`, or for a function write a lambda, as in `() -> x.over()`
// error: `bump` is declared with an empty parameter list, so naming it without a call makes a function value, which is allowed only where a function type is expected: call it, as in `bump()`, or for a function write a lambda, as in `() -> bump()`
// error: `name` is declared with an empty parameter list, so naming it without a call makes a function value, which is allowed only where a function type is expected: call it, as in `x.name()`, or for a function write a lambda, as in `() -> x.name()`

trait Named
    name() -> string

class Counter(var n: int)
    bump() -> int = n
    peek() -> int = n
    over() -> int = n
    over(k: int) -> int = n + k
    positive() -> bool = bump > 0

id[T](x: T) -> T = x
show(x: Any) = println(x)
greet(named: Named) = println(s"${named.name}")

main()
    val c = Counter(0)
    id(c.bump)
    show(c.peek)
    println(c.over)
