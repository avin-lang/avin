// error: `int` is a built-in type, so a pattern cannot bind it: alone it tests for the type, and `n: int` binds the value as one
// error: `string` is a built-in type, so a pattern cannot bind it: alone it tests for the type, and `n: string` binds the value as one
// error: `long` is a built-in type, so a pattern cannot bind it: alone it tests for the type, and `n: long` binds the value as one
// error: `char` is a built-in type, so a pattern cannot bind it: alone it tests for the type, and `n: char` binds the value as one
// error: `i8` is a built-in type, so a pattern cannot bind it: alone it tests for the type, and `n: i8` binds the value as one
// A built-in type's name in a pattern is a type pattern, so it cannot stand where a pattern binds a
// name: before `:`, before `@`, in `n + k`, in a comparison pattern, or as the rest of a sequence.

typed(x: Any) -> string = x match
  int: int -> "int"
  _ -> "other"

named(o: Option[string]) -> string = o match
  string @ Some(_) -> "some"
  _ -> "none"

successor(n: long) -> long = n match
  long + 1 -> 1
  _ -> 0

compared(c: char) -> bool = c match
  'a' <= char <= 'z' -> true
  _ -> false

rest(xs: Vector[i8]) -> int = xs match
  [_, i8*] -> 1
  _ -> 0

main() = 0
