// error: a variant's own type parameters stand for types, not type constructors: `G` of `V` takes type arguments; declare a constructor parameter on the type, as in `data D[G[_]]`
// error: a variant fixes no constructor parameter: `W` makes `D[Vector, T]`, and `F` of `D` is a constructor parameter, so its place holds `F`
// error: `F[A]` in the result of `X` is no type a `match` can take apart: the result's arguments are built of data types, classes, tuples and function types
// error: a variant fixes no constructor parameter: `Z` makes `D[Option, int]`, and `F` of `D` is a constructor parameter, so its place holds `F`
// A refined variant meets constructor parameters only where they keep their place: its own
// parameters are types, its result fixes no constructor parameter of its type, and no argument of
// its result applies one. `Y` keeps `F` and fixes `T`, which is allowed.

data D[F[_], T]
  Plain(x: F[T])
  V[G[_]](x: G[int]) -> D[F, int]
  W(x: Vector[T]) -> D[Vector, T]
  X[A](x: F[A]) -> D[F, F[A]]
  Y(x: F[int]) -> D[F, int]
  Z(n: int) -> D[Option, int]

main()
  println(1)
