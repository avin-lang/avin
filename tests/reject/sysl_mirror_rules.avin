// A data type declared with `@sysl` mirrors one Sysl enum or struct, which it names by its module
// and name, and it has no type parameters. No other annotation is given to a data type.
// error: `@sysl` on a data type takes one string, the module and name of the Sysl enum or struct it mirrors, as in `@sysl("sysl.fs.IoError")`
// error: `@sysl` on a data type names a Sysl enum or struct by its module and name, as in `sysl.fs.IoError`; `IoError` is not one
// error: a Sysl mirror has no type parameters: it mirrors one Sysl type
// error: unknown annotation `@native`

@sysl(42)
data NoTarget
  A

@sysl("IoError")
data Unqualified
  B

@sysl("sysl.fs.Holder")
data Generic[T]
  Held(value: T)

@native
data Unknown
  C

main() = 0
