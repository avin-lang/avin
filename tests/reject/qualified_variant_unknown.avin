// error: `Color` has no variant `Purple`; its variants are `Red`, `Green` and `Blue`
// error: `Color` has no variant `Purple`; its variants are `Red`, `Green` and `Blue`
// error: `Point` has no variant `Origin`; its one variant is `Point`
// error: `Option` has no variant `Nothing`; its variants are `Some` and `None`
// error: `Account` is a class, not a data type, so it has no variant `Gold`
// `Type.Variant` names one of the type's own variants: a name that is none of them is reported with
// the ones it has, in a pattern as in an expression, for a one-variant type and a generic one; a
// class has no variants at all.

data Color
    Red
    Green
    Blue

data Point(x: int, y: int)

class Account(owner: string)

paint(c: Color) -> int = c match
    Color.Purple -> 1
    _ -> 0

main()
    println(Color.Purple)
    println(Point.Origin)
    println(Option.Nothing)
    println(Account.Gold)
