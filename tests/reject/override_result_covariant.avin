// error: `boxed` overrides `Base.boxed`, which yields (Any, int), not (int, int)
// error: `scalar` overrides `Base.scalar`, which yields Any, not int
// error: `stored` overrides `Base.stored`, which yields (Animal, Array[Animal]), not (Dog, Array[Dog])
// error: `wider` overrides `Base.wider`, which yields (Dog, int), not (Animal, int)
// error: `Cats.pair` implements `Litter.pair`, which yields (Dog, Dog), not (Animal, Dog)
// An override's result fits only where it is seen as the declared one with no conversion: a part
// that would need a box (a number for an `Any`), an invariant argument (an `Array`'s element) and a
// wider result are refused, for overrides and trait implementations alike.

open class Animal(val name: string)

class Dog(name: string): Animal(name)

open class Base
    boxed() -> (Any, int) = ("x", 0)
    scalar() -> Any = "x"
    stored() -> (Animal, Array[Animal]) = (Animal("x"), Array.empty())
    wider() -> (Dog, int) = (Dog("x"), 0)

class Derived: Base
    override boxed() -> (int, int) = (1, 2)
    override scalar() -> int = 3
    override stored() -> (Dog, Array[Dog]) = (Dog("x"), Array.empty())
    override wider() -> (Animal, int) = (Animal("x"), 0)

trait Litter
    pair() -> (Dog, Dog)

class Cats: Litter
    override pair() -> (Animal, Dog) = (Animal("c"), Dog("d"))

main()
    println(Derived().scalar())
