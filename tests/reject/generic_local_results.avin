// error: `early` is called before its declaration, so it needs a declared result type
// error: `spin` is recursive, so it needs a declared result type
// error: `wide` takes 1 type argument, not 2
// error: `int` does not conform to `Named`, the bound of `T` in `wide`
// error: `bool` does not conform to `Named`, the bound of `T` in `named`
trait Named
    name() -> string

named[T: Named](x: T) -> string = x.name()

// A generic local called before its declaration, or recursively, declares its result type.
main()
    print(early(1))
    early[T](x: T) = x
    spin[T](x: T) = spin(x)
    print(spin(2))
    // Written type arguments and bounds hold for a function value as for a call, a local's or a
    // top-level function's, written or taken from the expected type.
    wide[T: Named](x: T) -> string = x.name()
    val f = wide[int, int]
    val g = wide[int]
    val h: (bool) -> string = named
