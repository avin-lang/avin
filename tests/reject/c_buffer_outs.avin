// Memory lent through an out pointer is named with `view:`, an `out` pointer to a pointer to bytes,
// answered as a view; `bytes:` copies into an `Array[byte]`.
// error: `view:` names the `out` parameter C answers the memory it lends through, and `n` is no `out` parameter of the prototype
// error: out value 1 of the C binding `notView`, `buffer`, is `int` in Avin and `unsigned char *` in C: the memory a binding lends is a `ByteView`, or with `writable` a `MutByteView`, perhaps in an `Option` for null
// error: out value 1 of the C binding `notBytes`, `buffer`, is `Array[int]` in Avin and `int *` in C: `bytes:` copies the bytes C answers into an `Array[byte]`, or an `Option` of one for null; `array:` copies an array of any other element
// error: parameter 1 of the C binding `updated` is `ByteView` in Avin and `unsigned char * *` in C, `inout`: a view is memory C lends, never passed back to C; memory C reads, writes or keeps is a `ByteBlock`
// error: out value 1 of the C binding `updated`, `buffer`, is `ByteView` in Avin and `unsigned char *` in C: C lends the memory `buffer` points at, so it is `out`, not `inout`
import avin.c.ByteView

@c(type: "struct frame *", release: "free")
class Frame
  @c("int frame_size(struct frame *self, int n)", view: "n", length: "n")
  notOut(n: int) -> int

  @c("void frame_image(struct frame *self, out unsigned char **buffer)", view: "buffer", length: "4")
  notView() -> int

  @c("void frame_ints(struct frame *self, out int **buffer, out int *n)", bytes: "buffer", length: "n")
  notBytes() -> (Array[int], int)

  @c("void frame_image(struct frame *self, inout unsigned char **buffer)", view: "buffer", length: "4")
  updated(buffer: ByteView) -> ByteView

main() = 0
