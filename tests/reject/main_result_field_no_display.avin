// error: `main`'s error is shown by its `Display`, and `Wrapped`, the error `main` answers, does not implement `Display`
// A data type has `Display` without asking only where every field has one, so an error holding a
// class without `Display` is refused, and so is a `Result[int, E]` with it.
class Inner(n: int)

data Wrapped(inner: Inner, why: string)

main() -> Result[int, Wrapped] = Err(Wrapped(Inner(1), "no"))
