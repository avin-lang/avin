// error: `onlyInside` yields A, not B
// error: `nextClause` yields T, not int
// error: this arm yields int, but the arms before it yield T
// error: this arm yields int, but the arms before it yield T
// error: `inGuard` yields T, not int
// Each place an arm's facts could be taken further than they hold is refused: a `Same` matched makes
// `A` and `B` one type only in its arm; one clause's equalities do not hold in the next; a type
// pattern and a union that names a type parameter teach nothing; and a guard is the arm's, so what
// it tests is not known after the `match`.

data Same[A, B]
  Refl -> Same[A, A]

data Expr[T]
  IntLit(value: int) -> Expr[int]
  BoolLit(value: bool) -> Expr[bool]

data Token[T]
  Num(n: int) -> Token[int | string]
  Word(w: string) -> Token[int | string]

onlyInside[A, B](p: Same[A, B], x: A) -> B
  p match
    Refl -> println("same")
  x

nextClause[T](e: Expr[T], x: T) -> int
nextClause(IntLit(n), x) = x + n
nextClause(_, x) = x

typePattern[T](a: Any, x: T) -> int = a match
  e: Expr[int] -> x
  _ -> 0

throughUnion[T](t: Token[T | string], x: T) -> int = t match
  Num(n) -> x
  _ -> 0

inGuard[T](e: Expr[T], x: T) -> int
  val r = e match
    IntLit(n) if x + n > 0 -> 1
    _ -> 0
  x

main()
  println(nextClause(IntLit(1), 2))
