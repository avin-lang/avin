// A mirror of a Sysl type that does not exist, with several variants, one carrying a field, is
// reported once at the mirror, with none of the shim's names.
// error: the Sysl mirror `Missing` does not match `sysl.fs.NoSuchKind`: 'sysl.fs' declares no 'NoSuchKind'
// error: tests/reject/sysl_mirror_unknown_variants.avin:6:1

@sysl("sysl.fs.NoSuchKind")
data Missing
  Gone
  Lost
  Away(n: int)

@sysl("sysl.hint.black_box")
same(m: Missing) -> Missing

main()
  println(s"${same(Gone)}")
