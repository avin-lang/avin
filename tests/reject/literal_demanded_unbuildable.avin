// Where a `Range` is demanded of a literal, by a declared type, a parameter, a declared result or an
// ascription, the literal cannot build it: only a type merely suggested, by the other operand of a
// comparison or a sibling branch, leaves a literal its default `Vector`.

take(r: Range) -> int = r.length

made() -> Range = [1, 2]

main()
  val r: Range = [1, 2]
  println(take([3]))
  println((r == ([1, 2]: Range)))
