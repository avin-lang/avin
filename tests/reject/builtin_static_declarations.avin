// error: `shouted` is already a method of a value of `string`, so it cannot also be a static member of the type
// error: `ready` is already a static member of `int`, so it cannot also be a method of its values
// error: `string.wrap` is the language's own, and no static member can redefine it
// error: `int.MaxValue` is the language's own, and no static member can redefine it
// error: `blank` is static, so it needs a body: it belongs to `string` itself
// A built-in type's static member shares its name with no method of the type's values, in either
// order, nor with a member the language gives the type, and has a body.

impl string
    shouted() -> string = self + "!"
    static shouted(s: string) -> string = s + "!"
    static wrap(s: string) -> string = s
    static blank() -> string

impl int
    static ready() -> int = 1
    ready(extra: int) -> int = self + extra
    static MaxValue() -> int = 0

main() = ()
