// error: an actor names the type of the messages it receives: `actor Quiet receives Message`
// error: an actor handles its messages in a `receive` block: `Deaf` has none
// error: `Twice` has one `receive` block, holding the arms that handle its messages
// error: an actor's parameter is a value its behaviour carries to it, so it cannot be by-name
// An actor declaration names its message type after `receives`, holds one `receive` block, and
// takes parameters as a class does, so none is by-name.
actor Quiet
    receive
        _ -> ()

actor Deaf receives int
    val n = 1

actor Twice receives int
    receive
        _ -> ()
    receive
        _ -> ()

actor Lazy(x: -> int) receives int
    receive
        _ -> ()

main() = ()
