// error: a comma inside brackets ends the `match`, so this arm's body is one value; write a tuple in parentheses, `(a, b)`
// error: expected `)`
// A middle arm's comma list inside brackets is not a tuple: the comma ends the `match`.

pairUp(t: (int, int)) -> int = t.0

main()
  val n = 2
  println(pairUp(n match
    2 -> 1, 2
    _ -> (0, 0)))
