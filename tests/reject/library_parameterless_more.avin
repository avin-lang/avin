// error: `abs` takes no parameter list, so it is called without parentheses: write `abs`, not `abs()`
// error: `isNaN` takes no parameter list, so it is called without parentheses: write `isNaN`, not `isNaN()`
// error: `text` takes no parameter list, so it is called without parentheses: write `text`, not `text()`
// error: `values` takes no parameter list, so it is called without parentheses: write `values`, not `values()`
// error: `values` takes no parameter list, so it is called without parentheses: write `values`, not `values()`
// An integer's, a real's and a string writer's accessors, and an enumeration's static `values` on
// its type and through a type parameter, are parameterless, so `()` after them is refused.

data Light derives Enumerable
    On
    Off

every[T: Enumerable]() -> Vector[T] = T.values()

main()
    println((-3).abs())
    println(1.5.isNaN())
    println(StringWriter().text())
    println(Light.values())
    println(every[Light]())
