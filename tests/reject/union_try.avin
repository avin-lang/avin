// error: `?` cannot pass on a `NetError` from a function whose errors are `IoError | ParseError`: it is no member of the union, and no member implements `From[NetError]`
// error: `?` cannot choose which member of `A | B` an error of `IoError` becomes: `A` and `B` each implement `From[IoError]`
// error: `?` cannot pass on an error of `IoError | NetError` from `single`, whose errors are `C`: its member `NetError` has no conversion to it; implement `From` for it, or convert the error first with `mapErr`
// error: `?` cannot pass on an error of `NetError | Timeout | IoError` from `several`, whose errors are `C`: its members `NetError` and `Timeout` have no conversion to it; implement `From` for each, or convert the error first with `mapErr`
// error: `scalar` yields Result[int, int], not Result[int, int | string]; `int | string` has a scalar member, so a value inside another type becomes one of it only when rebuilt, as by `r.mapErr(e -> e)` or `xs.map(x -> x)`, whose lambda injects
// An error that is no member and that no member converts is refused; two members converting it is
// refused naming both; a union converted member by member names each member with no conversion; a
// result with a scalar error union is not seen as a wider one with no rebuilding.

data IoError(path: string)
data ParseError(line: int)
data NetError(host: string)
data Timeout(ms: int)
data A(x: int)
data B(x: int)
data C(x: int)

impl From[IoError] for A
    static from(e: IoError) -> A = A(1)

impl From[IoError] for B
    static from(e: IoError) -> B = B(1)

impl From[IoError] for C
    static from(e: IoError) -> C = C(1)

fetch() -> Result[int, NetError] = Ok(1)
readText() -> Result[int, IoError] = Ok(1)
both() -> Result[int, IoError | NetError] = Ok(1)
three() -> Result[int, NetError | Timeout | IoError] = Ok(1)

load() -> Result[int, IoError | ParseError]
    val p = fetch()?
    Ok(p)

two() -> Result[int, A | B]
    val p = readText()?
    Ok(p)

single() -> Result[int, C]
    val p = both()?
    Ok(p)

several() -> Result[int, C]
    val p = three()?
    Ok(p)

scalar(r: Result[int, int]) -> Result[int, int | string] = r

main()
    println(1)
