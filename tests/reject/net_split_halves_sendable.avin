// error: `CountingReader` promises to be `Sendable`, but its field `reads` is a `var`; make it a `val`
// error: `BufferingWriter` promises to be `Sendable`, but its field `kept` holds a `Buffer[byte]`, which is mutable; an immutable copy (`toVector`) is sendable
// The halves of a split connection are sendable, and the traits promise it: a class of the
// program's own that claims to be a `StreamReader` or a `StreamWriter` is checked to be sendable, so
// one with a `var` field, or one holding a mutable buffer, is rejected as any other sendable class.
import avin.io.IoError
import avin.net.{StreamReader, StreamWriter}
import avin.time.Duration

class CountingReader: StreamReader
  var reads = 0
  override read(max: int) -> Result[Array[byte], IoError] = Ok(Array.empty[byte]())
  override readLine() -> Result[Option[string], IoError] = Ok(None)
  override readAll() -> Result[Array[byte], IoError] = Ok(Array.empty[byte]())
  override setTimeout(d: Duration) -> Result[unit, IoError] = Ok(())
  override close() -> Result[unit, IoError] = Ok(())
  override readable() -> bool = true
  override readinessDescriptor() -> int = -1

class BufferingWriter(val kept: Buffer[byte]): StreamWriter
  override write(bytes: Array[byte]) -> Result[unit, IoError] = Ok(())
  override writeSome(bytes: Array[byte]) -> Result[int, IoError] = Ok(bytes.length)
  override writeText(text: string) -> Result[unit, IoError] = Ok(())
  override setTimeout(d: Duration) -> Result[unit, IoError] = Ok(())
  override close() -> Result[unit, IoError] = Ok(())
  override writable() -> bool = true
  override writabilityDescriptor() -> int = -1

main() = ()
