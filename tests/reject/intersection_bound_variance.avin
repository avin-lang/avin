// Every operand of a method's own bounds is a contravariant position for its class's parameters,
// as a single bound is: a covariant `+T` may not appear in an invariant or covariant argument
// there, and may in a contravariant one, which the position flips.
// error: the covariant type parameter `+T` appears in an invariant position, the bound of `U` in `held`
// error: the covariant type parameter `+T` appears in a contravariant position, the bound of `U` in `made`
trait Named
  name() -> string

trait Holder[A]
  get() -> A

trait Sink[-A]
  put(a: A)

trait Maker[+A]
  make() -> A

class Box[+T](val item: T)
  held[U: Named & Holder[T]](u: U) -> int = 1
  made[U: Maker[T] & Named](u: U) -> int = 1
  sunk[U: Named & Sink[T]](u: U) -> int = 1

main()
  println(1)
