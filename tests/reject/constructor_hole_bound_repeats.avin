// A hole's bounds are held as a type parameter's are: a bound named twice is refused, and so are two
// classes among them.
// error: `Ord` is already a bound of `F`'s argument
// error: `F`'s argument has one class among its bounds, and `Animal` and `Plant` are both classes; the others are traits
open class Animal(val name: string)

open class Plant(val name: string)

twice[F[_: Ord & Ord]](x: F[int]) -> int = 0

classes[F[_: Animal & Plant]](x: F[Animal]) -> int = 0

main()
  println(0)
