// error: `Sole` declares the state `S` more than once
// error: `Named` declares the state `State` more than once
// error: `Generic` declares the state `S` more than once
// error: `Among` declares the state `B` more than once
// error: `Plain` declares the state `A` more than once
// A repeated state name is one error however many states the machine has, whether the repeat is
// its only state, is named `State` or like an event, or belongs to a generic machine or a state
// with parameters: the repeat is dropped, so `Name.State` stays a well-formed type.
data Ev
    A

machine Sole receives Ev
    state S
        A -> stay
    state S
        A -> stay

machine Named receives Ev
    state State
        A -> stay
    state State
        A -> stay

machine Generic[T] receives Ev
    state S
        A -> stay
    state S
        A -> stay

machine Among receives Ev
    state First
        A -> stay
    state B(x: int)
        A -> stay
    state B(x: int)
        A -> stay
    state Last
        A -> stay

machine Plain receives Ev
    state A
        A -> stay
    state A
        A -> stay

main() -> int = 0
