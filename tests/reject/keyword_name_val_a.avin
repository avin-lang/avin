// The keyword `val` on the left of `=` in a `while` body and a `for` body.

in_while(at: int) -> int
  var i = 0
  while i < 3
    val = at
    i += 1
  i

in_for(at: int) -> int
  for i in [1, 2, 3]
    val = at
  at

main() -> int = 0
