// error: `run` is declared more than once with the same parameter types
// error: `(@sendable () -> int) -> int` does not conform to `Sendable`, the bound of `T` in `send`: it is a function value, whose type does not say what it captures
// error: `Holder` does not conform to `Sendable`, the bound of `T` in `send`: its field `make` holds a `() -> @sendable () -> int`, which is a function value, whose type does not say what it captures
// error: `start` overrides `Runner.start`, whose parameter `f` is () -> int, not @sendable () -> int
// Two overloads that differ only in whether a function
// parameter is `@sendable` are one, since a lambda may be passed for either. A plain function is not
// sendable, whatever it takes or yields, once it is held as a plain function value (a lambda
// passed straight to a `Sendable`-bounded parameter is made `@sendable` instead), and data holding
// one is not either; diagnostics print a
// `@sendable` type as it is written, nested in another. A method taking a `@sendable` function does
// not implement one taking a plain function, which a call through the trait could pass.
run(f: @sendable () -> int) -> int = f()
run(f: () -> int) -> int = f()

send[T: Sendable](value: T) -> string = "sent"

data Holder(make: () -> @sendable () -> int)

trait Runner
  start(f: () -> int) -> int

class SendRunner(): Runner
  override start(f: @sendable () -> int) -> int = f()

main()
  val takesOne: (@sendable () -> int) -> int = (f: @sendable () -> int) -> f()
  println(send(takesOne))
  println(send(Holder(() -> () -> 1)))
  println(run(() -> 1))
