// error: `mkString` needs `T: Display`, which Vector[Opaque] does not meet
// error: `mkString` needs `T: Display`, which VectorIterator[Opaque] does not meet
// error: `mkString` needs `T: Display`, which Set[Opaque] does not meet
// `mkString`, which every `Iterable` has, needs elements that display: on a sequence, an iterator
// and a set alike, written once.
class Opaque(n: int)

impl Eq for Opaque
    equals(other: Opaque) -> bool = n == other.n

impl Hash for Opaque
    hash() -> long = n.hash()

main()
    val os: Vector[Opaque] = [Opaque(1)]
    print(os.mkString())
    print(os.iterator().mkString(", "))
    val set: Set[Opaque] = {Opaque(3)}
    print(set.mkString("{", ",", "}"))
