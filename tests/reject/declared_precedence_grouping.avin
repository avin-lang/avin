// error: `^` groups to the left and `^^` to the right, so they cannot be mixed at one level: add parentheses
// error: `^` groups to the left and `^^` to the right, so they cannot be mixed at one level: add parentheses
// error: `<` groups to the left and `<=<` to the right, so they cannot be mixed at one level: add parentheses
// error: `&&` groups to the left and `|&|` to the right, so they cannot be mixed at one level: add parentheses
// error: `<::>` groups to the left and `::` to the right, so they cannot be mixed at one level: add parentheses
// A method declared to group right does not mix, without parentheses, with a left-grouping operator
// its declaration puts it beside: the language's `^`, a comparison, `&&`; nor does one declared
// to group left with `::`, which groups right.
class T(val n: int)
  ^(o: T) -> T = o
  @groupsRight
  ^^(o: T) -> T = o
  @precedence("==")
  @groupsRight
  <=<(o: T) -> T = o
  @precedence("&&")
  @groupsRight
  |&|(o: T) -> T = o
  @precedence("::")
  <::>(o: T) -> T = o

main(args: Vector[string])
  val a = T(1)
  val x = a ^^ a ^ a
  val y = a ^ a ^^ a
  val z = a <=< a < a
  val w = true && a |&| a
  val v = a <::> a :: Nil
  // Parentheses settle each of them.
  val p = (a ^^ a) ^ a
  val q = a ^ (a ^^ a)
  val r = a <=< (a < a)
