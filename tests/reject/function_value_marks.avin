// error: `runAway` cannot be a value of this function type: it marks its parameter `f` `@sendable`, which a call through a function value does not check, and the type gives that parameter `() -> unit`, which is not sendable: it is a function value, whose type does not say what it captures; give that parameter a `@sendable` function type, as in `@sendable () -> unit`
// error: `spawn` cannot be a value of this function type: it marks its parameter `body` `@sendable`, which a call through a function value does not check, and the type gives that parameter `() -> unit`, which is not sendable: it is a function value, whose type does not say what it captures; give that parameter a `@sendable` function type, as in `@sendable () -> unit`
// error: `lift` cannot be a value of this function type: it marks its parameter `body` `@sendable`, which a call through a function value does not check, and the type gives that parameter `() -> int`, which is not sendable: it is a function value, whose type does not say what it captures; give that parameter a `@sendable` function type, as in `@sendable () -> int`
// error: `pass` cannot be a value of this function type: it marks its parameter `f` `@sendable`, which a call through a function value does not check, and the type gives that parameter `(int) -> unit`, which is not sendable: it is a function value, whose type does not say what it captures; give that parameter a `@sendable` function type, as in `@sendable (int) -> unit`
// A function whose parameter is marked is called through a function value with nothing checking what
// is passed for that parameter, so as a value its type gives each marked parameter a sendable type. A
// plain function type is refused for a library function (`spawn`, whose closure would otherwise run
// on four threads at once), for one of the program's own, where it is passed to a higher-order
// function, through a generic function, and for an overload chosen by the expected type.
import avin.threads.{spawn, Thread}

runAway(@sendable f: () -> unit) -> unit = spawn(f).join()

lift[T: Sendable](@sendable body: () -> T) -> T = spawn(body).join()

wrap[T](f: (() -> T) -> T, g: () -> T) -> T = f(g)

hof(f: (() -> unit, long) -> Thread[unit]) -> unit = f(() -> (), 65536).join()

pass(@sendable f: () -> unit) -> unit = f()
pass(@sendable f: (int) -> unit) -> unit = f(1)

main()
  val buf = Buffer[string]()
  val sp: (() -> unit, long) -> Thread[unit] = spawn
  val ts = (0 ..< 4).map(_ -> sp(() -> for i in 0 ..< 1000 do buf.append(s"x$i"), 1048576))
  val g: (() -> unit) -> unit = runAway
  hof(spawn)
  println(wrap(lift, () -> buf.length))
  val b: ((int) -> unit) -> unit = pass
