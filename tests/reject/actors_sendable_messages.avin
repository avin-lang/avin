// error: `Buffer[int]` does not conform to `Sendable`, the bound of `M` in `Behaviour`: it is mutable; an immutable copy (`toVector`) is sendable
// error: `Tally` does not conform to `Sendable`, the bound of `M` in `ActorRef`: its field `n` is a `var`; make it a `val`
// error: `(int) -> int` does not conform to `Sendable`, the bound of `M` in `spawn`: it is a function value, whose type does not say what it captures
// error: `(int) -> int` does not conform to `Sendable`, the bound of `M` in `Behaviour`: it is a function value, whose type does not say what it captures
// A message type must be sendable, so a behaviour, a reference or a spawn of one that is not is
// refused where the type is named: a mutable collection, a class with a `var` and a plain function
// value.
import avin.actors.{ActorRef, Behaviour, spawn}

class Tally()
  var n = 0

buffers() -> Behaviour[Buffer[int]] = Behaviour("Buffers", me -> b -> ())

tallies(r: ActorRef[Tally]) = r.tell(Tally())

functions() = spawn(Behaviour[(int) -> int]("Functions", me -> f -> ()))

main() = ()
