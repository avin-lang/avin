// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it uses `ch`, a `Channel[Buffer[int]]`, whose type argument `Buffer[int]` is mutable; an immutable copy (`toVector`) is sendable
// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it uses `sel`, a `Channel[Array[int]]`, whose type argument `Array[int]` is mutable; an immutable copy (`toVector`) is sendable
// A channel of capacity zero is sendable by the same rule as any channel: only where its values are,
// so a thread may not capture one of mutable values, to send on, receive from or select over.
import avin.threads.{Channel, spawn}

main()
  val ch = Channel[Buffer[int]](0)
  spawn(() -> ch.send(Buffer[int]())).join()
  val sel = Channel[Array[int]](0)
  spawn(() -> select
    sel.receive() as Some(a) -> a.length
    else 0).join()
  val fine = Channel[Vector[int]](0)
  val t = spawn(() -> fine.receive())
  fine.send([1, 2])
  println(t.join())
