// error: a lambda that captures `self` is made in a superclass's arguments, which run before the object is initialized
// error: a lambda that captures `self` is made in a superclass's arguments, which run before the object is initialized
// error: a lambda that captures `self` is made in a superclass's arguments, which run before the object is initialized
// error: a lambda that captures `self` is made in a superclass's arguments, which run before the object is initialized
// error: a lambda that captures `self` is made in a superclass's arguments, which run before the object is initialized
open class Base(f: () -> long)
  val got: long = f()

// A lambda in a collection argument.
open class Many(fs: Vector[() -> long])
  val got: long = fs(0)()
class InVector: Many([() -> v])
  val v: long = 4

// A lambda reading a `lazy val` of the object, whose initializer uses the object.
class Lazy: Base(() -> lz)
  val k: long = 2
  lazy val lz: long = k * 10

// A closure stored in a field of an object passed as the argument.
data Holder(f: () -> long)
open class Held(h: Holder)
  val got: long = h.f()
class InObject: Held(Holder(() -> o))
  val o: long = 6

// The argument is a `with` copy whose new field is such a closure.
val plain = Holder(() -> 0)
class Copied: Held(plain with { f = () -> w })
  val w: long = 7

// One branch of a conditional argument.
class Branch(flag: bool): Base(if flag then () -> b else () -> 0)
  val b: long = 3

main()
  println(InVector().got)
  println(Lazy().got)
  println(InObject().got)
  println(Copied().got)
  println(Branch(true).got)
