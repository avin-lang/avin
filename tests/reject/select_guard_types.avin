// error: expected bool, found int
// error: expected bool, found string
// error: expected bool, found Channel[int]
// error: expected bool, found unit
// A select arm's guard is a `bool`, on every kind of arm.
import avin.threads.{Channel, Readiness}
import avin.time.millis

guarded(r: Readiness)
  val c = Channel[int]()
  select
    c.receive() if 1 -> ()
    c.send(1) if "yes" -> ()
    after millis(1) if c -> ()
    r.readable() if () -> ()

main() = ()
