// error: `tag` overrides `A.tag`, whose type parameter `U` is not bounded by Ord
// error: `pair` overrides `A.pair`, whose type parameter `P` is not bounded by Display
// error: `both` overrides `A.both`, whose type parameter `U` is not bounded by Named
// error: `show` overrides `Shower.show`, whose type parameter `T` is not bounded by Display
// error: `render` overrides `Shower.render`, whose type parameter `T` is not bounded by Named
// An override assumes no more of its own type arguments than the method it overrides: a call through
// the base type passes any type argument the base's bounds admit. A bound an override adds, on any
// of its type parameters, renamed or not, and beside bounds it keeps, is rejected; so is a stronger
// bound in place of a weaker one.
trait Shape
    area() -> int

trait Named: Shape
    name() -> string

open class A
    tag[U](x: U) -> string = "a"
    pair[P, Q: Shape](p: P, q: Q) -> int = q.area()
    both[U: Shape](x: U) -> int = x.area()

class B: A
    override tag[V: Ord](x: V) -> string = "b"
    override pair[X: Display, Y: Shape](p: X, q: Y) -> int = 1
    override both[U: Shape + Named](x: U) -> int = x.area()

trait Shower
    show[T](x: T) -> string
    render[T: Shape](x: T) -> string = "shape"

class S: Shower
    override show[T: Display](x: T) -> string = s"$x"
    override render[T: Named](x: T) -> string = x.name()

main() -> int = 0
