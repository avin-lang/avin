// A lazy list is made by its companion's methods: its cells, the expression that evaluates them and
// its constructor's state are its own, and a list pattern does not take one apart.
// error: `cell` is private to `LazyList`
// error: `pending` is private to `LazyList`
// error: `LazyListProgress` is not defined
// error: `::` patterns match a `List`, not LazyList[int]

main()
    val xs = LazyList.from(0)
    println(xs.cell)
    println(xs.pending)
    val made = LazyList(() -> None, LazyListProgress(false))
    xs match
        x :: rest -> println(x)
        _ -> println("none")
