// A lazy list is made by its companion's methods: its cells' element, rest and the function that
// evaluates them are its own, the cell it would make by its constructor holds nothing yet, so only
// the class and its companion make one, and a list pattern does not take one apart.
// error: `first` is private to `LazyList`
// error: `pending` is private to `LazyList`
// error: `rest` is private to `LazyList`
// error: `LazyList` keeps fields its own code fills in, so only the class and its companion make one
// error: `::` patterns match a `List`, not LazyList[int]

main()
  val xs = LazyList.from(0)
  println(xs.first)
  println(xs.pending)
  println(xs.rest)
  val made = LazyList[int]()
  xs match
    x :: rest -> println(x)
    _ -> println("none")
