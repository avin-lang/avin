// error: `inferred` uses `?`, so it needs a declared result type
// error: this lambda uses `?`, so its result type must be known where it is written
// error: `?` cannot return from a delayed argument
// error: `?` cannot return from a class body
// error: this `match` does not cover every Option[int] value
// `?` returns from the function it is written in, so that function's result type must be declared,
// and it cannot be a delayed argument or a class body. A `match` on an `Option` covers `None`.

half(n: int) -> Option[int] = if n % 2 == 0 then Some(n / 2) else None

inferred(n: int) = Some(half(n)?)

apply[T](f: (int) -> T) -> T = f(2)

lambda() -> int
    val unknown = apply(n -> Some(half(n)?))
    0

once(value: -> int) -> int = value

delayed(n: int) -> Option[int] = Some(once(half(n)?))

class Halved(n: int)
    val value = half(n)?

uncovered(o: Option[int]) -> int = o match
    Some(v) -> v

main() = ()
