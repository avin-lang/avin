// A C binding is always checked against a header, and the headers are named by a package's
// manifest, so a program of one file with no manifest cannot have one.
// error: the C binding `abs` is checked against the headers a package's manifest names under `c-libraries`, and this program has no avin.hocon

@c("int abs(int)")
abs(n: int) -> int

main()
    println(abs(-1))
