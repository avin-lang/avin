// A field and a trait's method with a parameter list may share a name; every other method of the
// name is still refused, at the program's own declaration: a method of no trait, in an impl of a
// data type or in a class, and a template's method of no parameter list, which the field
// implements instead.
// error: `display` is already a field of `R`
// error: `compare` is already a field of `U`
// error: `display` is already a field of `K`
// error: `D` cannot derive `Named`: `title` is already a field of `D`

data R(display: int)

impl R
    display(out: Writer, spec: FormatSpec) = out.write("own")

data U(compare: int) derives Ord

impl U
    compare(other: U) -> int = 0

class K(val display: int)
    display(out: Writer, spec: FormatSpec) = ()

trait Named
    title -> string

derive Named for T
    title -> string = "t"

data D(title: string) derives Named

main()
    println(R(1))
    println(U(1) < U(2))
    println(D("a").title)
