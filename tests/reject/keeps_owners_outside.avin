// error: `@keeps_owners` is the standard library's mark on a type shared between owners, such as `ActorRef`, whose handles a send does not hand over
// error: `holds_handles` is an intrinsic of `avin.actors`
// `@keeps_owners` is the standard library's mark on a type shared between owners, at which handing a
// value over stops, and `holds_handles` the actors' intrinsic deciding which messages a send walks:
// neither is a program's own.
@keeps_owners
class Shared(val n: int)

@intrinsic("holds_handles")
private holds[T](value: T) -> bool

main() = println(Shared(1).n)
