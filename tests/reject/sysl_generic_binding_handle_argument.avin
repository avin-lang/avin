// A Sysl handle goes into Sysl only by itself, so it is not `Boundary`: a generic binding is not
// called at one, nor at an option of one, and a generic function's bound does not make it one. An
// Avin bound beside `Boundary` is held at the call as any bound is.
// error: `Handle` does not conform to `Boundary`, the bound of `T` in `same`
// error: `Option[Handle]` does not conform to `Boundary`, the bound of `T` in `same`
// error: `Handle` does not conform to `Boundary`, the bound of `T` in `passOn`
// error: `Spot` does not conform to `Ord`, the bound of `T` in `larger`

@sysl("pkg.values.same")
same[T: Boundary](x: T) -> T

@sysl("pkg.values.Handle")
class Handle

@sysl("pkg.values.handle")
handle() -> Handle

@sysl("pkg.values.larger")
larger[T: Boundary + Ord](a: T, b: T) -> T

@sysl("pkg.values.Spot")
data Spot(x: int, y: int)

passOn[T: Boundary](x: T) -> T = same(x)

main()
  val h = handle()
  same(h)
  same(Some(h))
  passOn(h)
  larger(Spot(1, 2), Spot(2, 1))
