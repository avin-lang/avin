// error: `pure` is not a static member of `Mappable`, the bound of `F`
// error: `F` has no bound, so it has no static member `pure`; a constructor trait declaring it, as in `[F[_]: Trait]`, gives it one
// error: `pure` is static: it belongs to the constructor, so it is called on it, as in `F.pure(…)`, not on a value
// error: `pure` is a static member of `Pointed`, which `Result[int, _]` does not implement: `Result` implements `Pointed` as `Result[_, E]`, leaving those arguments open
// error: `F` has no bound, so it has no static member `pure`; a constructor trait declaring it, as in `[F[_]: Trait]`, gives it one
// A static member is called on a constructor whose bound, or own conformance, declares it: not on a
// constructor parameter whose bound lacks it or that has none, not on a value of `F[X]`, and not on
// a partial application leaving open other arguments than the conformance does. Taken as a function
// value, an unbounded `F.pure` is refused the same way.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

trait Pointed[A]: Mappable[A]
  static pure[X](value: X) -> Self[X]

impl[T, E] Pointed[T] for Result[T, E]
  static pure[X](value: X) -> Result[X, E] = Ok(value)

notDeclared[F[_]: Mappable](n: int) -> F[int] = F.pure(n)

unbounded[F[_]](n: int) -> F[int] = F.pure(n)

onValue[F[_]: Pointed](fa: F[int]) -> F[int] = fa.pure(1)

wrongHole() -> int
  val r = Result[int, _].pure(1)
  0

unboundedValue[F[_]](xs: List[int]) -> List[F[int]] = xs.map(F.pure)

main()
  println(1)
