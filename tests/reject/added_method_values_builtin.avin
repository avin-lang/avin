// error: `pick` is overloaded, so as a value with no expected function type it is ambiguous: `Plain.pick[Self](k: int)`, `Plain.pick[Self](s: string)` could each be meant
// error: no overload of `pick` has the parameter types of (bool) -> string
// error: `shown` is called with `()`: write `.shown()`, or a lambda calling it for a function value
// error: `tagged` needs a `Tx` for `tx`, and no given of that type is in scope
// error: long has no field `pick`
// A method an impl adds to a trait, taken as a value on a built-in type: an overload with no expected
// function type, an expected type no overload fits, a method declared with `()` and no expected
// type, a `using` section no given fills, and a built-in type that does not implement the trait.
data Tx(id: int)

trait Plain
  plain() -> string

impl Plain for int
  plain() -> string = s"int $self"

impl Plain
  pick(k: int) -> string = s"${plain()} $k"
  pick(s: string) -> string = s"${plain()} $s"
  shown() -> string = s"[${plain()}]"
  tagged(k: int, using tx: Tx) -> string = s"${plain()}#$k/${tx.id}"

main() =
  val a = 1.pick
  val b: (bool) -> string = 2.pick
  val c = 3.shown
  val d = 4.tagged
  val l: long = 5
  val e = l.pick
