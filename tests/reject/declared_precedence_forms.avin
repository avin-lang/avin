// error: `@precedence` takes one string, an operator of the language whose level the method's calls bind at
// error: `@precedence` takes one string, an operator of the language whose level the method's calls bind at
// error: `+::` ends in `:`, so its calls group to the right already: remove `@groupsRight`
// error: `|` is the language's own operator, and keeps its level and grouping: only a method named by a symbol the language does not use declares `@precedence` or `@groupsRight`
// error: `max` is named by a word, and every method called infix by its name binds alike: only a method named by a symbol declares `@precedence` or `@groupsRight`
// A range, an assignment or a number names no level a method's calls may take; a name ending in `:`
// groups right already; the language's operators and named calls keep their levels.
class T(val n: int)
  @precedence("..")
  <|>(o: T) -> T = o
  @precedence(3)
  |>(o: T) -> T = o
  @groupsRight
  +::(o: T) -> T = o
  @precedence("+")
  |(o: T) -> T = o
  @precedence("|")
  max(o: T) -> T = o

main() = ()
