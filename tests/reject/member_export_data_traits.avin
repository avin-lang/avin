// error: `Datum` does not implement `bump` from `Bumpable`; implement it in an impl of `Bumpable`
// A data type's exports serve its uses; its impls of a trait write the trait's methods.
trait Bumpable
  bump() -> unit

class Counter(var count: int)
  bump() = count += 1

data Datum(c: Counter)

impl Datum
  export c.bump

impl Bumpable for Datum

main() = ()
