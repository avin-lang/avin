// error: an integer literal does not match a BigInt as a pattern; compare it with `==`, as in `if x == 0`
// error: `+` needs two values of one type, not BigInt and real
// error: `+=` needs two numbers of one type, not int and BigInt
// error: `*` needs two values of one type, not BigInt and byte
// error: `===` cannot compare BigInt with int
// Integers convert to a `BigInt` and nothing else does: a `real` and a `byte` are no integers, a
// compound assignment's integer target keeps its type, identity compares no converted value, and a
// literal is no pattern for a `BigInt`, whose literal is a call.
f(b: BigInt) -> string = b match
  0 -> "zero"
  _ -> "other"

main()
  val big = BigInt(5)
  var n = 3
  println(big + 1.5)
  n += big
  val by: byte = 3
  println(big * by)
  println(big === n)
  println(f(big))
