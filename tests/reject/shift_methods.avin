// error: `<<` is the language's operator on int, and no method can redefine it
// error: `>>` is the language's operator on byte, and no method can redefine it
// error: `Bits` has no method `>>`
// error: `<<` needs two numbers of one type, not int and Bits
// A type other than the integers and bytes may name methods `<<` and `>>`; the integers' and bytes'
// shifts are the machine's.
class Bits(val n: int)
    <<(k: int) -> Bits = self

impl int
    <<(k: int) -> int = self

impl byte
    >>(k: byte) -> byte = self

main()
    val b = Bits(1)
    val c = b << 2
    val d = b >> 2
    val e = 1 << b
