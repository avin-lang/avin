// error: `Base` is not a trait; an impl names a trait before `for`
// error: `shown` overrides nothing; `Pile` has no superclass
// error: `size` is already a method of `Sized`; an impl adds to a trait only methods the trait does not declare
// error: `Rope.size` implements `Sized.size`, which yields int, not string
// error: `hidden` is private to the impls of `Pile`
trait Sized
  size() -> int

class Base

data Pile(height: int)

impl Base for Pile
  size() -> int = 1

impl Pile
  private hidden() -> int = 2
  override shown() -> int = hidden()

impl Sized
  size() -> int = 0

data Rope(length: int)

impl Sized for Rope
  size() -> string = "long"

main() = println(s"${Pile(1).hidden()}")
