// error: the covariant type parameter `+T` appears in a contravariant position, the bound of `U` in `put`
// error: the covariant type parameter `+T` appears in a contravariant position, the bound of `V` in `put`
// A type parameter bounding a method's own is a position a caller passes a value in through, as any
// bound is: a `-T` may bound one and a `+T` may not, in a class's methods and a trait's alike.
class Box[+T](val held: T)
  put[U: T](u: U) -> unit = ()

trait Store[+T]
  put[V: T](v: V) -> unit

// Legal: a contravariant parameter bounds a method's own, as the input of a rule does.
class Sink[-T]
  take[U: T](u: U) -> unit = ()
  both[U: T, W: U](w: W) -> unit = ()

// Legal: an invariant one bounds it in any method.
class Cell[T](val held: T)
  with[U: T](u: U) -> Cell[T] = Cell(u)

main() = ()
