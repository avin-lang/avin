// What is passed for a `@sendable` parameter of a trait type is sendable inside the function, so a
// `match` function written for it is checked as a lambda is, by what its arms capture (a `var`) and
// by the module-level state they reach (a `var`, a `val` of a mutable array), and any other value is
// of a sendable type: an object with a `var` field is not, whether passed to a function or to a
// class's marked parameter.
data Rule[T](run: @sendable (char) -> Option[T])
class Counting(var n: int): PartialFunction[char, int]
    override isDefinedAt(c: char) -> bool = true
    override lift() -> char -> Option[int] = c -> Some(n)
var hits = 0
val table = Array.fill(3, 0)
pick[U](@sendable f: PartialFunction[char, U]) -> Rule[U] = Rule(c -> if f.isDefinedAt(c) then Some(f(c)) else None)
class Digits(@sendable f: PartialFunction[char, int])
    rule() -> Rule[int] = pick(f)
main() =
    var count = 0
    val a = pick(match 'a' -> count)
    val b = pick(Counting(0))
    val d = pick(match 'a' -> hits)
    val e = pick(match 'a' -> table.length)
    val g = Digits(Counting(1))
    val arr = Array.fill(2, 0)
    val h = pick(match 'a' -> arr.length)
    val pf: PartialFunction[char, int] = match 'a' -> 1
    val i = pick(pf)
    val j = pick((match 'a' -> 1).orElse(match 'b' -> 2))
