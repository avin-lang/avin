// error: `make` is a static member of `Box[Animal]`, which is not reached through the bound of `U`: a type argument meeting `Box[Animal]` may be the type at other type arguments, through its variance, and its static members are its own; bound `U` by the trait declaring `make`
// error: `U` does not conform to `Make[Animal]`, the bound of `C` in `build`
// error: `Box[Cat]` does not conform to `Make[Animal]`, the bound of `C` in `build`
// error: `Opt[Cat]` does not conform to `Make[Animal]`, the bound of `C` in `build`
// A covariant type's conformance to a trait whose members are all static is its own, at its own
// type arguments: a `Box[Cat]` is a `Box[Animal]`, but its `make` takes cats, so it is reached
// neither through a bound `Box[Animal]` nor as a `Make[Animal]`.
trait Make[A]
  static make(x: A) -> Self

open class Animal(val name: string)
class Cat(): Animal("cat")
class Dog(): Animal("dog")

abstract class Box[+T]
  item -> T

class Full[+T](val value: T): Box[T]
  override item -> T = value

impl[T] Make[T] for Box[T]
  static make(x: T) -> Box[T] = Full(x)

data Opt[+T]
  Some1(value: T)
  None1

impl[T] Make[T] for Opt[T]
  static make(x: T) -> Opt[T] = Some1(x)

build[C: Make[A], A](x: A) -> C = C.make(x)

viaBox[U: Box[Animal]]() -> U = U.make(Dog())

viaBound[U: Box[Animal]](d: Animal) -> U = build[U, Animal](d)

main()
  val wrong = build[Box[Cat], Animal](Dog())
  val alsoWrong = build[Opt[Cat], Animal](Dog())
