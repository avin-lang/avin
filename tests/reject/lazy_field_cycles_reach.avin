class Three
  lazy val three: int = one + 3
  lazy val one: int = two + 1
  lazy val two: int = three + 2

trait Named
  name() -> string
  greeting() -> string = "hello " + name()

class Person: Named
  lazy val named: string = greeting()
  override name() -> string = named

class Inner
  lazy val inner: int =
    lazy val step: int = inner + 1
    step * 2

class Defaulted
  lazy val defaulted: int = pick()

  pick(n: int = defaulted) -> int = n + 1

open class Top
  lazy val base: int = extra()

  extra() -> int = 0

class Bottom: Top
  lazy val own: int = base + 1
  override extra() -> int = own

main() = ()
