// error: `UserId` is an opaque type: `UserId(r)` makes one of its representation `r`, and `x.repr` is the representation of one; it is not a value or a pattern
// error: expected OrderId, found UserId
// error: `UserId | OrderId` has no member `repr`: its members share no type that has one; take it apart with a `match` or `is` first
// error: UserId has no field `value`
// An opaque type's name is not a pattern; two opaque types of one representation are different
// types; a union of them has no shared `repr`; it has only the members its impls give it.
opaque type UserId = long
opaque type OrderId = long

main()
  val u = UserId(1)
  u match
    UserId(n) -> println(n)
  val o: OrderId = u
  val x: UserId | OrderId = u
  println(x.repr)
  println(u.value)
