// error: `Both` inherits two implementations of `describe`, `Loud.describe` and `Quiet.describe`; override it
// error: `describe` is already a method of `Shape`, which `Plain` requires; mark it `override` to replace its default
// error: `missing` overrides nothing; no trait `Loud` requires has a method `missing`
// error: `describe` overrides `Shape.describe`, which yields string, not int
trait Shape
    area() -> int
    describe() -> string = "shape"

trait Loud: Shape
    override describe() -> string = "LOUD"
    override missing() -> int = 1
    override area() -> int

trait Quiet: Shape
    override describe() -> string = "quiet"

trait Plain: Shape
    describe() -> string = "plain"

trait Wrong: Shape
    override describe() -> int = 1

class Both: Loud, Quiet
    override area() -> int = 0

main() = ()
