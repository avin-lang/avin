// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it uses `g`, a `Graph`, which is not made to be shared between threads
// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it uses `a`, an `Atom[int]`, which is mutable, and not made to be shared between threads
// error: `Carry` does not conform to `Sendable`, the bound of `M` in `Behaviour`: its field `a` holds an `Atom[int]`, which is mutable, and not made to be shared between threads
// A graph and its nodes are mutable, so none of them is sendable: no thread's body may capture one,
// and no actor's message may carry one. A port is sendable, so the first thread's body is accepted:
// it is how another thread writes.
import avin.actors.Behaviour
import avin.reactive.{Atom, Graph}
import avin.threads.spawn

data Carry(a: Atom[int])

main()
  val g = Graph()
  val a = g.atom(0)
  val p = g.port(a)
  _ = spawn(() -> p.set(1))
  _ = spawn(() -> g.drain())
  _ = spawn(() -> a.set(2))
  _ = Behaviour[Carry]("Carrier", me -> c -> ())
