// error: what is passed for `f` of `pick` may use only sendable values from around it, but it uses `arr`, an `Array[int]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: what is passed for `f` of `pick` may use only sendable values from around it, but it captures `n`, a `var`, which the closure would share with the code that made it; copy it into a `val`, or share it through an `Atomic` or a `Mutex`
// error: what is passed for `f` of `pick` may run on another thread, which shares the program's module-level state, but it reaches `hits`, a module-level `var`, which every thread would share; share it through an `Atomic` or a `Mutex` held in a `val`
// error: what is passed for `f` of `pick` may use only sendable values from around it, but it uses `pf`, a `PartialFunction[char, int]`, which is a trait that does not promise to be sendable; declare it `trait PartialFunction: Sendable`, and every type implementing it is checked to be
// error: `@sendable_result` is the standard library's promise about a method it defines, which nothing checks against the method's body; a function outside it returns a value of a sendable type or a `@sendable` function
// A `match` function combined with a sendable one by `orElse` is checked as any written in place: its
// arms may not use a mutable value, capture a `var` or reach a module-level `var`. A chain of
// `orElse` is refused where any link is not sendable. Only the standard library promises a result
// sendable: a program's own function that says so is refused.
data Rule[T](run: @sendable (char) -> Option[T])
pick[U](@sendable f: PartialFunction[char, U]) -> Rule[U] = Rule(c -> if f.isDefinedAt(c) then Some(f(c)) else None)
var hits = 0

captures(@sendable f: PartialFunction[char, int]) -> Rule[int] =
  val arr = Array.fill(2, 0)
  pick(f.orElse(match 'a' -> arr.length))

mutable(@sendable f: PartialFunction[char, int]) -> Rule[int] =
  var n = 0
  n += 1
  pick(f.orElse(match 'a' -> n))

reach(@sendable f: PartialFunction[char, int]) -> Rule[int] = pick(f.orElse(match 'h' -> hits))

chain(@sendable f: PartialFunction[char, int], @sendable g: PartialFunction[char, int]) -> Rule[int] =
  val pf: PartialFunction[char, int] = match 'z' -> 26
  pick(f.orElse(g).orElse(pf).orElse(f))

@sendable_result
mine(f: PartialFunction[char, int]) -> PartialFunction[char, int] = f

main() = ()
