// error: only the arguments of `Result` itself are left open; a `_` inside `Option[_]` would leave open an argument of another type
// error: `Ord` mentions `Self`, so it is a bound, as in `[T: Ord]`, and not a type
// error: `(int, string)` is a type, and a tuple, a function type or a union is no constructor; `F[_]` takes a constructor of one argument, such as `Option`
// error: `Either` takes two arguments and `F` one; leave one open, as `Either[_, R]`
// At a call a `_` leaves open only the arguments of the type named; a bound is no constructor;
// a tuple is none; and a constructor of one arity is none for a parameter of another.
same[F[_], A](x: F[A]) -> F[A] = x

main()
  println(same[Result[Option[_], string], int](Ok(1)))
  println(same[Ord, int](1))
  println(same[(int, string), int](1))
  println(same[Either, int](Left(1)))
