// error: `T` is a type parameter, which a call converts to only where it is bounded by `Integer`
// error: cannot convert T to real with a call; a value of a type parameter bounded by `Numeric` converts with `.toReal`
// error: `T` does not conform to `Integer`, the bound of `T` in `needsInt`
// error: `floorDiv` is not a member of `Numeric`, the bound of `T`
// error: `average` needs `T: Numeric`, which Vector[string] does not meet
// A type parameter bounded by `Numeric` has the numbers' common members only: no conversion by a
// call, no integer-only method, and it does not meet `Integer`. A collection of strings has no mean.

needsInt[T: Integer](x: T) -> T = x

convert[T: Numeric](x: T) -> T = T(0)

widen[T: Numeric](x: T) -> real = real(x)

passOn[T: Numeric](x: T) -> T = needsInt(x)

floored[T: Numeric](x: T) -> T = x.floorDiv(x)

main()
  println(["a"].average)
