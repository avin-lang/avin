// One `@c` on a handle, its words given once, `shared` the only word without a key, and only a C
// binding makes a handle.
// error: `shared` is said once
// error: a C handle has one `@c`
// error: `@c` on a class names the C pointer type it is a handle on with `type:`, as in `@c(type: "cairo_t *", release: "cairo_destroy")`
// error: `Made` is a handle on the C type `struct thing *`, so only a C binding that answers one makes it

@c(type: "struct thing *", release: "free", shared, shared)
class SharedTwice

@c(type: "struct thing *", release: "free")
@c(type: "struct thing *", release: "free")
class Twice

@c(type: "struct thing *", release: "free", "struct other *")
class Positional

@c(type: "struct thing *", release: "free")
class Made

main()
  val m = Made()
