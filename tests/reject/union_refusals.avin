// error: an `impl` names a declared type, and `int | string` is a union; declare a data type to give it methods
// error: an `impl` names a declared type, and `int | bool` is a union; declare a data type to give it methods
// error: a union is no parent: a class or trait lists a class and traits after `:`, and `A | B` is a union
// error: a bound is a trait or a class, and `A | B` is a union
// error: a union is not called: `((int) -> int) | string` may hold a value that is no function; take it apart with a `match` first
// No `impl` or extension names a union, a union is no parent and no bound, and a union is not called.
// A lower bound may be a union.

trait A
    a() -> int

trait B
    b() -> int

impl Display for int | string
    display(w: Writer, spec: FormatSpec) = ()

impl int | bool
    twice() -> int = 2

class C: A | B
    a() -> int = 1

bounded[T: A | B](x: T) -> int = 0

lower[T >: A | B](x: T) -> int = 0

main()
    val f: ((int) -> int) | string = (n: int) -> n
    println(f(1))
