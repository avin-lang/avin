// error: `@trusted_sendable` is the standard library's mark on a type whose synchronization its structure cannot show, such as `Mutex`; a type outside it is checked to be sendable by its structure
// error: `Counter` promises to be `Sendable`, but its field `n` is a `var`; make it a `val`
// error: `Box[T]` promises to be `Sendable`, but its field `f` holds a `() -> T`, which is a function value
// error: `@trusted_sendable` is the standard library's mark on a type whose synchronization its structure cannot show
// `@trusted_sendable` is the standard library's mark on a class whose promise to be `Sendable` rests
// on synchronization the checker cannot see. A program's class may not take it, and a class that
// tries is still checked against its structure, its promise made in the header or by an impl.
@trusted_sendable("a program's own reason")
class Counter(private var n: int): Sendable
  get() -> int = n

@trusted_sendable("the function is pure")
class Box[T](private val f: () -> T)
  get() -> T = f()

impl[T: Sendable] Sendable for Box[T]

// A file that derives keeps the mark on the class, where it is refused all the same.
@trusted_sendable("derived equality")
class Version(val major: int): Sendable derives Eq, Hash

main()
  println(Counter(1).get(), Box(() -> 2).get(), Version(1) == Version(1))
