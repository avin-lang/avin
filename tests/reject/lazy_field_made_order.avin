// error: module-level values need one another to initialize: `First` → `Second` → `First`
// error: `held` is needed by its own initializer, directly or through the functions it calls
// error: module-level values need one another to initialize: `Maker` → `other` → `Maker`
// Making a `lazy val` field needs nothing, but reading it runs its initializer: a body that reads
// its own lazy field while the object is made needs what that initializer reads, and so does a
// lambda the body makes and calls. Each of these is still a cycle of module values.
object First
  val k: int = 1
  lazy val x: int = Second.k + 1
  println(x)

object Second
  val k: int = 2
  lazy val y: int = First.k + 1
  println(y)

class Holder
  val base: int = 6
  lazy val v: int = held.base + 1
  println(v)

val held: Holder = Holder()

object Maker
  val k: int = 3
  val f: () -> int = () -> other + 1
  val made: int = f()

val other: int = Maker.k

main() = ()
