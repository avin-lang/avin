// A contextual parameter's type is a type a given may have, fixed where its function is declared:
// it names no type parameter, of the function or of its class, and is no built-in type, tuple,
// function type or union.
// error: `codec: Codec[T]` names the type parameter `T`; a contextual parameter's type is fixed where its function is declared, and what `T` needs is a bound: `[T: Codec]`
// error: `item: T` names the type parameter `T`; a contextual parameter's type is fixed where its function is declared, and what `T` needs is a bound
// error: a contextual parameter is of a class, object, trait or data type: `int` would be given wherever an `int` is asked for
// error: a contextual parameter is of a class, object, trait or data type: `(int) -> int` would be given
// error: `log: Holder[E]` names the type parameter `E`

class Codec[T](name: string)
class Holder[E](value: E)

encode[T](value: T, using codec: Codec[T]) -> int = 0

class Box[T](x: T)
  put(using item: T) -> int = 0

retries(using count: int) -> int = count

mapped(using f: (int) -> int) -> int = f(1)

class Keeper[E](using log: Holder[E])

main() = 0
