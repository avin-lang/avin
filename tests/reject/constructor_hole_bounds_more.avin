// A constructor parameter with a bounded hole passed for one whose hole promises less, written or
// inferred, is refused, as is a type with a bounded parameter given as a written argument of a
// type; a hole's bound is a trait or a class.
object Origin

loose[F[_]](x: F[int]) -> F[int] = x

cov[F[+_]](x: F[int]) -> F[int] = x

passOrd[G[_: Ord]](x: G[int]) -> G[int] = loose[G](x)

badBound[F[_: int]](x: F[int]) -> int = 0

data Wrap[F[_]](inner: F[int])

objectBound[F[_: Origin]](x: F[int]) -> int = 0

inferred[G[+_: Ord]](x: G[int]) -> G[int] = cov(x)

main()
  val w: Wrap[TreeSet] = Wrap(TreeSet(1))
