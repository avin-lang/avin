// A Sysl mirror's field is written in lowerCamelCase, never as Sysl's snake_case, so a field has
// one spelling.
// error: a Sysl mirror's field is written in lowerCamelCase, and the compiler matches it to the Sysl field of the same words in snake_case: write `restArePositional`, not `rest_are_positional`

@sysl("sysl.args.Scan")
data Scan
  Scan(
      argv: Vector[string],
      at: long,
      bundle: string,
      attached: Option[string],
      last: string,
      rest_are_positional: bool
  )

@sysl("sysl.hint.black_box")
same(s: Scan) -> Scan

main() = 0
