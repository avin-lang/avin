// A prototype is read as C writes one, and what can never cross a C binding is refused as it is
// read: a variadic function, `long double`, a complex type, a parameter taking a function, and a
// prototype that names no function.
// error: `@c` takes the C function's prototype as the header writes it, as in `@c("int abs(int)")`, and this one is not: a variadic function cannot be bound: the types of the arguments `...` takes cannot be checked
// error: `@c` takes the C function's prototype as the header writes it, as in `@c("int abs(int)")`, and this one is not: `long double` cannot cross a C binding
// error: `@c` takes the C function's prototype as the header writes it, as in `@c("int abs(int)")`, and this one is not: `_Complex` cannot cross a C binding
// error: `@c` takes the C function's prototype as the header writes it, as in `@c("int abs(int)")`, and this one is not: a parameter taking a function cannot cross a C binding: callbacks are not implemented
// error: `@c` takes the C function's prototype as the header writes it, as in `@c("int abs(int)")`, and this one is not: it names no function: a prototype is a result type, the function's name and its parameters, as in `int abs(int)`

@c("int printf(const char *format, ...)")
printf(format: long) -> int

@c("long double sqrtl(long double)")
sqrtl(x: real) -> real

@c("double _Complex csqrt(double _Complex)")
csqrt(x: real) -> real

@c("void atexit_like(void (*f)(void))")
atexitLike(f: long)

@c("int (int)")
nameless(x: int) -> int

main() = 0
