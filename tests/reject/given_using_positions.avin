// Nothing calls `main`, a `@test` function or a test hook with a `using` section to fill, so none
// takes one; and a trait that names `Self` is only a bound, no contextual parameter's type.
// error: `main` takes no `using` section: nothing calls it to fill one, so it declares the givens it needs in its body
// error: a `@test` function takes no `using` section: the runner calls it with nothing
// error: a `@setup` function takes no `using` section
// error: `Same` mentions `Self`, so it is a bound

data Tx(id: int)

trait Same
  same(other: Self) -> bool

@test
checked(using tx: Tx)
  assert(tx.id == 1)

@setup
prepare(using tx: Tx) = ()

compare(using s: Same) -> int = 0

main(using tx: Tx) = ()
