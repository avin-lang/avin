// error: `apply` takes the same parameter types as `Meter`'s constructor, which `Meter(arguments)` also calls, so no call could choose between them
// error: `apply` takes the same parameter types as `Box`'s constructor, which `Box(arguments)` also calls, so no call could choose between them
// error: `apply` takes the same parameter types as the variant `Spot`, which `Spot(arguments)` also calls, so no call could choose between them
// error: no overload of `Meter` accepts these arguments; the overloads are `Meter(value: int)`, `Meter.apply(text: string)`
// error: no overload of `Pair` has the parameter types of (string) -> Pair; the overloads are `Pair(left: int, right: int)`, `Pair.apply(both: int)`
// A companion's `apply` overloads the constructor its name has in call position, so one taking the
// same parameter types, up to the names of type parameters, is refused where it is declared and
// left out of the calls; a call no candidate accepts names every candidate, and so does the name
// where a function type no candidate fits is expected.

class Meter(val value: int)

object Meter
    apply(value: int) -> Meter = Meter(value + 1)
    apply(text: string) -> Meter = Meter(0)

class Box[T](val item: T)

object Box
    apply[U](item: U) -> Box[U] = Box(item)

data Spot(x: int, y: int)

object Spot
    apply(a: int, b: int) -> Spot = Spot(b, a)

class Pair(val left: int, val right: int)

object Pair
    apply(both: int) -> Pair = Pair(both, both)

main()
    val m = Meter(true)
    val p: (string) -> Pair = Pair
