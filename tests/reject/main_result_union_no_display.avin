// error: `main`'s error is shown by its `Display`, and `Shown | Hidden`, the error `main` answers, does not implement `Display`
// A union of errors is shown by its members' `Display`, so every member needs one: one without it
// refuses the whole union.
data Shown(n: int)

class Hidden(n: int)

main() -> Result[unit, Shown | Hidden] = Err(Shown(3))
