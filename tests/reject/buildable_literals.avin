// error: a set literal cannot build Ring[int], which does not implement `Buildable`, the trait a collection literal is built through; an impl of it gives `static newBuilder()`
// error: a sequence literal cannot build Tail, which does not implement `Buildable`, the trait a collection literal is built through; an impl of it gives `static newBuilder()`
// error: `unbounded` yields Vector[int], not C
// error: a map literal cannot build Ring[(string, int)], which does not implement `Buildable`, the trait a collection literal is built through; an impl of it gives `static newBuilder()`

// A literal is built only through the expected type's own `Buildable` conformance: a companion's
// method named `newBuilder` is not one, an `Iterable` without the trait is not built, a conformance
// inherited from a parent does not build the subclass, and a type parameter needs the trait as a
// bound.

class Bag(val items: List[int])

class BagBuilder: Builder[int, Bag]
  private var items: List[int] = Nil

  override addOne(element: int)
    items = element :: items

  override result() -> Bag = Bag(items)

  override clear()
    items = Nil

object Bag
  newBuilder() -> BagBuilder = BagBuilder()

class Ring[A](): Iterable[A]
  override iterator() -> Iterator[A] = Iterator.empty[A]()

abstract class Head: Iterable[int]
  override iterator() -> Iterator[int] = Iterator.empty[int]()

class HeadBuilder: Builder[int, Head]
  override addOne(element: int) = ()
  override result() -> Head = Tail()
  override clear() = ()

impl Buildable[int] for Head
  static newBuilder() -> HeadBuilder = HeadBuilder()

class Tail(): Head()

unbounded[C]() -> C = [1]

main()
  val bag: Bag = [1, 2]
  val ring: Ring[int] = {1}
  val tail: Tail = [1]
  val pairs: Ring[(string, int)] = {a: 1}
  val head: Head = [1]
