// `consumes:` names a handle parameter, or `self` in a method of a handle, as strings; a handle is
// kept or taken, once.
// error: `keeps:` makes the handle a binding answers keep what it names, and `takeAndKeep` answers no handle and is no method of one
// error: `t` is named twice by `keeps:` and `consumes:`: a handle is kept or taken, once
// error: `consumes:` names `self`, and `notMethod` is not a method of a C handle
// error: `consumes:` names `t`, of type `int`: what a C binding keeps or takes is a handle, and anything else crosses for the call alone
// error: `consumes:` names a parameter, or a list of them, as strings, as in `consumes: "profile"`

@c(type: "struct thing *", release: "thing_free", retain: "thing_ref")
class Counted

@c("int thing_take(struct thing *t)", consumes: "t", keeps: "t")
takeAndKeep(t: Counted) -> int

@c("int thing_take(struct thing *t)", consumes: "self")
notMethod(t: Counted) -> int

@c("int thing_take(int t)", consumes: "t")
notHandle(t: int) -> int

@c("int thing_take(struct thing *t)", consumes: 3)
notName(t: Counted) -> int

main() = 0
