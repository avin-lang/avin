trait Named

open class Animal(val label: string): Named

class Dog(label: string): Animal(label)

class Cat(label: string): Animal(label)

class Pen[T](val held: T)
  swap[U: T](other: U) -> Pen[T] = Pen(other)

pick[A, B: A](a: A, b: B) -> A = b

main()
  Pen[Dog](Dog("rex")).swap(Cat("tom"))
  Pen[Animal](Dog("rex")).swap(1)
  Pen[Dog](Dog("rex")).swap[Animal](Dog("tom"))
  pick[Dog, string](Dog("a"), "b")
  pick[Animal, Named](Dog("a"), Dog("b"))
