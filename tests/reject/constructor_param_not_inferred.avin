// error: cannot infer `F` for this call to `none`; write it, as in `none[Option](arguments)`
// error: cannot infer `G` for this call to `two`; write it, as in `two[Either](arguments)`
// A constructor parameter has no default: one that neither a written argument nor an argument's
// type decides is an error, where a plain type parameter would be `Nothing`.
none[F[_]](n: int) -> int = n

two[G[_, _]](n: int) -> int = n

main()
  println(none(3))
  println(two(4))
