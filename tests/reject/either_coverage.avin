// error: this `match` does not cover every Either[string, int] value
// error: this `match` does not cover every Either[string, int] value
// error: this `match` does not cover every Either[string, Option[int]] value
// error: a binding's pattern must match every Either[string, int] value
// error: `merge` is for `Either[A, A]`; this is `Either[string, int]`

// A match on an Either covers it only with both `Left` and `Right`, each covering its value; a
// generator's pattern must match every element; and `merge` needs the two sides to be one type.

onlyRight(e: Either[string, int]) -> int = e match
  Right(n) -> n

onlyLeft(e: Either[string, int]) -> string = e match
  Left(why) -> why

halfInner(e: Either[string, Option[int]]) -> int = e match
  Left(_) -> 0
  Right(Some(n)) -> n

main()
  val e: Either[string, int] = Right(1)
  val es: List[Either[string, int]] = [e]
  for Right(n) in es do println(n)
  println(e.merge)
