// error: expected Box[Shelf[int]], found Box[TallShelf[int]]
// error: expected (Animal) -> _, found (Dog) -> int
// error: expected Box[Shelf[int]], found Box[TallShelf[int]]
// error: expected Result[int, Dog], found Result[int, Cat]
// error: expected Sink[Shelf[_]], found Sink[TallShelf[int]]
// Inference sees a value of a subclass as one of its superclass only where a value is read out. At
// an invariant argument a box of a subclass is no box of the superclass, since the generic code may
// store a superclass instance in it; at a function's parameter a function taking a subclass is no
// function taking the superclass, since the generic code may pass it one; the same holds for a
// constructor inferred through its superclass's conformance. The expected type decides a
// constructor's written-out arguments before the arguments do, so they cannot widen it.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

impl[T, E] Mappable[T] for Result[T, E]

open class Animal(val name: string)

class Dog(n: string, val bark: int): Animal(n)

class Cat(n: string): Animal(n)

open class Shelf[A](val item: A): Mappable[A]
  map[B](f: (A) -> B) -> Shelf[B] = Shelf(f(item))

class TallShelf[A](x: A, val height: int): Shelf[A](x)

class Box[A](var v: A)

class Sink[-A](val take: (A) -> int)

keep[A](x: Box[Shelf[A]]) -> Box[Shelf[A]] = x

applyTo[B](f: (Animal) -> B, a: Animal) -> B = f(a)

barkOf(d: Dog) -> int = d.bark

keepF[F[_]: Mappable](x: Box[F[int]]) -> Box[F[int]] = x

second[F[_]: Mappable](x: F[int], y: F[int]) -> F[int] = y

drain[A](s: Sink[Shelf[A]], x: Shelf[A]) -> int = s.take(x)

main()
  val tall: Box[TallShelf[int]] = Box(TallShelf(1, 2))
  val k: Box[Shelf[int]] = keep(tall)
  println(applyTo(barkOf, Animal("cat")))
  println(keepF(tall))
  val dogs: Result[int, Dog] = Err(Dog("rex", 1))
  val cats: Result[int, Cat] = Err(Cat("tom"))
  val narrow: Result[int, Dog] = second(dogs, cats)
  val sink: Sink[TallShelf[int]] = Sink(t -> t.height)
  println(drain(sink, Shelf(1)))
