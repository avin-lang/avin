// A collection whose element type does not fit the Sysl function is reported at the binding, in
// each direction. Out of Sysl, a collection is made from a slice or a `Buf`, so a result that holds
// one names every Sysl type it could have come from.
// error: the Sysl binding `splitInts` does not match `sysl.text.split`: `Vector[int]` is made from a Sysl `[]int` or `Buf[int]`, and the value is none of these
// error: the Sysl binding `parentParts` does not match `sysl.path.parent`: `Option[Vector[string]]` is made from a Sysl `Option[[]string]` or `Option[Buf[string]]`, and the value is none of these
// error: the Sysl binding `joinInts` does not match `sysl.path.join_all`: 'parts' of 'sysl.path.join_all' is []const string, but []int was given
// error: the Sysl binding `upperAll` does not match `sysl.text.to_upper`: 's' of 'sysl.text.to_upper' is string, but []string was given

@sysl("sysl.text.split")
splitInts(s: string, sep: string) -> Vector[int]

@sysl("sysl.path.parent")
parentParts(p: string) -> Option[Vector[string]]

@sysl("sysl.path.join_all")
joinInts(parts: Vector[int]) -> string

@sysl("sysl.text.to_upper")
upperAll(s: Vector[string]) -> string

main() = 0
