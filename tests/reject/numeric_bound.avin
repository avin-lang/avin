// error: `string` does not conform to `Numeric`, the bound of `T` in `mean`
// error: `bool` does not conform to `Numeric`, the bound of `T` in `mean`
// error: `char` does not conform to `Numeric`, the bound of `T` in `mean`
// error: `byte` does not conform to `Numeric`, the bound of `T` in `mean`
// error: `Box` does not conform to `Numeric`, the bound of `T` in `mean`
// Only the numbers meet `Numeric`: not strings, which add, nor booleans, characters or bytes, nor a
// class that implements none of it.

mean[T: Numeric](xs: Vector[T]) -> real = xs.average

class Box(val n: int)

main()
  println(mean(["a", "b"]))
  println(mean([true]))
  println(mean(['a']))
  println(mean([byte(1)]))
  println(mean([Box(1)]))
