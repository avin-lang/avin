// Comparison patterns over chars leave the values outside their bounds uncovered, so clauses made
// only of them need a catch-all.
// error: the clauses of `hexValue` do not cover every argument; add a clause for the rest, such as `hexValue(_)`

hexValue(c: char) -> int
hexValue('0' <= c <= '9') = int(c) - int('0')
hexValue('a' <= c <= 'f') = int(c) - int('a') + 10
hexValue('A' <= c <= 'F') = int(c) - int('A') + 10

main() = println(hexValue('7'))
