// error: this `match` does not cover every string value; add an arm for the rest, such as `_`
// error: this pattern is string, but the value it matches is int
// error: this pattern is int, but the value it matches is string
// Literal patterns never cover all strings.
named(s: string) -> int = s match
  "a" -> 1
  "b" -> 2

mixed(n: int, s: string) -> int
  val x = n match
    "one" -> 1
    _ -> 2
  val y = s match
    1 -> 1
    _ -> 2
  x + y

main() -> int = 0
