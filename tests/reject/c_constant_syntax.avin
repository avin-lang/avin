// A C constant is a `val` with a declared type and no initializer, and its `@c` names the constant with
// `const:`, a C identifier.
// error: a C constant is a `val`: its value is the header's
// error: a C constant has no initializer: its value is the header's
// error: a C constant declares its type, an integer type, `real` or `string`, as in `val mltVersion: int`
// error: `@c` on a module-level value takes `const:`, the C constant it is, as a string: `@c(const: "LIBMLT_VERSION_INT")`
// error: `const:` names a C constant, and `1X` is not a C identifier

@c(const: "MUTABLE")
var mutable: int

@c(const: "GIVEN")
val given: int = 3

@c(const: "UNTYPED")
val untyped

@c(name: "X")
val wrongWord: int

@c(const: "1X")
val notIdentifier: int

main() = 0
