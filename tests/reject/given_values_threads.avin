// A closure that fills a call from a given captures it, so a thread's body, a `@sendable` function
// value of a function with a section, an executor's future and its task are each checked for it as for
// any captured value, and a given that is not sendable is an error there naming it. An actor's section
// is held to the rules of any actor parameter.
// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it uses `conn`, a `Conn`, whose field `used` is a `var`; make it a `val`
// error: a `@sendable () -> int` may use only sendable values from around it, but it uses `conn`, a `Conn`, whose field `used` is a `var`; make it a `val`
// error: what is passed for `body` of `Executor.future` may use only sendable values from around it, but it uses `conn`
// error: what is passed for `task` of `Executor.execute` may use only sendable values from around it, but it uses `conn`
// error: `Conn` does not conform to `Sendable`, so the actor `Worker` cannot take it as its parameter `conn`: its field `used` is a `var`; make it a `val`
import avin.threads.{Executor, spawn}

class Conn()
  var used = 0

query(using conn: Conn) -> int = conn.used

actor Worker(using conn: Conn) receives int
  receive
    n -> println(n + query())

main()
  given conn = Conn()
  spawn(() -> query()).join()
  val q: @sendable () -> int = query
  val pool = Executor.fixed(1)
  _ = pool.future(query())
  pool.execute(() -> println(query()))
  pool.shutdown()
