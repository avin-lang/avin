// error: the actor `Filler` may run on another thread, which shares the program's module-level state, but through `Box.v` → `Box.fill` it reaches `shared`, a module-level value holding a `Buffer[string]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: the actor `Own` may run on another thread, which shares the program's module-level state, but through `v` → `fill` it reaches `shared`, a module-level value holding a `Buffer[string]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: `Carry` does not conform to `Sendable`, so the actor `Taker` cannot receive it: its field `h` holds a `Holds`, whose field `xs` holds a `Buffer[int]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: `Carry` does not conform to `Sendable`, the bound of `M` in `spawn`: its field `h` holds a `Holds`, whose field `xs` holds a `Buffer[int]`, which is mutable; an immutable copy (`toVector`) is sendable
// An actor runs on the workers of an executor, so a `lazy val` field it reads may not reach
// module-level mutable state through its initializer: a field of an object a message carries, and
// the actor's own field. An initializer that reads a constructor parameter holding a mutable
// object leaves that object in the object, which is then not sendable.
import avin.actors.spawn
import avin.threads.Promise

val shared = Buffer[string]()

class Box(val n: int)
  lazy val v: int = fill()
  private fill() -> int
    for i in 0 ..< n do shared.append(s"a$i")
    n

data Msg
  Go(b: Box)
  Done(p: Promise[unit])

actor Filler receives Msg
  receive
    Go(b) -> println(b.v)
    Done(p) -> p.complete(())

actor Own receives int
  lazy val v: int = fill()
  fill() -> int
    shared.append("o")
    1
  receive
    n -> println(v + n)

class Holds(xs: Buffer[int])
  lazy val v: int = xs.length

data Carry
  Take(h: Holds)

actor Taker receives Carry
  receive
    Take(h) -> println(h.v)

main()
  val a = spawn(Filler())
  a.tell(Go(Box(3)))
  val p = Promise[unit]()
  a.tell(Done(p))
  p.future.await()
  spawn(Own()).tell(1)
  spawn(Taker()).tell(Take(Holds(Buffer[int]())))
