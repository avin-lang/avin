// error: `b`, a `Buffer[int]`, which is mutable
// error: `n`, a `var`
// A task given to `execute` runs on another thread, so it is checked as any `@sendable` body is: it
// captures no mutable value and no `var`.
import avin.threads.Executor

main()
    val b = Buffer[int]()
    var n = 0
    Executor.shared().execute(() -> b.append(1))
    Executor.shared().execute(() -> n += 1)
