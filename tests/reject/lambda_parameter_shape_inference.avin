// error: cannot infer the type of `p`; write it, as in `(p: int) -> body`
// error: cannot infer the type of `b`; write it, as in `(b: int) -> body`
// error: expected Promise[string], found Promise[int]
// error: cannot infer the type of `r`; write it, as in `(r: int) -> body`
// error: expected Promise[int], found Promise[string]
// A lambda's parameter of a known shape with an open type argument takes the argument from its body,
// and only from there: a body that never uses the parameter leaves it open, and it is reported once,
// at the parameter; a body using it at two different types is a mismatch at the second; and a type
// the expected result already decides is not decided again by the body.
import avin.threads.Promise
import avin.actors.ActorRef

data Msg
  Count(reply: Promise[int])
  Named(reply: Promise[string])
  Ask(reply: ActorRef[int])
  Quiet

request[T: Sendable](f: (Promise[T]) -> Msg) -> int = 0
answer[T: Sendable](f: (Promise[T]) -> Msg) -> T = fail("not answered")
replyType[R: Sendable](make: (ActorRef[R]) -> Msg) -> int = 0
data Box[T](v: T)
width[T](f: (Box[T]) -> int) -> int = 0

main() -> int
  val a = request(p -> Quiet)
  val b = width(b -> 3)
  val c = request(p ->
    if true then Count(p) else Named(p))
  val d = replyType(r -> Quiet)
  val e: string = answer(p -> Count(p))
  a + b + c + d
