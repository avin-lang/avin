// A trailing block is given to the callee's last parameter, which must be by-name or a function, and
// must not be given already.

plain(n: int, last: int) -> int = n + last

none() -> int = 0

full(n: int, body: -> int) -> int = body

spread(n: int, rest: int*) -> int = n

main() -> int
  val a = plain(1)
    2
  val b = none
    3
  val c = full(1, 2)
    3
  val f: (int) -> int = x -> x
  val d = f
    4
  val e = spread(1)
    5
  0
