import avin.collections.mutable.{Map as MutableMap}
import avin.threads.{Future}

data JobMsg
  Start(id: int)
  Fill(chunk: Buffer[byte])

send[T: Sendable](value: T) -> string = "sent"

main()
  println(send(Fill(Buffer[byte]())))
  println(send(Array.fill(2, 0)))
  println(send(MutableMap[string, int]()))
  println(send([Deque[int]()]))
  println(send(Future(Buffer[int]())))
