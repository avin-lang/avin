// error: this `match` does not cover every int value; add an arm for the rest, such as `_`
// error: this `match` does not cover every bool value; add an arm for the rest, such as `_`
// error: this `match` does not cover every int value; add an arm for the rest, such as `_`
// error: this `match` does not cover every char value; add an arm for the rest, such as `_`
// Literals and ranges never cover an integer type; guarded arms do not count.
literals(n: int) -> int = n match
    0 -> 1
    1..10 -> 2

only_true(flag: bool) -> int = flag match
    true -> 1

guarded(n: int) -> int = n match
    x if x > 0 -> 1
    x if x <= 0 -> 2

letters(c: char) -> int = c match
    'a'..'z' | 'A'..'Z' -> 1

main() -> int
    // Both bool values, through alternatives or separately, do cover.
    val both = true match
        true | false -> 1
    val split = false match
        false -> 1
        true -> 2
    0
