// error: this `match` does not cover every int value, such as `-1`; add an arm for it, or `_` for the rest
// error: this `match` does not cover every bool value, such as `false`; add an arm for it, or `_` for the rest
// error: this `match` does not cover every int value; add an arm for the rest, such as `_`
// error: this `match` does not cover every char value, such as `' '`; add an arm for it, or `_` for the rest
// Literals and ranges cover an integer type only when they leave no value out; guarded arms do not
// count.
literals(n: int) -> int = n match
    0 -> 1
    1..10 -> 2

only_true(flag: bool) -> int = flag match
    true -> 1

guarded(n: int) -> int = n match
    x if x > 0 -> 1
    x if x <= 0 -> 2

letters(c: char) -> int = c match
    'a'..'z' | 'A'..'Z' -> 1

main() -> int
    // Both bool values, through alternatives or separately, do cover.
    val both = true match
        true | false -> 1
    val split = false match
        false -> 1
        true -> 2
    // Ranges and literals that reach both ends of byte cover it.
    val octet = 0x10 match
        0x00..<0x80 -> 1
        0x80..0xfe -> 2
        0xff -> 3
    0
