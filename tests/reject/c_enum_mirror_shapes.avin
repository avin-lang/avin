// A C enum mirror's variants are enumerators: one with fields, type parameters, an `enum:` that is a
// struct, two variants holding one enumerator, and `@c` on a variant of a type that mirrors nothing
// are refused.
// error: the variant `Holding` of the C enum mirror `WithFields` has fields, and a mirror's variants are enumerators, which hold none
// error: a C enum mirror has no type parameters: it mirrors one C enum
// error: `enum:` names the C enum the type mirrors, and `struct s` is not an enumeration or an integer type
// error: the variant `Again` of the C enum mirror `Repeated` mirrors `E_ONE`, as a variant before it does
// error: `@c` on a variant names the enumerator a variant of a C enum mirror holds, and `Plain` mirrors no C enum

@c(enum: "e_t", prefix: "E_")
data WithFields
  Plain
  Holding(x: int)

@c(enum: "e_t", prefix: "E_")
data Generic[T]
  One

@c(enum: "struct s", prefix: "S_")
data Struct
  One

@c(enum: "e_t", prefix: "E_")
data Repeated
  One
  @c("E_ONE")
  Again

data Plain
  @c("E_ONE")
  One

main() = 0
