// error: `A` does not conform to `Ord`, the bound of `F`'s argument in `F[_: Ord]`
// error: `Dog` does not conform to `Ord`, the bound of `F`'s argument in `F[_: Ord]`
// error: `B` does not conform to `Ord`, the bound of `F`'s argument in `F[_: Ord]`
// error: `TreeSet` bounds its parameter `A` by `Ord`, and `F` may be applied to any type, so `TreeSet` is no constructor for `F[_]`
// error: `TreeSet` bounds its parameter `A` by `Ord`, which `F[_: Hash]` does not promise of the types `F` is applied to, so `TreeSet` is no constructor for it
// Every `F[X]` a declaration writes is held to the bounds of `F`'s hole where it is written, so a
// generic definition's errors are reported at the definition; and a type whose parameter is bounded
// is a constructor only for a hole whose bounds imply that bound.
class Dog(val name: string)

sorted[F[_: Ord], A](x: F[A]) -> int = 0

dogs[F[_: Ord]](n: int) -> Option[F[Dog]] = None

class Index[F[_: Ord], B](val keys: Vector[F[B]])

loose[F[_]](x: F[int]) -> F[int] = x

hashed[F[_: Hash]](x: F[int]) -> F[int] = x

main()
  println(loose(TreeSet(1)))
  println(hashed(TreeSet(2)))
