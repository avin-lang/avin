// error: `One[int]` has refined variants: a field of one is not read by name yet
// error: `IntLit` is a variant of `Expr`, which has refined variants: a pattern cannot take one of its values apart yet
// error: `IntLit` is a variant of `Expr`, which has refined variants: a pattern cannot take one of its values apart yet
// error: `Hidden` hides `T`, named by its fields and not by its result: a value of a variant with hidden type parameters cannot be made yet
// error: `Ask` hides `R`, named by its fields and not by its result: a value of a variant with hidden type parameters cannot be made yet
// A field of a refined type's one variant is not read by name, an `is` test and a clause take no
// refined value apart, and a variant hiding a parameter of its type, or of its own in a plain type,
// makes no value, until the steps that build them.

data One[T]
  Mk(value: int) -> One[int]

data Expr[T]
  IntLit(value: int) -> Expr[int]
  Hidden(value: T, show: (T) -> string) -> Expr[string]

data Msg
  Ask[R](reply: (R) -> unit)

valueOf(e: Expr[int]) -> int
valueOf(IntLit(n)) = n

main()
  val o = Mk(1)
  println(o.value)
  val e = IntLit(2)
  println(e is IntLit(_))
  val h = Hidden(3, (x: int) -> "three")
  val m = Ask((x: int) -> ())
