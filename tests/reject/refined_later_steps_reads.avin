// error: `One[bool]` has no values: no variant of `One` makes one
// error: the field `items` of `Hold` has a type a `Holder[T]` does not determine; take the value apart with `match`
// error: `Holder[int]` has no values: no variant of `Holder` makes one
// error: `Hidden` hides `T`, named by its fields and not by its result: a value of a variant with hidden type parameters cannot be made yet
// error: `Ask` hides `R`, named by its fields and not by its result: a value of a variant with hidden type parameters cannot be made yet
// A field of a refined type's one variant is read by name where the instance says what the field's
// type is: an instance the variant cannot make has no values, and one that leaves a parameter of the
// field's type open is taken apart with `match`. A variant hiding a parameter of
// its type, or of its own in a plain type, still makes no value.

data One[T]
  Mk(value: int) -> One[int]

data Holder[T]
  Hold[A](items: Vector[A]) -> Holder[Vector[A]]

data Expr[T]
  IntLit(value: int) -> Expr[int]
  Hidden(value: T, show: (T) -> string) -> Expr[string]

data Msg
  Ask[R](reply: (R) -> unit)

none(o: One[bool]) -> int = o.value

open[T](h: Holder[T]) -> int = h.items.length

empty(h: Holder[int]) -> int = h.items.length

main()
  val h = Hidden(3, (x: int) -> "three")
  val m = Ask((x: int) -> ())
