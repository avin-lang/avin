// error: `Bad` does not conform to `Sendable`, the bound of `T` in `send`: its field `b` holds a `Buffer[int]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: `Fn` does not conform to `Sendable`, the bound of `T` in `send`: its field `f` holds a `(int) -> int`, which is a function value, whose type does not say what it captures
// error: `Settings` does not conform to `Sendable`, the bound of `T` in `send`: its field `b` holds a `Buffer[int]`, which is mutable; an immutable copy (`toVector`) is sendable
// A `lazy val` field is sendable only where its type is: one holding a mutable collection or a
// function value makes its class, its object, or a generic class at such an argument, unsendable,
// as an eager field would.
class Gen[T](x: T)
  lazy val v: Vector[T] = [x]

class Bad(n: int)
  lazy val b: Buffer[int] = Buffer[int]()

class Fn(n: int)
  lazy val f: (int) -> int = x -> x + n

object Settings
  lazy val b: Buffer[int] = Buffer[int]()

send[T: Sendable](x: T) -> unit = ()

main() -> int
  send(Gen(Buffer[int]()))
  send(Bad(1))
  send(Fn(1))
  send(Settings)
  0
