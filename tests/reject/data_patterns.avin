data Shape
    Circle(radius: int)
    Rect(width: int, height: int)

data Option[+T]
    Some(value: T)
    None

f(s: Shape) -> int = s match
    Square(x) -> x
    Circle(a, b) -> a
    Some(x) -> 1
    Rect -> 2
    _ -> 0

main()
    val g = Circle
