// error: `|` is the language's operator on int, and no method can redefine it
// error: `~` is the language's operator on byte, and no method can redefine it
// error: `~` needs an integer or a byte, not Bits
// error: `Bits` has no method `^`
// error: `int` has no method `~` to call infix
// A type other than the integers may name methods `|`, `&`, `^` and `~`, called between two
// operands; the integers' and bytes' are the machine's, and prefix `~` is theirs alone.
class Bits(val n: int)
    |(other: Bits) -> Bits = self
    ~(other: Bits) -> Bits = self

impl int
    |(other: int) -> int = self

impl byte
    ~(other: byte) -> byte = self

main()
    val b = Bits(1)
    val c = ~b
    val d = b ~ b
    val e = 1 ~ 2
    val f = b ^ b
