// error: each round of the cycle `Tree` -> `Tree` passes `Nest[T]` for `T`
// error: each round of the cycle `inner` -> `inner` passes `Nest[U]` for `U`
// error: each round of the cycle `viaLambda` -> `viaLambda` passes `Nest[T]` for `T`
// error: each round of the cycle `Walker.visit` -> `drive` -> `Walker.visit` passes `Nest[T]` for `T`
// error: each round of the cycle `Echo.echo` -> `Echo.echo` passes `Nest[A]` for `A`
// Growth through a data type naming itself at a larger instance in a field, a generic local
// function, a lambda calling its enclosing function, a trait method with type parameters of its own
// called through the trait, and a trait's default body.

data Nest[T](x: T)

data Tree[T]
  Leaf(value: T)
  Deeper(inner: Tree[Nest[T]])

outer[T](x: T, n: int) -> int
  inner[U](y: U, k: int) -> int = if k == 0 then 0 else inner(Nest(y), k - 1)
  inner(x, n)

viaLambda[T](x: T, n: int) -> int
  val f = (y: T) -> viaLambda(Nest(y), n - 1)
  if n == 0 then 0 else f(x)

trait Visitor
  visit[T](x: T, n: int) -> int

class Walker(): Visitor
  override visit[T](x: T, n: int) -> int = if n == 0 then 0 else drive(self, Nest(x), n - 1)

drive[T](v: Visitor, x: T, n: int) -> int = v.visit(x, n)

trait Echo[A]
  value() -> A
  echo(n: int) -> int = if n == 0 then 0 else Holder(Nest(value())).echo(n - 1)

class Holder[A](val a: A): Echo[A]
  override value() -> A = a

main() -> int
  val t: Tree[int] = Leaf(1)
  outer(1, 3) + viaLambda(1, 3) + drive(Walker(), 1, 3) + Holder(1).echo(3)
