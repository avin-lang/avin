// error: `Normal` is a variant; a comparison binds a name or `_`
// error: this arm is never reached: the arm `Normal` on line 32 already matches every value it would
// error: `Bold` has no fields; write it without parentheses
// A data type's companion object shares the name of the type's own variant, and so cannot share a
// name another type's variant also has. A shared name is still a variant in a comparison pattern,
// and once the expected type decides it, it is that type's variant, with that variant's fields.
data Point(x: int)

object Point
  origin() -> Point = Point(0)

data Mark
  Point
  Cross

data Slant
  Normal
  Italic

data Weight
  Normal(by: int)
  Bold

pick(n: int) -> int = n match
  Normal < 3 -> 0
  _ -> 1

slant(s: Slant) -> int = 0

weight(w: Weight) -> int = w match
  Normal -> 0
  Normal(1) -> 1
  _ -> 2

main()
  println(weight(Bold()))
