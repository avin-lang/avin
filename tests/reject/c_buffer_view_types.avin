// What a view binding answers: a `ByteView`, or with `writable` a `MutByteView` over memory that is not
// `const`, perhaps in an `Option`, lent from a C pointer.
// error: the result of the C binding `notMutable` is `ByteView` in Avin and `unsigned char *` in C: a `writable` binding lends a `MutByteView`
// error: the result of the C binding `notWritable` is `MutByteView` in Avin and `unsigned char *` in C: a `MutByteView` is lent by a binding marked `writable`
// error: the result of the C binding `constant` is `MutByteView` in Avin and `const unsigned char *` in C: C lends this memory `const`, so it is not `writable`
// error: the result of the C binding `notView` is `int` in Avin and `unsigned char *` in C: the memory a binding lends is a `ByteView`, or with `writable` a `MutByteView`, perhaps in an `Option` for null
// error: the result of the C binding `notPointer` is `ByteView` in Avin and `int` in C: `view` lends the memory C answers a pointer to, and C answers no pointer
import avin.c.{ByteView, MutByteView}

@c(type: "struct frame *", release: "free")
class Frame
  @c("unsigned char *frame_data(struct frame *self)", view, writable, length: "4")
  notMutable() -> ByteView

  @c("unsigned char *frame_data(struct frame *self)", view, length: "4")
  notWritable() -> MutByteView

  @c("const unsigned char *frame_cdata(struct frame *self)", view, writable, length: "4")
  constant() -> MutByteView

  @c("unsigned char *frame_data(struct frame *self)", view, length: "4")
  notView() -> int

  @c("int frame_size(struct frame *self)", view, length: "4")
  notPointer() -> ByteView

main() = 0
