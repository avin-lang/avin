// error: a machine declares its states: `NoStates` has no `state` block
// error: the first state is where `Starts` starts, so it takes no parameters
// error: a machine names the type of the events it handles: `machine NoEvents receives Event`
// error: state `S` has one `enter` block
// error: `enter` belongs to a state: write it inside the `state` block it runs for
// The shape of a machine declaration: states, a first state without parameters, the event type
// after `receives`, one `enter` per state and none outside a state.
data Ev
    A

machine NoStates receives Ev
    var x = 1

machine Starts receives Ev
    state First(n: int)
        A -> stay

machine NoEvents
    state S
        _ -> stay

machine Twice receives Ev
    state S
        enter
            println("a")
        enter
            println("b")
        A -> stay

machine Outside receives Ev
    enter
        println("x")
    state S
        A -> stay

main() -> int = 0
