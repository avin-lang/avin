// error: a comma inside brackets ends the `select`, so this arm's body is one value; write a tuple in parentheses, `(a, b)`
// error: expected `)`
// A middle arm's comma list inside brackets is not a tuple: the comma ends the `select`.
import avin.threads.Channel

pairUp(t: (int, int)) -> int = t.0

main()
  val c = Channel[int](1)
  println(pairUp(select
    c.receive() as Some(x) -> x, 2
    else (0, 0)))
