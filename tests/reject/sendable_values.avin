// error: `Any` does not conform to `Sendable`, the bound of `T` in `send`: it may hold a value of any type
// error: `(int) -> int` does not conform to `Sendable`, the bound of `T` in `send`: it is a function value, whose type does not say what it captures
// error: `(int, Log)` does not conform to `Sendable`, the bound of `T` in `send`: its part 2 is a `Log`, whose field `count` is a `var`; make it a `val`
// error: `T` does not conform to `Sendable`, the bound of `T` in `send`: it is a type parameter that may stand for any type; bound it, as in `[T: Sendable]`
// error: `Map[string, Buffer[int]]` does not conform to `Sendable`, the bound of `T` in `send`: its type argument `Buffer[int]` is mutable
// Values that are not sendable: `Any`, a function value held in a `val` of a plain function type, a tuple with a mutable part, an unbounded
// type parameter passed to bounded code, and an immutable map of mutable values.
class Log
  var count = 0

send[T: Sendable](value: T) -> string = "sent"

generic[T](value: T) -> string = send(value)

main()
  val a: Any = 1
  println(send(a))
  val f = (x: int) -> x + 1
  println(send(f))
  println(send((1, Log())))
  println(generic(1))
  println(send(Map[string, Buffer[int]]()))
