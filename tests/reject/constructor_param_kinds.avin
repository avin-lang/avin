// error: `F` is a constructor, so it is a type only with its 1 type argument, as in `F[A]`, not 0
// error: `A` takes no type arguments
// error: `F` is a constructor, so it is a type only with its 1 type argument, as in `F[A]`, not 2
// error: `int` is a type; `F[_]` takes a constructor of one argument, such as `Option`
// error: `Vector` takes one argument and `G` two
// A constructor parameter is a type only applied to as many arguments as it has holes, a type
// parameter takes no arguments, and at a call a constructor parameter takes a constructor of its
// own arity, never a type.
same[F[_], A](x: F[A]) -> F[A] = x
both[G[_, _]](x: G[int, string]) -> G[int, string] = x

bare[F[_]](x: F) -> int = 0
applied[A](x: A[int]) -> int = 0
over[F[_]](x: F[int, int]) -> int = 0

main()
  println(same[int, int](3))
  println(both[Vector](3))
