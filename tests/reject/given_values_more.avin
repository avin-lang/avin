// The neighbours of a function value with a section: a method value, a constructor and an overload
// chosen by the expected type are filled where they are taken, the error where no given is in scope
// being the call's; an overload is chosen by the parameters before its section alone; and a direct call
// writing more positional arguments than those parameters is told how many it takes.
// error: `write` needs a `Tx` for `tx`, and no given of that type is in scope
// error: `Order` needs a `Tx` for `tx`, and no given of that type is in scope
// error: no overload of `describe` has the parameter types of (int, Tx) -> string
// error: `tag` takes 0 arguments, not 2
// error: `insert` takes 1 argument, not 3

data Tx(id: int)

class Log()
  write(s: string, using tx: Tx) -> string = s

class Order(id: int, using tx: Tx)

insert(row: int, using tx: Tx) -> int = row + tx.id

tag(using tx: Tx) -> int = tx.id

describe(n: int, using tx: Tx) -> string = s"$n"

describe(s: string, using tx: Tx) -> string = s

main()
  val log = Log()
  val w: (string) -> string = log.write
  val o: (int) -> Order = Order
  given t = Tx(1)
  val d: (int, Tx) -> string = describe
  println(tag(t, t))
  println(insert(1, 2, 3))
