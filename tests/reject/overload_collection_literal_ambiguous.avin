// error: no overload of `both` accepts these arguments; the overloads are `both(m: Map[string, Named])`, `both(m: Map[string, Shown])`
// error: no overload of `wrong` accepts these arguments; the overloads are `wrong(m: Map[string, Named])`, `wrong(n: int)`
// A collection literal two overloads could each take leaves the call unchosen, and one no overload
// can take is still refused.
trait Named
  name -> string

trait Shown
  shown -> string

impl Named for string
  name -> string = self

impl Shown for string
  shown -> string = self

both(m: Map[string, Named]) -> int = 1
both(m: Map[string, Shown]) -> int = 2

wrong(m: Map[string, Named]) -> int = 1
wrong(n: int) -> int = 2

main()
  println(both({"a": "x"}))
  println(wrong({"a": 1.5}))
