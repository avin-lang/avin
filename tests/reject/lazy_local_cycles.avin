// error: the `lazy val` `n` needs its own value to initialize: `n` → `n`
// error: the `lazy val` `outer` needs its own value to initialize: `outer` → `inner` → `outer`
// error: the `lazy val` `viaHelper` needs its own value to initialize: `viaHelper` → `viaHelper`
// error: the `lazy val` `inMethod` needs its own value to initialize: `inMethod` → `inMethod`
// error: the `lazy val` `fresh` needs its own value to initialize: `fresh` → `fresh`
// A local `lazy val` is held to the rule a field's or a module-level one's is: refused when its
// initializer's own code reads it, directly, through another local lazy value, through a local
// function it calls, in a method, and in a loop body, where each pass makes a fresh one.
direct() -> int
  lazy val n: int = n + 1
  n

chain() -> int
  lazy val outer: int =
    lazy val inner: int = outer + 1
    inner * 2
  outer

helper() -> int
  lazy val viaHelper: int = twice()
  twice() -> int = viaHelper * 2
  viaHelper

class Box(seed: int)
  compute() -> int
    lazy val inMethod: int = seed + inMethod
    inMethod

passes() -> int
  var total = 0
  for i in 0 ..< 3
    lazy val fresh: int = i + fresh
    total += fresh
  total

main() = ()
