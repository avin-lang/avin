// error: `int` has no method `&&=`, and `&&` is not a method that `&&=` can assign through
// error: `a` is a `val`; only a `var` can be assigned
// error: `Bag` has no method `++:=`, and `++:` is not a method that `++:=` can assign through
// error: `Bag` has no method `<>` to call infix
// error: `+:=` needs two values of one type, not Bag and int
class Bag(val items: Vector[int])
  ++(other: Bag) -> Bag = self
  ++:(other: Bag) -> Bag = self

main()
  var n = 1
  n &&= 2
  val a = Bag([1])
  a ++= a
  var b = a
  b ++:= a
  b <>= a
  b +:= 1
