// error: `Id` is a generic type, and a type pattern names its type arguments, as in `_: Id[int]`
// error: `Tagged` is a generic type, and a type pattern names its type arguments, as in `_: Tagged[int, int]`
// error: `Box` is a generic type, and a type pattern names its type arguments, as in `_: Box[int]`
// error: `Name` is a type, so it cannot name a value: in a pattern it tests for the type, and `x: Name` binds a value of it
// error: `Text` is a type, so it cannot name a value: in a pattern it tests for the type, and `x: Text` binds a value of it
// An opaque type's name and an alias's name in a pattern test for the type, as any type's name does:
// a generic one alone, which names no type arguments, is refused, and no value is named after one.

opaque type Id[T] = int
opaque type Tagged[K, V] = string
type Box[T] = Option[T]
opaque type Name = string
type Text = string

ided(x: Any) -> bool = x is Id

tagged(x: Any) -> bool = x match
  Tagged -> true
  _ -> false

boxed(x: Any) -> bool = x is Box

local() -> int
  val Name = 3
  Name

param(Text: int) -> int = Text

main() = 0
