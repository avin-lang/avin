// error: `B` is declared after `A`; a type parameter bounding another is declared before it, as in `[B, A: B]`
// error: `T` is declared after `U`; a type parameter bounding another is declared before it, as in `[T, U: T]`
// A cycle of type parameters bounding one another is refused at the bound naming a later parameter.
cycle[A: B, B: A](a: A) -> unit = ()

class Pen[V](val held: V)
  spin[U: T, T: U](u: U) -> unit = ()

main() = ()
