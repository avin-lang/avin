// error: `+` needs two values of one type, not BigDecimal and real; a `real` is converted to a `BigDecimal` only explicitly, by `BigDecimal.fromRealShortest(x)` or `BigDecimal.fromRealExact(x)`
// error: `*` needs two numbers of one type, not real and BigDecimal; a `real` is converted to a `BigDecimal` only explicitly
// error: `+=` needs two values of one type, not BigDecimal and real; a `real` is converted
// error: `<` cannot compare BigDecimal with real
// error: a decimal literal does not match a BigDecimal as a pattern; compare it with `==`, as in `if x == 0.5`
// A `real` never meets a `BigDecimal`: arithmetic, compound assignment and comparison between them are
// errors that name the explicit conversions, and a decimal literal is no pattern for one.
main()
  val d: BigDecimal = 1.5
  val r = 2.5
  println(d + r)
  println(r * d)
  var e: BigDecimal = 0
  e += r
  println(d < r)
  d match
    0.5 -> println("half")
    _ -> println("other")
