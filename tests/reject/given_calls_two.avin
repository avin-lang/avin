// Two givens that fit at the nearest level make the call an error naming both, with each one's type
// and line: two of a block, two contextual parameters of the function, two of an object's body, two of
// the module. A nearer level holding one fit would have won outright.
// error: two givens fit `log: Logger` of `who` here: `file` (a `FileLogger`, line 32) and `plain` (a `Plain`, line 33); pass `log = …`
// error: two givens fit `log: Logger` of `who` here: `a` (a `FileLogger`, line 37) and `b` (a `Plain`, line 37); pass `log = …`
// error: two givens fit `log: Logger` of `who` here: `one` (a `FileLogger`, line 27) and `two` (a `Plain`, line 28); pass `log = …`
// error: two givens fit `log: Logger` of `who` here: `moduleFile` (a `FileLogger`, line 23) and `modulePlain` (a `Plain`, line 24); pass `log = …`

trait Logger
  name() -> string

class Plain(label: string): Logger
  override name() -> string = label

class FileLogger(path: string): Logger
  override name() -> string = path

who(using log: Logger) -> string = log.name()

// One given of the parameter's own type beside it is no help: each conforms.
plainOnly(using p: Plain) -> string = p.name()

given moduleFile = FileLogger("m")
given modulePlain = Plain("m")

object Holder
  given one = FileLogger("o")
  given two = Plain("o")
  read() -> string = who()

main()
  given file = FileLogger("f")
  given plain = Plain("p")
  println(who())
  println(plainOnly())

params(using a: FileLogger, b: Plain) -> string = who()

moduleLevel() -> string = who()
