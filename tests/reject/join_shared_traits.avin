// Two classes with no common superclass that share several unrelated traits have no single type to
// agree on, and every join that fails for that reason names the traits; a written type settles it.

trait Swims
    swim() -> int

trait Flies
    fly() -> int

trait Sings
    sing() -> int

class Duck: Swims, Flies, Sings
    override swim() -> int = 1
    override fly() -> int = 2
    override sing() -> int = 3

class Goose: Swims, Flies
    override swim() -> int = 3
    override fly() -> int = 4

class Robin: Swims, Flies, Sings
    override swim() -> int = 5
    override fly() -> int = 6
    override sing() -> int = 7

main()
    val c = true
    val bird = if c then Duck() else Goose()
    val armed = 1 match
        1 -> Duck()
        _ -> Goose()
    val flock = [Duck(), Goose()]
    var n = 0
    val left = loop
        n += 1
        if n == 1 then break Duck()
        break Goose()
    val three = if c then Duck() else Robin()
    // A written type is the answer, and so is an expected one.
    val written: Swims = if c then Duck() else Goose()
    println(written.swim())
