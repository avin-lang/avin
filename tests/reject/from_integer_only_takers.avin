// error: `==` cannot compare BigInt with string
// error: `*=` needs two numbers of one type, not int and long; write `int(l)`
// error: `*` needs two numbers of one type, not int and long; write `long(i)`
// error: `+` needs two values of one type, not Money and int
// error: integer literal does not fit in long
// Only a type implementing `FromInteger` takes integers: two integer widths still meet only through a
// conversion, a type without the trait takes none, and a literal where a `long` is expected must
// still fit one.
data Money(cents: long)

impl Add for Money
  add(other: Money) -> Money = Money(cents + other.cents)
  static zero() -> Money = Money(0)

main()
  val big = BigInt(5)
  println(big == "5")
  val l: long = 2
  var i: int = 1
  i *= l
  i = i * l
  val k = 4
  println(Money(1) + k)
  val x: long = 123456789012345678901234567890
