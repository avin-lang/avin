// error: a union in a type pattern is written in parentheses, `x: (int | string)`
// error: this `match` does not cover every `int | string` value, such as `_: string`
// error: `int | string` has no member `charCount`: its members share no type that has one; take it apart with a `match` or `is` first
// error: the clauses of `size` do not cover every argument; add a clause for the rest, such as `size(_: string)`
// error: this pattern can match no member of `int | string`
// A union in a type pattern is parenthesized; a guard does not cover a member; the union keeps its
// type after an `is`; clauses that leave a member out do not cover; a pattern of no member's kind
// matches nothing.

written(v: int | string | bool) -> string = v match
    x: int | string -> "int or string"
    _: bool -> "bool"

guarded(v: int | string) -> string = v match
    n: int -> "int"
    s: string if s.isEmpty -> "empty"

narrowed(v: int | string) -> int
    if v is _: string then return v.charCount
    0

size(x: int | string) -> int
size(n: int) = n

charOf(v: int | string) -> string = v match
    'c' -> "c"
    _ -> "other"

main() = 0
