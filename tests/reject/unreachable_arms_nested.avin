// error: this arm is never reached: the arm `Some(n)` on line 13 already matches every value it would
// error: this arm is never reached: the arms before it already match every value it would
// error: this arm is never reached: the arm `_ :: rest` on line 24 already matches every value it would
// error: this arm is never reached: the arm `Some(Shut)` on line 28 already matches every value it would; `Shut` binds a new value there, since no variant `Shut` is in scope
// error: this arm is never reached: the arm `whole @ (Some(_) | None)` on line 33 already matches every value it would
// Unreachable arms inside nested patterns: a variant's fields, a tuple's parts, a list, a sequence,
// alternatives and a named pattern, and a name inside a variant that binds where a variant was meant.
data Phase
  Open
  Closing

nestedVariant(o: Option[int]) -> int = o match
  Some(n) -> n
  Some(0) -> 0
  None -> -1

tupleParts(p: (bool, int)) -> int = p match
  (true, _) -> 1
  (false, n) -> n
  (_, 0) -> 0

listShapes(xs: List[int]) -> int = xs match
  [] -> 0
  _ :: rest -> 1
  x :: y :: _ -> 2

innerName(o: Option[Phase]) -> int = o match
  Some(Shut) -> 1
  Some(Open) -> 2
  None -> 0

alternativesAndNamed(o: Option[int]) -> int = o match
  whole @ (Some(_) | None) -> 1
  Some(5) -> 5

main() = ()
