// error: `foo"…"` names no interpolator: `StringContext` has no method `foo` here
// error: `+` joins two strings, not a string and int
// error: expected int, found string
// error: expected int, found string
// An interpolator is checked as the call it is: its name must be a method of `StringContext`, its
// holes must suit the method's parameters, and its value has the method's result type.
trait Sql
    sql(args: int*) -> string

impl Sql for StringContext
    sql(args: int*) -> string = parts.mkString("?")

main()
    val name = "x"
    print(foo"a $name ${name + 1}")
    print(sql"a $name")
    val n: int = raw"a"
