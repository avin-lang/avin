// error: this arm is never reached: the arm `[_, rest*]` on line 10 already matches every value it would
// error: this arm is never reached: the arm `Some(_)` on line 15 already matches every value it would
// error: this arm is never reached: the arm `n < 0` on line 19 already matches every value it would
// error: this arm is never reached: the arm `_` on line 25 already matches every value it would
// error: this arm is never reached: the arm `'α'..'ω'` on line 29 already matches every value it would
// More shapes: sequences by length, a rest, a generic type's instance, the extremes of an integer
// type, and a guarded arm that hides nothing while the arm after it is still covered.
sequence(v: Vector[int]) -> int = v match
    [] -> 0
    [_, rest*] -> 1
    [a, b] -> 2

generic[T](o: Option[T]) -> int = o match
    None -> 0
    Some(_) -> 1
    Some(x) -> 2

extremes(n: int) -> int = n match
    n < 0 -> -1
    0 <= n <= 2147483647 -> 1
    -2147483648 -> 2

afterGuard(n: int) -> int = n match
    n if n > 0 -> 1
    _ -> 0
    5 -> 5

unicode(c: char) -> int = c match
    'α'..'ω' -> 1
    'λ' -> 2
    _ -> 0

main() = ()
