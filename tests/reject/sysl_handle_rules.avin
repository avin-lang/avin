// A Sysl handle is made only by the bindings that return one, holds its Sysl value and nothing
// else, and crosses back into Sysl only as the receiver of its own methods.
// error: a Sysl handle has no parameters: the bindings that return one make it
// error: a Sysl handle holds its Sysl value and nothing else, so its body declares only methods
// error: `Crc32` is a handle on the Sysl type `sysl.checksum.Crc32`, so only a Sysl binding that returns one makes it
// error: `Crc32` has no member `state`
// error: `Crc32` cannot cross to Sysl: a Sysl handle goes back into Sysl only as the receiver of its own methods

@sysl("sysl.checksum.Crc32")
class Crc32
    finish() -> long

@sysl("sysl.checksum.Crc32")
class Seeded(seed: int)
    val extra = 1
    finish() -> long

@sysl("sysl.hint.black_box")
same(c: Crc32) -> Crc32

// The Sysl value's fields are not the handle's.
peek(c: Crc32) -> long = c.state

main()
    val c = Crc32()
