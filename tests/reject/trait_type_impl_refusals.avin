// error: `Shape` does not implement Show's `twice`; a trait type takes no default bodies, so its impl implements every method of the trait
// error: `Shape` does not implement Base's `base`, which `Show` requires; a trait type's impl implements every method of the trait and of those it requires
// error: `impl Show for Solid` overlaps the conformance of every `Solid` to `Show`: `Solid` is a `Show` through it already, and a type conforms to a trait through one impl
// error: a value of the trait `Shape` is of a type implementing it and has that type's `Display`, so an impl of `Display` is for the types implementing `Shape`, not for the trait
// error: a value of the trait `Shape` is of a type implementing it and has that type's `Eq`, so an impl of `Eq` is for the types implementing `Shape`, not for the trait
// A trait type's impl implements every method of a value the trait and the traits it requires
// declare, default bodies included; a trait that already requires the trait cannot implement it; and
// what every value has through its own type is not a trait type's to implement.
trait Base
  base() -> string

trait Show: Base
  show() -> string
  twice() -> string = show() + show()

trait Shape
  area() -> int

trait Solid: Show
  volume() -> int

impl Show for Shape
  show() -> string = "shape"

impl Show for Solid
  show() -> string = "solid"
  twice() -> string = "solid"
  base() -> string = "solid"

impl Display for Shape
  display(out: Writer, spec: FormatSpec) = out.write("shape")

impl Eq for Shape
  equals(other: Shape) -> bool = true

main() = ()
