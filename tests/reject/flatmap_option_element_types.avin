// error: expected (int) -> Option[string], found (int) -> Option[int]
// error: expected Map[string, int], found Iterable[string]
// error: expected Option[int], found Vector[int]
// error: int has no field `toIntOption`
// error: expected Vector[int], found Iterable[int]
// The result of a `flatMap` taking options, or of a map's `map` to non-pairs, is what its function
// decides, and is held to the type expected of it like any value.
positive(n: int) -> Option[int] = if n > 0 then Some(n) else None

main()
    val a: Vector[string] = [1, 2].flatMap(positive)
    val m: Map[string, int] = {"a": 1}
    val b: Map[string, int] = m.map((k, v) -> k)
    val o: Option[int] = Some(1)
    val c: Option[int] = o.flatMap(x -> [x])
    val d = [1].flatMap(_.toIntOption())
    val e: Vector[int] = m.map((k, v) -> v)
