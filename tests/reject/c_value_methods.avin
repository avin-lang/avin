// An opaque value's method takes the value first, by value, named `self`; it is no field accessor and
// keeps nothing; and a value C answers by value is never null.
// error: the receiver `self` of `pointer` is a `Event`, a copy of `as_event` passed by value, and the prototype says `as_event *`
// error: the prototype of an opaque value's method takes the value first, named `self`, as in `int mlt_event_data_to_int(mlt_event_data self)`
// error: `field:` binds a field accessor, a method of a C handle reading or writing a field of the struct it points at, and `field` is not a method of one
// error: `keeps:` names `self`, and `keeper` is not a method of a C handle
// error: the result of the C binding `maybe` is `Option[Event]` in Avin and `as_event` in C: a value C answers by value is never null, so an opaque value is not in an `Option`

@c(value: "as_event")
class Event
    @c("int as_event_pointer(as_event *self)")
    pointer() -> int

    @c("int as_event_other(int x)")
    noSelf() -> int

    @c(field: "i")
    field() -> int

    @c("int as_event_keep(as_event self)", keeps: "self")
    keeper() -> int

@c("as_event as_event_make(void)")
maybe() -> Option[Event]

main() = 0
