// error: `Box` is covariant in `T`, so a variant cannot fix `T`: `DogBox` makes a `Box[Dog]`; declare the parameter invariant, `data Box[T]`
// error: `Sink` is contravariant in `T`, so a variant cannot fix `T`: `Fixed` makes a `Sink[int]`; declare the parameter invariant, `data Sink[T]`
// error: `Two` is covariant in `A`, so a variant cannot fix `A`: `Swap` makes a `Two[B, A]`; declare the parameter invariant, `data Two[A, B]`
// error: `Three` is covariant in `C`, so a variant cannot fix `C`: `Wrap` makes a `Three[A, B, Option[C]]`; declare the parameter invariant, `data Three[-A, B, C]`
// error: the covariant type parameter `+T` appears in a contravariant position, the field `f` of `Bad`
// A parameter declared with a variance is never fixed by a variant: its result has the parameter
// itself in that place. The invariant places may be fixed beside it, and the fields are checked for
// variance against the parameters the variant leaves alone, as any variant's are.

open class Animal()

class Dog(): Animal

data Box[+T]
  Holds(value: T) -> Box[T]
  DogBox(dog: Dog) -> Box[Dog]

data Sink[-T]
  Takes(f: (T) -> unit)
  Fixed(f: (int) -> unit) -> Sink[int]

data Two[+A, B]
  Swap(a: A) -> Two[B, A]
  Keep(a: A) -> Two[A, int]

data Three[-A, B, +C]
  Wrap(c: C) -> Three[A, B, Option[C]]

data Out[+T, K]
  Bad(f: (T) -> unit) -> Out[T, int]

main() = ()
