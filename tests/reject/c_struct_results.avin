// A struct C answers by value is its mirror, never in an `Option`, at its own struct; one C fills is
// `out` through a pointer to that struct; and an array of mirrors goes to a `const` pointer only.
// error: the result of the C binding `maybe` is `Option[Point]` in Avin and `as_point` in C: a struct C answers by value is never null, so its mirror is not in an `Option`
// error: the result of the C binding `otherStruct` is `Point` in Avin and `as_rect` in C: `Point` mirrors `as_point`, so it is answered by value, as `as_point`
// error: the result of the C binding `pointer` is `Point` in Avin and `const as_point *` in C: `Point` mirrors `as_point`, so it is answered by value, as `as_point`
// error: out value 1 of the C binding `fillsOther`, `r`, is `Point` in Avin and `as_rect` in C: `Point` mirrors `as_point`, so C fills it through `out as_point *`
// error: parameter 1 of the C binding `writable` is `Array[Point]` in Avin and `as_point *` in C: an array of `Point` is converted into C memory that lives for the call and is never read back, so it goes to a `const` pointer, `const as_point *`

@c(struct: "as_point")
data Point(x: real, y: real)

@c("as_point as_make(void)")
maybe() -> Option[Point]

@c("as_rect as_make_rect(void)")
otherStruct() -> Point

@c("const as_point *as_pointer(void)")
pointer() -> Point

@c("void as_fill(out as_rect *r)")
fillsOther() -> Point

@c("void as_points(as_point *p, length(p) int n)")
writable(p: Array[Point])

main() = 0
