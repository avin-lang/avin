// What is not a scalar does not cross a C binding by value: a pointer, a struct, and Avin's `char`,
// a Unicode scalar value, which C has no type for. A struct is refused even as a discarded result,
// which would be passed by value.
// error: parameter 1 of the C binding `length` is `long` in Avin and `const char *` in C: pointers are not implemented
// error: the result of the C binding `name` is `long` in Avin and `const char *` in C: pointers are not implemented
// error: parameter 1 of the C binding `pointX` is `int` in Avin and `struct fixture_point_tag` in C: a struct passed by value is not implemented
// error: the result of the C binding `origin` is `unit` in Avin and `struct fixture_point_tag` in C: a struct passed by value is not implemented
// error: parameter 1 of the C binding `upper` is `char` in Avin and `int` in C: a C integer crosses as an integer type

@c("size_t strlen(const char *s)")
length(s: long) -> long

@c("const char *fixture_name(void)")
name() -> long

@c("int fixture_point_x(struct fixture_point_tag p)")
pointX(p: int) -> int

@c("struct fixture_point_tag fixture_origin(void)")
origin()

@c("int toupper(int)")
upper(c: char) -> int

main() = 0
