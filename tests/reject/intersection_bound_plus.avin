// A type parameter's bounds are joined with `&`, the one spelling: `+` between them is an error on
// a function, a class, a method's own parameters and an impl's header alike.
// error: a type parameter's bounds are joined with `&`, as in `[T: Ord & Display]`
// error: a type parameter's bounds are joined with `&`, as in `[T: Ord & Display]`
// error: a type parameter's bounds are joined with `&`, as in `[T: Ord & Display]`
// error: a type parameter's bounds are joined with `&`, as in `[T: Ord & Display]`
// error: a type parameter's bounds are joined with `&`, as in `[T: Ord & Display]`
trait Named
  name() -> string

trait Sized
  size() -> int

f[T: Named + Sized](x: T) -> int = 1

class Shelf[T: Named + Sized](val item: T)
  m[U: Sized & Named + Ord](u: U) -> int = 1

data Box[T](v: T)

impl[T: Ord + Display] Box[T]
  shown() -> string = s"$v"

g[K: Eq & Hash + Display, V](k: K, v: V) -> int = 1

main()
  println(1)
