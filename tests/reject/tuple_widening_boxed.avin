// error: expected (Any, int), found (int, int)
// error: expected (Any, int), found (bool, int)
// error: expected (Any, int), found (char, int)
// error: expected (Any, int), found (real, int)
// error: expected (int, Any), found (int, long)

// A tuple already made converts to a wider tuple only where each part already is what the wider one
// holds. A number, a `bool` or a `char` part would need a box, and its layout differs, so it does not
// convert; writing the tuple out where the wider one is expected boxes the part there.

wide(p: (Any, int)) -> int = p.1

main()
    val a: (int, int) = (1, 2)
    println(wide(a))
    val b: (bool, int) = (true, 2)
    println(wide(b))
    val c: (char, int) = ('c', 2)
    val w: (Any, int) = c
    val r: (real, int) = (1.5, 2)
    val v: Vector[(Any, int)] = [r]
    val l: (int, long) = (1, long(2))
    val second: (int, Any) = l
    val n = 3
    println(wide((n, 1)))
