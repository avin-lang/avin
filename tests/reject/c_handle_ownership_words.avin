// `borrowed` needs a handle answered whose class declares `retain`; `keeps:` names a handle
// parameter, and needs a holder: the handle the binding answers, or a method's receiver.
// error: the C binding `lendThing` lends a `Thing`, and `Thing` declares no `retain`: a lent object is kept only by a reference of its own
// error: `borrowed` says C only lends the handle a binding answers, and `countThings` answers no handle
// error: `keeps:` names `name`, of type `string`: what a C binding keeps or takes is a handle, and anything else crosses for the call alone
// error: `keeps:` names `m`, which is not a parameter of `missing`
// error: `keeps:` makes the handle a binding answers keep what it names, and `put` answers no handle and is no method of one

@c(type: "struct thing *", release: "thing_free")
class Thing
    @c("int thing_size(struct thing *self)")
    size() -> int

@c(type: "struct thing *", release: "thing_free", retain: "thing_ref")
class Counted

@c("struct thing *thing_lend(void)", borrowed)
lendThing() -> Thing

@c("int thing_count(void)", borrowed)
countThings() -> int

@c("struct thing *thing_new(int n, const char *name)", keeps: "name")
named(n: int, name: string) -> Counted

@c("struct thing *thing_new(int n)", keeps: "m")
missing(n: int) -> Counted

@c("int thing_put(struct thing *t)", keeps: "t")
put(t: Counted) -> int

main() = 0
