// error: `==` on mutable maps and sets compares their contents, which is not implemented yet; compare identities with `===`
// error: expected Map[string, Animal], found Map[string, Dog]
// error: expected Set[Animal], found Set[Dog]
// error: expected int, found string
// error: expected string, found int
// An immutable map is covariant in its values, but a mutable map is invariant, and so is a set of
// either kind; keys and values keep their types; and `==` on mutable maps and sets, which compares
// contents, waits for impls with bounds of their own on classes.

import avin.collections.mutable.{Map as MutableMap, Set as MutableSet}

open class Animal
class Dog: Animal()

main()
    val table = MutableMap[string, int]()
    val same = table == MutableMap[string, int]()
    val dogs = MutableMap[string, Dog]()
    val animals: MutableMap[string, Animal] = dogs
    val pack: Set[Animal] = Set[Dog]()
    val m = Map[string, int]().updated("a", "b")
    val n = Map[string, int]().updated(1, 2)
