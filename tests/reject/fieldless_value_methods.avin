// error: cannot infer `T` for this `Empty`; write it, as in `Empty[int]`
// error: `Empty` takes 1 type argument, not 0
// error: `unit` takes 0 arguments, not 1
// error: `Lone` has no field `nope`
// error: `Lone` has no method `nope` to call infix
// The bare name of a data type's variant of its own name with no fields is a value, so a method
// called on it is the value's, and a type argument nothing decides cannot be inferred. A static
// member of the type of the name is the type's: the value's method of that name is not reached
// through the name, and a generic type's static member needs its type arguments.

trait Unit
  static unit() -> Self

data Empty[T]()

impl[T] Empty[T]
  size() -> int = 0

impl[T] Unit for Empty[T]
  static unit() -> Empty[T] = Empty

data Both()

impl Both
  unit(n: int) -> string = "value"

impl Unit for Both
  static unit() -> Both = Both

data Lone()

main()
  println(Empty.size())
  println(Empty.unit())
  println(Both.unit(2))
  println(Lone.nope())
  println(Lone nope 1)
