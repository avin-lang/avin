// error: `Shape.Circle` has fields; match them, as in `Shape.Circle(…)`
// error: `Shape.Rect` has fields; match them, as in `Shape.Rect(…)`
// error: `Circle` has 1 field, not 0
// error: `Rect` has 2 fields, not 1
// error: `Red` has 0 fields, not 1
// In a pattern a qualified variant is written as its bare name is: one with fields is matched with
// them in parentheses, at the top of a pattern or nested in one, and `Shape.Circle()`, written with
// parentheses, is matched against the variant's fields by number.

data Color
    Red
    Green

data Shape
    Circle(radius: real)
    Rect(width: real, height: real)

top(s: Shape) -> int = s match
    Shape.Circle -> 1
    _ -> 0

nested(o: Option[Shape]) -> int = o match
    Option.Some(Shape.Rect) -> 1
    _ -> 0

counted(s: Shape) -> int = s match
    Shape.Circle() -> 1
    Shape.Rect(w) -> 2
    _ -> 0

fieldless(c: Color) -> int = c match
    Color.Red(x) -> 1
    _ -> 0

main() = ()
