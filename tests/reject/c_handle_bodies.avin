// A C handle holds its C pointer and nothing else: no parameters, no fields, its own `close()`, and
// no annotation on its methods but `@c`.
// error: a C handle has no parameters: the C bindings that answer one make it
// error: a C handle holds its C pointer and nothing else, so its body declares only methods
// error: every C handle has `close()`, which gives its object back through `release:`; bind a C function of that name under another
// error: unknown annotation `@inline` on a method of a C handle
// error: unknown annotation `@inline`

@c(type: "struct thing *", release: "free")
class WithParams(x: int)

@c(type: "struct thing *", release: "free")
class WithField
  val x: int = 1

@c(type: "struct thing *", release: "free")
class WithClose
  @c("int thing_close(struct thing *self)")
  close() -> int

@c(type: "struct thing *", release: "free")
class Marked
  @c("int thing_size(struct thing *self)")
  @inline
  marked() -> int

main() = 0
