data Point(x: int, y: int)

open class Animal(name: string)

type P = Point
type Pairs[T] = Vector[(T, T)]
type Base = Animal

class Dog(n: string): Base(n)

trait Describe
    describe() -> string

type Named = Describe

class Cat: Named
    describe() -> string = "cat"

main()
    val f = P
    val g = Pairs
    val q = Point(1, 2)
    val m = q match
        P(a, b) -> a + b
