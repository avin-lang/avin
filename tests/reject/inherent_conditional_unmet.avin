// error: `shown` needs `T: Display`, which Sub[Plain] does not meet
// error: `display` is a method of `Display`, which Sub[Plain] does not implement
class Plain(n: int)

open class Box[T](value: T)

impl[T: Display] Box[T]
    shown() -> string = value.toString()

impl[T: Display] Display for Box[T]
    display(out: Writer, spec: FormatSpec) = out.write(shown())

class Sub[T](v: T): Box[T](v)

unbounded[U](xs: List[U]) -> string = xs.mkString()

main()
    val ps: List[Plain] = [Plain(1)]
    println(ps.mkString())
    val f: () -> string = Box(Plain(2)).shown
    println(Sub(Plain(3)).shown())
    Sub(Plain(4)).display(StandardOutput, FormatSpec())
