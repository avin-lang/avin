// Variants share their module's names, so two mirrors in one module of Sysl enums that both have an
// `Inherit` variant declare it twice. That is reported, and the second mirror, which has lost the
// variant, is checked no further.
// error: the variant `Inherit` is declared more than once
@sysl("sysl.process.Group")
data Group
  Inherit
  New
  Join(pgid: int)

@sysl("sysl.process.Stdio")
data Stdio
  Inherit
  ToPath(path: string)
  FromPath(path: string)

main()
  println("x")
