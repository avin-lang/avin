// error: a `@test` function takes no parameters, and `takesOne` takes 1 parameter: `avin test` calls it with nothing
// error: a `@test` function has no type parameters, and `generic` declares `T`: the runner supplies no type arguments
// error: a `@test` function yields unit or a `Result[unit, E]`, and `givesBack` yields int: a test passes by returning, or by answering `Ok`
// A test is a top-level function the runner calls with nothing, and which passes by returning, or by
// answering `Ok`.

@test
takesOne(n: int)
  assert(n > 0)

@test
generic[T]()
  assert(true)

@test
givesBack() -> int = 1

main() = 0
