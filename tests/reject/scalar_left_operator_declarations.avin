// error: `real` does not implement Grow's `*`; a built-in type takes no default bodies, so its impl implements every method of the trait
// error: `*` is the language's operator on real, and no method can redefine it
// error: `*` is the language's operator on real, and no method can redefine it; a method `*` added to real takes one argument of a data type, a class, a trait or an opaque type
// error: `+` is the language's operator on real, and no method can redefine it; a method `+` added to real takes one argument of a data type, a class, a trait or an opaque type
// error: `<` is the language's operator on real, and no method can redefine it; a method `<` added to real takes one argument of a data type, a class, a trait or an opaque type
// An impl adding to a built-in type may add a binary operator only for an operand of a type the
// program declares, so an operator between two built-in values is always the machine's: not for
// another built-in type, a tuple or a type parameter, which a built-in type could fill; and never
// through a trait's implementation.
data Vec(x: real, y: real)

trait Grow
  *(v: Vec) -> Vec

impl Grow for real
  *(v: Vec) -> Vec = v

impl real
  *(o: real) -> real = o
  +(p: (int, int)) -> real = self
  <[T](o: T) -> bool = true

main()
  println(1)
