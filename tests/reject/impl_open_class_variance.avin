// error: the covariant type parameter `+T` appears in a contravariant position, the parameter `y` of `with`
// error: the covariant type parameter `+T` appears in a contravariant position, the parameter `y` of `with`
// error: the covariant type parameter `+T` appears in an invariant position, the result of `cells`
// error: the contravariant type parameter `-T` appears in a covariant position, the result of `patient`

// The methods an impl adds to an open or abstract class are in its method table and run the copy
// for the object's own type arguments, so they are variance positions even when every field is
// immutable: through a `Box[Animal]` view of a `Box[Dog]`, `with(cat)` would make a `Box[Dog]`
// holding a cat.

open class Animal(val name: string)
class Dog(name: string): Animal(name)
class Cat(name: string): Animal(name)

abstract class Box[+T]
  item() -> T

class One[+T](val x: T): Box[T]
  override item() -> T = x

impl[T] Box[T]
  with(y: T) -> Box[T] = One(y)

open class Crate[+T](val x: T)

impl[T] Crate[T]
  with(y: T) -> Crate[T] = Crate(y)
  // Lower-bounded, the element widens the result instead, which is allowed.
  widened[W >: T](y: W) -> Crate[W] = Crate(y)
  // An array of its type argument is a mutable view of it.
  cells() -> Array[T] = [x]

open class Vet[-T](val treat: (T) -> int)

impl[T] Vet[T]
  patient() -> Option[T] = None

main() -> int
  0
