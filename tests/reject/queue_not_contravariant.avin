// error: expected Queue[Dog], found Queue[Animal]
// A queue is covariant, not contravariant: a queue of animals is not a queue of dogs.

open class Animal(val name: string)
class Dog(name: string): Animal(name)

main(args: Vector[string])
  val animals: Queue[Animal] = Queue(Animal("a"))
  val dogs: Queue[Dog] = animals
  println(dogs.length)
