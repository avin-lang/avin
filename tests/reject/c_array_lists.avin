// `array:` names several arrays as a list, and then `length:` and `free:` are lists of the same
// length in the same order; a list names each array once, each an `out` parameter, and a list of
// lengths or frees comes only with a list of arrays.
// error: `array:` names 2 arrays, so `length:` gives the length of each, as a list in the same order, as in `length: ["num_glyphs", "num_clusters"]`
// error: `array:` names 2 arrays, so `free:` says how each is freed, as a list in the same order, `""` for one nothing frees
// error: `array:` names `a` twice
// error: `array:` names the `out` parameter C answers an array through, and `c` is no `out` parameter of the prototype
// error: `length:` is a list only where `array:` names a list of arrays, one length for each

@c(struct: "as_glyph")
data Glyph(index: long, x: real, y: real)

@c(
    "void f(out as_glyph **a, out int *na, out as_glyph **b, out int *nb)",
    array: ["a", "b"],
    length: "na",
    free: ["free", "free"]
)
lengthAlone() -> (Array[Glyph], int, Array[Glyph], int)

@c(
    "void f(out as_glyph **a, out int *na, out as_glyph **b, out int *nb)",
    array: ["a", "b"],
    length: ["na", "nb"],
    free: ["free"]
)
freeShort() -> (Array[Glyph], int, Array[Glyph], int)

@c("void g(out as_glyph **a, out int *na)", array: ["a", "a"], length: ["na", "na"])
twice() -> (Array[Glyph], int)

@c("void g(out as_glyph **a, out int *na)", array: ["a", "c"], length: ["na", "na"])
missing() -> (Array[Glyph], int)

@c("void g(out as_glyph **a, out int *na)", array: "a", length: ["na"])
lengthList() -> (Array[Glyph], int)

main() = 0
