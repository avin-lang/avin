// A Sysl mirror's field may be an `Array` or a `Vector` of boundary types, and it holds no mirror
// that holds itself through one.
// error: `Vector[Plain]` cannot cross to Sysl, so a Sysl mirror's field cannot be one
// error: a Sysl mirror cannot hold itself: `Vector[Tree]` holds `Tree`
// error: a Sysl mirror cannot hold itself: `Option[Array[Forest]]` holds `Forest`

data Plain
    Plain(n: int)

@sysl("sysl.fs.Fields")
data Fields
    Fields(items: Vector[Plain])

@sysl("sysl.fs.Tree")
data Tree
    Tree(children: Vector[Tree])

@sysl("sysl.fs.Forest")
data Forest
    Forest(more: Option[Array[Forest]])

main() = 0
