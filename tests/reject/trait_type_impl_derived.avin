// A type derives a trait through a field typed as a trait only where that trait type has its own
// impl at the field's arguments: one whose arguments miss the impl's bounds, a trait type with no
// impl, and a type implementing the trait that has no impl of its own are each reported by the
// field's type, nested or not.
// error: `Bad` cannot derive `Describe`: field `flags` has type `Map[int, bool]`, which does not implement `Describe`
// error: `Rows` cannot derive `Describe`: field `rows` has type `Vector[Map[int, bool]]`, which does not implement `Describe`
// error: `Drawn` cannot derive `Describe`: field `shape` has type `Shape`, which does not implement `Describe`
// error: `Hashed` cannot derive `Describe`: field `own` has type `HashMap[int, int]`, which does not implement `Describe`

trait Describe
  describe() -> string

impl Describe for int
  describe() -> string = s"$self"

impl[K: Describe, A: Describe] Describe for Map[K, A]
  describe() -> string = s"map of $size"

impl[A: Describe] Describe for Vector[A]
  describe() -> string = s"vector of $length"

derive Describe for T
  describe() -> string = T.walk(self, Describer("")).text

data Describer(text: string)

impl ShapeVisitor for Describer
  variant(v: VariantShape) -> Describer = Describer(v.name)

impl Describer
  field[F: Describe](f: FieldShape, value: F) -> Describer = Describer(text + value.describe())

trait Shape
  area() -> int

data Good(counts: Map[int, int], rows: Vector[Map[int, int]]) derives Describe

data Bad(flags: Map[int, bool]) derives Describe

data Rows(rows: Vector[Map[int, bool]]) derives Describe

data Drawn(shape: Shape) derives Describe

data Hashed(own: HashMap[int, int]) derives Describe

main() = 0
