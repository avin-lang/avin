// error: `NoApply` is a subtype of (int) -> int, so it has `apply(int) -> int`
// error: `WrongResult` is a subtype of (int) -> int, so its `apply` yields int, not string
// error: `Both` is a subtype of both (string) -> int and (int) -> int; a type is at most one function type
// error: the covariant type parameter `+T` appears in a contravariant position, the function type (T) -> bool
// error: the covariant type parameter `+T` appears in a contravariant position, the parameter `x` of `apply`
// A type listing a function type has the `apply` it names, is at most one function type, and keeps
// its type parameters' variance there.

class NoApply: (int) -> int
    other(x: int) -> int = x

class WrongResult: (int) -> int
    apply(x: int) -> string = "no"

class Both: Seq[int], (string) -> int
    override length() -> int = 0
    override apply(index: int) -> int = index
    apply(s: string) -> int = 0

class Box[+T](val item: T): (T) -> bool
    apply(x: T) -> bool = true

main()
    println(NoApply().other(1))
