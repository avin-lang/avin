// error: a select arm is a channel's `receive()` or `send(x)`, a stream's `readable()` or `writable()`, `after` a duration, or `else`
// error: a select arm is a channel's `receive()` or `send(x)`, a stream's `readable()` or `writable()`, `after` a duration, or `else`; a guard follows the arm's operation
// A select's arms are a channel's `receive()` or `send(x)`, `after` a duration, or `else`: any other
// call, a bare value, a `receive` with an argument and a `send` with two, a guard with no operation
// before it, are reported.
import avin.threads.Channel

main()
  val c = Channel[int]()
  select
    c.close() -> ()
    c -> ()
    c.receive(1) -> ()
    c.send(1, 2) -> ()
    if true -> ()
