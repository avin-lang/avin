// error: `false` is a keyword and cannot name a value
// error: `var` is a keyword and cannot name a value
// error: `private` is a keyword and cannot name a type parameter
// error: `static` is a keyword and cannot name a variant
// error: `val` is a keyword and cannot name a parameter
// A modifier of a member stays reserved: in a class body, where a line may be a statement,
// `private + (other: T)` could be a method named by a symbol or an expression on a value.
f[private](var: int) -> int = 1
data Kind
  static
main()
  val false = 1
  val g = (val: int) -> 1
