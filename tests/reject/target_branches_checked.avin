// error: `notOnMac` is not defined
// error: `notOnLinux` is not defined
// error: `noSuchArmFunction` is not defined
// error: `noSuchIntelFunction` is not defined
// Both branches over `avin.target` are checked on every machine, whichever one the machine takes:
// an error in either is reported here, so neither can rot unseen on the machine that skips it.
import avin.target
import avin.process.{Linux, MacOS}
import avin.target.{Aarch64, X86_64}

main()
  val a = target.os match
    MacOS -> notOnMac()
    Linux -> notOnLinux()
    _ -> 0
  val b = if target.arch == Aarch64 then noSuchArmFunction() else 1
  val c = if target.arch is X86_64 then noSuchIntelFunction() else 2
  println(a + b + c)
