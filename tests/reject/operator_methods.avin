// error: `+` is the language's operator on int, and no method can redefine it
// error: `<` is the language's operator on string, and no method can redefine it
// error: `-` is the language's operator on real, and no method can redefine it
// error: expected Span, found int
// error: `<` is a method of Stamp, and a comparison by a method does not chain; join the comparisons with `&&`
// The built-in types' arithmetic and orderings are the machine's, which no method replaces; an
// operator method is chosen by its operand's type like any overload; and a comparison by a method is
// a call of its own, which does not chain.
data Stamp(micros: long)

data Span(micros: long)

impl Stamp
  +(d: Span) -> Stamp = Stamp(micros + d.micros)
  <(other: Stamp) -> bool = micros < other.micros

impl int
  +(o: int) -> int = self

impl string
  <(o: string) -> bool = true

impl real
  -() -> real = self

main()
  val s = Stamp(1)
  val a = s + 1
  val b = s < s < s
