// A call whose contextual parameter no name, given or default fills is an error at the call, whatever
// its shape; a given of a supertype does not fill a subtype's parameter; and the section takes no part
// in choosing an overload, so a missing given never makes the call choose another.
// error: `tag` needs a `Tx` for `tx`, and no given of that type is in scope: declare one (`given tx = …`), take one as `using`, import one, or pass `tx = …`
// error: `fileOnly` needs a `FileLogger` for `file`, and no given of that type is in scope: declare one (`given file = …`), take one as `using`, import one, or pass `file = …`
// error: `show` needs a `Tx` for `tx`, and no given
// error: `Service` needs a `Tx` for `tx`, and no given
// error: `put` needs a `Tx` for `tx`, and no given

trait Logger
  name() -> string

class FileLogger(path: string): Logger
  override name() -> string = path

data Tx(id: int)

tag(using tx: Tx) -> int = tx.id

fileOnly(using file: FileLogger) -> string = file.name()

show(x: int, using tx: Tx) -> string = s"$x"
show(x: long) -> string = "long"

class Service(using tx: Tx)

trait Store
  put(key: string, using tx: Tx) -> int

use(store: Store)
  println(tag())
  println(show(1))
  val _ = Service()
  println(store.put("k"))

main()
  given log: Logger = FileLogger("a")
  println(fileOnly())
