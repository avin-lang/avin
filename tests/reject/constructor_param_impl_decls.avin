// error: `F` is a constructor parameter; an impl of a trait is for a data type, a class, an object or a built-in type
// error: `B` is not part of `F[A]`; each of an impl's type parameters is, so a call learns it from the receiver's type
// error: `empty` is static, which only a type's own member is; an impl adding to `F[A]` adds methods of values
// error: `twice` is already added to `G[T]` with the same parameter types; a method's overloads differ in their parameter types
// An impl adding to the applications of a constructor parameter adds methods of values, to the
// values whose type matches it: it states no conformance, every parameter of it is part of the type,
// it declares no static member, and two of its methods, or of two such impls of one module, differ
// in their parameter types.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

impl Mappable for Option

impl[F[_]: Mappable, A] Display for F[A]

impl[F[_]: Mappable, A, B] F[A]
  extra() -> int = 2

impl[F[_]: Mappable, A] F[A]
  static empty() -> int = 0
  twice(f: (A) -> A) -> F[A] = map(f).map(f)

impl[G[_]: Mappable, T] G[T]
  twice(f: (T) -> T) -> G[T] = map(f)

main()
  println(Some(1).twice(n -> n + 1))
