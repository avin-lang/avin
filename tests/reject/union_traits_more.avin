// error: `Ranked` cannot derive `Ord`: its field `v` has type `int | string`, which does not implement `Ord`: a union has no order between its members
// error: `Sq | Ci` has `name` from more than one type it conforms to: `Named` and `Titled`; take it apart with a `match` or `is` first
// error: `Bag | Plain` has no member `size`: its members share no type that has one; take it apart with a `match` or `is` first
// error: `Puppy | Kitten` has no member `wag`: its members share no type that has one; take it apart with a `match` or `is` first
// error: `Puppy | Kitten` has no member `tail`: its members share no type that has one; take it apart with a `match` or `is` first
// A clash is refused for a method named as a value too. A trait one member lacks is not the union's.
// A method or field of one member only is not the union's, even where the members share a class.
// `derives Ord` names the union field.

trait Named
    name() -> string

trait Titled
    name() -> string

class Sq: Named, Titled
    override name() -> string = "sq"

class Ci: Named, Titled
    override name() -> string = "ci"

trait Sized
    size() -> int

class Bag(n: int): Sized
    override size() -> int = n

class Plain

open class Pet(val called: string)

class Puppy(called: string, val tail: int): Pet(called)
    wag() -> string = "wag"

class Kitten(called: string): Pet(called)

data Ranked(v: int | string) derives Ord

main()
    val s: Sq | Ci = Sq()
    val f = s.name
    val b: Bag | Plain = Bag(1)
    println(b.size())
    val p: Puppy | Kitten = Puppy("bo", 1)
    println(p.wag())
    println(p.tail)
