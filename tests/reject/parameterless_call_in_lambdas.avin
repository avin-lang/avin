// A parameterless member called with `()` is reported the same way wherever the call sits: inside a
// lambda's body, on a placeholder, mid-chain with more calls after it, on an `Option` inside a lambda,
// and on a parameter whose type is a type parameter bounded by a collection trait.
// error: `isEmpty` takes no parameter list, so it is called without parentheses: write `isEmpty`, not `isEmpty()`
// error: `trim` takes no parameter list, so it is called without parentheses: write `trim`, not `trim()`
// error: `sorted` takes no parameter list, so it is called without parentheses: write `sorted`, not `sorted()`
// error: `get` takes no parameter list, so it is called without parentheses: write `get`, not `get()`
// error: `isEmpty` takes no parameter list, so it is called without parentheses: write `isEmpty`, not `isEmpty()`
// error: parameterless_call_in_lambdas.avin:15:31

emptyOf[T: Iterable[int]](t: T) -> bool = t.isEmpty()

main()
    val words = ["b", "", "a"]
    println(words.filter(w -> w.isEmpty()))
    println(words.map(_.trim()))
    println(words.sorted().mkString(", "))
    println([Some(1)].map(o -> o.get()))
    println(emptyOf([1]))
