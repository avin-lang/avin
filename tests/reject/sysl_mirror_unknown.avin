// A mirror of a Sysl type that does not exist is reported at the mirror, with Sysl's words.
// error: the Sysl mirror `Missing` does not match `sysl.fs.NoSuchError`: 'sysl.fs' declares no 'NoSuchError'
// error: tests/reject/sysl_mirror_unknown.avin:5:1

@sysl("sysl.fs.NoSuchError")
data Missing
  Gone

@sysl("sysl.hint.black_box")
same(m: Missing) -> Missing

main()
  println(s"${same(Gone)}")
