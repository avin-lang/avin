// error: this `match` does not cover every Shape value
// error: this `match` does not cover every Option[bool] value
// error: this `match` does not cover every Pair value

data Shape
  Circle(radius: int)
  Rect(width: int, height: int)
  Empty

data Option[+T]
  Some(value: T)
  None

data Pair(a: bool, b: bool)

area(s: Shape) -> int = s match
  Circle(r) -> r
  Empty -> 0

flag(o: Option[bool]) -> int = o match
  Some(true) -> 1
  None -> 0

both(p: Pair) -> int = p match
  Pair(true, _) -> 1
  Pair(_, true) -> 2

main() = ()
