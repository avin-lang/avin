// error: `@sendable_result` is the standard library's promise about a method it defines, which nothing checks against the method's body; a function outside it returns a value of a sendable type or a `@sendable` function
// error: `@sendable_result` is the standard library's promise about a method it defines, which nothing checks against the method's body; a function outside it returns a value of a sendable type or a `@sendable` function
// Nothing checks a `@sendable_result` promise against the body it is made of, so only the standard
// library makes one: a program's own class method, a method an impl adds to a trait, and a method
// an impl adds to the core library's `PartialFunction` are refused.
trait Shape
  area() -> int

class Square(side: int): Shape
  override area() -> int = side * side
  @sendable_result
  grown() -> Square = Square(side + 1)

impl Shape
  @sendable_result
  twice() -> int = area() * 2

impl[A, B] PartialFunction[A, B]
  @sendable_result
  again() -> PartialFunction[A, B] = self

main() = ()
