fib(n: int) -> int
fib(0) = 0
fib(1) = 1
fib(n) | n > 1 = fib(n - 1) + fib(n - 2)

pair(a: int, b: int) -> int
pair(x) = x
pair(_, _) = 0

lonely(n: int) -> int

mixed(n: int)
mixed(0) = 1
mixed(_) = true

both(a: bool, b: bool) -> int
both(true, _) = 1
both(_, true) = 2

main() -> int = 0
