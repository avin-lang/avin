// error: a deferred statement runs while its block is being left, so it cannot leave by `return`; there is no exit left to take
// error: a deferred statement runs while its block is being left, so it cannot leave by `?`; there is no exit left to take
// error: a deferred statement runs while its block is being left, so it cannot leave by `break`; there is no exit left to take
// error: a deferred statement runs while its block is being left, so it cannot leave by `continue`; there is no exit left to take
// A deferred statement runs while its block is being left, so no jump may leave it, at any depth:
// a `return`, a `?`, and a `break` or `continue` of a loop outside it. A loop written inside it is its
// own, so a jump within that loop is allowed (the `for` over `j`), as is one in a lambda (in the
// run tests).

first(c: bool) -> int
  defer if c then return 1
  2

opt(o: Option[int]) -> Option[int]
  defer
    val v = o?
    println(v)
  o

loops()
  for i in 0 ..< 3
    defer if i == 1 then break
    while true
      defer
        for j in 0 ..< 2
          if j == 1 then continue
          if j == 0 then break
        continue

nested() -> int
  defer
    for k in 0 ..< 2
      if k == 1 then return k
  0

main() = ()
