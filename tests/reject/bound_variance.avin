// error: the covariant type parameter `+T` appears in a contravariant position, the bound of `U` in `swap`
// A bound on a method's own type parameter is a position a caller passes a value in through, so a
// `+T` may not appear in it and a `-T` may.
trait Source[+A]
    next() -> A

class Shelf[+T](item: T)
    swap[U: Source[T]](u: U) -> T = item

class Sink[-T]
    take[U: Source[T]](u: U) = ()

main() = ()
