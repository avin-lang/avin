result(n: int) -> int = n
result(n: int) -> string = "n"

named(a: int) -> int = a
named(b: int) -> int = b

generic[T](x: T) -> T = x
generic[U](y: U) -> U = y

delayed(value: -> int) -> int = value
delayed(value: int) -> int = value

main() = 0
main(code: int) = code
