// Of the collections, only `Array` and `Vector` cross to Sysl: a list, a buffer or a map is converted
// by the Avin function that wraps the binding. An `Option` or a `Result` crosses only when what it
// holds does.
// error: `List[string]` cannot cross to Sysl
// error: `Buffer[string]` cannot cross to Sysl
// error: `Map[string, int]` cannot cross to Sysl
// error: `Option[Shape]` cannot cross to Sysl
// error: `Result[string, (Shape, int)]` cannot cross to Sysl

data Shape
  Circle(r: int)
  Square(side: int)

@sysl("sysl.hint.black_box")
list(l: List[string]) -> string

@sysl("sysl.hint.black_box")
buffer(s: string) -> Buffer[string]

@sysl("sysl.hint.black_box")
map(m: Map[string, int]) -> string

@sysl("sysl.hint.black_box")
maybeShape(o: Option[Shape]) -> string

@sysl("sysl.hint.black_box")
pairedResult(s: string) -> Result[string, (Shape, int)]

main() = 0
