// error: `int | string` does not conform to `Ord`, the bound of `K` in `TreeMap`: a union has no order between its members
// error: `sorted` needs `T: Ord`, which Vector[int | string] does not meet: a union has no order between its members
// error: `int | Plain` does not conform to `Display`, the bound of `T` in `shown`: its member `Plain` does not
// error: `int | string` does not conform to `Same`, the bound of `T` in `alike`: `Same` takes `Self` other than as the receiver, and a union conforms only to a trait whose methods take it as the receiver alone
// error: `Sq | Ci` has `name` from more than one type it conforms to: `Named` and `Titled`; take it apart with a `match` or `is` first
// A union has no order, so it is no `Ord` and cannot be sorted or used as a sorted map's key. It
// conforms to a trait only where every member does, naming the member that does not, and only to a
// trait taking `Self` as the receiver alone. A name two unrelated traits of the union both have is
// not chosen between.

class Plain

trait Same
    same(other: Self) -> bool

impl Same for int
    same(other: int) -> bool = self == other

impl Same for string
    same(other: string) -> bool = self == other

trait Named
    name() -> string

trait Titled
    name() -> string

class Sq: Named, Titled
    override name() -> string = "sq"

class Ci: Named, Titled
    override name() -> string = "ci"

shown[T: Display](x: T) -> string = s"<$x>"

alike[T: Same](a: T, b: T) -> bool = a.same(b)

keys(m: TreeMap[int | string, int]) -> int = 0

main()
    val v: Vector[int | string] = [1, "a"]
    println(v.sorted())
    val p: int | Plain = 1
    println(shown(p))
    val u: int | string = 1
    println(alike(u, u))
    val s: Sq | Ci = Sq()
    println(s.name())
