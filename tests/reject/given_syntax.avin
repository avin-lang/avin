// A given has a name of its own and is a `val`; a `using` section is written once, on no data
// variant, of parameters that are neither repeated nor by-name.
// error: every given has a name, which a call passes it explicitly by and another file imports it by: `given name = value`
// error: a given is a `val`: it is never reassigned
// error: a data variant's fields take no `using` section: each is given where the value is made
// error: `using` begins the contextual section once: every parameter after it is contextual already
// error: a contextual parameter cannot be by-name: a given is a value already made

data Tx(id: int)

data Event
  Saved(using tx: Tx)

twice(using a: Tx, using b: Tx) = 0

lazily(using tx: -> Tx) = 0

main()
  given Tx(1)
  given var tx = Tx(2)
