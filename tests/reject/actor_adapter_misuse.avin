// An adapter's function runs where its message is sent, and a pipe's where the future completes, so
// neither reaches the actor's own state; an adapter accepts only a sendable protocol; and both belong
// to an actor's own code, so they are no functions outside one.
import avin.actors.{ActorRef, spawn}
import avin.threads.Future

data Msg
    Got(n: int)
    Quiet

actor Counter receives Msg
    var count = 0
    receive
        Got(n) ->
            val a = adapter((s: string) -> Got(count))
            pipeToSelf(Future(1), v -> Got(count))
            val b = adapter((x: Array[int]) -> Quiet)
        Quiet -> ()

main()
    adapter((n: int) -> Quiet)
    pipeToSelf(Future(1), v -> Quiet)
