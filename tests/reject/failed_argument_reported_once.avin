// error: `nope` is not defined
// error: `absent` is not defined
// error: `missing` is not defined
import avin.encoding.{toHex, fromHex, toBase64, fromBase64}

// Each undefined name is reported once, where it is written: an overloaded call it is passed to is
// not reported again as ambiguous, and a type argument it reaches is not reported as two that differ.
main()
  val all = nope()
  assertEq(fromHex(toHex(all)), Ok(all))
  assertEq(fromBase64(toBase64(absent)), Ok(all))
  assertEq(Ok(missing), fromHex("00"))
