// error: `Point` implements `equals` from `Eq` without `hash` from `Hash`
// error: `Tag` implements `hash` from `Hash` without `equals` from `Eq`
// error: `==` cannot compare Tag with Point
// error: `!=` cannot compare int with string
// error: `==` cannot compare (int, int) with (int, string)
// Every type has `==`, between values of a common type, and a type implementing one of `equals` and
// `hash` implements both.
class Point(val x: int)

impl Eq for Point
    equals(other: Point) -> bool = x == other.x

data Tag(name: string)

impl Hash for Tag
    hash() -> long = 1

main()
    if Tag("a") == Point(1) then println("no")
    if 1 != "1" then println("no")
    if (1, 2) == (1, "2") then println("no")
