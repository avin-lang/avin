// error: `Square` already conforms to `Area`; a conformance is stated once
// error: `describe` is already a method of `Square` with the same parameter types
// error: `Shape` does not implement `area` from `Area`; implement it in an impl of `Area`
// error: `name` is not a method of `Area`; an impl of a trait implements the trait's methods, and `impl Shape` adds others
// error: unknown type `Missing`
trait Area
  area() -> int

class Square(side: int): Area
  override area() -> int = side * side
  describe() -> string = "square"

impl Area for Square
  area() -> int = 4

impl Square
  describe() -> string = "a square"

data Shape
  Circle(r: int)
  Dot

impl Area for Shape
  name() -> string = "shape"

impl Area for Missing
  area() -> int = 0

main() = ()
