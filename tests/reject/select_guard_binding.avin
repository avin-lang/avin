// error: `x` is not defined
// error: `got` is not defined
// A select arm's guard is evaluated before any arm is tried, so it cannot name what the arm's pattern
// binds, which has no value yet: not the value of `Some(x)`, not a name for the `Option`.
import avin.threads.Channel

main()
  val c = Channel[int]()
  select
    c.receive() as Some(x) if x > 0 -> ()
    c.receive() as got if got.isDefined -> ()
