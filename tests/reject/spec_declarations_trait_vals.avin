// error: `name` is read before `shout` is initialized
// An abstract class's body cannot read a trait's `val` it leaves to a subclass: it runs before the
// subclass's fields are set.
trait Named
  val name: string

abstract class Early: Named
  val shout = name + "!"

class Late(val name: string): Early

main()
  println(Late("x").shout)
