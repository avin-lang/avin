// A static member taken as a value on `Self` in a method's default body, which every type implementing
// the trait shares, is the call's error, whether the member is abstract or has a default body. A type
// implementing a trait at several type arguments, and a built-in type implementing such a trait, give
// each static member themselves, default body or not.
// error: `Self.wrap()` cannot be called in a trait's default body, which every type implementing the trait shares; a function bounded by the trait calls it, as `T.wrap()`
// error: `Self.plain()` cannot be called in a trait's default body, which every type implementing the trait shares; a function bounded by the trait calls it, as `T.plain()`
// error: `Twice` implements `Make[int]` without `static make(source: int)`
// error: `Twice` implements `Make[string]` without `static make(source: string)`
// error: `int` implements `Make[int]` without `static make(source: int)`

trait Absent
  static wrap(text: string) -> string = s"<$text>"
  static plain(text: string) -> string
  shown(texts: Vector[string]) -> Vector[string] = texts.map(Self.wrap)
  plainly(texts: Vector[string]) -> Vector[string]
    val f = Self.plain
    texts.map(f)

trait Make[E]
  static make(source: E) -> string = "made"

data Twice(name: string)

impl Make[int] for Twice

impl Make[string] for Twice

impl Make[int] for int

main() = ()
