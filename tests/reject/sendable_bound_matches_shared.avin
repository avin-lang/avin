// The bound holds for a `match` function only where every value the call gives of the type argument
// is one: a local partial function beside it as a second argument, in a vector, returned by a
// function passed beside it, or handed to a function given to one passed beside it, gives the
// callee a value that is not sendable. Written type arguments are held to the bound as written.
take[U: Sendable](value: U) -> U = value
pair[U: Sendable](a: U, b: U) -> U = a
pairs[U: Sendable](a: U, b: Vector[U]) -> U = a
fed[U: Sendable](a: U, more: () -> U) -> U = a
handed[U: Sendable](a: U, more: ((U) -> unit) -> unit) -> U = a

main() =
  val pf: PartialFunction[char, int] = match 'z' -> 26
  val a: PartialFunction[char, int] = pair(match 'a' -> 1, pf)
  val b: PartialFunction[char, int] = pairs(match 'a' -> 1, Vector(pf))
  val d: PartialFunction[char, int] = fed(match 'a' -> 1, () -> pf)
  val e: PartialFunction[char, int] = handed(match 'a' -> 1, (g: (PartialFunction[char, int]) -> unit) -> g(pf))
  val f = take[PartialFunction[char, int]](match 'a' -> 1)
