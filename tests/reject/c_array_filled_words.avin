// An array C fills, `out T *` named with `array:`, is allocated by the binding: never null, so never
// in an `Option`, freed by the binding rather than by `free:`, of an element an array holds, a
// mirror's own struct; and an array passed in whose length nothing carries is pointed at the form.
// error: out value 1 of the C binding `optional`, `values`, is `Option[Array[real]]` in Avin and `double` in C: the binding makes the array C fills through `values`, which is never null, so it is not in an `Option`
// error: out value 1 of the C binding `freed`, `values`, is `Array[real]` in Avin and `double` in C: the binding makes the array C fills through `values`, and frees it once copied; `free:` frees an array C allocates, answered through `out T **values`
// error: out value 1 of the C binding `mirror`, `glyphs`, is `Array[Glyph]` in Avin and `as_point` in C: `Glyph` mirrors `as_glyph`, so an array of it is answered as `out as_glyph *glyphs`
// error: out value 1 of the C binding `truths`, `flags`, is `Array[bool]` in Avin and `bool` in C: an array C answers is copied into an `Array[byte]`, `Array[int]`, `Array[long]`, `Array[real]` or an `Array` of a struct mirror
// error: parameter 1 of the C binding `unbounded` is `Array[real]` in Avin and `double *` in C: C could read past the end of an array whose length nothing carries: mark the integer parameter that carries it `length(dashes)`, or, for an array C fills with as many elements as the binding can work out before the call, write it `out double *dashes` and name it with `array: "dashes"`, its length a C expression given with `length:`

@c(struct: "as_glyph")
data Glyph(index: long, x: real, y: real)

@c("void f(int n, out double *values)", array: "values", length: "n")
optional(n: int) -> Option[Array[real]]

@c("void f(int n, out double *values)", array: "values", length: "n", free: "free")
freed(n: int) -> Array[real]

@c("void g(int n, out as_point *glyphs)", array: "glyphs", length: "n")
mirror(n: int) -> Array[Glyph]

@c("void h(int n, out bool *flags)", array: "flags", length: "n")
truths(n: int) -> Array[bool]

@c("void cairo_get_dash(double *dashes, out double *offset)")
unbounded(dashes: Array[real]) -> real

main() = 0
