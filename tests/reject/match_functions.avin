// error: this `match` does not cover every Shape value, such as `Rect(_, _)`; add an arm for it, or `_` for the rest
// error: a `match` with nothing before it is a function, whose type comes from where it is used
// error: a `match` function takes one value, but a function of 2 parameters is expected here
// error: this pattern is int, but the value it matches is Shape
// error: this `match` does not cover every (int, bool) value, such as `(_, false)`; add an arm for it, or `_` for the rest
// Where a function is expected, a `match` function's arms cover every value; it needs an expected
// type, of one parameter, and its patterns are held to that type.

data Shape
    Circle(r: real)
    Rect(w: real, h: real)

combine(f: (int, int) -> int) -> int = f(1, 2)

main()
    val shapes = [Circle(1.0), Rect(1.0, 2.0)]
    val radii = shapes.map(match Circle(r) -> r)
    val loose = match
        n -> n
    val pairwise = combine(match (a, b) -> a + b)
    val wrong = shapes.map(match
        1 -> 1.0
        _ -> 0.0)
    val tuples = [(1, true)].map(match (_, true) -> 1)
