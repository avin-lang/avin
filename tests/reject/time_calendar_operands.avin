// error: expected Period, found Duration
// error: `+` needs two values of one type, not Time and Duration
// error: no overload of `+` accepts these arguments; the overloads are `DateTime.+(p: Period)`, `DateTime.+(d: Duration)`
// error: `==` cannot compare Date with DateTime
// error: `Date` has no field `startOfHour`
// A date takes no duration (a day is a calendar step, `plusDays`), a time of day has no arithmetic
// (23:30 plus an hour is tomorrow or a fault), two readings do not add, a date is never equal to a
// reading, and a date has no hour to start.
import avin.time.{date, time, dateTime, days, hours}

main()
    println(date(2026, 1, 1) + days(1))
    println(time(23, 30) + hours(1))
    println(dateTime(2026, 1, 1, 0, 0) + dateTime(2026, 1, 1, 0, 0))
    println(date(2026, 1, 1) == dateTime(2026, 1, 1, 0, 0))
    println(date(2026, 1, 1).startOfHour)
