// error: expected Vector[int], found Iterable[int]
// error: `Iterable` has no member `length`
// error: expected List[int], found Iterable[int]

// A program's own `Iterable` gets `map` and the rest as an `Iterable`, not as any one collection.
class Three: Iterable[int]
  override iterator() -> Iterator[int] = [1, 2, 3].iterator()

main()
  val t = Three()
  val v: Vector[int] = t.map(x -> x)
  val n = t.filter(x -> x > 1).length()
  val l: List[int] = t.zip(t).map(p -> p.0)
