// error: `Plain` does not conform to `Ord`, the bound of `T` in `apply`
// A priority queue made without a comparison orders by the elements' own `Ord`, so a type without one is refused; `withOrdering` takes a comparison instead.
import avin.collections.mutable.PriorityQueue

class Plain(val n: int)

main()
    val q = PriorityQueue[Plain]()
    println(q.size())
