// error: polymorphic recursion: each round of the cycle `grow` -> `grow` passes `Wrap[F, _]` for `F`, so its type arguments grow without end and the code has no finite set of copies
// error: polymorphic recursion: each round of the cycle `deeper` -> `deeper` passes `Result[_, F[int]]` for `F`, so its type arguments grow without end and the code has no finite set of copies
// error: polymorphic recursion: each round of the cycle `nestErr` -> `nestErr` passes `Nest[E]` for `E`, so its type arguments grow without end and the code has no finite set of copies
// Polymorphic recursion counts constructors: a cycle passing a constructor built around the one it
// received, as `Wrap[F, _]` for `F` or `Result[_, F[int]]`, grows without end and is rejected,
// as is one whose constructor's written argument grows.
data Wrap[G[_], A](inner: G[A])

data Nest[E](e: E)

grow[F[_]](n: int, x: F[int]) -> int = if n == 0 then 0 else grow[Wrap[F, _]](n - 1, Wrap(x))

deeper[F[_]](n: int) -> int = if n == 0 then 0 else deeper[Result[_, F[int]]](n - 1)

nestErr[E, F[_]](n: int) -> int = if n == 0 then 0 else nestErr[Nest[E], Result[_, Nest[E]]](n - 1)

main()
  println(grow(1, Some(1)))
  println(deeper[Option](1))
  println(nestErr[int, Option](1))
