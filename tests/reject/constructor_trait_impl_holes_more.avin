// error: `Pair` already implements `Mappable` leaving `R` open; a type implements a constructor trait once, at one choice of holes, and this leaves `L` open
// error: `Ranked`'s parameter `A` is bounded by `Ord`, and `Mappable`'s parameter `A` is not, so `Ranked` is no constructor for it: what is `Mappable` applies its constructor to any type
// error: `int` takes no type arguments, so it is no constructor, and only a constructor implements the constructor trait `Mappable`
// error: `Seq` is a trait; an impl of a trait is for a data type, a class, an object or a built-in type
// A type implements a constructor trait at one choice of holes, through any trait requiring it too;
// a class's header is held as an impl is; and a built-in type or a trait is no constructor that an
// impl can make conform.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

trait Chainable[A]: Mappable[A]
  flatMap[B](f: (A) -> Self[B]) -> Self[B]

data Pair[L, R](left: L, right: R)

impl[L, R] Chainable[R] for Pair[L, R]
  map[B](f: (R) -> B) -> Pair[L, B] = Pair(left, f(right))
  flatMap[B](f: (R) -> Pair[L, B]) -> Pair[L, B] = f(right)

impl[L, R] Mappable[L] for Pair[L, R]

class Ranked[A: Ord](val item: A): Mappable[A]
  map[B: Ord](f: (A) -> B) -> Ranked[B] = todo()

impl Mappable for int

impl Mappable for Seq

main()
  println(1)
