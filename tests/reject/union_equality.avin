// error: `==` cannot compare int | string with bool
// error: `!=` cannot compare bool with int | string
// error: `==` cannot compare int | string with bool | char
// error: `==` cannot compare int | string with real
// error: `===` is undefined on Dog | int and Any, which may hold values with no identity; compare with `==`, or give one side a class type
// `==` between a union and a value that is of no member is an error, as comparing two types with no
// common type is, whichever side the union is on; so is comparing two unions sharing no member.
// `===` with no side a union of classes or function types only, as with two `Any`s, is an error.

class Dog

main()
    val u: int | string = 1
    val w: bool | char = true
    val r = 2.5
    println(u == true)
    println(false != u)
    println(u == w)
    println(u == r)
    val d: Dog | int = 1
    val a: Any = d
    println(d === a)
