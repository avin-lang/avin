// error: `Dog` is a type, so it cannot name a value: in a pattern it tests for the type, and `x: Dog` binds a value of it
// error: `Count` is a type, so it cannot name a value: in a pattern it tests for the type, and `x: Count` binds a value of it
// error: `Dog` is a type, so it cannot name a value: in a pattern it tests for the type, and `x: Dog` binds a value of it
// error: this arm is never reached: the arm `Animal` on line 31 already matches every value it would
// error: a value of type Dog is never a Bird, so this type pattern never matches
// A pattern binds no type's name, and a type's name in a pattern reaches coverage and reachability as
// the type pattern it is: an arm after a supertype's is never reached, and a type no value of the
// matched type can have is an error.

open class Animal()

class Dog(): Animal()

class Bird(): Animal()

type Count = int

typed(x: Any) -> int = x match
  Dog: Animal -> 1
  _ -> 0

named(o: Option[Count]) -> int = o match
  Count @ Some(_) -> 1
  _ -> 0

nested() -> int
  inner(Dog: int) -> int = Dog
  inner(1)

covered(a: Animal) -> int = a match
  Animal -> 1
  Dog -> 2

never(d: Dog) -> bool = d is Bird

main() = 0
