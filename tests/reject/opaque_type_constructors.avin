// error: an opaque type's parameter is a type, not a constructor: its layout is its representation's, which `F` applied would leave undecided
// error: `Stack` is an opaque type, laid out as its representation, so it is no constructor; `F[_]` takes a constructor of one argument, such as `Option`
// error: `UserId` is a type; `F[_]` takes a constructor of one argument, such as `Option`
// error: `Stack` is an opaque type, laid out as its representation, so it is no constructor; `F[_]` takes a constructor of one argument, such as `Option`
// An opaque type is no type constructor: a generic one is not passed for a constructor parameter
// `F[_]`, whose every instance is an object, and one is not declared with a constructor parameter,
// which would leave its layout undecided. A plain one is a type, and no constructor at all.
opaque type Stack[T] = Vector[T]
opaque type UserId = long
opaque type W[F[_]] = F[int]

size[F[_]](x: F[int]) -> int = 0

data Holder[F[_]](items: F[string])

main()
  println(size[Stack](Stack[int]([1])))
  println(size[UserId](UserId(1)))
  val h: Holder[Stack] = Holder(Stack[string]([]))
