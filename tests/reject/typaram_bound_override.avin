// error: `take` overrides `Sink.take`, whose type parameter `U` is bounded by no type parameter
// error: `Animal` is not a subtype of `Dog`, the type of `T`, which bounds `U` in `keep`
// error: `V` is not a subtype of `Named`, the type of `T`, which bounds `U` in `keep`
// An override may not assume more of its type arguments than the method it overrides: a bound by a
// type parameter it adds is refused. Through a sink of dogs, `take` holds its argument to `Dog`.
open class Animal(val label: string)

class Dog(label: string): Animal(label)

trait Sink[-T]
  take[U](u: U) -> string
  keep[U: T](u: U) -> string

class Kennel[T]: Sink[T]
  override take[U: T](u: U) -> string = "kennel"
  override keep[U: T](u: U) -> string = "kept"

// A type parameter bounded by a trait may stand for a value type, which is no trait value without a
// conversion, so it is not seen as the trait; one bounded by a class is (see the run test).
trait Named

viaTrait[V: Named](s: Sink[Named], v: V) -> string = s.keep(v)

main()
  val dogs: Sink[Dog] = Kennel[Animal]()
  dogs.keep[Animal](Animal("cow"))
