// A handle's method that may wait is marked `blocking`, alone where it is bound by its own name or
// after the Sysl method's name; a mirror takes no `blocking`, and nor does a handle itself (in
// sysl_blocking_handle_class.avin).
// error: `blocking` is written alone, after the Sysl function's name: `@sysl("sysl.net.accept", blocking)`
// error: `@sysl` takes `blocking` once
// error: `@sysl` on a handle's method takes one string, the name of the Sysl method it is bound to, as in `@sysl("close")`, or `blocking` alone where the method may wait
// error: `@sysl` on a data type takes one string, the module and name of the Sysl enum or struct it mirrors

@sysl("sysl.checksum.Crc32")
class Crc32
    @sysl(blocking: true)
    finish() -> long
    @sysl("finish", blocking, blocking)
    again() -> long
    @sysl(waits)
    other() -> long

@sysl("sysl.time.LocalDate", blocking)
data LocalDate
    LocalDate(day: int)

main() = 0
