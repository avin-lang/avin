// A field accessor is a method of a C handle; each of its parameters but a writer's value is an
// integer index its field names, each with a `bound:`, and `bound:` bounds only an index.
// error: `field:` binds a field accessor, a method of a C handle reading or writing a field of the struct it points at, and `width` is not a method of one
// error: the field accessor `unbounded` takes 1 index and no `bound:`: name the C expression in `self` that bounds each, which the index is checked against before C reads anything
// error: `bound:` bounds an index, and the field accessor `boundless` takes none
// error: `j` is not used by the field `values[i]` of `unused`: every parameter of a field accessor but the value written is an index the field names
// error: `s` is an index of the field accessor `named`, so it is an integer type, and it is `string`

@c(field: "width")
width() -> int

@c(type: "struct thing *", release: "free")
class Thing
  @c(field: "values[i]")
  unbounded(i: int) -> int

  @c(field: "width", bound: "self->count")
  boundless() -> int

  @c(field: "values[i]", bound: ["self->count", "self->count"])
  unused(i: int, j: int) -> int

  @c(field: "names[s]", bound: "self->count")
  named(s: string) -> int

main() = 0
