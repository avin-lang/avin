// error: an export in a type's body names one of its members, then members of what that holds, as in `export c.size`; what a member of `c` holds is exported by its own type
// error: an export is no method, so it takes no `override`
// error: an export presents the members of a value the type holds, so it cannot be `static`
// error: an export takes no annotations
// error: `export c.*` presents each member under its own name; to rename one, name it, as in `export c.{m as n}`
// An export names a member of a member and nothing deeper; it is no method, so it takes neither
// `override`, `static` nor an annotation; a wildcard renames nothing.
class Counter(var count: int)
  bump() = count += 1

class Deep(c: Counter)
  export c.count.more
  override export c.bump
  static export c.count

class Annotated(c: Counter)
  @inline
  export c.bump
  export c.* as everything

main() = ()
