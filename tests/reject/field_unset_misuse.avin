// error: a field left unset by the intrinsic `field_unset` is a `private var`, which the class's own code writes before it reads it
// error: a field left unset by the intrinsic `field_unset` is a `private var`, which the class's own code writes before it reads it
// error: a field left unset by the intrinsic `field_unset` declares its type, as in `private var loose: T = …`
// error: the covariant type parameter `+T` appears in an invariant position, the mutable field `checked`
// error: intrinsic `field_unset` takes no value and answers its type parameter
// A field the core library leaves unset is a private `var` with its type written: a public one could
// be read before it is set, and a `val` would never be set. Only a field left unset is free of the
// class's variance; another `var` of the class is still checked. The intrinsic takes nothing and
// answers its own type parameter.
module avin

@intrinsic("field_unset")
private unsetField[T]() -> T

@intrinsic("field_unset")
private unsetInt(n: int) -> int

class Slots[+T]
  private var held: T = unsetField()
  var shown: T = unsetField()
  private val fixed: T = unsetField()
  private var loose = unsetField[int]()
  private var checked: Option[T] = None

main()
  println(Slots[int]() is Slots)
