// error: `Dog` does not conform to `Ord`, the bound of `A` in `pick`
// error: `Array` is invariant in its parameter `T`, and `F[+_]` takes only a constructor covariant there
// error: `TreeSet` bounds its parameter `A` by `Ord`, and `F` may be applied to any type, so `TreeSet` is no constructor for `F[_]`
// A method taken as a value with its type arguments written has them held to their bounds, as a
// call has: a plain bound, a hole's variance and a constructor's own bounds.
class Dog(val name: string)

class Tools
  pick[A: Ord](x: A) -> A = x
  widen[F[+_]](x: F[int]) -> F[int] = x
  loose[F[_]](x: F[int]) -> F[int] = x

main()
  val f = Tools().pick[Dog]
  val g = Tools().widen[Array]
  val h = Tools().loose[TreeSet]
