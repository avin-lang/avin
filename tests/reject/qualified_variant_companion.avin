// error: `Circle` is a variant of `Shape`, which `Shape.Circle` names; its companion object cannot declare a member of that name
// error: `Empty` is a variant of `Shape`, which `Shape.Empty` names; its companion object cannot declare a member of that name
// `Shape.Circle` is the variant, so a companion of `Shape` declaring a method or a field of a
// variant's name would be hidden by it, and is refused where it is declared.

data Shape
    Circle(radius: real)
    Empty

object Shape
    Circle(r: real) -> Shape = Circle(r)
    val Empty = 0
    unit() -> Shape = Shape.Circle(1.0)

main() = println(Shape.unit())
