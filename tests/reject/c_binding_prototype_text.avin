// A prototype that is not one C declaration is refused at its string, saying what is wrong: a stray
// character, a missing parameter list or parenthesis, text after it, a `void` parameter, types
// that do not combine.
// error: and this one is not: `#` is not part of a C prototype
// error: and this one is not: `abs` is not followed by its parameters in parentheses
// error: and this one is not: the parameter list has no closing `)`
// error: and this one is not: `x` follows the parameter list
// error: and this one is not: `int` does not combine with the type before it

@c("int abs(int) #")
hash(n: int) -> int

@c("int abs")
noParameters(n: int) -> int

@c("int abs(int")
unclosed(n: int) -> int

@c("int abs(int) x")
trailing(n: int) -> int

@c("double int abs(int)")
twoTypes(n: int) -> int

main() = 0
