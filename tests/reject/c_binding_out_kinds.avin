// An out value is a scalar, a string, a handle, an enum mirror or a struct mirror, crossing from the type its pointer
// points at; a status with no out values holds `unit`.
// error: out value 1 of the C binding `unitOut`, `a`, is `unit` in Avin and `int` in C: an out value is a scalar, a string, a handle, an enum mirror or a struct mirror
// error: out value 1 of the C binding `stringAtInt`, `s`, is `string` in Avin and `int *` in C: a string crosses as a C `const char *` or `char *`
// error: out value 1 of the C binding `otherHandle`, `t`, is `Thing` in Avin and `struct other *` in C: a `Thing` crosses as its C type, `struct thing *`
// error: the result of the C binding `resultOut` is `Result[unit, int]` in Avin and `void` in C: a status is a C integer, `Ok` for zero and `Err` of the code otherwise
// error: out value 1 of the C binding `resultOut`, `r`, is `unit` in Avin and `int` in C: an out value is a scalar, a string, a handle, an enum mirror or a struct mirror

@c(type: "struct thing *", release: "thing_free")
class Thing

@c("void nothing(out int *a)")
unitOut()

@c("void name(out int **s)")
stringAtInt() -> string

@c("void made(out struct other **t)")
otherHandle() -> Thing

@c("void nested(out int *r)")
resultOut() -> Result[unit, int]

@c("int status(void)")
statusWithValue() -> Result[long, int]

main() = 0
