// error: `Sorted`'s parameter `T` is bounded by `Ord`, and `SendableMonad`'s parameter `A` is not
// error: `SendableMonad`'s parameter `A` is bounded by `Sendable`, so the hole it stands for is too, as in `F[_: Sendable]`
// error: `A` does not conform to `Sendable`, the bound of `A` in `SendableFunctor`: it is a type parameter that may stand for any type
// A constructor whose parameter is bounded by more than the trait's parameter promises is no
// constructor implementing it, and a constructor parameter bounded by it promises the bound of its
// hole; a constructor whose parameter has no bound implements it, but a trait requiring the trait
// bounds its own parameter as the trait does.
data Sorted[T: Ord](value: T)

impl SendableMonad for Sorted
  static pure[X: Sendable](value: X) -> Sorted[X] = Sorted(value)

  map[B: Sendable](@sendable f: (T) -> B) -> Sorted[B] = Sorted(f(value))

  flatMap[B: Sendable](@sendable f: (T) -> Sorted[B]) -> Sorted[B] = f(value)

loose[F[_]: SendableMonad](x: F[int]) -> F[int] = x

trait Loose[A]: SendableFunctor[A]
  extra() -> int

main()
  println(0)
