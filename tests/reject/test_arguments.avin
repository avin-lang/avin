// error: `should_trap` is written alone, or with the text the trap must print: `@test(should_trap: "out of bounds")`
// error: `ignore` needs the reason the test is not run, written as a string: `@test(ignore: "the parser drops the second arm")`
// error: `timeout` is a whole number of seconds from 0, for no limit, to 2147483: `@test(timeout: 30)`
// After its description, `@test` takes `should_trap`, alone or with text; `timeout`, whole seconds in
// range; and `ignore`, with a reason that is not empty.

@test(should_trap: 3)
trapText()
  assert(true)

@test(ignore)
bareIgnore()
  assert(true)

@test(ignore: "")
emptyIgnore()
  assert(true)

@test(timeout: 1.5)
fractionOfASecond()
  assert(true)

@test(timeout: 2147484)
pastTheLimit()
  assert(true)

main() = 0
