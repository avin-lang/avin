// A function declared with `def` and no parameter list shares its scope's one namespace: a value of
// its name in the same scope is refused, at the top level and in a block, and it is the only function
// of its name, so an overload with a parameter list is refused too.
// error: `now` is already a function
// error: `dup` is declared both with and without a parameter list: the one without is the only function of its name
// error: `v` is already declared as a local function in this block
// error: `w` is declared both with and without a parameter list
// error: `u` is already declared as a local function in this block

def now -> int = 1
val now = 2
def dup -> int = 1
dup(x: int) -> int = x

main() =
  val v = 1
  def v -> int = 2
  def w -> int = 2
  w(x: int) -> int = x
  def u -> int = 2
  val u = 1
