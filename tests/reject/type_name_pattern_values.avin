// error: `Box` is a generic type, and a type pattern names its type arguments, as in `_: Box[int]`
// error: `Pair` is a generic type, and a type pattern names its type arguments, as in `_: Pair[int, int]`
// error: `Cell` is a type, so it cannot name a value: in a pattern it tests for the type, and `x: Cell` binds a value of it
// error: `Dog` is a type, so it cannot name a value: in a pattern it tests for the type, and `x: Dog` binds a value of it
// error: `Pet` is a type, so it cannot name a value: in a pattern it tests for the type, and `x: Pet` binds a value of it
// A type's name in a pattern tests for the type, so a generic type's name alone, which names no type
// arguments, is refused, and no local or parameter may be named after a type.

class Box[T](val item: T)

trait Pair[A, B]

data Cell(value: int)

class Dog()

trait Pet

boxed(x: Any) -> bool = x is Box

paired(x: Any) -> bool = x match
  Pair -> true
  _ -> false

local() -> int
  val Cell = 3
  Cell

param(Dog: int) -> int = Dog

lambda() -> int
  val f = (Pet: int) -> Pet + 1
  f(1)

main() = 0
