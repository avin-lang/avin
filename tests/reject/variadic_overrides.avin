// error: `sum` overrides `Summer.sum`, whose parameter `xs` is repeated
// error: `count` overrides `Counter.count`, whose parameter `xs` is not repeated
// error: `values` is declared more than once with the same parameter types
trait Summer
    sum(xs: int*) -> int

class Plain: Summer
    override sum(xs: Vector[int]) -> int = xs.length

open class Counter
    count(xs: Vector[int]) -> int = xs.length

class Repeating: Counter
    override count(xs: int*) -> int = xs.length

// Inside the function a repeated parameter is a vector, so these have the same parameter types.
values(xs: int*) -> int = 1
values(xs: Vector[int]) -> int = 2

main()
    ()
