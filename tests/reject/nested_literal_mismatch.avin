// error: expected Vector[long], found Vector[string]
// error: expected Option[long], found Option[real]
// error: expected (long, long), found (int, int, int)
// error: no overload of `kind` accepts these arguments
// error: expected (int, long), found (long, long)
// The type another argument decides is an expected type, not a conversion: a string, a real or a
// tuple of another arity is still a mismatch. An overload's choice sees a nested literal at its own
// type where the candidates' parameters differ, and of two arguments that both hold literals the
// first decides for the second.
same[T](a: T, b: T) -> T = b
longs() -> Vector[long] = [long(1)]
kind(o: Option[long]) -> string = "long"
kind(o: Option[string]) -> string = "string"

main()
  val x: long = 1
  assertEq(longs(), ["a"])
  println(same(Some(x), Some(1.5)))
  println(same((x, x), (1, 2, 3)))
  println(kind(Some(1)))
  println(same((1, x), (x, 2)))
