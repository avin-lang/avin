// error: `Row` cannot derive `Ord`: its field `id` has type `UserId`, which does not implement `Ord`
// error: `Shown` cannot derive `Display`: its field `id` has type `UserId`, which does not implement `Display`
// error: `UserId` does not conform to `Debug`, the bound of `T` in `debug`
// A data type derives a trait only where its opaque-typed fields implement it: an opaque type has
// no trait of its representation's, `Debug` included, unless an impl gives it one.
opaque type UserId = long

data Row(id: UserId) derives Ord

data Shown(id: UserId) derives Display

main()
  println(debug(UserId(1)))
