// error: `Hold` hides `A`, and its field `value` names it: an `is` test or a binding takes apart no field of a hidden type; take the value apart with `match`, whose arm is compiled for each type the value hides
// error: `Hold` hides `A`, and its field `show` names it: an `is` test or a binding takes apart no field of a hidden type; take the value apart with `match`, whose arm is compiled for each type the value hides
// error: `Hold` hides `A`, and its field `value` names it: an `is` test or a binding takes apart no field of a hidden type; take the value apart with `match`, whose arm is compiled for each type the value hides
// error: `clause` yields A, not int
// An `is` test, alone or under `&&`, is compiled once for every pack of the value it tests, so it
// binds no field whose type names a hidden parameter; it may test the fields every pack shares the
// type of, and leave the others unmatched. A clause's result is held to the declared one.
data Box
  Hold[A](value: A, show: (A) -> string, tag: int)
  Empty

tested(b: Box) -> string
  if b is Hold(v, _, _) then "held" else "empty"

shown(b: Box) -> string
  if b is Hold(_, f, _) then "shown" else "empty"

both(b: Box, c: Box) -> bool = b is Hold(_, _, 1) && c is Hold(v, _, _)

clause(b: Box) -> int
clause(Hold(v, _, _)) = v
clause(Empty) = 0

main()
  println(tested(Empty))
