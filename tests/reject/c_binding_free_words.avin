// `@c` on a function takes the prototype and `free:`, which names, as a string, the C function that
// frees a string the binding answers, once; a binding that answers no string has nothing to free.
// error: `free:` names the C function that frees a string the binding answers, and `labs` answers no string: its result is `long` in C
// error: `free:` names a C function, and `not a name` is not a C identifier
// error: `free:` names the C function that frees the string as a string, as in `free: "free"`
// error: `owned:` is not a word of `@c` on a function, which takes `free:`, `keeps:`, `consumes:`, `array:`, `length:`, `borrowed` and `blocking`
// error: `free:` is given once

@c("long labs(long)", free: "free")
labs(n: long) -> long

@c("char *strdup(const char *s)", free: "not a name")
spaced(s: string) -> string

@c("char *strdup(const char *s)", free: 3)
numbered(s: string) -> string

@c("char *strdup(const char *s)", owned: "free")
owned(s: string) -> string

@c("char *strdup(const char *s)", free: "free", free: "free")
twice(s: string) -> string

main() = 0
