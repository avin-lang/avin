// error: `<` needs (Plain, int) to implement `Ord`
// error: `<` needs (unit, int) to implement `Ord`
// error: `Either[Plain, int]` does not conform to `Ord`, the bound of `T` in `smaller`
// A tuple, an either or a result is ordered only when every part is, and `unit` and a type without
// `Ord` have no order.
data Plain(n: int)

smaller[T: Ord](a: T, b: T) -> T = a

main()
  println((Plain(0), 1) < (Plain(1), 0))
  println(((), 1) < ((), 2))
  val a: Either[Plain, int] = Left(Plain(1))
  println(smaller(a, a).isLeft)
