// What C keeps of memory: a `ByteBlock`, with `keeps:`, held by the handle a binding answers or by
// its receiver; never a view, which C lent, and never `consumes:`. A `shared` handle lends no view.
// error: parameter 1 of the C binding `overView` is `ByteView` in Avin and `const unsigned char *` in C: a view is memory C lends, never passed back to C; memory C reads, writes or keeps is a `ByteBlock`
// error: `keeps:` names the view `v`, which C lent: what C keeps is a `ByteBlock`
// error: `consumes:` names the `ByteBlock` `b`: C keeps a block, with `keeps:`, and Avin frees it once nothing holds it
// error: `keeps:` makes the handle a binding answers keep what it names, and `keepsAlone` answers no handle and is no method of one
// error: `Shared` is `shared`, so another thread may use it while a view it lent is read; a view is lent only by a handle that belongs to one thread at a time
import avin.c.{ByteBlock, ByteView}

@c(type: "struct surface *", release: "free")
class Surface

@c("struct surface *over_view(const unsigned char *v)", keeps: "v")
overView(v: ByteView) -> Surface

@c("struct surface *over_block(unsigned char *b)", consumes: "b")
consumed(b: ByteBlock) -> Surface

@c("void hold(unsigned char *b)", keeps: "b")
keepsAlone(b: ByteBlock)

@c(type: "struct frame *", release: "free", shared)
class Shared
    @c("unsigned char *frame_data(struct frame *self)", view, length: "4")
    bytes() -> ByteView

main() = 0
