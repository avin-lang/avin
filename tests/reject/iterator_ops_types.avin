// error: `real` does not conform to `Integer`, the bound of `T` in `from`
// error: `flatten` is for an `Iterator` of an `Iterable`; this is `Iterator[int]`
// error: `Iterator` has no member `peek`
// error: expected (int) -> Either[_, _], found (int) -> int
// error: expected Vector[int], found Iterator[int]

// The companion iterators and the new transformations keep their types: `from` counts integers
// only, `flatten` needs collections for elements, `peek` is a buffered iterator's, `partitionMap`
// needs an `Either`, and a lazy result is an iterator, not a vector.

main()
  val halves = Iterator.from(0.5)
  val chars = [1, 2].iterator().flatten
  val ahead = [1].iterator().peek()
  val sides = Set(1).partitionMap(x -> x + 1)
  val v: Vector[int] = [1].iterator().scanLeft(0, (a, x) -> a + x)
