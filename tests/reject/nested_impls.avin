// error: `U` is not part of `Box[List[T]]`; each of an impl's type parameters is, so a call learns it from the receiver's type
// error: the type an impl of a trait is for takes the impl's type parameters, in order, as in `impl[T] Display for Box[T]`
// error: `count` is ambiguous on Pair[int, List[int]]: impls of `Pair[T, List[T]]` and of `Pair[A, List[B]]` each add it with the same parameter types
// error: `size` is ambiguous on Box[List[int]]: `Box` has it, and an impl adding to `Box[List[T]]` adds it with the same parameter types
// error: `largest` needs `T: Ord`, which Box[List[() -> int]] does not meet
data Box[T](value: T)

data Pair[A, B](first: A, second: B)

impl[T] Box[T]
    size() -> int = 1

impl[T] Box[List[T]]
    size() -> int = value.length()

// A bound on a nested impl's parameter applies at the call.
impl[T: Ord] Box[List[T]]
    largest() -> Option[T] = value.maxOption()

impl[T, U] Box[List[T]]
    other() -> int = 0

impl[T] Display for Box[List[T]]
    display(w: Writer) = ()

// Two impls whose types both match `Pair[int, List[int]]`.
impl[T] Pair[T, List[T]]
    count() -> int = 0

impl[A, B] Pair[A, List[B]]
    count() -> int = 1

main()
    val ints: List[int] = [1]
    println(Pair(1, ints).count())
    println(Pair("a", ints).count())
    println(Box(ints).size())
    val fs: List[() -> int] = [() -> 1]
    println(Box(fs).largest())
