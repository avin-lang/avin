// error: `Counter` promises to be `Sendable`, but its field `count` is a `var`; make it a `val`
// error: `Slot[A]` promises to be `Sendable`, but its field `value` is a `var`; make it a `val`
// error: `Vector[int]` does not conform to `Tag`, the bound of `T` in `tagged`
// error: `Vector[Plain]` does not conform to `Tag`, the bound of `T` in `tagged`
// An impl of a trait that promises `Sendable` keeps its own bound: a type argument outside it does
// not make the type that trait's, though `Vector[Plain]` stays `Sendable` by the standard library's
// impl; and an impl of such a trait, plain or generic, is a promise the type's structure must keep.
trait Tag: Sendable
  tag -> string

data Plain(n: int)

impl[T: Tag] Tag for Vector[T]
  tag -> string = "v"

class Counter
  var count = 0

impl Tag for Counter
  tag -> string = "counter"

class Slot[A](var value: A)

impl[A: Tag] Tag for Slot[A]
  tag -> string = "slot"

send[T: Sendable](value: T) -> string = "sent"

tagged[T: Tag](value: T) -> string = value.tag

main()
  println(send([Plain(1)]))
  println(tagged([1]))
  println(tagged([Plain(1)]))
