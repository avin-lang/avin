// error: a literal does not match an Any; match the value by its type first, as in `n: int`
// error: a value of type int is never a string, so this type pattern never matches
// error: expected (Any, int), found (int, int)
// error: integer literal is not exact as a real; write it with a fraction or exponent
// A literal does not match an Any, a type pattern that can never match is an error, a number inside
// a tuple already made is not boxed to make an `(Any, int)`, and an integer literal is a real only
// when it is exact.

wide(p: (Any, int)) -> int = p.1

lit(x: Any) -> string = x match
  5 -> "five"
  _ -> "other"

never(n: int) -> string = n match
  s: string -> s
  _ -> "int"

main()
  val t: (int, int) = (7, 1)
  println(wide(t))
  val tooBig: real = 9007199254740993
  println(tooBig)
