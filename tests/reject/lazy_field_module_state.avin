// error: what is passed for `body` of `spawn` may run on another thread, which shares the program's module-level state, but through `Box.v` → `Box.fill` it reaches `shared`, a module-level value holding a `Buffer[string]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: what is passed for `body` of `spawn` may run on another thread, which shares the program's module-level state, but through `Gen.v` → `Gen.fill` it reaches `shared`, a module-level value holding a `Buffer[string]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: what is passed for `body` of `spawn` may run on another thread, which shares the program's module-level state, but through `Own.v` → `Own.fill` it reaches `shared`, a module-level value holding a `Buffer[string]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: what is passed for `body` of `spawn` may run on another thread, which shares the program's module-level state, but through `Cache.v` → `Cache.fill` it reaches `shared`, a module-level value holding a `Buffer[string]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: what is passed for `body` of `spawn` may run on another thread, which shares the program's module-level state, but through `Through.get` → `Through.v` → `Through.fill` it reaches `shared`, a module-level value holding a `Buffer[string]`, which is mutable; an immutable copy (`toVector`) is sendable
// A `lazy val` field's first read runs its initializer on whichever thread reads it, so code that
// may run on another thread reaches whatever the initializer reaches, as it does through a
// module-level `lazy val`: a method of the class it calls, with or without `self`, at any type
// argument of a generic class, and in an `object`, read directly or through a method that reads it.
import avin.threads.spawn

val shared = Buffer[string]()

class Box(val n: int)
  lazy val v: int = fill()
  private fill() -> int
    for i in 0 ..< 3 do shared.append(s"x$i")
    n

class Gen[T](val x: T)
  lazy val v: int = fill()
  fill() -> int
    shared.append("g")
    1

class Own(val n: int)
  lazy val v: int = self.fill() + n
  fill() -> int
    shared.append("o")
    1

object Cache
  lazy val v: int = fill()
  fill() -> int
    shared.append("c")
    1

class Through(val n: int)
  lazy val v: int = fill()
  fill() -> int
    shared.append("t")
    n
  get() -> int = v

main()
  val ts = (0 ..< 4).map(k -> Box(k)).map(b -> spawn(() -> b.v))
  for t in ts do println(t.join())
  val g = Gen("é")
  println(spawn(() -> g.v).join())
  val o = Own(1)
  println(spawn(() -> o.v).join())
  println(spawn(() -> Cache.v).join())
  val th = Through(1)
  println(spawn(() -> th.get()).join())
