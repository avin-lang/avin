// error: `Mappable` is a constructor trait, so `Self` in it is a constructor, a type only with its 1 type argument, as in `Self[A]`
// error: `Mappable` is a bound for a constructor of one argument; declare `T[_]`
// error: `Mappable` is a constructor trait, so it is a bound of a constructor, as in `[F[_]: Mappable]`, and not a type
// error: `Bimappable` is a bound for a constructor of two arguments, and `F` takes one argument
// error: `Mappable` is a constructor trait, which bounds a constructor parameter named without arguments, as in `F[_]: Mappable`
// A constructor trait's `Self` is a constructor, written with its arguments; the trait bounds a
// constructor parameter of its arity, named bare, and is never a type or a type parameter's bound.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]
  same() -> Self

trait Bimappable[A, B]
  bimap[C, D](f: (A) -> C, g: (B) -> D) -> Self[C, D]

plain[T: Mappable](x: T) -> int = 0

typed(x: Mappable[int]) -> int = 0

wrongArity[F[_]: Bimappable](x: F[int]) -> int = 0

applied[F[_]: Mappable[int]](x: F[int]) -> int = 0

main()
  println(1)
