// error: `*|` is an operator of the language and cannot name a method
// error: `==` is an operator of the language, which a type has by implementing `Eq`, not by a method named `==`
// error: `::` is an operator of the language and cannot name a method
// error: `+:=` is an operator of the language and cannot name a method
// error: `++` names a function, but only a method can be named by a symbol: declare it in a class, trait, object or impl
class Bag(val items: Vector[int])
    *|(other: Bag) -> Bag = self
    ==(other: Bag) -> bool = true
    ::(x: int) -> Bag = self
    +:=(x: int) -> Bag = self
    ++(other: Bag) -> Bag = self

++(a: int, b: int) -> int = a

main()
    val a = Bag([1]) ++ Bag([2])
