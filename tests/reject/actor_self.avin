// error: `ActorRef` has no member `count`
// error: `ActorRef` has no member `helper`
// error: a `@sendable () -> int` may use only sendable values from around it, but it uses the state of the actor `Leaky`, whose field `count` is a `var`; make it a `val`
// error: `self` names the actor's reference; it cannot be declared
// error: `Behaviour` has no member `helper`
// `self` in an actor is its reference, so the actor's fields and methods are not its members, and
// the object holding the actor's state is never a value the program sees: a method value, which
// would carry the state, is refused where it is made as a `@sendable` function since the state has
// a `var`. `self` cannot be declared in an actor either, and a behaviour has none of the actor's
// methods.
import avin.actors.ActorRef

data Msg
    Go(back: ActorRef[@sendable () -> int])

actor Selfish receives int
    var count = 0
    helper() -> int = count
    receive
        n ->
            self.count = n
            self.helper()

actor Leaky receives Msg
    var count = 0
    peek() -> int = count
    receive
        Go(back) -> back.tell(peek)

actor Shadow receives int
    receive
        n ->
            val self = n
            ()

main()
    Selfish().helper()
