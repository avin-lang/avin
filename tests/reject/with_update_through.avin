class Person(var name: string)

data Shape
    Circle(radius: int)
    Square(side: int)

data Point(x: int, y: int)

data Spot(maybe: Option[Point])

data Thing(owner: Person, shape: Shape, at: Spot, count: int)

data Cell[T](value: T)

poke[T](c: Cell[T]) -> Cell[T] = c with { value.x = 1 }

main()
    val t = Thing(Person("a"), Circle(1), Spot(None), 0)
    val a = t with { owner.name = "b" }
    val b = t with { shape.radius = 2 }
    val d = t with { at.maybe.x = 1 }
    val e = t with { count.x = 1 }
