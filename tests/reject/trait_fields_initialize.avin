// error: `second` is read in the value of the trait's field `first`, which a class computes before its body: it may read only the fields initialized before it, and use `self` for nothing else
// error: `compute` is called in the value of the trait's field `c`, which a class computes before its body: it may read only the fields initialized before it, and use `self` for nothing else
// error: `self` is passed, stored or returned in the value of the trait's field `me`, which a class computes before its body: it may read only the fields initialized before it, and use `self` for nothing else
// error: a lambda that captures `self` is made in the value of the trait's field `later`, which a class computes before its body: it may read only the fields initialized before it, and use `self` for nothing else
// error: `fixed` is a `val` field of `Frozen`; only a `var` field can be assigned
trait Early
  val first: int = second + 1
  val second: int = 2

class UsesEarly: Early

trait Calls
  val c: int = compute()
  compute() -> int = 3

trait Escapes
  val me: Option[Escapes] = Some(self)
  val later: () -> int = () -> me.map((e) -> 1).getOrElse(0)

class Order(val n: int): Calls, Escapes

trait Frozen
  val fixed: int = 1

assign(f: Frozen) = f.fixed = 2

main() = ()
