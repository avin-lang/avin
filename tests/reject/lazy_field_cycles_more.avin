// error: the `lazy val` `label` needs its own value to initialize: `label` → `label`
// error: the `lazy val` `ratio` needs its own value to initialize: `ratio` → `ratio`
// error: the `lazy val` `doubled` needs its own value to initialize: `doubled` → `doubled`
// error: the `lazy val` `aliased` needs its own value to initialize: `aliased` → `aliased`
// error: the `lazy val` `helped` needs its own value to initialize: `helped` → `helped`
// More ways a field's initializer reaches its own value: an object extending a class whose
// override reads the inherited field by the object's name, an actor's field, an operator applied
// to the object, a local holding the object, and a local function the initializer calls.
open class Labelled
  lazy val label: string = text()

  text() -> string = "plain"

object Fancy: Labelled
  override text() -> string = Fancy.label + "!"

actor Reader(divisor: int) receives int
  lazy val ratio: int = 100 / divisor + ratio

  receive
    n -> println(ratio / n)

class Money(cents: int)
  lazy val doubled: Money = self + self

impl Add for Money
  add(other: Money) -> Money = Money(cents + other.cents + doubled.cents)
  static zero() -> Money = Money(0)

class Aliased
  lazy val aliased: int =
    val me = self
    me.aliased + 1

class Helped
  lazy val helped: int =
    twice() -> int = helped * 2
    twice()

main() = ()
