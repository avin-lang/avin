// Each field of a C struct mirror is an integer type, `byte`, `bool`, `real`, a `string` or
// `Option[string]`, an enum mirror or another struct mirror that does not hold it; no two fields
// mirror one C field, and a field's `@c` names its C field as one C identifier.
// error: `Vector[int]` cannot be a field of the C struct mirror `Bad`: a field is an integer type, `byte`, `bool`, `real`, a `string` or `Option[string]`, an enum mirror or another struct mirror
// error: `char` cannot be a field of the C struct mirror `Bad`: a field is an integer type, `byte`, `bool`, `real`, a `string` or `Option[string]`, an enum mirror or another struct mirror
// error: a C struct mirror cannot hold itself: `Loop` holds `Loop`
// error: two fields of the C struct mirror `Twice` mirror the C field `x_y`
// error: `@c` on a field names the C field it mirrors, and `not a name` is not a C identifier

@c(struct: "as_bad")
data Bad(v: Vector[int], c: char, ok: Option[string])

@c(struct: "as_loop")
data Loop(next: Loop)

@c(struct: "as_twice")
data Twice(xY: int, @c("x_y") other: int)

@c(struct: "as_named")
data Named(@c("not a name") name: string)

main() = 0
