// error: `===` compares identities, and P values have none
// error: `===` compares identities, and (int, int) values have none
// error: `===` compares identities, and Option[int] values have none
// error: `===` is undefined on T and T, which may hold values with no identity; compare with `==`, or give one side a class type
// error: `===` cannot compare Cell with () -> int
// `===` is defined only on reference types: a data value, a tuple, an Option and an unbounded type
// parameter have no identity, and two unrelated reference types have no common type.

data P(x: int)

class Cell(v: int)

values(a: P, b: (int, int), e: Option[int]) -> bool
  if a === a then return true
  if b === b then return true
  e === e

same[T](a: T, b: T) -> bool = a === b

mixed(c: Cell, f: () -> int) -> bool = c === f

main()
  println(values(P(1), (1, 2), None))
