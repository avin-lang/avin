// error: integer literal does not fit in byte, which holds 0 to 255
// error: integer literal does not fit in byte, which holds 0 to 255
// error: integer literal does not fit in i8
// error: integer literal is not exact as a real
// error: integer literal does not fit in long
// A literal nested in a value takes the width another argument decides, and is held to it: one
// that does not fit that width is an error, as a bare literal is.
same[T](a: T, b: T) -> T = b

main()
  val b: byte = 1
  val x: long = 1
  println(same([b], [256]))
  println(same((b, b), (0, -1)))
  println(same(Some(i8(1)), Some(128)))
  println(same([1.5], [1, 9_007_199_254_740_993]))
  println(same(Some([x]), Some([9_223_372_036_854_775_808])))
