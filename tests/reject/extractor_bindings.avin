// error: a binding's pattern must match every (int, int) value; take the value apart with `match`
// error: a binding's pattern must match every (int, int) value; take the value apart with `match`
object Twice
    unapply(n: int) -> Option[int] = if n % 2 == 0 then Some(n / 2) else None

// A binding's pattern and a `for`'s cannot fail, and an extractor may.
main()
    val (a, Twice(h)) = (1, 8)
    for (k, Twice(q)) in [(1, 2)]
        println(q)
