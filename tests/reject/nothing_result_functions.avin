// error: expected (Animal) -> Option[int], found (Dog) -> Nothing
// error: expected (int) -> int, found (int, int) -> Nothing
// error: expected (int) -> Nothing, found (int) -> Option[int]
// error: expected Vector[(int) -> Option[int]], found Vector[(int) -> Nothing]
// error: expected @sendable (int) -> Option[int], found (int) -> Nothing

// A function whose result is `Nothing` converts only where its parameters are the expected ones on
// the terms a function type's parameters vary by, and only where it is written: a parameter narrower
// than the one expected, another count of parameters, the other direction, a function held inside a
// collection and a plain function value expected as a `@sendable` one are each refused.

open class Animal()

class Dog(): Animal()

refuseDog(d: Dog) -> Nothing = fail("dog")

refuseBoth(a: int, b: int) -> Nothing = fail("both")

some(x: int) -> Option[int] = Some(x)

refuse(x: int) -> Nothing = fail("refused")

main()
    val ofAnimal: (Animal) -> Option[int] = refuseDog
    val ofOne: (int) -> int = refuseBoth
    val never: (int) -> Nothing = some
    val held: Vector[(int) -> Nothing] = [refuse]
    val wider: Vector[(int) -> Option[int]] = held
    val plain = refuse
    val sent: @sendable (int) -> Option[int] = plain
