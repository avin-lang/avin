// error: the `lazy val` `inLambda` needs its own value to initialize: `inLambda` → `inLambda`
// error: the `lazy val` `inField` needs its own value to initialize: `inField` → `inField`
// error: the `lazy val` `generic` needs its own value to initialize: `generic` → `generic`
// error: the `lazy val` `deep` needs its own value to initialize: `deep` → `deep`
// error: the `lazy val` `matched` needs its own value to initialize: `matched` → `matched`
// A local `lazy val` declared in a lambda's body, in a field's lazy initializer and in a generic
// function, one reached through two local functions calling each other, and one read in a match arm
// of its own initializer.
lambdaBody() -> int
  val f = () ->
    lazy val inLambda: int = inLambda + 1
    inLambda
  f()

class Holder
  lazy val total: int =
    lazy val inField: int = inField * 2
    inField

firstOf[T](items: Vector[T], fallback: T) -> T
  lazy val generic: T = if items.length > 0 then fallback else generic
  generic

twoHelpers() -> int
  lazy val deep: int = outer()
  outer() -> int = inner() + 1
  inner() -> int = deep * 2
  deep

matching(n: Option[int]) -> int
  lazy val matched: int = n match
    Some(x) -> x
    None -> matched + 1
  matched

main() = ()
