// error: `-` is the language's operator on int, and no method can redefine it; a method `-` added to int takes one argument of a data type, a class, a trait or an opaque type
// error: `/` is the language's operator on long, and no method can redefine it; a method `/` added to long takes one argument of a data type, a class, a trait or an opaque type
// error: `|` is the language's operator on int, and no method can redefine it; a method `|` added to int takes one argument of a data type, a class, a trait or an opaque type
// error: `>>` is the language's operator on byte, and no method can redefine it; a method `>>` added to byte takes one argument of a data type, a class, a trait or an opaque type
// error: `-` is the language's operator on real, and no method can redefine it
// The operand of an operator method added to a built-in type is of a type the program declares: a
// built-in operand, a function or a union is refused, and a prefix operator on a built-in type is
// still the language's own.
impl int
  -(o: long) -> int = self
  |(f: (int) -> int) -> int = self

impl long
  /(o: int | string) -> long = self

impl byte
  >>(o: string) -> byte = self

impl real
  -() -> real = self

main()
  println(1)
