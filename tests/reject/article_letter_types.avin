// error: a value of type Animal is never an M, so this type pattern never matches
// error: a value of type Animal is never a U, so this type pattern never matches
// error: a value of type Animal is never an X2, so this type pattern never matches
// error: a value of type Animal is never a Unicorn, so this type pattern never matches
// error: a value of type int is never a unit, so this type pattern never matches
// The article before a type's name in a diagnostic: a capital letter standing alone is read as the
// letter (`an M`, `a U`, `an X2`); a name read as a word takes `an` before a vowel other than `u`
// (`a Unicorn`, `a unit`).

open class Animal()
class M()
class U()
class X2()
class Unicorn()

letter(a: Animal) -> int = a match
  m: M -> 1
  _ -> 0

vowelLetter(a: Animal) -> int = a match
  u: U -> 1
  _ -> 0

letterDigit(a: Animal) -> int = a match
  x: X2 -> 1
  _ -> 0

uWord(a: Animal) -> int = a match
  u: Unicorn -> 1
  _ -> 0

unitWord(n: int) -> int = n match
  u: unit -> 1
  _ -> 0

main() -> int = 0
