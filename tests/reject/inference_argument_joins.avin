// error: expected Dog, found Cat
// error: expected Box[Cat], found Box[Dog]
// error: expected Duck, found Frog; they have no common superclass and share the unrelated traits Named and Swims, so write the type wanted
// error: the branches of this `if` yield Duck and Frog

// Arguments of one type parameter join only where a join exists: two scalars of different types
// have none, an invariant use decides the type argument for good, and two classes sharing several
// unrelated traits have no single one to agree on.

open class Animal()
class Dog() : Animal()
class Cat() : Animal()

class Box[T](var item: T)

trait Named
    label() -> string

trait Swims
    depth() -> int

class Duck() : Named, Swims
    override label() -> string = "duck"
    override depth() -> int = 1

class Frog() : Named, Swims
    override label() -> string = "frog"
    override depth() -> int = 2

pair[T](a: T, b: T) -> (T, T) = (a, b)
store[T](b: Box[T], x: T) = b.item = x
storeAfter[T](x: T, b: Box[T]) = b.item = x

main()
    val mixed = pair(1, "one")
    val dogs = Box(Dog())
    store(dogs, Cat())
    storeAfter(Cat(), dogs)
    val swimmers = pair(Duck(), Frog())
    val either = if true then Duck() else Frog()
