// error: `name` is already a member of `Named`, which `Defaulted` requires; a trait's field or `val` is declared once
// error: `pos` is already a field of `Positional`
// error: `fixed` is a `val` field of `Frozen`; only a `var` field can be assigned
// error: `count` is declared more than once in `Twice`; a trait's `val` shares its name with no other member
trait Named
  val name: string

trait Defaulted: Named
  val name: string = "x"

trait Positional
  var pos: int = 0

class Located: Positional
  pos() -> int = 1

trait Frozen
  val fixed: int = 1
  thaw() = fixed = 2

trait Twice
  var count: int = 0
  count() -> int = 1

main() = ()
