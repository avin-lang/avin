// A branch whose value is thrown away is judged on its own: an `if` without `else`, both branches
// of an `if` written as a statement, a `match` arm written as a statement, and a loop's body. The
// `if` and the `match` themselves are not reported again; an arm that drops nothing is not either.
fails(k: int) -> Result[int, string] = if k > 0 then Ok(k) else Err("no")

main()
  val n = 3
  var i = 0
  val r = fails(1)
  if n > 0 then fails(5)
  if n > 1 then fails(6) else fails(7)
  n match
    3 -> fails(8)
    _ -> println("other")
  while i < 2
    i += 1
    fails(i)
  println(r.isOk)
