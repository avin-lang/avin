// error: expected Readiness, found int
// error: expected Readiness, found Channel[int]
// error: expected Readiness, found string
// error: this arm yields string, but the arms before it yield int
// A `readable()` arm names a stream, anything that is a `Readiness`: an int, a channel or a string is
// reported as a call's argument of the wrong type is; and its body's type unifies with the other
// arms' as a match's does.
import avin.net.TcpStream
import avin.threads.Channel

f(c: TcpStream)
  val n = 3
  val ch = Channel[int]()
  select
    n.readable() -> ()
  select
    ch.readable() -> ()
  select
    "s".readable() -> ()
  val v: int = select
    ch.receive() as Some(x) -> x
    c.readable() -> "a"

main() = ()
