// error: `Pet` is a trait; an impl of a trait is for a data type, a class, an object or a built-in type
// A value of `Any` or of a trait is shown by its type at run time, but a value whose static type is
// a class still needs that class's own `Display`, and a type parameter its bound's. A trait's values
// are shown by their own types, so no impl gives a trait a `Display` of its own.

trait Pet
    name() -> string

class Cat(): Pet
    override name() -> string = "cat"

describe[T: Pet](pet: T) -> string = s"$pet"

impl Display for Pet
