// error: this call to `pure` is ambiguous: `Pointed.pure[A, X](value: X)`, `Lifted.pure[A, X](value: X)` each accept it, and none is more specific than the others
// A constructor parameter bounded by two traits that each declare a static member of one name and
// parameter types has no one member to call.
trait Pointed[A]
  static pure[X](value: X) -> Self[X]

trait Lifted[A]
  static pure[X](value: X) -> Self[X]

clash[F[_]: Pointed & Lifted](n: int) -> F[int] = F.pure(n)

main()
  println(1)
