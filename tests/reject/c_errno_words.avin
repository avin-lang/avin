// `errno` is said once; a binding marked `errno` still splits its `Ok` as any result splits, the C
// result followed by the out values or the out values alone, and a `void` function answers no -1.
// error: `errno` is said once
// error: the result of the C binding `tooMany` is `Result[(int, int, int), Errno]` in Avin and `int` in C: the binding answers the C result followed by its one out value, a tuple of 2, or its one out value alone
// error: the result of the C binding `nothing` is `Result[unit, Errno]` in Avin and `void` in C: `errno` marks a C function that answers -1 where it fails, so its result is a C integer
// error: the result of the C binding `errnoWord` is `Result[int, Errno2]` in Avin and `int` in C: a binding marked `errno` answers a `Result`: `Ok` of what C answers where it does not answer -1, and `Err` of why where it does, an `Errno` or an integer, as in `Result[int, Errno]`

import avin.c.Errno

@c("int f(int x)", errno, errno)
twice(x: int) -> Result[int, Errno]

@c("int f(int x, out int *y)", errno)
tooMany(x: int) -> Result[(int, int, int), Errno]

@c("void h(int x)", errno)
nothing(x: int) -> Result[unit, Errno]

// An error type that is no `Errno` and no integer: a data type of the program's own named so.
data Errno2
  Bad

@c("int f(int x)", errno)
errnoWord(x: int) -> Result[int, Errno2]

main() = 0
