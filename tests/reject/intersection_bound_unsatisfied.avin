// A type argument meets every bound in `A & B`, and the error names the side it misses; a member
// neither bound has names both; two bounds' methods of one signature make the call ambiguous.
// error: `Plain` does not conform to `Sized`, the bound of `T` in `two`
// error: `U` does not conform to `Sized`, the bound of `T` in `two`
// error: `weight` is not a member of `Named & Sized`, the bound of `T`
// error: this call to `label` is ambiguous: `Left.label()`, `Right.label()` each accept it
// error: `Plain` does not conform to `Sized`, the bound of `T` in `Shelf`
trait Named
  name() -> string

trait Sized
  size() -> int

trait Left
  label() -> string

trait Right
  label() -> string

data Plain(n: int)

impl Named for Plain
  name() -> string = "plain"

two[T: Named & Sized](x: T) -> int = x.size()

// Generic code passes its own parameter on only where that parameter's bounds meet the callee's.
outer[U: Named](x: U) -> int = two(x)

missing[T: Named & Sized](x: T) -> int = x.weight()

clash[T: Left & Right](x: T) -> string = x.label()

class Shelf[T: Named & Sized](val item: T)

shelved(s: Shelf[Plain]) -> int = 1

main()
  println(two(Plain(1)))
