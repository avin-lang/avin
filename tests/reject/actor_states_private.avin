// error: `ActorRef` has no member `state`
// error: a `@sendable (int) -> Ev` may use only sendable values from around it, but it uses the state of the actor `Other`, which only the actor's own code reaches; copy what it needs into a `val` first
// An actor's states are its own, though they may share names with a machine's states (`Waiting`):
// its reference has no `state()`, and only the actor reads it, so a sendable function reading the
// actor's fields is refused as for any actor, with no advice to make a field a `val`, which cannot
// make an actor that moves between states sendable.
import avin.threads.Future
import avin.actors.spawn

data Ev
    A

machine Turnstile receives Ev
    state Waiting
        _ -> stay

actor Gate receives Ev
    state Waiting
        _ -> stay
    state Shut
        _ -> stay

actor Other receives Ev
    val base = 1
    state Idle
        _ ->
            pipeToSelf(Future(2), n -> if n > base then A else A)
            stay

main()
    val r = spawn(Other())
    r.state()
