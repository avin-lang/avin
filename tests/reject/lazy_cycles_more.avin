// error: the `lazy val` `named` needs its own value to initialize: `named` → `named`
// error: the `lazy val` `generic` needs its own value to initialize: `generic` → `generic`
// error: the `lazy val` `boxed` needs its own value to initialize: `boxed` → `boxed`
// error: the `lazy val` `defaulted` needs its own value to initialize: `defaulted` → `defaulted`
// error: the `lazy val` `ordered` needs its own value to initialize: `ordered` → `ordered`
// More ways a `lazy val`'s own code reaches its read: an override a call through an `open` class
// may reach, a generic function, a generic class's method, a default argument, a comparison
// operator's method.
open class Base
  name() -> string = "base"

class Derived: Base
  override name() -> string = "derived " + named

make() -> Base = Derived()

lazy val named: string = make().name()

pick[T](x: T) -> int = generic + 1

lazy val generic: int = pick("x")

class Box[T](val item: T)
  size() -> int = boxed + 1

lazy val boxed: int = Box(2.5).size()

withDefault(x: int = defaulted + 1) -> int = x

lazy val defaulted: int = withDefault()

data Grade(points: int)

impl Ord for Grade
  compare(other: Grade) -> int = points + (if ordered then 1 else 0) - other.points

lazy val ordered: bool = Grade(1) < Grade(2)

main() = ()
