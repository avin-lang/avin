// error: `Cell` cannot derive `Describe`: field `v` has type `int | bool`, which does not implement `Describe`: its member `bool` does not
// error: `Kept` cannot derive `Ord`: its field `v` has type `int | string`, which does not implement `Ord`: a union has no order between its members
// error: `Pair` cannot derive `Describe`: field `Two.b` has type `string | bool`, which does not implement `Describe`: its member `bool` does not
// error: `Same` cannot derive `Ordered`: field `v` has type `int | string`, which does not implement `Ordered`: `Ordered` takes `Self` other than as the receiver, and a union conforms only to a trait whose methods take it as the receiver alone
// A derive template needs a union field to meet the hook's bound: every member implementing it, and
// the trait taking `Self` only as the receiver. `derives Ord` names a union field, in a class too.
// A field of a type of several variants is named with its variant.

trait Describe
    describe() -> string

impl Describe for int
    describe() -> string = s"$self"

impl Describe for string
    describe() -> string = self

derive Describe for T
    describe() -> string = T.walk(self, Describer("")).text

data Describer(text: string)

impl ShapeVisitor for Describer
    variant(v: VariantShape) -> Describer = Describer(v.name)

impl Describer
    field[F: Describe](f: FieldShape, value: F) -> Describer = Describer(s"$text ${value.describe()}")

trait Ordered
    before(other: Self) -> bool

impl Ordered for int
    before(other: int) -> bool = self < other

impl Ordered for string
    before(other: string) -> bool = self < other

derive Ordered for T
    before(other: T) -> bool = T.walk(self, Orderer(false)).seen

data Orderer(seen: bool)

impl ShapeVisitor for Orderer
    variant(v: VariantShape) -> Orderer = self

impl Orderer
    field[F: Ordered](f: FieldShape, value: F) -> Orderer = self

data Cell(v: int | bool) derives Describe

class Kept(val v: int | string) derives Eq, Hash, Ord

data Pair derives Describe
    One(a: int | string)
    Two(b: string | bool)

data Same(v: int | string) derives Ordered

main()
    println(1)
