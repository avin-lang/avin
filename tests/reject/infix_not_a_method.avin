// error: `Bag` has no method `missing` to call infix
// error: `Bag` has no method `f` to call infix
// error: `Bag` has no method `twice` to call infix
// error: `int` has no method `plus` to call infix
// An infix call names a method of its receiver's type. A field holding a function and a function
// of two parameters are not called infix.

class Bag(val n: int)
  val f: (int) -> int = (x) -> x + 1

twice(b: Bag, k: int) -> int = k * 2

unknown(b: Bag) -> int = b missing 3

field(b: Bag) -> int = b f 2

function(b: Bag) -> int = b twice 2

plus(a: int, b: int) -> int = a + b

builtin() -> int = 1 plus 2

main() -> int = 0
