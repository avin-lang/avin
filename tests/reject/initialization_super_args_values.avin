// error: `name` is a method of the object, which a superclass's arguments cannot use as a value: they run before the object is initialized
// error: a lambda that captures `self` is made in a superclass's arguments, which run before the object is initialized
// error: an argument passed by name uses `self` in a superclass's arguments, which run before the object is initialized
// error: a lambda that captures `self` is made in a superclass's arguments, which run before the object is initialized
// error: a lambda that captures `self` is made in a superclass's arguments, which run before the object is initialized
open class Base(f: () -> long)
  val got: long = f()

call(g: () -> long) -> long = g()

// A method value made inside a lambda.
class Inner: Base(() -> call(name))
  val s: long = 1
  name() -> long = s

// A lambda that assigns a field rather than reading one.
open class Runs(f: () -> unit)
  f()
  val done: bool = true
class Assigns: Runs(() -> count = 5)
  var count: long = 0

// An argument passed by name that makes a lambda over a field.
pick(flag: bool, v: -> () -> long) -> () -> long = if flag then v else () -> 0
class Picks: Base(pick(true, () -> p))
  val p: long = 2

// A trait's `val` the class supplies, read in a lambda.
trait Sized
  val size: long
class Supplies: Base(() -> size), Sized
  val size: long = 3

// A generic subclass whose field is of its own type parameter.
open class Gen[T](f: () -> T)
  val got: T = f()
class Own[T](seed: T): Gen[T](() -> held)
  val held: T = seed

main()
  println(Inner().got)
  println(Assigns().count)
  println(Picks().got)
  println(Supplies().got)
  println(Own("x").got)
