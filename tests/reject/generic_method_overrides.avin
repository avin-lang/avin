// error: `map` overrides `Mappable.map`, which has 1 type parameter of its own, not 2
// error: `Pair` does not implement `map` from `Mappable`
// error: `tag` overrides `Shelf.tag`, which has 1 type parameter of its own, not 0
// error: `tag` overrides `Shelf.tag`, whose parameter `item` is U, not int
trait Mappable[A]
  map[B](f: (A) -> B) -> Mappable[B]

class Pair[T](value: T): Mappable[T]
  override map[B, C](f: (T) -> B) -> Mappable[B] = Pair(f(value))

open class Shelf
  tag[U](item: U) -> string = "shelf"

class Flat: Shelf
  override tag(item: int) -> string = "flat"

class Bent: Shelf
  override tag[V](item: int) -> string = "bent"

main() = ()
