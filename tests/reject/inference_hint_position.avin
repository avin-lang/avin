// Written type arguments fill a leading prefix, so the hint spells every one up to the unsettled
// parameter, the settled ones by their types. The data types' parameters are invariant, so nothing
// settles them as `Nothing`.
data Outcome[T, E]
    Good(value: T)
    Bad(error: E)

data Cell[T]
    Full(value: T)
    Empty

second[A, B](a: A) -> int = 0

third[A, B, C](a: A, b: B) -> int = 0

main()
