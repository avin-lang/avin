// error: `===` is undefined on Shape and Shape, which may hold values with no identity; compare with `==`, or give one side a class type
// error: `!==` is undefined on Any and Shape, which may hold values with no identity
// error: `===` is undefined on T and T, which may hold values with no identity
// error: `===` is undefined on T and Any, which may hold values with no identity
// error: `===` is undefined on T and T, which may hold values with no identity

// Two sides that may each hold a value type have no defined identity: a boxed or data value may be
// one object or two at the compiler's choice, so `f(Tile(2), Tile(2))` and `f(3, 3)` would answer
// differently for no reason the program can see.

trait Shape
  area() -> int

data Tile(s: int)

impl Shape for Tile
  area() -> int = s * s

traits(a: Shape, b: Shape) -> bool = a === b

anyAndTrait(a: Any, b: Shape) -> bool = a !== b

unbounded[T](a: T, b: T) -> bool = a === b

unboundedAny[T](a: T, b: Any) -> bool = a === b

traitBounded[T: Shape](a: T, b: T) -> bool = a === b

main()
  println(traits(Tile(2), Tile(2)))
