// error: a pattern takes its type arguments from the value it matches; write `Heap.Leaf`
// error: a pattern takes its type arguments from the value it matches; write `Heap.Node`
// error: a pattern takes its type arguments from the value it matches; write `Tree.Branch`
// error: a pattern takes its type arguments from the value it matches; write `Some`
// A variant pattern names no type arguments, on its type or on the variant, with fields or without:
// the value matched decides them. Each is reported naming the pattern without them.

data Heap[T]
    Leaf
    Node(value: T, left: Heap[T], right: Heap[T])

data Tree[T]
    Leaf
    Branch(left: Tree[T], right: Tree[T])

size(h: Heap[int]) -> int = h match
    Heap.Leaf[int] -> 0
    Heap[int].Node(_, l, r) -> 1 + size(l) + size(r)

depth(t: Tree[int]) -> int = t match
    Tree.Branch[int](l, _) -> 1 + depth(l)
    _ -> 1

first(o: Option[int]) -> int = o match
    Some[int](x) -> x
    None -> 0

main() = ()
