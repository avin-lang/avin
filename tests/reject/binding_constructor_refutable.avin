// error: a binding's pattern must match every Option[int] value; take the value apart with `match`
// error: a binding's pattern must match every Shape value; take the value apart with `match`
// error: a binding's pattern must match every Point value; take the value apart with `match`
// error: a binding's pattern must match every Holder value; take the value apart with `match`
// error: a binding's pattern must match every Shape value; take the value apart with `match`
// A binding's constructor pattern must match every value: a variant of a type with several, a
// literal inside a one-variant constructor, a variant nested in a one-variant constructor, and a
// `for` loop's variant pattern can each fail, so they belong in a `match`.

data Point(x: int, y: int)

data Holder(held: Option[int])

data Shape
  Circle(r: int)
  Square(side: int)

main() -> int
  val opt: Option[int] = Some(1)
  val Some(x) = opt
  val Circle(r) = Square(2)
  val Point(0, y) = Point(0, 1)
  val Holder(Some(h)) = Holder(None)
  for Circle(c) in [Circle(1), Square(2)] do println(c)
  0
