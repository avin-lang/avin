// error: `<*>` takes 2 arguments, and only a method of one argument is called infix; write `a.<*>(1, 2)`
// error: `int` has no method `++` to call infix
// error: `int` has no method `=-` to call infix; `=` followed by a prefix `-` needs a space between them
// error: `Bag` has no method `<>` to call infix
class Bag(val items: Vector[int])
    <*>(i: int, j: int) -> Bag = self

main()
    val a = Bag([1])
    val e = a <*> (1, 2)
    val m = 1 ++ 2
    var n = 1
    n=-1
    a <> a
