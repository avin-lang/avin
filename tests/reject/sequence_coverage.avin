// error: this `match` does not cover every Vector[int] value, such as `[_, _, _*]`; add an arm for it, or `_` for the rest
// error: this `match` does not cover every Array[string] value, such as `[]`; add an arm for it, or `_` for the rest
// error: this `match` does not cover every Seq[int] value, such as `[_, _*]`; add an arm for it, or `_` for the rest
// error: this `match` does not cover every Vector[Vector[int]] value, such as `[[_, _*]]`; add an arm for it, or `_` for the rest
// error: this `match` does not cover every Vector[bool] value, such as `[false, _, _*]`; add an arm for it, or `_` for the rest
// A sequence pattern covers its own length, or with a rest every length from its own on; the
// arms of a match on any sequence must together cover every length.

fixedOnly(xs: Vector[int]) -> int = xs match
    [] -> 0
    [x] -> x

noEmpty(xs: Array[string]) -> string = xs match
    [first, _*] -> first

// A guarded arm never counts.
guarded(xs: Seq[int]) -> int = xs match
    [] -> 0
    [x, _*] if x > 0 -> x

nested(xss: Vector[Vector[int]]) -> int = xss match
    [] -> 0
    [[], _*] -> 1

elements(xs: Vector[bool]) -> int = xs match
    [] -> 0
    [_] -> 1
    [true, _*] -> 2

main() = 0
