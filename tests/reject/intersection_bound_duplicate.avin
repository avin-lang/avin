// A bound is written once among a parameter's bounds; two instances of one generic trait at
// different type arguments are two bounds, and the same instance twice is one written again.
// error: `Named` is already a bound of `T`
// error: `Make[int]` is already a bound of `T`
// error: `Named` is already a bound of `U`
trait Named
  name() -> string

trait Make[A]
  static make(a: A) -> Self

twice[T: Named & Named](x: T) -> int = 1

generic[T: Make[int] & Make[long] & Make[int]](x: T) -> int = 1

class Shelf[U: Named & Named](val item: U)

// Distinct instances are distinct bounds.
fine[T: Make[int] & Make[long]](x: T) -> int = 1

main()
  println(1)
