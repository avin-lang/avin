// error: expected an expression
// error: a `do` body needs a `while` test after it
// The keyword `do` on the left of `=` in a `while` body and a `for` body: the `at` after the `=`
// is not reported as an infix call with no argument, quoting `=.at`.

in_while(at: int) -> int
  var i = 0
  while i < 3
    do = at
    i += 1
  i

in_for(at: int) -> int
  for i in [1, 2, 3]
    do = at
  at

main() -> int = 0
