// The shapes of `length(…)` a prototype refuses: one marking `self` or naming it, one written after
// the type, one without its parentheses, one naming a parameter that carries a length itself, and a
// parameter declared with brackets, which is written as the pointer C passes.
// error: and this one is not: `self` is the receiver, which carries no array's length
// error: and this one is not: `length(data)` is written first, before the parameter's type and before `inout`, as in `length(data) size_t n`
// error: and this one is not: `length` names the array parameter whose length the parameter carries, in parentheses, as in `length(data) size_t n`
// error: and this one is not: `n` carries a length itself, so it is no array
// error: and this one is not: a parameter declared with brackets is written as the pointer C passes, as in `int *values`, its length carried by a parameter marked `length(values)`

@c("int f(const int *p, length(p) int self)")
selfLength(p: Array[int]) -> int

@c("int f(const int *p, int length(p) n)")
lengthAfterType(p: Array[int]) -> int

@c("int f(const int *p, length p int n)")
lengthUnparenthesized(p: Array[int]) -> int

@c("int f(const int *p, length(p) int n, length(n) int m)")
lengthOfLength(p: Array[int]) -> int

@c("int sum(int values[4])")
bracketed(values: Array[int]) -> int

main() = 0
