// error: `return` cannot leave a delayed argument, which is evaluated where its parameter is read
// error: expected LazyList[string], found LazyList[int]; they have no common superclass and share the unrelated traits Display and Debug, so write the type wanted
// error: `int` has no method `#::` to call infix
// error: `Both` has a method `#::` and its companion `Both` declares `#::` too, so `x #:: Both` could call either: rename one of them
// error: `int` has no method `+:` to call infix
class Both(val n: int)
  #::(x: int) -> Both = Both(x)

object Both
  #::(x: int, rest: -> Both) -> Both = rest

early(xs: LazyList[int]) -> LazyList[int] = 1 #:: (return xs)

main() =
  val a = "a" #:: LazyList.empty[int]()
  val b = 1 #:: 5
  val c = 1 #:: Both(2)
  val e = 1 +: 2 #:: LazyList.empty[int]()
