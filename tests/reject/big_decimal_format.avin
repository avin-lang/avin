// error: format `%d` expects an integer, but the value has type `BigDecimal`
// error: format `%s` expects a string or another value that is not a number, but the value has type `BigDecimal`
// error: format `%e` expects a real, but the value has type `BigDecimal`
// error: format `%x` expects an integer, but the value has type `BigDecimal`
// error: the flag `,`, which groups decimal digits, has no effect
// A `BigDecimal` takes `%f`, with the flags a `real` does, and none of the other number conversions:
// it is never written with an exponent, and it is a number, which `%s` refuses.
main()
  val d: BigDecimal = 1.5
  println(f"$d%d")
  println(f"$d%s")
  println(f"$d%e")
  println(f"$d%x")
  println(f"$d%,f")
