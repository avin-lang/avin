// error: `Plain` does not conform to `Display`, the bound of `T` in `println`
// error: `Shown` does not conform to `Debug`, the bound of `T` in `debug`
// error: `T` does not implement `Display`, so it cannot be interpolated
// error: expected Display, found Plain
class Plain(val n: int)

class Shown(n: int): Display
    override display(out: Writer, spec: FormatSpec) = out.write("shown")

unbounded[T](x: T) -> string = s"$x"

main()
    val p = Plain(1)
    println(s"plain $p")
    println(p)
    println(debug(Shown(2)))
    println(unbounded(1))
    val d: Display = Plain(3)
