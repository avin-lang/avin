// error: `Plain` does not implement `Display`, so it cannot be interpolated
// error: `Plain` does not conform to `Display`, the bound of `T` in `print`
// error: `Shown` does not conform to `Debug`, the bound of `T` in `debug`
// error: `T` does not implement `Display`, so it cannot be interpolated
// error: expected Display, found int
class Plain(val n: int)

data Shown(n: int)

impl Display for Shown
    display(out: Writer, spec: FormatSpec) = out.write("shown")

unbounded[T](x: T) -> string = s"$x"

main()
    val p = Plain(1)
    print(s"plain $p")
    print(p)
    print(debug(Shown(2)))
    print(unbounded(1))
    val d: Display = 3
