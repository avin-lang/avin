// error: `===` cannot compare Plain with Dog
// error: `===` cannot compare Plain with Shape
// error: `===` cannot compare (int) -> int with Plain
// error: `===` cannot compare Plain with Tile
// error: `!==` cannot compare Plain with string

// With a class on one side, the other must be a value that may be the same object: a sub- or
// superclass, a trait the class conforms to, an `Any` or a type parameter. An unrelated class, a
// trait the class does not conform to, a function, a data value or a string never is.

trait Shape
    area() -> int

open class Animal(val name: string)

class Dog(name: string): Animal(name)

class Plain(v: int)

data Tile(s: int)

classes(a: Plain, b: Dog) -> bool = a === b

foreignTrait(a: Plain, b: Shape) -> bool = a === b

functionAndClass(f: int -> int, b: Plain) -> bool = f === b

classAndData(a: Plain, b: Tile) -> bool = a === b

classAndString(a: Plain, b: string) -> bool = a !== b

main()
    println(classes(Plain(1), Dog("rex")))
