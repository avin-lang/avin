// error: the variant `A` is declared more than once
// error: the variant `B` is declared more than once
// error: the variant `C` is declared more than once
// A data type whose only variant is declared twice gets that one error and no error about
// deriving `Display` or `Debug`, with fields or without, and with explicit `derives`.
data Plain
  A
  A

data Fields
  B(x: int)
  B(x: int)

data Derived derives Display, Debug
  C(x: int)
  C(x: int)

main() -> int = 0
