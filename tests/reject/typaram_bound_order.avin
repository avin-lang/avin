// error: `B` is declared after `A`; a type parameter bounding another is declared before it, as in `[B, A: B]`
// error: the bound of `A` leads back to `A`
// error: unknown type `Q`
// error: a type parameter bounds a function's or a method's own type parameter, not `B`
// error: `C` has one type parameter among its bounds, and `B` is a second
// A type parameter bounding another is declared before it, so a chain of them never leads back:
// `[A: B, B: A]` is refused at its first bound. Only a function's or a method's own parameters are
// bounded by one, and by one at most.
later[A: B, B](a: A) -> unit = ()
itself[A: A](a: A) -> unit = ()
unknown[A: Q](a: A) -> unit = ()
class Holder[A, B: A](val b: B)
two[A, B, C: A & B](c: C) -> unit = ()

main() = ()
