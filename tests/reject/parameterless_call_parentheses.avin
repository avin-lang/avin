// A method declared with no parameter list is called by its name alone: parentheses after it call
// what it yields, which is refused where that is not a function, or a sequence given an index. The
// same holds inside the class, by bare name, and through `super`.
// error: `head` takes no parameter list, so it is called without parentheses: write `head`, not `head()`
// error: `items` takes no parameter list, so it is called without parentheses: write `items`, not `items()`
// error: `size` takes no parameter list, so it is called without parentheses: write `size`, not `size()`

open class Base(n: int)
    size -> int = n

class Derived(n: int) : Base(n)
    override size -> int = super.size + 1

class Chain(x: int)
    head -> int = x
    items -> Vector[int] = [x]
    second -> int = head + 1

main() =
    val c = Chain(1)
    println(c.head)
    println(c.head(3))
    println(c.items)
