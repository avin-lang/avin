// error: a `@sendable (int) -> int` may use only sendable values from around it, but it carries its receiver, a `Counter`, whose field `n` is a `var`; make it a `val`
// error: what is passed for `f` of `take` may use only sendable values from around it, but it carries its receiver, a `Counter`, whose field `n` is a `var`; make it a `val`
// error: a `@sendable (int) -> int` may use only sendable values from around it, but it carries its receiver, a `Counter`, whose field `n` is a `var`; make it a `val`
// error: what is passed for `f` of `take` may use only sendable values from around it, but it carries its receiver, a `Holder[int]`, whose field `items` holds a `Buffer[int]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: what is passed for `f` of `take` may run on another thread, which shares the program's module-level state, but through `Hitter.hit` it reaches `hits`, a module-level `var`, which every thread would share; share it through an `Atomic` or a `Mutex` held in a `val`
// A method value made sendable is held to its receiver's value, whatever the receiver expression
// uses: a receiver built on the spot that is not sendable is refused even where the expression uses
// nothing from around it, as an argument for a `@sendable` parameter, a `val` of a `@sendable` type,
// a function's result and a generic receiver; and a sendable receiver whose method reaches
// module-level state is still refused, since the method runs on the other thread.
class Counter()
  var n = 0
  bump(x: int) -> int = x + n

class Holder[T](val items: Buffer[T])
  size(x: int) -> int = items.length + x

var hits = 0

// A sendable receiver whose method reaches module-level state.
class Hitter(val n: int): Sendable
  hit(x: int) -> int
    hits += 1
    x + n

take(@sendable f: (int) -> int) -> int = f(1)

made() -> @sendable (int) -> int = Counter().bump

main()
  println(take(Counter().bump))
  val f: @sendable (int) -> int = Counter().bump
  println(take(Holder[int](Buffer[int]()).size))
  println(f(1), made()(1))
  println(take(Hitter(1).hit))
