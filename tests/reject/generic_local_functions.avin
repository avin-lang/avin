// error: cannot infer `T` for `pair` used as a value; write it, as in `pair[int]`
// error: `pair` takes 1 type argument, not 2
// error: `with` takes 1 type argument, not 2
// error: `T` is already a type parameter where `again` is declared; name this one differently
// error: `int` does not conform to `Named`, the bound of `T` in `describe`
trait Named
    name() -> string

// A generic local used as a value where nothing fixes its type argument, and too many written.
values()
    pair[T](x: T) -> (T, T) = (x, x)
    val f = pair
    print(pair[int, string](1))

// The enclosing function's type parameters are not written at a call: `with` takes one. A local's
// type parameter may not reuse a name already in scope.
outer[T: Display](seed: T)
    with[U: Display](u: U) -> (T, U) = (seed, u)
    print(with[int, int](1))
    again[T](x: T) -> T = x

bounded()
    describe[T: Named](x: T) -> string = x.name()
    print(describe(5))

main()
    values()
    outer(1)
    bounded()
