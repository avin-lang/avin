// error: a receive arm's pattern is `Some(p)` for a value, `None` for the channel closed and drained, or a name for either
// error: a receive arm's pattern is `Some(p)` for a value, `None` for the channel closed and drained, or a name for either
// error: a receive arm's pattern is `Some(p)` for a value, `None` for the channel closed and drained, or a name for either
// error: a receive arm's pattern is `Some(p)` for a value, `None` for the channel closed and drained, or a name for either
// error: a send arm binds nothing, so it has no `as` pattern
// A receive arm's pattern is `Some(p)`, `None` or a name; a literal, a tuple, alternatives and a
// type pattern are not, and a send arm binds nothing, so it has no pattern.
import avin.threads.Channel

main()
  val c = Channel[int]()
  select
    c.receive() as 3 -> ()
    c.receive() as (a, b) -> ()
    c.receive() as Some(x) | None -> ()
    c.receive() as o: Option[int] -> ()
    c.send(1) as x -> ()
