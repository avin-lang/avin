// An integer parameter is passed as the type it is declared, which Sysl accepts only where its own
// parameter's type holds every value of it: a `long` does not reach an `i32`.
// error: the Sysl binding `wide` does not match `sysl.time.days_in_month`: 'y' of 'sysl.time.days_in_month' is int, but long was given
@sysl("sysl.time.days_in_month")
wide(year: long, month: int) -> int

main() = 0
