// error: `cyclic` yields T, not Vector[T]
// error: this arm is never reached: `Wrap` needs `T` to be `Vector[T]`, which no type is
// error: `+` needs two values of one type, not T and int
// error: `Refl` is a `Same[int, int]`, and a `Same[int, string]` is expected here
// error: the type of the value matched must be known to match `IntLit`, which fixes the type's argument; write the type where the value is declared
// What an arm cannot learn it does not assume. An arm whose equalities contradict, a cyclic
// `T = Vector[T]`, is an error, and its body is checked with no equalities. The `else` branch of an
// `is` test knows nothing of its pattern. A `Same[int, string]` is never made, so `cast` never turns
// an `int` into a `string`. A value whose type is not known is not matched against a variant that
// fixes it.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  BoolLit(value: bool) -> Expr[bool]

data Twice[A, B]
  Wrap -> Twice[A, Vector[A]]

data Same[A, B]
  Refl -> Same[A, A]

cast[A, B](proof: Same[A, B], x: A) -> B
cast(Refl, x) = x

cyclic[T](t: Twice[T, T], x: T) -> Vector[T] = t match
  Wrap -> x

otherBranch[T](e: Expr[T], x: T) -> T = if e is IntLit(n) then x + n else x + 1

main()
  val p: Same[int, string] = Refl
  val s: string = cast(p, 1)
  val unknown = None
  unknown match
    Some(IntLit(n)) -> println(n)
    _ -> ()
