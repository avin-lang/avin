// error: `bump` is reached through two exports of `Two`, `export a.*` and `export b.*`; export it by name from the one meant, as in `export a.bump`
// error: `count` is exported privately by `Secretive`, so only its own code uses it
// error: `bump` is not defined
// error: `count` is exported by `Base`, which `Sub` extends, with `export c.count`; name this member something else
// error: (int) -> Counter has no field `count`
// Two wildcards reaching one name leave a use of it to be settled; a private export is the type's
// own; inside the type a bare name is not an export; a subclass does not hide its superclass's
// export; and an export is reached through a value, not through a type.
class Counter(var count: int)
  bump() = count += 1

class Two(a: Counter, b: Counter)
  export a.*
  export b.*

class Secretive(c: Counter)
  private export c.count
  report() -> int = self.count

class Bare(c: Counter)
  export c.bump
  go() = bump()

open class Base(c: Counter)
  export c.count

class Sub(c2: Counter): Base(c2)
  count -> int = 3

object Holder
  val store: Counter = Counter(0)
  export store.{bump, count}

main()
  Two(Counter(1), Counter(2)).bump()
  println(Secretive(Counter(1)).report())
  println(Secretive(Counter(1)).count)
  println(Counter.count)
