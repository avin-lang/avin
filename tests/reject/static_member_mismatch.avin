// error: `zero` is a static member of `Add`, so its implementation is `static` too
// error: `add` is a method of `Add`'s values, so its implementation is not `static`
// error: `one` is a static member of `Mul`, so its implementation is `static` too
// An implementation of a trait's member is static exactly where the member is, in an impl and in a
// class's body.

data Wrong(n: int)

impl Add for Wrong
  add(other: Wrong) -> Wrong = other
  zero() -> Wrong = Wrong(0)

data Flipped(n: int)

impl Add for Flipped
  static add(other: Flipped) -> Flipped = other
  static zero() -> Flipped = Flipped(0)

class Scale(val k: int): Mul
  override multiply(other: Scale) -> Scale = Scale(k * other.k)
  override one() -> Scale = Scale(1)

main() = ()
