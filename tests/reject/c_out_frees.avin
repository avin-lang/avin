// `free:` frees a string C answers through an `out` pointer with an entry `name: how`: the name an
// `out` parameter answering a string or its bytes, freed once, by a C function of it or a C
// expression in its name, and never beside arrays `array:` frees by position.
// error: `free:` frees the string C answers through the `out` parameter `missing`, and the prototype has no `out` parameter `missing`
// error: `free:` frees the string C answers through `n`, and it is `int`, not a string or its bytes
// error: `free:` frees `s` with a C function of it or a C expression in `s`, and `release(other)` is neither
// error: `free:` frees `s` twice
// error: `free:` frees the arrays `array:` names by position, so it frees no out string besides

@c("int get(out char **s, out int *n)", free: "missing: free")
missing() -> Result[(string, int), int]

@c("int get(out char **s, out int *n)", free: "n: free")
notString() -> Result[(string, int), int]

@c("int get(out char **s, out int *n)", free: "s: release(other)")
notInName() -> Result[(string, int), int]

@c("int get(out char **s, out int *n)", free: ["s: free", "s: release(s)"])
twice() -> Result[(string, int), int]

@c("int get(out char **s, out double **xs, out int *n)", array: "xs", length: "n", free: ["s: free", "free"])
besideArrays() -> Result[(string, Array[real], int), int]

main() = 0
