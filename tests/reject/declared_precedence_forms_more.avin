// error: `++=` is an assignment, and binds as `=` does: only a method named by a symbol the language does not use declares `@precedence` or `@groupsRight`
// error: `@precedence` is written twice on one method
// error: `@groupsRight` takes no arguments
// error: `@precedence` declares how the calls of a method named by a symbol bind, so it goes on a method of a class, trait, object or impl; a function is called by its name
// error: `@precedence` takes one string, an operator of the language whose level the method's calls bind at
// An assignment through a method keeps `=`'s level; each annotation is written once; `@groupsRight`
// takes nothing; a function is not called infix; the level is a string written alone.
class T(val n: int)
  @precedence("|")
  ++=(o: T) = ()
  @precedence("|")
  @precedence("&")
  <|>(o: T) -> T = o
  @groupsRight("left")
  ^^(o: T) -> T = o
  @precedence(level: "|")
  |>(o: T) -> T = o

@precedence("|")
pipe(a: int, b: int) -> int = a + b

main() = ()
