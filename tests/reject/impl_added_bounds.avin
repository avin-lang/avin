// error: `int.wrap` implements `Wrapper.wrap`, whose type parameter `T` is not bounded by Ord
// error: `Box.wrap` implements `Wrapper.wrap`, whose type parameter `T` is not bounded by Display
// error: `Base.pick` implements `Picker.pick` for `Heir`, whose type parameter `B` is not bounded by Animal
// error: `keep` overrides `Keeper.keep`, whose type parameter `T` is not bounded by Display
// error: `pair` overrides `Pairer.pair`, whose type parameter `B` is not bounded by Ord
// An implementation in an impl, for a built-in type or a data type, adds no bound to a type
// parameter of its own; nor does a superclass's method that fills a trait's, a trait that redeclares
// a required trait's method, or an override bounding its second type parameter. A class is a bound
// as a trait is.
open class Animal

trait Wrapper
    wrap[T](x: T) -> string

impl Wrapper for int
    wrap[T: Ord](x: T) -> string = "int"

data Box(n: int)

impl Wrapper for Box
    wrap[T: Display](x: T) -> string = s"$x"

trait Picker
    pick[A, B](a: A, b: B) -> int

open class Base
    pick[A, B: Animal](a: A, b: B) -> int = 1

class Heir: Base, Picker

trait Keeper
    keep[T](x: T) -> string = "kept"

trait Shown: Keeper
    override keep[T: Display](x: T) -> string = s"$x"

open class Pairer
    pair[A, B](a: A, b: B) -> int = 0

class Strict: Pairer
    override pair[A, B: Ord](a: A, b: B) -> int = 1

main() -> int = 0
