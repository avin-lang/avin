// error: this pattern is string, but the value it matches is int
// error: expected int, found string
// error: expected PartialFunction[int, int], found PartialFunction[string, int]
// A partial function's arms need not cover every value, but their patterns are held to its parameter
// type and their values agree on one type.

main()
  val wrongPattern: PartialFunction[int, int] = match
    "one" -> 1
  val disagree: PartialFunction[int, int] = match
    1 -> 1
    2 -> "two"
  val text: PartialFunction[string, int] = match "one" -> 1
  val numbers: PartialFunction[int, int] = text
