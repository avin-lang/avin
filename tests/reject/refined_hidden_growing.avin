// error: polymorphic recursion: each round of the cycle `Hold` -> `Hold` passes `Vector[A]` for `A`, so its type arguments grow without end and the code has no finite set of copies
// error: polymorphic recursion: each round of the cycle `pairUp` -> `pairUp` passes `(T, A)` for `T`, so its type arguments grow without end and the code has no finite set of copies
// error: polymorphic recursion: each round of the cycle `Keep` -> `deeper` -> `Keep` passes `(A, A)` for `T`, so its type arguments grow without end and the code has no finite set of copies
// A cycle that makes packs from ever larger hidden types is polymorphic recursion, reported naming
// the variant whose hidden type grows: an arm making a value of its own variant at a larger hidden
// type, and a generic function making a pack of its parameter whose arm calls it at a larger one. A
// type parameter grown beside a hidden type, where the value matched does not hold the parameter,
// grows as ever. Recursion that only reads the packs of the values it is given is ordinary.
data Box
  Hold[A](value: A)
  Empty

grow(b: Box, n: int) -> int = b match
  Hold(v) -> if n == 0 then 0 else grow(Hold([v]), n - 1)
  Empty -> 0

pairUp[T](x: T, b: Box, n: int) -> int = b match
  Hold(y) -> if n == 0 then 0 else pairUp((x, y), b, n - 1)
  Empty -> 0

data Cell
  Keep[A](value: A)

deeper[T](x: T, n: int) -> int = Keep(x) match
  Keep(y) -> if n == 0 then 0 else deeper((y, y), n - 1)

data Chain
  Link[A](value: A, next: Chain)
  End

// A chain's values carry their packs, which recursion through the chain only reads: no growth.
size(c: Chain) -> int = c match
  Link(_, next) -> 1 + size(next)
  End -> 0

main()
  println(grow(Hold(1), 3) + pairUp(1, Hold(2), 3) + deeper(1, 3) + size(Link(1, Link("a", End))))
