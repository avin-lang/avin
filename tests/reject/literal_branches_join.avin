// error: integer literal does not fit in i8
// error: integer literal does not fit in i8
// error: integer literal does not fit in int
// error: this arm yields string, but the arms before it yield int
// error: the branches of this `if` yield int and string

// A literal branch or arm takes the type the others decide, so one that does not fit it is an
// error; literals alone take the first one's type, an `int`; and branches and arms with no common
// type are reported in the order they are written.

main(args: Vector[string])
    val c = args.size() > 0
    val a = if c then 300 else i8(1)
    val b = args.size() match
        0 -> 300
        _ -> i8(1)
    val d = [1, 5000000000]
    val e = args.size() match
        0 -> 1
        _ -> "x"
    val g = if c then 1 else "x"
