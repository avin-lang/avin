// error: `Wrong.unapply` implements `Extractor.unapply`, which yields Option[int], not int
// error: `Missing` does not implement `unapply` from `BoolExtractor`; implement it
// error: `e` implements `Extractor[string, int]`, which takes no int, the value matched here
// error: `Holder` is not a variant or an extractor
// The traits hold their implementations to their signatures, a trait's value takes only what its
// `A` takes, and a class's name, which is no value, is no extractor.
object Wrong: Extractor[int, int]
  override unapply(n: int) -> int = n

object Missing: BoolExtractor[int]
  other(n: int) -> bool = true

class Holder(val n: int)

narrow(e: Extractor[string, int], n: int) -> int = n match
  e(x) -> x
  _ -> 0

four(h: Holder) -> int = h match
  Holder(n) -> n
  _ -> 0

main() = ()
