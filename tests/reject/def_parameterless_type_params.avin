// A function declared with `def` and no parameter list takes no type parameters of its own, at the
// top level and in a block, since `name[T]` would read as indexing its result.
// error: `first` has no parameter list, so it takes no type parameters
// error: `local` has no parameter list, so it takes no type parameters

def first[T] -> int = 1

main() =
    def local[T] -> int = 2
    println(local)
