// error: `Array` is invariant in its parameter `T`, and `F[+_]` takes only a constructor covariant there
// error: `G` is invariant at that argument, as `G[_]` is declared, and `F[+_]` takes only a constructor covariant there
// error: the contravariant type parameter `-A` appears in a covariant position, the field `x`
// error: the covariant type parameter `+A` appears in a contravariant position, the field `x`
// error: `Map[_, int]` is invariant in its parameter `K`, and `F[+_]` takes only a constructor covariant there
// The demand is checked for a written constructor, a partial application and a constructor
// parameter inferred from another's application alike; inside a type, `F[A]` puts `A` where the
// hole does, so `-A` is refused under `+_` and `+A` under `-_`.
open class Animal(val name: string)

class Dog(name: string): Animal(name)

widen[F[+_]](d: F[Dog]) -> F[Animal] = d

relay[G[_]](d: G[Dog]) -> G[Animal] = widen(d)

class Out[-A, F[+_]](val x: F[A])

class In[+A, F[-_]](val x: F[A])

main()
  val a: Array[Dog] = Array.fill(1, Dog("x"))
  println(widen[Array](a))
  val m: Map[Dog, int] = {Dog("d"): 1}
  println(widen[Map[_, int]](m))
