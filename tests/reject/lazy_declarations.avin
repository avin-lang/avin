// error: a `lazy` value is computed once and never assigned, so it is declared `lazy val`
// error: a parameter is given by its caller, so it cannot be `lazy`
// error: a data field is given when the value is made, so it cannot be `lazy`
// error: a class parameter is given when the object is made, so it cannot be `lazy`
// `lazy` makes a module-level value or a class body's field computed on its first read. A `lazy var`
// is not one, and a parameter, a data field and a class parameter are each given their value where
// they are made, so none can be lazy.
lazy var counter = 0

twice(lazy x: int) -> int = x + x

data Pair(lazy first: int, second: int)

class Box(lazy val content: int)

main() -> int = twice(counter)
