// error: this `match` does not cover every Weight value, such as `Bold`; add an arm for it, or `_` for the rest
// error: this arm is never reached: the arm `Normal` on line 23 already matches every value it would
// error: this `match` does not cover every Stretch value, such as `Normal`; add an arm for it, or `_` for the rest
// A match is checked for coverage over the matched type's own variants: a bare shared name is that
// type's variant, so it covers it, and the same variant written in full after it is never reached,
// and no other type's; an arm missing it names it.
data Slant
    Normal
    Italic

data Weight
    Bold
    Normal

data Stretch
    Normal
    Wide

heavy(w: Weight) -> bool = w match
    Normal -> false

upright(s: Slant) -> bool = s match
    Normal -> true
    Slant.Normal -> false
    Italic -> false

wide(s: Stretch) -> bool = s match
    Wide -> true

main() = ()
