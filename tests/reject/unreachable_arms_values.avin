// error: this arm is never reached: the arm `0..<10` on line 9 already matches every value it would
// error: this arm is never reached: the arm `n >= 0` on line 15 already matches every value it would
// error: this arm is never reached: the arms before it already match every value it would
// error: this arm is never reached: the arm `"yes"` on line 25 already matches every value it would
// error: this arm is never reached: the arms before it already match every value it would
// Arms covered by earlier arms over ordered values (int, long, char, byte), and strings, and by several earlier
// arms together, when no single one covers them.
digit(n: int) -> int = n match
  0 ..< 10 -> 1
  7 -> 2
  _ -> 0

sign(n: long) -> int = n match
  n < 0 -> -1
  n >= 0 -> 1
  0 -> 0

letter(c: char) -> int = c match
  'a' .. 'z' -> 1
  'A' .. 'Z' -> 2
  'q' | 'Q' -> 3
  _ -> 0

word(s: string) -> int = s match
  "yes" -> 1
  "no" -> 0
  "yes" -> 2
  _ -> -1

octet(b: byte) -> int = b match
  0x00 .. 0x7f -> 0
  x >= 128 -> 1
  _ -> 2

main() = ()
