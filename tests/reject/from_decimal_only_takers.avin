// error: expected BigInt, found real
// error: `+` needs two values of one type, not Count and BigInt
// error: `*` needs two values of one type, not BigInt and Count
// error: expected int, found real
// error: `+=` needs two numbers of one type, not int and BigDecimal
// Only a type implementing `FromDecimal` takes decimals: a decimal literal is no `BigInt` or `int`, a
// `BigInt` converts to no type that takes integers alone, and an integer target keeps its type.
data Count(n: long)

impl FromInteger for Count
  static fromInteger[N: Integer](n: N) -> Count = Count(long(n))

impl Add for Count
  add(other: Count) -> Count = Count(n + other.n)
  static zero() -> Count = Count(0)

impl Mul for Count
  multiply(other: Count) -> Count = Count(n * other.n)
  static one() -> Count = Count(1)

main()
  val b: BigInt = 1.5
  val big = BigInt(2)
  val c: Count = 3
  println(c + big)
  println(big * c)
  val i: int = 2.5
  var j: int = 1
  j += BigDecimal(2)
