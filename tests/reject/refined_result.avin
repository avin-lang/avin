// error: the result of a variant is an instance of its own type: `IntLit` of `Expr` declares `Option[int]`
// error: the result of a variant is an instance of its own type: `Count` of `Expr` declares `int`
// error: `A` is inside a union in the result of `Named`, so a value of the type does not say what `A` is
// error: `A` is inside a union in the result of `Deep`, so a value of the type does not say what `A` is
// error: `T` is inside a union in the result of `Own`, so a value of the type does not say what `T` is
// A refined variant's result is an instance of its own type, and a union in it names none of the
// variant's parameters, however deep it sits; a closed union, a function type, a tuple and a nested
// generic type are results a value can be read back from.

data Expr[T]
  IntLit(value: int) -> Option[int]
  Count(value: int) -> int
  Wide(value: int) -> Expr[int | string]
  Named[A](value: A) -> Expr[A | string]
  Deep[A](value: A) -> Expr[Vector[(int, A | bool)]]
  Own(value: T) -> Expr[T | unit]
  Fn[A, B](f: (A) -> B) -> Expr[(A) -> B]
  Lazy[A](f: (-> A) -> A) -> Expr[(-> A) -> A]
  Nest[A](v: Vector[A]) -> Expr[Option[Vector[A]]]

main() = ()
