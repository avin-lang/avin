// error: `int` is named twice in this union
// error: a `Dog` is already an `Animal`, so `Dog | Animal` is `Animal`; write `Animal`
// error: every member converts to `Any`, so this union is `Any`; write `Any`
// error: `Nothing` adds no value to a union; write `int`
// error: an `int` is already a `Display`, so `int | string | Display` is `Display`; write `Display`
// A member written by hand that another member absorbs is a mistake, reported with the type to write.

open class Animal

class Dog: Animal

main()
  val a: int | int = 1
  val b: Dog | Animal = Dog()
  val c: string | Any = "x"
  val d: int | Nothing = 1
  val e: int | string | Display = 1
