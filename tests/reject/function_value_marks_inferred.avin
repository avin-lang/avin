// error: a `@sendable () -> unit` may use only sendable values from around it, but it uses `buf`, a `Buffer[string]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: a `@sendable () -> unit` may use only sendable values from around it, but it uses `buf`, a `Buffer[string]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: a `@sendable () -> unit` may use only sendable values from around it, but it uses `buf`, a `Buffer[string]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: a `@sendable () -> int` may use only sendable values from around it, but it uses `buf`, a `Buffer[string]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: a `@sendable () -> int` may use only sendable values from around it, but it uses `buf`, a `Buffer[string]`, which is mutable; an immutable copy (`toVector`) is sendable
// With no function type expected, a function value of a marked function takes the `@sendable` form of
// each marked function parameter, so a closure passed through it is checked where it is written:
// through `spawn` held in a `val`, through a generic function that hands it back, through a method
// value, through a function-typed data type whose type is `@sendable`, and through a local function
// whose parameter is `@isolated`.
import avin.threads.{spawn, Thread}

hold[F](f: F) -> F = f

class Away
  run(@sendable f: () -> unit) -> unit = spawn(f).join()

data Twice(k: int)

impl (@sendable () -> int) -> int for Twice
  apply(@sendable f: () -> int) -> int = spawn(f).join() * k

main()
  val buf = Buffer[string]()
  val sp = spawn[unit]
  sp(() -> buf.append("x"), 65536).join()
  val held = hold(spawn[unit])
  held(() -> buf.append("y"), 65536).join()
  val r = Away().run
  r(() -> buf.append("z"))
  val tw: (@sendable () -> int) -> int = Twice(2)
  println(tw(() -> buf.length))
  run(@isolated f: () -> int) -> int = f()
  val lr = run
  println(lr(() -> buf.length))
