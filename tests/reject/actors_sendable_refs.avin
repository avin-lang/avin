// error: `Any` does not conform to `Sendable`, the bound of `M` in `Behaviour`: it may hold a value of any type
// error: `Job` does not conform to `Sendable`, the bound of `M` in `ActorRef`: its field `fill` holds a `Buffer[byte]`, which is mutable
// error: `Shape` does not conform to `Sendable`, the bound of `M` in `ActorRef`: it is `open`, so a subclass could add a `var`
// error: `Box[Array[int]]` does not conform to `Sendable`, the bound of `M` in `ActorRef`: its field `item` holds an `Array[int]`, which is mutable
// A message type must be sendable wherever it is named: `Any`, a data type holding a mutable field,
// an `open` class, and a generic data type at a mutable argument.
import avin.actors.{ActorRef, Behaviour, spawn}

data Job(fill: Buffer[byte])

open class Shape(val sides: int)

data Box[T](item: T)

anything() -> Behaviour[Any] = Behaviour("Anything", me -> a -> ())

jobs(r: ActorRef[Job]) = ()

shapes(r: ActorRef[Shape]) = ()

boxes(r: ActorRef[Box[Array[int]]]) = ()

main() = ()
