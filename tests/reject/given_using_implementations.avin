// A trait's method with a `using` section is implemented with the same section: a call through the
// trait fills it. An implementation without the section, or with one the trait's method lacks, does
// not implement the method, and is reported naming the parameter.
// error: `Plain` does not implement `put` from `Store`
// error: `put` overrides `Store.put`, whose parameter `tx` is contextual, after `using`
// error: `Plain` does not implement `get` from `Store`
// error: `get` overrides `Store.get`, whose parameter `tx` is not contextual

data Tx(id: int)

trait Store
  put(key: string, using tx: Tx) -> int
  get(key: string, tx: Tx) -> int

class Plain: Store
  override put(key: string, tx: Tx) -> int = 0
  override get(key: string, using tx: Tx) -> int = 0

main() = 0
