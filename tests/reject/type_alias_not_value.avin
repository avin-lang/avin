data Point(x: int, y: int)

data Shape
    Dot
    Line(length: int)

class Box[T](v: T)

type P = Point
type B = Box[int]
type Count = int
type S = Shape

impl P
    norm() -> int = x + y

main()
    val p = P(1, 2)
    val b = B(3)
    val n = Count(4)
    val s: S = Dot
    val m = s match
        S(_) -> 1
        _ -> 2
