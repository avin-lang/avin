// An array crosses as an `Array[byte]`, `Array[int]`, `Array[long]` or `Array[real]`, or an `Option`
// of one, to a pointer whose length another parameter carries; a pointer to `char` takes bytes. An
// array of any other element, an array whose length nothing carries, and a parameter some length
// names that is no array are refused.
// error: parameter 1 of the C binding `bools` is `Array[bool]` in Avin and `const int *` in C: an array crosses to C as `Array[byte]`, `Array[int]`, `Array[long]` or `Array[real]`, whose elements C reads as they are
// error: parameter 1 of the C binding `strings` is `Option[Array[string]]` in Avin and `const int *` in C: an array crosses to C as `Array[byte]`, `Array[int]`, `Array[long]` or `Array[real]`, whose elements C reads as they are
// error: parameter 1 of the C binding `unbounded` is `Array[int]` in Avin and `const int *` in C: C could read past the end of an array whose length nothing carries: mark the integer parameter that carries it `length(p)`
// error: parameter 1 of the C binding `notAnArray` is `int` in Avin and `const int *` in C: `p` is an array, its length carried by the parameter marked `length(p)`, so it crosses as an `Array` or an `Option` of one
// error: parameter 1 of the C binding `wideChars` is `Array[int]` in Avin and `char *` in C: a pointer to `char` takes an `Array[byte]`

@c("int f(const int *p, length(p) int n)")
bools(p: Array[bool]) -> int

@c("int f(const int *p, length(p) int n)")
strings(p: Option[Array[string]]) -> int

@c("int f(const int *p, int n)")
unbounded(p: Array[int], n: int) -> int

@c("int f(const int *p, length(p) int n)")
notAnArray(p: int) -> int

@c("int f(char *p, length(p) int n)")
wideChars(p: Array[int]) -> int

main() = 0
