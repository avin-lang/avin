// error: `Expr` has refined variants: they are declared and checked, but no value of the type can be made, matched or named yet
// error: `Expr` has refined variants: they are declared and checked, but no value of the type can be made, matched or named yet
// error: `Lit` is a variant of `Expr`, which has refined variants: they are declared and checked, but no value of the type can be made, matched or named yet
// error: `IntLit` is a variant of `Expr`, which has refined variants: they are declared and checked, but no value of the type can be made, matched or named yet
// error: `Lit` is a variant of `Expr`, which has refined variants: they are declared and checked, but no value of the type can be made, matched or named yet
// A type with a refined variant is declared and checked, and refused wherever a program would make,
// match or name a value of it, its plain variants included: in a type alias, a field of another
// type, a call of a variant and a pattern.

data Expr[T]
  Lit(value: T)
  IntLit(value: int) -> Expr[int]

type IntExpr = Expr[int]

data Holder(e: Expr[int])

g(x: Any) -> int = x match
  Lit(_) -> 1
  _ -> 0

main()
  println(Lit(3))
  println(IntLit(4))
  println(g(1))
