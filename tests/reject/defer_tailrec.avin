// error: this recursive call of `sum` is not in tail position: a deferred statement runs after it
// error: this recursive call of `find` is not in tail position: a deferred statement runs after it
// A deferred statement waiting to run takes every call after it out of tail position, the value of a
// `return` included, so `@tailrec` refuses a self-call there. One whose block has already been left
// (in `steps`, the inner block's) does not.

@tailrec
sum(n: int, acc: int) -> int
  defer println(acc)
  if n == 0 then return acc
  sum(n - 1, acc + n)

@tailrec
find(xs: Vector[int], i: int) -> int
  if i == xs.length then return -1
  if xs(i) == 0
    defer println(i)
    return find(xs, i + 1)
  i

@tailrec
steps(n: int) -> int
  if n == 0 then return 0
  val r =
    defer println(n)
    1
  steps(n - r)

main() = ()
