// error: cannot infer `F` from `Nest[Option, int]`: `Nest` has a parameter that takes a constructor, which a hole cannot leave open; write `F`, as in `two[Either](arguments)`
// error: expected Option[int], found Vector[int]
// error: cannot infer `F` for this call to `wrap`; write it, as in `wrap[Option](arguments)`
// error: cannot infer `F` for this call to `fromExpected`; write it, as in `fromExpected[Option](arguments)`
// A type whose parameter takes a constructor is no constructor to infer; two arguments naming one
// `F` must agree on its type; with nothing expected and no argument naming `F`, the call asks for
// it; and an expected type that is no generic type decides nothing.
data Nest[G[_], A](inner: G[A])

two[F[_, _], A, B](x: F[A, B]) -> F[A, B] = x

twice[F[_], A](x: F[A], y: F[A]) -> F[A] = y

wrap[F[_], A](a: A) -> F[A] = wrap[F, A](a)

fromExpected[F[_]](n: int) -> F[int] = fromExpected[F](n)

main()
  println(two(Nest[Option, int](Some(1))))
  println(twice(Some(1), [2]))
  println(wrap(3))
  val n: int = fromExpected(1)
