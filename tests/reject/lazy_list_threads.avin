// A lazy list is not sendable: its cells not yet evaluated are functions that may hold anything, so
// one reached by a thread's body, through a module-level value or a captured local, is
// an error.
// error: it reaches `squares`, a module-level value holding a `LazyList[string]`, which is mutable, and not made to be shared between threads
// error: it uses `local`, a `LazyList[int]`, which is mutable, and not made to be shared between threads
import avin.threads.scope

lazy val squares: LazyList[string] = LazyList.from(0).map(n -> s"sq${n * n}")

main()
  scope(s ->
    s.spawn(() ->
      println(squares.head)))
  val local = LazyList.from(0)
  scope(s ->
    s.spawn(() ->
      println(local.head)))
