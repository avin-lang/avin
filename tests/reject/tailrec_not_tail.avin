// error: this recursive call of `factorial` is not in tail position: its result is used by `*`
// error: this recursive call of `widen` is not in tail position: its result is converted to long
// error: this recursive call of `logged` is not in tail position: more of its block follows it
// error: this recursive call of `inLoop` is not in tail position: it is inside a loop
// error: this recursive call of `nested` is not in tail position: its result is an argument of another call
// `@tailrec` refuses a recursive call whose result is still used: by an operator, a conversion, the
// code after it, a loop around it, or another call.

@tailrec
factorial(n: long) -> long = if n == 0 then 1 else n * factorial(n - 1)

@tailrec
widen(n: int) -> long = if n == 0 then 0 else long(widen(n - 1))

@tailrec
logged(n: int) -> int
    if n == 0 then return 0
    logged(n - 1)
    println(n)
    n

@tailrec
inLoop(n: int) -> int
    for i in 0..<n
        inLoop(i)
    n

@tailrec
nested(n: int) -> int = if n == 0 then 0 else nested(nested(n - 1))

main() -> int = 0
