// error: expected A, found int
// error: `later` is not defined
// A default of a refined variant's field is checked with the variant's own parameters in scope, as
// any field's default is with its type's: it is a value of the field's type, and a function of the
// fields before it only.

data Expr[T]
  Fine[A](items: Vector[A] = [], count: int = items.size) -> Expr[Vector[A]]
  Wrong[A](items: Vector[A] = [1]) -> Expr[A]
  Early[A](first: int = later, later: A) -> Expr[A]

main() = ()
