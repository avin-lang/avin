// error: `T` does not implement `Display`, so it cannot be interpolated
// error: `<` on `E` needs a bound that is `Ord` or requires it, as in `[E: Ord]`
// error: `<` on `F` needs a bound that is `Ord` or requires it, as in `[F: Ord]`
// error: `<` on `G` needs a bound that is `Ord` or requires it, as in `[G: Ord]`
// error: `<` on `U` needs a bound that is `Ord` or requires it, as in `[U: Ord]`
// In an arm on a variant bounding its own parameter, the enclosing type parameter equated with it
// gains exactly that bound: not the methods of another trait, not among alternatives (neither's
// equalities hold there), not after the arm, not in the other branch of an `is` test, and not for
// another parameter.

data Coll[T]
  Plain(items: Vector[T])
  Sorted[A: Ord](items: Vector[A]) -> Coll[A]

shown[T](c: Coll[T], x: T) -> string = c match
  Plain(_) -> ""
  Sorted(_) -> s"$x"

either[E](c: Coll[E], a: E, b: E) -> bool = c match
  Plain(_) | Sorted(_) -> a < b

after[F](c: Coll[F], a: F, b: F) -> bool =
  val sorted = c match
    Plain(_) -> false
    Sorted(_) -> true
  sorted && a < b

otherwise[G](c: Coll[G], a: G, b: G) -> bool =
  if c is Sorted(_) then true else a < b

other[T, U](c: Coll[T], u: U, w: U) -> bool = c match
  Plain(_) -> false
  Sorted(_) -> u < w

main()
  println(1)
