// error: `x` has no value; only a trait declares a `val` without one, and a class gives each of its fields a value where it declares it
// error: `name` is a trait's `val`, which a subclass may supply, so it cannot be read in the body of an abstract class
// error: an impl adds methods, not state, so it cannot declare the field `size`
// error: `secret` is declared in a trait, so it cannot be private
trait Named
    val name: string
    private val secret: int

class Plain
    val x: int

abstract class Part: Named
    println(name)

class Whole(val name: string, val secret: int): Part()

impl Plain
    val size: int

main()
    println(Whole("w", 1).name)
