open class Animal()
class Dog(): Animal()

class Producer[+T](val item: T)
  get() -> T = item
  put(x: T) -> int = 0

class Cell[+T](var value: T)

trait Consumer[-T]
  take(x: T) -> int
  get() -> T

class Box[T](val item: T)

data List[+T]
  Cons(head: T, tail: List[T])
  Nil

main()
