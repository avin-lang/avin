// error: variance is written on the parameters of a data type or a class, not of a type alias, which is its expansion
// error: a type alias's parameter takes no bounds: the types its body names hold `T` to theirs wherever the alias is used
// error: a lower bound is written on a function's or a method's own type parameter, not on `W`
// error: the type parameter `A` is declared more than once
// error: `Self` is the type implementing a trait, so it cannot be declared
// A type alias's parameters are plain names: no variance, no bounds, no lower bound, each once, since
// the alias is its expansion and the types the body names hold each type argument to their own
// bounds. `Self` is a trait's, never an alias's name.

type Out[+T] = Vector[T]
type Sorted[T: Ord] = Vector[T]
type Wide[W >: int] = Vector[W]
type Twice[A, A] = (A, A)
type Self = int

main() = ()
