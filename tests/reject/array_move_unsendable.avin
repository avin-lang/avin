// error: `Buffer[int]` does not conform to `Sendable`, the bound of `T` in `move`: it is mutable
// An array moves only where its elements are sendable: an array of buffers would carry buffers the
// sender still reaches, so moving one is refused at the call.
import avin.actors.Isolated

main()
  val a = Array.fill[Buffer[int]](1, Buffer[int]())
  val moved = Isolated.move(a)
  println(moved.take().length)
