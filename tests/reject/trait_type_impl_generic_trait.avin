// A generic trait is implemented for a trait type at its arguments, which meet the trait's bounds
// as anywhere. Named without them it stands for a constructor's impl, which a trait type has none
// of, as it has none of a trait whose methods write `Self` with type arguments. The conformance
// holds at the arguments the impl states and at no others.
// error: `Map[int, bool]` does not conform to `Describe`, the bound of `T` in `Into`
// error: `Flat` is a trait, and only a data type or a class implements the constructor trait `Into`
// error: `Line` is a trait, and only a data type or a class implements the constructor trait `Wraps`
// error: `Shape` does not conform to `Into[int]`, the bound of `T` in `poured`

trait Describe
  describe() -> string

impl Describe for int
  describe() -> string = s"$self"

impl[K: Describe, A: Describe] Describe for Map[K, A]
  describe() -> string = s"map of $size"

trait Into[T: Describe]
  into(extra: T) -> string

trait Wraps[A]
  wrap[B](f: A -> B) -> Self[B]

trait Shape
  area() -> int

trait Solid
  volume() -> int

trait Flat
  width() -> int

trait Line[A]
  first() -> A

impl Into[Map[int, int]] for Shape
  into(extra: Map[int, int]) -> string = extra.describe()

impl Into[Map[int, bool]] for Solid
  into(extra: Map[int, bool]) -> string = ""

impl Into for Flat
  into(extra: int) -> string = ""

impl[A] Wraps[A] for Line[A]
  wrap[B](f: A -> B) -> Line[B] = self

poured[T: Into[int]](x: T) -> string = x.into(1)

main()
  val s: Option[Shape] = None
  s.map(x -> poured(x))
  0
