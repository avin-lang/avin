// One scope declares one given of a type: a block, a module's top level and an object's body each
// report the second, naming the first. Givens of one type in different blocks, and of different
// types in one, are not reported.
// error: `replica` is a second given of type `Tx` in this block, beside `primary` (line 20)
// error: `backup` is a second given of type `Tx` at this module's top level, beside `main0` (line 16)
// error: `two` is a second given of type `Tx` in `Holder`, beside `one` (line 12)

data Tx(id: int)
data Log(name: string)

object Holder
  given one = Tx(1)
  given log = Log("h")
  given two = Tx(2)

given main0 = Tx(0)
given backup = Tx(9)

main()
  given primary = Tx(1)
  given log = Log("a")
  if primary.id > 0
    given primary2 = Tx(3)
    println(primary2.id)
  given replica = Tx(2)
  println(replica.id + log.name.byteLength + Holder.one.id)
