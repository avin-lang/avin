// error: `wrong` yields bool, not T
// error: this arm yields int, not the T expected of the `match`
// error: the arms of this `match` agree on no type: `IntLit`'s yields an `int`, which is `T` only inside that arm; declare the result type
// error: the clauses of `undeclaredClauses` agree on no type: `IntLit`'s yields an `int`, which is `T` only inside that clause; declare the result type
// error: `+` needs two values of one type, not T and int
// An arm's result is checked against the type expected of the `match` under the arm's equalities,
// so an arm yielding a type its equalities do not make the expected one is an error. Where no type
// is expected an arm yields its own type as written, so arms yielding `int` and `T` agree on none.
// Outside the arm nothing of it is known.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  BoolLit(value: bool) -> Expr[bool]
  If(cond: Expr[bool], yes: Expr[T], no: Expr[T])

wrong[T](e: Expr[T]) -> T
wrong(IntLit(n)) = true
wrong(BoolLit(b)) = b
wrong(If(c, y, n)) = wrong(y)

wrongArm[T](e: Expr[T]) -> T = e match
  IntLit(n) -> n
  BoolLit(b) -> 1
  If(c, y, n) -> wrongArm(y)

undeclared[T](e: Expr[T], x: T) = e match
  IntLit(n) -> n
  _ -> x

undeclaredClauses[T](e: Expr[T], x: T)
undeclaredClauses(IntLit(n), x) = n
undeclaredClauses(_, x) = x

leaks[T](e: Expr[T], x: T) -> T
  e match
    IntLit(n) -> println(x + n)
    _ -> ()
  x + 1

main()
  println(wrong(IntLit(1)))
