// error: expected a pattern
// error: expected `->`
// error: expected a pattern
// error: expected `->`
// The keyword `match` on the left of `=` is reported as itself, in a `while` body and a `for` body,
// and what the parser recovers to adds no further error quoting the line or the enclosing body.

in_while(at: int) -> int
  var i = 0
  while i < 3
    match = at
    i += 1
  i

in_for(at: int) -> int
  for i in [1, 2, 3]
    match = at
  at

main() -> int = 0
