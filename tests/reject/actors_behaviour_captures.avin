// error: a `@sendable (ActorRef[int]) -> (int) -> unit` may use only sendable values from around it, but it uses `seen`, a `Buffer[int]`, which is mutable
// error: a `@sendable (ActorRef[int]) -> (int) -> unit` may use only sendable values from around it, but it captures `count`, a `var`
// error: a `@sendable (ActorRef[int]) -> (int) -> unit` may run on another thread, which shares the program's module-level state, but it reaches `total`, a module-level `var`
// error: a `@sendable (ActorRef[int]) -> (int) -> unit` may use only sendable values from around it, but it uses `f`, a `(int) -> unit`, which is a function value
// A behaviour's start is a `@sendable` function, made on one thread and run on another, so it may
// capture only sendable values and no `var`, and reach no module-level mutable state: a buffer
// captured, a `var` captured, a module-level `var` reached, and a plain function value held.
import avin.actors.{Behaviour, spawn}

var total = 0

buffered() -> Behaviour[int]
    val seen = Buffer[int]()
    Behaviour("Buffered", me -> n -> seen.append(n))

counted() -> Behaviour[int]
    var count = 0
    Behaviour("Counted", me -> n -> count += n)

totalled() -> Behaviour[int] = Behaviour("Totalled", me -> n -> total += n)

called(f: (int) -> unit) -> Behaviour[int] = Behaviour("Called", me -> n -> f(n))

main() = ()
