// error: `framed` is static: it belongs to the type, not to a value, so it has no `self` and cannot use the members of a value
// A static member's body has no value, so another static member is called on the type, as in
// `string.bracket()`, and a bare call reports that once, not again as a call on a value.

impl string
  static framed(s: string) -> string = bracket() + s + "]"
  static bracket() -> string = "["

main() = println(string.framed("x"))
