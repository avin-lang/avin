// error: a lower bound is written on a function's or a method's own type parameter, not on `A`
// error: unknown type `Nope`
// error: `Plain` does not
// error: `Expr` takes 1 type argument, not 0
// error: unknown type `Missing`
// A variant's own parameters take bounds as any type parameter does, which are resolved where the
// variant is declared, and no lower bound; the result is held to its type's bounds and arity, and
// names only types that exist.

class Plain()

data Sorted[T: Ord]
  Ints(items: Vector[int]) -> Sorted[int]
  Odd(item: Plain) -> Sorted[Plain]

data Expr[T]
  Low[A >: int](value: A) -> Expr[A]
  Unknown[A: Nope](value: A) -> Expr[A]
  Bare(value: int) -> Expr
  Lost(value: int) -> Expr[Missing]
  Sendy[R: Sendable & Display](value: R) -> Expr[R]

main() = ()
