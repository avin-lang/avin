// A function value has no `using` section: a function or a method with one, taken as a value, has
// its section filled where it is taken, so it is the error a call would be where no given is in scope
// or two fit; its type is the parameters before the section, so it does not fit a function type that
// takes the section too, and a call of it passes those parameters only. A method whose parameters are
// all in its section is called with `()`, as one of no parameters is.
// error: `insert` needs a `Tx` for `tx`, and no given of that type is in scope: declare one (`given tx = …`), take one as `using`, import one, or pass `tx = …`
// error: two givens fit `log: Logger` of `note` here: `a` (a `FileLogger`, line 32) and `b` (a `NetLogger`, line 33); pass `log = …`
// error: expected (int, Tx) -> int, found (int) -> int
// error: this function takes 1 argument, not 2
// error: `current` is called with `()`: write `s.current()`, or `() -> s.current()` for a function value

data Tx(id: int)

trait Logger
  write(s: string)

class FileLogger(): Logger
  override write(s: string) = ()

class NetLogger(): Logger
  override write(s: string) = ()

class Session()
  current(using tx: Tx) -> int = tx.id

insert(row: int, using tx: Tx) -> int = row + tx.id

note(s: string, using log: Logger) = log.write(s)

main()
  val f = insert
  given a = FileLogger()
  given b = NetLogger()
  [""].foreach(note)
  given t = Tx(1)
  val g: (int, Tx) -> int = insert
  val h = insert
  println(h(1, t))
  val s = Session()
  val c = s.current
  ()
