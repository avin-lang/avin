// A function value has no `using` section: a function or a method with one, taken as a value, takes
// its contextual parameters as positional ones, so one passed where a function of the written
// parameters alone is expected does not fit, and a call of the value passes every argument. A direct
// call writing more positional arguments than the parameters before the section is told so.
// error: this function takes 1 argument, not 0
// error: expected (int) -> unit, found (int, Tx) -> int
// error: expected (int) -> int, found (int, Tx) -> int
// error: `tag` takes 0 arguments, not 2
// error: `insert` takes 1 argument, not 3

data Tx(id: int)

insert(row: int, using tx: Tx) -> int = row + tx.id

tag(using tx: Tx) -> int = tx.id

main()
  given t = Tx(1)
  val f = tag
  println(f())
  println(f(t))
  [1, 2].foreach(insert)
  val g: (int) -> int = insert
  println(tag(t, t))
  println(insert(1, 2, 3))
