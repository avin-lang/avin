// error: `bool` does not implement Inverse's `!`; a built-in type takes no default bodies, so its impl implements every method of the trait
// error: a prefix `!` on bool is the language's own, and no method can define it; only a data type, a class or a trait has a method `!` taking no argument
// A trait may declare a method `!`, but a built-in type cannot implement it: its `!` stays the
// language's.
trait Inverse
  !() -> Inverse

impl Inverse for bool
  !() -> Inverse = self

main()
  println(1)
