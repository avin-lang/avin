// error: a positional argument cannot follow a named one
// error: `take` has no parameter `z`
// error: `n` is given more than once
// error: `s` is given more than once
// error: `take` needs an argument for `s`, which has no default
take(n: int, s: string, flag: bool = false) -> int = n

main()
    take(n = 1, "one")
    take(1, "one", z = 2)
    take(n = 1, s = "one", n = 2)
    take(1, "one", s = "two")
    take(n = 1, flag = true)
