// error: cannot infer the type of `a`; write it, as in `(a: int, other: int) -> body`
// error: cannot infer the type of `b`; write it, as in `(b: int, other: int) -> body`
// error: cannot infer the type of the tuple this lambda takes apart; declare its parameters' types
// error: `a` is a `val`; only a `var` can be assigned
// error: expected a function of 2 parameters, but this lambda takes 3
// A lambda taking a tuple apart needs each element's type from the expected type or from its
// declaration; its parameters are `val`s; and a two-parameter function type is not a tuple.

fromLambda[A, B, C](g: ((A, B)) -> C) -> string = "ok"

main()
    println(fromLambda((a, b: int) -> 1))
    println(fromLambda((a: int, b) -> a))
    println(fromLambda((_, _) -> 1))
    val f: ((int, int)) -> int = (a, b) -> a = 3
    val g: (int, int) -> int = (a, b, c) -> a
