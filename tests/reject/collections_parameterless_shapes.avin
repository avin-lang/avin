// A program's own collection declares an accessor without a parameter list, as the trait does; and
// an accessor has no function value, so a lambda gives one.
// error: `length` overrides `Seq.length`, which is declared without a parameter list; declare this one `length -> body` too
// error: `size` overrides `Iterable.size`, which is declared without a parameter list; declare this one `size -> body` too
// error: `isEmpty` overrides `Seq.isEmpty`, which is declared without a parameter list; declare this one `isEmpty -> body` too
// error: `head` takes no parameter list, so it has no function value: naming it calls it; for a function, write a lambda, as in `() -> x.head`

class Wrong(n: int): Seq[int]
  override length() -> int = n
  override apply(i: int) -> int = i

class Counted: Iterable[int]
  override iterator() -> Iterator[int] = [1].iterator()
  override size() -> int = 1

class Emptied: Seq[int]
  override length -> int = 0
  override apply(i: int) -> int = i
  override isEmpty() -> bool = true

main()
  val xs = [1, 2]
  val f: () -> int = xs.head
  println(f())
