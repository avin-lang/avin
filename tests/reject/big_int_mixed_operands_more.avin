// error: expected int, found BigInt
// error: `BigInt` has no method `&`
// error: `BigInt` has no method `+%`
// error: `<` cannot compare BigInt with real
// error: `*` needs two numbers of one type, not real and BigInt
// A `BigInt` never converts back to an integer, the bitwise, wrapping and saturating operators stay
// the integers' own, and a `real` meets a `BigInt` on neither side.
main()
  val big = BigInt(5)
  val back: int = big
  println(big & 1)
  println(big +% 1)
  println(big < 2.5)
  val r = 1.5
  println(r * big)
