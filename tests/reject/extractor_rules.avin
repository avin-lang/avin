// error: this `match` does not cover every int value, since an extractor may answer that it does not match; add an arm for the rest, such as `_`
// error: `limit` is not a variant, and int has no `unapply` or `unapplySeq` to make it an extractor
// error: `Nowhere` is not a variant or an extractor
// error: `rest*` stands for the rest of a sequence, last in a sequence pattern or in an `unapplySeq` extractor's patterns
object Twice
  unapply(n: int) -> Option[int] = if n % 2 == 0 then Some(n / 2) else None

object Digits
  unapplySeq(n: int) -> Option[Vector[int]] = Some([n])

// An extractor may answer that it does not match, so a `match` needs an arm for the rest.
half(n: int) -> int = n match
  Twice(h) -> h

main()
  val limit = 3
  val n = 8 match
    limit(x) -> x
    Nowhere(y) -> y
    Digits(first, middle*, last) -> first
    _ -> 0
