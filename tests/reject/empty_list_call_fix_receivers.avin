// Where the receiver is no plain name, the fix names the call after a bare dot rather than repeat the
// receiver's text: a constructor call, an `Option`, a string literal, a field of an object, and an
// element read by index; each followed by more of a chain, as `.next()` or `.toString`.
// error: `bump` is called with `()`: write `.bump()`, or a lambda calling it for a function value
// error: `iterator` is called with `()`: write `.iterator()`, or a lambda calling it for a function value
// error: `toInt` is called with `()`: write `.toInt()`, or a lambda calling it for a function value
// error: `total` is called with `()`: write `.total()`, or a lambda calling it for a function value
// error: `bump` is called with `()`: write `.bump()`, or a lambda calling it for a function value

class Counter(var n: int)
    bump() -> bool
        n = n + 1
        n > 2
    total() -> int = n

class Pair(val left: Counter, val right: Counter)

main()
    println(Counter(0).bump.toString)
    println(Some(1).iterator.hasNext())
    println("12".toInt.toString)
    val p = Pair(Counter(1), Counter(2))
    println(p.left.total + 1)
    val cs = [Counter(0)]
    println(cs(0).bump)
