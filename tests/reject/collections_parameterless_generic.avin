// Through `Iterable[T]`, `Seq[T]`, a bounded type parameter and an iterator the accessors are the
// same parameterless methods, so `()` is refused there too.
// error: `size` takes no parameter list, so it is called without parentheses: write `size`, not `size()`
// error: `length` takes no parameter list, so it is called without parentheses: write `length`, not `length()`
// error: `max` takes no parameter list, so it is called without parentheses: write `max`, not `max()`
// error: `sum` takes no parameter list, so it is called without parentheses: write `sum`, not `sum()`
// error: `toVector` takes no parameter list, so it is called without parentheses: write `toVector`, not `toVector()`

counted[T](xs: Iterable[T]) -> int = xs.size()

measured[T](xs: Seq[T]) -> int = xs.length()

greatest[T: Ord](xs: Iterable[T]) -> T = xs.max()

total[T: Add](xs: Iterable[T]) -> T = xs.sum()

drained[T](it: Iterator[T]) -> Vector[T] = it.toVector()

main()
  println(counted([1]), measured([1]), greatest([1]), total([1]), drained([1].iterator()))
