// error: `+=` needs two numbers of one type, not long and int; write `long(n)`
// error: `-=` needs two numbers of one type, not int and long; write `int(total)`
// error: `*=` needs two numbers of one type, not int and real; write `int(rate)`
// error: `+:=` needs two numbers of one type, not real and int; write `real(n)`
// error: `/=` needs two numbers of one type, not i8 and int; write `i8(n)`
// A compound assignment's target keeps its type, so the value converts to it, narrowing where the
// target is the narrower: the hint is a conversion that traps or truncates, and says so by its name.

main()
    var total: long = 0
    var n = 3
    val rate = 1.5
    var x = 2.0
    var small: i8 = 4
    total += n
    n -= total
    n *= rate
    println(x +:= n)
    small /= n
