// error: a `lazy` value is computed once and never assigned, so it is declared `lazy val`
// error: a `lazy val` is computed from its initializer, so it needs one
// A field declared `lazy` is a `lazy val` with an initializer. A local `lazy val` in a function's body
// is a value of its own, and is legal.
class Box()
    lazy var size: int = 1
    lazy val missing: int

main() -> int
    lazy val local = 3
    local
