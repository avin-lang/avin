// error: a `lazy` value is computed once and never assigned, so it is declared `lazy val`
// error: a `lazy val` is computed from its initializer, so it needs one
// error: a local is computed where it is declared, so it cannot be `lazy`
// A field declared `lazy` is a `lazy val` with an initializer, and a local is computed where it is
// declared, so it cannot be lazy.
class Box()
    lazy var size: int = 1
    lazy val missing: int

main() -> int
    lazy val local = 3
    local
