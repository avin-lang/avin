// error: expected Sink[Dog], found Sink[int]
// error: expected Sink[Animal], found Sink[Dog]
// Where the arguments decide a contravariant type argument, the result is still held to the type
// expected of it: a sink of `int`s is no sink of dogs, and a sink of dogs is no sink of animals.
class Sink[-T](val n: int)

class Box[T](val v: T)

open class Animal(val name: string)
class Dog(name: string): Animal(name)

make[T](b: Box[T]) -> Sink[T] = Sink[T](1)

animalSink(s: Sink[Animal]) -> int = s.n

main()
    val a: Sink[Dog] = make(Box(3))
    println(animalSink(make(Box(Dog("rex")))))
    println(a.n)
