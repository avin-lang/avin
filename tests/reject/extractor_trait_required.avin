// error: `Twice` is not a variant, and Twice implements no extractor trait; its `unapply` makes no extractor by its name alone: make `Twice` implement `Extractor[int, int]` and mark `unapply` `override`
// error: `Even` is not a variant, and Even implements no extractor trait; its `unapply` makes no extractor by its name alone: make `Even` implement `BoolExtractor[int]` and mark `unapply` `override`
// error: `Words` is not a variant, and Words implements no extractor trait; its `unapplySeq` makes no extractor by its name alone: make `Words` implement `SeqExtractor[string, List[string]]` and mark `unapplySeq` `override`
// error: `Num` implements `Extractor[int, int]`, which takes no string, the value matched here
// error: `Pair` is not a variant, and Pair implements no extractor trait; its `unapply` makes no extractor by its name alone, and a generic one implements no trait: declare the type parameters on a class implementing `Extractor`, `BoolExtractor` or `SeqExtractor`, and match with a value of it
// A method named `unapply` or `unapplySeq` makes no extractor without the trait; the error names the
// trait to implement, from the method's own signature.
object Twice
  unapply(n: int) -> Option[int] = if n % 2 == 0 then Some(n / 2) else None

object Even
  unapply(n: int) -> bool = n % 2 == 0

object Words
  unapplySeq(s: string) -> Option[List[string]] = Some(s.split(" ").toList)

object Pair
  unapply[A](xs: List[A]) -> Option[(A, A)] = None

object Num: Extractor[int, int]
  override unapply(n: int) -> Option[int] = Some(n)

one(n: int) -> int = n match
  Twice(h) -> h
  Even() -> 0
  _ -> 1

two(s: string) -> int = s match
  Words(a, b) -> 2
  Num(n) -> n
  _ -> 0

three(xs: List[int]) -> int = xs match
  Pair(a, b) -> a + b
  _ -> 0

main() = ()
