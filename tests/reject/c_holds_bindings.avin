// `hold:` names integer parameters whose values the handle a binding answers, or its receiver, holds,
// each declared by the holder's class with `holds:`.
// error: `hold:` names `fd`, which is not a parameter of `noSuch`
// error: `hold:` names `name`, of type `string`: a handle holds a C integer, such as a descriptor, and a handle or an object is kept with `keeps:`
// error: `undeclared` holds `third` in a `Conn`, which declares no `holds:` of that name
// error: `hold:` makes the handle a binding answers hold the values it names, and `nowhere` answers no handle and is no method of one
// error: `hold:` names a parameter, or a list of them, as strings, as in `hold: "sock"`

@c(type: "struct conn *", holds: ["int sock = -1", "long other"], release: "conn_free(self, sock, other)")
class Conn
  @c("int conn_start(struct conn *self, int sock)", hold: "fd")
  noSuch(sock: int) -> int

  @c("int conn_name(struct conn *self, const char *name)", hold: "name")
  named(name: string) -> int

  @c("int conn_start(struct conn *self, int third)", hold: "third")
  undeclared(third: int) -> int

@c("int conn_start(int sock)", hold: "sock")
nowhere(sock: int) -> int

@c("struct conn *conn_new(int sock)", hold: 3)
badWord(sock: int) -> Conn

main() = 0
