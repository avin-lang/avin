// error: this `match` does not cover every `int | string | bool` value, such as `_: bool`
// error: this pattern could match more than one member of `int | long`, `int` and `long`; match the member first with a type pattern, as in `x: int`
// error: this pattern could match more than one member of `Option[int] | Option[string]`, `Option[int]` and `Option[string]`; match the member first with a type pattern, as in `x: Option[int]`
// error: `bool` is no member of `int | string`, so this pattern can never match
// error: this arm is never reached: the arm `n: int` on line 26 already matches every value it would
// A `match` on a union covers every member; a pattern two members could match, a type pattern
// naming no member, and an arm after its member is covered are errors.

kind(v: int | string | bool) -> string = v match
    _: int -> "int"
    _: string -> "string"

zero(v: int | long) -> string = v match
    0 -> "zero"
    _ -> "other"

some(v: Option[int] | Option[string]) -> string = v match
    Some(x) -> "some"
    _ -> "none"

never(v: int | string) -> string = v match
    b: bool -> "bool"
    _ -> "other"

twice(v: int | string) -> string = v match
    n: int -> "int"
    _: int -> "again"
    _: string -> "string"

main() = 0
