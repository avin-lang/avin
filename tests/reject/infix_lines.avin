// error: an infix call starts on its receiver's line: end that line with `add` to put the argument on the next
// An infix call stays on one line, except that a line ending with the method's name continues on the
// next. Inside brackets, where a line break does not end the expression, a name that starts the next
// line still does not continue the line before it.

class Bag(val n: int)
    add(k: int) -> int = n + k

bracketed(b: Bag) -> int
    val t = (b
        add 2)
    t

main() -> int = 0
