// error: this delayed argument yields string, not int
// error: expected int, found string
// error: `int` is not a supertype of `Cat`, the lower bound of `B` in `getOrElse`
// error: this delayed argument yields bool, not long

// Option's, Either's and Result's lower bounds admit only a type the held one is seen as: a value
// type's bound is that type alone, so a value of another does not widen it, and a written type
// argument is held to the bound.

class Cat

main()
    val ints: Option[int] = Some(3)
    println(ints.getOrElse("none"))
    println(ints.contains("three"))
    val numbers: Either[int, Cat] = Left(3)
    println(numbers.orElse(Left("text")))
    val cats: Option[Cat] = None
    println(cats.getOrElse[int](3))
    val result: Result[long, string] = Ok(2)
    println(result.getOrElse(true))
