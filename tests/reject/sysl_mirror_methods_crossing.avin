// error: `List[int]` cannot cross to Sysl; a binding's parameters and result are integers of 8, 16, 32 or 64 bits, `byte`, `real`, `char`, `bool`, `unit`, `string`, data types declared with `@sysl` to mirror a Sysl enum or struct, and `Array`, `Vector`, `Option`, `Result` and tuples of these

@sysl("avintest.digits.Verdict")
data Verdict(code: long, note: string)

impl Verdict
    kinds(of: Vector[List[int]]) -> long
    listed() -> List[int]

main()
    println(Verdict(1, "a").listed())
