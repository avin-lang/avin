// Two overloads differing only in the order of a union's members are one overload. A value fitting
// two unrelated unions is ambiguous. A union argument does not choose among overloads of its
// members, for a function or a method, whichever order its members are written in.

f(x: int | string) -> string = "is"
f(x: int | bool) -> string = "ib"

width(n: int) -> int = n
width(s: string) -> int = s.charCount

h(x: int | string) -> int = 1
h(x: string | int) -> int = 2

class Box
    put(n: int) -> int = n
    put(s: string) -> int = 0

main()
    println(f(1))
    val u: int | string = 1
    println(width(u))
    println(Box().put(u))
    val v: string | int = "a"
    println(width(v))
