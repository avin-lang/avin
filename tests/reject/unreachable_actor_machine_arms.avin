// An actor's `receive` arms and a machine state's own arms are held to the rule. The shared
// `receive` arms of a machine are judged against each other, once: a state may override them.
data Ev
    Start
    Stop
    Tick(n: int)

actor Worker receives Ev
    receive
        Tick(_) -> ()
        _ -> ()
        Start -> ()

machine Door receives Ev
    state Idle
        _ -> stay
        Start -> Idle

    state Running
        Stop -> Idle

    receive
        Tick(n) -> stay
        Tick(0) -> stay
        _ -> stay

main() = ()
