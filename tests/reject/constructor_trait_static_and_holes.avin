// error: `Shipping`'s parameter `A` is bounded by `Sendable`, so the hole it stands for is too, as in `F[_: Sendable]`
// error: `pure` is a static member of the constructor trait `Pointed`, so it names no parameter of the trait, and it names `A`: a call of it names only the constructor, as in `F.pure(…)`; give it a type parameter of its own
// A constructor trait's bounded parameter bounds the hole it stands for, which a constructor
// parameter bounded by the trait must promise; and a static member, called on a constructor, names
// no parameter of the trait.
trait Shipping[A: Sendable]
  ship[B: Sendable](f: @sendable (A) -> B) -> Self[B]

loose[F[_]: Shipping](x: F[int]) -> int = 0

trait Pointed[A]
  static pure(value: A) -> Self[A]
  static empty[X]() -> Self[X]

data Cell[T](value: T)

impl Pointed for Cell
  static pure(value: T) -> Cell[T] = Cell(value)
  static empty[X]() -> Cell[X] = todo()

main()
  println(1)
