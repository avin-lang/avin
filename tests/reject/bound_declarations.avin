// error: `Self` is the type implementing a trait, so it is written only in a trait's methods
// error: a bound is a trait or a class, not int
// error: `T` has no bound, so it has no member `less`; a bound, as in `[T: Trait]`, gives it the methods of the trait
// error: `Ranked` mentions `Self`, so it is a bound, as in `[T: Ranked]`, and not a type
trait Ordered
  less(other: Self) -> bool

// A trait requiring one that mentions `Self` mentions it too.
trait Ranked: Ordered
  rank() -> int

class Point(x: int)
  closer(other: Self) -> bool = true

numeric[T: int](a: T) -> T = a

unbounded[T](a: T, b: T) -> bool = a.less(b)

ranked(r: Ranked) -> int = r.rank()

main() = ()
