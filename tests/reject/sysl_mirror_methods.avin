// Only a Sysl mirror's methods may go without a body, and only in an `impl` of no trait; a bound
// method's `@sysl` names a Sysl method, and a method with a body takes none.
// error: `plain` needs a body, or clauses on the lines after it
// error: a method with a body is not bound to Sysl, so it takes no `@sysl`
// error: unknown annotation `@inline` on a method of a Sysl mirror
// error: `@sysl` on a mirror's method names the Sysl method it is bound to, as in `@sysl("close")`; `a.b` is not one
// error: `show` needs a body, or clauses on the lines after it

data Plain(n: long)

impl Plain
  plain() -> long

@sysl("avintest.digits.Verdict")
data Verdict(code: long, note: string)

impl Verdict
  @sysl("describe")
  described() -> string = "x"
  @inline
  even() -> bool
  @sysl("a.b")
  kind() -> long

trait Show
  show() -> string

impl Show for Verdict
  show() -> string

main()
  println(Plain(1).plain())
