// error: a `Parrot` is both a `Named` and a `Pet`, so it could be either member of `Named | Pet`; give it the type you mean first, as in `val n: Named = value`
// error: the literal `3` fits `byte` and `long`, so it could be more than one member of `byte | long`; give it the type you mean, as in `byte(3)`
// error: this value could be `Option[int]` and `Option[string]`, more than one member of `Option[int] | Option[string]`; give it the type you mean first, as in `val x: Option[int] = value`
// error: expected int | string, found int | bool
// error: expected int | long | string, found bool
// A value that converts to several members, a literal several numeric members fit, `None` with two
// option members, a union with a member the target lacks, and a value no member takes are errors.

trait Named
  name() -> string

trait Pet
  owner() -> string

class Parrot(n: string): Named, Pet
  override name() -> string = n
  override owner() -> string = "ann"

type Num = int | long

main()
  val p: Named | Pet = Parrot("polly")
  val n: byte | long = 3
  val o: Option[int] | Option[string] = None
  val ib: int | bool = 1
  val narrower: int | string = ib
  val num: Num | string = true
