// error: `Either` already implements `Mappable`; a type implements a constructor trait once, at one choice of holes
// error: `T` is a hole of `Mappable[T]`, and a hole takes no bounds: the constructor conforms at every type it is applied to; bound only the parameters written out
// error: each of `Mappable`'s arguments is a parameter of `Result` left open, a hole, and int is none; a constructor trait's argument names the parameter, as in `impl[T, E] Mappable[T] for Result[T, E]`
// error: `A` is named twice among `Bimappable[A, A]`'s arguments; each hole is a different parameter of `Twin`
// error: `Twin` takes two arguments and `Mappable` one argument; name the ones left open, as in `impl[A, B] Mappable[B] for Twin[A, B]`
// An impl of a constructor trait gives the trait distinct parameters of the type, left open and
// unbounded, or leaves them off only where they are all the type's parameters; a type implements a
// constructor trait once.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

trait Bimappable[A, B]
  bimap[C, D](f: (A) -> C, g: (B) -> D) -> Self[C, D]

impl[L, R] Mappable[R] for Either[L, R]
impl[L, R] Mappable[L] for Either[L, R]

data Box[T](value: T)

impl[T: Display] Mappable[T] for Box[T]
  map[B](f: (T) -> B) -> Box[B] = Box(f(value))

impl[T, E] Mappable[int] for Result[T, E]

data Twin[A, B](a: A, b: B)

impl[A, B] Bimappable[A, A] for Twin[A, B]

impl Mappable for Twin

main()
  println(1)
