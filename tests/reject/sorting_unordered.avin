// error: `sorted` needs `T: Ord`, which Seq[T] does not meet
// error: `sorted` needs `T: Ord`, which Vector[Plain] does not meet
// error: `sorted` needs `T: Ord`, which List[Loose] does not meet
// error: `sort` needs `T: Ord`, which Buffer[Plain] does not meet
// error: `Plain` does not conform to `Ord`, the bound of `K` in `sortBy`
// Only ordered elements sort without being told how: `sorted()` and `sort()` need `Ord` of the
// element type, and `sortBy` of the key, while `sortWith` and a `sortBy` to an ordered key need
// nothing of the elements.
class Plain(val n: int)

data Loose(n: int)

unbounded[T](xs: Seq[T]) -> Vector[T] = xs.sorted()

main()
    val vector: Vector[Plain] = [Plain(2), Plain(1)]
    print(vector.sorted().length())
    print(vector.sortedBy(p -> p.n).length())
    print(vector.sortedWith((a, b) -> a.n.compare(b.n)).length())
    val list: List[Loose] = [Loose(1)]
    print(list.sorted().length())
    val buffer = Buffer[Plain]()
    buffer.sort()
    val array: Array[Plain] = [Plain(1)]
    array.sortBy(p -> p)
