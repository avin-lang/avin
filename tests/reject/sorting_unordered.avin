// error: `sorted` needs `T: Ord`, which Seq[T] does not meet
// error: `sorted` needs `T: Ord`, which Vector[Plain] does not meet
// error: `sorted` needs `T: Ord`, which List[Loose] does not meet
// error: `sortInPlace` needs `T: Ord`, which Buffer[Plain] does not meet
// error: `Plain` does not conform to `Ord`, the bound of `K` in `sortInPlaceBy`
// Only ordered elements sort without being told how: `sorted()` and `sortInPlace()` need `Ord` of
// the element type, and `sortBy` and `sortInPlaceBy` of the key, while `sortWith` and a `sortBy` to
// an ordered key need nothing of the elements.
class Plain(val n: int)

data Loose(n: int)

unbounded[T](xs: Seq[T]) -> Vector[T] = xs.sorted()

main()
  val vector: Vector[Plain] = [Plain(2), Plain(1)]
  println(vector.sorted().length())
  println(vector.sortBy(p -> p.n).length)
  println(vector.sortWith((a, b) -> a.n.compare(b.n)).length)
  val list: List[Loose] = [Loose(1)]
  println(list.sorted().length())
  val buffer = Buffer[Plain]()
  buffer.sortInPlace()
  val array: Array[Plain] = [Plain(1)]
  array.sortInPlaceBy(p -> p)
