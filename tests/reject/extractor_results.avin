// error: `Count.unapply` answers int; an extractor's `unapply` answers an Option or a bool
// error: `Even.unapply` answers a bool, so it takes no patterns: write `Even()`
// error: `Halves.unapply` gives (int, int), 2 values, so it takes 2 patterns, not 3
// error: `Halves.unapply` answers Option[(int, int)], so it takes one pattern or more, one for each part of the value it gives
// error: `Letters.unapplySeq` answers Option[int]; an extractor's `unapplySeq` answers an Option of a sequence
object Count
    unapply(s: string) -> int = s.byteLength()

object Even
    unapply(n: int) -> bool = n % 2 == 0

object Halves
    unapply(n: int) -> Option[(int, int)] = Some((n / 2, n - n / 2))

object Letters
    unapplySeq(s: string) -> Option[int] = Some(s.byteLength())

one(s: string) -> int = s match
    Count(n) -> n
    _ -> 0

two(n: int) -> int = n match
    Even(m) -> m
    Halves(a, b, c) -> a + b + c
    Halves() -> 1
    _ -> 0

three(s: string) -> int = s match
    Letters(a, b) -> 1
    _ -> 0

main() = ()
