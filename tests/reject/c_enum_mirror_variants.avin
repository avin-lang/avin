// A variant's `@c` names its enumerator as one string that is a C identifier, once.
// error: `@c` on a variant names its enumerator as one string, as in `@c("CAIRO_PDF_VERSION_1_4")`
// error: `@c` on a variant names its enumerator, and `1bad` is not a C identifier
// error: a variant of a C enum mirror has one `@c`
// error: `@c` on a variant names its enumerator as one string, as in `@c("CAIRO_PDF_VERSION_1_4")`

@c(enum: "e_t", prefix: "E_")
data Variants
    @c(3)
    Number
    @c("1bad")
    Digit
    @c("E_A") @c("E_B")
    Doubled
    @c(name: "E_C")
    Named

main() = 0
