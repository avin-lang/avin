// Where memory crosses: a `ByteBlock` is passed in, as it is, never in an `Option` and never `inout`;
// a view is never passed to C; neither a block nor a view is answered but by a binding marked `view`.
// error: parameter 1 of the C binding `passView` is `ByteView` in Avin and `const unsigned char *` in C: a view is memory C lends, never passed back to C; memory C reads, writes or keeps is a `ByteBlock`
// error: parameter 1 of the C binding `maybeBlock` is `Option[ByteBlock]` in Avin and `unsigned char *` in C: a `ByteBlock` is passed as it is, never in an `Option`
// error: parameter 1 of the C binding `notPointer` is `ByteBlock` in Avin and `int` in C: a `ByteBlock` is passed as a pointer to its bytes
// error: the result of the C binding `answersBlock` is `ByteBlock` in Avin and `unsigned char *` in C: a `ByteBlock` is memory Avin gives C, made by `ByteBlock(length)`, never answered by C
// error: the result of the C binding `unmarked` is `ByteView` in Avin and `unsigned char *` in C: a view is lent by a binding marked `view`, its length given with `length:`
import avin.c.{ByteBlock, ByteView}

@c("long sum(const unsigned char *p, length(p) int n)")
passView(p: ByteView) -> long

@c("long fill(unsigned char *p)")
maybeBlock(p: Option[ByteBlock]) -> long

@c("long count(int p)")
notPointer(p: ByteBlock) -> long

@c("unsigned char *make(void)")
answersBlock() -> ByteBlock

@c("unsigned char *make(void)")
unmarked() -> ByteView

main() = 0
