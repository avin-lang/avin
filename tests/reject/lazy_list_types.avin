// A lazy list is covariant and no wider: a list of animals is not a list of dogs. `::` and list
// patterns are a `List`'s, not a lazy list's, and the tail given to `cons` is a lazy list.
// error: expected LazyList[Dog], found LazyList[Animal]
// error: expected List[_], found LazyList[int]
// error: expected LazyList[_], found Vector[int]

open class Animal(val name: string)

class Dog(name: string): Animal(name)

main()
    val dogs: LazyList[Dog] = LazyList.empty[Animal]()
    val consed = 1 :: LazyList.from(2)
    val bad = LazyList.cons(1, [2, 3])
