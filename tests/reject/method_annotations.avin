// A built-in type's impl may declare its operations as intrinsics, each of the type the intrinsic
// has with the receiver first. No other method takes an annotation.
// error: intrinsic `string_byte_length` has type (string) -> int, not (string) -> long
// error: `string_lengths` is not an intrinsic
// error: annotations on methods are not implemented
module avin

impl string
    @intrinsic("string_byte_length")
    wideLength() -> long

    @intrinsic("string_lengths")
    lengths() -> int

    @sysl("sysl.text.to_upper")
    upperCase() -> string

data Box(value: int)

impl Box
    @intrinsic("string_byte_length")
    size() -> int

main() = 0
