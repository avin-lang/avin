// error: `d` is declared Dog, but this lambda is expected to take Animal
// error: `x` is declared Any, but this lambda is expected to take int
// error: `x` is declared Display, but this lambda is expected to take int
// error: `g` is declared (Animal) -> int, but this lambda is expected to take (Dog) -> int
// A lambda's declared parameter may be wider than the one expected only on the terms a function
// type's parameters vary by: never narrower, and never a value type widened to Any or a trait, which
// would need a box inside the function.

open class Animal(val name: string)

class Dog(name: string): Animal(name)

callAnimal(f: (Animal) -> int) -> int = f(Animal("generic"))

callInt(f: (int) -> int) -> int = f(1)

higher(f: ((Dog) -> int) -> int) -> int = f(d -> 1)

main()
    println(callAnimal((d: Dog) -> 1))
    println(callInt((x: Any) -> 2))
    println(callInt((x: Display) -> 3))
    println(higher((g: (Animal) -> int) -> g(Animal("a"))))
