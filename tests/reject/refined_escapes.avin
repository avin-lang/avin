// error: expected int, found T
// error: `n` is bound by an `is` test, and is in scope only where that test is known to hold
// error: this arm's result is an `Expr[A]`, and `A` is a type `Pair` takes from the value it matches, which is not known outside its arm
// error: a type declared outside this arm cannot be settled to an `Expr[A]`: `A` is a type `Pair` takes from the value it matches, which is not known outside its arm
// error: expected Expr[A of `Pair` on line 40], found Expr[A of `Pair` on line 41]
// A type known inside an arm does not leave it. An inference variable settled in an arm settles to
// the type as written there, so a store of another type elsewhere is an error. A name an `is` test
// binds, and the test's equalities, are out of scope past its branch. A type a variant takes from
// the value matched, `Pair`'s `A`, is known only inside the arm: an arm's result naming it with no
// type expected, or a variable declared outside settled to it, is an error, and two values' types
// are two types.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  Pair[A, B](first: Expr[A], second: Expr[B]) -> Expr[(A, B)]

settled[T](e: Expr[T], x: T)
  var best = None
  e match
    IntLit(n) -> best = Some(n)
    _ -> ()
  best = Some(x)

outOfScope[T](e: Expr[T]) -> int
  if e is IntLit(n) then println(n)
  n

leaves[T](e: Expr[T]) = e match
  Pair(a, _) -> a
  _ -> 0

settledOutside[T](e: Expr[T])
  var kept = None
  e match
    Pair(a, _) -> kept = Some(a)
    _ -> ()

twoValues[T, U](x: Expr[T], y: Expr[U])
  x match
    Pair(a, _) -> y match
      Pair(c, _) ->
        var v = a
        v = c
      _ -> ()
    _ -> ()

main()
  settled(IntLit(1), 2)
