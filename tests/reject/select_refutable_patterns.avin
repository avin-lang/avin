// error: a binding's pattern must match every Option[int] value; take the value apart with `match`
// error: a binding's pattern must match every int value; take the value apart with `match`
// The pattern inside `Some` binds as a `val` does, so one that can fail is reported as a `val`'s is.
import avin.threads.Channel

main()
  val c = Channel[Option[int]]()
  select
    c.receive() as Some(Some(x)) -> println(x)
  val d = Channel[int]()
  select
    d.receive() as Some(1) -> ()
