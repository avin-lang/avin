// error: `extra` is not a member of `Show`; an impl of a trait implements the trait's members, and an impl without a trait adds others
// error: `Bag[bool]` does not implement Show's `show`
// error: `Bag[Option[string]].show` implements `Show.show`, which takes 0 parameters, not 1
// error: `U` is not part of `Bag[Option[T]]`; each of an impl's type parameters is, so an instance of the type gives it
// error: `Eq` holds of a type at every instance alike, so its impl is for the type at the impl's type parameters, in order
// What an impl of a trait for an instance owes: the trait's members and no others, each with the
// trait's signature as the instance sees it, a body for each the trait leaves abstract, and type
// parameters the instance gives. Equality is a type's at every instance alike.

trait Show
  show() -> string
  label() -> string = "shown"

data Bag[T](value: T)

impl Show for Bag[int]
  show() -> string = "int"
  extra() -> int = 1

impl Show for Bag[bool]
  label() -> string = "a bool"

impl Show for Bag[Option[string]]
  show(n: int) -> string = "option"

impl[T, U] Show for Bag[Option[T]]
  show() -> string = "options"

impl Eq for Bag[real]
  equals(other: Bag[real]) -> bool = true

main()
  println(Bag(1).show())
