// error: a `@sendable (int) -> int` may use only sendable values from around it, but it uses `a`, an `Array[int]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: a `@sendable () -> int` may use only sendable values from around it, but it captures `count`, a `var`, which the closure would share with the code that made it; copy it into a `val`, or share it through an `Atomic` or a `Mutex`
// error: a `@sendable (int) -> int` may use only sendable values from around it, but it uses `counter`, a `Counter`, whose field `n` is a `var`; make it a `val`
// error: a `@sendable (int) -> int` may use only sendable values from around it, but it uses `f`, a `(int) -> int`, which is a function value, whose type does not say what it captures; mark the parameter `@sendable`, and what is passed for it is checked in turn
// error: a `@sendable () -> string` may use only sendable values from around it, but it uses `log`, a `Buffer[string]`, which is mutable; an immutable copy (`toVector`) is sendable
// A lambda or a method value converted to a `@sendable` function type is held to what it captures,
// wherever it is converted: a `val` of the type, an argument for a parameter of it, a field of data
// holding one, and a result of it. The error names the capture: a mutable array, a `var`, an object
// with a `var` field, a plain function parameter (which marking `@sendable` would make one), and a
// buffer captured by the closure a function returns.
class Counter()
    var n = 0
    bump(x: int) -> int = x + n

data Task(run: @sendable () -> string)

take(f: @sendable (int) -> int) -> int = f(1)

lift(f: (int) -> int) -> @sendable (int) -> int = (x) -> f(x)

logger(log: Buffer[string]) -> Task = Task(() -> log.toString())

main()
    val a = Array.fill(2, 0)
    val first: @sendable (int) -> int = (x) -> a(0) + x
    var count = 1
    count += 1
    val second: @sendable () -> int = () -> count
    val counter = Counter()
    println(take(counter.bump))
    println(lift((x) -> x)(1))
    println(logger(Buffer[string]()).run())
    println(first(1) + second())
