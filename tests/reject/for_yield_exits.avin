// error: `return` cannot leave a `for` with `yield`, whose guards, value definitions and yielded value are functions passed to its sources' methods
// error: `break` cannot leave a `for` with `yield`, whose guards, value definitions and yielded value are functions passed to its sources' methods
// error: `continue` cannot leave a `for` with `yield`, whose guards, value definitions and yielded value are functions passed to its sources' methods
// error: `return` cannot leave a `for` with `yield`, whose guards, value definitions and yielded value are functions passed to its sources' methods
// error: `?` cannot leave a `for` with `yield`, whose guards, value definitions and yielded value are functions passed to its sources' methods
// A comprehension's guards, value definitions and yielded value are functions passed to
// `withFilter`, `map` and `flatMap`, so `return`, `break`, `continue` and `?` cannot leave them; a
// loop inside one may be left as usual.

first(xs: List[int]) -> List[int]
    for x in xs yield
        if x > 2 then return xs
        x

count(xs: List[int]) -> int
    var n = 0
    while n < 3
        val ys = for x in xs if x > 0 yield
            if x > 2 then break
            x
        val zs = for x in xs if (if x > 1 then continue else true) yield x
        n += 1
    n

defined(xs: List[int]) -> List[int]
    for x in xs, y = (if x > 2 then return xs else x) yield y

inner(xs: List[int]) -> List[int]
    for x in xs yield
        var total = 0
        for i in 0 ..< x
            if i > 5 then break
            total += i
        total

lift(xs: List[Option[int]]) -> Option[List[int]]
    Some(for x in xs yield x?)

main()
    print(first([1]))
