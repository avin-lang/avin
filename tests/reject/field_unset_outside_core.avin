// error: `field_unset` is an intrinsic of the core library
// A field the class fills itself, left unset by the constructor and free of the class's variance, is
// the core library's means for its own cells, which only its code declares.

@intrinsic("field_unset")
private unset[T]() -> T

class Cell[+T]
    private var item: T = unset()

main()
    println(Cell[int]() is Cell)
