// error: `B` is not part of `(A) -> int`; each of an impl's type parameters is, so a call learns it from the receiver's type
// error: `+` is the language's operator on (A, B), and no method can redefine it
// error: `make` is static, which only a type's own member is; an impl adding to `(A, B)` adds methods of values
// error: `both` is already added to `(A, A)` with the same parameter types; a method's overloads differ in their parameter types
// error: `swap` is ambiguous on (int, int): module `avin` and the root module each add it with the same parameter types, and this file sees both
// An impl adding to tuples or functions follows the rules of any impl adding to a type built from its
// parameters: each parameter is part of the type, no operator of a tuple is redefined, no static
// member is added, an overload differs in its parameter types, and a method the core library already
// adds makes a call that sees both ambiguous.
impl[A, B] (A) -> int
  first() -> int = 1

impl[A, B] (A, B)
  +(other: (A, B)) -> (A, B) = other
  static make() -> int = 1
  swap() -> (B, A) = (self.1, self.0)

impl[A] (A, A)
  both() -> int = 2
  both() -> int = 3

main()
  println((1, 2).swap())
