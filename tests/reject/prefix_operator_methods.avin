// error: a prefix `!` on bool is the language's own, and no method can define it; only a data type, a class or a trait has a method `!` taking no argument
// error: a prefix `~` on string is the language's own, and no method can define it; only a data type, a class or a trait has a method `~` taking no argument
// error: a prefix `+` on int is the language's own, and no method can define it; only a data type, a class or a trait has a method `+` taking no argument
// error: expected bool, found Cond
// error: expected bool, found Cond
// The built-in types keep their prefix operators, which no method defines; and a `!` that yields
// something other than a `bool` is not a condition of an `if` or a `while`.
data Cond(text: string)

impl Cond
  !() -> Cond = Cond(s"NOT $text")

impl bool
  !() -> bool = self

impl string
  ~() -> string = self

impl int
  +() -> int = self

main()
  val c = Cond("x")
  if !c then println(1)
  while !c
    println(2)
