// error: state `Bare` of `Shared` does not handle `A` where the guard is false, `B(-1)` where the guard is false or `C` where the guard is false
// error: state `Partial` of `Shared` does not handle `B(-1)` where the guard is false or `C` where the guard is false
// error: state `Nothing_` of `Empty` does not handle `A`, `B(_)` or `C`
// The shared `receive` arms count toward every state, after its own, and a guarded shared arm counts
// for none; a state with no arms and no shared ones handles nothing.
data Ev
  A
  B(n: int)
  C

machine Shared receives Ev
  var on = true

  state Bare

  state Partial
    A -> stay

  state Full
    _ -> Bare

  receive
    B(0) -> stay
    _ if on -> stay

machine Empty receives Ev
  state Nothing_
  state Other
    A | B(_) | C -> stay

main() -> int = 0
