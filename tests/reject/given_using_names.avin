// An implementation's contextual parameter has its trait method's name, the one a call passes it
// by; and a binding to foreign code takes no `using` section, its parameters being the foreign
// function's.
// error: whose contextual parameter is named `tx`, not `transaction`: a call passes it by that name
// error: a `@sysl` binding takes no `using` section: its parameters are the foreign function's

data Tx(id: int)

trait Store
  drop(key: string, using tx: Tx) -> int

class Plain: Store
  override drop(key: string, using transaction: Tx) -> int = 0

@sysl("sysl.math.abs")
abs(n: int, using tx: Tx) -> int

main() = 0
