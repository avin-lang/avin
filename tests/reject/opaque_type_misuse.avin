// error: `<` needs UserId to implement `Ord`
// error: `UserId` does not implement `Display`, so it cannot be interpolated
// error: `UserId` takes 1 argument, not 2
// error: expected long, found string
// error: `Tag` takes 1 type argument, not 0
// An opaque type has only the traits its impls give it, so `<` and interpolation need impls; making
// one takes exactly one argument of its representation, and a generic one takes its type arguments.
opaque type UserId = long
opaque type Tag[T] = Vector[T]

main()
  val u = UserId(1)
  println(u < u)
  val s = s"$u"
  println(UserId(1, 2))
  println(UserId("s"))
  val t: Tag = Tag([1])
