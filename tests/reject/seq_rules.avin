// A `Seq` reads its elements and cannot change them, whatever sequence it holds; `::` takes apart only
// a list; a sequence is a function from an `int` index and from nothing else; and a deque, being
// mutable, is not covariant.

open class Animal(val name: string)
class Dog(n: string): Animal(n)

main()
  val d: Deque[int] = [1, 2]
  val s: Seq[int] = d
  s(0) = 5
  s.append(3)
  val v = [1, 2]
  v match
    x :: _ -> println(x)
    _ -> ()
  val f: (string) -> int = v
  val dogs: Deque[Dog] = [Dog("rex")]
  val animals: Deque[Animal] = dogs
