@sysl("sysl.text.to_lower")
lower(s: int | string) -> string

@sysl("sysl.text.to_lower")
lowerInto(s: string) -> string | bool

@sysl("sysl.time.YearMonthDay")
data Civil(year: int | real)

@c("int abs(int x)")
absolute(x: long | string) -> int

@c(struct: "as_point")
data Point(x: real | bool, y: real)

main() = 0
