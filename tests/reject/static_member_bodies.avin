// error: `zero` is static: it belongs to the type, not to a value, so it has no `self`
// error: `zero` is static: it belongs to the type, not to a value, so it has no `self` and cannot use the members of a value
// error: `one` is static: it belongs to the type, not to a value, so it has no `self` and cannot use the members of a value
// error: `Self.zero()` cannot be called in a trait's default body, which every type implementing the trait shares; a function bounded by the trait calls it, as `T.zero()`
// A static member works on no value: its body has no `self`, neither written nor implicit, and a
// trait's default body, shared by every type implementing the trait, has no one type to call one on.

data Cell(n: int)

impl Add for Cell
  add(other: Cell) -> Cell = Cell(n + other.n)
  static zero() -> Cell = self

data Purse(cents: int)

impl Add for Purse
  add(other: Purse) -> Purse = Purse(cents + other.cents)
  static zero() -> Purse = Purse(cents)

class Scale(val k: int): Mul
  override multiply(other: Scale) -> Scale = Scale(k * other.k)
  override static one() -> Scale = multiply(Scale(1))

trait Counted: Add
  count() -> Self = Self.zero()

main() = ()
