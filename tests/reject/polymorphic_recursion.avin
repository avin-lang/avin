// error: each round of the cycle `depth` -> `depth` passes `Nest[T]` for `T`, so its type arguments grow without end
// error: each round of the cycle `ping` -> `pong` -> `ping` passes `Nest[T]` for `U`
// error: each round of the cycle `swap` -> `swap` passes `(A, A)` for `B`
// error: each round of the cycle `wrap` -> `wrap` passes `(T) -> int` for `T`
// A generic function whose calls of itself, directly or through others, grow its type arguments:
// wrapped in a data type, swapped with a tuple of another, or inside a function type.

data Nest[T](x: T)

depth[T](x: T, n: int) -> int = if n == 0 then 0 else depth(Nest(x), n - 1)

ping[T](x: T, n: int) -> int = if n == 0 then 0 else pong(Nest(x), n - 1)

pong[U](y: U, n: int) -> int = if n == 0 then 1 else ping(y, n - 1)

swap[A, B](a: A, b: B, n: int) -> int = if n == 0 then 0 else swap(b, (a, a), n - 1)

wrap[T](f: (T) -> int, n: int) -> int = if n == 0 then 0 else wrap((g: (T) -> int) -> 0, n - 1)

main() -> int
  depth(1, 3) + ping("a", 3) + swap(1, true, 3) + wrap((x: int) -> x, 3)
