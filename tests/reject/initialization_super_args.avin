// error: a lambda that captures `self` is made in a superclass's arguments, which run before the object is initialized
// error: a lambda that captures `self` is made in a superclass's arguments, which run before the object is initialized
// error: `name` is a method of the object, which a superclass's arguments cannot use as a value: they run before the object is initialized
// error: an argument passed by name uses `self` in a superclass's arguments, which run before the object is initialized
// error: a lambda that captures `self` is made in a superclass's arguments, which run before the object is initialized
open class Text(f: () -> string)
  val got: string = f()

// A lambda reading the class's own field, which is set only after the superclass's constructor.
class Own: Text(() -> s)
  val s: string = "own"

// A lambda reading a field the class inherits, which the superclass sets after calling it.
open class Mid(f: () -> long)
  val got: long = f()
  val m: long = 9
class Leaf: Mid(() -> m)

// A method of the object, named as a value.
class Named: Text(name)
  val s: string = "named"
  name() -> string = s

// An argument passed by name, evaluated by `pick` while the superclass's arguments run.
pick(flag: bool, v: -> long) -> long = if flag then v else 0
open class Holder(val got: long)
class Late: Holder(pick(true, s * 2))
  val s: long = 21

// An object's arguments to the class it extends.
object Single: Mid(() -> k)
  val k: long = 1234

main()
  println(Own().got)
  println(Leaf().got)
  println(Named().got)
  println(Late().got)
  println(Single.got)
