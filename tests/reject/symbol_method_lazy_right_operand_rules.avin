// error: `fibs` is needed by its own initializer, directly or through the functions it calls
// error: `break` cannot leave a delayed argument, which is evaluated where its parameter is read
// error: `int` has no method `#::` to call infix
// error: `continue` cannot leave a delayed argument, which is evaluated where its parameter is read
val fibs: LazyList[long] = 0 #:: 1 #:: fibs.zip(fibs.tail).map((a, b) -> a + b)

// A companion's operator with a strict right operand is not called infix.
object Strict
  #::(x: int, rest: int) -> int = x + rest

class Bag(val items: Vector[int])
  #::(x: int) -> Bag = Bag(x +: items)

loops(bag: Bag) -> Bag
  var out = bag
  while true
    out = 1 #:: (break)
  for i in 0 ..< 3
    out = i #:: (continue)
  out

main() =
  println(1 #:: 2)
  println(fibs)
