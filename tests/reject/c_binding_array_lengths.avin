// `length(data)` names a pointer parameter passed in, which no other parameter's length names, and
// marks an integer passed in or an `inout` pointer to one, never an `out` one.
// error: and this one is not: `length(q)` names no parameter of the prototype
// error: and this one is not: a length is filled in from the array `p`, so `length(p)` marks a parameter passed in, or an `inout` pointer C writes the length it used through, not an `out` one
// error: and this one is not: `length(p)` marks the parameter carrying the length of `p`, which is an integer, and `double` is not one
// error: and this one is not: the length of `p` is carried by one parameter, and two say `length(p)`
// error: and this one is not: `x` is `int`, and an array is passed as a pointer to its elements, as in `uint8_t *x`

@c("int f(const int *p, length(q) int n)")
noSuchArray(p: Array[int]) -> int

@c("int f(const int *p, length(p) out int *n)")
outLength(p: Array[int]) -> int

@c("int f(const int *p, length(p) double n)")
realLength(p: Array[int]) -> int

@c("int f(const int *p, length(p) int n, length(p) int m)")
twoLengths(p: Array[int]) -> int

@c("int f(int x, length(x) int n)")
scalarArray(x: int) -> int

main() = 0
