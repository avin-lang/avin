// error: but it captures `a`, a `lazy val` whose initializer captures `n`, a `var`, which the closure would share with the code that made it
// error: but it captures `b`, a `lazy val` whose initializer uses `items`, a `Buffer[int]`, which is mutable
// error: through `bump` it reaches `hits`, a module-level `var`, which every thread would share
// error: but it uses `d`, a `Buffer[int]`, which is mutable; an immutable copy (`toVector`) is sendable
// error: but it captures `outer`, a `lazy val` whose initializer captures `inner`, a `lazy val` whose initializer captures `m`, a `var`
// A closure carried to another thread that captures a local `lazy val` carries its initializer with
// it, which runs wherever the value is first read. So the value's type must be sendable, and what its
// initializer captures and reaches is held to the rules for a thread's body, through every lazy value
// it reads in turn.
import avin.threads.spawn

var hits = 0

bump() -> int
  hits += 1
  hits

main()
  var n = 1
  lazy val a = n + 1
  spawn(() -> println(a)).join()
  val items = Buffer[int]()
  lazy val b = items.length
  spawn(() -> println(b)).join()
  lazy val c = bump()
  spawn(() -> println(c)).join()
  lazy val d: Buffer[int] = Buffer[int]()
  spawn(() -> println(d.length)).join()
  var m = 2
  lazy val inner = m * 2
  lazy val outer = inner + 1
  spawn(() -> println(outer)).join()
