// A static member taken as a value through a bound: its `using` section is filled where it is taken,
// so with no given there and no default it is an error; the value takes the parameters before the
// section; the expected type is checked against them; a trait the parameter is bounded by at several
// type arguments has one member per instance, which only a call's arguments choose between.
// error: `tagged` needs a `Tx` for `tx`, and no given of that type is in scope
// error: this function takes 1 argument, not 2
// error: expected (string) -> T, found (int) -> T
// error: `T` is bounded by several instances of `Make`, whose `make` only a call's arguments choose between, so `T.make` is no function value; write a lambda, as in `x -> T.make(x)`

class Tx(val id: int)

trait Parse
  static tagged(n: int, using tx: Tx) -> Self

trait Make[E]
  static make(source: E) -> Self

noGiven[T: Parse]() = T.tagged

sectionTaken[T: Parse]()
  given tx = Tx(1)
  val f = T.tagged
  f(1, tx)

wrongType[T: Parse]()
  given tx = Tx(1)
  val f: (string) -> T = T.tagged

several[T: Make[int] & Make[string]]() = T.make

main() = ()
