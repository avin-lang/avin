// What a `@threaded` callback captures counts whatever reaches it: a `var` a local function it calls
// captures, a parameter of the enclosing function, and a `val` holding a mutable object.
// error: the function passed to `f` of `share`, which Sysl may call from any thread, captures `seen`, a `var`, which that thread would share with the code here; capture a `val` holding its value
// error: `Array[string]` does not conform to `Sendable`, captured as `names` by the function passed to `f` of `share`, which Sysl may call from any thread: it is mutable; an immutable copy (`toVector`) is sendable
// error: `Tally` does not conform to `Sendable`, captured as `t` by the function passed to `f` of `share`, which Sysl may call from any thread: its field `n` is a `var`; make it a `val`

@sysl("avintest.callbacks.share")
share(@threaded f: (int) -> int)

class Tally(var n: int)

viaLocal()
    var seen = 0
    note(x: int) -> int
        seen += x
        seen
    share(x -> note(x))

viaParameter(names: Array[string]) = share(x -> x + names.length)

main()
    viaLocal()
    viaParameter(["a"].toArray())
    val t = Tally(2)
    share(x -> x + t.n)
