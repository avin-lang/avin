// error: the `lazy val` `direct` needs its own value to initialize: `direct` → `direct`
// error: the `lazy val` `named` needs its own value to initialize: `named` → `named`
// error: the `lazy val` `outside` needs its own value to initialize: `outside` → `outside`
// error: the `lazy val` `bridge` needs its own value to initialize: `bridge` → `bridge`
// error: the `lazy val` `viaModule` needs its own value to initialize: `viaModule` → `viaModule`
// An object has one instance, so every read through its name is of the same object: its lazy field
// is refused when its initializer reads it by bare name, through the object's name, in a function
// outside the body that reads it by name, and through a module-level `lazy val` that reads it, which
// is the module-level value's own cycle as well.
object Direct
  lazy val direct: int = direct + 1

object Named
  lazy val named: int = Named.named * 2

object Outside
  lazy val outside: int = helper()

helper() -> int = Outside.outside + 1

lazy val bridge: int = ViaModule.viaModule + 1

object ViaModule
  lazy val viaModule: int = bridge * 2

main() = ()
