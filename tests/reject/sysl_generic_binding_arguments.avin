// A generic binding is called only at `Boundary` types, each one Sysl type: a class, a data type
// that mirrors nothing, a collection, a function and a Sysl handle are refused at the call, and
// wherever a generic handle is given them.
// error: `Plain` does not conform to `Boundary`, the bound of `T` in `same`; a value crosses to Sysl as one Sysl type where it is an integer of 8, 16, 32 or 64 bits, `byte`, `real`, `char`, `bool`, `unit`, `string`, a data type declared with `@sysl` to mirror a Sysl enum or struct, or an `Option`, a `Result` or a tuple of these
// error: `Shape` does not conform to `Boundary`, the bound of `T` in `same`
// error: `Option[Vector[int]]` does not conform to `Boundary`, the bound of `T` in `same`
// error: `(int, (int) -> int)` does not conform to `Boundary`, the bound of `T` in `same`
// error: `Handle` does not conform to `Boundary`, the bound of `T` in `Signal`

@sysl("pkg.values.same")
same[T: Boundary](x: T) -> T

@sysl("pkg.values.Signal")
class Signal[T: Boundary]
    read() -> T

@sysl("pkg.values.Handle")
class Handle

class Plain(n: int)

data Shape
    Circle(r: int)

holds(s: Signal[Handle]) = ()

main()
    same(Plain(1))
    same(Circle(1))
    val v: Option[Vector[int]] = None
    same(v)
    same((1, (x: int) -> x))
