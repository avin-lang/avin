// error: `Boxing.map` does not implement `Mappable.map` for `Boxing`, whose parameter `f` takes (T) -> Any, and (T) -> B is not one without a conversion
// error: `HashMap` does not implement `map` from `Mappable`; implement it in an impl of `Mappable`
// error: `Outside.map` does not implement `Mappable.map` for `Outside`, which yields Option[B], and Outside[B] is wanted, which it is not without a conversion
// A meeting that needs a conversion of a function's result is refused; a type with no method of the
// name implements it in the impl; and one declared outside the impl that does not meet is reported at
// the impl.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

trait Chainable[A]
  flatMap[B](f: (A) -> Self[B]) -> Self[B]

data Boxing[T](value: T)

impl Mappable for Boxing
  map[B](f: (T) -> Any) -> Boxing[B] = todo()

impl[K, V] Mappable[V] for HashMap[K, V]

data Lowly[T](value: T)

impl Chainable for Lowly
  flatMap[B, C >: int](f: (T) -> Lowly[B]) -> Lowly[B] = f(value)

data Outside[T](value: T)

impl[T] Outside[T]
  map[B](f: (T) -> B) -> Option[B] = Some(f(value))

impl Mappable for Outside

main()
  println(1)
