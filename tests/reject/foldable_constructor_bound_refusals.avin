// error: `Mapping` is a constructor trait, so it requires only traits that bound constructors, and `Same` is a trait for types
// error: `Same` names `Self` beyond the receiver or has a static member, or requires a trait that does, so it bounds types and not constructors, and `F` is a constructor
// error: `Made` names `Self` beyond the receiver or has a static member, or requires a trait that does, so it bounds types and not constructors, and `F` is a constructor
// error: `Leaning` names `Self` beyond the receiver or has a static member, or requires a trait that does, so it bounds types and not constructors, and `F` is a constructor
// error: `Wrapped` is a constructor trait, so it is a bound of a constructor, as in `[F[_]: Wrapped]`, and not a type
// A trait for types bounds a constructor only where its members never name `Self` beyond the
// receiver and it has no static member, nor requires a trait that does; and a trait whose methods
// write `Self[X]` is a constructor trait only, never a type.
trait Same[A]
  same(other: Self) -> bool

trait Made[A]
  static made() -> int

trait Wrapped[A]
  wrap() -> Self[A]

trait Leaning[A]: Same[A]
  lean() -> int

trait Mapping[A]: Same[A]
  remap[B](f: (A) -> B) -> Self[B]

viaSame[F[_]: Same](x: F[int]) -> int = 0

viaMade[F[_]: Made](x: F[int]) -> int = 0

viaLeaning[F[_]: Leaning](x: F[int]) -> int = 0

asType(w: Wrapped[int]) -> int = 0

main()
  println(0)
