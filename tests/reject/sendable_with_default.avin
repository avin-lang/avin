// error: what is passed for `f` of `Map.withDefault` may use only sendable values from around it, but it uses `buf`, a `Buffer[string]`, which is mutable
// error: what is passed for `f` of `Map.withDefault` may use only sendable values from around it, but it captures `calls`, a `var`
// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it uses `shared`, a `Map[string, Buffer[int]]`, whose type argument `Buffer[int]` is mutable
// error: what is passed for `f` of `Map.withDefault` may use only sendable values from around it, but it uses `seen`, a `Buffer[string]`, which is mutable
// `Map` promises `Sendable`, so a map's default must be sendable too: `withDefault` takes a
// `@sendable` function, which may not use a mutable value from around it nor a `var`, and a
// `withDefaultValue` map of a mutable value is not sendable. A thread whose default appended to a
// captured buffer once raced with the code that made the map.
import avin.threads.spawn

main()
  val buf = Buffer[string]()
  val m: Map[string, int] = Map(("a", 1)).withDefault(k ->
    for i in 0 ..< 10 do buf.append(s"$k$i")
    0)
  val t = spawn(() -> m("missing"))
  println(t.join())
  var calls = 0
  val counted = HashMap(("a", 1)).withDefault(k ->
    calls += 1
    k.byteLength)
  println(counted("abc"))
  val shared = Map(("a", Buffer[int]())).withDefaultValue(Buffer[int]())
  val u = spawn(() -> shared("a").length)
  println(u.join())
  val generic = wrapped(TreeMap((1, "x")), buf)
  println(generic(2))

wrapped[K, V](m: Map[K, V], seen: Buffer[string]) -> Map[K, V] = m.withDefault(k ->
  seen.append("miss")
  m.head.1)
