// error: `size` is called before `last` is initialized
// error: `self` is passed, stored or returned before `last` is initialized
// error: an argument passed by name uses `self` before `last` is initialized
// An argument an overload chosen strictly evaluates at the call is held to the rules of an argument
// written in place: it may read initialized fields, and may not call a method or pass `self` before
// every field is initialized. Where the overload chosen takes it by name, it stays delayed, and a
// delayed argument reaching `self` is refused as before.
pick(n: int) -> int = n
pick[T](n: -> T) -> int = 1

keep(r: Early) -> int = 0
keep[T](r: -> T) -> int = 1

class Early(seed: int)
  val first = pick(seed)
  val second = pick(size())
  val third = keep(self)
  val fourth = pick(s"${first}")
  val last = 3

  size() -> int = last

main() -> int = 0
