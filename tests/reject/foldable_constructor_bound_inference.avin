// error: `Foldable` is a bound for a constructor of one argument, and `F` takes two arguments
// error: cannot infer `F` from `Ints`: `Ints` implements `Countable` as `Countable[int]`, at no parameters of its own, so it is no constructor implementing it; a constructor implements it at its parameters, as in `impl[T] Countable[T] for Box[T]`
// error: cannot infer `F` from `Pair[int, int]`: `Pair` implements `Countable` as `Countable[int]`, at no parameters of its own, so it is no constructor implementing it
// error: `TreeSet` bounds its parameter `A` by `Ord`, and `F` may be applied to any type, so `TreeSet` is no constructor for `F[_]`
// error: cannot infer `F` from `int`: `F[_]` takes a constructor of one argument, such as `Option`, and `int` is no data type, class or trait
// A trait for types bounds a constructor of as many holes as it has parameters, and a type is a
// constructor of it only where it conforms at its own parameters; a type whose parameter is bounded
// is one only for a hole promising that bound, as for a constructor trait.
trait Countable[A]
  count() -> int

class Ints(val n: int)

impl Countable[int] for Ints
  count() -> int = n

data Pair[A, B](a: A, b: B)

impl[A, B] Countable[int] for Pair[A, B]
  count() -> int = 2

counted[F[_]: Countable](x: F[int]) -> int = x.count()

summed[F[_]: Foldable](xs: F[int]) -> int = xs.foldLeft(0, (a, b) -> a + b)

twoHoles[F[_, _]: Foldable](x: F[int, int]) -> int = 0

main()
  println(counted(Ints(1)))
  println(counted(Pair(1, 2)))
  println(summed(TreeSet(1)))
  println(summed(7))
