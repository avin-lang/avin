// error: expected Iterable[Any], found Vector[int]
// error: expected Iterable[Any], found Seq[int]
// error: expected Vector[Any], found Vector[int]
// The print functions take `Any*`, and a sequence of numbers is not a sequence of `Any`, since a
// value is never boxed inside a container: such a sequence is printed whole, or spread once it holds
// `Any`.

main()
  val v: Vector[int] = [1, 2]
  val xs: Seq[int] = v
  println(v*)
  print(xs*)
  val p = println
  p(v)
