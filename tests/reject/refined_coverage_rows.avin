// error: this arm is never reached: the arms before it already match every value it would
// error: this clause is never reached: `ILit` needs `T` to be `int`, and `BLit` in the same clause needs it to be `bool`
// error: this pattern never matches: `BoolLit` makes an `Expr[bool]`, and the value matched is an `Expr[int]`
// error: this arm is never reached: `BLit` makes a `Lit[bool]`, and the value matched is a `Lit[int]`
// error: this pattern never matches: `BLit` makes a `Lit[bool]`, and the value matched is a `Lit[int]`
// Unreachable arms and patterns over refined variants. Once the variants possible at the instance are
// covered, a `_` after them is never reached. A clause's arguments form one row, an `is` test's
// pattern is checked like an arm's, an enclosing arm's equalities hold in a nested `match`, and each
// of a set of alternatives must be possible on its own.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  BoolLit(value: bool) -> Expr[bool]
  Add(a: Expr[int], b: Expr[int]) -> Expr[int]
  If(cond: Expr[bool], yes: Expr[T], no: Expr[T])

data Lit[T]
  ILit(value: int) -> Lit[int]
  BLit(value: bool) -> Lit[bool]

after(e: Expr[int]) -> int = e match
  IntLit(n) -> n
  Add(_, _) -> 0
  If(_, _, _) -> 1
  _ -> 2

clauses[T](a: Lit[T], b: Lit[T]) -> int
clauses(ILit(_), BLit(_)) = 0
clauses(_, _) = 1

tested(e: Expr[int]) -> int = if e is BoolLit(b) then 1 else 0

nested[T](a: Lit[T], b: Lit[T]) -> int = a match
  ILit(x) -> b match
    ILit(y) -> x + y
    BLit(_) -> 0
  BLit(_) -> 0

alternatives(e: Lit[int]) -> int = e match
  ILit(_) | BLit(_) -> 0

main()
  ()
