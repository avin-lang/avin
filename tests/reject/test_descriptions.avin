// error: `@test` takes a description, a string that is not empty, or nothing, and then `numbered` names the test
// error: `@test` takes a description, a string that is not empty, or nothing, and then `blank` names the test
// error: `@test` has no argument `name`: it takes a description, then `should_trap`, `timeout` and `ignore`
// error: `@test` takes a description, a string that is not empty, or nothing, and then `describedLast` names the test
// error: `@test` takes `timeout` once
// `@test` names a test after its function, and `@test("a sentence")` by the sentence, written first;
// nothing else is a name, and each of the arguments after it is said once.

@test(3)
numbered()
    assert(true)

@test("")
blank()
    assert(true)

@test(name: "named")
named()
    assert(true)

@test(should_trap, "a sentence")
describedLast()
    assert(true)

@test(timeout: 1, timeout: 2)
twice()
    assert(true)

main() = 0
