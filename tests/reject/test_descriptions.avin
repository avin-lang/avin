// error: `@test` takes a description, a string that is not empty, or nothing, and then `numbered` names the test
// error: `@test` takes a description, a string that is not empty, or nothing, and then `blank` names the test
// error: `@test` takes a description, a string that is not empty, or nothing, and then `named` names the test
// `@test` names a test after its function, and `@test("a sentence")` by the sentence; nothing else
// is a name.

@test(3)
numbered()
    assert(true)

@test("")
blank()
    assert(true)

@test(name: "named")
named()
    assert(true)

main() = 0
