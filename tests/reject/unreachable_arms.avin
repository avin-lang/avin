// error: this arm is never reached: the arm `_` on line 16 already matches every value it would
// error: this arm is never reached: the arm `t` on line 20 already matches every value it would
// error: this arm is never reached: the arm `Live` on line 25 already matches every value it would; `Live` binds a new value there, since no variant `Live` is in scope
// error: this arm is never reached: the arms before it already match every value it would
// error: this arm is never reached: the arms before it already match every value it would
// An arm no value can reach is an error, naming the earlier arm that already matches every value it
// would: one after `_`, one after a binding, one after a name spelled as a variant that is not in
// scope (which binds), and ones covered by earlier variant
// or literal arms together.
data Phase
  Open
  Closing
  Closed

afterWildcard(n: int) -> int = n match
  _ -> 0
  1 -> 1

afterBinding(s: string) -> int = s match
  t -> 0
  "a" -> 1

phaseCode(p: Phase) -> int = p match
  Closing -> 1
  Live -> 2
  Closed -> 3

coveredByVariants(o: Option[int]) -> int = o match
  Some(n) -> n
  None -> 0
  _ -> -1

flag(b: bool) -> int = b match
  true -> 1
  false -> 0
  _ -> -1

main() = ()
