// error: each round of the cycle `Box.compare` -> `Box` -> `Box.compare` passes `Wide[T]` for `T`
// error: each round of the cycle `Cell.show` -> `Cell` -> `Cell.show` passes `Shown[T]` for `T`
// error: each round of the cycle `widen` -> `Pair` -> `Pair.compare` -> `widen` passes `Wide[U]` for `T`
// error: each round of the cycle `Duo.compare` -> `Duo` -> `Duo.compare` passes `(T, T)` for `T`
// A method an impl with bounds of its own adds is still needed at every type argument that meets
// them, so a method building a larger instance of its type at such an argument grows without end:
// directly, through a trait's own, through generic code, and through a tuple, which is ordered when
// its parts are.

trait Show
    show() -> string

data Wide[T](value: T) derives Ord

data Shown[T](value: T)

impl Show for int
    show() -> string = s"#$self"

impl[T: Show] Show for Shown[T]
    show() -> string = value.show()

data Box[T](value: T)

impl[T: Ord] Ord for Box[T]
    compare(other: Box[T]) -> int
        val wider = Box(Wide(value))
        value.compare(other.value)

data Cell[T](value: T)

impl[T: Show] Show for Cell[T]
    show() -> string
        val wider = Cell(Shown(value))
        value.show()

data Pair[T](value: T)

widen[U: Ord](u: U) -> Pair[Wide[U]] = Pair(Wide(u))

impl[T: Ord] Ord for Pair[T]
    compare(other: Pair[T]) -> int
        val wider = widen(value)
        value.compare(other.value)

data Duo[T](value: T)

impl[T: Ord] Ord for Duo[T]
    compare(other: Duo[T]) -> int
        val wider = Duo((value, value))
        value.compare(other.value)

main()
    println(Box(1) < Box(2))
    // A cell shown as a `Show` is shown through its method table, which a cell of a `Shown` has too.
    val s: Show = Cell(1)
    println(s.show())
