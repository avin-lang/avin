// error: this branch yields Sink[string], not the Sink[B] expected of the `if`
// error: this arm yields Sink[string], not the Sink[B] expected of the `match`
// error: this branch yields Inv[A], not the Inv[B] expected of the `if`
// error: expected Sink[B], found Display
// error: the branches of this `if` agree on no type: `(B) -> int` and `(string) -> int`; to keep either, declare the type it yields, such as `((B) -> int) | ((string) -> int)`

// Two instances that differ at a contravariant argument where neither argument is a subtype of the
// other have no meet, so they agree on no instance: with nothing expected they fall back to a trait
// they share, and where an instance is expected, the branch or arm that is not one is named. An
// invariant argument that differs still has no join, and a function type's parameters follow the
// contravariant rule.
open class A
class B: A
class Sink[-T](val f: (T) -> int)

impl[T] Display for Sink[T]
  display(out: Writer, spec: FormatSpec) = out.write("sink")

class Inv[T](val x: T)

impl[T] Display for Inv[T]
  display(out: Writer, spec: FormatSpec) = out.write("inv")

bSink() -> Sink[B] = Sink(b -> 2)

strSink() -> Sink[string] = Sink(s -> s.byteLength)

wrong(c: bool) -> Sink[B] = if c then bSink() else strSink()

wrongArm(n: int) -> Sink[B] = n match
  0 -> bSink()
  _ -> strSink()

invA() -> Inv[A] = Inv(B())

invB() -> Inv[B] = Inv(B())

invariant(c: bool) -> Inv[B] = if c then invA() else invB()

main()
  val c = true
  val shared = if c then bSink() else strSink()
  val s: Sink[B] = shared
  val fb: (B) -> int = b -> 1
  val fs: (string) -> int = x -> 2
  val g = if c then fb else fs
