// error: `Plain` does not conform to `Ordered`, the bound of `T` in `max`
// error: `twice` is not a member of `Ordered`, the bound of `T`
// error: `Ordered` mentions `Self`, so it is a bound, as in `[T: Ordered]`, and not a type
// error: `Cost.less` implements `Ordered.less`, whose parameter `other` is Cost, not Plain
// error: `Plain` does not conform to `Ordered`, the bound of `T` in `Holder`
trait Ordered
    less(other: Self) -> bool

class Money(val cents: int): Ordered
    override less(other: Money) -> bool = cents < other.cents

class Plain(val n: int)

class Holder[T: Ordered](value: T)

max[T: Ordered](a: T, b: T) -> T = if a.less(b) then b else a

doubled[T: Ordered](a: T) -> T = a.twice()

keep(x: Ordered) -> int = 0

data Cost(amount: int)

impl Ordered for Cost
    less(other: Plain) -> bool = true

wrapped(h: Holder[Plain]) -> int = 0

main()
    max(Plain(1), Plain(2))
