// An `Array` or a `Vector` crosses to Sysl only when its elements do, however deep they are.
// error: `Array[Shape]` cannot cross to Sysl; a binding's parameters and result are integers of 8, 16, 32 or 64 bits, `byte`, `real`, `char`, `bool`, `unit`, `string`, data types declared with `@sysl` to mirror a Sysl enum or struct, and `Array`, `Vector`, `Option` and `Result` of these
// error: `Vector[(int, int)]` cannot cross to Sysl
// error: `Vector[i24]` cannot cross to Sysl
// error: `Vector[Vector[Shape]]` cannot cross to Sysl
// error: `Option[Array[Shape]]` cannot cross to Sysl

data Shape
    Circle(r: int)
    Square(side: int)

@sysl("sysl.hint.black_box")
shapes(a: Array[Shape]) -> string

@sysl("sysl.hint.black_box")
pairs(s: string) -> Vector[(int, int)]

@sysl("sysl.hint.black_box")
odd(v: Vector[i24]) -> string

@sysl("sysl.hint.black_box")
deepShapes(s: string) -> Vector[Vector[Shape]]

@sysl("sysl.hint.black_box")
maybeShapes(o: Option[Array[Shape]]) -> string

main() = 0
