// Of the collections, only an array of bytes crosses to Sysl, and an `Option` or a `Result` crosses
// only when what it holds does.
// error: `Array[int]` cannot cross to Sysl
// error: `Array[string]` cannot cross to Sysl
// error: `Vector[string]` cannot cross to Sysl
// error: `Option[Shape]` cannot cross to Sysl
// error: `Result[string, (int, int)]` cannot cross to Sysl

data Shape
    Circle(r: int)
    Square(side: int)

@sysl("sysl.hint.black_box")
ints(a: Array[int]) -> string

@sysl("sysl.hint.black_box")
strings(a: string) -> Array[string]

@sysl("sysl.hint.black_box")
vector(v: Vector[string]) -> string

@sysl("sysl.hint.black_box")
maybeShape(o: Option[Shape]) -> string

@sysl("sysl.hint.black_box")
pairedResult(s: string) -> Result[string, (int, int)]

main() = 0
