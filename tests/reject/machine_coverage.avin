// error: state `Opened` of `Door` does not handle `Unlock(_)`
// error: state `Locked` of `Door` does not handle `Open`, `Close`, `Lock(_)` or `Unlock(_)` where the guard is false
// error: state `Up` of `Flag` does not handle `false`
// error: state `Any` of `Count` does not handle `-1` where the guard is false
// error: state `One` of `Nested` does not handle `Both(true, None)`
// Every state must handle every event: its own arms and the shared ones together are checked, state
// by state, as a match is, guarded arms not counting. The error names the state, the machine and
// what is left: each variant not covered in full, or for a type without variants a value.
data DoorEvent
  Open
  Close
  Lock(code: int)
  Unlock(code: int)

machine Door receives DoorEvent
  state Closed
    Open -> Opened
    Lock(code) -> Locked(code)
    Close -> stay
    Unlock(_) -> stay

  state Opened
    Close -> Closed
    Open | Lock(_) -> stay

  state Locked(code: int)
    Unlock(c) if c == code -> Closed

machine Flag receives bool
  state Up
    true -> stay

machine Count receives int
  state Any
    n if n > 0 -> stay
    0 -> stay

data Pair
  Both(a: bool, b: Option[int])

machine Nested receives Pair
  state One
    Both(true, Some(_)) -> stay
    Both(false, _) -> stay

main() -> int = 0
