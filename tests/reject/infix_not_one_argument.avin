// error: `put` takes 2 arguments, and only a method of one argument is called infix; write `b.put(1, 2)`
// error: `put` takes 2 arguments, and only a method of one argument is called infix; write `b.put(arguments)`
// error: `size` takes 0 arguments, and only a method of one argument is called infix; write `b.size()`
// An infix call passes one argument. A tuple written after the name is that one argument, not a list
// of two, so a method of two parameters is called with a dot.

class Bag(val n: int)
    size() -> int = n
    put(a: int, b: int) -> int = a + b

pair(b: Bag) -> int = b put (1, 2)

one(b: Bag) -> int = b put 1

none(b: Bag) -> int = b size 3

main() -> int = 0
