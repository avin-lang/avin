// error: `<` cannot compare Option[int] with Option[string]
// error: `<` cannot compare Option[int] with int
// error: `>` cannot compare Opt[string] with Option[_]
// An unknown in one operand's type is settled from the other's only where the two can be one type.

data Opt[T] derives Ord
  Empty
  Full(value: T)

main()
  println(Some(1) < Some("a"))
  println(Some(1) < 2)
  println(Full("x") > None)
