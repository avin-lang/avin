// The empty-list rule holds for the library's methods and for a generic class's, as for a program's
// own; a function value interpolated is refused with the hint to call it; and a method value with
// parameters, which is a value wherever it is named, is still no `Display`.
// error: `iterator` is called with `()`: write `.iterator()`, or a lambda calling it for a function value
// error: `get` is called with `()`: write `b.get()`, or `() -> b.get()` for a function value
// error: `() -> int` does not implement `Display`, so it cannot be interpolated; a function value is never shown: to show what it returns, call it
// error: `(int) -> int` does not implement `Display`, so it cannot be interpolated; a function value is never shown: to show what it returns, call it

class Box[T](item: T)
    get() -> T = item
    add(k: int) -> int = k

main()
    println([3, 1, 2].iterator)
    val b = Box(1)
    println(b.get)
    val f: () -> int = b.get
    println(s"${f}")
    println(s"${b.add}")
