// error: `Source` is named more than once after `:`
// error: `Source` is generic; write its type arguments, as in `Source[int]`
// error: the superclass comes first after `:`, before the traits
// error: expected Sized, found Other
// error: `Mixed` conforms to `Source` twice, as Source[int] and Source[string]
trait Source[T]
    get() -> T

trait Sized
    size() -> int

abstract class Twice: Source[int], Source[string]

class Bare: Source

open class Base

abstract class Late: Sized, Base()

class Other

measure(s: Sized) -> int = s.size()

main()
    print(s"${measure(Other())}")

trait Ints: Source[int]

trait Strings: Source[string]

abstract class Mixed: Ints, Strings
