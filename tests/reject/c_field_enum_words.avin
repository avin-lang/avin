// A field accessor answers or writes an enum mirror itself: never one in an `Option`, since a field
// is never null. A struct mirror is read whole, and not refused.
// error: the field accessor `maybeKind` answers `Option[Kind]`, and a field is read as an integer type, `byte`, `bool`, `real`, an enum mirror, a struct mirror, a string or a handle
// error: the field accessor `setMaybeKind` writes `Option[Kind]`, and a field is written as an integer type, `byte`, `bool`, `real`, an enum mirror or a struct mirror

@c(enum: "enum kind", prefix: "K_")
data Kind
    One
    Two

@c(struct: "struct point")
data Point(x: int, y: int)

@c(type: "struct thing *", release: "free")
class Thing
    @c(field: "kind")
    maybeKind() -> Option[Kind]
    @c(field: "kind")
    setMaybeKind(k: Option[Kind])
    @c(field: "origin")
    point() -> Point

main() = 0
