// A field accessor answers or writes an enum mirror itself: never one in an `Option`, since a field
// is never null, and never a struct mirror, which is read through a binding.
// error: the field accessor `maybeKind` answers `Option[Kind]`, and a field is read as an integer type, `byte`, `bool`, `real`, an enum mirror, a string or a handle
// error: the field accessor `setMaybeKind` writes `Option[Kind]`, and a field is written as an integer type, `byte`, `bool`, `real` or an enum mirror
// error: the field accessor `point` answers `Point`, and a field is read as an integer type

@c(enum: "enum kind", prefix: "K_")
data Kind
    One
    Two

@c(struct: "struct point")
data Point(x: int, y: int)

@c(type: "struct thing *", release: "free")
class Thing
    @c(field: "kind")
    maybeKind() -> Option[Kind]
    @c(field: "kind")
    setMaybeKind(k: Option[Kind])
    @c(field: "origin")
    point() -> Point

main() = 0
