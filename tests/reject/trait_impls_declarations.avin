// error: `size` is already a method of `Named`; an impl adds to a trait only methods the trait does not declare
// error: `shout` overrides nothing; the methods an impl adds to `Named` are not the trait's, so no type implements or overrides them
// error: `label` is already added to `Named` with the same parameter types; a method's overloads differ in their parameter types
// error: `A` is not part of `Box[B]`; each of an impl's type parameters is, so a call learns it from the receiver's type
trait Named
    size() -> int

impl Named
    label() -> string = "named"
    size() -> int = 0
    override shout() -> string = "!"

impl Named
    label() -> string = "again"

trait Box[T]
    get() -> T

impl[A, B] Box[B]
    first() -> int = 0

main() = print(0)
