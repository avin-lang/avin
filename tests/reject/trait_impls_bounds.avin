// error: `mkString` needs `T: Display`, which Seq[T] does not meet
// error: `rank` needs `T: Ord`, which Self does not meet
// error: `Stack` is a trait; an impl of a trait is for a data type, a class, an object or a built-in type
// error: `rank` needs `T: Ord`, which Things does not meet
class Opaque

trait Stack[T]
  top() -> T

impl[T: Ord] Stack[T]
  rank() -> int = 0

// An unconditional impl reaches the conditional one's method only where its bound holds.
impl[T] Stack[T]
  ranked() -> int = rank()

class Things: Stack[Opaque]
  override top() -> Opaque = Opaque()

show[T](xs: Seq[T]) -> string = xs.mkString()

impl Display for Stack

main()
  println(show([1]))
  println(Things().rank())
