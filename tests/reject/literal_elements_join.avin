// error: integer literal does not fit in i8
// error: integer literal does not fit in long
// error: integer literal is not exact as a real; write it with a fraction or exponent
// error: the elements of a collection literal need a common type; int and string have none
// error: the values of a map literal need a common type; string and int have none

// A literal among the elements of a literal takes the type the others decide, so one that does not
// fit that type is an error, and elements with no common type are still reported in the order they
// are written, at the later one, whichever is the literal.

main()
  val narrow = [i8(1), 128]
  val wide = [long(1), 9223372036854775808]
  val inexact = [1.5, 9007199254740993]
  val mixed = [1, "two"]
  val values = {"a": "x", "b": 2}
