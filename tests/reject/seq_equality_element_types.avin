// error: `==` cannot compare Vector[int] with List[string]
// error: `==` cannot compare Buffer[int] with Vector[bool]
// error: `==` cannot compare Vector[int] with int

main()
  val v: Vector[int] = [1, 2]
  val l: List[string] = ["a"]
  val b = Buffer[int]()
  val w: Vector[bool] = [true]
  println(v == l)
  println(b == w)
  println(v == 2)
