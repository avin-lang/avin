// error: `<` cannot compare long with int; write `long(n)`
// error: `==` cannot compare int with long; write `long(n)`
// error: `!=` cannot compare real with int; write `real(n)`
// error: `>=` cannot compare i8 with int; write `int(small)`
// error: `<=` cannot compare int with real; write `real(n)`
// A comparison of two numbers of different types names the conversion as arithmetic does: `==` and
// `!=` too, and each link of a chain.

main()
  val total: long = 10
  val n = 3
  val x = 2.5
  val small: i8 = 1
  println(total < n)
  println(n == total)
  println(x != n)
  println(small >= n)
  println(0 <= n <= x)
