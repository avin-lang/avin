// error: expected Close, found Kept
// A byte sink is not a text sink, nor the reverse; a `ByteWriter` writes bytes, not text; a class
// claiming the trait writes; and the trait promises no `close`.
import avin.io.{ByteWriter, Close, IoError}

class Kept: ByteWriter
  override write(bytes: Array[byte]) -> Result[unit, IoError] = Ok(())

class Silent: ByteWriter

text(w: Writer) = w.write("x")

bytes(w: ByteWriter) -> Result[unit, IoError] = w.write(Array.empty[byte]())

main()
  val k = Kept()
  text(k)
  _ = bytes(StandardOutput)
  _ = k.write("text")
  val c: Close = k
