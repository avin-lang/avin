// A mirror naming a variant its Sysl enum lacks is reported once at the mirror, with Sysl's words
// and none of the shim's names.
// error: the Sysl mirror `Kind` does not match `sysl.fs.Kind`: enum 'sysl.fs.Kind' has no variant 'Folder'
// error: tests/reject/sysl_mirror_wrong_variant.avin:6:1

@sysl("sysl.fs.Kind")
data Kind
  Regular
  Folder
  Symlink
  Special(bits: int)

@sysl("sysl.hint.black_box")
same(k: Kind) -> Kind

main()
  println(s"${same(Regular)}")
