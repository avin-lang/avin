// error: `T` has no method `&`
// error: `T` has no method `<<`
// error: `&` needs two values of one type, not T and int
// The bitwise operators of a type parameter are its methods, unless the bound is `Integer`: `Ord`
// and `Display` give none, and the operands of an integer's own operator share one type.

meets[T: Ord](a: T, b: T) -> T = a & b
shifts[T: Display](a: T) -> T = a << a
mixed[T: Integer](a: T) -> T = a & 3

main()
  println(meets(1, 2))
