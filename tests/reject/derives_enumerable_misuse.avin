// error: `Enumerable` is derived twice
// error: `Twice` already conforms to `Enumerable`; a conformance is stated once
// error: `Plain` has no static member `values`
// error: `Phantom` cannot derive `Enumerable`: it has type parameters, and an enumeration's values are one fixed set of variants
data Color derives Enumerable, Enumerable
  Red
  Green

data Twice derives Enumerable
  One

impl Enumerable for Twice
  static values() -> Vector[Twice] = Vector.empty()
  ordinal() -> int = 0
  name() -> string = ""
  static valueOf(name: string) -> Option[Twice] = None

data Plain
  A
  B

data Phantom[A: Display] derives Ord, Enumerable
  X
  Y

main()
  println(Plain.values())
