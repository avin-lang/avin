// A collection of handles goes into Sysl as an `Array` or a `Vector` that is a binding's parameter,
// a handle's method's included, holding the handles themselves: not a `List`, not a collection of
// collections or of options, not in an `Option`, and not as a callback's answer.
// error: `List[Crc32]` cannot cross to Sysl: a Sysl handle goes back into Sysl by itself, as a parameter or the receiver of its own methods, or as the elements of an `Array` or a `Vector` that is a parameter
// error: `Vector[Vector[Crc32]]` cannot cross to Sysl: a Sysl handle goes back into Sysl by itself, as a parameter or the receiver of its own methods, or as the elements of an `Array` or a `Vector` that is a parameter
// error: `Option[Vector[Crc32]]` cannot cross to Sysl: a Sysl handle goes back into Sysl by itself, as a parameter or the receiver of its own methods, or as the elements of an `Array` or a `Vector` that is a parameter
// error: `Array[Option[Crc32]]` cannot cross to Sysl: a Sysl handle goes back into Sysl by itself, as a parameter or the receiver of its own methods, or as the elements of an `Array` or a `Vector` that is a parameter
// error: `Vector[Crc32]` cannot be a callback's result: a Sysl handle goes back into Sysl only by itself

@sysl("sysl.checksum.Crc32")
class Crc32
  finish() -> long
  absorbRows(rows: Vector[Vector[Crc32]])

@sysl("sysl.hint.black_box")
listed(all: List[Crc32]) -> long

@sysl("sysl.hint.black_box")
maybeMany(all: Option[Vector[Crc32]]) -> long

@sysl("sysl.hint.black_box")
optional(all: Array[Option[Crc32]]) -> long

@sysl("sysl.hint.black_box")
built(f: () -> Vector[Crc32]) -> long

main() = ()
