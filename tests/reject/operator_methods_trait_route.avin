// error: `-` needs Stamp to implement `Neg`
// error: `+` needs two numbers of one type, not int and Stamp
// error: `*` needs Stamp to implement `Mul`
// error: expected int, found Span
// A type's operator is its method of that name where it has one: a prefix `-` needs a method `-`
// taking no argument, the left operand chooses the method, an operator the type has no method for is
// its core trait's, and a method `<` hides the `<` of `Ord` from the operator.
data Stamp(micros: long)

data Span(micros: long) derives Ord

impl Stamp
  +(d: Span) -> Stamp = Stamp(micros + d.micros)
  -(d: Span) -> Stamp = self

impl Span
  <(n: int) -> bool = true

main()
  val s = Stamp(1)
  val c = -s
  val d = 1 + s
  val e = s * s
  val f = Span(1) < Span(2)
