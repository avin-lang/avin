// `A & B` is no type: an intersection of traits is written only as a type parameter's bounds, so a
// parameter, a `val`, a result, a type argument and a lower bound that write one are errors.
// error: `Named & Sized` is not a type: an intersection is written only as a type parameter's bounds, as in `[T: Named & Sized](x: T)`
// error: `Named & Sized & Weighed` is not a type
// error: `Sized & Named` is not a type
// error: `Named & Sized` is not a type
// error: `Named & Sized` is not a type
trait Named
  name() -> string

trait Sized
  size() -> int

trait Weighed
  weigh() -> int

f(x: Named & Sized) -> int = 1

val v: Option[Named & Sized & Weighed] = None

g() -> Sized & Named = g()

h(xs: Vector[(Named & Sized) -> int]) -> int = 1

k[W >: Named & Sized](x: W) -> int = 1

main()
  println(1)
