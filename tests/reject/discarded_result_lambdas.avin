// A lambda whose function type yields `unit` drops what its body yields, so a `Result` there is
// reported: one written for a declared `(int) -> unit`, one passed to `foreach`, the last line of
// a lambda with a block body, and a lambda written inside a deferred statement, which is a function
// of its own and not exempt as the statement is. A local function yielding `unit` is held to the
// rule as a top-level one is. A lambda whose result type is inferred keeps its `Result`, and is no
// discard.
fails(k: int) -> Result[int, string] = if k > 0 then Ok(k) else Err("no")

main()
  val keep = (k: int) -> fails(k)
  println(keep(1).isOk)
  val f: (int) -> unit = k -> fails(k)
  [1, 2].foreach(k -> fails(k))
  [3].foreach(k ->
    println(k)
    fails(k))
  defer
    [4].foreach(k -> fails(k))
  note()
    println("note")
    fails(9)
  note()
  f(1)
