// error: a `defer` is a statement of a block, run when that block is left; it is written on a line of its own in an indented body of a function, a lambda, a branch or a loop
// A `defer` is a statement of an indented block. Written as a value (a one-line function's body, a
// binding's value, an argument), as a one-line branch, or in a class body, which is not a block that
// is left, it is refused, each time with the same message.

g() = println("g")

h() = defer g()

k(c: bool)
    val x = defer g()
    if c then defer g()
    println(defer g())

class Thing()
    defer g()

main() = ()
