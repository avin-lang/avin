// Sysl checks each mirror against the enum or struct it names when a shim converts one, and its
// diagnostics are reported at the mirror; a binding whose `Option` or `Result` does not fit is
// reported at the binding.
// error: the Sysl mirror `Partial` does not match `sysl.fs.IoError`
// error: the Sysl mirror `Mistyped` does not match `sysl.time.Civil`
// error: the Sysl binding `parentCount` does not match `sysl.path.parent`: an integer is made from a Sysl integer, but the value is string

@sysl("sysl.fs.IoError")
data Partial
    NotFound
    Other(code: int)

@sysl("sysl.time.Civil")
data Mistyped
    Mistyped(year: string, month: int, day: int)

@sysl("sysl.time.LocalDate")
data LocalDate
    LocalDate(day: int)

@sysl("sysl.fs.read_text")
readText(file: string) -> Result[string, Partial]

@sysl("sysl.time.days_from_civil")
days(c: Mistyped) -> LocalDate

@sysl("sysl.path.parent")
parentCount(p: string) -> Option[int]

main()
    println(s"${readText("x")} ${days(Mistyped("1970", 1, 1))} ${parentCount("/a")}")
