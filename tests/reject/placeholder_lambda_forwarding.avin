// error: `double(_)` is the function `double` itself; pass it as `double`
// error: `add(_, _)` is the function `add` itself; pass it as `add`
// error: `twice(_)` is the function `twice` itself; pass it as `twice`
// A placeholder lambda that only calls a named function with its parameters in order is that
// function, which is passed by its name.

double(x: int) -> int = x * 2

add(a: int, b: int) -> int = a + b

twice(x: int) -> int = x + x

apply2(f: (int, int) -> int) -> int = f(1, 2)

main() -> int
    val xs = [1, 2, 3]
    println(xs.map(double(_)))
    println(apply2(add(_, _)))
    val g: (int) -> int = twice(_)
    0
