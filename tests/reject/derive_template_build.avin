// A template that builds values cannot derive for an open or an abstract class, whose value could be
// of any subclass; one that only walks values can. A generic type's parameter needs the hook's bound
// where the trait's is not enough.
// error: `Animal` cannot derive `Make`: its template builds values, and `Animal` is open, so a value of its type could be of any subclass
// error: `Plant` cannot derive `Make`: its template builds values, and `Plant` is abstract, so a value of its type could be of any subclass
// error: `Labelled` cannot derive `Make`: field `value` has type `A`, which does not implement `Text`; bound the parameter, as in `[A: Text]`

trait Text
    static parse() -> Self

impl Text for int
    static parse() -> int = 0

trait Make
    static make() -> Result[Self, string]

derive Make for T
    static make() -> Result[T, string] = T.build(Maker(0))

data Maker(n: int)

impl ShapeBuilder[string] for Maker
    variant(t: TypeShape) -> Result[int, string] = Ok(0)
    next(v: VariantShape) -> Result[Option[int], string] = Ok(None)
    duplicate(f: FieldShape) -> string = "twice"

impl Maker
    field[F: Text](f: FieldShape) -> Result[F, string] = Ok(F.parse())
    missing[F: Text](f: FieldShape) -> Result[F, string] = Ok(F.parse())

open class Animal(val legs: int) derives Make

abstract class Plant() derives Make

data Labelled[A](label: int, value: A) derives Make

main() = 0
