// expect: exit 0
// A lazy list's makers, its accessors and its conversions, on the empty list, a one-element list
// and longer ones, at several element types: `head`, `tail`, `headOption`, `isEmpty`, `apply`,
// `lift`, `length`, `knownSize`, `isEvaluated`, `+:`, the methods every `Iterable` has, a `for`
// loop, `toLazyList()` from a collection and from an iterator, and covariance.

open class Animal(val name: string)

class Dog(name: string): Animal(name)

describe(animals: LazyList[Animal]) -> string = animals.map(a -> a.name).mkString("/")

data Shape
    Circle(r: int)
    Square(side: int)

main() -> int
    val empty = LazyList.empty[int]()
    println(empty.isEvaluated())
    println(empty.knownSize)
    println(empty.isEmpty)
    println(empty.nonEmpty)
    println(empty.isEvaluated())
    println(empty.knownSize)
    println(empty.headOption)
    println(empty.lift(0))
    println(empty.lift(-1))
    println(empty.length)
    println(empty.size)
    println(empty.toVector)
    println(empty.toList)
    println(empty.lastOption)

    val one = LazyList.cons("only", LazyList.empty[string]())
    println(one.head)
    println(one.headOption)
    println(one.tail.isEmpty)
    println(one.length)
    println(one(0))
    println(one.lift(1))
    println(one.knownSize)

    val xs = LazyList.from(1).take(5)
    println(xs.length)
    println(xs.knownSize)
    println(xs(0))
    println(xs(4))
    println(xs.lift(5))
    println(xs.lift(-3))
    println(xs.last)
    println(xs.foldLeft(0, (a, x) -> a + x))
    println(xs.sum)
    println(xs.max)
    println(xs.exists(x -> x == 3))
    println(xs.forall(x -> x > 0))
    println(xs.find(x -> x > 3))
    println(xs.count(x -> x % 2 == 1))
    println(xs.mkString(", "))
    println(xs.toList)
    println(xs.tail.tail.toVector)
    var seen = ""
    for x in xs
        seen = seen + s"<$x>"
    println(seen)
    xs.foreach(x -> print(x))
    println()
    println(xs.force() === xs)

    // `+:` puts an element in front, of the element type or a wider one.
    val ys = 0 +: xs
    println(ys.toVector)
    println(("é" +: one).toVector)
    println((-1 +: empty).toVector)

    // From a collection and from an iterator; the iterator is read only as far as the cells are.
    println([3, 1, 2].toLazyList().toVector)
    println(Vector.empty[int]().toLazyList().isEmpty)
    println(List(7, 8).toLazyList().map(x -> x * 10).toVector)
    val it = Iterator.from(100)
    val fromIt = it.toLazyList()
    println(fromIt(2))
    println(fromIt(0))
    println(it.next())
    println("日本語".charIterator().toLazyList().toVector)

    // Element types: strings, tuples, options, data and classes.
    println(LazyList.cons((1, "a"), LazyList.cons((2, "b"), LazyList.empty[(int, string)]())).toVector)
    println(LazyList.cons(Some(1), LazyList.cons(None, LazyList.empty[Option[int]]())).toVector)
    val shapes = LazyList.cons(Circle(1), LazyList.cons(Square(2), LazyList.empty[Shape]()))
    println(shapes.map(s -> s match
        Circle(r) -> r
        Square(side) -> side * side).toVector)
    println(LazyList.from(long(int.MaxValue)).take(2).toVector)
    println(LazyList.from(i8(125)).take(3).toVector)
    println(LazyList.from(i8(127)).take(1).toVector)
    println(LazyList.from(10, -3).take(4).toVector)
    println(LazyList.from(7, 0).take(3).toVector)

    // Covariance: a list of dogs is a list of animals, and `+:` widens to the common type.
    val dogs: LazyList[Dog] = LazyList.cons(Dog("rex"), LazyList.cons(Dog("fido"), LazyList.empty[Dog]()))
    println(describe(dogs))
    val animals: LazyList[Animal] = Animal("cat") +: dogs
    println(describe(animals))
    val joined = dogs ++ LazyList.cons(Animal("owl"), LazyList.empty[Animal]())
    println(describe(joined))
    0
