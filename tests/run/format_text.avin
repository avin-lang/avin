// expect: exit 0
// `f"…"` text conversions: `%s` for a string or any other value that is not a number, with a width
// and `-` counting characters and a precision as the most characters taken; `%c` for a char; `%?`
// for any value's `Debug` form, a string or a char quoted and escaped, padded as a whole. A `%`
// anywhere but right after a hole is text, and so is every `%` in an `s"…"` literal. A hole with no
// specifier renders as in `s"…"`, and holes are evaluated once each, left to right, specifiers'
// counts in their places among them.
data Point(x: int, y: int)

data Shape
  Dot
  Circle(radius: real)

// A display that reads the spec it is handed: the width it pads to. Under `%s` a precision is the
// formatter's, which cuts the rendered text, so the renderer is handed none.
data Money(cents: long)

impl Display for Money
  display(out: Writer, spec: FormatSpec)
    val text = if spec.precision >= 0 then "precision seen" else f"$$${cents / 100}.${cents % 100}%02d"
    out.writeField(text, spec)

var counter = 0

next() -> int =
  counter += 1
  counter

main()
  val name = "zoë"
  val cut = 2
  println(f"[${name}%s] [${name}%6s] [${name}%-6s] [${name}%.2s] [${name}%-8.${cut}s] [${name}%.0s] [${name}%.9s]")
  println(f"[${'é'}%c] [${'x'}%3c] [${'x'}%-3c] [${true}%6s] [${()}%-4s] [${Point(1, 2)}%14s] [${Dot}%s]")
  println(
    f"[${"a\"b\n"}%?] [${'\''}%?] [${name}%8?] [${'c'}%-5?] [${Point(1, 2)}%?] [${Circle(1.5)}%16?] [${7}%?] [${2.5}%?]"
  )
  println(f"[${Money(1205)}] [${Money(1205)}%9s] [${Money(1205)}%-9.3s] [${Money(1205)}%-9.0s|]")
  val n = 7
  println(f"${n}%d done, 100% sure, 50%% here, % alone, $$%d stays")
  println(s"${n}%d is text in s, as is ${n}%")
  println(f"${n}${n}%d ${n}%d%d")
  println(f"" + f"%d" + f"plain" + f"${n}")
  println(f"[${next()}%${next()}d] [${next()}%-${next()}.${next()}d] [${next()}]")
  println(f"outer ${f"inner ${n}%03d"}%10s ${s"${n}%"}")
  val big: long = 99
  println(f"[${name}%${big - 90}s]")
