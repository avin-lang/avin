// expect: exit 0
// A union with a scalar member crosses every kind of call as its words: a direct call, a method
// through a table and its override, a function value and a closure, a call by name, a default
// argument, a tuple taken apart from a call, and a call in tail position, which stays one, so
// recursion a million deep returning a union runs in constant stack.

import avin.threads.spawn

trait Source
    next(seed: int | string) -> int | string

class Doubler: Source
    override next(seed: int | string) -> int | string = seed match
        n: int -> n * 2
        s: string -> s + s

open class Base
    pick(flag: bool) -> long | string = if flag then long(1) else "base"

class Derived: Base
    override pick(flag: bool) -> long | string = if flag then long(2) else "derived"

ping(n: int) -> int | string = if n == 0 then "ping done" else pong(n - 1)

pong(n: int) -> int | string = if n == 0 then 0 else ping(n - 1)

// A self call in tail position is a loop; the union accumulates through it.
count(n: int, acc: int | long) -> int | long
    if n == 0 then return acc
    val next: int | long = acc match
        k: int -> if k == int.MaxValue then long(k) + 1 else k + 1
        l: long -> l + 1
    count(n - 1, next)

// Recursion that is no tail call returns the union through every frame.
depth(n: int) -> int | bool = if n == 0 then true else depth(n - 1) match
    b: bool -> 1
    k: int -> k + 1

withDefault(x: int | string = "default") -> string = s"$x"

byName(x: -> int | string) -> int | string = x

pairOf(n: int) -> (int | string, string)
    if n == 0 then return (0, "zero")
    val (u, s) = pairOf(n - 1)
    val bumped: int | string = u match
        k: int -> k + 1
        t: string -> t
    (bumped, s)

apply(f: (int | string) -> int | string, u: int | string) -> int | string = f(u)

main()
    val source: Source = Doubler()
    println(source.next(21))
    println(source.next("ab"))
    val b: Base = Derived()
    println(s"${b.pick(true)} ${b.pick(false)} ${Base().pick(false)}")
    println(ping(1_000_001))
    println(ping(1_000_000))
    println(count(1_000_000, int.MaxValue - 10))
    println(count(5, 0))
    println(depth(1000))
    println(withDefault())
    println(withDefault(3))
    println(byName(7))
    println(byName("by name"))
    val (u, s) = pairOf(5)
    println(s"$u $s")
    // Function values and closures, capturing a union and changing it.
    val f: (int | string) -> int | string = v -> v match
        n: int -> n - 1
        t: string -> t.charCount()
    println(apply(f, 10))
    println(apply(f, "four"))
    var held: int | string = 0
    val bump = () -> held = held match
        n: int -> if n >= 2 then "many" else n + 1
        t: string -> t
    for _ in 0..<4 do bump()
    println(held)
    val adapted: (int) -> int | string = n -> n
    println(adapted(5))
    // A union made on another thread comes back as its value.
    val worker = spawn(() ->
        val r: int | string = "from a thread"
        r)
    println(worker.join())
