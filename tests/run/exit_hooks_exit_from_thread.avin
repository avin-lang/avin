// expect: exit 5
// `exit` called from another thread runs the hooks on that thread and ends the program with its
// status, while the main thread is still waiting for it; the main thread's own code after the wait
// never runs.
import avin.process
import avin.threads.spawn

main() -> int
    process.onExit(() -> println("hook registered by main"))
    val t = spawn(() ->
        process.onExit(() -> println("hook registered by the thread"))
        println("thread exits")
        process.exit(5))
    t.join()
    println("not reached")
    0
