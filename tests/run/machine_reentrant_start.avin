// expect: trap
// The first state's `enter` runs as the machine is made, and handling an event from inside it traps
// too: the machine is not yet done starting.
data Ev
    Echo

class Box(var target: Option[Hop])

machine Hop(box: Box) receives Ev
    box.target = Some(self)

    state Start
        enter
            println("starting")
            if box.target is Some(h) then h.handle(Echo)
        Echo -> stay

main() -> int
    val h = Hop(Box(None))
    println("unreachable")
    0
