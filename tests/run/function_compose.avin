// expect: exit 0
// `andThen` and `compose` join one-parameter functions, and `tupled` turns a two-parameter function
// into one taking a pair. They reach every value that is a function of that shape: lambdas, function
// references, method values, `@sendable` functions, a data type and a class naming a function type,
// a sequence, a set, a map and a partial function.

double(x: int) -> int = x * 2

show(x: int) -> string = s"<$x>"

join(a: string, b: int) -> string = s"$a$b"

data Lengths(extra: int)

impl (string) -> int for Lengths
  apply(s: string) -> int = s.charCount + extra

class Shout: (string) -> string
  apply(s: string) -> string = s + "!"

class Adder(val n: int)
  plus(x: int) -> int = x + n

pipe[A, B, C](f: (A) -> B, g: (B) -> C) -> (A) -> C = f.andThen(g)

before[A, B, Z](f: (A) -> B, g: (Z) -> A) -> (Z) -> B = f.compose(g)

main()
  val inc = (x: int) -> x + 1
  println(inc.andThen(double)(3), inc.compose(double)(3))
  println(double.andThen(show)(5), show.compose(double)(5))
  println(inc.andThen(double).andThen(show)(0), show.compose(double).compose(inc)(0))
  // The types change along the chain.
  val count: (string) -> int = s -> s.charCount
  println(count.andThen(n -> n > 2)("ünï"), count.compose((n: int) -> s"x$n")(4))
  // A result of `unit`.
  var seen = 0
  val record: (int) -> unit = inc.andThen(n -> seen = n)
  record(41)
  println(seen)
  // Generic instances, through the bounds of a generic function.
  println(pipe(inc, show)(1), pipe(show, count)(12345), before(show, inc)(9))
  // Captures are read when the joined function runs, not when it is made.
  var step = 1
  val stepped = ((x: int) -> x + step).andThen(double)
  println(stepped(1))
  step = 10
  println(stepped(1))
  // Method values and `@sendable` functions.
  val adder = Adder(100)
  println(adder.plus.andThen(show)(1))
  val safe: @sendable (int) -> int = x -> x - 1
  println(safe.andThen(double)(5), safe.compose(double)(5))
  // Values of types that are functions.
  println(Lengths(1).andThen(double)("ab"), Lengths(0).compose(show)(7))
  println(Shout().andThen(count)("hey"), Shout().compose(show)(1))
  println([10, 20, 30].andThen(show)(1), [10, 20, 30].compose(inc)(1))
  println({1, 2}.andThen(b -> if b then "in" else "out")(2), {1, 2}.compose(inc)(2))
  println({"a": 1}.andThen(double)("a"))
  val pf: PartialFunction[int, string] = match 1 -> "one"
  println(pf.andThen(s -> s + "!")(1))
  // `tupled` takes a pair.
  val add = (a: int, b: int) -> a + b
  println(add.tupled()((2, 3)))
  println(join.tupled()(("n", 1)))
  println([1, 2, 3].zip(["a", "b", "c"]).map(((n: int, s: string) -> s"$s$n").tupled()))
  println([(1, 2), (-2147483648, 2147483647)].map(add.tupled()))
  val joined = join.tupled().andThen(s -> s.charCount)
  println(joined(("ünï", 42)))
  // Many joined functions made and run, so a collection runs meanwhile.
  var total = 0
  for i in 0 ..< 3000
    val f = ((x: int) -> s"$x").andThen(s -> s.charCount).compose((n: int) -> n + i)
    total += f(0)
  println(total)
