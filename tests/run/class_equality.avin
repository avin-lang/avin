// expect: exit 0
// `==` and `!=` on a class instance, an object or a closure compare identities: the same instance
// is equal to itself, two instances with equal fields are not, a subclass instance is equal to the
// superclass reference that holds it, and a comparison works wherever a bool does.

class Item(val n: int)

open class Animal(val name: string)
class Dog(name: string): Animal(name)

object Registry
  val size = 3

twin(a: Item) -> Item = a

kind(a: Item, b: Item) -> string = a match
  x if x == b -> "same"
  _ -> "different"

main()
  val a = Item(1)
  val b = Item(1)
  println(s"${a == a} ${a == b} ${a != b} ${a != a}")
  println(s"${a == twin(a)} ${twin(b) == a}")
  println(s"${kind(a, a)} ${kind(a, b)}")
  println(s"${Registry == Registry}")
  val d = Dog("rex")
  val animal: Animal = d
  val other = Animal("rex")
  println(s"${animal == d} ${d == animal} ${other == d} ${other != animal}")
  val f: int -> int = x -> x + 1
  val g: int -> int = x -> x + 1
  val h = f
  println(s"${f == f} ${f == h} ${f == g} ${f != g}")
  if a == b then println("wrong") else println("distinct instances")
