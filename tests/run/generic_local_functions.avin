// expect: exit 0
// Local functions with type parameters of their own: inferred or written type arguments, bounds,
// captures, the enclosing function's type parameters, recursion, calls before the declaration,
// clauses, defaults, overloads and function values. Each list of type arguments is its own copy.

trait Named
    name() -> string

data Pet(label: string)

impl Named for Pet
    name() -> string = label

simple()
    pair[T](x: T) -> (T, T) = (x, x)
    print(pair(1))
    print(pair("a"))
    print(pair[real](2))
    val p: (long, long) = pair(3)
    print(p)

// Two type parameters, one written and one inferred.
written()
    convert[A, B](a: A, b: B) -> (B, A) = (b, a)
    print(convert[int](1, "one"))
    print(convert[int, string](2, "two"))

// A bound on a local's type parameter, called through.
bounded()
    describe[T: Named](x: T) -> string = "<" + x.name() + ">"
    print(describe(Pet("cat")))

// A generic local reads and assigns the enclosing locals.
captures() -> int
    var count = 0
    val prefix = "item"
    tag[T](x: T) -> string
        count += 1
        s"$prefix $count"
    print(tag(1))
    print(tag("x"))
    print(tag(true))
    count

// Inside a generic function, a local uses the outer type parameter and its own.
outer[T: Display](seed: T) -> ((T, int), int)
    var calls = 0
    with[U](u: U) -> (T, U)
        calls += 1
        (seed, u)
    val a = with(5)
    val b = with("s")
    print(b)
    (a, calls)

// Generic locals nest, the inner one seeing both outer parameter lists.
nested[A: Display](a: A)
    middle[B: Display](b: B)
        inner[C](c: C) -> (A, B, C) = (a, b, c)
        print(inner('z'))
        print(inner(1.5))
    middle(2)
    middle("two")

// Recursion and mutual recursion, with declared result types; calls before the declaration.
recursion()
    print(repeat(3, "ab"))
    print(isEven(10, 'e'))
    repeat[T](n: int, x: T) -> Vector[T] = if n == 0 then [] else repeat(n - 1, x) :+ x
    isEven[T](n: int, tag: T) -> bool = if n == 0 then true else isOdd(n - 1, tag)
    isOdd[T](n: int, tag: T) -> bool = if n == 0 then false else isEven(n - 1, tag)
    print(isOdd(7, 1))

// A generic local defined by clauses.
clauses()
    pick[T](first: bool, a: T, b: T) -> T
    pick(true, a, _) = a
    pick(false, _, b) = b
    print(pick(true, 4, 5))
    print(pick(false, "a", "b"))

// A default argument of a generic local is generic over the same parameters.
defaults()
    box[T](x: T, times: int = 2) -> Vector[T]
        var out: Vector[T] = []
        for _ in 0..<times
            out = out :+ x
        out
    print(box("d"))
    print(box(1, times = 3))

// Overloads of a generic local and a plain one; a generic local hides the top-level functions of
// its name, whatever their parameter types.
label(x: int) -> string = "top"

overloads()
    show[T](x: T) -> string = "any"
    show(x: int) -> string = "int"
    print(show(1))
    print(show("s"))
    label[T](x: T) -> string = "local"
    print(label(1))

// A generic local as a value, its type argument fixed by the expected function type or written.
values()
    twice[T](x: T) -> (T, T) = (x, x)
    val f: (int) -> (int, int) = twice
    print(f(7))
    val g = twice[string]
    print(g("g"))
    apply(h: (bool) -> (bool, bool)) -> (bool, bool) = h(true)
    print(apply(twice))

// Inside a generic local: a plain local function, a lambda, and a closure of the generic local that
// captures an enclosing `var`.
inner()
    var total = 0
    collect[T](x: T, n: int) -> Vector[T]
        add(v: Vector[T]) -> Vector[T] = v :+ x
        var out: Vector[T] = []
        for _ in 0..<n
            out = add(out)
        val bump = (k: int) -> total += k
        bump(n)
        out
    print(collect('c', 2))
    print(collect(1.5, 1))
    val f: (string, int) -> Vector[string] = collect
    print(f("s", 3))
    print(total)

// A generic local in a method of a generic class uses the class's type parameter, the method's and
// its own.
class Holder[A: Display](val held: A)
    combine[B: Display](b: B) -> string
        join[C](c: C) -> (A, B, C) = (held, b, c)
        s"${join(1)} ${join("x")}"

main()
    simple()
    written()
    bounded()
    print(captures())
    print(outer('q'))
    nested(true)
    recursion()
    clauses()
    defaults()
    overloads()
    values()
    inner()
    print(Holder(true).combine('b'))
