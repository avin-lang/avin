// An impl adds methods to a class as its body would: they see its private fields by bare name, call
// its methods, and a subclass inherits them, and the conformance an impl states, as it inherits its
// superclass's own.
trait Greeter
    greet() -> string
    twice() -> string = greet() + greet()

open class Person(name: string, var age: int)
    older() = age += 1

impl Person
    describe() -> string = s"$name, ${age}"
    birthday() -> string
        older()
        describe()
    private secret() -> string = name + "!"
    reveal() -> string = secret()

impl Greeter for Person
    greet() -> string = s"hi $name. "

class Child(name: string, age: int): Person(name, age)
    override greet() -> string = "hey. "

// A generic class's impl names the class's parameters, under names of its own.
class Stack[T](var items: (T, T))

impl[E] Stack[E]
    top() -> E = items.0
    swapped() -> Stack[E] = Stack((items.1, items.0))

object Config
    val port = 8080

impl Config
    address() -> string = s"localhost:$port"

impl Greeter for Config
    greet() -> string = "config. "

say(g: Greeter) = print(g.twice())

main()
    val p = Person("ada", 36)
    print(p.birthday())
    print(p.reveal())
    say(p)
    val c = Child("bo", 3)
    print(c.describe())
    say(c)
    val as_person: Person = c
    print(as_person.greet())
    val s = Stack((1, 2))
    print(s"${s.top()} ${s.swapped().top()}")
    print(Config.address())
    say(Config)
