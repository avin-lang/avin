// expect: exit 0
// Module-level values and object fields are roots of the collector: what they hold survives every
// collection while the program allocates a great deal after storing it.

data Node
    Leaf
    Link(value: int, next: Node)

class Box(val label: string)

object Cache
    var head: Node = Leaf
    var box = Box("cached box")
    var tag = "cache " + "tag"

var kept: Node = Leaf
val numbers = build(0, 50)
var saved: () -> string = () -> "unset"

build(from: int, count: int) -> Node = if count == 0 then Leaf else Link(from, build(from + 1, count - 1))

sum(n: Node) -> int = n match
    Leaf -> 0
    Link(v, rest) -> v + sum(rest)

// Allocates and drops many lists, so the collector runs many times.
churn()
    var i = 0
    while i < 200
        val garbage = build(i, 20)
        if sum(garbage) < 0 then println("never")
        i++

main()
    kept = build(1, 100)
    Cache.head = build(1000, 10)
    Cache.box = Box("new " + "box")
    val word = "cap" + "tured"
    saved = () -> s"closure $word"
    churn()
    println(s"${sum(kept)} ${sum(numbers)} ${sum(Cache.head)}")
    println(Cache.box.label)
    println(Cache.tag)
    println(saved())
