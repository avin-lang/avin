// expect: exit 0
// Machines of one module may share a state's name, and a state may share its name with an event's
// variant: each is a variant of its own machine's `State` type (or of the event type), and a bare
// name is the one of the type expected there. Inside a machine an arm's result is its own state; in
// `handle` the event is the event type's; outside, `is` and `match` decide by the value matched.
data Ev
    Start
    Idle
    Finish

machine First receives Ev
    var entered = 0
    state Idle
        enter
            entered += 1
        Start -> Running
        _ -> stay
    state Running
        Idle -> Idle
        Finish -> Done
        _ -> stay
    state Done
        _ -> stay

machine Second receives Ev
    state Waiting
        Start -> Ready(1)
        _ -> stay
    state Ready(n: int)
        Start -> Ready(n + 1)
        Idle -> Idle
        _ -> stay
    state Idle
        Finish -> Done
        _ -> stay
    state Done
        _ -> stay

describe(s: Second.State) -> string = s match
    Waiting -> "waiting"
    Ready(n) -> s"ready $n"
    Idle -> "idle"
    Done -> "done"

main() -> int
    val a = First()
    val b = Second()
    println(a.state() is Idle)
    println(a.handle(Start))
    println(a.handle(Idle) is Idle)
    println(a.entered)
    println(describe(b.handle(Start)))
    println(describe(b.handle(Start)))
    println(describe(b.handle(Idle)))
    println(b.state() is Idle)
    println(describe(b.handle(Finish)))
    println(a.handle(Start))
    println(a.handle(Finish) is Done)
    val s: First.State = Done
    println(s == a.state())
    println(Second.State.Idle == Idle)
    0
