// expect: exit 0

// `rest*` ends a sequence pattern, and binds what the patterns before it leave.
describe(xs: Vector[int]) -> string = xs match
    [] -> "empty"
    [only] -> s"just $only"
    [first, second, rest*] if rest.isEmpty() -> s"the pair $first, $second"
    [first, rest*] -> s"$first then $rest"
    _ -> "never: only a list's patterns count its lengths"

// On a list, `[a, rest*]` is `a :: rest`, so with `[]` it covers every list.
total(xs: List[int]) -> int = xs match
    [] -> 0
    [head, tail*] -> head + total(tail)

// `[rest*]` and `[_*]` match every sequence.
size(xs: Array[string]) -> int = xs match
    [first, _*] if first == "skip" -> -1
    [all*] -> all.length()

anyList(xs: List[string]) -> string = xs match
    [_*] -> "a list"

main()
    println(describe([]))
    println(describe([1]))
    println(describe([1, 2]))
    println(describe([1, 2, 3, 4]))
    println(total([1, 2, 3, 4]))
    val two: Array[string] = ["a", "b"]
    val skip: Array[string] = ["skip"]
    println(size(two))
    println(size(skip))
    println(size(Array.empty[string]()))
    println(anyList(["x"]))
    val x = [5, 6, 7]
    if x is [5, more*] then println(s"after five: $more")
