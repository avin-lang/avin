// Alternative, named and unit patterns, and the order guards and subjects are evaluated in: the
// subject once, a guard only when its pattern matched, and a guard that fails falls to the next arm.

trace(n: int) -> bool
  println(n)
  n > 0

multiline(n: int) -> int = n match
  | 1
  | 1
  | 2 if trace(n) -> 42
  | 3 | 4 -> 43
  10 | // continue at the arm margin
  // comments do not end the pattern
  20 -> 44
  | whole @ _ -> whole

boolean(flag: bool) -> int = flag match
  | true -> 1
  | false -> 0

mask(n: int) -> int = n match
  | 1 -> (1 | 2)
  | _ -> 4

nested(n: int) -> int = n match
  | 0 -> n match
    | 0 -> 42
    | _ -> 0
  | _ -> 0

whole_value[T](value: T) -> T = value match
  whole @ _ -> whole

narrow(value: i8) -> i8 = value match
  whole @ -128 -> whole
  else 0

wide(value: i129) -> i129 = value match
  whole @ -340282366920938463463374607431768211456 -> whole
  whole @ _ -> whole

read(value: -> int) = value

alternatives(n: int) -> int = n match
  -2 | -1 | 0 -> 10
  1 | 2 | 3 -> 20
  else 30

either(flag: bool) = flag match
  true | false -> 42

character(ch: char) -> int = ch match
  'a' | 'é' | '🌍' -> 42
  else 0

word(text: string) -> int = text match
  "" | "a\0b" | "λ" -> 42
  else 0

real_value(value: real) -> int = value match
  -0.0 | 0.5 | -1.5 -> 42
  else 0

wide_value(value: i129) -> int = value match
  -340282366920938463463374607431768211456 | 340282366920938463463374607431768211455 -> 42
  else 0

generic[T](value: T, flag: bool) -> T = flag match
  true | false -> value

unit_effect() -> unit
  println(10)
  ()

observe(value: unit) -> int = value match
  () -> 42

main()
  println(multiline(0))
  println(multiline(1))
  println(multiline(2))
  println(multiline(3))
  println(multiline(20))
  println(boolean(true), boolean(false), mask(1), mask(2), nested(0), nested(1))
  // A guard on a multiline alternative that fails falls through to the binding arm.
  println(1 match
    1
    | 2 if false -> 0
    | whole @ _ -> whole + 41)

  println(whole_value(42), whole_value(true), whole_value("alias"))
  println(narrow(-128), wide(-340282366920938463463374607431768211456))
  val whole = 99
  println(21 match
    a @ b @ _ -> a + b)
  println(42 match
    whole @ 42 if whole > 0 -> whole
    else 0)
  println(whole)
  println('é' match
    ch @ 'é' -> ch
    ch @ _ -> ch)
  println("a\0b" match
    text @ "a\0b" -> text == "a\0b"
    text @ _ -> false)
  println(-0.0 match
    zero @ 0.0 -> 1.0 / zero
    else 0.0)
  println(42 match
    whole @ _ -> read(whole))
  println(42 match
    whole @ _ ->
      helper() = whole
      helper())
  println(42 match
    first @ 42 if false -> first + 1
    second @ _ -> second)

  // The subject is evaluated once, whatever the arms and guards do.
  var subject = 0
  val snapshot = (subject +:= 1) match
    whole @ 1 if (subject := 42) == 42 -> whole
    else 0
  println(snapshot, subject)
  var subjects = 0
  var guards = 0
  val once = (subjects +:= 1) match
    1 | 1 if (guards +:= 1) == 2 -> 0
    0 | 1 -> 42
    else 0
  println(once, subjects, guards)
  println(1 match
    2 | 3 if 1 / 0 == 0 -> 0
    _ | 1 -> 42)
  var range_subject = 0
  var range_guards = 0
  val ranged = (range_subject +:= 1) match
    whole @ 0 ..< 2 if (range_guards +:= 1) == 2 -> whole
    0 .. 3 | 5 .. 6 -> 42
    else 0
  println(ranged, range_subject, range_guards)

  println(alternatives(-3), alternatives(-2), alternatives(0), alternatives(2), alternatives(4))
  println(either(true), either(false))
  println(character('é'), character('🌍'), character('z'))
  println(word("λ"), word("a\0b"), word("a\0c"), word(""))
  println(real_value(-0.0), real_value(0.5), real_value(1.0), real_value(0.0 / 0.0))
  println(
    wide_value(-340282366920938463463374607431768211456),
    wide_value(340282366920938463463374607431768211455),
    wide_value(0)
  )
  println(generic("generic", false))

  // Unit is a value, and a pattern.
  val value = whole_value(())
  println(observe(value))
  println(unit_effect() match
    () -> 42)
  var current: unit = ()
  current = ()
  current match
    alias @ () -> whole_value(alias)
  println((() -> ())() match
    () -> 42)
  var unit_guards = 0
  val unit_result = () match
    () | () if (unit_guards +:= 1) == 2 -> 0
    () -> 42
  println(unit_result, unit_guards)
