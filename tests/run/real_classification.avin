// `isNaN`, `isInfinite` and `isFinite` classify a `real`: NaN (from `0.0 / 0.0`, `real.NaN`,
// `infinity - infinity`, `sqrt(-1.0)`) is only NaN; both infinities (written, or reached by overflow
// and by `1.0 / 0.0`) are infinite and not finite; zeros of both signs, the least subnormal, the
// greatest and least finite values and ordinary numbers are finite. The three agree: each value is
// exactly one of NaN, infinite or finite. They work through a function, a generic-free chain of
// calls and a closure.
import avin.math

classify(x: real) -> string
  if x.isNaN then "nan" elif x.isInfinite then "inf" else "finite"

describe(x: real) = s"${classify(x)} ${x.isNaN} ${x.isInfinite} ${x.isFinite}"

main()
  val zero = 0.0
  val big = real.MaxValue
  println(describe(real.NaN))
  println(describe(zero / zero))
  println(describe(real.PositiveInfinity - real.PositiveInfinity))
  println(describe(math.sqrt(-1.0)))
  println(describe(-real.NaN))
  println(describe(real.PositiveInfinity))
  println(describe(real.NegativeInfinity))
  println(describe(1.0 / zero))
  println(describe(-1.0 / zero))
  println(describe(big * 2.0))
  println(describe(-big * 2.0))
  println(describe(math.exp(1000.0)))
  println(describe(0.0))
  println(describe(-0.0))
  println(describe(real.MinPositiveValue))
  println(describe(-real.MinPositiveValue))
  println(describe(real.MaxValue))
  println(describe(real.MinValue))
  println(describe(2.2250738585072014e-308))
  println(describe(1.0))
  println(describe(-123.456))
  println(describe(big))
  println(describe(big + 1.0))
  println(describe(real.MinPositiveValue / 2.0))
  println(real.NaN.isNaN && !(real.NaN == real.NaN))
  val values = [1.0, real.NaN, real.PositiveInfinity, -2.5, zero / zero]
  println(values.filter(v -> v.isFinite))
  println(values.count(v -> v.isNaN))
  println(values.map(v -> v.isInfinite))
  val check = (v: real) -> v.isNaN || v.isInfinite || v.isFinite
  println(values.forall(check))
