// expect: exit 0
// `choose` picks an item, `chooseWeighted` an index or the first of a pair with probability
// proportional to its weight, and `Weighted` does the same from a table built once. A seed replays
// every draw, a zero weight is never chosen, and one item is always the answer.
import avin.random.{Random, Weighted}

main()
  val a = Random(11)
  val b = Random(11)
  val items = ["x", "y", "z", "w"]
  val first = Array.tabulate(8, i -> a.choose(items)).toVector
  val second = Array.tabulate(8, i -> b.choose(items)).toVector
  println(s"choose replays: ${first == second}")
  println(first)

  val ws = [1.0, 0.0, 3.0]
  val idx = Random(3)
  val picks = Array.tabulate(10, i -> idx.chooseWeighted(ws)).toVector
  println(picks)
  println(s"pairs: ${Random(3).chooseWeighted([("a", 1.0), ("b", 0.0), ("c", 3.0)])}")

  val g = Random(99)
  val counts = Array.fill(3, 0)
  for i in 0 ..< 40000 do counts(g.chooseWeighted(ws)) += 1
  println(
    s"zero never: ${counts(1) == 0}, ratio near 3: ${real(counts(2)) > 2.9 * real(counts(0)) && real(counts(2)) < 3.1 * real(counts(0))}"
  )

  val table = Weighted([("sun", 6.0), ("rain", 3.0), ("snow", 1.0)])
  println(s"size ${table.size}")
  val h = Random(5)
  val seen = Array.fill(3, 0)
  for i in 0 ..< 50000
    table.sample(h) match
      "sun" -> seen(0) += 1
      "rain" -> seen(1) += 1
      _ -> seen(2) += 1
  println(s"sun near 30000: ${29000 < seen(0) < 31000}")
  println(s"rain near 15000: ${14300 < seen(1) < 15700}")
  println(s"snow near 5000: ${4500 < seen(2) < 5500}")
  val r1 = Array.tabulate(6, i -> table.sample(Random(long(i)))).toVector
  val r2 = Array.tabulate(6, i -> table.sample(Random(long(i)))).toVector
  println(s"replays: ${r1 == r2} ${r1}")

  val one = Weighted([(7, 0.25)])
  println(s"one item: ${one.sample(Random(1))} ${Random(1).chooseWeighted([0.5])} ${Random(1).choose([9])}")
  val lead = Weighted([("never", 0.0), ("always", 2.0)])
  println(s"zero first: ${Array.tabulate(20, i -> lead.sample(Random(long(i)))).forall(s -> s == "always")}")

  val shared = Random.choose([1, 2, 3])
  println(
    s"shared: ${1 <= shared <= 3} ${Random.chooseWeighted([0.0, 1.0])} ${Random.chooseWeighted([("p", 0.0), ("q", 1.0)])}"
  )
