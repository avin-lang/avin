// expect: exit 0
// A constructor parameter with no bound is inferred from a type of exactly as many parameters as it
// takes holes, named bare: from an argument, from the expected type, alongside the call's other type
// arguments, and from another constructor parameter in scope. Each call compiles its own copy at the
// constructor inferred, so a type pattern inside it sees the exact type.
same[F[_], A](x: F[A]) -> F[A] = x

pair[G[_, _], A, B](x: G[A, B]) -> G[A, B] = x

both[F[_], A, B](x: F[A], y: F[B]) -> (F[A], F[B]) = (x, y)

wrap[F[_], A](a: A, make: (A) -> F[A]) -> F[A] = make(a)

isInts[F[_]](x: F[int]) -> bool
  val any: Any = x
  any match
    _: F[int] -> true
    _ -> false

relay[F[_]](x: F[string]) -> F[string] = same(x)

relayPair[G[_, _]](x: G[int, bool]) -> G[int, bool] = pair(x)

nested[F[_], A](x: F[F[A]]) -> F[F[A]] = x

lift[F[_], A](x: F[A]) -> () -> F[A] = () -> same(x)

class Box[A](val item: A)

open class Shelf[A](val item: A)

class Crate[A](item: A): Shelf[A](item)

empty[F[_], A]() -> Option[F[A]] = None

main()
  println(same([1, 2, 3]))
  println(same(Some("ü✓")))
  println(same(Box(7)).item)
  println(same(Crate(1.5)).item)
  val left: Either[int, string] = Left(-2147483648)
  println(pair(left))
  val ok: Result[long, string] = Ok(9223372036854775807)
  println(pair(ok))
  println(pair({"k": 1}))
  println(both(Some(1), Some("one")))
  println(both([1], ["a", "b"]))
  println(wrap(3, x -> Some(x)))
  println(wrap("s", x -> [x, x]))
  println(isInts([1, 2]))
  println(isInts(Some(5)))
  println(relay(Some("relayed")))
  println(relay(["a", ""]))
  val right: Either[int, bool] = Right(true)
  println(relayPair(right))
  println(nested(Some(Some(0))))
  println(nested([[1], [], [2, 3]]))
  println(lift([true])())
  val v: Vector[long] = same([1, 2])
  println(v)
  val o: Option[Option[int]] = empty()
  println(o)
  val f = same[Vector, int]
  println(f([4]))
  var total = 0
  for x in same([10, 20, 30])
    total += x
  println(total)
