// expect: trap
// A program a trap is ending stays a trap: a hook calling `exit` ends only that hook, and the
// program does not end with its status. A hook that traps while an `exit` is ending the program
// makes it end as a trap.
import avin.process

main()
    process.onExit(() -> println("last"))
    process.onExit(() ->
        println("exit(0) in a hook")
        process.exit(0))
    process.onExit(() -> println("first"))
    fail("stop")
