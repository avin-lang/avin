// expect: trap
// A version range whose oldest is newer than its newest leaves nothing to speak, and traps where a
// server is given it.
import avin.net.tls.{Tls12, Tls13, TlsServer}

main()
  println(s"one version alone: ${TlsServer("", "").versions(Tls13, Tls13).minVersion}")
  _ = TlsServer("", "").versions(Tls13, Tls12)
  println("not reached")
