// expect: trap
// Threads that sleep, wait with a limit and await a future with a limit first are not deadlocked
// while their timers are set; once every timer has run out and each then waits on something nothing
// will end, the program is, and the report comes after their output.
import avin.threads.{Channel, Mutex, Promise, sleep, spawn}
import avin.time.millis

main()
  val never = Channel[int]()
  val sleeper = spawn(() ->
    sleep(millis(50))
    println("slept")
    never.receive().getOrElse(0))
  val m = Mutex(0)
  val c = m.condition()
  val timed = spawn(() ->
    val notified = m.with(n -> c.waitFor(60))
    println(s"timed wait notified: $notified")
    never.receive().getOrElse(0))
  val p = Promise[int]()
  println(s"awaited: ${p.future.await(millis(70))}")
  println(sleeper.join() + timed.join())
