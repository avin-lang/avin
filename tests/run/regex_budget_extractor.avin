// expect: trap
// A regex used as an extractor traps, as the plain searches do, when an attempt spends its budget;
// the cases before it answer as usual.
import avin.regex.Regex

main()
    val r = Regex("((a+)+?)$").withStepLimit(100000)
    for s in ["aa", "b", "a".repeat(40) + "b"]
        s match
            r(g, _) -> println(s"matched $g")
            _ -> println("no match")
