// expect: exit 0
// `s"…"` renders each hole as text: integers of any width in decimal, bytes as numbers, chars as
// themselves, reals as the fewest digits that read back the same, written out without an exponent,
// bools and unit by name.
// Holes are evaluated once each, left to right, and may hold any expression, interpolations
// included.

main() -> int
  val n = 42
  val most: i128 = -170141183460469231731687303715884105728
  val huge: i200 = 803469022129495137770981046170581301261101496891396417650687
  val b = byte(255)
  val r = 2.5
  println(s"n is $n, ${n * 2} doubled, $$5")
  println(s"long ${long(-9223372036854775807) - 1} small ${i8(-128)} bit ${i1(-1)} zero ${0}")
  println(s"wide $most and $huge and ${i100(7)}")
  println(
    s"byte $b char ${'é'} real $r ${0.1 + 0.2} ${1.0e21} ${1.5e-7} ${1.0} ${-0.0} bool ${n > 3} ${n < 3} unit ${()}"
  )
  println(s"nested ${s"[${n}]"} string ${"x" + "y"} braces ${"}"}")
  println(s"")
  println(s"plain")
  println(s"${n}")
  println(s"tab\there \u{1F30D} \"q\"")
  var calls = 0
  next() -> int
    calls += 1
    calls
  println(s"${next()}, ${next()}, ${next()}")
  var text = ""
  var i = 0
  while i < 4
    text = s"$text$i;"
    i += 1
  println(text)
  0
