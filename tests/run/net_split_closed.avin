// expect: trap
// A closed connection cannot be split: there is nothing left for halves to hold.
import avin.fs
import avin.io.IoError
import avin.net.{UnixListener, UnixStream}

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

main()
  val dir = ok(fs.createTempDir("avsplit"))
  val l = ok(UnixListener.bind(dir + "/s"))
  val c = ok(UnixStream.connect(dir + "/s"))
  val s = ok(l.accept())
  ok(c.close())
  println("closed", s.remoteAddress)
  _ = c.split()
  println("not reached")
