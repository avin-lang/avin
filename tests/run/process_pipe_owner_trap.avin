// expect: trap
// A child's output handed to a thread is that thread's while it runs: the program using it meanwhile
// traps, naming the `ChildOutput`.
import avin.process.Command
import avin.threads.{sleep, spawn}
import avin.time.millis

main()
  val child = Command("cat").pipeInput().pipeOutput().start().ok.get
  val output = child.stdout()
  val reader = spawn(() -> output.read(1).map(b -> b.length))
  sleep(millis(50))
  println("before")
  println(output.readable())
  println(s"not reached ${child.isAlive()}")
