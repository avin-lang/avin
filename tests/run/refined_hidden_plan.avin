// expect: exit 0
// A typed plan of transitions: `Then`'s `Mid` is hidden, chained from one step to the next, so a plan
// is a type error unless each step starts where the one before it ends, and `perform` drives a `Door`
// machine through it. `perform` recurses at `Plan[Mid, To]`, one pack per state a plan passes
// through, and a plan made inside a generic function makes packs at each copy's types.

data DoorEvent
  Open
  Close
  Lock(code: int)
  Unlock(code: int)

machine Door receives DoorEvent
  var opened = 0

  state Closed
    Open ->
      opened += 1
      Opened
    Lock(code) -> Locked(code)

  state Opened
    enter
      println("open")
    Close -> Closed

  state Locked(code: int)
    enter
      println(s"locked with $code")
    Unlock(c) if c == code -> Closed

  receive
    _ -> stay

data DoorShut()
data DoorOpen()
data DoorLocked()

data Step[From, To]
  OpenIt -> Step[DoorShut, DoorOpen]
  CloseIt -> Step[DoorOpen, DoorShut]
  LockIt(code: int) -> Step[DoorShut, DoorLocked]
  UnlockIt(code: int) -> Step[DoorLocked, DoorShut]

data Plan[From, To]
  Done -> Plan[From, From]
  Then[Mid](step: Step[From, Mid], rest: Plan[Mid, To])

event[From, To](s: Step[From, To]) -> DoorEvent
event(OpenIt) = Open
event(CloseIt) = Close
event(LockIt(code)) = Lock(code)
event(UnlockIt(code)) = Unlock(code)

perform[From, To](door: Door, plan: Plan[From, To]) -> unit
perform(door, Done) = ()
perform(door, Then(step, rest)) =
  _ = door.handle(event(step))
  perform(door, rest)

steps[From, To](plan: Plan[From, To]) -> int
steps(Done) = 0
steps(Then(_, rest)) = 1 + steps(rest)

// The first two steps of a plan, through nested patterns on `Then`.
opening[From, To](plan: Plan[From, To]) -> string = plan match
  Then(OpenIt, Then(CloseIt, _)) -> "opens and closes"
  Then(_, Then(_, _)) -> "two steps or more"
  Then(_, Done) -> "one step"
  Done -> "nothing"

// A plan made at a type parameter's instance: each copy makes its own packs.
around[A, B](go: Step[A, B], back: Step[B, A]) -> Plan[A, A] = Then(go, Then(back, Done))

main()
  val night: Plan[DoorShut, DoorShut] = Then(LockIt(42), Then(UnlockIt(42), Done))
  val door = Door()
  perform(door, night)
  val day: Plan[DoorShut, DoorShut] = Then(OpenIt, Then(CloseIt, Then(OpenIt, Then(CloseIt, Done))))
  perform(door, day)
  println(door.state())
  println(steps(night) + steps(day))
  println(opening(day))
  println(opening(night))
  println(opening(Then(LockIt(1), Done)))
  val nothing: Plan[DoorOpen, DoorOpen] = Done
  println(opening(nothing))
  println(night == night)
  println(night == Then(LockIt(42), Then(UnlockIt(43), Done)))
  println(night == day)
  val there = around(OpenIt, CloseIt)
  perform(door, there)
  perform(door, around(LockIt(7), UnlockIt(7)))
  println(steps(there))
  println(opening(there))
  println(there == Then(OpenIt, Then(CloseIt, Done)))
