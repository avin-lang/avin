// expect: trap
// A send waiting on a channel of capacity zero for a receiver that never comes gets the close as any
// send to a closed channel does: it traps, and its value is handed to nobody.
import avin.threads.{Channel, sleep, spawn}
import avin.time.millis

main()
  val ch = Channel[int](0)
  val closer = spawn(() ->
    sleep(20.millis)
    ch.close())
  println("sending")
  ch.send(1)
  println("not reached", closer.join())
