// expect: exit 0
// A thread waiting on a socket is not deadlocked, even while every other thread waits without a
// limit and no timer is set: `main` joins a thread parked in `accept`, and the client that ends the
// wait is another process, started before and connecting a little later. The same holds where
// `main` itself waits in `accept`.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.process
import avin.process.{Child, Command}
import avin.threads.{sleep, spawn}
import avin.time.millis

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

// Starts this program again as a client of `port`, which connects once it has slept a little.
client(port: int) -> Child
  val program = process.executable().get
  ok(Command(program, "client", port.toString()).start())

main(args: Vector[string])
  if args.length == 2 && args(0) == "client"
    sleep(millis(300))
    val s = ok(TcpStream.connect("127.0.0.1", args(1).toInt()))
    _ = s.close()
    return
  val l = ok(TcpListener.bind("127.0.0.1", 0))
  val one = client(l.port())
  val accepting = spawn(() ->
    val s = ok(l.accept())
    _ = s.close()
    "accepted by a thread")
  println(accepting.join())
  println(ok(one.waitFor()))

  val two = client(l.port())
  val s = ok(l.accept())
  _ = s.close()
  println("accepted by main")
  println(ok(two.waitFor()))
