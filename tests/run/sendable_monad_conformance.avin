// expect: exit 0
// `SendableMonad`, whose parameter is bounded by `Sendable`, is implemented by a constructor whose
// parameter is bounded by no more than that: `Future`, whose parameter has no bound, gives only
// `pure`, its own `map` and `flatMap` meeting the rest, as does a program's own type with an
// unbounded parameter; and generic code over `F[_: Sendable]: SendableMonad` runs at both.
import avin.threads.Future

data Cell[T](value: T)

impl SendableMonad for Cell
  static pure[X: Sendable](value: X) -> Cell[X] = Cell(value)

  map[B: Sendable](@sendable f: (T) -> B) -> Cell[B] = Cell(f(value))

  flatMap[B: Sendable](@sendable f: (T) -> Cell[B]) -> Cell[B] = f(value)

bothOf[F[_: Sendable]: SendableMonad, A: Sendable, B: Sendable](fa: F[A], fb: F[B]) -> F[(A, B)] =
  fa.flatMap(a -> fb.map(b -> (a, b)))

data Held[T](value: T)

impl[T] SendableFunctor[T] for Held[T]
  map[B: Sendable](@sendable f: (T) -> B) -> Held[B] = Held(f(value))

shipped[F[_: Sendable]: SendableFunctor](x: F[int]) -> F[int] = x.map(n -> n + 1)

lifted[F[_: Sendable]: SendableMonad](n: int) -> F[string] = F.pure(n).map(x -> s"<$x>")

main()
  println(bothOf(Future(1), Future("one")).await())
  println(bothOf(Cell(2), Cell('é')).value)
  println(lifted[Future](3).await())
  println(lifted[Cell](4).value)
  println(Future.pure([5, 6]).map(v -> v.length).await())
  println(shipped(Held(8)).value)
  println(Cell.pure(7).flatMap(x -> Cell(x * 6)).value)
