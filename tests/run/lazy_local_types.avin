// expect: exit 0
// A local `lazy val` holds a value of any type: a generic function's type parameter, a scalar, a
// real, a tuple, a data value, an `Option`, a function, an object of a class and a collection. It is
// declared in a method, where its initializer uses the object's fields and methods, in a lambda, in
// a function written as clauses, in a `match` arm and in a `while` loop.
data Shape
  Circle(radius: real)
  Square(side: real)

class Counter(start: int)
  var hits = 0

  bump() -> int
    hits += 1
    start + hits

  // The initializer reads the object's field and calls its method when the value is first read.
  twiceBumped() -> int
    lazy val bumped = bump()
    bumped + bumped

wrapped[T](x: T, show: (T) -> string) -> string
  lazy val both: (T, T) = (x, x)
  lazy val text = s"<${show(both.0)}|${show(both.1)}>"
  text + text

sign(n: int) -> string
sign(0) = "zero"
sign(n) =
  lazy val word = if n < 0 then "negative" else "positive"
  word

main()
  println(wrapped(3, n -> n.toString()))
  println(wrapped("é", s -> s))
  println(wrapped(Some(2.5), o -> o.toString()))

  lazy val ratio: real = 1.0 / 3.0
  lazy val pair = (1, "one")
  lazy val shape: Shape = Square(2.0)
  lazy val maybe: Option[int] = None
  lazy val add: (int, int) -> int = (a, b) -> a + b
  lazy val counter = Counter(10)
  lazy val items = Buffer[string]()
  println(ratio)
  println(pair.1)
  println(shape match
    Circle(r) -> r
    Square(s) -> s * s)
  println(maybe.getOrElse(-1))
  println(add(2, 3))
  println(counter.twiceBumped())
  println(counter.twiceBumped())
  items += "a"
  items += "b"
  println(items.length)

  val f = (k: int) ->
    lazy val square = k * k
    square + square
  println(f(4))

  println(sign(0))
  println(sign(-3))
  println(sign(8))

  val chosen = 2 match
    1 -> "one"
    n ->
      lazy val spelled = s"number $n"
      spelled
  println(chosen)

  var i = 0
  var seen = 0
  while i < 4
    lazy val step = i * 100
    if i % 2 == 0 then seen += step
    i += 1
  println(seen)
