// expect: exit 0
// A variant with fields named alone in a pattern tests for the variant and binds none of its fields,
// as `V(_, _)` does: in `is` and `is not`, under `!`, beside `&&` and `||`, in a `match` arm bare or
// qualified, nested in another pattern, in alternatives, in a function's clauses, in a lambda, in a
// `while` test, over a generic data type, and for a variant name two data types share. A `match`
// naming every variant alone needs no catch-all, and an arm with fields after the bare one's
// variant is reached only when the bare arm is not above it.

data Status
    Pending
    Shipped(carrier: string, days: int)
    Lost(reason: string)

data Box[T]
    Empty
    Full(value: T)

data Pair[A, B]
    Neither
    Both(first: A, second: B)

data Slant
    Normal
    Italic

data Weight
    Normal(by: int)
    Bold

describe(s: Status) -> string = s match
    Pending -> "pending"
    Shipped -> "shipped"
    Lost -> "lost"

qualified(s: Status) -> string = s match
    Status.Shipped -> "shipped"
    Status.Lost -> "lost"
    Status.Pending -> "pending"

delivered(s: Status) -> string = s match
    Shipped(c, d) if d < 2 -> s"fast by $c"
    Shipped -> "slow"
    _ -> "none"

moving(s: Status) -> bool = s match
    Shipped | Pending -> true
    Lost -> false

tag(s: Status) -> string
tag(Shipped) = "S"
tag(Lost) = "L"
tag(Pending) = "P"

full[T](b: Box[T]) -> bool = b is Full

paired[A, B](p: Pair[A, B]) -> string = p match
    Both -> "both"
    Neither -> "neither"

heavy(w: Weight) -> bool = w is Normal

carrierOf(s: Status) -> string
    if s is not Shipped then return "-"
    s match
        Shipped(c, _) -> c
        _ -> "?"

main()
    val a = Shipped("ups", 3)
    val l = Lost("rain on the ⛵")
    println(a is Shipped)
    println(a is Lost)
    println(a is not Shipped)
    println(!(a is Shipped))
    println(Pending is Shipped)
    println(l is Lost)
    if a is Shipped && a is Shipped(c, _) then println(c)
    if l is Shipped || l is Lost then println("either")
    println(describe(a))
    println(describe(l))
    println(describe(Pending))
    println(qualified(a))
    println(qualified(l))
    println(delivered(Shipped("dhl", 1)))
    println(delivered(a))
    println(delivered(Pending))
    println(moving(a))
    println(moving(l))
    println(tag(a) + tag(l) + tag(Pending))
    println(full(Full(1)))
    val e: Box[string] = Empty
    println(full(e))
    println(full(Full("é")))
    println(paired(Both(1, "x")))
    val n: Pair[int, string] = Neither
    println(paired(n))
    println(heavy(Normal(2)))
    println(heavy(Bold))
    val o: Option[Status] = Some(a)
    println(o is Some(Shipped))
    println(o is Some(Status.Lost))
    println(carrierOf(a))
    println(carrierOf(l))
    val all = [a, l, Pending, Shipped("fedex", 5)]
    println(all.filter(s -> s is Shipped).length)
    println(all.count(s -> s is not Shipped))
    var i = 0
    while all(i) is Shipped || all(i) is Lost
        i += 1
    println(i)
