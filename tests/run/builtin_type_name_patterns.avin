// expect: exit 0
// A built-in type's name in a pattern is a type pattern: `x is int` tests the type, and an arm
// `int ->` matches an int, as `_: int` does. Every built-in type's name reads so, sized integers
// included, wherever a pattern may stand: `is` and `is not`, arms, alternatives, nested inside a
// constructor or a tuple, a union's members, a generic function's parameter, clauses and `match`
// functions.

data Holder
  Holder(value: Any)
  Empty

data Pair
  Pair(left: int | string, right: Any)

class Box[T](val item: T)

kind(x: Any) -> string = x match
  int -> "int"
  long -> "long"
  i8 -> "i8"
  i16 -> "i16"
  i128 -> "i128"
  i7 -> "i7"
  byte -> "byte"
  real -> "real"
  bool -> "bool"
  char -> "char"
  string -> "string"
  unit -> "unit"
  _ -> "other"

// Every member of the union is covered by its own type's name, so no `_` arm is needed.
size(v: int | string) -> int = v match
  int -> 1
  string -> 2

// Alternatives of type patterns bind nothing, and together cover the union.
group(v: int | string | bool) -> string = v match
  int | bool -> "scalar"
  string -> "text"

// `_: int | string` is two alternatives now, each a type pattern, rather than a misplaced union.
either(v: int | string | bool) -> string = v match
  _: int | string -> "int or string"
  bool -> "bool"

// A built-in type's name inside a constructor tests the field.
held(h: Holder) -> string = h match
  Holder(int) -> "an int"
  Holder(string) -> "a string"
  Holder(_) -> "something"
  Empty -> "nothing"

pairKind(p: Pair) -> string = p match
  Pair(int, string) -> "int, string"
  Pair(int, _) -> "int, other"
  Pair(string, bool) -> "string, bool"
  Pair(string, _) -> "string, other"

// The test on a type parameter answers by the type the function is called at.
isInt[T](x: T) -> bool = x is int

isText[T](x: T) -> bool = x is not string

// Clauses take the type patterns as any other pattern.
describe(x: Any) -> string
describe(int) = "an int"
describe(char) = "a char"
describe(_) = "not an int or a char"

// A built-in name inside a tuple pattern tests that part.
parts(t: (Any, Any)) -> string = t match
  (int, string) -> "int and string"
  (int, int) -> "two ints"
  (_, real) -> "ends in a real"
  _ -> "other"

main()
  // `is` on each built-in type, true for the value's own type and false for another.
  val values: Vector[Any] = [
    1,
    long(5000000000),
    i8(-3),
    i16(300),
    i128(7),
    i7(5),
    byte(7),
    2.5,
    true,
    'é',
    "héllo",
    (),
    Box(1)
  ]
  for v in values do println(kind(v))
  val n: Any = 42
  println(n is int, n is long, n is string, n is i32, n is i64)
  val l: Any = long(9)
  println(l is long, l is i64, l is int)
  val s: Any = ""
  println(s is string, s is char, s is not string, s is not int)
  val u: Any = ()
  println(u is unit, u is bool)
  // `!` and `||`, `&&` with the type tests.
  println(!(n is int), n is int && s is string, n is string || s is string)
  // An `if` taking the type test, and its negation.
  if n is int then println("n holds an int")
  if s is not int then println("s holds no int")
  // Unions.
  println(size(3), size("three"))
  println(group(1), group(true), group("x"))
  println(either(1), either("a"), either(false))
  val m: int | string = "member"
  println(m is int, m is string, m is not int)
  // Nested.
  println(held(Holder(1)), held(Holder("a")), held(Holder(2.0)), held(Empty))
  println(pairKind(Pair(1, "x")), pairKind(Pair(1, 2)), pairKind(Pair("a", false)), pairKind(Pair("a", 'c')))
  val o: Option[Any] = Some(3)
  println(o is Some(int), o is Some(string), o is not Some(int))
  // Generic instances.
  println(isInt(3), isInt("3"), isInt(long(3)), isText("t"), isText(1))
  // Clauses and `match` functions.
  println(describe(1), describe('c'), describe("s"))
  val names = values.map(match
    int | long -> "integer"
    string | char -> "text"
    _ -> "other")
  println(names.mkString(" "))
  // A lambda taking the test, and one capturing the value tested.
  println(values.count(v -> v is int || v is long))
  val captured: Any = 'x'
  val test = () -> captured is char
  println(test())
  // A tuple's parts.
  println(parts((1, "a")), parts((1, 2)), parts(("a", 1.5)), parts(("a", "b")))
  // A loop runs while the test holds.
  var current: Any = 3
  var steps = 0
  while current is int
    steps += 1
    current = if steps < 3 then steps else "done"
  println(steps)
  // A binding beside the type still binds: `n: int` and `n @ int`.
  val bound: Any = 41
  if bound is k: int then println(k + 1)
  val whole = bound match
    w @ int -> w is int
    _ -> false
  println(whole)
