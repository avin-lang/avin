// A list displays as `[1, 2, 3]`, as an array does, and its diagnostic form shows each element's;
// it displays only when its elements do, and then converts to `Display`, nested lists included.

class Plain

describe(x: Any) -> string = x match
    d: Display -> "displays as " + d.toString()
    _ -> "does not display"

main()
    val xs: List[int] = [1, 2, 3]
    println(xs)
    val e: List[string] = []
    val words: List[string] = ["a", "b"]
    println(s"$e ${debug(words)} $words")
    val nested: List[List[int]] = [[1], [], [2, 3]]
    println(nested)
    val d: Display = xs
    println(d.toString())
    println(describe(xs))
    val ps: List[Plain] = [Plain()]
    println(describe(ps))
    val arrays: List[Array[int]] = [Array.fill(2, 7)]
    println(arrays)
    val listed: Array[List[string]] = Array.fill(1, words)
    println(debug(listed))
    xs.display(StandardOutput, FormatSpec(width = 11))
    println("|")
    val shown: List[Display] = [xs, nested]
    println(shown)
