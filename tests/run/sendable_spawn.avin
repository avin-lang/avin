// expect: exit 0
// What a thread's body may capture: immutable values (strings, tuples, data, vectors, lists, an
// `ArraySeq` frozen from an array, an object with no `var`, a trait that promises `Sendable`), the
// synchronized types (`Mutex`, `Atomic`, `Channel`, `Once`, a `Condition`, an `Executor`, a `Thread`
// of a sendable result), a `val` copied from a `var`, a type parameter bounded by `Sendable`, and
// whatever it makes itself. A parameter marked `@sendable` passes a body on, strict or by-name, and an
// override may keep the mark or drop it. A method value of an immutable object, a local function
// using only `val`s, and threads started from threads all qualify. A mutex's value is made in its
// argument, which may read a `var` of a sendable type, and a `with` body may assign one.
import avin.threads.{Atomic, Channel, Executor, Future, Mutex, Once, scope, spawn}

data Point(x: int, y: int)

class Box(val label: string, val items: Vector[int])
    total() -> int = items.sum()

trait Named: Sendable
    name() -> string

class Tag(val text: string): Named
    override name() -> string = text

trait Starter
    start(@sendable body: () -> int) -> int

class ThreadStarter(): Starter
    override start(@sendable body: () -> int) -> int = spawn(body).join()

class InlineStarter(): Starter
    override start(body: () -> int) -> int = body()

background[T: Sendable](@sendable body: () -> T) -> T = spawn(body).join()

later[T: Sendable](@sendable body: -> T) -> Future[T] = Future(body)

twice[T: Sendable](x: T) -> (T, T) = spawn(() -> (x, x)).join()

main() -> int
    val word = "héllo, 世界"
    val pair = (1, "one")
    val p = Point(3, 4)
    val v = [1, 2, 3]
    val l = List(4, 5)
    val frozen = Array.fill(3, 7).toArraySeq()
    val box = Box("b", [10, 20])
    val named: Named = Tag("tag")
    println(spawn(() -> s"$word ${pair.1} ${p.x + p.y} ${v.sum()} ${l.sum()} ${frozen.sum()} ${box.total()} ${named.name()}").join())

    val m = Mutex(Buffer[int]())
    val count = Atomic(0)
    val ch = Channel[int]()
    val once = Once()
    val ready = m.condition()
    val ex = Executor.fixed(2)
    val workers = (0..<4).map(i ->
        spawn(() ->
            once.run(() -> count.add(100))
            m.with(b -> b.addOne(i))
            ready.notifyAll()
            ch.send(i)
            ex.future(i * i).await())).toVector()
    var squares = 0
    for w in workers do squares += w.join()
    ch.close()
    var sent = 0
    for x in ch do sent += x
    println(s"squares $squares sent $sent count ${count.load()} held ${m.with(b -> b.length())}")
    val first = workers(0)
    println(spawn(() -> first.join()).join())
    ex.shutdown()

    var n = 5
    n += 1
    val copied = n
    println(spawn(() -> copied * 2).join())
    println(twice(p))
    println(background(() -> word.charCount()))
    println(later(v.length() + 1).await())
    val starters: Vector[Starter] = [ThreadStarter(), InlineStarter()]
    println(starters.map(st -> st.start(() -> p.x)).sum())

    println(spawn(() ->
        val own = Buffer[int]()
        for i in 0..<10 do own.addOne(i)
        val inner = () -> own.length()
        inner()).join())
    println(spawn(box.total).join())
    limit() -> int = v.length() + l.length()
    println(spawn(() -> limit()).join())
    println(spawn(() -> spawn(() -> spawn(() -> p.y).join()).join()).join())
    println(scope(s -> s.spawn(() -> v.length()).join() + s.spawn(() -> 1).join()))

    var start = 2
    val guarded = Mutex(Array.fill(start, 0).toBuffer())
    var seen = 0
    guarded.with(b ->
        seen = b.length()
        b.addOne(start))
    println(s"guarded ${guarded.with(b -> b.length())} seen $seen")
    val total = Mutex(0)
    total.update(t -> t + 5)
    total.set(total.get() + 1)
    println(total.get())
    0
