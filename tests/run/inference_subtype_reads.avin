// expect: exit 0
// Where a value is read out, inference still sees a subclass as its superclass and a type as a trait
// it conforms to: the whole parameter, a covariant argument, a tuple part, a function's result; an
// invariant argument that names the class itself still takes it; and a lambda passed for a function
// taking the superclass is checked with that parameter type.
open class Shelf[A](val item: A)

class TallShelf[A](x: A, val height: int): Shelf[A](x)

class Box[A](var v: A)

trait Named
  label() -> string

data Tag(text: string)

impl Named for Tag
  label() -> string = text

whole[A](x: Shelf[A]) -> A = x.item

inside[A](x: Option[Shelf[A]]) -> Option[A] = x.map(s -> s.item)

parts[A](x: (Shelf[A], int)) -> A = x.0.item

made[A](f: (int) -> Shelf[A]) -> A = f(3).item

exact[A](x: Box[Shelf[A]]) -> A = x.v.item

named[A](x: Option[A], show: (A) -> Named) -> string = x.map(a -> show(a).label()).getOrElse("-")

taking[B](f: (Shelf[int]) -> B) -> B = f(TallShelf(8, 1))

labels[T: Named](xs: Vector[T]) -> Vector[string] = xs.map(x -> x.label())

main()
  println(whole(TallShelf(1, 2)))
  println(inside(Some(TallShelf("in", 2))))
  println(parts((TallShelf(2.5, 0), 1)))
  println(made(n -> TallShelf(n * 2, n)))
  val box: Box[Shelf[int]] = Box(TallShelf(4, 4))
  println(exact(box))
  println(named(Some(1), n -> Tag(s"tag$n")))
  println(taking(s -> s.item + 1))
  println(labels([Tag("a"), Tag("ü")]))
