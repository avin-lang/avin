// expect: trap
// A body reader's read of one byte answers one; a read of none traps, as `io.Reader` asks at least one.
import avin.net.http.ServerRequest

main()
  val r = ServerRequest("POST", "/", body = Array.tabulate(3, i -> byte(int('a') + i)))
  val reader = r.bodyReader()
  println(reader.read(1).map(b -> b.length))
  println(reader.read(0).isOk)
