// expect: exit 0
// Captures reach through local functions to the top-level parameters, through generic code at
// each instance, and through lambdas inside lambdas; function values live in data fields and
// tuple parts; a recursive local function is passed as a value; a destructured `var` and a unit
// `var` are captured and assigned.

data Op(name: string, run: (int, int) -> int)

data Pair[A](first: A, second: A)

outerParam(n: int) -> int
    inner(k: int) -> int
        val f = (x: int) -> x + k + n
        f(1)
    inner(10)

both[T](x: T, y: T, pick: (T, T) -> T) -> Pair[T]
    val keep = (a: T) -> Pair(a, pick(x, y))
    keep(x)

applyTo(f: (int) -> int) -> int = f(5)

describe(n: int) -> () -> string = n match
    0 -> () -> "zero"
    k -> () -> s"some $k"

main() -> int
    print(s"${outerParam(100)}")
    val p = both(3, 4, (a, b) -> a * b)
    print(s"${p.first} ${p.second}")
    val q = both("x", "y", (a, b) -> b + a)
    print(q.first + q.second)
    fact(n: int) -> int = if n <= 1 then 1 else n * fact(n - 1)
    print(s"${applyTo(fact)}")
    var c = 0
    val f = () ->
        val g = () -> c += 1
        g()
        g()
    f()
    f()
    print(s"$c")
    var (a, b) = (1, 2)
    val swap = () ->
        a, b = b, a
    swap()
    print(s"$a $b")
    var u = ()
    val touch = () -> u = ()
    touch()
    val add = Op("add", (x, y) -> x + y)
    print(s"${add.name} ${add.run(2, 3)}")
    val fs = (applyTo, (x: int) -> x - 1)
    print(s"${fs.0(fs.1)}")
    print(describe(0)() + " " + describe(7)())
    0
