// expect: trap
// A part's content type is written as a header, so one holding a line break traps as the part is
// made, before anything could be sent.
import avin.net.http.Part

main()
  println(Part.file("f", "a.txt", "text/plain; charset=utf-8", Array.empty[byte]()).contentType)
  println(Part.file("f", "a.txt", "text/plain\r\nX-Injected: 1", Array.empty[byte]()).contentType)
