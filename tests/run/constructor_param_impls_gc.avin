// expect: exit 0
// Methods added to the applications of a constructor parameter, under allocation pressure: each
// call makes fresh strings and containers through the constructor's own `map` and `point`, and the
// results are held in a collection and in closures while many more are made, at several
// constructors and through a nested `F[G[A]]`, so a collection in between must keep every one.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

trait Pointed[A]: Mappable[A]
  static point[X](value: X) -> Self[X]

data Cell[T](value: T)

impl Pointed for Cell
  static point[X](value: X) -> Cell[X] = Cell(value)
  map[B](f: (T) -> B) -> Cell[B] = Cell(f(value))

class Crate[T](val item: T): Pointed[T]
  static point[X](value: X) -> Crate[X] = Crate(value)
  map[B](f: (T) -> B) -> Crate[B] = Crate(f(item))

impl Pointed for Option
  static point[X](value: X) -> Option[X] = Some(value)

impl Pointed for Vector
  static point[X](value: X) -> Vector[X] = Vector(value)

impl[F[_]: Pointed, A: Display] F[A]
  tagged(n: int) -> F[string] = map(a -> s"$a#$n")

impl[F[_]: Pointed, A] F[A]
  wrapped() -> F[F[A]] = F.point(self)

impl[F[_]: Mappable, G[_]: Mappable, A] F[G[A]]
  mapIn[B](f: (A) -> B) -> F[G[B]] = map(g -> g.map(f))

churn[F[_]: Pointed](seed: F[int], n: int) -> Vector[F[string]]
  var out: Vector[F[string]] = Vector()
  for i in 0 ..< n
    out = out :+ seed.tagged(i)
  out

main()
  val cells = churn(Cell(1), 2000)
  val crates = churn(Crate(2), 2000)
  val options = churn(Some(3), 2000)
  val vectors = churn(Vector(4, 5), 500)
  var keep: Vector[() -> string] = Vector()
  for i in 0 ..< 1000
    val w = Some(s"w$i").wrapped()
    keep = keep :+ (() -> w.mapIn(s -> s + "!").toString())
  val nested = Vector.tabulate(1000, i -> Some(Cell(i))).map(o -> o.mapIn(n -> s"n$n"))
  println(cells(0).value)
  println(cells(1999).value)
  println(crates(1234).item)
  println(options(1999))
  println(vectors(499))
  println(keep(0)())
  println(keep(999)())
  println(nested(999).map(c -> c.value))
  println(cells.length + crates.length + options.length + vectors.length)
