// expect: exit 0
// Sysl's `IoError` has the case `NoAttribute`, what the platform answers when a file has no extended
// attribute of the name asked for. A mirror names it, the platform's own code for it comes back as
// that case and as no other, and it has a sentence of its own, which is what the library's `Other`
// kind carries for it.
@sysl("sysl.fs.IoError")
data SyslError
  NotFound
  PermissionDenied
  AlreadyExists
  NotADirectory
  IsADirectory
  DirectoryNotEmpty
  TooManyOpenFiles
  NoSpaceLeft
  Interrupted
  NotOpen
  NotPermitted
  InvalidUtf8(offset: long)
  NoAttribute
  Other(code: int)

@sysl("sysl.fs.from_errno")
fromCode(code: int) -> SyslError

@sysl("avin.rt.io_error_message")
message(e: SyslError) -> string

@sysl("sysl.hint.black_box")
same(e: SyslError) -> SyslError

// The kind a library module gives each case: the ones a program tells apart by name, and every
// other one by its sentence.
kind(e: SyslError) -> string
kind(NotFound) = "NotFound"
kind(InvalidUtf8(at)) = s"InvalidUtf8($at)"
kind(e) = if message(e).isEmpty then "Other with no sentence" else "Other"

name(e: SyslError) -> string
name(NoAttribute) = "NoAttribute"
name(NotFound) = "NotFound"
name(Other(_)) = "Other"
name(_) = "another case"

main()
  // The code is 93 on macOS and the BSDs and 61 on Linux; each platform gives the other code
  // another meaning.
  val codes = [93, 61].filter(c -> fromCode(c) is NoAttribute)
  println(s"codes that are NoAttribute: ${codes.length}")
  val e = fromCode(codes(0))
  println(name(e))
  println(kind(e))
  println(message(e) != message(NotFound))
  println(message(e) == message(NoAttribute))
  // Into Sysl and back, it is still the same case.
  println(name(same(NoAttribute)))
  println(same(NoAttribute) == NoAttribute)
  println(NoAttribute == NotFound)
  // Its neighbours in the enum are still themselves.
  println(name(fromCode(2)))
  println(kind(fromCode(2)))
  println(name(fromCode(5)))
  println(name(same(InvalidUtf8(7))))
  println(kind(same(InvalidUtf8(7))))
