// expect: exit 0
// `long` is `i64`: the two names are one type, interchangeable in annotations, conversions and
// calls.

twice(n: i64) -> long = n * 2

widen(n: int) -> long = long(n)

main() -> int
  val a: long = 9223372036854775807
  val b: i64 = a
  if twice(widen(21)) != 42 then return 1
  if b != a || i64(widen(-1)) != -1 then return 2
  if long(int(7)) * 3 != 21 then return 3
  0
