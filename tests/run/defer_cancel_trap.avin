// expect: trap
// A deferred statement a cancellation runs is ordinary code: one that traps stops the program, as any
// trap does, and nothing more runs, neither the deferred statements below it nor the scope after.
import avin.threads.{Atomic, scope, sleep}
import avin.time.{hours, millis}

worker(started: Atomic[int], divisor: int)
  defer println("outer cleanup, never run")
  defer
    println("cleanup dividing")
    println(100 / divisor)
  started.add(1)
  sleep(hours(1))

main()
  val started = Atomic(0)
  scope(s ->
    s.spawn(() -> worker(started, started.load()))
    while started.load() == 0 do sleep(millis(1))
    s.cancel())
  println("after the scope, never run")
