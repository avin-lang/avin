// expect: exit 0
// `BigInt`'s `+`, `-`, `*`, `/`, `%`, unary `-`, `floorDiv` and `floorMod` agree with `long`'s on
// every pair of a set of values around zero, the limb base and the edges of `long`, wherever the
// `long` result does not overflow; and the carries and borrows that cross a limb come out exact.

val samples: Vector[long] = [0, 1, -1, 2, -2, 7, -7, 999999999, -999999999, 1000000000, -1000000000,
    1000000001, -1000000001, 999999999999999999, -999999999999999999, 1000000000000000000,
    -1000000000000000000, 3037000499, -3037000499, 4611686018427387904, -4611686018427387904,
    9223372036854775807, -9223372036854775807, -9223372036854775807 - 1]

val ops: Vector[string] = ["+", "-", "*", "/", "%", "floorDiv", "floorMod"]

// `op` on two `BigInt`s; a zero divisor is left to the caller.
big(op: string, a: BigInt, b: BigInt) -> BigInt
big("+", a, b) = a + b
big("-", a, b) = a - b
big("*", a, b) = a * b
big("/", a, b) = a / b
big("%", a, b) = a % b
big("floorDiv", a, b) = a.floorDiv(b)
big(_, a, b) = a.floorMod(b)

// `op` on two `long`s, called only where it neither overflows nor divides by zero.
small(op: string, a: long, b: long) -> long
small("+", a, b) = a + b
small("-", a, b) = a - b
small("*", a, b) = a * b
small("/", a, b) = a / b
small("%", a, b) = a % b
small("floorDiv", a, b) = a.floorDiv(b)
small(_, a, b) = a.floorMod(b)

// Whether `long` itself can compute `op` on `a` and `b`, worked out without overflowing.
longCan(op: string, a: long, b: long) -> bool
    if (op == "/" || op == "%" || op == "floorDiv" || op == "floorMod") && b == 0 then return false
    if op == "%" || op == "floorMod" then return !(a == long.MinValue && b == -1)
    val exact = big(if op == "floorDiv" then "/" else op, BigInt(a), BigInt(b))
    BigInt(long.MinValue) <= exact <= BigInt(long.MaxValue)

main()
    var checked = 0
    var wrong = 0
    for op in ops
        for a in samples
            for b in samples
                if longCan(op, a, b)
                    checked += 1
                    if big(op, BigInt(a), BigInt(b)).toLongOption != Some(small(op, a, b))
                        wrong += 1
                        println(s"wrong: $a $op $b")
    println(s"checked $checked, wrong $wrong")
    // Negation, including of the least long, whose magnitude no long holds.
    for a in samples
        val text = if a == long.MinValue then "9223372036854775808" else (-a).toString()
        if (-BigInt(a)).toString() != text then println(s"wrong negation of $a")
    println(-BigInt(long.MinValue))
    println(-BigInt(0) == 0)
    println(-(-BigInt(5)))
    // Results past long: a carry into a new limb, a borrow across every limb.
    println(BigInt(long.MaxValue) + 1)
    println(BigInt(long.MinValue) - 1)
    println(BigInt(long.MinValue) * long.MinValue)
    println(BigInt(long.MaxValue) * BigInt(long.MinValue))
    println(BigInt("999999999999999999999999999") + 1)
    println(BigInt("1000000000000000000000000000") - BigInt(1))
    println(BigInt("-1000000000000000000000000000") + 1)
    println(1 - BigInt("1000000000000000000000000000"))
    println(BigInt("123456789123456789") - BigInt("123456789123456789"))
    println(BigInt("-5") + BigInt("5"))
    println(BigInt("999999999999999999") * BigInt("999999999999999999"))
    println(BigInt(0) * BigInt("-123456789012345678901234567890"))
    // Signs of the truncating and the floored quotient and remainder, on many-limb numbers.
    val n: BigInt = 100000000000000000000000000007
    val d: BigInt = 3000000000000000000001
    for (x, y) in [(n, d), (-n, d), (n, -d), (-n, -d)]
        val q = x / y
        val r = x % y
        val fq = x.floorDiv(y)
        val fr = x.floorMod(y)
        println(s"$q $r $fq $fr ${q * y + r == x} ${fq * y + fr == x}")
    println(BigInt(-7).divRem(2))
    println(BigInt(0) / BigInt("-123456789012345678901234567890"))
    println(BigInt(0) % -3)
    println(BigInt(5) / BigInt(7))
    println(BigInt(-5) % 7)
    println(BigInt(-6).floorMod(3))
    println(BigInt("123456789012345678901234567890") / BigInt("123456789012345678901234567890"))
    println(BigInt("123456789012345678901234567890") % BigInt("123456789012345678901234567890"))
