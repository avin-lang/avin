import avin.io

// `readLine` yields each line without its terminator: `\n` and `\r\n` both end a line, a bare `\r`
// inside one is kept, an empty line is `Some("")`, UTF-8 text arrives whole, and the last line needs no
// terminator. After it, `readLine` is `None`, and stays so.
main()
    var n = 0
    var line = io.readLine()
    while line.isSome()
        n += 1
        val text = line.getOrElse("")
        println(s"$n: ${debug(text)} ${text.byteLength()} bytes, ${text.charCount()} chars")
        line = io.readLine()
    println(io.readLine().isNone())
    println(io.readAll().isEmpty())
