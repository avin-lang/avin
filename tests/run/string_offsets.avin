// expect: exit 0
// A string read at byte offsets: `byteAt` gives one byte of the encoding, `charAt` the character
// whose encoding begins there, and `startsWith(prefix, at)` whether `prefix` occurs there, false
// rather than a trap when it would reach outside the string.

main()
    val s = "aé中\u{1F600}z"
    println(s"${s.byteLength} ${int(s.byteAt(0))} ${int(s.byteAt(1))} ${int(s.byteAt(2))}")
    println(s"${s.charAt(0)} ${s.charAt(1)} ${s.charAt(3)} ${s.charAt(6)} ${s.charAt(10)}")
    println(s"${s.startsWith("a", 0)} ${s.startsWith("é中", 1)} ${s.startsWith("中", 1)}")
    println(s"${s.startsWith("z", 10)} ${s.startsWith("z", 11)} ${s.startsWith("", 11)} ${s.startsWith("a", -1)} ${s.startsWith("zz", 10)}")
