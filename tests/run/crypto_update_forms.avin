// expect: exit 0
// Every hasher takes its input as a vector, as an array or as a range of either, and all forms
// give the digest of the same bytes: whole, in pieces, from the middle of a buffer, empty.

import avin.crypto.{Sha256, Sha512, Sha1, Md5, sha256, sha512, sha1, md5, toHex}

main(args: Vector[string])
  val text = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
  val vec = text.bytes
  val arr = Array.tabulate(vec.length, i -> vec(i))

  // The array form.
  val a = Sha256()
  a.update(arr)
  println(toHex(a.finish()))
  println(a.finish() == sha256(vec))

  // The range forms of both, over the whole input, in pieces, and in the middle.
  val b = Sha256()
  b.update(vec, 0, 20)
  b.update(arr, 20, 40)
  b.update(vec, 40, vec.length)
  println(b.finish() == sha256(vec))

  val mid = Sha256()
  mid.update(arr, 4, 9)
  println(mid.finish() == sha256(text.slice(4, 9)))
  val midVec = Sha256()
  midVec.update(vec, 4, 9)
  println(midVec.finish() == sha256(text.slice(4, 9)))

  // Empty ranges and an empty array add nothing.
  val e = Sha256()
  e.update(vec, 0, 0)
  e.update(arr, 56, 56)
  e.update(Array.fill(0, byte(0)))
  e.update(vec, vec.length, vec.length)
  println(toHex(e.finish()))

  // An array written after `update` does not change what was hashed.
  val buf = Array.tabulate(3, i -> byte(97 + i))
  val c = Sha256()
  c.update(buf)
  buf(0) = byte(0)
  println(toHex(c.finish()) == toHex(sha256("abc")))

  // The other digests, in all four forms.
  val abc = "abc".bytes
  val abcArr = Array.tabulate(3, i -> abc(i))
  val h512 = Sha512()
  h512.update(abcArr)
  val h512r = Sha512()
  h512r.update(abc, 0, 3)
  val h512a = Sha512()
  h512a.update(abcArr, 1, 3)
  println(h512.finish() == sha512(abc))
  println(h512r.finish() == sha512(abc))
  println(h512a.finish() == sha512("bc"))
  val h1 = Sha1()
  h1.update(abcArr)
  val h1r = Sha1()
  h1r.update(abc, 1, 3)
  val h1a = Sha1()
  h1a.update(abcArr, 0, 2)
  println(h1.finish() == sha1(abc))
  println(h1r.finish() == sha1("bc"))
  println(h1a.finish() == sha1("ab"))
  val m = Md5()
  m.update(abcArr)
  val mr = Md5()
  mr.update(abc, 2, 3)
  val ma = Md5()
  ma.update(abcArr, 0, 1)
  println(m.finish() == md5(abc))
  println(mr.finish() == md5("c"))
  println(ma.finish() == md5("a"))

  // A large buffer fed in slices, under GC pressure from the garbage made between slices.
  val big = Array.tabulate(100000, i -> byte(i % 251))
  val bigVec = Vector.tabulate(100000, i -> byte(i % 251))
  val s = Sha256()
  var at = 0
  var junk = 0
  while at < 100000
    val next = if at + 7777 < 100000 then at + 7777 else 100000
    s.update(big, at, next)
    junk += Vector.tabulate(500, i -> i).length
    at = next
  println(s.finish() == sha256(bigVec))
  println(junk)
