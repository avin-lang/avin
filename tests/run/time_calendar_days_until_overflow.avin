// expect: trap
// The days from `Date.Min` to `Date.Max` are more than an `int` holds, and the count traps as an
// integer overflow does, while the count down from `Date.Max` to the day before the epoch is the
// least `int` exactly.
import avin.time.{Date}

main()
  println(Date.Max.daysUntil(Date(-1)))
  println(Date.Min.daysUntil(Date.Max))
