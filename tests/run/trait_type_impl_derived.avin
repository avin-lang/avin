// expect: exit 0
// A derived impl finds a trait type's own conformance for a field as a written impl does: a field
// typed as the trait, as a type argument, nested, in a variant and as the argument of a generic
// type deriving the trait, each by its static type. A generic trait whose parameter is bounded is
// implemented for a trait type, and its argument may be a trait type meeting the bound by its own
// conformance.
trait Describe
  describe() -> string

impl Describe for int
  describe() -> string = s"$self"

impl[K: Describe, A: Describe] Describe for Map[K, A]
  describe() -> string
    var out = "{"
    for (k, v) in self
      out = out + k.describe() + ":" + v.describe() + ";"
    out + "}"

impl[K: Describe, A: Describe] Describe for TreeMap[K, A]
  describe() -> string = s"tree of $size"

impl[A: Describe] Describe for Vector[A]
  describe() -> string
    var out = "["
    for x in self
      out = out + x.describe() + ","
    out + "]"

impl[A: Describe] Describe for Option[A]
  describe() -> string = self match
    Some(x) -> "some " + x.describe()
    None -> "none"

derive Describe for T
  describe() -> string = T.walk(self, Describer("")).text

data Describer(text: string)

impl ShapeVisitor for Describer
  variant(v: VariantShape) -> Describer = Describer(v.name)

impl Describer
  field[F: Describe](f: FieldShape, value: F) -> Describer = Describer(s"$text ${f.name}=${value.describe()}")

data Tally(
    counts: Map[int, int],
    rows: Vector[Map[int, int]],
    maybe: Option[Map[int, int]],
    own: TreeMap[int, int]
) derives Describe

data Pick derives Describe
  Held(m: Map[int, int])
  Bare

data Wrap[A](item: A) derives Describe

trait Into[T: Describe]
  into(extra: T) -> string

trait Shape
  area() -> int

class Square(side: int): Shape
  override area() -> int = side * side

impl Into[Map[int, int]] for Shape
  into(extra: Map[int, int]) -> string = s"shape ${area()} into " + extra.describe()

pour[T: Into[Map[int, int]]](x: T, m: Map[int, int]) -> string = x.into(m)

main()
  val m: Map[int, int] = {1: 2}
  val t = TreeMap((3, 4), (1, 2))
  val up: Map[int, int] = t
  println(Tally(m, [m, up, {}], Some(up), t).describe())
  println(Tally({}, [], None, t).describe())
  println(Pick.Held(up).describe())
  println(Pick.Bare.describe())
  // A generic type's argument decides: the trait type's impl, or the implementing type's own.
  println(Wrap(m).describe())
  println(Wrap(t).describe())
  println(Wrap[Map[int, int]](t).describe())
  val s: Shape = Square(2)
  println(s.into(m))
  println(pour(s, up))
  println(pour[Shape](Square(3), {}))
