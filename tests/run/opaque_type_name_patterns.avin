// expect: exit 0
// An opaque type's name in a pattern tests for the opaque type itself, exactly as `_: T` does: a
// value of it held as `Any` is that type and not its representation, and a value of the
// representation is not the opaque type. A plain alias's name tests for the type it stands for.
// The tests hold for an opaque type over another opaque type, inside a match, a closure and a
// generic function, and at every element of a large vector.

opaque type Name = string
opaque type Inner = int
opaque type Outer = Inner
opaque type Point = (int, int)
type Text = string

kind(v: Any) -> string = v match
  Name -> "name"
  string -> "string"
  Outer -> "outer"
  Inner -> "inner"
  int -> "int"
  Point -> "point"
  _ -> "other"

isName[T](v: T) -> bool = v is Name

made(i: int) -> Any = if i % 2 == 0 then Name(s"n$i") else s"s$i"

main()
  val n: Any = Name("hi")
  val s: Any = "hi"
  println(n is Name)
  println(n is _: Name)
  println(n is string)
  println(n is _: string)
  println(s is Name)
  println(s is _: Name)
  println(s is string)
  println(n is Text)
  println(s is Text)
  println(s is _: Text)
  val empty: Any = Name("")
  println(empty is Name)
  println(Name("é∑🙂") is Name)
  println(kind(n))
  println(kind(s))
  println(kind(Inner(-2147483648)))
  println(kind(Outer(Inner(2147483647))))
  println(kind(7))
  println(kind(Point((1, 2))))
  println(kind((1, 2)))
  println(kind(true))
  val test = (v: Any) -> v is Outer
  println(test(Outer(Inner(1))))
  println(test(Inner(1)))
  println(isName(Name("g")))
  println(isName("g"))
  val mixed = (0 ..< 2000).map(made).toVector
  println(mixed.count(v -> v is Name))
  println(mixed.count(v -> v is string))
  val m = n match
    Name if true -> "named"
    _ -> "not"
  println(m)
