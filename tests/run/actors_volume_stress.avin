// The shapes of `actors_million` and `actors_ten_thousand` at a size the collector's stress can run,
// collecting at every allocation while mailboxes hold messages in flight: a ring of 300 actors
// passing a token round three times, and 3999 messages from two threads and the main one to one
// actor, every one handled once and in each sender's order.
import avin.actors.{ActorRef, Behaviour, spawn}
import avin.threads.{Future, Promise}
import avin.threads as threads

data Msg
  Link(next: ActorRef[Msg])
  Token(laps: int, done: Promise[int])
  Seen(reply: Promise[int])

member(first: bool) -> Behaviour[Msg] = Behaviour("Member", me ->
  var next: Option[ActorRef[Msg]] = None
  var seen = 0
  m -> m match
    Link(n) -> next = Some(n)
    Token(laps, done) ->
      seen += 1
      if first && laps == 0 then done.complete(seen)
      else next.get.tell(Token(if first then laps - 1 else laps, done))
    Seen(reply) -> reply.complete(seen))

data Count
  Add(sender: int, seq: int, text: string)
  Total(reply: Promise[string])

summer() -> Behaviour[Count] = Behaviour("Summer", me ->
  val last = Array.fill(3, -1)
  var count = 0
  var bytes = 0
  var outOfOrder = 0
  m -> m match
    Add(s, n, text) ->
      if n != last(s) + 1 then outOfOrder += 1
      last(s) = n
      count += 1
      bytes += text.byteLength
    Total(reply) -> reply.complete(s"$count messages, $bytes bytes, $outOfOrder out of order"))

main()
  val n = 300
  val ring = (0 ..< n).map(i -> spawn(member(i == 0))).toVector
  for i in 0 ..< n do ring(i).tell(Link(ring((i + 1) % n)))
  val done = Promise[int]()
  ring(0).tell(Token(3, done))
  println(done.future.await())
  val counts = Future.all(ring.map(r ->
    val p = Promise[int]()
    r.tell(Seen(p))
    p.future)).await()
  println(counts.sum)

  val each = 1333
  val s = spawn(summer())
  val senders = (0 ..< 2).map(t -> threads.spawn(() ->
    for i in 0 ..< each do s.tell(Add(t, i, s"message $i from $t")))).toVector
  for i in 0 ..< each do s.tell(Add(2, i, "ü"))
  for t in senders do t.join()
  val p = Promise[string]()
  s.tell(Total(p))
  println(p.future.await())
