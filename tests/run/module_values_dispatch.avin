// expect: exit 0
// A call through a method table reaches every override, so a module value initialized by calling a
// method on an open class's or a trait's value initializes after the module values any override
// reads, wherever the file declares them. The calls are direct, through a trait, in an argument of
// another dispatch, and through a method value.

trait Namer
    label() -> string

open class Base
    name() -> string = "base"

class Derived: Base, Namer
    override name() -> string = "derived " + suffix
    override label() -> string = "labelled " + tag

class Other: Namer
    override label() -> string = "other " + tag

val viaClass = shout(pick().name())

val viaTrait = pickNamer().label()

val nested = pick().name() + "/" + pickNamer().label()

val method: () -> string = pick().name

val viaMethodValue = method()

val suffix = "late"

val tag = "tagged"

pick() -> Base = Derived()

pickNamer() -> Namer = Derived()

shout(s: string) -> string = s + "!"

main()
    print(viaClass)
    print(viaTrait)
    print(nested)
    print(viaMethodValue)
