// expect: trap
// A body limit of zero takes requests without bodies only; one below zero traps where the server
// starts.
import avin.net.http
import avin.net.http.Response

main()
    println(http.serve("127.0.0.1", 0, _ -> Response.empty(204), maxBodyBytes = 0).map(s -> s.shutdown()).isOk())
    println(http.serve("127.0.0.1", 0, _ -> Response.empty(204), maxBodyBytes = -1).isOk())
