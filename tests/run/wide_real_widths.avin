// Conversions between `real` and integers of every width class past 128 bits, at the edges of each
// width: its bounds, a tie at its top, and saturation; and past 2^1024, where a `real` is infinite.

two(k: int) -> real
    var r = 1.0
    for i in 0 ..< k do r = r * 2.0
    r

check129(z: int) -> int
    val one = i129(z) + 1
    val minimum = one << 128
    val maximum = -(minimum + 1)
    if real(maximum) != two(128) || real(minimum) != -two(128) then return 1
    if real((one << 127) + (one << 74)) != two(127) then return 2
    if real((one << 127) + (one << 74) + 1) != two(127) + two(75) then return 3
    if i129(two(128) + real(z)) != maximum || i129(-two(128) + real(z)) != minimum then return 4
    if i129(two(127) + real(z)) != one << 127 then return 5
    0

check192(z: int) -> int
    val one = i192(z) + 1
    val minimum = one << 191
    val maximum = -(minimum + 1)
    if real(maximum) != two(191) || real(minimum) != -two(191) then return 11
    if real((one << 150) * 3 + (one << 97)) != two(150) * 3.0 then return 12
    if real(-((one << 150) * 3 + (one << 98) + 1)) != -(two(150) * 3.0 + two(99)) then return 13
    if i192(two(200) + real(z)) != maximum || i192(-two(191) + real(z)) != minimum then return 14
    if i192((two(53) - 1.0) * two(137) + real(z)) != ((one << 53) - 1) << 137 then return 15
    0

check256(z: int) -> int
    val one = i256(z) + 1
    val minimum = one << 255
    val maximum = -(minimum + 1)
    if real(maximum) != two(255) || real(minimum) != -two(255) then return 21
    if real(minimum + 1) != -two(255) then return 22
    if i256(two(255) + real(z)) != maximum || i256(-two(255) + real(z)) != minimum then return 23
    if i256(-(two(53) - 1.0) * two(202) + real(z)) != -(((one << 53) - 1) << 202) then return 24
    0

check512(z: int) -> int
    val one = i512(z) + 1
    val minimum = one << 511
    val maximum = -(minimum + 1)
    if real(maximum) != two(511) || real(minimum) != -two(511) then return 31
    if real((one << 500) + (one << 447)) != two(500) then return 32
    if real((one << 500) + (one << 447) + (one << 3)) != two(500) + two(448) then return 33
    if i512(two(511) + real(z)) != maximum || i512(-1.0e150 + real(z)) != -(i512(1.0e150)) then return 34
    if real(i512(1.0e150 + real(z))) != 1.0e150 then return 35
    0

// Wide enough to hold numbers no `real` reaches.
check2000(z: int) -> int
    val one = i2000(z) + 1
    val biggest = (two(53) - 1.0) * two(971)
    if real(one << 1023) != two(1023) then return 41
    if real((one << 1024) - (one << 971)) != biggest then return 42
    if real((one << 1024) - (one << 970) - 1) != biggest then return 43
    if real((one << 1024) - (one << 970)) != 1.0 / real(z) then return 44
    if real(one << 1024) != 1.0 / real(z) then return 45
    if real(one << 1999) != -1.0 / real(z) then return 46
    if i2000(biggest + real(z)) != (one << 1024) - (one << 971) then return 47
    if i2000(-biggest + real(z)) != (one << 971) - (one << 1024) then return 48
    val minimum = one << 1999
    if i2000(1.0 / real(z)) != -(minimum + 1) || i2000(-1.0 / real(z)) != minimum then return 49
    if i2000(real(z) / real(z)) != 0 then return 50
    0

main(args: Vector[string]) -> int
    // Zero from the arguments, so that nothing is folded at compile time.
    val z = args.length
    var failed = check129(z)
    if failed == 0 then failed = check192(z)
    if failed == 0 then failed = check256(z)
    if failed == 0 then failed = check512(z)
    if failed == 0 then failed = check2000(z)
    failed
