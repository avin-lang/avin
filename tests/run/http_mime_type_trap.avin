// expect: trap
// A content type is sent as a header's value, so it holds no line break: one with a parameter is
// taken, and one holding `\n` traps where the table is extended.
import avin.net.http.MimeTypes

main()
  println(MimeTypes.standard.with("avin", "text/x-avin; charset=utf-8").typeOf("m.avin"))
  println(MimeTypes.standard.with("avin", "text/x-avin\nX-Evil: 1").typeOf("m.avin"))
