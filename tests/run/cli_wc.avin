// expect: exit 0
// args: -lw --top=2 one.txt two.txt
// A word counter reading its command line with `avin.cli`: two flags bundled as `-lw`, an int option
// given with `=`, and the files as the positional arguments that take the rest. The files are texts
// held by the program, so its output does not depend on the disk.
import avin.cli

val parser = cli.Parser("wc", "Count lines, words and characters.")
    .flag("lines", short = 'l', help = "count lines")
    .flag("words", short = 'w', help = "count words")
    .int("top", help = "list the N commonest words", value = "N")
    .positionals("file", help = "the files to count", required = true)

val texts = HashMap(
    ("one.txt", "the cat sat\non the mat\n"),
    ("two.txt", "a dog\nthe dog ran and the dog sat\n")
)

topWords(text: string, n: int) -> Vector[(string, int)] =
    val freq = text.lines
        .flatMap(_.split(" "))
        .filter(_.nonEmpty)
        .groupBy(w -> w)
        .map((k, v) -> (k, v.length))
        .toVector
    freq.sortBy(p -> (-p.1, p.0)).take(n)

main(args: Vector[string]) -> int
    val opts = parser.parseOrExit(args)
    var total = 0
    for f in opts.strings("file")
        val text = texts(f)
        val lines = text.lines.length
        val words = text.lines.flatMap(_.split(" ")).filter(_.nonEmpty).length
        total += lines
        var row = ""
        if opts.flag("lines") then row = row + f"$lines%6d"
        if opts.flag("words") then row = row + f"$words%6d"
        println(s"$row $f")
        for (w, k) in topWords(text, opts.int("top"))
            println(f"   $w%-12s $k%4d")
    println(s"total lines: $total")
    0
