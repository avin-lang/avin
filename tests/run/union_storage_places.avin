// expect: exit 0
// A union with a scalar member is stored as its words wherever it is kept: a data value's field, a
// class's `var` field, a tuple's part, an array's element, a vector's, a buffer's and a map's, an
// option's value, a generic class's field at a union type argument, a closure's capture, a captured
// `var`, a module-level `val`, `var` and `lazy val`, and a class's `lazy val`. Each holds either kind
// of member, is replaced by the other kind, and reads back the value stored, with `==`, the hash and
// its rendering unchanged; a value moves between places (field → local → array → capture → result)
// keeping its member.

data Holder(label: string, value: int | string)

data Pair(first: long | bool, second: char | string)

class Box(var current: real | string)

class Slot[T](var item: T)

class Lazy(seed: int)
    lazy val shown: int | string = if seed > 0 then s"lazy $seed" else seed

val moduleValue: long | string = s"mod ${1 + 1}"
var moduleVar: int | bool = 3
lazy val lazyValue: char | string = 'z'

made(i: int) -> int | string = if i % 3 == 0 then s"s$i" else i * 7

split(i: int) -> (int | string, int) = (made(i), i)

describe(u: int | string) -> string = u match
    n: int -> s"int $n"
    s: string -> s"string $s"

// A union read out of a field, put in an array, captured, and returned from the closure.
travel(h: Holder) -> int | string
    val local = h.value
    val arr: Array[int | string] = Array.fill(2, 0)
    arr(1) = local
    val captured = arr(1)
    val f = () -> captured
    f()

main()
    // A data value's field, both kinds of member, and its equality and hash.
    val h1 = Holder("a", made(3))
    val h2 = Holder("b", made(1))
    println(s"${h1.value} ${h2.value} ${describe(h1.value)} ${describe(h2.value)}")
    println(h1 == Holder("a", "s3"))
    println(h2 == Holder("b", 7))
    println(h1 == Holder("a", 3))
    println(h1.hash() == Holder("a", "s3").hash())
    println(h1)
    println(Pair(true, 'q'))
    println(Pair(long(-1), "p"))
    // A class's var field, replaced by the other kind and back.
    val b = Box(0.5)
    b.current = "now"
    println(b.current)
    b.current = -0.0
    println(b.current)
    b.current = s"again ${b.current}"
    println(b.current)
    // A generic class at a union type argument.
    val slot = Slot[int | string](4)
    slot.item = "four"
    println(slot.item)
    slot.item = 44
    println(slot.item)
    // A tuple's part.
    val t: (int | string, bool) = (made(2), true)
    val t2: (int | string, bool) = (made(6), false)
    val again: (int | string, bool) = (14, true)
    println(s"$t $t2 ${t == again} ${t == t2} ${t2.0} ${t.0.hash() == 14.hash()}")
    // A tuple with a union part taken apart from a call.
    val (part, index) = split(4)
    val (part2, index2) = split(3)
    println(s"$part $index $part2 $index2")
    // An array's elements.
    val arr: Array[int | string] = Array.fill(3, made(0))
    arr(1) = 9
    println(s"${arr(0)} ${arr(1)} ${arr(2)}")
    arr(0) = 10
    arr(2) = "two"
    println(s"${arr(0)} ${arr(1)} ${arr(2)}")
    // A vector's, a buffer's and a map's.
    var v: Vector[int | string] = []
    for i in 0..<6 do v = v :+ made(i)
    println(v)
    val buf: Buffer[byte | char | string] = Buffer()
    buf.append(byte(255))
    buf.append('é')
    buf.append("s")
    buf(0) = "replaced"
    println(buf)
    var m: Map[string, int | string] = {}
    m = m.updated("a", 1)
    m = m.updated("b", "two")
    println(s"${m.get("a")} ${m.get("b")} ${m.get("c")}")
    // An option's value.
    val o: Option[int | string] = Some(made(1))
    val o2: Option[int | string] = Some(made(0))
    val seven: Option[int | string] = Some(7)
    println(s"$o $o2 ${o == seven} ${o2 == seven}")
    // Module-level values.
    println(moduleValue)
    println(moduleVar)
    moduleVar = false
    println(moduleVar)
    moduleVar = 12
    println(moduleVar)
    println(lazyValue)
    // A class's lazy val.
    println(Lazy(3).shown)
    println(Lazy(-3).shown)
    // A captured var, replaced through the closure.
    var counter: int | string = 0
    val bump = () ->
        counter = counter match
            n: int -> if n > 1 then "big" else n + 1
            s: string -> s + "!"
    for _ in 0..<4 do bump()
    println(counter)
    // A capture of each kind.
    val num: int | string = 5
    val text: int | string = "five"
    val f = () -> s"$num $text"
    println(f())
    // Moves between places.
    println(travel(h1))
    println(travel(h2))
