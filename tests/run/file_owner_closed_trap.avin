// expect: trap
// A closed file still belongs to its owner: while the thread that closed it runs, a `close` by the
// code that handed it over traps rather than answering `Ok`.
import avin.fs
import avin.threads.{Channel, spawn}

main()
  val dir = fs.createTempDir("file-owner").ok.get
  val f = fs.create(dir + "/a.txt").ok.get
  val closed = Channel[int]()
  val finish = Channel[int]()
  val t = spawn(() ->
    _ = f.close()
    closed.send(1)
    _ = finish.receive()
    f.isClosed())
  _ = closed.receive()
  println("closed by the thread")
  _ = f.close()
  println("not reached")
  finish.send(1)
  println(t.join())
