// expect: exit 0
// `Restart` starts a failed actor again from the same behaviour, with fresh state: its `stopping`
// block runs on the state the trap left, its body runs again, and the messages still in its mailbox
// stay there and are handled by the new state, in order; the message that trapped is dropped. Each
// restart is reported on standard error after the trap. Its reference, its number and its watchers
// stay: a restart is not an ending.
import avin.actors.{ActorRef, Restart, spawn}
import avin.threads.Channel
import avin.time

data Msg
    Add(n: int)
    Fail
    Get(reply: ActorRef[string])

actor Account(starts: Channel[string]) receives Msg
    var total = 0
    val history = Buffer[int]()
    starts.send(s"$self starts")
    receive
        Add(n) ->
            total += n
            history.append(n)
        Fail -> total = total / (total - total)
        Get(r) -> r.tell(s"$total from $history")
    stopping
        starts.send(s"$self stopping at $total")

data Seen
    Gone(e: string)

actor Watcher(target: ActorRef[Msg], out: Channel[string]) receives Seen
    watch(target, e -> Gone(e.toString()))
    out.send("watching")
    receive
        Gone(e) -> out.send(s"ended: $e")

main()
    val starts = Channel[string]()
    val a = spawn(Account(starts), onFailure = Restart(3, time.minutes(1)))
    println(starts.receive().get)
    val out = Channel[string]()
    spawn(Watcher(a, out))
    println(out.receive().get)
    a.tell(Add(1))
    a.tell(Add(2))
    a.tell(Fail)
    // Queued behind the failure: handled after the restart, by the fresh state.
    a.tell(Add(10))
    a.tell(Add(20))
    println(a.ask(r -> Get(r), timeout = time.seconds(60)).await())
    println(starts.receive().get)
    println(starts.receive().get)
    a.tell(Fail)
    a.tell(Add(5))
    println(a.ask(r -> Get(r), timeout = time.seconds(60)).await())
    println(starts.receive().get)
    println(starts.receive().get)
    // Still the same actor, never ended.
    println(a)
    println(a.ended().isCompleted())
    a.tell(Fail)
    println(a.ask(r -> Get(r), timeout = time.seconds(60)).await())
    println(starts.receive().get)
    println(starts.receive().get)
    println(out.tryReceive())
