// expect: exit 0
// An integer of any width meets a `BigInt` under an operator as a `BigInt`: each arithmetic operator
// with the integer on either side, at every width from `i1` to past `long`, compound assignment
// into a `BigInt`, comparisons and equality both ways and in chains, an integer through a type
// parameter bounded by `Integer`, and the results, which are exact where the integer's own
// arithmetic would overflow.

// Each of the five operators with the integer on the right and on the left.
both[N: Integer](label: string, b: BigInt, n: N)
  println(s"$label: ${b + n} ${b - n} ${b * n} ${b / n} ${b % n} | ${n + b} ${n - b} ${n * b} ${n / b} ${n % b}")

scaled[N: Integer](b: BigInt, n: N) -> BigInt = b * n + n

ordered[N: Integer](b: BigInt, n: N) -> string = s"${b < n} ${b <= n} ${b > n} ${b >= n} ${b == n} ${b != n} ${n < b} ${n == b}"

main()
  val b = BigInt(1000)
  val i = 7
  val l: long = -3
  val s: i8 = 6
  val h: i16 = 300
  val w: i128 = 170141183460469231731687303715884105727
  val v: i200 = -1234567890123456789012345678901234567890
  val one: i1 = -1
  // Every operator, every width, either side.
  println(b + i)
  println(i + b)
  println(b - i)
  println(i - b)
  println(b * i)
  println(i * b)
  println(b / i)
  println(i / b)
  println(b % i)
  println(i % b)
  println(b * l)
  println(l * b)
  println(b - s)
  println(s - b)
  println(b / h)
  println(h % b)
  println(b * w)
  println(w * b)
  println(w + b)
  println(b + v)
  println(v % b)
  println(b * one)
  println(one - b)
  // The integer's own arithmetic would overflow; the `BigInt`'s does not.
  println(BigInt(long.MaxValue) + long.MaxValue)
  println(long.MinValue * BigInt(long.MinValue))
  println(-BigInt(1) * w * w)
  // Through a type parameter bounded by `Integer`.
  both("i8", b, s)
  both("i16", b, h)
  both("int", b, i)
  both("long", b, l)
  both("i128", BigInt(w) * 3, w)
  println(scaled(b, s))
  println(scaled(b, v))
  // Precedence is the operators' own: the integer converts where it stands.
  println(i + b * i)
  println((i + b) * i)
  println(-i * b)
  println(b * -i)
  // Compound assignment into a `BigInt`, at several widths.
  var f = BigInt(1)
  for k in 2 .. 25 do f *= k
  println(f)
  f += l
  f -= s
  f /= h
  f %= w
  println(f)
  var g: BigInt = 0
  for k in 1 .. 100 do g += k
  println(g)
  var p = BigInt(1)
  for _ in 0 ..< 100 do p *= i
  println(p)
  // Comparisons and equality, both ways and in chains.
  println(ordered(b, 999))
  println(ordered(b, 1000))
  println(ordered(b, long(1001)))
  println(ordered(BigInt(-1), one))
  println(ordered(BigInt(w) + 1, w))
  println(b == 1000)
  println(1000 == b)
  println(b != i)
  println(i != b)
  println(0 < b < 2000)
  println(i < b < h * 10)
  println(i < h < b)
  println(b < i < h)
  println(-b <= l <= b)
  // A literal on the integer side takes the `BigInt`'s type, a `long` too large for an `int` included.
  println(b * 10000000000)
  println(10000000000 - b)
  println(b < 10000000000)
  // An integer's own operators are unchanged beside one.
  println(i * i + int(b.toLong))
  // The value converted is evaluated once, where it stands.
  var calls = 0
  val counted = () ->
    calls += 1
    calls
  println(counted() * b + counted())
  println(counted() < b < counted() + 2000)
  println(calls)
