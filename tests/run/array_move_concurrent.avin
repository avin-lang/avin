// expect: exit 0
// Eight threads at once each make a hundred arrays and move them into one channel, with no copy; the
// receiver takes every one, and finds each sender's arrays whole: every element its sender's mark,
// and as many arrays from each as it sent. Every array then belongs to the receiver alone.
import avin.actors.Isolated
import avin.threads.{Channel, spawn}

main()
  val senders = 8
  val each = 100
  val ch = Channel[Isolated[Array[int]]](16)
  val threads = (0 ..< senders).map(s -> spawn(() ->
    for k in 0 ..< each
      val a = Array.fill[int](64 + k, s)
      ch.send(Isolated.move(a))
    each)).toVector
  val counts = Array.fill[int](senders, 0)
  var whole = 0
  for _ in 0 ..< senders * each
    val a = ch.receive().get.take()
    val s = a(0)
    var same = true
    for x in a
      if x != s then same = false
    if same then whole += 1
    counts(s) += 1
    a(0) = -1
  var sent = 0
  for t in threads do sent += t.join()
  println(s"sent $sent, whole $whole, per sender ${counts.toVector}")
