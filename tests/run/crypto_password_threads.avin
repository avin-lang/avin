// expect: exit 0
// Password hashing is blocking work. With one more thread hashing than there are workers, so that
// every worker is inside a hash at once, a lightweight thread that sleeps and wakes ten times still
// runs, and finishes while the hashes are computing: the scheduler hands the busy workers' places to
// other threads. Bound without `blocking`, the ticker waits for a hash to end. Every thread's hash
// verifies, each against its own password only.
import avin.crypto.password.{hashPassword, verifyPassword, Argon2Params, Argon2id}
import avin.process.processors
import avin.threads.{Atomic, sleep, spawn}
import avin.time

main()
  val hashers = processors() + 1
  val finished = Atomic(0)
  val slow = Argon2Params(Argon2id, 16384, 24, 1, 32, 16)
  val threads = Vector.tabulate(hashers, i ->
    spawn(() ->
      val stored = hashPassword(s"password $i", slow)
      val right = verifyPassword(s"password $i", stored)
      val wrong = verifyPassword(s"password ${i + 1}", stored)
      _ = finished.add(1)
      right == Ok(true) && wrong == Ok(false)))
  val ticker = spawn(() ->
    for _ in 0 ..< 10 do sleep(time.millis(1))
    finished.load())
  val seen = ticker.join()
  val results = threads.map(t -> t.join())
  println(s"the ticker finished while hashes ran: ${seen < hashers}")
  println(s"every hash verified: ${results.forall(r -> r)}")
  println(s"hashes: ${results.length == hashers}")
