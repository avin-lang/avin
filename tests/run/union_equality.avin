// expect: exit 0
// Two union values compare as two `Any`s holding them would: values of the same member compare as
// that member does, by value or by its own `Eq`, and values of different members are unequal, except
// that two sequences of equal elements are equal whatever their types. The hash is the member value's
// own. `u == x` with `x` a member's value injects `x` first. `===` holds on a union of classes.

class Money(val cents: int)

impl Eq for Money
  equals(other: Money) -> bool = cents == other.cents

impl Hash for Money
  hash() -> long = cents.hash()

class Dog(val name: string)
class Cat(val name: string)

data Point(x: int, y: int)

main()
  // The same member, equal and unequal.
  val a: int | string = 1
  val b: int | string = 1
  val c: int | string = 2
  val s: int | string = "1"
  println(s"${a == b} ${a == c} ${a != c} ${a == s} ${s == s}")
  // Different members are unequal even where their values print alike.
  val i: int | long = 1
  val one: long = 1
  val l: int | long = one
  println(s"${i == l} ${i != l}")
  val ch: char | string = 'x'
  val st: char | string = "x"
  println(ch == st)
  // A member's value injects before the comparison, on either side.
  println(s"${a == 1} ${1 == a} ${a == 2} ${s == "1"} ${"1" == s} ${a != "1"}")
  println(s"${l == one} ${i == one}")
  // A member's value held in a variable injects too, on either side and under `!=`, and so does a
  // value of a narrower union; in a chain each link injects on its own.
  val ten: long = 10
  val tenU: int | long = ten
  println(s"${one == l} ${one != i} ${ten == tenU} ${tenU != ten} ${ten == i}")
  val word = "1"
  println(s"${s == word} ${word == s} ${a == word} ${word != a}")
  val wider: int | string | bool = 1
  val wordy: int | string | bool = "1"
  println(s"${a == wider} ${wider == a} ${s == wider} ${s == wordy} ${wordy != s}")
  println(s"${a == b == 1} ${1 == a == b} ${l == one == l}")
  // Boundaries and Unicode.
  val big: int | string = int.MaxValue
  val small: int | string = int.MinValue
  println(s"${big == int.MaxValue} ${small == int.MinValue} ${big == small}")
  val e: int | string = ""
  val emoji: int | string = "日本🎉"
  println(s"${e == ""} ${emoji == "日本🎉"} ${e == emoji}")
  val nan: real | string = real.NaN
  println(nan == nan)
  val zero: real | string = 0.0
  val negative: real | string = -0.0
  println(zero == negative)
  // A class member's own `Eq` is used, and a class without one compares by identity.
  val m1: Money | int = Money(5)
  val m2: Money | int = Money(5)
  val m3: Money | int = Money(6)
  println(s"${m1 == m2} ${m1 == m3} ${m1 == 5}")
  val rex = Dog("rex")
  val d1: Dog | Cat = rex
  val d2: Dog | Cat = rex
  val d3: Dog | Cat = Dog("rex")
  println(s"${d1 == d2} ${d1 == d3} ${d1 === d2} ${d1 === d3}")
  // A union with a value member is compared by identity with a class's object, as an `Any` is.
  val di: Dog | int = rex
  val dn: Dog | int = 3
  println(s"${di === rex} ${dn === rex} ${rex !== dn}")
  // A data member compares by value.
  val p1: Point | string = Point(1, 2)
  val p2: Point | string = Point(1, 2)
  println(s"${p1 == p2} ${p1 == Point(2, 1)} ${p1 == "Point(1, 2)"}")
  // The sequence exception: a Vector and a List of equal elements are equal.
  val v: Vector[int] = [1, 2, 3]
  val sv: Vector[int] | List[int] = v
  val sl: Vector[int] | List[int] = List(1, 2, 3)
  val other: Vector[int] | List[int] = List(1, 2)
  println(s"${sv == sl} ${sl == sv} ${sv == other}")
  // Hashing is the member's own.
  println(s"${a.hash() == 1.hash()} ${s.hash() == "1".hash()} ${l.hash() == one.hash()}")
  println(m1.hash() == Money(5).hash())
  // A set holds `1` and `"1"` apart, and a map finds each key by its member.
  var set: Set[int | string] = Set(1, "1", 1, "1", 2)
  println(set.size)
  println(s"${set.contains(1)} ${set.contains("1")} ${set.contains("2")} ${set.contains(a)}")
  val map: Map[int | string, string] = {1: "int one", "1": "string one"}
  println(map.get(1))
  println(map.get("1"))
  println(map.get(s))
  println(map.get(3))
  val longs: Map[int | long, string] = {(i): "int", (l): "long"}
  println(s"${longs.size} ${longs.get(i)} ${longs.get(l)}")
  // Generic code compares a union as any other value.
  println(List(a, s, c).contains(b))
  println(Vector[int | string](1, "1").indexOf("1"))
