// expect: exit 0
// An opaque type is a type, so it is a type argument of a constructor parameter's applications:
// `F[UserId]` at `Vector` is a `Vector[UserId]` holding the numbers themselves, at `Option` an
// `Option[UserId]`, and a type pattern `F[UserId]` tells it from `F[long]`.

opaque type UserId = long

impl UserId
  def id -> long = repr

same[F[_], A](x: F[A]) -> F[A] = x

firsts[F[_]](x: F[UserId], y: F[UserId], first: bool) -> F[UserId] = if first then x else y

isUsers[F[_]](x: Any) -> bool = x match
  _: F[UserId] -> true
  _ -> false

main()
  val v = same[Vector, UserId]([UserId(1), UserId(2)])
  println(v.map(u -> u.id))
  println(firsts[Option](Some(UserId(3)), None, true).map(u -> u.id))
  println(firsts[Vector]([], [UserId(4)], false).map(u -> u.id))
  println(isUsers[Vector]([UserId(5)]))
  println(isUsers[Vector]([long(5)]))
  println(isUsers[Option](Some(UserId(5))))
  val many = same[Vector, UserId]((0 ..< 3000).map(i -> UserId(long(i))).toVector)
  println(many.foldLeft(long(0), (s, u) -> s + u.id))
