// expect: trap
// A rate limiter's burst is at least one token: a burst of one is taken, and a negative one traps where
// the limiter is made.
import avin.net.http.RateLimiter
import avin.time.seconds

main()
  println(RateLimiter(5, seconds(1), burst = 1).burst)
  println(RateLimiter(5, seconds(1), burst = -1).burst)
