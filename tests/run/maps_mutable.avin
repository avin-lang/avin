// expect: exit 0
// A mutable map, driven by a long pseudo-random run of updates and removals over a small range of
// keys, agrees at every step with an immutable map given the same operations: removal moves later
// entries of a run back, and lookups still find every key. Then the rest of its methods.

import avin.collections.mutable.{Map as MutableMap}

var computed = 0

// `value`, counting the calls.
compute(value: int) -> int
    computed += 1
    value

main()
    val table = MutableMap[int, int]()
    var model = Map[int, int]()
    var seed: long = 12345
    var agreed = true
    for step in 0..<3000
        seed = (seed *% 6364136223846793005 +% 1442695040888963407)
        val key = int((seed >> 40) & 127)
        if (seed >> 20) & 3 == 0
            val had = table.remove(key)
            if had != model.get(key) then agreed = false
            model = model.removed(key)
        else
            table(key) = step
            model = model.updated(key, step)
        if table.size != model.size then agreed = false
        if step % 100 == 0
            for k in 0..<128
                if table.get(k) != model.get(k) then agreed = false
    println(s"$agreed ${table.size == model.size} ${table.toMap == model}")

    var entries = 0
    var keySum = 0
    for (k, _) in table
        entries += 1
        keySum += k
    var modelKeySum = 0
    for k in model.keys do modelKeySum += k
    println(s"${entries == table.size} ${keySum == modelKeySum}")

    val cache = MutableMap[string, int]()
    val first = cache.getOrElseUpdate("k", compute(7))
    val second = cache.getOrElseUpdate("k", compute(8))
    println(s"$first $second $computed ${cache.getOrElse("absent", 0)}")

    val copy = cache.copy()
    copy("k") = 1
    val kept = MutableMap[string, int]()
    kept.addAll(Map[string, int]().updated("a", 1).updated("b", 2).updated("c", 3))
    val big = kept.filter((_, v) -> v >= 2)
    println(s"${cache("k")} ${copy("k")} ${copy === cache} ${cache === cache} ${kept.size} ${big.size} ${big.contains("a")}")
    var visits = 0
    kept.foreach((k, v) -> visits += k.byteLength * v)
    println(visits)
    kept.clear()
    println(s"${kept.size} ${kept.isEmpty} ${kept.get("a").isEmpty}")
    kept("z") = 26
    println(s"${kept.size} ${kept("z")} ${kept.nonEmpty}")
