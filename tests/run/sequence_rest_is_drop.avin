// expect: exit 0

// `rest*` binds exactly what `drop(n)` answers for the scrutinee's type, n being the elements
// before it, and `[rest*]` is no exception: it binds what `drop(0)` answers. A list's `drop` shares
// the list, so there `[rest*]` is the list itself; a vector's answers a vector; a range, an array, a
// buffer and a deque answer a vector, made when the pattern matches.

// A sequence of the program's own, whose `drop` is the sequence's own.
class Letters(private val text: string): Seq[char]
  override length -> int = text.charCount
  override apply(index: int) -> char = text.chars(index)

object Digits
  unapplySeq(n: int) -> Option[Vector[int]] = if n < 0 then None else Some(s"$n".chars.map(c -> c.asDigit))

whole[T](xs: Seq[T]) -> Vector[T] = xs match
  [rest*] -> rest

afterOne[T](xs: Seq[T]) -> Vector[T] = xs match
  [_, rest*] -> rest
  _ -> Vector.empty[T]()

main()
  // A range: `[rest*]` is a vector, as `drop(0)` is.
  val r = 1 .. 4
  val fromRange: Vector[int] = r match
    [rest*] -> rest
  println(fromRange, r.drop(0))
  val tail: Vector[int] = r match
    [first, rest*] -> rest
    _ -> Vector.empty[int]()
  println(tail)
  val empty = 0 ..< 0
  val none: Vector[int] = empty match
    [rest*] -> rest
  println(none, none.isEmpty)
  val stepped: Vector[int] = (10 .. 0 by -5) match
    [rest*] -> rest
  println(stepped)
  // A list: the list itself, as its `drop(0)` is.
  val l = List(1, 2, 3)
  val same: List[int] = l match
    [rest*] -> rest
  println(same, same == l)
  val shared: List[int] = l match
    [_, rest*] -> rest
    _ -> Nil
  println(shared, shared == l.drop(1))
  // A vector: a vector.
  val v = [4, 5]
  val fromVector: Vector[int] = v match
    [rest*] -> rest
  println(fromVector)
  // An array, a buffer and a deque: a vector holding the elements as they were.
  val a = Array.tabulate(3, i -> i * i)
  val fromArray: Vector[int] = a match
    [rest*] -> rest
  a(0) = 99
  println(fromArray, a)
  val b: Buffer[string] = ["x", "y"]
  val fromBuffer: Vector[string] = b match
    [rest*] -> rest
  b.addOne("z")
  println(fromBuffer, b)
  val d: Deque[int] = [7, 8]
  val fromDeque = d match
    [rest*] -> rest
  println(fromDeque, fromDeque.length)
  // `_*` alone matches every sequence, and so does `[rest*]`: no other arm is needed.
  println(r match
    [_*] -> "every range")
  // Generic code: what `Seq`'s `drop` answers.
  println(whole(l), whole(r), whole(Array.fill(2, 'q')), whole(Vector.empty[int]()))
  println(afterOne(l), afterOne(r), afterOne([1]))
  // A sequence of its own.
  val letters = Letters("héllo")
  println(whole(letters), afterOne(letters))
  val mine = letters match
    [rest*] -> rest
  println(mine.length)
  // An extractor's sequence is matched the same way.
  val n = 2024
  if n is Digits(rest*) then println(rest)
  if n is Digits(first, rest*) then println(first, rest)
  // Strings of every width, Unicode and nested sequences.
  val words = [["a"], [], ["😀", "b"]]
  val inner = words match
    [_, rest*] -> rest
    _ -> []
  println(inner)
  println(words match
    [[only], rest*] -> s"$only then ${rest.length} more"
    _ -> "other")
  // A guard sees the binding.
  println(r match
    [rest*] if rest.length > 10 -> "long"
    [rest*] -> s"short: $rest")
