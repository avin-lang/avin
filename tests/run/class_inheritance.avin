// expect: exit 0
// A subclass runs its superclass's constructor first, inherits its fields and methods, and
// overrides methods; a call through any receiver reaches the override of the object's own class.

open class Animal(val name: string)
    println(s"Animal $name")
    var sounds = 0

    speak() -> string
        sounds++
        s"$name makes ${sound()}"

    sound() -> string = "a noise"

    kind() -> string = "animal"

open class Dog(name: string, val tricks: int): Animal(name)
    println(s"Dog $name with $tricks")

    override sound() -> string = "woof"

    override kind() -> string = "dog/" + super.kind()

class Puppy(name: string): Dog(name + " jr", 1)
    println(s"Puppy $name")

    override kind() -> string = "puppy/" + super.kind()

// A generic subclass of a generic class: each instance has its own method table.
open class Holder[A](val item: A)
    show() -> string = "holder"
    take() -> A = item

class Named[A](item: A, val name: string): Holder[A](item)
    override show() -> string = s"$name holds ${describeAll(take())}"

describeAll[T](x: T) -> string = "something"

// Arms yielding a subclass and its superclass join to the superclass.
pick(n: int) -> string
    val x = n match
        0 -> Named(1, "one")
        _ -> Holder(2)
    val y = if n == 0 then Holder(3) else Named(4, "four")
    x.show() + " & " + y.show()

main() -> int
    val h: Holder[int] = Named(7, "seven")
    val g: Holder[string] = Named("x", "ex")
    println(h.show() + " / " + g.show() + " / " + Holder(true).show())
    if h.take() != 7 || g.take() != "x" then return 4
    println(pick(0) + " / " + pick(1))
    val p = Puppy("rex")
    println(p.speak())
    println(p.kind())
    val d: Dog = p
    println(d.kind())
    val a: Animal = d
    println(a.speak())
    println(a.kind())
    if a.sounds != 2 then return 1
    if p.tricks != 1 then return 2
    if !(a === p) then return 3
    val plain = Animal("cat")
    println(plain.speak())
    println(plain.kind())
    0
