// A multiple assignment writes fields as it writes locals: every place's object is taken first,
// then the values on the right are evaluated, then every place is stored.
class Pair(var a: int, var b: int)
    swap()
        a, b = b, a
    rotate()
        self.a, self.b = self.b, self.a + self.b
    bump(by: int)
        a, b += by, by * 2
    show() -> string = s"$a $b"

class Node(var value: int, var label: string)

var order = ""

note(text: string, n: int) -> int
    order = order + text
    n

pick(n: Node, tag: string) -> Node
    order = order + tag
    n

main()
    val p = Pair(1, 2)
    p.swap()
    println(p.show())
    p.rotate()
    println(p.show())
    p.bump(10)
    println(p.show())
    // A field of another object and a local together.
    val n = Node(1, "one")
    var count = 0
    n.value, count = 7, 3
    println(s"${n.value} $count")
    count, n.label = count + 1, "seven"
    println(s"$count ${n.label}")
    // Two objects' fields swapped through each other.
    val m = Node(2, "two")
    n.value, m.value = m.value, n.value
    println(s"${n.value} ${m.value}")
    // The objects are computed before the values, left to right.
    pick(n, "<n>").value, pick(m, "<m>").value = note("1", 100), note("2", 200)
    println(s"$order ${n.value} ${m.value}")
    // From a tuple value, and with a part skipped.
    val t = (5, "five")
    n.value, n.label = t
    println(s"${n.value} ${n.label}")
    _, m.label = t
    println(m.label)
    n.value, m.value += 1, 2
    println(s"${n.value} ${m.value}")
