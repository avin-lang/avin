// expect: exit 0
// Every rounding mode at the ties, just below and just above them, on both sides of zero and at
// zero, through `round`, `roundSignificant`, `div` and `divSignificant`; a value already at the digits
// kept is unchanged by every mode, and `HalfEven` is the default.
main()
  val modes = [HalfEven, HalfUp, HalfDown, Up, Down, Ceiling, Floor]
  val names = ["HalfEven", "HalfUp", "HalfDown", "Up", "Down", "Ceiling", "Floor"]
  val whole = [
    "2.5",
    "3.5",
    "2.4",
    "2.6",
    "2.49999",
    "2.50001",
    "-2.5",
    "-3.5",
    "-2.4",
    "-2.6",
    "-2.49999",
    "-2.50001",
    "0.5",
    "-0.5",
    "0",
    "0.0",
    "0.4",
    "-0.4",
    "2",
    "-2",
    "1.5",
    "-1.5",
    "9.5",
    "-9.5"
  ]
  println(whole.mkString(" "))
  for i in 0 ..< modes.length
    val row = whole.map(v -> BigDecimal(v).round(0, rounding = modes(i)).toString())
    println(s"${names(i)}: ${row.mkString(" ")}")
  // Two places: the tie is the third digit after the point, and anything after it breaks the tie.
  val cents = [
    "1.005",
    "1.015",
    "-1.005",
    "-1.015",
    "1.0049",
    "1.0051",
    "-1.0049",
    "-1.0051",
    "1.00500000000000000000000001",
    "1.01",
    "-1.01"
  ]
  println(cents.mkString(" "))
  for i in 0 ..< modes.length
    val row = cents.map(v -> BigDecimal(v).round(2, rounding = modes(i)).toString())
    println(s"${names(i)}: ${row.mkString(" ")}")
  // Significant digits, a carry adding a digit, and the zeros of a whole number.
  val sig = ["12.5", "13.5", "-12.5", "12.51", "9.95", "-9.95", "125", "0.000125", "99.5", "12"]
  println(sig.mkString(" "))
  for i in 0 ..< modes.length
    val row = sig.map(v -> BigDecimal(v).roundSignificant(2, rounding = modes(i)).toString())
    println(s"${names(i)}: ${row.mkString(" ")}")
  // A quotient at a scale: 1/8 = 0.125 is a tie at two places, 2/3 above one at none, 1/3 below one.
  for i in 0 ..< modes.length
    val m = modes(i)
    val one: BigDecimal = 1
    val two: BigDecimal = 2
    val row = [
      one.div(8, scale = 2, rounding = m),
      (-one).div(8, scale = 2, rounding = m),
      one.div(-8, scale = 2, rounding = m),
      two.div(3, scale = 0, rounding = m),
      two.div(-3, scale = 0, rounding = m),
      one.div(3, scale = 0, rounding = m),
      (-one).div(3, scale = 0, rounding = m),
      one.divSignificant(3, 1, rounding = m),
      two.divSignificant(3, 3, rounding = m),
      (-two).divSignificant(3, 3, rounding = m)
    ]
    println(s"${names(i)}: ${row.mkString(" ")}")
  // The default is HalfEven everywhere a rounding is taken.
  val tie: BigDecimal = 2.5
  println(tie.round(0))
  println(tie.roundSignificant(1))
  val five: BigDecimal = 5
  println(five.div(2, scale = 0))
  println(five.divSignificant(2, 1))
  println(BigDecimal(15).divSignificant(2, 1))
  // Rounding to as many places as a number has, or more, never changes its value.
  for i in 0 ..< modes.length
    val x: BigDecimal = -12.345
    print(
      s"${x.round(3, rounding = modes(i))} ${x.round(5, rounding = modes(i))} ${x.roundSignificant(5, rounding = modes(i))} "
    )
  println()
  // A negative number of places rounds to tens, hundreds, …, written as a whole number.
  val n: BigDecimal = 1250.75
  for i in 0 ..< modes.length
    print(
      s"${n.round(-2, rounding = modes(i))} ${(-n).round(-1, rounding = modes(i))} ${n.round(-5, rounding = modes(i))} "
    )
  println()
  // Huge numbers round the same way.
  val huge = BigDecimal("123456789012345678901234567890.5")
  println(huge.round(0))
  println((huge + 1).round(0))
  println(huge.round(0, rounding = Down))
  println((-huge).round(0, rounding = Floor))
  println(huge.roundSignificant(3))
