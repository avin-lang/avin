// A method's own type parameter bounded by its type's parameter widens the input a rule reads:
// `|[J: I]` joins a rule over any `Reader`, such as `err`, with one over an `Input`. `J` is inferred as
// the narrower of the two inputs, and a value of `J` is an `I`, with `Reader`'s members, in the body.
abstract class Reader(val length: int)
  var offset = 0
  atEnd() -> bool = offset >= length

class Input(val source: string): Reader(source.byteLength)

class Rule[-I: Reader, +T](val run: @sendable I -> Option[T])

type Parser[T] = Rule[Input, T]

impl[I: Reader, T] Rule[I, T]
  |[J: I](@sendable other: -> Rule[J, T]) -> Rule[J, T] = Rule(input ->
    val start = input.offset
    run(input) match
      Some(a) -> Some(a)
      None ->
        input.offset = start
        other.run(input))
  // The same, taking the other rule strictly.
  or[J: I](other: Rule[J, T]) -> Rule[J, T] = self | other
  // A `J` is seen as an `I` with no conversion: `self` reads a `J` as the `Rule[J, T]` it is.
  narrowed[J: I]() -> Rule[J, T] = self

success[T: Sendable](v: T) -> Rule[Reader, T] = Rule(input -> Some(v))
err[T](msg: string) -> Rule[Reader, T] = Rule(input -> None)

digit() -> Parser[long] = Rule(input ->
  if !input.atEnd() && '0' <= input.source.charAt(input.offset) <= '9'
    val d = long(int(input.source.charAt(input.offset)) - int('0'))
    input.offset += 1
    Some(d)
  else None)

parse[T](p: Parser[T], s: string) -> Option[T] = p.run(Input(s))

main()
  // An input-free rule joined with a string parser: `J` is `Input`.
  println(parse(err[long]("no") | digit(), "7"))
  println(parse(err[long]("no") | digit(), "x"))
  // A string parser joined with an input-free rule: `J` is still `Input`, the cap `I` gives it.
  println(parse(digit() | success(long(4)), "x"))
  println(parse(digit() | success(long(4)), "9"))
  println(parse(digit().or(success(long(5))), "x"))
  println(parse(err[long]("no").or(digit()), "2"))
  // Chained, and two input-free rules, whose join stays a `Rule[Reader, long]`.
  val p: Parser[long] = digit() | err[long]("no") | success(long(6))
  println(parse(p, "x"))
  println(parse(p, "3"))
  val free = err[long]("no") | success(long(8))
  println(free.run(Input("")))
  println(parse(success(long(1)).narrowed[Input](), ""))
  // A failed branch leaves the input where it was.
  val q = (digit() | err[long]("no")) | success(long(0))
  val input = Input("x")
  println(q.run(input))
  println(input.offset)
