// expect: exit 0
// A constructor parameter bounded by a constructor trait is inferred through the conformance, which
// says which of a type's arguments are the holes: `Result[int, AgeError]` makes `F` the constructor
// `Result[_, AgeError]`, `Either[string, int]` makes it `Either[string, _]`, and `Swapped[int, char]`,
// whose conformance leaves its first argument open, makes it `Swapped[_, char]`. A type of as many
// parameters as holes goes the same way. From the expected type too, and from a lambda's result.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

trait Pairs[A, B]
  swap() -> Self[B, A]

impl Mappable for Option

impl Mappable for Vector

impl[T, E] Mappable[T] for Result[T, E]

impl[L, R] Mappable[R] for Either[L, R]

data AgeError(why: string)

// A two-parameter type whose conformance leaves its FIRST argument open.
data Swapped[A, B](a: A, b: B)

impl[A, B] Mappable[A] for Swapped[A, B]
  map[C](f: (A) -> C) -> Swapped[C, B] = Swapped(f(a), b)

impl[A, B] Pairs[A, B] for Swapped[A, B]
  swap() -> Swapped[B, A] = Swapped(b, a)

class Cell[A](val value: A): Mappable[A]
  map[B](f: (A) -> B) -> Cell[B] = Cell(f(value))

incr[F[_]: Mappable](x: F[int]) -> F[int] = x.map(n -> n + 1)

shout[F[_]: Mappable](x: F[string]) -> F[string] = x.map(s -> s + "!")

second[F[_]: Mappable](x: F[int], y: F[int]) -> F[int] = y

flip[P[_, _]: Pairs, A, B](p: P[A, B]) -> P[B, A] = p.swap()

made[F[_]: Mappable](make: (int) -> F[int]) -> F[int] = make(41).map(n -> n + 1)

each[G[_]: Mappable](xs: Vector[int], f: (int) -> G[int]) -> Vector[G[int]] = xs.map(f)

// Generic code passing its own constructor parameter on, inferred.
relay[F[_]: Mappable](x: F[int]) -> F[int] = incr(incr(x))

// The constructor and its other type arguments inferred together.
pairUp[F[_]: Mappable, A](x: F[A], tag: string) -> F[(A, string)] = x.map(a -> (a, tag))

age(text: string) -> Result[int, AgeError] = if text == "" then Err(AgeError("empty")) else Ok(text.byteLength)

main()
  println(incr(Some(1)))
  println(incr([1, 2, 3]))
  val failed: Result[int, AgeError] = Err(AgeError("none"))
  println(incr(age("four")))
  println(incr(failed))
  val r: Result[int, string] = Ok(-2147483648)
  println(incr(r))
  // `Ok(1)` is a `Result[int, Nothing]`: the constructor is `Result[_, Nothing]`.
  println(incr(Ok(1)))
  val e: Either[string, int] = Right(2147483646)
  println(incr(e))
  val l: Either[string, int] = Left("left")
  println(incr(l))
  println(incr(Swapped(1, 'c')))
  println(shout(Swapped("ü✓", 'c')))
  println(incr(Cell(5)).value)
  println(shout(Cell("")).value)
  // An unknown the first argument leaves is decided by the second.
  println(second(Ok(1), age("ab")))
  println(second(age(""), Ok(1)))
  println(second(None, Some(3)))
  println(flip(Swapped(1, "one")))
  val o: Option[int] = made(n -> Some(n))
  println(o)
  val m: Result[int, string] = made(n -> Ok(n))
  println(m)
  println(made(n -> Swapped(n, true)))
  println(each([1, 2], n -> if n > 1 then Some(n) else None))
  println(each([3], n -> Ok(n)))
  println(relay(age("x")))
  println(relay(Swapped(0, 0.5)))
  println(pairUp(age("abc"), "t"))
  println(pairUp(Right(true), "b"))
  // Type patterns inside each copy see the exact type the constructor made.
  val got: Any = incr(age("xyz"))
  println(got match
    _: Result[int, AgeError] -> "Result[int, AgeError]"
    _ -> "other")
