// expect: exit 0
// The core library's `max` and `min` take one value or more: the greatest or least of them, the
// first of equal ones, with the rest given one by one or spliced from a sequence.

data Score(points: int, name: string) derives Ord

main()
    print(max(3, 9, 4))
    print(min(3, 9, 4))
    print(max(7))
    print(min("pear", "apple", "fig"))
    val rest = [5, -2, 8]
    print(max(0, rest*))
    print(min(0, rest*))
    print(max(1.5, 2.5))
    print(max(Score(2, "b"), Score(2, "a"), Score(1, "z")).name)
