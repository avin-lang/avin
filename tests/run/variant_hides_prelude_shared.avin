// expect: exit 0
// Two of the module's types share the variant `None`, hiding `Option`'s: an expected `Option`
// chooses `Option`'s, and an expected one of the module's types chooses that type's.
data ImageFormat
  None
  Png

data Mode
  None
  Fast

pick(f: ImageFormat, m: Mode, o: Option[Mode]) -> string = s"$f $m $o"

modeOf(n: int) -> Option[Mode] = n match
  0 -> None
  1 -> Some(None)
  _ -> Some(Fast)

main()
  println(pick(None, None, None))
  println(pick(Png, Fast, Some(None)))
  for n in 0 .. 2
    modeOf(n) match
      None -> println("no mode")
      Some(None) -> println("mode none")
      Some(Fast) -> println("fast")
  val o: Option[ImageFormat] = None
  println(o == None)
