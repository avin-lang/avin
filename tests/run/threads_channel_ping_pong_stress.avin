// expect: exit 0
// Two threads hand a list back and forth over channels while every allocation collects, so each
// thread is parked, holding what it has received, at many of the collections.
import avin.threads.{Channel, spawn}

main() -> int
  val ping = Channel[List[int]]()
  val pong = Channel[List[int]]()
  val echoer = spawn(() ->
    for xs in ping do pong.send(xs.length :: xs))
  var xs: List[int] = []
  for _ in 0 ..< 300
    ping.send(xs)
    xs = pong.receive().getOrElse([])
  ping.close()
  echoer.join()
  println(xs.length)
  println(xs.sum)
  0
