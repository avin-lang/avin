// expect: trap
// A range of more values than an `int` holds has no `int` length: asking for it traps rather than
// wrapping. Its ends, an index and whether it holds a value are still answered from its bounds.

main()
    val r = -2147483648 .. 2147483647
    println(s"${r.isEmpty()} ${r.head()} ${r.last()} ${r.headOption()} ${r.lastOption()} ${r(2147483647)} ${r.lift(5)} ${r.lift(-1)} ${r.contains(0)}")
    val half = -2147483648 .. 2147483647 by 2
    println(s"${half.last()} ${half(1073741823)} ${half.contains(2147483646)} ${half.contains(2147483647)}")
    var n = 0
    for i in r
        n += 1
        if n == 3 then break
    println(s"$n")
    println(s"${r.length()}")
