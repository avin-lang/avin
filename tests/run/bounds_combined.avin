// Bounds combined: two bounds on one parameter, a bound whose trait requires another, a class as a
// bound, a trait without `Self` as both a bound and a type argument, and a value of a bounded
// parameter passed where its bound's type is expected.
trait Named
  name() -> string

trait Sized
  size() -> int

trait Tagged: Named
  tag() -> string = s"<${name()}>"

// A trait whose `Self` is a result as well as a parameter.
trait Joins
  join(other: Self) -> Self
  val weight: int

class Box(val label: string, val weight: int): Tagged, Sized, Joins
  override name() -> string = label
  override size() -> int = weight * 10
  override join(other: Box) -> Box = Box(label + other.label, weight + other.weight)

data Note(text: string)

impl Named for Note
  name() -> string = text

impl Sized for Note
  size() -> int = 1

// Two bounds, joined with `&`.
report[T: Named & Sized](x: T) -> string = s"${x.name()}:${x.size()}"

// A bound reaches the methods of the traits its trait requires.
tagged[T: Tagged](x: T) -> string = s"${x.tag()} ${x.name()}"

// `Self` as a result, and a trait's `val` read through a bound.
total[T: Joins](a: T, b: T, c: T) -> int = a.join(b).join(c).weight

// A class as a bound: an open class's methods dispatch on the object an instance holds.
open class Animal(val legs: int)
  sound() -> string = "..."

class Dog: Animal(4)
  override sound() -> string = "woof"

speak[T: Animal](x: T) -> string = s"${x.sound()} on ${x.legs} legs"

// A value of a bounded parameter is a value of its bound's type.
describe(n: Named) -> string = s"named ${n.name()}"

forward[T: Named](x: T) -> string = describe(x)

// A trait type conforms to its own bound when its methods do not mention `Self`.
names[T: Named](xs: (T, T)) -> string = xs.0.name() + xs.1.name()

main()
  println(report(Note("memo")))
  println(report(Box("crate", 3)))
  println(tagged(Box("tin", 1)))
  println(s"${total(Box("a", 1), Box("b", 2), Box("c", 4))}")
  println(speak(Dog()))
  println(speak[Animal](Dog()))
  println(speak(Animal(2)))
  println(forward(Note("letter")))
  val a: Named = Note("x")
  val b: Named = Box("y", 0)
  println(names((a, b)))
