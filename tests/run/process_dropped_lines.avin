// expect: exit 0
// The pipe a command's `lines()` reads from is a file the program drops when it drops the lines
// unread, and it gives its descriptor back when the collector frees it. The program runs itself again
// limited to 64 descriptors, and the second run starts a hundred commands and reads one line of each:
// had a dropped pipe kept its descriptor, the run would have stopped at the limit.
import avin.process
import avin.process.Command

limited()
    for i in 0..<100
        Command("/usr/bin/printf", "one\ntwo\n").lines() match
            Ok(lines) ->
                if !lines.hasNext() || lines.next() != "one"
                    println(s"round $i: the first line is wrong")
                    process.exit(1)
            Err(e) ->
                println(s"round $i: $e")
                process.exit(1)
    println("100 rounds")

main()
    if process.args() == ["limited"]
        limited()
        return
    // The limit is set by the shell, which then becomes this program.
    val ran = Command("/bin/sh", "-c", "ulimit -n 64 && exec \"$0\" limited", process.programName()).run()
    println(ran.map(s -> s.isSuccess()))
