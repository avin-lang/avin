// expect: trap
// Threads that have ended leave their stacks for later ones, and a thread asking for less than such a
// stack holds may be given it. Recursion without a base case on that thread runs to the end of the
// stack it was given, not the size it asked for, and stops the program with the stack overflow trap.
import avin.threads.spawn

descend(n: int) -> int = descend(n + 1) + n

main() -> int
    // Megabyte stacks, kept as their threads end.
    for i in 0..<8 do spawn(() -> i * 2, 1048576).join()
    println("kept")
    val t = spawn(() -> descend(0), 600000)
    println(t.join())
    println("after")
    0
