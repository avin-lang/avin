// expect: exit 0
// An actor's turn is never cancelled by a scope, but it may run scopes of its own and cancel them, as
// any thread may. A turn whose scope's thread asks the actor itself cannot be answered while that turn
// runs, since an actor runs one turn at a time: the turn cancels the scope, the asker stops with no
// result, and the question is handled in the next turn, after the messages told before it, its reply
// going to an ask nobody awaits. A turn's scope whose threads are parked in a sleep, a channel and
// another actor's ask, that actor's own turn parked mid-wait, is cancelled and returns at once, and
// both actors go on handling their messages in order.
import avin.actors.{ActorRef, spawn}
import avin.threads.{Atomic, Channel, Promise, scope, sleep}
import avin.time

data Msg
    AskSelf(out: Channel[string])
    AskOther(other: ActorRef[Msg], out: Channel[string])
    Hold(entered: Promise[unit], gate: Promise[unit])
    Get(reply: ActorRef[string])
    Note(n: int)

actor Host(log: Channel[string]) receives Msg
    var gets = 0
    val active = Atomic[int](0)
    receive
        m ->
            if active.add(1) != 1 then log.send("overlap")
            m match
                AskSelf(out) ->
                    val me = self
                    val asking = Atomic(0)
                    val t = scope(s ->
                        val t = s.spawn(() ->
                            asking.store(1)
                            me.ask(r -> Get(r), time.seconds(30)).await())
                        while asking.load() == 0 do sleep(time.millis(1))
                        sleep(time.millis(30))
                        s.cancel()
                        t)
                    out.send(s"self ask: ${t.result()}")
                AskOther(other, out) ->
                    val parked = Atomic(0)
                    val idle = Channel[int]()
                    val ts = scope(s ->
                        val ts = [
                            s.spawn(() ->
                                parked.add(1)
                                sleep(time.hours(1))
                                "slept"),
                            s.spawn(() ->
                                parked.add(1)
                                s"received ${idle.receive()}"),
                            s.spawn(() ->
                                parked.add(1)
                                s"asked ${other.ask(r -> Get(r), time.seconds(30)).await()}")]
                        while parked.load() < 3 do sleep(time.millis(1))
                        sleep(time.millis(30))
                        s.cancel()
                        ts)
                    out.send(s"other asks: ${ts.map(t -> t.result())}")
                Hold(entered, gate) ->
                    entered.complete(())
                    gate.future.await()
                    log.send("held")
                Get(reply) ->
                    gets += 1
                    log.send(s"get $gets")
                    reply.tell(s"answer $gets")
                Note(n) -> log.send(s"note $n")
            active.add(-1)
            ()

main()
    val start = time.monotonic()
    val log = Channel[string](100)
    val out = Channel[string](10)
    val h = spawn(Host(log))
    h.tell(Note(1))
    h.tell(AskSelf(out))
    h.tell(Note(2))
    println(out.receive().get())
    println(h.ask(r -> Get(r), time.seconds(5)).await())
    for _ in 0..<4 do println(log.receive().get())
    // The other actor's turn is parked on a gate while the host's scope asks it.
    val otherLog = Channel[string](100)
    val other = spawn(Host(otherLog))
    val entered = Promise[unit]()
    val gate = Promise[unit]()
    other.tell(Hold(entered, gate))
    entered.future.await()
    h.tell(AskOther(other, out))
    h.tell(Note(3))
    println(out.receive().get())
    println(log.receive().get())
    other.tell(Note(4))
    gate.complete(())
    println(other.ask(r -> Get(r), time.seconds(5)).await())
    for _ in 0..<4 do println(otherLog.receive().get())
    println(h.ask(r -> Get(r), time.seconds(5)).await())
    println(log.receive().get())
    println(time.monotonic() - start < time.seconds(10))
