// expect: exit 0
// `print` and `println` take any value, each shown as `s"$x"` shows it: by its type's own `Display`, a
// value of `Any` or of a trait by the type it has at run time, and a type with no `Display` by its
// name. Several values are separated by `, `.

trait Pet
    name() -> string

class Dog(val called: string): Pet, Display
    override name() -> string = called
    override display(out: Writer, spec: FormatSpec) = out.write("Dog " + called)

class Cat(): Pet
    override name() -> string = "cat"

class Plain(val n: int)

data Point(x: int, y: int)

kind(x: Any) -> string = "any"
kind(x: string) -> string = "string"

main()
    val pet: Pet = Dog("rex")
    val cat: Pet = Cat()
    val a: Any = 2.5
    val xs: Seq[int] = [1, 2, 3]
    val maybe: Option[Pet] = Some(Dog("max"))
    val none: Option[Pet] = None
    val add: (int) -> int = x -> x + 1
    val big: long = 3000000000

    // One argument.
    println(7)
    println("text")
    println(pet)
    println(cat)
    println(a)
    println(xs)
    println(maybe)
    println(none)
    println(add)
    println(Plain(1))
    println(Point(1, 2))
    println(1 < 2)
    println('c')
    println(())

    // Several, of every kind at once.
    println(1, 2, 3)
    println(1, pet, xs)
    println("a", cat, a, maybe, add, Plain(2), Point(3, 4), -5, big)
    println()

    // `print` writes the same with no new line.
    print(pet)
    print(" ")
    print(1, cat, Plain(3))
    print()
    println()

    // Each is shown as interpolation shows it.
    println(s"$pet|$cat|$a|$xs|$maybe")
    println(pet, cat, a, xs, maybe)

    // A value already of `Any` or a vector of them.
    val anys: Vector[Any] = [1, "two", Cat()]
    println(anys)
    println(anys(0), anys(1), anys(2))

    // An integer literal fits an `Any` parameter of an overloaded function, which prints are, and a
    // more specific overload still wins.
    println(kind(1), kind(-2), kind("s"), kind(2.5))
    println(f"${3}%04d", Some(1), [1, 2], (1, "a"))
    if xs.isEmpty then println(fail("unreachable"))
    if xs.isEmpty then println(1, fail("unreachable"))

    // A sequence is one value; only `xs*` spreads it into the repeated parameter.
    val v: Vector[int] = [4, 5]
    val arr = Array.fill(2, 7)
    val list: List[int] = List(8, 9)
    println(v)
    println(arr)
    println(list)
    // A sequence of references spreads as it is; numbers are boxed one by one only where each is
    // written, so a sequence of them spreads once held as `Any`.
    val words: Seq[string] = ["x", "y", "z"]
    val names: List[string] = List("p", "q")
    val mixed: Vector[Any] = [1, "two", pet, xs]
    println(words*)
    println(names*)
    println(mixed*)
    val animals: Vector[Pet] = [Dog("a"), Cat()]
    println(animals)
    println(animals*)
    val nothing: Vector[Any] = []
    println(nothing*)
    print()
    print(words*)
    println()

    // As a value, a print function takes the vector itself.
    val p = println
    p([1, "two", pet])
    val q: (Vector[Any]) -> unit = print
    q([3])
    println()

    // Standard error takes the same.
    eprint(cat)
    eprint(" ")
    eprintln(Plain(4))
    eprintln(1, pet, add)
    eprint(2, xs)
    eprintln()
