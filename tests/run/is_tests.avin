// `is` and `is not` test a value against a pattern.

main() -> int
    val n = 7
    if !(n is 1..10) then return 1
    if n is not 1 | 3 | 7 then return 2
    if n is 8..<20 then return 3
    if !('x' is 'a'..'z') then return 4
    val flag = false
    if flag is true then return 5
    if !(n is _) then return 6
    0
