// real arithmetic and comparison follow IEEE 754.

main() -> int
    val half = 0.5
    val three = 3.0
    if half + half != 1.0 then return 1
    if three * half != 1.5 then return 2
    if three / 2.0 != 1.5 then return 3
    if three - 0.25 != 2.75 then return 4
    if 7.5 % 2.0 != 1.5 then return 5
    if -half != -0.5 then return 6
    // An integer literal where a real is expected is that real.
    if three * 2 != 6.0 then return 7
    if 2 * three != 6.0 then return 8
    val big: real = 9007199254740992
    if big + 1.0 != big then return 9
    // NaN compares false except with `!=`, and zero's sign does not affect equality.
    val zero = 0.0
    val nan = zero / zero
    if nan == nan || nan < 1.0 || nan >= 1.0 then return 10
    if !(nan != nan) then return 11
    if -zero != zero then return 12
    if !(0.1 < 0.2 < 0.30000000000000004) then return 13
    val infinity = 1.0 / zero
    if !(infinity > 1.0e308) then return 14
    var total = 0.0
    total += 0.25
    total *= 4
    if total != 1.0 then return 15
    0
