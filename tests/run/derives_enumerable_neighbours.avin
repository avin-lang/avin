// expect: exit 0
// `Enumerable` beside the other derivations and the features a program meets it with: `derives Ord`
// orders by declaration, as `ordinal()` does; a hand-written `Display` changes what a variant prints
// but not its `name()`, so `valueOf(name())` still finds it; `values()` and `valueOf` reached
// through a bound in generic code; variants as keys of a set and a map; closures capturing them;
// annotated variants; non-ASCII variant names.

data Suit derives Ord, Display, Debug, Enumerable
    Clubs
    Diamonds
    Hearts
    Spades

data Planet derives Enumerable
    Mercury
    Venus
    Earth

impl Display for Planet
    display(out: Writer, spec: FormatSpec) = out.write(name.toLower)

data Label(text: string)
impl Annotation for Label

data Level derives Enumerable
    @Label("low") Low
    @Label("high") High

data Greek derives Enumerable
    Αλφα
    Βήτα
    Ωμέγα

// The names of every variant of any enumeration.
names[E: Enumerable]() -> Vector[string] = E.values.map(e -> e.name)

// The variant after `e`, wrapping round to the first.
following[E: Enumerable](e: E) -> E
    val all = E.values
    all((e.ordinal + 1) % all.length)

parsed[E: Enumerable](text: string) -> Result[E, string] = E.valueOf(text) match
    Some(e) -> Ok(e)
    None -> Err(s"no variant $text")

main()
    // Ordering agrees with the ordinals.
    for a in Suit.values
        for b in Suit.values
            assert((a < b) == (a.ordinal < b.ordinal))
            assert((a == b) == (a.ordinal == b.ordinal))
            assert(a.compare(b) == b.ordinal.compare(a.ordinal) * -1)
    println(Suit.values.sorted.reverse)
    println(debug(Hearts))
    println(s"${Spades}")
    // A hand-written Display.
    println(Planet.values)
    for p in Planet.values
        println(s"$p ${p.name} ${Planet.valueOf(p.name) == Some(p)}")
    assert(Planet.valueOf("earth") == None)
    // Through a bound.
    println(names[Suit]())
    println(names[Planet]())
    println(following(Spades))
    println(following(Venus).name)
    println(parsed[Suit]("Hearts"))
    println(parsed[Suit]("hearts"))
    // As keys.
    var seen = HashSet.empty[Suit]()
    for s in Suit.values
        seen = seen.incl(s).incl(s)
    println(seen.size)
    assert(seen.contains(Suit.valueOf("Clubs").get))
    var counts = HashMap.empty[Planet, int]()
    for p in Planet.values
        counts = counts.updated(p, p.ordinal * 10)
    println(counts.get(Earth))
    assert(Hearts.hash() == Suit.valueOf("Hearts").get.hash())
    // Captured by closures.
    val favourite = Diamonds
    val isFavourite = (s: Suit) -> s == favourite
    println(Suit.values.filter(isFavourite))
    val ranks = Suit.values.map(s -> () -> s.ordinal)
    println(ranks.map(r -> r()))
    // Annotations leave the variants as they are.
    println(Level.values)
    println(Level.valueOf("High").map(l -> l.ordinal))
    // Names beyond ASCII.
    println(Greek.values)
    for g in Greek.values
        println(s"${g.ordinal} ${g.name} ${g.name.charCount}")
    println(Greek.valueOf("Βήτα"))
    println(Greek.valueOf("βήτα"))
    println(Greek.valueOf("Ωμεγα"))
