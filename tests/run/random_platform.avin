// expect: exit 0
// `Random()` is seeded by the platform, so two generators differ; the companion's methods share one
// generator that threads may call at once, and `Random.setSeed` makes it replay a seed's sequence.
import avin.random.Random
import avin.threads.{Atomic, scope}

main()
    val a = Random()
    val b = Random()
    var differ = false
    for i in 0..<4 do if a.nextLong() != b.nextLong() then differ = true
    println(s"platform-seeded generators differ: $differ")

    val r = Random.nextInt(100)
    println(s"companion in range: ${0 <= r < 100} ${Random.between(1, 2)} ${Random.nextBytes(3).length}")
    println(Random.shuffle([3, 1, 2]).sorted())
    println(Random.alphanumeric().take(5).toVector.length)

    val bad = Atomic(0)
    scope(s ->
        for t in 0..<4
            s.spawn(() ->
                for i in 0..<2000
                    val x = Random.nextInt(10)
                    if x < 0 || x >= 10 then bad.add(1)
                ()))
    println(s"threads out of range: ${bad.load()}")

    Random.setSeed(42)
    println(Random.nextInt())
    val g = Random(42)
    g.nextInt()
    println(Random.nextLong() == g.nextLong())
