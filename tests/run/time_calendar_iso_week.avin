// expect: exit 0
// The ISO 8601 week and its year, the weekday and the day of the year, checked against the host's
// `date -j -u -f %Y-%m-%d <day> '+%G %V %u %j %s'` for years with 52 and 53 weeks, weeks 1 and 53
// that cross a year's end either way, leap and common centuries (1900, 2000, 2100) and leap years
// (2024). The last column is the host's epoch second for that day (taken mid-day), whose UTC date
// must be the same day. Every row prints only when it disagrees; the counts close.
import avin.time.{Date, date, epochSeconds, utc, dateTime}

// The host's answers: the date, the ISO week-year, the week, the weekday number, the day of the
// year, and a second within that day.
val Reference: Vector[(int, int, int, long, int, int, int, long)] = [
    (1900, 1, 1, 1900, 1, 1, 1, -2208973466),
    (1900, 2, 28, 1900, 9, 3, 59, -2203962266),
    (1900, 3, 1, 1900, 9, 4, 60, -2203875866),
    (1900, 12, 31, 1901, 1, 1, 365, -2177523866),
    (1970, 1, 1, 1970, 1, 4, 1, 15334),
    (2000, 1, 1, 1999, 52, 6, 1, 946700134),
    (2000, 2, 29, 2000, 9, 2, 60, 951797734),
    (2000, 12, 31, 2000, 52, 7, 366, 978236134),
    (2004, 12, 31, 2004, 53, 5, 366, 1104466534),
    (2005, 1, 1, 2004, 53, 6, 1, 1104552934),
    (2005, 1, 2, 2004, 53, 7, 2, 1104639334),
    (2008, 12, 29, 2009, 1, 1, 364, 1230524134),
    (2009, 12, 31, 2009, 53, 4, 365, 1262232934),
    (2010, 1, 3, 2009, 53, 7, 3, 1262492134),
    (2015, 12, 31, 2015, 53, 4, 365, 1451535334),
    (2016, 1, 3, 2015, 53, 7, 3, 1451794534),
    (2020, 12, 31, 2020, 53, 4, 366, 1609388134),
    (2021, 1, 3, 2020, 53, 7, 3, 1609647334),
    (2021, 1, 4, 2021, 1, 1, 4, 1609733734),
    (2024, 2, 29, 2024, 9, 4, 60, 1709180134),
    (2024, 12, 30, 2025, 1, 1, 365, 1735532134),
    (2026, 8, 28, 2026, 35, 5, 240, 1787890534),
    (2026, 12, 31, 2026, 53, 4, 365, 1798690534),
    (2027, 1, 1, 2026, 53, 5, 1, 1798776934),
    (2027, 1, 3, 2026, 53, 7, 3, 1798949734),
    (2027, 1, 4, 2027, 1, 1, 4, 1799036134),
    (2032, 12, 31, 2032, 53, 5, 366, 1988079334),
    (2037, 12, 31, 2037, 53, 4, 365, 2145845734),
    (2100, 2, 28, 2100, 8, 7, 59, 4107471334),
    (2100, 3, 1, 2100, 9, 1, 60, 4107557734),
    (2100, 12, 31, 2100, 52, 5, 365, 4133909734)]

main()
    var agreed = 0
    for (y, m, d, weekYear, week, weekday, dayOfYear, second) in Reference
        val day = date(y, m, d)
        val ours = (day.isoWeekYear(), day.isoWeek(), day.weekday().isoNumber(), day.dayOfYear())
        val host = (weekYear, week, weekday, dayOfYear)
        if ours == host && epochSeconds(second).atZone(utc).date() == day then agreed += 1
        else println(s"$day: ours $ours, the host's $host")
    println(s"$agreed of ${Reference.size()} agree")

    // A reading and a zoned reading answer the week of their date.
    val reading = dateTime(2027, 1, 1, 23, 59, 59)
    println(s"${reading.isoWeekYear()}-W${reading.isoWeek()}")
    val zoned = epochSeconds(1798776934).atZone(utc)
    println(s"${zoned.isoWeekYear()}-W${zoned.isoWeek()}")

    // Every day of 400 years (one whole cycle of the calendar): the week counts up by one each Monday
    // and nowhere else, starts again at 1 exactly where the week-year changes, and every week-year
    // ends in week 52 or 53, with 71 years of 53 weeks in the cycle.
    var day = date(2000, 1, 3)
    var long53 = 0
    var faults = 0
    while day < date(2400, 1, 3)
        val next = Date(day.epochDay + 1)
        if next.weekday().isoNumber() == 1
            if next.isoWeekYear() == day.isoWeekYear()
                if next.isoWeek() != day.isoWeek() + 1 then faults += 1
            else
                if next.isoWeek() != 1 || next.isoWeekYear() != day.isoWeekYear() + 1 then faults += 1
                if day.isoWeek() == 53 then long53 += 1
                elif day.isoWeek() != 52 then faults += 1
        elif next.isoWeek() != day.isoWeek() || next.isoWeekYear() != day.isoWeekYear() then faults += 1
        day = next
    println(s"faults $faults, years of 53 weeks $long53")

    // The weeks at the edges of the dates: the least date's week-year is the year before its own
    // where it falls before that year's first Thursday, and neither traps.
    println(s"${Date.Min} ${Date.Min.weekday()} ${Date.Min.isoWeekYear()}-W${Date.Min.isoWeek()}")
    println(s"${Date.Max} ${Date.Max.weekday()} ${Date.Max.isoWeekYear()}-W${Date.Max.isoWeek()}")
