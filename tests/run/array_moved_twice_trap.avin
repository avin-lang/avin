// expect: trap
// An array moved once cannot be moved again by the code that moved it: the second move traps, so no
// two `Isolated`s hold one array.
import avin.actors.Isolated

main()
  val a = Array.fill[long](2, 0)
  val first = Isolated.move(a)
  println("moved once")
  val second = Isolated.move(a)
  println(first.take().length + second.take().length)
