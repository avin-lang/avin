// expect: exit 0
// A thread started with the default stack recurses a hundred thousand calls deep: the stack is
// reserved at its full size and committed only as deep as it goes, so deep recursion fits as it does
// on the main thread, and a thousand shallow threads beside it cost a page or so each. A stack asked
// for smaller than 64 KiB, even a negative size, is given 64 KiB.
import avin.threads.spawn

depth(n: int) -> int = if n == 0 then 0 else 1 + depth(n - 1)

main() -> int
    val deep = spawn(() -> depth(100000))
    val shallow = (0..<1000).map(i -> spawn(() -> depth(i % 10))).toVector
    println(deep.join())
    println(shallow.map(t -> t.join()).sum)
    val tiny = spawn(() -> depth(500), 1)
    val negative = spawn(() -> depth(500), -4096)
    println(tiny.join() + negative.join())
    0
