// expect: trap
// A `leave` block is part of handling the event that caused the transition, so handling an event
// from inside one traps.
data Ev
  Go
  Echo

class Box(var target: Option[Hop])

machine Hop(box: Box) receives Ev
  state Start
    leave
      println("leaving Start")
      if box.target is Some(h) then h.handle(Echo)
    Go -> Next
    Echo -> stay

  state Next
    _ -> stay

main() -> int
  val box = Box(None)
  val h = Hop(box)
  box.target = Some(h)
  h.handle(Echo)
  println("echo handled")
  h.handle(Go)
  println("unreachable")
  0
