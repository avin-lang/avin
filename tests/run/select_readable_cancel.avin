// expect: exit 0
// A thread parked in a select on a connection's `readable()` arm stops at once when its scope
// cancels it, with or without an `after` and a channel arm beside it: its deferred statements run,
// nothing after the select does, and nothing of the select is left on the poller. The connection
// works on afterwards: handed back by a deferred statement, it is read by the code that took it, a
// plain read and a later select each waiting on the poller as before, and bytes that arrive later
// are not lost to the cancelled select.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.threads.{Atomic, Channel, scope, sleep}
import avin.time.{hours, millis, seconds}

@sysl("avin.rt.socket_waiters")
socketWaiters() -> long

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

pair() -> (TcpStream, TcpStream)
  val l = ok(TcpListener.bind("127.0.0.1", 0))
  val c = ok(TcpStream.connect("127.0.0.1", l.port()))
  val s = ok(l.accept())
  _ = l.close()
  (c, s)

main()
  val (c, s) = pair()
  val (d, t) = pair()
  val (e, u) = pair()
  val back = Channel[TcpStream](3)
  val deferred = Atomic(0)
  val went = Atomic(0)
  val never = Channel[int]()
  scope(sc ->
    sc.spawn(() ->
      defer
        deferred.add(1)
        back.send(c)
      select
        c.readable() -> went.add(1)
        never.receive() as Some(_) -> went.add(1)
      went.add(1))
    sc.spawn(() ->
      defer
        deferred.add(1)
        back.send(d)
      select
        d.readable() -> went.add(1)
        after hours(1) -> went.add(1)
      went.add(1))
    sc.spawn(() ->
      defer
        deferred.add(1)
        back.send(e)
      select
        e.readable() -> went.add(1)
      went.add(1))
    while socketWaiters() < 3 do sleep(millis(1))
    sleep(millis(10))
    sc.cancel())
  println(deferred.load(), went.load(), socketWaiters())
  ok(s.writeText("plain\n"))
  ok(t.writeText("selected\n"))
  ok(u.writeText("later\n"))
  // The first handed back is read plainly, the others through a select; they come back in any order.
  val lines = Buffer[string]()
  lines.addOne(ok(back.receive().get.readLine()).getOrElse("(end)"))
  for _ in 0 ..< 2
    val x = back.receive().get
    lines.addOne(select
      x.readable() -> ok(x.readLine()).getOrElse("(end)")
      after seconds(5) -> "timed out")
  println(lines.toVector.sorted, socketWaiters())
  for x in [c, s, d, t, e, u] do _ = x.close()
