// expect: exit 0
// `avin.net.Url`: a URL read into its components and written back normalized, the error of text that
// is not one, a reference resolved against it, its query pairs, and a component replaced.
import avin.net.{Url, UrlError, MissingScheme, BadPort}

describe(text: string)
  Url.parse(text) match
    Ok(u) ->
      println(s"$u")
      println(s"  scheme=${u.scheme} userInfo=${u.userInfo} host=${u.host} port=${u.port} default=${u.portOrDefault}")
      println(s"  path=${u.path} query=${u.query} fragment=${u.fragment}")
    Err(MissingScheme) -> println(s"$text: a relative reference, not a URL")
    Err(BadPort(at)) -> println(s"$text: bad port at $at")
    Err(e) -> println(s"$text: ${e.message}")

main() -> int
  describe("HTTPS://Me:pw@Example.COM:443/docs/a%20b.html?lang=en&q=caf%C3%A9+au+lait#intro")
  describe("http://[2001:DB8::1]:8080/")
  describe("http://10.0.0.1")
  describe("http://h?")
  describe("mailto:someone@example.com")
  describe("../up")
  describe("http://h:123456/")
  describe("http://h/a b")
  val base = Url("http://example.com/docs/guide/intro.html?v=2")
  for ref in ["setup.html", "../api/", "/", "?v=3", "#install", "//cdn.example.com/x.js", "https://other.org/"]
    println(s"$ref -> ${base.resolve(ref).map(u -> s"$u").getOrElse("error")}")
  val search = Url("https://example.com/search?q=caf%C3%A9+au+lait&page=2&&flag")
  for (name, value) in search.queryParams
    println(s"$name = \"$value\"")
  println(search.withQuery(s"q=${Url.encode("\u{20ac} & more")}").withFragment("results").withPort(8443))
  println(Url.decode(Url.encode("na\u{ef}ve caf\u{e9}/\u{1f600}")).getOrElse("bad"))
  0
