// expect: exit 0

// A sequence pattern with a rest covers every length from its own on, so `[]` and `[x, rest*]`
// cover every sequence, whatever its type, and need no catch-all.
sum(xs: Vector[int]) -> int = xs match
  [] -> 0
  [x, rest*] -> x + sum(rest)

first(xs: Array[string]) -> string = xs match
  [] -> "none"
  [one] -> s"only $one"
  [a, _*] -> a

// A guarded arm never counts, so the arm after it must cover what it may leave.
positives(xs: Seq[int]) -> int = xs match
  [] -> 0
  [x, rest*] if x > 0 -> 1 + positives(rest)
  [_, rest*] -> positives(rest)

// Sequence patterns nest, and their elements are covered as any column is.
shape(xss: Vector[Vector[int]]) -> string = xss match
  [] -> "no rows"
  [[], _*] -> "first row empty"
  [[x, _*], _*] -> s"first row starts with $x"

flags(xs: Vector[bool]) -> string = xs match
  [] -> "none"
  [true, _*] -> "starts true"
  [false] -> "just false"
  [false, _, _*] -> "starts false"

// Two sequences matched together: each column counts its lengths.
both(pair: (Vector[int], Vector[int])) -> int = pair match
  ([], _) -> 0
  (_, []) -> 1
  ([a, _*], [b, _*]) -> a + b

main()
  println(sum([1, 2, 3, 4]))
  println(sum([]))
  val none: Array[string] = []
  val one: Array[string] = ["a"]
  val many: Array[string] = ["b", "c", "d"]
  println(first(none))
  println(first(one))
  println(first(many))
  println(positives([1, -2, 3, 0, 5]))
  println(shape([]))
  println(shape([[], [1]]))
  println(shape([[7, 8], []]))
  println(flags([]))
  println(flags([true, false]))
  println(flags([false]))
  println(flags([false, true, true]))
  println(both(([], [1])))
  println(both(([1], [])))
  println(both(([1, 2], [3])))
