// `List`, `Set` and `Map` have no constructor of their own name, so their companions' `apply` gives
// each a call form: the elements, or the pairs, as arguments. `Set` and `Map` keep their one
// variant's constructor, which takes the trie a set or map is held in, and a call with elements
// reaches the repeated `apply`.

class Pair(val left: int, val right: int)

object Pair
  apply(both: int) -> Pair = Pair(both, -both)

sum(xs: List[int]) -> int
  var total = 0
  for x in xs
    total += x
  total

main()
  val xs = List(1, 2, 3)
  println(xs)
  println(sum(xs))
  val none: List[string] = List()
  println(none.isEmpty)
  val words = List("a", "b")
  println(words)
  val s = Set(3, 1, 3, 2)
  println(s.size)
  println(s.contains(3))
  println(s.contains(4))
  println(Set.empty[int]().size)
  val m = Map((1, "one"), (2, "two"), (1, "uno"))
  println(m.size)
  println(m.get(1))
  println(m.get(3))
  // The name where a function is expected is the overload whose parameters fit.
  val made: (int) -> Pair = Pair
  println(made(4).right)
  val both: (int, int) -> Pair = Pair
  println(both(1, 2).right)
  val pairs = [5, 6].map(Pair)
  println(pairs(1).right)
  // The bare name is still the companion object where no function is expected.
  println(Pair.apply(7).right)
