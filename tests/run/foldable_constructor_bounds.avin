// expect: exit 0
// A trait whose methods never write `Self` bounds types and constructors alike: `impl Countable for
// Bag` makes each `Bag[T]` a `Countable[T]`, so a bound `[F[_]: Countable]` reads that conformance at
// the holes, a constructor trait may require it (`trait Sized[A]: Countable[A]`), an impl may add to
// its constructors, and a value is still a `Countable[int]` where a type is asked for. The library's
// `Foldable` is one, every `Iterable` and `Option`, `Result` and `Either` among its constructors.
trait Countable[A]
  count() -> int
  firstOr(fallback: A) -> A

trait Sized[A]: Countable[A]
  resized[B](f: (A) -> B) -> Self[B]

data Bag[T](items: Vector[T])

impl Sized for Bag
  count() -> int = items.length

  firstOr(fallback: T) -> T = items.headOption.getOrElse(fallback)

  resized[B](f: (T) -> B) -> Bag[B] = Bag(items.map(f))

// The second argument of a pair is its hole.
data Tagged[L, R](tag: L, value: R)

impl[L, R] Countable[R] for Tagged[L, R]
  count() -> int = 1

  firstOr(fallback: R) -> R = value

class Shelf[T](val held: List[T])

impl Countable for Shelf
  count() -> int = held.length

  firstOr(fallback: T) -> T = held.headOption.getOrElse(fallback)

counted[F[_]: Countable](x: F[int]) -> int = x.count() * 100 + x.firstOr(-1)

growing[F[_]: Sized](x: F[int]) -> (int, F[string]) = (x.count(), x.resized(n -> s"#$n"))

summed[F[_]: Foldable](xs: F[int]) -> int = xs.foldLeft(0, (a, b) -> a + b)

sortedSum[F[_: Ord]: Foldable](xs: F[int]) -> int = xs.foldLeft(0, (a, b) -> a + b)

// Through `Traverse`, which requires `Foldable`, the fold is the bound's too.
widest[F[_]: Traverse](xs: F[string]) -> int = xs.foldLeft(0, (a, s) -> if s.charCount > a then s.charCount else a)

// A value whose type is the trait, as for any trait for types.
countOf(x: Countable[int]) -> int = x.count()

totalOf(x: Foldable[int]) -> int = x.foldLeft(0, (a, b) -> a + b)

// An impl adding to the constructors a bound of the trait admits.
impl[F[_]: Countable, A] F[A]
  isLone() -> bool = count() == 1

// A generic class holding a constructor bounded by the trait.
class Tally[F[_]: Foldable](val parts: Vector[F[int]])
  total() -> int = parts.foldLeft(0, (acc, p) -> acc + summed(p))

// A closure given the bound's method, built in generic code and called after it returns.
adder[F[_]: Foldable](xs: F[int]) -> (int) -> int =
  val base = summed(xs)
  n -> n + base

main()
  println(counted(Bag([7, 8])))
  println(counted(Bag(Vector.empty[int]())))
  println(counted(Tagged("t", 5)))
  println(counted(Shelf(List(3))))
  println(growing(Bag([1, 2])))
  println(summed(Some(4)))
  val none: Option[int] = None
  println(summed(none))
  val ok: Result[int, string] = Ok(6)
  println(summed(ok))
  val right: Either[string, int] = Right(9)
  println(summed(right))
  println(summed([1, 2, 3]))
  println(summed(List(4, 5)))
  println(summed(Array.tabulate(4, i -> i)))
  println(sortedSum(TreeSet(1, 2, 2)))
  println(widest(["a", "héllo", "✓✓"]))
  println(widest(Some("four")))
  println(countOf(Bag([1, 2, 3])))
  println(countOf(Tagged(0, 1)))
  println(totalOf([10, 20]))
  println(totalOf(Some(30)))
  println(Bag([1]).isLone())
  println(Shelf(List(1, 2)).isLone())
  println(Tagged('x', "y").isLone())
  println(Tally[List]([List(1, 2), List(3)]).total())
  println(Tally[Option]([Some(1), None, Some(2)]).total())
  val add = adder(Bag([2, 3]).items)
  println(add(10))
  println(adder(Some(-5))(5))
  println(summed[Vector]([]))
  println(summed([2147483647, -2147483647]))
  println(summed[Seq](List(1, 2)) + summed[Iterable](HashSet(3)))
