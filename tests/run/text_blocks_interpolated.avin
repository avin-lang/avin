// expect: exit 0
// Every prefix composes with a text block. `s` and `f` read escapes, so a `\` at a line's end joins
// lines in them; `raw` and a program's own interpolator are given the parts as written, with the
// block's indentation and trailing blanks already dropped but no escape read and no line joined.

trait Pieces
    pieces(args: Display*) -> Vector[string]

impl Pieces for StringContext
    pieces(args: Display*) -> Vector[string] = parts

show(label: string, text: string)
    println(s"$label: [${text.replace("\n", "|")}]")

main()
    val name = "avin"
    val n = 7
    show("s", s"""
        name: $name
          count: ${n + 1}
        dollar $$ and quote $" and "lone"
        """)
    show("joined", s"""
        $name\
        -\
        ${n}
        """)
    show("f", f"""
        ${n}%03d|${2.5}%6.2f|
        ${name}%-6s|
        """)
    show("raw", raw"""
        C:\dir\file $name
          \t stays\
        """)
    // A hole may span lines; its lines are code, not the block's text.
    show("spanning", s"""
        sum ${
            n + 1
        } done
        """)
    val pieces = pieces"""
        a $name b
        c ${n} d
        """
    println(pieces.length)
    for p in pieces
        show("piece", p)
    // `raw` keeps `\"` as written, and a backslash before the closing quotes does not end the block.
    show("raw quote", raw"""
        say \"hi\"
        not closed \""" yet
        """)
    // A doubled backslash is taken whole, so the quotes after it close the block.
    show("raw backslash", raw"""
        end \\""")
