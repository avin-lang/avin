// expect: exit 0
// stderr: actor numbers vary
// The HTTP server's limits and life: a body over its limit answered `413` by its length and while
// chunked, a request line over the header limit `414` and headers over it `431`, each at the limit
// served; a client too slow `408`; a connection kept alive closed once idle for its limit; the
// connection limit holding the next connection unanswered until one ends; a hundred clients at
// once on few carriers; handlers that trap, a status out of range and a header with a line break,
// each answered `500` with the server living on; and a graceful shutdown with a request in flight,
// which is answered and closed, while a request on an idle connection is answered `503`, a new
// connection is refused, and `shutdown` waits for them all.
import avin.io.{ConnectionRefused, IoError}
import avin.net.{TcpServer, TcpStream}
import avin.net.http
import avin.net.http.{Response, ServerRequest}
import avin.threads.{Atomic, Channel, Promise, sleep, spawn}
import avin.time
import avin.time.{Duration, millis, monotonic}

@sysl("avin.rt.scheduler_workers")
workers() -> long

@sysl("avin.rt.processors")
processors() -> long

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message())

shown(bytes: Array[byte]) -> string = string.fromUtf8Lossy(bytes).replace("\r\n", "|")

open(server: TcpServer) -> TcpStream
    val c = ok(TcpStream.connect("127.0.0.1", server.port()))
    ok(c.setTimeout(time.seconds(10)))
    c

// The status line of everything the server sends for `text` until it closes the connection.
status(server: TcpServer, text: string) -> string
    val c = open(server)
    ok(c.writeText(text))
    val got = shown(ok(c.readAll()))
    c.close()
    val bar = got.indexOf('|')
    if bar < 0 then got else got.slice(0, bar)

// The status line and body of one response read from `c`.
response(c: TcpStream) -> string
    val first = ok(c.readLine()).getOrElse("")
    var length = 0
    while true
        val line = ok(c.readLine()).getOrElse("")
        if line.isEmpty() then break
        if line.toLowerCase().startsWith("content-length:") then length = line.slice(15, line.byteLength()).trim().toInt()
    val body = Buffer[byte]()
    while body.length() < length
        body.addAll(ok(c.read(length - body.length())))
    s"$first ${string.fromUtf8Lossy(body.toArray())}"

get(path: string) -> string = s"GET $path HTTP/1.1\r\nHost: t\r\n\r\n"

echoLength(r: ServerRequest) -> Response = Response.text(200, s"${r.method} ${r.target} ${r.body.length()}")

main()
    // Limits: a body of ten bytes at most, then sixty-four bytes of request line and headers.
    val small = ok(http.serve("127.0.0.1", 0, echoLength, maxBodyBytes = 10))
    println(status(small, "POST /b HTTP/1.1\r\nHost: t\r\nContent-Length: 10\r\nConnection: close\r\n\r\n0123456789"))
    println(status(small, "POST /b HTTP/1.1\r\nHost: t\r\nContent-Length: 11\r\n\r\n0123456789A"))
    println(status(small, "POST /b HTTP/1.1\r\nHost: t\r\nContent-Length: 99999999999999999999999\r\n\r\n"))
    println(status(small, "POST /b HTTP/1.1\r\nHost: t\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n5\r\n01234\r\n5\r\n56789\r\n0\r\n\r\n"))
    println(status(small, "POST /b HTTP/1.1\r\nHost: t\r\nTransfer-Encoding: chunked\r\n\r\n5\r\n01234\r\n6\r\n56789A\r\n0\r\n\r\n"))
    println(status(small, "POST /b HTTP/1.1\r\nHost: t\r\nTransfer-Encoding: chunked\r\n\r\nFFFFFFFFFFFFFFFFFFFFFFFF\r\n"))
    println(status(small, "POST /b HTTP/1.1\r\nHost: t\r\nContent-Length: 11\r\nExpect: 100-continue\r\n\r\n"))
    small.shutdown()
    val narrow = ok(http.serve("127.0.0.1", 0, echoLength, maxHeaderBytes = 64))
    println(status(narrow, s"GET /${"x".repeat(64)} HTTP/1.1\r\nHost: t\r\n\r\n"))
    println(status(narrow, s"GET /${"x".repeat(30)} HTTP/1.1\r\nHost: t\r\nX-Long: ${"y".repeat(30)}\r\n\r\n"))
    println(status(narrow, s"POST /${"x".repeat(9)} HTTP/1.1\r\nHost: t\r\nTransfer-Encoding: chunked\r\n\r\n0\r\nX-Trailer: ${"z".repeat(64)}\r\n\r\n"))
    println(status(narrow, s"GET /${"x".repeat(19)} HTTP/1.1\r\nHost: t\r\nConnection: close\r\n\r\n"))
    narrow.shutdown()

    // A client too slow: it stops part-way through its request, and is answered `408` once a wait
    // for it outlasts the limit. A connection kept alive is closed once idle for its own limit.
    val quick = ok(http.serve("127.0.0.1", 0, echoLength, readTimeout = millis(100), idleTimeout = millis(100)))
    val before = monotonic()
    println(status(quick, "GET /slow HTTP/1.1\r\nHost: t\r\n"))
    println(s"waited at least the limit: ${monotonic() - before >= millis(100)}")
    val idle = open(quick)
    ok(idle.writeText(get("/first")))
    println(response(idle))
    println(s"closed once idle: ${shown(ok(idle.readAll()))}|")
    idle.close()
    quick.shutdown()

    // One connection at most: the second waits unanswered until the first ends.
    val single = ok(http.serve("127.0.0.1", 0, echoLength, maxConnections = 1))
    val first = open(single)
    ok(first.writeText(get("/one")))
    println(response(first))
    val second = open(single)
    ok(second.writeText(get("/two")))
    ok(second.setTimeout(millis(100)))
    println(s"the second waits: ${second.readLine()}")
    first.close()
    ok(second.setTimeout(time.seconds(10)))
    println(s"then: ${response(second)}")
    second.close()
    single.shutdown()

    // A hundred clients at once, each answered once all have arrived, on few carriers.
    val warm = (0..<int(processors()) * 2).map(_ -> spawn(() -> sleep(millis(1)))).toVector()
    for t in warm do t.join()
    val started = workers()
    val go = Promise[unit]()
    val crowd = ok(http.serve("127.0.0.1", 0, r ->
        go.future.await()
        Response.text(200, r.target)))
    val port = crowd.port()
    val clients = (0..<100).map(i -> spawn(() ->
        http.get(s"http://127.0.0.1:$port/client/$i").map(r -> r.text() == s"/client/$i").getOrElse(false))).toVector()
    while crowd.connections() < 100 do sleep(millis(1))
    go.complete(())
    var answered = 0
    for c in clients
        if c.join() then answered += 1
    crowd.shutdown()
    println(s"answered: $answered, no carrier added: ${workers() - started <= processors()}")

    // Handlers that trap: each fails its connection alone, answered `500` and closed.
    val fragile = ok(http.serve("127.0.0.1", 0, r -> r.target match
        "/divide" -> Response.text(200, s"${1 / (r.body.length())}")
        "/status" -> Response.empty(99)
        "/header" -> Response(200, "OK", Vector(("X-Bad", "a\r\nb")), Array.empty[byte]())
        _ -> Response.text(200, "fine")))
    for path in ["/divide", "/status", "/header", "/fine"]
        println(status(fragile, s"GET $path HTTP/1.1\r\nHost: t\r\nConnection: close\r\n\r\n"))
    val sameConnection = open(fragile)
    ok(sameConnection.writeText(get("/fine") + get("/divide") + get("/fine")))
    println(response(sameConnection))
    println(s"${response(sameConnection)}, then closed: ${shown(ok(sameConnection.readAll()))}|")
    sameConnection.close()
    fragile.shutdown()

    // A graceful shutdown: the request in flight is answered with `Connection: close`; a request on a
    // connection that was idle is answered `503`; a new connection is refused; `shutdown` waits.
    val entered = Channel[string](8)
    val release = Promise[unit]()
    val graceful = ok(http.serve("127.0.0.1", 0, r ->
        if r.target == "/wait"
            entered.send(r.target)
            release.future.await()
        Response.text(200, s"done ${r.target}")))
    val gport = graceful.port()
    val idler = open(graceful)
    ok(idler.writeText(get("/early")))
    println(response(idler))
    val busy = open(graceful)
    ok(busy.writeText(get("/wait")))
    println(s"entered: ${entered.receive()}")
    val done = Atomic(false)
    val stopper = spawn(() ->
        graceful.shutdown()
        done.store(true))
    while !graceful.isStopping() do sleep(millis(1))
    ok(idler.writeText(get("/late")))
    println(s"on the idle connection: ${shown(ok(idler.readAll()))}")
    idler.close()
    var refused = false
    for _ in 0..<500
        TcpStream.connect("127.0.0.1", gport) match
            Err(ConnectionRefused) ->
                refused = true
                break
            Err(e) -> fail(e.message())
            Ok(late) -> late.close()
        sleep(millis(10))
    println(s"new connections refused: $refused, shutdown still waiting: ${!done.load()}")
    release.complete(())
    println(s"in flight: ${shown(ok(busy.readAll()))}")
    busy.close()
    stopper.join()
    println(s"shutdown returned: ${done.load()}, held: ${graceful.connections()}")

    // A connection that sends nothing is closed unanswered once its first wait outlasts
    // `readTimeout`; a shutdown waits for a connection idle between requests to reach its own limit.
    val patient = ok(http.serve("127.0.0.1", 0, echoLength, readTimeout = millis(100), idleTimeout = millis(1000)))
    val mute = open(patient)
    println(s"nothing sent, closed unanswered: ${shown(ok(mute.readAll()))}|")
    mute.close()
    val lingering = open(patient)
    ok(lingering.writeText(get("/kept")))
    println(response(lingering))
    val start = monotonic()
    patient.shutdown()
    println(s"shutdown waited for the idle limit: ${monotonic() - start >= millis(500)}, then closed: ${shown(ok(lingering.readAll()))}|")
    lingering.close()
