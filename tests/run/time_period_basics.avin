// expect: exit 0
// Periods on their own: the makers and their method forms, `years` as twelve months, months and days
// never converting, the empty period, adding, subtracting, negating and scaling, the parts of the
// months, equality and hashing as map and set keys, and the display, debug and ISO 8601 text of
// positive, negative, mixed-sign and empty periods.
import avin.time.{Period, months, years}

data Plan(name: string, every: Period)

same[T: Eq](a: T, b: T) -> bool = a == b

main()
    // Makers: functions, methods on `int`, and the constructor taking its fields as given.
    println(months(3) == 3.months())
    println(years(2) == 2.years())
    println(years(1) == months(12))
    println(years(-1) == months(-12))
    println(months(1) != Period(0, 30))
    println(months(1) != Period(1, 1))
    println(Period(1, 2) == Period(1, 2))
    println(Period.Zero == Period(0, 0))
    println(Period.Zero == months(0))
    println(Period.Zero.isZero())
    println(Period(0, 1).isZero())
    println(Period(1, -1).isZero())
    val p = Period(14, 3)
    println(s"${p.months} ${p.days}")

    // Arithmetic: parts add separately and never carry.
    println(months(11) + months(1))
    println(Period(0, 30) + Period(0, 1))
    println(Period(1, 2) + Period(3, 4))
    println(Period(1, 2) - Period(3, 4))
    println(-Period(1, 2))
    println(-Period.Zero)
    println(months(1) - months(1) == Period.Zero)
    println(Period(2, 5) * 3)
    println(Period(2, 5) * -1 == -Period(2, 5))
    println(Period(2, 5) * 0)
    println([months(1), months(2), Period(0, 3)].foldLeft(Period.Zero, (a, b) -> a + b))

    // The parts of the months, each with the period's sign.
    println(s"${months(14).toYearsPart()} ${months(14).toMonthsPart()}")
    println(s"${months(-14).toYearsPart()} ${months(-14).toMonthsPart()}")
    println(s"${months(12).toYearsPart()} ${months(12).toMonthsPart()}")
    println(s"${months(11).toYearsPart()} ${months(11).toMonthsPart()}")
    println(s"${Period(0, 400).toYearsPart()} ${Period(0, 400).toMonthsPart()}")

    // Display: years, months left over and days; the empty period as `0d`.
    println(Period(14, 3))
    println(Period(0, 14))
    println(Period.Zero)
    println(years(1))
    println(months(2))
    println(Period(12, 1))
    println(Period(-14, -3))
    println(Period(1, -3))
    println(Period(-1, 3))
    println(Period(2147483647, -2147483648))
    println(f"[${Period(1, 2)}%10s] [${Period(1, 2)}%-10s] [${Period.Zero}%4s] [${Period(14, 3)}%16?]")

    // Debug.
    println(debug(Period(14, 0)))
    println(debug(Period.Zero))
    println(debug(Period(-1, -1)))
    println(debug(Some(Period(0, 7))))
    println(debug(Plan("rent", months(1))))
    println(Plan("rent", months(1)))

    // ISO 8601 text.
    println(Period(14, 3).toIsoString())
    println(Period(0, 14).toIsoString())
    println(Period.Zero.toIsoString())
    println(years(3).toIsoString())
    println(months(5).toIsoString())
    println(Period(12, 1).toIsoString())
    println(Period(-14, -3).toIsoString())
    println(Period(1, -3).toIsoString())
    println(Period(-2147483648, 2147483647).toIsoString())

    // Equality and hashing: keys of a map and a set, a field of a data type, a generic `Eq`.
    val names = {months(1): "monthly", years(1): "yearly", Period(0, 7): "weekly"}
    println(s"${names(months(12))} ${names(Period(1, 0))} ${names(Period(0, 7))} ${names.get(Period(0, 30))}")
    val seen = Set(months(12), years(1), Period(0, 1), Period(0, 1))
    println(seen.size())
    println(Plan("rent", months(1)) == Plan("rent", Period(1, 0)))
    println(Plan("rent", months(1)) == Plan("rent", Period(0, 30)))
    println(same(years(2), months(24)))
    println(same(years(2), Period(0, 730)))

    // Captured by a closure.
    val step = Period(0, 7)
    val steps = (1..3).map(n -> step * n)
    println(steps)
