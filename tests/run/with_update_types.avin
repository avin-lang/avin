// expect: exit 0
// Each value is read against the type of the field its path ends at, so a literal takes that type:
// an integer literal into a `long`, a `byte` or a `real` field, a collection literal into the
// field's collection, `None` and `Some` into an `Option`, a lambda into a function field. A generic
// data value keeps its type arguments, and a field of a type parameter takes a value of the
// argument's type. Fields holding classes, arrays and closures are shared with the base, not copied.

data Mix(n: long, b: byte, ratio: real, c: char, flag: bool)

data Bag(items: Vector[int], names: Set[string], ages: Map[string, int], list: List[int], buf: Buffer[int])

data Maybe(first: Option[int], second: Option[string])

data Box[T](v: T, label: string)

data Pair[A, B](a: A, b: B)

data Holder[T](inner: Box[T], count: int)

data Fns(f: int -> int, g: (int, int) -> int)

class Counter(var n: int)

data Refs(counter: Counter, arr: Array[int], name: string)

data Wide(any: Any, shown: Display)

main() -> int
  val m = Mix(1, byte(2), 0.5, 'a', false)
  println(m with {n = 9_000_000_000, b = 255})
  println(m with {ratio = 1, c = 'é', flag = true})
  println(m with {n = -9223372036854775808})

  val bag = Bag([1], {"a"}, {"x": 1}, List(1), [7])
  val bag2 = bag with {items = [], names = {"b", "c"}, ages = {"y": 2, "z": 3}, list = [4, 5]}
  println(bag2.items)
  println(bag2.names.size)
  println(bag2.ages.size)
  if (m with {ratio = 1}).ratio != 1.0 then return 4
  println(bag2.list)
  println(bag2.buf)

  val mb = Maybe(Some(1), None)
  println(mb with {first = None, second = Some("s")})

  val bx = Box(1, "one")
  val bx2 = bx with {v = 2}
  val typed: Box[int] = bx2
  println(typed)
  println(Box("s", "str") with {v = "t", label = ""})
  println(Box(Some(1), "opt") with {v = None})
  val pr = Pair(1, "x") with {b = "y"}
  println(pr)
  val ho = Holder(Box('c', "char"), 0)
  println(ho with {inner.v = 'd', count = 1})
  println(ho with {inner = Box('e', "new")})

  val fs = Fns(x -> x + 1, (a, b) -> a + b)
  val fs2 = fs with {f = x -> x * 10}
  println(fs.f(2))
  println(fs2.f(2))
  println(fs2.g(2, 3))
  val k = 7
  val fs3 = fs2 with {g = (a, b) -> a * b + k}
  println(fs3.g(2, 3))

  val r = Refs(Counter(1), [1, 2], "r")
  val r2 = r with {name = "r2"}
  // The class object and the array are the same ones the base holds.
  r2.counter.n = 41
  r2.arr(0) = 10
  println(r.counter.n)
  println(r.arr(0))
  if r.counter !== r2.counter then return 1
  val r3 = r with {counter = Counter(0)}
  if r3.counter === r.counter then return 2
  if r3.arr !== r.arr then return 3

  val w = Wide(1, 2)
  println(w with {any = "now a string", shown = 'c'})
  0
