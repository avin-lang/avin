// expect: exit 0
// `length` read while other threads send and receive is always between zero and the bound, and
// settles at the number of values left once they stop.

import avin.threads.{Channel, spawn}

main(args: Vector[string])
  val ch = Channel[int](8)
  val producer = spawn(() ->
    for i in 0 ..< 2000 do ch.send(i)
    ch.close()
  )
  var sum = long(0)
  var seen = 0
  var bad = 0
  for x in ch
    val n = ch.length
    if n < 0 || n > 8 then bad += 1
    sum += long(x)
    seen += 1
  producer.join()
  println(s"$seen $sum $bad ${ch.length}")
