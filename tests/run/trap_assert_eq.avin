// expect: trap
// A failed `assertEq` shows both values in their `Debug` form, so strings inside are quoted, and
// reports the assertion's own place: rendering the values runs the program's derived `Debug`, which
// enters the library again, and the place is still the assertion's. What the program printed before
// it comes first.

data Tag(id: int, label: string) derives Eq, Debug

main()
    assertEq(Tag(1, "a"), Tag(1, "a"))
    println("first held")
    assertEq(Tag(2, "left" + "over"), Tag(2, "leftovers"))
