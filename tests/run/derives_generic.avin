// A generic type derives `Ord`, `Display` and `Debug` where its type arguments implement them: the
// derived impl bounds each parameter by the trait, so an instance at arguments that miss it is still
// made, compared and hashed, but neither ordered nor displayed.

data Pair[A, B](first: A, second: B) derives Display, Debug, Ord

class Cell[T](val item: T) derives Eq, Hash, Ord, Display, Debug

class Plain

largest[T: Ord](a: T, b: T) -> T = if a < b then b else a

describe(x: Any) -> string = x match
  d: Display -> "displays as " + d.toString()
  _ -> "does not display"

main()
  println(Pair(1, "a"))
  println(debug(Pair(1, "a")))
  println(Cell(Cell(2)))
  println(debug(Cell("s")))
  println(
    s"${Cell(3) < Cell(4)} ${largest(Cell(5), Cell(2))} ${Pair(1, 2) < Pair(1, 3)} ${largest(Pair("b", 1), Pair("a", 9))}"
  )
  val p = Pair(Plain(), 1)
  val c = Cell(Plain())
  println(s"${c == c} ${c == Cell(Plain())} ${c.hash() == c.hash()} ${p.second}")
  println(describe(Cell(1)))
  println(describe(c))
  println(describe(Pair(1, Cell(2))))
  println(describe(Pair(1, c)))
