// expect: exit 0
// An `Option[Nothing]` is always `None`. Where one made in a module value or returned by a function
// meets an option of a class or a string, it is that option's `None`: the program keeps those options
// as pointers, and every use below reads the same values it would of objects.

class Dog(val name: string) derives Display

val none = None

var made = 0

nothing() -> Option[Nothing] = None

counted() -> Option[Nothing]
    made += 1
    None

named(o: Option[Dog]) -> string = o.map(d -> d.name).getOrElse("nobody")

pick(n: int, d: Dog) -> Option[Dog] = if n > 0 then Some(d) else none

later() -> Option[Dog] = nothing()

chosen(n: int, d: Dog) -> Option[Dog] = n match
    0 -> nothing()
    1 -> none
    _ -> Some(d)

firstly(n: int, d: Dog) -> Option[string] = n match
    0 -> none
    _ -> Some(d.name)

main()
    val rex = Dog("rex")
    println(s"${named(pick(1, rex))} ${named(pick(0, rex))} ${named(later())} ${named(none)}")
    println(s"${named(chosen(0, rex))} ${named(chosen(1, rex))} ${named(chosen(2, rex))}")
    println(s"${firstly(0, rex)} ${firstly(1, rex)}")

    // Branches, `==`, and a lower-bounded method.
    val joined = if rex.name == "rex" then nothing() else Some(rex)
    println(joined)
    val o: Option[Dog] = Some(rex)
    println(s"${o.orElse(nothing())} ${later().orElse(none)} ${later().orElse(Some(rex))}")
    println(s"${later() == none} ${o == nothing()} ${none == later()} ${o != none}")
    val s: Option[string] = none
    println(s"$s ${s.getOrElse("empty")} ${s == nothing()}")

    // A converted value is still evaluated, once.
    val c: Option[Dog] = counted()
    println(s"$c ${named(counted())} $made")

    // A variable, a field of an Either or a Result, and collections.
    var held: Option[Dog] = none
    println(held.isEmpty)
    held = Some(rex)
    println(held)
    held = nothing()
    println(held)
    val r: Result[Option[Dog], string] = Ok(none)
    val e: Either[Option[Dog], int] = Left(nothing())
    println(s"$r $e ${r.map(x -> x.isDefined)}")
    val xs: Vector[Option[Dog]] = [none, Some(rex), nothing()]
    val ys = [Some(rex), none]
    val zs = [none, Some(rex)]
    println(s"$xs $ys $zs ${xs.map(named)}")
    val names = List(none, Some("a"), nothing())
    println(names.map(n -> n.getOrElse("-")))

    // Seen as `Any`, it is a `None` of either type.
    val any: Any = held
    val which = any match
        x: Option[Dog] -> s"dog option $x"
        _ -> "other"
    println(which)
