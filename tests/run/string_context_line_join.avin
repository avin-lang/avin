// expect: exit 0
// A text block's parts hold a `\` at a line's end as written, and `s` and `f` called on them join the
// line to the next, dropping the backslash, the line break and the blanks before it, as the compiler
// does for an `s"""…"""` literal. `raw` keeps them; an escaped backslash before a line break is a
// backslash, and `\n` written out is still a line break.
trait Again
  again(args: Display*) -> string

impl Again for StringContext
  again(args: Display*) -> string = StringContext(parts).s(args*)

main()
  println(StringContext(["a  \\\nb"]).s())
  println(StringContext(["x\t\\\n", "y"]).s(1))
  println(StringContext(["", "%d \\\nz"]).f(5))
  println(StringContext(["a\\\n"]).raw())
  val n = 2
  print(s"""
    one $n \
    two
    """)
  print(again"""
    one $n \
    two
    """)
  println(StringContext(["a\\nb"]).s())
  println(StringContext(["a\\\\\nb"]).s())
  println(StringContext(["\\\n"]).s() == "")
