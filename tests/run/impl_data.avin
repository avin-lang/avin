// `impl` adds methods to a data type. Inside them `self` is the value, the type's other methods are
// in scope by bare name, and so are the fields of a type with one variant.
data Point(x: int, y: int)

impl Point
  sum() -> int = x + y
  scaled(k: int) -> Point = Point(x * k, y * k)
  describe() -> string = s"($x, $y) sums to ${sum()}"
  same(other: Point) -> bool = x == other.x && self.y == other.y
  // A lambda in a method sees the fields and methods as the method does; a local hides a field.
  adder() -> (int) -> int = (n) -> n + x + sum()
  shadowed() -> int
    val x = 100
    x + y

// A type with several variants takes `self` apart with `match`; a variant with no fields is a value
// with methods too.
data Shape
  Circle(r: int)
  Rect(w: int, h: int)
  Empty

impl Shape
  area() -> int = self match
    Circle(r) -> 3 * r * r
    Rect(w, h) -> w * h
    Empty -> 0
  label() -> string = s"${kind()} of area ${area()}"
  private kind() -> string = self match
    Circle(_) -> "circle"
    Rect(_, _) -> "rect"
    Empty -> "nothing"

// An impl may come before the type it adds to.
impl Pair
  swap() -> Pair = Pair(second, first)

data Pair(first: string, second: string)

// A generic data type's impl names the type's parameters, in order.
data Chain[T]
  Link(head: T, tail: Chain[T])
  End

impl[T] Chain[T]
  length() -> int = self match
    Link(_, rest) -> 1 + rest.length()
    End -> 0
  first(otherwise: T) -> T = self match
    Link(h, _) -> h
    End -> otherwise
  prepend(item: T) -> Chain[T] = Link(item, self)
  // A method's own type parameters follow the type's.
  pairedWith[U](other: U, fallback: T) -> (T, U) = (first(fallback), other)

main()
  val p = Point(2, 3)
  println(s"${p.sum()}")
  println(p.scaled(10).describe())
  println(s"${p.same(Point(2, 3))} ${p.same(Point(3, 2))}")
  val add = p.adder()
  println(s"${add(1)} ${p.shadowed()}")
  val shapes = (Circle(2), Rect(3, 4), Empty)
  println(shapes.0.label())
  println(shapes.1.label())
  println(shapes.2.label())
  println(s"${Empty.area()}")
  val q = Pair("a", "b").swap()
  println(q.first + q.second)
  val c: Chain[int] = Link(1, Link(2, End))
  println(s"${c.length()} ${c.prepend(0).length()} ${c.first(9)} ${End[int].first(9)}")
  val words = End[string].prepend("x").prepend("y")
  println(s"${words.length()} ${words.first("")}")
  val paired = c.pairedWith("z", 0)
  println(s"${paired.0}${paired.1}")
