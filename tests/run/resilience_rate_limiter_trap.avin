// expect: trap
// The general rate limiter checks its numbers as the HTTP one does: a burst of one is taken, and a
// burst of none traps where the limiter is made.
import avin.resilience.RateLimiter
import avin.time.seconds

main()
  println(RateLimiter(1, seconds(1), burst = 1).burst)
  println(RateLimiter(1, seconds(1), burst = 0).burst)
