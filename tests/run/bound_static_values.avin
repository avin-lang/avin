// expect: exit 0
// A static member reached through a type parameter's bound, named without a call, is a function
// value of it, as on a known type: each instance of the code makes it of its type argument's member.
// Kept in a `val`, passed to a higher-order function, overloaded and chosen by the function type
// expected, with a `using` section filled where it is taken (from the given in scope, or the default),
// generic, inherited through a required trait, through one of several bounds, through one instance of
// a generic trait, captured by a closure, and from a generic function calling another.

class Tx(val id: int)

trait Parse
  static parse(text: string) -> Self
  static pick(x: int) -> string
  static pick(s: string) -> string
  static unit() -> Self
  static tagged(n: int, using tx: Tx) -> Self
  static stamped(n: int, using tx: Tx = Tx(9)) -> Self
  static pair[X](x: X, n: int) -> (X, Self)
  static joined(parts: int*) -> Self
  show() -> string

trait Bounded: Parse
  static top() -> Self

trait Labelled
  static label(n: int) -> string

trait Make[E]
  static make(source: E) -> Self

data Num(n: int)

impl Parse for Num
  static parse(text: string) -> Num = Num(text.charCount)
  static pick(x: int) -> string = s"num int $x"
  static pick(s: string) -> string = s"num string $s"
  static unit() -> Num = Num(0)
  static tagged(n: int, using tx: Tx) -> Num = Num(n * 100 + tx.id)
  static stamped(n: int, using tx: Tx) -> Num =Num(n * 10 + tx.id)
  static pair[X](x: X, n: int) -> (X, Num) = (x, Num(n))
  static joined(parts: int*) -> Num = Num(parts.sum)
  show() -> string = s"Num($n)"

impl Bounded for Num
  static top() -> Num = Num(int.MaxValue)

impl Labelled for Num
  static label(n: int) -> string = s"label $n"

impl Make[int] for Num
  static make(source: int) -> Num = Num(-source)

impl Parse for string
  static parse(text: string) -> string = text + "!"
  static pick(x: int) -> string = s"str int $x"
  static pick(s: string) -> string = s"str string $s"
  static unit() -> string = ""
  static tagged(n: int, using tx: Tx) -> string = s"tag $n/${tx.id}"
  static stamped(n: int, using tx: Tx) -> string =s"stamp $n/${tx.id}"
  static pair[X](x: X, n: int) -> (X, string) = (x, s"#$n")
  static joined(parts: int*) -> string = s"${parts.length} parts"
  show() -> string = s"'$self'"

apply[A, B](f: (A) -> B, a: A) -> B = f(a)

parsed[T: Parse](texts: Vector[string]) -> Vector[string]
  val parse = T.parse
  texts.map(parse).map(v -> v.show())

passed[T: Parse](texts: Vector[string]) -> Vector[string] = texts.map(T.parse).map(v -> v.show())

applied[T: Parse](text: string) -> string = apply(T.parse, text).show()

picked[T: Parse]() -> string
  val byInt: (int) -> string = T.pick
  val byText: (string) -> string = T.pick
  s"${byInt(1)}; ${byText("a")}"

unit[T: Parse]() -> string
  val make: () -> T = T.unit
  make().show()

tagged[T: Parse](n: int) -> string
  given tx = Tx(7)
  val f = T.tagged
  f(n).show()

taggedOuter[T: Parse](n: int, using tx: Tx) -> Vector[string] = [n, n + 1].map(T.tagged).map(v -> v.show())

stamped[T: Parse](n: int) -> string
  val f = T.stamped
  f(n).show()

paired[T: Parse]() -> string
  val f: (string, int) -> (string, T) = T.pair
  val (x, v) = f("x", 3)
  s"$x ${v.show()}"

joined[T: Parse]() -> string
  val f = T.joined
  f([1, 2, 3]).show()

top[T: Bounded]() -> string
  val f: () -> T = T.top
  val g = T.parse
  s"${f().show()} ${g("ab").show()}"

both[T: Parse & Labelled](n: int) -> string
  val f = T.label
  val g = T.parse
  s"${f(n)} ${g("xyz").show()}"

made[T: Make[int] & Parse](n: int) -> string
  val f = T.make
  f(n).show()

counter[T: Parse]() -> (string) -> string
  val parse = T.parse
  text -> parse(text).show()

nested[T: Parse](texts: Vector[string]) -> Vector[string] = passed[T](texts)

main()
  println(parsed[Num](["", "a", "héllo"]))
  println(parsed[string](["a", "ü"]))
  println(passed[Num](["xy"]))
  println(applied[string]("q"))
  println(picked[Num]())
  println(picked[string]())
  println(unit[Num]())
  println(unit[string]())
  println(tagged[Num](3))
  println(tagged[string](3))
  given outer = Tx(5)
  println(taggedOuter[Num](1))
  println(stamped[Num](2))
  println(stamped[string](2))
  println(paired[Num]())
  println(paired[string]())
  println(joined[Num]())
  println(joined[string]())
  println(top[Num]())
  println(both[Num](4))
  println(made[Num](6))
  val f = counter[Num]()
  println(f("four"))
  println(nested[string](["n"]))
  val direct = Num.parse
  println(direct("non-generic").show())
