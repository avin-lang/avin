// expect: exit 0
// env: AVIN_GC_STRESS=0
// Nesting is recursion: each level of parentheses is a few calls deep in the parser, so the depth a
// grammar reaches is bounded by the stack it runs on. 2,000 levels fit the main thread's stack, and
// a thread given 64 MiB takes 10,000. A collection at every allocation would scan the deep stack
// each time, so the collector runs as it would in a program.
import avin.parsing.{Parser, chainLeft, defer, integer, symbol, token}
import avin.threads.spawn

lazy val number: Parser[long] = token(integer)

lazy val parens: Parser[long] = symbol("(") ~> defer(expr) <~ symbol(")")

lazy val factor: Parser[long] = number | parens

lazy val term: Parser[long] = chainLeft(factor, symbol("*") ^^^ ((a: long, b: long) -> a * b))

lazy val expr: Parser[long] = chainLeft(term, symbol("+") ^^^ ((a: long, b: long) -> a + b))

nested(depth: int) -> string = "(".repeat(depth) + "1 + 2" + ")".repeat(depth)

main()
    print(expr.parse(nested(2000)))
    val deep = nested(10000)
    print(spawn(() -> expr.parse(deep), stack = 67108864).join())
    val unclosed = "(".repeat(10000) + "1" + ")".repeat(9999)
    print(spawn(() -> expr.parse(unclosed), stack = 67108864).join())
