// expect: exit 0
// A data type that derives `Ord` orders by variant, in declaration order, and then by the fields;
// `Display` and `Debug` write a variant as `Name(a, b)`, one without fields as its name, nesting
// through the fields' own forms. A generic type's `Ord` holds where its type arguments are ordered,
// and its `Display` needs its parameters bounded by `Display`. `Eq` and `Hash`, which a data type
// has already, may be derived too.

class Point(x: int, y: int) derives Eq, Hash, Ord, Display, Debug

data Shape derives Eq, Hash, Ord, Display, Debug
  Circle(radius: int)
  Rect(width: int, height: int)
  Empty

data Text derives Display, Debug
  Plain(text: string, mark: char)
  Nested(inner: Text, score: real)

data Box[T: Display](item: T) derives Ord, Display

data Cell[T](value: T) derives Ord

class Token(val id: int)

data Holder(point: Point, tag: string) derives Display, Debug

largest[T: Ord](a: T, b: T) -> T = if a < b then b else a

main()
  println(
    s"${Circle(3) < Rect(0, 0)} ${Rect(1, 2) < Rect(1, 3)} ${Rect(2, 0) > Rect(1, 9)} ${Empty > Rect(9, 9)} ${Empty <= Empty}"
  )
  println(s"[${Rect(1, 2)}] ${Circle(5)} $Empty ${debug(Empty)} ${largest(Circle(9), Rect(0, 1))}")
  println(s"${Circle(1) == Circle(1)} ${Circle(1).hash() == Circle(1).hash()}")
  val t = Nested(Plain("hi\n", 'c'), 1.5)
  println(t)
  println(debug(t))
  println(s"${largest(Box(3), Box(8))} ${largest(Box(Point(1, 2)), Box(Point(0, 9)))} ${Box("s") < Box("t")}")
  val token = Token(1)
  println(
    s"${Cell(token) == Cell(token)} ${Cell(token) == Cell(Token(1))} ${Cell(1) < Cell(2)} ${largest(Cell("a"), Cell("b")).value}"
  )
  val h = Holder(Point(1, 2), "a \"b\"")
  println(h)
  println(debug(h))
  StandardOutput.write("[")
  Rect(1, 2).display(StandardOutput, FormatSpec(width = 14, left = true))
  println("]")
