// expect: trap
// A hook that traps while it holds a mutex leaves the state the mutex guards in doubt, and a later
// hook may need it, so the program stops at once: the hooks after it do not run.
import avin.process
import avin.threads.Mutex

main()
  val counts = Mutex(Buffer[int]())
  process.onExit(() -> println("not run"))
  process.onExit(() ->
    println("takes the lock")
    counts.with(b -> b(3)))
  process.onExit(() -> println("first"))
  println("main ends")
