// A binding takes a value of a one-variant data type apart by its constructor pattern, which cannot
// fail: bare and qualified constructors, nested ones, `_`, generic types, `var`, a name bound with
// `@`, tuples mixed in both directions, a declared type, a `for` loop, and closures that capture the
// names bound. Every allocation collects (the test runner sets AVIN_GC_STRESS), so the strings and
// lists the names hold must be found by the collector.

data Point(x: int, y: int)

data Line(start: Point, tip: Point)

data Box[T](value: T)

data Labelled(name: string, tags: List[string])

data Framed(corners: (int, int), label: string)

data Wrap
  Only(n: int)

sum(p: Point) -> int
  val Point(a, b) = p
  a + b

main() -> int
  val Point(a, b) = Point(1, 2)
  println(a + b)
  val Line(Point(x0, y0), tip) = Line(Point(3, 4), Point(5, 6))
  println(s"$x0 $y0 ${tip.x} ${tip.y}")
  val Line(_, Point(_, far)) = Line(Point(0, 0), Point(7, 8))
  println(far)
  val Point(_, _) = Point(9, 9)
  val Box(v) = Box(3)
  println(v + 1)
  val Box(word) = Box("héllo, wörld")
  println(word)
  val Box(Box(inner)) = Box(Box(-2147483648))
  println(inner)
  var Point(lo, hi) = Point(10, 20)
  lo += 1
  hi = hi * 2
  println(s"$lo $hi")
  val whole @ Point(wx, wy) = Point(11, 12)
  println(s"${whole.x + whole.y} $wx $wy")
  val Point(pa, pb), n = Point(13, 14), 15
  println(pa + pb + n)
  val (Point(qa, qb), m) = (Point(16, 17), 18)
  println(qa + qb + m)
  val Framed((cx, cy), label) = Framed((19, 20), "frame")
  println(s"$label $cx $cy")
  val Point(da, db): Point = Point(21, 22)
  println(da * db)
  val Wrap.Only(k) = Only(23)
  println(k)
  val Only(j) = Only(24)
  println(j)
  val Labelled(name, tags) = Labelled("ünïcode", List("a", "b", "c"))
  println(s"$name ${tags.size}")
  val Point(ca, cb) = Point(25, 26)
  val add = (z: int) -> ca + cb + z
  println(add(1))
  println(sum(Point(27, 28)))
  var total = 0
  for Point(fx, fy) in [Point(1, 2), Point(3, 4), Point(5, 6)]
    total += fx * fy
  println(total)
  for Line(Point(sx, _), _) in [Line(Point(100, 0), Point(0, 0))] do println(sx)
  0
