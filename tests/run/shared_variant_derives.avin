// expect: exit 0
// Derived impls of types sharing variant names: each is made from its own type's variants, so
// `Display` and `Debug` write the shared name, `Eq`, `Hash` and `Ord` compare by the type's own
// declaration order, a shape names each variant, and a template's `build` makes the type's own
// variant from its index.
data Slant derives Eq, Hash, Ord, Display, Debug, Pick
    Normal
    Italic
    Lean(by: int)

data Weight derives Eq, Hash, Ord, Display, Debug, Pick
    Bold
    Normal
    Lean(by: string)

// Makes the variant at a given index, reading every field as its text.
trait Pick
    static pick(index: int, text: string) -> Result[Self, string]
    static second() -> string

derive Pick for T
    static pick(index: int, text: string) -> Result[T, string] = T.build(Picker(index, text))
    static second() -> string = T.shape().variants(1).name

class Picker(index: int, text: string)
    var given = false

impl ShapeBuilder[string] for Picker
    variant(t: TypeShape) -> Result[int, string] =
        if index < t.variantCount then Ok(index) else Err(s"${t.name} has no variant $index")
    next(v: VariantShape) -> Result[Option[int], string] =
        if given || v.fieldCount == 0 then return Ok(None)
        given = true
        Ok(Some(0))
    duplicate(f: FieldShape) -> string = s"duplicate ${f.name}"

impl Picker
    field[F: Read](f: FieldShape) -> Result[F, string] = Ok(F.read(text))
    missing[F: Read](f: FieldShape) -> Result[F, string] = Err(s"missing ${f.name}")

trait Read
    static read(text: string) -> Self

impl Read for int
    static read(text: string) -> int = text.toInt()

impl Read for string
    static read(text: string) -> string = text

main()
    val s: Slant = Normal
    val w: Weight = Normal
    println(s"$s $w ${Slant.Lean(2)} ${Weight.Lean("x")}")
    println(debug(Slant.Lean(3)))
    println(debug(Weight.Lean("w")))
    println(s == Normal)
    println(w < Normal)
    println(Bold < w)
    println(s < Italic)
    println(s.hash() == Slant.Normal.hash())
    println(Set[Weight](Normal, Bold, Normal).size)
    println(s"${Slant.second()} ${Weight.second()}")
    println(Slant.pick(0, ""))
    println(Weight.pick(1, ""))
    println(Slant.pick(2, "7"))
    println(Weight.pick(2, "seven"))
    println(Weight.pick(3, ""))
