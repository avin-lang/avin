// expect: exit 0
// A module-level `lazy val` may name itself in code its initializer makes and hands on without
// running it: a lazy list's tail passed by name, a handler, a method value, a lambda stored and
// called later. Such a read runs after the initializer has returned and finds the value, so none
// of these is a cycle. Two objects whose lazy fields read each other, and a value holding an object
// whose lazy field reads that value (of a generic class too), need nothing of each other to be made.
import avin.threads.scope

lazy val ones: LazyList[int] = LazyList.cons(1, ones)

lazy val fibs: LazyList[long] = LazyList.cons(0, LazyList.cons(1, fibs.zip(fibs.tail).map(p -> p.0 + p.1)))

lazy val counting: LazyList[int] = 0 #:: counting.map(n -> n + 1)

class Button(val label: string, val onClick: () -> string)

lazy val button: Button = Button("ok", () -> s"clicked ${button.label}")

class Greeter(val name: string, val greet: () -> string)

greeting() -> string = s"hello from ${greeter.name}"

lazy val greeter: Greeter = Greeter("greeter", greeting)

lazy val countdown: (int) -> int = n -> if n <= 0 then 42 else countdown(n - 1)

lazy val isEven: (int) -> bool = n -> n == 0 || isOdd(n - 1)

lazy val isOdd: (int) -> bool = n -> n != 0 && isEven(n - 1)

class Cell[T](val value: T, val again: () -> Cell[T])

lazy val looped: Cell[string] = Cell("loop", () -> looped)

lazy val top: int = middle + 1

lazy val middle: int = bottom() * 2

bottom() -> int = 20

object Left
  val k: int = 1
  lazy val x: int = Right.y + 10

object Right
  val k: int = 2
  lazy val y: int = Left.k + 20

class Holder
  lazy val v: int = holder.base + 1
  val base: int = 6

val holder: Holder = Holder()

class Wrap[T](val item: T)
  lazy val size: int = wrapped.item.charCount

val wrapped: Wrap[string] = Wrap("four")

lazy val shared: int = 99

main()
  println(ones.take(4).toVector)
  println(fibs.take(10).toVector)
  println(counting.take(5).toVector)
  println(button.onClick())
  println(greeter.greet())
  println(countdown(5))
  println(s"${isEven(10)} ${isOdd(7)} ${isEven(3)}")
  println(looped.again().again().value)
  println(top)
  println(s"${Left.x} ${Right.y}")
  println(holder.v)
  println(wrapped.size)
  scope(s ->
    s.spawn(() -> println(shared))
    s.spawn(() -> println(shared)))
