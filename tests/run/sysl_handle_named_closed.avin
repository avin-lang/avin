// expect: trap
// A handle whose `@sysl` gives it a name with `named` traps under that name, not its class's: a bound
// method after `close()` names the handle as it is named.

@sysl("sysl.checksum.Crc32", named: "Checksum")
class Crc32
    finish() -> long

@sysl("sysl.checksum.new_crc32")
newCrc32() -> Crc32

main()
    val c = newCrc32()
    println(c.finish())
    c.close()
    c.close()
    println(c.finish())
