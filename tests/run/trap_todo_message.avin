// expect: trap
// `todo(message)` reached says what is not implemented, at the call, in a generic function.

parse[T](text: string, fallback: T) -> T
  if text == "" then fallback else todo(s"parsing \"$text\"")

main()
  println(parse("", 7))
  println(parse("", "seven"))
  println(parse("8", 0))
