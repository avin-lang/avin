// expect: exit 0
// Closing a channel lets its values be drained: each one sent before the close is received, and then
// `receive` gives `None`, every time after too. Receivers already waiting when it closes wake and get
// `None`. `tryReceive` gives `None` while nothing is waiting. Closing twice does nothing.
import avin.threads.{Channel, spawn}

main() -> int
    val ch = Channel[string]()
    print(ch.tryReceive())
    ch.send("a")
    ch.send("b")
    ch.send("c")
    ch.close()
    ch.close()
    print(ch.receive())
    print(ch.tryReceive())
    print(ch.receive())
    print(ch.receive())
    print(ch.receive())
    val idle = Channel[int](1)
    var waiting: List[avin.threads.Thread[Option[int]]] = []
    for i in 0..<4 do waiting = spawn(() -> idle.receive()) :: waiting
    idle.close()
    for w in waiting do print(w.join())
    0
