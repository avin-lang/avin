// expect: exit 0
// The reference parts of a tuple taken apart from a call, which arrive as words of the call's
// result, kept alive while the program allocates: across calls, in loops, captured by closures (a
// `var` captured is boxed as it is bound, an allocation while the other parts are held), and in
// lightweight threads switched at their polls. Run with a collection at every allocation, a
// reference part the frame failed to keep would be freed and reused.
import avin.threads.spawn

data Cell(n: int, label: string)

// Recursive, so each call is made rather than copied in.
make(k: int) -> (string, int, Cell)
    if k > 0
        val (s, n, c) = make(k - 1)
        return (s + "+", n + 1, Cell(c.n + k, c.label))
    ("s", 0, Cell(0, "cell"))

// Allocates enough to collect many times over.
churn(n: int) -> int
    var xs: List[string] = []
    for i in 0..<n do xs = s"x$i" :: xs
    xs.length()

acrossCalls() -> string
    val (s, n, c) = make(3)
    val noise = churn(200)
    val (t, m, d) = make(2)
    val more = churn(200)
    s"$s $n ${c.n} ${c.label} $t $m ${d.n} $noise $more"

inLoop() -> string
    var total = 0
    var longest = ""
    for i in 0..<300
        val (s, n, c) = make(i % 7)
        total += churn(3)
        total += n + c.n + s.byteLength()
        if s.byteLength() > longest.byteLength() then longest = s
    s"$total $longest"

throughClosures() -> string
    val (s, n, c) = make(4)
    val show = () -> s"$s/$n/${c.label}"
    val made = churn(100)
    var (acc, count, last) = make(2)
    val bump = (x: string) ->
        acc = acc + x
        count += 1
    for i in 0..<20 do bump(i.toString())
    val again = churn(100)
    s"${show()} $acc $count ${last.n} $made $again"

// Each thread holds parts across its own loop, which polls and lets other threads run.
worker(id: int) -> int
    var failures = 0
    for round in 0..<200
        val (s, n, c) = make(id % 5 + 1)
        var spin = 0
        for i in 0..<50
            spin += churn(1)
        if s.byteLength() != id % 5 + 2 || n != id % 5 + 1 || c.label != "cell" || spin != 50 then failures++
    failures

main() -> int
    println(acrossCalls())
    println(inLoop())
    println(throughClosures())
    val threads = Vector.newBuilder[avin.threads.Thread[int]]()
    for id in 0..<8
        threads.addOne(spawn(() -> worker(id)))
    var failures = worker(8)
    for t in threads.result() do failures += t.join()
    println(s"$failures failures")
    failures
