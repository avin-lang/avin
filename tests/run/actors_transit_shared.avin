// expect: exit 0
// Handing a value over stops at what is shared between owners. An actor that owns a connection
// sends another a message holding its own reference, a future and a channel beside a handle field,
// and starts a child whose behaviour captures its reference: neither walk reaches the actor's state
// through the reference, so the connection stays the actor's and it goes on using it.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.actors.{ActorRef, Behaviour, spawn}
import avin.threads.{Channel, Future, Promise}

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message())

data Note(from: ActorRef[Cmd], seen: Future[unit], log: Channel[string], conn: Option[TcpStream])

data Cmd
    Open(port: int, done: Promise[unit])
    Greet(other: ActorRef[Note], done: Promise[string])
    Child(done: Promise[string])
    Read(done: Promise[string])

actor Listener receives Note
    receive
        Note(from, _, log, _) -> log.send(s"note from $from")

actor Owner receives Cmd
    var conn: Option[TcpStream] = None
    receive
        Open(port, done) ->
            conn = Some(ok(TcpStream.connect("127.0.0.1", port)))
            done.complete(())
        Greet(other, done) ->
            val log = Channel[string](1)
            other tell Note(self, Promise[unit]().future, log, None)
            log.receive()
            done.complete(ok(conn.get().readLine()).getOrElse("end"))
        Child(done) ->
            val parent = self
            spawn(Behaviour[int]("Kid", me -> n -> parent.toString()))
            done.complete(ok(conn.get().readLine()).getOrElse("end"))
        Read(done) -> done.complete(ok(conn.get().readLine()).getOrElse("end"))

call[T: Sendable](r: ActorRef[Cmd], make: (Promise[T]) -> Cmd) -> T
    val p = Promise[T]()
    r tell make(p)
    p.future.await()

main()
    val l = ok(TcpListener.bind("127.0.0.1", 0))
    val owner = spawn(Owner())
    call[unit](owner, p -> Open(l.port(), p))
    val far = ok(l.accept())
    ok(far.writeText("one\ntwo\nthree\n"))
    println(call[string](owner, p -> Greet(spawn(Listener()), p)))
    println(call[string](owner, p -> Child(p)))
    println(call[string](owner, p -> Read(p)))
