// expect: exit 0
// `===` is defined wherever one side is a reference that cannot be a value type: an instance of a
// class, an `object`, an array, a buffer, a function value, or a type parameter bounded by a class.
// The other side may then be an `Any`, a trait, an unbounded type parameter, or a sub- or superclass,
// and a boxed value or a data value on that side is never the same object.

trait Shape
    area() -> int

data Tile(s: int)

impl Shape for Tile
    area() -> int = s * s

impl Shape for int
    area() -> int = self * self

open class Animal(val name: string)

class Dog(name: string): Animal(name)

class Cat(name: string): Animal(name)

class Sq(s: int): Shape
    override area() -> int = s * s

object Origin

withAny(a: Any, b: Sq) -> bool = a === b

anyRight(b: Sq, a: Any) -> bool = b !== a

withTrait(a: Shape, b: Sq) -> bool = a === b

traitRight(b: Sq, a: Shape) -> bool = b === a

withParameter[T](a: T, b: Sq) -> bool = a === b

parameterRight[T](b: Sq, a: T) -> bool = b !== a

bounded[T: Animal](a: T, b: T) -> bool = a === b

boundedWithClass[T: Animal](a: T, b: Animal) -> bool = a === b

boundedWithAny[T: Animal](a: T, b: Any) -> bool = a === b

functions(f: int -> int, g: int -> int) -> bool = f === g

functionWithAny(f: int -> int, x: Any) -> bool = x === f

up(a: Animal, d: Dog) -> bool = a === d

main()
    val sq = Sq(2)
    val twin = Sq(2)
    println(s"${withAny(sq, sq)} ${withAny(twin, sq)} ${withAny(4, sq)} ${withAny("s", sq)} ${withAny(Tile(2), sq)} ${withAny((1, 2), sq)} ${withAny((), sq)}")
    println(s"${anyRight(sq, sq)} ${anyRight(sq, twin)} ${anyRight(sq, 4)} ${anyRight(sq, None)}")
    println(s"${withTrait(sq, sq)} ${withTrait(twin, sq)} ${withTrait(4, sq)} ${withTrait(Tile(2), sq)}")
    println(s"${traitRight(sq, sq)} ${traitRight(sq, twin)} ${traitRight(sq, 2)}")
    println(s"${withParameter(sq, sq)} ${withParameter(twin, sq)} ${withParameter(4, sq)} ${withParameter("x", sq)} ${withParameter(Tile(1), sq)} ${withParameter(long(9), sq)}")
    println(s"${parameterRight(sq, sq)} ${parameterRight(sq, 2.5)} ${parameterRight(sq, 'c')}")
    val d = Dog("rex")
    val c = Cat("tom")
    println(s"${bounded(d, d)} ${bounded(d, Dog("rex"))} ${boundedWithClass(d, d)} ${boundedWithClass(c, d)} ${boundedWithAny(d, d)} ${boundedWithAny(d, 3)}")
    val inc = (x: int) -> x + 1
    val dec = (x: int) -> x - 1
    println(s"${functions(inc, inc)} ${functions(inc, dec)} ${functionWithAny(inc, inc)} ${functionWithAny(inc, 3)}")
    println(s"${up(d, d)} ${up(c, d)} ${up(Dog("rex"), d)}")
    // Arrays, buffers and objects are references, and compare with an `Any` holding them.
    val arr = Array.tabulate(2, i -> i)
    val held: Any = arr
    val buf = Buffer[int]()
    val heldBuf: Any = buf
    val o: Any = Origin
    println(s"${held === arr} ${held === Array.tabulate(2, i -> i)} ${heldBuf === buf} ${o === Origin} ${o !== Origin}")
    // Many short-lived boxes on the other side never compare as the object.
    var hits = 0
    for i in 0..<2000
        if withAny(i, sq) || withParameter(Tile(i), sq) || withTrait(i, sq) then hits += 1
        if withAny(sq, sq) then hits += 1
    println(hits)
