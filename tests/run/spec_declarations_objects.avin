// expect: exit 0
// Spec probes for declarations, object: an object extending an abstract class, an object passed as a
// value of its own type, a companion's apply overloading the constructor (fixed, repeated and by-name
// with a trailing block), the companion as a function value, a data companion's private member used by
// an impl, and module-level vals and vars.
abstract class Shape(val label: string)
    area() -> int
    describe() -> string = s"$label ${area()}"

object Unit1: Shape("unit")
    override area() -> int = 1
    override describe() -> string = "the " + super.describe()

object Counter
    var hits = 0
    hit() -> int
        hits += 1
        hits

useObj(c: Counter) -> int = c.hit()

class Pair(val a: int, val b: int)

object Pair
    apply(a: int) -> Pair = Pair(a, a)
    apply(items: int*) -> Pair = Pair(items.length(), 0)

data Cell[T](value: T)

class Lazy[T](private val cell: Cell[T])
    get() -> T = cell.value

object Lazy
    apply[T](body: -> T) -> Lazy[T] = Lazy(Cell(body))

data Temp(c: int)

object Temp
    private secret() -> int = 7
    freezing() -> Temp = Temp(0)

impl Temp
    plusSecret() -> int = c + Temp.secret()

var calls = 0
val limit = 3

bump() -> int
    calls += 1
    calls

main()
    val s: Shape = Unit1
    println(s.describe())
    val held = Counter
    println(s"${useObj(held)} ${useObj(Counter)} ${Counter.hits}")
    val p1 = Pair(5)
    val p2 = Pair(1, 2)
    val p3 = Pair(1, 2, 3)
    println(s"${p1.a} ${p1.b} ${p2.a} ${p2.b} ${p3.a} ${p3.b}")
    val made = [1, 2].map(Pair)
    println(made.map(p -> p.a + p.b).mkString(","))
    val two: (int, int) -> Pair = Pair
    println(s"${two(3, 4).b} ${Pair.apply(9).b}")
    val l = Lazy
        val x = 20
        x + 1
    println(l.get())
    println(s"${Lazy[int](Cell(4)).get()} ${Lazy(Cell(5)).get()} ${Lazy("s").get()}")
    println(s"${Temp.freezing().plusSecret()} ${Temp(3).plusSecret()}")
    bump()
    bump()
    println(s"$calls $limit")
