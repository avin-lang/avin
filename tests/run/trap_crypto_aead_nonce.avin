// expect: trap
// A nonce the caller gives is 12 bytes; one of 8 traps rather than sealing under a nonce the cipher
// would pad out.
import avin.crypto.Aes256Gcm

main()
  val key = Aes256Gcm.generateKey()
  println(key.sealWithNonce(Vector.fill(12, byte(0)), "m".bytes).length)
  println(key.sealWithNonce(Vector.fill(8, byte(0)), "m".bytes).length)
