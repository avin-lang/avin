// expect: exit 0
// The library's threads build options of arrays, which have no `Ord`, inside code that shows and
// orders other options; the ordering options have only where their values do is not needed there,
// so a program loading the threads compiles, and orders options of its own.
import avin.threads.Mutex

main()
  println(1)
  val a: Option[int] = None
  println(a < Some(1))
  println(Some(Some(3)) > Some(None))
