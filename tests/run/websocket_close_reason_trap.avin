// expect: trap
// A close reason is at most 123 bytes of UTF-8, so the frame's payload with its code fits a control
// frame's 125: 123 bytes are taken, and 124, counted in bytes rather than characters, trap.
import avin.net.http
import avin.net.http.{Route, Router, WebSocket, webSocket}

main()
  val router = Router([Route.get("/", r -> webSocket(r, ws -> _ = ws.receive()))])
  val server = http.serve("127.0.0.1", 0, router.handle).ok.get
  val connect = () -> WebSocket.connect(s"ws://127.0.0.1:${server.port()}/").ok.get
  println(connect().close(1000, "x".repeat(123)).isOk)
  _ = connect().close(1000, "é".repeat(62))
