// expect: exit 0
// An operator on a data type or a class calls the type's trait method, so a module value built with
// `+`, `-`, `<`, `==` or unary `-` initializes after the module values that method reads, wherever
// the file declares them. The operators are used directly, through a bound, on a class, and on a
// tuple of data values whose element compares by its own method.

data Money(cents: int)

impl Add for Money
  add(other: Money) -> Money = Money(cents + other.cents + fee)
  static zero() -> Money = Money(0)

impl Neg for Money
  negate() -> Money = Money(-cents - fee)

impl Ord for Money
  compare(other: Money) -> int = cents + limit - other.cents

impl Eq for Money
  equals(other: Money) -> bool = cents + slack == other.cents

impl Hash for Money
  hash() -> long = long(cents)

class Weight(val grams: int): Add
  override add(other: Weight) -> Weight = Weight(grams + other.grams + tare)
  override static zero() -> Weight = Weight(tare)

val total = Money(1) + Money(2)

// A static member reads the module value it needs, called on the type and through a bound.
val empty = Weight.zero()

val started = start[Weight]()

start[T: Add]() -> T = T.zero()

val negated = -Money(5)

val smaller = Money(1) < Money(2)

val same = Money(1) == Money(11)

val pair = (Money(1), 1) == (Money(11), 1)

val doubled = twice(Money(3))

val heavy = Weight(1) + Weight(2)

twice[T: Add](x: T) -> T = x + x

val fee = 100

val limit = 10

val slack = 10

val tare = 7

main()
  println(total.cents)
  println(negated.cents)
  println(smaller)
  println(same)
  println(pair)
  println(doubled.cents)
  println(heavy.grams)
  println(s"${empty.grams} ${started.grams}")
