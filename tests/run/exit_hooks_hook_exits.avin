// expect: exit 2
// `exit` inside a hook ends only that hook: the hooks after it still run, and the program ends with
// the status of the ending that ran them, here the first `exit`'s.
import avin.process

main() -> int
    process.onExit(() -> println("last hook"))
    process.onExit(() ->
        println("hook calls exit(7)")
        process.exit(7)
        println("not reached"))
    process.onExit(() -> println("first hook"))
    process.exit(2)
