// A directory listed through `avin.fs`: the names of its entries, files and directories alike,
// without the directory before them and without `.` and `..`, sorted by code point: capitals before
// small letters, and a name beyond ASCII after both.
import avin.fs

// The temporary directory the test works in, written as `DIR` in what it prints, which an error
// names, so the output is the same on every run.
var root = ""

say(line: Any)
  println(if root == "" then s"$line" else s"$line".replace(root, "DIR"))

main()
  val dir = fs.createTempDir("avin-listing") match
    Ok(d) -> d
    Err(e) ->
      say(s"no directory: $e")
      return
  root = dir
  say(fs.listDir(dir))
  for name in ["b.txt", "a.txt", "notes", "ünïcode", "Zed", "a"] do _ = fs.writeText(dir + "/" + name, name)
  _ = fs.createDir(dir + "/sub")
  _ = fs.writeText(dir + "/sub/inner", "")
  val names = fs.listDir(dir).getOrElse([])
  say(names)
  say(names.contains("inner") || names.contains(".") || names.contains(".."))
  say(fs.listDir(dir + "/sub"))
  // A directory that is not there, and a file that is not a directory.
  say(fs.listDir(dir + "/missing"))
  say(fs.listDir(dir + "/notes"))
  // Many entries come back whole.
  _ = fs.createDir(dir + "/many")
  for i in 0 ..< 300 do _ = fs.writeText(s"$dir/many/f$i", "")
  val many = fs.listDir(dir + "/many").getOrElse([])
  say(s"${many.length} ${many.contains("f0")} ${many.contains("f299")}")
  say(many.slice(0, 5))
  say(many.last)
  say(many == many.sorted)
  // Two listings of an unchanged directory agree.
  say(fs.listDir(dir + "/many") == fs.listDir(dir + "/many"))
  say(fs.removeDirAll(dir))
