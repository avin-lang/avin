// A directory listed through `avin.fs`: the names of its entries, files and directories alike,
// without the directory before them and without `.` and `..`, in no promised order.
import avin.fs

main()
    val dir = fs.createTempDir("avin-listing") match
        Ok(d) -> d
        Err(e) ->
            print(s"no directory: $e")
            return
    print(fs.listDir(dir))
    for name in ["b.txt", "a.txt", "notes", "ünïcode"] do fs.writeText(dir + "/" + name, name)
    fs.createDir(dir + "/sub")
    fs.writeText(dir + "/sub/inner", "")
    val names = fs.listDir(dir).getOrElse([])
    print(names.length())
    for name in ["a.txt", "b.txt", "notes", "sub", "ünïcode"] do print(s"$name ${names.contains(name)}")
    print(names.contains("inner") || names.contains(".") || names.contains(".."))
    print(fs.listDir(dir + "/sub"))
    // A directory that is not there, and a file that is not a directory.
    print(fs.listDir(dir + "/missing"))
    print(fs.listDir(dir + "/notes"))
    // Many entries come back whole.
    fs.createDir(dir + "/many")
    for i in 0 ..< 300 do fs.writeText(s"$dir/many/f$i", "")
    val many = fs.listDir(dir + "/many").getOrElse([])
    print(s"${many.length()} ${many.contains("f0")} ${many.contains("f299")}")
    print(fs.removeDirAll(dir))
