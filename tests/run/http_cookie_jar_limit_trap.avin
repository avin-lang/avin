// expect: trap
// A cookie jar's limits of one are its least; a limit of none traps as the jar is made.
import avin.net.http.CookieJar

main()
  val least = CookieJar(maxCookieBytes = 1, maxPerDomain = 1, maxCookies = 1)
  println(s"${least.maxCookieBytes} ${least.maxPerDomain} ${least.maxCookies}")
  _ = CookieJar(maxPerDomain = 0)
