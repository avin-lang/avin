// A program that keeps a growing share of what it makes and throws the rest away, as a client reading
// rows does: everything kept is still whole after every collection. Its twins run the same shape with
// the collector paced by `AVIN_GC_PERCENT` instead of collecting at every allocation.

data Item(a: int, b: string, c: Vector[int])

main()
  val keep = Buffer[Item]()
  var spent = 0
  for i in 0 ..< 3000
    keep.addOne(Item(i, s"row $i", [i, i + 1]))
    val junk = Array.fill(256, byte(1))
    spent += junk.length
  var sum = long(0)
  var text = 0
  for item in keep
    sum += long(item.a) + long(item.c(0)) + long(item.c(1))
    text += item.b.byteLength
  println(s"kept=${keep.length} sum=$sum text=$text spent=$spent")
  println(keep(0))
  println(keep(2999))
