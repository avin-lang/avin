// expect: exit 0
// A vector is immutable: every operation that changes one makes a new vector and leaves the old as
// it was. It is covariant, compares and hashes by its elements, and is traversed by `for`.

open class Animal(val name: string)
class Dog(n: string): Animal(n)
class Cat(n: string): Animal(n)

names(xs: Vector[Animal]) -> string = xs.foldLeft("", (acc, a) -> acc + a.name)

main()
    val v = Vector.empty[int]()
    print(s"${v.length()} ${v.isEmpty()}")
    val w = v.appended(2).appended(3).prepended(1)
    print(s"${w.length()} ${w(0)} ${w(1)} ${w(2)} ${v.length()} ${w.nonEmpty()}")
    val u = w.updated(1, 20)
    print(s"${u(1)} ${w(1)}")
    val c = w.concat(u)
    print(s"${c.length()} ${c(3)} ${c(4)}")
    val s = c.slice(2, 5)
    print(s"${s.length()} ${s(0)} ${s(2)} ${c.slice(3, 3).isEmpty()}")
    print(s"${w.map(x -> x * 10)(2)} ${c.filter(x -> x > 2).length()} ${w.foldLeft(0, (a, x) -> a + x)}")
    print(s"${w.contains(3)} ${w.contains(4)} ${c.indexOf(20).getOrElse(-1)} ${w.exists(x -> x > 2)} ${w.get(3).isNone()}")
    var total = 0
    for x in c do total += x
    w.foreach(x -> total += x)
    print(s"$total")

    val b = Vector.builder[string]()
    b.add("x")
    b.addAll(["y", "z"])
    val built = b.result()
    print(s"${built.length()} ${built(2)}")
    val more = built.toBuffer()
    more.add("w")
    print(s"${more.length()} ${built.length()} ${built.toArray()(1)} ${built.toVector() === built}")

    val dogs: Vector[Dog] = [Dog("rex"), Dog("fido")]
    val animals: Vector[Animal] = dogs
    print(names(animals.appended(Cat("tom"))))

    print(s"${w == [1, 2, 3]} ${w == u} ${w != u} ${w.hash() == [1, 2, 3].hash()} ${[[1], [2]] == [[1], [2]]}")
    print(s"${["a", "b"] == ["a", "b"]} ${Vector.empty[string]() == []}")
