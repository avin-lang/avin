// expect: trap
// A reference to the array held in an object's field is the same array: once the array is moved,
// a use through the field traps as a use through the local does.
import avin.actors.Isolated

class Holder(val data: Array[int])

main()
  val a = Array.fill[int](3, 7)
  val h = Holder(a)
  val moved = Isolated.move(a)
  println("moved")
  println(h.data(0))
  println(moved.take().length)
