// expect: exit 55
// Functions defined by clauses: a signature, then one clause per line, with inline guards, guard
// blocks, data patterns, several parameters, and local functions written the same way.

classify(n: int) -> string
classify(0) = "zero"
classify(n)
  | n < 0 = "negative"
  | n < 10 = "small"
  | _ = "large"

fib(n: int) -> int
fib(n < 2) = n
fib(n) = fib(n - 1) + fib(n - 2)

data Shape
  Circle(radius: int)
  Rect(width: int, height: int)

area(s: Shape) -> int
area(Circle(r)) = 3 * r * r
area(Rect(w, h)) = w * h

// A generic function may have clauses, and its patterns reach into heap values.
data Option[+T]
  Some(value: T)
  None

getOrElse[T](o: Option[T], fallback: T) -> T
getOrElse(Some(v), _) = v
getOrElse(None, fallback) = fallback

data List
  Cons(head: int, tail: List)
  Nil

total(xs: List) -> int
total(Nil) = 0
total(Cons(x, rest)) = x + total(rest)

// When every guard of a clause fails, the next clause is tried.
sign(n: int) -> int
sign(n) | n > 0 = 1
sign(n) | n < 0 = -1
sign(_) = 0

// The same after a guard block, and after a clause whose body is an indented block.
clamp(n: int) -> int
clamp(n)
  | n > 100 = 100
  | n < 0 = 0
clamp(0) =
  val zero = 0
  zero
clamp(n) = n

// Clauses over two parameters are tried in order, column by column.
both(a: bool, b: bool) -> string
both(true, true) = "both"
both(false, false) = "neither"
both(_, _) = "one"

// The result type may be left to inference when no clause calls the function.
label(flag: bool)
label(true) = "on"
label(false) = "off"

// A clause's body may be an indented block.
steps(n: int) -> int
steps(0) = 0
steps(n) =
  val half = n / 2
  1 + steps(half)

main() -> int
  println(classify(0))
  println(classify(-5))
  println(classify(7))
  println(classify(12))
  println(both(true, true))
  println(both(false, true))
  println(both(false, false))
  println(label(true))
  println(label(false))
  // A local function may be defined by clauses as well, with or without a result type.
  twice(n: int) -> int
  twice(0) = 0
  twice(n) = 2 + twice(n - 1)
  pick(b: bool)
  pick(true) = 1
  pick(false) = 2
  if area(Circle(2)) != 12 || area(Rect(2, 3)) != 6 then return 1
  if sign(5) != 1 || sign(-5) != -1 || sign(0) != 0 then return 2
  if steps(8) != 4 then return 3
  if clamp(150) != 100 || clamp(-4) != 0 || clamp(0) != 0 || clamp(42) != 42 then return 5
  if twice(3) != 6 || pick(false) != 2 then return 4
  if getOrElse(Some(7), 0) != 7 || getOrElse(None, 9) != 9 || !getOrElse(None, true) then return 6
  if total(Cons(1, Cons(2, Cons(3, Nil)))) != 6 then return 7
  // A local function's clauses see the locals before it.
  var calls = 0
  offset(n: int) -> int
  offset(0) = calls
  offset(n) =
    calls += 1
    offset(n - 1)
  if offset(3) != 3 || calls != 3 then return 8
  fib(10)
