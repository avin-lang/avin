// expect: trap
// A required positional argument after an optional one could never be told from it, so it traps;
// one taking the rest is required only where it says so, and that traps too.
import avin.cli

main()
  val p = cli.Parser("tool").positional("a", required = false)
  p.positional("b", required = false)
  p.positionals("rest")
  println("optional after optional is fine")
  p.positionals("rest", required = true)
  println("not reached")
