// expect: exit 0
// `avin.regex` end to end: compiling patterns, searching, every match in turn, groups by number and
// by name, the anchoring of `matches`, lookarounds, flags, and a pattern that is not valid reported
// as a value.
import avin.regex
import avin.regex.{Regex, Match}

shown(m: Option[Match]) -> string = m match
    Some(found) -> s"${found.start()}-${found.end()} ${found.matched()} ${found.subgroups()}"
    None -> "no match"

main()
    val date = Regex("(?<year>\\d{4})-(?<month>\\d\\d)-(?<day>\\d\\d)")
    val m = date.findFirstMatchIn("due 2024-06-30, paid 2024-07-02").get()
    println(m.matched())
    println(m.group("month"))
    println(m.before())
    println(date.findAllIn("due 2024-06-30, paid 2024-07-02").toList())
    for d in date.findAllMatchIn("2024-06-30 2025-01-15")
        println(s"${d.group(1)} ${d.start(3)}")
    println("[a-z]+".r().findAllIn("one, two; three").toVector())
    println(Regex("a+b").matches("aab"))
    println(Regex("a+b").matches("aabx"))
    println(Regex("a+b").unanchored().matches("xaabx"))
    println(Regex("(?i)hello").findFirstIn("Say HELLO"))
    println(shown(Regex("(a|ab)(c|bcd)(d*)").findFirstMatchIn("abcd")))
    println(shown(Regex("(a|(b))+").findFirstMatchIn("ba")))
    println(shown(Regex("(?<=\\$)\\d+(?!\\d|%)").findFirstMatchIn("50% of $120")))
    println(shown(Regex("(?m)^\\w+$").findFirstMatchIn("first line\nword\nlast")))
    println(shown(Regex("\\bcat\\b").findFirstMatchIn("concat cat")))
    println(shown(Regex("(?>a+)b|a+").findFirstMatchIn("aaa")))
    println(shown(Regex("é+(.)").findFirstMatchIn("aééx")))
    println(Regex("a*").findAllIn("baac").toList())
    println(Regex.compile("a(b").map(r -> r.regex()))
    Regex.compile("[z-a]") match
        Err(e) -> println(e.message())
        Ok(_) -> println("compiled")
