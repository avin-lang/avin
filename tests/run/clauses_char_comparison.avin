// expect: exit 0
// A function's clauses take comparison patterns between two char bounds, tried in order, with both
// bounds inclusive under `<=` and the upper exclusive under `<`, beside a catch-all clause.

hexValue(c: char) -> int
hexValue('0' <= c <= '9') = int(c) - 48
hexValue('a' <= c <= 'f') = int(c) - 87
hexValue('A' <= c <= 'F') = int(c) - 55
hexValue(_) = -1

// The upper bound under `<` leaves 'z' out, and a one-bound pattern takes the rest above it.
letterClass(c: char) -> string
letterClass('a' <= c < 'z') = "below z"
letterClass(c >= 'z') = "z or above"
letterClass(_) = "below a"

// Clauses are tried in order: an earlier, wider clause wins over a later, narrower one.
firstWins(c: char) -> string
firstWins('a' <= c <= 'z') = "wide"
firstWins('m' <= c <= 'n') = "narrow"
firstWins(_) = "other"

// A comparison pattern nested in a constructor in a clause.
digitOf(o: Option[char]) -> int
digitOf(Some('0' <= c <= '9')) = int(c) - 48
digitOf(_) = -1

main() =
    for c in "09afAFgG/:`@".chars()
        println(s"$c ${hexValue(c)}")
    println(letterClass('a'))
    println(letterClass('y'))
    println(letterClass('z'))
    println(letterClass('~'))
    println(letterClass('A'))
    println(firstWins('m'))
    println(firstWins('é'))
    println(digitOf(Some('5')))
    println(digitOf(Some('x')))
    println(digitOf(None))
