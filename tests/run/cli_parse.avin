// expect: exit 0
// `Parser.parse` over every form an argument takes: long options with `=` and with the next
// argument, one-letter options alone, bundled and with their value attached, `--` and `-`, values
// that start with `-`, empty and non-ASCII arguments, flags counted, repeated options kept and
// single ones replaced, defaults, `given`, choices, and positional arguments required, optional and
// taking the rest.
import avin.cli

val p = cli.Parser("tool", "Do a thing.")
    .flag("verbose", short = 'v', help = "say more")
    .flag("quiet", short = 'q')
    .string("out", short = 'o', help = "where to write", value = "file")
    .int("count", short = 'n', default = 3)
    .real("scale", short = 's')
    .choice("format", ["text", "json"], short = 'f', default = "text")
    .string("tag", short = 't', repeated = true)
    .int("level", repeated = true)
    .real("weight", repeated = true, default = 0.5)
    .positional("input")
    .positional("output", required = false)
    .positionals("rest")

show(args: Vector[string])
    p.parse(args) match
        Ok(a) ->
            val parts = [
                s"v=${a.count("verbose")}",
                s"q=${a.flag("quiet")}",
                s"out=[${a.string("out")}]${a.given("out")}",
                s"n=${a.int("count")}${a.given("count")}",
                s"s=${a.real("scale")}",
                s"f=${a.string("format")}",
                s"tags=${a.strings("tag")}",
                s"levels=${a.ints("level")}",
                s"weights=${a.reals("weight")}",
                s"in=[${a.string("input")}]",
                s"outp=[${a.string("output")}]${a.given("output")}",
                s"rest=${a.strings("rest")}"
            ]
            println(parts.mkString(" "))
        Err(e) -> println(s"error: $e")

main()
    println("-- positionals only")
    show(["a"])
    show(["a", "b"])
    show(["a", "b", "c", "d"])
    println("-- long options")
    show(["--verbose", "--out", "x.txt", "a"])
    show(["--out=x.txt", "a"])
    show(["--out=", "a"])
    show(["--out=a=b", "a"])
    show(["--count", "-5", "a"])
    show(["--count=-2147483648", "a"])
    show(["--count", "2147483647", "a"])
    show(["--scale", "1.5", "--scale=-2e3", "a"])
    show(["--out", "--verbose", "a"])
    println("-- one-letter options")
    show(["-v", "-q", "a"])
    show(["-vvv", "a"])
    show(["-vqv", "a"])
    show(["-o", "x", "a"])
    show(["-ox", "a"])
    show(["-vox", "a"])
    show(["-vo", "x", "a"])
    show(["-n-7", "a"])
    show(["-n", "-7", "a"])
    show(["-fjson", "a"])
    println("-- repeated and replaced")
    show(["-t", "x", "--tag", "y", "-tz", "a"])
    show(["--level", "1", "--level=2", "a"])
    show(["--weight", "2", "a"])
    show(["--out", "first", "--out", "second", "a"])
    show(["-n", "1", "--count", "2", "a"])
    println("-- `--`, `-` and odd arguments")
    show(["--", "--verbose", "-x"])
    show(["a", "--", "-", "--"])
    show(["-", "-v"])
    show(["", ""])
    show(["a", "--verbose", "b", "-q", "c"])
    show(["ünï", "--out", "文件.txt", "-t", "é"])
    println("-- errors")
    show([])
    show(["--bogus", "a"])
    show(["--bogus=1", "a"])
    show(["-x", "a"])
    show(["-vx", "a"])
    show(["--=1", "a"])
    show(["--verbose=yes", "a"])
    show(["a", "--out"])
    show(["a", "-o"])
    show(["--count", "abc", "a"])
    show(["--count", "2147483648", "a"])
    show(["--count", "", "a"])
    show(["-nx", "a"])
    show(["--scale", "fast", "a"])
    show(["--scale", "1e999", "a"])
    show(["--format", "xml", "a"])
    show(["-f", "JSON", "a"])
    show(["-é", "a"])
    show(["--level", "1", "--level", "x", "a"])
    show(["--bogus", "--count", "x"])
