// expect: trap
// A connection keeps the bytes a line read beyond its line, and a later `readLine` is served from
// them without reaching the socket. Handed to a thread, the connection is the thread's all the same:
// the code that handed it over traps at that read, as it does at one that reaches the socket.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.threads.{Channel, spawn}

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message())

main()
    val l = ok(TcpListener.bind("127.0.0.1", 0))
    val c = ok(TcpStream.connect("127.0.0.1", l.port()))
    val s = ok(l.accept())
    ok(c.writeText("first\nsecond\nthird\n"))
    println(ok(s.readLine()))
    val go = Channel[int]()
    val t = spawn(() ->
        go.receive()
        ok(s.readLine()))
    println("handed over")
    println(s.readLine())
    go.send(1)
    println(t.join())
