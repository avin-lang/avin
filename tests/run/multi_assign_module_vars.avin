// expect: exit 0
// A module-level `var` is a place of a multiple assignment like a local or a field: the whole right
// side is made before any place changes, and the compound forms read every place first.
var a = 1
var b = 2
var word = "héllo"
var other = "日本語 🎉"
var lo: long = 9223372036854775807
var hi: long = -9223372036854775808
var trace = ""
var items = Vector[string]()
var count = 0

object Tally
    var hits = 0
    var name = "tally"

class Cell(var n: int)

val cell = Cell(7)

note(s: string, v: int) -> int
    trace = trace + s
    v

// The right side reads the module's values through a function, so storing early would show.
readA() -> int = a

swapIn[T](x: T, y: T) -> (T, T) = (y, x)

// A generic function storing its own instance's values into module state.
store2[T](x: T, y: T, show: (T) -> string)
    word, other = show(x), show(y)

main()
    a, b = b, a
    println(s"$a $b")
    // mixed with a local, in either order, and parenthesized
    var n = 10
    n, a = a, n
    println(s"$n $a $b")
    (b, n) = (n, b)
    println(s"$n $a $b")
    // the right side sees the values from before the statement, even through a call
    a, b = b, readA()
    println(s"$a $b")
    // Unicode strings swap whole
    word, other = other, word
    println(s"$word|$other|")
    // long extremes
    lo, hi = hi, lo
    println(s"$lo $hi")
    // a computed tuple, and `_`
    a, _ = swapIn(b, 99)
    println(s"$a")
    // compound form reads every place first
    a, b += b, a
    println(s"$a $b")
    // evaluation order: every right-hand part is made, left to right, before any store
    trace = ""
    a = 50
    a, b = note("x", 1), note("y", readA())
    println(s"$a $b $trace")
    // an object's field and a class instance's field among the places
    Tally.hits, a, cell.n = a, cell.n, Tally.hits
    println(s"${Tally.hits} $a ${cell.n}")
    Tally.name, word = word, Tally.name
    println(s"${Tally.name} $word")
    // a local of the same name hides the module's value
    var count = 5
    count, a = a, count
    println(s"$count $a ${readCount()}")
    // inside a closure
    val swap = () ->
        a, b = b, a
    swap()
    swap()
    swap()
    println(s"$a $b")
    // in a generic function
    store2(3, 4, (x) -> s"<$x>")
    println(s"$word $other")
    store2("ü", "ß", (x) -> x + x)
    println(s"$word $other")
    // many allocations stored through the places, for the collector
    for i in 0..<2000
        items, word = items :+ s"$i", s"w$i"
        if items.length > 50
            items, other = Vector[string](), word
    println(s"${items.length} $word $other")

readCount() -> int = count
