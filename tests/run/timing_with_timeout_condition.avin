// expect: trap
// The body of a `withTimeout` runs on a thread of its own, so a mutex its caller holds is not the
// body's: waiting on a condition of it from the body traps, as a wait by any thread that does not hold
// the mutex does.
import avin.threads.{Mutex, withTimeout}
import avin.time.seconds

val m = Mutex(0)
val ready = m.condition()

main()
  println("before")
  m.with(_ -> withTimeout(seconds(30), s -> ready.wait()).isDefined)
  println("after")
