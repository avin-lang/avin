// expect: exit 0
// A list's and an `ArraySeq`'s methods that take an element take it as a type parameter bounded
// below by the element type, so a collection seen at a wider type, or given an element of a wider
// type, answers a collection of the wider type; with the element type itself the result is unchanged.

open class Animal(val name: string)
class Dog(name: string) : Animal(name)
class Cat(name: string) : Animal(name)

kindL(a: Any) -> string = a match
    _: List[Dog] -> "List[Dog]"
    _: List[Animal] -> "List[Animal]"
    _: List[int] -> "List[int]"
    _: List[real] -> "List[real]"
    _ -> "other"

kindA(a: Any) -> string = a match
    _: ArraySeq[Dog] -> "ArraySeq[Dog]"
    _: ArraySeq[Animal] -> "ArraySeq[Animal]"
    _: ArraySeq[int] -> "ArraySeq[int]"
    _: ArraySeq[real] -> "ArraySeq[real]"
    _ -> "other"

namesL(xs: List[Animal]) -> string = xs.map(a -> a.name).mkString(" ")
namesA(xs: ArraySeq[Animal]) -> string = xs.map(a -> a.name).mkString(" ")
namesS(xs: Seq[Animal]) -> string = xs.map(a -> a.name).mkString(" ")

main()
    // List.
    val dogs: List[Dog] = [Dog("rex"), Dog("fido")]
    val cat = Cat("tom")
    val a1 = dogs :+ cat
    println(s"${kindL(a1)} ${namesL(a1)}")
    val a2 = cat +: dogs
    println(s"${kindL(a2)} ${namesL(a2)}")
    val cats: List[Cat] = [Cat("a"), Cat("b")]
    val a3 = dogs ++ cats
    println(s"${kindL(a3)} ${namesL(a3)}")
    val animals: List[Animal] = [Cat("c")]
    val a3b = dogs ++ animals
    println(s"${kindL(a3b)} ${namesL(a3b)}")
    val a3c = dogs ++ cats.toVector
    println(s"${kindL(a3c)} ${namesL(a3c)}")
    val a4 = dogs.updated(1, cat)
    println(s"${kindL(a4)} ${namesL(a4)} ${dogs.length}")
    // The original is unchanged.
    println(dogs.map(d -> d.name).mkString(" "))
    // Chains widen once and stay widened.
    val chain = dogs :+ cat :+ Dog("spot") :+ cat
    println(s"${kindL(chain)} ${namesL(chain)}")
    val chain2 = Dog("z") +: cat +: dogs
    println(s"${kindL(chain2)} ${namesL(chain2)}")
    // Element type unchanged when W = T.
    val same = dogs :+ Dog("spot")
    println(s"${kindL(same)} ${same.length}")
    val sameFront = Dog("first") +: dogs
    println(s"${kindL(sameFront)} ${sameFront.length}")
    val sameJoin = dogs ++ dogs
    println(s"${kindL(sameJoin)} ${sameJoin.length}")
    val sameUpd = dogs.updated(0, Dog("new"))
    println(s"${kindL(sameUpd)} ${sameUpd(0).name}")
    // Empty and single.
    val none: List[Dog] = []
    val oneAnimal = none :+ cat
    println(s"${kindL(oneAnimal)} ${oneAnimal.length}")
    println((none ++ cats).length)
    println((cats ++ none).length)
    // Nothing used as numbers.
    val reals: List[real] = List.empty[Nothing]()
    val r = reals :+ 1.5 :+ 2.5
    println(s"${kindL(r)} $r")
    val ints: List[int] = List.empty[Nothing]()
    println(s"${3 +: ints} ${ints ++ [4, 5]} ${(ints :+ 1).updated(0, 9)}")
    val nums: List[real] = [1.5]
    println(nums :+ 2.0)
    // Through a view as Seq.
    val seq: Seq[Animal] = dogs
    println(namesS(seq :+ cat))
    println(namesS(cat +: seq))
    println(namesS(seq.updated(0, cat)))
    println(namesS(seq ++ cats))
    // Through a covariant view as a list.
    val view: List[Animal] = dogs
    println(namesL(view :+ cat))
    println(namesL(view ++ cats))
    println(namesL(view.updated(0, cat)))
    println(kindL(view :+ Dog("q")))

    // ArraySeq.
    val ds: ArraySeq[Dog] = [Dog("rex"), Dog("fido")]
    val b1 = ds :+ cat
    println(s"${kindA(b1)} ${namesA(b1)}")
    val b2 = cat +: ds
    println(s"${kindA(b2)} ${namesA(b2)}")
    val cs: ArraySeq[Cat] = [Cat("a"), Cat("b")]
    val b3 = ds ++ cs
    println(s"${kindA(b3)} ${namesA(b3)}")
    val b3b = ds ++ cats
    println(s"${kindA(b3b)} ${namesA(b3b)}")
    val b4 = ds.updated(1, cat)
    println(s"${kindA(b4)} ${namesA(b4)} ${ds.length}")
    println(ds.map(d -> d.name).mkString(" "))
    val bchain = ds :+ cat :+ Dog("spot") :+ cat
    println(s"${kindA(bchain)} ${namesA(bchain)}")
    val sameA = ds :+ Dog("spot")
    println(s"${kindA(sameA)} ${sameA.length}")
    val sameAF = Dog("first") +: ds
    println(s"${kindA(sameAF)} ${sameAF.length}")
    val sameAJ = ds ++ ds
    println(s"${kindA(sameAJ)} ${sameAJ.length}")
    val sameAU = ds.updated(0, Dog("new"))
    println(s"${kindA(sameAU)} ${sameAU(0).name}")
    val noneA: ArraySeq[Dog] = []
    val oneA = noneA :+ cat
    println(s"${kindA(oneA)} ${oneA.length}")
    println((noneA ++ cs).length)
    val realsA: ArraySeq[real] = ArraySeq.empty[Nothing]()
    val ra = realsA :+ 1.5 :+ 2.5
    println(s"${kindA(ra)} $ra")
    val intsA: ArraySeq[int] = ArraySeq.empty[Nothing]()
    println(s"${3 +: intsA} ${intsA ++ [4, 5]}")
    val seqA: Seq[Animal] = ds
    println(namesS(seqA :+ cat))
    println(namesS(cat +: seqA))
    println(namesS(seqA.updated(0, cat)))
    val viewA: ArraySeq[Animal] = ds
    println(namesA(viewA :+ cat))
    println(namesA(viewA ++ cs))
    println(namesA(viewA.updated(0, cat)))
    println(kindA(viewA :+ Dog("q")))
