// expect: exit 0
// A lambda that uses `?` where the function expected yields a `Result` or an `Option` known only in
// shape: the error type is known and the value's type is the call's to infer. `?` checks against
// that shape, and the body decides the value's type: an `int`, a class, a tuple, unit, a `Vector`,
// through nested generic calls, a method generic over the lambda's result, `?` converting its error
// through `From`, `return` beside `?` and alone, an error type
// another argument decides, and a lambda that captures.

inside[T](f: (int) -> Result[T, string]) -> Result[T, string] = f(1)

half(n: int) -> Result[int, string] = if n % 2 == 0 then Ok(n / 2) else Err("odd")

maybe[T](f: (int) -> Option[T]) -> Option[T] = f(4)

positive(n: int) -> Option[int] = if n > 0 then Some(n) else None

class Point(val x: int, val y: int)

class Connection(name: string)
  transaction[T](f: (Connection) -> Result[T, string]) -> Result[T, string] = f(self)
  execute(sql: string) -> Result[int, string] = if sql.isEmpty then Err(s"$name: empty") else Ok(sql.charCount)

twice[T](f: (int) -> Result[T, string]) -> Result[(T, T), string] = f(2) match
  Ok(a) -> f(4) match
    Ok(b) -> Ok((a, b))
    Err(e) -> Err(e)
  Err(e) -> Err(e)

outer[T](g: (int) -> Result[T, string]) -> Result[T, string] = inside(n -> Ok(g(n)?))

data CodeError
  Code(code: int)

impl From[string] for CodeError
  static from(value: string) -> CodeError = Code(value.charCount)

coded[T](f: (int) -> Result[T, CodeError]) -> Result[T, CodeError] = f(3)

withError[T, E](fallback: E, f: (int) -> Result[T, E]) -> Result[T, E] = f(1)

show(r: Result[int, string]) -> string = r match
  Ok(n) -> s"Ok($n)"
  Err(e) -> s"Err($e)"

main()
  // The reproducer: `?` in an expression lambda.
  println(show(inside(n -> Ok(half(n + 1)? + 1))))
  println(show(inside(n -> Ok(half(n)? + 1))))
  // A block body with several `?` and then `Ok(x)`.
  val sum = inside(n ->
    val a = half(n + 1)?
    val b = half(a * 4)?
    Ok(a + b))
  println(show(sum))
  // The value's type is a class.
  inside(n -> Ok(Point(half(n + 3)?, n))) match
    Ok(p) -> println(s"Point(${p.x}, ${p.y})")
    Err(e) -> println(s"Err($e)")
  // A tuple.
  inside(n -> Ok((half(n + 1)?, "one"))) match
    Ok((a, b)) -> println(s"($a, $b)")
    Err(e) -> println(s"Err($e)")
  // Unit.
  inside(n ->
    half(n + 1)?
    Ok(())) match
    Ok(_) -> println("Ok(())")
    Err(e) -> println(s"Err($e)")
  // A Vector, and a failure on the second `?`.
  inside(n ->
    val a = half(n + 1)?
    val b = half(a + 2)?
    Ok([a, b])) match
    Ok(v) -> println(s"Ok($v)")
    Err(e) -> println(s"Err($e)")
  // `Option`'s shape.
  println(maybe(n -> Some(positive(n)? * 10)))
  println(maybe(n -> Some(positive(n - 9)? * 10)))
  println(maybe(n -> Some("x".repeat(positive(n)?))))
  // `return` beside `?`.
  println(show(inside(n ->
    if n > 0 then return Ok(100)
    Ok(half(n)?))))
  // A method generic over the lambda's result, on a class.
  val db = Connection("db")
  val done = db.transaction(tx ->
    val a = tx.execute("insert")?
    val b = tx.execute("update")?
    Ok(a + b))
  println(show(done))
  val failed = db.transaction(tx ->
    tx.execute("insert")?
    tx.execute("")?
    Ok("committed"))
  failed match
    Ok(s) -> println(s"Ok($s)")
    Err(e) -> println(s"Err($e)")
  // Nested generic calls: the inner lambda's result is the outer's to infer.
  twice(n -> Ok(half(n)? * 3)) match
    Ok((a, b)) -> println(s"($a, $b)")
    Err(e) -> println(s"Err($e)")
  println(show(outer(n -> Ok(half(n + 1)? - 1))))
  println(show(inside(n -> inside(m -> Ok(half(n + m)? + half(4)?)))))
  // `?` converts the error through `From` to the known error type.
  coded(n -> Ok(half(n)? + 1)) match
    Ok(v) -> println(s"Ok($v)")
    Err(Code(k)) -> println(s"Code($k)")
  // `return` alone, with no `?`.
  println(show(inside(n ->
    if n > 0 then return Ok(n + 40)
    Ok(0))))
  // The error type known from another argument, checked before the lambda.
  println(show(withError("unused", n -> Ok(half(n + 5)? * 2))))
  // A lambda that captures.
  val offset = 7
  println(show(inside(n -> Ok(half(n + 1)? + offset))))
