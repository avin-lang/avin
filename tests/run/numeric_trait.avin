// expect: exit 0
// `Numeric` is every integer width and `real`: a type parameter bounded by it has the five arithmetic
// operators, negation, the ordering, both text forms, `T.zero()`, `T.one()` and `toReal`. Every
// integer meets it through `Integer`, a parameter bounded by `Integer` reaches a `Numeric` function,
// and a type of a program's own joins by implementing it with the traits it extends.

mean[T: Numeric](xs: Vector[T]) -> real = xs.sum.toReal / real(xs.length)

describe[T: Numeric](a: T, b: T) -> string =
    s"$a $b sum ${a + b} difference ${a - b} product ${a * b} quotient ${a / b} remainder ${a % b} negated ${-a} less ${a < b} compare ${a.compare(b)}"

identities[T: Numeric](sample: T) -> string = s"zero ${T.zero()} one ${T.one()} sample ${sample.toReal}"

clamp[T: Numeric](x: T, lo: T, hi: T) -> T = if x < lo then lo elif x > hi then hi else x

// A `Numeric` function called from a parameter bounded only by `Integer`.
throughInteger[T: Integer](x: T) -> real = x.toReal + mean([x, x, x])

// A `Numeric` function calling another, and a closure capturing a `T`.
scaled[T: Numeric](xs: Vector[T], by: T) -> Vector[T] = xs.map(x -> x * by)
spread[T: Numeric](xs: Vector[T]) -> real = xs.max.toReal - xs.min.toReal + mean(scaled(xs, T.one()))

// A number of the program's own: a rational with a positive denominator, kept in lowest terms.
data Ratio(num: long, den: long)

gcd(a: long, b: long) -> long = if b == 0 then a.abs else gcd(b, a % b)

ratio(n: long, d: long) -> Ratio
    val g = gcd(n, d)
    val s: long = if d < 0 then -1 else 1
    Ratio(s * n / g, s * d / g)

impl Add for Ratio
    add(o: Ratio) -> Ratio = ratio(num * o.den + o.num * den, den * o.den)
    static zero() -> Ratio = Ratio(0, 1)
impl Sub for Ratio
    subtract(o: Ratio) -> Ratio = ratio(num * o.den - o.num * den, den * o.den)
impl Mul for Ratio
    multiply(o: Ratio) -> Ratio = ratio(num * o.num, den * o.den)
    static one() -> Ratio = Ratio(1, 1)
impl Div for Ratio
    divide(o: Ratio) -> Ratio = ratio(num * o.den, den * o.num)
impl Rem for Ratio
    remainder(o: Ratio) -> Ratio = self - o * ratio((num * o.den) / (den * o.num), 1)
impl Neg for Ratio
    negate() -> Ratio = Ratio(-num, den)
impl Ord for Ratio
    compare(o: Ratio) -> int = (num * o.den).compare(o.num * den)
impl Display for Ratio
    display(out: Writer, spec: FormatSpec) = out.writeField(s"$num/$den", spec)
impl Debug for Ratio
    debug(out: Writer, spec: FormatSpec) = out.writeField(s"Ratio($num/$den)", spec)
impl Numeric for Ratio
    toReal -> real = real(num) / real(den)

// A generic class over a number, holding a running total and the extremes it has seen.
class Running[T: Numeric]
    var total: T = T.zero()
    var count = 0
    var highest: Option[T] = None

    add(x: T)
        total = total + x
        count = count + 1
        highest = highest match
            Some(h) if h >= x -> Some(h)
            _ -> Some(x)

    mean -> real = total.toReal / real(count)

main()
    val running = Running[i16]()
    for x in [i16(4), i16(-2), i16(7)] do running.add(x)
    println(s"${running.total} ${running.highest} ${running.mean}")
    val reals = Running[real]()
    reals.add(0.5)
    reals.add(-1.5)
    println(s"${reals.total} ${reals.highest} ${reals.mean}")
    println(describe(i2(-1), i2(1)))
    println(describe(i8(10), i8(7)))
    println(describe(i16(-300), i16(7)))
    println(describe(7, -2))
    println(describe(long(-9000000000), long(4)))
    println(describe(i64(5), i64(3)))
    println(describe(i128(85070591730234615865843651857942052863), i128(-2)))
    println(describe(i33(-1000000000), i33(3)))
    println(describe(7.5, 2.0))
    println(describe(ratio(1, 2), ratio(1, 3)))
    println(identities(i8(0)))
    println(identities(i16(0)))
    println(identities(0))
    println(identities(long(0)))
    println(identities(i128(0)))
    println(identities(0.0))
    println(identities(ratio(3, 4)))
    // `toReal` at the boundaries: exact through 2^53, the nearest `real` beyond.
    println(i1(-1).toReal)
    println(i8(-128).toReal)
    println(i8(127).toReal)
    println(int.MinValue.toReal)
    println(int.MaxValue.toReal)
    println(long(9007199254740992).toReal == 9007199254740992.0)
    println(long(9007199254740993).toReal == 9007199254740992.0)
    println(long.MinValue.toReal == -9223372036854775808.0)
    println(long.MaxValue.toReal == 9223372036854775808.0)
    println((-0.0).toReal)
    println(mean([1, 2, 3, 4]))
    println(mean([1.5, 2.5]))
    println(mean([i8(-128), i8(127)]))
    println(mean([ratio(1, 2), ratio(1, 4)]))
    println(clamp(5, 0, 3))
    println(clamp(-1.5, 0.0, 1.0))
    println(clamp(i16(2), i16(0), i16(3)))
    println(clamp(ratio(5, 4), ratio(0, 1), Ratio.one()))
    println(throughInteger(i8(3)))
    println(throughInteger(long(-7)))
    println(spread([3, 1, 2]))
    println(spread([0.5, -0.5]))
    println(scaled([ratio(1, 2), ratio(2, 3)], ratio(3, 1)))
