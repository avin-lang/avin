// expect: exit 0
// `do … while` runs its body before the first test; `continue` reaches the test.
digits(n: int) -> string
  var rest = n
  var s = ""

  do
    s = s"${rest % 10}" + s
    rest /= 10
  while rest > 0

  s

// A `continue` reaches the test: were it to skip the test, this loop would never end.
skipping() -> int
  var i = 0
  var odd = 0
  do
    i += 1
    if i % 2 == 0 then continue
    odd += 1
  while i < 10
  odd

firstOver(limit: int) -> int
  var n = 1
  val found = do
    n *= 2
    if n > 1000 then break n
  while n < limit
  else -1
  found

nested() -> int
  var total = 0
  var i = 0
  do
    var j = 0
    do
      total += 1
      j += 1
    while j < 3
    i += 1
  while i < 2
  total

main() -> int
  var i = 0
  do i += 1 while i < 4
  println(digits(0))
  println(digits(4071))
  println(s"$i")
  println(s"${skipping()}")
  println(s"${firstOver(10)}")
  println(s"${firstOver(100000)}")
  println(s"${nested()}")
  var ran = 0
  do ran += 1 while false
  println(s"$ran")
  0
