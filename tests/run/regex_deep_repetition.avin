// expect: exit 0
// A repeated group over a long input takes no deeper a call stack however many repetitions it
// makes: each shape of group repetition, greedy, reluctant and possessive, over about a million
// characters, with the groups' spans checked at the end. The inputs are built by doubling, so they
// take a handful of allocations and the program runs under the collector's stress.
import avin.regex.{Regex, Match}

// `s` written `2^k` times.
doubled(s: string, k: int) -> string
    var out = s
    for _ in 0..<k do out = out + out
    out

spans(m: Match) -> string
    val out = StringWriter()
    out.write(s"${m.start()}-${m.end()}")
    for g in 1..m.groupCount do out.write(s" ${m.start(g)}-${m.end(g)}")
    out.text

first(pattern: string, input: string) -> string = Regex(pattern).findFirstMatchIn(input) match
    Some(m) -> spans(m)
    None -> "none"

show(label: string, pattern: string, input: string) = println(s"$label $pattern: ${first(pattern, input)}")

main()
    // 2^19 pairs: 1,048,576 characters.
    val ab = doubled("ab", 19)
    val abc = doubled("abc", 18) + "x"
    val aab = doubled("aab", 18)
    println(s"lengths ${ab.byteLength} ${abc.byteLength} ${aab.byteLength}")

    // A group of one length, counted.
    show("fixed", "(ab)*", ab)
    show("fixed then more", "(ab)*ab$", ab)
    show("fixed reluctant", "(ab)*?$", ab)
    show("fixed possessive", "(ab)*+$", ab)
    // A group of varying length: alternation, a repetition inside, captures inside.
    show("alternation", "(?:a|b)*", ab)
    show("alternation captured", "(a|b)*", ab)
    show("alternation reluctant", "(?:a|b)*?$", ab)
    show("alternation reluctant captured", "(a|b)*?$", ab)
    show("alternation possessive", "(a|b)*+$", ab)
    show("alternation bounded", "(a|b){0,2000000}", ab)
    show("alternation at least", "(a|b){1000000,}", ab)
    show("inner repetition", "(a+b)*", aab)
    show("inner repetition reluctant", "(a+?b)*?$", aab)
    show("captures inside", "((a)|(b))*", ab)
    show("captures inside reluctant", "((a)|(b))*?$", ab)
    // Giving back: the whole repetition is taken, then given back one at a time to find the end.
    show("give back", "(a|ab)*c", doubled("ab", 18) + "c")
    show("give back far", "(?:a|b)*ab", ab)
    show("give back captured", "(a|b)*ba", doubled("ab", 18) + "ba")
    // Nested repetitions.
    show("nested", "((?:a|b)c)*", doubled("ac", 18))
    show("nested loops", "((a|b)*c)*x", abc)
    show("nested reluctant", "((a|b)*?c)*?x", abc)
    // Back references and lookarounds inside the repeated group.
    show("back reference", "(?:(a|b)\\1)*", doubled("aabb", 17))
    show("lookahead", "(?:(?=a)a|b)*", ab)
    show("negative lookahead", "(?:a(?!a)|b)*", ab)
    show("lookbehind", "(?:(?<=b|^)a|b)*", ab)
    show("lookahead capture", "(?:a(?=(b)))*", doubled("ab", 18))
    // Other items repeated, which give back one repetition at a time.
    show("line breaks", "\\R*x", doubled("\r\n\n", 18) + "x")
    show("line breaks captured", "(\\R)*\nx", doubled("\r\n\n", 18) + "x")
    show("line breaks reluctant", "(\\R)*?x", doubled("\r\n\n", 18) + "x")
    show("atomic items", "(?>a|ab)*$", ab)
    show("back reference repeated", "(a)\\1*$", doubled("a", 20))
    show("back reference repeated reluctant", "(a)\\1*?$", doubled("a", 20))
    // A single character repeated, over the whole input and given back to its end.
    show("characters", "[ab]*b$", ab)
    show("characters reluctant", "[ab]*?b$", ab)
    // The whole input matched, and a search finding the only match at the end.
    println(Regex("(?:ab|ba)*").matches(ab))
    println(Regex("(?:a|b)*c").findFirstIn(ab + "c").map(s -> s.byteLength))
    println(Regex("(?:a|b)*c").findFirstIn(doubled("ab", 10)))
