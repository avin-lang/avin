import avin.io

// With nothing on standard input, `readLine` is `None` at once, `lines()` is empty and `readAll` is
// the empty string.
main()
    println(io.readLine())
    println(io.lines().hasNext())
    var n = 0
    for _ in io.lines() do n += 1
    println(n)
    println(debug(io.readAll()))
