// expect: exit 0
// args: -l --help --top many
// `parseOrExit` given `--help`: the help goes to standard output and the program exits with 0, even
// though an argument after it is wrong and a required argument is missing.
import avin.cli

val parser = cli.Parser("wc", "Count lines, words and characters.", version = "0.1")
    .flag("lines", short = 'l', help = "count lines")
    .int("top", help = "list the N commonest words", value = "N")
    .positionals("file", help = "the files to count", required = true)

main(args: Vector[string]) -> int
    parser.parseOrExit(args)
    println("not reached")
    1
