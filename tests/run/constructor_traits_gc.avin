// expect: exit 0
// Values made in bulk through constructor-trait bounds, so the collector runs while instances at
// `List`, `Option`, a partial application of `Result` and a program's own class hold them: in
// closures the trait's methods are given, in the lists they build, and across default bodies.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]
  mapTwice[B](f: (A) -> A, g: (A) -> B) -> Self[B] = map(a -> g(f(a)))

trait Chainable[A]: Mappable[A]
  flatMap[B](f: (A) -> Self[B]) -> Self[B]

impl Chainable for List
impl Chainable for Option
impl[T, E] Chainable[T] for Result[T, E]

class Cell[A](val item: A)
  map[B](f: (A) -> B) -> Cell[B] = Cell(f(item))
  flatMap[B](f: (A) -> Cell[B]) -> Cell[B] = f(item)

impl Chainable for Cell

labels[F[_]: Chainable](x: F[int], y: F[int]) -> F[string] =
  x.flatMap(a -> y.mapTwice(b -> a + b, s -> s"#$s"))

grow[F[_]: Mappable](x: F[int], rounds: int) -> F[int]
  var current = x
  for _ in 0 ..< rounds
    current = current.map(n -> n + 1)
  current

main()
  var total = 0
  for i in 0 ..< 300
    val xs = labels[List](List(i, i + 1, i + 2), List(1, 2, 3))
    total = total + xs.length
    val o = labels[Option](Some(i), Some(1))
    if o is Some(_) then total = total + 1
    val r = labels[Result[_, string]](Ok(i), Ok(2))
    if r is Ok(_) then total = total + 1
    total = total + labels[Cell](Cell(i), Cell(3)).item.charCount
  println(total)
  println(grow[List](List(1, 2, 3), 500))
  println(grow[Cell](Cell(0), 2000).item)
  println(grow[Result[_, string]](Ok(0), 1000))
