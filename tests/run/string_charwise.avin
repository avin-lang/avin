// expect: exit 0
// The character-wise methods of `string`: they walk characters, never bytes, so `é` (two bytes),
// `日` (three) and `😀` (four) are each one element, and every result is a string or a pair of them.

isVowel(c: char) -> bool = c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u'

show(p: (string, string)) -> string
    val (a, b) = p
    s"[$a|$b]"

showV(v: Vector[string]) -> string = v.map(x -> s"<$x>").mkString(",")

showC(o: Option[char]) -> string = o match
    Some(c) -> s"Some($c)"
    None -> "None"

main()
    // map
    println("hello".map(c -> c.toUpper))
    println("".map(c -> c.toUpper))
    println("é日😀".map(c -> if c == '日' then 'x' else c))
    println("abc".map(c -> '😀'))
    println("a😀".map(c -> 'é').byteLength)

    // flatMap
    println("abc".flatMap(c -> s"$c$c"))
    println("".flatMap(c -> "x"))
    println("a日b".flatMap(c -> if c == '日' then "" else c.toString()))
    println("é😀".flatMap(c -> s"[$c]"))

    // filter, filterNot
    println("education".filter(isVowel))
    println("education".filterNot(isVowel))
    println("".filter(isVowel).isEmpty)
    println("日本語é😀".filter(c -> int(c) > 127))
    println("日本語é😀".filterNot(c -> c == '本'))
    println("xyz".filter(isVowel).isEmpty)
    println("aei".filterNot(isVowel).isEmpty)

    // foreach
    var seen = ""
    var n = 0
    "aé日😀".foreach(c ->
        seen = seen + s"$c."
        n += 1)
    println(s"$seen $n")
    "".foreach(c -> n += 100)
    println(n)

    // exists, forall
    println("hello".exists(isVowel))
    println("rhythm".exists(isVowel))
    println("".exists(isVowel))
    println("aeiou".forall(isVowel))
    println("aexiou".forall(isVowel))
    println("".forall(isVowel))
    println("a😀".exists(c -> c == '😀'))
    println("😀😀".forall(c -> c == '😀'))

    // find
    println(showC("hello".find(isVowel)))
    println(showC("rhythm".find(isVowel)))
    println(showC("".find(isVowel)))
    println(showC("ab日c".find(c -> int(c) > 255)))
    println(showC("x".find(c -> c == 'x')))

    // takeWhile, dropWhile, span, partition
    println("aeixyz".takeWhile(isVowel))
    println("aeixyz".dropWhile(isVowel))
    println("xyz".takeWhile(isVowel).isEmpty)
    println("aei".takeWhile(isVowel))
    println("aei".dropWhile(isVowel).isEmpty)
    println("".takeWhile(isVowel).isEmpty)
    println("".dropWhile(isVowel).isEmpty)
    println("éé日x".takeWhile(c -> int(c) > 127))
    println("éé日x".dropWhile(c -> int(c) > 127))
    println(show("aeixyz".span(isVowel)))
    println(show("xyz".span(isVowel)))
    println(show("aei".span(isVowel)))
    println(show("".span(isVowel)))
    println(show("😀😀x".span(c -> c == '😀')))
    println(show("aXbYc".partition(c -> c.isLower)))
    println(show("".partition(c -> c.isLower)))
    println(show("abc".partition(c -> c.isLower)))
    println(show("ABC".partition(c -> c.isLower)))
    println(show("é1😀2".partition(c -> c.isDigit)))

    // splitAt
    println(show("hello".splitAt(2)))
    println(show("hello".splitAt(0)))
    println(show("hello".splitAt(-3)))
    println(show("hello".splitAt(5)))
    println(show("hello".splitAt(99)))
    println(show("".splitAt(3)))
    println(show("é日😀x".splitAt(1)))
    println(show("é日😀x".splitAt(2)))
    println(show("é日😀x".splitAt(3)))

    // tail, init
    println("hello".tail)
    println("hello".init)
    println("a".tail.isEmpty)
    println("a".init.isEmpty)
    println("é日".tail)
    println("é日".init)
    println("a😀".tail)
    println("😀a".init)
    println("日".tail.byteLength)
    println("ab".tail.tail.isEmpty)

    // charIterator
    val it = "aé日😀".charIterator()
    var out = ""
    while it.hasNext()
        out = out + s"${it.next()}/"
    println(out)
    println("".charIterator().hasNext())
    println("abc".charIterator().map(c -> c.toUpper).toVector.mkString(""))
    println("é日😀".charIterator().size)
    println("hello".charIterator().filter(isVowel).toVector.mkString(","))
    println("abcdef".charIterator().take(2).toVector.mkString(""))
    println("a😀b".charIterator().zipWithIndex.toVector.mkString(" "))
    val partial = "xyz".charIterator()
    partial.next()
    println(partial.next())
    println(partial.hasNext())

    // GC stress: many strings built by the character-wise forms
    var big = ""
    for i in 0..<200
        big = big + "é日😀k"
    println(big.charCount)
    val mapped = big.map(c -> if c == 'k' then 'K' else c)
    println(mapped.filter(c -> c == 'K').charCount)
    println(big.flatMap(c -> s"$c$c").charCount)
    var total = 0
    for round in 0..<300
        val (a, b) = big.splitAt(round)
        total += a.charCount + b.filterNot(c -> c == 'k').charCount
        total += big.tail.init.takeWhile(c -> c != 'k').charCount
    println(total)
    var cnt = 0
    val gi = big.charIterator()
    while gi.hasNext()
        gi.next()
        cnt += 1
    println(cnt)
