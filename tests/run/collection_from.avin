// expect: exit 0
// The companion `from(xs)` of every collection, `Vector.iterate`, `Vector.unfold`, `List.unfold`
// and the sorted conversions `toSortedSet()` and `toSortedMap()`: each source kind into each target.

import avin.collections.mutable.{Set as MutableSet, TreeSet as MutableTreeSet, LinkedSet as MutableLinkedSet, BitSet as MutableBitSet, Map as MutableMap, TreeMap as MutableTreeMap, LinkedMap as MutableLinkedMap, PriorityQueue}

class Item(val id: int)

main(args: Vector[string])
    val v = [3, 1, 2, 3, 1]
    val sources: Vector[() -> Iterable[int]] = [() -> v, () -> v.toList, () -> 1..3, () -> v.iterator(), () -> v.toArraySeq, () -> v.toSet, () -> Queue.from(v)]
    // Sequence targets keep the order of an ordered source.
    println(List.from(v))
    println(List.from(v.toList))
    println(List.from(1..4))
    println(List.from(v.iterator()))
    println(Vector.from(v.toList))
    println(Vector.from(1..4))
    println(ArraySeq.from(v.iterator()))
    println(ArraySeq.from(List(7, 8)))
    println(Queue.from(v))
    println(Queue.from(v).dequeue().0)
    println(Buffer.from(v))
    println(Buffer.from(1..3))
    for make in sources
        val src = make()
        println(HashSet.from(src).size)
        println(TreeSet.from(src).toVector)
        println(OrderedSet.from(src).size)
        println(BitSet.from(src).toVector)
        println(Vector.from(src).size)
        println(List.from(src).size)
        println(PriorityQueue.from(src).size)
        println(MutableSet.from(src).size)
        println(MutableTreeSet.from(src).toVector)
        println(MutableLinkedSet.from(src).size)
        println(MutableBitSet.from(src).toVector)
        println(src.toSortedSet.toVector)

    // Empty and one.
    val none: Vector[int] = []
    println(List.from(none).isEmpty)
    println(Vector.from(List[int]()).isEmpty)
    println(ArraySeq.from(none).isEmpty)
    println(Queue.from(none).isEmpty)
    println(HashSet.from(none).isEmpty)
    println(TreeSet.from(none).isEmpty)
    println(OrderedSet.from(none).isEmpty)
    println(BitSet.from(none).isEmpty)
    println(none.toSortedSet.isEmpty)
    println(List.from([9]))
    println(TreeSet.from([9]).toVector)
    println(BitSet.from([0]).toVector)
    println(BitSet.from([0, 63, 64, 200]).toVector)

    // Unsorted input to sorted targets.
    println(TreeSet.from(["pear", "apple", "fig", "apple"]).toVector)
    println(["b", "a", "c"].toSortedSet.toVector)
    println(OrderedSet.from(["b", "a", "b", "c", "a"]).toVector)
    println(OrderedSet.from(["b", "a", "b", "c", "a"]).toVector)

    // Maps: a later pair's value wins for a duplicate key.
    val pairs = [(2, "two"), (1, "one"), (2, "deux"), (3, "three"), (1, "un")]
    val hm = HashMap.from(pairs)
    println(hm.size)
    println(hm.get(2))
    println(hm.get(1))
    val tm = TreeMap.from(pairs)
    println(tm.toVector)
    val om = OrderedMap.from(pairs)
    println(om.toVector)
    println(pairs.toSortedMap.toVector)
    println(pairs.toList.toSortedMap.toVector)
    println(pairs.iterator().toSortedMap.toVector)
    println(HashMap.from(pairs.toList).size)
    println(TreeMap.from(List[(int, string)]()).isEmpty)
    println(OrderedMap.from(List[(int, string)]()).isEmpty)
    println(HashMap.from(List[(int, string)]()).isEmpty)
    println(TreeMap.from(OrderedMap.from(pairs)).toVector)
    println(HashMap.from(tm).size)
    val mm = MutableMap.from(pairs)
    println(mm.size)
    println(mm.get(2))
    println(MutableTreeMap.from(pairs).toVector)
    val lm = MutableLinkedMap.from(pairs)
    println(lm.toVector)
    println(lm.get(1))
    println(MutableTreeMap.from(pairs.iterator()).toVector)
    println(["x", "y"].toList.zip([1, 2]).toSortedMap.toVector)

    // Element widening where variance allows.
    val widened: Vector[Any] = Vector.from([1, 2, 3])
    println(widened.size)
    val widerList: List[Any] = List.from(["a", "b"])
    println(widerList.size)
    val srcOfItems: Iterable[Item] = [Item(1), Item(2)]
    val itemQueue: Queue[Item] = Queue.from(srcOfItems)
    println(itemQueue.size)

    // iterate and unfold.
    println(Vector.iterate(1, 6, x -> x * 2))
    println(Vector.iterate(1, 1, x -> x * 2))
    println(Vector.iterate(1, 0, x -> x * 2))
    println(Vector.iterate(1, -3, x -> x * 2))
    // f is called one fewer time than there are elements.
    var calls = 0
    println(Vector.iterate(0, 4, x ->
        calls += 1
        x + 1))
    println(calls)
    println(Vector.iterate("a", 3, s -> s + "b"))
    println(Vector.unfold(1, n -> if n > 40 then None else Some((n * n, n * 3))))
    println(Vector.unfold(5, n -> if n == 0 then None else Some((n, n - 1))))
    println(Vector.unfold(0, n -> if n == 0 then None else Some((n, n - 1))))
    println(List.unfold(1, n -> if n > 40 then None else Some((n * n, n * 3))))
    println(List.unfold("", s -> if s.byteLength() == 3 then None else Some((s.byteLength(), s + "x"))))
    println(List.unfold(0, n -> if n == 0 then None else Some((n, n - 1))).isEmpty)
    println(Vector.iterate(1, 1000, x -> x + 1).last)

    // Heap-allocated elements under churn.
    var total = 0
    for round in 0..<60
        val items = Vector.tabulate(50, i -> Item(round * 100 + i))
        val q = Queue.from(items)
        val ts = TreeSet.from(items.map(it -> s"i${it.id}"))
        val om2 = OrderedMap.from(items.map(it -> (s"k${it.id % 7}", it)))
        val hm2 = HashMap.from(items.map(it -> (it.id % 11, it.id)))
        val vi = Vector.iterate(Item(0), 20, it -> Item(it.id + 1))
        val ul = List.unfold(0, n -> if n >= 30 then None else Some((Item(n), n + 1)))
        total += q.size + ts.size + om2.size + hm2.size + vi.size + ul.size
    println(total)
