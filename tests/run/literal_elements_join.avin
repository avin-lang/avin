// expect: exit 0
// A number literal among the elements of a collection literal, the keys or values of a map literal,
// the branches of an `if` or the arms of a `match` takes the type the others decide, wherever it is
// written: `[long(1), 2]` and `[2, long(1)]` are both a `Vector[long]`, and `[1.5, 2]` a
// `Vector[real]`. So does a literal inside a value built around it (`Some(2)`, `(2, "b")`, `[2]`),
// and an expression of literals alone (`2 * 3`, `-5`). Where the others are literals too, the first
// written decides, an `int` unless it says otherwise.

open class Animal(val name: string)
class Dog(n: string): Animal(n)
class Cat(n: string): Animal(n)

// Each overload names the type its argument was given, so the type agreed on is visible.
kind(v: Vector[int]) -> string = "Vector[int]"
kind(v: Vector[long]) -> string = "Vector[long]"
kind(v: Vector[real]) -> string = "Vector[real]"
kind(v: Vector[i8]) -> string = "Vector[i8]"
kind(v: Vector[byte]) -> string = "Vector[byte]"
kind(v: Vector[Option[long]]) -> string = "Vector[Option[long]]"
kind(v: Vector[(long, string)]) -> string = "Vector[(long, string)]"
kind(v: Vector[Vector[long]]) -> string = "Vector[Vector[long]]"
kind(v: Vector[(Animal, long)]) -> string = "Vector[(Animal, long)]"
kind(v: List[long]) -> string = "List[long]"
kind(v: Map[string, long]) -> string = "Map[string, long]"
kind(v: Map[long, string]) -> string = "Map[long, string]"
kind(v: Set[long]) -> string = "Set[long]"

scalar(x: int) -> string = s"int $x"
scalar(x: long) -> string = s"long $x"
scalar(x: real) -> string = s"real $x"

option(o: Option[int]) -> string = "Option[int]"
option(o: Option[long]) -> string = "Option[long]"

same[T](a: T, b: T) -> T = b

pick(n: int) -> long = n match
  0 -> long(5)
  1 -> 6
  _ -> 1_000_000_000_000

pickFirst(n: int) -> string
  val r = n match
    0 -> 6
    1 -> -7
    _ -> long(8)
  scalar(r)

main(args: Vector[string])
  val big: long = 1

  // Either order; the literal may come first, last or between.
  println(kind([long(1), 2]))
  println(kind([2, long(1)]))
  println(kind([2, big, 3]))
  println(kind([1, 2 * 3, big, -5]))

  // A real decides for integer literals, which are that real.
  val reals = [1.5, 2]
  println(s"${kind(reals)} ${reals}")
  println(kind([2, 1.5]))
  println(kind([-1, 0.25, 3]))

  // Narrow types: the literals take them, at their bounds.
  println(kind([i8(1), -128, 127]))
  println(kind([0xff, byte(1), 0]))

  // The widest values of a long.
  val extremes = [big, 9223372036854775807, -9223372036854775808]
  println(s"${kind(extremes)} ${extremes}")

  // Literals nested in values built around them.
  println(kind([Some(big), Some(2)]))
  println(kind([Some(2), Some(big)]))
  println(kind([(2, "b"), (big, "a")]))
  println(kind([[2, 3], [big]]))
  println(kind([[2], [], [big]]))

  // A literal beside a class still lets the class widen the join.
  println(kind([(Dog("d"), 2), (Cat("c"), big)]))

  // The library's other collections, built from the literal.
  val list: List[long] = [2, big]
  println(kind(list))
  println(kind(List(2, big)))
  val set = {2, big}
  println(kind(set))

  // Map literals: the keys agree, and the values agree.
  val values = {"a": big, "b": 2}
  println(s"${kind(values)} ${values("b")}")
  val keys = {1: "one", long(2): "two"}
  println(s"${kind(keys)} ${keys(big)}")

  // The branches of an `if`.
  val yes = args.size == 0
  println(scalar(if yes then big else 2))
  println(scalar(if yes then 2 else big))
  println(scalar(if yes then 2 else 1.5))
  println(scalar(if !yes then 1 elif args.size > 3 then big else 3))
  println(scalar(if yes then 0 else 6))

  // The arms of a `match`.
  println(scalar(pick(0)))
  println(scalar(pick(1)))
  println(scalar(pick(2)))
  println(pickFirst(0))
  println(pickFirst(1))

  // Arguments of one type parameter agree the same way, the literal one either side.
  println(option(same(Some(big), Some(5))))
  println(option(same(Some(5), Some(big))))

  // Literals alone still default to `int`.
  println(kind([1, 2]))
  println(scalar(if yes then 1 else 2))

  // A closure over a vector the literal made, and the elements keep their values.
  val longs = [2, big, 3]
  val total = () -> longs.sum
  println(total())
