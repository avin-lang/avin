// expect: trap
// Recursion without a base case overflows the stack of a future's body, which runs on a worker of the
// pool, a lightweight thread of its own, and stops the program with the same trap.
import avin.threads.Future

descend(n: int) -> int = descend(n + 1) + n

main() -> int
  println("before")
  println(Future(descend(0)).await())
  println("after")
  0
