// char: a Unicode scalar value with ordering and conversions.

main() -> int
    val a = 'a'
    val z = 'z'
    if !(a < z) then return 1
    if !('a' <= a <= 'z') then return 2
    if int(a) != 97 then return 3
    if char(98) != 'b' then return 4
    if int('€') != 8364 then return 5
    if int('😀') != 128512 then return 6
    if char(1114111) <= char(65535) then return 7
    if char(byte(65)) != 'A' then return 8
    val code: i64 = 955
    if char(code) != 'λ' then return 9
    // The scalar values on either side of the surrogates convert.
    val below = 55295
    val above = 57344
    if int(char(below)) != 55295 || int(char(above)) != 57344 then return 10
    0
