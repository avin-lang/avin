// expect: exit 0
// avin.math's round, trunc, log2, fma, copySign, ulp, nextUp and nextDown on ordinary values, at
// ties and at the edges of `real`: negative zero, subnormals, the greatest value, the infinities
// and NaN.
import avin.math
import avin.math.{round, trunc, nextUp, nextDown}

main()
    rounding()
    truncating()
    logs()
    fused()
    signs()
    spacing()

rounding()
    println(s"round ${round(2.5)} ${round(-2.5)} ${round(3.5)} ${round(0.5)} ${round(-0.5)} ${round(1.5)} ${round(-1.5)}")
    println(s"round ${round(2.4)} ${round(2.6)} ${round(-2.4)} ${round(-2.6)} ${round(0.0)} ${round(-0.0)} ${round(7.0)}")
    // 0.49999999999999994 is the greatest real below one half: it rounds down, not to one.
    println(s"round ${round(0.49999999999999994)} ${round(-0.49999999999999994)} ${round(4503599627370497.0)} ${round(-4503599627370497.5)}")
    // Out of range and not a number convert as `long(x)` does.
    println(s"round ${round(real.NaN)} ${round(real.PositiveInfinity)} ${round(real.NegativeInfinity)}")
    println(s"round ${round(1e300)} ${round(-1e300)} ${round(9.3e18)} ${round(-9.3e18)} ${round(9.2e18)}")
    println(s"round ${round(real.MaxValue)} ${round(real.MinValue)} ${round(real.MinPositiveValue)} ${round(-real.MinPositiveValue)}")
    // The type is long, so a value past int's range is kept.
    val big: long = round(3000000000.5)
    println(s"round ${big}")

truncating()
    println(s"trunc ${trunc(2.7)} ${trunc(-2.7)} ${trunc(2.0)} ${trunc(-2.0)} ${trunc(0.0)} ${trunc(0.99999999999999989)}")
    // A negative value that truncates to zero keeps its sign.
    println(s"trunc ${trunc(-0.5)} ${trunc(-0.0)} ${1.0 / trunc(-0.5)} ${1.0 / trunc(0.5)}")
    println(s"trunc ${trunc(real.PositiveInfinity)} ${trunc(real.NegativeInfinity)} ${trunc(real.NaN)}")
    println(s"trunc ${trunc(1e300) == 1e300} ${trunc(real.MaxValue) == real.MaxValue} ${trunc(real.MinPositiveValue)} ${trunc(4503599627370497.5)}")
    // It agrees with floor above zero and ceil below it.
    println(s"trunc ${trunc(5.5) == math.floor(5.5)} ${trunc(-5.5) == math.ceil(-5.5)}")

logs()
    println(s"log2 ${math.log2(1.0)} ${math.log2(2.0)} ${math.log2(8.0)} ${math.log2(1024.0)} ${math.log2(0.5)} ${math.log2(0.125)}")
    println(s"log2 ${math.log2(3.0)} ${math.log2(10.0)} ${math.log2(math.E)}")
    println(s"log2 ${math.log2(0.0)} ${math.log2(-0.0)} ${math.log2(-1.0)} ${math.log2(real.NaN)} ${math.log2(real.PositiveInfinity)} ${math.log2(real.NegativeInfinity)}")
    println(s"log2 ${math.log2(real.MinPositiveValue)} ${math.log2(real.MaxValue)} ${math.log2(4503599627370496.0)}")
    var exact = true
    var e = -1074
    while e <= 1023
        if math.log2(math.pow(2.0, real(e))) != real(e) then exact = false
        e += 1
    println(s"log2 exact at every power of two: ${exact}")

fused()
    println(s"fma ${math.fma(2.0, 3.0, 4.0)} ${math.fma(-2.0, 3.0, 4.0)} ${math.fma(0.0, 5.0, 1.0)} ${math.fma(1.5, 2.0, -3.0)}")
    // One rounding rather than two: 0.1 * 10.0 rounds to exactly 1.0, whose difference from 1.0 the
    // fused form still sees.
    println(s"fma ${math.fma(0.1, 10.0, -1.0)} ${0.1 * 10.0 - 1.0}")
    println(s"fma ${math.fma(1e308, 10.0, -1e308)} ${math.fma(1e308, 10.0, -real.MaxValue) == real.PositiveInfinity}")
    println(s"fma ${math.fma(real.PositiveInfinity, 0.0, 1.0)} ${math.fma(real.NaN, 1.0, 1.0)} ${math.fma(1.0, 1.0, real.NaN)}")
    println(s"fma ${math.fma(1.0, real.PositiveInfinity, real.NegativeInfinity)} ${math.fma(2.0, real.PositiveInfinity, 1.0)} ${math.fma(2.0, 3.0, real.NegativeInfinity)}")
    println(s"fma ${math.fma(-0.0, 1.0, -0.0)} ${math.fma(0.0, 1.0, -0.0)} ${math.fma(-0.0, 1.0, 0.0)}")
    // `x * y + z` written out is two operations: the language does not fuse them behind the program's back.
    val x = 1.0 + 7.450580596923828e-9
    println(s"fma ${math.fma(x, x, -1.0)} ${x * x - 1.0}")

signs()
    println(s"copySign ${math.copySign(3.0, -1.0)} ${math.copySign(-3.0, 1.0)} ${math.copySign(3.0, 1.0)} ${math.copySign(-3.0, -1.0)}")
    println(s"copySign ${math.copySign(3.0, -0.0)} ${math.copySign(3.0, 0.0)} ${math.copySign(0.0, -1.0)} ${math.copySign(-0.0, 1.0)}")
    println(s"copySign ${math.copySign(real.PositiveInfinity, -1.0)} ${math.copySign(real.NegativeInfinity, 1.0)} ${math.copySign(real.MinPositiveValue, -2.0) == -real.MinPositiveValue}")
    // NaN has a sign bit as any value does, and a NaN as the sign donor passes it on.
    println(s"copySign ${math.copySign(1.0, real.NaN)} ${math.copySign(real.NaN, -1.0).isNaN()} ${math.copySign(real.NaN, 1.0).isNaN()}")
    println(s"copySign ${math.copySign(3.0, real.NegativeInfinity)} ${math.copySign(1.0, math.copySign(real.NaN, -1.0))}")

spacing()
    println(s"ulp ${math.ulp(1.0)} ${math.ulp(-1.0)} ${math.ulp(2.0)} ${math.ulp(0.5)} ${math.ulp(1024.0)}")
    val tiny = real.MinPositiveValue
    println(s"ulp ${math.ulp(0.0) == tiny} ${math.ulp(-0.0) == tiny} ${math.ulp(tiny) == tiny} ${math.ulp(1e-310) == tiny} ${math.ulp(2.2250738585072014e-308) == tiny}")
    println(s"ulp ${math.ulp(real.PositiveInfinity)} ${math.ulp(real.NegativeInfinity)} ${math.ulp(real.NaN).isNaN()}")
    // At the greatest finite value the gap is the one below it.
    val top = real.MaxValue
    println(s"ulp ${math.ulp(top) == top - nextDown(top)} ${math.ulp(real.MinValue) == math.ulp(top)} ${math.ulp(9007199254740992.0)} ${math.ulp(9007199254740991.0)}")
    println(s"nextUp ${nextUp(1.0)} ${nextUp(-1.0)} ${nextUp(0.0) == tiny} ${nextUp(-0.0) == tiny} ${nextUp(-tiny)} ${1.0 / nextUp(-tiny)}")
    println(s"nextUp ${nextUp(top)} ${nextUp(real.PositiveInfinity)} ${nextUp(real.NegativeInfinity) == real.MinValue} ${nextUp(real.NaN).isNaN()}")
    println(s"nextDown ${nextDown(1.0)} ${nextDown(-1.0)} ${nextDown(0.0) == -tiny} ${nextDown(-0.0) == -tiny} ${nextDown(tiny)} ${1.0 / nextDown(tiny)}")
    println(s"nextDown ${nextDown(real.MinValue)} ${nextDown(real.NegativeInfinity)} ${nextDown(real.PositiveInfinity) == top} ${nextDown(real.NaN).isNaN()}")
    // The neighbours are one ulp away and round trip, wherever the value sits.
    var ok = true
    for x in [1.0, 0.1, 3.0, 1e-300, 1e300, 123456.789, 4.9e-324, 2.2250738585072014e-308, 1.0000000000000002]
        if nextUp(x) - x != math.ulp(x) || x - nextDown(x) != math.ulp(x) && x != 1.0 then ok = false
        if nextDown(nextUp(x)) != x || nextUp(nextDown(x)) != x then ok = false
        if !(nextDown(x) < x < nextUp(x)) then ok = false
    println(s"neighbours ${ok}")
    // Across a power of two the gap below is half the gap above.
    println(s"binade ${1.0 - nextDown(1.0) == math.ulp(1.0) / 2.0} ${nextUp(1.0) - 1.0 == math.ulp(1.0)}")
