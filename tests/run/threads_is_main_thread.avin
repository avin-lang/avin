// expect: exit 0
// `isMainThread()` answers true on the thread `main` was called on and false on every lightweight
// thread: one spawned, one in a scope, a future's body on the shared pool and on an executor of its
// own, a thread spawned from another, and a thread that has slept and woken on another worker.
import avin.threads.{Executor, Future, Promise, isMainThread, scope, sleep, spawn}
import avin.time.millis

main()
  println(isMainThread())
  println(spawn(() -> isMainThread()).join())
  println(scope(s -> s.spawn(() -> isMainThread()).join()))
  println(Future(isMainThread()).await())
  val ex = Executor.fixed(2)
  println(ex.future(isMainThread()).await())
  ex.shutdown()
  println(spawn(() -> spawn(() -> isMainThread()).join()).join())
  println(spawn(() ->
    sleep(millis(2))
    isMainThread()).join())
  // A lightweight thread that completes a promise the main thread waits on: the main thread is still
  // the main thread after its wait.
  val p = Promise[bool]()
  val t = spawn(() -> p.complete(isMainThread()))
  println(p.future.await())
  t.join()
  println(isMainThread())
  // A function value of it, called on both sides.
  val f: @sendable () -> bool = isMainThread
  println(s"${f()} ${spawn(() -> f()).join()}")
