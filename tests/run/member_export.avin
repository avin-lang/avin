// expect: exit 0
// A class presents members of a field as its own: one member, a group, an alias, and every public
// member with `*`; a call keeps the member's overloads, defaults and named arguments, a read reads a
// field or calls a method of no parameter list, an assignment assigns a `var` field, and a method
// named without a call is its function value.
class Counter(var count: int)
  bump() = count += 1
  bump(by: int) = count += by
  add(a: int, b: int = 10) -> int = a + b + count
  total -> int = count * 2
  label(prefix: string, parts: string*) -> string = prefix + ":" + parts.mkString(",")
  private secret() -> int = 42

class Box(c: Counter)
  export c.bump
  export c.{add, total as doubled, label}
  export c.count

class All(c: Counter)
  export c.*
  total -> int = -1

main()
  val b = Box(Counter(1))
  b.bump()
  b.bump(5)
  println(b.count)
  println(b.add(1))
  println(b.add(a = 1, b = 2))
  println(b.add(b = 3, a = 4))
  println(b.doubled)
  println(b.label("p", "x", "y"))
  println(b.label("q"))
  b.count = 3
  println(b.count)
  b.count += 2
  println(b.count)
  b.count++
  println(b.count)
  val f = b.add
  println(f(1, 1))
  val g: (int) -> unit = b.bump
  g(10)
  println(b.count)
  val a = All(Counter(4))
  a.bump()
  a.bump(2)
  println(a.count)
  println(a.total)
  println(a.add(0, 0))
  println(s"${a.count} ${b.doubled}")
