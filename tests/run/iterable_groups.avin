// expect: exit 0
// `groupBy`, `groupMap` and `groupMapReduce` collect a collection's elements into a map by key, each
// group keeping the elements' order; a map's own methods leave its entries in hash order, so the
// keys are sorted before they are printed. A map is itself `Iterable` over its entries as pairs, so
// the same methods take it apart.
import avin.collections.mutable.{Map as MutableMap, Set as MutableSet}

showGroups[V: Display](groups: Map[string, Vector[V]])
    for k in groups.keys().toVector().sorted() do print(s"$k: ${groups(k).mkString(" ")}")

main()
    val words: List[string] = ["apple", "avocado", "banana", "blueberry", "cherry", "apricot"]
    showGroups(words.groupBy(w -> w.take(1)))
    showGroups(words.groupMap(w -> w.take(1), w -> w.byteLength()))
    val lengths = words.groupMapReduce(w -> w.take(1), w -> w.byteLength(), (a, b) -> a + b)
    for k in lengths.keys().toVector().sorted() do print(s"$k=${lengths(k)}")
    val firsts = words.groupMapReduce(w -> w.take(1), w -> w, (a, b) -> a)
    for k in firsts.keys().toVector().sorted() do print(s"$k=${firsts(k)}")
    val none: Vector[string] = []
    print(none.groupBy(w -> w.byteLength()).isEmpty())
    print(none.groupMapReduce(w -> w, w -> 1, (a, b) -> a + b).size())
    val parity = (1 .. 10).groupBy(x -> x % 3)
    for k in parity.keys().toVector().sorted() do print(s"$k: ${parity(k).mkString(",")}")
    val squares = Array.tabulate(6, i -> i * i).groupMapReduce(x -> x % 2 == 0, x -> 1, (a, b) -> a + b)
    print(s"even=${squares(true)} odd=${squares(false)}")

    // A map's entries are pairs.
    val ages: Map[string, int] = {ann: 31, bob: 27, cy: 40}
    print(ages.count(e -> e.1 > 30))
    print(ages.exists(e -> e.0 == "bob"))
    print(ages.forall(e -> e.1 > 20))
    print(ages.find(e -> e.1 == 40).map(e -> e.0).getOrElse("none"))
    print(ages.foldLeft(0, (acc, e) -> acc + e.1))
    print(ages.minBy(e -> e.1).map(e -> e.0).getOrElse("none"))
    print(ages.maxBy(e -> e.1).map(e -> e.0).getOrElse("none"))
    val (old, young) = ages.partition(e -> e.1 >= 30)
    print(s"${old.map(e -> e.0).sorted().mkString(",")} | ${young.map(e -> e.0).sorted().mkString(",")}")
    print(ages.toVector().sortedBy(e -> e.0).map(e -> s"${e.0}:${e.1}").mkString(" "))
    print(ages.toList().length())
    print(ages.zipWithIndex().length())
    var total = 0
    ages.foreach(e -> total += e.1)
    ages.foreach((k, v) -> total += v)
    print(total)
    print(Map.empty[string, int]().updated("solo", 1).mkString("{", ", ", "}"))
    val byDecade = ages.groupBy(e -> e.1 / 10)
    for k in byDecade.keys().toVector().sorted() do print(s"$k: ${byDecade(k).map(e -> e.0).sorted().mkString(",")}")

    // Mutable collections are `Iterable` too.
    val counts = MutableMap[string, int]()
    counts("x") = 1
    counts("y") = 2
    print(counts.foldLeft(0, (acc, e) -> acc + e.1))
    print(counts.maxBy(e -> e.1).map(e -> e.0).getOrElse("none"))
    val seen = MutableSet[int]()
    seen.add(5)
    seen.add(9)
    print(seen.reduce((a, b) -> a + b))
    print(seen.toVector().sorted().mkString(","))
