// expect: exit 0
// A generic union whose members are one scalar type at an instance, as `T | int` is at `T = int`, is
// that type there, with its layout: constructed, stored, read, returned, tested and seen as an `Any`
// as the scalar itself is.
build[T](x: T) -> Vector[T | int] = [x, 7]

buildReal[T](x: T) -> Vector[T | real] = [x, 0.5]

pick[T](x: T) -> T | real = x

pickInt[T](x: T) -> T | int = x

pickLong[T](x: T) -> T | long = x

pickChar[T](x: T) -> T | char = x

pickBool[T](x: T) -> T | bool = x

pickByte[T](x: T) -> T | byte = x

seven[T]() -> T | int = 7

some[T](x: T) -> Option[T | real] = Some(x)

nested[T](x: T) -> Vector[Option[T | int]] = [Some(x), None, Some(9)]

partial[T](x: T) -> Vector[T | int | string] = [x, 2, "three"]

maker[T](x: T) -> () -> T | int = () -> x

counter[T](x: T) -> (int) -> T | int = n -> if n == 0 then x else n

data Pair[A, B](a: A, b: B)

mk[T](x: T) -> Pair[T | int, T] = Pair(x, x)

class Holder[T](var held: T | int)

hold[T](x: T) -> Holder[T] = Holder(x)

count[T](v: Vector[T | int]) -> long
  var s: long = 0
  for e in v do s += e match
    t: T -> 100
    n: int -> long(n)
  s

isInt[T](x: T | int) -> bool = x is _: int

asAny[T](x: T) -> Any = pickInt[T](x)

show[T: Display](v: Vector[T | int]) -> string = v.map(x -> s"$x").mkString(",")

text[T: Display](x: T | int) -> string = x.toString()

same[T: Eq](x: T | int, y: T | int) -> bool = x == y

hashOf[T: Hash](x: T | int) -> long = x.hash()

keyed[T](x: T) -> Map[T | int, string] = Map((x, "x"), (5, "five"))

main()
  val v: Vector[int] = build[int](3)
  println(v(0))
  println(v(1))
  println(v)
  println(v.sum)
  val r: Vector[real] = buildReal[real](2.25)
  println(r)
  val p: real = pick[real](2.5)
  println(p + 1.0)
  println(pickInt[int](-2147483648))
  println(pickInt[int](2147483647))
  println(pickLong[long](9223372036854775807))
  println(pickChar[char]('é'))
  println(pickBool[bool](true))
  println(pickByte[byte](byte(255)))
  val sv: int = seven[int]()
  println(sv * 2)
  val o: Option[real] = some[real](1.5)
  println(o)
  println(o.map(x -> x * 2.0))
  val n: Vector[Option[int]] = nested[int](4)
  println(n)
  println(n.flatMap(x -> x.toVector).sum)
  val w: Vector[int | string] = partial[int](1)
  println(w)
  for e in w
    e match
      i: int -> println(s"int $i")
      s: string -> println(s"string $s")
  val f: () -> int = maker[int](11)
  println(f() + 1)
  val g = counter[int](5)
  println(g(0) + g(3))
  val pr: Pair[int, int] = mk[int](4)
  println(pr.a + pr.b)
  val h = hold[int](12)
  println(h.held + 1)
  h.held = 13
  println(h.held)
  println(count[int](v))
  println(count[string](build[string]("x")))
  println(isInt[int](3))
  println(isInt[string](3))
  println(isInt[string]("s"))
  val a = asAny[int](21)
  a match
    i: int -> println(s"any int ${i * 2}")
    _ -> println("not int")
  val av: Any = build[int](1)
  av match
    vi: Vector[int] -> println(s"vector int ${vi.sum}")
    _ -> println("not vector int")
  val aw: Any = build[bool](true)
  aw match
    vi: Vector[int] -> println(s"wrong ${vi.sum}")
    vu: Vector[bool | int] -> println(s"bool|int $vu")
    _ -> println("other")
  println(show[int](Vector(123456789, 987654321, 42)))
  println(text[int](42))
  println(text[string]("s"))
  println(same[int](3, 3))
  println(same[int](3, 4))
  println(same[string]("a", 3))
  println(hashOf[int](9) == 9.hash())
  val m: Map[int, string] = keyed[int](1)
  println(m(1) + m(5))
