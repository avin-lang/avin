// expect: exit 0
// Class instances, objects and closures compare and hash by identity, unless the class derives
// `Eq`; arrays and buffers compare by contents while `===` tells them apart. Identity-compared
// values work as map keys and set elements, through `Any` too, and `equals` and `hash` may be called
// on any value.

class Cell(v: int)

class Pt(x: int, y: int) derives Eq, Hash

object Origin

data Holder(c: Cell)

main()
    val a = Cell(1)
    val b = Cell(1)
    println(s"${a == a} ${a == b} ${a != b} ${a === a} ${a === b}")
    println(s"${a.hash() == a.hash()}")
    println(s"${Origin == Origin} ${Origin === Origin}")
    val f = (x: int) -> x + 1
    val g = (x: int) -> x + 1
    println(s"${f == f} ${f == g} ${f === f} ${f === g}")
    val arr1 = Array.tabulate(3, i -> i + 1)
    val arr2 = Array.tabulate(3, i -> i + 1)
    println(s"${arr1 == arr2} ${arr1 === arr2} ${arr1 === arr1} ${arr1.hash() == arr2.hash()}")
    val buf1 = Buffer[int]()
    val buf2 = Buffer[int]()
    buf1.append(4)
    buf2.append(4)
    println(s"${buf1 == buf2} ${buf1 === buf2}")
    println(s"${Pt(1, 2) == Pt(1, 2)} ${Pt(1, 2) === Pt(1, 2)} ${Pt(1, 2).hash() == Pt(1, 2).hash()}")
    val m = {(a): "a", (b): "b"}
    println(s"${m(a)} ${m(b)} ${m.size()}")
    val pm = {Pt(1, 2): "p"}
    println(s"${pm(Pt(1, 2))}")
    println(s"${Holder(a) == Holder(a)} ${Holder(a) == Holder(b)}")
    val s = {a, b, a}
    println(s"${s.size()}")
    val x: Any = a
    val y: Any = b
    println(s"${x == y} ${x == x}")
    val ps: Any = Pt(3, 4)
    println(s"${ps == Pt(3, 4)}")
    println(s"${a.equals(a)} ${1.equals(1)} ${"x".hash() == "x".hash()}")
