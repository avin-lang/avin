// `lines()` starts a command and gives its standard output's lines as they arrive, each without its
// `\n` or `\r\n`; a last line without a terminator is a line, and bytes that are not UTF-8 are each
// replaced with U+FFFD. The status is not checked. A pipeline's last stage and a sequence's parts
// give lines the same way, and output far larger than a pipe's buffer is read to its end.
import avin.process.Command

each(c: Command)
  c.lines() match
    Ok(lines) ->
      for line in lines do println(s"[$line]")
    Err(e) -> println(s"error: $e")

main()
  each(Command("/usr/bin/printf", "one\\ntwo\\r\\nthree"))
  each(Command("/usr/bin/printf", "\\n\\nafter two empty lines\\n"))
  each(Command("/usr/bin/true"))
  each(Command("/usr/bin/printf", "bad \\377 byte\\n"))
  // A failing command's lines are still given.
  each(Command("/bin/sh", "-c", "echo before failing; exit 3"))
  each(Command("/bin/echo", "c b a") | Command("/usr/bin/tr", " ", "\n") | Command("/usr/bin/sort"))
  each(Command("/bin/echo", "first") andThen Command("/bin/echo", "second"))
  each((Command("/bin/echo", "piped") andThen Command("/bin/echo", "sequence")) | Command("/usr/bin/tr", "a-z", "A-Z"))
  each(Command("avin-no-such-program"))
  // The iterator is lazy: taking the first lines reads only as far as they.
  Command("/bin/sh", "-c", "echo 1; echo 2; echo 3").lines() match
    Ok(lines) -> println(lines.take(2).toVector())
    Err(e) -> println(e)
  // Many lines, counted and checked as they arrive.
  Command("/bin/sh", "-c", "i=0; while [ $i -lt 20000 ]; do echo row$i; i=$((i+1)); done").lines() match
    Ok(lines) ->
      var n = 0
      var inOrder = true
      for line in lines
        if line != s"row$n" then inOrder = false
        n += 1
      println(s"$n lines, in order: $inOrder")
    Err(e) -> println(e)
  // One long line, larger than a pipe's buffer.
  Command("/usr/bin/head", "-c", "200000", "/dev/zero").lines() match
    Ok(lines) -> println(lines.map(l -> l.byteLength()).toVector())
    Err(e) -> println(e)
