// expect: trap
// `main` awaits the end of an actor that waits for mail nobody can send: the actor has no thread while
// its mailbox is empty, no worker is running or ready, and no timer is set, so the program is
// deadlocked. Idle workers, which wait for work by design and are as many as the machine has
// processors, are left out of the report.
import avin.actors.spawn
import avin.threads.Channel

actor Silent(seen: Channel[int]) receives int
  receive
    n -> seen.send(n)

main()
  val seen = Channel[int]()
  val a = spawn(Silent(seen))
  a.tell(1)
  println(seen.receive())
  println("awaiting the end")
  println(a.ended().await())
