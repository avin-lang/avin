// expect: trap
// A `Metrics` and a `ServerMetrics` share a registry, their names being different; a second `Metrics`
// in the same registry makes its names again, and traps.
import avin.metrics.Registry
import avin.net.http.{Metrics, ServerMetrics}

main()
  val r = Registry()
  _ = Metrics(registry = r)
  _ = ServerMetrics(registry = r)
  println(r.names)
  _ = Metrics(registry = r)
