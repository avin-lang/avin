// Blocks as values, `while` with `else` and `break` values, control transfer inside operands,
// shadowing and mutation order, and function bodies that end in a value or a statement.

identity[T](x: T) = x

before() -> int
  println(1)
  1

after() -> int
  println(3)
  3

show(a: int, b: int, c: int) = println(a, b, c)

shadowing(x: int) -> int
  val y =
    val x = x + 1
    x
  x + y

label(n: int) = if n < 0 then "negative" elif n == 0 then "zero" else "positive"

choose(n: int) -> int
  if n > 0 then
    val answer = 42
    answer
  else
    0
  end if
end choose

choose_arm(n: int) = n match
  0 ->
    val base = 21
    base * 2
  else 0

block_result() -> int
  println("before")
  42

block_discard()
  println("before")
  42

block_infer() =
  println("before")
  42

block_generic[T](x: T) =
  println("id")
  x

block_match_then_value() -> int
  true match
    true -> println("yes")
    false -> println("no")
  42

block_return_match() -> int
  println("match")
  1 match
    1 -> 42
    else 0

emit()
  println("first")
  println("second")

main()
  val answer =
    val base = 21
    base * 2
  println(answer)
  println(shadowing(20))
  println(label(-1), label(0), label(1))
  println(choose(1))
  println(choose_arm(0))
  println(10 + if true then 32 else 1 / 0)

  // Loops: the body may be inline, `else` supplies the value of a loop that ends normally, and a
  // `break` carries the value of one that does not.
  var n = 0
  while n < 3
    println(n)
    n += 1
  end while
  var i = 0
  while i < 3 do i += 1
  println(i)
  var skipped = 0
  while skipped < 5 do
    skipped += 1
    if skipped == 3 then continue
    println(skipped)
  end while
  var j = 0
  val found = while j < 10 do
    j += 1
    if j == 3 then break j
  else -1
  println(found, j)
  var k = 0
  val finished = while k < 2 do k += 1
  else 42
  println(finished, k)
  var outer = 0
  var count = 0
  while outer < 3
    outer += 1
    var inner = 0
    while inner < 3
      inner += 1
      if inner == 2 then break
      count += 1
  println(outer, count)
  val never = while false do println("body")
  else 42
  println(never)
  val breaks_outer = while true do
    while false do println("body")
    else break 42
  else 0
  println(breaks_outer)
  var broken = 0
  while broken < 3
    broken += 1
    broken match
      2 -> break
      else println(broken)
  println(broken)
  // A branch whose value is dropped need not agree with the other.
  if true then 1 else false
  1 match
    1 -> true
    else 42
  println("done")

  // `break` inside an operand abandons the rest of the expression and of the call.
  val a = while true do
    if true then break 42 else break 0
  else 0
  val b = while true do
    val x: int = 1 + (break 42)
    println(x)
  else 0
  val c = while true do
    val x: bool = 0 < (break 42) < 3
    println(x)
  else 0
  val d = while true do
    val x: bool = true && (break 42)
    println(x)
  else 0
  val e = while true do
    val x: int = if false then 1 else break 42
    println(x)
  else 0
  val f = while true do
    (break 42) match
      else println(0)
  else 0
  val g = while true do
    show(before(), break 42, after())
  else 0
  println(a, b, c, d, e, f, g)

  // Mutation: the right side of a compound assignment may change the variable, a `var` in an inner
  // block shadows without changing the outer one.
  var m = 1
  m += (m := 10)
  println(m)
  var chain = 1
  println(0 < chain++ < 10, chain)
  println(100 < chain++ < ++chain, chain)
  var p = 0
  var q = 0
  println(p := q := 42, p, q)
  var shadowed = 1
  if true then
    var shadowed = shadowed + 1
    shadowed += 1
    println(shadowed)
  println(shadowed)
  var text = "before"
  text = "after"
  println(text)
  var shown = debug("before")
  shown = debug("after")
  println(shown)

  println(block_result())
  block_discard()
  println(block_infer())
  println(block_generic(42))
  println(block_match_then_value())
  println(block_return_match())
  emit()
