// Blocks as values, `while` with `else` and `break` values, control transfer inside operands,
// shadowing and mutation order, and function bodies that end in a value or a statement.

identity[T](x: T) = x

before() -> int
    print(1)
    1

after() -> int
    print(3)
    3

show(a: int, b: int, c: int) = print(a, b, c)

shadowing(x: int) -> int
    val y =
        val x = x + 1
        x
    x + y

label(n: int) = if n < 0 then "negative" elif n == 0 then "zero" else "positive"

choose(n: int) -> int
    if n > 0 then
        val answer = 42
        answer
    else
        0
    end if
end choose

choose_arm(n: int) = n match
    0 ->
        val base = 21
        base * 2
    else 0

block_result() -> int
    print("before")
    42

block_discard()
    print("before")
    42

block_infer() =
    print("before")
    42

block_generic[T](x: T) =
    print("id")
    x

block_match_then_value() -> int
    true match
        true -> print("yes")
        false -> print("no")
    42

block_return_match() -> int
    print("match")
    1 match
        1 -> 42
        else 0

emit()
    print("first")
    print("second")

main()
    val answer =
        val base = 21
        base * 2
    print(answer)
    print(shadowing(20))
    print(label(-1), label(0), label(1))
    print(choose(1))
    print(choose_arm(0))
    print(10 + if true then 32 else 1 / 0)

    // Loops: the body may be inline, `else` supplies the value of a loop that ends normally, and a
    // `break` carries the value of one that does not.
    var n = 0
    while n < 3
        print(n)
        n += 1
    end while
    var i = 0
    while i < 3 do i += 1
    print(i)
    var skipped = 0
    while skipped < 5 do
        skipped += 1
        if skipped == 3 then continue
        print(skipped)
    end while
    var j = 0
    val found = while j < 10 do
        j += 1
        if j == 3 then break j
    else -1
    print(found, j)
    var k = 0
    val finished = while k < 2 do k += 1
    else 42
    print(finished, k)
    var outer = 0
    var count = 0
    while outer < 3
        outer += 1
        var inner = 0
        while inner < 3
            inner += 1
            if inner == 2 then break
            count += 1
    print(outer, count)
    val never = while false do print("body")
    else 42
    print(never)
    val breaks_outer = while true do
        while false do print("body")
        else break 42
    else 0
    print(breaks_outer)
    var broken = 0
    while broken < 3
        broken += 1
        broken match
            2 -> break
            else print(broken)
    print(broken)
    // A branch whose value is dropped need not agree with the other.
    if true then 1 else false
    1 match
        1 -> true
        else 42
    print("done")

    // `break` inside an operand abandons the rest of the expression and of the call.
    val a = while true do
        if true then break 42 else break 0
    else 0
    val b = while true do
        val x: int = 1 + (break 42)
        print(x)
    else 0
    val c = while true do
        val x: bool = 0 < (break 42) < 3
        print(x)
    else 0
    val d = while true do
        val x: bool = true && (break 42)
        print(x)
    else 0
    val e = while true do
        val x: int = if false then 1 else break 42
        print(x)
    else 0
    val f = while true do
        (break 42) match
            else print(0)
    else 0
    val g = while true do
        show(before(), break 42, after())
    else 0
    print(a, b, c, d, e, f, g)

    // Mutation: the right side of a compound assignment may change the variable, a `var` in an inner
    // block shadows without changing the outer one.
    var m = 1
    m += (m := 10)
    print(m)
    var chain = 1
    print(0 < chain++ < 10, chain)
    print(100 < chain++ < ++chain, chain)
    var p = 0
    var q = 0
    print(p := q := 42, p, q)
    var shadowed = 1
    if true then
        var shadowed = shadowed + 1
        shadowed += 1
        print(shadowed)
    print(shadowed)
    var text = "before"
    text = "after"
    print(text)
    var shown = debug("before")
    shown = debug("after")
    print(shown)

    print(block_result())
    block_discard()
    print(block_infer())
    print(block_generic(42))
    print(block_match_then_value())
    print(block_return_match())
    emit()
