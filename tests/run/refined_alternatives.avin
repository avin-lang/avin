// expect: exit 0
// Alternatives over refined variants. Each alternative is tested at what its own patterns read back
// from the value, so `Pair(IntLit(3), _) | Pair(_, BoolLit(true))` looks into either part, and an
// alternative the instance cannot hold, `BoolLit(false)` at `Expr[int]`, matches nothing while the
// others still may: in a `match`, in a clause and in an `is` test, at every instance called.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  BoolLit(value: bool) -> Expr[bool]
  If(cond: Expr[bool], yes: Expr[T], no: Expr[T])
  Pair[A, B](first: Expr[A], second: Expr[B]) -> Expr[(A, B)]

kind[T](e: Expr[T]) -> string = e match
  Pair(IntLit(3), _) | Pair(_, BoolLit(true)) -> "special pair"
  Pair(_, _) -> "pair"
  IntLit(1) | BoolLit(false) -> "small"
  _ -> "other"

kindClauses[T](e: Expr[T]) -> string
kindClauses(Pair(IntLit(3), _) | Pair(_, BoolLit(true))) = "special pair"
kindClauses(IntLit(1) | BoolLit(false)) = "small"
kindClauses(_) = "other"

small[T](e: Expr[T]) -> bool = e is IntLit(0) | BoolLit(false) | If(_, IntLit(9) | BoolLit(true), _)

main()
  println(kind(Pair(IntLit(3), BoolLit(false))))
  println(kind(Pair(IntLit(4), BoolLit(true))))
  println(kind(Pair(IntLit(4), IntLit(5))))
  println(kind(Pair(BoolLit(true), IntLit(5))))
  println(kind(IntLit(1)))
  println(kind(BoolLit(false)))
  println(kind(BoolLit(true)))
  println(kind(If(BoolLit(true), IntLit(1), IntLit(2))))
  println(kindClauses(Pair(IntLit(3), IntLit(3))))
  println(kindClauses(Pair(Pair(IntLit(1), IntLit(2)), BoolLit(true))))
  println(kindClauses(IntLit(1)))
  println(kindClauses(IntLit(2)))
  println(small(IntLit(0)))
  println(small(BoolLit(false)))
  println(small(If(BoolLit(true), IntLit(9), IntLit(9))))
  println(small(If(BoolLit(true), BoolLit(true), BoolLit(false))))
  println(small(If(BoolLit(true), BoolLit(false), BoolLit(false))))
  println(small(Pair(IntLit(0), IntLit(0))))
