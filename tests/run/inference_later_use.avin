// expect: exit 0
// An unknown stays open until the end of the body, so a later use settles it: an assignment, an
// argument, an operator, a literal pattern, or a store from a local function or a lambda.

describe(o: Option[int]) -> string = o match
    Some(v) -> s"some $v"
    None -> "none"

// The largest of a few values, with nothing seen yet at the start.
largest(count: int) -> int
    var best = None
    var k = 0
    while k < count
        k += 1
        val i = (k * 7) % 5
        best = best match
            Some(b) if b >= i -> Some(b)
            _ -> Some(i)
    best.getOrElse(-1)

main()
    print(s"${largest(3)} ${largest(0)}")

    var later = None
    print(describe(later))
    later = Some(1)
    print(describe(later))

    val n = None
    print(s"${n.getOrElse(0) + 1}")

    // `k + 1` settles what the pattern binds before the assignment below does.
    var m = None
    m match
        Some(k) -> print(s"${k + 1}")
        None -> print("empty")
    m = Some(5)
    print(describe(m))

    var total = None
    var i = 0
    while i < 4
        i += 1
        total = total match
            Some(t) -> Some(t + i)
            None -> Some(i)
    print(describe(total))

    var seen = None
    record(x: int)
        seen = Some(x)
    record(4)
    val text = seen match
        Some(3) -> "three"
        Some(x) -> s"other $x"
        None -> "none"
    print(text)

    var last = None
    Some(9).foreach(x -> last = Some(x))
    print(describe(last))

    var first = None
    val small = first match
        Some(v) if v > 2 -> v
        _ -> 0
    first = Some(1)
    print(s"$small ${describe(first)}")
