// expect: exit 0
// `Result.toOption` is the value as an `Option`, the error dropped: the same as `ok`, for any value
// and error type, in a chain, through a generic function and as a method value.

data Shape
    Circle(r: int)
    Square(side: int)

class Box(val label: string)

parse(s: string) -> Result[int, string] = s.toIntOption().okOr(s"not a number: $s")

firstOk[T, E](rs: Vector[Result[T, E]]) -> Option[T] = rs.find(r -> r.isOk).flatMap(r -> r.toOption)

main()
    println(parse("42").toOption)
    println(parse("x").toOption)
    println(parse("").toOption)
    val ok: Result[unit, string] = Ok(())
    println(ok.toOption)
    val shape: Result[Shape, int] = Ok(Circle(2))
    println(shape.toOption)
    val failed: Result[Shape, int] = Err(7)
    println(failed.toOption)
    val box: Result[Box, string] = Ok(Box("b"))
    println(box.toOption.map(b -> b.label))
    val nested: Result[Option[int], string] = Ok(None)
    println(nested.toOption)
    val maxed: Result[long, string] = Ok(9223372036854775807)
    println(maxed.toOption)
    val unicode: Result[string, int] = Ok("żółw 🐢")
    println(unicode.toOption)
    // The same answer as `ok`, every time.
    for s in ["1", "-2147483648", "nope", "٣"]
        assert(parse(s).toOption == parse(s).ok)
    println(firstOk([parse("a"), parse("5"), parse("6")]))
    println(firstOk([parse("a")]))
    println(firstOk[int, string]([]))
    val convert: (Result[int, string]) -> Option[int] = r -> r.toOption
    println(["3", "z"].map(s -> convert(parse(s))))
    println(parse("8").toOption.getOrElse(0) + parse("y").toOption.getOrElse(0))
