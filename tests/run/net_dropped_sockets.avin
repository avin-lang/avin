// expect: exit 0
// A connection and a listener the program drops without closing give their descriptors back when
// the collector frees them. The program runs itself again limited to 64 descriptors, and the second
// run makes three hundred listeners, connections and accepted connections, a hundred of each, never
// closing one: had a dropped socket kept its descriptor, the run would have stopped at the limit.
import avin.net.{TcpListener, TcpStream}
import avin.process
import avin.process.{Command, Exited}

// One listener, a connection to it and the connection it accepts, each dropped unclosed. A failure
// is printed with the round it happened in.
round(i: int) -> bool
  val listener = TcpListener.bind("127.0.0.1", 0) match
    Ok(l) -> l
    Err(e) ->
      println(s"bind $i: $e")
      return false
  val client = TcpStream.connect("127.0.0.1", listener.port()) match
    Ok(c) -> c
    Err(e) ->
      println(s"connect $i: $e")
      return false
  listener.accept() match
    Ok(served) ->
      // Each end is still usable: the bytes written on one arrive on the other.
      client.writeText("x").isOk && served.read(1).map(b -> b.length) == Ok(1)
    Err(e) ->
      println(s"accept $i: $e")
      false

limited()
  for i in 0 ..< 100
    if !round(i) then process.exit(1)
  println("100 rounds")

main()
  if process.args() == ["limited"]
    limited()
    return
  // The limit is set by the shell, which then becomes this program.
  val ran = Command("/bin/sh", "-c", "ulimit -n 64 && exec \"$0\" limited", process.programName()).run()
  println(ran.map(s -> s.isSuccess))
