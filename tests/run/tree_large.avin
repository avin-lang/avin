// expect: exit 0
// env: AVIN_GC_STRESS=0
// Many entries through a `TreeMap` and a `TreeSet`: thousands of pseudo-random insertions and
// removals checked at every stage against a mutable map's sorted keys, with lookups, ranges and the
// nearest-key queries agreeing; and 200,000 keys inserted in ascending order and removed in
// descending order, which only a tree kept balanced does without a path as long as the map.

import avin.collections.mutable.{Map as MutableMap}

// The next of a fixed sequence of pseudo-random numbers below 2^31.
next(seed: long) -> long = (seed * 1103515245 + 12345) % 2147483648

// The reference's keys, sorted, and its values in the same order.
sortedEntries(reference: MutableMap[int, int]) -> Vector[(int, int)] =
    reference.keys.sorted().map(k -> (k, reference(k)))

// Whether `tree` holds exactly the entries of `reference`, in ascending order of key.
agrees(tree: TreeMap[int, int], reference: MutableMap[int, int]) -> bool =
    tree.size == reference.size && tree.iterator().toVector == sortedEntries(reference)

main()
    var tree = TreeMap.empty[int, int]()
    var set = TreeSet.empty[int]()
    val reference = MutableMap[int, int]()
    var seed: long = 2026
    var mismatches = 0
    for round in 0..<20
        for i in 0..<400
            seed = next(seed)
            val key = int((seed / 65536) % 1000)
            seed = next(seed)
            if seed % 3 == 0
                tree = tree.removed(key)
                set = set.excl(key)
                reference.remove(key)
            else
                tree = tree.updated(key, i)
                set = set.incl(key)
                reference(key) = i
        if !agrees(tree, reference) then mismatches += 1
        if set.iterator().toVector != reference.keys.sorted() then mismatches += 1
        val entries = sortedEntries(reference)
        for probe in [-1, 0, 250, 499, 500, 777, 999, 1000]
            if tree.get(probe) != reference.get(probe) then mismatches += 1
            val below = entries.filter(e -> e.0 < probe)
            val upTo = entries.filter(e -> e.0 <= probe)
            val above = entries.filter(e -> e.0 >= probe)
            if tree.maxBefore(probe) != below.lastOption then mismatches += 1
            if tree.minAfter(probe) != above.headOption then mismatches += 1
            if tree.rangeFrom(probe).iterator().toVector != above then mismatches += 1
            if tree.iteratorFrom(probe).toVector != above then mismatches += 1
            if tree.rangeUntil(probe).iterator().toVector != below then mismatches += 1
            if tree.rangeTo(probe).iterator().toVector != upTo then mismatches += 1
            if set.rangeUntil(probe).size != below.length then mismatches += 1
            if set.rangeTo(probe).size != upTo.length then mismatches += 1
            if set.maxBefore(probe) != below.lastOption.map(e -> e.0) then mismatches += 1
        val window = tree.range(200, 600)
        if window.iterator().toVector != entries.filter(e -> 200 <= e.0 < 600) then mismatches += 1
        if tree.filter((k, v) -> k % 2 == 0).keys != entries.map(e -> e.0).filter(k -> k % 2 == 0)
            mismatches += 1
        if tree.headOption != entries.headOption || tree.lastOption != entries.lastOption then mismatches += 1
        if tree.reverseIterator().toVector != entries.reverse then mismatches += 1
    println(s"${tree.size} ${set.size} $mismatches")

    val n = 200000
    var ascending = TreeMap.empty[int, int]()
    for i in 0..<n do ascending = ascending.updated(i, i * 2)
    var sum: long = 0
    for i in 0..<n do sum += long(ascending(i))
    println(s"${ascending.size} $sum ${ascending.headOption} ${ascending.lastOption}")
    println(s"${ascending.range(1000, 1005)} ${ascending.rangeFrom(n - 2)} ${ascending.rangeUntil(2)}")
    var count = 0
    var previous = -1
    var ordered = true
    for (k, v) in ascending
        if k <= previous then ordered = false
        previous = k
        count += 1
    println(s"$count $ordered")
    val half = ascending.filter((k, v) -> k % 2 == 0)
    println(s"${half.size} ${half.get(4)} ${half.get(5)}")
    var shrinking = ascending
    var i = n - 1
    while i >= 0
        shrinking = shrinking.removed(i)
        i -= 1
    println(s"${shrinking.size} ${shrinking.isEmpty} ${ascending.size}")
