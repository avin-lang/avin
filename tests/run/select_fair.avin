// expect: exit 0
// Of several arms ready at once, a `select` chooses each as often as any other: over 6000 selects of
// two always-ready arms each runs about half the time, and of three arms about a third, two of them on
// one channel. The bounds are many standard deviations wide, so the test does not flake, and a select
// that favoured the first arm written, or the last, fails it. Arms of every kind are counted: two
// receive arms, a receive and a send, and a `None` arm beside a value arm of one closed channel
// that still holds values, where only the value arm is ready.
import avin.threads.Channel

within(count: int, total: int, ways: int) -> bool
  val expected = total / ways
  expected * 85 / 100 <= count <= expected * 115 / 100

main() -> int
  val total = 6000
  val a = Channel[int]()
  val b = Channel[int]()
  var firsts = 0
  for i in 0 ..< total
    a.send(i)
    b.send(i)
    select
      a.receive() as Some(_) -> firsts++
      b.receive() as Some(_) -> ()
    // Whichever arm did not run leaves its value; take it back so both are ready again.
    a.tryReceive()
    b.tryReceive()
  println(within(firsts, total, 2), within(total - firsts, total, 2))

  // Three arms, two of them on one channel.
  var counts = [0, 0, 0]
  for i in 0 ..< total
    a.send(i)
    b.send(i)
    val k = select
      a.receive() as Some(_) -> 0
      a.receive() as o -> 1
      b.receive() -> 2
    counts = counts.updated(k, counts(k) + 1)
    a.tryReceive()
    b.tryReceive()
  println(counts.forall(c -> within(c, total, 3)))

  // A receive and a send, both always ready.
  val sink = Channel[int]()
  var sends = 0
  for i in 0 ..< total
    a.send(i)
    select
      a.receive() -> ()
      sink.send(i) -> sends++
    a.tryReceive()
    sink.tryReceive()
  println(within(sends, total, 2))

  // With `else` too: the `else` never runs while an arm is ready.
  var elses = 0
  firsts = 0
  for i in 0 ..< total
    a.send(i)
    b.send(i)
    select
      a.receive() -> firsts++
      b.receive() -> ()
      else elses++
    a.tryReceive()
    b.tryReceive()
  println(within(firsts, total, 2), elses)

  // A closed channel holding values: only the value arm is ready, every time.
  val held = Channel[int]()
  for i in 0 ..< 100 do held.send(i)
  held.close()
  var values = 0
  for i in 0 ..< 100
    select
      held.receive() as None -> ()
      held.receive() as Some(_) -> values++
  println(values)
  0
