// expect: exit 0
// `compareAndSet` on a value without identity compares with `==`: an `Option`, a tuple, a string and a
// data value match an equal value made separately, and fail on a different one. A class instance
// keeps identity, even where its class derives `Eq`; a scalar compares as itself. Eight threads then
// add to a counter held in a data value through a compare-and-set loop while every allocation
// collects, and the total is exact.
import avin.threads.{Atomic, scope}

class Cell(val n: int) derives Eq, Hash

data Count(total: int, rounds: int)

numberOf(c: Option[Cell]) -> int = c match
    Some(cell) -> cell.n
    None -> -1

main() -> int
    val cell = Cell(7)
    val opt = Atomic(Some(cell))
    print(opt.compareAndSet(Some(Cell(7)), Some(Cell(8))))
    print(numberOf(opt.load()))
    print(opt.compareAndSet(Some(Cell(9)), Some(Cell(10))))
    print(numberOf(opt.load()))
    val none: Atomic[Option[Cell]] = Atomic(None)
    print(none.compareAndSet(Some(cell), None))
    print(none.compareAndSet(None, Some(cell)))

    val pair = Atomic((1, "one"))
    print(pair.compareAndSet((1, "o" + "ne"), (2, "two")))
    print(pair.compareAndSet((1, "one"), (3, "three")))
    print(pair.load().0)
    print(pair.load().1)

    val word = Atomic("alpha")
    print(word.compareAndSet("al" + "pha", "beta"))
    print(word.compareAndSet("alpha", "gamma"))
    print(word.load())

    val point = Atomic(Count(1, 2))
    print(point.compareAndSet(Count(1, 1 + 1), Count(5, 6)))
    print(point.compareAndSet(Count(1, 2), Count(7, 8)))
    print(point.load().total)

    val first = Cell(1)
    val twin = Cell(1)
    val held = Atomic(first)
    print(held.compareAndSet(twin, Cell(2)))
    print(held.compareAndSet(first, twin))
    print(held.load() === twin)

    val number = Atomic(5)
    print(number.compareAndSet(4, 6))
    print(number.compareAndSet(5, 6))

    val counter = Atomic(Count(0, 0))
    scope(s ->
        for t in 0..<8
            s.spawn(() ->
                for i in 0..<250
                    loop
                        val seen = counter.load()
                        if counter.compareAndSet(seen, Count(seen.total + t + 1, seen.rounds + 1)) then break))
    val done = counter.load()
    print(done.total)
    print(done.rounds)
    val updated = counter.update(c -> Count(c.total, c.rounds + 1))
    print(updated.rounds)
    if done.total == 9000 && done.rounds == 2000 then 0 else 1
