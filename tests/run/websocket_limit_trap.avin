// expect: trap
// `webSocket` answers a request without a connection, so a handler is tried as it is: a handshake is
// a `101` carrying its accept key, one that is not is answered with its status, and a message limit
// of zero is taken while a negative one traps.
import avin.net.http.{ServerRequest, webSocket}

handshake(headers: Vector[(string, string)]) -> ServerRequest = ServerRequest("GET", "/chat", headers)

main()
  val good = [
    ("Upgrade", "websocket"),
    ("Connection", "Upgrade"),
    ("Sec-WebSocket-Key", "dGhlIHNhbXBsZSBub25jZQ=="),
    ("Sec-WebSocket-Version", "13"),
    ("Sec-WebSocket-Protocol", "chat, superchat")
  ]
  val r = webSocket(handshake(good), _ -> (), protocols = ["superchat"], maxMessageBytes = 0)
  println(s"${r.status} ${r.headers} ${r.upgraded.isDefined}")
  val plain = webSocket(ServerRequest("GET", "/chat"), _ -> ())
  println(s"${plain.status} ${plain.header("Upgrade")} ${plain.upgraded.isDefined} ${plain.text}")
  _ = webSocket(handshake(good), _ -> (), maxMessageBytes = -1)
