// expect: trap
// A decoder's read asks for at least one byte; a read of none traps.
import avin.compress.{Decoder, gzip}
import avin.io.{IoError, Reader}

class Once(private val bytes: Array[byte]): Reader
  private var given = false
  override read(max: int) -> Result[Array[byte], IoError]
    if given then return Ok(Array.empty[byte]())
    given = true
    Ok(bytes)

main()
  val d = Decoder(Once(gzip("abc".utf8)))
  println(d.read(1).map(b -> b.length))
  println(d.read(0).isOk)
