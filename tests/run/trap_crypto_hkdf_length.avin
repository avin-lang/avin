// expect: trap
// HKDF makes at most 255 digests' worth of key: 8160 bytes over SHA-256 is the last length it makes,
// and one more traps, as asking for none does.
import avin.crypto.hkdfSha256

main()
  println(hkdfSha256("k".bytes, Vector(), Vector(), 8160).length)
  println(hkdfSha256("k".bytes, Vector(), Vector(), 8161).length)
