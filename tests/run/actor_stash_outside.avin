// expect: trap
// A stash is part of an actor's state, made by the actor's own code from its own reference: made
// anywhere else, here in `main` from a reference it holds, it traps.
import avin.actors.{Stash, spawn}

data Msg
  Ping

actor Quiet receives Msg
  receive
    Ping -> ()

main()
  val q = spawn(Quiet())
  println("before")
  Stash(q, 4)
  println("not reached")
