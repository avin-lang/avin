// expect: exit 0
// A trait type may implement a trait whose members are all static, as its own conformance: `Bag[A]`
// is made by `Bag[A].make`, on the type or through a bound whose argument is `Bag[A]` itself. A type
// implementing `Bag` does not get it: `ListBag` states its own, and its own is the one called for it.

trait Make[A]
  static make(x: A) -> Self

trait MakeTwo[A]: Make[A]
  static two(x: A, y: A) -> Self

trait Bag[A]
  first -> A
  size -> int

class OneBag[A](val a: A): Bag[A]
  override first -> A = a
  override size -> int = 1

class ListBag[A](val items: Vector[A]): Bag[A]
  override first -> A = items.head
  override size -> int = items.length

impl[A] Make[A] for Bag[A]
  static make(x: A) -> Bag[A] = OneBag(x)

impl[A] Make[A] for ListBag[A]
  static make(x: A) -> ListBag[A] = ListBag([x, x, x])

// A covariant trait type's own conformance, with a trait requiring another.
trait Source[+A]
  next() -> A

class Repeat[+A](val value: A): Source[A]
  override next() -> A = value

impl[A] MakeTwo[A] for Source[A]
  static make(x: A) -> Source[A] = Repeat(x)
  static two(x: A, y: A) -> Source[A] = Repeat(y)

build[C: Make[A], A](x: A) -> C = C.make(x)

buildTwo[C: MakeTwo[A], A](x: A, y: A) -> C = C.two(x, y)

// Passed on through a second bound, the argument is still `Bag[A]` itself.
relay[C: Make[A], A](x: A) -> C = build[C, A](x)

main()
  // On the trait type.
  println(Bag[int].make(1).size)
  println(Bag[string].make("x").first)
  // Through a bound whose argument is the trait type.
  println(build[Bag[int], int](2).size)
  println(relay[Bag[string], string]("relayed").first)
  // The implementer's own conformance, not the trait type's.
  println(build[ListBag[int], int](3).size)
  println(ListBag[int].make(4).size)
  val seen: Bag[int] = build[ListBag[int], int](5)
  println(seen.size)
  // Nested.
  val nested = build[Bag[Bag[int]], Bag[int]](Bag[int].make(6))
  println(nested.first.first)
  // A covariant trait type, and a required trait's member.
  println(build[Source[string], string]("s").next())
  println(buildTwo[Source[int], int](8, 9).next())
  val wide: Source[Any] = Source[string].make("wide")
  println(wide.next())
  // Boundary values.
  println(Bag[string].make("").first.isEmpty)
  println(Bag[string].make("ünïcödé ✓").first)
