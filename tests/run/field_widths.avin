// expect: exit 0
// Fields, array elements, captured vars and module-level values of every width keep their values:
// a bool, integers narrower than a byte and between the power-of-two widths, negative ones, and
// integers wider than a word, each stored and read back.

class Cell(var flag: bool, var tiny: i5, var odd: i24, var mid: i48, var wide: i128, var huge: i257)

data Pair(low: i65, high: i130)

var moduleWide: i200 = -12345678901234567890123456789
var moduleTiny: i3 = -2
var moduleFlag = false

main()
  val c = Cell(true, -16, -8388608, -140737488355328, -170141183460469231731687303715884105728, 1)
  println(s"${c.flag} ${c.tiny} ${c.odd} ${c.mid} ${c.wide} ${c.huge}")
  c.flag = !c.flag
  c.tiny = 15
  c.odd = 8388607
  c.mid = 140737488355327
  c.wide = 170141183460469231731687303715884105727
  c.huge = c.huge << 255
  println(s"${c.flag} ${c.tiny} ${c.odd} ${c.mid} ${c.wide} ${c.huge}")
  c.huge = -c.huge
  println(s"${c.huge}")

  val p = Pair(-1, 680564733841876926926749214863536422911)
  println(s"${p.low} ${p.high} ${p == Pair(-1, 680564733841876926926749214863536422911)}")

  println(s"$moduleWide $moduleTiny $moduleFlag")
  moduleWide = moduleWide * 1000000
  moduleTiny = 3
  moduleFlag = true
  println(s"$moduleWide $moduleTiny $moduleFlag")

  val tinies = Array.fill(3, i5(-7))
  tinies(1) = 9
  val flags = Array.fill(2, false)
  flags(1) = true
  val wides = Array.fill(2, i128(-1))
  wides(0) = 1 << 100
  println(s"${tinies(0)} ${tinies(1)} ${flags(0)} ${flags(1)} ${wides(0)} ${wides(1)}")

  var captured: i100 = -5
  val bump = () -> captured = captured * 1000000000000000000000
  bump()
  println(s"$captured")
