// expect: exit 0
// `Map`, `Set` and `List` are data types with companion objects: `empty` and `builder` take their
// type arguments as written or from the expected type, and a sequence literal where a `Set` is
// expected is built through `Set.builder`, as one where a `List` is expected still builds the list.

// A user collection over a data type, written as a literal through its companion's builder.
data Bag(items: List[int])

object Bag
    builder() -> BagBuilder = BagBuilder()

class BagBuilder: Builder[int, Bag]
    private var items: List[int] = Nil

    override add(element: int)
        items = element :: items

    override result() -> Bag = Bag(items)

main()
    val none = Map.empty[string, int]()
    print(none)
    print(none.isEmpty())
    val typed: Map[int, string] = Map.empty()
    print(typed.updated(1, "one"))

    val mb = Map.builder[string, int]()
    mb.add(("a", 1))
    mb.add(("b", 2))
    mb.add(("a", 3))
    val m = mb.result()
    print(s"${m.size()} ${m("a")} ${m("b")}")

    print(Set.empty[int]().added(4))
    val sb = Set.builder[char]()
    for ch in ['h', 'e', 'l', 'l', 'o']
        sb.add(ch)
    print(sb.result().size())

    val lb = List.builder[int]()
    for i in 1..5
        lb.add(i * i)
    print(lb.result())
    print(List.empty[string]().isEmpty())
    val lt: List[int] = List.empty()
    print(lt.length())

    val s: Set[int] = [3, 1, 3, 2, 1]
    print(s.size())
    print(s == Set.empty[int]().added(1).added(2).added(3))
    val pairs: Map[string, int] = [("x", 1), ("y", 2)]
    print(pairs("y"))
    val xs: List[string] = ["a", "b"]
    print(xs)
    val bag: Bag = [1, 2, 3]
    print(bag.items)

    // The variant of the type's name is still the constructor.
    print(Map[string, int]().isEmpty())
