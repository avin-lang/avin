// expect: exit 0
// `Map`, `Set` and `List` are data types with companion objects: `empty` and `newBuilder` take their
// type arguments as written or from the expected type, and a set literal where a `Set` is expected is
// built through `Set.newBuilder`, as a sequence literal where a `List` is expected still builds the
// list.

// A user collection over a data type, written as a literal through its companion's builder.
data Bag(items: List[int])

object Bag
    newBuilder() -> BagBuilder = BagBuilder()

class BagBuilder: Builder[int, Bag]
    private var items: List[int] = Nil

    override addOne(element: int)
        items = element :: items

    override result() -> Bag = Bag(items)

main()
    val none = Map.empty[string, int]()
    println(none)
    println(none.isEmpty())
    val typed: Map[int, string] = Map.empty()
    println(typed.updated(1, "one"))

    val mb = Map.newBuilder[string, int]()
    mb.addOne(("a", 1))
    mb.addOne(("b", 2))
    mb.addOne(("a", 3))
    val m = mb.result()
    println(s"${m.size()} ${m("a")} ${m("b")}")

    println(Set.empty[int]().incl(4))
    val sb = Set.newBuilder[char]()
    for ch in ['h', 'e', 'l', 'l', 'o']
        sb.addOne(ch)
    println(sb.result().size())

    val lb = List.newBuilder[int]()
    for i in 1..5
        lb.addOne(i * i)
    println(lb.result())
    println(List.empty[string]().isEmpty())
    val lt: List[int] = List.empty()
    println(lt.length())

    val s: Set[int] = {3, 1, 3, 2, 1}
    println(s.size())
    println(s == Set.empty[int]().incl(1).incl(2).incl(3))
    val pairs: Map[string, int] = {x: 1, y: 2}
    println(pairs("y"))
    val xs: List[string] = ["a", "b"]
    println(xs)
    val bag: Bag = [1, 2, 3]
    println(bag.items)

    // The variant of the type's name is still the constructor.
    println(Map[string, int]().isEmpty())
