// expect: exit 0
// The views `withFilter` makes, which a guard of a `for` with `yield` calls on a collection, are
// `Iterable`s: each may be held as one, looped over, folded and passed where an `Iterable` is
// wanted, and its elements are tested as they are reached, so a view of nothing and a view that
// keeps nothing are empty.
import avin.collections.mutable.{
  BitSet,
  LinkedMap,
  LinkedSet,
  Map as MutableMap,
  Set as MutableSet,
  TreeMap as MutableTreeMap,
  TreeSet as MutableTreeSet
}

total(xs: Iterable[int]) -> int = xs.foldLeft(0, (a, x) -> a + x)

keys[K, V](xs: Iterable[(K, V)]) -> Vector[K] = xs.map(match (k, _) -> k).toVector

even(x: int) -> bool = x % 2 == 0

counted(seen: Buffer[int], x: int, result: bool) -> bool
  seen.append(x)
  result

main()
  val list: List[int] = [1, 2, 3, 4]
  val vector = [1, 2, 3, 4, 5, 6]
  val array: Array[int] = [1, 2, 3, 4]
  val buffer: Buffer[int] = [2, 3, 4]
  val deque: Deque[int] = [4, 5, 6]
  val seq: Seq[int] = [6, 7, 8]
  val arraySeq = ArraySeq.fill(3, 2)
  val set: Set[int] = {1, 2, 3, 4}
  val treeSet: TreeSet[int] = {4, 1, 3, 2}
  println(total(list.withFilter(even)))
  println(total(vector.withFilter(even)))
  println(total(array.withFilter(even)))
  println(total(buffer.withFilter(even)))
  println(total(deque.withFilter(even)))
  println(total(seq.withFilter(even)))
  println(total(arraySeq.withFilter(even)))
  println(total(set.withFilter(even)))
  println(treeSet.withFilter(even).toVector)

  // A view held as an `Iterable`, looped over, and filtered again.
  val view: Iterable[int] = list.withFilter(x -> x > 1).withFilter(even)
  for x in view do println(x)
  println(view.toList)
  println(view.size)

  // Tested as reached: the test runs once for each element the loop takes.
  val tested = Buffer[int]()
  for x in vector.withFilter(x -> counted(tested, x, x > 2))
    if x == 4 then break
  println(tested.toVector)

  // Empty sources, and a test that keeps nothing.
  val empty: List[int] = []
  println(empty.withFilter(even).isEmpty)
  println(list.withFilter(x -> x > 100).toVector)
  println(total(Vector[int]().withFilter(even)))

  // Maps, sorted and mutable, give their entries as pairs.
  val map = {"a": 1, "b": 2}
  println(keys(map.withFilter(match (_, v) -> v > 1)))
  val treeMap: TreeMap[int, string] = {3: "c", 1: "a", 2: "b"}
  println(keys(treeMap.withFilter(match (k, _) -> k != 2)))
  val linkedMap: LinkedMap[string, int] = {"z": 1, "y": 2}
  println(keys(linkedMap.withFilter(match (_, v) -> v > 0)))
  val mutableMap: MutableMap[string, int] = {"k": 5}
  println(keys(mutableMap.withFilter(match (_, v) -> v == 5)))
  val mutableTreeMap: MutableTreeMap[int, string] = {9: "n", 8: "e"}
  println(keys(mutableTreeMap.withFilter(match (k, _) -> k > 0)))

  // The mutable sets and the bit set.
  val bits: BitSet = {3, 4, 10}
  println(total(bits.withFilter(even)))
  val linkedSet: LinkedSet[int] = {8, 7}
  println(linkedSet.withFilter(x -> x > 0).toVector)
  val mutableSet: MutableSet[int] = {6}
  println(total(mutableSet.withFilter(even)))
  val mutableTreeSet: MutableTreeSet[int] = {2, 1}
  println(mutableTreeSet.withFilter(x -> x < 5).toVector)

  // A comprehension's guarded calls still give the collection's own result.
  val guarded = for x in list if even(x) yield x * 10
  println(guarded)
