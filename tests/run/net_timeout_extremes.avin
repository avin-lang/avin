// expect: exit 0
// A connection's timeout at the ends of the durations there are: the longest, one short of it and a
// microsecond short of a whole millisecond round up without overflowing, and the shortest takes the
// limit away, on a TCP connection and a Unix one, in `main` and in a thread. Under a limit that does
// not run out, a read waits for the bytes the other end sends late.
import avin.fs
import avin.io.IoError
import avin.net.{TcpListener, TcpStream, UnixListener, UnixStream}
import avin.threads.{sleep, spawn}
import avin.time.{Duration, millis}

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message)

limits() -> Vector[Duration] = [Duration.Max, Duration(long.MaxValue - 1), Duration(999), Duration.Min, Duration.Zero]

main()
    val l = ok(TcpListener.bind("127.0.0.1", 0))
    val c = ok(TcpStream.connect("127.0.0.1", l.port()))
    val s = ok(l.accept())
    println(limits().map(d -> s.setTimeout(d).isOk))
    ok(s.setTimeout(Duration.Max))
    val late = spawn(() ->
        sleep(millis(30))
        ok(c.writeText("x")))
    println(s"tcp in main: ${ok(s.read(1)).length}")
    late.join()

    val dir = ok(fs.createTempDir("avto"))
    val path = dir + "/s"
    val u = ok(UnixListener.bind(path))
    val uc = ok(UnixStream.connect(path))
    val us = ok(u.accept())
    println(limits().map(d -> us.setTimeout(d).isOk))
    ok(us.setTimeout(Duration(long.MaxValue - 1)))
    val reader = spawn(() -> ok(us.read(1)).length)
    sleep(millis(30))
    ok(uc.writeText("y"))
    println(s"unix in a thread: ${reader.join()}")
    u.close()
    ok(fs.remove(path))
    ok(fs.removeDir(dir))
