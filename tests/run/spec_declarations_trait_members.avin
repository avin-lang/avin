// expect: exit 0
// Spec probes for declarations, trait Fields and Static members: a generic trait's var field through
// the trait, a subclass storing its superclass's trait fields once, a bound assigning a trait field, a
// trait field supplying another trait's val, an object with trait fields, static members with
// defaults through a bound on data, an open class and an abstract class, and statics as values.
trait Log
    var entries: Vector[string] = []
    record(s: string) = entries = entries :+ s

trait Box[T]
    var held: Option[T] = None

trait Named
    val name: string

trait Labelled
    val name: string = "from-trait"

class Ints: Box[int], Log

open class Root: Log
class Leaf: Root

class Tag: Labelled, Named

object Registry: Log

remember[T: Log](x: T, s: string) -> int
    x.entries = x.entries :+ s
    x.entries.length()

trait Zero
    static zero() -> Self
    static scaled(n: int = 2) -> Self
    plus(other: Self) -> Self

data Pt(x: int, y: int)
impl Zero for Pt
    static zero() -> Pt = Pt(0, 0)
    static scaled(n: int) -> Pt = Pt(n, n)
    plus(other: Pt) -> Pt = Pt(x + other.x, y + other.y)

open class Num(val v: int): Zero
    override static zero() -> Num = Num(0)
    override static scaled(n: int) -> Num = Num(n * 100)
    override plus(other: Num) -> Num = Num(v + other.v)

abstract class Abs: Zero
    override static zero() -> Abs = Concrete()
    override static scaled(n: int) -> Abs = Concrete()
    override plus(other: Abs) -> Abs = self

class Concrete: Abs

sum[T: Zero](items: Vector[T]) -> T
    var acc = T.zero()
    for x in items do acc = acc.plus(x)
    acc.plus(T.scaled())

impl int
    static parity(n: int) -> string = if n % 2 == 0 then "even" else "odd"
    static parity(s: string) -> string = s"parity of $s"

main()
    val i = Ints()
    val b: Box[int] = i
    b.held = Some(4)
    println(s"${i.held} ${b.held.getOrElse(0)}")
    val leaf = Leaf()
    val lg: Log = leaf
    lg.record("a")
    leaf.record("b")
    println(s"${leaf.entries} ${remember(leaf, "c")} ${lg.entries.length()}")
    val n: Named = Tag()
    println(n.name)
    Registry.record("r")
    println(Registry.entries)
    println(s"${sum([Pt(1, 2), Pt(3, 4)])} ${sum([Num(1), Num(2)]).v} ${sum([Pt(1, 1)]).x}")
    val mk = Pt.zero
    val sc: (int) -> Pt = Pt.scaled
    println(s"${mk()} ${sc(7)} ${Pt.scaled()} ${Num.scaled(n = 3).v}")
    val par: (int) -> string = int.parity
    println(s"${[1, 2, 3].map(int.parity)} ${par(4)} ${int.parity("x")}")
    println(s"${Abs.zero() is Concrete}")
