// expect: exit 0
// `size()` and `length()` on an iterator count the elements remaining and use the iterator up: it has
// no element left afterwards and a second count is 0. They count from where the iterator stands, and
// they work on the iterators made from other iterators, a range's, a string's and each collection's.
class Ticks(private var n: int): Iterator[int]
    override hasNext() -> bool = n > 0
    override next() -> int
        n -= 1
        n + 1

main()
    // empty, one, many
    val empty = Vector.empty[int]().iterator()
    println(s"${empty.size} ${empty.hasNext()}")
    val one = [7].iterator()
    println(s"${one.size} ${one.hasNext()} ${one.size}")
    val many = (1 .. 1000).iterator()
    println(s"${many.length} ${many.hasNext()} ${many.length} ${many.size}")
    println(Ticks(0).size)
    println(Ticks(5).size)
    println(Ticks(5).length)

    // after partial consumption
    val it = [10, 20, 30, 40, 50].iterator()
    println(it.next())
    println(it.next())
    println(it.size)
    println(it.hasNext())
    val last = [1, 2, 3].iterator()
    last.next()
    last.next()
    last.next()
    println(s"${last.size} ${last.length}")
    val mid = Ticks(6)
    mid.next()
    println(s"${mid.length} ${mid.size}")

    // iterators made from iterators
    println([1, 2, 3, 4, 5, 6].iterator().map(x -> x * 2).size)
    println([1, 2, 3, 4, 5, 6].iterator().filter(x -> x % 2 == 0).size)
    println([1, 2, 3, 4, 5, 6].iterator().filter(x -> x > 10).size)
    println([1, 2, 3, 4, 5, 6].iterator().take(4).size)
    println([1, 2, 3].iterator().take(10).size)
    println([1, 2, 3].iterator().take(0).size)
    println([1, 2, 3, 4, 5, 6].iterator().drop(2).size)
    println([1, 2, 3].iterator().drop(10).size)
    println([1, 2, 3].iterator().drop(0).length)
    println([1, 2, 3, 4].iterator().takeWhile(x -> x < 3).size)
    println([1, 2, 3, 4].iterator().dropWhile(x -> x < 3).size)
    println([1, 2, 3].iterator().zip(["a", "b"]).size)
    println([1, 2, 3].iterator().zip(["a", "b", "c", "d"]).size)
    println([1, 2, 3].iterator().zipWithIndex.size)
    println([1, 2, 3].iterator().flatMap(x -> [x, x]).size)
    println([1, 2, 3].iterator().flatMap(x -> Vector.empty[int]()).size)
    println([1, 2, 3, 4].iterator().collect(match
        x if x % 2 == 0 -> x).size)
    println([1, 2, 3, 4, 5, 6, 7, 8].iterator().filter(x -> x % 2 == 0).map(x -> x + 1).drop(1).take(2).size)

    // the source is read to its end, calling the function for each element
    var calls = 0
    val counted = [1, 2, 3, 4].iterator().map(x ->
        calls += 1
        x)
    println(s"${counted.size} $calls ${counted.size} $calls")

    // a range's iterator, a string's, each collection's
    println((1 .. 5).iterator().size)
    println((1 ..< 5).iterator().length)
    println((5 .. 1).iterator().size)
    println("hello".chars.iterator().size)
    println("".chars.iterator().size)
    println([1, 2, 3].iterator().size)
    println([1, 2, 3].toList.iterator().size)
    println(Array.tabulate(4, i -> i).iterator().size)
    println([1, 2, 2, 3].toSet.iterator().size)
    println([1, 2, 3].view().size)
    println((1 .. 10).view().filter(x -> x % 3 == 0).size)

    // the collection's own length does not use it up, and each iterator() is fresh
    val v = [1, 2, 3]
    println(s"${v.length} ${v.iterator().size} ${v.length} ${v.iterator().size}")
    val s = [1, 2, 3].toSet
    println(s"${s.size} ${s.iterator().size} ${s.size}")
