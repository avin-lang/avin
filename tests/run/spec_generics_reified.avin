// expect: exit 0
// Reified generics: a type pattern on an Any checks the exact type arguments, through variance for
// references (a List[Dog] is a List[Animal], a List[string] a List[Any]) and not for an int; a function
// value matches a function type it is a subtype of, and a Vector[int] is an (int) -> int; generic code
// makes an Array[T]; nested Option instances are told apart; and an Integer bound converts at each
// width, from i8 to i128.

open class Animal(val name: string)

class Dog(name: string): Animal(name)

lists(x: Any) -> string = x match
  _: List[Animal] -> "animals"
  _: List[Any] -> "anys"
  _: List[int] -> "ints"
  _ -> "other"

fns(x: Any) -> string = x match
  f: ((Dog) -> Animal) -> s"dog to animal ${f(Dog("d")).name}"
  f: ((int) -> int) -> s"int to int ${f(1)}"
  _ -> "other"

filled[T](n: int, x: T) -> Array[T]
  val a = Array.fill(n, x)
  a

opts(x: Any) -> string = x match
  _: Option[Option[int]] -> "nested int option"
  _: Option[int] -> "int option"
  _ -> "other"

digits[T: Integer](x: T) -> int
  var n = 1
  var rest = x / T(10)
  while rest != T(0)
    rest = rest / T(10)
    n += 1
  n

main()
  val dogs: List[Dog] = [Dog("a")]
  val ints: List[int] = [1, 2]
  println(s"${lists(dogs)} ${lists(ints)} ${lists(List[string]("s"))} ${lists(Nil)}")
  val g: (Animal) -> Dog = a -> Dog(a.name + "!")
  println(fns(g))
  val v: Vector[int] = [5, 6]
  println(fns(v))
  println(fns((n: int) -> n * 3))
  println(fns("s"))
  println(filled(3, "x").toVector)
  println(filled(2, Dog("p")).length)
  println(filled(0, 1.5).length)
  println(s"${opts(Some(Some(1)))} ${opts(Some(2))} ${opts(Some("s"))}")
  val big: i128 = 123456789012345678901234567890
  println(s"${digits(7)} ${digits(-1234)} ${digits(big)} ${digits(i8(-128))} ${digits(long.MinValue)}")
