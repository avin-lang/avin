// expect: exit 0
// Text blocks: `"""` on a line of its own, the content on the lines after it, the incidental
// indentation and each line's trailing blanks dropped, and the closing delimiter's place deciding
// both the strip and whether the value ends with a line break.

show(label: string, text: string)
    println(s"$label: [${text.replace("\n", "|")}] ${text.byteLength}")

plain() -> string
    """
    one
      two
    three
    """

// The closing delimiter further left keeps more of each line's indentation.
wider() -> string = """
        one
          two
      """

// A delimiter after content leaves the value without a final line break.
noFinalBreak() -> string = """
    last line"""

// Blank lines, and lines of blanks only, say nothing about the strip and keep their breaks.
withBlankLines() -> string = """
    a

        b

    c
    """

// Tabs and spaces each count as one column of indentation.
mixed() -> string = """
	x
	  y
	"""

// Escapes are read after the trimming, so a trailing `\u{20}` is a blank that stays.
escapes() -> string = """
    tab\there
    quote \" and \\ backslash
    kept\u{20}
    unicode \u{e9}
    """

// A lone quote, and two together, are text.
quotes() -> string = """
    she said "hi" and ""
    an escaped \""" does not close it
    ends with a quote\""""

// A `\` at a line's end joins it to the next; the blanks before it go with the line's end.
joined() -> string = """
    dead\
    beef  \
    cafe
    """

// A block with no content lines is empty.
empty() -> string = """
    """

main()
    show("plain", plain())
    show("wider", wider())
    show("noFinalBreak", noFinalBreak())
    show("withBlankLines", withBlankLines())
    show("mixed", mixed())
    show("escapes", escapes())
    show("quotes", quotes())
    show("joined", joined())
    show("empty", empty())
    val nested = if plain().byteLength > 0
        """
        inside an if
        """
    else
        ""
    show("nested", nested)
    show("argument", [
        """
        one
        """,
        "two"
    ].mkString(","))
