// expect: exit 0
// A raw string has no escape processing: a backslash is an ordinary character, so a path or a
// pattern is written as it reads. A backslash and a quote or backslash after it are one pair, so
// `raw"a\"b"` holds the four characters a, backslash, quote, b and `raw"a\\"` ends after two backslashes.
// `$"` is a double quote and `$$` a dollar sign in every interpolator; holes still interpolate,
// including after a backslash. An interpolator other than `s` and `f` receives its parts exactly as
// written, and `s` and `f` process their own escapes.
trait Words
    w(args: int*) -> string

impl Words for StringContext
    w(args: int*) -> string = parts.mkString("|")

main()
    val name = "x"
    println(raw"C:\dir\new")
    println(raw"a\\b")
    println(raw"a\"b")
    println(raw"a\\")
    println(raw"C:\\dir\\")
    println(raw"\\\"")
    println(raw"\\\"".byteLength)
    println(w"x\\")
    println(w"\\\"${2}\\")
    println(raw"\n\t\u00e9\x41 $name ${name} $$ \\ ")
    println(raw"${"}"}\\ ")
    println(raw"${name}\${name}\$name")
    println(raw"[${"\""}]\ ")
    println(raw"say $"hi$" \$$")
    println(s"say $"hi$" $$ $name")
    println(f"${name}%-3s|$"|\\")
    println(w"C:\dir $"q$" $$")
    println(w"a\"b${1}\n")
    println(s"a\tb|\\|$name|\"")
    println(StringContext(["C:\\d"]).raw())
