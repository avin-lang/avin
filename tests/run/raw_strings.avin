// expect: exit 0
// A raw string has no escape processing: a backslash is an ordinary character, so a path or a
// pattern is written as it reads. Only a backslash directly before a quote keeps that quote from
// ending any interpolated literal, so `raw"a\"b"` holds the four characters a, backslash, quote, b.
// `$"` is a double quote and `$$` a dollar sign in every interpolator; holes still interpolate,
// including after a backslash. An interpolator other than `s` and `f` receives its parts exactly as
// written, and `s` and `f` process their own escapes.
trait Words
    w(args: int*) -> string

impl Words for StringContext
    w(args: int*) -> string = parts.mkString("|")

main()
    val name = "x"
    print(raw"C:\dir\new")
    print(raw"a\\b")
    print(raw"a\"b")
    print(raw"\n\t\u00e9\x41 $name ${name} $$ \\ ")
    print(raw"${"}"}\\ ")
    print(raw"${name}\${name}\$name")
    print(raw"[${"\""}]\ ")
    print(raw"say $"hi$" \$$")
    print(s"say $"hi$" $$ $name")
    print(f"${name}%-3s|$"|\\")
    print(w"C:\dir $"q$" $$")
    print(w"a\"b${1}\n")
    print(s"a\tb|\\|$name|\"")
    print(StringContext(["C:\\d"]).raw())
