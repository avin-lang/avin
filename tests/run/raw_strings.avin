// expect: exit 0
// A raw string has no escape processing: a backslash is an ordinary character, so a path or a
// pattern is written as it reads, and the literal ends at the first quote outside a hole. Holes still
// interpolate, and `$$` is a dollar sign; `s"…"` and `f"…"` keep their escapes.
main()
    val name = "x"
    print(raw"C:\dir\new")
    print(raw"a\")
    print(raw"\n\t\u00e9\x41 $name ${name} $$ \\")
    print(raw"${"}"}\")
    print(raw"${name}\${name}")
    print(raw"\" + "b")
    print(raw"\".byteLength())
    print(raw"[${"\""}]\")
    print(s"a\tb|\\|$name")
    print(f"${name}%-3s|\\")
    print(StringContext(["C:\\d"]).raw())
