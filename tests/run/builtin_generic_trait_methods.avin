// expect: exit 0
// A method with type parameters of its own that an impl adds to a built-in type is reached through a
// trait value of that type: the boxed value's table and a string's hold it at each of its own type
// arguments, bounded or not, beside a data type's and a class's.
trait Tagger
  tag[T](x: T) -> string
  pair[A: Display, B](a: A, b: B) -> string

impl Tagger for int
  tag[T](x: T) -> string = s"int $self"
  pair[A: Display, B](a: A, b: B) -> string = s"int $a"

impl Tagger for string
  tag[T](x: T) -> string = s"string $self"
  pair[A: Display, B](a: A, b: B) -> string = s"string $a $self"

impl Tagger for real
  tag[T](x: T) -> string = "real"
  pair[A: Display, B](a: A, b: B) -> string = s"real $a"

impl Tagger for bool
  tag[T](x: T) -> string = s"bool $self"
  pair[A: Display, B](a: A, b: B) -> string = s"bool $a"

data Point(x: int)

impl Tagger for Point
  tag[T](x: T) -> string = "point"
  pair[A: Display, B](a: A, b: B) -> string = s"point $a"

class Named(val name: string): Tagger
  override tag[T](x: T) -> string = name
  override pair[A: Display, B](a: A, b: B) -> string = s"$name $a"

main() -> int
  val taggers: List[Tagger] = [7, "s", 1.5, true, Point(1), Named("n")]
  for t in taggers
    println(t.tag("text"))
    println(t.tag(42))
    println(t.pair(3, "b"))
    println(t.pair("a", 2.5))
  0
