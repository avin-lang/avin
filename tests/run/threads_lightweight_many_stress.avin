// expect: exit 0
// Two thousand threads under a collection at every allocation, each allocating a list of its own and
// handing it back, all started before any is joined, so the collector walks every parked and ready
// thread's frames many times over; then threads that start threads of their own.
import avin.threads.spawn

main() -> int
    val n = 2000
    val threads = (0..<n).map(i -> spawn(() -> List(i, i + 1, i + 2))).toVector()
    var total = 0
    for t in threads do total += t.join().sum()
    println(total)
    val nested = (0..<50).map(i ->
        spawn(() ->
            val inner = (0..<10).map(j -> spawn(() -> i * j)).toVector()
            inner.map(t -> t.join()).sum())).toVector()
    println(nested.map(t -> t.join()).sum())
    0
