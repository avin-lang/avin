// expect: trap
// Names of more than the 65535 bytes ALPN carries in all, each with its length byte, trap: 257 names
// of 255 bytes are 65792.
import avin.net.tls.TlsClient

main()
  val names = Vector.tabulate(257, i -> "n".repeat(255))
  println(s"${names.length} names")
  _ = TlsClient().offer(names)
  println("not reached")
