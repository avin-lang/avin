// expect: exit 0
// Tuples with and without parentheses, parts read by position, tuple patterns, destructuring
// bindings, and multiple assignment with its compound forms.

// A result of two values is written without parentheses.
divmod(a: int, b: int) -> (int, int) = a / b, a % b

swap[A, B](pair: (A, B)) -> (B, A) = pair.1, pair.0

data Shape
  Circle(radius: int)
  Square(side: int)

// Tuples may hold heap values, and patterns reach into them.
largest(shapes: (Shape, Shape)) -> int = shapes match
  (Circle(a), Circle(b)) -> if a > b then a else b
  (Square(s), _) -> s
  (_, Square(s)) -> s

// A tuple pattern over the scrutinee's parts, with literals: the coverage is per part.
both(flags: (bool, bool)) -> int = flags match
  (true, true) -> 3
  (true, false) -> 2
  (false, b) -> if b then 1 else 0

// Clauses over a tuple parameter.
first(pair: (int, int)) -> int
first((a, _)) = a

// A block's last line and a `return` may be tuples too.
bounds(a: int, b: int) -> (int, int)
  if a > b then return b, a
  a, b

main() -> int
  val q, r = divmod(17, 5)
  if q != 3 || r != 2 then return 1
  val (lo, hi) = bounds(9, 4)
  if lo != 4 || hi != 9 then return 2
  val t = (1, 'x', true)
  if t.0 != 1 || t.1 != 'x' || !t.2 then return 3
  val s = swap((7, false))
  if s.0 || s.1 != 7 then return 4
  if largest((Circle(2), Circle(5))) != 5 || largest((Circle(1), Square(4))) != 4 then return 5
  if both((true, false)) != 2 || both((false, true)) != 1 then return 6
  if first((8, 9)) != 8 then return 7
  // Multiple assignment evaluates everything on the right before storing anything.
  var a = 1
  var b = 2
  a, b = b, a
  if a != 2 || b != 1 then return 8
  (a, b) = (b, a)
  if a != 1 || b != 2 then return 9
  // A compound form reads every place first: both sides see the starting values.
  a, b += b, a
  if a != 3 || b != 3 then return 10
  // `_` discards a part, and a tuple-valued call can be the right side.
  var x = 0
  x, _ = divmod(20, 6)
  if x != 3 then return 11
  // A `var` binding by pattern makes every name assignable; a part may itself be a tuple.
  var (m, (n, k)) = (1, (2, 3))
  m, n, k = k, m, n
  if m != 3 || n != 1 || k != 2 then return 12
  // Nested tuples, and literals taking their widths from the expected type.
  val wide: (long, (byte, int)) = 5000000000, (0xff, -1)
  if wide.0 != 5000000000 || wide.1.0 != 0xff || wide.1.1 != -1 then return 13
  // Heap values survive collections while held in tuples.
  var pair = (Circle(1), Square(2))
  var count = 0
  while count < 100
    pair = (pair.1, pair.0)
    count++
  if largest(pair) != 2 then return 14
  0
