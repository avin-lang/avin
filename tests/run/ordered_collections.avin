// expect: exit 0
// OrderedMap and OrderedSet under the collector: entries added, replaced, removed and added again
// across enough churn to compact, held as the traits and as plain maps and sets, with values that
// are heap objects.

class Item(val id: int, val label: string)

main(args: Vector[string])
    var m = OrderedMap.empty[string, Item]()
    for i in 0..<300
        m = m.updated(s"k${i % 70}", Item(i, s"item $i"))
        if i % 3 == 0 then m = m.removed(s"k${(i * 7) % 70}")
    println(m.size())
    println(m.keys().take(6))
    println(m.values().take(4).map(it -> it.label))
    val older = m
    var churn = m
    for i in 0..<200
        churn = churn.removed(s"k${i % 70}").updated(s"n$i", Item(i, "n"))
    println(churn.size())
    println(older.size())
    val seq: SeqMap[string, Item] = older
    val plain: Map[string, Item] = older
    println(seq.reverseIterator().take(3).map(e -> e.0).toVector())
    println(plain.keys() == seq.keys())

    var s = OrderedSet.empty[string]()
    for i in 0..<400
        s = s.incl(s"e${(i * 13) % 90}")
        if i % 4 == 1 then s = s.excl(s"e${i % 90}")
    println(s.size())
    println(s.toVector().take(8))
    val h: Set[string] = HashSet.empty[string]() ++ s
    val o: Set[string] = s
    println(h == o)
    println(o.hash() == h.hash())
