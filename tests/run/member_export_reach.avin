// expect: exit 0
// What an export reads: a generic field with the type's arguments in place, a `var` field read
// again at every use, a method of no parameter list run at every use, an inherited field, a field of
// a data type's one variant and an object's field; and exports chaining, by name and by wildcard.
class Stack[T](private var items: Vector[T])
  export items.{length as size, isEmpty, map, contains, apply as at}
  push(x: T) = items = items :+ x

class Counter(var count: int)
  bump() = count += 1

class Holder(var current: Counter)
  export current.{count, bump}

class Fresh(start: int)
  made -> Counter = Counter(start)
  export made.{count, bump}

open class Base(c: Counter)
  export c.count

class Sub(c2: Counter): Base(c2)
  twice() -> int = self.count * 2

data Wrapper(inner: Counter, tag: string)

impl Wrapper
  export inner.{count, bump}
  export tag.charCount as tagLength

object Registry
  val store: Counter = Counter(100)
  export store.{bump, count}

class Inner(var v: int)
  get() -> int = v
  set(x: int) = v = x

class Middle(i: Inner)
  export i.{get, set}

class Outer(m: Middle)
  export m.get

class Everything(m: Middle)
  export m.*

class Pair[A, B](first: Vector[A], second: Vector[B])
  export first.length as firstLength
  export second.{length as secondLength, map as mapSecond}

class Ünïcode(c: Counter)
  export c.count as größe

main()
  val s = Stack([1, 2])
  s.push(3)
  println(s.size)
  println(s.isEmpty)
  println(s.map(x -> x * 10))
  println(s.map(x -> s"<$x>"))
  println(s.contains(2))
  println(s.at(0))
  val empty = Stack(Vector.empty[string]())
  println(empty.isEmpty)
  println(empty.size)
  val h = Holder(Counter(1))
  h.bump()
  println(h.count)
  h.current = Counter(9)
  println(h.count)
  h.bump()
  println(h.current.count)
  val fr = Fresh(5)
  fr.bump()
  println(fr.count)
  val sub = Sub(Counter(21))
  println(sub.count)
  println(sub.twice())
  val asBase: Base = sub
  println(asBase.count)
  val w = Wrapper(Counter(1), "abc")
  w.bump()
  w.count = w.count + 10
  println(w.count)
  println(w.tagLength)
  Registry.bump()
  println(Registry.count)
  val o = Outer(Middle(Inner(7)))
  println(o.get())
  val e = Everything(Middle(Inner(3)))
  e.set(4)
  println(e.get())
  val p = Pair([1, 2, 3], ["a"])
  println(p.firstLength + p.secondLength)
  println(p.mapSecond(x -> x + "!"))
  println(Ünïcode(Counter(-2147483648)).größe)
