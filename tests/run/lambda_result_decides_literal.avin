// expect: exit 0
// A lambda's result takes part in a call's tiers as any other argument does: once its parameter
// types are known, what it yields settles a type argument before a number literal beside it, so the
// literal takes that type, as it would from any value with a type of its own. A lambda whose result
// is itself a literal is checked in the literals' tier, and one that leaves by `return` or `?` is
// still checked after every other argument, since its result type must be known first.

describe(x: Any) -> string = x match
    n: int -> s"int $n"
    l: long -> s"long $l"
    r: real -> s"real $r"
    b: byte -> s"byte $b"
    v: Vector[long] -> s"Vector[long] ${v.size}"
    v: Vector[int] -> s"Vector[int] ${v.size}"
    _ -> "other"

pick[T](text: string, read: (string) -> Option[T], absent: T) -> Result[T, string] = read(text) match
    Some(v) -> Ok(v)
    None -> Ok(absent)

pickLast[T](text: string, absent: T, read: (string) -> Option[T]) -> T = read(text) match
    Some(v) -> v
    None -> absent

yielding[T](make: (string) -> T, absent: T) -> T = if absent == absent then make("abc") else absent

both[T](first: (string) -> T, second: (string) -> T, absent: T) -> Vector[T] = [first("ab"), second("abc"), absent]

chain[A, B](first: (string) -> A, next: (A) -> B, absent: B) -> (B, B) = (next(first("abcd")), absent)

nested[T](read: (string) -> Option[Vector[T]], absent: T) -> Vector[T] = read("xy") match
    Some(v) -> v :+ absent
    None -> [absent]

readLong(s: string) -> Option[long] = s.toLongOption()

inner[T](o: Option[T]) -> string = o match
    Some(v) -> describe(v)
    None -> "none"

shown[T](r: Result[T, string]) -> string = r match
    Ok(v) -> describe(v)
    Err(e) -> e

class Reader(val prefix: string)
    pick[T](read: (string) -> Option[T], absent: T) -> T = read(prefix) match
        Some(v) -> v
        None -> absent

class Holder[T](val read: (string) -> Option[T], val absent: T)
    get(text: string) -> T = read(text) match
        Some(v) -> v
        None -> absent

run() -> Result[unit, string]
    // The reproducer: the lambda yields Option[long], so `0` is a long.
    val n = pick("12", s -> s.toLongOption(), 0)?
    println(describe(n))
    val absent = pick("x", s -> s.toLongOption(), 0)?
    println(describe(absent))
    // A literal too wide for an int is accepted, since it is a long.
    val wide = pick("x", s -> s.toLongOption(), 5_000_000_000)?
    println(describe(wide))
    val negative = pick("x", s -> s.toLongOption(), -1)?
    println(describe(negative))
    // An integer literal beside a lambda yielding Option[real] is a real.
    val r = pick("x", s -> s.toRealOption(), 0)?
    println(describe(r))
    val r2 = pick("2.5", s -> s.toRealOption(), 2 * 3)?
    println(describe(r2))
    // The lambda's body as a block, an `if`, a `match`, and `None`.
    val block = pickLast(" 9 ", 0, s ->
        val t = s.strip
        t.toLongOption())
    println(describe(block))
    val branches = pick("", s -> if s.isEmpty then None else s.toLongOption(), 0)?
    println(describe(branches))
    val arms = pickLast("one", 0, s -> s match
        "one" -> Some(long(1))
        _ -> None)
    println(describe(arms))
    val none = pick("x", s -> None, 0)?
    println(describe(none))
    // The type expected of the call still decides where the lambda says nothing.
    val expected: Result[long, string] = pick("x", s -> None, 0)
    println(describe(expected?))
    Ok(())

main()
    run() match
        Ok(_) -> ()
        Err(e) -> println(e)
    // The literal before the lambda.
    println(describe(pickLast("34", 0, s -> s.toLongOption())))
    println(describe(pickLast("x", 0, s -> s.toRealOption())))
    // A lambda whose result is a literal is in the literals' tier: a value with a type of its own
    // decides it, and among literals alone the first written does.
    println(describe(yielding(s -> 1, long(5))))
    println(describe(yielding(s -> 1, 0)))
    println(describe(yielding(s -> 1.5, 0)))
    println(inner(yielding(s -> Some(1), Some(long(2)))))
    println(inner(yielding(s -> Some(1), None)))
    println(inner(nested(s -> Some([1, 2]), long(3)).headOption))
    println(describe(yielding(s -> s.byteLength + 1, 0)))
    // A captured long decides the literal.
    val base = long(10)
    println(describe(yielding(s -> base, 0)))
    println(describe(yielding(s -> base * 2, 0)))
    // Several lambdas: the first yields a long, the second's literal and the `0` follow it.
    println(describe(both(s -> long(s.byteLength), s -> 7, 0)))
    println(describe(both(s -> 7, s -> long(s.byteLength), 0)))
    // A lambda whose parameter type another lambda decides, which then decides the literal.
    val (doubled, fallback) = chain(s -> long(s.byteLength), n -> n * 2, 0)
    println(s"${describe(doubled)} ${describe(fallback)}")
    // Nested generics: the lambda yields Option[Vector[long]].
    println(describe(nested(s -> Some([long(s.byteLength)]), 0)))
    println(describe(nested(s -> None, 0)))
    // A named function in the lambda's place, as before.
    println(shown(pick("56", readLong, 0)))
    // A generic method and a generic class's constructor.
    println(describe(Reader("78").pick(s -> s.toLongOption(), 0)))
    println(describe(Reader("x").pick(s -> s.toLongOption(), 0)))
    println(describe(Holder(s -> s.toLongOption(), 0).get("x")))
    println(describe(Holder(s -> s.toLongOption(), 0).get("90")))
    // A lambda that leaves by `?` is checked last, so the literal decides its result type.
    println(shown(pick("41", s -> Some(s.toIntOption()? + 1), 0)))
