// A collection literal given to an overloaded function becomes the collection the one candidate it
// can be asks for, as it would for a single function: a map, vector or set literal whose elements
// are of types implementing a trait fits the overload taking that trait's collection, beside one
// taking a repeated parameter or an unrelated type. A literal that fits by itself chooses as before.
trait Param
  show -> string

impl Param for string
  show -> string = s"'$self'"

impl Param for int
  show -> string = s"$self"

impl Param for bool
  show -> string = if self then "yes" else "no"

single(m: Map[string, Param]) -> string = s"single ${m.size}"

pair(a: string, xs: Param*) -> string = s"positional ${xs.map(x -> x.show)}"
pair(a: string, m: Map[string, Param]) -> string = s"named ${m.size}"

either(x: int) -> string = "int"
either(m: Map[string, Param]) -> string = s"map ${m("k").show}"

seqs(n: int) -> string = "int"
seqs(xs: Vector[Param]) -> string = s"vector ${xs.map(x -> x.show)}"

sets(n: int) -> string = "int"
sets(xs: Set[Param]) -> string = s"set ${xs.size}"

plain(m: Map[string, string]) -> string = "strings"
plain(n: int) -> string = "int"

class Box
  put(xs: Param*) -> string = s"box positional ${xs.length}"
  put(m: Map[string, Param]) -> string = s"box named ${m.size}"

main()
  println(single({"a": "x", "b": 1}))
  println(pair("s", "x", 1))
  println(pair("s"))
  println(pair("s", {"a": "x"}))
  println(pair("s", {"a": "x", "b": 2, "c": true}))
  println(pair("s", {"a": 1}))
  println(either({"k": "v"}))
  println(either({"k": true}))
  println(either(3))
  println(seqs(["a", 1, false]))
  println(seqs(["only"]))
  println(sets({"a", "b"}))
  println(plain({"a": "x"}))
  println(Box().put({"a": "x", "b": 1}))
  println(Box().put("x", 1))
  val none: Option[long] = None
  println(pair("s", {"a": "x", "b": s"${none}"}))
