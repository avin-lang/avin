// expect: trap
// Running out of stack stops the program with no hook run: the report comes from a handler on a
// stack of its own, where no Avin code can run, and the thread's own stack is spent.
import avin.process

descend(n: int) -> int = descend(n + 1) + n

main() -> int
  process.onExit(() -> println("never runs"))
  println("before")
  println(descend(0))
  0
