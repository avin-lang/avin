// expect: exit 0
// A JSON text of more than a megabyte, 10,000 objects with strings, escapes, numbers, arrays and
// literals, parsed with `avin.parsing` well inside the time a test is given, and checked by summing
// what was read.
import avin.parsing.{Parser, decimal, defer, stringLiteral, symbol, token, whitespace}

data Json
    JNull
    JBool(value: bool)
    JNumber(value: real)
    JString(value: string)
    JArray(items: Vector[Json])
    JObject(fields: Vector[(string, Json)])

lazy val value: Parser[Json] = (
    symbol("null") ^^^ JNull
    | symbol("true") ^^^ JBool(true)
    | symbol("false") ^^^ JBool(false)
    | token(decimal) ^^ (x -> JNumber(x))
    | token(stringLiteral) ^^ (s -> JString(s))
    | defer(array)
    | defer(obj))

lazy val array: Parser[Json] = (symbol("[") ~> value.repSep(symbol(",")) <~ symbol("]")) ^^ (items -> JArray(items))

lazy val field: Parser[(string, Json)] = (token(stringLiteral) <~ symbol(":")) ~ value

lazy val obj: Parser[Json] = (symbol("{") ~> field.repSep(symbol(",")) <~ symbol("}")) ^^ (fields -> JObject(fields))

lazy val document: Parser[Json] = whitespace ~> value

main()
    val out = StringWriter()
    out.write("[\n")
    for i in 0..<10000
        if i > 0 then out.write(",\n")
        out.write(s"  {\"id\": $i, \"name\": \"item \\\"number\\\" $i\", \"price\": ${i}.25, \"tags\": [\"a\", \"b\\n\", \"\\u00e9\"], \"ok\": true, \"none\": null}")
    out.write("\n]\n")
    val text = out.text()
    print(text.byteLength() > 1000000)
    document.parse(text) match
        Ok(JArray(items)) ->
            var ids = 0.0
            var prices = 0.0
            var names = 0
            for item in items
                item match
                    JObject(fields) ->
                        for (k, v) in fields
                            (k, v) match
                                ("id", JNumber(n)) -> ids += n
                                ("price", JNumber(p)) -> prices += p
                                ("name", JString(s)) -> if s.startsWith("item \"number\" ") then names += 1
                                _ -> ()
                    _ -> ()
            print(s"${items.length()} $ids $prices $names")
        Ok(_) -> print("not an array")
        Err(e) -> print(e)
