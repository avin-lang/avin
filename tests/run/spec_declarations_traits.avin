// expect: exit 0
// Spec probes for declarations, trait: Self in default bodies through a bound and an impl, a sub-trait
// overriding its required trait's methods, a generic trait method through the trait at several type
// arguments, a var field and a data field supplying vals, function-typed vals, a superclass method
// implementing a trait's, and many trait-typed values made under allocation.
trait Ordered
  less(other: Self) -> bool
  greater(other: Self) -> bool = other.less(self)

class Money(val cents: int): Ordered
  override less(other: Money) -> bool = cents < other.cents

data Weight(grams: int)

impl Ordered for Weight
  less(other: Weight) -> bool = grams < other.grams

biggest[T: Ordered](items: Vector[T]) -> T
  var best = items(0)
  for x in items do if x.greater(best) then best = x
  best

trait Shape
  area() -> int
  describe() -> string = s"area ${area()}"

trait Square: Shape
  side() -> int
  override area() -> int = side() * side()
  override describe() -> string = s"square ${side()}"

class Tile(n: int): Square
  override side() -> int = n

trait Mapper[A]
  get() -> A
  map[B](f: (A) -> B) -> B = f(get())

class Holder(x: int): Mapper[int]
  override get() -> int = x

trait Named
  val name: string
  val action: () -> string
  greet() -> string = s"hello, $name"

class Person(var name: string): Named
  val action: () -> string = () -> "acting"

data Book(name: string, action: () -> string)
impl Named for Book

open class Base
  label() -> string = "base"

trait Labelled
  label() -> string

class Child: Base, Labelled

trait Animal
  sound() -> string

class Dog: Animal
  override sound() -> string = "woof"

class Cat: Animal
  override sound() -> string = "meow"

main()
  println(s"${biggest([Money(3), Money(9), Money(1)]).cents} ${biggest([Weight(5), Weight(2)]).grams}")
  println(s"${Money(1).greater(Money(0))} ${Weight(1).greater(Weight(2))}")
  val t = Tile(3)
  val s: Shape = t
  val q: Square = t
  println(s"${s.area()} ${s.describe()} ${q.describe()}")
  val m: Mapper[int] = Holder(20)
  println(s"${m.map(x -> x + 1)} ${m.map(x -> s"<$x>")} ${m.map(x -> x > 5)}")
  val p = Person("ann")
  val n: Named = p
  p.name = "bo"
  println(s"${n.name} ${n.greet()} ${n.action()}")
  val named: Vector[Named] = [p, Book("atlas", () -> "reading")]
  println(named.map(x -> x.greet() + " " + x.action()).mkString("; "))
  val l: Labelled = Child()
  println(l.label())
  var animals: Vector[Animal] = []
  for i in 0 .. 1000
    val a: Animal = if i % 2 == 0 then Dog() else Cat()
    animals = animals :+ a
  println(s"${animals.length} ${animals(999).sound()} ${animals(998).sound()}")
  val pick: Animal = animals.length % 3 match
    0 -> Dog()
    _ -> Cat()
  println(pick.sound())
