// expect: exit 0
// An operator method is exported by its spelling, and `a + b` calls it on what the export reads. A
// public export by name implements a trait's method of its name, every overload of it, a method of no
// parameter list and one with a default body, so a call through the trait reaches the member; the
// class's own method of a trait's name stays its own.
data Money(cents: long)

impl Money
  +(other: Money) -> Money = Money(cents + other.cents)
  <(other: Money) -> bool = cents < other.cents
  |(other: Money) -> Money = if cents >= other.cents then self else other

class Wallet(m: Money)
  export m.{+, <, |}

trait Bumpable
  bump() -> unit
  bump(by: int) -> unit
  count -> int
  describe() -> string = s"count $count"

class Counter(var count: int)
  bump() = count += 1
  bump(by: int) = count += by
  describe() -> string = s"counter at $count"

class Proxy(c: Counter): Bumpable
  export c.{bump, count, describe}

class Partial(c: Counter): Bumpable
  export c.{bump, count}

class Own(c: Counter): Bumpable
  export c.{bump}
  override count -> int = 1000

trait Sized
  size -> int

class Stack[T](items: Vector[T]): Sized
  export items.length as size

poke(b: Bumpable) -> string
  b.bump()
  b.bump(2)
  b.describe()

measure(s: Sized) -> int = s.size

main()
  val w = Wallet(Money(150))
  println(w + Money(25))
  println(w < Money(200))
  println(w < Money(100))
  println(w | Money(999))
  val p = Proxy(Counter(0))
  println(poke(p))
  println(p.count)
  val q = Partial(Counter(10))
  println(poke(q))
  val own = Own(Counter(5))
  println(poke(own))
  val things: Vector[Bumpable] = [p, q, own]
  for t in things
    t.bump()
  println(s"${p.count} ${q.count} ${own.count}")
  println(measure(Stack(["a", "b", "c"])))
  println(Stack([1]).size)
