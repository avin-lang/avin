// expect: trap
// A send on a channel of capacity zero waits for a receiver, and that wait is one the deadlock check
// counts: the main thread hands a value to nobody while its one other thread waits to receive from
// another such channel, so every thread waits and the report names what each waits for.
import avin.threads.{Channel, spawn}

main()
  val a = Channel[int](0)
  val b = Channel[int](0)
  val t = spawn(() -> b.receive())
  println("sending")
  a.send(1)
  println("not reached", t.join())
