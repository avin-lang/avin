// expect: exit 0
// A union with a scalar member is shown by the member it holds, through that member's own `Display`
// and `Debug`: in interpolation, with a format spec, through `toString()`, `debug`, `println` and a
// generic function bounded by `Display`, and as the field of a derived `Display`.

data Point(x: int, y: int) derives Display, Debug

data Labelled(label: string, value: int | char | string) derives Display, Debug

type Shown = int | long | real | char | bool | unit | byte | string | Point

framed[T: Display](x: T) -> string = s"<$x>"

line(u: Shown) -> string = s"$u|${u.toString()}|${debug(u)}|${framed(u)}"

main()
  val values: Vector[Shown] = [
    0,
    int.MinValue,
    long.MaxValue,
    2.5,
    -0.0,
    'q',
    '"',
    true,
    (),
    byte(200),
    "",
    "say \"hi\"",
    "日本",
    Point(1, -2)
  ]
  for v in values
    println(line(v))
  // Format specs reach the member's own rendering.
  val n: int | string = 42
  val s: int | string = "ab"
  println(f"[${n}%5s] [${n}%-5s] [${n}%.1s] [${s}%5s] [${s}%-5s] [${s}%?] [${s}%6?]")
  val r: real | bool = 3.14159
  println(f"[${r}%8s] [${r}%.3s]")
  // Debug quotes strings and characters, Display does not.
  val c: char | string = 'x'
  println(s"${c} ${debug(c)} ${s} ${debug(s)}")
  // A derived rendering shows a union field by its member.
  println(Labelled("a", 1))
  println(Labelled("b", 'z'))
  println(debug(Labelled("c", "text")))
  // `println` takes the union as an `Any`, boxing a scalar member there.
  println(n, s, r)
