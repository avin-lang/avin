// expect: exit 0
// A thread in a blocking call is running, so the program is not deadlocked while one is, however the
// others wait: `main` joins a thread waiting for a command to end, and receives from a channel that
// a thread sends to once its own command has ended. An actor asked a question it never answers is
// not a deadlock either: the ask's limit is a timer, and the answer is `TimedOut`.
import avin.actors.{ActorRef, AskError, TimedOut, spawn}
import avin.process.Command
import avin.threads
import avin.threads.Channel
import avin.time.millis

// Starts a thread running `body`.
start[T: Sendable](@sendable body: () -> T) -> threads.Thread[T] = threads.spawn(body)

data Question
  Ask(reply: ActorRef[int])

actor Mute receives Question
  receive
    Ask(_) -> ()

main()
  val waiting = start(() -> Command("/bin/sleep", "0.2").run().isOk)
  println(waiting.join())

  val ended = Channel[bool]()
  start(() -> ended.send(Command("/bin/sleep", "0.2").run().isOk))
  println(ended.receive())

  val mute = spawn(Mute())
  val answer = mute.ask(r -> Ask(r), millis(100)).await()
  println(answer match
    Err(TimedOut) -> "timed out"
    _ -> "answered")
