// expect: exit 0
// An argument some overload takes by name is delayed until the overload is chosen; where the one
// chosen takes it strictly, it is evaluated at the call, so a class body may pass it a field already
// initialized, as it may to any strict call, before its later fields are. A companion's generic
// by-name `apply` beside a constructor is the common case.
class Cell(val n: int)

object Cell
  apply[T](make: -> T) -> Cell = Cell(-1)

pick(n: int) -> string = s"strict $n"
pick[T](n: -> T) -> string = "by name"

class Holder(seed: int)
  private val base = seed + 1
  val made: Cell = Cell(base)
  val again: Cell = Cell(made.n * 2)
  val word = pick(base)
  val last = made.n + again.n

main() -> int
  val h = Holder(4)
  println(s"${h.made.n} ${h.again.n} ${h.word} ${h.last} ${Cell("text").n} ${pick("text")}")
  0
