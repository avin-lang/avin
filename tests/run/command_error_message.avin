// expect: exit 0
// CommandError's message for every variant, built directly and from real commands: a failed status
// names the command's programs, and a start failure is the `IoError` naming the program.
import avin.io.{IoError, NotFound, PermissionDenied, Other}
import avin.process
import avin.time
import avin.process.{Command,CommandError, ExitStatus, Failed, Io, Exited, Signalled, TimedOut}

main()
    println(Failed(Exited(1), "").message)
    println(Failed(Exited(0), "").message)
    println(Failed(Exited(255), "").message)
    println(Failed(Signalled(15), "").message)
    println(Failed(Signalled(9), "").message)
    println(Failed(Signalled(2), "").message)
    println(Failed(Signalled(1), "").message)
    println(Failed(Signalled(3), "").message)
    println(Failed(Signalled(13), "").message)
    println(Failed(Signalled(14), "").message)
    println(Failed(Signalled(28), "").message)
    println(Failed(Signalled(77), "").message)
    println(Failed(TimedOut, "").message)
    println(Failed(Exited(2), "ls").message)
    println(Failed(TimedOut, "sleep 5").message)
    println(Io(IoError(NotFound)).message)
    println(Io(IoError(PermissionDenied, "run", "./tool")).message)
    println(Io(IoError(Other("boom"))).message)
    val e: CommandError = Failed(Exited(7), "make")
    println(s"cannot go on: ${e.message}")
    println(s"cannot go on: $e")
    println(e.cause.isEmpty)
    println(Err[int, CommandError](e).context("building"))

    println(Command("sh", "-c", "exit 3").output() match
        Ok(_) -> "ok"
        Err(e) -> e.message)
    println(Command("sh", "-c", "kill -15 $$").output() match
        Ok(_) -> "ok"
        Err(e) -> e.message)
    println(Command("sleep", "5").withTimeout(time.millis(100)).output() match
        Ok(_) -> "ok"
        Err(e) -> e.message)
    println("false".output() match
        Ok(_) -> "ok"
        Err(e) -> e.message)
    println("/nonexistent/program".output() match
        Ok(_) -> "ok"
        Err(e) -> e.message)
    println("true".output() match
        Ok(_) -> "ok"
        Err(e) -> e.message)
    // Pipelines and sequences are named by their programs and how they are joined.
    println((Command("true") | Command("false")).output())
    println(Command("true").andThen(Command("false")).output())
    println(Command("false").orElse(Command("false")).output())
    println(Command("true").followedBy(Command("false")).output())
    println(((Command("true") | Command("true")).andThen(Command("false"))).output())
    // The kind of a start failure is still matched through `Io`.
    "/nonexistent/program".output() match
        Err(Io(IoError(NotFound, op, program))) -> println(s"$op / $program")
        other -> println(s"unexpected $other")
    Command("/nonexistent/program").run() match
        Err(IoError(NotFound, _, program)) -> println(s"run: $program")
        other -> println(s"unexpected $other")
