// expect: exit 0
// An `Option[Nothing]` inside another value (a vector, a `Result`, a function's result, an option, a
// data type's field, a tuple, a map's value) seen as the same value holding an option of a class or a
// string: the program keeps its options of classes and strings as pointers, and `None` is null in
// both, so every value reads, compares, hashes and shows as written.

class Dog(val name: string) derives Display, Debug, Eq, Hash

data Box[+T](item: T)

val nones = [None, None]

nothing() -> Option[Nothing] = None

nothingOk() -> Result[Option[Nothing], string] = Ok(None)

all() -> Vector[Option[Dog]] = nones

texts() -> Vector[Option[string]] = nones

wide() -> Result[Option[Dog], string] = nothingOk()

maker() -> () -> Option[Dog] = nothing

stringMaker() -> () -> Option[string] = nothing

inner() -> Option[Option[Nothing]] = Some(None)

innerDog() -> Option[Option[Dog]] = inner()

boxed() -> Box[Option[Nothing]] = Box(None)

boxedDog() -> Box[Option[Dog]] = boxed()

pair() -> (Option[Nothing], int) = (None, 1)

pairDog() -> (Option[Dog], int) = pair()

table() -> Map[string, Option[Nothing]] = {"a": None}

tableDog() -> Map[string, Option[Dog]] = table()

deeper() -> Vector[Vector[Option[Nothing]]] = [[None], []]

deeperDog() -> Vector[Vector[Option[Dog]]] = deeper()

// A generic function sees each instance's options as its own.
firstOf[T](xs: Vector[Option[T]], fallback: T) -> T = xs.headOption.flatten.getOrElse(fallback)

countDefined[T](xs: Vector[Option[T]]) -> int = xs.filter(o -> o.isDefined).length

main()
    val rex = Dog("rex")
    println(s"${all()} ${all().map(o -> o.isDefined)} ${all().map(o -> o.orElse(Some(rex)))}")
    println(s"${texts()} ${texts().map(o -> o.getOrElse("-"))}")
    println(s"${wide()} ${wide().map(o -> o.getOrElse(rex))}")
    val made = maker()
    println(s"${made()} ${made().isEmpty} ${made() == None}")
    println(s"${stringMaker()().getOrElse("empty")}")
    println(s"${innerDog()} ${innerDog().flatten} ${innerDog().map(o -> o.isEmpty)}")
    println(s"${boxedDog().item} ${boxedDog().item.orElse(Some(rex))}")
    val (first, n) = pairDog()
    println(s"${pairDog()} ${first.getOrElse(rex)} $n")
    println(s"${tableDog().get("a")} ${tableDog().get("a").flatten}")
    println(s"${deeperDog()} ${deeperDog().map(v -> v.length)}")
    // Equality and hashing see `None` from either side alike.
    val some: Vector[Option[Dog]] = [Some(rex), None]
    println(s"${all() == [None, None]} ${all() == some} ${some == [Some(rex), None]}")
    println(s"${all()(0) == None} ${all()(0).hash() == nothing().hash()} ${all()(0).hash() == some(1).hash()}")
    println(s"${innerDog() == Some(None)} ${boxedDog().item == None} ${pairDog() == (None, 1)}")
    // Elements seen as options of a class mix with ones made as such.
    val both: Vector[Option[Dog]] = all() ++ some
    println(both.map(o -> o.map(d -> d.name).getOrElse("-")))
    println(s"${firstOf(all(), rex)} ${firstOf(some, Dog("ace"))} ${countDefined(both)} ${countDefined(nones)}")
    // Debug, and an option boxed into an `Any`, read the same values; as an `Any` it is an
    // `Option[Dog]`, which is another type than the `Option[Nothing]` written beside it.
    println(debug(all()))
    val anything: Any = all()(0)
    val dog: Any = some(1)
    println(s"$anything ${anything == None} ${anything == dog}")
    // Plenty of allocation, so a collection runs while these values are live.
    var many: Vector[Option[Dog]] = all()
    for i in 0..<200
        many = many :+ (if i % 3 == 0 then Some(Dog(s"d$i")) else nothing())
    println(s"${countDefined(many)} ${many.length} ${many(2).map(d -> d.name)} ${many(3)}")
