// expect: trap
// `Escalate` is the default, and a top-level actor that escalates stops the program, the trap
// reported once, naming the actor, and nothing after it: so a program that supervises nothing
// behaves as one with threads, where a bug stops it. What was printed before is kept.
import avin.actors.spawn
import avin.threads.Channel

actor Parser(done: Channel[int]) receives string
  receive
    s ->
      println(s"parsing $s")
      done.send(s.toInt() * 2)

main()
  val done = Channel[int]()
  val p = spawn(Parser(done))
  p.tell("21")
  println(done.receive())
  p.tell("x")
  p.tell("4")
  println(done.receive())
  println("not reached")
