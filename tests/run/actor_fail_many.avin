// expect: exit 0
// A thousand failures leave the workers and the runtime as they were: five hundred actors, each
// failing once with `Stop`, and one actor restarting five hundred times, each failure after the
// actor's code has held and let go of a mutex and called through closures, so every lock and frame
// the trap dropped is accounted for. Then ordinary work runs on the same workers, and its answers
// are exact. Its smaller twin, `actor_fail_many_stress`, runs the same shape under the collector's
// stress.
// env: AVIN_GC_STRESS=0
import avin.actors.{ActorRef, Restart, Stop, spawn}
import avin.threads.{Mutex, Promise}
import avin.time

data Msg[T: Sendable]
    Boom(n: T)
    Sum(xs: Vector[int], reply: Promise[int])

actor Worker[T: Sendable](shared: Mutex[Buffer[int]]) receives Msg[T]
    var seen: List[string] = List()
    receive
        Boom(n) ->
            shared.with(b -> b.append(1))
            seen = List("boom")
            val f = (x: int) -> x / (x - x)
            seen = List(s"${twice(f, 3)}")
        Sum(xs, r) -> r.complete(xs.sum)

twice(f: (int) -> int, x: int) -> int = f(f(x))

sum[T: Sendable](w: ActorRef[Msg[T]], xs: Vector[int]) -> int
    val p = Promise[int]()
    w.tell(Sum(xs, p))
    p.future.await()

main()
    val n = 500
    val shared = Mutex(Buffer[int]())
    for i in 0..<n
        val w = spawn(Worker[int](shared), onFailure = Stop)
        w.tell(Boom(i))
        w.ended().await()
    val r = spawn(Worker[string](shared), onFailure = Restart(n, time.hours(1)))
    for i in 0..<n do r.tell(Boom(s"$i"))
    println(sum(r, Vector(1, 2, 3)))
    println(shared.with(b -> b.length))
    val workers = (0..<20).map(_ -> spawn(Worker[int](shared))).toVector
    var total = 0
    for (w, i) in workers.zipWithIndex do total += sum(w, (0..<i).toVector)
    println(total)
