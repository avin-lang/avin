// expect: exit 0
// Where a call's result is a class or data type at a contravariant type argument, the type it is
// expected to have bounds that argument only from below, so the arguments decide it: `make(Box(3))`
// is a `Sink[int]`, which is a `Sink[Nothing]` and a `Sink[Dog]`'s supertype's sink. Only where the
// arguments leave it open does the expected type decide it. The rule follows covariant arguments
// down (an `Option` or a `Vector` of sinks, a function's result) and reaches constructors, generic
// methods, a data type's contravariant parameter, and an actor's reference as `spawn` makes it.
import avin.actors.{ActorRef, spawn}

class Sink[-T](val n: int)

class Box[T](val v: T)

open class Animal(val name: string)
class Dog(name: string): Animal(name)

make[T](b: Box[T]) -> Sink[T] = Sink[T](1)

fresh[T]() -> Sink[T] = Sink[T](2)

anySink(s: Sink[Nothing]) -> int = s.n

dogSink(s: Sink[Dog]) -> int = s.n + 10

intSink(s: Sink[int]) -> int = s.n + 100

data Feed[-T]
    Feeding(count: int)

feed[T](x: T) -> Feed[T] = Feeding(1)

class Maker
    sinkOf[T](b: Box[T]) -> Sink[T] = Sink[T](3)

actor Quiet receives string
    receive
        _ -> ()

main()
    println(anySink(make(Box(3))))
    val s: Sink[Nothing] = make(Box("x"))
    println(s.n)
    // The argument says `Animal`; a sink of animals takes dogs too.
    println(dogSink(make(Box(Animal("cat")))))
    println(intSink(fresh()))
    val t: Sink[string] = fresh()
    println(t.n)
    val o: Option[Sink[Nothing]] = Some(make(Box(1.5)))
    println(o.get().n)
    val v: Vector[Sink[Nothing]] = Vector(make(Box(1)), make(Box("two")))
    println(v.length())
    val f: (int) -> Sink[Nothing] = n -> make(Box(n))
    println(f(4).n)
    val c: Sink[Nothing] = Sink(5)
    println(c.n)
    val d: Sink[Dog] = Sink[Animal](6)
    println(d.n)
    val fed: Feed[Nothing] = feed("grain")
    println(fed match
        Feeding(k) -> k)
    println(anySink(Maker().sinkOf(Box('c'))))
    val refs: Vector[ActorRef[Nothing]] = Vector(spawn(Quiet()))
    println(refs.length())
    val r: ActorRef[Nothing] = spawn(Quiet())
    println(r.name)
