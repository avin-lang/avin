// expect: exit 0
// A `TreeSet` keeps its elements in ascending order: membership, adding and removing as a `Set` has
// them, the set algebra, iteration in order, and the ordered operations. It compares, hashes and
// displays as a set does, is the predicate of membership, and is built by its companion, its builder
// and a literal where one is expected.

data Version(major: int, minor: int) derives Ord

main()
    val s = TreeSet(5, 3, 9, 1, 7, 3)
    print(s)
    print(debug(TreeSet("b", "a")))
    print(s"${s.size()} ${s.isEmpty()} ${TreeSet.empty[int]().isEmpty()} ${s.contains(7)} ${s(4)}")
    print(s"${s.added(4)} ${s.added(5) == s} ${s.removed(1)} ${s.removed(2) == s} $s")
    print(s ++ [2, 4, 9])
    print(s -- [1, 2, 9])
    val evens = TreeSet(2, 4, 6, 8, 10)
    val small = TreeSet(1, 2, 3, 4, 5)
    print(s"${s union evens} ${s intersect small} ${s diff small}")
    print(s"${TreeSet(1, 3).subsetOf(s)} ${small.subsetOf(s)} ${TreeSet.empty[int]().subsetOf(s)}")

    print(s.iterator().toVector())
    print(s.reverseIterator().toList())
    print(s"${s.first()} ${s.last()} ${TreeSet.empty[int]().last()}")
    print(s"${s.floor(6)} ${s.floor(7)} ${s.floor(0)} ${s.ceiling(6)} ${s.ceiling(1)} ${s.ceiling(10)}")
    print(s"${s.from(4)} ${s.until(7)} ${s.range(2, 9)} ${s.range(3, 4)} ${s.range(9, 2)}")
    print(s"${s.min()} ${s.max()} ${s.sum()} ${s.mkString("-")}")

    print(s.filter(x -> x > 4))
    print(s.map(x -> x % 4))
    print(s.map(x -> s"n$x"))
    print(s.collect(match
        x if x > 3 -> -x))
    print(s.flatMap(x -> [x, x * 10]))
    s.foreach(x -> print(x))
    print([1, 2, 3, 4, 5].filter(s))
    print(for x in s if x > 2 yield x * 2)
    print(for x in s if x > 2 if x < 9 yield x)

    val b = TreeSet.builder[string]()
    b.add("pear")
    b.addAll(["fig", "apple", "fig"])
    print(b.result())
    val literal: TreeSet[char] = ['z', 'a', 'm', 'a']
    print(literal)

    val versions = TreeSet(Version(1, 2), Version(0, 9), Version(1, 0))
    print(versions)
    print(versions.ceiling(Version(1, 1)))

    print(s"${s == TreeSet(9, 7, 5, 3, 1)} ${s.hash() == TreeSet(1, 9, 3, 7, 5).hash()} ${s != small}")
    print(s"${s.hash() == Set(1, 3, 5, 7, 9).hash()} ${TreeSet.empty[int]() == TreeSet[int]()}")
    val padded = StringWriter()
    TreeSet(1, 2).display(padded, FormatSpec(width = 8, left = true))
    print(s"[${padded.text()}]")

    val words = TreeMap(("b", 2), ("a", 1))
    print(words.keySet().added("c"))
