// expect: exit 0
// A `TreeSet` keeps its elements in ascending order: membership, adding and removing as a `Set` has
// them, the set algebra, iteration in order, and the ordered operations. It compares, hashes and
// displays as a set does, is the predicate of membership, and is built by its companion, its builder
// and a literal where one is expected.

data Version(major: int, minor: int) derives Ord

main()
    val s = TreeSet(5, 3, 9, 1, 7, 3)
    println(s)
    println(debug(TreeSet("b", "a")))
    println(s"${s.size} ${s.isEmpty} ${TreeSet.empty[int]().isEmpty} ${s.contains(7)} ${s(4)}")
    println(s"${s.incl(4)} ${s.incl(5) == s} ${s.excl(1)} ${s.excl(2) == s} $s")
    println(s ++ [2, 4, 9])
    println(s -- [1, 2, 9])
    val evens = TreeSet(2, 4, 6, 8, 10)
    val small = TreeSet(1, 2, 3, 4, 5)
    println(s"${s union evens} ${s intersect small} ${s diff small}")
    println(s"${TreeSet(1, 3).subsetOf(s)} ${small.subsetOf(s)} ${TreeSet.empty[int]().subsetOf(s)}")

    println(s.iterator().toVector)
    println(s.reverseIterator().toList)
    println(s"${s.headOption} ${s.lastOption} ${TreeSet.empty[int]().lastOption}")
    println(s"${s.maxBefore(6)} ${s.maxBefore(7)} ${s.maxBefore(0)} ${s.minAfter(6)} ${s.minAfter(1)} ${s.minAfter(10)}")
    println(s"${s.rangeFrom(4)} ${s.rangeUntil(7)} ${s.range(2, 9)} ${s.range(3, 4)} ${s.range(9, 2)}")
    println(s"${s.rangeTo(7)} ${s.rangeTo(6)} ${s.rangeTo(0)} ${s.iteratorFrom(4).toVector}")
    println(s"${s.head} ${s.last} ${s.firstKey} ${s.lastKey}")
    println(s"${s.min} ${s.max} ${s.sum} ${s.mkString("-")}")

    println(s.filter(x -> x > 4))
    println(s.map(x -> x % 4))
    println(s.map(x -> s"n$x"))
    println(s.collect(match
        x if x > 3 -> -x))
    println(s.flatMap(x -> [x, x * 10]))
    s.foreach(x -> println(x))
    println([1, 2, 3, 4, 5].filter(s))
    println(for x in s if x > 2 yield x * 2)
    println(for x in s if x > 2 if x < 9 yield x)

    val b = TreeSet.newBuilder[string]()
    b.addOne("pear")
    b.addAll(["fig", "apple", "fig"])
    println(b.result())
    val literal: TreeSet[char] = {'z', 'a', 'm', 'a'}
    println(literal)

    val versions = TreeSet(Version(1, 2), Version(0, 9), Version(1, 0))
    println(versions)
    println(versions.minAfter(Version(1, 1)))

    println(s"${s == TreeSet(9, 7, 5, 3, 1)} ${s.hash() == TreeSet(1, 9, 3, 7, 5).hash()} ${s != small}")
    println(s"${s.hash() == Set(1, 3, 5, 7, 9).hash()} ${TreeSet.empty[int]() == TreeSet[int]()}")
    val padded = StringWriter()
    TreeSet(1, 2).display(padded, FormatSpec(width = 8, left = true))
    println(s"[${padded.text}]")

    val words = TreeMap(("b", 2), ("a", 1))
    println(words.keySet.incl("c"))
