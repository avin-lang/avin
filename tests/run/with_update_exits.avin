// expect: exit 0
// A value that leaves the function, by `?`, by a `return` in a branch or by a `return` alone, leaves
// it before the new value is made; the values before it have run, the ones after it have not.

data Point(x: int, y: int)

var log = ""

step(s: string) -> int
  log = log + s
  1

data Triple(a: int, b: int, c: int)

pick(t: Triple, o: Option[int]) -> Option[Triple] = Some(t with {a = step("a"), b = o?, c = step("c")})

early(p: Point, stop: bool) -> Point = p with {y = step("b"), x = if stop then return Point(0, 0) else 5}

always(p: Point) -> Point
  val q = p with {x = return Point(-1, -1)}
  q

main() -> int
  println(pick(Triple(0, 0, 0), Some(7)))
  println(pick(Triple(0, 0, 0), None))
  println(early(Point(1, 2), true))
  println(early(Point(1, 2), false))
  println(always(Point(1, 2)))
  println(log)
  0
