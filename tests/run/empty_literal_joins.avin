// expect: exit 0

// An empty collection literal, `[]` or `{}`, or one holding only such literals, takes its element
// types from what it is joined with: the other elements of a sequence, set or map literal, the other
// branch of an `if`, the other arms of a `match`. Where nothing useful is expected, it is checked
// after them and against the type they agree on, so `{}` beside a map is the empty map.
data Pet(name: string)

pick(n: int) -> Map[string, int] = n match
  0 -> {}
  1 -> {"one": 1}
  _ -> {}

main()
  val c = true
  val d = false
  // Sequence literals.
  val nested = [{1: [2]}, {}]
  val m0: Map[int, Vector[int]] = nested(1)
  println(nested, m0.isEmpty)
  println([{}, {1: 2}])
  println([[], [1]])
  println([[1], []])
  println([{}, {1}])
  println([{1}, {}, {2, 3}])
  println([[], [{}], [{1: 2}]])
  println([[[]], [[1]]])
  println([{1: {}}, {2: {3: "x"}}])
  println([{2: {3: "x"}}, {1: {}}])
  println([[[1]], [[], [2]], [[]]])
  println(if c then {1: {}} else {2: {3: "x"}})
  println([{}, {Pet("rex"): [Some(1), None]}])
  // Set and map literals.
  println({{}, {1}})
  println({1: {2: 3}, 4: {}})
  println({1: {}, 4: {2: 3}})
  println({{}: 1, {2}: 3})
  println({"a": [], "b": [1.5]})
  // `if`.
  println(if c then {1: [2]} else {})
  println(if c then {} else {1: [2]})
  println(if d then {1: [2]} else {})
  println(if c then {1} else {})
  println(if c then [] else [1])
  println(if d then ["x"] else [])
  println(if c then [{}] else [{"k": 'v'}])
  val m = if c then {1: [2]} else {}
  val mt: Map[int, Vector[int]] = m
  println(mt)
  val any: Any = if d then {1: "a"} else {}
  println(any)
  println(if c then {} elif d then {1: 2} else {3: 4})
  // `match`.
  println(pick(0), pick(1), pick(5))
  val x = 2
  val arms = x match
    1 -> {}
    2 -> {"a": 1}
    _ -> {}
  println(arms)
  println(x match
    0 -> []
    _ -> [Pet("tom")])
  val k: Any = x match
    2 -> {}
    _ -> {1}
  println(k)
  println(x match
    2 if c -> {}
    _ -> {1: true})
  // A branch that never finishes takes nothing from it.
  val v = if c then {5: 6} else fail("unreached")
  println(v)
  // The empty map that results behaves as one.
  val settled = if d then {1: "a"} else {}
  println(settled.isEmpty, settled.get(1), settled.getOrElse(2, "none"))
