// expect: trap
// A negative number cannot be an element of a mutable `BitSet`: `add` traps on one, while `contains`
// and `remove` answer `false`.
import avin.collections.mutable.{BitSet as MutableBitSet}

main()
    val s = MutableBitSet(1, 2)
    println(s.contains(-1), s.remove(-1), s)
    s.add(-1)
