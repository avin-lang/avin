// expect: exit 0
// `Any` holds a value of any type: a built-in value is boxed where it converts, and a type pattern
// recovers it with its exact type. A class or trait type pattern matches an instance of a subclass
// or of a conforming class; generic types are told apart by their type arguments.

data Shape
  Circle(r: int)
  Square(side: int)

data Option[+T]
  Some(value: T)
  None

trait Pet
  name() -> string

open class Animal(val legs: int)

open class Dog(val called: string): Animal(4), Pet
  override name() -> string = called

class Puppy(called: string): Dog(called)

class Bird(): Animal(2)

class Cat(): Pet
  override name() -> string = "cat"

class Box[T](val item: T)

describe(x: Any) -> string = x match
  s: string -> s"string $s"
  n: int -> s"int $n"
  l: long -> s"long $l"
  r: real -> s"real $r"
  c: char -> s"char $c"
  b: bool -> s"bool $b"
  _: unit -> "unit"
  _: byte -> "byte"
  sh: Shape -> sh match
    Circle(r) -> s"circle $r"
    Square(side) -> s"square $side"
  t: (int, string) -> t match
    (n, s) -> s"pair $n $s"
  p: Puppy -> s"puppy ${p.name()}"
  d: Dog -> s"dog ${d.name()} with ${d.legs} legs"
  a: Animal -> s"animal with ${a.legs} legs"
  pet: Pet -> s"pet ${pet.name()}"
  bi: Box[int] -> s"box of int ${bi.item}"
  bs: Box[string] -> s"box of string ${bs.item}"
  o: Option[int] -> o match
    Some(v) -> s"some int $v"
    None -> "no int"
  _ -> "something else"

// The binding of a type pattern is in scope in its guard.
sign(x: Any) -> string = x match
  n: int if n < 0 -> "negative int"
  n: int if n > 0 -> "positive int"
  _: int -> "zero"
  _ -> "not an int"

// A downcast from an open class's type to a subclass's is a match with a type pattern.
legs_of_dog(a: Animal) -> int = a match
  d: Dog -> d.legs * 10
  _ -> a.legs

// A function's clauses may take an `Any` apart by type.
size(x: Any) -> int
size(s: string) = 100
size(n: int) = n
size(_) = 0

// A value converted to `Any` in generic code is boxed by its type in each copy.
wrap[T](x: T) -> Any = x

data Holder
  Hold(value: Any)

main() -> int
  println(describe("hi"))
  println(describe(42))
  println(describe(long(7000)))
  println(describe(1.5))
  println(describe('z'))
  println(describe(true))
  println(describe(()))
  println(describe(byte(9)))
  println(describe(Circle(3)))
  println(describe(Square(4)))
  println(describe((5, "five")))
  println(describe((5, 6)))
  println(describe(Puppy("rex jr")))
  println(describe(Dog("rex")))
  println(describe(Bird()))
  println(describe(Cat()))
  println(describe(Box(1)))
  println(describe(Box("one")))
  println(describe(Box(true)))
  println(describe(Some(8)))
  val nothing: Option[int] = None
  println(describe(nothing))
  println(describe(Some("eight")))
  println(sign(-3))
  println(sign(3))
  println(sign(0))
  println(sign("3"))
  println(s"${legs_of_dog(Dog("fido"))} ${legs_of_dog(Bird())}")
  println(s"${size("abc")} ${size(7)} ${size(1.0)}")
  println(describe(wrap(11)))
  println(describe(wrap("eleven")))
  println(describe(wrap(Dog("max"))))
  // `is` with a type pattern.
  val v: Any = Dog("spot")
  if !(v is _: Pet) then return 1
  if v is _: Bird then return 2
  if v is not _: Animal then return 3
  // A value of `Any` kept in data and in a local survives collections, boxed.
  var held = Hold(0)
  var total = 0
  var i = 0
  while i < 50
    i++
    val h = Hold(i * 2)
    val k = Hold(s"n$i")
    held = h
    h match
      Hold(n: int) -> total += n
      _ -> return 4
    k match
      Hold(s: string) -> if s == "" then return 5
      _ -> return 6
  println(s"total $total")
  val kept: Any = if total > 0 then 1 else "none"
  println(describe(kept))
  0
