import avin.io

// `readAll` takes everything left on standard input, terminators and all, after what `readLine` has
// already taken; then the input is at its end.
main()
  println(io.readLine())
  val rest = io.readAll()
  println(debug(rest))
  println(rest.charCount)
  println(debug(io.readAll()))
  println(io.readLine())
