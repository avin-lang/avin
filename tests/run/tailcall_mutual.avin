// expect: exit 0
// A call in tail position of another function replaces the caller's frame, so functions that call
// each other run in constant stack at any depth: `isEven` and `isOdd` ten million deep over `long`,
// and a cycle of three functions whose parameters differ in number and type, a string, a `real` and
// a `data` value among them, a million times round. A call that is not in tail position still nests,
// and is still right at a modest depth.

isEven(n: long) -> bool = if n == 0 then true else isOdd(n - 1)

isOdd(n: long) -> bool = n != 0 && isEven(n - 1)

data Point(x: int, y: int)

first(n: int, label: string, total: real) -> string =
    if n == 0 then s"$label ${total}" else second(n - 1, Point(n, n % 7), total + 0.5)

second(n: int, p: Point, total: real) -> string = third(n, total, p.x + p.y, p)

third(n: int, total: real, sum: int, p: Point) -> string = (sum % 3) match
    0 -> first(n, "zero", total)
    1 -> first(n, "one", total + 1.0)
    _ -> first(n, "two", total - 1.0)

// The sum of 1..n, each level waiting for the next one's result.
countDown(n: int) -> int = if n == 0 then 0 else n + countUp(n - 1)

countUp(n: int) -> int = if n == 0 then 0 else n + countDown(n - 1)

main() -> int
    println(isEven(10000000))
    println(isOdd(10000001))
    println(isEven(7))
    println(first(1000000, "start", 0.0))
    println(first(3, "start", 0.0))
    println(countDown(1000))
    0
