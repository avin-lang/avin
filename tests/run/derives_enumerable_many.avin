main()
    val all = Many.values()
    println(all.length())
    println(s"${all(0)} ${all(255)} ${all(256)} ${all(299)}")
    println(s"${V000.ordinal()} ${V255.ordinal()} ${V256.ordinal()} ${V299.ordinal()}")
    for i in 0..<all.length()
        val m = all(i)
        assert(m.ordinal() == i)
        val digits = s"$i"
        assert(m.name() == "V" + "0".repeat(3 - digits.byteLength()) + digits)
        assert(Many.valueOf(m.name()) == Some(m))
        if i > 0 then assert(all(i - 1) < m)
    println(Many.valueOf("V300"))
    println(Many.valueOf("V0"))
    println(Many.valueOf("V299"))
    // Many vectors at once.
    var kept: List[Vector[Many]] = Nil
    var total = 0
    for round in 0..<200
        val v = Many.values()
        total += v(round % 300).ordinal()
        kept = v :: kept
        assert(Many.valueOf(s"V${round + 100}") == Some(v(round + 100)))
    println(total)
    println(kept.length())
    assert(kept.forall(v -> v == all))
