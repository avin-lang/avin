// expect: trap
// A router checks its routees' supervision where it is asked for, as `spawn` does: a `Restart` with a
// limit less than zero traps in the calling code.
import avin.actors.{Router, Restart}
import avin.time

data Job
  Ping

actor Worker receives Job
  receive
    Ping -> ()

main()
  println(Router.pool(2, Worker(), onFailure = Restart(1, time.seconds(1))))
  Router.pool(2, Worker(), onFailure = Restart(-1, time.seconds(1)))
  println("not reached")
