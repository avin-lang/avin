// expect: exit 0
// `(value: T)` gives a value the type `T` exactly as `val x: T = value` would: a literal of every
// numeric type takes it, `None`, an empty collection and a lambda are typed by it, a value of a
// subtype stands as one of it, and a union's member becomes the union. It is written as an item of
// a parenthesized list: a group, a tuple's part or a call's argument, named or not.

open class Animal(val name: string)
  speak() -> string = "..."

class Dog(n: string): Animal(n)
  override speak() -> string = "woof"

trait Shape
  area() -> int

data Square(side: int)

impl Shape for Square
  area() -> int = side * side

data Cents(amount: long)

impl FromInteger for Cents
  static fromInteger[N: Integer](n: N) -> Cents = Cents(long(n) * 100)

total(xs: Iterable[int]) -> int = xs.foldLeft(0, (a, b) -> a + b)

describe(v: int | string) -> string = v match
  n: int -> s"int $n"
  s: string -> s"string $s"

twice[T](f: T -> T, x: T) -> T = f(f(x))

firstOr[T](xs: Vector[T], fallback: T) -> T = if xs.isEmpty then (fallback: T) else (xs(0): T)

made[T: FromInteger]() -> T = (42: T)

speakAll(xs: Vector[Animal]) -> string = xs.map(_.speak()).mkString(",")

main()
  // Integer literals, at each width's edges and past `long`.
  println((-128: i8))
  println((127: i8))
  println((-32768: i16))
  println((255: byte))
  println((2147483647: int))
  println((3_000_000_000: long))
  println((-9223372036854775808: long))
  println((0x7fff_ffff_ffff_ffff: long))
  println((170141183460469231731687303715884105727: i128))
  println((1: real) / 4)
  println((123456789012345678901234567890: BigInt) * 2)
  println((-1: BigInt))
  println((7: Cents))
  println(made[Cents]())
  println(made[BigInt]())
  // Decimal literals.
  println((2.5: real))
  println((-1.5: real))
  println((0.1: BigDecimal) + (0.2: BigDecimal))
  println((1e-30: BigDecimal))
  println((10: BigDecimal))
  // An ascription in an operation decides the other operand's type.
  val wide = (1: long) + 2147483647
  println(wide)
  // `None`, `Some`, results and empty collections.
  val none = (None: Option[string])
  println(none.getOrElse("empty"))
  println((Some(1): Option[long]).map(n -> n + 4000000000))
  val ok = (Ok(3): Result[int, string])
  println(ok.getOrElse(0))
  val failed = (Err("no"): Result[int, string])
  println(failed.isOk)
  println(([]: List[int]).length)
  println(({}: Map[string, int]).size)
  println(([]: Vector[string]).isEmpty)
  // Lambdas typed by their ascription.
  val double = ((x -> x * 2): int -> int)
  println(double(21))
  val add = ((x, y) -> x + y: (long, long) -> long)
  println(add(4000000000, 1))
  println(twice((_: long) * 3000000000, 1))
  val g: int -> int = x -> x + 1
  println((g: int -> int)(1))
  // A value of a subtype stands as one of the type.
  val a = (Dog("rex"): Animal)
  println(a.speak())
  println(a.name)
  println(speakAll(([Dog("a"), Dog("b")]: Vector[Animal])))
  println((Some(Dog("b")): Option[Animal]).map(x -> x.speak()).getOrElse(""))
  println((Square(3): Shape).area())
  println(total(([1, 2, 3]: Iterable[int])))
  println(total((List(4, 5): Iterable[int])))
  // A union's member becomes the union; a literal and a variable alike.
  println(describe((7: int | string)))
  val i = 3
  val u = (i: int | string)
  println(describe(u))
  println(describe(("hi": int | string)))
  // Tuples, named arguments and nested ascriptions.
  val t = (1: long, "é": int | string)
  println(t.0 + 5000000000)
  println(describe(t.1))
  println(((1, 2): (long, long)))
  println(((7: long): long))
  println(firstOr(fallback = (9: long), xs = []))
  println(firstOr(["a"], "b"))
  println(firstOr(fallback = 8: long, xs = []))
  // At the start of a line, a call with an ascribed name is a call, however many follow.
  println(i: int | string)
  println(i: int | string)
  // An ascription to `Any`, and one inside a closure that captures.
  val anything: Vector[Any] = [(1: Any), "s"]
  println(anything.length)
  val base = 10
  val shift = (n: int) -> (n + base: int | string)
  println(describe(shift(5)))
