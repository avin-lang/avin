// expect: exit 0
// A generic trait's static member with a default body: a type implementing the trait at one type
// argument takes the default, also where another type implements the trait at several and gives each
// member itself. The default is called on the type's name and through a bound, and through a bound it
// is a function value, of the type's own body where it gives one. `Self` in the default is the type.

trait Make[E]
  static make(source: E) -> string = s"made ${Self.kind()}"
  static kind() -> string = "plain"
  static other(source: E) -> string

data Host(name: string)

impl Make[int] for Host
  static other(source: int) -> string = s"host $source"

data Both(name: string)

impl Make[int] for Both
  static make(source: int) -> string = s"both int $source"
  static kind() -> string = "both"
  static other(source: int) -> string = s"both $source"

impl Make[string] for Both
  static make(source: string) -> string = s"both string $source"
  static other(source: string) -> string = s"both $source"

data Pair[A](a: A, b: A)

impl[A] Make[A] for Pair[A]
  static kind() -> string = "pair"
  static other(source: A) -> string = "pair other"

class Gauge(val level: int): Make[bool]
  override static other(source: bool) -> string = s"gauge $source"

one[T: Make[int]](n: int) -> string
  val f = T.make
  val g = T.other
  val k: () -> string = T.kind
  s"${f(n)} ${g(n)} ${k()} ${T.make(n)}"

any[E, T: Make[E]](e: E) -> string
  val f = T.make
  s"${[e, e].map(f)}"

closure[T: Make[int]]() -> (int) -> string
  val f = T.make
  n -> f(n) + "!"

main()
  println(Host.make(1))
  println(Both.make(1))
  println(Both.make("s"))
  println(Pair[int].make(2))
  println(Pair[string].make("p"))
  println(Gauge.make(true))
  println(one[Host](int.MaxValue))
  println(one[Both](2))
  println(one[Pair[int]](int.MinValue))
  println(any[int, Host](1))
  println(any[string, Both]("b"))
  println(any[string, Pair[string]]("ü"))
  println(any[bool, Gauge](false))
  println(closure[Host]()(0))
  println(closure[Both]()(0))
  val f = Host.make
  println(f(7))
  val g = Pair[bool].make
  println(g(true))
