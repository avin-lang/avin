// expect: trap
// A builder whose `variant` answers an index the type does not have is a bug in the builder: the
// build traps, naming the type. Values built before it are printed.
trait Make
    static make(i: int, j: int) -> Result[Self, string]

derive Make for T
    static make(i: int, j: int) -> Result[T, string] = T.build(Bad(i, j))

class Bad(i: int, j: int)
    var done = false

impl ShapeBuilder[string] for Bad
    variant(t: TypeShape) -> Result[int, string] = Ok(i)
    next(v: VariantShape) -> Result[Option[int], string] =
        if done then return Ok(None)
        done = true
        Ok(Some(j))
    duplicate(f: FieldShape) -> string = "dup"

impl Bad
    field[F: Zero](f: FieldShape) -> Result[F, string] = Ok(F.zero())
    missing[F: Zero](f: FieldShape) -> Result[F, string] = Ok(F.zero())

trait Zero
    static zero() -> Self

impl Zero for int
    static zero() -> int = 0

data Shape derives Make
    Circle(radius: int)
    Rect(width: int, height: int)

main()
    println(Shape.make(1, 1))
    println(Shape.make(-1, 0))
