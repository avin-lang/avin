// expect: exit 0
// A connection's errors name its address: `cannot connect to 127.0.0.1:<port>: connection refused`,
// a socket's path, a listener's address, and an accepted connection as a client of the listener;
// the kind still tells them apart.
import avin.fs
import avin.io.{IoError, NotFound, ConnectionRefused, AlreadyExists, Other}
import avin.net.{TcpListener, TcpStream, UnixListener, UnixStream}

kindOf(e: IoError) -> string = e match
    IoError(ConnectionRefused, _, _) -> "refused"
    IoError(NotFound, _, _) -> "not found"
    IoError(AlreadyExists, _, _) -> "exists"
    IoError(Other(_), _, _) -> "other"
    _ -> "else"

// The error with the port, which the platform chooses, written as `PORT`.
show[T](r: Result[T, IoError], port: int)
    r match
        Ok(_) -> println("ok")
        Err(e) -> println(s"${e.toString().replace(port.toString(), "PORT")} [${kindOf(e)}]")

main()
    val listener = TcpListener.bind("127.0.0.1", 0).ok.get
    val port = listener.port()
    // A connection to the listener, accepted: the accepted end is a client of the listener.
    val client = TcpStream.connect("127.0.0.1", port).ok.get
    val served = listener.accept().ok.get
    _ = served.close()
    show(served.read(1), port)
    show(served.writeText("x"), port)
    show(served.readLine(), port)
    show(served.readAll(), port)
    _ = client.close()
    show(client.read(1), port)
    show(client.write(Array.fill(1, byte(0))), port)
    show(client.shutdownOutput(), port)
    _ = listener.close()
    show(listener.accept(), port)
    // Nothing listens there now.
    show(TcpStream.connect("127.0.0.1", port), port)
    // A name that resolves to nothing.
    show(TcpStream.connect("no-such-host.invalid", 80), 0)

    val dir = fs.createTempDir("avin-net-err").ok.get
    val sock = dir + "/s"
    val shown = (r: Result[unit, IoError]) -> r match
        Ok(_) -> println("ok")
        Err(e) -> println(s"${e.toString().replace(dir, "DIR")} [${kindOf(e)}]")
    shown(UnixStream.connect(sock).map(_ -> ()))
    val unixListener = UnixListener.bind(sock).ok.get
    shown(UnixListener.bind(sock).map(_ -> ()))
    shown(UnixListener.bindReplacing(sock).map(_ -> ()))
    val u = UnixStream.connect(sock).ok.get
    val accepted = unixListener.accept().ok.get
    _ = u.close()
    _ = accepted.close()
    shown(u.read(1).map(_ -> ()))
    shown(accepted.writeText("x"))
    _ = unixListener.close()
    shown(unixListener.accept().map(_ -> ()))
    // A socket file nobody listens on any more is refused.
    shown(UnixStream.connect(sock).map(_ -> ()))
    _ = fs.removeDirAll(dir)
