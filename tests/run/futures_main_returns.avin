// expect: exit 4
// The program ends when `main` returns, though futures are still pending: their bodies loop or wait
// for ever on pool threads, and others are queued behind them. What `main` wrote is flushed, and its
// result is the exit status.
import avin.threads.{Future, Promise}

spin() -> int
    var n = 0
    while true
        n = (n + 1) % 1000
    n

main() -> int
    val never = Promise[int]()
    val pending = (0..<64).map(i -> if i % 2 == 0 then Future(spin()) else Future(never.future.await())).toVector()
    val chained = pending(1).map(n -> n + 1)
    println(s"main is done, ${chained.isCompleted()}")
    4
