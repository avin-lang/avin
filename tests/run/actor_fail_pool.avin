// expect: trap
// A trap while an actor holds a pool's resource inside `use` stops the program instead of failing the
// actor: the resource would otherwise never come back. The report still names the actor.
import avin.actors.{Stop, spawn}
import avin.threads.{Channel, Pool}

class Conn(val id: int): Sendable

actor Worker(pool: Pool[Conn, string], done: Channel[int]) receives int
  receive
    n -> done.send(pool.use(c -> c.id * 10 / n).getOrElse(-1))

main()
  val pool = Pool[Conn, string](() -> Ok(Conn(1)), maxSize = 1)
  val done = Channel[int]()
  val w = spawn(Worker(pool, done), onFailure = Stop)
  w.tell(2)
  println(done.receive())
  w.tell(0)
  println(done.receive())
  println("not reached")
