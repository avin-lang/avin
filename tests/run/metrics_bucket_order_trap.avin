// expect: trap
// A histogram's buckets are in increasing order: negative and zero bounds in order are taken, and a
// bound equal to the one before traps.
import avin.metrics.Registry

main()
  val r = Registry()
  println(r.histogram("a", "A.", buckets = [-2.0, 0.0, 0.5]).buckets)
  _ = r.histogram("b", "B.", buckets = [1.0, 2.0, 2.0])
