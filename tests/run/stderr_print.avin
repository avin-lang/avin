// `eprint` writes to standard error with no new line, `eprintln` with one, and `eprintln()` writes a
// bare new line; `eprint()` writes nothing. The variadic forms separate values with `, `.
// expect: exit 0
main()
  print("out ")
  eprint("a")
  eprint("b")
  eprint(1)
  eprintln()
  eprint()
  eprintln("line")
  eprintln()
  eprint(1, 2)
  eprint(" ")
  eprintln(3, "four", 'c')
  eprintln("with\nnewline")
  println("done")
