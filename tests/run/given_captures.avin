// expect: exit 0
// A closure that fills a call from a given captures it, as any value it reads: a lambda and a
// function value made in a block outlive the block and still call with its given, under GC stress,
// each of many made with a given of its own; a lambda in a lambda; a local function reading a given of
// the block around it; a `var` holding a closure reassigned to one taking another given; a function
// value made inside a `using` lambda and returned from it.

data Tx(id: int, label: string)

insert(row: int, using tx: Tx) -> string = s"$row:${tx.label}${tx.id}"

makeAll(n: int) -> Vector[(int) -> string]
  var made: Vector[(int) -> string] = Vector()
  for i in 0..<n
    given tx = Tx(i, s"t${i * 7}")
    val f: (int) -> string = if i % 2 == 0 then insert else row -> insert(row + 1)
    made = made :+ f
  made

nested() -> () -> () -> string
  given tx = Tx(5, "n")
  () -> () -> insert(1)

localReading() -> () -> string
  given tx = Tx(6, "l")
  show() -> string = insert(2)
  show

withTx[T](tx: Tx, body: (Tx) -> T) -> T = body(tx)

main()
  val all = makeAll(6)
  var out: Vector[string] = Vector()
  for f in all
    out = out :+ f(10)
  println(out)
  println(nested()()())
  println(localReading()())
  var current: (int) -> string =
    given first = Tx(1, "a")
    insert
  println(current(3))
  current =
    given second = Tx(2, "b")
    insert
  println(current(3))
  val taken = withTx(Tx(9, "u"), using tx -> insert)
  println(taken(4))
