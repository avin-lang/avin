// expect: exit 0
// Set algebra on the immutable and the mutable set: `++` and `--` take any collection, a mutable set
// changes in place through `+=`, `-=`, `++=` and `--=` on a `val`, and its union, intersect, diff,
// map and flatMap make new mutable sets. Elements are printed sorted, since iteration order is not
// specified.

import avin.collections.mutable.{Set as MutableSet}

show(s: Set[int]) -> string = s.toVector().sorted().mkString(",")

showMutable(s: MutableSet[int]) -> string = s.toVector().sorted().mkString(",")

main()
    val a = Set[int]().added(1).added(2).added(3)
    val b = Set[int]().added(3).added(4)
    val none = Set[int]()

    print(s"[${show(a ++ b)}] [${show(a ++ none)}] [${show(none ++ b)}] [${show(none ++ none)}]")
    print(s"[${show(a ++ [7, 8, 8])}] [${show(a ++ (5..6))}] [${show(a ++ a)}]")
    print(s"[${show(a -- b)}] [${show(a -- none)}] [${show(none -- a)}] [${show(a -- a)}]")
    print(s"[${show(a -- [9, 1, 1])}] [${show(a -- (2..10))}]")
    print(s"[${show(a union b)}] [${show(a intersect b)}] [${show(a diff b)}] ${a.subsetOf(a ++ b)}")
    print(s"[${show(a)}] [${show(b)}]")

    val m = MutableSet[int]()
    val n = MutableSet[int]()
    m += 1
    m += 2
    m += 2
    print(s"[${showMutable(m)}] ${m.size()}")
    m ++= [3, 4, 5]
    m ++= none
    print(s"[${showMutable(m)}]")
    m -= 1
    m -= 99
    print(s"[${showMutable(m)}]")
    m --= Set[int]().added(2).added(5).added(77)
    val noInts: Vector[int] = []
    m --= noInts
    print(s"[${showMutable(m)}]")
    n ++= (10..13)
    print(s"[${showMutable(m)}] [${showMutable(n)}]")

    val u = m.union(n)
    val i = n.intersect(MutableSet[int]().copy())
    val d = n.diff(m)
    print(s"[${showMutable(u)}] [${showMutable(i)}] [${showMutable(d)}] ${m.subsetOf(u)} ${u.subsetOf(m)}")
    u += 100
    print(s"[${showMutable(m)}] [${showMutable(n)}] [${showMutable(u)}]")

    val e = MutableSet[int]()
    print(s"[${showMutable(e.union(m))}] [${showMutable(e.intersect(m))}] [${showMutable(m.diff(e))}] ${e.subsetOf(m)} ${e.subsetOf(e)}")

    val sq = u.map(x -> x % 5)
    val fm = n.flatMap(x -> [x, x + 100])
    print(s"[${showMutable(sq)}] [${showMutable(fm)}] ${MutableSet[int]().map(x -> x).isEmpty()} ${MutableSet[int]().flatMap(x -> [x]).isEmpty()}")

    val r = MutableSet[int]()
    r ++= (1..10)
    r.retain(x -> x % 3 == 0)
    print(s"[${showMutable(r)}]")
    r.retain(x -> true)
    print(s"[${showMutable(r)}]")
    r.retain(x -> false)
    print(s"[${showMutable(r)}] ${r.isEmpty()}")
