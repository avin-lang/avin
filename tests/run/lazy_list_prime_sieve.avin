// expect: exit 0
// The sieve of primes, written as the lazy list it defines: each cell is a prime followed by the
// sieve of what remains once that prime's multiples are filtered out. The right operand of `#::` is
// evaluated only when the cell after the prime is first read, so the endless recursion runs one step
// per prime read. The element type of `primes` is inferred from `sieve`'s result, and the
// placeholder lambda reads `s.head()` again each time it is called.

sieve(s: LazyList[int]) -> LazyList[int] =
    s.head #:: sieve(s.tail.filter(_ % s.head != 0))

val primes = sieve(LazyList.from(2))

main()
    println(primes.take(20).toVector)
    println(primes(99))
    println(primes.isEvaluated())
    println(primes.drop(20).headOption)
    println(primes.takeWhile(_ < 60).toVector)
    val again = sieve(LazyList.from(2))
    println(again.take(5).toVector)
