// expect: trap
// Each of a rate limiter's tokens takes at least a microsecond to come: a thousand a millisecond is
// taken, and a thousand and one a millisecond traps where the limiter is made.
import avin.net.http.RateLimiter
import avin.time.millis

main()
  println(RateLimiter(1000, millis(1)).per)
  println(RateLimiter(1001, millis(1)).per)
