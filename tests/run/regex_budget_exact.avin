// expect: trap
// Each operation run is a step: `a` matching `a` takes two, its character and the end of the
// pattern, so a limit of 2 is enough and a limit of 1 traps.
import avin.regex.Regex

main()
    println(Regex("a").withStepLimit(2).findFirstIn("a"))
    println(Regex("a").withStepLimit(2).findAllIn("aaa").toList)
    println(Regex("a").withStepLimit(1).findFirstIn("a"))
