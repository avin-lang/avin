// expect: exit 0
// Built-in types, strings, tuples and data types compare and hash by value, field by field, with no
// declaration: nested values, every variant of a type with several, generic instances and unit
// included. Equal values have equal hashes.

data Point(x: int, y: int)

data Shape
    Circle(center: Point, radius: real)
    Square(corner: Point, side: real)
    Empty

data Box[T](item: T)

data Chain
    Link(value: string, next: Chain)
    End

data Marked(label: string, mark: unit)

same[T: Eq](a: T, b: T) -> bool = a == b

hashes[T: Hash](a: T, b: T) -> bool = a.hash() == b.hash()

main()
    val p = Point(1, 2)
    print(s"${p == Point(1, 2)} ${p != Point(1, 2)} ${p == Point(2, 1)} ${p != Point(1, 3)}")
    val c = Circle(Point(0, 0), 1.5)
    print(s"${c == Circle(Point(0, 0), 1.5)} ${c == Circle(Point(0, 1), 1.5)} ${c == Square(Point(0, 0), 1.5)}")
    print(s"${Empty == Empty} ${c == Empty} ${Empty != Square(p, 2.0)}")
    print(s"${Box(3) == Box(3)} ${Box("a") == Box("b")} ${Box(Box(p)) == Box(Box(Point(1, 2)))}")
    val chain = Link("a", Link("b", End))
    print(s"${chain == Link("a", Link("b", End))} ${chain == Link("a", End)}")
    print(s"${(1, "x") == (1, "x")} ${(1, "x") == (1, "y")} ${((1, 2), p) == ((1, 2), Point(1, 2))}")
    print(s"${"abc" == "ab" + "c"} ${"abc" != "abd"} ${() == ()} ${true == !false}")
    print(s"${Marked("m", ()) == Marked("m", ())} ${Marked("m", ()) == Marked("n", ())}")
    print(s"${same(p, Point(1, 2))} ${same(3, 3)} ${same("x", "y")} ${same((1, 'a'), (1, 'a'))} ${same(c, Empty)}")
    print(s"${p.hash() == Point(1, 2).hash()} ${c.hash() == Circle(Point(0, 0), 1.5).hash()} ${chain.hash() == Link("a", Link("b", End)).hash()}")
    print(s"${hashes("abc", "ab" + "c")} ${hashes(7, 7)} ${hashes((p, 1), (Point(1, 2), 1))} ${hashes(0.0, -0.0)}")
    print(s"${p.equals(Point(1, 2))} ${Empty.equals(c)} ${5.equals(5)} ${"a".hash() == "a".hash()}")
