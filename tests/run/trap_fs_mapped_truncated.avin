// expect: trap
// A file cut short while it is mapped leaves pages of the mapping with nothing behind them. Reading
// one stops the program with the bus error trap, never with bytes that are not the file's: the
// mapping was made over three pages, the file is emptied by another handle, and the third page is
// read.
import avin.fs

main()
  val dir = fs.createTempDir("avin-mapped-trap").toOption.get
  val path = dir + "/a"
  _ = fs.writeBytes(path, Array.fill(3 * 16384, byte(7)))
  val m = fs.mapFile(path).toOption.get
  println(m(2 * 16384))
  val f = fs.openUpdate(path).toOption.get
  _ = f.setLength(0)
  _ = f.close()
  _ = fs.removeDirAll(dir)
  println(m(2 * 16384 + 1))
