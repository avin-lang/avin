// expect: trap
// A thread whose stack was trimmed while it slept still overflows at its stack's own end: it recurses
// deep, sleeps long enough for the pages below it to be given back, recurses deep again on pages
// committed afresh, and then recurses without a base case, which stops the program with the stack
// overflow trap rather than a fault.
import avin.threads.{sleep, spawn}
import avin.time.millis

depth(n: int) -> int = if n == 0 then 0 else 1 + depth(n - 1)

descend(n: int) -> int = descend(n + 1) + n

main() -> int
  val t = spawn(() ->
    println(depth(20000))
    sleep(millis(50))
    println(depth(20000))
    descend(0))
  println(t.join())
  println("after")
  0
