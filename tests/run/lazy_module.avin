// expect: exit 0
// A module-level `lazy val` is computed on its first read, once, and every later read gives the
// value kept: the initializer's side effect is counted. One never read is never computed. A lazy
// value's initializer reads other module-level values, eager and lazy, which are ready by then; an
// eager value may read a lazy one, which is then computed during initialization.
var computed = 0
var neverComputed = 0

val base = 40

lazy val answer: int = compute()

lazy val unused = neverRun()

lazy val greeting = s"answer is $answer"

val early = greeting + "!"

lazy val nothing: unit = println("a lazy unit value runs once")

lazy val wide = i128(1) << 100

lazy val maybe: Option[string] = Some("kept")

compute() -> int
    computed += 1
    base + 2

neverRun() -> int
    neverComputed += 1
    0

main() -> int
    println(early)
    println(computed)
    println(answer)
    println(answer + answer)
    println(computed)
    println(neverComputed)
    nothing
    nothing
    println(wide + i128(1))
    println(maybe.getOrElse("lost"))
    0
