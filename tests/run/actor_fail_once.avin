// expect: trap
// A trap inside a `Once` body an actor runs stops the program instead of failing the actor, whatever
// its supervision: other threads may be waiting for the body to finish. A trap in the actor after
// the body has finished fails only the actor.
import avin.actors.{Stop, spawn}
import avin.threads.{Channel, Once}

actor Initializer(once: Once, done: Channel[string]) receives int
  receive
    n ->
      once.run(() -> done.send(s"${10 / n}"))
      done.send(s"ran with $n")

main()
  val done = Channel[string]()
  val good = Once()
  val a = spawn(Initializer(good, done), onFailure = Stop)
  a.tell(5)
  println(done.receive().get)
  println(done.receive().get)
  // The body has run, so it does not run again, and nothing traps.
  a.tell(0)
  println(done.receive().get)
  val bad = Once()
  val b = spawn(Initializer(bad, done), onFailure = Stop)
  b.tell(0)
  println(done.receive())
  println("not reached")
