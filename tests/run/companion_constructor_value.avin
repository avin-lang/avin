// expect: exit 0

// A class whose companion object declares no `apply` is made by its name where a function is
// expected, as in call position: the name is the class's constructor, generic or not, while
// elsewhere it is the companion object, whose members it reaches.

import avin.actors.Isolated

class Box(val n: int)
  show() -> string = s"Box($n)"

object Box
  zero() -> Box = Box(0)

class Pair[A](val a: A, val b: A)

object Pair
  same[A](x: A) -> Pair[A] = Pair(x, x)

class Named(val name: string)

object Named
  apply(n: int) -> Named = Named(s"#$n")

apply2[A, B](f: (A) -> B, x: A) -> B = f(x)

main()
  val mk: (int) -> Box = Box
  println(mk(3).show(), Box.zero().show())
  println(apply2(Box, 7).show())
  val pair: (string, string) -> Pair[string] = Pair
  val p = pair("é", "ü")
  println(p.a, p.b, Pair.same(1).b)
  val boxes = [1, 2].map(Box)
  println(boxes.map(b -> b.n))
  val byNumber: (int) -> Named = Named
  val byName: (string) -> Named = Named
  println(byNumber(4).name, byName("x").name)
  val iso: (Vector[int]) -> Isolated[Vector[int]] = Isolated
  println(iso([1, 2, 3]).with(v -> v.length))
