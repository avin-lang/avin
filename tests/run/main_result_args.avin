// expect: exit 1
// args: 12 x 30
// `main(args: Vector[string])` may answer with a `Result` too: the arguments arrive as for any
// `main`, and the first that is not a number ends the program with its error.
main(args: Vector[string]) -> Result[unit, string]
  var total = 0
  for a in args
    total += a.toIntOption().okOr(s"`$a` is not a number")?
    println(s"total $total")
  Ok(())
