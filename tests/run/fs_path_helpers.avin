// expect: exit 0
// The path helpers of `avin.fs` that answer from the text alone: root, isHidden, withFileName,
// withExtension, sibling, and the component-wise startsWith and endsWith, at the root, with trailing
// and doubled separators, dotfiles, `.` and `..`, the empty path and names beyond ASCII.
import avin.fs

main()
  println("-- root")
  for p in ["/", "/a", "//a", "a", "", "./a"] do println(s"[$p] ${fs.root(p)}")
  println("-- isHidden")
  for p in [".git", "a/.git", "a/.git/", ".a/b", "a/b", "/", "", ".", "..", "a/..", "a/.", "..x", ".文件", "文件"] do
    println(s"[$p] ${fs.isHidden(p)}")
  println("-- withFileName")
  for (p, n) in [
    ("/a/b.txt", "c"),
    ("/a/b/", "c"),
    ("a", "c"),
    ("a/b", "c.d"),
    ("/a", "c"),
    ("/", "c"),
    ("", "c"),
    (".", "c"),
    ("..", "c"),
    ("a/..", "c"),
    ("/a/b", ""),
    ("a", ""),
    ("/a", ""),
    ("/a/b", "x/y"),
    ("ünï/文件.txt", "名前"),
    ("/a//b", "c"),
    ("a/b", ".hidden")
  ] do println(s"[$p] [$n] [${fs.withFileName(p, n)}]")
  println("-- withExtension")
  for (p, e) in [
    ("a.tar.gz", "xz"),
    ("a", "txt"),
    ("a.txt", ""),
    ("/d/a.txt", "md"),
    ("a/b/", "x"),
    (".profile", "bak"),
    (".config.json", "yml"),
    ("a.", "x"),
    ("a.", ""),
    ("/", "x"),
    ("", "x"),
    (".", "x"),
    ("..", "x"),
    ("a/..", "x"),
    ("文件.txt", "文"),
    ("a", ""),
    ("/a.b/c", "d"),
    ("a.txt", "tar.gz")
  ] do println(s"[$p] [$e] [${fs.withExtension(p, e)}]")
  println("-- sibling")
  for (p, n) in [
    ("/a/b", "c"),
    ("b", "c"),
    ("/b", "c"),
    ("a/b/", "c"),
    ("/", "c"),
    ("", "c"),
    (".", "c"),
    ("a/..", "c"),
    ("/a/b", "/etc"),
    ("/a/b", "x/y"),
    ("/a/b", ""),
    ("a/b", ".."),
    ("ünï/文件", "名前")
  ] do println(s"[$p] [$n] ${fs.sibling(p, n)}")
  println("-- startsWith")
  for (p, x) in [
    ("/a/b", "/a"),
    ("/a/b", "/"),
    ("/a/b", "/a/b"),
    ("/a/b", "/a/b/c"),
    ("/ab", "/a"),
    ("/a/b", "a"),
    ("a/b", "/a"),
    ("a/b", "a"),
    ("a/b", ""),
    ("/a", ""),
    ("", ""),
    ("/", "/"),
    ("/", ""),
    ("", "/"),
    ("/a//b/", "/a/b"),
    ("a/b/", "a/b"),
    ("a/./b", "a/b"),
    ("a/../b", "a"),
    ("//a", "/a"),
    ("ünï/文件", "ünï"),
    ("ünï/文件", "ün"),
    ("a/b", "a/b/")
  ] do println(s"[$p] [$x] ${fs.startsWith(p, x)}")
  println("-- endsWith")
  for (p, x) in [
    ("/a/b/c", "c"),
    ("/a/b/c", "b/c"),
    ("/a/b/c", "/a/b/c"),
    ("/a/b/c", "/c"),
    ("/a/b/c", "bc"),
    ("/a/b/c", "a/b/c/d"),
    ("a/b/c", "/a/b/c"),
    ("a/b/c", "a/b/c"),
    ("a/b", ""),
    ("", ""),
    ("/", "/"),
    ("/", ""),
    ("/a", "/"),
    ("", "a"),
    ("/a", "a"),
    ("/a", "/a"),
    ("a", "/a"),
    ("a/b/", "b"),
    ("a/b", "b/"),
    ("a/../b", "../b"),
    ("ünï/文件", "文件"),
    ("ünï/文件", "件")
  ] do println(s"[$p] [$x] ${fs.endsWith(p, x)}")
  println("-- round trips")
  val p = "/srv/app/data.tar.gz"
  println(fs.withExtension(fs.withExtension(p, "xz"), "gz") == p)
  println(fs.withFileName(p, fs.fileName(p).getOrElse("")) == p)
  println(fs.sibling(p, fs.fileName(p).getOrElse("")) == p)
  println(fs.startsWith(p, fs.parent(p).getOrElse("")) && fs.endsWith(p, fs.fileName(p).getOrElse("")))
