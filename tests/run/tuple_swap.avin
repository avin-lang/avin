// expect: exit 0
// `swap` turns a pair round, at every pair of types: scalars at their bounds, strings, objects,
// nested pairs (only the outer one turns), options; through a generic function, a method value and a
// lambda taking pairs, and swapped twice it is the pair it was.

data Point(x: int, y: int)

class Box(val label: string)

flip[A, B](p: (A, B)) -> (B, A) = p.swap

main()
    println((1, "one").swap)
    println((-2147483648, 2147483647).swap)
    println(("", "ünïcode ✓").swap)
    println((Point(1, 2), 'z').swap)
    val box = Box("b")
    val turned = (box, 3).swap
    println(turned.0, turned.1 === box)
    println(((1, 2), (3, 4)).swap)
    val options: (Option[int], Option[string]) = (Some(1), None)
    println(options.swap)
    val p = (true, 0.5)
    println(p.swap.swap == p)
    val back: (real, bool) = p.swap
    println(back)
    println(flip((7, "seven")), flip(("x", (1, 2))))
    // `swap` has no method value, being parameterless; a lambda reads it later.
    val later = () -> (1, "a").swap
    println(later())
    println([(1, "a"), (2, "b")].map(q -> q.swap))
    println({"k": 1, "j": 2}.toVector.map(q -> q.swap).sorted)
    var total = 0
    for i in 0..<4000
        total += (s"$i", i).swap.0
    println(total)
