import avin.io

// `lines()` iterates the lines left on standard input, read as it advances, so it picks up after a
// `readLine` and leaves nothing behind; `hasNext` asks without taking a line.
main()
  println(io.readLine())
  val it = io.lines()
  println(it.hasNext())
  println(it.hasNext())
  for line in it do println(s"[$line]")
  println(it.hasNext())
  println(io.readLine())
