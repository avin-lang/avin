// expect: exit 0
// A union converts to a type each of its members converts to: `Dog | Cat` is an `Animal`,
// `int | long` an `Any` (and matched back), `int | string` a `Display`. Through a covariant type
// argument a union of references is seen with no conversion, laid out as an `Any` is:
// `List[Dog] <: List[Dog | Cat]`, `Option[Dog | Cat] <: Option[Animal]`, and a `Result[T, IoError]`
// is a `Result[T, IoError | ParseError]`, the same object holding the same array. Function types
// follow: `(Dog | Cat) -> int` is a `(Dog) -> int`, `() -> Dog` a `() -> Dog | Cat`, and a named
// function with a union parameter is made, where it is written, into a function of one member.

trait Animal
    name() -> string

class Dog(n: string): Animal
    override name() -> string = n

class Cat(n: string): Animal
    override name() -> string = n

data IoError(path: string)
data ParseError(line: int)

describe(x: int | string) -> string = x match
    n: int -> s"number $n"
    s: string -> s"text $s"

animalName(a: Animal) -> string = a.name()

back(a: Any) -> string = a match
    n: int -> s"int $n"
    l: long -> s"long $l"
    _ -> "other"

shown(d: Display) -> string = s"[$d]"

letters(x: Dog | Cat) -> int = animalName(x).charCount()

read(ok: bool, cells: Array[int]) -> Result[Array[int], IoError]
    if ok then Ok(cells) else Err(IoError("missing"))

load(ok: bool, cells: Array[int]) -> Result[Array[int], IoError | ParseError] = read(ok, cells)

makeDog() -> Dog = Dog("made")

errorText(e: IoError | ParseError) -> string = e match
    IoError(p) -> s"io $p"
    ParseError(n) -> s"parse $n"

main()
    val dc: Dog | Cat = Cat("tom")
    println(animalName(dc))
    val rex = Dog("rex")
    val same: Dog | Cat = rex
    println(s"${same === rex} ${same === dc}")
    val il: int | long = 5_000_000_000
    println(back(il))
    val small: int | long = 7
    println(back(small))
    val anything: Any = small
    println(back(anything))
    val text: int | string = 9
    println(shown(text))
    val dogs: List[Dog] = List(Dog("a"), Dog("b"))
    val pets: List[Dog | Cat] = dogs
    println(pets.map(p -> animalName(p)))
    val od: Option[Dog | Cat] = Some(Dog("o"))
    val oa: Option[Animal] = od
    println(oa.map(a -> a.name()))
    val cells = Array.fill(3, 0)
    load(true, cells) match
        Ok(a) -> println(a === cells)
        Err(e) -> println(errorText(e))
    load(false, cells) match
        Ok(_) -> println("no")
        Err(e) -> println(errorText(e))
    val f: (Dog) -> int = letters
    println(f(Dog("four")))
    val g: () -> Dog | Cat = makeDog
    println(animalName(g()))
    val h: (int) -> string = describe
    println(h(12))
    val k: (string) -> string = describe
    println(k("s"))
    val ints = [1, 2].map(describe)
    println(ints)
    val sendable: @sendable (int) -> int | string = n -> if n > 0 then n else "not positive"
    println(describe(sendable(-1)))
    println(describe(sendable(3)))
    val plain: (int) -> int | string = sendable
    println(describe(plain(5)))
