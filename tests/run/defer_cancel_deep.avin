// expect: exit 0
// Deferred statements reached by a deep recursion all run when a cancellation stops it at the
// bottom, the deepest first, each holding what it captured: a parameter, a `var` changed after the
// `defer`, an object made for it. Deferred statements run on the ordinary path, a loop's ten thousand
// turns and a recursion as it returns, leave nothing behind for a later cancellation to run.
import avin.threads.{Atomic, Channel, scope, sleep}
import avin.time.{hours, millis}

class Note(val text: string)

down(depth: int, log: Channel[string], started: Atomic[int])
  var seen = "unset"
  val note = Note(s"note $depth")
  defer log.send(s"$depth: $seen, ${note.text}")
  seen = "set"
  if depth == 0
    started.add(1)
    sleep(hours(1))
  else down(depth - 1, log, started)

returning(depth: int, total: Atomic[int]) -> int
  defer total.add(1)
  if depth == 0 then 0 else 1 + returning(depth - 1, total)

worker(log: Channel[string], started: Atomic[int], total: Atomic[int])
  defer log.send("worker")
  for i in 0 ..< 10000
    defer total.add(1)
  println(returning(30, total))
  down(20, log, started)

main()
  val log = Channel[string](64)
  val started = Atomic(0)
  val total = Atomic(0)
  scope(s ->
    s.spawn(() -> worker(log, started, total))
    while started.load() == 0 do sleep(millis(1))
    s.cancel())
  println(total.load())
  while log.tryReceive() is Some(line) do println(line)
