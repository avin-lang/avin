// expect: exit 0

// A value of a type parameter bounded by a trait is a value of that trait wherever the trait is
// expected, whatever the instance: a built-in value is boxed as the trait's value, as it is where its
// own type is written, and an object, a data value or a string is taken as it is.
trait Show
  show -> string

// A default body passing its receiver on as a trait: `Self` is a type parameter there too.
trait Again: Show
  again -> string = twice(self)

opaque type Code = int
opaque type Label = string

impl Show for Code
  show -> string = s"code $repr"

impl Again for Code

impl Show for Label
  show -> string = s"label $repr"

impl Again for Label

impl Show for int
  show -> string = s"int $self"

impl Show for long
  show -> string = s"long $self"

impl Show for real
  show -> string = s"real $self"

impl Show for bool
  show -> string = s"bool $self"

impl Show for byte
  show -> string = s"byte ${int(self)}"

impl Show for char
  show -> string = s"char $self"

impl Show for string
  show -> string = s"string $self"

class Point(x: int, y: int): Again
  override show -> string = s"point $x $y"

data Shape
  Circle(r: int)
  Dot

impl Show for Shape
  show -> string = self match
    Circle(r) -> s"circle $r"
    Dot -> "dot"

impl Again for Shape

one(item: Show) -> string = item.show
twice(item: Show) -> string = item.show + "/" + item.show
many(items: Show*) -> string = items.map(i -> i.show).mkString(", ")

viaSingle[T: Show](v: T) -> string = one(v)
viaMany[T: Show](a: T, b: T) -> string = many(a, b)
viaOption[T: Show](v: T) -> Option[Show] = Some(v)
viaVector[T: Show](a: T, b: T) -> Vector[Show] = [a, b]
asShow[T: Show](v: T) -> Show = v

viaLocal[T: Show](v: T) -> string =
  val s: Show = v
  s.show

viaNested[T: Show](v: T) -> string = viaSingle(v) + " | " + viaInner(v)
viaInner[U: Show](u: U) -> string = asShow(u).show
viaClosure[T: Show](v: T) -> () -> string = () -> one(v)
viaAgain[T: Again](v: T) -> string = v.again + " ; " + twice(v)

class Holder(item: Show)
  describe -> string = item.show

viaField[T: Show](v: T) -> Holder = Holder(v)

// A type parameter's value taken out of a union, and a union of two type parameters.
pick[T: Show](v: T | bool) -> string = v match
  b: bool -> s"bool $b"
  t: T -> one(t)

either[T: Show, U: Show](flag: bool, a: T, b: U) -> string = one(if flag then a else b)

// A core trait, which tuples conform to through the core library's impls.
asDisplay[T: Display](v: T) -> Display = v
viaDisplay[T: Display](v: T) -> string = s"[${asDisplay(v)}]"

class Shower(prefix: string)
  render[T: Show](v: T) -> string = prefix + one(v)

all[T: Show](v: T)
  println(viaSingle(v))
  println(viaMany(v, v))
  println(viaOption(v).map(s -> s.show).getOrElse("none"))
  println(viaVector(v, v).map(s -> s.show).mkString(" & "))
  println(asShow(v).show)
  println(viaLocal(v))
  println(viaNested(v))
  println(viaClosure(v)())
  println(viaField(v).describe)
  println(Shower("> ").render(v))

main()
  all(7)
  all(-2147483648)
  all(long(9223372036854775807))
  all(2.5)
  all(true)
  all(false)
  all(byte(255))
  all('é')
  all("hi")
  all(Point(1, 2))
  all(Circle(4))
  all(Dot)
  all(Code(42))
  all(Label("tag"))
  println(viaAgain(Point(5, 6)))
  println(viaAgain(Circle(7)))
  println(viaAgain(Code(-1)))
  println(viaAgain(Label("x")))
  println(pick[int](5))
  println(pick[real](true))
  println(pick("s"))
  println(either(true, 1, "x"))
  println(either(false, 1, "x"))
  println(either(false, 'c', long(-1)))
  println(viaDisplay(3))
  println(viaDisplay(4.25))
  println(viaDisplay('z'))
  println(viaDisplay((3, true)))
  println(viaDisplay(("a", (1, 'b'))))
  println(viaDisplay(Some(5)))
  // Many boxes made and dropped while the earlier ones are still held.
  var kept: Vector[Show] = []
  for i in 0 ..< 2000
    kept = kept :+ asShow(i)
    kept = kept :+ asShow(i % 2 == 0)
    kept = kept :+ asShow(real(i) * 0.5)
  println(kept.length)
  println(kept(3998).show)
  println(kept(5999).show)
