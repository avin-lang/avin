// expect: exit 0
// `map` on a map answers a map where its function makes pairs, and a collection of the results, in
// the map's iteration order, where it makes anything else; `flatMap` likewise. The function may take
// the key and the value, or the entry as one pair, and may be a lambda, a `match` function or a
// method value. The same holds for every kind of map, and for a `for` comprehension over one.
import avin.collections.mutable

data Summary(user: string, count: int)

summarize(k: string, v: int) -> Summary = Summary(k, v)

summarizeEntry(e: (string, int)) -> Summary = Summary(e.0, e.1)

swap(k: string, v: int) -> (int, string) = (v, k)

// A generic function mapping a map it knows only as a `Map`.
keysOf[K, V](m: Map[K, V]) -> Iterable[K] = m.map((k, _) -> k)

inverted[K, V](m: Map[K, V]) -> Map[V, K] = m.map((k, v) -> (v, k))

main()
    val m: Map[string, int] = {"ä": 1}
    println(m.map((k, v) -> Summary(k, v)))
    println(m.map(e -> e.0))
    println(m.map(match (k, v) -> s"$k=$v"))
    println(m.map(summarize))
    println(m.map(summarizeEntry))
    println(m.map((k, v) -> v * 2))
    println(m.map((_, _) -> ()))
    // A pair still makes a map, by either shape of function.
    println(m.map((k, v) -> (v, k)))
    println(m.map(e -> (e.1, e.0)))
    println(m.map(swap))
    println(m.map((k, v) -> ((k, v), v)))
    // A function answering a pair of pairs or a triple: only a pair makes a map.
    println(m.map((k, v) -> (k, v, k)))
    println(m.flatMap(e -> [e.0, e.0]))
    println(m.flatMap(e -> [(e.1, e.0)]))
    println(keysOf(m), inverted(m))

    // A closure capturing a local, on many entries.
    var big: Map[int, int] = {}
    for i in 0..<300 do big = big.updated(i, i * i)
    val offset = 7
    println(big.map((k, v) -> v - k + offset).toVector.sorted.take(3))
    println(big.map((k, v) -> (k % 3, v)).size)

    // An empty map maps to an empty collection.
    val empty: Map[string, int] = {}
    println(empty.map((k, v) -> Summary(k, v)), empty.map((k, v) -> (v, k)))

    // Comprehensions.
    println(for (k, v) in m yield Summary(k, v))
    println(for (k, v) in m if v > 0 yield s"$k$v")
    println(for (k, v) in m if v > 0 yield (v, k))
    println(for (k, v) in m, x in [1, 2] yield x + v)
    println(for (k, v) in m if v > 5 yield k)

    // The other maps.
    val tree: TreeMap[int, string] = {2: "b", 1: "a", 3: "c"}
    println(tree.map((k, v) -> v), tree.map((k, v) -> (k * 10, v)), tree.map(e -> e.1 + e.1))
    println(for (k, v) in tree if k > 1 yield v)
    println(for (k, v) in tree if k > 1 yield (v, k))
    println(tree.flatMap(e -> [e.0]))
    val ordered = OrderedMap(("z", 1), ("y", 2))
    println(ordered.map((k, v) -> k), ordered.map((k, v) -> (v, k)))
    val mm = mutable.Map[string, int]()
    mm("q") = 26
    println(mm.map((k, v) -> Summary(k, v)), mm.map((k, v) -> (v, k)), mm.map(e -> e.1))
    println(for (k, v) in mm if v > 0 yield k)
    println(for (k, v) in mm if v > 0 yield (k, v + 1))
    val linked = mutable.LinkedMap[string, int]()
    linked("first") = 1
    linked("second") = 2
    println(linked.map((k, v) -> k), linked.map((k, v) -> (v, k)))
    println(for (k, v) in linked if v > 1 yield k)
    val mt = mutable.TreeMap[int, string]()
    mt(2) = "two"
    mt(1) = "one"
    println(mt.map((k, v) -> v), mt.map((k, v) -> (k + 1, v)))
    println(for (k, v) in mt if k > 0 yield v)
    println(for (k, v) in mt if k > 0, c in [k, k] yield c)
