// A list, vector or array of ordered elements has `max` and `min`: `None` when empty, the element
// itself when there is one, and the first of equal ones; a type with its own `Ord` orders by it.
data Ranked(rank: int, name: string)

impl Ord for Ranked
    compare(other: Ranked) -> int = rank.compare(other.rank)

main()
    val list: List[int] = [3, -1, 7, 7, 0]
    print(list.max().getOrElse(0))
    print(list.min().getOrElse(0))
    val none: List[string] = []
    print(none.max().isEmpty())
    val one: Vector[string] = ["only"]
    print(one.max().getOrElse("none"))
    print(one.min().getOrElse("none"))
    val words: Vector[string] = ["pear", "apple", "quince"]
    print(words.min().getOrElse("none"))
    val reals: Array[real] = [2.5, -0.5, 1.0]
    print(reals.max().getOrElse(0.0))
    val empty: Array[int] = Array.empty()
    print(empty.min().isEmpty())
    val ranked: List[Ranked] = [Ranked(2, "first"), Ranked(5, "high"), Ranked(5, "later"), Ranked(1, "low")]
    val nobody = Ranked(0, "nobody")
    print(ranked.max().getOrElse(nobody).name)
    print(ranked.min().getOrElse(nobody).name)
