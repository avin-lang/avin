// A list, vector or array of ordered elements has `maxOption` and `minOption`: `None` when empty,
// the element itself when there is one, and the first of equal ones; a type with its own `Ord`
// orders by it. `max` and `min` answer the element itself, with the same choice among equal ones.
data Ranked(rank: int, name: string)

impl Ord for Ranked
    compare(other: Ranked) -> int = rank.compare(other.rank)

main()
    val list: List[int] = [3, -1, 7, 7, 0]
    println(list.maxOption.getOrElse(0))
    println(list.minOption.getOrElse(0))
    val none: List[string] = []
    println(none.maxOption.isEmpty())
    val one: Vector[string] = ["only"]
    println(one.maxOption.getOrElse("none"))
    println(one.minOption.getOrElse("none"))
    val words: Vector[string] = ["pear", "apple", "quince"]
    println(words.minOption.getOrElse("none"))
    val reals: Array[real] = [2.5, -0.5, 1.0]
    println(reals.maxOption.getOrElse(0.0))
    val empty: Array[int] = Array.empty()
    println(empty.minOption.isEmpty())
    val ranked: List[Ranked] = [Ranked(2, "first"), Ranked(5, "high"), Ranked(5, "later"), Ranked(1, "low")]
    val nobody = Ranked(0, "nobody")
    println(ranked.maxOption.getOrElse(nobody).name)
    println(ranked.minOption.getOrElse(nobody).name)
    println(s"${list.max} ${list.min} ${one.max} ${reals.min} ${ranked.max.name} ${ranked.min.name}")
    println(s"${ranked.maxBy(r -> r.rank).name} ${ranked.minBy(r -> -r.rank).name} ${words.maxBy(w -> w.charCount())}")
