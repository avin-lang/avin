// expect: exit 0
// Closing a child's standard input is the end of its input: `wc -c` counts what was written and
// answers once the input is closed, not before; a child whose input is closed before anything is
// written reads none; `cat` waits for more for as long as the input stays open, and ends by itself
// once it is closed. Closing an end twice does nothing, and an end the child never used closes
// cleanly.
import avin.io.IoError
import avin.process.Command
import avin.threads.sleep
import avin.time.millis

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

counted(text: string) -> string
  val child = Command("wc", "-c").pipeInput().pipeOutput().start().ok.get
  ok(child.stdin().writeText(text))
  // Nothing is answered while the input is still open.
  sleep(millis(50))
  val early = child.stdout().readable()
  ok(child.stdin().close())
  val answer = string.fromUtf8Lossy(ok(child.stdout().readAll())).trim
  _ = child.waitFor().ok.get
  s"$answer (answered before the end: $early)"

main() -> int
  println(counted("hello"))
  println(counted(""))
  println(counted("ünïcödé\n"))
  println(counted("x".repeat(200000)))

  // `cat` runs for as long as its input is open, and ends once it is closed.
  val cat = Command("cat").pipeInput().pipeOutput().start().ok.get
  sleep(millis(50))
  println(s"cat alive with its input open: ${cat.isAlive()}")
  ok(cat.stdin().close())
  ok(cat.stdin().close())
  println(s"its output then ends: ${ok(cat.stdout().readAll()).length}")
  println(s"cat ended: ${cat.waitFor().ok.get}")

  // A child that never reads its input: closing it does nothing to the child.
  val echo = Command("echo", "hi").pipeInput().pipeOutput().start().ok.get
  println(s"echo: ${ok(echo.stdout().readLine()).get}")
  println(s"echo ended: ${echo.waitFor().ok.get}")
  ok(echo.stdin().close())
  ok(echo.stdout().close())
  0
