// A command runs one program with the program's own streams and answers how it ended: an exit code,
// a signal, or a program that could not be started. A string runs as a command line once
// `avin.process` is imported, split at white space with no shell.
import avin.process.{Command, CommandError, ExitStatus, Exited, Signalled, TimedOut, Io, Failed}
import avin.io

describe(s: ExitStatus) -> string = s match
  Exited(code) -> s"exited $code, success ${s.isSuccess}"
  Signalled(n) -> s"signal $n, success ${s.isSuccess}"
  TimedOut -> s"timed out, success ${s.isSuccess}"

main()
  // The child writes straight to the program's standard output.
  println(Command("/bin/echo", "hello", "two words").run())
  println(Command("/usr/bin/true").run().map(describe))
  println(Command("/usr/bin/false").run().map(describe))
  println(Command("/bin/sh", "-c", "exit 3").run().map(describe))
  println(Command("/bin/sh", "-c", "exit 255").run().map(describe))
  // Killed by a signal, which is not an exit code.
  println(Command("/bin/sh", "-c", "kill -9 $$").run().map(describe))
  println(Command("/bin/sh", "-c", "kill -15 $$").run().map(describe))
  // A program without a `/` is looked for on PATH.
  println(Command("echo", "found on PATH").run())
  // An argument is passed as it is: a space, a quote and a `$` reach the program unread.
  println(Command("/bin/echo", "a  b", "'q'", "$HOME").output())
  // A program that is not there fails to start.
  println(Command("avin-no-such-program").run())
  println(Command("/avin/no/such/program").run())
  println(Command("avin-no-such-program").output())
  Command("avin-no-such-program").output() match
    Err(Io(e)) -> println(e == io.NotFound)
    _ -> println("unexpected")
  // A string is a command line.
  println("/bin/echo from   a  string".run())
  println("/bin/echo captured from a string".output())
  println("/usr/bin/false".output())
  println(Command.parse("  /bin/echo   parsed\tline  ").output())
  // Failed carries the status.
  Command("/bin/sh", "-c", "exit 7").output() match
    Err(Failed(status)) -> println(describe(status))
    _ -> println("unexpected")
  println(Exited(0).isSuccess)
  println(Exited(1).isSuccess)
  println(Signalled(9).isSuccess)
  println(TimedOut.isSuccess)
