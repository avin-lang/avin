// expect: exit 0
// An override or an implementation may keep the bounds of the method it overrides, drop them, write
// one a kept bound requires or a superclass of a class bound, rename the type parameters, or bound a
// type parameter by a trait every type has; each is called through the base type and its own.
trait Shape
    area() -> int

trait Named: Shape
    name() -> string

open class Animal
    sound() -> string = "..."

open class Dog: Animal
    override sound() -> string = "woof"

class Square(val side: int): Named derives Display
    override area() -> int = side * side
    override name() -> string = "square"

open class A
    same[U: Named](x: U) -> string = x.name()
    weaker[U: Named](x: U) -> string = "a"
    dropped[U: Ord](x: U) -> string = "a"
    renamed[U: Shape, V: Named](x: U, y: V) -> int = x.area()
    classes[U: Dog](x: U) -> string = x.sound()
    universal[U](x: U) -> string = "a"

class B: A
    override same[U: Named](x: U) -> string = s"b ${x.name()}"
    override weaker[U: Shape](x: U) -> string = s"b ${x.area()}"
    override dropped[U](x: U) -> string = "b dropped"
    override renamed[P: Shape, Q: Shape](x: P, y: Q) -> int = x.area() + y.area()
    override classes[U: Animal](x: U) -> string = s"b ${x.sound()}"
    override universal[U: Eq + Hash](x: U) -> string = "b universal"

trait Shower
    show[T: Display + Named](x: T) -> string
    describe[T: Named](x: T) -> string = "default"

class S: Shower
    override show[T: Display](x: T) -> string = s"shown $x"
    override describe[T: Shape](x: T) -> string = s"area ${x.area()}"

data Box(n: int)

impl Shower for Box
    show[T: Named](x: T) -> string = s"box ${x.name()}"

impl Shower for int
    show[T](x: T) -> string = s"int $self"
    describe[T](x: T) -> string = "int describe"

main() -> int
    val sq = Square(3)
    val a: A = B()
    println(a.same(sq))
    println(a.weaker(sq))
    println(a.dropped(1))
    println(a.renamed(sq, sq))
    println(a.classes(Dog()))
    println(a.universal(sq))
    val b = B()
    println(b.weaker(sq))
    println(b.classes(Animal()))
    val shown: List[Shower] = [S(), Box(1), 7]
    for s in shown
        println(s.show(sq))
        println(s.describe(sq))
    0
