// expect: exit 0
// A union conforms to a trait every member conforms to whose methods take `Self` only as their
// receiver: `Display` and `Debug` (printing, interpolation, `toString`, `debug`, a field width, a
// `[T: Display]` bound), a library's generic traits through the members' join (`Vector` and `List`
// are both a `Seq`), and a program's own traits, implemented by classes and by built-in types alike.
// A call through one runs the member's own method. `u.m()` is looked up on the members' join first:
// a trait, or an open class whose overrides are called; its fields are read and its methods named
// as values too. A union is `Sendable` where every member is.

trait Sized
    size() -> int
    doubled() -> int = size() * 2

class Bag(n: int): Sized
    override size() -> int = n

impl Sized for string
    size() -> int = charCount
    doubled() -> int = size() * 2

impl Sized for int
    size() -> int = self
    doubled() -> int = self * 2

trait Animal
    name() -> string

class Dog(n: string): Animal
    override name() -> string = n

class Cat(n: string): Animal
    override name() -> string = s"cat $n"

open class Pet(val called: string)
    sound() -> string = "..."
    greet(other: string) -> string = s"$called greets $other"

class Puppy(called: string): Pet(called)
    override sound() -> string = "yip"

class Kitten(called: string): Pet(called)

// A trait requiring another: a union reaches both through the nearer one.
trait Labelled: Sized
    label() -> string

class Tag(t: string): Labelled
    override size() -> int = t.charCount
    override label() -> string = s"#$t"

class Note(t: string): Labelled
    override size() -> int = 1
    override label() -> string = s"note $t"

shown[T: Display](x: T) -> string = s"<$x>"

total[T: Sized](xs: Vector[T]) -> int = xs.map(x -> x.size()).sum

hashed[T: Hash](x: T) -> long = x.hash()

pet(a: Dog | Cat) -> string = a.name()

describe(v: int | string) -> string = v.toString()

sent[T: Sendable](x: T) -> string = "sent"

main()
    // Display, Debug and formatting.
    val u: int | string = 3
    val t: int | string = "two"
    println(u)
    println(t)
    println(s"[$u] [$t] [${u.toString()}] [${describe(t)}]")
    println(debug(u))
    println(debug(t))
    println(f"[${u}%5s] [${t}%-5s] [${t}%?]")
    println(shown(u))
    println(shown(t))
    val r: real | char | bool = 'é'
    println(s"$r ${debug(r)} ${shown(r)}")
    val nested: Vector[int | string] = [1, "a", 2]
    println(nested)
    println(debug(nested))
    // A program's own trait, through classes and built-in types, with its default method.
    val b: Bag | string = Bag(7)
    val s: Bag | string = "héllo"
    val n: int | string = 40
    println(s"${b.size()} ${s.size()} ${n.size()} ${b.doubled()} ${s.doubled()}")
    val many: Vector[Bag | string | int] = [Bag(1), "ab", 3, ""]
    println(many.map(_.size()))
    println(many.map(x -> x.doubled()).sum)
    println(total(many))
    // The join: a trait, an open class with an override, its field and its method as a value.
    println(pet(Dog("rex")))
    println(pet(Cat("tom")))
    val p: Puppy | Kitten = Puppy("bo")
    val k: Puppy | Kitten = Kitten("mi")
    println(s"${p.sound()} ${k.sound()} ${p.called} ${k.greet("you")}")
    val speak: () -> string = p.sound
    println(speak())
    val pets: Vector[Puppy | Kitten] = [k, p]
    println(pets.map(_.called).mkString(","))
    // A trait requiring another.
    val l: Tag | Note = Tag("abc")
    println(s"${l.label()} ${l.size()} ${l.doubled()}")
    // A library generic trait through the join.
    val vec: Vector[int] = [1, 2, 3]
    val seq: Vector[int] | List[int] = vec
    val list: Vector[int] | List[int] = List(4, 5)
    println(s"${seq.size} ${list.size} ${seq.map(x -> x * 10)} ${list.contains(5)}")
    // Hash through a bound.
    println(hashed(u) == 3.hash())
    // Unions in closures keep their methods.
    val sizes: (Bag | string) -> int = x -> x.size() + 1
    println(sizes(s))
    // A union of sendable members is `Sendable`.
    println(sent(u))
    val pair: (int | string, bool) = (t, true)
    println(sent(pair))
