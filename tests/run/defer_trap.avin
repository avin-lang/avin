// expect: trap
// A trap stops the program where it happens: no deferred statement runs, neither the function's own
// nor any of its callers', since the program's state is already wrong. What ran before it stays done:
// the first call's and the first turn's deferred statements ran as they returned.
inner(n: int) -> int
    defer println(s"inner($n): closed")
    println(s"inner($n): dividing")
    100 / n

outer()
    defer println("outer: closed")
    for i in 0..<3
        defer println(s"turn $i: closed")
        println(s"turn $i: ${inner(1 - i)}")

main()
    defer println("main: closed")
    outer()
