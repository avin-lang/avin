// expect: trap
// A streamed body's length is at least zero: zero is taken, and a negative one traps where the
// response is made.
import avin.net.http.Response

main()
  println(Response.stream(200, "text/plain", 0, _ -> ()).streamed.map(b -> b.length))
  println(Response.stream(200, "text/plain", -1, _ -> ()).status)
