// expect: trap
// A label name is a letter or `_`, then letters, digits or `_`; a colon, allowed in a metric name, is
// not allowed in a label's, and traps.
import avin.metrics.Registry

main()
  val r = Registry()
  _ = r.counter("a_total", "A.", ["_", "x_9", "Up"])
  println(r.names)
  _ = r.counter("b_total", "B.", ["ns:key"])
