// expect: trap
// An adapter's function runs where the message is sent, so where `main` sends, a trap in it is a
// trap in `main`, which stops the program as any trap outside an actor does: the report names no
// actor.
import avin.actors.{ActorRef, spawn}
import avin.threads.Channel

actor Adapting(refs: Channel[ActorRef[string]]) receives int
  refs.send(adapter(s -> s.toInt()))
  receive
    n -> println(s"got $n")

main()
  val refs = Channel[ActorRef[string]]()
  spawn(Adapting(refs))
  val ad = refs.receive().get
  ad.tell("not a number")
  println("not reached")
