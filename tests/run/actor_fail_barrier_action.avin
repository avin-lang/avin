// expect: trap
// A trap in a barrier's action, run by an actor arriving last, stops the program instead of failing
// the actor: the other parties are waiting for the action to end. The report still names the actor.
import avin.actors.{Stop, spawn}
import avin.threads.{Atomic, Barrier, Channel}

actor Party(meet: Barrier, done: Channel[bool]) receives int
  receive
    _ -> done.send(meet.wait())

main()
  val rounds = Atomic(0)
  val meet = Barrier(1, () ->
    if rounds.add(1) == 2 then fail("the second round's action fails"))
  val done = Channel[bool]()
  val p = spawn(Party(meet, done), onFailure = Stop)
  p.tell(0)
  println(done.receive())
  p.tell(0)
  println(done.receive())
  println("not reached")
