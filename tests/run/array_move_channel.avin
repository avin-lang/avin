// expect: exit 0
// An array moved into an `Isolated` goes through a channel to another thread without a copy, at no
// elements, one and a mebibyte: the receiver takes it, finds the sender's bytes, changes them and
// sends the same array back the same way, and the sender, having taken it again, uses it through
// the reference it kept, which is the very array the receiver had.
import avin.actors.Isolated
import avin.threads.{Channel, spawn}

sumOf(a: Array[byte]) -> long
  var total: long = 0
  for b in a do total += long(int(b))
  total

trip(size: int)
  val a = Array.tabulate[byte](size, i -> byte(i % 251))
  val there = Channel[Isolated[Array[byte]]](1)
  val back = Channel[Isolated[Array[byte]]](1)
  val t = spawn(() ->
    val got = there.receive().get.take()
    val seen = sumOf(got)
    for i in 0 ..< got.length do got(i) = byte(1)
    back.send(Isolated.move(got))
    seen)
  val before = sumOf(a)
  there.send(Isolated.move(a))
  val seen = t.join()
  val returned = back.receive().get.take()
  println(s"$size: sent $before, seen $seen, same array ${returned === a}, now ${sumOf(a)}")

main()
  trip(0)
  trip(1)
  trip(1048576)
