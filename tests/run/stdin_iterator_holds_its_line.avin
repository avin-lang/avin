// expect: exit 0
// An iterator over standard input takes the line (or character) `hasNext` answers for, so asking again
// takes nothing more, `next` without `hasNext` takes one itself, a `readLine` after `hasNext` reads the
// line after the one the iterator holds, and the iterator answers `false` for ever once the input ends.
import avin.io
import avin.io.Source

line() -> string = s"[${io.readLine().getOrElse("none")}]"

main()
  val it = io.lines()
  println(s"${it.hasNext()} ${it.hasNext()} ${it.next()}")
  println(it.next())
  println(s"${it.hasNext()} ${line()} ${it.next()}")
  val other = io.lines()
  println(s"${other.next()} ${it.next()}")
  val chars = Source.stdin().chars()
  println(s"${chars.hasNext()} ${chars.hasNext()} ${chars.next()} ${chars.next()}")
  println(s"${chars.hasNext()} ${line()} ${chars.next()}")
  println(s"${line()} ${it.hasNext()} ${it.hasNext()} ${chars.hasNext()} ${line()} ${io.readAll().isEmpty}")
