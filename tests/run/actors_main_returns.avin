// The program ends when `main` returns, with every actor still running and the messages in their
// mailboxes never handled: an actor held in its first message, a thousand messages queued behind
// it, and an actor whose start never finishes.
import avin.actors.{Behaviour, spawn}
import avin.threads.{Channel, Promise}

main()
  val never = Channel[int]()
  val held = Promise[unit]()
  val a = spawn(Behaviour[int]("Held", me -> n ->
    held.tryComplete(())
    never.receive()
    println(s"handled $n")))
  for i in 0 ..< 1000 do a.tell(i)
  held.future.await()
  val started = Promise[unit]()
  spawn(Behaviour[int]("Starting", me ->
    started.complete(())
    never.receive()
    n -> println(s"handled $n"))).tell(1)
  started.future.await()
  println("main returns")
