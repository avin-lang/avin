// expect: exit 0
// A sequence literal is a Vector unless the expected type asks for another collection: then it is
// built with that collection's builder, and its elements take the expected element type. Without an
// expected type the elements agree on one, as the branches of an `if` do.

open class Animal(val name: string)
class Dog(n: string): Animal(n)
class Cat(n: string): Animal(n)

sum(xs: Array[int]) -> int
    var t = 0
    for x in xs do t += x
    t

count(xs: Iterable[string]) -> int
    var n = 0
    for _ in xs do n += 1
    n

// A collection of the program's own, with a builder in its companion, is built by a literal too.
class Bag(val items: Buffer[int])

object Bag
    builder() -> BagBuilder = BagBuilder(Buffer[int]())

class BagBuilder(private val items: Buffer[int]): Builder[int, Bag]
    override add(element: int) = items.add(element * 2)
    override result() -> Bag = Bag(items)

main()
    val v = [1, 2, 3]
    print(s"${v.length()} ${v(0)} ${v(2)}")
    val b: Buffer[int] = [4, 5]
    b.add(6)
    print(s"${b.length()} ${b(2)}")
    val header: Array[byte] = [0x89, 0x50, 0x4e, 0x47]
    print(s"${header(0)} ${header.length()} ${sum([1, 2, 3, 4])}")
    val l: List[int] = [7, 8]
    print(s"${l.length()} ${l == [7, 8]}")
    print(s"${count(["a", "b", "c"])}")

    val nested = [[1], [2, 3]]
    print(s"${nested(1)(1)} ${nested.length()} ${nested(0).length()}")
    val grid: Vector[Buffer[int]] = [[1, 2], []]
    grid(1).add(9)
    print(s"${grid(0)(1)} ${grid(1)(0)}")

    val pets = [Dog("rex"), Cat("tom")]
    val first: Animal = pets(0)
    print(s"${first.name} ${pets(1).name}")
    val maybe = [None, Some(2)]
    print(s"${maybe(1).getOrElse(0)} ${maybe(0).isNone()}")

    val none: Vector[string] = []
    val nothing: Buffer[Dog] = []
    val zero: Array[real] = []
    print(s"${none.length()} ${nothing.length()} ${zero.length()}")
    var later = []
    later = [1.5]
    print(s"${later(0)}")

    val bag: Bag = [1, 2, 3]
    print(s"${bag.items(2)}")

    for x in [10, 20] do print(s"$x")
    var t = 0
    for x in b do t += x
    print(s"$t ${[1, 2] == [1, 2]} ${b == [4, 5, 6]}")
