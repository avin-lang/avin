// expect: trap
// A TCP connect's timeout of zero is no limit; one below zero, by a microsecond, traps before
// anything is looked up.
import avin.net.{TcpListener, TcpStream}
import avin.time.{Duration, micros}

main()
  val listener = TcpListener.bind("127.0.0.1", 0).ok.get
  println(TcpStream.connect("127.0.0.1", listener.port(), Duration.Zero).isOk)
  _ = TcpStream.connect("127.0.0.1", listener.port(), micros(-1))
