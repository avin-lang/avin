// `signalGroup` of a group whose members have all ended is `Err(Other("No such process"))` whether or
// not the last of them has been reaped yet: a member that has ended but not been waited for is a
// zombie, and the platform may answer a permission error for a group holding only zombies.
import avin.fs
import avin.io
import avin.io.IoError
import avin.process.{Child, Command}
import avin.signal
import avin.threads
import avin.time.millis

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

// Waits until `file` holds a line, and answers it.
written(file: string) -> string
  loop
    fs.readText(file) match
      Ok(text) if text.endsWith("\n") -> return text.trim()
      _ -> threads.sleep(millis(2))

// The state letters `ps` gives the process `pid`.
stateOf(pid: string) -> string = ok(Command("/bin/ps", "-o", "stat=", "-p", pid).output().mapErr(e -> IoError(io.Other("ps")))).trim()

// An error's kind, without the process group its message names.
kind(e: IoError) -> io.ErrorKind = e.kind

// Waits until the process `pid` has ended and not been reaped.
zombie(pid: string)
  loop
    if stateOf(pid).startsWith("Z") then return
    threads.sleep(millis(2))

main()
  // The group's only member ended and is not waited for: a zombie.
  val dead = ok(Command("/bin/sleep", "30").inNewGroup().start())
  println(dead.signalGroup(signal.Kill).mapErr(kind))
  zombie(dead.pid().toString())
  println(stateOf(dead.pid().toString()).startsWith("Z"))
  println(dead.signalGroup(0).mapErr(kind))
  println(dead.signalGroup(signal.Terminate).mapErr(kind))
  println(dead.signalGroup(signal.Kill).mapErr(kind))
  // Waiting reaps it, and the answer stays the same.
  println(dead.waitFor())
  println(dead.signalGroup(0).mapErr(kind))
  println(dead.signalGroup(signal.Terminate).mapErr(kind))

  // A group with a live member answers Ok, and a zombie leader beside it changes nothing.
  // The member is known to be running once the shell has written its id.
  val dir = ok(fs.createTempDir("avin-group-zombie"))
  val shell = ok(Command("/bin/sh", "-c", "/bin/sleep 300 & echo $! > \"$0\"; exec /bin/sleep 300", dir + "/member").inNewGroup().start())
  written(dir + "/member")
  println(shell.signalGroup(0).mapErr(kind))
  println(shell.signal(signal.Kill))
  println(shell.signalGroup(0).mapErr(kind))
  println(shell.signalGroup(signal.Kill).mapErr(kind))
  zombie(shell.pid().toString())
  println(shell.signalGroup(0).mapErr(kind))
  println(shell.waitFor())
  println(shell.signalGroup(0).mapErr(kind))

  // A command not started in a group of its own has no group, ended or not.
  val plain = ok(Command("/bin/sleep", "30").start())
  println(plain.signalGroup(0).mapErr(kind))
  println(plain.signal(signal.Kill))
  zombie(plain.pid().toString())
  println(plain.signalGroup(0).mapErr(kind))
  println(plain.waitFor())
