// expect: exit 0
// An actor's parameters follow a class's rules: defaults, one computed from the parameter before it,
// named arguments in any order, a repeated parameter, a `var` parameter the actor changes, a
// `@sendable` function, a tuple, an `Option`, a data value and another actor's reference. They are
// the actor's immutable fields, read in the body and in arms. An actor without parameters is
// called with an empty argument list. Each start gets the arguments the behaviour was made with,
// so a second actor of one behaviour starts from them again, whatever the first did with its `var`.
import avin.actors.{ActorRef, spawn}
import avin.threads.Promise

data Shape
  Circle(r: int)
  Square(s: int)

actor Sink receives Promise[string]
  receive
    p -> p.complete("sink")

actor Config(name: string, width: int = 80, height: int = width / 2, tags: string*) receives Promise[string]
  receive
    p -> p.complete(s"$name ${width}x$height $tags")

actor Tally(
    var left: int,
    step: @sendable (int) -> int,
    pair: (int, string),
    maybe: Option[Shape],
    sink: ActorRef[Promise[string]]
) receives Promise[string]
  val first = left
  receive
    p ->
      left = step(left)
      val inner = Promise[string]()
      sink.tell(inner)
      p.complete(s"$first -> $left ${pair.0}${pair.1} $maybe ${inner.future.await()}")

actor Unit0 receives Promise[string]
  receive
    p -> p.complete("no parameters")

ask(r: ActorRef[Promise[string]]) -> string
  val p = Promise[string]()
  r.tell(p)
  p.future.await()

main()
  println(ask(spawn(Config("a"))))
  println(ask(spawn(Config("b", 100))))
  println(ask(spawn(Config("c", height = 3, width = 7))))
  println(ask(spawn(Config("d", 1, 2, "x", "y", "z"))))
  println(ask(spawn(Config(width = 9, name = "e"))))
  val sink = spawn(Sink())
  val tally = Tally(10, n -> n * 3, (1, "one"), Some(Square(4)), sink)
  val t = spawn(tally)
  println(ask(t))
  println(ask(t))
  println(ask(spawn(tally)))
  println(ask(spawn(Unit0())))
