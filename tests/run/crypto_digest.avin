import avin.crypto.{sha256, sha512, sha1, md5, hmacSha256, hmacSha512, toHex, Sha256, Sha512}

// Digests under the collector's stress: vectors, text, a hasher fed in pieces, and HMAC.
main(args: Vector[string])
    println(toHex(sha256("abc")))
    println(toHex(sha512("")))
    println(toHex(sha1("héllo")))
    println(toHex(md5(Vector.tabulate(256, i -> byte(i)))))
    println(toHex(hmacSha256("Jefe", "what do ya want for nothing?")))
    println(toHex(hmacSha512("Jefe", "what do ya want for nothing?")))
    val h = Sha256()
    val g = Sha512()
    for piece in ["abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".slice(0, 20), "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".slice(20, 56)]
        h.update(piece)
        g.update(piece)
    println(toHex(h.finish()))
    println(toHex(g.finish()))
