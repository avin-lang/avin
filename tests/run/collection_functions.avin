// A sequence is the function from an index to its element, a set the predicate of membership and a
// map the function from its keys to their values: each is used wherever its function type is
// expected, passed, stored and called, with no conversion, alongside lambdas of the same type.

import avin.collections.mutable.{Map as MutableMap, Set as MutableSet}

open class Animal(val name: string)
class Dog(name: string): Animal(name)

// A class implementing `Seq` is a function as every sequence is.
class Squares(n: int): Seq[int]
    override length() -> int = n
    override apply(index: int) -> int = index * index

// A class that is a function by its own header.
class Shout: (string) -> string
    apply(s: string) -> string = s + "!"

// An abstract parent's function type and `apply`, which each subclass overrides.
abstract class Scale: (int) -> int
    apply(x: int) -> int

class Twice: Scale()
    override apply(x: int) -> int = x * 2

class Thrice: Scale()
    override apply(x: int) -> int = x * 3

twice[T: Display](f: (int) -> T, i: int) -> string = s"${f(i)} ${f(i)}"

firstThree[T](xs: Seq[T]) -> Vector[T] = (0 ..< 3).map(xs)

main()
    val v = ["a", "b", "c", "d"]
    val l: List[string] = ["e", "f", "g"]
    val a: Array[string] = ["h", "i", "j"]
    val b: Buffer[string] = ["k", "l", "m"]
    val d: Deque[string] = ["n", "o", "p"]
    print((0 ..< 3).map(v))
    print((0 ..< 3).map(l))
    print((0 ..< 3).map(a))
    print((0 ..< 3).map(b))
    print((0 ..< 3).map(d))
    print(firstThree(v))
    print(twice(l, 2))

    // Stored as a function and called, the same as a lambda stored there.
    var f: (int) -> string = v
    print(f(3))
    f = i -> s"lambda $i"
    print(f(3))
    f = d
    print(f(0))
    val fs: Vector[(int) -> string] = [v, l, i -> "x", a]
    print(fs.map(g -> g(1)))

    // A user class implementing `Seq`, and one whose header names a function type.
    val sq = Squares(4)
    print((0 ..< 4).map(sq))
    val h: (int) -> int = sq
    print(h(3))
    val shout: (string) -> string = Shout()
    print(v.map(shout))
    val scales: Vector[(int) -> int] = [Twice(), Thrice(), x -> x + 1]
    print(scales.map(s -> s(10)))

    // A set is a predicate: `s(x)` is membership, and the set filters as a lambda does.
    val allowed = Set[string]().added("b").added("d")
    print(s"${allowed("b")} ${allowed("c")}")
    print(v.filter(allowed))
    val p: (string) -> bool = allowed
    print(s"${p("d")} ${p("a")}")
    val seen = MutableSet[int]()
    seen.add(2)
    seen.add(3)
    print(s"${seen(2)} ${seen(5)}")
    print([1, 2, 3, 4].filter(seen))

    // A map is the function from its keys.
    val table = Map[string, int]().updated("one", 1).updated("two", 2)
    print(["two", "one", "two"].map(table))
    val lookup: (string) -> int = table
    print(lookup("one"))
    val counts = MutableMap[string, int]()
    counts("x") = 10
    counts("y") = 20
    print(["y", "x"].map(counts))

    // Variance: a vector of dogs is a function to animals; a map's values are covariant too.
    val kennel: Vector[Dog] = [Dog("rex"), Dog("fido")]
    val pick: (int) -> Animal = kennel
    print(pick(1).name)
    val owners = Map[string, Dog]().updated("ann", Dog("max"))
    val ownerOf: (string) -> Animal = owners
    print(ownerOf("ann").name)
