// `fs.readTail`, `fs.readTailLines` and `fs.readBytesFrom`: the end of a file, and what was appended
// after an offset, read without the rest.
import avin.fs
import avin.io.IoError

show(r: Result[Vector[string], IoError]) -> string = r match
    Ok(v) -> v.map(s -> s"[$s]").mkString(",")
    Err(e) -> s"Err($e)"

tail(file: string, n: long) -> string = fs.readTail(file, n) match
    Ok(t) -> s"<$t>"
    Err(e) -> s"Err($e)"

main()
    val dir = fs.createTempDir("avin-tail") match
        Ok(d) -> d
        Err(e) -> return
    val f = dir + "/f"
    // readTail: empty file, zero bytes, more than the file holds, exactly the file, a part.
    fs.writeText(f, "")
    println(tail(f, 0) + tail(f, 10))
    fs.writeText(f, "abcdef")
    println(tail(f, 0) + tail(f, 1) + tail(f, 3) + tail(f, 6) + tail(f, 7) + tail(f, 1000000))
    // A cut inside a two-, three- and four-byte character starts at the next whole one.
    fs.writeText(f, "aé✓😀z")
    println(tail(f, 1) + tail(f, 2) + tail(f, 3) + tail(f, 4) + tail(f, 5) + tail(f, 6))
    println(tail(f, 7) + tail(f, 8) + tail(f, 9) + tail(f, 10) + tail(f, 11) + tail(f, 12) + tail(f, 13))
    // A cut that lands on a character's first byte keeps it.
    fs.writeText(f, "é✓")
    println(tail(f, 3) + tail(f, 4) + tail(f, 5))
    // Only continuation bytes in the tail: nothing is left, not garbage.
    fs.writeText(f, "😀")
    println(tail(f, 1) + tail(f, 2) + tail(f, 3) + tail(f, 4))
    // Invalid bytes in the middle are replaced, not an error.
    fs.writeBytes(f, Array.tabulate(5, i -> if i == 2 then byte(0xff) else byte(66)))
    println(tail(f, 5))
    // A tail across several read blocks.
    fs.writeText(f, "é".repeat(20000))
    val big = fs.readTail(f, 30001)
    println(big match
        Ok(t) -> s"${t.byteLength()} ${t == "é".repeat(15000)}"
        Err(e) -> s"$e")
    // readTailLines.
    fs.writeText(f, "")
    println(show(fs.readTailLines(f, 3)))
    fs.writeText(f, "one")
    println(show(fs.readTailLines(f, 3)))
    fs.writeText(f, "one\n")
    println(show(fs.readTailLines(f, 3)))
    fs.writeText(f, "one\ntwo\nthree\nfour\n")
    println(show(fs.readTailLines(f, 0)) + show(fs.readTailLines(f, 1)) + show(fs.readTailLines(f, 2)))
    println(show(fs.readTailLines(f, 4)))
    println(show(fs.readTailLines(f, 5)))
    fs.writeText(f, "one\ntwo\nthree\nfour")
    println(show(fs.readTailLines(f, 2)))
    fs.writeText(f, "a\r\nb\r\n\n\nc\n")
    println(show(fs.readTailLines(f, 4)))
    println(show(fs.readTailLines(f, 3)))
    fs.writeText(f, "\n")
    println(show(fs.readTailLines(f, 2)))
    fs.writeText(f, "\n\n")
    println(show(fs.readTailLines(f, 5)))
    // Lines of Unicode and a line longer than a block, with the block edge falling in a character.
    fs.writeText(f, "x\n" + "é".repeat(9000) + "\n✓\n")
    val lines = fs.readTailLines(f, 2)
    println(lines match
        Ok(v) -> s"${v.length} ${v(0) == "é".repeat(9000)} ${v(1)}"
        Err(e) -> s"$e")
    // Many lines: the last 3 of 5000, over several blocks.
    val many = Buffer[string]()
    for i in 0..<5000
        many.addOne(s"line $i")
    fs.writeText(f, many.toVector.mkString("\n") + "\n")
    println(show(fs.readTailLines(f, 3)))
    println(fs.readTailLines(f, 5000).map(v -> v.length))
    println(fs.readTailLines(f, 6000).map(v -> v.length))
    // readBytesFrom: after an offset, at the end, past it, from the start; a file that grows.
    fs.writeText(f, "hello")
    println(fs.readBytesFrom(f, 2).map(b -> b.mkString(" ")))
    println(fs.readBytesFrom(f, 5).map(b -> b.length))
    println(fs.readBytesFrom(f, 99).map(b -> b.length))
    println(fs.readBytesFrom(f, 0).map(b -> b.length))
    fs.appendText(f, ", wörld\n")
    println(fs.readBytesFrom(f, 5).map(b -> string.fromUtf8Lossy(b)))
    fs.writeText(f, "")
    println(fs.readBytesFrom(f, 0).map(b -> b.length))
    // The tail functions on a growing log.
    for i in 0..<3
        fs.appendText(dir + "/log", s"event $i\n")
        println(show(fs.readTailLines(dir + "/log", 2)))
    fs.removeDirAll(dir)
