// expect: exit 0
// A handle sent twice goes with the first message only: the sender no longer owns it when it sends
// the second, so the second receiver's use traps, failing that actor alone, while the first goes on
// using it. A message sent to an actor that has ended is dropped, and the handles it holds stay the
// sender's, who goes on using them.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.actors.{ActorRef, Stop, spawn}
import avin.threads.Promise

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message())

data Msg
    Read(conn: TcpStream, done: Promise[string])
    Quit

actor Reader receives Msg
    receive
        Read(conn, done) -> done.complete(ok(conn.readLine()).getOrElse("end"))
        Quit -> stop()

read(r: ActorRef[Msg], conn: TcpStream) -> string
    val p = Promise[string]()
    r tell Read(conn, p)
    p.future.await()

main()
    val l = ok(TcpListener.bind("127.0.0.1", 0))
    val c = ok(TcpStream.connect("127.0.0.1", l.port()))
    val s = ok(l.accept())
    ok(c.writeText("one\ntwo\nthree\n"))
    val first = spawn(Reader())
    val second = spawn(Reader(), onFailure = Stop)
    println(read(first, s))
    second tell Read(s, Promise[string]())
    println(second.ended().await())
    println(read(first, s))
    val c2 = ok(TcpStream.connect("127.0.0.1", l.port()))
    val s2 = ok(l.accept())
    ok(c2.writeText("kept\n"))
    val gone = spawn(Reader())
    gone tell Quit
    gone.ended().await()
    gone tell Read(s2, Promise[string]())
    println(ok(s2.readLine()))
