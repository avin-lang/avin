// expect: exit 0
// End markers close a `match` (a function's body and a statement), a `val` and a `while`; `not` is a
// name except after `is`, where `is not(p)` negates the pattern `(p)`; `return` inside a lambda
// leaves the lambda; and `while x is not P` binds the pattern's names in the loop's `else`.

not(b: bool) -> bool = !b

describe(n: int) -> string = n match
    0 -> "zero"
    _ -> "some"
end match

main()
    1 match
        0 -> println(describe(0))
        _ -> println(describe(1))
    end match
    val n = 3
    val label = n match
        1 -> "one"
        _ -> "many"
    end match
    val total =
        val base = 21
        base * 2
    end val
    var i = 0
    while i < 2
        i += 1
    end while
    if not(n == 3) then println("no")
    else println("yes")
    val o: Option[int] = Some(2)
    println(o is not(None))
    val f: (int) -> int = x ->
        if x > 0 then return x * 10
        -1
    println(s"$label $total $i ${f(2)} ${f(-1)}")
    var rest: List[int] = [1, 2, 3]
    while rest is not head :: more
        println("never")
    else
        println(s"$head $more")
