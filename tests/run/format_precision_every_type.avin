// expect: exit 0

// Under `%s` and `%?` a precision cuts the rendered text to that many characters, whatever the
// value's type: the value is rendered whole, its first N characters are kept, and those fill the
// field the width describes. The renderer itself never sees the precision.
data P(x: int)

// A type whose renderer would write its own form of the precision if it were handed one.
class Loud(): Display
    override display(out: Writer, spec: FormatSpec) = out.write(if spec.precision >= 0 then "PRECISION SEEN" else "loud value")

data Color
    Red
    Green

main()
    val xs = [1, 2, 3]
    // Strings and chars, `Display` and `Debug`.
    println(f"[${"abcdef"}%.2s] [${"abcdef"}%.2?] [${'x'}%.1?] [${'x'}%.0?] [${"a\"b"}%.3?]")
    // Collections, options, tuples, data, enums, bools, unit.
    println(f"[${xs}%.3s] [${xs}%.3?] [${List(1, 2)}%.2s] [${{1: "a"}}%.4s] [${{7}}%.2?]")
    println(f"[${Some(1)}%.3s] [${Some("x")}%.4?] [${None}%.1s] [${(1, 2)}%.2s] [${(1, "a")}%.5?]")
    println(f"[${P(1)}%.2s] [${P(1)}%.3?] [${Green}%.1s] [${true}%.1s] [${false}%.3?] [${()}%.1s]")
    println(f"[${1..5}%.2s] [${0..<9 by 3}%.5?]")
    // Numbers under `%?` are cut too; under their own conversions the precision is theirs.
    println(f"[${42}%.1?] [${long(12345)}%.3?] [${2.5}%.2?] [${42}%.5d] [${2.5}%.3f]")
    // Unicode: characters, not bytes.
    println(f"[${"héllo"}%.2s] [${"😀😀😀"}%.2s] [${["é", "ü"]}%.4?] [${'é'}%.2?]")
    // Width with precision: the cut text fills the field, on either side.
    println(f"[${"abc"}%5.1s] [${"abc"}%-5.2s] [${xs}%6.3s] [${xs}%-6.2?] [${P(12)}%4.3s]")
    // Zero, past the length, and counted.
    val n = 2
    println(f"[${xs}%.0s] [${xs}%.99s] [${xs}%.${n}s] [${xs}%.${-1}s] [${xs}%.${n}?] [${"ab"}%.${long(1)}s]")
    // Through `Any`, a trait and a type with no `Display` of its own.
    val any: Any = (1, 2, 3)
    val seq: Seq[int] = xs
    println(f"[${any}%.3s] [${seq}%.2s] [${seq}%.4?]")
    // The renderer is not handed the precision: it renders whole and is cut.
    println(f"[${Loud()}%.4s] [${Loud()}%s] [${Loud()}%8.4s]")
    // The runtime formatter cuts the same way.
    val shown: Vector[Display] = [12345, P(9)]
    println(StringContext(["[", "%.2s] [", "%-6.3s]"]).f(shown*))
    // A precision on a string written plainly, and without one, is unchanged.
    println(f"[${"plain"}%s] [${"plain"}%7s] [${"plain"}%.5s]")
