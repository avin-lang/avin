// `for` over ranges written in place, `Range` values, arrays, iterators and a class of the
// program's own, with `break`, `continue`, nested loops and patterns that take elements apart.

data Point(x: int, y: int)

class Countdown(from: int): Iterable[int]
  override iterator() -> Iterator[int] = Ticks(from)

class Ticks(private var n: int): Iterator[int]
  override hasNext() -> bool = n > 0
  override next() -> int
    n -= 1
    n + 1

main()
  for i in 0 ..< 3 do println(s"exclusive $i")
  for i in 1 .. 3 do println(s"inclusive $i")
  for i in 3 .. 1 do println("never")
  for i in 1 ..< 1 do println("never")
  for _ in 0 ..< 2 do println("twice")

  // The bounds are evaluated once, before the loop.
  var limit = 3
  for i in 0 ..< limit
    limit = 10
    println(s"bounded $i")

  // `continue` goes to the next element and `break` leaves the loop.
  for i in 0 ..< 10
    if i % 2 == 1 then continue
    if i > 6 then break
    println(s"even $i")

  // Nested loops: `break` and `continue` belong to the innermost one.
  for i in 1 .. 3
    for j in 1 .. 3
      if j > i then break
      println(s"$i.$j")

  // Ranges of other integer types, and ranges that end at the largest or smallest value.
  val big: long = 3000000000
  for x in big ..< big + 2 do println(s"long $x")
  var count = 0
  for x in 2147483645 .. 2147483647 do count += 1
  for x in -2147483648 .. -2147483647 do count += 1
  for x in i8(126) .. i8(127) do count += 1
  println(s"edges $count")

  // `Range` values, stepped with `by`.
  for x in 0 .. 10 by 3 do println(s"by3 $x")
  for x in 10 .. 0 by -4 do println(s"down $x")
  for x in 0 ..< 9 by 3 do println(s"open $x")
  for x in 2147483640 .. 2147483647 by 5 do println(s"top $x")
  for x in -2147483640 .. -2147483648 by -5 do println(s"bottom $x")
  val r = 1 .. 4
  var sum = 0
  for x in r do sum += x
  for x in r do sum += x
  println(s"range twice $sum")

  // Arrays, taking elements apart by pattern.
  val points = Array.tabulate(3, i -> Point(i, i * 10))
  for Point(x, y) in points do println(s"point $x,$y")
  val pairs = Array.tabulate(2, i -> (i, s"p$i"))
  for (i, name) in pairs do println(s"pair $i $name")
  for p in Array.empty[Point]() do println("never")

  // Each element is a new binding, so a closure keeps the one it saw.
  val fs = Array.tabulate(3, i -> () -> i * 100)
  val seen = Array.fill(3, 0)
  var k = 0
  for f in fs
    seen(k) = f()
    k += 1
  println(s"closures ${seen(0)} ${seen(1)} ${seen(2)}")

  // A class of the program's own, and an iterator, which a loop consumes.
  for n in Countdown(3) do println(s"countdown $n")
  val it = Countdown(4).iterator()
  for n in it
    if n == 2 then break
    println(s"first $n")
  for n in it do println(s"rest $n")
  println(s"left ${it.hasNext()}")

  // A sum over a million elements.
  var total: long = 0
  for i in 0 ..< 1000000 do total += long(i)
  println(s"total $total")
