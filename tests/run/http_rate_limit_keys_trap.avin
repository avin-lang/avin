// expect: trap
// A rate limiter holds at least one bucket: a `maxKeys` of one is taken, and zero traps where the
// limiter is made.
import avin.net.http.RateLimiter
import avin.time.seconds

main()
  println(RateLimiter(1, seconds(1), maxKeys = 1).maxKeys)
  println(RateLimiter(1, seconds(1), maxKeys = 0).maxKeys)
