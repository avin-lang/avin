// An impl adds methods to a trait: every value whose type conforms to it has them, a class or data
// type implementing it, the trait's own type and a type parameter bounded by it. The core library
// writes `contains`, `indexOf`, `mkString`, `maxOption` and `minOption` once on `Seq`. A type's own method with the
// same parameter types takes precedence; one with others overloads the added one. The added methods
// reach the value only through the trait's methods, so a covariant trait takes its parameter in them.

// A sequence the program defines gets the sequence methods.
class Squares(n: int): Seq[int]
    override length() -> int = n
    override apply(index: int) -> int = index * index

    // A class's own methods reach the added ones by bare name.
    hasNine() -> bool = contains(9)

// A data type implementing `Seq` through an impl gets them too.
data Pair(a: string, b: string)

impl Seq[string] for Pair
    length() -> int = 2
    apply(index: int) -> string = if index == 0 then a else b

impl Pair
    // So do the methods an impl adds to the data type.
    joined() -> string = mkString("+")

// A sequence with its own `contains`, which a call on it reaches instead of the added one, and an
// overload of `indexOf` with other parameter types beside the added one.
class Loud(items: Vector[string]): Seq[string]
    override length() -> int = items.length()
    override apply(index: int) -> string = items(index)
    contains(element: string) -> bool
        println(s"Loud looks for $element")
        items.contains(element)
    indexOf(element: string, from: int, until: int) -> int
        var i = from
        while i < until
            if items(i) == element then return i
            i += 1
        -1

has[T](xs: Seq[T], x: T) -> bool = xs.contains(x)

joinAll[T: Display](xs: Seq[T]) -> string = xs.mkString("<", "|", ">")

largest[S: Seq[int]](xs: S) -> Option[int] = xs.maxOption()

where[T](xs: Seq[T], x: T) -> int = xs.indexOf(x)

// A covariant trait of the program's own, with methods an impl adds that take its parameter.
trait Shelf[+T]
    size() -> int
    at(index: int) -> T

    // A trait's default body reaches them too.
    summary() -> string = describe("summary")

impl[T] Shelf[T]
    // Bare calls reach the trait's methods and the other added ones; `self` is the value.
    holds(item: T) -> bool = self.position(item) >= 0

    position(item: T) -> int
        for i in 0 ..< size()
            if at(i).equals(item) then return i
        -1

    // An added method with type parameters of its own, and one with a default.
    mapped[U](f: (T) -> U) -> List[U]
        var out: List[U] = []
        var i = size() - 1
        while i >= 0
            out = f(self.at(i)) :: out
            i -= 1
        out

    describe(prefix: string = "shelf") -> string = s"$prefix of ${count()}"

    private count() -> int = size()

// An added method that holds only where the elements are ordered.
impl[T: Ord] Shelf[T]
    sorted() -> bool
        for i in 1 ..< size()
            if at(i - 1) > at(i) then return false
        true

open class Animal(val name: string)

class Dog(name: string): Animal(name)

class Kennel(dogs: Vector[Dog]): Shelf[Dog]
    override size() -> int = dogs.length()
    override at(index: int) -> Dog = dogs(index)

class Numbers(values: Array[int]): Shelf[int]
    override size() -> int = values.length()
    override at(index: int) -> int = values(index)

main()
    // Generic code over `Seq[T]`, given each kind of sequence.
    val vector: Vector[int] = [3, 1, 4, 1, 5]
    val list: List[int] = [2, 7, 1, 8]
    val array: Array[string] = ["x", "y"]
    val buffer = Buffer[real]()
    buffer.add(1.5)
    buffer.add(2.5)
    val deque = Deque[char]()
    deque.addLast('p')
    deque.addFirst('q')
    println(has(vector, 4))
    println(has(list, 3))
    println(has(array, "y"))
    println(has(buffer, 2.5))
    println(has(deque, 'q'))
    println(joinAll(vector))
    println(joinAll(list))
    println(joinAll(array))
    println(joinAll(buffer))
    println(joinAll(deque))
    println(where(list, 8))
    println(where(vector, 9))
    println(largest(vector))
    println(largest(list))

    // The methods on each type directly, on a value seen as a `Seq`, and infix.
    println(vector.indexOf(1))
    println(list.contains(7))
    println(list.minOption())
    val seen: Seq[int] = list
    println(seen.mkString())
    println(seen.maxOption())
    println(vector contains 5)

    // A sequence the program defines, and a data type implementing `Seq`.
    val squares = Squares(5)
    println(squares.contains(9))
    println(squares.indexOf(16))
    println(squares.mkString("-"))
    println(squares.maxOption())
    println(has(squares, 10))
    val pair = Pair("left", "right")
    println(pair.contains("right"))
    println(pair.mkString(" & "))
    println(pair.minOption())

    // A method named without a call is a function bound to the value.
    val test = vector.contains
    println(test(3))

    // A type's own method takes precedence over the added one; generic code over `Seq` calls the
    // added one. An own overload with other parameter types sits beside the added one.
    val loud = Loud(["a", "b", "a"])
    println(loud.contains("b"))
    println(has(loud, "b"))
    println(loud.indexOf("a"))
    println(loud.indexOf("a", 1))
    println(loud.indexOf("a", 1, 2))

    // A covariant trait's added methods take its parameter: a kennel of dogs seen as a shelf of
    // animals holds an animal.
    val rex = Dog("Rex")
    val kennel = Kennel([rex, Dog("Fido")])
    val shelf: Shelf[Animal] = kennel
    println(shelf.holds(rex))
    println(shelf.holds(Animal("Tom")))
    println(kennel.position(rex))
    println(kennel.mapped(d -> d.name).mkString())
    println(kennel.describe())
    println(kennel.describe("kennel"))
    val numbers = Numbers([1, 2, 2, 9])
    println(numbers.sorted())
    println(Numbers([3, 2]).sorted())
    println(numbers.mapped(n -> n * 10))
    println(squares.hasNine())
    println(pair.joined())
    println(kennel.summary())
    println(shelf.summary())
