// expect: trap
// `Future.all` and `Future.traverse` of nothing are the future of an empty vector, and the shared
// executor answers that it is not shut down; but `Future.first` of no futures has no value to give,
// so it traps.
import avin.threads.{Executor, Future}

main()
    val none: Vector[Future[int]] = []
    println(Future.all(none).await())
    println(Future.traverse(List[int](), n -> Future(n)).await())
    println(Executor.shared().isShutdown())
    println(Future.first(none).await())
