// expect: trap
// A `trySend` to a channel `after` made traps as a send does, and so would a timed send, rather than
// answering whether there was room: nothing but its clock sends to it.
import avin.threads.after
import avin.time.{epochMicros, hours, millis}

main()
  val a = after(hours(1))
  println("before")
  println(a.trySend(epochMicros(0)) || a.send(epochMicros(0), millis(5)))
  println("after")
