// expect: exit 0
// A `loop` runs until a `break` or `return` leaves it; `break` may carry a value.
firstOver(limit: int) -> int
  var n = 1
  loop
    if n * n > limit then return n
    n += 1

main() -> int
  var count = 0
  loop
    count += 1
    if count == 3 then break
  println(s"$count")

  var k = 0
  val found = loop
    k += 5
    if k > 12 then break k * 2
  println(s"$found")

  var odd = 0
  var i = 0
  loop
    i += 1
    if i > 10 then break
    if i % 2 == 0 then continue
    odd += i
  println(s"$odd")

  println(s"${firstOver(50)}")

  var pairs = 0
  var a = 0
  loop
    a += 1
    if a > 3 then break
    var b = 0
    loop
      b += 1
      if b > a then break
      pairs += 1
  println(s"$pairs")

  var once = 0
  loop do
    once += 1
    break
  println(s"$once")
  0
