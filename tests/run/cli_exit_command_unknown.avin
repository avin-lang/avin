// expect: exit 2
// args: --file t.txt lst --all
// `parseOrExit` given a command the program does not take: the reason, with the command it was most
// likely meant to be, the program's usage line and where the commands are listed go to standard
// error, and the program exits with 2.
import avin.cli

val parser = cli.Parser("todo", "Keep a to-do list.")
  .string("file", help = "the list", default = "todo.txt")
  .command(cli.Parser("add", "Add a task.").positionals("words", required = true))
  .command(cli.Parser("list", "List the tasks.").flag("all"))

main(args: Vector[string]) -> int
  val opts = parser.parseOrExit(args)
  println(s"not reached: ${opts.command}")
  0
