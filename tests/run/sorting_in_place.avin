// An array, a buffer and a deque sort in place: `sortInPlace()` where the elements are ordered, and
// `sortInPlaceBy(key)` and `sortInPlaceWith(compare)` always. Every sort is stable, so elements that
// compare equal keep their order; a deque sorts from its front, wherever its ring starts.
data Entry(rank: int, name: string)

data Level derives Eq, Hash, Ord
    Low
    Middle
    High

descending(a: int, b: int) -> int = b.compare(a)

names(entries: Seq[Entry]) -> string = entries.foldLeft("", (acc, e) -> acc + e.name)

main()
    // Arrays.
    val empty: Array[int] = Array.empty()
    empty.sortInPlace()
    empty.sortInPlaceBy(x -> x)
    empty.sortInPlaceWith(descending)
    println(empty)
    val one: Array[int] = [4]
    one.sortInPlace()
    println(one)
    val ascending: Array[int] = [1, 2, 3]
    ascending.sortInPlace()
    println(ascending)
    val reversed: Array[int] = [5, 4, 3, 2, 1]
    reversed.sortInPlace()
    println(reversed)
    val repeated: Array[int] = [2, 3, 2, 1, 3, 1]
    repeated.sortInPlaceWith(descending)
    println(repeated)
    repeated.sortInPlaceBy(x -> x)
    println(repeated)
    val words: Array[string] = ["pear", "Fig", "äpfel", "apple"]
    words.sortInPlace()
    println(words)
    val reals: Array[real] = [0.5, -2.0, 3.25, 0.0]
    reals.sortInPlace()
    println(reals)
    val levels: Array[Level] = [High, Low, Middle, Low]
    levels.sortInPlace()
    println(levels)
    val entries: Array[Entry] = [Entry(2, "a"), Entry(1, "b"), Entry(2, "c"), Entry(1, "d")]
    entries.sortInPlaceBy(e -> e.rank)
    println(names(entries))
    entries.sortInPlaceWith((x, y) -> y.rank.compare(x.rank))
    println(names(entries))

    // Buffers.
    val buffer = Buffer[int]()
    buffer.sortInPlace()
    println(buffer)
    buffer += 3
    buffer.sortInPlace()
    println(buffer)
    buffer ++= [1, 2, 1]
    buffer.sortInPlace()
    println(buffer)
    buffer.sortInPlaceWith(descending)
    println(buffer)
    buffer.sortInPlaceBy(x -> x % 2)
    println(buffer)
    val wordBuffer = Buffer[string]()
    wordBuffer ++= ["b", "a", "c", "a"]
    wordBuffer.sortInPlace()
    println(wordBuffer)
    val levelBuffer = Buffer[Level]()
    levelBuffer ++= [Middle, High, Low]
    levelBuffer.sortInPlaceWith((a, b) -> b.compare(a))
    println(levelBuffer)
    val realBuffer = Buffer[real]()
    realBuffer ++= [1.5, -1.5, 0.25]
    realBuffer.sortInPlace()
    println(realBuffer)
    val entryBuffer = Buffer[Entry]()
    entryBuffer ++= [Entry(3, "a"), Entry(1, "b"), Entry(3, "c"), Entry(1, "d"), Entry(2, "e")]
    entryBuffer.sortInPlaceBy(e -> e.rank)
    println(names(entryBuffer))
    // A sorted buffer still grows and shrinks as before.
    entryBuffer.addOne(Entry(0, "f"))
    entryBuffer.remove(0)
    println(names(entryBuffer))

    // Deques, sorted after `prepend` has moved the ring's start.
    val deque: Deque[int] = []
    deque.sortInPlace()
    println(deque)
    deque.append(5)
    deque.sortInPlace()
    println(deque)
    deque.prepend(9)
    deque.prepend(1)
    deque.append(5)
    deque.prepend(3)
    deque.sortInPlace()
    println(deque)
    deque.sortInPlaceWith(descending)
    println(deque)
    deque.sortInPlaceBy(x -> x)
    println(deque)
    println(s"${deque.removeHead()} ${deque.removeLast()}")
    val wordDeque: Deque[string] = ["m", "z"]
    wordDeque.prepend("q")
    wordDeque.prepend("a")
    wordDeque.sortInPlace()
    println(wordDeque)
    val entryDeque: Deque[Entry] = [Entry(2, "a"), Entry(1, "b")]
    entryDeque.prepend(Entry(1, "c"))
    entryDeque.prepend(Entry(2, "d"))
    entryDeque.sortInPlaceBy(e -> e.rank)
    println(names(entryDeque))
    val levelDeque: Deque[Level] = [High, Low]
    levelDeque.prepend(Middle)
    levelDeque.sortInPlace()
    println(levelDeque)
    val realDeque: Deque[real] = [2.0, 1.0]
    realDeque.prepend(3.5)
    realDeque.sortInPlace()
    println(realDeque)
