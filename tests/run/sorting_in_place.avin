// An array, a buffer and a deque sort in place: `sort()` where the elements are ordered, and
// `sortBy(key)` and `sortWith(compare)` always. Every sort is stable, so elements that compare equal
// keep their order; a deque sorts from its front, wherever its ring starts.
data Entry(rank: int, name: string)

data Level derives Eq, Hash, Ord
    Low
    Middle
    High

descending(a: int, b: int) -> int = b.compare(a)

names(entries: Seq[Entry]) -> string = entries.foldLeft("", (acc, e) -> acc + e.name)

main()
    // Arrays.
    val empty: Array[int] = Array.empty()
    empty.sort()
    empty.sortBy(x -> x)
    empty.sortWith(descending)
    println(empty)
    val one: Array[int] = [4]
    one.sort()
    println(one)
    val ascending: Array[int] = [1, 2, 3]
    ascending.sort()
    println(ascending)
    val reversed: Array[int] = [5, 4, 3, 2, 1]
    reversed.sort()
    println(reversed)
    val repeated: Array[int] = [2, 3, 2, 1, 3, 1]
    repeated.sortWith(descending)
    println(repeated)
    repeated.sortBy(x -> x)
    println(repeated)
    val words: Array[string] = ["pear", "Fig", "äpfel", "apple"]
    words.sort()
    println(words)
    val reals: Array[real] = [0.5, -2.0, 3.25, 0.0]
    reals.sort()
    println(reals)
    val levels: Array[Level] = [High, Low, Middle, Low]
    levels.sort()
    println(levels)
    val entries: Array[Entry] = [Entry(2, "a"), Entry(1, "b"), Entry(2, "c"), Entry(1, "d")]
    entries.sortBy(e -> e.rank)
    println(names(entries))
    entries.sortWith((x, y) -> y.rank.compare(x.rank))
    println(names(entries))

    // Buffers.
    val buffer = Buffer[int]()
    buffer.sort()
    println(buffer)
    buffer += 3
    buffer.sort()
    println(buffer)
    buffer ++= [1, 2, 1]
    buffer.sort()
    println(buffer)
    buffer.sortWith(descending)
    println(buffer)
    buffer.sortBy(x -> x % 2)
    println(buffer)
    val wordBuffer = Buffer[string]()
    wordBuffer ++= ["b", "a", "c", "a"]
    wordBuffer.sort()
    println(wordBuffer)
    val levelBuffer = Buffer[Level]()
    levelBuffer ++= [Middle, High, Low]
    levelBuffer.sortWith((a, b) -> b.compare(a))
    println(levelBuffer)
    val realBuffer = Buffer[real]()
    realBuffer ++= [1.5, -1.5, 0.25]
    realBuffer.sort()
    println(realBuffer)
    val entryBuffer = Buffer[Entry]()
    entryBuffer ++= [Entry(3, "a"), Entry(1, "b"), Entry(3, "c"), Entry(1, "d"), Entry(2, "e")]
    entryBuffer.sortBy(e -> e.rank)
    println(names(entryBuffer))
    // A sorted buffer still grows and shrinks as before.
    entryBuffer.add(Entry(0, "f"))
    entryBuffer.remove(0)
    println(names(entryBuffer))

    // Deques, sorted after `addFirst` has moved the ring's start.
    val deque: Deque[int] = []
    deque.sort()
    println(deque)
    deque.addLast(5)
    deque.sort()
    println(deque)
    deque.addFirst(9)
    deque.addFirst(1)
    deque.addLast(5)
    deque.addFirst(3)
    deque.sort()
    println(deque)
    deque.sortWith(descending)
    println(deque)
    deque.sortBy(x -> x)
    println(deque)
    println(s"${deque.removeFirst()} ${deque.removeLast()}")
    val wordDeque: Deque[string] = ["m", "z"]
    wordDeque.addFirst("q")
    wordDeque.addFirst("a")
    wordDeque.sort()
    println(wordDeque)
    val entryDeque: Deque[Entry] = [Entry(2, "a"), Entry(1, "b")]
    entryDeque.addFirst(Entry(1, "c"))
    entryDeque.addFirst(Entry(2, "d"))
    entryDeque.sortBy(e -> e.rank)
    println(names(entryDeque))
    val levelDeque: Deque[Level] = [High, Low]
    levelDeque.addFirst(Middle)
    levelDeque.sort()
    println(levelDeque)
    val realDeque: Deque[real] = [2.0, 1.0]
    realDeque.addFirst(3.5)
    realDeque.sort()
    println(realDeque)
