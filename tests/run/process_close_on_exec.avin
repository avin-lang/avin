// A started program sees only its three standard streams, whatever this program has open: files in
// every mode, TCP and Unix listeners, connected streams at both ends, the pipe of another command
// still being read, and the runtime's own descriptors once threads and futures are running. `ls`
// lists `/dev/fd`, which shows the descriptors open in it, its own among them: `0 1 2 3` on Linux,
// and `0 1 2 3 4` on macOS, where `ls` holds the directory it runs in open as well. That is the
// answer in every way a command is run and redirected, at both optimization levels, and any
// descriptor the child had been handed would show as one more.
import avin.fs
import avin.net.{TcpListener, TcpStream, UnixListener, UnixStream}
import avin.process
import avin.process.Command
import avin.threads
import avin.threads.Future

listing() -> Command = Command("/bin/ls", "/dev/fd")

words(text: string) -> string = text.split("\n").filter(w -> w.nonEmpty()).mkString(" ")

// Whether `ls /dev/fd` listed only the standard streams and its own: on macOS it holds the directory
// it runs in and `/dev/fd` open, 3 and 4, and on Linux `/proc/self/fd`, 3.
clean(text: string) -> bool = words(text) == (if process.os() == process.MacOS then "0 1 2 3 4" else "0 1 2 3")

main()
  val dir = fs.createTempDir("avin-cloexec").ok().get()
  val f = s"$dir/file"
  fs.writeText(f, "text\n")
  // Open files of every mode.
  val reading = fs.open(f).ok().get()
  val writing = fs.create(s"$dir/created").ok().get()
  val appending = fs.append(f).ok().get()
  val updating = fs.openUpdate(f).ok().get()
  val fresh = fs.createUpdate(s"$dir/fresh").ok().get()
  // Listeners and both ends of connected streams.
  val tcp = TcpListener.bind("127.0.0.1", 0).ok().get()
  val tcpClient = TcpStream.connect("127.0.0.1", tcp.port()).ok().get()
  val tcpServer = tcp.accept().ok().get()
  val unix = UnixListener.bind(s"$dir/socket").ok().get()
  val unixClient = UnixStream.connect(s"$dir/socket").ok().get()
  val unixServer = unix.accept().ok().get()
  // Another command's output still being read, through its pipe.
  val other = Command("/bin/sh", "-c", "echo first; sleep 5").errorsToFile(s"$dir/other").lines().ok().get()
  println(other.next())
  // Threads and the futures' pool running.
  println(Future(6 * 7).await())
  println(threads.spawn(() -> 1).join())
  // Captured, read as lines, written to a file, appended, fed from a file, with errors redirected.
  println(clean(listing().output().ok().get()))
  println(clean(listing().lines().ok().get().mkString("\n")))
  println(listing().toFile(s"$dir/out").run())
  println(clean(fs.readText(s"$dir/out").ok().get()))
  println(listing().appendTo(s"$dir/appended").errorsToOutput().run())
  println(clean(fs.readText(s"$dir/appended").ok().get()))
  println(clean(listing().fromFile(f).errorsToFile(s"$dir/errors").output().ok().get()))
  println(clean(listing().withInput("input\n").output().ok().get()))
  // In a group of its own, in a pipeline (whose other pipe end it must not hold) and in a sequence.
  println(clean(listing().inNewGroup().output().ok().get()))
  println(clean((listing() | Command("/bin/cat")).output().ok().get()))
  println(clean((Command("/usr/bin/true") andThen listing()).output().ok().get()))
  // Started and waited for.
  val child = listing().toFile(s"$dir/started").start().ok().get()
  println(child.waitFor())
  println(clean(fs.readText(s"$dir/started").ok().get()))
  // Everything this program opened is still its own.
  println(reading.readAll().map(b -> b.length))
  println(tcpClient.writeText("ping\n").isOk())
  println(tcpServer.readLine())
  println(unixClient.writeText("pong\n").isOk())
  println(unixServer.readLine())
  for c in [writing, appending, updating, fresh] do c.close()
  fs.removeDirAll(dir)
