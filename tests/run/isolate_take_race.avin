// expect: exit 0
// stderr: actor numbers vary
// Two actors race to `take` one `Isolated`, round after round: the atomic compare-and-set lets
// exactly one of them have the objects and the other traps with "`Isolated` was already taken". Each
// racer is spawned with `onFailure = Stop`, so the winner ends `Stopped` after handing back the sum
// it took, the loser ends `Failed`, and their endings are counted rather than named: which actor wins
// a round is decided at run time, so the output is the same either way.
import avin.actors.{ActorRef, Failed, Stop, Stopped, Isolated, isolate, spawn}
import avin.threads.Channel

data Race
    Grab(chunk: Isolated[Buffer[int]])

actor Racer(sums: Channel[int]) receives Race
    receive
        Grab(chunk) ->
            val b = chunk.take()
            var sum = 0
            for x in b
                sum += x
            sums.send(sum)
            stop()

main() -> int
    val rounds = 200
    val sums = Channel[int]()
    var wins = 0
    var traps = 0
    var bad = 0
    for round in 0..<rounds
        val chunk = isolate
            val b = Buffer[int]()
            for i in 0..<10
                b.addOne(round + i)
            b
        val a = spawn(Racer(sums), onFailure = Stop)
        val b = spawn(Racer(sums), onFailure = Stop)
        a.tell(Grab(chunk))
        b.tell(Grab(chunk))
        var won = 0
        for r in [a, b]
            r.ended().await() match
                Stopped -> won += 1
                Failed(_) -> traps += 1
        wins += won
        if won != 1 || sums.receive() != Some(10 * round + 45) then bad += 1
    println(s"rounds $rounds")
    println(s"wins $wins")
    println(s"traps $traps")
    println(s"bad rounds $bad")
    if wins == rounds && traps == rounds && bad == 0 then 0 else 1
