// expect: exit 0
// Conversions in and out: from integers of every width and a `BigInt` exactly; from a `real` by the
// two explicit choices, its exact binary value or its shortest decimal; to a `real` as the nearest one;
// and to the integers toward zero, as `toLong`, `toInt` and `toBigInt`, with the `Option` forms
// answering None where the whole part does not fit. The parts: `unscaled`, `scale`, `precision`.
main()
  // From integers and a `BigInt`.
  println(BigDecimal(42))
  println(BigDecimal(long.MinValue))
  println(BigDecimal(long.MaxValue))
  val wide: i128 = -170141183460469231731687303715884105728
  println(BigDecimal(wide))
  val small: i8 = -128
  println(BigDecimal(small))
  println(BigDecimal(BigInt(2).pow(100)))
  println(BigDecimal.fromInteger(7))
  println(BigDecimal.fromBigInt(BigInt(-7)))
  println(BigDecimal.fromDecimal("-7.50"))
  // From a `real`: every digit of its binary value, or the shortest decimal that reads back as it.
  for r in [0.1, 0.5, 2.0, -2.0, 0.0, -0.0, 1e21, 1.5e-7, 123.456, -1.0 / 3.0, 5e-324, 1.7976931348623157e308]
    val shortest = BigDecimal.fromRealShortest(r)
    println(s"$r -> $shortest (scale ${shortest.scale}) round-trips ${shortest.toReal == r}")
  for r in [0.1, 0.5, 0.25, 2.0, -0.0, 1e21, -1.0 / 3.0, 3.0e-5]
    val exact = BigDecimal.fromRealExact(r)
    println(s"$r -> $exact (scale ${exact.scale}) round-trips ${exact.toReal == r}")
  println(BigDecimal.fromRealExact(5e-324).scale)
  println(BigDecimal.fromRealExact(5e-324).precision)
  println(BigDecimal.fromRealExact(1.7976931348623157e308).precision)
  println(BigDecimal.fromRealExact(0.1) == BigDecimal.fromRealShortest(0.1))
  println(BigDecimal.fromRealExact(0.5) == BigDecimal.fromRealShortest(0.5))
  // To a `real`: the nearest, a tie to even, and infinities and zero beyond the range.
  println(BigDecimal("0.1").toReal)
  println(BigDecimal("-2.5").toReal)
  println(BigDecimal("12345678901234567890.123456789").toReal)
  println(BigDecimal("9007199254740993").toReal)
  println(BigDecimal(BigInt(10).pow(400), 0).toReal)
  println(BigDecimal(-BigInt(10).pow(400), 0).toReal)
  println(BigDecimal(BigInt(1), 400).toReal)
  println(BigDecimal("0.000").toReal)
  // To the integers, toward zero.
  for t in ["2.7", "-2.7", "0.999", "-0.999", "5", "-5", "123456789.000000001", "0.00"]
    val d = BigDecimal(t)
    println(s"$t -> ${d.toBigInt} ${d.toLong} ${d.toInt} ${d.toLongOption} ${d.toIntOption}")
  println(BigDecimal("9223372036854775807.9").toLongOption)
  println(BigDecimal("9223372036854775808").toLongOption)
  println(BigDecimal("-9223372036854775808.9").toLongOption)
  println(BigDecimal("-9223372036854775809").toLongOption)
  println(BigDecimal("2147483647.5").toIntOption)
  println(BigDecimal("2147483648").toIntOption)
  println(BigDecimal("-2147483648.99").toIntOption)
  println(BigDecimal("1e30").toBigInt)
  println(BigDecimal("-1e30").toIntOption)
  // The parts.
  for t in ["123.45", "-0.001", "0", "0.000", "1e3", "100", "-12345678901234567890.5"]
    val d = BigDecimal(t)
    println(s"$t: unscaled ${d.unscaled} scale ${d.scale} precision ${d.precision}")
  println(BigDecimal(BigInt(-1999), 2))
  println(BigDecimal(BigInt(0), 3))
  // `pow` is exact.
  println(BigDecimal("1.1").pow(2))
  println(BigDecimal("-0.5").pow(3))
  println(BigDecimal("1.5").pow(0))
  println(BigDecimal("0.00").pow(0))
  println(BigDecimal("10").pow(25))
  println(BigDecimal("1.01").pow(30).scale)
