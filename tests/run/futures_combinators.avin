// expect: exit 0
// The combinators make new futures without waiting: `map` and `flatMap` chain, `zip` pairs two
// values, `first` gives whichever value is there first, and `onComplete` runs on a pool thread once
// the value is there, also for a future already complete. Every step allocates, so collections run
// while the steps are spread over the pool.
import avin.threads.{Future, Mutex, Promise}

main() -> int
    val chain = Future(2).map(x -> x + 1).flatMap(x -> Future(s"${x * 10}")).map(s -> s + "!")
    println(s"chain ${chain.await()}")
    var deep = Future.successful(0)
    for i in 0..<200
        deep = deep.flatMap(n -> Future(n + i)).map(n -> n + 1)
    println(s"deep ${deep.await()}")
    val (n, word) = Future(1).zip(Future("one")).await()
    println(s"zip $n $word")
    val never = Promise[string]()
    val first = Future.first([never.future, Future("quick"), never.future])
    println(s"first ${first.await()}")
    val kept = Promise[int]()
    val unkept = Promise[int]()
    val firstKept = Future.first([unkept.future, kept.future])
    kept.complete(5)
    println(s"first kept ${firstKept.await()}")
    val seen = Mutex(Buffer[string]())
    val finished = Promise[unit]()
    val counted = Future(21)
    counted.onComplete(v ->
        seen.with(b -> b.add(s"value $v"))
        finished.complete(()))
    finished.future.await()
    val late = Promise[unit]()
    counted.onComplete(v ->
        seen.with(b -> b.add(s"again $v"))
        late.complete(()))
    late.future.await()
    println(seen.with(b -> b.mkString(", ")))
    0
