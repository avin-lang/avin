// expect: exit 0
// A method named by a symbol binds at the level of the language's operator its first character
// belongs to: `~` and `~>` start no operator of a level and bind tightest, `^^` binds with `^`, and
// `<~` with the comparisons. A type other than the integers may have methods named `|`, `&`, `^`
// and `~`, which `a | b` calls; on integers they stay the machine's operators. `x |= y` calls the
// target's method `|=` where its type has one, and is otherwise `x = x | y`.

// A grammar term, shown as the expression it was built from.
class Term(val text: string)
    ~(other: Term) -> Term = Term(s"($text ~ ${other.text})")
    ~>(other: Term) -> Term = Term(s"($text ~> ${other.text})")
    <~(other: Term) -> Term = Term(s"($text <~ ${other.text})")
    ^^(f: string) -> Term = Term(s"($text ^^ $f)")
    |(other: Term) -> Term = Term(s"($text | ${other.text})")

data Flags(bits: int)

impl Flags
    |(other: Flags) -> Flags = Flags(bits | other.bits)
    &(other: Flags) -> Flags = Flags(bits & other.bits)
    ^(other: Flags) -> Flags = Flags(bits ^ other.bits)
    ~(other: Flags) -> Flags = Flags(bits & ~other.bits)

class Log(var entries: Vector[string])
    |=(entry: string)
        entries = entries :+ entry

trait Choice
    |(other: Self) -> Self

data Pick(name: string)

impl Choice for Pick
    |(other: Pick) -> Pick = if name == "" then other else self

either[T: Choice](a: T, b: T) -> T = a | b

impl string
    &(other: string) -> string = self + " and " + other

main()
    val a = Term("a")
    val b = Term("b")
    val c = Term("c")
    val d = Term("d")
    print((a ~ b ^^ "f" | c ~ d).text)
    print((a ~> b <~ c).text)
    print((a <~ b ~ c).text)
    print((a ~ b ~> c | d).text)

    val r = Flags(12)
    print(s"${(r | Flags(1)).bits} ${(r & Flags(4)).bits} ${(r ^ Flags(4)).bits} ${(r ~ Flags(4)).bits}")
    print(s"${(Flags(1) | Flags(2) & Flags(3)).bits}")
    var f = Flags(1)
    f |= Flags(4)
    print(s"${f.bits}")
    f &= Flags(6)
    print(s"${f.bits}")
    f ^= Flags(5)
    print(s"${f.bits}")
    val log = Log([])
    log |= "one"
    log |= "two"
    print(s"${log.entries}")
    print(either(Pick(""), Pick("second")).name)
    print("salt" & "pepper")

    // The integers keep their operators.
    val x = 12
    val mask = 3
    print(s"${x | 1} ${x & mask == 0} ${x ^ 5 | 2} ${~x}")
    var n = 1
    n |= 6
    print(s"$n")

    // The library's symbol methods: `++` and `+:` bind with `+`, `:+` with `::`.
    val xs = [1, 2]
    print(s"${xs ++ [3] :+ 4} ${0 +: xs :+ 9}")
