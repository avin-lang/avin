// expect: exit 0
// A deadlock among some threads while another still runs is not found: two threads wait for ever on
// each other's mutex, but `main` is not waiting, so the program goes on and ends when `main` returns,
// leaving them waiting.
import avin.threads.{Channel, Mutex, sleep, spawn}
import avin.time.millis

main()
  val a = Mutex(0)
  val b = Mutex(0)
  val aTaken = Channel[int]()
  val bTaken = Channel[int]()
  spawn(() ->
    a.with(x ->
      aTaken.send(1)
      bTaken.receive()
      b.with(y -> x + y)))
  spawn(() ->
    b.with(y ->
      bTaken.send(1)
      aTaken.receive()
      a.with(x -> x + y)))
  sleep(millis(100))
  var sum = 0
  for i in 1 .. 1000 do sum += i
  println(sum)
