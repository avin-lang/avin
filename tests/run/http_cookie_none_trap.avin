// expect: trap
// `SameSite=None` is sent only on a secure cookie, so a cookie made with it and without `Secure` traps.
import avin.net.http.{SetCookie, Unrestricted}

main()
  println(SetCookie("a", "1", sameSite = Some(Unrestricted), secure = true).header)
  println(SetCookie("a", "1", sameSite = Some(Unrestricted)).header)
