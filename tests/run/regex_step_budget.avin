// expect: exit 0
// The step budget: patterns that backtrack only as far as an input's length asks finish under it,
// the classic exponential shapes finish where a greedy loop remembers where it failed, their
// possessive and atomic forms finish at once, and `withStepLimit` sets the budget of each attempt at
// a start, not of a whole search.
import avin.regex.Regex

doubled(s: string, k: int) -> string
    var out = s
    for _ in 0..<k do out = out + out
    out

show(pattern: string, input: string) = println(s"$pattern: ${Regex(pattern).findFirstIn(input)}")

main()
    val a40 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    val a2048 = doubled("a", 11)
    // A greedy, unbounded repetition of a group, in a pattern with no back reference, remembers the
    // indices where a further repetition failed, so these take polynomial time, not exponential.
    show("(a+)+$", a40 + "b")
    show("(a|a)*b", a40)
    show("(a|aa)+$", a40 + "b")
    show("(a*)*$", a40 + "b")
    show("(?:a+)+$", a40 + "b")
    println(Regex("(a+)+$").findFirstIn(a2048 + "b"))
    println(Regex("(a|aa)+$").findFirstIn(a2048 + "b"))
    println(Regex("(a|a)*b").findFirstIn(a2048))
    // The shapes that do backtrack exponentially, made possessive or atomic, fail at once.
    show("(a++)+?$", a40 + "b")
    show("(?>a+)+?$", a40 + "b")
    show("(?>a|a){1,60}b", a40)
    show("(a|a){1,60}+b", a40)
    show("(?>a|aa)+$\\1", a40 + "b")
    show("(a|aa)++$\\1", a40 + "b")
    show("(a++)++$", a40 + "b")
    // And where they can match, they match.
    show("(a++)+?$", a40)
    show("(?>a|a){1,60}b", a40 + "b")
    show("(?>a|aa)+$", a40)
    // The budget is per attempt: a search over many starts takes more steps in all than one
    // attempt may.
    val words = doubled("word ", 10)
    val counted = Regex("\\w+").withStepLimit(50).findAllIn(words).toVector.length
    println(s"words $counted")
    println(Regex("(\\w+)\\s").withStepLimit(100).replaceAllIn(doubled("ab ", 4), "$1,"))
    // A limit keeps the regex's anchoring, and reaches `pattern().split`.
    println(Regex("b").unanchored().withStepLimit(100).matches("abc"))
    println(Regex("b").withStepLimit(100).matches("abc"))
    println(Regex("b").withStepLimit(100).unanchored().matches("abc"))
    println(Regex(",").withStepLimit(10).split("a,b,c").toList)
    println(Regex("(a)(b)?").withStepLimit(1000).pattern().groupCount())
    println(Regex("x+").withStepLimit(5).regex())
    // A generous limit lets a slow pattern finish.
    println(Regex("(a|a){1,60}b").withStepLimit(1000000).findFirstIn("aaaaaaaaab"))
    println(Regex("(a|a){1,60}b").withStepLimit(100000000).findFirstIn("aaaaaaaaaaaaaaaa"))
