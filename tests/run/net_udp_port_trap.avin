// expect: trap
// A port outside 0 to 65535 is a mistake in the program, not a failure of the network: a send to one
// traps, after a send to the last port, 65535, goes as any other.
import avin.net.{IpAddress, UdpSocket}

main()
  UdpSocket.bind("127.0.0.1", 0) match
    Ok(s) ->
      println(s.sendTo("x".utf8, IpAddress.Localhost, 65535).isOk)
      println(s.sendTo("x".utf8, IpAddress.Localhost, 65536).isOk)
      println("not reached")
    Err(e) -> println(e.message)
