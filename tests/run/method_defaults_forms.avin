// Defaults on the other forms a method takes: generic, overloaded, by-name and defined by clauses. A
// method used as a value takes every parameter.
class Tool(name: string)
    // A generic method's default is of its own type parameter's type, from an earlier parameter.
    twice[T](first: T, second: T = first) -> (T, T) = (first, second)
    // Overloads that differ in a defaulted parameter's type, each with its own default.
    tag(n: int, mark: string = "#") -> string = s"$mark$n $name"
    tag(s: string, mark: string = "@") -> string = s"$mark$s $name"
    // A by-name parameter's default is delayed like any argument to it.
    either(flag: bool, fallback: -> string = loud()) -> string = if flag then name else fallback
    loud() -> string
        print("computing fallback")
        name + "!"
    // Clauses match every parameter, the defaulted one included.
    sign(n: int, zero: string = s"$name zero") -> string
    sign(0, z) = z
    sign(n < 0, _) = "negative"
    sign(_, _) = "positive"
    total(a: int, b: int = a) -> int = a + b

main()
    val t = Tool("saw")
    val (a, b) = t.twice(3)
    print(s"$a $b")
    val (c, d) = t.twice("x")
    print(s"$c $d")
    print(t.tag(1))
    print(t.tag("one"))
    print(t.tag(2, "%"))
    print(t.either(true))
    print(t.either(false))
    print(t.sign(0))
    print(t.sign(0, "nothing"))
    print(t.sign(-4))
    val f: (int, int) -> int = t.total
    print(s"${f(1, 2)} ${t.total(4)}")
