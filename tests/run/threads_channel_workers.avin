// expect: exit 174
// The example in the threads chapter: four workers square the jobs a bounded channel hands them and
// send the squares on an unbounded one, which the main thread totals once both are closed. The sum
// of the squares of 1 to 100 is 338350, which is 174 modulo 256.
import avin.threads.{Channel, scope}

main() -> int
  val jobs = Channel[int](16)
  val results = Channel[int]()
  scope(s ->
    for w in 0 ..< 4
      s.spawn(() ->
        for n in jobs do results.send(n * n))
    for n in 1 .. 100 do jobs.send(n)
    jobs.close())
  results.close()
  var total = 0
  for r in results do total += r
  total % 256
