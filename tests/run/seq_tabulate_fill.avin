// expect: exit 0
// `Vector`, `List` and `ArraySeq` each have `tabulate(n)(f)`-shaped and `fill` companions like
// `Array`'s: `tabulate` calls `f` with 0 ..< n in order, `fill` evaluates its element once for each
// position, and a length that is not positive gives an empty collection.

data Point(x: int, y: int)

class Counter(var n: int)

bump(c: Counter) -> int
  c.n += 1
  c.n

main()
  // tabulate
  println(Vector.tabulate(5, i -> i * i))
  println(List.tabulate(5, i -> i * i))
  println(ArraySeq.tabulate(5, i -> i * i))
  println(Vector.tabulate(0, i -> i).isEmpty)
  println(List.tabulate(0, i -> i).isEmpty)
  println(ArraySeq.tabulate(0, i -> i).isEmpty)
  println(Vector.tabulate(-3, i -> i).length)
  println(List.tabulate(-3, i -> i).length)
  println(ArraySeq.tabulate(-3, i -> i).length)
  println(Vector.tabulate(1, i -> s"x$i"))
  println(List.tabulate(1, i -> s"x$i"))
  println(ArraySeq.tabulate(1, i -> s"x$i"))
  // Order of evaluation.
  var order = ""
  val v = Vector.tabulate(4, i ->
    order = s"$order$i"
    i)
  var order2 = ""
  val l = List.tabulate(4, i ->
    order2 = s"$order2$i"
    i)
  var order3 = ""
  val a = ArraySeq.tabulate(4, i ->
    order3 = s"$order3$i"
    i)
  println(s"$order $order2 $order3 $v $l $a")
  // A function never called for an empty result.
  var calls = 0
  Vector.tabulate(0, i ->
    calls += 1
    i)
  List.tabulate(-1, i ->
    calls += 1
    i)
  ArraySeq.tabulate(0, i ->
    calls += 1
    i)
  println(calls)
  // Large n, across the vector's levels.
  val big = Vector.tabulate(1100, i -> i)
  println(s"${big.length} ${big(0)} ${big(31)} ${big(32)} ${big(1023)} ${big(1024)} ${big(1099)}")
  val bigL = List.tabulate(1100, i -> i)
  println(s"${bigL.length} ${bigL.head} ${bigL.last}")
  val bigA = ArraySeq.tabulate(1100, i -> i)
  println(s"${bigA.length} ${bigA(0)} ${bigA(1099)}")
  println(big == bigL)
  println(bigA == bigL)
  // Generic element types and equality across the kinds.
  println(Vector.tabulate(3, i -> Point(i, -i)))
  println(List.tabulate(3, i -> (i, s"$i")))
  println(ArraySeq.tabulate(3, i -> Some(i)))
  println(Vector.tabulate(3, i -> [i, i]))
  println(Vector.tabulate(3, i -> i) == [0, 1, 2])
  println(List.tabulate(3, i -> i) == [0, 1, 2])
  println(ArraySeq.tabulate(3, i -> i) == [0, 1, 2])
  println(Vector.tabulate(3, i -> real(i) * 0.5))

  // fill
  println(Vector.fill(3, 7))
  println(List.fill(3, "a"))
  println(ArraySeq.fill(3, true))
  println(Vector.fill(0, 7).isEmpty)
  println(List.fill(0, 7).isEmpty)
  println(ArraySeq.fill(0, 7).isEmpty)
  println(Vector.fill(-2, 7).length)
  println(List.fill(-2, 7).length)
  println(ArraySeq.fill(-2, 7).length)
  println(Vector.fill(1, 'c'))
  println(List.fill(1, 'c'))
  println(ArraySeq.fill(1, 'c'))
  // The element is evaluated once for each position.
  val c1 = Counter(0)
  val fv = Vector.fill(4, bump(c1))
  val c2 = Counter(0)
  val fl = List.fill(4, bump(c2))
  val c3 = Counter(0)
  val fa = ArraySeq.fill(4, bump(c3))
  println(s"$fv $fl $fa ${c1.n} ${c2.n} ${c3.n}")
  // Not evaluated at all for an empty result.
  val c4 = Counter(0)
  Vector.fill(0, bump(c4))
  List.fill(-5, bump(c4))
  ArraySeq.fill(0, bump(c4))
  println(c4.n)
  // A reference element is evaluated afresh, so each position holds its own object.
  val objs = List.fill(3, Counter(0))
  objs(0).n = 5
  println(s"${objs(0).n} ${objs(1).n} ${objs(2).n}")
  val objsV = Vector.fill(3, Counter(0))
  objsV(2).n = 8
  println(s"${objsV(0).n} ${objsV(2).n}")
  val objsA = ArraySeq.fill(3, Counter(0))
  objsA(1).n = 4
  println(s"${objsA(0).n} ${objsA(1).n}")
  // Large fill.
  println(Vector.fill(1100, 1).foldLeft(0, (a, b) -> a + b))
  println(List.fill(1100, 1).foldLeft(0, (a, b) -> a + b))
  println(ArraySeq.fill(1100, 1).foldLeft(0, (a, b) -> a + b))
  // Generic element types.
  println(Vector.fill(2, Point(1, 2)))
  println(List.fill(2, [1, 2]))
  println(ArraySeq.fill(2, (1, "x")))
  // The result widens like any other.
  val ints: Vector[int] = Vector.fill(2, 1)
  println(ints :+ 3)
