// A line that starts with a binary operator and is indented deeper than the line its expression
// began on continues that expression, at the operator's own precedence: the line break means
// nothing. A method named by a symbol with `~` in it binds tightest, so a grammar's `~`, `~>` and
// `<~` read together, and `|` between alternatives binds loosest of them.

// A grammar term, shown as the expression it was built from.
class Term(val text: string)
    ~(other: Term) -> Term = Term(s"($text ~ ${other.text})")
    ~>(other: Term) -> Term = Term(s"($text ~> ${other.text})")
    <~(other: Term) -> Term = Term(s"($text <~ ${other.text})")
    ^^(f: string) -> Term = Term(s"($text ^^ $f)")
    |(other: Term) -> Term = Term(s"($text | ${other.text})")

t(text: string) -> Term = Term(text)

// A parser of a list of tokens: from a position, the value read and the position after it.
class Grammar(val run: (Vector[string], int) -> Option[(int, int)])
    |(other: Grammar) -> Grammar = Grammar((ts, i) -> self.run(ts, i) match
        Some(r) -> Some(r)
        None -> other.run(ts, i))
    ~>(other: Grammar) -> Grammar = Grammar((ts, i) -> self.run(ts, i) match
        Some((_, j)) -> other.run(ts, j)
        None -> None)
    <~(other: Grammar) -> Grammar = Grammar((ts, i) -> self.run(ts, i) match
        Some((v, j)) -> other.run(ts, j) match
            Some((_, k)) -> Some((v, k))
            None -> None
        None -> None)
    ^^(f: int -> int) -> Grammar = Grammar((ts, i) -> self.run(ts, i) match
        Some((v, j)) -> Some((f(v), j))
        None -> None)

symbol(s: string) -> Grammar = Grammar((ts, i) -> if i < ts.length() && ts(i) == s then Some((0, i + 1)) else None)

digit(d: string, v: int) -> Grammar = Grammar((ts, i) -> if i < ts.length() && ts(i) == d then Some((v, i + 1)) else None)

// A number, a parenthesized number, or a negated one.
atom() -> Grammar =
    digit("1", 1)
        | digit("2", 2)
        | symbol("(") ~> digit("3", 3) <~ symbol(")")
        | symbol("-") ~> digit("4", 4) ^^ (n -> 0 - n)

parsed(g: Grammar, ts: Vector[string]) -> string = g.run(ts, 0) match
    Some((v, n)) -> s"$v after $n"
    None -> "no parse"

total(a: int, b: int, c: int, d: int) -> int =
    a
        + b * c
        - d

sign(x: int) -> int
    if x < 0
        -1
    else
        val magnitude = x
            * 1
        magnitude
            - x
            + 1

main()
    val term = t("num")
        | t("(") ~> t("expr") <~ t(")")
        | t("ident") ^^ "Var"
    println(term.text)
    println((t("[") ~> t("items") <~ t("]") ^^ "f").text)
    println((t("a") <~ t("b") ~ t("c")).text)

    val g = atom()
    println(parsed(g, ["2"]))
    println(parsed(g, ["(", "3", ")"]))
    println(parsed(g, ["-", "4"]))
    println(parsed(g, ["("]))

    println(total(1, 2, 3, 4))
    val big = 1 + 2
        * 3

        // A comment and a blank line between continuation lines change nothing.
        - 4
    println(big)
    println(sign(-5))
    println(sign(5))
    val chained = 1 < 2
        < 3
    println(chained)
