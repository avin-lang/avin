// expect: exit 0
// Multi-line block lambdas as the items of lists, tuples, calls, maps, sets and nested lists, each
// item after one at its bracket's indentation, as `avin fmt` lays them out; the program means what it
// did before formatting.
f(g: () -> int) -> int = g()

h(x: int) -> int = x

k(a: int, b: int, c: int) -> int = a + b + c

main()
  val xs = [1, 2]
  val ts = [
    f(() ->
      h(0)
      h(1)),
    f(() -> 2),
    f(() ->
      h(3)
      h(4)),
    f(() -> 5)]
  val t = (
    f(() ->
      h(0)
      h(6)),
    f(() -> 7))
  val c = k(
    f(() ->
      h(0)
      h(1)),
    f(() -> 2),
    3)
  val m = {
    "a": f(() ->
      h(0)
      h(1)),
    "b": f(() -> 2)}
  val n = [
    [f(() ->
      h(0)
      h(1)),
      f(() -> 2)],
    [3]]
  val e = [
    f(() ->
      h(0) match
        0 -> 1
        _ -> 2),
    // a comment between items
    f(() ->
      if h(1) > 0 then 3 else 4),
    f(() -> 5)]
  val us = [
    (xs.map x ->
      val y = x + 1
      y),
    (xs.map x ->
      x * 2),
    xs]
  val vs = [
    xs.map x ->
      x + 3]
  println(ts)
  println(t)
  println(c)
  println(m("a") + m("b"))
  println(n)
  println(e)
  println(us)
  println(vs)
