// expect: trap
// A trap while an actor holds a semaphore's permit inside `withPermit` stops the program instead of
// failing the actor: the permit would otherwise never come back. The report still names the actor.
import avin.actors.{Stop, spawn}
import avin.threads.{Channel, Semaphore}

actor Worker(permits: Semaphore, done: Channel[int]) receives int
  receive
    n -> done.send(permits.withPermit(() -> 10 / n))

main()
  val permits = Semaphore(1)
  val done = Channel[int]()
  val w = spawn(Worker(permits, done), onFailure = Stop)
  w.tell(2)
  println(done.receive())
  w.tell(0)
  println(done.receive())
  println("not reached")
