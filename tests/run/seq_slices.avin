// expect: exit 0
// The slice methods of a sequence: `indexOfSlice`, `lastIndexOfSlice`, `containsSlice` and `patch`,
// with the empty slice, a slice longer than the sequence, repeats that overlap, out-of-range `from`
// and `end`, every kind of sequence and an element type of our own.

data Pt(x: int, y: int)

open class Animal(val name: string)
class Dog(n: string): Animal(n)

main()
    val v = [1, 2, 3, 1, 2, 3, 1]
    println(s"${v.indexOfSlice([1, 2])} ${v.indexOfSlice([2, 3, 1])} ${v.indexOfSlice([3, 1, 2, 3])} ${v.indexOfSlice([9])} ${v.indexOfSlice([1, 3])}")
    println(s"${v.indexOfSlice([1, 2], 1)} ${v.indexOfSlice([1, 2], 3)} ${v.indexOfSlice([1, 2], 4)} ${v.indexOfSlice([1], 6)} ${v.indexOfSlice([1], 7)}")
    println(s"${v.indexOfSlice([1, 2], -5)} ${v.indexOfSlice([1, 2], 100)}")
    // empty slice: found at from while from is no further than the end
    val none: Vector[int] = []
    println(s"${v.indexOfSlice(none)} ${v.indexOfSlice(none, 3)} ${v.indexOfSlice(none, 7)} ${v.indexOfSlice(none, 8)} ${v.indexOfSlice(none, -2)}")
    println(s"${none.indexOfSlice(none)} ${none.indexOfSlice([1])} ${none.indexOfSlice(none, 1)}")
    // slice as long as, and longer than, the sequence
    println(s"${v.indexOfSlice(v)} ${v.indexOfSlice(v ++ [1])} ${[5].indexOfSlice([5])} ${[5].indexOfSlice([5, 5])}")
    // overlapping repeats
    println(s"${[1, 1, 1, 1].indexOfSlice([1, 1, 1])} ${[1, 1, 2].indexOfSlice([1, 2])} ${[1, 1, 1, 2].indexOfSlice([1, 1, 2])}")

    println(s"${v.lastIndexOfSlice([1, 2])} ${v.lastIndexOfSlice([2, 3, 1])} ${v.lastIndexOfSlice([1, 2, 3])} ${v.lastIndexOfSlice([9])} ${v.lastIndexOfSlice([3, 1])}")
    println(s"${v.lastIndexOfSlice([1, 2], 3)} ${v.lastIndexOfSlice([1, 2], 2)} ${v.lastIndexOfSlice([1, 2], 0)} ${v.lastIndexOfSlice([1, 2], -1)} ${v.lastIndexOfSlice([1, 2], 100)}")
    println(s"${v.lastIndexOfSlice(none)} ${v.lastIndexOfSlice(none, 3)} ${v.lastIndexOfSlice(none, 100)} ${v.lastIndexOfSlice(none, -1)} ${none.lastIndexOfSlice(none)} ${none.lastIndexOfSlice([1])}")
    println(s"${v.lastIndexOfSlice(v)} ${v.lastIndexOfSlice(v ++ [1])} ${[1, 1, 1, 1].lastIndexOfSlice([1, 1, 1])} ${[1, 1, 2, 1, 1].lastIndexOfSlice([1, 1])}")

    println(s"${v.containsSlice([2, 3, 1, 2])} ${v.containsSlice([2, 1])} ${v.containsSlice(none)} ${none.containsSlice(none)} ${none.containsSlice([1])} ${v.containsSlice(v)} ${v.containsSlice(v ++ [1])}")

    // patch: replace in the middle, at the ends, past the ends, nothing taken out, everything taken out
    println(v.patch(2, [10, 20], 2))
    println(v.patch(0, [10], 1))
    println(v.patch(6, [10], 1))
    println(v.patch(7, [10, 11], 0))
    println(v.patch(3, none, 2))
    println(v.patch(0, none, 100))
    println(v.patch(3, [0], 0))
    println(v.patch(-4, [0], 2))
    println(v.patch(100, [0], 2))
    println(v.patch(5, [0], 100))
    println(v.patch(5, [0], -3))
    println(none.patch(0, [1, 2], 0))
    println(none.patch(3, [1, 2], 5))
    println(none.patch(0, none, 0))
    // an Iterable of another kind, and the type widens
    println(v.patch(1, 7 .. 9, 5))
    val dogs: Vector[Dog] = [Dog("rex"), Dog("fido"), Dog("spot")]
    val patched: Vector[Animal] = dogs.patch(1, [Animal("tom")], 1)
    println(patched.map(x -> x.name))
    // a patch leaves the receiver alone
    println(v)

    // every kind of sequence
    val l: List[int] = [1, 2, 3, 2, 3]
    val a: Array[int] = [1, 2, 3, 2, 3]
    val b: Buffer[int] = [1, 2, 3, 2, 3]
    val d: Deque[int] = [1, 2, 3, 2, 3]
    val r = 1 .. 5
    println(s"${l.indexOfSlice([2, 3])} ${a.indexOfSlice([2, 3])} ${b.indexOfSlice([2, 3])} ${d.indexOfSlice([2, 3])} ${r.indexOfSlice([3, 4])}")
    println(s"${l.lastIndexOfSlice([2, 3])} ${a.lastIndexOfSlice([2, 3])} ${b.lastIndexOfSlice([2, 3])} ${d.lastIndexOfSlice([2, 3])} ${r.lastIndexOfSlice([3, 4])}")
    println(s"${l.containsSlice(a)} ${r.containsSlice(d)} ${d.containsSlice(r)}")
    println(l.patch(1, r, 2))
    println(r.patch(0, l, 5))
    // a slice of another kind than the receiver, with elements of our own and strings
    println(s"${[Pt(1, 2), Pt(3, 4), Pt(5, 6)].indexOfSlice([Pt(3, 4), Pt(5, 6)])} ${[Pt(1, 2)].indexOfSlice([Pt(1, 3)])}")
    println(s"${["a", "bc", "a", "bc"].lastIndexOfSlice(["a", "bc"])} ${['h', 'e', 'l', 'l', 'o'].indexOfSlice(['l', 'l'])}")
    // many allocated elements, GC pressure
    val words = (0 ..< 300).map(i -> s"w${i % 7}")
    println(s"${words.indexOfSlice(["w6", "w0", "w1"])} ${words.lastIndexOfSlice(["w6", "w0", "w1"])} ${words.patch(3, words, 290).length}")
