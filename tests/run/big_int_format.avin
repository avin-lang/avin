// expect: exit 0
// A `BigInt` formats as an integer does: interpolated, printed, and under `%d`, `%i`, `%x`, `%X`,
// `%o` and `%b` with every flag, width and precision, matching `long` wherever the value fits one,
// and past `long` too; its `%?` form is its display form; it shows inside a collection.

main()
    for n in [long.MinValue, -255, -1, 0, 1, 7, 255, 1234567, 1000000000, long.MaxValue]
        val b = BigInt(n)
        val big = f"$b%d|$b%5d|$b%-6d|$b%+d|$b% d|$b%08d|$b%,d|$b%.3d|$b%x|$b%X|$b%#x|$b%#X|$b%o|$b%#o|$b%b|$b%#b|$b%010x|$b%-+8d|$b%i|$b%,015d"
        val ref = f"$n%d|$n%5d|$n%-6d|$n%+d|$n% d|$n%08d|$n%,d|$n%.3d|$n%x|$n%X|$n%#x|$n%#X|$n%o|$n%#o|$n%b|$n%#b|$n%010x|$n%-+8d|$n%i|$n%,015d"
        println(big)
        if big != ref then println(s"differs from long: $ref")
    val z = BigInt(0)
    println(f"[$z%.0d] [$z%#x] [$z%#o] [$z%+.0d]")
    val huge = BigInt(2).pow(100) - BigInt(1)
    println(f"$huge%d")
    println(f"$huge%,d")
    println(f"$huge%x")
    println(f"$huge%#X")
    println(f"$huge%o")
    println(f"$huge%b")
    println(f"${-huge}%40d|")
    println(f"${-huge}%-40d|")
    println(f"${-huge}%045d")
    println(f"${-huge}%+,d")
    println(f"$huge%.40d")
    println(f"$huge%?")
    println(s"value: $huge")
    println(huge.toString())
    println([BigInt(1), -huge])
    println(Some(BigInt(-3)))
    println((BigInt(1), BigInt(2)))
    val width = 35
    println(f"$huge%${width}d|")
