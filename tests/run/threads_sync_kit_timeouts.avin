// expect: exit 0
// The timed waits of the synchronization kit park on the runtime's timers and run out no sooner than
// asked: a wait group's `waitFor` and a semaphore's `acquireFor`, in milliseconds and as a `Duration`,
// a part of a millisecond waited for as a whole one, and a time that is not positive only asking.
// Of a hundred timed waiters on a semaphore given fifty permits, exactly fifty take one and the rest
// run out.
import avin.threads.{Atomic, Semaphore, WaitGroup, scope}
import avin.time

// Whether `f` answered `false` no sooner than `atLeastMicros` after it began.
ranOut(atLeastMicros: long, f: () -> bool) -> bool
  val began = time.monotonic().micros
  val answered = f()
  !answered && time.monotonic().micros - began >= atLeastMicros

main()
  val busy = WaitGroup()
  busy.add(1)
  val empty = Semaphore(0, capacity = 1)
  println(
    s"group ${ranOut(30000, () -> busy.waitFor(30))} ${ranOut(30000, () -> busy.waitFor(time.millis(30)))} ${ranOut(1000, () -> busy.waitFor(time.micros(1)))}"
  )
  println(
    s"semaphore ${ranOut(30000, () -> empty.acquireFor(30))} ${ranOut(30000, () -> empty.acquireFor(time.millis(30)))} ${ranOut(1000, () -> empty.acquireFor(time.micros(1)))}"
  )
  println(
    s"not positive ${busy.waitFor(0)} ${busy.waitFor(-5)} ${empty.acquireFor(0)} ${empty.acquireFor(time.micros(-1))}"
  )
  busy.done()
  println(s"zero now ${busy.waitFor(0)} ${busy.waitFor(time.hours(1))}")

  val half = Semaphore(0, capacity = 100)
  val took = Atomic(0)
  val missed = Atomic(0)
  scope(s ->
    for _ in 0 ..< 100
      s.spawn(() ->
        if half.acquireFor(time.millis(500)) then took.add(1) else missed.add(1))
    for _ in 0 ..< 50 do half.release())
  println(s"took ${took.load()} missed ${missed.load()} left ${half.availablePermits()}")
