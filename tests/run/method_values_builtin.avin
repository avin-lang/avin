// A method an impl adds to a built-in type, named without a call, is a function value bound to the
// value it is named on. The built-in types belong to the core library's module, `avin`, so this file
// is part of that module.
module avin

impl string
    shout() -> string = self + "!"
    // A bare method name inside the impl is bound to `self`.
    shouter() -> () -> string = shout

impl int
    plus(n: int) -> int = self + n
    private half() -> int = self / 2
    halver() -> () -> int = half

main() -> int
    val loud = "hey".shout
    print(loud())
    print("ho".shouter()())
    val add = 40.plus
    print(s"${add(2)} ${10.halver()()}")
    0
