// expect: exit 42
// A literal takes its width from the expected type, at any width. The exit status is the low byte
// of the entry function's result: 2^32 + 42 truncates to 42.
narrow(x: i8) -> i8 = x

bit(x: i1) -> i1 = x

wide(x: i128) -> i128 = x

odd(x: i33) -> i33 = x

big() -> i64 = 4294967338

main() -> i64
  narrow(-128)
  narrow(127)
  bit(-1)
  bit(0)
  wide(-9223372036854775808)
  wide(18446744073709551615)
  odd(-4294967296)
  big()
