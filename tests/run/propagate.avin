// expect: exit 0
// `?` yields the value inside an `Ok` or a `Some`, and on an `Err` or a `None` returns it from the
// enclosing function: a chain of them in a small parser, an `Option` chain, `?` inside a lambda,
// which returns from the lambda, in a generic function, on nested types, and with an error type the
// function's error type is a superclass of, or `Any`.

digit(c: char) -> Result[int, string] =
    if c >= '0' && c <= '9' then Ok(int(c) - int('0')) else Err(s"`$c` is not a digit")

sign(c: char) -> Result[int, string] = c match
    '+' -> Ok(1)
    '-' -> Ok(-1)
    _ -> Err(s"`$c` is not a sign")

// A signed two-digit number: each step fails the whole parse.
number(s: char, a: char, b: char) -> Result[int, string]
    val k = sign(s)?
    val tens = digit(a)?
    Ok(k * (tens * 10 + digit(b)?))

sum(x: (char, char, char), y: (char, char, char)) -> Result[int, string] =
    Ok(number(x.0, x.1, x.2)? + number(y.0, y.1, y.2)?)

show(r: Result[int, string]) -> string = r match
    Ok(v) -> s"ok $v"
    Err(e) -> s"err $e"

half(n: int) -> Option[int] = if n % 2 == 0 then Some(n / 2) else None

quarter(n: int) -> Option[int]
    val h = half(n)?
    half(h)

both(a: Option[int], b: Option[int]) -> Option[(int, int)] = Some((a?, b?))

// `?` as a statement: only its early return matters.
checked(n: int) -> Option[string]
    half(n)?
    Some("even")

eighths(xs: (int, int)) -> int
    val f: (int) -> Option[int] = n -> Some(quarter(n)? / 2)
    f(xs.0).getOrElse(-1) + f(xs.1).getOrElse(-100)

twice[T, E](r: Result[T, E]) -> Result[(T, T), E]
    val v = r?
    Ok((v, v))

nested(o: Option[Result[int, string]]) -> Option[Result[int, string]]
    val inner = o?
    Some(inner.map(x -> x * 2))

open class Problem(val text: string)
class Missing(text: string) : Problem(text)

open class Animal(val name: string)
class Dog(name: string) : Animal(name)

fetch(n: int) -> Result[Dog, Missing] = if n > 0 then Ok(Dog("rex")) else Err(Missing("no dog"))

general(n: int) -> Result[Animal, Problem]
    val d = fetch(n)?
    Ok(d)

count(n: int) -> Result[int, int] = if n < 5 then Ok(n) else Err(n)

anything(n: int) -> Result[string, Any]
    val d = fetch(n)?
    val k = count(n)?
    Ok(s"${d.name} $k")

explain(r: Result[string, Any]) -> string = r match
    Ok(v) -> v
    Err(m: Missing) -> s"missing ${m.text}"
    Err(k: int) -> s"count $k"
    Err(_) -> "other"

main()
    print(show(number('+', '4', '2')))
    print(show(number('-', '0', '7')))
    print(show(number('*', '4', '2')))
    print(show(number('+', 'x', '2')))
    print(show(number('+', '4', 'y')))
    print(show(sum(('+', '1', '0'), ('-', '0', '3'))))
    print(show(sum(('+', '1', '0'), ('-', 'z', '3'))))
    print(s"${quarter(8).getOrElse(-1)} ${quarter(6).getOrElse(-1)} ${quarter(3).getOrElse(-1)}")
    print(s"${both(Some(1), Some(2)).isSome()} ${both(Some(1), None).isNone()} ${both(None, Some(2)).isNone()}")
    print(s"${checked(4).getOrElse("odd")} ${checked(5).getOrElse("odd")}")
    print(s"${eighths((16, 6))}")
    val text: Result[string, string] = Ok("ab")
    print(twice(text).map(p -> p.0 + p.1).getOrElse(""))
    val failed: Result[string, string] = Err("no text")
    print(twice(failed).err().getOrElse(""))
    print(s"${nested(Some(Ok(4))).getOrElse(Err("x")).getOrElse(0)} ${nested(None).isNone()}")
    print(show(nested(Some(Err("inner"))).getOrElse(Ok(0))))
    print(general(1).map(a -> a.name).getOrElse("?"))
    print(general(0).err().map(p -> p.text).getOrElse("?"))
    print(explain(anything(3)))
    print(explain(anything(0)))
    print(explain(anything(7)))
