// A function whose result is `Nothing` is a function of every result type: a named function, a
// lambda, a method value, a generic function and a function yielding such a function convert where a
// function of another result is expected, in a declared type, an argument, a result, a field, the
// branches of an `if` and a `match`, a collection literal and an inferred type argument. The value is
// evaluated once, where it is written, and the parameters still vary as a function's do.

refuse(x: int) -> Nothing = fail(s"refused $x")

never[T](x: T) -> Nothing = fail("never")

maker() -> () -> Nothing = () -> fail("made")

pick[A, R](first: bool, f: (A) -> R, g: (A) -> R) -> (A) -> R = if first then f else g

applyAt(f: (int) -> Option[int], x: int) -> Option[int] = f(x)

asResult() -> (int) -> Option[int] = refuse

open class Animal(val name: string)

class Dog(name: string): Animal(name)

describeAnimal(a: Animal) -> Nothing = fail(a.name)

class Guard(val limit: int)
  check(x: int) -> Nothing = fail(s"over $limit")

data Handler(name: string, run: (int) -> Option[int])

made(label: string) -> (int) -> Nothing
  println(s"made $label")
  refuse

main()
  val some = (x: int) -> Some(x)

  // Declared types, of every kind of result.
  val toOption: (int) -> Option[int] = refuse
  val toInt: (int) -> int = refuse
  val toLong: (int) -> long = refuse
  val toReal: (int) -> real = refuse
  val toBool: (int) -> bool = refuse
  val toString: (int) -> string = refuse
  val toChar: (int) -> char = refuse
  val toTuple: (int) -> (int, string) = refuse
  val toUnit: (int) -> unit = refuse
  val toAny: (int) -> Any = refuse
  val toVector: (int) -> Vector[string] = refuse
  println("declared")

  // A lambda whose body never finishes, held first at its own type.
  val failing = (x: int) -> fail(s"lambda $x")
  val fromLambda: (int) -> Option[int] = failing
  // A method value and a generic function.
  val guard = Guard(3)
  val fromMethod: (int) -> Option[int] = guard.check
  val fromGeneric: (int) -> int = never
  println("lambda, method, generic")

  // A named function is a `@sendable` one of a wider result, and so is a `@sendable` value.
  val sendableNamed: @sendable (int) -> Option[int] = refuse
  val sendableHeld: @sendable (int) -> Nothing = refuse
  val sendableWider: @sendable (int) -> Option[int] = sendableHeld
  val sendableToPlain: (int) -> string = sendableHeld
  println("sendable")

  // Arguments and results, called only where they would not run the failing function.
  println(applyAt(some, 1))
  val chosen = pick(false, refuse, some)
  val read: Option[int] = chosen(2)
  println(read)
  println(pick(true, some, refuse)(3))
  val back = asResult()
  println("result")

  // The branches of an `if` and of a `match`, and a collection literal, agree on the function type
  // of the branch that yields a value.
  val flag = false
  val either = if flag then refuse else some
  println(either(4))
  val other = if !flag then some else refuse
  println(other(5))
  val arm = 2 match
    1 -> refuse
    2 -> some
    _ -> failing
  println(arm(6))
  val listed = [refuse, some, failing]
  val second = listed(1)
  println(second(7))
  println(listed.length)

  // A field of a data value.
  val handler = Handler("refusing", refuse)
  println(handler.name)

  // A nested function type: the function a call of `maker` makes yields `Nothing` too.
  val nested: () -> () -> int = maker
  val inner = nested()
  println("nested")

  // Parameters stay contravariant: a function of an `Animal` is one of a `Dog`.
  val ofDog: (Dog) -> string = describeAnimal
  println("contravariant")

  // The value converted is evaluated once, where it is written.
  val once: (int) -> Option[int] = made("once")
  println(applyAt(some, 8))

  // An inferred type argument the converted function alone names is `Nothing`; nothing is called.
  val empty: Vector[int] = []
  println(empty.map(refuse).length)
