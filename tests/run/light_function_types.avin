// expect: exit 0
// A function type with one parameter is written without parentheses, and `->` groups to the right.

twice(f: int -> int, x: int) -> int = f(f(x))

adder(n: int) -> int -> int = x -> x + n

compose[A, B, C](f: A -> B, g: B -> C) -> A -> C = x -> g(f(x))

applyAll(fs: List[int -> int], x: int) -> int
    var acc = x
    for f in fs
        acc = f(acc)
    acc

pick(flag: bool) -> (int -> int, string)
    if flag then (x -> x + 1, "inc") else (x -> x - 1, "dec")

higher(g: (int -> int) -> int) -> int = g(x -> x * 10)

lazy(x: -> int -> int) -> int = x(4)

class Holder(val f: int -> int)
    run(x: int) -> int = f(x)

main() -> int
    println(s"${twice(x -> x + 3, 1)}")
    println(s"${adder(5)(10)}")
    val add: int -> int -> int = a -> b -> a + b
    println(s"${add(3)(4)}")
    val plain: (int) -> int = adder(1)
    val light: int -> int = plain
    println(s"${light(1)}")
    val f = compose(adder(1), (x: int) -> s"<$x>")
    println(f(1))
    println(s"${applyAll([adder(1), adder(2), x -> x * 2], 1)}")
    val (g, name) = pick(true)
    println(s"$name ${g(1)}")
    println(s"${higher(h -> h(2))}")
    println(s"${lazy(x -> x + 1)}")
    println(s"${Holder(adder(7)).run(1)}")
    0
