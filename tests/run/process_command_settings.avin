// env: AVIN_COMMAND_OUTER=from the program
// A command's directory, variables and time limit: set on one program or on a command made of
// several, where each part runs with them unless it sets its own. A variable it sets leaves the
// program's own environment as it was. A command stopped for its time limit is `TimedOut`, and a
// part of a sequence not yet started then is not started.
import avin.process.{Command, env}
import avin.time.{millis, seconds}
import avin.fs

main()
  val dir = fs.createTempDir("avin-command-settings") match
    Ok(d) -> d
    Err(e) -> fail(s"no temporary directory: $e")
  _ = fs.createDir(dir + "/inner")
  _ = fs.writeText(dir + "/inner/marker.txt", "")
  // The directory.
  println(Command("/bin/ls").inDir(dir + "/inner").output())
  println(Command("/bin/ls", "inner").inDir(dir).output())
  println((Command("/bin/ls") andThen Command("/bin/ls").inDir(dir)).inDir(dir + "/inner").output())
  println(Command("/bin/ls").inDir(dir + "/no-such-directory").run())
  // Variables: added to the program's own, which the child also sees.
  val show = Command("/bin/sh", "-c", "echo \"$AVIN_COMMAND_OUTER|$AVIN_COMMAND_A|$AVIN_COMMAND_B\"")
  println(show.output())
  println(show.withEnv("AVIN_COMMAND_A", "a").withEnv("AVIN_COMMAND_B", "b").output())
  println(show.withEnv("AVIN_COMMAND_A", "first").withEnv("AVIN_COMMAND_A", "second").output())
  println(show.withEnv("AVIN_COMMAND_OUTER", "replaced").output())
  println(
    (
      show.withEnv("AVIN_COMMAND_A", "own") | Command("/bin/cat")
    ).withEnv("AVIN_COMMAND_A", "pipeline").withEnv("AVIN_COMMAND_B", "shared").output()
  )
  println(env("AVIN_COMMAND_A"))
  println(env("AVIN_COMMAND_OUTER"))
  // A time limit: a program that outstays it is stopped.
  println(Command("/bin/sleep", "5").withTimeout(millis(200)).run())
  println(Command("/bin/sleep", "5").withTimeout(millis(200)).output())
  println(Command("/bin/echo", "in time").withTimeout(seconds(30)).output())
  // On a sequence it bounds the whole: the second part is never started.
  println(
    (Command("/bin/sleep", "5") followedBy Command("/bin/echo", "not started")).withTimeout(millis(200)).output()
  )
  // On a pipeline it bounds every stage; the status is the last stage's.
  println((Command("/bin/echo", "x") | Command("/bin/sleep", "5")).withTimeout(millis(200)).run())
  // The earlier of two limits applies.
  println(
    Command("/bin/sleep", "5").withTimeout(millis(200)).andThen(
      Command("/bin/echo", "no")
    ).withTimeout(seconds(30)).run()
  )
  _ = fs.removeDirAll(dir)
