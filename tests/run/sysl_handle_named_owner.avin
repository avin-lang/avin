// expect: trap
// A handle whose `@sysl` gives it a name with `named` traps under that name where it belongs to
// another thread.
import avin.threads.{Channel, spawn}

@sysl("sysl.checksum.Crc32", named: "Checksum")
class Crc32
  finish() -> long

@sysl("sysl.checksum.new_crc32")
newCrc32() -> Crc32

main()
  val c = newCrc32()
  val go = Channel[int]()
  val t = spawn(() ->
    go.receive()
    c.finish())
  println("handed over")
  c.finish()
  go.send(1)
  println(t.join())
