// Local bindings, assignment and updates.

main() -> int
  val base = 10
  var n = base
  n += 5
  n -= 3
  n *= 2
  if n != 24 then return 1
  n /= 5
  n %= 3
  if n != 1 then return 2
  n <<= 4
  n |= 1
  n &= 17
  n ^= 3
  if n != 18 then return 3
  // `:=` yields the stored value.
  var m = 0
  if (m := 7) != 7 then return 4
  m += 1
  if (m +:= 2) != 10 then return 5
  if m != 10 then return 6
  // Prefix updates yield the new value, postfix the old.
  var i = 5
  if i++ != 5 then return 7
  if i != 6 then return 8
  if ++i != 7 then return 9
  if i-- != 7 then return 10
  if --i != 5 then return 11
  // An inner block's bindings shadow and then go out of scope.
  val shadowed = 1
  val inner =
    val shadowed = 2
    shadowed * 10
  if inner != 20 || shadowed != 1 then return 12
  0
