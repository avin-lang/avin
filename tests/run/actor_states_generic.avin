// expect: exit 0
// A generic actor with states: its `State` type takes the actor's type parameters, so a state holds
// values of them, at two instances, with the type arguments written and inferred; a state whose
// data is a collection of the type parameter; an actor whose message type is its type parameter
// itself, its states guarded on the message; a state holding a bounded type parameter, compared
// through its bound; and a generic actor with states spawning another at its own type argument.
import avin.actors.{ActorRef, Behaviour, spawn}
import avin.threads.Promise
import avin.time

data Slot[T: Sendable]
  Fill(value: T)
  Take(reply: Promise[Option[T]])
  Peek(reply: Promise[string])

actor Cell[T: Sendable] receives Slot[T]
  state Empty
    Fill(v) -> Full(v)
    Take(r) ->
      r.complete(None)
      stay
  state Full(value: T)
    Fill(v) -> Full(v)
    Take(r) ->
      r.complete(Some(value))
      Empty
  receive
    Peek(r) ->
      r.complete(if state() is Full(_) then "full" else "empty")
      stay

actor Batcher[T: Sendable](size: int, out: Promise[Vector[Vector[T]]]) receives Option[T]
  var done = Vector[Vector[T]]()

  state Unbatched
    Some(v) -> collect(Vector(v))
    None -> finish(Vector())

  state Collecting(items: Vector[T])
    Some(v) -> collect(items :+ v)
    None -> finish(items)

  state Finished
    _ -> stay

  // Helpers yielding the next state, named by the actor's `State` type at its type parameter.
  collect(items: Vector[T]) -> Batcher.State[T]
    if items.length < size then return Collecting(items)
    done = done :+ items
    Unbatched

  finish(items: Vector[T]) -> Batcher.State[T]
    if !items.isEmpty then done = done :+ items
    out.complete(done)
    Finished

actor Highest[T: Ord & Sendable](reply: Promise[T]) receives Option[T]
  state NoneYet
    Some(v) -> Best(v)
    None -> stay
  state Best(top: T)
    Some(v) if v > top -> Best(v)
    Some(_) -> stay
    None ->
      reply.complete(top)
      stay

actor Parent[T: Sendable](probe: Promise[Option[T]]) receives Option[T]
  state Waiting
    Some(v) ->
      val child = spawn(Cell[T]())
      child.tell(Fill(v))
      child.tell(Take(probe))
      Spawned(child)
    None -> stay
  state Spawned(child: ActorRef[Slot[T]])
    _ -> stay

main()
  val wait = time.seconds(60)
  val ints = spawn(Cell[int]())
  val p0 = Promise[string]()
  ints.tell(Peek(p0))
  println(p0.future.await())
  ints.tell(Fill(7))
  ints.tell(Fill(8))
  val p1 = Promise[string]()
  ints.tell(Peek(p1))
  println(p1.future.await())
  val t1 = Promise[Option[int]]()
  ints.tell(Take(t1))
  println(t1.future.await())
  val t2 = Promise[Option[int]]()
  ints.tell(Take(t2))
  println(t2.future.await())
  val made: Behaviour[Slot[string]] = Cell()
  val strings = spawn(made)
  strings.tell(Fill("héllo, 世界"))
  val t3 = Promise[Option[string]]()
  strings.tell(Take(t3))
  println(t3.future.await())
  val batches = Promise[Vector[Vector[string]]]()
  val b = spawn(Batcher(2, batches))
  for w in ["a", "b", "c", "d", "e"] do b.tell(Some(w))
  b.tell(None)
  b.tell(Some("late"))
  println(batches.future.await())
  val top = Promise[long]()
  val h = spawn(Highest(top))
  val ns: Vector[long] = [3, -9223372036854775808, 9223372036854775807, 5]
  for n in ns do h.tell(Some(n))
  h.tell(None)
  println(top.future.await())
  val probe = Promise[Option[string]]()
  val parent = spawn(Parent(probe))
  parent.tell(Some("child"))
  println(probe.future.await())
