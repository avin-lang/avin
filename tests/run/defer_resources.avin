// The library's resources are each an `io.Close`, so `defer r.close()` gives one back on every way
// out of a block: a file, a temporary directory, a started command, a TCP listener and connection.
// Closing twice answers `Ok` and does nothing more, so the success path may close first to see the
// `Err`. A generic function takes any of them as `[R: io.Close]`, and a program's own class may be one.
// expect: exit 0
import avin.fs
import avin.fs.{File, TempDir}
import avin.io
import avin.io.{Close, IoError}
import avin.net.{TcpListener, TcpStream}
import avin.process.Command

// Writes `lines` to a new file, giving up at the first empty one; the file is closed on every path.
class Opened()
  var files: Vector[File] = []

writeLines(name: string, lines: Vector[string], opened: Opened) -> Result[int, IoError]
  val f = fs.create(name)?
  opened.files = opened.files :+ f
  defer f.close()
  var n = 0
  for line in lines
    if line.isEmpty then return Err(IoError(io.Other("an empty line"), "write", name))
    f.writeText(line + "\n")?
    n += 1
  // Closing here reports a failed flush; the deferred close then does nothing.
  f.close()?
  Ok(n)

// The first line of a file, with the file closed whether or not there is one.
firstLine(name: string) -> Result[Option[string], IoError]
  val f = fs.open(name)?
  defer f.close()
  val line = f.readLine()?
  if line is None then return Ok(None)
  Ok(line)

// Any resource, closed when the body is done with it, whatever way the body leaves.
using[R: Close, T](resource: R, body: (R) -> T) -> T
  defer resource.close()
  body(resource)

// A program's own resource.
class Lease(val name: string): Close
  var closings = 0
  override close() -> Result[unit, IoError]
    closings += 1
    if closings == 1 then println(s"lease $name: returned")
    Ok(())

leaseAll(names: Vector[string], stopAt: string) -> Vector[Lease]
  var held: Vector[Lease] = []
  for n in names
    val l = Lease(n)
    held = held :+ l
    defer l.close()
    if n == stopAt then break
    println(s"lease $n: used")
  held

main()
  val dir = fs.tempDir("defer-resources").ok.get
  println(fs.isDir(dir.path))
  val base = dir.path

  val opened = Opened()
  println(writeLines(base + "/a.txt", ["one", "two"], opened))
  println(writeLines(base + "/b.txt", ["x", "", "y"], opened).mapErr(e -> e.kind))
  println(writeLines(base + "/no/such/dir/c.txt", ["z"], opened).mapErr(e -> e.kind))
  println(opened.files.map(f -> f.isClosed()))
  println(fs.readText(base + "/b.txt"))
  println(firstLine(base + "/a.txt"))
  println(firstLine(base + "/missing.txt").isErr)
  println(fs.writeText(base + "/empty.txt", ""))
  println(firstLine(base + "/empty.txt"))

  // A temporary directory is removed when its block is left, by `?` too.
  var kept = ""
  val made: () -> Result[unit, IoError] = () ->
    val t = fs.tempDir("defer-inner")?
    defer t.close()
    kept = t.path
    fs.writeText(t.path + "/inside.txt", "ü")?
    fs.readText(t.path + "/nothing")?
    Ok(())
  println(made().isErr)
  println(fs.exists(kept))
  val again = fs.tempDir("defer-twice").ok.get
  println(again.close())
  println(again.close())
  println(again.isClosed)

  // A started command is stopped and waited for.
  val sleeper = Command("/bin/sleep", "30").start().ok.get
  println(using(sleeper, c -> c.isAlive()))
  println(sleeper.isAlive())
  println(sleeper.close())
  val quick = Command("/bin/sh", "-c", "exit 3").start().ok.get
  // One that has ended keeps its status: closing it only waits for it again.
  println(using(quick, c -> c.waitFor()))
  println(quick.waitFor())
  println(quick.close())

  // A listener and a connection: generic over `Close` both.
  val listener = TcpListener.bind("127.0.0.1", 0).ok.get
  val port = listener.port()
  val client = TcpStream.connect("127.0.0.1", port).ok.get
  val served = listener.accept().ok.get
  println(using(client, s -> s.writeText("hi\n")))
  println(served.readLine())
  println(served.readLine())
  println(client.writeText("again").mapErr(e -> e.kind))
  println(using(served, s -> 1))
  println(using(listener, l -> l.port() == port))
  println(listener.accept().isErr)
  println(listener.close())

  // A resource taken in each turn of a loop is returned at the end of that turn, and at `break`.
  val leases = leaseAll(["a", "b", "c", "d"], "c")
  println(leases.map(l -> l.closings))
  println(using(Lease("solo"), l -> l.name + "!"))

  println(dir.close())
  println(fs.exists(base))
  println(dir.close())
