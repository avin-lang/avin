// Conversions between `real` and an integer wider than 128 bits, on values only known at run time:
// to `real` rounds to nearest with ties to even, and back truncates toward zero, saturates at the
// bounds and maps NaN to zero, exactly as for a narrow integer.

toReal(x: i257) -> real = real(x)
fromReal(r: real) -> i257 = i257(r)

// 2^k, exactly.
two(k: int) -> real
  var r = 1.0
  for i in 0 ..< k do r = r * 2.0
  r

main(args: Vector[string]) -> int
  // Zero from the arguments, so that nothing below is folded at compile time.
  val z = args.length
  val one = i257(z) + 1
  val zero = real(z)

  // Small values, both signs, and zero, which is positive.
  if toReal(one * 12345) != 12345.0 then return 1
  if toReal(one * -12345) != -12345.0 then return 2
  if toReal(one - 1) != 0.0 then return 3
  if 1.0 / toReal(one - 1) <= 0.0 then return 4
  if toReal(one) != 1.0 || toReal(-one) != -1.0 then return 5

  // Around 2^53, where a double runs out of digits: ties go to the even neighbour.
  val p53 = one << 53
  if toReal(p53 + 1) != two(53) then return 6
  if toReal(p53 + 3) != two(53) + 4.0 then return 7
  if toReal(-(p53 + 3)) != -(two(53) + 4.0) then return 8
  if toReal(p53 - 1) != two(53) - 1.0 then return 9

  // The same digits far above bit 64, where the rounding decision rests on bits below the top 64.
  if toReal((p53 + 1) << 150) != two(203) then return 10
  if toReal(((p53 + 1) << 150) + 1) != (two(53) + 2.0) * two(150) then return 11
  if toReal(((p53 + 1) << 150) - 1) != two(203) then return 12
  if toReal((p53 + 3) << 150) != (two(53) + 4.0) * two(150) then return 13
  if toReal(-(((p53 + 1) << 150) + 1)) != -(two(53) + 2.0) * two(150) then return 14

  // Exact powers of two, and the top of the width.
  if toReal(one << 200) != two(200) then return 15
  if toReal(one << 255) != two(255) then return 16
  val minimum = one << 256
  val maximum = -(minimum + 1)
  if toReal(minimum) != -two(256) then return 17
  if toReal(maximum) != two(256) then return 18
  if toReal(minimum + 1) != -two(256) then return 19

  // Agreement with the native conversion wherever a value fits 128 bits.
  var x = one
  for i in 0 ..< 120
    if toReal(x) != real(i128(x)) then return 20
    if toReal(-x) != real(i128(-x)) then return 21
    x = x * 3 / 2 + 7

  // Back to an integer: toward zero, both signs, below one, and negative zero.
  if fromReal(zero + 2.9) != 2 then return 30
  if fromReal(zero - 2.9) != -2 then return 31
  if fromReal(zero + 0.5) != 0 || fromReal(zero - 0.5) != 0 then return 32
  if fromReal(-zero) != 0 then return 33
  if fromReal(zero + 1.0) != 1 then return 34
  if fromReal(zero + 4503599627370496.5) != p53 / 2 then return 35
  if fromReal(zero + 4503599627370495.5) != p53 / 2 - 1 then return 36
  if fromReal(zero + two(53) - 1.0) != p53 - 1 then return 37

  // Large magnitudes are exact.
  if fromReal(zero + two(200)) != one << 200 then return 38
  if fromReal(zero - two(200)) != -(one << 200) then return 39
  if fromReal((two(53) - 1.0) * two(203)) != ((p53 - 1) << 203) then return 40
  if fromReal(-two(256)) != minimum then return 41

  // Saturation at the bounds, infinities, and NaN.
  if fromReal(zero + two(256)) != maximum then return 42
  if fromReal(zero + 1.0e300) != maximum then return 43
  if fromReal(zero - 1.0e300) != minimum then return 44
  if fromReal(1.0 / zero) != maximum then return 45
  if fromReal(-1.0 / zero) != minimum then return 46
  if fromReal(zero / zero) != 0 then return 47
  if fromReal(-(zero / zero)) != 0 then return 48

  // A round trip keeps every value a double holds.
  var y = one
  for i in 0 ..< 250
    if fromReal(toReal(y)) != y || fromReal(toReal(-y)) != -y then return 49
    y = if y < p53 / 2 then y * 2 + 1 else y * 2
  0
