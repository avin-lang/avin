// expect: exit 0
// Tail calls between methods and between local functions replace the caller's frame as calls between
// top-level functions do: two methods of a class calling each other on `self` and on another object,
// and two local functions calling each other, one of them reading a value of the enclosing function
// it captures. Each runs a million or more calls deep.

class Walker(val step: int)
    ping(n: int, acc: long) -> long = if n <= 0 then acc else pong(n - step, acc + 1)
    pong(n: int, acc: long) -> long = if n <= 0 then acc else Walker(step).ping(n - step, acc + 2)

class Counter
    var hits = 0
    up(n: int) -> int =
        hits += 1
        if n == 0 then hits else down(n - 1)
    down(n: int) -> int =
        hits += 1
        if n == 0 then hits else up(n - 1)

steps(n: int, stride: int) -> long
    there(k: int, acc: long) -> long = if k <= 0 then acc else back(k - stride, acc + 1)
    back(k: int, acc: long) -> long = if k <= 0 then acc else there(k - stride, acc + 1)
    there(n, 0)

// The local functions share a `var` of the enclosing function, which each receives the address of
// and passes on: the variable outlives both of their frames.
visits(n: int) -> int
    var count = 0
    odd(k: int) -> int =
        count += 1
        if k == 0 then count else even(k - 1)
    even(k: int) -> int =
        count += 1
        if k == 0 then count else odd(k - 1)
    val total = even(n)
    total + count

main() -> int
    println(Walker(1).ping(3000000, 0))
    println(Counter().up(2000000))
    println(steps(5000000, 1))
    println(steps(10, 3))
    println(visits(3000000))
    0
