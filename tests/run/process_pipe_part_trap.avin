// expect: trap
// A pipe is the started command's to hand over: a part of a pipeline asking for one traps when the
// command starts, with nothing started.
import avin.process.Command

main()
  println((Command("echo", "fine") | Command("cat")).pipeOutput().start().isOk)
  println((Command("echo", "x").pipeOutput() | Command("cat")).start())
  println("not reached")
