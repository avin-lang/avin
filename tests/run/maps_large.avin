// expect: exit 0
// env: AVIN_GC_STRESS=0
// Sequential integer keys, whose hashes are themselves, spread well enough for both maps: 100,000
// keys inserted, looked up and removed, with the immutable map's trie and the mutable map's table
// both still answering correctly at every stage.

import avin.collections.mutable.{Map as MutableMap}

main()
  val n = 100000
  var persistent = Map[int, int]()
  val table = MutableMap[int, int]()
  for i in 0 ..< n
    persistent = persistent.updated(i, i)
    table(i) = i
  var sum: long = 0
  for i in 0 ..< n do sum += long(persistent(i)) + long(table(i))
  println(s"${persistent.size} ${table.size} $sum")
  for i in 0 ..< n
    if i % 3 != 0
      persistent = persistent.removed(i)
      table.remove(i)
  var present = 0
  for i in 0 ..< n
    if persistent.contains(i) then present += 1
    if table.contains(i) then present += 1
  println(s"${persistent.size} ${table.size} $present ${table.toMap == persistent}")
