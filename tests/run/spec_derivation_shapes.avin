// expect: exit 0
// Shapes beyond the plain cases: a class's repeated parameter is a field of type `Vector[T]`, walked
// and built through its vector; fields of nested generic types; a type with no fields; annotation
// arguments that are calls, not literals; `variant` asked of a builder even for one variant.

trait Describe
  describe() -> string

impl Describe for int
  describe() -> string = s"$self"

impl Describe for string
  describe() -> string = s"\"$self\""

impl[A: Describe] Describe for Vector[A]
  describe() -> string = "<" + map(a -> a.describe()).mkString(" ") + ">"

impl[A: Describe] Describe for Option[A]
  describe() -> string = self match
    Some(a) -> "Some " + a.describe()
    None -> "None"

derive Describe for T
  describe() -> string = T.walk(self, Plain("")).text

data Plain(text: string)

impl ShapeVisitor for Plain
  variant(v: VariantShape) -> Plain = Plain(v.name)

impl Plain
  field[F: Describe](f: FieldShape, value: F) -> Plain =
    val label = f.annotation[Tag]().map(t -> t.text).getOrElse(f.name)
    Plain(s"$text $label=${value.describe()}")

data Tag(text: string)
impl Annotation for Tag

prefix() -> string = "computed"

class Bag(val name: string, items: int*) derives Describe, FromPairs

data Nested(inner: Option[Option[int]], list: Vector[Vector[string]]) derives Describe

data Odd(@Tag(prefix() + "-" + "x") n: int, @Tag("lo" + "ng") m: int) derives Describe

data Lone() derives Describe

// A builder that counts how often `variant` is asked.
trait FromPairs
  static fromPairs(pairs: Vector[(string, string)]) -> Result[Self, string]

derive FromPairs for T
  static fromPairs(pairs: Vector[(string, string)]) -> Result[T, string] =
    val reader = Reader(pairs)
    val result = T.build(reader)
    println(s"variant asked ${reader.asked} time(s)")
    result

class Reader(pairs: Vector[(string, string)])
  var at = 0
  var asked = 0
  var current = ""

impl ShapeBuilder[string] for Reader
  variant(t: TypeShape) -> Result[int, string] =
    asked += 1
    Ok(0)
  next(v: VariantShape) -> Result[Option[int], string] =
    if at >= pairs.length then return Ok(None)
    val (key, text) = pairs(at)
    at += 1
    current = text
    Ok(Some(v.fields.find(f -> f.name == key).map(f -> f.index).getOrElse(0)))
  duplicate(f: FieldShape) -> string = s"duplicate ${f.name}"

impl Reader
  field[F: Parse](f: FieldShape) -> Result[F, string] = Ok(F.parse(current))
  missing[F: Parse](f: FieldShape) -> Result[F, string] = Err(s"missing ${f.name}")

trait Parse
  static parse(text: string) -> Self

impl Parse for string
  static parse(text: string) -> string = text

impl Parse for int
  static parse(text: string) -> int = text.toInt()

impl[A: Parse] Parse for Vector[A]
  static parse(text: string) -> Vector[A] = text.split(",").map(s -> A.parse(s))

data One(x: string) derives FromPairs

main()
  println(Bag("b", 1, 2, 3).describe())
  println(Bag("e").describe())
  println(Nested(Some(None), [[], ["a"]]).describe())
  println(Nested(None, []).describe())
  println(Odd(1, 2).describe())
  val lone: Lone = Lone
  println(lone.describe())
  println(One.fromPairs([("x", "hi")]).map(o -> o.x))
  Bag.fromPairs([("items", "4,5"), ("name", "n")]) match
    Ok(b) -> println(b.describe())
    Err(e) -> println(e)
