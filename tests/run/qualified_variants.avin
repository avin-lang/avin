// expect: exit 0
// A variant is reached by its bare name or through its type, `Type.Variant`: both name the same
// constructor, in expressions and in patterns, with fields or without, and the two forms mix freely.

data Color
    Red
    Green
    Blue

data Shape
    Circle(radius: real)
    Rect(width: real, height: real)
    Empty

data Tree
    Leaf(value: int)
    Node(left: Tree, right: Tree)

name(c: Color) -> string = c match
    Color.Red -> "red"
    Green -> "green"
    Color.Blue -> "blue"

area(s: Shape) -> real = s match
    Shape.Circle(r) -> 3.0 * r * r
    Shape.Rect(w, h) -> w * h
    Shape.Empty -> 0.0

sum(t: Tree) -> int = t match
    Tree.Leaf(v) -> v
    Tree.Node(Tree.Leaf(a), Tree.Leaf(b)) -> a + b
    Node(l, r) -> sum(l) + sum(r)

classify(s: Shape) -> string = s match
    Shape.Circle(r) if r > 10.0 -> "big circle"
    Shape.Circle(_) | Shape.Empty -> "round or nothing"
    whole @ Shape.Rect(w, _) -> s"rect $w of ${area(whole)}"

warm(c: Color) -> bool = c match
    Color.Red | Color.Green -> true
    Blue -> false

main()
    // Expressions: the qualified and the bare form make equal values.
    println(name(Color.Red))
    println(name(Green))
    println(name(Color.Blue))
    println(Color.Red == Red)
    println(Color.Green != Color.Blue)
    println(Color.Blue)
    // Variants with fields, by position and by name; a variant without fields among them.
    println(area(Shape.Circle(1.0)))
    println(area(Shape.Rect(2.0, 3.0)))
    println(area(Shape.Rect(height = 4.0, width = 0.5)))
    println(area(Shape.Empty))
    println(Shape.Circle(2.5))
    println(Shape.Circle(1.0) == Circle(1.0))
    // Nested constructions and nested patterns.
    println(sum(Tree.Node(Tree.Leaf(1), Tree.Leaf(2))))
    println(sum(Tree.Node(Tree.Node(Leaf(1), Tree.Leaf(2)), Tree.Leaf(4))))
    // Guards, alternatives and `@` bindings over qualified patterns.
    println(classify(Shape.Circle(11.0)))
    println(classify(Shape.Circle(1.0)))
    println(classify(Shape.Empty))
    println(classify(Shape.Rect(2.0, 5.0)))
    println(warm(Color.Red))
    println(warm(Color.Blue))
    // `is` tests.
    println(Shape.Circle(3.0) is Shape.Circle(_))
    println(Shape.Empty is Shape.Rect(_, _))
    val s = Shape.Rect(1.0, 2.0)
    if s is Shape.Rect(w, h) then println(w + h)
    // In a closure, capturing a variant's value and making one.
    val c = Color.Green
    val pick = (n: int) -> if n == 0 then c else Color.Red
    println(pick(0))
    println(pick(1))
    val grow = (r: real) -> Shape.Circle(r * 2.0)
    println(grow(1.5))
    // In collections, with the element type inferred from the qualified form.
    val colors = [Color.Red, Green, Color.Blue]
    println(colors.map(name))
    val shapes = [Shape.Circle(1.0), Shape.Empty, Shape.Rect(1.0, 1.0)]
    println(shapes.map(area))
    // Many allocations of qualified constructions, kept alive across collections.
    var keep: List[Shape] = Nil
    for i in 0..<2000
        keep = Shape.Circle(real(i)) :: keep
    var total = 0.0
    for k in keep
        total = total + (k match
            Shape.Circle(r) -> r
            _ -> 0.0)
    println(total)
