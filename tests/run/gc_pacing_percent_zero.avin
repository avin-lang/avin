// `AVIN_GC_PERCENT=0` paces the collector at its floor alone, so it collects once for every few MiB
// allocated whatever is live: everything kept is still whole after many collections.
// env: AVIN_GC_STRESS=0
// env: AVIN_GC_PERCENT=0

data Item(a: int, b: string, c: Vector[int])

main()
  val keep = Buffer[Item]()
  var spent = 0
  for i in 0 ..< 100000
    keep.addOne(Item(i, s"row $i", [i, i + 1]))
    val junk = Array.fill(256, byte(1))
    spent += junk.length
  var sum = long(0)
  var text = 0
  for item in keep
    sum += long(item.a) + long(item.c(0)) + long(item.c(1))
    text += item.b.byteLength
  println(s"kept=${keep.length} sum=$sum text=$text spent=$spent")
  println(keep(0))
  println(keep(99999))
