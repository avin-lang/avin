// expect: exit 0
// A call's type arguments are inferred from its arguments by subtyping, a type argument's variance
// deciding the direction: at a contravariant argument the parameter's type must be an instance of
// the argument's, so a `Box[A, int]` is given where a `Box[B, T]` is wanted, `B` being an `A`, and
// `T` is `int`. At a covariant argument the argument's type is an instance of the parameter's. The
// rule follows covariant arguments down (a list of boxes), holds a function's parameters the same
// way, decides a type argument named only at a contravariant argument as the type given there, and
// reaches methods, extensions, lambdas and data types.
open class A(val tag: string)
class B: A("b")
class C: A("c")

class Box[-I, +T](val f: (I) -> T)

class Pair[+X, +Y](val x: X, val y: Y)

open class Reader(val text: string)
class Input(text: string): Reader(text)

class Rule[-I, +T](val run: (I) -> T)

data Pred[-T]
  Pred(test: (T) -> bool)

take[T](b: Box[B, T]) -> T = b.f(B())

second[T](p: Pair[A, T]) -> T = p.y

takeAll[T](bs: List[Box[B, T]]) -> int = bs.length

applyB[T](f: (B) -> T) -> T = f(B())

parse[T](r: Rule[Input, T]) -> T = r.run(Input("in"))

both[I, T](r: Rule[I, T], input: I) -> T = r.run(input)

feed[T](b: Box[T, int], x: T) -> int = b.f(x)

holds[T](p: Pred[B], x: T) -> T = x

withBox[T](b: Box[B, T], k: (T) -> string) -> string = k(b.f(B()))

pairUp[T](b: Box[T, int], c: Box[T, int], x: T) -> int = b.f(x) + c.f(x)

class Runner(val name: string)
  run[T](b: Box[B, T]) -> T = b.f(B())

impl A
  through[T](b: Box[B, T]) -> T = b.f(B())

main()
  val x: Box[A, int] = Box(a -> 1)
  println(take(x))
  val named: Box[A, string] = Box(a -> a.tag)
  println(take(named))
  val boxes: Box[A, Vector[string]] = Box(a -> [a.tag, "v"])
  println(take(boxes).length)
  // The same type: the contravariant argument holds with no subtyping at all.
  val exact: Box[B, long] = Box(b -> 9)
  println(take(exact))
  println(second(Pair(B(), 7)))
  println(takeAll(List(x, x)))
  val g: (A) -> int = a -> 7
  println(applyB(g))
  println(applyB((a: A) -> a.tag.charCount + 40))
  val scale: long = 1000000000000
  val r: Rule[Reader, long] = Rule(rd -> long(rd.text.charCount) * scale)
  println(parse(r))
  println(both(r, Input("four")))
  // Named only at the contravariant argument and by a value of a subtype, `T` is the type given there.
  println(feed(x, B()))
  println(feed(x, C()))
  val p: Pred[A] = Pred(a -> a.tag == "b")
  println(holds(p, "kept"))
  println(withBox(x, n -> s"<$n>"))
  // The first box decides `T` as `B`; a box of any `A` is a box of `B`s too.
  val onlyB: Box[B, int] = Box(b -> 20)
  println(pairUp(onlyB, x, B()))
  println(Runner("r").run(x))
  println(C().through(named))
