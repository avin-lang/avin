// expect: trap
// Each half of a split connection belongs to one thread at a time, as the connection did: the
// reading half handed to a thread traps in the code that handed it over at its next use, while the
// writing half, kept, works on.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.threads.{Channel, spawn}

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

main()
  val l = ok(TcpListener.bind("127.0.0.1", 0))
  val c = ok(TcpStream.connect("127.0.0.1", l.port()))
  val s = ok(l.accept())
  val (r, w) = c.split()
  val go = Channel[int]()
  val t = spawn(() ->
    go.receive()
    ok(r.close()))
  ok(w.writeText("kept\n"))
  println(ok(s.readLine()).getOrElse("(end)"))
  _ = r.readable()
  println("not reached")
  go.send(1)
  t.join()
