// `wrap` converts an integer keeping the low bits, where a conversion written as the type's call
// traps on a value that does not fit.

narrow[T: Integer](n: long) -> T = T.wrap(n)

main() -> int
    println(i8.wrap(300), i8.wrap(-129), i8.wrap(127), i8.wrap(128), i8.wrap(-128))
    val big: long = 4294967298
    println(int.wrap(big), int.wrap(long.MaxValue), int.wrap(long.MinValue))
    println(i16.wrap(i257(70000)), i1.wrap(2), i1.wrap(3), i5.wrap(35))
    val b: byte = 0xc8
    println(i8.wrap(b), int.wrap(b), i8.wrap(char(65)), i16.wrap(char(40000)))
    println(long.wrap(int.MinValue), i128.wrap(long.MinValue), i8.wrap(i8.MinValue))
    val narrowed: i5 = narrow(35)
    val wide: long = 2147483648
    println(narrowed, narrow[i8](-1), narrow[int](wide))
    println(i8.wrap(1.5), int.wrap(2.9))
    0
