// `a | b` runs the two at once, `a`'s standard output `b`'s standard input, and its status is `b`'s.
// Pipelines nest, hold sequences as stages and are held by them, carry data larger than a pipe's
// buffer, and a stage that cannot be started fails the whole pipeline.
import avin.process.Command

main()
  val three = Command("/bin/echo", "gamma alpha beta") | Command("/usr/bin/tr", " ", "\n") | Command("/usr/bin/sort")
  println(three.output())
  // The status is the last stage's.
  println((Command("/usr/bin/false") | Command("/bin/cat")).run())
  println((Command("/bin/echo", "x") | Command("/usr/bin/false")).run())
  println((Command("/bin/echo", "x") | Command("/usr/bin/false")).output())
  // Grouped either way, the stages are the same.
  val left = (Command("/bin/echo", "abc") | Command("/usr/bin/rev")) | Command("/usr/bin/tr", "a-z", "A-Z")
  val right = Command("/bin/echo", "abc") | (Command("/usr/bin/rev") | Command("/usr/bin/tr", "a-z", "A-Z"))
  println(left.output())
  println(right.output())
  // Input given to the pipeline is the first stage's; a redirection of the pipeline's output is the
  // last stage's.
  println((Command("/bin/cat") | Command("/usr/bin/wc", "-l")).withInput("1\n2\n3\n").output().map(t -> t.trim()))
  // Much more than a pipe holds passes between the stages, and the first stage, whose reader stops
  // early, is ended by its broken pipe.
  println(
    (
      Command("/usr/bin/yes", "y") | Command("/usr/bin/head", "-n", "100000") | Command("/usr/bin/wc", "-l")
    ).output().map(t -> t.trim())
  )
  println(
    (
      Command("/usr/bin/head", "-c", "500000", "/dev/zero") | Command("/bin/cat") | Command("/bin/cat")
    ).output().map(t -> t.byteLength())
  )
  // A sequence as a stage: both parts write into the pipe, and its reader sees the end of its input
  // only once the second part has ended.
  println(
    (
      (Command("/bin/echo", "first") andThen Command("/bin/echo", "second")) | Command("/usr/bin/tr", "a-z", "A-Z")
    ).output()
  )
  println(
    (Command("/usr/bin/printf", "p\\nq\\n") | (Command("/bin/cat") followedBy Command("/bin/echo", "end"))).output()
  )
  // A pipeline in a sequence.
  println(
    (
      (Command("/bin/echo", "z") | Command("/usr/bin/false")) orElse Command("/bin/echo", "after a failed pipeline")
    ).output()
  )
  // A stage that cannot be started.
  println((Command("/bin/echo", "x") | Command("avin-no-such-program")).run())
  println((Command("avin-no-such-program") | Command("/bin/cat")).run())
  println((Command("/bin/echo", "x") | Command("avin-no-such-program") | Command("/bin/cat")).output())
