// expect: exit 0
// A three-state weather chain walked with `chooseWeighted`: each row of the transition matrix is the
// weights of the next state. A seed replays the walk, and the long-run share of each state matches
// the chain's stationary distribution.
import avin.random.Random

main()
    val names = ["sunny", "cloudy", "rainy"]
    val rows = [[0.7, 0.2, 0.1], [0.3, 0.4, 0.3], [0.2, 0.3, 0.5]]
    val g = Random(2024)
    var state = 0
    val walk = Array.tabulate(12, i ->
        state = g.chooseWeighted(rows(state))
        names(state))
    println(walk.toVector)

    val counts = Array.fill(3, 0)
    val steps = 100000
    for i in 0..<steps
        state = g.chooseWeighted(rows(state))
        counts(state) += 1
    // The stationary distribution of the matrix is (21, 13, 12) / 46.
    val sunny = real(counts(0)) / real(steps)
    val cloudy = real(counts(1)) / real(steps)
    val rainy = real(counts(2)) / real(steps)
    println(s"sunny near 21/46: ${0.44 < sunny < 0.47}")
    println(s"cloudy near 13/46: ${0.27 < cloudy < 0.30}")
    println(s"rainy near 12/46: ${0.245 < rainy < 0.275}")
