// An override writes the overridden method's bound by a type parameter, or none, and a call through
// the trait reaches the override at each instance.
open class Animal(val label: string)

class Dog(label: string): Animal(label)

trait Sink[-T]
  take[U: T](u: U) -> string

// The class's parameter, bounded by a class, bounds the override's own: a `U` has `Animal`'s fields.
class Kennel[A: Animal]: Sink[A]
  override take[U: A](u: U) -> string = s"kennel ${u.label}"

// Assuming less than the trait's method is allowed: no bound at all.
class Pound: Sink[Animal]
  override take[U](u: U) -> string = "pound"

feed[U: Animal](s: Sink[Animal], u: U) -> string = s.take(u)

main()
  val sinks: Vector[Sink[Animal]] = [Kennel[Animal](), Pound()]
  for s in sinks
    println(s.take(Dog("rex")))
    println(feed(s, Animal("cow")))
  // A sink of animals is a sink of dogs, whose `take` holds `U` to `Dog`.
  val dogs: Sink[Dog] = Kennel[Animal]()
  println(dogs.take(Dog("fido")))
