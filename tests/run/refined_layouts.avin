// expect: exit 0
// The layout of an instance of a type with refined variants holds the variants possible at it, each
// at its declared position, so equality, hashing, `Display` and `Debug` are compiled per instance
// over them: fields of value types (`int`, `long`, `real`, a tuple, a union with a scalar member) and
// of references, fieldless variants, a parameter of the type a variant names nowhere, a variant's own
// parameter with a default, and a constructor parameter kept in its place. Where the trait on the
// instance does not imply it on a variant's own parameter, the type has no `Display`, and a value
// shows its type.

data Val[T]
  I(n: int) -> Val[int]
  L(n: long) -> Val[long]
  R(x: real) -> Val[real]
  P(at: (int, real)) -> Val[(int, real)]
  S(text: string) -> Val[string]
  W(either: int | string) -> Val[int | string]
  Many[A](items: Vector[Val[A]]) -> Val[Vector[A]]
  Sized[Ä](wert: Vector[Ä] = [], n: int = wert.size) -> Val[Vector[Ä]]
  Same(a: Val[T], b: Val[T])

data Query[R]
  Balance -> Query[long]
  Owner -> Query[string]
  Deposit(amount: long) -> Query[unit]

data DoorShut()

data DoorOpen()

data Step[From, To]
  OpenIt -> Step[DoorShut, DoorOpen]
  CloseIt -> Step[DoorOpen, DoorShut]
  Wait(seconds: int) -> Step[From, From]

data Shape[F[_], T]
  Plain(x: F[T])
  Counted(x: F[int]) -> Shape[F, int]
  Named(name: string) -> Shape[F, string]

class Opaque(val n: int)

class Wrap[A](val a: A)

impl[A] Display for Wrap[A]
  display(out: Writer, spec: FormatSpec)
    out.write("wrap")

data Odd[T]
  Hold[A](x: A) -> Odd[Wrap[A]]

main()
  val vals: Vector[Any] = [I(1), L(9223372036854775807), R(2.5), P((3, -0.5)), S(""), S("é\n"), W(4), W("ü")]
  for v in vals
    println(v)
  println(debug(S("é\n")))
  println(debug(W("ü")))
  println(I(1) == I(1))
  println(L(-9223372036854775808) == L(-9223372036854775808))
  println(R(2.5) == R(2.5))
  println(P((3, -0.5)) == P((3, 0.5)))
  println(S("é") == S("é"))
  println(W(4) == W(4))
  println(W(4) == W("4"))
  println(S("a").hash() == S("a").hash())
  println(Same(I(1), I(2)))
  println(Same(S("x"), S("x")) == Same(S("x"), S("x")))
  println(Many([I(1), I(-1)]))
  println(Many([S("a")]) == Many([S("a")]))
  println(Many[int]([]))
  println(Sized[int]())
  println(Sized(["x", "y"]))
  println(Sized([1, 2, 3]) == Sized([1, 2, 3], 3))
  println(Sized([1, 2, 3]) == Sized([1, 2, 3], 4))
  // Fieldless refined variants, one constant object each.
  println(Balance)
  println(Query[string].Owner)
  println(Deposit(1))
  val q: Query[long] = Balance
  println(q == Balance)
  println(Query[long].Balance == Balance)
  // `Wait`'s `To` is fixed to its `From`; `OpenIt` names neither parameter in a field.
  val opened: Step[DoorShut, DoorOpen] = OpenIt
  val waited: Step[DoorOpen, DoorOpen] = Wait(3)
  println(opened)
  println(waited)
  println(Wait[DoorShut](0) == Wait[DoorShut](0))
  println(CloseIt == CloseIt)
  // A constructor parameter in its place, beside a fixed `T`.
  val counted: Shape[Vector, int] = Counted([1, 2])
  val again: Shape[Vector, int] = Counted([1, 2])
  val plain: Shape[Vector, int] = Plain([1, 2])
  println(counted == again)
  println(counted == plain)
  println(Named[Option]("n") == Named[Option]("n"))
  // `Wrap[A]` shows itself whatever `A` is, so `Odd[Wrap[A]]` having `Display` says nothing of `A`.
  println(Hold(Opaque(1)))
  val shapes: Vector[Any] = [counted, Named[Option]("n"), opened, waited]
  for s in shapes
    s match
      x: Shape[Vector, int] -> println("a counted shape")
      x: Step[DoorOpen, DoorOpen] -> println(s"a waiting step $x")
      x: Step[DoorShut, DoorOpen] -> println(s"an opening step $x")
      _ -> println("something else")
