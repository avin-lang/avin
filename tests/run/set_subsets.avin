// expect: exit 0
// `subsets()` visits every subset of a set and `subsets(k)` those of `k` elements, each a set of the
// receiver's kind, lazily: the empty set first, then the subsets of one element, of two, and so on,
// those of one size in the lexicographic order of their elements' positions in iteration order.

kind(s: Any) -> string = s match
  _: HashSet[int] -> "hash"
  _: TreeSet[int] -> "tree"
  _: OrderedSet[int] -> "ordered"
  _: BitSet -> "bitset"
  _ -> "other"

binomial(n: int, k: int) -> long
  var r: long = 1
  for i in 1 ..< k + 1 do r = r * long(n - k + i) / long(i)
  r

main()
  // order and content, on the sorted kinds
  val ts = TreeSet(1, 2, 3)
  println(ts.subsets().toVector)
  println(ts.subsets(2).toVector)
  println(ts.subsets(0).toVector, ts.subsets(1).toVector, ts.subsets(3).toVector)
  println(OrderedSet(30, 10, 20).subsets().toVector)
  println(OrderedSet(30, 10, 20).subsets(2).toVector)
  println(BitSet(5, 1, 3).subsets(2).toVector)

  // the receiver's kind
  println(kind(HashSet(1, 2).subsets().toVector(1)), kind(TreeSet(1, 2).subsets().toVector(1)))
  println(kind(OrderedSet(1, 2).subsets().toVector(2)), kind(BitSet(1, 2).subsets().toVector(3)))
  println(kind(TreeSet(1, 2).subsets(0).toVector(0)), kind(OrderedSet(1, 2).subsets(2).toVector(0)))
  val asSet: Set[int] = TreeSet(1, 2, 3)
  println(kind(asSet.subsets(2).toVector(0)), asSet.subsets().toVector.length)

  // counts: 2^n and C(n, k), and every subset is a distinct subset of the set
  for n in 0 ..< 9
    val s = TreeSet.from(0 ..< n)
    val all = s.subsets().toVector
    var ok = all.length == 1 << n && HashSet.from(all).size == 1 << n
    for sub in all
      if !sub.subsetOf(s) then ok = false
    var total = 0
    for k in 0 ..< n + 1
      val ks = s.subsets(k).toVector
      if long(ks.length) != binomial(n, k) then ok = false
      for sub in ks
        if sub.size != k then ok = false
      total += ks.length
    println(n, all.length, ok, total)

  // the sizes come out ascending in subsets()
  val sizes = HashSet.from([1, 2, 3, 4]).subsets().map(x -> x.size).toVector
  println(sizes, sizes == sizes.sorted)

  // k out of range: none
  println(ts.subsets(-1).toVector, ts.subsets(4).toVector, ts.subsets(100).toVector)
  println(ts.subsets(-1).hasNext(), ts.subsets(4).hasNext(), ts.subsets(3).hasNext())
  println(TreeSet.empty[int]().subsets(1).hasNext(), TreeSet.empty[int]().subsets(-1).hasNext())

  // the empty set has one subset: itself
  val e = TreeSet.empty[int]()
  println(e.subsets().toVector, e.subsets(0).toVector, kind(e.subsets().next()))
  println(BitSet.empty().subsets().toVector, HashSet.empty[int]().subsets(0).toVector.length)
  println(OrderedSet.empty[int]().subsets().toVector.length)

  // a one-element set
  println(HashSet(7).subsets().toVector, HashSet(7).subsets(1).toVector)

  // laziness: a 30-element set has 2^30 subsets and a few are taken without making the rest
  val big = TreeSet.from(0 ..< 30)
  println(big.subsets().take(4).toVector)
  println(big.subsets(2).take(3).toVector)
  println(big.subsets(15).take(1).toVector)
  println(big.subsets(30).toVector.length, big.subsets(31).hasNext())
  val it = big.subsets()
  it.next()
  println(it.next(), it.hasNext())
  println(big.subsets(29).take(2).toVector)
  println(big.subsets(3).take(2).map(x -> x.size).toVector)

  // the iterator is exhausted at the end and traps afterwards
  val one = TreeSet(1).subsets()
  println(one.next(), one.next(), one.hasNext())

  // the set is unchanged and subsets are independent of it
  val src = TreeSet(1, 2, 3)
  val subs = src.subsets(2).toVector
  println(subs(0).incl(99), src, subs(0), src.size)

  // strings, and subsets of subsets
  val words = TreeSet("a", "b", "c")
  println(words.subsets(2).toVector)
  println(TreeSet(1, 2, 3).subsets(2).toVector.map(x -> x.subsets().toVector.length))

  // GC pressure: build many subsets while allocating
  var n = 0
  var sum = 0
  for sub in TreeSet.from(0 ..< 14).subsets()
    n += 1
    sum += sub.size
  println(n, sum)
  var cnt = 0
  for sub in OrderedSet.from(0 ..< 20).subsets(10)
    cnt += 1
    if cnt >= 5000 then break
  println(cnt)
