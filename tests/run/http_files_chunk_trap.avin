// expect: trap
// A file server reads a file a chunk at a time, so its chunk is at least one byte: one byte is
// taken, and zero traps where the server is made.
import avin.net.http.FileServer

main()
  println(FileServer("/srv", chunkBytes = 1).chunkBytes)
  println(FileServer("/srv", chunkBytes = 0).chunkBytes)
