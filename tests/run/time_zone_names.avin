// expect: exit 0
// `zone(name)`: a name in the tz database, `UTC`, and the fixed offsets `Z`, `+hh:mm`, `+hhmm`;
// what cannot be a name (decided before anything is read), a name the database lacks, and their
// messages; `fixedZone` and `utc`; a zone's equality, hash, display and debug form, and its
// answers at an instant.
import avin.time.{Duration, Zone, ZoneError, epochSeconds, fixedZone, hours, minutes, utc, zone}

show(name: string)
    zone(name) match
        Ok(z) -> println(s"'$name' -> $z ${z.isFixed()} ${z.offsetAt(epochSeconds(0))} ${z == utc}")
        Err(e) -> println(s"'$name' -> ${e.message()} | $e")

main()
    for name in ["UTC", "Z", "+05:30", "+0530", "-08:00", "-0800", "+00:00", "-00:00", "+23:59", "-23:59", "America/Toronto", "Asia/Kolkata", "Etc/GMT+5"] do show(name)
    for name in ["", "/etc/passwd", "../etc/passwd", "America/../UTC", "Europe/Pa ris", "Europe/Paris\n", "Ünïcode", "a:b", "+24:00", "+05:60", "+5:30"] do show(name)
    for name in ["Mars/Olympus_Mons", "America", "+053", "Nowhere_Near"] do show(name)

    // Each variant's message and display.
    println(zone("Mars/Olympus_Mons") == Err(ZoneError.UnknownZone("Mars/Olympus_Mons")))
    println(zone("") == Err(ZoneError.NotAZoneName("")))
    println(ZoneError.Malformed("Broken/Zone").message())

    // `utc` is `zone("UTC")`, `fixedZone(0)` and the zero offset by any spelling.
    println(zone("UTC").getOrElse(fixedZone(hours(1))) == utc)
    println(fixedZone(Duration.Zero) == utc)
    println(zone("Z").getOrElse(fixedZone(hours(1))) == utc)
    println(fixedZone(hours(5) + minutes(30)) == zone("+0530").getOrElse(utc))
    println(fixedZone(hours(5) + minutes(30)).hash() == zone("+05:30").getOrElse(utc).hash())
    println(fixedZone(hours(5)) == fixedZone(hours(6)))
    println(s"${fixedZone(-minutes(1))} ${fixedZone(hours(23) + minutes(59))} ${fixedZone(-(hours(23) + minutes(59)))}")
    println(s"${utc.name()} ${utc} ${debug(utc)} ${utc.isFixed()} ${utc.abbreviationAt(epochSeconds(0))} ${utc.isDaylightSavingAt(epochSeconds(0))}")

    // A named zone: its answers change with the instant; a fixed zone's never do.
    val toronto = zone("America/Toronto").getOrElse(utc)
    val january = epochSeconds(1767225600)
    val july = epochSeconds(1782864000)
    println(s"${toronto.name()} ${debug(toronto)} ${toronto.isFixed()}")
    println(s"${toronto.offsetAt(january)} ${toronto.abbreviationAt(january)} ${toronto.isDaylightSavingAt(january)}")
    println(s"${toronto.offsetAt(july)} ${toronto.abbreviationAt(july)} ${toronto.isDaylightSavingAt(july)}")
    val india = fixedZone(hours(5) + minutes(30))
    println(s"${india.offsetAt(january)} ${india.offsetAt(july)} ${india.abbreviationAt(july)} ${india.isDaylightSavingAt(july)}")

    // Zones are map keys, equal by name.
    val names = Map[Zone, string]().updated(toronto, "home").updated(utc, "server")
    println(names(zone("America/Toronto").getOrElse(utc)))
    println(names(fixedZone(Duration.Zero)))

    // A reading in one zone read again in another is the same instant, and a different reading.
    val here = july.atZone(toronto)
    val there = here.atZone(india)
    println(s"$here $there ${here.isSameInstant(there)} ${here == there} ${there.atZone(toronto) == here}")
