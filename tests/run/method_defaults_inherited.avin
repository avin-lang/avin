// Defaults belong to the method that introduces a parameter. An override takes them, and a call
// computes them from the receiver it is made on, whichever class's method then runs.
open class Shape(val name: string)
    describe(prefix: string = s"<$name>", width: int = 10) -> string = s"$prefix $name $width"
    scaled(by: int = 2) -> int = by

class Circle(r: int) : Shape("circle")
    override describe(prefix: string, width: int) -> string = s"circle($r) $prefix $width"

class Square(side: int) : Shape("square")
    override scaled(by: int) -> int = side * by

// The defaults of a generic class's method, taken by an override in a subclass that fixes the type.
open class Store[T](val item: T)
    pair(other: T = item) -> (T, T) = (item, other)

class IntStore(n: int) : Store[int](n)
    override pair(other: int) -> (int, int) = (other, item)

// A trait's method declares defaults; a call through the trait's type uses them, and so does a call
// on a class that implements the method.
trait Greeter
    greet(who: string = "world", punctuation: string = "!") -> string

class English() : Greeter
    override greet(who: string, punctuation: string) -> string = s"hello, $who$punctuation"

class Polite(title: string)

impl Greeter for Polite
    greet(who: string, punctuation: string) -> string = s"good day, $title $who$punctuation"

// A trait's default may use the receiver's other methods.
trait Sized
    size() -> int
    padded(extra: int = size()) -> int = size() + extra

data Bag(count: int)

impl Sized for Bag
    size() -> int = count

// An impl of a data type declares defaults on its own methods.
data Temperature(degrees: int)

impl Temperature
    warmer(by: int = degrees / 10) -> Temperature = Temperature(degrees + by)

// A method of one required parameter and defaults is called infix.
class Vec(x: int, y: int)
    plus(other: Vec, scale: int = 1) -> Vec = Vec(x + other.x * scale, y + other.y * scale)
    show() -> string = s"($x, $y)"

// A superclass's constructor defaults apply where a subclass passes fewer arguments.
open class Base(val a: int, val b: int = a * 2)

class Derived() : Base(5)

// `super` calls the overridden method, with its defaults.
class Loud() : Shape("loud")
    override describe(prefix: string, width: int) -> string = super.describe() + s" / $prefix $width"

show(s: Shape)
    println(s.describe())
    println(s"${s.scaled()} ${s.scaled(5)}")

showStore(s: Store[int])
    val (a, b) = s.pair()
    println(s"$a $b")

welcome(g: Greeter)
    println(g.greet())
    println(g.greet(punctuation = "?"))

main()
    show(Shape("plain"))
    show(Circle(2))
    show(Square(3))
    println(Circle(1).describe(width = 3))
    println(s"${Square(4).scaled()}")
    showStore(Store(1))
    showStore(IntStore(2))
    val (c, d) = IntStore(7).pair()
    println(s"$c $d")
    welcome(English())
    welcome(Polite("sir"))
    println(English().greet("you"))
    println(Polite("madam").greet())
    val bag = Bag(3)
    println(s"${bag.padded()} ${bag.padded(1)}")
    val sized: Sized = Bag(4)
    println(s"${sized.padded()}")
    println(s"${Temperature(50).warmer().degrees} ${Temperature(50).warmer(1).degrees}")
    val v = Vec(1, 2) plus Vec(10, 20)
    println(v.show())
    println(Vec(1, 2).plus(Vec(1, 1), 3).show())
    val e = Derived()
    println(s"${e.a} ${e.b}")
    println(Loud().describe())
