// expect: exit 0
// The constructor runs the body in order: a field's initializer sees the statements above it, and a
// statement below changes a field the initializers above already read. Once every field is
// initialized, the body may capture the object in a lambda and call its methods. An object bound by
// a pattern is the same object.

class Cell(var value: int)
    val before = value
    value += 1
    val after = value
    var reader: () -> int = () -> 0
    var doubled = 0
    reader = () -> value
    doubled = twice()
    twice() -> int = value * 2

main() -> int
    val c = Cell(4)
    println(s"${c.before} ${c.after} ${c.reader()} ${c.doubled}")
    c.value = 9
    println(s"${c.reader()}")
    c match
        x -> if !(x === c) then return 1
    0
