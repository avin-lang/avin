// expect: exit 0
// The constructor runs the body in order: a field's initializer may hold a lambda that captures
// the object, call a method, and see the statements above it; a statement below changes a field
// the initializers above already read. An object bound by a pattern is the same object.

class Cell(var value: int)
    val reader: () -> int = () -> value
    val doubled = twice()
    twice() -> int = value * 2
    value += 1
    val after = value

main() -> int
    val c = Cell(4)
    print(s"${c.reader()} ${c.doubled} ${c.after}")
    c.value = 9
    print(s"${c.reader()}")
    c match
        x -> if !(x === c) then return 1
    0
