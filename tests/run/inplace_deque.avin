// expect: exit 0
// A deque changes in place as a buffer does: `remove(i, n)`, `trimStart`, `trimEnd`, `filterInPlace`,
// `mapInPlace`, `patchInPlace`, `subtractOne` and `reverseInPlace`. Its elements wrap around the
// end of its array, so every operation is checked against a buffer holding the same elements, for
// every place the first element can start and every length, wrapped or not.

class Box(val n: int) derives Eq, Hash

// A deque of `0 ..< n` whose first element sits at `shift` in an array of eight places.
layout(shift: int, n: int) -> Deque[int]
    val d = Deque[int]()
    for i in 0 ..< shift do d.append(-1)
    for i in 0 ..< shift do d.removeHead()
    for i in 0 ..< n do d.append(i)
    d

model(n: int) -> Buffer[int]
    val b = Buffer[int]()
    for i in 0 ..< n do b.addOne(i)
    b

check(d: Deque[int], b: Buffer[int], what: string) -> int
    if d.toVector == b.toVector && d.length == b.length then return 0
    println(s"MISMATCH $what: $d $b")
    1

main()
    var bad = 0
    var checks = 0
    for shift in 0 ..< 8
        for n in 0 ..< 9
            // every remove(i, c)
            for i in 0 ..< n + 1
                for c in 0 ..< n - i + 1
                    val d = layout(shift, n)
                    val b = model(n)
                    d.remove(i, c)
                    b.remove(i, c)
                    bad += check(d, b, s"remove($i, $c) shift $shift n $n")
                    d.append(100)
                    b.append(100)
                    d.prepend(-100)
                    b.prepend(-100)
                    bad += check(d, b, s"remove($i, $c) then ends, shift $shift n $n")
                    checks += 2
            // trimStart, trimEnd
            for c in 0 ..< n + 1
                val d = layout(shift, n)
                val b = model(n)
                d.trimStart(c)
                b.trimStart(c)
                bad += check(d, b, s"trimStart($c) shift $shift n $n")
                val d2 = layout(shift, n)
                val b2 = model(n)
                d2.trimEnd(c)
                b2.trimEnd(c)
                bad += check(d2, b2, s"trimEnd($c) shift $shift n $n")
                checks += 2
            // filterInPlace by several predicates
            for m in 1 ..< 4
                val d = layout(shift, n)
                val b = model(n)
                d.filterInPlace(x -> x % m == 0)
                b.filterInPlace(x -> x % m == 0)
                bad += check(d, b, s"filterInPlace($m) shift $shift n $n")
                d.append(5)
                d.prepend(6)
                b.append(5)
                b.prepend(6)
                bad += check(d, b, s"filter then ends $m shift $shift n $n")
                checks += 2
            val df = layout(shift, n)
            val bf = model(n)
            df.filterInPlace(x -> false)
            bf.filterInPlace(x -> false)
            bad += check(df, bf, s"filter none shift $shift n $n")
            // mapInPlace and reverseInPlace
            val dm = layout(shift, n)
            val bm = model(n)
            dm.mapInPlace(x -> x * 3 + 1)
            bm.mapInPlace(x -> x * 3 + 1)
            bad += check(dm, bm, s"mapInPlace shift $shift n $n")
            dm.reverseInPlace()
            bm.reverseInPlace()
            bad += check(dm, bm, s"reverseInPlace shift $shift n $n")
            checks += 4
            // patchInPlace
            for i in 0 ..< n + 1
                for c in 0 ..< n - i + 1
                    for k in 0 ..< 4
                        val d = layout(shift, n)
                        val b = model(n)
                        val with = model(k + 50).toVector.take(k)
                        d.patchInPlace(i, with, c)
                        b.patchInPlace(i, with, c)
                        bad += check(d, b, s"patchInPlace($i, $k, $c) shift $shift n $n")
                        checks += 1
            // subtractOne
            for x in -1 ..< n + 1
                val d = layout(shift, n)
                val b = model(n)
                val got = d.subtractOne(x)
                val expected = b.subtractOne(x)
                bad += check(d, b, s"subtractOne($x) shift $shift n $n")
                if got != expected
                    bad += 1
                    println(s"MISMATCH subtractOne answer $x")
                checks += 2
    println(s"checks $checks mismatches $bad")

    // A deque patched with itself places the elements it held when the call began.
    val mine = layout(5, 6)
    mine.patchInPlace(2, mine, 2)
    println(mine)

    // A full deque (no spare room) wraps entirely.
    val full = layout(3, 8)
    full.remove(2, 3)
    println(s"$full ${full.length}")
    full.trimStart(5)
    println(s"$full ${full.isEmpty}")
    full.append(1)
    println(full)

    // Elements keep nothing alive once taken out, and the deque is usable at every size.
    val objs = Deque[Box]()
    for i in 0 ..< 3000
        objs.append(Box(i))
        if i % 3 == 0 then objs.removeHead()
    objs.filterInPlace(b -> b.n % 2 == 0)
    objs.remove(5, 100)
    objs.trimStart(7)
    objs.trimEnd(7)
    objs.mapInPlace(b -> Box(b.n + 1))
    objs.reverseInPlace()
    println(s"${objs.length} ${objs(0).n} ${objs(objs.length - 1).n}")
    println(objs.subtractOne(Box(objs(3).n)))

    // strings, one and empty
    val words = Deque[string]()
    words.prepend("b")
    words.prepend("a")
    words.append("c")
    words.reverseInPlace()
    words.mapInPlace(w -> w + "!")
    println(debug(words))
    println(words.subtractOne("b!"))
    println(words.subtractOne("zz!"))
    println(debug(words))
    val none = Deque[string]()
    none.reverseInPlace()
    none.trimStart(0)
    none.trimEnd(0)
    none.remove(0, 0)
    none.filterInPlace(w -> true)
    none.mapInPlace(w -> w)
    println(none.subtractOne("x"))
    println(none.length)
