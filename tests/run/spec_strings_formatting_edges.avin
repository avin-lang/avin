// expect: exit 0
// Formatting at its edges: the smallest integers of each width in every base, precision 0 on zero,
// rounding half to even, infinities and NaNs under each real conversion and flag, Unicode text
// truncated and padded by characters, counted widths and precisions that are negative, long or past
// `int`, flags with counted widths, a value of the program's own reading its `FormatSpec`, values
// typed `Any` and as traits interpolated by their run-time types, and `print`'s argument forms.
data Money(cents: long)

impl Display for Money
  display(out: Writer, spec: FormatSpec)
    val text = if spec.conversion == 'x' then "M${cents}" else s"$$${cents / 100}.${cents % 100}"
    val shown = if spec.plus && cents >= 0 then "+" + text else text
    out.writeField(if spec.precision >= 0 then shown.take(spec.precision) else shown, spec)

trait Pet
  name() -> string

class Cat(): Pet
  override name() -> string = "cat"

main()
  val i8min: i8 = -128
  val i16min: i16 = -32768
  println(f"${i8min}%d ${i8min}%x ${i8min}%o ${i8min}%b ${i16min}%X")
  println(f"${long.MinValue}%d|${long.MinValue}%x|${int.MinValue}%#x|${long.MaxValue}%+d")
  val z = 0
  println(f"[${z}%.0d] [${z}%5.0d] [${z}%#x] [${z}%#o] [${8}%#o] [${5}%#b] [${255}%#X] [${7}%.3d] [${-7}%06.3d]")
  val bt: byte = 200
  println(f"${bt}%d ${bt}%x ${bt}%08b")
  println(
    f"${0.125}%.2f ${0.375}%.2f ${2.5}%.0f ${3.5}%.0f ${-0.5}%.0f ${1e300}%.0e ${0.0}%e ${123456.0}%g ${0.0001}%g ${1.0}%#g"
  )
  val inf = 1.0 / 0.0
  val nan = 0.0 / 0.0
  println(f"${inf}%f ${-inf}%e ${inf}%E ${nan}%g ${nan}%G ${inf}%+f ${inf}%8f| ${nan}%-6f| ${inf}%08f")
  println(f"[${"héllo"}%.2s] [${"日本語"}%5s] [${"日本語"}%-5s] [${'é'}%3c] [${"ab"}%.0s]")
  val w = -6
  val big: long = 3000000000
  val p: long = 2
  println(
    f"[${"ab"}%${w}s] [${1.5}%.${p}f] [${"ab"}%.${-1}s] [${4}%0${w + 10}d] [${4}%-${3}d] [${"x"}%${big - big + 3}s]"
  )
  var order = Buffer[int]()
  val counted = f"${real(track(order, 1, 5))}%${track(order, 2, 4)}.${track(order, 3, 2)}f"
  println(s"$counted ${order}")
  val m = Money(1234)
  println(f"[$m] [${m}%10s] [${m}%-10s|] [${m}%.4s] [${Money(-5)}%-7s]")
  val xs: Seq[int] = [1, 2, 3]
  val nested: Vector[Seq[int]] = [xs, List(4)]
  val pet: Pet = Cat()
  val anything: Any = (1, "two")
  val fn: Any = (x: int) -> x
  println(s"$xs $nested $pet $anything $fn")
  println(f"[${pet}%5s] [${xs}%-10s] [${anything}%?]")
  println("total", 3, (1, 2))
  println(1, pet, xs)
  print()
  println()
  print("a", 'b')
  println()
  val words: Seq[string] = ["x", "y"]
  println(words*)
  println(words)
  println(debug("a\"b\n\t\\"), debug('\''), debug(()), debug(2.5), debug(Some('c')))
  println(s"${()} ${true} ${1.0} ${0.1} ${-0.0} ${1e21} ${1e-7}")

track(order: Buffer[int], n: int, value: int) -> int
  order.append(n)
  value
