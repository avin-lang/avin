// expect: exit 0
// `watch(ref, message:)` puts `message` in the watcher's own mailbox when the watched actor ends,
// and `watch(ref, f)` puts `f` of how it ended there: of a live actor once it ends, of one that has
// ended already at once. Watching an actor again replaces the earlier watch, so its end is told
// once, by the newer; `unwatch` stops the telling; an actor watching itself is told nothing and ends
// as usual; a parent watches its own child; and a watcher that ends first is simply not told. A
// generic actor watches at its own message type.
import avin.actors.{ActorRef, Ending, Failed, Stopped, spawn}
import avin.threads.{Channel, Promise}

data Msg
    Quit
    Watch(target: ActorRef[Nothing])
    WatchTwice(target: ActorRef[Nothing])
    WatchThenUnwatch(target: ActorRef[Nothing])
    Ended(label: string)
    EndedHow(e: Ending)
    Report(reply: Promise[string])

how(e: Ending) -> string = e match
    Stopped -> "stopped"
    Failed(reason) -> s"failed: $reason"

actor Target receives Msg
    receive
        Quit -> stop()
        _ -> ()

actor Watcher(log: Channel[string]) receives Msg
    var told: Vector[string] = Vector()
    receive
        Watch(target) -> watch(target, e -> EndedHow(e))
        WatchTwice(target) ->
            watch(target, message = Ended("first"))
            watch(target, message = Ended("second"))
        WatchThenUnwatch(target) ->
            watch(target, Ended("unwatched"))
            unwatch(target)
        Ended(label) ->
            told = told :+ label
            log.send(label)
        EndedHow(e) ->
            told = told :+ how(e)
            log.send(how(e))
        Report(reply) -> reply.complete(told.mkString(", "))
        Quit -> stop()

actor SelfWatcher(log: Channel[string]) receives Msg
    watch(self, Ended("self"))
    receive
        Ended(label) -> log.send(s"told of $label")
        Quit -> stop()
        _ -> ()
    stopping
        log.send("self-watcher stopping")

actor Parent(log: Channel[string]) receives Msg
    val kid = spawn(Target())
    watch(kid, Ended("my child"))
    kid.tell(Quit)
    receive
        Ended(label) ->
            log.send(s"parent told of $label, ${children().length} children left")
            stop()
        _ -> ()

data Gen[T: Sendable]
    Watched(value: T)
    Start(target: ActorRef[Nothing], value: T)

actor GenericWatcher[T: Sendable + Display](out: Channel[string]) receives Gen[T]
    receive
        Start(target, value) -> watch(target, Watched(value))
        Watched(value) ->
            out.send(s"generic told $value")
            stop()

report(w: ActorRef[Msg]) -> string
    val p = Promise[string]()
    w.tell(Report(p))
    p.future.await()

main()
    val log = Channel[string]()
    val w = spawn(Watcher(log))
    val live = spawn(Target())
    w.tell(Watch(live))
    // Once the watcher has handled the watch, end the target.
    println(report(w))
    live.tell(Quit)
    println(log.receive().get())
    val gone = spawn(Target())
    gone.tell(Quit)
    gone.ended().await()
    w.tell(Watch(gone))
    println(log.receive().get())
    val twice = spawn(Target())
    w.tell(WatchTwice(twice))
    report(w)
    twice.tell(Quit)
    println(log.receive().get())
    val unwatched = spawn(Target())
    w.tell(WatchThenUnwatch(unwatched))
    report(w)
    unwatched.tell(Quit)
    unwatched.ended().await()
    // A last watched end, told after the unwatched one would have been.
    val last = spawn(Target())
    w.tell(Watch(last))
    report(w)
    last.tell(Quit)
    println(log.receive().get())
    println(report(w))

    val sw = spawn(SelfWatcher(log))
    sw.tell(Quit)
    sw.ended().await()
    println(log.receive().get())

    val p = spawn(Parent(log))
    p.ended().await()
    println(log.receive().get())

    // A watcher that ends before the actor it watches is not told, and nothing goes wrong.
    val early = spawn(Watcher(log))
    val later = spawn(Target())
    early.tell(Watch(later))
    early.tell(Quit)
    early.ended().await()
    later.tell(Quit)
    later.ended().await()

    val out = Channel[string]()
    val gw = spawn(GenericWatcher[string](out))
    val target = spawn(Target())
    gw.tell(Start(target, "seven"))
    target.tell(Quit)
    println(out.receive().get())
    gw.ended().await()
    w.tell(Quit)
    w.ended().await()
    log.close()
    println(s"left in the log: ${log.toVector}")
