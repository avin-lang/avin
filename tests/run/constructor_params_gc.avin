// expect: exit 0
// Values of `F[A]` made, kept and dropped in bulk through generic code with constructor
// parameters, so the collector runs while instances at `Vector`, `Option`, `List` and a partial
// application hold them: in fields, in closures, in a recursive type and across calls.
data Nested[F[_], A](inner: F[Option[A]])

class Keeper[F[_]](var kept: F[string])
  replace(x: F[string]) = kept = x

same[F[_], A](x: F[A]) -> F[A] = x

keepAll[F[_]](xs: Vector[F[int]]) -> Vector[() -> F[int]]
  var out: Vector[() -> F[int]] = []
  for x in xs
    out = out :+ (() -> same[F, int](x))
  out

main()
  var made: Vector[Vector[int]] = []
  for i in 0 ..< 2000
    made = made :+ same[Vector, int]([i, i + 1, i * 2])
  var sum = 0
  for v in made
    sum += v(2)
  println(sum)
  val boxes = keepAll[Option]([Some(1), None, Some(3)])
  var found = 0
  for f in boxes
    if f() is Some(n) then found += n
  println(found)
  val k = Keeper[List](List("a"))
  for i in 0 ..< 1000
    k.replace(List(s"item $i", "x"))
  println(k.kept)
  var nested: Vector[Nested[Vector, string]] = []
  for i in 0 ..< 500
    nested = nested :+ Nested[Vector, string]([Some(s"n$i"), None])
  println(nested.length)
  println(nested(499).inner)
  var r: Vector[Result[int, string]] = []
  for i in 0 ..< 1000
    r = r :+ same[Result[_, string], int](if i % 2 == 0 then Ok(i) else Err("odd"))
  var oks = 0
  for x in r
    if x is Ok(_) then oks += 1
  println(oks)
