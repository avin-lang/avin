// expect: exit 0
// A generic data type naming itself at its own type arguments inside another type, as `Option[Chain[T]]`,
// `Vector[Tree[T]]`, `List[Tree[T]]`, a tuple or an `Either`, recurses at the same instance and has
// finitely many copies: it compiles, and its derived `Display`, `Debug`, `Eq`, `Hash` and `Ord` work on
// it, on values thousands of links deep as well. So do generic data types naming each other.

data Chain[T](head: T, rest: Option[Chain[T]])

// An ordered wrapper of the program's own, so the derived `Ord` meets the same shape.
data Opt[T] derives Ord
    Empty
    Full(value: T)

data Link[T](head: T, rest: Opt[Link[T]]) derives Ord

data Rose[T](label: T, kids: Vector[Rose[T]])

data Bush[T](label: T, kids: List[Bush[T]])

data Paired[T](value: T, next: Option[(Paired[T], int)])

data Fork[T](value: T, next: Either[string, Fork[T]])

data Stack[T]
    Bottom
    Layer(item: T, below: Option[Stack[T]])

// Two generic types naming each other, each at the other's own type argument.
data Ping[T](value: T, pong: Opt[Pong[T]]) derives Ord

data Pong[T](value: T, ping: Opt[Ping[T]]) derives Ord

// Two parameters, swapped between the two types each round, so the instances still repeat.
data Hither[A, B](a: A, there: Option[Thither[B, A]])

data Thither[A, B](a: A, back: Option[Hither[B, A]])

// A chain `n` links long, built from the end.
chain(n: int) -> Chain[int]
    var c = Chain(n, None)
    var i = n - 1
    while i > 0
        c = Chain(i, Some(c))
        i -= 1
    c

// An ordered chain `n` links long, its last value raised by `last`.
linked(n: int, last: int) -> Link[int]
    var l = Link(n + last, Empty)
    var i = n - 1
    while i > 0
        l = Link(i, Full(l))
        i -= 1
    l

// The number of links, walked without recursion so a deep chain cannot exhaust the stack.
links[T](c: Chain[T]) -> int
    var count = 1
    var at = c.rest
    while at is Some(next)
        count += 1
        at = next.rest
    count

main()
    println(Chain(1, None))
    println(Chain("a", Some(Chain("b", None))))
    println(debug(Chain("a", Some(Chain("b", None)))))
    println(Rose(1, [Rose(2, []), Rose(3, [Rose(4, [])])]))
    println(Bush("x", List(Bush("y", List()))))
    println(Paired(1, Some((Paired(2, None), 7))))
    println(Fork(1, Right(Fork(2, Left("end")))))
    val s: Stack[int] = Layer(1, Some(Layer(2, Some(Bottom))))
    println(s)
    println(Ping(1, Full(Pong(2, Full(Ping(3, Empty))))))
    println(Hither(1, Some(Thither("a", Some(Hither(2, None))))))
    println(Link(1, Full(Link(2, Empty))))

    // Equality, hashing and order, derived and structural.
    val a = Chain(1, Some(Chain(2, None)))
    val b = Chain(1, Some(Chain(2, None)))
    val c = Chain(1, Some(Chain(3, None)))
    println(s"${a == b} ${a == c} ${a.hash() == b.hash()}")
    val k = Link(1, Full(Link(2, Empty)))
    val k2 = Link(1, Full(Link(3, Empty)))
    println(s"${k == Link(1, Full(Link(2, Empty)))} ${k == k2} ${k < k2} ${k2 > k} ${k < k} ${Link(1, Empty) < k} ${k.hash() == Link(1, Full(Link(2, Empty))).hash()}")
    val r = Rose(1, [Rose(2, [])])
    println(s"${r == Rose(1, [Rose(2, [])])} ${r == Rose(1, [])} ${r.hash() == Rose(1, [Rose(2, [])]).hash()}")
    val f = Fork(1, Right(Fork(2, Left("x"))))
    println(s"${f == Fork(1, Right(Fork(2, Left("x"))))} ${f == Fork(1, Left("x"))}")
    val p = Ping(1, Full(Pong(2, Empty)))
    println(s"${p == Ping(1, Full(Pong(2, Empty)))} ${p < Ping(1, Full(Pong(3, Empty)))} ${p.hash() == Ping(1, Full(Pong(2, Empty))).hash()}")
    val h = Hither(1, Some(Thither("a", None)))
    println(s"${h == Hither(1, Some(Thither("a", None)))} ${h == Hither(1, None)}")

    // Deep values: three thousand links built, compared and hashed, and two thousand displayed, each
    // link of which takes several frames of the derived `Display` at -O0.
    val long1 = chain(3000)
    val long2 = chain(3000)
    val shorter = chain(2999)
    println(links(long1))
    println(s"${long1 == long2} ${long1 == shorter} ${long1.hash() == long2.hash()}")
    val text = chain(2000).toString()
    println(s"${text.byteLength} ${text.startsWith("Chain(1, Some(Chain(2, ")} ${text.endsWith("Chain(2000, None)" + ")".repeat(3998))}")
    val deep1 = linked(3000, 0)
    val deep2 = linked(3000, 0)
    val deep3 = linked(3000, 1)
    println(s"${deep1 == deep2} ${deep1 < deep3} ${deep3 > deep1} ${deep1 < deep2} ${deep1.hash() == deep2.hash()} ${linked(2000, 0).toString().byteLength}")
