// expect: exit 0
// The program's own CPU time and its reaped children's. `cpuTime` grows with the work the program
// does and never goes back; `total` is `user` and `system` added; `CpuTime` adds as a value, with
// `Zero` its zero. `childrenCpuTime` takes in a child only once it is reaped, with the time of the
// sub-processes it ran and reaped in turn, and nothing for one still running or ended unwaited.
import avin.process
import avin.process.{Command, CpuTime}
import avin.threads
import avin.time

private val Burn = "i=0; while [ $i -lt 3 ]; do sh -c 'j=0; while [ $j -lt 40000 ]; do j=$((j+1)); done'; i=$((i+1)); done"

// A seventh of a second of CPU time used done by the program itself.
spin() -> long
  var x: long = 0
  val start = process.cpuTime().total
  while (process.cpuTime().total - start).toMillis < 150
    for i in 0 ..< 100000 do x = x +% long(i) * 3
  x

main()
  // The data value.
  val a = CpuTime(time.millis(3), time.millis(4))
  val b = CpuTime(time.micros(1), time.micros(2))
  println(a.total == time.millis(7))
  println(a + b == CpuTime(time.micros(3001), time.micros(4002)))
  println(CpuTime.Zero.total.isZero)
  println(a + CpuTime.Zero == a)
  println([a, b, a].sum.total == time.micros(14003))
  // The program's own time grows with work, and its parts add to its total.
  val before = process.cpuTime()
  val x = spin()
  val after = process.cpuTime()
  println(x != 0)
  println((after.total - before.total).toMillis >= 150)
  println(after.user >= before.user && after.system >= before.system)
  println(after.total == after.user + after.system)
  println(!after.user.isNegative && !after.system.isNegative)
  // A child counts only once it is reaped.
  val kids0 = process.childrenCpuTime()
  val child = Command("/bin/sh", "-c", Burn).start().ok.get
  val running = process.childrenCpuTime()
  println(running == kids0)
  println(child.waitFor())
  val kids1 = process.childrenCpuTime()
  println((kids1.total - kids0.total).toMillis >= 150)
  println(kids1.total - kids0.total >= child.cpuTime().total - time.millis(1))
  // A child that has ended and was not waited for counts nothing.
  val unwaited = Command("/bin/sh", "-c", Burn).start().ok.get
  val pid = unwaited.detach()
  threads.sleep(time.millis(800))
  println(process.childrenCpuTime() == kids1)
  println(process.waitPid(pid))
  println((process.childrenCpuTime().total - kids1.total).toMillis >= 150)
