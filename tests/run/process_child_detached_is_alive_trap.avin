// expect: trap
// A detached command is no longer its `Child`'s to wait for, ask after or stop: `isAlive` traps, after
// `pid` and a signal through the `Child` still answered.
import avin.process.Command

main()
  val child = Command("/bin/sleep", "30").start().ok.get
  val pid = child.detach()
  println(pid == child.pid())
  println(child.signal(15))
  println(child.isAlive())
  println("not reached")
