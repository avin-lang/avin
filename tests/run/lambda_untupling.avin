// expect: exit 0
// Where a function of one tuple is expected, a lambda of as many parameters as the tuple has
// elements takes the tuple apart: each parameter is an element, typed from it, and `_` binds
// nothing. An inner tuple is one element, a declared parameter may be wider than its element, and
// a lambda of one parameter still takes the tuple whole.

import avin.collections.mutable.{Map as MutableMap}

trait Animal
    name() -> string

class Dog : Animal
    override name() -> string = "dog"

class Cat : Animal
    override name() -> string = "cat"

applyPair[A, B, C](p: (A, B), g: ((A, B)) -> C) -> C = g(p)

fromDeclared[A, B, C](g: ((A, B)) -> C, p: (A, B)) -> C = g(p)

adder(base: int) -> ((int, int)) -> int = (a, b) -> a + b + base

divmod(a: int, b: int) -> (int, int) = a / b, a % b

class Labelled[T](val items: Vector[(string, T)])
    render(f: ((string, T)) -> string) -> Vector[string] = items.map(f)

main()
    val xs = [1, 2, 3]
    val ys = [1, 2, 4]

    // The common shapes over a Vector of pairs.
    println(xs.zip(xs).forall((x, y) -> x == y))
    println(xs.zip(ys).forall((x, y) -> x == y))
    println(xs.zip(ys).exists((x, y) -> x != y))
    println(xs.zip(ys).map((x, y) -> x + y))
    println(xs.zip(["a", "b", "c"]).filter((n, _) -> n != 2).map((n, s) -> s"$s$n"))
    xs.zip(ys).foreach((x, _) -> println(x))
    println(xs.zip(ys).flatMap((a, b) -> [a, b]))
    println(xs.zip(ys).sortBy((a, _) -> -a))
    println(xs.zip(ys).count((a, b) -> a < b))
    println(xs.zip(ys).find((a, b) -> a != b))

    // A function of two parameters is untouched: foldLeft's takes the accumulator and the pair.
    println(xs.zip(ys).foldLeft(0, (acc, p) -> acc + p.0 * p.1))

    // Empty and one-element sources.
    println(Vector.empty[(int, int)]().map((a, b) -> a + b))
    println(Vector.empty[(int, int)]().forall((a, b) -> false))
    println([(7, 8)].map((a, b) -> b - a))

    // A List, an Option, an Iterator and a Map.
    val l = List(1, 2, 3)
    println(l.zip(l).map((a, b) -> a * b))
    val o: Option[(int, string)] = Some((1, "a"))
    println(o.map((n, s) -> s"$s$n"))
    val none: Option[(int, string)] = None
    println(none.map((n, s) -> s"$s$n"))
    println(xs.iterator().zip(ys.iterator()).map((a, b) -> a + b).toVector())
    val m = Map[string, int]().updated("a", 1).updated("b", 2)
    println(m.forall((k, v) -> v > 0))
    println(m.exists((k, _) -> k == "b"))
    println(m.filter((_, v) -> v > 1))
    println(m.map((k, v) -> (v, k)))
    val mm = MutableMap[string, int]()
    mm("q") = 5
    mm.foreach((k, v) -> println(s"$k=$v"))

    // Arity three and four, typed and untyped parameters mixed.
    val trip = [(1, "a", 'x'), (2, "b", 'y')]
    println(trip.map((n: int, s: string, ch) -> s"$n$s$ch"))
    println(trip.map((_, _, ch) -> ch))
    val quads = [(1, 2, 3, 4)]
    println(quads.map((a, b, c, d) -> a * 1000 + b * 100 + c * 10 + d))

    // An inner tuple is one element.
    val nest = [((1, 2), 3)]
    println(nest.map((p, z) -> p.0 + p.1 + z))
    println(nest.map((p, _) -> p))
    println([(1, (2, 3))].map((a, inner) -> applyPair(inner, (b, c) -> a + b + c)))

    // A declared parameter wider than its element.
    val pets = [(Dog(), 1), (Dog(), 2)]
    println(pets.map((a: Animal, n) -> s"${a.name()}$n"))

    // Closures: capturing a value, assigning a captured var, escaping as a result.
    val k = 10
    println(xs.zip(ys).map((a, b) -> a * b + k))
    var total = 0
    xs.zip(ys).foreach((a, b) -> total += a * b)
    println(total)
    println(adder(5)((1, 2)))
    val made = xs.map(n -> ((a: int, b: int) -> a + b + n))
    println(made.map(f -> f(1, 1)))

    // A parameter named as an outer local shadows it inside the lambda only.
    val x = 100
    println(xs.zip(ys).map((x, y) -> x + y))
    println(x)

    // Generic functions and methods taking `((A, B)) -> C`.
    println(applyPair((2, "x"), (n, s) -> s"$n$s"))
    println(applyPair((2, "x"), (n: int, s: string) -> s"$s$n"))
    println(fromDeclared((a: int, b: bool) -> if b then a else -a, (4, false)))
    println(Labelled([("one", 1), ("two", 2)]).render((name, n) -> s"$name=$n"))

    // As a value of a declared function type, called with a tuple.
    val f: ((int, int)) -> int = (a, b) -> a - b
    println(f((10, 3)))
    println(f(divmod(17, 5)))
    val g: ((int, int)) -> int = p -> p.0 + p.1
    println(g((1, 2)))
    val h: ((int, int)) -> int = (_, _) -> 7
    println(h((1, 2)))

    // A two-parameter function type stays two parameters.
    val two: (int, int) -> int = (a, b) -> a * b
    println(two(3, 4))

    // Nested untupling and the match function beside it.
    println(xs.zip(ys).map((a, b) -> xs.zip(ys).map((c, d) -> a * c + b * d)))
    println(xs.zip(ys).map(match (a, b) -> a - b))
    val grid = [[(1, 2)], [(3, 4)]]
    println(grid.map(row -> row.map((a, b) -> a + b)))

    // Boundary values and Unicode strings pass through the elements unchanged.
    val edges = [(int.MinValue, int.MaxValue), (0, -1)]
    println(edges.map((lo, hi) -> s"$lo..$hi"))
    println([("é", "日本")].map((a, b) -> b + a))
    println([(long.MaxValue, "")].map((n, s) -> s"$n[$s]"))

    // Many short-lived tuples and strings through an untupled lambda.
    var big: Vector[(int, string)] = []
    for i in 0..<2000 do big = big :+ (i, s"v$i")
    val joined = big.map((i, s) -> s + s"$i").filter((s) -> s.charCount() > 5)
    println(joined.length())
    println(big.foldLeft(0, (acc, p) -> acc + p.0))
