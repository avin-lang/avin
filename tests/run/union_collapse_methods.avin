// expect: exit 0
// A union named by a generic class's or trait's own type parameter collapses at an instance as one
// named by a generic function's does: a method's result, a field and an overriding method's result
// typed `T | int` are `int` at `T = int`, through the trait and through the class.
trait Src[T]
  get() -> T | int

class Gen[T](val v: T): Src[T]
  override get() -> T | int = v

class Cell[T](var slot: T | real)
  read() -> T | real = slot
  put(x: T) = slot = x

data Box[T](item: T | string)

open[T](b: Box[T]) -> T | string = b.item

main()
  val g: Src[int] = Gen(7)
  val r: int = g.get()
  println(r + 1)
  val h = Gen(8)
  println(h.get())
  val gs: Src[string] = Gen("s")
  println(gs.get())
  val gb: Src[bool] = Gen(true)
  gb.get() match
    b: bool -> println(s"bool $b")
    i: int -> println(s"int $i")
  val c = Cell[real](1.5)
  println(c.read() + 1.0)
  c.put(2.75)
  println(c.slot)
  val bx = Box[string]("inside")
  println(open(bx).charCount)
  println(bx.item)
  val bi = Box[int](4)
  println(open(bi))
