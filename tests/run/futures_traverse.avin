// expect: exit 0
// `Future.traverse` calls its function for each element in order on the calling thread, so the
// futures start in that order, and gives their values in the order of the elements however the
// futures finish: later elements here finish first. An empty source gives an empty vector at once,
// and any iterable will do.
import avin.threads.{Future, Promise}

main() -> int
    val order = Buffer[int]()
    val gates = (0..<8).map(i -> Promise[unit]()).toVector
    val all = Future.traverse(0..<8, i ->
        order.addOne(i)
        Future
            gates(i).future.await()
            i * i)
    println(s"called in order ${order}")
    for i in (0..<8).reverse do gates(i).complete(())
    println(s"values ${all.await()}")
    val none = Future.traverse(Buffer[int](), i -> Future(i))
    println(s"empty ${none.isCompleted()} ${none.await()}")
    val words = Future.traverse(["one", "two", "three"], w -> Future(w.charCount))
    println(s"lengths ${words.await()}")
    val many = Future.traverse(1..200, n -> Future(n.toString()))
    val joined = many.await()
    println(s"many ${joined.length} ${joined(0)} ${joined(199)}")
    val ready = Future.traverse(List(3, 2, 1), n -> Future.successful(n * 10))
    println(s"complete already ${ready.await()}")
    0
