// expect: exit 0
// A `None` or an `Err` whose type argument nothing around it gives takes it from the branches it
// joins: the other branch of an `if` or `match`, the other return paths of a lambda passed to a
// generic function, with covariance deciding the instance.

open class Animal(val name: string)
class Dog(name: string) : Animal(name)

describe(o: Option[int]) -> string = o match
    Some(v) -> s"some $v"
    None -> "none"

// Result types inferred from the joined branches.
pick(c: bool, x: int) = if c then Some(x) else None
half(n: int) = if n % 2 == 0 then Ok(n / 2) else Err(s"$n is odd")
nonNegative(n: int) = if n < 0 then Err("negative") else Ok(n)

applyTo[A, B](x: A, f: A -> Option[B]) -> Option[B] = f(x)

main()
    val a = if true then Some(3) else None
    val b = if false then None else Some("s")
    println(s"${describe(a)} ${b.getOrElse("e")} ${describe(pick(true, 4))} ${describe(pick(false, 4))}")

    val m = 2 match
        1 -> None
        2 -> Some(2)
        _ -> None
    println(describe(m))

    println(s"${half(4).getOrElse(-1)} ${half(3).getOrElse(-1)} ${nonNegative(-2).isErr()} ${nonNegative(2).getOrElse(0)}")

    // `Option[Dog]` joined with an unknown is `Option[Dog]`, which is an `Option[Animal]`.
    val pet = if true then Some(Dog("rex")) else None
    val animal: Option[Animal] = pet
    println(animal.map(x -> x.name).getOrElse(""))
    val mixed = if false then Some(Animal("cat")) elif true then None else Some(Dog("fido"))
    println(mixed.map(x -> x.name).getOrElse("nobody"))

    // A lambda's `None` takes its type from the lambda's other return path, whichever comes first.
    println(describe(Some(5).flatMap(x -> if x > 3 then Some(x * 2) else None)))
    println(describe(Some(2).flatMap(x -> if x > 3 then None else Some(x + 10))))
    println(describe(applyTo(4, x -> if x > 3 then None else Some(x))))
    println(describe(applyTo(1, x -> if x > 3 then None else Some(x))))
