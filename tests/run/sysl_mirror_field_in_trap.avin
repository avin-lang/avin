// expect: trap
// A mirror's integer field going into Sysl stops the program, where the binding is called, when the
// Sysl field's type cannot hold its value.

@sysl("sysl.time.Date")
data WideDate
    WideDate(day: long)

@sysl("sysl.hint.black_box")
same(d: WideDate) -> WideDate

main()
    println(same(WideDate(2147483647)))
    println(same(WideDate(2147483648)))
