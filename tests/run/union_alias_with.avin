// expect: exit 0
// An alias names a union, generic or not, and is the union wherever it is written: a parameter, a
// result, a field, a type argument, a tuple's part, a pattern's type. `p with { v = 3 }` replaces a
// union field whole, injecting the value as any assignment does.

type Num = int | long

type OrErr[T] = T | string

data Reading(name: string, value: Num)

data Point(x: int, y: int)

data Holder(v: Point | int)

sum(a: Num, b: Num) -> long = toLong(a) + toLong(b)

toLong(n: Num) -> long = n match
  i: int -> long(i)
  l: long -> l

parse(text: string) -> OrErr[int] = text.toIntOption() match
  Some(n) -> n
  None -> s"not a number: $text"

explain(r: OrErr[int]) -> string = r match
  n: int -> s"number $n"
  e: string -> s"error $e"

nums(xs: Vector[Num]) -> long = xs.foldLeft(long(0), (acc, n) -> acc + toLong(n))

anyNum(a: Any) -> string = a match
  n: Num -> s"num ${toLong(n)}"
  _ -> "not a num"

main()
  println(sum(1, 5_000_000_000))
  val r = Reading("temp", 21)
  println(r)
  println(toLong(r.value))
  val pair: (Num, OrErr[bool]) = (2, true)
  println(toLong(pair.0))
  println(explain(parse("42")))
  println(explain(parse("forty")))
  println(nums([1, 2, 3_000_000_000]))
  println(anyNum(7))
  println(anyNum(long(7)))
  println(anyNum("seven"))
  val h = Holder(Point(1, 2))
  println(h with {v = 3})
  println(h with {v = Point(4, 5)})
  println(r with {value = 9_000_000_000})
