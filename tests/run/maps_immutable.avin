// expect: exit 0
// An immutable map is persistent: every update returns a new map and leaves the old one as it was.
// Its values are covariant. Maps are equal, and hash alike, when they hold equal entries, however
// they were built; `concat`, `filter`, `map` and `mapValues` make new maps; a builder takes pairs.
// The iteration order depends only on the keys, so two maps of the same keys built in opposite
// orders iterate alike.

open class Animal(val name: string)
class Dog(name: string): Animal(name)

describe(m: Map[string, Animal]) -> string
    var names = ""
    for k in m.keys do names = names + m(k).name
    s"${m.size}:${names.byteLength}"

main()
    val empty = Map[int, string]()
    val one = empty.updated(1, "one")
    val two = one.updated(2, "two")
    val changed = two.updated(1, "uno")
    println(s"${empty.size} ${one.size} ${two.size} ${changed.size} ${empty.isEmpty} ${two.nonEmpty}")
    println(s"${one(1)} ${two(1)} ${changed(1)} ${two.get(3).isEmpty}")
    val less = two.removed(1)
    println(s"${less.size} ${two.size} ${less.contains(1)} ${two.contains(1)} ${two.removed(9) == two}")

    var up = Map[int, int]()
    var down = Map[int, int]()
    for i in 0..<300
        up = up.updated(i, i * 3)
        down = down.updated(299 - i, (299 - i) * 3)
    println(s"${up == down} ${up.hash() == down.hash()} ${up == down.updated(7, 0)} ${up == down.removed(7)}")
    var same = true
    val a = up.iterator()
    val b = down.iterator()
    while a.hasNext()
        if a.next() != b.next() then same = false
    println(s"$same ${b.hasNext()}")

    val evens = up.filter((k, _) -> k % 2 == 0)
    val halves = up.mapValues(v -> v / 3)
    val swapped = up.map((k, v) -> (v, k))
    println(s"${evens.size} ${evens.contains(3)} ${halves(299)} ${swapped(897)} ${swapped.size}")
    val merged = Map[string, int]().updated("a", 1).updated("b", 2) ++ Map[string, int]().updated("b", 20).updated("c", 30)
    println(s"${merged.size} ${merged("a")} ${merged("b")} ${merged("c")}")
    var visits = 0
    merged.foreach((k, v) -> visits += k.byteLength + v)
    println(visits)

    val dogs = Map[string, Dog]().updated("rex", Dog("Rex")).updated("fido", Dog("Fido"))
    val animals: Map[string, Animal] = dogs
    println(describe(animals.updated("cat", Animal("Tom"))))
    println(describe(dogs))

    val builder = HashMapBuilder[string, int]()
    builder.addOne(("x", 1))
    builder.addAll(merged)
    builder.addOne(("a", 100))
    val built = builder.result()
    println(s"${built.size} ${built("a")} ${built("x")} ${built == merged.updated("x", 1).updated("a", 100)}")
    println(s"${Map[string, Map[int, int]]().updated("m", up) == Map[string, Map[int, int]]().updated("m", down)}")
