// expect: exit 42
// `return` leaves the function from inside loops and branches.

search(limit: int) -> int
    var i = 0
    while i < limit do
        i += 1
        if i * 7 == 42 then return i * 7
    -1

classify(n: int) -> int
    if n > 0
        return 1
    0

main() -> int
    if classify(5) != 1 || classify(-5) != 0 then return 1
    search(100)
