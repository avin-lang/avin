// expect: exit 0
// `export` means an export only at the start of a top-level line before a name; everywhere else it is
// an ordinary name: a function, a parameter, a local, a field and a method.
data Shipment(export: bool)

export(n: int) -> int = n * 2

class Port
    export(s: string) -> string = s + "!"

twice(export: int) -> int = export + export

main()
    println(export(3))
    println(Shipment(true).export)
    println(Port().export("out"))
    val f = (export: int) -> export + 1
    println(f(4))
    println(twice(5))
    val export = "local"
    println(export)
