// expect: exit 0
// `size()` counts the elements of any iterable by traversing it unless the type holds its count, and
// `knownSize()` answers that count only when it needs no traversal, otherwise -1. Sequences have both
// `length()` and `size()`, equal. `sizeCompare(n)` compares the count with `n` reading at most
// `n + 1` elements. A view or an iterator-backed collection reports -1 and is not changed by `size()`.
import avin.collections.mutable.{Map as MutableMap, Set as MutableSet}

// A user collection that implements only `iterator()`: size counts by iteration, knownSize is -1.
class Countdown(private val from: int): Iterable[int]
    override iterator() -> Iterator[int] = CountdownIterator(from)

class CountdownIterator(private var n: int): Iterator[int]
    override hasNext() -> bool = n > 0
    override next() -> int
        n -= 1
        n + 1

// A user collection that keeps its own count.
class Counted(private val n: int): Iterable[int]
    override iterator() -> Iterator[int] = CountdownIterator(n)
    override size -> int = n
    override knownSize -> int = n

// Generic code over Iterable[T].
sizeOf[T](xs: Iterable[T]) -> int = xs.size
knownOf[T](xs: Iterable[T]) -> int = xs.knownSize
cmp[T](xs: Iterable[T], n: int) -> int = xs.sizeCompare(n)

seqs[T](xs: Seq[T]) -> string = s"${xs.length} ${xs.size} ${xs.length == xs.size}"

main()
    // sequences: length == size, empty, one, many
    println(seqs(Vector.empty[int]()))
    println(seqs([1]))
    println(seqs(Vector.tabulate(1000, i -> i)))
    println(seqs(Vector.tabulate(100000, i -> i)))
    println(seqs(List.empty[int]()))
    println(seqs([1, 2, 3]))
    val l: List[int] = [1, 2, 3, 4, 5]
    println(seqs(l))
    println(seqs(Array.fill(0, 0)))
    println(seqs(Array.fill(7, 0)))
    val a: ArraySeq[int] = [1, 2, 3, 4]
    println(seqs(a))
    println(seqs(ArraySeq.empty[int]()))
    println(seqs(0 ..< 0))
    println(seqs(0 ..< 10))
    println(seqs(0 .. 10))
    println(seqs(10 .. 0 by -2))
    val b = Buffer[int]()
    println(seqs(b))
    b.addOne(1)
    println(seqs(b))
    b.addAll(Vector.tabulate(50, i -> i))
    println(seqs(b))
    b.clear()
    println(seqs(b))
    val d = Deque[int]()
    println(seqs(d))
    d.addOne(1)
    d.addOne(2)
    println(seqs(d))
    println(Vector.tabulate(10, i -> i).size)
    println([1, 2, 3].size)

    // knownSize: O(1) types answer the count
    println(Vector.empty[int]().knownSize)
    println(Vector.tabulate(100, i -> i).knownSize)
    println(Array.fill(5, 0).knownSize)
    println(a.knownSize)
    println((0 ..< 10).knownSize)
    println((0 .. 10).knownSize)
    println(b.knownSize)
    println(d.knownSize)
    // a list answers only when it is empty
    println(List.empty[int]().knownSize)
    println(l.knownSize)
    val nil: List[int] = []
    println(nil.knownSize)

    // sets and maps
    val hs = Set(1, 2, 3)
    println(s"${hs.size} ${hs.knownSize}")
    println(s"${Set.empty[int]().size} ${Set.empty[int]().knownSize}")
    val hs2 = hs.incl(4).incl(4).excl(1).excl(99)
    println(s"${hs2.size} ${hs2.knownSize}")
    val hm = Map((1, "a"), (2, "b"))
    println(s"${hm.size} ${hm.knownSize}")
    println(s"${Map[int, int]().size} ${Map[int, int]().knownSize}")
    val hm2 = hm.updated(3, "c").updated(3, "d").removed(1).removed(42)
    println(s"${hm2.size} ${hm2.knownSize}")
    val ts = TreeSet(3, 1, 2, 3)
    println(s"${ts.size} ${ts.knownSize}")
    println(s"${ts.incl(10).size} ${ts.excl(1).excl(2).excl(3).size} ${ts.excl(1).excl(2).excl(3).knownSize}")
    val tm = TreeMap((2, "b"), (1, "a"), (2, "c"))
    println(s"${tm.size} ${tm.knownSize}")
    println(s"${tm.updated(5, "e").size} ${tm.removed(1).removed(2).size}")
    val ms = MutableSet[int]()
    println(s"${ms.size} ${ms.knownSize}")
    ms.add(1)
    ms.add(1)
    ms.add(2)
    println(s"${ms.size} ${ms.knownSize}")
    ms.remove(1)
    ms.remove(77)
    println(s"${ms.size} ${ms.knownSize}")
    ms.clear()
    println(s"${ms.size} ${ms.knownSize}")
    val mm = MutableMap[int, string]()
    println(s"${mm.size} ${mm.knownSize}")
    mm.update(1, "a")
    mm.update(2, "b")
    mm.update(1, "c")
    println(s"${mm.size} ${mm.knownSize}")
    mm.remove(1)
    mm.remove(9)
    println(s"${mm.size} ${mm.knownSize}")
    mm.clear()
    println(s"${mm.size} ${mm.knownSize}")
    for i in 0 ..< 200 do mm.update(i, "x")
    println(s"${mm.size} ${mm.knownSize}")

    // generic code over Iterable[T]
    println(sizeOf([1, 2, 3]))
    println(sizeOf(Vector.empty[int]()))
    println(sizeOf(l))
    println(sizeOf(hs))
    println(sizeOf(hm))
    println(sizeOf(ts))
    println(sizeOf(ms))
    println(sizeOf(mm))
    println(sizeOf(0 ..< 5))
    println(sizeOf(Countdown(4)))
    println(sizeOf(Counted(9)))
    println(sizeOf([1, 2, 3].iterator()))
    println(knownOf([1, 2, 3]))
    println(knownOf(hs))
    println(knownOf(l))
    println(knownOf(Countdown(4)))
    println(knownOf(Counted(9)))
    println(knownOf([1, 2, 3].iterator()))

    // a user class implementing Iterable gets a working size by iteration
    val c = Countdown(5)
    println(s"${c.size} ${c.size} ${c.knownSize}")
    println(Countdown(0).size)
    println(Countdown(1).size)
    println(Countdown(5).isEmpty)
    println(Countdown(0).isEmpty)
    println(Countdown(3).nonEmpty)
    println(Counted(9).size)

    // views and iterators: -1, and size on a view does not change the source
    val v = Vector.tabulate(10, i -> i)
    val it = v.iterator()
    println(it.knownSize)
    println(it.size)
    println(it.size)
    println(v.iterator().map(x -> x * 2).knownSize)
    println(v.view().knownSize)
    println(v.view().filter(x -> x % 2 == 0).size)
    println(v.size)
    val src = Buffer[int]()
    src.addAll([1, 2, 3, 4])
    val lazyView = src.view().map(x -> x + 1)
    println(lazyView.size)
    println(src.size)
    println(src)
    println(lazyView.size)
    println((0 ..< 5).iterator().knownSize)
    println(hs.iterator().knownSize)
    println(hm.iterator().knownSize)
    println(hs.iterator().size)
    println(hm.iterator().size)

    // sizeCompare
    println(cmp(Vector.empty[int](), 0))
    println(cmp(Vector.empty[int](), 1))
    println(cmp([1], 0))
    println(cmp([1], 1))
    println(cmp([1, 2, 3], 2))
    println(cmp([1, 2, 3], 3))
    println(cmp([1, 2, 3], 4))
    println(cmp([1, 2, 3], -1))
    println(cmp(l, 5))
    println(cmp(l, 4))
    println(cmp(l, 6))
    println(cmp(List.empty[int](), 0))
    println(cmp(Countdown(4), 3))
    println(cmp(Countdown(4), 4))
    println(cmp(Countdown(4), 5))
    println(cmp(Countdown(0), 0))
    println(cmp(Countdown(4), -2))
    println(cmp(hs, 3))
    println(cmp(hm, 5))
    println(cmp(0 ..< 100, 99))
    println(cmp([1, 2, 3].iterator(), 3))
    // sizeCompare on an infinite-ish source reads only n + 1 elements
    var read = 0
    val counting = Countdown(1000000).iterator().map(x ->
        read += 1
        x)
    println(counting.sizeCompare(3))
    println(read)
