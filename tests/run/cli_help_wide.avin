// expect: exit 0
// `avin.cli`'s help lines its help texts up in one column of a terminal however wide the names
// before them are: CJK option, argument and command names take two columns a character, an emoji two,
// a combining mark none, and ASCII names line up as they always have.
import avin.cli

main()
  val wide = cli.Parser("道具", "名前の幅を揃える。")
    .positional("ファイル", help = "読むファイル")
    .string("出力", short = '出', help = "書く場所")
    .flag("verbose", short = 'v', help = "say more")
    .string("cafe\u{301}", help = "a name with a combining accent")
    .flag("🚀", help = "an emoji name")
    .flag("👍🏽", help = "an emoji with a skin tone")
  println("-- wide")
  print(wide.help)

  val wideCommands = cli.Parser("tool")
    .flag("詳細", short = '詳', help = "a wide option beside wide commands")
    .command(cli.Parser("追加", "加える"))
    .command(cli.Parser("一覧表示", "the longest name, eight columns"))
    .command(cli.Parser("ab", "two columns"))
    .command(cli.Parser("日本", "four columns"))
  println("-- commands")
  print(wideCommands.help)

  val ascii = cli.Parser("tool", "Copy things.")
    .positional("source", help = "what to copy")
    .flag("verbose", short = 'v', help = "say more")
    .int("jobs", short = 'j', help = "how many at once", default = 4)
  println("-- ascii")
  print(ascii.help)
