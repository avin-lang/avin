// expect: exit 0
// A placeholder lambda stands in any place whose value is the function expected: each branch of an
// `if`, each arm of a `match` and the last line of a block, when the `if`, `match` or block is a
// call's argument, a declared value or the body of a function with a declared result. Nested
// branches, two `_`s, generic and aliased function types, clauses, closures and many lambdas made in
// a loop.

data Request(method: string, path: string, status: int)

type Handler = (Request) -> string

// A function's declared result gives its body's placeholders their types.
adder(n: int) -> (int) -> int = _ + n

// Each clause's body, guarded or not, is a place of its own.
op(name: string) -> (int, int) -> int
op("+") = _ + _
op("*") = _ * _
op(_) = _ - _

scaler(n: int) -> (int) -> int
scaler(n)
  | n < 0 = _ * -1
  | n == 0 = _ -> 0
  | _ = _ * n

// A generic function type: a branch may be a placeholder or a written lambda.
wrap[T](keep: bool) -> (T) -> Option[T] = if keep then Some(_) else _ -> None

// An aliased function type, through a `match` whose arms nest another `match`.
keyOf(by: string, short: bool) -> Handler = by match
  "method" -> _.method
  "status" -> short match
    true -> _.status.toString()
    false -> "status " + _.status.toString()
  _ -> _.path

// The body is a block, and its last line is the place.
twice(n: int) -> (int) -> int
  val k = n * 2
  _ * k

applyAll(fs: Vector[(int) -> int], x: int) -> Vector[int] = fs.map(f -> f(x))

main() -> int
  val requests = [Request("GET", "/a", 200), Request("POST", "/b", 404), Request("GET", "/c", 500)]
  for by in ["method", "status", "path"]
    val key: (Request) -> string = by match
      "method" -> _.method
      "status" -> _.status.toString()
      _ -> _.path
    println(s"$by: ${requests.map(key)}")
  println(requests.map(keyOf("status", false)))
  println(requests.map(keyOf("status", true)))
  println(requests.map(keyOf("other", true)))

  // `if` and `elif` branches, in a declared value and in a call's argument.
  for mode in 0 ..< 3
    val f: (int) -> int = if mode == 0 then _ + 1 elif mode == 1 then _ * 10 else _ - 1
    println(s"mode $mode: ${[1, 2, 3].map(f)}")
  for up in [true, false]
    println([1, 2, 3].map(if up then _ + 1 else _ - 1))

  // Two `_`s in each branch; a function of a tuple takes the pair apart.
  for add in [true, false]
    val g: (int, int) -> int = if add then _ + _ else _ * _
    println(g(3, 4))
    println([(1, 2), (3, 4)].map(if add then _ + _ else _ * _))

  // Comparison patterns, a guard and a written lambda beside placeholder arms; an arm's block
  // yields its last line.
  for n in [-2, 0, 5, 50, 51]
    val h: (int) -> string = n match
      m < 0 -> "neg " + _.toString()
      0 -> _ -> "zero"
      m < 10 ->
        val tag = s"small$m"
        tag + ":" + _.toString()
      m if m % 2 == 0 -> "even " + (_ + m).toString()
      _ -> _.toString()
    println(h(7))

  // A declared value whose block yields a placeholder on its last line.
  val bump: (int) -> int =
    val step = 5
    _ + step
  println(bump(1))

  println(adder(10)(5))
  println(s"${op("+")(6, 3)} ${op("*")(6, 3)} ${op("-")(6, 3)}")
  println(s"${scaler(-1)(4)} ${scaler(0)(4)} ${scaler(3)(4)}")
  println(s"${wrap[int](true)(4)} ${wrap[string](false)("x")}")
  println(twice(3)(2))

  // Closures made in a loop, each capturing its own value, read after many allocations.
  var fs: Vector[(int) -> int] = []
  for i in 0 ..< 200
    val f: (int) -> int = if i % 2 == 0 then _ + i else _ - i
    fs = fs :+ f
  var junk: Vector[string] = []
  for i in 0 ..< 2000
    junk = junk :+ i.toString()
  val results = applyAll(fs, 1000)
  println(s"${results(0)} ${results(1)} ${results(198)} ${results(199)} ${junk.length}")
  0
