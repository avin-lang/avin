// expect: exit 0
// The reference a union holds stays alive, and the collector never takes the bits of a scalar member
// for a reference: unions holding strings made as the program runs are kept in locals, parameters and
// results across allocations, and in the cells an object, a vector, a map and a closure keep, while
// every allocation collects (the corpus runs this under GC stress).

data Holder(label: string, value: int | string)

class Box(var current: real | string)

made(i: int) -> int | string = if i % 3 == 0 then s"s$i" else i * 7

// The union parameter is live across the allocations of the loop.
churn(u: int | string, rounds: int) -> int | string
    var junk: Vector[string] = []
    for i in 0..<rounds
        junk = junk :+ s"junk $i"
    u

// A union result made from a string allocated after the parameter was read.
rebuild(u: int | string) -> int | string = u match
    n: int -> if n % 2 == 0 then s"even $n" else n
    s: string -> s + "!"

check(u: int | string) -> long = u match
    n: int -> long(n)
    s: string -> long(s.byteLength())

main()
    var total: long = 0
    var kept: Vector[int | string] = []
    var holders: Vector[Holder] = []
    var table: Map[int, long | string] = {}
    val box = Box(0.5)
    var closures: Vector[() -> int | string] = []
    for i in 0..<120
        val u = made(i)
        val v = churn(rebuild(u), 3)
        total += check(v)
        kept = kept :+ v
        holders = holders :+ Holder(s"h$i", u)
        table = table.updated(i, if i % 2 == 0 then long(i) else s"t$i")
        box.current = if i % 4 == 0 then s"box $i" else real(i)
        val captured: int | string = v
        closures = closures :+ (() -> captured)
    println(total)
    var again: long = 0
    for v in kept do again += check(v)
    println(again)
    var labels = 0
    for h in holders
        labels += h.label.byteLength()
        again += check(h.value)
    println(s"$labels $again")
    var tableBytes: long = 0
    for i in 0..<120
        table.get(i) match
            Some(l: long) -> tableBytes += l
            Some(s: string) -> tableBytes += long(s.byteLength())
            None -> ()
    println(tableBytes)
    println(box.current)
    var fromClosures: long = 0
    for f in closures do fromClosures += check(f())
    println(fromClosures)
