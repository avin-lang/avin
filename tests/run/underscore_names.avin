// expect: exit 0
// `_` names nothing: any number of lambda, function and method parameters, locals, destructured
// components and loop variables may be `_`, and none of them clashes or can be read.

pick(_: int, y: int, _: int) -> int = y

class Counter(val start: int)
  second(_: int, y: int) -> int = y + start

firstOf(f: (int, int) -> int) -> int = f(1, 2)

pair() -> (int, string) = (7, "seven")

main() -> int
  println(s"${firstOf((_, _) -> 5)}")
  println(s"${firstOf((_: int, _: int) -> 6)}")
  println(s"${firstOf((a, _) -> a)}")
  println(s"${pick(1, 2, 3)}")
  println(s"${Counter(10).second(0, 1)}")
  val _ = println("evaluated")
  val _ = println("evaluated again")
  val (_, _) = pair()
  val (n, _) = pair()
  println(s"$n")
  var total = 0
  for _ in 0 ..< 3
    total += 1
  println(s"$total")
  val f = (_: int, _: int) -> true
  println(s"${f(1, 2)}")
  0
