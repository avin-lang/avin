// expect: trap
// A byte read from a closed mapping traps, naming the `MappedBytes`, rather than reading memory that
// is no longer mapped.
import avin.fs

main()
  val dir = fs.createTempDir("avin-mapped-trap").toOption.get
  _ = fs.writeText(dir + "/a", "abc")
  val m = fs.mapFile(dir + "/a").toOption.get
  _ = fs.removeDirAll(dir)
  println(m(0))
  _ = m.close()
  println(m(0))
