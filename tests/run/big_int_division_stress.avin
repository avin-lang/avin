// expect: exit 0
// Long division checked against its definition on thousands of many-limb numbers: `q * b + r == a`,
// `r` smaller than `b` in magnitude and of `a`'s sign. The limbs are drawn mostly from the values
// that make a quotient limb's estimate come out too large: zero, one, the largest limb and half the
// base, beside arbitrary ones. Products and sums are checked by undoing them.

var seed: long = 12345

// The next number of a fixed pseudo-random sequence, from 0 up to `n`.
next(n: long) -> long
    seed = (seed *% 6364136223846793005 +% 1442695040888963407)
    val x = (seed >> 33) % n
    if x < 0 then -x else x

limb() -> long = next(6) match
    0 -> 0
    1 -> 1
    2 -> 999999999
    3 -> 500000000
    4 -> 499999999
    _ -> next(1000000000)

// A number of `limbs` limbs of nine digits each, the top one not zero, of either sign.
number(limbs: int) -> BigInt
    val base = BigInt(1000000000)
    var x = BigInt(next(999999999) + 1)
    for _ in 1 ..< limbs do x = x * base + BigInt(limb())
    if next(2) == 0 then -x else x

main()
    var checked = 0
    var wrong = 0
    for round in 0 ..< 3000
        val a = number(int(next(12)) + 1)
        val b = number(int(next(7)) + 1)
        val (q, r) = a.divRem(b)
        val ok = q * b + r == a && r.abs < b.abs && (r.isZero || r.sign == a.sign)
            && q == a / b && r == a % b
            && (a * b) / b == a && (a * b) % b == BigInt.zero() && (a + b) - b == a && (a - b) + b == a
        checked += 1
        if !ok
            wrong += 1
            println(s"wrong: $a / $b")
    println(s"checked $checked, wrong $wrong")
    // Divisors whose top limb is the largest and the smallest a limb can be, and a dividend that is
    // the divisor's square less one.
    for b in [BigInt("999999999999999999999999999"), BigInt("1000000000000000000000000001"),
            BigInt("1000000000000000000"), BigInt("500000000000000000000000000")]
        val a = b * b - BigInt.one()
        val (q, r) = a.divRem(b)
        println(s"$q $r ${q * b + r == a}")
