// expect: exit 0
// `identity` gives back what it is given, at every type: scalars at their bounds, strings, data and
// class values (the same object), tuples, options, functions; and it is a function value wherever
// one is expected.

data Point(x: int, y: int)

class Counter(var n: int)

main()
    println(identity(-2147483648), identity(2147483647), identity[long](-9223372036854775808))
    println(identity(0.5), identity('é'), identity(true), identity(()))
    println(s"[${identity("")}]", identity("ünïcode ✓"))
    println(identity(Point(1, 2)))
    val c = Counter(1)
    println(identity(c) === c)
    identity(c).n = 5
    println(c.n)
    println(identity((1, "one")), identity(Some(Some(3))), identity[Option[int]](None))
    val f = identity((x: int) -> x + 1)
    println(f(1))
    println(identity(identity(identity(4))))
    // As a function value.
    println([1, 2, 3].map(identity))
    println(["a", "b"].map(identity[string]))
    val id: (Point) -> Point = identity
    println(id(Point(3, 4)))
    println(Some(5).fold(0, identity))
    println([[1], [2, 3]].flatMap(identity))
    // Many objects through it, so a collection runs while values pass.
    var total = 0
    for i in 0..<5000
        total += identity(s"$i").charCount()
    println(total)
