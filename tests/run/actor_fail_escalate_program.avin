// expect: trap
// A failure escalated from the leaf of a tree three deep, through a parent that escalates too, to a
// top-level actor that escalates, stops the program: the trap is reported once, at the leaf, and
// no actor's `stopping` block or later message runs.
import avin.actors.spawn
import avin.threads.Channel

actor Leaf(ready: Channel[int]) receives int
    ready.send(1)
    receive
        n ->
            println(s"leaf got $n")
            val xs = Vector(1, 2, 3)
            println(xs(n))
    stopping
        println("leaf stopping")

actor Mid(ready: Channel[int]) receives int
    val leaf = spawn(Leaf(ready))
    receive
        n -> leaf.tell(n)
    stopping
        println("mid stopping")

actor Root(ready: Channel[int]) receives int
    val mid = spawn(Mid(ready))
    receive
        n -> mid.tell(n)
    stopping
        println("root stopping")

main()
    val ready = Channel[int]()
    val root = spawn(Root(ready))
    ready.receive()
    root.tell(1)
    root.tell(-1)
    root.ended().await()
    println("not reached")
