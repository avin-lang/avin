// `fs.rename`: a file or directory moved in one step, replacing what is at the destination, and
// each failure an `IoError` value.
import avin.fs
import avin.io.{IoError, NotFound, DirectoryNotEmpty, NotADirectory, IsADirectory}

// The temporary directory the test works in, written as `DIR` in what it prints, which an error
// names, so the output is the same on every run.
var root = ""

say(line: Any)
    println(if root == "" then s"$line" else s"$line".replace(root, "DIR"))

main()
    val dir = fs.createTempDir("avin-fs-rename") match
        Ok(d) -> d
        Err(e) ->
            say(s"no directory: $e")
            return
    root = dir
    // A file moves: the old name is gone and the contents are the same.
    fs.writeText(dir + "/a", "alpha")
    say(fs.rename(dir + "/a", dir + "/b"))
    say(s"${fs.exists(dir + "/a")} ${fs.readText(dir + "/b")}")
    // An existing file at the destination is replaced.
    fs.writeText(dir + "/old", "old contents, longer than the new")
    fs.writeText(dir + "/new", "new")
    say(fs.rename(dir + "/new", dir + "/old"))
    say(s"${fs.exists(dir + "/new")} ${fs.readText(dir + "/old")}")
    // The atomic-write pattern: write beside, then rename over.
    fs.writeText(dir + "/state.json", "{\"v\":1}")
    fs.writeText(dir + "/state.json.new", "{\"v\":2}")
    say(fs.rename(dir + "/state.json.new", dir + "/state.json"))
    say(s"${fs.readText(dir + "/state.json")} ${fs.exists(dir + "/state.json.new")}")
    // An empty file moves, and bytes survive.
    fs.writeText(dir + "/empty", "")
    say(fs.rename(dir + "/empty", dir + "/empty2"))
    say(s"${fs.readBytes(dir + "/empty2")}")
    val all = Array.tabulate(256, (i) -> byte(i))
    fs.writeBytes(dir + "/all", all)
    fs.rename(dir + "/all", dir + "/all2")
    fs.readBytes(dir + "/all2") match
        Ok(b) -> say(b == all)
        Err(e) -> say(s"$e")
    // A directory moves with what it holds.
    fs.createDir(dir + "/d1")
    fs.writeText(dir + "/d1/inner", "inside")
    say(fs.rename(dir + "/d1", dir + "/d2"))
    say(s"${fs.exists(dir + "/d1")} ${fs.isDir(dir + "/d2")} ${fs.readText(dir + "/d2/inner")}")
    // An empty directory at the destination is replaced by a directory.
    fs.createDir(dir + "/e1")
    fs.writeText(dir + "/e1/x", "x")
    fs.createDir(dir + "/e2")
    say(fs.rename(dir + "/e1", dir + "/e2"))
    say(fs.readText(dir + "/e2/x"))
    // A directory that holds entries is not replaced.
    fs.createDir(dir + "/f1")
    fs.createDir(dir + "/f2")
    fs.writeText(dir + "/f2/keep", "keep")
    fs.rename(dir + "/f1", dir + "/f2") match
        Err(IoError(DirectoryNotEmpty, _, _)) -> say("directory not empty")
        other -> say(s"unexpected $other")
    say(s"${fs.isDir(dir + "/f1")} ${fs.readText(dir + "/f2/keep")}")
    // A file onto a directory, and a directory onto a file, are refused and move nothing.
    fs.writeText(dir + "/plain", "plain")
    fs.createDir(dir + "/adir")
    fs.rename(dir + "/plain", dir + "/adir") match
        Err(IoError(IsADirectory, _, _)) -> say("is a directory")
        other -> say(s"unexpected $other")
    fs.rename(dir + "/adir", dir + "/plain") match
        Err(IoError(NotADirectory, _, _)) -> say("not a directory")
        other -> say(s"unexpected $other")
    say(s"${fs.readText(dir + "/plain")} ${fs.isDir(dir + "/adir")}")
    // A missing source.
    fs.rename(dir + "/missing", dir + "/target") match
        Err(IoError(NotFound, _, _)) -> say("not found")
        other -> say(s"unexpected $other")
    say(fs.exists(dir + "/target"))
    // A destination in a missing directory leaves the source where it was.
    fs.writeText(dir + "/src", "src")
    fs.rename(dir + "/src", dir + "/no/such/dir/dst") match
        Err(IoError(NotFound, _, _)) -> say("not found")
        other -> say(s"unexpected $other")
    say(s"${fs.readText(dir + "/src")} ${fs.exists(dir + "/no")}")
    // A destination under a file.
    fs.rename(dir + "/src", dir + "/plain/under") match
        Err(IoError(NotADirectory, _, _)) -> say("not a directory")
        other -> say(s"unexpected $other")
    // The same path changes nothing and succeeds.
    say(fs.rename(dir + "/src", dir + "/src"))
    say(fs.readText(dir + "/src"))
    // Unicode names, source and destination.
    fs.writeText(dir + "/wörld ✓", "uni")
    say(fs.rename(dir + "/wörld ✓", dir + "/日本語 🎉"))
    say(s"${fs.exists(dir + "/wörld ✓")} ${fs.readText(dir + "/日本語 🎉")}")
    // The error's message.
    fs.rename(dir + "/missing", dir + "/x") match
        Err(e) -> say(e.message)
        other -> say(s"unexpected $other")
    fs.rename(dir + "/f1", dir + "/f2") match
        Err(e) -> say(e.message)
        other -> say(s"unexpected $other")
    // A name moved there and back.
    say(fs.rename(dir + "/src", dir + "/src2"))
    say(fs.rename(dir + "/src2", dir + "/src"))
    say(fs.readText(dir + "/src"))
    say(s"${fs.removeDirAll(dir)} ${fs.exists(dir)}")
