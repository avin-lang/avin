// expect: exit 0
// A closure that captures a local `lazy val` shares it with the code around it: whichever reads it
// first computes it, once, and the other sees the value kept. A closure never called never computes
// it, and one called twice computes it once. A lazy value declared in a loop body is a fresh one on
// each pass, and a closure keeps the one of its own pass after the loop goes on.
var runs = 0

count(label: string, value: int) -> int
  runs += 1
  println(s"computing $label")
  value

// The closure outlives the function that declared the value, and still computes it on its first call.
later() -> () -> int
  lazy val kept = count("kept", 3)
  () -> kept * 100

// A local function reads the value as a closure does.
viaLocal() -> int
  lazy val shared = count("shared", 9)
  twice() -> int = shared + shared
  twice() + shared

main()
  lazy val unused = count("unused", 1)
  val neverCalled = () -> unused
  println("made a closure that is never called")

  lazy val inClosure = count("in closure", 2)
  val read = () -> inClosure + 1
  println(read())
  println(read())
  println(inClosure)

  lazy val outsideFirst = count("outside first", 5)
  println(outsideFirst)
  val readAfter = () -> outsideFirst * 2
  println(readAfter())

  val f = later()
  println("later() returned")
  println(f())
  println(f())

  println(viaLocal())

  var made: Vector[() -> int] = []
  for i in 0 ..< 3
    lazy val each = count(s"pass $i", i * 10)
    made = made :+ (() -> each + 1)
  println(made(2)())
  println(made(0)())
  println(made(2)())

  // Two closures over one value: the second sees what the first computed.
  lazy val pair = count("pair", 7)
  val one = () -> pair
  val two = () -> pair * 3
  println(two())
  println(one())

  // Nested closures reach it through the closure around them.
  lazy val deep = count("deep", 4)
  val outer = () -> (() -> deep + 1)
  println(outer()())
  println(deep)

  println(runs)
