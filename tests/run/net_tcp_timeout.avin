// expect: exit 0
// A `TcpStream`'s `timeout` is the limit `setTimeout` set, kept in whole milliseconds with a part of
// one counting as one, and zero where there is none: before any is set, after zero, and after a
// negative duration.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.threads.spawn
import avin.time.{Duration, micros, millis, seconds}

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

main()
  val l = ok(TcpListener.bind("127.0.0.1", 0))
  val port = l.port()
  val accepting = spawn(() -> ok(l.accept()))
  val c = ok(TcpStream.connect("127.0.0.1", port))
  val s = accepting.join()
  println("none set", c.timeout.micros)
  ok(c.setTimeout(millis(300)))
  println("300 ms", c.timeout.micros)
  ok(c.setTimeout(micros(1500)))
  println("1500 us", c.timeout.micros)
  ok(c.setTimeout(micros(1)))
  println("1 us", c.timeout.micros)
  ok(c.setTimeout(seconds(2)))
  println("2 s", c.timeout.micros)
  ok(c.setTimeout(Duration.Zero))
  println("zero", c.timeout.micros)
  ok(c.setTimeout(millis(5)))
  ok(c.setTimeout(millis(-5)))
  println("negative", c.timeout.micros)
  println("the other end's own", s.timeout.micros)
  ok(c.close())
  ok(s.close())
  _ = l.close()
