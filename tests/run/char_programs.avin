// Characters across the whole range: conversion to and from integers of several widths, patterns,
// comparisons including chains, and their debug form.

identity[T](x: T) -> T = x

choose(flag: bool) = if flag then 'a' else '🌍'

classify(c: char) -> int = c match
  'a' -> 1
  '🌍' -> 2
  '\0' -> 3
  else 0

show(c: char)
  println(int(c), i8.wrap(c), i257(c), classify(c), identity(c) == c)

compare(a: char, b: char)
  println(a == b, a != b, a < b, a <= b, a > b, a >= b, '\0' <= a <= b)

main()
  for code in [0, 9, 10, 39, 65, 92, 233, 55295, 57344, 65535, 65536, 127757, 1114111]
    show(char(code))
  compare('a', 'a')
  compare('a', 'é')
  compare('🌍', 'a')
  compare('\0', '\u{10FFFF}')
  compare('\u{D7FF}', '\u{E000}')
  var letter: char = 'a'
  letter = 'é'
  println(letter)
  println(int(char(i17(65535))), char(i8(65)), int(char(i1(0))), char(i257(127757)))
  println(choose(true), choose(false))
  println(debug('a'), debug('🌍'), debug('\n'))
