// expect: exit 0
// env: AVIN_GC_STRESS=0
// Thirty thousand short threads, each sending one value on a channel and ending, while the main thread
// receives: senders park on the bounded channel and wake on other workers, and the stacks of the ones
// that have ended are handed to the ones still being started.
import avin.threads.{Channel, scope}

main() -> int
  val bounded = Channel[int](8)
  var total = 0
  scope(s ->
    for i in 0 ..< 30000
      s.spawn(() -> bounded.send(i % 10))
      if i % 100 == 99
        for _ in 0 ..< 100 do total += bounded.receive().getOrElse(0))
  println(total)
  val unbounded = Channel[int]()
  scope(s ->
    for i in 0 ..< 20000
      s.spawn(() -> unbounded.send(1)))
  unbounded.close()
  var count = 0
  for x in unbounded do count += x
  println(count)
  0
