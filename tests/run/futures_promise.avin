// expect: exit 0
// A promise is completed from another thread, and every thread waiting on its future wakes with the
// value; `tryComplete` answers whether it completed it, so only the first of several racing threads
// does.
import avin.threads.{Atomic, Promise, scope, spawn}

main() -> int
    val reply = Promise[string]()
    val waiters = (0..<4).map(i -> spawn(() -> s"waiter $i got ${reply.future.await()}")).toVector
    val sender = spawn(() -> reply.complete(s"the ${"answer"}"))
    sender.join()
    for w in waiters do println(w.join())
    println(s"completed ${reply.isCompleted()}")
    val race = Promise[int]()
    val winners = Atomic(0)
    scope(s ->
        for i in 0..<8
            s.spawn(() ->
                if race.tryComplete(i) then winners.add(1)
                ()))
    println(s"winners ${winners.load()}, value in range ${race.future.await() < 8}")
    println(s"late try ${race.tryComplete(99)} ${race.future.await() != 99}")
    0
