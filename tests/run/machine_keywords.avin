// expect: exit 0
// `machine`, `receives`, `state`, `receive`, `enter`, `leave` and `stay` are keywords only where a
// machine's declaration uses them, so everywhere else they are ordinary names: a function called
// `machine`, a variable called `state`, a pattern binding `stay`, and, inside a machine's body, a
// field called `receive` and a method reading `state()`.
machine(n: int) -> int = n * 2

machine Switch receives bool
    var receive = 0
    var enter = "e"
    var leave = "l"

    state Off
        true -> On
        false ->
            receive += 1
            stay

    state On
        stay -> if stay then Off else stay

    named() -> string = state() match
        Off -> s"off $enter"
        On -> s"on $leave"

main() -> int
    val state = machine(21)
    println(state)
    val stay = Vector(1, 2)
    println(stay)
    var receives = 3
    receives += 1
    println(receives)
    val s = Switch()
    s.handle(false)
    s.handle(false)
    println(s.named())
    s.handle(true)
    println(s.named())
    s.handle(false)
    println(s.named())
    s.handle(true)
    println(s.named())
    println(s.receive)
    0
