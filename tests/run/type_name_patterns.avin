// expect: exit 0
// A name in a pattern that is no variant but names a type is that type's pattern: `a is Dog` tests
// for a `Dog`, as `_: Dog` does, for a class, a trait, an object, a data type, an alias and a type
// parameter alike. A variant's name still matches the variant.

trait Pet
  name() -> string

open class Animal(val legs: int)

class Dog(): Animal(4), Pet
  override name() -> string = "dog"

class Bird(): Animal(2)

object Origin

data Shape
  Circle(r: int)
  Square(side: int)

data Cell(value: int)

type Creature = Animal

kind(x: Any) -> string = x match
  Dog -> "dog"
  Pet -> "some other pet"
  Animal -> "some other animal"
  Origin -> "the origin"
  Shape -> "a shape"
  _: Cell -> "a cell"
  _ -> "other"

// A variant's name is the variant, never the type: `Circle` alone matches the variant.
shapeKind(s: Shape) -> string = s match
  Circle -> "circle"
  Square -> "square"

legs(a: Animal) -> int = a match
  Bird -> 2
  _ -> a.legs

// An alias names the type it stands for.
isCreature(x: Any) -> bool = x is Creature

// A type parameter's name tests for the type the function is called at.
same[T](x: T, y: Any) -> bool = y is T

// A union's members by their names, together covering it.
member(v: Dog | Cell) -> string = v match
  Dog -> "dog"
  Cell -> "cell"

// `_: Dog | Bird` is two alternatives, each a type's name.
flies(a: Animal) -> bool = a match
  _: Bird | Dog -> a is Bird
  _ -> false

main()
  val things: Vector[Any] = [Dog(), Bird(), Origin, Cell(1), Circle(2), "s"]
  for t in things do println(kind(t))
  println(shapeKind(Circle(1)), shapeKind(Square(2)))
  println(legs(Bird()), legs(Dog()))
  println(isCreature(Dog()), isCreature("no"))
  println(same(1, 2), same(1, "two"), same("a", "b"))
  println(member(Dog()), member(Cell(3)))
  println(flies(Bird()), flies(Dog()))
  val pet: Any = Dog()
  println(pet is Pet, pet is not Bird, pet is Animal && pet is Dog)
  // `Cell` names its own variant too, and the variant wins: on a `Cell` it matches every value.
  val o: Option[Any] = Some(Dog())
  println(o is Some(Dog), o is Some(Bird))
  val c = Cell(5)
  println(c is Cell, c is Cell(5), c is Cell(6))
