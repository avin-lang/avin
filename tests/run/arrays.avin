// Arrays of every kind of element: each element is stored at its type's own width, read with
// `a(i)`, replaced with `a(i) = v` and its compound forms, and an array is a reference with
// identity, so a copy is a new array.

class Dog(val name: string)

data Point(x: int, y: int)

main()
    val ints = Array.fill(5, 0)
    ints(2) = 7
    ints(3) += 4
    ints(4)++
    println(s"${ints(0)} ${ints(2)} ${ints(3)} ${ints(4)} ${ints.length()}")
    println(s"${ints(1) := 9} ${ints(1)} ${ints(4)--} ${ints(4)} ${++ints(4)}")

    val reals = Array.fill(2, 1.5)
    reals(1) *= 3.0
    println(s"${reals(0) + reals(1)}")

    val flags = Array.fill(3, true)
    flags(1) = false
    println(s"${flags(0)} ${flags(1)} ${flags(2)}")

    val bytes = Array.fill(4, byte(200))
    bytes(3) = byte(7)
    println(s"${bytes(0)} ${bytes(3)}")

    val longs = Array.tabulate(3, i -> long(i) * 5000000000)
    println(s"${longs(2)}")

    val chars = Array.tabulate(3, i -> char(97 + i))
    println(s"${chars(0)}${chars(1)}${chars(2)}")

    val words = Array.tabulate(3, i -> s"w$i")
    words(0) = words(2) + "!"
    println(s"${words(0)} ${words(1)}")

    val dogs = Array.tabulate(2, i -> Dog(s"dog$i"))
    println(s"${dogs(0).name} ${dogs(1).name}")

    val points = Array.tabulate(3, i -> Point(i, i * 10))
    points(0) = Point(5, 50)
    println(s"${points(0).x} ${points(2).y}")

    val units = Array.fill(3, ())
    units(1) = ()
    println(s"units ${units.length()}")

    val squares = Array.tabulate(5, i -> i * i)
    val middle = squares.slice(1, 4)
    println(s"${middle.length()} ${middle(0)} ${middle(2)} ${squares.slice(2, 2).length()}")
    val copy = squares.copy()
    copy(0) = 100
    println(s"${squares(0)} ${copy(0)} ${copy === squares} ${squares === squares}")

    println(s"${squares.get(4).getOrElse(0)} ${squares.get(5).isEmpty()} ${squares.get(-1).isEmpty()}")
    val none = Array.empty[string]()
    println(s"${none.length()} ${none.isEmpty()} ${squares.nonEmpty()}")

    // An array of arrays, and a function value of an element operation.
    val grid = Array.tabulate(3, r -> Array.tabulate(3, c -> r * 3 + c))
    grid(1)(1) = 0
    println(s"${grid(1)(1)} ${grid(2)(0)}")
    val read = squares.apply
    println(s"${read(3)}")
