// expect: trap
// A field's `lazy val` whose initializer hands a lambda reading the value to a method that calls it
// at once is not a compile-time cycle, since the rule does not follow a function the code only
// makes. Run on a thread other than the main one, the read made while the value is being
// initialized traps on that thread, naming the value, rather than wait for itself.
import avin.threads.scope

class Graph(seed: int)
  lazy val first: int = apply(() -> first + seed)

  apply(f: () -> int) -> int = f()

main() -> int
  println("before")
  val g = Graph(1)
  scope(s -> s.spawn(() -> println(g.first)))
  println("after")
  0
