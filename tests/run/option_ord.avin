// expect: exit 0
// `Option[T]` is `Ord` when `T` is: `None` orders before every `Some`, and two `Some`s as their values.
// Covers the pairs, nesting, ordered data and derived-Ord fields, sorting, extremes, and generic use.

data Point(x: int, y: int) derives Ord

data Entry(name: string, rank: Option[int]) derives Ord

data Tagged[T](tag: Option[T]) derives Ord

smaller[T: Ord](a: T, b: T) -> T = if a.compare(b) <= 0 then a else b

sign(n: int) -> int = if n < 0 then -1 else if n > 0 then 1 else 0

main()
    val none: Option[int] = None
    val one: Option[int] = Some(1)
    val two: Option[int] = Some(2)
    val negative: Option[int] = Some(-5)
    val low: Option[int] = Some(-2147483647 - 1)

    // None against Some, Some against Some, None against None.
    println(s"${sign(none.compare(one))} ${sign(one.compare(none))} ${sign(none.compare(none))}")
    println(s"${sign(one.compare(two))} ${sign(two.compare(one))} ${sign(two.compare(two))}")
    println(s"${none < low} ${none < negative} ${low < negative} ${one >= one} ${none > one}")
    println(s"${none <= none} ${none >= none} ${two > one} ${one <= two}")

    // Nested options: None, Some(None), Some(Some(n)) in that order.
    val outerNone: Option[Option[int]] = None
    val innerNone: Option[Option[int]] = Some(None)
    val innerOne: Option[Option[int]] = Some(Some(1))
    val innerTwo: Option[Option[int]] = Some(Some(2))
    println(s"${outerNone < innerNone} ${innerNone < innerOne} ${innerOne < innerTwo} ${innerTwo > outerNone}")
    println(s"${sign(innerNone.compare(innerNone))} ${sign(innerTwo.compare(innerOne))}")
    val nested: Vector[Option[Option[int]]] = [innerTwo, outerNone, innerOne, innerNone]
    println(nested.sorted())

    // Options of data types that derive Ord.
    val p1: Option[Point] = Some(Point(1, 5))
    val p2: Option[Point] = Some(Point(2, 0))
    val p3: Option[Point] = Some(Point(1, 6))
    val noPoint: Option[Point] = None
    println(s"${p1 < p2} ${p1 < p3} ${noPoint < p1} ${p3 < p2}")
    println(Vector(p2, noPoint, p3, p1).sorted())

    // Options of strings, chars, reals.
    val s1: Option[string] = Some("apple")
    val s2: Option[string] = Some("banana")
    val noString: Option[string] = None
    println(s"${s1 < s2} ${noString < s1} ${Some("") > noString}")
    val noReal: Option[real] = None
    println(s"${Some('a') < Some('b')} ${Some(1.5) < Some(2.5)} ${noReal < Some(1.5)}")

    // A derived Ord with an Option field: the first differing field decides, None before Some.
    val e1 = Entry("a", None)
    val e2 = Entry("a", Some(0))
    val e3 = Entry("a", Some(1))
    val e4 = Entry("b", None)
    println(s"${e1 < e2} ${e2 < e3} ${e3 < e4} ${e1 < e4} ${sign(e2.compare(e2))}")
    println(Vector(e4, e3, e2, e1).sorted())
    val t1 = Tagged[int](None)
    val t2 = Tagged[int](Some(3))
    println(s"${t1 < t2} ${t2 < t1} ${sign(t1.compare(t1))}")

    // Sorting, in both directions and with duplicates.
    val mixed: Vector[Option[int]] = [two, none, one, negative, none, two]
    println(mixed.sorted())
    println(mixed.sortWith((a, b) -> b.compare(a)))
    println(mixed.toList.sorted())
    val empty: Vector[Option[int]] = []
    println(empty.sorted())
    println(Vector[Option[int]](none).sorted())
    println(mixed.sortBy(o -> o))

    // Extremes: max, min, and the Option-valued ones.
    println(s"${mixed.max} ${mixed.min}")
    println(s"${mixed.maxOption} ${mixed.minOption}")
    println(s"${empty.maxOption} ${empty.minOption}")
    println(s"${max(none, one, two)} ${min(none, one, two)} ${max(none, none)} ${min(one, two)}")
    println(mixed.maxBy(o -> o))

    // Through a generic function bounded by Ord.
    println(s"${smaller(none, one)} ${smaller(two, one)} ${smaller(low, negative)}")
    println(smaller(innerNone, innerOne))
    println(smaller(p1, p3))

    // Options as keys of an ordered set and map.
    val set = TreeSet(two, none, one, none)
    println(set.toList)
    val map = TreeMap((two, "two"), (none, "none"), (one, "one"))
    println(map.toList)
