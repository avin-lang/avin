// `Debug` is a value's diagnostic form, and `debug(x)` renders it as a string: a string and a `char`
// are written as the literals that make them, quoted and escaped; the other built-in types as they
// display.

class Token(val kind: string, val text: string): Debug
  override debug(out: Writer, spec: FormatSpec)
    out.write(kind)
    out.write("(")
    text.debug(out, spec)
    out.write(")")

// A type may implement both forms, each its own way.
data Name(value: string)

impl Display for Name
  display(out: Writer, spec: FormatSpec) = out.write(value)

// Inside an implementation of `Debug`, the bare name `debug` is the method, so a part is written
// through its own `debug` method.
impl Debug for Name
  debug(out: Writer, spec: FormatSpec)
    out.write("Name(")
    value.debug(out, spec)
    out.write(")")

// Generic code reaches the form through a bound.
both[T: Display & Debug](x: T) -> string = s"$x / ${debug(x)}"

main()
  println(debug("plain"))
  println(debug("quote \" and backslash \\"))
  println(debug("line\nbreak\ttab\r\u{1}"))
  println(debug("ünïcode"))
  println(debug(""))
  println(debug('a'))
  println(debug('\''))
  println(debug('\n'))
  println(debug(42))
  println(debug(long(-9)))
  println(debug(1.25))
  println(debug(true))
  println(debug(()))
  println(debug(byte(7)))
  println(debug(Token("word", "say \"hi\"")))
  println(debug(Name("Ann")))
  println(both(Name("Bo")))
  println(both("text"))
  println(both(3))
  val out = StringWriter()
  "padded".debug(out, FormatSpec(12))
  println(out.text + "|")
