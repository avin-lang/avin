// expect: exit 0
// A type with refined variants derives as any data type does, each copy of the derived code compiled
// for the variants possible at its instance: `Ord` compares by variant position, then by fields, at
// each instance, through a variant's own parameters read back from the instance.

data Expr[T] derives Ord
  IntLit(value: int) -> Expr[int]
  StrLit(value: string) -> Expr[string]
  Neg(e: Expr[int]) -> Expr[int]
  Pair[A, B](first: Expr[A], second: Expr[B]) -> Expr[(A, B)]

main()
  println(IntLit(1) < IntLit(2))
  println(IntLit(2) < Neg(IntLit(1)))
  println(Neg(IntLit(3)).compare(Neg(IntLit(3))))
  println(StrLit("é") > StrLit("e"))
  println(StrLit("") < StrLit("a"))
  println(Pair(IntLit(3), StrLit("b")) > Pair(IntLit(3), StrLit("a")))
  println(Pair(IntLit(2), StrLit("z")) < Pair(Neg(IntLit(0)), StrLit("a")))
  println([Neg(IntLit(1)), IntLit(5), IntLit(-5)].sorted)
