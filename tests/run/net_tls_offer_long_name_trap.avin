// expect: trap
// A protocol name is measured in bytes: 128 characters of two bytes each, 256 bytes, are one over
// what ALPN carries, and a server offering them traps.
import avin.net.tls.TlsServer

main()
  val name = "é".repeat(128)
  println(s"${name.charCount} characters, ${name.byteLength} bytes")
  _ = TlsServer("", "").offer([name])
  println("not reached")
