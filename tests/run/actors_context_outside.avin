// expect: trap
// An `ActorContext` is made by an actor's own start, from the reference it is given: made by any
// other code, here `main`, which holds a reference it was given by `spawn`, it traps, so no code but
// the actor's own stops it or sets its timers.
import avin.actors.{ActorContext, Behaviour, spawn}

main()
  val r = spawn(Behaviour[int]("Quiet", me -> n -> ()))
  val ctx = ActorContext(r)
  ctx.stop()
  println("not reached")
