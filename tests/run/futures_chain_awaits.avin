// expect: exit 0
// A chain of futures, each body awaiting the future before it, built so that every body waits at
// once: each waiting worker is a parked thread, and the pool starts another in its place, so the
// chain resolves however long it is. Two hundred links run here under a collection at every
// allocation; `futures_chain_awaits_deep` runs ten thousand.
import avin.threads.{Future, Promise}

chain(links: int) -> int
    val start = Promise[int]()
    var last = start.future
    for _ in 0..<links
        val before = last
        last = Future(before.await() + 1)
    start.complete(0)
    last.await()

main() -> int
    println(chain(200))
    val mapped = (0..<50).foldLeft(Future.successful(0), (f, _) -> f.flatMap(n -> Future(n + 2)))
    println(mapped.await())
    0
