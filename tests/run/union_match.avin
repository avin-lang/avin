// expect: exit 0
// A `match` takes a union apart by type and covers every member. A type pattern tests a member; a
// supertype of a member covers it and binds it as the supertype; a subtype covers part of it; a
// sub-union pattern covers the members it names and binds the smaller union. Any other pattern (a
// literal, a range, a comparison, `n + k`, a constructor, a list or sequence pattern, a tuple, an
// extractor) applies to the one member it can match and counts toward covering that member alone.
// `_` and a bare binding cover every member. Clauses take a union parameter apart the same way, and
// so does a `match` function. An `Any` matched by a union pattern binds the union, and a generic
// `match` on `T | int` takes, at `T = int`, every value by the first arm.

trait Animal
    name() -> string

open class Dog(val n: string): Animal
    override name() -> string = n

class Puppy(n: string): Dog(n)

class Cat(n: string): Animal
    override name() -> string = n

data Token(text: string)

data Shape
    Circle(r: int)
    Square(side: int)

object Even
    unapply(n: int) -> Option[int] = if n % 2 == 0 then Some(n / 2) else None

byType(v: int | string | Token) -> string = v match
    n: int -> s"int $n"
    s: string -> s"string $s"
    Token(t) -> s"token $t"

supertype(v: Dog | int) -> string = v match
    a: Animal -> s"animal ${a.name()}"
    n: int -> s"int $n"

subtype(v: Dog | int) -> string = v match
    p: Puppy -> s"puppy ${p.n}"
    d: Dog -> s"dog ${d.n}"
    _: int -> "int"

subUnion(v: int | string | bool) -> string = v match
    x: (int | string) -> s"int or string ${x}"
    b: bool -> s"bool $b"

sign(v: int | string) -> string = v match
    n < 0 -> "negative"
    0 -> "zero"
    _: int -> "positive"
    "" -> "empty"
    _: string -> "text"

ranges(v: int | char) -> string = v match
    1..10 -> "small int"
    'a'..'z' -> "lower"
    n + 1 -> s"successor of $n"
    _: int -> "int"
    _: char -> "char"

shapes(v: Shape | string) -> string = v match
    Circle(r) -> s"circle $r"
    Square(s) -> s"square $s"
    t: string -> t

lists(v: List[int] | int) -> string = v match
    [] -> "empty list"
    h :: _ -> s"list from $h"
    n: int -> s"int $n"

sequences(v: Vector[int] | bool) -> string = v match
    [a, b] -> s"pair $a $b"
    _: Vector[int] -> "vector"
    b: bool -> s"bool $b"

// A type pattern among a constructor's fields says which member it is.
options(v: Option[int] | Option[string]) -> string = v match
    Some(n: int) -> s"int option $n"
    Some(s: string) -> s"string option $s"
    _ -> "none"

tuples(v: (int, string) | bool) -> string = v match
    (n, s) -> s"tuple $n $s"
    b: bool -> s"bool $b"

extractor(v: int | string) -> string = v match
    Even(half) -> s"even, half $half"
    n: int -> s"odd $n"
    s: string -> s

wildcard(v: int | string) -> string = v match
    0 -> "zero"
    _ -> "something"

binding(v: int | string) -> string = v match
    n: int -> s"int $n"
    other -> s"other $other"

guarded(v: int | string) -> string = v match
    n: int if n > 100 -> "big"
    n: int -> s"int $n"
    s: string -> s

firstArm(v: Dog | Cat) -> string = v match
    a: Animal -> s"animal ${a.name()}"

size(x: int | string) -> int
size(n: int) = n
size(s: string) = s.charCount()

val describe: (int | string) -> string = match
    n: int -> s"function int $n"
    s: string -> s"function string $s"

fromAny(a: Any) -> string = a match
    x: (int | string) -> s"union ${x}"
    _ -> "neither"

generic[T: Display](x: T | int) -> string = x match
    t: T -> s"T $t"
    n: int -> s"int $n"

main()
    println(byType(1))
    println(byType("two"))
    println(byType(Token("three")))
    println(supertype(Dog("rex")))
    println(supertype(4))
    println(subtype(Puppy("pip")))
    println(subtype(Dog("rex")))
    println(subtype(5))
    println(subUnion(6))
    println(subUnion("six"))
    println(subUnion(true))
    println(sign(-1))
    println(sign(0))
    println(sign(1))
    println(sign(""))
    println(sign("s"))
    println(ranges(3))
    println(ranges('q'))
    println(ranges(42))
    println(ranges(-4))
    println(ranges('Z'))
    println(shapes(Circle(1)))
    println(shapes(Square(2)))
    println(shapes("shape"))
    println(lists(List()))
    println(lists(List(7, 8)))
    println(lists(9))
    println(sequences([1, 2]))
    println(sequences([1, 2, 3]))
    println(sequences(false))
    println(options(Some(22)))
    val so: Option[string] = Some("opt")
    println(options(so))
    val none: Option[int] = None
    println(options(none))
    println(tuples((10, "ten")))
    println(tuples(true))
    println(extractor(12))
    println(extractor(13))
    println(extractor("fourteen"))
    println(wildcard(0))
    println(wildcard("w"))
    println(binding(15))
    println(binding("b"))
    println(guarded(500))
    println(guarded(16))
    println(guarded("g"))
    println(firstArm(Dog("first")))
    println(size(17))
    println(size("héllo"))
    println(describe(18))
    println(describe("d"))
    println(fromAny(19))
    println(fromAny("nineteen"))
    println(fromAny(true))
    println(generic[int](20))
    println(generic[string]("t"))
    println(generic[string](21))
