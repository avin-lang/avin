// expect: exit 0
// A refined variant's fields may be of opaque types, and a type with refined variants takes an
// opaque type as its own type argument: the values are made, printed, compared, hashed and told
// apart through `Any` by their instance, an opaque type's instance apart from its representation's.

opaque type UserId = long
opaque type Name = string

impl Display for UserId
  display(out: Writer, spec: FormatSpec) = out.write(s"u${repr}")

data Query[R]
  Count -> Query[long]
  Whose(id: UserId) -> Query[string]
  Rename(id: UserId, to: Name) -> Query[unit]
  Plain(r: R)

describe(x: Any) -> string = x match
  _: Query[long] -> "long query"
  _: Query[UserId] -> "user query"
  _: Query[string] -> "string query"
  _: Query[unit] -> "unit query"
  _ -> "other"

main()
  val qs: Vector[Any] = [Count, Whose(UserId(3)), Rename(UserId(1), Name("x")), Plain(UserId(1)), Plain(long(1))]
  for q in qs do println(describe(q))
  println(Whose(UserId(3)))
  println(Whose(UserId(3)) == Whose(UserId(3)))
  println(Whose(UserId(3)) == Whose(UserId(4)))
  println(Whose(UserId(3)).hash() == Whose(UserId(3)).hash())
  val p: Query[UserId] = Plain(UserId(9))
  println(p)
  println(p == Plain(UserId(9)))
  val many = (0 ..< 1000).map(i -> Whose(UserId(long(i)))).toVector
  println(many.length)
  println(many(999))
