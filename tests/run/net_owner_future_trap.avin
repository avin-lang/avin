// expect: trap
// A connection handed to a future's body is the body's while it runs, whichever worker runs it: the
// code that handed it over traps at a read served from the bytes read ahead.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.threads.{Channel, Future}

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message)

main()
    val l = ok(TcpListener.bind("127.0.0.1", 0))
    val c = ok(TcpStream.connect("127.0.0.1", l.port()))
    val s = ok(l.accept())
    ok(c.writeText("first\nsecond\nthird\n"))
    println(ok(s.readLine()))
    val go = Channel[int]()
    val f = Future
        go.receive()
        ok(s.readLine())
    println("handed over")
    _ = s.readLine()
    println("not reached")
    go.send(1)
    println(f.await())
