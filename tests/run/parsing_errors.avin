// expect: exit 0
// A failed parse reports the furthest place any alternative reached, as a line and a column counted
// in characters, with every distinct thing that could have continued the text there, in the order
// the grammar tried them, and what was found. `label` names a rule in place of what it is made of,
// a commit point stops backtracking, and `filter`, `failure` and the numbers say what they wanted.
import avin.parsing.{ParseError, Parser, commit, decimal, defer, failure, ident, integer, lit, stringLiteral, symbol, token, whitespace}

lazy val element: Parser[long] = token(integer) | defer(list) ^^ (xs -> long(xs.length()))

lazy val list: Parser[Vector[long]] = symbol("[") ~> element.repSep(symbol(",")) <~ symbol("]")

lazy val labelled: Parser[Vector[long]] = symbol("[") ~> token(integer).label("number").repSep(symbol(",")) <~ symbol("]")

lazy val keyword: Parser[string] = lit("let") | lit("var")

lazy val name: Parser[string] = ident.filter("name that is not a keyword", n -> n != "let" && n != "var")

show[T: Display](label: string, r: Result[T, ParseError])
    r match
        Ok(v) -> print(s"$label: ok $v")
        Err(e) -> print(s"$label: $e")

main()
    show("missing comma", list.parse("[1, 2,\n  3 4]"))
    show("trailing comma", list.parse("[1, 2, ]"))
    show("unclosed", list.parse("[1, [2, 3]"))
    show("empty text", list.parse(""))
    show("nothing after", list.parse("[1] 2"))
    show("labelled", labelled.parse("[1, x]"))
    // A failure past the labelled rule's first character keeps what was expected there.
    val angled = (symbol("<") ~> token(integer) <~ symbol(">")).label("angled number")
    show("labelled start", angled.parse("x"))
    show("labelled inside", angled.parse("<x"))
    show("labelled end", angled.parse("<1 x"))
    show("labelled among others", (angled | symbol("(") ^^^ long(0)).parse("x"))

    // The position's parts, and the column counted in characters on a later line.
    list.parse("[1,\n\u00e9\u00e9]") match
        Err(e) -> print(s"${e.position.offset} ${e.position.line} ${e.position.column} ${e.expected} ${e.found}")
        Ok(_) -> print("parsed")
    show("character width", token(stringLiteral).parse("\"\u00e9\u{1F600}\" x"))

    // The same expectation reached twice at one place is reported once.
    show("once", (lit("a") ~ lit("b") ^^^ 1 | lit("a") ~ lit("b") ~ lit("c") ^^^ 2 | lit("a") ~ lit("d") ^^^ 3).parse("ax"))

    // Without a commit point the second alternative is tried; with one the parse stops at `y`.
    val loose = lit("x") ~ lit("y") ^^^ 1 | lit("x") ~ lit("z") ^^^ 2
    val strict = lit("x") ~! lit("y") ^^^ 1 | lit("x") ~ lit("z") ^^^ 2
    show("loose", loose.parse("xz"))
    show("strict", strict.parse("xz"))
    show("strict before", strict.parse("w"))
    show("committed", (commit(lit("a")) | lit("b")).parse("b"))
    show("committed in repetition", (lit("(") ~! lit(")") ^^^ 1).rep().parse("()(]"))

    show("keyword", keyword.parse("val"))
    show("filter", name.parse("let"))
    show("filter passes", name.parse("letter"))
    show("failure", failure[int]("anything at all").parse("x"))
    show("too large", integer.parse("99999999999999999999"))
    show("number", decimal.parse("-x"))
    show("unterminated", stringLiteral.parse("\"abc"))
    show("control character", stringLiteral.parse("\"a\nb\""))
    show("escape", stringLiteral.parse("\"a\\qb\""))
    show("hex digit", stringLiteral.parse("\"\\u12g4\""))
    show("lone low surrogate", stringLiteral.parse("\"\\udc00\""))
    show("missing low surrogate", stringLiteral.parse("\"\\ud800x\""))
    show("wrong low surrogate", stringLiteral.parse("\"\\ud800\\u0041\""))
    show("white space first", (whitespace ~> lit("a")).parse("  \n  b"))
