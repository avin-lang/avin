// expect: exit 0
// An `Atomic` of a reference keeps its referent alive: eight threads swap freshly made nodes, each
// holding a list, into one `Atomic[Node]` while every allocation collects, and check every node they
// take out whole. A compare-and-set of a reference compares identity: a node equal in contents but
// not the same object does not match. A string is a reference too.
import avin.threads.{Atomic, scope}

class Node(val owner: int, val round: int, val items: List[int])

made(owner: int, round: int) -> Node = Node(owner, round, [owner, round, owner + round])

whole(n: Node) -> bool = n.items == [n.owner, n.round, n.owner + n.round]

main() -> int
    val slot = Atomic(made(-1, 0))
    val broken = Atomic(0)
    scope(s ->
        for t in 0..<8
            s.spawn(() ->
                for i in 0..<300
                    val old = slot.swap(made(t, i))
                    if !whole(old) then broken.add(1)))
    println(broken.load())
    println(whole(slot.load()))
    val first = made(1, 2)
    val twin = made(1, 2)
    val held = Atomic(first)
    println(held.compareAndSet(twin, made(3, 4)))
    println(held.compareAndSet(first, twin))
    println(held.load() === twin)
    val word = Atomic("start")
    println(word.swap("next"))
    println(word.load())
    broken.load()
