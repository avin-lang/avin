// expect: exit 0
// With no paths, `io.inputLines` is standard input's lines named `-`, terminators removed, read as the
// iterator advances, so a line read between steps by `readLine` is not given twice. Standard input
// here is `io_inputs_lines_stdin.in`, whose last line has no terminator.
import avin.fs
import avin.io
import avin.io.IoError

show(r: Result[(string, string), IoError]) -> string = r match
  Ok((name, line)) -> s"$name:$line"
  Err(e) -> s"error ${e.message}"

main()
  val dir = fs.tempDir("io-inputs-lines").getOrElse(fail("no temp dir"))
  defer dir.close()
  val f = dir.path + "/f.txt"
  _ = fs.writeText(f, "a\nb\n")
  val it = io.inputLines(Vector(f, "-"))
  println(show(it.next()).replace(dir.path + "/", ""))
  println(show(it.next()).replace(dir.path + "/", ""))
  println(show(it.next()))
  println(io.readLine())
  println(show(it.next()))
  println(it.hasNext())
  println(io.inputLines(Vector()).hasNext())
