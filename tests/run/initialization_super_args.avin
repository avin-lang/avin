// expect: exit 0
// A superclass's arguments may hand the superclass functions that read nothing of the object under
// construction: the class's parameters, module-level values and other objects. The superclass calls
// each one in its body, before any field of the new object is set, and every read finds a value.

open class Base(f: () -> string)
  val got: string = f()

open class Numbers(f: () -> long)
  val got: long = f()

open class Generic[T](f: () -> T)
  val got: T = f()

pick(flag: bool, v: -> long) -> long = if flag then v else 0
open class Holder(val got: long)

val greeting: string = "héllo"
val limits: Vector[long] = [9223372036854775807, -9223372036854775808]

object Settings
  val name: string = "settings"

class Other(val label: string)

// A lambda capturing a class parameter reads the argument itself.
class FromParam(start: string): Base(() -> start + "!")
  val after: string = got + "?"

// A parameter that is also a field: in the arguments its name is still the argument.
class FromField(val k: long): Numbers(() -> k * 2)
  val s: long = 21

// A module-level value, at the boundary values of a `long`.
class FromModule: Numbers(() -> limits(0))
class FromModuleMin: Numbers(() -> limits(1))
class FromGreeting: Base(() -> greeting)

// Another object's field, through a module-level object and through an argument.
class FromObject: Base(() -> Settings.name)
class FromOther(o: Other): Base(() -> o.label)

// A by-name argument reading a parameter.
class ByName(n: long): Holder(pick(true, n * 2))

// A generic superclass, at a reference type.
class GenericNames(names: Vector[string]): Generic[Vector[string]](() -> names)

// A lambda inside a lambda, both reading only a parameter.
twice(f: () -> long) -> long = f() + f()
class Nested(n: long): Numbers(() -> twice(() -> n))

// Two levels of superclass: the middle class passes on a function of its own parameter.
open class Middle(g: () -> long): Generic[long](g)
class Deep(d: long): Middle(() -> d + 1)

// An empty string and a lambda that captures nothing.
class Empty: Base(() -> "")

// An object extending a class, its arguments reading a module-level value.
object Single: Numbers(() -> limits(0) - 1)
  val k: long = 1

main()
  println(FromParam("start").got)
  println(FromParam("start").after)
  println(FromField(7).got)
  println(FromModule().got)
  println(FromModuleMin().got)
  println(FromGreeting().got)
  println(FromObject().got)
  println(FromOther(Other("other")).got)
  println(ByName(21).got)
  println(GenericNames(["a", "b"]).got.size)
  println(Nested(5).got)
  println(Deep(41).got)
  println(Empty().got.byteLength)
  println(Single.got)
  println(Single.k)
