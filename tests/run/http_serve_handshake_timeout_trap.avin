// expect: trap
// A handshake timeout of zero is no limit and the least one taken; one below zero, by a microsecond,
// traps where the server starts, with or without TLS.
import avin.net.http
import avin.net.http.Response
import avin.time.{Duration, micros}

main()
  println(
    http.serve("127.0.0.1", 0, _ -> Response.empty(204), handshakeTimeout = Duration.Zero).map(s -> s.shutdown()).isOk
  )
  println(http.serve("127.0.0.1", 0, _ -> Response.empty(204), handshakeTimeout = micros(-1)).isOk)
