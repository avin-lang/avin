// expect: exit 0
// A `StringWriter` is `Display`: it shows, interpolates and converts with `toString()` as the text
// written to it so far, honouring a field's width and side, as a string does.

show[T: Display](x: T) -> string = s"<$x>"

main()
  val w = StringWriter()
  println(s"[$w]")
  println(w.toString().isEmpty)
  w.write("héllo")
  w.write(", ")
  w.write("🌍")
  println(w)
  println(s"[$w]")
  println(w.toString())
  println(w.toString() == w.text)
  println(f"[${w}%12s]")
  println(f"[${w}%-12s|]")
  println(show(w))
  // Shown as its text now, not when it was made.
  w.write("!")
  println(show(w))
  w.clear()
  println(s"[${w}] ${w.isEmpty}")
  // As a value of `Display` and of `Any`, and kept in a collection.
  val d: Display = w
  w.write("again")
  println(d.toString())
  val a: Any = w
  println(a)
  val ws = Buffer[StringWriter]()
  for i in 0 ..< 3
    val each = StringWriter()
    each.write(s"w$i")
    ws.addOne(each)
  println(ws.map(x -> x.toString()).mkString(","))
  println(ws.mkString("+"))
