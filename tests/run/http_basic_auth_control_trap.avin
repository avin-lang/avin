// expect: trap
// A password of any printable text, Unicode included, is fine for basic authentication; one holding a
// control character, here a line break that would split the header, traps.
import avin.net.http.Request

main()
  println(Request("GET", "http://a.test/").withBasicAuth("ü", "pässwörd 🔑").header("Authorization").getOrElse("-"))
  _ = Request("GET", "http://a.test/").withBasicAuth("user", "line\nbreak")
