// expect: exit 0
// Maps and sets meeting their neighbours: keys that are data values, tuples, options, sequences of
// different kinds and class instances by identity; an update through the trait keeping a tree
// collection's kind; a value widened through `updated`; equality across kinds and through `Any`;
// `updatedWith` adding, replacing and removing; the mutable kinds' compound assignments and their
// edge cases; display and debug of nested collections; and the sorted operations at their edges.
import avin.collections.mutable.{Map as MutableMap, Set as MutableSet}

data Point(x: int, y: int)

open class Animal(val name: string)
class Cat(name: string) : Animal(name)
class Dog(name: string) : Animal(name)

class Token(val text: string)

kind(m: Map[string, int]) -> string = m match
    _: TreeMap[string, int] -> "tree"
    _: HashMap[string, int] -> "hash"
    _ -> "other"

main()
    val byPoint = {Point(1, 2): "a", Point(3, 4): "b"}
    println(s"${byPoint(Point(1, 2))} ${byPoint.get(Point(9, 9))}")
    val byPair = {(1, "x"): 10}
    println(byPair.getOrElse((1, "x"), 0) + byPair.getOrElse((2, "x"), 5))
    val byOption = Map((Some(1), "one"), (None, "none"))
    println(s"${byOption(None)} ${byOption(Some(1))}")
    val bySeq: Map[Seq[int], string] = {[1, 2]: "v"}
    println(s"${bySeq.get(List(1, 2))} ${bySeq.get(1..2)} ${bySeq.get([2, 1])}")
    val t1 = Token("t")
    val t2 = Token("t")
    val byToken = {(t1): 1}
    println(s"${byToken.get(t1)} ${byToken.get(t2)}")

    val tree: Map[string, int] = TreeMap(("b", 2), ("a", 1))
    val updated = tree.updated("c", 3)
    println(s"$updated ${kind(updated)} ${kind(tree.removed("a"))}")
    println(s"${kind(tree.filter((k, v) -> v > 1))} ${tree.mapValues(v -> v * 2)} ${kind(tree.map(e -> (e.1.toString(), e.1)))}")
    val cats: Map[string, Cat] = {"tom": Cat("tom")}
    val pets: Map[string, Animal] = cats.updated("rex", Dog("rex"))
    println(pets.values().map(a -> a.name).sorted())
    println(cats.getOrElse("none", Dog("fido")).name)

    val hm = {"a": 1, "b": 2}
    val tm = TreeMap(("b", 2), ("a", 1))
    val anyH: Any = hm
    val anyT: Any = tm
    println(s"${hm == tm} ${anyH == anyT} ${hm.hash() == tm.hash()} ${{1, 2} == TreeSet(2, 1)} ${hm == {"a": 1}}")

    val counts = {"a": 1}
    val inc = (o: Option[int]) -> o match
        Some(n) -> if n > 1 then None else Some(n + 1)
        None -> Some(1)
    val c1 = counts.updatedWith("a", inc)
    val c2 = c1.updatedWith("a", inc)
    val c3 = counts.updatedWith("z", inc)
    println(s"$c1 $c2 $c3 $counts")
    println(s"${hm ++ [("a", 9), ("a", 7), ("c", 3)]} ${hm -- ["a", "zz"]} ${hm.keys()} ${hm.values()} ${hm.keySet()}")
    println(s"${{1, 2} ++ [2, 3]} ${{1, 2} -- List(2, 9)} ${{1, 2, 3} union {4}} ${{1, 2} subsetOf {1, 2, 3}} ${{1, 2}.excl(5)}")
    println(hm.transform((k, v) -> k + v.toString()))

    val ms = MutableSet[int]()
    ms += 1
    ms ++= [2, 3, 3]
    ms -= 9
    println(ms.size())
    ms --= ms
    println(s"${ms.size()} ${ms.isEmpty()}")
    val mm = MutableMap[string, int]()
    mm("a") = 1
    mm("a") += 4
    mm += ("b", 2)
    mm ++= [("c", 3), ("c", 30)]
    mm -= "zz"
    mm --= ["b"]
    println(s"${mm("a")} ${mm.get("c")} ${mm.remove("a")} ${mm.remove("a")} ${mm.updateWith("d", o -> Some(o.getOrElse(0) + 1))} ${mm.size()}")
    val snapshot = mm.keys()
    mm("e") = 5
    println(s"${snapshot.length()} ${mm.keySet().size()}")
    val other = MutableMap[string, int]()
    other("c") = 30
    other("d") = 1
    other("e") = 5
    println(s"${mm == other} ${mm === other}")

    val nested = {"xs": [1, 2], "ys": Vector.empty[int]()}
    println(nested("xs"))
    println(debug({"k": Some("v")}))
    println(debug(TreeSet("b", "a")))
    println({"a": 1}.mkString())
    val empty = TreeMap.empty[int, string]()
    println(s"${empty.headOption()} ${empty.lastOption()} ${empty.minAfter(0)} ${empty.range(1, 5)}")
    val ts: TreeSet[int] = {5, 1, 3, 9}
    println(s"${ts.range(3, 3)} ${ts.range(5, 1)} ${ts.rangeFrom(4)} ${ts.minAfter(9)} ${ts.maxBefore(1)} ${ts.firstKey()} ${ts.lastKey()}")
    println(s"${ts.iteratorFrom(4).toList()} ${ts.reverseIterator().toList()}")
    val sm = TreeMap((3, "c"), (1, "a"), (2, "b"))
    println(sm.map(e -> (e.0 % 2, e.1)))
    println(s"${sm.keysIteratorFrom(2).toList()} ${sm.valuesIteratorFrom(2).toList()} ${sm.keySet().toString()}")
