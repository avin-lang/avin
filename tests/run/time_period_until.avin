// expect: exit 0
// The calendar between two dates: `Date - Date` as a period of days, `monthsUntil` counting whole
// months as a person does, and `until` as those months and the days left over, in both directions,
// from month ends and across leap days. `a + a.until(b) == b` holds for every pair of a sweep, either
// way round; `b - a.until(b) == a` and `b.until(a) == -a.until(b)` do not always hold, and the pairs
// where they fail are counted and shown.
import avin.time.{Date, Period, date, months}

main()
  // `Date - Date`: days only, negative where the right is later.
  println(date(2026, 3, 1) - date(2026, 1, 31))
  println(date(2026, 1, 31) - date(2026, 3, 1))
  println(date(2024, 3, 1) - date(2024, 2, 28))
  println(date(2023, 3, 1) - date(2023, 2, 28))
  println(date(2027, 1, 1) - date(2026, 1, 1))
  println(date(2025, 1, 1) - date(2024, 1, 1))
  println(date(2026, 8, 28) - date(2026, 8, 28))
  println(Date.Max - Date(0))
  println(Date(-1) - Date.Max)
  println(date(2026, 3, 1) - date(2026, 1, 31) == Period(0, 29))

  // Whole months as a person counts them.
  println(date(2026, 1, 31).monthsUntil(date(2026, 2, 28)))
  println(date(2026, 1, 31).monthsUntil(date(2026, 3, 1)))
  println(date(2026, 1, 31).monthsUntil(date(2026, 3, 30)))
  println(date(2026, 1, 31).monthsUntil(date(2026, 3, 31)))
  println(date(2026, 1, 15).monthsUntil(date(2026, 1, 31)))
  println(date(2026, 1, 15).monthsUntil(date(2027, 1, 14)))
  println(date(2026, 1, 15).monthsUntil(date(2027, 1, 15)))
  println(date(2024, 2, 29).monthsUntil(date(2025, 2, 28)))
  println(date(2024, 2, 29).monthsUntil(date(2025, 3, 1)))
  println(date(2026, 2, 28).monthsUntil(date(2026, 3, 31)))
  println(date(2026, 3, 1).monthsUntil(date(2026, 1, 31)))
  println(date(2026, 2, 28).monthsUntil(date(2026, 1, 31)))
  println(date(2027, 1, 14).monthsUntil(date(2026, 1, 15)))
  println(date(2026, 8, 28).monthsUntil(date(2026, 8, 28)))
  println(Date.Min.monthsUntil(Date.Max))
  println(Date.Max.monthsUntil(Date.Min))

  // The period between, from month ends and in both directions.
  println(date(2026, 1, 31).until(date(2026, 2, 28)))
  println(date(2026, 1, 31).until(date(2026, 3, 1)))
  println(date(2026, 1, 30).until(date(2026, 3, 1)))
  println(date(2024, 2, 29).until(date(2025, 2, 28)))
  println(date(2024, 2, 29).until(date(2028, 2, 29)))
  println(date(2026, 1, 15).until(date(2027, 3, 20)))
  println(date(2026, 3, 1).until(date(2026, 1, 31)))
  println(date(2026, 3, 31).until(date(2026, 2, 28)))
  println(date(2026, 3, 1).until(date(2026, 1, 30)))
  println(date(2027, 3, 20).until(date(2026, 1, 15)))
  println(date(2026, 8, 28).until(date(2026, 8, 28)))
  println(Date.Min.until(Date.Max))
  println(Date.Min + Date.Min.until(Date.Max) == Date.Max)
  println(Date.Max + Date.Max.until(Date.Min) == Date.Min)

  // Where the round trips fail: back from the later date, and the reverse period.
  println(date(2026, 3, 1) - date(2026, 1, 30).until(date(2026, 3, 1)))
  println(date(2026, 3, 1).until(date(2026, 1, 30)))

  // A sweep: every day of 2024 (a leap year) against dates 0 to 400 days on, every seventh.
  var pairs = 0
  var forward = 0
  var backward = 0
  var back = 0
  var reverse = 0
  var monthsAgree = 0
  val start = date(2024, 1, 1)
  for i in 0 .. 365
    val a = start.plusDays(i)
    for j in 0 .. 57
      val b = a.plusDays(j * 7)
      pairs += 1
      if a + a.until(b) == b then forward += 1
      if b + b.until(a) == a then backward += 1
      if b - a.until(b) == a then back += 1
      if b.until(a) == -a.until(b) then reverse += 1
      if b.monthsUntil(a) == -a.monthsUntil(b) then monthsAgree += 1
  println(s"$pairs pairs: forward $forward, backward $backward, monthsUntil antisymmetric $monthsAgree")
  println(s"b - a.until(b) == a in $back, b.until(a) == -a.until(b) in $reverse")
  println(back < pairs && reverse < pairs)

  // `until` is never longer than the months it names plus less than a month of days.
  var bounded = true
  for i in 0 .. 365
    val a = start.plusDays(i)
    val b = a.plusDays(i * 3 + 1)
    val p = a.until(b)
    if !(0 <= p.days < 31) || p.months < 0 then bounded = false
    if a + months(p.months) > b then bounded = false
  println(bounded)
