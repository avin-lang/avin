// expect: exit 0
// What a request carries for the middleware observing it: `remote` and `route`, `None` unless given;
// the route a router chose, its whole pattern under nested groups, a `GET` route's for a `HEAD`, and
// none for a request no route matched; `withParams` keeping both; and `withHeaderReplaced`, which
// drops every header of the name whatever its case, keeps the rest in order and adds the new one last.
import avin.net.http.{Response, Route, Router, ServerRequest}

main()
  val bare = ServerRequest("GET", "/")
  println(s"${bare.remote} ${bare.route}")
  val given = ServerRequest("GET", "/", remote = Some("192.0.2.1"), route = Some("/x"))
  println(s"${given.remote} ${given.route}")
  val bound = given.withParams(Vector(("id", "7")))
  println(s"${bound.remote} ${bound.route} ${bound.params}")

  val seen: @sendable (ServerRequest) -> Response = r -> Response.text(200, s"${r.route} ${r.remote} ${r.params}")
  val router = Router(
    Route.group(
      "/v1",
      Route.group("/users/:uid", [Route.get("/files/:name", seen), Route.get("/", seen)])
    ) :+ Route.post("/v1/users/:uid", seen)
  )
  println(router.handle(ServerRequest("GET", "/v1/users/3/files/a.txt", remote = Some("::1"))).text)
  println(router.handle(ServerRequest("GET", "/v1/users/3")).text)
  println(router.handle(ServerRequest("HEAD", "/v1/users/3")).text)
  println(router.handle(ServerRequest("POST", "/v1/users/4")).text)
  println(router.handle(ServerRequest("GET", "/nowhere")).status)

  val headed = ServerRequest(
    "GET",
    "/",
    Vector(("A", "1"), ("x-request-id", "old"), ("B", "2"), ("X-REQUEST-ID", "older")),
    remote = Some("192.0.2.1")
  )
  val replaced = headed.withHeaderReplaced("X-Request-Id", "new")
  println(replaced.headers)
  println(s"${replaced.header("x-request-id")} ${replaced.remote}")
  println(ServerRequest("GET", "/").withHeaderReplaced("New", "").headers)
  println(headed.headers.length)
