// expect: exit 0
// A scope cancels the threads pinned to the main thread that it started as it cancels its others: one
// parked on a channel stops there, one started in a cancelled scope runs nothing, and each answers
// `None`. A time limit around a pinned thread's wait ends it; and a pinned thread runs a scope of its
// own, on the workers and pinned.
import avin.threads.{Channel, isPinnedToMain, scope, sleep, spawn, spawnOnMain, withTimeout}
import avin.time.millis

main()
  val never = Channel[int]()
  val log = Buffer[string]()
  val (parked, late) = scope(s ->
    val parked = s.spawnOnMain(() ->
      log.append("parked")
      never.receive()
      log.append("not reached")
      1)
    val finished = s.spawnOnMain(() -> 2)
    println(finished.join())
    s.cancel()
    val late = s.spawnOnMain(() ->
      log.append("not run")
      3)
    (parked, late))
  println(parked.result())
  println(late.result())
  println(log.mkString(","))

  // A timeout around a pinned thread's wait: the body runs on the workers, the pinned thread waits
  // for it, and the time runs out.
  val timed = spawnOnMain(() ->
    withTimeout(millis(5), s -> never.receive()))
  println(timed.join())

  // A cancelled scope's pinned thread asleep: the sleep ends at once.
  val slept = scope(s ->
    val t = s.spawnOnMain(() ->
      sleep(millis(60000))
      "woke")
    s.cancel()
    t)
  println(slept.result())

  // A pinned thread runs a scope that starts threads on the workers and pinned threads both.
  println(spawnOnMain(() -> scope(s ->
    val a = s.spawn(() -> 20)
    val b = s.spawnOnMain(() -> if isPinnedToMain() then 22 else 0)
    a.join() + b.join())).join())

  // A scope run on a worker cannot start a pinned thread: shown by a spawned thread that tries outside
  // a scope in the trap test; here, the worker's own threads are still fine.
  println(spawn(() -> scope(s -> s.spawn(() -> 5).join())).join())
