// expect: trap
// A receive takes room for at least one byte, so a receive of none traps at the call, before it
// waits for anything.
import avin.net.UdpSocket

main()
  UdpSocket.bind("127.0.0.1", 0) match
    Ok(s) ->
      println(s.receiveFrom(1 - 1).isOk)
      println("not reached")
    Err(e) -> println(e.message)
