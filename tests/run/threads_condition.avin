// expect: exit 0
// A producer and a consumer share a queue a mutex holds, the consumer waiting on a condition while the
// queue is empty and the producer on another while it is full: every value arrives once, in order,
// and the queue never holds more than its bound. Values are made as they go, so collections happen
// while one thread sleeps in a wait.
import avin.threads.{Mutex, spawn}

main() -> int
  val queue = Mutex(Deque[string]())
  val ready = queue.condition()
  val room = queue.condition()
  val bound = 4
  val count = 2000
  val consumer = spawn(() ->
    var got = 0
    var wrong = 0
    var over = 0
    while got < count
      val v = queue.with(q ->
        while q.isEmpty do ready.wait()
        if q.length > bound then over += 1
        val x = q.removeHead()
        room.notify()
        x)
      if v != s"item $got" then wrong += 1
      got += 1
    (wrong, over))
  for i in 0 ..< count
    val item = s"item $i"
    queue.with(q ->
      while q.length >= bound do room.wait()
      q.append(item)
      ready.notifyAll())
  val (wrong, over) = consumer.join()
  println(s"$wrong wrong, $over over the bound")
  wrong + over
