// expect: exit 0
// Several data types of one module may each have a variant of one name. A bare use of the name is
// the variant of the type expected there: a parameter's, an annotated binding's, a function's
// result, a field's, a collection's element, the other operand of a comparison, and in a pattern the
// matched value's. The qualified `Type.Variant` always works, and mixes with the bare form.

data Slant
    Normal
    Italic
    Oblique

// Declared after `Slant`, and with the shared variant last rather than first.
data Weight
    Bold
    Normal

// A third type sharing `Normal`, declared before the type that uses it.
data Stretch
    Condensed
    Normal
    Expanded

data Font(slant: Slant, weight: Weight, stretch: Stretch)

slantName(s: Slant) -> string = s match
    Normal -> "upright"
    Italic -> "italic"
    Oblique -> "oblique"

// Exhaustive with no wildcard: the bare `Normal` arm is `Weight`'s, so `Bold` and `Normal` cover it.
heavy(w: Weight) -> bool = w match
    Normal -> false
    Bold -> true

stretchCode(s: Stretch) -> int = s match
    Condensed -> -1
    Stretch.Normal -> 0
    Expanded -> 1

defaultWeight() -> Weight = Normal

pick(bold: bool) -> Weight = if bold then Bold else Normal

describe(f: Font) -> string = f match
    Font(Normal, Normal, Normal) -> "plain"
    Font(Italic, Normal, _) -> "italic"
    Font(_, Bold, Normal) -> "bold"
    Font(s, w, t) -> s"$s $w $t"

main()
    // Parameters decide.
    println(slantName(Normal))
    println(heavy(Normal))
    println(heavy(Bold))
    println(stretchCode(Normal))
    // Annotated bindings, results and `if` branches.
    val s: Slant = Normal
    var w: Weight = Normal
    println(s"$s $w ${defaultWeight()} ${pick(true)} ${pick(false)}")
    w = Bold
    println(w)
    // Fields of a construction, each its own type's `Normal`.
    println(describe(Font(Normal, Normal, Normal)))
    println(describe(Font(Italic, Normal, Normal)))
    println(describe(Font(Oblique, Bold, Normal)))
    println(describe(Font(Oblique, Bold, Expanded)))
    // Comparisons take the type of the other operand, either side.
    println(w == Normal)
    println(Normal != w)
    println(s == Normal && Normal == Stretch.Normal)
    println(Slant.Normal == Normal)
    // `is` tests match against the tested value's type.
    println(s is Normal)
    println(w is Normal)
    // Collections with an element type.
    val ws: Vector[Weight] = [Normal, Bold, Normal]
    println(ws)
    println(ws.filter(x -> x == Normal).length)
    val ss: List[Stretch] = List(Condensed, Normal, Expanded)
    println(ss.map(stretchCode))
    // Qualified forms, which need no expected type.
    val q = Weight.Normal
    val r = Stretch.Normal
    println(s"$q $r ${q == Weight.Normal}")
    // A closure capturing a value of one of the types, compared with the bare name.
    val isPlain = (x: Slant) -> x == Normal && w == Bold
    println(isPlain(Normal))
    println(isPlain(Italic))
