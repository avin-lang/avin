// expect: exit 0
// An actor started by an actor's code is its child: `children()` lists the ones that have not
// ended, in the order they started, and `parent()` names the actor that started it, `None` for a
// top-level actor. `stop(child)` ends a child, which leaves `children()` once it has ended; stopping
// a child that has ended already, or an actor that has ended whoever started it, does nothing. A
// child started from a `stopping` block is stopped at once, and its parent ends without waiting for
// it. A top-level actor spawned from `main` has no parent, nor does one spawned inside a future an
// actor starts, which is not the actor's own code.
import avin.actors.{ActorRef, spawn}
import avin.threads.{Channel, Future, Promise}

data Msg
    Report(reply: Promise[string])
    StopFirst(reply: Promise[string])
    StopAgain(target: ActorRef[Nothing], reply: Promise[string])
    Parent(reply: Promise[Option[ActorRef[Nothing]]])
    ParentOfKid(reply: Promise[string])
    Quit
    Note

actor Kid(n: int, log: Channel[string]) receives Msg
    receive
        Parent(reply) -> reply.complete(parent())
        Quit -> stop()
        _ -> ()
    stopping
        log.send(s"kid $n stopping")

actor Mother(log: Channel[string]) receives Msg
    val kids = Vector(spawn(Kid(1, log)), spawn(Kid(2, log)), spawn(Kid(3, log)))
    receive
        Report(reply) -> reply.complete(s"${children().length} children, first is ${children().head == kids(0)}, in order ${children() == kids}")
        StopFirst(reply) ->
            stop(kids(0))
            reply.complete("asked")
        StopAgain(target, reply) ->
            stop(target)
            reply.complete(s"stopping $target again did nothing; ${children().length} children")
        Parent(reply) -> reply.complete(parent())
        ParentOfKid(reply) ->
            val p = Promise[Option[ActorRef[Nothing]]]()
            kids(1).tell(Parent(p))
            reply.complete(s"the second kid's parent is its mother: ${p.future.await() == Some(self)}")
        Quit -> stop()
        Note -> ()
    stopping
        log.send(s"mother stopping with ${children().length} children")
        spawn(Kid(99, log))

data Ask(reply: Promise[Option[ActorRef[Nothing]]])

// An actor whose future spawns: the future's body is not the actor's code.
actor Launcher receives Ask
    receive
        Ask(reply) ->
            val inner = Future(spawn(Kid(7, Channel[string]())))
            val p = Promise[Option[ActorRef[Nothing]]]()
            inner.await().tell(Parent(p))
            reply.complete(p.future.await())

ask(m: ActorRef[Msg], make: (Promise[string]) -> Msg) -> string
    val p = Promise[string]()
    m.tell(make(p))
    p.future.await()

main()
    val log = Channel[string]()
    val m = spawn(Mother(log))
    println(ask(m, p -> Report(p)))
    val top = Promise[Option[ActorRef[Nothing]]]()
    m.tell(Parent(top))
    println(s"mother's parent: ${top.future.await()}")
    println(ask(m, p -> ParentOfKid(p)))
    println(ask(m, p -> StopFirst(p)))
    // Wait until the first child has ended: the report then counts two.
    var report = ask(m, p -> Report(p))
    while report.startsWith("3") do report = ask(m, p -> Report(p))
    println(report)
    println(log.receive().get())
    val gone = spawn(Kid(50, log))
    gone.tell(Quit)
    gone.ended().await()
    println(log.receive().get())
    println(ask(m, p -> StopAgain(gone, p)))
    val launcher = spawn(Launcher())
    val launched = Promise[Option[ActorRef[Nothing]]]()
    launcher.tell(Ask(launched))
    println(s"a future's actor has a parent: ${launched.future.await().isDefined()}")
    m.tell(Quit)
    m.ended().await()
    // The two children left end before their mother; the one her `stopping` block starts after.
    val lines = [log.receive().get(), log.receive().get()].sorted()
    for line in lines do println(line)
    println(log.receive().get())
    println(log.receive().get())
