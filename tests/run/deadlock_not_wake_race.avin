// expect: exit 0
// The main thread woken just as the last other thread stops running is not deadlocked: `main` joins
// thousands of short threads, each ending as `main` begins to wait; takes a mutex that threads hand
// it as they let it go; and receives values each sent by a thread that ends at once. In every one the
// thread that wakes `main` is gone, and nothing runs, by the time `main` looks.
import avin.threads.{Channel, Mutex, spawn}

main()
  var joined = 0
  for i in 0 ..< 3000
    joined += spawn(() -> i % 2).join()
  println(joined)

  val m = Mutex(0)
  val takers = Vector.tabulate(4, k -> spawn(() ->
    for _ in 0 ..< 1000 do m.update(n -> n + 1)
    k))
  for _ in 0 ..< 1000 do m.update(n -> n + 1)
  var ks = 0
  for t in takers do ks += t.join()
  println(m.get())
  println(ks)

  val c = Channel[int]()
  var got = 0
  for i in 0 ..< 3000
    spawn(() -> c.send(1))
    got += c.receive().getOrElse(0)
  println(got)
