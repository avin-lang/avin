// expect: exit 0
// What `derives` and every data type's automatic `Display` and `Debug` stand for names the core
// library's traits and types themselves, so a module that declares its own `Display`, `Debug`,
// `Writer` or `StringWriter`, a variant named `Hash` or a function named `Ord` keeps printing,
// comparing and hashing its types, and its own declarations of those names are usable beside them.

trait Display
  render() -> string

trait Debug
  inspect() -> string

class Writer(val lines: int)

class StringWriter

data Token
  Hash
  Plus

impl Debug for Token
  inspect() -> string = "a token"

Ord(n: int) -> int = n + 1

data Point(x: int, y: int)

impl Display for Point
  render() -> string = s"<$x, $y>"

data Pair[A, B](first: A, second: B)

data Holder[Writer](held: Writer)

class Version(val major: int, val minor: int) derives Eq, Hash, Ord

class Box[T](val item: T) derives Eq, Hash, Ord, Display, Debug

main()
  val p = Point(1, 2)
  println(p)
  println(s"$p ${debug(p)}")
  println(p.render())
  println(Some(3))
  println(debug(Some("s")))
  println(Pair(1, "a"))
  println(debug(Pair("a", Pair(1, 'c'))))
  println(Holder(5))
  println(s"$Hash ${debug(Plus)}")
  println(Writer(Ord(2)).lines)
  val v = Version(1, 2)
  println(s"${v == Version(1, 2)} ${v.hash() == Version(1, 2).hash()} ${v < Version(1, 3)} ${Version(2, 0) > v}")
  println(s"${Version(1, 9).compare(Version(2, 0))} ${Plus.inspect()}")
  println(Box(Box(3)))
  println(debug(Box("s")))
  println(Box(1) < Box(2))
