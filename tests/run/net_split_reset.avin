// expect: exit 0
// The peer of a split connection resets it while both halves are parked, the reader waiting for
// bytes and the writer for room, each on its own lightweight thread: each half's wait ends, the
// writer's with `ConnectionReset` and the reader's with that or the end of the input, and every use
// of either half after answers the reset or, for the reader, the end of the input, never ending the
// program. Each half then closes: a TLS writer's close answers `Ok` as a TCP one's does, though its
// close notice cannot go out, even where the reader was the one that tried to send it; and nothing is left on the poller.
// The peer resets by closing with bytes it has not read, after the writer has filled its buffers.
// Over TCP and TLS.
import avin.fs
import avin.io
import avin.io.IoError
import avin.net.{ByteStream, StreamReader, StreamWriter, TcpListener, TcpStream}
import avin.net.tls.{TlsClient, TlsError, TlsServer, TlsStream}
import avin.threads.{Channel, Thread, sleep, spawn}
import avin.time.millis

@sysl("avin.rt.socket_waiters")
socketWaiters() -> long

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

tls[T](r: Result[T, TlsError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

fixture(name: string) -> string
  val here = "tests/fixtures/tls/" + name
  ok(fs.readText(if fs.exists(here) then here else "../" + here))

// What a reader's read came to: the reset, or the end of the input.
readOutcome(r: Result[Array[byte], IoError]) -> string = r match
  Err(IoError(io.ConnectionReset, _, _)) -> "ended"
  Ok(bytes) -> if bytes.length == 0 then "ended" else s"read ${bytes.length}"
  Err(e) -> e.kind.description

// What a reader's readLine came to, likewise.
lineOutcome(r: Result[Option[string], IoError]) -> string = r match
  Err(IoError(io.ConnectionReset, _, _)) -> "ended"
  Ok(None) -> "ended"
  Ok(Some(text)) -> s"line $text"
  Err(e) -> e.kind.description

writeOutcome(r: Result[unit, IoError]) -> string = r match
  Err(IoError(io.ConnectionReset, _, _)) -> "reset"
  Ok(_) -> "sent"
  Err(e) -> e.kind.description

// A peer that waits for the word to go, then closes the connection it has read nothing of.
peer(s: ByteStream, go: Channel[int]) -> string
  go.receive()
  _ = s.close()
  "closed"

run(name: string, c: ByteStream, go: Channel[int], far: Thread[string])
  val (r, w) = c.split()
  val reading = spawn(() ->
    val first = readOutcome(r.read(100))
    val again = readOutcome(r.read(100))
    val line = lineOutcome(r.readLine())
    val lineAgain = lineOutcome(r.readLine())
    s"$first $again $line $lineAgain ${r.close().isOk}")
  val writing = spawn(() ->
    val big = Array.fill(4194304, byte(120))
    val first = writeOutcome(w.write(big))
    val again = writeOutcome(w.write(Array.fill(1, byte(1))))
    val some = w.writeSome(Array.fill(1, byte(1))).isErr
    s"$first $again $some ${w.close().isOk}")
  // Both halves parked on the poller: the writer has filled the buffers between the two ends.
  while socketWaiters() < 2 do sleep(millis(1))
  go.send(1)
  println(name, "far end", far.join())
  println(name, "reader", reading.join())
  println(name, "writer", writing.join())
  println(name, "waiters", socketWaiters())

main()
  val l = ok(TcpListener.bind("127.0.0.1", 0))
  val port = l.port()
  val server = tls(TlsServer.of(fixture("localhost.pem"), fixture("localhost.key")))
  val tcpGo = Channel[int](1)
  val tlsGo = Channel[int](1)
  val tcpFar = spawn(() ->
    val s = ok(l.accept())
    _ = l.close()
    peer(s, tcpGo))
  run("tcp", ok(TcpStream.connect("127.0.0.1", port)), tcpGo, tcpFar)
  val m = ok(TcpListener.bind("127.0.0.1", 0))
  val securePort = m.port()
  val tlsFar = spawn(() ->
    val s = tls(TlsStream.server(ok(m.accept()), server))
    _ = m.close()
    peer(s, tlsGo))
  run("tls", tls(TlsStream.connect("localhost", securePort, TlsClient().trust(fixture("ca.pem")))), tlsGo, tlsFar)
