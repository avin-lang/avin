// expect: exit 0
// `bool` is `Ord` with `false < true`: its four operators, `compare`, chains, `min`/`max`/`clamp`,
// `Reverse`, sort keys alone and inside tuples, sorting, extremes, sorted sets and maps, derived and
// generic orders holding a bool, closures, and bools only known at run time.

data Task(id: int, done: bool)

data Flagged(on: bool, name: string) derives Ord

smaller[T: Ord](a: T, b: T) -> T = if a.compare(b) <= 0 then a else b

sign(n: int) -> int = if n < 0 then -1 elif n > 0 then 1 else 0

// A bool the compiler cannot know: decided by an argument.
flag(n: int) -> bool = n > 0

row(a: bool, b: bool) -> string = s"$a $b: ${a < b} ${a <= b} ${a > b} ${a >= b} ${sign(a.compare(b))}"

main()
  val f = flag(0)
  val t = flag(1)

  // Every pair, through the operators and `compare`.
  println(row(f, f))
  println(row(f, t))
  println(row(t, f))
  println(row(t, t))
  println(s"${false < true} ${true < false} ${true >= false} ${false <= false}")
  println(s"${f.less(t)} ${t.lessOrEqual(f)} ${t.greater(f)} ${f.greaterOrEqual(t)}")

  // Chains.
  println(s"${f < t <= t} ${f <= f < t} ${t > f >= f} ${f < t < t}")

  // Generic code bounded by `Ord`.
  println(s"${smaller(t, f)} ${smaller(t, t)} ${max(f, t, f)} ${min(t, f, t)} ${max(t)} ${min(f)}")
  println(s"${clamp(f, t, t)} ${clamp(t, f, f)} ${clamp(t, f, t)}")
  println(s"${Reverse(t) < Reverse(f)} ${Reverse(f) < Reverse(t)}")

  // Sorting a vector and a list of bools, with duplicates, empty and one element.
  val flags = [t, f, t, t, f, f, t]
  println(flags.sorted)
  println(flags.toList.sorted)
  println(flags.sortBy(b -> Reverse(b)))
  println(flags.sortWith(compareBy(b -> b)))
  val none: Vector[bool] = []
  println(none.sorted)
  println([t].sorted)
  println(s"${flags.max} ${flags.min} ${none.maxOption} ${none.minOption} ${[f, f].max} ${[t, t].min}")

  // Bools in tuple keys: open tasks first, then by id; and done ones first.
  val tasks = [Task(4, t), Task(2, f), Task(3, t), Task(1, f), Task(5, f)]
  println(tasks.sortBy(task -> (task.done, task.id)).map(_.id))
  println(tasks.sortBy(task -> (Reverse(task.done), task.id)).map(_.id))
  println(tasks.sortBy(task -> (task.done, Reverse(task.id))).map(_.id))
  println(tasks.sortBy(_.done).map(_.id))
  println(s"${tasks.minBy(_.done).id} ${tasks.maxBy(_.done).id} ${tasks.maxBy(task -> (task.done, task.id)).id}")
  println(s"${(f, 9) < (t, 0)} ${(t, 0) < (t, 1)} ${(t, f, 1) < (t, t, 0)} ${(1, t) > (1, f)}")

  // Sorted sets and maps keyed by bools.
  println(TreeSet(t, f, t))
  println(TreeSet(t))
  var tree = TreeMap[bool, string]()
  tree = tree.updated(t, "yes")
  tree = tree.updated(f, "no")
  tree = tree.updated(t, "yes again")
  println(tree)
  println(TreeSet((t, 1), (f, 2), (t, 0)))

  // Derived and generic orders over a bool.
  println(Vector(Flagged(t, "a"), Flagged(f, "b"), Flagged(t, "0"), Flagged(f, "a")).sorted)
  val o1: Option[bool] = None
  val o2: Option[bool] = Some(f)
  val o3: Option[bool] = Some(t)
  println(s"${o1 < o2} ${o2 < o3} ${o3 > o1}")
  val e1: Either[bool, int] = Left(t)
  val e2: Either[bool, int] = Right(0)
  println(s"${e1 < e2} ${smaller(e2, e1)}")
  println(s"${List(f, t) < List(t)} ${List(t, f) < List(t, t)} ${List(t) < List(t, f)}")

  // A closure comparing against a captured bool.
  val below = (b: bool) -> b < t
  println(s"${below(f)} ${below(t)}")

  // Many bools sorted: stable counts, false first.
  var many: Vector[(bool, int)] = []
  for i in 0 ..< 5000
    many = many :+ (flag(i % 3 - 1), i)
  val sortedMany = many.sorted
  println(s"${sortedMany.count(p -> !p.0)} ${sortedMany(0)} ${sortedMany(3333)} ${sortedMany(4999)}")
  println(sortedMany.map(_.0).sorted == sortedMany.map(_.0))
