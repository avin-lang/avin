// Bitwise operators and shifts; a shift count at least the width, or negative, shifts every bit out.

main() -> int
    val a = 12
    val b = 10
    if a & b != 8 then return 1
    if a | b != 14 then return 2
    if a ^ b != 6 then return 3
    if ~a != -13 then return 4
    // `&` binds tighter than `^`, which binds tighter than `|`; all bind tighter than comparison.
    if 1 | 2 ^ 3 & 5 != 3 then return 5
    if a & 4 == 0 then return 6
    if 1 << 4 != 16 then return 7
    if -16 >> 2 != -4 then return 8
    val width = 32
    if 1 << width != 0 then return 9
    if 1 << (width + 5) != 0 then return 10
    if -1 >> width != -1 then return 11
    if 64 >> width != 0 then return 12
    if 1 << -1 != 0 then return 13
    val byte_sized: i8 = -128
    if byte_sized >> 7 != -1 then return 14
    if byte_sized << 1 != 0 then return 15
    0
