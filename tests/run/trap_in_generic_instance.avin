// expect: trap
// Every instance of a generic function reports the generic's own source: here the string instance
// traps, at the `%` both instances share.

slot[T](value: T, index: int, size: int) -> T
    println(s"slot ${index % size}")
    value

main() -> int
    println(s"${slot(7, 5, 3)}")
    println(slot("seven", 5, 0))
    0
