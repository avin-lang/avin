// expect: exit 0
// `blocking` marks a body that waits on something other than a future, so the pool starts a worker in
// its place while it waits. Every worker of a full pool here waits in `blocking` for a channel that
// only a task queued behind them fills; without `blocking` none would ever run it. The same holds on
// an executor of two workers, for nested `blocking` and for an `await` inside one, which count once,
// and `blocking` on a thread of no pool simply runs its body.
import avin.threads.{blocking, sleep, Channel, Executor, Future}
import avin.time.millis

// Sleeps, leaving its place on the pool to another worker while it does.
nap(i: int) -> int
    blocking
        sleep(millis(20))
        i

main() -> int
    val shared = Channel[int]()
    val receivers = (0..<64).map(i -> Future(blocking(shared.receive().getOrElse(-1)))).toVector()
    val sender = Future
        for n in 1..64 do shared.send(n)
        "sent"
    println(s"shared pool: ${sender.await()}, received ${Future.all(receivers).await().sum()}")

    val two = Executor.fixed(2)
    val jobs = Channel[int]()
    val waiting = (0..<6).map(i -> two.future(blocking(jobs.receive().getOrElse(-1) * 10))).toVector()
    val filler = two.future
        for n in 1..6 do jobs.send(n)
        jobs.close()
        6
    println(s"two workers: filled ${filler.await()}, received ${Future.all(waiting).await().sum()}")

    val gate = Channel[string]()
    val inner = two.future(blocking(blocking(gate.receive().getOrElse("closed"))))
    val outer = two.future(blocking(two.future(gate.receive().getOrElse("closed")).await()))
    val opener = two.future
        gate.send("first")
        gate.send("second")
        "opened"
    val got = [inner.await(), outer.await()].sorted()
    println(s"nested: ${opener.await()} ${got}")

    val slept = (0..<8).map(i -> two.future(nap(i))).toVector()
    println(s"sleeping in blocking on two workers ${Future.all(slept).await()}")

    println(s"no pool: ${blocking(6 * 7)}")
    two.shutdown()
    0
