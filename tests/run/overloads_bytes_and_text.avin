// expect: exit 0
import avin.encoding.{toHex, fromHex, toBase64, fromBase64}

// Overloads taking bytes and text each choose by the argument's type, and a generic call's two
// arguments of one `Result` type agree.
f(x: Vector[byte]) -> string = "bytes"
f(x: string) -> string = "text"

allBytes() -> Vector[byte] = Vector.tabulate(256, i -> byte(i))

main()
  val all = allBytes()
  val empty: Vector[byte] = []
  println(f(all))
  println(f("é"))
  println(f(empty))
  println(f(""))
  assertEq(fromHex(toHex(all)), Ok(all))
  assertEq(Ok(all), fromHex(toHex(all)))
  assertEq(fromBase64(toBase64(all)), Ok(all))
  assertEq(toHex("é"), "c3a9")
  assertEq(toHex(empty), "")
  println(toBase64("日本"))
