// expect: exit 0
// A thread parked waiting on a socket is woken by its scope's cancellation and stops, with nothing
// after the operation run: a TCP read, a TCP accept, a TCP write to a peer that never reads, a Unix
// read and a Unix accept. The sockets come back to the scope's thread afterwards and still work: the
// read connections receive what is written next, the listeners accept the next connection, and the
// stuffed connection is closed.
import avin.fs
import avin.io.IoError
import avin.net.{TcpListener, TcpStream, UnixListener, UnixStream}
import avin.threads.{Atomic, scope, sleep}
import avin.time.millis

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message)

main()
    val l = ok(TcpListener.bind("127.0.0.1", 0))
    val c = ok(TcpStream.connect("127.0.0.1", l.port()))
    val s = ok(l.accept())
    val stuffed = ok(TcpStream.connect("127.0.0.1", l.port()))
    val ignoring = ok(l.accept())
    val dir = ok(fs.createTempDir("avc"))
    val ul = ok(UnixListener.bind(dir + "/s"))
    val uc = ok(UnixStream.connect(dir + "/s"))
    val us = ok(ul.accept())
    val after = Atomic(0)
    val started = Atomic(0)
    val ts = scope(sc ->
        val ts = [
            sc.spawn(() ->
                started.add(1)
                val line = s.readLine()
                after.add(1)
                line.isOk()),
            sc.spawn(() ->
                started.add(1)
                val got = l.accept()
                after.add(1)
                got.isOk()),
            sc.spawn(() ->
                started.add(1)
                val big = Array.fill(1 << 20, byte(7))
                var sent = true
                while sent do sent = stuffed.write(big).isOk()
                after.add(1)
                sent),
            sc.spawn(() ->
                started.add(1)
                val line = us.readLine()
                after.add(1)
                line.isOk()),
            sc.spawn(() ->
                started.add(1)
                val got = ul.accept()
                after.add(1)
                got.isOk())]
        while started.load() < 5 do sleep(millis(1))
        sleep(millis(30))
        sc.cancel()
        ts)
    for t in ts do println(t.result())
    println(after.load())
    ok(c.writeText("tcp after\n"))
    println(ok(s.readLine()))
    val next = ok(TcpStream.connect("127.0.0.1", l.port()))
    ok(next.writeText("accepted after\n"))
    println(ok(ok(l.accept()).readLine()))
    ok(uc.writeText("unix after\n"))
    println(ok(us.readLine()))
    val unext = ok(UnixStream.connect(dir + "/s"))
    ok(unext.writeText("unix accepted after\n"))
    println(ok(ok(ul.accept()).readLine()))
    stuffed.close()
    ignoring.close()
    println("closed")
