// expect: exit 0
// A built-in type's own static members, declared in an impl of the type without a trait: called on
// the type's name, with parameters, defaults and overloads, beside the type's methods of values, the
// static members of its traits and the members the language gives it.

impl string
  static repeated(part: string, times: int = 2) -> string
    var out = ""
    for _ in 0 ..< times
      out = out + part
    out
  static pair(a: char, b: char) -> string = s"$a$b"
  static pair(a: int, b: int) -> string = s"$a,$b"
  shouted() -> string = self + "!"

impl int
  static parity(n: int) -> string = if n % 2 == 0 then "even" else "odd"

impl long
  static fromParts(high: int, low: int) -> long = long(high) * 1000000 + long(low)

impl i8
  static clampFrom(n: int) -> i8 = if n > 127 then i8.MaxValue elif n < -128 then i8.MinValue else i8(n)

impl char
  static fromDigit(d: int) -> char = "0123456789".charAt(d)

impl real
  static half(x: real) -> real = x / 2.0

impl bool
  static fromFlag(flag: string) -> bool = flag == "yes"

impl byte
  static fromLow(n: int) -> byte = byte(n % 256)

// A static member calls the type's others, and a method of a value calls a static on the type.
impl string
  static framed(
      s: string
  ) -> string = string.pair('[', ']').charAt(0).toString() + s + string.pair('[', ']').charAt(1).toString()
  boxed() -> string = string.framed(self)

main()
  println(string.repeated("ab"))
  println(string.repeated("ab", 3))
  println(string.repeated(times = 0, part = "x").byteLength)
  println(string.pair('o', 'k'))
  println(string.pair(4, 2))
  println("hey".shouted())
  println(int.parity(7))
  println(int.parity(-4))
  println(int.zero() + int.one())
  println(long.fromParts(3, 42))
  println(i8.clampFrom(500))
  println(i8.clampFrom(-500))
  println(i8.wrap(300))
  println(char.fromDigit(7))
  println(real.half(5.0))
  println(bool.fromFlag("yes"))
  println(bool.fromFlag("no"))
  println(byte.fromLow(258))
  println(byte.MaxValue)
  println("mid".boxed())
  // A value of the type's name hides the type, as for any static member.
  val string = "shadow"
  println(string.byteLength)
