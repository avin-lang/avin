-- literal and separators
a/b ~ a/b: true
a/b ~ a//b/: true
a//b/ ~ a/b: true
a/b ~ a/c: false
a/b ~ a/b/c: false
a ~ : false
 ~ : true
/a ~ a: false
a ~ /a: false
/ ~ /: true
/* ~ /etc: true
-- star
*.txt ~ notes.txt: true
*.txt ~ .txt: false
*.txt ~ a/notes.txt: false
* ~ : false
a* ~ a: true
*a*b* ~ xaybz: true
*a*b ~ xaybz: false
a*/c ~ abc/c: true
a*/c ~ ab/x/c: false
-- question mark
?.txt ~ a.txt: true
?.txt ~ ab.txt: false
?.txt ~ 文.txt: true
??.txt ~ 文.txt: false
? ~ /: false
-- classes
[abc].txt ~ b.txt: true
[abc].txt ~ d.txt: false
[a-c]x ~ bx: true
[a-c]x ~ dx: false
[!a-c]x ~ dx: true
[^a-c]x ~ bx: false
[]] ~ ]: true
[-a] ~ -: true
[a-] ~ -: true
[\]] ~ ]: true
[ä-ö] ~ é: true
[ä-ö] ~ z: false
[ab ~ [ab: true
[ab ~ a: false
-- escapes
\* ~ *: true
\* ~ a: false
a\? ~ a?: true
a\? ~ ab: false
a\ ~ a\: true
-- double star
** ~ : true
** ~ a/b/c: true
**/*.c ~ main.c: true
**/*.c ~ src/lib/main.c: true
src/**/main.c ~ src/main.c: true
src/**/main.c ~ src/a/b/main.c: true
src/**/main.c ~ lib/a/main.c: false
**/b/** ~ a/b/c/d: true
a/** ~ a: true
a**b ~ axyb: true
a**b ~ ax/yb: false
/**/x ~ /x: true
/**/x ~ x: false
-- hidden names
* ~ .git: false
?git ~ .git: false
[.]git ~ .git: false
.* ~ .git: true
.git ~ .git: true
\.git ~ .git: true
**/*.c ~ .git/main.c: false
**/*.c ~ a/.hidden/main.c: false
.hidden/*.c ~ .hidden/main.c: true
*/x ~ ../x: false
../* ~ ../x: true
-- beyond ASCII
文件* ~ 文件.txt: true
*.ünï ~ a.ünï: true
ünï/**/*.txt ~ ünï/日本/x.txt: true
