// expect: trap
// A top-level actor that has used up its restarts escalates, and with no parent that stops the
// program: each trap is reported, each restart after it, and the last trap is the program's end.
import avin.actors.{Restart, spawn}
import avin.threads.Channel
import avin.time

actor Fragile(log: Channel[string]) receives int
    log.send("starts")
    receive
        n -> log.send(s"${10 / n}")

main()
    val log = Channel[string]()
    val f = spawn(Fragile(log), onFailure = Restart(2, time.hours(1)))
    println(log.receive().get())
    for n in [5, 0, 2, 0, 1, 0, 3]
        f.tell(n)
        println(log.receive().get())
    println("not reached")
