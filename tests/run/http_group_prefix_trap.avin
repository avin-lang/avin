// expect: trap
// A group's prefix begins with `/` and does not end with one, so `/api/` traps where the group is
// made, after `/api` is taken.
import avin.net.http.{Response, Route}

main()
  println(Route.group("/api", [Route.get("/x", _ -> Response.empty(204))]).map(r -> r.pattern))
  println(Route.group("/api/", [Route.get("/x", _ -> Response.empty(204))]).map(r -> r.pattern))
