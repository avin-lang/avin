// expect: exit 0
// Several impls of one trait for instances of one type, beside a generic impl whose bound none of
// them meets, each instance taking the one that holds of it; impls for partly applied instances, whose
// parameters each instance gives; instances of a class reached through a subclass; an impl stating a
// generic trait at the instance's own parameters; and instance impls of data types reached through
// bounds, trait values, static members and the default bodies they keep.

trait Label
  label() -> string
  shout() -> string = label().toUpper

impl Label for int
  label() -> string = s"int $self"
  shout() -> string = s"INT $self"

// Neither `byte` nor `string` is a `Label`, so the generic impl holds of neither instance.
impl Label for Vector[byte]
  label() -> string = s"${length} bytes"

impl Label for Vector[string]
  label() -> string = "words " + mkString("+")

impl[T: Label] Label for Vector[T]
  label() -> string = "[" + map(x -> x.label()).mkString(", ") + "]"

labelOf[T: Label](x: T) -> string = x.label()

// Partly applied: every `Pair` whose second part is an `int`, whatever its first.
data Pair[A, B](first: A, second: B)

impl[K] Label for Pair[K, int]
  label() -> string = s"pair ending ${second}"

impl Label for Pair[string, string]
  label() -> string = s"words $first $second"

// A nested instance: a `Bag` of any `Option`, beside one of `int`.
data Bag[T](value: T)

impl[T] Label for Bag[Option[T]]
  label() -> string = if value.isDefined then "some bag" else "empty bag"

impl Label for Bag[int]
  label() -> string = s"bag of $value"

trait Make
  static make(n: int) -> Self

impl Make for Bag[int]
  static make(n: int) -> Bag[int] = Bag(n * 10)

impl Make for Bag[string]
  static make(n: int) -> Bag[string] = Bag(s"#$n")

made[T: Make](n: int) -> T = T.make(n)

// A class and its subclass: the impl is for the superclass's instance, and holds of the subclass's.
abstract class Shape[T](val tag: T)
  area() -> int

class Square[T](tag: T, val side: int): Shape[T](tag)
  override area() -> int = side * side

impl Label for Shape[string]
  label() -> string = s"shape $tag of area ${area()}"

// A generic trait stated at the instance's own parameter.
trait Into[R]
  into() -> R

impl[K] Into[K] for Pair[K, bool]
  into() -> K = first

convert[R, T: Into[R]](x: T) -> R = x.into()

main()
  val bytes: Vector[byte] = "abc".bytes
  val words: Vector[string] = ["a", "b"]
  println(bytes.label())
  println(words.label())
  println([1, 2].label())
  println([bytes, "d".bytes].label())
  println([words].label())
  println(labelOf(bytes))
  println(labelOf(words))
  println(labelOf([[1], [2, 3]]))
  println(bytes.shout())
  println(words.shout())
  val ls: Vector[Label] = [bytes, words, [4], 5, Pair("k", 1), Bag(Some(1)), Bag(3)]
  for x in ls
    println(x.label())
  println(Pair(true, 7).label())
  println(Pair("x", "y").label())
  println(labelOf(Pair(1.5, 2)))
  println(Bag[Option[string]](None).label())
  println(labelOf(Bag(Some("s"))))
  println(made[Bag[int]](4).value)
  println(made[Bag[string]](4).value)
  println(Bag[int].make(1).value)
  val sq = Square("blue", 3)
  println(sq.label())
  val shape: Shape[string] = sq
  println(labelOf(shape))
  val l: Label = sq
  println(l.shout())
  println(convert[string, Pair[string, bool]](Pair("into", true)))
  println(Pair(42, false).into())
