// expect: exit 0
// A lambda's parameter whose expected type is known in shape but not in every type argument, a
// `Promise[T]` or an `ActorRef[R]` of a `T` or `R` nothing else in the call decides, takes that shape,
// and the lambda's body decides the rest: passing the parameter to a constructor, a function or a
// method that wants a settled type, reading a field of it, or returning it. The type argument so
// decided is the call's, as if written: at an invariant type (`Promise`), a contravariant one
// (`ActorRef`), a covariant one (`Option`), nested inside another, at one of two parameters, beside a
// written parameter type, in a generic method, through a local function, and with the call's result
// passed where a type is expected.
import avin.actors.ActorRef
import avin.threads.Promise

data Msg
    ReadLine(reply: Promise[Option[string]])
    Count(reply: Promise[int])
    Ask(reply: ActorRef[int])
    Pair(left: Promise[string], right: Promise[bool])

// The request helper of a protocol whose replies come back through a promise.
request[T: Sendable](f: (Promise[T]) -> Msg) -> T
    val p = Promise[T]()
    answer(f(p))
    p.future.await()

answer(m: Msg) = m match
    ReadLine(r) -> r.complete(Some("a line"))
    Count(r) -> r.complete(7)
    Pair(l, r) ->
        l.complete("left")
        r.complete(true)
    Ask(_) -> ()

// One whose reply address is contravariant in what it accepts.
// `make` is not called: the call compiles only where `R` is decided.
replyType[R: Sendable](make: (ActorRef[R]) -> Msg) -> string = "decided"

data Box[T](v: T)

fromBox[T](f: (Box[T]) -> T, x: T) -> T = f(Box(x))
width[T](f: (Box[T]) -> int) -> string = "decided"
twice[A, B](f: (Option[A], B) -> string, a: A, b: B) -> string = f(Some(a), b) + f(None, b)
nested[T](f: (Option[Box[T]]) -> T, x: T) -> T = f(Some(Box(x)))
both[T: Sendable](f: (Promise[T], Promise[T]) -> Msg) -> T
    val p = Promise[T]()
    val q = Promise[T]()
    answer(f(p, q))
    q.future.await()

class Service()
    call[T: Sendable](f: (Promise[T]) -> Msg) -> T = request(f)

take(p: Promise[int]) -> Msg = Count(p)

main()
    // Invariant: the constructor's parameter decides `T`.
    println(request(p -> ReadLine(p)))
    println(request(p -> Count(p)))
    // The result then has the type decided, and may be used as one.
    val line: Option[string] = request(p -> ReadLine(p))
    println(line.getOrElse("none") + "!")
    println(request(p -> Count(p)) + 1)
    // A function, not a constructor, decides it.
    println(request(p -> take(p)))
    // A block body.
    println(request(p ->
        val m = Count(p)
        m))
    // Contravariant: `ActorRef[R]` passed where an `ActorRef[int]` is wanted.
    println(replyType(r -> Ask(r)))
    // Reading a field: the result type is then the field's.
    println(fromBox(b -> b.v, "boxed"))
    println(fromBox(b -> b.v + 1, 41))
    // Nothing but the body: `b.v + 0` makes the field an `int`.
    println(width(b -> b.v + 0))
    // A covariant shape, at one of two parameters, the other written.
    println(twice((o, n: int) -> o.map(x -> x + n).getOrElse(-1).toString(), 1, 2))
    // Nested inside another.
    println(nested(o -> o.get.v, 'x'))
    // Two parameters of one open shape, the second deciding it.
    println(both((p, q) -> Count(q)) + 1)
    // In a generic method, and through a written type argument for comparison.
    println(Service().call(p -> ReadLine(p)))
    println(request[int](p -> Count(p)))
