// expect: exit 0
// `select` opens a block only where it ends its line; elsewhere it is an ordinary name: a local, a
// function, a parameter, a method and a field.
class Picker(val select: int)
  pick(select: int) -> int = select + self.select

select(xs: Vector[int], p: (int) -> bool) -> Vector[int] = xs.filter(p)

main() -> int
  val select = 3
  println(select + 1)
  println(main2())
  println(Picker(10).pick(select), Picker(1).select)
  0

main2() -> Vector[int] = select([1, 2, 3, 4], x -> x % 2 == 0)
