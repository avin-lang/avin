// expect: exit 0
// A `select` inside an actor's turn: the turn waits on two channels at once, or with a timeout, and
// the select's value decides what the actor does. The actor's state and the select's bindings are
// seen in the arms, and the turns stay one at a time, in the order told.
import avin.actors.spawn
import avin.threads.{Channel, Promise}
import avin.time.millis

data Msg
  Take(reply: Promise[string])
  Poll(reply: Promise[string])

actor Picker(left: Channel[int], right: Channel[string]) receives Msg
  var turns = 0
  receive
    Take(reply) ->
      turns += 1
      val got = select
        left.receive() as Some(n) -> s"turn $turns: left $n"
        right.receive() as Some(s) -> s"turn $turns: right $s"
      reply.complete(got)
    Poll(reply) ->
      turns += 1
      val got = select
        left.receive() as Some(n) -> s"turn $turns: left $n"
        after 5.millis -> s"turn $turns: nothing"
      reply.complete(got)

main() -> int
  val left = Channel[int]()
  val right = Channel[string]()
  val picker = spawn(Picker(left, right))
  left.send(1)
  val first = Promise[string]()
  picker.tell(Take(first))
  println(first.future.await())
  val second = Promise[string]()
  picker.tell(Take(second))
  right.send("r")
  println(second.future.await())
  val third = Promise[string]()
  picker.tell(Poll(third))
  println(third.future.await())
  left.send(2)
  val fourth = Promise[string]()
  picker.tell(Poll(fourth))
  println(fourth.future.await())
  0
