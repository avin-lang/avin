// A partial function is an `A -> B`: passed to `map` over values in its domain, stored as one and
// called, beside lambdas of the same type, with no conversion.

applyTwice(f: int -> int, x: int) -> int = f(f(x))

main()
    val half: PartialFunction[int, int] = match n if n % 2 == 0 -> n / 2
    println([2, 4, 8].map(half))
    val f: int -> int = half
    println(f(12))
    println(applyTwice(half, 8))
    val names: PartialFunction[int, string] = match
        1 -> "one"
        2 -> "two"
    val fs: Vector[int -> string] = [names, n -> s"#$n"]
    println(fs.map(g -> g(2)))
    println(half.orElse(match n -> n * 10)(3))
