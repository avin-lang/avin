// expect: exit 0
// A trait's default method may make an instance of a type that conforms to the trait at a larger type
// argument, called through the trait: `paired()` on a `Source[int]` makes a `Paired[int]`, a
// `Source[(int, int)]`. The method tables hold `paired` only for the types a call reaches it on, so
// `Paired[int]`'s table does not hold it and the program compiles. A method with type parameters of
// its own, `zip`, a call one level further, on the `Source[(int, int)]`, and a default body calling
// `paired()` on itself are the neighbours.
trait Source[+A]
    get() -> A
    paired() -> Source[(A, int)] = Paired(self)
    zip[B](other: Source[B]) -> Source[(A, B)] = Zipped(self, other)
    first() -> A = paired().get().0

class Paired[A](inner: Source[A]): Source[(A, int)]
    override get() -> (A, int) = (inner.get(), 0)

class Zipped[A, B](left: Source[A], right: Source[B]): Source[(A, B)]
    override get() -> (A, B) = (left.get(), right.get())

class One: Source[int]
    override get() -> int = 1

class Word(text: string): Source[string]
    override get() -> string = text

data Fixed(n: int)

impl Source[int] for Fixed
    get() -> int = n

main()
    val s: Source[int] = One()
    print(s.paired().get().0)
    val twice = s.paired().paired().get()
    print(twice.0.0 + twice.0.1 + twice.1)
    val w: Source[string] = Word("hi")
    val z = s.zip(w)
    print(z.get().1)
    print(z.zip(s).get().1)
    val f: Source[int] = Fixed(7)
    print(f.paired().get().0)
    print(f.zip(w).get().0)
    print(w.first())
    print(f.first())
