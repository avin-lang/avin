// expect: exit 0
// A round-robin router sends each message to the next routee in turn, the routees numbered after the
// router in the order they started; an ask through the router is answered by the routee that took
// it, and the reply reference is the asker's. The router is shown as `Router#n`, and its reference
// compares as the router's.
import avin.actors.{ActorRef, Router, RoundRobin, Behaviour}
import avin.time

data Job
  Who(replyTo: ActorRef[string])
  Add(n: int, replyTo: ActorRef[int])

actor Worker receives Job
  var total = 0

  receive
    Who(replyTo) -> replyTo.tell(s"$self")
    Add(n, replyTo) ->
      total += n
      replyTo.tell(total)

ask(router: ActorRef[Job]) -> string = router.ask(r -> Who(r), timeout = time.seconds(5)).await() match
  Ok(name) -> name
  Err(e) -> e.message

main()
  val router = Router.pool(4, Worker(), RoundRobin)
  println(router)
  println(router == router)
  for _ in 0 ..< 9 do println(ask(router))
  // Each routee keeps its own state: the fifth and later adds land on routees that already hold a
  // total.
  for i in 1 .. 8
    val total = router.ask(r -> Add(i, r), timeout = time.seconds(5)).await()
    println(total)
  // The default routing is round robin.
  val plain = Router.pool(2, Worker())
  for _ in 0 ..< 3 do println(ask(plain))
  // A pool of one sends everything to its one routee.
  val single = Router.pool(1, Worker())
  for _ in 0 ..< 2 do println(ask(single))
