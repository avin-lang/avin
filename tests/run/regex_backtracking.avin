// expect: exit 0
// The backtracking matcher's choices, shape by shape: alternation, every kind of repetition (of a
// character, of a group of one length, of a group of varying length, of any other item) greedy,
// reluctant and possessive, with captures, back references and lookarounds inside them, and the
// spans every group holds afterwards. Each line is the first match with each group's span, then
// every match in turn.
import avin.regex.{Regex, Match}

spans(m: Match) -> string
    val out = StringWriter()
    out.write(s"${m.start()}-${m.end()}")
    for g in 1..m.groupCount() do out.write(s" ${m.start(g)}-${m.end(g)}")
    out.text()

t(pattern: string, input: string)
    val r = Regex(pattern)
    val first = r.findFirstMatchIn(input) match
        Some(m) -> spans(m)
        None -> "none"
    val all = StringWriter()
    for m in r.findAllMatchIn(input) do all.write(s"[${spans(m)}]")
    println(s"$pattern on \"$input\": $first; all ${all.text()}; whole ${r.matches(input)}")

main()
    // Alternation, in order.
    t("a|ab|abc", "abc")
    t("(a|ab)(c|bcd)(d*)", "abcd")
    t("(?:x|y|z)+", "zyxw")
    t("(a|b|)+c", "abbc")
    // A repeated group of varying length: greedy, reluctant, bounded, nested.
    t("(a|ab)*c", "abababc")
    t("(a|ab)*?c", "abababc")
    t("(a|ab){2,3}c", "abababc")
    t("(a|ab){0,1}b", "ab")
    t("((a|b)*c)*", "abcbacc")
    t("((a|b)*?c)+?", "abcbacc")
    t("(a+b)*", "aabab")
    t("(a+b)*ab", "aababab")
    t("(a+?b)*", "aabab")
    t("(?:a+|b)*c", "aabbaac")
    t("(a*)*b", "aaab")
    t("(a*)+b", "aaab")
    t("(a*)+", "b")
    t("(a?)*", "aa")
    t("(|a)*", "aa")
    t("(a|)*b", "aab")
    t("(?:a?)*?b", "aab")
    t("(a|(b))+", "ba")
    t("(a|(b))+", "abab")
    t("((a)|b)+", "ab")
    t("(?:(a)|(b))*", "abba")
    t("(ab|a)(bc|c)*", "abcbc")
    t("(x(?:a|b)*y)+", "xaybxbyy")
    // A repeated group whose body has one length.
    t("(ab)*", "ababab")
    t("(ab)*ab", "ababab")
    t("(ab)*?b", "ababab")
    t("(ab)*+ab", "ababab")
    t("(ab){2}", "ababab")
    t("(ab){1,2}abc", "abababc")
    t("((a)b){0,2}abc", "ababc")
    t("(?:ab)*c", "ababc")
    t("(\\R)*x", "\r\n\n\r\nx")
    t("(\\R)*\nx", "\r\n\n\r\nx")
    t("(\\R)*?\nx", "\r\n\n\r\nx")
    // Any other item repeated: line breaks, graphemes, back references, lookarounds, atomic groups.
    t("\\R*\nx", "\n\r\n\r\nx")
    t("\\R*?\nx", "\n\r\n\r\nx")
    t("\\R*+\nx", "\n\r\n\nx")
    t("\\R?\n", "\r\n")
    t("\\R??\n", "\r\n")
    t("\\X*a", "e\u0301ea")
    t("(a)\\1*", "aaaab")
    t("(a)\\1*?b", "aaaab")
    t("(a)\\1{2}", "aaaa")
    t("(a)\\1?", "aa")
    t("(a)\\1??a", "aa")
    t("(?>a|ab)*b", "abab")
    t("(?>a|ab)*?c", "aabc")
    t("(?>ab|a)+c", "ababac")
    t("(?>a+)b|a+", "aaa")
    t("(?>(a)|b)?b", "ab")
    t("(?=a)*a", "a")
    t("(?=a)?b", "b")
    // Possessive repetitions of groups.
    t("(a|ab)*+c", "ababc")
    t("(a|ab)*+b", "aab")
    t("(?:a|b)++b", "abab")
    t("(a|b)?+b", "ab")
    t("(a|b)?+a", "ab")
    t("a*+a", "aaa")
    t("a?+a", "a")
    // Single characters repeated.
    t("a*ab", "aaab")
    t("a*?ab", "aaab")
    t("a{2,3}", "aaaa")
    t("a{2,3}?", "aaaa")
    t("[ab]+b", "abab")
    t("x*", "axx")
    // Back references inside repeated groups.
    t("(?:(a|b)\\1)*", "aabbab")
    t("(?:(\\w)\\1)+", "aabbcd")
    t("(a*)\\1", "aaaaa")
    t("^(a+)\\1$", "aaaa")
    t("^(a+)\\1$", "aaa")
    t("(?i)(a)\\1+", "aAaA")
    t("((a)|b)\\2", "aa")
    t("(?:(a)|b)*\\1", "abba")
    t("(?:(a)|(b))+\\1\\2", "abab")
    // Lookarounds inside repeated groups.
    t("(?:(?=a)\\w)*", "aab")
    t("(?:a(?!b))*", "aaab")
    t("(?:(?<=a)b|a)+", "abab")
    t("(?:(?<!a)b|a)+", "baab")
    t("(?:x(?=(y)))+", "xyxy")
    t("(?=(a+))a*b\\1", "baaabac")
    t("(?<=(a|bc))x", "bcx")
    t("(?:(?<=ab|b)c)+", "abcc")
    // Anchors and boundaries.
    t("(?:\\b\\w+\\b\\s*)*$", "one two three")
    t("^(?:a|b)*$", "abba")
    t("(?m)(?:^a$\\n?)*", "a\na\nb")
    t("\\G(a|b)", "abc")
    // Unicode.
    t("(é|e)+", "eéé")
    t("(?:\\p{L}\\p{M}*)+", "e\u0301a")
