// expect: exit 0
// A directory the program may not read is still a directory: `isDir` is true and `isFile` false,
// as `metadata` says, while listing it is `PermissionDenied`. A file it may not read is still a file.
// What is inside a directory it may not search cannot be seen at all. A link to the unreadable
// directory answers as the directory does. The mode is set with `chmod`; where the program runs as a
// user the mode does not bind, that is said and the run stops there.
import avin.fs
import avin.process.Command

main()
    val dir = fs.createTempDir("avin-kind") match
        Ok(d) -> d
        Err(e) ->
            println(s"no directory: $e")
            return
    val locked = fs.join(dir, "locked")
    val secret = fs.join(dir, "secret.txt")
    _ = fs.createDir(locked)
    _ = fs.writeText(fs.join(locked, "inner.txt"), "")
    _ = fs.writeText(secret, "s")
    _ = fs.symlink("locked", fs.join(dir, "to-locked"))
    _ = Command("chmod", "000", locked).run()
    _ = Command("chmod", "000", secret).run()
    if fs.listDir(locked).isOk
        println("mode does not bind")
    else
        println(s"${fs.exists(locked)} ${fs.isDir(locked)} ${fs.isFile(locked)}")
        println(fs.metadata(locked).map(m -> (m.isDir, m.isFile)))
        println(fs.listDir(locked).mapErr(e -> e.kind))
        println(s"${fs.isDir(fs.join(dir, "to-locked"))} ${fs.isFile(fs.join(dir, "to-locked"))}")
        println(s"${fs.exists(secret)} ${fs.isDir(secret)} ${fs.isFile(secret)}")
        println(fs.readText(secret).mapErr(e -> e.kind))
        val inner = fs.join(locked, "inner.txt")
        println(s"${fs.isDir(inner)} ${fs.isFile(inner)}")
        // Not there at all, and a dangling link: neither a directory nor a file.
        _ = fs.symlink("missing", fs.join(dir, "dangling"))
        println(s"${fs.isDir(fs.join(dir, "missing"))} ${fs.isFile(fs.join(dir, "missing"))}")
        println(s"${fs.isDir(fs.join(dir, "dangling"))} ${fs.isFile(fs.join(dir, "dangling"))}")
    _ = Command("chmod", "755", locked).run()
    _ = Command("chmod", "644", secret).run()
    println(fs.removeDirAll(dir))
