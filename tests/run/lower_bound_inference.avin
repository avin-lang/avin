// expect: exit 0
// A lower-bounded type argument takes the expected type only where that type admits the bound: where
// a `Display` is expected of a call whose `W >: string`, `W` is `string`, and the result is passed as
// a `Display` is. A delayed (by-name) argument widens the type argument as any other argument does.

open class Animal(val name: string)
class Cat(n: string): Animal(n)
class Dog(n: string): Animal(n)

data Box[+A](item: A)

impl[A] Box[A]
    orElse[W >: A](ok: bool, other: -> W) -> W = if ok then item else other

    withOther[W >: A](other: W) -> W = other

    both[W >: A](other: W) -> Vector[W] = [item, other]

shout(d: Display) -> string = s"$d!"

main()
    val words = Box("hi")
    println(words.orElse(true, "no"), words.withOther("other"))
    println(shout(words.withOther("there")))
    val shown: Display = words.orElse(false, "fallback")
    println(shown)

    // A reference type the expected type decides is still taken.
    val cats = Box(Cat("Tom"))
    val a: Animal = cats.withOther(Dog("Rex"))
    println(a.name)
    val animals: Vector[Animal] = cats.both(Dog("Rex"))
    println(animals.map(x -> x.name))

    // A delayed argument of a supertype widens `W`.
    val picked = cats.orElse(false, Dog("Rex"))
    val first: Animal = picked
    println(first.name, cats.orElse(true, Dog("Rex")).name)
    println(cats.orElse(true, fail("a delayed argument not read is not evaluated")).name)
