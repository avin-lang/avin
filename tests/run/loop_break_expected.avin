// expect: exit 0
// The type a loop is expected to yield reaches the values of its `break`s, as it reaches a
// literal bound to a declared type.
take(n: long) -> long = n + 1

fromReturn() -> long
    return loop
        break 14

fromDeclared() -> real
    var i = 0
    val r: real = while i < 3 do
        i += 1
        if i == 2 then break 2
    else 7
    r

main() -> int
    val n: long = loop
        break 14
    print(n)

    print(take(loop do break 20))
    print(fromReturn())
    print(fromDeclared())

    val f: () -> long = () -> loop
        break 5
    print(f())

    val o: Option[long] = loop
        break Some(8)
    print(o)

    var k = 0
    val mixed: long = loop
        k += 1
        if k == 1 then continue
        if k == 2 then break 1
        break n
    print(mixed)

    var j = 0
    val w: long = while j < 5 do
        j += 1
        if j == 3 then break 30
    else 40
    print(w)

    // The inner loop is a statement: its `break` is not given the outer loop's type.
    val outer: long = loop
        var count = 0
        loop
            count += 1
            if count == 2 then break
        break 99
    print(outer)
    0
