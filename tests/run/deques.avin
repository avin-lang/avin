// expect: exit 0
// A deque adds and removes at both ends, so it is a queue and a stack alike; its elements wrap around
// the end of its array and stay in order as it grows. It is read and replaced by index, compares and
// hashes by its elements, displays as an array does, and is built by its builder and by a literal.

class Job(val id: int)

drain(d: Deque[Job]) -> string
    var out = ""
    while d.nonEmpty() do out = out + s"${d.removeFirst().id} "
    out

main()
    // A queue: in at the back, out at the front.
    val queue = Deque[Job]()
    for i in 1..5 do queue.addLast(Job(i))
    println(drain(queue))
    println(queue.isEmpty())

    // A stack: in and out at the back.
    val stack = Deque[string]()
    stack.addLast("a")
    stack.addLast("b")
    stack.addLast("c")
    println(s"${stack.removeLast()}${stack.removeLast()}${stack.removeLast()} ${stack.length()}")

    // Both ends at once, and every index after each change.
    val d = Deque[int]()
    d.addFirst(2)
    d.addLast(3)
    d.addFirst(1)
    d.addFirst(0)
    println(d)
    d(0) = 10
    d(3) += 30
    println(d)
    println(debug(Deque.empty[string]()))
    println(s"${d.removeFirst()} ${d.removeLast()} $d")

    // Elements that wrap around the end of the array keep their order as it grows, references
    // surviving the collections the growth sets off.
    val ring = Deque[Job]()
    for i in 0 ..< 6 do ring.addLast(Job(i))
    for i in 0 ..< 4 do ring.removeFirst()
    for i in 6 ..< 12 do ring.addLast(Job(i))
    for i in 1..3 do ring.addFirst(Job(-i))
    var ids = ""
    for j in ring do ids = ids + s"${j.id} "
    println(ids)
    val mixed = Deque[Job]()
    for i in 0 ..< 2000
        mixed.addLast(Job(i))
        if i % 3 == 0 then mixed.addFirst(Job(-i))
        if i % 2 == 0 then mixed.removeFirst()
    var sum = 0
    for j in mixed do sum += j.id
    println(s"${mixed.length()} $sum ${mixed.head().id} ${mixed.last().id}")
    mixed.clear()
    mixed.addFirst(Job(7))
    println(s"${mixed.length()} ${mixed(0).id}")

    // Literals, the builder, conversions, comparison and joining.
    val lit: Deque[string] = ["x", "y"]
    lit.addFirst("w")
    println(debug(lit))
    val built = Deque.builder[int]()
    built.add(1)
    built.addAll([2, 3])
    val three = built.result()
    println(three == [1, 2, 3])
    val other: Deque[int] = [0, 1, 2]
    other.removeFirst()
    other.addLast(3)
    println(s"${three == other} ${three.hash() == other.hash()}")
    println(three.mkString("<", "|", ">"))
    println(s"${three.toVector()} ${three.toArray().length()} ${three.toList()}")
    three.display(StandardOutput, FormatSpec(width = 12))
    three.debug(StandardOutput, FormatSpec(width = 12, left = true))
    println("|")
    println(three.get(5).getOrElse(-1))
