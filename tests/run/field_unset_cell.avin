// expect: exit 0
// The core library's cells: a field left unset by `field_unset` holds zero bytes, not yet a value,
// until the class's own code writes it, and a covariant class may keep its element in such a `var`.
// The collector runs at every allocation here, between the making of a cell and its filling, so it
// meets the unset fields of every kind of element: a scalar, a wide integer, a reference, a union with
// a scalar member, an option, a function and a unit. A cell seen through a wider type reads what was
// stored for it.
module avin

@intrinsic("field_unset")
private unsetField[T]() -> T

class Slot[+T]
  private var item: T = unsetField()
  private var next: Slot[T] = unsetField()
  private var filled = false

  get() -> T = if filled then item else fail("an empty slot")

  following() -> Slot[T] = next

  isFilled() -> bool = filled

object Slot
  // A slot never filled; only the class and its companion make one, since its fields start unset.
  empty[T]() -> Slot[T] = Slot[T]()

  of[T](x: T) -> Slot[T]
    val s = Slot[T]()
    // Garbage between the making and the filling, so the collector runs over the unset fields.
    val noise = Vector.tabulate(8, i -> s"$i")
    s.item = x
    s.next = s
    s.filled = noise.length == 8
    s

  linked[T](x: T, after: Slot[T]) -> Slot[T]
    val s = of(x)
    s.next = after
    s

open class Animal(val name: string)

class Dog(name: string): Animal(name)

main()
  val empty = Slot.empty[int]()
  println(empty.isFilled())
  println(Slot.of(42).get())
  println(Slot.of(int.MinValue).get())
  println(Slot.of(long.MaxValue).get())
  println(Slot.of(i128(170141183460469231731687303715884105727)).get())
  println(Slot.of(1.5).get())
  println(Slot.of(true).get())
  println(Slot.of('日').get())
  println(Slot.of("é👋").get())
  val u: int | string = "union"
  println(Slot.of(u).get())
  val v: int | string = 7
  println(Slot.of(v).get())
  println(Slot.of(Some(3)).get())
  val none: Option[string] = None
  println(Slot.of(none).get())
  println(Slot.of((1, "one")).get())
  val f = Slot.of((n: int) -> n * 2).get()
  println(f(21))
  Slot.of(()).get()
  println("unit")
  // Seen as a slot of animals, a slot of dogs gives its dog.
  val dogs: Slot[Animal] = Slot.of(Dog("rex"))
  println(dogs.get().name)
  val chain = Slot.linked(1, Slot.linked(2, Slot.of(3)))
  var s = chain
  var total = 0
  for _ in 0 ..< 3
    total += s.get()
    s = s.following()
  println(total)
