// expect: exit 0
// A class's constructor runs its superclass's first, then stores its parameters, then computes the
// fields of its traits, a trait's required traits before it and each trait once, in the order of
// its `:` list, and then runs its own body. A trait's field may read the fields initialized before
// it: its own trait's earlier ones, a required trait's, and a class parameter supplying a `val`.
// Generic traits' fields take the class's type arguments, and are reached through a type
// parameter's bound as through the trait.
trace(what: string, value: int) -> int
    println(what)
    value

trait Base
    val b: int = trace("Base.b", 1)

trait Left: Base
    val l: int = trace("Left.l", b + 10)
    val l2: int = trace("Left.l2", l + 1)

trait Right: Base
    var r: int = trace("Right.r", b + 20)

open class Root(val tag: string)
    val rootField = trace(s"Root body $tag", 0)

open class Leaf(tag: string, val n: int): Root(tag), Right, Left
    val own = trace(s"Leaf body ${n + l + l2 + r}", 3)

class Twig: Leaf("twig", 0), Base
    val twig = trace("Twig body", b)

trait Box[T]
    var item: Option[T] = None
    put(x: T) = item = Some(x)
    take() -> Option[T]
        val out = item
        item = None
        out

class IntBox: Box[int]
class Pair[A](val first: A): Box[A]
class Named: Box[string]
object Shelf: Box[string]

fill[B: Box[string]](box: B, text: string) -> string
    box.item = Some(text)
    box.item.getOrElse("empty")

trait Greeter
    val name: string
    val greeting: string = "hello, " + name

class Person(val name: string): Greeter

main()
    val leaf = Leaf("t", 5)
    println(leaf.l2)
    leaf.r = 99
    val right: Right = leaf
    println(right.r)
    val base: Base = leaf
    println(base.b)
    val twig = Twig()
    println(twig.twig)
    val box = IntBox()
    box.put(4)
    println(box.item.getOrElse(0))
    println(box.take().getOrElse(-1))
    println(box.take().getOrElse(-1))
    val pair = Pair[string]("a")
    pair.put("b")
    val held: Box[string] = pair
    println(held.item.getOrElse("?"))
    println(fill(Named(), "through the bound"))
    println(fill(pair, "pair"))
    Shelf.put("on the shelf")
    println(Shelf.item.getOrElse("?"))
    println(Person("ada").greeting)
    var boxes: Vector[Box[string]] = []
    for i in 0..<300
        val b = Pair[int](i)
        b.put(i * 2)
        val s = Named()
        s.put(s"box $i")
        boxes = boxes :+ s
    var total = 0
    for b in boxes
        total += b.item.map((t) -> t.byteLength()).getOrElse(0)
    println(total)
