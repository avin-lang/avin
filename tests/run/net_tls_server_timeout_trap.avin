// expect: trap
// A server handshake's timeout below zero, by a microsecond, traps before the handshake begins.
import avin.net.{TcpListener, TcpStream}
import avin.net.tls.{TlsServer, TlsStream}
import avin.time.micros

main()
  val listener = TcpListener.bind("127.0.0.1", 0).ok.get
  val client = TcpStream.connect("127.0.0.1", listener.port()).ok.get
  val accepted = listener.accept().ok.get
  println("accepted")
  _ = TlsStream.server(accepted, TlsServer("", ""), micros(-1))
  _ = client.close()
