// expect: trap
// `T.MaxValue` is the instance's greatest value, so arithmetic past it traps at that width: at
// `int` the sum below fits, and at `i8` it is one past `127`.

bump[T: Integer](x: T) -> T = T.MaxValue - T(100) + x

main()
    println(bump(100))
    val b: i8 = 101
    println(bump(b))
