// expect: exit 0
// Commands in `avin.cli`: a parser taking commands, each read by a parser of its own, with the
// program's options before the command word and the command's after it; commands of commands; the
// usage line and the help listing the commands; `help <command>` and `<command> --help`; an unknown
// command answered with the command it was most likely meant to be; and the error's `report` and
// `exitCode`, which a program reading one command line after another writes before carrying on.
import avin.cli

val add = cli.Parser("add", "Add a task.")
  .choice("priority", ["high", "normal", "low"], short = 'p', default = "normal")
  .string("tag", short = 't', help = "a tag for the task", repeated = true)
  .positionals("words", help = "the task's title", required = true)

val remote = cli.Parser("remote", "Manage the remotes.")
  .flag("verbose", short = 'v')
  .command(cli.Parser("add", "Add a remote.").positional("name").positional("url"))
  .command(cli.Parser("remove", "Remove a remote.").positional("name"))

val todo = cli.Parser("todo", "Keep a to-do list.", version = "0.3")
  .string("file", short = 'f', help = "the list", default = "todo.txt")
  .flag("quiet", short = 'q', help = "say less")
  .command(add)
  .command(cli.Parser("list", "List the tasks.").flag("all", short = 'a', help = "list finished tasks too"))
  .command(cli.Parser("stats", "Count the tasks."))
  .command(remote)

shown(p: cli.Parser, args: Vector[string])
  p.parse(args) match
    Ok(a) -> println(s"ok: ${described(a)}")
    Err(cli.HelpRequested(text)) -> print(s"help:\n$text")
    Err(cli.VersionRequested(text)) -> println(s"version: $text")
    Err(cli.Invalid(reason, usage, program, hint)) -> println(s"invalid: $reason | $usage | $program | $hint")

described(a: cli.Args) -> string = a.command match
  "" -> "no command"
  "add" -> s"add ${a.commandArgs.string("priority")} ${a.commandArgs.strings("tag")} ${a.commandArgs.strings("words")}"
  "list" -> s"list all=${a.commandArgs.flag("all")}"
  "remote" ->
    val r = a.commandArgs
    s"remote verbose=${r.flag("verbose")} ${r.command} ${described(r.commandArgs)}"
  c -> c

main()
  println("-- dispatch")
  shown(todo, ["add", "milk"])
  shown(todo, ["add", "-p", "high", "--tag", "home", "buy", "milk", "-t", "shop"])
  shown(todo, ["list", "-a"])
  shown(todo, ["list"])
  shown(todo, ["stats"])
  val a = todo.parse(["-q", "--file", "work.txt", "stats"]).ok.get
  println(s"${a.command} ${a.string("file")} ${a.flag("quiet")} ${a.given("file")}")
  val b = todo.parse(["stats"]).ok.get
  println(s"${b.command} ${b.string("file")} ${b.flag("quiet")} ${b.given("file")}")
  println("-- a value that looks like a command is the option's")
  val c = todo.parse(["--file", "list", "stats"]).ok.get
  println(s"${c.command} ${c.string("file")}")
  val d = todo.parse(["--file=add", "list"]).ok.get
  println(s"${d.command} ${d.string("file")}")
  println("-- after `--`, the command; its own `--` is its own")
  shown(todo, ["--", "list"])
  shown(todo, ["--", "add", "-p", "low", "x"])
  shown(todo, ["add", "--", "-p", "--tag"])
  println("-- commands of a command")
  shown(todo, ["remote", "add", "origin", "git@host"])
  shown(todo, ["remote", "-v", "remove", "origin"])
  shown(todo, ["remote"])
  shown(todo, ["remote", "rename"])
  shown(todo, ["remote", "add", "origin"])
  println("-- the program's options come before the command")
  shown(todo, ["list", "--file", "x"])
  shown(todo, ["list", "-q"])
  println("-- missing and unknown commands")
  shown(todo, [])
  shown(todo, ["-q"])
  shown(todo, ["lst"])
  shown(todo, ["ad"])
  shown(todo, ["stat"])
  shown(todo, ["rem"])
  shown(todo, ["re"])
  shown(todo, ["frobnicate"])
  shown(todo, ["LIST"])
  shown(todo, [""])
  shown(todo, ["-"])
  shown(todo, ["hepl"])
  println("-- usage and help")
  println(todo.usage)
  println(remote.usage)
  print(todo.help)
  println("-- help requests")
  shown(todo, ["--help"])
  shown(todo, ["-h", "nosuch"])
  shown(todo, ["help"])
  shown(todo, ["help", "add"])
  shown(todo, ["add", "--help"])
  shown(todo, ["add", "-h"])
  shown(todo, ["add", "--bogus", "--help"])
  shown(todo, ["help", "remote", "add"])
  shown(todo, ["remote", "help", "add"])
  shown(todo, ["remote", "add", "--help"])
  shown(todo, ["help", "help"])
  shown(todo, ["help", "remote", "help"])
  shown(todo, ["help", "lst"])
  shown(todo, ["help", "stats", "extra"])
  shown(todo, ["help", "remote", "rmove"])
  println("-- the version is the program's, before the command")
  shown(todo, ["--version"])
  shown(todo, ["list", "--version"])
  println("-- a mistake in the command's own arguments")
  shown(todo, ["add"])
  shown(todo, ["add", "-p", "urgent", "x"])
  shown(todo, ["stats", "extra"])
  println("-- a required option of the program's, with a command")
  val strict = cli.Parser("strict").string("to", required = true).command(cli.Parser("go").flag("fast"))
  print(strict.help)
  shown(strict, ["go"])
  shown(strict, ["--to", "x", "go", "--fast"])
  shown(strict, ["go", "--help"])
  shown(strict, ["go", "--slow"])
  println("-- a program's own `help` command")
  val own = cli.Parser("own").command(cli.Parser("help", "The program's own help.").positionals("topic"))
  print(own.help)
  shown(own, ["help", "x", "y"])
  shown(own, ["hlp"])
  shown(own, ["--help"])
  println("-- a program without --help of its own: the hint names `help`")
  val bare = cli.Parser("bare").flag("help").command(cli.Parser("run"))
  shown(bare, ["walk"])
  shown(bare, ["--help", "run"])
  val none = cli.Parser("none").flag("help").command(cli.Parser("help"))
  shown(none, ["walk"])
  println("-- Unicode commands")
  val wide = cli.Parser("ünï").command(cli.Parser("größe", "wie groß")).command(cli.Parser("文件", "文件"))
  print(wide.help)
  shown(wide, ["große"])
  shown(wide, ["文件"])
  shown(wide, ["文"])
  println("-- a parser without commands")
  val plain = cli.Parser("plain").flag("x").parse(["--x"]).ok.get
  println(s"command: `${plain.command}`")
  println("-- report and exitCode, without ending the program")
  for line in [["lst"], ["add"], ["--version"], ["help", "stats"], ["stats"]]
    todo.parse(line) match
      Ok(r) -> println(s"ran ${r.command}")
      Err(e) ->
        print(e.report)
        println(s"(exit ${e.exitCode}, message `${e.message}`, shown `$e`)")
  println("-- a parser unchanged by a command added to a copy")
  val base = cli.Parser("base").flag("x")
  val more = base.command(cli.Parser("go"))
  shown(base, ["--x"])
  shown(more, ["--x", "go"])
  shown(base, ["go"])
