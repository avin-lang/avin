// expect: exit 0
// A refined variant bounding its own parameter, which its result names: `Sorted[A: Ord]` is made only
// at ordered types, and in an arm on it the enclosing code's `T`, equated with `A`, is `Ord` too, so
// the arm may compare and take the least of its elements. The bound is gained through a clause, a
// `match`, an `is` test with an early return, a nested `match`, a lambda made in the arm, a class's
// method and a local generic function, and by a parameter equated with a part of the result
// (`Conv2`'s `A: Into[B]`, both in a tuple). A copy at a type without the bound (`Thing`) holds no
// `Sorted`, and its arm is left out; a value is made in an arm under the bound it gained (`resort`,
// `insert`). The derived `Display`, `Eq` and `Hash` cover the variants an instance holds.
data Coll[T] derives Display, Eq, Hash
  Plain(items: Vector[T])
  Sorted[A: Ord](items: Vector[A]) -> Coll[A]

data Tree[T]
  Leaf
  Node[A: Ord](left: Tree[A], value: A, right: Tree[A]) -> Tree[A]

data Shown[T]
  Bare(value: T)
  Labelled[A: Display](value: A) -> Shown[A]

trait Into[X]
  into() -> X

class Meters(val m: int): Into[string]
  override into() -> string = s"${m}m"

data Conv[T]
  Raw(value: T)
  Conv2[A: Into[B], B](a: A, fallback: B) -> Conv[(A, B)]

class Thing(val n: int)

class Shape(val name: string): Display
  override display(out: Writer, spec: FormatSpec) = out.write(s"<$name>")

smallestC[T](c: Coll[T]) -> Option[T]
smallestC(Sorted(items)) = items.minOption
smallestC(Plain(_)) = None

viaIs[T](c: Coll[T]) -> Option[T] =
  if c is Sorted(items) then return items.maxOption
  None

resort[T](c: Coll[T]) -> Coll[T] = c match
  Plain(items) -> Plain(items)
  Sorted(items) -> Sorted(items.reverse)

insert[T](t: Tree[T], x: T) -> Tree[T] = t match
  Leaf -> Leaf
  Node(l, v, r) ->
    val grow = (u: Tree[T]) -> u match
      Leaf -> Node(Leaf, x, Leaf)
      Node(_, _, _) -> insert(u, x)
    if x < v then Node(grow(l), v, r)
    elif x > v then Node(l, v, grow(r))
    else t

inOrder[T](t: Tree[T]) -> Vector[T] = t match
  Leaf -> []
  Node(l, v, r) -> inOrder(l) ++ [v] ++ inOrder(r)

both[T](c: Coll[T], s: Shown[T], x: T, y: T) -> string = c match
  Plain(_) -> "plain"
  Sorted(_) -> s match
    Bare(_) -> s"bare ${x < y}"
    Labelled(_) -> s"$x ${x < y} $y"

later[T](c: Coll[T]) -> () -> Option[T] = c match
  Plain(_) -> () -> None
  Sorted(items) -> () -> items.minOption

convert[X, Y](c: Conv[(X, Y)]) -> Y = c match
  Raw((_, y)) -> y
  Conv2(a, _) -> a.into()

class Holder[T](val c: Coll[T])
  least() -> Option[T] = c match
    Plain(_) -> None
    Sorted(items) -> items.minOption

local[T](c: Coll[T]) -> Option[T] =
  inner[U](d: Coll[U]) -> Option[U] = d match
    Plain(_) -> None
    Sorted(items) -> items.minOption
  inner(c)

data Ranked[T]
  Empty
  Run[A: Ord](items: Vector[A]) -> Ranked[A]
  Titled[A: Ord, B: Display](items: Vector[A], label: B) -> Ranked[A]

describe[T](s: Ranked[T]) -> string = s match
  Empty -> "empty"
  Run(items) -> s"node ${items.maxOption.isEmpty}"
  Titled(items, label) -> s"$label ${items.length} ${items.length > 1 && items(0) < items(1)}"

main()
  val s: Coll[int] = Sorted([3, 1, 2])
  println(smallestC(s))
  println(viaIs(s))
  println(resort(s))
  println(s == Sorted([3, 1, 2]))
  println(s == Plain([3, 1, 2]))
  println(Set(s, Sorted([3, 1, 2]), Plain([1])).size)
  println(smallestC(Coll[long].Sorted([long(9), long.MinValue])))
  val p: Coll[Thing] = Plain([Thing(1)])
  println(smallestC(p).isEmpty)
  println(viaIs(p).isEmpty)
  val ps: Coll[Shape] = Plain([Shape("sq")])
  println(ps)
  var t: Tree[int] = Node(Leaf, 5, Leaf)
  for x in [3, 8, 1, 4, 9, 5]
    t = insert(t, x)
  println(inOrder(t))
  println(inOrder(Tree[Thing].Leaf).length)
  println(both(s, Labelled(1), 1, 2))
  println(both(Sorted(["b"]), Bare("x"), "b", "a"))
  println(later(s)())
  println(later(Plain([Thing(2)]))().isEmpty)
  println(convert(Conv2(Meters(3), "none")))
  println(Holder(s).least())
  println(local(Sorted(["ü", "ä"])))
  println(Sorted[string](["", "a"]))
  println(describe(Run([1])))
  println(describe(Titled([1, 2], "one")))
  println(describe(Titled(["b", "a"], 2.5)))
  println(describe(Ranked[int].Empty))
  var total = long(0)
  for i in 0 ..< 3000
    val c: Coll[long] = Sorted([long(i), long(i) * 2, long(-i)])
    total += smallestC(c).getOrElse(long(0))
    val keep = later(Sorted([s"$i", "x"]))
    if i % 1000 == 0 then println(keep())
  println(total)
