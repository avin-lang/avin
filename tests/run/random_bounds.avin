// expect: exit 0
// Every bounded draw stays inside its bounds, at the smallest and largest bounds the types allow, a
// bound of one gives only zero, and a small bound's values come up about equally often.
import avin.random.Random

main()
    val g = Random(2026)
    var ok = true
    for bound in [1, 2, 3, 7, 100, 1000003, int.MaxValue]
        for i in 0..<2000
            val r = g.nextInt(bound)
            if r < 0 || r >= bound then ok = false
    println(s"nextInt(bound) in range: $ok")

    ok = true
    for bound in [long(1), long(2), long(5000000000), long.MaxValue / 3 * 2, long.MaxValue]
        for i in 0..<2000
            val r = g.nextLong(bound)
            if r < 0 || r >= bound then ok = false
    println(s"nextLong(bound) in range: $ok")

    var onlyZero = true
    for i in 0..<100 do if g.nextInt(1) != 0 || g.nextLong(long(1)) != 0 then onlyZero = false
    println(s"bound of one gives zero: $onlyZero")

    ok = true
    var sawMin = false
    for i in 0..<2000
        val a = g.between(-3, 4)
        if a < -3 || a >= 4 then ok = false
        if a == -3 then sawMin = true
        val b = g.between(int.MinValue, int.MaxValue)
        if b == int.MaxValue then ok = false
        val c = g.between(long.MinValue, long.MaxValue)
        if c == long.MaxValue then ok = false
        val d = g.between(long(-10), long(-9))
        if d != -10 then ok = false
        val e = g.between(int.MaxValue - 1, int.MaxValue)
        if e != int.MaxValue - 1 then ok = false
    println(s"between on integers in range: $ok, least reached: $sawMin")

    ok = true
    for i in 0..<5000
        val u = g.nextReal()
        if u < 0.0 || u >= 1.0 then ok = false
        val v = g.between(-1.5, 2.5)
        if v < -1.5 || v >= 2.5 then ok = false
        val w = g.between(1.0, 1.0000000000000002)
        if w != 1.0 then ok = false
    println(s"reals in range: $ok")

    val counts = Array.fill(6, 0)
    for i in 0..<60000 do counts(g.nextInt(6)) += 1
    println(s"each face near 10000: ${counts.forall(n -> 9500 < n < 10500)}")

    var trues = 0
    for i in 0..<10000 do if g.nextBoolean() then trues += 1
    println(s"booleans near half: ${4800 < trues < 5200}")

    println(s"no bytes: ${g.nextBytes(0).length}, seven bytes: ${g.nextBytes(7).length}")
    val text = g.alphanumeric().take(2000).toVector
    println(s"alphanumeric: ${text.length} ${text.forall(c -> c.isLetterOrDigit && c < '{')}")
    println(s"all 62 drawn: ${text.toSet.size}")
