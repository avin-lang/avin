// A type parameter bounded by another, `[B: A]`: a value of `B` is a value of `A` with no conversion,
// and has `A`'s bounds' members. The bounding parameter may be an earlier one of the same list or the
// enclosing class's, and a trait may bound the same parameter beside it.
trait Named
  name() -> string

trait Loud
  loud() -> string

open class Animal(val label: string): Named
  override name() -> string = label
  sound() -> string = "..."

open class Dog(label: string): Animal(label), Loud
  override sound() -> string = "woof"
  override loud() -> string = "WOOF"

class Puppy(label: string): Dog(label)

// An earlier parameter of the same list: a `B` is returned as an `A`.
firstOf[A: Named, B: A](a: A, b: B) -> A = if b.name().byteLength > 3 then b else a

// The bound used in the body: `A`'s bound's method on a `B`, and a `B` stored as an `A`.
describe[A: Named, B: A](b: B) -> string
  val asA: A = b
  s"${b.name()}/${asA.name()}"

// A chain: a `C` is a `B` and so an `A`, and has `A`'s bound.
chain[A: Named, B: A, C: B](c: C) -> string
  val b: B = c
  val a: A = b
  val again: A = c
  s"${c.name()} ${a.name()} ${again.name()}"

// A type parameter and a trait bound one parameter together.
shout[A: Named, B: A & Loud](a: A, b: B) -> string
  val pick: A = if a.name() == "" then b else a
  s"${b.name()} ${b.loud()} ${pick.name()}"

// The bounding parameter joins with the bounded one: the branches agree on `A`.
either[A, B: A](flag: bool, a: A, b: B) -> A = if flag then a else b

// Values of `B` gathered where `A`s are: a vector of `B` is read as `A`s one by one, and a closure
// captures a `B` and yields it as an `A`.
gather[A, B: A](a: A, bs: Vector[B]) -> Vector[A]
  var out: Vector[A] = [a]
  for b in bs
    out = out :+ b
  out

later[A, B: A](b: B) -> () -> A = () -> b

class Pen[T](val held: T)
  // A class's type parameter as the bound of a method's own.
  swap[U: T](other: U) -> Pen[T] = Pen(other)
  keep[U: T](others: Vector[U]) -> Vector[T]
    var out: Vector[T] = [held]
    for o in others
      out = out :+ o
    out

main()
  println(firstOf(Animal("cat"), Dog("rex")).name())
  println(firstOf(Animal("cat"), Dog("fido")).name())
  println(describe[Animal, Dog](Dog("fido")))
  println(describe(Dog("fido")))
  println(chain[Animal, Dog, Puppy](Puppy("pip")))
  println(chain[Named, Animal, Dog](Dog("rex")))
  println(shout(Animal("cow"), Dog("rex")))
  println(shout(Animal(""), Dog("rex")))
  println(either(true, Animal("a"), Dog("b")).name())
  println(either(false, Animal("a"), Dog("b")).name())
  println(either(false, "a", "b"))
  println(either(true, 1, 2))
  println(gather(Animal("cow"), [Dog("a"), Puppy("b")]).map(x -> x.name()))
  println(gather(Animal("cow"), Vector.empty[Dog]()).length)
  println(later[Animal, Dog](Dog("held"))().sound())
  val p = Pen[Animal](Animal("cow")).swap(Dog("rex"))
  println(p.held.sound())
  println(Pen[Animal](Animal("cow")).keep([Dog("a"), Dog("b")]).length)
  println(Pen[Named](Animal("cow")).swap(Dog("rex")).held.name())
  println(Pen[Animal](Animal("cow")).swap[Puppy](Puppy("pip")).held.sound())
  println(Pen[long](1).swap(long(2)).held)
  println(Pen[string]("").swap("é").held)
