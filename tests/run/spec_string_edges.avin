// expect: exit 0
// The string methods at their edges: the empty string and empty patterns, offsets before, at and
// past the ends, characters of more than one byte, the two kinds of white space, the number readers'
// accepted and refused forms, ordering by code point, and the char classifiers outside ASCII.

main()
    println(s"${"".startsWith("")} ${"ab".endsWith("")} ${"".contains("")} ${"ab".startsWith("b", 1)} ${"ab".startsWith("bc", 1)} ${"ab".startsWith("a", 5)}")
    println(s"${"aaa".replace("aa", "b")} ${"abc".replace("", "x")} ${"".replace("a", "b")}")
    println(s"${"abcabc".indexOf("c")} ${"abcabc".indexOf("c", 3)} ${"abc".indexOf("a", -5)} ${"abc".indexOf("a", 9)} ${"abc".indexOf("", 2)} ${"abc".indexOf('b')}")
    println(s"${"abcabc".lastIndexOf("a")} ${"abcabc".lastIndexOf("a", 2)} ${"abc".lastIndexOf("")} ${"abc".lastIndexOf("", 1)} ${"abc".lastIndexOf("", 50)} ${"abc".lastIndexOf('z')}")
    println(s"${"a1b2".indexWhere(c -> c.isDigit())} ${"a1b2".indexWhere(c -> c.isDigit(), 2)} ${"a1b2".lastIndexWhere(c -> c.isDigit())} ${"a1b2".lastIndexWhere(c -> c.isDigit(), 2)} ${"a1".lastIndexWhere(c -> true, -1)}")
    println(s"${"".headOption()} ${"xé".lastOption()} ${"xé".last()}")
    println(s"${"prefix".stripPrefix("pre")} ${"prefix".stripPrefix("x")} ${"prefix".stripSuffix("fix")} ${"éa".capitalize()} ${"Ab".capitalize()}")
    println(s"[${"  a ".strip()}] [${" a ".trim()}] [${" a ".stripLeading()}] [${" a ".stripTrailing()}]")
    println(s"${"ab".repeat(0).isEmpty()} ${"ab".repeat(3)}")
    println(",a,,b,".split(","))
    println("abc".split(","))
    println("a\nb\n".lines())
    println("".lines())
    println("a\r\nb\rc".lines().length)
    println(s"${" \t".isBlank()} ${"".isBlank()} ${"x".isBlank()}")
    println(s"${"héllo".reverse()} [${"é".padStart(3, '*')}] [${"abc".padEnd(2)}] [${"a".padTo(3, '.')}]")
    println(s"${"STRAßE".equalsIgnoreCase("straße")} ${"straße".toUpperCase()}")
    println(s"${"héllo".take(2)} ${"héllo".drop(2)} ${"héllo".take(-1).isEmpty()} ${"héllo".take(99)} ${"héllo".takeRight(3)} ${"héllo".dropRight(4)}")
    println(s"${"+12".toInt()} ${"-0".toInt()} ${"9223372036854775807".toLong()} ${"12x".toIntOption()} ${"2147483648".toIntOption()} ${"".toIntOption()}")
    println(s"${"3.25".toReal()} ${"-.5".toReal()} ${"1e10".toReal()} ${" 1".toRealOption()} ${"nan".toRealOption()} ${"1e400".toRealOption()} ${"5.".toRealOption()}")
    println(s"${"café".byteLength()} ${"café".charCount()} ${"café".slice(3, 5)} ${"café".count(c -> c > 'b')}")
    println(s"${"b" > "a"} ${"é" > "z"} ${"ab" < "abc"} ${"" < "a"}")
    println(s"${'٣'.asDigit()} ${'z'.asDigit()} ${'Ｚ'.asDigit()} ${'!'.asDigit()} ${'ß'.toUpper()} ${' '.isWhitespace()} ${' '.isSpaceChar()} ${'\u001c'.isWhitespace()}")
    println(s"${"|a\n  |b\n c".stripMargin()}")
    println(s"${"#a\n #b".stripMargin('#')}")
