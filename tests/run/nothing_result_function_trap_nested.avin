// expect: trap
// A function yielding a function whose result is `Nothing`, converted to one yielding a function of a
// `real`, and a captured method value converted the same way: making the inner function runs nothing
// that fails, and calling it reaches the failing code, whose trap stops the program.

class Gate(val name: string)
    shut() -> Nothing = fail(s"$name is shut")

level(gate: Gate) -> () -> Nothing = gate.shut

main()
    val gate = Gate("north")
    val outer: (Gate) -> () -> real = level
    val inner = outer(gate)
    println("made")
    println(inner() + 1.5)
