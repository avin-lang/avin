// Standard input longer than one read of it, character by character: a character whose bytes fall
// on both sides of where a read stopped is still one character, a sequence cut short by a line's end
// across another such place is one U+FFFD, and so is one cut short by the end of the input.
import avin.io.Source

main()
  var count = 0
  var aCount = 0
  var bCount = 0
  val others = Buffer[string]()
  for c in Source.stdin().chars()
    if c == 'a' then aCount += 1
    elif c == 'b' then bCount += 1
    elif c == '\n' then others.addOne(s"$count:\\n")
    else others.addOne(s"$count:$c")
    count += 1
  println(s"$count chars, $aCount a, $bCount b")
  println(others.mkString(" "))
