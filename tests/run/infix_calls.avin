// expect: exit 0
// A method of one argument can be called infix: `a max b` is `a.max(b)`. The call is resolved
// exactly as the dotted one is: a class's method, a data type's impl method, a trait's method
// dispatched on the receiver's class, the overload the argument's type chooses, a generic method
// with its type argument inferred, and an object's method. An infix call binds more loosely than
// arithmetic and ranges and more tightly than comparisons and `&&`, and groups to the left.

class Num(val value: int)
  max(other: Num) -> Num = if other.value > value then other else self
  plus(n: int) -> Num = Num(value + n)
  describe(n: int) -> string = s"int $n"
  describe(s: string) -> string = s"string $s"
  describe(b: bool) -> string = s"bool $b"
  same(other: Num) -> bool = value == other.value
  pick[T](options: (T, T)) -> T = if value > 0 then options.0 else options.1

data Shape
  Square(side: int)
  Rect(w: int, h: int)

impl Shape
  area() -> int = self match
    Square(s) -> s * s
    Rect(w, h) -> w * h
  scaled(k: int) -> Shape = self match
    Square(s) -> Square(s * k)
    Rect(w, h) -> Rect(w * k, h * k)

trait Greeter
  greet(name: string) -> string

class English: Greeter
  override greet(name: string) -> string = s"hello, $name"

class French: Greeter
  override greet(name: string) -> string = s"bonjour, $name"

class Wrap[T](val item: T)
  zip[U](other: U) -> (T, U) = (item, other)
  holds(x: T) -> bool = true

object Config
  merge(other: int) -> int = 100 + other

greetAll(g: Greeter) -> string = g greet "ann"

main()
  val a = Num(3)
  val b = Num(5)
  println(s"${(a max b).value}")
  // Arithmetic binds first: `a plus 1 + 2` is `a.plus(1 + 2)`.
  println(s"${(a plus 1 + 2).value}")
  // Left grouping: `a max b max Num(9)` is `(a.max(b)).max(Num(9))`.
  println(s"${(a max b max Num(9)).value}")
  println(s"${(a plus 2 plus 3).value}")
  // Comparisons and `&&` bind more loosely.
  println(s"${a same Num(3) && b same Num(5)}")
  println(s"${(a plus 2).value == (b plus 0).value}")
  println(a describe 7)
  println(a describe "seven")
  println(a describe true)
  println(s"${a pick ("yes", "no")}")
  println(s"${Num(0) pick (1, 2)}")

  println(s"${(Square(3) scaled 2).area()}")
  println(s"${(Rect(2, 3) scaled 10).area()}")

  println(greetAll(English()))
  println(greetAll(French()))

  val w = Wrap("key")
  val pair = w zip 42
  println(s"${pair.0} ${pair.1}")
  println(s"${w holds "lock"}")

  println(s"${Config merge 23}")
  // The argument may continue on an indented line when the line ends with the method's name.
  val far = a max
    Num(40)
  println(s"${far.value}")
  println(s"${(a plus (2 * 3)).value + 1}")
