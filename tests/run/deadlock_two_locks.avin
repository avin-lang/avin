// expect: trap
// Two threads take two mutexes in opposite orders, each holding one while it waits for the other,
// and `main` joins the first: every thread waits on something only another waiting thread could end,
// so the program stops with a deadlock, naming each thread and what it waits on.
import avin.threads.{Channel, Mutex, spawn}

main()
  val a = Mutex(0)
  val b = Mutex(0)
  val aTaken = Channel[int]()
  val bTaken = Channel[int]()
  val first = spawn(() ->
    a.with(x ->
      aTaken.send(1)
      bTaken.receive()
      b.with(y -> x + y)))
  val second = spawn(() ->
    b.with(y ->
      bTaken.send(1)
      aTaken.receive()
      a.with(x -> x + y)))
  println("joining")
  println(first.join())
  println(second.join())
