// expect: exit 0
// A union is a set of members, brought to a normal form: nested unions flatten and order does not
// matter, so `int | string` and `string | int` are one type (a value made as one is passed as the
// other, and one map takes keys of both spellings). Members that come together through a type
// argument or an alias are absorbed silently: `T | int` at `T = int` is `int`, `T | Animal` at
// `T = Dog` is `Animal`, `T | string` at `T = int | bool` is `int | bool | string`, and `Key | string`
// is `Key`. Two unrelated traits stay two members, as do two instances of one generic type. A data
// type may name a union that names it back. Messages print a union with its aliases expanded.

trait Named
  name() -> string

trait Pet
  owner() -> string

open class Animal(val n: string)

class Dog(n: string): Animal(n)

class Parrot(n: string): Named, Pet
  override name() -> string = n
  override owner() -> string = "ann"

type Key = int | string

type Num = int | long

data Node(label: string, kids: Vector[Node | string])

flat(x: int | (string | bool)) -> string = x match
  n: int -> s"int $n"
  s: string -> s"string $s"
  b: bool -> s"bool $b"

swapped(x: string | int) -> string = x match
  n: int -> s"int $n"
  s: string -> s"string $s"

keyOrText(x: Key | string) -> string = swapped(x)

numOrText(x: Num | string) -> string = x match
  n: int -> s"int $n"
  l: long -> s"long $l"
  s: string -> s"string $s"

// At `T = int` the two members are one, and the arm for `T` takes every value.
same[T: Display](x: T | int) -> string = x match
  t: T -> s"T $t"
  n: int -> s"int $n"

wider[T](x: T | Animal) -> string = x match
  a: Animal -> s"animal ${a.n}"
  _: T -> "T"

grows[T](x: T | string) -> string = x match
  s: string -> s"string $s"
  _: T -> "T"

twoTraits(x: Named | Pet) -> string = x match
  n: Named -> s"named ${n.name()}"
  p: Pet -> s"pet of ${p.owner()}"

twoOptions(x: Option[int] | Option[string]) -> string = x match
  o: Option[int] -> s"ints $o"
  o: Option[string] -> s"strings $o"

render(n: Node) -> string = n.label + "(" + n.kids.map(k -> k match
  c: Node -> render(c)
  s: string -> s).mkString(" ") + ")"

main()
  println(flat(1))
  println(flat("a"))
  println(flat(true))
  val u: int | string = "made as int | string"
  println(swapped(u))
  val r: string | int = 2
  println(flat(r))
  val m: Map[int | string, int] = {1: 10, "one": 11}
  val n: Map[string | int, int] = m
  println(n.get(1))
  println(n.get("one"))
  println(keyOrText(3))
  println(keyOrText("k"))
  println(numOrText(4))
  println(numOrText(5_000_000_000))
  println(numOrText("num"))
  println(same[int](6))
  println(same[string]("s"))
  println(same[string](7))
  println(wider[Dog](Dog("rex")))
  val ib: int | bool = true
  println(grows[int | bool](ib))
  println(grows[int | bool]("text"))
  val polly: Named = Parrot("polly")
  println(twoTraits(polly))
  val pet: Pet = Parrot("pip")
  println(twoTraits(pet))
  println(twoOptions(Some(7)))
  val so: Option[string] = Some("seven")
  println(twoOptions(so))
  val tree = Node("root", [Node("left", ["a", "b"]), "middle", Node("right", [])])
  println(render(tree))
  println(tree)
  println(tree == Node("root", [Node("left", ["a", "b"]), "middle", Node("right", [])]))
  println(tree == Node("root", ["middle"]))
