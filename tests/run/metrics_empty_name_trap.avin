// expect: trap
// A metric name is not empty, nor holds a character other than letters, digits, `_` and `:`; a gauge
// of a function is checked as every family is.
import avin.metrics.Registry

main()
  val r = Registry()
  r.gaugeOf("ok", "Ok.", () -> 1.0)
  println(r.names)
  r.gaugeOf("", "Empty.", () -> 1.0)
