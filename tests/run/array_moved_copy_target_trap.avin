// expect: trap
// Copying into an array the program moved traps: the copy would write elements the receiver owns.
import avin.actors.Isolated

main()
  val a = Array.fill[int](4, 0)
  val source = Array.fill[int](4, 9)
  val moved = Isolated.move(a)
  println("moved")
  source.copyTo(a, 0)
  println(moved.take()(0))
