// expect: trap
// An `html"…"` hole where no escaping makes it safe, here an unquoted attribute value, traps with the
// reason, after the templates before it have rendered.
import avin.html.Html

main()
  val name = "x onmouseover=alert(1)"
  println(html"<p title=\"$name\">ok</p>")
  println(html"<p title=$name>no</p>")
