// Strings compare by content, byte for byte: embedded zeros, combining marks, long strings, and
// escapes all take part. A chain evaluates each string once, and a match evaluates its subject once
// and a guard only when its literal matched.

middle() -> string
  println("middle")
  "b"

fail() -> string = if 1 / 0 == 0 then "x" else "y"

subject() -> string
  println("subject")
  "λ"

guard() -> bool
  println("guard")
  false

pick(value: string) -> int = value match
  "absent" if guard() -> 0
  "λ" if guard() -> 1
  "λ" -> 42
  else 0

compare(a: string, b: string) = println(a == b, a != b)

classify(value: string) -> int = value match
  "" -> 0
  "a\0b" -> 1
  "λ" -> 2
  else 3

same(a: string, b: string) = a == b

main()
  val samples = ["", "a", "aa", "a\0b", "a\0c", "λ", "é", "e\u{301}", "🌍", "quote:\"\\\n"]
  for a in samples
    for b in samples
      compare(a, b)
  for value in samples
    println(classify(value))
  println("b" == middle() != "x")
  println("a" == "b" == fail())
  println(pick(subject()))
  var text = "before"
  text = "after"
  println(text == "after", text != "before")
  val longText = "λ".repeat(1024)
  println(same(longText, "λ".repeat(1024)))
  println(same(longText, "λ".repeat(1023) + "x"))
  println("x" match
    else 42)
