// expect: trap
// An offset at a mapping's length is past its last byte and traps rather than reading the page
// beyond: the last byte reads, the one after it does not.
import avin.fs

main()
  val dir = fs.createTempDir("avin-mapped-trap").toOption.get
  _ = fs.writeText(dir + "/a", "abc")
  val m = fs.mapFile(dir + "/a").toOption.get
  _ = fs.removeDirAll(dir)
  println(m(2))
  println(m(3))
