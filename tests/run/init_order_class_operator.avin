// expect: exit 0
// An operator on a final class calls that class's own method, so a module-level value whose
// initializer adds two `Box`es needs only what `Box.add` uses: not what the `add` of another class
// uses. `early` is computed before `later`, which needs it, and no cycle runs through `Other.add`,
// which reads `later` but is called only after both.
class Box(val n: int)

impl Add for Box
  static zero() -> Box = Box(0)
  add(other: Box) -> Box = Box(n + other.n)

class Other(val n: int)

impl Add for Other
  static zero() -> Other = Other(0)
  add(other: Other) -> Other = Other(n + other.n + later.n)

val early: Box = Box(1) + Box(2)
val later: Box = Box(early.n * 10)
val total: int = (Other(1) + Other(2)).n

main()
  println(early.n)
  println(later.n)
  println(total)
