// expect: exit 0
// A failure that would make more than `limit` restarts within the last `within` escalates instead:
// to the parent, which fails in turn, and whose own supervision decides. A limit of zero never
// restarts. Restarts older than the window no longer count, so an actor that fails once in a while
// restarts every time.
import avin.actors.{ActorRef, Restart, Stop, spawn}
import avin.threads.{Channel, sleep}
import avin.time

actor Fragile(log: Channel[string]) receives int
  log.send(s"$self starts")
  receive
    n -> log.send(s"${10 / n}")

actor Holder(limit: int, within: long, refs: Channel[ActorRef[int]], log: Channel[string]) receives int
  refs.send(spawn(Fragile(log), onFailure = Restart(limit, time.millis(within))))
  receive
    _ -> stop()
  stopping
    log.send(s"$self stopping")

drain(log: Channel[string], n: int)
  for _ in 0 ..< n do println(log.receive().get)

main()
  val log = Channel[string]()
  val refs = Channel[ActorRef[int]]()
  // Two restarts within a minute are allowed; the third failure escalates to the holder.
  val h = spawn(Holder(2, 60000, refs, log), onFailure = Stop)
  val f = refs.receive().get
  drain(log, 1)
  f.tell(0)
  drain(log, 1)
  f.tell(0)
  drain(log, 1)
  f.tell(5)
  drain(log, 1)
  f.tell(0)
  println(f.ended().await())
  println(h.ended().await())
  drain(log, 1)
  // A limit of zero escalates the first failure.
  val z = spawn(Holder(0, 60000, refs, log), onFailure = Stop)
  val g = refs.receive().get
  drain(log, 1)
  g.tell(0)
  println(g.ended().await())
  println(z.ended().await())
  drain(log, 1)
  // A window of 20ms: failures further apart than that each restart, with a limit of one.
  val w = spawn(Holder(1, 20, refs, log), onFailure = Stop)
  val k = refs.receive().get
  drain(log, 1)
  for _ in 0 ..< 3
    sleep(time.millis(60))
    k.tell(0)
    drain(log, 1)
  w.tell(0)
  println(k.ended().await())
  println(w.ended().await())
  drain(log, 1)
