// print and debug in whole programs: arguments of every kind joined by `, `, unicode and escapes,
// each argument evaluated once and in order before the line is written, a user function that
// shadows the library's, and `debug` as the quoted, escaped form of a value.

after(effect: unit, n: int) = n

tag(n: int) = after(println(n), n)

show(n: int) -> unit = n match
  0 -> println("zero")
  else println("other")

echo(s: string) = println(s)

choose(n: int) = n match
  0 -> "yes"
  else "no"

identity[T](x: T) = x

wrap[T: Debug](x: T) = debug(x)

pick(n: int) = n match
  0 -> debug("yes")
  else debug("no")

source() -> string
  println("evaluated")
  "hi"

emit(value: string)
  println(value)
  println(value)

main()
  println("answer:", 42, true, false, -2147483647 - 1, 2147483647)
  println("héllo λ 🌍", "", "quote: \" slash: \\")
  echo(choose(0))
  println(tag(1), tag(2))
  show(0)
  show(1)
  println(identity(42), identity(true))
  println("hello", debug("hello"))
  println(debug(-2147483647 - 1), debug(true), debug(false))
  println(debug("a\nb\t\\\""))
  println(wrap(42), wrap(true), wrap("hi"))
  println(identity(debug(42)), identity(debug("hi")))
  println(pick(0))
  emit(debug(source()))
  println(debug('a'), debug('🌍'), debug('\n'))
  println(debug(1.5), debug("é"), debug(()))
