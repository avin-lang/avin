// print and debug in whole programs: arguments of every kind joined by `, `, unicode and escapes,
// each argument evaluated once and in order before the line is written, a user function that
// shadows the library's, and `debug` as the quoted, escaped form of a value.

after(effect: unit, n: int) = n

tag(n: int) = after(print(n), n)

show(n: int) -> unit = n match
    0 -> print("zero")
    else print("other")

echo(s: string) = print(s)

choose(n: int) = n match
    0 -> "yes"
    else "no"

identity[T](x: T) = x

wrap[T: Debug](x: T) = debug(x)

pick(n: int) = n match
    0 -> debug("yes")
    else debug("no")

source() -> string
    print("evaluated")
    "hi"

emit(value: string)
    print(value)
    print(value)

main()
    print("answer:", 42, true, false, -2147483647 - 1, 2147483647)
    print("héllo λ 🌍", "", "quote: \" slash: \\")
    echo(choose(0))
    print(tag(1), tag(2))
    show(0)
    show(1)
    print(identity(42), identity(true))
    print("hello", debug("hello"))
    print(debug(-2147483647 - 1), debug(true), debug(false))
    print(debug("a\nb\t\\\""))
    print(wrap(42), wrap(true), wrap("hi"))
    print(identity(debug(42)), identity(debug("hi")))
    print(pick(0))
    emit(debug(source()))
    print(debug('a'), debug('🌍'), debug('\n'))
    print(debug(1.5), debug("é"), debug(()))
