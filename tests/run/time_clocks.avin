// expect: exit 0
// The two clocks: `monotonic()` is a `Duration` that never decreases, across 10,000 reads on one
// thread and on eight at once, and elapsed time is `monotonic() - start`; `now()` is an `Instant`
// after 2020. Every delay takes a `Duration`: `Future.await` and `Condition.waitFor` beside their
// milliseconds, a part of a millisecond waited for as a whole one, and a delay of zero or less asking
// without waiting. Only lower bounds and generous upper bounds are checked.
import avin.threads.{Future, Mutex, Promise, sleep, spawn}
import avin.time.{Duration, Instant, micros, millis, seconds, monotonic, now, epochSeconds}

// Whether `n` reads of the monotonic clock never decrease, making text between them so the collector
// runs while it is read.
ordered(n: int) -> bool
    var last = monotonic()
    var ok = true
    var junk = 0
    for i in 0..<n
        val m = monotonic()
        if m < last then ok = false
        last = m
        junk += s"read $i at $m".byteLength()
    ok && junk > 0

main()
    println(ordered(10000))
    val readers = (0..<8).map(_ -> spawn(() -> ordered(2000))).toVector
    var all = true
    for r in readers do all = all && r.join()
    println(all)

    val start = monotonic()
    sleep(millis(20))
    val elapsed = monotonic() - start
    println(s"${elapsed >= millis(20)} ${elapsed < seconds(30)} ${elapsed.isNegative()}")
    println(now() > epochSeconds(1577836800))
    val text = s"${now()}"
    println(text.endsWith("Z") && text.byteLength() >= 20)

    // `Future.await` with a duration.
    val p = Promise[int]()
    val waited = monotonic()
    println(p.future.await(millis(30)))
    println(monotonic() - waited >= millis(30))
    println(p.future.await(Duration.Zero))
    println(p.future.await(millis(-5)))
    println(p.future.await(Duration.Min))
    println(p.future.await(micros(1)))
    p.complete(7)
    println(p.future.await(Duration.Zero))
    println(p.future.await(Duration.Max))
    println(Future(1 + 1).await(seconds(10)))

    // `Condition.waitFor` with a duration.
    val m = Mutex(0)
    val c = m.condition()
    val before = monotonic()
    println(m.with(_ -> c.waitFor(millis(20))))
    println(monotonic() - before >= millis(20))
    println(m.with(_ -> c.waitFor(Duration.Zero)))
    println(m.with(_ -> c.waitFor(seconds(-1))))
    println(m.with(_ -> c.waitFor(micros(1))))
