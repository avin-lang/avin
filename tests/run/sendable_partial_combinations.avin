// expect: exit 0
// `orElse` of two sendable partial functions is sendable: two `@sendable` parameters, a parameter and
// a `match` function written in place, or a chain of them, passed on through `@sendable` parameters
// and run on other threads. A `match` function written where a `PartialFunction` is expected and
// passed for a type argument bounded by `Sendable` is made as a `@sendable` one, as a lambda there
// is, so the bound holds, through a function, a method's own type parameter and a value two
// parameters share, and the partial function runs on another thread.
import avin.threads.spawn

data Rule[T](run: @sendable (char) -> Option[T])

pick[U](@sendable f: PartialFunction[char, U]) -> Rule[U] = Rule(c -> if f.isDefinedAt(c) then Some(f(c)) else None)

pickAgain[U](@sendable f: PartialFunction[char, U]) -> Rule[U] = pick(f)

either[U](@sendable f: PartialFunction[char, U], @sendable g: PartialFunction[char, U]) -> Rule[U] = pick(f.orElse(g))

// Combined, then passed on through another marked parameter.
eitherAgain[U](@sendable f: PartialFunction[char, U], @sendable g: PartialFunction[char, U]) -> Rule[U] = pickAgain(f.orElse(g))

// A chain, the same parameter more than once among its links.
chain(@sendable f: PartialFunction[char, int], @sendable g: PartialFunction[char, int]) -> Rule[int] =
    pick(f.orElse(g).orElse(match '?' -> -1).orElse(f))

// A marked parameter and a `match` function written in place, whose arms use a `val` around them.
withDefault(@sendable f: PartialFunction[char, int], fallback: int) -> Rule[int] =
    pick(f.orElse(match _ -> fallback))

// A marked receiver and a marked argument inside a `@sendable` lambda.
later(@sendable f: PartialFunction[char, int], @sendable g: PartialFunction[char, int]) -> @sendable () -> Rule[int] =
    () -> pick(f.orElse(g))

show[T: Display](r: Rule[T], text: string) -> string
    var out = ""
    for c in text.chars
        out = out + (r.run(c) match
            Some(v) -> s"$v "
            None -> "- ")
    out

take[U: Sendable](value: U) -> U = value

pair[U: Sendable](a: U, b: U) -> (U, U) = (a, b)

// The value runs on another thread, its use given as a `@sendable` function of it.
runOn[U: Sendable](@sendable use: (U) -> string, value: U) -> string = spawn(() -> use(value)).join()

class Box(val n: int)
    keep[U: Sendable](value: U) -> U = value

main() =
    val digit: PartialFunction[char, int] = match c if '0' <= c <= '9' -> int(c) - int('0')
    println(show(either(match 'a' -> 1, match 'b' -> 2), "abc"))
    println(show(eitherAgain(match 'x' -> "ex", match 'y' -> "why"), "xyz"))
    val offset = 10
    val r = chain(match c if 'a' <= c <= 'c' -> int(c) - int('a') + offset, match 'z' -> 26)
    println(spawn(() -> show(r, "abcz?!")).join())
    println(spawn(() -> show(withDefault(match 'é' -> 233, 0), "éa")).join())
    println(spawn(later(match 'q' -> 1, match 'Q' -> 2)).join().run('Q'))
    // A `match` function that matches nothing but its wildcard, as the first of two.
    println(show(either(match _ -> 0, match 'a' -> 1), "a"))
    println(digit('7'))
    // A `match` function passed for a type argument bounded by `Sendable`.
    val vowel: PartialFunction[char, int] = take(match
        'a' -> 1
        'e' -> 2)
    println(vowel.isDefinedAt('a'), vowel.isDefinedAt('b'), vowel('e'))
    println(vowel.lift()('z'), vowel.applyOrElse('x', c -> -1))
    val (lo, hi): (PartialFunction[int, string], PartialFunction[int, string]) = pair(match n if n < offset -> "low", match n if n >= offset -> "high")
    println(lo(int.MinValue), hi(int.MaxValue), lo.orElse(hi)(offset))
    val kept: PartialFunction[string, int] = Box(1).keep(match "" -> 0)
    println(kept(""), kept.isDefinedAt("ü"))
    println(runOn((p: PartialFunction[char, string]) -> p('k'), match 'k' -> "kay"))
