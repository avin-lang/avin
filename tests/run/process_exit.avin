// expect: exit 3
import avin.process

// `exit` ends the program at once with its status, from inside a nested call, and what was printed
// before it reaches standard output even when that is a pipe. Nothing after it runs.
finish(code: int) -> Nothing
    println("finishing")
    process.exit(code)

pick(n: int) -> int = if n > 0 then n else finish(3)

main()
    println("before")
    println(pick(5))
    println(pick(0))
    println("after")
