// expect: exit 0
// `blocking` inside threads that are not a pool's simply runs its body, whatever the body waits on: a
// channel, a sleep, a join, a nested `blocking`, a future. Inside a future body started from such a
// thread it still leaves the body's place on the pool to another worker.
import avin.threads.{blocking, sleep, Channel, Future, scope, spawn}
import avin.time.millis

main() -> int
    val jobs = Channel[int]()
    val got = spawn(() -> blocking(jobs.receive().getOrElse(-1)))
    jobs.send(7)
    println(got.join())
    val napped = spawn(() ->
        blocking
            sleep(millis(5))
            blocking(spawn(() -> 6 * 7).join()))
    println(napped.join())
    val results = Channel[int]()
    val total = scope(s ->
        for i in 0..<64
            s.spawn(() -> results.send(blocking(Future(blocking(i)).await())))
        var sum = 0
        for _ in 0..<64 do sum += results.receive().getOrElse(0)
        sum)
    println(total)
    val shared = Channel[int]()
    val waiting = spawn(() ->
        val receivers = (0..<64).map(_ -> Future(blocking(shared.receive().getOrElse(-1)))).toVector()
        for n in 1..64 do shared.send(n)
        Future.all(receivers).await().sum())
    println(waiting.join())
    0
