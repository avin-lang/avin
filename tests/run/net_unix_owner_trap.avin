// expect: trap
// A Unix connection handed to a thread is the thread's while the thread runs, and the code that
// handed it over traps at its next use, as a TCP connection's does.
import avin.fs
import avin.io.IoError
import avin.net.{UnixListener, UnixStream}
import avin.threads.{Channel, spawn}

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message)

main()
    val dir = ok(fs.createTempDir("avu"))
    val l = ok(UnixListener.bind(dir + "/s"))
    val c = ok(UnixStream.connect(dir + "/s"))
    val s = ok(l.accept())
    ok(c.writeText("first\nsecond\n"))
    val go = Channel[int]()
    val t = spawn(() ->
        go.receive()
        ok(s.readLine()))
    println("handed over")
    s.readLine()
    println("not reached")
    go.send(1)
    println(t.join())
