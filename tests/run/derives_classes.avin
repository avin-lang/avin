// expect: exit 0
// A class that derives `Eq` and `Hash` compares and hashes by its constructor parameters, `Ord`
// orders by them in turn, and `Display` and `Debug` write `Name(a, b)` through each field's own
// form. Derived traits are ordinary conformances: bounds, operators, interpolation, `Any` and
// trait-typed values all reach them.

class Point(x: int, val y: int) derives Eq, Hash, Ord, Display, Debug

class Label(val text: string, val at: Point) derives Eq, Hash, Display, Debug

class Pair[A: Ord + Display, B: Ord + Display](val a: A, val b: B) derives Eq, Hash, Ord, Display

class Tagged[T](val value: T) derives Eq, Hash

open class Base(val n: int) derives Eq, Hash, Ord, Display
class Extended(n: int, val extra: string): Base(n)

class Blank derives Eq, Hash, Display, Debug

class Counter(private var count: int, name: string) derives Eq, Hash, Display, Debug
    bump() = count += 1

largest[T: Ord](a: T, b: T) -> T = if a < b then b else a

main()
    val p = Point(1, 2)
    val q = Point(1, 2)
    print(s"${p == q} ${p != q} ${p === q} ${p.hash() == q.hash()} ${p == Point(2, 1)}")
    print(s"${p < Point(1, 3)} ${Point(2, 0) > p} ${p <= q} ${p.compare(Point(0, 5))} ${largest(p, Point(0, 9))}")
    print(p)
    print(debug(p))
    val l = Label("ada \"a\"", p)
    print(s"$l")
    print(debug(l))
    print(s"${l == Label("ada \"a\"", Point(1, 2))} ${l.hash() == Label("ada \"a\"", q).hash()}")
    print(s"${Pair(1, "b") < Pair(1, "c")} ${Pair(2, "a") > Pair(1, "z")} ${largest(Pair("x", 2), Pair("x", 1))}")
    print(s"${Tagged(1) == Tagged(1)} ${Tagged("a") == Tagged("b")} ${Tagged(p).hash() == Tagged(q).hash()}")
    print(s"${Extended(3, "e")} ${Base(3) == Base(3)} ${Base(2) < Base(3)} ${Extended(3, "e").compare(Base(2))}")
    print(s"${Blank() == Blank()} ${Blank()} ${debug(Blank())}")
    val c = Counter(1, "a")
    val d = Counter(1, "a")
    print(c == d)
    c.bump()
    print(s"${c == d} $c ${debug(c)}")
    val x: Any = Point(4, 5)
    val y: Any = Point(4, 5)
    val z: Any = Label("p", Point(4, 5))
    print(s"${x == y} ${x == z} ${x.hash() == y.hash()}")
    val shown: Display = c
    print(shown)
    StandardOutput.write("[")
    p.display(StandardOutput, FormatSpec(width = 12))
    StandardOutput.write("][")
    p.debug(StandardOutput, FormatSpec(width = 12, left = true))
    print("]")
