// expect: trap
// A metric name is a letter, `_` or `:`, then letters, digits, `_` or `:`: such names are taken, and
// one beginning with a digit traps.
import avin.metrics.Registry

main()
  val r = Registry()
  _ = r.counter("a", "A.")
  _ = r.counter("_:x9", "X.")
  _ = r.counter(":", "Colon.")
  println(r.names)
  _ = r.counter("9lives", "Nine.")
