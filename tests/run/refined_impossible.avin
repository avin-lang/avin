// expect: exit 0
// A copy of generic code at an instance no value of the matched type reaches still compiles: an arm,
// an `is` test's branch, the rest of a block after an early return or a destructuring binding, and a
// `while` body whose equalities are false at the copy are left out, and a field read of a type with
// no values traps if it were ever reached. Here each such copy is made as a function value and never
// called, beside the copies that run.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  BoolLit(value: bool) -> Expr[bool]

data Same[A, B]
  Refl -> Same[A, A]

data One[T]
  Mk(value: int) -> One[int]

castBack[A, B](proof: Same[A, B], y: B) -> A
  val Refl = proof
  y

valueOf[T](o: One[T]) -> int = o.value

firstInt[T](e: Expr[T], x: T) -> T
  if e is not IntLit(n) then return x
  x + n

countDown[T](e: Expr[T], x: T) -> int
  var steps = 0
  var left = e
  while left is IntLit(n) && n > 0
    steps += 1
    left = IntLit(n - 1)
  steps

choose[T](e: Expr[T], x: T) -> T = if e is BoolLit(b) then b && x else x

main()
  val impossibleCast: (Same[int, string], string) -> int = castBack
  val impossibleRead: (One[bool]) -> int = valueOf
  println(castBack(Refl, 7))
  println(valueOf(Mk(3)))
  println(firstInt(IntLit(2), 40))
  println(firstInt(BoolLit(true), false))
  println(countDown(IntLit(3), 0))
  println(countDown(BoolLit(true), true))
  println(choose(BoolLit(true), false))
  println(choose(IntLit(1), 5))
  println("made")
