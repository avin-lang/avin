// expect: exit 0
// Two instances of one generic type that differ at a contravariant argument agree on the instance
// whose argument is the narrower of the two, their meet: `Sink[A]` and `Sink[B]` for `Sink[-T]`
// agree on `Sink[B]`, whichever branch is written first, in an `if` or a `match`, with or without a
// type expected of them, even where the type has an impl of a trait both instances share. The rule
// reaches data types, mixed variance, nesting, function types and any number of branches. Branches
// that agree on a type that is not the one expected of them agree on the expected type when both are
// instances of it.
open class A(val tag: string)
open class B: A("b")
class C: B

class Sink[-T](val f: (T) -> int)

impl[T] Display for Sink[T]
  display(out: Writer, spec: FormatSpec) = out.write("sink")

data Pred[-T]
  Pred(test: (T) -> bool)

impl[T] Display for Pred[T]
  display(out: Writer, spec: FormatSpec) = out.write("pred")

class Rule[-I, +T](val run: (I) -> T)

impl[I, T] Display for Rule[I, T]
  display(out: Writer, spec: FormatSpec) = out.write("rule")

trait Pet
  name() -> string

open class Animal

class Dog: Animal, Pet
  override name() -> string = "dog"

class Cat: Animal, Pet
  override name() -> string = "cat"

anySink() -> Sink[A] = Sink(a -> 1)

bSink() -> Sink[B] = Sink(b -> 2)

cSink() -> Sink[C] = Sink(c -> 3)

strSink() -> Sink[string] = Sink(s -> s.byteLength)

pickIn(c: bool) -> Sink[B] = if c then anySink() else bSink()

pickBack(c: bool) -> Sink[B] = if c then bSink() else anySink()

armed(n: int) -> Sink[B] = n match
  0 -> anySink()
  _ -> bSink()

armedBack(n: int) -> Sink[B] = n match
  0 -> bSink()
  _ -> anySink()

three(n: int) -> Sink[C] = n match
  0 -> anySink()
  1 -> bSink()
  _ -> cSink()

pet(c: bool) -> Pet = if c then Dog() else Cat()

petArm(n: int) -> Pet = n match
  0 -> Dog()
  _ -> Cat()

main()
  val yes = true
  val no = false
  // With no type expected.
  val first = if yes then anySink() else bSink()
  val second = if no then bSink() else anySink()
  val arm = 1 match
    1 -> anySink()
    _ -> bSink()
  val armBack = 1 match
    1 -> bSink()
    _ -> anySink()
  val s1: Sink[B] = first
  val s2: Sink[B] = second
  val s3: Sink[B] = arm
  val s4: Sink[B] = armBack
  println(s1.f(B()), s2.f(B()), s3.f(C()), s4.f(B()))
  // With the type expected.
  println(pickIn(true).f(B()), pickIn(false).f(B()), pickBack(true).f(B()), pickBack(false).f(B()))
  println(armed(0).f(B()), armed(1).f(B()), armedBack(0).f(B()), armedBack(1).f(B()))
  val written: Sink[B] = if yes then anySink() else bSink()
  println(written.f(C()))
  // Three branches agree on the narrowest, in any order.
  println(three(0).f(C()), three(1).f(C()), three(2).f(C()))
  val chained = if yes then cSink() else if no then anySink() else bSink()
  val s5: Sink[C] = chained
  println(s5.f(C()))
  // A data type.
  val pa: Pred[A] = Pred(a -> a.tag == "b")
  val pb: Pred[B] = Pred(b -> false)
  val pred = if yes then pa else pb
  val p1: Pred[B] = pred
  println(p1.test(B()), s"$pred")
  // One argument contravariant and one covariant: the meet of the first, the join of the second.
  val ra: Rule[A, B] = Rule(a -> B())
  val rb: Rule[B, A] = Rule(b -> b)
  val rule = if yes then ra else rb
  val r1: Rule[B, A] = rule
  println(r1.run(B()).tag, s"$rule")
  // Nested in a covariant argument.
  val va: Vector[Sink[A]] = [anySink()]
  val vb: Vector[Sink[B]] = [bSink(), bSink()]
  val nested = if yes then va else vb
  val v1: Vector[Sink[B]] = nested
  println(v1.length)
  // A function type's parameter.
  val fa: (A) -> int = a -> 10
  val fb: (B) -> int = b -> 20
  val fun = if yes then fa else fb
  val funBack = if no then fb else fa
  val f1: (B) -> int = fun
  val f2: (B) -> int = funBack
  println(f1(B()), f2(C()))
  val ga: (A) -> A = a -> a
  val gb: (B) -> B = b -> b
  val g = if yes then ga else gb
  val g1: (B) -> A = g
  println(g1(B()).tag)
  // `Nothing` at a contravariant argument is below every type, so it is the meet.
  val none: Sink[Nothing] = Sink(x -> 0)
  val low = if yes then bSink() else none
  val s6: Sink[Nothing] = low
  println(s"$s6")
  // Classes whose common superclass is not the trait expected of them agree on the trait.
  println(pet(true).name(), pet(false).name(), petArm(0).name(), petArm(1).name())
  val p: Pet = if no then Dog() else Cat()
  println(p.name())
  // Unrelated arguments have no meet: with nothing expected the instances agree on the trait they
  // share, and with an instance both are instances of expected, on that.
  val shared = if yes then bSink() else strSink()
  val shown: Display = shared
  val both: Sink[Nothing] = if yes then bSink() else strSink()
  val bothArm: Sink[Nothing] = 2 match
    1 -> strSink()
    _ -> bSink()
  println(s"$shown $both $bothArm")
