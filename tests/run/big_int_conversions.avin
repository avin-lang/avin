// expect: exit 0
// Making a `BigInt` from an integer of every width, a literal as large as a `long` included, and
// taking it back: `toLong`/`toInt` and their `Option` forms at and one past each bound, and `toReal`,
// correctly rounded and an infinity past the greatest finite `real`.

main()
  // A literal as large as a `long`, and integer values of every width.
  println(BigInt(9223372036854775807))
  println(BigInt(-9223372036854775807))
  val small: i8 = -128
  val i: int = int.MinValue
  val n: long = long.MinValue
  println(BigInt(small))
  println(BigInt(i))
  println(BigInt(n))
  println(BigInt(i1(-1)))
  val wide: i128 = i128(long.MaxValue) * i128(long.MaxValue) * i128(-2)
  println(BigInt(wide))
  println(BigInt(wide) == BigInt(long.MaxValue) * BigInt(long.MaxValue) * BigInt(-2))
  println(BigInt(i128.MinValue))
  println(BigInt(i128.MaxValue))
  println(BigInt(i257.MaxValue))
  println(BigInt(i257.MinValue) == -BigInt(2).pow(256))
  println(BigInt(i128(0)))
  // `long` and `int` back, at the bounds and one past.
  val longMax = BigInt(long.MaxValue)
  val longMin = BigInt(long.MinValue)
  println(longMax.toLongOption)
  println(longMin.toLongOption)
  println((longMax + BigInt(1)).toLongOption)
  println((longMin - BigInt(1)).toLongOption)
  println(BigInt(2).pow(64).toLongOption)
  println(BigInt(10).pow(27).toLongOption)
  println(BigInt(10).pow(28).toLongOption)
  println(BigInt(0).toLongOption)
  println(longMax.toLong)
  println(longMin.toLong)
  println(BigInt(int.MaxValue).toIntOption)
  println(BigInt(int.MinValue).toIntOption)
  println((BigInt(int.MaxValue) + BigInt(1)).toIntOption)
  println((BigInt(int.MinValue) - BigInt(1)).toIntOption)
  println(BigInt(-42).toInt)
  // `toReal`: exact up to 2^53, the nearest `real` beyond, a tie to the even one, and an infinity
  // past the greatest finite value.
  println(BigInt(0).toReal)
  println(BigInt(-12345).toReal)
  println(BigInt(2).pow(53).toReal == 9007199254740992.0)
  println((BigInt(2).pow(53) + BigInt(1)).toReal == 9007199254740992.0)
  println((BigInt(2).pow(53) + BigInt(3)).toReal == 9007199254740996.0)
  println(BigInt(10).pow(308).toReal == 1e308)
  println(
    BigInt(
      ""
    ).toReal == real.MaxValue
  )
  println(BigInt(10).pow(309).toReal)
  println((-BigInt(10).pow(400)).toReal)
  // `abs`, `sign`, `isZero`.
  for x in [BigInt(0), BigInt(5), BigInt(-5), -BigInt(10).pow(40)]
    println(s"${x.abs} ${x.sign} ${x.isZero}")
