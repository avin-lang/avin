// expect: exit 3
// When `main` returns, the exit hooks run on the main thread, newest first and once each, after
// everything `main` printed, and the status `main` returned is the program's. A hook may print, read
// what it captured, allocate and call functions; what it prints follows what `main` printed.
import avin.process

say(text: string) = println(s"hook: $text")

main() -> int
    process.onExit(() -> say("registered first, runs last"))
    val name = "captured"
    process.onExit(() -> say(s"reads $name"))
    process.onExit(() -> say([1, 2, 3].map(n -> n * 10).mkString(", ")))
    process.onExit(() -> say("registered last, runs first"))
    println("main ends")
    3
