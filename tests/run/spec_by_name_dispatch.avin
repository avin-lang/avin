// expect: exit 0
// By-name parameters on trait methods, their overrides and defaults, dispatched through a trait-typed
// vector; on an impl method of a data type; on a generic function given data values and collections
// of them, which a collection made at every allocation must keep alive; and on an object's method.
// An argument is evaluated only at the reads the chosen implementation makes.

trait Runner
  run(times: int, body: -> unit)
  twice(body: -> int) -> int = body + body

class Plain: Runner
  override run(times: int, body: -> unit)
    var i = 0
    while i < times
      body
      i += 1

class Lazy: Runner
  override run(times: int, body: -> unit) = ()
  override twice(body: -> int) -> int = 0

data Cell(v: int)

impl Cell
  orElse(fallback: -> Cell) -> Cell = if v > 0 then self else fallback

pick[T](flag: bool, a: -> T, b: -> T) -> T = if flag then a else b

object Guard
  check(ok: bool, message: -> string) -> string = if ok then "fine" else message

main()
  var count = 0
  val rs: Vector[Runner] = [Plain(), Lazy()]
  tick() -> int
    count += 10
    1
  for r in rs
    r.run(3, count += 1)
    count += r.twice(tick())
  println(count)
  var made = 0
  mk(v: int) -> Cell
    made += 1
    Cell(v)
  println(s"${Cell(1).orElse(mk(9))} ${Cell(0).orElse(mk(9))} $made")
  made = 0
  println(s"${pick(true, mk(1), mk(2))} ${pick(false, [mk(3)], [mk(4), mk(5)])} $made")
  var built = 0
  msg() -> string
    built += 1
    "bad " + built.toString()
  println(s"${Guard.check(true, msg())} ${Guard.check(false, msg())} $built")
  val strs = Vector.empty[string]() :+ "a"
  println(pick(strs.isEmpty, "empty", strs(0) + "!"))
