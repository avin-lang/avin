// expect: exit 0
// What a thread's body may reach at module level: printing to standard output and standard error,
// a `val` of immutable data (a scalar, a string, a vector, a data value, a map), a `lazy val` of a
// sendable type, an `Atomic`, a `Mutex` guarding a buffer, a `Channel`, an object with no `var`, and
// a collection's companion object making a fresh collection inside the body; and the standard
// library's own module-level state, the shared random generator and the Unicode tables a regex reads. A module-level `var`
// stays usable outside any thread's body: from `main` and from a closure that runs at once on the
// calling thread; a mutex's `with` body takes its value as a local read before it. Every thread is
// joined before the next starts, so the output's order is fixed.
import avin.threads.{spawn, scope, Atomic, Mutex, Channel, Future}
import avin.random.Random
import avin.regex.Regex

val limit: int = 3
val greeting = "héllo"
val names: Vector[string] = ["a", "b", "c"]
val ages: Map[string, int] = Map(("a", 1), ("b", 2))
data Point(x: int, y: int)
val origin = Point(4, 5)
lazy val squares: Vector[int] = (0 ..< 5).map(i -> i * i).toVector
val hits = Atomic(0)
val guarded = Mutex(Buffer[int]())
val lines = Channel[string](8)
var calls = 0

object Settings
  val width = 7
  describe() -> string = s"width $width"

record(n: int) -> int = hits.add(n)

main()
  spawn(() -> println(s"$greeting ${names.length} ${limit + origin.x + origin.y}")).join()
  spawn(() -> print(s"${ages("b")} ${squares(4)}\n")).join()
  spawn(() -> eprintln("to standard error")).join()
  spawn(() -> StandardError.write("written to the error stream\n")).join()
  spawn(() -> record(2)).join()
  scope(s ->
    for _ in 0 ..< 4
      s.spawn(() -> record(1)))
  println(hits.load())
  spawn(() -> guarded.with(b -> b.addOne(limit))).join()
  spawn(() -> lines.send(Settings.describe())).join()
  println(lines.receive().getOrElse("none"))
  spawn(() ->
    val fresh = Buffer[int]()
    fresh.addOne(Array.fill(2, 9)(1))
    println(fresh.length + fresh(0))).join()
  println(Future(names.mkString(",")).await())
  spawn(() -> println(Random.nextInt(1) + Regex("\\X").findAllIn("e\u0301\u00e9").toList.length)).join()
  calls += 1
  names.foreach(n -> calls += 2)
  val now = calls
  guarded.with(b -> b.addOne(now))
  println(s"$calls ${guarded.with(b -> b.length)}")
