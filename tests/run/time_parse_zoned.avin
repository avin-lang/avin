// expect: exit 0
// `parseZoned`: a timestamp and, optionally, a zone's name in brackets. Without a name the zone is the
// offset's fixed zone (`utc` for `Z` and any zero offset); with one, the offset must be the one the
// zone's clocks show at that instant, so both readings of an autumn overlap read and a reading in a
// spring gap does not. A name the database lacks is `UnknownZone`; every display reads back equal.
import avin.time.{
  Instant, Zoned, TimeParseError, OutOfRange, BadShape, Trailing, epochSeconds, fixedZone, hours, minutes, utc, zone,
  parseZoned
}

show(text: string) = parseZoned(text) match
  Ok(z) -> println(s"$text -> $z ${z.zone.name} ${z.offset} ${z.toInstant}")
  Err(e) -> println(e.message)

main()
  val toronto = zone("America/Toronto").getOrElse(utc)
  val kolkata = zone("Asia/Kolkata").getOrElse(utc)
  val kathmandu = zone("Asia/Kathmandu").getOrElse(utc)
  val lordHowe = zone("Australia/Lord_Howe").getOrElse(utc)

  // No name: the offset's own zone.
  show("2026-03-03T14:30:00Z")
  show("2026-03-03T14:30:00+00:00")
  show("2026-03-03T14:30:00-0000")
  show("2026-03-03T20:00:00+05:30")
  show("2026-03-03T20:00:00+0530")
  show("2026-03-03T06:30:00.25-08:00")
  show("2026-03-03 06:30-08:00")
  println(parseZoned("2026-03-03T14:30:00Z").map(z -> z.zone == utc))
  println(parseZoned("2026-03-03T20:00:00+05:30").map(z -> z.zone == fixedZone(hours(5) + minutes(30))))

  // A name: the offset is checked against the zone's at that instant.
  show("2026-03-08T09:00:00-04:00[America/Toronto]")
  show("2026-03-08T09:00:00-05:00[America/Toronto]")
  show("2026-01-15T09:00:00-05:00[America/Toronto]")
  show("2026-03-08T20:00:00+05:30[Asia/Kolkata]")
  show("2026-03-08T20:00:00+05:45[Asia/Kathmandu]")
  show("2026-03-08T20:00:00+05:30[Asia/Kathmandu]")
  show("2026-03-03T14:30:00Z[UTC]")
  show("2026-03-03T14:30:00+00:00[UTC]")
  show("2026-03-03T14:30:00+01:00[UTC]")
  show("2026-03-03T20:00:00+05:30[+05:30]")
  show("2026-03-03T20:00:00+05:30[+05:45]")
  show("2026-03-03T14:30:00Z[Z]")

  // The autumn overlap: 01:30 happens twice in Toronto, an hour apart, and both read.
  show("2026-11-01T01:30:00-04:00[America/Toronto]")
  show("2026-11-01T01:30:00-05:00[America/Toronto]")
  // The spring gap: 02:30 never happens there, so no offset makes it a reading the zone shows.
  show("2026-03-08T02:30:00-05:00[America/Toronto]")
  show("2026-03-08T02:30:00-04:00[America/Toronto]")
  // Lord Howe's half-hour change, both sides.
  show("2026-04-05T01:45:00+11:00[Australia/Lord_Howe]")
  show("2026-04-05T01:45:00+10:30[Australia/Lord_Howe]")

  // Names the database lacks, and names that cannot be one.
  show("2026-03-03T14:30:00Z[Nowhere/Atall]")
  show("2026-03-03T14:30:00Z[../../etc/passwd]")
  show("2026-03-03T14:30:00Z[/etc/localtime]")
  show("2026-03-03T14:30:00Z[Europe/Pa ris]")
  show("2026-03-03T14:30:00Z[Ünïcode]")
  println(
    parseZoned("2026-03-03T14:30:00Z[Nowhere/Atall]") == Err(
      TimeParseError.UnknownZone("2026-03-03T14:30:00Z[Nowhere/Atall]", "Nowhere/Atall")
    )
  )

  // Shapes: no offset, an empty or unclosed bracket, text after it.
  show("2026-03-08T09:00:00[America/Toronto]")
  show("2026-03-08T09:00:00")
  show("2026-03-08T09:00:00-04:00[]")
  show("2026-03-08T09:00:00-04:00[America/Toronto")
  show("2026-03-08T09:00:00-04:00[")
  show("2026-03-08T09:00:00-04:00[America/Toronto] ")
  show("2026-03-08T09:00:00-04:00[America/Toronto][UTC]")
  show("2026-03-08T09:00:00-04:00 [America/Toronto]")
  show("")
  // The shape, then the reading, then the offset, then the zone.
  show("2026-02-30T09:00:00-04:00[Nowhere/Atall]")
  show("2026-03-08T09:00:00-25:00[Nowhere/Atall]")
  show("2026-03-08T09:00:00-04:00[Nowhere/Atall")
  show("+294247-01-11T00:00:00Z[UTC]")
  println(parseZoned("2026-03-08T09:00:00-04:00[") == Err(BadShape("2026-03-08T09:00:00-04:00[", 26, "']'")))
  println(
    parseZoned("2026-03-08T09:00:00-05:00[America/Toronto]") == Err(
      OutOfRange("2026-03-08T09:00:00-05:00[America/Toronto]", "offset")
    )
  )
  println(parseZoned("2026-03-08T09:00:00Z ") == Err(Trailing("2026-03-08T09:00:00Z ", 20)))

  // Every display reads back, in every kind of zone, over a sweep of 2026 and 1970.
  var failures = 0
  var checked = 0
  for z in [
    toronto,
    kolkata,
    kathmandu,
    lordHowe,
    utc,
    fixedZone(hours(-9) - minutes(30)),
    fixedZone(hours(23) + minutes(59))
  ]
    for start in [epochSeconds(1767225600), epochSeconds(0)]
      var k = 0
      while k < 366 * 24
        val reading = (start + hours(long(k)) + minutes(long(k % 60))).atZone(z)
        if parseZoned(s"$reading") != Ok(reading) then failures += 1
        checked += 1
        k += 7
  // The least and greatest instants read back in UTC.
  println(parseZoned(s"${Instant.Min.atZone(utc)}") == Ok(Instant.Min.atZone(utc)))
  println(parseZoned(s"${Instant.Max.atZone(utc)}") == Ok(Instant.Max.atZone(utc)))
  println(s"$checked readings read back, $failures failures")
