// expect: exit 0
// Sorting and ranges at their edges: stable sorts by one key then another, a key computed once per
// element, a list's sorts answering lists, a deque whose ring has wrapped sorted front first, more
// than one run of 16 merged, strings by code point; and ranges stepping up to the type's largest
// value without passing it, counting down, answering from their bounds on ranges too long to count,
// and the ranges of other integer types.
data Entry(rank: int, name: string)

main()
    val entries = [Entry(2, "b"), Entry(1, "a"), Entry(2, "c"), Entry(1, "d")]
    println(entries.sortBy(e -> e.name).sortBy(e -> e.rank).map(e -> e.name))
    println(entries.sortWith((x, y) -> y.rank.compare(x.rank)).map(e -> e.name))
    var keys = 0
    val byKey = entries.sortBy(e ->
        keys += 1
        e.name)
    println(s"${byKey.map(e -> e.name)} $keys")
    val l: List[int] = [3, 1, 2]
    val ls: List[int] = l.sorted()
    val lb: List[int] = l.sortBy(x -> -x)
    val lw: List[int] = l.sortWith((a, b) -> a.compare(b))
    println(s"$ls $lb $lw $l")

    val dq = Deque[int]()
    for i in 0..<5 do dq.append(i)
    dq.removeHead()
    dq.removeHead()
    dq.append(-1)
    dq.append(-2)
    dq.prepend(9)
    dq.sortInPlace()
    println(dq)
    val many = Array.tabulate(100, i -> (i * 37) % 100)
    val sortedCopy = many.sorted()
    many.sortInPlaceBy(x -> -x)
    println(s"${sortedCopy.take(3)} ${sortedCopy.last} ${many(0)} ${many(99)} ${sortedCopy == (0..99)}")
    val buf = ["b", "B", "a", "é", "Z"].toBuffer()
    buf.sortInPlaceWith((a, b) -> a.compare(b))
    println(buf)
    val stableMany = (0..<40).map(i -> Entry(i % 3, i.toString())).sortBy(e -> e.rank)
    println(stableMany.take(4).map(e -> e.name))
    println(Vector.empty[int]().sorted())
    println([5].sorted())

    var ups = Buffer[int]()
    for i in 2147483640..2147483647 by 5 do ups.append(i)
    println(ups)
    var downs = Buffer[int]()
    for i in -2147483641 .. -2147483648 by -4 do downs.append(i)
    println(downs)
    println(s"${(10..0 by -2).toVector} ${(5..1).isEmpty} ${(5..<5).isEmpty} ${(1..1).length}")
    val huge = int.MinValue .. int.MaxValue
    println(s"${huge.head} ${huge.last} ${huge.lift(5)} ${huge.contains(0)} ${huge(10)}")
    println(s"${(1 ..< 10 by 3).contains(7)} ${(1 ..< 10 by 3).contains(8)} ${(1 ..< 10 by 3).contains(10)} ${(10 .. 1 by -3).contains(4)}")
    println(s"${(0 ..< 100 by 5)(3)} ${(1..5).map(x -> x * x)} ${(1..5).reverse} ${(1..6).filter(x -> x % 2 == 1)}")
    val small: i8 = 100
    val top: i8 = 127
    val step: i8 = 20
    val r8 = small .. top by step
    println(s"${r8.toVector} ${r8.length} ${r8.contains(120)} ${r8.contains(127)}")
    val big: long = 5000000000
    val rl = 0 .. big by 1000000000
    println(s"${rl.length} ${rl.last} ${rl.contains(3000000000)} ${rl.lift(2)}")
    val wide = long.MinValue .. long.MaxValue
    println(s"${wide.contains(0)} ${wide.head} ${wide.lift(1)} ${wide.isEmpty}")
