// expect: exit 0
// A field's `lazy val` is its object's, so reading the same field of another instance is a
// different value and is accepted: a node's depth from the next node's, a tree's size from its
// children's, a lazy field reaching another instance's through a method, a generic class, an
// object reading instances of a class, chains of lazy fields with no cycle, a subclass's override
// that reads a different field, and a lambda the initializer makes and hands on, which reads the
// value only once it is stored. Instances read first on other threads give the same values.
import avin.threads.spawn

class Node(next: Option[Node])
  lazy val depth: int = next match
    Some(n) -> n.depth + 1
    None -> 0

class Tree(children: Vector[Tree])
  lazy val size: int = children.foldLeft(1, (total, child) -> total + child.size)

class Account(parent: Option[Account], own: int)
  lazy val balance: int = own + inherited()

  inherited() -> int = parent match
    Some(p) -> p.balance
    None -> 0

class Chain[T](value: T, before: Option[Chain[T]])
  lazy val all: Vector[T] = before match
    Some(b) -> b.all :+ value
    None -> [value]

object Registry
  val roots: Vector[Node] = [Node(None), Node(Some(Node(None)))]
  lazy val deepest: int = roots.foldLeft(0, (most, n) -> if n.depth > most then n.depth else most)

class Steps(n: int)
  lazy val third: int = second + 1
  lazy val second: int = first + 1
  lazy val first: int = n

open class Shape(side: int)
  lazy val area: int = measure()

  measure() -> int = side * side

class Framed(side: int): Shape(side)
  lazy val frame: int = side * 4
  override measure() -> int = frame + side * side

class Knot
  lazy val later: () -> int = () -> value + 1
  lazy val value: int = 41

  twice(other: Knot) -> int = other.value * 2

class Peer(name: string)
  lazy val partner: Peer = Peer(name + "'")
  lazy val partnerName: string = partner.name

main()
  val chain = Node(Some(Node(Some(Node(None)))))
  println(chain.depth)
  println(Tree([Tree([]), Tree([Tree([]), Tree([])])]).size)
  println(Account(Some(Account(Some(Account(None, 1)), 10)), 100).balance)
  println(Chain("c", Some(Chain("b", Some(Chain("a", None))))).all)
  println(Registry.deepest)
  println(Steps(5).third)
  println(Shape(3).area)
  println(Framed(3).area)
  val k = Knot()
  println(k.later())
  println(k.twice(Knot()))
  println(Peer("p").partnerName)
  val fresh = [Node(Some(Node(None))), Node(None), Node(Some(Node(Some(Node(Some(Node(None)))))))]
  val threads = fresh.map(n -> spawn(() -> n.depth))
  for t in threads do println(t.join())
  val trees = [Tree([Tree([])]), Tree([])]
  val sizes = trees.map(t -> spawn(() -> t.size))
  for t in sizes do println(t.join())
