// expect: trap
// A trap in a thread other than the main one stops the whole program: what was written before it is
// flushed once, the trap is reported once, and the main thread, waiting to join, never goes on.
import avin.threads.spawn

divide(a: int, b: int) -> int = a / b

main() -> int
  println("before")
  val t = spawn(() -> divide(1, 0))
  t.join()
  println("after")
  0
