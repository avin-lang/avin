// expect: exit 0
// A trait's module derives it for any type with a template, `derive Describe for T`, written once
// against the type's shape. `T.walk` calls the visitor's `field` hook once per field, at the field's
// own type; `T.walkPair` does the same over two values; `T.variantOf` and `T.shape()` read the shape,
// annotations included. Derived for a one-variant data type, a type of several variants, a generic
// type (each parameter bounded by the trait), a recursive type, a class (its constructor parameters,
// plain ones included) and an open class.

trait Describe
  describe() -> string

impl Describe for int
  describe() -> string = s"$self"

impl Describe for string
  describe() -> string = s"\"$self\""

impl[A: Describe] Describe for List[A]
  describe() -> string = "[" + map(a -> a.describe()).mkString(", ") + "]"

derive Describe for T
  describe() -> string = T.walk(self, Describer(T.shape(), "")).finish()

data Rename(to: string)
impl Annotation for Rename

object Hidden: Annotation

data Describer(shape: TypeShape, text: string)

impl ShapeVisitor for Describer
  variant(v: VariantShape) -> Describer =
    val shown = v.annotation[Rename]().map(r -> r.to).getOrElse(v.name)
    Describer(shape, shown)

impl Describer
  field[F: Describe](f: FieldShape, value: F) -> Describer =
    if f.has(Hidden) then return self
    val name = f.annotation[Rename]().map(r -> r.to).getOrElse(f.name)
    val sep = if text.contains("(") then ", " else "("
    Describer(shape, s"$text$sep$name = ${value.describe()}")
  finish() -> string = if text.contains("(") then text + ")" else text

data Box[A](item: A) derives Describe

data Tree(label: string, children: List[Tree]) derives Describe

class Account(val owner: string, balance: int, @Hidden secret: int) derives Describe

open class Base(val n: int) derives Describe

class Derived(n: int): Base(n)

data Person(@Rename("full_name") name: string, age: int, @Hidden score: int = 0) derives Describe

@Rename("Figure")
data Shape derives Describe, Kind
  @Rename("circle") Circle(radius: int)
  Rect(width: int, height: int)
  Empty

// Comparison over two values, through `walkPair`.
trait Same
  same(other: Self) -> bool

derive Same for T
  same(other: T) -> bool = T.walkPair(self, other, Agree(true)).all

data Agree(all: bool)

impl ShapePairVisitor for Agree
  variants(a: VariantShape, b: VariantShape) -> Agree = Agree(a.index == b.index)

impl Agree
  field[F: Eq](f: FieldShape, a: F, b: F) -> Agree = Agree(all && a == b)

// The shape itself: the type's name and annotations, and the variant a value is.
trait Kind
  kind() -> string

derive Kind for T
  kind() -> string =
    val renamed = T.shape().annotation[Rename]().map(r -> r.to).getOrElse("-")
    s"${T.shape().name}.${T.variantOf(self).name} of ${T.shape().variantCount}, ${T.variantOf(self).fieldCount} fields, $renamed"

data Pair(a: int, b: string) derives Same, Kind

data Light derives Same, Kind
  Red
  Green(level: int)

class Holder[A](val item: A) derives Same, Kind

main()
  println(Box(5).describe())
  println(Box("x").describe())
  println(Box(Box(1)).describe())
  println(Tree("root", [Tree("a", []), Tree("b", [Tree("c", [])])]).describe())
  println(Account("ed", 10, 99).describe())
  println(Base(3).describe())
  println(Derived(4).describe())
  println(Person("Ada", 36).describe())
  println(Circle(1).describe())
  println(Rect(1, 2).describe())
  println(Empty.describe())
  println(Pair(1, "x").same(Pair(1, "x")))
  println(Pair(1, "x").same(Pair(1, "y")))
  println(Red.same(Red))
  println(Red.same(Green(1)))
  println(Green(2).same(Green(2)))
  println(Green(2).same(Green(3)))
  println(Holder(Pair(1, "x")).same(Holder(Pair(1, "x"))))
  println(Holder(Pair(1, "x")).same(Holder(Pair(2, "x"))))
  println(Green(2).kind())
  println(Red.kind())
  println(Pair(1, "x").kind())
  println(Holder(Pair(1, "x")).kind())
  println(Circle(1).kind())
