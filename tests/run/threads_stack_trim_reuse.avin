// expect: exit 0
// env: AVIN_GC_STRESS=0
// Ten thousand threads, a hundred at a time, each recursing twenty thousand calls deep and ending. The
// stacks kept for later threads are given back down to their top pages as they are kept, so once every
// thread is joined the program holds about what it held before, not the mebibyte or more each kept
// stack once reached; and the stacks that are not kept are unmapped, so nothing grows with the count.
import avin.process.{pid, residentBytes}
import avin.threads.spawn

depth(n: int) -> int = if n == 0 then 0 else 1 + depth(n - 1)

resident() -> long = residentBytes(pid()).ok.get

main() -> int
  // Shallow threads first, so the workers and the runtime's own memory are there before measuring.
  for round in 0 ..< 10
    val warm = (0 ..< 100).map(i -> spawn(() -> i)).toVector
    for t in warm do _ = t.join()
  val before = resident()
  var right = 0
  for round in 0 ..< 100
    val threads = (0 ..< 100).map(i -> spawn(() -> depth(20000))).toVector
    right += threads.count(t -> t.join() == 20000)
  println(right)
  println(resident() - before < 33554432)
  0
