// expect: exit 0
// `derives Enumerable` on a data type whose variants have no fields: `values()` is every variant in
// declaration order, `ordinal()` each one's 0-based position, `name()` its declared name and
// `valueOf(name)` the variant of exactly that name, or `None`. Every variant round-trips through
// its name and its position.

data Color derives Enumerable
    Red
    Green
    Blue

// One variant, and the single-line form, whose one variant is the type's name.
data Single derives Enumerable
    Only

data Marker() derives Enumerable

// Variant names that are also the trait's method names, and a long one.
data Awkward derives Enumerable
    Values
    Name
    Ordinal
    ValueOf
    AVeryLongVariantNameThatGoesOnAndOnAndOnPastAnyShortBuffer

colorWord(c: Color) -> string = c.ordinal() match
    0 -> "first"
    1 -> "second"
    _ -> "later"

main()
    println(Color.values())
    for c in Color.values()
        println(s"${c.ordinal()} ${c.name()} $c ${colorWord(c)}")
    println(Color.values().length())
    println(Color.valueOf("Red"))
    println(Color.valueOf("Blue"))
    println(Color.valueOf("Blue") == Some(Blue))
    // Exact names only: the empty string, another case, white space around it, a prefix, a longer
    // name and non-ASCII text are no variant.
    for text in ["", "red", "RED", "rED", " Red", "Red ", "Re", "Redd", "Rød", "Grün"]
        println(s"[$text] ${Color.valueOf(text)}")
    assert(Color.valueOf("Red\u0000") == None)
    // Round trips.
    val all = Color.values()
    for i in 0..<all.length()
        val c = all(i)
        assert(c.ordinal() == i)
        assert(Color.valueOf(c.name()) == Some(c))
        assert(all(c.ordinal()) == c)
    // A new vector each time, equal to the last.
    assert(Color.values() == Color.values())
    // A value reached by a match is the same variant `values()` holds.
    val picked = Green
    assert(picked == all(1))
    assert(picked.ordinal() == 1)
    println(picked.name())
    println(Single.values())
    println(Only.ordinal())
    println(Only.name())
    println(Single.valueOf("Only"))
    println(Single.valueOf("Single"))
    println(Marker.values())
    val marker: Marker = Marker
    println(marker.ordinal())
    println(marker.name())
    println(Marker.ordinal())
    println(Marker.valueOf("Marker"))
    println(Awkward.values())
    for a in Awkward.values()
        println(s"${a.ordinal()} ${a.name()} ${Awkward.valueOf(a.name()) == Some(a)}")
    println(Awkward.valueOf("Values"))
    println(Awkward.valueOf("values"))
