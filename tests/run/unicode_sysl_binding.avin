// expect: exit 0
// A Sysl binding may be named, and its parameters named, in any script: the shim's symbol spells
// each byte that is not an ASCII letter or digit in hexadecimal, so the name never reaches a symbol
// table as it is written.
@sysl("sysl.text.to_upper")
groß(größe: string) -> string

@sysl("sysl.text.to_upper")
大写(文字: string) -> string

@sysl("sysl.text.to_lower")
private нижний(s: string) -> string

main()
    println(groß("straße"))
    println(groß(größe = "ärger"))
    val f = 大写
    println(f("über"))
    println(нижний("ЖУК"))
