// expect: exit 0
// A collection literal builds the type it is expected to be through that type's own conformance to
// `Buildable`: every library collection, a program's own, generic or not, a type parameter bounded by
// the trait, and nested and empty literals. A companion's `newBuilder` is never the literal's.

import avin.collections.mutable.{
  BitSet as MutableBitSet,
  LinkedMap,
  LinkedSet,
  Map as MutableMap,
  PriorityQueue,
  Set as MutableSet,
  TreeMap as MutableTreeMap,
  TreeSet as MutableTreeSet
}

// A program's own generic collection, built by a literal through its impl.
class Stack[T](val items: List[T])

class StackBuilder[T]: Builder[T, Stack[T]]
  private var items: List[T] = Nil

  override addOne(element: T)
    items = element :: items

  override result() -> Stack[T] = Stack(items)

  override clear()
    items = Nil

impl[T] Buildable[T] for Stack[T]
  static newBuilder() -> StackBuilder[T] = StackBuilder[T]()

// A collection with both a companion `newBuilder` and a `Buildable` impl: the literal uses the impl,
// whose builder keeps the elements as they are, never the companion's, which doubles them.
class Tally(val total: int)

class TallyBuilder(private val factor: int): Builder[int, Tally]
  private var total = 0

  override addOne(element: int)
    total += element * factor

  override result() -> Tally = Tally(total)

  override clear()
    total = 0

impl Buildable[int] for Tally
  static newBuilder() -> TallyBuilder = TallyBuilder(1)

object Tally
  newBuilder() -> TallyBuilder = TallyBuilder(2)

// A collection of pairs, built by a map literal.
data Ledger(lines: List[string])

class LedgerBuilder: Builder[(string, int), Ledger]
  private var lines: List[string] = Nil

  override addOne(element: (string, int))
    lines = s"${element.0}=${element.1}" :: lines

  override result() -> Ledger = Ledger(lines.reverse)

  override clear()
    lines = Nil

impl Buildable[(string, int)] for Ledger
  static newBuilder() -> LedgerBuilder = LedgerBuilder()

// A generic type that is a collection at one instance only, by an impl for that instance.
class Count[T](val n: int)

class CountBuilder: Builder[int, Count[int]]
  private var n = 0

  override addOne(element: int)
    n += element

  override result() -> Count[int] = Count[int](n)

  override clear()
    n = 0

impl Buildable[int] for Count[int]
  static newBuilder() -> CountBuilder = CountBuilder()

// Literals where a type parameter bounded by the trait is expected: each instance builds its own.
make[C: Buildable[int]]() -> C = [3, 1, 2]

makeSet[C: Buildable[int]]() -> C = {5, 4}

makeEmpty[C: Buildable[string]]() -> C = []

makeMap[M: Buildable[(string, int)]]() -> M = {b: 2, a: 1}

// The static member called through the bound.
fill[C: Buildable[int]](n: int) -> C
  val b = C.newBuilder()
  for i in 1 .. n do b.addOne(i)
  b.result()

main()
  // Sequences.
  val vector: Vector[int] = [1, 2, 3]
  val list: List[int] = [1, 2, 3]
  val array: Array[int] = [1, 2, 3]
  val buffer: Buffer[int] = [1, 2, 3]
  val arraySeq: ArraySeq[int] = [1, 2, 3]
  val deque: Deque[int] = [1, 2, 3]
  val queue: Queue[int] = [1, 2, 3]
  println(s"$vector $list $array $buffer $arraySeq $deque $queue")
  buffer.addOne(4)
  deque.prepend(0)
  println(s"$buffer $deque ${queue.dequeue.0}")

  // Immutable sets and maps.
  val set: Set[int] = {3, 1, 2}
  val hashSet: HashSet[int] = {3, 1, 2}
  val sortedSet: SortedSet[int] = {3, 1, 2}
  val treeSet: TreeSet[int] = {3, 1, 2}
  val seqSet: SeqSet[int] = {3, 1, 2}
  val orderedSet: OrderedSet[int] = {3, 1, 2}
  val bitSet: BitSet = {3, 1, 2}
  println(s"${set.size} ${hashSet.size} $sortedSet $treeSet $seqSet $orderedSet $bitSet")
  val map: Map[string, int] = {b: 2, a: 1}
  val hashMap: HashMap[string, int] = {b: 2, a: 1}
  val sortedMap: SortedMap[string, int] = {b: 2, a: 1}
  val treeMap: TreeMap[string, int] = {b: 2, a: 1}
  val seqMap: SeqMap[string, int] = {b: 2, a: 1}
  val orderedMap: OrderedMap[string, int] = {b: 2, a: 1}
  println(s"${map("a")} ${hashMap("b")} $sortedMap $treeMap $seqMap $orderedMap")

  // Mutable sets and maps, and the priority queue.
  val mset: MutableSet[int] = {1, 2}
  mset.add(3)
  val mtree: MutableTreeSet[int] = {3, 1, 2}
  val linkedSet: LinkedSet[int] = {3, 1, 2}
  val mbits: MutableBitSet = {3, 1}
  mbits.add(2)
  println(s"${mset.size} $mtree $linkedSet $mbits")
  val mmap: MutableMap[string, int] = {a: 1}
  mmap("b") = 2
  val mtreeMap: MutableTreeMap[string, int] = {b: 2, a: 1}
  val linkedMap: LinkedMap[string, int] = {b: 2, a: 1}
  println(s"${mmap.size} $mtreeMap $linkedMap")
  val pq: PriorityQueue[int] = [3, 9, 1]
  println(s"${pq.size} ${pq.dequeue()}")

  // A program's own collections.
  val stack: Stack[string] = ["a", "b"]
  val tally: Tally = [1, 2, 3]
  val viaCompanion = Tally.newBuilder()
  viaCompanion.addOne(1)
  val ledger: Ledger = {x: 1, y: 2}
  println(s"${stack.items} ${tally.total} ${viaCompanion.result().total} ${ledger.lines}")

  // Through a bound.
  val v: Vector[int] = make()
  val t: TreeSet[int] = make()
  val s: Stack[int] = make()
  val b: BitSet = makeSet()
  val l: List[int] = makeSet()
  val e: TreeSet[string] = makeEmpty()
  val m: TreeMap[string, int] = makeMap()
  val g: Ledger = makeMap()
  println(s"$v $t ${s.items} $b $l ${e.isEmpty} $m ${g.lines}")
  val filled: Buffer[int] = fill(3)
  val counted: Tally = fill(4)
  println(s"$filled ${counted.total}")

  // Nested and empty literals.
  val grid: Vector[TreeSet[int]] = [{3, 1}, {}, {2}]
  val index: TreeMap[string, Buffer[int]] = {b: [2], a: []}
  index("a").addOne(7)
  val stacks: Stack[Stack[int]] = [[1, 2], []]
  println(s"$grid $index ${stacks.items.map(_.items)}")
  val noStack: Stack[int] = []
  val noTally: Tally = []
  val noLedger: Ledger = {}
  val noTree: TreeSet[int] = {}
  val noMap: TreeMap[int, int] = {}
  println(s"${noStack.items} ${noTally.total} ${noLedger.lines} $noTree $noMap")
  val nothing = []
  println(s"${nothing.length} ${nothing}")

  // An instance impl, and trait types built by their own conformances.
  val count: Count[int] = [1, 2, 3]
  val noCount: Count[int] = []
  val counted2: Count[int] = fill(3)
  val noMapAsSet: Map[string, int] = {}
  val sortedEmpty: SortedSet[int] = {}
  val seqMapEmpty: SeqMap[int, int] = {}
  println(s"${count.n} ${noCount.n} ${counted2.n} $noMapAsSet $sortedEmpty $seqMapEmpty")
