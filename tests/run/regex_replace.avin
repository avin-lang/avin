// expect: exit 0
// `avin.regex` replacing and splitting: group references in a replacement, a replacement computed
// from each match, replacing some matches only, empty matches between characters, splitting with
// and without a limit, and quoting text as a pattern or as a replacement.
import avin.regex
import avin.regex.{Regex, Match}

main()
    val date = Regex("(?<year>\\d{4})-(?<month>\\d\\d)")
    println(date.replaceAllIn("2024-06 and 2025-01", "$2/$1"))
    println(date.replaceAllIn("2024-06 and 2025-01", "${month}.${year}"))
    println(date.replaceFirstIn("2024-06 and 2025-01", "<$0>"))
    println(date.replaceAllIn("2024-06", "\\$1 costs \\\\"))
    println(Regex("\\d+").replaceAllIn("a1b22", m -> (m.matched().toInt().get() * 2).toString()))
    println(Regex("(\\w)").replaceAllIn("ab", (m: Match) -> "$1$1"))
    println(Regex("\\w+").replaceSomeIn("one two three", m -> if m.matched().byteLength() == 3 then Some(m.matched().toUpperCase()) else None))
    println(Regex("").replaceAllIn("é😀", "-"))
    println(Regex("a*").replaceAllIn("baaac", "-"))
    println(Regex("x").replaceAllIn("abc", "-"))
    println(Regex("(a)(b)?").replaceAllIn("ab a", "[$2]"))
    println(Regex("(a)").replaceAllIn("a", "$10"))
    println(Regex("\\$").replaceAllIn("$5", Regex.quoteReplacement("\\$")))
    println(Regex(",").split("a,b,,c,,").toList())
    println(Regex(",").split("a,b,,c,,").length())
    println(Regex("").split("é😀").toList())
    println(Regex("\\s+").split("no-spaces").toList())
    println(Regex(",").pattern().split("a,b,,", -1).toList())
    println(Regex(",").pattern().split("a,b,c", 2).toList())
    println(Regex.quote("1+1=2"))
    println(Regex(Regex.quote("a.b\\Ec")).findFirstIn("xa.b\\Ec"))
