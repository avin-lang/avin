// expect: exit 0

// Generic extractors: values of generic classes, used in generic code and at several types.
class Pair[A]: Extractor[List[A], (A, A)]
  override unapply(xs: List[A]) -> Option[(A, A)] = xs match
    [a, b] -> Some((a, b))
    _ -> None

// An extractor that is a value of a generic class.
class Equals[T: Eq](wanted: T): BoolExtractor[T]
  override unapply(x: T) -> bool = x == wanted

class Wrapped[T](label: string): SeqExtractor[Vector[T], List[T]]
  override unapplySeq(xs: Vector[T]) -> Option[List[T]] = if xs.isEmpty then None else Some(xs.toList)

swap[A](xs: List[A]) -> List[A]
  val pair = Pair[A]()
  xs match
    pair(a, b) -> [b, a]
    _ -> xs

count[T: Eq](xs: List[T], wanted: T) -> int
  val target = Equals(wanted)
  var n = 0
  for x in xs
    if x is target() then n += 1
  n

ends[T: Display](xs: Vector[T]) -> string
  val w = Wrapped[T]("w")
  xs match
    w(only) -> s"only $only"
    w(first, _*) -> s"first $first"
    _ -> "empty"

main()
  println(swap([1, 2]))
  println(swap(["a", "b"]))
  println(swap([1, 2, 3]))
  println(count([1, 2, 1, 3, 1], 1))
  println(count(["x", "y"], "y"))
  println(ends([7]))
  println(ends(["p", "q"]))
  println(ends(Vector.empty[int]()))
