// expect: exit 0

// A generic extractor method, used in generic code and at several types.
object Pair
    unapply[A](xs: List[A]) -> Option[(A, A)] = xs match
        [a, b] -> Some((a, b))
        _ -> None

// An extractor that is a value of a generic class.
class Equals[T: Eq](wanted: T)
    unapply(x: T) -> bool = x == wanted

class Wrapped[T](label: string)
    unapplySeq(xs: Vector[T]) -> Option[List[T]] = if xs.isEmpty() then None else Some(xs.toList())

swap[A](xs: List[A]) -> List[A] = xs match
    Pair(a, b) -> [b, a]
    _ -> xs

count[T: Eq](xs: List[T], wanted: T) -> int
    val target = Equals(wanted)
    var n = 0
    for x in xs
        if x is target() then n += 1
    n

ends[T: Display](xs: Vector[T]) -> string
    val w = Wrapped[T]("w")
    xs match
        w(only) -> s"only $only"
        w(first, _*) -> s"first $first"
        _ -> "empty"

main()
    println(swap([1, 2]))
    println(swap(["a", "b"]))
    println(swap([1, 2, 3]))
    println(count([1, 2, 1, 3, 1], 1))
    println(count(["x", "y"], "y"))
    println(ends([7]))
    println(ends(["p", "q"]))
    println(ends(Vector.empty[int]()))
