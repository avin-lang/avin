// expect: exit 42
// `return` as an operand: it leaves the function at once, so the arguments after it are never
// evaluated and the call around it never happens. A bare `return` in a unit function, and the exit
// status from `main`'s result.

identity[T](x: T) -> T = return x

value(x: int) -> int
    println(x)
    x

combine(a: int, b: int, c: int) = a + b + c

leave() -> int
    combine(value(1), return 42, value(3))
    99

search() -> int
    var n = 0
    while n < 4
        n += 1
        if n == 3 then return n
        println(n)
    -1

wide() -> i128 = return 18446744073709551616

stop()
    return
    println(999)

in_condition() -> int
    while (return 42) do println(99)
    0

after_range() -> int
    lower()..<(return 7)
    0

lower() -> int
    println("first")
    1

unit_value() -> unit = return ()

early(flag: bool) -> string
    if flag then return "early"
    "late"

bare_argument()
    println(return, 99)

main() -> int
    bare_argument()
    println(leave())
    println(search())
    println(wide())
    println(identity('é'), identity(0.5))
    stop()
    println(in_condition())
    println(after_range())
    println(unit_value() match
        () -> 42)
    println(early(true), early(false))
    return 42
