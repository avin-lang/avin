// A `match` with nothing before it, where a `PartialFunction` is expected, need not cover every
// value: `isDefinedAt` tells where it is defined, and `lift`, `applyOrElse` and `orElse` work with it.

data Shape
  Circle(r: real)
  Rect(w: real, h: real)

main()
  val half: PartialFunction[int, int] = match n if n % 2 == 0 -> n / 2
  println(s"${half.isDefinedAt(4)} ${half.isDefinedAt(3)} ${half(10)}")
  println(s"${half.applyOrElse(7, x -> -x)} ${half.applyOrElse(8, x -> -x)}")

  val lifted = half.lift()
  println(s"${lifted(6)} ${lifted(5)}")

  val small: PartialFunction[int, string] = match
    1 -> "one"
    2 -> "two"
  val big: PartialFunction[int, string] = match n if n > 100 -> "big"
  val either = small.orElse(big)
  println(s"${either(1)} ${either(500)} ${either.isDefinedAt(50)} ${either.lift()(50)}")

  // A guard runs once for each `applyOrElse`: the patterns are tested once.
  var tests = 0
  positive(n: int) -> bool
    tests += 1
    n > 0
  val counted: PartialFunction[int, int] = match
    n if positive(n) -> n
  println(s"${counted.applyOrElse(3, _ -> 0)} ${counted.applyOrElse(-3, _ -> 0)} $tests")

  // collect and collectFirst.
  val shapes = [Circle(1.0), Rect(2.0, 3.0), Circle(20.0)]
  val radii = shapes.collect(match Circle(r) -> r)
  println(radii.mkString(" "))
  val firstBig = shapes collectFirst match
    Circle(r) if r > 10.0 -> r
  println(s"$firstBig")
  println(s"${shapes.collectFirst(match Rect(w, h) if w > 5.0 -> w * h)}")

  println([Some(1), None, Some(3)].collect(match Some(n) -> n * 10).mkString(","))
  val list: List[int] = [1, 2, 3, 4]
  println(list.collect(match n if n % 2 == 0 -> n * n).toString())
  println((1 .. 10).collect(match n if n % 3 == 0 -> s"<$n>").mkString(""))
  val array = Array.fill(3, 7)
  println(array.collect(match n if n > 5 -> n + 1).mkString(","))
  val buffer = Buffer[int]()
  buffer.addOne(1)
  buffer.addOne(2)
  println(buffer.collect(match 2 -> "two").mkString(","))
  val deque = Deque[int]()
  deque.append(5)
  deque.append(6)
  println(deque.collect(match 6 -> 60).mkString(","))
  val set: Set[int] = {1, 2, 3}
  println(set.collect(match n if n > 1 -> n * 0).toString())
  val map: Map[string, int] = {a: 1, b: 2}
  println(map.collect(match (k, v) if v > 1 -> (k + k, v)).toString())
  println(s"${map.collectFirst(match (k, 1) -> k)}")
  println(s"${Some(4).collect(match n if n > 3 -> n)} ${Some(2).collect(match n if n > 3 -> n)}")
  println(s"${list.collectFirst(match n if n > 9 -> n)}")
