// expect: exit 0
// `length` is a snapshot of the values a channel holds, sent and not yet received; `capacity` is the
// bound it was made with. Reading either never consumes or waits.

import avin.threads.Channel

main(args: Vector[string])
  val ch = Channel[int](3)
  println(s"${ch.length} ${ch.size} ${ch.capacity}")
  ch.send(1)
  ch.send(2)
  println(s"${ch.length} ${ch.size}")
  ch.send(3)
  println(s"${ch.length} ${ch.trySend(4)} ${ch.length}")
  println(ch.receive())
  println(s"${ch.length} ${ch.length}")
  ch.close()
  println(s"${ch.length} ${ch.isClosed()}")
  println(ch.toVector)
  println(ch.length)

  val unbounded = Channel[string]()
  for i in 0 ..< 1000 do unbounded.send(s"v$i")
  println(s"${unbounded.length} ${unbounded.capacity == 2147483647}")
  var n = 0
  while unbounded.length > 0
    unbounded.receive()
    n += 1
  println(n)

  val rendezvous = Channel[int](0)
  println(s"${rendezvous.length} ${rendezvous.capacity}")
  println(rendezvous.trySend(1))
  println(rendezvous.length)

  val empty = Channel[int]()
  println(empty.size)
  println(empty.length)
