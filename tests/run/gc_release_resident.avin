// expect: exit 0
// env: AVIN_GC_STRESS=0
// A burst of a million strings held and then dropped: once collections have freed it, the heap gives
// its pages back to the system, and the program's resident size falls far below its peak, while
// what the program keeps allocating afterwards is reused in place.
import avin.process

resident() -> long = process.residentBytes(process.pid()).ok.getOrElse(0)

main()
  val start = resident()
  var held = Buffer[string]()
  for i in 0 ..< 1000000 do held += s"burst object number $i"
  val peak = resident()
  println(s"${held.length} objects, grew by more than 40 MB: ${peak - start > 41943040}")
  println(held(999999))
  held = Buffer[string]()
  // Enough short-lived allocation that collections run after the drop: the first frees the burst,
  // a later one finds the heap reaching far past what it holds and releases.
  var churn = 0
  for i in 0 ..< 2000000 do churn += s"small garbage $i".byteLength
  println(churn)
  val after = resident()
  println(s"after the drop, below a quarter of the peak: ${after < peak / 4}")
