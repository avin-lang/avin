// expect: exit 0
// A width or precision written as a hole is counted when the program runs, from an integer of any
// width: a negative width pads on the right at its magnitude, a negative precision is as though none
// were written, and a count beyond `int` is the largest `int`. Flags written before a counted width
// still apply, and a value that renders itself is handed the counts in its `FormatSpec`.
data Tag(name: string)

impl Display for Tag
  display(out: Writer, spec: FormatSpec) = out.writeField(s"<${name}>", spec)

main()
  val x = 3.14159265
  for n in [0, 2, 6]
    println(f"[${x}%.${n}f] [${42}%0${n + 3}d] [${"abcdefgh"}%.${n}s]")
  val w: i8 = -6
  val p: long = -3
  println(f"[${42}%${w}d] [${x}%.${p}f] [${x}%${w}.${2}f] [${"hi"}%${w}s|]")
  val far: i128 = -170141183460469231731687303715884105728
  println(f"[${"cut"}%.${far}s] [${7}%+0${i16(5)}d]")
  println(f"[${Tag("t")}%${8}s] [${Tag("t")}%-${8}s] [${Tag("t")}%${-8}s]")
  println(FormatSpec().withWidth(-5), FormatSpec().withPrecision(far), FormatSpec(width = 3).withWidth(far + 1))
