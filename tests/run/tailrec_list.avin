// expect: exit 0
// env: AVIN_GC_STRESS=0
// A list of ten million elements is built and taken apart by functions that call themselves in tail
// position, each running as a loop: building onto an accumulator, matching the list's variants,
// walking it with a type parameter, and testing it with `is`. Collecting at every allocation is off
// for so many; `tailrec_capture` builds a short list under it.

data Chain[+T]
    Link(head: T, tail: Chain[T])
    End

@tailrec
build(n: int, acc: Chain[int]) -> Chain[int] = if n == 0 then acc else build(n - 1, Link(n, acc))

@tailrec
total(xs: Chain[int], acc: long) -> long = xs match
    Link(h, t) -> total(t, acc + long(h))
    End -> acc

@tailrec
size[T](xs: Chain[T], acc: int) -> int = xs match
    Link(_, t) -> size(t, acc + 1)
    End -> acc

@tailrec
last[T](xs: Chain[T], fallback: T) -> T
    if xs is Link(h, End) then return h
    xs match
        Link(_, t) -> last(t, fallback)
        End -> fallback

@tailrec
reverse[T](xs: Chain[T], acc: Chain[T]) -> Chain[T] = xs match
    Link(h, t) -> reverse(t, Link(h, acc))
    End -> acc

main() -> int
    val deep = 10000000
    val xs = build(deep, End)
    println(total(xs, 0))
    println(size(xs, 0))
    println(last(xs, -1))
    val back = reverse(xs, End)
    back match
        Link(h, _) -> println(h)
        End -> println("empty")
    println(size(reverse(build(3, End), End), 0))
    0
