// expect: exit 0
// An overload accepts an argument of a subtype of its parameter's type, or of a covariant instance
// of it, as a call of a single function does; of several that accept it, the one whose parameter
// types the others accept is chosen. A type's own method overloads one an impl adds to its trait.

open class Animal(val name: string)
class Dog(n: string): Animal(n)

kind(x: Iterable[int]) -> string = "iterable"
kind(x: string) -> string = "string"

pick(a: Animal) -> string = s"animal ${a.name}"
pick(d: Dog) -> string = s"dog ${d.name}"

count(xs: Seq[Animal]) -> string = s"animals ${xs.length()}"
count(xs: Vector[Dog]) -> string = s"dogs ${xs.length()}"
count(n: int) -> string = s"number $n"

class Shelf(n: int)
    take(x: Iterable[int]) -> string = "some ints"
    take(x: Seq[int]) -> string = "a sequence of ints"
    take(x: string) -> string = "a word"

trait Named
    name() -> string

impl Named
    greet(other: Named) -> string = s"${name()} greets ${other.name()}"

class Person(private val who: string): Named
    override name() -> string = who
    greet(other: Person) -> string = s"${name()} shakes hands with ${other.name()}"

class Robot: Named
    override name() -> string = "robot"

main()
    val v = [1, 2, 3]
    val l: List[int] = [4, 5]
    print(s"${kind(v)} ${kind(l)} ${kind(1 .. 3)} ${kind("x")}")
    val rex = Dog("rex")
    val cat = Animal("tom")
    val seen: Animal = rex
    print(s"${pick(rex)} ${pick(cat)} ${pick(seen)}")
    val dogs: Vector[Dog] = [rex]
    val list: List[Dog] = [rex, rex]
    print(s"${count(dogs)} ${count(list)} ${count([cat])} ${count(3)}")
    val shelf = Shelf(1)
    print(s"${shelf.take(v)} ${shelf.take(v.toSet())} ${shelf.take("w")}")
    val ann = Person("ann")
    print(s"${ann.greet(Person("bob"))} ${ann.greet(Robot())}")
    // A list's own `++` keeps a list, sharing a list on its right; seen as a `Seq`, it joins into a
    // vector.
    val both: List[int] = l ++ l
    val mixed: List[int] = l ++ v
    val seq: Seq[int] = l
    print(s"$both $mixed ${seq ++ l} ${v ++ v} ${v ++ l}")
