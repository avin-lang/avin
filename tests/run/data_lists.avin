// expect: exit 0
// Recursive data built and taken apart; every allocation collects (the test runner sets
// AVIN_GC_STRESS), so every value still in use must be found by the collector.

data List[+T]
  Cons(head: T, tail: List[T])
  Nil

data Tree
  Node(left: Tree, value: int, right: Tree)
  Leaf

range(from: int, to: int) -> List[int] = if from > to then Nil else Cons(from, range(from + 1, to))

sum(xs: List[int]) -> int = xs match
  Cons(h, t) -> h + sum(t)
  Nil -> 0

length[T](xs: List[T]) -> int = xs match
  Cons(_, t) -> 1 + length(t)
  Nil -> 0

reverse[T](xs: List[T]) -> List[T]
  var out: List[T] = Nil
  var rest = xs
  while rest is Cons(_, _)
    rest match
      Cons(h, t) ->
        out = Cons(h, out)
        rest = t
      Nil -> ()
  out

insert(t: Tree, v: int) -> Tree = t match
  Leaf -> Node(Leaf, v, Leaf)
  Node(l, x, r) -> if v < x then Node(insert(l, v), x, r) else Node(l, x, insert(r, v))

total(t: Tree) -> int = t match
  Leaf -> 0
  Node(l, x, r) -> total(l) + x + total(r)

first(t: Tree) -> int = t match
  Node(Leaf, x, _) -> x
  Node(l, _, _) -> first(l)
  Leaf -> -1

main() -> int
  val xs = range(1, 100)
  if sum(xs) != 5050 || length(xs) != 100 then return 1
  val ys = reverse(xs)
  ys match
    Cons(100, Cons(99, _)) -> ()
    _ -> return 2
  if sum(ys) != 5050 then return 3
  var words: List[string] = Nil
  words = Cons("b", Cons("a", words))
  if length(words) != 2 then return 4
  var t = Leaf
  var i = 0
  while i < 50
    t = insert(t, (i * 37) % 50)
    i += 1
  if total(t) != 1225 || first(t) != 0 then return 5
  0
