// expect: exit 0
// A constructor trait's default bodies are compiled for each constructor implementing it, so they
// call static members on `Self`, and a default may override a method a required trait declares:
// `Chainable`'s `map` is `flatMap` then `Self.pure`. Where a type has no `map` of its own, the
// default is its `map` (`Box`, a class `Crate`, `Lazy`, and `Outcome[_, E]` at its first
// hole); where it has one that meets the trait's, its own is called (`Option`, `List`), answering
// exactly as before.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

trait Pointed[A]: Mappable[A]
  static pure[X](value: X) -> Self[X]

trait Chainable[A]: Pointed[A]
  flatMap[B](f: (A) -> Self[B]) -> Self[B]
  override map[B](f: (A) -> B) -> Self[B] = flatMap(a -> Self.pure(f(a)))
  // `Self.pure` as a function value, and in a nested closure.
  rewrap() -> Self[A] = flatMap(Self.pure)
  paired[B](other: Self[B]) -> Self[(A, B)] = flatMap(a -> other.flatMap(b -> Self.pure((a, b))))
  constant[B](b: B) -> Self[B] = map(_ -> b)

data Box[T](value: T)

impl[T] Box[T]
  flatMap[B](f: (T) -> Box[B]) -> Box[B] = f(value)

impl Chainable for Box
  static pure[X](value: X) -> Box[X] = Box(value)

class Crate[A](val item: A): Chainable[A]
  static pure[X](value: X) -> Crate[X] = Crate(value)
  flatMap[B](f: (A) -> Crate[B]) -> Crate[B] = f(item)

data Lazy[T](get: () -> T)

impl Chainable for Lazy
  static pure[X](value: X) -> Lazy[X] = Lazy(() -> value)
  flatMap[B](f: (T) -> Lazy[B]) -> Lazy[B] = Lazy(() -> f(get()).get())

data Outcome[T, E]
  Done(value: T)
  Failed(error: E)

impl[T, E] Chainable[T] for Outcome[T, E]
  static pure[X](value: X) -> Outcome[X, E] = Done(value)
  flatMap[B](f: (T) -> Outcome[B, E]) -> Outcome[B, E] = self match
    Done(v) -> f(v)
    Failed(e) -> Failed(e)

impl Chainable for Option
  static pure[X](value: X) -> Option[X] = Some(value)

impl Chainable for List
  static pure[X](value: X) -> List[X] = List(value)

incr[F[_]: Mappable](x: F[int]) -> F[int] = x.map(n -> n + 1)

main()
  // The default `map`, at four constructors, called on the type and through a bound.
  println(Box(1).map(n -> n + 1).value)
  println(incr[Box](Box(2)).value)
  println(Crate(3).map(n -> s"c$n").item)
  println(incr[Crate](Crate(4)).item)
  println(Box("é").rewrap().value)
  println(Crate(5).paired(Crate("five")).item)
  println(Box(6).constant('x').value)
  println(Lazy(() -> 7).map(n -> n * 2).get())
  println(incr[Lazy](Lazy.pure(int.MaxValue - 1)).get())
  println(Lazy(() -> "a").paired(Lazy.pure('b')).get())
  // A two-parameter type at its first hole, `Outcome[_, E]`.
  println(Done[int, string](12).map(n -> n + 1))
  println(incr[Outcome[_, string]](Failed("no")))
  println(Outcome[_, bool].pure(13).constant("k"))
  // The types' own `map` meets the trait's, so it is the one called, on the type and through it.
  println(Some(8).map(n -> n + 1))
  println(incr[Option](Some(9)))
  println(incr[Option](None))
  println(List(1, 2).map(n -> n * 10))
  println(incr[List](List()))
  // The other defaults at those types call their `pure`.
  println(Some(10).rewrap())
  println(Option.pure(11).paired(Some("b")))
  println(List(1, 2).paired(List('a', 'b')))
  println(List(1, 2, 3).constant(0))
