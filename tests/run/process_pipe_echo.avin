// expect: exit 0
// A command started with its standard input and output piped: what the program writes into the
// child's input comes back on its output as it arrives, `cat` echoing it, before the input has ended.
// `read(max)` answers what has arrived without waiting for `max` bytes, `readLine` a line at a time,
// and closing the input ends `cat`'s, after which its output ends, an empty read, as often as asked.
import avin.process.Command
import avin.time.millis

main() -> int
  val child = Command("cat").pipeInput().pipeOutput().start().ok.get
  val input = child.stdin()
  val output = child.stdout()

  // Nothing has arrived: a read of only what is there answers `None`, and nothing is readable.
  println(s"available before any write: ${output.readAvailable(10).ok.get}, readable: ${output.readable()}")

  // One write, one read: the read answers the five bytes that arrived, far fewer than it asked for.
  input.write("hello".utf8).ok.get
  var got = ""
  while got.byteLength < 5 do got = got + string.fromUtf8Lossy(output.read(65536).ok.get)
  println(s"echoed: $got")

  // A line read ahead past its end is what `readAvailable` answers first, a piece at a time.
  input.writeText("ab\ncdef").ok.get
  println(s"line: ${output.readLine().ok.get.get}")
  var rest = ""
  var taken = 0
  while taken < 4
    output.readAvailable(2).ok.get match
      Some(b) ->
        rest = rest + s"[${string.fromUtf8Lossy(b)}]"
        taken += b.length
      None -> ()
  println(s"available after it: $rest")

  // Lines, each read as soon as it is written.
  for word in ["one", "two", "three"]
    input.writeText(s"$word\n").ok.get
    val line = output.readLine().ok.get.get
    println(s"line: $line")

  // Text that is not ASCII, and an empty write, which writes nothing.
  input.write(Array.empty[byte]()).ok.get
  input.writeText("π ✓\n").ok.get
  println(s"unicode: ${output.readLine().ok.get.get}")

  // The same end every time it is asked for.
  println(s"same input: ${child.stdin() === input}")
  println(s"same output: ${child.stdout() === output}")

  // Closing the input ends cat's, then its output ends, and the reads say so as often as asked.
  input.writeText("last, no newline").ok.get
  input.close().ok.get
  input.close().ok.get
  println(s"rest: ${string.fromUtf8Lossy(output.readAll().ok.get)}")
  println(s"after the end: ${output.read(10).ok.get.length} ${output.read(10).ok.get.length}")
  println(s"line after the end: ${output.readLine().ok.get}")
  println(s"status: ${child.waitFor().ok.get}")

  // A closed end answers errors rather than trapping.
  println(input.write("x".utf8).err.get.message)
  println(s"writable once closed: ${input.writable()}, descriptor: ${input.writabilityDescriptor()}")
  println(input.setTimeout(millis(5)).err.get.message)
  output.close().ok.get
  println(output.read(1).err.get.message)
  println(output.readAvailable(1).err.get.message)
  println(s"readable once closed: ${output.readable()}, descriptor: ${output.readinessDescriptor()}")
  0
