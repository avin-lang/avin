// expect: exit 0
// A method value made sendable carries its receiver's value, evaluated where the value is made, so
// what the receiver expression uses on the way stays behind: a sendable receiver built from a
// mutable object, a buffer, a `var`, a non-sendable parameter or a function reaching module-level
// state is accepted, as an argument for a
// `@sendable` parameter, a `val` of a `@sendable` type and a function's result, for a class, a
// generic class and data, and the receiver is evaluated once.
import avin.threads.spawn

class Counter()
  var n = 0

class Adder(val n: int): Sendable
  add(x: int) -> int = n + x

class Scaled[T: Sendable](val factor: int, val label: T): Sendable
  scale(x: int) -> int = factor * x

data Offset(by: int)

impl Offset
  move(x: int) -> int = x + by

take(@sendable f: (int) -> int) -> int = f(1)

var made = 0

adderOf(c: Counter) -> Adder
  made += 1
  Adder(c.n)

// The receiver is built from a parameter that is not sendable.
bound(c: Counter) -> @sendable (int) -> int = Adder(c.n * 2).add

main()
  val c = Counter()
  c.n = 10
  val log = Buffer[int]()
  log.addOne(5)
  var v = 3
  v += 1
  println(take(Adder(c.n).add))
  println(take(Adder(log(0)).add))
  println(take(Adder(v).add))
  println(take(Scaled[string](c.n, "x").scale))
  println(take(Offset(log.length).move))
  val f: @sendable (int) -> int = adderOf(c).add
  println(f(1), f(2), made)
  println(bound(c)(1))
  val t = spawn(() -> f(100))
  println(t.join())
  val a = Adder(7)
  println(take(a.add))
