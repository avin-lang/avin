// expect: exit 0
// Endless lazy lists: the primes by a sieve of nested filters, the Fibonacci numbers and the
// Hamming numbers defined by reference to themselves (a module-level `lazy val`, a field of an
// object and a `lazy val` field of a class), and endless lists made by recursive functions, read
// only as far as they are used.

sieve(xs: LazyList[int]) -> LazyList[int]
    val p = xs.head
    LazyList.cons(p, sieve(xs.tail.filter(n -> n % p != 0)))

lazy val primes: LazyList[int] = sieve(LazyList.from(2))

lazy val fibs: LazyList[long] = LazyList.cons(0, LazyList.cons(1, fibs.zip(fibs.tail).map(p -> p.0 + p.1)))

// The ordered merge of two endless ordered lists, without repeats.
merge(a: LazyList[long], b: LazyList[long]) -> LazyList[long]
    val x = a.head
    val y = b.head
    if x < y then LazyList.cons(x, merge(a.tail, b))
    else if y < x then LazyList.cons(y, merge(a, b.tail))
    else LazyList.cons(x, merge(a.tail, b.tail))

lazy val hamming: LazyList[long] = LazyList.cons(1, merge(hamming.map(n -> n * 2), merge(hamming.map(n -> n * 3), hamming.map(n -> n * 5))))

class Series(start: int)
    lazy val squares: LazyList[int] = LazyList.from(start).map(n -> n * n)
    lazy val running: LazyList[int] = LazyList.cons(start, running.zip(squares.tail).map(p -> p.0 + p.1))

object Triangles
    lazy val all: LazyList[int] = LazyList.cons(0, all.zipWithIndex.map(p -> p.0 + p.1 + 1))

collatz(n: long) -> LazyList[long] = LazyList.unfold(n, k -> if k == 0 then None else Some((k, if k == 1 then 0 else if k % 2 == 0 then k / 2 else 3 * k + 1)))

digitsOf(n: int) -> LazyList[int] = if n < 10 then LazyList.cons(n, LazyList.empty[int]()) else LazyList.cons(n % 10, digitsOf(n / 10))

main() -> int
    println(primes.take(15).toVector)
    println(primes(99))
    println(primes.dropWhile(p -> p < 500).head)
    println(primes.takeWhile(p -> p < 30).length)
    println(fibs.take(12).toVector)
    println(fibs(90))
    println(fibs.drop(50).head)
    println(hamming.take(20).toVector)
    println(hamming(300))
    val s = Series(1)
    println(s.running.take(5).toVector)
    println(Series(3).running.take(3).toVector)
    println(Triangles.all.take(8).toVector)
    println(collatz(27).length)
    println(collatz(6).toVector)
    println(digitsOf(90210).toVector)
    println(LazyList.iterate("", w -> w + "ab").map(w -> w.charCount()).take(4).toVector)
    println(LazyList.continually("x").take(3).mkString(""))
    println(LazyList.from(0).zip(LazyList.from(100, -1)).dropWhile(p -> p.0 < p.1).head)
    println(LazyList.from(1).flatMap(n -> LazyList.fill(n, n)).take(10).toVector)
    println(LazyList.from(1).map(n -> n * n).filter(n -> n % 7 == 1).take(5).toVector)
    println(primes.map(p -> p * p).takeWhile(p -> p < 200).sum)
    val few = sieve(LazyList.from(2))
    println(few(4))
    println(few)
    0
