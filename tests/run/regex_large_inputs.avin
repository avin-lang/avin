// expect: exit 0
// env: AVIN_GC_STRESS=0
// Typical patterns over a text of close to a million characters finish inside the default step
// budget: searching every match of words, addresses, times and alternatives, a repeated group over
// the whole text, lookarounds and a back reference. It makes a match object for each of hundreds of
// thousands of matches, so it runs without the collector's stress.
import avin.regex.Regex

doubled(s: string, k: int) -> string
    var out = s
    for _ in 0..<k do out = out + out
    out

counted(pattern: string, text: string) -> int
    var n = 0
    for _ in Regex(pattern).findAllIn(text) do n += 1
    n

main()
    val text = doubled("the quick brown fox soon mailed fox@example.com at 10:45, ", 14)
    println(s"text ${text.byteLength}")
    println(counted("\\b\\w+\\b", text))
    println(counted("(\\w+)@(\\w+)\\.com", text))
    println(counted("\\d{2}:\\d{2}", text))
    println(counted("(?:\\w+\\s?)+,", text))
    println(counted("(?:the|quick|brown|fox|mailed|at)\\s", text))
    println(counted("[^,]*,", text))
    println(counted("fox(?=@)", text))
    println(counted("(?<=@)\\w+", text))
    println(counted("(\\w)\\1", text))
    println(counted("(?i)QUICK\\s+(\\w+)", text))
    println(Regex(".*com").findFirstIn(text).map(s -> s.byteLength))
    println(Regex("^(?:[^,]*, )*$").matches(text))
    println(Regex("^(?:(\\w+)(?:@\\w+\\.com)?[ ,:]*)*$").matches(text))
    println(Regex("(?s).*zzz").findPrefixOf(text))
    println(Regex("\\w+").replaceAllIn(text, "w").byteLength)
    println(Regex(", ").split(text).length)
