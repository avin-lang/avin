// expect: exit 0
// A tuple has a trait its arity's impl states only where every part meets the impl's bounds. A set
// keeps each element in an `(A, unit)` pair, and `unit` is not `Ord`, so a program that also compares
// through `Ord` (as a list's `<` does) compiles no `compare` for the pair. Tuples whose parts are all
// ordered still compare, through a bound and through a list of them.
largest[T: Ord](items: Vector[T]) -> T
    var best = items(0)
    for x in items
        if x > best then best = x
    best

main()
    println(List(1, 1, 2).distinct())
    println(List(1) < List(2))
    println(Set(3, 4).size(), TreeSet(5, 6).size(), Map((1, ())).size())
    println(largest([(1, "b"), (2, "a"), (1, "z")]))
    println(List((1, 'a')) < List((1, 'b')))
    val units = [(), ()]
    println(units.distinct().length())
