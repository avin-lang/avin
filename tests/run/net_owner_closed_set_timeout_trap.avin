// expect: trap
// A connection the thread it was handed to has closed is still the thread's while the thread runs:
// the code that handed it over traps at `setTimeout` rather than being told the connection is
// closed, though bytes were read ahead before it was handed over.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.threads.{Channel, spawn}
import avin.time

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message)

main()
    val l = ok(TcpListener.bind("127.0.0.1", 0))
    val c = ok(TcpStream.connect("127.0.0.1", l.port()))
    val s = ok(l.accept())
    ok(c.writeText("first\nsecond\n"))
    println(ok(s.readLine()))
    val closed = Channel[int]()
    val go = Channel[int]()
    val t = spawn(() ->
        s.close()
        closed.send(1)
        go.receive()
        s.readLine().isErr())
    closed.receive()
    println("closed by the thread")
    s.setTimeout(time.millis(5))
    println("not reached")
    go.send(1)
    println(t.join())
