// expect: exit 0
// `scanRight`, `reduceRight`, `corresponds`, `segmentLength`, `findLast`, `inits`, `tails`,
// `transpose` and `unzip3` of a sequence: the empty and one-element cases, every kind of sequence,
// out-of-range `from`, elements of our own and enough allocation to move the collector.

data Pt(x: int, y: int)

main()
    val none: Vector[int] = []
    // scanRight keeps every partial fold, the initial last
    println((1 .. 3).scanRight(0, (x, acc) -> x + acc))
    println([1, 2, 3].scanRight("", (x, acc) -> s"$x$acc"))
    println([1, 2, 3].scanRight(100, (x, acc) -> x - acc))
    println(none.scanRight(7, (x, acc) -> x + acc))
    println([4].scanRight(1, (x, acc) -> x * 10 + acc))
    val l: List[int] = [1, 2, 3]
    val d: Deque[int] = [1, 2, 3]
    println(s"${l.scanRight(0, (x, acc) -> x + acc)} ${d.scanRight(0, (x, acc) -> x + acc)}")
    // reduceRight combines from the right
    println([1, 2, 3, 4].reduceRight((x, acc) -> x - acc))
    println([10, 3, 2].reduceRight((x, acc) -> x - acc))
    println(["a", "b", "c"].reduceRight((x, acc) -> s"($x$acc)"))
    println([9].reduceRight((x, acc) -> x - acc))
    println(none.reduceRightOption((x, acc) -> x + acc))
    println([9].reduceRightOption((x, acc) -> x + acc))
    println([1, 2, 3, 4].reduceRightOption((x, acc) -> x - acc))
    println(l.reduceRight((x, acc) -> x - acc) == [1, 2, 3].foldRight(0, (x, acc) -> x - acc) + 0)

    // corresponds needs equal lengths and the test to hold pairwise
    println(s"${[1, 2, 3].corresponds([2, 4, 6], (a, b) -> a * 2 == b)} ${[1, 2, 3].corresponds([2, 4, 7], (a, b) -> a * 2 == b)}")
    println(s"${[1, 2, 3].corresponds([2, 4], (a, b) -> a * 2 == b)} ${[1, 2].corresponds([2, 4, 6], (a, b) -> a * 2 == b)}")
    println(s"${none.corresponds(none, (a, b) -> false)} ${none.corresponds([1], (a, b) -> true)} ${[1].corresponds(none, (a, b) -> true)}")
    println(s"${[1, 2, 3].corresponds(["1", "2", "3"], (a, b) -> s"$a" == b)} ${l.corresponds(d, (a, b) -> a == b)} ${l.corresponds(1 .. 3, (a, b) -> a == b)}")

    // segmentLength is the run of satisfying elements from `from`
    val s = [1, 2, 3, 10, 11, 1, 2]
    println(s"${s.segmentLength(x -> x < 5)} ${s.segmentLength(x -> x < 5, 1)} ${s.segmentLength(x -> x < 5, 3)} ${s.segmentLength(x -> x > 5, 3)} ${s.segmentLength(x -> x < 5, 5)}")
    println(s"${s.segmentLength(x -> x < 5, -4)} ${s.segmentLength(x -> true, 0)} ${s.segmentLength(x -> true, 7)} ${s.segmentLength(x -> true, 100)} ${s.segmentLength(x -> false)}")
    println(s"${none.segmentLength(x -> true)} ${none.segmentLength(x -> true, 3)} ${l.segmentLength(x -> x < 3)} ${(1 .. 9).segmentLength(x -> x < 6, 2)}")

    // findLast is the last element that satisfies the test
    println(s"${s.findLast(x -> x < 3)} ${s.findLast(x -> x > 10)} ${s.findLast(x -> x > 100)} ${none.findLast(x -> true)} ${[5].findLast(x -> x == 5)}")
    println(s"${l.findLast(x -> x < 3)} ${d.findLast(x -> x % 2 == 1)} ${(1 .. 10).findLast(x -> x % 4 == 0)}")
    println([Pt(1, 2), Pt(3, 4), Pt(5, 4)].findLast(p -> p.y == 4))

    // inits and tails: n + 1 vectors, the empty one last
    println([1, 2, 3].inits().toVector())
    println([1, 2, 3].tails().toVector())
    println(none.inits().toVector())
    println(none.tails().toVector())
    println([7].inits().toVector())
    println([7].tails().toVector())
    println(s"${l.inits().toVector()} ${l.tails().toVector()} ${(1 .. 3).tails().toVector()} ${d.inits().toVector()}")
    val it = [1, 2].tails()
    println(s"${it.hasNext()} ${it.next()} ${it.next()} ${it.hasNext()} ${it.next()} ${it.hasNext()}")
    val ni = [1, 2].inits()
    println(s"${ni.next()} ${ni.next()} ${ni.next()} ${ni.hasNext()}")
    println((0 ..< 100).toVector().inits().toVector().length())
    println((0 ..< 100).toVector().tails().map(t -> t.length()).toVector().take(3))

    // transpose swaps rows and columns
    println([[1, 2, 3], [4, 5, 6]].transpose())
    println([[1], [2], [3]].transpose())
    println([[1, 2, 3]].transpose())
    println([[1, 2], [3, 4]].transpose().transpose())
    val noRows: Vector[Vector[int]] = []
    println(noRows.transpose())
    val emptyRows: Vector[Vector[int]] = [[], []]
    println(emptyRows.transpose())
    println([["a", "b"], ["c", "d"], ["e", "f"]].transpose())
    println([[Pt(1, 2), Pt(3, 4)], [Pt(5, 6), Pt(7, 8)]].transpose())
    val ll: List[List[int]] = [[1, 2], [3, 4]]
    println(ll.transpose())
    val rows: Vector[Seq[int]] = [1 .. 3, [4, 5, 6]]
    println(rows.transpose())

    // unzip3 splits triples
    val (a, b, c) = [(1, "a", 1.5), (2, "b", 2.5), (3, "c", 3.5)].unzip3()
    println(s"$a $b $c")
    val (e1, e2, e3) = Vector.empty[(int, string, bool)]().unzip3()
    println(s"$e1 $e2 $e3 ${e1.length() + e2.length() + e3.length()}")
    val (o1, o2, o3) = [(1, 'x', true)].unzip3()
    println(s"$o1 $o2 $o3")
    val (p1, p2, p3) = (List[(int, int, int)]((1, 2, 3), (4, 5, 6))).unzip3()
    println(s"$p1 $p2 $p3")

    // many allocated elements, GC pressure
    val words = (0 ..< 400).map(i -> s"w$i")
    println(words.scanRight("", (w, acc) -> if acc.byteLength() > 20 then "" else w + acc).length())
    println(words.inits().map(v -> v.length()).foldLeft(0, (x, y) -> x + y))
    val grid = (0 ..< 40).map(i -> (0 ..< 25).map(j -> s"$i,$j"))
    val t = grid.transpose()
    println(s"${t.length()} ${t(0).length()} ${t(24)(39)} ${t.transpose() == grid}")
    val triples = (0 ..< 300).map(i -> (i, s"s$i", i % 2 == 0))
    val (xs, ys, zs) = triples.unzip3()
    println(s"${xs.length()} ${ys(299)} ${zs.count(z -> z)}")
