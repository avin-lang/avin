// expect: exit 0
// Lists and sequence patterns meeting their neighbours: a list built by a builder, then traversed,
// transformed, compared, hashed, reversed and shown; a `Cat` consed onto a
// `List[Dog]` where a `List[Animal]` is expected; lists ordered element by element; and sequence
// patterns over arrays, buffers, deques and ranges, binding a rest as a vector, nesting data
// patterns and guards, in a generic function, and exhaustive with only `[]` and a rest.
open class Animal(val name: string)
class Cat(name: string) : Animal(name)
class Dog(name: string) : Animal(name)

data Shape
    Circle(r: int)
    Square(side: int)

firstTwo[T](xs: Seq[T]) -> Option[(T, T)] = xs match
    [a, b, _*] -> Some((a, b))
    _ -> None

describe(xs: Seq[Shape]) -> string = xs match
    [] -> "none"
    [Circle(r)] if r > 10 -> "one big circle"
    [Circle(_), rest*] -> s"a circle then ${rest.length}"
    [Square(s), Square(t)] -> s"two squares ${s + t}"
    [_, rest*] -> s"something then ${rest.length}"

countAll(xs: List[int]) -> int = xs match
    [] -> 0
    [_, tail*] -> 1 + countAll(tail)

pairs[A](xs: List[A]) -> List[(A, A)] = xs match
    a :: [b] -> [(a, b)]
    a :: b :: rest -> (a, b) :: pairs(rest)
    _ -> []

main()
    val n = 2000
    val zero: long = 0
    val b = List.newBuilder[int]()
    for i in 0..<n do b.addOne(i)
    val big = b.result()
    val big2 = big.map(x -> x)
    println(s"${big.length} ${big == big2} ${big.hash() == big2.hash()} ${big.filter(x -> x % 2 == 0).length} ${big.last}")
    println(s"${big.foldLeft(zero, (acc, x) -> acc + long(x))} ${big.reverse.head} ${big.toString().byteLength() > n}")
    println(s"${big < big2} ${big.take(3) < big} ${List(1, 3) > List(1, 2, 9)} ${List(1) < List(1, 0)} ${List[int]() < List(0)}")

    val dogs: List[Dog] = [Dog("rex")]
    val animals: List[Animal] = Cat("tom") :: dogs
    println(animals.map(a -> a.name))
    val built = 1 :: 2 :: []
    println(s"$built ${pairs([1, 2, 3, 4, 5])} ${pairs(["a", "b"])} ${pairs([1])}")

    val arr = Array.tabulate(4, i -> i * 10)
    val buf: Buffer[string] = ["x", "y"]
    val dq: Deque[int] = [7]
    println(s"${firstTwo(arr)} ${firstTwo(buf)} ${firstTwo(dq)} ${firstTwo(3..9)} ${firstTwo(List(1))}")
    val restKind: string = arr match
        [first, rest*] ->
            val v: Vector[int] = rest
            s"$first then $v"
        [] -> "empty"
    println(restKind)
    println(describe([]))
    println(describe([Circle(11)]))
    println(describe(List(Circle(1), Square(2))))
    println(describe([Square(2), Square(3)]))
    println(describe(Array.fill(3, Square(1))))
    println(countAll(big.take(1000)))
    val whole = (1..3) match
        [rest*] -> rest
    println(whole)
