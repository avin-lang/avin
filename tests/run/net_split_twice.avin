// expect: trap
// A connection is split once: a second split of it stops the program, since its halves already
// hold it.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

main()
  val l = ok(TcpListener.bind("127.0.0.1", 0))
  val c = ok(TcpStream.connect("127.0.0.1", l.port()))
  val s = ok(l.accept())
  val (r, w) = c.split()
  println("split", s.remoteAddress)
  _ = c.split()
  println("not reached")
