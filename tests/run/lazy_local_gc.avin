// expect: exit 0
// Local `lazy val`s whose values live on the heap, made in a loop while the collector runs at every
// allocation (the corpus runs under GC stress): each pass's cell, its initializer's closure and the
// value it computes survive the collections between the declaration, the first read and the later
// ones, as do the cells closures keep after their pass is over.
build(n: int) -> Vector[string]
  var out: Vector[string] = []
  for i in 0 ..< n
    out = out :+ s"item $i"
  out

main()
  var kept: Vector[() -> Vector[string]] = []
  var total = 0
  for round in 0 ..< 60
    val label = s"round $round"
    lazy val items: Vector[string] = build(round % 7 + 1) :+ label
    var junk: Vector[int] = []
    for j in 0 ..< 20
      junk = junk :+ j
    if round % 3 == 0 then total += items.length
    kept = kept :+ (() -> items)
  for k in kept
    total += k().length
  println(total)
  println(kept(59)().last)
  println(kept(0)().last)
