// expect: trap
// A trap inside a `lazy val`'s initializer an actor runs stops the program instead of failing the
// actor, whatever its supervision: another thread reading the value would wait for it for ever. A
// trap after the value is stored fails only the actor.
import avin.actors.{Stop, spawn}
import avin.threads.Channel

class Settings(val divisor: int)
    lazy val ratio: int = 100 / divisor

actor Reader(settings: Settings, done: Channel[string]) receives int
    receive
        n -> done.send(s"${settings.ratio / n}")

main()
    val done = Channel[string]()
    val a = spawn(Reader(Settings(4), done), onFailure = Stop)
    a.tell(5)
    println(done.receive().get())
    // The value is stored already: a trap after it fails the actor alone.
    a.tell(0)
    println(a.ended().await())
    val b = spawn(Reader(Settings(0), done), onFailure = Stop)
    b.tell(1)
    println(done.receive())
    println("not reached")
