// expect: exit 0
// Spec probes for declarations, trait methods with a default before a repeated parameter, an overload
// beside it, and type parameters of their own, through the trait type on a class and on a data impl.
trait Sink
  put(label: string = "item", values: int*) -> string
  put(flag: bool) -> string
  each[B](f: (int) -> B, xs: int*) -> Vector[B]

class Printer: Sink
  override put(label: string, values: int*) -> string = s"$label=${values.mkString(",")}"
  override put(flag: bool) -> string = s"flag $flag"
  override each[B](f: (int) -> B, xs: int*) -> Vector[B] = xs.map(f)

data Tally(n: int)

impl Sink for Tally
  put(label: string, values: int*) -> string = s"$label#${values.length + n}"
  put(flag: bool) -> string = "tally"
  each[B](f: (int) -> B, xs: int*) -> Vector[B] = xs.map(f).take(n)

main()
  val sinks: Vector[Sink] = [Printer(), Tally(1)]
  for s in sinks
    println(
      s"${s.put()} ${s.put("x", 1, 2)} ${s.put(label = "y")} ${s.put(true)} ${s.each(x -> x * 2, 1, 2, 3)} ${s.each(x -> s"<$x>", [4, 5]*)}"
    )
