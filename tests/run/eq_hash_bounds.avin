// expect: exit 0
// Every type is `Eq` and `Hash`, so a bound of `Eq + Hash` is met by every type argument: an
// unbounded type parameter, one with other bounds only, `Any`, function types and classes without an
// `Eq` impl, which compare by identity.

data Pt(x: int, y: int)

class Token(val id: int)

trait Named
    name() -> string

class Tag(val text: string): Named
    override name() -> string = text

buildSet[T](a: T, b: T) -> Set[T] = Set[T]().incl(a).incl(b)

buildMap[T](a: T, b: T) -> Map[T, int] = Map[T, int]().updated(a, 1).updated(b, 2)

pairMap[T](a: T, b: T) -> Map[T, int] = [(a, 1), (b, 2)].toMap

bounded[T: Named](a: T, b: T) -> Set[T] = Set[T]().incl(a).incl(b)

viaHelper[T](a: T) -> int = buildSet(a, a).size

main()
    println(buildSet(1, 2).size)
    println(buildSet(1, 1).size)
    println(buildSet("a", "b").size)
    println(buildSet(Pt(1, 2), Pt(1, 2)).size)
    val t = Token(1)
    println(buildSet(t, Token(1)).size)
    println(buildSet(t, t).size)
    val f = (x: int) -> x + 1
    val g = (x: int) -> x + 1
    println(buildSet(f, g).size)
    println(buildSet(f, f).size)
    println(buildMap(1, 2).size)
    println(buildMap(Pt(1, 2), Pt(1, 2)).size)
    println(buildMap(t, Token(1)).size)
    println(buildMap(f, g).size)
    println(pairMap("x", "y").size)
    println(pairMap(t, t).size)
    println(pairMap(f, g).size)
    println(bounded(Tag("a"), Tag("a")).size)
    val x: Any = 1
    val y: Any = "s"
    println(buildSet(x, y).size)
    println(viaHelper(Pt(3, 4)))
