// expect: exit 0
// Every type is `Eq` and `Hash`, so a bound of `Eq + Hash` is met by every type argument: an
// unbounded type parameter, one with other bounds only, `Any`, function types and classes without an
// `Eq` impl, which compare by identity.

data Pt(x: int, y: int)

class Token(val id: int)

trait Named
    name() -> string

class Tag(val text: string): Named
    override name() -> string = text

buildSet[T](a: T, b: T) -> Set[T] = Set[T]().added(a).added(b)

buildMap[T](a: T, b: T) -> Map[T, int] = Map[T, int]().updated(a, 1).updated(b, 2)

pairMap[T](a: T, b: T) -> Map[T, int] = [(a, 1), (b, 2)].toMap()

bounded[T: Named](a: T, b: T) -> Set[T] = Set[T]().added(a).added(b)

viaHelper[T](a: T) -> int = buildSet(a, a).size()

main()
    print(buildSet(1, 2).size())
    print(buildSet(1, 1).size())
    print(buildSet("a", "b").size())
    print(buildSet(Pt(1, 2), Pt(1, 2)).size())
    val t = Token(1)
    print(buildSet(t, Token(1)).size())
    print(buildSet(t, t).size())
    val f = (x: int) -> x + 1
    val g = (x: int) -> x + 1
    print(buildSet(f, g).size())
    print(buildSet(f, f).size())
    print(buildMap(1, 2).size())
    print(buildMap(Pt(1, 2), Pt(1, 2)).size())
    print(buildMap(t, Token(1)).size())
    print(buildMap(f, g).size())
    print(pairMap("x", "y").size())
    print(pairMap(t, t).size())
    print(pairMap(f, g).size())
    print(bounded(Tag("a"), Tag("a")).size())
    val x: Any = 1
    val y: Any = "s"
    print(buildSet(x, y).size())
    print(viaHelper(Pt(3, 4)))
