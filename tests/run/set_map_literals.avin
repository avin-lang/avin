// expect: exit 0
// Set literals `{a, b}` and map literals `{k: v}`: with no expected collection a `Set` and a `Map`,
// and otherwise the collection the expected type asks for, built through its companion's `builder`:
// the mutable set and map, the sorted ones and a program's own.

import avin.collections.mutable.{Map as MutableMap, Set as MutableSet}

// A program's own collection of pairs, written as a map literal through its companion's builder.
data Pairs(keys: List[string], total: int)

object Pairs
    builder() -> PairsBuilder = PairsBuilder()

class PairsBuilder: Builder[(string, int), Pairs]
    private var keys: List[string] = Nil
    private var total = 0

    override add(element: (string, int))
        keys = element.0 :: keys
        total += element.1

    override result() -> Pairs = Pairs(keys, total)

// A program's own collection of elements, written as a set literal.
data Bag(items: List[int])

object Bag
    builder() -> BagBuilder = BagBuilder()

class BagBuilder: Builder[int, Bag]
    private var items: List[int] = Nil

    override add(element: int)
        items = element :: items

    override result() -> Bag = Bag(items)

open class Animal(val name: string)
class Dog(name: string): Animal(name)
class Cat(name: string): Animal(name)

sizeOf(s: Set[int]) -> int = s.size()

lookup(m: Map[string, int], k: string) -> int = m.getOrElse(k, -1)

total(m: MutableMap[string, long]) -> long
    var sum = long(0)
    for (_, v) in m do sum += v
    sum

main()
    // Defaults: an immutable set and map.
    val s = {3, 1, 2, 3}
    print(s.size())
    print(s.contains(2))
    print(s == Set(1, 2, 3))
    val m = {"a": 1, "b": 2}
    print(m("b"))
    print(m == Map(("a", 1), ("b", 2)))
    // A bare name before `:` is a string key.
    val short = {a: 1, b: 2}
    print(short == m)
    print({x: true})
    // A key that is not a bare name is an expression.
    val k = "z"
    print({(k): 26}("z"))
    val n = 7
    print({n: 1}.contains("n"))
    print({n + 1: "eight"}(8))
    print({1: "one", 2: "two"}(2))

    // Empty literals settled by the expected type.
    val noSet: Set[string] = {}
    print(noSet.isEmpty())
    val noMap: Map[string, int] = {}
    print(noMap.isEmpty())
    var later = {}
    later = Set("x")
    print(later.size())

    // The expected type gives elements, keys and values their types.
    val longs: Set[long] = {1, 2}
    print(longs.contains(long(2)))
    val bytes: Map[byte, long] = {0x01: 5, 0x02: 6}
    print(bytes(byte(2)))

    // Elements, keys and values agree on a type as `if` branches do.
    val pets = {Dog("rex"), Cat("tom")}
    val first: Set[Animal] = pets
    print(first.size())
    val owners = {"ann": Dog("rex"), "bob": Cat("tom")}
    print(owners("bob").name)

    // The mutable set and map.
    val seen: MutableSet[int] = {}
    seen.add(4)
    seen.add(4)
    print(seen.size())
    val counts: MutableMap[string, int] = {a: 1}
    counts("a") += 2
    counts("b") = 5
    print(counts("a"))
    print(counts.size())
    val ms: MutableSet[string] = {"x", "y", "x"}
    print(ms.size())
    print(total({a: 1, b: 2}))

    // The sorted ones iterate in order.
    val ts: TreeSet[int] = {5, 1, 3}
    print(ts)
    val tm: TreeMap[string, int] = {c: 3, a: 1, b: 2}
    print(tm)

    // A program's own collections.
    val pairs: Pairs = {a: 1, b: 2, c: 3}
    print(pairs.total)
    print(pairs.keys)
    val bag: Bag = {1, 2}
    print(bag.items)

    // Nested literals.
    val nested = {"evens": {2, 4}, "odds": {1, 3, 5}}
    print(nested("odds").size())
    val groups: Map[string, Vector[int]] = {small: [1, 2], large: [100]}
    print(groups("small"))
    val sets = [{1}, {2, 3}]
    print(sets(1).size())
    val inner: Map[string, MutableSet[int]] = {a: {1, 2}}
    inner("a").add(3)
    print(inner("a").size())

    // As arguments.
    print(sizeOf({1, 2, 2}))
    print(lookup({one: 1}, "one"))
    print(lookup({}, "one"))

    // Compared with `==`, a literal takes the other operand's type.
    print(ts == {1, 3, 5})
    print(m != {a: 1})

    // Written across lines, with a trailing comma.
    val spread: Map[string, (int) -> int] = {
        a: x -> x + 1,
        b: x -> x * 2,
    }
    print(spread("a")(1) + spread("b")(10))
    val fs = {"inc": (x: int) -> x + 1, "dbl": (x: int) -> x * 2}
    print(fs("dbl")(21))
