extensions: [(PIPELINING, ), (SIZE, 100000), (8BITMIME, ), (HELP, )]
SIZE: Some(100000), 8BITMIME: true, STARTTLS: false
encrypted: false
quit again: true
S: 220-fake.example ESMTP
S: 220 ready
C: EHLO client.example
S: 250-fake.example greets localhost
S: 250-PIPELINING
S: 250-SIZE 100000
S: 250-8BITMIME
S: 250 HELP
C: MAIL FROM:<ada@example.com> SIZE=304
S: 250 2.1.0 sender ok
C: RCPT TO:<bob@example.com>
S: 250 2.1.5 recipient ok
C: RCPT TO:<carol@example.com>
S: 250 2.1.5 recipient ok
C: RCPT TO:<dave@example.com>
S: 250 2.1.5 recipient ok
C: DATA
S: 354 go ahead
D: Date: Thu, 01 Jan 1970 00:00:00 +0000⏎
D: From: Ada <ada@example.com>⏎
D: To: bob@example.com⏎
D: Cc: carol@example.com⏎
D: Subject: Dots⏎
D: Message-ID: <m@example.com>⏎
D: MIME-Version: 1.0⏎
D: Content-Type: text/plain; charset=utf-8⏎
D: Content-Transfer-Encoding: 7bit⏎
D: ⏎
D: ..leading dot⏎
D: ...two⏎
D: lone LF⏎
D: lone CR⏎
D: ..⏎
D: end⏎
D: .⏎
S: 250 2.0.0 queued as 42
C: QUIT
S: 221 bye
port by default: 587 465 25
S: 220 fake ESMTP
C: EHLO localhost
S: 250-fake
S: 250-STARTTLS
S: 250 AUTH PLAIN
C: STARTTLS
S: 220 2.0.0 ready to start TLS
-- TLS
C: EHLO localhost
S: 250-fake
S: 250-AUTH LOGIN PLAIN
