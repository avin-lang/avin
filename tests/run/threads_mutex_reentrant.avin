// expect: trap
// A mutex is not reentrant: a thread that takes one it already holds, from inside its `with`, would
// wait for ever, so it traps instead, at the program's call.
import avin.threads.Mutex

main() -> int
  val m = Mutex(1)
  println("before")
  m.with(v -> m.get() + v)
  println("after")
  0
