// expect: exit 0
// Lazy lists under the stressed collector, which runs at every allocation: cells of strings and of
// objects evaluated across collections, a list whose head is held and read again (its cells kept,
// the same objects each time), lists walked with nothing holding their heads, tails that capture
// heap values, an expression dropped once its cell is evaluated, and self-referential lists.

class Box(val label: string)

lazy val tribonacci: LazyList[long] = LazyList.cons(
  0,
  LazyList.cons(
    0,
    LazyList.cons(1, tribonacci.zip(tribonacci.tail).zip(tribonacci.tail.tail).map(p -> p.0.0 + p.0.1 + p.1))
  )
)

labelled(prefix: string, n: int) -> LazyList[Box] = LazyList.cons(Box(s"$prefix$n"), labelled(prefix, n + 1))

main() -> int
  // Held: the cells survive, and reading them again gives the same objects without computing them.
  var made = 0
  val boxes = LazyList.from(0).map(n ->
    made += 1
    Box(s"box-$n-" + "x".repeat(n % 7)))
  val first = boxes.take(500).toVector
  println(made)
  val second = boxes.take(500).toVector
  println(made)
  var same = true
  for i in 0 ..< 500
    if !(first(i) === second(i)) then same = false
  println(same)
  println(boxes(499).label)
  println(boxes.take(3).map(b -> b.label).toVector)

  // Not held: each walk makes its cells afresh and leaves them to the collector.
  var total = 0
  for round in 0 ..< 5
    for b in labelled(s"r$round-", 0).take(400)
      total += b.label.byteLength
  println(total)
  println(LazyList.from(0).map(n -> s"s$n").filter(s -> s.endsWith("7")).take(50).length)

  // Tails capturing heap values, evaluated after the values' last other use.
  var lists: Vector[LazyList[string]] = []
  for i in 0 ..< 50
    val words = Vector.tabulate(3, k -> s"w$i.$k")
    lists = lists :+ LazyList.cons("head", LazyList.cons(words.mkString("+"), LazyList.empty[string]()))
  var joined = ""
  for l in lists
    joined = l(1)
  println(joined)
  println(lists(0).toVector)

  // The expression of a cell is dropped once the cell is evaluated; the elements stay.
  val big = Vector.tabulate(1000, i -> s"item$i")
  val fromBig = LazyList.cons(big(0), big.toLazyList().drop(1))
  println(fromBig.length)
  println(fromBig(999))

  println(tribonacci.drop(60).head)
  println(LazyList.iterate("a", s -> s + "b").drop(200).head.byteLength)
  println(LazyList.unfold(0, n -> if n < 300 then Some((s"u$n", n + 1)) else None).last)
  val shown = boxes.map(b -> b.label.byteLength).take(4)
  shown(1)
  println(shown)
  0
