// expect: exit 0
// The regex chapter's pattern language, construct by construct: escapes and quotation, classes with
// union and intersection, the predefined and POSIX classes, repetition in its three modes, groups and
// back references, anchors and boundaries, line breaks, and every flag.
import avin.regex
import avin.regex.Regex

all(pattern: string, text: string) -> string = Regex.compile(pattern) match
  Ok(r) -> r.findAllIn(text).toList.map(s -> s"<$s>").mkString("")
  Err(e) -> e.description

main()
  println(all(raw"a\.b\\c\-", raw"a.b\c- axb\c"))
  println(all(raw"\t\n\r\f\a\e", "\t\n\r\u{c}\u{7}\u{1b}"))
  println(all(raw"\0101\012\0377", "A\nÿ"))
  println(all(raw"\x41\x{1F600}é", "A😀é"))
  println(all(raw"\cA\cZ", "\u{1}\u{1a}"))
  println(all(raw"\Q.*+\E.", ".*+x .x"))
  println(all(raw"\Q(a", "x(a"))
  println(all(raw".", "a\nb"))
  println(all(raw"(?s).", "a\nb"))
  println(all(raw"(?d).", "a\rb\n"))
  println(all(raw"[]a]+", "]a]b"))
  println(all(raw"[-a]+|[b-]+", "-a-b-"))
  println(all(raw"[^a-c]+", "abxyzc"))
  println(all(raw"[a[xy]]+", "axyb"))
  println(all(raw"[a-z&&[^aeiou]]+", "hello"))
  println(all(raw"\d+\D", "a12b 3"))
  println(all(raw"\s+", "a \t\u{b}\u{c}b"))
  println(all(raw"\w+", "ab_9-é"))
  println(all(raw"\S+|\W", "ab cd"))
  println(all(raw"\h+", "a \tb\nc"))
  println(all(raw"\v", "a\nb\u{b}c d"))
  println(all(raw"\H\V", "ab"))
  println(all(raw"\p{Lu}+", "abCDéÉ"))
  println(all(raw"\pL+", "ab1é"))
  println(all(raw"\p{gc=Nd}\p{IsLu}", "1A 2b"))
  println(all(raw"\p{L}\P{L}", "a1bc"))
  println(all(raw"\p{Alpha}+", "abé"))
  println(all(raw"(?U)\p{Alpha}+", "abé"))
  println(all(raw"\p{Punct}+", "a!?,b"))
  println(all(raw"\p{XDigit}+", "fg09"))
  println(all(raw"\p{L1}+", "aé😀"))
  println(all(raw"a{2}", "aaaaa"))
  println(all(raw"a{2,}", "a aaaaa"))
  println(all(raw"a{1,2}", "aaa"))
  println(all(raw"a+?", "aaa"))
  println(all(raw"<.+?>", "<a><b>"))
  println(all(raw"a++a", "aaa"))
  println(all(raw"a?+a", "aa"))
  println(all(raw"(?:ab)+", "ababx"))
  println(all(raw"(\w)\1", "aabcc"))
  println(all(raw"(?<c>\w)\k<c>", "xxyzz"))
  println(all(raw"(a)\11", "aa1 a11"))
  println(all(raw"(?i)(a)\1", "aA"))
  println(all(raw"\Aab", "abab"))
  println(all(raw"ab\z", "abab\n"))
  println(all(raw"ab\Z", "abab\n"))
  println(all(raw"ab$$", "abab\n"))
  println(all(raw"\Ga", "aaba"))
  println(all(raw"\Bb\B", "abc b"))
  println(all(raw"\R", "a\r\nb\nc\u{85}d\u{2028}"))
  println(all(raw"x|xy|y", "xy"))
  println(all(raw"(?i)abc", "ABC aBc"))
  println(all(raw"(?i)é", "É"))
  println(all(raw"(?iu)é", "É"))
  println(all(raw"(?i:a)b", "AB Ab"))
  println(all(raw"(?i)a(?-i)b", "AB Ab"))
  println(all(raw"(a(?i)b)c|bc", "aBc aBC"))
  println(all(raw"(?m)^\w", "ab\ncd\r\nef"))
  println(all(raw"(?m)$$", "a\nb"))
  println(all(raw"(?x) a b  # comment", "ab"))
  println(all(raw"(?x)[a b]+", "a b"))
  println(all(raw"(?x)\Q a b\E", " a b"))
  println(all(raw"(?dm)^b", "a\rb\nb"))
  println(all(raw"(?U)\d+", "12٣٤"))
  println(all(raw"(?U)(?-U)\d+", "12٣٤"))
  println(all(raw"(?<=ab)c", "abc xc"))
  println(all(raw"(?<!a)b", "ab cb"))
  println(all(raw"a(?=b)", "ab ac"))
  println(all(raw"a(?!b)", "ab ac"))
  println(all(raw"(?<=a{1,3})b", "aab"))
