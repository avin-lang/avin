// expect: exit 0
// Every collection of numbers has `average` and `averageOption`, a `real` mean: an empty one answers
// `None`, the elements are totalled as `real`s so integers whose sum overflows their type still
// average, and a type parameter bounded by `Numeric` reaches them, with `sum`, `product`, `min` and
// `max`, through its bound.

stats[T: Numeric](xs: Iterable[T]) -> string =
    s"sum ${xs.sum} product ${xs.product} min ${xs.minOption} max ${xs.maxOption} average ${xs.averageOption}"

meanOf[T: Numeric](xs: Seq[T]) -> real = xs.average

main()
    val vector: Vector[int] = [1, 2, 3, 4]
    println(vector.average)
    println(vector.averageOption)
    val list: List[long] = [10, 20]
    println(list.average)
    val array: Array[real] = [0.5, 1.5, 4.0]
    println(array.average)
    val set: Set[i16] = {3, 3, 9}
    println(set.average)
    val m: Map[string, int] = {"a": 2, "b": 5}
    println(m.values.average)
    println((1 .. 100).average)
    println((1 ..< 1).averageOption)
    println((long(1) .. long(4)).average)
    println(Some(7).toVector.average)
    // One element is its own mean.
    println([i8(-128)].average)
    println([2.5].average)
    // Sums that overflow the element type still average.
    println([i8(127), i8(127)].average)
    println([int.MaxValue, int.MaxValue, int.MaxValue].average)
    println([long.MinValue, long.MinValue].average)
    // Empty collections have no mean.
    println(Vector[int]().averageOption)
    println(List[real]().averageOption)
    println(Set[long]().averageOption)
    // The non-finite reals average as `real` arithmetic does.
    println([1.0, real.PositiveInfinity].average)
    println([real.PositiveInfinity, real.NegativeInfinity].average.isNaN)
    println([real.NaN, 1.0].average.isNaN)
    // An iterator averages once; it is consumed.
    val it = [4, 6].iterator()
    println(it.average)
    println(it.averageOption)
    // Through a bound.
    println(stats([2, 3, 4]))
    println(stats([1.5, -2.0]))
    println(stats(Vector[i8]()))
    println(stats(List[real]()))
    println(meanOf([i128(1), i128(2)]))
    println(meanOf([0.25, 0.75]))
    // In a closure and nested collections.
    val rows: Vector[Vector[int]] = [[1, 2], [3, 4, 5], [6]]
    println(rows.map(r -> r.average))
    println(rows.filter(r -> r.length > 5).map(r -> r.average).averageOption)
