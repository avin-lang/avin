// expect: trap
// A started command the thread it was handed to has waited for holds no program of its own any more,
// and is still the thread's while the thread runs: the code that handed it over traps at
// `waitFor`.
import avin.io.IoError
import avin.process.{Child, Command}
import avin.threads.{Channel, spawn}

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message)

main()
    val child = ok(Command("/bin/sh", "-c", "exit 3").start())
    val waited = Channel[int]()
    val go = Channel[int]()
    val t = spawn(() ->
        val status = child.waitFor()
        waited.send(1)
        go.receive()
        status)
    waited.receive()
    println("waited for by the thread")
    _ = child.waitFor()
    println("not reached")
    go.send(1)
    println(t.join())
