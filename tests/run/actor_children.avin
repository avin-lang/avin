// expect: exit 0
// Actors spawning actors: a tree whose every node spawns its two children in its body, from its own
// parameters, and answers a count by asking them and adding up; a factory that spawns a new actor
// from an arm for every message, with an argument computed from its own `var`, a string, which is
// sendable whatever it was computed from, and hands back its reference in the reply; and an actor
// of one declaration spawning another of the same, a chain, each link holding the next's reference.
import avin.actors.{ActorRef, spawn}
import avin.threads.Promise

data TreeMsg(reply: Promise[int])

actor Node(depth: int) receives TreeMsg
  val subtrees: Vector[ActorRef[TreeMsg]] = if depth == 0 then Vector() else Vector(
    spawn(Node(depth - 1)),
    spawn(Node(depth - 1))
  )

  receive
    TreeMsg(reply) ->
      var total = 1
      for child in subtrees
        val p = Promise[int]()
        child.tell(TreeMsg(p))
        total += p.future.await()
      reply.complete(total)

data Order(label: string, reply: Promise[ActorRef[Promise[string]]])

actor Worker(label: string) receives Promise[string]
  receive
    p -> p.complete(s"worker $label")

actor Factory receives Order
  var made = 0
  receive
    Order(label, reply) ->
      made += 1
      reply.complete(spawn(Worker(s"$label$made")))

data Pass(n: int, reply: Promise[string])

actor Link(left: int) receives Pass
  val next: Option[ActorRef[Pass]] = if left > 0 then Some(spawn(Link(left - 1))) else None
  receive
    Pass(n, reply) -> next match
      Some(r) -> r.tell(Pass(n + 1, reply))
      None -> reply.complete(s"end of chain after $n")

main()
  val root = spawn(Node(6))
  val count = Promise[int]()
  root.tell(TreeMsg(count))
  println(count.future.await())
  val factory = spawn(Factory())
  for name in ["a", "b", "c"]
    val made = Promise[ActorRef[Promise[string]]]()
    factory.tell(Order(name, made))
    val worker = made.future.await()
    val answer = Promise[string]()
    worker.tell(answer)
    println(answer.future.await())
  val chain = spawn(Link(50))
  val end = Promise[string]()
  chain.tell(Pass(0, end))
  println(end.future.await())
