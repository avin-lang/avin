// expect: exit 0
// A buffer grows as elements are added, at the end or anywhere, and gives them back by index, by
// removal and by traversal. It compares by its elements, and its array and vector are copies.

class Dog(val name: string)

main()
    val b = Buffer[int]()
    print(s"${b.length()} ${b.isEmpty()} ${b.get(0).isNone()}")
    for i in 0 ..< 10 do b.add(i * i)
    b(3) = 100
    b(4) += 1
    b(5)++
    print(s"${b.length()} ${b(0)} ${b(3)} ${b(4)} ${b(5)} ${b.nonEmpty()} ${b.get(9).getOrElse(-1)}")
    b.insert(0, -1)
    b.insert(5, 55)
    b.insert(b.length(), 999)
    print(s"${b.length()} ${b(0)} ${b(5)} ${b(12)}")
    print(s"${b.remove(0)} ${b.remove(4)} ${b.remove(b.length() - 1)} ${b.length()} ${b(0)}")
    var total = 0
    for x in b do total += x
    print(s"$total")
    b.addAll([1, 2, 3])
    print(s"${b.length()} ${b(12)}")

    val a = b.toArray()
    a(0) = 42
    val v = b.toVector()
    b(0) = 7
    print(s"${a(0)} ${v(0)} ${b(0)} ${a.length()} ${v.length()}")

    b.clear()
    print(s"${b.length()} ${b.isEmpty()}")
    b.add(5)
    print(s"${b(0)} ${b.length()}")

    val dogs = Buffer.empty[Dog]()
    dogs.add(Dog("rex"))
    dogs.insert(0, Dog("fido"))
    print(s"${dogs(0).name} ${dogs(1).name} ${dogs.remove(0).name} ${dogs(0).name}")

    val x = Buffer[string]()
    x.add("a")
    x.add("b")
    val y = Buffer[string]()
    y.add("a")
    y.add("b")
    print(s"${x == y} ${x.hash() == y.hash()} ${x === y}")
    y.add("c")
    print(s"${x == y} ${x != y}")
    print(y)
    print(debug(y))
    y.remove(1)
    print(s"$y ${Buffer[int]()}")
