// expect: exit 0
// A buffer grows as elements are added, at the end or anywhere, and gives them back by index, by
// removal and by traversal. It compares by its elements, and its array and vector are copies.

class Dog(val name: string)

main()
    val b = Buffer[int]()
    println(s"${b.length} ${b.isEmpty} ${b.lift(0).isEmpty()}")
    for i in 0 ..< 10 do b.addOne(i * i)
    b(3) = 100
    b(4) += 1
    b(5)++
    println(s"${b.length} ${b(0)} ${b(3)} ${b(4)} ${b(5)} ${b.nonEmpty} ${b.lift(9).getOrElse(-1)}")
    b.insert(0, -1)
    b.insert(5, 55)
    b.insert(b.length, 999)
    println(s"${b.length} ${b(0)} ${b(5)} ${b(12)}")
    println(s"${b.remove(0)} ${b.remove(4)} ${b.remove(b.length - 1)} ${b.length} ${b(0)}")
    var total = 0
    for x in b do total += x
    println(s"$total")
    b.addAll([1, 2, 3])
    println(s"${b.length} ${b(12)}")

    val a = b.toArray()
    a(0) = 42
    val v = b.toVector
    b(0) = 7
    println(s"${a(0)} ${v(0)} ${b(0)} ${a.length} ${v.length}")

    b.clear()
    println(s"${b.length} ${b.isEmpty}")
    b.addOne(5)
    println(s"${b(0)} ${b.length}")

    val dogs = Buffer.empty[Dog]()
    dogs.addOne(Dog("rex"))
    dogs.insert(0, Dog("fido"))
    println(s"${dogs(0).name} ${dogs(1).name} ${dogs.remove(0).name} ${dogs(0).name}")

    val x = Buffer[string]()
    x.addOne("a")
    x.addOne("b")
    val y = Buffer[string]()
    y.addOne("a")
    y.addOne("b")
    println(s"${x == y} ${x.hash() == y.hash()} ${x === y}")
    y.addOne("c")
    println(s"${x == y} ${x != y}")
    println(y)
    println(debug(y))
    y.remove(1)
    println(s"$y ${Buffer[int]()}")
