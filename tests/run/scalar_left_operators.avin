// expect: exit 0
// An impl adding to a built-in type may add a binary operator method whose operand is of a type the
// program declares, so a built-in value stands on the operator's left: `k * v`. The overload is
// chosen statically by the operand's type, an integer literal on the left takes the type that has the
// method, and an operator between two built-in values stays the machine's.
data Vec(x: real, y: real)

impl Vec
  *(k: real) -> Vec = Vec(x * k, y * k)
  +(o: Vec) -> Vec = Vec(x + o.x, y + o.y)

  show() -> string = s"($x, $y)"

data Money(cents: long)

class Counter(var n: int)

data Box[T](item: T)

opaque type Meters = real

impl Meters
  value() -> real = repr

trait Shape
  area() -> real

class Square(val side: real): Shape
  override area() -> real = side * side

class Circle(val r: real): Shape
  override area() -> real = 3.0 * r * r

impl real
  *(v: Vec) -> Vec = v * self
  /(v: Vec) -> Vec = Vec(self / v.x, self / v.y)
  -(v: Vec) -> Vec = Vec(self - v.x, self - v.y)
  %(v: Vec) -> real = self
  *(s: Shape) -> real = self * s.area()
  +(m: Meters) -> Meters = Meters(self + m.value())
  <(v: Vec) -> bool = self < v.x && self < v.y
  >=(v: Vec) -> bool = self >= v.x && self >= v.y

impl int
  *(m: Money) -> Money = Money(long(self) * m.cents)
  +(c: Counter) -> int = self + c.n
  *[T](b: Box[T]) -> ArraySeq[T] = ArraySeq.fill(self, b.item)
  |(v: Vec) -> int = self + 100
  <<(m: Money) -> long = long(self) + m.cents
  <=(m: Money) -> bool = long(self) <= m.cents

impl long
  *(m: Money) -> Money = Money(self * m.cents * 10)
  -(m: Money) -> Money = Money(self - m.cents)

impl byte
  &(c: Counter) -> int = int(self) + c.n
  +(c: Counter) -> int = int(self) * c.n

impl string
  *(c: Counter) -> string = self.repeat(c.n)
  +(v: Vec) -> string = self + v.show()

impl char
  +(c: Counter) -> string = s"$self${c.n}"

impl bool
  &(c: Counter) -> bool = self && c.n > 0

twice(k: real, v: Vec) -> Vec = k * v + v * k

// In a generic function and a closure capturing the scalar.
scaledAll[T](k: real, xs: Vector[Vec], tag: T) -> Vector[(Vec, T)] = xs.map(v -> (k * v, tag))

main()
  val v = Vec(1.0, 2.0)
  val k = 3.0
  // A built-in value on the left, of each type the impls add to.
  println((k * v).show())
  println((2.0 * v).show())
  println((-2.0 * v).show())
  println((2 * v).show())
  println((k / v).show())
  println((k - v).show())
  println(k % v)
  println(twice(0.5, v).show())
  println(2.0 * Square(3.0))
  println(1.0 * Circle(1.0))
  println((1.5 + Meters(2.0)).value())
  // The method's precedence is the operator's: `1.0 + 2.0 * v` is `1.0 + (2.0 * v)`, a real plus a
  // Vec, which `real` has no `+` for, so it is parenthesized.
  println((k * v + 1.0 * v).show())
  val m = Money(7)
  val n = 3
  println((n * m).cents)
  println((3 * m).cents)
  println((long(3) * m).cents)
  val l: long = 4
  println((l * m).cents)
  println((l - m).cents)
  println(n + Counter(4))
  println(5 + Counter(6))
  println(2 * Box("ab"))
  println(n | v)
  println(1 << m)
  println(byte(3) & Counter(4))
  println(byte(3) + Counter(4))
  println("ab" * Counter(3))
  println("v=" + v)
  println('c' + Counter(9))
  println(true & Counter(1))
  // Orderings, alone and in a chain, with a literal taking the type that has the method.
  println(0.5 < v)
  println(3.0 < v)
  println(0.5 >= v)
  println(2.0 >= v)
  println(1 <= m)
  println(9 <= m)
  println(0.0 < v && 1 <= m)
  // Between built-in values the operators are the machine's.
  println(k * 2.0)
  println(3 * 4)
  println(3 << 2)
  println(6 & 3)
  println(l * l)
  println("x" + "y")
  println(1.0 < 2.0)
  // A compound assignment on a Vec still calls its own method.
  var w = v
  w = 2.0 * w
  w = w * 2.0
  println(w.show())
  for (s, t) in scaledAll(10.0, [v, Vec(0.5, 0.25)], 'x')
    println(s"${s.show()} $t")
