// expect: exit 0
// Placeholder lambdas: each `_` in a call's argument is a parameter of its own, in the order
// written, and the argument is the lambda's body. Parameter types come from the expected function
// type, as for any lambda.

class Person(val name: string, val age: int)

class Order(val items: Vector[int])

apply3(f: (int, int, int) -> int) -> int = f(1, 2, 3)

apply2(f: (int, int) -> int) -> int = f(10, 3)

applyS(f: (string) -> int) -> int = f("héllo")

scale(x: int, by: int) -> int = x * by

sum3(a: int, b: int, c: int) -> int = a * 100 + b * 10 + c

data Point(x: int, y: int)

class Num(val value: int)
  max(other: Num) -> Num = if other.value > value then other else self

pairNum(f: (Num, Num) -> Num) -> int = f(Num(3), Num(9)).value

prepend(f: (int, Vector[int]) -> Vector[int]) -> Vector[int] = f(1, [2, 3])

main() -> int
  val xs = [3, -1, 4, 1, -5, 9]
  // One placeholder: operators, a method, a field, a comparison.
  println(xs.map(_ + 1))
  println(xs.filter(_ > 0))
  println(xs.map(_.toString()))
  val people = [Person("Ann", 41), Person("Bo", 7), Person("Cy", 19)]
  println(people.map(_.name))
  println(people.sortBy(_.age).map(_.name))
  println(people.filter(_.age >= 18).map(_.name.byteLength))
  // Two and three placeholders, bound in the order written.
  println(xs.reduce(_ + _))
  println(apply2(_ - _))
  println(apply3(_ * 100 + _ * 10 + _))
  println(apply3(sum3(_, _, _) + 1))
  // A `_` alone as an argument belongs to the argument around its call.
  println(xs.map(scale(_, 2)))
  println(xs.map(scale(2, _) - 1))
  println(apply2(scale(_, _) + 1))
  // A constructor's name is not a function's, so `Some(_)` is the lambda `x -> Some(x)`.
  println(xs.map(Some(_)).map(_.isDefined))
  println(apply2(scale(_, 2) + _))
  // Every precedence: unary, multiplicative, additive, shifts, bitwise, comparison, logical.
  println(xs.map(-_))
  println(xs.map(_ * 2 + 1))
  println(xs.map(1 + _ * 2))
  println(xs.map((_ + 1) * 2))
  println(xs.map(_ % 3))
  println(xs.map(_ << 1))
  println(xs.map(_ & 1))
  println(xs.map(_ ^ 1))
  println(xs.filter(0 < _ < 5))
  println(xs.filter(_ > 0 && true))
  println(xs.map(!(_ > 0)))
  println(xs.map(_ +% 1))
  println(xs.map(_ == 4))
  println([Num(1), Num(7)].map(_ max Num(5)).map(_.value))
  println([Num(1), Num(7)].map(Num(4) max _).map(_.value))
  println(pairNum(_ max _ max Num(6)))
  // A name ending in `:` takes its receiver on the right, and is written after its argument, so
  // the `_` before it is still the first parameter.
  println(prepend(_ +: _))
  println([[1], [2, 3]].map(_ :+ 0))
  println([[1], [2, 3]].map(0 +: _))
  // Nested calls: each `_` binds to its own argument.
  val orders = [Order([1, 2]), Order([]), Order([5])]
  println(orders.map(_.items.map(_ * 2)))
  println(orders.map(_.items.filter(_ > 1).length))
  // Strings and Unicode.
  println(["a", "β", "日本"].map(_ + "!"))
  println(applyS(_.byteLength))
  // Tuples: built from `_`, and a tuple taken apart by two placeholders.
  println(xs.map((_, 0)))
  println(xs.zip(xs).map(_ + _))
  println([(1, 2), (3, 4)].map(_.0))
  // `with`'s base, and a method's result used further.
  println([Point(1, 2), Point(3, 4)].map(_ with {y = 0}))
  println(people.map(_.name.byteLength + 1))
  // Ranges and `is`.
  println([1, 3].map(0 ..< _).map(_.length))
  println([Some(1), None].map(_ is Some(_)))
  // A placeholder lambda closes over locals.
  val offset = 100
  var hits = 0
  println(xs.map(_ + offset))
  xs.foreach(n -> hits += n)
  println(xs.map(_ * hits))
  val labels = people.map(p -> s"${p.name}:${offset}")
  println(labels.map(_ + "!"))
  // Boundary values.
  println([2147483647, -2147483648].map(_ +| 1))
  val empty: Vector[int] = []
  println(empty.map(_ + 1))
  0
