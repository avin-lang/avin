// expect: exit 0
// An object is a value of its own type, so overloads choose by it like any other argument, and a
// module value of a function type is called by its name.

object Origin
    val x = 0
    val y = 0

class Point(val x: int, val y: int)

object Point
    val unit = Point(1, 1)

describe(o: Origin) -> string = "the origin"
describe(p: Point) -> string = s"(${p.x}, ${p.y})"
describe(n: int) -> string = s"number $n"

val pick: int -> string = (n: int) -> describe(n * 2)

main()
    print(describe(Origin))
    print(describe(Point(2, 3)))
    print(describe(Point.unit))
    print(describe(4))
    print(pick(5))
