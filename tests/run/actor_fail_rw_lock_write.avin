// expect: trap
// A trap while an actor writes a `RwLock` stops the program instead of failing the actor: other
// threads wait for the lock, and the value it guards is in doubt. The report still names the actor.
import avin.actors.{Stop, spawn}
import avin.threads.{Channel, RwLock}

actor Writer(shared: RwLock[Buffer[int]], done: Channel[int]) receives int
  receive
    n ->
      done.send(shared.write(b ->
        b.append(n)
        b(n)))

main()
  val shared = RwLock(Buffer[int]())
  val done = Channel[int]()
  val w = spawn(Writer(shared, done), onFailure = Stop)
  w.tell(0)
  println(done.receive())
  w.tell(5)
  println(done.receive())
  println("not reached")
