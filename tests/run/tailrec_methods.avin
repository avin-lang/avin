// expect: exit 0
// Tail calls of generic methods are loops at the instance being run: a method of a generic class, one
// with a type parameter of its own, a private method of an open class, which no subclass replaces,
// and a method an impl adds to a generic data type. Each runs ten million passes.

class Holder[T](val item: T)
    @tailrec
    keep(n: int) -> T = if n == 0 then item else keep(n - 1)

    @tailrec
    with[U](n: int, other: U) -> U = if n == 0 then other else with(n - 1, other)

open class Base
    @tailrec
    private down(n: int) -> int = if n == 0 then 0 else down(n - 1)
    run(n: int) -> int = down(n)

data Wrap[T](value: T)

impl[T] Wrap[T]
    @tailrec
    unwrapAfter(n: int) -> T = if n == 0 then value else unwrapAfter(n - 1)

main() -> int
    println(Holder("x").keep(10000000))
    println(Holder(1).with(10000000, "y"))
    println(Base().run(10000000))
    println(Wrap(5).unwrapAfter(10000000))
    0
