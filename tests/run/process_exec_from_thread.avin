// expect: exit 0
// `exec` from a thread the program started, while `main` waits to join it and other threads sleep:
// the whole process becomes `/bin/sh`, every thread of the program gone with it, and the shell's
// status is the program's. What the threads printed before is written out first.
import avin.process
import avin.threads
import avin.time

main()
  val sleepers = (0..<8).map(i -> threads.spawn(() ->
    threads.sleep(time.seconds(30))
    i)).toVector
  println("main is waiting")
  val becomer = threads.spawn(() ->
    println("the thread calls exec")
    process.exec("/bin/sh", ["-c", "echo the shell runs; exit 0"]).isErr)
  println(s"joined: ${becomer.join()}")
  for s in sleepers do println(s.join())
