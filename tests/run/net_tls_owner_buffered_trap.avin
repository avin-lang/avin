// expect: trap
// A TLS connection keeps the plaintext a line read beyond its line, and a later `readLine` is served
// from it without reaching TLS or the socket. Handed to a thread, the connection is the thread's all
// the same: the code that handed it over traps at that read, as it does at a `TcpStream`'s.
import avin.fs
import avin.io.IoError
import avin.net.TcpListener
import avin.net.tls.{TlsClient, TlsError, TlsServer, TlsStream}
import avin.threads.{Channel, spawn}

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

tls[T](r: Result[T, TlsError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

// A test certificate or key, from the repository root or from `compiler/`.
fixture(name: string) -> string
  val here = "tests/fixtures/tls/" + name
  ok(fs.readText(if fs.exists(here) then here else "../" + here))

main()
  val l = ok(TcpListener.bind("127.0.0.1", 0))
  val server = tls(TlsServer.of(fixture("localhost.pem"), fixture("localhost.key")))
  val port = l.port()
  val serving = spawn(() ->
    val s = tls(TlsStream.server(ok(l.accept()), server))
    ok(s.writeText("first\nsecond\nthird\n"))
    _ = s.readLine())
  val c = tls(TlsStream.connect("localhost", port, TlsClient().trust(fixture("ca.pem"))))
  println(ok(c.readLine()))
  val go = Channel[int]()
  val t = spawn(() ->
    go.receive()
    ok(c.readLine()))
  println("handed over")
  println(c.readLine())
  go.send(1)
  println(t.join(), serving.join())
