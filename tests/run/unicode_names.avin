// expect: exit 0
// Names in any script: a letter of any script starts a name, and letters, digits, combining marks
// and `_` of any script continue it. A capitalized name (an uppercase or titlecase first letter)
// names types and variants as an ASCII one does; a caseless letter starts a binding's name.

data Ärger
    Δelta(größe: int)
    Ωmega
    Жук(имя: string, 年齢: int)

class Fläche(val breite: int, val höhe: int)
    inhalt() -> int = breite * höhe

trait Größe
    größe() -> int

impl Größe for Fläche
    größe() -> int = inhalt()

object Zähler
    val anfang: int = 10
    nächster(n: int) -> int = n + 1

// A generic with a type parameter spelled in Greek.
wähle[Τ](ja: bool, eins: Τ, zwei: Τ) -> Τ = if ja then eins else zwei

beschreibe(ä: Ärger) -> string = ä match
    Δelta(größe) -> s"Δelta $größe"
    Ωmega -> "Ωmega"
    Жук(имя, 年齢) -> s"Жук $имя ${年齢 + 1}"

// The variant written with its type, and a caseless binding in a pattern.
gleich(ä: Ärger) -> bool = ä match
    Ärger.Ωmega -> true
    名前 -> 名前 == Ärger.Δelta(0)

// Named arguments in any script.
fläche(breite: int = 2, höhe: int = 3) -> int = breite * höhe

main()
    val café = "crème"
    val ü = 7
    val π = 3.25
    val значение = ü * 2
    val 名前 = "名"
    // Combining marks and other scripts' digits in continue position.
    val v⃗ = 4
    val x٣ = 3
    val a١٢ = 12
    val ǅemal = "titlecase"
    println(s"$café $ü $π $значение $名前 ${v⃗ + x٣ + a١٢} $ǅemal")
    println(s"${ü + 1} ${名前}${名前} $ü$ü")
    println(f"$π%.1f ${ü * 2}%04d")
    // A value shows its type's and fields' own names.
    println(Ärger.Δelta(5))
    println(Жук("Ваня", 3))
    println(beschreibe(Ärger.Δelta(5)))
    println(beschreibe(Ωmega))
    println(beschreibe(Жук("Ваня", 3)))
    println(s"${gleich(Ωmega)} ${gleich(Δelta(0))} ${gleich(Δelta(1))}")
    val f = Fläche(3, 4)
    println(s"${f.breite} ${f.höhe} ${f.inhalt()} ${f.größe()}")
    println(Zähler.nächster(Zähler.anfang))
    println(wähle(true, "α", "β") + wähle(false, "α", "ω") + wähle(false, 1, 2).toString())
    println(fläche(höhe = 5) + fläche(breite = 1, höhe = 1))
    // A closure capturing a non-ASCII name, and a function value of one.
    var summe = 0
    val addiere = (n: int) -> summe += n * ü
    for i in 1..3 do addiere(i)
    println(summe)
    val g = Zähler.nächster
    println(g(41))
    // Names that differ in script but look alike are different names: Latin `a`, Cyrillic `а`.
    val a = 1
    val а = 2
    println(a + а)
