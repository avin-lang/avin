// expect: exit 0

// A width under `%s` and `%?` applies to the whole rendered value, whatever its type's renderer does
// with the spec: a program's own `display` or `debug` that ignores the spec is still padded to the
// field, on the left, or on the right under `-`; a value as wide as the field or wider is written
// whole; the width counts characters, not bytes. The renderer is still handed the whole spec.

// Renders itself and ignores the spec.
data M(cents: long)

impl Display for M
    display(out: Writer, spec: FormatSpec) = out.write(s"$$$cents")

impl Debug for M
    debug(out: Writer, spec: FormatSpec) = out.write(s"M<$cents>")

// Renders a text of its own, which may be empty or Unicode.
data Word(text: string)

impl Display for Word
    display(out: Writer, spec: FormatSpec) = out.write(text)

// Reads the width it is handed and writes it.
class Seer(): Display
    override display(out: Writer, spec: FormatSpec) = out.write(s"w${spec.width}")

// Fills the field itself, so the formatter has nothing left to pad.
class Fitted(): Display
    override display(out: Writer, spec: FormatSpec) = out.writeField("fit", spec)

// Writes more than the field, padding itself past it.
class Wide(): Display
    override display(out: Writer, spec: FormatSpec) =
        out.write("[")
        out.writeSpaces(long(spec.width))
        out.write("]")

// A generic type with a program's own `Display`.
data Box[T](item: T)

impl[T: Display] Display for Box[T]
    display(out: Writer, spec: FormatSpec) =
        out.write("<")
        item.display(out, FormatSpec())
        out.write(">")

// A derived `Display` holding a field with a program's own.
data Line(m: M, n: int)

trait Pet
    name() -> string

class Cat(): Pet, Display
    override name() -> string = "cat"
    override display(out: Writer, spec: FormatSpec) = out.write("Tom")

field[T: Display](x: T) -> string = f"[${x}%6s|${x}%-6s]"

debugField[T: Debug](x: T) -> string = f"[${x}%8?]"

main()
    // The reproducer: a program's own, a derived and a built-in `Display`, all padded alike.
    println(f"[${M(5)}%8s] [${Line(M(1), 2)}%12s] [${Some(3)}%8s]")
    // Right and left alignment, and the `Debug` form under `%?`.
    println(f"[${M(5)}%6s] [${M(5)}%-6s] [${M(5)}%8?] [${M(5)}%-8?]")
    // A width of one is no padding; a value as wide as the field or wider is written whole.
    println(f"[${M(5)}%1s] [${M(5)}%2s] [${M(12345)}%3s] [${M(12345)}%-3s]")
    // An empty rendering fills the field with spaces.
    println(f"[${Word("")}%4s] [${Word("")}%-4s] [${Word("")}%s]")
    // The width counts characters: each of these is two or three characters of several bytes.
    println(f"[${Word("é")}%4s] [${Word("€€")}%-4s] [${Word("😀ü")}%5s] [${Word("日本語")}%2s]")
    // A width counted when the program runs, a negative count padding on the right.
    val w = 7
    val none: long = 0
    println(f"[${M(5)}%${w}s] [${M(5)}%${-w}s] [${M(5)}%-${w}s] [${M(5)}%${none}s]")
    // A width and a precision together: cut first, then padded.
    println(f"[${M(12345)}%8.3s] [${M(12345)}%-8.3s] [${M(5)}%8.0s]")
    // The renderer is handed the whole spec, then its text is padded to the field.
    println(f"[${Seer()}%6s] [${Seer()}%-6s] [${Seer()}%s]")
    // A renderer that fills the field itself is not padded twice; one that writes more is whole.
    println(f"[${Fitted()}%6s] [${Fitted()}%-6s] [${Wide()}%3s]")
    // Generic instances: a type parameter bounded by `Display` or `Debug`, and a generic data type.
    println(field(M(5)))
    println(field(Box(M(5))))
    println(field(Box("é")))
    println(field(7))
    println(field("ab"))
    println(debugField(M(5)))
    println(debugField("x"))
    // Inside containers, the whole rendering fills the field.
    println(f"[${[M(1), M(2)]}%14s] [${Some(M(5))}%-12s] [${(M(1), 2)}%10s] [${Box(Box(M(3)))}%9s]")
    // A value of a trait or of `Any`, shown by its own type's `Display`.
    val pet: Pet = Cat()
    val any: Any = M(5)
    println(f"[${pet}%6s] [${any}%-6s]")
    // A closure capturing the value.
    val show = () -> f"[${M(9)}%5s]"
    println(show())
    // The `f` method, called as a method on a context, pads alike.
    println(StringContext(["[", "%8s]"]).f(M(5)))
    println(StringContext(["[", "%-8s]"]).f(Word("é")))
    // `toString()` and an unformatted hole are unchanged.
    println(s"${M(5).toString()}|${M(5)}|")
