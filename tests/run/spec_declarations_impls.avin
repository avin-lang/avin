// expect: exit 0
// Spec probes for declarations, impl: a static-only generic trait at two type arguments through a
// bound, data variants without fields dispatching through a trait, impls for types built from their
// parameters, a type's own method passed over by one added to its trait, and a method an impl in
// the class's module adds that reads a private field and is overridden.
trait Make[A]
    static make(a: A) -> Self

class Note(val text: string): Make[int], Make[string]
    override static make(a: int) -> Note = Note(s"int $a")
    override static make(a: string) -> Note = Note(s"string $a")

both[T: Make[int] + Make[string]]() -> (T, T) = (T.make(1), T.make("x"))

trait Speak
    speak() -> string

data Light
    On
    Off
    Dim(level: int)

impl Speak for Light
    speak() -> string = self match
        On -> "on"
        Off -> "off"
        Dim(l) -> s"dim $l"

data Pair[A, B](a: A, b: B)

impl[T] Pair[T, T]
    same() -> bool = a == b

impl[T] Option[Option[T]]
    flat() -> Option[T] = self match
        Some(inner) -> inner
        None -> None

impl[T] Seq[Seq[T]]
    total() -> int = foldLeft(0, (acc, s) -> acc + s.length())

trait Sized
    size() -> int

impl Sized
    doubled() -> int = size() * 2
    tag() -> string = "added"

class Fast: Sized
    override size() -> int = 5
    tag() -> string = "own"

open class Secret(private val code: int)

impl Secret
    reveal() -> int = code + 1

class Sub: Secret(41)
    override reveal() -> int = 0

viaTrait(s: Sized) -> string = s.tag()

main()
    val (p, q) = both[Note]()
    println(s"${p.text} ${q.text} ${Note.make(3).text}")
    val ls: Vector[Speak] = [On, Off, Dim(3)]
    println(ls.map(x -> x.speak()).mkString(" "))
    println(s"${Pair(1, 1).same()} ${Pair("a", "b").same()}")
    val oo: Option[Option[int]] = Some(Some(2))
    println(s"${oo.flat()} ${Some(None).flat()}")
    val vl: Vector[List[int]] = [List(1, 2), List(3)]
    println(s"${vl.total()}")
    val f = Fast()
    println(s"${f.doubled()} ${f.tag()} ${viaTrait(f)}")
    val s: Secret = Sub()
    println(s"${Secret(1).reveal()} ${s.reveal()}")
