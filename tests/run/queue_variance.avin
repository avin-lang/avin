// expect: exit 0
// A queue is covariant: a `Queue[Dog]` is a `Queue[Animal]`, and enqueueing a supertype widens it.
// Its operations work on the widened view, on nested queues, and on queues of other element types.

open class Animal(val name: string)
class Dog(name: string) : Animal(name)
class Cat(name: string) : Animal(name)

names(q: Queue[Animal]) -> string
    var out = ""
    for a in q do out = out + a.name + " "
    out

kind(q: Queue[Animal]) -> string = q match
    _: Queue[Dog] -> "Queue[Dog]"
    _: Queue[Animal] -> "Queue[Animal]"

main(args: Vector[string])
    val dogs: Queue[Dog] = Queue(Dog("rex"), Dog("fido"))
    println(names(dogs))
    val animals: Queue[Animal] = dogs
    println(animals.length)
    val mixed = dogs.enqueue(Cat("tom"))
    println(names(mixed))
    val more = mixed.enqueueAll(Queue(Cat("kit")))
    println(names(more))
    println(more.front.name)
    println(more.dequeue.0.name)
    println(names(more.dequeue.1))
    println(names(more.map(a -> a)))
    println(names(more.filter(a -> a.name != "rex")))
    println(kind(dogs))
    println(kind(Queue.empty[Animal]()))
    println(names(Queue.empty[Dog]().enqueue(Cat("c"))))
    println(Queue.empty[Dog]().length)
    val strs: Queue[Any] = Queue("a", "b").enqueue(3)
    println(strs.length)
    val nested = Queue(Queue(1, 2), Queue(3)).enqueue(Queue.empty[int]())
    println(nested.length)
    println(nested.front)
    println(nested.map(q -> q.length))
    val opt: Queue[Option[int]] = Queue(Some(1), None)
    println(opt)
