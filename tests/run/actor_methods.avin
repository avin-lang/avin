// expect: exit 0
// An actor's methods are its own helpers, called with the implicit receiver a class's methods have:
// one reading and changing the body's fields, one reading a parameter, a recursive one, one with a
// default, two overloads told apart by their parameter types, one written `private`, one called
// from the body before any message, and one passed as a function value to a collection's method.
// Methods may be declared before or after the `receive` block.
import avin.actors.spawn
import avin.threads.Promise

data Op
    Add(n: int)
    Fact(n: int)
    Name(text: string)
    Report(reply: Promise[string])

actor Ledger(prefix: string) receives Op
    var total = 0
    var names: Vector[string] = Vector()
    var log: Vector[string] = Vector()
    note("opened")

    note(text: string) = log = log :+ text
    add(n: int, times: int = 1) = total += n * times
    describe(n: int) -> string = s"int $n"
    describe(s: string) -> string = s"string $s"

    receive
        Add(n) ->
            add(n)
            add(n, times = 2)
            note(describe(n))
        Fact(n) -> note(s"$n! = ${fact(long(n))}")
        Name(text) ->
            names = names :+ label(text)
            note(describe(text))
        Report(reply) -> reply.complete(s"$total ${names.map(shout)} $log")

    private fact(n: long) -> long = if n <= 1 then 1 else n * fact(n - 1)
    private label(text: string) -> string = prefix + text
    shout(s: string) -> string = s.toUpperCase()

main()
    val l = spawn(Ledger("#"))
    l.tell(Add(2))
    l.tell(Fact(10))
    l.tell(Name("ann"))
    l.tell(Add(-1))
    l.tell(Name("bo"))
    val p = Promise[string]()
    l.tell(Report(p))
    println(p.future.await())
