// Literal and range patterns at the edges: negative literals in every base, the most negative value
// of a width, wide integers, reals with signed zero, characters, and empty or reversed ranges.
// Range patterns take integers, bytes and chars, so a real is matched by its literals only.

small(x: i8) = x match
  -128 -> 1
  -0x1e -> 2
  -1 -> 3
  -0 -> 4
  else 0

ordinary(x: int) = x match
  -0x8000_0000 -> 1
  -1 -> 2
  else 0

wide(x: i257) = x match
  -115792089237316195423570985008687907853269984665640564039457584007913129639936 -> 1
  -18446744073709551616 -> 2
  -1 -> 3
  else 0

floating(x: real) = x match
  -0.0 -> 1
  -1.5 -> 2
  -30.0 -> 3
  -5e-324 -> 4
  else 0

inclusive(n: int) -> int = n match
  -1 .. 2 -> 42
  else 0

exclusive(n: int) -> int = n match
  -1 ..< 2 -> 42
  else 0

empty(n: int) -> int = n match
  3 .. 1 | 1 ..< 1 -> 0
  else 42

character(ch: char) -> int = ch match
  'a' ..< 'z' -> 1
  'é' .. '🌍' -> 2
  else 0

wide_range(value: i129) -> int = value match
  -340282366920938463463374607431768211456 ..< -340282366920938463463374607431768211455 -> 1
  340282366920938463463374607431768211454 .. 340282366920938463463374607431768211455 -> 2
  else 0

pick[T](value: T, n: int) -> T = n match
  0 .. 9 -> value
  else value

main()
  println(small(-128), small(-30), small(-1), small(0), small(1), small(127))
  println(ordinary(-2147483647 - 1), ordinary(-1), ordinary(0), ordinary(2147483647))
  println(
    wide(-115792089237316195423570985008687907853269984665640564039457584007913129639936),
    wide(-18446744073709551616),
    wide(-1),
    wide(0)
  )
  println(floating(0.0), floating(-0.0), floating(-1.5), floating(-30.0), floating(-5e-324), floating(1.5))
  val zero = 0.0
  println(floating(zero / zero))
  // Each range at each of its edges: below, on the first, inside, on the last, above.
  for n in -2 .. 3
    println(n, inclusive(n), exclusive(n), empty(n))
  println(character('a'), character('y'), character('z'), character('é'), character('🌍'), character('\u{10FFFF}'))
  val top: i129 = 340282366920938463463374607431768211455
  println(wide_range(-340282366920938463463374607431768211456), wide_range(0), wide_range(top))
  println(pick(42, 3), pick("kept", 30))
