// Named functions as values, lambdas, and nested helpers: choosing a function by a condition,
// storing one in a variable, passing generic ones, capturing mutable variables, helpers that
// call each other and themselves, and the order the callee and its arguments run in.

inc(x: int) = x + 1

double(x: int) = x * 2

identity[T](x: T) -> T = x

apply[T](f: T -> T, x: T) -> T = f(x)

pick(flag: bool) -> int -> int
  println(5)
  if flag then inc else double

run(f: () -> unit) = f()

hello() = println(42)

count_down(n: int) -> int = if n == 0 then 42 else apply(count_down, n - 1)

value() -> int
  println(2)
  41

pick_first() -> int -> int
  println(1)
  inc

combine(f: (int, int) -> int, a: int, b: int) = f(a, b)

make() -> int -> int = (x: int) -> x + 1

with_return() -> int
  val f: () -> int = () ->
    return 42
  f() + 1

calculate(base: int) -> int
  var total = base
  bump(delta: int) -> int
    total += delta
    total
  call_bump(delta: int) = bump(delta)
  println(bump(1))
  total += 10
  println(call_bump(2))
  total

sum(base: int) -> int
  recur(n: int) -> int = if n == 0 then base else recur(n - 1) + n
  recur(3)

reenter(seed: int) -> int
  helper(n: int) -> int
    bridge(k: int) -> int = helper(k)
    if n == 0 then seed else bridge(n - 1)
  helper(3)

outer[T](x: T) -> T
  get() -> T = x
  get()

make_helper(unused: int) -> int -> int
  step(x: int) = x + 1
  step

visits_outer(seed: int) -> int
  var visits = 0
  helper(n: int) -> int
    visits += 1
    bridge(k: int) -> int = helper(k)
    if n == 0 then seed + visits else bridge(n - 1)
  helper(3)

early_helper() -> int
  helper() -> int = return 42
  helper()
  99

shadowed_capture()
  var value = 40
  add(extra: int) = value + extra
  val result =
    val value = 999
    add(2)
  println(result)
  println(add(value := 3))

local_main() -> int
  main() = 42
  println("outer")
  main()

helpers_in_loop()
  var total = 0
  var i = 0
  while i < 4
    var local = i
    add() =
      local += 1
      total += local
    add()
    println(local, total)
    i += 1

// Local helpers may be used before the line that declares them, so long as what they capture is
// already initialized.
mutual(base: int) -> int
  var visits = 0
  val result = even(7)
  even(n: int) -> int
    visits += 1
    if n == 0 then base else odd(n - 1)
  odd(n: int) -> int
    visits += 1
    if n == 0 then base + 1 else even(n - 1)
  println(visits)
  result

forward_outer[T](value: T) -> T
  val result = first(3)
  first(n: int) -> T = if n == 0 then value else second(n - 1)
  second(n: int) -> T = first(n)
  result

forward_value() -> int -> int
  val result: int -> int = increment
  increment(x: int) -> int = x + 1
  result

main()
  val f: int -> int = inc
  println(f(41))
  println(apply(double, 21))
  println(pick(true)(41))
  println(pick(false)(21))
  var chosen = inc
  chosen = double
  println(chosen(21))
  chosen = inc
  println(chosen((chosen := double)(1)))
  println(chosen(3))
  println(identity(inc)(41))
  println(apply(identity[i128], 18446744073709551616))
  println(apply(identity[char], 'é'))
  println(apply(identity[real], 0.5))
  println(apply(identity[string], "hello"))
  run(hello)
  println(count_down(5))
  // The callee is chosen before its argument runs.
  println(pick_first()(value()))

  println(apply(x -> x + 1, 41))
  println(combine((a, b) -> a * b, 6, 7))
  val add_one: int -> int = x ->
    val result = x + 1
    result
  println(add_one(41))
  println(make()(41))
  println(apply(x -> x, 42), apply(x -> x, true), apply(x -> x, 'é'), apply(x -> x, "hello"))
  println(with_return())
  val offset = 40
  println(((x: int) -> x + offset)(2))
  var total = 40
  println((() -> total +:= 2)())
  println(total)
  println(((x: int) -> ((y: int) -> x + y)(2))(40))
  var base = 40
  near(x: int) = base + x
  println(((x: int) -> near(x))(2))

  println(calculate(1))
  println(sum(36))
  println(reenter(42))
  println(outer(42), outer(true), outer('é'), outer(0.5), outer("hello"))
  println(make_helper(999)(41))
  println(visits_outer(38))
  println(early_helper())
  shadowed_capture()
  println(local_main())
  helpers_in_loop()
  println(mutual(41))
  println(forward_outer(42), forward_outer(true), forward_outer("text"))
  println(forward_value()(41))
