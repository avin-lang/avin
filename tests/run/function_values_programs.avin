// Named functions as values, lambdas, and nested helpers: choosing a function by a condition,
// storing one in a variable, passing generic ones, capturing mutable variables, helpers that
// call each other and themselves, and the order the callee and its arguments run in.

inc(x: int) = x + 1

double(x: int) = x * 2

identity[T](x: T) -> T = x

apply[T](f: T -> T, x: T) -> T = f(x)

pick(flag: bool) -> int -> int
    print(5)
    if flag then inc else double

run(f: () -> unit) = f()

hello() = print(42)

count_down(n: int) -> int = if n == 0 then 42 else apply(count_down, n - 1)

value() -> int
    print(2)
    41

pick_first() -> int -> int
    print(1)
    inc

combine(f: (int, int) -> int, a: int, b: int) = f(a, b)

make() -> int -> int = (x: int) -> x + 1

with_return() -> int
    val f: () -> int = () ->
        return 42
    f() + 1

calculate(base: int) -> int
    var total = base
    bump(delta: int) -> int
        total += delta
        total
    call_bump(delta: int) = bump(delta)
    print(bump(1))
    total += 10
    print(call_bump(2))
    total

sum(base: int) -> int
    recur(n: int) -> int = if n == 0 then base else recur(n - 1) + n
    recur(3)

reenter(seed: int) -> int
    helper(n: int) -> int
        bridge(k: int) -> int = helper(k)
        if n == 0 then seed else bridge(n - 1)
    helper(3)

outer[T](x: T) -> T
    get() -> T = x
    get()

make_helper(unused: int) -> int -> int
    step(x: int) = x + 1
    step

visits_outer(seed: int) -> int
    var visits = 0
    helper(n: int) -> int
        visits += 1
        bridge(k: int) -> int = helper(k)
        if n == 0 then seed + visits else bridge(n - 1)
    helper(3)

early_helper() -> int
    helper() -> int = return 42
    helper()
    99

shadowed_capture()
    var value = 40
    add(extra: int) = value + extra
    val result =
        val value = 999
        add(2)
    print(result)
    print(add(value := 3))

local_main() -> int
    main() = 42
    print("outer")
    main()

helpers_in_loop()
    var total = 0
    var i = 0
    while i < 4
        var local = i
        add() =
            local += 1
            total += local
        add()
        print(local, total)
        i += 1

// Local helpers may be used before the line that declares them, so long as what they capture is
// already initialized.
mutual(base: int) -> int
    var visits = 0
    val result = even(7)
    even(n: int) -> int
        visits += 1
        if n == 0 then base else odd(n - 1)
    odd(n: int) -> int
        visits += 1
        if n == 0 then base + 1 else even(n - 1)
    print(visits)
    result

forward_outer[T](value: T) -> T
    val result = first(3)
    first(n: int) -> T = if n == 0 then value else second(n - 1)
    second(n: int) -> T = first(n)
    result

forward_value() -> int -> int
    val result: int -> int = increment
    increment(x: int) -> int = x + 1
    result

main()
    val f: int -> int = inc
    print(f(41))
    print(apply(double, 21))
    print(pick(true)(41))
    print(pick(false)(21))
    var chosen = inc
    chosen = double
    print(chosen(21))
    chosen = inc
    print(chosen((chosen := double)(1)))
    print(chosen(3))
    print(identity(inc)(41))
    print(apply(identity[i128], 18446744073709551616))
    print(apply(identity[char], 'é'))
    print(apply(identity[real], 0.5))
    print(apply(identity[string], "hello"))
    run(hello)
    print(count_down(5))
    // The callee is chosen before its argument runs.
    print(pick_first()(value()))

    print(apply(x -> x + 1, 41))
    print(combine((a, b) -> a * b, 6, 7))
    val add_one: int -> int = x ->
        val result = x + 1
        result
    print(add_one(41))
    print(make()(41))
    print(apply(x -> x, 42), apply(x -> x, true), apply(x -> x, 'é'), apply(x -> x, "hello"))
    print(with_return())
    val offset = 40
    print(((x: int) -> x + offset)(2))
    var total = 40
    print((() -> total +:= 2)())
    print(total)
    print(((x: int) -> ((y: int) -> x + y)(2))(40))
    var base = 40
    near(x: int) = base + x
    print(((x: int) -> near(x))(2))

    print(calculate(1))
    print(sum(36))
    print(reenter(42))
    print(outer(42), outer(true), outer('é'), outer(0.5), outer("hello"))
    print(make_helper(999)(41))
    print(visits_outer(38))
    print(early_helper())
    shadowed_capture()
    print(local_main())
    helpers_in_loop()
    print(mutual(41))
    print(forward_outer(42), forward_outer(true), forward_outer("text"))
    print(forward_value()(41))
