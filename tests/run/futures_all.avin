// expect: exit 0
// A thousand futures, each making a string on the pool, gathered by `Future.all` into one vector in
// the order they were given, whichever finished first; `all` of none is an empty vector at once.
import avin.threads.Future

main() -> int
  val fs = (1 .. 1000).map(i -> Future(s"$i")).toVector
  val gathered = Future.all(fs).await()
  var total = 0
  var inOrder = true
  for (text, i) in gathered.zipWithIndex
    if text.toIntOption() != Some(i + 1) then inOrder = false
    total += i + 1
  println(s"${gathered.length} values summing to $total, in order: $inOrder")
  val summed = Future.all(fs.map(f -> f.map(t -> t.charCount))).map(v -> v.sum)
  println(s"digits ${summed.await()}")
  val none: Vector[Future[int]] = []
  println(s"none ${Future.all(none).await().length}")
  0
