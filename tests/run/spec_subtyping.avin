// expect: exit 0
// Subtyping and agreement: a List[Dog] is a List[Animal], a List[Nothing] a List[int], a function of
// an Animal a function of a Dog and one yielding a string one yielding Any; branches yielding
// Some(dog) and Some(cat) agree on Option[Animal]; flatMap's lambda branches agree on the expected
// Iterable; an impl makes a class a trait's subtype; and recursion whose type arguments do not grow,
// swapped or repeated, compiles; with main taking []string.

open class Animal(val name: string)

class Dog(name: string): Animal(name)

class Cat(name: string): Animal(name)

trait Named
  label() -> string

impl Named for Dog
  label() -> string = "dog " + name

names(xs: List[Animal]) -> string = xs.map(a -> a.name).mkString(",")

callAny(f: () -> Any) -> Any = f()

callDog(f: (Dog) -> int) -> int = f(Dog("rex"))

labelOf(n: Named) -> string = n.label()

swap[A, B](p: (A, B)) -> (B, A) = (p.1, p.0)

same[T](x: T, n: int) -> T = if n == 0 then x else same(x, n - 1)

flipped[A, B](a: A, b: B, n: int) -> string = if n == 0 then s"done" else flipped(b, a, n - 1)

main(args: [] string)
  val dogs: List[Dog] = [Dog("a"), Dog("b")]
  println(names(dogs))
  val none: List[Nothing] = Nil
  val ints: List[int] = none
  println(ints.length)
  println(callAny(() -> "text"))
  println(callDog((a: Animal) -> a.name.byteLength))
  val c = true
  val pet = if c then Some(Dog("d")) else Some(Cat("c"))
  val held: Option[Animal] = pet
  println(held.map(a -> a.name))
  val v = [1, 2, 3]
  println(v.flatMap(n -> if n == 2 then List.empty[int]() else v))
  println(labelOf(Dog("x")))
  val pairs: (Animal, string) = (Dog("t"), "s")
  println(pairs.0.name)
  println(swap((1, "one")))
  println(same("s", 3))
  println(flipped(1, "a", 5))
  println(args.length)
