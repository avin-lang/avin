// expect: exit 0
// An impl of `Display` for one instance of a data type is an impl of the trait the type's own, so the
// type has no `Display` without asking: the instance it names renders through it, interpolated,
// printed and inside a collection, and the type's other instances have none. A `Debug` the type has
// without asking is untouched.

data Box[T](value: T)

impl Display for Box[int]
  display(out: Writer, spec: FormatSpec) = out.write(s"an int box of $value")

describe(a: Any) -> string = a match
  d: Display -> s"shown as $d"
  _ -> "no Display"

main()
  println(Box(1))
  println(s"[${Box(2)}]")
  println([Box(3), Box(4)])
  println(describe(Box(5)))
  println(describe(Box("s")))
  println(f"${Box("t")}%?")
  println(f"${Box(6)}%?")
