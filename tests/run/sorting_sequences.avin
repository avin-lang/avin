// Every sequence has `sorted()` where its elements are ordered, and `sortBy(key)` and
// `sortWith(compare)` always. A list sorts into a list; every other sequence sorts into a vector,
// leaving itself as it was. Every sort is stable: elements that compare equal keep their order.
data Entry(rank: int, name: string)

data Suit derives Eq, Hash, Ord
    Clubs
    Diamonds
    Hearts
    Spades

data Card(rank: int, suit: Suit) derives Eq, Hash, Ord

descending(a: int, b: int) -> int = b.compare(a)

main()
    // A vector: empty, one element, already sorted, reversed, duplicates.
    val none: Vector[int] = []
    println(none.sorted())
    val one: Vector[int] = [7]
    println(one.sorted())
    val ascending: Vector[int] = [1, 2, 3, 4]
    println(ascending.sorted())
    val reversed: Vector[int] = [4, 3, 2, 1]
    println(reversed.sorted())
    println(reversed)
    val repeated: Vector[int] = [3, 1, 3, 2, 1, 3]
    println(repeated.sorted())
    println(repeated.sortWith(descending))
    println(repeated.sortBy(x -> -x))

    // A list sorts into a list.
    val list: List[int] = [5, 2, 8, 2, 1]
    val sortedList: List[int] = list.sorted()
    println(sortedList)
    val byKey: List[int] = list.sortBy(x -> x % 3)
    println(byKey)
    val withCompare: List[int] = list.sortWith((a, b) -> b.compare(a))
    println(withCompare)
    val emptyList: List[string] = []
    println(emptyList.sorted())
    println(emptyList.sortBy(s -> s.charCount()))
    val oneList: List[string] = ["only"]
    println(oneList.sortWith((a, b) -> a.compare(b)))

    // An array, a buffer and a deque sort into a vector and are left as they were.
    val array: Array[int] = [3, 1, 2]
    val fromArray: Vector[int] = array.sorted()
    println(s"$fromArray $array")
    val buffer = Buffer[int]()
    buffer ++= [9, 7, 8]
    val fromBuffer: Vector[int] = buffer.sortWith(descending)
    println(s"$fromBuffer $buffer")
    val deque: Deque[int] = [6, 4, 5]
    deque.prepend(10)
    val fromDeque: Vector[int] = deque.sortBy(x -> x)
    println(s"$fromDeque $deque")

    // Strings order by code point, reals as IEEE 754 orders them.
    val words: Vector[string] = ["pear", "Zebra", "apple", "äpfel", "", "app"]
    println(words.sorted().mkString(" | "))
    println(words.sortBy(w -> w.charCount()).mkString(" | "))
    val reals: List[real] = [2.5, -1.0, 0.0, 10.25, -3.5]
    println(reals.sorted())

    // Stability: entries with equal ranks keep the order they came in, whichever sort is used.
    val entries: Vector[Entry] = [Entry(2, "a"), Entry(1, "b"), Entry(2, "c"), Entry(1, "d"), Entry(3, "e"), Entry(2, "f")]
    println(entries.sortBy(e -> e.rank).map(e -> e.name).mkString(""))
    println(entries.sortWith((x, y) -> x.rank.compare(y.rank)).map(e -> e.name).mkString(""))
    println(entries.sortWith((x, y) -> y.rank.compare(x.rank)).map(e -> e.name).mkString(""))
    val entryList: List[Entry] = entries.toList
    println(entryList.sortBy(e -> e.rank).map(e -> e.name).mkString(""))
    // Every element comparing equal leaves the order untouched.
    println(entries.sortWith((x, y) -> 0).map(e -> e.name).mkString(""))

    // A data type deriving `Ord` sorts by variant in declaration order, then by its fields.
    val suits: Vector[Suit] = [Spades, Clubs, Hearts, Diamonds, Clubs]
    println(suits.sorted())
    val cards: List[Card] = [Card(10, Hearts), Card(2, Spades), Card(10, Clubs), Card(2, Diamonds)]
    println(cards.sorted())
    println(cards.sortBy(c -> c.suit))

    // Generic code over `Seq` reaches the same sorts.
    println(smallest3([9, 4, 7, 1, 8]))
    println(smallest3(Array.tabulate(6, i -> 6 - i)))

smallest3[T: Ord](xs: Seq[T]) -> Vector[T]
    val s = xs.sorted()
    if s.length <= 3 then s else s.slice(0, 3)
