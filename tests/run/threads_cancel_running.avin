// expect: exit 0
// A running thread is cancelled at its next safepoint poll: a loop that calls nothing, a loop that
// calls a function, a deep recursion, and a loop that allocates as it goes all stop, with no
// result and nothing after the loop run. More threads compute than there are processors, so some are
// ready but not yet running when the scope is cancelled, and a thread cancelled before it ever ran
// ends at once. Threads that finished before the cancellation keep their results.
import avin.threads.{Atomic, scope, sleep}
import avin.time.millis

step(n: long) -> long = n % 1000003 + 1

forever(x: long) -> long = forever(step(x))

down(n: long) -> long = if n == 0 then forever(0) else down(n - 1) + 1

spin(kind: int) -> long
    var x: long = 0
    if kind == 0
        while true do x = x +% 1
    elif kind == 1
        while true do x = step(x)
    elif kind == 2
        x = down(1000)
    else
        var xs: List[long] = []
        while true
            xs = x :: xs
            if xs.length > 100 then xs = []
    x

main() -> int
    val running = Atomic(0)
    val after = Atomic(0)
    val results = scope(s ->
        val done = s.spawn(() -> long(42))
        done.join()
        var ts = [done]
        for i in 0..<16
            ts = ts :+ s.spawn(() ->
                running.add(1)
                val x = spin(i % 4)
                after.add(1)
                x)
        while running.load() == 0 do sleep(millis(1))
        sleep(millis(30))
        s.cancel()
        ts)
    for t in results do println(t.result())
    println(after.load())
    0
