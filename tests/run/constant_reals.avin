// expect: exit 0
// A value built only of constants inside a function is made at compile time, and one holding a real
// is named by the real's bits: two reals that are close or print alike (0.0 and -0.0, 0.3 and the
// sum that misses it) stay apart, and the same real in two functions is one value.

data P(x: real, y: real)

data Tagged(name: string, weight: real, on: bool)

zero() -> P = P(0.0, 0.0)

negativeZero() -> P = P(-0.0, -0.0)

near() -> Option[real] = Some(0.30000000000000004)

exact() -> Option[real] = Some(0.3)

again() -> Option[real] = Some(0.3)

tiny() -> (Option[real], Option[real]) = (Some(4.9e-324), Some(1.7976931348623157e308))

tagged() -> Tagged = Tagged("pi", 3.14159, true)

nested() -> Option[(real, Option[real])] = Some((1.5, Some(-2.5)))

which(o: Option[real]) -> string = o match
  Some(0.3) -> "three tenths"
  Some(_) -> "other"
  None -> "none"

main()
  println(zero())
  println(negativeZero())
  println(1.0 / zero().x)
  println(1.0 / negativeZero().x)
  println(zero() == negativeZero())
  println(exact() == again())
  println(which(exact()))
  println(which(near()))
  println(which(None))
  println(tiny() == (Some(4.9e-324), Some(1.7976931348623157e308)))
  println(tiny() == (Some(0.0), Some(1.7976931348623157e308)))
  println(tagged())
  println(nested())
  var kept: Vector[Option[real]] = []
  for i in 0 ..< 20000
    kept = kept :+ (if i % 2 == 0 then exact() else near())
  var threes = 0
  for k in kept
    if which(k) == "three tenths" then threes += 1
  println(threes)
