// expect: exit 0
// `+`, `-`, `*`, `/`, `%` and unary `-` are the core traits' methods: a data type or a class gains
// them through an impl, compound assignment included, and generic code uses them through a bound,
// where an instance at a built-in type is the machine's own operation.

data Vector2(x: int, y: int)

impl Add for Vector2
  add(other: Vector2) -> Vector2 = Vector2(x + other.x, y + other.y)
  static zero() -> Vector2 = Vector2(0, 0)

impl Sub for Vector2
  subtract(other: Vector2) -> Vector2 = Vector2(x - other.x, y - other.y)

impl Neg for Vector2
  negate() -> Vector2 = Vector2(-x, -y)

class Money(val cents: long): Add, Mul, Div, Rem
  override add(other: Money) -> Money = Money(cents + other.cents)
  override static zero() -> Money = Money(0)
  override multiply(other: Money) -> Money = Money(cents * other.cents)
  override static one() -> Money = Money(1)
  override divide(other: Money) -> Money = Money(cents / other.cents)
  override remainder(other: Money) -> Money = Money(cents % other.cents)

sum[T: Add](items: (T, T, T)) -> T
  val (a, b, c) = items
  a + b + c

difference[T: Sub + Neg](a: T, b: T) -> T = -(a - b)

shown(v: Vector2) -> string = s"(${v.x}, ${v.y})"

main()
  val v = Vector2(1, 2) + Vector2(10, 20)
  println(shown(v))
  println(shown(v - Vector2(1, 1)))
  println(shown(-v))
  var w = Vector2(0, 0)
  w += Vector2(2, 3)
  w += w
  println(shown(w))
  println(shown(sum((Vector2(1, 1), Vector2(2, 2), Vector2(3, 3)))))
  println(s"${sum((1, 2, 3))} ${sum(("a", "b", "c"))} ${sum((0.5, 0.25, 0.25))} ${sum((long(1), long(2), long(3)))}")
  println(s"${difference(3, 10)} ${shown(difference(Vector2(5, 5), Vector2(1, 2)))}")
  val m = Money(7) * Money(6)
  println(s"${m.cents} ${(m / Money(5)).cents} ${(m % Money(5)).cents} ${sum((Money(1), Money(2), m)).cents}")
  println(s"${5.add(6)} ${(-3).negate()} ${"x".add("y")}")
