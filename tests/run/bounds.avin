// A bound gives a type parameter the methods of a trait: `[T: Ordered]` is any type conforming to
// `Ordered`, and `Self` in the trait is that type. Each instance calls its type's own method.
trait Ordered
    less(other: Self) -> bool
    greater(other: Self) -> bool = other.less(self)
    atMost(other: Self) -> bool = !greater(other)

max[T: Ordered](a: T, b: T) -> T = if a.less(b) then b else a

min[T: Ordered](a: T, b: T) -> T = if b.less(a) then b else a

// A class conforms in its header.
class Money(val cents: int): Ordered
    override less(other: Money) -> bool = cents < other.cents

// A data type conforms through an impl.
data Version(major: int, minor: int)

impl Ordered for Version
    less(other: Version) -> bool = major < other.major || major == other.major && minor < other.minor

// A class conforms through an impl too.
class Word(val text: string, val rank: int)

impl Ordered for Word
    less(other: Word) -> bool = rank < other.rank

// A generic class bounded where it is declared: its methods use the bound.
class SortedPair[T: Ordered](first: T, second: T)
    low() -> T = min(first, second)
    high() -> T = max(first, second)
    // A method with a bounded type parameter of its own.
    both[U: Ordered](a: U, b: U) -> bool = first.atMost(second) && a.atMost(b)

// A bound calling a method with a default body, and a method value through a bound.
largest[T: Ordered](items: (T, T, T)) -> T
    val (a, b, c) = items
    val beats = a.greater
    if beats(b) then max(a, c) else max(b, c)

main()
    print(s"${max(Money(250), Money(120)).cents}")
    print(s"${min(Money(250), Money(120)).cents}")
    val v = max(Version(1, 4), Version(1, 10))
    print(s"${v.major}.${v.minor}")
    print(max(Word("pear", 2), Word("fig", 1)).text)
    val pair = SortedPair(Version(1, 9), Version(2, 0))
    print(s"${pair.low().major} ${pair.high().major}")
    print(s"${pair.both(Money(1), Money(2))} ${pair.both(Money(3), Money(2))}")
    print(s"${largest((Money(5), Money(9), Money(7))).cents}")
    print(s"${max[Money](Money(3), Money(4)).cents}")
