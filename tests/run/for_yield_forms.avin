// `for` with `yield`: three generators, guards before and after a generator, patterns that take
// elements apart, the block form, a type of the program's own with `map`, `flatMap` and
// `withFilter`, and the order of evaluation, which follows the source element by element: a guard
// tests an element just before the rest of the comprehension uses it, and a later generator's source
// is evaluated anew for each element of the one before.

data Shape
    Circle(r: int)
    Square(side: int)

data Point(x: int, y: int)

// One value or none, with the three methods a comprehension calls.
class Maybe[T](private val value: Option[T])
    map[U](f: (T) -> U) -> Maybe[U] = Maybe(value.map(f))
    flatMap[U](f: (T) -> Maybe[U]) -> Maybe[U] = value match
        Some(v) -> f(v)
        None -> Maybe(None)
    withFilter(p: (T) -> bool) -> Maybe[T] = Maybe(value.filter(p))
    show() -> string = value match
        Some(_) -> "just"
        None -> "nothing"

seen(tag: string, x: int) -> int
    print(s"$tag $x")
    x

source(tag: string, xs: List[int]) -> List[int]
    print(s"source $tag")
    xs

main()
    val xs: List[int] = [1, 2, 3]
    print(for a in xs, b in xs, c in xs if a < b && b < c yield a * 100 + b * 10 + c)
    print(for a in xs if a != 2, b in xs if b != a, c in [a + b] yield c)

    val pairs: List[(string, int)] = [("a", 1), ("b", 2)]
    print(for (name, n) in pairs yield name.repeat(n))
    val points: Vector[Point] = [Point(1, 2), Point(3, 4)]
    print(for Point(x, y) in points yield x * y)
    print(for (_, n) in pairs, _ in xs yield n)

    val shapes: List[Shape] = [Circle(1), Square(2)]
    val sizes = for shape in shapes yield shape match
        Circle(r) -> r * 3
        Square(side) -> side * 4
    print(sizes)

    val grid = for
        row in 0 ..< 3
        if row != 1
        col in 0 ..< 2
    yield
        val cell = row * 10 + col
        cell * 2
    print(grid)

    print((for x in Maybe(Some(2)), y in Maybe(Some(5)) if x < y yield x + y).show())
    print((for x in Maybe(Some(9)), y in Maybe(Some(5)) if x < y yield x + y).show())

    val ordered = for
        x in source("outer", [1, 2])
        if seen("guard", x) > 0
        y in source("inner", [x])
    yield seen("yield", x + y)
    print(ordered)
    print(for x in xs if seen("first", x) != 2 if seen("second", x) != 3 yield x)
