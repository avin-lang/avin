// expect: trap
// The most negative value of a wide integer divided by -1 does not fit, as at any width.

divide(a: i257, b: i257) = println(a / b, a % b)

main()
  divide(-115792089237316195423570985008687907853269984665640564039457584007913129639936, 1)
  divide(-115792089237316195423570985008687907853269984665640564039457584007913129639936, -1)
