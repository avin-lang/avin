// expect: exit 0
// env: AVIN_GC_STRESS=0
// env: AVIN_GC_RELEASE=0
// `AVIN_GC_RELEASE=0` keeps the heap's free pages: the burst gc_release_resident drops leaves the
// program at its peak resident size after collections have freed it.
import avin.process

resident() -> long = process.residentBytes(process.pid()).ok.getOrElse(0)

main()
  val start = resident()
  var held = Buffer[string]()
  for i in 0 ..< 1000000 do held += s"burst object number $i"
  val peak = resident()
  println(s"${held.length} objects, grew by more than 40 MB: ${peak - start > 41943040}")
  held = Buffer[string]()
  var churn = 0
  for i in 0 ..< 2000000 do churn += s"small garbage $i".byteLength
  println(churn)
  val after = resident()
  println(s"after the drop, still above three quarters of the peak: ${after > peak / 4 * 3}")
