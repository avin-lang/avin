// expect: exit 0
// A method named by a symbol may declare the level its calls bind at, `@precedence("|")` naming the
// language's operator of that level, and that its calls group to the right, `@groupsRight`. Each
// line shows the grouping the parse chose; the default a name gives is shown beside a declared one.

class T(val s: string)
  // Methods at the levels their names give, to group against.
  *(o: T) -> T = T(s"($s * ${o.s})")
  +(o: T) -> T = T(s"($s + ${o.s})")
  &(o: T) -> T = T(s"($s & ${o.s})")
  ^(o: T) -> T = T(s"($s ^ ${o.s})")
  |(o: T) -> T = T(s"($s | ${o.s})")
  <(o: T) -> T = T(s"($s < ${o.s})")
  <=>(o: T) -> T = T(s"($s <=> ${o.s})")
  ~>(o: T) -> T = T(s"($s ~> ${o.s})")
  // `<|>` would bind as `<` does; declared, it binds as `|`.
  @precedence("|")
  <|>(o: T) -> T = T(s"($s <|> ${o.s})")
  // A pipe looser than every comparison and than `&&`.
  @precedence("||")
  |>(o: T) -> T = T(s"($s |> ${o.s})")
  @precedence("&&")
  &>(o: T) -> T = T(s"($s &> ${o.s})")
  @precedence("==")
  +++(o: T) -> T = T(s"($s +++ ${o.s})")
  @precedence("::")
  |+|(o: T) -> T = T(s"($s |+| ${o.s})")
  @precedence("^")
  </>(o: T) -> T = T(s"($s </> ${o.s})")
  @precedence("&")
  >>>(o: T) -> T = T(s"($s >>> ${o.s})")
  @precedence("+")
  **(o: T) -> T = T(s"($s ** ${o.s})")
  @precedence("*")
  <+>(o: T) -> T = T(s"($s <+> ${o.s})")
  @precedence("~")
  +-+(o: T) -> T = T(s"($s +-+ ${o.s})")
  // Another operator of a level names that level as well: `-` is `+`'s, `<<` is `*`'s.
  @precedence("-")
  %%(o: T) -> T = T(s"($s %% ${o.s})")
  @precedence("<<")
  =>>(o: T) -> T = T(s"($s =>> ${o.s})")
  @precedence("!=")
  ^^^(o: T) -> T = T(s"($s ^^^ ${o.s})")
  // Right grouping on a name not ending in `:`: the receiver stays on the left.
  @groupsRight
  ^^(o: T) -> T = T(s"($s ^^ ${o.s})")
  @precedence("+")
  @groupsRight
  -->(o: T) -> T = T(s"($s --> ${o.s})")
  // A name ending in `:` keeps its receiver on the right, at its declared level.
  @precedence("==")
  +::(o: T) -> T = T(s"(${o.s} +:: $s)")
  // Overloads of one name declare alike.
  @precedence("|")
  <|>(n: int) -> T = T(s"($s <|> $n)")
  show() -> string = s

val a = T("a")
val b = T("b")
val c = T("c")

// Prints its name when evaluated, to show the order operands are evaluated in.
said(name: string) -> T
  println(s"evaluated $name")
  T(name)

main()
  // `<|>` as `|`, left grouping: `<|>` and `|` read left to right; `<` binds looser.
  println((a <|> b | c).show())
  println((a | b <|> c).show())
  println((a <|> b < c).show())
  println((a <=> b | c).show())
  // `|>` as `||`: looser than comparisons, `&&`-level calls and everything else.
  println((a |> b < c).show())
  println((a |> b &> c).show())
  println((a &> b |> c).show())
  // `&>` as `&&`: looser than comparisons, tighter than `|>`.
  println((a &> b < c).show())
  // `+++` as `==`: looser than `+`, where its first character would bind with it.
  println((a +++ b + c).show())
  println((a + b +++ c).show())
  // `|+|` as `::`: looser than `|`.
  println((a |+| b | c).show())
  println((a | b |+| c).show())
  // `</>` as `^`: tighter than `|`, looser than `&`.
  println((a </> b | c).show())
  println((a </> b & c).show())
  // `>>>` as `&`: tighter than `^`; by its name it would bind with the shifts.
  println((a >>> b ^ c).show())
  println((a >>> b * c).show())
  // `**` as `+`: looser than `*`.
  println((a * b ** c).show())
  println((a ** b * c).show())
  // `<+>` as `*`: tighter than `+`.
  println((a + b <+> c).show())
  // `+-+` as `~`: tighter than `*`, alongside `~>`.
  println((a * b +-+ c).show())
  println((a +-+ b ~> c).show())
  // `%%` as `-`, `=>>` as `<<`, `^^^` as `!=`.
  println((a * b %% c).show())
  println((a + b =>> c).show())
  println((a | b ^^^ c).show())
  // Right grouping.
  println((a ^^ b ^^ c).show())
  println((a --> b --> c).show())
  println((a ^^ b * c).show())
  println((said("x") ^^ said("y") ^^ said("z")).show())
  // A `:` name at its declared level: as `==`, looser than `|`, where `+` would bind tighter.
  println((a | b +:: c).show())
  println((a +:: b +:: c).show())
  // Parentheses settle a grouping as always.
  println(((a |> b) < c).show())
  println((a ^^ (b ^^ c)).show())
  println(((a ^^ b) ^^ c).show())
  // An overload, an interpolation hole and a continuation line read the declaration too.
  println((a <|> 1 | c).show())
  println(s"${(a <|> b | c).show()}")
  val spread = a
    <|> b
    | c
  println(spread.show())
  // In a generic function and a closure.
  val f = (x: T) -> x |> b < c
  println(f(a).show())
  println(twice(a, (x: T) -> x <|> b | c).show())

twice[A](x: A, g: A -> A) -> A = g(g(x))
