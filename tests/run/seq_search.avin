// expect: exit 0
// `search` is a binary search of a sequence in ascending order: `Found(i)` with the first index of an
// equal element, or `InsertionPoint(i)` with where the element would go. `searchBy` orders by a key
// and the three-argument form looks at a window of the sequence.

data Person(name: string, age: int)

show(r: SearchResult) -> string = r match
    Found(i) -> s"Found($i)"
    InsertionPoint(i) -> s"At($i)"

lookup[T: Ord](xs: Seq[T], x: T) -> string = show(xs.search(x))

main()
    val v = [1, 3, 5, 7, 9]
    // present, absent, below all, above all
    println(s"${show(v.search(1))} ${show(v.search(5))} ${show(v.search(9))}")
    println(s"${show(v.search(0))} ${show(v.search(4))} ${show(v.search(10))} ${show(v.search(8))}")
    // empty and one element
    val e: Vector[int] = []
    println(s"${show(e.search(3))} ${show([5].search(5))} ${show([5].search(4))} ${show([5].search(6))}")
    // two elements, every position
    println(s"${show([2, 4].search(1))} ${show([2, 4].search(2))} ${show([2, 4].search(3))} ${show([2, 4].search(4))} ${show([2, 4].search(5))}")
    // duplicates: the first of the equal elements is found, and an absent one goes before the larger
    val d = [1, 2, 2, 2, 2, 3, 3]
    println(s"${show(d.search(2))} ${show(d.search(3))} ${show(d.search(1))} ${show(d.search(0))} ${show(d.search(4))}")
    println(show([7, 7, 7, 7].search(7)) + " " + show([7, 7, 7, 7].search(6)) + " " + show([7, 7, 7, 7].search(8)))
    // every index of a longer sequence agrees with a linear scan
    val big = (0 ..< 100).map(i -> i * 2)
    var agree = true
    for x in -1 .. 200
        val expected = big.indexOf(x)
        val ok = big.search(x) match
            Found(i) -> i == expected
            InsertionPoint(i) -> expected == -1 && (i == 100 || big(i) > x) && (i == 0 || big(i - 1) < x)
        if !ok then agree = false
    println(agree)
    // other kinds of sequence and other ordered types
    val l: List[int] = [10, 20, 30]
    val a: Array[int] = [10, 20, 30]
    val r = 0 ..< 50
    println(s"${lookup(l, 20)} ${lookup(a, 25)} ${lookup(r, 49)} ${lookup(r, 50)} ${lookup(r, -1)}")
    println(s"${lookup(["apple", "fig", "pear"], "fig")} ${lookup(["apple", "fig", "pear"], "grape")}")
    println(s"${lookup([1.5, 2.5], 2.0)} ${lookup(['a', 'c'], 'b')} ${lookup([long(-3), long(0), long(3)], long(0))}")
    // the extreme ints do not overflow the midpoint
    println(s"${lookup([-2147483647 - 1, 0, 2147483647], 2147483647)} ${lookup([-2147483647 - 1, 2147483647], 0)}")
    // the result is a value
    println(v.search(5) == Found(2))
    println(v.search(4) == InsertionPoint(2))
    println(v.search(4) != Found(2))
    // a window of the sequence
    println(s"${show(v.search(5, 0, 5))} ${show(v.search(5, 3, 5))} ${show(v.search(5, 0, 2))} ${show(v.search(7, 1, 4))}")
    println(s"${show(v.search(0, 2, 4))} ${show(v.search(10, 2, 4))} ${show(v.search(5, 2, 2))} ${show(v.search(5, 4, 1))}")
    println(s"${show(v.search(5, -3, 99))} ${show(v.search(9, -3, 99))} ${show(v.search(5, 99, 120))} ${show(v.search(5, -9, -2))}")
    // by a key
    val people = [Person("ann", 20), Person("bob", 30), Person("cy", 30), Person("di", 41)]
    println(s"${show(people.searchBy(p -> p.age, 30))} ${show(people.searchBy(p -> p.age, 25))} ${show(people.searchBy(p -> p.age, 50))} ${show(people.searchBy(p -> p.age, 1))}")
    println(show(people.searchBy(p -> p.name, "cy")) + " " + show(people.searchBy(p -> p.name, "zed")))
    println(show((e.map(x -> Person("x", x))).searchBy(p -> p.age, 1)))
    // a pointer element, GC pressure while searching
    val words = (0 ..< 500).map(i -> s"w${1000 + i}")
    var found = 0
    for i in 0 ..< 500
        if words.search(s"w${1000 + i}") == Found(i) then found += 1
    println(found)
