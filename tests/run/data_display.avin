// expect: exit 0
// Every data type has `Display` and `Debug` without asking, where its fields have them: a variant
// is written `Name(a, b)`, one without fields as its name, and `Debug` quotes the strings inside. A
// generic type has them at type arguments that have them, so `Option` and `Result` show as their
// variants, while a collection inside keeps its own form. An impl of its own replaces the type's
// automatic one, and a type a field leaves without `Display` is simply not one.

data Point(x: int, y: int)

data Shape
    Circle(radius: int)
    Rect(width: int, height: int)
    Empty

data Tree
    Leaf(value: int)
    Node(left: Tree, right: Tree)

data Labelled[T](label: string, value: T)

data Money(cents: long)

impl Display for Money
    display(out: Writer, spec: FormatSpec) = out.write(s"$$${cents / 100}.${cents % 100}")

data Asked(text: string) derives Display, Debug

class Plain

data Wrapper(plain: Plain)

data Outer(inner: Wrapper)

describe(x: Any) -> string = x match
    d: Display -> "displays as " + d.toString()
    _ -> "does not display"

main()
    println(Point(1, 2))
    println(debug(Point(1, 2)))
    println(s"${Circle(3)} ${Rect(1, 2)} $Empty ${debug(Empty)}")
    println(Node(Leaf(1), Node(Leaf(2), Leaf(3))))
    println(Labelled("a", "b"))
    println(debug(Labelled("a", "b")))
    println(Labelled("p", Point(3, 4)))
    println(debug(Labelled("s", Labelled("t", 'c'))))
    val some: Option[int] = Some(3)
    val none: Option[int] = None
    println(s"$some $none ${debug(none)}")
    println(Some("x"))
    println(debug(Some("x")))
    val ok: Result[int, string] = Ok(1)
    val err: Result[int, string] = Err("x")
    println(s"$ok $err ${debug(err)}")
    println(Some([1, 2]))
    val names: List[string] = ["a", "b"]
    println(debug(Some(names)))
    println(debug(Some(Map[string, int]().updated("k", 1))))
    println(Money(1234))
    println(debug(Money(1234)))
    println(s"${Asked("hi")} ${debug(Asked("hi"))}")
    val padded = StringWriter()
    Point(1, 2).display(padded, FormatSpec(width = 12))
    println(s"[${padded.text()}]")
    println(describe(Some(1)))
    println(describe(Wrapper(Plain())))
    println(describe(Outer(Wrapper(Plain()))))
    println(describe(Some(Plain())))
