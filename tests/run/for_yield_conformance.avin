// expect: exit 0
// A `for` with `yield` admits each source by conformance: the last generator's an `Iterable` or a
// `Functor`, one a generator or a guarded definition follows an `Iterable` or a `Monad`, and a
// guard's an `Iterable`, through `withFilter`, or a `Filter`, through `filter`. Each role at a type
// of the program's own (a class, a data type, two parameters, a subclass of a conforming class), at
// the library's `Option`, `Result` and `Either`, mixed with collections, and through the bounds of a
// constructor parameter.

// Only a `Functor`: the last generator, and nothing else, may draw from it.
class Wrap[T](val value: T)
  map[U](f: (T) -> U) -> Wrap[U] = Wrap(f(value))

impl Functor for Wrap

// A `Monad` and a `Filter` whose `filter` says when it runs, so the order of evaluation shows.
class Maybe[T](private val value: Option[T], private val log: Buffer[string])
  map[U](f: (T) -> U) -> Maybe[U] = Maybe(value.map(f), log)
  flatMap[U](f: (T) -> Maybe[U]) -> Maybe[U] = value match
    Some(v) -> f(v)
    None -> Maybe(None, log)
  get() -> Option[T] = value

impl Monad for Maybe
  static pure[X](value: X) -> Maybe[X] = Maybe(Some(value), Buffer[string]())

impl Filter for Maybe
  filter(p: (T) -> bool) -> Maybe[T]
    log.append("filter")
    Maybe(value.filter(p), log)

// A data type that is a `Monad` and no `Filter`.
data Ident[A](value: A)

impl Monad for Ident
  static pure[X](value: X) -> Ident[X] = Ident(value)

  flatMap[B](f: (A) -> Ident[B]) -> Ident[B] = f(value)

// Two parameters, a `Monad` at the first: a value with the notes made on the way to it. Its `map`
// is `Monad`'s default, through `flatMap` and `pure`.
data Logged[T, W](value: T, notes: Vector[W])

impl[T, W] Monad[T] for Logged[T, W]
  static pure[X](value: X) -> Logged[X, W] = Logged(value, [])

  flatMap[B](f: (T) -> Logged[B, W]) -> Logged[B, W]
    val next = f(value)
    Logged(next.value, notes ++ next.notes)

// A subclass is a source through the superclass that conforms.
open class Cell[T](val item: T)
  map[U](f: (T) -> U) -> Cell[U] = Cell(f(item))
  flatMap[U](f: (T) -> Cell[U]) -> Cell[U] = f(item)

impl Monad for Cell
  static pure[X](value: X) -> Cell[X] = Cell(value)

class LoudCell[T](item: T): Cell[T](item)

// Through the bounds: `Functor` alone takes one generator, `Monad` several, `Filter` a guard.
doubled[F[_]: Functor](fa: F[int]) -> F[int] = for a in fa yield a * 2

pairUp[F[_]: Monad, A, B](fa: F[A], fb: F[B]) -> F[(A, B)] = for a in fa, b in fb yield (a, b)

smallPairs[F[_]: Monad & Filter](
    fa: F[int],
    fb: F[int]
) -> F[int] = for a in fa if a < 10, b in fb, s = a + b if s % 2 == 0 yield s

defined[F[_]: Monad & Filter](fa: F[int]) -> F[int] = for a in fa, d = a * 3 if d > 5 yield d + 1

parse(s: string) -> Option[int] = s.toIntOption()

noted(log: Buffer[string], tag: string, result: bool) -> bool
  log.append(tag)
  result

main()
  // A `Functor` alone, as the last generator, at a class and through a bound.
  println((for x in Wrap(20) yield x + 1).value)
  println(doubled(Wrap(4)).value)
  println(doubled(Some(5)))
  println(doubled([1, 2, 3]))
  val ok: Result[int, string] = Ok(6)
  println(doubled(ok))

  // A `Monad` and a `Filter` of the program's own: the guard calls `filter`, in turn with the rest.
  val log = Buffer[string]()
  val m = for x in Maybe(Some(2), log) if noted(
    log,
    "guard x",
    x > 1
  ), y in Maybe(Some(5), log) if noted(log, "guard y", y > x) yield x * y
  println(m.get())
  println(log.toVector)
  val none = for x in Maybe(Some(1), log) if x > 1, y in Maybe(Some(5), log) yield x + y
  println(none.get())
  println(pairUp(Maybe(Some(1), log), Maybe(Some("a"), log)).get())
  println(smallPairs(Maybe(Some(3), log), Maybe(Some(5), log)).get())
  println(defined(Maybe(Some(1), log)).get())
  println(defined(Maybe(Some(2), log)).get())
  println(log.size)

  // A `Monad` without a `Filter`, and a definition no guard follows.
  val i = for a in Ident(3), b = a * 2, c in Ident(b + 1) yield (a, b, c)
  println(i.value)
  println(pairUp(Ident(1), Ident(true)).value)

  // Two parameters, the hole at the first.
  val t = for a in Logged(2, ["first"]), b in Logged(a * 10, ["second"]) yield a + b
  println(t.value)
  println(t.notes)
  println(pairUp(Logged(1, ["a"]), Logged('b', ["b"])).notes)

  // A subclass, through its superclass's conformance.
  val c = for a in LoudCell(4), b in Cell(a + 1) yield a * b
  println(c.item)

  // The library's monads: `Option`'s guard is its `filter`, `Result` and `Either` take no guard.
  println(for a in Some(3), b in Some(4) if a < b yield a + b)
  println(for a in Some(3), b in Some(4) if a > b yield a + b)
  val r1: Result[int, string] = Ok(1)
  val r2: Result[int, string] = Err("bad")
  println(for a in r1, b in r1 yield a + b)
  println(for a in r1, b in r2 yield a + b)
  val e1: Either[string, int] = Right(7)
  println(for a in e1, b in e1 yield a * b)
  println(smallPairs(Some(2), Some(4)))
  println(smallPairs([1, 2, 30], [1, 2]))

  // An `Iterable` first, an `Option` last: the collection's own overloads still decide.
  val words = ["1", "x", "3"]
  println(for w in words, n in parse(w) yield n * 10)
  println(for w in words if w != "1", n in parse(w) yield n)

  // A comprehension in a closure, capturing, and one nested in another's yielded value.
  val base = 100
  val f = (k: int) -> for a in Ident(k), b in Ident(base) yield a + b
  println(f(5).value)
  println(for a in Some(1) yield (for b in Wrap(a) yield b + 1).value)
