// expect: trap
// env: AVIN_GC_STRESS=0
// env: AVIN_HEAP_LIMIT=1048576
// A program whose live data outgrows the heap limit stops with a message naming the limit.

data List
    Cons(head: int, tail: List)
    Nil

main()
    println("growing")
    var xs = Nil
    var i = 0
    while true
        xs = Cons(i, xs)
        i += 1
