// expect: trap
// `+=`, `++=`, `addAll` and the builder of a mutable `BitSet` trap on a negative element, after
// adding the elements before it; `-=` and `--=` ignore one.
import avin.collections.mutable.{BitSet as MutableBitSet}

main()
  val s = MutableBitSet(1, 2)
  s -= -3
  s --= [-1, -2]
  println(s)
  s ++= [7, -1]
