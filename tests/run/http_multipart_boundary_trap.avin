// expect: trap
// A boundary RFC 2046 allows is one to seventy of its characters not ending in a space: seventy is
// written, and a `{` traps.
import avin.net.http.{Multipart, Part}

main()
  val m = Multipart([Part.field("a", "1")])
  println(m.encoded("b".repeat(70)).length)
  println(m.encoded("a{b").length)
