// expect: exit 0
// Maps and sets display in the shape of their literals, `{a: 1}` and `{1, 2}`, with each part in its
// own `Display`, and debug with each part's `Debug`, so strings are quoted; a field width pads the
// whole. Mutable maps and sets render the same way and, like arrays, compare and hash by contents.

import avin.collections.mutable.{Map as MutableMap, Set as MutableSet}

main()
    val ages = Map[string, int]().updated("ada", 36)
    println(ages)
    println(debug(ages))
    val padded = StringWriter()
    ages.display(padded, FormatSpec(width = 12))
    Set[int]().incl(1).display(padded, FormatSpec(width = 5, left = true))
    println(s"[${padded.text}]")
    println(Map[int, string]())
    println(Set[string]().incl("x"))
    println(debug(Set[string]().incl("x")))
    println(Set[int]().incl(7))
    println(Map[string, List[int]]().updated("xs", [1, 2]))

    val table = MutableMap[string, int]()
    table("b") = 2
    println(table)
    println(debug(table))
    val seen = MutableSet[char]()
    seen.add('q')
    println(seen)
    println(debug(seen))

    val other = MutableMap[string, int]()
    println(s"${table == other} ${table === other}")
    other("b") = 2
    println(s"${table == other} ${table.hash() == other.hash()} ${table === other} ${table != other}")
    other("b") = 3
    println(s"${table == other}")
    val again = MutableSet[char]()
    again.add('q')
    println(s"${seen == again} ${seen.hash() == again.hash()}")
