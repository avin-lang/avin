// expect: exit 0
// Values made through constructors inferred by their conformances, in bulk, while the collector
// runs: written-out arguments joined across calls, subclasses passed as their superclass, results
// held in vectors and in closures that capture them.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

impl[T, E] Mappable[T] for Result[T, E]

impl[L, R] Mappable[R] for Either[L, R]

open class Animal(val name: string)

class Dog(n: string): Animal(n)

class Cat(n: string): Animal(n)

open class Shelf[A](val item: A): Mappable[A]
  map[B](f: (A) -> B) -> Shelf[B] = Shelf(f(item))

private class TallShelf[A](x: A, val height: int): Shelf[A](x)

second[F[_]: Mappable](x: F[string], y: F[string]) -> F[string] = y.map(s -> s + "!")

later[F[_]: Mappable](x: F[int]) -> () -> F[string] = () -> x.map(n -> s"n$n")

dog(i: int) -> Result[string, Dog] = if i % 2 == 0 then Ok(s"d$i") else Err(Dog(s"dog$i"))

cat(i: int) -> Result[string, Cat] = if i % 3 == 0 then Ok(s"c$i") else Err(Cat(s"cat$i"))

main()
  var joined: Vector[Result[string, Animal]] = []
  for i in 0 ..< 1500
    joined = joined :+ second(dog(i), cat(i))
  var errs = 0
  for r in joined
    if r is Err(_) then errs += 1
  println(errs)
  println(joined(1499) match
    Ok(s) -> s
    Err(a) -> a.name)
  var shelves: Vector[Shelf[string]] = []
  for i in 0 ..< 1500
    shelves = shelves :+ second(Shelf(s"s$i"), TallShelf(s"t$i", i))
  println(shelves(1499).item)
  var thunks: Vector[() -> Either[string, string]] = []
  for i in 0 ..< 1000
    val e: Either[string, int] = if i % 5 == 0 then Left(s"l$i") else Right(i)
    thunks = thunks :+ later(e)
  var rights = 0
  for t in thunks
    if t() is Right(_) then rights += 1
  println(rights)
  println(thunks(999)())
