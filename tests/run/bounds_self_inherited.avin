// expect: exit 0
// A subclass inherits its superclass's conformance to a trait that mentions `Self`, where `Self` stays
// the superclass, the type that conforms: it keeps the superclass's implementation or overrides it
// with the same parameter types, and passes where a bound asks for the trait.

trait Less
  lt(other: Self) -> bool
  gt(other: Self) -> bool = other.lt(self)

open class Rank(val n: int)

impl Less for Rank
  lt(other: Rank) -> bool = n < other.n

class Plain(n: int): Rank(n)

class Reversed(n: int): Rank(n)
  override lt(other: Rank) -> bool = n > other.n

smaller[T: Less](a: T, b: T) -> T = if b.lt(a) then b else a

main()
  println(s"${Plain(1).lt(Rank(2))} ${Plain(3).gt(Plain(2))} ${smaller(Plain(5), Plain(4)).n}")
  println(s"${Reversed(1).lt(Rank(2))} ${smaller(Reversed(5), Reversed(4)).n}")
  val r: Rank = Reversed(1)
  println(s"${r.lt(Rank(0))} ${smaller(r, Rank(3)).n}")
