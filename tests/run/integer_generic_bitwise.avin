// expect: exit 0
// A type parameter bounded by `Integer` has the bitwise and shift operators as the machine's, at the
// width each instance is: `&`, `|`, `^` and the shifts, with the shifts never trapping and `>>`
// keeping the sign, as on the concrete types.

and[T: Integer](a: T, b: T) -> T = a & b
or[T: Integer](a: T, b: T) -> T = a | b
xor[T: Integer](a: T, b: T) -> T = a ^ b
left[T: Integer](a: T, n: T) -> T = a << n
right[T: Integer](a: T, n: T) -> T = a >> n

// Counts the ones of a non-negative number, as a program of its own would.
ones[T: Integer](x: T) -> int
  var rest = x
  var n = 0
  while rest != T(0)
    rest = rest & (rest - T(1))
    n += 1
  n

main()
  println(s"int ${and(12, 10)} ${or(12, 10)} ${xor(12, 10)} ${left(3, 4)} ${right(-16, 2)} ${right(16, 2)}")
  println(
    s"int ${and(-1, 255)} ${or(int.MinValue, 1)} ${xor(-1, int.MaxValue)} ${left(1, 31)} ${left(1, 32)} ${right(-1, 40)}"
  )
  val a: long = 0x7fff000000000000
  val b: long = long.MinValue
  println(s"long ${and(a, b)} ${or(a, b)} ${xor(a, a)} ${left(a, long(8))} ${right(b, long(63))}")
  val x: i8 = 100
  val y: i8 = -128
  println(s"i8 ${and(x, y)} ${or(x, y)} ${xor(x, y)} ${left(x, i8(1))} ${right(y, i8(7))} ${right(y, i8(100))}")
  val p: i5 = 9
  val q: i5 = 6
  println(s"i5 ${and(p, q)} ${or(p, q)} ${xor(p, q)} ${left(p, i5(2))} ${right(p, i5(1))}")
  val w: i128 = 1
  println(
    s"i128 ${left(w, i128(100)) == and(left(w, i128(100)), left(w, i128(100)))} ${right(left(w, i128(127)), i128(127))} ${ones(left(w, i128(100)) - w)}"
  )
  println(s"ones ${ones(255)} ${ones(long.MaxValue)} ${ones(i8.MaxValue)}")
