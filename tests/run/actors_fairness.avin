// A worker handles at most 16 messages of one actor before putting it at the back of its executor's
// queue, so a busy actor never holds the worker from the others. On an executor of one worker, held
// by a gate while three actors fill their mailboxes, the turns take 16 of A's 40, all 3 of B's, 16
// of C's 20, 16 more of A's, C's last 4 and A's last 8. An actor's start runs in its first turn and
// is not one of the 16; exactly 16 messages take one turn, 17 two, 32 two; an actor with no
// messages runs only its start.
import avin.actors.{Behaviour, spawn}
import avin.threads.{Channel, Executor}

// An actor whose start, and each message, is written to `log`.
logger(name: string, log: Channel[string]) -> Behaviour[int] = Behaviour(name, me ->
  log.send(s"$name start")
  n -> log.send(s"$name $n"))

// An actor that holds its worker until `go` is sent a value.
gate(go: Channel[int]) -> Behaviour[unit] = Behaviour("Gate", me -> _ ->
  go.receive()
  ())

// Runs `counts(i)` messages through actor `i` of as many, all on one worker held by a gate, and prints
// the log with each actor's run of messages as one line.
run(counts: Vector[int])
  val ex = Executor.fixed(1)
  val log = Channel[string]()
  val go = Channel[int]()
  val g = spawn(gate(go), executor = ex)
  g.tell(())
  val names = ["A", "B", "C"]
  val actors = counts.indices.map(i -> spawn(logger(names(i), log), executor = ex)).toVector
  for i in counts.indices
    for n in 1 .. counts(i) do actors(i).tell(n)
  go.send(1)
  var turn = ""
  var count = 0
  for _ in 0 ..< counts.sum + counts.length
    val entry = log.receive().get
    val who = entry.slice(0, 1)
    if entry.endsWith("start") || who != turn
      if count > 0 then println(s"$turn x$count")
      turn = who
      count = 0
    if entry.endsWith("start") then println(entry) else count += 1
  if count > 0 then println(s"$turn x$count")
  println("--")
  ex.shutdown()

main()
  run([40, 3, 20])
  run([16, 1])
  run([17, 1])
  run([32, 1])
  run([0, 0])
  run([1])
