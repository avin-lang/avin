// expect: exit 0
// Eight threads allocate at once, each building a list of strings and a vector of its own, so
// collections stop threads that are allocating, threads parked at polls and threads waiting for the
// heap; every thread's frames are roots throughout. The results are combined by joining.
import avin.threads.spawn

build(id: int, n: int) -> (List[string], Vector[int])
    var words: List[string] = []
    val b = Vector.builder[int]()
    for i in 0..<n
        words = s"t$id-$i" :: words
        b.add(id * 1000 + i)
    (words, b.result())

check(id: int, n: int, words: List[string], numbers: Vector[int]) -> int
    if words.length() != n || numbers.length() != n then return 1
    var i = n - 1
    for w in words
        if w != s"t$id-$i" then return 2
        i--
    for j in 0..<n
        if numbers(j) != id * 1000 + j then return 3
    0

main() -> int
    val n = 500
    val threads = Vector.builder[avin.threads.Thread[(List[string], Vector[int])]]()
    for id in 0..<8
        threads.add(spawn(() -> build(id, n)))
    // The main thread allocates beside them.
    val (ownWords, ownNumbers) = build(8, n)
    var failures = check(8, n, ownWords, ownNumbers)
    var total = 0
    var id = 0
    for t in threads.result()
        val (words, numbers) = t.join()
        failures += check(id, n, words, numbers)
        total += words.length()
        id++
    print(s"$total strings, $failures failures")
    failures
