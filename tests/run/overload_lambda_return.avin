// expect: exit 0
// A lambda passed to overloads told apart by its result, which uses `?` or `return` and so is tried
// against each of them before one is chosen: only the one the call keeps is compiled, whatever the
// other tries made of it, with results of scalar types (`int`, `long`, `bool`, `real`) beside a
// `Result` or an `Option`, a lambda nested inside one, and a local function it calls.
class Task(val run: (string) -> long)

object Task
  of(run: (string) -> int) -> Task = Task(s -> long(run(s)))
  of(run: (string) -> Result[int, int]) -> Task = Task(s -> run(s) match
    Ok(x) -> long(x)
    Err(x) -> -long(x))

flag(f: (int) -> bool) -> string = s"bool ${f(3)}"
flag(f: (int) -> Option[long]) -> string = s"option ${f(3)}"

measure(f: (int) -> real) -> real = f(4)
measure(f: (int) -> Result[real, string]) -> real = f(4).getOrElse(-1.0)

halve(n: int) -> Result[int, int] = if n % 2 == 0 then Ok(n / 2) else Err(n)

main()
  println(Task.of(s ->
    val n = halve(s.byteLength)?
    if n > 10 then return Err(99)
    Ok(n)).run("abcdef"))
  println(Task.of(s ->
    val n = halve(s.byteLength)?
    Ok(n)).run("abc"))
  println(Task.of(s ->
    if s.isEmpty then return Err(7)
    Ok(s.byteLength)).run(""))
  println(Task.of(s -> s.byteLength * 2).run("ab"))
  println(flag(n ->
    if n > 2 then return Some(long(n) * 1000000000000)
    None))
  println(flag(n -> n > 2))
  println(measure(n ->
    if n < 0 then return Err("negative")
    Ok(real(n) / 8.0)))
  println(measure(n -> real(n) * 1.5))
  println(Task.of(s ->
    val parts = s.split(",").map(p -> p.byteLength)
    val first = halve(parts(0))?
    Ok(first + parts.length)).run("abcd,e"))
  println(Task.of(s ->
    twice(n: int) -> Result[int, int] = if n > 100 then Err(n) else Ok(n * 2)
    Ok(twice(twice(s.byteLength)?)?)).run("abc"))
