// expect: exit 0
// `avin.time`: durations and their arithmetic, text forms and order; the monotonic clock only moves
// forward; the wall clock's text form from fixed readings.
import avin.time
import avin.time.{Duration, Instant, WallTime}

main()
    val d = time.seconds(90) + time.milliseconds(500)
    println(d)
    println(debug(d))
    println(debug(time.fromEpoch(time.zero())))
    println(time.microseconds(3))
    println(time.microseconds(1500))
    println(time.milliseconds(2250))
    println(time.milliseconds(-500))
    println(time.microseconds(-1500))
    println(time.zero())
    println(time.minutes(2).inSeconds())
    println(time.hours(1).inMinutes())
    println(time.milliseconds(1999).inSeconds())
    println(time.milliseconds(1500).inSecondsReal())
    println(time.seconds(3) - time.seconds(5))
    println(-time.seconds(2))
    println(time.seconds(2) * 3)
    println(time.seconds(7) / 2)
    println((time.seconds(-4)).abs())
    println(time.seconds(1) < time.seconds(2))
    println(time.seconds(1) == time.milliseconds(1000))
    println(time.seconds(2).compare(time.seconds(1)))
    println(time.seconds(-1).isNegative())
    println(s"[${time.milliseconds(15)}]")

    val a = time.now()
    val b = time.now()
    println(b >= a)
    println(b.since(a) >= time.zero())
    println(b.since(a).isNegative())
    println(a.elapsed() >= time.zero())
    val c = a + time.seconds(10)
    println(c > a)
    println(c.since(a))
    println(c - time.seconds(10) == a)
    println(c.since(a) == time.seconds(10))

    val epoch = time.fromEpoch(time.zero())
    println(epoch)
    println(epoch + time.seconds(86400 * 365 + 3723) + time.microseconds(45))
    println(time.fromEpoch(time.microseconds(-1)))
    println(time.fromEpoch(time.seconds(951782400)))
    println(time.fromEpoch(time.seconds(1793795696)))
    println(time.fromEpoch(time.seconds(-86400 * 365)))
    val w = time.wallClock()
    println(w > epoch)
    println((w + time.seconds(5)).since(w))
    println(w - time.seconds(5) < w)
    println(w.since(epoch) == w.sinceEpoch)

    // A reading less another of its clock is the duration between them.
    println(c - a)
    println(w + time.seconds(5) - w)
    println(c - a == c.since(a))
    // `+=` and `-=` on a reading go through its methods `+` and `-`.
    var t = epoch
    t += time.hours(1)
    t -= time.seconds(1)
    println(t)
    var i = a
    i += time.seconds(3)
    println(i - a)
    // A duration's own `-` and `+` stay `Sub`'s, `Add`'s and `Neg`'s.
    var d2 = time.seconds(1)
    d2 += time.seconds(2)
    d2 *= 2
    d2 -= -time.seconds(1)
    println(d2)
    println(time.seconds(10) / 4 * 3)
