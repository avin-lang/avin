// expect: exit 0
// `avin.time`'s durations: the makers and their method forms on `int` and `long`, the whole units and
// the parts (negative durations dropped toward zero), the sign, arithmetic, `d / e`, the companion's
// bounds, and the text of each unit's boundaries.
import avin.time
import avin.time.{Duration, micros, millis, seconds, minutes, hours, days, weeks}

main()
  // The makers, and each as a method on an `int` and a `long`.
  println(s"${micros(1)} ${millis(1)} ${seconds(1)} ${minutes(1)} ${hours(1)} ${days(1)} ${weeks(1)}")
  println(2.hours == hours(2))
  val two: long = 2
  println(two.hours == hours(2))
  println(90.seconds == minutes(1) + seconds(30))
  println(s"${3.micros} ${3.millis} ${3.seconds} ${3.minutes} ${3.hours} ${3.days} ${3.weeks}")
  println(s"${two.micros} ${two.millis} ${two.seconds} ${two.minutes} ${two.days} ${two.weeks}")
  println((-1).days == hours(-24))
  println(weeks(1) == days(7))
  println(Duration(1500) == micros(1500))
  println(time.micros(7))

  // Whole units, a fraction dropped toward zero.
  println((hours(1) + minutes(30)).toMinutes)
  println(seconds(-90).toMinutes)
  println(s"${days(3).toDays} ${hours(49).toDays} ${hours(-49).toDays}")
  println(s"${minutes(150).toHours} ${seconds(119).toMinutes} ${millis(1999).toSeconds} ${micros(1999).toMillis}")
  println(s"${micros(-1500).toMillis} ${micros(-1999999).toSeconds} ${micros(999).toMillis}")

  // The parts below the next larger unit, negative for a negative duration.
  val d = hours(50) + minutes(7) + seconds(9) + micros(250)
  println(s"${d.toHoursPart} ${d.toMinutesPart} ${d.toSecondsPart} ${d.toMicrosPart}")
  val n = -d
  println(s"${n.toHoursPart} ${n.toMinutesPart} ${n.toSecondsPart} ${n.toMicrosPart}")
  println(s"${Duration.Zero.toHoursPart} ${hours(24).toHoursPart} ${minutes(60).toMinutesPart}")
  println(millis(1500).toSecondsReal)
  println(micros(-250000).toSecondsReal)

  // The sign.
  println(s"${seconds(-1).isNegative} ${Duration.Zero.isNegative} ${seconds(1).isNegative}")
  println(s"${Duration.Zero.isZero} ${micros(1).isZero} ${micros(-1).isZero}")
  println(s"${seconds(-4).abs} ${seconds(4).abs} ${Duration.Zero.abs} ${Duration.Max.abs == Duration.Max}")
  println((Duration.Min + micros(1)).abs == Duration.Max)

  // Arithmetic.
  println(seconds(3) - seconds(5))
  println(-seconds(2))
  println(seconds(2) * 3)
  println(seconds(7) / 2)
  println(millis(-7) / 2)
  println(seconds(10) / 4 * 3)
  println(seconds(2) * -1)
  println(seconds(2) * 0)
  println(hours(1) / minutes(7))
  println(hours(-1) / minutes(7))
  println(minutes(7) / hours(1))
  println(Duration.Max / Duration.Max)
  println(Duration.Min / micros(1) == Duration.Min.micros)
  var acc = seconds(1)
  acc += seconds(2)
  acc *= 2
  acc -= -seconds(1)
  acc /= 7
  println(acc)

  // Order and equality.
  println(seconds(1) < seconds(2))
  println(seconds(1) == millis(1000))
  println(seconds(2).compare(seconds(1)))
  println(Duration.Min < micros(-1) < Duration.Zero < micros(1) < Duration.Max)
  println(s"${Duration.Min.micros} ${Duration.Max.micros} ${Duration.Zero.micros}")

  // Text: the largest of `s`, `ms` and `us` with a whole part, the fraction without trailing zeros.
  println(s"${hours(1) + minutes(30)} ${seconds(-45)} ${Duration.Zero} ${seconds(90) + millis(500)}")
  println(s"${millis(250)} ${micros(1500)} ${micros(7)}")
  println(s"${micros(999)} ${micros(1000)} ${micros(1001)} ${micros(999999)} ${micros(1000000)} ${micros(1000001)}")
  println(
    s"${micros(-999)} ${micros(-1000)} ${micros(-1001)} ${micros(-999999)} ${micros(-1000000)} ${micros(-1000001)}"
  )
  println(s"${micros(1)} ${micros(-1)} ${millis(-500)} ${micros(-1500)} ${millis(2250)} ${micros(1010)}")
  println(s"${Duration.Max} ${Duration.Min}")
  println(debug(seconds(90) + millis(500)))
  println(debug(Duration.Zero))
  println(debug(micros(-7)))
  println(f"[${millis(15)}] [${millis(15)}%8s] [${millis(15)}%-8s]")
