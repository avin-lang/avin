// expect: exit 0
// `avin.time`: durations and their arithmetic, text forms and order; the monotonic clock only moves
// forward; the wall clock's text form from fixed readings.
import avin.time
import avin.time.{Duration, Instant, WallTime}

main()
    val d = time.seconds(90) + time.milliseconds(500)
    print(d)
    print(debug(d))
    print(debug(time.fromEpoch(time.zero())))
    print(time.microseconds(3))
    print(time.microseconds(1500))
    print(time.milliseconds(2250))
    print(time.milliseconds(-500))
    print(time.microseconds(-1500))
    print(time.zero())
    print(time.minutes(2).inSeconds())
    print(time.hours(1).inMinutes())
    print(time.milliseconds(1999).inSeconds())
    print(time.milliseconds(1500).inSecondsReal())
    print(time.seconds(3) - time.seconds(5))
    print(-time.seconds(2))
    print(time.seconds(2).times(3))
    print(time.seconds(7).dividedBy(2))
    print((time.seconds(-4)).abs())
    print(time.seconds(1) < time.seconds(2))
    print(time.seconds(1) == time.milliseconds(1000))
    print(time.seconds(2).compare(time.seconds(1)))
    print(time.seconds(-1).isNegative())
    print(s"[${time.milliseconds(15)}]")

    val a = time.now()
    val b = time.now()
    print(b >= a)
    print(b.since(a) >= time.zero())
    print(b.since(a).isNegative())
    print(a.elapsed() >= time.zero())
    val c = a.plus(time.seconds(10))
    print(c > a)
    print(c.since(a))
    print(c.minus(time.seconds(10)) == a)
    print(c.since(a) == time.seconds(10))

    val epoch = time.fromEpoch(time.zero())
    print(epoch)
    print(epoch.plus(time.seconds(86400 * 365 + 3723)).plus(time.microseconds(45)))
    print(time.fromEpoch(time.microseconds(-1)))
    print(time.fromEpoch(time.seconds(951782400)))
    print(time.fromEpoch(time.seconds(1793795696)))
    print(time.fromEpoch(time.seconds(-86400 * 365)))
    val w = time.wallClock()
    print(w > epoch)
    print(w.plus(time.seconds(5)).since(w))
    print(w.minus(time.seconds(5)) < w)
    print(w.since(epoch) == w.sinceEpoch)
