// expect: exit 0
// A value becomes a union value where a union is expected of it, at a single site: an argument, a
// binding, an assignment to a `var`, a field of a data type and of a class, a result written with `=`
// and with `return`, a part of a tuple written out, each branch of an `if` and each arm of a `match`,
// each element of a collection literal, a map literal's keys and values, a field given in `with`, a
// default argument and a named one. A value whose type is a member is that member; otherwise it is
// the one member its type converts to, as a subclass's instance is its superclass's. A union value
// given where a wider union is expected is the same value there.

open class Dog(val n: string)

class Puppy(n: string): Dog(n)

data Box(v: int | string)

class Holder(var v: int | string)

show(x: int | string) -> string = x match
  n: int -> s"int $n"
  s: string -> s"string $s"

three() -> int | string = 3

early(c: bool) -> int | string
  if c then return 4
  "late"

withDefault(x: int | string = 7) -> string = show(x)

animal(x: Dog | int) -> string = x match
  d: Dog -> s"dog ${d.n}"
  n: int -> s"int $n"

wider(x: int | string | bool) -> string = x match
  n: int -> s"int $n"
  s: string -> s"string $s"
  b: bool -> s"bool $b"

main(args: Vector[string])
  val yes = args.size == 0
  println(show(1))
  val bound: int | string = "bound"
  println(show(bound))
  var v: int | string = 1
  println(show(v))
  v = "assigned"
  println(show(v))
  v = 2
  println(show(v))
  println(show(Box(3).v))
  println(show(Box("box").v))
  val h = Holder(4)
  println(show(h.v))
  h.v = "held"
  println(show(h.v))
  println(show(three()))
  println(show(early(true)))
  println(show(early(false)))
  val t: (int | string, int | string) = (5, "five")
  println(s"${show(t.0)} ${show(t.1)}")
  val branch: int | string = if yes then 6 else "six"
  println(show(branch))
  val other: int | string = if !yes then 6 else "six"
  println(show(other))
  val arm: int | string = args.size match
    0 -> "none"
    _ -> 7
  println(show(arm))
  val list: Vector[int | string] = [8, "eight", 9]
  println(list.map(show))
  val m: Map[int | string, int | string] = {1: "one", "two": 2}
  println(m.get(1).map(show))
  println(m.get("two").map(show))
  println(Box(10) with {v = "changed"})
  println(Box("b") with {v = 11})
  println(withDefault())
  println(withDefault("given"))
  println(show(x = "named"))
  println(show(x = 12))
  println(animal(Puppy("pup")))
  println(animal(13))
  val narrow: int | string = "narrow"
  println(wider(narrow))
  val narrowInt: int | string = 14
  println(wider(narrowInt))
  println(wider(false))
