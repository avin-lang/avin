// `Source.stdin()` reads standard input from the buffer `io.readLine`, `io.lines` and `io.readAll`
// share, so all of them can be mixed and each takes up where the last stopped. Characters come one
// at a time, with bytes that are not UTF-8 one U+FFFD for each ill-formed run, as a line has them.
import avin.io
import avin.io.Source

show(c: char) -> string = if c == '\n' then "\\n" elif c == '\r' then "\\r" else c.toString()

take(cs: Iterator[char], n: int) -> string = (0..<n).map(_ -> show(cs.next())).mkString("|")

main()
    val src = Source.stdin()
    // A line ending `\r\n`.
    println(src.lines().next())
    // Characters beyond ASCII, then the line's terminator.
    val cs = src.chars()
    println(take(cs, 4))
    // A stray byte is one U+FFFD, from a second `Source.stdin()` reading the same input.
    println(take(Source.stdin().chars(), 11))
    // A sequence cut short by the end of its line is one U+FFFD, then the terminator.
    println(take(cs, 6))
    // The shared buffer, then the source's lines again.
    println(io.readLine())
    for line in src.lines().take(1) do println(s"<$line>")
    // Everything left, terminators and all.
    println(src.readAll().replace("\r", "\\r").replace("\n", "\\n"))
    // At the end, every way of reading has nothing.
    println(s"${src.lines().hasNext()} ${src.chars().hasNext()} [${src.readAll()}] ${io.readLine()}")
