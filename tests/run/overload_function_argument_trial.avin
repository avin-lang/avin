// expect: exit 0
// Overloads that differ only in what a function argument returns, `flatMap` taking `(T) ->
// Iterable[U]` or `(T) -> Option[U]`: an argument that cannot be checked alone is tried against each
// candidate, and the one that takes it is chosen. A lambda whose branches join only at the result a
// candidate expects, a generic function named as a value, and a lambda that never returns each reach
// an overload; user overloads of the same shape do as library ones do.

wrap(g: (int) -> Option[int]) -> string = s"option ${g(2)}"
wrap(g: (int) -> Iterable[int]) -> string = s"iterable ${g(2).toVector}"

firstOf[A](x: A) -> A = x

main()
    val v = [1, 2, 3]
    val l = List(7, 8)
    // Branches of two collection types join at the expected `Iterable[U]`.
    println(v.flatMap(n -> if n == 2 then l else v))
    println(l.flatMap(n -> if n == 7 then v else l))
    println(Some(1).flatMap(n -> if n == 1 then l else v))
    println(v.flatMap(n -> if n == 1 then l elif n == 2 then v else List.empty[int]()))
    // A body that fits one candidate alone keeps choosing as before.
    println(v.flatMap(n -> if n > 1 then Some(n * 10) else None))
    println(v.flatMap(n -> [n, n]))
    // A generic function named as a value takes the overload its instance fits.
    println([[1], [2, 3]].flatMap(identity))
    println([Some(1), None, Some(3)].flatMap(identity))
    println(List([4], [5]).flatMap(firstOf))
    println(Some(Some(6)).flatMap(identity))
    println(Some([6, 7]).flatMap(identity))
    // A lambda that never returns fits every candidate alike; the first declared is chosen.
    val none: Option[int] = None
    println(none.flatMap[int](x -> fail("never called")))
    println(Vector.empty[int]().flatMap[string](x -> fail("never called")))
    // A program's own overloads.
    println(wrap(n -> if n > 1 then l else v))
    println(wrap(n -> if n > 1 then Some(n) else None))
