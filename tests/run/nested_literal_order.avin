// expect: exit 0
// An argument holding a number literal is checked after the arguments that hold none, against what
// they decide, and an expression of literals alone after both:
// - An arithmetic operation, a negation or an `if` on literals alone is checked last, so a call
//   holding a literal deep inside it, whose result is a `long`, decides the type of
//   `1_000_000_000_000 + 2001` written before or after it.
// - Only a covariant type argument of the decided type is left open for a later argument to widen;
//   an invariant one (an `Array`'s element) is kept whole, so `Err(2)` against a
//   `Result[(Array[long], int), int]` is exactly that type.

class Point(val x: real, val y: real)
class Named(val label: Option[string], val n: int)

glyphsMake(n: int) -> Result[(Array[long], int), int] =
    if n < 0 then Err(2) else Ok((Array.fill(1, long(n)), 1))

boxes(n: int) -> (Array[long], Vector[long]) = (Array.fill(1, long(n)), [long(n)])

deepCheck(p: Point, named: Named, tag: i8) -> long = 1_000_000_000_000 + long(named.n) * 2001 + long(tag)

repeat(n: long, f: (long) -> long) -> long
    var total: long = 0
    for i in 0..<n do total = total + f(i)
    total

// Calls a function on a value read many times, as a callback is.
onTimes(f: (long) -> int, seed: long, times: int) -> long
    var total: long = 0
    for _ in 0..<times do total = total + long(f(seed))
    total

main()
    // An invariant part of the decided type is kept whole, inside a tuple inside a `Result`.
    assertEq(glyphsMake(-1), Err(2))
    assertEq(Err(2), glyphsMake(-1))
    println(glyphsMake(-1))
    assertEq(boxes(3).1, [3])
    val pair = boxes(4)
    assertEq(pair, (pair.0, [4]))

    // A call holding a literal deep inside, then arithmetic on literals: the call decides `long`.
    assertEq(deepCheck(Point(0.0, 1.0), Named(Some("é"), 1), i8(127)), 1_000_000_000_000 + 2001 + 127)
    assertEq(1_000_000_000_000 + 2001 + 127, deepCheck(Point(0.0, 1.0), Named(Some("é"), 1), i8(127)))

    // A call with a literal and a lambda, beside arithmetic on literals; nested, and with a named
    // function in place of the lambda.
    assertEq(repeat(3, i -> repeat(i + 1, j -> j)), 0 + 1 + 3)
    val bump: (long) -> long = (i) -> i * 2
    assertEq(repeat(4, bump), 2 * (0 + 1 + 2 + 3))
    assertEq(onTimes(x -> s"$x".byteLength(), 12345, 4), 4 * 5)
    assertEq(-(4 * 5), -onTimes(x -> s"$x".byteLength(), 12345, 4))
    assertEq(if pair.1.isEmpty() then 0 else 6, repeat(3, i -> i + 1))
    println("ok")
