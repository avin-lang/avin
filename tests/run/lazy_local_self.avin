// expect: trap
// A local `lazy val` whose initializer needs its own value would wait for itself for ever: the read
// made while it is being initialized traps there instead, naming the value, as a field's does.
// A closure that reads it from inside the initializer is the same read.
main()
  lazy val total: int =
    println("computing total")
    val again = () -> total
    again() + 1
  println("before")
  println(total)
  println("after")
