// expect: exit 0
// A linked set iterates in insertion order: after adds, re-adds (which keep the place), removals and
// re-adds (which make the element new), through its whole mutable API.

import avin.collections.mutable.{LinkedSet}

main()
  // Empty and one.
  val s = LinkedSet[string]()
  println(
    s"${s.size} ${s.isEmpty} ${s.nonEmpty} ${s.headOption} ${s.lastOption} $s ${s.contains("a")} ${s.remove("a")}"
  )
  println(s"${s.add("a")} ${s.size} ${s.head} ${s.last} $s ${s("a")} ${s("b")}")
  println(s"${s.add("a")} ${s.size}")

  // Order after add / re-add / remove / re-add.
  s.add("b")
  s.add("c")
  s.add("a")
  println(s"$s")
  println(s"${s.remove("a")} ${s.remove("a")} $s")
  s.add("a")
  println(s"$s ${s.headOption} ${s.lastOption}")

  // addLast and moveToEnd.
  s.addLast("b")
  println(s"$s")
  s.addLast("z")
  println(s"$s ${s.moveToEnd("c")} ${s.moveToEnd("nope")} $s")

  // removeFirst / removeLast.
  println(s"${s.removeFirst()} ${s.removeLast()} $s")

  // Operators and bulk methods.
  s += "p"
  s += "p"
  s ++= ["q", "a", "r"]
  println(s"$s")
  s -= "q"
  s -= "missing"
  s --= ["p", "nothing"]
  println(s"$s")
  s.addAll(["k", "j"])
  println(s"$s ${s.size}")
  s --= s
  println(s"$s ${s.size}")
  s.add("again")
  println(s"$s")

  // filterInPlace, filter, map, flatMap, copy, withFilter, set algebra, subsetOf.
  val t = LinkedSet[int]()
  for i in [5, 3, 8, 1, 9, 2] do t.add(i)
  val u = t.copy()
  u.filterInPlace(x -> x > 2)
  println(s"$t $u ${t.filter(x -> x % 2 == 1)}")
  println(s"${t.map(x -> x % 3)} ${t.flatMap(x -> [x, x * 10]).size}")
  val evens: LinkedSet[int] = for x in t if x % 2 == 0 yield x * 100
  println(s"$evens")
  val other = LinkedSet[int]()
  for i in [9, 4, 5] do other.add(i)
  println(s"${t.union(other)} ${t.intersect(other)} ${t.diff(other)} ${other.diff(t)}")
  println(s"${u.subsetOf(t)} ${t.subsetOf(u)} ${LinkedSet[int]().subsetOf(t)} ${t.subsetOf(t)}")
  var sum = 0
  t.foreach(x -> sum += x)
  println(sum)

  // Equality ignores order; hash agrees; display, debug and conversion.
  val a = LinkedSet[int]()
  val b = LinkedSet[int]()
  a.add(1)
  a.add(2)
  b.add(2)
  b.add(1)
  println(s"${a == b} ${a.hash() == b.hash()} ${a === b} $a $b ${a.toSet == b.toSet}")
  b.add(3)
  println(s"${a == b}")
  val w = LinkedSet[string]()
  w.add("é")
  w.add("日本")
  w.add("")
  println(s"$w ${w.contains("日本")} ${w.contains("")}")

  // The builder and function view.
  val built = LinkedSet.newBuilder[int]()
  built.addOne(3)
  built.addOne(1)
  built.addOne(3)
  println(s"${built.result()} ${LinkedSet.empty[int]()} ${[1, 2, 3].map(a)}")

  // Many elements: order, removal in the middle, and a sliding window.
  val big = LinkedSet[int]()
  for i in 0 ..< 6000 do big.add(i)
  for i in 0 ..< 6000
    if i % 3 != 0 then big.remove(i)
  var ordered = true
  var last = -1
  for x in big
    if x <= last then ordered = false
    last = x
  println(s"${big.size} $ordered ${big.head} ${big.last}")
  val win = LinkedSet[int]()
  for i in 0 ..< 50 do win.add(i)
  for i in 50 ..< 50000
    win.add(i)
    win.removeFirst()
  println(s"${win.size} ${win.head} ${win.last}")
