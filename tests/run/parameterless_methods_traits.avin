// expect: exit 0
// A trait's or an abstract class's method declared with no parameter list is abstract, or has a
// default that reads the others by bare name; an override is declared without a parameter list too,
// and a call through the trait or the superclass reaches the object's own implementation. A public
// field of the method's name, `val` or `var`, a class parameter among them, or a field of a data
// type's one variant, implements an abstract one. `super.name` reads the superclass's implementation. A type parameter bounded by the trait
// reads the method by name. A parameterless method that yields a function, or a sequence, is called
// with arguments: the parentheses call what it yields.

trait Named
    name -> string
    greeting -> string = s"hello $name"
    shout -> string = greeting.toUpper

class Person(val name: string) : Named

class Robot : Named
    val name = "R2"
    override greeting -> string = s"beep $name"

class Mutable : Named
    var name = "first"

abstract class Animal
    sound -> string
    legs -> int = 4
    speak() -> string = s"says $sound on $legs legs"

class Dog : Animal
    val sound = "woof"

class Bird : Animal
    override sound -> string = "tweet"
    override legs -> int = super.legs - 2

open class Base(n: int)
    size -> int = n
    label -> string = s"base $size"

class Derived(n: int) : Base(n)
    override size -> int = super.size + 100
    override label -> string = "derived " + super.label

trait HasSize
    size -> int

class Sized(s: int) : HasSize
    override size -> int = s

data Box(size: int)

impl HasSize for Box

data Crate(w: int, h: int)

impl HasSize for Crate
    override size -> int = w * h

trait Zero
    static zero -> Self

data Money(cents: long)

impl Zero for Money
    static zero -> Money = Money(0)

total[T: HasSize](xs: Vector[T]) -> int = xs.foldLeft(0, (acc, x) -> acc + x.size)

names[T: Named](xs: Vector[T]) -> Vector[string] = xs.map(x -> x.name)

class Tools(x: int)
    adder -> (int) -> int = n -> n + x
    thunk -> () -> int = () -> x * 10
    items -> Vector[int] = [x, x + 1, x + 2]

main() =
    val ns: Vector[Named] = [Person("ann"), Robot(), Mutable()]
    for n in ns
        println(n.name)
        println(n.greeting)
        println(n.shout)
    val m = Mutable()
    m.name = "second"
    println(m.greeting)
    val zoo: Vector[Animal] = [Dog(), Bird()]
    for a in zoo
        println(a.speak())
        println(a.sound)
    val d: Base = Derived(1)
    println(d.size)
    println(d.label)
    println(total([Sized(2), Sized(5)]))
    val hs: Vector[HasSize] = [Sized(3), Box(9), Crate(2, 4)]
    println(hs.map(h -> h.size))
    println(names([Person("bo"), Person("cy")]))
    println(Money.zero)
    val t = Tools(5)
    println(t.adder(4))
    println(t.thunk())
    println(t.items(2))
    println(t.items.length)
    val f = t.adder
    println(f(1))
