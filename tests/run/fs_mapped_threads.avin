// expect: exit 0
// A mapping is handed to a thread by giving it to the thread's body, as every Sysl handle is: the
// thread reads and writes it, and once the thread has been joined the mapping is the caller's
// again, here closed by the code that made it. Several threads each map the same file for
// themselves and read it at once.
import avin.fs
import avin.io.IoError
import avin.threads.spawn

impl[T] Result[T, IoError]
  get() -> T = self match
    Ok(v) -> v
    Err(e) -> fail(s"unexpected $e")

main()
  val dir = fs.createTempDir("avin-mapped-threads").get()
  val path = dir + "/a"
  _ = fs.writeText(path, "0123456789").get()
  val m = fs.mapFileMutable(path).get()
  val t = spawn(() ->
    m(0) = byte(int('T'))
    _ = m.flush()
    m(9))
  println(t.join())
  println(fs.readText(path).get())
  println(m(0))
  _ = m.close()
  // Each thread maps the file for itself.
  val readers = Vector.tabulate(4, i -> spawn(() ->
    val own = fs.mapFile(path).get()
    var sum = 0
    for k in 0 ..< 10
      sum += int(own(k))
    _ = own.close()
    sum))
  println(readers.map(r -> r.join()))
  _ = fs.removeDirAll(dir).get()
