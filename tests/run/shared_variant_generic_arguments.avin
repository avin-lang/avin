// expect: exit 0
// A variant name several data types share, passed where a generic function wants a type argument,
// is decided by what the call's other arguments decided of that type argument, whichever side of it
// they are written on: `same(segment, MoveTo(1.0, 2.0))` and `same(MoveTo(1.0, 2.0), segment)`.
// Named arguments, methods of a generic type, constructors of generic data and classes, collection
// literals and comparisons decide it the same way, and so do generic data types sharing names, where
// the variant's own fields still decide its type arguments.
data Segment derives Eq, Debug
    MoveTo(x: real, y: real)
    LineTo(x: real, y: real)
    Close

data PathDataType derives Eq, Debug
    MoveTo
    LineTo
    Close

data Tree[T] derives Eq, Debug
    Leaf
    Node(value: T)

data Heap[T] derives Eq, Debug
    Leaf
    Node(value: T, rank: int)

data Pair[T]
    Both(a: T, b: T)

class Holder[T](val first: T, val second: T)

same[T: Eq](a: T, b: T) -> bool = a == b

pick[T](a: T, b: T, first: bool) -> T = if first then a else b

three[T: Eq](a: T, b: T, c: T) -> bool = a == b && b == c

describe(s: Segment) -> string = s match
    MoveTo(x, y) -> s"move $x $y"
    LineTo(x, y) -> s"line $x $y"
    Close -> "close"

main()
    val seg: Segment = MoveTo(10.0, 20.0)
    val kind: PathDataType = Close
    val x = 10.0
    // The argument after the one that decides.
    assertEq(seg, MoveTo(10.0, 20.0))
    println(same(seg, MoveTo(10.0, 20.0)))
    println(same(seg, Close))
    println(same(kind, Close))
    println(same(kind, MoveTo))
    // The argument before the one that decides, with literal fields and without.
    println(same(MoveTo(10.0, 20.0), seg))
    println(same(MoveTo(x, 20.0), seg))
    println(same(Close, seg))
    println(same(Close, kind))
    // Between two that decide, and two shared names after one that decides.
    println(three(seg, LineTo(x, x), seg))
    println(three(kind, Close, Close))
    println(describe(pick(Close, seg, true)))
    println(describe(pick(seg, LineTo(1.0, 2.0), false)))
    // Named arguments, in either order.
    println(same(a = seg, b = MoveTo(10.0, 20.0)))
    println(same(b = Close, a = kind))
    println(same(b = seg, a = MoveTo(x, 20.0)))
    // A method whose parameter the receiver's type argument decides.
    val segments = [seg, LineTo(1.0, 2.0)]
    println(segments.contains(LineTo(1.0, 2.0)))
    println(segments.contains(Close))
    val kinds: Vector[PathDataType] = [MoveTo, Close]
    println(kinds.contains(LineTo))
    // Constructors of generic data and of a generic class.
    val p = Both(seg, Close)
    p match
        Both(a, b) -> println(s"${describe(a)} / ${describe(b)}")
    val h = Holder(Close, seg)
    println(s"${describe(h.first)} / ${describe(h.second)}")
    // Comparisons.
    println(seg == MoveTo(10.0, 20.0))
    println(MoveTo(10.0, 20.0) == seg)
    println(kind != MoveTo)
    // Generic data sharing names: the type argument comes from the variant's own fields.
    val t: Tree[int] = Node(3)
    val heap: Heap[string] = Node("a", 1)
    println(same(t, Node(3)))
    println(same(Node(4), t))
    println(same(t, Leaf))
    println(same(heap, Node("a", 1)))
    println(same(Leaf, heap))
    assertEq(t, Node(3))
    // Collection literals and branches agree the same way, on either side.
    val later = [Close, seg, MoveTo(x, x)]
    println(later.length())
    println(describe(later(2)))
    val first = if x > 1.0 then Close else seg
    println(describe(first))
    val second = if x > 1.0 then seg else LineTo(1.0, 1.0)
    println(describe(second))
    // Inside a lambda's body, the parameter's type decides as any other argument does.
    val f = (s: Segment) -> same(s, Close)
    println(f(Close))
    println(f(seg))
