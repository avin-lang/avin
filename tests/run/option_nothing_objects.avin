// expect: exit 0
// An `Option[Nothing]` inside another value seen both as an option of a class (a pointer) and as an
// option of an `int` (an object) can be neither: such a program keeps every option an object, and
// reads the same values.

class Dog(val name: string) derives Display

val nones = [None, None]

counts() -> Vector[Option[int]] = nones

nothingOk() -> Result[Option[Nothing], string] = Ok(None)

nothing() -> Option[Nothing] = None

pick(n: int, d: Dog) -> Option[Dog] = if n > 0 then Some(d) else nothing()

all() -> Vector[Option[Dog]] = nones

wide() -> Result[Option[Dog], string] = nothingOk()

maker() -> () -> Option[Dog] = nothing

main()
    val rex = Dog("rex")
    println(s"${pick(1, rex)} ${pick(0, rex)}")
    println(s"${all()} ${all().map(o -> o.isDefined())} ${all().map(o -> o.orElse(Some(rex)))}")
    println(s"${wide()} ${wide().map(o -> o.getOrElse(rex))}")
    val made = maker()
    println(s"${made()} ${made().isEmpty()} ${made() == pick(0, rex)}")
    val both: Vector[Option[Dog]] = all() ++ [Some(rex)]
    println(both.map(o -> o.map(d -> d.name).getOrElse("-")))
    // The values of a map literal agree on the option that is not `Option[Nothing]`.
    val byKey = {1: Some(rex), 2: nothing()}
    println(s"${byKey.get(1)} ${byKey.get(2)}")
    println(s"${counts()} ${counts().map(o -> o.getOrElse(7))}")
