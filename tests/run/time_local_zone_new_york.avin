// expect: exit 0
// env: TZ=America/New_York
// The host's zone is the one `TZ` names. Across New York's two daylight saving transitions of 2026
// the local zone's offset, abbreviation and daylight saving change at the instant the clocks do,
// and a reading shows the wall clock: 01:59:59 EST is followed by 03:00:00 EDT, and 01:59:59 EDT by
// 01:00:00 EST, the repeated hour's two readings told apart by their offsets.
import avin.time.{Instant, epochSeconds, localZone, zone, utc, seconds, hours}

show(t: Instant)
    val z = t.atZone(localZone())
    println(s"$z ${z.format("hh:mm:ss zzz z")} ${z.isDaylightSaving()} ${localZone().offsetAt(t)} ${localZone().isDaylightSavingAt(t)} ${localZone().abbreviationAt(t)}")

main()
    val here = localZone()
    println(here)
    println(here.name())
    println(here.isFixed())
    println(here == zone("America/New_York").getOrElse(utc))
    println(here == utc)

    // Spring forward: 2026-03-08T07:00:00Z is 02:00 EST, which the clocks show as 03:00 EDT.
    val spring = epochSeconds(1772953200)
    show(spring - seconds(1))
    show(spring)
    show(spring + hours(1))

    // Fall back: 2026-11-01T06:00:00Z is 02:00 EDT, which the clocks show as 01:00 EST again.
    val fall = epochSeconds(1793512800)
    show(fall - hours(1))
    show(fall - seconds(1))
    show(fall)
    val first = (fall - hours(1)).atZone(here)
    val second = fall.atZone(here)
    println(s"${first.dateTime == second.dateTime} ${first == second} ${first.isBefore(second)} ${first.offset} ${second.offset}")

    // The marshal column: the start time to the minute.
    println(epochSeconds(1793975460).atZone(here).format("MM-DD hh:mm"))
