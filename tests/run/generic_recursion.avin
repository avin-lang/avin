// expect: exit 0
// Recursion in generic code whose type arguments never grow has finitely many copies and compiles:
// a function, method, local function or lambda calling itself at the same type arguments, at a
// permutation of them, at a fixed type, or through a trait; a type growing once outside any cycle;
// a cycle that wraps a value and takes it apart again through a bound, so it never nests deeper;
// and data types naming themselves at their own type arguments.

data Nest[T](x: T)

data Chain[T]
  End
  Link(value: T, rest: Chain[T])

count[T](xs: Chain[T]) -> int = xs match
  End -> 0
  Link(_, rest) -> 1 + count(rest)

swap[A: Display, B: Display](a: A, b: B, n: int) -> string = if n == 0 then s"$a $b" else swap(b, a, n - 1)

even[T](x: T, n: int) -> bool = if n == 0 then true else odd(x, n - 1)

odd[T](x: T, n: int) -> bool = if n == 0 then false else even(x, n - 1)

settle[A, B](a: A, b: B, n: int) -> int = if n == 0 then 0 else 1 + settle(b, n, n - 1)

reset[T](x: T, n: int) -> int = if n == 0 then 0 else 1 + reset(n, n - 1)

twice[T](x: T) -> Nest[Nest[T]] = Nest(Nest(x))

unwrap[T](x: Nest[Nest[T]]) -> T = x.x.x

class Box[T](val x: T)
  depth(n: int) -> int = if n == 0 then 0 else 1 + Box(x).depth(n - 1)
  map[U](f: (T) -> U) -> Box[U] = Box(f(x))

trait Deep
  depth(n: int) -> int

class Shell[T](val x: T): Deep
  override depth(n: int) -> int = if n == 0 then 0 else 1 + viaTrait(Shell(x), n - 1)

viaTrait(d: Deep, n: int) -> int = d.depth(n)

viaBound[D: Deep](d: D, n: int) -> int = d.depth(n)

outer[T](x: T, n: int) -> int
  inner[U](y: U, k: int) -> int = if k == 0 then 0 else 1 + inner(y, k - 1)
  inner((x, x), n)

viaLambda[T](x: T, n: int) -> int
  val f = (y: T) -> viaLambda(y, n - 1)
  if n == 0 then 0 else 1 + f(x)

trait Measured
  measure(n: int) -> int

impl Measured for int
  measure(n: int) -> int = self + n

impl[A: Measured] Measured for Nest[A]
  measure(n: int) -> int = if n == 0 then 0 else 1 + wrapped(x, n - 1)

wrapped[T: Measured](v: T, n: int) -> int = through(Nest(v), n)

through[S: Measured](s: S, n: int) -> int = s.measure(n)

main() -> int
  println(count(Link(1, Link(2, Link(3, End)))))
  println(swap(1, "one", 3))
  println(even('x', 4))
  println(settle(true, "b", 3))
  println(reset("s", 4))
  println(unwrap(twice(7)))
  println(Box(1).depth(5))
  println(Box(2).map((x: int) -> s"<$x>").x)
  println(viaTrait(Shell(1), 3))
  println(viaBound(Shell("a"), 2))
  println(outer(1, 4))
  println(viaLambda(1.5, 3))
  println(wrapped(10, 3))
  for (x, i) in [10, 20, 30].iterator().zipWithIndex
    println(x + i)
  0
