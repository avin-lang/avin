// expect: exit 0
// A type parameter bounded by `Integer` has the limits every integer width has, `T.MaxValue` and
// `T.MinValue`, each instance's own: the same generic code answers `127` at `i8` and
// `9223372036854775807` at `long`. They have type `T`, so they compare, compute and convert as any
// `T` does, and they are reached from nested generic functions, lambdas, default arguments and the
// methods of a generic class.

limits[T: Integer](x: T) -> string = s"${T.MinValue} ${T.MaxValue}"

// The number of bits of the width, from the greatest value's: one more, for the sign.
width[T: Integer]() -> int
  var rest = T.MaxValue
  var n = 1
  while rest != T(0)
    rest = rest >> T(1)
    n += 1
  n

// A generic function reaching the limits through another generic function, at its own `T`.
nested[T: Integer](x: T) -> string = s"${limits(x)} w${width[T]()}"

isEdge[T: Integer](x: T) -> bool = x == T.MaxValue || x == T.MinValue

// The limits as a default argument's value.
clamp[T: Integer](x: T, lo: T = T.MinValue, hi: T = T.MaxValue) -> T =
  if x < lo then lo elif x > hi then hi else x

// The limits captured by a lambda, and named inside one.
counter[T: Integer]() -> () -> T
  var n = T.MinValue
  () ->
    val now = n
    if n < T.MaxValue then n = n + T(1)
    now

steps[T: Integer](start: T) -> Vector[bool] = [start, T.MaxValue, T.MinValue].map(v -> v == T.MaxValue)

// The limits as the operands of arithmetic, conversion and bitwise operators.
mixed[T: Integer](x: T) -> string
  val span = long(T.MaxValue) - long(T.MinValue)
  val complement = T.MaxValue ^ T.wrap(-1)
  s"${span} ${complement == T.MinValue} ${T.MaxValue - x} ${-T.MaxValue} ${T.MinValue < T.MaxValue}"

class Range[T: Integer](lo: T)
  top() -> T = T.MaxValue
  fits(n: long) -> bool = long(T.MinValue) <= n <= long(T.MaxValue)

main()
  println(limits(i1.wrap(0)))
  println(limits(i2(1)))
  println(limits(i5(3)))
  val b: i8 = 7
  println(limits(b))
  println(limits(i16(7)))
  println(limits(7))
  println(limits(long(7)))
  println(limits(i65(7)))
  println(limits(i127(7)))
  println(limits(i128(7)))
  println(limits(i129(7)))
  println(limits(i257(7)))
  println(
    s"${width[i1]()} ${width[i2]()} ${width[i7]()} ${width[i8]()} ${width[int]()} ${width[long]()} ${width[i65]()} ${width[i128]()} ${width[i257]()}"
  )
  println(nested(b))
  println(nested(7))
  println(nested(i128(7)))
  println(
    s"${isEdge(b)} ${isEdge(i8.MaxValue)} ${isEdge(i8.MinValue)} ${isEdge(int.MaxValue)} ${isEdge(long.MinValue)} ${isEdge(i1.MinValue)}"
  )
  println(s"${clamp(b)} ${clamp(b, i8(10))} ${clamp(b, i8(-5), i8(3))} ${clamp(long.MinValue, hi = long(5))}")
  val next = counter[i2]()
  println(s"${next()} ${next()} ${next()} ${next()} ${next()}")
  println(steps(b))
  println(steps(i128(0)))
  println(mixed(b))
  println(mixed(7))
  println(mixed(i1.wrap(0)))
  val r = Range(b)
  println(s"${r.top()} ${r.fits(long(127))} ${r.fits(long(128))} ${r.fits(-long(128))} ${r.fits(-long(129))}")
  val wide = Range(long(7))
  println(s"${wide.top()} ${wide.fits(long.MinValue)}")
