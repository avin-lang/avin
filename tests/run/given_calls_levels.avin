// expect: exit 0
// A call fills each contextual parameter it does not pass by name from the given in the nearest
// scope whose type conforms to the parameter's: the enclosing blocks innermost first, each with the
// givens declared before the call; the contextual parameters of the enclosing function, a local
// function's and a lambda's a level between their bodies and the block they are written in; the
// enclosing class's constructor's; the enclosing object's givens; the module's. The nearer level wins
// outright, an argument passed by name beats every given, and a given's name takes no part.

trait Logger
  name() -> string

class Plain(label: string): Logger
  override name() -> string = label

class FileLogger(path: string): Logger
  override name() -> string = s"file $path"

data Tx(id: int)

tag(using tx: Tx) -> int = tx.id

who(using log: Logger) -> string = log.name()

fileOnly(using file: FileLogger) -> string = file.name()

given moduleTx = Tx(1)
given moduleLog: Logger = Plain("module")

object Store
  given storeTx = Tx(2)
  val first = tag()
  read() -> int = tag()
  nested() -> int
    given inner = Tx(20)
    tag()
  logged() -> string = who()

class Service(label: string, using tx: Tx)
  val first = tag()
  run() -> int = tag()
  shadow() -> int
    given mine = Tx(30)
    tag()
  passed() -> int = tag(tx = Tx(31))

// The function's own contextual parameter fills the calls in its body, passing it on.
forwards(using tx: Tx) -> int = tag() * 10

// A block of the body is nearer than the function's parameters.
blockBeatsParam(using tx: Tx) -> int
  given local = Tx(tx.id + 100)
  tag()

// Recursion, mutual recursion and a tail call pass the given on.
countdown(n: int, acc: int, using tx: Tx) -> int = if n == 0 then acc + tx.id else countdown(n - 1, acc + 1)

isEven(n: int, using tx: Tx) -> bool = if n == 0 then tx.id > 0 else isOdd(n - 1)

isOdd(n: int, using tx: Tx) -> bool = if n == 0 then tx.id < 0 else isEven(n - 1)

// Clauses' bodies have the section as givens.
describe(n: int, using tx: Tx) -> string
describe(0) = s"none in ${tag()}"
describe(n) = s"$n in ${tag()}"

keep() -> () -> int
  given kept = Tx(77)
  () -> tag()

main()
  // Before any given of the block, the module's.
  println(tag())
  println(who())
  println(Store.first)
  println(Store.read())
  println(Store.nested())
  println(Store.logged())
  given t = Tx(6)
  val s = Service("s")
  println(s.first)
  println(s.run())
  println(s.shadow())
  println(s.passed())
  println(Service("named", tx = Tx(3)).run())
  println(forwards())
  println(forwards(tx = Tx(4)))
  println(blockBeatsParam(tx = Tx(5)))
  println(tag())
  println(tag(tx = Tx(7)))
  if t.id > 0
    given t2 = Tx(8)
    println(tag())
    // A given's own value sees the givens outside it, not itself.
    if t2.id > 0
      given own = Tx(tag() * 10)
      println(own.id)
    // A value of the given's name that is no given changes nothing.
    if t2.id > 1
      val t2 = 5
      println(tag() + t2)
  println(tag())
  // A given `FileLogger` fills a `Logger`, and the block's beats the module's.
  given f = FileLogger("a.log")
  println(who())
  println(fileOnly())
  // A local function's own section is nearer than the block it is written in.
  helper(using tx: Tx) -> int = tag() * 1000
  println(helper(tx = Tx(2)))
  outer() -> int = tag() + 1
  println(outer())
  // So is a lambda's.
  val g = (using tx: Tx) -> tag() + 1
  println(g(Tx(40)))
  val h = () -> tag() + 2
  println(h())
  println(countdown(100000, 0))
  println(isEven(10))
  println(isOdd(7))
  println(describe(0))
  println(describe(3))
  val later = keep()
  for i in 0..<1000
    val _ = Plain(s"$i").name()
  println(later())
