// Generic functions: type arguments are inferred from the arguments and the expected type, or
// written, and each instantiation is compiled separately.

identity[T](x: T) -> T = x

first[A, B](a: A, b: B) -> A = a

second[A, B](a: A, b: B) -> B = b

choose[T](flag: bool, yes: T, no: T) -> T = if flag then yes else no

// A generic function may call another, and itself.
twice[T](x: T) -> T = identity(identity(x))

countdown[T](n: int, value: T) -> T = if n == 0 then value else countdown(n - 1, value)

// Locals, branches and match arms of a type parameter's type.
keep[T](x: T) -> T
    val copy: T = x
    var held = copy
    held = x
    held match
        other -> other

// A local function of a generic function sees its type parameters and captures its locals.
wrap[T](x: T) -> T
    val saved = x
    give() -> T = saved
    give()

make[T](x: T) -> T = x

main()
    if identity(41) + 1 == 42 then println("int")
    if identity(true) then println("bool")
    println(identity("string"))
    if identity('c') == 'c' then println("char")
    if identity(2.5) == 2.5 then println("real")
    // A literal takes the type the other arguments settle, in either position.
    val small: i8 = 3
    val picked = choose(false, 100, small)
    if picked == small then println("i8")
    // The expected type settles a literal argument.
    val wide: i64 = identity(5000000000)
    if wide == 5000000000 then println("expected")
    if first(1, "one") == 1 then println(second(1, "first and second"))
    // Written type arguments.
    val n = identity[i16](7)
    // A leading prefix of the type arguments, with the rest inferred.
    val m = first[i8](5, "five")
    if n + 32000 == 32007 && m + 120 == 125 then println("written")
    if twice(9) == 9 && countdown(3, 'z') == 'z' then println("calls")
    if keep(6) == 6 && wrap(8) == 8 then println("bodies")
    // A unit type argument, which has no runtime value.
    val nothing = identity(())
    make[unit](())
    println("unit")
