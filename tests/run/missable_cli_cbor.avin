// expect: exit 0
// `avin.cli`, which reads its configuration as TOML, imported together with `avin.cbor`: the two
// decoder traits share the core's `Missable`, so the program compiles. An option comes from a TOML
// table through `parseWithConfig`, and the settings it makes round-trip through CBOR with an absent
// `Option` field read back as `None`.
import avin.cbor
import avin.cbor.{CborDecoder, CborEncoder, CborOmitNone}
import avin.cli
import avin.toml

data Settings(port: int, @CborOmitNone label: Option[string]) derives CborEncoder, CborDecoder

val p = cli.Parser("serve", "Serve.").int("port", default = 80)

main()
  val config = toml.parse("port = 8443\n").ok.get
  val env = HashMap.empty[string, string]()
  p.parseWithConfig([], config, "serve.toml", env = env) match
    Ok(a) ->
      val s = Settings(a.int("port"), None)
      val back = cbor.decode[Settings](cbor.encode(s)).ok.get
      println(s"${back.port} ${back.label} ${back == s}")
      println(s"${a.origin("port")}")
    Err(e) -> println(s"error: $e")
  println(cbor.decode[Settings](cbor.encode(Settings(1, Some("x")))).ok.get.label)
