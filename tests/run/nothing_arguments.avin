// expect: exit 0
// An argument of type `Nothing` (a `break`, `return`, `continue` or a call that never returns)
// constrains no type argument: the call is never made, and a type argument nothing else decides is
// `Nothing`. The code after such an argument is never reached.

class Holder(n: int)
  keep[T](x: T) -> T
    x

identity[T](x: T) -> T
  x

pair[A, B](a: A, b: B) -> (A, B)
  (a, b)

both[T](a: T, b: T) -> T
  b

apply[T](f: () -> T) -> T
  f()

firstOf[T](xs: Vector[T]) -> T
  xs.head

lazily[T](x: -> T, use: bool) -> int
  if use then 1 else 0

doubled(n: int) -> int
  identity(return n * 2)

guarded(n: int) -> int
  if n > 0 then identity(fail("never")) else n

main()
  var i = 0
  // The programs of the report: a generic call, `println`, and an operator.
  val a = loop
    i += 1
    if i == 3 then println(break 42)
  println(a)
  val b = loop
    i += 1
    identity(break i)
  println(b)
  val c = loop
    val x = 1 + (break 7)
  println(c)
  println(doubled(5))
  println(guarded(-1))
  // Two type parameters, one of them given only `Nothing`.
  val d = loop
    pair(break 8, "x")
  println(d)
  // `Nothing` beside an argument that decides the type, before it and after it.
  val e = loop
    both(2, break 9)
  println(e)
  val f = loop
    both(break 10, 7)
  println(f)
  // An `if` with one branch `Nothing` is the other branch's type.
  i = 0
  val g = loop
    i += 1
    println(identity(if i > 3 then break i * 10 else i))
  println(g)
  // `Nothing` inside a tuple or a collection literal given to a generic.
  val h = loop
    println(pair((break 11, 2), 3))
  println(h)
  val k = loop
    println(firstOf([1, break 12]))
  println(k)
  // A lambda whose body never finishes yields `Nothing`.
  val m = loop
    if i > 0 then break 13 else apply(() -> fail("never"))
  println(m)
  // An expected type still decides the type argument.
  val n = loop
    val wide: long = identity(break 14)
  println(n)
  // A generic method and a generic constructor.
  val o = loop
    Holder(1).keep(break 15)
  println(o)
  val p = loop
    Some(break 16)
  println(p)
  // A by-name argument that never finishes is not evaluated.
  println(lazily(fail("never"), false))
  // `continue` as an argument.
  i = 0
  val q = while i < 5 do
    i += 1
    if i < 4 then println(identity(continue)) else break i
  else -1
  println(q)
