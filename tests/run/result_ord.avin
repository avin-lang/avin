// expect: exit 0
// `Result[T, E]` is `Ord` when `T` and `E` are, ordered as an `Either` is with `Err` in place of `Left`:
// every `Err` before every `Ok`, and two on the same side as their values.

data Point(x: int, y: int) derives Ord

data Job(name: string, outcome: Result[int, string]) derives Ord

smaller[T: Ord](a: T, b: T) -> T = if a.compare(b) <= 0 then a else b

sign(n: int) -> int = if n < 0 then -1 elif n > 0 then 1 else 0

main()
  val ok1: Result[int, string] = Ok(1)
  val ok2: Result[int, string] = Ok(2)
  val okLow: Result[int, string] = Ok(-2147483647 - 1)
  val ea: Result[int, string] = Err("a")
  val eb: Result[int, string] = Err("b")
  val eEmpty: Result[int, string] = Err("")

  println(s"${sign(ea.compare(ok1))} ${sign(ok1.compare(ea))} ${sign(ok1.compare(ok1))} ${sign(ea.compare(ea))}")
  println(s"${sign(ok1.compare(ok2))} ${sign(ok2.compare(ok1))} ${sign(ea.compare(eb))} ${sign(eb.compare(ea))}")
  println(s"${eb < okLow} ${eEmpty < ea} ${okLow < ok1} ${ok1 > eb} ${ok1 >= ok1} ${ea <= ea}")
  println(s"${ok1 < ea} ${ok1 <= ea} ${ea > ok1} ${ea >= ok1}")

  val mixed: Vector[Result[int, string]] = [ok2, eb, ok1, ea, ok2, eEmpty, okLow]
  println(mixed.sorted)
  println(mixed.sortWith((a, b) -> b.compare(a)))
  println(mixed.toList.sorted)
  val empty: Vector[Result[int, string]] = []
  println(empty.sorted)
  println(Vector[Result[int, string]](ea).sorted)
  println(mixed.sortBy(r -> r))
  println(s"${mixed.max} ${mixed.min} ${mixed.maxOption} ${mixed.minOption} ${empty.minOption}")
  println(s"${max(ok1, ea, ok2)} ${min(ok1, ea, ok2)} ${max(ea, eb)} ${min(ok1, ok2)}")

  // Both type arguments the same: an Err still precedes an Ok.
  val s1: Result[int, int] = Ok(0)
  val s2: Result[int, int] = Err(99)
  println(s"${s2 < s1} ${s1 > s2}")

  // Tuples, options and results nested.
  val t1: Result[(int, int), (string, int)] = Ok((1, 5))
  val t2: Result[(int, int), (string, int)] = Ok((1, 6))
  val t3: Result[(int, int), (string, int)] = Err(("z", 0))
  val t4: Result[(int, int), (string, int)] = Err(("z", 1))
  println(s"${t3 < t4} ${t4 < t1} ${t1 < t2} ${t3 < t2}")
  println(Vector(t2, t1, t4, t3).sorted)
  val o1: Result[Option[int], int] = Ok(Some(0))
  val o2: Result[Option[int], int] = Ok(None)
  val o3: Result[Option[int], int] = Err(5)
  println(Vector(o1, o2, o3).sorted)
  val n0: Option[Result[int, int]] = None
  val n1: Option[Result[int, int]] = Some(Err(5))
  val n2: Option[Result[int, int]] = Some(Ok(0))
  println(Vector(n2, n1, n0).sorted)
  val d1: Result[Result[int, int], int] = Ok(Ok(0))
  val d2: Result[Result[int, int], int] = Ok(Err(3))
  val d3: Result[Result[int, int], int] = Err(9)
  println(Vector(d1, d2, d3).sorted)

  // Against an either's order: Left and Err are alike, Right and Ok are alike.
  val e: Either[int, int] = Left(1)
  val r: Result[int, int] = Err(1)
  println(s"${e < Right(0)} ${r < Ok(0)}")

  // Derived Ord with a result field, and data in a result.
  println(Vector(Job("b", ok1), Job("a", ea), Job("a", ok1), Job("a", eb)).sorted)
  val p1: Result[Point, Point] = Ok(Point(1, 2))
  val p2: Result[Point, Point] = Err(Point(9, 9))
  println(s"${p1 > p2} ${Err(Point(1, 1)) < Err(Point(1, 2))}")

  val tree = TreeMap((ok2, "x"), (ea, "y"), (ok1, "z"))
  println(tree)
  println(TreeSet(ok1, ea, ok1, eb))
  println(s"${smaller(ok1, ea)} ${smaller(ok1, ok2)} ${smaller(eb, ea)}")
