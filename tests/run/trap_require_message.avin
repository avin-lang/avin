// expect: trap
// A failed `require` with a message builds it then, once, from what the call captured, and names it
// at the call inside a lambda handed to a library function.

var built = 0

describe(x: int, limit: int) -> string
    built += 1
    s"$x is at most $limit, ✓ ünïcode, built $built"

main()
    val limit = 2
    val xs = [1, 2, 3]
    val ys = xs.map(x -> require(x <= limit, describe(x, limit)))
    println(ys.length)
