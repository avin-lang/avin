// expect: exit 0
// Every kind of member survives every storage place unchanged: each integer width at its least and
// greatest value (wider than 64 bits included, kept boxed), a real's NaN and negative zero, a `char` at
// the ends of its range, a `byte`, a `bool`, `unit`, an empty and a non-ASCII string, an object of a
// class, a data value, an `Option` and a nested union flattened into its outer one. Each value is
// stored in a field, an array, a module-level `var`, a closure and a captured `var`, read back, and
// compared with what was stored by `==`, by the hash and by its rendering.

class Dog(name: string) derives Eq, Hash, Display

data Shape
  Circle(r: real)
  Square(side: int)

class Field[T](var held: T)

type Flag = int | bool

var global8: i8 | string = ""
var globalWide: i128 | bool = false
var globalReal: real | char = 'a'
var globalMixed: i16 | long | char | string = ""

// Stores `x` in every place and reads it back from each, checking each copy against `x`.
roundTrip[T: Display](label: string, x: T)
  val field = Field[T](x)
  val arr: Array[T] = Array.fill(2, x)
  arr(1) = field.held
  var boxed = arr(0)
  val f = () -> boxed
  boxed = arr(1)
  val captured = f()
  val same = captured == x && field.held == x && arr(1) == x && captured.hash() == x.hash()
  println(s"$label: $captured ${s"$captured" == s"$x"} $same")

main()
  roundTrip[i8 | string]("i8 min", i8(-128))
  roundTrip[i8 | string]("i8 max", i8(127))
  roundTrip[i16 | string]("i16 min", i16(-32768))
  roundTrip[i16 | string]("i16 max", i16(32767))
  roundTrip[int | string]("int min", -2147483648)
  roundTrip[int | string]("int max", 2147483647)
  roundTrip[long | string]("long min", long(-9223372036854775807) - 1)
  roundTrip[long | string]("long max", long(9223372036854775807))
  roundTrip[i33 | bool]("i33 min", i33(-4294967296))
  roundTrip[i65 | bool]("i65 min", i65(-18446744073709551616))
  roundTrip[i128 | string]("i128 max", i128(170141183460469231731687303715884105727))
  roundTrip[i128 | int]("i128 min", i128(-170141183460469231731687303715884105728))
  roundTrip[i128 | int]("int beside i128", -1)
  roundTrip[byte | string]("byte", byte(255))
  roundTrip[real | string]("negative zero", -0.0)
  roundTrip[real | string]("infinity", 1.0 / 0.0)
  roundTrip[char | string]("char min", '\u{0}')
  roundTrip[char | string]("char max", '\u{10FFFF}')
  roundTrip[bool | string]("bool", true)
  roundTrip[unit | string]("unit", ())
  roundTrip[int | string]("empty string", "")
  roundTrip[int | string]("non-ASCII string", "héllo, 世界")
  roundTrip[int | Dog]("class", Dog("rex"))
  roundTrip[bool | Shape]("data", Square(4))
  roundTrip[long | Option[string]]("option", Some("x"))
  roundTrip[long | Option[string]]("none", None)
  roundTrip[Flag | string]("nested flattened", false)
  // A NaN is never `==` to itself, so it is checked by its bits.
  val nan: real | string = 0.0 / 0.0
  val field = Field[real | string](nan)
  val arr: Array[real | string] = Array.fill(1, nan)
  for u in [field.held, arr(0)]
    u match
      r: real -> println(s"NaN kept: ${r.isNaN}")
      s: string -> println(s)
  // Module-level variables of each kind, replaced in turn.
  global8 = i8(-128)
  println(global8)
  global8 = "eight"
  println(global8)
  globalWide = i128(-170141183460469231731687303715884105728)
  println(globalWide)
  globalWide = true
  println(globalWide)
  globalReal = -0.0
  println(globalReal)
  globalReal = '\u{10FFFF}'
  println(globalReal == '\u{10FFFF}')
  globalMixed = i16(-32768)
  println(globalMixed)
  globalMixed = long(-9223372036854775807) - 1
  println(globalMixed)
  globalMixed = 'é'
  println(globalMixed)
  globalMixed = "mixed"
  println(globalMixed)
