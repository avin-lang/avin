// expect: exit 0
// A `var` field of a class bounding a type parameter is assigned through a value of that parameter
// as on an instance of the class: plain and compound assignment, the yielding forms, fields the
// bound inherits, a generic class bound, several bounds, from a lambda and a local function, and
// through an expression that is not a local. The caller's object sees every store.

open class Base
  var n = 0

class Derived: Base
  var extra = 7

bump[T: Base](x: T)
  val before = x.n
  x.n = before + 1

compound[T: Base](x: T)
  x.n += 10
  x.n -= 3
  x.n *= 4
  x.n /= 2
  x.n %= 9
  x.n |= 16
  x.n &= 23
  x.n ^= 5
  x.n <<= 2
  x.n >>= 1
  x.n +%= 1

yielding[T: Base](x: T) -> int
  val a = x.n := 100
  val b = x.n +:= 5
  a + b

open class Root
  var depth = 1

open class Middle: Root
  var label = "m"

class Leaf: Middle

deepen[T: Middle](x: T)
  x.depth += 1
  x.label = x.label + "!"

open class Box[A](var value: A)

class IntBox(v: int): Box[int](v)

setBox[T: Box[int]](b: T, v: int)
  b.value = v
  b.value += 1

trait Named
  name() -> string

class Tagged(val tag: string): Base, Named
  override name() -> string = tag

both[T: Base & Named](x: T) -> string
  x.n += x.name().byteLength
  x.name()

inLambda[T: Base](x: T)
  val f = () -> x.n += 2
  f()
  f()

inLocal[T: Base](x: T)
  step(by: int)
    x.n += by
  step(3)
  step(4)

same[T](x: T) -> T = x

throughCall[T: Base](x: T)
  same(x).n = 50
  same(x).n += 1

main()
  val b = Base()
  bump(b)
  bump(b)
  println(b.n)

  val d = Derived()
  bump(d)
  println(d.n)
  println(d.extra)

  val c = Base()
  compound(c)
  println(c.n)

  val y = Base()
  println(yielding(y))
  println(y.n)

  val leaf = Leaf()
  deepen(leaf)
  deepen(leaf)
  println(leaf.depth)
  println(leaf.label)

  val box = IntBox(1)
  setBox(box, 41)
  println(box.value)
  val plain = Box(0)
  setBox(plain, -1)
  println(plain.value)

  val t = Tagged("héllo")
  println(both(t))
  println(t.n)

  val l = Base()
  inLambda(l)
  println(l.n)

  val f = Derived()
  inLocal(f)
  println(f.n)

  val w = Base()
  throughCall(w)
  println(w.n)
