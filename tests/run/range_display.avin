// expect: exit 0

// A range displays as it is written: `1..5`, `0..<10`, and `by` and the step where the step is not
// 1. Its `Debug` form is the same, `println` and interpolation show it, and a field width pads it.
data Span(r: Range)

main()
  println(1 .. 5)
  println(0 ..< 10)
  println(0 ..< 10 by 2)
  println(10 .. 1 by -3)
  println(-5 .. -1)
  println(0 ..< 0)
  println(3 .. 1)
  println(int.MinValue .. int.MaxValue)
  println(0 ..< int.MaxValue by 1000000000)
  // The bounds are shown as given, not as the last value reached.
  println(1 .. 10 by 4, (1 .. 10 by 4).last)
  val r = 1 .. 5
  println(s"[$r] [${0..<3}] [${r by 2}]")
  println(r.toString(), (2 ..< 4).toString().charCount)
  println(f"[${r}%8s] [${r}%-8s] [${r}%?] [${r}%6?]")
  println(debug(1 ..< 4 by 2))
  // Through `Any`, a `Seq` and a trait, as the type it has when the program runs.
  val q: Seq[int] = 2 .. 4
  val i: Iterable[int] = 0 ..< 2
  val a: Any = 7 .. 7
  println(q, i, a)
  println([1 .. 2, 3 ..< 4])
  println(Some(1 .. 3), (0 ..< 1, "x"), Span(5 .. 6))
  println(debug([1 .. 2]))
  // A range of another integer type displays the same way.
  val lo: long = 1
  println(lo .. 5, lo ..< 9 by 4)
  val small: i8 = -3
  println(small .. small, debug(small ..< 0))
  println(s"${lo..lo}")
  // What a range makes of itself is a vector, and displays as one.
  println(r.map(x -> x * 2), r.reverse, r.drop(0))
