// expect: trap
// The wall-clock span from `DateTime.Min` to `DateTime.Max` is longer than a `Duration` holds, and
// traps as an integer overflow does; a span just inside it does not.
import avin.time.{DateTime, dateTime}

main()
  println(dateTime(2026, 1, 1, 0, 0) - dateTime(1970, 1, 1, 0, 0))
  println(DateTime.Max - DateTime.Min)
