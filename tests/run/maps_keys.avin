// expect: exit 0
// Any type is a key, found by its own hash and `==`: strings sharing long prefixes, tuples, data
// values compared field by field, a class with its own `equals` and `hash`, a class compared by
// identity, and keys whose hashes are all equal, which share one collision in the immutable map and
// one run of slots in the mutable one.

import avin.collections.mutable.{Map as MutableMap}

data Point(x: int, y: int)

class Name(val text: string)

impl Eq for Name
    equals(other: Name) -> bool = text == other.text

impl Hash for Name
    hash() -> long = text.hash()

class Handle(val id: int)

// Every value hashes alike, so only `==` tells them apart.
class Clash(val n: int)

impl Eq for Clash
    equals(other: Clash) -> bool = n == other.n

impl Hash for Clash
    hash() -> long = 42

main()
    var byPrefix = Map[string, int]()
    val mutablePrefix = MutableMap[string, int]()
    for i in 0..<200
        byPrefix = byPrefix.updated(s"a-long-common-prefix-$i", i)
        mutablePrefix(s"a-long-common-prefix-$i") = i
    var ok = true
    for i in 0..<200
        if byPrefix(s"a-long-common-prefix-$i") != i || mutablePrefix(s"a-long-common-prefix-$i") != i then ok = false
    println(s"$ok ${byPrefix.size()} ${mutablePrefix.size()} ${byPrefix.contains("a-long-common-prefix-200")}")

    val grid = Map[(int, int), string]().updated((1, 2), "a").updated((2, 1), "b").updated((1, 2), "c")
    println(s"${grid.size()} ${grid((1, 2))} ${grid((2, 1))} ${grid.get((3, 3)).isEmpty()}")

    val points = MutableMap[Point, int]()
    points(Point(1, 2)) = 3
    points(Point(1, 2)) += 4
    println(s"${points.size()} ${points(Point(1, 2))} ${points.contains(Point(2, 1))}")

    val names = Map[Name, int]().updated(Name("ada"), 1).updated(Name("ada"), 2).updated(Name("bob"), 3)
    println(s"${names.size()} ${names(Name("ada"))} ${names(Name("bob"))}")

    val h = Handle(1)
    val handles = MutableMap[Handle, string]()
    handles(h) = "first"
    handles(Handle(1)) = "second"
    println(s"${handles.size()} ${handles(h)} ${handles.contains(Handle(1))}")

    var clashes = Map[Clash, int]()
    val mutableClashes = MutableMap[Clash, int]()
    for i in 0..<20
        clashes = clashes.updated(Clash(i), i * i)
        mutableClashes(Clash(i)) = i * i
    clashes = clashes.updated(Clash(5), -5)
    var sum = 0
    for i in 0..<20 do sum += clashes(Clash(i)) + mutableClashes(Clash(i))
    println(s"${clashes.size()} ${mutableClashes.size()} $sum")
    for i in 0..<19
        clashes = clashes.removed(Clash(i))
        mutableClashes.remove(Clash(i))
    println(s"${clashes.size()} ${mutableClashes.size()} ${clashes(Clash(19))} ${mutableClashes(Clash(19))} ${clashes.contains(Clash(0))}")
    println(s"${clashes.removed(Clash(19)).isEmpty()} ${clashes == Map[Clash, int]().updated(Clash(19), 361)}")
