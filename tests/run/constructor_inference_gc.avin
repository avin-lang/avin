// expect: exit 0
// Values of `F[A]` made and dropped in bulk through constructors that are inferred rather than
// written, under covariant and bounded holes, so the collector runs while instances at `Vector`,
// `Option`, `TreeSet` and `List` hold them: in fields, in closures and across calls.
open class Animal(val name: string)

class Dog(name: string): Animal(name)

same[F[_], A](x: F[A]) -> F[A] = x

widen[F[+_]](d: F[Dog]) -> F[Animal] = d

ordered[F[_: Ord], A: Ord](x: F[A]) -> F[A] = x

class Keeper[F[+_]](var kept: F[Animal])
  replace(d: F[Dog]) = kept = widen(d)

later[F[_], A](x: F[A]) -> () -> F[A] = () -> same(x)

main()
  var made: Vector[Vector[string]] = []
  for i in 0 ..< 2000
    made = made :+ same([s"a$i", s"b$i"])
  println(made(1999))
  val k = Keeper[List](List(Dog("first")))
  for i in 0 ..< 1000
    k.replace(List(Dog(s"dog $i")))
  println(k.kept.map(a -> a.name))
  var sets: Vector[TreeSet[int]] = []
  for i in 0 ..< 500
    sets = sets :+ ordered(TreeSet(i, i - 1, i + 1))
  println(sets(499))
  var thunks: Vector[() -> Option[Animal]] = []
  for i in 0 ..< 1000
    val d: Option[Dog] = if i % 3 == 0 then Some(Dog(s"d$i")) else None
    thunks = thunks :+ later(widen(d))
  var named = 0
  for t in thunks
    if t() is Some(_) then named += 1
  println(named)
