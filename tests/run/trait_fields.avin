// expect: exit 0
// A trait may declare fields with values, `val` and `var`, which every class and object conforming
// to it stores. The trait's methods read and assign them by bare name and through `self`; outside,
// they are read and assigned through the class's type and through the trait's, which reaches the
// field of the object's own class. A subclass stores them once, in its superclass.
data Position(line: int, column: int)

trait Positional
    var pos: Option[Position] = None
    at(line: int, column: int) = pos = Some(Position(line, column))
    where() -> string = self.pos match
        Some(p) -> s"${p.line}:${p.column}"
        None -> "nowhere"

class Token(val text: string): Positional

trait Counted
    var count: int = 0
    val step: int = 1
    bump() -> int
        count += step
        self.count

class Node(name: string): Positional, Counted
    val label = s"node $name with ${count} counted"

object Registry: Counted

open class Animal(val legs: int): Positional
class Dog: Animal(4)
    walk() = pos = Some(Position(legs, legs))

trait Ranked
    var rank: int = 1
    beats(other: Self) -> bool = rank > other.rank
    swap(other: Self) =
        rank, other.rank = other.rank, rank

class Player(val name: string): Ranked

best[T: Ranked](a: T, b: T) -> T = if a.beats(b) then a else b

abstract class Shape: Counted
    area() -> int

class Square(side: int): Shape
    override area() -> int
        bump()
        side * side

main()
    val t = Token("x")
    println(t.where())
    t.at(3, 4)
    println(t.where())
    t.pos = None
    println(t.where())
    val p: Positional = t
    p.pos = Some(Position(7, 8))
    println(t.where())
    println(p.pos.map((q) -> q.line).getOrElse(0))
    val n = Node("a")
    println(n.label)
    n.bump()
    n.bump()
    val k: Counted = n
    k.count += 10
    println(k.bump())
    println(n.count)
    println(k.count++)
    println(++k.count)
    println(k.count := 40)
    println(n.count)
    n.at(1, 1)
    println(n.where())
    Registry.bump()
    Registry.count *= 7
    println(Registry.count)
    val d = Dog()
    d.walk()
    println(d.where())
    val a: Animal = d
    println(a.where())
    val x = Player("x")
    val y = Player("y")
    y.rank = 5
    println(best(x, y).name)
    x.swap(y)
    println(s"${x.rank} ${y.rank}")
    println(best(x, y).name)
    val s: Shape = Square(3)
    println(s.area() + s.area())
    println(s.count)
