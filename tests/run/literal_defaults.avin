// expect: exit 0
// A default written as a literal takes the parameter's type, as the literal would written at the
// call: a narrow or wide integer, a negated number, a `byte`, a char, a string. A default that is not
// a literal is still computed at each call that leaves it out, from the parameters before it.
var calls = 0

counted() -> int =
    calls += 1
    calls

pick(a: i8 = -128, b: i128 = 170141183460469231731687303715884105727, c: byte = 0xff, d: real = -0.5, e: char = 'é', f: string = "\t|", g: int = counted(), h: int = int(a) + 1) -> string =
    s"$a $b $c $d $e $f $g $h"

data Box(n: long = -9223372036854775807, label: string = "box", size: int = n.toString().byteLength())

main()
    println(pick())
    println(pick(b = 1, g = 0))
    println(pick(5))
    println(Box(), Box(1), Box(label = "x"))
