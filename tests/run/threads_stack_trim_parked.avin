// expect: exit 0
// env: AVIN_GC_STRESS=0
// Two thousand threads each recurse ten thousand calls deep, return, and park. Once parked a while,
// each has given back the pages below where it parked, so together they hold a few pages each rather
// than the half mebibyte or more each reached. Woken, each recurses as deep again, on pages committed
// afresh, and gets the same answer.
import avin.process.{pid, residentBytes}
import avin.threads.{Channel, sleep, spawn}
import avin.time.millis

depth(n: int) -> int = if n == 0 then 0 else 1 + depth(n - 1)

resident() -> long = residentBytes(pid()).ok.get

main() -> int
  val n = 2000
  val gate = Channel[int]()
  val parked = Channel[int]()
  val before = resident()
  val threads = (0 ..< n).map(i ->
    spawn(() ->
      val first = depth(10000)
      parked.send(first)
      _ = gate.receive()
      depth(10000) == first && first == 10000)).toVector
  for i in 0 ..< n do _ = parked.receive()
  sleep(millis(300))
  val held = resident() - before
  println(held < long(n) * 131072)
  for i in 0 ..< n do gate.send(i)
  println(threads.forall(t -> t.join()))
  0
