// expect: exit 0
// The system library's `publish` example for copying and moving, run as written: the first publish
// makes `live`, the second keeps the first as `live.previous`, and the third replaces that.
import avin.fs
import avin.io.IoError

publish(build: string, live: string) -> Result[unit, IoError]
  val previous = live + ".previous"
  fs.removeIfExists(previous)?
  if fs.exists(live) then fs.move(live, previous)?
  fs.copyAll(build, live, attributes = true)

main()
  val dir = fs.createTempDir("avin-fs-copy-publish") match
    Ok(d) -> d
    Err(e) ->
      println(s"no directory: $e")
      return
  for round in [1, 2, 3]
    _ = fs.writeText(dir + "/build/index.html", s"release $round", createParents = true)
    println(publish(dir + "/build", dir + "/site"))
    println(
      s"${fs.readText(dir + "/site/index.html")} ${fs.readText(dir + "/site.previous/index.html").getOrElse("none")}"
    )
  println(fs.removeDirAll(dir))
