// expect: exit 0
// `string.fromUtf8` decodes bytes, refusing those that are not UTF-8 with the offset of the first bad
// sequence and whether the bytes merely end inside one; `string.fromUtf8Lossy` puts U+FFFD where such
// a sequence was. A string's own bytes always decode back to it.

bytesOf(values: Vector[int]) -> Array[byte] = values.map(v -> byte(v)).toArray()

show(values: Vector[int])
    string.fromUtf8(bytesOf(values)) match
        Ok(s) -> println(s"ok \"$s\" (${s.charCount()} chars)")
        Err(Utf8Error(offset, truncated)) -> println(s"error at $offset, truncated $truncated")

main()
    show([104, 105])
    show([])
    show([0xC3, 0xA9, 0x74, 0xC3, 0xA9])
    show([0xE2, 0x82, 0xAC])
    show([0xF0, 0x9F, 0x98, 0x80])
    // A continuation byte that begins nothing.
    show([0x61, 0x80, 0x62])
    // Bytes that end inside a sequence.
    show([0x61, 0x62, 0xE2, 0x82])
    show([0xF0, 0x9F])
    // An overlong encoding of '/', a surrogate, a value past U+10FFFF, and a byte no sequence begins with.
    show([0xC0, 0xAF])
    show([0x61, 0xED, 0xA0, 0x80])
    show([0xF4, 0x90, 0x80, 0x80])
    show([0x61, 0x62, 0x63, 0xFF])
    // A truncated sequence followed by more bytes is not truncated: no continuation could rescue it.
    show([0xE2, 0x82, 0x61])
    val err = string.fromUtf8(bytesOf([0xC3]))
    println(err == Err(Utf8Error(0, true)))
    println(string.fromUtf8Lossy(bytesOf([0x61, 0x80, 0x62])))
    println(string.fromUtf8Lossy(bytesOf([0x61, 0x62, 0xE2, 0x82])).charCount())
    println(string.fromUtf8Lossy(bytesOf([0xC0, 0xAF, 0x7A])) == "\u{FFFD}\u{FFFD}z")
    println(string.fromUtf8Lossy(bytesOf([0x6F, 0x6B])))
    println(string.fromUtf8Lossy(bytesOf([])).isEmpty())
    for text in ["", "plain", "naïve café", "€100", "😀 grin", "a\u{0}b"]
        val back = string.fromUtf8(text.bytes().toArray())
        println(back == Ok(text))
        println(string.fromUtf8Lossy(text.bytes().toArray()) == text)
    val cut: Array[byte] = [0x61, 0xE2, 0x82]
    println(string.fromUtf8(cut))
    println(string.fromUtf8("naïve".bytes().toArray()))
    // As a function value.
    val decode = string.fromUtf8Lossy
    println(decode(bytesOf([0x79, 0x65, 0x73])))
