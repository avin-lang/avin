// `Option` and `Result` of boundary types cross to Sysl and back, variant by variant, in parameters
// and results. `sysl.hint.black_box` hands back the value it is given, so each binding of it carries
// a value into Sysl and out again.

@sysl("sysl.path.parent")
parent(p: string) -> Option[string]

@sysl("sysl.path.extension")
extension(p: string) -> Option[string]

@sysl("sysl.hint.black_box")
optionString(o: Option[string]) -> Option[string]

@sysl("sysl.hint.black_box")
optionInt(o: Option[int]) -> Option[int]

@sysl("sysl.hint.black_box")
optionUnit(o: Option[unit]) -> Option[unit]

@sysl("sysl.hint.black_box")
optionChar(o: Option[char]) -> Option[char]

@sysl("sysl.hint.black_box")
optionBool(o: Option[bool]) -> Option[bool]

@sysl("sysl.hint.black_box")
optionReal(o: Option[real]) -> Option[real]

@sysl("sysl.hint.black_box")
optionByte(o: Option[byte]) -> Option[byte]

@sysl("sysl.hint.black_box")
optionNarrow(o: Option[i8]) -> Option[i8]

@sysl("sysl.hint.black_box")
optionOption(o: Option[Option[long]]) -> Option[Option[long]]

@sysl("sysl.hint.black_box")
result(r: Result[string, int]) -> Result[string, int]

@sysl("sysl.hint.black_box")
resultOption(r: Result[Option[string], string]) -> Result[Option[string], string]

@sysl("sysl.hint.black_box")
resultUnit(r: Result[unit, Option[bool]]) -> Result[unit, Option[bool]]

main()
    // Out of Sysl: a value and its absence.
    print(s"${parent("/usr/lib")} ${parent("/")} ${extension("notes.txt")} ${extension("notes")}")
    // Into Sysl and out again, both variants of each.
    print(s"${optionString(Some("wörld"))} ${optionString(Some(""))} ${optionString(None)}")
    print(s"${optionInt(Some(-7))} ${optionInt(Some(2147483647))} ${optionInt(None)}")
    print(s"${optionUnit(Some(()))} ${optionUnit(None)}")
    print(s"${optionChar(Some('λ'))} ${optionBool(Some(true))} ${optionBool(Some(false))} ${optionBool(None)}")
    print(s"${optionReal(Some(2.5))} ${optionByte(Some(byte(0xff)))} ${optionNarrow(Some(-128))}")
    print(s"${optionOption(Some(Some(9000000000)))} ${optionOption(Some(None))} ${optionOption(None)}")
    print(s"${result(Ok("fine"))} ${result(Err(-1))}")
    // An `Option[string]` nested in a `Result`, in each place it can be.
    print(s"${resultOption(Ok(Some("inner")))} ${resultOption(Ok(None))} ${resultOption(Err("outer"))}")
    print(s"${resultUnit(Ok(()))} ${resultUnit(Err(Some(true)))} ${resultUnit(Err(None))}")
    // What a binding makes is collected like any other value: many of them, each still whole.
    var kept: List[Result[Option[string], string]] = []
    var i = 0
    while i < 300
        kept = resultOption(Ok(Some(s"item $i"))) :: kept
        i += 1
    var whole = 0
    for r in kept
        r match
            Ok(Some(text)) -> if text.startsWith("item ") then whole += 1
            _ -> ()
    print(s"$whole")
    // A binding passed as a value converts as a direct call does.
    val f: Option[string] -> Option[string] = optionString
    val g: string -> Option[string] = parent
    print(s"${f(Some("via value"))} ${f(None)} ${g("/x/y")}")
