// expect: exit 0
// Option's iterator, knownSize and unzip, on Some and on None.

main()
  val some: Option[int] = Some(4)
  val none: Option[int] = None
  println(some.iterator().toList)
  println(none.iterator().toList)
  println(some.iterator().hasNext())
  println(none.iterator().hasNext())
  println(some.knownSize)
  println(none.knownSize)
  val pair: Option[(int, string)] = Some((1, "a"))
  val (l, r) = pair.unzip
  println(s"$l $r")
  val nothing: Option[(int, string)] = None
  val (nl, nr) = nothing.unzip
  println(s"$nl $nr")
  for x in some do println(s"for $x")
  for x in none do println("unreachable")
