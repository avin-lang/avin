// expect: trap
// Writing an array the program moved into a `ByteBlock` reads the array, so it traps at the write.
import avin.actors.Isolated
import avin.c.ByteBlock

main()
  val block = ByteBlock(4)
  val a = Array.fill[byte](2, byte(1))
  block.write(0, a)
  val moved = Isolated.move(a)
  println("moved")
  block.write(2, a)
  println(moved.take().length)
