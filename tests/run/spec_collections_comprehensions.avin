// expect: exit 0
// `for` comprehensions over every kind of source: the first source deciding the result's kind (a
// list, an array, a buffer, a deque, a set, an option, a range, a map, a mutable set), later
// generators drawing from other kinds, a type of the program's own with `map`, `flatMap` and
// `withFilter`, guards interleaving with the yielded values, definitions evaluated for every element
// before the guard after them, and loop bindings captured by closures one element each.
import avin.collections.mutable.{Set as MutableSet}

class Box(val items: Vector[int])
    map(f: (int) -> int) -> Box = Box(items.map(f))
    flatMap(f: (int) -> Box) -> Box = Box(items.flatMap(x -> f(x).items))
    withFilter(p: (int) -> bool) -> Box = Box(items.filter(p))

say(log: Buffer[string], s: string, result: bool) -> bool
    log.append(s)
    result

tripled(log: Buffer[string], x: int) -> int
    log.append(s"def $x")
    x * 3

main()
    val l: List[int] = for x in List(1, 2, 3) if x != 2 yield x * 10
    val a: Array[string] = for x in Array.fill(2, 7) yield x.toString()
    val buf: Buffer[int] = [1, 2].toBuffer()
    val bb: Buffer[int] = for x in buf, y in List(10, 20) yield x + y
    val dq: Deque[int] = [3]
    val dd: Deque[int] = for x in dq yield -x
    val s: Set[int] = for x in {1, 2, 3}, y in [0, 0] yield x % 2
    val o: Option[int] = for x in Some(4), y in Some(5) if x < y yield x * y
    val none: Option[int] = for x in Some(4) if x > 9 yield x
    val r: Vector[int] = for x in 1..3 yield x * x
    val m: Map[string, int] = for (k, v) in {"a": 1, "b": 2} if v > 1 yield (k + k, v)
    val ms = MutableSet[int]()
    ms += 5
    val msOut: MutableSet[int] = for x in ms yield x + 1
    println(s"$l ${a.toList} ${bb.toList} ${buf.toList} ${dd.toList} $s $o $none $r $m ${msOut.toList} ${ms.toList}")

    val box = for x in Box([1, 2, 3]) if x > 1, y in Box([x, 100]) yield x + y
    println(box.items)

    val log = Buffer[string]()
    val out = for x in [1, 2, 3] if say(log, s"test $x", x != 2) yield
        log.append(s"yield $x")
        x
    println(s"$out ${log.mkString(", ")}")
    val log2 = Buffer[string]()
    val defs = for x in [1, 2], y = tripled(log2, x) if say(log2, s"guard $y", true) yield y
    println(s"$defs ${log2.mkString(", ")}")

    val fs = Buffer[() -> int]()
    for i in 0..<3 do fs.append(() -> i)
    for x in [10, 20] do fs.append(() -> x)
    println(fs.map(f -> f()).toList)
    val grid = for
        row in 0 ..< 3
        if row % 2 == 0
        col in 0 ..< 2
        cell = row * 2 + col
    yield cell * cell
    println(grid)
    val again = for x in [1, 2], x in [x * 10] yield x
    println(again)
    val empty: List[int] = for x in List[int](), y in [1] yield x + y
    println(empty)
