// expect: exit 0
// The Sysl handles a cancelled thread's body reached are handed back once the scope has waited for it,
// as a body that returns hands them back itself: the code after the scope uses a connection the
// cancelled thread held, writes to it and closes it. So does the code after a scope whose thread was
// started already cancelled and never ran, and after one that returned normally.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.threads.{scope, sleep}
import avin.time.hours

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

main()
  val l = ok(TcpListener.bind("127.0.0.1", 0))
  val c = ok(TcpStream.connect("127.0.0.1", l.port()))
  val s = ok(l.accept())
  val t = scope(sc ->
    val t = sc.spawn(() ->
      ok(c.writeText("from the thread\n"))
      sleep(hours(1))
      ok(c.writeText("never\n")))
    println(ok(s.readLine()))
    sc.cancel()
    t)
  println(t.result())
  ok(c.writeText("after the cancelled scope\n"))
  println(ok(s.readLine()))
  val never = scope(sc ->
    sc.cancel()
    sc.spawn(() -> ok(c.writeText("never\n"))))
  println(never.result())
  ok(c.writeText("after the scope that ran nothing\n"))
  println(ok(s.readLine()))
  val wrote = scope(sc -> sc.spawn(() -> ok(c.writeText("finished\n"))))
  println(wrote.result())
  println(ok(s.readLine()))
  _ = c.close()
  println("closed")
