// expect: exit 0
// Local functions and local values of other blocks may share a name, and a lambda bound to a value
// whose name differs from every local function is unaffected.

shadowsInInnerBlock() -> int
  f() -> int = 1
  val inner = if true
    val f = 5
    f
  else 0
  inner + f()

siblingBlocks() -> int
  val a = if true
    g() -> int = 10
    g()
  else 0
  val b = if true
    val g = 20
    g
  else 0
  a + b

overloads() -> int
  add(x: int) -> int = x + 1
  add(x: int, y: int) -> int = x + y
  add(1) + add(2, 3)

lambdas() -> int
  twice(x: int) -> int = x * 2
  val inc = (x: int) -> x + 1
  inc(twice(3))

parameter(f: int) -> int
  f() -> int = 7
  f()

main() -> int
  if shadowsInInnerBlock() != 6 then return 1
  if siblingBlocks() != 30 then return 2
  if overloads() != 7 then return 3
  if lambdas() != 7 then return 4
  if parameter(9) != 7 then return 5
  0
