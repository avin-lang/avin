// expect: trap
// A `Metrics`' latency buckets are in increasing order: one equal to the bucket before it traps where
// the `Metrics` is made, after ones in order were taken.
import avin.net.http.Metrics
import avin.time.millis

main()
  println(Metrics([millis(1), millis(2)]).buckets)
  println(Metrics([millis(1), millis(5), millis(5)]).buckets)
