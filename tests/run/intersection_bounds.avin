// expect: exit 0
// A type parameter bounded by `A & B` conforms to both: its values have every bound's members,
// pass as each bound's type, and each instance calls its own type argument's implementations.
trait Named
  name() -> string

trait Sized
  size() -> int

trait Weighed
  weigh(scale: int) -> int

trait Tagged: Named
  tag() -> string = s"<${name()}>"

trait Source[A]
  next() -> Option[A]

trait ByCount
  say(n: int) -> string

trait ByText
  say(s: string) -> string

data Note(text: string)

impl Named for Note
  name() -> string = text

impl Sized for Note
  size() -> int = text.charCount

impl Weighed for Note
  weigh(scale: int) -> int = scale * text.charCount

impl ByCount for Note
  say(n: int) -> string = s"count $n"

impl ByText for Note
  say(s: string) -> string = s"text $s"

class Counter(var n: int): Source[int], Tagged, Sized
  override next() -> Option[int]
    if n == 0 then return None
    n -= 1
    Some(n)
  override name() -> string = "counter"
  override size() -> int = n

open class Animal(val legs: int)
  sound() -> string = "..."

class Dog: Animal(4), Named
  override sound() -> string = "woof"
  override name() -> string = "dog"

class Cat: Animal(4), Named
  override sound() -> string = "meow"
  override name() -> string = "cat"

// Two bounds, and three.
two[T: Named & Sized](x: T) -> string = s"${x.name()}:${x.size()}"

three[T: Named & Sized & Weighed](x: T) -> string = s"${x.name()} ${x.size()} ${x.weigh(3)}"

// A generic trait among the bounds, its argument inferred from the value passed.
drain[S: Source[A] & Tagged, A: Display](s: S) -> string
  var out = s.tag()
  loop
    s.next() match
      Some(v) -> out = s"$out $v"
      None -> break
  out

// Methods of one name from two bounds are overloads, told apart by their parameter types.
talk[T: ByCount & ByText](x: T) -> string = x.say(1) + ", " + x.say("a")

// A closure captures a bounded value and calls both bounds' methods.
later[T: Named & Sized](x: T) -> () -> string = () -> s"${x.name()}/${x.size()}"

// The core traits: `<` from `Ord`, interpolation from `Display`.
ordered[T: Ord & Display](a: T, b: T) -> string = if a < b then s"$a<$b" else s"$b<=$a"

// A class among the bounds: its methods dispatch on the object, a trait's beside them.
voice[T: Animal & Named](x: T) -> string = s"${x.name()} says ${x.sound()} on ${x.legs} legs"

// A value of `T` is a value of each bound's type.
describe(n: Named) -> string = s"named ${n.name()}"
measure(s: Sized) -> int = s.size()
asBoth[T: Named & Sized](x: T) -> string = s"${describe(x)} ${measure(x)}"

// A bounded function calls one that needs fewer of its bounds, and one that needs them in another order.
fewer[T: Sized](x: T) -> int = x.size() * 2
reordered[T: Sized & Named](x: T) -> string = s"${x.size()}${x.name()}"
forwards[T: Named & Sized & Weighed](x: T) -> string = s"${fewer(x)} ${reordered(x)} ${two(x)}"

// Bounds on a data type's, a class's and an impl's parameters.
data Labelled[T: Ord & Display](item: T)

impl[T: Ord & Display] Labelled[T]
  bigger(other: T) -> string = if item < other then s"$other" else s"$item"

class Shelf[T: Named & Sized](val items: List[T])
  total() -> int = items.foldLeft(0, (n, x) -> n + x.size())
  names() -> string = items.map(x -> x.name()).mkString(",")

data Pack[T](v: T)

impl[T: Ord & Display] Ord for Pack[T]
  compare(other: Pack[T]) -> int = if v < other.v then -1 elif other.v < v then 1 else 0

// A lower bound before the bounds, on a covariant class's method.
class Chain[+T](val items: List[T])
  joined[W >: T: Display & Ord](extra: W) -> string = s"${(extra :: items).max}"

// A trait's parameter bounded by two traits, met by a class's header.
trait Catalogue[T: Named & Sized]
  first() -> T
  summary() -> string = s"${first().name()}#${first().size()}"

class NoteCatalogue(val note: Note): Catalogue[Note]
  override first() -> Note = note

// Two bounds' methods of one signature are no error until a call is ambiguous.
trait Left
  label() -> string

trait Right
  label() -> string

uncalled[T: Left & Right](x: T) -> int = 1

// `Eq & Hash` admit every type.
keyed[K: Eq & Hash](a: K, b: K) -> string = if a == b then "same" else "different"

main()
  println(two(Note("memo")))
  println(two(Counter(3)))
  println(three(Note("abc")))
  println(drain(Counter(3)))
  println(talk(Note("q")))
  println(later(Note("hello"))())
  println(ordered(3, 2))
  println(ordered("b", "a"))
  println(ordered(2.5, 7.0))
  println(ordered(long.MaxValue, long.MinValue))
  println(ordered("é", "日本"))
  println(voice(Dog()))
  println(voice(Cat()))
  println(asBoth(Note("xy")))
  println(forwards(Note("four")))
  println(Labelled(5).bigger(9))
  println(Labelled("b").bigger("a"))
  val shelf = Shelf([Note("a"), Note("bb"), Note("")])
  println(s"${shelf.total()} ${shelf.names()}")
  println(s"${Pack(1) < Pack(2)} ${Pack("z") < Pack("a")}")
  println(Chain[int](List(1, 7)).joined(5))
  println(Chain[int](List()).joined(-3))
  println(NoteCatalogue(Note("cat")).summary())
  println(keyed(Note("a"), Note("a")))
  println(keyed(Dog(), Dog()))
  var sum = 0
  for i in 0 ..< 2000
    sum += two(Note(s"n$i")).charCount
  println(sum)
