// expect: exit 0
// An `Option[Nothing]` inside another value seen only as options kept as objects (of an `int`, of an
// option) is kept as an object, and the program's options of classes and strings stay pointers, so a
// bare `Option[Nothing]` written as one of those becomes null.

class Dog(val name: string) derives Display

val nones = [None, None]

nothing() -> Option[Nothing] = None

counts() -> Vector[Option[int]] = nones

layered() -> Result[Option[Option[Dog]], string] = Ok(nothing())

wrapped() -> Result[Option[Nothing], string] = Ok(None)

wideInt() -> Result[Option[long], string] = wrapped()

pick(n: int, d: Dog) -> Option[Dog] = if n > 0 then Some(d) else nothing()

named(n: int) -> Option[string] = if n > 0 then Some(s"n$n") else nothing()

main()
    val rex = Dog("rex")
    println(s"${counts()} ${counts().map(o -> o.getOrElse(7))} ${counts().map(o -> o.isEmpty)}")
    println(s"${layered()} ${wideInt()} ${wideInt().map(o -> o.getOrElse(9))}")
    println(s"${pick(1, rex)} ${pick(0, rex)} ${named(2)} ${named(0)} ${pick(0, rex) == nothing()}")
    val mixed: Vector[Option[int]] = counts() ++ [Some(1)]
    println(s"$mixed ${mixed.sorted} ${mixed(0) == mixed(1)} ${mixed(0).hash() == mixed(1).hash()}")
    // Written as an `Option[int]`, an `Option[Nothing]` is that option's own `None`, so as an `Any`
    // it equals any other `Option[int]`'s `None`, and an `Option[Nothing]`'s only through `==` on the
    // options themselves.
    val converted: Option[int] = nothing()
    val written: Option[int] = None
    val left: Any = converted
    val right: Any = written
    val bare: Any = nothing()
    println(s"${left == right} ${left == bare} ${converted == nothing()}")
