// expect: trap
// An upgrade names its protocol by a token: `websocket` and `h2c` make a `101` saying nothing else,
// and a name holding a space traps where the response is made.
import avin.net.http.Response

main()
  for p in ["websocket", "h2c"]
    val r = Response.upgrade(p, _ -> ())
    println(s"${r.status} ${r.reason} ${r.headers} ${r.body.length} ${r.upgraded.map(u -> u.protocol)}")
  println(Response.upgrade("websocket", _ -> ()).withHeader("X", "y").upgraded.isDefined)
  _ = Response.upgrade("web socket", _ -> ())
