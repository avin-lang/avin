// expect: exit 0
// A method defined by clauses matches its arguments, never its receiver, wherever it is declared: in
// an impl of a data type, of a generic one, of a built-in type, in an impl of a trait for a type, in
// a class, and as a static member, which has no receiver at all.

data Tree
    Leaf
    Node(left: Tree, value: int, right: Tree)

impl Tree
    label(n: int) -> string
    label(0) = "none"
    label(n < 0) = "negative"
    label(n) = s"$n of ${self.count()}"
    count() -> int = self match
        Leaf -> 0
        Node(l, _, r) -> l.count() + 1 + r.count()
    pair(a: int, b: bool) -> string
    pair(0, true) = "zero, yes"
    pair(_, b) = s"other, $b"

data Box[T]
    Box(item: T)

impl[T: Display] Box[T]
    show(prefix: string) -> string
    show("") = s"${self.item}"
    show(p) = s"$p${self.item}"

impl int
    static parity(n: int) -> string
    parity(n) | n % 2 == 0 = "even"
    parity(_) = "odd"
    sign(scale: int) -> int
    sign(0) = 0
    sign(k) = if self < 0 then -k else k

trait Grade
    grade(score: int) -> char

impl Grade for string
    grade(score: int) -> char
    grade(s >= 90) = 'A'
    grade(s >= 50) = 'B'
    grade(_) = 'C'

class Scale(factor: int)
    apply(n: int) -> int
    apply(0) = 0
    apply(n) = n * factor

trait Named
    static make(n: int) -> Self

class Item(val id: int): Named
    override static make(n: int) -> Item
    make(0) = Item(-1)
    make(n) = Item(n)

main() =
    val t = Node(Leaf, 1, Node(Leaf, 2, Leaf))
    println(s"${t.label(0)} ${t.label(-1)} ${t.label(5)}")
    println(s"${t.pair(0, true)} ${t.pair(0, false)} ${Leaf.pair(3, true)}")
    println(s"${Box(4).show("")} ${Box("x").show("> ")}")
    println(s"${int.parity(4)} ${int.parity(7)} ${(-3).sign(2)} ${3.sign(2)} ${3.sign(0)}")
    println(s"${"a".grade(95)}${"a".grade(60)}${"a".grade(10)}")
    val s = Scale(3)
    println(s"${s(0)} ${s(4)}")
    println(s"${Item.make(0).id} ${Item.make(8).id}")
