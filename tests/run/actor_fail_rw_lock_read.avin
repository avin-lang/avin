// expect: trap
// A trap while an actor reads a `RwLock` stops the program instead of failing the actor, whatever its
// supervision: the actor's share of the lock would otherwise be held for ever, keeping every writer
// out. The report still names the actor.
import avin.actors.{Stop, spawn}
import avin.threads.{Channel, RwLock}

actor Reader(shared: RwLock[Buffer[int]], done: Channel[int]) receives int
  receive
    n ->
      done.send(shared.read(b -> b(n)))

main()
  val shared = RwLock(Buffer[int]())
  shared.write(b -> b.append(7))
  val done = Channel[int]()
  val r = spawn(Reader(shared, done), onFailure = Stop)
  r.tell(0)
  println(done.receive())
  r.tell(5)
  println(done.receive())
  println("not reached")
