// expect: exit 0
// An option of a type whose values are references is kept as one pointer, and one of a value type
// as an object. Every method gives the same answers either way: each line is printed for an option
// of a class, a string, a data type, a tuple, a function, an array and `Any`, and of an `int`.

class Cat(val name: string) derives Display, Debug, Eq, Hash

data Shape
    Circle(radius: int)
    Square(side: int)

exercise[T](label: string, x: T, y: T, show: (T) -> string)
    val some: Option[T] = Some(x)
    val none: Option[T] = None
    val name: (T) -> string = v -> show(v)
    var out = s"$label: ${some.isDefined} ${some.isEmpty} ${none.isDefined} ${none.isEmpty}"
    out = out + s" ${show(some.getOrElse(y))} ${show(none.getOrElse(y))}"
    out = out + s" ${show(some.orElse(Some(y)).getOrElse(y))} ${show(none.orElse(Some(y)).getOrElse(x))}"
    out = out + s" ${some.map(name).getOrElse("-")} ${none.map(name).getOrElse("-")}"
    out = out + s" ${some.flatMap(v -> Some(show(v))).getOrElse("-")} ${some.flatMap(v -> None[string]).isEmpty}"
    out = out + s" ${some.filter(v -> true).isDefined} ${some.filter(v -> false).isDefined} ${none.filter(v -> true).isDefined}"
    out = out + s" ${some.withFilter(v -> true).isDefined} ${some.collect(match v -> show(v)).getOrElse("-")}"
    out = out + s" ${some.fold("empty", name)} ${none.fold("empty", name)}"
    var seen = 0
    some.foreach(v -> seen += 1)
    none.foreach(v -> seen += 10)
    out = out + s" $seen ${some.exists(v -> true)} ${none.exists(v -> true)} ${some.forall(v -> false)} ${none.forall(v -> false)}"
    out = out + s" ${some.contains(x)} ${some.contains(y)} ${none.contains(x)}"
    out = out + s" ${some.toList.length} ${none.toList.length} ${some.toVector.length} ${none.toArraySeq.length}"
    out = out + s" ${some.zip(Some(1)).isDefined} ${none.zip(Some(1)).isDefined} ${some.zip(None[int]).isDefined}"
    out = out + s" ${Some(some).flatten.isDefined} ${Some(none).flatten.isDefined} ${None[Option[T]].flatten.isDefined}"
    out = out + s" ${some == Some(x)} ${some == Some(y)} ${some == none} ${none == None[T]}"
    out = out + s" ${some.hash() == Some(x).hash()} ${none.hash() == None[T].hash()}"
    val described = some match
        Some(v) -> show(v)
        None -> "none"
    val absent = none match
        Some(v) -> show(v)
        None -> "none"
    println(out + s" $described $absent")

main()
    val tom = Cat("tom")
    val kit = Cat("kit")
    exercise("class", tom, kit, c -> c.name)
    exercise("string", "a", "b", s -> s)
    exercise("data", Circle(1), Square(2), s -> s"$s")
    exercise("tuple", (1, "x"), (2, "y"), t -> s"${t.0}${t.1}")
    val double: (int) -> int = n -> n * 2
    val triple: (int) -> int = n -> n * 3
    exercise("function", double, triple, f -> s"${f(5)}")
    val first = Array.fill(2, 7)
    val second = Array.fill(1, 8)
    exercise("array", first, second, a -> s"${a.length}")
    val anything: Any = tom
    val other: Any = "other"
    exercise("any", anything, other, a -> a match
        c: Cat -> c.name
        s: string -> s
        _ -> "?")
    exercise("int", 1, 2, n -> s"$n")

    // Display and Debug name the variant, and interpolation shows the value inside.
    val cat: Option[Cat] = Some(tom)
    val nobody: Option[Cat] = None
    val word: Option[string] = Some("hi")
    println(s"$cat $nobody $word ${debug(word)} ${debug(cat)} ${cat.toString()} ${nobody.toString()}")
    println(s"${Some(Circle(3))} ${Some((1, "two")).map(t -> t.1)} ${debug(None[string])}")

    // Equality is structural and the hash follows it, through values of unknown type too.
    val a: Any = Some(Cat("tom"))
    val b: Any = Some(Cat("tom"))
    val c: Any = None[Cat]
    println(s"${cat == Some(Cat("tom"))} ${a == b} ${a == c} ${a.hash() == b.hash()} ${c == None[Cat]}")
