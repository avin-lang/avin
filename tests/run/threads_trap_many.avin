// expect: trap
// Several threads trapping at once stop the program once: only the first of them reports, and the
// others wait for the end.
import avin.threads.spawn

divide(a: int, b: int) -> int = a / b

main() -> int
    println("before")
    var threads: List[avin.threads.Thread[int]] = []
    for i in 0..<6 do threads = spawn(() -> divide(i, 0)) :: threads
    for t in threads do println(t.join())
    0
