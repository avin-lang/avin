// expect: exit 0
// The state machine of the chapter: a machine starts in its first state, each arm's value is the
// next state, `stay` keeps the current one and its data, a guarded arm that fails falls through to
// the shared `receive` arms, and `Door.State` is an ordinary data type a program matches on.
data DoorEvent
  Open
  Close
  Lock(code: int)
  Unlock(code: int)

machine Door receives DoorEvent
  var opened = 0

  state Closed
    Open ->
      opened += 1
      Opened
    Lock(code) -> Locked(code)

  state Opened
    enter
      println("open")
    Close -> Closed

  state Locked(code: int)
    Unlock(c) if c == code -> Closed

  receive
    _ -> stay

describe(s: Door.State) -> string = s match
  Closed -> "closed"
  Opened -> "opened"
  Locked(code) -> s"locked with $code"

main() -> int
  val door = Door()
  println(door.state())
  println(door.handle(Open))
  println(door.handle(Close))
  println(door.handle(Lock(7)))
  // A wrong code fails the guard, so the shared arm keeps the state and its code.
  println(door.handle(Unlock(3)))
  println(door.handle(Open))
  println(describe(door.state()))
  println(door.handle(Unlock(7)))
  println(door.state() is Locked(_))
  println(door.state() is Closed)
  println(door.opened)
  // `handle` answers the new state, the one `state()` reads from then on.
  val s: Door.State = door.state()
  println(s == Closed)
  println(door.handle(Open) == door.state())
  println(door.opened)
  0
