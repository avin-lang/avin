// expect: trap
// Two threads each join the other, and `main` joins the first: a cycle of joins is a deadlock, and
// the report names each join.
import avin.threads.{Channel, Thread, spawn}

// Joins the thread `hand` gives, once it does.
joinGiven(hand: Channel[Thread[int]]) -> int = hand.receive() match
  Some(t) -> t.join() + 1
  None -> 0

main()
  val handOne = Channel[Thread[int]]()
  val handTwo = Channel[Thread[int]]()
  val one = spawn(() -> joinGiven(handOne))
  val two = spawn(() -> joinGiven(handTwo))
  handOne.send(two)
  handTwo.send(one)
  println("joining")
  println(one.join())
