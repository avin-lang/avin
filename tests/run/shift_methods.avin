// expect: exit 0
// A type other than the integers and bytes may have methods named `<<` and `>>`, which `a << b` and
// `a >> b` call at the shifts' own level, that of multiplication: tighter than `+` and `++`, `|`
// and the comparisons. `x <<= y` calls the target's method `<<=` where its type has one, and is otherwise
// `x = x << y`. On the integers and bytes the shifts stay the machine's.

// A parser term, shown as the expression it was built from.
class Term(val text: string)
  >>(f: string) -> Term = Term(s"($text >> $f)")
  <<(other: Term) -> Term = Term(s"($text << ${other.text})")
  ++(other: Term) -> Term = Term(s"($text ++ ${other.text})")
  |(other: Term) -> Term = Term(s"($text | ${other.text})")
  ~(other: Term) -> Term = Term(s"($text ~ ${other.text})")

// The name `>>>`, which is no operator of the language, is an ordinary symbol method.
data Bits(n: int)

impl Bits
  <<(k: int) -> Bits = Bits(n << k)
  >>(k: int) -> Bits = Bits(n >> k)
  >>>(k: int) -> Bits = Bits((n >> k) & 255)

class Log(var entries: Vector[string])
  <<=(entry: string)
    entries = entries :+ entry

trait Pipe
  >>(stage: string) -> Self

data Steps(names: Vector[string])

impl Pipe for Steps
  >>(stage: string) -> Steps = Steps(names :+ stage)

through[T: Pipe](p: T) -> T = p >> "parse" >> "check"

impl string
  <<(other: string) -> string = self + other

main()
  val a = Term("a")
  val b = Term("b")
  val c = Term("c")
  println((a >> "f" | b).text)
  println((a | b >> "f").text)
  println((a ++ b >> "f").text)
  println((a >> "f" ++ b).text)
  println((a >> "f" >> "g").text)
  println((a << b << c).text)
  println((a ~ b >> "f").text)
  println((a ~ b << c).text)
  println(s"${(Bits(3) << 2).n} ${(Bits(12) >> 1).n} ${(Bits(-1) >>> 4).n}")
  println(s"${(Bits(1) << 2).n == 4}")

  var t = Term("x")
  t >>= "f"
  t <<= Term("y")
  println(t.text)
  var bits = Bits(1)
  bits <<= 3
  println(s"${bits.n}")
  val log = Log([])
  log <<= "one"
  log <<= "two"
  println(s"${log.entries}")
  println(s"${through(Steps([])).names}")
  println("left" << "right")

  // The integers and bytes keep their shifts.
  val x = 1
  println(s"${x << 4} ${1 + 2 << 3} ${-16 >> 2} ${x << 2 | 1}")
  var n = 3
  n <<= 2
  println(s"$n")
