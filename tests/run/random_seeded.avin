// expect: exit 0
// A seeded generator is PCG32 on the reference implementation's stream: `Random(42)` gives the
// published sequence, and one seed gives one sequence for every method, again after `setSeed`.
import avin.random.Random

main()
    val g = Random(42)
    println(s"${g.nextInt()} ${g.nextInt()} ${g.nextInt()} ${g.nextInt()} ${g.nextInt()} ${g.nextInt()}")

    val a = Random(7)
    val b = Random(7)
    var same = true
    for i in 0..<1000 do if a.nextLong() != b.nextLong() then same = false
    println(same)
    println(Random(7).nextInt() == Random(8).nextInt())

    val c = Random(123)
    println(s"${c.nextInt(100)} ${c.nextLong(1000000000000)} ${c.between(1, 7)} ${c.between(long(-5), long(5))}")
    println(s"${c.nextReal()} ${c.between(2.0, 3.0)} ${c.nextBoolean()} ${c.nextGaussian()}")
    println(c.nextBytes(6))
    println(c.alphanumeric().take(12).mkString(""))
    println(c.shuffle([1, 2, 3, 4, 5, 6, 7, 8]))

    val first = Random(99)
    val x = first.nextLong()
    first.nextGaussian()
    first.setSeed(99)
    println(first.nextLong() == x)

    println(Random(0).nextLong())
    println(Random(-1).nextLong())
    println(Random(long.MinValue).nextInt())
