// expect: exit 42
// Data types with several variants, a one-line data type with field access, and matches over
// variants with and without fields.

data Shape
    Circle(radius: int)
    Rect(width: int, height: int)
    Empty

data Point(x: int, y: int)

area(s: Shape) -> int = s match
    Circle(r) -> 3 * r * r
    Rect(w, h) -> w * h
    Empty -> 0

describe(s: Shape) = s match
    Circle(_) -> print("circle")
    Rect(w, h) if w == h -> print("square")
    Rect(_, _) -> print("rectangle")
    Empty -> print("empty")

isEmpty(s: Shape) -> bool = s is Empty

main() -> int
    val p = Point(3, 4)
    val shapes = Rect(p.x, p.y)
    describe(Circle(1))
    describe(Rect(2, 2))
    describe(shapes)
    describe(Empty)
    if !isEmpty(Empty) || isEmpty(Circle(1)) then return 1
    if !(Circle(5) is Circle(_)) || Rect(1, 2) is Rect(2, _) then return 2
    // 12 + 12 + 0 + 18 = 42
    area(Circle(2)) + area(shapes) + area(Empty) + Point(10, 8).x + p.y * 2
