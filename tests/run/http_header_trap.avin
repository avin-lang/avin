// expect: trap
// A header's value holds no line break, which would end the header and begin another, so one that
// does traps where it is added.
import avin.net.http.Request

main()
  val r = Request("GET", "http://example.com/").withHeader("X-Ok", "fine")
  println(r.headers)
  println(r.withHeader("X-Bad", "a\r\nInjected: yes").headers)
