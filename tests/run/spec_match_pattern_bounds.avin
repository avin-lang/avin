// expect: exit 0
// Patterns at their bounds: `n + k` at the largest and smallest values without overflow, comparison
// patterns covering every int with no catch-all, ranges and comparisons on bytes and chars, type
// patterns comparing a generic class's type arguments exactly, comparison and alternative patterns
// nested in a constructor across lines, a named pattern, literals at an i8's limits, and a guard
// evaluated once per arm it reaches.

class Box[T](val item: T)

var guards = 0

counted(b: bool) -> bool
    guards += 1
    b

pred(n: int) -> int = n match
    m + 1 -> m
    _ -> -1

predLong(n: long) -> long = n match
    m + 3 -> m
    _ -> 0

bucket(n: int) -> string = n match
    n < 0 -> "negative"
    0 <= n < 10 -> "digit"
    n >= 10 -> "large"

bytes(b: byte) -> string = b match
    x < 16 -> "low"
    16 <= x <= 200 -> "mid"
    _ -> "high"

letter(c: char) -> string = c match
    'a' <= c <= 'z' -> "lower"
    'A'..'Z' -> "upper"
    '0'..<'9' -> "digit below nine"
    _ -> "other"

kind(x: Any) -> string = x match
    b: Box[int] -> s"int box ${b.item}"
    b: Box[string] -> s"string box ${b.item}"
    _: Box[bool] -> "bool box"
    _ -> "no box"

nested(o: Option[int]) -> string = o match
    Some(n > 0) -> "positive"
    Some(0) -> "zero"
    Some(-1 | -2
        | -3) -> "small negative"
    whole @ Some(_) -> s"other $whole"
    None -> "none"

wide(n: i8) -> string = n match
    -128 -> "min"
    127 -> "max"
    k + 100 -> s"over $k"
    _ -> "rest"

main()
    println(s"${pred(0)} ${pred(1)} ${pred(2147483647)} ${pred(-2147483648)}")
    println(s"${predLong(9223372036854775807)} ${predLong(2)}")
    println(s"${bucket(-2147483648)} ${bucket(0)} ${bucket(9)} ${bucket(10)} ${bucket(2147483647)}")
    println(s"${bytes(byte(0))} ${bytes(byte(15))} ${bytes(byte(16))} ${bytes(byte(200))} ${bytes(byte(255))}")
    println(s"${letter('a')} ${letter('z')} ${letter('Q')} ${letter('0')} ${letter('9')} ${letter('é')}")
    println(s"${kind(Box(3))} ${kind(Box("s"))} ${kind(Box(true))} ${kind(Box(1.5))} ${kind(4)}")
    println(s"${nested(Some(5))} ${nested(Some(0))} ${nested(Some(-3))} ${nested(Some(-9))} ${nested(None)}")
    println(s"${wide(-128)} ${wide(127)} ${wide(120)} ${wide(5)}")
    val r = 5 match
        n if counted(n > 10) -> "big"
        n if counted(n > 3) -> "mid"
        _ -> "small"
    println(s"$r $guards")
