// expect: exit 0
// The corners of filling a `using` section: a trailing block goes to the last parameter before the
// section; a by-name argument and a lambda are evaluated as without one; a section of several
// parameters fills each from its own given, in any mix with ones passed by name; a given of a generic
// instance fills only a parameter of that instance; a given of an object type and of a trait type;
// a given filled into a value-typed parameter; a delayed argument and a lambda written in the call
// resolve their own calls where they are written; and a filled call allocating under GC stress.

data Tx(id: int)

data Retries(count: int)

class Pool[T](items: Vector[T])
  size() -> int = items.length

trait Logger
  name() -> string

object Silent: Logger
  override name() -> string = "silent"

object SystemClock
  now() -> long = 42

tag(using tx: Tx) -> int = tx.id

times(n: int, action: -> unit, using tx: Tx)
  var i = 0
  while i < n + tx.id
    action
    i += 1

applyTo(f: (int) -> int, using tx: Tx) -> int = f(tx.id)

several(using tx: Tx, r: Retries, l: Logger) -> string = s"${tx.id} ${r.count} ${l.name()}"

strings(using p: Pool[string]) -> int = p.size()

ints(using p: Pool[int]) -> int = p.size() * 100

clockNow(using c: SystemClock) -> long = c.now()

delayed(value: -> int, using tx: Tx) -> int = value + tx.id

fill(n: int, using tx: Tx) -> Vector[string]
  if n == 0 then return []
  val rest = fill(n - 1)
  rest :+ s"${n + tx.id}"

main()
  given tx = Tx(1)
  given r = Retries(3)
  given l: Logger = Silent
  given ps = Pool(["a", "b"])
  given pi = Pool([1, 2, 3])
  given c = SystemClock
  var ticks = 0
  times(2)
    ticks += 1
  println(ticks)
  println(applyTo(x -> x + tag()))
  println(several())
  println(several(r = Retries(9)))
  println(several(l = Silent, tx = Tx(5)))
  println(strings())
  println(ints())
  println(clockNow())
  println(delayed(tag() * 10))
  println(fill(300).length)
  println(fill(3))
