// expect: exit 0
// A trait's static member may have a default body, compiled for each type implementing the trait that
// gives none, with `Self` that type. A type's own body replaces it. It is reached on the type's name,
// through a bound by the trait, and through a bound by a trait requiring it; it may call another
// static member on `Self`, which is then the type's own; and it serves a generic type, a built-in
// type, a class, a data type and an object, each at its own `Self`.

trait Absent
  static none() -> Option[Self] = None
  static label() -> string = "absent"
  static described() -> string = s"${Self.label()}:${Self.none().isEmpty}"

trait Decode: Absent
  static decode(text: string) -> Self

data Port(n: int)

impl Absent for Port
  static none() -> Option[Port] = Some(Port(80))
  static label() -> string = "port"

impl Decode for Port
  static decode(text: string) -> Port = Port(text.toInt())

data Host(name: string)

impl Absent for Host

impl Decode for Host
  static decode(text: string) -> Host = Host(text)

class Gauge(val level: int)

impl Absent for Gauge
  static label() -> string = "gauge"

object Nobody

impl Absent for Nobody

data Pair[A](a: A, b: A)

impl[A] Absent for Pair[A]

impl Absent for int
  static label() -> string = "int"

impl Absent for string

// A trait requiring `Absent` with no static members of its own takes the defaults too.
trait Tagged: Absent
  tag() -> string

data Badge(text: string)

impl Tagged for Badge
  tag() -> string = text

impl Absent for Badge

viaAbsent[T: Absent]() -> string = s"${T.label()} ${T.none().isEmpty} ${T.described()}"

viaDecode[T: Decode](text: string) -> T = T.none() match
  Some(t) -> if text == "" then t else T.decode(text)
  None -> T.decode(text)

// The default is compiled once per type: its value at one type never leaks into another's.
sizes[A: Absent, B: Absent]() -> string = s"${A.label()}/${B.label()}"

main()
  println(Port.none().map(p -> p.n))
  println(Host.none().isEmpty)
  println(Port.label())
  println(Host.label())
  println(Port.described())
  println(Host.described())
  println(viaAbsent[Port]())
  println(viaAbsent[Host]())
  println(viaAbsent[Gauge]())
  println(viaAbsent[Nobody]())
  println(viaAbsent[Pair[int]]())
  println(viaAbsent[Pair[string]]())
  println(viaAbsent[int]())
  println(viaAbsent[string]())
  println(viaAbsent[Badge]())
  println(viaDecode[Port]("").n)
  println(viaDecode[Port]("443").n)
  println(viaDecode[Host]("h").name)
  println(sizes[int, string]())
  println(sizes[Port, Pair[Port]]())
  println(int.described())
  println(Pair[bool].described())
  val f: () -> string = Gauge.label
  println(f())
