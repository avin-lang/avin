// expect: exit 0
// Static members on constructors under allocation pressure: values made by `F.pure` and by a
// default body's `Self.pure` are held in collections and closures while more are made, at several
// constructors, so a collection in between must keep every one of them.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

trait Pointed[A]: Mappable[A]
  static pure[X](value: X) -> Self[X]

trait Chainable[A]: Pointed[A]
  flatMap[B](f: (A) -> Self[B]) -> Self[B]
  override map[B](f: (A) -> B) -> Self[B] = flatMap(a -> Self.pure(f(a)))

data Cell[T](value: T)

impl[T] Cell[T]
  flatMap[B](f: (T) -> Cell[B]) -> Cell[B] = f(value)

impl Chainable for Cell
  static pure[X](value: X) -> Cell[X] = Cell(value)

impl Chainable for Option
  static pure[X](value: X) -> Option[X] = Some(value)

impl[T, E] Chainable[T] for Result[T, E]
  static pure[X](value: X) -> Result[X, E] = Ok(value)

// Many values made by the constructor's `pure`, each holding a fresh string.
build[F[_]: Pointed](n: int) -> Vector[F[string]]
  var out: Vector[F[string]] = Vector()
  for i in 0 ..< n
    out = out :+ F.pure(s"item-$i")
  out

// Closures holding values made by `pure`, run after more allocation.
thunks[F[_]: Pointed](n: int) -> Vector[() -> F[Vector[int]]]
  var out: Vector[() -> F[Vector[int]]] = Vector()
  for i in 0 ..< n
    val held = Vector.tabulate(i % 7, k -> k + i)
    out = out :+ (() -> F.pure(held))
  out

// `map` through the default body, which calls `Self.pure` for every element.
mapped[F[_]: Chainable](xs: Vector[F[int]]) -> Vector[F[string]] = xs.map(x -> x.map(n -> s"#$n"))

main()
  val cells = build[Cell](500)
  val options = build[Option](500)
  val results = build[Result[_, string]](500)
  println(cells(0).value + " " + cells(499).value)
  println(options(250))
  println(results(499))
  val ts = thunks[Option](300)
  var total = 0
  for t in ts
    t() match
      Some(v) -> total += v.length
      None -> ()
  println(total)
  val ms = mapped[Cell](Vector.tabulate(400, i -> Cell(i)))
  println(ms(0).value + " " + ms(399).value)
  val ro = mapped[Result[_, string]](Vector.tabulate(400, i -> if i % 2 == 0 then Ok(i) else Err(s"odd $i")))
  println(ro(398))
  println(ro(399))
  println(cells.length + options.length + results.length)
