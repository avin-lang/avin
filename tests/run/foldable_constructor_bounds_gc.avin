// expect: exit 0
// Values made in bulk through `Foldable`, `Traverse` and `Monad` bounds, so the collector runs while
// instances at `List`, `Vector`, `Option` and a partial application of `Result` hold them: in the
// accumulators `foldLeft` threads, in the closures `traverse` builds, and in what `sequence` gathers.
gathered[F[_]: Foldable](xs: F[string]) -> Vector[string] = xs.foldLeft([], (acc, s) -> acc :+ s"$s!")

checked(n: int) -> Result[string, string] = if n >= 0 then Ok(s"n$n") else Err(s"bad $n")

repeated[F[_]: Monad](fa: F[int], n: int) -> F[Vector[int]] =
  var out = fa.map(x -> [x])
  for _ in 0 ..< n
    out = out.flatMap(xs -> fa.map(x -> xs :+ x))
  out

main()
  var total = 0
  for round in 0 ..< 200
    val words = List.tabulate(20, i -> s"w${round * 20 + i}")
    total += gathered(words).length
    total += gathered(Some(s"$round")).length
    val parsed = Vector.tabulate(10, i -> checked(i - (round % 3)))
    total += parsed.traverse(r -> r.toOption).map(v -> v.length).getOrElse(0)
    total += Vector.tabulate(10, i -> i).traverse(checked).map(v -> v.length).getOrElse(-1)
    val nested: List[Option[string]] = List.tabulate(5, i -> Some(s"o$i"))
    total += nested.sequence().map(l -> l.length).getOrElse(0)
    total += repeated(Some(round), 3).map(v -> v.length).getOrElse(0)
  println(total)
  println(repeated([1, 2], 2).length)
  println(repeated[Result[_, string]](Ok(7), 2))
