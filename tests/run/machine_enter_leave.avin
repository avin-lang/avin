// expect: exit 0
// `enter` runs when a machine moves into a state and `leave` when it moves out, `leave` first. An
// arm yielding a state, even the current one, is a transition and runs both; `stay` runs neither.
// The first state's `enter` runs when the machine is made, after the body. Inside `leave` the
// machine is still in the state it leaves; inside `enter` it is in the new one, and the arm itself
// runs before either.
data Ev
    Go
    Again
    Wait
    Back

machine Lamp(label: string) receives Ev
    var log = Vector[string]()
    log = log :+ s"body $label"

    state Off
        enter
            log = log :+ s"enter Off in ${state()}"
        leave
            log = log :+ s"leave Off in ${state()}"
        Go ->
            log = log :+ "arm Go"
            On(1)
        Wait -> stay
        Again -> Off
        Back -> stay

    state On(level: int)
        enter
            log = log :+ s"enter On($level) in ${state()}"
        leave
            log = log :+ s"leave On($level) in ${state()}"
        Again -> On(level + 1)
        Wait -> stay
        Back -> Off
        Go -> stay

show(lamp: Lamp)
    for line in lamp.log do println(line)
    println("--")
    lamp.log = Vector()

main() -> int
    val lamp = Lamp("a")
    show(lamp)
    lamp.handle(Wait)
    show(lamp)
    lamp.handle(Again)
    show(lamp)
    lamp.handle(Go)
    show(lamp)
    lamp.handle(Again)
    show(lamp)
    lamp.handle(Wait)
    lamp.handle(Go)
    show(lamp)
    println(lamp.handle(Back))
    show(lamp)
    0
