// expect: exit 0
// An ordering settles what one operand's type leaves unknown from the other's, as `==` does:
// `Some(1) < None` compares two `Option[int]`s, on either side, nested, inside a tuple and on a data
// type of the program's own. Two options of nothing compare too, both `None`.

data Opt[T] derives Ord
  Empty
  Full(value: T)

main()
  println(Full(1) < Empty)
  println(Empty < Full(1))
  println(Empty[int] <= Empty)
  println(None < Some(1))
  println(Some(1) <= None)
  println(Some(1) >= None)
  println(Some(Some(3)) > Some(None))
  println(Some(None) < Some(Some("a")))
  println((None, 1) < (Some(2), 1))
  println(Full(None) >= Full(Some("a")))
  val xs = [Some(3), None, Some(1)]
  println(xs.sorted)
  // Options of nothing: only `None`, equal to itself.
  println(None < None)
  println(None <= None)
  println(None > None)
  val a = None
  println(a >= a)
  println(a.compare(a))
