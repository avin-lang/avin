// Calls through a bound take every form a method call takes: overloads, default arguments, infix
// calls, methods with type parameters of their own, a generic trait as the bound, and calls from
// lambdas and local functions inside the generic.
trait Shape
    area() -> int
    scaled(by: int = 2) -> int = area() * by
    fits(n: int) -> bool = area() <= n
    fits(other: Self) -> bool = area() <= other.area()
    pick[B](yes: B, no: B) -> B = if area() > 10 then yes else no

trait Source[A]
    next() -> A

data Tile
    Small
    Large(side: int)

impl Shape for Tile
    area() -> int = self match
        Small -> 1
        Large(s) -> s * s

class Counter(var count: int): Source[int]
    override next() -> int
        count = count + 1
        count

measure[T: Shape](x: T, y: T) -> string
    val first = s"${x.scaled()} ${x.scaled(by = 3)}"
    val second = s"${x.fits(5)} ${x.fits(y)} ${x fits y}"
    val third = x.pick("big", "small") + " " + y.pick[string]("big", "small")
    first + " / " + second + " / " + third

// A bound with a type argument naming another parameter.
drain[S: Source[A], A](s: S, n: int) -> A
    var last = s.next()
    var i = 1
    while i < n
        last = s.next()
        i = i + 1
    last

// A lambda and a local function in the generic call through the bound too.
areas[T: Shape](items: (T, T)) -> int
    val area = (t: T) -> t.area()
    sum(a: T, b: T) -> int = area(a) + b.area()
    sum(items.0, items.1)

main()
    println(measure(Small, Large(4)))
    println(measure(Large(5), Small))
    println(s"${drain(Counter(0), 3)}")
    println(s"${areas((Large(2), Large(3)))}")
