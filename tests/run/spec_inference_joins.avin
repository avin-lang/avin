// expect: exit 0
// Inference by join and by later use: classes joining to the one trait every shared trait is a parent
// of, at a branch and at a call; cat :: dogs as a List[Animal]; several arguments joining; Any expected
// admitting two value types; a None settled by a lambda that stores into it; a Nothing argument
// deciding nothing; a leading prefix of written type arguments; and unknowns only read out as Nothing.

trait Named
    name() -> string

trait Pet: Named
    owner() -> string = "nobody"

class Parrot: Pet
    override name() -> string = "polly"

class Goldfish: Pet
    override name() -> string = "bubbles"

open class Animal(val label: string)

class Cat(label: string): Animal(label)

class Dog(label: string): Animal(label)

pair[T](a: T, b: T) -> (T, T) = (a, b)

firstOf[T](a: Option[T], b: Option[T]) -> Option[T] = a.orElse(b)

identity[T](x: T) -> T = x

convert[A, B](a: A, f: (A) -> B) -> B = f(a)

show[T](o: Option[T]) -> string = if o.isEmpty() then "empty" else "full"

main()
    val c = true
    val pet = if c then Parrot() else Goldfish()
    println(s"${pet.name()} ${pet.owner()}")
    val both = pair(Parrot(), Goldfish())
    println(both.1.name())
    val animals = Cat("tom") :: List[Dog](Dog("rex"))
    println(animals.map(a -> a.label))
    println(pair(Cat("a"), Dog("b")).1.label)
    println(firstOf(Some(Cat("c")), Some(Dog("d"))).map(a -> a.label))
    val anyPair: (Any, Any) = pair(1, "one")
    println(anyPair)
    var best = None
    val record = (n: int) -> best = Some(n)
    record(3)
    println(best)
    val found = loop
        val x = identity(break 42)
    println(found)
    println(convert[int, string](5, n -> s"<$n>"))
    println(convert[int](6, n -> n * 2))
    println(show(None))
    val e = Left(1)
    println(e)
    val first = if c then Some(2) else None
    println(first)
