// expect: exit 0
// The lambdas and `match` functions of one call are checked in turn, each the first whose parameter
// types are known by then: declared by it, or decided by the arguments checked before it. So what a
// typed lambda decides reaches a `match` function or an untyped lambda written before it, through
// any number of function arguments, in calls of functions, methods and overloads.

both[A, B: Display](g: (A) -> B, f: (A) -> B) -> (A) -> string = x -> s"${g(x)} ${f(x)}"

partial[A, B: Display](g: PartialFunction[A, B], f: (A) -> B) -> (A) -> string = x -> s"${g.isDefinedAt(x)} ${f(x)}"

partialLast[A, B: Display](f: (A) -> B, g: PartialFunction[A, B]) -> (A) -> string = x -> s"${f(x)} ${g.lift()(x)}"

back[A, B](g: (B) -> A, f: (A) -> B) -> (A) -> A = x -> g(f(x))

chain[A, B, C](first: (B) -> C, second: (A) -> B, third: (int) -> A, n: int) -> C = first(second(third(n)))

pairs[A, B, C](f: ((A, B)) -> C, g: (int) -> (A, B), n: int) -> C = f(g(n))

sendBoth[A, B: Display](@sendable g: (A) -> B, @sendable f: (A) -> B) -> (A) -> string = x -> s"${g(x)} ${f(x)}"

sendBound[A: Sendable, B: Sendable](g: @sendable (A) -> B, f: @sendable (int) -> A, n: int) -> B = g(f(n))

sendVar[F: Sendable, A](
    g: PartialFunction[A, int],
    f: F,
    h: (A) -> A
) -> (A) -> int = x -> if g.isDefinedAt(h(x)) then g(h(x)) else -1

over[A, B: Display](g: (A) -> B, f: (A) -> B) -> (A) -> string = x -> s"two ${g(x)} ${f(x)}"
over[A, B: Display](g: (A) -> B, f: (A) -> B, h: (A) -> B) -> (A) -> string = x -> s"three ${g(x)} ${f(x)} ${h(x)}"
over[A, B, C: Display](g: (A, B) -> C, f: (A) -> B) -> (A) -> string = x -> s"binary ${g(x, f(x))}"

class Box[T](value: T)
  apply2[U](g: (T) -> U, f: (U) -> U) -> U = f(g(value))
  mixed[U, V](g: (U) -> V, f: (T) -> U) -> V = g(f(value))

main() -> int
  // The match function first, the typed lambda second.
  println(both(match n -> n + 1, (x: int) -> x * 10)(4))
  // And swapped: the typed lambda first.
  println(both((x: int) -> x * 10, match n -> n + 1)(4))
  // An untyped lambda before the typed one.
  println(both(y -> y - 1, (x: int) -> x)(7))
  // A partial function, either side of the typed lambda.
  println(partial(match n if n > 0 -> n, (x: int) -> -x)(3))
  println(partial(match n if n > 0 -> n, (x: int) -> -x)(-3))
  println(partialLast((x: int) -> x * 2, match n if n % 2 == 0 -> n / 2)(6))
  println(partialLast((x: int) -> x * 2, match n if n % 2 == 0 -> n / 2)(5))
  // The typed lambda's result decides what the `match` function before it matches.
  println(back(match s -> s.byteLength, (x: int) -> s"<$x>")(42))
  // Three function arguments, decided right to left.
  println(chain(match b -> b.byteLength, a -> s"[$a]", (n: int) -> n * 100, 7))
  // All three already known, decided left to right.
  println(chain((b: string) -> b.byteLength, (a: int) -> s"[$a]", (n: int) -> n, 7))
  // A lambda that takes a tuple apart, before the typed lambda that decides the tuple.
  println(pairs((a, b) -> a + b.byteLength, (n: int) -> (n, s"$n$n"), 12))
  println(pairs((a, _) -> a * 2, (n: int) -> (n, "x"), 21))
  // `@sendable` parameters, and type arguments bounded by `Sendable`.
  println(sendBoth(match n -> n * 3, (x: int) -> x + 1)(5))
  println(sendBound(match a -> a.byteLength, (n: int) -> s"$n", 12345))
  println(sendVar(match s if s.byteLength > 2 -> s.byteLength, (n: int) -> n, (t: string) -> t + "!")("abcd"))
  println(sendVar(match s if s.byteLength > 2 -> s.byteLength, (n: int) -> n, (t: string) -> t + "!")("a"))
  // Overloads: chosen by shape and count, then inferred in the same order.
  println(over(match n -> n + 1, (x: int) -> x)(1))
  println(over(match n -> n + 1, y -> y * 2, (x: int) -> x)(1))
  println(over((a: int, b: string) -> s"$a$b", match n -> s"#$n")(9))
  // Methods: the receiver decides `T`, a typed lambda decides `U`.
  val box = Box(5)
  println(box.apply2(match n -> s"$n", s -> s + "!"))
  println(box.mixed(match s -> s.byteLength, (t: int) -> s"$t$t$t"))
  // Generic instances, closures and nesting.
  val offset = 100
  println(partial(match Some(n) -> n + offset, (o: Option[int]) -> o.getOrElse(-1))(Some(1)))
  println(partial(match Some(n) -> n + offset, (o: Option[int]) -> o.getOrElse(-1))(None))
  println(partialLast((o: Option[int]) -> o.getOrElse(-1), match Some(n) -> n + offset)(None))
  println(both(match xs -> xs.length, (v: Vector[string]) -> v.length * 2)(["", "é", "日本"]))
  println(both(match n -> both(match m -> m + n, (k: int) -> k)(n), (x: int) -> s"$x")(2))
  println(both(match s -> s.byteLength, (x: string) -> x.chars.length)("日本"))
  println(both(match s -> s + "|", (x: string) -> x)(""))
  0
