// A method a class inherits that also implements a trait's method keeps its own defaults, which a
// call through the trait's type sees too, when the trait's method declares none or the very same.
trait Counter
    count(step: int) -> int

open class Base()
    count(step: int = 1) -> int = step * 10

class Ticker() : Base(), Counter

trait Sized
    size(extra: int = 2) -> int

open class Box() : Sized
    override size(extra: int) -> int = 100 + extra

trait Boxed : Sized

class Crate() : Box(), Boxed

open class Bare()
    size(extra: int) -> int = extra

class Wrapped() : Bare(), Sized
    override size(extra: int) -> int = 50 + extra

trait Measured
    measure(by: int) -> int

trait Ruler
    measure(by: int = 4) -> int = by * 3

data Stick(length: int)

impl Ruler for Stick
impl Measured for Stick

main()
    val t = Ticker()
    print(s"${t.count()} ${t.count(3)}")
    val c: Counter = t
    print(s"${c.count(5)}")
    val crate = Crate()
    print(s"${crate.size()}")
    val sized: Sized = crate
    print(s"${sized.size()}")
    val boxed: Boxed = crate
    print(s"${boxed.size(1)} ${boxed.size()}")
    print(s"${Wrapped().size()}")
    val w: Sized = Wrapped()
    print(s"${w.size()}")
    val stick = Stick(1)
    print(s"${stick.measure()}")
    val m: Measured = stick
    print(s"${m.measure(5)}")
