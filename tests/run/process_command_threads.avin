// A command is sendable, so a thread may start, wait for and read it: a child started on another
// thread is waited for there, and a sequence's lines are read on another thread, whose own driver
// thread runs the sequence. Commands run from several threads at once each answer their own.
// A started child and a lines iterator are mutable, so they stay on the thread that made them.
import avin.process.Command
import avin.threads

main()
  val exit9 = Command("/bin/sh", "-c", "exit 9")
  println(threads.spawn(() ->
    exit9.start() match
      Ok(c) -> c.waitFor()
      Err(e) -> fail(s"not started: $e")).join())
  val both = Command("/bin/echo", "read") andThen Command("/bin/echo", "elsewhere")
  println(threads.spawn(() ->
    both.lines() match
      Ok(l) -> l.toVector
      Err(e) -> fail(s"not started: $e")).join())
  val workers = (0 ..< 4).map(
    i -> threads.spawn(() -> (Command("/bin/echo", s"worker $i") | Command("/usr/bin/tr", "a-z", "A-Z")).output())
  ).toVector
  for w in workers do println(w.join())
