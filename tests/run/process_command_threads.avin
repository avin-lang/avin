// A started command belongs to the code that started it, and moves with what a thread's body is
// given: a child started on one thread is waited for on another, and a command's lines are read on
// another. Commands run from several threads at once each answer their own.
import avin.process.Command
import avin.threads

main()
  val child = Command("/bin/sh", "-c", "exit 9").start() match
    Ok(c) -> c
    Err(e) -> fail(s"not started: $e")
  println(threads.spawn(() -> child.waitFor()).join())
  val lines = (Command("/bin/echo", "read") andThen Command("/bin/echo", "elsewhere")).lines() match
    Ok(l) -> l
    Err(e) -> fail(s"not started: $e")
  println(threads.spawn(() -> lines.toVector()).join())
  val workers = (0 ..< 4).map(
    i -> threads.spawn(() -> (Command("/bin/echo", s"worker $i") | Command("/usr/bin/tr", "a-z", "A-Z")).output())
  ).toVector()
  for w in workers do println(w.join())
