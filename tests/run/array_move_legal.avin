// expect: exit 0
// What moving an array leaves legal. Any array of sendable elements moves: strings, options,
// tuples, data and longs. A slice taken before the move is a copy, still the sender's. `with` works on
// a moved array in place, on whichever thread holds the `Isolated`, and leaves it moved. An array
// taken back by the thread that moved it is that thread's again, through every reference it kept. An
// `Isolated` made by `isolate` still holds an array nothing moved, and a moved one can be moved
// again by the code that took it.
import avin.actors.{Isolated, isolate}
import avin.threads.{Channel, spawn}

data Point(x: int, y: int)

main()
  val words = Array.tabulate[string](3, i -> s"w$i")
  val wordsBack = Isolated.move(words).take()
  println(s"${wordsBack.toVector} ${wordsBack === words} ${words(2)}")

  val opts = Array.tabulate[Option[int]](3, i -> if i == 1 then None else Some(i))
  val pairs = Array.tabulate[(int, string)](2, i -> (i, s"p$i"))
  val points = Array.tabulate[Point](2, i -> Point(i, -i))
  val longs = Array.fill[long](2, 9223372036854775807)
  println(Isolated.move(opts).take().toVector)
  println(Isolated.move(pairs).take().toVector)
  println(Isolated.move(points).take().toVector)
  println(Isolated.move(longs).take().toVector)

  val bytes = Array.tabulate[byte](4, i -> byte(i))
  val before = bytes.slice(1, 3)
  val moved = Isolated.move(bytes)
  before(0) = byte(42)
  println(s"slice kept: ${before.toVector}")

  val total = moved.with(a ->
    a(0) = byte(7)
    a.length)
  println(s"with saw $total elements")
  val ch = Channel[Isolated[Array[byte]]](1)
  ch.send(moved)
  val t = spawn(() ->
    val m = ch.receive().get
    m.with(a -> int(a(0))))
  println(s"with on another thread read ${t.join()}")
  val mine = moved.take()
  println(s"taken back: ${bytes.toVector} ${mine === bytes}")

  val fresh = isolate(Array.fill[int](2, 3))
  val got = fresh.take()
  got(1) = 4
  println(got.toVector)
  val again = Isolated.move(got).take()
  println(s"moved again: ${again.toVector} ${again === got}")

  val empty = Array.empty[string]()
  val emptyBack = Isolated.move(empty).take()
  println(s"empty: ${emptyBack.length} ${emptyBack === empty}")
