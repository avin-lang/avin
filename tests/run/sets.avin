// expect: exit 0
// Immutable sets: adding an element twice keeps one, updates leave the old set as it was, the set
// operations make new sets, and sets are equal when they hold the same elements. A mutable set adds
// and removes in place and converts to an immutable one.

import avin.collections.mutable.{Set as MutableSet}

setOf(xs: Iterable[int]) -> Set[int]
    val b = HashSetBuilder[int]()
    b.addAll(xs)
    b.result()

total(s: Set[int]) -> int
    var sum = 0
    for x in s do sum += x
    sum

main()
    val small = Set[int]().incl(1).incl(2).incl(2)
    println(s"${small.size()} ${small(1)} ${small.contains(3)} ${small.incl(1) == small} ${small.excl(1).size()} ${small.size()}")

    val odds = setOf(Array.tabulate(10, i -> 2 * i + 1))
    val low = setOf(1..10)
    println(s"${odds.size()} ${low.size()} ${total(odds)} ${total(low)}")
    val both = odds intersect low
    val either = odds union low
    val onlyLow = low diff odds
    println(s"${both.size()} ${total(both)} ${either.size()} ${total(either)} ${onlyLow.size()} ${total(onlyLow)}")
    println(s"${both.subsetOf(odds)} ${both.subsetOf(low)} ${low.subsetOf(odds)} ${Set[int]().subsetOf(both)}")
    println(s"${(odds union low) == (low union odds)} ${(both union onlyLow) == low} ${odds == low} ${odds.hash() == setOf(Array.tabulate(10, i -> 19 - 2 * i)).hash()}")
    val tens = low.map(x -> x / 10)
    val big = low.filter(x -> x > 7)
    println(s"${tens.size()} ${total(tens)} ${big.size()} ${total(big)}")
    var visited = 0
    big.foreach(x -> visited += x)
    println(visited)

    val words = Set[string]().incl("ab").incl("cd")
    val pairs = Set[(string, int)]().incl(("ab", 1)).incl(("ab", 1)).incl(("ab", 2))
    val nested = Set[Set[int]]().incl(low).incl(setOf(Array.tabulate(10, i -> 10 - i)))
    println(s"${words.contains("ab")} ${pairs.size()} ${nested.size()}")

    val seen = MutableSet[int]()
    println(s"${seen.add(3)} ${seen.add(3)} ${seen.add(4)} ${seen(3)} ${seen.size()}")
    println(s"${seen.remove(3)} ${seen.remove(3)} ${seen.size()}")
    seen.addAll(1..5)
    println(s"${seen.size()} ${seen.toSet() == setOf(1..5)} ${seen.filter(x -> x % 2 == 0).size()} ${seen.copy().size()}")
    seen.clear()
    println(s"${seen.isEmpty()} ${seen.contains(4)}")
