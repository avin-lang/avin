// expect: trap
// A sender's close takes the codes and reasons `close` takes, and traps where it is called on one it
// does not: 3000 is taken, 1005 traps.
import avin.net.http
import avin.net.http.{Route, Router, WebSocket, webSocket}

main()
  val router = Router([Route.get("/", r -> webSocket(r, ws -> _ = ws.receive()))])
  val server = http.serve("127.0.0.1", 0, router.handle).ok.get
  val connect = () -> WebSocket.connect(s"ws://127.0.0.1:${server.port()}/").ok.get
  println(connect().sender().close(3000, "fine").isOk)
  _ = connect().sender().close(1005)
