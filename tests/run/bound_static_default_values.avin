// expect: exit 0
// A static member with a default body, reached through a type parameter's bound and named without a
// call, is a function value of it: each instance of the code makes it of its type argument's member,
// which is the type's own body where it gives one and the trait's default, compiled for that type,
// where it gives none. Kept in a `val`, passed to a higher-order function, overloaded and chosen by
// the function type expected, with a `using` section, through a requiring trait, on a built-in type,
// a generic type, a class and an object, captured by a closure, from a generic function calling
// another, and taken on `Self` inside a default body.

class Tx(val id: int)

trait Absent
  static label() -> string = "absent"
  static wrap(text: string) -> string = s"<$text>"
  static pick(x: int) -> string = s"int $x"
  static pick(s: string) -> string = s"string $s"
  static named(n: int) -> string = s"${Self.label()} $n"
  static stamped(n: int, using tx: Tx) -> string = s"${Self.label()} $n/${tx.id}"
  static none() -> Option[Self] = None
  static all(ns: Vector[int]) -> Vector[string] = ns.map(Self.named)
  static twice(text: string) -> string
    val w = Self.wrap
    w(w(text))
  static make(n: int) -> Self

trait Decode: Absent
  static decode(text: string) -> Self

// A trait requiring `Absent` with no static members of its own.
trait Tagged: Absent
  tag() -> string

data Port(n: int)

impl Absent for Port
  static label() -> string = "port"
  static wrap(text: string) -> string = s"[$text]"
  static pick(x: int) -> string = s"port int $x"
  static none() -> Option[Port] = Some(Port(80))
  static make(n: int) -> Port = Port(n)

impl Decode for Port
  static decode(text: string) -> Port = Port(text.charCount)

data Host(name: string)

impl Absent for Host
  static make(n: int) -> Host = Host(s"h$n")

impl Decode for Host
  static decode(text: string) -> Host = Host(text)

class Gauge(val level: int)

impl Absent for Gauge
  static label() -> string = "gauge"
  static make(n: int) -> Gauge = Gauge(n)

object Nobody

impl Absent for Nobody
  static make(n: int) -> Nobody = Nobody

data Pair[A](a: A, b: A)

impl[A: Absent] Absent for Pair[A]
  static label() -> string = s"pair of ${A.label()}"
  static make(n: int) -> Pair[A] = Pair(A.make(n), A.make(n + 1))

impl Absent for int
  static label() -> string = "int"
  static make(n: int) -> int = n

impl Absent for string
  static make(n: int) -> string = s"s$n"

data Badge(text: string)

impl Tagged for Badge
  tag() -> string = text

impl Absent for Badge
  static wrap(text: string) -> string = s"{$text}"
  static make(n: int) -> Badge = Badge(s"b$n")

apply[A, B](f: (A) -> B, a: A) -> B = f(a)

kept[T: Absent](text: string) -> string
  val wrap = T.wrap
  wrap(text)

passed[T: Absent](texts: Vector[string]) -> Vector[string] = texts.map(T.wrap)

applied[T: Absent](n: int) -> string = apply(T.named, n)

labelled[T: Absent]() -> string
  val f: () -> string = T.label
  f()

picked[T: Absent]() -> string
  val byInt: (int) -> string = T.pick
  val byText: (string) -> string = T.pick
  s"${byInt(1)}; ${byText("a")}"

stamped[T: Absent](n: int) -> string
  given tx = Tx(7)
  val f = T.stamped
  f(n)

stampedOuter[T: Absent](using tx: Tx) -> Vector[string] = [1, 2].map(T.stamped)

absent[T: Absent]() -> bool
  val f: () -> Option[T] = T.none
  f().isEmpty

viaSelf[T: Absent]() -> string
  val all = T.all
  val twice = T.twice
  s"${all([1, 2])} ${twice("x")}"

viaDecode[T: Decode](text: string) -> string
  val wrap = T.wrap
  val named = T.named
  val decode = T.decode
  s"${wrap(text)} ${named(text.charCount)} ${[text, ""].map(decode).length}"

viaTagged[T: Tagged](n: int) -> string
  val wrap = T.wrap
  val make = T.make
  wrap(make(n).tag())

closure[T: Absent]() -> (string) -> string
  val wrap = T.wrap
  val label: () -> string = T.label
  text -> s"${label()} ${wrap(text)}"

nested[T: Absent](texts: Vector[string]) -> Vector[string] = passed[T](texts)

// The value is made once per instance: one type's never serves another.
sides[A: Absent, B: Absent](text: string) -> string
  val a = A.wrap
  val b = B.wrap
  val la: () -> string = A.label
  val lb: () -> string = B.label
  s"${la()} ${a(text)} / ${lb()} ${b(text)}"

main()
  println(kept[Port]("a"))
  println(kept[Host]("a"))
  println(kept[int]("a"))
  println(kept[string]("ü"))
  println(kept[Gauge](""))
  println(kept[Nobody]("n"))
  println(kept[Pair[int]]("p"))
  println(kept[Badge]("b"))
  println(passed[Port](["x", "y"]))
  println(passed[Host](["x", "y"]))
  println(passed[string]([]))
  println(applied[Port](int.MaxValue))
  println(applied[Host](int.MinValue))
  println(applied[int](0))
  println(applied[Pair[Port]](2))
  println(applied[Pair[Pair[string]]](3))
  println(labelled[Port]())
  println(labelled[Host]())
  println(labelled[Gauge]())
  println(labelled[Nobody]())
  println(labelled[string]())
  println(picked[Port]())
  println(picked[Host]())
  println(picked[int]())
  println(stamped[Port](3))
  println(stamped[Host](3))
  given outer = Tx(5)
  println(stampedOuter[Gauge]())
  println(stampedOuter[string]())
  println(absent[Port]())
  println(absent[Host]())
  println(absent[Pair[int]]())
  println(viaSelf[Port]())
  println(viaSelf[Host]())
  println(viaSelf[int]())
  println(viaSelf[Pair[Gauge]]())
  println(viaDecode[Port]("abc"))
  println(viaDecode[Host]("abc"))
  println(viaTagged[Badge](4))
  val f = closure[Port]()
  val g = closure[Host]()
  println(f("c"))
  println(g("c"))
  println(nested[Host](["n"]))
  println(nested[Port](["n"]))
  println(sides[Port, Host]("s"))
  println(sides[Host, Port]("s"))
  println(sides[int, Pair[int]]("s"))
  val direct = Host.wrap
  println(direct("known"))
  val builtin = string.named
  println(builtin(9))
