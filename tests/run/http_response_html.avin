// expect: exit 0
// `Response.html` over the loopback: its status and reason, the type `text/html; charset=utf-8`, the
// body sent as given (markup, Unicode and characters HTML would escape left alone), an empty body, a
// status other than 200, and a `HEAD` of it, which has the length and no body; `withHeader` adds to it.
import avin.net.http
import avin.net.http.{HttpError, Response, ServerRequest}

page(r: ServerRequest) -> Response = r.path match
  "/" -> Response.html(200, "<p>café ✓ &amp; <b>bold</b></p>")
  "/empty" -> Response.html(200, "")
  "/tagged" -> Response.html(201, "<i>made</i>").withHeader("X-Note", "kept")
  _ -> Response.html(404, "<h1>no such page</h1>")

describe(r: Result[http.Response, HttpError]) -> string = r match
  Ok(
    res
  ) -> s"${res.status} ${res.reason} ${res.header("Content-Type").getOrElse("-")} ${res.header("Content-Length").getOrElse("-")} [${res.text}]"
  Err(e) -> s"error: ${e.message}"

main()
  val server = http.serve("127.0.0.1", 0, page).ok.get
  val base = s"http://127.0.0.1:${server.port()}"
  println(describe(http.get(base + "/")))
  println(describe(http.get(base + "/empty")))
  println(describe(http.get(base + "/missing")))
  println(describe(http.head(base + "/")))
  http.get(base + "/tagged") match
    Ok(res) -> println(
      s"${res.status} ${res.header("X-Note").getOrElse("-")} ${res.header("Content-Type").getOrElse("-")} [${res.text}]"
    )
    Err(e) -> println(e.message)
  server.shutdown()
