// Conversions between integer widths, reals, bytes and chars.

main() -> int
    // Widening sign-extends; narrowing keeps the low bits.
    val small: i8 = -2
    if int(small) != -2 then return 1
    if i64(small) * 3000000000 != -6000000000 then return 2
    if i8(300) != 44 then return 3
    if i8(-129) != 127 then return 4
    val wide: i64 = 4294967298
    if int(wide) != 2 then return 5
    if int(i128(wide)) != 2 then return 6
    // Reals truncate toward zero, saturate at the bounds, and NaN becomes zero.
    if int(2.9) != 2 then return 7
    if int(-2.9) != -2 then return 8
    if int(1.0e20) != 2147483647 then return 9
    if i8(-1000.0) != -128 then return 10
    val zero = 0.0
    if int(zero / zero) != 0 then return 11
    if real(7) / 2.0 != 3.5 then return 12
    if real(small) != -2.0 then return 13
    if real(byte(200)) != 200.0 then return 14
    // A byte converts to an integer by value.
    val b: byte = 0xc8
    if i8(b) != -56 then return 15
    if i64(b) != 200 then return 16
    if int(int(5)) != 5 then return 17
    0
