// expect: exit 5
// The program `exec` becomes is the same process: the shell's `$$` is the pid this program had, and
// the status the parent sees is the shell's own `exit 5`. The call is reached through `?` from a
// function answering a `Result`, which an `exec` that succeeded never comes back to.
import avin.io.IoError
import avin.process

become(pid: long) -> Result[unit, IoError]
  process.exec(
    "/bin/sh",
    ["-c", "if [ \"$$\" = \"$1\" ]; then echo same pid; else echo \"$$ is not $1\"; fi; exit 5", "sh", s"$pid"]
  )?
  println("not reached")
  Ok(())

main() -> int
  val pid = process.pid()
  println(pid > 0)
  println(become(pid))
  1
