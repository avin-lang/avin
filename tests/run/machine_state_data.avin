// expect: exit 0
// A state's parameters are the data it holds: its arms, `enter` and `leave` read them by name, a
// transition makes the next state's data, `stay` keeps it, and `state()` answers it as the fields
// of the `State` variant. States hold any values, objects, strings and collections among them.
class Item(val name: string)

data Cmd
  Push(item: Item)
  Pop
  Rename(text: string)
  Finish

machine Stack receives Cmd
  var popped = Vector[string]()

  state Empty
    Push(item) -> Holding(Vector(item), "first")
    Pop -> stay
    Rename(_) -> stay
    Finish -> Done(0, "")

  state Holding(items: Vector[Item], tag: string)
    leave
      println(s"leaving Holding($tag) with ${items.length}")
    Push(item) -> Holding(items :+ item, tag)
    Pop ->
      popped = popped :+ items.last.name
      if items.length == 1 then Empty else Holding(items.init, tag)
    Rename(text) -> Holding(items, text)
    Finish -> Done(items.length, tag)

  state Done(count: int, tag: string)
    enter
      println(s"done with $count tagged \"$tag\"")
    _ -> stay

main() -> int
  val s = Stack()
  s.handle(Push(Item("a")))
  s.handle(Push(Item("b")))
  s.handle(Rename("é✓"))
  s.state() match
    Holding(items, tag) -> println(s"${items.length} $tag ${items(0).name}")
    _ -> println("unexpected")
  s.handle(Pop)
  s.handle(Pop)
  s.handle(Pop)
  println(s.popped)
  // `Stack.State` holds an `Item`, which has no `Display`, so it has none either and shows as its
  // type, as any data type does.
  println(s.state())
  println(s.state() is Empty)
  s.handle(Push(Item("c")))
  println(s.handle(Finish))
  println(s.handle(Push(Item("d"))))
  println(s.state() is Done(1, "first"))
  0
