// expect: exit 0
// Spec probes for declarations, in combination under allocation: generic clause functions over a
// covariant tree built by thousands of inserts, a spliced vector of two thousand strings into a
// repeated parameter whose local function assigns the enclosing vars, and lambdas capturing loop values.
data Tree[+T]
    Leaf
    Node(left: Tree[T], value: T, right: Tree[T])

insert(t: Tree[int], v: int) -> Tree[int]
insert(Leaf, v) = Node(Leaf, v, Leaf)
insert(Node(l, x, r), v)
    | v < x = Node(insert(l, v), x, r)
    | v > x = Node(l, x, insert(r, v))
    | _ = Node(l, x, r)

size[T](t: Tree[T]) -> int
size(Leaf) = 0
size(Node(l, _, r)) = size(l) + 1 + size(r)

walk[T](t: Tree[T], out: Vector[T]) -> Vector[T]
walk(Leaf, out) = out
walk(Node(l, x, r), out) = walk(r, walk(l, out) :+ x)

collect(items: string*) -> Vector[(int, string)]
    var out: Vector[(int, string)] = []
    var i = 0
    keep(s: string)
        out = out :+ (i, s)
        i += 1
    for s in items do keep(s)
    out

makers() -> Vector[() -> int]
    var fs: Vector[() -> int] = []
    for i in 0..2
        val k = i * 10
        fs = fs :+ (() -> k)
    fs

main()
    var t: Tree[int] = Leaf
    var seed = 7
    for i in 0..3000
        seed = (seed * 31 + 11) % 10007
        t = insert(t, seed)
    val xs = walk(t, [])
    var sorted = true
    for i in 1..(xs.length() - 1) do if xs(i - 1) >= xs(i) then sorted = false
    println(s"${size(t) == xs.length()} $sorted")
    val words: Vector[string] = (1..2000).map(n -> s"w$n").toVector()
    val c = collect(words*)
    println(s"${c.length()} ${c(0)} ${c(1999)}")
    println(makers().map(f -> f()))
    val st: Tree[string] = Node(Leaf, "m", Node(Leaf, "z", Leaf))
    val any: Tree[Any] = st
    println(s"${size(any)} ${walk(st, [])}")
