// expect: trap
// A connection a behaviour holds is the actor's from `spawn` on: the actor's own use of it works,
// and the code that spawned it traps at its next use.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.actors.{Behaviour, spawn}
import avin.threads.Promise

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

main()
  val l = ok(TcpListener.bind("127.0.0.1", 0))
  val c = ok(TcpStream.connect("127.0.0.1", l.port()))
  val s = ok(l.accept())
  ok(c.writeText("first\nsecond\n"))
  val read = Promise[Option[string]]()
  val a = spawn(Behaviour[unit]("Reader", me -> _ -> read.complete(ok(s.readLine()))))
  println("spawned")
  a.tell(())
  println(read.future.await())
  _ = s.readLine()
  println("not reached")
