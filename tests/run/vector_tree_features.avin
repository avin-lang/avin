// expect: exit 0
// A vector of many leaves does everything a short one does: it is the function from an index to
// its element, collects with a partial function, is what a repeated parameter receives, flattens
// and unzips, and has every method of an iterable.

at(f: (int) -> int, i: int) -> int = f(i)

counted(values: int*) -> string = s"${values.length()} ${values(values.length() - 1)}"

main()
    var v: Vector[int] = []
    for i in 0 ..< 5000 do v = v :+ i
    val f: (int) -> int = v
    print(s"${at(v, 4321)} ${f(1024)} ${at(v.drop(1000), 0)}")
    val tens = v.collect(match x if x % 1000 == 0 -> x / 1000)
    print(s"$tens ${tens.length()}")
    print(counted(v*))
    print(counted(1, 2, 3))
    val nested = for k in v.take(50) yield v.slice(k * 100, k * 100 + 100)
    val flat = nested.flatten()
    print(s"${nested.length()} ${flat.length()} ${flat == v}")
    val (evens, odds) = v.map(x -> (2 * x, 2 * x + 1)).unzip()
    print(s"${evens.length()} ${evens(4999)} ${odds(4999)} ${evens.sum() +% odds.sum()}")
    print(s"${v.max()} ${v.min()} ${v.sum()} ${v.take(5).mkString("+")} ${v.count(x -> x % 7 == 0)}")
    print(s"${v.find(x -> x > 4000)} ${v.indexWhere(x -> x * x > 1000000)} ${v.forall(x -> x >= 0)} ${v.exists(x -> x < 0)}")
    print(s"${v.sorted() == v} ${v.sortedBy(x -> -x).head()} ${v.foldRight(0, (x, acc) -> acc +% x)}")
    val p = for x in v if x % 999 == 0 yield x
    print(p)
    print(v.take(3).toList())
