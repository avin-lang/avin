// expect: exit 0
// The server's request, routes, router and responses, without a connection: a request's path,
// segments, query and headers read from its target; routes tried in order, parameters bound,
// `HEAD` answered by a `GET` route unless a `HEAD` route matches, `404` and `405` with `Allow`, a
// method of the program's own, Unicode patterns, an empty segment and a trailing slash; the
// response makers and the reason phrases; and a router used from another thread.
import avin.net.http
import avin.net.http.{Response, Route, Router, ServerRequest}
import avin.threads.spawn

shown(r: Response) -> string = s"${r.status} ${r.reason} ${r.headers} ${r.text}"

main()
    val q = ServerRequest("GET", "/a/b%20c/?x=1&y=%C3%A9", Vector(("Content-Type", "text/plain")), Array.empty[byte]())
    println(q.path)
    println(q.segments)
    println(s"${q.query} ${q.queryParams} ${q.version}")
    println(s"${q.header("content-type")} ${q.header("CONTENT-TYPE")} ${q.header("missing")}")
    val root = ServerRequest("POST", "/", body = Array.tabulate(3, i -> byte(int('a') + i)))
    println(s"${root.path} ${root.segments.length} ${root.query} ${root.text} ${root.params}")
    val absolute = ServerRequest("GET", "http://Example.com:8080/p%2Fq?")
    println(s"${absolute.path} ${absolute.segments} ${absolute.query}")
    println(ServerRequest("GET", "/✓//é", version = "HTTP/1.0").segments)

    val router = Router([
        Route.get("/", _ -> Response.text(200, "root")),
        Route.get("/items/:id", r -> Response.text(200, s"item ${r.param("id")}")),
        Route.get("/items/:id", _ -> Response.text(200, "never: the first route wins")),
        Route("HEAD", "/both", _ -> Response.text(200, "head route")),
        Route.get("/both", _ -> Response.text(200, "get route")),
        Route.get("/a/:x/b/:y", r -> Response.text(200, s"${r.param("x")}+${r.param("y")} ${r.params}")),
        Route.post("/items/:id", r -> Response.text(201, s"made ${r.param("id")} from ${r.text}")),
        Route.put("/items/:id", _ -> Response.empty(204)),
        Route.delete("/items/:id", _ -> Response.empty(204)),
        Route.patch("/items/:id", _ -> Response.empty(204)),
        Route("PROPFIND", "/dav", _ -> Response.text(207, "multi")),
        Route.get("/日本/:語", r -> Response.text(200, r.param("語"))),
        Route.get("/colon/:", _ -> Response.text(200, "a lone colon is a literal segment")),
        Route.get("/slash/", _ -> Response.text(200, "trailing slash"))])
    val requests = [
        ("GET", "/"), ("GET", "/items/42"), ("GET", "/items/%E2%9C%93"), ("HEAD", "/items/7"),
        ("HEAD", "/both"), ("GET", "/both"), ("GET", "/a/1/b/2"), ("PUT", "/items/1"),
        ("DELETE", "/items/1"), ("PATCH", "/items/1"), ("PROPFIND", "/dav"), ("GET", "/%E6%97%A5%E6%9C%AC/%E8%AA%9E"),
        ("GET", "/colon/:"), ("GET", "/colon/x"), ("GET", "/slash/"), ("GET", "/slash"), ("GET", "/items/"),
        ("GET", "/items"), ("GET", "/items/1/more"), ("GET", "/nowhere"), ("OPTIONS", "/items/1"),
        ("POST", "/dav"), ("POST", "/"), ("get", "/")]
    for (m, t) in requests
        println(s"$m $t -> ${shown(router.handle(ServerRequest(m, t)))}")
    println(shown(router.handle(ServerRequest("POST", "/items/9", body = Array.tabulate(2, i -> byte(int('x') + i))))))
    println(shown(Router([]).handle(ServerRequest("GET", "/"))))

    // The response makers, a header added, and the reason phrases.
    println(shown(Response.text(201, "")))
    println(shown(Response.bytes(200, Array.tabulate(2, i -> byte(int('0') + i)), "application/octet-stream").withHeader("X-A", "1").withHeader("X-B", "")))
    println(shown(Response.empty(418)))
    println([100, 200, 204, 304, 404, 413, 431, 503, 505, 299, 0, -1].map(s -> s"$s=${http.reasonPhrase(s)}"))

    // A router may be handed to another thread.
    val elsewhere = spawn(() -> router.handle(ServerRequest("GET", "/items/x")).text)
    println(elsewhere.join())
