// expect: exit 0
// `partition(p)` on a hash, tree or ordered map and on a hash, tree, ordered or bit set answers a
// pair of the collection's own kind, each part keeping the order of the whole, with `p` called once
// for each entry. Through a trait, or with a function of one pair, `partition` is `Iterable`'s and
// answers vectors.

kind(m: Any) -> string = m match
    _: HashMap[int, string] -> "hash"
    _: TreeMap[int, string] -> "tree"
    _: OrderedMap[int, string] -> "ordered"
    _: HashSet[int] -> "hashset"
    _: TreeSet[int] -> "treeset"
    _: OrderedSet[int] -> "orderedset"
    _: BitSet -> "bitset"
    _ -> "other"

main()
    val entries = [(5, "e"), (1, "a"), (4, "d"), (2, "b"), (3, "c")]

    val (hy, hn) = HashMap.from(entries).partition((k, v) -> k % 2 == 1)
    println(kind(hy), kind(hn), hy.size, hn.size, hy == HashMap((1, "a"), (3, "c"), (5, "e")), hn == HashMap((2, "b"), (4, "d")))

    val (ty, tn) = TreeMap.from(entries).partition((k, v) -> k % 2 == 1)
    println(kind(ty), kind(tn), ty, tn)
    println(ty.keys, tn.keys, ty.firstKey, tn.lastKey)

    val (oy, on) = OrderedMap.from(entries).partition((k, v) -> k % 2 == 1)
    println(kind(oy), kind(on), oy, on)
    println(oy.keys, on.keys)

    // the predicate sees the value too, and is called once for each entry
    var calls = 0
    val (big, small) = OrderedMap.from(entries).partition((k, v) ->
        calls += 1
        v >= "c")
    println(big, small, calls)

    // all, none and empty
    val m = TreeMap.from(entries)
    val (all, none) = m.partition((k, v) -> true)
    println(all == m, none.isEmpty, kind(none))
    val (none2, all2) = m.partition((k, v) -> false)
    println(none2.isEmpty, all2 == m)
    val (e1, e2) = TreeMap.empty[int, string]().partition((k, v) -> true)
    println(e1.size, e2.size, kind(e1), kind(e2))
    val (s1, s2) = OrderedMap.empty[int, string]().partition((k, v) -> true)
    println(s1.size, s2.size)
    val (h1, h2) = HashMap.empty[int, string]().partition((k, v) -> true)
    println(h1.size, h2.size)

    // the parts are independent of the whole, which is unchanged
    val whole = OrderedMap.from(entries)
    val (a, b) = whole.partition((k, v) -> k > 2)
    println(whole.size, a.updated(99, "z").size, whole.size, b.size)
    println(a.updated(1, "q"), whole)

    // an ordered map's parts keep the insertion order after removals and re-insertion
    val moved = OrderedMap((3, "c"), (1, "a"), (2, "b")).removed(1).updated(1, "A")
    val (mo1, mo2) = moved.partition((k, v) -> k != 2)
    println(mo1, mo2)

    // through a trait or a pair function it is Iterable's, with vectors
    val asMap: Map[int, string] = TreeMap.from(entries)
    val (vy, vn) = asMap.partition(e -> e.0 < 3)
    println(vy, vn)
    val (py, pn) = m.partition(e -> e.0 < 3)
    println(py, pn)

    // through Map, SortedMap and SeqMap a two-parameter predicate answers maps of the receiver's kind
    val (my, mn) = asMap.partition((k, v) -> k % 2 == 1)
    println(kind(my), kind(mn), my, mn)
    val hm: Map[int, string] = HashMap.from(entries)
    val (hmy, hmn) = hm.partition((k, v) -> k % 2 == 1)
    println(kind(hmy), kind(hmn), hmy.size, hmn.size, hmy == HashMap((1, "a"), (3, "c"), (5, "e")))
    val om: Map[int, string] = OrderedMap.from(entries)
    val (omy, omn) = om.partition((k, v) -> k % 2 == 1)
    println(kind(omy), kind(omn), omy, omn)
    val sm: SortedMap[int, string] = TreeMap.from(entries)
    val (smy, smn) = sm.partition((k, v) -> k < 3)
    println(kind(smy), kind(smn), smy, smn, smy.firstKey)
    val qm: SeqMap[int, string] = OrderedMap.from(entries)
    val (qmy, qmn) = qm.partition((k, v) -> k < 3)
    println(kind(qmy), kind(qmn), qmy, qmn)
    var tcalls = 0
    val (c1, c2) = om.partition((k, v) ->
        tcalls += 1
        true)
    println(c1.size, c2.size, tcalls)
    // the default of Map (a wrapper, a filtered view) answers a Map
    val dm: Map[int, string] = TreeMap.from(entries).withDefaultValue("?")
    val (dy, dn) = dm.partition((k, v) -> k > 3)
    println(dy.size, dn.size, dy.get(4), dn.get(4))

    // sets
    val ints = [7, 3, 9, 1, 8, 2, 70, 64, 63]
    val (hsy, hsn) = HashSet.from(ints).partition(x -> x % 2 == 0)
    println(kind(hsy), kind(hsn), hsy.size, hsn.size, hsy == HashSet(8, 2, 70, 64), hsn == HashSet(7, 3, 9, 1, 63))
    val (tsy, tsn) = TreeSet.from(ints).partition(x -> x % 2 == 0)
    println(kind(tsy), kind(tsn), tsy, tsn)
    val (osy, osn) = OrderedSet.from(ints).partition(x -> x % 2 == 0)
    println(kind(osy), kind(osn), osy, osn)
    val (bsy, bsn) = BitSet.from(ints).partition(x -> x % 2 == 0)
    println(kind(bsy), kind(bsn), bsy, bsn, bsy.toBitMask.length, bsn.toBitMask.length)

    // predicate called once per element, in iteration order
    var order = ""
    TreeSet.from([3, 1, 2]).partition(x ->
        order += s"${x}"
        x > 1)
    println(order)
    var sorder = ""
    OrderedSet.from([3, 1, 2]).partition(x ->
        sorder += s"${x}"
        x > 1)
    println(sorder)
    var border = ""
    BitSet.from([3, 1, 2]).partition(x ->
        border += s"${x}"
        x > 1)
    println(border)

    // all, none, empty
    val (ba, bn) = BitSet.from(ints).partition(x -> true)
    println(ba == BitSet.from(ints), bn.isEmpty, bn.toBitMask.length)
    val (be1, be2) = BitSet.empty().partition(x -> true)
    println(be1.size, be2.size, kind(be1))
    val (te1, te2) = TreeSet.empty[int]().partition(x -> true)
    println(te1.size, te2.size)
    val (oe1, oe2) = OrderedSet.empty[int]().partition(x -> true)
    println(oe1.size, oe2.size)
    val (he1, he2) = HashSet.empty[int]().partition(x -> true)
    println(he1.size, he2.size)
    println(osy.incl(100), osn.incl(100).size, HashSet.from(ints).size)

    // through the trait, a set's partition is Iterable's
    val asSet: Set[int] = TreeSet.from(ints)
    val (v1, v2) = asSet.partition(x -> x < 5)
    println(v1, v2)

    // GC pressure
    var big1: OrderedMap[int, int] = OrderedMap.empty[int, int]()
    for i in 0 ..< 300 do big1 = big1.updated(i, i)
    var total = 0
    for round in 0 ..< 5
        val (even, odd) = big1.partition((k, v) -> (k + round) % 2 == 0)
        total += even.size * 2 + odd.size + even.keys.head
    println(total)
    var bigSet = TreeSet.empty[int]()
    for i in 0 ..< 300 do bigSet = bigSet.incl(i * 3)
    val (sa, sb) = bigSet.partition(x -> x % 2 == 0)
    println(sa.size, sb.size, sa.head, sb.head)
