// expect: exit 0
// A value of an opaque type held as `Any` is boxed as the opaque type, whatever its representation,
// a reference included: a type pattern for the opaque type finds it, one for the representation does
// not, and a value of the representation is not taken for the opaque type. Generic opaque types are
// told apart by their type arguments. A value with no `Display` prints as its type's name, which
// shows nothing of the representation.

data Pt(x: int, y: int)

opaque type Name = string
opaque type UserId = long
opaque type Point = Pt
opaque type Names = Vector[string]
opaque type Tag[T] = long

kind(x: Any) -> string = x match
  _: string -> "string"
  _: long -> "long"
  _: Pt -> "pt"
  _: Vector[string] -> "vector"
  _: Name -> "name"
  _: UserId -> "user"
  _: Point -> "point"
  _: Names -> "names"
  _: Tag[int] -> "int tag"
  _: Tag[string] -> "string tag"
  _ -> "other"

isString(a: Any) -> bool = a is _: string

isName(a: Any) -> bool = a is _: Name

isLong(a: Any) -> bool = a is _: long

isUser(a: Any) -> bool = a is _: UserId

main()
  println(kind(Name("x")))
  println(kind(UserId(1)))
  println(kind(Point(Pt(1, 2))))
  println(kind(Names(["a"])))
  println(kind(Tag[int](1)))
  println(kind(Tag[string](1)))
  println(kind(Tag[bool](1)))
  println(kind("s"))
  println(kind(long(1)))
  println(kind(Pt(1, 1)))
  println(kind(["a"]))
  println(isString(Name("x")))
  println(isName("x"))
  println(isName(Name("x")))
  println(isLong(UserId(1)))
  println(isUser(long(1)))
  println(isUser(UserId(1)))
  val w: Any = Tag[string](1)
  println(w is _: Tag[string])
  println(w is _: Tag[int])
  println(w is _: UserId)
  val name: Any = Name("hi")
  println(name == "hi")
  println(name == Name("hi"))
  if name is n: Name then println(n.repr)
  println(UserId(1))
  println(Point(Pt(1, 2)))
