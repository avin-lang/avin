// expect: exit 0
// `format(pattern)`: every element, padded and unpadded, on a reading whose every field is a single
// digit and on one whose fields are two; the twelve-hour clock at midnight, noon and either side;
// quoted text and the escaped bar; characters that are no element standing for themselves; and a
// pattern on a `Date`, a `Time`, a `DateTime` and a `Zoned`.
import avin.time.{Duration, epochSeconds, epochMicros, utc, fixedZone, zone, hours, minutes, date, time, dateTime}

main()
    // 2026-08-05T07:04:09.012345Z, a Wednesday, the 217th day of the year.
    val small = epochMicros(1785913449012345).atZone(utc)
    println(small.format("Y YY YYYY"))
    println(small.format("M MM MMM MMMM"))
    println(small.format("D DD DDD"))
    println(small.format("WWW WWWW"))
    println(small.format("h hh h12 hh12 a A"))
    println(small.format("m mm s ss"))
    println(small.format("f ff fff ffff fffff ffffff"))
    println(small.format("z zz zzz zzzz"))

    // 2026-08-28T17:24:15Z in Toronto: 13:24:15 EDT, a Friday.
    val toronto = zone("America/Toronto").getOrElse(utc)
    val t = epochSeconds(1787937855).atZone(toronto)
    println(t.format("WWWW, MMMM D, Y |at| h12:mm a"))
    println(t.format("YYYY-MM-DDThh:mm:ss.fffZ"))
    println(t.format("z zz zzz zzzz"))
    println(t.format("hh12 A"))

    // A fixed zone: its abbreviation and its name are the offset.
    val india = fixedZone(hours(5) + minutes(30))
    println(epochSeconds(0).atZone(india).format("hh:mm z zz zzz zzzz"))
    println(epochSeconds(0).atZone(fixedZone(-(hours(9) + minutes(30)))).format("hh:mm z zz zzz zzzz"))
    println(epochSeconds(0).atZone(utc).format("z zz zzz zzzz"))

    // The twelve-hour clock: midnight and noon are 12, and am turns to pm at noon.
    for h in [0, 1, 11, 12, 13, 23] do println(time(h, 5).format("h12 hh12 a A || h hh"))

    // Quoted text, an escaped bar outside and inside the bars, an empty quote, and characters that
    // are no element.
    val d = date(2026, 1, 2)
    println(d.format("|Year:| Y"))
    println(d.format("Y||M||D"))
    println(d.format("|a||b| D"))
    println(d.format("||||"))
    println(d.format("|| D"))
    println(d.format("Y-M-D T Q x é ✓"))
    println(d.format(""))
    println(d.format("MMMMDD"))

    // Every month's and every weekday's names.
    for m in 1..<13 do println(date(2026, m, 1).format("M MM MMM MMMM WWW WWWW"))

    // Each kind of value.
    println(date(2026, 8, 28).format("WWW D MMM YYYY"))
    println(time(9, 5, 7, 120000).format("hh:mm:ss.ff"))
    println(dateTime(2026, 8, 28, 17, 24, 15).format("YYYY-MM-DD hh:mm:ss"))
    println(time(0, 0).format("h:mm:ss.ffffff"))
    println(time(23, 59, 59, 999999).format("hh:mm:ss.ffffff f"))
