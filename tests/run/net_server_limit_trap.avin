// expect: trap
// A server holds at least one connection, so a limit of zero traps where the server is started.
import avin.net.TcpServer

main()
    println(TcpServer.start("127.0.0.1", 0, (s, _) -> s.close(), maxConnections = 1).map(s -> s.shutdown()).isOk)
    println(TcpServer.start("127.0.0.1", 0, (s, _) -> s.close(), maxConnections = 0).isOk)
