// expect: exit 0
// The lazy transformations an iterator has beyond `map` and the rest: `++` and `concat`, `scanLeft`,
// `grouped`, `sliding`, `distinct`, `distinctBy`, `zipAll`, `padTo`, `tapEach`, `buffered` with
// `peek` and `peekOption`, and `flatten` of an iterator of collections. Each reads its source only as
// far as it is asked, which an endless source and counted reads prove, and each answers an iterator.
class Naturals(private var n: int, private var reads: int): Iterator[int]
    override hasNext() -> bool = true
    override next() -> int
        reads += 1
        n += 1
        n
    readCount() -> int = reads

// A collection that counts how many times it is asked for an iterator.
class Counted(val items: Vector[int], private var asked: int): Iterable[int]
    override iterator() -> Iterator[int]
        asked += 1
        items.iterator()
    askedCount() -> int = asked

open class Animal(val name: string)
class Cat(n: string): Animal(n)
class Dog(n: string): Animal(n)

// The lazy forms used where the element type is a parameter.
windows[T](items: Vector[T], size: int, step: int) -> Vector[Vector[T]] = items.iterator().sliding(size, step).toVector

uniqueOf[T](items: Iterable[T]) -> Vector[T] = items.iterator().distinct.toVector

main()
    // ++ and concat: the other side's iterator asked for only once these elements are used up.
    val tail = Counted([8, 9], 0)
    val joined = [1, 2].iterator() ++ tail
    println(tail.askedCount())
    println(joined.next())
    println(joined.next())
    println(tail.askedCount())
    println(joined.hasNext())
    println(tail.askedCount())
    println(joined.toVector)
    println(tail.askedCount())
    println(joined.hasNext())
    val empty: Vector[int] = []
    println((empty.iterator() ++ empty).hasNext())
    println((empty.iterator() ++ [1]).toVector)
    println([1].iterator().concat(empty).toVector)
    println(([1].iterator() ++ Naturals(10, 0)).take(3).toVector)
    println((Naturals(0, 0) ++ [0]).take(2).toVector)
    val cats: Vector[Cat] = [Cat("tom")]
    val dogs: Vector[Dog] = [Dog("rex")]
    val pets: Iterator[Animal] = cats.iterator() ++ dogs
    println(pets.map(a -> a.name).toVector)
    println(cats.iterator().concat(dogs).map(a -> a.name).mkString("+"))
    println(["a", "b"].iterator().concat(["é"]).toVector)

    // scanLeft: `initial` first, then each partial result, `f` called as each is read.
    var folds = 0
    val add: (int, int) -> int = (a, x) ->
        folds += 1
        a + x
    val running = Naturals(0, 0).scanLeft(0, add)
    println(folds)
    println(running.next())
    println(folds)
    println(running.take(4).toVector)
    println(folds)
    println(empty.iterator().scanLeft(7, add).toVector)
    println([1].iterator().scanLeft("", (s, x) -> s + s"$x").toVector)
    println(["a", "b", "c"].iterator().scanLeft(List.empty[string](), (acc, s) -> s :: acc).toVector)

    // grouped and sliding: windows read when asked for; an endless source gives endless windows.
    val nat = Naturals(0, 0)
    val groups = nat.grouped(3)
    println(nat.readCount())
    println(groups.next())
    println(nat.readCount())
    println(groups.next())
    println(nat.readCount())
    val nat2 = Naturals(0, 0)
    val pairs = nat2.sliding(2)
    println(pairs.take(3).toVector)
    println(nat2.readCount())
    val nat3 = Naturals(0, 0)
    println(nat3.sliding(2, 4).take(2).toVector)
    println(nat3.readCount())
    println(empty.iterator().grouped(2).hasNext())
    println(empty.iterator().sliding(3, 7).toVector)
    println([5].iterator().sliding(4).toVector)
    println([5].iterator().grouped(1).toVector)
    println((1..7).iterator().grouped(7).toVector)
    println((1..7).iterator().grouped(100).toVector)
    println((1..7).iterator().sliding(3).toVector)
    println((1..7).iterator().sliding(3, 3).toVector)
    println((1..7).iterator().sliding(2, 3).toVector)
    println((1..6).iterator().sliding(2, 5).toVector)
    println((1..5).iterator().sliding(2, 5).toVector)
    println(windows(["ä", "b", "ç"], 2, 1))
    println(windows([(1, 'x'), (2, 'y')], 1, 2))

    // Every window shape agrees with a sequence's own `sliding`, for lengths 0 to 9, sizes 1 to 5 and
    // steps 1 to 6.
    var agreed = 0
    var differed = 0
    for length in 0 ..< 10
        val items = Vector.tabulate(length, i -> i)
        for size in 1 ..< 6
            for step in 1 ..< 7
                val lazy = items.iterator().sliding(size, step).toVector
                val eager = items.sliding(size, step).toVector
                if lazy == eager then agreed += 1 else differed += 1
                if size == step
                    if items.iterator().grouped(size).toVector == items.grouped(size).toVector then agreed += 1 else differed += 1
    println(s"$agreed agreed, $differed differed")

    // distinct and distinctBy: each element tested as it is read, so an endless source works.
    println([3, 1, 3, 2, 1].iterator().distinct.toVector)
    println(Naturals(0, 0).map(x -> x % 4).distinct.take(4).toVector)
    var keyed = 0
    val parity: (int) -> int = x ->
        keyed += 1
        x % 2
    val byParity = Naturals(0, 0).distinctBy(parity)
    println(byParity.take(2).toVector)
    println(keyed)
    println(empty.iterator().distinct.hasNext())
    println(["b", "B", "a", "b", "A"].iterator().distinctBy(s -> s.toLowerCase).toVector)
    println(uniqueOf([(1, "x"), (1, "y"), (1, "x")]))
    println(uniqueOf(Set(2, 2)))
    println([Some(1), None, Some(1), None].iterator().distinct.toVector)

    // zipAll: as many pairs as the longer side, the shorter side's place filled.
    println([1, 2, 3].iterator().zipAll(["a"], 0, "-").toVector)
    println([1].iterator().zipAll(["a", "b", "c"], 0, "-").toVector)
    println(empty.iterator().zipAll(empty, 0, 0).toVector)
    println(empty.iterator().zipAll(["z"], -1, "").toVector)
    println(Naturals(0, 0).zipAll([10, 20], 0, 0).take(3).toVector)
    println([1, 2].iterator().zipAll(Naturals(100, 0), -1, -1).take(4).toVector)

    // padTo: elements followed by copies of the padding up to `total`.
    println([1].iterator().padTo(4, 0).toVector)
    println([1, 2, 3].iterator().padTo(2, 0).toVector)
    println([1, 2].iterator().padTo(2, 0).toVector)
    println(empty.iterator().padTo(3, 9).toVector)
    println(empty.iterator().padTo(0, 9).toVector)
    println(empty.iterator().padTo(-5, 9).hasNext())
    println(Naturals(0, 0).padTo(2, 0).take(4).toVector)
    println(["é"].iterator().padTo(3, "·").mkString())

    // tapEach: `f` called with each element as it is read, and no other.
    val seen = Buffer[int]()
    val tapped = Naturals(0, 0).tapEach(x -> seen.addOne(x))
    println(seen.toVector)
    println(tapped.take(3).toVector)
    println(seen.toVector)
    println(empty.iterator().tapEach(x -> seen.addOne(x)).toVector)
    println(seen.length)

    // buffered: peek and peekOption look at the next element without moving past it.
    val nat4 = Naturals(0, 0)
    val ahead = nat4.buffered()
    println(nat4.readCount())
    println(ahead.peek())
    println(ahead.peek())
    println(nat4.readCount())
    println(ahead.next())
    println(ahead.next())
    println(ahead.peekOption())
    println(nat4.readCount())
    val short = [7].iterator().buffered()
    println(short.peekOption())
    println(short.hasNext())
    println(short.next())
    println(short.peekOption())
    println(short.hasNext())
    println(empty.iterator().buffered().peekOption())
    val words = ["a", "a", "b", "c", "c", "c"].iterator().buffered()
    val runs = Buffer[string]()
    while words.hasNext()
        val w = words.next()
        var n = 1
        while words.peekOption() == Some(w)
            words.next()
            n += 1
        runs.addOne(s"$w$n")
    println(runs.toVector)
    println([1, 2, 3].iterator().buffered().map(x -> x * 2).toVector)
    val again = [1, 2].iterator().buffered()
    println(again.peek())
    println(again.buffered().toVector)

    // flatten: an iterator of collections joins their elements, reading each when it is reached.
    println([[1, 2], [], [3]].iterator().flatten.toVector)
    val nested = Naturals(0, 0).map(n -> Vector.tabulate(n, i -> n))
    println(nested.flatten.take(6).toVector)
    val ofIterators = [Naturals(0, 0), Naturals(100, 0)].iterator()
    println(ofIterators.flatten.take(3).toVector)
    val sets: Vector[Set[string]] = [Set("x"), Set(), Set("y")]
    println(sets.iterator().flatten.toVector)
    val lists: Vector[List[int]] = []
    println(lists.iterator().flatten.hasNext())

    // The transformations chain, still lazy, and the result is an ordinary iterator.
    val nat5 = Naturals(0, 0)
    val chain = nat5.distinctBy(x -> x / 2).scanLeft(0, (a, x) -> a + x).sliding(2).map(w -> w.sum).take(3)
    println(nat5.readCount())
    println(chain.toVector)
    println(nat5.readCount())

    // Many allocations through the windows, as a collector running at every allocation sees them.
    val texts = Iterator.tabulate(3000, i -> s"t$i").sliding(5, 3).map(w -> w.mkString("")).toVector
    println(texts.length)
    println(texts(999))
    println(Iterator.from(0).map(i -> s"$i").grouped(50).take(40).map(g -> g.length).sum)
