// expect: trap
// `IpAddress.v4` takes each part from 0 to 255; the edges are addresses, and a part past them is a
// mistake in the program, which traps.
import avin.net.IpAddress

main()
  println(IpAddress.v4(0, 0, 0, 0))
  println(IpAddress.v4(255, 255, 255, 255))
  println(IpAddress.v4(10, 256 - 1, 0, 1))
  println(IpAddress.v4(10, 0, 0, 256))
  println("not reached")
