// expect: exit 0
// Comprehensions over the mutable collections: one generator, a guard, two generators and a value
// definition a guard follows, over an array, a buffer, a deque, a mutable set and a mutable map. The
// first source decides the result, a new collection of its own kind that the comprehension leaves
// the source unchanged beside; a map's entries reach it as pairs. A guard tests each element just
// before the call after it uses it, element by element.

import avin.collections.mutable.{Map as MutableMap, Set as MutableSet}

seen(tag: string, x: int) -> int
    println(s"$tag $x")
    x

main()
    val ys: List[int] = [10, 20]

    val array = Array.tabulate(4, i -> i + 1)
    val doubled: Array[int] = for x in array yield x * 2
    println(doubled)
    println(for x in array if x % 2 == 0 yield x)
    println(for x in array, y in ys if x < 3 yield x + y)
    println(for x in array, y = x * x if y > 4 yield y)
    println(array)

    val buffer: Buffer[int] = [1, 2, 3]
    val grown: Buffer[int] = for x in buffer yield x + 1
    grown += 9
    println(grown)
    println(for x in buffer if x != 2 yield x)
    println(for x in buffer, y in ys yield x * y)
    println(for x in buffer, y = x * 3 if y > 3, z in [y] yield z)
    println(buffer)

    val deque: Deque[int] = [1, 2, 3]
    val shifted: Deque[int] = for x in deque yield x - 1
    shifted.addFirst(7)
    println(shifted)
    println(for x in deque if x > 1 yield x)
    println(for x in deque, y in ys if y > 10 yield x + y)
    println(for x in deque, y = -x if y < -1 yield y)
    println(deque)

    val set = MutableSet[int]()
    set ++= [1, 2, 3]
    val tens: MutableSet[int] = for x in set yield x * 10
    tens += 5
    println(tens.size(), tens.contains(5), tens.contains(30))
    println((for x in set if x > 1 yield x).size())
    println((for x in set, y in ys yield x + y).contains(23))
    val squares = for x in set, y = x * x if y > 1 yield y
    println(squares.contains(4), squares.contains(9), squares.size())
    // Elements that map alike become one.
    println((for x in set yield x % 2).size())
    println(set.size())

    val ages = MutableMap[string, int]()
    ages("ann") = 30
    ages("bo") = 12
    val older: MutableMap[string, int] = for (name, age) in ages yield (name, age + 1)
    older("cy") = 1
    println(older("ann"), older("bo"), older("cy"))
    val adults = for (name, age) in ages if age >= 18 yield (name, age)
    println(adults.size(), adults.contains("ann"))
    val tagged = for (name, age) in ages, n in [1, 2] yield (s"$name$n", age * n)
    println(tagged.size(), tagged("ann2"), tagged("bo1"))
    val decades = for (name, age) in ages, decade = age / 10 if decade > 1 yield (name, decade)
    println(decades.size(), decades("ann"))
    println(ages.size(), ages("ann"))

    // A guard runs in turn with the rest of the comprehension.
    val buffered: Buffer[int] = [1, 2, 3]
    println(for x in buffered if seen("guard", x) != 2 yield seen("yield", x))
