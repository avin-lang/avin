// Method values made in every kind of scope: inside a lambda in a method, in a class body, in a
// generic function, in a module-level value, and of a method with a by-name parameter.

ignore(n: int) = ()

class Tally(var total: int)
  add(n: int) = total += n
  // A bare method name inside a lambda in a method binds the `self` the lambda captures.
  adder() -> () -> (int) -> unit = () -> add
  // Made in the class body, which is the constructor, once every field is initialized.
  var own: (int) -> unit = ignore
  own = add
  unless(flag: bool, n: -> int) -> int = if flag then 0 else n

object Log
  var lines = 0
  note(s: string) -> int
    lines += 1
    println(s)
    lines

// A module-level value holding a method value of an object.
val logger: (string) -> int = Log.note

class Holder[T](var value: T)
  set(v: T) = value = v

setter[T](h: Holder[T]) -> (T) -> unit = h.set

var reads = 0

read(n: int) -> int
  reads += 1
  n

main() -> int
  val t = Tally(0)
  t.adder()()(3)
  t.own(4)
  println(s"${t.total}")
  // A by-name parameter stays by-name in the value's type.
  val u = t.unless
  println(s"${u(true, read(5))} ${u(false, read(6))} $reads")
  logger("one")
  println(s"${logger("two")}")
  val h = Holder("a")
  val s = setter(h)
  s("b")
  println(h.value)
  0
