// expect: exit 0
// A program whose only lightweight threads are pinned to the main thread starts no worker, and their
// sleeps and timed waits still end: the timers that end them run from the first pinned thread on.
import avin.threads.{Channel, runMainThreads, sleep, spawnOnMain}
import avin.time.millis

main()
  val slept = spawnOnMain(() ->
    sleep(millis(3))
    "slept")
  println(runMainThreads())
  println(slept.join())
  val c = Channel[int]()
  println(spawnOnMain(() -> c.receive(millis(3))).join())
  // The main thread's own timed wait, while a pinned thread sleeps.
  val late = spawnOnMain(() ->
    sleep(millis(2))
    c.send(5))
  println(c.receive(millis(2000)))
  late.join()
