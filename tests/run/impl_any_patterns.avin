// A conformance an impl states is part of the type's record, so a type pattern on an `Any` matches a
// data value, a class instance or an object by a trait an impl gave it, and by the traits that trait
// requires; a value whose type conforms to nothing else does not match.
trait Named
    label() -> string

trait Tagged: Named
    tag() -> string = s"<${label()}>"

data Shape
    Circle(r: int)
    Dot

impl Tagged for Shape
    label() -> string = self match
        Circle(r) -> s"circle $r"
        Dot -> "dot"

class Rect(w: int, h: int)

impl Named for Rect
    label() -> string = s"rect ${w}x$h"

object Origin

impl Named for Origin
    label() -> string = "origin"

data Box[T](value: T)

impl[T] Named for Box[T]
    label() -> string = "box"

data Plain(n: int)

describe(x: Any) -> string = x match
    t: Tagged -> "tagged " + t.tag()
    n: Named -> "named " + n.label()
    _ -> "something else"

main()
    print(describe(Circle(2)))
    print(describe(Dot))
    print(describe(Rect(1, 2)))
    print(describe(Origin))
    print(describe(Box(1)))
    print(describe(Box("s")))
    print(describe(Plain(3)))
    print(describe((Dot, 1)))
