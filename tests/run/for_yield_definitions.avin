// expect: exit 0
// Value definitions between a comprehension's generators: after a generator or after another
// definition, with or without guards after them, in the comma and block forms, taking values apart
// by patterns, over lists, ranges, options, maps and a type of the program's own. A definition is
// evaluated once for each element that reaches it and binds in its guards, the later generators and
// the yielded value; one a guard follows pairs the elements with its value through `map`, so it is
// evaluated for every element before that guard tests any.

// One value or none, with the three methods a comprehension calls.
class Maybe[T](private val value: Option[T])
    map[U](f: (T) -> U) -> Maybe[U] = Maybe(value.map(f))
    flatMap[U](f: (T) -> Maybe[U]) -> Maybe[U] = value match
        Some(v) -> f(v)
        None -> Maybe(None)
    withFilter(p: (T) -> bool) -> Maybe[T] = Maybe(value.filter(p))
    get() -> Option[T] = value

seen(tag: string, x: int) -> int
    println(s"$tag $x")
    x

main()
    val xs: List[int] = [1, 2, 3]

    // After the last generator, and between two.
    println(for x in xs, y = x * 10 yield x + y)
    println(for x in xs, y = x + 1, z in [y, y * 10] yield z)
    // Several in a row, each seeing the ones before it.
    println(for x in xs, y = x + 1, z = y * 2 yield (x, y, z))

    // Patterns: a tuple, a nested tuple, a data value and `_`, whose value is still evaluated.
    println(for x in xs, (a, b) = (x, x * x) yield a + b)
    println(for x in xs, (a, (b, c)) = (x, (x + 1, x + 2)) yield a * b * c)
    val pairs: List[(string, int)] = [("a", 1), ("b", 2)]
    println(for (name, n) in pairs, (upper, twice) = (name.repeat(2), n * 2) yield s"$upper$twice")
    println(for x in [5, 6], _ = seen("wildcard", x) yield x)

    // Guards after a definition see it; guards before it do not need it.
    println(for x in xs, y = x * x if y > 1 yield y)
    println(for x in xs if x != 2, y = x * 3 if y < 9 yield y)
    println(for x in xs, y = x + 1 if y > 2, z = y * 2 if z > 6 yield (x, y, z))
    println(for x in xs, (a, b) = (x, -x) if a + b == 0 if a > 1 yield b)
    println(for x in xs, y = x if y != 2, z in [y, y + 100] yield z)

    // A later generator may bind a name an earlier one bound; a definition after it rebinds the
    // earlier generator's name, which the later generator's scope does not hold.
    println(for x in xs, y in [x * 10], x = y + 1 yield x)

    // Each element binds the definition anew, so a closure keeps the value it saw.
    val adders = for x in xs, step = x * 100 yield (n: int) -> n + step
    println(for f in adders yield f(1))

    // The block form: definitions one to a line, with guards on the lines after them.
    val grid = for
        row in 0 ..< 3
        start = row * 10
        if start != 10
        col in 0 ..< 2
        cell = start + col
    yield cell * 2
    println(grid)

    // Over a range, an option, a map and a type of the program's own.
    println(for i in 1 .. 4, square = i * i if square % 2 == 0 yield square)
    println(for o in Some(3), p = o + 1 if p > 3 yield p)
    println(for o in Some(3), p = o + 1 if p > 9 yield p)
    val ages = Map(("ann", 30), ("bo", 12))
    println(for (name, age) in ages, adult = age >= 18 if adult yield (name, age))
    println(for (name, age) in ages, next = age + 1 yield (name, next))
    println((for x in Maybe(Some(2)), y = x * 5 if y > 5, z in Maybe(Some(y)) yield z + 1).get())
    println((for x in Maybe(Some(1)), y = x * 5 if y > 5, z in Maybe(Some(y)) yield z + 1).get())

    // Evaluation counts: a definition no guard follows runs once per element, interleaved with the
    // rest of the comprehension; one a guard follows runs once per element, all before its guard.
    val inline = for
        x in [1, 2]
        y = seen("inline", x)
        z in [seen("inner", y)]
    yield seen("yield", z)
    println(inline)
    val guarded = for
        x in [1, 2, 3]
        y = seen("paired", x)
        if seen("guard", y) != 2
    yield seen("yield", y)
    println(guarded)
    val filtered = for
        x in [1, 2, 3]
        if seen("before", x) != 1
        y = seen("paired", x)
        if y != 3
    yield y
    println(filtered)
