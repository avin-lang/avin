// expect: exit 0
// Every collection's `flatMap` takes a function answering an option and keeps the values, in a
// collection of its own kind; a collection of options flattens; and a `for` comprehension draws from
// collections and options alike, in either order. The option's own methods still answer options.
import avin.collections.mutable

parse(s: string) -> Option[int] = s.toIntOption()

positive(n: int) -> Option[int] = if n > 0 then Some(n) else None

// A generic function passing an option-making function on.
kept[T, U](xs: Vector[T], f: (T) -> Option[U]) -> Vector[U] = xs.flatMap(f)

// The same through `Iterable`, which every collection is.
keptAny[T, U](xs: Iterable[T], f: (T) -> Option[U]) -> Iterable[U] = xs.flatMap(f)

data Event(user: string, score: int)

fromText(line: string) -> Option[Event] = line.split(":").toVector match
    [user, score] -> score.toIntOption().map(n -> Event(user, n))
    _ -> None

main()
    val words = ["1", "x", "3", "", "-7", "٣"]
    println(words.flatMap(_.toIntOption()))
    println(words.flatMap(parse))
    println(words.flatMap(w -> parse(w)))
    println(List("4", "y", "5").flatMap(parse))
    val array: Array[string] = ["6", "z"]
    println(array.flatMap(parse))
    val buffer: Buffer[string] = ["7", "8"]
    println(buffer.flatMap(parse))
    val deque: Deque[string] = ["9", "q"]
    println(deque.flatMap(parse))
    val arraySeq: ArraySeq[string] = ["10", "11"]
    println(arraySeq.flatMap(parse))
    val set: Set[string] = {"12", "w"}
    println(set.flatMap(parse))
    // An endless lazy list keeps its laziness through options.
    println(LazyList.from(1).flatMap(n -> if n % 3 == 0 then Some(n) else None).take(3).toVector)
    println(["14", "u"].iterator().flatMap(parse).toVector)
    println((1..5).flatMap(n -> if n % 2 == 0 then Some(n * n) else None))
    val ms: mutable.Set[string] = {"15", "t"}
    println(ms.flatMap(parse))
    val empty: Vector[string] = []
    println(empty.flatMap(parse))
    println(["none"].flatMap(parse))

    // Generic instances, method values and closures capturing.
    println(kept(["1", "2", "b"], parse))
    println(kept([-1, 2, 0, 3], positive))
    val limit = 2
    println([1, 2, 3, 4].flatMap(n -> if n <= limit then Some(n) else None))
    println(["a:1", "b", "c:x", "d:4"].flatMap(fromText))
    // A lambda taking a pair apart chooses by its body too.
    val pairs = [1, 5, 3].zip([4, 2, 3])
    println(pairs.flatMap((a, b) -> if a > b then Some(a - b) else None), pairs.flatMap((a, b) -> [a, b]))
    println(List(("x", 1)).flatMap((s, n) -> Some(s"$s$n")))

    // A map's entries made into options: a pair keeps a map, anything else a collection.
    val m: Map[string, int] = {"a": 1, "b": -2}
    println(m.flatMap(e -> if e.1 > 0 then Some((e.0, e.1 * 10)) else None))
    println(m.flatMap(e -> positive(e.1)))
    println(m.flatMap((k, v) -> if v > 0 then Some((v, k)) else None), m.flatMap((k, v) -> positive(v)))

    println(keptAny(List("2", "c"), parse), keptAny(ms, parse))
    val tm: TreeMap[int, string] = {2: "b", 1: "a"}
    println(tm.flatMap(e -> if e.0 > 1 then Some((e.1, e.0)) else None), tm.flatMap(e -> Some(e.1)))
    val mm: mutable.Map[string, int] = {"k": 3}
    println(mm.flatMap(e -> Some((e.1, e.0))), mm.flatMap(e -> positive(e.1)))
    val lm = mutable.LinkedMap[string, int]()
    lm("p") = 5
    println(lm.flatMap(e -> Some((e.1, e.0))), lm.flatMap(e -> positive(e.1)))

    // Flattening collections and iterators of options.
    println([Some(1), None, Some(3)].flatten)
    println(List(Some("a"), None).flatten)
    println([None, Some('é')].iterator().flatten.toVector)
    val nothingThere: Vector[Option[int]] = [None, None]
    println(nothingThere.flatten)
    val none: Option[int] = None

    // Comprehensions drawing from collections and options alike.
    println(for w in words, n in parse(w) yield n * 2)
    println(for w in words, n in parse(w) if n > 1 yield n)
    println(for w in words if w != "", n in parse(w) yield n)
    println(for w in List("1", "z"), n in parse(w) yield n)
    println(for w in array if w != "", n in parse(w) yield n)
    println(for w in set if w != "", n in parse(w) yield n)
    println(for w in ms if w != "", n in parse(w) yield n)
    println(for (k, v) in m if v != 0, n in positive(v) yield n)
    println(for (k, v) in m if v != 0, n in positive(v) yield (k, n))
    println(for (k, v) in tm if k > 0, s in Some(v) yield s)
    println(for (k, v) in mm if v > 0, n in positive(v) yield (k, n))
    println(for a in Some(1), b in Some(2) yield a + b)
    println(for a in Some(1), b in none yield a + b)
    println(for a in Some(2), b in [10, 20] yield a * b)

    // An option's own methods answer options.
    val two: Option[int] = Some(2)
    println(two.map(x -> x + 1), two.flatMap(x -> Some(x * 10)), two.flatMap(positive), none.flatMap(positive))
    println(two.filter(_ > 5), two.zip(Some("z")), Some(Some(4)).flatten)
    println(two.flatMap(x -> None), none.flatMap(x -> Some(x)))
    // A function answering a collection makes a vector of its elements, or none for `None`.
    println(two.flatMap(x -> [x, x]), none.flatMap(x -> [x, x]), two.flatMap(x -> List(x)))
    var seen = 0
    for x in two do seen += x
    for x in none do seen += 100
    println(seen)

    // Many short-lived options under collection.
    var big: Vector[int] = []
    for i in 0..<2000 do big = big :+ i
    println(big.flatMap(i -> if i % 500 == 0 then Some(s"#$i") else None))
