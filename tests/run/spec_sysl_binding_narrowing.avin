// expect: exit 0
// An integer parameter goes into whatever integer the Sysl parameter is, converted with a check: a
// `long` reaches an `i32` parameter where its value fits, and a narrow Avin integer a wide one.

@sysl("sysl.time.days_in_month")
daysInMonth(year: long, month: i8) -> int

main()
    println(daysInMonth(2024, 2))
    println(daysInMonth(2023, 2))
    println(daysInMonth(-2147483648, 12))
    println(daysInMonth(2147483647, 4))
