// expect: exit 1
// args: --count 2 --count abc
// `parse` answers an `ArgsError`, an `Error`, so a `main` answering a `Result` can pass it on with
// `?`: the program writes `error: ` and what was wrong, and exits with 1.
import avin.cli

val parser = cli.Parser("count").int("count", short = 'c')

main(args: Vector[string]) -> Result[unit, cli.ArgsError]
  println("parsing")
  val a = parser.parse(args)?
  println(s"not reached: ${a.int("count")}")
  Ok(())
