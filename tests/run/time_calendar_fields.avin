// expect: exit 0
// Replacing a field, the starting points, the weekday searches and the days between dates, on
// `Date`, `Time` and `DateTime`: month ends (31 to 30, February 29 to 28), leap years (2000, 1900,
// 2024, 2100, year 0), year boundaries, every weekday as a start, negative years, and the least and
// greatest dates where an answer still fits.
import avin.time.{Date, Time, DateTime, Weekday, date, time, dateTime}

main()
  // withYear and withMonth clamp the day to the new month; withDay does not.
  println(date(2024, 2, 29).withYear(2025))
  println(date(2024, 2, 29).withYear(2028))
  println(date(2024, 2, 29).withYear(2000))
  println(date(2024, 2, 29).withYear(1900))
  println(date(2024, 2, 29).withYear(2100))
  println(date(2024, 2, 29).withYear(0))
  println(date(2024, 2, 29).withYear(-1))
  println(date(2024, 2, 29).withYear(10000))
  println(date(2026, 1, 31).withMonth(2))
  println(date(2024, 1, 31).withMonth(2))
  println(date(2026, 3, 31).withMonth(4))
  println(date(2026, 5, 31).withMonth(6))
  println(date(2026, 5, 31).withMonth(7))
  println(date(2026, 8, 30).withMonth(2))
  println(date(2026, 1, 15).withMonth(12))
  println(date(2026, 12, 15).withMonth(1))
  println(date(2026, 2, 1).withDay(28))
  println(date(2024, 2, 1).withDay(29))
  println(date(2026, 4, 1).withDay(30))
  println(date(2026, 12, 1).withDay(31))
  println(date(2026, 3, 9).withDay(1))
  // A field replaced by its own value is the same date.
  val same = date(2026, 3, 9)
  println(same.withYear(2026) == same && same.withMonth(3) == same && same.withDay(9) == same)

  // Starting points of a date.
  println(date(2026, 8, 28).startOfYear)
  println(date(2026, 1, 1).startOfYear)
  println(date(2026, 12, 31).startOfYear)
  println(date(2026, 8, 28).startOfMonth)
  println(date(2026, 3, 1).startOfMonth)
  println(date(2026, 1, 15).endOfMonth)
  println(date(2026, 2, 1).endOfMonth)
  println(date(2024, 2, 1).endOfMonth)
  println(date(2000, 2, 10).endOfMonth)
  println(date(1900, 2, 10).endOfMonth)
  println(date(2100, 2, 10).endOfMonth)
  println(date(0, 2, 10).endOfMonth)
  println(date(2026, 4, 30).endOfMonth)
  println(date(2026, 12, 31).endOfMonth)
  println(date(-1, 12, 31).startOfYear)

  // startOfWeek is the Monday, from every day of a week that crosses a year's end.
  var d = date(2026, 12, 28)
  while d <= date(2027, 1, 3)
    println(s"$d ${d.weekday} -> ${d.startOfWeek} ${d.startOfWeek.weekday}")
    d = Date(d.epochDay + 1)
  println(date(1970, 1, 1).startOfWeek)

  // onOrAfter and onOrBefore from a Friday to every weekday; a Friday's own is itself.
  val friday = date(2026, 8, 28)
  for w in [
    Weekday.Monday,
    Weekday.Tuesday,
    Weekday.Wednesday,
    Weekday.Thursday,
    Weekday.Friday,
    Weekday.Saturday,
    Weekday.Sunday
  ]
    println(s"$w ${friday.onOrAfter(w)} ${friday.onOrBefore(w)}")
  println(date(2026, 12, 30).onOrAfter(Weekday.Monday))
  println(date(2027, 1, 2).onOrBefore(Weekday.Thursday))
  println(date(2024, 2, 27).onOrAfter(Weekday.Thursday))

  // The days between dates, across a leap day, a century that is not leap, and backwards.
  println(date(2026, 1, 31).daysUntil(date(2026, 3, 1)))
  println(date(2024, 1, 31).daysUntil(date(2024, 3, 1)))
  println(date(1900, 2, 28).daysUntil(date(1900, 3, 1)))
  println(date(2000, 2, 28).daysUntil(date(2000, 3, 1)))
  println(date(2026, 3, 1).daysUntil(date(2026, 1, 31)))
  println(date(2026, 3, 1).daysUntil(date(2026, 3, 1)))
  println(date(2000, 1, 1).daysUntil(date(2400, 1, 1)))
  println(date(1970, 1, 1).daysUntil(date(-1, 12, 31)))
  println(date(1970, 1, 1).daysUntil(Date.Min))
  println(date(1970, 1, 1).daysUntil(Date.Max))
  println(Date.Max.daysUntil(Date(-1)))

  // The edges of the dates: the searches and starts that stay within them.
  println(Date.Max.startOfMonth)
  println(Date.Max.startOfWeek)
  println(Date.Max.onOrBefore(Weekday.Monday))
  println(Date.Min.onOrAfter(Weekday.Monday))
  println(Date.Min.endOfMonth)
  println(Date.Min.withDay(30))

  // A time of day with a field replaced.
  val t = time(9, 30, 15, 250000)
  println(t.withHour(0))
  println(t.withHour(23))
  println(t.withMinute(0))
  println(t.withMinute(59))
  println(t.withSecond(0))
  println(t.withSecond(59))
  println(t.withMicrosecond(0))
  println(t.withMicrosecond(999999))
  println(Time.Midnight.withMicrosecond(1))

  // A reading with a field replaced, its starting points and its truncations.
  val r = dateTime(2024, 2, 29, 13, 45, 30, 123456)
  println(r.withYear(2025))
  println(r.withMonth(4))
  println(r.withDay(1))
  println(r.withHour(0))
  println(r.withMinute(0))
  println(r.withSecond(0))
  println(r.withMicrosecond(0))
  println(r.startOfYear)
  println(r.startOfMonth)
  println(r.startOfWeek)
  println(r.endOfMonth)
  println(dateTime(2026, 1, 31, 23, 59).withMonth(2))
  println(r.startOfDay)
  println(r.startOfHour)
  println(r.startOfMinute)
  println(r.startOfSecond)
  println(dateTime(2026, 1, 1, 0, 0).startOfHour)
  println(DateTime.Max.startOfSecond)
  println(DateTime.Min)
  println(DateTime.Max)
