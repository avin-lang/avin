// Every kind of sendable value is a message, and arrives as it was told: the integers at their
// bounds, reals, chars, bools, `unit`, strings empty and of every width of character, tuples,
// `Option`, `Result`, `Vector`, `List`, the immutable `Map`, nested and generic data, a final class
// with only `val` fields, an `ActorRef`, a `Behaviour`, which the receiver spawns, and a `@sendable`
// function, which it calls.
import avin.actors.{ActorRef, Behaviour, spawn}
import avin.threads.Channel

data Tree[T]
    Leaf
    Node(left: Tree[T], value: T, right: Tree[T])

class Point(val x: int, val y: int)

data Msg
    Ints(a: int, b: int, c: long, d: long, e: i8, f: byte)
    Reals(r: real, c: char, b: bool, u: unit)
    Text(s: string)
    Parts(t: (int, string, (bool, char)), o: Option[string], r: Result[int, string])
    Collections(v: Vector[int], l: List[string], m: Map[string, int])
    Nested(t: Tree[string], p: Point)
    Ref(to: ActorRef[string])
    Start(b: Behaviour[string], text: string)
    Call(f: @sendable (int) -> int)

describe(t: Tree[string]) -> string = t match
    Leaf -> "."
    Node(l, v, r) -> s"(${describe(l)} $v ${describe(r)})"

receiver(log: Channel[string]) -> Behaviour[Msg] = Behaviour("Receiver", me -> m -> m match
    Ints(a, b, c, d, e, f) -> log.send(s"$a $b $c $d $e $f")
    Reals(r, c, b, u) -> log.send(s"$r $c $b $u")
    Text(s) -> log.send(s"[$s] ${s.charCount()} chars, ${s.byteLength()} bytes")
    Parts(t, o, r) -> log.send(s"$t $o $r")
    Collections(v, l, m) -> log.send(s"$v $l ${m("b")}")
    Nested(t, p) -> log.send(s"${describe(t)} ${p.x},${p.y}")
    Ref(to) -> to.tell(s"told by $me")
    Start(b, text) -> spawn(b).tell(text)
    Call(f) -> log.send(s"${f(20)}"))

main()
    val log = Channel[string]()
    val r = spawn(receiver(log))
    r.tell(Ints(-2147483648, 2147483647, -9223372036854775808, 9223372036854775807, i8(-128), byte(255)))
    r.tell(Reals(-0.5, 'é', true, ()))
    r.tell(Text(""))
    r.tell(Text("aé€😀"))
    r.tell(Parts((1, "one", (false, 'x')), None, Err("no")))
    r.tell(Parts((2, "", (true, '\n')), Some("yes"), Ok(3)))
    r.tell(Collections([], [], Map(("b", 0))))
    r.tell(Collections([1, 2, 3], ["x", "y"], Map(("a", 1), ("b", 2))))
    r.tell(Nested(Node(Node(Leaf, "a", Leaf), "b", Leaf), Point(-1, 1)))
    r.tell(Ref(spawn(Behaviour[string]("Echo", me -> s -> log.send(s)))))
    r.tell(Start(Behaviour("Started", me -> s -> log.send(s"$me got $s")), "hello"))
    val k = 22
    r.tell(Call(n -> n + k))
    for _ in 0..<9 do println(log.receive().get())
    // The last three come from three actors, in any order.
    val last = (0..<3).map(_ -> log.receive().get()).toVector
    for line in last.sorted() do println(line)
