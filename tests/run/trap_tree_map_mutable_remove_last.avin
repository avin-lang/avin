// expect: trap
// Removing the last entry of an empty mutable tree map traps, once the entries are used up.

import avin.collections.mutable.{TreeMap as MutableTreeMap}

main()
    val m = MutableTreeMap[int, string]()
    m(2) = "b"
    m(1) = "a"
    println(m.removeLast())
    println(m.removeLast())
    println(m.removeLast())
