// A `Source` over a string: lines split at `\n` with a `\r` before it going with the terminator, a
// last line without one, a `\r` elsewhere kept, and every way of reading taking up where the last
// stopped.
import avin.io.Source

show(src: Source) -> string = src.lines().map(l -> s"[${l.replace("\r", "\\r")}]").mkString(" ")

// One function reads any source.
count(src: Source) -> int = src.lines().count(l -> !l.isEmpty)

main()
  println(show(Source.fromString("a\nb\r\nc")))
  println(show(Source.fromString("a\nb\n")))
  println(show(Source.fromString("a\r\r\nb\rc\n\n\nd")))
  println(show(Source.fromString("\n")))
  println(show(Source.fromString("\r\n")))
  // Empty input has no lines, no characters and nothing to read.
  val empty = Source.fromString("")
  println(s"${empty.lines().hasNext()} ${empty.chars().hasNext()} [${empty.readAll()}]")
  println(count(Source.fromString("one\n\ntwo\n\n")))
  // Characters beyond ASCII, one at a time, then the rest.
  val src = Source.fromString("hé✓😀\nnext\r\nlast")
  val cs = src.chars()
  println(s"${cs.next()} ${cs.next()} ${cs.next()} ${cs.next()} ${cs.next() == '\n'}")
  // A line picks up after the characters, and `readAll` after the line.
  println(src.lines().next())
  println(s"[${src.readAll()}]")
  // A source read to its end has nothing more, whichever way it is asked.
  println(s"${src.lines().hasNext()} ${src.chars().hasNext()} [${src.readAll()}]")
  // An iterator advanced past what it holds traps; asking first does not take anything.
  val one = Source.fromString("x\ny")
  val it = one.lines()
  println(s"${it.hasNext()} ${it.hasNext()} ${it.next()} ${one.chars().next()} ${it.hasNext()}")
  // A for loop over the lines, and the characters as a string again.
  for line in Source.fromString("p\nq").lines() do println(s"<$line>")
  println(Source.fromString("abc").chars().map(c -> c.toUpper).mkString(""))
