// expect: trap
// A compression level runs from 0 to 9; one past it traps where the compression is asked for.
import avin.compress.{Gzip, compress}

main()
  println(compress("abc".utf8, Gzip, 9).length > 0)
  println(compress("abc".utf8, Gzip, 0).length > 0)
  println(compress("abc".utf8, Gzip, 10).length)
