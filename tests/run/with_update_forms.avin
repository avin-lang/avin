// expect: exit 0
// `with` is a postfix tail of any expression: a call, a field, a parenthesized expression, another
// `with`, so updates chain, and a member read follows its brace. It stands in lambdas, match arms,
// clauses, methods of the data type itself and generic functions. The base is evaluated once, before
// the values, and the values in the order written, whatever order the fields are declared in.

data Point(x: int, y: int)

impl Point
    moved(dx: int) -> Point = self with { x = x + dx }

data Sprite(pos: Point, name: string)

data Box[T](v: T, label: string)

data Shape
    Circle(radius: int)
    Square(side: Point)

var log = ""
var notes = 0

note(s: string) -> int
    log = log + s
    notes += 1
    notes

made() -> Sprite
    log = log + "b"
    Sprite(Point(1, 2), "made")

relabel[T](b: Box[T], label: string) -> Box[T] = b with { label = label }

refill[T](b: Box[T], v: T) -> Box[T] = b with { v = v }

grow(s: Shape) -> Shape = s match
    Square(p) -> Square(p with { y = p.y * 2 })
    Circle(r) -> Circle(r + 1)

nudge(s: Sprite, n: int) -> Sprite
nudge(s, n < 0) = s with { pos.x = 0 }
nudge(s, n) = s with { pos.x = s.pos.x + n }

main() -> int
    // A call as the base, evaluated once, before the values; values in written order.
    val a = made() with { name = "n" + note("1").toString(), pos.y = note("2"), pos.x = note("3") }
    println(a)
    println(log)
    if log != "b123" then return 1
    // A field as the base.
    val s = Sprite(Point(1, 2), "s")
    println(s.pos with { y = 5 })
    // Chained, left to right.
    println(s with { name = "one" } with { name = "two", pos.x = 9 } with { pos.y = 8 })
    // A member read after the brace.
    println(s with { pos.x = 3 }.pos.x)
    println((s with { pos = Point(4, 4) }).pos)
    // In a lambda, capturing a local.
    val k = 100
    val shift = (p: Point) -> p with { x = p.x + k }
    println(shift(Point(1, 1)))
    println([Point(1, 1), Point(2, 2)].map(p -> p with { y = 0 }))
    // In a match arm and in clauses.
    println(grow(Square(Point(3, 3))))
    println(grow(Circle(1)))
    println(nudge(s, -1))
    println(nudge(s, 5))
    // In a method of the data type, on `self`.
    println(Point(1, 2).moved(3))
    // In generic functions.
    println(relabel(Box(1, "a"), "b"))
    println(refill(Box("x", "a"), "y"))
    println(refill(Box(Point(0, 0), "p"), Point(1, 1)))
    // In an `if`, as a condition's operand and as a call's argument.
    val big = if s.pos.x > 0 then s with { name = "big" } else s
    println(big.name)
    if (s with { pos.x = 7 }).pos.x == 7 then println("seven")
    println(Sprite(s.pos with { x = -1 }, "arg"))
    0
