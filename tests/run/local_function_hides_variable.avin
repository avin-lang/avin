// expect: exit 0
// A local function declared in a nested scope hides an enclosing value of the same name, whether
// the value is a `val`, a `var` or a parameter; outside that scope the value is seen again.

nestedBlock() -> int
    val f = 3
    val inner = if true
        f() -> int = 4
        f() + 10
    else 0
    inner + f

callBeforeDeclaration() -> int
    val f = 3
    if true
        val r = f()
        f() -> int = 5
        r + 1
    else 0

hidesVar() -> int
    var f = 1
    f += 1
    val g = if true
        f(x: int) -> int = x * 100
        f(2)
    else 0
    g + f

parameter(f: int) -> int
    val inner = if true
        f() -> int = 7
        f()
    else 0
    inner + f

overloads() -> int
    val f = 1
    val r = if true
        f(x: int) -> int = x + 1
        f(x: int, y: int) -> int = x + y
        f(1) + f(2, 3)
    else 0
    r + f

captures() -> int
    var count = 0
    var f = 10
    val r = if true
        f() -> int
            count += 1
            count
        f() + f()
    else 0
    f += 1
    r + count + f

lambdaInside() -> int
    val f = 2
    if true
        f(x: int) -> int = x * 3
        val g = (y: int) -> f(y) + 1
        g(4)
    else 0

nestedFunction() -> int
    val f = 1
    outer() -> int
        f() -> int = 20
        inner() -> int = f() + 1
        inner()
    outer() + f

recursive() -> int
    val f = 5
    if true
        f(n: int) -> int = if n == 0 then 0 else n + f(n - 1)
        f(4)
    else 0

functionValue() -> int
    val f = 5
    if true
        f(n: int) -> int = n + 1
        val g = f
        g(1)
    else 0

lambdaBody() -> int
    val f = 7
    val h = () ->
        f() -> int = 8
        f()
    h() + f

paramFunction(f: int) -> int
    f() -> int = 1
    f() + 1

innerValueHidesFunction() -> int
    f() -> int = 1
    if true
        val f = 40
        f + 2
    else f()

main() -> int
    if nestedBlock() != 17 then return 1
    if callBeforeDeclaration() != 6 then return 2
    if hidesVar() != 202 then return 3
    if parameter(9) != 16 then return 4
    if overloads() != 8 then return 5
    if captures() != 16 then return 6
    if lambdaInside() != 13 then return 7
    if nestedFunction() != 22 then return 8
    if recursive() != 10 then return 9
    if functionValue() != 2 then return 10
    if lambdaBody() != 15 then return 11
    if paramFunction(5) != 2 then return 12
    if innerValueHidesFunction() != 42 then return 13
    0
