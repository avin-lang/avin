// expect: exit 0
// Every shape of call fills its `using` section the same way, once the written arguments have chosen
// what is called: class constructors, a superclass's arguments, a companion's `apply`, an infix call,
// a static member through a bound, a trait's method through the trait's type and through a bound, an
// extension's method, a function with a repeated parameter before its section, overloads, generic
// functions, and defaults, which see the section.

data Tx(id: int)

data Clock(at: int)

class Pool[T](items: Vector[T])
  size() -> int = items.length

given moduleTx = Tx(1)
given pool = Pool(["a", "b", "c"])

trait Store
  put(key: string, using tx: Tx) -> int

class Memory: Store
  override put(key: string, using tx: Tx) -> int = key.byteLength * 10 + tx.id

trait Made
  static make(using tx: Tx) -> Self

data Stamp(id: int)

impl Made for Stamp
  static make(using tx: Tx) -> Stamp = Stamp(tx.id * 2)

build[T: Made]() -> T = T.make()

storeThrough[S: Store](s: S) -> int = s.put("ab")

impl string
  tagged(using tx: Tx) -> string = s"$self#${tx.id}"
  plus(n: int, using tx: Tx) -> int = self.byteLength + n + tx.id

open class Base(using tx: Tx)
  baseId() -> int = tx.id

class Passing(using tx: Tx): Base()
  own() -> int = tx.id

class Explicit(extra: int, using tx: Tx): Base(tx = Tx(tx.id + extra))

class Account(val id: int)

object Account
  apply(using tx: Tx) -> Account = Account(tx.id * 100)

total(xs: int*, using tx: Tx) -> int
  var sum = 0
  for x in xs
    sum += x
  sum * 10 + tx.id

show(x: int, using tx: Tx) -> string = s"int $x in ${tx.id}"
show(x: string) -> string = s"string $x"

poolSize(using p: Pool[string]) -> int = p.size()

sizeOf[T](x: T) -> int = poolSize()

pair[A, B](a: A, b: B, using tx: Tx) -> (A, B, int) = (a, b, tx.id)

// An ordinary parameter's default sees the section, which is filled first.
logged(message: string, level: int = tx.id * 10, using tx: Tx) -> string = s"$message at $level"

now(using clock: Clock = Clock(100)) -> int = clock.at

// A contextual parameter's default sees the section's parameters before it.
stamp(using tx: Tx, clock: Clock = Clock(tx.id + 1000)) -> int = clock.at

class Timed(using clock: Clock = Clock(7))
  at() -> int = clock.at

main()
  val store: Store = Memory()
  println(store.put("key"))
  println(Memory().put("k"))
  println(storeThrough(Memory()))
  println(build[Stamp]().id)
  println(Stamp.make().id)
  println("abc".tagged())
  println("abc" plus 1)
  println("abc".plus(2))
  println(Passing().baseId())
  println(Passing().own())
  println(Explicit(5).baseId())
  println(Account().id)
  println(Account(3).id)
  println(total(1, 2, 3))
  println(total())
  val xs = [4, 5]
  println(total(xs*))
  println(total(1, tx = Tx(9)))
  println(show(1))
  println(show("s"))
  println(sizeOf(1))
  println(sizeOf("x"))
  println(sizeOf(Tx(0)))
  println(pair(1, "b"))
  println(logged("m"))
  println(logged("m", level = 3))
  println(logged("m", tx = Tx(2)))
  println(now())
  println(stamp())
  println(stamp(clock = Clock(5)))
  println(Timed().at())
  given t = Tx(6)
  given c = Clock(8)
  println(store.put("key"))
  println(Stamp.make().id)
  println(build[Stamp]().id)
  println("abc" plus 1)
  println(Passing().own())
  println(Account().id)
  println(total(1, 2))
  println(logged("m"))
  println(now())
  println(stamp())
  println(Timed().at())
