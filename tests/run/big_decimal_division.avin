// expect: exit 0
// Division: `/` is exact where the quotient ends within 34 significant digits, keeping no zeros past
// the dividend's scale less the divisor's, and otherwise rounds half to even at 34; `div` takes a
// scale, `divSignificant` a number of digits, `exactDiv` answers None for a quotient that never ends,
// and `%` and `divRem` cut the quotient to a whole number.
main()
  val one: BigDecimal = 1
  // Quotients that end.
  println(one / 4)
  println(one / 8)
  println(BigDecimal(10) / 4)
  println(BigDecimal(10) / 2)
  println(BigDecimal("10.00") / 2)
  println(BigDecimal("6.00") / BigDecimal("2.0"))
  println(BigDecimal("1.0") / 4)
  println(BigDecimal("0.001") / 1000)
  println(BigDecimal(1000) / BigDecimal("0.001"))
  println(BigDecimal(-7) / 2)
  println(BigDecimal(7) / -2)
  println(BigDecimal(-7) / -2)
  println(BigDecimal(0) / 7)
  println(BigDecimal("0.000") / 7)
  println(BigDecimal("0.000") / BigDecimal("0.1"))
  println(one / 1)
  // Quotients that never end round to 34 significant digits, half to even.
  println(one / 3)
  println(BigDecimal(2) / 3)
  println(BigDecimal(-2) / 3)
  println(one / 7)
  println(BigDecimal(1000000) / 3)
  println(BigDecimal("0.000001") / 3)
  println((one / 3).precision)
  println((BigDecimal(2) / 3).precision)
  // The precision boundary: a quotient of 34 digits is exact, one of 35 rounds, a tie to even.
  val d34 = BigDecimal("1234567890123456789012345678901234")
  println(d34 / 1)
  println(BigDecimal("12345678901234567890123456789012345") / 1)
  println(BigDecimal("12345678901234567890123456789012355") / 1)
  println(BigDecimal("12345678901234567890123456789012346") / 1)
  println(BigDecimal("0.12345678901234567890123456789012345") / 1)
  println(BigDecimal("99999999999999999999999999999999995") / 1)
  println(BigDecimal("9999999999999999999999999999999999.5") / 1)
  println(d34 / 2)
  println(d34 / 4)
  // `div` at a scale, a negative one rounding to tens.
  println(one.div(3, scale = 0))
  println(one.div(3, scale = 10))
  println(BigDecimal(2).div(3, scale = 5))
  println(BigDecimal(2).div(3, scale = 5, rounding = Down))
  println(BigDecimal(1).div(4, scale = 5))
  println(BigDecimal(12345).div(7, scale = -2))
  println(BigDecimal(-12345).div(7, scale = -1, rounding = Floor))
  println(BigDecimal("1.5").div(BigDecimal("0.5"), scale = 0))
  println(BigDecimal(0).div(3, scale = 3))
  println(one.div(3, scale = 60))
  // `divSignificant` to a number of digits.
  println(one.divSignificant(3, 5))
  println(BigDecimal(200).divSignificant(3, 2))
  println(BigDecimal(2).divSignificant(4, 10))
  println(BigDecimal(1).divSignificant(BigDecimal("0.0003"), 3))
  println(BigDecimal(1).divSignificant(3, 60))
  println(BigDecimal(9999).divSignificant(10, 2))
  // `exactDiv` answers the exact quotient, or None.
  println(one.exactDiv(8))
  println(one.exactDiv(3))
  println(BigDecimal(1).exactDiv(BigDecimal("0.125")))
  println(BigDecimal("6.00").exactDiv(2))
  println(BigDecimal(1).exactDiv(1024))
  println(BigDecimal(1).exactDiv(-80))
  println(BigDecimal(3).exactDiv(6))
  println(BigDecimal(7).exactDiv(14))
  println(BigDecimal(1).exactDiv(6))
  println(BigDecimal(0).exactDiv(3))
  println(BigDecimal("12345678901234567890123456789").exactDiv(BigDecimal("0.0005")))
  println(BigDecimal(2).pow(200).exactDiv(BigDecimal(2).pow(200)))
  println(BigDecimal(1).exactDiv(BigDecimal(2).pow(70)))
  // Where `/` is exact it agrees with `exactDiv`.
  val pairs = [
    (BigDecimal(1), BigDecimal(8)),
    (BigDecimal("6.00"), BigDecimal(2)),
    (BigDecimal("-0.75"), BigDecimal("0.5")),
    (BigDecimal(1), BigDecimal(1024))
  ]
  for (a, b) in pairs
    println(a.exactDiv(b) == Some(a / b))
  // `%` and `divRem`: the quotient cut to a whole number, the remainder with the dividend's sign.
  println(BigDecimal("7.5") % 2)
  println(BigDecimal("-7.5") % 2)
  println(BigDecimal("7.5") % -2)
  println(BigDecimal("7.5") % BigDecimal("0.4"))
  println(BigDecimal(10) % BigDecimal("0.3"))
  println(BigDecimal(6) % 3)
  println(BigDecimal("0.00") % 3)
  println(BigDecimal("7.5").divRem(2))
  println(BigDecimal("-7.5").divRem(2))
  println(BigDecimal("1E+2").divRem(BigDecimal("0.07")))
  val (q, r) = BigDecimal("123.456").divRem(BigDecimal("0.1"))
  println(q * BigDecimal("0.1") + r == BigDecimal("123.456"))
  // Compound assignment.
  var x: BigDecimal = 100
  x /= 8
  println(x)
  x %= 5
  println(x)
  x /= BigDecimal(3)
  println(x)
