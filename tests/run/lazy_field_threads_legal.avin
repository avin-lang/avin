// expect: exit 0
// A `lazy val` field read on another thread is legal when its initializer, and everything it calls,
// reaches only sendable module-level state: an immutable vector, a module-level `lazy val` of a
// sendable type, an `Atomic` held in a `val`. Each object's initializer runs once, whichever thread
// reads it first, and every later read, on any thread, sees its value. An actor's own `lazy val`
// whose initializer is pure is legal too.
import avin.actors.spawn as spawnActor
import avin.threads.{Atomic, Promise, spawn}

val table = [1, 2, 3]
val runs = Atomic(0)
lazy val base: int = table.length * 100

class Box(val n: int)
  lazy val v: int = count() + n * 2 + table.length
  lazy val s: string = s"box é$n"
  lazy val big: long = long.MaxValue - long(1000 - base)
  private count() -> int
    runs.add(1)
    0

class Gen[T](val x: T)
  lazy val pair: (T, int) = (x, base)

actor Echo(done: Promise[int]) receives int
  lazy val offset: int = table(0) + base
  receive
    n -> done.complete(n + offset)

main()
  val bs = (0 ..< 4).map(k -> Box(k))
  val ts = bs.map(b -> spawn(() -> b.v + b.s.charCount))
  for t in ts do println(t.join())
  val again = bs.map(b -> spawn(() -> b.v))
  for t in again do println(t.join())
  println(bs(0).v)
  println(bs(3).s)
  println(spawn(() -> bs(1).big).join())
  println(runs.load())
  val g = Gen("ü")
  println(spawn(() -> g.pair).join())
  val done = Promise[int]()
  spawnActor(Echo(done)).tell(5)
  println(done.future.await())
