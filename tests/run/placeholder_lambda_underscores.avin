// expect: exit 0
// Every other meaning of `_` is unchanged beside placeholder lambdas: a lambda parameter that binds
// nothing, a pattern's wildcard, a discarded value or part, a loop variable, a clause's ignored
// argument, the last guard, a digit separator, and a name that begins with `_`.

firstOf(f: (int, int) -> int) -> int = f(1, 2)

sign(n: int) -> int
sign(n)
  | n < 0 = -1
  | _ = 1

describe(n: int) -> string
describe(_ < 0) = "negative"
describe(_) = "not negative"

both(a: int, b: int) -> string
both(_, _) = "two ignored"

divmod(a: int, b: int) -> (int, int) = (a / b, a % b)

main() -> int
  val xs = [1, 2, 3]
  // `_ ->` and `(_, _) ->` are lambdas whose parameters bind nothing.
  println(xs.map(_ -> 0))
  println(firstOf((_, b) -> b))
  println(firstOf((_, _) -> 9))
  // Wildcards in patterns inside a placeholder lambda's argument, and in a `match` function.
  println([Some(1), None].map(_ is Some(_)))
  println([Some(4), None].map(match
    Some(_) -> "some"
    _ -> "none"))
  println(xs.map(_ + 1_000))
  // A name that begins with `_` is an ordinary name, never a placeholder.
  val _offset = 5
  println(xs.map(_ + _offset))
  println(xs.map(n -> n + _offset))
  val _ = println("discarded")
  val (q, _) = divmod(7, 2)
  var r = 0
  _, r = divmod(9, 4)
  println(s"$q $r")
  var count = 0
  for _ in xs
    count += 1
  println(count)
  println(s"${sign(-3)} ${sign(3)} ${describe(-1)} ${describe(1)} ${both(1, 2)}")
  println(for (_, n) in [(1, 2), (3, 4)] yield n)
  0
