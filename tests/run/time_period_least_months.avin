// expect: trap
// Taking the least `int` of months from a date counts in a `long`, so it overflows nothing on the way
// and traps naming the date it would reach, far past `Date.Max`.
import avin.time.{Date, Period, date}

main()
    println(date(2026, 1, 31) - Period(0, int.MinValue + 800000000))
    println(date(2026, 1, 31) - Period(int.MinValue, 0))
