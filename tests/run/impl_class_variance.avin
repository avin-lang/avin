// expect: exit 0
// A class whose fields are all immutable holds nothing a method could store into, so the methods its
// impls add may take its covariant parameter, and an impl may make it compare by its contents.

open class Animal(val name: string)
class Dog(n: string): Animal(n)

class Pair[+T](val first: T, val second: T)

impl[T] Pair[T]
  withFirst(x: T) -> Pair[T] = Pair(x, second)
  has(x: T) -> bool = first.equals(x) || second.equals(x)

impl[T] Eq for Pair[T]
  equals(other: Pair[T]) -> bool = first.equals(other.first) && second.equals(other.second)

impl[T] Hash for Pair[T]
  hash() -> long = first.hash() *% 31 +% second.hash()

main()
  val dogs = Pair(Dog("a"), Dog("b"))
  val animals: Pair[Animal] = dogs
  val changed = animals.withFirst(Animal("c"))
  println(s"${changed.first.name} ${changed.second.name} ${animals.has(dogs.first)}")
  println(s"${Pair(1, 2) == Pair(1, 2)} ${Pair(1, 2) == Pair(2, 1)} ${Pair("x", "y").hash() == Pair("x", "y").hash()}")
