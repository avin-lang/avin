// expect: exit 0
// The standard constructor traits add no method a type already has and change none: `map`,
// `flatMap`, `filter` and `foldLeft` on each type in the table are the calls they always were, with
// the results they always had, read here by a type pattern on the exact type; `flatMap` taking an
// `Option` still keeps the values present; a lazy list's `map` still reads nothing until it is read;
// and a value of a trait for types, `Seq` or `Iterable`, keeps its own methods' results.
kind(x: Any) -> string = x match
  _: List[string] -> "List[string]"
  _: List[int] -> "List[int]"
  _: Vector[string] -> "Vector[string]"
  _: Vector[int] -> "Vector[int]"
  _: ArraySeq[string] -> "ArraySeq[string]"
  _: Queue[string] -> "Queue[string]"
  _: Array[string] -> "Array[string]"
  _: Buffer[string] -> "Buffer[string]"
  _: Deque[string] -> "Deque[string]"
  _: LazyList[string] -> "LazyList[string]"
  _: Option[string] -> "Option[string]"
  _: Option[int] -> "Option[int]"
  _: Result[string, int] -> "Result[string, int]"
  _: Either[int, string] -> "Either[int, string]"
  _: Set[string] -> "Set[string]"
  _: string -> "string"
  _: int -> "int"
  _ -> "other"

shown(n: int) -> string = s"#$n"

main()
  val list = List(1, 2, 3)
  println(kind(list.map(shown)))
  println(kind(list.flatMap(n -> [shown(n)])))
  println(kind(list.flatMap(n -> if n > 1 then Some(n) else None)))
  println(list.flatMap(n -> if n > 1 then Some(n) else None))
  println(kind(list.filter(n -> n > 1)))
  println(kind(list.foldLeft("", (acc, n) -> acc + shown(n))))
  val vector = [1, 2, 3]
  println(kind(vector.map(shown)))
  println(kind(vector.flatMap(n -> List(shown(n)))))
  println(kind(vector.filter(n -> n > 2)))
  println(vector.foldLeft(0, (a, b) -> a * 10 + b))
  println(kind(vector.toArraySeq.map(shown)))
  println(kind(Queue(1, 2).map(shown)))
  println(kind(Array.tabulate(2, i -> i).map(shown)))
  println(kind([1].toBuffer().map(shown)))
  val deque = Deque[int]()
  deque.append(1)
  println(kind(deque.map(shown)))
  var reads = 0
  val lazy = LazyList.iterate(1, n ->
    reads += 1
    n + 1).map(shown)
  println(kind(lazy))
  println(reads)
  println(lazy.take(3).toList)
  println(reads)
  println(kind(Some(1).map(shown)))
  println(kind(Some(1).flatMap(n -> Some(shown(n)))))
  println(kind(Some(2).filter(n -> n > 1)))
  println(Some(4).foldLeft(1, (a, b) -> a + b))
  val ok: Result[int, int] = Ok(5)
  println(kind(ok.map(shown)))
  val right: Either[int, int] = Right(6)
  println(kind(right.map(shown)))
  println(kind(HashSet(1, 2).map(shown)))
  val seq: Seq[int] = list
  println(kind(seq.map(shown)))
  val items: Iterable[int] = vector
  println(items.foldLeft(0, (a, b) -> a + b))
  println(kind("héllo".map(c -> c)))
