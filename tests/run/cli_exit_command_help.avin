// expect: exit 0
// args: help add
// `parseOrExit` given `help` and a command: that command's help, named after the program and the
// command, goes to standard output and the program exits with 0.
import avin.cli

val add = cli.Parser("add", "Add a task.")
  .choice("priority", ["high", "normal", "low"], short = 'p', default = "normal")
  .positionals("words", help = "the task's title", required = true)

val parser = cli.Parser("todo", "Keep a to-do list.")
  .string("file", help = "the list", default = "todo.txt")
  .command(add)
  .command(cli.Parser("list", "List the tasks."))

main(args: Vector[string]) -> int
  parser.parseOrExit(args)
  println("not reached")
  1
