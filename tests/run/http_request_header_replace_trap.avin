// expect: trap
// A header replaced on a request is a token and a value without a line break: a value holding a line
// break traps, after a well-formed header was replaced.
import avin.net.http.ServerRequest

main()
  println(ServerRequest("GET", "/").withHeaderReplaced("X-Ok", "fine").headers)
  println(ServerRequest("GET", "/").withHeaderReplaced("X-Bad", "a\r\nInjected: yes").headers)
