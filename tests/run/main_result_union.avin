// expect: exit 1
// A `main` answering with a union of errors shows whichever member it holds by that member's own
// `Display`: `?` on functions with different error types collects them into the union.
data ReadError(file: string)

impl Display for ReadError
    display(out: Writer, spec: FormatSpec) = out.write(s"cannot read $file")

data ParseError(line: int, why: string)

impl Display for ParseError
    display(out: Writer, spec: FormatSpec) = out.write(s"line $line: $why")

load(file: string) -> Result[string, ReadError] = if file == "" then Err(ReadError("(nothing)")) else Ok("a = 1\nb")

parse(text: string) -> Result[int, ParseError]
    var n = 0
    for line in text.split("\n")
        n += 1
        if !line.contains("=") then return Err(ParseError(n, s"no `=` in \"$line\""))
    Ok(n)

main() -> Result[unit, ReadError | ParseError]
    val text = load("settings")?
    println("loaded")
    val n = parse(text)?
    println(s"$n settings")
    Ok(())
