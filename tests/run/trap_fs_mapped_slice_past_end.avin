// expect: trap
// A slice reaching past a mapping's end traps rather than copying a short range: up to the end is
// fine, one byte further is not.
import avin.fs

main()
  val dir = fs.createTempDir("avin-mapped-trap").toOption.get
  _ = fs.writeText(dir + "/a", "abcdef")
  val m = fs.mapFile(dir + "/a").toOption.get
  _ = fs.removeDirAll(dir)
  println(m.slice(4, 6).length)
  println(m.slice(4, 7).length)
