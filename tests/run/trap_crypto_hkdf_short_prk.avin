// expect: trap
// HKDF-Expand takes a pseudorandom key at least a digest long, as RFC 5869 asks: 32 bytes over
// SHA-256 expands, and 31 traps.
import avin.crypto.hkdfExpandSha256

main()
  println(hkdfExpandSha256(Vector.fill(32, byte(1)), Vector(), 16).length)
  println(hkdfExpandSha256(Vector.fill(31, byte(1)), Vector(), 16).length)
