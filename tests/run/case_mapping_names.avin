// expect: exit 0
// A `char` and a `string` map their case under one pair of names, `toUpper` and `toLower`, and a
// string maps each of its characters exactly as the character maps itself.

shout(s: string) -> string = s.toUpper
whisper(c: char) -> char = c.toLower

main()
    println("hello Wörld".toUpper)
    println("HELLO WÖRLD".toLower)
    println('ö'.toUpper)
    println('Ö'.toLower)
    println(s"[${"".toUpper}] [${"".toLower}]")
    // One character for one: `ß` and digits stay as they are, and the byte length may change.
    println(s"${"ß".toUpper} ${"123".toUpper} ${'ß'.toUpper}")
    println(s"${"ı".toUpper} ${"ſ".toUpper.byteLength}")
    for text in ["Ǆemal", "ΣΊΣΥΦΟΣ", "Ꭰ", "a🐢B", "ǅ"]
        assert(text.toUpper == text.map(c -> c.toUpper))
        assert(text.toLower == text.map(c -> c.toLower))
        println(s"${text.toUpper} ${text.toLower}")
    println(["a", "B"].map(shout))
    println("ABC".map(whisper))
    val up: (string) -> string = s -> s.toUpper
    println(up("x"))
    println("MiXeD".toLower.toUpper.toLower)
