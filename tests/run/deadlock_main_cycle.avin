// expect: trap
// `main` joins a thread that waits for a value only `main` would send, after the join: each waits on
// the other, and the report lists both.
import avin.threads.{Channel, spawn}

main()
  val answers = Channel[int]()
  val t = spawn(() -> answers.receive().getOrElse(0) * 2)
  println("joining")
  println(t.join())
  answers.send(21)
