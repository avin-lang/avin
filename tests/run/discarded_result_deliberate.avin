// expect: exit 0
// `_ = e` evaluates `e` once and drops its value on purpose: a `Result` of any instance, a method's
// and a chained call's, a `Future`, on a line of its own, in a branch, in a single-line loop and as
// a `unit` lambda's body. `val _ = e` drops one too. A deferred statement may drop a `Result`, and
// runs. A value of any other type is dropped freely.
import avin.fs
import avin.threads.Future

var calls = 0

fails(k: int) -> Result[int, string] =
    calls += 1
    if k > 0 then Ok(k) else Err(s"no $k")

class Log
    var lines: Vector[string] = []
    add(s: string) -> Result[unit, string] =
        lines = lines :+ s
        if s.isEmpty then Err("empty") else Ok(())

wrap[T](x: T) -> Result[T, string] =
    calls += 1
    Ok(x)

closing(log: Log) -> Result[int, string]
    defer log.add("closed")
    log.add("open")?
    Ok(log.lines.length)

main()
    _ = fails(1)
    _ = fails(-1)
    val _ = fails(2)
    _ = wrap("ключ ✓")
    _ = wrap(long(9223372036854775807))
    val log = Log()
    _ = log.add("a")
    _ = log.add("")
    _ = fails(3).map(x -> x + 1).flatMap(x -> fails(-x))
    if calls > 0 then _ = fails(4) else _ = fails(5)
    for i in 0..<3 do _ = fails(i)
    [7, 8].foreach(k -> _ = fails(k))
    _ = Future(6).map(x -> x * 2)
    println(calls)
    println(log.lines)
    println(closing(log))
    println(log.lines)
    val dir = fs.createTempDir("avin-discard").getOrElse("")
    _ = fs.writeText(dir + "/x", "x")
    println(fs.readText(dir + "/x"))
    _ = fs.removeDirAll(dir)
    println(fs.exists(dir))
    log.lines.length
    Some(1)
