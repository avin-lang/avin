// A type is printable because it implements `Display`: `println`, interpolation and `toString()` all
// render through it, into a `Writer`, in the field a `FormatSpec` describes.

// A class conforms in its header; its rendering pads the whole text to the field.
class Point(val x: int, val y: int): Display
  override display(out: Writer, spec: FormatSpec) = out.writeField(s"($x, $y)", spec)

// A data type conforms through an impl, and renders a part through the part's own `Display`.
data Segment(from: Point, to: Point)

impl Display for Segment
  display(out: Writer, spec: FormatSpec) = out.write(s"$from -> $to")

// Variants render under their own names, writing piece by piece.
data Shape
  Circle(radius: real)
  Square(side: int)

impl Display for Shape
  display(out: Writer, spec: FormatSpec)
    self match
      Circle(r) ->
        out.write("circle ")
        out.write(r.toString())
      Square(s) ->
        out.write("square ")
        out.writeInt(long(s))

// A generic class renders through its parameter's bound.
class Labelled[T: Display](label: string, value: T): Display
  override display(out: Writer, spec: FormatSpec)
    out.write(label)
    out.write(": ")
    value.display(out, spec)

// Generic code reaches `display` and `toString` through a bound, for the built-in types too.
show[T: Display](x: T) -> string = s"<$x>"

framed[T: Display](x: T) -> string = "[" + x.toString() + "]"

padded[T: Display](x: T, spec: FormatSpec) -> string
  val out = StringWriter()
  x.display(out, spec)
  out.text

main()
  println("text")
  println(42)
  println(long(-7))
  println(2.5)
  println('c')
  println(true)
  println(())
  println(byte(200))
  val p = Point(1, 2)
  println(p)
  println(s"p is $p and ${Point(3, 4)}")
  println(p.toString())
  println(Segment(p, Point(5, 6)))
  println(s"segment ${Segment(Point(0, 0), p)}")
  println(Circle(1.5))
  println(s"${Square(3)} and ${Circle(0.5)}")
  println(Labelled("origin", Point(0, 0)))
  println(Labelled("count", 3))
  println(show(p))
  println(show(10))
  println(show("s"))
  println(framed(Square(2)))
  println(framed(false))
  println(padded(42, FormatSpec(6)))
  println(padded(42, FormatSpec(width = 6, left = true)) + "|")
  println(padded("ab", FormatSpec(5)) + "|")
  println(padded('x', FormatSpec(3, left = true)) + "|")
  println(padded(p, FormatSpec(10)))
  println(padded(Labelled("n", 7), FormatSpec(4)))
  println(padded("wider than the field", FormatSpec(3)))
  println(padded("ünï", FormatSpec(5)) + "|")
  val out = StringWriter()
  writeAll(out)
  println(out.text)

// A writer collects what several values write into it.
writeAll(out: Writer)
  Point(7, 8).display(out, FormatSpec())
  out.writeChar(' ')
  12.display(out, FormatSpec())
  out.writeSpaces(2)
  true.display(out, FormatSpec())
