// expect: trap
// A connection handed to a thread's body is the body's while the body runs: the code that handed it
// over may not use it meanwhile, and traps at the use.
import avin.net.{TcpListener, TcpStream}
import avin.threads.{Channel, spawn}

main()
    TcpListener.bind("127.0.0.1", 0) match
        Ok(l) ->
            TcpStream.connect("127.0.0.1", l.port()) match
                Ok(s) ->
                    val go = Channel[int]()
                    val t = spawn(() ->
                        go.receive()
                        s.writeText("mine\n").isOk())
                    println("handed over")
                    println(s.writeText("again\n").isOk())
                    go.send(1)
                    println(t.join())
                Err(e) -> println(e.message())
            l.close()
        Err(e) -> println(e.message())
