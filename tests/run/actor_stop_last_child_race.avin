// expect: exit 0
// An actor ending failed waits for its children, and ends when the last of them has, however that
// last end falls against the actor's own turn: here it races the turn in which the actor began to
// end. Every shape runs many times, one tree at a time, and every root must end within the
// timeout: a parent supervised with `Stop` and one child; one with three children, each with a
// child of its own; a chain four deep escalating to a root supervised with `Stop`; and a `Restart`
// whose limit is spent, escalating to a root supervised with `Stop`. Each tree is waited for before
// the next starts, so the traps are reported in order.
import avin.actors.{ActorRef, Escalate, Restart, Stop, spawn}
import avin.threads.Channel
import avin.time

actor Quiet(depth: int) receives int
    if depth > 0 then spawn(Quiet(depth - 1))
    receive
        _ -> ()
    stopping
        ()

actor Parent(kids: int, depth: int) receives int
    for _ in 0..<kids do spawn(Quiet(depth))
    receive
        n -> println(s"never: ${100 / n}")

// A link of a chain: the last one hands itself back, and traps on its message.
actor Link(depth: int, back: Channel[ActorRef[int]]) receives int
    if depth == 0 then back.send(self) else spawn(Link(depth - 1, back), onFailure = Escalate)
    receive
        n -> println(s"never: ${100 / n}")

actor Chain(depth: int, back: Channel[ActorRef[int]]) receives int
    spawn(Link(depth, back), onFailure = Escalate)
    receive
        _ -> ()

actor Restarter receives int
    spawn(Quiet(1))
    receive
        n -> println(s"never: ${100 / n}")

actor Spender(back: Channel[ActorRef[int]]) receives int
    back.send(spawn(Restarter(), onFailure = Restart(0, time.seconds(60))))
    spawn(Quiet(1))
    receive
        _ -> ()

// Waits for `root` to end, and says so where it does not within the timeout.
ends(shape: string, i: int, root: ActorRef[Nothing]) -> bool = root.ended().await(time.seconds(20)) match
    Some(_) -> true
    None ->
        println(s"$shape $i: the root never ended")
        false

main()
    val runs = 25
    val back = Channel[ActorRef[int]]()
    var ended = 0
    for i in 0..<runs
        val p = spawn(Parent(1, 0), onFailure = Stop)
        p.tell(0)
        if ends("one child", i, p) then ended += 1
    for i in 0..<runs
        val p = spawn(Parent(3, 1), onFailure = Stop)
        p.tell(0)
        if ends("three children", i, p) then ended += 1
    for i in 0..<runs
        val root = spawn(Chain(3, back), onFailure = Stop)
        back.receive().get.tell(0)
        if ends("chain", i, root) then ended += 1
    for i in 0..<runs
        val root = spawn(Spender(back), onFailure = Stop)
        back.receive().get.tell(0)
        if ends("spent restart", i, root) then ended += 1
    println(s"$ended of ${4 * runs} roots ended")
