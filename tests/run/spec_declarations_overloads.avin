// expect: exit 0
// Spec probes for declarations, overloads and defaults: written type arguments choosing the generic
// overload, an option overload over a plain one, literals choosing int, long, real and byte, a default
// of a generic parameter from the one before it, named lambdas inferring, a method default reading the
// receiver through a superclass type, a by-name overload never running its argument, and empty splices.
which[T](x: T) -> string = "any"
which(x: int) -> string = "int"

opt[T](x: T) -> string = "plain"
opt[T](x: Option[T]) -> string = "option"

measure(n: int) -> string = "int"
measure(r: real) -> string = "real"

wide(n: int) -> string = "int"
wide(n: long) -> string = "long"

small(b: byte) -> string = "byte"
small(s: string) -> string = "string"

same[T](x: T, y: T = x) -> (T, T) = (x, y)

run[A, B](x: A, f: (A) -> B) -> B = f(x)

open class Greeter(val who: string)
    greet(prefix: string = s"hi $who") -> string = prefix + "."

class Loud(who: string): Greeter(who)

delayed(x: -> int) -> string = "delayed"
delayed(s: string) -> string = "string"

tick(n: int) -> int
    println(s"tick $n")
    n

pick(label: string, rest: string*) -> string = s"$label:${rest.length}"

main()
    println(s"${which(1)} ${which("x")} ${which[int](1)} ${which[string]("s")}")
    println(s"${opt(1)} ${opt(Some(1))} ${opt[int](None)}")
    println(s"${measure(1)} ${measure(1.5)} ${wide(1)} ${wide(3000000000)} ${wide(-2147483648)} ${wide(2147483648)}")
    println(s"${small(7)} ${small("s")}")
    println(s"${same(4)} ${same("a", y = "b")} ${same(Some(1), None)}")
    println(s"${run(f = x -> x * 2, x = 21)} ${run(x = "ab", f = s -> s.byteLength)}")
    val g: Greeter = Loud("ann")
    println(s"${g.greet()} ${Greeter("bo").greet(prefix = "yo")}")
    println(delayed(tick(1)))
    println(s"${pick("a")} ${pick("b", "x", "y")} ${pick("c", [].map((s: string) -> s)*)}")
    val empty: Vector[string] = []
    println(pick("d", empty*))
