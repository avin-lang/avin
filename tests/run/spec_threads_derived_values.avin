// expect: exit 0
// Threads meeting derivation and equality: an `Atomic` of a data type with an equality of its own
// compares with it, and values whose `describe` a template derives cross threads through a channel
// and a mutex while every thread allocates.
import avin.threads.{Atomic, Channel, Mutex, scope}

data Name(text: string)

impl Eq for Name
    equals(other: Name) -> bool = text.toLower == other.text.toLower

impl Hash for Name
    hash() -> long = text.toLower.hash()

trait Describe
    describe() -> string

impl Describe for int
    describe() -> string = s"$self"

impl[A: Describe] Describe for Option[A]
    describe() -> string = self match
        Some(a) -> a.describe()
        None -> "-"

derive Describe for T
    describe() -> string = T.walk(self, Text("")).text

data Text(text: string)

impl ShapeVisitor for Text
    variant(v: VariantShape) -> Text = Text(v.name)

impl Text
    field[F: Describe](f: FieldShape, value: F) -> Text = Text(s"$text ${f.name}=${value.describe()}")

data Job derives Describe, Eq
    Add(a: int, b: int)
    Neg(a: Option[int])
    Stop

main()
    val a = Atomic(Name("Ada"))
    println(a.compareAndSet(Name("ADA"), Name("Bea")))
    println(a.load().text)
    println(a.compareAndSet(Name("ada"), Name("Cy")))
    // Derived values cross threads through a channel and a mutex while the threads allocate.
    val jobs = Channel[Job](4)
    val seen = Mutex(Buffer[string]())
    scope(s ->
        for w in 0..<3
            s.spawn(() ->
                for j in jobs
                    val d = j.describe()
                    seen.with(b -> b.addOne(d)))
        for n in 0..<300
            val job: Job = if n % 3 == 0 then Add(n, 1) elif n % 3 == 1 then Neg(if n % 2 == 0 then Some(n) else None) else Stop
            jobs.send(job)
        jobs.close())
    val all = seen.with(b -> b.toVector).sorted
    println(all.length)
    println(all.take(3))
    println(all.count(d -> d == "Stop"))
    println([Stop, Add(1, 2), Neg(None)].contains(Add(1, 2)))
    val held = Atomic[Job](Neg(Some(1)))
    println(held.compareAndSet(Neg(Some(1)), Stop))
    println(held.load().describe())
