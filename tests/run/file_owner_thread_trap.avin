// expect: trap
// An open file a thread's body reaches is the thread's while it runs, and the code that handed it
// over traps at its next call, naming the `File`.
import avin.fs
import avin.threads.{Channel, spawn}

main()
  val dir = fs.createTempDir("file-owner").ok.get
  val f = fs.create(dir + "/a.txt").ok.get
  val go = Channel[int]()
  val t = spawn(() ->
    _ = go.receive()
    f.writeText("thread\n").isOk)
  println("handed over")
  _ = f.writeText("main\n")
  println("not reached")
  go.send(1)
  println(t.join())
