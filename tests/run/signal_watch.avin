// expect: exit 0
// `avin.signal`: the named signals, and a `Watch` that counts a signal for the program, which then
// does not end it. `take` answers whether it arrived since the last take, several arrivals being one
// `true`; two watches each see every arrival; `wait` parks until it arrives, from this program or
// another, and `wait(limit)` gives up. Signals nothing may catch, and numbers the platform does not
// have, are refused.
import avin.io.IoError
import avin.process
import avin.process.{Command, MacOS}
import avin.signal
import avin.signal.Watch
import avin.threads.{Channel, Future, spawn}
import avin.time
import avin.time.millis

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

// Sends `sig` to this program.
raise(sig: int) = ok(process.signal(process.pid(), sig))

main()
  // The numbers.
  println(
    [
      signal.Hangup,
      signal.Interrupt,
      signal.Quit,
      signal.Kill,
      signal.BrokenPipe,
      signal.Alarm,
      signal.Terminate,
      signal.WindowChange
    ]
  )
  val users = if process.os() == MacOS then [30, 31] else [10, 12]
  println([signal.User1, signal.User2] == users)

  // Terminate, sent to itself: counted, not ending the program.
  val term = ok(signal.watch(signal.Terminate))
  println(term.signal())
  println(term.take())
  raise(signal.Terminate)
  println(term.take())
  println(term.take())
  // Three arrivals between two takes are one.
  raise(signal.Terminate)
  raise(signal.Terminate)
  raise(signal.Terminate)
  println(term.take())
  println(term.take())

  // Two watches of one signal each see it, and a watch made after an arrival does not.
  val again = ok(signal.watch(signal.Terminate))
  raise(signal.Terminate)
  println(term.take())
  println(again.take())
  val later = ok(signal.watch(signal.Terminate))
  println(later.take())

  // Sent by another program.
  ok(Command("/bin/sh", "-c", "kill -TERM \"$0\"", process.pid().toString()).run())
  println(term.take())

  // `wait` on a thread of its own, woken by a signal this thread sends; the watch is sendable.
  val hup = ok(signal.watch(signal.Hangup))
  val waiting = spawn(() ->
    hup.wait()
    "hangup seen")
  raise(signal.Hangup)
  println(waiting.join())
  println(hup.take())
  // A wait for an arrival that came before it returns at once.
  raise(signal.Hangup)
  hup.wait()
  println("arrived before the wait")

  // `wait(limit)`: gives up, waiting at least the limit; a limit of zero or less looks once.
  val usr = ok(signal.watch(signal.User1))
  val start = time.monotonic()
  println(usr.wait(millis(60)))
  println(time.monotonic() - start >= millis(60))
  println(usr.wait(millis(0)))
  println(usr.wait(millis(-5)))
  raise(signal.User1)
  println(usr.wait(millis(0)))
  raise(signal.User1)
  println(usr.wait(time.seconds(30)))
  // Woken within the limit by a signal from a future's body.
  val sender = Future(process.signal(process.pid(), signal.User1))
  println(usr.wait(time.seconds(30)))
  println(sender.await())

  // Interrupt and the user signals are watched as Terminate is.
  val int = ok(signal.watch(signal.Interrupt))
  raise(signal.Interrupt)
  println(int.take())
  val two = ok(signal.watch(signal.User2))
  raise(signal.User2)
  println(two.take())
  println(usr.take())

  // Refused: what nothing may catch, and what the platform does not have.
  println(signal.watch(signal.Kill).isErr)
  println(signal.watch(17).isErr || signal.watch(19).isErr)
  println(signal.watch(0).map(w -> w.signal()))
  println(signal.watch(-1).map(w -> w.signal()))
  println(signal.watch(65).map(w -> w.signal()))

  // Many watches, made and dropped while the collector runs, leave the one kept counting.
  for i in 0 ..< 200 do ok(signal.watch(signal.Terminate)).take()
  raise(signal.Terminate)
  println(term.take())
