// expect: trap
// `for` loops over iterators, in the program and in the core library. A buffer's `addAll` loops over
// the program's own iterable, whose `next` calls the library: the trap reports that call, the one the
// program wrote, not the library's loop or the program's call of `addAll`.

class Countdown(from: int): Iterable[int]
    override iterator() -> Iterator[int] = CountdownIterator(from)

class CountdownIterator(private var current: int): Iterator[int]
    override hasNext() -> bool = true

    override next() -> int
        val made = Array.fill(current, 0)
        current -= 1
        made.length()

main()
    for n in Buffer.builder[int]().result()
        println(s"$n")
    val seen = Buffer[int]()
    for x in [3, 4]
        seen.add(x)
    println(s"${seen.length()}")
    seen.addAll(Countdown(1))
