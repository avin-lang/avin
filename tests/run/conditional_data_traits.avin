// A data type conforms to a trait that is also a type through an impl with bounds of its own, for
// the type arguments that meet them: it converts to the trait, is called through it, and matches a
// type pattern on an `Any`, only there. A trait the conditional one requires holds with it. A
// `Tagged` of a displayable value displays itself, as every data type does where its fields do.

data Tagged[T](tag: string, value: T)

trait Named
    name() -> string

trait Labelled: Named
    label() -> string = "<" + name() + ">"

impl[T: Display] Labelled for Tagged[T]
    name() -> string = tag + "=" + value.toString()

class Plain

labels(items: Array[Labelled]) -> string
    var out = ""
    for x in items
        out = out + x.label()
    out

kind(x: Any) -> string = x match
    l: Labelled -> "labelled " + l.label()
    n: Named -> "named " + n.name()
    _ -> "neither"

main()
    val n: Named = Tagged("a", 1)
    print(n.name())
    print(labels(Array.tabulate(2, i -> Tagged("k", i))))
    print(kind(Tagged("b", true)))
    print(kind(Tagged("c", Plain())))
    print(kind(Tagged("d", Tagged("e", 2))))
    print(Tagged("f", Plain()) == Tagged("f", Plain()))
