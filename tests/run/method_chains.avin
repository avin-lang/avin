// expect: exit 0
// A comparison chain whose links are operator methods yielding `bool`: each link calls its left
// operand's method, chosen among its overloads by that link's operands; links of methods and
// built-in links mix; operands are evaluated left to right, each middle operand once, and
// evaluation stops at the first false link.

var calls = 0

data Instant(at: long)

impl Instant
  <(other: Instant) -> bool
    println("  Instant < Instant")
    at < other.at
  <=(other: Instant) -> bool
    println("  Instant <= Instant")
    at <= other.at
  <=(d: Duration) -> bool
    println("  Instant <= Duration")
    at <= d.length
  >(other: Instant) -> bool
    println("  Instant > Instant")
    at > other.at
  >=(other: Instant) -> bool
    println("  Instant >= Instant")
    at >= other.at
  <(limit: long) -> bool
    println("  Instant < long")
    at < limit

// `Duration` has `Ord`'s `<` and a method `<=` taking an `Instant`: `<` between two durations is
// built in, `<=` calls the method.
data Duration(length: long) derives Ord

impl Duration
  <=(i: Instant) -> bool
    println("  Duration <= Instant")
    length <= i.at

class Version(val major: int, val minor: int)
  <(other: Version) -> bool = major < other.major || major == other.major && minor < other.minor
  <=(other: Version) -> bool = !(other < self)

// A trait declaring the methods, and its classes.
trait Ranked
  rank() -> int
  <(other: Ranked) -> bool = rank() < other.rank()
  <=(other: Ranked) -> bool = rank() <= other.rank()

class Card(val n: int): Ranked
  override rank() -> int = n

class Joker(val face: string): Ranked
  override rank() -> int = 99

// A type parameter bounded by the trait has its methods, and chains through them.
within[T: Ranked](lo: T, x: T, hi: T) -> bool = lo <= x < hi

// A method taking an `int`, called with literals among the chain's operands.
data Meter(n: int)

impl Meter
  <(limit: int) -> bool = n < limit
  <(other: Meter) -> bool = n < other.n

tick(i: Instant) -> Instant
  calls += 1
  i

tickDuration(d: Duration) -> Duration
  calls += 1
  d

tickVersion(v: Version) -> Version
  calls += 1
  v

main()
  val t = Instant(5)
  println("two links of methods")
  println(Instant(1) < t < Instant(9))
  println(Instant(1) <= t <= Instant(5))
  println(Instant(9) > t >= Instant(5))
  println(Instant(5) < t < Instant(9))
  println("three links of methods")
  println(Instant(1) < Instant(2) <= t < Instant(9))
  println(Instant(1) < Instant(2) <= t < Instant(3))
  println("an overload per link")
  println(Instant(1) < t <= Duration(5))
  val six: long = 6
  val five: long = 5
  println(Instant(1) < t < six)
  println(Instant(1) <= t < five)
  println("literal operands")
  val m = Meter(5)
  println(Meter(1) < m < 10, m < 10 < 20, m < 3 < 20, Meter(1) < m < Meter(4))
  println("methods and built-in links mixed")
  println(Instant(0) <= Duration(5) < Duration(7))
  println(Duration(1) < Duration(2) <= Instant(3))
  println(Duration(3) < Duration(2) <= Instant(3))
  println(Instant(1) < t == Instant(5))
  println(Instant(1) < t != Instant(5))
  println(t == Instant(5) < Instant(6))
  println(t != Instant(5) < Instant(6))
  println("the middle operand is evaluated once")
  calls = 0
  println(Instant(1) < tick(t) < tick(Instant(9)) <= Instant(10))
  println(calls)
  calls = 0
  println(Instant(0) <= tickDuration(Duration(5)) < Duration(7))
  println(calls)
  println("a false link stops the chain")
  calls = 0
  println(Instant(9) < tick(t) < tick(Instant(10)))
  println(calls)
  calls = 0
  println(Instant(1) < tick(t) > tick(Instant(10)) < tick(Instant(11)))
  println(calls)
  calls = 0
  println(Duration(9) < Duration(2) <= tick(Instant(3)))
  println(calls)
  println("a class")
  val v = Version(1, 4)
  calls = 0
  println(Version(1, 0) <= tickVersion(v) < Version(2, 0), Version(1, 5) <= tickVersion(v) < Version(2, 0))
  println(calls)
  println("a trait and its classes")
  val r: Ranked = Card(7)
  println(Card(1) <= r < Joker("red"), Card(8) <= r < Joker("red"), Joker("black") < r <= Card(9))
  println(within(Card(1), Card(5), Card(9)), within(Card(1), Card(9), Card(9)))
  println(within[Ranked](Card(1), Joker("red"), Card(9)), within[Ranked](Card(1), Card(2), Joker("red")))
  println("across lines")
  val across = Instant(1)
    < t
    <= Duration(5)
  println(across)
  println("in conditions")
  for at in [0, 1, 5, 9, 10]
    if Instant(1) <= Instant(long(at)) < Instant(10) then println(s"$at in") else println(s"$at out")
  var n: long = 0
  while Instant(0) <= Instant(n) < Instant(3)
    n += 1
  println(n)
  println("a lone comparison by a method is a call")
  println(t < Instant(6))
  println((Instant(1) < t) == (t < Instant(9)))
