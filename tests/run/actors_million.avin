// A million messages, told by four threads to one actor, are each handled once: the actor's sum and
// count come out exact. The mailbox is unbounded, so the senders never wait however far they run
// ahead. Its smaller twin, `actors_volume_stress`, runs the same shape under the collector's stress.
// env: AVIN_GC_STRESS=0
import avin.actors.{Behaviour, spawn}
import avin.threads.Promise
import avin.threads as threads

data Msg
    Add(n: long)
    Total(reply: Promise[(long, long)])

summer() -> Behaviour[Msg] = Behaviour("Summer", me ->
    var sum: long = 0
    var count: long = 0
    m -> m match
        Add(n) ->
            sum += n
            count += 1
        Total(reply) -> reply.complete((sum, count)))

main()
    val each = 250000
    val s = spawn(summer())
    val senders = (0..<4).map(t -> threads.spawn(() ->
        for i in 0..<each do s.tell(Add(long(t * each + i))))).toVector
    for t in senders do t.join()
    val p = Promise[(long, long)]()
    s.tell(Total(p))
    val (sum, count) = p.future.await()
    println(s"$count messages, sum $sum")
    val n = long(4 * each)
    println(sum == n * (n - 1) / 2)
