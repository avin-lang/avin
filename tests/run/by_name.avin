// expect: exit 0
// By-name parameters: an argument evaluated at each read of its parameter, never at the call, and
// never cached. Each argument counts its evaluations in a captured `var`, so the output shows how
// many times it ran: none, once and many. Run under a collection at every allocation, a delayed
// string or data value is made at each read and must survive until it is used.

data Box
  Box(label: string, size: int)

twice(value: -> int) -> int = value + value

never(value: -> int) -> int = 0

once(value: -> int) -> int = value

times(n: int, action: -> unit)
  var i = 0
  while i < n
    action
    i += 1

unless(condition: bool, action: -> unit)
  if !condition then action

// Passing a by-name parameter on forwards the expression, still unevaluated.
forwarded(value: -> int) -> int = twice(value)

forwarded_never(value: -> int) -> int = never(value)

joined(text: -> string) -> string = text + "|" + text

sizes(box: -> Box) -> int = box.size + box.size

identity_twice[T](value: -> T) -> (T, T) = (value, value)

// A delayed function: each read evaluates the expression, which yields the function to call.
applied(f: -> (int) -> int) -> int = f(1) + f(2)

// The callee's own evaluation changes what the expression reads.
until_limit(limit: int, step: -> unit, current: -> int) -> int
  var steps = 0
  while current < limit
    step
    steps += 1
  steps

// A lambda that reads a by-name parameter evaluates it when the lambda is called, after the call
// that passed it has returned.
later(value: -> int) -> () -> int = () -> value + 1

first[T](value: -> T) -> T = value

both[T](value: -> T) -> (T, T) = (first(value), first(value))

apply_to(f: (int) -> int, x: int) -> int = f(x)

main() -> int
  var count = 0
  next() -> int
    count += 1
    count
  println(s"${twice(next())} after ${count}")
  count = 0
  println(s"${never(next())} after ${count}")
  count = 0
  println(s"${once(next())} after ${count}")
  count = 0
  println(s"${forwarded(next())} after ${count}")
  count = 0
  println(s"${forwarded_never(next())} after ${count}")

  var ticks = 0
  times(3, ticks += 1)
  println(s"ticks $ticks")
  unless(true, println("not shown"))
  unless(false, println("shown"))

  var made = 0
  text() -> string
    made += 1
    s"text$made"
  box() -> Box
    made += 1
    Box("b", made)
  println(joined(text()))
  println(s"made $made")
  println(s"${sizes(box())} made $made")

  val pair = identity_twice(next())
  println(s"${pair.0} ${pair.1}")
  val words = identity_twice(text())
  println(words.0 + words.1)

  var built = 0
  scale() -> (int) -> int
    built += 1
    val k = built * 10
    x -> x * k
  println(s"${applied(scale())} built $built")

  var n = 0
  println(s"steps ${until_limit(5, n += 1, n)} n $n")

  // A by-name parameter of a local function and of a lambda.
  count = 0
  thrice(value: -> int) -> int = value + value + value
  println(s"${thrice(next())} after $count")
  val doubled: (-> int) -> int = value -> value * 2 + value
  count = 0
  println(s"${doubled(next())} after $count")
  val strict: (int) -> int = value -> value * 2 + value
  count = 0
  println(s"${strict(next())} after $count")

  count = 0
  val f = later(next())
  println(s"later after $count")
  println(s"${f()} ${f()} after $count")
  count = 0
  val firsts = both(next())
  println(s"${firsts.0} ${firsts.1} after $count")
  val texts = both(text())
  println(texts.0 + texts.1)
  // A lambda inside a delayed argument may return from itself.
  println(s"${once(apply_to(x -> if x > 0 then return x * 2 else 0, 4))}")
  0
