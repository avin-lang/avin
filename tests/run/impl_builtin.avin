// The built-in types belong to the core library's module, `avin`, so an impl adding methods to one is
// written there; this file is part of that module. Such a method is called directly on a value.
module avin

impl string
  shout() -> string = self + "!"
  twice() -> string = shout() + shout()

impl int
  squared() -> int = self * self
  plus(n: int) -> int = self + n
  private half() -> int = self / 2
  halfSquared() -> int = half().squared()

impl bool
  flip() -> bool = !self

main()
  println("hi".shout())
  val s = "ab"
  println(s.twice())
  println(s"${7.squared()} ${3.plus(4).squared()} ${10.halfSquared()}")
  println(s"${true.flip()}")
