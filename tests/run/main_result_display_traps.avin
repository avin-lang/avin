// expect: trap
// The error's `Display` runs after `main` has answered, as ordinary code: a trap in it stops the
// program as a trap, not with status 1, and the `error: ` it began is not written.
data Broken(code: int)

impl Display for Broken
    display(out: Writer, spec: FormatSpec) = fail(s"cannot show code $code")

main() -> Result[unit, Broken]
    println("answering")
    Err(Broken(5))
