// expect: exit 0
// The methods every `Iterable` has that build at once: `scanLeft`, `tapEach`, `partitionMap`, `span`,
// `concat` and `flatten` of a collection of collections answer vectors, and `grouped` and `sliding`
// answer the iterator of windows an iterator's own forms make. Sets, maps, a program's own iterable
// and an iterator seen only as an `Iterable` have them; a sequence keeps its own where it has one.
class Counted(val items: Vector[int]): Iterable[int]
    override iterator() -> Iterator[int] = items.iterator()

open class Animal(val name: string)
class Cat(n: string): Animal(n)
class Dog(n: string): Animal(n)

// Through a type parameter, the forms every `Iterable` has.
scanned[T](items: Iterable[T], f: (int, T) -> int) -> Vector[int] = items.scanLeft(0, f)

halves[T](items: Iterable[T], p: (T) -> bool) -> (Vector[T], Vector[T]) = items.span(p)

flat[T](items: Iterable[Iterable[T]]) -> Vector[T] = items.flatten()

main()
    val set = Set(3)
    val own = Counted([1, 2, 3, 4, 5])
    val none = Counted([])
    val one: Map[string, int] = {"k": 2}

    // scanLeft: `initial`, then each partial fold, one more than there are elements.
    val sums: Vector[int] = own.scanLeft(0, (a, x) -> a + x)
    println(sums)
    println(none.scanLeft(9, (a, x) -> a + x))
    println(set.scanLeft("", (s, x) -> s + s"$x"))
    println(one.scanLeft(0, (a, e) -> a + e.1))
    println(scanned(own, (a, x) -> a * 10 + x))
    println(scanned(["ab", "c"], (a, s) -> a + s.chars().length()))
    println((1..4).scanLeft(1, (a, x) -> a * x))

    // tapEach: `f` called with every element before the vector of them is answered.
    var tapped = Buffer[int]()
    val same: Vector[int] = own.tapEach(x -> tapped.addOne(x))
    println(tapped.toVector())
    println(same)
    println(none.tapEach(x -> tapped.addOne(x)))
    println(tapped.length())
    tapped = Buffer[int]()
    println(own.tapEach(x -> tapped.addOne(x)).head())
    println(tapped.length())
    println(Set("é").tapEach(s -> print(s)))

    // partitionMap: the Left values and the Right values, each in order.
    val split: (Vector[int], Vector[string]) = own.partitionMap(x -> if x % 2 == 0 then Left(x * 100) else Right(s"<$x>"))
    println(split)
    println(none.partitionMap(x -> Left[int, int](x)))
    println([1, 2].partitionMap(x -> Left[int, string](x)))
    println([1, 2].partitionMap(x -> Right[string, int](x)))
    val (oks, errs) = ["1", "x", "22", ""].partitionMap(s -> s.toIntOption() match
        Some(n) -> Left(n)
        None -> Right(s))
    println(oks)
    println(errs)
    println(Set(1).partitionMap(x -> Right[Animal, Animal](Cat("c"))).1.map(a -> a.name))

    // span: the elements before the first that fails `p`, and the rest; `p` not called after that.
    var tested = 0
    val small: (int) -> bool = x ->
        tested += 1
        x < 3
    println(own.span(small))
    println(tested)
    println(own.span(x -> true))
    println(own.span(x -> false))
    println(none.span(x -> true))
    println(set.span(x -> x == 3))
    println(halves(Counted([4, 4, 5, 4]), x -> x == 4))

    // grouped and sliding: windows of the elements, as an iterator.
    println(own.grouped(2).toVector())
    println(own.sliding(3).toVector())
    println(own.sliding(2, 2).toVector())
    println(none.grouped(4).hasNext())
    println(set.sliding(5).toVector())
    println(one.grouped(1).toVector())
    println([1, 2, 3].grouped(2).toVector())

    // concat: these elements, then `other`'s, in a vector of a type wide enough for both.
    println(own.concat([6]))
    println(none.concat(none))
    println(set.concat(List(4, 5)))
    val cats = Set(Cat("tom"))
    val animals: Vector[Animal] = cats.concat([Dog("rex")])
    println(animals.map(a -> a.name))
    println(one.concat([("b", 2)]))
    println(["x"].concat(Set("y")))

    // flatten: a collection of collections, their elements in order.
    val sets: Vector[Set[int]] = [Set(1), Set(), Set(2)]
    println(sets.flatten())
    println(Set(Vector(1, 2)).flatten())
    println(Counted([]).map(x -> [x]).flatten())
    println(flat([[1], [2, 3]]))
    println(flat(List(Set("a"), Set("b"))))
    println(flat([Counted([7, 8]), Counted([])]))
    val nested: Vector[Vector[string]] = [["é"], [], ["ü", "ß"]]
    println(nested.flatten())
    println(List(List(1), List(2)).flatten())

    // An iterator seen only as an `Iterable` takes these forms, and is consumed by them.
    val it: Iterable[int] = [1, 2, 3].iterator()
    println(it.scanLeft(0, (a, x) -> a + x))
    println(it.isEmpty())
    val it2: Iterable[int] = [1, 2, 3, 4].iterator()
    println(it2.span(x -> x < 2))
    println(it2.isEmpty())

    // Many allocations, as a collector running at every allocation sees them.
    val big = Counted(Vector.tabulate(3000, i -> i))
    println(big.scanLeft(long(0), (a, x) -> a + long(x)).last())
    val (evens, odds) = big.partitionMap(x -> if x % 2 == 0 then Left(s"e$x") else Right(s"o$x"))
    println(s"${evens.length()} ${odds.last()}")
    println(big.map(x -> [s"$x", s"$x"]).flatten().length())
    println(big.concat(big.tapEach(x -> ())).length())
