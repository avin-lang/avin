// expect: exit 0
// A `select` is an expression like any other: nested in another select's arm, with bindings of the
// same name in each; in a lambda and a closure capturing its channels; in a generic function at
// several type arguments; as an argument, a condition and a loop's body. Control leaves an arm as it
// leaves a match arm: `return` from the function, `break` and `continue` in the loop around, and an
// arm body that is an indented block of statements. `end select` may close one.
import avin.threads.{Channel, spawn}

// The first value either channel has, at any type.
either[T](a: Channel[T], b: Channel[T]) -> Option[T] = select
  a.receive() as Some(x) -> Some(x)
  b.receive() as Some(x) -> Some(x)
  else None

// `return` from inside an arm.
firstPositive(c: Channel[int]) -> int
  while true
    select
      c.receive() as Some(x) ->
        if x > 0 then return x
      c.receive() as None -> return -1
  0

main() -> int
  val outer = Channel[int]()
  val inner = Channel[string]()
  outer.send(1)
  inner.send("in")
  val nested = select
    outer.receive() as Some(x) ->
      val y = x + 1
      select
        inner.receive() as Some(x) -> s"$y $x"
        else "inner empty"
    else "outer empty"
  println(nested)
  outer.send(2)
  val nestedElse = select
    outer.receive() as Some(x) ->
      select
        inner.receive() as Some(x) -> s"$x"
        else s"inner empty after $x"
    else "outer empty"
  println(nestedElse)

  // A select in a lambda, its channels captured.
  val chosen = (n: int) ->
    outer.send(n)
    select
      outer.receive() as Some(x) -> x * 3
      inner.receive() as Some(_) -> -1
  println(chosen(4), chosen(5))

  // A generic function at two type arguments.
  val ints = Channel[int]()
  val more = Channel[int]()
  more.send(9)
  val strs = Channel[string]()
  strs.send("s")
  println(either(ints, more), either(strs, Channel[string]()), either(ints, ints))

  // As an argument, and as an operand.
  ints.send(3)
  println("argument", select
    ints.receive() as Some(x) -> x
    else 0)
  ints.send(3)
  val sum = 1 + select
    ints.receive() as Some(x) -> x
    else 0
  println(sum)

  // `break` and `continue` in a loop around the select.
  for i in 0 ..< 5 do ints.send(i)
  ints.close()
  var seen: List[int] = []
  while true
    select
      ints.receive() as Some(x) ->
        if x % 2 == 1 then continue
        seen = seen :+ x
      ints.receive() as None -> break
  println(seen)

  val ns = Channel[int]()
  for x in [0, -2, 7, 8] do ns.send(x)
  println(firstPositive(ns))
  ns.close()
  println(firstPositive(ns))

  // A select on a lightweight thread inside a select's arm on the main thread.
  val hand = Channel[int]()
  hand.send(10)
  val reply = select
    hand.receive() as Some(x) ->
      spawn(() ->
        val back = Channel[int]()
        back.send(x)
        select
          back.receive() as Some(y) -> y + 1).join()
  println(reply)

  // `end select` closes one.
  val closedOne = select
    hand.receive() as Some(x) -> x
    else 42
  end select
  println(closedOne)
  0
