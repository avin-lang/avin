// expect: exit 0
// `avin.signal`'s job-control and child signals: `Stop`, `Continue`, `TerminalStop` and `Child`,
// numbered as the platform numbers them and named in a status's message. Continue, TerminalStop and
// Child can be watched, Stop cannot, as Kill cannot; a watched TerminalStop does not stop the
// program, and a watched Child is raised when a program this one started ends.
import avin.io.IoError
import avin.process
import avin.process.{Command, CommandError, Failed, MacOS, Signalled}
import avin.signal
import avin.time

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

// Sends `sig` to this program.
raise(sig: int) = ok(process.signal(process.pid(), sig))

main()
  // The numbers: the platform's own, all distinct, none of the fixed ones.
  val mac = process.os() == MacOS
  println(signal.Stop == (if mac then 17 else 19))
  println(signal.Continue == (if mac then 19 else 18))
  println(signal.TerminalStop == (if mac then 18 else 20))
  println(signal.Child == (if mac then 20 else 17))
  val all = [signal.Hangup, signal.Interrupt, signal.Quit, signal.Kill, signal.BrokenPipe, signal.Alarm, signal.Terminate, signal.WindowChange, signal.User1, signal.User2, signal.Stop, signal.Continue, signal.TerminalStop, signal.Child]
  println(all.toSet.size == all.size)

  // The names, as a status a signal ended says them.
  println(Failed(Signalled(signal.Stop), "").message.endsWith("(Stop)"))
  println(Failed(Signalled(signal.Continue), "").message.endsWith("(Continue)"))
  println(Failed(Signalled(signal.TerminalStop), "").message.endsWith("(TerminalStop)"))
  println(Failed(Signalled(signal.Child), "").message.endsWith("(Child)"))
  println(Failed(Signalled(signal.User1), "").message.endsWith("(User1)"))
  println(Failed(Signalled(signal.User2), "").message.endsWith("(User2)"))
  println(Failed(Signalled(signal.Terminate), "").message.endsWith("(Terminate)"))
  println(Failed(Signalled(signal.Stop), "").message.startsWith(s"killed by signal ${signal.Stop} "))

  // Stop cannot be watched; the refusal is Kill's.
  println(signal.watch(signal.Stop).isErr)
  println(signal.watch(signal.Stop).map(w -> w.signal()).mapErr(e -> e.kind) == signal.watch(signal.Kill).map(w -> w.signal()).mapErr(e -> e.kind))
  println(signal.watch(signal.Stop) match
    Ok(_) -> "watched"
    Err(e) -> e.message == s"cannot watch signal ${signal.Stop}: Invalid argument")

  // Continue, sent to a program that is not stopped, is counted and disturbs nothing.
  val cont = ok(signal.watch(signal.Continue))
  println(cont.signal() == signal.Continue)
  println(cont.take())
  raise(signal.Continue)
  println(cont.take())
  println(cont.take())

  // TerminalStop, watched, is counted and the program is not stopped.
  val tstp = ok(signal.watch(signal.TerminalStop))
  raise(signal.TerminalStop)
  println(tstp.take())
  println(tstp.take())

  // Child: raised when a program this one started ends.
  val child = ok(signal.watch(signal.Child))
  println(child.take())
  val started = ok(Command("/bin/sh", "-c", "exit 0").start())
  println(child.wait(time.seconds(30)))
  println(started.waitFor())
  // A watch of it sees one raised by hand, too.
  raise(signal.Child)
  println(child.wait(time.seconds(30)))
  // And another program's end is another arrival.
  val second = ok(Command("/bin/sh", "-c", "exit 3").start())
  println(child.wait(time.seconds(30)))
  println(second.waitFor())
