// expect: trap
// The hardening limits are checked where the server starts: a `headerTimeout` of zero and a
// `maxHeaders` of one start a server, and a negative `headerTimeout` traps.
import avin.net.http
import avin.net.http.Response
import avin.time.{Duration, micros}

main()
  println(http.serve("127.0.0.1", 0, _ -> Response.empty(204), headerTimeout = Duration.Zero).map(s -> s.shutdown()).isOk)
  println(http.serve("127.0.0.1", 0, _ -> Response.empty(204), maxHeaders = 1).map(s -> s.shutdown()).isOk)
  println(http.serve("127.0.0.1", 0, _ -> Response.empty(204), headerTimeout = micros(-1)).isOk)
