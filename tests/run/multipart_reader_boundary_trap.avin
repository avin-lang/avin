// expect: trap
// A multipart reader made directly takes a boundary RFC 2046 allows, seventy characters at most, and
// traps on one it does not.
import avin.io.{IoError, Reader}
import avin.net.http.{MultipartLimits, MultipartReader}

class Empty(): Reader
  override read(max: int) -> Result[Array[byte], IoError] = Ok(Array.empty[byte]())

main()
  _ = MultipartReader(Empty(), "b".repeat(70), MultipartLimits())
  println("seventy taken")
  _ = MultipartReader(Empty(), "b".repeat(71), MultipartLimits())
  println("unreachable")
