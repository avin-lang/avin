// expect: exit 0
// Functions are values: named functions, lambdas and closures over values and shared `var`s,
// passed, returned, composed and called.

twice(f: (int) -> int, x: int) -> int = f(f(x))

double(x: int) -> int = x * 2

compose[A, B, C](f: (A) -> B, g: (B) -> C) -> (A) -> C = x -> g(f(x))

adder(n: int) -> (int) -> int = x -> x + n

counter() -> () -> int
  var count = 0
  () ->
    count += 1
    count

main() -> int
  println(s"${twice(double, 5)}")
  println(s"${twice(x -> x + 3, 1)}")
  val add5 = adder(5)
  println(s"${add5(10)}")
  val next = counter()
  next()
  next()
  println(s"${next()}")
  val f = compose(double, (x: int) -> s"<$x>")
  println(f(21))
  var total = 0
  val bump: (int) -> unit = k -> total += k
  bump(4)
  bump(6)
  println(s"$total")
  // A function type has any number of parameters.
  val nine = (
      a: int,
      b: int,
      c: int,
      d: int,
      e: int,
      f: int,
      g: int,
      h: int,
      i: int
  ) -> a + b + c + d + e + f + g + h + i
  println(s"${nine(1, 2, 3, 4, 5, 6, 7, 8, 9)}")
  0
