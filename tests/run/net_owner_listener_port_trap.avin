// expect: trap
// A listener handed to a thread is the thread's while the thread runs, and the code that handed it
// over traps at `port`, the port it holds in a field of its own included.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.threads.{Channel, spawn}
import avin.time

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

main()
  val l = ok(TcpListener.bind("127.0.0.1", 0))
  val go = Channel[int]()
  val t = spawn(() ->
    go.receive()
    _ = l.close()
    l.port())
  println("handed over")
  l.port()
  println("not reached")
  go.send(1)
  println(t.join())
