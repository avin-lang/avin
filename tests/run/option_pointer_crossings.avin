// expect: exit 0
// Where an option kept as one pointer meets code that needs an object: as an `Any` and back through a
// type pattern, as a trait's value found by a pattern, inside another option, in a field, an array, a
// map and a vector, through a covariant view, and many times over while the collector runs.

import avin.collections.mutable.{Map as MutableMap}

open class Animal(val name: string) derives Display
class Dog(name: string) : Animal(name)

class Kennel(var resident: Option[Dog])

describe(a: Any) -> string = a match
    o: Option[Dog] -> s"dogs ${o.map(d -> d.name).getOrElse("none")}"
    o: Option[string] -> s"words ${o.getOrElse("none")}"
    n: int -> s"int $n"
    _ -> "other"

shown(a: Any) -> string = a match
    d: Display -> d.toString()
    _ -> "hidden"

nested(o: Option[Option[Dog]]) -> string = o match
    Some(Some(d)) -> s"some some ${d.name}"
    Some(None) -> "some none"
    None -> "none"

main()
    val rex = Dog("rex")
    val dog: Option[Dog] = Some(rex)
    val gone: Option[Dog] = None
    println(s"${describe(dog)} ${describe(gone)} ${describe(Some("w"))} ${describe(None[string])} ${describe(3)}")
    println(s"${shown(dog)} ${shown(gone)} ${shown(Some(1))}")
    val boxed: Any = dog
    val back = boxed match
        o: Option[Animal] -> o match
            Some(a) -> a.name
            None -> "none"
        _ -> "no"
    println(back)

    println(s"${nested(Some(dog))} ${nested(Some(gone))} ${nested(None)} ${Some(dog).flatten().map(d -> d.name)}")
    println(s"${Some(dog) == Some(Some(Dog("rex")))} ${Some(gone) == Some(None[Dog])} ${Some(dog) == Some(gone)}")

    // An `Option[Dog]` is an `Option[Animal]`.
    val animal: Option[Animal] = dog
    println(s"${animal.map(a -> a.name).getOrElse("none")} $animal")

    val kennel = Kennel(None)
    println(kennel.resident.isDefined())
    kennel.resident = dog
    println(kennel.resident.map(d -> d.name).getOrElse("empty"))

    val slots = Array.fill(3, gone)
    slots(1) = dog
    var filled = 0
    for s in slots do if s.isDefined() then filled += 1
    println(s"$filled ${slots(1).map(d -> d.name)}")

    val owners = MutableMap[string, Dog]()
    owners("ann") = rex
    println(s"${owners.get("ann").map(d -> d.name)} ${owners.get("bob").isEmpty()} ${owners.getOrElse("bob", Dog("stray")).name}")
    var frozen = Map[int, Dog]()
    for i in 0..<100 do frozen = frozen.updated(i, Dog(s"d$i"))
    var found = 0
    for i in 0..<150
        frozen.get(i) match
            Some(d) -> found += d.name.byteLength()
            None -> ()
    println(found)

    // Options made and dropped while the collector runs keep their values alive while held.
    var kept: Vector[Option[Dog]] = []
    for i in 0..<2000
        val o = if i % 3 == 0 then None else Some(Dog(s"n$i"))
        if i % 100 == 1 then kept = kept :+ o
    var names = 0
    for o in kept do names += o.map(d -> d.name.byteLength()).getOrElse(0)
    println(s"${kept.length()} $names")
