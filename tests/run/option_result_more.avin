// expect: exit 0
// The further methods of `Option` and `Result`: testing the value, `contains`, conversion to a list
// or vector, `zip`, `flatten` and `orElse`, on a value and on its absence.

pair(o: Option[(int, string)]) -> string = o match
    Some((n, s)) -> s"$n/$s"
    None -> "none"

main()
    val a: Option[int] = None
    val b = Some(3)
    print(s"${a.exists(x -> x > 0)} ${b.exists(x -> x > 2)} ${b.exists(x -> x > 3)}")
    print(s"${a.forall(x -> x > 0)} ${b.forall(x -> x > 2)} ${b.forall(x -> x > 3)}")
    print(s"${a.contains(3)} ${b.contains(3)} ${b.contains(4)} ${Some("é").contains("é")} ${Some(Some(1)).contains(Some(1))}")
    print(s"${a.toList()} ${b.toList()} ${a.toVector()} ${b.toVector()}")
    print(s"${b.toList().length()} ${a.toVector().length()} ${Some("x").toVector()(0)}")
    print(s"${pair(b.zip(Some("s")))} ${pair(a.zip(Some("s")))} ${pair(b.zip(None[string]))} ${pair(a.zip(None[string]))}")

    val ok: Result[int, string] = Ok(4)
    val bad: Result[int, string] = Err("no")
    print(s"${ok.exists(x -> x == 4)} ${ok.exists(x -> x == 5)} ${bad.exists(x -> true)}")
    print(s"${ok.forall(x -> x == 4)} ${ok.forall(x -> x == 5)} ${bad.forall(x -> false)}")
    print(s"${ok.toList()} ${bad.toList()}")
    val recovered: Result[int, int] = bad.orElse(e -> Ok(e.byteLength()))
    val changed: Result[int, int] = bad.orElse(e -> Err(e.byteLength()))
    val kept: Result[int, int] = ok.orElse(e -> Err(0))
    print(s"${recovered.getOrElse(-1)} ${changed.err().getOrElse(-1)} ${kept.getOrElse(-1)}")
