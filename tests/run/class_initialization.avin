// expect: exit 0
// Once a class body has initialized every field, it may call the object's methods, pass the object
// on, store it and capture it in lambdas. An open class's body may call a method that cannot be
// overridden and that uses the object only for its fields, so a subclass's fields, which are set
// after it runs, are never read before they are set.

var registered = 0

register(c: Counter) -> int
    registered += c.count
    registered

class Counter(start: int)
    var count = start
    val label = s"counter $start"
    var reader: () -> int = () -> 0
    var position = 0
    reader = () -> count * 10
    bump()
    position = register(self)
    print((() -> () -> describe())()())

    bump() = count++

    describe() -> string = s"$label at $count"

open class Base(val name: string, width: int)
    val size = width + 1
    var total = 0
    total = measure() + fixed()

    private measure() -> int = size * 2

    private fixed() -> int
        total += 1
        size + total + measure()

    describe() -> string = s"base $name"

class Derived(name: string, val extra: int): Base(name, extra)
    val tag = s"$name/$extra"
    print(describe())

    override describe() -> string = s"$tag: $total"

object Registry
    var items = 0
    val first = Counter(7)
    items = add(first)

    add(c: Counter) -> int = c.count + 1

main()
    val c = Counter(3)
    print(s"${c.count} ${c.reader()} ${c.position} $registered")
    val d = Derived("ab", 5)
    print(s"${d.total} ${d.tag}")
    print(s"${Registry.items}")
