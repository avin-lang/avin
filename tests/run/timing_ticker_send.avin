// expect: trap
// A ticker's channel is delivered to by its clock alone: a select's send arm on it traps when it is
// tried, as a plain send does.
import avin.threads.{Channel, Ticker}
import avin.time.{epochMicros, hours}

main()
  val t = Ticker(hours(1))
  val never = Channel[int]()
  println("before")
  select
    never.receive() as Some(x) -> println(x)
    t.ticks.send(epochMicros(0)) -> println("sent")
  println("after")
