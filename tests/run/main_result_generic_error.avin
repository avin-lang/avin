// expect: exit 1
// The error may be any type with `Display`: here an instance of a generic class, whose `Display`
// is stated for every element type that has one, and which is built by a closure that captures a
// local.
class Failure[T](what: T, count: int)

impl[T: Display] Display for Failure[T]
    display(out: Writer, spec: FormatSpec) = out.write(s"$what failed $count times")

retry[T](what: T, times: int, attempt: (int) -> bool) -> Result[unit, Failure[T]]
    for i in 1..times
        if attempt(i) then return Ok(())
    Err(Failure(what, times))

main() -> Result[int, Failure[string]]
    val limit = 2
    retry("first", 3, i -> i >= limit)?
    println("first worked")
    retry("second", 3, i -> i > limit + 5)?
    Ok(0)
