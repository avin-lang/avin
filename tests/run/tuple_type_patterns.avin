// expect: exit 0
// A tuple's type at run time is the one it was made with, so a tuple type pattern compares that type,
// not the classes of the objects inside it. A tuple pattern with a type pattern inside it tests each
// part on its own.

open class Animal(val name: string)

class Dog(name: string): Animal(name)

class Cat(name: string): Animal(name)

whole(x: Any) -> string = x match
    _: (Dog, int) -> "dog pair"
    _: (Animal, int) -> "animal pair"
    _ -> "other"

parts(t: (Animal, int)) -> string = t match
    (d: Dog, n) -> s"dog ${d.name} $n"
    (c: Cat, n) -> s"cat ${c.name} $n"
    (a, n) -> s"animal ${a.name} $n"

main()
    val a: Animal = Dog("rex")
    println(whole((a, 1)))
    println(whole((Dog("fido"), 1)))
    println(whole((Animal("generic"), 1)))
    println(whole((1, Dog("fido"))))
    val t: (Animal, int) = (a, 1)
    println(t match
        _: (Dog, int) -> "dog"
        _ -> "not")
    println(parts(t))
    println(parts((Cat("tom"), 2)))
    println(parts((Animal("generic"), 3)))
    val made: (Dog, int) = (Dog("max"), 4)
    val seen: (Animal, int) = made
    println(whole(seen))
    println(parts(seen))
    val held: Any = t
    println(held match
        p: (Animal, int) -> parts(p)
        _ -> "no")
