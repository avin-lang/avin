// expect: exit 0
// An impl with bounds of its own makes a data type conform for the type arguments that meet them:
// `Box[T]` is ordered when `T` is, and a box of anything still compares with `==`, by value. The
// impl's methods use the bounds, and each instance calls its type argument's own methods.

data Box[T](item: T)

impl[T: Ord] Ord for Box[T]
    compare(other: Box[T]) -> int = item.compare(other.item)

data Labelled[T](label: string, value: T)

// Compared by the value alone, wherever the value's type compares and hashes.
impl[T: Eq] Eq for Labelled[T]
    equals(other: Labelled[T]) -> bool = value == other.value

impl[T: Hash] Hash for Labelled[T]
    hash() -> long = value.hash()

data Pair[A, B](first: A, second: B)

impl[A: Add, B: Add] Add for Pair[A, B]
    add(other: Pair[A, B]) -> Pair[A, B] = Pair(first + other.first, second + other.second)
    static zero() -> Pair[A, B] = Pair(A.zero(), B.zero())

largest[T: Ord](a: T, b: T) -> T = if a < b then b else a

class Token(val id: int)

main()
    println(s"${largest(Box(3), Box(8)).item} ${largest(Box("pear"), Box("fig")).item} ${Box(1) < Box(2)}")
    println(s"${largest(Box(Box(2)), Box(Box(1))).item.item}")
    val t = Token(1)
    println(s"${Box(t) == Box(t)} ${Box(t) == Box(Token(1))}")
    println(s"${Labelled("a", 1) == Labelled("b", 1)} ${Labelled("a", 1) == Labelled("a", 2)} ${Labelled("x", 5).hash() == Labelled("y", 5).hash()}")
    val p = Pair(1, "a") + Pair(2, "b")
    println(s"${p.first} ${p.second}")
