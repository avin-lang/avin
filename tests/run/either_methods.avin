// expect: exit 0
// Either's members on a Left and on a Right, its companion's `cond`, and Option's `toRight` and
// `toLeft` on Some and on None.

half(n: int) -> Either[string, int] = if n % 2 == 0 then Right(n / 2) else Left(s"$n is odd")

main()
  val r: Either[string, int] = Right(4)
  val l: Either[string, int] = Left("no")
  println(s"$r $l")
  println(s"${r.isRight} ${r.isLeft} ${l.isRight} ${l.isLeft}")
  println(r.fold(s -> s"left $s", n -> s"right ${n * 10}"))
  println(l.fold(s -> s"left $s", n -> s"right ${n * 10}"))
  println(s"${r.swap} ${l.swap}")
  println(s"${r.map(n -> n + 1)} ${l.map(n -> n + 1)}")
  println(s"${r.flatMap(half)} ${r.flatMap(n -> half(n + 1))} ${l.flatMap(half)}")
  var evaluated = 0
  fallback() -> int
    evaluated += 1
    7
  println(s"${r.getOrElse(fallback())} ${l.getOrElse(fallback())} evaluated $evaluated")
  other() -> Either[string, int]
    evaluated += 1
    Right(9)
  println(s"${r.orElse(other())} ${l.orElse(other())} ${l.orElse(Left("again"))} evaluated $evaluated")
  zero() -> string
    evaluated += 1
    "small"
  println(s"${r.filterOrElse(n -> n > 3, zero())} ${r.filterOrElse(n -> n > 4, zero())} evaluated $evaluated")
  println(s"${l.filterOrElse(n -> true, zero())} evaluated $evaluated")
  println(s"${r.contains(4)} ${r.contains(5)} ${l.contains(4)}")
  println(s"${r.exists(n -> n > 3)} ${r.exists(n -> n > 4)} ${l.exists(n -> true)}")
  println(s"${r.forall(n -> n > 3)} ${r.forall(n -> n > 4)} ${l.forall(n -> false)}")
  println(s"${r.toOption} ${l.toOption}")
  println(s"${r.toList} ${l.toList} ${r.toVector} ${l.toVector}")
  r.foreach(n -> println(s"foreach $n"))
  l.foreach(n -> println("unreachable"))
  println(s"${r.iterator().toList} ${l.iterator().hasNext()}")
  for n in r.toList do println(s"for $n")
  for n in l.toList do println("unreachable")

  val same: Either[int, int] = Left(3)
  val differ: Either[int, int] = Right(5)
  println(s"${same.merge} ${differ.merge}")
  val nestedLeft: Either[Either[string, int], int] = Left(Right(1))
  val plainRight: Either[Either[string, int], int] = Right(2)
  println(s"${nestedLeft.joinLeft} ${plainRight.joinLeft}")
  val nestedRight: Either[string, Either[string, int]] = Right(Left("inner"))
  val plainLeft: Either[string, Either[string, int]] = Left("outer")
  println(s"${nestedRight.joinRight} ${plainLeft.joinRight}")

  var sides = 0
  rightSide() -> int
    sides += 1
    1
  leftSide() -> string
    sides += 10
    "no"
  val yes: Either[string, int] = Either.cond(true, rightSide(), leftSide())
  val no: Either[string, int] = Either.cond(false, rightSide(), leftSide())
  println(s"$yes $no sides $sides")

  val some: Option[int] = Some(2)
  val none: Option[int] = None
  var asked = 0
  missing() -> string
    asked += 1
    "missing"
  ratio() -> real
    asked += 1
    0.5
  println(s"${some.toRight(missing())} ${none.toRight(missing())} asked $asked")
  println(s"${some.toLeft(ratio())} ${none.toLeft(ratio())} asked $asked")

  println(s"${r == Right(4)} ${r == l} ${l == Left("no")} ${debug(r)} ${debug(l)}")
  val described = l match
    Left(why) -> s"left $why"
    Right(n) -> s"right $n"
  println(described)
