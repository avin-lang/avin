// expect: trap
// A derived value's computation may only read: a write from inside one traps, saying to write from
// an effect instead. Writes before it, outside any computation, stand.
import avin.reactive.Graph

main()
  val g = Graph()
  val a = g.atom(1)
  val b = g.atom(0)
  b.set(5)
  println(b.get())
  val d = g.derived(get ->
    b.set(get(a))
    get(a) + 1)
  println(d.get())
