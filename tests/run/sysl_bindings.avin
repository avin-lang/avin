// Sysl functions called through bindings, with every boundary type crossing in each direction.

@sysl("sysl.text.to_upper")
upper(s: string) -> string

@sysl("sysl.text.eq_fold")
sameFolded(a: string, b: string) -> bool

@sysl("sysl.path.is_absolute")
isAbsolute(p: string) -> bool

@sysl("sysl.math.nextafter")
nextAfter(x: real, toward: real) -> real

@sysl("sysl.time.days_in_month")
daysInMonth(year: int, month: int) -> int

// Narrower integers cross too: Sysl widens them where the function takes an `int`.
@sysl("sysl.time.days_in_month")
daysInMonthNarrow(year: i16, month: i8) -> int

@sysl("sysl.unicode.to_upper")
upperChar(c: char) -> char

@sysl("sysl.unicode.is_upper")
isUpper(c: char) -> bool

@sysl("sysl.prints")
write(s: string)

@sysl("sysl.text.is_char_boundary")
startsChar(b: byte) -> bool

@sysl("sysl.posix.time.nanosleep")
sleepNanos(nanos: long) -> long

main()
    print(upper("hello, wörld"))
    // A string made at run time crosses as well as a literal, and so does the empty string.
    val name = "avin" + "-" + "lang"
    print(upper(name))
    print(s"[${upper("")}]")
    print(s"${sameFolded("Straße", "STRASSE")} ${sameFolded("a", "b")}")
    print(s"${isAbsolute("/usr")} ${isAbsolute("usr")}")
    print(s"${nextAfter(1.0, 2.0) > 1.0} ${nextAfter(1.0, 0.0) < 1.0}")
    print(s"${daysInMonth(2024, 2)} ${daysInMonth(2023, 2)} ${daysInMonthNarrow(2023, 12)}")
    print(s"${upperChar('λ')} ${isUpper('Q')} ${isUpper('q')}")
    print(s"${startsChar(0x41)} ${startsChar(0x80)} ${startsChar(0xff)} ${sleepNanos(1)}")
    // Sysl's standard output is the program's, so what each side writes stays in order.
    write("from Sysl, ")
    print("then Avin")
    // A binding is a function like any other: it can be passed as a value.
    val f: string -> string = upper
    print(f("value"))
    // Strings a binding returns are collected like any other.
    var total = 0
    var i = 0
    while i < 200
        total = total + (if upper("x" + s"$i") == "X" + s"$i" then 1 else 0)
        i = i + 1
    print(s"$total")
