// expect: trap
// Removing the first entry of an empty mutable tree map traps, once the entries are used up.

import avin.collections.mutable.{TreeMap as MutableTreeMap}

main()
  val m = MutableTreeMap[int, string]()
  m(2) = "b"
  m(1) = "a"
  println(m.removeFirst())
  println(m.removeFirst())
  println(m.removeFirst())
