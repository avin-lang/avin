// expect: exit 0
// A thread's result is an object on the heap: a class holding a list and a string, made by the
// thread and handed back by `join`. It survives every collection after the thread has ended and its
// context is gone, while the main thread allocates over it, and a second join gives the same object.
import avin.threads.spawn

class Report(val name: string, val lines: List[string])

main() -> int
    val t = spawn(() ->
        var lines: List[string] = []
        for i in 0..<100 do lines = s"line $i" :: lines
        Report("made by a thread", lines))
    val report = t.join()
    var garbage: List[string] = []
    for i in 0..<300 do garbage = s"garbage $i" :: garbage
    if garbage.length() != 300 then return 1
    if t.join() !== report then return 2
    print(report.name)
    print(report.lines.length())
    print(report.lines.head())
    0
