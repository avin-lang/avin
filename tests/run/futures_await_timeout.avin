// expect: exit 0
// `await(timeoutMillis)` gives `None` once the time runs out with no value, having waited that long,
// and `Some` of the value where it comes in time; a time that is not positive asks without waiting.
// A condition's `waitFor` answers the same way, from inside its mutex.
import avin.threads.{Future, Mutex, Promise, spawn}

@sysl("avin.rt.monotonic_millis")
millis() -> long

main() -> int
    val never = Promise[int]()
    val before = millis()
    val expired = never.future.await(50)
    val waited = millis() - before
    println(s"expired $expired, waited long enough ${waited >= 49}")
    println(s"zero ${never.future.await(0)} negative ${never.future.await(-1)}")
    val slow = Promise[string]()
    spawn(() ->
        val gate = Mutex(0)
        val c = gate.condition()
        gate.with(_ -> c.waitFor(20))
        slow.complete("in time"))
    println(s"in time ${slow.future.await(5000)}")
    println(s"done at once ${Future.successful(3).await(0)}")
    val m = Mutex(0)
    val c = m.condition()
    val timedOut = m.with(_ -> c.waitFor(10))
    println(s"condition timed out ${!timedOut}")
    0
