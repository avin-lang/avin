// expect: exit 0
// Arms that stay legal: an arm with a guard never hides the arms after it, an arm that earlier arms
// cover only in part is reached, an extractor answers at run time so the arms after it are reached,
// and a machine state may override a shared arm by handling the event itself.
data Ev
  Start
  Stop
  Tick(n: int)

object Even
  unapply(n: int) -> bool = n % 2 == 0

guarded(n: int) -> string = n match
  n if n > 100 -> "big"
  _ if n < 0 -> "negative"
  0 -> "zero"
  n -> "other"

partial(o: Option[int]) -> string = o match
  Some(0) -> "zero"
  Some(n) if n > 0 -> "positive"
  Some(_) -> "negative"
  None -> "none"

ranges(n: int) -> string = n match
  0 ..< 10 -> "digit"
  5 ..< 20 -> "teen-ish"
  n < 0 -> "negative"
  _ -> "large"

extractor(n: int) -> string = n match
  Even() -> "even"
  Even() -> "never even twice"
  n -> "odd"

words(s: string) -> string = s match
  "a" -> "first"
  "b" -> "second"
  _ -> "other"

pairs(p: (bool, bool)) -> string = p match
  (true, _) -> "left"
  (_, true) -> "right"
  (false, false) -> "neither"

clause(n: int) -> string
clause(0) = "zero"

clause(n)
  | n > 0 = "positive"
  | _ = "negative"

guardedClause(n: int) -> string
guardedClause(n) | n > 0 = "positive"
guardedClause(_) = "other"

sequences(v: Vector[int]) -> string = v match
  [] -> "empty"
  [x] -> "one"
  [x, rest*] -> "many"

machine Door receives Ev
  state Closed
    Start -> Open
    Tick(_) -> stay

  state Open
    Stop -> Closed

  receive
    Tick(n) -> stay
    _ -> stay

main()
  println(guarded(200) + " " + guarded(-1) + " " + guarded(0) + " " + guarded(5))
  println(partial(Some(0)) + " " + partial(Some(3)) + " " + partial(Some(-3)) + " " + partial(None))
  println(ranges(3) + " " + ranges(15) + " " + ranges(-4) + " " + ranges(40))
  println(extractor(4) + " " + extractor(5))
  println(words("a") + " " + words("b") + " " + words("c"))
  println(pairs((true, false)) + " " + pairs((false, true)) + " " + pairs((false, false)))
  println(clause(0) + " " + clause(1) + " " + clause(-1) + " " + guardedClause(1) + " " + guardedClause(0))
  println(sequences([]) + " " + sequences([1]) + " " + sequences([1, 2]))
  val door = Door()
  door.handle(Start)
  door.handle(Tick(1))
  door.handle(Stop)
  println(door.state())
