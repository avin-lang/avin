// expect: exit 0
// The methods every integer type has: abs, sign, pow, gcd, lcm, floorDiv, floorMod, bitCount,
// leadingZeros, trailingZeros, isPowerOfTwo and toRadix, at int, long, i8 and a width above 64 bits,
// on zero, one, negatives and the greatest and least values.

main()
    abs()
    sign()
    pow()
    gcd()
    lcm()
    floors()
    bits()
    radix()

abs()
    println(s"abs ${(-5).abs} ${5.abs} ${0.abs} ${int.MaxValue.abs} ${(-int.MaxValue).abs}")
    val l: long = -9
    println(s"abs ${l.abs} ${long.MaxValue.abs} ${(-long.MaxValue).abs}")
    val b: i8 = -127
    val c: i8 = 127
    println(s"abs ${b.abs} ${c.abs}")
    val w: i128 = -170141183460469231731687303715884105727
    println(s"abs ${w.abs}")

sign()
    println(s"sign ${(-5).sign} ${0.sign} ${5.sign} ${int.MinValue.sign} ${int.MaxValue.sign}")
    val l: long = long.MinValue
    val c: i8 = -128
    val one: i1 = -1
    println(s"sign ${l.sign} ${long.MaxValue.sign} ${c.sign} ${one.sign} ${i1.MaxValue.sign}")
    // The result is an int whatever the width.
    val s: int = c.sign
    println(s"sign ${s}")

pow()
    println(s"pow ${2.pow(10)} ${3.pow(0)} ${0.pow(0)} ${0.pow(5)} ${1.pow(1000000)} ${(-2).pow(3)} ${(-2).pow(4)}")
    println(s"pow ${2.pow(30)} ${(-2).pow(31)} ${46340.pow(2)} ${(-1).pow(int.MaxValue)} ${(-1).pow(2147483646)}")
    val l: long = 2
    println(s"pow ${l.pow(62)} ${(-l).pow(63)} ${long(10).pow(18)}")
    val b: i8 = 2
    println(s"pow ${b.pow(6)} ${(-b).pow(7)} ${b.pow(0)}")
    val x: i8 = 11
    println(s"pow ${x.pow(2)} ${x.pow(1)}")
    // The last squaring is never made: 2^30 needs a base of 2^16 only for bits it does not use.
    println(s"pow ${2.pow(30)} ${3.pow(19)}")
    val w: i128 = 2
    println(s"pow ${w.pow(126)}")

gcd()
    println(s"gcd ${12.gcd(18)} ${18.gcd(12)} ${7.gcd(13)} ${0.gcd(5)} ${5.gcd(0)} ${0.gcd(0)} ${6.gcd(6)}")
    println(s"gcd ${(-12).gcd(18)} ${12.gcd(-18)} ${(-12).gcd(-18)} ${1.gcd(int.MaxValue)} ${int.MaxValue.gcd(int.MaxValue)}")
    println(s"gcd ${int.MinValue.gcd(6)} ${int.MinValue.gcd(-1)} ${int.MinValue.gcd(3)} ${6.gcd(int.MinValue)}")
    val l: long = long.MinValue
    println(s"gcd ${l.gcd(4)} ${l.gcd(-1)} ${l.gcd(long.MaxValue)}")
    val b: i8 = -128
    println(s"gcd ${b.gcd(2)} ${b.gcd(-1)}")

lcm()
    println(s"lcm ${4.lcm(6)} ${6.lcm(4)} ${3.lcm(7)} ${0.lcm(5)} ${5.lcm(0)} ${0.lcm(0)} ${5.lcm(5)} ${1.lcm(9)}")
    println(s"lcm ${(-4).lcm(6)} ${4.lcm(-6)} ${(-4).lcm(-6)}")
    println(s"lcm ${int.MaxValue.lcm(1)} ${int.MaxValue.lcm(int.MaxValue)} ${1073741824.lcm(2)} ${46341.lcm(46340)}")
    val l: long = long.MaxValue
    println(s"lcm ${l.lcm(1)} ${l.lcm(l)} ${long.MinValue.lcm(0)} ${long(0).lcm(long.MinValue)}")
    val b: i8 = 12
    println(s"lcm ${b.lcm(10)} ${b.lcm(8)}")

floors()
    println(s"floorDiv ${7.floorDiv(2)} ${(-7).floorDiv(2)} ${7.floorDiv(-2)} ${(-7).floorDiv(-2)} ${6.floorDiv(3)} ${(-6).floorDiv(3)} ${0.floorDiv(5)}")
    println(s"floorMod ${7.floorMod(2)} ${(-7).floorMod(2)} ${7.floorMod(-2)} ${(-7).floorMod(-2)} ${6.floorMod(3)} ${(-6).floorMod(3)} ${0.floorMod(-5)}")
    println(s"floor ${int.MinValue.floorDiv(2)} ${int.MinValue.floorMod(-1)} ${int.MinValue.floorMod(int.MaxValue)} ${int.MaxValue.floorMod(int.MinValue)}")
    println(s"floor ${(-1).floorDiv(int.MaxValue)} ${(-1).floorMod(int.MaxValue)} ${1.floorDiv(int.MinValue)} ${1.floorMod(int.MinValue)}")
    val l: long = long.MinValue
    println(s"floor ${l.floorDiv(3)} ${l.floorMod(3)} ${l.floorDiv(long.MaxValue)} ${l.floorMod(long.MaxValue)}")
    val b: i8 = -128
    val three: i8 = 3
    println(s"floor ${b.floorDiv(three)} ${b.floorMod(three)} ${b.floorMod(-1)}")
    // The identity holds across signs.
    var ok = true
    for a in -9..9
        for d in -4..4
            if d != 0 && a.floorDiv(d) * d + a.floorMod(d) != a then ok = false
            if d != 0 && a.floorMod(d) != 0 && (a.floorMod(d) < 0) != (d < 0) then ok = false
    println(s"floor identity ${ok}")

bits()
    println(s"bitCount ${0.bitCount} ${1.bitCount} ${255.bitCount} ${(-1).bitCount} ${int.MaxValue.bitCount} ${int.MinValue.bitCount} ${(-2).bitCount}")
    println(s"leadingZeros ${0.leadingZeros} ${1.leadingZeros} ${255.leadingZeros} ${(-1).leadingZeros} ${int.MaxValue.leadingZeros} ${int.MinValue.leadingZeros}")
    println(s"trailingZeros ${0.trailingZeros} ${1.trailingZeros} ${8.trailingZeros} ${(-1).trailingZeros} ${int.MaxValue.trailingZeros} ${int.MinValue.trailingZeros} ${(-8).trailingZeros}")
    println(s"isPowerOfTwo ${0.isPowerOfTwo} ${1.isPowerOfTwo} ${2.isPowerOfTwo} ${3.isPowerOfTwo} ${1073741824.isPowerOfTwo} ${int.MaxValue.isPowerOfTwo} ${int.MinValue.isPowerOfTwo} ${(-4).isPowerOfTwo}")
    val l: long = long.MinValue
    val m: long = long.MaxValue
    println(s"long ${l.bitCount} ${m.bitCount} ${l.leadingZeros} ${m.leadingZeros} ${l.trailingZeros} ${m.trailingZeros} ${long(0).leadingZeros} ${long(0).trailingZeros}")
    println(s"long ${long(1).leadingZeros} ${long(4294967296).isPowerOfTwo} ${l.isPowerOfTwo} ${m.isPowerOfTwo}")
    val b: i8 = -128
    val c: i8 = 127
    val z: i8 = 0
    println(s"i8 ${b.bitCount} ${c.bitCount} ${z.bitCount} ${b.leadingZeros} ${c.leadingZeros} ${z.leadingZeros} ${z.trailingZeros} ${b.trailingZeros}")
    val p: i8 = 64
    println(s"i8 ${p.isPowerOfTwo} ${b.isPowerOfTwo} ${c.isPowerOfTwo} ${p.leadingZeros} ${p.trailingZeros}")
    // Every width counts its own width of bits.
    val one: i1 = -1
    val zero: i1 = 0
    println(s"i1 ${one.bitCount} ${zero.bitCount} ${one.leadingZeros} ${zero.leadingZeros} ${one.trailingZeros} ${zero.trailingZeros}")
    val two: i2 = 1
    val minus: i2 = -2
    println(s"i2 ${two.bitCount} ${minus.bitCount} ${two.leadingZeros} ${minus.trailingZeros} ${two.isPowerOfTwo}")
    val w: i128 = 1
    val wn: i128 = -1
    println(s"i128 ${w.bitCount} ${wn.bitCount} ${w.leadingZeros} ${wn.leadingZeros} ${w.trailingZeros} ${(w + w + w + w).isPowerOfTwo}")
    val w65: i65 = 4611686018427387904
    println(s"i65 ${w65.bitCount} ${w65.leadingZeros} ${w65.trailingZeros} ${(-w65).bitCount}")

radix()
    println(s"radix ${255.toRadix(16)} ${255.toRadix(2)} ${255.toRadix(8)} ${255.toRadix(10)} ${255.toRadix(36)} ${35.toRadix(36)} ${36.toRadix(36)}")
    println(s"radix ${0.toRadix(2)} ${0.toRadix(36)} ${1.toRadix(2)} ${(-255).toRadix(16)} ${(-1).toRadix(2)} ${(-35).toRadix(36)}")
    println(s"radix ${int.MaxValue.toRadix(16)} ${int.MinValue.toRadix(16)} ${int.MinValue.toRadix(2)} ${int.MinValue.toRadix(10)} ${int.MaxValue.toRadix(36)} ${int.MinValue.toRadix(36)}")
    val l: long = long.MinValue
    println(s"radix ${l.toRadix(16)} ${long.MaxValue.toRadix(16)} ${l.toRadix(36)} ${l.toRadix(10)} ${l.toRadix(2)}")
    // Agrees with `%x` and `%b`, which also write a sign and magnitude.
    println(f"${255}%x ${-255}%x ${255}%b ${-255}%b ${int.MinValue}%x")
    println(s"${(-255).toRadix(16) == f"${-255}%x"} ${int.MinValue.toRadix(16) == f"${int.MinValue}%x"} ${(-255).toRadix(2) == f"${-255}%b"}")
    // Widths too narrow to hold the radix go through a wider one.
    val b: i8 = -128
    val c: i8 = 127
    println(s"radix ${b.toRadix(2)} ${c.toRadix(2)} ${b.toRadix(36)} ${c.toRadix(36)} ${b.toRadix(16)} ${c.toRadix(16)}")
    val i3: i3 = -4
    val i5: i5 = 15
    val i6: i6 = -32
    val i6m: i6 = 31
    println(s"radix ${i3.toRadix(36)} ${i3.toRadix(2)} ${i5.toRadix(36)} ${i5.toRadix(16)} ${i6.toRadix(32)} ${i6.toRadix(36)} ${i6m.toRadix(36)} ${i6m.toRadix(2)}")
    val one: i1 = -1
    val zero: i1 = 0
    println(s"radix ${one.toRadix(2)} ${one.toRadix(36)} ${zero.toRadix(36)}")
    val w: i128 = 1
    println(s"radix ${(w + w + w + w + w + w + w + w + w + w + w + w + w + w + w + w).toRadix(2)} ${(-w).toRadix(36)}")
    val big: i128 = 170141183460469231731687303715884105727
    println(s"radix ${big.toRadix(16)} ${(-big - w).toRadix(16)} ${big.toRadix(36)}")
