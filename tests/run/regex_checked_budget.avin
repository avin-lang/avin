// expect: exit 0
// The checked searches: every `try` method answers a `MatchError` where an attempt at a start spends
// its step budget, in place of trapping, and answers what its plain search does otherwise. The error
// ends the whole search, wherever in the text it is met; the regex itself is untouched by it.
import avin.regex.{Regex, MatchError}

show[T: Display](label: string, r: Result[T, MatchError]) = r match
    Ok(v) -> println(s"$label: Ok($v)")
    Err(e) -> println(s"$label: Err(${e.inputLength}, ${e.budget})")

// The lines a regex matches, as a program reading text from outside counts them: the first line
// whose search spends its budget ends the count.
countMatching(r: Regex, lines: Vector[string]) -> Result[int, MatchError]
    var n = 0
    for line in lines
        if r.tryMatches(line)? then n += 1
    Ok(n)

main()
    val a40b = "a".repeat(40) + "b"
    // A reluctant repetition of a group backtracks exponentially; a limit keeps the test quick.
    val bad = Regex("(a+)+?$").withStepLimit(100000)

    // Every checked entry point, on the input that spends the budget.
    show("tryMatches", bad.tryMatches(a40b))
    show("tryMatches unanchored", bad.unanchored().tryMatches(a40b))
    show("tryFindFirstIn", bad.tryFindFirstIn(a40b))
    show("tryFindFirstMatchIn", bad.tryFindFirstMatchIn(a40b))
    show("tryFindPrefixOf", bad.tryFindPrefixOf(a40b))
    show("tryFindPrefixMatchOf", bad.tryFindPrefixMatchOf(a40b))
    show("tryFindAllIn", bad.tryFindAllIn(a40b))
    show("tryFindAllMatchIn", bad.tryFindAllMatchIn(a40b))
    show("tryReplaceAllIn", bad.tryReplaceAllIn(a40b, "x"))
    show("tryReplaceAllIn f", bad.tryReplaceAllIn(a40b, m -> "x"))
    show("tryReplaceFirstIn", bad.tryReplaceFirstIn(a40b, "x"))
    show("tryReplaceSomeIn", bad.tryReplaceSomeIn(a40b, m -> Some("x")))
    show("trySplit", bad.trySplit(a40b))
    show("Pattern.trySplit", bad.pattern().trySplit(a40b, 2))

    // The same pattern on short inputs, and on inputs it matches, answers as the plain search does.
    show("short tryMatches", bad.tryMatches("aaaa"))
    show("short tryFindFirstIn", bad.tryFindFirstIn("aaab"))
    show("short tryFindFirstMatchIn", bad.tryFindFirstMatchIn("baaa").map(o -> o.map(m -> m.start())))
    show("short tryFindPrefixOf", bad.tryFindPrefixOf("aaa"))
    show("short tryFindAllIn", Regex("a+").tryFindAllIn("aa b aaa"))
    show("short tryFindAllMatchIn", Regex("a+").tryFindAllMatchIn("aa b aaa").map(ms -> ms.map(m -> m.end())))
    show("short tryReplaceAllIn", Regex("(a+)").tryReplaceAllIn("aa b aaa", "<$1>"))
    show("short tryReplaceSomeIn", Regex("a+").tryReplaceSomeIn("aa b aaa", m -> if m.matched().byteLength() > 2 then Some("3") else None))
    show("short trySplit", Regex(",").trySplit("x,y,,"))
    show("short Pattern.trySplit", Regex(",").pattern().trySplit("x,y,,", -1).map(a -> a.length))
    show("empty input", bad.tryFindFirstIn(""))
    show("empty matches", Regex("").tryMatches(""))

    // The error itself: the pattern, the input's length in characters and the budget.
    bad.tryFindFirstIn(a40b) match
        Err(e) ->
            println(e.pattern)
            println(e.message)
            println(s"$e")
            println(e == MatchError("(a+)+?$", 41, 100000))
        Ok(_) -> println("no error")

    // The regex is untouched by an error: a search after one answers as before.
    show("after an error", bad.tryFindFirstIn("aaa"))
    show("plain after an error", Ok(bad.findFirstIn("aaa")))

    // Unicode input: the length counts characters, not bytes.
    show("unicode", Regex("(é+)+?$").withStepLimit(100000).tryFindFirstIn("é".repeat(40) + "b"))
    show("unicode short", Regex("(é+)+?$").withStepLimit(100000).tryFindFirstIn("éé"))

    // A budget spent inside a lookaround or an atomic group is not read as the body's failing: a
    // negative lookahead does not turn it into a match.
    show("negative lookahead", Regex("(?!(a+)+?$).*").withStepLimit(100000).tryMatches(a40b))
    show("lookahead", Regex("(?=(a+)+?$).*").withStepLimit(100000).tryMatches(a40b))
    show("atomic", Regex("(?>(a+)+?$)").withStepLimit(100000).tryFindFirstIn(a40b))
    show("negative lookahead short", Regex("(?!(a+)+?$).*").withStepLimit(100000).tryMatches("aab"))

    // The default budget, with no limit set.
    show("default budget", Regex("(a+)+?$").tryFindFirstIn(a40b))

    // A Result composes with `?`.
    val lines = Vector("aaa", "aab", "a", a40b, "aaaa")
    show("count good", countMatching(bad, lines.take(3)))
    show("count bad", countMatching(bad, lines))

    // Inside closures and collections.
    println(Vector("aa", a40b, "b").map(s -> bad.tryMatches(s).isOk()))
