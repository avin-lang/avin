// expect: trap
// An extension added to a table of types is the text after a name's last `.`, so it is not empty and
// holds no `.` or `/`: `tar` is taken, and `tar.gz` traps where the table is extended.
import avin.net.http.MimeTypes

main()
  println(MimeTypes.standard.with("tar", "application/x-tar").typeOf("a.tar"))
  println(MimeTypes.standard.with("tar.gz", "application/gzip").typeOf("a.tar.gz"))
