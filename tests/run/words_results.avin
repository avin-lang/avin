// expect: exit 0
// A call whose tuple the caller takes apart, `val (a, b) = f(x)`, is made to a copy of `f` that
// answers with the tuple's parts, one machine word each, so neither function makes the tuple: parts of
// every machine type, references beside scalars, through recursion, generic copies, methods, local
// functions, calls in tail position and returns, nested and refutable patterns, and a tuple made at
// compile time. Every part must arrive as it was made.

data Cell(n: int, label: string)

// Recursion keeps the function from being copied into its callers, so the call is made.
countdown(n: int) -> (string, int)
    if n == 0 then return ("done", 0)
    val (s, k) = countdown(n - 1)
    (s + "!", k + n)

// Every machine type in one tuple: a byte, a char, a bool, a real, a long, a short and a string.
everything(n: int) -> (byte, char, bool, real, long, i16, string)
    if n > 0 then return everything(n - 1)
    (byte(255), 'é', true, -0.5, -9223372036854775807 - 1, i16(32767), "ünï")

// A part with no runtime value is no word.
withUnit(n: int) -> (unit, int, string)
    if n > 0 then return withUnit(n - 1)
    ((), 42, "unit")

// A tuple part is one reference word, an option kept as a pointer is the pointer, and an option of
// a number is an object.
nested(n: int) -> ((int, string), Option[Cell], Option[int], Cell)
    if n > 0 then return nested(n - 1)
    ((7, "seven"), Some(Cell(1, "one")), Some(-3), Cell(2, "two"))

nothing(n: int) -> (Option[Cell], Option[int])
    if n > 0 then return nothing(n - 1)
    (None, None)

// Generic copies at scalar and reference arguments.
twice[A, B](a: A, b: B, n: int) -> (A, B, int)
    if n == 0 then return (a, b, 0)
    val (x, y, k) = twice(a, b, n - 1)
    (x, y, k + 1)

class Counter(var total: int)
    // A method answering with a tuple, called directly.
    step(by: int, n: int) -> (int, Counter)
        if n == 0 then return (total, self)
        total += by
        step(by, n - 1)

// A call in tail position of a function answering with a tuple passes the callee's words on as they
// come, through two functions that call each other.
ping(n: int, trail: string) -> (string, long)
    if n == 0 then return (trail, 0)
    pong(n - 1, trail + "i")

pong(n: int, trail: string) -> (string, long)
    if n == 0 then (trail, 1) else ping(n - 1, trail + "o")

// Calls in tail position between two such functions run in constant stack, however deep.
even(n: int, seen: long) -> (bool, long)
    if n == 0 then (true, seen) else odd(n - 1, seen + 1)

odd(n: int, seen: long) -> (bool, long)
    if n == 0 then (false, seen) else even(n - 1, seen + 1)

// A tail call of itself is a loop; the tuple is taken apart where the loop ends.
spin(n: int, acc: long, s: string) -> (long, string)
    if n == 0 then (acc, s) else spin(n - 1, acc + long(n), s)

// The arms of a `match` meet in one tuple, and an early `return` leaves with another.
choose(k: int) -> (int, string)
    if k < 0 then return (k, "negative")
    k match
        0 -> (0, "zero")
        1 -> (1, "one")
        _ -> if k > 100 then choose(-k) else (k, "many")

// A module-level tuple made at compile time: its parts are read where it is returned.
val Fixed: (int, string) = (2147483647, "")

fixed(n: int) -> (int, string) = if n > 0 then fixed(n - 1) else Fixed

// A local function capturing a parameter and a local.
outer(base: int) -> int
    val extra = 10
    inner(n: int) -> (int, int)
        if n == 0 then return (base, extra)
        val (a, b) = inner(n - 1)
        (a + 1, b)
    val (a, b) = inner(3)
    a + b

main() -> int
    val (s, k) = countdown(5)
    println(s"$s $k")
    val (b, c, flag, r, l, h, text) = everything(2)
    println(s"$b $c $flag $r $l $h $text")
    val (u, x, label) = withUnit(1)
    println(s"$u $x $label")
    val ((i, name), cell, number, other) = nested(3)
    println(s"$i $name ${cell.map(c -> c.label).getOrElse("-")} ${number.getOrElse(0)} ${other.label}")
    val (none1, none2) = nothing(1)
    println(s"${none1.isEmpty} ${none2.isEmpty}")
    val (p, q, depth) = twice(-2147483648, "two", 4)
    println(s"$p $q $depth")
    val (cellAgain, empty, depth2) = twice(Cell(5, "five"), "", 2)
    println(s"${cellAgain.label} [$empty] $depth2")
    val counter = Counter(0)
    val (total, same) = counter.step(3, 4)
    println(s"$total ${same.total}")
    val (trail, parity) = ping(5, "")
    println(s"$trail $parity")
    val (isEven, steps) = even(10000001, 0)
    println(s"$isEven $steps")
    val (sum, tag) = spin(100000, 0, "looped")
    println(s"$sum $tag")
    for k in [-1, 0, 1, 7, 101]
        val (n, word) = choose(k)
        println(s"$k -> $n $word")
    val (max, blank) = fixed(1)
    println(s"$max [$blank]")
    println(outer(5))
    // A nested pattern reaches into the parts as they arrive.
    val (first, (rest, set)) = some(3)
    println(s"${first.map(c -> c.label).getOrElse("-")} $rest $set")
    0

some(n: int) -> (Option[Cell], (int, bool))
    if n > 0 then return some(n - 1)
    (Some(Cell(9, "made")), (9, true))
