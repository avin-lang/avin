// expect: exit 0
// `f` called directly on a `StringContext` reads each specifier from the start of the part after its
// hole as the program runs, and renders as an `f"…"` literal does: its parts' escapes decoded, a
// width or precision given as an `int` or `long` argument of its own, and a `%` anywhere else as
// text. An argument renders in its own form under a conversion its type does not take. An `f"…"`
// literal and the call it denotes make the same text.
main()
    val x = 3.14159265
    val n = 42
    println(StringContext(["[", "%05d] [", "%-8.3f] [", "%#x]\\t|"]).f(n, x, 255))
    println(f"[${n}%05d] [${x}%-8.3f] [${255}%#x]\t|")
    println(StringContext(["", "%", ".", "f|", "%-", "s|"]).f(x, 9, 2, "ab", 4))
    println(f"${x}%${9}.${2}f|${"ab"}%-${4}s|")
    val w: long = -5
    println(StringContext(["<", "%", "d> 100% <", "%.0s>"]).f(7, w, "gone"))
    println(StringContext(["", "%f ", "%c ", "%s ", "%+d ", "%e"]).f(7, 'q', 2.5, "s", x))
    println(StringContext(["only"]).f(), StringContext(["", ""]).f("bare"))
