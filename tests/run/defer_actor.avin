// expect: exit 0
// A turn of an actor is a block like any other: its deferred statements run as the turn ends, by its
// end, and a loop's in it at each `break`, and the `stopping` block may defer too. A turn that traps
// fails the actor without running the turn's deferred statements; the actor's `stopping` block still
// runs, as for any failed turn.
import avin.actors.{Stop, spawn}
import avin.threads.{Channel, Promise}

data Msg
    Work(n: int)
    Find(xs: Vector[int], target: int, reply: Promise[int])
    Fail(n: int)

actor Worker(log: Channel[string]) receives Msg
    var done = 0
    receive
        Work(n) ->
            defer log.send(s"work $n: closed")
            done += n
            log.send(s"work $n: done $done")
        Find(xs, target, reply) ->
            defer log.send(s"find $target: closed")
            var at = -1
            for i in 0..<xs.length
                defer log.send(s"  find $target: looked at $i")
                if xs(i) == target
                    at = i
                    break
            reply.complete(at)
        Fail(n) ->
            defer log.send("fail: never sent")
            log.send("fail: dividing")
            done = done / (n - n)
    stopping
        defer log.send("stopping: closed")
        log.send(s"stopping at $done")

show(log: Channel[string], n: int) = for _ in 0..<n do println(log.receive().get)

main()
    val log = Channel[string]()
    val w = spawn(Worker(log), onFailure = Stop)
    w.tell(Work(3))
    show(log, 2)
    val found = Promise[int]()
    w.tell(Find([4, 5, 6], 5, found))
    println(found.future.await())
    show(log, 3)
    w.tell(Fail(1))
    println(w.ended().await())
    show(log, 3)
