// expect: exit 0
// A function, constructor or method whose parameter is marked is still a value where the value's type
// gives that parameter a sendable type. With no function type expected it takes the `@sendable` form
// of each marked function parameter, so `spawn[int]`, a function of the program's own, a method value
// and a local function are values as they are, and a closure passed through one is checked where it
// is written. A `@sendable` function type written for the value, an overload chosen by one, a value
// passed to a higher-order or generic function whose parameter type is `@sendable`, a placeholder
// lambda of that type, a marked parameter of a sendable type (`int`), a constructor at a sendable type
// argument, and a function-typed class whose `apply` marks a parameter the type makes sendable are
// all legal, and each runs.
import avin.threads.{spawn, Thread, Future, Mutex}
import avin.actors.Isolated

runAway(@sendable f: () -> unit) -> unit = spawn(f).join()

keep(@sendable n: int) -> int = n + 1

lift[T: Sendable](@sendable body: () -> T) -> T = spawn(body).join()

wrap[T](f: (@sendable () -> T) -> T, g: @sendable () -> T) -> T = f(g)

hold[F](f: F) -> F = f

hof(f: (@sendable () -> int, long) -> Thread[int]) -> int = f(() -> 40, 65536).join()

pass(@sendable f: () -> unit) -> unit = f()
pass(@sendable f: (int) -> unit) -> unit = f(41)

class Away(tag: string)
  run(@sendable f: () -> unit) -> unit = spawn(f).join()

class Add: (int) -> int
  apply(@sendable n: int) -> int = n + 100

data Twice(k: int)

impl (@sendable () -> int) -> int for Twice
  apply(@sendable f: () -> int) -> int = spawn(f).join() * k

main()
  val sp = spawn[int]
  println(sp(() -> 7, 65536).join())
  val typed: (@sendable () -> int, long) -> Thread[int] = spawn
  println(typed(() -> 8, 65536).join())
  val g = runAway
  g(() -> println("away"))
  val g2: (@sendable () -> unit) -> unit = runAway
  g2(() -> println("away, typed"))
  val k: (int) -> int = keep
  println(k(4))
  println([1, 2, 3].map(keep))
  println(wrap(lift, () -> "lifted"))
  val held = hold(spawn[string])
  println(held(() -> "held", 65536).join())
  println(hof(spawn))
  val b: (@sendable (int) -> unit) -> unit = pass
  b(n -> println(n))
  val ph: (@sendable () -> int) -> Thread[int] = spawn(_, 65536)
  println(ph(() -> 9).join())
  val a = Away("a")
  val r = a.run
  r(() -> println("run"))
  val r2: (@sendable () -> unit) -> unit = a.run
  r2(() -> println("run, typed"))
  val f = Future(3)
  val m: (@sendable (int) -> int) -> Future[int] = f.map
  println(m(x -> x * 2).await())
  val mk: (int) -> Mutex[int] = Mutex
  println(mk(3).with(x -> x + 1))
  val mi: (Vector[string]) -> Isolated[Vector[string]] = Isolated
  println(mi(["é", "ü"]).with(v -> v.length))
  val add: (int) -> int = Add()
  println(add(-2147483548))
  val tw: (@sendable () -> int) -> int = Twice(2)
  println(tw(() -> 21))
  run(@isolated f: () -> int) -> int = f()
  val lr = run
  println(lr(() -> 5))
  val total = Vector.fill(3, 1)
  println(lr(() -> total.length))
