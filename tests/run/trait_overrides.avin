// A trait may override a default of a trait it requires: in every class and data type conforming to
// it, its body replaces the required trait's at that method's position, so a call through either
// trait's type reaches it.
trait Shape
  area() -> int
  describe() -> string = s"shape of area ${area()}"
  name() -> string

trait Square: Shape
  side() -> int
  override area() -> int = side() * side()
  override describe() -> string = s"square of side ${side()}"

// A trait overriding an override, and giving an abstract method a body.
trait Single: Square
  override side() -> int = 1
  override describe() -> string = "unit square"
  override name() -> string = "unit"

class Tile(n: int): Square
  override side() -> int = n
  override name() -> string = "tile"

class Dot: Single

// Two traits overriding one default differently: the class overrides it itself.
trait Loud: Shape
  override describe() -> string = "LOUD"

trait Quiet: Shape
  override describe() -> string = "quiet"

class Both: Loud, Quiet
  override area() -> int = 0
  override name() -> string = "both"
  override describe() -> string = "loud and quiet"

// A superclass conforming to the required trait, and a subclass bringing in the override, which
// replaces the default the superclass's table holds. (A method of the superclass's own and a trait's
// default are two implementations, which the subclass would have to override.)
abstract class Plain: Shape
  override name() -> string = "plain"

class Squared: Plain(), Square
  override side() -> int = 3

// A data type conforming through an impl.
data Patch(n: int)

impl Square for Patch
  side() -> int = n
  name() -> string = "patch"

// A generic default overridden by a trait that requires it.
trait Wrap
  wrap[T](x: T) -> (string, T) = ("wrap", x)

trait Fancy: Wrap
  override wrap[U](x: U) -> (string, U) = ("fancy", x)

class Gift: Fancy

// A trait's override takes the defaults of the method it overrides, through a chain of overrides,
// and a class and a data type conforming to the last trait use them through every trait's type.
trait Say
  say[T](x: T, n: int = 1) -> string = s"say $n"

trait Shout: Say
  override say[U](x: U, n: int) -> string = s"shout $n"

trait Roar: Shout
  override say[V](x: V, n: int) -> string = s"roar $n"

class Speaker: Shout

class Lion: Roar

data Cub(age: int)

impl Roar for Cub

main_says()
  val s: Say = Speaker()
  val h: Shout = Speaker()
  val r: Say = Lion()
  println(s.say(true))
  println(h.say("x"))
  println(Speaker().say(2))
  println(r.say(1, 3))
  println(Lion().say(2.5))
  val c: Shout = Cub(1)
  println(c.say('c'))

shape(s: Shape) -> string = s"${s.name()}: ${s.describe()} (${s.area()})"

square(s: Square) -> string = s"${s.name()}: ${s.describe()} side ${s.side()}"

main()
  println(shape(Tile(4)))
  println(square(Tile(5)))
  println(shape(Dot()))
  println(square(Dot()))
  println(shape(Both()))
  println(shape(Squared()))
  println(square(Squared()))
  println(shape(Patch(6)))
  println(square(Patch(7)))
  val t = Tile(2)
  println(t.describe())
  val w: Wrap = Gift()
  w.wrap(3) match
    (s, n) -> println(s"$s $n")
  Gift().wrap("box") match
    (s, b) -> println(s"$s $b")
  main_says()
