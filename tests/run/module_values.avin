// expect: exit 0
// Module-level values initialize before `main`, each after the values its initializer uses,
// directly or through the functions it calls, whatever order the file declares them in; values
// that need nothing of one another keep their declaration order. Each initializer prints when it
// runs, so the output shows the order.

trace(name: string, value: int) -> int
    print(s"init $name")
    value

// Needs `base` through `doubled`, a function that reads it.
val total = trace("total", doubled() + offset)

doubled() -> int = base * 2

val first = trace("first", 1)

var offset = trace("offset", Settings.start + 1)

val base = trace("base", 20)

// An object's field initialized from a module value, and a module value initialized by calling an
// object's method.
object Settings
    val start = trace("Settings.start", first + 9)
    scaled(n: int) -> int = n * start

val scaledBase = trace("scaledBase", Settings.scaled(base))

// A module `var` holding a closure, replaced later.
var handler: int -> string = (n: int) -> s"first handler $n"

var greeting: string = "hello"

// Never read: still initialized, in its place.
val unread = trace("unread", 0)

count() -> int
    offset++
    offset

main()
    print("main")
    print(s"total $total base $base first $first offset $offset scaledBase $scaledBase")
    print(handler(1))
    val suffix = "!"
    handler = (n: int) -> s"second handler $n$suffix"
    print(handler(2))
    greeting = greeting + ", world"
    print(greeting)
    print(s"${count()} ${count()} ${offset}")
    offset += 100
    print(s"$offset")
    val before = offset--
    print(s"$before $offset ${--offset}")
