// expect: exit 0
// Bodies that wait for other futures do not stall the pool: far more futures than processors each
// wait for one they start, three levels deep, so every worker is waiting at once while the futures
// they wait for are still queued. The pool starts workers in place of the waiting ones, and every
// value arrives.
import avin.threads.Future

level(depth: int, n: int) -> int
  if depth == 0 then return n
  val inner = Future(level(depth - 1, n + 1))
  inner.await() + 1

main() -> int
  val outer = (0 ..< 64).map(i -> Future(level(3, i))).toVector
  var total = 0
  for f in outer do total += f.await()
  println(s"total $total")
  val waits = (0 ..< 32).map(i -> Future(Future(i).await(10000).getOrElse(-1))).toVector
  println(s"timed ${Future.all(waits).await().sum}")
  0
