// Messages from many senders, threads and futures and other actors, interleave in any order, but
// two messages one sender tells one actor are handled in the order they were told. Every message is
// handled exactly once, and the actor never runs on two threads at once: its state is a plain `var`,
// and a flag set for the length of each handling is never found set already. A message told after
// every sender has finished is handled after all of theirs.
import avin.actors.{ActorRef, Behaviour, spawn}
import avin.threads.{Atomic, Future, Promise}
import avin.threads as threads

data Msg
    From(sender: int, seq: int)
    Report(reply: Promise[string])

data Go(count: int, done: Promise[unit])

val senders = 12
val each = 500

checker() -> Behaviour[Msg] = Behaviour("Checker", me ->
    val last = Array.fill(senders, -1)
    var handled = 0
    var outOfOrder = 0
    var overlapped = 0
    val inside = Atomic[bool](false)
    m ->
        if !inside.compareAndSet(false, true) then overlapped += 1
        m match
            From(s, n) ->
                if n != last(s) + 1 then outOfOrder += 1
                last(s) = n
                handled += 1
            Report(reply) -> reply.complete(s"handled $handled, out of order $outOfOrder, overlapped $overlapped")
        inside.store(false))

// An actor that tells `count` messages as sender `id` when it is told to go, then says it is done.
relay(target: ActorRef[Msg], id: int) -> Behaviour[Go] = Behaviour("Relay", me -> go ->
    for i in 0..<go.count do target.tell(From(id, i))
    go.done.complete(()))

main()
    val c = spawn(checker())
    val started = (0..<4).map(id -> threads.spawn(() ->
        for i in 0..<each do c.tell(From(id, i)))).toVector
    val futures = (4..<8).map(id -> Future(for i in 0..<each do c.tell(From(id, i)))).toVector
    val dones = (8..<senders).map(id ->
        val done = Promise[unit]()
        spawn(relay(c, id)).tell(Go(each, done))
        done.future).toVector
    for t in started do t.join()
    Future.all(futures).await()
    Future.all(dones).await()
    val p = Promise[string]()
    c.tell(Report(p))
    println(p.future.await())
