// A companion's `apply` methods overload the constructor its name has in call position: `Name(…)`
// chooses among them by the ordinary rules, most specific by parameter types, with by-name
// parameters, trailing blocks, repeated parameters and generics as for any call.

class Cell[T](val value: T)

class Lazy[T](private val cell: Cell[T])
    get() -> T = cell.value

object Lazy
    var runs = 0
    // A by-name `apply`: the argument is evaluated by the body, once.
    apply[T](body: -> T) -> Lazy[T]
        runs++
        Lazy(Cell(body))

class Temperature(val celsius: real)

object Temperature
    apply(fahrenheit: int) -> Temperature = Temperature(real(fahrenheit - 32) * 5.0 / 9.0)
    apply(degrees: int, scale: string) -> Temperature = if scale == "F" then Temperature(degrees) else Temperature(real(degrees))

data Point(x: int, y: int)

object Point
    apply(both: int) -> Point = Point(both, both)
    apply(coords: int*) -> Point = Point(coords(0), coords(1) * 10)

// A companion of a data type with no variant of its name: `Shape(…)` is only its `apply`.
data Shape
    Circle(radius: int)
    Square(side: int)

object Shape
    apply(size: int, round: bool) -> Shape = if round then Circle(size) else Square(size)

// A plain object with `apply`, no companion of anything, is called through it.
object Twice
    apply(n: int) -> int = n * 2
    apply(s: string) -> string = s + s

// An abstract class is not made by its name, so its name calls its companion's `apply` alone.
abstract class Animal
    sound() -> string

class Dog: Animal
    override sound() -> string = "woof"

object Animal
    apply(kind: string) -> Animal = Dog()

describe(s: Shape) -> string = s match
    Circle(r) -> s"circle $r"
    Square(n) -> s"square $n"

main()
    // The constructor where its parameter types fit, the by-name `apply` where they do not.
    val direct = Lazy(Cell(1))
    print(direct.get())
    print(Lazy.runs)
    val computed = Lazy("made")
    print(computed.get())
    print(Lazy.runs)
    // The by-name `apply` takes an indented block after the name.
    val blocked = Lazy
        val a = 20
        a + 1
    print(blocked.get())
    // Type arguments written at the call are the chosen candidate's: the class's, then the method's.
    val typed = Lazy[int](Cell(5))
    print(typed.get())
    val long_one = Lazy[long](7)
    print(long_one.get())
    // A generic `apply` infers its type argument from the argument.
    val listed = Lazy([1, 2, 3])
    print(listed.get().length())
    // Overloads chosen by argument type and count.
    print(Temperature(1.5).celsius)
    print(Temperature(212).celsius)
    print(Temperature(50, "F").celsius)
    print(Temperature(50, "C").celsius)
    // A data type's variant of its own name overloads the same way, a repeated parameter last.
    print(Point(1, 2).y)
    print(Point(3).y)
    print(Point(4, 5, 6).y)
    print(describe(Shape(2, true)))
    print(describe(Shape(3, false)))
    print(Twice(21))
    print(Twice("ab"))
    print(Animal("dog").sound())
    // `Name.apply` is still a member call.
    print(Point.apply(9).x)
