// expect: trap
// A window is not negative: zero is fine and -1 traps.
import avin.crypto.verifyTotp
import avin.time.epochSeconds

main()
  println(verifyTotp(Vector.fill(20, byte(1)), "000000", epochSeconds(5), 0).isDefined)
  println(verifyTotp(Vector.fill(20, byte(1)), "000000", epochSeconds(5), -1))
