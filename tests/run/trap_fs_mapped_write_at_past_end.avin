// expect: trap
// `writeAt` traps when its bytes would run past the mapping's end, before writing any of them: the
// bytes that fit are not written either.
import avin.fs

bytesOf(text: string) -> Array[byte] = Array.tabulate(text.byteLength, i -> text.byteAt(i))

main()
  val dir = fs.createTempDir("avin-mapped-trap").toOption.get
  _ = fs.writeText(dir + "/a", "abcd")
  val m = fs.mapFileMutable(dir + "/a").toOption.get
  _ = fs.removeDirAll(dir)
  m.writeAt(2, bytesOf("CD"))
  println(string.fromUtf8(m.toArray()))
  m.writeAt(3, bytesOf("XY"))
