// expect: trap
// A trap in a thread the program started runs the hooks on that thread after the trap's report,
// hooks registered by every thread among them, while the main thread waits for it. An integer
// overflow is a trap like any other.
import avin.process
import avin.threads.spawn

bump(n: int) -> int = n + 1

main() -> int
  process.onExit(() -> eprintln("main's hook"))
  val t = spawn(() ->
    process.onExit(() -> eprintln("the thread's hook"))
    println(bump(2147483647)))
  t.join()
  println("not reached")
  0
