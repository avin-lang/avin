// expect: exit 0
// A `lazy val` in a class body is computed for each instance on that instance's first read, once.
// Its initializer may read every field, even one declared after it, and call methods, since it runs
// once the object is complete; it is read from the class's own methods, from outside, by a
// subclass, through a trait's `val` it supplies, and on an object made by the expression read. A
// lazy field of an object, and of a generic class, works the same way.
var made = 0

trait Named
    val label: string

open class Account(owner: string, balance: int): Named
    lazy val label: string = describe()
    lazy val doubled = twice + 0
    val twice: int = balance * 2

    describe() -> string
        made += 1
        s"$owner has $balance"

    summary() -> string = s"$label ($doubled)"

class Savings(owner: string, balance: int, rate: int): Account(owner, balance)
    lazy val interest: int = balance * rate / 100

    report() -> string = s"$label, interest $interest"

// Once every field is initialized, the body of a class that is not open may read it.
class Report(title: string)
    lazy val heading: string = s"== $title =="
    val width: int = title.byteLength()
    print(heading)

class Cell[T](value: T)
    lazy val pair: (T, T) = (value, value)

object Settings
    lazy val name: string = load()

    load() -> string
        made += 100
        "settings"

open() -> Account = Account("Zoe", 7)

nameOf(n: Named) -> string = n.label

main() -> int
    val a = Account("Ann", 10)
    val b = Account("Bob", 20)
    print(made)
    print(a.label)
    print(a.label)
    print(made)
    print(b.summary())
    print(made)
    print(a.doubled)
    val s = Savings("Sue", 200, 5)
    print(s.report())
    print(s.report())
    print(made)
    print(nameOf(Account("Cy", 1)))
    print(open().label)
    print(made)
    val c = Cell("x")
    val (p, q) = c.pair
    print(p + q)
    print(Settings.name)
    print(Settings.name)
    val r = Report("notes")
    print(r.heading)
    print(r.width)
    print(made)
    0
