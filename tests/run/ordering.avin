// expect: exit 0
// `<`, `<=`, `>` and `>=` are `Ord`'s. A type implements `compare` and has all four, in comparisons,
// chains and generic code; the built-in types order as their operators do, in generic code too. A
// type may implement one of the four as well, which then answers for its operator.

data Version(major: int, minor: int)

impl Ord for Version
  compare(other: Version) -> int = if major != other.major then major - other.major else minor - other.minor

class Money(val cents: int): Ord
  override compare(other: Money) -> int = cents - other.cents
  override less(other: Money) -> bool
    println("less")
    cents < other.cents

open class Rank(val n: int)

impl Ord for Rank
  compare(other: Rank) -> int = n - other.n

class Elevated(n: int): Rank(n)
  override compare(other: Rank) -> int = n + 10 - other.n

largest[T: Ord](a: T, b: T) -> T = if a < b then b else a

sort3[T: Ord](a: T, b: T, c: T) -> (T, T, T)
  var x = a
  var y = b
  var z = c
  if y < x
    x, y = y, x
  if z < y
    y, z = z, y
  if y < x
    x, y = y, x
  (x, y, z)

between[T: Ord](low: T, x: T, high: T) -> bool = low <= x <= high

main()
  val v = Version(1, 2)
  println(s"${v < Version(1, 3)} ${v <= Version(1, 2)} ${v > Version(0, 9)} ${v >= Version(2, 0)}")
  println(s"${Version(1, 0) < v < Version(1, 5)} ${between(Version(1, 0), v, Version(1, 1))}")
  println(
    s"${largest(Version(3, 1), Version(3, 0)).minor} ${largest(3, 9)} ${largest("pear", "apple")} ${largest('a', 'z')} ${largest(2.5, -1.0)}"
  )
  val (a, b, c) = sort3(3, 1, 2)
  println(s"$a $b $c")
  val (p, q, r) = sort3("b", "c", "a")
  println(s"$p $q $r")
  val (x, y, z) = sort3(Version(2, 0), Version(1, 1), Version(1, 0))
  println(s"${x.major}.${x.minor} ${y.major}.${y.minor} ${z.major}.${z.minor}")
  println(s"${Money(1) < Money(2)} ${Money(5) > Money(2)} ${largest(Money(7), Money(4)).cents}")
  val e: Rank = Elevated(1)
  println(s"${e > Rank(5)} ${Rank(5) > e} ${largest(Rank(2), e).n}")
  println(s"${v.compare(Version(1, 2))} ${3.compare(5)} ${"b".compare("a")} ${between(1, 5, 3)}")
