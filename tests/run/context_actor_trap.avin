// expect: exit 0
// A trap in an actor's turn inside a `withValue` runs no deferred statement, so the value it set is
// not taken off by one; the turn still leaves it behind: the `stopping` block of the restart, the
// start that runs again and the next message all see no value, nor the one the teller had.
import avin.actors.{Restart, spawn}
import avin.threads.{Channel, Context, Key, withValue}
import avin.time

val tag = Key[string]("tag")

seen() -> string = Context.current().value(tag).getOrElse("none")

actor Fragile(log: Channel[string]) receives int
  log.send(s"starts: ${seen()}")
  stopping
    log.send(s"stopping: ${seen()}")
  receive
    n -> withValue(tag, "inside", () -> log.send(s"${10 / n}: ${seen()}"))

main()
  val log = Channel[string]()
  val f = spawn(Fragile(log), onFailure = Restart(5, time.hours(1)))
  println(log.receive().get)
  withValue(tag, "teller", () ->
    for n in [5, 0, 2]
      f.tell(n))
  for _ in 0 ..< 4 do println(log.receive().get)
