// expect: exit 0
// Unix domain socket edges: a missing path, a path in use (live, left behind, and not a socket), a
// path too long for the platform, an empty path, a missing directory, replacing a left-over socket
// file, a megabyte each way, many round trips, and a client that finds its server gone.
import avin.fs
import avin.io.{IoError, NotFound, ConnectionRefused, AlreadyExists, Other}
import avin.net.{UnixListener, UnixStream}
import avin.threads.spawn

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message())

describe[T](r: Result[T, IoError]) -> string = r match
    Ok(_) -> "ok"
    Err(NotFound) -> "not found"
    Err(ConnectionRefused) -> "refused"
    Err(AlreadyExists) -> "already exists"
    Err(Other(m)) -> "other"
    Err(_) -> "error"

// Echoes each line it reads until the other end finishes sending, and says how many.
echoLines(s: UnixStream) -> int
    var n = 0
    while true
        ok(s.readLine()) match
            Some(line) ->
                ok(s.writeText(line + "\n"))
                n += 1
            None ->
                s.close()
                return n
    n

main()
    val dir = ok(fs.createTempDir("avu"))
    val sock = dir + "/s"

    // Nothing there: connecting is not found; a directory that is missing is an error too.
    println(describe(UnixStream.connect(sock)))
    println(describe(UnixStream.connect(dir + "/nodir/s")))
    println(describe(UnixListener.bind(dir + "/nodir/s")))

    // A path in use is refused, the listener that holds it unharmed.
    val l = ok(UnixListener.bind(sock))
    println(describe(UnixListener.bind(sock)))
    println(describe(UnixListener.bindReplacing(sock)))
    // The probe `bindReplacing` made is a connection the listener accepts and finds closed.
    val echo = spawn(() ->
        ok(ok(l.accept()).readLine())
        val s = ok(l.accept())
        ok(s.writeText(ok(s.readLine()).getOrElse("") + "!\n"))
        s.close()
        0)
    val c = ok(UnixStream.connect(sock))
    ok(c.writeText("still here\n"))
    println(ok(c.readLine()))
    c.close()
    echo.join()

    // A socket file left behind: connecting is refused, binding is refused, replacing works.
    l.close()
    println(fs.exists(sock))
    println(describe(UnixStream.connect(sock)))
    println(describe(UnixListener.bind(sock)))
    val again = ok(UnixListener.bindReplacing(sock))
    val srv = spawn(() ->
        val s = ok(again.accept())
        ok(s.writeText("replaced\n"))
        s.close()
        0)
    val c2 = ok(UnixStream.connect(sock))
    println(ok(c2.readLine()))
    c2.close()
    srv.join()
    again.close()

    // Replacing with nothing at the path just binds.
    ok(fs.remove(sock))
    val fresh = ok(UnixListener.bindReplacing(sock))
    fresh.close()
    ok(fs.remove(sock))

    // A regular file at the path is never removed.
    ok(fs.writeText(sock, "not a socket"))
    println(describe(UnixListener.bind(sock)))
    println(describe(UnixListener.bindReplacing(sock)))
    println(ok(fs.readText(sock)))
    ok(fs.remove(sock))

    // A path too long for the platform is an error, and an empty one.
    val long = dir + "/" + "x".repeat(200)
    println(describe(UnixListener.bind(long)))
    println(describe(UnixStream.connect(long)))
    println(describe(UnixListener.bindReplacing(long)))
    println(describe(UnixListener.bind("")))
    println(describe(UnixStream.connect("")))
    println(UnixListener.bind(long) match
        Err(Other(m)) -> m.nonEmpty()
        _ -> false)

    // A megabyte each way, the client sending while the server reads it all and sends it reversed.
    val big = Array.tabulate(1048576, i -> byte(i % 251))
    val bigL = ok(UnixListener.bind(sock))
    val rev = spawn(() ->
        val s = ok(bigL.accept())
        val all = ok(s.readAll())
        ok(s.write(Array.tabulate(all.length, i -> all(all.length - 1 - i))))
        s.close()
        all.length)
    val b = ok(UnixStream.connect(sock))
    ok(b.write(big))
    ok(b.shutdownOutput())
    val back = ok(b.readAll())
    println(back.length)
    var same = back.length == big.length
    for i in 0..<big.length do if back(i) != big(big.length - 1 - i) then same = false
    println(same)
    println(rev.join())
    b.close()

    // Many round trips over one connection.
    val pong = spawn(() -> echoLines(ok(bigL.accept())))
    val p = ok(UnixStream.connect(sock))
    var good = 0
    for i in 0..<500
        ok(p.writeText(s"ping $i\n"))
        if ok(p.readLine()) == Some(s"ping $i") then good += 1
    ok(p.shutdownOutput())
    println(good)
    p.close()
    println(pong.join())

    // A client whose server has closed the listener and gone: refused.
    bigL.close()
    println(describe(UnixStream.connect(sock)))
    ok(fs.remove(sock))
    ok(fs.removeDir(dir))
