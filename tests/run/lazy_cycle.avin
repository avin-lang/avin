// expect: trap
// A `lazy val` whose initializer needs its own value, here through another lazy value, would wait
// for itself for ever: the read made while it is being initialized traps there instead.
lazy val first: int = second + 1

lazy val second: int = later()

later() -> int
    print("computing second")
    first * 2

main() -> int
    print("before")
    print(first)
    print("after")
    0
