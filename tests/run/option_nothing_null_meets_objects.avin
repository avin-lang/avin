// expect: exit 0
// A program that keeps `Option[Nothing]` as a pointer (a vector of it is seen as a vector of options
// of a class) still writes it as an option kept as an object (of an `int`, a `real`, an option, a
// tuple of one) where it is passed, returned, stored and compared: there it becomes that option's
// `None` object.

class Dog(val name: string) derives Display

val nones = [None]

nothing() -> Option[Nothing] = None

dogs() -> Vector[Option[Dog]] = nones

count(n: int) -> Option[int] = if n > 0 then Some(n) else nothing()

ratio(o: Option[real]) -> real = o.getOrElse(0.5)

nested(n: int, d: Dog) -> Option[Option[Dog]] = n match
    0 -> nothing()
    1 -> Some(nothing())
    _ -> Some(Some(d))

parts() -> Vector[Option[(int, int)]] = [Some((1, 2)), nothing()]

held(n: int) -> int
    var o: Option[int] = nothing()
    if n > 0 then o = Some(n)
    o.getOrElse(-1)

main()
    val rex = Dog("rex")
    println(s"${dogs()} ${count(0)} ${count(3)} ${ratio(nothing())} ${ratio(Some(2.0))}")
    println(s"${nested(0, rex)} ${nested(1, rex)} ${nested(2, rex)} ${nested(1, rex).flatten()}")
    println(s"${parts()} ${held(0)} ${held(7)}")
    println(s"${count(0) == nothing()} ${count(0) == None} ${count(0).hash() == count(-1).hash()} ${nested(0, rex) == None}")
    val ints: Vector[Option[int]] = [nothing(), Some(2), nothing()]
    println(s"${ints} ${ints.map(o -> o.getOrElse(0)).sum()} ${ints.sorted()}")
    val anyNone: Any = count(0)
    val anyDog: Any = dogs()(0)
    println(s"$anyNone $anyDog ${anyNone == anyDog}")
