// expect: trap
// A mutex hands on only the handles its value's type shows. A function value hides what it
// captures, so a file reached only through a closure the mutex keeps stays its opener's, and another
// thread's call traps, as it would without the mutex.
import avin.fs
import avin.threads.{Mutex, spawn}

main()
  val dir = fs.createTempDir("file-owner").ok.get
  val f = fs.create(dir + "/a.txt").ok.get
  val m = Mutex(() -> f.writeText("x\n").isOk)
  println(m.with(w -> w()))
  println("to another thread")
  println(spawn(() -> m.with(w -> w())).join())
