// expect: exit 0
// Among overloads, one that has a lambda take a tuple apart is chosen only where no overload takes
// the lambda as written; where it is the only one that fits, it is chosen.

pick(f: (int, int) -> int) -> string = s"two parameters: ${f(3, 4)}"
pick(f: ((int, int)) -> int) -> string = s"one pair: ${f((3, 4))}"

only(f: ((int, int)) -> int) -> string = s"one pair: ${f((5, 6))}"
only(f: (int, int, int) -> int) -> string = s"three ints: ${f(5, 6, 7)}"

three(f: ((int, int, int)) -> int) -> int = f((1, 2, 3))
three(f: ((int, int)) -> int) -> int = f((10, 20))

main()
    println(pick((a, b) -> a * b))
    println(pick(p -> p.0 - p.1))
    println(only((a, b) -> a + b))
    println(only((a, b, c) -> a * b * c))
    println(three((a, b, c) -> a + b + c))
    println(three((a, b) -> a + b))
    // Map's own two-parameter `map` is chosen over the one taking each entry.
    val m = Map[string, int]().updated("a", 1)
    println(m.map((k, v) -> (v, k)))
    println(m.map(e -> (e.1, e.0)))
