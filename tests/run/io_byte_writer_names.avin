// expect: exit 0
// `io.ByteWriter`, the sink of bytes, and the prelude's `Writer`, the sink of rendered text, are two
// names, so a program sees both with nothing qualified: one class may be both, its two `write`s told
// apart by what they take, and a function bounded by each takes it. Values render into the `Writer`
// as they always do while bytes go through the `ByteWriter`, with the rest of `avin.io`'s traits
// imported beside it.
import avin.io.{ByteWriter, Close, IoError, Reader}

bytesOf(text: string) -> Array[byte] = Array.tabulate(text.byteLength, i -> text.byteAt(i))

// Both a text sink and a byte sink, keeping each apart.
class Log: Writer, ByteWriter
  val text = StringWriter()
  val bytes = Buffer[byte]()

  override write(text: string) = self.text.write(text)

  override write(bytes: Array[byte]) -> Result[unit, IoError]
    self.bytes.addAll(bytes)
    Ok(())

render[W: Writer](out: W, n: int) = n.display(out, FormatSpec())

send[B: ByteWriter](out: B, text: string) -> Result[unit, IoError] = out.write(bytesOf(text))

main()
  val log = Log()
  render(log, 42)
  log.write(" and text")
  _ = send(log, "bytes")
  _ = log.write(bytesOf("!"))
  val asText: Writer = log
  val asBytes: ByteWriter = log
  asText.write(", as a Writer")
  _ = asBytes.write(bytesOf(", as a ByteWriter"))
  println("text:", log.text.text)
  println("bytes:", string.fromUtf8Lossy(log.bytes.toArray()))
  // The prelude's writers are text sinks still.
  StandardOutput.write("standard output is a Writer\n")
