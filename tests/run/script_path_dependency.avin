// expect: exit 0
// A program of one file names its dependencies in a header at its top, as a manifest's
// `dependencies` block does, and imports the dependency's modules by their own names.

import greeting.{greet, greetAll}

main()
  println(greet("Avin"))
  println(greet(""))
  println(greet("Ünïcødé 世界"))
  for g in greetAll([1, 2])
    println(g)
  val f = (n: string) -> greet(n)
  println(f("closure"))
