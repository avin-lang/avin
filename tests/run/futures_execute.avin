// `ex.execute(task)` runs a task on the executor's workers with no future of it, on the shared pool
// and on an executor of one's own; work given after `shutdown` still runs, on a worker started for
// it, so an actor on an executor that has been shut down still handles what it is told, and `tell`
// never fails.
import avin.actors.{Behaviour, spawn}
import avin.threads.{Atomic, Executor, Promise}

// Runs `n` tasks on `ex` and answers how many ran, once all have.
count(ex: Executor, n: int) -> int
    val ran = Atomic[int](0)
    val done = Promise[unit]()
    for _ in 0..<n do ex.execute(() -> if ran.add(1) == n then done.complete(()))
    done.future.await()
    ran.load()

main()
    println(count(Executor.shared(), 100))
    val ex = Executor.fixed(2)
    println(count(ex, 1000))
    ex.shutdown()
    println(ex.isShutdown())
    println(count(ex, 10))

    val other = Executor.fixed(2)
    val reply = Promise[int]()
    val a = spawn(Behaviour[int]("Late", me -> n -> reply.complete(n)), other)
    other.shutdown()
    a.tell(7)
    println(reply.future.await())
