// expect: exit 0
// Byte offsets that fall inside a character. `charAt` reads every character whole at the offset
// where it begins, at each edge of the one-, two-, three- and four-byte encodings. The searches
// answer only offsets where a character begins: an empty needle searched from inside a character
// is found at the next one, searched back from inside one at the one it belongs to, and does not
// occur inside one; `indexWhere` from inside a character starts at the next. A regex's matches
// begin and end where characters do, and a zone name with characters beyond ASCII is refused
// rather than read inside them.
import avin.regex.Regex
import avin.time.zone

// The code of each character of `s`, read by `charAt` at each offset where one begins.
codes(s: string) -> string
  var out = ""
  var at = 0
  while at < s.byteLength
    val c = s.charAt(at)
    out = out + s"$at:${int(c)} "
    at += c.toString().byteLength
  out

main()
  println(codes("\u{7F}\u{80}\u{7FF}\u{800}\u{FFFF}\u{10000}\u{10FFFF}"))
  println(codes("café😀\u{ED}\u{A0}"))
  println(codes(""))
  val s = "café"
  // An empty needle from inside `é` (offset 4) is found where the next character would begin.
  println(s"${s.indexOf("", 3)} ${s.indexOf("", 4)} ${s.indexOf("", 5)} ${s.indexOf("", 6)}")
  val e = "😀😀"
  println(s"${e.indexOf("", 1)} ${e.indexOf("", 2)} ${e.indexOf("", 3)} ${e.indexOf("", 5)} ${e.indexOf("", 7)}")
  // A non-empty needle or a character is only ever found where a character begins.
  println(s"${s.indexOf("é", 4)} ${s.indexOf('é', 2)} ${e.indexOf("😀", 1)} ${e.indexOf('😀', 3)}")
  // Searched back from inside `é`, the empty needle is found where `é` begins.
  println(
    s"${s.lastIndexOf("", 4)} ${s.lastIndexOf("", 5)} ${e.lastIndexOf("", 7)} ${e.lastIndexOf("", 6)} ${e.lastIndexOf("", 1)}"
  )
  println(s"${s.lastIndexOf("é", 4)} ${s.lastIndexOf('é', 4)} ${e.lastIndexOf("😀", 6)}")
  // The empty string does not occur inside a character, and does at every boundary.
  println(s"${s.startsWith("", 3)} ${s.startsWith("", 4)} ${s.startsWith("", 5)} ${s.startsWith("", 6)}")
  println(s"${e.startsWith("", 1)} ${e.startsWith("", 2)} ${e.startsWith("", 3)} ${e.startsWith("", 4)}")
  println(s"${s.startsWith("é", 3)} ${s.startsWith("\u{A9}", 4)} ${s.endsWith("")} ${"".startsWith("", 0)}")
  // `indexWhere` from inside a character starts at the next; `lastIndexWhere` back from inside one
  // finds the character it belongs to.
  val t = "aé中😀z"
  println(
    s"${t.indexWhere(_ -> true, 2)} ${t.indexWhere(_ -> true, 4)} ${t.indexWhere(_ -> true, 5)} ${t.indexWhere(_ -> true, 7)}"
  )
  println(
    s"${t.indexWhere(_ -> true, 9)} ${t.indexWhere(_ -> true, 10)} ${t.indexWhere(c -> c == 'é', 2)} ${"é".indexWhere(_ -> true, 1)}"
  )
  println(
    s"${t.lastIndexWhere(_ -> true, 2)} ${t.lastIndexWhere(_ -> true, 5)} ${t.lastIndexWhere(_ -> true, 9)} ${t.lastIndexWhere(c -> c == '😀', 8)}"
  )
  // Empty matches of a regex fall between characters, never inside one.
  for m in Regex("").findAllMatchIn("é😀a") do print(s"${m.start(0)} ")
  println()
  for m in Regex("x*").findAllMatchIn("中") do print(s"${m.start(0)}-${m.end(0)} ")
  println()
  println(Regex("x*").replaceAllIn("é😀", "-"))
  // A fixed-offset zone name is read by its bytes, so characters beyond ASCII where digits or the
  // colon stand make it no offset, and then no zone name either.
  for name in ["+é:00", "+0é00", "+00:é", "+0é0", "+05:30"]
    println(zone(name) match
      Ok(_) -> s"$name ok"
      Err(err) -> err.message)
