// expect: exit 0
// `isolate` runs its body, written in place or as a trailing block, and wraps what it returns. The
// body may read sendable values from around it, a `var` among them, and module-level values that are
// immutable and sendable. `with` works on the objects in place and gives back a sendable value;
// `take` gives them out once, after which they are ordinary objects. An `Isolated` of any type may be
// made: a buffer, an empty one, a string, an integer, a map of buffers, a generic instance, `unit`
// and an empty option, and one isolating another.
import avin.actors.{Isolated, isolate}
import avin.collections.mutable.{Map as MutableMap}
import avin.threads.Atomic

val base = 100
val names = Vector("α", "β", "γ")
val made = Atomic[int](0)

object Limits
    val most = 3

data Cell(n: int)

class Point(val x: int, val y: int)

// A function that isolates what its own isolating argument makes.
wrapped[T](@isolating make: -> T) -> Isolated[T] = isolate(make)

filled[T: Sendable](x: T, n: int) -> Isolated[Buffer[T]] = isolate
    val b = Buffer[T]()
    for _ in 0..<n do b.append(x)
    b

main()
    val size = 4
    var offset = 10
    val chunk = isolate
        val b = Buffer[int]()
        for i in 0..<size do b.append(base + offset + i)
        made.add(1)
        b
    offset = 0
    println(chunk.with(b -> b.size))
    chunk.with(b ->
        b.append(Limits.most)
        ())
    println(chunk.with(b -> b.toVector))
    val b = chunk.take()
    b.append(-1)
    println(b)
    val empty = isolate(Buffer[string]())
    println(empty.take().isEmpty)
    val text = isolate("ünïcödé")
    println(text.with(s -> s.charCount()))
    println(text.take())
    val number = isolate(i64(9223372036854775807))
    println(number.take())
    val point = isolate(Point(1, 2))
    println(point.with(p -> p.x + p.y))
    val table = isolate
        val m = MutableMap[string, Buffer[Cell]]()
        for name in names
            val cells = Buffer[Cell]()
            cells.append(Cell(name.byteLength()))
            m(name) = cells
        m
    println(table.with(m -> m.size))
    println(table.take()("β")(0))
    println(wrapped(Buffer[real]()).with(r -> r.size))
    println(filled("x", 3).take())
    println(filled(Cell(7), 2).with(c -> c(1)))
    val nested = isolate(isolate(Buffer[int]()))
    println(nested.take().take().size)
    println(isolate(()).take())
    println(isolate(Option[Buffer[int]].None).take().isEmpty())
    println(made.load())
