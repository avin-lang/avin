// expect: exit 0
// An integer or real literal given to a union is its own default type where that is a member: `int`,
// or `long` for a literal too large for an `int`, and `real`. Otherwise it is the one numeric member
// it fits. `None`, an empty collection literal and `Ok(x)` take their type from the one member that
// is an instance of their type.

intOrLong(x: int | long) -> string = x match
    n: int -> s"int $n"
    l: long -> s"long $l"

longOrText(x: long | string) -> string = x match
    l: long -> s"long $l"
    s: string -> s"string $s"

byteOrText(x: byte | string) -> string = x match
    b: byte -> s"byte $b"
    s: string -> s"string $s"

realOrText(x: real | string) -> string = x match
    r: real -> s"real $r"
    s: string -> s"string $s"

intOrReal(x: int | real) -> string = x match
    n: int -> s"int $n"
    r: real -> s"real $r"

optionOrText(x: Option[int] | string) -> string = x match
    o: Option[int] -> s"option $o"
    s: string -> s"string $s"

vectorOrInt(x: Vector[string] | int) -> string = x match
    v: Vector[string] -> s"vector of ${v.size}"
    n: int -> s"int $n"

setOrInt(x: Set[int] | int) -> string = x match
    s: Set[int] -> s"set of ${s.size}"
    n: int -> s"int $n"

resultOrBool(x: Result[int, string] | bool) -> string = x match
    r: Result[int, string] -> s"result $r"
    b: bool -> s"bool $b"

main()
    println(intOrLong(3))
    println(intOrLong(-3))
    println(intOrLong(2147483647))
    println(intOrLong(-2147483648))
    println(intOrLong(2147483648))
    println(intOrLong(-2147483649))
    println(intOrLong(5_000_000_000))
    println(intOrLong(int.MaxValue))
    println(intOrLong(long.MinValue))
    println(intOrLong(long.MaxValue))
    println(longOrText(3))
    println(longOrText(-9223372036854775808))
    println(byteOrText(255))
    println(byteOrText(0))
    println(realOrText(1.5))
    println(realOrText(-0.0))
    println(realOrText(2))
    println(intOrReal(2))
    println(intOrReal(2.5))
    println(optionOrText(None))
    println(optionOrText(Some(4)))
    println(vectorOrInt([]))
    println(vectorOrInt(["a", "b"]))
    println(setOrInt({}))
    println(resultOrBool(Ok(1)))
    println(resultOrBool(Err("bad")))
    println(resultOrBool(true))
