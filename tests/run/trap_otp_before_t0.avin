// expect: trap
// A time before the start time has no step to make a code from.
import avin.crypto.{totp, OtpSha1}
import avin.time.epochSeconds

main()
  println(totp(Vector.fill(20, byte(1)), epochSeconds(100), 6, OtpSha1, 30, 100).charCount)
  println(totp(Vector.fill(20, byte(1)), epochSeconds(99), 6, OtpSha1, 30, 100))
