// A built-in type conforms to a trait through an impl, written in the trait's module. It meets the
// trait as a bound, and each instance calls the impl's method directly: a built-in value is no
// object and has no method table. A built-in type takes no default bodies, so its impl implements
// every method of the trait.

trait Sized
    size() -> int
    describe() -> string = s"size ${size()}"

// A trait requiring another: an impl of each is needed.
trait Weighed: Sized
    weight(scale: int) -> int

// A trait mentioning `Self`, with an abstract method yielding unit.
trait Merge
    merge(other: Self) -> Self
    log(text: string)

impl Sized for string
    size() -> int = if self == "" then 0 else 1
    describe() -> string = s"a string of ${size()}"

impl Sized for int
    size() -> int = 4
    describe() -> string = "an int"

impl Weighed for int
    weight(scale: int) -> int = self * scale

impl Merge for int
    merge(other: int) -> int = self + other
    log(text: string) = println(s"int: $text")

impl Merge for string
    merge(other: string) -> string = self + other
    log(text: string) = println(s"string: $text")

// A class meets the same traits, through its method table.
class Crate(val items: int): Weighed
    override size() -> int = items
    override weight(scale: int) -> int = items * scale * 10

total[T: Sized](a: T, b: T) -> int = a.size() + b.size()

heavier[T: Weighed](a: T, b: T, scale: int) -> T = if a.weight(scale) >= b.weight(scale) then a else b

merged[T: Merge](a: T, b: T) -> T
    a.log("merging")
    a.merge(b)

main()
    println(total("abc", "hello"))
    println(total(1, 2))
    println(total(Crate(2), Crate(3)))
    println("abc".describe())
    println(7.describe())
    println(Crate(4).describe())
    println(heavier(3, 5, 2))
    println(heavier(Crate(1), Crate(2), 1).items)
    println(merged(20, 22))
    println(merged("ab", "cd"))
