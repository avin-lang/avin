// expect: exit 0
// env: AVIN_GC_STRESS=0
// Threads that join a thread which is ending at that moment: each of twenty thousand threads joins
// the one started before it, so a joiner is woken while the thread it waited for is still switching
// away from its worker for the last time, and may start on another worker and end itself before that
// worker has given the first one's stack back. Then a fan of threads all joining one that ends at
// once.
import avin.threads.{Thread, spawn}

main() -> int
  var last: Thread[int] = spawn(() -> 0)
  for i in 1 .. 20000
    val before = last
    last = spawn(() -> before.join() + 1)
  println(last.join())
  for round in 0 ..< 200
    val first = spawn(() -> round)
    val joiners = (0 ..< 50).map(_ -> spawn(() -> first.join())).toVector
    for j in joiners
      if j.join() != round then return 1
  println("joined")
  0
