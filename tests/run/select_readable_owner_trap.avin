// expect: trap
// A select's `readable()` arm uses its stream as a read would, so a stream handed to another thread
// traps in the code that handed it over when a select there names it, as any other use of it does.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.threads.{Channel, spawn}

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

main()
  val l = ok(TcpListener.bind("127.0.0.1", 0))
  val c = ok(TcpStream.connect("127.0.0.1", l.port()))
  val s = ok(l.accept())
  val go = Channel[int]()
  val t = spawn(() ->
    go.receive()
    ok(c.close()))
  println("handed over")
  select
    c.readable() -> println("readable")
    go.receive() -> println("received")
  go.send(1)
  t.join()
