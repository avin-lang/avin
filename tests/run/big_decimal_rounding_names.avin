// expect: exit 0
// A program's own variants named like `Rounding`'s hide them where nothing expects a `Rounding`, and
// where one is expected the bare name is still `Rounding`'s; `Rounding.Up` always is. A `Rounding`
// is a value that can be held, passed and matched.
data Direction
  Up
  Down

describe(d: Direction) -> string = d match
  Up -> "up"
  Down -> "down"

named(r: Rounding) -> string = r match
  HalfEven -> "half even"
  HalfUp -> "half up"
  HalfDown -> "half down"
  Up -> "up"
  Down -> "down"
  Ceiling -> "ceiling"
  Floor -> "floor"

main()
  val x: BigDecimal = 2.5
  println(describe(Up))
  println(describe(Down))
  println(x.round(0, rounding = Up))
  println(x.round(0, rounding = Down))
  println(x.round(0, rounding = Rounding.Up))
  val mode: Rounding = Ceiling
  println(x.round(0, rounding = mode))
  val modes: Vector[Rounding] = [Up, Down, Floor]
  println(modes.map(named).mkString(", "))
  println(modes.map(m -> x.round(0, rounding = m)).mkString(" "))
  val d = Up
  println(describe(d))
  println(named(HalfEven) == named(Rounding.HalfEven))
