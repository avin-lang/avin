// expect: exit 0
// Every lazy method evaluates nothing when it is called, each cell is evaluated at most once however
// many lists made from it and iterators over it read it, and the tail of `cons` and the right
// operand of `++` are evaluated only when the cell after them is read. Counters in the functions
// count the evaluations; `Display` shows which cells are evaluated, without evaluating any.

var calls = 0

counted(x: int) -> int
    calls += 1
    x

report(label: string)
    println(s"$label: $calls")
    calls = 0

var tails = 0

numbersFrom(n: int) -> LazyList[int] = LazyList.cons(n, numbersFrom(n + 1))

countingFrom(n: int) -> LazyList[int]
    tails += 1
    LazyList.cons(n, countingFrom(n + 1))

main() -> int
    // `map`: nothing at the call, one call per cell read, none when a cell is read again.
    val squares = LazyList.from(0).map(x -> counted(x * x))
    report("map made")
    println(squares)
    println(squares(3))
    report("map read to 3")
    println(squares)
    println(squares(3))
    println(squares(1))
    report("map read again")
    println(squares.take(6).toVector())
    report("map read to 5")

    // Two derived lists and two iterators share the source's cells.
    val source = LazyList.from(0).map(counted)
    val evens = source.filter(x -> x % 2 == 0)
    val doubled = source.map(x -> x * 2)
    report("derived made")
    println(evens.take(3).toVector())
    report("evens read")
    println(doubled.take(5).toVector())
    report("doubled read")
    val a = source.iterator()
    val b = source.iterator()
    println(s"${a.next()} ${a.next()} ${b.next()} ${b.next()} ${b.next()}")
    report("iterators read")

    // `filter` reads the source up to the next element it accepts and no further.
    var tested = 0
    val big = LazyList.from(1).filter(x ->
        tested += 1
        x % 10 == 0)
    println(tested)
    println(big.head())
    println(tested)
    println(big(1))
    println(tested)
    println(big(1))
    println(tested)
    println(big.filterNot(x -> x % 20 == 0).take(2).toVector())

    // `take(n)` never reads the cell after the `n`th, and `take(0)` reads nothing.
    val taken = LazyList.from(0).map(counted).take(3)
    report("take made")
    println(taken.length())
    report("take counted")
    println(LazyList.from(0).map(counted).take(0).length())
    println(LazyList.from(0).map(counted).take(-5).isEmpty())
    report("take nothing")
    println(LazyList.from(0).map(counted).take(1).toVector())
    report("take one")

    // `drop(n)` skips when its first cell is read, and the skipped cells stay evaluated in the source.
    val src = LazyList.from(0).map(counted)
    val dropped = src.drop(4)
    report("drop made")
    println(dropped.head())
    report("drop read")
    println(src)
    println(src.drop(0) === src)
    println(src.drop(-1) === src)
    println(src.take(2).drop(5).isEmpty())
    report("drop past the end")

    // `takeWhile` reads the element that ends it and nothing after; `dropWhile` reads to the first
    // element it keeps.
    val upTo = LazyList.from(0).map(counted).takeWhile(x -> x < 3)
    report("takeWhile made")
    println(upTo.toVector())
    report("takeWhile read")
    val after = LazyList.from(0).map(counted).dropWhile(x -> x < 3)
    report("dropWhile made")
    println(after.head())
    report("dropWhile read")
    println(LazyList.from(0).takeWhile(x -> x < 0).isEmpty())
    println(LazyList.from(0).take(3).dropWhile(x -> x < 10).isEmpty())

    // `zip` reads a cell of each side per pair, the left's first: where the right ends, the left's
    // cell at that place has been read, and none after it.
    val left = LazyList.from(0).map(counted)
    val right = LazyList.from(10).map(counted).take(2)
    val zipped = left.zip(right)
    report("zip made")
    println(zipped.toVector())
    report("zip read")
    println(LazyList.empty[int]().zip(LazyList.from(0).map(counted)).isEmpty())
    report("zip of empty")
    println(LazyList.from(5).take(3).zipWithIndex().toVector())

    // `++`: the right operand is not evaluated until the cell after the left's last is read.
    var made = 0
    val rightSide = () ->
        made += 1
        LazyList.from(100).take(2)
    val both = LazyList.from(1).take(2) ++ rightSide()
    println(made)
    println(both(1))
    println(made)
    println(both(2))
    println(made)
    println(both.toVector())
    println(made)
    println((LazyList.empty[int]() ++ LazyList.empty[int]()).isEmpty())
    println((LazyList.empty[int]() ++ LazyList.from(4).take(1)).toVector())
    println((LazyList.from(4).take(1) ++ LazyList.empty[int]()).toVector())
    val endless = LazyList.from(0) ++ rightSide()
    println(endless(1000))
    println(made)

    // `flatMap` reads one source cell per element it needs, skipping those that give nothing.
    val expanded = LazyList.from(0).map(counted).flatMap(n -> Vector.fill(n % 3, n))
    report("flatMap made")
    println(expanded.take(3).toVector())
    report("flatMap read three")
    println(LazyList.from(0).take(4).flatMap(n -> Vector.empty[int]()).isEmpty())
    println(LazyList.from(1).take(3).flatMap(n -> LazyList.from(n).take(n)).toVector())

    // `cons`: the head at the call, the tail when the second cell is read, once.
    val built = countingFrom(0)
    println(tails)
    println(built.head())
    println(built.headOption())
    println(built.isEmpty())
    println(built.nonEmpty())
    println(built.knownSize())
    println(tails)
    println(built(3))
    println(tails)
    println(built(3))
    println(built.tail() === built.tail())
    println(tails)

    // The tail is a delayed expression capturing the locals it names: each list keeps its own.
    var lists: Vector[LazyList[string]] = []
    for i in 0 ..< 3
        val label = s"item$i"
        lists = lists :+ LazyList.cons(label, LazyList.cons(label + "!", LazyList.empty[string]()))
    for l in lists
        println(l.toVector())
    var shared = 1
    val late = LazyList.cons(0, LazyList.cons(shared, LazyList.empty[int]()))
    shared = 2
    println(late.toVector())
    shared = 3
    println(late.toVector())

    // The companion's makers evaluate nothing when called.
    var stepped = 0
    val powers = LazyList.iterate(1, x ->
        stepped += 1
        x * 2)
    println(stepped)
    println(powers(4))
    println(stepped)
    println(powers(4))
    println(stepped)
    var unfolded = 0
    val countdown = LazyList.unfold(3, n ->
        unfolded += 1
        if n == 0 then None else Some((n, n - 1)))
    println(unfolded)
    println(countdown.head())
    println(unfolded)
    println(countdown.toVector())
    println(unfolded)
    println(countdown.length())
    println(unfolded)
    var drawn = 0
    val draws = LazyList.continually
        drawn += 1
        drawn * 100
    println(drawn)
    println(draws(2))
    println(drawn)
    println(draws(0))
    println(drawn)
    val filled = LazyList.fill(3, counted(9))
    report("fill made")
    println(filled.toVector())
    report("fill read")
    println(LazyList.fill(0, counted(9)).isEmpty())
    report("fill none")
    val table = LazyList.tabulate(4, i -> counted(i * i))
    report("tabulate made")
    println(table(2))
    report("tabulate read to 2")
    println(table.toVector())
    report("tabulate read")
    println(LazyList.tabulate(-1, i -> i).isEmpty())

    // Display and Debug show the evaluated prefix and evaluate nothing.
    val shown = LazyList.from(0).map(counted)
    println(shown)
    println(f"$shown%?")
    shown(1)
    println(shown)
    report("shown")
    val words = LazyList.cons("a", LazyList.cons("b", LazyList.empty[string]()))
    println(f"$words%?")
    words.length()
    println(f"$words%?")
    println(words)
    println(f"[$words%10s] [$words%12?]")
    println(f"[$words%-10s]")
    println(numbersFrom(0))
    0
