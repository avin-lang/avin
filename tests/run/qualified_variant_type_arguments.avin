// expect: exit 0
// A generic type's variant reached through its type takes its type arguments on the type,
// `Heap[int].Leaf`, or on the variant, `Heap.Leaf[int]`; both name the same value, with fields or
// without, at one type parameter or several. Patterns name the variant without type arguments,
// whichever way the value was made. Two generic types sharing a variant's name are told apart by
// the type written before it.

data Heap[T]
  Leaf
  Node(value: T, left: Heap[T], right: Heap[T])

data Pair[A, B]
  Neither
  Both(a: A, b: B)

data Tree[T]
  Leaf
  Branch(left: Tree[T], right: Tree[T])

data Cell[T](value: T)

size[T](h: Heap[T]) -> int = h match
  Heap.Leaf -> 0
  Heap.Node(_, l, r) -> 1 + size(l) + size(r)

depth[T](t: Tree[T]) -> int = t match
  Tree.Leaf -> 1
  Tree.Branch(l, r) -> 1 + max(depth(l), depth(r))

insert(h: Heap[int], x: int) -> Heap[int] = h match
  Heap.Leaf -> Heap.Node[int](x, Heap.Leaf[int], Heap[int].Leaf)
  Heap.Node(v, l, r) -> if x < v then Heap.Node[int](x, insert(r, v), l) else Heap[int].Node(v, insert(r, x), l)

main()
  // Fieldless, one type parameter: both spellings, and the bare one, are one value.
  val a = Heap.Leaf[int]
  val b = Heap[int].Leaf
  val c: Heap[int] = Leaf[int]
  println(a)
  println(a == b && b == c)
  println(size(a))
  // The type arguments decide the instance where nothing else does.
  val strings = Heap.Leaf[string]
  println(size(Heap.Node("x", strings, Heap.Leaf[string])))
  // With fields, one type parameter: an `int` literal widened by the written `long`.
  val wide = Heap.Node[long](1, Heap.Leaf[long], Heap.Leaf)
  println(wide)
  println(wide == Heap[long].Node(1, Heap.Leaf, Heap.Leaf))
  // Two type parameters.
  println(Pair.Neither[int, string])
  println(Pair.Neither[int, string] == Pair[int, string].Neither)
  println(Pair.Both[long, string](2, "two"))
  println(Pair.Both[int, Heap[int]](3, Heap.Leaf[int]))
  // A leading prefix of them, with the rest inferred.
  val p: Pair[int, string] = Pair.Neither[int]
  println(p == Pair.Neither[int, string])
  println(Pair.Both[long](5, "five"))
  // A shared variant name: the written type decides which `Leaf`.
  val t = Tree.Leaf[int]
  println(depth(Tree.Branch[int](t, Tree.Branch(Tree[int].Leaf, Tree.Leaf[int]))))
  println(size(Heap.Leaf[real]) + depth(Tree.Leaf[real]))
  // A one-variant generic type: its variant has the type's name.
  println(Cell.Cell[long](4))
  println(Cell.Cell[string]("s").value)
  // Nested inside other constructions, and in a lambda.
  val nested = Option.Some(Heap.Leaf[int])
  println(nested)
  val f = (n: int) -> Heap.Node[int](n, Heap.Leaf[int], Heap.Leaf[int])
  println(size(f(5)))
  var h = Heap.Leaf[int]
  for x in [5, 3, 8, 1, 9, 2]
    h = insert(h, x)
  println(size(h))
  h match
    Heap.Node(v, _, _) -> println(v)
    Heap.Leaf -> println("empty")
