// expect: exit 0
// Views that take an option as another type with no conversion: an option inside a list seen as a
// `List[Any]`, an option of an option seen as an `Option[Any]`, an option seen as a trait, and a type
// pattern on an `Any` that finds options inside a list. A program with any of them keeps every option
// an object, so each reads as the option it is.

class Dog(val name: string) derives Display

show(items: List[Any]) -> string = items.map(x -> x match
    o: Option[Dog] -> o.map(d -> d.name).getOrElse("nobody")
    _ -> "other").mkString(",")

main()
    val dogs: List[Option[Dog]] = Some(Dog("rex")) :: None :: Nil
    print(show(dogs))

    val nested: Option[Option[Dog]] = Some(None)
    val wide: Option[Any] = nested
    val inner = wide match
        Some(o: Option[Dog]) -> s"inner ${o.isDefined()}"
        Some(_) -> "something else"
        None -> "none"
    print(inner)

    val shown: Display = Some(Dog("fido"))
    print(shown.toString())

    val boxed: Any = dogs
    val count = boxed match
        l: List[Any] -> l.length()
        _ -> -1
    print(count)
