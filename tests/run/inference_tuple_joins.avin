// expect: exit 0
// Two tuples join part by part, since a tuple's parts are read out: `(Dog, long)` and `(Cat, long)`
// agree on `(Animal, long)`, as a type argument of a generic call given both, as the branches of an
// `if` or the arms of a `match`, and as the elements of a collection literal. The join reaches
// tuples nested in tuples and in the covariant arguments of a generic type.

open class Animal(val name: string)
open class Dog(n: string) : Animal(n)
class Cat(n: string) : Animal(n)
class Puppy(n: string) : Dog(n)

trait Named
    label() -> string

trait Pet : Named
    owner() -> string

class Parrot(n: string) : Pet
    override label() -> string = s"parrot $n"
    override owner() -> string = "ann"

class Goldfish(n: string) : Pet
    override label() -> string = s"goldfish $n"
    override owner() -> string = "bob"

same[T](a: T, b: T) -> T = b

firstOf[T](a: Option[T], b: Option[T]) -> Option[T] = a.orElse(b)

class Holder[+T](val left: T, val right: T)

// Each overload names the type its argument was given, so the joined type is visible.
kind(p: (Animal, long)) -> string = "(Animal, long)"
kind(p: (Dog, long)) -> string = "(Dog, long)"
kind(p: (Animal, string)) -> string = "(Animal, string)"

main(args: Vector[string])
    val d = Dog("rex")
    val c = Cat("tom")
    val x: long = 5_000_000_000
    val pick = args.size == 0

    // A generic call: the second argument widens the first, in either order.
    val t = same((d, x), (c, x))
    println(s"${t.0.name} ${t.1} ${kind(t)}")
    val u = same((c, x), (d, x))
    println(s"${u.0.name} ${kind(u)}")

    // A subclass joins to its superclass, and a tuple of one type stays as it is.
    println(kind(same((Puppy("bit"), x), (d, x))))
    println(kind(same((d, x), (d, x))))

    // A literal part takes the number the other tuple decides.
    println(kind(same((d, x), (c, 7))))
    println(kind(same((d, 7), (c, x))))

    // Several reference parts each join; strings stay strings.
    val three = same((d, "a", c), (c, "b", d))
    println(s"${three.0.name} ${three.1} ${three.2.name}")

    // Tuples nested in tuples.
    val nested = same(((d, x), "n"), ((c, x), "m"))
    println(s"${nested.0.0.name} ${kind(nested.0)}")

    // Two classes with no common superclass join to the one trait they share.
    val pets = same((Parrot("polly"), 1), (Goldfish("nemo"), 2))
    println(s"${pets.0.owner()} ${pets.0.label()}")

    // Inside covariant arguments: an option, a vector, a list, a generic class.
    val o = same(Some((d, x)), Some((c, x)))
    println(o.map(p -> p.0.name).getOrElse("none"))
    println(firstOf(None, Some((c, x))).map(p -> kind(p)).getOrElse("none"))
    println(firstOf(Some((d, x)), Some((c, x))).map(p -> kind(p)).getOrElse("none"))
    val v = same([(d, x)], [(c, x), (Puppy("pup"), x)])
    for p in v do println(s"${p.0.name} ${kind(p)}")
    val l: List[(Dog, long)] = [(d, x)]
    val joined = (c, x) :: l
    for p in joined do println(p.0.name)
    val h = Holder((d, "left"), (c, "right"))
    println(s"${h.left.0.name} ${h.right.0.name} ${kind(h.right)}")

    // The branches of an `if` and the arms of a `match`.
    val either = if pick then (d, x) else (c, x)
    println(s"${either.0.name} ${kind(either)}")
    val arm = args.size match
        0 -> (c, "zero")
        1 -> (d, "one")
        _ -> (Puppy("many"), "many")
    println(s"${arm.0.name} ${kind(arm)}")

    // The elements of a collection literal and the values of a map literal.
    val literal = [(d, x), (c, x)]
    for p in literal do println(kind(p))
    val table = {"a": (d, x), "b": (c, x)}
    println(table("b").0.name)

    // A closure capturing the joined tuple.
    val show = () -> s"${t.0.name}/${t.1}"
    println(show())

    // An expected type still decides the type argument before the arguments.
    val wide: (Animal, long) = same((d, x), (d, x))
    println(kind(wide))
