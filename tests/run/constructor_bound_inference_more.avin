// expect: exit 0
// Inferring a bounded constructor, the neighbouring shapes: the arguments a constructor writes out
// join by their parameter's variance (a `Result[int, Dog]` beside a `Result[int, Cat]` makes `F`
// `Result[_, Animal]`), while the hole is decided as any type argument is; a subclass with no
// conformance of its own is matched as its nearest superclass that has one, a private one and one
// that fixes the superclass's argument alike; nested applications `F[G[A]]` decide both; literals
// sit beside a constructor; and two bounds that agree on the holes decide it together.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

trait Counted[A]
  again() -> Self[A]
  count() -> int

impl Mappable for Option

impl Mappable for List

impl[T, E] Mappable[T] for Result[T, E]

impl Counted for Option
  again() -> Option[T] = self
  count() -> int = if self is Some(_) then 1 else 0

open class Animal(val name: string)

class Dog(n: string): Animal(n)

class Cat(n: string): Animal(n)

open class Shelf[A](val item: A): Mappable[A]
  map[B](f: (A) -> B) -> Shelf[B] = Shelf(f(item))

private class TallShelf[A](x: A, val height: int): Shelf[A](x)

open class Plank(val n: int): Shelf[int](n)

class Beam(n: int): Plank(n)

incr[F[_]: Mappable](x: F[int]) -> F[int] = x.map(n -> n + 1)

second[F[_]: Mappable](x: F[int], y: F[int]) -> F[int] = y

three[F[_]: Mappable](x: F[int], y: F[int], z: F[int]) -> Vector[F[int]] = [x, y, z]

deep[F[_]: Mappable, G[_]: Mappable](x: F[G[int]]) -> F[G[int]] = x.map(g -> g.map(n -> n * 10))

counted[F[_]: Mappable & Counted](x: F[int]) -> int = x.map(n -> n + 1).again().count()

name(r: Result[int, Animal]) -> string = r match
  Ok(n) -> s"ok $n"
  Err(a) -> s"err ${a.name}"

dogErr(n: string) -> Result[int, Dog] = Err(Dog(n))

catErr(n: string) -> Result[int, Cat] = Err(Cat(n))

main()
  // Joined by variance, in either order and across three arguments.
  println(name(second(dogErr("rex"), catErr("tom"))))
  println(name(second(catErr("tom"), dogErr("rex"))))
  val all = three(Ok(1), dogErr("a"), catErr("b"))
  for r in all
    println(name(r))
  val animals: Result[int, Animal] = second(dogErr("x"), Ok(7))
  println(name(animals))
  // A subclass is passed as its superclass, which has the conformance.
  println(incr(TallShelf(2, 10)).item)
  println(incr(Plank(3)).item)
  println(incr(Beam(4)).item)
  val tall: TallShelf[int] = TallShelf(5, 1)
  println(second(Shelf(0), tall).item)
  // Nested applications.
  val nest: List[Option[int]] = List(Some(1), None, Some(3))
  println(deep(nest))
  val ok: Option[Result[int, string]] = Some(Ok(4))
  println(deep(ok))
  println(deep(Some(Shelf(6))).map(s -> s.item))
  // Literals beside a constructor.
  println(second(Some(1), Some(2)))
  println(second(List(1, 2), List(3)))
  println(incr(Some(-2147483648)))
  println(incr(List(0)))
  // Two bounds whose conformances leave the same argument open.
  println(counted(Some(41)))
  println(counted(None))
