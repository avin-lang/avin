// expect: trap
// Padding by width with a fill character that takes no column traps rather than looping for ever:
// a wide fill and a one-column fill pad, a combining mark does not.

main()
  println("[" + "ab".padEndWidth(5, '中') + "]")
  println("[" + "ab".padStartWidth(3, '-') + "]")
  println("[" + "ab".padStartWidth(2, '\u{301}') + "]")
  println("[" + "ab".padEndWidth(3, '\u{301}') + "]")
