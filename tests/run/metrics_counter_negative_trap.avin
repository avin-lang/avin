// expect: trap
// A counter only goes up: adding zero and the least amount above it is taken, and adding a negative
// amount traps.
import avin.metrics.Registry

main()
  val c = Registry().counter("up_total", "Up.")
  c.add(0.0)
  c.add(5e-324)
  c.add(real.MaxValue)
  println(c.value > 0.0)
  c.add(-1.0)
