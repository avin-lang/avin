// expect: exit 0
// Refined variants are declared and checked, and a program holding them compiles and runs. A variant
// whose result is written as its type at the type's own parameters is a plain variant: its type is
// used as any data type is, covariance, matching, equality and closures included.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  BoolLit(value: bool) -> Expr[bool]
  Add(a: Expr[int], b: Expr[int]) -> Expr[int]
  Eq(a: Expr[int], b: Expr[int]) -> Expr[bool]
  If(cond: Expr[bool], yes: Expr[T], no: Expr[T])
  Pair[A, B](first: Expr[A], second: Expr[B]) -> Expr[(A, B)]
  First[A, B](pair: Expr[(A, B)]) -> Expr[A]
  Wide(text: string) -> Expr[int | string]
  Fn[A, B](f: (A) -> B) -> Expr[(A) -> B]
  Größe[Ä](wert: Vector[Ä] = [], n: int = wert.size) -> Expr[Vector[Ä]]
  Hidden(value: T, show: (T) -> string) -> Expr[string]

data Query[R]
  Balance -> Query[long]
  Owner -> Query[string]
  Deposit(amount: long) -> Query[unit]

data Msg
  Ask[R: Sendable](query: Query[R], reply: (R) -> unit)

open class Animal(val name: string)

class Dog(name: string): Animal(name)

data Box[+T] derives Eq
  Holds(value: T) -> Box[T]
  Empty -> Box[T]

data Cell[T](value: T)

data Tagged[K, V]
  Entry(key: K, value: V) -> Tagged[K, V]
  Blank

describe(b: Box[Animal]) -> string = b match
  Holds(a) -> s"holds ${a.name}"
  Empty -> "empty"

main()
  val dog: Box[Dog] = Holds(Dog("rex"))
  println(describe(dog))
  println(describe(Empty))
  println(Holds(1) == Holds(1))
  println(Holds("é") == Holds("e"))
  val entries = [Entry("ü", 1), Entry("", -2147483648), Blank]
  for e in entries
    println(e)
  val count = 3
  val make = (k: string) -> Entry(k, count)
  println(make("k"))
  println(Cell(Holds(2.5)))
