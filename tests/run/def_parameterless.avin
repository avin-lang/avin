// expect: exit 0
// `def` declares a function with no parameter list at the top level and in a block. It is called by
// its bare name, with no parentheses, and its body runs again at every read; a counter shows it.
// Parentheses after it call what it yields, a function or a sequence given an index. It has no
// function value, so where one is wanted a lambda names it. A local one captures what is in scope
// where it is declared, as a local function does.

var counter = 0

tick() -> int
  counter += 1
  counter

def now -> int = tick()
def label -> string = s"tick ${now}"
def adder -> (int) -> int = x -> x + now
def squares -> Vector[int] = [1, 4, 9, 16]
def inferred = now * 10
def nothingYet -> Option[int] = None
private def secret -> string = "hidden"

def block -> int
  val a = now
  val b = now
  a + b

class Holder(val n: int)
  def doubled -> int = n * 2

def holder -> Holder = Holder(now)

generic[T](x: T, f: (T) -> string) -> string
  def shown -> string = f(x) + s"@$now"
  shown + "," + shown

later(f: () -> int) -> int = f() + f()

main() =
  // Each read runs the body again.
  println(now)
  println(now)
  println(s"${now} ${now}")
  println(now + now)
  println(now.toString() + "!")
  println(now.toString().byteLength)
  println(label)
  // Parentheses call what it yields.
  println(adder(100))
  println(adder(100))
  println(squares(2))
  println(squares.length)
  println(squares.map(x -> x + 1))
  println(inferred)
  println(nothingYet.getOrElse(-1))
  println(secret)
  println(block)
  println(holder.doubled)
  println(holder.n)
  // A function wanted: the lambda reads it at every call.
  val f: () -> int = () -> now
  println(f())
  println(f())
  println(later(() -> now))
  // A function yielded is a function value, which the name gives.
  val g: (int) -> int = adder
  println(g(0))
  println(generic(5, x -> s"<$x>"))
  // Local ones, capturing a `var` and a parameter, are read again at each use.
  var steps = 0
  def step -> int
    steps += 1
    steps
  println(s"$step $step $step")
  println(steps)
  val base = 1000
  def offset -> int = base + steps
  println(offset)
  steps = 5
  println(offset)
  def localAdder -> (int) -> int = x -> x + base
  println(localAdder(7))
  def localList -> Vector[string] = ["a", "b", "c"]
  println(localList(1))
  // A local one used before its declaration, as local functions may be.
  println(early)
  def early -> int = 42
  // In a loop and in a lambda it is read each time.
  var total = 0
  for _ in 0 ..< 3
    total += step
  println(total)
  println([1, 2, 3].map(x -> x + step))
  // Inside a nested function and a nested block.
  nested() -> int = step * 100
  println(nested())
  if true
    def inner -> string = s"inner $step"
    println(inner)
