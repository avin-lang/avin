// expect: trap
// A selector's `readable` entry uses its stream as a read does, so a connection handed to another
// thread traps in the thread that handed it over when its selector tries the entry.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.threads.{Channel, Selector, spawn}

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

main()
  val l = ok(TcpListener.bind("127.0.0.1", 0))
  val c = ok(TcpStream.connect("127.0.0.1", l.port()))
  val s = ok(l.accept())
  val go = Channel[int]()
  val t = spawn(() ->
    go.receive()
    ok(c.close()))
  println("handed over")
  val sel = Selector[int]()
  sel.receive(go, 0)
  sel.readable(c, 1)
  println(sel.wait())
  go.send(1)
  t.join()
