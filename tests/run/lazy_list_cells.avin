// expect: exit 0
// A lazy list's cells keep their element and the list after it in the cell itself, stored when the
// cell is evaluated. Lists that are their own tails, two cells apart or one, repeat for ever; a cell
// evaluated as another list's first cell (`#::`'s rest, `drop`, `dropWhile`, the join of `++`) holds
// that cell's element and rest; elements of every kind are kept, the collector running at every
// allocation; a list of dogs read as a list of animals gives its dogs; and the state a cell is in
// shows in `isEvaluated` and `knownSize` before, during and after its evaluation.

open class Animal(val name: string)

class Dog(name: string): Animal(name)

lazy val ones: LazyList[int] = LazyList.cons(1, ones)

lazy val alternating: LazyList[int] = 1 #:: 2 #:: alternating

lazy val cycle: LazyList[int] = LazyList.from(0).take(3) ++ cycle

lazy val doubled: LazyList[long] = 1 #:: doubled.map(x -> x * 2)

describe[T: Display](xs: LazyList[T]) -> string = s"${xs.isEvaluated()} ${xs.knownSize}"

main()
  println(ones.take(5).toVector)
  println(ones.tail.tail.head)
  println(alternating.take(5).toVector)
  println(alternating.drop(3).take(3).toVector)
  println(cycle.take(8).toVector)
  println(doubled.take(6).toVector)

  // A cell evaluated as another list's first cell.
  val source = LazyList.from(10)
  val dropped = source.drop(2)
  println(dropped.head)
  println(dropped.tail.head)
  println(source.take(4).toVector)
  println(source.dropWhile(x -> x < 13).take(2).toVector)
  println((LazyList.empty[int]() ++ LazyList.from(7)).take(2).toVector)
  println((LazyList.from(1).take(2) ++ LazyList.empty[int]()).toVector)
  println((LazyList.empty[int]() ++ LazyList.empty[int]()).isEmpty)
  println(LazyList.from(0).take(2).drop(5).isEmpty)
  println(LazyList.from(0).take(2).dropWhile(x -> true).isEmpty)

  // Elements of every kind.
  println(LazyList.from(long.MaxValue - 2).take(3).toVector)
  println(LazyList.iterate(0.5, x -> x * 2).take(3).toVector)
  println(LazyList.iterate(true, x -> !x).take(3).toVector)
  println(LazyList.iterate('a', c -> char(int(c) + 1)).take(3).toVector)
  println(LazyList.iterate("é", s -> s + "👋").take(3).toVector)
  println(LazyList.from(0).map(x -> (x, s"$x")).take(2).toVector)
  println(LazyList.from(0).map(x -> if x % 2 == 0 then Some(x) else None).take(3).toVector)
  val mixed: LazyList[int | string] = LazyList.from(0).map(x -> if x % 2 == 0 then x else s"odd $x")
  println(mixed.take(3).toVector)
  println(LazyList.continually(()).take(4).length)
  val fs = LazyList.from(1).map(k -> (n: int) -> n * k)
  println(fs(2)(10))

  // Covariance: the cells of a list of dogs read through a list of animals.
  val dogs: LazyList[Dog] = LazyList.from(0).map(i -> Dog(s"dog$i"))
  val animals: LazyList[Animal] = dogs
  println(animals.take(2).map(a -> a.name).toVector)
  val more: LazyList[Animal] = dogs.take(1) ++ LazyList.cons(Animal("cat"), LazyList.empty[Animal]())
  println(more.map(a -> a.name).toVector)
  val front: LazyList[Animal] = Animal("owl") +: dogs.take(1)
  println(front.map(a -> a.name).toVector)

  // The state of a cell before and after it is evaluated.
  val fresh = LazyList.from(0).filter(x -> x > 2)
  println(describe(fresh))
  println(fresh.head)
  println(describe(fresh))
  val none = LazyList.empty[int]()
  println(describe(none))
  println(none.isEmpty)
  println(describe(none))
  // While a cell is evaluated, it is neither evaluated nor known to be empty.
  println(watching.head)
  println(describe(watching))
  println(describe(LazyList.cons(1, LazyList.empty[int]())))

lazy val watching: LazyList[string] = LazyList.continually(describe(watching))
