// expect: exit 0
// A data type, a class or a trait may name methods `+`, `-`, `*`, `/`, `%`, `<`, `<=`, `>` and `>=`,
// with any operand and result types, overloaded by the operand's type. `a + b` calls `a`'s method `+`
// at the built-in operator's precedence; `-a` calls a method `-` taking no argument. Where a type has
// no such method, the operator is its core trait's, as generic code always reaches it.

data Span(micros: long) derives Ord

impl Add for Span
  add(other: Span) -> Span = Span(micros + other.micros)
  static zero() -> Span = Span(0)

data Stamp(micros: long)

impl Stamp
  +(d: Span) -> Stamp = Stamp(micros + d.micros)
  -(d: Span) -> Stamp = Stamp(micros - d.micros)
  -(earlier: Stamp) -> Span = Span(micros - earlier.micros)
  <(other: Stamp) -> bool = micros < other.micros
  >=(other: Stamp) -> bool = micros >= other.micros

class Vec(val x: real, val y: real)
  *(k: real) -> Vec = Vec(x * k, y * k)
  *(other: Vec) -> real = x * other.x + y * other.y
  +(other: Vec) -> Vec = Vec(x + other.x, y + other.y)
  /(k: real) -> Vec = Vec(x / k, y / k)
  -() -> Vec = Vec(-x, -y)
  show() -> string = s"($x, $y)"

// A comparison by a method yields whatever the method does: here a condition of a query.
data Column(name: string)

impl Column
  <(n: int) -> string = s"$name < $n"
  >(n: int) -> string = s"$name > $n"
  <=(other: Column) -> string = s"$name <= ${other.name}"

data Clock(minutes: int)

impl Clock
  %(n: int) -> int = minutes % n

// A type with a method `+` and `Add` as well: the operator calls the method, and generic code bounded
// by `Add` calls `add`.
data Money(cents: long)

impl Money
  +(n: long) -> Money = Money(cents + n)

impl Add for Money
  add(other: Money) -> Money = Money(cents + other.cents)
  static zero() -> Money = Money(0)

total[T: Add](items: Vector[T]) -> T
  var sum = T.zero()
  for x in items
    sum = sum + x
  sum

// A trait's method `+`, called on the trait's value, dispatches on its class.
trait Shape
  +(n: int) -> Shape
  size() -> int

class Square(val side: int): Shape
  override +(n: int) -> Shape = Square(side + n)
  override size() -> int = side * side

class Line(val length: int): Shape
  override +(n: int) -> Shape = Line(length * n)
  override size() -> int = length

// A type parameter bounded by such a trait has its method `+`.
grow[T: Shape](s: T) -> int = (s + 2).size()

class Counter(var count: Stamp)

main()
  val s = Stamp(100)
  val later = s + Span(50)
  println(later.micros)
  println((later - Span(20)).micros)
  println((later - s).micros)
  println(later - s == Span(50))
  println(s < later)
  println(later < s)
  println(later >= s)
  // The precedence is the built-in operator's: `*` before `+`.
  val v = Vec(1.0, 2.0)
  println((v + v * 2.0).show())
  println(v * Vec(3.0, 4.0))
  println((v / 2.0).show())
  println((-v).show())
  println((-v * 3.0).show())
  // The dotted form names the same method.
  println(v.+(v).show())
  println(Column("age") < 30)
  println(Column("age") > 18)
  println(Column("lo") <= Column("hi"))
  println(Clock(135) % 60)
  // `+=` and `-=` assign through the methods `+` and `-`, on a local and on a field.
  var t = Stamp(0)
  t += Span(7)
  t += Span(3)
  t -= Span(1)
  println(t.micros)
  var w = Vec(1.0, 1.0)
  w *= 4.0
  w += Vec(1.0, 0.0)
  println(w.show())
  val counter = Counter(Stamp(5))
  counter.count += Span(5)
  println(counter.count.micros)
  var m = Money(100)
  m += 5
  println(m.cents)
  println((m + 10).cents)
  println(total([Money(1), Money(2), Money(3)]).cents)
  println(total([Span(4), Span(5)]).micros)
  // `Span` has no method `+`, so its `+` is still `Add`'s.
  println((Span(1) + Span(2)).micros)
  val shapes: Vector[Shape] = [Square(2), Line(3)]
  for sh in shapes
    println((sh + 1).size())
  println(grow(Square(1)))
  println(grow(Line(4)))
