// expect: exit 0
// `==` and the hash of a union with a scalar member are decided by its tag, and agree with those of
// the same value seen as an `Any`: equal values hash alike whichever view holds them, two members are
// never equal (`1` as an `int` and as a `long`), and a member's own equality is used.

class Money(val cents: int)

impl Eq for Money
    equals(other: Money) -> bool = cents == other.cents

impl Hash for Money
    hash() -> long = cents.hash()

class Dog(val name: string)

data Point(x: int, y: int)

type Mixed = int | long | real | char | bool | unit | byte | string | Money | Point | Dog

// Both views of every pair: the union's `==` and hash, and those of the values as `Any`s.
agree(a: Mixed, b: Mixed) -> string
    val x: Any = a
    val y: Any = b
    val same = a == b
    if same != (x == y) then return "== disagrees"
    if a.hash() != x.hash() then return "hash disagrees"
    if same && a.hash() != b.hash() then return "equal values hash apart"
    if same then "equal" else "unequal"

eqParams(a: int | string, b: int | string) -> bool = a == b

main()
    val rex = Dog("rex")
    var values: Vector[Mixed] = [0, 1, -1, int.MaxValue, int.MinValue]
    values = values :+ long(1)
    values = values :+ long.MaxValue
    values = values :+ 1.0
    values = values :+ 0.0
    values = values :+ -0.0
    values = values :+ real.NaN
    values = values :+ '1'
    values = values :+ true
    values = values :+ false
    values = values :+ ()
    values = values :+ byte(1)
    values = values :+ "1"
    values = values :+ ""
    values = values :+ "日本"
    values = values :+ Money(5)
    values = values :+ Money(5)
    values = values :+ Point(1, 2)
    values = values :+ Point(1, 2)
    values = values :+ rex
    values = values :+ rex
    values = values :+ Dog("rex")
    var equal = 0
    var problems = 0
    for i in 0..<values.size()
        for j in 0..<values.size()
            val verdict = agree(values(i), values(j))
            if verdict == "equal" then equal += 1
            elif verdict != "unequal"
                problems += 1
                println(s"$i $j $verdict")
    println(s"$equal equal pairs, $problems problems")
    // Each member against its neighbours.
    val i: int | long = 1
    val l: int | long = long(1)
    println(s"${i == l} ${i != l} ${i == i} ${l == long(1)} ${i == 1}")
    val nan: real | bool = real.NaN
    println(s"${nan == nan} ${nan != nan}")
    val zero: real | bool = 0.0
    val negative: real | bool = -0.0
    println(s"${zero == negative} ${zero.hash() == negative.hash()}")
    val c: char | string = 'x'
    val s: char | string = "x"
    println(s"${c == s} ${c == 'x'} ${s == "x"}")
    val u1: unit | int = ()
    val u2: unit | int = ()
    println(s"${u1 == u2} ${u1 == 0} ${u1.hash() == ().hash()}")
    // Parameters compare as locals do.
    println(s"${eqParams(1, 1)} ${eqParams(1, "1")} ${eqParams("a", "a")}")
    // Hashing keeps sets and maps apart by member and finds each key by its value.
    val keys: Set[int | long | char] = Set(1, long(1), '1', 1, long(1))
    println(keys.size())
    println(s"${keys.contains(1)} ${keys.contains(long(1))} ${keys.contains('1')} ${keys.contains(2)}")
    var table: Map[real | bool, string] = {}
    table = table.updated(1.5, "real")
    table = table.updated(true, "bool")
    println(s"${table.get(1.5)} ${table.get(true)} ${table.get(false)}")
    // `===` sees a scalar member as a new box, never the object on the other side.
    val di: Dog | int = rex
    val dn: Dog | int = 3
    println(s"${di === rex} ${dn === rex} ${rex !== dn}")
