// expect: trap
// A Unix listener handed to a thread is the thread's while the thread runs, and the code that handed
// it over traps at its next use.
import avin.fs
import avin.io.IoError
import avin.net.UnixListener
import avin.threads.{Channel, spawn}

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

main()
  val dir = ok(fs.createTempDir("avu"))
  val l = ok(UnixListener.bind(dir + "/s"))
  val go = Channel[int]()
  val t = spawn(() ->
    go.receive()
    _ = l.close()
    0)
  println("handed over")
  _ = l.close()
  println("not reached")
  go.send(1)
  println(t.join())
