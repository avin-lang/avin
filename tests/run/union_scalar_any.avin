// expect: exit 0
// A union with a scalar member converts to an `Any`, or to a trait every member has, where it is
// written: a scalar member is boxed there and a reference passed as it is. A type pattern takes the
// value back out of the `Any`, as the union, as a smaller union or as a member, and fails on a value
// that is no member. Generic code at a union type argument keeps the union's own layout.

class Dog(val name: string)

trait Named
    name() -> string

class Cat(val n: string): Named
    override name() -> string = n

impl Named for int
    name() -> string = s"number $self"

asAny(u: int | bool | string) -> Any = u

member(u: int | bool | string) -> string = u match
    n: int -> s"int $n"
    b: bool -> s"bool $b"
    s: string -> s"string $s"

back(a: Any) -> string = a match
    whole: (int | bool | string) -> s"union ${member(whole)}"
    _ -> "no member"

partly(a: Any) -> string = a match
    small: (int | bool) -> s"small $small"
    _ -> "not small"

named(n: Named) -> string = n.name()

shownAs(d: Display) -> string = s"{$d}"

first[T](xs: Vector[T]) -> Option[T] = if xs.isEmpty then None else Some(xs.head)

same[T](x: T) -> T = x

twice[T](x: T, f: (T) -> T) -> T = f(f(x))

main()
    println(back(asAny(5)))
    println(back(asAny(true)))
    println(back(asAny("s")))
    println(back(2.5))
    println(back(Dog("d")))
    println(partly(asAny(7)))
    println(partly(asAny("x")))
    println(partly(long(7)))
    // The value as an `Any` is the member's own: a type pattern on the member's type finds it.
    val u: int | Dog = 12
    val a: Any = u
    println(a match
        n: int -> s"int ${n + 1}"
        _ -> "other")
    val d: int | Dog = Dog("rex")
    val ad: Any = d
    println(ad match
        dog: Dog -> dog.name
        _ -> "other")
    // A union whose members all implement a trait converts to it.
    val pet: int | Cat = Cat("tom")
    val num: int | Cat = 4
    println(s"${named(pet)} ${named(num)}")
    val text: int | string = "t"
    val digit: int | string = 9
    println(s"${shownAs(text)} ${shownAs(digit)}")
    // Generic code at a union type argument.
    val xs: Vector[int | string] = [3, "three"]
    println(first(xs))
    println(first(Vector[int | string]()))
    println(same[int | string]("kept"))
    println(twice[int | string](1, v -> v match
        n: int -> n * 10
        s: string -> s))
    println(xs.map(v -> same(v)))
    println(xs.filter(v -> v is _: int))
    println(xs.contains(3))
    println(xs.contains("3"))
    val maybe: Option[int | string] = Some("in an option")
    println(maybe.getOrElse(0))
    println(maybe.map(v -> v match
        n: int -> n
        s: string -> s.charCount))
