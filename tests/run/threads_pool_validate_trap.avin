// expect: trap
// A trap inside `validate` stops the program, as one inside `f` or `create` does: the resource being
// checked would otherwise be left counted for ever. Nothing after the call runs.
import avin.threads.Pool

main()
  val pool = Pool[int, string](() -> Ok(1), maxSize = 1, validate = Some(r -> r / (r - 1) == 0))
  println(pool.use(r -> r))
  println(pool.use(r -> r))
  println("not reached")
