// expect: exit 0
// Reading instants in a zone at the calendar's edges: midnight and the last microsecond of a day, the
// end of a year, leap days (a fourth year, a century that is not one, a fourth century that is),
// epoch 0, instants before it, the least and greatest instants, and an offset that carries the
// reading across a day, a month and a year. The readings' fields, their display, and the round
// trip back to the instant.
import avin.time.{Date, Duration, Instant, Time, Weekday, Zoned, epochSeconds, epochMicros, utc, fixedZone, hours, minutes, seconds, date, time, dateTime, isLeapYear, daysInMonth}

show(z: Zoned)
    println(s"$z ${z.weekday} day ${z.dayOfYear} ${z.format("YYYY-MM-DD hh:mm:ss.ffffff")} back ${z.toInstant == z.toInstant.atZone(utc).toInstant}")

main()
    // Epoch 0, and the microseconds either side of it.
    show(epochSeconds(0).atZone(utc))
    show(epochMicros(-1).atZone(utc))
    show(epochMicros(1).atZone(utc))
    println(epochMicros(-1).atZone(utc).date.epochDay)
    println(epochMicros(-1).atZone(utc).time.microsOfDay)

    // Midnight and the end of a day.
    show(epochSeconds(1785888000).atZone(utc))
    show(epochMicros(1785974399999999).atZone(utc))

    // The end of a year, and a fixed zone carrying it into the next one and back.
    val lastSecond = epochSeconds(1798761599)
    show(lastSecond.atZone(utc))
    show((lastSecond + seconds(1)).atZone(utc))
    show(lastSecond.atZone(fixedZone(hours(1))))
    show((lastSecond + seconds(1)).atZone(fixedZone(-minutes(1))))

    // Leap days: 2024-02-29, the day after it, 1900 (no leap day) and 2000 (a leap day).
    show(epochSeconds(1709251199).atZone(utc))
    show((epochSeconds(1709251199) + seconds(1)).atZone(utc))
    println(date(2024, 2, 29).dayOfYear)
    println(date(2024, 12, 31).dayOfYear)
    println(date(2023, 12, 31).dayOfYear)
    println(s"${isLeapYear(2024)} ${isLeapYear(2023)} ${isLeapYear(1900)} ${isLeapYear(2000)} ${isLeapYear(0)} ${isLeapYear(-4)} ${isLeapYear(-1)}")
    println(s"${daysInMonth(2024, 2)} ${daysInMonth(2023, 2)} ${daysInMonth(1900, 2)} ${daysInMonth(2000, 2)} ${daysInMonth(2026, 4)} ${daysInMonth(2026, 12)}")
    println(date(2000, 2, 29))
    println(date(2000, 3, 1).epochDay - date(2000, 2, 28).epochDay)
    println(date(1900, 3, 1).epochDay - date(1900, 2, 28).epochDay)

    // Before the epoch: 1969, 1900, year 1, year 0 (a leap year) and year -1.
    show(epochSeconds(-1).atZone(utc))
    show(epochSeconds(-2208988800).atZone(utc))
    show(midnightOf(date(1, 1, 1)).atZone(utc))
    show(midnightOf(date(0, 2, 29)).atZone(utc))
    show((midnightOf(date(0, 1, 1)) - seconds(1)).atZone(utc))
    show(midnightOf(date(-1, 12, 31)).atZone(utc))
    println(date(0, 12, 31).dayOfYear)
    println(date(-1, 12, 31).dayOfYear)
    println(date(-1, 12, 31))
    println(date(-1, 12, 31).format("Y YY YYYY"))
    println(date(12345, 6, 7))
    println(date(12345, 6, 7).format("Y YY YYYY"))
    println(date(5, 6, 7).format("Y YY YYYY"))

    // The least and greatest instants have a reading in every zone, the offset carrying them past
    // the instants' own range.
    show(Instant.Min.atZone(utc))
    show(Instant.Max.atZone(utc))
    println(Instant.Min.atZone(fixedZone(-(hours(23) + minutes(59)))))
    println(Instant.Max.atZone(fixedZone(hours(23) + minutes(59))))
    println(Instant.Min.atZone(fixedZone(-(hours(23) + minutes(59)))).toInstant == Instant.Min)
    println(Instant.Max.atZone(fixedZone(hours(23) + minutes(59))).toInstant == Instant.Max)

    // The fields of each calendar type, and their order.
    val dt = dateTime(2026, 8, 28, 17, 24, 15, 500)
    println(s"$dt ${dt.year} ${dt.month} ${dt.day} ${dt.hour} ${dt.minute} ${dt.second} ${dt.microsecond} ${dt.weekday} ${dt.monthName} ${dt.daysInMonth} ${dt.daysInYear} ${dt.isLeapYear}")
    println(s"${dt.date} ${dt.time} ${dateTime(dt.date, dt.time) == dt} ${dt.date.atTime(dt.time) == dt} ${dt.time.atDate(dt.date) == dt}")
    println(s"${date(2026, 1, 1) < date(2026, 1, 2)} ${time(9, 0) < time(9, 0, 0, 1)} ${dateTime(2026, 1, 1, 23, 59) < dateTime(2026, 1, 2, 0, 0)}")
    println(s"${time(0, 0) == Time.Midnight} ${time(12, 0) == Time.Noon} ${time(9, 30, 7, 250000)} ${time(9, 30)}")
    println(s"${Weekday.Monday < Weekday.Sunday} ${Weekday.Sunday.isoNumber} ${Weekday.Monday.plus(-1)} ${Weekday.Friday.plus(3)} ${Weekday.Wednesday.plus(14)} ${Weekday.Sunday.plus(1)}")

    // A zoned reading's other parts.
    val z = epochSeconds(1787937855).atZone(fixedZone(hours(2)))
    println(s"${z.dateTime} ${z.offset} ${z.zone} ${z.date} ${z.time} ${z.epochSeconds} ${z.epochMillis} ${z.epochMicros} ${z.isDaylightSaving} ${z.abbreviation}")
    val same = z.atZone(utc)
    println(s"$same ${same == z} ${same.isSameInstant(z)} ${same.isBefore(z)} ${same.isAfter(z)} ${z.atZone(fixedZone(hours(2))) == z}")
    val later = (epochSeconds(1787937855) + seconds(1)).atZone(utc)
    println(s"${z.isBefore(later)} ${later.isAfter(z)} ${later.isSameInstant(z)}")

// The first instant of `d` in UTC.
midnightOf(d: Date) -> Instant = epochSeconds(long(d.epochDay) * 86400)
