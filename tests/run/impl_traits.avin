// `impl Trait for Type` makes a type conform after the fact: a data type, a class or an object. A
// value of the trait's type then reaches any of them, and its calls dispatch through the method
// table each value's descriptor carries.
trait Area
    area() -> int
    name() -> string = "shape"
    describe() -> string = s"${name()} of area ${area()}"

data Shape
    Circle(r: int)
    Square(side: int)
    Dot

// The methods of an impl of a trait implement the trait's methods, so they are not marked
// `override`; one may call another, and a default body the impl leaves alone stays.
impl Area for Shape
    area() -> int = self match
        Circle(r) -> 3 * r * r
        Square(s) -> s * s
        Dot -> 0
    name() -> string = self match
        Circle(_) -> "circle"
        Square(_) -> "square"
        Dot -> "dot"

class Rect(w: int, h: int)
    perimeter() -> int = 2 * (w + h)

impl Area for Rect
    area() -> int = w * h
    name() -> string = s"rect of perimeter ${perimeter()}"

object Unit
    val size = 1

impl Area for Unit
    area() -> int = size

// A data type conforming to a trait that requires another implements both.
trait Named
    label() -> string

trait Tagged: Named
    tag() -> string = s"<${label()}>"

data Word(text: string)

impl Tagged for Word
    label() -> string = text

// A generic trait for a generic data type.
trait Source[T]
    get() -> T
    both() -> (T, T) = (get(), get())

data Box[T](value: T)

impl[T] Source[T] for Box[T]
    get() -> T = value

// An impl of a trait for a type declared after it, and a trait-typed list holding every kind of
// shape at once.
impl Area for Ring
    area() -> int = outer - inner

data Ring(outer: int, inner: int)

data Shapes
    More(first: Area, rest: Shapes)
    Done

impl Shapes
    total() -> int = self match
        More(s, rest) -> s.area() + rest.total()
        Done -> 0
    each()
        self match
            More(s, rest) ->
                print(s.describe())
                rest.each()
            Done -> ()

// One method fills the position of every trait with a method of its name, as a class's does; an
// impl with no body states a conformance its type already implements.
trait Measured
    size() -> int

trait Counted
    size() -> int
    counted() -> string = s"${size()} counted"

data Rope(length: int)

impl Measured for Rope
    size() -> int = length

impl Counted for Rope

show(a: Area) = print(a.describe())

named(n: Named) -> string = n.label()

main()
    val all: Shapes = More(Circle(1), More(Rect(2, 3), More(Square(2), More(Dot, More(Unit, More(Ring(9, 4), Done))))))
    all.each()
    print(s"${all.total()}")
    show(Square(5))
    var current: Area = Dot
    print(s"${current.area()}")
    current = Circle(2)
    print(current.describe())
    print(Circle(3).describe())
    val w = Word("hi")
    print(w.tag())
    val t: Tagged = w
    print(t.tag() + named(t) + named(w))
    val s: Source[int] = Box(4)
    print(s"${s.get()} ${s.both().1} ${Box("q").both().0}")
    val m: Measured = Rope(7)
    val k: Counted = Rope(8)
    print(s"${m.size()} ${k.size()} ${k.counted()} ${Rope(2).counted()}")
    val r = Rect(1, 1)
    val same: Area = r
    print(s"${same === r}")
