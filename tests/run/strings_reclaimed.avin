// expect: exit 0
// env: AVIN_GC_STRESS=0
// env: AVIN_HEAP_LIMIT=1048576
// Joins strings totalling many times the heap's one megabyte while keeping one alive: the strings
// no longer reachable are freed, and the one still held survives every collection intact.

repeat(s: string, n: int) -> string = if n == 0 then "" else s + repeat(s, n - 1)

main() -> int
    val kept = repeat("kept", 100)
    var round = 0
    while round < 2000
        if repeat("abcdefgh", 64) != repeat("abcdefgh", 32) + repeat("abcdefgh", 32) then return 1
        round += 1
    if kept != repeat("kept", 50) + repeat("kept", 50) then return 2
    0
