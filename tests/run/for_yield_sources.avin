// `for` with `yield` over each collection of the core library: a list, a vector, an array and a
// buffer yield their own kind, a set a set, a map a map of the pairs yielded, a range a vector and an
// option an option. A later generator's source may be another kind, which `flatMap` takes as any
// `Iterable`.

main()
    val xs: List[int] = [1, 2, 3, 4]
    println(for x in xs yield x * 10)
    println(for x in xs if x % 2 == 0 yield x + 1)

    val v: Vector[int] = [1, 2, 3]
    println(for x in v, y in v if x < y yield s"$x<$y")

    val a = Array.tabulate(4, i -> i + 1)
    val squares: Array[int] = for x in a if x != 2 yield x * x
    println(squares)

    val b = Buffer[string]()
    b.add("p")
    b.add("q")
    val repeated: Buffer[string] = for s in b, n in 1..2 yield s.repeat(n)
    println(repeated)

    val d = Deque[int]()
    d.addLast(2)
    d.addFirst(1)
    d.addLast(3)
    val shifted: Deque[int] = for x in d if x != 2, y in [x, x * 10] yield y
    println(shifted)

    val s: Set[int] = Set.empty[int]().incl(1).incl(2).incl(3).incl(4)
    println(for x in s if x > 1 yield x % 2 == 0)
    println(for x in s, y in [x, -x] if x < 3 yield y)

    val m: Map[string, int] = Map.empty[string, int]().updated("a", 1).updated("b", 2)
    println(for (k, n) in m if n > 1 yield (k, n * 100))
    println(for (k, n) in m, i in 1..n yield (s"$k$i", i))

    println(for i in 0 ..< 5 yield i * i)
    val r = 0 ..< 4
    println(for i in r, j in 0 ..< i if (i + j) % 2 == 1 yield s"$i$j")
    println(for i in 1..3, c in xs if c <= i yield i * 10 + c)

    println(for x in xs, y in v yield x * y)
    println(for x in v, y in xs if y == x yield y)

    val some: Option[int] = Some(3)
    val none: Option[int] = None
    println((for x in some, y in some yield x * y).getOrElse(-1))
    println((for x in some, y in none yield x * y).getOrElse(-1))
    println((for x in some if x > 5 yield x).getOrElse(-1))
