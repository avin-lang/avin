// expect: trap
// A range whose start is after its end traps, for an array as for a vector.

import avin.crypto.Md5

main()
  val h = Md5()
  h.update(Array.fill(4, byte(7)), 2, 2)
  h.update([byte(1), byte(2), byte(3)], 3, 3)
  println("ok")
  h.update(Array.fill(4, byte(7)), 3, 2)
  println("unreachable")
