// expect: exit 0
// The path calls of `avin.fs` that ask the file system: symbolic links made, read and recognised,
// `absolute` and `canonicalize`, `walk` over a tree holding links (one back up the tree, one dangling)
// and a directory it may not read, and `glob` over the same tree. The mode is set with `chmod`;
// where the program runs as a user the mode does not bind, that is said and the run stops there.
import avin.fs
import avin.process
import avin.process.Command

main()
    val dir = fs.createTempDir("avin-tree") match
        Ok(d) -> d
        Err(e) ->
            println(s"no directory: $e")
            return
    val at = (rel: string) -> fs.join(dir, rel)
    val shown = (p: string) -> fs.relativeTo(p, dir).getOrElse(p)
    fs.writeText(at("a.txt"), "a")
    fs.writeText(at("b.c"), "b")
    fs.createDirAll(at(".hidden"))
    fs.writeText(at(".hidden/x.c"), "x")
    fs.createDirAll(at("src/lib"))
    fs.writeText(at("src/main.c"), "")
    fs.writeText(at("src/lib/util.c"), "")
    fs.writeText(at("src/lib/文件.c"), "")
    fs.createDir(at("empty"))
    fs.createDir(at("locked"))
    fs.writeText(at("locked/secret.c"), "")

    println("-- links")
    println(fs.symlink(".", at("loop")))
    println(fs.symlink("src", at("link-src")))
    println(fs.symlink("src/lib", at("link-lib")))
    println(fs.symlink("missing", at("dangling")))
    println(fs.symlink("src", at("a.txt")))
    println(fs.readLink(at("link-src")))
    println(fs.readLink(at("a.txt")))
    println(fs.readLink(at("nothing")))
    println(s"${fs.isLink(at("link-src"))} ${fs.isDir(at("link-src"))} ${fs.isLink(at("src"))}")
    println(s"${fs.isLink(at("dangling"))} ${fs.exists(at("dangling"))} ${fs.isLink(at("nothing"))}")

    println("-- absolute and canonicalize")
    val here = process.currentDir().getOrElse("?")
    println(fs.absolute(".") == Ok(here))
    println(fs.absolute("a/../b") == Ok(fs.join(here, "b")))
    println(fs.absolute("/x/./y/..//z"))
    val real = fs.canonicalize(dir).getOrElse("?")
    println(fs.canonicalize(at("link-src/main.c")) == Ok(fs.join(real, "src/main.c")))
    // Text cancels `link-lib/..` to the tree's top; the file system climbs out of `src/lib` to `src`.
    println(shown(fs.normalize(at("link-lib/../main.c"))))
    println(fs.canonicalize(at("link-lib/../main.c")) == Ok(fs.join(real, "src/main.c")))
    println(fs.canonicalize(at("dangling")))
    println(fs.canonicalize(at("nothing")))

    Command("chmod", "000", at("locked")).run()
    if fs.listDir(at("locked")).isOk
        println("mode does not bind")
        Command("chmod", "755", at("locked")).run()
        fs.removeDirAll(dir)
        return

    println("-- walk")
    fs.walk(dir) match
        Ok(entries) ->
            for e in entries
                println(s"${e.relative} depth=${e.depth} dir=${e.isDir} link=${e.isLink} error=${e.error}")
                if e.path != at(e.relative) then println("  path is not the root joined with relative")
        Err(e) -> println(s"walk failed: $e")
    println(fs.walk(at("empty")).map(es -> es.length))
    println(fs.walk(at("missing")).map(es -> es.length))
    println(fs.walk(at("b.c")).map(es -> es.length))
    println(fs.walk(at("locked")).map(es -> es.length))
    // The root is followed when it is a link; links below it are not.
    println(fs.walk(at("link-src")).map(es -> es.map(e -> e.relative)))
    println(fs.walk(at("src/")).map(es -> es.map(e -> shown(e.path))))
    // Two walks of an unchanged tree agree.
    println(fs.walk(dir) == fs.walk(dir))

    println("-- glob")
    val globbed = (pattern: string) ->
        val found = fs.glob(at(pattern))
        val wrong = found.filter(p -> !fs.matches(at(pattern), p))
        println(s"$pattern: ${found.map(shown)}${if wrong.isEmpty then "" else s" not matching: $wrong"}")
    globbed("*.c")
    globbed("*")
    globbed(".*")
    globbed("**/*.c")
    globbed("**")
    globbed("*/main.c")
    globbed("src/**")
    globbed("src/**/*.c")
    globbed("src/lib/文*")
    globbed("src/[lm]*")
    globbed("**/lib")
    globbed("dangling")
    globbed("a.txt")
    globbed("nothing")
    globbed("nothing/*")
    globbed("a.txt/*")
    globbed("locked/*")
    globbed(".hidden/*.c")
    globbed("loop/loop/a.txt")
    globbed("src//lib/")
    println(fs.glob(""))
    println(fs.glob("/"))
    println(fs.glob(at("**/*.c")) == fs.glob(at("**/*.c")))

    Command("chmod", "755", at("locked")).run()
    println(fs.removeDirAll(dir))
    println(fs.exists(dir))
