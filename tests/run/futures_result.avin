// expect: exit 0
// A future runs its body on the pool and `await` gives back what the body returned, the same value
// at every await; the body is written as an argument or as a trailing block. A future made complete
// has its value at once, and one not yet complete has none.
import avin.threads.{Future, Promise}

square(n: int) -> int = n * n

main() -> int
    val a = Future(square(7))
    print(s"argument ${a.await()} ${a.await()}")
    val b = Future
        val words = "the pool runs this block".split(" ")
        words.length() * 10
    print(s"block ${b.await()}")
    print(s"completed ${b.isCompleted()} ${b.value()}")
    val done = Future.successful("ready")
    print(s"successful ${done.isCompleted()} ${done.value()} ${done.await()}")
    val pending = Promise[int]().future
    print(s"pending ${pending.isCompleted()} ${pending.value()}")
    val texts = Future(s"made on ${"a pool thread"}")
    print(texts.await())
    val spelled = Future.apply(6 * 7)
    print(s"spelled out ${spelled.await()}")
    0
