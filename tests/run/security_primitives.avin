// expect: exit 0
// The pieces an API server checks a request with, under the collector's stress: a bearer token drawn
// from the operating system, sent as base64url and compared in constant time; an HMAC-SHA-256
// signature carried as base64 and as hexadecimal; and the refusals of a malformed header.
import avin.crypto.{hmacSha256, constantTimeEquals, toHex}
import avin.encoding.{toBase64, fromBase64, toBase64Url, fromBase64Url, fromHex}
import avin.random.SecureRandom

// Whether the `Authorization` header carries the expected bearer token.
authorized(header: string, expected: string) -> bool =
  header.startsWith("Bearer ") && constantTimeEquals(header.drop(7), expected)

main(args: Vector[string])
  val token = SecureRandom.urlToken()
  println(s"token length: ${token.byteLength}")
  println(s"right token: ${authorized(s"Bearer $token", token)}")
  println(s"wrong token: ${authorized(s"Bearer ${SecureRandom.urlToken()}", token)}")
  println(s"short token: ${authorized(s"Bearer ${token.take(42)}", token)}")

  val signature = hmacSha256("Jefe", "what do ya want for nothing?")
  println(toBase64(signature))
  println(toBase64Url(signature))
  println(toHex(signature))
  println(fromBase64(toBase64(signature)).map(s -> constantTimeEquals(s, signature)))
  println(fromHex(toHex(signature)).map(s -> constantTimeEquals(s, signature)))

  var bytes = 0
  for i in 0 ..< 300
    val b = SecureRandom.nextBytes(i).toVector
    if fromBase64Url(toBase64Url(b)) == Ok(b) then bytes += 1
  println(s"round trips: $bytes")

  println(fromBase64("Zm9v YmFy"))
  println(fromBase64Url("Zg=="))
  println(fromBase64("Zm8"))
  println(fromBase64("Zh=="))
