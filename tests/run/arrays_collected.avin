// An array of references keeps every element alive through collections: a large array of strings
// and objects, filled while the program allocates, read back after much more allocation.

class Cell(val n: int)

main()
    val words = Array.tabulate(2000, i -> s"word$i")
    val cells = Array.tabulate(2000, i -> Cell(i))
    var churn = 0
    for k in 0..<5000
        val junk = s"junk$k" + "!"
        churn += junk.byteLength
    cells(5) = Cell(-5)
    var total: long = 0
    for c in cells do total += long(c.n)
    println(s"${words(0)} ${words(1999)} ${cells(1999).n} $total $churn")
    // A copy made by slicing holds the same objects.
    val tail = cells.slice(1990, 2000)
    println(s"${tail.length} ${tail(9) === cells(1999)}")
