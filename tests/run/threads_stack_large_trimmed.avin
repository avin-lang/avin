// expect: exit 0
// A thread asking for a 64 MiB stack recurses two hundred thousand calls deep, several times what the
// default 8 MiB holds, sleeps while the pages below it are given back, and recurses as deep again. A
// thread asking for less than the least stack gets 64 KiB and still recurses within it after its own
// sleep.
import avin.threads.{sleep, spawn}
import avin.time.millis

depth(n: int) -> int = if n == 0 then 0 else 1 + depth(n - 1)

twice(n: int) -> int
  val first = depth(n)
  sleep(millis(20))
  first + depth(n)

main() -> int
  val big = spawn(() -> twice(200000), 67108864)
  val small = spawn(() -> twice(200), 1)
  println(big.join())
  println(small.join())
  0
