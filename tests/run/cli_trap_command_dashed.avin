// expect: trap
// A command is named by one word that does not start with `-`, which would read as an option: a
// parser named `--go` given as a command traps where it is declared.
import avin.cli

main()
  val p = cli.Parser("tool").command(cli.Parser("go"))
  println("one declared")
  p.command(cli.Parser("--go"))
  println("not reached")
