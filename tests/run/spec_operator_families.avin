// expect: exit 0
// The operator families and their precedence: shifts at the multiplicative level, `::` below the
// arithmetic and grouping to the right, `&` over `^` over `|`, a prefix `-` after an operator, the
// identities `zero()` and `one()` through a bound (empty sums and products included), the update
// operators' values, `:=`, a right-grouping symbol method evaluating its operands in the order
// written, compound assignment through a method and on an element whose index is evaluated once,
// and `a ++ -b` read as `(a++) - b`.

data Pt(x: int, y: int)

impl Add for Pt
    add(other: Pt) -> Pt = Pt(x + other.x, y + other.y)
    static zero() -> Pt = Pt(0, 0)

total[T: Add](items: Vector[T]) -> T
    var sum = T.zero()
    for x in items
        sum = sum + x
    sum

product[T: Mul](items: Vector[T]) -> T
    var p = T.one()
    for x in items
        p = p * x
    p

data Seqv(items: Vector[int])

impl Seqv
    +:(x: int) -> Seqv = Seqv(x +: items)
    :+(x: int) -> Seqv = Seqv(items :+ x)

data Flags(bits: int)

impl Flags
    |(other: Flags) -> Flags = Flags(bits | other.bits)

var log = ""

note(s: string, v: int) -> int
    log = log + s
    v

main()
    println(1 + 2 << 3)
    val rest: List[int] = [5]
    val n = 1
    println(n + 1 :: rest)
    println(1 :: 2 :: Nil)
    var a = 0
    a = -1
    val y = 3
    println(s"$a ${a * -y} ${a- -y}")
    println(total([Pt(1, 2), Pt(3, 4)]))
    println(total(Vector.empty[Pt]()))
    println(total(["a", "b", "c"]))
    println(total(Vector.empty[string]()).isEmpty)
    println(total([1.5, 2.5]))
    println(total(Vector.empty[long]() :+ 1 :+ 2))
    println(product(Vector.empty[int]()))
    println(product([2.0, 3.0]))
    println(product([2, 3, 4]))
    println(1 | 2 ^ 3 & 5)
    val x = 6
    println(x & 1 == 0)
    var i = 5
    println(s"${i++} ${i} ${++i} ${i} ${i--} ${--i}")
    var z = 0
    println(z := 7)
    println(z += 1)
    println(z)
    val s = 1 +: 2 +: Seqv([3]) :+ 4
    println(s.items)
    log = ""
    val t = note("x", 9) +: Seqv([note("v", 0)])
    println(s"${t.items} $log")
    var f = Flags(1)
    f |= Flags(4)
    println(f.bits)
    val arr = Array.fill(3, 0)
    var k = 0
    nextIndex() -> int
        k += 1
        k - 1
    arr(nextIndex()) += 5
    println(s"${arr(0)} ${arr(1)} $k")
    var xs = [1, 2]
    xs ++= [3]
    xs :+= 4
    println(xs)
    val b = 2
    var c = 10
    println(c ++ -b)
    println(c)
    println(1 < 2 < 3)
    println(3 > 2 > 2)
