// expect: exit 0
// A static member named on its type without a call is a function value taking the member's
// parameters: a built-in type's own, a trait's implementation at a built-in type and at a data type,
// and an overloaded one picked by the function type expected.

impl string
    static twice(s: string) -> string = s + s
    static pair(a: int, b: int) -> string = s"$a,$b"
    static pair(a: char, b: char) -> string = s"$a$b"

impl int
    static square(n: int) -> int = n * n

data Point(x: int, y: int)

impl Add for Point
    add(other: Point) -> Point = Point(x + other.x, y + other.y)
    static zero() -> Point = Point(0, 0)

apply(f: (int) -> int, n: int) -> int = f(n)

main()
    val f = string.twice
    println(f("ab"))
    println(["x", "y"].map(string.twice))
    println(apply(int.square, 9))
    val z: () -> int = int.zero
    println(z())
    val p: () -> Point = Point.zero
    println(p())
    val chars: (char, char) -> string = string.pair
    println(chars('o', 'k'))
    val ints: (int, int) -> string = string.pair
    println(ints(1, 2))
