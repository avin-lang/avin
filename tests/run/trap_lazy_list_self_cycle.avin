// expect: trap
// A lazy list whose first cell needs its own value, here an empty list joined to itself, would wait
// for itself for ever: the read made while the cell is being evaluated traps there instead, with a
// message that speaks of the lazy list rather than of anything inside it. A list whose later cells
// refer to it, as `ones` does, is fine.

lazy val ones: LazyList[int] = LazyList.cons(1, ones)

lazy val nothing: LazyList[int] = LazyList.empty[int]() ++ nothing

main()
    println(ones.take(3).toVector)
    println("before")
    nothing.isEmpty
    println("after")
