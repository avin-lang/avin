// A block whose last line closes a bracket opened before the block ends at that line's comma: the
// items after it are the enclosing list's, not parts of a tuple the block yields.

runWith(f: () -> int, size: int = 4096) -> string = s"${f()} $size"

first(f: int -> int, a: int, b: int) -> int = f(a) * 100 + b * 10 + a

middle(a: int, f: int -> int, b: int) -> int = a * 100 + f(b)

pair(f: () -> (int, string), n: int) -> string
  val t = f()
  s"${t.0} ${t.1} $n"

swapped(f: () -> (int, int)) -> string
  val t = f()
  s"${t.0} ${t.1}"

main()
  val n = 3
  // The call that showed it: the second argument is the call's, not part of the lambda's value.
  println(runWith(() ->
    val a = 10
    a + n * 2, 67108864))
  // A named argument after the block.
  println(runWith(() ->
    val a = 1
    a, size = 7))
  // The lambda as the first, middle and last argument.
  println(first(x ->
    x + 1, 2, 3))
  println(middle(1, x ->
    x * 2, 5))
  println(runWith(() -> 2, 9))
  // A collection literal and a map.
  val fs = [() ->
    val a = 4
    a, () -> 5]
  println(fs.size)
  println(fs(0)() + fs(1)())
  val m = {"a": () ->
    val b = 6
    b, "c": () -> 7}
  println(m.size)
  println(m("a")() + m("c")())
  // Nested lambdas, each closing a bracket on the one line.
  println(runWith(() ->
    middle(1, x ->
      x + n, 2), 11))
  // `if` and `match` blocks inside the lambda end at the comma too.
  println(runWith(() ->
    if n > 2
      1
    else
      2, 12))
  println(runWith(() ->
    n match
      3 -> 30
      _ -> 0, 13))
  // A tuple the lambda yields is written in parentheses there.
  println(pair(() ->
    val k = 8
    (k, "eight"), 14))
  // A closing bracket on a line of its own leaves the last line a tuple.
  println(swapped(() ->
    1, 2
  ))
  // A multiple assignment inside the block is unchanged.
  println(swapped(() ->
    var a = 1
    var b = 2
    a, b = b, a
    (a, b)))
  // A block outside brackets yields a tuple from its last line as before.
  val g = () ->
    5, 6
  println(g())
