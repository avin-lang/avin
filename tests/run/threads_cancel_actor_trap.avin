// expect: exit 0
// An actor whose code traps inside a scope's body fails, and its thread goes back to the turn with the
// scope's frames dropped; the scopes it opens afterwards, after its restart, still cancel their
// threads and wait for them.
import avin.actors.{ActorRef, Restart, spawn}
import avin.threads.{Channel, scope, sleep}
import avin.time

data Msg
    Bad
    Run(reply: ActorRef[string])

actor Worker receives Msg
    receive
        Bad -> scope(s ->
            val zero = s.spawn(() -> 0).join()
            println(1 / zero))
        Run(r) -> r.tell(scope(s ->
            val t = s.spawn(() ->
                sleep(time.hours(1))
                1)
            s.cancel()
            s"${t.result()} ${s.isCancelled()}"))

main()
    val w = spawn(Worker(), onFailure = Restart(3, time.minutes(1)))
    println(w.ask(r -> Run(r), timeout = time.seconds(60)).await())
    w.tell(Bad)
    println(w.ask(r -> Run(r), timeout = time.seconds(60)).await())
    println(w.ask(r -> Run(r), timeout = time.seconds(60)).await())
