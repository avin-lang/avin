// expect: exit 0
// On a future of a `Result`, `mapErr` turns one failure into another and leaves an `Ok` alone, and
// `orElse` goes on to another future only where the first ended in `Err`: its by-name argument is not
// even evaluated after an `Ok`. A failure passes through `mapOk` and `flatMapOk` to reach them, the
// fallback may itself fail or fail differently, and `orElse` may widen the value to a supertype.
import avin.threads.{Atomic, Future, Promise}

trait Animal: Sendable
  name() -> string

class Cat(): Animal
  override name() -> string = "cat"

class Dog(): Animal
  override name() -> string = "dog"

parse(text: string) -> Future[Result[int, string]] = Future
  text.toIntOption() match
    Some(n) -> Ok(n)
    None -> Err(s"not a number: $text")

main() -> int
  val good = parse("42").mapErr(e -> e.charCount)
  println(s"ok kept ${good.await()}")
  val bad = parse("x").mapErr(e -> e.charCount)
  println(s"err mapped ${bad.await()}")
  val through = parse("y").mapOk(n -> n * 2).flatMapOk(n -> parse("7")).mapErr(e -> s"[$e]")
  println(s"through ${through.await()}")
  val calls = Atomic(0)
  val first = parse("5").orElse
    calls.add(1)
    parse("6")
  println(s"first ${first.await()} fallback evaluated ${calls.load()}")
  val second = parse("z").orElse
    calls.add(1)
    parse("6")
  println(s"second ${second.await()} fallback evaluated ${calls.load()}")
  val both = parse("p").orElse(parse("q"))
  println(s"both fail ${both.await()}")
  val zero: Future[Result[int, string]] = Future.successful(Ok(0))
  val chain = parse("a").orElse(parse("b")).orElse(parse("c")).orElse(zero)
  println(s"chain ${chain.await()}")
  val notFound: Future[Result[int, int]] = Future.successful(Err(404))
  val retyped = parse("r").orElse(notFound)
  println(s"retyped ${retyped.await()}")
  val cat: Future[Result[Cat, string]] = Future.successful(Err("no cat"))
  val dog: Future[Result[Animal, string]] = Future(Ok(Dog()))
  val pet = cat.orElse(dog)
  println(s"widened ${pet.await().map(a -> a.name())}")
  val minusOne: Future[Result[int, int]] = Future.successful(Ok(-1))
  val recovered = parse("m").mapErr(e -> e.charCount).orElse(minusOne).mapOk(n -> n + 1)
  println(s"recovered ${recovered.await()}")
  // The first future is not complete when the fallback is chained: the fallback waits for it.
  val late = Promise[Result[int, string]]()
  val after = late.future.orElse(parse("9")).mapErr(e -> e.toUpper)
  println(s"pending ${after.isCompleted()}")
  late.complete(Err("late"))
  println(s"after ${after.await()}")
  0
