// Arrays compare and hash by their contents, element by element, and `===` compares their
// identities. An array displays as `[1, 2, 3]` and its diagnostic form shows each element's; it
// displays only when its elements do. Nested arrays compare and display element by element too.

class Token(val id: int)

describe(x: Any) -> string = x match
    d: Display -> "displays as " + d.toString()
    _ -> "does not display"

main()
    val a = Array.tabulate(3, i -> i + 1)
    val b = Array.fill(3, 0)
    b(0) = 1
    b(1) = 2
    b(2) = 3
    println(a)
    println(s"${a == b} ${a === b} ${a != b} ${a.hash() == b.hash()} ${a === a}")
    b(2) = 4
    println(s"${a == b} $b")
    println(Array.fill(2, 0) == Array.fill(3, 0))
    val nested = Array.tabulate(2, i -> Array.fill(i + 1, "x"))
    val other = Array.tabulate(2, i -> Array.fill(i + 1, "x"))
    println(s"$nested ${nested == other} ${nested.hash() == other.hash()}")
    println(debug(nested))
    a.display(StandardOutput, FormatSpec(width = 12))
    println("|")
    a.display(StandardOutput, FormatSpec(width = 12, left = true))
    println("|")
    val e: Array[int] = Array.empty()
    println(s"$e ${e == Array.empty[int]()}")
    val t = Token(1)
    println(s"${Array.fill(2, t) == Array.fill(2, t)} ${Array.fill(1, t) == Array.fill(1, Token(1))}")
    val x: Any = a
    val y: Any = Array.tabulate(3, i -> i + 1)
    println(x == y)
    println(describe(x))
    println(describe(Array.fill(1, t)))
    val words = Array.fill(2, "w")
    println(s"$words ${debug(words)} ${Array.fill(2, 'c')} ${Array.fill(1, 2.5)}")
