// expect: exit 0
// A pool makes a resource when one is asked for and none is idle, lends the idle one again after,
// and answers what the body returns. `lease` lets the body mark its resource broken, which the pool
// then destroys instead of lending it again; `stats` shows what the pool holds at each step.
import avin.threads.{Atomic, Pool, PoolStats}

class Conn(val id: int): Sendable

main()
  val made = Atomic(0)
  val destroyed = Atomic(0)
  val pool = Pool[Conn, string](
    () -> Ok(Conn(made.add(1))),
    maxSize = 2,
    destroy = Some(c -> _ = destroyed.add(1))
  )
  println(pool.stats())
  println(pool.use(c -> c.id * 10))
  println(pool.stats())
  println(pool.use(c -> c.id * 10))
  println(pool.use(c -> pool.use(d -> s"${c.id} ${d.id}")))
  println(pool.stats())
  println(pool.lease(l ->
    l.markBroken()
    l.resource.id))
  println(pool.stats())
  println(s"made ${made.load()} destroyed ${destroyed.load()}")
  println(pool.use(c -> c.id))
  pool.close()
  println(pool.stats())
  println(s"made ${made.load()} destroyed ${destroyed.load()} closed ${pool.isClosed()}")
  println(pool.use(c -> c.id))
