// expect: trap
// A trap after a million tail calls between two functions reports the place it happened, and the
// output written before it is flushed. A call into the core library in tail position reports the
// program's call that entered it.

ping(n: int, xs: Vector[int]) -> int = if n == 0 then pong(n, xs) else pong(n - 1, xs)

pong(n: int, xs: Vector[int]) -> int = if n == 0 then xs(3) else ping(n - 1, xs)

main() -> int
  println("before")
  ping(1000000, [1, 2])
