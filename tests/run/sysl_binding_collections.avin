// Arrays and vectors of boundary types cross to Sysl as copies. Into Sysl, a collection becomes a
// slice of its elements, each converted; out of Sysl, a slice or a `Buf` becomes a new vector or
// array. `sysl.hint.black_box` hands back the value it is given, so each binding of it carries a
// collection into Sysl and out again.

@sysl("sysl.text.split")
split(s: string, sep: string) -> Vector[string]

@sysl("sysl.text.split")
splitArray(s: string, sep: string) -> Array[string]

@sysl("sysl.path.join_all")
joinAll(parts: Vector[string]) -> string

@sysl("sysl.path.join_all")
joinArray(parts: Array[string]) -> string

@sysl("sysl.hint.black_box")
ints(v: Vector[int]) -> Vector[int]

@sysl("sysl.hint.black_box")
reals(a: Array[real]) -> Vector[real]

@sysl("sysl.hint.black_box")
longs(a: Array[long]) -> Array[long]

@sysl("sysl.hint.black_box")
narrow(v: Vector[i8]) -> Vector[i8]

@sysl("sysl.hint.black_box")
flags(v: Vector[bool]) -> Vector[bool]

@sysl("sysl.hint.black_box")
chars(v: Vector[char]) -> Vector[char]

@sysl("sysl.hint.black_box")
units(v: Vector[unit]) -> Vector[unit]

@sysl("sysl.hint.black_box")
bytes(v: Vector[byte]) -> Vector[byte]

@sysl("sysl.hint.black_box")
strings(v: Vector[string]) -> Vector[string]

@sysl("sysl.hint.black_box")
nested(v: Vector[Vector[string]]) -> Vector[Vector[string]]

@sysl("sysl.hint.black_box")
chunks(v: Vector[Array[byte]]) -> Vector[Array[byte]]

@sysl("sysl.hint.black_box")
maybe(o: Option[Vector[int]]) -> Option[Vector[int]]

@sysl("sysl.hint.black_box")
options(v: Vector[Option[string]]) -> Vector[Option[string]]

@sysl("sysl.hint.black_box")
result(r: Result[Vector[string], Vector[long]]) -> Result[Vector[string], Vector[long]]

// A mirror's field may be a collection: Sysl's cursor over a program's arguments holds a slice of
// them. A struct's mirror names its fields in lowerCamelCase, each matched to the Sysl field of the
// same words in snake_case.
@sysl("sysl.args.Scan")
data Scan
    Scan(argv: Vector[string], at: long, bundle: string, attached: Option[string], last: string, restArePositional: bool)

@sysl("sysl.hint.black_box")
sameScan(s: Scan) -> Scan

main()
    // Out of Sysl: a slice of strings, as a vector and as an array.
    println(split("a,b,,c", ","))
    println(splitArray("x y", " "))
    println(split("", ","))
    // Into Sysl: a vector and an array of strings.
    println(joinAll(["usr", "local", "bin"]))
    println(joinArray(Array.tabulate(3, i -> s"p$i")))
    println(joinAll(Vector.newBuilder[string]().result()))
    // Into Sysl and out again, an element type of each width.
    println(ints([1, -2, 2147483647]))
    println(reals(Array.tabulate(3, i -> real(i) / 4.0)))
    println(longs(Array.tabulate(2, i -> 9000000000 * long(i + 1))))
    println(narrow([-128, 0, 127]))
    println(flags([true, false, true]))
    println(chars(['a', 'λ', '😀']))
    println(units([(), ()]).length)
    println(bytes([byte(0), byte(0xff)]))
    println(strings(["wörld", "", "!"]))
    println(strings(Vector.newBuilder[string]().result()))
    println(ints(Vector.newBuilder[int]().result()).length)
    // Collections of collections, and of options.
    println(nested([["a", "b"], [], ["c"]]))
    println(chunks([Array.tabulate(2, i -> byte(i + 1)), Array.tabulate(0, i -> byte(i))]).map(a -> a.length))
    println(options([Some("x"), None]))
    // Collections inside an `Option` and a `Result`.
    println(s"${maybe(Some([4, 5]))} ${maybe(Some([]))} ${maybe(None)}")
    println(s"${result(Ok(["ok"]))} ${result(Err([7, 8]))}")
    // A collection inside a mirror of a Sysl struct.
    println(sameScan(Scan(["prog", "-v"], 1, "", Some("x"), "-o", false)))
    println(sameScan(Scan(["prog", "--", "f"], 2, "", None, "--", true)).restArePositional)
    // A large result survives the collections that making its strings causes.
    val many = split(Array.tabulate(10000, i -> s"item$i").mkString(","), ",")
    println(many.length)
    println(s"${many(0)} ${many(5000)} ${many(9999)}")
    var total = 0
    for s in many do total += s.byteLength()
    println(total)
    // A vector of many leaves goes into Sysl a leaf at a time, whichever end it grew at and wherever
    // it was cut, and comes out as a vector of the same elements.
    var grown: Vector[int] = []
    for i in 0 ..< 40000 do grown = grown :+ i
    var prepended: Vector[int] = []
    for i in 0 ..< 3000 do prepended = i +: prepended
    val cut = grown.slice(31, 33000)
    for v in [grown, prepended, cut, grown.take(1), grown.drop(39968)]
        val back = ints(v)
        println(s"${back.length} ${back == v} ${back.sum}")
    println(nested([grown.take(40).map(i -> s"$i"), prepended.takeRight(2).map(i -> s"$i")]).map(v -> v.length))
