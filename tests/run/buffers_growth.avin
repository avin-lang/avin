// expect: exit 0
// env: AVIN_GC_STRESS=0
// A buffer of a million elements, of values and of references, grows by replacing its array, and
// every element survives the collections that its growth and its strings set off. The collector
// runs as it ordinarily does, when the heap's budget is spent, since collecting at each of a million
// allocations would take hours; `buffers.avin` runs a buffer under the stressed collector.

class Cell(val n: int)

main()
    val ints = Buffer[int]()
    for i in 0 ..< 1000000 do ints.add(i)
    var sum = long(0)
    for x in ints do sum += long(x)
    print(s"${ints.length()} ${ints(999999)} $sum")

    val cells = Buffer[Cell]()
    for i in 0 ..< 1000000 do cells.add(Cell(i))
    var ok = true
    for i in 0 ..< cells.length()
        if cells(i).n != i then ok = false
    print(s"${cells.length()} $ok")

    val words = Buffer[string]()
    for i in 0 ..< 100000 do words.add(s"w$i")
    while words.length() > 10 do words.remove(words.length() - 1)
    print(s"${words.length()} ${words(9)}")
    words.clear()
    for i in 0 ..< 1000 do words.add(s"again$i")
    print(s"${words(999)}")
