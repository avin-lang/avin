// expect: exit 0
// More of constructor traits: `self` is a `Self[A]`, passed where the trait takes one; a trait of two
// parameters is implemented with two holes and bounds an `F[_, _]`; a bounded parameter of the
// trait is the bound of the hole it stands for, `F[_: Sendable]`; an impl bounding an argument it
// writes out conforms where that argument meets the bound; and a method an impl writes is the
// type's own, called on the type as any of its methods is.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]
  itself() -> Self[A] = self
  either(other: Self[A], first: bool) -> Self[A] = if first then self else other

trait Bimappable[A, B]
  bimap[C, D](f: (A) -> C, g: (B) -> D) -> Self[C, D]
  firstOnly[C](f: (A) -> C) -> Self[C, B] = bimap(f, b -> b)

trait Shipping[A: Sendable]
  ship[B: Sendable](f: @sendable (A) -> B) -> Self[B]

data Duo[L, R](left: L, right: R)

impl Bimappable for Duo
  bimap[C, D](f: (L) -> C, g: (R) -> D) -> Duo[C, D] = Duo(f(left), g(right))

data Parcel[T: Sendable](item: T)

impl Shipping for Parcel
  ship[B: Sendable](f: @sendable (T) -> B) -> Parcel[B] = Parcel(f(item))

data Report[T, E](value: T, note: E)

impl[T, E: Display] Mappable[T] for Report[T, E]
  map[B](f: (T) -> B) -> Report[B, E] = Report(f(value), note)

data Box[T](value: T)

impl Mappable for Box
  map[B](f: (T) -> B) -> Box[B] = Box(f(value))

swapped[F[_, _]: Bimappable](x: F[int, string]) -> F[string, int] = x.bimap(n -> s"$n", s -> s.charCount)

send[F[_: Sendable]: Shipping](x: F[int]) -> F[string] = x.ship(n -> s"#$n")

chosen[F[_]: Mappable](x: F[int], y: F[int]) -> (F[int], F[int]) = (x.itself(), x.either(y, false))

noted[F[_]: Mappable](x: F[int]) -> F[bool] = x.map(n -> n % 2 == 0)

main()
  println(swapped[Duo](Duo(1, "abc")))
  println(Duo(7, 'q').firstOnly(n -> n * 5))
  println(send[Parcel](Parcel(4)).item)
  println(chosen[Box](Box(1), Box(2)))
  println(noted[Report[_, string]](Report(3, "odd")))
  println(noted[Report[_, int]](Report(4, 0)))
  println(Box(9).map(n -> n - 1).value)
  println(Box("é✓").itself().value)
