// expect: exit 0
// A `StringWriter` reports its `length()` in bytes, whether it `isEmpty()`, and can be `clear()`ed
// and written to again.

main()
    val w = StringWriter()
    println(s"${w.length()} ${w.isEmpty()} [${w.text()}]")
    w.write("")
    println(w.isEmpty())
    w.write("abc")
    println(s"${w.length()} ${w.isEmpty()} ${w.text()}")
    w.writeChar('d')
    w.writeInt(-45)
    println(s"${w.length()} ${w.text()}")

    // Characters of two, three and four bytes count every byte.
    val u = StringWriter()
    u.write("é")
    println(u.length())
    u.write("€")
    println(u.length())
    u.writeChar('😀')
    println(u.length())
    u.write("日本語")
    println(s"${u.length()} ${u.text().bytes().length()}")
    u.writeChar('é')
    println(u.length())

    // clear
    u.clear()
    println(s"${u.length()} ${u.isEmpty()} [${u.text()}]")
    u.write("x")
    println(s"${u.length()} ${u.text()}")
    u.clear()
    u.clear()
    println(u.isEmpty())

    // A text taken before a clear is not changed by it, or by later writes.
    val v = StringWriter()
    v.write("first")
    val taken = v.text()
    v.clear()
    v.write("second")
    println(s"$taken ${v.text()} ${v.length()}")

    // Past the first growth, and again after a clear.
    val big = StringWriter()
    for i in 0 ..< 1000 do big.write("0123456789")
    println(big.length())
    big.clear()
    for i in 0 ..< 100 do big.write("é")
    println(s"${big.length()} ${big.text().bytes().length()}")

    // Used as a Writer, a field and a displayed value reach the same length.
    val out = StringWriter()
    out.writeField("ab", FormatSpec(width = 5))
    println(s"${out.length()} [${out.text()}]")
    out.clear()
    (123).display(out, FormatSpec())
    println(s"${out.length()} ${out.text()}")
