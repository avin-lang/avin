// expect: exit 0
// A machine is declared like a class, so it may be generic: its type parameters are its `State`
// type's too, so a state may hold values of them, and each instance is a machine of its own type.
data Slot[T]
  Put(value: T)
  Take
  Peek

machine Cell[T: Display](fallback: T) receives Slot[T]
  var taken = Vector[T]()

  state Vacant
    Put(v) -> Full(v)
    Take ->
      taken = taken :+ fallback
      stay
    Peek -> stay

  state Full(value: T)
    enter
      println(s"holding $value")
    Put(v) -> Full(v)
    Take ->
      taken = taken :+ value
      Vacant
    Peek -> stay

  current() -> Option[T] = state() match
    Full(v) -> Some(v)
    Vacant -> None

main() -> int
  val ints = Cell(0)
  ints.handle(Take)
  ints.handle(Put(5))
  ints.handle(Put(6))
  println(ints.current())
  ints.handle(Take)
  println(ints.taken)
  println(ints.state())
  val words = Cell[string]("none")
  words.handle(Put("ü"))
  val s: Cell.State[string] = words.handle(Peek)
  println(s)
  words.handle(Take)
  words.handle(Take)
  println(words.taken)
  println(words.current())
  0
