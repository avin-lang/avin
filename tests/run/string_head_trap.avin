// expect: trap
// A string's `head` and `last` are its end characters, and the empty string's `head` traps at the
// program's call; `headOption` answers None for it instead.

main()
    val word = "émoji😀"
    println(s"${word.head()} ${word.last()} ${word.headOption()} ${"".lastOption()}")
    println("".head())
