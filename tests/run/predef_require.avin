// expect: exit 0
// `require` that holds lets the program carry on and never evaluates its message; `todo` stands where
// a value of any type is expected and is not reached on a path that is not taken.

var built = 0

message(text: string) -> string
    built += 1
    text

positive(n: int) -> int
    require(n > 0, message(s"$n is positive"))
    n

data Shape
    Circle(r: int)
    Square(side: int)

area(s: Shape) -> int = s match
    Circle(r) -> r * r * 3
    Square(_) -> todo("the area of a square")

main()
    require(true)
    require(1 < 2 < 3)
    require(true, "never shown")
    require(true, message("never built"))
    println(built)
    println(positive(1), positive(2147483647))
    println(built)
    // The message is a by-name argument: a lambda's capture is read when it would be built.
    var limit = 10
    val check = (n: int) -> require(n <= limit, s"$n is at most $limit")
    check(10)
    limit = 0
    check(0)
    check(-2147483648)
    // Over generic instances and in a loop under allocation.
    for i in 0..<2000
        require(s"item $i".charCount() > 0, message("unused"))
    println(built)
    println(area(Circle(2)))
    // `todo()` is `Nothing`, so it is a branch of any type.
    val text: string = if built > 0 then todo() else "fine"
    val number: long = if built == 0 then 9223372036854775807 else todo("a long")
    val shape: Shape = if false then todo() else Circle(1)
    println(text, number, area(shape))
