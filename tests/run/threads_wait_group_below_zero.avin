// expect: trap
// A wait group's count never falls below zero: a `done` with nothing counted means a piece of work was
// finished twice or never added, so it traps, and the count is left as it was.
import avin.threads.WaitGroup

main()
  val g = WaitGroup()
  g.add(2)
  g.done()
  g.done()
  println(s"at zero ${g.pending()}")
  g.done()
  println("after")
