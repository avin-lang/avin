// expect: exit 0
// A data value held in a local that a local function reads and replaces, in a generic function
// instantiated at two types.

data Option[+T]
    Some(value: T)
    None

latest[T](values: Option[T], fallback: T) -> T
    var current: Option[T] = None
    remember(o: Option[T])
        current = o
    remember(values)
    current match
        Some(v) -> v
        None -> fallback

main() -> int
    if latest(Some(4), 0) != 4 then return 1
    if latest(None, 'z') != 'z' then return 2
    print(latest(Some("x"), "y"))
    0
