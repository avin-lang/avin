// expect: exit 0
// A comprehension over futures is their `flatMap` and `map`: each generator's future is waited for by
// the steps, not by the caller, and the result is a future of the yielded value. A later generator
// may use an earlier one's value.
import avin.threads.Future

price(item: string) -> int = item.charCount() * 3

main() -> int
    val sum = for x in Future.apply(3), y in Future.apply(4) yield x + y
    print(s"sum ${sum.await()}")
    val quote = for
        item in Future.apply("lantern")
        cost in Future.apply(price(item))
        tax in Future.successful(cost / 10)
    yield s"$item costs ${cost + tax}"
    print(quote.await())
    0
