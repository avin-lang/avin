// expect: trap
// A lambda the initializer makes and hands to a function that calls it before returning: the
// compile-time rule does not follow it, so its read of the value runs while the initializer is
// still running, and the read traps there, naming the value, rather than wait for itself.
apply(f: () -> int) -> int = f()

lazy val handed: int = apply(() -> handed + 1)

main() -> int
  println("before")
  println(handed)
  println("after")
  0
