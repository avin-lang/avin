// expect: exit 0
// A conformance to a trait whose members are all static is no variance position of the conforming
// type, and neither is a class's static member: a covariant abstract class, a covariant final class
// and a covariant data type each implement `Make[T]`, a trait whose one member is static and takes a
// `T`. A call on the type runs the type's own static at the arguments it names, and a call through a
// bound runs the type argument's own, at its own arguments, after the value made is seen at a wider
// type.

trait Make[A]
  static make(x: A) -> Self

// A trait whose members are all static, requiring another such trait.
trait MakeTwo[A]: Make[A]
  static two(x: A, y: A) -> Self

open class Animal(val name: string)
class Cat(): Animal("cat")
class Dog(): Animal("dog")

abstract class Box[+T]
  item -> T

class Full[+T](val value: T): Box[T]
  override item -> T = value

impl[T] Make[T] for Box[T]
  static make(x: T) -> Box[T] = Full(x)

class Pair[+T](val first: T, val second: T)

impl[T] MakeTwo[T] for Pair[T]
  static make(x: T) -> Pair[T] = Pair(x, x)
  static two(x: T, y: T) -> Pair[T] = Pair(x, y)

data Opt[+T]
  Some1(value: T)
  None1

impl[T] Make[T] for Opt[T]
  static make(x: T) -> Opt[T] = Some1(x)

// A contravariant class: its static takes a `T` and yields one, which is no position either.
class Sink[-T](val seen: (T) -> string)

impl[T] Make[T] for Sink[T]
  static make(x: T) -> Sink[T] = Sink(y -> "sink")

build[C: Make[A], A](x: A) -> C = C.make(x)

buildTwo[C: MakeTwo[A], A](x: A, y: A) -> C = C.two(x, y)

// Through two bounds, the argument's own impl is the one called.
twice[C: Make[A], A](x: A) -> (C, C) = (build[C, A](x), C.make(x))

optName(o: Opt[Animal]) -> string = o match
  Some1(a) -> a.name
  None1 -> "none"

main()
  // On the type, at the arguments it names.
  println(Box[int].make(1).item)
  println(Box[Cat].make(Cat()).item.name)
  println(Pair[string].two("a", "b").second)
  println(optName(Opt[Dog].make(Dog())))
  // Through a bound, the type argument's own.
  val cats: Box[Animal] = build[Box[Cat], Cat](Cat())
  println(cats.item.name)
  val dogs: Pair[Animal] = buildTwo[Pair[Dog], Dog](Dog(), Dog())
  println(dogs.first.name + " " + dogs.second.name)
  val same: Pair[Animal] = build[Pair[Cat], Cat](Cat())
  println(same.second.name)
  println(optName(build[Opt[Cat], Cat](Cat())))
  val animals = build[Box[Animal], Animal](Dog())
  println(animals.item.name)
  // Nested and generic arguments.
  val nested = build[Box[Box[string]], Box[string]](Box[string].make("deep"))
  println(nested.item.item)
  val ps = twice[Pair[int], int](7)
  println(ps.0.first + ps.1.second)
  // Seen at a wider type afterwards, the value is what it was made.
  val wide: Box[Any] = build[Box[string], string]("wide")
  println(wide.item)
  val sink: Sink[Cat] = build[Sink[Animal], Animal](Dog())
  println(sink.seen(Cat()))
  // Boundary values.
  println(Box[long].make(9223372036854775807).item)
  println(Box[string].make("").item.isEmpty)
  println(Box[string].make("héllo ✓").item)
