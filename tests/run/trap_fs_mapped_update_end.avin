// expect: trap
// Writing at a writable mapping's length traps, and the file keeps its length and bytes.
import avin.fs

main()
  val dir = fs.createTempDir("avin-mapped-trap").toOption.get
  _ = fs.writeText(dir + "/a", "abc")
  val m = fs.mapFileMutable(dir + "/a").toOption.get
  _ = fs.removeDirAll(dir)
  m(2) = byte(int('C'))
  println(m(2))
  m(3) = byte(int('D'))
