// expect: trap
// A handle's bound method called after `close()` has given its Sysl value back stops the program at
// the call, naming the handle's class. A method with a body runs as long as it reaches no bound one.

@sysl("sysl.checksum.Crc32")
class Crc32
  finish() -> long
  label() -> string = "a checksum"

@sysl("sysl.checksum.new_crc32")
newCrc32() -> Crc32

main()
  val c = newCrc32()
  println(c.finish())
  c.close()
  println(c.label())
  println(c.finish())
