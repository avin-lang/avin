// expect: exit 0
// Methods defined by clauses, recursive methods, methods that return lambdas capturing `self`,
// local functions inside methods, and how names resolve inside a class: a parameter or a local
// hides a field of the same name, which `self` still reaches, and a method hides a top-level
// function of the same name.

data Shape
    Circle(r: int)
    Square(side: int)

describe() -> string = "top-level describe"

class Counter(var count: int, step: int)
    // Defined by clauses over its argument; the receiver is not matched.
    classify(n: int) -> string
    classify(0) = "zero"
    classify(n)
        | n < 0 = "negative"
        | _ = s"positive $n"

    factorial(n: int) -> long = if n <= 1 then 1 else long(n) * factorial(n - 1)

    even(n: int) -> bool = if n == 0 then true else self.odd(n - 1)
    odd(n: int) -> bool = if n == 0 then false else even(n - 1)

    // The lambda captures `self` and sees later changes to the field.
    reader() -> () -> int = () -> count
    adder() -> (int) -> unit = (n) -> count += n * step

    // A parameter named like a field hides it; `self.count` is the field.
    reset(count: int)
        self.count = count

    // A local named like a field hides it too.
    shadow() -> int
        val step = 100
        step + self.step

    twice() -> int
        helper(x: int) -> int = x + count
        helper(helper(0))

    describe() -> string = s"counter at $count"
    label() -> string = describe()

    area(s: Shape) -> int = s match
        Circle(r) -> 3 * r * r
        Square(side) -> side * side

main() -> int
    val c = Counter(1, 2)
    print(c.classify(0))
    print(c.classify(-4))
    print(c.classify(9))
    if c.factorial(20) != 2432902008176640000 then return 1
    if !c.even(10) || c.odd(10) then return 2
    val read = c.reader()
    val add = c.adder()
    add(5)
    if read() != 11 || c.count != 11 then return 3
    c.reset(4)
    if read() != 4 then return 4
    if c.shadow() != 102 then return 5
    if c.twice() != 8 then return 6
    print(c.describe())
    print(describe())
    if c.area(Circle(2)) != 12 || c.area(Square(3)) != 9 then return 7
    if c.label() != "counter at 4" then return 8
    0
