// expect: exit 0
// Eight threads add to an `Atomic[int]` and subtract from an `Atomic[long]` a hundred thousand times
// each, add to an `Atomic[i128]`, which is wider than a word, and raise an `Atomic[int]` maximum with a
// compare-and-set loop: every total is exact. Then the
// single operations on a bool, a byte-wide integer, a real and a 128-bit integer.
import avin.threads.{Atomic, scope}

main() -> int
    val count = Atomic(0)
    val debt = Atomic(long(0))
    val highest = Atomic(-1)
    val big = Atomic(i128(1) << 80)
    scope(s ->
        for t in 0..<8
            s.spawn(() ->
                for i in 0..<100000
                    count.add(1)
                    debt.sub(long(3))
                    big.add(i128(1))
                    val mine = t * 100000 + i
                    var seen = highest.load()
                    while seen < mine && !highest.compareAndSet(seen, mine)
                        seen = highest.load()))
    print(count.load())
    print(debt.load())
    print(highest.load())
    print(big.load() - (i128(1) << 80))
    print(count.update(x -> x / 2))
    val flag = Atomic(false)
    print(flag.compareAndSet(false, true))
    print(flag.compareAndSet(false, true))
    print(flag.swap(false))
    print(flag.load())
    val small = Atomic(i5(3))
    print(small.add(i5(4)))
    print(small.swap(i5(-2)))
    print(small.load())
    val r = Atomic(0.5)
    print(r.compareAndSet(0.5, 1.25))
    print(r.compareAndSet(0.5, 2.0))
    print(r.load())
    val wide = Atomic(i128(1) << 100)
    print(wide.add(i128(1)))
    print(wide.compareAndSet(i128(1), i128(2)))
    print(wide.compareAndSet((i128(1) << 100) + i128(1), i128(2)))
    print(wide.swap(i128(9)))
    print(wide.load())
    0
