// expect: exit 0
// Placeholder lambdas meeting their neighbours: generic functions, overloads, by-name parameters,
// named arguments, declared values, closures that outlive their frame, and many lambdas made in a
// loop.

mapAll[A, B](xs: Vector[A], f: (A) -> B) -> Vector[B] = xs.map(f)

combine[T](a: T, b: T, f: (T, T) -> T) -> T = f(a, b)

pick(f: (int) -> int) -> string = s"one: ${f(10)}"
pick(f: (int, int) -> int) -> string = s"two: ${f(10, 3)}"
pick(f: (int, int, int) -> int) -> string = s"three: ${f(1, 2, 3)}"

lazily(f: -> (int) -> int) -> int = f(5) + f(6)

named(scale: int, by: (int) -> int) -> int = by(scale)

adderOf(n: int) -> (int) -> int = x -> x + n

makeAll(n: int) -> Vector[(int) -> int]
    var out: Vector[(int) -> int] = []
    for i in 0..<n
        val step = i
        out = out :+ adderOf(step)
    out

class Box[T](val item: T)
    map[U](f: (T) -> U) -> Box[U] = Box(f(item))

main() -> int
    // Generic: the parameter's type comes from the instance.
    println(mapAll([1, 2, 3], _ * 10))
    println(mapAll(["a", "b"], _ + "?"))
    println(combine(2, 5, _ * _))
    println(combine("ab", "cd", _ + _))
    println(Box(7).map(_ + 1).map(_.toString()).item)
    println(Box(Some(3)).map(_.isDefined).item)
    // Overloads: the number of `_` picks the overload, as a lambda's parameter count does.
    println(pick(_ + 1))
    println(pick(_ - _))
    println(pick(_ + _ * _))
    // By-name: the delayed argument is the function itself.
    println(lazily(_ * 2))
    // A named argument.
    println(named(by = _ + 1, scale = 4))
    // A declared value's type gives the parameters.
    val inc: (int) -> int = _ + 1
    val both: (int, string) -> string = _.toString() + _
    var swap: (string) -> string = _ + "!"
    println(inc(41))
    println(both(1, "a"))
    println(swap("hi"))
    swap = s -> s + "?"
    println(swap("hi"))
    // A placeholder lambda in a lambda's body belongs to the call it is an argument of.
    val rows = [[1, 2], [3]]
    println(rows.map(r -> r.map(_ * 2)))
    println(rows.map(_.map(_ + 1).foldLeft(0, _ + _)))
    // Deep nesting: each `_` binds at its own argument.
    println(rows.map(_.map(x -> [x, x].map(_ * x))))
    // Closures over a local, outliving the function that made them, at many instances.
    var total = 0
    for f in makeAll(200)
        total += [1].map(f(_) + 0)(0)
    println(total)
    var made: Vector[(int) -> int] = []
    for i in 0..<500
        val k = i
        val f: (int) -> int = _ * k
        made = made :+ f
    var sum = 0
    for f in made
        sum += f(2)
    println(sum)
    0
