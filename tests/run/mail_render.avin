// expect: exit 0
// Whole messages as `avin.net.mail` writes them, each with a fixed date, ID and boundary: a plain
// one, one with a name to encode and folded recipients, text and HTML as alternatives, an
// attachment with a Unicode filename, an inline image beside HTML, and all of them together. Every
// line is checked to end in CR LF and to be at most 998 characters, then printed with its CR LF as a
// line break.
import avin.net.mail.{Attachment, Mailbox, Message}
import avin.time.epochSeconds

show(title: string, m: Message)
  println(s"== $title")
  m.render() match
    Ok(text) ->
      for line in text.split("\r\n")
        if line.contains("\r") || line.contains("\n") then println("!! a lone line break")
        if line.byteLength > 998 then println("!! a line longer than 998")
      if text.nonEmpty && !text.endsWith("\r\n") then println("(no line break at the end)")
      print(text.replace("\r\n", "\n"))
      if !text.endsWith("\r\n") then println("")
    Err(e) -> println(s"error: ${e.message}")

main()
  val at = Some(epochSeconds(1700000000))
  val ada = Mailbox("ada@example.com", "Ada Lovelace")
  val bob = Mailbox("bob@example.com")
  show(
    "plain",
    Message(
      ada,
      to = [bob],
      subject = "Hello",
      text = Some("Hi Bob,\nSee you soon.\n"),
      date = at,
      messageId = Some("1@example.com")
    )
  )
  show(
    "names and folding",
    Message(
      Mailbox("eloise@example.com", "Éloise Dupré"),
      to = [
        Mailbox("a@example.com", "Smith, Anne"),
        Mailbox("b@example.com", "Bé"),
        Mailbox("charles.babbage@example.com", "Charles Babbage")
      ],
      cc = [Mailbox("c@example.com")],
      bcc = [Mailbox("secret@example.com")],
      replyTo = [Mailbox("replies@example.com")],
      subject = "Réunion à 15 h — ordre du jour",
      text = Some("Bonjour à tous,\nla réunion est déplacée.\n"),
      headers = [("X-Mailer", "avin"), ("X-Priority", "3")],
      date = at,
      messageId = Some("2@example.com")
    )
  )
  show(
    "alternative",
    Message(
      ada,
      to = [bob],
      subject = "Both",
      text = Some("Plain words.\n"),
      html = Some("<p>Rich <b>words</b>.</p>\n"),
      date = at,
      messageId = Some("3@example.com"),
      boundary = Some("b")
    )
  )
  show(
    "attachment",
    Message(
      ada,
      to = [bob],
      subject = "Report",
      text = Some("Attached.\n"),
      attachments = [Attachment("résumé.txt", "text/plain; charset=utf-8", "Grüße\n".bytes)],
      date = at,
      messageId = Some("4@example.com"),
      boundary = Some("b")
    )
  )
  show(
    "inline image",
    Message(
      ada,
      to = [bob],
      html = Some("<img src=\"cid:logo\">\n"),
      attachments = [
        Attachment(
          "logo.png",
          "image/png",
          Vector[byte](byte(137), byte(80), byte(78), byte(71)),
          inline = true,
          contentId = "logo"
        )
      ],
      date = at,
      messageId = Some("5@example.com"),
      boundary = Some("b")
    )
  )
  show(
    "everything",
    Message(
      ada,
      to = [bob],
      subject = "All",
      text = Some("t\n"),
      html = Some("<p>h</p>\n"),
      attachments = [
        Attachment("a.bin", "application/octet-stream", Vector.tabulate(60, i -> byte(i))),
        Attachment("logo.png", "image/png", Vector[byte](byte(1)), inline = true, contentId = "logo")
      ],
      date = at,
      messageId = Some("6@example.com"),
      boundary = Some("b")
    )
  )
  show("a line break in the subject", Message(ada, to = [bob], subject = "Hi\r\nBcc: evil@example.com", date = at))
