// expect: exit 0
// A thread that completes a promise runs what other threads registered to wait for it, and its
// cancellation does not cut that short: a chain of 300 futures, each `Future.first` of the one
// before, which the completing thread resolves link by link, resolves every time, though that thread
// is cancelled while it is resolving the chain.
// The completing thread itself stops at its next cancellation point after, so nothing after its sleep
// runs. A cancelled thread waiting for a future does not stop the future's own work, which still
// completes it.
import avin.threads.{Atomic, Future, Promise, scope, sleep}
import avin.time.{hours, millis}

main() -> int
  val after = Atomic(0)
  var resolved = 0
  for _ in 0 ..< 20
    val p = Promise[int]()
    var chain = p.future
    for _ in 0 ..< 300
      chain = Future.first([chain])
    // The cancellation comes once the promise is seen complete, so the thread is resolving the
    // chain or past it; cancelling it before it completes the promise would leave the chain
    // unresolved by design.
    scope(s ->
      s.spawn(() ->
        p.complete(7)
        sleep(hours(1))
        after.add(1))
      while !p.isCompleted() do sleep(millis(0))
      s.cancel())
    if chain.await(millis(30000)) == Some(7) then resolved += 1
  println(resolved)
  println(after.load())
  // The work of a future a cancelled thread waits for still completes it.
  val gate = Promise[int]()
  val work = Future(gate.future.await() * 2)
  scope(s ->
    s.spawn(() -> work.await())
    sleep(millis(5))
    s.cancel())
  gate.complete(21)
  println(work.await())
  0
