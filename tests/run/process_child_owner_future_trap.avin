// expect: trap
// A sequence handed to a future's body is the body's while it runs, its later part not yet started:
// the code that handed it over traps at `waitFor`, before it could start that part itself.
import avin.io.IoError
import avin.process.{Child, Command}
import avin.threads.{Channel, Future}

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

main()
  val child = ok((Command("/bin/sleep", "0.2") andThen Command("/bin/sh", "-c", "exit 3")).start())
  val go = Channel[int]()
  val f = Future
    go.receive()
    child.waitFor()
  println("handed over")
  _ = child.waitFor()
  println("not reached")
  go.send(1)
  println(f.await())
