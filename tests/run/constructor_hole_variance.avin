// expect: exit 0
// A hole's variance: inside a declaration with `F[+_]`, an `F[Dog]` is an `F[Animal]`, and with
// `F[-_]` an `F[Animal]` is an `F[Dog]`; a variant type parameter may sit in `F[A]` where the hole
// keeps its position. Each constructor passed, written or inferred, is covariant (or contravariant)
// at that argument: `Option`, `Vector`, a partial application, another constructor parameter
// declaring the same variance.
open class Animal(val name: string)

class Dog(name: string): Animal(name)

class Cat(name: string): Animal(name)

widen[F[+_]](d: F[Dog]) -> F[Animal] = d

widenLocal[F[+_]](d: F[Dog]) -> F[Animal]
  val a: F[Animal] = d
  var b: F[Animal] = a
  b = d
  b

later[F[+_]](d: F[Dog]) -> () -> F[Animal] = () -> d

relay[G[+_]](d: G[Dog]) -> G[Animal] = widen(d)

relayWritten[G[+_]](d: G[Dog]) -> G[Animal] = widen[G](d)

class Sink[-A](val label: string)
  take(a: A) -> string = label

narrow[F[-_]](s: F[Animal]) -> F[Dog] = s

class Holder[+A, F[+_]](val held: F[A])

class Feeder[-A, F[-_]](val feed: F[A])

both[F[_], A](x: F[A], y: F[A]) -> F[A] = y

names(xs: Option[Animal]) -> string = xs.map(a -> a.name).getOrElse("none")

main()
  println(names(widen(Some(Dog("rex")))))
  println(widen([Dog("a"), Dog("b")]).map(a -> a.name))
  println(names(widenLocal(Some(Dog("local")))))
  println(names(later(Some(Dog("later")))()))
  println(names(relay(Some(Dog("relayed")))))
  println(names(relayWritten(Some(Dog("written")))))
  val r: Result[Dog, string] = Ok(Dog("ok"))
  println(widen[Result[_, string]](r).map(a -> a.name))
  val e: Either[string, Dog] = Right(Dog("right"))
  println(widen[Either[string, _]](e).map(a -> a.name))
  println(names(widen(None)))
  println(narrow(Sink[Animal]("sink")).take(Dog("d")))
  val h: Holder[Animal, Option] = Holder[Dog, Option](Some(Dog("held")))
  println(names(h.held))
  val f: Feeder[Dog, Sink] = Feeder[Animal, Sink](Sink[Animal]("fed"))
  println(f.feed.take(Dog("x")))
  val mixed: Option[Animal] = both(Some(Dog("d")), Some(Cat("c")))
  println(names(mixed))
  val joined = both(Some(Dog("dog")), Some(Cat("cat")))
  println(names(joined))
