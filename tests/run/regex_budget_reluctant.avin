// expect: trap
// A reluctant repetition of a repetition backtracks exponentially when the rest of the pattern
// cannot match; the attempt spends its step budget and traps, naming the pattern and the input's
// length.
import avin.regex.Regex

main()
    println(Regex("(a+)+?$").findFirstIn("aaaab"))
    println(Regex("(a+)+?$").findFirstIn("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab"))
