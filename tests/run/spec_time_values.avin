// expect: exit 0
// `avin.time`'s values in other features: `max`, `min` and sorting over durations, readings of
// either clock ordered and compared, durations in options and collections; negative durations
// divided and converted toward zero; and the display's largest unit being seconds.
import avin.time
import avin.time.{Duration, microseconds, milliseconds, seconds, minutes, hours, zero, fromEpoch}

main()
    println(max(seconds(1), milliseconds(1500)))
    println(min(seconds(-1), zero()))
    println([seconds(3), microseconds(1), minutes(-1), zero()].sorted())
    println(milliseconds(-7) / 2)
    println(microseconds(-1500).inMilliseconds())
    println(microseconds(-1999999).inSeconds())
    println(seconds(-90).inMinutes())
    println(microseconds(-1).abs())
    println(zero().isNegative())
    println(hours(25))
    println(minutes(90))
    println(microseconds(1001))
    println(microseconds(-1))
    val a = fromEpoch(seconds(1))
    val b = fromEpoch(seconds(2))
    println(s"${a < b} ${max(a, b) == b} ${a.since(b)} ${b - a}")
    val i = time.now()
    val j = i + seconds(1)
    println(s"${i < j} ${max(i, j) == j} ${j - i} ${(j - seconds(1)) == i}")
    println(Some(seconds(1)) == Some(milliseconds(1000)))
    println([microseconds(5), milliseconds(1)].map(d -> d * 2))
