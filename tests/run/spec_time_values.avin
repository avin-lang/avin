// expect: exit 0
// `avin.time`'s values in other features: `max`, `min` and sorting; `TreeMap` and `HashMap` keys and
// `Set` members; a generic function bounded by `Ord`; fields of a data type and a class; captured by a
// closure; sent through a `Channel` to another thread and asked of an actor; in options and
// collections; in `s"…"` and `f"…"` with a width.
import avin.actors.{ActorRef, spawn}
import avin.threads.{Channel, spawn as thread}
import avin.time
import avin.time.{Duration, Instant, micros, millis, seconds, minutes, hours, epochSeconds}

data Event(name: string, at: Instant, took: Duration)

class Log(val first: Instant, var total: Duration)
    record(e: Event) = total = total + e.took

// The least of a non-empty vector, for any ordered type.
least[T: Ord](items: Vector[T]) -> T
    var best = items(0)
    for x in items do if x < best then best = x
    best

data Ask
    Later(than: Instant, by: Duration, reply: ActorRef[Instant])

actor Clock receives Ask
    receive
        Later(t, d, reply) -> reply.tell(t + d)

main()
    println(max(seconds(1), millis(1500)))
    println(min(seconds(-1), Duration.Zero))
    println([seconds(3), micros(1), minutes(-1), Duration.Zero].sorted())
    println(max(epochSeconds(1), Instant.Epoch))
    println([epochSeconds(5), Instant.Max, Instant.Min, Instant.Epoch].sorted())

    // Map keys and set members, ordered and hashed.
    val tree = TreeMap((seconds(2), "two"), (millis(1), "milli"), (seconds(-1), "minus"), (millis(2000), "again"))
    println(tree)
    val stamps = TreeMap((epochSeconds(60), "b"), (Instant.Epoch, "a"), (epochSeconds(-60), "z"))
    println(stamps.keys().toVector())
    val hashed = HashMap((seconds(1), 1), (millis(1000), 2), (hours(1), 3))
    println(s"${hashed.size()} ${hashed.get(micros(1000000))} ${hashed.get(hours(1))} ${hashed.get(minutes(1))}")
    val instants = HashMap((epochSeconds(1), "one"), (Instant(1000000), "same"))
    println(s"${instants.size()} ${instants.get(epochSeconds(1))}")
    println(Set(seconds(1), millis(1000), micros(1)).size())

    // Generic code.
    println(least(Vector(seconds(3), millis(-2), hours(1))))
    println(least(Vector(epochSeconds(3), Instant.Epoch, epochSeconds(9))))

    // Fields of a data type and a class.
    val e = Event("boot", epochSeconds(10), millis(250))
    println(e)
    println(e == Event("boot", epochSeconds(10), micros(250000)))
    val log = Log(e.at, Duration.Zero)
    log.record(e)
    log.record(Event("run", e.at + seconds(1), seconds(2)))
    println(s"${log.first} ${log.total}")

    // Captured by a closure.
    val start = epochSeconds(100)
    val after = (d: Duration) -> start + d
    println(Vector(seconds(1), minutes(1)).map(after))
    val step = minutes(1)
    println((1..3).map(i -> step * long(i)).toVector())

    // Through a channel to another thread, and asked of an actor.
    val ch = Channel[(Instant, Duration)](4)
    val worker = thread(() ->
        var sum = Duration.Zero
        for (t, d) in ch do sum = sum + d + (t - Instant.Epoch)
        sum)
    ch.send((epochSeconds(1), seconds(1)))
    ch.send((epochSeconds(2), millis(500)))
    ch.close()
    println(worker.join())
    val clock = spawn(Clock())
    println(clock.ask(r -> Later(Instant.Epoch, hours(2), r), seconds(10)).await())

    // Options, collections and text.
    println(Some(seconds(1)) == Some(millis(1000)))
    println([micros(5), millis(1)].map(d -> d * 2))
    println(Some(Instant.Epoch))
    println(s"took ${seconds(90)} at ${epochSeconds(0)}")
    println(f"[${seconds(1)}%6s] [${Instant.Epoch}%-22s] [${micros(3)}%-5s]")
    println(time.Duration.Zero == Duration.Zero)
