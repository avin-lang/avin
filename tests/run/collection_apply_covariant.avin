// expect: exit 0
// An empty `Vector()`, `List()`, `Queue()`, `ArraySeq()` and `LazyList()` with no type to infer from
// is a collection of `Nothing`, the least type, as `[]` is; it is then any collection of its kind,
// and each empty `apply` takes its type from an expected type or from written type arguments too.

len(xs: Vector[int]) -> int = xs.length

main()
  val v = Vector()
  val l = List()
  val q = Queue()
  val a = ArraySeq()
  val z = LazyList()
  val lit = []
  println(len(v))
  println(len(lit))
  val asInts: Vector[int] = v
  val asStrings: List[string] = l
  println(asInts.length)
  println(asStrings.length)
  println(q.size)
  println(a.length)
  println(z.isEmpty)
  val e1: Vector[string] = Vector()
  val e2: List[int] = List()
  val e3: Queue[int] = Queue()
  val e4: ArraySeq[int] = ArraySeq()
  val e5: LazyList[int] = LazyList()
  println(e1.length + e2.length + e3.size + e4.length)
  println(e5.isEmpty)
  println(Vector[int]().length + List[int]().length + Queue[int]().size + ArraySeq[int]().length)
  println(LazyList[int]().isEmpty)
