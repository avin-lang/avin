// expect: exit 0
// A class's answers for the characters below 128 are held as two words of bits, those below 64 and
// those from 64 on, and every other character is asked of the class's test. Each edge of the two
// words is matched, alone, in a range across it, negated, repeated and without regard to case, and so
// are the characters just past them, 128 and 255 from a class's table of the first 256, and one
// beyond that.
import avin.regex.Regex

// Whether `pattern` matches all of the one character `code`.
hits(pattern: string, code: int) -> bool = Regex(pattern).matches(char(code).toString())

// The characters among `codes` that `pattern` matches, as their numbers.
which(pattern: string, codes: Vector[int]) -> string = codes.filter(c -> hits(pattern, c)).map(
  c -> c.toString()
).mkString(",")

main() -> int
  val edges: Vector[int] = [0, 1, 62, 63, 64, 65, 126, 127, 128, 254, 255, 256, 0x10ffff]
  println(which("[\\x00]", edges))
  println(which("[\\x3f]", edges))
  println(which("[\\x40]", edges))
  println(which("[\\x7f]", edges))
  println(which("[\\x80]", edges))
  println(which("[\\xff]", edges))
  println(which("[\\x{100}]", edges))
  println(which("[\\x{10ffff}]", edges))
  println(which("[\\x3e-\\x41]", edges))
  println(which("[\\x7e-\\x{100}]", edges))
  println(which("[^\\x00\\x3f\\x40\\x7f]", edges))
  println(which("[\\x00-\\x7f]", edges))
  println(which("[^\\x00-\\x7f]", edges))
  println(which(".", edges))
  println(which("(?s).", edges))
  // A repetition of one class across both words and past them.
  println(
    Regex("[\\x00-\\x{100}]+").findFirstIn(
      "\u{0}?@\u{7f}\u{80}\u{ff}\u{100}\u{101}"
    ).map(s -> s.charCount).getOrElse(-1)
  )
  println(Regex("[?@]{2}").findAllIn("??@@?@").toVector.mkString(" "))
  // Case: the partners of a letter lie in the other word.
  println(which("(?i)[a]", [65, 97, 64, 96]))
  println(which("(?i)[\\x3f-\\x41]", [63, 64, 65, 97, 98]))
  println(which("(?i)a", [65, 97]))
  println(which("[\\w]", [47, 48, 63, 64, 65, 95, 96, 122, 127]))
  println(which("\\W", [47, 48, 63, 64, 65, 95, 96, 122, 127]))
  0
