// expect: exit 0
// The methods written once on `Seq` work on a range: lookups, searches, folds, conversions,
// ordering, sequence patterns, and `==` and the hash against other kinds of sequence. A range that
// ends at the largest `int`, or starts at the smallest, steps to its end without passing it.

describe(xs: Seq[int]) -> string = xs match
    [] -> "empty"
    [a] -> s"one $a"
    [a, b] -> s"two $a $b"
    [first, 2, _, last] -> s"four from $first to $last"
    _ -> "more"

main()
    val r = 1 .. 10 by 3
    println(s"${r.get(3)} ${r.get(4)} ${r.head()} ${r.last()} ${r.headOption()} ${(5 ..< 5).lastOption()}")
    println(s"${r.exists(x -> x > 9)} ${r.forall(x -> x % 3 == 1)} ${r.find(x -> x > 3)} ${r.find(x -> x > 10)} ${r.indexWhere(x -> x > 3)} ${r.count(x -> x % 2 == 0)}")
    println(s"${r.toVector()} ${r.toList()} ${r.contains(7)} ${r.indexOf(7)} ${r.indexOf(8)} ${r.mkString(", ")}")
    println(s"${r.maxOption()} ${r.minOption()} ${(10 .. 1 by -3).sorted()} ${(10 .. 1 by -3).maxOption()} ${(5 .. 4).maxOption()} ${r.foldLeft(0, (a, x) -> a * 100 + x)}")

    // Sequence patterns read the length once and each tested element by index.
    println(s"${describe(5 ..< 5)} ${describe(5 .. 5)} ${describe(5 .. 6)} ${describe(1 .. 4)} ${describe(0 .. 3)} ${describe(1 .. 9)} ${describe(9 .. 6 by -1)}")
    (1 .. 2) match
        [1, b] -> println(s"pattern $b")
        _ -> println("no match")

    // Equal to any sequence of the same values, and hashed alike; every empty range is equal.
    val s: Seq[int] = 0 ..< 4
    println(s"${s == [0, 1, 2, 3]} ${(0 ..< 4) == [0, 1, 2, 3]} ${(0 ..< 4) == (0 .. 3)} ${(0 .. 6 by 2) == [0, 2, 4, 6]} ${(0 ..< 4) == [0, 1, 2]}")
    println(s"${(0 ..< 4).hash() == [0, 1, 2, 3].hash()} ${(1 .. 0) == (5 .. 2)} ${(1 .. 0).hash() == (5 .. 2).hash()} ${s.length()} ${s(3)}")

    // At the ends of `int`.
    val top = 2147483640 .. 2147483647
    println(s"${top.length()} ${top.last()} ${top(7)} ${top.contains(2147483647)} ${top.toVector()}")
    var count = 0
    for i in top do count += 1
    for i in 2147483645 .. 2147483647 do count += 1
    for i in -2147483646 .. -2147483648 by -1 do count += 1
    println(s"$count")
    val wide = -2147483648 .. 2147483647 by 3
    println(s"${wide.length()} ${wide.head()} ${wide.last()} ${wide(1431655765)} ${wide.contains(2147483647)} ${wide.contains(0)}")
    val down = 2147483647 .. -2147483648 by -2147483648
    println(s"${down.length()} ${down.toVector()}")
