// expect: trap
// A connection handed to a thread is the thread's while the thread runs, and the code that handed it
// over traps at a `setTimeout`.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.threads.{Channel, spawn}
import avin.time

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message())

main()
    val l = ok(TcpListener.bind("127.0.0.1", 0))
    val c = ok(TcpStream.connect("127.0.0.1", l.port()))
    val s = ok(l.accept())
    ok(c.writeText("first\nsecond\nthird\n"))
    println(ok(s.readLine()))
    val go = Channel[int]()
    val t = spawn(() ->
        go.receive()
        ok(s.readLine()))
    println("handed over")
    s.setTimeout(time.milliseconds(5))
    println("not reached")
    go.send(1)
    println(t.join())
