// expect: exit 0
// An `ArraySeq` holds its elements in one array that nothing writes to after it is made: an
// immutable sequence for elements built once and then read. Every operation that changes one makes
// a new one and leaves the old as it was. It is covariant, compares and hashes by its elements, and
// is what a collection literal makes when the expected type asks for it.

open class Animal(val name: string)
class Dog(n: string): Animal(n)

names(xs: ArraySeq[Animal]) -> string = xs.foldLeft("", (acc, a) -> acc + a.name)

at(f: (int) -> string, i: int) -> string = f(i)

main()
    val a: ArraySeq[int] = [1, 2, 3]
    val e = ArraySeq.empty[int]()
    print(s"$a ${a.length()} ${e.length()} ${e.isEmpty()} ${a(2)}")
    val w = (0 +: a) :+ 4
    print(s"$w $a ${a.updated(1, 20)} $a ${a ++ w}")
    print(s"${a.slice(1, 3)} ${a.map(x -> x * 10)} ${w.filter(x -> x % 2 == 0)} ${w.collect(match x if x > 2 -> s"<$x>")}")
    print(s"${a.flatMap(x -> [x, x])} ${for x in w if x > 1 yield x * x}")
    var total = 0
    for x in w do total += x
    print(s"$total ${w.foldLeft(0, (s, x) -> s + x)} ${w.sum()} ${w.max()} ${w.mkString("-")}")
    // Equality and hashing are by the elements, however the sequence was made.
    val b = ArraySeq.builder[int]()
    for x in [1, 2, 3] do b.add(x)
    val built = b.result()
    print(s"${built == a} ${built.hash() == a.hash()} ${a == a.updated(0, 9)}")
    // Between vectors and array sequences, both ways.
    val v = a.toVector()
    val l: List[int] = [7, 8]
    print(s"$v ${v.toArraySeq() == a} ${[5, 6].toArraySeq()} ${Array.tabulate(3, i -> i).toArraySeq()} ${l.toArraySeq()}")
    print(s"${Some(1).toArraySeq()} ${a.toList()} ${a.toArray().length()} ${a.toBuffer().length()}")
    print(a)
    // Covariance, and a sequence used as the function from an index to its element.
    val dogs: ArraySeq[Dog] = [Dog("rex"), Dog("fido")]
    print(names(dogs))
    val words: ArraySeq[string] = ["zero", "one"]
    print(at(words, 1))
    var it = a.reverseIterator()
    var back = ""
    while it.hasNext() do back = back + s"${it.next()}"
    print(back)
