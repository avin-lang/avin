// expect: exit 0
// A function that calls itself in tail position runs as a loop, so ten million calls deep it uses no
// more stack than one: an accumulator, clauses, a match, `&&` and `||`, `return`, a generic function,
// a local function, and methods of a final class, an object and a data type, on their own receiver
// and on another one.

@tailrec
sum(n: long, acc: long) -> long = if n == 0 then acc else sum(n - 1, acc + n)

// No annotation: a tail call is a loop whether or not `@tailrec` asks for one.
countDown(n: int) -> int = if n == 0 then 0 else countDown(n - 1)

@tailrec
gcd(a: long, b: long) -> long
gcd(a, 0) = a
gcd(a, b) = gcd(b, a % b)

// `gcd` of two neighbours takes few steps; counting through clauses takes ten million.
@tailrec
steps(n: int, acc: int) -> int
steps(0, acc) = acc
steps(n, acc)
  | n % 2 == 0 = steps(n - 1, acc + 2)
  | _ = steps(n - 1, acc + 1)

@tailrec
parity(n: int, even: bool) -> bool = n match
  0 -> even
  _ -> parity(n - 1, !even)

// The right operand of `&&` and `||` is in tail position.
@tailrec
allBelow(n: int, limit: int) -> bool = n == 0 || (n < limit && allBelow(n - 1, limit))

@tailrec
early(n: int) -> int
  if n == 0 then return 7
  val next = n - 1
  return early(next)

@tailrec
repeatGeneric[T](n: int, value: T) -> T = if n == 0 then value else repeatGeneric(n - 1, value)

// The arguments are all evaluated before any parameter changes: the swap sees the old values.
@tailrec
swapping(n: int, a: int, b: int) -> int = if n == 0 then a * 10 + b else swapping(n - 1, b, a)

class Counter(val step: long)
  @tailrec
  run(n: int, acc: long) -> long = if n == 0 then acc else run(n - 1, acc + step)

  // A call on another counter of the same class is a loop too, with that counter as the receiver.
  @tailrec
  pass(other: Counter, n: int, acc: long) -> long = if n == 0 then acc + step else other.pass(self, n - 1, acc + step)

object Steps
  @tailrec
  count(n: int, acc: int) -> int = if n == 0 then acc else count(n - 1, acc + 1)

data Countdown(left: long)

impl Countdown
  @tailrec
  finish(acc: long) -> long = if left == 0 then acc else Countdown(left - 1).finish(acc + left)

main() -> int
  @tailrec
  local(n: int, acc: int) -> int = if n == 0 then acc else local(n - 1, acc + 1)

  val deep = 10000000
  println(sum(long(deep), 0))
  println(countDown(deep))
  println(gcd(1071, 462))
  println(steps(deep, 0))
  println(parity(deep, true))
  println(allBelow(deep, deep + 1))
  println(allBelow(deep, deep))
  println(early(deep))
  println(repeatGeneric(deep, "same"))
  println(repeatGeneric(deep, 42))
  println(swapping(deep + 1, 1, 2))
  println(Counter(2).run(deep, 0))
  println(Counter(1).pass(Counter(2), deep + 1, 0))
  println(Steps.count(deep, 0))
  println(Countdown(long(deep)).finish(0))
  println(local(deep, 0))
  0
