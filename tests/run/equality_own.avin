// expect: exit 0
// A type that implements `Eq` and `Hash` compares and hashes by its own methods: a class by its fields
// instead of its identity, a data type by a rule of its own instead of field by field. `==` and `!=`
// call them directly, generic code at the type included, and so do values inside a data value or a
// tuple.

class Point(val x: int, val y: int)

impl Eq for Point
    equals(other: Point) -> bool = x == other.x && y == other.y

impl Hash for Point
    hash() -> long = long(x) * 31 + long(y)

// Compared by name only: the count does not take part.
data Tally(name: string, count: int)

impl Eq for Tally
    equals(other: Tally) -> bool = name == other.name

impl Hash for Tally
    hash() -> long = name.hash()

// A class declaring the traits in its header.
class Word(val text: string): Eq, Hash
    override equals(other: Word) -> bool = text == other.text
    override hash() -> long = text.hash()

data Pair(a: Point, b: Tally)

same[T: Eq](a: T, b: T) -> bool = a == b

main()
    val p = Point(1, 2)
    print(s"${p == Point(1, 2)} ${p != Point(1, 2)} ${p == Point(2, 1)} ${p === Point(1, 2)} ${p === p}")
    print(s"${p.hash() == Point(1, 2).hash()} ${same(p, Point(1, 2))} ${same(p, Point(0, 2))}")
    print(s"${Tally("a", 1) == Tally("a", 2)} ${Tally("a", 1) == Tally("b", 1)} ${Tally("a", 1).hash() == Tally("a", 9).hash()}")
    print(s"${Word("hi") == Word("hi")} ${Word("hi") != Word("ho")} ${same(Word("x"), Word("x"))}")
    print(s"${Pair(Point(1, 2), Tally("t", 1)) == Pair(Point(1, 2), Tally("t", 5))} ${(p, 1) == (Point(1, 2), 1)}")
