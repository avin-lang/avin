// expect: exit 0
// `parseDateTime`: a date and a time joined by `T` or one space, the least and greatest readings,
// the shape read whole before any field's range, every refusal with its byte or field, and every
// display reading back equal over a sweep from year -1 to 10000.
import avin.time.{Date, DateTime, BadShape, OutOfRange, Trailing, dateTime, timeOfMicros, parseDateTime}

main()
  println(parseDateTime("2026-03-08T09:30:00"))
  println(parseDateTime("2026-03-08 09:30"))
  println(parseDateTime("2026-03-08T09:30:07.25"))
  println(parseDateTime("+10000-01-01T00:00"))
  println(parseDateTime("-0001-12-31T23:59:59.999999"))
  println(parseDateTime("2024-02-29T12:00") == Ok(dateTime(2024, 2, 29, 12, 0)))
  println(parseDateTime(s"${DateTime.Min}") == Ok(DateTime.Min))
  println(parseDateTime(s"${DateTime.Max}") == Ok(DateTime.Max))
  println(parseDateTime(s"${DateTime.Min}"))
  println(parseDateTime(s"${DateTime.Max}"))

  // The joint: `T` or one space, nothing else.
  println(parseDateTime("2026-03-08t09:30"))
  println(parseDateTime("2026-03-08  09:30"))
  println(parseDateTime("2026-03-0809:30"))
  println(parseDateTime("2026-03-08_09:30"))
  println(parseDateTime("2026-03-08T"))
  println(parseDateTime("2026-03-08"))
  println(parseDateTime("2026-03-08 "))

  // The date's fields are checked before the time's, and the whole shape before either.
  println(parseDateTime("2026-02-30T24:00"))
  println(parseDateTime("2026-02-28T24:00"))
  println(parseDateTime("2026-02-28T23:59:60"))
  println(parseDateTime("2026-02-28T23:59:59.1234567"))
  println(parseDateTime("2023-02-29T00:00"))
  println(parseDateTime("2026-13-01T00:00"))
  println(parseDateTime("2026-02-30T09:3"))
  println(parseDateTime("2026-02-30T09:30Z"))

  // Shapes and text left over.
  println(parseDateTime(""))
  println(parseDateTime("T09:30"))
  println(parseDateTime("2026-03-08T9:30"))
  println(parseDateTime("2026-03-08T09:30Z"))
  println(parseDateTime("2026-03-08T09:30:00+05:30"))
  println(parseDateTime("2026-03-08T09:30 "))
  println(parseDateTime("2026-03-08T٠٩:30"))
  println(parseDateTime("2026-03-08 09:30:00.٥"))

  println(parseDateTime("2026-03-08X09:30") == Err(BadShape("2026-03-08X09:30", 10, "'T' or a space")))
  println(parseDateTime("2026-02-28T24:00") == Err(OutOfRange("2026-02-28T24:00", "hour")))
  println(parseDateTime("2026-03-08T09:30Z") == Err(Trailing("2026-03-08T09:30Z", 16)))

  // Every display reads back, with a time of day moving through 0 to 6 digits of fraction.
  val fractions: Vector[long] = [0, 100000, 120000, 123000, 123400, 123450, 123456]
  var failures = 0
  var checked = 0
  var d = Date(0).epochDay - 365 * 1971
  var k = 0
  while d <= 2932896
    val micros = long(k * 7919 % 86400) * 1000000 + fractions(k % 7)
    val reading = DateTime(Date(d), timeOfMicros(micros))
    if parseDateTime(s"$reading") != Ok(reading) then failures += 1
    val spaced = s"${reading.date} ${reading.time}"
    if parseDateTime(spaced) != Ok(reading) then failures += 1
    checked += 1
    d += 991
    k += 1
  println(s"$checked readings read back both ways, $failures failures")
