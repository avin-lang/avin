// expect: exit 0
// An immutable queue: enqueue at the back, dequeue at the front, each leaving the original as it was.

main(args: Vector[string])
  val e = Queue.empty[int]()
  println(e.isEmpty)
  println(e.length)
  println(e.frontOption)
  println(e.dequeueOption)
  println(e)

  val one = e.enqueue(7)
  println(one)
  println(one.front)
  println(e.length)

  val q = Queue(1, 2, 3)
  val q2 = q.enqueue(4)
  println(q)
  println(q2)
  println(q2.front)
  val (h, rest) = q2.dequeue
  println(h)
  println(rest)
  println(q2)
  println(q2(0))
  println(q2(3))
  println(q2.length)
  println(q2.toList)
  println(q.enqueueAll([8, 9]))
  println(q.enqueueAll(Queue(8, 9)).length)
  println(Queue.empty[string]().isEmpty)
