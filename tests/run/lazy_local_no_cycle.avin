// expect: exit 0
// Local `lazy val`s whose initializers read other lazy values but never their own are accepted: a
// chain, a local function reading an earlier value, a nested value reading the outer one's
// neighbour, a lambda made and stored that reads the value later, a lazy list whose tail is
// itself, and a local value inside a field's initializer reading the object's other fields.
chain() -> int
  lazy val a: int = 1
  lazy val b: int = a + 1
  lazy val c: int = b * a + 1
  c

helper() -> int
  lazy val base: int = 10
  scaled() -> int = base * 3
  lazy val top: int = scaled() + 1
  top

nested() -> int
  lazy val side: int = 4
  lazy val outer: int =
    lazy val inner: int = side + 1
    inner * 2
  outer

stored() -> int
  lazy val value: int = 41
  lazy val later: () -> int = () -> value + 1
  later()

ones() -> Vector[int]
  lazy val ones: LazyList[int] = LazyList.cons(1, ones)
  ones.take(3).toVector

class Sheet(rows: int)
  lazy val cells: int = rows * 2
  lazy val total: int =
    lazy val counted: int = cells + rows
    counted + 1

main()
  println(chain())
  println(helper())
  println(nested())
  println(stored())
  println(ones())
  println(Sheet(3).total)
