// expect: exit 0
// Generic classes: type arguments inferred from the constructor's arguments or from the expected
// type, or written; methods with type parameters of their own; a linked stack of class objects
// built large enough that collections run while its nodes hold references to one another.

data Option[+T]
    Some(value: T)
    None

class Box[T](var value: T)
    get() -> T = value
    put(v: T) = value = v
    map[U](f: (T) -> U) -> Box[U] = Box(f(value))
    pairWith[U](other: U) -> (T, U) = (value, other)

class Node[T](val item: T, val next: Option[Node[T]])

class Stack[T]()
    var top: Option[Node[T]] = None
    var size = 0

    push(item: T)
        top = Some(Node(item, top))
        size++

    pop() -> Option[T] = top match
        Some(node) ->
            top = node.next
            size--
            Some(node.item)
        None -> None

    peek() -> Option[T] = top match
        Some(node) -> Some(node.item)
        None -> None

main() -> int
    val b = Box(41)
    b.put(b.get() + 1)
    if b.value != 42 then return 1
    val s = b.map((n) -> s"n=$n")
    print(s.get())
    val written = Box[string]("x")
    val (v, flag) = written.pairWith(true)
    if v != "x" || !flag then return 2
    val expected: Box[Option[int]] = Box(None)
    expected.put(Some(3))
    expected.get() match
        Some(3) -> ()
        _ -> return 3
    val stack = Stack[string]()
    var i = 0
    while i < 5000
        stack.push(s"item $i")
        i++
    if stack.size != 5000 then return 4
    stack.peek() match
        Some(top) -> print(top)
        None -> return 5
    var popped = 0
    while stack.pop() is Some(_)
        popped++
    if popped != 5000 || stack.size != 0 then return 6
    val ints = Stack[int]()
    ints.push(1)
    ints.push(2)
    var sum = 0
    while true
        ints.pop() match
            Some(n) -> sum += n
            None -> break
    if sum != 3 then return 7
    0
