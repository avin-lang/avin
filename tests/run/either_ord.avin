// expect: exit 0
// `Either[L, R]` is `Ord` when `L` and `R` are: every `Left` before every `Right`, and two on the same
// side as their values. Covers pairs, ties, nesting, sorting, extremes, keys, derived fields, generics.

data Point(x: int, y: int) derives Ord

data Row(name: string, side: Either[int, string]) derives Ord

smaller[T: Ord](a: T, b: T) -> T = if a.compare(b) <= 0 then a else b

sign(n: int) -> int = if n < 0 then -1 elif n > 0 then 1 else 0

main()
    val l1: Either[int, string] = Left(1)
    val l2: Either[int, string] = Left(2)
    val lLow: Either[int, string] = Left(-2147483647 - 1)
    val lHigh: Either[int, string] = Left(2147483647)
    val ra: Either[int, string] = Right("a")
    val rb: Either[int, string] = Right("b")
    val rEmpty: Either[int, string] = Right("")

    // Left against Right, in both directions, and every pair on one side.
    println(s"${sign(l1.compare(ra))} ${sign(ra.compare(l1))} ${sign(l1.compare(l1))} ${sign(ra.compare(ra))}")
    println(s"${sign(l1.compare(l2))} ${sign(l2.compare(l1))} ${sign(ra.compare(rb))} ${sign(rb.compare(ra))}")
    println(s"${lHigh < rEmpty} ${lLow < l1} ${lHigh > l2} ${rEmpty < ra} ${rEmpty <= rEmpty}")
    println(s"${l1 <= l1} ${l1 >= l1} ${ra > l2} ${ra >= l2} ${l2 < ra} ${l2 <= ra} ${l1 > ra}")

    // Sorting: every Left first, each side by value; duplicates kept.
    val mixed: Vector[Either[int, string]] = [rb, l2, ra, l1, rb, lLow, rEmpty, l2]
    println(mixed.sorted())
    println(mixed.sortWith((a, b) -> b.compare(a)))
    println(mixed.toList().sorted())
    val empty: Vector[Either[int, string]] = []
    println(empty.sorted())
    println(Vector[Either[int, string]](ra).sorted())
    println(mixed.sortBy(e -> e))

    // Extremes.
    println(s"${mixed.max()} ${mixed.min()}")
    println(s"${mixed.maxOption()} ${mixed.minOption()} ${empty.maxOption()}")
    println(s"${max(l1, ra, l2)} ${min(l1, ra, l2)} ${max(l1, l2)} ${min(ra, rb)}")

    // Both sides the same type: a Left still precedes a Right.
    val same1: Either[int, int] = Right(0)
    val same2: Either[int, int] = Left(99)
    println(s"${same2 < same1} ${same1 > same2}")

    // Tuples inside an either, ties broken by later parts.
    val t1: Either[(int, int), (string, int)] = Left((1, 5))
    val t2: Either[(int, int), (string, int)] = Left((1, 6))
    val t3: Either[(int, int), (string, int)] = Left((2, 0))
    val t4: Either[(int, int), (string, int)] = Right(("a", 9))
    val t5: Either[(int, int), (string, int)] = Right(("a", 10))
    println(s"${t1 < t2} ${t2 < t3} ${t3 < t4} ${t4 < t5} ${t5 > t1}")
    println(Vector(t5, t3, t4, t2, t1).sorted())

    // Options inside an either, and an either inside an option.
    val o1: Either[Option[int], int] = Left(None)
    val o2: Either[Option[int], int] = Left(Some(0))
    val o3: Either[Option[int], int] = Right(-1)
    println(s"${o1 < o2} ${o2 < o3} ${o1 < o3}")
    println(Vector(o3, o2, o1).sorted())
    val n0: Option[Either[int, int]] = None
    val n1: Option[Either[int, int]] = Some(Left(5))
    val n2: Option[Either[int, int]] = Some(Right(0))
    println(s"${n0 < n1} ${n1 < n2} ${n0 < n2}")
    println(Vector(n2, n1, n0).sorted())

    // Eithers nested on either side.
    val deep1: Either[Either[int, int], int] = Left(Left(7))
    val deep2: Either[Either[int, int], int] = Left(Right(0))
    val deep3: Either[Either[int, int], int] = Right(-1)
    println(s"${deep1 < deep2} ${deep2 < deep3} ${deep1 < deep3}")
    println(Vector(deep3, deep2, deep1).sorted())

    // Data types that derive Ord on either side, and a derived Ord with an either field.
    val p1: Either[Point, string] = Left(Point(1, 2))
    val p2: Either[Point, string] = Left(Point(1, 3))
    println(s"${p1 < p2} ${p2 < Right("")}")
    println(Vector(Row("b", l1), Row("a", ra), Row("a", l2), Row("a", l1)).sorted())

    // Tree keys.
    val tree = TreeMap((rb, 1), (l2, 2), (ra, 3), (l1, 4))
    println(tree)
    println(tree.keys().toList())
    println(TreeSet(rb, l1, ra, l1, rb, l2))

    // A generic function bounded by Ord.
    println(s"${smaller(l1, ra)} ${smaller(ra, l1)} ${smaller(rb, ra)} ${smaller(l2, l1)}")
