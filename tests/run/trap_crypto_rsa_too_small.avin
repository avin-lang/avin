// expect: trap
// An RSA key is made from 2048 bits up: asking for a 1024-bit one is a mistake in the program, and
// traps rather than making a key too weak to sign with.
import avin.crypto.{generatePrivateKey, RsaKey, Ed25519Key}

main()
  println(generatePrivateKey(Ed25519Key))
  println(generatePrivateKey(RsaKey(1024)))
