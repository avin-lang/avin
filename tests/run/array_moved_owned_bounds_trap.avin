// expect: trap
// An array taken back after a move keeps its length and its bounds: every element inside it is the
// taker's to read and write, its length and a slice of it are whole, and an index past its end
// traps as it does for any array, not as a move.
import avin.actors.Isolated

main()
  val a = Isolated.move(Array.tabulate[int](3, i -> i * 10)).take()
  a(2) = 25
  println(s"${a.length} ${a(0)} ${a(2)} ${a.slice(1, 3).toVector}")
  val empty = Isolated.move(Array.empty[int]()).take()
  println(empty.length)
  println(a(3))
