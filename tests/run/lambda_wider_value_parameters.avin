// expect: exit 0
// A lambda whose parameter is declared Any or a trait, where a function of a data value, a string, a
// tuple or an option is expected, receives the value with its exact type, as a function value of
// that wider type does, in a binding and through a generic method too.

data P(x: int)

data Big(a: int, b: int, c: int, d: int, e: string)

callP(f: (P) -> string) -> string = f(P(3))

callBig(f: (Big) -> string) -> string = f(Big(1, 2, 3, 4, "five"))

callS(f: (string) -> string) -> string = f("str")

callT(f: ((int, int)) -> string) -> string = f((1, 2))

callO(f: (Option[int]) -> string) -> string = f(Some(9))

show(x: Any) -> string = x match
    p: P -> s"P ${p.x}"
    b: Big -> s"Big ${b.e}"
    s: string -> s"string $s"
    t: (int, int) -> s"pair ${t.0}"
    o: Option[int] -> s"option $o"
    _ -> "other"

main()
    println(callP((x: Display) -> s"display $x"))
    println(callP((x: Any) -> show(x)))
    println(callBig((x: Any) -> show(x)))
    println(callS((x: Any) -> show(x)))
    println(callT((x: Any) -> show(x)))
    println(callO((x: Any) -> show(x)))
    val g: (P) -> string = (x: Any) -> show(x)
    println(g(P(5)))
    val h: (Any) -> string = show
    println(callP(h))
    println([P(1), P(2)].map((x: Any) -> show(x)))
