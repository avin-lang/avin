// expect: trap
// A slice longer than an array can hold traps before copying anything: a 3 GiB sparse file's mapping
// reads at an offset past `int`'s range, but its whole is not one array.
import avin.fs

main()
  val dir = fs.createTempDir("avin-mapped-trap").toOption.get
  val path = dir + "/a"
  val f = fs.createUpdate(path).toOption.get
  val size: long = 3221225472
  _ = f.setLength(size)
  _ = f.close()
  val m = fs.mapFile(path).toOption.get
  _ = fs.removeDirAll(dir)
  println(m(size - 1))
  println(m.slice(size - 3, size).length)
  println(m.toArray().length)
