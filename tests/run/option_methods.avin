// expect: exit 0
// The core library's `Option`: its methods, matching it exhaustively, and its covariance. Defaults
// and alternatives passed by name are evaluated only when they are needed, which the counter shows.

open class Animal(val name: string)
class Dog(name: string) : Animal(name)

describe(o: Option[int]) -> string = o match
    Some(v) if v < 0 -> s"negative $v"
    Some(v) -> s"some $v"
    None -> "none"

main()
    val a: Option[int] = None
    val b = Some(3)
    println(s"${a.isSome()} ${a.isNone()} ${b.isSome()} ${b.isNone()}")
    println(s"${describe(a)} ${describe(b)} ${describe(Some(-2))}")

    var evaluated = 0
    fallback() -> int
        evaluated += 1
        7
    println(s"${a.getOrElse(fallback())} ${b.getOrElse(fallback())} evaluated $evaluated")
    other() -> Option[int]
        evaluated += 1
        Some(9)
    println(s"${a.orElse(other()).getOrElse(0)} ${b.orElse(other()).getOrElse(0)} evaluated $evaluated")

    println(s"${b.map(x -> x * 2).getOrElse(0)} ${a.map(x -> x * 2).isNone()}")
    println(describe(b.map(x -> s"$x!").map(s -> 10)))
    val small: (int) -> Option[int] = x -> if x < 5 then Some(x + 100) else None
    println(s"${describe(b.flatMap(small))} ${describe(Some(8).flatMap(small))} ${describe(a.flatMap(small))}")
    println(s"${describe(b.filter(x -> x == 3))} ${describe(b.filter(x -> x > 3))} ${describe(a.filter(x -> true))}")
    println(s"${b.fold(fallback(), x -> x + 1)} ${a.fold(-1, x -> x + 1)} evaluated $evaluated")
    b.foreach(x -> println(s"each $x"))
    a.foreach(x -> println("not shown"))

    // Strings and data inside an option survive the collector between the calls that unwrap them.
    val words = Some("word").map(w -> w + "s").filter(w -> w != "")
    println(words.getOrElse("empty"))

    // An `Option[Dog]` is an `Option[Animal]`, and its methods see `T` as `Animal`.
    val dogs: Option[Dog] = Some(Dog("fido"))
    val animals: Option[Animal] = dogs
    println(animals.map(x -> x.name).getOrElse("none"))
    val nobody: Option[Animal] = None[Dog]
    println(nobody.getOrElse(Animal("cat")).name)
    val either = if b.isSome() then Some(Dog("rex")) else Some(Animal("generic"))
    println(either.map(x -> x.name).getOrElse(""))
