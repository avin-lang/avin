// `defer` runs its statement when control leaves the block it is a statement of, by every way out:
// the block's end, `return`, `?` on an `Option` and on a `Result`, `break` and `continue`, a `break`
// with a value, and a nested block's end before its enclosing block's. The deferred statements a
// block reached run in the reverse of their order; one never reached never runs.
// expect: exit 3

// The block's end: the last one written runs first.
reverse()
    defer println("reverse: third")
    defer println("reverse: second")
    defer println("reverse: first")
    println("reverse: body")

// An early `return` runs every one reached, from every enclosing block, innermost first; one after
// the `return` is never reached.
early(n: int) -> string
    defer println(s"early($n): outer")
    if n < 0
        defer println(s"early($n): branch")
        return "negative"
    defer println(s"early($n): after the branch")
    if n == 0 then return "zero"
    "positive"

// The value of a `return` and of the block is computed before the deferred statements run, and a
// name in a deferred statement is read when it runs.
var log: Vector[string] = []

valueFirst() -> int
    var x = 1
    defer x = 100
    defer log = log :+ s"x was $x when the first ran"
    x = 2
    return x

blockValue() -> int
    var x = 10
    defer x += 1
    x

// `?` on an `Option` and on a `Result` takes its failure arm through the deferred statements.
half(n: int) -> Option[int]
    defer println(s"half($n): done")
    val even = (if n % 2 == 0 then Some(n) else None)?
    Some(even / 2)

parse(text: string) -> Result[int, string]
    defer println(s"parse($text): done")
    val n = (text.toIntOption() match
        Some(v) -> Ok(v)
        None -> Err(s"not a number: $text"))?
    Ok(n * 10)

// A loop body's deferred statements run at the end of every turn, at `continue` and at `break`.
loops()
    for i in 0..<5
        defer println(s"turn $i: closed")
        if i == 1 then continue
        if i == 3 then break
        println(s"turn $i: body")
    println("loops: after")

// Only the inner loop's statements run at the inner `break`; the outer one's run at the end of its turn.
nested()
    for i in 0..<2
        defer println(s"outer $i: closed")
        var j = 0
        while true
            defer println(s"  inner $i.$j: closed")
            if j == 1 then break
            j += 1
        println(s"outer $i: inner done")

// A `break` with a value: the value is computed, then the statements run, then the loop yields it.
breakValue() -> int
    var k = 0
    val found = loop
        defer k += 100
        k += 1
        if k > 3 then break k
    found * 1000 + k

// A `return` from inside a loop runs the loop body's statements and the function's.
search(xs: Vector[int], target: int) -> int
    defer println(s"search($target): done")
    for i in 0..<xs.length
        defer println(s"  looked at $i")
        if xs(i) == target then return i
    -1

// A nested block's statements run at its own end, before the code after it.
blocks()
    defer println("blocks: function")
    val n =
        defer println("blocks: inner value block")
        41
    println(s"blocks: n = ${n + 1}")

// A `match` arm and an `if` branch are blocks of their own.
arms(o: Option[string])
    o match
        Some(s) ->
            defer println(s"arms: some $s closed")
            println(s"arms: some $s")
        None ->
            defer println("arms: none closed")
            println("arms: none")

// A deferred statement may be an indented block, and may hold a loop whose own jumps stay inside it,
// a `defer` of its own (run at the end of that block) and an `if`.
blockForm()
    defer
        defer println("blockForm: the inner deferred statement")
        for i in 0..<10
            if i == 2 then break
            if i == 0 then continue
            println(s"blockForm: loop $i")
        println("blockForm: deferred block ends")
    println("blockForm: body")

// A statement reached in one call is not carried into the next.
counted(n: int) -> int
    var hits = 0
    for i in 0..<n
        defer hits += 1
        if i % 2 == 0 then continue
    hits

main() -> int
    reverse()
    println(early(-1))
    println(early(0))
    println(early(1))
    println(valueFirst())
    println(log)
    println(blockValue())
    println(half(4))
    println(half(3))
    println(parse("7"))
    println(parse("seven"))
    loops()
    nested()
    println(breakValue())
    println(search([5, 6, 7], 6))
    println(search([5], 9))
    blocks()
    arms(Some("é"))
    arms(None)
    blockForm()
    println(counted(0))
    println(counted(5))
    // `main`'s own deferred statements run before the program exits with its result.
    defer println("main: last words")
    3
