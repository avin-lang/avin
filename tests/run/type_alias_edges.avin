// expect: exit 0
// Corners of type aliases: boundary values through an alias of a built-in type, an empty string and
// an empty collection, a generic alias whose body is a bounded type used where the bound holds, an
// alias in trait, impl and class method signatures, in a generic class's type argument and in an
// `is` test, an alias declared after its first use, and many values of aliased types made and
// dropped, so the collector meets them.

type Big = long
type Small = int
type Text = string
type Sorted[T] = TreeSet[T]
type Cell[T] = Box[Option[T]]
type Matrix = Vector[Vector[Later]]
type Later = Small
type Tree = Vector[Leaf]
type Visit = (Leaf) -> Small

data Leaf(label: Text, weight: Small)

class Box[T](val item: T)

trait Weighed
    mass() -> Small

impl Weighed for Leaf
    mass() -> Small = weight

impl Leaf
    heavier(other: Leaf) -> Leaf = if weight >= other.weight then self else other

smallest[T: Ord](s: Sorted[T]) -> T = s.min

// An alias names only a type, so a function and a module value may share its name.
type Pair = (Small, Small)

Pair(a: Small) -> Pair = (a, a)

val Weight: Pair = Pair(5)

type Handler = (string) -> unit

total(t: Tree, v: Visit) -> Big = t.map(leaf -> long(v(leaf))).sum

main()
    val hi: Small = 2147483647
    val lo: Small = -2147483648
    println(s"$hi $lo")
    val big: Big = 9223372036854775807
    println(big)
    val empty: Text = ""
    println(empty.byteLength())
    val none: Matrix = []
    println(none.length)
    val grid: Matrix = [[1], [2, 3]]
    println(grid(1)(1))
    val s: Sorted[int] = TreeSet.empty[int]().incl(3).incl(1).incl(2)
    println(smallest(s))
    val c: Cell[Text] = Box(Some("in"))
    println(c.item)
    val w: Weighed = Leaf("x", 4)
    println(w.mass())
    println(Leaf("a", 1).heavier(Leaf("b", 2)).label)
    val any: Any = (1, 2)
    if any is p: (Small, Small) then println(p.0 + p.1)
    var tree: Tree = []
    for i in 0..<20000
        tree = if tree.length > 1000 then [Leaf(s"$i", i)] else tree :+ Leaf(s"leaf $i", i % 7)
    println(tree.length)
    println(total(tree, _.weight))
    var cells: Vector[Cell[Small]] = []
    for i in 0..<5000
        cells = cells :+ Box(if i % 2 == 0 then Some(i) else None)
    println(cells.count(_.item.isDefined()))
    println(Weight.0 + Pair(1).1)
    val h: Handler = s -> println(s)
    h("handled")
