// expect: trap
// An outbox of zero messages is taken, a handshake answered as any other, and a negative one traps
// where `webSocket` is called; `WebSocket.connect` checks it the same way.
import avin.net.http.{ServerRequest, webSocket}

main()
  val good = [
    ("Upgrade", "websocket"),
    ("Connection", "Upgrade"),
    ("Sec-WebSocket-Key", "dGhlIHNhbXBsZSBub25jZQ=="),
    ("Sec-WebSocket-Version", "13")
  ]
  val r = webSocket(ServerRequest("GET", "/chat", good), _ -> (), outboxSize = 0)
  println(s"${r.status} ${r.upgraded.isDefined}")
  _ = webSocket(ServerRequest("GET", "/chat", good), _ -> (), outboxSize = -1)
