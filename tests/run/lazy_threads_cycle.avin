// expect: trap
// A field's `lazy val` whose initializer, run on a thread other than the main one, needs its own
// value through another lazy field would wait for itself for ever: the read made while it is being
// initialized traps at that read, naming the value, while another thread waits for it.
import avin.threads.{sleep, scope}
import avin.time.milliseconds

class Graph[T](seed: T)
    lazy val first: Vector[T] = second :+ seed

    lazy val second: Vector[T] = later()

    later() -> Vector[T]
        sleep(milliseconds(20))
        first

main() -> int
    println("before")
    val g = Graph("x")
    scope(s ->
        s.spawn(() -> println(g.first.length()))
        sleep(milliseconds(5))
        s.spawn(() -> println(g.first.length())))
    println("after")
    0
