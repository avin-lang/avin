// expect: trap
// A derived value that reads itself, here on its second computation, traps rather than recursing.
import avin.reactive.{Derived, Graph}

main()
  val g = Graph()
  val a = g.atom(1)
  val holder = Buffer[Derived[int]]()
  val d = g.derived(get -> if holder.isEmpty then get(a) else get(holder(0)) + 1)
  println(d.get())
  holder.append(d)
  a.set(2)
  println(d.get())
