// expect: exit 0
// A hole's bounds: `F[_: Ord]` is applied only to types that are `Ord`, and in return takes a
// constructor whose parameter at that hole is bounded by `Ord`, `TreeSet` among them, as well as one
// whose parameter is unbounded. `Eq` and `Hash` need no hole bound, since every type has them, so
// `Set` is a constructor for a plain `_`. A constructor parameter with bounded holes is passed on to
// another whose hole bounds imply its own, and a data type's constructor parameter carries hole
// bounds too.
data Version(major: int, minor: int) derives Ord

ordered[F[_: Ord], A: Ord](x: F[A]) -> F[A] = x

ints[F[_: Ord]](x: F[int]) -> F[int] = x

anything[F[_]](x: F[int]) -> F[int] = x

hashed[F[_: Hash]](x: F[string]) -> F[string] = x

sendable[F[+_: Sendable]](x: F[int]) -> F[int] = x

relay[G[_: Ord]](x: G[int]) -> G[int] = ints(x)

relayWritten[G[_: Ord & Hash]](x: G[long]) -> G[long] = ordered[G, long](x)

data Sorted[F[_: Ord], A: Ord](items: F[A])

class Index[F[_: Ord]](val keys: F[string])
  first() -> F[string] = keys

main()
  println(ordered(TreeSet(3, 1, 2)))
  println(ordered(TreeSet("b", "a", "ü")))
  println(ordered(TreeSet(Version(1, 2), Version(0, 9))))
  println(ordered([Version(2, 0)]))
  println(ints(TreeSet(-2147483648, 2147483647, 0)))
  println(ints(Some(1)))
  println(anything(Set(1, 1, 2)))
  println(hashed(Set("x")))
  println(sendable(Some(5)))
  println(relay(TreeSet(9, 8)))
  println(relayWritten(TreeSet(long(7))))
  println(Sorted[TreeSet, int](TreeSet(5, 4)).items)
  println(Sorted(TreeSet("q")).items)
  println(Index(TreeSet("k2", "k1")).first())
  println(Index[Vector](["v"]).first())
