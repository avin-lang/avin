// A program's own trait may be implemented for one width beside the core library's impls for every
// width: the width then has both, as a bound and by name. A width's methods from the family are
// values like any other method, and a conversion to a bounded type parameter may be given its width
// explicitly.

trait Sized
    size() -> int

impl Sized for i5
    size() -> int = 5

impl Sized for i128
    size() -> int = 128

measured[T: Sized](x: T) -> int = x.size()

shown[T: Display](x: T) -> string = x.toString()

narrow[T: Integer](n: long) -> T = T(n)

main()
    print(measured(i5(1)) + measured(i128(1)))
    print(shown(i5(-1)) + " " + shown(i128(-1)))
    print(i5(2).size())
    print(i5(2).toString())
    val render = i5(-9).toString
    print(render())
    val plus = i24(40).add
    print(plus(i24(2)))
    print(narrow[i5](35))
    print(narrow[i128](-7))
