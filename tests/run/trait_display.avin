// expect: exit 0
// A value of `Any` or of a trait is shown by the type it has at run time: its own `Display` and
// `Debug`, or, for a type with neither, its type's name. So a `Seq[int]` prints as the vector it
// holds, and a trait's value meets a `Display` or `Debug` bound, as every type meets `Eq`'s.

trait Pet
  name() -> string

class Dog(val called: string): Pet, Display, Debug
  override name() -> string = called
  override display(out: Writer, spec: FormatSpec) = out.writeField("Dog " + called, spec)
  override debug(out: Writer, spec: FormatSpec) = out.writeField(s"Dog(\"$called\")", spec)

class Cat(): Pet
  override name() -> string = "cat"

data Fish(called: string)

impl Pet for Fish
  name() -> string = called

trait Shape: Display
  area() -> int

class Square(val side: int): Shape
  override area() -> int = side * side
  override display(out: Writer, spec: FormatSpec) = out.writeField(s"Square($side)", spec)

class Box[T](val item: T)

data Pen(pet: Pet, count: int)

show[T: Display](value: T) -> string = s"<$value>"

main()
  // The core library's traits: a sequence prints as the collection it is.
  val xs: Seq[int] = [1, 2, 3]
  println(xs)
  println(s"$xs and ${xs.toString()}")
  println(debug(xs))
  println(f"[$xs%12s|$xs%-12s]")
  val words: Iterable[string] = ["a", "b"]
  println(words)
  println(debug(words))
  println(f"$words%?")
  val nested: Vector[Seq[int]] = [xs, [4]]
  println(nested)
  println(debug(nested))

  // A trait of the program: each implementor shows itself, one with no `Display` by its name.
  val pets: Vector[Pet] = [Dog("rex"), Cat(), Fish("nemo")]
  for p in pets
    println(s"${p.name()}: $p / ${debug(p)} / ${p.toString()}")
  println(pets)
  println(f"[${pets(1)}%5s]")

  // A trait that requires `Display` is shown the same way.
  val shape: Shape = Square(3)
  println(shape)

  // Its `Debug` is not required, so it is the object's own, or its type's name.
  println(debug(shape))
  // A `Display` value, which every object it holds implements, through its method table.
  val d: Display = Square(4)
  println(s"$d ${debug(pets(1))}")

  // A `Display` bound.
  println(show(xs))
  println(show(pets(2)))
  println(show(nested))

  // `Any`: every value, by its own type.
  val add: (int) -> int = x -> x + 1
  val anys: Vector[Any] = [3, "str", 2.5, true, (), (1, "two"), Box(1), add, Some(Fish("a")), None[int], xs]
  for a in anys
    println(s"$a / ${debug(a)}")
  println(show(anys(0)))
  println(anys(6).toString())

  // A data type with a trait-typed field has `Display` and `Debug`, through the field's own type.
  val pen = Pen(Cat(), 2)
  println(pen)
  println(debug(pen))
  val maybe: Option[Pet] = Some(Dog("max"))
  println(maybe)
