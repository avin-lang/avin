// expect: exit 0
// The iterators `object Iterator` makes from a value or a function: `empty`, `single`, `iterate`,
// `unfold`, `continually`, `from`, `fill` and `tabulate`. Each computes an element only when it is
// read, so a function or a by-name element is called once for each element read and never at the
// call, and an endless one is used through `take` and the other methods that stop.
class Point(val x: int, val y: int)

data Shape
    Circle(r: int)
    Square(side: int)

// Generic code reaches each companion function at an element type it does not know.
firstTwo[T](start: T, f: (T) -> T) -> Vector[T] = Iterator.iterate(start, f).take(2).toVector

repeated[T](n: int, x: T) -> Vector[T] = Iterator.fill(n, x).toVector

main()
    // empty: no element, at any type.
    println(Iterator.empty[int]().hasNext())
    println(Iterator.empty[string]().toVector)
    println(Iterator.empty[(int, string)]().size)
    val none: Iterator[Point] = Iterator.empty()
    println(none.isEmpty)

    // single: exactly one element, then none.
    val one = Iterator.single("ë")
    println(one.hasNext())
    println(one.next())
    println(one.hasNext())
    println(Iterator.single(Some(3)).toVector)
    println(Iterator.single((1, "a")).toList)

    // iterate: start first, then `f` of the one before, each call made when its result is read.
    var steps = 0
    val doubled: (int) -> int = x ->
        steps += 1
        x * 2
    val powers = Iterator.iterate(1, doubled)
    println(steps)
    println(powers.next())
    println(steps)
    println(powers.take(4).toVector)
    println(steps)
    println(Iterator.iterate("", s -> s + "ab").take(3).toVector)
    println(firstTwo(Point(0, 0), p -> Point(p.x + 1, p.y - 1)).map(p -> s"${p.x},${p.y}"))
    println(firstTwo(Circle(1), s -> s match
        Circle(r) -> Square(r)
        Square(side) -> Circle(side + 1)))
    println(Iterator.iterate(0, x -> x + 1).takeWhile(x -> x < 5).sum)
    println(Iterator.iterate(1, x -> x).take(3).toVector)

    // unfold: the elements `f` gives while it gives `Some`; `f` called when another is asked for.
    var unfolds = 0
    val countdown: (int) -> Option[(string, int)] = n ->
        unfolds += 1
        if n == 0 then None else Some((s"#$n", n - 1))
    val down = Iterator.unfold(3, countdown)
    println(unfolds)
    println(down.hasNext())
    println(down.hasNext())
    println(unfolds)
    println(down.toVector)
    println(unfolds)
    println(down.hasNext())
    println(unfolds)
    println(Iterator.unfold(0, n -> None[(int, int)]).toVector)
    val fibs = Iterator.unfold((0, 1), p -> Some((p.0, (p.1, p.0 + p.1))))
    println(fibs.take(10).toVector)
    println(Iterator.unfold((0, 1), p -> Some((p.0, (p.1, p.0 + p.1)))).take(6).toVector)
    println(Iterator.unfold([1, 2, 3], xs -> if xs.isEmpty then None else Some((xs.sum, xs.tail))).toVector)

    // continually: the by-name element evaluated once for each element read, never at the call.
    var evaluated = 0
    val tick: () -> int = () ->
        evaluated += 1
        evaluated * 10
    val ticks = Iterator.continually(tick())
    println(evaluated)
    println(ticks.hasNext())
    println(evaluated)
    println(ticks.take(3).toVector)
    println(evaluated)
    println(Iterator.continually("x").take(0).toVector)
    println(Iterator.continually(Point(1, 2)).take(2).map(p -> p.x + p.y).toVector)

    // from: counting up by one, or by any step, at any integer type.
    println(Iterator.from(0).take(5).toVector)
    println(Iterator.from(-2).take(5).toVector)
    println(Iterator.from(10, 5).take(3).toVector)
    println(Iterator.from(10, -3).take(4).toVector)
    println(Iterator.from(7, 0).take(3).toVector)
    println(Iterator.from(long(4000000000)).take(2).toVector)
    println(Iterator.from(long(1), long(1000000000)).take(4).toVector)
    println(Iterator.from(i8(125)).take(3).toVector)
    println(Iterator.from(int.MaxValue - 1).take(2).toVector)
    println(Iterator.from(int.MaxValue).next())
    println(Iterator.from(int.MinValue, -1).next())
    println(Iterator.from(int.MinValue + 2, -1).take(3).toVector)
    println(Iterator.from(1).map(x -> x * x).filter(x -> x % 2 == 1).take(3).toVector)
    println(Iterator.from(1).zip(["a", "b"]).toVector)
    println(Iterator.from(1).map(x -> x * x).takeWhile(x -> x < 50).toVector)

    // fill: `count` elements, the by-name element evaluated as each is read.
    var made = 0
    val make: () -> string = () ->
        made += 1
        s"m$made"
    val filled = Iterator.fill(3, make())
    println(made)
    println(filled.next())
    println(made)
    println(filled.toVector)
    println(made)
    println(Iterator.fill(0, make()).toVector)
    println(Iterator.fill(-4, make()).hasNext())
    println(made)
    println(repeated(2, (1, 'é')))
    println(repeated(3, Square(2)))
    println(Iterator.fill(2, [1, 2]).toVector)

    // tabulate: `count` elements, `f(i)` computed as the element at `i` is read.
    var calls = 0
    val square: (int) -> int = i ->
        calls += 1
        i * i
    val squares = Iterator.tabulate(5, square)
    println(calls)
    println(squares.take(2).toVector)
    println(calls)
    println(Iterator.tabulate(5, square).size)
    println(calls)
    println(Iterator.tabulate(0, square).toVector)
    println(Iterator.tabulate(-1, square).toVector)
    println(Iterator.tabulate(3, i -> "αβγ".take(i + 1)).toVector)
    println(Iterator.tabulate(1, i -> i).toVector)

    // Many allocations through one pipeline, as a collection running at every allocation sees them.
    val words = Iterator.tabulate(2000, i -> s"w$i").map(w -> w + "!").toVector
    println(words.length)
    println(words(1999))
    println(Iterator.iterate(List(0), xs -> xs.length :: xs).take(300).map(xs -> xs.length).sum)
