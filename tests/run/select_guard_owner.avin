// expect: exit 0
// A `readable()` or `writable()` arm guarded off does not use its stream, so naming a connection that
// belongs to another thread in such an arm does not trap: the arm's stream is not even evaluated.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.threads.{Channel, spawn}

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

main()
  val l = ok(TcpListener.bind("127.0.0.1", 0))
  val c = ok(TcpStream.connect("127.0.0.1", l.port()))
  val s = ok(l.accept())
  val go = Channel[int](1)
  val t = spawn(() ->
    go.receive()
    ok(c.close()))
  go.send(1)
  val mine = false
  println(select
    c.readable() if mine -> "readable"
    c.writable() if mine -> "writable"
    go.receive() if mine -> "received"
    else "every arm off")
  t.join()
  ok(s.close())
