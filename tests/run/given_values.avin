// expect: exit 0
// A function or method taken as a value has its `using` section filled where it is taken, so the
// value takes the parameters before the section: `rows.map(insert)` is `rows.map(row -> insert(row))`
// with the given in scope there captured. A function, a function of the section alone, a generic one,
// one with a repeated parameter, a local function, a method of a value, a method named in its own
// class, an object's method, an object's `apply`, a constructor, a trait method through a trait-typed value, an overload
// chosen by the expected type; the given found at every level (a block, a `using` lambda, the
// function's own section, a class's constructor, an object's body, the module); and the section's
// default where no given is in scope, computed at each call as the call's would be.

data Tx(id: int)

class Clock(val start: long)

var ticks: long = 0

nextClock() -> Clock
  ticks += 1
  Clock(ticks)

given moduleTx = Tx(100)

insert(row: int, using tx: Tx) -> int = row * 10 + tx.id

tag(using tx: Tx) -> int = tx.id

now(using clock: Clock = nextClock()) -> long = clock.start

total(xs: int*, using tx: Tx) -> int = xs.sum + tx.id

pairWith[T](x: T, using tx: Tx) -> (T, int) = (x, tx.id)

describe(n: int, using tx: Tx) -> string = s"int $n in ${tx.id}"

describe(s: string, using tx: Tx) -> string = s"string $s in ${tx.id}"

withTx[T](tx: Tx, body: (Tx) -> T) -> T = body(tx)

trait Store
  put(row: int, using tx: Tx) -> string

class MemoryStore(): Store
  override put(row: int, using tx: Tx) -> string = s"memory $row/${tx.id}"

class DiskStore(): Store
  override put(row: int, using tx: Tx) -> string = s"disk $row/${tx.id}"

class Log(prefix: string)
  write(s: string, using tx: Tx) -> string = s"$prefix$s#${tx.id}"

class Order(id: int, using tx: Tx)
  show() -> string = s"order $id in ${tx.id}"

class Service(using tx: Tx)
  stamp(s: string) -> string = s"$s@${tx.id}"
  stampAll(xs: Vector[string]) -> Vector[string] = xs.map(stamp)
  inserted(xs: Vector[int]) -> Vector[int] = xs.map(insert)

object Maker
  apply(n: int, using tx: Tx) -> string = s"made $n/${tx.id}"

object Session
  given current = Tx(7)
  run(xs: Vector[int]) -> Vector[int] = xs.map(insert)

// The section's own parameter fills a value taken in the body, and recursion through it.
countdown(n: int, using tx: Tx) -> Vector[int]
  if n == 0 then return Vector()
  val step = countdown
  step(n - 1) :+ insert(n)

moduleLevel() -> Vector[int] = [1, 2].map(insert)

main()
  println(moduleLevel())
  given t = Tx(1)
  println([1, 2].map(insert))
  val f = tag
  println(f())
  val g: (Vector[int]) -> int = total
  println(g([1, 2, 3]))
  println(g(Vector()))
  val p: (string) -> (string, int) = pairWith
  println(p("a"))
  val q = pairWith[bool]
  println(q(true))
  local(n: int, using tx: Tx) -> int = n + tx.id
  println([10, 20].map(local))
  val log = Log("> ")
  println(["a", "b"].map(log.write))
  println([5, 6].map(Order).map(o -> o.show()))
  println([7].map(Maker))
  val stores: Vector[Store] = [MemoryStore(), DiskStore()]
  for s in stores
    println([3].map(s.put))
  val di: (int) -> string = describe
  val ds: (string) -> string = describe
  println(s"${di(4)}, ${ds("x")}")
  println(Service(tx = Tx(2)).stampAll(["a", "b"]))
  println(Service(tx = Tx(3)).inserted([1]))
  println(Session.run([1, 2]))
  println(countdown(3))
  println(withTx(Tx(8), using tx -> [1, 2].map(insert)))
  // The given is the one in scope where the value is taken, wherever it is called.
  val outer = insert
  val inner =
    given nearer = Tx(4)
    insert
  println(s"${outer(1)} ${inner(1)}")
  // With no given in scope, the default, computed at each call of the value.
  val clocked = now
  println(s"${clocked()} ${clocked()} ${ticks}")
  given c = Clock(50)
  val fixed = now
  println(s"${fixed()} ${fixed()} ${ticks}")
