// expect: trap
// A request's total timeout of zero, no limit, is one; below zero by a microsecond, it traps as the
// request is made, by `withTotalTimeout` as by the constructor.
import avin.net.http.Request
import avin.time.{Duration, micros}

main()
  println(Request("GET", "http://x/", totalTimeout = Duration.Zero).totalTimeout)
  _ = Request("GET", "http://x/").withTotalTimeout(micros(-1))
