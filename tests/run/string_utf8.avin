// expect: exit 0
// `s.utf8` is the bytes of a string's encoding in a new array, as many as `byteLength`, the same
// bytes `bytes` gives as a vector: one per ASCII character, two to four for the others. Each call
// makes a new array, so writing to one leaves the string and every other array as they were, and
// `string.fromUtf8` reads the array back to the same string.
show(a: Array[byte]) -> string = a.map(b -> f"${b}%02x").mkString(" ")

main()
    println(show("".utf8), "".utf8.length)
    println(show("A".utf8))
    println(show("héllo".utf8), "héllo".utf8.length, "héllo".byteLength)
    println(show("€".utf8), show("😀".utf8), show("\u{0}".utf8))
    val text = "naïve 😀 日本"
    val bytes = text.utf8
    println(bytes.length == text.byteLength, bytes.toVector == text.bytes)
    println(string.fromUtf8(bytes) == Ok(text))
    // A fresh array each time, owned by its caller.
    val first = text.utf8
    first(0) = byte(0x4e)
    println(string.fromUtf8(first) == Ok("Naïve 😀 日本"), text, show(text.utf8.slice(0, 1)))
    // Every byte value a character can encode to, round tripped.
    var all = ""
    for c in 1..<256 do all = all + char(c).toString()
    println(all.utf8.length, string.fromUtf8(all.utf8) == Ok(all))
    // Many arrays at once, kept alive while more are made.
    val held = Vector.tabulate(200, i -> s"item $i é".utf8)
    var total = 0
    for a in held do total += a.length
    println(total, string.fromUtf8(held(199)) == Ok("item 199 é"))
