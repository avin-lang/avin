// expect: exit 0
// An `IoError` names what was being done and what to: its display is `cannot <operation> <subject>:
// <description>`, for every operation of `avin.fs` that can fail, and a program still tells
// failures apart by the kind, through a pattern, a guard or `==`.
import avin.fs
import avin.io
import avin.io.{ErrorKind, IoError, NotFound, PermissionDenied, AlreadyExists, IsADirectory, NotADirectory, DirectoryNotEmpty, InvalidUtf8, ConnectionRefused, ConnectionReset, TimedOut, Other}

// What a failure is, told by its kind.
kindName(e: IoError) -> string = e match
    IoError(NotFound, _, _) -> "not found"
    IoError(AlreadyExists, _, _) -> "exists"
    IoError(InvalidUtf8(at), _, _) -> s"utf8 at $at"
    _ if e.kind == IsADirectory -> "a directory"
    _ -> "other"

// The temporary directory the test works in, written as `DIR` in what it prints.
var root = ""

show[T](r: Result[T, IoError])
    r match
        Ok(_) -> println("ok")
        Err(e) -> println(s"${e.toString().replace(root, "DIR")} [${kindName(e)}]")

main()
    // Each kind's description, the same on every platform.
    val kinds = [NotFound, PermissionDenied, AlreadyExists, IsADirectory, NotADirectory, DirectoryNotEmpty,
                 InvalidUtf8(7), ConnectionRefused, ConnectionReset, TimedOut, Other("custom")]
    for k in kinds do println(k.description)
    // With neither operation nor subject, the description alone; with an operation, `cannot …: …`;
    // with a subject alone, `subject: …`.
    println(IoError(NotFound))
    println(IoError(Other("disk on fire")))
    println(IoError(TimedOut, "read"))
    println(IoError(NotFound, "", "x.txt"))
    println(IoError(PermissionDenied, "write", "/etc/passwd"))
    println(IoError(NotFound, "read", "naïve ✓.txt"))
    // An empty description leaves its `: ` out.
    println(IoError(Other(""), "read", "f"))
    println(IoError(Other(""), "", "g"))
    println(s"[${IoError(Other(""))}]")
    // The message is the display; an `IoError` has no cause.
    val e = IoError(NotFound, "read", "a")
    println(e.message == s"$e")
    println(e.cause.isEmpty)
    // Equal by kind, operation and subject.
    println(e == IoError(NotFound, "read", "a"))
    println(e == IoError(NotFound, "write", "a"))
    println(e.kind == NotFound)
    println(e.operation)
    println(e.subject)

    val dir = fs.createTempDir("avin-io-error-display").ok.get
    root = dir
    val missing = dir + "/missing.txt"
    show(fs.readText(missing))
    show(fs.readBytes(missing))
    show(fs.writeText(dir + "/no/such/dir/f", "x"))
    show(fs.appendText(dir + "/no/f", "x"))
    show(fs.writeBytes(dir + "/no/f", Array.empty[byte]()))
    show(fs.appendBytes(dir + "/no/f", Array.empty[byte]()))
    show(fs.remove(missing))
    show(fs.remove(dir))
    show(fs.removeDir(missing))
    show(fs.removeDirAll(dir + "/no/such"))
    show(fs.rename(missing, dir + "/b.txt"))
    show(fs.createDir(dir))
    show(fs.createDir(dir + "/no/such"))
    fs.writeText(dir + "/file", "x")
    show(fs.createDirAll(dir + "/file/sub"))
    show(fs.metadata(missing))
    show(fs.size(missing))
    show(fs.modified(missing))
    show(fs.listDir(missing))
    show(fs.listDir(dir + "/file"))
    show(fs.open(missing))
    show(fs.open(dir))
    show(fs.openUpdate(dir))
    show(fs.create(dir + "/no/f"))
    show(fs.append(dir + "/no/f"))
    show(fs.createUpdate(dir + "/no/f"))
    show(fs.readTail(missing, 10))
    show(fs.readTailLines(missing, 2))
    show(fs.readBytesFrom(missing, 0))
    fs.createDir(dir + "/full")
    fs.writeText(dir + "/full/x", "x")
    show(fs.removeDir(dir + "/full"))
    // Text that is not UTF-8 names the byte, and the file.
    fs.writeBytes(dir + "/bad", Array.tabulate(2, i -> if i == 0 then byte(int('a')) else byte(0xff)))
    show(fs.readText(dir + "/bad"))
    // An open file's errors name the file it was opened as.
    val f = fs.open(dir + "/file").ok.get
    show(f.write(Array.fill(1, byte(1))))
    show(f.seek(-1))
    f.close()
    show(f.read(1))
    show(f.readLine())
    show(f.size())
    show(f.position())
    show(f.flush())
    val w = fs.create(dir + "/w").ok.get
    show(w.read(1))
    w.close()
    show(w.writeText("x"))
    fs.removeDirAll(dir)
