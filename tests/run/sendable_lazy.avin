// expect: exit 0
// A `lazy val` field is sendable where its type is, since exactly one thread runs its initializer:
// a class, a generic class at a sendable argument and an object holding one are sendable, and the
// threads they are handed to, unread, read the value first together and see one value.
import avin.threads.{sleep, Atomic, Channel, scope}
import avin.time.millis

class Report(title: string)
  val runs = Atomic(0)
  lazy val heading: string =
    runs.add(1)
    sleep(millis(5))
    s"== $title =="

class Gen[T](x: T)
  lazy val v: Vector[T] = [x, x]

val tableRuns = Atomic(0)

object Table
  lazy val rows: Vector[int] =
    tableRuns.add(1)
    sleep(millis(5))
    (0 ..< 10).toVector

// Hands `x` to four threads through a channel; each gives back what `read` makes of it.
handOver[T: Sendable](x: T, @sendable read: (T) -> int) -> int
  val ch = Channel[T](4)
  val sum = Atomic(0)
  scope(s ->
    for _ in 0 ..< 4
      s.spawn(() ->
        ch.receive() match
          Some(v) -> sum.add(read(v))
          None -> 0)
    for _ in 0 ..< 4
      ch.send(x))
  sum.load()

main() -> int
  val r = Report("lazy")
  println(handOver(r, x -> x.heading.byteLength))
  println(handOver(Gen("ab"), g -> g.v.length + g.v(1).byteLength))
  println(handOver(Table, t -> t.rows.sum))
  println(s"runs ${r.runs.load()} ${tableRuns.load()}, ${r.heading}")
  0
