// Every collection of displayable elements joins into a string with `mkString`: with the default
// separator, with one given, and between a start and an end; empty and with one element. A map joins
// its entries as `key: value`. A bounded type parameter reaches `mkString` through its bound.
joinAll[T: Display](xs: List[T], ys: Vector[T]) -> string = xs.mkString("+") + " / " + ys.mkString("(", " ", ")")

main()
    val list: List[int] = [1, 2, 3]
    println(list.mkString())
    println(list.mkString("-"))
    println(list.mkString("[", "; ", "]"))
    val none: List[int] = []
    println("<" + none.mkString() + ">")
    println(none.mkString("{", ",", "}"))
    val one: List[string] = ["solo"]
    println(one.mkString(" and "))

    val vector: Vector[string] = ["a", "b", "c"]
    println(vector.mkString(""))
    println(vector.mkString("<", "|", ">"))
    val noVector: Vector[int] = []
    println("<" + noVector.mkString() + ">")

    val array: Array[real] = [1.5, 2.0]
    println(array.mkString(" "))
    val noArray: Array[int] = Array.empty()
    println("(" + noArray.mkString("x") + ")")

    val buffer = Buffer[char]()
    println("<" + buffer.mkString() + ">")
    buffer.addOne('a')
    println(buffer.mkString())
    buffer.addOne('z')
    println(buffer.mkString(".."))

    val set = Set[int]().incl(4)
    println(set.mkString("[", ", ", "]"))
    println("<" + Set[int]().mkString() + ">")

    val map = Map[string, int]().updated("a", 1)
    println(map.mkString())
    println(map.mkString("{", "; ", "}"))
    println("<" + Map[string, bool]().mkString() + ">")

    println(joinAll([true, false], [false]))
    val lists: List[List[int]] = [[1, 2], []]
    println(lists.mkString(" | "))
