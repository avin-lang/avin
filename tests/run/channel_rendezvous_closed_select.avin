// expect: trap
// A select waiting to send on a channel of capacity zero wakes to the channel's close and traps, as a
// send arm on a closed channel does; a select waiting to receive from one wakes to its `None` arm.
import avin.threads.{Channel, sleep, spawn}
import avin.time.millis

main()
  val ch = Channel[int](0)
  val receiving = spawn(() -> select
    ch.receive() as Some(x) -> s"value $x"
    ch.receive() as None -> "closed")
  val closer = spawn(() ->
    sleep(20.millis)
    ch.close())
  println(receiving.join())
  val other = Channel[int](0)
  val closer2 = spawn(() ->
    sleep(20.millis)
    other.close())
  println("selecting")
  select
    other.send(1) -> println("not reached")
  println("not reached", closer.join(), closer2.join())
