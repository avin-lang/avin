// expect: trap
// A request line needs at least one byte, so a header limit of zero traps where the server starts.
import avin.net.http
import avin.net.http.Response

main()
  println(http.serve("127.0.0.1", 0, _ -> Response.empty(204), maxHeaderBytes = 1).map(s -> s.shutdown()).isOk)
  println(http.serve("127.0.0.1", 0, _ -> Response.empty(204), maxHeaderBytes = 0).isOk)
