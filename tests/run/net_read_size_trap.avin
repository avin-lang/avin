// expect: trap
// A read takes at least one byte, so a read of none traps at the call.
import avin.net.{TcpListener, TcpStream}

main()
    TcpListener.bind("127.0.0.1", 0) match
        Ok(l) -> TcpStream.connect("127.0.0.1", l.port()) match
            Ok(s) ->
                println(s.writeText("sent").isOk())
                println(s.read(0).isOk())
            Err(e) -> println(e.message())
        Err(e) -> println(e.message())
