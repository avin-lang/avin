// expect: exit 0
// stderr: actor numbers vary
// HTTPS: the HTTP server serving TLS with a certificate a test authority issued for `localhost` and
// `127.0.0.1`, and the client fetching `https` URLs, trusting that authority through `withTls`.
// `GET` and `POST`, a body far larger than one TLS record each way, a connection kept alive for
// several requests over TLS, many clients at once on lightweight threads, a redirect from `http` to
// `https`, and the failures: a certificate the client does not trust, an expired one, a server that
// does not speak TLS, a certificate to trust that is not PEM, a handshake that times out, a
// handshake that fails leaving the server serving, and a handler that traps on a TLS connection.
import avin.fs
import avin.io.{IoError, TimedOut}
import avin.net.{TcpListener, TcpServer, TcpStream}
import avin.net.http
import avin.net.http.{HttpError, Io, Request, Response, ServerRequest, Tls}
import avin.net.tls.{Certificate, Credentials, Handshake, TlsClient, TlsError, TlsServer, TlsStream}
import avin.threads.spawn
import avin.time
import avin.time.millis

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(s"unexpected error: ${e.message}")

fetched[T](r: Result[T, HttpError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(s"unexpected error: ${e.message}")

// A test certificate or key, from the repository root or from `compiler/`.
fixture(name: string) -> string
    val here = "tests/fixtures/tls/" + name
    ok(fs.readText(if fs.exists(here) then here else "../" + here))

identity(certificate: string) -> TlsServer = TlsServer.of(fixture(certificate), fixture("localhost.key")) match
    Ok(s) -> s
    Err(e) -> fail(e.message)

trusting() -> TlsClient = TlsClient().trust(fixture("ca.pem"))

// What a failed request was, by kind.
failure(r: Result[Response, HttpError]) -> string = r match
    Ok(response) -> s"answered ${response.status}"
    Err(Tls(Certificate(_, _))) -> "certificate refused"
    Err(Tls(Handshake(_))) -> "handshake failed"
    Err(Tls(Credentials(_))) -> "credentials"
    Err(Io(IoError(TimedOut, _, _))) -> "timed out"
    Err(e) -> s"other: ${e.message}"

handle(r: ServerRequest) -> Response = r.target match
    "/big" -> Response.bytes(200, Array.tabulate(3 * 1024 * 1024, i -> byte(i % 253)), "application/octet-stream")
    "/trap" -> fail("the handler gave up")
    _ -> Response.text(200, s"${r.method} ${r.target} ${r.text.byteLength} bytes")

main()
    val server = ok(http.serve("127.0.0.1", 0, handle, maxBodyBytes = 4 * 1024 * 1024, tls = Some(identity("localhost.pem"))))
    val base = s"https://localhost:${server.port()}"

    // A request and its answer, by host name and by address.
    println(fetched(http.send(Request("GET", s"$base/hello").withTls(trusting()))).text)
    println(fetched(http.send(Request("GET", s"https://127.0.0.1:${server.port()}/by-address").withTls(trusting()))).text)
    val posted = Request("POST", s"$base/post").withHeader("Content-Type", "text/plain").withBody("héllo").withTls(trusting())
    println(fetched(http.send(posted)).text)

    // Large bodies each way.
    val big = fetched(http.send(Request("GET", s"$base/big").withTls(trusting())))
    var same = big.body.length == 3 * 1024 * 1024
    for i in 0..<big.body.length
        if big.body(i) != byte(i % 253) then same = false
    println(s"a large body: ${big.body.length} bytes, as sent: $same")
    val upload = Request("PUT", s"$base/upload").withBody(Array.fill(3 * 1024 * 1024, byte(7))).withTls(trusting())
    println(fetched(http.send(upload)).text)

    // One TLS connection kept alive for three requests.
    val kept = TlsStream.connect("localhost", server.port(), trusting()) match
        Ok(s) -> s
        Err(e) -> fail(e.message)
    ok(kept.setTimeout(time.seconds(20)))
    for i in 1..3
        ok(kept.writeText(s"GET /kept/$i HTTP/1.1\r\nHost: localhost\r\n\r\n"))
        var length = 0
        while true
            val line = ok(kept.readLine()).getOrElse("")
            if line.isEmpty then break
            if line.toLower.startsWith("content-length:") then length = line.slice(15, line.byteLength).trim.toInt()
        println(s"kept alive: ${string.fromUtf8Lossy(ok(kept.read(length)))}")
    _ = kept.close()

    // Many clients at once, each on a lightweight thread of its own.
    val clients = (0..<48).map(i -> spawn(() ->
        val answer = http.send(Request("GET", s"https://localhost:${server.port()}/client/$i").withTls(trusting()))
        answer.map(r -> r.text == s"GET /client/$i 0 bytes").getOrElse(false))).toVector
    var answered = 0
    for c in clients
        if c.join() then answered += 1
    println(s"$answered of 48 answered")

    // A redirect from `http` to `https` keeps the request's TLS settings.
    val plain = ok(http.serve("127.0.0.1", 0, r -> Response.empty(301).withHeader("Location", s"$base/redirected")))
    println(fetched(http.send(Request("GET", s"http://127.0.0.1:${plain.port()}/start").withTls(trusting()))).text)

    // The machine's store alone does not know the test authority, and an `https` URL spoken to a
    // server that does not speak TLS fails its handshake.
    println(failure(http.get(s"$base/untrusted")))
    println(failure(http.send(Request("GET", s"https://localhost:${plain.port()}/").withTls(trusting()))))
    println(failure(http.send(Request("GET", s"$base/").withTls(TlsClient().trust("not PEM")))))
    plain.shutdown()

    // An expired certificate.
    val stale = ok(http.serve("127.0.0.1", 0, handle, tls = Some(identity("expired.pem"))))
    println(failure(http.send(Request("GET", s"https://localhost:${stale.port()}/").withTls(trusting()))))
    stale.shutdown()

    // A server that accepts and never answers times the handshake out by the request's limit.
    val silent = ok(TcpListener.bind("127.0.0.1", 0))
    println(failure(http.send(Request("GET", s"https://localhost:${silent.port()}/").withTimeout(millis(200)).withTls(trusting()))))
    _ = silent.close()

    // A handshake that fails, and a client that sends no TLS at all, leave the server serving.
    val raw = ok(TcpStream.connect("127.0.0.1", server.port()))
    ok(raw.writeText("GET / HTTP/1.1\r\n\r\n"))
    println(s"plain text to the TLS server: ${ok(raw.readAll()).length >= 0}")
    _ = raw.close()
    println(fetched(http.send(Request("GET", s"$base/still").withTls(trusting()))).text)

    // A handler that traps closes its TLS connection, unanswered, and the server goes on.
    println(failure(http.send(Request("GET", s"$base/trap").withTls(trusting()))).startsWith("other"))
    println(fetched(http.send(Request("GET", s"$base/after").withTls(trusting()))).text)

    server.shutdown()
