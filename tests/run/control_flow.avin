// if, while, break and continue, and the order operands are evaluated in.

side(label: string, value: int) -> int
    print(label)
    value

yes(label: string) -> bool
    print(label)
    true

no(label: string) -> bool
    print(label)
    false

label(n: int) -> string
    if n < 0 then "negative"
    elif n == 0 then "zero"
    else "positive"

main()
    print(label(-5))
    print(label(0))
    print(label(5))
    // `&&` and `||` evaluate their right operand only when it decides the result.
    if no("a") && yes("never") then print("wrong")
    if yes("b") || yes("never") then print("or")
    // A chain evaluates each middle operand once and stops at the first false link.
    if side("one", 1) < side("two", 2) < side("three", 3) then print("ascending")
    if side("four", 4) < side("zero", 0) < side("never", 9) then print("wrong")
    // `continue` returns to the test; `break` leaves the loop.
    var i = 0
    while i < 10 do
        i += 1
        if i % 2 == 0 then continue
        if i > 6 then break
        if i == 3 then print("three") else print("odd")
    // A loop yields its `else` on normal completion, or a `break` value.
    var n = 0
    val found = while n < 10 do
        n += 1
        if n * n > 20 then break "found"
    else "missing"
    print(found)
    val exhausted = while n < 3 do
        break "early"
    else "finished"
    print(exhausted)
    // `break` leaves only the innermost loop.
    var outer = 0
    while outer < 2 do
        outer += 1
        while true do break
        print("outer")
