// expect: exit 0
// Inside brackets whose commas separate items (call arguments, tuple, list, set and map literals,
// a `with` change), a comma ends a one-line arm's body, the `match` and the item it stands in, so
// the items after it are the list's own; a tuple there is written in parentheses. A block opened
// inside the brackets starts a line again, where a comma list is a tuple without parentheses.

pair(n: int, s: string) -> string = s"$n:$s"

three(a: int, b: int, c: int) -> int = a * 100 + b * 10 + c

first(t: (int, int), s: string) -> string = s"${t.0}/${t.1}/$s"

apply(f: int -> int, n: int) -> int = f(n)

count(xs: Vector[int], k: int) -> string = s"$xs+$k"

data Point(x: int, y: int)

kind(x: int) -> string = pair(x match
  1 -> 10
  _ -> 0, "a")

main()
  // The last arm, followed by an argument on the same line.
  println(kind(1))
  println(kind(7))
  // A middle argument: the match ends at its comma, the third argument follows.
  val n = 2
  println(three(1, n match
    2 -> 5
    _ -> 6, 9))
  // The comma at the end of the line, the next argument on the line after the arms.
  println(pair(n match
    2 -> 4
    _ -> 0,
    "next"))
  // A named argument after the match.
  println(pair(s = "named", n = n match
    2 -> 8
    _ -> 0))
  println(pair(n = n match
    2 -> 3
    _ -> 0, s = "after"))
  // An `else` arm ends the same way.
  println(pair(n match
    1 -> 1
    else 2, "else"))
  // A tuple body in parentheses is still one value.
  println(first(n match
    2 -> (1, 2)
    _ -> (0, 0), "t"))
  // Nested: the inner match is the outer arm's body, inside brackets of its own.
  println(pair(n match
    2 -> three(n match
      2 -> 1
      _ -> 2, 3, 4)
    _ -> 0, "nested"))
  // Nested without brackets of its own: the comma ends both matches.
  println(pair(n match
    2 -> n + 1 match
      3 -> 30
      _ -> 31
    _ -> 0, "both"))
  // A vector literal and a tuple.
  val xs = [n match
    2 -> 7
    _ -> 0, 9]
  println(xs)
  val t = (n match
    2 -> 1
    _ -> 0, "x")
  println(t.0)
  println(t.1)
  // A set and a map literal.
  val s: Set[int] = {n match
    2 -> 5
    _ -> 6, 7}
  println(s.size)
  val m = {"a": n match
    2 -> 1
    _ -> 0, "b": 2}
  println(m("a"))
  println(m("b"))
  // A `with` change.
  val p = Point(1, 1)
  val q = p with {x = n match
    2 -> 5
    _ -> 0, y = 6}
  println(s"${q.x} ${q.y}")
  // A one-line `match` function, an `if`, a lambda and a `yield` stop at the comma too.
  println(apply(match x -> x + 1, 2))
  println(pair(if n > 1 then 1 else 2, "if"))
  println(apply(x -> x * 3, 4))
  println(count(for x in 1 .. 2 yield x * 10, 5))
  // An indented arm body is a block: a comma list there is a tuple without parentheses.
  println(first(n match
    2 ->
      1, 2
    _ -> (0, 0), "block"))
  // At statement level an arm's body fills a line, so a comma list is a tuple.
  val u = n match
    2 -> 4, 5
    _ -> 0, 0
  println(u.1)
