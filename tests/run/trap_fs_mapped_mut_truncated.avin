// expect: trap
// A write through a writable mapping to a page the file no longer reaches stops the program with the
// bus error trap rather than writing memory nothing reads.
import avin.fs

main()
  val dir = fs.createTempDir("avin-mapped-trap").toOption.get
  val path = dir + "/a"
  _ = fs.writeBytes(path, Array.fill(3 * 16384, byte(7)))
  val m = fs.mapFileMutable(path).toOption.get
  val f = fs.openUpdate(path).toOption.get
  _ = f.setLength(0)
  _ = f.close()
  _ = fs.removeDirAll(dir)
  m(2 * 16384) = byte(1)
  println("unreachable")
