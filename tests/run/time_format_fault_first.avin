// expect: trap
// The whole pattern is read before anything is written: a malformed run later in a pattern traps
// as malformed even where an earlier element is one the value lacks.
import avin.time.{date}

main()
    println(date(2026, 8, 28).format("YYYY"))
    println(date(2026, 8, 28).format("hh YYY"))
