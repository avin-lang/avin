// expect: exit 0
// `?` in a function declaring a union of errors passes each kind on with no wrapper type. An error
// converting to the union is passed on as it is: a member, a subclass of a member, a narrower union,
// a scalar injected. Otherwise the one member implementing `From` at the error's type makes it.
// Otherwise an error union is converted member by member, by each member's own conversion. Otherwise
// the existing `From` rule applies. A result already made is the wider result where its errors are
// references; a scalar one is rebuilt by `mapErr(e -> e)`. `?` on an `Option` is unaffected.

data ParseError(line: int)
data Invalid(why: string)
data NetError(host: string)
data ConfigError(msg: string)

open class IoError(val path: string)
    describe() -> string = s"io error at $path"

class Missing(path: string): IoError(path)
    override describe() -> string = s"missing $path"

impl From[IoError] for ConfigError
    static from(e: IoError) -> ConfigError = ConfigError(s"config: ${e.describe()}")

impl From[ParseError] for ConfigError
    static from(e: ParseError) -> ConfigError = ConfigError(s"config: line ${e.line}")

data Wrapped(inner: string)

impl From[NetError] for Wrapped
    static from(e: NetError) -> Wrapped = Wrapped(s"net ${e.host}")

readText(p: string) -> Result[string, IoError] = p match
    "" -> Err(IoError("nowhere"))
    "?" -> Err(Missing("?"))
    _ -> Ok(p)

parseIt(t: string) -> Result[int, ParseError] = if t.startsWith("x") then Err(ParseError(t.charCount)) else Ok(t.charCount)

fetch(host: string) -> Result[string, NetError] = if host == "down" then Err(NetError(host)) else Ok(s"page of $host")

// Rule 1: each kind is a member; a subclass of a member is that member.
load(p: string) -> Result[int, IoError | ParseError]
    val text = readText(p)?
    val n = parseIt(text)?
    Ok(n)

// Rule 1: a narrower union inside a wider one.
checked(p: string) -> Result[int, IoError | ParseError | Invalid]
    val n = load(p)?
    if n > 5 then Err(Invalid("too long")) else Ok(n)

// Rule 2: the one member with `From` at the error's type converts it.
config(p: string) -> Result[string, ConfigError | NetError]
    val text = readText(p)?
    val page = fetch(text)?
    Ok(page)

// Rule 3: a union into a plain type, member by member.
settings(p: string) -> Result[int, ConfigError]
    val n = load(p)?
    Ok(n * 10)

// A union into another union it does not convert to: each member by itself, here by rule 2.
mixed(p: string) -> Result[int, ConfigError | Invalid]
    val n = load(p)?
    if n == 0 then Err(Invalid("empty")) else Ok(n)

// Rule 4: unchanged, into a plain type through its `From`.
wrapped(host: string) -> Result[string, Wrapped]
    val page = fetch(host)?
    Ok(page)

// A scalar error injected into a union with a scalar member.
code(n: int) -> Result[int, int | string]
    val r: Result[int, int] = if n > 0 then Ok(n) else Err(n)
    val v = r?
    val w: Result[int, string] = if v > 100 then Err("too big") else Ok(v)
    Ok(w?)

// A result already made, its errors references, is the wider result as it is.
widened(p: string) -> Result[string, IoError | ParseError] = readText(p)

// A scalar error union is rebuilt by `mapErr(e -> e)`.
rebuilt(n: int) -> Result[int, int | string]
    val r: Result[int, int] = if n > 0 then Ok(n) else Err(n)
    r.mapErr(e -> e)

firstChar(s: string) -> Option[char]
    val c = s.chars.headOption?
    Some(c)

shown(r: Result[int, IoError | ParseError | Invalid]) -> string = r match
    Ok(n) -> s"ok $n"
    Err(i: Invalid) -> s"err $i"
    Err(e: (IoError | ParseError)) -> s"err ${kind(e)}"

kind(e: IoError | ParseError) -> string = e match
    m: Missing -> m.describe()
    io: IoError -> io.describe()
    p: ParseError -> s"parse at ${p.line}"

main()
    for p in ["", "?", "xyz", "abc"]
        load(p) match
            Ok(n) -> println(s"loaded $n")
            Err(e) -> println(kind(e))
    println(shown(checked("abcdefg")))
    println(shown(checked("x")))
    println(shown(checked("ab")))
    for p in ["", "down", "up"]
        println(config(p))
    for p in ["?", "xx", "abc"]
        println(settings(p))
    println(s"${mixed("")} ${mixed("x")} ${mixed("ab")}")
    println(wrapped("down"))
    println(wrapped("up"))
    println(s"${code(-3)} ${code(0)} ${code(500)} ${code(7)}")
    println(s"${code(int.MinValue)} ${code(int.MaxValue)}")
    println(s"${rebuilt(-1)} ${rebuilt(2)}")
    println(widened("") match
        Err(e) -> kind(e)
        Ok(t) -> t)
    // A lambda with a declared union result uses `?` too.
    val both: (string) -> Result[int, IoError | ParseError] = p -> Ok(parseIt(readText(p)?)?)
    println(both("x1") match
        Err(e) -> kind(e)
        Ok(n) -> s"$n")
    println(both("") match
        Err(e) -> kind(e)
        Ok(n) -> s"$n")
    println(both("four") match
        Err(e) -> kind(e)
        Ok(n) -> s"$n")
    println(s"${firstChar("é")} ${firstChar("")}")
    // Many errors made and passed on, held across collections.
    var errors = 0
    for i in 0..<2000
        if load(if i % 3 == 0 then "" elif i % 3 == 1 then s"x$i" else "ok") is Err(_) then errors += 1
    println(errors)
