// expect: exit 0
// Variadic `apply` on the mutable `Map`, `Set`, `LinkedMap` and `LinkedSet`, as the mutable
// `TreeMap`, `TreeSet` and `BitSet` have it: later pairs replace earlier ones, a linked collection
// keeps first-insertion order, the result is a fresh mutable collection, and no arguments is empty.

import avin.collections.mutable.{Map, Set, LinkedMap, LinkedSet, TreeMap, TreeSet}

main(args: Vector[string])
  val m = Map((1, "a"), (2, "b"), (1, "c"))
  println(s"${m.size} ${m(1)} ${m(2)}")
  m(3) = "d"
  println(m.size)
  val other = Map((1, "a"))
  other(9) = "z"
  println(Map((1, "a")).size)

  val lm = LinkedMap(("x", 1), ("y", 2), ("z", 3), ("x", 9))
  println(lm.toVector)
  lm("w") = 4
  println(lm.size)

  val s = Set(3, 1, 3, 2)
  println(s"${s.size} ${s(1)} ${s(3)} ${s(9)}")
  val ls = LinkedSet("b", "a", "b", "c")
  println(ls.toVector)

  println(Map[int, int]().size)
  println(LinkedMap[string, int]().size)
  println(Set[int]().size)
  println(LinkedSet[int]().size)

  val one = Map(("k", 1))
  println(one.toVector)
  val typed: Map[string, int] = Map(("a", 1), ("b", 2))
  println(typed.size)
  val tm = TreeMap((2, "b"), (1, "a"))
  println(tm.toVector)
  println(TreeSet(3, 1, 2).toVector)
