// expect: exit 1
// A `main` that answers `Err` while lightweight threads and actors still run ends the program as a
// `main` that returns does: the error is written, the threads and actors are left where they are,
// the exit hooks run on the main thread after the error line, and the status is 1.
import avin.actors.{Behaviour, spawn}
import avin.process
import avin.threads
import avin.threads.{Channel, Promise}

main() -> Result[unit, string]
  process.onExit(() -> println("hook ran"))
  val never = Channel[int]()
  val started = Promise[unit]()
  threads.spawn(() ->
    started.complete(())
    never.receive()
    println("thread not reached"))
  started.future.await()
  val held = Promise[unit]()
  val a = spawn(Behaviour[int]("Held", me -> n ->
    held.tryComplete(())
    never.receive()
    println(s"handled $n")))
  for i in 0 ..< 100 do a.tell(i)
  held.future.await()
  println("main answers")
  Err(s"gave up with ${[1, 2, 3].map(n -> n * 2).mkString(", ")} pending")
