// expect: exit 0
// `def` is optional before every function and method declaration, and changes nothing about it:
// each declaration here is written once with `def` and once without, and the two agree. It goes
// after the modifiers (`private`, `static`, `override`) and after the annotations, and it is written
// on the signature of a function defined by clauses, not on its clauses.

def area(width: int, height: int) -> int = width * height
plainArea(width: int, height: int) -> int = width * height

def greet(name: string)
    println(s"hello, $name")

def twice[T](x: T) -> (T, T) = (x, x)

def fib(n: int) -> int
fib(n < 2) = n
fib(n) = fib(n - 1) + fib(n - 2)

def classify(n: int) -> string
classify(0) = "zero"
classify(n)
    | n < 0 = "negative"
    | _ = "positive"

def sum(xs: int*) -> int
    var total = 0
    for x in xs
        total += x
    total

def withDefault(a: int, b: int = 10) -> int = a + b

private def hidden() -> int = 7

@tailrec
def count(n: int, acc: int) -> int = if n == 0 then acc else count(n - 1, acc + 1)

def inferred(x: int) = x * 3

trait Shape
    def area() -> real
    def name -> string
    def describe() -> string = s"$name of area ${area()}"

trait Unit
    static def unit() -> Self

open class Rect(val w: real, val h: real): Shape, Unit
    override def area() -> real = w * h
    override def name -> string = "rect"
    def scaled(k: real) -> Rect = Rect(w * k, h * k)
    // With `def`, a member with no parameter list may leave its result type to be inferred.
    def perimeter = 2.0 * (w + h)
    private def secret() -> int = 1
    def reveal() -> int = secret() + 1
    override static def unit() -> Rect = Rect(1.0, 1.0)
    def +(other: Rect) -> Rect = Rect(w + other.w, h + other.h)

class Square(side: real): Rect(side, side)
    override def name -> string = "square"
    override def area() -> real = side * side

object Counter
    var n = 0
    def next() -> int
        n += 1
        n
    def current -> int = n

data Tree
    Leaf
    Node(left: Tree, value: int, right: Tree)

impl Tree
    def size -> int = self match
        Leaf -> 0
        Node(l, _, r) -> l.size + 1 + r.size
    def depth() -> int = self match
        Leaf -> 0
        Node(l, _, r) -> 1 + max(l.depth(), r.depth())
    def label(n: int) -> string
    label(0) = "none"
    label(n) = s"$n of $size"

impl int
    static def parity(n: int) -> string = if n % 2 == 0 then "even" else "odd"

trait Sized
    size -> int

impl Sized for string
    def size -> int = self.byteLength

def outer(n: int) -> int
    def inner(k: int) -> int = k + n
    plainInner(k: int) -> int = k + n
    def go(k: int) -> int
    go(0) = 0
    go(k) = 1 + go(k - 1)
    @tailrec
    def loopTo(i: int, acc: int) -> int = if i == 0 then acc else loopTo(i - 1, acc + i)
    inner(1) + plainInner(1) + go(3) + loopTo(4, 0)

main() =
    println(area(3, 4) == plainArea(3, 4))
    greet("def")
    println(twice("a"))
    println(fib(10))
    println(s"${classify(0)} ${classify(-3)} ${classify(5)}")
    println(sum(1, 2, 3))
    println(withDefault(1))
    println(withDefault(1, b = 2))
    println(hidden())
    println(count(1000, 0))
    println(inferred(4))
    val r = Rect(2.0, 3.0)
    println(r.describe())
    println(r.scaled(2.0).area())
    println(r.reveal())
    println(r.perimeter)
    println(Rect.unit().area())
    println((r + Rect.unit()).area())
    val s: Shape = Square(3.0)
    println(s.describe())
    println(s"${Counter.next()} ${Counter.next()} ${Counter.current}")
    val t = Node(Node(Leaf, 1, Leaf), 2, Node(Leaf, 3, Leaf))
    println(s"${t.size} ${t.depth()} ${t.label(0)} ${t.label(2)} ${int.parity(3)}")
    println("héllo".size)
    println(outer(10))
    // A function declared with `def` is a function value like any other.
    val f: (int, int) -> int = area
    println(f(5, 6))
    println([1, 2, 3].map(inferred))
