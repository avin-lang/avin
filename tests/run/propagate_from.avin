// expect: exit 0
// `?` converts an error through `From` where the enclosing function yields errors of another type:
// one error type implementing `From` once for each error it wraps, nested `?`, a function generic
// over its error type by one bound or several, a class stating its conformances in its header, an
// error converted at a type it is a value of, a generic error type, `?` in a lambda, and `Option`'s
// `?`, which converts nothing.

data IoError
    NotFound(path: string)

data ParseError
    BadNumber(text: string)

data AppError
    Io(cause: IoError)
    Parse(cause: ParseError)
    Code(code: int)

impl From[IoError] for AppError
    static from(value: IoError) -> AppError = Io(value)

impl From[ParseError] for AppError
    static from(value: ParseError) -> AppError = Parse(value)

impl From[int] for AppError
    static from(value: int) -> AppError = Code(value)

read(path: string) -> Result[string, IoError] =
    if path == "missing" then Err(NotFound(path)) elif path == "word" then Ok("forty") else Ok("42")

parse(text: string) -> Result[int, ParseError] = text.toIntOption() match
    Some(n) -> Ok(n)
    None -> Err(BadNumber(text))

checked(n: int) -> Result[int, int] = if n < 0 then Err(n) else Ok(n)

load(path: string, offset: int) -> Result[int, AppError]
    val text = read(path)?
    val n = parse(text)?
    checked(n - offset)?
    Ok(n)

nested(path: string) -> Result[int, AppError] = Ok(parse(read(path)?)? + 1)

lift[F: From[IoError]](path: string) -> Result[string, F]
    val text = read(path)?
    Ok(text)

loadAny[F: From[IoError] + From[ParseError]](path: string) -> Result[int, F]
    val n = parse(read(path)?)?
    Ok(n)

class Report(val text: string) : From[IoError], From[ParseError]
    override static from(value: IoError) -> Report = Report(s"io: $value")
    override static from(value: ParseError) -> Report = Report(s"parse: $value")

reported(path: string) -> Result[int, Report]
    val n = parse(read(path)?)?
    Ok(n)

open class Problem(val detail: string)

class Missing(detail: string) : Problem(detail)

data Outcome
    Failed(detail: string)

impl From[Problem] for Outcome
    static from(value: Problem) -> Outcome = Failed(value.detail)

find(name: string) -> Result[int, Missing] = if name == "" then Err(Missing("no name")) else Ok(name.byteLength)

found(name: string) -> Result[int, Outcome]
    val n = find(name)?
    Ok(n)

data Tagged[T]
    Tagged(value: T)

impl[T] From[T] for Tagged[T]
    static from(value: T) -> Tagged[T] = Tagged(value)

tagged(n: int) -> Result[int, Tagged[int]]
    val x = checked(n)?
    Ok(x * 2)

halve(n: int) -> Option[int] = if n % 2 == 0 then Some(n / 2) else None

quarter(n: int) -> Option[int] = Some(halve(halve(n)?)?)

show(r: Result[int, Report]) -> string = r match
    Ok(n) -> s"Ok($n)"
    Err(report) -> s"Err(${report.text})"

main()
    println(load("ok", 0))
    println(load("missing", 0))
    println(load("word", 0))
    println(load("ok", 50))
    println(nested("ok"))
    println(nested("word"))
    println(lift[AppError]("missing"))
    println(lift[AppError]("ok"))
    println(loadAny[AppError]("missing"))
    println(loadAny[AppError]("word"))
    println(loadAny[AppError]("ok"))
    println(show(reported("missing")))
    println(show(reported("word")))
    println(show(reported("ok")))
    println(found(""))
    println(found("abc"))
    println(tagged(-3))
    println(tagged(4))
    val viaLambda: (string) -> Result[int, AppError] = p -> Ok(parse(read(p)?)? * 10)
    println(viaLambda("ok"))
    println(viaLambda("missing"))
    println(quarter(8))
    println(quarter(6))
    println(AppError.from(7))
