// expect: trap
// Asking for the command's arguments where the parser declares no commands is the program's
// mistake, and traps; its `command` is empty.
import avin.cli

main()
  val a = cli.Parser("tool").flag("x").parse(["--x"]).ok.get
  println(s"command: `${a.command}`")
  println(a.commandArgs.flag("x"))
