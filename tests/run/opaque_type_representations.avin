// expect: exit 0
// An opaque type may be laid out as any type with values to lay out: a number, a string, a data
// value, an object, a tuple, a function, an `Option`, another opaque type, a `bool`, a `char` and
// a `byte`. Its values work as its representation's do, inside closures, loops, options, tuples
// and collections, and an object it holds is that very object.

data Pt(x: int, y: int)
class Cell(var n: int)

opaque type Meters = real
opaque type Feet = real
opaque type Name = string
opaque type Point = Pt
opaque type Handle = Cell
opaque type Pair = (int, string)
opaque type Fn = (int) -> int
opaque type Maybe = Option[int]
opaque type Inner = int
opaque type Outer = Inner
opaque type Flag = bool
opaque type Letter = char
opaque type Octet = byte

impl Meters
  def toFeet -> Feet = Feet(repr * 3.28084)
  plus(o: Meters) -> Meters = Meters(repr + o.repr)

impl Outer
  def inner -> Inner = repr
  def value -> int = repr.repr

which(x: Meters | Feet) -> string = x match
  m: Meters -> s"meters ${m.repr}"
  f: Feet -> s"feet ${f.repr}"

main()
  val m = Meters(2.0).plus(Meters(0.5))
  println(m.repr)
  println(which(m))
  println(which(m.toFeet))
  println(Name("é∑🙂").repr.charCount)
  println(Name("") == Name(""))
  val p = Point(Pt(1, 2))
  println(p.repr.x + p.repr.y)
  val c = Cell(1)
  val h = Handle(c)
  h.repr.n = 9
  println(c.n)
  println(Handle(c) == h)
  println(Pair((1, "a")).repr)
  val f = Fn(x -> x * 3)
  println(f.repr(4))
  println(Maybe(None).repr)
  println(Maybe(Some(3)) == Maybe(Some(3)))
  println(Outer(Inner(7)).value)
  println(Flag(true).repr && !Flag(false).repr)
  println(Letter('z').repr)
  println(Octet(byte(255)).repr)
  println(Inner(-2147483648).repr)
  val big = Inner(2147483647)
  println(big.repr)
  val k = 5
  val add = (u: Inner) -> Inner(u.repr + k)
  println(add(Inner(1)).repr)
  var acc = Inner(0)
  for i in 1 .. 10
    acc = Inner(acc.repr + i)
  println(acc.repr)
  val opt: Option[Meters] = Some(Meters(1.5))
  println(opt.map(x -> x.repr))
  val pairs = [(Name("a"), Inner(1)), (Name("b"), Inner(2))]
  println(pairs.map((n, i) -> n.repr + i.repr.toString()))
  val big2 = (0 ..< 2000).map(i -> Name(s"n$i")).toVector
  println(big2.length)
  println(big2(1999).repr)
  val x: Any = Name("hi")
  println(x is Name)
  println(x is string)
  println(Name("q"))
