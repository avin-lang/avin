// expect: exit 0
// On `Any` and on trait-typed values, `==` is decided at run time by the values' own types: values of
// different types are unequal, and values of one type compare as that type does, by value, by its own
// `equals` or by identity. The hash follows the same entries.

data Point(x: int, y: int)

class Counter(val n: int)

class Name(val text: string)

impl Eq for Name
    equals(other: Name) -> bool = text == other.text

impl Hash for Name
    hash() -> long = text.hash()

trait Shape
    area() -> int

data Square(side: int)

impl Shape for Square
    area() -> int = side * side

class Disc(val r: int): Shape
    override area() -> int = 3 * r * r

open class Animal(val name: string)

class Dog(name: string): Animal(name)

impl Eq for Dog
    equals(other: Dog) -> bool = name == other.name

impl Hash for Dog
    hash() -> long = name.hash()

equal(a: Any, b: Any) -> bool = a == b

sameShape(a: Shape, b: Shape) -> bool = a == b

main()
    print(s"${equal(1, 1)} ${equal(1, 2)} ${equal(1, long(1))} ${equal(1, "1")} ${equal('a', 'a')} ${equal((), ())}")
    print(s"${equal("ab", "a" + "b")} ${equal("ab", "ba")} ${equal(true, true)} ${equal(1.5, 1.5)} ${equal(byte(1), byte(1))}")
    print(s"${equal(Point(1, 2), Point(1, 2))} ${equal(Point(1, 2), Point(2, 1))} ${equal(Point(1, 2), (1, 2))} ${equal((1, "a"), (1, "a"))}")
    val c = Counter(1)
    print(s"${equal(c, c)} ${equal(c, Counter(1))} ${equal(Name("x"), Name("x"))} ${equal(Name("x"), Name("y"))}")
    val f: int -> int = x -> x
    print(s"${equal(f, f)} ${equal(f, (x: int) -> x)}")
    val x: Any = Point(3, 4)
    print(s"${x == Point(3, 4)} ${Point(3, 4) == x} ${x != 5} ${x == x}")
    val s: Shape = Square(2)
    print(s"${sameShape(s, Square(2))} ${sameShape(s, Square(3))} ${sameShape(Disc(1), Disc(1))} ${sameShape(s, Disc(1))}")
    val d = Disc(2)
    print(s"${sameShape(d, d)} ${s == Square(2)} ${Square(2) == s}")
    val a: Animal = Dog("rex")
    val b: Animal = Dog("rex")
    print(s"${a == b} ${a == Animal("rex")} ${Animal("rex") == Animal("rex")}")
    print(s"${x.hash() == Point(3, 4).hash()} ${s.hash() == Square(2).hash()} ${a.hash() == b.hash()}")
    val n: Any = 7
    val m: Any = 7
    val t: Any = "seven"
    print(s"${n.hash() == m.hash()} ${t.hash() == "seven".hash()}")
