// Lambdas where their result is not used or is used by a guard: a lambda whose value is dropped
// because its context is `unit` still runs, and a lambda that is only a condition inside a guard.

effect(f: int -> unit) = f(41)

test(f: int -> bool, value: int) = f(value)

main()
    var seen = 0
    effect(x -> seen = x + 1)
    println(seen)
    // A lambda in a unit context may have a value of another type, which is dropped.
    effect(x -> x + 1)
    println(42 match
        n if test(x -> x > 0, n) -> n
        else 0)
    println(-1 match
        n if test(x -> x > 0, n) -> n
        else 0)
