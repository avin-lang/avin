// expect: exit 0
// env: AVIN_GC_STRESS=0
// Continuation passing in constant stack: the sum is built as a chain of a million continuations,
// each calling the next in tail position, and running the chain nests no frames. The chain is a
// million live closures, so collecting at every allocation would trace it a million times; the
// rooting of a tail call's fresh arguments is covered under stress by `tailcall_values`.

sumTo(n: long, k: (long) -> long) -> long =
  if n == 0 then k(0) else sumTo(n - 1, s -> k(s + n))

// The same through a trait: each continuation is an object whose method calls the next one's.
trait Then
  run(value: long) -> long

class Done: Then
  override run(value: long) -> long = value

class AddThen(amount: long, rest: Then): Then
  override run(value: long) -> long = rest.run(value + amount)

chain(n: long, k: Then) -> long = if n == 0 then k.run(0) else chain(n - 1, AddThen(n, k))

main() -> int
  println(sumTo(1000000, s -> s))
  println(sumTo(3, s -> s * 10))
  println(chain(1000000, Done()))
  0
