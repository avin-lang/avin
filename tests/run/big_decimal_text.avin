// expect: exit 0
// A `BigDecimal` is written in plain digits, never with an exponent, however large or small; it is
// read from text exactly by `BigDecimal(text)` and `BigDecimal.parse`, which answers None for text
// that is not a number; and under `%f` it takes the precision as its places with the flags a `real`
// takes.
main()
  // Plain digits at every size and scale.
  for t in [
    "0",
    "0.0",
    "1",
    "-1",
    "0.5",
    "-0.5",
    "0.000001",
    "-0.000001",
    "123.456",
    "1e21",
    "1.5e-7",
    "-1E+30",
    "12345678901234567890.123456789012345678901234567890"
  ]
    println(BigDecimal(t))
  println(BigDecimal(BigInt(1), 40))
  println(BigDecimal(BigInt(-1), 40))
  println(BigDecimal(BigInt(10).pow(40), 0))
  println(BigDecimal(BigInt(10).pow(40), 40))
  println(BigDecimal(BigInt(12345), 2))
  println(BigDecimal(BigInt(12345), 5))
  println(BigDecimal(BigInt(12345), 7))
  // The forms text may take: a sign, a point anywhere among the digits, an exponent.
  for t in [
    "+1.5",
    "-.5",
    ".5",
    "5.",
    "007.50",
    "1.5e3",
    "1.5E-3",
    "1e+2",
    "-1e-2",
    "0e10",
    "0.0e-10",
    "1.23e2",
    "1.23e1",
    "-12.5e-0"
  ]
    println(s"$t -> ${BigDecimal.parse(t)}")
  // Text that is not a number answers None.
  for t in [
    "",
    "-",
    "+",
    ".",
    "-.",
    "e5",
    "1e",
    "1e+",
    "1.2.3",
    "1,5",
    " 1",
    "1 ",
    "1_000",
    "0x10",
    "1e5.5",
    "--1",
    "+-1",
    "1..2",
    "abc",
    "١٢",
    "NaN",
    "Infinity",
    "1e99999999999",
    "1e-99999999999",
    "1e2147483648",
    "1e-2147483648"
  ]
    println(s"[$t] -> ${BigDecimal.parse(t)}")
  // The exponent's extremes that keep an `int` scale.
  println(BigDecimal.parse("1e-2147483647").map(_.scale))
  println(BigDecimal.parse("1e-2147483646").map(_.precision))
  // `%f` takes the precision as places, rounding half to even, and the `real` flags.
  val x: BigDecimal = 2.345
  val y: BigDecimal = -2.355
  val z: BigDecimal = 0.004
  println(f"[$x%f] [$x%.2f] [$x%.0f] [$x%.5f] [$y%.2f] [$z%.2f] [${-z}%.2f]")
  println(f"[$x%10.2f] [$x%-10.2f] [$x%010.2f] [$y%010.2f] [$x%+.2f] [$x% .2f] [$y%+.2f]")
  println(f"[$x%#.0f] [${BigDecimal(5)}%#f] [${BigDecimal(5)}%f] [$x%3f]")
  val huge = BigDecimal("123456789012345678901234567890.5")
  println(f"[$huge%.0f] [$huge%.3f] [$huge%40.1f]")
  // Interpolation, padding, `toString` and the `Debug` form.
  println(s"price: $x")
  println(f"[$x] [$x%?] [$x%8?] [$y%-8?]")
  println(x.toString())
  println([x, y])
  println(Some(z))
