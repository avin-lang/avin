// expect: exit 42
// A `main` answering with `Result[int, E]` exits with the integer `Ok` holds, and writes nothing to
// standard error; `?` passes each `Ok` through.
parse(text: string) -> Result[int, string] = text.toIntOption() match
    Some(n) -> Ok(n)
    None -> Err(s"not a number: $text")

main() -> Result[int, string]
    val a = parse("40")?
    val b = parse("2")?
    Ok(a + b)
