// Code after `return`, `break` and `continue` compiles and never runs; branches that never finish
// agree with any other branch.

pick(flag: bool) -> int
  val n = if flag then return 7 else 8
  n * 2

after_return() -> int
  return 3
  val ignored = 1 + 2
  println("never")
  ignored

loops() -> int
  var total = 0
  var i = 0
  while i < 5 do
    i += 1
    if i == 2
      continue
      println("never")
    val inner = while true do
      break i * 10
      println("never")
    else 0
    total += inner
  total

main() -> int
  if pick(true) != 7 || pick(false) != 16 then return 1
  if after_return() != 3 then return 2
  if loops() != 130 then return 3
  val nothing = ()
  val greeting = "kept"
  println(greeting)
  var flag = true
  flag = !flag
  if flag then return 4
  val sum = 1 + (return 0)
