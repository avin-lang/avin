// A program that imports `avin.fs` alone: the library reads `avin.io`, which `avin.fs` imports, so
// the error type `avin.fs` answers with is complete without the program naming its module.
// expect: exit 0
import avin.fs

main()
  fs.readText("/no/such/file/anywhere") match
    Ok(_) -> println("read")
    Err(e) -> println(e.message)
