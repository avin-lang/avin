// expect: exit 0
// `actor` is a keyword only where a declaration starts, before the name it declares, `receives` only
// after an actor's header, and `receive` only at the start of a line in an actor's body with its
// arms indented after it. Everywhere else they are ordinary names: a function called `actor`, a
// class's fields and a function's parameter and locals called `receive` and `receives`, a `match`
// arm reading them, and inside an actor a field called `receives`, a method called `receive` and a
// parameter called `actor`.
import avin.actors.spawn
import avin.threads.Promise

class Stage(val receive: int, val receives: int, val actor: string)

actor(x: int) -> int = x + 1

receives(actor: int) -> int
    val receive = actor * 2
    var receives = receive
    receives += 1
    receives

data Msg
    Ask(reply: Promise[string])

actor Echo(actor: string) receives Msg
    val receives = 40
    receive(n: int) -> int = n + receives
    receive
        Ask(reply) -> reply.complete(s"$actor ${receive(2)}")

main()
    val s = Stage(1, 2, "a")
    println(s.receive + s.receives + actor(3) + receives(4))
    val receive = s.actor
    val actor = receive match
        "a" -> "matched"
        _ -> "not"
    println(actor)
    val e = spawn(Echo("echo"))
    val p = Promise[string]()
    e.tell(Ask(p))
    println(p.future.await())
