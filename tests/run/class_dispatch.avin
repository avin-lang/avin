// expect: exit 0
// Abstract classes and virtual dispatch: a template method in the superclass calls an abstract one
// each subclass implements; a generic superclass is extended at a written type argument; an
// override may yield a subclass of the overridden method's result; objects of different
// subclasses sit in one list and are dispatched in a loop; and enough of them are made, each
// holding references declared at both levels, that collections walk them.

data List[+T]
  Cons(head: T, tail: List[T])
  Empty

abstract class Shape(val label: string)
  var tag: Option[string] = None

  area() -> int

  name() -> string = "shape"

  describe() -> string = s"$label: ${name()} of area ${area()}"

  copy() -> Shape

open class Rect(label: string, val w: int, val h: int): Shape(label)
  override area() -> int = w * h
  override name() -> string = "rect"
  override copy() -> Rect = Rect(label + "'", w, h)

class Square(label: string, side: int): Rect(label, side, side)
  override name() -> string = "square"
  override copy() -> Square = Square(label + "'", w)

class Circle(label: string, val r: int): Shape("circle " + label)
  override area() -> int = 3 * r * r
  override copy() -> Shape = Circle(label, r + 1)

data Option[+T]
  Some(value: T)
  None

open class Box[T](var value: T)
  get() -> T = value
  show() -> string = "box"

class IntBox(x: int): Box[int](x * 2)
  override show() -> string = s"int box of ${get()}"
  doubled() -> int = value * 2

sum(shapes: List[Shape]) -> int = shapes match
  Cons(s, rest) -> s.area() + sum(rest)
  Empty -> 0

printAll(shapes: List[Shape]) -> unit = shapes match
  Cons(s, rest) ->
    println(s.describe())
    println(s.copy().describe())
    printAll(rest)
  Empty -> ()

tagged(shapes: List[Shape], acc: int) -> int = shapes match
  Cons(s, rest) -> tagged(rest, s.tag match
    Some(t) -> if t == s"#${s.label}" then acc + 1 else acc
    None -> acc)
  Empty -> acc

main() -> int
  var shapes: List[Shape] = Empty
  shapes = Cons(Rect("r", 2, 3), shapes)
  shapes = Cons(Square("s", 4), shapes)
  shapes = Cons(Circle("c", 1), shapes)
  printAll(shapes)
  if sum(shapes) != 6 + 16 + 3 then return 1
  val sq = Square("q", 5)
  val sq2: Square = sq.copy()
  if sq2.w != 5 then return 2
  val pair: (Shape, Rect) = (sq, sq2)
  val (first, second) = pair
  println(first.describe() + " / " + second.describe())
  val b: Box[int] = IntBox(21)
  println(b.show())
  if b.get() != 42 then return 3
  if IntBox(1).doubled() != 4 then return 4
  val plain = Box("text")
  println(plain.show() + " " + plain.get())
  // Many objects of every class, each tagged with a string built at run time, so the
  // collections that run while they are made walk fields of both the superclass and the
  // subclass.
  var many: List[Shape] = Empty
  var i = 0
  while i < 3000
    val s: Shape = if i % 3 == 0 then Rect(
      s"r$i",
      i % 7,
      2
    ) elif i % 3 == 1 then Square(s"s$i", i % 5) else Circle(s"c$i", i % 4)
    s.tag = Some("#" + s.label)
    many = Cons(s, many)
    i++
  println(s"total ${sum(many)} with ${tagged(many, 0)} tagged by label")
  if !(sq === sq2) && sq !== sq then return 5
  val r: Rect = sq
  if !(r === sq) then return 6
  0
