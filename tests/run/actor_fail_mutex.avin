// expect: trap
// A trap while an actor holds a `Mutex` stops the program instead of failing the actor, whatever
// its supervision: other threads may be waiting for the lock, and the value it guards is in doubt.
// The report still names the actor.
import avin.actors.{Stop, spawn}
import avin.threads.{Channel, Mutex}

actor Keeper(shared: Mutex[Buffer[int]], done: Channel[int]) receives int
    receive
        n ->
            val size = shared.with(b ->
                b.append(n)
                b(n))
            done.send(size)

main()
    val shared = Mutex(Buffer[int]())
    val done = Channel[int]()
    val k = spawn(Keeper(shared, done), onFailure = Stop)
    k.tell(0)
    println(done.receive())
    k.tell(5)
    println(done.receive())
    println("not reached")
