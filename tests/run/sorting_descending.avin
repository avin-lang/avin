// expect: exit 0
// `sortedDescending` puts a sequence of ordered elements in descending order: a list into a list,
// any other sequence into a vector, leaving itself as it was. The sort is stable, so elements that
// compare equal keep their order, which `sorted.reverse` turns round. An array, a buffer and a deque
// also sort themselves in place with `sortInPlaceDescending()`, stably too. A key sorts descending through `Reverse`, alone or as one
// part of a tuple key, and a comparison through `reverseOrder`.
data Tagged(key: int, tag: string) derives Eq

impl Ord for Tagged
    compare(other: Tagged) -> int = key.compare(other.key)

data Person(name: string, age: int)

tags(items: Seq[Tagged]) -> string = items.map(t -> s"${t.key}${t.tag}").mkString(" ")

main()
    // Empty, one, already descending, ascending, duplicates.
    val none: Vector[int] = []
    println(none.sortedDescending)
    println([7].sortedDescending)
    println([4, 3, 2, 1].sortedDescending)
    val ascending = [1, 2, 3, 4]
    println(ascending.sortedDescending)
    println(ascending)
    println([3, 1, 3, 2, 1, 3].sortedDescending)

    // The extreme values of each width, and reals, chars and strings, Unicode among them.
    println([0, 2147483647, -2147483648, -1, 1].sortedDescending)
    val longs: Vector[long] = [0, 9223372036854775807, -9223372036854775807 - 1]
    println(longs.sortedDescending)
    println([1.5, -0.5, 2.25].sortedDescending)
    println(['b', 'é', 'a', 'Z'].sortedDescending)
    println(["pear", "", "Äpfel", "apple", "pear"].sortedDescending)

    // Stability: equal keys keep their order, unlike a reversed ascending sort.
    val tagged = [Tagged(1, "a"), Tagged(2, "b"), Tagged(1, "c"), Tagged(2, "d"), Tagged(1, "e")]
    println(tags(tagged.sortedDescending))
    println(tags(tagged.sorted.reverse))
    println(tags(tagged.sorted))

    // A list sorts into a list.
    val list: List[int] = [5, 2, 8, 2, 1]
    val down: List[int] = list.sortedDescending
    println(down)
    val emptyList: List[string] = []
    println(emptyList.sortedDescending)
    val taggedList: List[Tagged] = [Tagged(3, "x"), Tagged(3, "y"), Tagged(4, "z")]
    println(tags(taggedList.sortedDescending))

    // Other sequences: an array, a range and the characters of a string.
    val array = Array.tabulate(5, i -> (i * 7) % 5)
    println(array.sortedDescending)
    println(array)
    println((1..5).sortedDescending)
    println("héllo".chars.sortedDescending.mkString(""))

    // In place, stable too.
    val inPlace = Array.tabulate(5, i -> tagged(i))
    inPlace.sortInPlaceDescending()
    println(tags(inPlace))
    val emptyArray: Array[int] = Array.empty()
    emptyArray.sortInPlaceDescending()
    println(emptyArray)
    val buffer = Buffer[Tagged]()
    for t in tagged do buffer.addOne(t)
    buffer.sortInPlaceDescending()
    println(tags(buffer))
    val deque = Deque[int]()
    for x in [3, 9, 1] do deque.append(x)
    deque.prepend(5)
    deque.sortInPlaceDescending()
    println(deque.toVector, deque.sortedDescending)

    // By a key: `Reverse`, alone and in a tuple; and a comparison turned round.
    val people = [Person("Ann", 30), Person("Bob", 25), Person("Cy", 30), Person("Di", 25)]
    println(people.sortBy(p -> Reverse(p.age)).map(_.name).mkString(" "))
    println(people.sortBy(p -> (Reverse(p.age), Reverse(p.name))).map(_.name).mkString(" "))
    println(people.sortWith(reverseOrder(compareBy(p -> p.age))).map(_.name).mkString(" "))

    // Through a generic function.
    println(top3([9, 4, 7, 1, 8]))
    println(top3(["b", "c", "a"]))

top3[T: Ord](items: Vector[T]) -> Vector[T] = items.sortedDescending.take(3)
