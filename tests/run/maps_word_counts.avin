// expect: exit 0
// Counting words with an immutable map, rebuilt by `updated`, and with a mutable one, updated in
// place through `m(key) = value` and its compound forms. Both agree, and the immutable map made from
// the mutable one equals the one built directly.

import avin.collections.mutable.{Map as MutableMap}

val text = Array.tabulate(12, i -> if i % 3 == 0 then "the" elif i % 4 == 1 then "cat" elif i % 5 == 2 then "sat" else "mat")

main()
    var counts = Map[string, int]()
    for w in text do counts = counts.updated(w, counts.getOrElse(w, 0) + 1)
    println(s"${counts.size()} the=${counts("the")} cat=${counts("cat")} sat=${counts("sat")} mat=${counts("mat")}")
    println(s"${counts.get("dog").isNone()} ${counts.contains("cat")} ${counts.getOrElse("dog", -1)}")

    val tally = MutableMap[string, int]()
    for w in text
        if !tally.contains(w) then tally(w) = 0
        tally(w) += 1
    println(s"${tally.size()} the=${tally("the")} cat=${tally("cat")} sat=${tally("sat")} mat=${tally("mat")}")
    println(s"${tally.toMap() == counts}")

    var total = 0
    for (_, n) in counts do total += n
    var keys = 0
    for k in counts.keys() do keys += k.byteLength()
    var values = 0
    for v in tally.valuesIterator() do values += v
    println(s"$total $keys $values")
