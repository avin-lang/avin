// expect: trap
// A deadlock stops the program as any trap does: what was printed is flushed first, and the exit
// hooks run after the report.
import avin.process.onExit
import avin.threads.Channel

main()
  onExit(() -> println("hook ran"))
  print("printed before, ")
  println("unflushed")
  val c = Channel[string]()
  println(c.receive())
