// expect: exit 0
// Every sequence has the structural methods, written once on `Seq`: taking and dropping by count or
// by a test, slicing, splitting, reversing, joining, replacing and padding, zipping, scanning,
// removing repeats, grouping into windows, searching from the end, comparing prefixes and suffixes,
// and multiset intersection and difference. Seen as a `Seq`, each answers with a vector; a list, a
// vector and an `ArraySeq` answer with their own kind, and an array, a buffer and a deque keep their
// own kind for the element-wise `map`, `filter` and `filterNot`. A count is held to the sequence:
// `take(-1)` is empty and `drop(100)` of a short sequence is empty.

// A sequence written by a user: the default methods reach it through `length` and `apply` alone.
class Squares(n: int): Seq[int]
    override length -> int = n
    override apply(index: int) -> int
        if index < 0 || index >= n then fail("index out of range")
        index * index

two[A: Display](p: (A, A)) -> string
    val (x, y) = p
    s"($x | $y)"

pairs[A: Display, B: Display](v: Vector[(A, B)]) -> string
    var out = "["
    for (x, y) in v do out = out + s"<$x,$y>"
    out + "]"

windows[T: Display](it: Iterator[Vector[T]]) -> string
    var out = ""
    for w in it do out = out + s"$w"
    if out == "" then "none" else out

// Each method as every sequence has it, through `Seq[int]`.
report(name: string, xs: Seq[int])
    println(s"== $name ${xs.length}")
    println(s"  map ${xs.map(x -> x * 10)} flatMap ${xs.flatMap(x -> [x, -x])} filter ${xs.filter(x -> x % 2 == 0)} filterNot ${xs.filterNot(x -> x % 2 == 0)} collect ${xs.collect(match x if x > 2 -> x)}")
    println(s"  take ${xs.take(2)} ${xs.take(-1)} ${xs.take(100)} drop ${xs.drop(2)} ${xs.drop(-1)} ${xs.drop(100)}")
    println(s"  takeWhile ${xs.takeWhile(x -> x < 3)} dropWhile ${xs.dropWhile(x -> x < 3)} takeRight ${xs.takeRight(2)} ${xs.takeRight(-3)} ${xs.takeRight(100)} dropRight ${xs.dropRight(2)} ${xs.dropRight(100)}")
    val middle = if xs.length >= 3 then xs.slice(1, 3) else xs.slice(0, xs.length)
    println(s"  slice $middle ${xs.slice(0, 0)} splitAt ${two(xs.splitAt(2))} ${two(xs.splitAt(-5))} ${two(xs.splitAt(50))} span ${two(xs.span(x -> x < 3))}")
    if xs.nonEmpty then println(s"  tail ${xs.tail} init ${xs.init}")
    println(s"  reverse ${xs.reverse} ++ ${xs ++ [7, 8]} ${xs ++ xs} :+ ${xs :+ 9} +: ${0 +: xs} padTo ${xs.padTo(6, 0)} ${xs.padTo(1, 0)}")
    if xs.nonEmpty then println(s"  updated ${xs.updated(0, 99)} ${xs.updated(xs.length - 1, 77)}")
    println(s"  indices ${xs.indices.toVector} zip ${pairs(xs.zip(["a", "b", "c"]))} zipAll ${pairs(xs.zipAll(["a"], -1, "z"))} scanLeft ${xs.scanLeft(0, (s, x) -> s + x)}")
    println(s"  distinct ${(xs ++ xs).distinct} distinctBy ${xs.distinctBy(x -> x % 2)} grouped ${windows(xs.grouped(2))} sliding ${windows(xs.sliding(2))} ${windows(xs.sliding(3, 2))} ${windows(xs.sliding(10))}")
    println(s"  lastIndexOf ${(xs ++ xs).lastIndexOf(1)} ${xs.lastIndexOf(42)} lastIndexWhere ${xs.lastIndexWhere(x -> x < 3)} ${xs.lastIndexWhere(x -> x > 100)} indexOf ${xs.indexOf(1)}")
    println(s"  startsWith ${xs.startsWith([])} ${xs.startsWith(xs.take(2))} ${xs.startsWith([5, 5])} endsWith ${xs.endsWith(xs.takeRight(2))} ${xs.endsWith([5, 5, 5, 5, 5, 5, 5])} sameElements ${xs.sameElements(xs.toList)} ${xs.sameElements(xs :+ 1)}")
    println(s"  intersect ${xs.intersect([4, 1, 1, 9])} diff ${xs.diff([4, 1, 1, 9])} ${(xs ++ xs).diff(xs)} ${(xs ++ xs).intersect(xs ++ [1])}")
    println(s"  guard ${for x in xs if x % 2 == 1 yield x + 100}")

main()
    val l: List[int] = [1, 2, 3, 4]
    val v: Vector[int] = [1, 2, 3, 4]
    val s: ArraySeq[int] = [1, 2, 3, 4]
    val a: Array[int] = [1, 2, 3, 4]
    val b: Buffer[int] = [1, 2, 3, 4]
    val d: Deque[int] = [1, 2, 3, 4]
    val r = 1 .. 4
    val q = Squares(4)
    report("list", l)
    report("vector", v)
    report("arraySeq", s)
    report("array", a)
    report("buffer", b)
    report("deque", d)
    report("range", r)
    report("squares", q)
    report("empty list", List.empty[int]())
    report("empty vector", Vector.empty[int]())
    report("empty array", Array.empty[int]())
    report("empty range", 4 ..< 4)
    report("single", [5])

    // A list answers with lists, sharing what it can.
    val l1: List[int] = l.takeWhile(x -> x < 3)
    val l2: List[int] = l.dropWhile(x -> x < 3)
    val (l3, l4): (List[int], List[int]) = l.span(x -> x < 2)
    val (l5, l6): (List[int], List[int]) = l.splitAt(3)
    val l7: List[int] = l.slice(1, 3)
    val l8: List[int] = l.init
    val l9: List[int] = l ++ v
    val l10: List[int] = l :+ 5
    val l11: List[int] = 0 +: l
    val l12: List[int] = l.updated(2, 30)
    val l13: List[int] = l.padTo(6, 0)
    val l14: List[int] = (l ++ l).distinct
    val l15: List[int] = l.distinctBy(x -> x / 3)
    val l16: List[int] = l.intersect([2, 9])
    val l17: List[int] = l.diff([2, 9])
    val l18: List[int] = l.filterNot(x -> x > 2)
    val l19: List[int] = l.takeRight(3)
    val l20: List[int] = l.dropRight(3)
    println(s"$l1 $l2 $l3 $l4 $l5 $l6 $l7 $l8 $l9 $l10 $l11 $l12 $l13 $l14 $l15 $l16 $l17 $l18 $l19 $l20 ${l ++ l} ${l.updated(0, 9)} $l")
    println(s"${l.takeRight(-1)} ${l.dropRight(-1)} ${l.takeRight(9)} ${l.dropRight(9)} ${l.padTo(2, 0)} ${List.empty[int]().span(x -> true).0}")

    // A vector answers with vectors.
    val v1: Vector[int] = v.takeWhile(x -> x < 3)
    val v2: Vector[int] = v.reverse
    val v3: Vector[int] = v ++ l
    val v4: Vector[int] = v.padTo(5, 7)
    println(s"$v1 $v2 $v3 $v4 ${v.diff([1])} ${v.span(x -> x < 3).1}")

    // An `ArraySeq` answers with its own kind.
    val s1: ArraySeq[int] = s.take(2)
    val s2: ArraySeq[int] = s.drop(-4)
    val s3: ArraySeq[int] = s.takeWhile(x -> x < 3)
    val s4: ArraySeq[int] = s.dropWhile(x -> x < 3)
    val s5: ArraySeq[int] = s.reverse
    val s6: ArraySeq[int] = s ++ l
    val s7: ArraySeq[int] = s.tail
    val s8: ArraySeq[int] = s.init
    val s9: ArraySeq[int] = s.takeRight(1)
    val s10: ArraySeq[int] = s.dropRight(1)
    val s11: ArraySeq[int] = s.padTo(5, 0)
    val s12: ArraySeq[int] = (s ++ s).distinct
    val s13: ArraySeq[int] = s.intersect([3, 3])
    val s14: ArraySeq[int] = s.diff([3, 3])
    val s15: ArraySeq[int] = s.filterNot(x -> x == 1)
    val s16: ArraySeq[int] = s.distinctBy(x -> x % 2)
    val (s17, s18): (ArraySeq[int], ArraySeq[int]) = s.span(x -> x < 3)
    val (s19, s20): (ArraySeq[int], ArraySeq[int]) = s.splitAt(1)
    println(s"$s1 $s2 $s3 $s4 $s5 $s6 $s7 $s8 $s9 $s10 $s11 $s12 $s13 $s14 $s15 $s16 $s17 $s18 $s19 $s20 ${s.take(100)}")

    // An array, a buffer and a deque filter into a new one of their kind and answer the structural
    // methods with vectors, leaving themselves as they were.
    val a1: Array[int] = a.filterNot(x -> x == 2)
    val b1: Buffer[int] = b.filter(x -> x > 2)
    val b2: Buffer[int] = b.filterNot(x -> x > 2)
    val d1: Deque[int] = d.filter(x -> x > 2)
    val d2: Deque[int] = d.filterNot(x -> x > 2)
    val a2: Vector[int] = a.reverse
    val b3: Vector[int] = b.take(2)
    val d3: Vector[int] = d :+ 5
    println(s"$a1 $b1 $b2 $d1 $d2 $a2 $b3 $d3 $a $b $d")

    // A sequence of a subtype is one of its supertype: the methods take the supertype's elements.
    val words: Vector[string] = ["b", "a", "b", "c"]
    val joined: Seq[string] = words.diff(["b"])
    println(s"${joined.mkString()} ${words.distinct} ${words.lastIndexOf("b")} ${words.zip(1 .. 10).length} ${words.sliding(2, 3).toVector}")
