// expect: exit 0
// Set and map literals in the places an expression goes: globals, generic arguments, a block's last
// line, `match` arms and `if` branches, with `Option` values agreeing, negative keys, tuple elements,
// and expected types a set or map satisfies, an `Iterable` or a function, which take the default.

val primes = {2, 3, 5, 7}
val names = {one: 1, two: 2}

count[A](s: Set[A]) -> int = s.size()

keysOf[K, V](m: Map[K, V]) -> int = m.size()

made(flag: bool) -> Set[int]
    val base = 10
    {base, base + 1}

pick(n: int) -> Map[string, int] = n match
    0 -> {}
    1 -> {one: 1}
    _ -> {many: n}

main()
    println(primes.contains(5))
    println(names("two"))
    println(count({"a", "b"}))
    println(keysOf({1: 'a'}))
    println(made(true).size())
    println(pick(0).size() + pick(1).size() + pick(5)("many"))
    val opts = {a: None, b: Some(1)}
    println(opts("b"))
    println({-1: "neg"}(-1))
    val it: Iterable[int] = {1, 2}
    println(it.toVector().length())
    val tuples = {(1, 2), (1, 2), (3, 4)}
    println(tuples.size())
    println(if primes.contains(2) then {1} else {2, 3})
    val e: Set[int] = {}
    println(e)
    val em: Map[int, int] = {}
    println(em)
    val f: (string) -> bool = {"a"}
    println(f("a"))
