// expect: trap
// Every byte after the first of a four-byte character is inside its encoding: offsets 1, 2 and 3
// of "😀" each trap, and the offset past it is a boundary again. The last byte is the one read here,
// after a loop that stops at the first offset where a character begins.

main()
  val s = "😀z"
  var at = 1
  while (s.byteAt(at) & 0xc0) == 0x80
    at += 1
  println(s"${s.charAt(0)} ${s.charAt(at)} $at")
  println(s.charAt(3))
