// expect: exit 0
// Eight threads each add one to a counter a mutex holds a hundred thousand times, and to a second
// counter they share through a `Mutex[int]`'s `update`: no increment is lost. `get` and `set` read and
// replace an immutable value under the lock, and `with` gives back what its body returns.
import avin.threads.{Mutex, scope}

class Counter()
    var n = 0

main() -> int
    val counter = Mutex(Counter())
    val total = Mutex(0)
    scope(s ->
        for t in 0..<8
            s.spawn(() ->
                for i in 0..<100000
                    counter.with(c -> c.n += 1)
                    if i % 10 == 0 then total.update(x -> x + 1)))
    val n = counter.with(c -> c.n)
    print(n)
    print(total.get())
    total.set(5)
    print(total.update(x -> x * 2))
    print(total.get())
    if n == 800000 && total.get() == 10 then 0 else 1
