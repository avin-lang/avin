// expect: exit 0
// In an object's own body its name is `self`. A `lazy val`'s initializer, a lambda made after the
// last field, a method and an `override` name the object freely, since that code runs only once the
// object is complete, and the object does not need itself to initialize. Before the last field the
// name reads a field declared above it, assigns one, or reads an inherited field, as `self` may.
import avin.threads.{Future, spawn}

open class Base(val tag: string)
  describe() -> string = s"base $tag"

open class Box[T: Display](val item: T)
  show() -> string = s"box $item"

// A module-level value declared above the object it reads: the object is still made first.
val early: int = Counter.next()

object Counter: Base("counter")
  val start: int = 1
  var count: int = Counter.start
  Counter.count = Counter.count + 1
  lazy val doubled: int = Counter.start * 2 + Counter.count
  var hook: () -> int = () -> 0
  // After the last field, a lambda capturing the object is stored and called later.
  hook = () -> Counter.count * 10
  // Made and called at once, while the object is being made: every field is already set.
  println(s"made ${twice(() -> Counter.count)}")
  next() -> int
    Counter.count = Counter.count + 1
    Counter.count
  override describe() -> string = s"${super.describe()} at ${Counter.count}"

twice(f: () -> int) -> int = f() + f()

// A generic superclass, its inherited field read through the name before the object's own fields.
object Tagged: Box[string]("t")
  val tags: Vector[string] = [Tagged.item, Tagged.item + "!"]
  same(x: Any) -> bool = x match
    Tagged -> true
    _ -> false
  override show() -> string = s"${Tagged.tags} ${Tagged.item}"

// A companion: its name makes the class through the constructor, and calls its own `apply`.
class Point(val x: int)

object Point
  val origin: Point = Point(0)
  lazy val unit: Point = Point.at(1)
  at(x: int) -> Point = Point(x)
  apply(x: int, y: int) -> Point = Point(x + y)
  sum() -> int = Point(2, 3).x + Point.origin.x + Point.unit.x

// Two objects naming themselves in their lazy values and methods, and each other in one of each.
object Ping
  val n: int = 3
  lazy val total: int = Ping.n + Pong.n
  echo() -> int = Pong.reply() + Ping.n

object Pong
  val n: int = 4
  lazy val total: int = Pong.n * Pong.reply()
  reply() -> int = Pong.n

// An object with no `var` is sendable: a thread and a future started in its methods use its name.
object Frozen
  val k: int = 7
  val word: string = "héllo, 世界"
  onThread() -> int = spawn(() -> Frozen.k + 1).join()
  later() -> string = Future(Frozen.word + "!").await()

main()
  println(early)
  println(Counter.doubled)
  println(Counter.hook())
  println(Counter.next())
  println(Counter.describe())
  println(Tagged.show())
  println(Tagged.same(Tagged))
  println(Tagged.same(Counter))
  println(Point.sum())
  println(Ping.total)
  println(Pong.total)
  println(Ping.echo())
  println(Frozen.onThread())
  println(Frozen.later())
