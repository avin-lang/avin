// expect: trap
// `le` is the label a histogram's buckets are written with: a counter may be labelled `le`, and a
// histogram so labelled traps.
import avin.metrics.Registry

main()
  val r = Registry()
  _ = r.counter("a_total", "A.", ["le"])
  println(r.names)
  _ = r.histogram("b", "B.", ["op", "le"])
