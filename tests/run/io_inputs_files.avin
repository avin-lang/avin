// expect: exit 0
// `io.inputs(paths)` is each named file as its name and all its text, read when the iterator reaches
// it; a file that cannot be read is an `Err` naming it, in its place, and the iterator goes on.
// `io.inputLines(paths)` is the same a line at a time, a name with each line. Here standard input is
// empty, so `-` and no names at all give an input with no text and no lines.
import avin.fs
import avin.io
import avin.io.IoError

show(r: Result[(string, string), IoError]) -> string = r match
  Ok((name, text)) -> s"$name=[${text.replace("\n", "\\n")}]"
  Err(e) -> s"error ${e.kind.description} | ${e.message}"

main()
  val dir = fs.tempDir("io-inputs").getOrElse(fail("no temp dir"))
  defer dir.close()
  val a = dir.path + "/a.txt"
  val b = dir.path + "/b.txt"
  val empty = dir.path + "/empty.txt"
  val crlf = dir.path + "/crlf.txt"
  val bad = dir.path + "/bad.bin"
  val missing = dir.path + "/missing.txt"
  _ = fs.writeText(a, "one\ntwo\n")
  _ = fs.writeText(b, "three")
  _ = fs.writeText(empty, "")
  _ = fs.writeText(crlf, "x\r\ny\r\n\r\nz")
  _ = fs.writeBytes(bad, Array.tabulate(3, i -> if i == 1 then byte(0xff) else byte(0x61)))
  val at = (p: string) -> p.replace(dir.path + "/", "")

  // Whole texts, in the order named.
  for r in io.inputs(Vector(a, b))
    println(show(r).replace(dir.path + "/", ""))
  // An empty file is an input with empty text.
  println(show(io.inputs(Vector(empty)).next()).replace(dir.path + "/", ""))
  // Nothing named is standard input, here empty; so is `-`, and a second `-` finds it empty.
  println(show(io.inputs(Vector()).next()))
  println(io.inputs(Vector("-", "-")).map(show).mkString(" ; "))
  // No paths at all: exactly one input.
  println(io.inputs(Vector()).count(_ -> true))
  // A missing file, then a file that is not UTF-8, then one that reads: each reported, none stops the rest.
  for r in io.inputs(Vector(missing, bad, b))
    println(show(r).replace(dir.path + "/", ""))
  // The same path twice is read twice.
  println(io.inputs(Vector(b, b)).map(show).mkString(" ; ").replace(dir.path + "/", ""))
  // The iterator is lazy: a file written after the call but before the iterator reaches it is seen.
  val later = dir.path + "/later.txt"
  val it = io.inputs(Vector(b, later))
  println(show(it.next()).replace(dir.path + "/", ""))
  _ = fs.writeText(later, "late")
  println(show(it.next()).replace(dir.path + "/", ""))
  println(it.hasNext())

  // Lines: each with its input's name, terminators removed, `\r\n` included.
  for r in io.inputLines(Vector(a, crlf, b))
    println(show(r).replace(dir.path + "/", ""))
  // An input with no lines gives nothing, between inputs that have some.
  println(io.inputLines(Vector(empty, a, empty, b, empty)).count(_ -> true))
  // An unreadable input is one `Err` and no lines, and the lines after it still come.
  for r in io.inputLines(Vector(missing, b, bad, a))
    println(show(r).replace(dir.path + "/", ""))
  // Standard input, empty here, gives no lines; nothing named is the same.
  println(io.inputLines(Vector()).hasNext())
  println(io.inputLines(Vector("-")).hasNext())
  println(io.inputLines(Vector()).count(_ -> true))
  // A blank line is a line.
  _ = fs.writeText(a, "\n\n")
  println(io.inputLines(Vector(a)).map(show).mkString(" ; ").replace(dir.path + "/", ""))
  // hasNext twice, then next, loses nothing.
  val l = io.inputLines(Vector(b))
  println(l.hasNext())
  println(l.hasNext())
  println(show(l.next()).replace(dir.path + "/", ""))
  println(l.hasNext())
  println(at(a))
