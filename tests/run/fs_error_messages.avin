// `IoError.message`: a sentence for each named case, and the platform's own wording for a failure
// that has no named case.
import avin.fs
import avin.io.{IoError, NotFound, PermissionDenied, AlreadyExists, IsADirectory, NotADirectory, DirectoryNotEmpty, InvalidUtf8, Other}

main()
    val cases = [NotFound, PermissionDenied, AlreadyExists, IsADirectory, NotADirectory, DirectoryNotEmpty, InvalidUtf8(7), Other("custom")]
    for e in cases do println(e.message)
    // A name too long for the file system has no named case, so it is `Other` with the platform's text.
    val dir = "/tmp/avin-fs-messages"
    println(fs.createDirAll(dir))
    val long = dir + "/" + "x".repeat(300)
    fs.writeText(long, "a") match
        Err(Other(text)) ->
            println(text)
            println(text != "" && !text.startsWith("system error"))
        other -> println(s"unexpected $other")
    fs.readText(long) match
        Err(e) -> println(e.message)
        other -> println(s"unexpected $other")
    // The named cases keep their own sentence.
    fs.readText(dir + "/missing") match
        Err(e) -> println(e.message)
        other -> println(s"unexpected $other")
    println(fs.removeDirAll(dir))
