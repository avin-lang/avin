// `ErrorKind.description`: a sentence for each named kind, and the platform's own wording for a
// failure that has no named kind; an `IoError`'s message puts the operation and the path before it.
import avin.fs

import avin.io.{
  IoError, NotFound, PermissionDenied, AlreadyExists, IsADirectory, NotADirectory, DirectoryNotEmpty, InvalidUtf8, Other
}

main()
  val kinds = [
    NotFound,
    PermissionDenied,
    AlreadyExists,
    IsADirectory,
    NotADirectory,
    DirectoryNotEmpty,
    InvalidUtf8(7),
    Other("custom")
  ]
  for k in kinds do println(k.description)
  // A name too long for the file system has no named kind, so it is `Other` with the platform's text.
  val dir = "/tmp/avin-fs-messages"
  println(fs.createDirAll(dir))
  val longPath = dir + "/" + "x".repeat(300)
  fs.writeText(longPath, "a") match
    Err(IoError(Other(text), op, path)) ->
      println(text)
      println(text != "" && !text.startsWith("system error"))
      println(op)
      println(path == longPath)
    other -> println(s"unexpected $other")
  fs.readText(longPath) match
    Err(e) -> println(e.message.startsWith(s"cannot read $longPath: "))
    other -> println(s"unexpected $other")
  // The named kinds keep their own sentence.
  fs.readText(dir + "/missing") match
    Err(e) -> println(e.message)
    other -> println(s"unexpected $other")
  println(fs.removeDirAll(dir))
