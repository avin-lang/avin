// Wrapping and saturating operators say what happens at the bounds.

main() -> int
  val max: i8 = 127
  val min: i8 = -128
  if max +% 1 != -128 then return 1
  if min -% 1 != 127 then return 2
  if max *% 2 != -2 then return 3
  if max +| 1 != 127 then return 4
  if min -| 1 != -128 then return 5
  if max *| 2 != 127 then return 6
  if min *| 2 != -128 then return 7
  if min *| -1 != 127 then return 8
  var x: i8 = 120
  x +%= 10
  if x != -126 then return 9
  x -|= 100
  if x != -128 then return 10
  0
