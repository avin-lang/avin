// expect: trap
// A client request's decompression limit is at least zero; one below it traps where the request is
// made, and a request taking no decompression has none.
import avin.net.http.Request

main()
  println(Request("GET", "http://example.invalid/").decoding)
  println(Request("GET", "http://example.invalid/").withoutDecoding().decoding)
  println(Request("GET", "http://example.invalid/").withDecoding(0).decoding)
  println(Request("GET", "http://example.invalid/").withDecoding(-1).decoding)
