// expect: trap
// An effect that writes what it reads never settles: after a hundred runs in one flush it traps,
// rather than looping for ever. An effect that writes something it does not read settles at once.
import avin.reactive.Graph

main()
  val g = Graph()
  val a = g.atom(0)
  val b = g.atom(0)
  _ = g.effect(get -> b.set(get(a) + 1))
  println(b.get())
  _ = g.effect(get -> a.set(get(a) + 1))
  println(a.get())
