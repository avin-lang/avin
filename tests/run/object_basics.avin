// expect: exit 0
// An object is a singleton value: its fields are read and written from functions, its methods call
// one another and other objects' methods, it is passed as a value of its own type, and it is
// referenced in the file before it is declared.

show() = print(s"port ${Config.port} verbose ${Config.verbose}")

enable(config: Config) = config.verbose = true

same(a: Config, b: Config) -> bool = a === b

main()
    show()
    Config.verbose = true
    Config.port += 1
    show()
    Config.verbose = false
    enable(Config)
    show()
    print(Config.describe())
    print(Log.write("from main"))
    print(s"${Log.count}")
    if same(Config, Config) then print("one instance")
    Config.bump()
    Config.bump()
    print(s"${Config.port}")

object Config
    val name = "server"
    var port = 8080
    var verbose = false
    private var bumps = 0

    describe() -> string = Log.write(s"$name on $port")

    bump()
        bumps++
        port = port + bumps

object Log
    var count: int = 0

    write(text: string) -> string
        count++
        s"[$count] $text"
