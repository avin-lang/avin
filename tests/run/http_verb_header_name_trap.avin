// expect: trap
// The headers a verb is given are checked before any connection is made: a name that is not a token
// traps, so nothing is sent to the URL, which here names no server at all.
import avin.net.http

main()
    println("before")
    println(http.put("http://127.0.0.1:1/", "x", "text/plain", [("Bad Name", "v")]))
