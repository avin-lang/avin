// Sorting many elements: 10,000 pseudo-random integers with many repeats, sorted by every sort on
// every sequence, come out in order and with every element kept, and the lengths around the sort's
// runs and merges sort as well as long ones. Equal keys keep their order at any length.
data Tagged(value: int, index: int)

// The next of a fixed sequence of pseudo-random numbers below 2^31.
next(seed: long) -> long = (seed * 1103515245 + 12345) % 2147483648

randomInts(count: int, below: int) -> Array[int]
    var seed: long = 2026
    Array.tabulate(count, i ->
        seed = next(seed)
        int((seed / 65536) % long(below)))

// How many times each value below `below` occurs.
counts(xs: Seq[int], below: int) -> Array[int]
    val c = Array.fill(below, 0)
    for x in xs do c(x) += 1
    c

ascending(xs: Seq[int]) -> bool
    for i in 1 ..< xs.length
        if xs(i - 1) > xs(i) then return false
    true

descendingOrder(xs: Seq[int]) -> bool
    for i in 1 ..< xs.length
        if xs(i - 1) < xs(i) then return false
    true

// Whether the values ascend and, among equal values, the original indices do too.
stable(xs: Seq[Tagged]) -> bool
    for i in 1 ..< xs.length
        val a = xs(i - 1)
        val b = xs(i)
        if a.value > b.value || a.value == b.value && a.index > b.index then return false
    true

check(label: string, sorted: Seq[int], orderOk: bool, expected: Array[int], below: int)
    println(s"$label ${sorted.length} $orderOk ${counts(sorted, below) == expected}")

main()
    val below = 500
    val n = 10000
    val source = randomInts(n, below)
    val expected = counts(source, below)
    println(ascending(source))

    val vector = source.toVector
    val v = vector.sorted()
    check("vector sorted", v, ascending(v), expected, below)
    val vd = vector.sortWith((a, b) -> b.compare(a))
    check("vector sortWith", vd, descendingOrder(vd), expected, below)
    val vk = vector.sortBy(x -> -x)
    check("vector sortBy", vk, descendingOrder(vk), expected, below)
    println(vector == source.toVector)

    val list = vector.toList
    val l: List[int] = list.sorted()
    check("list sorted", l, ascending(l.toVector), expected, below)
    val lk: List[int] = list.sortBy(x -> below - x)
    check("list sortBy", lk, descendingOrder(lk.toVector), expected, below)

    val array = source.copy()
    array.sortInPlace()
    check("array sortInPlace", array, ascending(array), expected, below)
    array.sortInPlaceWith((a, b) -> b.compare(a))
    check("array sortInPlaceWith", array, descendingOrder(array), expected, below)
    array.sortInPlaceBy(x -> x)
    check("array sortInPlaceBy", array, ascending(array), expected, below)

    val buffer = Buffer[int]()
    buffer ++= source
    buffer.sortInPlace()
    check("buffer sortInPlace", buffer, ascending(buffer), expected, below)
    buffer.sortInPlaceWith((a, b) -> b.compare(a))
    check("buffer sortInPlaceWith", buffer, descendingOrder(buffer), expected, below)

    val deque = Deque[int]()
    for i in 0 ..< n do if i % 2 == 0 then deque.prepend(source(i)) else deque.append(source(i))
    deque.sortInPlace()
    check("deque sortInPlace", deque, ascending(deque), expected, below)
    deque.sortInPlaceBy(x -> -x)
    check("deque sortInPlaceBy", deque, descendingOrder(deque), expected, below)

    // Stability across merges: values with few distinct keys, tagged with where they started.
    val tagged = Array.tabulate(n, i -> Tagged(source(i) % 7, i))
    println(stable(tagged.sortBy(t -> t.value)))
    println(stable(tagged.sortWith((a, b) -> a.value.compare(b.value))))
    tagged.sortInPlaceBy(t -> t.value)
    println(stable(tagged))

    // Lengths on either side of the runs the merge starts from, and of their doublings.
    var allSorted = true
    for size in [2, 3, 15, 16, 17, 31, 32, 33, 47, 48, 49, 63, 64, 65, 100, 257]
        val xs = randomInts(size, 10)
        val sizedExpected = counts(xs, 10)
        val s = xs.sorted()
        xs.sortInPlaceWith((a, b) -> b.compare(a))
        val ts = Array.tabulate(size, i -> Tagged(xs(i) % 3, i))
        ts.sortInPlaceBy(t -> t.value)
        if !ascending(s) || counts(s, 10) != sizedExpected || !descendingOrder(xs) || counts(xs, 10) != sizedExpected || !stable(ts)
            println(s"size $size failed")
            allSorted = false
    println(allSorted)
