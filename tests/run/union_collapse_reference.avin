// expect: exit 0
// A generic union whose members are one reference type at an instance, as `T | string` is at
// `T = string`, is that type there: a string, a data value, an object, an option, a tuple or a
// function, never a box around one.
data Point(x: int, y: int)

class Counter(var n: int)

orString[T](x: T) -> T | string = x

orPoint[T](x: T) -> T | Point = x

orCounter[T](x: T) -> T | Counter = x

orOption[T](x: T) -> T | Option[int] = x

orTuple[T](x: T) -> T | (int, string) = x

orFunction[T](x: T) -> T | ((int) -> int) = x

strings[T](x: T) -> Vector[T | string] = [x, "b"]

arr[T](x: T) -> Array[T | string] = Array.fill(2, x)

points[T](x: T) -> Vector[T | Point] = [x, Point(3, 4)]

main()
  val s: string = orString[string]("héllo")
  println(s.charCount)
  println(orString[string](""))
  val pt: Point = orPoint[Point](Point(1, 2))
  println(pt.x + pt.y)
  val c: Counter = orCounter[Counter](Counter(5))
  c.n += 1
  println(c.n)
  val op: Option[int] = orOption[Option[int]](Some(8))
  println(op.map(x -> x + 1))
  val none: Option[int] = orOption[Option[int]](None)
  println(none.isEmpty)
  val t: (int, string) = orTuple[(int, string)]((1, "one"))
  println(t.1)
  val f: (int) -> int = orFunction[(int) -> int](x -> x * 3)
  println(f(5))
  val vs: Vector[string] = strings[string]("a")
  println(vs.mkString("+"))
  val a: Array[string] = arr[string]("q")
  a(0) = "z"
  println(a.toVector)
  val b = arr[int | string](5)
  b(1) = "str"
  println(b.toVector)
  val ps: Vector[Point] = points[Point](Point(1, 1))
  println(ps.map(p -> p.x * p.y).sum)
  val anyv: Any = strings[string]("a")
  anyv match
    v: Vector[string] -> println(s"vector string ${v.length}")
    _ -> println("other")
  val mixed: Vector[int | string] = strings[int](3)
  println(mixed)
