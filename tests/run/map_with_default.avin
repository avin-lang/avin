// expect: exit 0
// `withDefault(f)` and `withDefaultValue(v)` wrap a map of any kind: `apply` of an absent key answers
// the default, while `get`, `contains`, `getOrElse`, `size` and iteration see only the real entries
// and the default is never stored. Updates keep the default, and the wrapper equals and hashes as the
// map it wraps.

open class Animal(val name: string)
class Dog(n: string): Animal(n)

probe(m: Map[string, int])
    val d = m.withDefaultValue(-1)
    println(d("a"), d("zz"), d.get("zz"), d.contains("zz"), d.getOrElse("zz", 7), d.size, d.isEmpty)
    println(d.keys, d.values)

main()
    // every map kind
    probe(HashMap(("a", 1), ("b", 2)))
    probe(TreeMap(("b", 2), ("a", 1)))
    probe(OrderedMap(("b", 2), ("a", 1)))
    probe(Map.empty[string, int]())

    // the default is a function of the key, evaluated on each miss and never stored
    var calls = 0
    val m = HashMap(("a", 1)).withDefault(k ->
        calls += 1
        k.byteLength)
    println(m("abc"), m("abc"), m("xy"), calls, m.size, m.contains("abc"), m.keys)
    println(m("a"), calls)

    // updates and removals keep the default
    val u = m.updated("b", 5)
    println(u("b"), u("missing"), u.size, u.get("missing"))
    val r = u.removed("b")
    println(r("b"), r.size, r.get("b"))
    val pp = (m ++ [("q", 9)]) -- ["a"]
    println(pp("q"), pp("a"), pp.size, pp.keys)
    println(m.updatedWith("a", o -> None)("a"), m.updatedWith("a", o -> None).size)
    val f = m.updated("z", 0).filter((k, v) -> v > 0)
    println(f("z"), f.size, f.filterKeys(k -> k != "a").size, f.filterKeys(k -> k != "a")("a"))

    // a default of a supertype value widens the map
    val animals: Map[string, Animal] = HashMap(("rex", Dog("Rex"))).withDefaultValue(Animal("none"))
    println(animals("rex").name, animals("cat").name, animals.size)
    val widened = HashMap(("rex", Dog("Rex"))).withDefaultValue(Dog("pup")).updated("cat", Animal("Tom"))
    println(widened("cat").name, widened("zzz").name)

    // transform and mapValues answer the wrapped map's own: no default
    val t = m.mapValues(v -> v * 10)
    println(t.get("a"), t.get("nope"), t.size)

    // iteration keeps the wrapped map's order
    val o = OrderedMap(("z", 1), ("a", 2), ("m", 3)).withDefaultValue(0)
    println(o.keys, o.values, o.keysIterator().toVector, o.map((k, v) -> (k, v + 1)).size)
    var seen = ""
    o.foreach((k, v) -> seen += k)
    println(seen)
    val tr = TreeMap((3, "c"), (1, "a")).withDefaultValue("?")
    println(tr.keys, tr(1), tr(2), tr.removed(1)(1), tr.keySet.size)

    // equality and hashing: equal to the map it wraps and to maps of other kinds, ignoring the default
    val plain = HashMap(("a", 1), ("b", 2))
    val w1 = plain.withDefaultValue(0)
    val w2 = plain.withDefaultValue(99)
    val w3 = TreeMap(("b", 2), ("a", 1)).withDefault(k -> 5)
    println(w1 == w2, w1 == plain, plain == w1, w1 == w3, w1.hash() == plain.hash(), w1.hash() == w3.hash())
    println(w1 == plain.updated("c", 3), w1 == plain.withDefaultValue(0).removed("a"))
    val a: Any = w1
    val b: Any = plain
    println(a == b, b == a)

    // display and debug are the wrapped map's
    println(w1, debug(w1), OrderedMap(("x", 1)).withDefaultValue(0), debug(OrderedMap(("x", 1)).withDefaultValue(0)))
    val padded = StringWriter()
    OrderedMap(("x", 1)).withDefaultValue(0).display(padded, FormatSpec(width = 10))
    println(s"[${padded.text}]")

    // a wrapper of a wrapper: the outer default answers
    val ww = w1.withDefaultValue(42)
    println(ww("a"), ww("none"), ww.size)

    // a map is its own function, the wrapper too
    val fn: (string) -> int = w1
    println(fn("b"), fn("nope"), ["a", "q"].map(w1))

    // large and GC pressure
    var big: Map[int, int] = HashMap.empty[int, int]()
    for i in 0 ..< 2000 do big = big.updated(i, i * 2)
    val bd = big.withDefault(k -> -k)
    var sum = 0
    for i in 0 ..< 4000 do sum += bd(i)
    println(sum, bd.size, bd.get(3000))
    var chain: Map[int, int] = Map.empty[int, int]().withDefaultValue(1)
    for i in 0 ..< 500 do chain = chain.updated(i, i)
    println(chain.size, chain(499), chain(500))
