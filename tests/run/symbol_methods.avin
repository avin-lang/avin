// expect: exit 0
// A method may be named by a run of operator characters and called infix: `xs ++ ys` is
// `xs.++(ys)`. Such a call binds at the level of the operator its first character belongs to, `++`
// with `+` and `:+` with `::`, and groups to the left, except that a name ending in `:` groups to the right and takes
// its receiver on the right: `x +: xs` is `xs.+:(x)`, with `x` evaluated first. `x op= y` calls the
// target's method `op=` when it has one, and otherwise, for a symbol method `op`, assigns
// `x = x op y`. `i++` still increments, since no operand follows it on the line.

class Acc(val n: int)
    ++(k: int) -> Acc = Acc(n * 10 + k)
    *:(k: int) -> Acc = Acc(n * k)

data Money(cents: int)

impl Money
    <+>(other: Money) -> Money = Money(cents + other.cents)

trait Joinable
    ++(other: Self) -> Self

data Path(parts: Vector[string])

impl Joinable for Path
    ++(other: Path) -> Path = Path(parts ++ other.parts)

joinAll[T: Joinable](a: T, b: T, c: T) -> T = a ++ b ++ c

trait Sized
    size() -> int

// An impl adds a symbol method to a trait, which every conforming value has.
impl Sized
    <=>(other: Sized) -> int = size() - other.size()

class Box(n: int): Sized
    override size() -> int = n

class Counter(var n: int)
    +=(k: int)
        n = n + k

impl Counter
    -=(k: int)
        n = n - k

class Holder(val c: Counter, var items: Vector[int])
    take(more: Vector[int])
        items ++= more

var log: Vector[string] = []

noisy(label: string, n: int) -> int
    println(label)
    n

noisyVector(label: string) -> Vector[int]
    println(label)
    [9]

main()
    // The library's symbol methods.
    val v = [2, 3]
    println(s"${v :+ 4} ${1 +: v} ${v ++ [7, 8]} ${v.++([5])} ${v.:+(6)} ${v.+:(0)}")
    println(s"${0 +: 1 +: (v :+ 4 :+ 5)} ${(0 +: v) :+ 4}")
    println(s"${v ++ [1] == [2, 3, 1]} ${v :+ 1 != v && 1 +: v != v}")
    // `++` binds with `+`, more tightly than `::`.
    println(s"${(1 :: 2 :: []) ++ (3 :: [])}")
    val m = Map[string, int]().updated("a", 1) ++ Map[string, int]().updated("b", 2)
    println(s"${m.size} ${m("a")} ${m("b")}")
    val buffer = Buffer[int]()
    buffer += 1
    buffer ++= [2, 3]
    buffer.addOne(4)
    buffer.+=(5)
    println(s"$buffer")

    // A class's, a data type's through an impl, and a trait's, also through a bound.
    println(s"${(Acc(1) ++ 2 ++ 3).n}")
    println(s"${(Acc(1) ++ (2 + 3)).n}")
    println(s"${(Acc(4) ++ 1).n > 40}")
    println(s"${(3 *: 2 *: Acc(5)).n}")
    println(s"${(Money(5) <+> Money(7)).cents}")
    println(s"${joinAll(Path(["a"]), Path(["b"]), Path(["c", "d"])).parts}")
    println(s"${Box(5) <=> Box(2)}")

    // A right-grouping call evaluates its operands in the order they are written.
    val w = noisy("left", 1) +: noisy("middle", 2) +: noisyVector("right")
    println(s"$w")

    // `op=` calls the method where the target's type has one, and otherwise assigns.
    val counter = Counter(1)
    counter += 10
    counter -= 3
    println(s"${counter.n}")
    val h = Holder(Counter(0), [1])
    h.c += 4
    h.items ++= [2, 3]
    h.items :+= 4
    h.take([5])
    println(s"${h.c.n} ${h.items}")
    log :+= "one"
    log ++= ["two"]
    println(s"$log")
    var xs = [1]
    xs ++= [2]
    xs :+= 3
    println(s"$xs")
    val rows = [[1], [2]].toArray()
    rows(1) ++= [20]
    val buffers = [Buffer[int](), Buffer[int]()].toArray()
    buffers(0) += 7
    println(s"${rows(1)} ${buffers(0)}")

    // `++` with no operand after it on its line updates the operand before it.
    var i = 0
    i++
    ++i
    val joined = v ++ [i]
    i--
    println(s"$joined $i")
