// expect: exit 0
// An option of a reference type is kept as a pointer, `None` being null. The comparison operators on
// it run `Ord`'s default bodies, which take their receiver as an object, so a null `None` must go in
// as the object it stands for: every operator, in both orders, with `None` on either side, on classes,
// data types, strings, nested options and options of options of objects.

class Version(val major: int, val minor: int) derives Eq, Hash, Ord

data Node(label: string) derives Ord

all(a: Option[Version], b: Option[Version]) -> string = s"${a < b} ${a <= b} ${a > b} ${a >= b} ${a == b} ${a != b}"

main()
    val none: Option[Version] = None
    val v1: Option[Version] = Some(Version(1, 0))
    val v2: Option[Version] = Some(Version(1, 1))
    println(all(none, none))
    println(all(none, v1))
    println(all(v1, none))
    println(all(v1, v2))
    println(all(v2, v1))
    println(all(v1, v1))

    val noNode: Option[Node] = None
    val node: Option[Node] = Some(Node("a"))
    println(s"${noNode < node} ${node < noNode} ${noNode >= node} ${node > noNode} ${noNode <= noNode}")

    val noString: Option[string] = None
    val text: Option[string] = Some("x")
    println(s"${noString < text} ${text <= noString} ${noString >= noString} ${text > noString}")

    val outerNone: Option[Option[Node]] = None
    val innerNone: Option[Option[Node]] = Some(None)
    val inner: Option[Option[Node]] = Some(Some(Node("z")))
    println(s"${outerNone < innerNone} ${innerNone < inner} ${inner > outerNone} ${innerNone >= innerNone} ${outerNone > inner}")

    val chain = Vector(v2, none, v1).sorted()
    println(chain.map(o -> o.map(v -> v.minor)))
    println(none < v1 && v1 < v2)
    println(Vector(v2, none, v1).max.map(v -> v.minor))
    println(Vector(v2, none, v1).min.isEmpty())
