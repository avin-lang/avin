// expect: exit 0
// A queue driven by many mixes of enqueue and dequeue agrees with a vector model at every step, and
// every earlier version stays as it was (persistence). Also equality across differently split
// internal lists, hashing, and ordinary operations against the model.

class Rng(var state: long)
    next(bound: int) -> int
        state = (state *% 6364136223846793005 +% 1442695040888963407)
        val x = (state >> 33) & 0x7fffffff
        int(x % long(bound))

same(q: Queue[int], m: Vector[int]) -> bool = q.length == m.length && q == m && q.toVector == m

main(args: Vector[string])
    // Several enqueue/dequeue ratios, with every version kept for a later check.
    var failures = 0
    for bias in [1, 2, 3, 5, 8]
        val rng = Rng(long(bias) * 977)
        var q = Queue.empty[int]()
        var m = Vector.empty[int]()
        val versions = Buffer[Queue[int]]()
        val models = Buffer[Vector[int]]()
        for step in 0 ..< 120
            if rng.next(10) < bias || m.isEmpty
                q = q.enqueue(step)
                m = m :+ step
            else
                val (x, rest) = q.dequeue
                if x != m.head then failures += 1
                q = rest
                m = m.tail
            if !same(q, m) then failures += 1
            if m.nonEmpty && q.front != m.head then failures += 1
            if m.nonEmpty && q(m.length - 1) != m.last then failures += 1
            if step % 10 == 0
                versions.append(q)
                models.append(m)
        for i in 0 ..< versions.length
            if !same(versions(i), models(i)) then failures += 1
    println(failures)

    // Equal contents reached by different splits of front and back compare and hash equal.
    val a = Queue(1, 2, 3, 4)
    val b = Queue(0, 1, 2, 3, 4).dequeue.1
    val c = Queue.empty[int]().enqueue(1).enqueue(2).enqueue(3).enqueue(4)
    val d = Queue(1, 2).enqueueAll([3, 4])
    val e = Queue(9, 1, 2).dequeue.1.enqueue(3).enqueue(4)
    println(a == b && b == c && c == d && d == e)
    println(a.hash() == b.hash() && b.hash() == c.hash() && c.hash() == d.hash() && d.hash() == e.hash())
    println(a == Vector(1, 2, 3, 4))
    println(a == List(1, 2, 3, 4))
    println(a.hash() == Vector(1, 2, 3, 4).hash())
    println(a != Queue(1, 2, 3))
    println(a != Queue(1, 2, 3, 5))
    println(Queue.empty[int]() == Queue.empty[int]())
    println(Queue.empty[int]() == Queue(1).dequeue.1)
    println(Queue.empty[int]() != Queue(1))

    // map, filter, filterNot, flatMap answer queues; the rest from Seq works.
    val q = Queue(1, 2, 3, 4, 5, 6)
    println(q.map(x -> x * x))
    println(q.filter(x -> x % 2 == 0))
    println(q.filterNot(x -> x % 2 == 0))
    println(q.flatMap(x -> [x, -x]).length)
    println(q.map(x -> s"<$x>"))
    println(q.sum)
    println(q.reverse)
    println(q.take(2))
    println(q.contains(4))
    println(q.toQueue == q)
    println(q.dequeue.1.enqueue(7).filter(x -> x > 2).map(x -> x + 1))

    // A drained queue and one built by the builder.
    var r = q
    var total = 0
    while r.nonEmpty
        val (x, more) = r.dequeue
        total += x
        r = more
    println(total)
    val bld = Queue.newBuilder[int]()
    for i in 0 ..< 5 do bld.addOne(i)
    println(bld.knownSize)
    println(bld.result())
