// expect: trap
// A function whose result is `Nothing`, converted to a function of another result, still runs when
// called through the wider type: here through a generic function's parameter, whose type argument the
// other argument decided, the call reaches it and its trap stops the program.

refuse(x: int) -> Nothing = fail(s"refused $x")

pick[A, R](first: bool, f: (A) -> R, g: (A) -> R) -> (A) -> R = if first then f else g

main()
    val some = (x: int) -> Some(x)
    val chosen = pick(true, refuse, some)
    println("chosen")
    println(chosen(1))
