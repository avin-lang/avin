// expect: exit 0
// The mutable tree map's API at its edges: empty and one entry, every ordered query at the bounds,
// string keys, a reversed and a custom order, snapshots, iteration while the map is updated, the
// operators, equality, display, builders, and both tree maps imported together.

import avin.collections.mutable.{TreeMap as MutableTreeMap, TreeSet as MutableTreeSet}
import avin.collections.mutable.TreeMap
import avin.{TreeMap as ImmutableTreeMap}

// A key ordered by its length first, then alphabetically.
data Word(text: string)

impl Ord for Word
    compare(other: Word) -> int =
        if text.byteLength() != other.text.byteLength() then text.byteLength() - other.text.byteLength()
        else text.compare(other.text)

main()
    // Empty.
    val e = MutableTreeMap[int, string]()
    println(e.isEmpty)
    println(e.size)
    println(e.headOption)
    println(e.lastOption)
    println(e.minAfter(0))
    println(e.maxBefore(0))
    println(e.removeFirstOption())
    println(e.removeLastOption())
    println(e.remove(3))
    println(e.range(0, 10).isEmpty)
    println(e.rangeFrom(0).isEmpty)
    println(e.rangeTo(0).isEmpty)
    println(e.rangeUntil(0).isEmpty)
    println(e.get(1))
    println(e.getOrElse(1, "none"))
    println(e)

    // One entry.
    val one = MutableTreeMap[int, string]()
    one(5) = "five"
    println(one.firstKey() == 5 && one.lastKey() == 5)
    println(one.minAfter(5))
    println(one.minAfter(6))
    println(one.maxBefore(5))
    println(one.maxBefore(6))
    println(one.range(5, 5).isEmpty)
    println(one.range(5, 6).size)
    println(one.range(6, 5).isEmpty)
    println(one.rangeTo(5).size)
    println(one.rangeUntil(5).isEmpty)
    println(one.removeFirst())
    println(one.isEmpty)
    one(1) = "one"
    println(one.removeLast())
    println(one.isEmpty)

    // Integer extremes as keys.
    val ext = MutableTreeMap[int, int]()
    ext(-2147483647 - 1) = 1
    ext(2147483647) = 2
    ext(0) = 3
    println(ext.keys)
    println(ext.minAfter(-2147483647 - 1))
    println(ext.maxBefore(2147483647))

    // String keys, including the empty string and non-ASCII text.
    val s = MutableTreeMap[string, int]()
    s("pear") = 1
    s("") = 2
    s("apple") = 3
    s("zebra") = 4
    s("élan") = 5
    s("apple") = 6
    println(s)
    println(s.keys)
    println(s.minAfter("b"))
    println(s.maxBefore("b"))
    println(s.range("apple", "pear"))
    println(s.removeFirst())
    println(s.firstKey())

    // A reversed order.
    val r = MutableTreeMap[Reverse[int], string]()
    for i in 1..5 do r(Reverse(i)) = "v" + i.toString()
    println(r.firstKey().value)
    println(r.lastKey().value)
    println(r.minAfter(Reverse(3)).map(e -> e.0.value))
    println(r.maxBefore(Reverse(3)).map(e -> e.0.value))
    println(r.range(Reverse(4), Reverse(1)).keys.map(k -> k.value))
    println(r.removeFirst().0.value)

    // A custom order.
    val w = MutableTreeMap[Word, int]()
    for t in ["ccc", "a", "bb", "aa", "b", "abc"] do w(Word(t)) = t.byteLength()
    println(w.keys.map(k -> k.text))
    println(w.minAfter(Word("zz")).map(e -> e.0.text))
    println(w.maxBefore(Word("aa")).map(e -> e.0.text))

    // Updates through the operators and helpers.
    val m = MutableTreeMap[int, int]()
    m += (3, 30)
    m ++= [(1, 10), (2, 20), (3, 33)]
    println(m)
    m -= 2
    println(m)
    m --= [1, 99]
    println(m)
    println(m.getOrElseUpdate(7, 70))
    println(m.getOrElseUpdate(7, 71))
    println(m.updateWith(7, v -> v.map(x -> x + 1)))
    println(m.updateWith(7, v -> None))
    println(m.updateWith(8, v -> Some(80)))
    println(m)
    println(m(3))
    m.addAll([(0, 0), (-1, -10)])
    m.filterInPlace((k, v) -> k != 0)
    println(m)
    println(m.mapValues(v -> v * 2))
    println(m.transform((k, v) -> k + v))
    println(m.filter((k, v) -> v > 0))
    println(m.filterKeys(k -> k > 3))
    println(m.map((k, v) -> (-k, v)))
    println(m.flatMap(kv -> [(kv.0, kv.1), (kv.0 + 100, kv.1)]))
    println(m.keySet)
    println(m.values)
    var sum = 0
    m.foreach((k, v) -> sum += v)
    println(sum)
    val yielded: MutableTreeMap[int, int] = for (k, v) in m if v > 0 yield (k, v + 1)
    println(yielded)

    // A snapshot and an iterator are not touched by later updates.
    val snap = m.toTreeMap()
    val it = m.iterator()
    m(100) = 1
    m.remove(3)
    println(snap.size)
    println(it.toVector)
    println(m.size)
    val cp = m.copy()
    cp(200) = 2
    println(!m.contains(200) && cp.contains(200))
    m.clear()
    println(m.isEmpty)
    println(snap.size)

    // Updating while iterating is safe: the loop sees the map as it was.
    val live = MutableTreeMap[int, int]()
    for i in 0..<10 do live(i) = i
    var seen = 0
    for (k, v) in live
        live.remove(k + 1)
        live(k + 100) = k
        seen += 1
    println(seen)
    println(live.size)

    // Equality and hash follow the entries.
    val a = MutableTreeMap[int, int]()
    val b = MutableTreeMap[int, int]()
    a(1) = 1
    a(2) = 2
    b(2) = 2
    b(1) = 1
    println(a == b)
    println(a.hash() == b.hash())
    b(3) = 3
    println(a == b)
    println(a.toTreeMap().hash() == a.hash())

    // Debug form and builders.
    val named = MutableTreeMap[string, int]()
    named("a") = 1
    println(debug(named))
    val built = MutableTreeMap.newBuilder[int, int]()
    built.addOne((2, 1))
    built.addOne((1, 1))
    built.addOne((2, 5))
    println(built.result())
    val lit = MutableTreeMap((3, "c"), (1, "a"), (3, "z"))
    println(lit)
    println(MutableTreeMap.empty[int, int]().size)

    // The two tree maps meet in one program and stay apart.
    val im = ImmutableTreeMap((2, "b"), (1, "a"))
    val mu = TreeMap[int, string]()
    for (k, v) in im do mu(k) = v
    mu(0) = "z"
    println(im.size)
    println(mu.size)
    println(MutableTreeMap.fromTree(im) == MutableTreeMap((1, "a"), (2, "b")))

    // A tree set's keys from a map.
    val ks = MutableTreeSet[int]()
    for k in mu.keysIterator() do ks.add(k)
    println(ks)
