// expect: exit 0
// Two mirrors of Sysl enums in one module share the variant `Inherit`, as `sysl.process`'s `Stdio`
// and `Group` do. Each bare `Inherit` is decided by the parameter it is passed to, and crosses into
// Sysl as its own enum's variant.
@sysl("sysl.process.Status")
data Status
  Exited(code: int)
  Signalled(signal: int)
  TimedOut

@sysl("sysl.fs.IoError")
data SyslError
  NotFound
  PermissionDenied
  AlreadyExists
  NotADirectory
  IsADirectory
  DirectoryNotEmpty
  TooManyOpenFiles
  NoSpaceLeft
  Interrupted
  NotOpen
  NotPermitted
  InvalidUtf8(offset: long)
  Other(code: int)

@sysl("sysl.fs.File")
class File
  fd() -> Result[int, SyslError]

@sysl("sysl.process.Stdio")
data Stdio
  Inherit
  ToFile(file: File)
  ToPath(path: string)
  FromFile(file: File)
  FromPath(path: string)

@sysl("sysl.process.Group")
data Group
  Inherit
  New
  Join(pgid: int)

@sysl("sysl.process.Var")
data Var(name: string, value: string)

@sysl("sysl.process.run")
runProgram(program: string, args: Vector[string], dir: string, env: Vector[Var], timeout: int, inheritEnv: bool, stdout: Stdio, stderr: Stdio, stdin: Stdio, group: Group, foreground: bool) -> Result[Status, SyslError]

describe(r: Result[Status, SyslError]) -> string = r match
  Ok(Exited(code)) -> s"exited $code"
  Ok(Signalled(n)) -> s"signalled $n"
  Ok(TimedOut) -> "timed out"
  Err(NotFound) -> "not found"
  Err(e) -> s"error $e"

main()
  println(describe(runProgram("/usr/bin/true", [], "", [], 0, true, Inherit, Inherit, Inherit, Inherit, false)))
  println(describe(runProgram("/usr/bin/false", [], "", [], 0, true, Stdio.Inherit, Inherit, Inherit, Group.Inherit, false)))
  println(describe(runProgram("/usr/bin/true", [], "", [], 0, true, Inherit, Inherit, Inherit, New, false)))
  println(describe(runProgram("/no/such/program", [], "", [], 0, true, Inherit, Inherit, Inherit, Inherit, false)))
  val g: Group = Inherit
  val s: Stdio = Inherit
  println(s"$g ${s is Inherit} ${s is ToPath(_)}")
