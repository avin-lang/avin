// expect: exit 0
// A deferred statement runs to its end once begun, its thread's cancellation notwithstanding: one a
// cancellation runs may itself wait (a sleep, a channel, a join, a scope of its own whose threads run
// to their ends), and so may one its block's own end began when the cancellation came in the middle
// of it; the thread goes on to its next cancellation point after, and stops there.
import avin.threads.{Atomic, Channel, scope, sleep}
import avin.time.{hours, millis}

stopped(log: Channel[string], gate: Channel[int], started: Atomic[int])
  defer
    sleep(millis(5))
    val got = gate.receive()
    val inner = scope(s -> s.spawn(() -> 5).join())
    log.send(s"cleanup after the cancellation waited for $got and joined $inner")
  started.add(1)
  sleep(hours(1))
  log.send("slept an hour")

returning(log: Channel[string], gate: Channel[int], started: Atomic[int])
  defer
    started.add(1)
    val got = gate.receive()
    log.send(s"cleanup the cancellation came in waited for $got")
  ()

thenStops(log: Channel[string], gate: Channel[int], started: Atomic[int])
  returning(log, gate, started)
  started.add(10)
  sleep(hours(1))
  log.send("slept an hour")

main()
  val log = Channel[string](16)
  val started = Atomic(0)
  val gate = Channel[int](4)
  scope(s ->
    s.spawn(() -> stopped(log, gate, started))
    s.spawn(() -> thenStops(log, gate, started))
    while started.load() < 2 do sleep(millis(1))
    s.cancel()
    sleep(millis(20))
    gate.send(1)
    gate.send(2))
  var lines: Buffer[string] = Buffer()
  while log.tryReceive() is Some(line) do lines.append(line)
  for line in lines.toVector.sorted do println(line.replace("1", "n").replace("2", "n"))
  println(s"went on to the next cancellation point: ${started.load() == 12}")
