// expect: exit 0
// `max` and `min` as methods of the integers, `real`, `char` and `byte`, beside the free functions;
// the integers' own `MaxValue` and `MinValue` are separate names and stay.

import avin.math

main(args: Vector[string])
  println(s"${3.max(4)} ${3.min(4)} ${4.max(3)} ${4.min(3)} ${3.max(3)} ${3.min(3)}")
  println(s"${(-5).max(-9)} ${(-5).min(-9)} ${0.max(-0)}")
  println(s"${int.MaxValue.max(1)} ${int.MaxValue.min(1)} ${int.MinValue.max(1)} ${int.MinValue.min(1)}")
  println(s"${long.MaxValue.max(long(0))} ${long.MinValue.min(long(0))} ${long(5).max(long(7))} ${long(5).min(long(7))}")
  println(s"${i8(100).max(i8(-100))} ${i8(100).min(i8(-100))} ${i16(300).max(i16(2))} ${i16(300).min(i16(2))}")
  println(s"${int.MaxValue} ${int.MinValue} ${long.MaxValue}")
  println(3.max(4) == max(3, 4))
  println(3.min(4) == min(3, 4))
  println(1 max 2 min 0)

  println(s"${1.5.max(2.5)} ${1.5.min(2.5)} ${(-1.5).max(-2.5)} ${(-1.5).min(-2.5)}")
  println(s"${1.0.max(real.NaN)} ${real.NaN.max(1.0)} ${1.0.min(real.NaN)} ${real.NaN.min(1.0)}")
  println(s"${(-0.0).max(0.0)} ${(0.0).max(-0.0)} ${(-0.0).min(0.0)} ${(0.0).min(-0.0)}")
  println(1.0.max(2.0) == math.max(1.0, 2.0))
  println(s"${real.PositiveInfinity.max(1.0)} ${real.NegativeInfinity.min(1.0)}")

  println(s"${'a'.max('b')} ${'a'.min('b')} ${'z'.max('a')} ${'é'.max('e')} ${'é'.min('e')}")
  println(s"${'😀'.max('z')} ${'😀'.min('z')} ${'q'.max('q')}")

  println(s"${byte(200).max(byte(3))} ${byte(200).min(byte(3))} ${byte(0).max(byte(255))} ${byte(0).min(byte(255))}")
  println(byte(128).max(byte(127)) == byte(128))
