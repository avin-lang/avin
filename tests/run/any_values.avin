// expect: exit 0
// `Any` in fields, tuple parts and generic hierarchies: a value converts where it is written, and
// a type pattern on a trait's or an open generic class's type tests the object's exact type.

trait Pet
    name() -> string

open class Animal(val legs: int)

open class Dog(val called: string): Animal(4), Pet
    override name() -> string = called

class Cat(): Pet
    override name() -> string = "cat"

open class Base[T](val item: T)

class Derived[T](item: T, val extra: int): Base[T](item)

class Slot(var held: Any)

show(x: Any) -> string = x match
    s: string -> s"'$s'"
    n: int -> s"$n"
    b: bool -> s"$b"
    _: unit -> "()"
    d: Derived[int] -> s"derived int ${d.item} ${d.extra}"
    b: Base[int] -> s"base int ${b.item}"
    b: Base[string] -> s"base string ${b.item}"
    t: (Dog, int) -> s"dog pair ${t.0.name()} ${t.1}"
    t: (Animal, int) -> s"animal pair ${t.0.legs} ${t.1}"
    _ -> "other"

// A trait-typed value is matched by the classes conforming to it.
kind(p: Pet) -> string = p match
    d: Dog -> s"dog ${d.called}"
    _: Cat -> "a cat"
    _ -> "another pet"

main() -> int
    // A class's field of type `Any` takes a boxed value, and a new one on assignment.
    val slot = Slot(1)
    println(show(slot.held))
    slot.held = "two"
    println(show(slot.held))
    slot.held = false
    println(show(slot.held))
    slot.held = ()
    println(show(slot.held))
    // A tuple written out converts each part to its expected type.
    val pair: (Any, int) = ("first", 2)
    println(s"${show(pair.0)} ${pair.1}")
    // An open generic class's type pattern names its type arguments; a subclass's instance matches.
    println(show(Derived(5, 6)))
    println(show(Base(7)))
    println(show(Base("seven")))
    println(show(Derived("eight", 8)))
    // A tuple's parts may be instances of subclasses of the type a pattern names.
    println(show((Dog("rex"), 1)))
    val animal: Animal = Dog("fido")
    println(show((animal, 2)))
    println(show((Animal(6), 3)))
    println(kind(Dog("max")))
    println(kind(Cat()))
    // A value already of type `Any` passes through a conversion unchanged.
    val a: Any = 3
    val b: Any = a
    println(show(b))
    0
