// expect: exit 0
// A program's own operators and methods that read a module-level `var` are reached by a thread's body
// only where the body's code may really call them. A call through an operator on a final class, or on
// a class whose subclasses are all known, reaches that class's method and its subclasses', never a
// method of the same name of another class. A generic function, in the standard library or the
// program, called at known type arguments reaches only what those types implement: `+` and `/` on
// integers and on `BigInt`, the hashing and equality of a map's `int` keys, sorting `int`s, and
// printing. A type parameter's bound limits it further, to the types that conform: a program type
// that does not implement `Integer` is never the element of a counting iterator.
import avin.threads.{spawn, Future}

var count = 0

// Its operators read `count`, so only `main` uses them.
data Money(cents: int)

impl Add for Money
  static zero() -> Money = Money(count)
  add(other: Money) -> Money = Money(cents + other.cents + count)

impl Sub for Money
  subtract(other: Money) -> Money = Money(cents - other.cents - count)

impl Div for Money
  divide(other: Money) -> Money = Money(cents / other.cents + count)

impl Mul for Money
  static one() -> Money = Money(1 + count)
  multiply(other: Money) -> Money = Money(cents * other.cents + count)

// A class with an `add` of its own that reads `count`, beside one whose `add` does not.
class Tally(val n: int)
  add(other: Tally) -> Tally = Tally(n + other.n + count)

class Meter(val n: int)

impl Add for Meter
  static zero() -> Meter = Meter(0)
  add(other: Meter) -> Meter = Meter(n + other.n)

// An open class whose `+` reads no module state in it or in any subclass.
open class Weight(val grams: int)

impl Add for Weight
  static zero() -> Weight = Weight(0)
  add(other: Weight) -> Weight = Weight(grams + other.grams)

class Heavy(g: int) : Weight(g * 2)

heavy() -> Weight = Heavy(3)

twice[T: Add](x: T) -> T = x + x

main()
  spawn(() -> println(12)).join()
  spawn(() -> println(BigInt(10).pow(30) / BigInt(7))).join()
  spawn(() -> println(BigInt(10).pow(20) - BigInt(1))).join()
  spawn(() -> println({1: "one", 2: "two"}.updated(3, "three").size)).join()
  spawn(() -> println([3, 1, 2].sorted)).join()
  spawn(() -> println([1, 2, 3].sum)).join()
  spawn(() -> println([2, 2, 3].distinct.length)).join()
  spawn(() -> println(Future.successful(4).await())).join()
  spawn(() -> println((Meter(2) + Meter(3)).n)).join()
  spawn(() -> println((Weight(2) + heavy()).grams)).join()
  spawn(() -> println(twice(21))).join()
  spawn(() -> println(twice(Meter(4)).n)).join()
  count += 1
  println((Money(4) + Money(3) - Money(1)).cents)
  println((Money(9) / Money(3) * Money(2)).cents)
  println(Tally(1).add(Tally(2)).n)
  println(twice(Money(5)).cents)
