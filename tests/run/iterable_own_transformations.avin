// expect: exit 0

// A program's own class conforming to `Iterable` has `map`, `flatMap`, `filter`, `withFilter`,
// `collect` and `zip`, each answering an `Iterable` of its elements in iteration order. The library's
// collections keep their own, of their own kind.
class Three: Iterable[int]
    override iterator() -> Iterator[int] = [1, 2, 3].iterator()

class Nothing0: Iterable[string]
    override iterator() -> Iterator[string] = Vector.empty[string]().iterator()

// A generic collection of its own, which hands out a fresh iterator each time.
class Bag[T](private val items: Vector[T]): Iterable[T]
    override iterator() -> Iterator[T] = items.iterator()

// An iterator of its own is an `Iterable` too, but `Iterator`'s own lazy forms are its.
class Countdown(private var n: int): Iterator[int]
    override hasNext() -> bool = n > 0
    override next() -> int
        n -= 1
        n + 1

doubled(xs: Iterable[int]) -> Iterable[int] = xs.map(x -> x * 2)

main()
    val t = Three()
    val m: Iterable[int] = t.map(x -> x * 2)
    println(m)
    println(t.map(x -> s"<$x>"))
    println(t.flatMap(x -> [x, -x]))
    println(t.flatMap(x -> List.empty[int]()))
    println(t.flatMap(x -> Some(x).toList()))
    println(t.filter(x -> x != 2))
    println(t.filter(x -> false))
    println(t.withFilter(x -> x > 1))
    println(t.collect(match
        1 -> "one"
        3 -> "three"))
    println(t.zip(["a", "b"]))
    println(t.zip(1..10))
    println(t.zip(Vector.empty[char]()))
    println(for x in t if x > 1 yield x * 10)
    val pairs = for
        x in t
        y in Bag(["a", "b"])
    yield s"$x$y"
    println(pairs)
    // Chained, and the source traversed again each time.
    println(t.map(x -> x + 1).filter(x -> x % 2 == 0).map(x -> x * 100))
    println(t.map(x -> x).toList)
    // A closure capturing a local, and a mutable one.
    val offset = 7
    var calls = 0
    println(t.map(x ->
        calls += 1
        x + offset))
    println(calls)
    // An empty collection of its own.
    val none = Nothing0()
    println(none.map(s -> s.charCount()))
    println(none.filter(s -> true).isEmpty)
    println(none.zip(t))
    println(none.flatMap(s -> [s]))
    // Generic, with references and with values.
    val bag = Bag(["x", "yy", "zzz"])
    println(bag.map(s -> s.charCount()))
    println(bag.filter(s -> s.charCount() > 1))
    println(Bag([Some(1), None, Some(3)]).collect(match
        Some(v) -> v))
    println(Bag(Vector.empty[int]()).map(x -> x))
    println(Bag([(1, "a"), (2, "b")]).map(p -> p.1.repeat(p.0)))
    println(Bag([int.MinValue, int.MaxValue]).map(x -> long(x) * 2))
    // Code generic over `Iterable` calls them on anything.
    println(doubled(t))
    println(doubled([1, 2]))
    println(doubled(List(3)))
    println(doubled({5}))
    println(doubled(0..<3))
    // The library's collections keep their own kind.
    val l: List[int] = List(1, 2).map(x -> x + 1)
    println(l)
    val s: Set[int] = {1, 2, 3}.map(x -> x % 2)
    println(s)
    val v: Vector[int] = (1..3).map(x -> x * x)
    println(v)
    val a: Array[int] = Array.tabulate(2, i -> i + 1).map(x -> -x)
    println(a)
    val ts: TreeSet[int] = TreeSet(3, 1, 2).filter(x -> x > 1)
    println(ts)
    val mm: Map[string, int] = {1: "a"}.map((k, w) -> (w, k))
    println(mm)
    val buf: Buffer[int] = [1, 2]
    val b: Buffer[int] = buf.map(x -> x * 3)
    println(b)
    // An iterator keeps its lazy forms.
    var seen = 0
    val lazy: Iterator[int] = Countdown(1000000).map(x ->
        seen += 1
        x)
    println(lazy.take(2).toVector)
    println(seen)
    println(Countdown(3).zip(t).toVector)
