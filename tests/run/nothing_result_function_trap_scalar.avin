// expect: trap
// A function whose result is `Nothing`, converted to a function yielding an `int`, is called through
// that type with the result used in arithmetic: the call reaches it, and its trap stops the program.

refuse(x: int) -> Nothing = fail(s"refused $x")

twice(f: (int) -> int, x: int) -> int = f(f(x)) + 1

main()
  println(twice(x -> x * 2, 3))
  val counted: (int) -> int = refuse
  println(twice(counted, 5))
