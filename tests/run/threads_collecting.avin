// expect: exit 0
// env: AVIN_GC_STRESS=0
// Eight threads allocate far more than survives, running in parallel, so collections the heap's
// budget starts stop threads in the middle of their work, many times over, while each keeps a long
// list alive. Every list is checked whole after its thread is joined.
import avin.threads.spawn

churn(id: int, rounds: int) -> List[string]
    var kept: List[string] = []
    for r in 0..<rounds
        var scratch: List[string] = []
        for i in 0..<200
            scratch = s"$id:$r:$i" :: scratch
        kept = scratch.head() :: kept
    kept

main() -> int
    val rounds = 2000
    var threads: List[avin.threads.Thread[List[string]]] = []
    for id in 0..<8
        threads = spawn(() -> churn(id, rounds)) :: threads
    var failures = 0
    var id = 7
    for t in threads
        var r = rounds - 1
        for w in t.join()
            if w != s"$id:$r:199" then failures++
            r--
        if r != -1 then failures++
        id--
    print(s"$failures failures")
    failures
