// expect: exit 0
// Unix domain sockets: a listener at a path, connections echoed by lightweight threads (one, then
// many at once), lines, reads of a size, everything to the end, the end of sending, an empty line,
// Unicode text, a client blocked reading while the server delays, a peer closing mid-line, timeouts,
// and what a closed connection and listener answer.
import avin.fs
import avin.io.{IoError, TimedOut, Other}
import avin.net.{UnixListener, UnixStream}
import avin.threads.{spawn, sleep}
import avin.time

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message())

bytesOf(text: string) -> Array[byte] = Array.tabulate(text.byteLength(), i -> text.byteAt(i))

// Echoes each line it reads, upper-cased, until the other end finishes sending, and says how many.
echoLines(s: UnixStream) -> int
    var n = 0
    while true
        ok(s.readLine()) match
            Some(line) ->
                ok(s.writeText(line.toUpperCase() + "\n"))
                n += 1
            None ->
                s.close()
                return n
    n

main()
    val dir = ok(fs.createTempDir("avu"))
    val sock = dir + "/s"
    val l = ok(UnixListener.bind(sock))
    println(l.path() == sock)
    println(fs.exists(sock))

    // One connection: lines with both terminators, an empty line, Unicode, a last line with none.
    val lines = spawn(() -> echoLines(ok(l.accept())))
    val c = ok(UnixStream.connect(sock))
    ok(c.writeText("one\r\ntwo\n\nhéllo 世界 \U0001F600\n"))
    for _ in 0..<4
        println(ok(c.readLine()))
    ok(c.writeText("no terminator"))
    ok(c.shutdownOutput())
    println(ok(c.readLine()))
    println(ok(c.readLine()))
    c.close()
    c.close()
    println(lines.join())

    // Many clients at once, each on its own lightweight thread, served by threads that accept them.
    val server = spawn(() ->
        for _ in 0..<40
            val conn = ok(l.accept())
            spawn(() ->
                val got = ok(conn.readLine())
                ok(conn.writeText(s"echo ${got.getOrElse("")}\n"))
                conn.close()
                0)
        0)
    val clients = (0..<40).map(i -> spawn(() ->
        val s = ok(UnixStream.connect(sock))
        ok(s.writeText(s"hi$i\n"))
        val back = ok(s.readLine())
        s.close()
        back == Some(s"echo hi$i"))).toVector
    println(clients.map(t -> t.join()).count(b -> b))
    server.join()

    // A client blocked reading while the server delays; the other threads run meanwhile.
    val slow = spawn(() ->
        val s = ok(l.accept())
        ok(s.readLine())
        sleep(time.millis(150))
        ok(s.writeText("late\n"))
        s.close()
        0)
    val w = ok(UnixStream.connect(sock))
    ok(w.writeText("go\n"))
    val ticks = spawn(() ->
        var n = 0
        for _ in 0..<5
            sleep(time.millis(10))
            n += 1
        n)
    println(ok(w.readLine()))
    println(ticks.join())
    w.close()
    slow.join()

    // Reads of a size take what has arrived, at most the size; what a line read leaves comes first.
    val reader = spawn(() ->
        val s = ok(l.accept())
        ok(s.writeText("head\nbody-bytes"))
        ok(s.shutdownOutput())
        ok(s.readAll()).length)
    val r = ok(UnixStream.connect(sock))
    println(ok(r.readLine()))
    println(string.fromUtf8Lossy(ok(r.read(4))))
    println(string.fromUtf8Lossy(ok(r.readAll())))
    println(ok(r.read(10)).length)
    println(ok(r.readLine()))
    r.close()
    println(reader.join())

    // A peer that closes in the middle of a line: the partial line is the last one, then the end.
    val half = spawn(() ->
        val s = ok(l.accept())
        ok(s.writeText("whole\npart"))
        s.close()
        0)
    val h = ok(UnixStream.connect(sock))
    println(ok(h.readLine()))
    println(ok(h.readLine()))
    println(ok(h.readLine()))
    h.close()
    half.join()

    // A peer that closes at once: no line, no bytes, nothing to read all of.
    val gone = spawn(() ->
        ok(l.accept()).close()
        0)
    val g = ok(UnixStream.connect(sock))
    println(ok(g.readLine()))
    println(ok(g.readAll()).length)
    g.close()
    gone.join()

    // A read that waits longer than the timeout fails with `TimedOut`, and the connection stays.
    val late = spawn(() ->
        val s = ok(l.accept())
        ok(s.readLine())
        ok(s.writeText("late\n"))
        s.close()
        0)
    val t = ok(UnixStream.connect(sock))
    ok(t.setTimeout(time.millis(50)))
    println(t.readLine() match
        Err(TimedOut) -> "timed out"
        Err(e) -> e.message()
        Ok(_) -> "read")
    ok(t.setTimeout(time.Duration.Zero))
    ok(t.writeText("go\n"))
    println(ok(t.readLine()))
    t.close()
    late.join()

    // A closed connection answers an error to every read and write.
    println(t.read(1).isErr())
    println(t.readLine() match
        Err(Other(m)) -> m
        _ -> "?")
    println(t.readAll().isErr())
    println(t.writeText("x").isErr())
    println(t.write(bytesOf("x")).isErr())
    println(t.shutdownOutput().isErr())
    println(t.setTimeout(time.millis(1)).isErr())

    // A closed listener answers an error, and leaves its file behind.
    l.close()
    l.close()
    println(l.accept() match
        Err(Other(m)) -> m
        _ -> "?")
    println(fs.exists(sock))
    ok(fs.remove(sock))
    ok(fs.removeDir(dir))
