// expect: exit 0
// `List` is covariant: a list of a subtype is a list of its supertype, `::` puts an element in front
// of a list of a wider type, and a list of a program's own `data` type compares by contents.

trait Animal
  name() -> string

class Dog(n: string): Animal
  override name() -> string = s"dog $n"

class Cat(n: string): Animal
  override name() -> string = s"cat $n"

data Point(x: int, y: int)

names(xs: List[Animal]) -> string
  var out = ""
  for x in xs do out = out + x.name() + "; "
  out

main()
  val dogs: List[Dog] = [Dog("rex"), Dog("fido")]
  println(names(dogs))
  val animals: List[Animal] = Cat("tom") :: dogs
  println(names(animals))
  val mixed: List[Animal] = [Dog("a"), Cat("b")]
  println(names(mixed))
  println(names(dogs.map(d -> Cat(d.name()))))
  val ps: List[Point] = [Point(1, 2), Point(3, 4)]
  println(ps == Point(1, 2) :: [Point(3, 4)])
  println(ps == Point(1, 2) :: [Point(3, 5)])
  ps match
    Point(a, _) :: [Point(_, d)] -> println(a + d)
    _ -> println("no")
  // A list as an Iterable.
  val all: Iterable[Animal] = animals
  var n = 0
  for _ in all do n += 1
  println(n)
