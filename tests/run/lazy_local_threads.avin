// expect: exit 0
// A local `lazy val` a thread's body captures keeps the cross-thread guarantees a field's has: eight
// threads read it first together, the initializer waiting until every one has arrived at its read,
// so seven find it running and wait for it, safe for the collector. It runs exactly once and every
// thread sees the whole value, which the thread that declared it then reads without computing it
// again. Its initializer may capture what a thread's body may: `val`s of sendable types and
// sendable `lazy val`s. Futures and a value a generic function declares behave the same way.
import avin.threads.{Atomic, Future, scope, spawn}

build(prefix: string, runs: Atomic[int], arrived: Atomic[int], count: int) -> Vector[string]
  runs.add(1)
  while arrived.load() < count do ()
  var out: Vector[string] = []
  for i in 0 ..< 200
    out = out :+ s"$prefix$i"
  out

firstOf[T: Sendable](x: T, runs: Atomic[int]) -> Vector[T]
  lazy val both: Vector[T] =
    runs.add(1)
    [x, x]
  val futures = (0 ..< 4).map(_ -> Future(both.length)).toVector
  var total = 0
  for f in futures
    total += f.await()
  println(total)
  both

main()
  val runs = Atomic(0)
  val arrived = Atomic(0)
  val prefix = "t"
  lazy val table: Vector[string] = build(prefix, runs, arrived, 8)
  lazy val size = table.length
  val lengths = Atomic(0)
  scope(s ->
    for _ in 0 ..< 8
      s.spawn(() ->
        var junk: Vector[int] = []
        for i in 0 ..< 50
          junk = junk :+ i
        arrived.add(1)
        lengths.add(table.length + size + junk.length)))
  println(runs.load())
  println(lengths.load())
  println(table(199))
  println(runs.load())

  // A value no thread reads is never computed, even when the threads capture it.
  val idle = Atomic(0)
  lazy val skipped = idle.add(1)
  spawn(() -> if false then println(skipped)).join()
  println(idle.load())

  val genericRuns = Atomic(0)
  println(firstOf("ab", genericRuns))
  println(firstOf(7, genericRuns).length)
  println(genericRuns.load())
