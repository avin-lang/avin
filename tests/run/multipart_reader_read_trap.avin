// expect: trap
// A multipart reader's read of one byte answers one; a read of none traps.
import avin.net.http.{MultipartReader, ServerRequest}

main()
  val body = "--b\r\nContent-Disposition: form-data; name=a\r\n\r\nxyz\r\n--b--"
  val r = ServerRequest(
    "POST",
    "/",
    [("Content-Type", "multipart/form-data; boundary=b")],
    Array.tabulate(body.byteLength, i -> body.byteAt(i))
  )
  val m = r.multipartReader() match
    Ok(m) -> m
    Err(e) -> fail(e.message)
  println(m.next().map(h -> h.map(p -> p.name)))
  println(m.read(1).map(b -> b.length))
  println(m.read(0).isOk)
