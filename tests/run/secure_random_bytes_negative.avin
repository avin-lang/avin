// expect: trap
// A negative count of secure bytes is a bug in the caller, so it traps; a count of zero is an empty
// array and an empty token.
import avin.random.SecureRandom

main()
  println(SecureRandom.nextBytes(0).length)
  println(SecureRandom.urlToken(0).byteLength)
  println(SecureRandom.hexToken(-1))
