// expect: trap
// A listener the thread it was handed to has closed is still the thread's while the thread runs: the
// code that handed it over traps at `accept` rather than being answered as for a closed listener.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.threads.{Channel, spawn}
import avin.time

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message)

main()
    val l = ok(TcpListener.bind("127.0.0.1", 0))
    val closed = Channel[int]()
    val go = Channel[int]()
    val t = spawn(() ->
        l.close()
        closed.send(1)
        go.receive()
        l.port())
    closed.receive()
    println("closed by the thread")
    l.accept()
    println("not reached")
    go.send(1)
    println(t.join())
