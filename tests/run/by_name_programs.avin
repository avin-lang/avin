// By-name parameters in whole programs: forwarding through several functions, reads that see
// a change made in between, evaluation order against strict parameters, a by-name function as a
// value, and arguments that contain loops, helpers and lambdas.

ignore(value: -> int) = 42

read[T](value: -> T) -> T = value

from_strict[T](value: T) -> T = read(value)

when(enabled: bool, action: -> unit)
    if enabled then action

twice(value: -> int) = value + value

forward(value: -> int) = twice(value)

wrapped(value: -> int) = forward(value + 1)

observe(value: -> int, change: -> unit) -> int
    val before = value
    change
    before * 10 + value

nested(value: -> int) -> int
    helper() = value
    helper() + (() -> value)()

mark(value: int) -> int
    print(value)
    value

order(first: -> int, strict: int, last: -> int)
    print(strict)
    print(first)
    print(last)

repeat(n: int, value: -> int) -> int = if n == 0 then 0 else value + repeat(n - 1, value)

run_twice(effect: -> unit)
    effect
    effect

forward_ignored(value: -> int) = ignore(value + 1)

inc(value: int) = value + 1

factory() -> int -> int
    print("factory")
    inc

use(value: -> int -> int) = value(40) + value(1)

apply(f: (-> int) -> int, value: -> int) = f(value)

read_discarding(value: -> int, effect: unit) = value

ignore_discarding(value: -> int, effect: unit) = 42

clear(value: -> unit) = value

main()
    var count = 0
    print(ignore(count +:= 1))
    print(count)
    print(twice(count +:= 1))
    print(count)
    print(forward(count +:= 1))
    print(wrapped(count +:= 1))
    print(nested(count +:= 1))
    print(count)
    var value = 1
    print(observe(value, (value = 2)))
    print(value)
    order(mark(1), mark(2), mark(3))
    print(read(true), read('é'), read(0.5), read("text"))
    print(read[i129](170141183460469231731687303715884105727))
    print(from_strict[i129](170141183460469231731687303715884105727))
    print(from_strict("borrowed"), from_strict(false), from_strict(0.5))
    when(false, print(100))
    when(true, print(42))

    var calls = 0
    print(repeat(3, calls +:= 1))
    print(calls)

    var base = 20
    bump() -> int = base +:= 1
    print(twice(bump()))

    // Arguments that are never read are never run, so one that would trap is harmless.
    print(forward_ignored(1 / 0))
    run_twice(print(42))
    print(read(while true do break 42 else 0))

    // A delayed call to a function that returns a function calls it at each read.
    print(use(factory()))
    var applied = 20
    print(apply(twice, applied +:= 1))
    print(read(twice)(base))

    // The callee is chosen once, before the delayed argument is read.
    var operation = read_discarding
    print(operation(1, (operation = ignore_discarding)))

    // Many reads in a loop do not grow the stack.
    var total = 0
    while total < 1000000
        clear(total += 1)
    print(total)
