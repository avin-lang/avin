// expect: trap
// A trap in a local `lazy val`'s initializer stops the program as any trap does, at the first read;
// one whose initializer would trap but is never read never runs it.
divide(a: int, b: int) -> int = a / b

main()
  lazy val unread = divide(1, 0)
  lazy val broken: int = divide(10, 0)
  println("declared")
  println(broken)
  println("not reached")
