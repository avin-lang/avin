// expect: trap
// An SMTP client's timeout of zero is no limit; one below zero, by a microsecond, traps where the
// client is made, before anything is connected.
import avin.net.smtp.SmtpClient
import avin.time.{Duration, micros}

main()
  println(SmtpClient("localhost", connectTimeout = Duration.Zero, commandTimeout = Duration.Zero).portUsed)
  _ = SmtpClient("localhost", dataTimeout = micros(-1))
