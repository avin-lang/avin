// expect: exit 0
// Values that never leave the function that makes them are kept as their fields, and values that
// do leave it stay objects. Either way every result is the one the object gives: values made in
// loops, on two paths, beside an older one from the same place, iterators over sequences only an
// iterator holds, and values stored, returned, captured, held as `Any`, passed to a function value,
// compared by identity and handed to other threads.
import avin.threads.spawn

data Pt(x: int, y: int)

data Shape
  Circle(radius: int)
  Rect(w: int, h: int)

class Cell(var value: int)

class Holder(var p: Pt)

var sink: Any = 0

divmod(a: int, b: int) -> (int, int) = a / b, a % b

// A tuple made and taken apart in a loop, once the function that makes it is inlined.
digits(n: int) -> int
  var sum = 0
  var rest = n
  while rest > 0
    val (q, r) = divmod(rest, 10)
    sum += r
    rest = q
  sum

// A value made on one of two paths and matched where it is made.
area(round: bool, k: int) -> int
  val s = if round then Circle(k) else Rect(k, k + 1)
  s match
    Circle(r) -> 3 * r * r
    Rect(w, h) -> w * h

// A value made in a loop, used before the next one is made.
walk(n: int) -> int
  var total = 0
  for i in 0 ..< n
    val p = Pt(i, i * 2)
    total += p.x + p.y
  total

// An older value kept beside a newer one made at the same place.
previous(n: int) -> int
  var last = Pt(0, 0)
  var total = 0
  for i in 1 .. n
    val p = Pt(i, i)
    total += last.x
    last = p
  total + last.y

// A sequence only the loop's iterator holds, while the loop allocates: the iterator's reference to
// it is all that keeps it alive.
strings(xs: Iterable[int]) -> int
  var length = 0
  for x in xs
    length += s"<$x>".byteLength
  length

vectorSum(n: int) -> long
  var total: long = 0
  for x in Array.tabulate(n, i -> i).toVector
    total += long(s"$x".byteLength + x)
  total

listSum(n: int) -> long
  var total: long = 0
  for x in Array.tabulate(n, i -> i).toList
    total += long(s"$x".byteLength + x)
  total

seqSum(n: int) -> long
  var total: long = 0
  for x in Array.tabulate(n, i -> i).toArraySeq
    total += long(s"$x".byteLength + x)
  total

rangeSum(n: int) -> long
  val r = 0 ..< n
  var total: long = 0
  for x in r
    total += long(x)
  total

// Values that leave the function stay objects.
store(h: Holder, k: int) = h.p = Pt(k, k + 1)

make(k: int) -> Pt = Pt(k, -k)

capture(k: int) -> (int) -> int
  val p = Pt(k, 2 * k)
  x -> x + p.x + p.y

hold(k: int)
  val a: Any = Pt(k, k)
  sink = a

through(f: (Pt) -> int, k: int) -> int = f(Pt(k, k + 2))

same(k: int) -> string
  val c = Cell(k)
  val d = Cell(k)
  val e = c
  s"${c === d} ${c === e} ${c.value == d.value}"

// Each thread makes values of its own and keeps them as fields; the value handed to a thread is an
// object.
threaded() -> int
  val shared = Pt(40, 2)
  var threads: List[avin.threads.Thread[int]] = []
  for id in 0 ..< 4
    threads = spawn(() -> walk(100 + id) + shared.x + shared.y) :: threads
  var total = 0
  for t in threads
    total += t.join()
  total

main()
  println(s"${digits(907)} ${digits(0)} ${area(true, 3)} ${area(false, 3)}")
  println(s"${walk(10)} ${previous(5)}")
  val n = 1000
  println(s"${vectorSum(n)} ${listSum(n)} ${seqSum(n)} ${rangeSum(n)}")
  println(s"${strings(Array.tabulate(40, i -> i).toVector)} ${strings(Array.tabulate(40, i -> i).toList)}")
  val h = Holder(Pt(0, 0))
  store(h, 5)
  println(s"${h.p} ${make(3)} ${capture(4)(1)}")
  hold(7)
  val held = sink match
    p: Pt -> s"$p"
    _ -> "?"
  println(s"$held ${through(p -> p.x * p.y, 3)}")
  println(same(9))
  println(threaded())
