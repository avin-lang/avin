// expect: exit 0
// Lambdas take and return unions; a closure that captures a union `var` and changes it to another
// member is seen outside; placeholder lambdas and method references run over unions, and a lambda
// given where a union of a function and another type is expected is the function member.

show(x: int | string) -> string = x match
    n: int -> s"int $n"
    s: string -> s"string $s"

apply(f: (int | string) -> int | string, x: int | string) -> int | string = f(x)

main()
    val flip: (int | string) -> int | string = x -> x match
        n: int -> s"$n"
        s: string -> s.charCount
    println(show(flip(3)))
    println(show(flip("four")))
    println(show(apply(flip, "seven")))
    println(show(apply(x -> x, 8)))
    var state: int | string = 0
    val step = () ->
        state = state match
            n: int if n < 2 -> n + 1
            n: int -> s"stopped at $n"
            s: string -> s
    for _ in 0..<4
        step()
        println(show(state))
    val xs: Vector[int | string] = [1, "two", 3]
    println(xs.map(_.toString()))
    println(xs.map(show))
    println(xs.filter(x -> x is _: int).size)
    val made: ((int) -> int) | string = n -> n * 3
    println(made match
        f: ((int) -> int) -> f(5)
        _: string -> 0)
    val counters: Vector[() -> int | string] = [() -> 1, () -> "one"]
    println(counters.map(c -> show(c())))
