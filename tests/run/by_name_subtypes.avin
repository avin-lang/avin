// expect: exit 0
// A delayed argument may yield a subtype of what its by-name parameter yields, as a strict argument
// may be a subtype of its parameter: through a companion's `apply` called by its type's name (which
// overloads the constructor), through a method, and with what it yields deciding the call's type
// arguments, also those held to a lower bound and those in an invariant position.
trait Animal
    name() -> string

class Cat(): Animal
    override name() -> string = "cat"

class Dog(): Animal
    override name() -> string = "dog"

class Box[T](val v: T, val n: int)

object Box
    apply[T](body: -> T) -> Box[T] = Box(body, 1)
    make[T](body: -> T) -> Box[T] = Box(body, 2)

class Cell[T](val v: T)

impl[T, E] Cell[Result[T, E]]
    lazily[U >: T, F](other: -> Cell[Result[U, F]]) -> Cell[Result[U, F]] = v match
        Ok(t) -> Cell[Result[U, F]](Ok(t))
        Err(_) -> other
    strictly[U >: T, F](other: Cell[Result[U, F]]) -> Cell[Result[U, F]] = other

yielding(body: -> Animal) -> string = body.name()

pick[T](a: -> T, b: -> T, first: bool) -> T = if first then a else b

main() -> int
    val named: Box[Option[Animal]] = Box(Some(Dog()))
    val made: Box[Option[Animal]] = Box.make(Some(Cat()))
    val applied: Box[Option[Animal]] = Box.apply(Some(Dog()))
    println(s"${named.v.map(a -> a.name())} ${named.n} ${made.v.map(a -> a.name())} ${made.n} ${applied.n}")
    val plain: Box[Animal] = Box(Cat())
    println(s"${plain.v.name()} ${yielding(Dog())}")
    val cats: Cell[Result[Cat, string]] = Cell(Err("no cat"))
    val animals: Cell[Result[Animal, string]] = Cell(Ok(Dog()))
    println(cats.lazily(animals).v.map(a -> a.name()))
    println(cats.strictly(animals).v.map(a -> a.name()))
    val counts: Cell[Result[int, string]] = Cell(Err("none"))
    val other: Cell[Result[int, long]] = Cell(Err(long(7)))
    println(counts.lazily(other).v)
    val chosen: Animal = pick(Cat(), Dog(), false)
    println(chosen.name())
    0
