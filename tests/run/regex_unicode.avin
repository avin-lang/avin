// expect: exit 0
// `avin.regex` over the Unicode Character Database: scripts, blocks and binary properties, the `U`
// flag's Unicode classes and word boundaries, and grapheme clusters with `\X` and `\b{g}`.
import avin.regex
import avin.regex.Regex

all(pattern: string, text: string) -> string = Regex.compile(pattern) match
    Ok(r) -> r.findAllIn(text).toList().toString()
    Err(e) -> e.description

main()
    println(all(raw"\p{IsGreek}+", "Ἀθῆναι and Σπάρτη"))
    println(all(raw"\p{sc=Cyrl}+", "Москва, Kyiv, Київ"))
    println(all(raw"\p{IsHan}+|\p{IsHiragana}+|\p{IsKatakana}+", "東京はトウキョウ"))
    println(all(raw"\p{InCJK_Unified_Ideographs}", "漢a字"))
    println(all(raw"\p{block=Arrows}+", "a→←b⇒"))
    println(all(raw"\p{IsAlphabetic}+", "Ⅻ legions, ٣ ships"))
    println(all(raw"\p{IsUppercase}\p{IsLowercase}+", "Ünïcode Ⓐbc"))
    println(all(raw"\p{IsEmoji_Presentation}", "ok 👍 #1 ✨"))
    println(all(raw"(?U)\w+", "naïve café_1, ٣٤"))
    println(all(raw"\w+", "naïve café_1"))
    println(all(raw"(?U)\b\w", "élan vital"))
    println(all(raw"\X", "e\u{301}🇯🇵👩\u{200d}💻a"))
    println(Regex(raw"\b{g}").replaceAllIn("ne\u{301}e", "|"))
    println(all(raw"\p{IsKlingon}", "a"))
    println(all("(?c)a", "a"))
