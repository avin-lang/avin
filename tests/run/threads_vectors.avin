// expect: exit 0
// Vectors cross between threads whole. Every array of a vector's tree is written before the object
// that holds it is made, so a thread given a vector another made sees all of its elements: each of
// four threads grows its own vector from one they share, at both ends and through updates, while
// the others allocate, and the main thread reads every one back.
import avin.threads.spawn

main() -> int
  var shared: Vector[int] = []
  for i in 0 ..< 3000 do shared = shared :+ i
  val base = shared
  var threads: Vector[avin.threads.Thread[Vector[int]]] = []
  for k in 0 ..< 4
    threads = threads :+ spawn(() ->
      var v = base
      for i in 0 ..< 2000 do v = (-k +: v) :+ (k * 10000 + i)
      v.updated(2000, k))
  for k in 0 ..< 4
    val v = threads(k).join()
    if v.length != 7000 then return 1
    if v(0) != -k || v(1999) != -k then return 2
    if v(2000) != k || v(2001) != 1 || v(4999) != 2999 then return 3
    if v(5000) != k * 10000 || v(6999) != k * 10000 + 1999 then return 4
    println(s"thread $k: ${v.length} ${v.drop(2001).take(2999) == shared.tail}")
  if shared.length != 3000 || shared(2999) != 2999 then return 5
  0
