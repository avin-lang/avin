// expect: exit 0
// Mappings the program drops without closing are unmapped when the collector frees them. Each round
// maps a 64 GiB sparse file read-only and writable and drops both; three thousand rounds ask for 384
// TiB of address space, three times what a process has, so had a dropped mapping stayed mapped the
// run would have stopped with an `Err` long before the end. The program allocates almost nothing
// else, so it is the mappings themselves that bring the collections on. Each round also reads a byte
// of each mapping.
import avin.fs
import avin.io.IoError

impl[T] Result[T, IoError]
  get() -> T = self match
    Ok(v) -> v
    Err(e) -> fail(s"unexpected $e")

round(path: string, i: int, size: long) -> bool
  val m = fs.mapFile(path) match
    Ok(m) -> m
    Err(e) ->
      println(s"map $i: $e")
      return false
  val w = fs.mapFileMutable(path) match
    Ok(w) -> w
    Err(e) ->
      println(s"map writable $i: $e")
      return false
  m(size - 1) == w(size - 1)

main()
  val dir = fs.createTempDir("avin-mapped-dropped").get()
  val path = dir + "/sparse"
  val size: long = 68719476736
  val f = fs.createUpdate(path).get()
  _ = f.setLength(size).get()
  _ = f.close()
  var i = 0
  while i < 3000 && round(path, i, size)
    i += 1
  println(s"$i rounds")
  _ = fs.removeDirAll(dir).get()
