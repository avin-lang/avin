// expect: exit 0
// Functions declared with `def` and no parameter list that allocate at every read, read in loops
// under a collection at every allocation: each read builds a fresh value, a lambda kept in a
// collection reads one again at each call, and a local one in a generic function captures a value of
// the type argument.

var made = 0

def fresh -> Vector[string]
    made += 1
    [s"v$made", s"w$made"]

def joined -> string = fresh.mkString("+")

collect[T: Display](x: T, n: int) -> Vector[string]
    var parts: Vector[string] = []
    def piece -> string = s"$x/${parts.length}"
    for _ in 0..<n
        parts = parts :+ piece
    parts

main() =
    var total = 0
    for _ in 0..<500
        total += fresh.length + joined.byteLength()
    println(total)
    println(made)
    var readers: Vector[() -> string] = []
    for i in 0..<50
        readers = readers :+ (() -> joined)
    var last = ""
    for r in readers
        last = r()
    println(last)
    println(collect(7, 300).length)
    println(collect("s", 3))
    println(collect(Some(1.5), 2))
