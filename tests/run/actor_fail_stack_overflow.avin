// expect: trap
// An actor that runs out of stack stops the program, whatever its supervision, with the trap every
// thread reports for it: the stack ran out wherever the actor's code happened to be, the runtime
// or the C library among the places, so the state other threads share is in doubt.
import avin.actors.{Stop, spawn}
import avin.threads.Channel

descend(n: int) -> int = descend(n + 1) + n

actor Deep(done: Channel[int]) receives int
    receive
        n -> done.send(if n == 0 then 0 else descend(n))

main()
    val done = Channel[int]()
    val d = spawn(Deep(done), onFailure = Stop)
    d.tell(0)
    println(done.receive())
    d.tell(1)
    println(done.receive())
    println("not reached")
