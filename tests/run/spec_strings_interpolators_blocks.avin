// expect: exit 0
// Interpolators and text blocks together: a program's own interpolator returning a type of its own,
// receiving its parts with escapes unprocessed and its holes in order, as a text block too; `$$` and
// `$"` in each quote form; `raw` keeping a backslash; a block's indentation, trailing blanks, joined
// lines and a hole spanning lines; and `s` and `f` called directly with counted arguments.
trait Tagging
    tag(args: Display*) -> Tagged

impl Tagging for StringContext
    tag(args: Display*) -> Tagged = Tagged(parts, args.map(a -> a.toString()))

data Tagged(parts: Vector[string], values: Vector[string])

counted(log: Buffer[int], n: int) -> int
    log.append(n)
    n

main()
    val who = "you"
    val t = tag"hi\n$who and ${1 + 2}$$"
    println(debug(t.parts))
    println(t.values)
    val empty = tag""
    println(s"${empty.parts.length()} ${empty.values.length()}")
    val onlyHole = tag"$who"
    println(debug(onlyHole.parts))
    val log = Buffer[int]()
    val order = tag"${counted(log, 1)}${counted(log, 2)}-${counted(log, 3)}"
    println(s"${order.values} $log")

    println(s"cost: $$5, said $"hi$"")
    println(raw"C:\dir\$who $$ $"q$" \"")
    println(f"${3}%d$$ ${"q"}%s$"")
    val block = s"""
        name: $who
          total: ${List(20,
            1).sum()}
        price: $$9 \
        and more
        """
    print(block)
    val rawBlock = raw"""
        a\tb \
        c
        """
    print(rawBlock)
    val blanks = """
        trailing
        kept\u{20}
        """
    println(debug(blanks))
    val tagBlock = tag"""
        x $who
        y\n
        """
    println(debug(tagBlock.parts))
    val noBreak = """
        ends here"""
    println(debug(noBreak))
    val fBlock = f"""
        ${3.14159}%.2f|${who}%-5s|
        """
    print(fBlock)

    println(StringContext(["a", "b", ""]).s(1, true))
    println(StringContext(["", "%5.1f|", "%-4s|"]).f(2.25, "x"))
    val width: long = 6
    println(StringContext(["[", "%*d]"]).s(7))
    println(StringContext(["", "%.", "f"]).f(1.23456, 2))
    println(StringContext(["", "%", "d|"]).f(42, width))
    println(StringContext(["", "%d"]).f("text"))
