// expect: trap
// A wait on time alone is never a deadlock: `main` receiving from an `after`, from a ticker, with a
// timeout from a channel nobody sends to, in a select whose only arms are `after` channels, and in a
// `withTimeout` whose body waits for ever, each with no other thread running, all go on once their
// time comes. A ticker that is stopped is a channel nobody sends to, and waiting on it with no limit
// is a deadlock, reported after the output.
import avin.threads.{Channel, Ticker, after, withTimeout}
import avin.time.millis

main()
  println(s"after: ${after(millis(30)).receive().isDefined}")
  val t = Ticker(millis(10))
  println(s"ticks: ${t.ticks.receive().isDefined}, ${t.ticks.receive().isDefined}")
  val never = Channel[int]()
  println(s"timed receive: ${never.receive(millis(20))}")
  val arm = select
    after(millis(20)).receive() -> "first"
    after(millis(4000)).receive() -> "second"
  println(s"select: $arm")
  println(s"withTimeout: ${withTimeout(millis(20), s -> never.receive())}")
  t.stop()
  println("stopped")
  println(t.ticks.receive())
