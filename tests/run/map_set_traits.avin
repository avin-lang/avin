// expect: exit 0
// `Map` and `Set` are traits: the hash-based and the tree collections conform to them, the tree ones
// through `SortedMap` and `SortedSet`. An update through a trait keeps the collection's kind, a value
// of a supertype widens the map, and maps and sets of different kinds with equal contents are equal
// and hash alike.

open class Animal(val name: string)
class Cat(n: string): Animal(n)
class Dog(n: string): Animal(n)

total(m: Map[string, int]) -> int
    var sum = 0
    for (k, v) in m do sum += v
    sum

kind(m: Map[string, int]) -> string = m match
    h: HashMap[string, int] -> "hash"
    t: TreeMap[string, int] -> "tree"
    _ -> "other"

setKind(s: Set[int]) -> string = s match
    h: HashSet[int] -> "hash"
    t: TreeSet[int] -> "tree"
    _ -> "other"

bump(m: Map[string, int]) -> Map[string, int] = (m.updated("z", 26) ++ [("y", 25)]).removed("a")

names(m: Map[string, Animal]) -> string = m.values().map(a -> a.name).sorted().mkString(",")

main()
    val h: Map[string, int] = {"a": 1, "b": 2}
    val t = TreeMap(("b", 2), ("a", 1))
    println(total(h), total(t), kind(h), kind(t))
    println(kind(bump(h)), kind(bump(t)), bump(t).keys())
    println(kind(h.filter((k, v) -> v > 1)), kind(t.filterKeys(k -> k != "a")), kind(t.mapValues(v -> v * 2)))
    println(kind(h -- ["a"]), kind(t.updatedWith("a", v -> None)), kind(t.transform((k, v) -> v + 1)))

    // A key-changing map builds a hash map through the trait, a tree map where the type is known.
    val asMap: Map[string, int] = t
    println(kind(asMap.map((k, v) -> (k + "!", v))), kind(t.map((k, v) -> (k + "!", v))))

    // Widening through the lower bound.
    val cats: Map[string, Cat] = {"tom": Cat("Tom")}
    val pets = cats.updated("rex", Dog("Rex"))
    val animals: Map[string, Animal] = pets
    println(names(animals), names(cats ++ [("fido", Dog("Fido"))]))
    val treeCats = TreeMap(("tom", Cat("Tom")))
    println(treeCats.updated("rex", Dog("Rex")).headOption().map(e -> e.1.name))
    println(h.getOrElse("q", 0), h.getOrElse("a", 0), cats.getOrElse("x", Dog("Stray")).name)

    // The sorted traits keep their ordered members through an update.
    val sorted: SortedMap[string, int] = t
    println(sorted.updated("0", 0).headOption(), sorted.removed("a").headOption(), (sorted ++ [("c", 3)]).lastOption())
    println(sorted.rangeFrom("b").keys(), sorted.keySet().headOption(), sorted.maxBefore("az"), sorted.minAfter("az"))
    val literal: SortedMap[string, int] = {"y": 2, "x": 1}
    println(literal.keys(), kind(literal.filter((k, v) -> true)))
    val sortedSet: SortedSet[int] = {3, 1, 2}
    println(sortedSet.incl(0).headOption(), sortedSet.excl(1).headOption(), sortedSet.range(1, 3).toVector(), (sortedSet ++ [9]).lastOption())

    // Sets: the kind is kept, and set algebra works across kinds.
    val hs: Set[int] = {1, 2, 3}
    val ts: Set[int] = TreeSet(2, 3, 4)
    println(setKind(hs.incl(9)), setKind(ts.incl(9)), setKind(ts.union(hs)), setKind(hs.intersect(ts)))
    println(hs.intersect(ts) == ts.intersect(hs), ts.diff(hs).toVector(), hs.subsetOf(ts), hs(2), ts(1))

    // Equality and hashes across kinds, through the traits and through `Any`.
    val ht: Map[string, int] = TreeMap(("a", 1), ("b", 2))
    println(h == ht, h.hash() == ht.hash(), h == bump(h), h == Map.empty[string, int]())
    val x: Any = h
    val y: Any = ht
    println(x == y, x.hash() == y.hash(), x == HashMap(("a", 1)))
    val sa: Any = Set(1, 2)
    val sb: Any = TreeSet(2, 1)
    println(sa == sb, sa.hash() == sb.hash(), sa == TreeSet(1), sa == y)

    // Printing a map or set typed as its trait shows its own type's form; mkString joins the pairs.
    val shown: Map[string, int] = TreeMap(("b", 2), ("a", 1))
    println(shown)
    println(s"$shown ${sortedSet}")
    println(shown.mkString("; "))
