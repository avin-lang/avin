// expect: exit 0
// A `TreeMap` keeps its entries in the order of their keys: lookups, updates and removals as a `Map`
// has them, iteration ascending, and the ordered operations — first and last, the nearest entry to a
// key, and the entries from, to, until or between keys. It compares, hashes and displays as a map does.
// A tree map is covariant in its values, as a map is.
open class Animal(val name: string)
class Dog(name: string): Animal(name)

main()
    var m = TreeMap.empty[string, int]()
    for (w, i) in [("pear", 3), ("apple", 1), ("fig", 2), ("kiwi", 5), ("date", 4)] do m = m.updated(w, i)
    println(m)
    println(debug(m))
    println(s"${m.size} ${m.isEmpty} ${m.nonEmpty} ${TreeMap.empty[int, int]().isEmpty}")
    println(s"${m.get("fig")} ${m.get("plum")} ${m("kiwi")} ${m.getOrElse("plum", 0)} ${m.contains("date")}")

    val replaced = m.updated("fig", 20)
    println(s"$replaced $m")
    val smaller = m.removed("apple").removed("plum")
    println(s"$smaller ${smaller.size}")
    println(m.removed("plum") == m)

    println(m.keys)
    println(m.values)
    println(m.keySet)
    println(m.keysIterator().toVector)
    println(m.valuesIterator().toList)
    println(m.reverseIterator().toVector)
    println(s"${m.headOption} ${m.lastOption} ${TreeMap.empty[int, int]().headOption}")
    println(s"${m.maxBefore("e")} ${m.maxBefore("date")} ${m.maxBefore("a")}")
    println(s"${m.minAfter("e")} ${m.minAfter("pear")} ${m.minAfter("q")}")
    println(m.rangeFrom("e"))
    println(m.rangeUntil("fig"))
    println(m.range("b", "kiwi"))
    println(m.range("kiwi", "b"))
    println(m.rangeFrom("zzz"))
    println(s"${m.rangeTo("fig")} ${m.rangeTo("e")} ${m.rangeTo("a")}")
    println(s"${m.head} ${m.last} ${m.firstKey()} ${m.lastKey()}")
    println(s"${m.iteratorFrom("e").toVector} ${m.keysIteratorFrom("fig").toVector} ${m.valuesIteratorFrom("kiwi").toVector}")

    println(m ++ [("banana", 9), ("apple", 0)])
    println(m -- ["apple", "plum", "pear"])
    println(m.updatedWith("fig", v -> v.map(n -> n * 10)))
    println(m.updatedWith("fig", v -> None))
    println(m.updatedWith("cherry", v -> Some(7)))
    println(m.filterKeys(k -> k.byteLength() == 4))
    println(m.filter((k, v) -> v % 2 == 1))
    println(m.transform((k, v) -> s"$k$v"))
    println(m.mapValues(v -> v * v))
    println(m.map((k, v) -> (v, k)))
    println(m.map(e -> (e.1 % 2, e.0)))
    println(m.collect(match
        (k, v) if v > 2 -> (k.byteLength(), v)))
    println(m.flatMap(e -> [(e.1, e.0), (-e.1, e.0)]))
    m.foreach((k, v) -> println(s"$k=$v"))
    println(m.mkString())
    println(m.mkString("<", "; ", ">"))
    println(["fig", "kiwi"].map(m))

    val doubled = for (k, v) in m if v > 2 yield (k, v * 2)
    println(doubled)

    val built = TreeMap.newBuilder[int, string]()
    built.addOne((3, "c"))
    built.addAll([(1, "a"), (2, "b"), (1, "z")])
    println(built.result())
    println(TreeMap((5, "e"), (4, "d"), (5, "f")))
    val literal: TreeMap[int, string] = {2: "b", 1: "a"}
    println(literal)

    val same = TreeMap((4, "d"), (5, "f"))
    val other = TreeMap((5, "f"), (4, "d"))
    println(s"${same == other} ${same.hash() == other.hash()} ${same != TreeMap((4, "d"))}")
    println(s"${same.hash() == Map((4, "d"), (5, "f")).hash()}")
    println(s"${same == TreeMap((4, "d"), (5, "g"))}")

    val padded = StringWriter()
    TreeMap((1, 2)).display(padded, FormatSpec(width = 10))
    println(s"[${padded.text()}]")

    val dogs = TreeMap((2, Dog("rex")), (1, Dog("ace")))
    val animals: TreeMap[int, Animal] = dogs
    val named = animals.updated(3, Animal("cat"))
    println(named.values.map(a -> a.name))
