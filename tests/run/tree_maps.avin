// expect: exit 0
// A `TreeMap` keeps its entries in the order of their keys: lookups, updates and removals as a `Map`
// has them, iteration ascending, and the ordered operations — first and last, the nearest entry to a
// key, and the entries from, until or between keys. It compares, hashes and displays as a map does.
// A tree map is covariant in its values, as a map is.
open class Animal(val name: string)
class Dog(name: string): Animal(name)

main()
    var m = TreeMap.empty[string, int]()
    for (w, i) in [("pear", 3), ("apple", 1), ("fig", 2), ("kiwi", 5), ("date", 4)] do m = m.updated(w, i)
    print(m)
    print(debug(m))
    print(s"${m.size()} ${m.isEmpty()} ${m.nonEmpty()} ${TreeMap.empty[int, int]().isEmpty()}")
    print(s"${m.get("fig")} ${m.get("plum")} ${m("kiwi")} ${m.getOrElse("plum", 0)} ${m.contains("date")}")

    val replaced = m.updated("fig", 20)
    print(s"$replaced $m")
    val smaller = m.removed("apple").removed("plum")
    print(s"$smaller ${smaller.size()}")
    print(m.removed("plum") == m)

    print(m.keys())
    print(m.values())
    print(m.keySet())
    print(m.keysIterator().toVector())
    print(m.valuesIterator().toList())
    print(m.reverseIterator().toVector())
    print(s"${m.first()} ${m.last()} ${TreeMap.empty[int, int]().first()}")
    print(s"${m.floor("e")} ${m.floor("date")} ${m.floor("a")}")
    print(s"${m.ceiling("e")} ${m.ceiling("pear")} ${m.ceiling("q")}")
    print(m.from("e"))
    print(m.until("fig"))
    print(m.range("b", "kiwi"))
    print(m.range("kiwi", "b"))
    print(m.from("zzz"))

    print(m ++ [("banana", 9), ("apple", 0)])
    print(m -- ["apple", "plum", "pear"])
    print(m.updatedWith("fig", v -> v.map(n -> n * 10)))
    print(m.updatedWith("fig", v -> None))
    print(m.updatedWith("cherry", v -> Some(7)))
    print(m.filterKeys(k -> k.byteLength() == 4))
    print(m.filter((k, v) -> v % 2 == 1))
    print(m.transform((k, v) -> s"$k$v"))
    print(m.mapValues(v -> v * v))
    print(m.map((k, v) -> (v, k)))
    print(m.map(e -> (e.1 % 2, e.0)))
    print(m.collect(match
        (k, v) if v > 2 -> (k.byteLength(), v)))
    print(m.flatMap(e -> [(e.1, e.0), (-e.1, e.0)]))
    m.foreach((k, v) -> print(s"$k=$v"))
    print(m.mkString())
    print(m.mkString("<", "; ", ">"))
    print(["fig", "kiwi"].map(m))

    val doubled = for (k, v) in m if v > 2 yield (k, v * 2)
    print(doubled)

    val built = TreeMap.builder[int, string]()
    built.add((3, "c"))
    built.addAll([(1, "a"), (2, "b"), (1, "z")])
    print(built.result())
    print(TreeMap((5, "e"), (4, "d"), (5, "f")))
    val literal: TreeMap[int, string] = {2: "b", 1: "a"}
    print(literal)

    val same = TreeMap((4, "d"), (5, "f"))
    val other = TreeMap((5, "f"), (4, "d"))
    print(s"${same == other} ${same.hash() == other.hash()} ${same != TreeMap((4, "d"))}")
    print(s"${same.hash() == Map((4, "d"), (5, "f")).hash()}")
    print(s"${same == TreeMap((4, "d"), (5, "g"))}")

    val padded = StringWriter()
    TreeMap((1, 2)).display(padded, FormatSpec(width = 10))
    print(s"[${padded.text()}]")

    val dogs = TreeMap((2, Dog("rex")), (1, Dog("ace")))
    val animals: TreeMap[int, Animal] = dogs
    val named = animals.updated(3, Animal("cat"))
    print(named.values().map(a -> a.name))
