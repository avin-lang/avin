// expect: exit 0
// The regex chapter's API: `Regex` with group names given, prefix searches, `replaceFirstIn`,
// `replaceSomeIn`, a computed replacement read as one, empty matches replaced at every position,
// quoting, splitting with each kind of limit, `Pattern`, `Match`'s members, a `MatchIterator`
// answering for its current match, the capture rules of repeated groups, and `PatternError`s.
import avin.regex
import avin.regex.{Regex, Match, Groups}

shownSplit(xs: Array[string]) -> string = xs.toList().map(s -> s"<$s>").mkString("")

describe(pattern: string) -> string = Regex.compile(pattern) match
    Ok(_) -> "compiled"
    Err(e) -> s"${e.description} @${e.index}"

main()
    val named = Regex("(\\d+)-(\\d+)", "from", "to")
    val m = named.findFirstMatchIn("pages 12-30").get()
    println(s"${m.group("from")} ${m.group("to")} ${m.group("")} ${m.groupNames()}")
    println(s"${m.groupCount()} ${m.start(2)} ${m.end(2)} ${m.before(1)} ${m.after(2)} ${m.after()}")
    val opt = Regex("(a)|(b)").findFirstMatchIn("b").get()
    println(s"${opt.start(1)} ${opt.end(1)} ${opt.group(1)} ${opt.before(1)} ${opt.subgroups()}")
    println("(x)(y)?".r("first", "second").findFirstMatchIn("x").get().group("second"))

    val word = Regex("\\w+")
    println(word.findPrefixOf("abc def"))
    println(word.findPrefixOf(" abc"))
    println(word.findPrefixMatchOf("abc def").map(m -> m.end()))
    println(word.replaceFirstIn("one two three", "N"))
    println(word.replaceAllIn("one two", m -> m.matched().byteLength().toString()))
    println(Regex("(\\w)(\\w*)").replaceAllIn("one two", m -> "$2$1"))
    println(word.replaceSomeIn("one two three", m -> if m.matched() == "two" then Some("2") else None))
    println(Regex("(?<w>o)").replaceAllIn("foo", "[${w}]"))
    println(Regex("(o)").replaceAllIn("foo", "$10"))
    println(Regex("(o)|(x)").replaceAllIn("fo", "[$2]"))
    println(Regex("o").replaceAllIn("foo", "\\$\\\\"))
    println(Regex("o").replaceAllIn("foo", Regex.quoteReplacement("$1\\")))
    println(Regex.quoteReplacement("$1\\"))
    println(Regex("").replaceAllIn("é😀", "-"))
    println(Regex("a*").replaceAllIn("baaac", "-"))
    println(Regex("z").replaceAllIn("abc", "-"))
    println(Regex(Regex.quote("a.b\\Ec")).matches("a.b\\Ec"))
    println(Regex.quote("x\\Ey"))

    println(shownSplit(Regex(",").split(",a")))
    println(shownSplit(Regex("").split("ab")))
    println(shownSplit(Regex(",").split("")))
    println(shownSplit(Regex(",").split("a,,b,,")))
    println(Regex(",").split(",,").length())
    println(shownSplit(Regex(",").pattern().split("a,b,c,d", 2)))
    println(shownSplit(Regex(",").pattern().split("a,,b,,", -1)))
    val p = Regex("(a)(b)").pattern()
    println(s"${p.pattern()} ${p.groupCount()} ${Regex("(a)(b)")} ${Regex("x+").regex()}")

    val it = Regex("(\\d)(\\w)?").findAllIn("1a 2 3c")
    println(s"${it.start()} ${it.matched()}")
    while it.hasNext()
        val text = it.next()
        println(s"$text ${it.start()} ${it.end()} ${it.start(2)} ${it.end(1)} ${it.group(2)} ${it.groupCount()}")
    println(Regex("\\d").findAllIn("1 2").matchData().map(m -> m.start()).toList())

    println(Regex("((a)b){0,2}abc").findFirstMatchIn("ababc").map(m -> s"${m.group(1)} ${m.start(2)}"))
    println(Regex("(?:(a)|b)+").findFirstMatchIn("ab").map(m -> m.subgroups()))
    println(Regex("(?=(a))a").findFirstMatchIn("a").map(m -> m.group(1)))
    println(Regex("(?>a)?a").findFirstIn("a"))
    println(Regex("(a*)+b").findFirstMatchIn("aab").map(m -> m.group(1)))

    for t in List("2024-06-30", "x")
        val date = Regex("(\\d{4})-(\\d\\d)-(\\d\\d)")
        val out = t match
            date(y, rest*) -> s"$y $rest"
            _ -> "not a date"
        println(out)
    val loose = Regex("(\\d+)").unanchored()
    println(loose.matches("ab12") && !loose.anchored().matches("ab12"))
    for g in "(\\d+)x(\\d+)|none".r().findAllMatchIn("3x4 none")
        if g is Groups(w, h) then println(s"$w by $h") else println("no groups")
    if Regex("x").findFirstMatchIn("x").get() is Groups() then println("groupless") else println("not groupless")

    println(describe("(ab"))
    println(describe("a)"))
    println(describe("[ab"))
    println(describe("*a"))
    println(describe("a{2,1}"))
    println(describe("a{2"))
    println(describe("\\y"))
    println(describe("\\x{110000}"))
    println(describe("a\\c"))
    println(describe("{"))
    println(describe("\\0"))
    println(describe("\\xg1"))
    println(describe("\\u12"))
    println(describe("(?<a"))
    println(describe("\\kx"))
    println(describe("\\p{}"))
    println(describe("(?<x"))
    println(describe("(?q)"))
    println(describe("(?<=a+)b"))
    println(describe("(?<n>a)(?<n>b)"))
    println(describe("\\k<m>"))
    println(describe("(?<1a>x)"))
    println(describe("\\p{Nope}"))
    println(describe("\\p{"))
    println(describe("\\N{LATIN SMALL LETTER A}"))
    println(describe("\\pL\\X(?<=\\X)"))
    Regex.compile("*a") match
        Err(e) -> println(e.message())
        Ok(_) -> ()
    Regex.compile("(ab") match
        Err(e) -> println(e.message())
        Ok(_) -> ()
