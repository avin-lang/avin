// expect: exit 0
// A local `lazy val` is computed on its first read, exactly once, and every later read gives the
// value kept; one that is never read is never computed, and one read only on a branch not taken is
// not computed either. Its initializer sees the locals around it as they are when it runs.
var computed: Vector[string] = []

note(label: string, value: int) -> int
  computed = computed :+ label
  println(s"computing $label")
  value

pick(flag: bool) -> int
  lazy val costly = note(s"costly for $flag", 7)
  if flag then costly * 2 else 0

main()
  lazy val never = note("never", 1)
  lazy val twice = note("twice", 21)
  println("before any read")
  println(twice + twice)
  println(twice)

  // Read on one branch only.
  println(pick(false))
  println(pick(true))

  // Declared and inferred types, the extremes of `int` and `long`, Unicode, unit.
  lazy val smallest: int = -2147483648
  lazy val largest: long = 9223372036854775807
  lazy val greeting = "héllo, 世界 👋"
  lazy val nothing: unit = println("the unit value is computed")
  println(smallest)
  println(largest)
  println(greeting.charCount)
  nothing
  nothing

  // A later lazy value may read an earlier one; the earlier is computed by that read.
  lazy val base = note("base", 4)
  lazy val derived = base * base
  println(derived)
  println(base)

  // A `var` the initializer reads is read when the value is computed, not where it is declared.
  var n = 5
  lazy val doubled = n * 2
  n = 50
  println(doubled)
  n = 500
  println(doubled)

  // An inner block's lazy value hides an outer name, and is its own.
  val shown = 1
  if true
    lazy val shown = note("inner shown", 2)
    println(shown)
  println(shown)

  println(computed)
