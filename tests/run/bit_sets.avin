// expect: exit 0
// An immutable `BitSet` is a `SortedSet[int]` kept as bits: membership, adding and removing as a `Set`
// has them, the set algebra a word at a time, iteration in ascending order, the ordered operations, and
// the words themselves through `toBitMask` and `fromBitMask`. It is checked at the 64-bit word
// boundaries, with large sparse elements, and against a `TreeSet` as the model.

// The next pseudo-random number below `n`, from a linear congruential state.
next(seed: long, n: int) -> (long, int)
    val s = (seed * 1103515245 + 12345) % 2147483648
    (s, int((s / 65536) % long(n)))

// A bit set and a tree set of up to `count` elements below `limit`, from `seed`.
build(seed: long, count: int, limit: int) -> (BitSet, TreeSet[int], long)
    var s = seed
    var b = BitSet.empty()
    var t = TreeSet.empty[int]()
    for _ in 0 ..< count
        val r = next(s, limit)
        s = r.0
        b = b.incl(r.1)
        t = t.incl(r.1)
    (b, t, s)

same(b: BitSet, t: TreeSet[int]) -> bool = b.toVector == t.toVector && b.size == t.size

setKind(s: Set[int]) -> string = s match
    _: BitSet -> "bit"
    _: TreeSet[int] -> "tree"
    _: HashSet[int] -> "hash"
    _ -> "other"

sum(s: Set[int]) -> int = s.foldLeft(0, (a, x) -> a + x)

main()
    // Empty.
    val e = BitSet.empty()
    println(e, e.size, e.isEmpty, e.nonEmpty, e.toBitMask, e.headOption, e.lastOption)
    println(e.minAfter(0), e.maxBefore(100), e.range(0, 10), e.rangeFrom(0), e.reverseIterator().toVector)
    println(e == BitSet(), e.hash() == HashSet.empty[int]().hash(), e.contains(0), e.excl(5) == e, e.diff(BitSet(1)))

    // The word boundaries: 0, 63, 64, 65, 127, 128.
    val w = BitSet(0, 63, 64, 65, 127, 128)
    println(w, w.size, w.toBitMask)
    println(w.contains(0), w.contains(1), w.contains(62), w.contains(63), w.contains(64), w.contains(65), w.contains(66))
    println(w.contains(127), w.contains(128), w.contains(129), w.contains(1000))
    println(BitSet(63).toBitMask, BitSet(64).toBitMask, BitSet(0).toBitMask, BitSet(65).toBitMask)
    println(w.excl(64), w.excl(0), w.excl(128).toBitMask, w.excl(65).excl(64).excl(63).toBitMask)
    println(w.incl(1), w.incl(64) == w, w.incl(129).size, w.excl(7) == w)

    // The sign bit of a word is element 63: the mask is negative, and the element behaves like any other.
    val top = BitSet(63)
    println(top.toBitMask, top.contains(63), top.headOption, top.lastOption, top.size, top.excl(63).isEmpty)
    println(top.reverseIterator().toVector, top.minAfter(63), top.maxBefore(64), top.maxBefore(63), top.minAfter(64))
    println(BitSet(0, 1, 2, 3).toBitMask, BitSet.fromBitMask([-1]).size, BitSet.fromBitMask([-1]).lastOption)

    // Persistence: an update leaves the old set as it was.
    val base = BitSet(1, 2, 3)
    val grown = base.incl(70)
    val shrunk = base.excl(1)
    println(base, grown, shrunk, base == BitSet(1, 2, 3))

    // The example of the specification.
    val doc = BitSet(1, 3, 64)
    println(doc.toBitMask, BitSet.fromBitMask([10, 1]), doc.rangeFrom(2), doc.rangeFrom(-5) == doc)

    // Ordered operations, first and last, the nearest element, the ranges.
    val s = BitSet(5, 3, 9, 1, 64, 63, 65, 200)
    println(s.headOption, s.lastOption, s.head, s.last, s.firstKey, s.lastKey)
    println(s.minAfter(-5), s.minAfter(0), s.minAfter(1), s.minAfter(2), s.minAfter(64), s.minAfter(66), s.minAfter(200), s.minAfter(201))
    println(s.maxBefore(-5), s.maxBefore(0), s.maxBefore(1), s.maxBefore(2), s.maxBefore(64), s.maxBefore(65), s.maxBefore(201), s.maxBefore(1000))
    println(s.rangeFrom(-3), s.rangeFrom(5), s.rangeFrom(6), s.rangeFrom(65), s.rangeFrom(66), s.rangeFrom(201))
    println(s.rangeTo(-1), s.rangeTo(0), s.rangeTo(1), s.rangeTo(63), s.rangeTo(64), s.rangeTo(200), s.rangeTo(int.MaxValue))
    println(s.rangeUntil(-1), s.rangeUntil(1), s.rangeUntil(2), s.rangeUntil(64), s.rangeUntil(65), s.rangeUntil(201))
    println(s.range(3, 65), s.range(0, 1000), s.range(5, 5), s.range(9, 5), s.range(-100, 4), s.range(64, 66))
    println(s.range(int.MinValue, int.MaxValue), s.rangeFrom(int.MinValue), s.rangeFrom(int.MaxValue), s.rangeUntil(int.MinValue))
    println(s.iteratorFrom(9).toVector, s.iteratorFrom(10).toVector, s.reverseIterator().toVector)
    println(s.range(3, 65).toBitMask, s.range(64, 66).toBitMask, s.rangeFrom(64).toBitMask)

    // Large sparse elements.
    val sparse = BitSet(0, 4095, 4096, 20000, 40000)
    println(sparse, sparse.size, sparse.toBitMask.length, sparse.contains(40000), sparse.contains(39999))
    println(sparse.lastOption, sparse.maxBefore(40000), sparse.minAfter(4097), sparse.rangeFrom(4096).size)
    println(sparse.excl(40000).toBitMask.length, sparse.excl(40000).lastOption, sparse.range(4096, 20001))
    println(BitSet(40000).contains(40000), BitSet(30000).incl(5).toBitMask.length)

    // Set algebra: across kinds the result keeps the receiver's kind.
    val a = BitSet(1, 2, 3, 64, 100)
    val b = BitSet(3, 4, 64, 200)
    println(a.union(b), a.intersect(b), a.diff(b), b.diff(a), a.symmetricDiff(b), a ++ b, a -- b)
    println(a.union(e), e.union(a), a.intersect(e), e.intersect(a), a.diff(e), e.diff(a), a.symmetricDiff(a), a.diff(a).isEmpty)
    println(a.subsetOf(a), a.intersect(b).subsetOf(a), a.subsetOf(b), e.subsetOf(a), a.subsetOf(e), a.subsetOf(a.incl(9)))
    println(a ++ [7, 8, 7], a -- [1, 99, -4, 100000], a ++ (10 ..< 13), a ++ Vector[int]())
    println((a -- a).toBitMask, (a ++ [9000]).toBitMask.length, ((a ++ [9000]) -- [9000]).toBitMask.length)
    val ts: Set[int] = TreeSet(2, 3, 4)
    val hs: Set[int] = HashSet(3, 99)
    val bs: Set[int] = a
    println(setKind(bs.union(ts)), setKind(bs.intersect(ts)), setKind(bs.diff(hs)), setKind(ts.union(bs)), setKind(hs.intersect(bs)))
    println(bs.union(ts).toVector, bs.intersect(ts).toVector, bs.diff(hs).toVector, ts.diff(bs).toVector, bs.subsetOf(ts), BitSet(2, 3).subsetOf(ts))
    println(a.union(HashSet(5, 6)), a.intersect(TreeSet(1, 64, 7)), a.diff(HashSet(1, 2)), a.subsetOf(TreeSet(1, 2, 3, 64, 100, 101)))
    println(a.filter(x -> x % 2 == 0), a.filter(x -> false), a.filter(x -> true) == a, a.filter(x -> x < 64).toBitMask)

    // Through the traits: an update keeps the kind.
    val viaSorted: SortedSet[int] = BitSet(10, 20)
    val viaSet: Set[int] = BitSet(10, 20)
    println(setKind(viaSorted.incl(5)), setKind(viaSet.incl(5)), setKind(viaSet.excl(10)), setKind(viaSet ++ [1]), setKind(viaSorted.filter(x -> x > 10)))
    println(viaSorted.incl(5).headOption, viaSorted.rangeFrom(11).toVector, viaSorted.maxBefore(20), viaSorted.reverseIterator().toVector)
    println(viaSet(10), viaSet(11), viaSet.contains(20), sum(viaSet), viaSet.size, viaSet.map(x -> x / 10))
    println(SortedSet[int](3, 1).union(viaSorted).headOption, viaSorted.union(SortedSet[int](3, 1)).headOption)

    // Equality and hashes: equal to any set of the same elements, whatever its kind.
    val x1: Set[int] = BitSet(1, 3, 64, 65)
    val x2: Set[int] = TreeSet(65, 3, 64, 1)
    val x3: Set[int] = HashSet(1, 3, 64, 65)
    val x4: Set[int] = BitSet(1, 3, 64)
    println(x1 == x2, x2 == x1, x1 == x3, x3 == x1, x1 == x4, x4 == x1, x1 == x1)
    println(x1.hash() == x2.hash(), x1.hash() == x3.hash(), x1.hash() != x4.hash(), BitSet(1, 3, 64, 65).hash() == x3.hash())
    val ax: Any = BitSet(1, 2)
    val ay: Any = TreeSet(2, 1)
    val az: Any = HashSet(1, 2)
    println(ax == ay, ay == ax, ax == az, az == ax, ax.hash() == ay.hash(), ax == TreeSet(1))
    println(BitSet(1, 2) == BitSet(2, 1), BitSet(1, 2) != BitSet(1, 2, 3), BitSet.empty() == BitSet.fromBitMask([0, 0]))
    println(BitSet.fromBitMask([0, 0, 0]).toBitMask, BitSet.fromBitMask([5, 0]).toBitMask, BitSet.fromBitMask([]) == e)
    println(HashSet(BitSet(1, 2), BitSet(2, 1), BitSet(3)).size, HashMap((BitSet(1), "a")).get(BitSet(1)))

    // Bit-mask round trip.
    val roundTrip = [BitSet.empty(), BitSet(0), BitSet(63), BitSet(64), BitSet(0, 63, 64, 127, 128), s, sparse]
    for r in roundTrip
        println(BitSet.fromBitMask(r.toBitMask) == r, BitSet.fromBitMask(r.toBitMask).toBitMask == r.toBitMask)
    println(BitSet.fromBitMask([1, 2]), BitSet.fromBitMask([0, 1]),BitSet.fromBitMask([long.MinValue]), BitSet.fromBitMask([long.MaxValue]).size)
    println(BitSet.fromBitMask([-1, -1]).size, BitSet.fromBitMask([-1, -1]).range(60, 68), BitSet.fromBitMask([-1, -1]).lastOption)

    // Companion, builder, display and debug, the predicate of membership.
    val built = BitSet.newBuilder()
    built.addOne(9)
    built.addOne(2)
    built.addOne(9)
    println(built.result(), BitSet(), BitSet(7, 7, 7), BitSet(4).toVector, BitSet(4, 2).toList)
    val bld = BitSet.newBuilder()
    bld.addOne(1)
    bld.clear()
    bld.addOne(2)
    println(bld.result())
    val lit: SortedSet[int] = {5, 1, 3}
    println(lit)
    println(s"${BitSet(1, 2)} ${BitSet(1, 2)}",BitSet(1, 2, 3).mkString(","), BitSet(5, 6).toVector, BitSet(1, 2, 3).toVector.length)
    println([1, 2, 3, 64, 100].filter(BitSet(3, 64, 100)), BitSet(1, 2).exists(x -> x == 2), BitSet(3, 4).forall(x -> x > 3))
    println(BitSet(3, 1, 2).foldLeft(0, (a, x) -> a * 10 + x), BitSet(3, 1, 2).map(x -> -x).size, BitSet(1, 2).flatMap(x -> [x, x + 100]).size)
    println(BitSet(5, 1).toVector, BitSet(5, 1).size, BitSet(1, 2, 3).count(x -> x > 1))

    // A model check against a TreeSet, over random sets of several densities: every operation's answer
    // matches the tree set's.
    var seed: long = 7
    var checked = 0
    var bad = 0
    for limit in [10, 64, 65, 200]
        for _ in 0 ..< 3
            val r1 = build(seed, 30, limit)
            val r2 = build(r1.2, 20, limit)
            seed = r2.2
            val b1 = r1.0
            val t1 = r1.1
            val b2 = r2.0
            val t2 = r2.1
            val probe = limit / 2
            if !same(b1, t1) || !same(b2, t2) then bad += 1
            if !same(b1.union(b2), t1.union(t2)) then bad += 1
            if !same(b1.intersect(b2), t1.intersect(t2)) then bad += 1
            if !same(b1.diff(b2), t1.diff(t2)) then bad += 1
            if !same(b1 ++ t2, t1 ++ t2) then bad += 1
            if !same(b1 -- t2, t1 -- t2) then bad += 1
            if b1.subsetOf(b2) != t1.subsetOf(t2) then bad += 1
            if b1.subsetOf(t2) != t1.subsetOf(t2) then bad += 1
            if b1.headOption != t1.headOption || b1.lastOption != t1.lastOption then bad += 1
            if b1.minAfter(probe) != t1.minAfter(probe) || b1.maxBefore(probe) != t1.maxBefore(probe) then bad += 1
            if !same(b1.rangeFrom(probe), t1.rangeFrom(probe)) || !same(b1.rangeTo(probe), t1.rangeTo(probe)) then bad += 1
            if !same(b1.rangeUntil(probe), t1.rangeUntil(probe)) || !same(b1.range(3, probe), t1.range(3, probe)) then bad += 1
            if b1.reverseIterator().toVector != t1.reverseIterator().toVector then bad += 1
            if b1.iteratorFrom(probe).toVector != t1.iteratorFrom(probe).toVector then bad += 1
            if !same(b1.filter(x -> x % 3 == 0), t1.filter(x -> x % 3 == 0)) then bad += 1
            if !same(b1.excl(probe), t1.excl(probe)) || !same(b1.incl(probe), t1.incl(probe)) then bad += 1
            val sb: Set[int] = b1
            val st: Set[int] = t1
            if sb != st || sb.hash() != st.hash() then bad += 1
            if BitSet.fromBitMask(b1.toBitMask) != b1 then bad += 1
            for x in 0 ..< limit + 2
                if b1.contains(x) != t1.contains(x) then bad += 1
            checked += 1
    println("model", checked, bad)

    // Allocation under pressure: many small sets built, grown and dropped.
    var total = 0
    for i in 0 ..< 40
        var g = BitSet.empty()
        for j in 0 ..< 10 do g = g.incl(i * 7 + j * 13)
        total += g.size + g.toBitMask.length
        total += (g.union(BitSet(i)) -- [i]).size
    println(total)
