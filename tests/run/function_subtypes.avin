// A data type is a function by an impl naming the function type, every variant alike; a value of a
// type parameter bounded by a sequence is a function from an index; a function's own type is never
// changed by where it is held.

data Lengths(n: int)

impl (string) -> int for Lengths
    apply(s: string) -> int = s.charCount() + n

data Step
    Up(by: int)
    Down(by: int)
    Stay

impl Step
    apply(x: int) -> int = self match
        Up(by) -> x + by
        Down(by) -> x - by
        Stay -> x

impl (int) -> int for Step

// A one-parameter function type as a parent needs no parentheses.
class Doubler: int -> int
    apply(x: int) -> int = x + x

measure(f: (string) -> int) -> int = f("abc")

// `xs` is a function from an index wherever its bound is a sequence.
pickAll[S: Seq[string]](xs: S, at: Vector[int]) -> Vector[string] = at.map(xs)

compose(f: (int) -> int, g: (int) -> int) -> (int) -> int = x -> g(f(x))

main()
    val l = Lengths(1)
    print(l("ab"))
    print(measure(l))
    print(["a", "bb"].map(l))

    val steps: Vector[(int) -> int] = [Up(2), Down(5), Stay, x -> x * 10]
    print(steps.map(s -> s(10)))
    print(compose(Up(1), Down(3))(0))
    print(compose(Up(1), x -> x * x)(2))
    print(compose(Doubler(), Doubler())(3))

    print(pickAll(["p", "q", "r"], [2, 0]))
    val names: List[string] = ["x", "y"]
    print(pickAll(names, [1, 1]))

    // Captured values reach a closure called as a function value, alongside the objects.
    var total = 0
    val add: (int) -> int = x ->
        total += x
        total
    val calls: Vector[(int) -> int] = [add, Up(100), add]
    print(calls.map(f -> f(5)))
    print(total)
