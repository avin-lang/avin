// expect: exit 0
// env: AVIN_GC_STRESS=0
// Fifty thousand futures made as fast as possible and then awaited, and chains of `flatMap` whose
// links each make a future, so the pool's threads park and wake across workers while short threads
// end and hand their stacks on.
import avin.threads.Future

main() -> int
    val futures = (0..<50000).map(i -> Future(i % 9)).toVector()
    var total = 0
    for f in futures do total += f.await()
    println(total)
    var chains = 0
    for c in 0..<100
        chains += (0..<100).foldLeft(Future.successful(c), (f, _) -> f.flatMap(n -> Future(n + 1))).await()
    println(chains)
    0
