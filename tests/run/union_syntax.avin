// expect: exit 0
// A union is written wherever a type is: a parameter, a result, a `val` and a `var`, a field of a
// data type and of a class, a type argument, a part of a tuple and of a function type, and an alias's
// body. `|` binds more tightly than `->`: `(A) -> B | C` returns the union and `A | B -> C` takes it;
// a union of function types parenthesizes each. `Option[A | B]` and `Option[A] | B` are different
// types, `[]int | string` is a vector or a string and `[](int | string)` a vector of the union. A
// union breaks across lines inside brackets, after a `|`. In a pattern `|` separates alternatives, in
// an expression it is the bitwise or or a type's method `|`, and after a clause's arguments it
// begins a guard, each beside unions in the same file.

data Cell(content: int | string)

class Slot(var held: int | string)

type Key = int | string

class Flags(val bits: int)
    |(other: Flags) -> Flags = Flags(bits | other.bits)

show(x: int | string) -> string = x match
    n: int -> s"int $n"
    s: string -> s"string $s"

pick(first: bool) -> int | string = if first then 1 else "one"

takes(f: int | string -> string) -> string = f(2) + " " + f("two")

returns(n: int) -> (int) -> int | string = (k: int) -> if k > n then k else "small"

choose(f: ((int) -> int) | string) -> string = f match
    g: ((int) -> int) -> s"called ${g(20)}"
    s: string -> s"text $s"

optional(o: Option[int | string]) -> string = o match
    Some(v) -> s"some ${show(v)}"
    None -> "none"

either(o: Option[int] | string) -> string = o match
    x: Option[int] -> s"option $x"
    s: string -> s"string $s"

vectorOr(v: []int | string) -> string = v match
    xs: Vector[int] -> s"ints ${xs.size()}"
    s: string -> s"string $s"

vectorOf(v: [](int | string)) -> string = v.map(show).mkString(", ")

parenthesized(x: (int | string)) -> string = show(x)

broken(xs: Vector[int |
        string |
        bool]) -> int = xs.size()

sendable(f: @sendable (int) -> int | string) -> string = show(f(0))

identity[T](x: T) -> T = x

positive(n: int | string) -> string
positive(n: int) | n > 0 = "positive int"
positive(n: int) = "int"
positive(s: string) = "string"

alternatives(v: int | string | bool) -> string = v match
    _: int | _: string -> "int or string"
    _: bool -> "bool"

main()
    println(show(1))
    println(show("a"))
    println(show(pick(true)))
    println(show(pick(false)))
    val v: int | string = 3
    var w: int | string = 4
    w = "four"
    println(s"${show(v)} ${show(w)}")
    println(show(Cell("cell").content))
    val slot = Slot(5)
    slot.held = "slot"
    println(show(slot.held))
    println(show(identity[int | string](6)))
    println(List.empty[int | string]().size())
    val pair: (int | string, bool) = ("pair", true)
    println(s"${show(pair.0)} ${pair.1}")
    val k: Key = 7
    println(show(k))
    println(takes(show))
    println(show(returns(1)(5)))
    println(show(returns(9)(5)))
    println(choose((n: int) -> n + 1))
    println(choose("plain"))
    println(optional(Some(8)))
    println(optional(Some("eight")))
    println(optional(None))
    println(either(Some(9)))
    println(either("nine"))
    println(vectorOr([1, 2, 3]))
    println(vectorOr("ten"))
    println(vectorOf([1, "two", 3]))
    println(parenthesized(11))
    println(broken([1, "a", true]))
    println(sendable(n -> if n > 0 then n else "zero"))
    println(positive(12))
    println(positive(-12))
    println(positive("p"))
    println(alternatives(1))
    println(alternatives("s"))
    println(alternatives(false))
    // `|` in an expression is still the bitwise or, and a type's own method `|`.
    val a = 12
    val b = 3
    println(a | b)
    println((Flags(1) | Flags(4)).bits)
