// expect: exit 0
// Branches that agree on no type of their own are taken as the type expected of them, where both fit
// it, also while that type's arguments are still being inferred: a lambda passed to `flatMap` is
// expected to yield an `Iterable[U]`, so a `List[int]` in one branch and a `Vector[int]` in the
// other agree on `Iterable[int]`, and `U` is `int`. The same holds for `match` arms, nested `if`s,
// a block's last expression, a loop's `else` and `break`, generic arguments, and user traits.

trait Source[T]
    item() -> T
trait Named
    name() -> string

// Two classes sharing two unrelated traits, so only the type asked for decides between them.
class Apple(val n: int) : Source[int], Named
    override item() -> int = n
    override name() -> string = "apple"
class Pear(val n: int) : Source[int], Named
    override item() -> int = n * 10
    override name() -> string = "pear"

total[U](xs: Iterable[U], f: (U) -> int) -> int
    var s = 0
    for x in xs
        s += f(x)
    s

fromSource[U](f: () -> Source[U]) -> U = f().item()

maybe[U](f: (int) -> Option[Iterable[U]]) -> Iterable[U] = f(1).getOrElse(List.empty[U]())

firstFound[U](xs: Vector[int], f: (int) -> Iterable[U]) -> Iterable[U]
    var i = 0
    while i < xs.length()
        if xs(i) > 1 then break f(xs(i))
        i += 1
    else List.empty[U]()

main()
    val v: Vector[int] = [1, 2, 3]
    val l = List.empty[int]()

    // Both branch orders.
    println(v.flatMap(n -> if n == 2 then l else v))
    println(v.flatMap(n -> if n == 2 then v else l))

    // `match` arms, `elif` chains and nested `if`s.
    println(v.flatMap(n -> n match
        1 -> l
        2 -> v
        _ -> [n]))
    println(v.flatMap(n -> if n == 1 then l elif n == 2 then v else [n, n]))
    println(v.flatMap(n -> if n == 1 then (if n > 0 then l else v) else v))

    // The last expression of a block body.
    println(v.flatMap(n ->
        val k = n * 2
        if k == 2 then l else v))

    // A generic method argument.
    println(total(if v.length() == 3 then l else v, x -> x))

    // A user trait, which the branches' classes share with another.
    println(fromSource(() -> if v.length() == 3 then Apple(4) else Pear(4)))
    println(fromSource(() -> if v.length() == 2 then Apple(4) else Pear(4)))

    // The shape nested in an `Option`.
    println(maybe(n -> if n == 1 then Some(l) else Some(v)).toList())
    println(maybe(n -> if n == 2 then Some(l) else Some(v)).toList())

    // A loop's `else` and its `break`.
    println(firstFound(v, n -> if n == 2 then v else l).toList())
    println(v.flatMap(n ->
        var i = 0
        while i < n
            if i == 1 then break l
            i += 1
        else v))
