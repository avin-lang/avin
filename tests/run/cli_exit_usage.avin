// expect: exit 2
// args: one.txt --top many
// `parseOrExit` given arguments the program does not take: the program's name and what was wrong,
// the usage line and where the help is go to standard error, nothing to standard output, and the
// program exits with 2 before `main` goes on.
import avin.cli

val parser = cli.Parser("wc", "Count lines, words and characters.")
    .flag("lines", short = 'l', help = "count lines")
    .int("top", help = "list the N commonest words", value = "N")
    .positionals("file", help = "the files to count", required = true)

main(args: Vector[string]) -> int
    val opts = parser.parseOrExit(args)
    println(s"not reached: ${opts.int("top")}")
    0
