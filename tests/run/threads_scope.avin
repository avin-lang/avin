// expect: exit 0
// `scope` returns only once every thread started through it has finished: each thread stores into its
// own atomic slot and the slots are read without joining any of the threads; a scope's body may
// join a thread itself, and the scope's own join of it then returns at once; a scope's threads may
// start and join threads of their own; a scope that starts nothing returns its body's result.
import avin.threads.{Atomic, scope, spawn}

work(n: int) -> int
    var s = 0
    for i in 0..<n * 100000 do s += i % 7
    s

main() -> int
    val slots = (0..<6).map(_ -> Atomic(0)).toVector
    val answer = scope((s) ->
        for i in 0..<6
            s.spawn(() -> slots(i).store(work(i + 1)))
        "body done")
    println(answer)
    for i in 0..<6
        if slots(i).load() != work(i + 1) then return 1
    val joined = scope((s) ->
        val t = s.spawn(() -> 40)
        val inner = s.spawn(() -> spawn(() -> 2).join())
        t.join() + inner.join())
    println(joined)
    println(scope((s) -> 7))
    0
