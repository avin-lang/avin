// expect: exit 0
// A method an impl with bounds of its own adds exists only at the type arguments that meet the
// bounds, so code that builds a larger instance of the type, at a type argument that does not, needs
// no copy of the method there: it compiles, and its type arguments do not grow. Here on a data type
// of the program's own, on one of the library's, on a recursive data type, through a trait's
// default body the impl brings, through generic code passing the type argument on, and nested.

trait Show
  show() -> string
  twice() -> string = show() + show()

impl Show for int
  show() -> string = s"#$self"
  twice() -> string = show() + show()

// No `Ord` and no `Show`.
data Plain[T](value: T)

data Box[T](value: T)

// Comparing boxes builds a box of a `Plain`, which has no `Ord`, so the comparison is never needed
// at `Box[Plain[T]]`.
impl[T: Ord] Ord for Box[T]
  compare(other: Box[T]) -> int
    val wider = Box(Plain(value))
    if wider.value.value != value then return 99
    value.compare(other.value)

data Cell[T](value: T)

// Showing a cell builds a cell of a `Plain`, which has no `Show`.
impl[T: Show] Show for Cell[T]
  show() -> string
    val wider = Cell(Plain(value))
    if wider.value.value.show() != value.show() then return "?"
    s"Cell(${value.show()})"

// A trait the program declares, implemented by a type of the library's.
impl[T: Show] Show for Option[T]
  show() -> string
    val wider = Some(Plain(self))
    if wider.isEmpty then return "?"
    self match
      Some(v) -> s"Some(${v.show()})"
      None -> "None"

// A recursive data type: its children are the same instance.
data Tree[T](label: T, kids: Vector[Tree[T]])

impl[T: Show] Show for Tree[T]
  show() -> string
    var out = label.show()
    for k in kids
      out = out + "(" + k.show() + ")"
    out

// Generic code passing a box's type argument on: `relay` holds a `Plain` on one path and an
// ordered value on the other, and only the ordered one reaches the comparison.
relay[U](u: U) -> Box[U] = Box(u)

compareRelayed[U: Ord](a: U, b: U) -> int
  val p = relay(Plain(a))
  if p.value.value != a then return 99
  relay(a).compare(relay(b))

main()
  // On the program's own data type.
  println(Box(1) < Box(2))
  println(Box(3).compare(Box(3)))
  println(Box("b") > Box("a"))
  // Nested: a box of boxes is ordered because a box of ints is.
  println(Box(Box(1)) < Box(Box(2)))
  println(Box(Box(Box(5))).compare(Box(Box(Box(4)))))
  // An option of boxes, the library's conditional `Ord` over the program's.
  val some: Option[Box[int]] = Some(Box(1))
  val none: Option[Box[int]] = None
  println(none < some)
  println(Some(Some(Box(2))) > Some(Some(Box(1))))
  // Shown through the conditional impl, and through the default body it brings.
  println(Cell(7).show())
  println(Cell(Cell(8)).show())
  println(Cell(9).twice())
  // Through the method table: a cell as a `Show`, which a cell of a `Plain` is not.
  val shown: Show = Cell(6)
  println(shown.show())
  println(shown.twice())
  val o: Option[int] = Some(4)
  val n: Option[int] = None
  println(o.show())
  println(n.show())
  println(Some(Cell(5)).show())
  println(Cell(o).show())
  // A recursive data type.
  val t = Tree(1, [Tree(2, []), Tree(3, [Tree(4, [])])])
  println(t.show())
  println(Tree(Cell(1), [Tree(Cell(2), [])]).twice())
  // Through generic code.
  println(compareRelayed(1, 2))
  println(compareRelayed("z", "a"))
  // Sorting through the library, at a type ordered by the conditional impl.
  val boxes: Vector[Box[int]] = [Box(3), Box(1), Box(2)]
  println(boxes.sorted.map((b) -> b.value))
