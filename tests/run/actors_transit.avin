// expect: exit 0
// A Sysl handle in a message is the receiving actor's from the send on, wherever the message holds
// it: directly, in an option, in a vector of tuples, in a class, in a recursive data type, or in the
// buffer of an `Isolated`. A receiver that sends it on hands it over in turn, so the last of a
// chain of actors reads from it, and an actor that sends one to itself keeps it. Each turn runs on
// one of four workers, so the handles are used on threads other than the one that made them.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.actors.{ActorRef, Isolated, isolate, spawn}
import avin.threads.{Executor, Promise}

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

class Box(val conn: TcpStream)

data Chain
  End
  Link(conn: TcpStream, next: Chain)

data Msg
  Direct(conn: TcpStream, done: Promise[string])
  Maybe(conn: Option[TcpStream], done: Promise[string])
  Many(conns: Vector[(int, TcpStream)], done: Promise[string])
  Boxed(box: Box, done: Promise[string])
  Linked(chain: Chain, done: Promise[string])
  Held(conns: Isolated[Buffer[TcpStream]], done: Promise[string])
  Forward(conn: TcpStream, to: ActorRef[Msg], done: Promise[string])

line(c: TcpStream) -> string = ok(c.readLine()) match
  Some(s) -> s
  None -> "end"

along(chain: Chain) -> string = chain match
  End -> "."
  Link(c, next) -> line(c) + " " + along(next)

actor Reader receives Msg
  receive
    Direct(conn, done) -> done.complete(line(conn))
    Maybe(conn, done) -> done.complete(conn match
      Some(c) -> line(c)
      None -> "none")
    Many(conns, done) ->
      var out = ""
      for (n, c) in conns do out = out + s"$n=${line(c)} "
      done.complete(out)
    Boxed(box, done) -> done.complete(line(box.conn))
    Linked(chain, done) -> done.complete(along(chain))
    Held(conns, done) ->
      val b = conns.take()
      var out = ""
      for c in b do out = out + line(c) + " "
      done.complete(out)
    Forward(conn, to, done) -> to tell Direct(conn, done)

// A connection whose far end has written `text`: the near end, which is sent.
opened(l: TcpListener, text: string) -> TcpStream
  val c = ok(TcpStream.connect("127.0.0.1", l.port()))
  val s = ok(l.accept())
  ok(c.writeText(text + "\n"))
  s

ask(r: ActorRef[Msg], make: (Promise[string]) -> Msg) -> string
  val p = Promise[string]()
  r tell make(p)
  p.future.await()

main()
  val ex = Executor.fixed(4)
  val l = ok(TcpListener.bind("127.0.0.1", 0))
  val a = spawn(Reader(), executor = ex)
  val b = spawn(Reader(), executor = ex)
  val c = spawn(Reader(), executor = ex)
  println(ask(a, p -> Direct(opened(l, "direct"), p)))
  println(ask(a, p -> Maybe(Some(opened(l, "maybe")), p)))
  println(ask(a, p -> Maybe(None, p)))
  println(ask(b, p -> Many(Vector((1, opened(l, "one")), (2, opened(l, "two")), (3, opened(l, "three"))), p)))
  println(ask(b, p -> Many(Vector(), p)))
  println(ask(b, p -> Boxed(Box(opened(l, "boxed")), p)))
  println(ask(c, p -> Linked(Link(opened(l, "first"), Link(opened(l, "second"), End)), p)))
  val x = opened(l, "isolated x")
  val y = opened(l, "isolated y")
  val held = isolate
    val b = Buffer[TcpStream]()
    b.append(x)
    b.append(y)
    b
  println(ask(c, p -> Held(held, p)))
  println(ask(a, p -> Forward(opened(l, "forwarded twice"), b, p)))
  val d = spawn(Reader(), executor = ex)
  println(ask(a, p -> Forward(opened(l, "through three"), c, p)))
  println(ask(d, p -> Forward(opened(l, "and back"), d, p)))
  ex.shutdown()
