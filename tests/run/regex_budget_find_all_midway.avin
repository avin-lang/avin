// expect: trap
// The plain searches still trap when an attempt spends its budget: walking every match gives those
// before the attempt that spends it, then traps, the message naming the budget and the checked
// searches that answer it instead.
import avin.regex.Regex

main()
    val r = Regex("x|(a+)+?$").withStepLimit(100000)
    val text = "x-x-x-" + "a".repeat(40) + "b"
    for m in r.findAllIn(text)
        println(m)
    println("not reached")
