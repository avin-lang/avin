// expect: exit 0
// Equality at its edges: NaN unequal to itself and -0.0 equal to 0.0, also as a field and a tuple part,
// with equal hashes; nested options; a data value holding collections, equal and hashing alike
// whatever its set's order, and found as a map key by an equal one; a List equal to a Vector; strings
// compared by their bytes, unnormalized; and i128 values at their limit.

data R(x: real)

data Bag(items: Vector[int], tags: Set[string])

main()
    val nan = real.NaN
    println(s"${nan == nan} ${nan != nan} ${nan < 1.0} ${0.0 == -0.0} ${0.0.hash() == (-0.0).hash()}")
    println(s"${R(0.0) == R(-0.0)} ${R(nan) == R(nan)}")
    println(s"${(0.0, 1) == (-0.0, 1)}")
    println(s"${Some(Some(1)) == Some(Some(1))} ${Some(None) == Some(None)} ${Some(Some(1)) == Some(None)}")
    val b1 = Bag([1, 2], {"a", "b"})
    val b2 = Bag([1, 2], {"b", "a"})
    println(s"${b1 == b2} ${b1.hash() == b2.hash()}")
    val m = {(b1): "one"}
    println(m.get(b2))
    val l: List[int] = [1, 2]
    val v: Vector[int] = [1, 2]
    println(s"${l == v} ${l.hash() == v.hash()}")
    println(s"${"" == ""} ${"é" == "é"}")
    val big1: i128 = 170141183460469231731687303715884105727
    val big2: i128 = 170141183460469231731687303715884105727
    println(s"${big1 == big2} ${big1.hash() == big2.hash()}")
