// expect: exit 0
// A `Child` handed to another thread to be waited for is still asked for its ids and signalled by
// the code that handed it over, which would trap at `waitFor`, `isAlive` or `kill`: the waiter sees
// the status the signal caused. So does a third thread, a future's body, and a thread of a vector of
// children each waited for by a thread of its own.
import avin.io.{ErrorKind, IoError}
import avin.process.{Child, Command}
import avin.signal
import avin.threads.{Future, spawn}

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

// An error's kind, without the process id its message names.
kind(e: IoError) -> ErrorKind = e.kind

main()
  // Waited for on a thread, signalled here.
  val child = ok(Command("/bin/sleep", "30").inNewGroup.start())
  val pid = child.pid()
  val waiter = spawn(() -> child.waitFor())
  println(child.pid() == pid)
  println(child.group() == Some(pid))
  println(child.signal(signal.Terminate).mapErr(kind))
  println(waiter.join())
  // Back here, it has been seen to end.
  println(child.signal(0).mapErr(kind))
  println(child.signalGroup(0).mapErr(kind))

  // Waited for by a future, its group signalled from a thread of its own.
  val grouped = ok(Command("/bin/sh", "-c", "/bin/sleep 30 & wait").inNewGroup.start())
  val waiting = Future(grouped.waitFor())
  println(spawn(() -> grouped.signalGroup(signal.Kill).mapErr(kind)).join())
  println(waiting.await())

  // Several, each waited for by a thread of its own, every one signalled from here.
  val many = (0 ..< 4).map(i -> ok(Command("/bin/sleep", "30").start())).toVector
  val waiters = many.map(c -> spawn(() -> c.waitFor())).toVector
  for (c, i) in many.zipWithIndex do println(
    c.signal(if i % 2 == 0 then signal.Terminate else signal.Kill).mapErr(kind)
  )
  println(waiters.map(t -> t.join()))

  // A waiter of a program that ends by itself, while this thread signals it with zero until it is
  // seen to end; the signal never fails any other way.
  val quick = ok(Command("/bin/sleep", "0.2").start())
  val q = spawn(() -> quick.waitFor())
  var answers = 0
  while quick.signal(0).isOk do answers += 1
  println(answers > 0)
  println(q.join())
  println(quick.signal(0).mapErr(kind))
