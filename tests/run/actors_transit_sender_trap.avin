// expect: trap
// A connection sent in a message is the receiving actor's from the send on, so the sender's next
// use of it traps, though the receiver has used it already and the sender still holds it.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.actors.spawn
import avin.threads.Promise

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message())

data Msg
    Serve(conns: Vector[TcpStream], done: Promise[unit])

actor Server receives Msg
    receive
        Serve(conns, done) ->
            for c in conns do println(ok(c.readLine()))
            done.complete(())

main()
    val l = ok(TcpListener.bind("127.0.0.1", 0))
    val c = ok(TcpStream.connect("127.0.0.1", l.port()))
    val s = ok(l.accept())
    ok(c.writeText("hello\nagain\n"))
    val server = spawn(Server())
    val done = Promise[unit]()
    server tell Serve(Vector(s), done)
    done.future.await()
    println("served")
    s.readLine()
    println("not reached")
