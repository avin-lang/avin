// expect: exit 0
// The neighbours of a forwarded use: an infix call, a lone `<` by a method, a method's own type
// arguments written and inferred, a by-name parameter evaluated as the member decides, a lambda
// capturing the exporting value, a private export used by the type's own code and its companion, an
// export of an empty collection's members, and boundary values.
class Counter(var count: int)
  plus(n: int) -> int = count + n
  <(other: int) -> bool = count < other
  convert[U](f: (int) -> U) -> U = f(count)
  orElse(fallback: -> int) -> int = if count > 0 then count else fallback

class Box(c: Counter)
  export c.{plus, <, convert, orElse}
  private export c.count as hidden
  peek() -> int = self.hidden

object Box
  peekAt(b: Box) -> int = b.hidden

class Names(names: Vector[string])
  export names.{isEmpty, length, headOption, mkString}

var evaluated = 0

side() -> int
  evaluated += 1
  99

main()
  val b = Box(Counter(5))
  println(b plus 3)
  println(b < 6)
  println(b < 5)
  println(b.convert[string](n -> s"#$n"))
  println(b.convert(n -> n * 2))
  println(b.orElse(side()))
  println(evaluated)
  val zero = Box(Counter(0))
  println(zero.orElse(side()))
  println(evaluated)
  val adders = [1, 2, 3].map(n -> b.plus(n))
  println(adders)
  val later = () -> b.plus(100)
  println(later())
  println(b.peek())
  println(Box.peekAt(zero))
  val none = Names(Vector.empty[string]())
  println(none.isEmpty)
  println(none.length)
  println(none.headOption)
  println(none.mkString("|"))
  val some = Names(["α", "β"])
  println(some.headOption)
  println(some.mkString("|"))
  println(Box(Counter(2147483647)).plus(-2147483647))
