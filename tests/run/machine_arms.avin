// expect: exit 0
// An arm's value is where the machine goes, so `stay` may be the value of any branch: of an `if`,
// of a nested `match`, of a block's last line. A state's own arms are tried before the shared
// ones, a guard that fails passes the event on to the next arm, and events of any type drive a
// machine: here an `int`, matched by literals, ranges and comparisons.
machine Gauge receives int
    var seen = Vector[int]()

    state Low
        leave
            seen = seen :+ -1
        0 -> stay
        n if n > 100 -> High(n)
        1..10 ->
            if seen.length > 3 then Mid(5) else stay
        n ->
            seen = seen :+ n
            n % 2 match
                0 -> Mid(n)
                _ -> stay

    state Mid(level: int)
        n if n == level -> stay
        _ < 0 -> Low
        n ->
            seen = seen :+ n
            if n > level then High(n)
            elif n == 0 then stay
            else Mid(n)

    state High(peak: int)
        enter
            seen = seen :+ peak

    receive
        0 -> Low
        _ -> stay

main() -> int
    val g = Gauge()
    println(g.handle(0))
    println(g.handle(3))
    println(g.handle(13))
    println(g.handle(14))
    println(g.handle(14))
    println(g.handle(12))
    println(g.handle(0))
    println(g.handle(-4))
    println(g.handle(500))
    println(g.handle(7))
    println(g.handle(0))
    println(g.seen)
    0
