// expect: exit 0
// A `for` loop goes over a value whose type conforms to `Iterable` by name: a class declaring it, a
// class given it by an impl, a data type, a generic class, a subclass of a conforming class, an
// iterator of the program's own, a type parameter bounded by `Iterable` or by a trait requiring it,
// a value seen only as an `Iterable` or an `Iterator`, a union of collections, every library
// collection, a channel, and the
// ranges and arrays that have loops of their own. `break` and `continue` keep their meaning, and a
// closure made in the body captures the element of its own round.
import avin.threads.Channel

class Countdown(val from: int): Iterable[int]
  override iterator() -> Iterator[int] = CountdownIterator(from)

open class Steps(val n: int): Iterable[int]
  override iterator() -> Iterator[int] = (0 ..< n).iterator()

class Doubled(m: int): Steps(m)

class CountdownIterator(var at: int): Iterator[int]
  override hasNext() -> bool = at > 0
  override next() -> int
    if at <= 0 then fail("exhausted")
    at -= 1
    at + 1

class Bag
  val items = ["x", "y", "z"]

impl Iterable[string] for Bag
  iterator() -> Iterator[string] = items.iterator()

data Pair[T](first: T, second: T)

impl[T] Iterable[T] for Pair[T]
  iterator() -> Iterator[T] = [first, second].iterator()

class Box[T](val item: T): Iterable[T]
  override iterator() -> Iterator[T] = [item].iterator()

trait Shelf[T]: Iterable[T]
  label() -> string

class Books: Shelf[string]
  override label() -> string = "books"
  override iterator() -> Iterator[string] = ["a", "b"].iterator()

total[T: Iterable[int]](source: T) -> int
  var sum = 0
  for x in source do sum += x
  sum

labelled[S: Shelf[string]](shelf: S) -> string
  var out = shelf.label()
  for x in shelf do out = s"$out $x"
  out

joined[A: Display](source: Iterable[A]) -> string
  var out = ""
  for x in source do out = s"$out<$x>"
  out

pick(b: bool) -> Vector[int] | List[int] = if b then Vector(1, 2) else List(3)

drained[A](it: Iterator[A]) -> int
  var n = 0
  for _ in it do n += 1
  n

main()
  var seen = ""
  for x in Countdown(3) do seen = s"$seen$x"
  println(seen)
  for x in Countdown(0) do println("never")
  for b in Bag() do print(b)
  println()
  for x in Pair(1, 2) do print(x)
  println()
  for (a, b) in Pair((1, "one"), (2, "two")) do print(s"$a=$b ")
  println()
  for x in Box("only") do println(x)
  for x in Doubled(3) do print(x)
  println()
  for x in CountdownIterator(2) do print(x)
  println()
  println(total(Countdown(4)))
  println(total([5, 6]))
  println(total(Box(7)))
  println(labelled(Books()))
  println(joined(Bag()))
  println(joined(List(1, 2)))
  println(drained([1, 2, 3].iterator()))
  println(drained(CountdownIterator(5)))

  val it = [1, 2, 3, 4].iterator()
  for x in it
    if x == 2 then break
    print(x)
  for x in it do print(x)
  println()

  var odd = ""
  for x in Countdown(6)
    if x % 2 == 0 then continue
    odd = s"$odd$x"
  println(odd)

  var later: Buffer[() -> int] = Buffer()
  for x in Countdown(3) do later.append(() -> x * 10)
  for f in later do print(s"${f()} ")
  println()

  for x in [1, 2] do print(x)
  for x in List(3, 4) do print(x)
  for x in Set(5) do print(x)
  for (k, v) in {"k": 6} do print(s"$k$v")
  for x in Array.tabulate(2, i -> i + 7) do print(x)
  for x in 9 .. 9 do print(x)
  val r = 1 ..< 3
  for x in r do print(x)
  val low: long = 1
  for x in low .. 2 do print(x)
  val buffered: Buffer[int] = Buffer()
  buffered.append(1)
  buffered.append(2)
  for x in buffered do print(x)
  for x in [3, 4].toLazyList() do print(x)
  for x in [5, 6].view().map(y -> y + 1) do print(x)
  println()
  for x in pick(true) do print(x)
  for x in pick(false) do print(x)
  println()

  val ch = Channel[int](capacity = 2)
  ch.send(1)
  ch.send(2)
  ch.close()
  for x in ch do print(x)
  println()
