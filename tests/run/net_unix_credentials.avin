// expect: exit 0
// A Unix connection's `peerCredentials` are the user, group and process id of the program at the
// other end, as the system vouches for them: here this program at both ends, so both answer its own
// ids, and the same again when asked twice. A closed or split connection answers an error. A Unix
// listener takes a backlog, `bind`'s and `bindReplacing`'s, and accepts with it.
import avin.fs
import avin.io.IoError
import avin.net.{PeerCredentials, UnixListener, UnixStream}
import avin.process
import avin.threads.spawn

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

// Whether `c` is this program, as a peer.
isSelf(c: PeerCredentials) -> bool =
  c.user == process.userId() && c.group == process.groupId() && c.process == Some(process.pid())

main()
  val dir = ok(fs.createTempDir("avc"))
  val sock = dir + "/s"
  val l = ok(UnixListener.bind(sock, backlog = 1))
  val accepting = spawn(() -> ok(l.accept()))
  val c = ok(UnixStream.connect(sock))
  val s = accepting.join()
  val mine = ok(c.peerCredentials())
  val theirs = ok(s.peerCredentials())
  println("the server's end is this program", isSelf(mine))
  println("the client's end is this program", isSelf(theirs))
  println("asked again, the same", ok(c.peerCredentials()) == mine, ok(s.peerCredentials()) == theirs)
  println("ids are not negative", mine.user >= 0, mine.group >= 0)

  // The connection still carries bytes after its credentials are read.
  ok(c.writeText("after\n"))
  println("arrived", ok(s.readLine()))

  ok(c.close())
  println("closed", c.peerCredentials().isErr)
  c.peerCredentials() match
    Err(e) -> println(e.operation, e.message.endsWith(": the connection is closed"))
    Ok(_) -> ()
  val (reader, writer) = s.split()
  println("split", s.peerCredentials().isErr)
  _ = reader.close()
  _ = writer.close()
  ok(l.close())

  // `bindReplacing` takes the left socket file's path with its own backlog.
  val again = ok(UnixListener.bindReplacing(sock, backlog = 2))
  val next = spawn(() -> ok(again.accept()))
  val d = ok(UnixStream.connect(sock))
  val t = next.join()
  println("replaced, and accepting", isSelf(ok(t.peerCredentials())))
  ok(d.close())
  ok(t.close())
  ok(again.close())
  ok(fs.remove(sock))
  ok(fs.removeDir(dir))
