// expect: exit 0
// A log of JSON lines: one compact value appended per line, the file read back and each line parsed,
// a damaged line reported with its own line and column, and the events filtered by a field.
import avin.json
import avin.json.Json
import avin.fs

main()
    val dir = fs.createTempDir("json-lines").ok.get
    val log = dir + "/events.jsonl"
    for i in 0..<5
        val event = Json.obj(("event", Json.str(if i % 2 == 0 then "started" else "finished")), ("id", Json.num(i)), ("cmd", Json.str("say \"hi\"\n é")))
        fs.appendText(log, event.render + "\n")
    fs.appendText(log, "{\"event\": \"finished\", \"id\": }\n")
    val lines = fs.readText(log).ok.get.lines
    for (line, n) in lines.zipWithIndex
        json.parse(line) match
            Ok(j) -> println(s"${n + 1}: ${j("event").asString.get} ${j("id")} ${j("cmd").asString.get.charCount}")
            Err(e) -> println(s"${n + 1}: $e")
    val finished = lines.map(l -> json.parse(l)).filter(r -> r.isOk).map(r -> r.ok.get).filter(j -> j.get("event") == Some(Json.str("finished")))
    println(finished.map(j -> j("id").asInt.get))
    fs.removeDirAll(dir)
