// expect: exit 0
// Repeated parameters in the other places a parameter list is written: clauses, local functions,
// an object's methods and a generic class's, with literals and lambdas as elements, a sequence of a
// type parameter spliced, and overloads told apart by their element types.

// A repeated parameter is matched by the clauses as the vector it is.
described(xs: int*) -> string
described([]) = "none"
described([x]) = s"just $x"
described(_) = "several"

object Numbers
    sum(xs: int*) -> int
        var total = 0
        for x in xs do total += x
        total

class Stack[T]
    var items: Vector[T] = []
    push(xs: T*) -> Stack[T]
        items = items ++ xs
        self

wide(xs: long*) -> long
    var total: long = 0
    for x in xs do total += x
    total

applied(n: int, fs: ((int) -> int)*) -> int
    var out = n
    for f in fs do out = f(out)
    out

counted[T](items: T*) -> int = items.length()

forwarded[T](xs: Iterable[T]) -> int = counted(xs*)

kind(xs: int*) -> string = "ints"
kind(xs: string*) -> string = "strings"

starting(first: int, rest: int*) -> string = s"$first then ${rest.length()}"

main()
    print(described())
    print(described(7))
    print(described(1, 2))

    // a local function
    product(xs: int*) -> int
        var out = 1
        for x in xs do out *= x
        out
    print(product(2, 3, 4))

    print(Numbers.sum(1, 2, 3))
    print(Stack[string]().push("a", "b").push().push("c").items)

    // literals take the element type, and lambdas their parameter types from it
    print(wide(3000000000, 1))
    print(applied(1, x -> x + 1, x -> x * 10))

    // a sequence of a type parameter, spliced; the element type inferred from a spliced list
    val l: List[string] = ["p", "q"]
    print(forwarded(l))
    print(counted(l*))

    print(kind(1, 2))
    print(kind("a"))

    // a named argument before a repeated parameter left empty
    print(starting(first = 5))
