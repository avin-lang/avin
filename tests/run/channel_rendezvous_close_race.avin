// expect: exit 0
// Closing a channel of capacity zero while threads wait on it, over and over: every value a send
// handed over is received exactly once, every receiver waiting when the close comes wakes to `None`,
// plain, timed or in a select, and a receive after the close never finds a value, since a closed one
// hands nothing over.
import avin.threads.{Atomic, Channel, spawn}
import avin.time.seconds

main() -> int
  var allCounted = true
  var allSummed = true
  var allClosed = true
  for round in 0 ..< 40
    val ch = Channel[int](0)
    val n = 50 + round
    val count = Atomic(0)
    val sum = Atomic(long(0))
    val closedSeen = Atomic(0)
    val plain = Vector.tabulate(2, _ -> spawn(() ->
      for x in ch
        count.add(1)
        sum.add(long(x))
      closedSeen.add(1)))
    val timed = spawn(() ->
      var going = true
      while going
        ch.receive(seconds(30)) match
          Some(x) ->
            count.add(1)
            sum.add(long(x))
          None -> going = false
      closedSeen.add(1))
    val selecting = spawn(() ->
      var going = true
      while going
        select
          ch.receive() as Some(x) ->
            count.add(1)
            sum.add(long(x))
          ch.receive() as None -> going = false
      closedSeen.add(1))
    for i in 1 .. n do ch.send(i)
    ch.close()
    plain.foreach(t -> t.join())
    timed.join()
    selecting.join()
    if count.load() != n then allCounted = false
    if sum.load() != long(n) * long(n + 1) / 2 then allSummed = false
    if closedSeen.load() != 4 || ch.receive().isDefined || ch.tryReceive().isDefined then allClosed = false
  println(allCounted, allSummed, allClosed)
  0
