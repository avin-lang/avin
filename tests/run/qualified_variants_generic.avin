// expect: exit 0
// The qualified form of a generic type's variants infers its type arguments as the bare form does,
// from the arguments and from the expected type; they may also be written, once, on the type or on
// the variant. A type's companion keeps its members beside its variants, a capitalized one
// included, and a local, a parameter or a field of the type's name hides the type, so
// `Name.member` is then the value's.

data Box[T]
    Full(value: T)
    Vacant

data Point(x: int, y: int)

object Point
    val Unit = Point.Point(1, 1)
    origin() -> Point = Point.Point(0, 0)
    describe(p: Point) -> string = s"<${p.x}, ${p.y}>"

data Token
    Token

impl Token
    label() -> string = "token"

data Palette(Red: int, Blue: int)

hidden(Color: Palette) -> int = Color.Red + Color.Blue

class Easel(Color: Palette)
    total() -> int = Color.Red * 10 + Color.Blue

data Color
    Red
    Blue

unwrap[T](b: Box[T], fallback: T) -> T = b match
    Box.Full(v) -> v
    Box.Vacant -> fallback

firstOk(results: List[Result[int, string]]) -> Option[int] = results match
    Result.Ok(v) :: _ -> Option.Some(v)
    Result.Err(_) :: rest -> firstOk(rest)
    List.Nil -> Option.None

main()
    // Inferred from the arguments.
    println(Option.Some(1))
    println(Option.Some("one"))
    println(Box.Full(2.5))
    // Inferred from the expected type.
    val none: Option[int] = Option.None
    println(none)
    val wide: Option[long] = Option.Some(7)
    println(wide)
    val empty: Box[string] = Box.Vacant
    println(unwrap(empty, "fallback"))
    println(unwrap(Box.Full("kept"), "fallback"))
    // Written on the type or on the variant.
    println(Option[int].None)
    println(Option[string].Some("s"))
    println(Option.Some[long](9))
    println(Box[int].Vacant == Box.Vacant)
    // The core library's types: Result, Either, List.
    println(firstOk([Result.Err("a"), Result.Ok(3), Result.Ok(4)]))
    println(firstOk([Result.Err("a")]))
    println(Either.Left(1) == Left(1))
    val ints = List.Cons(1, List.Cons(2, List.Nil))
    println(ints)
    println(ints.length)
    // A one-variant type: its variant has the type's name; the companion's members stay.
    println(Point.Point(1, 2) == Point(1, 2))
    println(Point.origin())
    println(Point.Unit)
    println(Point.describe(Point.Point(3, 4)))
    // A one-variant type with no fields: the type's methods on its value, and its variant.
    println(Token.label())
    println(Token.Token == Token)
    // A parameter named as the type hides it: `Color.Red` is the parameter's field.
    println(hidden(Palette(1, 2)))
    println(Easel(Palette(3, 4)).total())
    if true
        val Color = Palette(5, 6)
        println(Color.Red)
    println(Color.Red == Red)
    // Nested generic constructions.
    val nested = Option.Some(Box.Full(Option.Some(Color.Blue)))
    println(nested)
    nested match
        Option.Some(Box.Full(Option.Some(Color.Blue))) -> println("deep blue")
        Option.Some(Box.Full(Option.Some(Color.Red))) -> println("deep red")
        Option.Some(Box.Full(Option.None)) -> println("deep none")
        Option.Some(Box.Vacant) -> println("vacant")
        Option.None -> println("none")
