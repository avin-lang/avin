// A hook registered while the hooks run is run too, at once after the hook that registered it and
// before the hooks registered earlier; one registered and then cancelled inside a hook does not run.
import avin.process

main()
  process.onExit(() -> println("oldest"))
  process.onExit(() ->
    println("outer")
    process.onExit(() ->
      println("inner")
      process.onExit(() -> println("innermost")))
    val h = process.onExit(() -> println("cancelled"))
    println(s"cancel: ${h.cancel()}"))
  println("main ends")
