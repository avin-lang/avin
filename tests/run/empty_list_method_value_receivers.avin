// expect: exit 0
// The receivers the empty-list error writes out are each legal where a function type is expected:
// `self` and a parameter of a type parameter's type as a function result, a captured local inside a
// lambda, a placeholder in a `map` whose result is annotated, and a constructor call, an `Option`,
// a field and an element read by index as arguments to a parameter of function type.

class Counter(var n: int)
    bump() -> int
        n = n + 1
        n
    total() -> int = n
    totaller() -> () -> int = self.total

class Pair(val left: Counter, val right: Counter)

iteratorOf[T: Iterable[int]](t: T) -> () -> Iterator[int] = t.iterator
apply[A](f: () -> A) -> A = f()

main()
    val c = Counter(4)
    println(c.totaller()())
    println(iteratorOf([7, 8])().next())
    val later: Vector[() -> int] = [1, 2].map(_ -> c.bump)
    println(later.map(f -> f()))
    val cs = [Counter(1), Counter(2)]
    val totals: Vector[() -> int] = cs.map(_.total)
    println(totals.map(f -> f()))
    println(apply(Counter(9).total))
    println(apply(Some(3).iterator).next())
    val p = Pair(Counter(5), Counter(6))
    println(apply(p.right.total), apply(cs(1).bump), cs(1).n)
