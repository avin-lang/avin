// expect: exit 0
// `BigInt` as a number, an ordered value and a key: generic code over `Numeric`, `Add`, `Mul` and
// `Ord` takes it, `BigInt.zero()` and `BigInt.one()` are its identities beside its companion's
// `apply`, equal values are equal and hash alike however they were made, it keys hash and tree
// maps, sorts, and `gcd`, `lcm`, `abs` and `sign` agree with `long`'s; threads share one.
import avin.threads.spawn

total[T: Add](xs: Vector[T]) -> T
    var t = T.zero()
    for x in xs do t = t + x
    t

square[T: Numeric](x: T) -> T = x * x

largest[T: Ord](xs: Vector[T]) -> T
    var best = xs(0)
    for x in xs do if x > best then best = x
    best

main()
    val xs = [BigInt(3), BigInt("-100000000000000000000000"), BigInt(0), BigInt("99999999999999999999"), BigInt(-1)]
    println(total(xs))
    println(xs.sum)
    println(xs.filter(!_.isZero).product)
    println(xs.average)
    println(square(BigInt("-12345678901234567890")))
    println(largest(xs))
    println(xs.max)
    println(xs.min)
    println(xs.sorted)
    println(xs.sortedDescending)
    println(BigInt.zero())
    println(BigInt.one())
    val z: () -> BigInt = BigInt.zero
    println(z())
    println(BigInt(1) < BigInt(2) < BigInt("100000000000000000000"))
    println(BigInt(-1) > BigInt("-100000000000000000000"))
    println(BigInt(5) <= BigInt(5))
    println(BigInt(5) >= BigInt(6))
    println(BigInt(5).compare(BigInt(-5)))
    println(BigInt(-5).compare(BigInt(-6)))
    println(BigInt("-0").compare(BigInt(0)))
    // Equal however made, so equal hashes: a key of a hash map and a member of a set.
    val a = BigInt("123456789012345678901234567890")
    val b = BigInt("1234567890123456789012345678900") / BigInt(10)
    println(a == b)
    println(a.hash() == b.hash())
    println(a != -a)
    println(a.hash() != (-a).hash())
    println(BigInt(0).hash() == (-BigInt(0)).hash())
    var counts = HashMap[BigInt, int]()
    for i in 0 ..< 10
        val key = BigInt(i % 3).pow(70)
        counts = counts.updated(key, counts.get(key).getOrElse(0) + 1)
    println(counts.get(BigInt(2).pow(70)))
    println(counts.get(BigInt(0)))
    println(counts.size)
    println(Set(a, b, BigInt(1), BigInt("1")).size)
    println(TreeSet(BigInt(3), BigInt(-2), BigInt("10000000000000000000000")))
    // `gcd`, `lcm`, `abs` and `sign` agree with `long`'s.
    val ns: Vector[long] = [0, 1, -1, 12, -18, 1000000007, 999999999999, -600851475143]
    var agree = true
    for x in ns
        for y in ns
            if BigInt(x).gcd(BigInt(y)) != BigInt(x.gcd(y)) then agree = false
            if (x.abs < 2000000 || y.abs < 2000000) && BigInt(x).lcm(BigInt(y)) != BigInt(x.lcm(y)) then agree = false
        if BigInt(x).abs != BigInt(x.abs) || BigInt(x).sign != x.sign then agree = false
    println(agree)
    println(BigInt(2).pow(100).gcd(BigInt(6).pow(40)))
    println(BigInt(2).pow(100).lcm(BigInt(3).pow(20)))
    println(BigInt(0).gcd(BigInt(0)))
    println(BigInt(0).lcm(BigInt(5)))
    println(BigInt(long.MinValue).gcd(BigInt(0)))
    // An immutable value, so it is sendable: threads share one and hand results back.
    val shared = BigInt(3).pow(200)
    val workers = (1 .. 4).map(k -> spawn(() -> shared * BigInt(k)))
    println(workers.map(w -> w.join()).sum == shared * BigInt(10))
