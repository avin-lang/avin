// Integer widths from one bit to 257: the wrapping and saturating operators at each width's most
// negative and most positive value, conversions that keep the low bits, and the update operators on
// a narrow variable.

identity[T](value: T) -> T = value

edges1(low: i1, high: i1)
    print(low, high, low -% high == low, high +% low == low, low +% low == high, ~low == high)
    print(low *% low == low, low +| low == low, high -| low == high, low < high)

edges5(low: i5, high: i5)
    print(low, high, low -% 1 == high, high +% 1 == low, high +| 1 == high, low -| 1 == low)
    print(low *% -1 == low, low *| -1 == high, ~low == high, low % -1 == 0)

edges17(low: i17, high: i17)
    print(low, high, low -% 1 == high, high +% 1 == low, high +| 1 == high, low -| 1 == low)
    print(low *% -1 == low, low *| -1 == high, ~low == high, low % -1 == 0)

edges65(low: i65, high: i65)
    print(low, high, low -% 1 == high, high +% 1 == low, high +| 1 == high, low -| 1 == low)
    print(low *% -1 == low, low *| -1 == high, ~low == high, low % -1 == 0)

edges257(low: i257, high: i257)
    print(low, high, low -% 1 == high, high +% 1 == low, high +| 1 == high, low -| 1 == low)
    print(low *% -1 == low, low *| -1 == high, ~low == high, low % -1 == 0)

divide(a: i257, b: i257) = print(a / b, a % b)

main()
    edges1(-1, 0)
    edges5(-16, 15)
    edges17(-65536, 65535)
    edges65(-18446744073709551616, 18446744073709551615)
    edges257(-115792089237316195423570985008687907853269984665640564039457584007913129639936, 115792089237316195423570985008687907853269984665640564039457584007913129639935)

    // Division truncates toward zero at any width, and the remainder takes the dividend's sign.
    divide(-7, 3)
    divide(7, -3)
    divide(-7, -3)
    divide(18446744073709551616, -3)
    divide(-115792089237316195423570985008687907853269984665640564039457584007913129639936, 2)
    divide(-115792089237316195423570985008687907853269984665640564039457584007913129639936, -2)

    // Updates and conversions on narrow and wide values.
    var n: i8 = 100
    n +%= 100
    print(n)
    n -%= 1
    print(n)
    val wide: i257 = -18446744073709551616
    print(wide)
    print(i8(300), i64(n), i257(n), int(wide), i1(-1), i8(i1(-1)))
    print(identity(wide), debug(wide), 0 < n <= 127)
    print(0 > n >= -128)
