// expect: trap
// A cancelled thread has no result, so `join` on it traps; `result` is the way to ask.
import avin.threads.{scope, sleep}
import avin.time.hours

main()
    val t = scope(s ->
        val t = s.spawn(() ->
            sleep(hours(1))
            1)
        s.cancel()
        t)
    println(t.result())
    println(t.join())
