// expect: trap
// A map runs the key's own `hash`, which enters the core library again, before it finds no key: the
// trap still reports the program's read of the map, not the call inside `hash`.

data Key(name: string)

impl Eq for Key
  equals(other: Key) -> bool = name == other.name

impl Hash for Key
  hash() -> long = Some(name).getOrElse("").hash()

main()
  val m = Map[Key, int]().updated(Key("a"), 1)
  println(s"${m(Key("a"))}")
  println(s"${m(Key("b"))}")
