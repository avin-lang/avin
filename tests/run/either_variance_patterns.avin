// expect: exit 0
// Either is covariant in both sides, so an `Either[Cat, Dog]` is an `Either[Animal, Animal]`, whose
// methods then take and give `Animal`s. Left and Right are patterns, nested and guarded; a match on
// both covers every value. Eithers compare and hash by side and value, so they are keys of a set.

open class Animal(val name: string)
class Cat(n: string): Animal(n)
class Dog(n: string): Animal(n)

named(e: Either[Animal, Animal]) -> string = e.merge().name

describe(e: Either[string, Option[int]]) -> string = e match
    Left("") -> "empty reason"
    Left(why) -> s"failed: $why"
    Right(Some(n)) if n < 0 -> s"negative $n"
    Right(Some(n)) -> s"value $n"
    Right(None) -> "nothing"

main()
    val cat: Either[Cat, Dog] = Left(Cat("Tom"))
    val dog: Either[Cat, Dog] = Right(Dog("Rex"))
    println(s"${named(cat)} ${named(dog)}")
    val animals: Either[Animal, Animal] = dog
    println(animals.getOrElse(Cat("Felix")).name)
    val stray: Either[Animal, Animal] = cat
    println(stray.getOrElse(Cat("Felix")).name)
    println(stray.orElse(Right(Cat("Felix"))).merge().name)
    println(stray.swap().map(a -> a.name).getOrElse("none"))
    val pets: Vector[Either[Cat, Dog]] = [cat, dog]
    val seen: Vector[Either[Animal, Animal]] = pets
    println(seen.map(e -> e.fold(c -> s"cat ${c.name}", d -> s"dog ${d.name}")))

    println(describe(Left("")))
    println(describe(Left("timeout")))
    println(describe(Right(Some(-1))))
    println(describe(Right(Some(3))))
    println(describe(Right(None)))

    val e: Either[int, string] = Right("x")
    if e is Right(s) then println(s"is $s")
    if !(e is Left(_)) then println("not left")

    val keys: Set[Either[int, string]] = Set(Left(1), Right("1"), Left(1), Right("1"), Right("2"))
    println(keys.size)
    println(s"${keys.contains(Left(1))} ${keys.contains(Right("2"))} ${keys.contains(Left(2))}")
    val m: Map[Either[int, bool], string] = Map((Left(1), "one"), (Right(true), "yes"))
    println(s"${m.get(Left(1))} ${m.get(Right(true))} ${m.get(Right(false))}")
    val one: Either[int, int] = Left(1)
    println(s"${one == Right(1)} ${one == Left(1)} ${one != Left(2)}")
