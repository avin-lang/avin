// expect: exit 0
// env: AVIN_GC_STRESS=0
// Two threads hand a number back and forth over two channels a hundred thousand times, each waiting
// for the other at every turn: a wait parks its thread and a send wakes the other, so the round trips
// cost no operating system thread a wait. Then the main thread plays one side itself.
import avin.threads.{Channel, spawn}

rally(rounds: int, ping: Channel[int], pong: Channel[int]) -> int
  var last = 0
  for _ in 0 ..< rounds
    ping.send(last + 1)
    last = pong.receive().getOrElse(-1)
  last

echo(ping: Channel[int], pong: Channel[int])
  for n in ping do pong.send(n + 1)

main() -> int
  val rounds = 100000
  val ping = Channel[int]()
  val pong = Channel[int]()
  val echoer = spawn(() -> echo(ping, pong))
  val player = spawn(() -> rally(rounds, ping, pong))
  println(player.join())
  val mine = rally(1000, ping, pong)
  println(mine)
  ping.close()
  echoer.join()
  val one = Channel[int](1)
  val other = Channel[int](1)
  val bounded = spawn(() -> echo(one, other))
  println(rally(rounds, one, other))
  one.close()
  bounded.join()
  0
