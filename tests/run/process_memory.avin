// The memory the machine has and the memory a process holds: `totalMemory` is positive and more
// than the program holds; `residentBytes` reads the program itself, a running child (by its pid and
// through its `Child`), and answers `Err(NotFound)` for a child already waited for, for a pid no
// process can have and for one past the largest process id. The process 1 belongs to the system:
// macOS refuses a program another user's process, `Err(PermissionDenied)`, and Linux answers its
// size; either way it is no other error.
import avin.io.{IoError, NotFound, PermissionDenied}
import avin.process
import avin.process.{Child, Command}
import avin.time.Duration

started(c: Command) -> Child = c.start() match
  Ok(child) -> child
  Err(e) -> fail(s"not started: $e")

main()
  val total = process.totalMemory()
  println(total.map(t -> t > 0))
  println(total == process.totalMemory())
  // Ten mebibytes, touched, are held by the program, and the machine has more than it holds.
  val held = Array.fill(10485760, byte(1))
  val own = process.residentBytes(process.pid())
  println(own.map(b -> b > 10485760))
  println(own.map(b -> b < total.ok.get))
  // A running child, by its pid and through its `Child`.
  val child = started(Command("/bin/sleep", "30"))
  println(process.residentBytes(child.pid()).map(b -> b > 0))
  println(child.residentBytes().map(b -> b > 0))
  child.kill()
  println(child.waitFor())
  // Once waited for, the child is gone.
  println(child.residentBytes().mapErr(e -> e.kind))
  println(process.residentBytes(child.pid()).mapErr(e -> e.kind))
  println(
    child.residentBytes().err.get.message
      == s"cannot read the memory of process ${child.pid()}: no such file or directory"
  )
  // A command with no program started is not there either.
  val late = started(Command("/bin/sleep", "1").withTimeout(Duration.Zero))
  println(late.waitFor().isOk)
  println(late.residentBytes())
  // Pids that name no process.
  println(process.residentBytes(0))
  println(process.residentBytes(-1))
  println(process.residentBytes(-9223372036854775807 - 1))
  println(process.residentBytes(2147483647))
  println(process.residentBytes(2147483648))
  println(process.residentBytes(9223372036854775807))
  // The system's first process: refused on macOS, read on Linux.
  println(process.residentBytes(1) match
    Ok(b) -> process.os() == process.Linux && b > 0
    Err(IoError(PermissionDenied, _, _)) -> process.os() == process.MacOS
    Err(_) -> false)
  println(held.length)
