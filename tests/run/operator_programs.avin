// Operator families in whole programs: comparison chains that evaluate each operand once and stop
// early, bitwise operators and their precedence, wrapping and saturating arithmetic at the edges of
// `int`, and shifts by counts at and beyond the width.

bump(n: int) -> int
    print(n)
    n

shift(n: int, k: int) = print(n << k, n >> k)

chain(a: int, b: int, c: int)
    print(a < b < c, a <= b <= c, a > b >= c, a == b != c, a != b == c, a <= b > c)

main()
    // Comparison chains.
    print(1 < 2 < 3, 3 > 2 >= 2, 1 == 1 != 2 <= 3)
    print(true == true != false, false == true == false)
    print(0 < bump(5) < 10)
    print(9 < bump(5) < bump(6))
    print(2 < 1 < (1 / 0))
    print((1 < 2) == true, (1 < 2 < 3) && (4 > 3 > 2))
    for a in -1..1
        for b in -1..1
            for c in -1..1
                chain(a, b, c)

    // Bitwise operators: `&` binds tightest, then `^`, then `|`; shifts bind like `*`.
    print(12 & 5, 12 | 5, 12 ^ 5, ~0, ~42)
    print(12 & 4 == 4, 1 + 2 << 3, 1 | 2 ^ 3 & 4)

    // Wrapping and saturating arithmetic at the edges.
    print(2147483647 +% 1, -2147483648 -% 1, 1073741824 *% 4)
    print(2147483647 +| 1, -2147483648 -| 1, -2147483648 +| -1, 2147483647 -| -1, 5 +| 7, 5 -| 7)
    print(1073741824 *| 4, -1073741824 *| 4, -2147483648 *| -1, -2147483648 *| 1, -2147483648 *| 0, -5 *| -7)

    // A shift by the width or more shifts everything out; a negative count does too.
    shift(-8, 2)
    shift(-8, 31)
    shift(-8, 32)
    shift(8, 40)
    shift(-8, -1)

    // Each compound family on one variable.
    var n = 6
    n *= 7
    n /= 2
    n %= 20
    n <<= 3
    n |= 2
    n ^= 3
    n &= 15
    n >>= 1
    print(n)
    var edge = 2147483647
    edge +|= 1
    print(edge)
    edge +%= 1
    print(edge)
    edge -|= 1
    print(edge)
    edge -%= 1
    print(edge)

    // Assignments are expressions in their yielding forms.
    var m = 1
    print(m := 42, m)
    print(m +:= 1, m)
    print(m++, m, ++m, m)
