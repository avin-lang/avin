// `print` writes a value's `Display` form with no new line, so several calls share a line;
// `print()` writes nothing and `println()` writes a bare new line.
// expect: exit 0
main()
  print("a")
  print("b")
  print(1)
  print(2.5)
  print(true)
  println()
  print()
  println("after empty print")
  println()
  println()
  print("no newline at all")
  print()
  println()
  print("line one\nline two\n")
  print("tail\n")
  print("embedded ")
  println("newline\nin the middle")
  print(s"interpolated ${1 + 2}, ")
  println('c')
