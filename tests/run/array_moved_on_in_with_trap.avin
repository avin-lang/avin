// expect: trap
// A `with` that moves its array on into a second `Isolated` leaves the first holding an array that
// is no longer its to give: the second hands it out to this thread, and what the first then gives
// another thread traps at that thread's use. On the thread that took it from the second, the array
// is that thread's, whichever reference it is used through.
import avin.actors.Isolated
import avin.threads.spawn

main()
  val first = Isolated.move(Array.fill[int](2, 5))
  val second = first.with(a -> Isolated.move(a))
  val mine = second.take()
  println(mine(0))
  val t = spawn(() ->
    val stale = first.take()
    stale(0))
  println(t.join())
