// expect: exit 0
// The errors chapter's values meeting their neighbours: an Option of an Option, `?` on nested
// options and inside a generic function, Either equality, hashing and display by side and value,
// `Either.cond` evaluating only its chosen side, a module-level `None` used as a typed option,
// `Left(1)` as an instance of any `Either[int, R]`, and `fail` standing where values are expected.

val none = None

pick(o: Option[int]) -> int = o.getOrElse(-1)

firstOf[T](xs: List[Option[T]]) -> Option[T] = xs.headOption?

nestedTwice(o: Option[Option[int]]) -> Option[int] = Some((o?)? + 1)

asEither(n: int) -> Either[int, string] = if n > 0 then Left(n) else Right("zero")

counted(log: Buffer[string], s: string) -> string
    log.append(s)
    s

total(xs: List[Option[int]]) -> Option[int]
    var sum = 0
    for x in xs do sum += x?
    Some(sum)

main()
    println(pick(none))
    val oo: Option[Option[int]] = Some(Some(3))
    println(oo.flatten())
    println(Some(None).flatten() == None)
    println(nestedTwice(oo))
    println(nestedTwice(Some(None)))
    println(nestedTwice(None))
    println(firstOf(List(Some("a"), None)))
    println(firstOf(List(None, Some("b"))))
    println(total(List(Some(1), Some(2), Some(3))))
    println(total(List(Some(1), None, Some(3))))
    println(total(List()))

    val l: Either[int, string] = Left(1)
    println(l == asEither(1))
    println(l != asEither(2))
    println(Right("zero") == asEither(0))
    println(l.hash() == asEither(1).hash())
    println(asEither(0))
    println(asEither(5))
    println(debug(Left("no")))
    println(debug(Right(Some(4))))
    val nested: Either[Either[int, string], string] = Left(Right("in"))
    println(nested)
    println(nested.joinLeft())

    val log = Buffer[string]()
    val yes = Either.cond(true, counted(log, "right"), counted(log, "left"))
    val no = Either.cond(false, counted(log, "right"), counted(log, "left"))
    println(s"$yes $no ${log.mkString(",")}")

    val e: Either[int, Either[int, string]] = Right(Left(7))
    println(e.joinRight())
    val same: Either[string, string] = if log.length > 1 then Left("l") else Right("r")
    println(same.merge())

    val n: int = if log.length == 2 then 9 else fail("not reached")
    println(n)
    val o: Option[string] = if n == 9 then Some("nine") else fail("not reached")
    println(o.toRight(fail("not evaluated")))
    println(none.toLeft(4))
