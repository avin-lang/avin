// expect: exit 0
// Declared variance: an instance of a generic type is an instance of another where each type
// argument follows its parameter's variance. A covariant `List[Dog]` is a `List[Animal]` with no
// conversion, since both are references to the same objects; calls on the elements still reach the
// overrides of their own classes. Function types take wider parameters and yield narrower results.

open class Animal(val name: string)
    sound() -> string = "..."
    describe() -> string = s"$name says ${sound()}"

class Dog(name: string) : Animal(name)
    override sound() -> string = "woof"

class Cat(name: string) : Animal(name)
    override sound() -> string = "meow"

data List[+T]
    Cons(head: T, tail: List[T])
    Nil

data Option[+T]
    Some(value: T)
    None

describeAll(xs: List[Animal]) -> int = xs match
    Cons(a, rest) ->
        println(a.describe())
        1 + describeAll(rest)
    Nil -> 0

firstName(o: Option[List[Animal]]) -> string = o match
    Some(Cons(a, _)) -> a.name
    _ -> "none"

// A covariant trait: values are read out of it.
trait Source[+T]
    next() -> T
    peek() -> Option[T] = Some(next())

class Kennel(val dog: Dog) : Source[Dog]
    var count = 0
    override next() -> Dog
        count++
        dog

drain(s: Source[Animal]) -> string = s.next().describe()

// A contravariant trait: values are passed into it.
trait Sink[-T]
    put(x: T) -> int

class Counter() : Sink[Animal]
    var seen = 0
    override put(x: Animal) -> int
        seen++
        if x.name == "bo" then 2 else 1

feedDog(s: Sink[Dog], d: Dog) -> int = s.put(d)

// A covariant class holding a value and handing out views of it.
class Crate[+T](val item: T)
    get() -> T = item
    wrap() -> Option[T] = Some(item)

loudest(c: Crate[Animal]) -> string = c.get().sound()

measure(f: (Dog) -> int, d: Dog) -> int = f(d)

adopt(make: () -> Animal) -> string = make().describe()

main() -> int
    val dogs: List[Dog] = Cons(Dog("rex"), Cons(Dog("fido"), Nil))
    if describeAll(dogs) != 2 then return 1
    val mixed: List[Animal] = Cons(Cat("tom"), dogs)
    if describeAll(mixed) != 3 then return 2
    val nested: Option[List[Dog]] = Some(dogs)
    if firstName(nested) != "rex" then return 3
    val kennel = Kennel(Dog("max"))
    println(drain(kennel))
    val s: Source[Animal] = kennel
    s.peek() match
        Some(a) -> println(a.describe())
        None -> return 4
    if kennel.count != 2 then return 5
    val counter = Counter()
    if feedDog(counter, Dog("bo")) != 2 then return 6
    val sink: Sink[Dog] = counter
    sink.put(Dog("buddy"))
    if counter.seen != 2 then return 7
    val crate: Crate[Dog] = Crate(Dog("lassie"))
    println(loudest(crate))
    val wide: Crate[Animal] = crate
    wide.wrap() match
        Some(a) -> println(a.describe())
        None -> return 8
    val byName: (Animal) -> int = (a) -> if a.name == "spot" then 4 else 0
    if measure(byName, Dog("spot")) != 4 then return 9
    val makeDog: () -> Dog = () -> Dog("pup")
    println(adopt(makeDog))
    // The branches agree on the instance whose argument is their arguments' common superclass.
    val either = if dogs is Nil then Some(Cat("kit")) else Some(Dog("ace"))
    either match
        Some(a) -> println(a.describe())
        None -> return 10
    // A type pattern tests the object's own type: a `List[Dog]` held as `Any` is a `List[Animal]`,
    // and a `List[Animal]` holding a `List[Dog]` is one.
    val held: Any = dogs
    held match
        xs: List[Animal] -> println(s"animals: ${describeAll(xs)}")
        _ -> return 11
    mixed match
        _: List[Dog] -> return 12
        _ -> ()
    val narrowed: List[Animal] = dogs
    narrowed match
        ds: List[Dog] -> println(s"dogs: ${describeAll(ds)}")
        _ -> return 13
    val strings: Any = Cons("a", Nil)
    strings match
        _: List[Any] -> println("strings are objects")
        _ -> return 14
    val ints: Any = Cons(1, Nil)
    ints match
        _: List[Any] -> return 15
        _: List[int] -> println("ints are values")
        _ -> return 16
    0
