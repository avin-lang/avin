// expect: exit 0
// An `exec` that fails answers an `Err` and the program carries on exactly as it was: a path with
// nothing at it and a bare name nothing on the `PATH` answers to are `NotFound`, a file that may not
// be run and a directory are `PermissionDenied`. With an environment of its own, a bare name is
// looked for on that environment's `PATH` alone, so `sh` under a `PATH` that has no `sh` is
// `NotFound` too. After every failure the program's threads, environment and exit hooks are all
// still there, and the hook runs as the program ends.
import avin.fs
import avin.io.IoError
import avin.process
import avin.threads

shown(r: Result[Nothing, IoError]) -> string = r match
  Err(e) -> s"Err($e)"
  Ok(_) -> "succeeded"

main()
  process.onExit(() -> println("the exit hook ran"))
  val dir = fs.createTempDir("avin-exec-missing").ok().get()
  val plain = s"$dir/plain.txt"
  fs.writeText(plain, "#!/bin/sh\necho ran\n")
  println(shown(process.exec("/nonexistent/avin-no-such-program", [])))
  println(shown(process.exec(s"$dir/missing", ["an argument"])))
  println(shown(process.exec("avin-no-such-program-on-path", [])))
  println(shown(process.exec(plain, [])))
  println(shown(process.exec(dir, [])))
  println(shown(process.exec("sh", ["-c", "echo ran"], Map(("PATH", dir)))))
  println(shown(process.exec("avin-no-such-program-on-path", [], Map())))
  println(shown(process.exec(s"$dir/missing", [], process.environment())))
  // Everything is as it was.
  println(process.env("PATH").isDefined())
  println(threads.spawn(() -> 6 * 7).join())
  fs.removeDirAll(dir)
  println("carried on")
