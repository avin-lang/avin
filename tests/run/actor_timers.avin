// expect: exit 0
// Timers: `after(delay, message)` sends the actor `message` once, and `every(interval, message)`
// each time the interval passes, both queued like any other message, so behind what was told
// before. Timers fire in the order they fall due, whatever order they were set in, and a delay of
// zero or less is due at once. `cancel()` stops a timer and drops a message of it that is queued but
// not yet handled: a repeating timer cancelled in the arm handling its third message sends no
// fourth, and one cancelled before it falls due sends nothing, also when another actor, which was
// sent the `Timer`, cancels it. Ending cancels every timer the actor has, and an actor nothing
// refers to goes on running its timers. A generic actor sets timers of its own message type.
// Nothing here measures time: each check is an order or a count.
import avin.actors.{ActorRef, Timer, spawn}
import avin.threads.{Channel, Promise}
import avin.time as time

data Msg
    Late
    Early
    Now
    Zero
    Negative
    Tick(n: int)
    Done
    Cancel(t: Timer, done: Promise[unit])
    Quit

actor Orderer(log: Channel[string]) receives Msg
    self.tell(Now)
    after(time.millis(-5), Negative)
    after(time.Duration.Zero, Zero)
    after(time.millis(300), Late)
    after(time.millis(1), Early)
    receive
        Late ->
            log.send("late")
            stop()
        Early -> log.send("early")
        Now -> log.send("now")
        Zero -> log.send("zero")
        Negative -> log.send("negative")
        _ -> ()

actor Repeater(log: Channel[string]) receives Msg
    var ticks = 0
    val timer = every(time.millis(1), Tick(0))
    receive
        Tick(_) ->
            ticks += 1
            if ticks == 3
                timer.cancel()
                timer.cancel()
                // Long enough for many more ticks, had the timer gone on.
                after(time.millis(25), Done)
        Done ->
            log.send(s"ticks: $ticks")
            stop()
        _ -> ()

actor Canceller(log: Channel[string]) receives Msg
    val never = after(time.hours(1), Tick(1))
    never.cancel()
    val soon = after(time.millis(5), Tick(2))
    soon.cancel()
    after(time.millis(20), Done)
    receive
        Tick(n) -> log.send(s"cancelled timer $n fired")
        Done ->
            log.send("no cancelled timer fired")
            stop()
        _ -> ()

// Hands a timer of its own to another actor, which cancels it, and waits in its body until it has:
// the timer's message, where it fired meanwhile, waits in the mailbox and is dropped.
actor Giver(other: ActorRef[Msg], log: Channel[string]) receives Msg
    val cancelled = Promise[unit]()
    other.tell(Cancel(after(time.millis(1), Tick(3)), cancelled))
    cancelled.future.await()
    after(time.millis(20), Done)
    receive
        Tick(n) -> log.send(s"timer $n fired after another actor cancelled it")
        Done ->
            log.send("the timer another actor cancelled never fired")
            stop()
        _ -> ()

actor Taker receives Msg
    receive
        Cancel(t, done) ->
            t.cancel()
            done.complete(())
        Quit -> stop()
        _ -> ()

// Ends with a repeating and a pending timer; its `stopping` block reports what it saw, and nothing
// arrives afterwards.
actor Ender(log: Channel[string]) receives Msg
    var ticks = 0
    every(time.millis(1), Tick(0))
    after(time.hours(2), Late)
    receive
        Tick(_) ->
            ticks += 1
            if ticks == 4 then stop()
        Late -> log.send("a pending timer fired after the end")
        _ -> ()
    stopping
        log.send(s"ender stopping after $ticks ticks")

// Runs with no reference kept, telling the channel each tick.
actor Unreferenced(log: Channel[string]) receives Msg
    var n = 0
    every(time.millis(1), Tick(0))
    receive
        Tick(_) ->
            n += 1
            log.send(s"unreferenced tick $n")
            if n == 3 then stop()
        _ -> ()

data Clocked[T: Sendable]
    Fire(value: T)
    Stop

actor Delayed[T: Sendable + Display](values: Vector[T], log: Channel[string]) receives Clocked[T]
    var i = 0
    for v in values
        i += 1
        after(time.millis(long(i * 50)), Fire(v))
    var fired = 0
    receive
        Fire(v) ->
            fired += 1
            log.send(s"fired $v")
            if fired == values.length then stop()
        Stop -> stop()

collect(log: Channel[string], n: int) -> Vector[string]
    var lines: Vector[string] = Vector()
    for _ in 0..<n do lines = lines :+ log.receive().get()
    lines

main()
    val log = Channel[string]()
    spawn(Orderer(log)).ended().await()
    println(collect(log, 5))
    spawn(Repeater(log)).ended().await()
    println(log.receive().get())
    spawn(Canceller(log)).ended().await()
    println(log.receive().get())
    val taker = spawn(Taker())
    spawn(Giver(taker, log)).ended().await()
    println(log.receive().get())
    taker.tell(Quit)
    val ender = spawn(Ender(log))
    ender.ended().await()
    println(log.receive().get())
    spawn(Unreferenced(log))
    println(collect(log, 3))
    val d = spawn(Delayed[string](["a", "β", "c"], log))
    d.ended().await()
    println(collect(log, 3))
    val extremes: Vector[long] = [9223372036854775807, -9223372036854775808]
    val numbers = spawn(Delayed[long](extremes, log))
    numbers.ended().await()
    println(collect(log, 2))
    log.close()
    println(s"left in the log: ${log.toVector}")
