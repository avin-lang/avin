// expect: exit 0
// An argument for a `@sendable` function parameter of an overloaded function is made `@sendable`
// whichever way the overload is chosen: a lambda whose result tells overloads apart (by a plain
// result, a `Result`, an `Option`), one using `?` or `return`, a function named as a value, a method
// value, on a top-level function, a companion's method and a class's method, and the chosen function
// may then run it on another thread.
import avin.threads.spawn

class Task(val run: @sendable (string) -> int)

object Task
  of(run: @sendable (string) -> int) -> Task = Task(run)
  of(run: @sendable (string) -> Result[int, int]) -> Task = Task(s -> run(s) match
    Ok(x) -> x
    Err(x) -> -x)
  of(run: @sendable (string) -> Option[int]) -> Task = Task(s -> run(s).getOrElse(0))

pick(f: @sendable (int) -> int) -> int = spawn(() -> f(20)).join()
pick(f: @sendable (int) -> string) -> int = spawn(() -> f(20)).join().byteLength

class Runner(val base: int)
  go(f: @sendable (int) -> int) -> int = spawn(() -> f(base)).join()
  go(f: @sendable (int) -> bool) -> int = if spawn(() -> f(base)).join() then 1 else 0

class Scale(val by: int): Sendable
  times(n: int) -> int = n * by

halve(n: int) -> Result[int, int] = if n % 2 == 0 then Ok(n / 2) else Err(n)

lengthOf(s: string) -> int = s.byteLength

parsed(s: string) -> Result[int, int] = s.toIntOption() match
  Some(n) -> Ok(n)
  None -> Err(1)

describe(n: int) -> string = s"n=$n"

main()
  val words = ["a", "bb"]
  println(Task.of(s -> s.byteLength).run("abc"))
  println(Task.of(s -> Err(s.byteLength)).run("abcd"))
  println(Task.of(s -> Some(s.byteLength + words.length)).run("ab"))
  println(Task.of(s ->
    val n = halve(s.byteLength)?
    if n > 10 then return Err(99)
    Ok(n)).run("abcdef"))
  println(Task.of(s ->
    val n = halve(s.byteLength)?
    Ok(n)).run("abc"))
  println(Task.of(lengthOf).run("hello"))
  println(Task.of(parsed).run("41"))
  println(Task.of(parsed).run("x"))
  println(pick(n -> n + 1))
  println(pick(n -> s"$n!"))
  println(pick(describe))
  println(pick(Scale(3).times))
  println(Runner(5).go(n -> n * n))
  println(Runner(5).go(n -> n > 4))
  println(Runner(5).go(Scale(2).times))
