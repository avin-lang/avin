// expect: exit 0
// A deadline that passes while an idle resource is being checked stops the check, and the resource
// goes back to the pool rather than being destroyed: `validate` here never waits and always answers
// true, so no resource is ever destroyed, however the deadlines fall. Calls whose deadlines pass
// while they wait for the pool, are checking a resource or are using one, many rounds over.
import avin.threads.{Pool, scope, sleep, withDeadline}
import avin.time.{millis, now}

main()
  var destroyed: long = 0
  for round in 0 ..< 60
    val pool = Pool[int, string](() -> Ok(1), maxSize = 4, validate = Some(_ -> true))
    scope(s ->
      val threads = (0 ..< 100).map(i -> s.spawn(() ->
        _ = withDeadline(now() + millis(long(1 + i % 7)), _ -> pool.use(_ -> sleep(millis(2))))))
      threads.foreach(t -> t.join()))
    destroyed += pool.counters().destroyed
    val stats = pool.stats()
    if stats.lent != 0 || stats.waiting != 0 then println(s"round $round left $stats")
    pool.close()
  println(s"destroyed: $destroyed")
