// The methods a `for` with `yield` calls, called directly: `withFilter` on each collection gives a
// view that tests each element as `map`, `flatMap` or `foreach` reaches it, and chains with another
// `withFilter`; `flatMap` takes any `Iterable` from its function; arrays and buffers map to their own
// kind, ranges to vectors, and a map's entries go to its functions as pairs.

main()
    val xs: List[int] = [1, 2, 3, 4, 5, 6]
    val evens = xs.withFilter(x -> x % 2 == 0)
    evens.foreach(x -> println(x))
    println(evens.withFilter(x -> x > 2).map(x -> x * 10))
    println(xs.flatMap(x -> Array.fill(x % 3, x)))

    val v: Vector[string] = ["a", "bb", "ccc"]
    println(v.flatMap(s -> [s, s.toUpper]))
    v.withFilter(s -> s.byteLength > 1).foreach(s -> println(s))

    val a = Array.tabulate(5, i -> i * i)
    println(a.map(x -> x + 1))
    println(a.filter(x -> x % 2 == 0))
    a.foreach(x -> println(x))
    println(a.withFilter(x -> x > 3).flatMap(x -> [x, -x]))

    val b = Buffer[int]()
    b.addAll([3, 1, 2])
    println(b.map(x -> x * 2))
    println(b.withFilter(x -> x != 1).withFilter(x -> x != 2).map(x -> x))
    b.withFilter(x -> x < 3).foreach(x -> println(x))

    val d = Deque[int]()
    d.addAll([5, 6, 7])
    println(d.map(x -> x - 5))
    println(d.flatMap(x -> [x, x]))
    println(d.withFilter(x -> x > 5).withFilter(x -> x < 7).map(x -> x * 2))
    d.withFilter(x -> x != 6).foreach(x -> println(x))

    val r = 1..4
    println(r.map(i -> s"#$i"))
    r.foreach(i -> println(i))
    println(r.withFilter(i -> i % 2 == 1).flatMap(i -> [i, i]))
    (0 ..< 10 by 3).withFilter(i -> i > 0).foreach(i -> println(i))

    val s: Set[int] = Set.empty[int]().incl(1).incl(2).incl(3)
    println(s.flatMap(x -> [x, x * 10]))
    s.withFilter(x -> x == 2).foreach(x -> println(x))

    val m: Map[string, int] = Map.empty[string, int]().updated("a", 1).updated("b", 2)
    println(m.map(e -> (e.1, e.0)))
    println(m.map((k, n) -> (n, k)))
    println(m.flatMap(e -> [(e.0, e.1), (e.0 + e.0, e.1 * 2)]))
    m.withFilter(e -> e.1 > 1).foreach(e -> println(e.0))
    println(m.withFilter(e -> e.1 > 1).flatMap(e -> [(e.1, e.0)]))

    val o: Option[int] = Some(4)
    println(o.withFilter(x -> x > 3).getOrElse(0))
    println(o.withFilter(x -> x > 4).getOrElse(0))
