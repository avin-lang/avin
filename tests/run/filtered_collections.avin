// The methods a `for` with `yield` calls, called directly: `withFilter` on each collection gives a
// view that tests each element as `map`, `flatMap` or `foreach` reaches it, and chains with another
// `withFilter`; `flatMap` takes any `Iterable` from its function; arrays and buffers map to their own
// kind, ranges to vectors, and a map's entries go to its functions as pairs.

main()
    val xs: List[int] = [1, 2, 3, 4, 5, 6]
    val evens = xs.withFilter(x -> x % 2 == 0)
    evens.foreach(x -> print(x))
    print(evens.withFilter(x -> x > 2).map(x -> x * 10))
    print(xs.flatMap(x -> Array.fill(x % 3, x)))

    val v: Vector[string] = ["a", "bb", "ccc"]
    print(v.flatMap(s -> [s, s.toUpper()]))
    v.withFilter(s -> s.byteLength() > 1).foreach(s -> print(s))

    val a = Array.tabulate(5, i -> i * i)
    print(a.map(x -> x + 1))
    print(a.filter(x -> x % 2 == 0))
    a.foreach(x -> print(x))
    print(a.withFilter(x -> x > 3).flatMap(x -> [x, -x]))

    val b = Buffer[int]()
    b.addAll([3, 1, 2])
    print(b.map(x -> x * 2))
    print(b.withFilter(x -> x != 1).withFilter(x -> x != 2).map(x -> x))
    b.withFilter(x -> x < 3).foreach(x -> print(x))

    val r = 1..4
    print(r.map(i -> s"#$i"))
    r.foreach(i -> print(i))
    print(r.withFilter(i -> i % 2 == 1).flatMap(i -> [i, i]))
    (0 ..< 10 by 3).withFilter(i -> i > 0).foreach(i -> print(i))

    val s: Set[int] = Set.empty[int]().added(1).added(2).added(3)
    print(s.flatMap(x -> [x, x * 10]))
    s.withFilter(x -> x == 2).foreach(x -> print(x))

    val m: Map[string, int] = Map.empty[string, int]().updated("a", 1).updated("b", 2)
    print(m.map(e -> (e.1, e.0)))
    print(m.map((k, n) -> (n, k)))
    print(m.flatMap(e -> [(e.0, e.1), (e.0 + e.0, e.1 * 2)]))
    m.withFilter(e -> e.1 > 1).foreach(e -> print(e.0))
    print(m.withFilter(e -> e.1 > 1).flatMap(e -> [(e.1, e.0)]))

    val o: Option[int] = Some(4)
    print(o.withFilter(x -> x > 3).getOrElse(0))
    print(o.withFilter(x -> x > 4).getOrElse(0))
