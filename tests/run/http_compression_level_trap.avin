// expect: trap
// A compression middleware's level runs from 0 to 9, and its limits are at least zero; a level past
// 9 traps where the middleware is made.
import avin.net.http.Compression

main()
  println(Compression(level = 0, minBytes = 0, maxDecodedBytes = 0).level)
  println(Compression(level = 10).level)
