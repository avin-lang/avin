// An impl with bounds of its own adds methods only at the type arguments that meet them: a class's
// and a data type's, a method calling another of the same impl, a bound on the second parameter, a
// subclass inheriting the methods at the arguments it gives its superclass, a bounded type parameter
// reaching them, and a method value taken from one.
data Plain(n: int)

open class Base[T](value: T)
    get() -> T = value

impl[T: Display] Base[T]
    shown() -> string = "<" + value.toString() + ">"
    twice() -> string = shown() + shown()

class Sub[T](v: T): Base[T](v)

class Named(v: string): Base[string](v)

data Pair[A, B](first: A, second: B)

impl[A, B: Ord] Pair[A, B]
    secondBigger(other: B) -> bool = second.compare(other) > 0

shownAll[U: Display](items: List[Base[U]]) -> string
    var text = ""
    for b in items do text = text + b.shown()
    text

main()
    // A type argument that misses the bound leaves the unconditional methods in place.
    print(Base(Plain(1)).get().n)
    print(Base(2).shown())
    print(Sub(7).twice())
    val up: Base[string] = Sub("x")
    print(up.shown())
    print(Named("n").shown())
    print(Pair(Plain(3), 10).secondBigger(4))
    print(Pair("a", Plain(2)).first)
    print(shownAll([Base(1), Sub(2)]))
    val f: () -> string = Sub(true).shown
    print(f())
