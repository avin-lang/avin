// expect: exit 0
// Number literals where a type that takes decimals is expected: a real literal is read from its
// digits exactly, with its separators dropped and its exponent applied, and an integer literal of any
// size and base is a whole number, wherever a type is expected; a type parameter bounded by
// `FromDecimal` and a program's own type take them the same way.

// A program's own type that takes decimals: it keeps the text it was given.
data Spelled(text: string)

impl FromInteger for Spelled
  static fromInteger[N: Integer](n: N) -> Spelled = Spelled(s"integer $n")

impl FromDecimal for Spelled
  static fromDecimal(text: string) -> Spelled = Spelled(s"decimal $text")
  static fromBigInt(n: BigInt) -> Spelled = Spelled(s"big $n")

made[T: FromDecimal](x: T) -> (T, T, T) =
  val half: T = 0.5
  val whole: T = 7
  (x, half, whole)

priced(price: BigDecimal = 9.99, count: BigDecimal = 3) -> BigDecimal = price * count

halve(x: BigDecimal) -> BigDecimal = x * 0.5

pick(cheap: bool) -> BigDecimal = if cheap then 0.99 else 1_999.99

main()
  val price: BigDecimal = 19.99
  println(price)
  println(price.scale)
  val tenth: BigDecimal = 0.1
  val fifth: BigDecimal = 0.2
  println(tenth + fifth == 0.3)
  println(tenth + fifth)
  // Digits past what a `real` holds are kept.
  val many: BigDecimal = 0.12345678901234567890123456789012345678901234567890
  println(many)
  val wide: BigDecimal = 123456789012345678901234567890.000000000000000000001
  println(wide)
  // Signs, separators, exponents and trailing zeros.
  val negative: BigDecimal = -0.5
  println(negative)
  val separated: BigDecimal = 1_000_000.000_001
  println(separated)
  val thousand: BigDecimal = 1e3
  println(thousand)
  println(thousand.scale)
  val small: BigDecimal = 1.5e-3
  println(small)
  val upper: BigDecimal = 2.5E+2
  println(upper)
  val tiny: BigDecimal = 1e-30
  println(tiny)
  val zeros: BigDecimal = 1.500
  println(zeros)
  println(zeros.scale)
  val negZero: BigDecimal = -0.0
  println(negZero)
  println(negZero.sign)
  // Integer literals of any size and base.
  val n: BigDecimal = 42
  println(n)
  println(n.scale)
  val huge: BigDecimal = 123456789012345678901234567890123456789
  println(huge)
  val hex: BigDecimal = 0xff
  println(hex)
  val least: BigDecimal = -9223372036854775808
  println(least)
  // In arguments, defaults, results, branches, collections and operands on either side.
  println(halve(3.3))
  println(priced())
  println(priced(count = 2))
  println(priced(0.01, 100))
  println(pick(true))
  println(pick(false))
  val prices: Vector[BigDecimal] = [1.5, 2.25, 3, -0.75]
  println(prices)
  println(prices.sum)
  val m: Map[string, BigDecimal] = {"a": 0.1, "b": 2}
  println(m)
  val opt: Option[BigDecimal] = Some(2.50)
  println(opt)
  val pair: (BigDecimal, BigDecimal) = (0.5, 2)
  println(pair)
  println(price + 0.01)
  println(0.01 + price)
  println(price - 0.99)
  println(1.5 * price)
  println(price * -2)
  println(price / 0.5)
  println(100 / price.round(0))
  println(price % 0.5)
  println(price > 19.989)
  println(19.991 > price)
  println(price == 19.990)
  println(0 < price < 20.0)
  var total: BigDecimal = 0
  total += 0.1
  total += 0.2
  total -= 0.05
  total *= 1.5
  println(total)
  // Among literals alone a decimal literal is still a real, and so is the integer beside it.
  println(1 + 0.5, 1 < 2.5 < 3, 0.5 * 2, -1.5 + 1)
  // A type parameter bounded by `FromDecimal`, and a program's own type.
  println(made(BigDecimal("1.25")))
  val s: Spelled = 1_2.3_4e-5
  println(s)
  val t: Spelled = -0.0
  println(t)
  val u: Spelled = 12
  println(u)
  println(made(Spelled("x")))
  println(made[Spelled](2.5))
