// expect: exit 0
// Eight threads read a `lazy val` for the first time together, a module-level value and a field of
// one shared object. Each initializer waits until every thread has arrived at its read, so seven
// find it running and wait for it, safe for the collector: it runs exactly once, and every thread
// sees the whole value. The values are built on the heap while the collector runs at every
// allocation, and they survive the collections that follow.
import avin.threads.{Atomic, scope}

val runs = Atomic(0)
val atTable = Atomic(0)
val atItems = Atomic(0)

lazy val table: Vector[string] = build("m", atTable)

class Shared(prefix: string)
    lazy val items: Vector[string] = build(prefix, atItems)

build(prefix: string, arrived: Atomic[int]) -> Vector[string]
    runs.add(1)
    while arrived.load() < 8 do ()
    var out: Vector[string] = []
    for i in 0..<200
        out = out :+ s"$prefix$i"
    out

main() -> int
    val shared = Shared("f")
    val lengths = Atomic(0)
    scope(s ->
        for _ in 0..<8
            s.spawn(() ->
                var junk: Vector[int] = []
                for i in 0..<50
                    junk = junk :+ i
                atTable.add(1)
                val t = table
                atItems.add(1)
                lengths.add(t.length() + shared.items.length() + junk.length())))
    print(runs.load())
    print(lengths.load())
    var rest: Vector[int] = []
    for i in 0..<300
        rest = rest :+ i
    print(table(199))
    print(shared.items(0))
    print(shared.items.mkString(",").byteLength())
    print(rest.length())
    0
