// expect: exit 0
// A line printed is never split, whichever threads print: `println` renders its arguments and its new
// line first and adds them to standard output in one step, and `print` does the same with no new line.
// The program runs itself as a child in which eight threads each print 300 lines of varying length,
// one of them far longer than standard output's buffer, and reads the child's output back: every line
// must be whole, each thread's lines in the order it printed them, none lost. It does so for one
// argument, several arguments, numbers, a whole line given to `print` as one argument and as several,
// and a mix of `println` and `print`, into a pipe, and for one argument and the mix into a file too.
import avin.fs
import avin.process
import avin.process.Command
import avin.threads.scope

val Threads = 8

val Lines = 300

// The length of the filler in thread `t`'s line `n`: short and varying, except that thread 0's line 150
// is longer than any buffer standard output keeps.
fill(t: int, n: int) -> int = if t == 0 && n == 150 then 100000 else (t * 37 + n * 13) % 150

pad(t: int, n: int) -> string = char(int('a') + t).toString().repeat(fill(t, n))

// Thread `t` prints its lines the way `how` names.
emit(how: string, t: int)
  for n in 0 ..< Lines
    how match
      "one" -> println(s"$t:$n:${pad(t, n)}.")
      "many" -> println(s"$t:", s"$n:", s"${pad(t, n)}.")
      "numbers" -> println(t * 100000 + n)
      "print" -> print(s"$t:$n:${pad(t, n)}.\n")
      "printMany" -> print(s"$t:", s"$n:", s"${pad(t, n)}.\n")
      _ ->
        if n % 2 == 0 then println(s"$t:$n:${pad(t, n)}.") else print(s"$t:$n:${pad(t, n)}.\n")

child(how: string)
  scope(s ->
    for t in 0 ..< Threads
      s.spawn(() -> emit(how, t)))

// The thread and line number a line names, if it is whole: `-1` for one that is not.
parsed(how: string, line: string) -> (int, int) =
  if how == "numbers"
    line.toIntOption() match
      Some(k) if 0 <= k / 100000 < Threads && 0 <= k % 100000 < Lines -> (k / 100000, k % 100000)
      _ -> (-1, -1)
  else
    val parts = (if how == "many" || how == "printMany" then line.replace(", ", "") else line).split(":")
    if parts.length != 3 then return (-1, -1)
    (parts(0).toIntOption(), parts(1).toIntOption()) match
      (Some(t), Some(n)) if 0 <= t < Threads && 0 <= n < Lines ->
        if parts(2) == s"${pad(t, n)}." then (t, n) else (-1, -1)
      _ -> (-1, -1)

// Checks every line of `text` and says what it found.
check(how: string, to: string, text: string)
  val next = Array.fill(Threads, 0)
  var bad = 0
  var count = 0
  for line in text.lines
    count += 1
    val (t, n) = parsed(how, line)
    if t < 0
      if bad < 3 then println(s"$how $to: broken line ${line.take(60)}")
      bad += 1
    elif next(t) != n
      if bad < 3 then println(s"$how $to: thread $t line $n where ${next(t)} was next")
      bad += 1
      next(t) = n + 1
    else
      next(t) = n + 1
  val complete = (0 ..< Threads).forall(t -> next(t) == Lines)
  println(s"$how $to: $count lines, $bad broken, ${if complete then "all" else "not all"} there")

main(args: Vector[string])
  if args.length == 2 && args(0) == "child" then return child(args(1))
  if !args.isEmpty then fail(s"unexpected arguments $args")
  val program = process.executable().getOrElse("")
  val dir = fs.createTempDir("avin-println-whole") match
    Ok(d) -> d
    Err(e) -> fail(s"no temporary directory: $e")
  for how in ["one", "many", "numbers", "print", "printMany", "mixed"]
    Command(program, "child", how).output() match
      Ok(text) -> check(how, "pipe", text)
      Err(e) -> println(s"$how pipe: $e")
  for how in ["one", "mixed"]
    val file = s"$dir/$how.txt"
    _ = Command(program, "child", how).toFile(file).run()
    fs.readText(file) match
      Ok(text) -> check(how, "file", text)
      Err(e) -> println(s"$how file: $e")
  _ = fs.removeDirAll(dir)
