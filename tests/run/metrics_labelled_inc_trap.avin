// expect: trap
// A family's own `inc` is its one series' where it has no labels; one with labels finds a series by
// `labels`, and its own `inc` traps.
import avin.metrics.Registry

main()
  val c = Registry().counter("c_total", "C.", ["k"])
  c.labels("a").inc()
  println(c.labels("a").value)
  c.inc()
