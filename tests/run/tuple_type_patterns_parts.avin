// expect: exit 0
// A tuple type pattern matches a tuple whose type, as it was made, is seen as the pattern's with no
// conversion: a part that is an object is its own `Any`, so a `(string, string)` and a `(Dog, string)`
// are `(Any, string)`s, while an `(int, string)` is not, its `int` being no object. A part naming a
// union of references takes the objects that are its members, whatever the part was made as; a part
// naming a union with a scalar member takes only a tuple made with that union there.

class Dog(val name: string)
class Cat(val name: string)
class Bird(val name: string)

kind(a: Any) -> string = a match
    _: (Any, string) -> "any and string"
    t: (int | string, bool) -> s"scalar union and bool: ${t.0}"
    p: (Dog | Cat, int) -> s"pet and int: ${p.1}"
    n: ((Dog | Cat, int), bool) -> s"nested pet: ${n.0.1}"
    _ -> "none"

petName(p: Dog | Cat) -> string = p match
    d: Dog -> d.name
    c: Cat -> c.name

main()
    // A part that is an object is seen as `Any`.
    println(kind(("a", "b")))
    println(kind((Dog("d"), "b")))
    println(kind(((1, 2), "b")))
    println(kind((Some(1), "b")))
    val made: (Any, string) = (1, "b")
    println(kind(made))
    // A scalar part is no `Any` part.
    println(kind((1, "b")))
    println(kind((true, "b")))
    // A union with a scalar member: only a tuple made with that union matches.
    val u: (int | string, bool) = (1, true)
    println(kind(u))
    val us: (int | string, bool) = ("s", false)
    println(kind(us))
    println(kind((1, true)))
    println(kind(("s", true)))
    val other: (int | bool, bool) = (1, true)
    println(kind(other))
    // A union of references: the objects its members are, made as a member, as the union or as an
    // `Any`.
    println(kind((Dog("rex"), 1)))
    println(kind((Cat("tom"), 2)))
    val pets: (Dog | Cat, int) = (Cat("kit"), 3)
    println(kind(pets))
    val anyPet: (Any, int) = (Dog("any"), 4)
    println(kind(anyPet))
    val bird: (Any, int) = (Bird("b"), 5)
    println(kind(bird))
    val boxed: (Any, int) = (5, 6)
    println(kind(boxed))
    println(kind((Bird("b"), 7)))
    // Nested tuples are tested part by part.
    println(kind(((Dog("n"), 8), true)))
    println(kind(((Bird("n"), 9), true)))
    // The value bound is the tuple, its parts readable as the pattern's types.
    val seen: Any = (Cat("bound"), 10)
    seen match
        p: (Dog | Cat, int) -> println(s"${petName(p.0)} ${p.1}")
        _ -> println("none")
    // A tuple whose static type holds objects is still tested part by part against a union.
    val holding: (Any, int) = (Bird("static"), 11)
    holding match
        p: (Dog | Cat, int) -> println(s"pet ${p.1}")
        _ -> println("not a pet")
