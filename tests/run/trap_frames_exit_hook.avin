// expect: trap
// A trap that stops the program drops the frames of the code that trapped before the exit hooks run
// on its thread, so a collection a hook's allocation makes never reads a slot that code had not yet
// stored to. `step` keeps `label` in a slot only the `Show` arm stores, and the `Fail` arm traps
// before any store; `fill` first leaves the stack where that slot lies full of references to
// objects that are collected before the trap. The hook allocates, and what it captured is intact.
import avin.process

data Step
  Add(n: int)
  Fail
  Show(label: string)

step(s: Step, total: int) -> int = s match
  Add(n) -> total + n
  Fail -> total / (total - total)
  Show(label) ->
    println(s"$label: $total")
    label.charCount + total

// Makes `n` rounds of six strings, all six held at once and dead after their round, and answers
// how many characters they had.
fill(n: int) -> int
  var total = 0
  for i in 0 ..< n
    val a = s"fill $i of $n"
    val b = a + "b"
    val c = b + "c"
    val d = c + "d"
    val e = d + "e"
    val f = e + "f"
    total += a.charCount + b.charCount + c.charCount + d.charCount + e.charCount + f.charCount
  total

main()
  val words = Vector("alpha", "beta", "γάμμα")
  process.onExit(() ->
    val built = (0 ..< 50).map(i -> s"${words(i % words.length)}$i").toVector
    println(s"hook: ${built.length} ${built(49)} ${words.mkString("+")}"))
  var total = step(Show("start"), 1)
  total = step(Add(fill(20)), total)
  println(total)
  // What `fill` made is garbage once the line below allocates, which collects under stress.
  val junk = fill(30)
  println(s"filled $junk")
  total = step(Fail, junk)
  println(total)
