// expect: exit 0
// The words that begin a top-level declaration (`data`, `class`, `object`, `trait`, `impl`,
// `import`, `module`, and `open` and `abstract` before `class`) are keywords only there, before the
// name they declare. Everywhere else they are ordinary names: a local, a parameter, a field, a
// function, a method, a named argument, a pattern binding, a type parameter and a variant.

data Shape
  Circle(r: int)
  Square(side: int)

@sendable
private data Hidden(n: int)

data Kind
  open
  abstract(trait: int)

class Record(val data: string, val class: int, val type: string)
  object() -> string = s"object of $data"
  trait -> int = class * 2
  def impl = data.charCount

object Registry
  val import = 3
  var module = "m"
  impl(n: int) -> int = n + import
  data(n: int) -> int = n * 10

trait Named
  name() -> string

trait Sized
  size() -> int

impl Named for Record
  name() -> string = s"record $data"

impl Sized for Record
  size() -> int = class

abstract class Base
  abstract(x: int) -> int
  open(x: int) -> int = abstract(x) + 1

class Derived: Base
  override abstract(x: int) -> int = x * 3

data(x: int) -> int = x + 1

class(x: int) -> int = x + 2

object(x: int) -> int = x + 3

trait(x: int) -> int = x + 4

impl(x: int) -> int = x + 5

import(x: int) -> int = x + 6

module(x: int) -> int = x + 7

data2[data](module: data) -> data = module

describe[T: Named & Sized](data: T) -> string = s"${data.name()} of size ${data.size()}"

private callDeclared() -> int = data(1) + class(1) + object(1) + trait(1) + impl(1) + import(1) + module(1)

main()
  println(callDeclared())
  val data = "payload"
  println(data)
  val class = 4
  var object = class + 1
  object += 1
  println(object)
  val r = Record(data = "d", class = 7, type = "t")
  println(r.data)
  println(r.class)
  println(r.type)
  println(r.object())
  println(r.trait)
  println(r.impl)
  println(r.name())
  println(describe(r))
  println(Registry.import)
  println(Registry.impl(1))
  println(Registry.data(4))
  Registry.module = "n"
  println(Registry.module)
  val module = [1, 2, 3]
  for import in module do println(import)
  val shape: Shape = Circle(2)
  shape match
    Circle(data) -> println(data)
    Square(_) -> println(0)
  val kind: Kind = Kind.abstract(9)
  kind match
    Kind.abstract(trait) -> println(trait)
    Kind.open -> println("open")
  val impl = (abstract: int) -> abstract + class
  println(impl(1))
  val trait = () -> data.charCount + class
  println(trait())
  println(Derived().abstract(2))
  println(Derived().open(2))
  println(Hidden(5).n)
  println(data2[string]("generic"))
  val abstract = Record(data = "e", class = 1, type = "u")
  println(abstract.class + abstract.data.charCount)
