// expect: exit 0
// An actor's states may share their names with other variants of its module, as a machine's do: a
// message's variant, another actor's state and a machine's state. Each is a variant of its own type,
// and a bare name is the one of the type expected there: an arm's result is the actor's own state, an
// arm's pattern is the message type's, and a pattern on `state()` is the actor's `State` type's.
// Outside the actors, the program's own uses decide by the type expected, or name the type.
import avin.actors.{ActorRef, spawn}
import avin.threads.Channel
import avin.time

data Ev
  Start
  Idle
  Ready
  Ask(reply: ActorRef[string])

actor First receives Ev
  state Idle
    Start -> Ready
    Idle -> Idle
  state Ready
    Idle -> Idle
    Ready -> stay
  receive
    Ask(r) ->
      val text = state() match
        Idle -> "first idle"
        Ready -> "first ready"
      r.tell(text)
      stay
    _ -> stay

actor Second receives Ev
  var moves = 0
  state Ready
    Start ->
      moves += 1
      Idle(moves)
  state Idle(n: int)
    Ready -> Ready
  receive
    Ask(r) ->
      r.tell(s"second ${state()}")
      stay
    _ -> stay

machine Turnstile receives Ev
  state Ready
    Start -> Idle
    _ -> stay
  state Idle
    _ -> stay

main()
  val wait = time.seconds(60)
  val a = spawn(First())
  println(a.ask(r -> Ask(r), timeout = wait).await())
  a.tell(Start)
  println(a.ask(r -> Ask(r), timeout = wait).await())
  a.tell(Ready)
  a.tell(Idle)
  println(a.ask(r -> Ask(r), timeout = wait).await())
  val b = spawn(Second())
  b.tell(Start)
  println(b.ask(r -> Ask(r), timeout = wait).await())
  b.tell(Ready)
  b.tell(Start)
  println(b.ask(r -> Ask(r), timeout = wait).await())
  val t = Turnstile()
  println(t.handle(Start) is Turnstile.State.Idle)
  val sent: Ev = Ready
  println(sent)
