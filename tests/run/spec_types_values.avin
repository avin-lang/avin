// expect: exit 0
// unit as a field, a parameter, a pattern and a type argument; tuples returned without parentheses,
// taken apart nested, ordered, displayed, debugged and hashed; a tuple parameter; curried function
// types; a class and a data type that are function types; collections used as functions; and
// string.fromUtf8 refusing each kind of malformed sequence.

data Holder(u: unit, n: int)

class Shout: (string) -> string
  apply(s: string) -> string = s + "!"

data Lengths(extra: int)

impl (string) -> int for Lengths
  apply(s: string) -> int = s.charCount + extra

unitArg(u: unit) -> string = u match
  () -> "unit"

bounds(a: int, b: int) -> (int, int)
  if a > b then return b, a
  a, b

applyPair(f: ((int, int)) -> int, p: (int, int)) -> int = f(p)

adder(n: int) -> int -> int = x -> x + n

largest[T: Ord](a: T, b: T) -> T = if a > b then a else b

main()
  val h = Holder((), 3)
  println(s"${h == Holder((), 3)} ${unitArg(())} ${Some(()).isDefined}")
  val us: Vector[unit] = [(), ()]
  println(us.length)
  println(bounds(5, 2))
  val (a, (b, c)) = (1, (2, 3))
  println(s"$a $b $c")
  println(s"${(1, "b") < (1, "c")} ${(2, "a") > (1, "z")} ${largest((1, 2), (1, 3))}")
  println(debug((1, "x", 'c')))
  println(((1, 2), "t"))
  println(s"${(1, 2).hash() == (1, 2).hash()}")
  println(applyPair(p -> p.0 * p.1, (6, 7)))
  val add: int -> int -> int = x -> y -> x + y
  println(add(2)(3))
  val fs: List[int -> int] = [adder(1), adder(2)]
  println(fs.map(f -> f(10)))
  val f: (string) -> string = Shout()
  println(f("hi"))
  println(["a", "bb"].map(Lengths(1)))
  val seq = [10, 20, 30]
  println([2, 0].map(seq))
  val set = {1, 3}
  println([1, 2, 3].filter(set))
  val m = {"a": 1, "b": 2}
  println(["b", "a"].map(m))
  val cut: Array[byte] = [0x61, 0xE2, 0x82]
  println(string.fromUtf8(cut))
  println(string.fromUtf8Lossy(cut))
  val stray: Array[byte] = [0x80, 0x61]
  println(string.fromUtf8(stray))
  val surrogate: Array[byte] = [0xED, 0xA0, 0x80]
  println(string.fromUtf8(surrogate))
  val big: Array[byte] = [0xF4, 0x90, 0x80, 0x80]
  println(string.fromUtf8(big))
  val overlong: Array[byte] = [0xC0, 0xAF]
  println(string.fromUtf8(overlong))
  val empty: Array[byte] = Array.empty()
  println(string.fromUtf8(empty))
  println(string.fromUtf8Lossy(stray))
