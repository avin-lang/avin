// expect: exit 0
// Unary minus on a real flips the sign bit of every value: NaN, the zeros, the infinities and
// ordinary numbers, on constants and variables, directly and inside generic code.
import avin.math

negate[T: Neg](x: T) -> T = -x
twice(x: real) -> real = -(-x)

main()
    val nan = real.NaN
    val zero = 0.0
    val negZero = -0.0
    val inf = real.PositiveInfinity
    val ninf = real.NegativeInfinity
    val x = 2.5

    // NaN: constant, variable, function, generic
    println(s"${math.signBit(nan)} ${math.signBit(-nan)} ${math.signBit(-(-nan))}")
    println(s"${math.signBit(real.NaN)} ${math.signBit(-real.NaN)} ${math.signBit(-(-real.NaN))}")
    println(s"${math.signBit(negate(nan))} ${math.signBit(negate(negate(nan)))} ${math.signBit(twice(nan))}")
    println(s"${(-nan).isNaN()} ${(-real.NaN).isNaN()} ${negate(nan).isNaN()}")
    // zeros
    println(s"${math.signBit(zero)} ${math.signBit(-zero)} ${math.signBit(negZero)} ${math.signBit(-negZero)}")
    println(s"${math.signBit(-0.0)} ${math.signBit(-(-0.0))} ${math.signBit(negate(zero))} ${math.signBit(negate(negZero))}")
    println(s"${1.0 / -zero} ${1.0 / -negZero} ${1.0 / negate(zero)} ${1.0 / negate(negZero)}")
    // infinities
    println(s"${-inf} ${-ninf} ${negate(inf)} ${negate(ninf)} ${-real.PositiveInfinity} ${-real.NegativeInfinity}")
    println(s"${math.signBit(-inf)} ${math.signBit(-ninf)}")
    // ordinary values
    println(s"${-x} ${-(-x)} ${negate(x)} ${negate(-x)} ${-2.5} ${twice(x)}")
    println(s"${math.signBit(x)} ${math.signBit(-x)} ${math.signBit(-real.MinPositiveValue)}")
    // other numeric types still negate
    println(s"${negate(5)} ${negate(long(-7))}")
