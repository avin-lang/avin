// expect: exit 0
// `open` is a modifier only before `class`, so it stays an ordinary name everywhere else: a
// function, a method (with a parameter list or without one), a parameter and a local may be called
// `open`, and calls, assignments and reads of it are not taken for a misplaced modifier. The public
// methods of an `open` or `abstract` class are overridden with no marker on the method itself.

open(path: string) -> string = "opened " + path

open class Door
  var openCount = 0
  open(by: string) -> string
    openCount += 1
    s"$by opens"
  sound() -> string = "creak"

class Window(shut: bool)
  open -> bool = !shut

class Hatch
  def open = "hatch"

class Gate: Door
  override sound() -> string = "clang"

abstract class Lock
  open(code: int) -> bool
  describe() -> string = if open(42) then "open" else "shut"

class Combination: Lock
  override open(code: int) -> bool = code == 42

twice(open: int) -> int = open * 2

main()
  println(open("a.txt"))
  val d = Door()
  println(d.open("ann"))
  println(d.openCount)
  println(Window(false).open)
  println(Window(true).open)
  println(Hatch().open)
  val g: Door = Gate()
  println(g.sound())
  println(Combination().describe())
  var open = 1
  open = open +twice(open)
  println(open)
