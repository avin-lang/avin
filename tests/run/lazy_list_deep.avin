// expect: exit 0
// env: AVIN_GC_STRESS=0
// Lazy lists of a million cells and more, far deeper than any stack could recurse, are
// evaluated, walked, counted, converted and displayed without deepening the stack: every method that
// reads many cells reads them in a loop, and so do `filter`, `dropWhile`, `drop` and `flatMap` when
// they skip that many elements to reach one. A list walked by a `for` loop, with nothing holding its
// head, is collected behind the loop, so its cells pass through a few megabytes. The collector runs as it ordinarily does, since
// collecting at each of these allocations would take hours; `lazy_list_gc.avin` runs lazy lists
// under the stressed collector.
import avin.process.{pid, residentBytes}

val million = 1000000

residentMegabytes() -> long = residentBytes(pid()).getOrElse(0) / 1000000

// Fibonacci numbers by reference to themselves, wrapping where they overflow.
lazy val wrapping: LazyList[long] = LazyList.cons(0, LazyList.cons(1, wrapping.zip(wrapping.tail).map(p -> p.0 +% p.1)))

countUp(n: int) -> LazyList[int] = LazyList.cons(n, countUp(n + 1))

main() -> int
  val before = residentMegabytes()
  var total: long = 0
  for x in LazyList.from(0).take(3 * million)
    total += long(x)
  println(total)
  println(residentMegabytes() - before < 300)

  val counted = LazyList.from(0).take(million)
  println(counted.length)
  println(counted.length)
  println(counted(million - 1))
  println(counted.lift(million))
  println(counted.last)
  println(counted.toVector.length)
  println(counted.toList.length)
  println(counted.foldLeft(long(0), (a, x) -> a + long(x)))
  println(s"$counted".charCount)
  println(f"$counted%?".charCount)

  println(LazyList.from(0).filter(n -> n >= million).head)
  println(LazyList.from(0).dropWhile(n -> n < million).head)
  println(LazyList.from(0).drop(million).head)
  println(LazyList.from(0).flatMap(n -> if n < million then Vector.empty[int]() else Vector(n)).head)
  println(LazyList.from(0).map(n -> n * 2).filter(n -> n % 3 == 0).drop(million).head)
  println(LazyList.from(0).takeWhile(n -> n < million).length)

  println(wrapping(million))
  println(countUp(0).take(million).length)
  println(countUp(0)(million))
  println(LazyList.iterate(long(1), x -> x *% 3 +% 1).drop(million).head)
  println(LazyList.unfold(million, n -> if n == 0 then None else Some((n, n - 1))).length)
  println(LazyList.continually(7).take(million).sum)
  println((LazyList.from(0).take(million) ++ LazyList.from(0).take(million)).length)
  println(LazyList.from(0).take(million).zip(LazyList.from(1)).last)
  println(LazyList.from(0).zipWithIndex.drop(million).head)
  println(LazyList.tabulate(million, i -> i % 10).sum)
  println(Vector.tabulate(million, i -> i).toLazyList().length)

  // A pipeline of many stages: each stage adds a frame when a cell of the last is first read.
  var stages = LazyList.from(0)
  for _ in 0 ..< 1000
    stages = stages.map(x -> x + 1)
  println(stages.take(3).toVector)
  0
