// expect: exit 0
// `combinations(k)` and `permutations()`: lazy iterators of the distinct selections of a sequence,
// two elements being the same where `equals` says so. Distinct elements, duplicates, all equal, the
// empty sequence, `k` of 0, one and the length, out-of-range `k`, counts against the binomial and
// multinomial formulas, and elements of our own.

data Pt(x: int, y: int)

// A custom equality: two words are the same when they have the same first letter.
class Word(val text: string)

impl Eq for Word
    equals(other: Word) -> bool = text.startsWith(other.text.take(1))

impl Hash for Word
    hash() -> long = text.take(1).hash()

fact(n: int) -> long = if n <= 1 then long(1) else long(n) * fact(n - 1)

main()
    val none: Vector[int] = []
    // distinct elements: every combination, in order
    println([1, 2, 3, 4].combinations(2).toVector())
    println([1, 2, 3, 4].combinations(3).toVector())
    println([1, 2, 3, 4].combinations(1).toVector())
    println([1, 2, 3, 4].combinations(4).toVector())
    println([1, 2, 3, 4].combinations(0).toVector())
    println([1, 2, 3, 4].combinations(5).toVector())
    println([1, 2, 3, 4].combinations(-1).toVector())
    println(none.combinations(0).toVector())
    println(none.combinations(1).toVector())
    println([9].combinations(1).toVector())
    println([9].combinations(0).toVector())
    // duplicates: each distinct combination once
    println([1, 1, 2].combinations(2).toVector())
    println([1, 1, 2].combinations(1).toVector())
    println([1, 1, 2].combinations(3).toVector())
    println([1, 2, 1, 2].combinations(2).toVector())
    println([2, 1, 2, 1, 3].combinations(3).toVector())
    println([5, 5, 5, 5].combinations(2).toVector())
    println([5, 5, 5, 5].combinations(4).toVector())
    println([5, 5, 5, 5].combinations(5).toVector())
    println(["a", "b", "a"].combinations(2).toVector())
    // counts agree with the formulas: C(8, 3) = 56, C(10, 5) = 252, 2^6 = 64 over all k
    println(s"${(1 .. 8).combinations(3).toVector().length()} ${(1 .. 10).combinations(5).toVector().length()}")
    var all = 0
    for k in 0 .. 6 do all += (1 .. 6).combinations(k).toVector().length()
    println(all)
    // a multiset 1 1 1 2 2 3: selections of 3 are (3 choose with caps) = 6
    println([1, 1, 1, 2, 2, 3].combinations(3).toVector())
    // every combination is distinct and sorted by first appearance
    val cs = [3, 1, 3, 2, 1, 4].combinations(3).toVector()
    println(s"${cs.length()} ${cs.distinct().length() == cs.length()} ${cs.head()} ${cs.last()}")
    // the iterator is lazy and steps in order
    val it = [1, 2, 3].combinations(2)
    println(s"${it.hasNext()} ${it.next()} ${it.next()} ${it.hasNext()} ${it.next()} ${it.hasNext()}")
    // a huge number of combinations is only made as far as it is stepped: C(60, 30) would not fit
    val big = (0 ..< 60).combinations(30)
    println(s"${big.next().length()} ${big.next().last()} ${big.hasNext()}")
    // other kinds of sequence, and elements of our own
    val l: List[int] = [1, 2, 2]
    val d: Deque[int] = [1, 2, 2]
    println(s"${l.combinations(2).toVector()} ${d.combinations(2).toVector()} ${(1 .. 3).combinations(2).toVector()}")
    println([Pt(1, 2), Pt(1, 2), Pt(3, 4)].combinations(2).toVector())
    println([Word("apple"), Word("avocado"), Word("bean")].combinations(2).map(c -> c.map(w -> w.text)).toVector())

    // permutations: all orders, each once
    println([1, 2, 3].permutations().toVector())
    println([1, 1, 2].permutations().toVector())
    println([2, 1, 1].permutations().toVector())
    println([1, 2, 2, 1].permutations().toVector())
    println(none.permutations().toVector())
    println([7].permutations().toVector())
    println([4, 4, 4].permutations().toVector())
    println(["b", "a"].permutations().toVector())
    println([Word("apple"), Word("avocado"), Word("bean")].permutations().map(c -> c.map(w -> w.text)).toVector())
    // counts agree with n! and n! / (a! b! ...)
    println(s"${(1 .. 5).permutations().toVector().length()} ${fact(5)} ${(1 .. 7).permutations().toVector().length()} ${fact(7)}")
    println(s"${[1, 1, 2, 2, 3].permutations().toVector().length()} ${fact(5) / (fact(2) * fact(2))}")
    println(s"${[1, 1, 1, 1, 2, 2].permutations().toVector().length()} ${fact(6) / (fact(4) * fact(2))}")
    val ps = [3, 1, 2, 1].permutations().toVector()
    println(s"${ps.length()} ${ps.distinct().length() == ps.length()} ${ps.head()} ${ps.last()} ${ps.forall(p -> p.sorted() == [1, 1, 2, 3])}")
    // lazy: 20 elements have 20! orders, and the first few are cheap
    val many = (1 .. 20).permutations()
    println(s"${many.next()} ${many.next().take(3)} ${many.hasNext()}")
    val st = [1, 2].permutations()
    println(s"${st.hasNext()} ${st.next()} ${st.next()} ${st.hasNext()}")
    val l3: List[int] = [1, 2, 3]
    val sq: Seq[int] = [1, 2, 3]
    println(s"${l3.permutations().toVector().length()} ${(1 .. 3).permutations().toVector().length()} ${sq.permutations().toVector().length()}")
    // a source that changes afterwards does not change an iterator already made
    val buf: Buffer[int] = [1, 2, 3]
    val pit = buf.permutations()
    buf.addOne(99)
    println(s"${pit.toVector().length()} ${buf.length()}")
    // GC pressure over allocated elements
    val words = (0 ..< 6).map(i -> s"word$i")
    var total = 0
    for p in words.permutations()
        total += p(0).byteLength() + p(5).byteLength()
    println(total)
    var combos = 0
    for c in (0 ..< 200).map(i -> s"c${i % 20}").combinations(2) do combos += c.length()
    println(combos)
