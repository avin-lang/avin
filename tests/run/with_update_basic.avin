// expect: exit 0
// `base with { … }` makes a new value of the base's data type with the named fields replaced and
// every other field the base's, which is itself unchanged. A brace holds the changes one per line, the
// last with a comma, and `with` stays an ordinary name everywhere else, a field's among them.

data Style(fg: int, bg: int, pad: int)

data Flags(with: int, other: string)

data One(only: string)

class Holder(val with: int)
  plus(n: int) -> int = with + n

// A method named `with`, called infix with an argument that is not a brace.
class Scale(factor: int)
  with(n: int) -> int = factor * n

main() -> int
  val theme = Style(1, 2, 3)
  val hot = theme with {bg = 9}
  println(theme)
  println(hot)
  val two = theme with {pad = 8, fg = 7}
  println(two)
  val all = theme with {fg = 4, bg = 5, pad = 6}
  println(all)
  val lines = theme with {
    bg = 9,
    pad = 8,
  }
  println(lines)
  if lines != Style(1, 9, 8) then return 1
  // Changing a field to the value it had makes an equal value.
  if (theme with {bg = 2}) != theme then return 2
  val f = Flags(1, "a")
  println((f with {with = 9}).with)
  val with = 3
  println(with + (f with {other = "b"}).with)
  println(One("x") with {only = "é ü 字"})
  println(One("x") with {only = ""})
  val h = Holder(5)
  println(h.with)
  println(h plus 1)
  val sc = Scale(2)
  println(sc with 3)
  println(sc.with(4))
  println(sc with (5))
  0
