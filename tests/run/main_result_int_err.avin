// expect: exit 1
// A `main` answering with `Result[int, E]` exits with 1 on `Err`, whatever integer it would have
// answered, with the error's `Display` after `error: ` on standard error, Unicode included.
parse(text: string) -> Result[int, string] = text.toIntOption() match
    Some(n) -> Ok(n)
    None -> Err(s"not a number: «$text» ✗")

main() -> Result[int, string]
    val a = parse("40")?
    val b = parse("zwei")?
    Ok(a + b)
