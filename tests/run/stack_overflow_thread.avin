// expect: trap
// Recursion without a base case overflows the stack of a spawned thread, which has a stack of its own,
// and stops the whole program with the same trap.
import avin.threads.spawn

descend(n: int) -> int = descend(n + 1) + n

main() -> int
  println("before")
  val t = spawn(() -> descend(0), 1048576)
  println(t.join())
  println("after")
  0
