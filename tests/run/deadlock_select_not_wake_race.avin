// expect: exit 0
// The main thread in a `select` woken just as the last other thread stops running is not
// deadlocked: thousands of times `main` selects on two channels while a new thread sends on one of
// them and ends at once, or sends to the room a full channel's receiver makes. The wake of a select's
// arm is counted as every wake is, so `main` never takes the moment after it for a deadlock.
import avin.threads.{Channel, spawn}

main()
  val a = Channel[int]()
  val b = Channel[int]()
  var got = 0
  for i in 0 ..< 3000
    spawn(() -> if i % 2 == 0 then a.send(1) else b.send(2))
    select
      a.receive() as Some(x) -> got += x
      b.receive() as Some(x) -> got += x
  println(got)

  val full = Channel[int](1)
  var sent = 0
  for i in 0 ..< 3000
    full.send(i)
    spawn(() -> _ = full.receive())
    select
      full.send(i) -> sent += 1
    _ = full.receive()
  println(sent)
