// expect: exit 0
// `math.abs`, `max`, `min` and `signum` take `int` and `long` as well as `real`; the overload is
// chosen by the argument types, an integer literal beside an `int` is an `int`, and the `real`
// functions keep their IEEE meaning.

import avin.math

main(args: Vector[string])
  val n = 5
  val big: long = 5_000_000_000
  println(math.max(1, n))
  println(math.min(1, n))
  println(math.max(big, 3))
  println(math.min(-big, long(n)))
  println(math.abs(-n))
  println(math.abs(-big))
  println(math.signum(-n))
  println(math.signum(big))
  println(math.signum(0))
  println(math.max(1.5, 2.0))
  println(math.max(0.0, 2))
  println(math.abs(-2.5))
  println(math.signum(-2.5))
  val m: int = math.max(2, n)
  println(m)
  println(math.max(1, 2))
  println(math.abs(-3))
  println(math.max(int.MinValue, int.MaxValue))
  println(math.min(int.MinValue, int.MaxValue))
  println(math.abs(int.MaxValue))
  println(math.abs(long.MaxValue))
  println(math.max(long.MinValue, long.MaxValue))
  println(math.min(7, 7))
  println(math.signum(long.MinValue))
  println(math.max(real.NaN, 1.0).isNaN)
