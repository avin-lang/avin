// expect: trap
// A server made directly with a protocol name ALPN cannot carry is made, and traps at its first
// connection, before the handshake begins.
import avin.net.{TcpListener, TcpStream}
import avin.net.tls.{TlsServer, TlsStream}

main()
  val listener = TcpListener.bind("127.0.0.1", 0).ok.get
  val client = TcpStream.connect("127.0.0.1", listener.port()).ok.get
  val accepted = listener.accept().ok.get
  val settings = TlsServer("", "", ["http/1.1", "x".repeat(256)])
  println(s"made: ${settings.protocols.length} protocols")
  _ = TlsStream.server(accepted, settings)
  _ = client.close()
  println("not reached")
