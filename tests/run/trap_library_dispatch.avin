// expect: trap
// A core-library method reached through a trait, so through its type's method table, traps at the
// program's call of it, inside the program's function that takes the trait.

drain(it: Iterator[int]) -> int
  var total = 0
  while it.hasNext() do total += it.next()
  total

finish(b: Builder[int, Vector[int]]) -> int = b.result().length

main()
  println(s"${drain([2, 2, 2].iterator())}")
  val b = Vector.newBuilder[int]()
  b.addOne(1)
  println(s"${finish(b)}")
  val it: Iterator[int] = [1].iterator()
  println(s"${it.next()}")
  finish(b)
