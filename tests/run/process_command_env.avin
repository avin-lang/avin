// env: AVIN_ENV_OUTER=from the program
// env: AVIN_ENV_OTHER=also inherited
// A command's environment: `clearEnv` starts it empty, `withoutEnv` drops one variable and
// `withEnvironment` gives exactly the variables named, each applied in the order called, a part's
// own after its command's. A cleared environment looks a program up on the system's default search
// path, not the running program's. The running program's own environment is never changed.
import avin.process.{Command, env}

// The variables a program is started with, one per line, in order.
vars(c: Command) -> Command = (c | Command("/usr/bin/sort")).withEnv("LC_ALL", "C")

main()
  val e = Command("/usr/bin/env")
  // Untouched, the program's variables are passed on and a set one is added.
  println(Command("/bin/sh", "-c", "echo \"$AVIN_ENV_OUTER|$AVIN_ENV_OTHER\"").output())
  // Cleared: only what is set afterwards.
  println(vars(e.clearEnv()).output())
  println(vars(e.clearEnv().withEnv("A", "1")).output())
  println(vars(e.clearEnv().withEnv("A", "1").withEnv("B", "2")).output())
  println(vars(e.clearEnv().withEnv("A", "1").withEnv("A", "2")).output())
  // Order: a set before the clear is lost, one after it stays.
  println(vars(e.withEnv("A", "before").clearEnv().withEnv("B", "after")).output())
  println(vars(e.clearEnv().clearEnv().withEnv("A", "1")).output())
  // The program's own variables are gone once cleared, though the running program still has them.
  println(Command("/bin/sh", "-c", "echo \"$AVIN_ENV_OUTER|$AVIN_ENV_OTHER\"").clearEnv().output())
  println(env("AVIN_ENV_OUTER"))
  // Removing one: present, absent, set then removed, removed then set.
  val show = Command("/bin/sh", "-c", "echo \"$AVIN_ENV_OUTER|$AVIN_ENV_OTHER|$AVIN_ENV_NEW\"")
  println(show.withoutEnv("AVIN_ENV_OUTER").output())
  println(show.withoutEnv("AVIN_ENV_NO_SUCH").output())
  println(show.withoutEnv("AVIN_ENV_OUTER").withoutEnv("AVIN_ENV_OTHER").output())
  println(show.withEnv("AVIN_ENV_NEW", "n").withoutEnv("AVIN_ENV_NEW").output())
  println(show.withoutEnv("AVIN_ENV_OUTER").withEnv("AVIN_ENV_OUTER", "back").output())
  println(show.withoutEnv("AVIN_ENV_OUTER").withoutEnv("AVIN_ENV_OUTER").output())
  println(show.clearEnv().withoutEnv("AVIN_ENV_NEW").output())
  println(show.withoutEnv("AVIN_ENV_OTHER").clearEnv().withEnv("AVIN_ENV_NEW", "x").output())
  // Exactly this environment.
  println(vars(e.withEnvironment(Map(("A", "1"), ("B", "2")))).output())
  println(vars(e.withEnvironment(Map())).output())
  println(vars(e.withEnv("Z", "gone").withEnvironment(Map(("A", "1")))).output())
  println(vars(e.withEnvironment(Map(("A", "1"))).withEnv("B", "2")).output())
  // Unicode values and names, and an empty value.
  println(vars(e.clearEnv().withEnv("GREEK", "λόγος 🌍").withEnv("EMPTY", "")).output())
  println(vars(e.withEnvironment(Map(("ÉTÉ", "été")))).output())
  // A bare program name after a clear is found on the default search path.
  println(Command("env").clearEnv().withEnv("A", "1").output())
  println(Command("env").withEnvironment(Map(("PATH", "/no/such/dir"))).run())
  println(Command("/usr/bin/env").withEnvironment(Map(("PATH", "/no/such/dir"))).output())
  // Pipelines and sequences: the command's edits come first and each part's own after them.
  println((e.withEnv("P", "part") | Command("/usr/bin/sort")).clearEnv().output())
  println((e.clearEnv() | Command("/usr/bin/sort")).withEnv("A", "outer").output())
  println((e.withEnv("A", "part") | Command("/usr/bin/sort")).clearEnv().output())
  println((e.clearEnv().withEnv("A", "1") followedBy e.clearEnv().withEnv("B", "2")).output())
  println((e.withEnv("C", "own") followedBy e).clearEnv().withEnv("C", "3").output())
  // The same command run twice gives the same environment, and a changed one leaves the first as it was.
  val cleared = e.clearEnv().withEnv("A", "1")
  val changed = cleared.withEnv("B", "2")
  println(cleared.output())
  println(changed.output())
  println(cleared.output())
  // A directory alongside a cleared environment.
  println(Command("/bin/pwd").clearEnv().inDir("/").output())
