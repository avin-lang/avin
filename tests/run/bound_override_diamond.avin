// expect: exit 0
// A value bounded by two traits that both reach one method, where one of them overrides it, has the
// override alone: with `F[_]: Monad & Filter`, `map` is `Monad`'s default over `flatMap`, not also
// the `Functor` method `Filter` requires, and with `T: Loud & Quiet` over `Base`, `describe` is
// `Loud`'s. Called, named as a function value, and in a comprehension.

trait Base
  describe() -> string = "base"

trait Loud: Base
  override describe() -> string = "loud"

trait Quiet: Base
  hush() -> string = "shh"

class Both: Loud, Quiet

class OnlyQuiet: Quiet

said[T: Loud & Quiet](t: T) -> string = t.describe() + " " + t.hush()

plain[T: Quiet](t: T) -> string = t.describe()

// A `Monad` whose own `map` is not written, so `Monad`'s default runs, and a `Filter`.
data Box[A](value: Option[A])

impl Monad for Box
  static pure[X](value: X) -> Box[X] = Box(Some(value))

  flatMap[B](f: (A) -> Box[B]) -> Box[B] = value match
    Some(a) -> f(a)
    None -> Box(None)

impl Filter for Box
  filter(p: (A) -> bool) -> Box[A] = Box(value.filter(p))

incremented[F[_]: Monad & Filter](fa: F[int]) -> F[int] = fa.map(x -> x + 1)

asFunction[F[_]: Filter & Monad](fa: F[int]) -> F[string]
  val f = fa.map[string]
  f(x -> s"<$x>")

kept[F[_]: Monad & Filter](fa: F[int]) -> F[int] = for x in fa if x > 0 yield x * 2

main()
  println(said(Both()))
  println(plain(OnlyQuiet()))
  println(plain(Both()))
  println(incremented(Box(Some(1))).value)
  println(incremented(Some(41)))
  println(incremented([1, 2]))
  println(asFunction(Box(Some(7))).value)
  println(asFunction(Some(8)))
  println(kept(Box(Some(3))).value)
  println(kept(Box(Some(-3))).value)
  println(kept([-1, 0, 5]))
