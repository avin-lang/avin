// expect: trap
// The core library calls back into the program, which calls the library again: a trap there
// reports the nearest call the program made, inside the function it gave `tabulate`.

main()
    val lengths = Array.tabulate(3, i -> Array.fill(2 - i, 0).length())
    print(s"${lengths.length()}")
    Array.tabulate(3, i ->
        print(s"$i")
        Array.fill(1 - i, 0).length())
