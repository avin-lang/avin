// expect: exit 0
// Static members of constructor traits, called on a constructor: a bounded constructor parameter
// (`F.pure`), a type named bare (`Option.pure`), a partial application (`Result[_, E].pure`), an
// alias that is a constructor (`Parsed.pure`), and a type with every argument written `_`
// (`Box[_].pure`). Each call is the constructor's own member, and `F.pure` in generic code is the
// one of each constructor the code is instantiated at, from whichever of its bounds declares it.
// A static member is a function value too.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

trait Pointed[A]: Mappable[A]
  static pure[X](value: X) -> Self[X]

data Box[T](value: T)

impl Pointed for Box
  static pure[X](value: X) -> Box[X] = Box(value)
  map[B](f: (T) -> B) -> Box[B] = Box(f(value))

class Crate[A](val item: A): Pointed[A]
  static pure[X](value: X) -> Crate[X] = Crate(value)
  map[B](f: (A) -> B) -> Crate[B] = Crate(f(item))

impl Pointed for Option
  static pure[X](value: X) -> Option[X] = Some(value)

impl Pointed for List
  static pure[X](value: X) -> List[X] = List(value)

impl[T, E] Pointed[T] for Result[T, E]
  static pure[X](value: X) -> Result[X, E] = Ok(value)

impl[L, R] Pointed[R] for Either[L, R]
  static pure[X](value: X) -> Either[L, X] = Right(value)

type Parsed[T] = Result[T, string]

// A static member's body may name the type's parameter its conformance leaves open, which a call on
// the constructor leaves undecided: nothing of that type is ever made there.
data Shelf[T](items: Vector[T])

impl Pointed for Shelf
  static pure[X](value: X) -> Shelf[X]
    val none: Vector[T] = Vector()
    Shelf(Vector(value).take(1 - none.length))
  map[B](f: (T) -> B) -> Shelf[B] = Shelf(items.map(f))

// A second constructor trait with a static member, for a parameter bounded by both.
trait Empty[A]
  static empty[X]() -> Self[X]

impl Empty for Option
  static empty[X]() -> Option[X] = None

impl Empty for List
  static empty[X]() -> List[X] = List()

both[F[_]: Pointed & Empty](n: int) -> (F[int], F[string]) = (F.pure(n), F.empty())

wrap[F[_]: Pointed, A](a: A) -> F[A] = F.pure(a)

// The static member and a method of the bound, together.
wrapped[F[_]: Pointed](n: int) -> F[string] = F.pure(n).map(x -> s"<$x>")

// `F` passed on to another generic function, written and inferred from the expected type.
passed[F[_]: Pointed](n: int) -> F[int]
  val inner: F[int] = wrap(n)
  wrap[F, int](n + 1).map(m -> m * 10)

// A static member as a function value, in generic code and on a known constructor.
allPure[F[_]: Pointed](xs: List[int]) -> List[F[int]] = xs.map(F.pure)

// Inside a closure, which captures `n` and calls the constructor's member each time it runs.
later[F[_]: Pointed](n: int) -> () -> F[int] = () -> F.pure(n * 2)

// A partial application naming a type parameter in scope.
okIn[E](n: int) -> Result[int, E] = Result[_, E].pure(n)

class Maker[F[_]: Pointed]
  make(s: string) -> F[string] = F.pure(s)

data Point(x: int, y: int)

main()
  println(wrap[Option, int](1))
  println(wrap[List, string]("é"))
  println(wrap[Result[_, string], int](3))
  println(wrap[Either[int, _], bool](true))
  println(wrap[Box, int](5).value)
  println(wrap[Crate, int](6).item)
  println(wrap[Parsed, int](7))
  println(wrap[Option, Point](Point(1, 2)))
  println(wrap[List, (int, string)]((1, "")))
  val inferred: Option[char] = wrap('λ')
  println(inferred)
  println(wrapped[Option](8))
  println(wrapped[Result[_, bool]](9))
  println(passed[List](4))
  println(passed[Crate](4).item)
  println(allPure[Option](List(1, 2)))
  println(allPure[Result[_, char]](List(3)))
  println(allPure[List](List()))
  println(later[List](21)())
  println(later[Box](-1)().value)
  println(okIn[string](9))
  println(Maker[Option]().make("m"))
  println(Maker[Either[unit, _]]().make(""))
  println(both[Option](1))
  println(both[List](2))
  println(Option.empty[int]())
  println(Option.pure(1))
  println(List.pure("a"))
  println(Result[_, string].pure(2))
  println(Either[string, _].pure(3))
  println(Parsed.pure(4))
  println(Box.pure(5).value)
  println(Box[_].pure(5).value)
  println(Crate.pure(6).item)
  println(Shelf.pure("s").items)
  println(wrap[Shelf, int](7).map(n -> n + 1).items)
  println(Option.pure(int.MaxValue))
  println(Option.pure(long.MinValue))
  println(Option.pure(Option.pure(0)))
  val f: (int) -> Option[int] = Option.pure
  println(f(8))
  println(List(1, 2).map(Result[_, string].pure))
  println(Vector("x", "y").map(Box.pure).map(b -> b.value))
