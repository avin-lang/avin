// expect: exit 0
// Values of refined variants: each is called as a generic function of its parameters, its type
// arguments inferred from its fields and the type expected, or written on the variant, or on the type
// for the instance it makes. A value has the result's type at those arguments, and it is printed,
// compared, hashed and taken apart by a type pattern on `Any` as any data value is. `First`, whose
// `B` is hidden, is declared beside them and leaves the type's `Display` and equality whole.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  BoolLit(value: bool) -> Expr[bool]
  Add(a: Expr[int], b: Expr[int]) -> Expr[int]
  Eq(a: Expr[int], b: Expr[int]) -> Expr[bool]
  If(cond: Expr[bool], yes: Expr[T], no: Expr[T])
  Pair[A, B](first: Expr[A], second: Expr[B]) -> Expr[(A, B)]
  First[A, B](pair: Expr[(A, B)]) -> Expr[A]

class Holder(val e: Expr[int])

kind(x: Any) -> string = x match
  e: Expr[int] -> s"int $e"
  e: Expr[bool] -> s"bool $e"
  e: Expr[(int, bool)] -> s"pair $e"
  _ -> "other"

// A generic function makes a refined value at its own type argument.
twice[A](e: Expr[A]) -> Expr[(A, A)] = Pair(e, e)

main()
  val one = IntLit(1)
  val two = Add(one, IntLit(1))
  val same: Expr[bool] = Eq(one, two)
  val chosen = If(same, one, IntLit(2))
  val pair = Pair(chosen, BoolLit(true))
  // Every variant a value can be made of, in its `Display` and its `Debug` form.
  for e in [one, two, chosen]
    println(e)
  println(same)
  println(pair)
  println(debug(pair))
  println(If(BoolLit(false), BoolLit(true), same))
  // Boundary values in the fields.
  println(IntLit(-2147483648))
  println(Add(IntLit(2147483647), IntLit(0)))
  // Equality and hashing by variant and fields, at each instance.
  println(one == IntLit(1))
  println(one == IntLit(2))
  println(one != two)
  println(same == Eq(IntLit(1), Add(IntLit(1), IntLit(1))))
  println(pair == Pair(If(same, one, IntLit(2)), BoolLit(true)))
  println(pair == Pair(If(same, one, IntLit(2)), BoolLit(false)))
  println(one.hash() == IntLit(1).hash())
  println(pair.hash() == Pair(If(same, one, IntLit(2)), BoolLit(true)).hash())
  // Explicit type arguments on the variant, a prefix of them, and the instance on the type.
  val written = Pair[int, bool](IntLit(3), BoolLit(false))
  println(written)
  println(Pair[int](IntLit(4), same))
  println(Expr[int].If(BoolLit(true), one, two))
  println(Expr[(int, bool)].Pair(one, same))
  println(Expr.IntLit(5))
  println(Expr[bool].BoolLit(true) == BoolLit(true))
  // A generic function's refined value at two instances.
  println(twice(one))
  println(twice(pair))
  // `Expr[int]` and `Expr[bool]` in one `Vector[Any]`, told apart by type pattern.
  val mixed: Vector[Any] = [one, same, written, IntLit(6), "text", 7]
  for x in mixed
    println(kind(x))
  // In a class field, captured by a closure, and as a `Map` key.
  val h = Holder(two)
  println(h.e)
  println(h.e == two)
  val make = (b: bool) -> If(BoolLit(b), h.e, one)
  println(make(true))
  println(make(false))
  var names: Map[Expr[int], string] = Map()
  names = names.updated(one, "one").updated(two, "two").updated(chosen, "chosen")
  println(names.get(IntLit(1)))
  println(names.get(Add(IntLit(1), IntLit(1))))
  println(names.get(IntLit(9)))
  println(names.size)
