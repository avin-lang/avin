// expect: exit 0
// Option's `okOr` and `okOrElse` on Some and None, laziness, generic instances; Result's `ok` and
// `err` back to options.

var calls = 0

fresh() -> string
    calls += 1
    "made"

first[T](xs: Vector[T]) -> Option[T] = if xs.isEmpty() then None else Some(xs(0))

lookup[T](xs: Vector[T]) -> Result[T, string] = first(xs).okOr("empty")

main()
    val some: Option[int] = Some(3)
    val none: Option[int] = None
    println(some.okOr("e"))
    println(none.okOr("e"))
    println(some.okOrElse(() -> "e"))
    println(none.okOrElse(() -> "e"))

    println(some.okOrElse(fresh))
    println(calls)
    println(none.okOrElse(fresh))
    println(calls)

    println(lookup([1, 2]))
    println(lookup(Vector.empty[string]()))
    println(lookup(["a"]))

    val nested: Option[Option[int]] = Some(None)
    println(nested.okOr(0))
    val noneOfNone: Option[Option[int]] = None
    println(noneOfNone.okOr(0))

    val ok: Result[int, string] = Ok(1)
    val err: Result[int, string] = Err("bad")
    println(ok.ok())
    println(ok.err())
    println(err.ok())
    println(err.err())
    println(some.okOr("e").ok() == some)
    println(none.okOr("e").err())
    println(Some("").okOr(1))
    println(Some(long(9223372036854775807)).okOr(1))
