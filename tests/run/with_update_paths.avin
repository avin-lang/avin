// expect: exit 0
// A path of field names changes a field inside a field, at any depth, and leaves the rest of every
// value along it as it was. Paths and plain fields mix, and paths sharing a prefix change one value
// made once for that prefix. The base is never changed.

data Point(x: int, y: int)

data Sprite(pos: Point, name: string)

data Layer(top: Sprite, depth: int)

data Scene(layer: Layer, title: string)

main() -> int
  val s = Sprite(Point(1, 2), "ship")
  // Depth 1 and 2 in one clause.
  val t = s with {pos.x = 3, name = "ghost"}
  println(s)
  println(t)
  // Two paths through one prefix.
  val u = s with {pos.x = 10, pos.y = 20}
  println(u)
  // The order of the paths does not matter to the result.
  if (s with {pos.y = 20, pos.x = 10}) != u then return 1
  // Depth 3.
  val l = Layer(s, 1)
  println(l with {top.pos.y = 7})
  println(l with {top.pos.y = 7, top.name = "n", depth = 2})
  // Depth 4, reaching every level once.
  val sc = Scene(l, "main")
  println(sc with {layer.top.pos.x = 0, layer.top.name = "deep", layer.depth = 9, title = "t"})
  println(sc with {layer.top.pos = Point(5, 6)})
  println(sc with {layer.top = Sprite(Point(8, 8), "whole")})
  // Siblings at different depths under one prefix.
  println(sc with {layer.depth = 4, layer.top.pos.x = 4})
  println(sc)
  // The value of a change may read the base.
  println(s with {pos.x = s.pos.x + s.pos.y})
  0
