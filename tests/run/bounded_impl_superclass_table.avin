// expect: exit 0
// A bounded impl of a trait for an abstract or open class places the trait in the method table of
// each subclass instance only where the instance meets the bounds. An instance that misses them
// (a `Vector[byte]`, a `Sub[byte]`) leaves the slot empty, so a call through a union or `Any` that
// reaches the trait's slot compiles; an instance that meets them is called through it as before.
trait Enc
    enc() -> string

impl Enc for int
    enc() -> string = s"i$self"

impl Enc for string
    enc() -> string = s"s$self"

impl[A: Enc] Enc for Vector[A]
    enc() -> string = s"[${self.map(a -> a.enc()).mkString(",")}]"

open class Holder[T](val item: T)

class Sub[T](x: T): Holder[T](x)

impl[T: Enc] Enc for Holder[T]
    enc() -> string = s"holder ${item.enc()}"

show[A: Enc](a: A) -> string = a.enc()

describe(x: Any) -> string = x match
    e: Enc -> e.enc()
    _ -> "none"

main()
    val bytes: Vector[byte] = [byte(1)]
    val sub = Sub(byte(2))
    println(bytes, sub.item)
    val u: int | string = 3
    println(show(u))
    val w: Vector[int] | string = [1, 2]
    println(show(w))
    println(show(Sub(5)))
    val held: Holder[string] | int = Sub("s")
    println(show(held))
    println(describe([7]), describe(bytes), describe(Sub(1)), describe(sub))
