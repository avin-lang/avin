// expect: exit 0
// env: AVIN_GC_STRESS=0
// A deque of a hundred thousand references and more, added at both ends and taken from the front as
// it goes, so its elements wrap around its array at every size it grows through, keeps them in order,
// every one surviving the collections its growth and its jobs set off. The collector runs as it
// ordinarily does, when the heap's budget is spent; `deques.avin` runs a deque under the stressed
// collector.

class Job(val id: int)

main()
    val d = Deque[Job]()
    for i in 0 ..< 150000
        d.addLast(Job(i))
        if i % 3 == 0 then d.addFirst(Job(-i))
        if i % 2 == 0 then d.removeFirst()
    var sum = long(0)
    for j in d do sum += long(j.id)
    print(s"${d.length()} $sum ${d.head().id} ${d.last().id}")

    // Taken from both ends until empty, each end in its own order.
    var ordered = true
    var previous = d.head().id - 1
    while d.length() > 1
        val front = d.removeFirst()
        if front.id <= previous then ordered = false
        previous = front.id
        d.removeLast()
    print(s"$ordered ${d.length()}")

    // A stack of a hundred thousand, popped back to empty.
    val stack = Deque[Job]()
    for i in 0 ..< 100000 do stack.addFirst(Job(i))
    var expected = 99999
    var right = true
    while stack.nonEmpty()
        if stack.removeFirst().id != expected then right = false
        expected -= 1
    print(s"$right ${stack.length()}")
