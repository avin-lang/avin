// expect: trap
// `${name}` in a replacement is a group the pattern names; the names given to the regex do not
// count, and a name no group of the pattern has traps.
import avin.regex.Regex

main()
    println(Regex("(?<word>\\w+)").replaceAllIn("hi", "<${word}>"))
    println(Regex("(\\w+)", "word").replaceAllIn("hi", "<${word}>"))
