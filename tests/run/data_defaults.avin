// A variant's field may have a default, as a constructor's parameter may: a function of the fields
// before it, called where a construction omits the field, positionally or by name.

data Range(low: int = 0, high: int = low + 10, step: int = 1)

data Shape
  Box(width: int, height: int = width)
  Line(length: int = 1)

// A generic data type's default sees the type's parameters through the fields before it.
data Tagged[T](value: T, tag: string = "untagged", copy: T = value)

var counter = 100

next() -> int
  counter += 1
  counter

data Ticket(id: int = next(), name: string = "anon")

area(s: Shape) -> int = s match
  Box(w, h) -> w * h
  Line(n) -> n

main()
  val a = Range()
  println(s"${a.low} ${a.high} ${a.step}")
  val b = Range(5)
  println(s"${b.low} ${b.high} ${b.step}")
  val c = Range(high = 3)
  println(s"${c.low} ${c.high} ${c.step}")
  val d = Range(1, step = 2)
  println(s"${d.low} ${d.high} ${d.step}")
  println(s"${area(Box(3))} ${area(Box(3, 4))} ${area(Line())} ${area(Line(7))}")
  val t = Tagged(4)
  println(s"${t.value} ${t.tag} ${t.copy}")
  val u = Tagged("x", "named")
  println(s"${u.value} ${u.tag} ${u.copy}")
  val first = Ticket()
  val second = Ticket(name = "bo")
  val third = Ticket(7)
  println(s"${first.id} ${first.name} ${second.id} ${second.name} ${third.id} ${third.name}")
