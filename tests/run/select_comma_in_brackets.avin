// expect: exit 0
// Inside brackets whose commas separate items a comma after a `select`'s last one-line arm ends the
// arm, the `select` and the item, as it ends a match's: the items after it are the bracket's own, in
// a call (positional and named), a tuple and a vector. A tuple body there is written in
// parentheses. A select in a block whose last line closes a bracket opened before the block ends at
// that line's comma too, and an indented arm body is a block as before.
import avin.threads.{Channel, spawn}
import avin.time.millis

pair(a: string, b: int) -> string = s"$a/$b"

named(a: string, n: int = 0) -> string = s"$a:$n"

main() -> int
  val c = Channel[int](4)
  c.send(1)
  println(select
    c.receive() as Some(x) -> s"got $x"
    else "none", 2)
  println(pair(select
    c.receive() as Some(x) -> s"got $x"
    else "none", 3))
  c.send(4)
  println(named(select
    c.receive() as Some(x) -> s"got $x"
    after 0.millis -> "at once", n = 5))
  println((select
    else "else", 6))
  println([select
    c.receive() as Some(x) -> s"got $x"
    else "empty", "next"])
  // A tuple body is written in parentheses.
  c.send(8)
  val t = (select
    c.receive() as Some(x) -> (x, x + 1)
    else (0, 0), "after")
  println(t)
  // A lambda whose last line is a select's arm closes the call's bracket at its comma.
  val worker = spawn(() ->
    val d = Channel[int](1)
    d.send(9)
    select
      d.receive() as Some(x) -> x * 2
      else 0, stack = 1048576)
  println(worker.join())
  // An indented arm body is a block: a comma there makes a tuple.
  c.send(10)
  println(select
    c.receive() as Some(x) ->
      x, x
    else (0, 0))
  // Outside brackets a one-line arm's comma list is a tuple, as before.
  c.send(11)
  val u = select
    c.receive() as Some(x) -> x, "tuple"
    else 0, "none"
  println(u)
  0
