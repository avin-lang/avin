// expect: exit 0
// A combinator library whose grammars are module-level values: a `Parser[T]` holds a `@sendable`
// function, so it is sendable at every `T`, and a recursive grammar of module-level `lazy val`s is
// used from spawned threads, with a deep stack, each parsing its own input. A combinator takes and
// makes `@sendable` functions, and the lambdas it writes capture only sendable parsers and functions.
import avin.threads.spawn

data Input(chars: Vector[char], at: int)

data Parser[T](run: @sendable (Input) -> Option[(T, Input)])

input(text: string) -> Input = Input(text.chars.toVector, 0)

satisfy(@sendable test: (char) -> bool) -> Parser[char] = Parser((in) ->
    if in.at < in.chars.length && test(in.chars(in.at)) then Some((in.chars(in.at), Input(in.chars, in.at + 1))) else None)

literal(c: char) -> Parser[char] = satisfy((x) -> x == c)

map[A, B](p: Parser[A], @sendable f: (A) -> B) -> Parser[B] = Parser((in) -> p.run(in).map((a, rest) -> (f(a), rest)))

seq[A, B](p: Parser[A], q: Parser[B]) -> Parser[(A, B)] = Parser((in) ->
    p.run(in) match
        Some((a, rest)) -> q.run(rest).map((b, last) -> ((a, b), last))
        None -> None)

orElse[T](p: Parser[T], q: Parser[T]) -> Parser[T] = Parser((in) ->
    p.run(in) match
        Some(found) -> Some(found)
        None -> q.run(in))

many[T](p: Parser[T]) -> Parser[List[T]] = Parser((in) ->
    var items: List[T] = Nil
    var at = in
    loop
        p.run(at) match
            Some((item, rest)) ->
                items = item :: items
                at = rest
            None -> break
    Some((items.reverse, at)))

// Folds a first value and the operator-value pairs after it, left to right.
chain(first: Parser[long], op: Parser[char], next: Parser[long], @sendable combine: (long, char, long) -> long) -> Parser[long] =
    map(seq(first, many(seq(op, next))), (head, rest) -> rest.foldLeft(head, (acc, pair) -> combine(acc, pair.0, pair.1)))

// A parser made only when it first runs, so a grammar may name itself.
later[T](@sendable make: () -> Parser[T]) -> Parser[T] = Parser((in) -> make().run(in))

all[T](p: Parser[T], text: string) -> Option[T] = p.run(input(text)) match
    Some((value, rest)) -> if rest.at == rest.chars.length then Some(value) else None
    None -> None

apply(a: long, op: char, b: long) -> long = op match
    '+' -> a + b
    '-' -> a - b
    '*' -> a * b
    _ -> a

lazy val digit: Parser[long] = map(satisfy((c) -> '0' <= c <= '9'), (c) -> long(int(c) - int('0')))
lazy val number: Parser[long] = map(seq(digit, many(digit)), (d, ds) -> ds.foldLeft(d, (acc, x) -> acc * 10 + x))
lazy val parenthesized: Parser[long] = map(seq(seq(literal('('), later(() -> expr)), literal(')')), (inner, _) -> inner.1)
lazy val factor: Parser[long] = orElse(number, parenthesized)
lazy val term: Parser[long] = chain(factor, literal('*'), factor, apply)
lazy val expr: Parser[long] = chain(term, orElse(literal('+'), literal('-')), term, apply)

// `depth` nested parentheses around one digit.
nested(depth: int) -> string
    var text = ""
    for _ in 0..<depth
        text = text + "("
    text = text + "7"
    for _ in 0..<depth
        text = text + ")"
    text

main()
    println(all(expr, "1+2*3"))
    println(all(expr, "(1+2)*3-4"))
    println(all(expr, ""))
    println(all(expr, "1+"))
    println(all(expr, "9223372036854775807"))
    val deep = nested(300)
    println(spawn(() -> all(expr, deep), stack = 67108864).join())
    val threads = (0..<4).map((i) -> spawn(() -> all(expr, s"$i*10+$i"))).toVector
    println(threads.map((t) -> t.join()))
    // A parser passed to a thread as a value, and one made on the thread.
    val p: Parser[long] = term
    println(spawn(() -> all(p, "6*7")).join())
    println(spawn(() -> all(map(number, (n) -> n + 1), "41")).join())
