// expect: trap
// A select whose every arm is guarded off, with no `after` or `else`, could be ended only by a
// cancellation, so it traps when it is reached rather than waiting for ever.
import avin.threads.Channel

main()
  val a = Channel[int](1)
  a.send(1)
  val open = false
  println("before")
  select
    a.receive() as Some(x) if open -> println(x)
    a.send(2) if open -> println("sent")
  println("after")
