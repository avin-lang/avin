// expect: exit 0
// The actor of the chapter: `actor Counter(start: int) receives CounterMsg` is a behaviour, made by
// `Counter(10)` without starting anything and started by `spawn`. Its body is its start: its fields
// and statements run once, on the actor's own execution, before it handles a message, and its `var`
// keeps its value from one message to the next. Two actors of one behaviour have state of their own,
// and a reference is shown by the declaration's name and the actor's number.
import avin.actors.{ActorRef, Behaviour, spawn}
import avin.threads.{Channel, Promise}

data CounterMsg
    Increment(by: int)
    Get(reply: Promise[int])
    Reset

actor Counter(start: int) receives CounterMsg
    var count = start

    receive
        Increment(by) -> count += by
        Get(replyTo) -> replyTo.complete(count)
        Reset -> count = 0

data LogMsg
    Note(text: string)
    Flush(done: Promise[unit])

// The body's statements run before any message, even one told before the actor was spawned's
// reference was handed back, and only once however many messages arrive.
actor Logged(log: Channel[string]) receives LogMsg
    log.send("body starts")
    var lines = 0
    val greeting = "hello"
    log.send(s"body made $greeting")

    receive
        Note(text) ->
            lines += 1
            log.send(s"$lines: $text")
        Flush(done) -> done.complete(())

get(c: ActorRef[CounterMsg]) -> int
    val p = Promise[int]()
    c.tell(Get(p))
    p.future.await()

main()
    val behaviour: Behaviour[CounterMsg] = Counter(10)
    println(behaviour.name)
    val counter = spawn(behaviour)
    counter.tell(Increment(5))
    counter tell Increment(2)
    println(get(counter))
    counter.tell(Reset)
    println(get(counter))
    counter.tell(Increment(-3))
    println(get(counter))
    // The same behaviour started again is a second actor, from the same arguments.
    val again = spawn(behaviour)
    println(get(again))
    println(get(counter))
    println(again != counter)
    println(s"$counter $again")
    val log = Channel[string](16)
    val logged = spawn(Logged(log))
    logged.tell(Note("one"))
    logged.tell(Note("two"))
    val done = Promise[unit]()
    logged.tell(Flush(done))
    done.future.await()
    for _ in 0..<4 do println(log.receive().get())
