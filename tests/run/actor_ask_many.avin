// expect: exit 0
// Many asks at once, each matched to its own reply: eight threads and a hundred futures ask one
// actor in parallel, and every answer is the one its own question asked for; an actor that answers
// out of order, the newest question first, still matches every reply to its ask; and actors asking
// each other pipe a thousand replies back, each counted once; and every reply reference is distinct,
// a set of fifty of them holding fifty.
import avin.actors.{ActorRef, AskError, spawn}
import avin.threads.Promise
import avin.threads as threads
import avin.time

data Square(n: int, reply: ActorRef[long])

actor Squarer receives Square
    receive
        Square(n, reply) -> reply.tell(long(n) * long(n))

data Backwards
    Question(n: int, reply: ActorRef[int])
    Answer

// Holds every question until told to answer, then answers the newest first.
actor Reverser receives Backwards
    var held: List[(int, ActorRef[int])] = List()
    receive
        Question(n, reply) -> held = (n, reply) :: held
        Answer ->
            var distinct: Set[ActorRef[int]] = Set()
            for (_, reply) in held do distinct = distinct.incl(reply)
            println(s"${distinct.size} distinct replies")
            for (n, reply) in held do reply.tell(n + 1000)
            held = List()

data Peer
    Start(other: ActorRef[Peer], count: int, done: Promise[int])
    Bump(n: int, reply: ActorRef[int])
    Back(expected: int, got: Result[int, AskError])

actor Pair receives Peer
    var waiting = 0
    var right = 0
    var finished: Option[Promise[int]] = None
    receive
        Start(other, count, done) ->
            finished = Some(done)
            waiting = count
            for i in 0..<count do pipeToSelf(other.ask(r -> Bump(i, r), time.seconds(60)), g -> Back(i + 1, g))
        Bump(n, reply) -> reply.tell(n + 1)
        Back(expected, got) ->
            if got == Ok(expected) then right += 1
            waiting -= 1
            if waiting == 0 then finished.get.complete(right)

main()
    val patience = time.seconds(60)
    val squarer = spawn(Squarer())
    // Eight threads, each asking two hundred questions and checking each answer.
    val counts = (0..<8).map(t -> threads.spawn(() ->
        var bad = 0
        for i in 0..<200
            val n = t * 1000 + i
            if squarer.ask(r -> Square(n, r), patience).await() != Ok(long(n) * long(n)) then bad += 1
        bad)).toVector
    println(counts.map(h -> h.join()).foldLeft(0, (a, b) -> a + b))
    // A hundred futures asking at once, their answers gathered after.
    val asks = (0..<100).map(i -> squarer.ask(r -> Square(i, r), patience)).toVector
    var sum: long = 0
    for a in asks
        a.await() match
            Ok(v) -> sum += v
            Err(_) -> sum -= 1_000_000
    println(sum)
    // Out of order: the newest question is answered first, every reply still its own.
    val reverser = spawn(Reverser())
    val questions = (0..<50).map(i -> reverser.ask(r -> Question(i, r), patience)).toVector
    reverser.tell(Answer)
    var matched = 0
    for i in 0..<50
        if questions(i).await() == Ok(i + 1000) then matched += 1
    println(matched)
    // Two actors asking each other, a thousand replies piped back.
    val a = spawn(Pair())
    val b = spawn(Pair())
    val done = Promise[int]()
    a.tell(Start(b, 1000, done))
    println(done.future.await())
