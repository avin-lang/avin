// expect: trap
// Recursion without a base case on a thread asking for a stack of one byte, which is given the least
// stack a thread has, overflows it and stops the program with the stack overflow trap, not a fault.
import avin.threads.spawn

descend(n: int) -> int = descend(n + 1) + n

main() -> int
  println("before")
  val t = spawn(() -> descend(0), 1)
  println(t.join())
  println("after")
  0
