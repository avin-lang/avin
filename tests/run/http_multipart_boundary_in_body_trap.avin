// expect: trap
// A boundary a part's body holds would end the part early, so writing with it traps; one that holds
// only part of it, or it in another case, is written.
import avin.net.http.{Multipart, Part}

main()
  println(Multipart([Part.field("a", "-B")]).encoded("B").length)
  println(Multipart([Part.field("a", "x--b")]).encoded("B").length)
  val file = Part.file("f", "n", "text/plain", Array(byte(45), byte(45), byte(66)))
  println(Multipart([Part.field("a", "ok"), file]).encoded("B").length)
