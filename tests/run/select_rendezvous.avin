// expect: exit 0
// Two threads hand values back and forth through channels of capacity one, both sides using
// `select`: each side's send arm waits while the channel is full and its receive arm while it is
// empty, so every exchange parks one side until the other acts. Every value arrives once and in
// order. A select on the main thread, which is not a worker, waits on a lightweight thread's
// channel, and one on a lightweight thread waits on the main thread's.
import avin.threads.{Channel, spawn}

main() -> int
  val ping = Channel[int](1)
  val pong = Channel[int](1)
  val rounds = 2000
  // The far side: receives each value and sends it back doubled, each step a select.
  val echo = spawn(() ->
    var handled = 0
    var going = true
    while going
      select
        ping.receive() as Some(x) ->
          select
            pong.send(x * 2) -> handled++
        ping.receive() as None -> going = false
    handled)
  var sum: long = 0
  var inOrder = true
  for i in 0 ..< rounds
    select
      ping.send(i) -> ()
    val back = select
      pong.receive() as Some(y) -> y
      pong.receive() as None -> -1
    if back != i * 2 then inOrder = false
    sum += long(back)
  ping.close()
  println(echo.join(), inOrder, sum)

  // Both sides of one channel at once: a select sending while full and a select receiving, each on
  // its own thread, until every value has passed.
  val pipe = Channel[int](1)
  val count = 3000
  val producer = spawn(() ->
    for i in 0 ..< count
      select
        pipe.send(i) -> ()
    pipe.close()
    count)
  val consumer = spawn(() ->
    var next = 0
    var ok = true
    var going = true
    while going
      select
        pipe.receive() as Some(x) ->
          if x != next then ok = false
          next++
        pipe.receive() as None -> going = false
    (next, ok))
  println(producer.join(), consumer.join())
  0
