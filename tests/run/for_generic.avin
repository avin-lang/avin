// `for` in generic code: over an `Iterable[T]` parameter, whatever collection is passed, and over a
// type parameter bounded by `Iterable`. Each goes through the iterator the value hands out.

class Countdown(from: int): Iterable[int]
  override iterator() -> Iterator[int] = Ticks(from)

class Ticks(private var n: int): Iterator[int]
  override hasNext() -> bool = n > 0
  override next() -> int
    n -= 1
    n + 1

total[T](xs: Iterable[T], f: (T) -> int) -> int
  var sum = 0
  for x in xs do sum += f(x)
  sum

count[C: Iterable[string]](xs: C) -> int
  var n = 0
  for _ in xs do n += 1
  n

// An array is iterable as itself and through its iterator; an iterator is iterable too.
firstOver[T](xs: Iterable[T], f: (T) -> int, bound: int) -> int
  for x in xs
    if f(x) > bound then return f(x)
  -1

main()
  println(s"${total(Countdown(4), n -> n)}")
  println(s"${total(Array.fill(3, "ab"), s -> s.byteLength)}")
  println(s"${total(1..10, n -> n)}")
  println(s"${total(Array.tabulate(4, i -> i).iterator(), n -> n * n)}")
  println(s"${count(Array.fill(5, "x"))}")
  println(s"${firstOver(0..<100, n -> n * n, 50)} ${firstOver(Array.empty[int](), n -> n, 0)}")
  // Covariance: an iterable of dogs is an iterable of animals.
  val dogs: Iterable[Dog] = Array.tabulate(2, i -> Dog(s"rex$i"))
  val animals: Iterable[Animal] = dogs
  for a in animals do println(a.name())

open class Animal
  name() -> string = "animal"

class Dog(n: string): Animal()
  override name() -> string = n
