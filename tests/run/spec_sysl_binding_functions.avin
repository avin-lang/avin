// expect: exit 0
// A Sysl binding is otherwise an ordinary function: overloaded by its parameter types, given
// defaults and named arguments, private behind a public wrapper, and passed as a value.
@sysl("sysl.text.to_upper")
upper(s: string) -> string

@sysl("sysl.unicode.to_upper")
upper(c: char) -> char

@sysl("sysl.time.days_in_month")
private daysIn(year: int = 2024, month: int = 2) -> int

february() -> int = daysIn()

apply[A](f: A -> A, a: A) -> A = f(a)

main()
    println(upper("abc"))
    println(upper('q'))
    println(daysIn())
    println(daysIn(2023))
    println(daysIn(month = 4))
    println(february())
    println(apply[string](upper, "x"))
    val g: char -> char = upper
    println(g('z'))
