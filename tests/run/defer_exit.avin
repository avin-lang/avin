// expect: exit 4
// `process.exit` ends the program where it is called: the exit hooks run, and no deferred statement
// does, neither the caller's nor any enclosing block's.
import avin.process

leave(code: int) -> int
  defer println("leave: never printed")
  for i in 0 ..< 3
    defer println("turn: never printed")
    if i == 0 then process.exit(code)
  0

main()
  defer println("main: never printed")
  process.onExit(() -> println("exit hook ran"))
  println("before")
  println(leave(4))
