// expect: exit 0
// A function value is an object whose header names its exact function type, so a type pattern on a
// function type tests it: through `Any`, through a function type it is a subtype of, in generic code,
// and as a part of a tuple, an option, an array or a generic class. Parameters are contravariant and
// results covariant where they are references; a class or a collection that is a function is a value
// of its function type.

open class Animal(val name: string)

class Dog(name: string): Animal(name)

class Box[T](val item: T)

class Table(val base: int): (int) -> int
  apply(n: int) -> int = base + n

class Tripler(): Animal("tripler"), (int) -> int
  apply(n: int) -> int = n * 3

trait Named
  label() -> string

class Quadrupler(): Named, (int) -> int
  override label() -> string = "quadrupler"
  apply(n: int) -> int = n * 4

kind(x: Any) -> string = x match
  f: ((int) -> int) -> s"(int) -> int gives ${f(1)}"
  _: ((string) -> int) -> "(string) -> int"
  f: ((Dog) -> Animal) -> s"(Dog) -> Animal gives ${f(Dog("rex")).name}"
  _: (() -> Any) -> "() -> Any"
  _: (() -> int) -> "() -> int"
  _: Box[(int) -> int] -> "Box[(int) -> int]"
  _: ((int) -> string, int) -> "((int) -> string, int)"
  o: Option[(int) -> int] -> o match
    Some(f) -> s"some (int) -> int gives ${f(2)}"
    None -> "no function"
  _: Array[(string) -> int] -> "Array[(string) -> int]"
  _ -> "something else"

inc(n: int) -> int = n + 1

maker[T](x: T) -> () -> T = () -> x

twoOf[T](x: T) -> Array[T]
  val a: Array[T] = [x, x]
  a

isA[T](x: Any) -> bool = x is _: T

// A value of a function type may be of a narrower one.
narrowed(f: (Dog) -> Animal) -> string = f match
  _: ((Animal) -> Dog) -> "(Animal) -> Dog"
  _ -> "another (Dog) -> Animal"

// A value of a function type may be an object of a class extending it.
table(f: (int) -> int) -> string = f match
  t: Table -> s"table at ${t.base}"
  _ -> "a lambda"

// A function may be an instance of an open class or a trait, and such a value may be a function.
fromFunction(f: (int) -> int) -> string = f match
  a: Animal -> a.name
  n: Named -> n.label()
  _ -> "a plain function"

fromAnimal(a: Animal) -> string = a match
  f: ((int) -> int) -> s"an animal giving ${f(2)}"
  _ -> "an animal"

fromNamed(n: Named) -> string = n match
  f: ((int) -> int) -> s"a named giving ${f(2)}"
  _ -> "a named"

main() -> int
  println(kind(inc))
  val k = 5
  val add: (int) -> int = n -> n + k
  println(kind(add))
  println(kind((s: string) -> if s == "" then 0 else 1))
  val rename: (Animal) -> Dog = a -> Dog(a.name + "!")
  println(kind(rename))
  println(kind(maker("s")))
  println(kind(maker(3)))
  println(kind(maker(Dog("max"))))
  println(kind(Box(inc)))
  println(kind(Box((s: string) -> 1)))
  println(kind(((n: int) -> n.toString(), 1)))
  println(kind(((n: int) -> n, 1)))
  println(kind(Some(add)))
  val none: Option[(int) -> int] = None
  println(kind(none))
  println(kind(twoOf((s: string) -> 2)))
  println(kind(twoOf(inc)))
  println(kind([10, 20, 30]))
  println(kind(["a"]))
  println(kind(Table(100)))
  println(narrowed(rename))
  println(narrowed((d: Dog) -> d))
  println(table(Table(7)))
  println(table(inc))
  println(fromFunction(Tripler()))
  println(fromFunction(Quadrupler()))
  println(fromFunction(add))
  println(s"${fromAnimal(Tripler())}, ${fromAnimal(Dog("fido"))}, ${fromNamed(Quadrupler())}")
  println(s"${isA[(int) -> int](inc)} ${isA[(string) -> int](inc)} ${isA[(int) -> Any](inc)} ${isA[(int) -> int]([1])}")
  println(s"${isA[() -> Animal](maker(Dog("d")))} ${isA[() -> Dog](maker(Animal("a")))}")
  // Closures made in a loop keep their type across collections.
  var held: Any = inc
  var total = 0
  for i in 0 ..< 200
    val step = i
    val f: (int) -> int = n -> n + step
    held = f
    val g: Any = Box(s"n$i")
    if !(g is _: Box[string]) then return 1
    held match
      h: ((int) -> int) -> total += h(0)
      _ -> return 2
  println(s"total $total")
  val same: Any = add
  val again: Any = add
  if same != again then return 3
  0
