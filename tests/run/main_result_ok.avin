// expect: exit 0
// A `main` answering with `Result[unit, E]` exits with 0 on `Ok`, writing nothing to standard error,
// and `?` inside it passes an `Ok` through.
data Bad(why: string)

impl Display for Bad
    display(out: Writer, spec: FormatSpec) = out.write(s"bad: $why")

half(n: int) -> Result[int, Bad] = if n % 2 == 0 then Ok(n / 2) else Err(Bad(s"$n is odd"))

main() -> Result[unit, Bad]
    val a = half(84)?
    val b = half(a)?
    println(s"$a $b")
    Ok(())
