// expect: exit 0
// Givens are values: declared in blocks, at the top level and in objects, of classes, objects,
// traits, data types of one and several variants, generic instances and value types, each read by
// its name as a `val` is. A nested block's given hides an outer one of the same name, and a
// closure that reads one keeps it after its block ends.

trait Logger
  write(message: string) -> string

class Prefixed(prefix: string): Logger
  override write(message: string) -> string = prefix + message

class Pool[T](items: Vector[T])
  size() -> int = items.length

data Retries(count: int)

data Level
  Info
  Warn(code: int)

opaque type UserId = long

object SystemClock
  now() -> long = 42

object Config
  given retries = Retries(3)
  given level: Level = Level.Warn(7)

given appLog: Logger = Prefixed("app: ")
private given clock = SystemClock

levelCode(l: Level) -> int = l match
  Level.Info -> 0
  Level.Warn(code) -> code

keep() -> () -> string
  given log: Logger = Prefixed("kept: ")
  () -> log.write("later")

main()
  println(appLog.write("start"))
  println(clock.now())
  println(Config.retries.count)
  println(levelCode(Config.level))
  given pool = Pool([1, 2, 3])
  println(pool.size())
  given user: UserId = UserId(5)
  given retries = Retries(0)
  if retries.count == 0
    given retries = Retries(9)
    println(retries.count)
  println(retries.count)
  given журнал: Logger = Prefixed("ж ")
  println(журнал.write("unicode"))
  val later = keep()
  for i in 0..<1000
    val _ = Pool([i]).size()
  println(later())
