// expect: exit 0
// One field supplies the `val` of its name of every trait its type conforms to: two traits
// declaring `val label` are both read from the one field, of a class and of a data type.
trait Titled
    val label: string

trait Tagged
    val label: string
    tag() -> string = s"<$label>"

class Item(val label: string): Titled, Tagged

data Note(label: string)
impl Titled for Note
impl Tagged for Note

title(t: Titled) -> string = t.label

main()
    val item = Item("item")
    val tagged: Tagged = item
    println(title(item) + " " + tagged.label + " " + tagged.tag())
    val note = Note("note")
    val noted: Tagged = note
    println(title(note) + " " + noted.label + " " + noted.tag())
