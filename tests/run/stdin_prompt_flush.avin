// A prompt written with `print`, with no new line and no flush, is out before the program waits for
// standard input: the read sends it on its way first, so text another writer puts on standard output
// afterwards follows the prompt. A second read that finds the input already buffered has nothing to
// send and still answers, and so does one at the end of the input.
import avin.io
import avin.fs

main()
    print("name? ")
    val name = io.readLine().getOrElse("none")
    fs.writeText("/dev/stdout", "[typed]")
    println(s"hello $name")
    print("again? ")
    println(io.readLine().getOrElse("none"))
    println(io.readLine().isEmpty())
