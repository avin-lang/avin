// expect: trap
// A mirror's integer field converts from and to any Sysl integer, and a value the other side's type
// cannot hold stops the program where the binding is called, in each direction.

@sysl("sysl.time.Time")
data NarrowTime
    NarrowTime(us: i16)

@sysl("sysl.time.time")
timeAt(h: int, m: int, s: int) -> NarrowTime

@sysl("sysl.time.Date")
data WideDate
    WideDate(day: long)

@sysl("sysl.hint.black_box")
same(d: WideDate) -> WideDate

main()
    println(same(WideDate(-719468)))
    println(timeAt(0, 0, 0))
    println(timeAt(0, 0, 1))
