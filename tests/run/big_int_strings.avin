// expect: exit 0
// `BigInt` from text and back: decimal and every radix from 2 to 36, signs, leading zeros, either
// case of a letter digit, round trips of many-limb numbers in every radix, agreement with `long`'s
// `toRadix` and `toLongOption(radix)` in range, and the texts that are not numbers.

main()
    println(BigInt("0"))
    println(BigInt("-0"))
    println(BigInt("+0"))
    println(BigInt("000000000000000000000000000000"))
    println(BigInt("-000000000000000000000000000012"))
    println(BigInt("+123456789012345678901234567890"))
    println(BigInt("1000000000"))
    println(BigInt("999999999"))
    println(BigInt("-1000000000000000000"))
    println(BigInt("ff", 16))
    println(BigInt("FF", 16))
    println(BigInt("-Zz", 36))
    println(BigInt("101", 2))
    println(BigInt("0", 7))
    println(BigInt("777", 8))
    // Round trips in every radix, of numbers of many sizes and both signs.
    var roundTrips = 0
    var wrong = 0
    var x = BigInt("-1")
    for size in 0 ..< 12
        x = x * BigInt("-982451653098712345") + BigInt(size)
        for radix in 2 .. 36
            roundTrips += 1
            val text = x.toRadix(radix)
            if BigInt(text, radix) != x || BigInt.parse(text.toUpper, radix) != Some(x) then wrong += 1
        if BigInt(x.toString()) != x then wrong += 1
    println(s"round trips $roundTrips, wrong $wrong")
    println(x)
    println(x.toRadix(2))
    println(x.toRadix(36))
    // Agreement with `long` in range.
    var agree = true
    for n in [long.MinValue, -1000000000, -36, -1, 0, 1, 35, 36, 999999999, 1000000000, long.MaxValue]
        for radix in 2 .. 36
            if BigInt(n).toRadix(radix) != n.toRadix(radix) then agree = false
            if BigInt.parse(n.toRadix(radix), radix).map(_.toLong) != Some(n) then agree = false
    println(agree)
    println(BigInt(255).toRadix(16))
    println(BigInt(-255).toRadix(2))
    println(BigInt(0).toRadix(36))
    // Texts that are not numbers.
    for text in ["", "-", "+", " 1", "1 ", "1_000", "1,000", "1e5", "1.0", "--1", "+-1", "0x10", "١٢", "１２", "12a", "é"]
        println(s"\"$text\" ${BigInt.parse(text)}")
    println(BigInt.parse("12", 2))
    println(BigInt.parse("z", 35))
    println(BigInt.parse("Z", 36))
    println(BigInt.parse("g", 16))
    println(BigInt.parse("123456789012345678901234567890"))
