// expect: exit 0
// A priority queue gives the greatest element first by the element type's order or by a comparison
// it is made with; `Reverse` and `reverseOrder` turn either into least first. It iterates in heap
// order, `toSortedVector` gives dequeue order without emptying it, and every sequence of operations
// agrees with a sorted vector.
import avin.collections.mutable.PriorityQueue

data Job(priority: int, name: string) derives Ord

class Plain(val n: int)

// A deterministic stream of numbers in `0 ..< bound`.
class Lcg(private var state: int)
  next(bound: int) -> int
    state = (state * 75 + 74) % 65537
    (state / 3) % bound

check(ok: bool, what: string)
  if !ok then println(s"FAILED: ${what}")

descending(xs: Vector[int]) -> Vector[int] = xs.sortWith((a, b) -> b.compare(a))

main()
  // Empty.
  val e = PriorityQueue[int]()
  println(s"${e.size} ${e.isEmpty} ${e.nonEmpty} ${e.knownSize}")
  println(s"${e.headOption} ${e.dequeueOption()} ${e.dequeueAll()} ${e.toSortedVector()} ${e.toVector}")
  e.clear()
  println(e.size)

  // One element.
  val one = PriorityQueue[int]()
  one.addOne(42)
  println(s"${one.head} ${one.headOption} ${one.size} ${one.toVector}")
  println(s"${one.dequeue()} ${one.isEmpty}")

  // Greatest first from any order; head leaves the queue alone.
  val q = PriorityQueue[int]()
  q.enqueue(3, 9, 1, 7)
  q += 5
  q ++= [8, 2]
  println(s"${q.size} ${q.head} ${q.size}")
  println(q.toSortedVector())
  println(q.size)
  println(q.dequeueAll())
  println(q.isEmpty)

  // Duplicates are each kept and come out together.
  val dup = PriorityQueue[int]()
  dup.enqueue(2, 2, 2, 5, 5, 1, 1)
  println(dup.dequeueAll())

  // Boundary integers.
  val edge = PriorityQueue[int]()
  edge.enqueue(0, -2147483647 - 1, 2147483647, -1, 1)
  println(edge.dequeueAll())

  // Strings and reals.
  val words = PriorityQueue[string]()
  words.enqueue("pear", "apple", "", "fig", "zebra", "é")
  println(words.dequeueAll())
  val reals = PriorityQueue[real]()
  reals.enqueue(2.5, -1.0, 0.0, 10.25)
  println(reals.dequeueAll())

  // A data type with a derived order.
  val jobs = PriorityQueue[Job]()
  jobs.enqueue(Job(2, "b"), Job(9, "a"), Job(2, "c"), Job(5, "z"))
  for j in jobs.dequeueAll() do println(s"${j.priority}${j.name}")

  // dequeueOption and head traps are options, not traps, where empty is asked politely.
  val opt = PriorityQueue[int]()
  opt.addOne(4)
  println(s"${opt.dequeueOption()} ${opt.dequeueOption()} ${opt.headOption}")

  // A comparison of its own, least first, and Reverse and reverseOrder.
  val least = PriorityQueue.withOrdering[int]((x, y) -> y.compare(x))
  least.enqueue(5, 1, 4, 2, 3)
  println(least.dequeueAll())
  val rev = PriorityQueue[Reverse[int]]()
  for x in [5, 1, 4, 2, 3] do rev.addOne(Reverse(x))
  println(rev.dequeueAll().map(r -> r.value))
  val viaReverseOrder = PriorityQueue.withOrdering(reverseOrder(compareBy((j: Job) -> j.priority)))
  viaReverseOrder.enqueue(Job(7, "x"), Job(3, "y"), Job(5, "z"))
  println(viaReverseOrder.dequeueAll().map(j -> j.priority))

  // compareBy and thenBy: priority first, then name.
  val by = PriorityQueue.withOrdering(thenBy(compareBy((j: Job) -> j.priority), compareBy((j: Job) -> j.name)))
  by.enqueue(Job(1, "b"), Job(2, "a"), Job(1, "c"), Job(2, "z"))
  println(by.dequeueAll().map(j -> s"${j.priority}${j.name}"))

  // Iteration is in heap order: the greatest first, every element once, and a snapshot.
  val it = PriorityQueue[int]()
  it.enqueue(4, 8, 6, 2, 9, 1)
  val seen = it.toVector
  check(seen.size == 6 && seen(0) == 9, "iteration starts at the greatest")
  check(descending(seen) == it.toSortedVector(), "iteration holds every element once")
  var count = 0
  for x in it
    count += 1
    if count == 1 then it.enqueue(100)
    if count == 2 then it.dequeue()
  check(count == 6, "an iterator sees the queue as it was made")
  println(s"${it.size} ${it.head}")
  check(it.iterator().next() == it.head, "iterator's first is head")

  // Iterable conformance: the other operations.
  val q2 = PriorityQueue[int]()
  q2.enqueue(5, 1, 3)
  println(
    s"${q2.max} ${q2.min} ${q2.map(x -> x * 2).sum} ${q2.size} ${q2.exists(x -> x == 3)} ${q2.filter(x -> x > 1).size}"
  )

  // copy is independent and keeps the order.
  val orig = PriorityQueue.withOrdering[int]((x, y) -> y.compare(x))
  orig.enqueue(3, 1, 2)
  val cp = orig.copy()
  cp.addOne(0)
  println(s"${orig.size} ${cp.size} ${orig.head} ${cp.head} ${cp.dequeueAll()}")

  // A queue added to itself doubles each element.
  val selfq = PriorityQueue[int]()
  selfq.enqueue(1, 2)
  selfq ++= selfq
  println(selfq.dequeueAll())

  // The builder.
  val b = PriorityQueue.newBuilder[int]()
  b.addAll([4, 7, 1])
  val built = b.result()
  println(built.dequeueAll())
  b.clear()
  b.addOne(3)
  println(b.result().head)

  // A queue of queues, and of closures capturing.
  val inner = PriorityQueue[PriorityQueue[int]]((x, y) -> x.size.compare(y.size))
  val p1 = PriorityQueue[int]()
  val p2 = PriorityQueue[int]()
  p2.enqueue(1, 2)
  inner.enqueue(p1, p2)
  println(inner.head.size)

  // Clear then reuse.
  val reuse = PriorityQueue[int]()
  reuse.enqueue(1, 2, 3)
  reuse.clear()
  check(reuse.isEmpty, "cleared")
  reuse.enqueue(9, 8)
  println(reuse.dequeueAll())

  // Many pseudo-random sequences of operations against a sorted vector.
  var checked = 0
  for seed in 1 .. 60
    val rng = Lcg(seed)
    val bound = 1 + rng.next(40)
    val pq = PriorityQueue[int]()
    var model = Vector[int]()
    for step in 0 ..< 200
      val op = rng.next(4)
      if op < 2
        val x = rng.next(bound)
        pq.addOne(x)
        model = descending(model ++ [x])
      elif op == 2
        if model.isEmpty
          check(pq.dequeueOption() == None, "empty dequeueOption")
        else
          check(pq.dequeue() == model(0), s"dequeue seed ${seed} step ${step}")
          model = model.drop(1)
      else
        check(pq.headOption == model.headOption, s"head seed ${seed} step ${step}")
      check(pq.size == model.size, s"size seed ${seed} step ${step}")
      checked += 1
    check(pq.toSortedVector() == model, s"sorted seed ${seed}")
    check(pq.dequeueAll() == model, s"drain seed ${seed}")
  println(s"checked ${checked}")

  // Growing: a thousand elements in descending, ascending and shuffled order.
  for shape in 0 .. 2
    val big = PriorityQueue[int]()
    val rng = Lcg(7 + shape)
    for i in 0 ..< 1000
      big.addOne(if shape == 0 then 1000 - i elif shape == 1 then i else rng.next(500))
    val out = big.dequeueAll()
    check(out.size == 1000, "all out")
    var sorted = true
    for i in 1 ..< 1000
      if out(i - 1) < out(i) then sorted = false
    check(sorted, s"sorted shape ${shape}")
  println("grown")

  // A type with no order is queued by a comparison given to withOrdering.
  val plain = PriorityQueue.withOrdering[Plain]((x, y) -> x.n.compare(y.n))
  plain.enqueue(Plain(2), Plain(8), Plain(5))
  println(plain.dequeueAll().map(p -> p.n))
