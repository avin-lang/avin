// expect: exit 0
// A mirror of a Sysl enum with a variant `None`, as `sysl.hint.Locality` has, hides `Option`'s in
// the module; an expected `Option` still chooses `Option`'s, and the mirror's own uses are unchanged.
@sysl("sysl.hint.Locality")
data Locality
  None
  Low
  Medium
  High

hint(level: int) -> Option[Locality]
  if level < 0 then return None
  if level == 0 then return Some(None)
  Some(High)

describe(o: Option[Locality]) -> string = o match
  None -> "no hint"
  Some(None) -> "no locality"
  Some(l) -> s"$l"

main()
  println(describe(hint(-1)))
  println(describe(hint(0)))
  println(describe(hint(1)))
  val l: Locality = None
  val o: Option[Locality] = None
  println(s"$l $o ${l == None} ${o == None}")
  val ls: Vector[Locality] = [None, Low, Medium]
  println(ls)
