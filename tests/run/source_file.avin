// A `Source` over a file reads it whole when it is made, as `fs.readText` does: a file that is not
// there, a directory, or bytes that are not UTF-8 are the `Err`, and a source made is read like any
// other. Nothing is held open, so the file can go away while its source is still being read.
import avin.fs
import avin.io.{IoError, InvalidUtf8, IsADirectory, NotFound, Source}

count(src: Source) -> int = src.lines().count(l -> !l.isEmpty)

show(r: Result[Source, IoError]) -> string = r match
  Ok(src) -> src.lines().map(l -> s"[$l]").mkString(" ")
  Err(e) -> s"${e.kind}: ${e.message}"

// The temporary directory the test works in, written as `DIR` in what it prints, which an error
// names, so the output is the same on every run.
var root = ""

say(line: Any)
  println(if root == "" then s"$line" else s"$line".replace(root, "DIR"))

main()
  val dir = fs.createTempDir("avin-source") match
    Ok(d) -> d
    Err(e) ->
      say(s"no directory: $e")
      return
  root = dir
  val notes = dir + "/notes.txt"
  say(fs.writeText(notes, "first\r\n\nsecond ✓\nthird"))
  say(show(Source.fromFile(notes)))
  Source.fromFile(notes) match
    Ok(src) -> say(count(src))
    Err(e) -> say(e.message)
  // The file is read when the source is made, so removing it afterwards changes nothing.
  Source.fromFile(notes) match
    Ok(src) ->
      say(fs.remove(notes))
      say(s"[${src.lines().next()}] [${src.readAll().replace("\n", "|")}]")
    Err(e) -> say(e.message)
  // An empty file is a source with nothing in it.
  say(fs.writeText(dir + "/empty", ""))
  Source.fromFile(dir + "/empty") match
    Ok(src) -> say(s"${src.lines().hasNext()} ${src.chars().hasNext()} [${src.readAll()}]")
    Err(e) -> say(e.message)
  // A large file, line by line: the lines arrive in order and none is lost.
  val large = (0 ..< 20000).map(i -> s"line $i\n").mkString("")
  say(fs.writeText(dir + "/large", large))
  Source.fromFile(dir + "/large") match
    Ok(src) ->
      var n = 0
      var ordered = true
      for line in src.lines()
        if line != s"line $n" then ordered = false
        n += 1
      say(s"$n $ordered")
    Err(e) -> say(e.message)
  // Failures: missing, a directory, and bytes that are not UTF-8.
  say(show(Source.fromFile(dir + "/missing")))
  say(show(Source.fromFile(dir)))
  say(s"${fs.writeText(dir + "/raw", "ok\n")} ${fs.appendBytes(dir + "/raw", Array.fill(1, byte(0xff)))}")
  say(show(Source.fromFile(dir + "/raw")))
  Source.fromFile(dir + "/raw") match
    Err(IoError(InvalidUtf8(at), _, _)) -> say(s"invalid at $at")
    other -> say("unexpected")
  Source.fromFile(dir + "/missing") match
    Err(IoError(NotFound, _, _)) -> say("not found")
    other -> say("unexpected")
  Source.fromFile(dir) match
    Err(IoError(IsADirectory, _, _)) -> say("a directory")
    other -> say("unexpected")
  say(fs.removeDirAll(dir))
