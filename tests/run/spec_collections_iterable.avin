// expect: exit 0
// The methods every Iterable has, on a class of the program's own that conforms to `Iterable`, a
// set, a map's entries and a range: the first of equal keys and elements, the empty cases, sums of
// no reals and no strings, grouping in order, `collect` and `collectFirst` reaching no further than
// needed, and an iterator's transformations reading their source only as far as asked.
class Countdown(val from: int) : Iterable[int]
    override iterator() -> Iterator[int] = CountdownIterator(from)

class CountdownIterator(var at: int) : Iterator[int]
    override hasNext() -> bool = at > 0
    override next() -> int
        if at <= 0 then fail("exhausted")
        at -= 1
        at + 1

main()
    val c = Countdown(4)
    println(s"${c.head} ${c.last} ${c.headOption} ${Countdown(0).lastOption} ${c.isEmpty} ${Countdown(0).nonEmpty}")
    println(s"${c.foldLeft(0, (a, b) -> a * 10 + b)} ${c.reduce((a, b) -> a - b)} ${Countdown(0).reduceOption((a, b) -> a + b)}")
    println(s"${c.exists(x -> x == 2)} ${c.forall(x -> x > 0)} ${c.find(x -> x < 3)} ${c.count(x -> x % 2 == 0)}")
    println(s"${c.min} ${c.max} ${Countdown(0).maxOption} ${c.sum} ${c.product} ${Countdown(0).sum} ${Countdown(0).product}")
    println(s"${c.mkString("-")} ${c.mkString("<", "|", ">")} ${c.toList} ${c.toVector} ${c.zipWithIndex}")
    println(s"${c.partition(x -> x > 2)} ${c.toSet.size} ${c.view().map(x -> x * 2).toList}")

    val words = ["bb", "a", "cc", "ab", "b"]
    println(words.minBy(w -> w.byteLength))
    println(words.maxBy(w -> w.byteLength))
    println(words.minByOption(w -> w.byteLength))
    println(Vector.empty[string]().maxByOption(w -> w.byteLength))
    var keyed = 0
    println(words.maxBy(w ->
        keyed += 1
        w.byteLength))
    println(keyed)
    val grouped = words.groupBy(w -> w.byteLength)
    println(s"${grouped(1)} ${grouped(2)}")
    println(words.groupMap(w -> w.take(1), w -> w.byteLength)("a"))
    println(words.groupMapReduce(w -> w.take(1), w -> 1, (a, b) -> a + b)("b"))
    println(List[real]().sum)
    println(List[string]().sum)
    println(["x", "y", "z"].sum)
    println(max(3, 9, 4))
    println(min(5, [7, 2, 8]*))
    println(max(1))
    println([(1, "a"), (2, "b"), (1, "c")].toMap(1))
    println([1, 2, 1].toBuffer().length)
    println([3, 1, 3].toArray().length)

    val s = {3, 1, 2}
    println(s"${s.sum} ${s.count(x -> x > 1)} ${s.exists(x -> x == 3)} ${s.toList.sorted}")
    val m = {"a": 1, "b": -2}
    println(m.view().filter(e -> e.1 > 0).map(e -> e.0).toVector)
    println(m.foldLeft(0, (acc, e) -> acc + e.1))
    println(m.collect(match
        (k, v) if v > 0 -> (k + k, v * 10)))
    println((1..6).groupBy(x -> x % 3)(0))
    println((1..10).collectFirst(match
        x if x % 4 == 0 -> x * 100))
    var reached = 0
    val counted = (1..10).view().map(x ->
        reached += 1
        x)
    val firstEven = counted.collectFirst(match
        x if x % 2 == 0 -> x)
    println(s"$firstEven $reached")
    println(Some(3).collect(match
        x if x > 2 -> x.toString()))

    var calls = 0
    val it = (1..1000000).iterator().map(x ->
        calls += 1
        x * x)
    println(it.take(2).toVector)
    println(calls)
    var made = 0
    val flat = [1, 2, 3].iterator().flatMap(x ->
        made += 1
        [x, x])
    println(s"${flat.next()} ${flat.next()} $made ${flat.next()} $made")
    println([1, 2, 3].iterator().zip(["a", "b"]).toList)
    println(["p", "q"].iterator().zipWithIndex.toList)
    println([1, 2, 3, 4, 5].iterator().drop(1).takeWhile(x -> x < 4).toList)
    println([1, 5, 2].iterator().dropWhile(x -> x < 3).toList)
    val src = [1, 2].toBuffer()
    val v = src.view()
    src.append(3)
    println(v.toList)
    val once = [1, 2].iterator()
    println(s"${once.iterator().toList} ${once.toList}")
