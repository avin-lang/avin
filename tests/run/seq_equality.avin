// expect: exit 0
// Sequences of different kinds with the same elements in the same order are equal and hash alike,
// whether compared as their own types, as `Seq`s or as elements of other collections.

val v = [1, 2, 3]
val l: List[int] = [1, 2, 3]

hashOf(s: Seq[int]) -> long = s.hash()

main()
    println(v == l, l == v, v != l)
    println(v == (1..3), (1..3) == l, (1..<4) == v, (1..3) != (1..4))
    println(v.toArraySeq == l, v.toArraySeq == v)

    val buf = Buffer[int]()
    buf += 1
    buf += 2
    buf += 3
    val dq = Deque[int]()
    dq.append(2)
    dq.append(3)
    dq.prepend(1)
    val arr = Array.fill(3, 0)
    arr(0) = 1
    arr(1) = 2
    arr(2) = 3
    println(buf == v, dq == l, arr == v, buf == dq, arr == dq, arr == buf)
    println(buf == arr, dq == (1..3), (1..3) == arr)

    // Hashes agree.
    println(v.hash() == l.hash(), l.hash() == buf.hash(), dq.hash() == arr.hash(), (1..3).hash() == v.hash(), v.toArraySeq.hash() == l.hash())
    println(hashOf(v) == hashOf(l), hashOf(l) == hashOf(1..3))

    // Through the trait type.
    val a: Seq[int] = v
    val b: Seq[int] = l
    val c: Seq[int] = 1..3
    val d: Seq[int] = [1, 2]
    println(a == b, b == c, a == d, d != c, a == v, l == b)

    // Empty sequences.
    val e1: Vector[int] = []
    val e2: List[int] = []
    val e3 = 1..<1
    println(e1 == e2, e2 == e3, e1 == e3, e1.hash() == e2.hash(), e2.hash() == e3.hash(), e1 == v)

    // Unequal lengths and elements.
    println(v == [1, 2], [1, 2] == v, l == [1, 2, 4], v == [1, 2, 3, 4], (1..3) == [3, 2, 1])

    // Map and set keys across kinds.
    var m = Map.empty[Seq[int], string]()
    m = m.updated(v, "vector")
    println(m.getOrElse(l, "none"), m.getOrElse(1..3, "none"), m.getOrElse([1, 2], "none"), m.size)
    m = m.updated(l, "list")
    println(m.size, m.getOrElse(1..3, "none"))
    val s = Set.empty[Seq[int]]().incl(v).incl(l).incl(1..3).incl(d)
    println(s.size, s.contains(buf), s.contains([1, 2]))

    // Nested sequences.
    val nv: Vector[Vector[int]] = [[1], [2, 3]]
    val nl: List[List[int]] = [[1], [2, 3]]
    val ns: Seq[Seq[int]] = nv
    val nt: Seq[Seq[int]] = [(1..1), [2, 3]]
    val nls: Seq[Seq[int]] = nl
    println(nv == nls, ns == nt, nt == nv, nv.hash() == nl.hash(), ns.hash() == nt.hash(), nls == nt)
    val ts: Vector[(int, Vector[int])] = [(1, [2])]
    val us: List[(int, Vector[int])] = [(1, [2])]
    println(ts == us, ts.hash() == us.hash())

    // Strings and other element types.
    println(["a", "b"] == List("a", "b"), ["a", "b"] == List("a", "c"), [1.5, 2.5] == List(1.5, 2.5))

    // An equal pair of vectors built differently, and a long list against a vector.
    val big = (1..2000).toVector
    val bigList = (1..2000).toList
    println(big == bigList, big.hash() == bigList.hash(), big == (1..2000), big.take(1999) == bigList)
