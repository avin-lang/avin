// expect: exit 0
// A program's own sequence compares by elements with every other kind, unless its class implements
// `Eq` itself, in which case that is its equality; through `Any` values of different types stay
// unequal, and a long list compares in a loop.

class Squares(val n: int): Seq[int]
    override length() -> int = n
    override apply(i: int) -> int = i * i

class Loose(val n: int): Seq[int]
    override length() -> int = n
    override apply(i: int) -> int = i

impl Eq for Loose
    equals(other: Loose) -> bool = n == other.n

impl Hash for Loose
    hash() -> long = long(n)

main()
    val sq = Squares(4)
    val expected: Vector[int] = [0, 1, 4, 9]
    print(sq == expected, expected == sq, sq == Squares(4), sq == Squares(3), sq.hash() == expected.hash())

    // The class's own `Eq` wins between two of its instances, and a sequence of the same elements
    // still equals it.
    val a = Loose(3)
    val items: List[int] = [0, 1, 2]
    print(a == Loose(3), a == Loose(2), a == items, items == a)

    // Ranges compare by their values, not by identity.
    print((1..3) == (1..3), (1..3) == (1 ..< 4), (1..10 by 3) == (1..<11 by 3), (3..1 by -1) == [3, 2, 1], (5..1) == (2..<2))

    // `Any` holds the values' own types, so a vector and a list of the same elements are two values.
    val x: Any = expected
    val y: Any = expected.toList()
    val z: Any = [0, 1, 4, 9]
    print(x == y, x == z, x.hash() == y.hash())

    // Long lists compare and hash in loops.
    val long1 = (1..1000000).toList()
    val long2 = (1..1000000).toVector()
    print(long1 == long2, long1.hash() == long2.hash(), long1 == (1..1000000))
