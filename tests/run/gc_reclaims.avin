// expect: exit 0
// env: AVIN_GC_STRESS=0
// env: AVIN_HEAP_LIMIT=1048576
// Allocates many times the heap's one megabyte while keeping little alive: the collector frees what
// is no longer reachable, and what is still reachable survives every collection intact.

data List
  Cons(head: int, tail: List)
  Nil

range(from: int, to: int) -> List = if from > to then Nil else Cons(from, range(from + 1, to))

sum(xs: List) -> int = xs match
  Cons(h, t) -> h + sum(t)
  Nil -> 0

main() -> int
  val kept = range(1, 1000)
  var round = 0
  while round < 2000
    if sum(range(1, 100)) != 5050 then return 1
    round += 1
  if sum(kept) != 500500 then return 2
  0
