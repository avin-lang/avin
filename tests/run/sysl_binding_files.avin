// Files through Sysl's `sysl.fs`: `Result`s whose errors are a mirror of Sysl's `IoError` enum, and
// arrays of bytes copied in each direction. The program works in a directory of its own, which it
// makes and removes.

@sysl("sysl.fs.IoError")
data IoError
  NotFound
  PermissionDenied
  AlreadyExists
  NotADirectory
  IsADirectory
  DirectoryNotEmpty
  TooManyOpenFiles
  NoSpaceLeft
  Interrupted
  NotOpen
  NotPermitted
  // Sysl counts the offset in a `usize`; it comes out of Sysl as a `long`.
  InvalidUtf8(offset: long)
  Other(code: int)

@sysl("sysl.fs.make_temp_dir")
makeTempDir(prefix: string) -> Result[string, IoError]

@sysl("sysl.fs.remove_dir_all")
removeDirAll(dir: string) -> Result[unit, IoError]

@sysl("sysl.fs.read_text")
readText(file: string) -> Result[string, IoError]

@sysl("sysl.fs.write_text")
writeText(file: string, text: string) -> Result[unit, IoError]

@sysl("sysl.fs.read_bytes")
readBytes(file: string) -> Result[Array[byte], IoError]

@sysl("sysl.fs.write_bytes")
writeBytes(file: string, bytes: Array[byte]) -> Result[unit, IoError]

@sysl("sysl.encoding.hex_string")
hex(bytes: Array[byte]) -> string

@sysl("sysl.hint.black_box")
same(bytes: Array[byte]) -> Array[byte]

@sysl("sysl.hint.black_box")
sameError(e: IoError) -> IoError

@sysl("sysl.net.timed_out")
timedOut(e: IoError) -> bool

show(bytes: Array[byte]) -> string = s"${bytes.length}:${hex(bytes)}"

main()
  val dir = makeTempDir("avin-files") match
    Ok(d) -> d
    Err(e) ->
      println(s"no directory: $e")
      return
  val text = dir + "/text.txt"
  println(s"${writeText(text, "hello, wörld")} ${readText(text)}")
  // An empty file reads back as the empty string and as no bytes.
  println(s"${writeText(dir + "/empty", "")} [${readText(dir + "/empty")}]")
  readBytes(dir + "/empty") match
    Ok(b) -> println(s"empty ${show(b)}")
    Err(e) -> println(s"$e")
  // Bytes in and out: the array a binding returns is a new one, and changing it leaves the file's
  // copy alone.
  readBytes(text) match
    Ok(b) ->
      println(show(b))
      b(0) = byte(0x48)
      println(s"${show(b)} ${readText(text)}")
    Err(e) -> println(s"$e")
  val raw = Array.fill(4, byte(0xff))
  raw(1) = byte(0)
  println(s"${writeBytes(dir + "/raw", raw)} ${show(raw)}")
  // Bytes that are not UTF-8 are an error with a payload.
  println(s"${readText(dir + "/raw")}")
  println(s"${readText(dir + "/missing")} ${writeText(dir + "/no/such/dir", "x")}")
  // A directory read as a file.
  println(s"${readText(dir)}")
  // Arrays of bytes into Sysl and out again, the empty one too, and the copy is not the original.
  val copy = same(raw)
  copy(0) = byte(1)
  println(s"${show(same(Array.empty[byte]()))} ${show(copy)} ${show(raw)}")
  // A mirror into Sysl and out again, a variant with a payload and one without.
  println(s"${sameError(Other(42))} ${sameError(InvalidUtf8(7))} ${sameError(NotFound)} ${sameError(NotOpen)}")
  println(s"${timedOut(NotFound)} ${timedOut(Other(2))}")
  println(s"${removeDirAll(dir)} ${readText(text)}")
