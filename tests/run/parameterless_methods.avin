// expect: exit 0
// A method declared with no parameter list, `name -> T = …`, is called by its name alone, `x.name`,
// with no parentheses; one declared with `()` keeps them at the call. Naming a parameterless method
// calls it every time, on a receiver evaluated once per read: in a chain, an interpolation, a guard,
// a chained comparison, an operand of `#::`, a lambda that captures the read, and inside the class
// by its bare name or through `self`. Run under a collection at every allocation, at -O0 and -O2.

class Chain(items: Vector[int])
    head -> int = items(0)
    tail -> Chain = Chain(items.slice(1, items.length))
    isEmpty -> bool = items.length == 0
    second -> int = tail.head
    third -> int = self.tail.tail.head
    clear() -> Chain = Chain([])

class Counter
    var count = 0
    next -> int
        count += 1
        count
    peek() -> int = count

class Cell[T](item: T)
    get -> T = item
    pair -> (T, T) = (get, self.get)
    wrapped -> Cell[Cell[T]] = Cell(self)

object Config
    answer -> int = 42
    greeting -> string = s"answer $answer"

data Point(x: int, y: int)

impl Point
    sum -> int = x + y
    swapped -> Point = Point(y, x)

impl string
    shout -> string = self.toUpper + "!"

impl int
    doubled -> int = self * 2

class Edge
    least -> int = int.MinValue
    most -> long = long.MaxValue
    empty -> string = ""
    accent -> string = "héllo wörld ☃"

var made = 0

makeChain() -> Chain
    made += 1
    Chain([10, 20, 30])

main() =
    val c = Chain([1, 2, 3])
    println(c.head)
    println(c.tail.head)
    println(c.second)
    println(c.third)
    println(c.tail.tail.tail.isEmpty)
    println(c.clear().isEmpty)
    // Each read of a parameterless method runs it again.
    val k = Counter()
    println(k.next)
    println(k.next)
    println(k.peek())
    // A lambda captures the receiver and calls the method at each call of the lambda.
    val read = () -> k.next
    println(read())
    println(read())
    println(k.peek())
    // The receiver is evaluated once for each read.
    println(makeChain().head + makeChain().tail.head)
    println(made)
    println(Cell("hi").get)
    println(Cell(7).pair)
    println(Cell(true).wrapped.get.get)
    println(Config.answer)
    println(Config.greeting)
    println(Point(2, 3).sum)
    println(Point(2, 3).swapped)
    println(Point(2, 3).swapped.swapped.sum)
    println("hey".shout)
    println(21.doubled.doubled)
    println(s"${c.head} and ${c.tail.head} and ${Cell(1).get.toString()}")
    val m = 2 match
        n if n == c.second -> "matched"
        _ -> "no"
    println(m)
    println(if c.head < c.second < c.third then "rising" else "not")
    val stream = c.head #:: c.second #:: LazyList.empty[int]()
    println(stream.toVector)
    val e = Edge()
    println(e.least)
    println(e.most)
    println(e.empty.isEmpty)
    println(e.accent.charCount)
    println(e.accent.shout)
