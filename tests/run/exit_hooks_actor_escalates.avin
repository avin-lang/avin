// expect: trap
// A failure escalated past every actor stops the program, and the hooks run then, after the trap's
// report naming the actor, on the thread that stops the program. A hook registered by the actor
// that failed runs with the others.
import avin.actors.spawn
import avin.process
import avin.threads.Channel

actor Leaf(ready: Channel[int]) receives int
    process.onExit(() -> eprintln("the leaf's hook"))
    ready.send(1)
    receive
        n -> println(Vector(1, 2, 3)(n))

main()
    process.onExit(() -> eprintln("main's hook"))
    val ready = Channel[int]()
    val leaf = spawn(Leaf(ready))
    ready.receive()
    leaf.tell(9)
    leaf.ended().await()
    println("not reached")
