// expect: exit 0
// A call whose argument holds a typed pattern, `f(x is _: T)`, is a call and not a signature, also
// on the line before another call of the same name, in a block, a function's body and an object's
// body. A signature's `:` follows a parameter's name at the start of its item.

show(b: bool) = println(b)

object Probe
  val held: Any = "s"
  show(held is _: Vector[string])
  show(held is _: string)

local(w: Any)
  show(w is _: Vector[string])
  show(w is _: int)
  println(w is _: Option[int])
  println(w is _: int)

main()
  val w: Any = 1
  println(w is _: Vector[string])
  println(w is _: int)
  local(w)
  local(Probe.held)
  sig(x: int, y: string)
  sig(1, "a") = println("one")
  sig(_, y) = println(y)
  sig(1, "")
  sig(2, "two")
