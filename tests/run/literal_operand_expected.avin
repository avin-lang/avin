// expect: exit 0
// A collection literal, or a value built around number literals, given to an overloaded method or
// function takes its numbers from the parameter it is given to, as a bare literal does: with
// `v: Vector[long]`, `v ++ [400]` is a `Vector[long]`, and so is `v ++ List(400)` on a list. The
// element type the receiver decides reaches the literal through the method's lower-bounded type
// parameter, for every integer and decimal type, for a type of the program's own that takes
// integers, for nested literals, and through a generic function's earlier argument.

data Cents(amount: long)

impl FromInteger for Cents
  static fromInteger[N: Integer](n: N) -> Cents = Cents(long(n) * 100)

pair[T](a: Vector[T], b: Vector[T]) -> Vector[T] = a ++ b

// Overloads told apart by their element type: the literal takes the one the other argument decides.
pick(a: Vector[long], b: Vector[long]) -> string = s"long ${a ++ b}"
pick(a: Vector[string], b: Vector[string]) -> string = s"string ${a ++ b}"

// Overloads whose literal fits either take it as its own type, as before.
own(xs: Vector[int]) -> string = "int"
own(xs: Vector[long]) -> string = "long"

main() =
  val v: Vector[long] = [1, 2]
  val w = v ++ [400]
  val big: long = 5_000_000_000
  println(w)
  println(w.map(x -> x * 3_000_000_000))
  println(v ++ [9_223_372_036_854_775_807, -9_223_372_036_854_775_808])
  println(v ++ [big, 3])
  println(v ++ [])
  println(v :+ 400)
  println(400 +: v)
  val l: List[long] = List(1, 2)
  println(l ++ List(400))
  println(l ++ [400])
  println(l :+ 400)
  val s: Set[long] = {1}
  println(s ++ {400})
  println(s ++ [400])
  val m: Map[string, long] = {"a": 1}
  println(m ++ {"b": 2})
  val bytes: Vector[byte] = [1]
  println(bytes ++ [255])
  val reals: Vector[real] = [1.5]
  println(reals ++ [2])
  println(reals ++ [2.25, 3])
  val bigs: Vector[BigInt] = [1]
  println(bigs ++ [100_000_000_000_000_000_000])
  val decimals: Vector[BigDecimal] = [1]
  println(decimals ++ [0.1, 2])
  val cents: Vector[Cents] = [Cents(1)]
  println(cents ++ [2])
  val nested: Vector[Vector[long]] = [[1]]
  println(nested ++ [[5_000_000_000], []])
  val tuples: Vector[(long, real)] = [(1, 1.5)]
  println(tuples ++ [(2, 3)])
  val options: Vector[Option[long]] = [Some(1)]
  println(options ++ [Some(2), None])
  println(pair(v, [1]))
  println(pair([1], v))
  println(pair(cents, [3]))
  println(pair(bigs, [100_000_000_000_000_000_000]))
  println(pick(v, [1]))
  println(pick(["a"], ["b"]))
  println(own([1]))
  val captured = () -> v ++ [7]
  println(captured())
