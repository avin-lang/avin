// expect: exit 0
// A bracket opened on a declaration's line holds the declaration together across line breaks, however
// the line began: after a return type, in a module value, in a clause, in a parameter's default, in a
// field initializer, and with brackets nested.

sum(b: int) -> int = (b
    + 2)

add(a: int, b: int) -> int = a + b

call(b: int) -> int = add(b,
    2)

size(b: int) -> int = (b,
    2).1

val total = (1
    + 2)

pick(a: int) -> int
pick(0) = (10
    + 1)
pick(n) = n

withDefault(a: int = (1
    + 2)) -> int = a

apply(g: (int) -> int,
    h: int) -> int = g(h)

nested(b: int) -> int = ((b
    + 1)
    * (2,
        3).1)

class Holder(val n: int)
    val doubled = (n
        * 2)

main() -> int
    print(s"${sum(1)}")
    print(s"${call(5)}")
    print(s"${size(7)}")
    print(s"$total")
    print(s"${pick(0)}")
    print(s"${pick(5)}")
    print(s"${withDefault()}")
    print(s"${apply((x) -> x + 1, 4)}")
    print(s"${nested(1)}")
    print(s"${Holder(4).doubled}")
    0
