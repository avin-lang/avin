// expect: exit 0
// A mutable `BitSet` in `avin.collections.mutable` changes in place: `add` and `remove` answer whether
// the set changed, `+=`, `-=`, `++=` and `--=` need no `var`, and the in-place algebra takes another
// bit set. It is checked at the 64-bit word boundaries, with large sparse elements, and against a
// `HashSet` as the model. A negative element is never in it: `contains` and `remove` say no.
import avin.collections.mutable.{BitSet as MutableBitSet}

next(seed: long, n: int) -> (long, int)
    val s = (seed * 1103515245 + 12345) % 2147483648
    (s, int((s / 65536) % long(n)))

fill(seed: long, count: int, limit: int) -> (MutableBitSet, HashSet[int], long)
    var s = seed
    val b = MutableBitSet()
    var h = HashSet.empty[int]()
    for _ in 0 ..< count
        val r = next(s, limit)
        s = r.0
        b.add(r.1)
        h = h.incl(r.1)
    (b, h, s)

same(b: MutableBitSet, h: HashSet[int]) -> bool = b.size() == h.size() && h.forall(x -> b.contains(x)) && b.toVector().forall(x -> h.contains(x))

main()
    // Empty.
    val e = MutableBitSet()
    println(e, e.size(), e.isEmpty(), e.nonEmpty(), e.toBitMask(), e.headOption(), e.lastOption(), e.knownSize())
    println(e.minAfter(0), e.maxBefore(10), e.iterator().hasNext(), e.contains(0), e.remove(0), e == MutableBitSet.empty())

    // add and remove answer whether they changed the set, at the word boundaries.
    val m = MutableBitSet()
    for x in [0, 63, 64, 65, 127, 128] do println(m.add(x), m.add(x), m.contains(x))
    println(m, m.size(), m.toBitMask())
    println(m.contains(1), m.contains(62), m.contains(66), m.contains(129), m.contains(100000), m.contains(-1), m.contains(int.MinValue))
    println(m.remove(64), m.remove(64), m.remove(1), m.remove(-1), m.remove(100000), m.remove(int.MinValue), m)
    println(m.remove(128), m.toBitMask(), m.remove(127), m.toBitMask(), m.remove(63), m.remove(0), m.remove(65), m.toBitMask(), m.isEmpty())
    println(m.add(63), m.toBitMask(), m.headOption(), m.lastOption(), m(63), m(62))

    // The sign bit, and the empty set after clear.
    m.clear()
    println(m, m.size(), m.add(0), m.size())
    m.clear()
    println(m.toBitMask(), m == e, m.hash() == e.hash())

    // Compound assignment needs no var.
    val c = MutableBitSet(5, 3)
    c += 4
    c += 4
    c -= 5
    c -= 77
    c -= -2
    c ++= [10, 11, 64]
    c --= [11, 12, -1, 5000]
    println(c, c.size())
    c --= c
    println(c, c.isEmpty())
    c ++= c
    c ++= [1, 2]
    c ++= c
    println(c)
    c.addAll(10 ..< 14)
    println(c, c.size())
    c.filterInPlace(x -> x % 2 == 0)
    println(c)
    c.filterInPlace(x -> false)
    println(c, c.isEmpty())

    // Large sparse elements, growing and then holding the high words.
    val big = MutableBitSet(0, 4095, 4096, 20000, 40000)
    println(big, big.size(), big.toBitMask().length(), big.lastOption(), big.maxBefore(40000), big.minAfter(4097))
    big -= 40000
    println(big.toBitMask().length(), big.lastOption())
    println(MutableBitSet(30000).lastOption(), MutableBitSet(30000).size())

    // Ordered operations.
    val s = MutableBitSet(5, 3, 9, 1, 64, 63, 65, 200)
    println(s.headOption(), s.lastOption(), s.head(), s.last())
    println(s.minAfter(-5), s.minAfter(2), s.minAfter(64), s.minAfter(66), s.minAfter(201))
    println(s.maxBefore(-5), s.maxBefore(1), s.maxBefore(2), s.maxBefore(64), s.maxBefore(1000))
    println(s.toVector(), s.toList(), s.mkString(","))

    // In-place and new-set algebra.
    val a = MutableBitSet(1, 2, 3, 64, 100)
    val b = MutableBitSet(3, 4, 64, 200)
    println(a.union(b), a.intersect(b), a.diff(b), b.diff(a), a.symmetricDiff(b))
    println(a, b)
    val u = a.copy()
    u.unionInPlace(b)
    val i = a.copy()
    i.intersectInPlace(b)
    val d = a.copy()
    d.diffInPlace(b)
    val x = a.copy()
    x.symmetricDiffInPlace(b)
    println(u, i, d, x, a)
    val twin = a.copy()
    twin.unionInPlace(twin)
    println(twin == a)
    twin.diffInPlace(twin)
    println(twin, twin.toBitMask())
    val grown = MutableBitSet(1)
    grown.unionInPlace(MutableBitSet(5000))
    println(grown, grown.toBitMask().length())
    grown.intersectInPlace(MutableBitSet(1))
    println(grown, grown.toBitMask().length())
    grown.symmetricDiffInPlace(MutableBitSet(1))
    println(grown, grown.isEmpty(), grown.toBitMask())
    println(a.subsetOf(a), i.subsetOf(a), a.subsetOf(b), e.subsetOf(a), a.subsetOf(e))
    println(a.filter(x -> x % 2 == 0), a.map(x -> x / 2), a.flatMap(x -> [x, x + 1]), a.copy() == a, !(a.copy() === a))

    // Copies are independent, and so are the immutable sets taken from one.
    val orig = MutableBitSet(1, 2, 3)
    val cp = orig.copy()
    cp += 9
    val frozen = orig.toSet()
    orig += 7
    println(orig, cp, frozen, frozen == BitSet(1, 2, 3))
    val back = MutableBitSet.fromBitMask(frozen.toBitMask())
    back += 50
    println(back, frozen, MutableBitSet.fromBitMask([5, 0, 0]).toBitMask(), MutableBitSet.fromBitMask([]), MutableBitSet.fromBitMask([-1]).size())

    // An iteration is over the elements the set had when it began.
    val it = MutableBitSet(1, 2, 3)
    var seen = 0
    for x in it
        it += x + 10
        seen += 1
    println(seen, it)
    val reuse = MutableBitSet(4, 8)
    reuse.foreach(x -> reuse += x + 1)
    println(reuse)

    // Equality, hashes, display, the predicate, the builder and the companion.
    println(MutableBitSet(1, 2) == MutableBitSet(2, 1), MutableBitSet(1, 2) != MutableBitSet(1, 3), MutableBitSet(1) != MutableBitSet(1, 70))
    println(MutableBitSet(1, 2).hash() == HashSet(1, 2).hash(), MutableBitSet(1, 2).hash() == BitSet(1, 2).hash())
    println(MutableBitSet(1, 2).toSet() == BitSet(1, 2), MutableBitSet(1, 2).toSet().toVector())
    val pred = MutableBitSet(2, 3)
    println([1, 2, 3, 4].filter(pred), s"${MutableBitSet(1, 2)}", MutableBitSet(), MutableBitSet(7, 7))
    val bld = MutableBitSet.newBuilder()
    bld.addOne(9)
    bld.addOne(2)
    bld.addOne(9)
    println(bld.knownSize(), bld.result())
    bld.clear()
    bld.addOne(1)
    println(bld.result())
    val shown: MutableBitSet = MutableBitSet(3, 1)
    println(for p in shown if p > 1 yield p * 2)
    println(for p in MutableBitSet(1, 2, 3) if p > 1 if p < 3 yield p * 2)

    // A model check against a HashSet over random sets of several densities.
    var seed: long = 11
    var checked = 0
    var bad = 0
    for limit in [10, 64, 65, 200]
        for _ in 0 ..< 3
            val r1 = fill(seed, 30, limit)
            val r2 = fill(r1.2, 20, limit)
            seed = r2.2
            val b1 = r1.0
            val h1 = r1.1
            val b2 = r2.0
            val h2 = r2.1
            if !same(b1, h1) || !same(b2, h2) then bad += 1
            if !same(b1.union(b2), h1.union(h2)) then bad += 1
            if !same(b1.intersect(b2), h1.intersect(h2)) then bad += 1
            if !same(b1.diff(b2), h1.diff(h2)) then bad += 1
            if b1.subsetOf(b2) != h1.subsetOf(h2) then bad += 1
            val sym = b1.symmetricDiff(b2)
            if !same(sym, h1.union(h2).diff(h1.intersect(h2))) then bad += 1
            if !same(b1.filter(x -> x % 3 == 0), h1.filter(x -> x % 3 == 0)) then bad += 1
            val t = b1.copy()
            t.unionInPlace(b2)
            if !same(t, h1.union(h2)) then bad += 1
            t.intersectInPlace(b2)
            if !same(t, h2) then bad += 1
            t.diffInPlace(b1)
            if !same(t, h2.diff(h1)) then bad += 1
            val probe = limit / 2
            val sorted = TreeSet.empty[int]() ++ h1
            if b1.headOption() != sorted.headOption() || b1.lastOption() != sorted.lastOption() then bad += 1
            if b1.minAfter(probe) != sorted.minAfter(probe) || b1.maxBefore(probe) != sorted.maxBefore(probe) then bad += 1
            if b1.hash() != h1.hash() || b1.toSet().toVector() != sorted.toVector() then bad += 1
            for x in 0 ..< limit + 2
                if b1.contains(x) != h1.contains(x) then bad += 1
            checked += 1
    println("model", checked, bad)

    // Allocation under pressure: many sets grown, combined and dropped.
    var total = 0
    for k in 0 ..< 40
        val g = MutableBitSet()
        for j in 0 ..< 10 do g += k * 7 + j * 13
        total += g.size() + g.toBitMask().length()
        g.unionInPlace(MutableBitSet(k))
        g -= k
        total += g.size()
    println(total)
