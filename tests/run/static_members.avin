// expect: exit 0
// Static members of a trait: `Add`'s `zero` and `Mul`'s `one`, called on a type and on a bounded type
// parameter, at built-in types, a data type, a class, and a program's own generic trait.

data Point(x: int, y: int)

impl Add for Point
    add(other: Point) -> Point = Point(x + other.x, y + other.y)
    static zero() -> Point = Point(0, 0)

class Money(val cents: long): Add, Mul
    override add(other: Money) -> Money = Money(cents + other.cents)
    override static zero() -> Money = Money(0)
    override multiply(other: Money) -> Money = Money(cents * other.cents)
    override static one() -> Money = Money(1)

total[T: Add](a: T, b: T, c: T) -> T
    var sum = T.zero()
    sum = sum + a
    sum = sum + b
    sum + c

power[T: Mul](x: T, n: int) -> T
    var result = T.one()
    for _ in 0..<n
        result = result * x
    result

// A trait of the program's own, generic, with a static member that takes an argument.
trait Source[A]
    next() -> A
    static starting(seed: A) -> Self

data Counter(n: int)

impl Source[int] for Counter
    next() -> int = n + 1
    static starting(seed: int) -> Counter = Counter(seed * 10)

first[S: Source[int]](seed: int) -> int = S.starting(seed).next()

// A static member with a default argument, which every implementation takes.
trait Shaped
    static unit(scale: int = 3) -> Self
    area() -> int

data Square(side: int)

impl Shaped for Square
    static unit(scale: int) -> Square = Square(scale)
    area() -> int = side * side

measured[T: Shaped]() -> int = T.unit().area() + T.unit(scale = 1).area()

// An open class's static member, through a bound at the class itself and at a subclass that inherits it.
open class Tally(val n: int): Add
    override add(other: Tally) -> Tally = Tally(n + other.n)
    override static zero() -> Tally = Tally(100)

class Marked(n: int): Tally(n)

// A generic data type whose static member calls its type arguments' own.
data Pair[A, B](first: A, second: B)

impl[A: Add, B: Add] Add for Pair[A, B]
    add(other: Pair[A, B]) -> Pair[A, B] = Pair(first + other.first, second + other.second)
    static zero() -> Pair[A, B] = Pair(A.zero(), B.zero())

// A static member calling another of its type, by the type's name.
data Grid(n: int)

impl Add for Grid
    add(other: Grid) -> Grid = Grid(n + other.n)
    static zero() -> Grid = Grid(Pair[int, int].zero().first + 7)

zeroOf[T: Integer]() -> T = T.zero()

// A static member with a type parameter of its own, called at two type arguments through one bound.
trait Parse
    static parse[B](text: string, tag: B) -> (Self, B)

data Num(n: int)

impl Parse for Num
    static parse[B](text: string, tag: B) -> (Num, B) = (Num(text.byteLength), tag)

read[T: Parse](text: string) -> T
    val (value, flag) = T.parse(text, true)
    val (again, _) = T.parse(text, "x")
    if flag then value else again

main()
    println(s"${int.zero()} ${long.one()} ${i8.zero()} ${real.zero()} ${real.one()} [${string.zero()}]")
    println(s"${total(1, 2, 3)} ${total(1.5, 2.5, 3.0)} ${total("a", "b", "c")}")
    println(s"${total(Point(1, 2), Point(3, 4), Point(5, 6))} ${Point.zero()}")
    println(s"${total(Money(1), Money(2), Money(3)).cents} ${power(Money(3), 3).cents} ${Money.zero().cents}")
    println(s"${power(2, 10)} ${power(long(2), 40)} ${power(1.5, 2)} ${power(3, 0)}")
    println(s"${first[Counter](4)} ${Counter.starting(2)}")
    println(s"${measured[Square]()} ${Square.unit()} ${Square.unit(5)}")
    println(s"${total(Tally(1), Tally(2), Tally(3)).n} ${total[Tally](Marked(1), Marked(2), Marked(3)).n} ${Marked.zero().n}")
    println(s"${total(Pair(1, "a"), Pair(2, "b"), Pair(3, "c"))} ${Pair[real, string].zero()}")
    println(s"${Grid.zero()} ${zeroOf[i5]()} ${zeroOf[i128]()} ${i257.one()}")
    println(s"${total(Marked(1), Marked(2), Marked(3)).n}")
    val (n, k) = Num.parse("hello", 1)
    println(s"${read[Num]("abc")} $n $k")
