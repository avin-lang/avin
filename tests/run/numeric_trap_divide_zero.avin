// expect: trap
// `/` in a function over `Numeric` is the element type's own division: a `real` divided by zero is an
// infinity, an integer divided by zero traps.

ratio[T: Numeric](a: T, b: T) -> T = a / b

main() -> int
    println(ratio(1.0, 0.0))
    println(ratio(7, 2))
    println(ratio(7, 0))
    0
