// A `return` or `break` value stops at the comma inside brackets whose commas separate items, so
// what follows is another argument and never part of a tuple. Where the value fills a line, a list
// is still a tuple.

shown(label: string, n: int) -> int
  println(label)
  n

pair(a: int, b: int, c: int = 0) -> int = a * 10 + b + c

early() -> int = pair(shown("first", 1), return 7, shown("never", 3))

named() -> int = pair(b = shown("b", 2), a = return 8)

line() -> (int, int)
  return 1, 2

main()
  println(s"${early()}")
  println(s"${named()}")
  val t = line()
  println(s"${t.0} ${t.1}")
  var i = 0
  val r = while i < 3 do
    i += 1
    pair(i, if i == 2 then break i else 0)
  else -1
  println(s"$i $r")
