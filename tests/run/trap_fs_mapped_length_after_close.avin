// expect: trap
// Every call but `close` on a closed mapping traps, `length` and a slice included.
import avin.fs

main()
  val dir = fs.createTempDir("avin-mapped-trap").toOption.get
  _ = fs.writeText(dir + "/a", "abc")
  val m = fs.mapFile(dir + "/a").toOption.get
  _ = fs.removeDirAll(dir)
  _ = m.close()
  println(m.close())
  println(m.length)
