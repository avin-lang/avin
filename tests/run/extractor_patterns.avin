// expect: exit 0

// One value from an `unapply`.
object Twice
    unapply(n: int) -> Option[int] = if n % 2 == 0 then Some(n / 2) else None

// Several values, as a tuple.
object Split
    unapply(s: string) -> Option[(string, string)]
        val at = s.indexOf("=")
        if at < 0 then None else Some((s.slice(0, at), s.slice(at + 1, s.byteLength())))

// No values: a test.
object Even
    unapply(n: int) -> bool = n % 2 == 0

// A sequence.
object Words
    unapplySeq(s: string) -> Option[List[string]] = if s == "" then None else Some(s.split(" ").toList)

object Digits
    unapplySeq(n: int) -> Option[Vector[int]] = if n < 0 then None else Some(s"$n".chars().map(c -> c.asDigit()))

// A generic extractor.
object Pair
    unapply[A](xs: List[A]) -> Option[(A, A)] = xs match
        [a, b] -> Some((a, b))
        _ -> None

// An extractor that is a value of a class, with state of its own.
class Above(limit: int)
    unapply(n: int) -> Option[int] = if n > limit then Some(n - limit) else None

// A class with a companion object as its extractor; the class is not a variant.
class Point(val x: int, val y: int)

object Point
    unapply(p: Point) -> Option[(int, int)] = Some((p.x, p.y))

data Shape
    Circle(r: int)
    Square(side: int)

// A variant of the name stays the variant, whatever its type's companion declares.
data Cell(value: int)

object Cell
    unapply(n: int) -> Option[int] = Some(n * 100)

describe(n: int) -> string = n match
    Twice(Twice(q)) -> s"four times $q"
    Twice(h) -> s"twice $h"
    _ -> "odd"

parity(n: int) -> string = n match
    Even() -> "even"
    _ -> "odd"

words(s: string) -> string = s match
    Words(one) -> s"one: $one"
    Words(first, second) -> s"two: $first, $second"
    Words(first, rest*) -> s"$first and ${rest.length} more"
    _ -> "none"

digits(n: int) -> string = n match
    Digits(d) -> s"one digit $d"
    Digits(first, _*) if first == 9 -> "starts with nine"
    Digits(first, second, rest*) -> s"$first, $second and ${rest.length} more"
    _ -> "negative"

lastIsZero(n: int) -> bool = n match
    Digits(_, _*) -> n % 10 == 0
    _ -> false

pairs(xs: List[string]) -> string = xs match
    Pair(a, b) -> s"$a & $b"
    _ -> "not a pair"

assignment(s: string) -> string = s match
    Split(key, Split(inner, _)) -> s"$key holds another assignment to $inner"
    Split(key, value) if value.byteLength() > 3 -> s"$key gets a long value"
    Split(key, value) -> s"$key = $value"
    _ -> "not an assignment"

whole(s: string) -> string = s match
    Split(both) -> s"pair ${both.0}/${both.1}"
    _ -> "no"

shape(s: Shape) -> string = s match
    Circle(r) -> s"circle $r"
    Square(side) -> s"square $side"

cell(c: Cell) -> int = c match
    Cell(v) -> v

// In a function's clauses.
half(n: int) -> int
half(Twice(h)) = h
half(n) = -n

main()
    println(describe(12))
    println(describe(6))
    println(describe(7))
    println(parity(4))
    println(parity(5))
    println(words("solo"))
    println(words("hello world"))
    println(words("a b c d"))
    println(words(""))
    println(digits(7))
    println(digits(912))
    println(digits(1234))
    println(digits(-5))
    println(lastIsZero(120))
    println(pairs(["x", "y"]))
    println(pairs(["x"]))
    println(assignment("k=v"))
    println(assignment("name=longvalue"))
    println(assignment("plain"))
    println(whole("a=b"))
    println(shape(Circle(3)))
    println(shape(Square(2)))
    println(half(10))
    println(half(3))
    val big = Above(100)
    val n = 130
    println(n match
        big(over) -> s"over by $over"
        _ -> "within")
    println(Point(3, 4) match
        Point(x, y) -> s"($x, $y)"
        _ -> "never")
    println(cell(Cell(7)))
    println(assignment("a=b=c"))
    // In `is`, and named.
    if 18 is Twice(nine) then println(s"is: $nine")
    if 5 is not Even() then println("five is odd")
    println(8 match
        whole @ Twice(h) -> s"$whole is twice $h"
        _ -> "no")
    // Inside other patterns, and in a lambda capturing the extractor.
    val values = [Some(4), None, Some(3), Some(150)]
    println(values.map(match
        Some(Twice(h)) -> h
        Some(_) -> -1
        None -> 0))
    println(values.collect(match Some(big(o)) -> o))
    // Alternatives of extractors.
    println(10 match
        Even() | big(_) -> "even or big"
        _ -> "other")
