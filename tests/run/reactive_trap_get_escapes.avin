// expect: trap
// A `Get` belongs to the computation it was given to: kept and used after that computation has
// returned, it traps, since a read then would be recorded nowhere.
import avin.reactive.{Get, Graph}

main()
  val g = Graph()
  val a = g.atom(1)
  val kept = Buffer[Get]()
  val d = g.derived(get ->
    kept.append(get)
    get(a) + 1)
  println(d.get())
  println(kept(0)(a))
