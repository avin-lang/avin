// expect: exit 0
// HTTP-dates: `toHttpDate` writes IMF-fixdate; `parseHttpDate` reads it and the two obsolete forms,
// refusing everything else with an error that names the field or the place.
import avin.time.{
  Instant, TimeParseError, BadShape, OutOfRange, Trailing, date, daysInMonth, epochSeconds, epochMicros, parseHttpDate,
  parseTimestamp
}

// A fixed "now" so two-digit years do not depend on the clock: 2026-11-23T12:00:00Z.
val Now: Instant = epochSeconds(1795435200)

// What a parse answers, written as the HTTP-date it came to, or the failure's kind.
shown(text: string) -> string = parseHttpDate(text, Now) match
  Ok(t) -> t.toHttpDate()
  Err(BadShape(_, at, _)) -> s"shape@$at"
  Err(OutOfRange(_, field)) -> s"range:$field"
  Err(Trailing(_, at)) -> s"trailing@$at"
  Err(_) -> "other"

at(text: string) -> Instant = parseTimestamp(text).getOrElse(Instant.Epoch)

main()
  // The RFC 9110 example in its three forms, both ways.
  val example = epochSeconds(784111777)
  println(example.toHttpDate())
  println(example.toString())
  for text in ["Sun, 06 Nov 1994 08:49:37 GMT", "Sunday, 06-Nov-94 08:49:37 GMT", "Sun Nov  6 08:49:37 1994"]
    println(parseHttpDate(text, Now) == Ok(example))
  println(parseHttpDate("Sun, 06 Nov 1994 08:49:37 GMT").map(t -> t.epochSeconds))

  // Boundaries.
  println(Instant.Epoch.toHttpDate())
  println(epochSeconds(-1).toHttpDate())
  println(at("2024-02-29T23:59:59Z").toHttpDate())
  println(at("2023-02-28T23:59:59Z").toHttpDate())
  println(at("2024-12-31T23:59:59Z").toHttpDate())
  println(at("2025-01-01T00:00:00Z").toHttpDate())
  println(at("9999-12-31T23:59:59Z").toHttpDate())
  println(at("0000-01-01T00:00:00Z").toHttpDate())
  println(at("2026-03-01T00:00:00Z").toHttpDate())
  println(epochMicros(1999999).toHttpDate())
  println(epochMicros(-1).toHttpDate())
  println(at("2026-03-05T01:02:03Z").toHttpDate())

  // Every weekday and every month name, written and read back.
  var day = 0
  while day < 7
    val t = epochSeconds(long(day) * 86400 + 4 * 86400)
    println(t.toHttpDate())
    println(parseHttpDate(t.toHttpDate(), Now) == Ok(t))
    day += 1
  var month = 1
  while month <= 12
    val t = at(s"2026-${if month < 10 then "0" else ""}$month-15T10:20:30Z")
    println(t.toHttpDate())
    println(parseHttpDate(t.toHttpDate(), Now) == Ok(t))
    month += 1

  // Parsing the boundaries.
  println(shown("Thu, 01 Jan 1970 00:00:00 GMT"))
  println(shown("Thu, 29 Feb 2024 23:59:59 GMT"))
  println(shown("Fri, 31 Dec 9999 23:59:59 GMT"))
  println(shown("Sat, 01 Jan 0000 00:00:00 GMT"))
  println(shown("Mon, 31 Dec 2029 23:59:59 GMT"))
  println(shown("Thu Jan  1 00:00:00 1970"))
  println(shown("Wed Jan 10 00:00:00 2024"))
  println(shown("Sun Nov 16 08:49:37 1994"))
  println(shown("Sunday, 06-Nov-1994 08:49:37 GMT"))

  // The day name must be the date's.
  println(shown("Mon, 06 Nov 1994 08:49:37 GMT"))
  println(shown("Monday, 06-Nov-94 08:49:37 GMT"))
  println(shown("Mon Nov  6 08:49:37 1994"))

  // The calendar is checked.
  println(shown("Wed, 29 Feb 2023 00:00:00 GMT"))
  println(shown("Mon, 29 Feb 1900 00:00:00 GMT"))
  println(shown("Sat, 29 Feb 2000 00:00:00 GMT"))
  println(shown("Sun, 00 Nov 1994 08:49:37 GMT"))
  println(shown("Sun, 31 Nov 1994 08:49:37 GMT"))
  println(shown("Sun, 06 Nov 1994 24:49:37 GMT"))
  println(shown("Sun, 06 Nov 1994 08:60:37 GMT"))
  println(shown("Sun, 06 Nov 1994 08:49:60 GMT"))
  println(shown("Sun, 06 Nov 1994 23:59:59 GMT"))

  // Shapes refused: names, case, widths, spaces, zone, trailing text.
  println(shown(""))
  println(shown("Sun"))
  println(shown("Sunday"))
  println(shown("Xyz, 06 Nov 1994 08:49:37 GMT"))
  println(shown("sun, 06 Nov 1994 08:49:37 GMT"))
  println(shown("SUN, 06 Nov 1994 08:49:37 GMT"))
  println(shown("Sun, 06 nov 1994 08:49:37 GMT"))
  println(shown("Sun, 06 NOV 1994 08:49:37 GMT"))
  println(shown("Sun, 06 Nov 1994 08:49:37 gmt"))
  println(shown("Sun, 06 Nov 1994 08:49:37 UTC"))
  println(shown("Sun, 06 Nov 1994 08:49:37"))
  println(shown("Sun, 06 Nov 1994 08:49:37 +0000"))
  println(shown("Sun, 06 Foo 1994 08:49:37 GMT"))
  println(shown("Sun, 06 Nov 94 08:49:37 GMT"))
  println(shown("Sun, 6 Nov 1994 08:49:37 GMT"))
  println(shown("Sun, 06 Nov 1994 8:49:37 GMT"))
  println(shown("Sun, 06 Nov 1994 08:49 GMT"))
  println(shown("Sun, 06 Nov 1994 08-49-37 GMT"))
  println(shown("Sun,06 Nov 1994 08:49:37 GMT"))
  println(shown("Sun  06 Nov 1994 08:49:37 GMT"))
  println(shown("Sun, 06  Nov 1994 08:49:37 GMT"))
  println(shown(" Sun, 06 Nov 1994 08:49:37 GMT"))
  println(shown("Sun, 06 Nov 1994 08:49:37 GMT "))
  println(shown("Sun, 06 Nov 1994 08:49:37 GMT\n"))
  println(shown("Sun, 06 Nov 1994 08:49:37 GMTX"))
  println(shown("Sun, 06 Nov 1994 08:49:37 GM"))
  println(shown("Sun, 06 Nov 1994 08:49:3"))
  println(shown("Sunday, 06 Nov 1994 08:49:37 GMT"))
  println(shown("Sun, 06-Nov-1994 08:49:37 GMT"))
  println(shown("Sunday, 06-Nov-94 08:49:37"))
  println(shown("Sunday, 6-Nov-94 08:49:37 GMT"))
  println(shown("Sunday 06-Nov-94 08:49:37 GMT"))
  println(shown("Sun Nov 6 08:49:37 1994"))
  println(shown("Sun Nov   6 08:49:37 1994"))
  println(shown("Sun Nov  6 08:49:37 94"))
  println(shown("Sun Nov  6 08:49:37 1994 "))
  println(shown("Sun Nov  6 08:49:37 1994 GMT"))
  println(shown("Sun Nov 06 08:49:37 1994"))
  println(shown("Sun Nov  x 08:49:37 1994"))
  println(shown("Sun, 0６ Nov 1994 08:49:37 GMT"))

  // Single-digit days: the padding of each form.
  println(at("2026-03-05T01:02:03Z").toHttpDate() == "Thu, 05 Mar 2026 01:02:03 GMT")
  println(shown("Thu, 05 Mar 2026 01:02:03 GMT"))
  println(shown("Thu Mar  5 01:02:03 2026"))
  println(shown("Thursday, 05-Mar-26 01:02:03 GMT"))

  // Two-digit years against Now = 2026-11-23: up to fifty years ahead stays in this century, further
  // ahead is the century before.
  // Each text carries the day name of one candidate year; only the century the parse chooses accepts
  // it (weekdays of one date never repeat a century apart), so `found` is the year it chose.
  for (yy, mon, d, clock) in [
    (76, "Nov", 23, "12:00:00"),
    (76, "Nov", 23, "12:00:01"),
    (76, "Nov", 22, "12:00:01"),
    (76, "Nov", 24, "00:00:00"),
    (0, "Jan", 1, "00:00:00"),
    (99, "Jan", 1, "00:00:00"),
    (69, "Dec", 31, "23:59:59"),
    (70, "Jan", 1, "00:00:00"),
    (0, "Feb", 29, "00:00:00"),
    (96, "Feb", 29, "00:00:00"),
    (24, "Feb", 29, "00:00:00"),
    (26, "Nov", 23, "12:00:00"),
    (27, "Nov", 23, "12:00:00")
  ]
    val mm = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"].indexOf(mon) + 1
    val dd = if d < 10 then s"0$d" else s"$d"
    val yy2 = if yy < 10 then s"0$yy" else s"$yy"
    var found = "none"
    for century in [1900, 2000, 2100]
      if found == "none" && d <= daysInMonth(long(century + yy), mm)
        val name = date(century + yy, mm, d).weekday
        val text = s"$name, $dd-$mon-$yy2 $clock GMT"
        parseHttpDate(text, Now) match
          Ok(t) -> found = s"${century + yy}"
          Err(_) -> ()
    println(s"$yy2-$mon-$dd $clock -> $found")

  // The clock-reading overload agrees with an explicit now at the current instant.
  println(parseHttpDate("Sunday, 06-Nov-94 08:49:37 GMT").map(t -> t.epochSeconds))

  // A round trip of many instants, to the second, across the century.
  var n = 0
  var bad = 0
  var seconds: long = -2208988800
  while seconds < 253402300800
    val t = epochSeconds(seconds)
    if parseHttpDate(t.toHttpDate(), Now) != Ok(t) then bad += 1
    n += 1
    seconds += 1234567891
  println(s"$n round trips, $bad failures")
  var m: long = 0
  var worse = 0
  while m < 2000
    val t = epochSeconds(m * 86399 + 17)
    if parseHttpDate(t.toHttpDate(), Now) != Ok(t) then worse += 1
    m += 1
  println(s"$worse failures over 2000 consecutive-ish instants")

  // A parse never traps on any prefix of a valid text.
  var answered = 0
  for whole in ["Sun, 06 Nov 1994 08:49:37 GMT", "Sunday, 06-Nov-94 08:49:37 GMT", "Sun Nov  6 08:49:37 1994"]
    var k = 0
    while k <= whole.byteLength
      parseHttpDate(whole.slice(0, k), Now).isOk
      answered += 1
      k += 1
  println(answered)
