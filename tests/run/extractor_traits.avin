// expect: exit 0

// The conformance makes an extractor: values of the extractor traits match wherever they are, as a
// parameter of a trait's type, a bounded type parameter, a data type through an impl, a subclass
// inheriting its superclass's conformance, and with the traits' variance.

open class Animal(val name: string)

class Dog(name: string): Animal(name)

// A `-A`: an extractor of animals takes dogs.
object Named: Extractor[Animal, string]
  override unapply(a: Animal) -> Option[string] = if a.name == "" then None else Some(a.name)

// A `+B`: an extractor giving dogs gives animals.
object Puppy: Extractor[int, Dog]
  override unapply(n: int) -> Option[Dog] = if n < 2 then Some(Dog(s"pup$n")) else None

// One taking a trait's value, the matched value's type deciding nothing about the call.
firstNumber(e: Extractor[string, int], s: string) -> int = s match
  e(n) -> n
  _ -> -1

// One taking a bounded type parameter.
countMatching[E: BoolExtractor[int]](e: E, xs: Vector[int]) -> int
  var n = 0
  for x in xs
    if x is e() then n += 1
  n

seqLength[S: SeqExtractor[string, List[string]]](e: S, s: string) -> int = s match
  e(rest*) -> rest.length
  _ -> -1

object Length: Extractor[string, int]
  override unapply(s: string) -> Option[int] = if s == "" then None else Some(s.byteLength)

object Digit: Extractor[string, int]
  override unapply(s: string) -> Option[int] = if s.byteLength == 1 then s.toIntOption() else None

// A data type through an impl.
data Between(lo: int, hi: int)

impl BoolExtractor[int] for Between
  unapply(n: int) -> bool = lo <= n <= hi

// A subclass keeps its superclass's conformance and overrides its method.
open class Scaled(factor: int): Extractor[int, int]
  override unapply(n: int) -> Option[int] = if n % factor == 0 then Some(n / factor) else None

class Halved: Scaled(2)
  override unapply(n: int) -> Option[int] = if n > 0 && n % 2 == 0 then Some(n / 2) else None

// One implementing an `unapply` trait and `SeqExtractor` at different types: the matched value's
// type chooses.
object Both: Extractor[int, int], SeqExtractor[string, List[string]]
  override unapply(n: int) -> Option[int] = Some(n + 1)
  override unapplySeq(s: string) -> Option[List[string]] = Some(s.split(",").toList)

// At the same type, `unapply` serves.
object Same: Extractor[string, string], SeqExtractor[string, List[string]]
  override unapply(s: string) -> Option[string] = Some(s"whole $s")
  override unapplySeq(s: string) -> Option[List[string]] = Some(s.split(",").toList)

// Another method named `unapply` beside the trait's is an ordinary method.
object Overloaded: Extractor[int, int]
  override unapply(n: int) -> Option[int] = Some(n * 10)
  unapply(s: string) -> string = s"just a method of $s"

// Unicode text and the extremes of `int`.
object Chars: SeqExtractor[string, Vector[char]]
  override unapplySeq(s: string) -> Option[Vector[char]] = Some(s.chars)

object Extreme: Extractor[int, string]
  override unapply(n: int) -> Option[string] = n match
    2147483647 -> Some("max")
    -2147483648 -> Some("min")
    _ -> None

describeAnimal(a: Animal) -> string = a match
  Named(n) -> s"named $n"
  _ -> "nameless"

main()
  println(describeAnimal(Dog("rex")))
  println(describeAnimal(Animal("")))
  println(1 match
    Puppy(Named(n)) -> n
    _ -> "none")
  val dogs: Extractor[int, Animal] = Puppy
  println(0 match
    dogs(a) -> a.name
    _ -> "none")
  val anyName: Extractor[Dog, string] = Named
  println(Dog("fido") match
    anyName(n) -> n
    _ -> "none")
  println(firstNumber(Length, "four"))
  println(firstNumber(Digit, "7"))
  println(firstNumber(Digit, "x"))
  println(firstNumber(Length, ""))
  println(countMatching(Between(3, 5), [1, 3, 4, 5, 6]))
  println(seqLength(Both, "a,b,c"))
  val teen = Between(13, 19)
  println(15 match
    teen() -> "teen"
    _ -> "not")
  val s: Scaled = Halved()
  println(8 match
    s(h) -> s"half $h"
    _ -> "odd")
  println(-8 match
    s(h) -> s"half $h"
    _ -> "not positive")
  println(Scaled(3) match
    three -> (9 match
      three(q) -> s"third $q"
      _ -> "no"))
  println(4 match
    Both(n) -> n
    _ -> 0)
  println("x,y" match
    Both(a, b) -> s"$a $b"
    _ -> "")
  println("p,q" match
    Same(whole) -> whole
    _ -> "")
  println(3 match
    Overloaded(n) -> n
    _ -> 0)
  println(Overloaded.unapply("it"))
  println("héllo, 世界" match
    Chars(first, second, _*) -> s"$first$second"
    _ -> "")
  println("" match
    Chars() -> "no chars"
    _ -> "some")
  println(2147483647 match
    Extreme(e) -> e
    _ -> "")
  println(-2147483648 match
    Extreme(e) -> e
    _ -> "")
  // A lambda capturing an extractor value, over many allocations.
  val halves = Halved()
  val found = (1 .. 2000).toVector.collect(match halves(h) if h % 500 == 0 -> h)
  println(found)
