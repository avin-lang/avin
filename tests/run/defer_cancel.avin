// expect: exit 0
// A thread stopped by its scope's cancellation ends at its cancellation point with nothing of its body
// run after it, its deferred statements included; one that finished first ran its own as it returned.
import avin.threads
import avin.threads.{Atomic, Channel}
import avin.time

wait(ready: Channel[int], ran: Atomic[int], stopped: Atomic[int]) -> int
    defer stopped.add(1)
    ran.add(1)
    ready.send(1)
    threads.sleep(time.seconds(60))
    7

quick(finished: Atomic[int]) -> int
    defer finished.add(1)
    3

main()
    val ran = Atomic(0)
    val stopped = Atomic(0)
    val finished = Atomic(0)
    val ready = Channel[int](4)
    threads.scope(s ->
        val q = s.spawn(() -> quick(finished))
        println(q.join())
        for _ in 0..<3 do s.spawn(() -> wait(ready, ran, stopped))
        for _ in 0..<3 do ready.receive()
        s.cancel())
    println(s"ran ${ran.load()}, deferred ${stopped.load()}, finished ${finished.load()}")
