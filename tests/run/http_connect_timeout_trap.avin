// expect: trap
// A request's connect timeout below zero, by a microsecond, traps as the request is made, by
// `withConnectTimeout` as by the constructor.
import avin.net.http.Request
import avin.time.{Duration, micros}

main()
  println(Request("GET", "http://x/", connectTimeout = Duration.Zero).connectTimeout)
  _ = Request("GET", "http://x/").withConnectTimeout(micros(-1))
