// expect: exit 0
// An impl without `for` adds methods to the tuples and the functions its type matches, as to any type
// built from its parameters: a parameter named twice takes one type, a part written out matches only
// itself, bounds hold the methods to the arguments that meet them, a `@sendable` function type adds
// only to `@sendable` functions, and a type's own method of the same parameter types is found before
// one added to the function type it is.

impl[A] (A, A)
    both(f: (A) -> bool) -> bool = f(self.0) && f(self.1)

impl[A: Display, B: Display] (A, B)
    shown() -> string = s"$0 and ${self.1}".replace("$0", s"${self.0}")

impl[A] (A, int)
    sum() -> long = long(self.1) + 1

impl[A, B, C] (A, B, C)
    rotate() -> (B, C, A) = (self.1, self.2, self.0)

impl[T] (T) -> T
    twice() -> (T) -> T = x -> self(self(x))

impl[R] () -> R
    run2() -> (R, R) = (self(), self())

impl[A] (A) -> unit
    each(xs: Vector[A]) = for x in xs do self(x)

impl[A, B] (A) -> Option[B]
    orNone(a: A) -> bool = self(a).isEmpty()

impl[A, B: Display] @sendable (A) -> B
    // Only a `@sendable` function has it.
    shipped(a: A) -> string = s"sent ${self(a)}"

class Chain(val label: string): (int) -> int
    apply(x: int) -> int = x + 1
    // Its own `andThen` of the same parameter types is the one a call finds.
    andThen(g: (int) -> int) -> (int) -> int = x -> g(x) * 1000

main()
    println((2, 4).both(n -> n % 2 == 0), ("a", "bc").both(s -> s.charCount() > 1))
    println((1, "x").shown(), ('é', 0.5).shown())
    println(("a", -2147483648).sum(), (true, 2147483647).sum())
    println((1, "b", true).rotate())
    val inc = (n: int) -> n + 1
    println(inc.twice()(0), inc.twice().twice()(0), ((s: string) -> s + "!").twice()("hi"))
    var calls = 0
    val tick = () ->
        calls += 1
        calls
    println(tick.run2(), calls)
    var seen: Vector[string] = []
    val add: (string) -> unit = s -> seen = seen :+ s
    add.each(["p", "q"])
    println(seen)
    println(((n: int) -> if n > 0 then Some(n) else None).orNone(0))
    val chain = Chain("c")
    println(chain.andThen(n -> n + 1)(1), chain.twice()(1))
    val plain: (int) -> int = chain
    val safe: @sendable (int) -> int = n -> n * 7
    println(safe.shipped(6), safe.andThen(n -> n + 1)(1))
    println(plain.andThen(n -> n + 1)(1))
