// expect: trap
// Lightweight threads parked in selects with no `after` are waits the deadlock check counts as any
// other: one selects on a single channel nothing sends to, another on two, after a first select took
// the one value there was, and `main` joins the first. Nothing can end any wait, so the program is
// deadlocked, and the report names each select with its channels.
import avin.threads.{Channel, spawn}

main()
  val a = Channel[int]()
  val b = Channel[int]()
  val c = Channel[int](1)
  c.send(7)
  val one = spawn(() ->
    select
      a.receive() as Some(x) -> x
      else 0
    select
      a.receive() as Some(x) -> x)
  val two = spawn(() ->
    var got = 0
    select
      c.receive() as Some(x) -> got = x
    select
      b.receive() as Some(x) -> got += x
      c.receive() as Some(x) -> got += x
    got)
  println("joining")
  println(one.join(), two.join())
