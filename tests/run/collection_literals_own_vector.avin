// expect: exit 0
// A literal is the core library's `Vector` even where the program declares a `Vector` of its own.

class Vector(val n: int)

main()
    val mine = Vector(5)
    val xs = [mine, Vector(6)]
    println(s"${mine.n} ${xs(1).n} ${xs.length()}")
    println(s"${(xs :+ Vector(7)).map(v -> v.n).foldLeft(0, (a, n) -> a + n)}")
