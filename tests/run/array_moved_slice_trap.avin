// expect: trap
// A slice of an array the program moved would copy elements the receiver may be changing, so it
// traps; a slice taken before the move is a copy of the program's own (array_move_legal).
import avin.actors.Isolated

main()
  val a = Array.tabulate[byte](8, i -> byte(i))
  val moved = Isolated.move(a)
  println(a.slice(0, 2).length)
  println(moved.take().length)
