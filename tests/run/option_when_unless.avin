// expect: exit 0
// `Option.when` and `Option.unless` give `Some` of the value on one side of the condition and `None`
// on the other; the value is evaluated only for `Some`, and once.

var evaluated = 0

counted[T](value: T) -> T
    evaluated += 1
    value

open class Animal(val name: string)
class Dog(name: string): Animal(name)

main()
    println(Option.when(true, 1), Option.when(false, 1))
    println(Option.unless(false, "a"), Option.unless(true, "a"))
    println(evaluated)
    println(Option.when(true, counted(2)), evaluated)
    println(Option.when(false, counted(2)), evaluated)
    println(Option.unless(false, counted(3)), evaluated)
    println(Option.unless(true, counted(3)), evaluated)
    // A value that would stop the program is never reached on the `None` side.
    println(Option.when(false, todo()), Option.unless(true, fail("reached")))
    // Generic instances and the expected type.
    val animal: Option[Animal] = Option.when(true, Dog("rex"))
    println(animal.map(a -> a.name))
    println(Option.when(true, (1, "x")), Option.when(true, Some(-2147483648)), Option.unless(false, ""))
    println(Option.when(true, [1, 2]).map(v -> v.length()))
    // A capture is read when the value is evaluated.
    var n = 1
    val later = () -> Option.when(n > 1, n * 10)
    println(later())
    n = 2
    println(later())
    // The condition is evaluated once, whatever it is.
    val picks = (0..<6).toVector().map(i -> Option.when(i % 2 == 0, i))
    println(picks)
    println(picks.flatMap(o -> o.toVector()))
    var made = 0
    for i in 0..<3000
        if Option.unless(i % 3 == 0, s"v$i").isDefined() then made += 1
    println(made)
