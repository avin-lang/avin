// expect: exit 0
// Equality, ordering and hashing are by value, whatever the scales: `2.0 == 2.00`, both hash alike
// and are one key of a hash map, a tree map and a set, while `scale` still tells them apart and
// `stripTrailingZeros` normalises. Generic code over `Numeric`, `Add`, `Mul` and `Ord` takes a
// `BigDecimal`, and threads share one.
import avin.threads.spawn

total[T: Add](xs: Vector[T]) -> T
  var t = T.zero()
  for x in xs do t = t + x
  t

square[T: Numeric](x: T) -> T = x * x

main()
  val a: BigDecimal = 2.0
  val b: BigDecimal = 2.00
  val c: BigDecimal = 2
  println(a == b)
  println(a == c)
  println(a != b)
  println(a.compare(b))
  println(a.hash() == b.hash())
  println(a.hash() == c.hash())
  println(s"${a.scale} ${b.scale} ${c.scale}")
  println(s"$a $b $c")
  println(s"${a.stripTrailingZeros} ${b.stripTrailingZeros} ${c.stripTrailingZeros}")
  println(a.stripTrailingZeros.scale)
  // Zero at every scale, and negated.
  val zs = [BigDecimal("0"), BigDecimal("0.0"), BigDecimal("-0.000"), BigDecimal("0e5"), -BigDecimal("0.00")]
  println(zs)
  println(zs.forall(z -> z == zs(0) && z.hash() == zs(0).hash() && z.isZero && z.sign == 0))
  // Values that differ only far down, or by sign.
  val p = BigDecimal("1.00000000000000000000000000000000000000001")
  println(p == 1)
  println(p > 1)
  println(-p < -1)
  println(BigDecimal("-1.5") == BigDecimal("1.5"))
  println(BigDecimal("-1.5").hash() == BigDecimal("1.5").hash())
  println(BigDecimal("0.1") < BigDecimal("0.10000000000000000000001"))
  println(BigDecimal("123.4500").compare(BigDecimal("123.45")))
  println(BigDecimal("-0.01").compare(BigDecimal("0.001")))
  println(BigDecimal("100").compare(BigDecimal("99.999999")))
  // Keys of a hash map and a tree map, members of sets.
  var counts = HashMap[BigDecimal, int]()
  for v in ["1.5", "1.50", "1.500", "2", "2.0", "-0", "0.00", "1.05"]
    val key = BigDecimal(v)
    counts = counts.updated(key, counts.get(key).getOrElse(0) + 1)
  println(counts.size)
  println(counts.get(BigDecimal("1.5000000")))
  println(counts.get(BigDecimal(2)))
  println(counts.get(BigDecimal(0)))
  println(counts.get(BigDecimal("1.05")))
  println(counts.get(BigDecimal("1.050")))
  println(counts.get(BigDecimal("1.005")))
  println(Set(a, b, c, BigDecimal("2.000000000000000000000000000000")).size)
  println(Set(BigDecimal("0.1"), BigDecimal("0.10"), BigDecimal("0.01")).size)
  println(TreeSet(BigDecimal("3.10"), BigDecimal("-2"), BigDecimal("3.1"), BigDecimal("0.5")))
  var tree = TreeMap[BigDecimal, string]()
  tree = tree.updated(BigDecimal("1.0"), "one")
  tree = tree.updated(BigDecimal("1.00"), "one again")
  tree = tree.updated(BigDecimal("0.5"), "half")
  println(tree)
  // Generic code over numbers and ordered values.
  val xs = [
    BigDecimal("1.25"),
    BigDecimal("-0.5"),
    BigDecimal("1000000000000000000000.001"),
    BigDecimal(0),
    BigDecimal("3")
  ]
  println(total(xs))
  println(xs.sum)
  println(xs.filter(!_.isZero).product)
  println(xs.max)
  println(xs.min)
  println(xs.sorted)
  println(xs.sortedDescending)
  println(square(BigDecimal("-1.1")))
  println(BigDecimal.zero())
  println(BigDecimal.one())
  println(BigDecimal.zero() == 0)
  println(BigDecimal("0.1") + BigDecimal("0.2") == BigDecimal("0.3"))
  println(BigDecimal(1) < BigDecimal("1.5") < BigDecimal(2))
  // `abs`, `sign`, `negate()` and unary `-`.
  println(BigDecimal("-3.50").abs)
  println(BigDecimal("3.50").abs)
  println(BigDecimal("-3.50").sign)
  println(BigDecimal("0.00").sign)
  println(BigDecimal("3.50").negate())
  println(-BigDecimal("-3.50"))
  // An immutable value, so threads share one.
  val shared = BigDecimal("1.1").pow(50)
  val workers = (1 .. 4).map(k -> spawn(() -> shared * k))
  println(workers.map(w -> w.join()).sum == shared * 10)
