// expect: exit 0
// A moved array goes to a new thread in what its body captures, and comes back in what the body
// returns, at no elements, one and a mebibyte: the thread takes it, fills it and moves it back, and
// the thread that joined it takes the same array and uses it through the reference it kept. A
// lightweight thread of a scope does the same.
import avin.actors.Isolated
import avin.threads.{scope, spawn}

sumOf(a: Array[long]) -> long
  var total: long = 0
  for x in a do total += x
  total

trip(size: int)
  val a = Array.fill[long](size, 0)
  val items = Isolated.move(a)
  val t = spawn(() ->
    val got = items.take()
    for i in 0 ..< got.length do got(i) = long(i)
    Isolated.move(got))
  val back = t.join().take()
  println(s"$size: same array ${back === a}, sum ${sumOf(a)}")

main()
  trip(0)
  trip(1)
  trip(1048576)
  val b = Array.fill[long](3, 5)
  val moved = Isolated.move(b)
  val total = scope(s ->
    val inner = s.spawn(() ->
      val got = moved.take()
      got(0) = 100
      sumOf(got))
    inner.join())
  println(s"scoped: $total")
