// A file of 8 MiB written and read through an open handle: in blocks, whole, by line, from the
// middle, and by the tail functions.
import avin.fs
import avin.io.IoError

impl[T] Result[T, IoError]
  get() -> T = self match
    Ok(v) -> v
    Err(e) -> fail(s"unexpected $e")

main()
  val dir = fs.createTempDir("avin-large").get()
  val file = dir + "/big"
  val total = 8 * 1024 * 1024
  // 8192 lines of 1024 bytes: a 10-digit number, padding and the newline.
  val w = fs.create(file).get()
  for i in 0 ..< 8192
    val n = i.toString()
    _ = w.writeText("0".repeat(10 - n.byteLength) + n + "-".repeat(1013) + "\n")
  println(w.size().get() == long(total))
  _ = w.close()
  val r = fs.open(file).get()
  println(r.size().get())
  // Read in 1 MiB blocks.
  var blocks = 0
  var bytes = 0
  while true
    val b = r.read(1048576).get()
    if b.length == 0 then break
    blocks += 1
    bytes += b.length
  println(s"$blocks $bytes ${r.position().get()}")
  // Everything at once, from a seek, and the first and last bytes.
  _ = r.seek(0)
  val all = r.readAll().get()
  println(s"${all.length} ${all(0)} ${all(total - 1)}")
  _ = r.seek(long(1024 * 5000))
  println(r.readLine().get().get.slice(0, 10))
  // Lines through the buffer to the end.
  _ = r.seek(0)
  var count = 0
  var last = ""
  while true
    r.readLine().get() match
      Some(l) ->
        count += 1
        last = l
      None -> break
  println(s"$count ${last.slice(0, 10)} ${last.byteLength}")
  // Text of the whole file in one call.
  _ = r.seek(long(total - 128))
  println(r.readText().get().byteLength)
  _ = r.close()
  // The tail functions and readBytesFrom read only the end.
  println(fs.readTail(file, 130).get().byteLength)
  println(fs.readTailLines(file, 2).get().map(l -> l.slice(0, 10)))
  println(fs.readBytesFrom(file, long(total - 3)).get().length)
  // Appending to it from a second handle while the first follows.
  val f = fs.open(file).get()
  _ = f.seekToEnd()
  val a = fs.append(file).get()
  _ = a.writeText("tail line\n")
  _ = a.close()
  println(f.readCompleteLine().get())
  _ = f.close()
  _ = fs.removeDirAll(dir)
