// expect: exit 0
// Threads at their edges: a condition's wait of no time or less answers false at once; several
// threads joining one thread at once each get its result; `Once.isDone` before and after; threads
// whose results are `unit` and an `Option` of a tuple; a scope's value from nested scopes.
import avin.threads.{Mutex, Once, spawn, scope}
import avin.time

main()
    // A wait of no time, or less, answers false at once.
    val m = Mutex(0)
    val c = m.condition()
    val start = time.now()
    println(m.with(_ -> c.waitFor(0)))
    println(m.with(_ -> c.waitFor(-5)))
    println(start.elapsed() < time.seconds(1))
    // Several threads join one thread at once, and each gets its result.
    val worker = spawn(() ->
        var total: long = 0
        for i in 0..<100000 do total += long(i)
        total)
    val joiners = (0..<6).map(_ -> spawn(() -> worker.join()))
    println(joiners.map(j -> j.join()).distinct())
    println(worker.join())
    // A `Once` not yet run is not done; one whose body returned is.
    val once = Once()
    println(once.isDone())
    var runs = 0
    scope(s ->
        for _ in 0..<4
            s.spawn(() -> once.run(() -> runs += 1)))
    println(s"${once.isDone()} $runs")
    // A thread whose result is unit, and one whose result is an Option of a data value.
    val quiet = spawn(() -> println("quiet"))
    quiet.join()
    val boxed = spawn(() -> Some((1, "one")))
    println(boxed.join())
    // A scope returning its body's value, nested inside another's thread.
    println(scope(s -> scope(t -> 41) + 1))
