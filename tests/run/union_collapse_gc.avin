// expect: exit 0
// A vector of a collapsed union holds the scalar itself, so a collection running while it is alive
// finds no reference in it to follow, and its elements survive as the numbers they are.
build[T](x: T, n: int) -> Vector[T | int] = Vector.tabulate(n, i -> if i % 2 == 0 then x else i)

strings[T](x: T, n: int) -> Vector[T | string] = Vector.tabulate(n, i -> if i % 2 == 0 then x else s"s$i")

total[T](v: Vector[T | int]) -> long
  var s: long = 0
  for e in v do s += e match
    t: T -> 1
    n: int -> long(n)
  s

main()
  val v = build[int](7, 2000)
  val w = strings[string]("even", 1000)
  var junk: long = 0
  for i in 0 ..< 5000 do junk += long(s"garbage $i".byteLength)
  println(junk > 0)
  println(total[int](v))
  println(v.take(4))
  println(w.take(3))
  println(w.map(s -> s.charCount).sum)
