// expect: trap
// Copying out of an array the program moved traps too: the receiver may be writing what it reads.
import avin.actors.Isolated

main()
  val a = Array.fill[int](4, 0)
  val target = Array.fill[int](4, 9)
  val moved = Isolated.move(a)
  println("moved")
  a.copyTo(target, 0)
  println(moved.take()(0))
