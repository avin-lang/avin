// expect: exit 1
// `?` in a `main` answering with `Result[unit, E]` ends it at the first `Err`: the program writes
// `error: ` and the error's `Display` to standard error and exits with 1, after what `main` printed
// before it, and nothing after the `?` runs.
data Bad(why: string)

impl Display for Bad
  display(out: Writer, spec: FormatSpec) = out.write(s"bad: $why")

half(n: int) -> Result[int, Bad] = if n % 2 == 0 then Ok(n / 2) else Err(Bad(s"$n is odd"))

main() -> Result[unit, Bad]
  val a = half(42)?
  println(s"half is $a")
  val b = half(a)?
  println(s"not reached $b")
  Ok(())
