// expect: trap
// A CORS max age is at least zero: zero is taken, and a negative one traps where the policy is made.
import avin.net.http.Cors
import avin.time.Duration

main()
  println(Cors(maxAge = Some(Duration(0))).maxAge.isDefined)
  println(Cors(maxAge = Some(Duration(-1))).maxAge.isDefined)
