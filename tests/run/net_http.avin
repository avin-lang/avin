// expect: exit 0
// The HTTP client against a server written here, on a thread over the loopback: the request it writes,
// bodies by `Content-Length`, chunked and to the connection's end, a status that is an answer, `HEAD`,
// interim responses, redirects followed up to five and only for `GET` and `HEAD`, timeouts, and the
// errors of a reply that is not HTTP, a URL that is not one, a scheme other than `http` and
// `https`, and a refused connection, for `https` as well.
import avin.io.{IoError, ConnectionRefused, TimedOut}
import avin.net.{TcpListener, TcpStream}
import avin.net.http
import avin.net.http.{HttpError, Io, BadUrl, Malformed, Unsupported, Request, Response}
import avin.threads.spawn
import avin.time

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message)

// A request's head, its lines joined with `|`, and its body.
readRequest(s: TcpStream) -> (string, string)
    val lines = Buffer[string]()
    var length = 0
    while true
        val line = ok(s.readLine()).getOrElse("")
        if line.isEmpty then break
        if line.toLowerCase.startsWith("content-length:") then length = line.slice(15, line.byteLength).trim.toInt()
        lines.addOne(line)
    val body = Buffer[byte]()
    while body.length < length
        body.addAll(ok(s.read(length - body.length)))
    (lines.toVector.mkString("|"), string.fromUtf8Lossy(body.toArray()))

fixed(status: string, body: string) -> string =
    s"HTTP/1.1 $status\r\nContent-Type: text/plain\r\nContent-Length: ${body.byteLength}\r\n\r\n$body"

redirect(status: string, location: string) -> string = s"HTTP/1.1 $status\r\nLocation: $location\r\nContent-Length: 0\r\n\r\n"

// Answers each connection by its path until it is asked for `/quit`.
serve(l: TcpListener, port: int) -> int
    var served = 0
    while true
        val s = ok(l.accept())
        served += 1
        val (head, body) = readRequest(s)
        val target = head.split(" ")(1).split("?")(0)
        if target == "/stall"
            // Waits for the client to give up and close.
            ok(s.readAll())
            s.close()
            continue
        val reply = target match
            "/echo" -> fixed("200 OK", s"${head.replace(s":$port", ":PORT")}#$body")
            "/chunked" -> "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n1;name=value\r\n,\r\nA\r\n chunked!!\r\n0\r\nTrailer: yes\r\n\r\n"
            "/eof" -> "HTTP/1.1 200 OK\r\n\r\nuntil the end"
            "/missing" -> fixed("404 Not Found", "nope")
            "/empty" -> "HTTP/1.1 204 No Content\r\n\r\n"
            "/r1" -> redirect("302 Found", "r2?from=1")
            "/r2" -> redirect("301 Moved Permanently", s"http://127.0.0.1:$port/echo")
            "/continue" -> "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"
            "/bad" -> "garbage\r\n\r\n"
            "/short" -> "HTTP/1.1 200 OK\r\nContent-Length: 10\r\n\r\nabc"
            "/badchunk" -> "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n"
            "/quit" -> fixed("200 OK", "bye")
            _ ->
                if target.startsWith("/loop/")
                    redirect("302 Found", s"/loop/${target.slice(6, target.byteLength).toInt() + 1}")
                else fixed("500 Internal Server Error", target)
        if target == "/utf"
            ok(s.writeText("HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\n"))
            ok(s.write([byte(97), byte(0xC3), byte(98)].toArray()))
        else ok(s.writeText(reply))
        s.close()
        if target == "/quit" then return served
    served

describe(r: Result[Response, HttpError]) -> string = r match
    Ok(res) -> s"${res.status} ${res.reason} [${res.text}]"
    Err(e) -> s"error: ${e.message}"

main()
    val l = ok(TcpListener.bind("127.0.0.1", 0))
    val port = l.port()
    val base = s"http://127.0.0.1:$port"
    val server = spawn(() -> serve(l, port))

    // The request line, `Host`, the length and `Connection: close`, then the program's own headers.
    println(describe(http.get(s"$base/echo?x=1&y=2#frag")))
    println(describe(http.post(s"$base/echo", "a=1", "application/x-www-form-urlencoded")))
    println(describe(http.send(Request("PUT", s"$base/echo").withHeader("X-Note", "kept as written").withBody("é"))))
    println(describe(http.send(Request("DELETE", s"$base/echo").withHeader("Host", "example.org"))))

    // Bodies of each kind, and a status that is an answer.
    println(describe(http.get(s"$base/chunked")))
    println(describe(http.get(s"$base/eof")))
    println(describe(http.get(s"$base/missing")))
    println(describe(http.get(s"$base/empty")))
    println(describe(http.get(s"$base/utf")))
    println(describe(http.get(s"$base/continue")))
    http.get(s"$base/missing") match
        Ok(r) -> println(s"${r.header("CONTENT-type")} ${r.header("content-length")} ${r.header("X-None")} ${r.headers.length} ${r.body.length}")
        Err(e) -> println(e)

    // `HEAD` reads no body whatever the headers announce.
    http.send(Request("HEAD", s"$base/missing")) match
        Ok(r) -> println(s"${r.status} ${r.header("Content-Length")} ${r.body.length}")
        Err(e) -> println(e)

    // Redirects: a relative one resolved against the URL that answered, then an absolute one.
    println(describe(http.get(s"$base/r1")))
    // Five are followed and the sixth is the answer; a `POST` follows none.
    http.get(s"$base/loop/10") match
        Ok(r) -> println(s"${r.status} ${r.header("Location")}")
        Err(e) -> println(e)
    http.post(s"$base/r1", "", "text/plain") match
        Ok(r) -> println(s"${r.status} ${r.header("Location")}")
        Err(e) -> println(e)

    // Replies that are not HTTP, or break off.
    println(describe(http.get(s"$base/bad")))
    println(describe(http.get(s"$base/short")))
    println(describe(http.get(s"$base/badchunk")))

    // A reply that takes longer than the request's timeout.
    http.send(Request("GET", s"$base/stall").withTimeout(time.millis(50))) match
        Err(Io(IoError(TimedOut, _, _))) -> println("timed out")
        other -> println(describe(other))

    // Requests that are refused before any connection is made.
    println(describe(http.get("ftp://example.com/file")))
    println(describe(http.get("no scheme")))
    println(describe(http.get("mailto:someone@example.com")))
    http.get("/relative") match
        Err(BadUrl(e)) -> println(s"bad url: $e")
        other -> println(describe(other))

    println(describe(http.get(s"$base/quit")))
    println(server.join())
    l.close()
    http.get(s"$base/echo") match
        Err(Io(IoError(ConnectionRefused, _, _))) -> println("refused")
        other -> println(describe(other))
    // An `https` URL whose connection is refused is `Io`, as an `http` one is.
    http.get(base.replace("http:", "https:") + "/echo") match
        Err(Io(IoError(ConnectionRefused, _, _))) -> println("https refused")
        other -> println(describe(other))
