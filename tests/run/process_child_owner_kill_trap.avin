// expect: trap
// A started command handed to a thread is the thread's while the thread runs, and the code that
// handed it over traps at `kill`.
import avin.io.IoError
import avin.process.{Child, Command}
import avin.threads.{Channel, spawn}

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message())

main()
    val child = ok(Command("/bin/sleep", "2").start())
    val go = Channel[int]()
    val t = spawn(() ->
        go.receive()
        child.kill()
        child.waitFor())
    println("handed over")
    child.kill()
    println("not reached")
    go.send(1)
    println(t.join())
