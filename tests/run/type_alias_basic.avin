// expect: exit 0
// A type alias is another name for its type: transparent, so a value of the alias is a value of the
// type it stands for and the other way round, with no conversion. Aliases name tuples, function
// types, collections, built-in types, data types and classes; a generic alias takes type arguments
// and expands by substitution; an alias may name another, declared before or after it.

type Point2 = (int, int)
type Pairs[T] = Vector[(T, T)]
type Handler = (string) -> unit
type Count = int
type Name = string
type Grid = Vector[Vector[Count]]
type Matrix[T] = Vector[Vector[T]]
type IntMatrix = Matrix[int]
type Later = Earlier
type Earlier = Point2
type Id[T] = T
type Swap[A, B] = (B, A)
type Callback[T] = (T) -> T
type Lookup[K, V] = Map[K, V]

data Shape
    Circle(radius: real)
    Square(side: real)

type Figure = Shape

class Counter(var n: int)

type Tally = Counter

add(a: Point2, b: (int, int)) -> Point2 = (a.0 + b.0, a.1 + b.1)

sumPairs(ps: Pairs[int]) -> int = ps.map((a, b) -> a * b).sum

area(f: Figure) -> real = f match
    Circle(r) -> 3.0 * r * r
    Square(s) -> s * s

firstOf[T](m: Matrix[T]) -> T = m(0)(0)

main()
    val p: Point2 = (1, 2)
    val q = add(p, (3, 4))
    println(q)
    val t: (int, int) = q
    println(t.0 + t.1)
    println(sumPairs([(1, 2), (3, 4)]))
    val ps: Vector[(int, int)] = [(5, 6)]
    println(sumPairs(ps))
    var seen = ""
    val h: Handler = (s) -> seen = seen + s
    h("a")
    h("b")
    println(seen)
    val n: Count = 41
    println(n + 1)
    val who: Name = "Ünïcödé"
    println(who.charCount)
    val g: Grid = [[1, 2], [3]]
    println(g(1)(0))
    val m: IntMatrix = g
    println(firstOf(m))
    val l: Later = (7, 8)
    val e: Earlier = l
    println(e.1)
    val i: Id[string] = "same"
    println(i)
    val s: Swap[int, string] = ("left", 3)
    println(s.0 + s.1.toString())
    val twice: Callback[int] = _ * 2
    println(twice(21))
    val look: Lookup[string, int] = {"a": 1}
    println(look("a"))
    println(area(Square(3.0)))
    val fig: Figure = Circle(1.0)
    println(area(fig))
    val tally: Tally = Counter(0)
    tally.n += 5
    val back: Counter = tally
    println(back.n)
    val empty: Pairs[string] = []
    println(empty.length)
