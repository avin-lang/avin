// expect: exit 0
// Threads blocked on a mutex, on a condition and on a channel hold up no collection: while they wait,
// the main thread allocates and collects many times over, still holding the mutex, and then lets
// them all go. Every waiter finishes with what it was waiting for.
import avin.threads.{Channel, Mutex, spawn}

churn(rounds: int) -> int
    var kept: List[string] = []
    for r in 0..<rounds
        kept = s"r$r" :: kept
        if r % 50 == 0 then kept = []
    kept.length()

main() -> int
    val m = Mutex(Buffer[string]())
    val changed = m.condition()
    val ch = Channel[string]()
    var flag = false
    val condWaiter = spawn(() ->
        m.with(b ->
            while !flag do changed.wait()
            b.length()))
    val chanWaiters = [spawn(() -> ch.receive()), spawn(() -> ch.receive())]
    val lockWaiters = m.with(b ->
        val ws = [spawn(() -> m.with(x -> x.add("one"))), spawn(() -> m.with(x -> x.add("two")))]
        print(churn(3000))
        b.add("main")
        flag = true
        changed.notifyAll()
        ws)
    print(churn(3000))
    ch.send("first")
    ch.send("second")
    for w in lockWaiters do w.join()
    print(m.with(b -> b.length()))
    print(condWaiter.join() >= 1)
    var got = 0
    for w in chanWaiters
        if w.join().isDefined() then got += 1
    print(got)
    0
