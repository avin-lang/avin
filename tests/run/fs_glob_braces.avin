// expect: exit 0
// Patterns: `{a,b}` alternation in `matches`, `matcher` and `glob` (nested, empty and single
// alternatives, alternatives holding `/` and `**`, escaped and unclosed braces, braces inside a class),
// `**` at the start, in the middle and at the end, escaped wildcards, and the hidden-name rule as it
// meets alternation.
import avin.fs

fits(pattern: string, paths: Vector[string])
  val m = fs.matcher(pattern)
  val yes = paths.filter(p -> fs.matches(pattern, p))
  val same = paths.forall(p -> m(p) == fs.matches(pattern, p))
  println(s"$pattern: ${yes.mkString(" ")}${if same then "" else " (matcher disagrees)"}")

main()
  println("-- alternation")
  fits("{a,b}", ["a", "b", "c", "ab", "{a,b}", ""])
  fits("x{a,b}y", ["xay", "xby", "xy", "xaby"])
  fits("{a,b}{1,2}", ["a1", "a2", "b1", "b2", "a", "12"])
  fits("{a,{b,c}}d", ["ad", "bd", "cd", "d", "{b,c}d"])
  fits("{a}", ["a", "{a}"])
  fits("x{}y", ["xy", "x{}y"])
  fits("{,a}x", ["x", "ax", ",ax"])
  fits("{a,}", ["a", ""])
  fits("{*.c,*.h}", ["x.c", "x.h", "x.o", ".x.c"])
  fits("*.{c,h}", ["x.c", "x.h", "x.ch", ".h"])
  fits("{文,字}?", ["文a", "字ü", "文", "x字"])
  fits("[ab]{c,d}", ["ac", "bd", "cc"])

  println("-- alternatives across components")
  fits("{src,lib}/*.c", ["src/x.c", "lib/x.c", "test/x.c", "src/a/x.c"])
  fits("{src/a,b}/x", ["src/a/x", "b/x", "src/x", "a/x"])
  fits("{/abs,rel}/x", ["/abs/x", "rel/x", "abs/x", "/rel/x"])
  fits("{**/,}x.c", ["x.c", "a/x.c", "a/b/x.c", ".h/x.c"])
  fits("src/{**/*.c,*.h}", ["src/x.c", "src/a/b/x.c", "src/x.h", "src/a/x.h"])

  println("-- braces that are not alternation")
  fits("{a,b", ["{a,b", "a", "b"])
  fits("a,b}", ["a,b}", "a"])
  fits("}{", ["}{"])
  fits("\\{a,b\\}", ["{a,b}", "a", "b"])
  fits("{a\\,b,c}", ["a,b", "c", "a", "b"])
  fits("{a\\}b,c}", ["a}b", "c"])
  fits("[{]a,b}", ["{a,b}", "{a", "a"])
  fits("[{,}]", ["{", ",", "}", "{,}"])
  fits("{[,],x}", [",", "x", "[", "]"])
  fits("{[}],x}", ["}", "]", "x"])

  println("-- ** at the start, middle and end")
  val paths = ["x", "a/x", "a/b/x", "a/b/c/x", "a/.h/x", ".h/x", "a", "a/b", "b/x", "/x", "/a/x"]
  fits("**/x", paths)
  fits("a/**/x", paths)
  fits("a/**", paths)
  fits("**", paths)
  fits("/**/x", paths)
  fits("a/**/**/x", paths)
  fits("**/b/**", paths)
  fits("a**", ["a", "ab", "a/b"])

  println("-- escaped characters")
  fits("\\*", ["*", "a", "\\*"])
  fits("\\?", ["?", "a"])
  fits("\\[a]", ["[a]", "a"])
  fits("a\\", ["a\\", "a"])
  fits("\\\\", ["\\", "\\\\"])
  fits("\\.h", [".h", "h"])
  fits("\\a\\b", ["ab"])

  println("-- hidden names")
  fits("{.git,src}", [".git", "src", "git"])
  fits("{*,.*}", ["a", ".a", "..", "."])
  fits("*/{.h,x}", ["a/.h", "a/x", ".a/x"])
  fits("?{git,h}", [".git", "xgit", ".h"])

  println("-- glob with alternation")
  val dir = fs.createTempDir("avin-glob-braces") match
    Ok(d) -> d
    Err(e) ->
      println(s"no directory: $e")
      return
  val at = (rel: string) -> fs.join(dir, rel)
  _ = fs.createDirAll(at("src/a"))
  _ = fs.createDirAll(at("lib"))
  _ = fs.writeText(at("src/x.c"), "")
  _ = fs.writeText(at("src/a/y.c"), "")
  _ = fs.writeText(at("src/x.h"), "")
  _ = fs.writeText(at("lib/z.c"), "")
  _ = fs.writeText(at("lib/.w.c"), "")
  val globbed = (pattern: string) ->
    val found = fs.glob(at(pattern))
    val wrong = found.filter(p -> !fs.matches(at(pattern), p))
    val shown = found.map(p -> fs.relativeTo(p, dir).getOrElse(p))
    println(s"$pattern: $shown${if wrong.isEmpty then "" else s" not matching: $wrong"}")
  globbed("{lib,src}/*.c")
  globbed("{src,lib}/*.c")
  globbed("{src,src}/*.c")
  globbed("src/*.{h,c}")
  globbed("{**/*.c,nothing}")
  globbed("{lib/.*,src/a/*}")
  globbed("{missing,also-missing}")
  globbed("{lib}")
  globbed("{lib")
  println(fs.removeDirAll(dir))
