// args: one two
// expect: exit 2

// `[]T` is `Vector[T]` wherever a type stands: parameters, results, fields, type arguments, tuple
// parts, function types and type patterns.

data Row(cells: []string, grid: [][]int)

total(xs: []int) -> int
    var sum = 0
    for x in xs do sum += x
    sum

doubled(xs: []int) -> []int = xs.map(x -> x * 2)

applyAll(fs: [](int -> int), x: int) -> int
    var acc = x
    for f in fs do acc = f(acc)
    acc

first(xs: []string) -> Option[[]string] = if xs.length() == 0 then None else Some(xs)

describe(x: Any) -> string = x match
    v: []int -> s"ints ${v.length()}"
    w: [][]int -> s"rows ${w.length()}"
    _ -> "other"

main(args: []string) -> int
    val row = Row(["a", "b"], [[1, 2], [3]])
    print(row.cells.length())
    print(row.grid.length())
    print(total(doubled([1, 2, 3])))
    val sumOf: []int -> int = total
    print(sumOf([4, 5]))
    print(applyAll([x -> x + 1, x -> x * 10], 1))
    print(first(args) is Some(_))
    val pair: ([]int, string) = ([1], "p")
    val (ints, label) = pair
    print(ints.length())
    print(label)
    val v: Vector[int] = [7, 8]
    val s: []int = v
    print(s)
    print(describe([1, 2]))
    print(describe([[1], [2], [3]]))
    print(describe("x"))
    args.length()
