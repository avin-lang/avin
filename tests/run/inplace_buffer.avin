// expect: exit 0
// A buffer changes in place: `remove(i, n)`, `trimStart`, `trimEnd`, `filterInPlace`, `mapInPlace`,
// `patchInPlace`, `subtractOne` and `reverseInPlace`, each over empty, one-element and many-element
// buffers, reference and value elements, and after the buffer has grown.

class Box(val n: int) derives Eq, Hash

fill(n: int) -> Buffer[int]
  val b = Buffer[int]()
  for i in 0 ..< n do b.addOne(i)
  b

main()
  // remove(i, n)
  val a = fill(6)
  a.remove(1, 2)
  println(a)
  a.remove(0, 0)
  a.remove(a.length, 0)
  a.remove(2, 2)
  println(a)
  a.remove(0, 2)
  println(debug(a))
  val one = fill(1)
  one.remove(0, 1)
  println(one.length)
  val none = Buffer[int]()
  none.remove(0, 0)
  println(none.length)
  val tail = fill(5)
  tail.remove(3, 2)
  println(tail)
  val whole = fill(300)
  whole.remove(0, 300)
  println(s"${whole.length} ${whole.isEmpty}")
  whole.addOne(7)
  println(whole)

  // trimStart / trimEnd
  val t = fill(8)
  t.trimStart(3)
  println(t)
  t.trimEnd(2)
  println(t)
  t.trimStart(0)
  t.trimEnd(0)
  println(t)
  t.trimStart(3)
  println(s"${t.length}")
  val u = fill(4)
  u.trimEnd(4)
  println(u.length)
  val v = Buffer[int]()
  v.trimStart(0)
  v.trimEnd(0)
  println(v.length)

  // filterInPlace
  val f = fill(10)
  f.filterInPlace(x -> x % 3 != 0)
  println(f)
  f.filterInPlace(x -> true)
  println(f)
  f.filterInPlace(x -> false)
  println(s"${f.length} ${f.isEmpty}")
  f.filterInPlace(x -> true)
  val g = fill(1)
  g.filterInPlace(x -> true)
  println(g)
  g.filterInPlace(x -> false)
  println(g.length)
  val order = Buffer[int]()
  val h = fill(5)
  recordEven(x: int) -> bool
    order.addOne(x)
    x % 2 == 0
  h.filterInPlace(recordEven)
  println(s"$order $h")

  // mapInPlace
  val m = fill(4)
  m.mapInPlace(x -> x * x)
  println(m)
  val words = Buffer[string]()
  words ++= ["a", "bb", "ccc"]
  words.mapInPlace(w -> w + w)
  println(debug(words))
  val e = Buffer[int]()
  e.mapInPlace(x -> x + 1)
  println(e.length)
  val boxes = Buffer[Box]()
  boxes += Box(1)
  boxes += Box(2)
  boxes.mapInPlace(b -> Box(b.n * 10))
  println(boxes.map(b -> b.n))

  // patchInPlace
  val p = fill(6)
  p.patchInPlace(1, [90, 91, 92], 2)
  println(p)
  p.patchInPlace(0, [], 3)
  println(p)
  p.patchInPlace(p.length, [1, 2], 0)
  println(p)
  p.patchInPlace(1, [], 0)
  p.patchInPlace(0, [5], 0)
  println(p)
  p.patchInPlace(0, [7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7], p.length)
  println(p)
  val q = fill(4)
  q.patchInPlace(1, q, 2)
  println(q)
  val r = fill(3)
  r.patchInPlace(3, r, 0)
  println(r)
  val pe = Buffer[int]()
  pe.patchInPlace(0, [1], 0)
  println(pe)

  // subtractOne
  val s = Buffer[int]()
  s ++= [1, 2, 3, 2, 1]
  println(s.subtractOne(2))
  println(s)
  println(s.subtractOne(9))
  println(s.subtractOne(1))
  println(s)
  println(s.subtractOne(1))
  println(s)
  println(Buffer[int]().subtractOne(1))
  val sb = Buffer[Box]()
  sb += Box(1)
  sb += Box(2)
  println(sb.subtractOne(Box(2)))
  println(sb.length)
  val ss = Buffer[string]()
  ss ++= ["x", "y"]
  println(ss.subtractOne("x"))
  println(debug(ss))

  // reverseInPlace
  val rv = fill(5)
  rv.reverseInPlace()
  println(rv)
  rv.reverseInPlace()
  println(rv)
  val r4 = fill(4)
  r4.reverseInPlace()
  println(r4)
  val r1 = fill(1)
  r1.reverseInPlace()
  println(r1)
  val r0 = Buffer[int]()
  r0.reverseInPlace()
  println(r0.length)
  val big = fill(1000)
  big.reverseInPlace()
  println(s"${big(0)} ${big(999)} ${big.length}")

  // stress: the removed elements no longer keep anything alive, and the buffer stays usable
  val objs = Buffer[Box]()
  for i in 0 ..< 2000 do objs += Box(i)
  objs.filterInPlace(b -> b.n % 2 == 0)
  objs.remove(10, 500)
  objs.trimStart(5)
  objs.trimEnd(5)
  objs.mapInPlace(b -> Box(b.n + 1))
  objs.reverseInPlace()
  println(s"${objs.length} ${objs(0).n} ${objs(objs.length - 1).n}")
