// expect: trap
// A bearer token is a token68: one with padding is fine; one holding a space traps.
import avin.net.http.Request

main()
  println(Request("GET", "http://a.test/").withBearer("abc.DEF-123_~+/==").header("Authorization").getOrElse("-"))
  _ = Request("GET", "http://a.test/").withBearer("two words")
