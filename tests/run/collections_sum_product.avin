// expect: exit 0
// `sum()` and `product()` on every collection whose elements add or multiply: empty ones answer the
// identity, strings concatenate, a data type with its own `zero` sums, and a bounded type parameter
// reaches them through its bound.

data Point(x: int, y: int)

impl Add for Point
    add(other: Point) -> Point = Point(x + other.x, y + other.y)
    static zero() -> Point = Point(0, 0)

total[T: Add](xs: Iterable[T]) -> T = xs.sum()
totalSeq[T: Add](xs: Seq[T]) -> T = xs.sum()

main()
    val list: List[int] = [1, 2, 3, 4]
    print(list.sum())
    print(list.product())
    val vector: Vector[int] = [2, 3, 4]
    print(vector.sum())
    print(vector.product())
    val array: Array[int] = Array.fill(3, 5)
    print(array.sum())
    print(array.product())
    val buffer = Buffer[int]()
    print(buffer.sum())
    print(buffer.product())
    buffer.add(6)
    buffer.add(7)
    print(buffer.sum())
    print(buffer.product())
    val deque = Deque[int]()
    deque.addLast(2)
    deque.addLast(9)
    print(deque.sum())
    print(deque.product())
    print((1..10).sum())
    print((1..5).product())
    val set: Set[int] = Set.empty[int]().added(1).added(2).added(3)
    print(set.sum())
    print(set.product())

    val none: List[int] = []
    print(none.sum())
    print(none.product())
    val noReals: Vector[real] = []
    print(noReals.sum())
    print(noReals.product())
    val noStrings: List[string] = []
    print("<" + noStrings.sum() + ">")

    val reals: List[real] = [1.5, 2.0, 2.0]
    print(reals.sum())
    print(reals.product())
    val strings: List[string] = ["a", "b", "c"]
    print(strings.sum())

    val longs: List[long] = [3000000000, 3000000000]
    print(longs.sum())
    print(longs.product())
    val bytes: List[i8] = [100, 20, 7]
    print(bytes.sum())
    val smalls: List[i8] = [2, 3, 4]
    print(smalls.product())

    val points: List[Point] = [Point(1, 2), Point(3, 4)]
    print(points.sum())
    val noPoints: List[Point] = []
    print(noPoints.sum())

    print(total(list))
    print(totalSeq(vector))
    print(total(strings))
