// Names bound by `is` patterns, in scope where the test is known to hold: the `then` branch of an
// `if`, the body of a `while`, the right operand of `&&`, and, after `if x is not P` whose branch
// never finishes, the rest of the block. Every allocation collects (the test runner sets
// AVIN_GC_STRESS), so a list held only by such a name must be found by the collector.

data Shape
    Circle(radius: int)
    Rect(width: int, height: int)

data Pair(first: Option[int], second: Option[string])

orZero(o: Option[int]) -> int
    if o is Some(v) then v else 0

// The `else` of an `if` sees what a negated test bound.
described(o: Option[int]) -> string
    if o is not Some(v) then "nothing" else s"just $v"

// Walks a list by taking its head off each time round.
total(xs: List[int]) -> int
    var rest = xs
    var sum = 0
    while rest is head :: more
        sum += head
        rest = more
    sum

joined(xs: List[string]) -> string
    var rest = xs
    var out = ""
    while rest is word :: more do
        out = out + word
        rest = more
    out

// A `while` whose `else` runs once the negated test fails, binding the name for it. The right
// operand of `||` runs where the left one failed, so it sees the name too.
firstNonZero(xs: List[int]) -> int
    var rest = xs
    while rest is not n :: _ || n == 0 do
        rest = rest match
            _ :: more -> more
            [] -> return -1
    else n

// A binding used on the right of `&&` and in the body.
bigger(o: Option[int], limit: int) -> string
    if o is Some(n) && n > limit then s"$n is over $limit" else "no"

// Both sides of `&&` bind, and the second test reads the first's name.
both(a: Option[int], b: Option[int]) -> int
    if a is Some(x) && b is Some(y) && y > x then x + y else -1

// A type pattern on `Any`.
size(value: Any) -> int
    if value is s: string then s.byteLength
    elif value is n: int && n > 3 then n
    else 0

// Early return on the negated test: the name is in scope for the rest of the block.
area(shape: Option[Shape]) -> int
    if shape is not Some(Rect(w, h)) then return 0
    w * h

firstWord(xs: List[string]) -> string
    if xs is not word :: _ then return "none"
    if word == "" then return "empty"
    word

// `break` and `continue` leave the branch too.
evens(xs: List[Option[int]]) -> int
    var count = 0
    for x in xs
        if x is not Some(n) then continue
        if n % 2 == 0 then count += 1
    count

// An `else` that never finishes keeps the positive names for what follows.
doubled(o: Option[int]) -> int
    if o is Some(v) then () else return 0
    v * 2

// Nested patterns, with a name for the whole and names inside.
nested(p: Pair) -> string
    if p is Pair(Some(n), Some(word)) && n > 0 then s"$word $n" else "partial"

whole(o: Option[Shape]) -> string
    if o is Some(shape @ Circle(r)) then s"circle $r" else "other"

// A name bound by `is` that a closure captures.
later(o: Option[int]) -> int
    if o is Some(v)
        val f = (k: int) -> k + v
        return f(10)
    0

// `!` swaps the outcomes: the names of a negated `!(x is not P)` hold in the `then` branch.
flipped(o: Option[int]) -> int
    if !(o is not Some(v)) then v else -1

// `||` where both sides fail binds the names of both negated tests.
sum2(a: Option[int], b: Option[int]) -> int
    if a is not Some(x) || b is not Some(y) then return 0
    x + y

// An `is` test that binds, used as a value: its names are in scope nowhere after it.
anyBig(o: Option[int]) -> bool
    val big = o is Some(n) && n > 100
    big

main() -> int
    println(s"${orZero(Some(4))} ${orZero(None)}")
    println(s"${described(Some(3))} ${described(None)}")
    println(s"${total(1 :: 2 :: 3 :: [])} ${total([])} ${joined(["a", "b", "c"])}")
    println(s"${firstNonZero([0, 0, 3, 4])} ${firstNonZero([0])} ${firstNonZero([])}")
    println(s"${bigger(Some(9), 5)} ${bigger(Some(2), 5)} ${bigger(None, 5)}")
    println(s"${both(Some(1), Some(2))} ${both(Some(3), Some(2))} ${both(None, Some(1))}")
    println(s"${size("four")} ${size(7)} ${size(2)} ${size(true)}")
    println(s"${area(Some(Rect(3, 4)))} ${area(Some(Circle(2)))} ${area(None)}")
    println(s"${firstWord(["hi", "there"])} ${firstWord([""])} ${firstWord([])}")
    println(s"${evens([Some(2), None, Some(3), Some(4)])}")
    println(s"${doubled(Some(21))} ${doubled(None)}")
    println(s"${nested(Pair(Some(2), Some("two")))} ${nested(Pair(Some(2), None))}")
    println(s"${whole(Some(Circle(5)))} ${whole(Some(Rect(1, 1)))}")
    println(s"${later(Some(5))} ${later(None)}")
    println(s"${flipped(Some(8))} ${flipped(None)}")
    println(s"${sum2(Some(1), Some(2))} ${sum2(None, Some(2))}")
    println(s"${anyBig(Some(101))} ${anyBig(Some(1))}")
    0
