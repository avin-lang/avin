// expect: exit 0
// env: AVIN_GC_STRESS=1
// The collector sees a moved array wherever it is: the receiver takes an array of strings, puts a
// new string in every element while making garbage enough to collect many times, and moves the array
// back; the sender then reads every string it was given, none of them collected. The array itself
// lives only in the `Isolated` while it is in the channel.
import avin.actors.Isolated
import avin.threads.{Channel, spawn}

main()
  val n = 2000
  val there = Channel[Isolated[Array[string]]](1)
  val back = Channel[Isolated[Array[string]]](1)
  val t = spawn(() ->
    val a = there.receive().get.take()
    var junk = 0
    for i in 0 ..< a.length
      a(i) = s"item-$i-" + "x".repeat(i % 7)
      val garbage = Vector.tabulate(8, k -> s"g$k$i")
      junk += garbage.length
    back.send(Isolated.move(a))
    junk)
  there.send(Isolated.move(Array.fill[string](n, "")))
  println(t.join())
  val a = back.receive().get.take()
  var good = 0
  for i in 0 ..< n
    if a(i) == s"item-$i-" + "x".repeat(i % 7) then good += 1
  println(s"$good of $n strings intact")
