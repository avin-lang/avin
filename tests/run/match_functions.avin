// A `match` with nothing before it, where a function is expected, is a function of one value whose
// arms cover every value: tuples, data variants, guards and block bodies.

data Shape
  Circle(r: real)
  Rect(w: real, h: real)
  Dot

describe(n: int, f: int -> string) -> string = f(n)

main()
  val pairs = [(1, "one"), (2, "two")]
  println(pairs.map(match (k, v) -> s"$k=$v").mkString(", "))

  val areas = [Circle(1.0), Rect(2.0, 3.0), Dot].map(match
    Circle(r) -> r * r * 3.0
    Rect(w, h) -> w * h
    Dot -> 0.0)
  println(areas.mkString(" "))

  val sign: (int) -> string = match
    n if n < 0 -> "negative"
    0 -> "zero"
    _ -> "positive"
  println(sign(-3) + " " + sign(0) + " " + sign(9))

  // The arms may have blocks for bodies, and see the locals around the function.
  val unit = "cm"
  val sizes = [Circle(2.0), Dot].map(match
    Circle(r) ->
      val d = r * 2.0
      s"$d$unit"
    Rect(w, _) -> s"$w$unit"
    Dot -> s"0$unit")
  println(sizes.mkString(" "))

  println(describe(5, match
    1 -> "one"
    n -> s"many: $n"))

  // After an infix method name at the end of a line.
  val firstWide = [Rect(1.0, 1.0), Rect(4.0, 1.0)] exists match
    Rect(w, _) if w > 2.0 -> true
    _ -> false
  println(s"$firstWide")

  val flags = [true, false].map(match
    true -> 1
    false -> 0)
  println(flags.mkString(","))
