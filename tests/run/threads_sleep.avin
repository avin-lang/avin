// expect: exit 0
// `sleep` pauses its thread for at least the duration given, and a duration of zero or less returns
// at once. Threads that sleep are safe for the collector: the main thread allocates and collects
// while they sleep, and they sleep side by side rather than one after another. Only lower bounds and
// generous upper bounds are checked, so a loaded machine cannot make the test fail.
import avin.threads.{sleep, spawn, Future}
import avin.time.{Duration, millis, micros, monotonic}

main() -> int
    val start = monotonic()
    sleep(millis(30))
    println(s"slept at least 30ms ${monotonic() - start >= millis(30)}")
    val tiny = monotonic()
    sleep(micros(1))
    sleep(Duration.Zero)
    sleep(millis(-5))
    sleep(Duration.Min)
    println(s"no time returns at once ${monotonic() - tiny < millis(1000)}")
    val together = monotonic()
    val sleepers = (0..<16).map(i -> spawn(() ->
        sleep(100.millis())
        i)).toVector
    var total = 0
    for t in sleepers do total += t.join()
    val took = monotonic() - together
    println(s"sixteen sleepers $total, at least 100ms ${took >= millis(100)}, side by side ${took < millis(1500)}")
    val collected = (0..<8).map(i -> spawn(() ->
        sleep(millis(50))
        s"sleeper $i".charCount())).toVector
    var garbage = 0
    for round in 0..<20
        val v = (0..<10).map(k -> s"value $k of $round").toVector
        garbage += v.length
    var lengths = 0
    for t in collected do lengths += t.join()
    println(s"collected while sleeping: garbage $garbage, lengths $lengths")
    val pooled = Future
        sleep(millis(10))
        "slept on the pool"
    println(pooled.await())
    0
