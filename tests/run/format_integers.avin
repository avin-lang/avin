// expect: exit 0
// `f"…"` integer conversions: `%d` and `%i` in decimal, `%x`, `%X`, `%o` and `%b` in their bases, a
// negative value in every base as its sign and magnitude; the flags `-`, `+`, a space, `0` and `#`; a
// width; a precision as a least count of digits, where a precision of 0 writes zero as nothing; and
// zero padding after the sign and the prefix, which gives way to `-` and to a precision. Every width
// of integer takes them, from `i8` to wider than `long`, and so does `byte`.
lowest[T: Integer](x: T) -> string = f"${x}%#x|${x}%+d"

main()
    val n = 42
    val m = -42
    println(f"[${n}%d] [${n}%i] [${m}%d] [${n}%5d] [${n}%-5d] [${n}%05d] [${m}%05d] [${m}%-05d]")
    println(f"[${n}%+d] [${m}%+d] [${n}% d] [${m}% d] [${n}%+05d] [${n}% 5d] [${0}%+d]")
    println(f"[${n}%.4d] [${m}%.4d] [${n}%8.4d] [${n}%08.4d] [${n}%-8.4d] [${0}%.0d] [${0}%5.0d] [${7}%.0d]")
    println(f"[${255}%x] [${255}%X] [${255}%o] [${5}%b] [${m}%x] [${m}%o] [${m}%b] [${0}%x]")
    println(f"[${255}%#x] [${255}%#X] [${255}%#o] [${5}%#b] [${0}%#x] [${0}%#o] [${0}%#b] [${8}%#.3o]")
    println(f"[${255}%#08x] [${m}%#08x] [${255}%-#8x|] [${255}%+x] [${255}%.6x] [${3}%08b]")
    val small: i8 = -128
    val wide: i128 = 170141183460469231731687303715884105727
    val low: i128 = -170141183460469231731687303715884105728
    val huge = -(i200(wide) * i200(1000000))
    println(f"[${small}%d] [${small}%x] [${small}%05d] [${small}%b]")
    println(f"[${wide}%d] [${wide}%x] [${low}%x] [${wide}%45d] [${low}%-+42d|]")
    println(f"[${huge}%X] [${huge}%064d] [${huge}%o]")
    val longest: long = -9223372036854775807 - 1
    println(f"[${longest}%d] [${longest}%x] [${longest}%025d]")
    val b = byte(0xfe)
    println(f"[${b}%d] [${b}%x] [${b}%#010b] [${b}%5o]")
    println(lowest(-255), lowest(wide))
