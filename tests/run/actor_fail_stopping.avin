// expect: exit 0
// A trap in a `stopping` block is reported, and the actor ends without running it again: it ends
// `Failed` with that trap's reason when it was stopping, keeps the first reason when a trap had
// already failed it, and ends rather than starting again when the block ran for a restart. Its
// supervision is not asked again, so its parent goes on. The rest of an actor's `onStopping`
// functions do not run after one traps.
import avin.actors.{ActorContext, ActorRef, Behaviour, Restart, Stop, spawn}
import avin.threads.Channel
import avin.time

data Msg
  Quit
  Fail
  Ping(reply: ActorRef[string])

actor Closer(log: Channel[string]) receives Msg
  var open = 3
  receive
    Quit -> stop()
    Fail -> open = open / (open -open)
    Ping(r) -> r.tell("pong")
  stopping
    log.send("closing")
    val handles = Vector(1, 2, 3)
    log.send(s"${handles(open)}")

actor Parent(log: Channel[string], refs: Channel[ActorRef[Msg]]) receives Msg
  refs.send(spawn(Closer(log)))
  receive
    Ping(r) -> r.tell(s"parent has ${children().length} children")
    _ -> ()

main()
  val log = Channel[string]()
  // Stopped, then the block traps: `Failed` with the block's reason.
  val a = spawn(Closer(log), onFailure = Stop)
  a.tell(Quit)
  println(a.ended().await())
  println(log.receive().get)
  // Failed in an arm, then the block traps as well: the arm's reason stays.
  val b = spawn(Closer(log), onFailure = Stop)
  b.tell(Fail)
  println(b.ended().await())
  println(log.receive().get)
  // The block runs for a restart and traps: the actor ends instead of starting again, and the
  // message waiting behind the failure is dropped with its mailbox.
  val c = spawn(Closer(log), onFailure = Restart(5, time.minutes(1)))
  c.tell(Fail)
  c.tell(Ping(spawn(Behaviour[string]("Never", me -> s -> println(s)))))
  println(c.ended().await())
  println(log.receive().get)
  // A child whose block traps as it stops ends `Failed`, and its parent is not failed by it.
  val refs = Channel[ActorRef[Msg]]()
  val p = spawn(Parent(log, refs))
  val child = refs.receive().get
  child.tell(Quit)
  println(child.ended().await())
  println(log.receive().get)
  println(p.ask(r -> Ping(r), timeout = time.seconds(60)).await())
  // Of several `onStopping` functions, those after one that traps do not run.
  val d = spawn(Behaviour[int]("Steps", me ->
    val ctx = ActorContext(me)
    ctx.onStopping(() -> log.send("first"))
    ctx.onStopping(() -> log.send(s"${Vector[string]().head}"))
    ctx.onStopping(() -> log.send("third"))
    _ -> ctx.stop()), onFailure = Stop)
  d.tell(0)
  println(d.ended().await())
  println(log.receive().get)
  println(log.tryReceive())
