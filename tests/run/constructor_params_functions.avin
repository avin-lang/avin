// expect: exit 0
// Constructor parameters on functions and methods, written at calls: one hole and two, the
// constructor argument written as a generic type named bare, a partial application, an alias that
// is a constructor and another constructor parameter, bare or partially applied. `F[int]` at
// `Vector` is a `Vector[int]`, its elements unboxed, and each instance knows its type exactly.
data ParseError(message: string)

type Parsed[T] = Result[T, ParseError]
type Flip[A, B] = Either[B, A]

same[F[_], A](x: F[A]) -> F[A] = x

pick[F[_]](a: F[int], b: F[int], first: bool) -> F[int] = if first then a else b

both[G[_, _]](x: G[int, string]) -> G[int, string] = x

through[F[_]](x: F[int]) -> F[int] = same[F, int](x)

right[G[_, _]](x: G[string, long]) -> G[string, long] = same[G[string, _], long](x)

nest[F[_]](x: F[F[int]]) -> F[F[int]] = x

later[F[_]](x: F[string]) -> () -> F[string] = () -> x

isInts[F[_]](x: Any) -> bool = x match
  _: F[int] -> true
  _ -> false

either[F[_]](x: F[int] | string) -> string = x match
  s: string -> "text " + s
  _ -> "an F[int]"

asAny[F[_]](x: F[int]) -> Any = x

local[F[_]](x: F[int], y: F[int]) -> F[int]
  val first: F[int] = x
  var chosen: F[int] = first
  chosen = y
  chosen

depth[F[_]](n: int, x: F[int]) -> int = if n == 0 then 0 else 1 + depth[F](n - 1, x)

equal[F[_]](a: F[int], b: F[int]) -> bool = a == b

defaulted[F[_]](x: F[int], label: string = "plain") -> string = label

class Pair[A](val first: A)
  wrap[F[_]](x: F[A]) -> F[A] = x
  pairWith[G[_, _]](x: G[A, A]) -> G[A, A] = x

object Tools
  keep[F[_]](x: F[bool]) -> F[bool] = x

main()
  println(same[Vector, int]([1, 2, 3]))
  println(same[Vector]([4, 5]))
  println(same[Option, string](Some("ü✓")))
  println(same[Result[_, ParseError], int](Ok(4)))
  println(same[Parsed, int](Err(ParseError("bad"))))
  println(same[Map[string, _], int]({"k": 7}))
  println(same[Either[string, _], real](Right(1.5)))
  println(pick[Vector]([1], [2], false))
  println(pick[Option](None, Some(9), true))
  println(both[Either](Left(3)))
  println(both[Result](Err("e")))
  println(both[Flip](Left("flipped")))
  println(through[Option](Some(2147483647)))
  println(right[Either](Right(9223372036854775807)))
  println(right[Result](Ok("r")))
  println(nest[Option](Some(Some(-2147483648))))
  println(nest[Vector]([[], [1], [2, 3]]))
  val f = later[Vector](["", "a"])
  println(f())
  println(isInts[Vector]([1, 2]))
  println(isInts[Vector](["a"]))
  println(isInts[Vector]([]))
  println(isInts[Parsed](Ok(1)))
  println(isInts[Result[_, ParseError]](Ok("s")))
  println(isInts[Result[_, string]](Ok(1)))
  println(either[Option](Some(1)))
  println(either[Option]("s"))
  println(asAny[Vector]([3]))
  println(local[Option](None, Some(0)))
  println(depth[Vector](3, [1]))
  println(equal[Option](Some(1), Some(1)))
  println(equal[Vector]([1], [2]))
  println(defaulted[Option](None))
  println(defaulted[Option](None, label = "named"))
  println(Pair(1).wrap[Option](Some(2)))
  println(Pair("p").pairWith[Either](Right("q")))
  println(Tools.keep[Vector]([true, false]))
  val g = same[Vector, string]
  println(g(["fn"]))
  var total = 0
  for x in same[Vector, int]([10, 20, 30])
    total += x
  println(total)
