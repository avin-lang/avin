// expect: trap
// Recursion without a base case overflows the stack of a thread a scope started, a lightweight thread
// on a stack reserved for it, and stops the whole program with the trap every thread reports.
import avin.threads.scope

descend(n: int) -> int = descend(n + 1) + n

main() -> int
  println("before")
  scope(s ->
    val t = s.spawn(() -> descend(0))
    println(t.join()))
  println("after")
  0
