// expect: trap
// A trap inside a future's body stops the whole program, as a trap in any thread does: what was
// written before it is flushed once, the trap is reported at the body's own line, and the waiting
// main thread never goes on.
import avin.threads.Future

divide(a: int, b: int) -> int = a / b

main() -> int
    print("before")
    val f = Future.apply(divide(1, 0))
    f.await()
    print("after")
    0
