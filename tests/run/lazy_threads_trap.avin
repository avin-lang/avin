// expect: trap
// A trap inside a `lazy val`'s initializer while other threads wait for its value stops the whole
// program, once, at the initializer's own site: the waiting threads never go on with a value that
// was never stored.
import avin.threads.{sleep, Atomic, scope}
import avin.time.millis

val arrived = Atomic(0)
val divisor = Atomic(0)

lazy val ratio: int =
    while arrived.load() < 6 do ()
    sleep(millis(20))
    100 / divisor.load()

main() -> int
    println("before")
    scope(s ->
        for _ in 0..<6
            s.spawn(() ->
                arrived.add(1)
                println(ratio)))
    println("after")
    0
