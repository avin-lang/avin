// `flush()` sends what has been written to standard output on its way even when no line is complete:
// a partial line written before another writer of the same standard output (a file write to
// `/dev/stdout`, a child process) arrives before that writer's text. Without the flush the partial
// line waits and the other text overtakes it. Flushing with nothing buffered, repeatedly, and after a
// large write all work, and `StandardOutput.flush()` and `StandardError.flush()` are available beside
// the top-level one.
import avin.process.Command
import avin.fs

main()
  print("a")
  flush()
  _ = fs.writeText("/dev/stdout", "b")
  print("c")
  StandardOutput.flush()
  _ = fs.writeText("/dev/stdout", "d")
  print("e")
  flush()
  _ = Command("/bin/sh", "-c", "printf f").run()
  println()
  flush()
  flush()
  StandardOutput.flush()
  StandardError.flush()
  print("x".repeat(200000).byteLength)
  flush()
  _ = fs.writeText("/dev/stdout", "|")
  print("y".repeat(200000).byteLength)
  flush()
  _ = fs.writeText("/dev/stdout", "|")
  println("done")
