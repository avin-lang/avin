// expect: exit 0
// A type parameter given several arguments takes their join, as the branches of an `if` do: each
// argument where a value is read out is a lower bound, and the type argument is the least type
// above them all. The first argument does not decide it alone.

open class Animal(val name: string)
open class Dog(n: string) : Animal(n)
class Cat(n: string) : Animal(n)
class Puppy(n: string) : Dog(n)

trait Named
    label() -> string

trait Pet : Named
    owner() -> string

class Parrot(n: string) : Pet
    override label() -> string = s"parrot $n"
    override owner() -> string = "ann"

class Goldfish(n: string) : Pet
    override label() -> string = s"goldfish $n"
    override owner() -> string = "bob"

class Robot(n: string) : Named
    override label() -> string = s"robot $n"

pair[T](a: T, b: T) -> (T, T) = (a, b)

firstOf[T](a: Option[T], b: Option[T]) -> Option[T] = a.orElse(b)

largest[T: Ord](a: T, b: T) -> T = if a < b then b else a

class Holder[+T](val left: T, val right: T)
    both() -> List[T] = [left, right]

class Box[T](var item: T)

// `T` is a lower bound from `x` and then decided by the invariant `Box[T]`, which `x` fits.
put[T](x: T, b: Box[T]) -> T
    b.item = x
    b.item

// Overloads are chosen with each candidate's own inference, which joins the same way.
kind[T](a: T, b: T) -> string = "one type"
kind(a: int, b: string) -> string = "int and string"

names(xs: List[Animal]) -> string
    var out = ""
    for x in xs do out = if out == "" then x.name else out + " " + x.name
    out

labels(xs: List[Named]) -> string
    var out = ""
    for x in xs do out = if out == "" then x.label() else out + "; " + x.label()
    out

main()
    // `::` is `Cons`: a cat in front of dogs is a list of animals, with nothing expected.
    val dogs: List[Dog] = [Dog("rex"), Dog("fido")]
    val all = Cat("tom") :: dogs
    println(names(all))
    println(names(Cons(Cat("kit"), dogs)))
    println(names(Puppy("bit") :: dogs))

    // Two arguments of one type parameter: the nearest common superclass, either order.
    val p = pair(Cat("a"), Dog("b"))
    println(s"${p.0.name} ${p.1.name}")
    val q = pair(Puppy("c"), Cat("d"))
    println(names([q.0, q.1]))

    // Inside a generic argument, covariance carries the join: `Option[Cat]` and `Option[Dog]`
    // give `Animal`, and an argument checked after the first is not held to it.
    println(firstOf(Some(Cat("e")), Some(Dog("f"))).map(x -> x.name).getOrElse("none"))
    println(firstOf(None, Some(Dog("g"))).map(x -> x.name).getOrElse("none"))

    // Numbers keep their rules: a literal takes the other argument's type, whatever its spelling.
    println(largest(0x10, 7))
    println(largest(1_000, 999))
    val big: long = 5000000000
    println(largest(big, 3))

    // A generic class's constructor joins its arguments the same way.
    val h = Holder(Dog("h"), Cat("i"))
    println(names(h.both()))

    // Two classes with no common superclass join to the one trait they share that every other
    // they share is a parent of: `Pet`, not also `Named`.
    val pets = pair(Parrot("polly"), Goldfish("nemo"))
    println(s"${pets.0.owner()} ${pets.1.owner()}")
    val named = Robot("r2") :: [Parrot("kea")]
    println(labels(named))

    // The same rule joins branches.
    val either = if big > 0 then Parrot("lory") else Goldfish("koi")
    println(either.owner())

    val animals: Box[Animal] = Box(Animal("z"))
    println(put(Dog("j"), animals).name)
    println(s"${kind(Cat("k"), Dog("l"))}, ${kind(1, "m")}")

    // An expected type still decides the type argument before the arguments.
    val wide: (Named, Named) = pair(Parrot("x"), Robot("y"))
    println(wide.1.label())
    val anything: Any = largest(1, 2)
    val shown = anything match
        n: int -> s"int $n"
        _ -> "other"
    println(shown)
