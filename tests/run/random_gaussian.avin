// expect: exit 0
// `nextGaussian` with a fixed seed has a mean near 0 and a variance near 1, and about 68% of its
// values within one standard deviation; `setSeed` drops the value the polar method kept, so the
// sequence after it is the seed's own.
import avin.random.Random

main()
    val g = Random(31337)
    val n = 100000
    var sum = 0.0
    var squares = 0.0
    var within = 0
    for i in 0..<n
        val x = g.nextGaussian()
        sum += x
        squares += x * x
        if x > -1.0 && x < 1.0 then within += 1
    val mean = sum / real(n)
    val variance = squares / real(n) - mean * mean
    println(s"mean near 0: ${mean > -0.02 && mean < 0.02}")
    println(s"variance near 1: ${variance > 0.98 && variance < 1.02}")
    println(s"within one: ${within > 67500 && within < 69000}")

    val a = Random(8)
    val first = a.nextGaussian()
    a.nextGaussian()
    a.nextGaussian()
    a.setSeed(8)
    println(a.nextGaussian() == first)
