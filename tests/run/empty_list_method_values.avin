// expect: exit 0
// A method declared with an empty parameter list, named without a call, is a function value where a
// function type is expected: an annotated `val`, a parameter of function type (a generic one
// included), an element of a collection of functions, an `Option` of one, a field and a result. The
// value holds its receiver, so it sees the receiver's later state; it works for static members
// reached through their type, for trait methods through the trait, for a generic class's methods, for
// a bare name inside the class, and for one overload chosen by the expected function type. A method
// with parameters is a value wherever it is named, with no expected type at all.

trait Zero
    static zero() -> Self

class Counter(var n: int): Zero
    override static zero() -> Counter = Counter(0)
    bump() -> int
        n = n + 1
        n
    add(k: int) -> int
        n = n + k
        n
    over() -> int = n
    over(k: int) -> int = n * k
    bumper() -> () -> int = bump

trait Named
    name() -> string

class Dog: Named
    override name() -> string = "rex"

class Cat: Named
    override name() -> string = "tom"

class Box[T](item: T)
    get() -> T = item

class Holder(f: () -> int)
    run() -> int = f()

apply(f: () -> int) -> int = f()
twice[T](f: () -> T) -> (T, T) = (f(), f())
maker(c: Counter) -> () -> int = c.bump

main()
    val c = Counter(0)
    val f: () -> int = c.bump
    println(f(), f(), apply(c.bump), twice(c.bump))
    val g = c.add
    println(g(10), c.n)
    val h: () -> Counter = Counter.zero
    println(h().n)
    val named: Vector[Named] = [Dog(), Cat()]
    val names: Vector[() -> string] = named.map(a -> a.name)
    println(names.map(n -> n()))
    val k: () -> string = named(1).name
    println(k())
    val fs: Vector[() -> int] = [c.bump, c.bump]
    println(fs(0)(), fs(1)())
    val o: Option[() -> int] = Some(c.bump)
    println(o.get()())
    println(c.bumper()(), maker(c)(), Holder(c.bump).run())
    val b = Box("héllo")
    val gb: () -> string = b.get
    println(gb(), twice(b.get))
    val big: Box[long] = Box(9223372036854775807)
    val gl: () -> long = big.get
    println(gl())
    val o0: () -> int = c.over
    val o1: (int) -> int = c.over
    println(o0(), o1(2))
    c.n = -5
    println(f(), o0())
    println(Vector(1, 2, 3).map(x -> f() + x))
