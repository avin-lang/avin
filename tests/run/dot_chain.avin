// expect: exit 0
// A line that starts with a member's `.`, indented deeper than the line its expression began on,
// continues that expression, wherever an operator line would: a method chain one call per line.

class Log
    var parts: Vector[string] = []
    add(s: string) -> Log
        parts = parts :+ s
        self
    joined -> string = parts.mkString("+")

data Person(name: string, age: int)

// A clause's body.
describe(n: int) -> string
describe(n < 0) = "neg"
    .reverse
describe(n) = [n, n + 1]
    .map(_ * 10)
    .mkString(",")

// A return value, and `?` after a `.` line.
firstWord(lines: Vector[string]) -> Option[string]
    val first = lines
        .headOption?
        .trim
    return first
        .split(" ")
        .headOption

// A function's `=` body on the line of its signature.
total(xs: Vector[int]) -> int = xs
    .filter(_ > 1)
    .sum

main() -> int
    // A binding's value, several dots.
    val xs = [3, 1, 2]
        .map(_ * 2)
        .filter(_ > 2)
        .sorted
    println(xs)

    // A field read and a parameterless method, with blank lines and comments between.
    val people = [Person("ann", 31), Person("bo", 17), Person("cy", 45)]
    val adults = people

        // the adults
        .filter(_.age >= 18)
        // by name
        .map(_.name)

        .mkString(" ")
    println(adults)

    // `.` binds to the operand right before it, as on one line: `10 - xs.length`.
    val n = 10 - xs
        .length
    println(n)
    // Operators and `.` lines mix, each line at its own precedence.
    val m = xs
        .length
        * 100
        + people
            .length
    println(m)

    // An assignment.
    var s = ""
    s = "  Avin  "
        .trim
        .reverse
    println(s)

    // An expression statement, with Unicode in the chain.
    val log = Log()
    log
        .add("é")
        .add("日本")
        .add("")
    println(log.joined)

    // An infix call's argument: `log.add("ab".reverse)`.
    log add "ab"
        .reverse
    println(log.joined)

    // A `match` arm's body.
    val word = xs.length match
        2 -> "two"
            .reverse
        _ -> "other"
    println(word)

    // A lambda's body.
    val inc = (v: Vector[int]) -> v
        .map(_ + 1)
    println(inc([1, 2]))

    // A branch of a one-line `if`.
    val pick = if xs.length > 1 then xs
        .head
    else 0
    println(pick)

    // A trailing lambda's body inside a chain, and the chain going on after it.
    val ys = xs
        .map x ->
            x + 1
        .filter(_ > 5)
    println(ys)

    // A one-element and an empty chain.
    println([7]
        .map(_ + 1))
    val none: Vector[int] = []
    println(none
        .map(_ + 1)
        .length)

    println(describe(-1))
    println(describe(4))
    println(firstWord(["  hello world", "x"]))
    println(firstWord([]))
    println(total([1, 2, 3]))
    0
