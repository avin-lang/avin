// expect: exit 0
// The help, the usage line and the version `avin.cli` writes from a parser's declarations, the
// `--help`/`-h`/`--version` requests, required options and arguments, and a program declaring `help`
// or the letter `h` itself.
import avin.cli

tried(p: cli.Parser, args: Vector[string])
  p.parse(args) match
    Ok(_) -> println("ok")
    Err(cli.HelpRequested(text)) -> println(s"help, the same as `help`: ${text == p.help}")
    Err(cli.VersionRequested(text)) -> println(s"version: $text")
    Err(cli.Invalid(message, usage)) -> println(s"invalid: $message | $usage")

main()
  val full = cli.Parser("tool", "Copy things somewhere.", version = "1.2.3")
    .string("to", help = "the directory to copy into", required = true, value = "dir")
    .flag("verbose", short = 'v', help = "say more")
    .int("jobs", short = 'j', help = "how many at once", default = 4)
    .int("retries", help = "how often to try again")
    .real("ratio", default = 0.25)
    .choice("mode", ["fast", "safe"], short = 'm', help = "how to copy", default = "safe")
    .string("exclude", short = 'x', help = "a pattern to leave out", repeated = true)
    .positional("source", help = "what to copy")
    .positionals("more", help = "more to copy")
  println("-- usage")
  println(full.usage)
  println("-- help")
  print(full.help)
  println("-- requests")
  tried(full, ["--version"])
  tried(full, ["--help"])
  tried(full, ["--help=yes"])
  tried(full, ["-vh"])
  tried(full, ["--bogus", "--help"])
  tried(full, ["--help", "--bogus"])
  tried(full, ["--", "--help"])
  println("-- required")
  tried(full, ["a"])
  tried(full, ["--to", "d"])
  tried(full, ["--to", "d", "a", "b", "c"])
  println("-- the bare minimum")
  val bare = cli.Parser("bare")
  println(bare.usage)
  print(bare.help)
  tried(bare, [])
  tried(bare, ["x"])
  tried(bare, ["--version"])
  tried(bare, ["-h"])
  println("-- optional arguments")
  val opt = cli.Parser("opt").positional("a", required = false).positionals("rest")
  println(opt.usage)
  tried(opt, [])
  tried(opt, ["x", "y", "z"])
  val rest = cli.Parser("rest").positional("first").positionals("others", required = true)
  println(rest.usage)
  tried(rest, ["x"])
  tried(rest, ["x", "y"])
  println("-- a program's own help and h")
  val own = cli.Parser("own", version = "9")
    .flag("help", help = "the program's own help")
    .flag("hidden", short = 'h')
    .flag("version")
  print(own.help)
  own.parse(["--help", "-h", "--version"]) match
    Ok(a) -> println(s"${a.flag("help")} ${a.flag("hidden")} ${a.flag("version")}")
    Err(e) -> println(s"error: $e")
  val letter = cli.Parser("letter").flag("host", short = 'h')
  print(letter.help)
  tried(letter, ["--help"])
  tried(letter, ["-h"])
  println("-- Unicode in names and help")
  val wide = cli.Parser("ünï", "Ça marche.").string(
    "größe",
    short = 'ß',
    help = "wie groß"
  ).positional("datei", help = "文件")
  print(wide.help)
  wide.parse(["-ß", "9", "x"]) match
    Ok(a) -> println(s"${a.string("größe")} ${a.string("datei")}")
    Err(e) -> println(s"error: $e")
