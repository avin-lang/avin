// expect: exit 0
// A bounded channel holds its sender back: a producer sending as fast as it can to a channel of
// capacity 3 never gets more than 3 values ahead of a consumer that works on each one, and every
// value arrives once, in order. `trySend` refuses a value while the channel is full.
import avin.threads.{Atomic, Channel, spawn}

slowly(x: int) -> int
  var acc = 0
  for i in 0 ..< 2000 do acc = (acc + x * i) % 1000003
  acc

main() -> int
  val ch = Channel[string](3)
  val sent = Atomic(0)
  val count = 3000
  val producer = spawn(() ->
    for i in 0 ..< count
      ch.send(s"v$i")
      sent.add(1)
    ch.close())
  var received = 0
  var wrong = 0
  var ahead = 0
  var work = 0
  loop
    ch.receive() match
      Some(v) ->
        if v != s"v$received" then wrong += 1
        received += 1
        if sent.load() > received + 3 then ahead += 1
        work = (work + slowly(received)) % 1000003
      None -> break
  producer.join()
  println(s"$received received, $wrong out of order, $ahead times too far ahead")
  val full = Channel[int](2)
  println(full.trySend(1))
  println(full.trySend(2))
  println(full.trySend(3))
  println(full.tryReceive())
  println(full.trySend(3))
  if received == count && wrong == 0 && ahead == 0 then 0 else 1
