// expect: exit 0
// `head #:: tail` makes a lazy list whose `tail` is taken by name: it is not evaluated when the list
// is made, nor when its first cell is read, but when its second cell is first read, and then once.
// The operator groups to the right, binds as `::` does (more loosely than arithmetic, more tightly
// than comparisons), and lets a `lazy val` or a recursive function name the list being defined:
// Fibonacci numbers, primes by a sieve, an endless counter and a constant list. Covers inference of
// the element type from the tail and from the expected type, a supertype head on a subtype tail, a
// generic function, a class field, captured `var`s read at evaluation, Unicode and the extreme ints,
// the dotted call `LazyList.#::`, and a long list walked under the collector.

open class Animal(val name: string)
class Dog(n: string): Animal(n)

var evaluations = 0

counted(xs: LazyList[int]) -> LazyList[int]
  evaluations += 1
  xs

lazy val fibs: LazyList[long] = 0 #:: 1 #:: fibs.zip(fibs.tail).map((a, b) -> a + b)

sieve(xs: LazyList[int]) -> LazyList[int]
  val p = xs.head
  p #:: sieve(xs.tail.filter(n -> n % p != 0))

lazy val primes: LazyList[int] = sieve(LazyList.from(2))

countFrom(n: int) -> LazyList[int] = n #:: countFrom(n + 1)

prepend[T](x: T, xs: LazyList[T]) -> LazyList[T] = x #:: xs

class Holder
  lazy val ones: LazyList[int] = 1 #:: ones

laziness() =
  evaluations = 0
  val xs = 1 #:: counted(2 #:: counted(LazyList.empty()))
  println(evaluations)
  println(xs.head)
  println(xs.isEvaluated())
  println(evaluations)
  println(xs.tail.head)
  println(evaluations)
  println(xs.toVector)
  println(evaluations)
  println(xs.toVector)
  println(xs.length)
  println(evaluations)
  // A tail never read is never evaluated.
  evaluations = 0
  val unread = 7 #:: counted(8 #:: LazyList.empty())
  println(unread.take(1).toVector)
  println(evaluations)

grouping() =
  // Arithmetic in the head binds first; `#::` binds more tightly than a comparison.
  val n = 4
  val ys = n + 1 #:: n * 2 #:: n - 10 #:: LazyList.empty[int]()
  println(ys.toVector)
  println((1 #:: LazyList.empty[int]()).head == 1)
  // `+:` binds at the additive level, so it is parenthesized to prepend to a `#::` list; `++`
  // joins a list made by `#::`, and `#::` prepends to a joined one.
  val zs = 0 +: (1 #:: LazyList.empty[int]())
  println(zs.toVector)
  val joined = (1 #:: LazyList.empty[int]()) ++ (2 #:: LazyList.empty[int]())
  println(joined.toVector)
  val front = 0 #:: (joined ++ LazyList.from(3).take(2))
  println(front.toVector)
  // The other operators ending in `:` are as they were.
  println(3 +: Vector(4, 5))
  println(3 +: List(4, 5))
  println(3 :: 4 :: List(5))
  println(3 +: 4 +: Vector[int]())

endless() =
  println(fibs.take(12).toVector)
  println(fibs(90))
  println(primes.take(10).toVector)
  println(countFrom(5).drop(3).take(3).toVector)
  println(Holder().ones.take(4).toVector)

types() =
  val e: LazyList[int] = 1 #:: LazyList.empty()
  println(e.toVector)
  println(prepend("a", prepend("b", LazyList.empty())).toVector)
  val animals: LazyList[Animal] = Dog("rex") #:: LazyList.empty[Animal]()
  println(animals.map(a -> a.name).toVector)
  val mixed = Animal("cat") #:: Dog("rex") #:: LazyList.empty[Dog]()
  println(mixed.map(a -> a.name).toVector)
  val unicode = "é" #:: "日本" #:: "👋" #:: LazyList.empty[string]()
  println(unicode)
  unicode.force()
  println(unicode)
  val extremes = -2147483648 #:: 2147483647 #:: LazyList.empty[int]()
  println(extremes.toVector)
  val longs: LazyList[long] = -9223372036854775808 #:: 9223372036854775807 #:: LazyList.empty()
  println(longs.toVector)
  println(LazyList.#::(7, LazyList.empty[int]()).toVector)
  val tuples = (1, "one") #:: (2, "two") #:: LazyList.empty[(int, string)]()
  println(tuples.map(t -> t.1).toVector)

captures() =
  // The head is evaluated where it is written; the tail, holding the next head, when it is read.
  var k = 10
  val xs = k #:: k + 1 #:: LazyList.empty[int]()
  k = 20
  println(xs.toVector)
  var label = "first"
  val f = () -> label #:: LazyList.empty[string]()
  label = "second"
  println(f().toVector)

collected() =
  // A long list made by `#::`, walked and counted without deepening the stack.
  println(countFrom(0).take(3000).foldLeft(long(0), (acc, n) -> acc + long(n)))
  println(countFrom(0).drop(2000).head)

main() =
  laziness()
  grouping()
  endless()
  types()
  captures()
  collected()
