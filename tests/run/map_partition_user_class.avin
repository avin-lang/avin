// expect: exit 0
// A user class that implements `Map` inherits `partition(p)` for a two-parameter predicate, which
// answers `Map`s (via `removed`, so the class's own kind), `p` called once per entry; a class may
// also override it. A filtered view and a default wrapper partition likewise.

class Wrapped[K, V](private val inner: Map[K, V]): Map[K, V]
    override size() -> int = inner.size()
    override get(key: K) -> Option[V] = inner.get(key)
    override updated[W >: V](key: K, value: W) -> Map[K, W] = Wrapped(inner.updated(key, value))
    override removed(key: K) -> Map[K, V] = Wrapped(inner.removed(key))
    override keySet() -> Set[K] = inner.keySet()
    override transform[W](f: (K, V) -> W) -> Map[K, W] = inner.transform(f)
    override iterator() -> Iterator[(K, V)] = inner.iterator()

class Tagged[K, V](private val inner: Map[K, V]): Map[K, V]
    override size() -> int = inner.size()
    override get(key: K) -> Option[V] = inner.get(key)
    override updated[W >: V](key: K, value: W) -> Map[K, W] = Tagged(inner.updated(key, value))
    override removed(key: K) -> Map[K, V] = Tagged(inner.removed(key))
    override keySet() -> Set[K] = inner.keySet()
    override transform[W](f: (K, V) -> W) -> Map[K, W] = inner.transform(f)
    override iterator() -> Iterator[(K, V)] = inner.iterator()
    override partition(p: (K, V) -> bool) -> (Map[K, V], Map[K, V]) = (inner.filter(p), inner.filter((k, v) -> !p(k, v)))

kind(m: Any) -> string = m match
    _: Wrapped[int, string] -> "wrapped"
    _: Tagged[int, string] -> "tagged"
    _: TreeMap[int, string] -> "tree"
    _ -> "other"

main()
    val base = TreeMap((1, "a"), (2, "b"), (3, "c"), (4, "d"))
    var calls = 0
    val w: Map[int, string] = Wrapped(base)
    val (wy, wn) = w.partition((k, v) ->
        calls += 1
        k % 2 == 0)
    println(kind(wy), kind(wn), wy.size(), wn.size(), calls, wy.get(2), wn.get(2))
    val t: Map[int, string] = Tagged(base)
    val (ty, tn) = t.partition((k, v) -> k > 2)
    println(kind(ty), kind(tn), ty.size(), tn.size())
    val (ey, en) = Wrapped(TreeMap.empty[int, string]()).partition((k, v) -> true)
    println(ey.size(), en.size())
    val (vy, vn) = w.partition(e -> e.0 < 3)
    println(vy, vn)
    val fv = base.withFilter(e -> e.0 > 1)
    println(fv.map(e -> e).size())
