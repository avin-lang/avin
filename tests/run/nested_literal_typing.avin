// expect: exit 0
// A number literal inside a value built around it (a collection literal, a tuple, `Some(1)`, a generic
// constructor) takes the number type its expected type gives it, and that expected type may come from
// another argument of a generic call: in `assertEq[T](actual: T, expected: T)`, `T` decided as a
// `Vector[long]` by `f()` makes `[1, 2]` a `Vector[long]`, whichever argument is written first.

same[T](a: T, b: T) -> T = b

named[T](first: T, second: T = first) -> T = second

mapIt[A, B](x: A, f: (A) -> B) -> B = f(x)

class Box[T](val item: T)

open class Animal(val n: int)
class Dog(k: int): Animal(k)
class Cat(k: int): Animal(k)

longs() -> Vector[long] = [long(7)]
someLong() -> Option[long] = Some(long(7))
table() -> Map[string, long] = {"a": long(7)}
pairOf() -> (long, byte) = (1, 2)

// A literal in a declared result takes the result's numbers.
resultOption() -> Option[long] = Some(9_000_000_000)
resultReals() -> Vector[real] = [1, 2]

wide(v: Vector[int]) -> string = "int"
wide(v: Vector[long]) -> string = "long"

kind(o: Option[long], n: int) -> string = "option and int"
kind(o: Option[long], s: string) -> string = "option and string"

main()
  // The decided type comes first, then the literal-holding argument; and the other way round.
  assertEq(longs(), [7])
  assertEq([7], longs())
  assertEq(someLong(), Some(7))
  assertEq(Some(7), someLong())
  assertEq(table(), {"a": 7})
  assertEq({"a": 7}, table())
  assertEq(pairOf(), (1, 2))
  assertEq((1, 2), pairOf())
  println("assertEq")

  // Nested shapes: options in vectors, vectors in vectors, a tuple in a box.
  val x: long = 5
  val nested = same([Some(x)], [Some(1), None])
  val nestedLongs: Vector[Option[long]] = nested
  println(nestedLongs)
  val deep = same([[x]], [[2_147_483_648], []])
  println(deep)
  val boxed = same(Box((x, 1.5)), Box((3_000_000_000, 2)))
  println(boxed.item)
  val bothSome = same(Some(1), Some(long(2)))
  val asLong: Option[long] = bothSome
  println(asLong)

  // The extremes of the decided width fit; `real` takes an exact integer.
  println(same([x], [9_223_372_036_854_775_807, -9_223_372_036_854_775_808]))
  val b: byte = 1
  println(same([b], [0, 255]))
  println(same(Some(i8(1)), Some(-128)))
  println(same([1.5], [1, 9_007_199_254_740_992]))

  // Declared types, as before: a binding, a declared result.
  val v: Vector[long] = [1, 2]
  val o: Option[long] = Some(1)
  val m: Map[string, long] = {"a": 1}
  val vo: Vector[Option[long]] = [Some(1), None]
  val t: (long, byte) = (1, 2)
  val r: real = 1
  println(s"$v $o $m $vo $t $r")
  println(resultOption())
  println(resultReals())

  // Named arguments in either order, and a default.
  println(named(second = [1, 2], first = longs()))
  println(named(first = longs(), second = [3]))
  println(named(longs()))

  // A lambda returning a literal-holding value, and one passed to a generic call.
  val g: (int) -> Option[long] = (n) -> if n > 0 then Some(1) else Some(3_000_000_000)
  println(g(0))
  val h: Vector[Option[long]] = mapIt(0, (n) -> [Some(1), None])
  println(h)
  println(mapIt(longs(), (xs) -> same(xs, [4, 5])))

  // A conversion keeps the type it names, and decides for the other argument.
  println(same(Some(long(1)), Some(2)))

  // Reference types other arguments decide are still widened by a later one: no literal decides them.
  val dogs: Vector[Dog] = [Dog(1)]
  val joined = same(dogs, [Cat(2)])
  val animals: Vector[Animal] = joined
  println(animals.size)
  val joinedOption = same(Some(Dog(1)), Some(Cat(2)))
  val pets: Option[Animal] = joinedOption
  println(!pets.isEmpty)
  val joinedBox = same(Some([Dog(1)]), Some([Cat(2)]))
  val boxedAnimals: Option[Vector[Animal]] = joinedBox
  println(!boxedAnimals.isEmpty)

  // With nothing else deciding, a literal keeps its own type.
  val ints = same([1], [2])
  val stillInts: Vector[int] = ints
  println(stillInts)

  // Overloads: a nested literal is checked once, at its own type, where the candidates' parameters
  // differ; where they agree on it, it takes that type.
  println(wide([1]))
  println(kind(Some(1), 2))
  println(kind(Some(1), "x"))
