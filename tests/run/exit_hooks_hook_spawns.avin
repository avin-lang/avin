// A hook may start a thread of its own, or a future, and wait for it: the program's threads go on
// running while the hooks run, so work handed to one in a hook finishes.
import avin.process
import avin.threads.{Future, spawn}

main()
  process.onExit(() ->
    val t = spawn(() -> (1 .. 100).sum)
    println(s"thread: ${t.join()}")
    println(s"future: ${Future(6 * 7).await()}"))
  println("main ends")
