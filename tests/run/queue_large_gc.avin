// expect: exit 0
// A long queue of heap elements, churned by interleaved enqueues and dequeues, survives collection;
// every operation walks lists in a loop, so a queue of twenty thousand elements is mapped,
// compared, hashed and displayed without deepening the stack.

class Box(val n: int)

main(args: Vector[string])
    var q = Queue.empty[Box]()
    for i in 0 ..< 20000 do q = q.enqueue(Box(i))
    println(q.length())
    var sum: long = 0
    for i in 0 ..< 12000
        val (b, rest) = q.dequeue()
        sum += long(b.n)
        q = rest.enqueue(Box(20000 + i))
    println(sum)
    println(q.length())
    println(q.front().n)
    val doubled = q.map(b -> b.n * 2)
    println(doubled.length())
    println(doubled.front())
    val same = q.map(b -> b.n * 2)
    println(doubled == same)
    println(doubled.hash() == same.hash())
    println(q.filter(b -> b.n % 1000 == 0).length())
    var strs = Queue.empty[string]()
    for i in 0 ..< 3000 do strs = strs.enqueue(s"item $i")
    var count = 0
    while strs.nonEmpty()
        val (s, rest) = strs.dequeue()
        if s != "" then count += 1
        strs = rest
    println(count)
