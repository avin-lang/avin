// expect: exit 0
// A range is a sequence of its values: its length, the value at an index and whether it holds a
// value are computed from its bounds, with `by` steps, negative steps and empty ranges, and it is a
// function from an index to its value. A range written in a `for` still counts in place.

total(xs: Seq[int]) -> int = xs.foldLeft(0, (a, x) -> a + x)

at(f: (int) -> int, i: int) -> int = f(i)

describe(name: string, r: Range)
  println(
    s"$name: length ${r.length} values ${r.toVector} empty ${r.isEmpty} first ${r.headOption} last ${r.lastOption} lift(1) ${r.lift(1)} lift(-1) ${r.lift(-1)}"
  )

main()
  describe("1 ..< 10 by 3", 1 ..< 10 by 3)
  describe("1 .. 10 by 3", 1 .. 10 by 3)
  describe("0 .. 9 by 3", 0 .. 9 by 3)
  describe("10 .. 1 by -4", 10 .. 1 by -4)
  describe("10 ..< 2 by -4", 10 ..< 2 by -4)
  describe("10 ..< 1 by -3", 10 ..< 1 by -3)
  describe("5 ..< 5", 5 ..< 5)
  describe("5 .. 5", 5 .. 5)
  describe("5 .. 4", 5 .. 4)
  describe("4 .. 5 by -1", 4 .. 5 by -1)
  describe("-3 .. 3 by 2", -3 .. 3 by 2)
  describe("from the smallest int", -2147483648 .. 2147483647 by 1073741824)
  describe("to the largest int", 2147483640 .. 2147483647 by 5)
  describe("down to the smallest int", -2147483640 .. -2147483648 by -5)

  // Whether a value is on the progression, by arithmetic.
  val r = 1 ..< 10 by 3
  println(
    s"${r.contains(1)} ${r.contains(4)} ${r.contains(7)} ${r.contains(10)} ${r.contains(5)} ${r.contains(-2)} ${r.contains(0)}"
  )
  val d = 10 .. 1 by -4
  println(s"${d.contains(10)} ${d.contains(6)} ${d.contains(2)} ${d.contains(-2)} ${d.contains(14)} ${d.contains(3)}")
  val wide = -2147483648 .. 2147483647 by 1073741824
  println(
    s"${wide.contains(1073741824)} ${wide.contains(2147483647)} ${wide.contains(-2147483648)} ${(5 ..< 5).contains(5)} ${(5 .. 5).contains(5)}"
  )

  // The value at an index, and the range as a function.
  println(s"${r(0)} ${r(2)} ${d(1)} ${at(r, 1)} ${at(0 ..< 100 by 5, 19)} ${(0 ..< 3).map(r)}")

  // Every sequence method, through `Seq[int]` and on the range itself; each makes a vector.
  println(s"${total(1 .. 100)} ${total(1 .. 100 by 2)} ${total(100 .. 1 by -1)} ${(1 .. 5).sum} ${(1 .. 5).product}")
  println(
    s"${(1 .. 6).take(2)} ${(1 .. 6).drop(4)} ${(1 .. 6).reverse} ${(1 .. 6).slice(2, 4)} ${(1 .. 6).sliding(4, 3).toVector} ${(1 .. 6).indexOf(5)} ${(1 .. 6).lastIndexWhere(x -> x < 3)}"
  )
  println(
    s"${(0 .. 20 by 5).map(x -> x / 5)} ${(1 .. 3).flatMap(x -> [x, x])} ${(1 .. 9).collect(match x if x % 4 == 0 -> x)} ${(1 .. 4).indices.toVector} ${(1 .. 4) ++ (7 .. 8)}"
  )
  val v: Vector[int] = for x in 1 .. 10 if x % 3 == 0 if x > 3 yield x * x
  val w: Vector[int] = for x in 1 .. 2, y in 10 .. 11 yield x * y
  println(s"$v $w ${(1 .. 4).sameElements([1, 2, 3, 4])} ${(1 .. 4).startsWith(1 .. 2)} ${(1 .. 4).endsWith([4])}")
  var seen = ""
  (3 .. 1 by -1).foreach(x -> seen = seen + s"$x")
  println(seen)

  // A `for` over a range, written in place or held in a value, steps through it.
  var sum = 0
  for i in 1 ..< 10 by 3 do sum += i
  for i in r do sum += i
  for i in d do sum += i
  println(s"$sum")
