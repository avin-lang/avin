// expect: exit 0
// `avin.fs` at its edges: `remove` refuses a directory as `IsADirectory` on every platform and
// removes a link rather than what it names; `createDirAll` over a file is `AlreadyExists`; bytes are
// copied each way; the questions follow symbolic links, a dangling one answering no to each; and
// `removeDirAll` removes the links in its tree without following them. The links are made through
// Sysl's `sysl.fs.symlink`, which `avin.fs` does not offer.
import avin.fs

@sysl("sysl.fs.IoError")
private data SyslIoError
    NotFound
    PermissionDenied
    AlreadyExists
    NotADirectory
    IsADirectory
    DirectoryNotEmpty
    TooManyOpenFiles
    NoSpaceLeft
    Interrupted
    NotOpen
    NotPermitted
    // Sysl counts the offset in a `usize`; it comes out of Sysl as a `long`.
    InvalidUtf8(offset: long)
    Other(code: int)

@sysl("sysl.fs.symlink")
private symlinkRaw(target: string, link: string) -> Result[unit, SyslIoError]

symlink(target: string, link: string) -> bool = symlinkRaw(target, link).isOk

main()
    val dir = fs.createTempDir("avin-fs-edges").getOrElse("")
    val outside = fs.createTempDir("avin-fs-outside").getOrElse("")
    // `remove` removes a file and never a directory.
    println(s"${fs.createDir(dir + "/d")} ${fs.remove(dir + "/d")} ${fs.isDir(dir + "/d")}")
    // A file where the directory itself would go is `AlreadyExists`.
    println(s"${fs.writeText(dir + "/f", "x")} ${fs.createDirAll(dir + "/f")} ${fs.createDir(dir + "/f")}")
    // Bytes are copied each way.
    val bytes = Array.fill(3, byte(7))
    println(fs.writeBytes(dir + "/b", bytes))
    bytes(0) = byte(1)
    val read = fs.readBytes(dir + "/b").getOrElse(Array.fill(0, byte(0)))
    read(1) = byte(2)
    println(s"$bytes $read ${fs.readBytes(dir + "/b")}")
    // A link to a directory is a file to `remove`, which removes the link and not what it names.
    println(symlink(outside, dir + "/link"))
    println(s"${fs.remove(dir + "/link")} ${fs.exists(dir + "/link")} ${fs.isDir(outside)}")
    // The questions follow symbolic links.
    println(fs.writeText(outside + "/keep.txt", "kept"))
    println(symlink(outside, dir + "/toOutside"))
    println(symlink(outside + "/keep.txt", dir + "/toFile"))
    println(symlink(dir + "/nothing", dir + "/dangling"))
    println(s"${fs.isDir(dir + "/toOutside")} ${fs.isFile(dir + "/toOutside")} ${fs.exists(dir + "/toOutside")}")
    println(s"${fs.isFile(dir + "/toFile")} ${fs.readText(dir + "/toFile")} ${fs.readText(dir + "/toOutside/keep.txt")}")
    println(s"${fs.exists(dir + "/dangling")} ${fs.isFile(dir + "/dangling")} ${fs.isDir(dir + "/dangling")}")
    println(fs.listDir(dir))
    // `removeDirAll` removes a link inside the tree and never follows it.
    println(s"${fs.removeDirAll(dir)} ${fs.exists(dir)}")
    println(s"${fs.exists(outside + "/keep.txt")} ${fs.readText(outside + "/keep.txt")}")
    println(fs.removeDirAll(outside))
