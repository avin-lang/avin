// `process.signal` sends a signal to a process by id, or to a group by a negative id: signal zero
// sends nothing and answers whether one could be sent, a process that has ended and been waited for
// is no such process, and a number the platform does not have is refused before anything is sent.
import avin.fs
import avin.io.{ErrorKind, IoError}
import avin.process
import avin.process.{Child, Command}
import avin.signal
import avin.threads
import avin.time.millis

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

// An error's kind, without the process id its message names.
kind(e: IoError) -> ErrorKind = e.kind

main()
  // Itself, with signal zero.
  println(process.signal(process.pid(), 0).mapErr(kind))
  // A child, stopped by the signal its status then names.
  val sleeper = ok(Command("/bin/sleep", "30").start())
  println(process.signal(sleeper.pid(), 0).mapErr(kind))
  println(process.signal(sleeper.pid(), signal.Kill).mapErr(kind))
  println(sleeper.waitFor())
  // Once waited for, its id names no process.
  println(process.signal(sleeper.pid(), 0).mapErr(kind))
  println(process.signal(sleeper.pid(), signal.Terminate).mapErr(kind))
  // A program that exits by itself, waited for.
  val quick = ok(Command("/usr/bin/true").start())
  println(quick.waitFor())
  println(process.signal(quick.pid(), 0).mapErr(kind))
  // A group, by its negative id: the group a command started in leads, and its members with it.
  val grouped = ok(Command("/bin/sh", "-c", "/bin/sleep 30 & /bin/sleep 31 & wait").inNewGroup.start())
  val g = grouped.group().get
  println(process.signal(-g, 0).mapErr(kind))
  println(process.signal(-g, signal.Terminate).mapErr(kind))
  println(grouped.waitFor())
  // Each signal a program may be sent, and the ones a platform does not have.
  println(process.signal(process.pid(), -1).mapErr(kind))
  println(process.signal(process.pid(), 65).mapErr(kind))
  println(process.signal(process.pid(), 2147483647).mapErr(kind))
  // A user signal a child shell traps, by the platform's own number, sent once the shell says it is
  // ready.
  val dir = ok(fs.createTempDir("avin-process-signal"))
  val ready = dir + "/ready"
  val trapping = ok(Command("/bin/sh", "-c", "trap 'exit 7' USR1; : > \"$0\"; while :; do /bin/sleep 0.02; done", ready).start())
  while !fs.exists(ready) do threads.sleep(millis(5))
  println(process.signal(trapping.pid(), signal.User1).mapErr(kind))
  println(trapping.waitFor())
  _ = fs.removeDirAll(dir)
  // Zero is this program's own group, which signal zero only asks about.
  println(process.signal(0, 0).mapErr(kind))
