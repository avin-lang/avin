// expect: exit 0
// Each turn of an actor is a lightweight thread of its own, so a turn that waits parks and holds no
// worker: a hundred actors, far more than there are workers, each wait in a turn at once (on a
// channel, a promise's future, a sleep polling a count, a lock, and a condition) until every one of
// them has arrived, which only happens if the waiting turns leave the workers to the others. Then
// many actors sleep in their turns at once and all wake; and an actor whose turn sleeps lets another
// actor run meanwhile, which finishes first.
import avin.actors.{ActorRef, Behaviour, spawn}
import avin.threads.{Atomic, Channel, Condition, Mutex, Promise, sleep}
import avin.time

// What a turn waits on until every actor has arrived.
data Gate
    OnChannel(c: Channel[int])
    OnFuture(p: Promise[unit])
    OnCount(arrived: Atomic[int], all: int)
    OnMutex(m: Mutex[Array[int]], c: Condition, all: int)

// An actor whose one message makes its turn arrive, then wait at the gate, then report.
waiter(arrived: Atomic[int], done: Channel[int]) -> Behaviour[Gate] = Behaviour("Waiter", me -> g ->
    arrived.add(1)
    g match
        OnChannel(c) -> done.send(c.receive().get())
        OnFuture(p) ->
            p.future.await()
            done.send(1)
        OnCount(a, all) ->
            while a.load() < all do sleep(time.millis(1))
            done.send(1)
        OnMutex(m, c, all) ->
            m.with(count ->
                count(0) += 1
                if count(0) == all then c.notifyAll()
                while count(0) < all do c.wait())
            done.send(1))

// Starts `n` actors whose turns all wait at the gate `make` gives, releases them as `release` does
// once all have arrived, and answers how many reported.
round(n: int, make: (Atomic[int]) -> Gate, release: (Gate) -> unit) -> int
    val arrived = Atomic[int](0)
    val done = Channel[int]()
    val gate = make(arrived)
    for _ in 0..<n do spawn(waiter(arrived, done)).tell(gate)
    while arrived.load() < n do sleep(time.millis(1))
    release(gate)
    var reported = 0
    for _ in 0..<n do reported += done.receive().get()
    reported

main()
    val n = 100
    println(round(n, _ -> OnChannel(Channel[int]()), g -> if g is OnChannel(c) then for _ in 0..<n do c.send(1)))
    println(round(n, _ -> OnFuture(Promise[unit]()), g -> if g is OnFuture(p) then p.complete(())))
    println(round(n, a -> OnCount(a, n), _ -> ()))
    // The mutex's value counts the arrivals made under it; the last one wakes them all.
    val m = Mutex(Array.fill(1, 0))
    println(round(n, _ -> OnMutex(m, m.condition(), n), _ -> ()))
    // Many sleeping turns at once, all waking.
    val woke = Channel[int]()
    for i in 0..<300 do spawn(Behaviour[long]("Sleeper", me -> ms ->
        sleep(time.millis(ms))
        woke.send(1))).tell(20)
    var total = 0
    for _ in 0..<300 do total += woke.receive().get()
    println(total)
    // A turn that sleeps lets another actor run meanwhile.
    val order = Channel[string]()
    val slow = spawn(Behaviour[unit]("Slow", me -> _ ->
        sleep(time.millis(200))
        order.send("slow")))
    val quick = spawn(Behaviour[unit]("Quick", me -> _ -> order.send("quick")))
    slow.tell(())
    sleep(time.millis(20))
    quick.tell(())
    println(order.receive())
    println(order.receive())
