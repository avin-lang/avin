// expect: exit 30
// Arms that never finish agree with any other arm, and a match can be an operand.

fizz(n: int) -> int
  val r = n % 15 match
    0 -> return 15
    r if r % 5 == 0 -> 5
    r if r % 3 == 0 -> 3
    _ -> 0
  r

main() -> int
  var total = 0
  var i = 1
  while i <= 10 do
    total += fizz(i)
    i += 1
  // 3 + 5 + 3 + 3 + 5 = 19 for 1..10, plus 15 for 15 itself, minus 4.
  total + fizz(15) - 4
