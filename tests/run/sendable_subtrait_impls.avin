// expect: exit 0
// An impl of a trait that promises `Sendable` does not take over the `Sendable` a type has from
// elsewhere. `Vector[T]` is `Sendable` by the standard library's impl at every sendable `T`, so a
// bounded impl of `Tag` for it leaves `Vector[long]` (and the library's classes holding one)
// sendable; so does a concrete-instance impl. A type with its own `Sendable` impl, or one its
// declaration makes `Sendable`, keeps it at arguments outside the sub-trait impl's bound; a type whose
// only promise is the sub-trait impl is `Sendable` where that impl's bound is met, and by its
// structure elsewhere. The same holds of
// `Eq` and `Hash`, which a trait may promise in the same way.
import avin.threads.spawn

trait Tag: Sendable
  tag -> string

data Label(name: string)

impl Tag for Label
  tag -> string = name

impl[T: Tag] Tag for Vector[T]
  tag -> string = "v" + self.map((x) -> x.tag).mkString(",")

impl Tag for Vector[byte]
  tag -> string = s"bytes(${self.length})"

impl Tag for Option[int]
  tag -> string = "oi"

impl[T: Tag] Tag for Option[Vector[T]]
  tag -> string = "ov"

data Pair[A](first: A, second: A)

impl[A: Sendable] Sendable for Pair[A]

impl[A: Tag] Tag for Pair[A]
  tag -> string = first.tag + "&" + second.tag

class Cell[A: Sendable](val value: A): Sendable

impl[A: Tag] Tag for Cell[A]
  tag -> string = "cell " + value.tag

class Holder[A](val value: A)

impl[A: Tag] Tag for Holder[A]
  tag -> string = "holder " + value.tag

trait Key: Eq, Hash
  key -> string

impl Key for Label
  key -> string = name

impl[T: Key] Key for Vector[T]
  key -> string = "k" + self.map((x) -> x.key).mkString(",")

hashed[T: Hash](value: T) -> long = value.hash()

send[T: Sendable](value: T) -> string = "sent"

across[T: Sendable](value: T) -> T = spawn(() -> value).join()

tagged[T: Tag](value: T) -> string = value.tag

main()
  val longs: Vector[long] = [1, 2, 3]
  println(send(longs))
  println(across(longs).length)
  val nested: Vector[Vector[int]] = [[1], [2, 3]]
  println(send(nested))
  println(tagged([Label("a"), Label("b")]))
  println(tagged([[Label("n")]]))
  val bytes: Vector[byte] = [byte(1), byte(2)]
  println(tagged(bytes))
  println(send(bytes))
  println(across(bytes).length)
  println(tagged(Some(4)))
  println(send(Some("s")))
  println(tagged(Some([Label("o")])))
  println(send(Holder(1)))
  println(send(Pair(1, 2)))
  println(tagged(Pair(Label("x"), Label("y"))))
  println(send(Cell(5)))
  println(tagged(Cell(Label("c"))))
  println(send(Holder(Label("h"))))
  println(tagged(Holder(Label("h"))))
  println(across(Holder(Label("t"))).value.name)
  println([1, 2] == [1, 2])
  val lists: Vector[Vector[int]] = [[1], [1], [2]]
  println(lists.distinct.length)
  println(hashed([Label("k")]) == hashed([Label("k")]))
  println([Label("k")].key)
