// expect: exit 0
// Repeated parameters. `values: T*` takes zero or more `T`s, which the function sees as a
// `Vector[T]`, or one sequence spliced with `xs*`: any `Iterable[T]`, copied into a vector, or a
// `Vector[T]` passed as it is. The parameters before it may have defaults, and its arguments are
// evaluated in the order written.

total(values: int*) -> int
    var sum = 0
    for v in values do sum += v
    sum

joined(separator: string, parts: string*) -> string
    var out = ""
    for i in 0..<parts.length()
        if i > 0 then out = out + separator
        out = out + parts(i)
    out

scaled(factor: int = 10, values: int*) -> Vector[int] = for v in values yield v * factor

largest[T: Ord](first: T, rest: T*) -> T
    var best = first
    for x in rest
        if x > best then best = x
    best

counted[T](items: T*) -> int = items.length()

shown(tag: string, value: int) -> int
    print(s"$tag")
    value

class Path(val parts: string*)
    text() -> string = joined("/", parts*)

class Bag
    var items: Vector[int] = []
    put(xs: int*) -> Bag
        items = items ++ xs
        self

trait Summer
    sum(xs: int*) -> int

class Plain: Summer
    override sum(xs: int*) -> int = total(xs*)

data Word(text: string)

impl Word
    surround(marks: string*) -> string
        var out = text
        for m in marks do out = m + out + m
        out

main()
    // zero, one and many arguments
    print(total())
    print(total(5))
    print(total(1, 2, 3, 4))
    print(joined(", "))
    print(joined(", ", "a"))
    print(joined(", ", "a", "b", "c"))

    // splicing a Vector, a List, a Range and an Array
    val v = [1, 2, 3]
    print(total(v*))
    val l: List[int] = [4, 5]
    val a: Array[int] = [7, 8]
    print(total(l*))
    print(total((1..10)*))
    print(total(a*))
    print(joined("-", ["x", "y"]*))
    val set: Set[int] = [100]
    print(total(set*))
    print(total(([1, 2] ++ v)*))

    // the parameter is a vector inside the function
    print(scaled(2, 1, 2, 3))
    print(scaled())

    // generic inference from the arguments
    print(largest(3, 9, 4))
    print(largest("pear", "apple"))
    print(largest(1))
    print(counted("a", "b", "c"))
    print(counted[int]())
    print(largest(0, v*))

    // arguments run in the order written
    print(total(shown("a", 1), shown("b", 2), shown("c", 3)))

    // constructors, methods, trait methods and methods an impl adds
    print(Path("usr", "local", "bin").text())
    print(Path().parts.length())
    print(Bag().put(1, 2).put().put(3).items)
    val s: Summer = Plain()
    print(s.sum(1, 2, 3))
    print(Word("x").surround("<", "*"))

    // a repeated method of one parameter called infix takes one argument
    print(Word("y") surround "!")

    // a function used as a value takes the vector
    val f: (Vector[int]) -> int = total
    print(f([10, 20]))
