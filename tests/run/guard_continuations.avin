// expect: exit 0
// Guards written as an indented block, and continuation lines that really continue an expression,
// are still accepted.
block(n: int) -> int
block(n)
    | n < 0 = 1
    | n < 10 = 2
    | _ = 3

single(n: int) -> int
single(n) | n < 0 = 1
single(_) = 2

condition(a: int, b: int) -> int
condition(a, b) | a < 0 || b < 0 = 1
    + 10
condition(_, _) = 2

bits(n: int) -> int
bits(n) | n > 0 = n
    | 8
bits(_) = 0

class Holder
    pick(n: int) -> int
    pick(n)
        | n < 0 = 1
        | _ = 2

main()
    println(s"${block(-1)} ${block(5)} ${block(50)}")
    println(s"${single(-1)} ${single(1)}")
    println(s"${condition(-1, 1)} ${condition(1, -1)} ${condition(1, 1)}")
    println(s"${bits(1)} ${bits(0)}")
    println(s"${Holder().pick(-3)} ${Holder().pick(3)}")
