// A method named without a call is a function value bound to its receiver: a closure holding the
// receiver, of the method's type without it. The receiver is evaluated once, where the value is made;
// through a superclass or a trait the value calls the implementation the object's class has. Run
// under a collection at every allocation, a method value kept in a data structure keeps its receiver.

data List[+T]
    Nil
    Cons(head: T, tail: List[T])

each[T](xs: List[T], f: (T) -> unit) -> unit = xs match
    Nil -> ()
    Cons(h, t) ->
        f(h)
        each(t, f)

map[A, B](xs: List[A], f: (A) -> B) -> List[B] = xs match
    Nil -> Nil
    Cons(h, t) -> Cons(f(h), map(t, f))

class Account(var balance: int)
    deposit(n: int) = balance += n
    // A bare method name in the class is the same closure over `self`.
    depositor() -> (int) -> unit = deposit
    private secret() -> int = balance * 2
    doubled() -> () -> int = secret

open class Animal(name: string)
    sound() -> string = "..."
    speak(times: int) -> string = s"$name says ${sound()} x$times"

class Dog(name: string) : Animal(name)
    override sound() -> string = "woof"

trait Shape
    area() -> int

class Square(side: int) : Shape
    override area() -> int = side * side

class Circle(r: int) : Shape
    override area() -> int = 3 * r * r

data Point(x: int, y: int)

impl Point
    shifted(dx: int) -> Point = Point(x + dx, y)
    show() -> string = s"($x, $y)"

object Counter
    var count = 0
    bump(by: int) -> int
        count += by
        count

class Box[T](item: T)
    get() -> T = item
    pair[U](other: U) -> (T, U) = (item, other)

var made = 0

account(start: int) -> Account
    made += 1
    Account(start)

twice(f: (int) -> unit, n: int)
    f(n)
    f(n)

main() -> int
    // A method value mutates the object it is bound to.
    val acct = Account(10)
    val f = acct.deposit
    f(5)
    print(s"${acct.balance}")
    // Passed to a higher-order function.
    twice(acct.deposit, 1)
    print(s"${acct.balance}")
    val g = acct.depositor()
    g(100)
    print(s"${acct.balance} ${acct.doubled()()}")
    // The receiver is evaluated once, where the value is made.
    val h = account(0).deposit
    h(1)
    h(2)
    print(s"made $made")
    // Through a superclass-typed receiver the value calls the override.
    val a: Animal = Dog("rex")
    val speak = a.speak
    val sound = a.sound
    print(speak(2) + " " + sound())
    // Through a trait-typed receiver.
    val shapes: List[Shape] = Cons(Square(3), Cons(Circle(2), Nil))
    val areas = map(shapes, s -> s.area)
    each(areas, k -> print(s"${k()}"))
    // A data impl method and an object method.
    val p = Point(1, 2)
    val shift = p.shifted
    print(shift(10).show())
    val bump = Counter.bump
    bump(3)
    print(s"${bump(4)}")
    // A generic class: the class's type arguments come from the receiver, a method's own from the
    // expected type or written.
    val box = Box("gift")
    val get = box.get
    val pairer: (int) -> (string, int) = box.pair
    val written = box.pair[bool]
    print(get() + s" ${pairer(7).1} ${written(true).1}")
    // Method values kept in a list survive collections, each holding its receiver.
    var deposits: List[(int) -> unit] = Nil
    var accounts: List[Account] = Nil
    var i = 0
    while i < 3
        val fresh = Account(i * 100)
        accounts = Cons(fresh, accounts)
        deposits = Cons(fresh.deposit, deposits)
        i += 1
    each(deposits, d -> d(7))
    each(accounts, x -> print(s"${x.balance}"))
    // Two values of one method on one object are two closures.
    print(s"${acct.deposit === acct.deposit}")
    0
