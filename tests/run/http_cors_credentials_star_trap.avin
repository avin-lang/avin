// expect: trap
// A CORS policy of origin `*` refuses credentials where it is made: a named origin with credentials is
// taken, and `*` with them traps.
import avin.net.http.Cors

main()
  println(Cors(origins = ["https://a.example"], credentials = true).credentials)
  println(Cors(origins = ["https://a.example", "*"], credentials = true).credentials)
