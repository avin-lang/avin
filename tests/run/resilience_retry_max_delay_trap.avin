// expect: trap
// A retry policy's maximum delay is at least its initial delay: an equal one is taken, and one a
// microsecond shorter traps.
import avin.resilience.RetryPolicy
import avin.time.{micros, seconds}

main()
  println(RetryPolicy(initialDelay = seconds(1), maxDelay = seconds(1)).maxDelay)
  println(RetryPolicy(initialDelay = seconds(1), maxDelay = seconds(1) - micros(1)).maxDelay)
