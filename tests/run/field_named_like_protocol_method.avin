// expect: exit 0
// A field may take the name of any method a trait gives its type with a parameter list: `display`,
// `debug`, `toString`, `equals`, `hash`, `compare`, `less`, `lessOrEqual`, `greater`,
// `greaterOrEqual`, `iterator`, `hasNext`, `next`. `x.name` reads the field and `x.name(args)` calls
// the method, so the derived `Display`, `Debug`, `Eq`, `Hash` and `Ord`, the library's printing,
// interpolation, formatting, comparison and hashing all keep working, for a data type with one
// variant, a generic one, one with several variants, and a class.

data Config(host: string, port: int, debug: bool)

data Every(
    display: int,
    debug: string,
    toString: int,
    equals: int,
    hash: long,
    compare: int,
    less: int,
    lessOrEqual: int,
    greater: int,
    greaterOrEqual: int,
    iterator: int,
    hasNext: int,
    next: char
) derives Ord, Hash

data Pair[A](display: A, debug: A) derives Ord, Hash

data Shape derives Ord
  Circle(display: int)
  Square(debug: string, compare: int)
  Dot

class Settings(val host: string, val debug: bool, val display: int) derives Display, Debug, Eq, Hash

// A generic function reaches the methods through the bound, whatever fields the type has.
shown[T: Display](x: T) -> string = s"<$x>"

largest[T: Ord](a: T, b: T) -> T = if a > b then a else b

main()
  val config = Config("localhost", 8080, true)
  println(config)
  println(debug(config))
  println(config.debug)
  println(s"${config.host}:${config.port} debug=${config.debug}")

  val e = Every(1, "d", 0, 2, 3, 4, 5, 6, 7, 8, 9, 10, 'x')
  val f = Every(1, "d", 0, 2, 3, 4, 5, 6, 7, 8, 9, 10, 'y')
  println(e)
  println(debug(e))
  println(s"$e")
  println(f"[${e}%50s]")
  println(e.toString())
  println(e.toString)
  println(shown(e))
  println(e == e)
  println(e == f)
  println(e < f)
  println(e.compare(f))
  println(e.less(f))
  println(largest(e, f).next)
  println(e.hash() == Every(1, "d", 0, 2, 3, 4, 5, 6, 7, 8, 9, 10, 'x').hash())
  println(
    e.display
      + e.equals
      + e.compare
      + e.less
      + e.lessOrEqual
      + e.greater
      + e.greaterOrEqual
      + e.iterator
      + e.hasNext
      + e.toString
  )
  println(e.debug)
  println(e.hash)
  println({e, e, f}.size)

  val p = Pair(1, 2)
  println(p)
  println(debug(Pair("a", "b")))
  println(p.display + p.debug)
  println(p < Pair(1, 3))
  println(shown(Pair('a', 'b')))

  val shapes: Vector[Shape] = [Square("q", 2), Circle(1), Dot, Circle(0)]
  println(shapes)
  println(debug(shapes))
  println(shapes.sorted)
  for s in shapes
    s match
      Circle(display) -> println(s"circle $display")
      Square(debug, compare) -> println(s"square $debug $compare")
      Dot -> println("dot")

  val k = Settings("h", true, 3)
  println(k)
  println(debug(k))
  println(k.debug)
  println(k.display)
  println(k == Settings("h", true, 3))
  println(k.hash() == Settings("h", true, 3).hash())
  println(shown(k))
