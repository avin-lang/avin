// expect: trap
// A trusted block is an IP address and an optional prefix: a good one is taken, and an address that is
// not one traps where the block is made.
import avin.net.http.TrustedProxies

main()
  println(TrustedProxies(["10.0.0.0/8"]).trusted.length)
  println(TrustedProxies(["10.0.0/8"]).trusted.length)
