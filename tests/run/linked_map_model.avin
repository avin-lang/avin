// expect: exit 0
// env: AVIN_GC_STRESS=0
// A linked map driven by tens of thousands of pseudo-random puts, updates, removals, re-puts to the end,
// and removals from either end, agrees at every step with a model: an immutable map for the values and a
// vector of keys for the order. This crosses growth of the index, the squeezing of gaps, and the
// trimming of gaps at the end of the buffer, and it ends with sequential inserts past several thousand
// entries and their removal in order.

import avin.collections.mutable.{LinkedMap, LinkedSet}

// The model's order with `key` taken out.
without(order: Vector[int], key: int) -> Vector[int] = order.filter(k -> k != key)

main()
    val table = LinkedMap[int, int]()
    var values = Map[int, int]()
    var order: Vector[int] = []
    var seed: long = 987654321
    var agreed = true
    var steps = 0
    for step in 0..<20000
        seed = (seed *% 6364136223846793005 +% 1442695040888963407)
        val key = int((seed >> 40) & 255)
        val op = int((seed >> 20) & 15)
        if op < 6
            // put: a present key keeps its place
            table(key) = step
            if !values.contains(key) then order = order ++ [key]
            values = values.updated(key, step)
        else if op < 9
            val had = table.remove(key)
            if had != values.get(key) then agreed = false
            values = values.removed(key)
            order = without(order, key)
        else if op == 9
            table.putLast(key, step)
            order = without(order, key) ++ [key]
            values = values.updated(key, step)
        else if op == 10
            val moved = table.moveToEnd(key)
            if moved != values.contains(key) then agreed = false
            if moved then order = without(order, key) ++ [key]
        else if op == 11
            if order.nonEmpty
                val (k, v) = table.removeFirst()
                if k != order(0) || v != values(k) then agreed = false
                order = order.drop(1)
                values = values.removed(k)
        else if op == 12
            if order.nonEmpty
                val (k, v) = table.removeLast()
                if k != order(order.length - 1) || v != values(k) then agreed = false
                order = order.dropRight(1)
                values = values.removed(k)
        else
            if table.get(key) != values.get(key) then agreed = false
        if table.size != values.size then agreed = false
        if step % 50 == 0
            if table.keys != order then agreed = false
            if table.headOption.map(e -> e.0) != order.headOption then agreed = false
            if table.lastOption.map(e -> e.0) != order.lastOption then agreed = false
            for k in 0..<256
                if table.get(k) != values.get(k) then agreed = false
        steps += 1
    println(s"$agreed $steps ${table.size} ${table.toMap == values}")

    // Sequential growth well past the index's resizes, then removal in order from the front.
    val big = LinkedMap[int, int]()
    for i in 0..<30000 do big(i) = i * 2
    var inOrder = true
    var expect = 0
    for (k, v) in big
        if k != expect || v != k * 2 then inOrder = false
        expect += 1
    println(s"${big.size} $inOrder $expect ${big(29999)} ${big.head} ${big.last}")
    var firstsOk = true
    for i in 0..<29990
        val (k, v) = big.removeFirst()
        if k != i || v != i * 2 then firstsOk = false
    println(s"$firstsOk ${big.size} ${big.keys}")

    // A sliding window: put at the end and take from the front, two hundred thousand times over a small set of
    // slots, so gaps are squeezed out over and over without the map growing.
    val window = LinkedMap[int, int]()
    for i in 0..<64 do window(i) = i
    for i in 64..<200000
        window(i) = i
        window.removeFirst()
    println(s"${window.size} ${window.head} ${window.last}")

    // Sets of the same shape.
    val set = LinkedSet[int]()
    for i in 0..<5000 do set.add((i * 7919) % 5003)
    val expected = Buffer[int]()
    for i in 0..<5000 do expected.addOne((i * 7919) % 5003)
    var matches = true
    var j = 0
    for x in set
        if x != expected(j) then matches = false
        j += 1
    println(s"${set.size} $matches $j")
