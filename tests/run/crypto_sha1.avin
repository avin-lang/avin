import avin.crypto.{sha1, toHex, Sha1}

// SHA-1 against the test vectors of RFC 3174 and FIPS 180: the empty message, `abc`, the 448-bit
// message spanning two blocks, a million `a`s fed to a hasher in pieces, the same message given as
// bytes and as text, and the WebSocket handshake's key and GUID of RFC 6455 § 1.3.
main()
  println(toHex(sha1("")))
  println(toHex(sha1("abc")))
  println(toHex(sha1("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")))
  println(toHex(sha1("abc".bytes)) == toHex(sha1("abc")))
  val h = Sha1()
  val piece = "a".repeat(1000)
  for _ in 0 ..< 1000
    h.update(piece)
  println(toHex(h.finish()))
  val g = Sha1()
  g.update("ab")
  g.update("")
  g.update("c")
  println(toHex(g.finish()))
  println(toHex(sha1("dGhlIHNhbXBsZSBub25jZQ==258EAFA5-E914-47DA-95CA-C5AB0DC85B11")))
