// expect: trap
// A `Metrics`' latency bucket is above zero: a bound of zero traps where the `Metrics` is made, after
// the least bound above zero, a microsecond, was taken.
import avin.net.http.Metrics
import avin.time.micros

main()
  println(Metrics([micros(1)]).buckets)
  println(Metrics([micros(0), micros(1)]).buckets)
