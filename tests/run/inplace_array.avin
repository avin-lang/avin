// expect: exit 0
// An array changes in place: `reverseInPlace`, `mapInPlace`, `fillInPlace` and `copyTo`, which
// copies a range into another array or, overlapping, into the same one in either direction.

class Box(val n: int)

seq(n: int) -> Array[int] = Array.tabulate(n, i -> i)

main()
    // reverseInPlace
    for n in 0 ..< 7
        val a = seq(n)
        a.reverseInPlace()
        println(a)
    val big = seq(1001)
    big.reverseInPlace()
    println(s"${big(0)} ${big(500)} ${big(1000)}")

    // mapInPlace
    val m = seq(4)
    m.mapInPlace(x -> x * x + 1)
    println(m)
    val e = Array.empty[int]()
    e.mapInPlace(x -> x + 1)
    println(e.length)
    val s = Array.fill(2, "ab")
    s.mapInPlace(w -> w + "!")
    println(debug(s))
    val bytes = Array.fill(3, byte(250))
    bytes.mapInPlace(b -> b ^ byte(255))
    println(bytes)
    val rs = Array.fill(3, 1.5)
    rs.mapInPlace(r -> r * 2.0)
    println(rs)
    val boxes = Array.tabulate(3, i -> Box(i))
    boxes.mapInPlace(b -> Box(b.n + 10))
    println(boxes.map(b -> b.n))

    // fillInPlace
    val f = seq(5)
    f.fillInPlace(9)
    println(f)
    val fe = Array.empty[string]()
    fe.fillInPlace("x")
    println(fe.length)
    val shared = Array.fill(3, Box(0))
    val one = Box(7)
    shared.fillInPlace(one)
    println(shared(0) === one && shared(2) === one)
    val fs = Array.fill(2, "a")
    fs.fillInPlace("long string here")
    println(debug(fs))

    // copyTo into another array
    val src = seq(6)
    val dst = Array.fill(8, -1)
    src.copyTo(dst, 1)
    println(dst)
    src.copyTo(dst, 0, 2, 3)
    println(dst)
    src.copyTo(dst, 7, 5, 1)
    println(dst)
    src.copyTo(dst, 8, 6, 0)
    src.copyTo(dst, 0, 0, 0)
    println(dst)
    src.copyTo(dst, 2, 4)
    println(dst)
    src.copyTo(dst, 2, count = 2)
    println(dst)
    seq(0).copyTo(Array.empty[int](), 0)
    val words = Array.fill(3, "-")
    Array.tabulate(2, i -> s"w$i").copyTo(words, 1)
    println(debug(words))

    // copyTo overlapping in one array, in both directions
    val right = seq(8)
    right.copyTo(right, 2, 0, 5)
    println(right)
    val left = seq(8)
    left.copyTo(left, 0, 3, 5)
    println(left)
    val same = seq(5)
    same.copyTo(same, 0)
    println(same)
    same.copyTo(same, 2, 2, 3)
    println(same)
    val shift1 = seq(6)
    shift1.copyTo(shift1, 1, 0, 5)
    println(shift1)
    val shiftBack = seq(6)
    shiftBack.copyTo(shiftBack, 0, 1, 5)
    println(shiftBack)
    val refs = Array.tabulate(5, i -> Box(i))
    refs.copyTo(refs, 1, 0, 4)
    println(refs.map(b -> b.n))
    println(refs(0) === refs(1))

    // stress: many arrays, so collections run in the middle of the copies
    var total = 0
    for round in 0 ..< 300
        val xs = Array.tabulate(50, i -> Box(i + round))
        xs.copyTo(xs, 3, 0, 40)
        xs.reverseInPlace()
        xs.mapInPlace(b -> Box(b.n + 1))
        total += xs(0).n + xs(49).n
    println(total)
