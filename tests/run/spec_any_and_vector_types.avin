// expect: exit 0
// Values converted to Any and to a trait at each site, and recovered by type patterns; a tuple's run-time
// type is the one it was made with, whatever class its parts are; the overload on a value's own type
// beats the one on a trait; vector types written []T in every position; and partial functions made
// from a match: isDefinedAt, applyOrElse, lift, orElse, and passing one where a function is expected.

open class Animal(val name: string)

class Dog(name: string): Animal(name)

describe(x: Any) -> string = x match
    s: string -> s"text $s"
    n: int -> s"number $n"
    p: (Animal, int) -> s"animal pair ${p.0.name} ${p.1}"
    _: (Dog, int) -> "dog pair"
    v: []int -> s"ints ${v.length()}"
    u: unit -> "unit"
    _ -> "something else"

shown(d: Display) -> string = s"display ${d}"

shown(n: int) -> string = s"int $n"

exact(x: Any) -> string = x match
    _: (Dog, int) -> "dog pair"
    _: (Animal, int) -> "animal pair"
    _ -> "other"

pick(flag: bool) -> Any = if flag then 1 else "one"

total(xs: []int) -> int = xs.sum()

val sumAll: []int -> int = total

main()
    val animal: Animal = Dog("rex")
    println(describe((animal, 1)))
    println(describe((Dog("fido"), 2)))
    println(describe([1, 2, 3]))
    println(describe(()))
    println(describe(pick(true)))
    println(describe(pick(false)))
    println(describe(2.5))
    val shownAll: Vector[Display] = [1, "two", (3, 4)]
    println(shownAll.map(d -> shown(d)))
    println(s"${shown(42)} ${shown("s")}")
    val d: Display = 7
    println(d match
        n: int -> n + 1
        _ -> 0)
    var slot: Any = 1
    slot = "now text"
    println(describe(slot))
    val parts: (Any, int) = (5, 6)
    println(describe(parts.0))
    val vv: [][]int = [[1], [2, 3]]
    println(vv)
    val fns: [](int -> int) = [x -> x + 1]
    println(fns(0)(1))
    val opt: Option[[]string] = Some(["a"])
    println(opt)
    println(sumAll([1, 2, 3]))
    val half: PartialFunction[int, int] = match n if n % 2 == 0 -> n / 2
    println(s"${half.isDefinedAt(3)} ${half.applyOrElse(3, n -> n)} ${[2, 4].map(half)} ${half.lift()(3)} ${half.lift()(8)}")
    val neg: PartialFunction[int, int] = match n if n < 0 -> -n
    val both = half.orElse(neg)
    println(s"${both(-5)} ${both(6)} ${both.isDefinedAt(3)}")
    println(s"${exact((animal, 1))} ${exact((Dog("f"), 1))}")
    val made: (Animal, int) = (animal, 1)
    println(made match
        _: (Dog, int) -> "dog"
        _ -> "made as (Animal, int)")
