// expect: exit 0
// Lower-bounded type parameters, `[W >: T]`: a covariant `T` appears as the lower bound of a method's
// own parameter, and a call widens `W` to the join of the bound and its arguments, as far as `Any`.

trait Named
  name() -> string

open class Animal(val label: string): Named
  override name() -> string = label

class Cat(label: string): Animal(label)
class Dog(label: string): Animal(label)

// A covariant data type, with methods an extension adds and a generic function.
data Chain[+A]
  Link(head: A, tail: Chain[A])
  End

impl[A] Chain[A]
  prepended[W >: A](x: W) -> Chain[W] = Link(x, self)
  size() -> int = self match
    Link(_, rest) -> 1 + rest.size()
    End -> 0

prepend[A, W >: A](xs: Chain[A], x: W) -> Chain[W] = Link(x, xs)

names(xs: Chain[Animal]) -> string = xs match
  Link(a, rest) -> a.name() + " " + names(rest)
  End -> ""

describe(xs: Chain[Any]) -> string = xs match
  Link(a, rest) ->
    val here = a match
      s: string -> s"string $s"
      n: Named -> s"named ${n.name()}"
      _ -> "other"
    here + "; " + describe(rest)
  End -> ""

// A covariant trait declares the method, and each class implements it: the call dispatches.
trait Bag[K, +V]
  size() -> int
  put[W >: V](key: K, value: W) -> Bag[K, W]
  first() -> V

class One[K, +V](val key: K, val value: V): Bag[K, V]
  override size() -> int = 1
  override put[W >: V](key: K, value: W) -> Bag[K, W] = Two(self.key, self.value, key, value)
  override first() -> V = value

class Two[K, +V](val k1: K, val v1: V, val k2: K, val v2: V): Bag[K, V]
  override size() -> int = 2
  override put[W >: V](key: K, value: W) -> Bag[K, W] = One(key, value)
  override first() -> V = v1

// A covariant class's own method, and one with a trait bound beside the lower bound.
class Holder[+T](val item: T)
  or[W >: T](other: W, mine: bool) -> W = if mine then item else other
  pairWith[W >: T](other: W) -> (W, W) = (item, other)
  bothNames[W >: T: Named](other: W) -> string
    val w: W = item
    w.name() + "/" + other.name()

// A lower bound on an invariant parameter.
class Cell[T](val v: T)
  widened[W >: T](x: W) -> Vector[W] = [v, x]

main()
  val cats: Chain[Cat] = Link(Cat("tom"), End)
  // The join of `Cat` and `Dog`.
  val pets = cats.prepended(Dog("rex"))
  println(names(pets))
  println(pets.size())
  // A written type argument, and one the expected type decides.
  val written = cats.prepended[Animal](Cat("kit"))
  println(names(written))
  val expected: Chain[Animal] = cats.prepended(Cat("ash"))
  println(names(expected))
  // A `Cat` keeps `W` as `Cat`.
  val more = cats.prepended(Cat("kit"))
  val again: Chain[Cat] = more
  println(again.size())
  // No nearer common type than `Any`.
  val mixed = cats.prepended("hello")
  println(describe(mixed))
  // Through a generic function.
  println(names(prepend(cats, Dog("max"))))
  // Value types: the literal takes the bound's type.
  val longs: Chain[long] = Link(5, End)
  val wider = longs.prepended(3)
  val sure: Chain[long] = wider
  println(sure.size())
  // Through a trait, by dispatch.
  val bag: Bag[string, Cat] = One("a", Cat("tom"))
  val grown = bag.put("b", Dog("rex"))
  println(grown.size())
  println(grown.first().name())
  val back = grown.put("c", Dog("fido"))
  println(back.first().name())
  // A class's own methods.
  val h = Holder(Cat("tom"))
  println(h.or(Dog("rex"), true).name())
  println(h.or(Dog("rex"), false).name())
  val (a, b) = h.pairWith(Dog("rex"))
  println(a.name() + " " + b.name())
  println(h.bothNames(Dog("rex")))
  val cell = Cell(Cat("tom"))
  println(cell.widened(Dog("rex")).length)
