// Whole files through `avin.fs`, in a directory the program makes and removes: text and bytes
// written, appended and read back, and each failure an `IoError` value.
import avin.fs
import avin.io.{IoError, NotFound, InvalidUtf8, IsADirectory}

show(bytes: Array[byte]) -> string = bytes.mkString(" ")

main()
    val dir = fs.createTempDir("avin-fs") match
        Ok(d) -> d
        Err(e) ->
            print(s"no directory: $e")
            return
    print(s"${fs.exists(dir)} ${fs.isDir(dir)} ${fs.isFile(dir)}")
    val text = dir + "/text.txt"
    // Text round trips, characters beyond ASCII included.
    print(s"${fs.writeText(text, "hello, wörld ✓")} ${fs.readText(text)}")
    print(s"${fs.exists(text)} ${fs.isDir(text)} ${fs.isFile(text)}")
    // Writing replaces; appending adds, and makes a file that is not there.
    print(s"${fs.writeText(text, "one")} ${fs.appendText(text, ", two")} ${fs.readText(text)}")
    print(s"${fs.appendText(dir + "/fresh", "made")} ${fs.readText(dir + "/fresh")}")
    // An empty file is the empty string and no bytes.
    print(s"${fs.writeText(dir + "/empty", "")} [${fs.readText(dir + "/empty")}] ${fs.readBytes(dir + "/empty")}")
    // Bytes round trip, every value from 0 to 255 included.
    val all = Array.tabulate(256, (i) -> byte(i))
    print(fs.writeBytes(dir + "/all", all))
    fs.readBytes(dir + "/all") match
        Ok(b) -> print(s"${b.length()} ${b == all} ${b(0)} ${b(255)}")
        Err(e) -> print(s"$e")
    print(s"${fs.writeText(dir + "/raw", "ok")} ${fs.appendBytes(dir + "/raw", Array.fill(1, byte(0xff)))}")
    fs.readBytes(dir + "/raw") match
        Ok(b) -> print(show(b))
        Err(e) -> print(s"$e")
    // Bytes that are not UTF-8 read as text are an error naming where they stop being UTF-8.
    print(fs.readText(dir + "/raw"))
    fs.readText(dir + "/raw") match
        Err(InvalidUtf8(at)) -> print(s"invalid at $at")
        other -> print(s"unexpected $other")
    // A missing file, a missing directory on the way, and a directory read as a file.
    print(s"${fs.readText(dir + "/missing")} ${fs.readBytes(dir + "/missing")}")
    print(s"${fs.writeText(dir + "/no/such/file", "x")}")
    fs.readText(dir) match
        Err(IsADirectory) -> print("a directory")
        other -> print(s"unexpected $other")
    fs.readText(dir + "/missing") match
        Err(NotFound) -> print("not found")
        other -> print(s"unexpected $other")
    // Removing a file, then removing it again.
    print(s"${fs.remove(text)} ${fs.exists(text)} ${fs.remove(text)}")
    print(s"${fs.removeDirAll(dir)} ${fs.exists(dir)} ${fs.readText(dir + "/all")}")
