// Whole files through `avin.fs`, in a directory the program makes and removes: text and bytes
// written, appended and read back, and each failure an `IoError` value.
import avin.fs
import avin.io.{IoError, NotFound, InvalidUtf8, IsADirectory}

show(bytes: Array[byte]) -> string = bytes.mkString(" ")

// The temporary directory the test works in, written as `DIR` in what it prints, which an error
// names, so the output is the same on every run.
var root = ""

say(line: Any)
    println(if root == "" then s"$line" else s"$line".replace(root, "DIR"))

main()
    val dir = fs.createTempDir("avin-fs") match
        Ok(d) -> d
        Err(e) ->
            say(s"no directory: $e")
            return
    root = dir
    say(s"${fs.exists(dir)} ${fs.isDir(dir)} ${fs.isFile(dir)}")
    val text = dir + "/text.txt"
    // Text round trips, characters beyond ASCII included.
    say(s"${fs.writeText(text, "hello, wörld ✓")} ${fs.readText(text)}")
    say(s"${fs.exists(text)} ${fs.isDir(text)} ${fs.isFile(text)}")
    // Writing replaces; appending adds, and makes a file that is not there.
    say(s"${fs.writeText(text, "one")} ${fs.appendText(text, ", two")} ${fs.readText(text)}")
    say(s"${fs.appendText(dir + "/fresh", "made")} ${fs.readText(dir + "/fresh")}")
    // An empty file is the empty string and no bytes.
    say(s"${fs.writeText(dir + "/empty", "")} [${fs.readText(dir + "/empty")}] ${fs.readBytes(dir + "/empty")}")
    // Bytes round trip, every value from 0 to 255 included.
    val all = Array.tabulate(256, (i) -> byte(i))
    say(fs.writeBytes(dir + "/all", all))
    fs.readBytes(dir + "/all") match
        Ok(b) -> say(s"${b.length} ${b == all} ${b(0)} ${b(255)}")
        Err(e) -> say(s"$e")
    say(s"${fs.writeText(dir + "/raw", "ok")} ${fs.appendBytes(dir + "/raw", Array.fill(1, byte(0xff)))}")
    fs.readBytes(dir + "/raw") match
        Ok(b) -> say(show(b))
        Err(e) -> say(s"$e")
    // Bytes that are not UTF-8 read as text are an error naming where they stop being UTF-8.
    say(fs.readText(dir + "/raw"))
    fs.readText(dir + "/raw") match
        Err(IoError(InvalidUtf8(at), _, _)) -> say(s"invalid at $at")
        other -> say(s"unexpected $other")
    // A missing file, a missing directory on the way, and a directory read as a file.
    say(s"${fs.readText(dir + "/missing")} ${fs.readBytes(dir + "/missing")}")
    say(s"${fs.writeText(dir + "/no/such/file", "x")}")
    fs.readText(dir) match
        Err(IoError(IsADirectory, _, _)) -> say("a directory")
        other -> say(s"unexpected $other")
    fs.readText(dir + "/missing") match
        Err(IoError(NotFound, _, _)) -> say("not found")
        other -> say(s"unexpected $other")
    // Removing a file, then removing it again.
    say(s"${fs.remove(text)} ${fs.exists(text)} ${fs.remove(text)}")
    say(s"${fs.removeDirAll(dir)} ${fs.exists(dir)} ${fs.readText(dir + "/all")}")
