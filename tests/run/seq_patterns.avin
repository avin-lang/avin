// expect: exit 0
// A sequence pattern takes apart any sequence: `[]` matches an empty one and `[a, b]` one of exactly
// two elements, binding or testing each, on vectors, arrays, buffers and deques as on lists, in
// `match`, in clauses, in `is`, nested, inside a lambda, and on a sequence known only as a `Seq`.

class Point(val x: int, val y: int)

describe(xs: Vector[string]) -> string = xs match
  [] -> "nobody"
  [one] -> one
  [first, second] -> s"$first and $second"
  _ -> s"${xs(0)} and ${xs.length - 1} others"

shape[T](xs: Seq[T]) -> string = xs match
  [] -> "empty"
  [_] -> "one"
  [_, _] -> "two"
  _ -> "many"

pairSum(xs: Array[int]) -> int
pairSum([a, b]) = a + b
pairSum([a, b, c]) | a == 0 = b + c
pairSum(_) = -1

main()
  println(describe([]))
  println(describe(["Ann"]))
  println(describe(["Ann", "Bo"]))
  println(describe(["Ann", "Bo", "Cy"]))

  val l: List[int] = [1, 2]
  val d: Deque[int] = [1, 2, 3]
  val b: Buffer[int] = []
  val a: Array[string] = ["solo"]
  println(s"${shape(l)} ${shape(d)} ${shape(b)} ${shape(a)} ${shape([1, 2, 3, 4])}")

  println(s"${pairSum([3, 4])} ${pairSum([0, 5, 6])} ${pairSum([1, 5, 6])} ${pairSum([])}")

  // Literals and ranges test elements; nested patterns take apart sequences of sequences.
  val grid = [[1, 2], [3]]
  grid match
    [[x, 2], [y]] -> println(x + y)
    _ -> println("no")
  grid match
    [[0, _], _] -> println("starts with 0")
    [[1, n], [m]] -> println(n * m)
    _ -> println("no")
  println(s"${[1, 2, 3] is [1, _, 3]} ${[1, 2, 3] is [1, 5, 3]} ${[1, 2] is [_, 0..5]}")

  // Elements that are objects, bound and read.
  val points: Buffer[Point] = [Point(1, 2), Point(3, 4)]
  points match
    [p, q] -> println(p.x + q.y)
    _ -> println("no")

  // A deque matched after its elements have wrapped around its array.
  val ring = Deque[int]()
  for i in 0 ..< 8 do ring.append(i)
  for i in 0 ..< 6 do ring.removeHead()
  ring.append(8)
  ring match
    [x, y, z] -> println(s"$x $y $z")
    _ -> println("no")

  // Inside a lambda, and in an `is` that binds for the branch it guards.
  val product = (v: Vector[int]) -> v match
    [x, y] -> x * y
    _ -> 0
  println(s"${product([6, 7])} ${product([6])}")
  val pair = ["left", "right"]
  if pair is [left, right] then println(s"$right $left")
