// expect: exit 0
// A machine is an ordinary object: held in collections, captured by closures, passed to functions
// and handled through any of them, each keeping its own state. Many machines whose states hold
// objects survive collection while they move between states.
class Payload(val id: int, val text: string)

data Signal
  Load(p: Payload)
  Drop
  Ping

machine Holder(val id: int) receives Signal
  var pings = 0

  state Idle
    Load(p) -> Loaded(p, Vector(p))
    Drop -> stay
    Ping ->
      pings += 1
      stay

  state Loaded(current: Payload, history: Vector[Payload])
    Load(p) -> Loaded(p, history :+ p)
    Drop -> Idle
    Ping ->
      pings += 1
      stay

loadedCount(h: Holder) -> int = h.state() match
  Loaded(_, history) -> history.length
  Idle -> 0

main() -> int
  var holders = Vector[Holder]()
  for i in 0 ..< 200
    holders = holders :+ Holder(i)
  for round in 0 ..< 5
    for h in holders
      if h.id % 3 == round % 3 then h.handle(Drop)
      else h.handle(Load(Payload(h.id * 10 + round, s"p${h.id}-$round")))
  var total = 0
  for h in holders do total += loadedCount(h)
  println(total)
  holders(7).state() match
    Loaded(current, history) -> println(s"${current.text} ${history.length} ${history(0).id}")
    Idle -> println("idle")
  println(holders(6).state() is Idle)

  // Closures capture a machine and handle events through it.
  val m = Holder(-1)
  val ping = () -> m.handle(Ping)
  val load = (n: int) -> m.handle(Load(Payload(n, "x")))
  ping()
  ping()
  load(3)
  ping()
  println(m.pings)
  println(loadedCount(m))

  // A map of machines, each found and driven by its key.
  val byName = Map[string, Holder]().updated("a", Holder(1)).updated("b", Holder(2))
  byName("a").handle(Load(Payload(1, "one")))
  println(loadedCount(byName("a")))
  println(loadedCount(byName("b")))
  val handlers = Vector((s: Signal) -> byName("b").handle(s), (s: Signal) -> byName("a").handle(s))
  for f in handlers do f(Load(Payload(9, "nine")))
  println(loadedCount(byName("a")) + loadedCount(byName("b")))
  0
