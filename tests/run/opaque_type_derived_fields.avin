// expect: exit 0
// A data type whose fields are of opaque types derives a trait where each opaque type implements it:
// the core library's `Ord`, `Display`, `Eq` and `Hash`, and a template of the program's own, a JSON
// encoder walking the fields at their own types, which reaches the opaque type's impl rather than
// its representation's.

opaque type UserId = long
opaque type Email = string

impl Ord for UserId
  compare(other: UserId) -> int = repr.compare(other.repr)

impl Display for UserId
  display(out: Writer, spec: FormatSpec) = out.write(s"#${repr}")

trait ToJson
  json() -> string

impl ToJson for long
  json() -> string = s"$self"

impl ToJson for string
  json() -> string = s"\"$self\""

impl ToJson for UserId
  json() -> string = s"{\"user\": ${repr}}"

impl ToJson for Email
  json() -> string = s"\"mailto:${repr}\""

derive ToJson for T
  json() -> string = T.walk(self, Encoder("")).finish()

data Encoder(text: string)

impl ShapeVisitor for Encoder
  variant(v: VariantShape) -> Encoder = self

impl Encoder
  field[F: ToJson](f: FieldShape, value: F) -> Encoder =
    val sep = if text == "" then "{" else ", "
    Encoder(s"$text$sep\"${f.name}\": ${value.json()}")
  finish() -> string = text + "}"

data Row(id: UserId, n: int) derives Ord, Display, Eq, Hash

data Pair[A](a: A, b: A) derives Ord, Display

data Account(id: UserId, mail: Email, note: string) derives ToJson

main()
  val r = Row(UserId(2), 1)
  println(r)
  println(r < Row(UserId(3), 0))
  println(r == Row(UserId(2), 1))
  println(r.hash() == Row(UserId(2), 1).hash())
  println(Pair(UserId(1), UserId(2)))
  println([Row(UserId(5), 0), r].sorted)
  println(Account(UserId(7), Email("a@b.c"), "").json())
