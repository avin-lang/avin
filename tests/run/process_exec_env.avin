// expect: exit 0
// `exec` with an environment of its own: the new program sees exactly the variables given, nothing of
// this program's inherited, a value with spaces, Unicode or nothing at all kept as it is, and a bare
// name looked for on the `PATH` the environment gives. The arguments reach it as they were, an
// empty one and one of spaces among them.
import avin.process

main()
  val home = process.env("HOME").isDefined()
  println(s"this program has HOME: $home")
  val environment = Map(("PATH", "/usr/bin:/bin"), ("GREETING", "héllo wörld ✓"), ("EMPTY", ""))
  val script = "printf '%s|' \"$GREETING\" \"${EMPTY-unset}\" \"${HOME-unset}\" \"$#\" \"$1\" \"$2\" \"$3\"; echo; env | grep -v -e '^PWD=' -e '^SHLVL=' -e '^_=' -e '^OLDPWD=' | sort"
  val r = process.exec("sh", ["-c", script, "sh", "", "two words", "∑"], environment)
  println(s"exec came back: ${r.isErr()}")
