// A command's standard output is captured as text by `output()`, its standard error left the
// program's own, and its standard input given as text or a file. `toFile` and `appendTo` send the
// output to a file, emptied first or added to; on a sequence the file is opened once, so both parts
// write it. Output too large for a pipe's buffer comes back whole, and bytes that are not UTF-8 are
// each replaced with U+FFFD.
import avin.process.Command
import avin.fs

main()
  val dir = fs.createTempDir("avin-command-output") match
    Ok(d) -> d
    Err(e) -> fail(s"no temporary directory: $e")
  // Standard error is not captured: it reaches the program's own.
  println(Command("/bin/sh", "-c", "echo to-err >&2; echo to-out").output())
  // Nothing written is the empty string.
  println(Command("/usr/bin/true").output())
  // Standard input from text, and from a file.
  println(Command("/bin/cat").withInput("first\nsecond\n").output())
  println(Command("/usr/bin/wc", "-c").withInput("").output().map(t -> t.trim()))
  fs.writeText(dir + "/in.txt", "from a file\n")
  println(Command("/bin/cat").fromFile(dir + "/in.txt").output())
  println(Command("/bin/cat").fromFile(dir + "/missing.txt").output())
  // The last redirection of a stream is the one that counts.
  println(Command("/bin/cat").fromFile(dir + "/in.txt").withInput("text wins\n").output())
  // Output to a file: emptied first, then added to.
  fs.writeText(dir + "/out.txt", "old contents\n")
  println(Command("/bin/echo", "one").toFile(dir + "/out.txt").run())
  println(fs.readText(dir + "/out.txt"))
  println(Command("/bin/echo", "two").appendTo(dir + "/out.txt").run())
  println(Command("/bin/echo", "three").appendTo(dir + "/out.txt").run())
  println(fs.readText(dir + "/out.txt"))
  println(Command("/bin/echo", "nothing captured").toFile(dir + "/out.txt").output())
  println(fs.readText(dir + "/out.txt"))
  // A sequence redirected as a whole writes one file, both parts in turn.
  println((Command("/bin/echo", "a") andThen Command("/bin/echo", "b")).toFile(dir + "/seq.txt").run())
  println(fs.readText(dir + "/seq.txt"))
  // A sequence's input is opened once and shared: the second part reads on where the first stopped,
  // which is the end.
  println((Command("/bin/cat") andThen Command("/bin/cat")).fromFile(dir + "/seq.txt").output())
  println((Command("/bin/cat") andThen Command("/bin/cat")).withInput("once\n").output())
  // A directory cannot be written.
  println(Command("/bin/echo", "x").toFile(dir).run())
  // Output much larger than a pipe's buffer.
  println(Command("/usr/bin/head", "-c", "300000", "/dev/zero").output().map(t -> t.byteLength()))
  val big = Command("/bin/sh", "-c", "i=0; while [ $i -lt 5000 ]; do echo line$i; i=$((i+1)); done").output()
  println(big.map(t -> t.lines().length))
  println(big.map(t -> t.lines()(4999)))
  // Ill-formed UTF-8.
  println(Command("/usr/bin/printf", "a\\377b\\n").output())
  fs.removeDirAll(dir)
