// expect: exit 0
// Sequences with equal elements in order are equal through `Any` and trait-typed values whatever
// their class, with hashes that agree; sequences of different elements or lengths, and values that
// are not sequences, stay unequal.

trait Marker
    mark() -> int

class Tagged(): Marker
    override mark() -> int = 1

class Squares(val n: int): Seq[int]
    override length() -> int = n
    override apply(i: int) -> int = i * i

equal(a: Any, b: Any) -> bool = a == b

sameHash(a: Any, b: Any) -> bool = a.hash() == b.hash()

main()
    val v = [1, 2, 3]
    val l: List[int] = [1, 2, 3]
    val buf = Buffer[int]()
    buf += 1
    buf += 2
    buf += 3
    val dq = Deque[int]()
    dq.addLast(2)
    dq.addLast(3)
    dq.addFirst(1)
    val arr = Array.fill(3, 0)
    arr(0) = 1
    arr(1) = 2
    arr(2) = 3
    val all: Vector[Any] = [v, l, v.toArraySeq(), buf, dq, arr, 1..3, v.view().toVector()]
    var agree = true
    for x in all
        for y in all
            if !equal(x, y) || !sameHash(x, y) then agree = false
    println(agree)

    val a: Any = [1, 2]
    println(a == List(1, 2), List(1, 2) == a, a != List(1, 3), a != List(1, 2, 3), a != List(1))
    println(a.hash() == List(1, 2).hash())

    // Different elements, lengths and non-sequences.
    println(equal(v, [1, 2, 4]), equal(v, [1, 2]), equal(v, 3), equal(3, v), equal(v, "abc"), equal(v, Tagged()))
    val none: Vector[int] = []
    println(equal(none, List.empty[int]()), equal(List.empty[int](), none), equal([1], ["a"]))

    // Elements of other types, and nested sequences.
    println(equal(["a", "b"], List("a", "b")), equal(["a", "b"], List("a", "c")))
    println(equal([[1], [2, 3]], List(List(1), [2, 3].toList())), equal([[1], [2, 3]], List(List(1), [2, 4].toList())))
    println(equal([(1, "a")], List((1, "a"))), equal([Some(1)], List(Some(1))))

    // A program's own sequence, a trait-typed value and a sequence of the same kind.
    println(equal(Squares(3), [0, 1, 4]), equal([0, 1, 4], Squares(3)), equal(Squares(3), Squares(3)), equal(Squares(3), Squares(2)))
    val s: Seq[int] = l
    val m: Marker = Tagged()
    println(equal(s, v), equal(s, m), equal(v, v.toList()))

    // Through sets and maps holding sequences.
    val set: Set[Any] = {v, 7}
    println(set.contains(l), set.contains(buf), set.contains([1, 2]), set.contains(7))
    val map: Map[Any, int] = Map((v, 1))
    println(map.get(l), map.get(arr), map.get([3]))
    val seqs: Set[Seq[int]] = {v, l, 1..3, [5]}
    println(seqs.size())
    val keyed: Map[List[int], string] = Map((l, "list"))
    println(keyed.get([1, 2, 3]), keyed.getOrElse([1], "none"))
