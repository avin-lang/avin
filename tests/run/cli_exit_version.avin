// expect: exit 0
// args: --version
// `parseOrExit` given `--version`: the name and the version go to standard output as one line and
// the program exits with 0.
import avin.cli

val parser = cli.Parser("wc", version = "0.1.0-ünï")
  .positionals("file", required = true)

main(args: Vector[string]) -> int
  parser.parseOrExit(args)
  println("not reached")
  1
