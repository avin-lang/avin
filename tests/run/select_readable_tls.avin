// expect: exit 0
// A TLS connection is readable while TLS holds plaintext it has already decrypted, though nothing is
// left on the socket beneath: a read of 100 bytes from a 12000-byte record leaves the rest inside TLS,
// and a select with a five-second `after` runs its readable arm at once. Once that plaintext is read
// and nothing more has come, the connection is not readable, and the `after` runs; a record arriving
// later wakes a waiting select through the socket. Plaintext a `readLine` read beyond its line keeps
// it readable, and so does the peer closing. Nothing is left on the poller afterwards.
import avin.fs
import avin.io.IoError
import avin.net.TcpListener
import avin.net.tls.{TlsClient, TlsError, TlsServer, TlsStream}
import avin.threads.{Channel, spawn}
import avin.time.{millis, seconds}

@sysl("avin.rt.socket_waiters")
socketWaiters() -> long

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

tls[T](r: Result[T, TlsError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

// A test certificate or key, from the repository root or from `compiler/`.
fixture(name: string) -> string
  val here = "tests/fixtures/tls/" + name
  ok(fs.readText(if fs.exists(here) then here else "../" + here))

within(c: TlsStream, d: avin.time.Duration) -> string = select
  c.readable() -> "readable"
  after d -> "timed out"

run(where: string)
  val l = ok(TcpListener.bind("127.0.0.1", 0))
  val port = l.port()
  val server = tls(TlsServer.of(fixture("localhost.pem"), fixture("localhost.key")))
  val go = Channel[string]()
  val serving = spawn(() ->
    val s = tls(TlsStream.server(ok(l.accept()), server))
    ok(s.write(Array.fill(12000, byte(97))))
    loop
      go.receive() match
        Some(text) -> ok(s.writeText(text))
        None -> break
    ok(s.close()))
  val c = tls(TlsStream.connect("localhost", port, TlsClient().trust(fixture("ca.pem"))))
  var got = ok(c.read(100)).length
  println(where, got, within(c, seconds(5)))
  while got < 12000
    got += ok(c.read(12000)).length
  println(where, got, within(c, millis(50)))
  go.send("later\n")
  println(where, select
    c.readable() -> ok(c.readLine()).getOrElse("(end)"))
  go.send("one\ntwo\n")
  println(where, ok(c.readLine()).getOrElse("(end)"))
  println(where, select
    c.readable() -> ok(c.readLine()).getOrElse("(end)")
    else "nothing")
  go.close()
  println(where, select
    c.readable() -> ok(c.readLine()).getOrElse("(end)"))
  serving.join()
  ok(c.close())
  // A closed connection is readable, its read answering that it is closed.
  println(where, within(c, seconds(5)), c.read(1).isErr, c.readinessDescriptor())
  println(where, socketWaiters())

main()
  run("main")
  spawn(() -> run("thread")).join()
