// expect: exit 0
// `fs.matches`: a path against a pattern, component by component. `*`, `?`, classes and their
// negations and ranges, `\` escapes, `**` as whole components, hidden names, a `[` left open, names
// beyond ASCII (where `?` is one character), and separators doubled or trailing.
import avin.fs

check(pattern: string, p: string) = println(s"$pattern ~ $p: ${fs.matches(pattern, p)}")

main()
    println("-- literal and separators")
    check("a/b", "a/b")
    check("a/b", "a//b/")
    check("a//b/", "a/b")
    check("a/b", "a/c")
    check("a/b", "a/b/c")
    check("a", "")
    check("", "")
    check("/a", "a")
    check("a", "/a")
    check("/", "/")
    check("/*", "/etc")
    println("-- star")
    check("*.txt", "notes.txt")
    check("*.txt", ".txt")
    check("*.txt", "a/notes.txt")
    check("*", "")
    check("a*", "a")
    check("*a*b*", "xaybz")
    check("*a*b", "xaybz")
    check("a*/c", "abc/c")
    check("a*/c", "ab/x/c")
    println("-- question mark")
    check("?.txt", "a.txt")
    check("?.txt", "ab.txt")
    check("?.txt", "文.txt")
    check("??.txt", "文.txt")
    check("?", "/")
    println("-- classes")
    check("[abc].txt", "b.txt")
    check("[abc].txt", "d.txt")
    check("[a-c]x", "bx")
    check("[a-c]x", "dx")
    check("[!a-c]x", "dx")
    check("[^a-c]x", "bx")
    check("[]]", "]")
    check("[-a]", "-")
    check("[a-]", "-")
    check("[\\]]", "]")
    check("[ä-ö]", "é")
    check("[ä-ö]", "z")
    check("[ab", "[ab")
    check("[ab", "a")
    println("-- escapes")
    check("\\*", "*")
    check("\\*", "a")
    check("a\\?", "a?")
    check("a\\?", "ab")
    check("a\\", "a\\")
    println("-- double star")
    check("**", "")
    check("**", "a/b/c")
    check("**/*.c", "main.c")
    check("**/*.c", "src/lib/main.c")
    check("src/**/main.c", "src/main.c")
    check("src/**/main.c", "src/a/b/main.c")
    check("src/**/main.c", "lib/a/main.c")
    check("**/b/**", "a/b/c/d")
    check("a/**", "a")
    check("a**b", "axyb")
    check("a**b", "ax/yb")
    check("/**/x", "/x")
    check("/**/x", "x")
    println("-- hidden names")
    check("*", ".git")
    check("?git", ".git")
    check("[.]git", ".git")
    check(".*", ".git")
    check(".git", ".git")
    check("\\.git", ".git")
    check("**/*.c", ".git/main.c")
    check("**/*.c", "a/.hidden/main.c")
    check(".hidden/*.c", ".hidden/main.c")
    check("*/x", "../x")
    check("../*", "../x")
    println("-- beyond ASCII")
    check("文件*", "文件.txt")
    check("*.ünï", "a.ünï")
    check("ünï/**/*.txt", "ünï/日本/x.txt")
