// expect: exit 0
// A method taken as a value with type arguments that meet its bounds is accepted, as at a call: a
// plain bound, a bounded type parameter of the code taking it, a covariant constructor for `F[+_]`
// and a bounded constructor for `F[_: Ord]`.
class Tools
  pick[A: Ord](x: A, y: A) -> A = if x < y then x else y
  widen[F[+_]](x: F[int]) -> F[int] = x
  sorted[F[_: Ord]](x: F[int]) -> F[int] = x

smallest[T: Ord](a: T, b: T) -> T
  val f = Tools().pick[T]
  f(a, b)

main()
  val f = Tools().pick[int]
  println(f(3, -2147483648))
  val g = Tools().pick[string]
  println(g("b", "ä"))
  println(smallest(2.5, 1.5))
  val w = Tools().widen[Option]
  println(w(Some(1)))
  val s = Tools().sorted[TreeSet]
  println(s(TreeSet(3, 2)))
