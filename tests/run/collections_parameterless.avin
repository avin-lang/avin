// expect: exit 0
// The collections' accessors are parameterless methods: `xs.head`, `xs.size`, `m.keys`, read with no
// parentheses on every collection, through `Iterable[T]`, `Seq[T]` and a bounded type parameter, and
// in a program's own collection, which declares `length` and `size` without a parameter list too, or
// implements `length` with a field. What makes a fresh mutable object or reads an iterator on keeps
// its parentheses: `iterator()`, `toArray()`, `toBuffer()`, `next()`.

import avin.collections.mutable

// Generic code over any collection reads the accessors the same way.
describe[T: Display](xs: Iterable[T]) -> string =
  s"size ${xs.size}, empty ${xs.isEmpty}, nonEmpty ${xs.nonEmpty}, head ${xs.headOption}, last ${xs.lastOption}, known ${xs.knownSize}"

ends[T: Display](xs: Seq[T]) -> string =
  if xs.isEmpty then "none" else s"${xs.head}..${xs.last} of ${xs.length}, tail ${xs.tail}, init ${xs.init}, reverse ${xs.reverse}"

extremes[T: Ord & Display](xs: Iterable[T]) -> string = s"${xs.min} ${xs.max} ${xs.minOption} ${xs.maxOption}"

totals[T: Add & Mul & Display](xs: Iterable[T]) -> string = s"${xs.sum} ${xs.product}"

// A sequence of its own: `length` is declared without a parameter list, as `Seq` declares it.
class Countdown(from: int): Seq[int]
  override length -> int = from
  override apply(i: int) -> int = from - i

// A field implements the abstract `length`.
class Repeated(val length: int, item: string): Seq[string]
  override apply(i: int) -> string = item

// An `Iterable` that counts itself.
class Twice(x: int): Iterable[int]
  override iterator() -> Iterator[int] = [x, x].iterator()
  override size -> int = 2
  override knownSize -> int = 2

// A parameterless method of a generic class that yields a function gives that function where one
// is expected.
class Holder[T](x: T)
  item -> T = x

main()
  val v = [3, 1, 2]
  val l = List(3, 1, 2)
  val r = 1 ..< 4
  val a = Array.tabulate(2, i -> 5 + i)
  val s = HashSet.from([2, 1])
  val m = Map(("a", 1), ("b", 2))
  val empty = Vector.empty[int]()
  println(describe(v))
  println(describe(l))
  println(describe(r))
  println(describe(a))
  println(describe(empty))
  println(describe(Twice(7)))
  println(s.size, s.isEmpty, s.toSet == s.toSet)
  println(ends(v))
  println(ends(l))
  println(ends(r))
  println(ends(empty))
  println(ends(Countdown(3)))
  println(ends(Repeated(2, "é😀")))
  println(extremes(v))
  println(extremes(["b", "a"]))
  println(totals(v))
  println(totals(Vector.empty[long]()))
  println(totals(List(1.5, 2.0)))
  // Conversions and the rest on a concrete collection.
  println(v.toList, l.toVector, v.toSet.size, [("k", 1)].toMap, v.toArraySeq, v.toSortedSet)
  println([(2, "b"), (1, "a")].toSortedMap, [1, 1, 2].distinct, v.indices, v.zipWithIndex)
  println([[1, 2], [3]].flatten, [[1, 2], [3, 4]].transpose, [(1, "x"), (2, "y")].unzip)
  println(m.keys, m.values, m.keySet, m.size, m.isEmpty)
  // A chain of accessors, an accessor in an operand and in a chained comparison.
  println(v.tail.head + l.reverse.head, 0 < v.length <= 3, v.reverse.reverse == v)
  // Mutable collections.
  val buf = Buffer.from([1, 2])
  buf.addOne(3)
  println(buf.length, buf.last, buf.toVector)
  val mm = mutable.Map[string, int]()
  mm("x") = 1
  println(mm.size, mm.keys, mm.values, mm.toMap, mm.nonEmpty)
  val ts = mutable.TreeSet.from([3, 1, 2])
  println(ts.head, ts.last, ts.size, ts.toSet)
  // A lazy list forces only what the accessor needs.
  val naturals = LazyList.iterate(0, x -> x + 1)
  println(naturals.head, naturals.tail.head, naturals.tail.tail.headOption)
  // On an iterator an accessor reads from it: `head` takes one element, `size` the rest.
  val it = [10, 20, 30].iterator()
  println(it.head, it.size, it.isEmpty)
  // A lambda is the function form of an accessor.
  val first = () -> v.head
  val sizes = [v, [1]].map(xs -> xs.size)
  println(first(), sizes)
  // What makes a fresh mutable object keeps its parentheses.
  val arr = v.toArray()
  arr(0) = 9
  val b2 = v.toBuffer()
  b2.addOne(4)
  println(v, arr.length, b2.length, v.iterator().next())
  val got: () -> int = Holder(() -> 41).item
  val fs: Vector[() -> int] = [() -> 1, () -> 2]
  val firstOf: () -> int = fs.head
  println(got() + 1, firstOf())
