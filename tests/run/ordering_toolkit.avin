// expect: exit 0
// ArraySeq orders lexicographically; Reverse, clamp, compareBy, reverseOrder and thenBy.

data Person(name: string, age: int)

smaller[T: Ord](a: T, b: T) -> T = if a.compare(b) <= 0 then a else b

sign(n: int) -> int = if n < 0 then -1 elif n > 0 then 1 else 0

seq(items: Vector[int]) -> ArraySeq[int] = items.toArraySeq

main()
    val sa = seq([1, 2, 3])
    val sb = seq([1, 2, 4])
    val se = seq([])
    val one = seq([1])
    val longer = seq([1, 2, 3, 0])
    println(s"${sign(se.compare(se))} ${sign(se.compare(one))} ${sign(one.compare(se))}")
    println(s"${sign(sa.compare(seq([1, 2, 3])))} ${sign(sa.compare(sb))} ${sign(sb.compare(sa))}")
    println(s"${sign(sa.compare(longer))} ${sign(longer.compare(sa))} ${sa < sb} ${sa <= seq([1, 2, 3])} ${sb > sa} ${longer >= sa}")
    println(s"${seq([2]) > seq([1, 9, 9])} ${seq([0, 9]) < seq([1])}")
    val all = [sb, longer, se, sa, seq([0]), one]
    println(all.sorted())
    println(all.max)
    println(smaller(sa, sb))
    val ws = [["b"].toArraySeq, ["a", "z"].toArraySeq, ["a"].toArraySeq, [].toArraySeq]
    println(ws.sorted())
    println(Vector(seq([2, 1]), seq([2]), seq([1, 5])).sortBy(x -> Reverse(x)))
    println(Vector(Reverse(sa), Reverse(sb)).sorted().map(r -> r.value))

    // Reverse.
    println(s"${Reverse(1) < Reverse(2)} ${Reverse(2) < Reverse(1)} ${Reverse(1) == Reverse(1)} ${sign(Reverse(5).compare(Reverse(5)))}")
    println(s"${Reverse(1) <= Reverse(1)} ${Reverse(1) >= Reverse(2)} ${Reverse(1) > Reverse(2)}")
    println(Vector(3, 1, 2, 1).sortBy(x -> Reverse(x)))
    println(Vector("b", "c", "a").sortBy(x -> Reverse(x)))
    println(Reverse(Reverse(1)) < Reverse(Reverse(2)))
    println(Vector(3, 1, 2).sortBy(x -> Reverse(Reverse(x))))
    val people = [Person("zed", 30), Person("amy", 41), Person("bob", 30), Person("cat", 41)]
    println(people.sortBy(p -> (Reverse(p.age), p.name)).map(p -> p.name))
    println(people.sortBy(p -> (p.age, Reverse(p.name))).map(p -> p.name))
    println(people.toList.sortBy(p -> (Reverse(p.age), p.name)).map(p -> p.name))
    println(Vector(Some(1), None, Some(3)).sortBy(x -> Reverse(x)))
    println(Vector(Reverse(2), Reverse(9), Reverse(4)).max.value)
    val none: Vector[Reverse[int]] = []
    println(none.sorted())

    // clamp.
    println(s"${clamp(15, 0, 10)} ${clamp(-5, 0, 10)} ${clamp(5, 0, 10)} ${clamp(0, 0, 10)} ${clamp(10, 0, 10)} ${clamp(5, 5, 5)}")
    println(s"${clamp(2147483647, -2147483647 - 1, 100)} ${clamp(-2147483647 - 1, -10, 10)}")
    println(s"${clamp("m", "a", "f")} ${clamp('x', 'a', 'f')} ${clamp(2.5, 0.0, 1.0)} ${clamp(Reverse(5), Reverse(9), Reverse(1)).value}")

    // compareBy, reverseOrder, thenBy.
    val byAge = compareBy((p: Person) -> p.age)
    val byName = compareBy((p: Person) -> p.name)
    println(people.sortWith(byAge).map(p -> p.name))
    println(people.sortWith(reverseOrder(byAge)).map(p -> p.name))
    println(people.sortWith(thenBy(reverseOrder(byAge), byName)).map(p -> p.name))
    println(people.sortWith(thenBy(byAge, reverseOrder(byName))).map(p -> p.name))
    println(people.sortWith(reverseOrder(reverseOrder(byName))).map(p -> p.name))
    println(Vector[Person]().sortWith(thenBy(byAge, byName)))
    println(sign(byAge(people(0), people(2))))
    println(sign(thenBy(byAge, byName)(people(0), people(2))))

    // Many elements, to give the collector work.
    var big: Vector[ArraySeq[int]] = []
    for i in 0 ..< 300 do big = big :+ seq([i % 7, i % 5, i])
    val sorted = big.sortBy(v -> Reverse(v))
    println(s"${sorted(0)} ${sorted(299)}")
    val desc = big.sortWith(reverseOrder(compareBy((v: ArraySeq[int]) -> v)))
    println(s"${desc(0)} ${desc(299)}")
