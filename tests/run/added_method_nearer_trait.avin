// expect: exit 0

// Impls adding a method of one name and parameter types to a trait and to a trait requiring it: the
// nearer trait's is the type's wherever it applies, and the farther one's where only it does.
trait Shape
  area() -> int

trait Polygon: Shape
  sides() -> int

trait Square: Polygon

impl Shape
  describe() -> string = s"a shape of area ${area()}"
  tag(n: int) -> string = s"shape $n"

impl Polygon
  describe() -> string = s"a polygon of ${sides()} sides"

impl Square
  describe() -> string = "a square"

// Another parameter type overloads instead.
impl Polygon
  tag(s: string) -> string = s"polygon $s"

class Blob(): Shape
  override area() -> int = 3

class Tri(): Polygon
  override area() -> int = 6
  override sides() -> int = 3

class Box(): Square
  override area() -> int = 4
  override sides() -> int = 4

// Generic code sees the bound's trait, and calls what that trait has.
viaShape[T: Shape](x: T) -> string = x.describe()

viaPolygon(p: Polygon) -> string = p.describe()

main()
  println(Blob().describe())
  println(Tri().describe())
  println(Box().describe())
  val s: Shape = Tri()
  println(s.describe())
  println(viaPolygon(Box()))
  println(viaShape(Box()))
  println(Tri().tag(1), Tri().tag("x"))
  val shapes: Vector[Polygon] = [Tri(), Box()]
  println(shapes.map(p -> p.describe()))
