// expect: exit 0
// Methods overload by their parameter types as functions do: a call chooses the most specific method
// of its name that accepts its arguments, an integer literal preferring its own type, and the bare
// name inside the class chooses the same way. Each overload is a method of its own, so a subclass
// overrides one and inherits the others, adds one of its own, and a call through the superclass's
// type dispatches to the override of the overload it chose.

class Counter(var total: int)
    add(n: int) -> int
        total = total + n
        total
    add(s: string) -> int = add(10)
    add(a: int, b: int) -> int = add(a + b)
    scale(n: int) -> string = s"int $n"
    scale(n: long) -> string = s"long $n"
    scale(r: real) -> string = "real"

open class Shape(val name: string)
    describe(n: int) -> string = s"$name with $n"
    describe(s: string) -> string = s"$name named $s"
    describe() -> string = s"plain $name"

open class Circle(r: int): Shape("circle")
    override describe(n: int) -> string = s"circle of radius $r with $n"
    describe(flag: bool) -> string = if flag then "circle, yes" else "circle, no"

class Dot: Circle(0)
    override describe(s: string) -> string = s"dot named $s"
    override describe(flag: bool) -> string = "dot, either way"

trait Sink
    put(n: int) -> string
    put(s: string) -> string
    put(n: int, times: int) -> string = s"${put(n)} x$times"

class Logger: Sink
    override put(n: int) -> string = s"logged int $n"
    override put(s: string) -> string = s"logged string $s"

data Slot
    Filled(v: int)
    Empty

impl Sink for Slot
    put(n: int) -> string = self match
        Filled(v) -> s"slot $v takes $n"
        Empty -> s"empty slot takes $n"
    put(s: string) -> string = s"slot takes $s"

impl Slot
    size() -> int = self match
        Filled(_) -> 1
        Empty -> 0
    size(extra: int) -> int = size() + extra

object Format
    show(n: int) -> string = s"#$n"
    show(b: bool) -> string = if b then "on" else "off"
    show(n: int, width: int) -> string = s"#$n/$width"

class Box[T](val item: T)
    get() -> T = item
    pair(other: T) -> string = "pair of two"
    pair(n: int, other: T) -> string = s"pair after $n"

impl string
    twice() -> string = self + self
    twice(sep: string) -> string = self + sep + self

shapeLines(s: Shape)
    print(s.describe(7))
    print(s.describe("x"))
    print(s.describe())

circleLines(c: Circle)
    print(c.describe(true))
    print(c.describe(1))
    print(c.describe("y"))

send(s: Sink) -> string = s"${s.put(1)}; ${s.put("a")}; ${s.put(2, 3)}"

main()
    val c = Counter(0)
    print(c.add(2))
    print(c.add("four"))
    print(c.add(1, 2))
    print(c.scale(2))
    print(c.scale(3000000000))
    print(c.scale(0.5))

    shapeLines(Shape("square"))
    shapeLines(Circle(2))
    shapeLines(Dot())
    circleLines(Circle(3))
    circleLines(Dot())

    print(send(Logger()))
    print(send(Filled(5)))
    print(send(Empty))
    print(Filled(1).size(10))
    print(Empty.size())

    print(Format.show(3))
    print(Format.show(false))
    print(Format.show(3, 4))

    val b = Box("hat")
    print(b.pair("coat"))
    print(b.pair(2, "scarf"))
    val n = Box(5)
    print(n.pair(1, 2))
    print(n.get())

    print("ab".twice())
    print("ab".twice("-"))
