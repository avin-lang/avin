// expect: trap
// `withStepLimit(n)` allows each attempt `n` steps; an attempt that takes more traps, and the message
// gives the limit.
import avin.regex.Regex

main()
  val r = Regex("(\\w+\\s?)*$").withStepLimit(30)
  println(r.matches("one two"))
  println(Regex("(\\w+\\s?)*$").matches("one two three four five six seven eight nine ten"))
  println(r.matches("one two three four five six seven eight nine ten"))
