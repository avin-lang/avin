// expect: exit 2
// args: --file t.txt add -p urgent milk
// `parseOrExit` given a mistake in a command's own arguments: the program and the command's name,
// what was wrong, the command's usage line and where its help is go to standard error, and the
// program exits with 2.
import avin.cli

val add = cli.Parser("add", "Add a task.")
  .choice("priority", ["high", "normal", "low"], short = 'p', default = "normal")
  .positionals("words", required = true)

val parser = cli.Parser("todo", "Keep a to-do list.")
  .string("file", help = "the list", default = "todo.txt")
  .command(add)
  .command(cli.Parser("list", "List the tasks."))

main(args: Vector[string]) -> int
  val opts = parser.parseOrExit(args)
  println(s"not reached: ${opts.command}")
  0
