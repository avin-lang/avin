// expect: trap
// A file server's `Cache-Control` is a header's value, so it holds no line break: `no-cache` is
// taken, and a value holding `\n` traps where the server is made.
import avin.net.http.FileServer

main()
  println(FileServer("/srv", cacheControl = Some("no-cache")).cacheControl)
  println(FileServer("/srv", cacheControl = Some("max-age=1\nX-Evil: 1")).cacheControl)
