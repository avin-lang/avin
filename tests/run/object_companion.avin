// expect: exit 0
// An object named after a class of its module is its companion. In call position the name is the
// class's constructor; `Account.member` is the companion's member, and the bare name is the
// companion object. Each may use the other's private members.

class Account(owner: string, private var balance: int)
  private val id = Account.issue()

  describe() -> string = s"#$id $owner: $balance"

  // The class reaches the companion's private counter.
  issued() -> int = Account.next

object Account
  private var next = 0
  val bank = "First Avin"

  // A factory, and a method reading the class's private members.
  open(owner: string) -> Account = Account(owner, 0)
  rich(owner: string, amount: int) -> Account = Account(owner, amount)
  balanceOf(a: Account) -> int = a.balance
  credit(a: Account, amount: int) = a.balance += amount

  private issue() -> int
    next++
    next

main()
  val a = Account.open("ada")
  val b = Account("bob", 5)
  val c = Account.rich("cy", 100)
  Account.credit(a, 7)
  println(a.describe())
  println(b.describe())
  println(c.describe())
  println(s"${Account.balanceOf(a)} ${b.issued()} ${Account.bank}")
  val bank = Account
  println(bank.bank)
  // A generic function instantiated at the object's type and at the class's is two functions.
  println(same(Account).bank)
  println(same(b).describe())

same[T](x: T) -> T = x
