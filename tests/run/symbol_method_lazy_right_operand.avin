// expect: exit 0
// A companion object may declare an operator ending in `:` whose right operand is by name: `x op: r`
// on a value `r` of the companion's type calls the companion's `op:(x, r)`, evaluating `x` where it
// is written and passing `r` unevaluated, for a class and for a data type. Another type's own method
// of the same name still takes its receiver strictly, evaluated once at the call, after its left
// operand. Names starting with `#` bind at the level of the character after it (`#::` as `::`,
// `#+` as `+`, `#*` as `*`), and a name of `#` alone, `##`, binds tightest.

class Chain(val label: string, private val after: () -> Chain)
    next() -> Chain = after()

object Chain
    #::(label: string, rest: -> Chain) -> Chain = Chain(label, () -> rest)

class Bag(val items: Vector[int])
    #::(x: int) -> Bag = Bag(x +: items)

data Pair(a: int, b: int)

object Pair
    *:(x: int, p: -> Pair) -> Pair = Pair(x, x)

data V(n: int)

impl V
    ##(o: V) -> V = V(n * 10 + o.n)
    #+(o: V) -> V = V(n + o.n)
    #*(o: V) -> V = V(n * o.n)

var log = Vector[string]()

note(s: string) -> string
    log = log :+ s
    s

num(n: int) -> int
    log = log :+ s"num $n"
    n

bag(n: int) -> Bag
    log = log :+ s"bag $n"
    Bag(Vector(n))

pair() -> Pair
    log = log :+ "pair"
    Pair(0, 0)

endless(n: int) -> Chain = note(s"c$n") #:: endless(n + 1)

main() =
    // The class's companion: each `next()` evaluates one more step, and an endless chain returns.
    val c = endless(0)
    println(log)
    println(c.next().next().label)
    println(log)
    log = Vector()
    println(Chain.#::("dotted", endless(9)).label)
    println(log)
    // A type with a strict `#::` of its own: the left operand first, then the receiver, once each.
    log = Vector()
    val b = num(1) #:: num(2) #:: bag(9)
    println(b.items)
    println(log)
    // A data type's companion, its right operand never read.
    log = Vector()
    println(num(3) *: pair())
    println(log)
    // Levels of names starting with `#`.
    println(V(1) ## V(2) #+ V(3))
    println(V(1) #+ V(2) #* V(3))
    println(V(2) #* V(3) #+ V(1) ## V(4))
    println(V(1).##(V(2)))
