// expect: exit 0
// Large products: 100! and 1000! in full, their digit counts and sums, dividing a factorial back
// down, powers of two against shifting, Fibonacci numbers far past `long`, and a closure that
// captures a `BigInt` and accumulates into it.

factorial(n: int) -> BigInt
    var f = BigInt.one()
    for i in 2 .. n do f = f * BigInt(i)
    f

digitSum(x: BigInt) -> int
    var sum = 0
    for c in x.toString().chars do sum += int(c) - int('0')
    sum

main()
    val f100 = factorial(100)
    println(f100)
    println(f100.toString().byteLength)
    println(digitSum(f100))
    val f1000 = factorial(1000)
    println(f1000.toString().byteLength)
    println(digitSum(f1000))
    println(f1000.toString().slice(0, 30))
    println(f1000 / factorial(998))
    println(f1000 % factorial(999))
    println(f100 / f100)
    println(factorial(0))
    println(factorial(20).toLong)
    println(factorial(21).toLongOption)
    // 2^n by `pow` and by doubling.
    var doubled = BigInt.one()
    var same = true
    for n in 0 .. 300
        if BigInt(2).pow(n) != doubled then same = false
        doubled = doubled + doubled
    println(same)
    println(BigInt(2).pow(256))
    println(BigInt(-3).pow(41))
    println(BigInt(10).pow(30))
    println(BigInt(0).pow(0))
    println(BigInt(0).pow(5))
    println(BigInt(-1).pow(1000001))
    // The 300th Fibonacci number, and the identity F(2n) = F(n) * (2 F(n+1) - F(n)).
    var a = BigInt.zero()
    var b = BigInt.one()
    val fib = Buffer[BigInt]()
    for _ in 0 .. 300
        fib.addOne(a)
        val t = a + b
        a = b
        b = t
    println(fib(300))
    println(fib(300) == fib(150) * (BigInt(2) * fib(151) - fib(150)))
    // A closure capturing and updating a `BigInt`.
    var total = BigInt.zero()
    val add = (n: int) -> total = total + BigInt(n).pow(20)
    for i in 1 .. 10 do add(i)
    println(total)
