// expect: exit 0
// A trait may re-declare a method of a trait it requires without a body, marked `override`, giving it
// a narrower result: a call through the sub-trait yields the narrower type. The one implementation
// fills the method's single position in the table, so a call through either trait reaches it. A
// re-declaration without a body of a method that has a default makes it abstract again, so each
// implementer of the sub-trait gives its own. A generic method, a data type and a class implementing
// the sub-trait, a default of the sub-trait using the narrower result, and generic functions bounded
// by each trait are the neighbours.
trait Bag[K, +V]
    size() -> int
    updated[W >: V](key: K, value: W) -> Bag[K, W]
    removed(key: K) -> Bag[K, V]
    describe() -> string = s"a bag of ${size()}"

trait SortedBag[K, +V]: Bag[K, V]
    override updated[W >: V](key: K, value: W) -> SortedBag[K, W]
    override removed(key: K) -> SortedBag[K, V]
    override describe() -> string
    first() -> Option[K]
    firstAfter[W >: V](key: K, value: W) -> Option[K] = updated(key, value).first()

insert[V](entries: List[(int, V)], key: int, value: V) -> List[(int, V)] = entries match
    [] -> List((key, value))
    Cons(e, rest) ->
        if key < e.0 then Cons((key, value), entries)
        elif key == e.0 then Cons((key, value), rest)
        else Cons(e, insert(rest, key, value))

remove[V](entries: List[(int, V)], key: int) -> List[(int, V)] = entries match
    [] -> entries
    Cons(e, rest) -> if e.0 == key then rest else Cons(e, remove(rest, key))

data Row[+V](entries: List[(int, V)])

impl[V] SortedBag[int, V] for Row[V]
    size() -> int = entries.length()
    updated[W >: V](key: int, value: W) -> Row[W] = Row(insert(entries, key, value))
    removed(key: int) -> Row[V] = Row(remove(entries, key))
    describe() -> string = s"a row of ${size()}"
    first() -> Option[int] = entries.headOption().map(e -> e.0)

class Tree[V](entries: List[(int, V)]): SortedBag[int, V]
    override size() -> int = entries.length()
    override updated[W >: V](key: int, value: W) -> SortedBag[int, W] = Tree(insert(entries, key, value))
    override removed(key: int) -> Tree[V] = Tree(remove(entries, key))
    override describe() -> string = s"a tree of ${size()}"
    override first() -> Option[int] = entries.headOption().map(e -> e.0)

// A trait further down gives the re-declared method a body again, which its implementers inherit.
trait Labelled[+V]: SortedBag[int, V]
    override describe() -> string = s"labelled ${size()}"

data Single[+V](key: int, value: V)

impl[V] Labelled[V] for Single[V]
    size() -> int = 1
    updated[W >: V](key: int, value: W) -> Row[W] = Row(insert(List((self.key, self.value)), key, value))
    removed(key: int) -> Row[V] = Row(remove(List((self.key, self.value)), key))
    first() -> Option[int] = Some(self.key)

// Generic code bounded by each trait.
grown[B: Bag[int, string]](b: B) -> int = b.updated(9, "z").size()
smallest[B: SortedBag[int, string]](b: B) -> Option[int] = b.updated(0, "a").removed(5).first()

show(b: Bag[int, string]) -> string = s"${b.describe()} ${b.updated(4, "d").describe()}"

main()
    val row: SortedBag[int, string] = Row(List()).updated(5, "e").updated(2, "b")
    println(row.first())
    println(row.updated(1, "a").first())
    println(row.removed(2).first())
    println(row.firstAfter(0, "x"))
    val bag: Bag[int, string] = row
    println(bag.updated(7, "g").size())
    println(show(row))
    val tree: SortedBag[int, string] = Tree(List()).updated(8, "h").updated(3, "c")
    println(tree.first())
    println(tree.removed(3).updated(6, "f").first())
    println(show(tree))
    println(grown(row))
    println(grown(tree))
    println(smallest(row))
    println(smallest(tree))
    val direct = Row(List((1, "one")))
    println(direct.updated(0, "zero").first())
    println(Tree(List((4, "four"))).removed(4).size())
    val single: Bag[int, string] = Single(3, "c")
    println(show(single))
    println(grown(Single(3, "c")))
    println(smallest(Single(5, "e")))
