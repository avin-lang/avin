// An actor's start runs once, before any message, on the actor's own execution; `tell` returns at
// once, and the messages one sender tells one actor are handled in the order they were told, an
// actor's state kept in its start's locals from one message to the next.
import avin.actors.{ActorRef, Behaviour, spawn}
import avin.threads.{Channel, Promise}

data CounterMsg
  Increment(by: int)
  Get(reply: Promise[int])

counter(start: int, log: Channel[string]) -> Behaviour[CounterMsg] = Behaviour("Counter", me ->
  var count = start
  log.send(s"started at $count")
  m -> m match
    Increment(by) ->
      count += by
      log.send(s"now $count")
    Get(reply) -> reply.complete(count))

main()
  val log = Channel[string]()
  val c = spawn(counter(10, log))
  c.tell(Increment(5))
  c tell Increment(2)
  c.tell(Increment(-20))
  val p = Promise[int]()
  c.tell(Get(p))
  println(p.future.await())
  for _ in 0 ..< 4 do println(log.receive().get)
  println(log.tryReceive())
