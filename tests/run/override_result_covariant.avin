// expect: exit 0
// An override's or an implementation's result is a covariant position: it may yield any type that
// is seen as the declared result with no conversion. A tuple of subclasses is a tuple of their
// superclasses, part by part and nested; an instance of a covariant generic type is one at a wider
// argument; a function with a narrower result is one with the wider; a string or an object is its
// own `Any`. Calls through the base type and through the subtype both see the value whole.

open class Animal(val name: string)

class Dog(name: string): Animal(name)

trait Litter
    pair() -> (Animal, Animal)
    nested() -> ((Animal, int), string)

class Puppies: Litter
    override pair() -> (Dog, Dog) = (Dog("rex"), Dog("fido"))
    override nested() -> ((Dog, int), string) = ((Dog("é✓"), -1), "")

data Kennel(size: int)

impl Litter for Kennel
    pair() -> (Dog, Dog) = (Dog(s"k$size"), Dog("k"))
    nested() -> ((Dog, int), string) = ((Dog("n"), size), "kennel")

open class Base
    pair() -> (Animal, int) = (Animal("base"), 0)
    maybe() -> Option[Animal] = None
    maker() -> () -> Animal = () -> Animal("made")
    anything() -> Any = 0
    tupleAny() -> (Any, int) = ("base", 0)
    animals() -> Vector[(Animal, int)] = []
    maps() -> (Map[string, int], Map[string, int]) = (Map(), Map())

class Derived: Base
    override pair() -> (Dog, int) = (Dog("derived"), 1)
    override maybe() -> Option[Dog] = Some(Dog("some"))
    override maker() -> () -> Dog = () -> Dog("made dog")
    override anything() -> string = "any string"
    override tupleAny() -> ((int, int), int) = ((7, 8), 9)
    override animals() -> Vector[(Dog, int)] = [(Dog("v"), 3)]
    override maps() -> (HashMap[string, int], HashMap[string, int]) = (HashMap(("a", 1)), HashMap(("b", 2), ("c", 3)))

// A generic base whose result names its own parameter.
open class Box[T]
    both(x: T) -> (Option[T], int) = (None, 0)

class DogBox: Box[Animal]
    override both(x: Animal) -> (Option[Dog], int) = (Some(Dog(x.name)), 1)

describe(l: Litter) -> string
    val p = l.pair()
    val n = l.nested()
    s"${p.0.name} ${p.1.name} ${n.0.0.name} ${n.0.1} [${n.1}]"

main()
    println(describe(Puppies()))
    println(describe(Kennel(4)))
    val own = Puppies().pair()
    println(own.0.name, own.1.name)
    val b: Base = Derived()
    println(b.pair().0.name, b.pair().1)
    println(b.maybe().map((a) -> a.name))
    println(b.maker()().name)
    println(b.anything() match
        s: string -> s"string $s"
        _ -> "other")
    println(b.tupleAny().0 match
        t: (int, int) -> s"tuple ${t.0} ${t.1}"
        _ -> "other")
    println(b.animals().map((p) -> s"${p.0.name} ${p.1}"))
    val m = b.maps()
    println(m.0.size(), m.1.size(), m.1.get("c"))
    val d = Derived()
    println(d.pair().0.name, d.maybe().map((x) -> x.name))
    val plain: Base = Base()
    println(plain.pair().0.name, plain.maybe().map((a) -> a.name), plain.maps().0.size())
    val box: Box[Animal] = DogBox()
    println(box.both(Animal("boxed")).0.map((a) -> a.name), box.both(Dog("x")).1)
    // Kept across collections, so the garbage collector sees each tuple as the object it was made as.
    val all = Buffer.empty[(Animal, Animal)]()
    for i in 0..<200
        all.append(Puppies().pair())
    println(all.size(), all(199).1.name)
