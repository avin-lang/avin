// expect: trap
// A client made directly with its oldest version newer than its newest is made, and traps at its
// first connection, before the handshake begins.
import avin.net.{TcpListener, TcpStream}
import avin.net.tls.{Tls12, Tls13, TlsClient, TlsStream}

main()
  val listener = TcpListener.bind("127.0.0.1", 0).ok.get
  val tcp = TcpStream.connect("127.0.0.1", listener.port()).ok.get
  val accepted = listener.accept().ok.get
  val settings = TlsClient(minVersion = Tls13, maxVersion = Tls12)
  println(s"made: ${settings.minVersion} to ${settings.maxVersion}")
  _ = TlsStream.client(tcp, "localhost", settings)
  _ = accepted.close()
  println("not reached")
