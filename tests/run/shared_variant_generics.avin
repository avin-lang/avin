// expect: exit 0
// Generic data types sharing variant names, with and without fields, and with different field types
// under one name. The expected type decides the variant and then its type arguments are inferred as
// for any variant; nested patterns decide each inner name by its field's type.

data Tree[T]
    Leaf
    Node(left: Tree[T], value: T, right: Tree[T])

data Heap[T]
    Leaf
    Node(value: T, rest: Heap[T])

data Shape
    Circle(radius: int)
    Square(side: int)

data Mark
    Circle(label: string)
    Cross

size[T](t: Tree[T]) -> int = t match
    Leaf -> 0
    Node(l, _, r) -> size(l) + 1 + size(r)

total(h: Heap[int]) -> int = h match
    Leaf -> 0
    Node(v, rest) -> v + total(rest)

insert(t: Tree[int], x: int) -> Tree[int] = t match
    Leaf -> Node(Leaf, x, Leaf)
    Node(l, v, r) -> if x < v then Node(insert(l, x), v, r) else Node(l, v, insert(r, x))

area(s: Shape) -> int = s match
    Circle(r) -> 3 * r * r
    Square(a) -> a * a

label(m: Mark) -> string = m match
    Circle(text) -> text
    Cross -> "x"

// A pair of the two, each `Circle` in the pattern decided by its own field's type.
both(p: (Shape, Mark)) -> string = p match
    (Circle(r), Circle(text)) -> s"circle $r labelled $text"
    (Square(a), Circle(text)) -> s"square $a labelled $text"
    (_, Cross) -> "crossed"

firstLeafy(xs: Vector[Option[Tree[string]]]) -> int
    var n = 0
    for x in xs
        if x is Some(Leaf) then n += 1
    n

main()
    var t: Tree[int] = Leaf
    for x in [5, 2, 8, 1]
        t = insert(t, x)
    println(size(t))
    val h: Heap[int] = Node(3, Node(4, Leaf))
    println(total(h))
    println(total(Node(10, Leaf)))
    // Strings and longs: the type argument comes with the expected type.
    val ts: Tree[string] = Node(Leaf, "a", Leaf)
    println(size(ts))
    val hl: Heap[long] = Leaf
    println(hl)
    println(Heap.Node(1, Heap[int].Leaf))
    println(area(Circle(2)))
    println(area(Square(3)))
    println(label(Circle("ring")))
    println(both((Circle(1), Circle("a"))))
    println(both((Square(2), Circle("b"))))
    println(both((Circle(1), Cross)))
    // Inside an option, a pattern's expected type reaches the shared name through `Some`.
    println(firstLeafy([Some(Leaf), None, Some(Node(Leaf, "z", Leaf)), Some(Tree.Leaf)]))
    val o: Option[Mark] = Some(Circle("o"))
    println(o)
