// expect: exit 0
// A `select`'s receive arms: `Some(p)` runs for a value and binds it, `None` for the channel closed
// and drained, a name for either and binds the `Option` received, `_` or no pattern for either and
// binds nothing. `Some` takes any pattern a `val` takes: a tuple, a nested tuple, `_`. The select is
// an expression whose value is the body that ran, and the bodies' types are unified as a match's
// arms' are. Exactly one arm runs, and only it receives: the other channels keep their values.
import avin.threads.Channel

data Pair(left: string, right: int)

// The first value of `c` as text, or "closed"; a select as a function's whole body.
firstOf(c: Channel[string]) -> string = select
  c.receive() as Some(s) -> s"got $s"
  c.receive() as None -> "closed"

main() -> int
  val words = Channel[string]()
  words.send("héllo ✓")
  println(firstOf(words))
  words.send("")
  println(firstOf(words))
  words.close()
  println(firstOf(words))
  println(firstOf(words))

  // A name binds the `Option`, for a value and for the close alike.
  val opts = Channel[int]()
  opts.send(2147483647)
  val shown = select
    opts.receive() as o -> s"$o"
  println(shown)
  opts.close()
  val closedShown = select
    opts.receive() as o -> s"$o"
  println(closedShown)

  // `_` and no pattern bind nothing and run for either.
  val ticks = Channel[unit]()
  ticks.send(())
  select
    ticks.receive() as _ -> println("tick, ignored")
  ticks.send(())
  select
    ticks.receive() -> println("tick, no pattern")
  ticks.close()
  select
    ticks.receive() -> println("closed, no pattern")

  // `Some` with a tuple, a nested tuple, a data value and `_`.
  val pairs = Channel[(string, int)]()
  pairs.send(("a", -2147483648))
  select
    pairs.receive() as Some((s, n)) -> println(s"$s $n")
  val nested = Channel[((int, int), string)]()
  nested.send(((1, 2), "z"))
  select
    nested.receive() as Some(((a, b), z)) -> println(a + b, z)
  val pairsOf = Channel[Pair]()
  pairsOf.send(Pair("p", 9))
  select
    pairsOf.receive() as Some(Pair(l, r)) -> println(l, r)
  pairsOf.send(Pair("q", 1))
  select
    pairsOf.receive() as Some(_) -> println("a pair, unbound")
  println(pairsOf.tryReceive())

  // A channel of options: `Some(o)` binds the option sent, `None` sent is a value, not the close.
  val maybes = Channel[Option[int]]()
  maybes.send(None)
  maybes.send(Some(5))
  for i in 0 ..< 2
    select
      maybes.receive() as Some(o) -> println(s"value $o")
      maybes.receive() as None -> println("closed")
  maybes.close()
  select
    maybes.receive() as Some(o) -> println(s"value $o")
    maybes.receive() as None -> println("closed")

  // Only the arm that runs receives: the other channel keeps its value.
  val a = Channel[int]()
  val b = Channel[int]()
  a.send(1)
  val which = select
    a.receive() as Some(x) -> x
    b.receive() as Some(x) -> x + 100
  println(which, a.tryReceive(), b.tryReceive())
  b.send(2)
  b.send(3)
  val other = select
    a.receive() as Some(x) -> x
    b.receive() as Some(x) -> x + 100
  println(other, b.tryReceive(), b.tryReceive())

  // The bodies' types unify: an arm yielding `nothing` joins one yielding an int.
  a.send(4)
  val unified: int = select
    a.receive() as Some(x) -> x * 10
    a.receive() as None -> fail("not closed")
  println(unified)
  0
