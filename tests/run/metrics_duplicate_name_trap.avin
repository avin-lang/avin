// expect: trap
// A name is made once in a registry: the same name in another registry is taken, and making it again,
// as a family of another kind, traps.
import avin.metrics.Registry

main()
  val r = Registry()
  _ = r.counter("jobs_total", "Jobs.")
  _ = Registry().counter("jobs_total", "Jobs.")
  println(r.names)
  _ = r.gauge("jobs_total", "Jobs again.")
