// expect: exit 0
// Spec probes for declarations, class and Clauses, in combination: a generic class whose default is
// an earlier field and whose method has clauses and type parameters of its own, method values, a
// repeated constructor parameter after defaults, generic data defaults, clauses over nested options and
// the long boundary, overloads with defaults, and local functions called before their declaration.
class Box[T](val item: T, val backup: T = item)
    pair[U](other: U) -> (T, U) = (item, other)
    pick(n: int) -> T
    pick(0) = item
    pick(n)
        | n < 0 = backup
        | _ = item

class Counter(private var count: int = 0)
    bump(by: int = 1) -> int
        count += by
        count
    same(other: Counter) -> bool = count == other.count

class Framed(left: string = "[", right: string = "]", items: int*)
    show() -> string = left + items.mkString(",") + right

data Range[T](low: T, high: T = low)

depth(o: Option[Option[int]]) -> int
depth(None) = 0
depth(Some(None)) = 1
depth(Some(Some(n))) = 2 + n

sign(n: long) -> string
sign(n) | n == -9223372036854775808 = "min"
sign(n < 0) = "neg"
sign(0) = "zero"
sign(_) = "pos"

measure(n: int, scale: int = 2) -> string = s"int ${n * scale}"
measure(s: string, scale: int = 3) -> string = s"string ${s.byteLength * scale}"

apply2[A, B](f: (A) -> B, x: A) -> B = f(x)

main()
    val b = Box("a")
    println(s"${b.pair(1)} ${b.pick(0)} ${b.pick(-1)}")
    val bb = Box(1, 2)
    val pf = bb.pair[bool]
    println(s"${pf(true)} ${bb.pick(-5)}")
    val c = Counter()
    val bump = c.bump
    println(s"${bump(2)} ${c.bump()} ${c.bump(by = 4)} ${c.same(Counter(7))}")
    println(Framed().show() + Framed("<", ">", 1, 2).show() + Framed(right = ")").show())
    val r = Range(low = 3)
    val rs = Range("a", "z")
    println(s"${r.low} ${r.high} ${rs.high}")
    println(s"${depth(None)} ${depth(Some(None))} ${depth(Some(Some(5)))}")
    println(s"${sign(-9223372036854775808)} ${sign(-1)} ${sign(0)} ${sign(9223372036854775807)}")
    println(s"${measure(4)} ${measure("ab")} ${measure(scale = 10, n = 1)} ${measure("x", scale = 1)}")
    var total = 0
    add(n: int)
        total += n
    val adder = add
    for i in 1..4 do adder(i)
    println(s"$total ${early()}")
    early() -> int = total * 2
    fact(n: long) -> long
    fact(0) = 1
    fact(n) = n * fact(n - 1)
    println(s"${fact(20)}")
    val made = [1, 2, 3].map(Counter)
    println(s"${made.map(k -> k.bump()).mkString(" ")}")
    println(apply2((s: string) -> Box(s).backup, "q"))
