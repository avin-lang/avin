#!/usr/bin/env -S avin run
// avin.hocon
// dependencies {
//   greeting { path = "../packages/greeting" }
// }

// expect: exit 0
// A `#!` line comes first and the dependencies header second, so the file runs as a command.

import greeting.greet

main(args: Vector[string])
    println(greet(s"${args.size} arguments"))
