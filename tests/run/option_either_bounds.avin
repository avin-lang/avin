// expect: exit 0
// Option's, Either's and Result's methods that take a value in take it as a type with the held one
// as its lower bound, so a wider value widens the result: `getOrElse`, `orElse`, `contains`, `zip`,
// Either's `flatMap` and `filterOrElse`, and Result's `flatMap` and `orElse`.

trait Animal
    name() -> string

class Cat : Animal
    override name() -> string = "cat"

class Dog : Animal
    override name() -> string = "dog"

describe(a: Animal) -> string = a.name()

main()
    val cat: Option[Cat] = Some(Cat())
    val noCat: Option[Cat] = None
    val dog = Dog()
    val animal: Animal = dog

    // Option: a `Dog` default on an `Option[Cat]` is an `Animal`.
    val fromNone = noCat.getOrElse(dog)
    val fromSome = cat.getOrElse(dog)
    println(s"${describe(fromNone)} ${describe(fromSome)}")
    val either: Option[Animal] = noCat.orElse(Some(dog))
    println(s"${either.map(describe)} ${cat.orElse(Some(dog)).map(describe)}")
    println(s"${noCat.contains(animal)} ${cat.contains(animal)}")
    val sameCat = Cat()
    val heldCat: Option[Cat] = Some(sameCat)
    val asAnimal: Animal = sameCat
    println(heldCat.contains(asAnimal))
    val pair = cat.zip(Some(1))
    println(pair.map(p -> describe(p.0)))

    // Value types keep their own type: the bound admits only itself.
    val ints: Option[int] = Some(3)
    val noInts: Option[int] = None
    println(s"${ints.getOrElse(4)} ${noInts.getOrElse(4)} ${ints.contains(3)} ${noInts.orElse(Some(9))}")
    println(s"${ints.zip(Some("z"))} ${noInts.zip(Some("z"))}")

    // Either: each side widens on its own.
    val right: Either[string, Cat] = Right(Cat())
    val left: Either[string, Cat] = Left("no")
    println(s"${describe(left.getOrElse(dog))} ${describe(right.getOrElse(dog))}")
    val widened: Either[string, Animal] = left.orElse(Right(dog))
    println(widened.map(describe))
    println(s"${left.contains(animal)} ${right.contains(animal)}")
    val catLeft: Either[Cat, int] = Right(5)
    val small: Either[Animal, int] = catLeft.filterOrElse(n -> n < 3, dog)
    println(small.swap.map(describe))
    val chained: Either[Animal, string] = catLeft.flatMap(n -> if n > 3 then Left(dog) else Right("small"))
    println(chained.swap.map(describe))

    // Result: the value's side and the error's.
    val failed: Result[Cat, string] = Err("bad")
    val worked: Result[Cat, string] = Ok(Cat())
    println(s"${describe(failed.getOrElse(dog))} ${describe(worked.getOrElse(dog))}")
    val recovered: Result[Animal, int] = failed.orElse(e -> Ok(dog))
    println(recovered.map(describe))
    val catErr: Result[int, Cat] = Ok(2)
    val next: Result[int, Animal] = catErr.flatMap(n -> Err(dog))
    println(next.mapErr(describe))
