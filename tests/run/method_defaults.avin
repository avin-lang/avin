// A method's default may use the parameters before it and the receiver: `self` and its members by
// bare name. It is computed at each call that omits the argument, after the written arguments.
class Account(owner: string, var balance: int = 0)
  val fee = 2
  deposit(amount: int, times: int = 1, note: string = s"$owner x$times") -> string
    balance += amount * times
    s"$note -> $balance"
  withdraw(amount: int = balance - fee) -> int
    balance -= amount
    balance
  describe(prefix: string = self.owner) -> string = s"$prefix has $balance"

// A constructor's default may use the class's parameters before it.
class Box(width: int, height: int = width, val label: string = s"${width}x$height")
  area() -> int = width * height

// A generic class's constructor default, of the class's type parameter.
class Holder[T](first: T, second: T = first)
  both() -> (T, T) = (first, second)

var counter = 0

tick() -> int
  counter += 1
  counter

class Logger(name: string)
  log(message: string, level: int = tick()) -> string = s"$name[$level] $message"

// A method's default may call another method of the same object.
class Scale(factor: int)
  unit() -> int = factor * 10
  apply(x: int, by: int = unit()) -> int = x * by

main()
  val a = Account("ann")
  println(s"${a.balance}")
  println(a.deposit(10))
  println(a.deposit(5, 3))
  println(a.deposit(1, note = "named"))
  println(a.deposit(times = 2, amount = 4))
  println(s"${a.withdraw(1)} ${a.withdraw()}")
  println(a.describe())
  println(a.describe("someone"))
  val b = Account("bob", 100)
  println(s"${b.balance}")
  val c = Account(balance = 7, owner = "cy")
  println(c.describe())
  val square = Box(3)
  println(s"${square.area()} ${square.label}")
  val wide = Box(2, 5)
  println(wide.label)
  val named = Box(4, label = "four")
  println(named.label)
  val (x, y) = Holder(1).both()
  println(s"$x $y")
  val (p, q) = Holder("x", "y").both()
  println(s"$p $q")
  val log = Logger("app")
  println(log.log("start"))
  println(log.log("again"))
  println(log.log("fixed", 9))
  println(s"${Scale(3).apply(2)} ${Scale(3).apply(2, 1)}")
