// expect: exit 0
// A selector's wait is a cancellation point as a select's is: a scope's `cancel` stops a thread parked
// in `wait` or in a long `within` with a send entry waiting for room, and nothing after the wait
// runs. Nothing of the cancelled waits stays on the channels: values sent afterwards go to the next
// thread waiting, and the send that waited sent nothing.
import avin.threads.{Atomic, Channel, Selector, scope, sleep, spawn}
import avin.time.{hours, millis}

main() -> int
  val started = Atomic(0)
  val after = Atomic(0)
  val a = Channel[int]()
  val b = Channel[int]()
  val full = Channel[int](1)
  full.send(0)
  val results = scope(s ->
    val waiting = s.spawn(() ->
      val sel = Selector[int]()
      sel.receive(a, 0)
      sel.receive(b, 1)
      started.add(1)
      println(sel.wait())
      after.add(1))
    val timed = s.spawn(() ->
      val sel = Selector[int]()
      sel.receive(a, 0)
      sel.send(full, 7, 1)
      started.add(1)
      println(sel.within(hours(1)))
      after.add(1))
    while started.load() < 2 do sleep(1.millis)
    sleep(20.millis)
    s.cancel()
    [waiting, timed])
  println(results.map(t -> t.result()), after.load())

  val plain = spawn(() -> a.receive())
  val other = spawn(() ->
    val sel = Selector[string]()
    val fromB = sel.receive(b, "b")
    sel.wait()
    fromB.received())
  sleep(10.millis)
  a.send(1)
  b.send(2)
  println(plain.join(), other.join())
  println(full.receive(), full.tryReceive())
  0
