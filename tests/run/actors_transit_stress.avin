// expect: exit 0
// Many connections cross many actors at once: each message holds two of them beside the reference
// of the actor to pass them to, every actor hands them on once before one reads them, and all of it
// runs on four workers while main keeps sending. Every line arrives, read by whichever actor holds
// the connections at the end.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.actors.{ActorRef, spawn}
import avin.threads.{Channel, Executor}

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message)

data Pass(conns: Vector[TcpStream], hops: int, next: Vector[ActorRef[Pass]], out: Channel[string])

actor Relay(index: int) receives Pass
    receive
        Pass(conns, hops, next, out) ->
            if hops == 0
                var text = ""
                for c in conns do text = text + ok(c.readLine()).getOrElse("end") + " "
                out.send(text)
            else
                next((index + hops) % next.size) tell Pass(conns, hops - 1, next, out)

main()
    val ex = Executor.fixed(4)
    val l = ok(TcpListener.bind("127.0.0.1", 0))
    val relays = (0..<6).map(i -> spawn(Relay(i), executor = ex)).toVector
    val out = Channel[string](16)
    val jobs = 12
    for j in 0..<jobs
        var pair: Vector[TcpStream] = Vector()
        for k in 0..<2
            val far = ok(TcpStream.connect("127.0.0.1", l.port()))
            val near = ok(l.accept())
            ok(far.writeText(s"j${j}k$k\n"))
            pair = pair :+ near
        relays(j % 6) tell Pass(pair, 1 + j % 3, relays, out)
    var lines: Vector[string] = Vector()
    for _ in 0..<jobs do lines = lines :+ out.receive().get()
    println(lines.sorted().mkString("|"))
    ex.shutdown()
