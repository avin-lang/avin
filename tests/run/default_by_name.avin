// expect: exit 0
// The default of a by-name parameter is a delayed expression like any argument to it: evaluated at
// each read, never at the call, and not at all when the parameter is not read. A named argument to a
// by-name parameter is delayed too, though the arguments around it are held in the order written.

shown(tag: string, value: int) -> int
    print(s"$tag=$value")
    value

maybe(flag: bool, value: -> int = shown("default", 0)) -> int = if flag then value else -1

// A default may read an earlier by-name parameter, which evaluates that argument again.
both(x: -> int, y: -> int = x + 1) -> int = x + y

chosen[T](flag: bool, yes: -> T, no: -> T = yes) -> T = if flag then yes else no

main()
    print(s"${maybe(false)}")
    print(s"${maybe(true)}")
    print(s"${maybe(value = shown("named", 5), flag = false)}")
    print(s"${maybe(value = shown("named", 5), flag = true)}")
    print(s"${both(shown("x", 1))}")
    print(chosen(false, yes = "yes"))
    print(chosen(no = "no", flag = false, yes = "yes"))

    // A local function's by-name default captures what is in scope where it is declared, and runs
    // at each read.
    var reads = 0
    counted() -> int
        reads += 1
        reads
    twice(value: -> int = counted()) -> int = value + value
    print(s"${twice()} $reads")
    print(s"${twice(value = 10)} $reads")
