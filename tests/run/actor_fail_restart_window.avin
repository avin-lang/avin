// expect: trap
// A `Restart` whose window is not more than zero is refused where the actor is spawned: a window of
// one microsecond is the shortest there is.
import avin.actors.{Restart, spawn}
import avin.time

actor Idle receives int
    receive
        _ -> ()

main()
    val ok = spawn(Idle(), onFailure = Restart(5, time.microseconds(1)))
    println(ok)
    spawn(Idle(), onFailure = Restart(5, time.zero()))
    println("not reached")
