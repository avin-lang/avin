// expect: exit 0
// Tuples are `Display`, `Debug` and `Ord` where their parts are, at every arity a program writes:
// printed and interpolated as `(a, b)`, debugged with each part's literal form, padded whole, and
// ordered part by part.

data Point(x: int, y: int)

// A data type with a tuple field has `Display` without asking, through the tuple's.
data Labelled(label: string, at: (int, int))

data Rank derives Ord
    Low
    High

smallest[T: Ord](a: T, b: T) -> T = if a <= b then a else b

shown[T: Display](value: T) -> string = value.toString()

padded[T: Display](value: T, width: int, left: bool) -> string
    val out = StringWriter()
    value.display(out, FormatSpec(width = width, left = left))
    out.text()

main()
    print((1, "one"))
    print((1, 2.5, 'c', true, ()))
    print(((1, 2), ("a", (3, 4))))
    print(s"at ${(3, 4)} and ${shown((Point(1, 2), "p"))}")
    print(Labelled("origin", (0, 0)))
    print(debug((1, "one", 'c')))
    print(debug(("quote \" inside", ('\n', 7))))
    print("[" + padded((1, 2), 10, false) + "]")
    print("[" + padded((1, 2), 10, true) + "]")
    print(padded((1, 2), 2, false))

    // Part by part: the first part that differs decides.
    print((1, 2) < (1, 3))
    print((1, 9) < (2, 0))
    print((2, "b") <= (2, "b"))
    print(("b", 1) > ("a", 9))
    print((1, 2, 3) >= (1, 2, 4))
    print((1, 2).compare((1, 2)))
    print(("a", 'z').compare(("b", 'a')))
    print(smallest((3, "c"), (3, "a")))
    print(smallest((High, 1), (Low, 2)))
    print(((1, 2), 3) < ((1, 3), 0))

    // Sorting and the extremes go through `Ord`.
    print([(2, "b"), (1, "z"), (2, "a"), (1, "a")].sorted())
    print(max((1, 'a'), (1, 'b'), (0, 'z')))
    print(min((1, 'a'), (1, 'b'), (0, 'z')))

    // A tuple written only inside an interpolation hole, and a wider one.
    print(s"${(1, 2, 3, 4, 5, 6)}")
    val wide = (1, 2, 3, 4, 5, 6, 7)
    print(wide < (1, 2, 3, 4, 5, 6, 8))
    assertEq((1, "a"), (1, "a"))
