// expect: exit 0
// An adapter's function runs where the message is sent, so a trap in it is the sender's: an actor
// that sends to an adapter whose function traps fails, and the adapting actor goes on, never having
// seen the message. A `pipeToSelf` function and a watch's function run in the actor that asked for
// them, when it takes the message, so a trap in one fails that actor, not the code that completed
// the future or the actor whose end was watched.
import avin.actors.{ActorRef, Failed, Stop, spawn}
import avin.threads.{Channel, Future, Promise}
import avin.time

data Reply
  Number(n: int)
  Text(s: string)

actor Adapting(log: Channel[string], refs: Channel[ActorRef[string]]) receives Reply
  refs.send(adapter(s -> Number(s.toInt())))
  receive
    Number(n) -> log.send(s"number $n")
    Text(s) -> log.send(s"text $s")

actor Sender(to: ActorRef[string]) receives string
  receive
    s -> to.tell(s)

data Piped
  Value(n: int)
  Watched(e: string)

actor Piper(f: Future[int], log: Channel[string]) receives Piped
  pipeToSelf(f, n -> Value(100 / n))
  log.send("piping")
  receive
    Value(n) -> log.send(s"value $n")
    Watched(e) -> log.send(e)

actor Quitter receives int
  receive
    _ -> stop()

actor Watching(target: ActorRef[int], log: Channel[string]) receives Piped
  watch(target, e -> Watched(s"${Vector(1)(if e is Failed(_) then 0 else 5)}"))
  log.send("watching")
  receive
    Value(n) -> log.send(s"value $n")
    Watched(e) -> log.send(e)

main()
  val log = Channel[string]()
  val refs = Channel[ActorRef[string]]()
  val a = spawn(Adapting(log, refs), onFailure = Stop)
  val ad = refs.receive().get
  ad.tell("12")
  println(log.receive().get)
  val s = spawn(Sender(ad), onFailure = Stop)
  s.tell("x")
  println(s.ended().await())
  s.tell("13")
  ad.tell("14")
  println(log.receive().get)
  println(a.ended().isCompleted())
  // A pipe from a future a promise completes on this thread: the trap is the piping actor's.
  val p = Promise[int]()
  val piper = spawn(Piper(p.future, log), onFailure = Stop)
  println(log.receive().get)
  p.complete(0)
  println("completed")
  println(piper.ended().await())
  // A pipe of a future complete already runs its function in the actor's own body.
  val done = spawn(Piper(Future.successful(0), log), onFailure = Stop)
  println(done.ended().await())
  // A watch whose function traps fails the watcher; the watched actor ended as it would have.
  val q = spawn(Quitter())
  val w = spawn(Watching(q, log), onFailure = Stop)
  println(log.receive().get)
  q.tell(0)
  println(q.ended().await())
  println(w.ended().await())
