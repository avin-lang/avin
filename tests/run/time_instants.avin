// expect: exit 0
// `avin.time`'s instants: the epoch makers and their counts back (rounded toward negative infinity),
// the companion's bounds and their text, ISO 8601 text with the fraction only where there is one and
// years outside 0 to 9999 signed, arithmetic along the timeline, order, and the wall clock.
import avin.time.{Duration, Instant, now, epochSeconds, epochMillis, epochMicros, micros, millis, seconds, hours, days}

main()
    // The makers.
    println(epochSeconds(0))
    println(epochSeconds(0) == Instant.Epoch)
    println(epochMicros(0) == Instant(0))
    println(epochMillis(1000).epochSeconds)
    println(epochMillis(-1).epochSeconds)
    println(epochMicros(-1).epochMillis)
    println(epochMicros(-1000).epochMillis)
    println(epochMicros(-1001).epochMillis)
    println(epochMicros(1999).epochMillis)
    println(epochMicros(1000000001))
    println(epochMicros(1000000001).epochMicros)
    println(epochSeconds(-1).epochSeconds)
    println(epochSeconds(1793795696).epochMillis)

    // Round trips at the extremes.
    println(epochMicros(Instant.Max.epochMicros) == Instant.Max)
    println(epochMicros(Instant.Min.epochMicros) == Instant.Min)
    println(Instant.Max.epochSeconds)
    println(Instant.Min.epochSeconds)
    println(Instant.Max.epochMillis)
    println(Instant.Min.epochMillis)
    println(epochSeconds(Instant.Max.epochSeconds) <= Instant.Max)
    println(epochSeconds(Instant.Min.epochSeconds + 1) > Instant.Min)
    println(epochMillis(Instant.Max.epochMillis).epochMillis == Instant.Max.epochMillis)
    println(epochSeconds(9223372036854) == epochMillis(9223372036854000))

    // Text.
    println(Instant.Min)
    println(Instant.Max)
    println(Instant.Epoch)
    println(epochMillis(-1))
    println(epochMicros(1))
    println(epochMillis(500))
    println(epochMicros(250000))
    println(epochSeconds(951782400))
    println(epochSeconds(1793795696))
    println(epochSeconds(-86400 * 365))
    println(epochSeconds(1772548200) + millis(500))
    // The year boundaries: 0000, -0001, 9999 and +10000.
    println(epochSeconds(-62167219200))
    println(epochSeconds(-62167219201))
    println(epochSeconds(253402300799))
    println(epochSeconds(253402300800))
    println(debug(Instant.Epoch))

    // Arithmetic along the timeline.
    val t = Instant.Epoch + days(365) + hours(1) + seconds(2) + micros(45)
    println(t)
    println(t - Instant.Epoch)
    println(Instant.Epoch - t)
    println(t - days(365) - t)
    println(t - seconds(2) + seconds(2) == t)
    println(Instant.Max - Instant.Epoch == Duration.Max)
    println(Instant.Epoch - Instant.Max == -Duration.Max)
    println(Instant.Min + Duration.Max)
    var w = Instant.Epoch
    w += hours(1)
    w -= seconds(1)
    println(w)

    // Order.
    println(Instant.Min < epochMicros(-1) < Instant.Epoch < epochMicros(1) < Instant.Max)
    println(epochSeconds(2).compare(epochSeconds(1)))
    println(max(epochSeconds(1), epochSeconds(2)) == epochSeconds(2))
    println([epochSeconds(3), Instant.Epoch, epochSeconds(-3)].sorted)

    // The wall clock reads after 2020 and is an ordinary instant.
    val stamp = now()
    println(stamp > epochSeconds(1577836800))
    println(stamp - stamp == Duration.Zero)
    println(now() - stamp < hours(1))
