// Searching a string for an offset, -1 when there is none, and reading a number, which answers with
// an `Option` from the `toXOption` forms. Offsets count bytes; `é` takes two bytes, each of `日本` three, and `😀` four.

show(o: Option[int]) -> string = o match
  Some(n) -> s"$n"
  None -> "-"

showAt(at: int) -> string = if at < 0 then "-" else s"$at"

showLong(o: Option[long]) -> string = o match
  Some(n) -> s"$n"
  None -> "-"

showReal(o: Option[real]) -> string = o match
  Some(x) -> s"$x"
  None -> "-"

// The sum of two numbers read from strings, or None if either is not a number: `?` passes the
// refusal on.
sumOf(a: string, b: string) -> Option[int]
  val x = a.toIntOption()?
  val y = b.toIntOption()?
  Some(x + y)

main()
  val word = "café au café"
  val wide = "日本😀日本"
  // The first occurrence, with and without a starting offset.
  println(
    s"${showAt(word.indexOf("caf"))} ${showAt(word.indexOf("é"))} ${showAt(word.indexOf("z"))} ${showAt(word.indexOf("café au café!"))}"
  )
  println(
    s"${showAt(word.indexOf("caf", 1))} ${showAt(word.indexOf("caf", 8))} ${showAt(word.indexOf("caf", 9))} ${showAt(word.indexOf("caf", -4))}"
  )
  println(
    s"${showAt(wide.indexOf("😀"))} ${showAt(wide.indexOf("本"))} ${showAt(wide.indexOf("本", 4))} ${showAt(wide.indexOf("日", 1))}"
  )
  // An empty needle is found where the search starts, and at the end of the string.
  println(
    s"${showAt(word.indexOf(""))} ${showAt(word.indexOf("", 5))} ${showAt(word.indexOf("", word.byteLength))} ${showAt(word.indexOf("", 99))} ${showAt("".indexOf(""))}"
  )
  // The last occurrence.
  println(
    s"${showAt(word.lastIndexOf("caf"))} ${showAt(word.lastIndexOf("é"))} ${showAt(word.lastIndexOf("z"))} ${showAt(word.lastIndexOf("c"))}"
  )
  println(
    s"${showAt(wide.lastIndexOf("日"))} ${showAt(wide.lastIndexOf("本😀"))} ${showAt("aaa".lastIndexOf("aa"))} ${showAt("ab".lastIndexOf("abc"))}"
  )
  println(s"${showAt(word.lastIndexOf(""))} ${showAt("".lastIndexOf(""))} ${showAt("".lastIndexOf("a"))}")
  // The last occurrence beginning at or before an offset, which may be past the end.
  println(
    s"${showAt(word.lastIndexOf("caf", 8))} ${showAt(word.lastIndexOf("caf", 7))} ${showAt(word.lastIndexOf("caf", 99))} ${showAt(word.lastIndexOf("caf", -1))} ${showAt(wide.lastIndexOf("日", 9))}"
  )
  // A found offset slices the string back out.
  val at = word.indexOf("au")
  println(s"[${word.slice(0, at)}] [${word.slice(at, word.byteLength)}]")
  // Whole numbers: an optional sign, then decimal digits and nothing else.
  println(
    s"${show("42".toIntOption())} ${show("-7".toIntOption())} ${show("+3".toIntOption())} ${show("007".toIntOption())} ${show("-0".toIntOption())}"
  )
  println(
    s"${show("".toIntOption())} ${show("-".toIntOption())} ${show("+".toIntOption())} ${show("12a".toIntOption())} ${show(" 1".toIntOption())} ${show("1 ".toIntOption())} ${show("1_0".toIntOption())} ${show("--1".toIntOption())} ${show("١٢".toIntOption())}"
  )
  // An int holds -2147483648 to 2147483647.
  println(
    s"${show("2147483647".toIntOption())} ${show("2147483648".toIntOption())} ${show("-2147483648".toIntOption())} ${show("-2147483649".toIntOption())} ${show("99999999999999999999".toIntOption())}"
  )
  // A long holds -9223372036854775808 to 9223372036854775807.
  println(s"${showLong("9223372036854775807".toLongOption())} ${showLong("9223372036854775808".toLongOption())}")
  println(s"${showLong("-9223372036854775808".toLongOption())} ${showLong("-9223372036854775809".toLongOption())}")
  println(
    s"${showLong("2147483648".toLongOption())} ${showLong("+9223372036854775807".toLongOption())} ${showLong("000000000000000000000000012".toLongOption())} ${showLong("99999999999999999999".toLongOption())} ${showLong("-99999999999999999999".toLongOption())} ${showLong("".toLongOption())} ${showLong("9x".toLongOption())}"
  )
  // Real numbers.
  println(
    s"${showReal("3.25".toRealOption())} ${showReal("-0.5".toRealOption())} ${showReal("1e10".toRealOption())} ${showReal("2.5E-3".toRealOption())} ${showReal("7".toRealOption())} ${showReal("0.1".toRealOption())}"
  )
  println(
    s"${showReal("".toRealOption())} ${showReal("abc".toRealOption())} ${showReal("1.5x".toRealOption())} ${showReal("1e999".toRealOption())} ${showReal("nan".toRealOption())} ${showReal("inf".toRealOption())} ${showReal("-infinity".toRealOption())} ${showReal(" 1".toRealOption())} ${showReal("1 ".toRealOption())} ${showReal("\n1".toRealOption())} ${showReal("0x10".toRealOption())} ${showReal("+.5".toRealOption())} ${showReal("1.".toRealOption())}"
  )
  // `?` and getOrElse.
  println(
    s"${show(sumOf("20", "22"))} ${show(sumOf("20", "x"))} ${show(sumOf("y", "22"))} ${show(sumOf("2147483648", "1"))}"
  )
  println(
    s"${"12".toIntOption().getOrElse(0) + "x".toIntOption().getOrElse(100)} ${"2.5".toRealOption().getOrElse(0.0) * 2.0} ${"?".toLongOption().isEmpty} ${"5".toLongOption().isDefined}"
  )
