// The string methods that answer with an `Option`: searching for an offset and reading a number.
// Offsets count bytes; `é` takes two bytes, each of `日本` three, and `😀` four.

show(o: Option[int]) -> string = o match
    Some(n) -> s"$n"
    None -> "-"

showLong(o: Option[long]) -> string = o match
    Some(n) -> s"$n"
    None -> "-"

showReal(o: Option[real]) -> string = o match
    Some(x) -> s"$x"
    None -> "-"

// The sum of two numbers read from strings, or None if either is not a number: `?` passes the
// refusal on.
sumOf(a: string, b: string) -> Option[int]
    val x = a.toInt()?
    val y = b.toInt()?
    Some(x + y)

main()
    val word = "café au café"
    val wide = "日本😀日本"
    // The first occurrence, with and without a starting offset.
    print(s"${show(word.indexOf("caf"))} ${show(word.indexOf("é"))} ${show(word.indexOf("z"))} ${show(word.indexOf("café au café!"))}")
    print(s"${show(word.indexOf("caf", 1))} ${show(word.indexOf("caf", 8))} ${show(word.indexOf("caf", 9))} ${show(word.indexOf("caf", -4))}")
    print(s"${show(wide.indexOf("😀"))} ${show(wide.indexOf("本"))} ${show(wide.indexOf("本", 4))} ${show(wide.indexOf("日", 1))}")
    // An empty needle is found where the search starts, and at the end of the string.
    print(s"${show(word.indexOf(""))} ${show(word.indexOf("", 5))} ${show(word.indexOf("", word.byteLength()))} ${show(word.indexOf("", 99))} ${show("".indexOf(""))}")
    // The last occurrence.
    print(s"${show(word.lastIndexOf("caf"))} ${show(word.lastIndexOf("é"))} ${show(word.lastIndexOf("z"))} ${show(word.lastIndexOf("c"))}")
    print(s"${show(wide.lastIndexOf("日"))} ${show(wide.lastIndexOf("本😀"))} ${show("aaa".lastIndexOf("aa"))} ${show("ab".lastIndexOf("abc"))}")
    print(s"${show(word.lastIndexOf(""))} ${show("".lastIndexOf(""))} ${show("".lastIndexOf("a"))}")
    // A found offset slices the string back out.
    val at = word.indexOf("au").getOrElse(0)
    print(s"[${word.slice(0, at)}] [${word.slice(at, word.byteLength())}]")
    // Whole numbers: an optional sign, then decimal digits and nothing else.
    print(s"${show("42".toInt())} ${show("-7".toInt())} ${show("+3".toInt())} ${show("007".toInt())} ${show("-0".toInt())}")
    print(s"${show("".toInt())} ${show("-".toInt())} ${show("+".toInt())} ${show("12a".toInt())} ${show(" 1".toInt())} ${show("1 ".toInt())} ${show("1_0".toInt())} ${show("--1".toInt())} ${show("١٢".toInt())}")
    // An int holds -2147483648 to 2147483647.
    print(s"${show("2147483647".toInt())} ${show("2147483648".toInt())} ${show("-2147483648".toInt())} ${show("-2147483649".toInt())} ${show("99999999999999999999".toInt())}")
    // A long holds -9223372036854775808 to 9223372036854775807.
    print(s"${showLong("9223372036854775807".toLong())} ${showLong("9223372036854775808".toLong())}")
    print(s"${showLong("-9223372036854775808".toLong())} ${showLong("-9223372036854775809".toLong())}")
    print(s"${showLong("2147483648".toLong())} ${showLong("+9223372036854775807".toLong())} ${showLong("000000000000000000000000012".toLong())} ${showLong("99999999999999999999".toLong())} ${showLong("-99999999999999999999".toLong())} ${showLong("".toLong())} ${showLong("9x".toLong())}")
    // Real numbers.
    print(s"${showReal("3.25".toReal())} ${showReal("-0.5".toReal())} ${showReal("1e10".toReal())} ${showReal("2.5E-3".toReal())} ${showReal("7".toReal())} ${showReal("0.1".toReal())}")
    print(s"${showReal("".toReal())} ${showReal("abc".toReal())} ${showReal("1.5x".toReal())} ${showReal("1e999".toReal())} ${showReal("nan".toReal())} ${showReal("inf".toReal())} ${showReal("-infinity".toReal())} ${showReal(" 1".toReal())} ${showReal("1 ".toReal())} ${showReal("\n1".toReal())} ${showReal("0x10".toReal())} ${showReal("+.5".toReal())} ${showReal("1.".toReal())}")
    // `?` and getOrElse.
    print(s"${show(sumOf("20", "22"))} ${show(sumOf("20", "x"))} ${show(sumOf("y", "22"))} ${show(sumOf("2147483648", "1"))}")
    print(s"${"12".toInt().getOrElse(0) + "x".toInt().getOrElse(100)} ${"2.5".toReal().getOrElse(0.0) * 2.0} ${"?".toLong().isEmpty()} ${"5".toLong().isDefined()}")
