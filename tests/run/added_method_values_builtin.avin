// expect: exit 0
// The methods an impl adds to a trait reach every value whose type conforms to it, a built-in type
// implementing it as a class does: `int`, `string`, `real`, `char`, `bool`, an array and an opaque
// type. Each is called dotted and infix, and taken as a function value with and without an expected
// function type, passed to a higher-order function, with a `using` section filled where it is taken,
// overloaded with the overload chosen by the expected type, generic in the trait's argument, and
// through a bound. A type's own method of the same parameter types is found first.

data Tx(id: int)

trait Plain
  plain() -> string

impl Plain for int
  plain() -> string = s"int $self"

impl Plain for string
  plain() -> string = s"string $self"

impl Plain for real
  plain() -> string = s"real $self"

impl Plain for char
  plain() -> string = s"char $self"

impl Plain for bool
  plain() -> string = s"bool $self"

impl Plain for Array[int]
  plain() -> string = s"array of ${length}"

opaque type Code = int

impl Plain for Code
  plain() -> string = "code"

class Box(val n: int): Plain
  override plain() -> string = s"box $n"

impl Plain
  loud(k: int) -> string = s"${plain()}!$k"
  tagged(k: int, using tx: Tx) -> string = s"${plain()}#$k/${tx.id}"
  current(using tx: Tx) -> string = s"${plain()}@${tx.id}"
  shown() -> string = s"[${plain()}]"
  pick(k: int) -> string = s"int ${plain()} $k"
  pick(s: string) -> string = s"string ${plain()} $s"
  // `string` has its own `repeat(count: int)`, which is found first there.
  repeat(count: int) -> string = s"added ${plain()} $count"

trait Holder[T]
  held() -> T

impl Holder[int] for string
  held() -> int = byteLength

impl[T] Holder[T]
  heldPair(x: T) -> (T, T) = (held(), x)

apply(f: (int) -> string, k: int) -> string = f(k)

throughBound[T: Plain](x: T) -> string
  val f = x.loud
  f(9)

main() =
  given tx = Tx(7)
  // Calls, dotted and infix.
  println(5.loud(1))
  println("hi" loud 2)
  println(1.5.loud(3))
  println('c'.loud(4))
  println(true.loud(5))
  val arr = [1, 2, 3].toArray()
  println(arr.loud(6))
  println(Code(1).loud(7))
  // Values, with no expected type.
  val n: int = 42
  val a = n.loud
  println(a(1))
  val s = "word".loud
  println(s(2))
  val e = "".loud
  println(e(3))
  val u = "ünï".loud
  println(u(4))
  val m = 2147483647.loud
  println(m(5))
  val lo = (-2147483647 - 1).loud
  println(lo(6))
  val b = Box(3).loud
  println(b(7))
  // Values where a function type is expected, passed on.
  val typed: (int) -> string = 'z'.loud
  println(typed(8))
  println([1, 2].map(true.loud))
  println(apply(n.loud, 10))
  println(apply(arr.loud, 11))
  // A `using` section filled where the value is taken.
  val t = 3.tagged
  println(t(12))
  println([1, 2].map("s".tagged))
  val cur: () -> string = 4.current
  println(cur())
  // A method of no parameters, where a function type is expected.
  val sh: () -> string = 5.shown
  println(sh())
  // Overloads chosen by the expected function type.
  val pi: (int) -> string = 6.pick
  val ps: (string) -> string = 6.pick
  println(pi(1))
  println(ps("x"))
  // A generic trait's added method at the built-in type's arguments.
  println("abc".heldPair(9))
  val hp = "abcd".heldPair
  println(hp(1))
  // The type's own method of the name and parameter types is found first, as a call and as a value;
  // a type without one has the added one.
  println("ab".repeat(2))
  val own = "ab".repeat
  println(own(3))
  println(5.repeat(2))
  val added = 5.repeat
  println(added(3))
  // Through a bound, at a built-in type argument.
  println(throughBound(8))
  println(throughBound("b"))
  // A value captured and called later, after collections.
  var fs: Vector[(int) -> string] = []
  for i in 0..<3
    fs = fs :+ i.loud
  println(fs.map(f -> f(0)))
