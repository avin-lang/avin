// expect: trap
// A timed send to a ticker's channel traps as a send does, even with no time to wait.
import avin.threads.Ticker
import avin.time.{epochMicros, hours, millis}

main()
  val t = Ticker(hours(1))
  println("before")
  println(t.ticks.send(epochMicros(0), millis(5)))
  println("after")
