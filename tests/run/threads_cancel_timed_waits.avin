// expect: exit 0
// Threads cancelled the moment they park in a timed wait: a long sleep, a condition's `waitFor`, a
// sleep so short its timer fires as the cancellation comes, a join of a thread that sleeps, and a
// thread that has already finished. Half the rounds are cancelled from the main thread, half from one
// of the scope's own threads on another worker. No wait a cancellation ended leaves its timer behind
// to wake the thread's next wait or a thread that has ended, so every result is one its thread could
// give, and the timed waits that follow all keep their time.
import avin.threads.{Mutex, scope, sleep}
import avin.time.{millis, seconds}

work(kind: int, pause: int) -> int
    if kind == 0
        sleep(seconds(60))
        0
    elif kind == 1
        val m = Mutex(0)
        val c = m.condition()
        m.with(_ -> c.waitFor(60000))
        1
    elif kind == 2
        sleep(millis(long(pause)))
        2
    elif kind == 3
        scope(inner -> inner.spawn(() ->
            sleep(seconds(60))
            3).join())
    else 4

// Whether `v` is a result the thread of `kind` may give once cancelled: the waits that last a minute
// never finish, and the others finish or not.
possible(kind: int, v: Option[int]) -> bool = v match
    Some(x) -> x == kind && (kind == 2 || kind == 4)
    None -> true

// One round: ten threads, cancelled `pause` milliseconds after they start; answers how many gave a
// result their thread could not have.
runRound(pause: int) -> int
    val ts = scope(s ->
        val ts = (0..<10).map(i -> s.spawn(() -> work(i % 5, pause))).toVector
        sleep(millis(long(pause)))
        s.cancel()
        ts)
    var wrong = 0
    for (t, i) in ts.zipWithIndex
        if !possible(i % 5, t.result()) then wrong += 1
    wrong

main() -> int
    var wrong = 0
    for round in 0..<40
        val pause = round % 3
        // Odd rounds are run, and cancelled, by a thread of their own on a worker.
        wrong += if round % 2 == 0 then runRound(pause) else scope(o -> o.spawn(() -> runRound(pause)).join())
    println(wrong)
    // Timed waits after the cancellations each wait their own time.
    val m = Mutex(0)
    val c = m.condition()
    var timedOut = 0
    for _ in 0..<20
        sleep(millis(1))
        if !m.with(_ -> c.waitFor(1)) then timedOut += 1
    println(timedOut)
    val late = scope(s -> (0..<8).map(i -> s.spawn(() ->
        sleep(millis(long(i % 3)))
        i)).toVector.map(t -> t.join()).sum)
    println(late)
    0
