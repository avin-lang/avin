// expect: trap
// An executor takes no new body after its shutdown: giving it one is a bug, so it traps, at the
// program's call.
import avin.threads.Executor

main() -> int
  val ex = Executor.fixed(2)
  println(s"before ${ex.future(21 * 2).await()}")
  ex.shutdown()
  _ = ex.future(1)
  println("not reached")
  0
