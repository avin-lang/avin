// expect: trap
// A check's timeout is more than zero: a millisecond is taken, zero traps.
import avin.net.http
import avin.time.{Duration, millis}

main()
  println(http.check("a", () -> Ok(()), timeout = millis(1)).timeout.micros)
  println(http.check("a", () -> Ok(()), timeout = Duration.Zero).timeout.micros)
