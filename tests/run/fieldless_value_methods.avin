// expect: exit 0
// The bare name of a data type's variant of its own name with no fields is a value of the type, so
// a method called on the name is called on that value: an impl's method, a trait's method, a
// default body, an infix call and a method used as a function value. A static member of the type
// of the name is called on the type, and a value's method of the same name is called on the value.

trait Named
    name() -> string
    shout() -> string = name() + "!"

trait Unit
    static unit() -> Self

data Lone()

impl Lone
    hi() -> string = "hi"
    twice(s: string) -> string = s + s
    same(other: Lone) -> bool = other == self
    describe() -> string = s"lone says ${hi()}"

impl Named for Lone
    name() -> string = "lone"

impl Unit for Lone
    static unit() -> Lone = Lone

data Color
    Red
    Green
    Blue

impl Color
    label() -> string = self match
        Red -> "red"
        Green -> "green"
        Blue -> "blue"

impl Named for Color
    name() -> string = label()

data Empty[T]()

impl[T] Empty[T]
    size() -> int = 0
    wrap(x: T) -> Option[T] = Some(x)

data Holder(n: int)

impl Holder
    get() -> int = n

data Maker()

impl Maker
    make() -> int = 1

impl Unit for Maker
    static unit() -> Maker = Maker

data Both()

impl Both
    unit(n: int) -> string = s"value $n"

impl Unit for Both
    static unit() -> Both = Both

shout[T: Named](x: T) -> string = x.shout()

main()
    // A method of an impl, called on the bare name and on a value of it.
    println(Lone.hi())
    val l = Lone
    println(l.hi())
    println(Lone.twice("ab"))
    println(Lone.same(Lone))
    println(Lone.describe())
    // A trait's method and its default body.
    println(Lone.name())
    println(Lone.shout())
    println(shout(Lone))
    // An infix call.
    println(Lone twice "cd")
    println(Lone same l)
    // A method as a function value, bound to the value.
    val f = Lone.hi
    println(f())
    val g: (string) -> string = Lone.twice
    println(g("x"))
    println(["p", "q"].map(Lone.twice))
    // A static member of the type is the type's.
    println(Lone.unit().hi())
    println(Maker.unit().make())
    println(Maker.make())
    // A static member and a value's method share a name: the type's is called on the name, the
    // value's on a value.
    println(Both.unit().unit(5))
    val b = Both
    println(b.unit(6))
    // Inside a closure.
    val h = () -> Lone.hi() + Lone.name()
    println(h())
    // The field-less variants of a type with several.
    println(Red.label())
    println(Green.name())
    println(Blue.label())
    println(Blue.shout())
    // A generic data type with no fields, its type argument written or inferred.
    println(Empty[int].size())
    println(Empty[string].wrap("w"))
    println(Empty.wrap(7))
    val e: Empty[int] = Empty
    println(e.wrap(3))
    // A variant with fields stays called by its name.
    println(Holder(4).get())
    // Patterns are unaffected.
    val c: Color = Green
    println(c match
        Red -> 1
        Green -> 2
        Blue -> 3)
    println(Lone match
        Lone -> "matched")
    println(l is Lone)
