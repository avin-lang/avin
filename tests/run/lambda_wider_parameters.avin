// expect: exit 0
// A lambda whose parameter is declared wider than the function type expected of it is a value of
// that type, as a function of an `Animal` is a function of a `Dog`: passed to a function, stored in a
// binding, given to a generic method whose type argument is known, with several parameters, and as
// a function-typed parameter that is itself narrower in what it takes.

open class Animal(val name: string)

class Dog(name: string): Animal(name)

callDog(f: (Dog) -> int) -> int = f(Dog("rex"))

callStrings(f: (string, Dog) -> string) -> string = f("s", Dog("d"))

higher(f: ((Animal) -> int) -> int) -> int = f(a -> a.name.byteLength())

main()
    println(callDog((a: Animal) -> a.name.byteLength()))
    println(callStrings((s: Any, a: Animal) -> s"${a.name} ${s is _: string}"))
    println(higher((g: (Dog) -> int) -> g(Dog("abcd"))))
    val stored: (Dog) -> string = (a: Animal) -> a.name + "!"
    println(stored(Dog("fido")))
    val dogs: List[Dog] = [Dog("a"), Dog("bb")]
    println(dogs.map((a: Animal) -> a.name.byteLength()))
    var made = 0
    val counted: (Dog) -> unit = (a: Animal) -> made += a.name.byteLength()
    for d in dogs
        counted(d)
    println(made)
