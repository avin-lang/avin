// expect: exit 0
// A built-in value, a string or a tuple is a value of each trait it implements, as a data value or an
// object is: held, passed and returned as the trait, called through it, compared, and matched back
// out of it and out of `Any`.

trait Named
    name() -> string

impl Named for int
    name() -> string = s"int $self"

impl Named for string
    name() -> string = s"string $self"

data P(x: int)

describe(d: Display) -> string = s"<$d>"

choose(flag: bool) -> Display = if flag then 1 else "one"

named(items: Vector[Named]) -> string
    var out = ""
    for n in items
        out = out + n.name() + ";"
    out

// An overload taking a trait accepts a literal and a built-in value as the trait's, and one taking
// the value's own type is the more specific.
overloaded(d: Display) -> string = s"display $d"

overloaded(s: string) -> string = s"string $s"

kind(d: Display) -> string = d match
    n: int -> s"int ${n + 1}"
    s: string -> s"string of ${s.byteLength()}"
    t: (int, int) -> s"pair summing ${t.0 + t.1}"
    _ -> "other"

main()
    val items: Vector[Display] = [1, "two", 'c', P(3), (4, 5), true, 2.5, (), i128(12345678901234567), byte(7)]
    for i in items
        print(i)
    print(describe(42))
    print(describe((1, "x")))
    print(describe(choose(true)))
    print(describe(choose(false)))
    val shown: Display = if items.length() > 3 then "many" else 0
    print(shown)
    print(named([3, "s"]))
    val n: Named = 7
    print(n.name())

    // Debug through the trait keeps each type's own form.
    val debugged: Vector[Debug] = ["q\"", 'c', 5, ("a", 'b')]
    for d in debugged
        print(debug(d))

    // Matched back out, by its own type.
    print(kind(41))
    print(kind("four"))
    print(kind((2, 3)))
    print(kind(2.5))

    // `==` on trait values compares by the values' own types.
    val a: Display = 1
    val b: Display = 1
    val c: Display = "1"
    print(a == b)
    print(a == c)
    print(c == "1")

    // From `Any`, a value is matched as a trait it implements.
    val anys: Vector[Any] = [7, "seven", (7, 7), P(7), 7.5]
    for x in anys
        x match
            d: Named -> print(s"named ${d.name()}")
            d: Display -> print(s"display $d")
            _ -> print("neither")

    // `print` and `eprint` take several values of any types that implement `Display`.
    print("total", 3, (1, 2))
    print(P(1), "x", 2.5, 'c', true, ())
    val more: Vector[Display] = [4, "five"]
    print(0, 1, more*)
    eprint("to standard error", 1)
    print(overloaded(5), overloaded("s"), overloaded(P(2)))
