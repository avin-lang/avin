// expect: exit 0
// `Sendable` is decided from each type's structure, and generic code bounded by it accepts every
// sendable type: scalars, strings and unit; tuples; data types of sendable fields, a recursive one
// included; final classes and objects without a `var`; the immutable collections of sendable
// elements; the synchronized types; a Sysl handle; a trait, an abstract class, a class header and an
// impl that promise `Sendable`; and type parameters bounded by it, or by a trait that promises it,
// passed on to other bounded code.
import avin.threads.{Atomic, Channel, Future, Mutex, Once, Promise}

data Point(x: int, y: int)

data Tree
    Leaf
    Node(left: Tree, value: string, right: Tree)

data Job(id: int, tags: Vector[string], origin: Option[Point])

class Account(val owner: string, val balance: long)

object Settings
    val retries = 3

trait Shape: Sendable
    area() -> real

class Square(val side: real): Shape
    override area() -> real = side * side

class Circle(val r: real): Shape
    override area() -> real = 3.0 * r * r

class Pair[A: Sendable, B: Sendable](val first: A, val second: B): Sendable

class Counter(private val count: Mutex[int])

// A data type may state the promise in an impl, and is held to it there.
data Reading(sensor: string, values: Vector[real])

impl Sendable for Reading

// An abstract class that promises `Sendable` is sendable, each subclass checked to keep it.
abstract class Message: Sendable
    text() -> string

class Note(val body: string): Message
    override text() -> string = body

// A generic trait that promises `Sendable` is sendable at sendable arguments; an implementor's
// parameter passed to it is taken as sendable where the implementor is checked.
trait Envelope[T]: Sendable
    contents() -> T

class Letter[T](val body: T): Envelope[T]
    override contents() -> T = body

// A Sysl handle is sendable: a send hands its ownership over.
@sysl("sysl.checksum.Crc32")
class Crc32
    finish() -> long

@sysl("sysl.checksum.new_crc32")
newCrc32() -> Crc32

// A data type bounding its parameter by `Sendable` is held to it where it is named.
data Parcel[T: Sendable](item: T)

measured[S: Shape](shape: S) -> string = send(shape)

shown[T: Sendable + Display](value: T) -> string = s"${send(value)} $value"

// A class that holds itself, through an option, is decided by its other fields.
class Link(val label: string, val next: Option[Link])

send[T: Sendable](value: T) -> string = "sent"

forward[T: Sendable](value: T) -> string = send(value)

both[A: Sendable, B: Sendable](a: A, b: B) -> string = send((a, b))

total(shapes: Vector[Shape]) -> real
    var sum = 0.0
    for s in shapes do sum = sum + s.area()
    sum

main()
    println(send(1))
    println(send(long(2)))
    println(send(1.5))
    println(send('c'))
    println(send(true))
    println(send(()))
    println(send("text"))
    println(send(byte(7)))
    println(send((1, "one", 'x')))
    println(send(Point(1, 2)))
    println(send(Node(Leaf, "root", Node(Leaf, "right", Leaf))))
    println(send(Job(1, ["a", "b"], Some(Point(0, 0)))))
    println(send(Account("ann", long(10))))
    println(send(Settings))
    println(send([1, 2, 3]))
    println(send(List(1, 2)))
    println(send(["a"].toArraySeq()))
    println(send(0..<10))
    println(send(Map[string, int]().updated("a", 1)))
    println(send(Set(1, 2)))
    println(send(TreeMap[int, string]().updated(1, "one")))
    println(send(Some([Point(1, 1)])))
    val parsed: Result[int, string] = Ok(1)
    println(send(parsed))
    val chosen: Either[string, Point] = Right(Point(2, 2))
    println(send(chosen))
    println(send(Mutex(Buffer[int]())))
    println(send(Atomic(5)))
    println(send(Channel[string]()))
    println(send(Promise[int]()))
    println(send(Future(1)))
    println(send(Once()))
    println(send(Counter(Mutex(0))))
    val shape: Shape = Square(2.0)
    println(send(shape))
    val shapes: Vector[Shape] = [Square(1.0), Circle(1.0)]
    println(send(shapes))
    println(total([Square(1.0), Square(2.0)]))
    println(send(Pair(1, "x")))
    println(forward(Point(3, 4)))
    println(both(1, [Point(5, 6)]))
    println(send(Reading("t", [1.0, 2.0])))
    val note: Message = Note("hi")
    println(send(note))
    println(note.text())
    val letter: Envelope[Vector[int]] = Letter([1, 2])
    println(send(letter))
    println(send(Letter(Point(1, 2))))
    println(send(newCrc32()))
    val parcel: Parcel[Option[Point]] = Parcel(Some(Point(7, 8)))
    println(send(parcel))
    println(parcel.item)
    println(measured(Circle(2.0)))
    println(send(TreeSet(3, 1)))
    println(send(Map[int, Vector[Shape]]()))
    println(shown(42))
    println(send(Link("a", Some(Link("b", None)))))
