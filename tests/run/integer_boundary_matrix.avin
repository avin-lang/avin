// Every operator over the edge values of `int`, checked against the same operation done in `long`
// and brought back: the wrapping, saturating, bitwise, shift and division families, and the
// comparison chains against their `&&` expansions. The program prints how many cases it ran and how
// many disagreed.

var cases = 0
var bad = 0

check(ok: bool)
    cases += 1
    if !ok then bad += 1

clamp(x: long) -> int = if x < -2147483648 then -2147483647 - 1 else if x > 2147483647 then 2147483647 else int(x)

arithmetic(a: int, b: int)
    val x = long(a)
    val y = long(b)
    check(a +% b == int(x + y))
    check(a -% b == int(x - y))
    check(a *% b == int(x * y))
    check(a +| b == clamp(x + y))
    check(a -| b == clamp(x - y))
    check(a *| b == clamp(x * y))
    check(a & b == int(x & y))
    check(a | b == int(x | y))
    check(a ^ b == int(x ^ y))
    check((a < b) == (x < y))
    check((a == b) == (x == y))
    if b != 0 && !(a == -2147483647 - 1 && b == -1)
        check(a / b == int(x / y))
        check(a % b == int(x % y))
    if a == -2147483647 - 1 && b == -1 then check(a % b == 0)

shift(a: int, count: int)
    val x = long(a)
    val wide_count = long(count)
    val left = if count >= 0 && count < 32 then int(x << wide_count) else 0
    val right = if count >= 0 && count < 32 then int(x >> wide_count) else if a < 0 then -1 else 0
    check(a << count == left)
    check(a >> count == right)

chain(a: int, b: int, c: int)
    check((a < b < c) == (a < b && b < c))
    check((a <= b <= c) == (a <= b && b <= c))
    check((a > b >= c) == (a > b && b >= c))
    check((a == b != c) == (a == b && b != c))
    check((a != b == c) == (a != b && b == c))
    check((a <= b > c) == (a <= b && b > c))

main()
    val edges = [-2147483647 - 1, -2147483647, -46341, -46340, -1, 0, 1, 46340, 46341, 2147483646, 2147483647]
    val counts = [-2147483647 - 1, -1, 0, 1, 2, 15, 30, 31, 32, 33, 63, 64, 2147483647]
    for a in edges
        for b in edges
            arithmetic(a, b)
    for a in edges
        for count in counts
            shift(a, count)
    for a in -1..1
        for b in -1..1
            for c in -1..1
                chain(a, b, c)
    println(cases, bad)
