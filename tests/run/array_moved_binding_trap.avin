// expect: trap
// An array the program moved, given to a Sysl binding that reads it (decoding UTF-8), stops the
// program at the call, as any other use of it does.
import avin.actors.Isolated

main()
  val a = "hi".utf8
  println(string.fromUtf8(a))
  val moved = Isolated.move(a)
  println(string.fromUtf8(a))
  println(moved.take().length)
