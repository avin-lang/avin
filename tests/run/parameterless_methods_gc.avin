// expect: exit 0
// Parameterless methods that allocate, read in loops and chains under a collection at every
// allocation: each read builds a fresh value the next read reaches through, a lambda kept in a
// collection holds the receiver whose method it reads, and a generic class's read yields the value
// it holds at its own type.

data Node[T]
    End
    Link(value: T, rest: Node[T])

class Stack[T](top: Node[T])
    isEmpty -> bool = top is End
    peek -> T = top match
        Link(v, _) -> v
        End -> fail("empty")
    popped -> Stack[T] = top match
        Link(_, r) -> Stack(r)
        End -> self
    size -> int = if isEmpty then 0 else 1 + popped.size
    push(x: T) -> Stack[T] = Stack(Link(x, top))

class Text(s: string)
    twice -> Text = Text(s + s)
    length -> int = s.byteLength()

main() =
    var st: Stack[string] = Stack(End)
    for i in 0..<200
        st = st.push(s"item $i")
    println(st.size)
    println(st.peek)
    println(st.popped.popped.peek)
    var walk = st
    var seen = 0
    while !walk.isEmpty
        seen += walk.peek.byteLength()
        walk = walk.popped
    println(seen)
    var t = Text("ab")
    for _ in 0..<10
        t = t.twice
    println(t.length)
    var reads: Vector[() -> string] = []
    for i in 0..<50
        val s = Stack(Link(s"kept $i", End))
        reads = reads :+ (() -> s.peek)
    println(reads(0)())
    println(reads(49)())
    println(reads.map(r -> r().byteLength()).sum)
    val nums: Stack[long] = Stack(Link(long.MaxValue, Link(long.MinValue, End)))
    println(nums.peek)
    println(nums.popped.peek)
