// expect: exit 0
// `f"…"` real conversions: `%f` fixed, `%e` and `%E` with an exponent, `%g` and `%G` in whichever is
// shorter with the precision as significant digits; the digits are the exact value's, rounded half
// to even; the flags `-`, `+`, a space, `0` (after the sign) and `#`; infinities and NaN. A real
// hole with no specifier keeps its shortest form.
main()
    val x = 3.14159265
    val y = -2.5
    println(f"[${x}%f] [${x}%.2f] [${x}%.0f] [${y}%.0f] [${0.125}%.2f] [${2.5}%.0f] [${3.5}%.0f]")
    println(f"[${x}%10.3f] [${x}%-10.3f] [${x}%010.3f] [${y}%010.3f] [${x}%+.1f] [${x}% .1f] [${3.0}%#.0f]")
    println(f"[${x}%e] [${x}%.2e] [${x}%E] [${123456.0}%.3e] [${0.000123}%e] [${y}%+012.3e]")
    println(f"[${x}%g] [${100000.0}%g] [${1000000.0}%g] [${0.0001}%g] [${0.00001}%G] [${x}%.3g] [${2.0}%#g]")
    val inf = 1.0 / 0.0
    val nan = 0.0 / 0.0
    println(f"[${inf}%f] [${-inf}%e] [${inf}%G] [${inf}%08f] [${nan}%5.1f] [${inf}%+f]")
    println(f"[$x] [${x}] [$y] [${0.1}] [${1e21}]")
