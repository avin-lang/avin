// expect: exit 0
// A regex is an extractor: `case date(y, m, d)` matches the whole text and binds the groups.
import avin.regex
import avin.regex.{Regex, Groups}

val date = Regex("(\\d{4})-(\\d\\d)-(\\d\\d)")

describe(s: string) -> string = s match
  date(year, month, day) -> s"day $day of month $month in $year"
  _ -> s"not a date: $s"

main()
  println(describe("2024-06-30"))
  println(describe("due 2024-06-30"))
  println(describe("2024-6-30"))
  // Unanchored, any part of the text matches.
  val anywhere = date.unanchored
  println("due 2024-06-30 at noon" match
    anywhere(y, _*) -> s"year $y"
    _ -> "none")
  // A group that took no part gives the empty string.
  val signed = "([+-])?(\\d+)".r()
  for s in ["-12", "7", "x"]
    println(s match
      signed(sign, digits) -> s"sign '$sign', digits $digits"
      _ -> "no number")
  // No groups: the pattern is a test.
  val word = "[a-z]+".r()
  println(if "hello" is word() then "a word" else "not a word")
  println(if "Hello" is word() then "a word" else "not a word")
  // A local regex in a lambda, nested inside another pattern.
  val pair = "(\\w+)=(\\w+)".r()
  val found = ["a=1", "b", "c=3"].map(s -> Some(s)).collect(match Some(pair(k, v)) -> s"$k:$v")
  println(found)
  // `Groups` takes apart a match from any regex.
  for m in "(\\d+)x(\\d+)".r().findAllMatchIn("3x4 and 10x20")
    m match
      Groups(w, h) -> println(s"$w by $h")
      _ -> println("?")
  println("[a-z]+".r().findFirstMatchIn("abc") match
    Some(Groups(_*)) -> "groups"
    Some(_) -> "a match without groups"
    None -> "nothing")
