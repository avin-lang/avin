// expect: exit 0
// Inference never forms a union, and carries one it is given: `val u2 = u` is the union, `Some(u)`
// an option of it, and `id(u)` takes `T` as it. Where a union and one of its members meet as two
// branches or arms, they agree on the union, and the member is injected. A type parameter that is a
// member of a union in a parameter's type takes what the argument leaves over once the other members
// are taken out: `orText(3)` gives `T = int`, and `orText(u)` with three members the other two.

show(x: int | string) -> string = x match
    n: int -> s"int $n"
    s: string -> s"string $s"

id[T](x: T) -> T = x

orText[T: Display](x: T | string) -> string = x match
    s: string -> s"text $s"
    t: T -> s"other $t"

// The arm for `T` comes first: at `T = int | bool` it takes only those members.
leftOver[T](x: T | string, describe: (T) -> string) -> string = x match
    t: T -> describe(t)
    s: string -> s"text $s"

kind(x: int | bool) -> string = x match
    n: int -> s"int $n"
    b: bool -> s"bool $b"

main(args: Vector[string])
    val yes = args.size == 0
    val u: int | string = "u"
    val u2 = u
    println(show(u2))
    val o = Some(u)
    println(o.map(show))
    println(show(id(u)))
    val joined = if yes then u else 3
    println(show(joined))
    val other = if !yes then u else 3
    println(show(other))
    val armed = args.size match
        0 -> 4
        _ -> u
    println(show(armed))
    val listed = [u, u2]
    println(listed.map(show))
    println(orText(3))
    println(orText(true))
    val three: int | bool | string = false
    println(orText(three))
    val words: int | bool | string = "w"
    println(orText(words))
    println(leftOver(three, kind))
    println(leftOver(words, kind))
    println(leftOver(5, (n: int) -> s"five is $n"))
