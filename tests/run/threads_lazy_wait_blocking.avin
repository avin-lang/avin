// expect: exit 0
// A `lazy val` whose initializer waits for a channel that only a later thread fills, read by far more
// threads than there are processors: each reader waits for the initializer by blocking its
// operating system thread, and the runtime runs another worker in place of each one held, so the
// thread that fills the channel still runs and every reader gets the value.
import avin.threads.{Channel, scope}

val gate = Channel[int]()

lazy val answer: int = gate.receive().getOrElse(-1) + 1

main() -> int
    val total = scope(s ->
        val readers = (0..<128).map(_ -> s.spawn(() -> answer)).toVector
        s.spawn(() -> gate.send(41))
        readers.map(t -> t.join()).sum)
    println(total)
    0
