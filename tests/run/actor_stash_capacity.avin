// expect: exit 0
// A stash's capacity is at least one: a capacity of zero, or less, traps where the stash is made,
// failing the actor that makes it, here under `Stop`, so its end tells the reason. A capacity of one
// holds one message.
import avin.actors.{ActorRef, Stash, Stop, spawn}
import avin.time

data Msg
  Hold(n: int)
  Count(replyTo: ActorRef[string])

actor Holder(capacity: int) receives Msg
  val stash = Stash(self, capacity)

  receive
    Hold(n) -> stash.add(Hold(n))
    Count(replyTo) -> replyTo.tell(s"${stash.length} of ${stash.capacity}, full ${stash.isFull}")

main()
  val one = spawn(Holder(1))
  one.tell(Hold(1))
  println(one.ask(r -> Count(r), timeout = time.seconds(5)).await())
  println(spawn(Holder(0), onFailure = Stop).ended().await())
  println(spawn(Holder(-2147483648), onFailure = Stop).ended().await())
