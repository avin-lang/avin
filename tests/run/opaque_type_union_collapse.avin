// expect: exit 0
// A union of an opaque type and its representation is no collapsed union: at `T | int` with `T`
// an opaque type over `int`, each element keeps which member it is, under collection at every
// allocation too; at `T` the representation itself, or the opaque type in both places, it collapses
// as any union of one type does.

opaque type Inner = int
opaque type Name = string
opaque type Twice = Inner

build[T](x: T, n: int) -> Vector[T | int] = Vector.tabulate(n, i -> if i % 2 == 0 then x else i)

strings[T](x: T, n: int) -> Vector[T | string] = Vector.tabulate(n, i -> if i % 2 == 0 then x else s"s$i")

kinds[T](v: Vector[T | int]) -> string = v.map(e -> e match
  _: T -> "t"
  _: int -> "i").mkString("")

skinds[T](v: Vector[T | string]) -> string = v.map(e -> e match
  _: T -> "t"
  _: string -> "s").mkString("")

pick[T](x: T | Inner) -> string = x match
  _: Inner -> "inner"
  _: T -> "t"

main()
  println(kinds[Inner](build(Inner(7), 6)))
  println(kinds[int](build(7, 6)))
  println(kinds[Twice](build(Twice(Inner(1)), 4)))
  println(skinds[Name](strings(Name("n"), 4)))
  println(skinds[string](strings("n", 4)))
  println(pick[int](3))
  println(pick[int](Inner(3)))
  println(pick[Inner](Inner(3)))
  val v = build(Inner(5), 2000)
  var s = 0
  for e in v do s += e match
    t: Inner -> t.repr
    n: int -> n
  println(s)
