// expect: exit 0
// env: TZDIR=/etc
// env: TZ=hosts
// The database is the directory TZDIR names: a file in it that is no zone's is Malformed, a zone
// only the usual directory holds is unknown there, and a local zone whose file cannot be decoded
// is utc.
import avin.time.{localZone, utc, zone}

main()
    zone("hosts") match
        Ok(z) -> println(s"found $z")
        Err(e) -> println(e)
    zone("America/Toronto") match
        Ok(z) -> println(s"found $z")
        Err(e) -> println(e)
    println(localZone() == utc)
    println(zone("UTC").getOrElse(localZone()) == utc)
