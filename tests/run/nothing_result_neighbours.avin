// expect: exit 1
import avin.process.exit

// `Nothing` conforms to every result type: a lambda that never returns is accepted where an `int`
// function is expected, and a method overriding one that yields `int` may yield `Nothing`, called
// through the base class.
open class Base()
  size() -> int = 1

class Failing(): Base()
  override size() -> Nothing = exit(1)

apply(f: (int) -> int, n: int) -> int = f(n)

main()
  println(apply(x -> x + 4, 1))
  val bad: (int) -> int = x -> exit(1)
  val b: Base = Base()
  println(b.size())
  if b.size() > 100 then println(apply(bad, 1))
  val f: Base = Failing()
  println(f.size())
