// expect: exit 0
// A `select` with an `after` is a timed wait, so it is never a deadlock, even while every other thread
// waits for ever: `main` selects with a limit on a channel nobody sends to while a thread waits on
// another, and the `after` runs; a thread selecting with a limit is joined by `main`, and its `after`
// ends the join; and a select whose `after` is zero answers at once.
import avin.threads.{Channel, spawn}
import avin.time.millis

main()
  val quiet = Channel[int]()
  val never = Channel[int]()
  val stuck = spawn(() -> never.receive().getOrElse(-1))
  select
    quiet.receive() as Some(x) -> println(x)
    after 30.millis -> println("main: timed out")
  val timed = spawn(() ->
    select
      quiet.receive() as Some(x) -> x
      after 30.millis -> 2)
  println(timed.join())
  select
    quiet.receive() as Some(x) -> println(x)
    after 0.millis -> println("zero")
  never.close()
  println(stuck.join())
