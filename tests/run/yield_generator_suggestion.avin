// expect: exit 0
// The suggestions of the diagnostics for a generator whose element type is open are written as the
// diagnostics say, and they compile.
main()
  val a = for x in Ok(1), y in Err[int, string]("no") yield x + y
  println(a)
  val source: Result[int, string] = Err("bad")
  val b = for y in source yield y + 1
  println(b)
  val c = for (p, q) in Ok[(int, int), string]((1, 2)) yield p + q
  println(c)
