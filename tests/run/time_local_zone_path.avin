// expect: exit 0
// env: TZ=/usr/share/zoneinfo/Asia/Tokyo
// The host's own zone: a TZ that is a path names the file it leads to, and the zone is named for what follows its zoneinfo directory.
import avin.time.{epochSeconds, localZone, utc, zone}

main()
    val here = localZone()
    println(s"${here} ${debug(here)} ${here == utc} ${here.isFixed}")
    val t = epochSeconds(1787937855).atZone(here)
    println(s"$t ${t.format("YYYY-MM-DD hh:mm z zzz zzzz")}")
