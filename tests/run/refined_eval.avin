// expect: exit 0
// Refinement: an arm on a refined variant learns what the variant fixes, so `eval[T](e: Expr[T]) -> T`
// type-checks, each clause's body checked against `T` under its equalities, and runs at every
// instance the program calls it at: `int`, `bool`, a pair, a pair of pairs. The same evaluator is
// written as clauses, as a `match`, as a match function, through `is` with an early return, as a
// generic method of a class and as a generic local function.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  BoolLit(value: bool) -> Expr[bool]
  StrLit(value: string) -> Expr[string]
  Add(a: Expr[int], b: Expr[int]) -> Expr[int]
  Eq(a: Expr[int], b: Expr[int]) -> Expr[bool]
  If(cond: Expr[bool], yes: Expr[T], no: Expr[T])
  Pair[A, B](first: Expr[A], second: Expr[B]) -> Expr[(A, B)]

eval[T](e: Expr[T]) -> T
eval(IntLit(n)) = n
eval(BoolLit(b)) = b
eval(StrLit(s)) = s
eval(Add(a, b)) = eval(a) + eval(b)
eval(Eq(a, b)) = eval(a) == eval(b)
eval(If(c, yes, no)) = if eval(c) then eval(yes) else eval(no)
eval(Pair(a, b)) = (eval(a), eval(b))

matched[T](e: Expr[T]) -> T = e match
  IntLit(n) -> n
  BoolLit(b) -> b
  StrLit(s) -> s
  Add(a, b) -> matched(a) + matched(b)
  Eq(a, b) -> matched(a) == matched(b)
  If(c, yes, no) -> if matched(c) then matched(yes) else matched(no)
  Pair(a, b) -> (matched(a), matched(b))

// `is` with an early return: the rest of the block holds the test's equalities.
tested[T](e: Expr[T]) -> T
  if e is IntLit(n) then return n
  if e is not Pair(a, b) then return matched(e)
  (tested(a), tested(b))

class Evaluator(name: string)
  run[T](e: Expr[T]) -> T = e match
    IntLit(n) -> n
    BoolLit(b) -> b
    StrLit(s) -> s
    Add(a, b) -> run(a) + run(b)
    Eq(a, b) -> run(a) == run(b)
    If(c, yes, no) -> if run(c) then run(yes) else run(no)
    Pair(a, b) -> (run(a), run(b))

// A match function whose type is declared refines as any `match` does.
viaMatchFunction[T](e: Expr[T]) -> T
  val f: (Expr[T]) -> T = match
    IntLit(n) -> n
    BoolLit(b) -> b
    StrLit(s) -> s
    Add(a, b) -> eval(a) + eval(b)
    Eq(a, b) -> eval(a) == eval(b)
    If(c, yes, no) -> if eval(c) then eval(yes) else eval(no)
    Pair(a, b) -> (eval(a), eval(b))
  f(e)

viaLocal[T](e: Expr[T]) -> T
  go[U](x: Expr[U]) -> U = x match
    IntLit(n) -> n
    BoolLit(b) -> b
    StrLit(s) -> s
    Add(a, b) -> go(a) + go(b)
    Eq(a, b) -> go(a) == go(b)
    If(c, yes, no) -> if go(c) then go(yes) else go(no)
    Pair(a, b) -> (go(a), go(b))
  go(e)

main()
  val two = Add(IntLit(1), IntLit(1))
  val choice = If(Eq(IntLit(2), two), Pair(IntLit(7), BoolLit(true)), Pair(IntLit(0), BoolLit(false)))
  val nested = Pair(choice, StrLit("héllo ✓"))
  println(eval(two))
  println(eval(Eq(two, IntLit(3))))
  println(eval(choice))
  println(eval(nested))
  println(eval(StrLit("")))
  println(matched(choice))
  println(matched(nested))
  println(tested(IntLit(5)))
  println(tested(BoolLit(false)))
  println(tested(nested))
  val ev = Evaluator("e")
  println(ev.run(choice))
  println(ev.run(Add(IntLit(2147483646), IntLit(1))))
  println(viaLocal(nested))
  println(viaLocal(IntLit(-2147483648)))
  println(viaMatchFunction(nested))
  println(viaMatchFunction(Eq(IntLit(1), IntLit(1))))
  // A match function on a known instance.
  val sum: (Expr[int]) -> int = match
    IntLit(n) -> n * 10
    Add(a, b) -> eval(a) + eval(b)
    _ -> -1
  println(sum(IntLit(4)))
  println(sum(two))
  println(sum(If(BoolLit(true), IntLit(9), IntLit(8))))
  // A deep tree, evaluated at every copy, allocates as it goes.
  var big: Expr[int] = IntLit(0)
  for i in 1 .. 1000
    big = Add(big, If(Eq(IntLit(i % 3), IntLit(0)), IntLit(i), IntLit(0)))
  println(eval(big))
  println(matched(big) == tested(big))
