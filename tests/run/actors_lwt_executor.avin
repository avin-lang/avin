// expect: exit 0
// `Executor.shared()` is the same executor every time, and an actor given it explicitly runs its
// turns as lightweight threads of their own, as the default does: fifty such actors park in their
// turns at once. An actor given an executor of its own runs its turns as tasks there instead, so on
// `Executor.fixed(1)` a turn that sleeps keeps the executor's one place and the next actor waits for
// it. A turn has a thread's stack, so it recurses deeply; a turn of a generic behaviour parks too;
// and what a parked turn holds on the heap survives the collections other actors cause meanwhile.
import avin.actors.{Behaviour, spawn}
import avin.threads.{Channel, Executor, sleep}
import avin.time

// Recurses `n` deep and answers `n`.
depth(n: int) -> int = if n == 0 then 0 else 1 + depth(n - 1)

// An actor that waits for a value of `T` on `from` and passes it on to `to`.
relay[T: Sendable](from: Channel[T], to: Channel[T]) -> Behaviour[unit] = Behaviour("Relay", me -> _ ->
    to.send(from.receive().get()))

main()
    println(Executor.shared() === Executor.shared())
    println(Executor.shared() === Executor.fixed(1))
    // Explicitly shared: every turn parked at once.
    val gate = Channel[int]()
    val done = Channel[int]()
    for _ in 0..<50 do spawn(Behaviour[unit]("Parked", me -> _ -> done.send(gate.receive().get())), executor = Executor.shared()).tell(())
    for _ in 0..<50 do gate.send(1)
    var n = 0
    for _ in 0..<50 do n += done.receive().get()
    println(n)
    // An executor of one: the sleeping turn keeps its place.
    val one = Executor.fixed(1)
    val order = Channel[string]()
    spawn(Behaviour[unit]("Slow", me -> _ ->
        sleep(time.millis(100))
        order.send("slow")), executor = one).tell(())
    sleep(time.millis(10))
    spawn(Behaviour[unit]("Quick", me -> _ -> order.send("quick")), executor = one).tell(())
    println(order.receive())
    println(order.receive())
    one.shutdown()
    // A deep recursion in a turn.
    val deep = Channel[int]()
    spawn(Behaviour[int]("Deep", me -> k -> deep.send(depth(k)))).tell(100000)
    println(deep.receive())
    // Generic relays, of strings and of options, parked until fed.
    val sIn = Channel[string]()
    val sOut = Channel[string]()
    spawn(relay(sIn, sOut)).tell(())
    val oIn = Channel[Option[long]]()
    val oOut = Channel[Option[long]]()
    spawn(relay(oIn, oOut)).tell(())
    sIn.send("héllo, wörld ✓")
    oIn.send(Some(9223372036854775807))
    println(sOut.receive())
    println(oOut.receive())
    // A parked turn's heap values outlive what other turns allocate meanwhile.
    val held = Channel[int]()
    spawn(Behaviour[unit]("Holder", me -> _ ->
        val words = (0..<1000).map(i -> s"word$i").toVector()
        sleep(time.millis(50))
        held.send(words.map(w -> w.byteLength()).sum()))).tell(())
    val churn = Channel[int]()
    for i in 0..<8 do spawn(Behaviour[unit]("Churn", me -> _ ->
        var total = 0
        for j in 0..<2000 do total += s"$i-$j".byteLength()
        churn.send(total))).tell(())
    var churned = 0
    for _ in 0..<8 do churned += churn.receive().get()
    println(churned)
    println(held.receive())
