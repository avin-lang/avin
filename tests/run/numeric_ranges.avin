// expect: exit 0
// A range of any integer type other than `int` is a `NumericRange`: a sequence of its values with
// the same bounds, steps and emptiness as `Range`, answering an index, the first value and
// membership from its bounds, and never passing either end of its type.

describe[T: Integer](name: string, r: NumericRange[T])
  println(
    s"$name: values ${r.toVector} empty ${r.isEmpty} first ${r.headOption} last ${r.lastOption} lift(1) ${r.lift(1)} lift(-1) ${r.lift(-1)}"
  )

total(xs: Seq[long]) -> long = xs.foldLeft(long(0), (a, x) -> a + x)

main()
  val lo: i8 = -128
  val hi: i8 = 127
  val one: i8 = 1
  describe("i8 up to the top", hi - 3 .. hi)
  describe("i8 up to the top, open", hi - 3 ..< hi)
  describe("i8 down to the bottom", lo + 3 .. lo by -one)
  describe("i8 step 50", lo .. hi by 50)
  describe("i8 down step 100", hi .. lo by -100)
  describe("i8 empty", hi .. lo)
  describe("i8 single", one .. one)
  describe("i8 open single", one ..< one)
  describe("i8 up by one more than the room", hi - 1 .. hi by 5)
  println(s"i8 whole length ${(lo .. hi).length} sum ${(lo .. hi).foldLeft(0, (a, x) -> a + int(x))}")
  println(s"i8 whole open length ${(lo ..< hi).length} last ${(lo ..< hi).last} head ${(lo ..< hi).head}")

  val r16: i16 = 10
  describe("i16", r16 .. r16 + 20 by 7)
  val r64: long = 5
  describe("long", r64 .. 9)
  describe("long literal first", 3 .. r64)
  describe("long down", r64 .. 0 by -2)
  describe("long open down", r64 ..< 0 by -2)

  // Ranges of more values than an int holds.
  val big: long = 5000000000
  val huge = 0 .. big
  println(
    s"huge first ${huge.head} last ${huge.last} lift ${huge.lift(2000000000)} ${huge.lift(2147483647)} ${huge.lift(-1)}"
  )
  println(
    s"huge contains ${huge.contains(big)} ${huge.contains(big + 1)} ${huge.contains(-1)} ${huge.contains(3000000000)}"
  )
  val stepped = 0 .. big by 1000000000
  println(
    s"stepped length ${stepped.length} values ${stepped.toVector} contains ${stepped.contains(3000000000)} ${stepped.contains(3000000001)}"
  )
  println(s"stepped total ${total(stepped)} reversed ${stepped.reverse}")

  // The ends of long: nothing wraps.
  val top: long = 9223372036854775807
  val bottom: long = -9223372036854775807 - 1
  describe("long top", top - 2 .. top)
  describe("long top step 2", top - 3 .. top by 2)
  describe("long top big step", top - 1 .. top by top)
  describe("long bottom", bottom + 2 .. bottom by -1)
  describe("long bottom big step", bottom + 1 .. bottom by bottom)
  describe("long open top", top - 2 ..< top)
  describe("long empty at the top", top ..< top)
  val whole = bottom .. top
  println(
    s"whole head ${whole.head} lift(2) ${whole.lift(2)} lift(2147483647) ${whole.lift(2147483647)} contains ${whole.contains(0)} ${whole.contains(top)} ${whole.contains(bottom)}"
  )
  val whole2 = bottom .. top by top
  println(
    s"whole by top contains ${whole2.contains(bottom)} ${whole2.contains(-1)} ${whole2.contains(top - 1)} ${whole2.contains(bottom + top)} ${whole2.contains(bottom + top + top)}"
  )
  val minstep = top .. bottom by bottom
  print("min step")
  for x in minstep do print(s" $x")
  println(s" contains ${minstep.contains(top)} ${minstep.contains(-1)} ${minstep.contains(0)}")
  var seen = 0
  for x in whole
    seen += 1
    if seen == 3 then break
  println(s"whole iterates $seen")

  // Loops and comprehensions over them.
  for x in 3 .. r64 do print(s"$x ")
  println("")
  for x in (top - 2 .. top).reverse do print(s"$x ")
  println("")
  for x in lo + 2 .. lo by -one do print(s"$x ")
  println("")
  val squares = for x in r64 .. 8 yield x * x
  println(squares)
  val evens = for x in (r64 .. 20 by 5) if x > 5 yield x + 1
  println(evens)
  for x in (one .. 3) do print(s"[$x]")
  println("")

  // A range as a value in a function; its bounds are evaluated once, left to right.
  var calls = 0
  next() -> long
    calls += 1
    long(calls)
  val ordered = next() .. next() + 3
  println(s"${ordered.toVector} calls $calls")
  println(total(r64 .. 7))

  // Equal ranges are equal sequences.
  val expected: Vector[long] = [5, 6, 7, 8]
  println((r64 .. 8).toVector == expected)
  println((r64 .. 8) == (r64 .. 8))
