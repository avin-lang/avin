// expect: exit 0
// A data type may have a companion object, as a class may. In call position a variant of the type's
// name still makes a value; the bare name and `Name.member` are the companion. The type's impl and
// the companion each use the other's private members.

data Temperature(kelvin: int)

impl Temperature
  describe() -> string = s"${kelvin}K (${Temperature.label(self)})"

  private celsius() -> int = kelvin - 273

object Temperature
  private val absoluteZero = 0
  val freezing = Temperature(273)

  // A factory, reaching the companion's private value.
  fromCelsius(c: int) -> Temperature = Temperature(c + 273 + absoluteZero)

  // A private method, which the impl calls, calling the type's private method in turn.
  private label(t: Temperature) -> string = s"${t.celsius()}C"

  count() -> int = 1

// A generic data type's companion gives its members type parameters of their own.
data Pair[A, B](first: A, second: B)

object Pair
  twice[T](x: T) -> Pair[T, T] = Pair(x, x)

// A data type of several variants has a companion too; its name is no variant's, so it is never
// called.
data Shape
  Circle(radius: int)
  Square(side: int)

object Shape
  unit() -> Shape = Square(1)

  area(s: Shape) -> int = s match
    Circle(r) -> 3 * r * r
    Square(a) -> a * a

main()
  println(Temperature.fromCelsius(20).describe())
  println(Temperature.freezing.describe())
  println(Temperature(300).describe())
  println(Temperature(273) == Temperature.freezing)
  val t: Temperature = Temperature(5)
  println(t.kelvin)
  val companion = Temperature
  println(companion.count())
  println(Shape.area(Shape.unit()))
  println(Shape.area(Circle(2)))
  val p = Pair.twice[string]("x")
  val q: Pair[int, int] = Pair.twice(7)
  println(s"${p.first}${p.second} ${q.first + q.second} ${Pair(1, "one").second}")
  // Patterns still name the variant.
  Temperature.fromCelsius(0) match
    Temperature(k) -> println(k)
