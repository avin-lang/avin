// expect: exit 0
// A class or object body may call a function whose result type is inferred, even one that reads
// the body's own fields: the function needs the fields declared before the call, never the code
// after it, so it is not recursive.

object Config
  val name = "config"
  show(self)

show(c: Config) = println(s"show ${c.name}")

class Point(x: int)
  val label = s"point $x"
  val after = label + " done"
  describe(self)

describe(p: Point) = println(p.label)

object Printer
  report(c: Config) = println(s"report ${c.name}")

object Settings
  val mode = "fast"
  Printer.report(Config)
  val level = 3

// A module value computed by a function declared after it, which reads an object's inferred field.
val total = count(Settings)

count(s: Settings) = s.level * 2

// `A`'s body needs `B`'s field `b`, so `B`'s body is checked as far as `b` and resumed later; the
// rest of it calls a function that needs `A`'s field.
class A
  val a = "a"
  useB(B(false))

class B(nest: bool)
  val b = "b"
  if nest then useA(A())
  val later = b + " later"
  println(twiceOver(() -> later + "!"))

useB(x: B) = println(s"useB ${x.b}")

twiceOver(f: () -> string) = f() + f()

useA(x: A) = println(s"useA ${x.a}")

main()
  println(Config.name)
  println(Point(4).after)
  println(Settings.mode)
  println(s"total $total")
  val b = B(true)
  println(b.later)
