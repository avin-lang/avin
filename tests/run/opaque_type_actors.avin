// expect: exit 0
// A value of an opaque type is sendable where its representation is, so it is an actor's message, a
// part of one and a promise's value, and crosses threads as its representation would.
import avin.actors.{Behaviour, spawn}
import avin.threads.Promise

opaque type UserId = long
opaque type Name = string
opaque type Batch[T] = Vector[T]

data Visit(user: UserId, name: Name)

impl[T] Batch[T]
  def items -> Vector[T] = repr

main()
  val total = Promise[UserId]()
  val names = Promise[Batch[Name]]()
  val counter = spawn(Behaviour[Visit]("Visits", me ->
    var sum = long(0)
    var seen: Vector[Name] = []
    v ->
      sum += v.user.repr
      seen = seen :+ v.name
      if v.user == UserId(0)
        total.complete(UserId(sum))
        names.complete(Batch(seen))))
  for i in 1..100
    counter.tell(Visit(UserId(long(i)), Name(s"n$i")))
  counter.tell(Visit(UserId(0), Name("end")))
  println(total.future.await().repr)
  val got = names.future.await().items
  println(got.length)
  println(got(99).repr)
  println(got(100).repr)
