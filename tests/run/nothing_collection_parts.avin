// expect: exit 0
// A tuple or a collection literal with a part that never finishes is never made: the parts before it
// are evaluated, in order, and nothing after it is reached.

side(label: string, value: int) -> int
    print(label)
    value

main()
    val a = loop
        val t = (side("first", 1), break 1, side("never", 2))
    print(a)
    val b = loop
        val v = [side("element", 1), break 2, side("never", 3)]
    print(b)
    val c = loop
        val l: List[int] = [1, break 3, 3]
    print(c)
    val d = loop
        val m = {1: "a", 2: break 4}
    print(d)
    val e = loop
        print({1, break 5})
    print(e)
    val f = loop
        val m = {(break 6): 1}
    print(f)
    val g = loop
        val v: Vector[long] = [1, break 7]
    print(g)
    val h = loop
        print((break 8, 2))
    print(h)
    val k = loop
        print([break 9])
    print(k)
