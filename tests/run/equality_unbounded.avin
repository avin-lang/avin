// expect: exit 0
// `==` and `!=` work on a value of a type parameter with no bound: every type has equality and a
// hash, and each instance compares as its own type does, a user `Eq` included.

data Pt(x: int, y: int)

class Token(val id: int)

class Word(val text: string): Eq, Hash
    override equals(other: Word) -> bool = text.byteLength() == other.text.byteLength()
    override hash() -> long = long(text.byteLength())

same[T](a: T, b: T) -> bool = a == b

differ[T](a: T, b: T) -> bool = a != b

sameOption[T](a: Option[T], b: Option[T]) -> bool = a == b

samePair[T](a: T, b: T) -> bool = (a, 1) == (b, 1)

distinct[T](items: Vector[T]) -> Vector[T]
    var out: Vector[T] = []
    for x in items
        if !out.contains(x) then out = out :+ x
    out

main()
    val t = Token(1)
    print(s"${same(1, 1)} ${same(1, 2)} ${same("a", "a")} ${same("a", "b")}")
    print(s"${same(Pt(1, 2), Pt(1, 2))} ${same(Pt(1, 2), Pt(2, 1))}")
    print(s"${same(t, t)} ${same(t, Token(1))} ${same(Word("ab"), Word("cd"))}")
    print(s"${differ(1, 1)} ${differ(1, 2)} ${differ(t, Token(1))}")
    print(s"${same((1, "a"), (1, "a"))} ${samePair(Pt(1, 2), Pt(1, 2))} ${samePair(t, Token(1))}")
    print(s"${sameOption(Some(1), Some(1))} ${sameOption(Some(1), None)} ${sameOption(Some("a"), Some("b"))}")
    print(s"${same(1.hash(), 1.hash())} ${Pt(1, 2).hash() == Pt(1, 2).hash()} ${"ab".hash() == "ab".hash()}")
    print(distinct([1, 2, 1, 3, 2]).toString())
