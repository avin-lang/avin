// expect: exit 0
// Comprehensions over sources admitted by conformance, under allocation pressure: values of a
// program's own `Monad` and `Filter`, made in guards, definitions and yielded values and through a
// constructor parameter's bounds, are held in collections and closures while more are made, so a
// collection in between must keep every one of them.

data Box[A](items: Vector[A])

impl Monad for Box
  static pure[X](value: X) -> Box[X] = Box([value])

  flatMap[B](f: (A) -> Box[B]) -> Box[B]
    var out: Vector[B] = []
    for a in items
      out = out ++ f(a).items
    Box(out)

impl Filter for Box
  filter(p: (A) -> bool) -> Box[A] = Box(items.filter(p))

// A pair of strings made fresh each time, so every value the comprehension makes is on the heap.
labelled[F[_]: Monad & Filter](fa: F[int], fb: F[string]) -> F[(string, string)] =
  for a in fa if a % 3 != 0, s = s"n$a", b in fb, t = s + b if t.charCount > 2 yield (t, s)

main()
  var kept: Vector[Box[(string, string)]] = []
  var closures: Vector[() -> Box[string]] = []
  for round in 0 ..< 60
    val numbers = Box([round, round + 1, round + 2])
    val words = Box([s"x$round", "y", ""])
    kept = kept :+ labelled(numbers, words)
    val captured = Box([s"c$round"])
    closures = closures :+ (() -> for w in captured, v in Box([w, w + "!"]) yield v + "?")
  var total = 0
  for box in kept
    for (t, s) in box.items
      total += t.charCount + s.charCount
  println(total)
  println(kept(0).items)
  println(kept(59).items.size)
  println(closures(0)().items)
  println(closures(59)().items)
  val opts = for i in 0 ..< 40, o = Some(i) if i % 7 == 0, v in o yield v
  println(opts)
