// expect: exit 0
// Ten thousand threads sleeping at once on a handful of workers all wake in about one sleep: each
// parks on a timer and frees its worker, so no worker is added and none is replaced as if it were
// blocked. A worker that blocked for each sleep would take minutes; the bound is generous, so a loaded
// machine cannot make the test fail. Collections at every allocation would walk ten thousand parked
// stacks for each of the threads started, so this program runs without them; `threads_sleep_parks`
// sleeps a thousand under them.
// env: AVIN_GC_STRESS=0
import avin.threads.{Atomic, sleep, spawn}
import avin.time.{millis, monotonic}

@sysl("avin.rt.scheduler_workers")
workers() -> long

@sysl("avin.rt.scheduler_releases")
releases() -> long

@sysl("avin.rt.processors")
processors() -> long

main() -> int
  val warm = (0 ..< processors() * 2).map(_ -> spawn(() -> sleep(millis(1)))).toVector
  for t in warm do t.join()
  val started = workers()
  val released = releases()
  val woke = Atomic(0)
  val t0 = monotonic()
  val all = (0 ..< 10000).map(_ -> spawn(() ->
    val before = monotonic()
    sleep(millis(200))
    if monotonic() - before >= millis(200) then woke.update(k -> k + 1))).toVector
  for t in all do t.join()
  val took = monotonic() - t0
  println(s"ten thousand sleepers woke on time: ${woke.load() == 10000}")
  println(s"in about one sleep: ${took < millis(10000)}")
  println(s"no worker added: ${workers() - started <= processors()}, none replaced: ${releases() == released}")
  0
