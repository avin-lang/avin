// expect: exit 0
// The program ends when `main` returns, as it always does: a thread pinned to the main thread that is
// still parked, or still ready and never run, does not keep it alive, and runs no further.
import avin.threads.{Channel, runMainThreads, spawnOnMain}

main()
  val c = Channel[int]()
  spawnOnMain(() ->
    println("parks")
    c.receive()
    println("never resumed"))
  println(runMainThreads())
  spawnOnMain(() -> println("never run"))
  println("main returns")
