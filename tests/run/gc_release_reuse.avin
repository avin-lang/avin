// expect: exit 0
// The heap gives the pages of large free runs back to the system after a collection, and hands them
// out again later: what is allocated into them holds what was written, new arrays start from their
// fill value whatever the pages held before, and objects kept between the released runs keep their
// contents. A burst of 64 KiB arrays with every tenth kept leaves free runs of nine arrays between
// the kept ones, and the arrays past the last kept one reach the top of the heap.

import avin.process

resident() -> long = process.residentBytes(process.pid()).ok.getOrElse(0)

// The array number `n` of a round, every element written from `n` and its index.
made(n: int, len: int) -> Array[int]
  val a = Array.fill(len, 0)
  for i in 0 ..< len do a(i) = n * 7 + i
  a

intact(a: Array[int], n: int) -> bool = (0 ..< a.length).forall(i -> a(i) == n * 7 + i)

main()
  val kept = Buffer[Array[int]]()
  var burst = Buffer[Array[int]]()
  for n in 0 ..< 450
    val a = made(n, 16384)
    if n % 10 == 0 && n < 400 then kept += a else burst += a
  println(s"kept ${kept.length}, dropped ${burst.length}")
  val peak = resident()
  burst = Buffer[Array[int]]()
  // Under stress every allocation collects: the first after the drop frees the burst, and the next
  // finds the heap reaching far past what it holds, and releases.
  for n in 0 ..< 4 do println(s"collect $n".byteLength)
  println(peak - resident() > 16777216)
  // Fresh arrays of several sizes, into the released runs and past them: each starts from its fill
  // value and holds what is written into it.
  var fresh = Buffer[Array[int]]()
  for n in 0 ..< 150
    val len = if n % 3 == 0 then 16384 else if n % 3 == 1 then 300 else 40000
    val a = Array.fill(len, -1)
    if !a.forall(x -> x == -1) then println(s"array $n did not start from its fill value")
    for i in 0 ..< len do a(i) = n * 7 + i
    fresh += a
  println((0 ..< fresh.length).forall(n -> intact(fresh(n), n)))
  // Dropped again and allocated again, so runs released once are released and reused once more.
  fresh = Buffer[Array[int]]()
  var again = Buffer[string]()
  for n in 0 ..< 4000 do again += s"string number $n after the release"
  println((0 ..< again.length).forall(n -> again(n) == s"string number $n after the release"))
  // Every kept array still holds what was written into it before any release.
  println((0 ..< kept.length).forall(k -> intact(kept(k), k * 10)))
