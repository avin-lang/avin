// expect: exit 0
// The core library's `Result`: its methods, matching it exhaustively, and its covariance in both the
// value and the error.

open class Problem(val text: string)
class Missing(text: string) : Problem(text)

show(r: Result[int, string]) -> string = r match
    Ok(v) -> s"ok $v"
    Err(e) -> s"err $e"

main()
    val good: Result[int, string] = Ok(5)
    val bad: Result[int, string] = Err("boom")
    println(s"${show(good)} ${show(bad)}")
    println(s"${good.isOk} ${good.isErr} ${bad.isOk} ${bad.isErr}")

    var evaluated = 0
    fallback() -> int
        evaluated += 1
        -1
    println(s"${good.getOrElse(fallback())} ${bad.getOrElse(fallback())} evaluated $evaluated")

    println(s"${good.ok.getOrElse(0)} ${bad.ok.isEmpty} ${good.err.isEmpty} ${bad.err.getOrElse("")}")
    println(s"${show(good.map(x -> x * 10))} ${show(bad.map(x -> x * 10))}")
    val lengths = bad.mapErr(e -> 42)
    lengths match
        Ok(_) -> println("not shown")
        Err(n) -> println(s"mapped error $n")
    println(show(good.mapErr(e -> e + "!")))
    val positive: (int) -> Result[int, string] = x -> if x > 0 then Ok(x) else Err(s"$x is not positive")
    println(s"${show(good.flatMap(positive))} ${show(Ok[int, string](-3).flatMap(positive))} ${show(bad.flatMap(positive))}")
    println(s"${good.fold(e -> 0, v -> v + 1)} ${bad.fold(e -> 0, v -> v + 1)}")
    good.foreach(v -> println(s"each $v"))
    bad.foreach(v -> println("not shown"))

    // Both parameters are covariant.
    val missing: Result[int, Missing] = Err(Missing("file"))
    val general: Result[int, Problem] = missing
    println(general.err.map(p -> p.text).getOrElse(""))
    val unknown: Result[Any, Any] = Ok("text")
    unknown match
        Ok(s: string) -> println(s"a string $s")
        Ok(_) -> println("something else")
        Err(_) -> println("an error")
