// expect: exit 0
// `equals` and `hash` may be called on any value, a value of a type parameter included, whatever its
// bounds: each instance compares and hashes as its type does.

class Word(val text: string): Eq, Hash
    override equals(other: Word) -> bool = text.byteLength() == other.text.byteLength()
    override hash() -> long = long(text.byteLength())

class Token(val id: int)

same[T](a: T, b: T) -> bool = a.equals(b)

hashOf[T](value: T) -> long = value.hash()

sameOrdered[T: Ord](a: T, b: T) -> bool = a.equals(b) && a.hash() == b.hash()

main()
    val t = Token(1)
    println(s"${same(1, 1)} ${same("a", "b")} ${same(Word("ab"), Word("cd"))} ${same(t, t)} ${same(t, Token(1))}")
    println(s"${hashOf(Word("abc"))} ${hashOf(7) == 7.hash()} ${hashOf((1, "a")) == (1, "a").hash()}")
    println(s"${sameOrdered(3, 3)} ${sameOrdered("x", "y")}")
