// expect: exit 0
// Tail calls through method tables and function values replace the caller's frame too: a lambda
// calling itself through the variable holding it, two trait methods calling each other through the
// trait, and a state machine passing itself functions as values, each a million calls deep. Arguments
// made fresh for each call, objects and closures, survive a collection at every allocation while the
// call is replacing its caller's frame. A started thread, which the runtime runs through the
// program's closure runner, runs a deep mutual recursion on a stack of its own.
import avin.threads.spawn

// A lambda reaches itself through the object it is stored in, so each call is of a function value.
data Loop(run: (Loop, int, int) -> int)

countDown(n: int) -> int
    val looping = Loop((me, k, acc) -> if k == 0 then acc else me.run(me, k - 1, acc + 2))
    looping.run(looping, n, 0)

// A lambda that captures a `var` of the function it is written in is called through an entry that
// keeps the variable's box where the lambda's code can reach it, on its own stack; that call is an
// ordinary one, and the lambda's own call in tail position is still a tail call.
captured(n: int) -> int
    var step: (int, int) -> int = (k, acc) -> acc
    step = (k, acc) -> if k == 0 then acc else step(k - 1, acc + 1)
    step(n, 0)

trait Step
    next(n: int, trail: Trail) -> int

data Trail(count: int, last: string)

class Left: Step
    override next(n: int, trail: Trail) -> int =
        if trail.last != "right" && n != 1000000 then -1
        elif n == 0 then trail.count
        else go(Right(), n - 1, Trail(trail.count + 1, "left"))

class Right: Step
    override next(n: int, trail: Trail) -> int =
        if trail.last != "left" then -1
        elif n == 0 then trail.count
        else go(Left(), n - 1, Trail(trail.count + 1, "right"))

// The step is a trait, so the call goes through its object's method table.
go(s: Step, n: int, trail: Trail) -> int = s.next(n, trail)

// A state machine whose states are function values: each state hands the next its own successor.
data State(name: string, run: (int, State) -> string)

spin(n: int, state: State) -> string = state.run(n, state)

flip(n: int, me: State) -> string =
    if n == 0 then me.name else spin(n - 1, State(s"flop", flop))

flop(n: int, me: State) -> string =
    if n == 0 then me.name else spin(n - 1, State(s"flip", flip))

isEven(n: long) -> bool = if n == 0 then true else isOdd(n - 1)

isOdd(n: long) -> bool = if n == 0 then false else isEven(n - 1)

main() -> int
    println(countDown(1000000))
    println(captured(10000))
    println(go(Left(), 1000000, Trail(0, "right")))
    println(spin(1000001, State("flip", flip)))
    val t = spawn(() -> isEven(5000000), 262144)
    println(t.join())
    0
