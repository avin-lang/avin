// expect: exit 0
// Random patterns over every construct of the pattern language (alternation, groups of each kind,
// every quantifier greedy, reluctant and possessive, back references, lookarounds, anchors and
// boundaries) on short random inputs: each line is every match with its groups' spans, whether the
// whole input matches, and the prefix match.
import avin.regex.{Regex, Match}

spans(m: Match) -> string
    val out = StringWriter()
    out.write(s"${m.start()}-${m.end()}")
    for g in 1..m.groupCount() do out.write(s" ${m.start(g)}-${m.end(g)}")
    out.text()

t(pattern: string, inputs: Array[string])
    Regex.compile(pattern) match
        Err(e) -> println(s"$pattern invalid")
        Ok(r) ->
            for input in inputs
                val all = StringWriter()
                for m in r.findAllMatchIn(input) do all.write(s"[${spans(m)}]")
                println(s"$pattern ${all.text()} ${r.matches(input)} ${r.findPrefixOf(input)}")

main()
    t("^|x(?:b)*(?=[ab]{2,}(?=(?:(?:b{2,}?c|[ab]?b{2,}\\R{0,2}+)?+(?!c*\\w{1,3}?|xbc{1,3}+|b{0,2}?)?+(?>.{1,3}|.{2,}+|aa)){1,3}|(b{1,3}b{0,2}?(?:b?+c[ab]*|c+?b{0,2}?|c{0,2}\\w{2}+b{1,3}+))*|\\1?)(?!(?<=b){2,}+.??)){1,3}+", ["bbaaa\nb", "b\nac", "", "cba"])
