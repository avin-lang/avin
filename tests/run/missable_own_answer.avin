// expect: exit 0
// A type of the program's own writes its own `Missable` answer: `Port`'s absent field is port 80. Two
// formats decode records holding a `Port`, and each takes that answer for the field left out, through
// its derived decoder. A type that derives its decoders and writes no `Missable` keeps the default,
// `None`, so its absence is still an error. A field's own default comes before its type's answer.
import avin.cbor
import avin.cbor.{CborDecoder, CborEncoder}
import avin.toml
import avin.toml.{TomlDecoder, TomlEncoder}

data Port(number: int) derives TomlEncoder, TomlDecoder, CborEncoder, CborDecoder

impl Missable for Port
  static whenMissing() -> Option[Port] = Some(Port(80))

data Host(name: string) derives TomlEncoder, TomlDecoder, CborEncoder, CborDecoder

data Server(name: string, port: Port, host: Host) derives TomlEncoder, TomlDecoder, CborEncoder, CborDecoder

data Defaulted(name: string, port: Port = Port(8080)) derives TomlEncoder, TomlDecoder, CborEncoder, CborDecoder

data OnlyName(name: string) derives TomlEncoder, CborEncoder

data NameAndHost(name: string, host: Host) derives TomlEncoder, CborEncoder

show[E: Display](label: string, r: Result[Server, E]) = r match
  Ok(s) -> println(s"$label: ${s.name} ${s.port.number} ${s.host.name}")
  Err(e) -> println(s"$label: error: $e")

main()
  val input = NameAndHost("web", Host("h"))
  show("toml", toml.decode[Server](toml.encode(input).ok.get))
  show("cbor", cbor.decode[Server](cbor.encode(input)))

  // A present port is read, not replaced.
  val full = Server("api", Port(443), Host("a"))
  show("toml full", toml.decode[Server](toml.encode(full).ok.get))
  show("cbor full", cbor.decode[Server](cbor.encode(full)))

  // `Host` keeps the default: its absence is an error naming the field.
  show("toml no host", toml.decode[Server](toml.encode(OnlyName("x")).ok.get))
  show("cbor no host", cbor.decode[Server](cbor.encode(OnlyName("x"))))

  // The field's default wins over the type's answer.
  println(toml.decode[Defaulted](toml.encode(OnlyName("d")).ok.get).ok.get.port.number)
  println(cbor.decode[Defaulted](cbor.encode(OnlyName("d"))).ok.get.port.number)

  // One answer, reached through either format's bound and the core trait.
  println(viaToml[Port]().map(p -> p.number))
  println(viaCbor[Port]().map(p -> p.number))
  println(Port.whenMissing().map(p -> p.number))
  println(Host.whenMissing().isEmpty)
  println(viaToml[Option[Port]]().map(o -> o.isEmpty))

viaToml[A: TomlDecoder]() -> Option[A] = A.whenMissing()

viaCbor[A: CborDecoder]() -> Option[A] = A.whenMissing()
