// expect: exit 0
// An integer member wider than a union's 64 bits keeps every bit: the union keeps it boxed in its
// reference word, so `i128`, `i65` and `i256` members pass through locals, parameters, results and
// storage at their least and greatest values, beside narrower members, references and each other;
// a `match`, `is`, `==`, the hash, rendering, widening, narrowing and conversion to `Any` see the
// member's own value.

data Kept(value: i128 | int)

pass(u: i128 | int | string) -> i128 | int | string = u

wide(i: int) -> i128 | int = if i > 0 then i128(170141183460469231731687303715884105727) - i128(i) else i

kind(u: i128 | int | string) -> string = u match
    w: i128 -> s"i128 $w"
    n: int -> s"int $n"
    s: string -> s"string $s"

narrow(u: i128 | int | string) -> i128 | int = u match
    x: (i128 | int) -> x
    _: string -> 0

main()
    val max: i128 | bool = i128(170141183460469231731687303715884105727)
    val min: i128 | bool = i128(-170141183460469231731687303715884105728)
    println(s"$max $min")
    val small: i65 | int = i65(-18446744073709551616)
    val big: i256 | bool = i256(1) << 254
    println(s"$small $big")
    println(kind(pass(i128(-1))))
    println(kind(pass(-1)))
    println(kind(pass("w")))
    println(kind(wide(3)))
    println(kind(wide(-3)))
    println(narrow(i128(1) << 100))
    println(narrow(5))
    println(narrow("x"))
    val a: i128 | int = i128(42)
    val b: i128 | int = 42
    println(s"${a == b} ${a == i128(42)} ${b == 42} ${a.hash() == i128(42).hash()}")
    println(s"${a is _: i128} ${a is _: int} ${b is _: int}")
    val seen: Any = a
    seen match
        w: i128 -> println(s"Any holds i128 $w")
        _ -> println("Any holds something else")
    val k = Kept(i128(-170141183460469231731687303715884105728))
    println(k)
    println(k == Kept(i128(-170141183460469231731687303715884105728)))
    val v: Vector[i128 | int] = [wide(1), wide(-1), i128(0)]
    println(v)
    val arr: Array[i256 | string] = Array.fill(2, "none")
    arr(0) = i256(-1) << 255
    println(s"${arr(0)} ${arr(1)}")
