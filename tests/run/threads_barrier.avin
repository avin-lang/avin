// expect: exit 0
// A barrier holds each party until all have arrived, runs its action once a round on the last to
// arrive with the others still waiting, and is ready for the next round: across many rounds no party
// runs ahead, exactly one `wait` a round answers `true`, and the action sees every party's work of
// that round. A barrier of one party never waits.
import avin.threads.{Atomic, Barrier, scope}

main()
  val parties = 8
  val rounds = 50
  val work = Atomic(0)
  val actions = Atomic(0)
  val bad = Atomic(0)
  val step = Barrier(parties, () ->
    // Every party's work of this round is done before the action runs.
    if work.load() != (actions.load() + 1) * parties then bad.add(1)
    actions.add(1))
  val lasts = Atomic(0)
  scope(s ->
    for _ in 0 ..< parties
      s.spawn(() ->
        for r in 0 ..< rounds
          // No party is ever a round ahead of the actions run.
          if actions.load() != r then bad.add(1)
          work.add(1)
          if step.wait() then lasts.add(1)))
  println(s"actions ${actions.load()} lasts ${lasts.load()} work ${work.load()} bad ${bad.load()}")
  println(s"parties ${step.parties} waiting ${step.waiting()}")

  // One party: every wait is the last arrival, and runs the action.
  val ran = Atomic(0)
  val alone = Barrier(1, () -> ran.add(1))
  println(s"alone ${alone.wait()} ${alone.wait()} ran ${ran.load()}")

  // No action: the default does nothing.
  val plain = Barrier(2)
  val other = Atomic(false)
  scope(s ->
    s.spawn(() -> other.store(plain.wait()))
    val mine = plain.wait()
    println(s"one last ${mine != other.load()}"))
