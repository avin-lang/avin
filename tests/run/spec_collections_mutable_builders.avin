// expect: exit 0
// Builders, buffers, deques, collections as functions and literals built by their expected type:
// a builder reused after `clear()` leaving what it handed over unchanged, `knownSize`, a buffer and a
// deque given themselves to add, every way of adding and removing, element assignment with compound
// operators, a sequence, a set and a map passed where a function is expected with variance through
// the function type, and literals of every collection kind under GC pressure.
import avin.collections.mutable.{Map as MutableMap, Set as MutableSet}

open class Animal(val name: string)
class Dog(name: string): Animal(name)

names(f: (int) -> Animal, n: int) -> string = (0 ..< n).map(i -> f(i).name).mkString(",")

main()
  val lb = List.newBuilder[int]()
  lb.addOne(1)
  lb.addAll([2, 3])
  lb.sizeHint(10)
  println(lb.knownSize)
  val first = lb.result()
  lb.clear()
  lb.addOne(9)
  val second = lb.result()
  println(s"$first $second")
  val sb = Set.newBuilder[string]()
  sb.addAll(["a", "b", "a"])
  println(sb.result().size)
  val vb = Vector.newBuilder[string]()
  for i in 0 ..< 100 do vb.addOne(i.toString())
  val hundred = vb.result()
  println(s"${hundred.length} ${hundred(31)} ${hundred(32)} ${hundred.last}")

  val b = Buffer[int]()
  b += 1
  b.append(2)
  b.addOne(3)
  b ++= [4, 5]
  b.appendAll(List(6))
  b.addAll(7 .. 8)
  b.prepend(0)
  b.prependAll([-2, -1])
  b.insert(3, 100)
  b.insertAll(1, [50, 51])
  println(s"$b ${b.remove(0)} ${b.length}")
  b ++= b
  println(b.length)
  b(0) += 1000
  b(1)++
  b(2) = 7
  println(s"${b.take(3)} ${b.lift(99)}")
  b.clear()
  b.insertAll(0, b)
  println(s"$b ${b.isEmpty}")

  val d = Deque[string]()
  d.append("b")
  d.prepend("a")
  d.addOne("c")
  d.prependAll(["x", "y"])
  d.appendAll(["z"])
  d.insert(2, "m")
  d.insertAll(0, ["p"])
  println(s"$d ${d.removeHead()} ${d.removeLast()} ${d(1)}")
  d(0) = "q"
  d.addAll(d)
  println(s"${d.length} ${d.mkString("")} ${d == ["q", "y", "m", "a", "b", "c", "q", "y", "m", "a", "b", "c"]}")
  val stack = Deque[int]()
  for i in 0 ..< 40 do stack.append(i)
  for i in 0 ..< 30 do stack.removeHead()
  for i in 0 ..< 40 do stack.append(i)
  println(s"${stack.length} ${stack(0)} ${stack(49)} ${stack.removeLast()}")

  val dogs: Vector[Dog] = [Dog("rex"), Dog("fido")]
  println(names(dogs, 2))
  val byName: Map[int, Dog] = {0: Dog("a"), 1: Dog("b")}
  println(names(byName, 2))
  val allowed: Set[string] = {"one"}
  println(["one", "two"].filter(allowed))
  val ms = MutableSet[int]()
  ms += 2
  println([1, 2, 3].filter(ms))
  val mm = MutableMap[int, string]()
  mm(0) = "zero"
  println([0, 0].map(mm))
  val fs: Vector[(int) -> string] = [["w0", "w1"], i -> s"#$i"]
  println(fs.map(f -> f(1)))
  println((0 ..< 100 by 5)(3))

  var total = 0
  for round in 0 ..< 200
    val asList: List[string] = ["a", round.toString()]
    val asArray: Array[int] = [round, round + 1]
    val asBuffer: Buffer[(int, string)] = [(round, "x")]
    val asDeque: Deque[Option[int]] = [Some(round), None]
    val asSet: Set[List[int]] = {[round], []}
    val asMap: Map[string, Vector[int]] = {k: [round], j: []}
    val asTree: TreeMap[int, string] = {(round): "r", -1: "m"}
    val asMutable: MutableMap[string, int] = {a: round}
    val nestedLit = [{1: [2]}, {}]
    total += asList.length + asArray(1) - round + asBuffer.length + asDeque.length + asSet.size + asMap(
      "k"
    ).length + asTree.size + asMutable("a") - round + nestedLit.length
  println(total)
