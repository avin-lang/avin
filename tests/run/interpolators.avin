// expect: exit 0
// Every interpolated string is a call on a `StringContext`: the parts as written, the holes as the
// method's arguments, each evaluated once, left to right. `s` decodes the parts' escapes, `raw`
// keeps them, and a program's own interpolator is a method a trait gives `StringContext`.
data Pair(left: int, right: int)

trait Shout
  shout(args: Display*) -> string

impl Shout for StringContext
  shout(args: Display*) -> string = s(args*).toUpper

trait Pairs
  pair(left: int, right: int) -> Pair

impl Pairs for StringContext
  pair(left: int, right: int) -> Pair = Pair(left, right)

trait Pieces
  pieces(args: Display*) -> Vector[string]

impl Pieces for StringContext
  pieces(args: Display*) -> Vector[string] = parts

var calls = 0

next() -> int
  calls += 1
  calls

main()
  val id = 7
  println(raw"a\tb $id\n $$ \\ \u00e9")
  println(s"a\tb $id $$|")
  println(StringContext(["a\\tb ", "|"]).s(id))
  println(StringContext(["x", "y"]).raw(1))
  println(shout"hi $id there, ${(1, 'c')}")
  println(raw"")
  println(raw"${id}${id}")
  println(StringContext(["\\u00e9\\x41\\u{1F600}\\uD83D\\uDE00\\\"\\\\\\'\\`\\/\\0|\\e|"]).s().byteLength)
  println(StringContext(["\\n\\t\\r\\a\\b\\f\\v"]).s().bytes)
  val p: Pair = pair"${next()} then ${next()}"
  println(p)
  println(pieces"a${1}b${2}c")
  println(pieces"$id$id")
  println(pieces"é $$ ${"in a hole"} \t")
