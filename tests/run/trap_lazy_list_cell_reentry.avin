// expect: trap
// A lazy list whose first element reads that same list's first cell traps when the cell is first
// read, naming the lazy list's cell, not anything inside it. Before that, a list reading another
// list's cells while its own is evaluated (a `map` over its source) is fine.

lazy val again: LazyList[int] = LazyList.continually(again.head)

main()
  val source = 1 #:: 2 #:: LazyList.empty[int]()
  println(source.map(x -> x * 10).toVector)
  println(again.isEvaluated())
  println(again.head)
  println("not reached")
