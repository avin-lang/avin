// expect: exit 0
// A union parameter accepts every value that injects into it. An overload taking the argument's own
// type is more specific than one taking a union it belongs to, and a union is more specific than a
// type its members all convert to (`Any`, a trait). Of two unions neither converting to the other, a
// union argument picks the one it converts to. A plain overload is more specific than a generic one
// taking the same argument. Methods, static members and named arguments choose the same way.

show(n: int) -> string = "int"
show(x: int | string) -> string = "int or string"
show(x: Any) -> string = "any"

f(x: int | string) -> string = "int | string"
f(x: int | bool) -> string = "int | bool"

g[T](x: T) -> string = "generic"
g(x: int | string) -> string = "union"

trait Animal
    name() -> string

class Dog(n: string): Animal
    override name() -> string = n

class Cat(n: string): Animal
    override name() -> string = n

class Fish

pet(a: Dog) -> string = "dog"
pet(a: Dog | Cat) -> string = "dog or cat"
pet(a: Animal) -> string = "animal"

wide(x: int | string) -> string = "two"
wide(x: int | string | bool) -> string = "three"

class Printer
    put(n: int) -> string = s"int $n"
    put(x: int | string) -> string = s"union $x"
    put(x: Display) -> string = s"display $x"

object Make
    of(n: long) -> string = s"long $n"
    of(x: long | string) -> string = s"long or string $x"

named(x: int | string, label: string = "-") -> string = s"$label$x"

main()
    // The literal's own type, the union, and the supertype.
    println(show(1))
    println(show("a"))
    println(show(true))
    println(show(2.5))
    val u: int | string = "z"
    println(show(u))
    val three: int | string | bool = false
    println(show(three))
    // A union argument picks the union it converts to; a member value the narrowest that fits.
    val ib: int | bool = true
    println(f(u))
    println(f(ib))
    println(f("s"))
    println(f(false))
    // Generic against union.
    println(g(1))
    println(g(u))
    println(g(true))
    println(g[int | string](u))
    // Classes, unions of classes and a trait.
    println(pet(Dog("rex")))
    println(pet(Cat("tom")))
    val dc: Dog | Cat = Dog("fido")
    println(pet(dc))
    val an: Animal = Cat("kit")
    println(pet(an))
    // A smaller union is more specific than a wider one containing it.
    println(wide(1))
    println(wide(u))
    println(wide(true))
    println(wide(three))
    // Methods and static members.
    val p = Printer()
    println(p.put(7))
    println(p.put("x"))
    println(p.put(u))
    println(p.put(1.5))
    println(Make.of(5_000_000_000))
    println(Make.of("t"))
    val ls: long | string = 3
    println(Make.of(ls))
    // Named and default arguments.
    println(named(4))
    println(named(x = "q", label = "#"))
    println(named(label = "@", x = u))
