// expect: exit 0
// A linked map iterates in insertion order: after puts, updates (which keep the place), removals and
// re-puts (which make the key new), through every way of reading it; plus its whole mutable API.

import avin.collections.mutable.{LinkedMap, LinkedSet}

var computed = 0

// `value`, counting the calls.
compute(value: int) -> int
    computed += 1
    value

main()
    // Empty.
    val m = LinkedMap[string, int]()
    println(s"${m.size} ${m.isEmpty} ${m.nonEmpty} ${m.get("a")} ${m.headOption} ${m.lastOption} $m")
    println(s"${m.keys} ${m.values} ${m.toMap} ${m.remove("a")} ${m.contains("a")}")
    for e in m do println("never")

    // One entry.
    m("a") = 1
    println(s"${m.size} ${m.isEmpty} ${m.get("a")} ${m.head} ${m.last} $m ${m("a")}")

    // Order after put / update / remove / re-put.
    m("b") = 2
    m("c") = 3
    m("a") = 10
    println(s"$m ${m.keys} ${m.values}")
    println(s"${m.remove("a")} ${m.remove("zz")} $m")
    m("a") = 11
    println(s"$m ${m.headOption} ${m.lastOption}")
    m("b") = 20
    println(s"$m")
    println(s"${m.size} ${m.keySet.size} ${m.toMap}")

    // Operators and bulk methods.
    m += ("d", 4)
    m ++= [("e", 5), ("a", 12), ("f", 6)]
    println(s"$m")
    m -= "d"
    m -= "nothing"
    m --= ["e", "c", "nothing"]
    println(s"$m")
    m.addAll([("x", 0), ("b", 21)])
    println(s"$m")

    // getOrElse, getOrElseUpdate, updateWith.
    println(s"${m.getOrElse("b", compute(-1))} ${m.getOrElse("q", compute(-1))} $computed")
    println(s"${m.getOrElseUpdate("n", compute(99))} ${m.getOrElseUpdate("n", compute(98))} $computed $m")
    println(s"${m.updateWith("n", o -> o.map(v -> v + 1))} ${m.updateWith("k", o -> Some(5))} ${m.updateWith("x", o -> None)} $m")
    println(s"${m.updateWith("gone", o -> None)} $m")

    // Re-putting a key keeps its place; putLast and moveToEnd move it.
    m.putLast("a", 100)
    println(s"$m")
    m.putLast("brand new", 7)
    println(s"$m")
    println(s"${m.moveToEnd("b")} ${m.moveToEnd("absent")} $m")

    // filterInPlace, filter, map, transform, mapValues, filterKeys, flatMap, copy, withFilter.
    val c = m.copy()
    c.filterInPlace((k, v) -> v > 7)
    println(s"$c $m")
    println(s"${m.filter((k, v) -> v % 2 == 0)} ${m.filterKeys(k -> k.byteLength() == 1)}")
    println(s"${m.mapValues(v -> v * 2)} ${m.transform((k, v) -> s"$k$v")}")
    println(s"${m.map((k, v) -> (v % 3, k))}")
    println(s"${m.flatMap(entry -> [(entry.0, 1), (entry.0 + "!", 2)])}")
    val bumped: LinkedMap[string, int] = for (k, v) in m if v > 7 yield (k, v + 1)
    println(s"$bumped")

    // foreach order, and an entry whose value is replaced in place.
    var sb = ""
    m.foreach((k, v) -> sb += s"$k=$v,")
    println(sb)

    // clear, then reuse.
    m.clear()
    println(s"${m.size} $m ${m.headOption} ${m.lastOption}")
    m("z") = 1
    m("y") = 2
    println(s"$m")

    // Equality ignores order; hash agrees; copies are independent.
    val p = LinkedMap[int, string]()
    val q = LinkedMap[int, string]()
    p(1) = "a"
    p(2) = "b"
    q(2) = "b"
    q(1) = "a"
    println(s"${p == q} ${p.hash() == q.hash()} ${p === q} $p $q")
    q(3) = "c"
    println(s"${p == q}")
    val r = p.copy()
    r(9) = "z"
    println(s"$p $r")

    // The builder, Iterable and function views, empty().
    val built = LinkedMap.newBuilder[int, int]()
    built.addOne((3, 30))
    built.addOne((1, 10))
    built.addOne((3, 31))
    println(s"${built.result()} ${LinkedMap.empty[int, int]()}")
    val f: (int) -> string = p
    println(s"${[1, 2].map(f)} ${p.iterator().toVector} ${p.keysIterator().toVector} ${p.valuesIterator().toVector}")

    // Unicode and unit-valued sets built on it.
    val u = LinkedMap[string, int]()
    u("é") = 1
    u("日本") = 2
    u("") = 3
    u("😀") = 4
    println(s"$u ${u("日本")} ${u.get("")}")

    // Values of reference type, mutated through the map.
    val lists = LinkedMap[int, Buffer[int]]()
    for i in 0..<3 do lists(i) = Buffer[int]()
    for i in 0..<9 do lists(i % 3).addOne(i)
    println(s"$lists")

    // A set of linked maps' keys, from the map.
    println(s"${LinkedSet[int]().size}")
