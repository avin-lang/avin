// expect: exit 0
// A `using` section declares contextual parameters on functions, methods, static members, local
// functions, clauses, class constructors and lambdas; inside the body each is a value of its name,
// and a call passes one explicitly by name. A trait method's section is implemented with the same
// one. A contextual class parameter is a private field its methods read.

trait Logger
  write(message: string) -> string

class Prefixed(prefix: string): Logger
  override write(message: string) -> string = prefix + message

data Tx(id: int)

insert(row: string, using tx: Tx, log: Logger) -> string = log.write(s"$row in ${tx.id}")

now(using tick: Tx = Tx(100)) -> int = tick.id

class Service(name: string, using log: Logger)
  greet() -> string = log.write(name)

trait Store
  put(key: string, using tx: Tx) -> int

class Memory: Store
  override put(key: string, using tx: Tx) -> int = key.byteLength + tx.id

trait Made
  static make(using tx: Tx) -> Self

data Stamp(id: int)

impl Made for Stamp
  static make(using tx: Tx) -> Stamp = Stamp(tx.id * 2)

describe(n: int, using tx: Tx) -> string
describe(0) = s"none in ${tx.id}"
describe(n) = s"$n in ${tx.id}"

main()
  val tx = Tx(7)
  val log: Logger = Prefixed("> ")
  println(insert("row", tx = tx, log = log))
  println(now())
  println(now(tick = Tx(1)))
  println(Service("svc", log = log).greet())
  val store: Store = Memory()
  println(store.put("key", tx = tx))
  println(describe(0, tx = tx))
  println(describe(3, tx = tx))
  println(Stamp.make(tx = tx).id)
  twice(n: int, using tx: Tx) -> int = n * 2 + tx.id
  println(twice(5, tx = tx))
  val f = (using t: Tx) -> t.id + 1
  println(f(tx))
  val g = (n: int, using t: Tx) -> n + t.id
  println(g(1, tx))
