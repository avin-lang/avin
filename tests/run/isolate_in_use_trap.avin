// expect: trap
// `with` holds the objects while its function runs, so a `take` of the same `Isolated` from inside
// the function traps; afterwards they are held again.
import avin.actors.isolate

main()
  val chunk = isolate(Buffer[int]())
  println(chunk.with(b -> b.size))
  println(chunk.with(b -> b.size))
  chunk.with(b -> chunk.take().size)
  println("not reached")
