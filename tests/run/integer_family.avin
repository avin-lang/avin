// The integers are one family: every width has Display, Debug, Ord and the arithmetic traits from
// one impl of each in the core library, so a width no program has used before prints, compares and
// meets a bound like `int` does. A value that fits in a `long` renders through it; a wider one in
// chunks of eighteen digits, padded with zeros inside the number.

max[T: Ord](a: T, b: T) -> T = if a > b then a else b

sum[T: Add](xs: Vector[T], zero: T) -> T
    var total = zero
    for x in xs
        total = total + x
    total

// A type parameter bounded by `Integer` has the operators, both text forms, and conversions to and
// from the other integer types.
describe[T: Integer](x: T) -> string = s"$x long ${long.wrap(x)} doubled ${x + x} sign ${x.compare(T(0))}"

narrow[T: Integer](n: long) -> T = T.wrap(n)

field[T: Display](x: T, width: int, left: bool) -> string
    val out = StringWriter()
    x.display(out, FormatSpec(width, -1, left))
    out.text()

main()
    println(i1(-1))
    println(i1(0))
    println(i4(-8))
    println(i4(7))
    println(i5(-16))
    println(i5(15))
    println(i24(-8388608))
    println(i24(8388607))
    println(long(-9223372036854775807) - 1)
    println(long(9223372036854775807))
    val low: i128 = -170141183460469231731687303715884105728
    val high: i128 = 170141183460469231731687303715884105727
    println(low)
    println(high)
    val least: i257 = -115792089237316195423570985008687907853269984665640564039457584007913129639936
    val most: i257 = 115792089237316195423570985008687907853269984665640564039457584007913129639935
    println(least)
    println(most)
    // Just past `long`, and chunks with zeros inside them.
    println(i65(-18446744073709551616))
    println(i128(9223372036854775807) + 1)
    println(i128(-9223372036854775807) - 2)
    println(i128(100000000000000000007))
    println(i128(-100000000000000000000000000000000000001))
    // Debug and toString are the same digits.
    println(debug(i4(-8)))
    println(debug(i5(9)))
    println(debug(low))
    println(debug(least))
    println(i5(-3).toString() + "|" + high.toString() + "|" + i24(42).toString())
    // A field is filled around the whole number, at any width.
    println(s"[${field(i5(-7), 5, false)}] [${field(i5(-7), 5, true)}] [${field(high, 42, false)}] [${field(low, 41, true)}]")
    // Bounds met by every width.
    println(max(i5(3), i5(-4)))
    println(max(low, high))
    println(max(i128(-5), i128(-6)))
    println(sum([i24(1), i24(2), i24(3)], i24(0)))
    println(sum([i128(10000000000000000000), i128(10000000000000000000)], i128(0)))
    println([i5(1), i5(-2), i5(3)])
    println(describe(i5(-3)))
    println(describe(i24(1000)))
    println(describe(high / i128(4)))
    // Narrowing to a width keeps the low bits: 35 is 0b100011, so its low five bits are 3.
    val n: i5 = narrow(35)
    println(n)
    val m: i128 = narrow(-1)
    println(m)
    // The trait methods behind the operators, called by name.
    println(i24(5).add(i24(6)))
    println(i24(5).subtract(i24(6)))
    println(i24(5).multiply(i24(6)))
    println(i24(17).divide(i24(5)))
    println(i24(17).remainder(i24(5)))
    println(i24(5).negate())
    println(i5(3).compare(i5(3)))
    println(high.less(low))
    println(low.lessOrEqual(high))
    // Equal values hash equally, and a wide width is a map key.
    println(i5(3).hash() == i5(3).hash())
    println(high.hash() == i128(170141183460469231731687303715884105727).hash())
    println(least.hash() == i257(-115792089237316195423570985008687907853269984665640564039457584007913129639936).hash())
    var keys = Map[i128, string]()
    keys = keys.updated(high, "most").updated(low, "least").updated(i128(-1), "minus one")
    println(keys(i128(170141183460469231731687303715884105727)))
    println(keys(i128(-170141183460469231731687303715884105728)))
    println(keys(i128(-1)))
    println(keys.get(i128(0)).isEmpty())
