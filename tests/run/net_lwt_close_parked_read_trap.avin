// expect: trap
// A connection a thread is parked reading belongs to that thread, so closing it from elsewhere traps
// rather than pulling the socket out from under the wait; the wait itself ends only when the other
// end sends, finishes or the connection's timeout runs out.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.threads.{sleep, spawn}
import avin.time.millis

@sysl("avin.rt.socket_waiters")
socketWaiters() -> long

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message)

main()
    val l = ok(TcpListener.bind("127.0.0.1", 0))
    val c = ok(TcpStream.connect("127.0.0.1", l.port()))
    val s = ok(l.accept())
    val t = spawn(() -> s.read(1).isOk())
    while socketWaiters() < 1
        sleep(millis(1))
    println("parked")
    s.close()
    println("not reached")
    c.close()
    println(t.join())
