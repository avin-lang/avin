// `start()` starts a command and answers at once with a `Child`: `waitFor()` waits and answers the
// same status every time, `isAlive()` asks without waiting, and `kill()` stops every program of the
// command still running and starts no part not yet started. Several children run at once.
import avin.process.{Command, Child}

started(c: Command) -> Child = c.start() match
  Ok(child) -> child
  Err(e) -> fail(s"not started: $e")

main()
  val quick = started(Command("/bin/sh", "-c", "exit 4"))
  println(quick.waitFor())
  println(quick.waitFor())
  println(quick.isAlive())
  // A long one is alive until it is killed, and its status says the signal.
  val sleeper = started(Command("/bin/sleep", "30"))
  println(sleeper.isAlive())
  sleeper.kill()
  println(sleeper.waitFor())
  println(sleeper.isAlive())
  // Killing a child that has ended does nothing.
  sleeper.kill()
  println(sleeper.waitFor())
  // A killed sequence starts nothing more.
  val sequence = started(Command("/bin/sleep", "30") followedBy Command("/bin/echo", "never printed"))
  sequence.kill()
  println(sequence.waitFor())
  // A killed pipeline ends every stage.
  val pipeline = started(Command("/bin/sleep", "30") | Command("/bin/sleep", "30"))
  println(pipeline.isAlive())
  pipeline.kill()
  println(pipeline.waitFor())
  // Several at once, waited for in any order: three sleeps of a second each take about a second.
  val many = (0 ..< 3).map(i -> started(Command("/bin/sh", "-c", s"sleep 1; exit $i"))).toVector
  println(many.reverse.map(c -> c.waitFor()))
  // A sequence started is moved on by asking whether it is alive, and by waiting.
  val steps = started(Command("/usr/bin/true") andThen Command("/bin/echo", "second part"))
  println(steps.waitFor())
  // A command that cannot be started.
  println(Command("avin-no-such-program").start().map(c -> c.waitFor()))
