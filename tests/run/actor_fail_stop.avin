// expect: exit 0
// A trap in an arm fails only its actor. With `onFailure = Stop` the actor ends: the message being
// handled is dropped with the rest of its mailbox, its `stopping` block runs, its `ended()` is
// `Failed` with the trap's reason, and every actor watching it is told, by message and by function.
// The report names the actor. Other actors go on running and their state is untouched, and a trap
// inside the core library is reported where the actor's code called it.
import avin.actors.{ActorRef, Ending, Failed, Stop, Stopped, spawn}
import avin.threads.Channel
import avin.time

data Msg
  Add(n: int)
  Index(i: int)
  Divide(by: int)
  Deep(n: int)
  Get(reply: ActorRef[int])

actor Counter(log: Channel[string]) receives Msg
  var count = 0
  receive
    Add(n) -> count += n
    Index(i) -> count = Vector(1, 2, 3)(i)
    Divide(by) -> count = count / by
    Deep(n) -> count = down(n, x -> x / (x - x))
    Get(r) -> r.tell(count)
  stopping
    log.send(s"stopping $self at $count")

// Recursion through a closure, so the trap is several frames below the arm.
down(n: int, f: (int) -> int) -> int = if n == 0 then f(7) else 1 + down(n - 1, f)

data Seen
  Told(who: string)
  Ended(e: Ending)

actor Watcher(target: ActorRef[Msg], out: Channel[string]) receives Seen
  watch(target, Told(target.toString()))
  receive
    Told(who) -> out.send(s"told: $who ended")
    Ended(e) -> out.send(s"by function: $e")

actor FnWatcher(target: ActorRef[Msg], out: Channel[string]) receives Seen
  watch(target, e -> Ended(e))
  receive
    Told(who) -> out.send(who)
    Ended(e) -> out.send(s"by function: $e")

main()
  val log = Channel[string]()
  val other = spawn(Counter(log), onFailure = Stop)
  other.tell(Add(5))
  // An integer overflow in an arm.
  val a = spawn(Counter(log), onFailure = Stop)
  val seen = Channel[string]()
  spawn(Watcher(a, seen))
  a.tell(Add(2147483647))
  a.tell(Add(1))
  a.tell(Add(100))
  println(a.ended().await())
  println(log.receive())
  println(seen.receive())
  // An index out of range in the library, reported where the arm indexed.
  val b = spawn(Counter(log), onFailure = Stop)
  spawn(FnWatcher(b, seen))
  b.tell(Index(3))
  println(b.ended().await())
  println(log.receive())
  println(seen.receive())
  // A division by zero several calls below the arm.
  val c = spawn(Counter(log), onFailure = Stop)
  c.tell(Add(1))
  c.tell(Deep(5))
  println(c.ended().await())
  println(log.receive())
  // A message to an actor that has ended is dropped, and an ask of it answers at once.
  c.tell(Add(1))
  println(c.ask(r -> Get(r), timeout = time.seconds(60)).await())
  // The other actor never noticed.
  other.tell(Add(2))
  println(other.ask(r -> Get(r), timeout = time.seconds(60)).await())
