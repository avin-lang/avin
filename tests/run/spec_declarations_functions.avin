// expect: exit 0
// Spec probes for declarations, Functions: a subclass passing a repeated argument on, constructor and
// trait-method defaults, a fresh default per call, a strict overload chosen once, a repeated overload
// losing to a fixed one, a repeated function as a value, splices of every sequence, and clauses over it.
import avin.collections.mutable.{Map as MutableMap}

open class Path(val parts: string*)
    joined() -> string = parts.mkString("/")

class AbsPath(parts: string*): Path(parts*)
    override joined() -> string = "/" + super.joined()

open class Base(val a: int, val b: int = 7)
class Derived(x: int): Base(x)

class Ctor(a: int, b: int = a * 2)
    val sum = a + b

trait Greeter
    greet(name: string, punct: string = "!") -> string

class Hi: Greeter
    override greet(name: string, punct: string) -> string = s"hi $name$punct"

fresh(b: MutableMap[int, int] = MutableMap[int, int]()) -> MutableMap[int, int]
    b(b.size) = 1
    b

eager(x: int) -> string = s"strict $x"
eager(x: string) -> string = "s"

counted(tag: string, n: int) -> int
    println(tag)
    n

pick(x: long) -> string = "long"
pick(xs: int*) -> string = "many"

total(values: int*) -> int
    var sum = 0
    for v in values do sum += v
    sum

firstOr(xs: int*) -> int
firstOr([]) = -1
firstOr([x]) = x
firstOr(xs) = xs.length

main()
    println(AbsPath("usr", "bin").joined())
    println(s"${Derived(1).b}")
    println(s"${Ctor(3).sum} ${Ctor(3, 1).sum}")
    val g: Greeter = Hi()
    println(g.greet("ann"))
    println(Hi().greet("bo", "?"))
    println(s"${fresh().size} ${fresh().size}")
    println(eager(counted("once", 4)))
    println(pick(1))
    val f: (Vector[int]) -> int = total
    println(s"${f([1, 2])}")
    val xs = [4, 5]
    println(s"${total(([1, 2] ++ xs)*)} ${total(List(1, 2)*)} ${total(Set(3)*)} ${total((1..10)*)} ${total(Array.fill(3, 2)*)}")
    println(s"${firstOr()} ${firstOr(9)} ${firstOr(1, 2, 3)}")
