// Assertions that hold let the program carry on, whatever the type compared; a `@test` function is
// compiled with the program and is not run by it.

data Point(x: int, y: int) derives Eq, Debug

@test
neverRun()
  println("a test does not run when the program does")

main()
  assert(1 + 1 == 2)
  assert("ab".byteLength == 2, "a two-letter string is two bytes")
  assertEq(6 * 7, 42)
  assertEq("text", "te" + "xt")
  assertEq(Point(1, 2), Point(1, 2))
  assertEq([1, 2, 3], [1, 2, 3])
  assertEq('c', 'c')
  assertEq(2.5, 2.5)
  assertEq(Some(3), Some(3))
  val none: Option[string] = None
  assertEq(none, None)
  assertEq(Some([1, 2]), Some([1, 2]))
  println("every assertion held")
