// expect: exit 0
// env: AVIN_GC_STRESS=0
// Far more threads than processors spin until told to stop, polling an atomic flag, and then as many
// in a tight loop that makes no call at all, so every worker is held by a thread that never waits. A thread
// started after them still runs, and plays four rounds with the main thread: each spinning thread
// that has run for its slice while another is ready yields at its next poll and goes to the back of
// the queue. Without that the spinners would keep their workers for ever and nothing would end.
import avin.threads.{Atomic, Channel, spawn}

spinPolling(stop: Atomic[bool]) -> long
    var n: long = 0
    while !stop.load() do n += 1
    n

spinTight(stop: Atomic[bool]) -> long
    var rounds: long = 0
    while !stop.load()
        var i = 0
        while i < 100000 do i += 1
        rounds += 1
    rounds

// Starts 256 spinners of one kind, plays four rounds with a thread started after them, and stops
// them.
contend(tight: bool) -> string
    val stop = Atomic(false)
    val spinners = (0..<256).map(_ -> spawn(() -> if tight then spinTight(stop) else spinPolling(stop))).toVector()
    val ping = Channel[int]()
    val pong = Channel[int]()
    val player = spawn(() ->
        for n in ping do pong.send(n + 1)
        "played")
    var last = 0
    for _ in 0..<4
        ping.send(last)
        last = pong.receive().getOrElse(-1)
    ping.close()
    val played = player.join()
    stop.store(true)
    val ended = spinners.map(t -> t.join()).forall(n -> n >= 0)
    s"$played $last rounds while every worker spun, and the spinners ended $ended"

main() -> int
    println(contend(false))
    println(contend(true))
    0
