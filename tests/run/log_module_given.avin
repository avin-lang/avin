// expect: exit 0
// `avin.log` through a module-level given: every function of the module finds it without passing it,
// a block's given hides it, the record functions imported by name (`debug` among them, beside the
// prelude's `debug` of a value) write through it, the standard error sink writes each line in one
// write with no colour where standard error is not a terminal, and the standard output sink likewise.
import avin.log
import avin.log.{Json, Level, Logger, debug, info, stderrSink, stdoutSink}
import avin.time.{Instant, epochSeconds}

private fixed() -> Instant = epochSeconds(86400)

given appLog: Logger = Logger(level = Level.Debug, sink = stderrSink(), clock = fixed, fields = [("app", "demo")])

handle(id: int)
  val reqLog = appLog.child([("request", id)])
  given r: Logger = reqLog
  info("handling")
  log.trace("never written")
  helper()

helper(using logger: Logger)
  debug("helper", [("depth", 1)])

main()
  info("started", [("port", 8080)])
  handle(7)
  log.warn("plain warn")
  println(appLog.enabled(Level.Trace), appLog.enabled(Level.Debug))
  val out = Logger(format = Json, sink = stdoutSink(), clock = fixed)
  out.info("to stdout", [("ok", true)])
  println(stderrSink().colours, stdoutSink().colours)
