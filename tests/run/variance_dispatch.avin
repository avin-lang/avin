// expect: exit 0
// Covariant and contravariant views of open classes, data types and tuples: a call through a view
// reaches the method of the object's own class, and a type pattern on an `Any` finds the views an
// object's class and traits have.

open class Animal(val name: string)
    sound() -> string = "..."

class Dog(name: string) : Animal(name)
    override sound() -> string = "woof"

open class Shelf[+T](val item: T)
    top() -> T = item
    label() -> string = "shelf"

class DogShelf(d: Dog) : Shelf[Dog](d)
    override top() -> Dog = Dog(s"${item.name} junior")
    override label() -> string = "dog shelf"

trait Source[+T]
    next() -> T

class Kennel(val dog: Dog) : Source[Dog]
    override next() -> Dog = dog

// A contravariant data type: its field takes a `T` in.
data Handler[-T](run: (T) -> int)

handleDog(h: Handler[Dog], d: Dog) -> int = h.run(d)

// A method with type parameters of its own, called through a covariant view.
class Crate[+T](val item: T)
    map[U](f: (T) -> U) -> Crate[U] = Crate(f(item))

firstOf(p: (Any, Animal)) -> string = p match
    (s: string, a) -> s"$s ${a.name}"
    _ -> "?"

names(make: () -> Any) -> string = make() match
    s: string -> s
    _ -> "?"

main() -> int
    val shelf: Shelf[Animal] = DogShelf(Dog("rex"))
    println(s"${shelf.label()}: ${shelf.top().name} says ${shelf.top().sound()}")
    val plain: Shelf[Animal] = Shelf(Dog("fido"))
    println(s"${plain.label()}: ${plain.top().name}")
    val h: Handler[Animal] = Handler((a) -> if a.name == "max" then 7 else 0)
    if handleDog(h, Dog("max")) != 7 then return 1
    val crate: Crate[Animal] = Crate(Dog("bo"))
    println(crate.map((a) -> a.sound()).item)
    println(firstOf(("pair", Dog("ace"))))
    println(names(() -> "a string result"))
    val held: Any = Kennel(Dog("lassie"))
    held match
        s: Source[Animal] -> println(s"a source of ${s.next().name}")
        _ -> return 2
    val shelved: Any = DogShelf(Dog("spot"))
    shelved match
        s: Shelf[Animal] -> println(s"a shelf of ${s.top().name}")
        _ -> return 3
    shelved match
        _: Shelf[string] -> return 4
        _ -> ()
    0
