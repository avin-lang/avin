// expect: exit 0
// The iterators made from an iterator read their source only as far as they are asked: a `map`
// followed by `take(3)` calls the mapped function three times, however long the source is, and
// `filter`, `takeWhile` and `dropWhile` call their test only on the elements they reach. `zip` ends
// with the shorter side, and the methods every `Iterable` has consume an iterator.
class Naturals(private var n: int): Iterator[int]
    override hasNext() -> bool = true
    override next() -> int
        n += 1
        n

main()
    var calls = 0
    val square: (int) -> int = x ->
        calls += 1
        x * x
    val firstThree = Naturals(0).map(square).take(3)
    println(calls)
    println(firstThree.toVector())
    println(calls)

    var tested = 0
    val even: (int) -> bool = x ->
        tested += 1
        x % 2 == 0
    val evens = Naturals(0).filter(even)
    println(evens.next())
    println(evens.next())
    println(tested)

    var checked = 0
    val below4: (int) -> bool = x ->
        checked += 1
        x < 4
    val small = Naturals(0).takeWhile(below4)
    println(checked)
    println(small.toList())
    println(checked)

    var skipped = 0
    val below7: (int) -> bool = x ->
        skipped += 1
        x < 7
    val later = (1 .. 10).iterator().dropWhile(below7)
    println(skipped)
    println(later.toVector())
    println(skipped)

    println((1 .. 10).iterator().drop(7).toVector())
    println((1 .. 3).iterator().drop(5).hasNext())
    println((1 .. 3).iterator().take(0).hasNext())
    println((1 .. 3).iterator().take(-1).toVector())
    println(Naturals(0).drop(100).next())
    println((1 .. 3).iterator().dropWhile(x -> x < 9).toVector())
    println((1 .. 3).iterator().takeWhile(x -> x < 9).toVector())

    val words: Vector[string] = ["one", "two", "three"]
    for (n, w) in Naturals(0).zip(words.iterator()) do println(s"$n $w")
    for (w, i) in words.iterator().zipWithIndex() do println(s"$i:$w")
    println(words.iterator().zip(Naturals(10)).map(p -> s"${p.0}${p.1}").mkString(" "))

    // Chained, still lazy.
    var steps = 0
    val step: (int) -> int = x ->
        steps += 1
        x
    val chain = Naturals(0).map(step).filter(x -> x % 3 == 0).drop(1).take(2)
    println(steps)
    println(chain.toVector())
    println(steps)

    // The `Iterable` methods consume.
    val it = (1 .. 5).iterator()
    println(it.find(x -> x == 2).getOrElse(0))
    println(it.next())
    println(it.count(x -> x > 0))
    println(it.isEmpty())
    println(Naturals(0).take(4).sum())
    println(Naturals(0).take(4).max().getOrElse(0))
    println(Naturals(0).exists(x -> x > 1000))

    val empty: Vector[int] = []
    println(empty.iterator().map(x -> x + 1).hasNext())
    println(empty.iterator().filter(x -> true).toVector())
    println(empty.iterator().zip(Naturals(0)).hasNext())
    println(empty.iterator().takeWhile(x -> true).hasNext())
    println(empty.iterator().dropWhile(x -> true).hasNext())
    println(empty.iterator().zipWithIndex().hasNext())
