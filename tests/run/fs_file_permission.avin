// A file the program may not open is `PermissionDenied`, in each way of opening it. The mode is set
// with `chmod`; where the program runs as a user the mode does not bind, the checks are skipped.
import avin.fs
import avin.io.{IoError, PermissionDenied}
import avin.fs.File
import avin.process.Command

failure(r: Result[File, IoError]) -> string = r match
    Ok(h) ->
        h.close()
        "opened"
    Err(e) -> s"Err($e)"

// The temporary directory the test works in, written as `DIR` in what it prints, which an error
// names, so the output is the same on every run.
var root = ""

say(line: Any)
    println(if root == "" then s"$line" else s"$line".replace(root, "DIR"))

main()
    val dir = fs.createTempDir("avin-perm").get()
    root = dir
    val f = dir + "/f"
    fs.writeText(f, "secret")
    Command("chmod", "000", f).run()
    if fs.readText(f).isOk()
        say("mode does not bind")
        Command("chmod", "644", f).run()
        fs.removeDirAll(dir)
        return
    say(failure(fs.open(f)))
    say(failure(fs.openUpdate(f)))
    say(failure(fs.append(f)))
    say(failure(fs.create(f)))
    say(failure(fs.createUpdate(f)))
    say(fs.readBytesFrom(f, 0))
    say(fs.readTail(f, 4))
    say(fs.readTailLines(f, 4))
    // Read-only: reading opens, writing does not.
    Command("chmod", "444", f).run()
    say(failure(fs.open(f)))
    say(failure(fs.append(f)))
    say(failure(fs.create(f)))
    // Restored, it opens again and still holds what it did.
    Command("chmod", "644", f).run()
    say(fs.readText(f))
    fs.removeDirAll(dir)

impl[T] Result[T, IoError]
    get() -> T = self match
        Ok(v) -> v
        Err(e) -> fail(s"unexpected $e")
