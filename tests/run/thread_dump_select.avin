// expect: exit 0
// stderr: times vary
// The quit signal's thread dump shows a thread parked in a `select` as waiting in a select, with how
// many channels its arms wait on and for how long, and one whose select has an `after` as waiting
// with a time limit. Both go on once the dump is written: a value sent ends the first, and the second
// is ended by its channel's value before its hour is up.
import avin.process
import avin.signal
import avin.threads.{Channel, spawn}
import avin.time.hours

@sysl("avin.rt.thread_dumps")
dumps() -> long

@sysl("avin.rt.lightweight_parked")
parked() -> long

main()
  val a = Channel[int]()
  val b = Channel[int]()
  val full = Channel[int](1)
  full.send(0)
  val first = spawn(() ->
    select
      a.receive() as Some(x) -> x
      b.receive() as Some(x) -> x * 10
      full.send(1) -> -1)
  val second = spawn(() ->
    select
      b.receive() as Some(x) -> x
      after hours(1) -> 0)
  while parked() != 2 do ()
  _ = process.signal(process.pid(), signal.Quit)
  while dumps() < 1 do ()
  println("dump written")
  a.send(4)
  b.send(5)
  println(first.join(), second.join())
