// expect: trap
// A terminal library's cleanup on a trap: the program has switched the terminal to the alternate
// screen and hidden the cursor; a trap deep in its drawing still runs the hook, which writes the
// sequences that put both back, after what was drawn and after the trap's report.
import avin.process

val Enter: string = "\u001b[?1049h\u001b[?25l"
val Leave: string = "\u001b[?25h\u001b[?1049l"

class Screen(val rows: Vector[string])
    draw(at: int) = print(rows(at))

main(args: Vector[string]) -> int
    print(Enter)
    process.onExit(() -> print(Leave))
    val s = Screen(Vector("row 0\n", "row 1\n"))
    for i in 0..3 do s.draw(i)
    print(Leave)
    0
