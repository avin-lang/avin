// expect: exit 0
// `parseTimestamp`: a reading and an offset, `Z`, `±hh:mm` or `±hhmm`, which it subtracts to find the
// instant; `Instant.Min` and `Instant.Max` read back and a microsecond past either is out of range,
// an offset may carry a reading on a day past them back inside, a reading with no offset is refused,
// an offset beyond ±23:59 is out of range, and every display reads back over a sweep of instants.
import avin.time.{Instant, BadShape, OutOfRange, epochSeconds, epochMicros, micros, hours, minutes, parseTimestamp}

main()
    println(parseTimestamp("2026-03-03T14:30:00Z"))
    println(parseTimestamp("2026-03-03T14:30:00.5Z"))
    println(parseTimestamp("1970-01-01T00:00:00Z") == Ok(Instant.Epoch))
    println(parseTimestamp("1970-01-01T00:00Z") == Ok(Instant.Epoch))
    println(parseTimestamp("1970-01-01 00:00:00Z") == Ok(Instant.Epoch))
    println(parseTimestamp("2026-03-03T20:00:00+05:30"))
    println(parseTimestamp("2026-03-03T06:30:00-0800"))
    println(parseTimestamp("2026-03-03T14:30:00+0000"))
    println(parseTimestamp("2026-03-03T14:30:00-00:00"))
    println(parseTimestamp("2026-03-03T14:30:00+23:59"))
    println(parseTimestamp("2026-03-03T14:30:00-23:59"))
    println(parseTimestamp("1969-12-31T23:59:59.999999Z") == Ok(epochMicros(-1)))
    println(parseTimestamp("2026-03-08T09:30:00+05:45") == parseTimestamp("2026-03-08T03:45:00Z"))
    println(parseTimestamp("2026-03-08T00:30:00-0900") == Ok(epochSeconds(1772962200)))

    // The least and greatest instants read back, and a microsecond past either does not.
    println(parseTimestamp(s"${Instant.Min}") == Ok(Instant.Min))
    println(parseTimestamp(s"${Instant.Max}") == Ok(Instant.Max))
    println(parseTimestamp("-290308-12-21T19:59:05.224191Z"))
    println(parseTimestamp("+294247-01-10T04:00:54.775808Z"))
    println(parseTimestamp("-290308-12-21T00:00:00Z"))
    println(parseTimestamp("+294247-01-11T00:00:00Z"))
    println(parseTimestamp("+5881580-07-11T23:59:59Z"))
    println(parseTimestamp("-5877641-06-23T00:00:00Z"))

    // An offset carries a reading across the edge, either way.
    println(parseTimestamp("+294247-01-11T00:00:00+23:59"))
    println(parseTimestamp("+294247-01-10T04:00:54.775807-00:01"))
    println(parseTimestamp("-290308-12-21T19:59:05.224192+00:01"))
    println(parseTimestamp("-290308-12-21T20:00:05.224192+00:01") == Ok(Instant.Min))
    println(parseTimestamp("+294247-01-10T03:59:54.775807-00:01") == Ok(Instant.Max))
    println(parseTimestamp("-290308-12-20T23:59:00-23:59"))

    // No offset, a malformed one, one out of range.
    println(parseTimestamp("2026-03-03T14:30:00"))
    println(parseTimestamp("2026-03-03T14:30"))
    println(parseTimestamp("2026-03-03T14:30:00z"))
    println(parseTimestamp("2026-03-03T14:30:00 Z"))
    println(parseTimestamp("2026-03-03T14:30:00+5:30"))
    println(parseTimestamp("2026-03-03T14:30:00+05"))
    println(parseTimestamp("2026-03-03T14:30:00+05:"))
    println(parseTimestamp("2026-03-03T14:30:00+05:3"))
    println(parseTimestamp("2026-03-03T14:30:00+053"))
    println(parseTimestamp("2026-03-03T14:30:00+05-30"))
    println(parseTimestamp("2026-03-03T14:30:00-25:00"))
    println(parseTimestamp("2026-03-03T14:30:00+24:00"))
    println(parseTimestamp("2026-03-03T14:30:00+05:60"))
    println(parseTimestamp("2026-03-03T14:30:00+٠٥:30"))
    println(parseTimestamp("2026-03-03T14:30:00−05:00"))

    // Text left over, and the order of the checks: the whole shape, then the reading, then the offset.
    println(parseTimestamp("2026-03-03T14:30:00ZZ"))
    println(parseTimestamp("2026-03-03T14:30:00+05:30 "))
    println(parseTimestamp("2026-03-03T14:30:00Z[UTC]"))
    println(parseTimestamp("2026-02-30T24:00:00-25:00"))
    println(parseTimestamp("2026-02-28T24:00:00-25:00"))
    println(parseTimestamp("2026-02-30T24:00:00-25:00 "))
    println(parseTimestamp(""))

    println(parseTimestamp("2026-03-03T14:30:00") == Err(BadShape("2026-03-03T14:30:00", 19, "an offset like Z, +05:30 or -0800")))
    println(parseTimestamp("2026-03-03T14:30:00-25:00") == Err(OutOfRange("2026-03-03T14:30:00-25:00", "offset")))

    // Every display reads back, over instants spread across the whole range and around the epoch.
    var failures = 0
    var checked = 0
    var t: long = long.MinValue
    while t <= long.MaxValue - 9007199254740993
        val i = epochMicros(t)
        if parseTimestamp(s"$i") != Ok(i) then failures += 1
        checked += 1
        t += 9007199254740993
    var s: long = -100000
    while s <= 100000
        val i = epochMicros(s * 7777)
        if parseTimestamp(s"$i") != Ok(i) then failures += 1
        checked += 1
        s += 37
    println(s"$checked instants read back, $failures failures")
