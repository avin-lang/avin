// expect: exit 0
// env: AVIN_GC_STRESS=0
// A chain of ten thousand futures, each body awaiting the future before it, all waiting at once:
// ten thousand parked workers, which cost the program a stack reservation each and no operating
// system thread.
import avin.threads.{Future, Promise}

chain(links: int) -> int
  val start = Promise[int]()
  var last = start.future
  for _ in 0 ..< links
    val before = last
    last = Future(before.await() + 1)
  start.complete(0)
  last.await()

main() -> int
  println(chain(10000))
  val mapped = (0 ..< 50).foldLeft(Future.successful(0), (f, _) -> f.flatMap(n -> Future(n + 2)))
  println(mapped.await())
  0
