// expect: trap
// A trap runs the hooks on the thread that trapped, after its report: a hook writing to standard
// error writes after the trap's line, and what the program printed before the trap is flushed
// before either. The program still ends as a trap ends it.
import avin.process

main() -> int
  process.onExit(() -> eprintln("cleanup on standard error"))
  process.onExit(() -> println("cleanup on standard output"))
  println("before the trap")
  val xs = [1, 2, 3]
  println(xs(5))
  0
