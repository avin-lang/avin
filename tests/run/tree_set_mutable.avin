// expect: exit 0
// A mutable tree set, driven by thousands of random additions and removals, visits its elements in
// order and agrees at every step with a sorted-vector model; then the ordered queries at and between
// elements, both ends, the set algebra, snapshots, iteration while the set is updated, and the
// other types of element.

import avin.collections.mutable.{TreeSet as MutableTreeSet}
import avin.{TreeSet as ImmutableTreeSet}

main()
    val set = MutableTreeSet[int]()
    var model: Vector[int] = []
    var seed: long = 424242
    var agreed = true
    for step in 0..<4000
        seed = (seed *% 6364136223846793005 +% 1442695040888963407)
        val x = int((seed >> 40) & 255)
        val present = model.contains(x)
        if (seed >> 20) & 3 == 0
            if set.remove(x) != present then agreed = false
            model = model.filter(y -> y != x)
        else
            if set.add(x) == present then agreed = false
            if !present then model = (model ++ [x]).sorted()
        if set.size() != model.size() then agreed = false
        if step % 97 == 0
            if set.iterator().toVector() != model then agreed = false
            if set.reverseIterator().toVector() != model.reverse() then agreed = false
            for probe in -1..<258
                if set.minAfter(probe) != model.find(y -> y >= probe) then agreed = false
                if set.maxBefore(probe) != model.findLast(y -> y < probe) then agreed = false
                if set.contains(probe) != model.contains(probe) then agreed = false
                if set(probe) != model.contains(probe) then agreed = false
    println(agreed)
    println(set.iterator().toVector() == model)
    println(set.firstKey() == model(0) && set.lastKey() == model.last())
    println(set.headOption() == Some(model(0)) && set.lastOption() == Some(model.last()))

    var rangesAgree = true
    for low in -1..<258 by 7
        for high in -1..<258 by 11
            if set.range(low, high).iterator().toVector() != model.filter(y -> low <= y < high) then rangesAgree = false
        if set.rangeFrom(low).iterator().toVector() != model.filter(y -> y >= low) then rangesAgree = false
        if set.rangeTo(low).iterator().toVector() != model.filter(y -> y <= low) then rangesAgree = false
        if set.rangeUntil(low).iterator().toVector() != model.filter(y -> y < low) then rangesAgree = false
    println(rangesAgree)

    val drain = set.copy()
    var drained = true
    var count = 0
    while drain.nonEmpty()
        val x = if count % 2 == 0 then drain.removeFirst() else drain.removeLast()
        val want = if count % 2 == 0 then model(count / 2) else model(model.size() - 1 - count / 2)
        if x != want then drained = false
        count += 1
    println(drained && count == model.size())

    // Empty and one element.
    val e = MutableTreeSet[int]()
    println(e.isEmpty() && e.size() == 0)
    println(e.headOption())
    println(e.lastOption())
    println(e.removeFirstOption())
    println(e.removeLastOption())
    println(e.minAfter(0))
    println(e.maxBefore(0))
    println(e.remove(1))
    println(e.range(0, 5).isEmpty())
    println(e)
    println(e.add(7))
    println(e.add(7))
    println(e.minAfter(7))
    println(e.minAfter(8))
    println(e.maxBefore(7))
    println(e.maxBefore(8))
    println(e.range(7, 7).isEmpty())
    println(e.range(7, 8))
    println(e.removeFirstOption())
    println(e.isEmpty())
    e += 1
    println(e.removeLast())
    println(e.isEmpty())

    // Operators and algebra.
    val s = MutableTreeSet(5, 3, 9, 3, 1)
    println(s)
    s += 4
    s -= 9
    s ++= [10, 11]
    s --= [1, 100]
    println(s)
    println(s.union(MutableTreeSet(0, 3)))
    println(s.intersect(MutableTreeSet(3, 4, 6)))
    println(s.diff(MutableTreeSet(3, 4, 6)))
    println(MutableTreeSet(3, 4).subsetOf(s))
    println(MutableTreeSet(3, 6).subsetOf(s))
    println(s.map(x -> x % 3))
    println(s.flatMap(x -> [x, x + 1]))
    println(s.filter(x -> x > 4))
    s.filterInPlace(x -> x % 2 == 1)
    println(s)
    var total = 0
    s.foreach(x -> total += x)
    println(total)
    val guarded: MutableTreeSet[int] = for x in s if x > 3 yield x * 10
    println(guarded)
    s --= s
    println(s.isEmpty())
    s ++= [2, 1]
    s.clear()
    println(s.size())
    s.addAll([3, 1, 2])
    println(s.removeFirstOption())
    println(s.removeLastOption())
    println(s)

    // Snapshots and iteration while updating.
    val live = MutableTreeSet[int]()
    for i in 0..<10 do live.add(i)
    val snap = live.toTreeSet()
    var seen = 0
    for x in live
        live.remove(x + 1)
        live.add(x + 100)
        seen += 1
    println(seen)
    println(live.size())
    println(snap.size())
    println(ImmutableTreeSet(1, 2) == MutableTreeSet(2, 1).toTreeSet())

    // Equality, hash, display.
    println(MutableTreeSet(1, 2) == MutableTreeSet(2, 1))
    println(MutableTreeSet(1, 2) == MutableTreeSet(2, 3))
    println(MutableTreeSet(1, 2).hash() == MutableTreeSet(2, 1).hash())
    println(debug(MutableTreeSet("b", "a")))

    // Strings, a reversed order, a pair order, builders.
    val words = MutableTreeSet("pear", "", "apple", "élan", "apple")
    println(words)
    println(words.minAfter("b"))
    println(words.maxBefore("b"))
    val rev = MutableTreeSet(Reverse(1), Reverse(3), Reverse(2))
    println(rev.firstKey().value)
    println(rev.removeLast().value)
    println(rev.minAfter(Reverse(2)).map(r -> r.value))
    val pairs = MutableTreeSet((2, "b"), (1, "z"), (2, "a"))
    println(pairs)
    val b = MutableTreeSet.newBuilder[int]()
    b.addOne(2)
    b.addOne(1)
    b.addOne(2)
    println(b.result())
    println(MutableTreeSet.empty[string]().size())
    println(MutableTreeSet.fromTree(ImmutableTreeSet(3, 1, 2)))
