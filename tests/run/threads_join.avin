// expect: exit 0
// A thread runs a closure and is joined for its result: an int computed beside the main thread's own
// share of the work, a second join giving the same result again, a thread that starts and joins one
// of its own, a thread given a stack of its own size, and a closure that captures the caller's
// values.
import avin.threads.spawn

sum(from: long, to: long) -> long
    var s: long = 0
    var i = from
    while i <= to
        s += i
        i++
    s

depth(n: int) -> int = if n == 0 then 0 else 1 + depth(n - 1)

main() -> int
    val worker = spawn(() -> sum(1, 100000))
    val mine = sum(100001, 200000)
    print(worker.join() + mine)
    print(worker.join())
    val outer = spawn(() ->
        val inner = spawn(() -> 6 * 7)
        inner.join() + 1)
    print(outer.join())
    val deep = spawn(() -> depth(20000), 67108864)
    print(deep.join())
    val name = "worker"
    val n = 3
    val greeting = spawn(() -> s"$name $n")
    print(greeting.join())
    val nothing = spawn(() -> print("from a thread"))
    nothing.join()
    0
