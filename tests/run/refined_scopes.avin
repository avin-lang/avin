// expect: exit 0
// Where an arm's equalities hold: in its guard and body, in the patterns nested in its own, in a
// clause, in the `then` branch of an `is` test and the rest of a block after an early return, in the
// right operand of `&&`, and after a destructuring binding. Inside, a type and what it equals are
// one: a `T` that is an `int` takes `int`'s operators and methods, and a lambda made there and called
// later still sees it. A variable declared outside keeps its declared type and takes a value of it.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  BoolLit(value: bool) -> Expr[bool]
  Neg(inner: Expr[int]) -> Expr[int]
  If(cond: Expr[bool], yes: Expr[T], no: Expr[T])
  Pair[A, B](first: Expr[A], second: Expr[B]) -> Expr[(A, B)]

data Same[A, B]
  Refl -> Same[A, A]

cast[A, B](proof: Same[A, B], x: A) -> B
cast(Refl, x) = x

castBack[A, B](proof: Same[A, B], y: B) -> A
  val Refl = proof
  y

// `x: T` is an `int` in the `IntLit` arm, with `int`'s operators and methods.
bump[T](e: Expr[T], x: T) -> T = e match
  IntLit(n) -> x + n
  Neg(inner) -> -x
  BoolLit(b) -> !x && b
  _ -> x

describe[T](e: Expr[T], x: T) -> string = e match
  IntLit(n) if x > n -> s"${x.toString()} above $n"
  IntLit(n) -> s"${x.toString()} at most $n"
  _ -> "other"

// Nested patterns refine further: `If(BoolLit(b), x, y)` learns `T`'s equalities from `If` only.
shortcut[T](e: Expr[T]) -> Option[Expr[T]] = e match
  If(BoolLit(b), yes, no) -> Some(if b then yes else no)
  _ -> None

// A lambda made in an arm, called after the `match`, still sees the arm's equalities.
adder[T](e: Expr[T]) -> (T) -> T
  var f: (T) -> T = (x: T) -> x
  e match
    IntLit(n) -> f = (x: T) -> x + n
    BoolLit(b) -> f = (x: T) -> x || b
    _ -> ()
  f

// A variable declared outside the arm keeps its declared type and takes a value of it.
lastSeen[T](es: Vector[Expr[T]], start: T) -> T
  var out: T = start
  for e in es
    if e is IntLit(n) && n > 0 then out = n
    if e is BoolLit(b) then out = b
  out

// The right operand of `&&` holds the left one's equalities.
positive[T](e: Expr[T], x: T) -> bool = e is IntLit(n) && x + n > 0

// A match inside an arm sees the arm's equalities: `other` is an `Expr[int]` there.
both[T](e: Expr[T], other: Expr[T]) -> int = e match
  IntLit(n) -> other match
    IntLit(m) -> n + m
    Neg(IntLit(m)) -> n - m
    _ -> n
  _ -> 0

// A field of a refined type's one variant is read by name at an instance it makes.
data One[T]
  Mk(value: int, label: string) -> One[int]

data Holder[T]
  Hold[A](items: Vector[A]) -> Holder[Vector[A]]

labelOf[T](o: One[T]) -> string = o.label

itemsOf(h: Holder[Vector[string]]) -> Vector[string] = h.items

// A closed union fixed by a result.
data Token[T]
  Num(n: int) -> Token[int | string]
  Word(w: string) -> Token[int | string]
  Flag(on: bool) -> Token[bool]

read[T](t: Token[T]) -> T
read(Num(n)) = n
read(Word(w)) = w
read(Flag(on)) = on

data DoorShut()
data DoorOpen()
data DoorLocked()

data Step[From, To]
  OpenIt -> Step[DoorShut, DoorOpen]
  CloseIt -> Step[DoorOpen, DoorShut]
  LockIt(code: int) -> Step[DoorShut, DoorLocked]
  UnlockIt(code: int) -> Step[DoorLocked, DoorShut]

event[From, To](s: Step[From, To]) -> string
event(OpenIt) = "open"
event(CloseIt) = "close"
event(LockIt(code)) = s"lock $code"
event(UnlockIt(code)) = s"unlock $code"

main()
  println(cast(Refl, 41) + 1)
  println(castBack(Refl, "back"))
  println(bump(IntLit(2), 40))
  println(bump(Neg(IntLit(1)), 5))
  println(bump(BoolLit(true), false))
  println(bump(If(BoolLit(true), IntLit(1), IntLit(2)), 9))
  println(describe(IntLit(3), 7))
  println(describe(IntLit(3), 2))
  println(describe(BoolLit(true), false))
  println(shortcut(If(BoolLit(false), IntLit(1), IntLit(2))))
  println(shortcut(If(BoolLit(true), Pair(IntLit(1), BoolLit(true)), Pair(IntLit(2), BoolLit(false)))))
  println(shortcut(IntLit(3)))
  val plus3 = adder(IntLit(3))
  println(plus3(4))
  val orTrue = adder(BoolLit(true))
  println(orTrue(false))
  val same = adder(Pair(IntLit(1), IntLit(2)))
  println(same((5, 6)))
  println(lastSeen([IntLit(0), IntLit(4), IntLit(-1), Neg(IntLit(2))], 1))
  println(lastSeen([BoolLit(true), BoolLit(false)], true))
  println(positive(IntLit(1), 0))
  println(positive(IntLit(-5), 4))
  println(positive(BoolLit(true), true))
  println(both(IntLit(10), Neg(IntLit(3))))
  println(both(IntLit(10), IntLit(5)))
  println(both(BoolLit(true), BoolLit(false)))
  println(labelOf(Mk(1, "one")))
  println(Mk(2, "two").value)
  println(itemsOf(Hold(["first", "second"])))
  println(read(Num(7)))
  println(read(Word("seven")))
  println(read(Flag(true)))
  println(event(OpenIt))
  println(event(LockIt(42)))
  println(event(UnlockIt(42)))
  println(event(CloseIt))
