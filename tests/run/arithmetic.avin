// Integer arithmetic: each check that fails exits with its own number.

main() -> int
  val seven = 7
  val minus_seven = -7
  if seven + 3 != 10 then return 1
  if seven - 10 != -3 then return 2
  if seven * minus_seven != -49 then return 3
  // Division truncates toward zero, and the remainder takes the dividend's sign.
  if seven / 2 != 3 then return 4
  if minus_seven / 2 != -3 then return 5
  if minus_seven % 2 != -1 then return 6
  if seven % -2 != 1 then return 7
  // The most negative value divided by -1 does not fit, but its remainder is 0.
  val min: i8 = -128
  if min % -1 != 0 then return 8
  if -seven != minus_seven then return 9
  if +seven != 7 then return 10
  // A literal takes the other operand's width, on either side.
  val small: i8 = 100
  if small + 27 != 127 then return 11
  if 27 + small != 127 then return 12
  val wide: i64 = 3000000000
  if wide * 2 != 6000000000 then return 13
  val huge: i128 = 170141183460469231731687303715884105727
  if huge - 1 + 1 != huge then return 14
  // Precedence: multiplication and shifts bind together, above addition.
  if 1 + 2 * 3 != 7 then return 15
  if 1 + 2 << 3 != 17 then return 16
  if (1 + 2) * 3 != 9 then return 17
  if 10 - 4 - 3 != 3 then return 18
  0
