// expect: trap
// A listener a thread is parked accepting on belongs to that thread, so closing it from elsewhere
// traps rather than pulling the socket out from under the wait.
import avin.io.IoError
import avin.net.TcpListener
import avin.threads.{sleep, spawn}
import avin.time.millis

@sysl("avin.rt.socket_waiters")
socketWaiters() -> long

ok[T](r: Result[T, IoError]) -> T = r match
    Ok(v) -> v
    Err(e) -> fail(e.message)

main()
    val l = ok(TcpListener.bind("127.0.0.1", 0))
    val t = spawn(() -> l.accept().isOk())
    while socketWaiters() < 1
        sleep(millis(1))
    println("parked")
    l.close()
    println("not reached")
    println(t.join())
