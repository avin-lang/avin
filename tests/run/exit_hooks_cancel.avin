// `cancel` takes a hook out so it does not run, and answers whether it was still registered: true
// once, false after, and false for a hook that has already run or is running. A hook may cancel one
// registered before it, which then does not run, and the hooks around a cancelled one keep their
// order.
import avin.process
import avin.process.ExitHook
import avin.threads.Atomic

main()
    val a = process.onExit(() -> println("a"))
    val b = process.onExit(() -> println("b, cancelled by main"))
    val c = process.onExit(() -> println("c, cancelled by d"))
    process.onExit(() ->
        println("d")
        println(s"d cancels c: ${c.cancel()}"))
    println(s"cancel b: ${b.cancel()}")
    println(s"cancel b again: ${b.cancel()}")
    val me = Atomic[Option[ExitHook]](None)
    val e = process.onExit(() ->
        println("e")
        me.load() match
            Some(h) -> println(s"e cancels itself: ${h.cancel()}")
            None -> ())
    me.store(Some(e))
    println("main ends")
