// expect: trap
// A task given by `execute` runs as an owner of its own and nothing is handed to it, so a connection
// it reaches that the giving code owns traps in the task.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.threads.{Executor, Promise}

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

main()
  val l = ok(TcpListener.bind("127.0.0.1", 0))
  val c = ok(TcpStream.connect("127.0.0.1", l.port()))
  val s = ok(l.accept())
  ok(c.writeText("first\n"))
  println(ok(s.readLine()))
  val done = Promise[unit]()
  Executor.shared().execute(() ->
    _ = c.close()
    done.complete(()))
  done.future.await()
  println("not reached")
