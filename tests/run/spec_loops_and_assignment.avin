// expect: exit 0
// Multiple assignment (a swap, the compound form reading every place first, a `_` place,
// parenthesized places, fields whose objects are evaluated before the right side), destructuring
// bindings, and the loops' values: `while` with `break` and `else`, `loop` with `break`, `do … while`
// whose `continue` runs the test and whose `else` runs when the test fails, and `while true` and
// `loop` ending a function.

class Range2(var lo: int, var hi: int)
  flip()
    self.lo, hi = hi, lo

var log = ""

pick(r: Range2, tag: string) -> Range2
  log = log + tag
  r

value(v: int, tag: string) -> int
  log = log + tag
  v

divmod(a: int, b: int) -> (int, int) = (a / b, a % b)

forever(n: int) -> int
  var k = n
  while true
    k += 1
    if k > 100 then return k

endless(n: int) -> int
  var k = n
  loop
    k += 3
    if k > 10 then return k

main()
  var a = 1
  var b = 2
  a, b = b, a
  println(s"$a $b")
  a, b += b, a
  println(s"$a $b")
  var q = 0
  q, _ = divmod(17, 5)
  println(q)
  (a, b) = (10, 20)
  println(s"$a $b")
  var (lo, hi) = 0, 10
  lo += 1
  hi -= 1
  println(s"$lo $hi")
  val x, y = divmod(17, 5)
  println(s"$x $y")
  val r1 = Range2(1, 2)
  val r2 = Range2(3, 4)
  log = ""
  pick(r1, "a").lo, pick(r2, "b").hi = value(7, "c"), value(8, "d")
  println(s"$log ${r1.lo} ${r2.hi}")
  r1.flip()
  println(s"${r1.lo} ${r1.hi}")
  var n = 0
  val found = while n < 10 do
    n += 1
    if n == 5 then break n * 100
  else -1
  println(found)
  var m = 0
  val missed = while m < 3 do
    m += 1
  else -1
  println(missed)
  var k = 0
  val looped = loop
    k += 5
    if k > 12 then break k * 2
  println(looped)
  var i = 0
  log = ""
  do
    i += 1
    if i < 3 then continue
    println(s"body $i")
  while value(i, "t") < 4
  println(s"$i $log")
  var j = 0
  val d = do
    j += 1
    if j == 7 then break j
  while j < 3 else -j
  println(d)
  var once = 0
  do once += 1 while false
  println(once)
  println(forever(5))
  println(endless(0))
