// expect: trap
// Lines and columns stay right after constructs that span lines: a block `if`, a `match` and a
// call whose arguments are spread over lines. Columns count characters, not bytes: “é” is one.

pick(a: int,
     b: int,
     c: int) -> int = a + b + c

main() -> int
    val n = pick(1,
                 2,
                 3)
    val label = if n > 5
        "é big"
    else
        "é small"
    print(label)
    val code = n match
        6 -> 0
        _ -> 1
    print(s"${code}")
    val zero = code
    val q = ("é", n / zero).1
    q
