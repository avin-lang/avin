// expect: exit 0
// `x is P` tests a union value against any pattern a `match` arm takes and binds what `P` binds where
// the test is known to have matched: after `then`, past an `is not` that returned early, in a
// `while`, and on the matching side of `&&` and `||`. The union value itself keeps its type.

lengthOf(v: int | string) -> int
  if v is s: string then return s.charCount
  0

doubled(v: int | string) -> int
  if v is not n: int then return -1
  n * 2

countDown(start: int | string) -> string
  var v: int | string = start
  var out = ""
  while v is n: int
    out = out + s"$n "
    v = if n > 0 then n - 1 else "done"
  out + (v match
    s: string -> s
    _: int -> "")

both(v: int | string, w: int | string) -> string
  if v is a: int && w is b: int then s"sum ${a + b}" else "not both ints"

either(v: int | string) -> string
  if v is not n: int || n < 0 then "not a natural int" else s"natural $n"

literal(v: int | string) -> bool = v is 0

stringy(v: int | string) -> bool = v is _: string

main()
  println(lengthOf("héllo"))
  println(lengthOf(5))
  println(doubled(21))
  println(doubled("x"))
  println(countDown(3))
  println(countDown("start"))
  println(both(1, 2))
  println(both(1, "two"))
  println(either(4))
  println(either(-4))
  println(either("four"))
  println(literal(0))
  println(literal(1))
  println(literal("0"))
  println(stringy("s"))
  println(stringy(1))
