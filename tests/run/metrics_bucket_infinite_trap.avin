// expect: trap
// A histogram's bounds are finite, the one past them all being its own: the largest finite bound is
// taken, and an infinite one traps.
import avin.metrics.Registry

main()
  val r = Registry()
  println(r.histogram("a", "A.", buckets = [real.MaxValue]).buckets.length)
  _ = r.histogram("b", "B.", buckets = [1.0, real.PositiveInfinity])
