// expect: trap
// A send arm on a closed channel traps when the select tries it, as `send` does, whatever the other
// arms: here the only other arm is never ready, so the send arm is always tried.
import avin.threads.Channel

main()
  val done = Channel[int]()
  val never = Channel[int]()
  done.close()
  println("before")
  select
    never.receive() as Some(x) -> println(x)
    done.send(1) -> println("sent")
  println("after")
