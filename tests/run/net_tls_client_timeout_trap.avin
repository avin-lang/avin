// expect: trap
// A client handshake's timeout below zero, by a microsecond, traps before the handshake begins.
import avin.net.{TcpListener, TcpStream}
import avin.net.tls.{TlsClient, TlsStream}
import avin.time.micros

main()
  val listener = TcpListener.bind("127.0.0.1", 0).ok.get
  val tcp = TcpStream.connect("127.0.0.1", listener.port()).ok.get
  println("connected")
  _ = TlsStream.client(tcp, "localhost", TlsClient(), micros(-1))
  _ = listener.close()
