// expect: exit 0
// An unbounded channel never holds its senders back: four producers send a thousand values each
// without a receiver running, then one consumer takes them all with `for x in ch` once the channel is
// closed; each producer's values arrive in the order it sent them.
import avin.threads.{Channel, scope}

main() -> int
    val ch = Channel[(int, int)]()
    scope(s ->
        for p in 0..<4
            s.spawn(() ->
                for i in 0..<1000 do ch.send((p, i))))
    ch.close()
    println(ch.isClosed())
    val next = Array.fill(4, 0)
    var total = 0
    var wrong = 0
    for (p, i) in ch
        if i != next(p) then wrong += 1
        next(p) = i + 1
        total += 1
    println(s"$total received, $wrong out of order")
    println(ch.receive().isDefined())
    if total == 4000 && wrong == 0 then 0 else 1
