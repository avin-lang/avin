// expect: exit 0
// A period added to and taken from a date and a reading: month ends clamping, leap days, months
// first and then days, negative and mixed-sign periods, the lossy month step, the calendar steps by
// name, and a reading keeping its time of day. The table at the end was computed with the host's
// `date -j -v` and is kept as data; that tool rolls 29 February a year on to 1 March, where the
// calendar here clamps to 28 February, and those rows say so.
import avin.time.{Date, DateTime, Period, date, dateTime, months, years}

check(label: string, got: Date, want: Date) =
  println(if got == want then s"$label $got" else s"$label $got WRONG, want $want")

main()
  // Month ends clamp, in a common and a leap year.
  println(date(2026, 1, 31) + months(1))
  println(date(2024, 1, 31) + months(1))
  println(date(2026, 3, 31) + months(1))
  println(date(2026, 3, 31) - months(1))
  println(date(2026, 5, 31) + months(-3))
  println(date(2026, 1, 30) + months(1))
  println(date(2026, 1, 28) + months(1))
  println(date(2026, 12, 31) + months(2))
  println(date(2026, 12, 15) + months(1))
  println(date(2026, 1, 15) - months(1))
  println(date(2026, 1, 15) + months(-13))
  println(date(2026, 1, 15) + months(24))

  // Leap days.
  println(date(2024, 2, 29) + years(1))
  println(date(2024, 2, 29) + years(4))
  println(date(2024, 2, 29) - years(1))
  println(date(2024, 2, 29) - years(4))
  println(date(2000, 2, 29) + years(100))
  println(date(2000, 2, 29) + years(400))
  println(date(2024, 2, 29) + months(12))
  println(date(2023, 2, 28) + years(1))
  println(date(0, 2, 29) + years(-1))
  println(date(0, 2, 29) + years(-4))

  // Months first, then days.
  println(date(2026, 1, 31) + Period(1, 1))
  println(date(2026, 1, 31) + months(1) + Period(0, 1))
  println(date(2026, 1, 31) + Period(0, 1) + months(1))
  println(date(2024, 1, 31) + Period(1, 1))
  println(date(2026, 3, 1) - Period(1, 1))
  println(date(2026, 3, 31) - Period(1, 1))
  println(date(2026, 3, 31) + Period(-1, 1))
  println(date(2026, 3, 31) + Period(1, -1))
  println(date(2026, 1, 1) + Period(0, 365))
  println(date(2024, 1, 1) + Period(0, 365))
  println(date(2026, 1, 1) + Period(0, -1))

  // Clamping makes month steps lossy, and `p` then `-p` need not come back.
  println(date(2026, 1, 31) + months(1) - months(1))
  println(date(2026, 1, 31) + months(1) + months(1))
  println(date(2026, 1, 31) + months(2))
  println(date(2026, 1, 15) + months(1) - months(1) == date(2026, 1, 15))
  println(date(2026, 1, 15) + Period(3, 10) - Period(3, 10) == date(2026, 1, 15))

  // The empty period moves nothing; a period of days agrees with `plusDays`.
  val d = date(2026, 8, 28)
  println(d + Period.Zero == d)
  println(d - Period.Zero == d)
  println(Date.Max + Period.Zero == Date.Max)
  println(Date.Min - Period.Zero == Date.Min)
  println(d + Period(0, 10) == d.plusDays(10))

  // The calendar steps by name.
  println(d.plusYears(1) == d + years(1))
  println(d.plusMonths(-7) == d + months(-7))
  println(d.plusWeeks(5))
  println(d.plusWeeks(-1))
  println(d.plusDays(4))
  println(d.plusDays(-28))
  println(date(2024, 2, 29).plusYears(1))
  println(date(2026, 1, 31).plusMonths(1))
  println(Date.Max.plusDays(0) == Date.Max)
  println(Date.Max.plusMonths(0) == Date.Max)

  // A reading keeps its time of day.
  val r = dateTime(2026, 1, 31, 23, 59, 59, 999999)
  println(r + months(1))
  println(r - months(1))
  println(r + Period(1, 1))
  println(r - Period(0, 31))
  println(dateTime(2024, 2, 29, 12, 0) + years(1))
  println(r.plusYears(2))
  println(r.plusMonths(13))
  println(r.plusWeeks(1))
  println(r.plusDays(-31))
  println(DateTime.Max - Period(0, 1))
  println(DateTime.Min + months(1))

  // Values from `date -j -v` (each row: start, the `-v` steps, the answer).
  check("-v+1m", date(2026, 1, 31) + months(1), date(2026, 2, 28))
  check("-v+1m", date(2024, 1, 31) + months(1), date(2024, 2, 29))
  check("-v+4y", date(2024, 2, 29) + years(4), date(2028, 2, 29))
  check("-v-1m", date(2026, 3, 31) - months(1), date(2026, 2, 28))
  check("-v+1m -v+1d", date(2026, 1, 31) + Period(1, 1), date(2026, 3, 1))
  check("-v+100d", date(2026, 5, 15) + Period(0, 100), date(2026, 8, 23))
  check("-v-1000d", date(2026, 5, 15) - Period(0, 1000), date(2023, 8, 19))
  check("-v+2m", date(2026, 12, 31) + months(2), date(2027, 2, 28))
  check("-v+5w", date(2026, 8, 28).plusWeeks(5), date(2026, 10, 2))
  check("-v-3m", date(2026, 5, 31) - months(3), date(2026, 2, 28))
  check("-v+2m -v-1d", date(1999, 12, 31) + Period(2, -1), date(2000, 2, 28))
  check("-v-13m", date(2025, 3, 29) - months(13), date(2024, 2, 29))
  // `date -j -v+1y` gives 2025-03-01, `-v-1y` 2023-03-01 and 2000-02-29 `-v+100y` 2100-03-01: a
  // year step there rolls past the month's end, where here it clamps.
  check("-v+1y (date: 2025-03-01)", date(2024, 2, 29) + years(1), date(2025, 2, 28))
  check("-v-1y (date: 2023-03-01)", date(2024, 2, 29) - years(1), date(2023, 2, 28))
  check("-v+100y (date: 2100-03-01)", date(2000, 2, 29) + years(100), date(2100, 2, 28))
