// `eprint` writes a value's `Display` form and a new line to standard error, as `print` does to
// standard output, and `StandardError` is a `Writer` like `StandardOutput`; neither stream's text
// reaches the other.
data Point(x: int, y: int)

impl Display for Point
    display(out: Writer, spec: FormatSpec)
        out.write("(")
        out.writeInt(long(x))
        out.write(", ")
        out.writeInt(long(y))
        out.write(")")

main()
    print("to standard output")
    eprint("to standard error")
    eprint(42)
    eprint(Point(3, -4))
    eprint(s"interpolated ${1 + 2} é")
    eprint("")
    StandardError.write("written ")
    StandardError.writeInt(-7)
    StandardError.writeChar('!')
    StandardError.write("\n")
    Point(1, 2).display(StandardError, FormatSpec())
    StandardError.write("|\n")
    print("done")
