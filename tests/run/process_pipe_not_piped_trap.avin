// expect: trap
// Asking a `Child` for a pipe its command did not ask for traps, saying how to ask for it; the pipes
// it did ask for are answered.
import avin.process.Command

main()
  val child = Command("cat").pipeInput().start().ok.get
  _ = child.stdin().close()
  println("input answered")
  _ = child.waitFor()
  println(child.stdout())
  println("not reached")
