// expect: exit 0
// `-` among the paths of `io.inputs` is standard input, in its place in the order, read to its end
// at that point; a second `-` finds it empty. Standard input here is `io_inputs_stdin.in`.
import avin.fs
import avin.io
import avin.io.IoError

show(r: Result[(string, string), IoError]) -> string = r match
  Ok((name, text)) -> s"$name=[${text.replace("\n", "\\n")}]"
  Err(e) -> s"error ${e.message}"

main()
  val dir = fs.tempDir("io-inputs-stdin").getOrElse(fail("no temp dir"))
  defer dir.close()
  val f = dir.path + "/f.txt"
  _ = fs.writeText(f, "file\n")
  // A line taken first is not part of the input: `inputs` takes up where the reader stopped.
  println(io.readLine())
  for r in io.inputs(Vector(f, "-", f, "-"))
    println(show(r).replace(dir.path + "/", ""))
  println(io.readLine())
