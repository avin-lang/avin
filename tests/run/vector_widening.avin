// expect: exit 0
// A vector's methods that take an element take it as a type parameter bounded below by the element
// type, so a vector seen at a wider type and given an element of that type answers a vector of the
// wider type, never one of its own type holding a foreign element.

open class Animal(val name: string)

class Dog(name: string): Animal(name)
  bark() -> string = s"$name woofs"

class Cat(name: string): Animal(name)

open class Crate[+T](val x: T)

impl[T] Crate[T]
  widened[W >: T](y: W) -> Crate[W] = Crate(y)

class DogCrate(d: Dog): Crate[Dog](d)

kind(a: Any) -> string = a match
  _: Vector[Dog] -> "Vector[Dog]"
  _: Vector[Animal] -> "Vector[Animal]"
  _ -> "other"

names(xs: Vector[Animal]) -> string = xs.map(a -> a.name).mkString(" ")

main()
  val dogs: Vector[Dog] = [Dog("rex"), Dog("fido")]
  val animals: Vector[Animal] = dogs
  val more = animals :+ Cat("tom")
  println(s"${kind(more)} ${names(more)}")
  val front = Cat("kit") +: animals
  println(s"${kind(front)} ${names(front)}")
  val cats: Vector[Animal] = [Cat("a"), Cat("b")]
  val joined = animals ++ cats
  println(s"${kind(joined)} ${names(joined)}")
  val replaced = animals.updated(0, Cat("max"))
  println(s"${kind(replaced)} ${names(replaced)} ${names(animals)}")
  // A cat added to the vector of dogs itself makes a vector of animals.
  val mixed = dogs :+ Cat("tom")
  println(s"${kind(mixed)} ${names(mixed)}")
  // Dogs added to dogs stay dogs.
  val pack = dogs :+ Dog("spot")
  println(s"${kind(pack)} ${pack(2).bark()}")

  // An array of the elements is of the type the call asks for.
  val array: Array[Animal] = animals.toArray()
  array(0) = Cat("tab")
  println(s"${array(0).name} ${dogs(0).bark()}")
  println([1, 2, 3].toArray().length)

  // An empty vector of `Nothing` used as a vector of numbers holds numbers.
  val none = Vector.empty[Nothing]()
  val reals: Vector[real] = none
  val r = reals :+ 1.5 :+ 2.5
  println(s"${r.length} ${r(0)} ${r(1)}")
  val ints: Vector[int] = none
  val i = 3 +: ints
  println(s"$i ${i(0) + 1}")
  val longs: Vector[long] = [1, 2]
  println(longs :+ 3)
  println(ints ++ [4, 5])

  // The companion makes a vector of the elements given.
  val empty: Vector[int] = Vector()
  val one = Vector(7)
  val three = Vector("a", "b", "c")
  println(s"${empty.length} $one $three")

  // A sequence seen at a wider type widens the same way.
  val seq: Seq[Animal] = List(Dog("rex"))
  println(names((seq :+ Cat("tom")).toVector))
  println(List(1, 2) :+ 3)

  // An impl method of an open class with a lower-bounded parameter runs through the method table.
  val crate: Crate[Animal] = DogCrate(Dog("rex"))
  println(crate.widened(Cat("tom")).x.name)

  // Iteration and guards over a vector.
  for d in dogs.reverseIterator() do print(s"${d.name} ")
  println("")
  println(for x in [1, 2, 3, 4] if x % 2 == 0 yield x * 10)
