// expect: exit 0
// Repeated parameters beside overloads, defaults and named arguments, with elements of a wider
// type than the arguments, and through a superclass's constructor. An overload without a repeated
// parameter that accepts a call is chosen over one with.

describe(n: int) -> string = "one int"
describe(a: int, b: int) -> string = "two ints"
describe(ns: int*) -> string = s"${ns.length()} ints"

// `pick(1)` takes the `long` overload: one without a repeated parameter fits, so the repeated one
// is not a candidate, though it would take the literal as its own type.
pick(x: long) -> string = "long"
pick(xs: int*) -> string = "repeated"

framed(left: string = "[", right: string = "]", items: int*) -> string
    var out = left
    for i in items do out = out + i.toString()
    out + right

kinds(values: Any*) -> string
    var out = ""
    for v in values
        out = out + (v match
            n: int -> "int "
            s: string -> "string "
            _ -> "other ")
    out.trim()

open class Animal(val name: string)
class Dog(name: string): Animal(name)

names(animals: Animal*) -> string
    var out = ""
    for a in animals do out = out + a.name + " "
    out.trim()

open class Shape(val sides: int*)
class Square(): Shape(1, 1, 1, 1)
class Polygon(corners: int*): Shape(corners*)

main()
    print(describe(1))
    print(describe(1, 2))
    print(describe(1, 2, 3))
    print(describe())
    val v = [4, 5]
    print(describe(v*))
    print(pick(1))
    print(pick(1, 2))
    print(pick())

    print(framed())
    print(framed("<", ">", 1, 2))
    print(framed(right = ")", left = "("))

    print(kinds(1, "a", 2.5))
    val mixed: Vector[Any] = [1, "b"]
    print(kinds(mixed*))

    print(names(Dog("rex"), Animal("cat")))
    val dogs = [Dog("a"), Dog("b")]
    print(names(dogs*))

    print(Square().sides.length())
    print(Polygon(1, 2, 3).sides)
