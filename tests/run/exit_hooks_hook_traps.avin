// expect: trap
// A hook that traps is reported as a trap in an exit hook and never goes on; the hooks after it
// still run, each once, and the program, though `main` returned 0, ends as a trap ends it. Two
// hooks that trap are both reported.
import avin.process

main() -> int
  process.onExit(() -> eprintln("third"))
  process.onExit(() ->
    eprintln("second, before its trap")
    fail("second failed")
    eprintln("not reached"))
  process.onExit(() -> eprintln("between"))
  process.onExit(() ->
    eprintln("first, before its trap")
    val d = 0
    eprintln(10 / d))
  println("main ends")
  0
