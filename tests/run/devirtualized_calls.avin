// expect: exit 0
// A call through a trait or an open or abstract class runs the receiver's own method, however the
// compiler makes it: through the receiver's method table, directly where only one method can run, or
// after testing which of a few types the receiver has.

// A trait with one implementation: every call of `area` runs `Square`'s.
trait Shape
    area() -> int

class Square(val side: int): Shape
    override area() -> int = side * side

// A trait with two, each of which a call must tell apart.
trait Animal
    sound() -> string

class Cat: Animal
    override sound() -> string = "meow"

class Dog(val loud: bool): Animal
    override sound() -> string = if loud then "WOOF" else "woof"

// An open class with an override, and a subclass that inherits it.
open class Counter
    step() -> int = 1

open class Doubler: Counter
    override step() -> int = 2

class Quiet: Doubler

// An abstract class whose subclasses override at different depths.
abstract class Node
    depth() -> int
    label() -> string = "node"

class Leaf: Node
    override depth() -> int = 0

open class Branch(val child: Node): Node
    override depth() -> int = child.depth() + 1
    override label() -> string = "branch"

class Root(c: Node): Branch(c)
    override label() -> string = "root"

// A trait's default body, which one type keeps and another replaces in its impl.
trait Greeter
    greet() -> string = "hello"

data Plain(n: int)
data Fancy(n: int)

impl Greeter for Plain

impl Greeter for Fancy
    greet() -> string = s"good day $n"

// A generic trait whose instances at different type arguments are different methods.
trait Box[+T]
    get() -> T

class Holder[T](val item: T): Box[T]
    override get() -> T = item

open class Pet(val name: string)
class Puppy(n: string): Pet(n)

// Nine implementations, more than a call tests for.
trait Digit
    value() -> int

class D1: Digit
    override value() -> int = 1
class D2: Digit
    override value() -> int = 2
class D3: Digit
    override value() -> int = 3
class D4: Digit
    override value() -> int = 4
class D5: Digit
    override value() -> int = 5
class D6: Digit
    override value() -> int = 6
class D7: Digit
    override value() -> int = 7
class D8: Digit
    override value() -> int = 8
class D9: Digit
    override value() -> int = 9

total(s: Shape) -> int = s.area()
speak(a: Animal) -> string = a.sound()
steps(c: Counter) -> int = c.step()
describe(n: Node) -> string = s"${n.label()} ${n.depth()}"
welcome(g: Greeter) -> string = g.greet()
petName(b: Box[Pet]) -> string = b.get().name
sum(ds: Vector[Digit]) -> int
    var t = 0
    for d in ds do t += d.value()
    t

// A function that always returns an object of one class, through a trait type.
makeAnimal() -> Animal = Cat()

// A local that holds objects of two classes in turn.
both() -> string
    var a: Animal = Cat()
    val first = a.sound()
    a = Dog(true)
    first + " " + a.sound()

main()
    println(total(Square(4)))
    println(s"${speak(Cat())} ${speak(Dog(false))} ${speak(Dog(true))} ${speak(makeAnimal())} ${both()}")
    println(s"${steps(Counter())} ${steps(Doubler())} ${steps(Quiet())}")
    println(s"${describe(Leaf())} ${describe(Branch(Leaf()))} ${describe(Root(Branch(Leaf())))}")
    println(s"${welcome(Plain(1))} ${welcome(Fancy(2))}")
    val ints: Box[int] = Holder(7)
    val words: Box[string] = Holder("seven")
    println(s"${ints.get()} ${words.get()} ${petName(Holder(Puppy("rex")))} ${petName(Holder(Pet("tom")))}")
    println(sum([D1(), D2(), D3(), D4(), D5(), D6(), D7(), D8(), D9()]))
    // Iterators of different sequences, each traversed by `for`.
    var n = 0
    for x in [1, 2, 3].toArraySeq() do n += x
    val l: List[int] = [4, 5]
    for x in l do n += x
    for x in [6, 7] do n += x
    println(n)
