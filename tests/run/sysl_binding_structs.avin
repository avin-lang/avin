// Data types that mirror Sysl structs: one variant named as the type, whose fields are the struct's,
// by name. A mirror may hold another, and may sit in an `Option`.

@sysl("sysl.time.YearMonthDay")
data Civil
    Civil(year: int, month: int, day: int)

@sysl("sysl.time.Date")
data LocalDate
    LocalDate(day: int)

@sysl("sysl.time.Time")
data LocalTime
    LocalTime(us: long)

@sysl("sysl.time.DateTime")
data LocalDateTime
    LocalDateTime(date: LocalDate, time: LocalTime)

@sysl("sysl.time.days_from_civil")
daysFromCivil(c: Civil) -> LocalDate

@sysl("sysl.time.civil_from_days")
civilFromDays(d: LocalDate) -> Civil

@sysl("sysl.time.checked_date")
checkedDate(year: int, month: int, day: int) -> Option[LocalDate]

@sysl("sysl.hint.black_box")
same(t: LocalDateTime) -> LocalDateTime

// An option of a mirror crosses both ways; Avin keeps it as one pointer.
@sysl("sysl.hint.black_box")
sameDate(d: Option[LocalDate]) -> Option[LocalDate]

main()
    println(s"${daysFromCivil(Civil(1970, 1, 1))} ${daysFromCivil(Civil(2000, 3, 1))} ${daysFromCivil(Civil(1969, 12, 31))}")
    println(s"${civilFromDays(LocalDate(11017))} ${civilFromDays(LocalDate(-1))}")
    println(s"${checkedDate(2024, 2, 29)} ${checkedDate(2023, 2, 29)}")
    println(s"${same(LocalDateTime(LocalDate(19000), LocalTime(86399999999)))}")
    println(s"${sameDate(Some(LocalDate(7)))} ${sameDate(None)} ${sameDate(checkedDate(2024, 2, 29)).map(d -> d.day)}")
