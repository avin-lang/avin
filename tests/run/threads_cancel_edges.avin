// expect: exit 0
// The edges of a scope's cancellation. A scope with no threads may be cancelled, and cancelling twice
// is the same as once. A thread started in a cancelled scope ends before its body runs. A thread that
// finished before the cancellation keeps its result, and its `join` still answers it. A scope's body
// goes on after `cancel` and its result is the scope's. `isCancelled` is false until the scope is
// cancelled. A cancellation racing a thread's own end leaves the thread either finished with its
// result or cancelled with none, never anything between, a thousand times over. The main thread's
// scope and a lightweight thread's scope behave alike. Generic results, results that are objects and
// strings, and results of the unit type all come back as `None` when cancelled.
import avin.threads.{Atomic, scope, sleep, spawn}
import avin.time.{hours, millis}

class Point(val x: int, val y: int)

main() -> int
    // No threads.
    println(scope(s ->
        val before = s.isCancelled()
        s.cancel()
        s.cancel()
        (before, s.isCancelled())))
    // Started after the cancellation.
    val ran = Atomic(0)
    val late = scope(s ->
        s.cancel()
        val t = s.spawn(() ->
            ran.store(1)
            "ran")
        val u = s.spawn(() -> ran.store(2))
        (t, u, "body went on"))
    println((late.0.result(), late.1.result(), late.2, ran.load()))
    // Finished before.
    val early = scope(s ->
        val t = s.spawn(() -> Point(1, 2))
        val p = t.join()
        s.cancel()
        (t, p.x + p.y))
    println(early.0.join().y)
    println(early.1)
    // Results of every kind when cancelled.
    val kinds = scope(s ->
        val a = s.spawn(() ->
            sleep(hours(1))
            "text")
        val b = s.spawn(() ->
            sleep(hours(1))
            Point(3, 4))
        val c = s.spawn(() ->
            sleep(hours(1))
            [1, 2, 3])
        val d = s.spawn(() -> sleep(hours(1)))
        val e = s.spawn(() ->
            sleep(hours(1))
            Some("é"))
        sleep(millis(5))
        s.cancel()
        (a, b, c, d, e))
    println((kinds.0.result(), kinds.1.result().isDefined, kinds.2.result(), kinds.3.result(), kinds.4.result()))
    // Racing the end.
    var finished = 0
    var cancelled = 0
    for i in 0..<1000
        val t = scope(s ->
            val t = s.spawn(() -> i * 2)
            if i % 3 == 0 then sleep(millis(0))
            s.cancel()
            t)
        t.result() match
            Some(v) ->
                if v != i * 2 then println(s"wrong result $v for $i")
                finished += 1
            None -> cancelled += 1
    println(finished + cancelled)
    // The same from a lightweight thread's scope.
    val fromThread = spawn(() -> scope(s ->
        val t = s.spawn(() ->
            sleep(hours(1))
            1)
        s.cancel()
        (t.result(), s.isCancelled())))
    println(fromThread.join())
    0
