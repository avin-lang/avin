// expect: exit 0
// `parseTime`: `hh:mm`, `hh:mm:ss` and `hh:mm:ss.f` with one to six digits of fraction, a fraction
// meaning what it says, the first and last microsecond of the day, `24:00`, a second of `60` and a
// seventh digit refused, every shape refusal with its byte, and every display reading back equal over
// times with 0 to 6 digits of fraction.
import avin.time.{Time, BadShape, OutOfRange, Trailing, time, timeOfMicros, parseTime}

main()
    // The accepted forms.
    println(parseTime("09:30"))
    println(parseTime("09:30:07"))
    println(parseTime("09:30:07.25"))
    println(parseTime("09:30:07.250000"))
    println(parseTime("00:00") == Ok(Time.Midnight))
    println(parseTime("12:00:00") == Ok(Time.Noon))
    println(parseTime("23:59:59.999999"))
    println(parseTime("00:00:00.000001"))
    println(parseTime("00:00:00.000000") == Ok(Time.Midnight))

    // A fraction means what it says, one to six digits.
    println(parseTime("00:00:00.5") == Ok(time(0, 0, 0, 500000)))
    println(parseTime("00:00:00.05") == Ok(time(0, 0, 0, 50000)))
    println(parseTime("00:00:00.005") == Ok(time(0, 0, 0, 5000)))
    println(parseTime("00:00:00.0005") == Ok(time(0, 0, 0, 500)))
    println(parseTime("00:00:00.00005") == Ok(time(0, 0, 0, 50)))
    println(parseTime("00:00:00.000005") == Ok(time(0, 0, 0, 5)))
    println(parseTime("00:00:00.123456") == Ok(time(0, 0, 0, 123456)))

    // A seventh digit is refused, even a zero.
    println(parseTime("00:00:00.1234567"))
    println(parseTime("00:00:00.0000000"))
    println(parseTime("00:00:00.1234560"))

    // Out of range, the hour first.
    println(parseTime("24:00"))
    println(parseTime("24:00:00"))
    println(parseTime("23:60"))
    println(parseTime("23:59:60"))
    println(parseTime("99:99:99"))
    println(parseTime("23:59:60.1234567"))

    // Shapes.
    println(parseTime(""))
    println(parseTime("9:30"))
    println(parseTime("09"))
    println(parseTime("09:"))
    println(parseTime("09:3"))
    println(parseTime("0930"))
    println(parseTime("09.30"))
    println(parseTime("09:30:"))
    println(parseTime("09:30:0"))
    println(parseTime("09:30:07."))
    println(parseTime("09:30:07.x"))
    println(parseTime("-09:30"))
    println(parseTime(" 09:30"))
    println(parseTime("09:30:07,5"))

    // Text after a whole time.
    println(parseTime("09:30 "))
    println(parseTime("09:30.5"))
    println(parseTime("09:30:07Z"))
    println(parseTime("09:30:07.5+01:00"))
    println(parseTime("24:00x"))

    // Digits are ASCII only.
    println(parseTime("٠٩:30"))
    println(parseTime("09:30:07.٥"))
    println(parseTime("０9:30"))

    println(parseTime("09-30") == Err(BadShape("09-30", 2, "':'")))
    println(parseTime("24:00") == Err(OutOfRange("24:00", "hour")))
    println(parseTime("09:30 ") == Err(Trailing("09:30 ", 5)))

    // Every display reads back: a sweep of the day with 0 to 6 digits of fraction.
    var failures = 0
    var checked = 0
    val fractions = [0, 100000, 120000, 123000, 123400, 123450, 123456, 1, 999999, 500000]
    var second: long = 0
    while second < 86400
        for f in fractions
            val t = timeOfMicros(second * 1000000 + long(f))
            if parseTime(s"$t") != Ok(t) then failures += 1
            checked += 1
        second += 373
    println(s"$checked times read back, $failures failures")
    println(parseTime(s"${timeOfMicros(86399999999)}"))
