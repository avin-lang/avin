// expect: exit 0
// `fs.setOwner` and `fs.ownerName`: what an ordinary user may do (give a file to herself and her own
// group, which changes nothing), what the platform refuses (another user), ids outside 0 to
// 4294967295 refused before the path is looked at, a missing path, a directory, a symbolic link
// (followed), a Unicode name, and the owner's name read back through `process.userName`. Results
// that depend on who runs the test are printed as booleans.
import avin.fs
import avin.io
import avin.io.IoError
import avin.process

@sysl("sysl.fs.IoError")
private data SyslIoError
  NotFound
  PermissionDenied
  AlreadyExists
  NotADirectory
  IsADirectory
  DirectoryNotEmpty
  TooManyOpenFiles
  NoSpaceLeft
  Interrupted
  NotOpen
  NotPermitted
  InvalidUtf8(offset: long)
  Other(code: int)

@sysl("sysl.fs.symlink")
private symlinkRaw(target: string, link: string) -> Result[unit, SyslIoError]

var root = ""

say(line: Any)
  println(if root == "" then s"$line" else s"$line".replace(root, "DIR"))

// The owner and group ids of `file` as `metadata` reads them, as "same" when they are the
// program's own.
who(file: string) -> string = fs.metadata(file) match
  Ok(m) -> s"${m.owner == process.userId()} ${m.group == process.groupId()}"
  Err(e) -> s"$e"

main()
  val dir = fs.createTempDir("avin-fs-owner").getOrElse("")
  root = dir
  val file = dir + "/token"
  _ = fs.writeText(file, "secret")
  val me = process.userId()
  val myGroup = process.groupId()
  // A file the program made is its own.
  say(who(file))
  // Giving a file to oneself succeeds, on a file, a directory and through a link, and changes nothing.
  say(fs.setOwner(file, me, myGroup))
  say(who(file))
  val sub = dir + "/sub"
  _ = fs.createDir(sub)
  say(fs.setOwner(sub, me, myGroup))
  say(who(sub))
  val link = dir + "/link"
  _ = symlinkRaw(file, link)
  say(fs.setOwner(link, me, myGroup))
  say(who(link))
  val uni = dir + "/héllo 世界"
  _ = fs.writeText(uni, "x")
  say(fs.setOwner(uni, me, myGroup))
  // The contents and the mode stay as they were.
  _ = fs.setPermissions(file, 0o640)
  say(fs.setOwner(file, me, myGroup))
  say(s"${fs.readText(file)} ${fs.permissions(file)}")
  // Another user is the platform's refusal for a user who is not the superuser.
  if me != 0
    say(fs.setOwner(file, me + 1, myGroup))
    say(fs.setOwner(file, 0, myGroup))
    say(who(file))
  // Ids outside 0 to 4294967295 are refused first and the file is left as it was.
  say(fs.setOwner(file, -1, myGroup))
  say(fs.setOwner(file, me, -1))
  say(fs.setOwner(file, 4294967296, myGroup))
  say(fs.setOwner(file, me, 4294967296))
  say(fs.setOwner(file, 9223372036854775807, myGroup))
  say(who(file))
  // A missing path, and a path through a file.
  say(fs.setOwner(dir + "/missing", me, myGroup))
  say(fs.setOwner(file + "/below", me, myGroup))
  say(fs.setOwner(dir + "/dangling", me, myGroup))
  // The owner's name is the one `process.userName` gives, for a file, a directory and a link.
  val named = process.userName(me)
  say(fs.ownerName(file) == named)
  say(fs.ownerName(sub) == named)
  say(fs.ownerName(link) == named)
  say(fs.ownerName(uni) == named)
  say(fs.ownerName(dir + "/missing"))
  // A dangling link is `NotFound`, as `metadata` has it.
  _ = symlinkRaw(dir + "/gone", dir + "/dangling")
  say(fs.ownerName(dir + "/dangling"))
  // Root's file would be named `root`: the name of id 0 is what `userName` says.
  say(process.userName(0))
  _ = fs.removeDirAll(dir)
