// expect: exit 0
// A data type, a class or a trait may name methods `!`, `~` and `+` taking no argument, which the
// prefix operators call, as a prefix `-` calls a method `-`. Each may yield any type and binds at the
// prefix level; where a type has no such method, the operator keeps its own meaning.

// A query builder's condition: `!c` builds the negated condition rather than a `bool`.
data Cond(text: string)

impl Cond
  !() -> Cond = Cond(s"NOT ($text)")
  &(other: Cond) -> Cond = Cond(s"$text AND ${other.text}")
  -() -> Cond = Cond(s"MINUS ($text)")
  ~() -> Cond = Cond(s"LIKE ($text)")

data Col(name: string)

impl Col
  <(n: int) -> Cond = Cond(s"$name < $n")

data Query(where: Cond)

// A set of eight bits as a class: `~` is the complement, `+` alone its count, and both are also
// overloaded with one argument for the binary form.
class Bits(val word: int)
  ~() -> Bits = Bits(~word & 255)
  ~(other: Bits) -> Bits = Bits(word ^ other.word)
  +() -> int = count(word)
  +(other: Bits) -> Bits = Bits(word | other.word)
  -() -> Bits = Bits(0)
  show() -> string = s"Bits($word)"

count(n: int) -> int
  var k = 0
  var w = n
  while w != 0
    k += w & 1
    w = w >> 1
  k

// A method `!` yielding a `bool` makes `!x` a condition.
data Stack(items: Vector[int])

impl Stack
  !() -> bool = items.isEmpty

// A generic data type's methods.
data Pair[T](a: T, b: T)

impl[T] Pair[T]
  ~() -> Pair[T] = Pair(b, a)
  !() -> Vector[T] = [b, a]

// A trait declares them, its classes implement them, and a value of the trait dispatches.
trait Sign
  !() -> Sign
  ~() -> int
  +() -> string
  label() -> string

class Yes: Sign
  override !() -> Sign = No()
  override ~() -> int = 1
  override +() -> string = "+yes"
  override label() -> string = "yes"

class No: Sign
  override !() -> Sign = Yes()
  override ~() -> int = 0
  override +() -> string = "+no"
  override label() -> string = "no"

// A bound declares them for generic code: `Self` is the implementing type.
trait Flip
  !() -> Self
  ~() -> Self
  +() -> int

data Coin(heads: bool)

impl Flip for Coin
  !() -> Coin = Coin(!heads)
  ~() -> Coin = Coin(true)
  +() -> int = if heads then 1 else 0

// A bound's `!` yielding a `bool` is a condition in generic code.
trait Blank
  !() -> bool

data Tray(count: int)

impl Blank for Tray
  !() -> bool = count == 0

blanks[T: Blank](xs: Vector[T]) -> int
  var k = 0
  for x in xs
    if !x then k += 1
  k

twice[T: Flip](x: T) -> T = ! !x
settle[T: Flip](x: T) -> int = +(~x)
score[T: Flip](xs: Vector[T]) -> int
  var total = 0
  for x in xs
    total += +x + +(!x)
  total

main()
  val c = Col("age") < 30
  println((!c).text)
  // Prefix binds tighter than a binary operator: `!c & c` is `(!c) & c`.
  println((!c & c).text)
  // A member is reached before the prefix applies: `!q.where` is `!(q.where)`.
  val q = Query(Col("n") < 5)
  println((!q.where).text)
  // Nested prefixes, each a call of its own method.
  println((! !c).text)
  println((- ~c).text)
  println((~ -c).text)
  println((! - ~c).text)
  // The dotted forms name the same methods.
  println(c.!().text)
  println(c.~().text)
  val b = Bits(5)
  println((~b).show())
  println(+b)
  println(+(~b))
  // `~b + b` is `(~b) + b`, and the binary forms still take one argument.
  println((~b + b).show())
  println((b ~ Bits(3)).show())
  println((b + Bits(2)).show())
  println(+b + +Bits(255))
  println((-b).show())
  println((- ~b).show())
  // `+b.word` reaches the field first, so it is the built-in `+` on an int.
  println(+b.word)
  // A `!` yielding a `bool` is a condition, in `if`, `while`, with `&&` and `||`.
  val empty = Stack([])
  val full = Stack([1, 2])
  if !empty then println("empty") else println("not empty")
  if !full then println("empty") else println("not empty")
  println(!empty && !full)
  println(!empty || !full)
  println(! !empty)
  var s = Stack([1, 2, 3])
  var popped = 0
  while !(!s)
    s = Stack(s.items.dropRight(1))
    popped += 1
  println(popped)
  // Generic instances.
  val p = ~Pair(1, 2)
  println(s"${p.a} ${p.b}")
  val ps = ~Pair("x", "y")
  println(s"${ps.a} ${ps.b}")
  println(!Pair('a', 'b'))
  // A trait's value dispatches on its class.
  val signs: Vector[Sign] = [Yes(), No()]
  for sign in signs
    println(s"${(!sign).label()} ${~sign} ${+sign} ${(! !sign).label()}")
  // Through a bound.
  println(twice(Coin(true)).heads)
  println(settle(Coin(false)))
  println(score([Coin(true), Coin(false), Coin(true)]))
  println(blanks([Tray(0), Tray(2), Tray(0), Tray(1)]))
  println(!Tray(0))
  // In a closure, and many times over, so the collector runs among the calls.
  val conds = [Col("a") < 1, Col("b") < 2]
  println(conds.map(x -> (!x).text))
  var last = Cond("")
  for i in 0..<2000
    last = !Cond(s"c$i")
  println(last.text)
  // Where a type has no method of the operator's name, it keeps its own meaning.
  println(!true)
  println(! !false)
  println(~5)
  println(~byte(15))
  println(+7)
  println(+2.5)
  println(-(3))
  val n = 4
  println(~n + n)
  println(!(n < 3))
