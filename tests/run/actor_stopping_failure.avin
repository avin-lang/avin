// expect: exit 0
// `failure()` answers, in an actor's `stopping` block and in what it calls, the reason of the trap
// ending or restarting the actor: after a failure under `Stop`, during a restart, and in a child and
// its parent where the child's failure escalates. It answers `None` in a `stopping` block that runs
// after a plain stop, in the actor's body and arms, and in code that is no actor's.
import avin.actors.{ActorRef, Restart, Stop, failure, spawn}
import avin.threads.Channel
import avin.time

data Cmd
  Boom
  Halt

actor Probe(name: string, out: Channel[string]) receives Cmd
  out.send(s"$name starts, seeing ${failure()}")
  receive
    Boom -> fail(s"boom in $name")
    Halt -> stop()
  stopping
    out.send(s"$name stopping after ${failure()}")
    note(out, name)

private note(out: Channel[string], name: string) = out.send(s"$name: a function its stopping calls sees ${failure()}")

data Go
  Go

actor Parent(out: Channel[string]) receives Go
  val child: ActorRef[Cmd] = spawn(Probe("child", out))
  receive
    Go -> child.tell(Boom)
  stopping
    out.send(s"parent stopping after ${failure()}")

private show(out: Channel[string], n: int)
  for i in 0 ..< n do println(out.receive().get)

main()
  val out = Channel[string]()
  println(s"main sees ${failure()}")
  val a = spawn(Probe("stopped", out), onFailure = Stop)
  show(out, 1)
  a.tell(Boom)
  show(out, 2)
  _ = a.ended().await()
  val b = spawn(Probe("restarted", out), onFailure = Restart(1, time.minutes(1)))
  show(out, 1)
  b.tell(Boom)
  show(out, 3)
  b.tell(Halt)
  show(out, 2)
  _ = b.ended().await()
  val p = spawn(Parent(out), onFailure = Stop)
  show(out, 1)
  p.tell(Go)
  show(out, 3)
  println(s"parent ended ${p.ended().await()}")
  println(s"main still sees ${failure()}")
