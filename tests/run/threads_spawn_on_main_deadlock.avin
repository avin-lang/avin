// expect: trap
// The main thread joins a thread pinned to it that waits on a channel nothing will ever send to: the
// main thread runs it as it waits, it parks, and nothing is left that could make either ready. The
// deadlock report names the pinned thread as pinned to the main thread.
import avin.threads.{Channel, spawnOnMain}

main()
  val c = Channel[int]()
  val t = spawnOnMain(() -> c.receive())
  println("joining")
  println(t.join())
  println("not reached")
