// expect: exit 0
// The methods every Seq has, on a class of the program's own that conforms to `Seq` by giving
// `length()` and `apply(i)`, and the kind each concrete sequence answers with: a list, a vector and
// an `ArraySeq` their own; an array, a buffer and a deque their own for the element-wise methods and
// a vector for the structural ones; a range a vector. Counts held to the sequence, multiset
// `intersect` and `diff` with data values, and the searches with their `from` and `end`.

data Point(x: int, y: int)

class Squares(val n: int) : Seq[int]
    override length -> int = n
    override apply(i: int) -> int = i * i

main()
    val sq = Squares(5)
    println(s"${sq.length} ${sq(3)} ${sq.lift(7)} ${sq.head} ${sq.last} ${sq.contains(9)}")
    val sqTaken: Vector[int] = sq.take(2)
    val sqMapped: Vector[string] = sq.map(x -> x.toString())
    println(s"$sqTaken $sqMapped ${sq.reverse} ${sq.indexOf(4)} ${sq.foldRight(0, (x, acc) -> x - acc)}")
    println(s"${sq.reverseIterator().toList} ${sq.sliding(2, 3).toVector} ${sq.mkString("+")} ${sq.max}")

    val l: List[int] = [1, 2, 3, 2]
    val lt: List[int] = l.takeWhile(x -> x < 3)
    val ld: List[int] = l.drop(1)
    val lr: List[int] = l.reverse
    val lp: List[int] = l.padTo(6, 0)
    val ldist: List[int] = l.distinct
    val (la, lb) = l.span(x -> x < 2)
    val lspan: (List[int], List[int]) = (la, lb)
    println(s"$lt $ld $lr $lp $ldist $lspan ${l.splitAt(50)} ${l.splitAt(-3)}")
    val v = [5, 6, 7]
    val vd: Vector[int] = v.drop(2)
    val vt: Vector[int] = v.takeRight(10)
    val vi: Vector[int] = v.init
    println(s"$vd $vt $vi ${v.take(-1)} ${v.drop(100)} ${v.dropRight(1)} ${v.slice(1, 1)}")
    val a: ArraySeq[int] = [3, 1, 2]
    val ar: ArraySeq[int] = a.reverse
    val af: ArraySeq[int] = a.filter(x -> x > 1)
    val am: ArraySeq[string] = a.map(x -> s"n$x")
    println(s"$ar $af $am")

    val arr = Array.tabulate(3, i -> i + 1)
    val arrMapped: Array[int] = arr.map(x -> x * 10)
    val arrDropped: Vector[int] = arr.drop(1)
    val buf = [4, 5, 6].toBuffer()
    val bufFiltered: Buffer[int] = buf.filter(x -> x != 5)
    val bufTaken: Vector[int] = buf.take(1)
    val dq = Deque[int]()
    dq.append(8)
    dq.prepend(7)
    val dqMapped: Deque[int] = dq.map(x -> x + 1)
    val dqReversed: Vector[int] = dq.reverse
    println(s"${arrMapped.toList} $arrDropped ${arr.toList} ${bufFiltered.toList} $bufTaken ${buf.length} ${dqMapped.toList} $dqReversed ${dq.toList}")
    val r = 1..5
    val rm: Vector[int] = r.map(x -> x * 2)
    val rf: Vector[int] = r.filter(x -> x % 2 == 0)
    val rt: Vector[int] = r.tail
    println(s"$rm $rf $rt ${r.indices.toList} ${r.scanLeft(0, (s, x) -> s + x)}")

    val through: Seq[int] = l
    val tv: Vector[int] = through.takeWhile(x -> x < 3)
    println(tv)

    println(s"${[1, 1, 2].intersect([1, 3])} ${[1, 1, 2].diff([1, 3])} ${[3, 1, 3, 1].intersect([1, 3, 3])}")
    val pts = [Point(1, 2), Point(1, 2), Point(3, 4)]
    println(s"${pts.diff([Point(1, 2)])} ${pts.intersect([Point(3, 4), Point(9, 9)])} ${pts.distinct}")
    println(pts.distinctBy(p -> p.x))
    println([1, 2, 3].zipAll(["a"], 0, "-"))
    println(["a"].zipAll([1, 2], "?", 0))
    println(Vector.empty[int]().zipAll(Vector.empty[string](), 0, ""))
    println(Vector.empty[int]().scanLeft(7, (s, x) -> s + x))
    println([1, 2, 3, 4, 5].grouped(2).toVector)
    println([1, 2, 3, 4, 5].sliding(3, 2).toVector)
    println([1, 2].sliding(5).toVector)
    println([1, 2, 3, 4].sliding(2, 3).toVector)
    println(Vector.empty[int]().grouped(3).toVector)
    val xs = [1, 2, 1, 2, 1]
    println(s"${xs.indexOf(2)} ${xs.indexOf(2, 2)} ${xs.indexOf(2, 9)} ${xs.indexWhere(x -> x > 1, 4)}")
    println(s"${xs.lastIndexOf(2)} ${xs.lastIndexOf(2, 2)} ${xs.lastIndexOf(1, 0)} ${xs.lastIndexWhere(x -> x > 5)}")
    println(s"${xs.startsWith([1, 2])} ${xs.startsWith(Vector.empty[int]())} ${xs.endsWith([2, 1])} ${xs.endsWith([1, 2, 1, 2, 1, 2])}")
    println(s"${xs.sameElements(List(1, 2, 1, 2, 1))} ${xs.sameElements([1, 2])} ${Vector.empty[int]().sameElements(List[int]())}")
    println(s"${Vector.empty[int]().lift(0)} ${Vector.empty[int]().headOption} ${Vector.empty[int]().lastOption} ${xs.lift(-1)}")
