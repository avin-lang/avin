// expect: trap
// A `Once` whose body runs the same `Once` again would wait for ever, so it traps, as a mutex
// taken twice does.
import avin.threads.Once

main()
  val once = Once()
  once.run(() -> println("outer"))
  val again = Once()
  again.run(() ->
    println("inner")
    again.run(() -> println("never")))
