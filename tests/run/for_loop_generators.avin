// A `for` without `yield` takes several generators, `if` guards and value definitions, and runs as
// the loops they would nest into: `break` and `continue` act on the innermost generator's loop, and
// `return` leaves the function.

data Point(x: int, y: int)

// Counts how often a guard or a definition is evaluated.
class Tally(var n: int)
  seen[T](value: T) -> T
    n += 1
    value

class Countdown(from: int): Iterable[int]
  override iterator() -> Iterator[int] = Ticks(from)

class Ticks(private var n: int): Iterator[int]
  override hasNext() -> bool = n > 0
  override next() -> int
    n -= 1
    n + 1

firstPair(target: int) -> (int, int)
  for i in 0 ..< 10, j in i ..< 10 if i * j == target do return (i, j)
  (-1, -1)

firstFromDefinition(xs: Vector[int]) -> int
  for x in xs, y = x * x if y > 20 do return y
  0

count[T](xs: Vector[T], ys: Vector[T], same: (T, T) -> bool) -> int
  var n = 0
  for x in xs, y in ys if same(x, y) do n += 1
  n

others(c: int) -> Vector[int] =
  for d in 0 ..< 4 if d != c
    yield d

main()
  // The motivating forms.
  for i in 0 ..< 3, j in i + 1 ..< 3 do println(s"pair $i $j ${i * j}")
  val xs = [3, -1, 4, -1, 5]
  for x in xs if x > 0 do println(s"positive $x")

  // Three generators, the later ones reading the earlier ones.
  var triples = 0
  for a in 1 .. 4, b in a .. 4, c in b .. 4 if a + b > c do triples += 1
  println(s"triples $triples")

  // A guard before the second generator tests once per element of the first.
  val tested = Tally(0)
  for i in 0 ..< 4 if tested.seen(i % 2 == 0), j in 0 ..< 3 do println(s"even $i $j")
  println(s"tested ${tested.n}")

  // Several guards in a row, each tested only where the one before it held.
  val seconds = Tally(0)
  for i in 0 ..< 6 if i > 1 if seconds.seen(i < 4) do println(s"between $i")
  println(s"seconds ${seconds.n}")

  // Value definitions: evaluated once per element that reaches them, bound in everything after.
  val made = Tally(0)
  for i in 1 .. 3, sq = made.seen(i * i) if sq > 1, j in 0 ..< 2 do println(s"def $i $sq $j")
  println(s"made ${made.n}")
  for p in [Point(1, 2), Point(3, 4)], Point(px, py) = p, (s, d) = (px + py, py - px) do println(s"parts $px $py $s $d")
  val ignored = Tally(0)
  for i in 0 ..< 3, _ = ignored.seen(i) do println(s"wild $i")
  println(s"ignored ${ignored.n}")

  // `continue` goes to the innermost generator's next element.
  for i in 0 ..< 3, j in 0 ..< 3
    if j == 1 then continue
    println(s"continue $i $j")

  // `break` leaves the innermost generator's loop; the outer one goes on.
  for i in 0 ..< 3, j in 0 ..< 5
    if j > i then break
    println(s"break $i $j")

  // `return` leaves the function from any depth.
  println(s"found ${firstPair(12)}")
  println(s"missing ${firstPair(97)}")
  println(s"defined ${firstFromDefinition([2, 3, 5, 7])}")
  println(s"undefined ${firstFromDefinition([1, 2])}")

  // An indented body, patterns taking elements apart, and every kind of source.
  for (k, name) in [(1, "one"), (2, "two")], c in Countdown(k)
    val shown = s"$name:$c"
    println(shown)
  val grid = Array.tabulate(2, i -> Array.tabulate(2, j -> i * 2 + j))
  for row in grid, cell in row if cell != 2 do println(s"cell $cell")
  for x in 0 .. 10 by 5, y in 10 .. 0 by -10 do println(s"stepped $x $y")
  val big: long = 3000000000
  for x in big ..< big + 2, y in 0 ..< 1 do println(s"long $x $y")
  for x in 2147483646 .. 2147483647, y in -2147483648 .. -2147483647 do println(s"edge $x $y")

  // Empty sources run nothing, outer or inner.
  for i in 0 ..< 0, j in 0 ..< 3 do println("never")
  for i in 0 ..< 3, j in 0 ..< 0 do println("never")
  for i in 0 ..< 3 if false do println("never")
  for i in Vector.empty[int](), j in [1] do println("never")

  // A generic function, and Unicode strings.
  println(s"same ${count([1, 2, 3], [3, 2, 1, 2], (a, b) -> a == b)}")
  println(s"words ${count(["é", "ü"], ["ü", "日本"], (a, b) -> a == b)}")

  // Each element is a new binding, so closures keep the ones they saw.
  val fs = Buffer[() -> int]()
  for i in 0 ..< 2, j in 0 ..< 2 if i != j do fs += () -> i * 10 + j
  for f in fs do println(s"closure ${f()}")

  // Allocation in every iteration, under the collector's pressure.
  var length = 0
  for i in 0 ..< 200, j in 0 ..< 50 if (i + j) % 7 == 0, text = s"$i-$j" do length += text.charCount
  println(s"length $length")

  // `yield` on the line under a one-line `for`'s clauses.
  println(s"others ${others(2)}")
  val products =
    for i in 1 .. 3, j in 1 .. 3 if i < j
      yield i * j
  println(s"products $products")
  val blocks = for x in [1, 2, 3] if x != 2
    yield
      val y = x * 10
      y + 1
  println(s"blocks $blocks")
