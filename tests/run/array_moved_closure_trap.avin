// expect: trap
// A closure that captured the array before it moved holds the same array: calling it afterwards
// traps at the use inside the closure.
import avin.actors.Isolated

main()
  val a = Array.fill[int](3, 7)
  val bump = () -> a(0) = a(0) + 1
  bump()
  val moved = Isolated.move(a)
  println("moved")
  bump()
  println(moved.take()(0))
