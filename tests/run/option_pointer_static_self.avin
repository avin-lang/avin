// expect: exit 0
// A trait `Option` conforms to whose static member gives `Self` inside another type (`Missable`'s
// `whenMissing() -> Option[Self]`, and here `Spares`'s `spares() -> Vector[Self]`) keeps options of
// classes as pointers: a static member is called on a type, never on an option made an object, and
// each body of it is compiled for the type it is called on. So an `Option[Dog]` boxed as an `Any`
// stays an `Option[Dog]`, beside an `Option[Nothing]` that is another type, as with no such trait;
// and the static members give their options, nested, as written.

class Dog(val name: string) derives Display, Eq

trait Spares
  static spares() -> Vector[Self]
  static firstSpare() -> Option[Self] = Self.spares().headOption

impl[A] Spares for Option[A]
  static spares() -> Vector[Option[A]] = [None]

val nones = [None, None]

all() -> Vector[Option[Dog]] = nones

nothing() -> Option[Nothing] = None

sparesOf[T: Spares]() -> Vector[T] = T.spares()

main()
  val some: Vector[Option[Dog]] = [Some(Dog("rex")), None]
  val anything: Any = all()(0)
  val dog: Any = some(1)
  println(s"$anything ${anything == None} ${anything == dog}")
  println(s"${all()(0) == nothing()} ${some(0).map(d -> d.name)}")
  println(Option[Dog].spares())
  println(sparesOf[Option[Dog]]())
  println(Option[Dog].firstSpare())
  println(Option[string].firstSpare().map(o -> o.isEmpty))
  println(Option[Dog].whenMissing())
  println(missingThrough[Option[Dog]]())
  val made: Vector[Option[Dog]] = Vector.tabulate(5, i -> if i % 2 == 0 then Some(Dog(s"d$i")) else None)
  println(made.map(o -> o.map(d -> d.name).getOrElse("-")))

missingThrough[T: Missable]() -> Option[T] = T.whenMissing()
