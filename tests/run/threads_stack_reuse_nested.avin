// expect: exit 0
// env: AVIN_GC_STRESS=0
// Lightweight threads that start short threads of their own, each through a scope and directly, so
// the starters run on workers too and several of them take and give back stacks at once while other
// workers end the threads they started. Eight starters of six thousand threads each.
import avin.threads.{Atomic, scope, spawn}

main() -> int
    val counted = Atomic(0)
    val starters = (0..<8).map(k ->
        spawn(() ->
            scope(s ->
                for i in 0..<3000
                    s.spawn(() -> counted.update(c -> c + 1)))
            var mine = 0
            for i in 0..<3000
                mine += spawn(() -> i % 2 + k).join()
            mine)).toVector
    var total = 0
    for t in starters do total += t.join()
    println(counted.load())
    println(total)
    0
