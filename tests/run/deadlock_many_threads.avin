// expect: trap
// Ten threads receive from one channel nothing sends to, `main` joins the first, and two threads that
// ended before are not listed: the report has one line for each thread still there, in the order
// they started, numbered from 1 by that order.
import avin.threads.{Channel, spawn}

main()
  val done = spawn(() -> 1)
  val also = spawn(() -> 2)
  println(done.join() + also.join())
  val c = Channel[int]()
  val waiting = Vector.tabulate(10, i -> spawn(() -> c.receive().getOrElse(i)))
  println(waiting(0).join())
