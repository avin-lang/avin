// expect: exit 0
// A variant with fields, named and not called, is its constructor as a function value, as a class's
// name is: bare, qualified through its type, or with type arguments; passed to a method, a generic
// function, an actor's `adapter` and a thread; stored, typed by an expected function type or by its
// own fields. A generic variant takes its instance from the expected type, from written type
// arguments, or from what is passed; a refined variant makes its declared instance; an expected
// function type's result decides between variants sharing a name; a variant without fields stays a
// value.
import avin.actors.{ActorRef, spawn}
import avin.threads
import avin.time

data Msg
  Heard(text: string)
  Pair(count: int, text: string)
  Named(name: string = "nobody", times: int = 1)
  Range(from: int, until: int)
  Quiet

data Slant
  Normal(degrees: int)
  Italic

data Weight
  Normal(grams: int)
  Bold

data Tree[T]
  Leaf
  Node(left: Tree[T], value: T, right: Tree[T])

data Expr[T]
  IntLit(value: int) -> Expr[int]
  BoolLit(value: bool) -> Expr[bool]
  Both[A, B](first: Expr[A], second: Expr[B]) -> Expr[(A, B)]

class Point(x: int, y: int) derives Display

eval[T](e: Expr[T]) -> string = e match
  IntLit(v) -> s"int $v"
  BoolLit(v) -> s"bool $v"
  Both(a, b) -> s"(${eval(a)}, ${eval(b)})"

// A generic function whose parameter type the value decides.
applyTo[A, B](f: (A) -> B, a: A) -> B = f(a)

twice[A, B](f: (A, A) -> B, a: A) -> B = f(a, a)

sendable(f: @sendable (string) -> Msg) -> Msg = f("sent")

// A generic function whose variant value takes its instance from the function's type parameter.
wrapAll[T](xs: Vector[T]) -> Vector[Option[T]] = xs.map(Some)

data Ear
  Caught(event: string)
  Give(reply: ActorRef[ActorRef[string]])
  Stop(reply: ActorRef[Vector[string]])

actor Listener receives Ear
  // The adapter's protocol is the variant's field type, with nothing written.
  val ear = adapter(Caught)
  var heard = Vector.empty[string]()
  receive
    Caught(event) -> heard = heard :+ event
    Give(reply) -> reply.tell(ear)
    Stop(reply) ->
      reply.tell(heard)
      stop()

main()
  // Bare, to a method, a stored value, and a typed one.
  println(["a", "b", ""].map(Heard))
  val heard = Heard
  println(heard("x"))
  val pair: (int, string) -> Msg = Pair
  println(pair(1, "y"))
  println([2, 3].map(n -> pair(n, "é")))
  // Every field is a parameter, defaults included, in order.
  val named = Named
  println(named("ada", 3))
  println(twice(Range, 7))
  // A class's name and a variant's are values alike.
  val point = Point
  println(point(1, 2))
  // Generic: from the expected type, from the receiver's elements, from written type arguments, and
  // from a type parameter of the enclosing function.
  println([1, 2].map(Some))
  val some: (string) -> Option[string] = Some
  println(some("s"))
  val written = Some[long]
  println(written(9_000_000_000))
  val qualified = Option.Some[int]
  println(qualified(-1))
  println(wrapAll(Vector.empty[int]()))
  println(wrapAll(["q"]))
  // Through a generic function: the variant's field type decides the function's parameter.
  println(applyTo(Heard, "z"))
  println(applyTo(Slant.Normal, 12))
  // Qualified through its type, and shared names decided by the expected result.
  val slant: (int) -> Slant = Normal
  val weight: (int) -> Weight = Normal
  println(slant(10))
  println(weight(20))
  println([1].map(Weight.Normal))
  // Generic variants of the program's own type, at two instances, and a value taking a value.
  val node: (Tree[int], int, Tree[int]) -> Tree[int] = Node
  println(node(Leaf, 1, node(Leaf, 2, Leaf)))
  val words = Tree.Node[string]
  println(words(Leaf, "w", Leaf))
  // Refined variants make their declared instance.
  val lit = IntLit
  val bit = BoolLit
  println(eval(lit(4)))
  println(eval(Both(lit(1), bit(true))))
  println([5, 6].map(IntLit).map(eval))
  val both: (Expr[int], Expr[bool]) -> Expr[(int, bool)] = Both
  println(eval(both(lit(7), bit(false))))
  // A variant without fields stays a value.
  val quiet = Quiet
  println(quiet)
  println([Quiet, Heard("h")])
  // Where a `@sendable` function is expected, and run on another thread.
  println(sendable(Heard))
  val made = threads.spawn(() -> ["t1", "t2"].map(Msg.Heard))
  println(made.join())
  // An actor's adapter takes the variant itself.
  val patience = time.seconds(30)
  val listener = spawn(Listener())
  val ear = listener.ask(Give, patience).await().ok.get
  ear.tell("one")
  ear.tell("two")
  println(listener.ask(Stop, patience).await().ok.get)
  // Many values, made under collection.
  var total = 0
  for i in 0 ..< 20_000
    val built = (0 ..< 8).map(Some).map(o -> o.getOrElse(0))
    total += built.sum
  println(total)
