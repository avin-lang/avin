// expect: exit 0
// Overloaded functions: several functions of one name, told apart by their parameter types. A call
// chooses the one its arguments fit; when several fit, the most specific.

describe(n: int) -> string = s"int $n"
describe(s: string) -> string = s"string $s"
describe(b: bool) -> string = s"bool $b"

// A real argument chooses the real overload.
measure(r: real) -> string = "real"
measure(s: string) -> string = "string"

// By arity, and by a parameter after the first.
sum(a: int) -> int = a
sum(a: int, b: int) -> int = a + b
sum(a: int, b: int, c: int) -> int = a + b + c

pair(a: int, b: string) -> string = s"int, string"
pair(a: string, b: int) -> string = s"string, int"

// A literal fits any parameter it can become: here only `byte` holds 200 and only `i8` holds -100.
small(x: i8) -> string = "i8"
small(x: string) -> string = "string"
octet(x: byte) -> string = "byte"
octet(x: bool) -> string = "bool"

// A generic overload and a specific one: the specific one is more specific, so it wins where both fit.
which[T](x: T) -> string = "any"
which(x: int) -> string = "int"

// One generic overload more specific than another.
data Maybe[T]
    Just(value: T)
    Empty

shape[T](x: T) -> string = "plain"
shape[T](x: Maybe[T]) -> string = "option"

// Named arguments choose by name as well as by type.
area(width: int, height: int) -> int = width * height
area(side: int) -> int = side * side

// Overloads may call each other, and themselves.
count(n: int) -> int = if n == 0 then 0 else 1 + count(n - 1)
count(s: string) -> int = if s == "" then 0 else 100 + count(2)

// A lambda fits an overload whose parameter is a function of as many parameters.
run(f: (int) -> int) -> int = f(10)
run(f: (int, int) -> int) -> int = f(10, 20)

// By-name and strict overloads with different types.
twice(value: -> int) -> int = value + value
twice(value: string) -> string = value + value

data Shape
    Circle(radius: int)
    Square(side: int)

size(s: Shape) -> int = s match
    Circle(r) -> r
    Square(x) -> x
size(n: int) -> int = n

apply_int(f: (int) -> string, n: int) -> string = f(n)
apply_text(f: (string) -> string, s: string) -> string = f(s)

main()
    print(describe(1))
    print(describe("a"))
    print(measure(1.5))
    print(describe(true))
    print(s"${sum(1)} ${sum(1, 2)} ${sum(1, 2, 3)}")
    print(pair(1, "a"))
    print(pair("a", 1))
    print(small(-100))
    print(octet(200))
    print(which(1))
    print(which("x"))
    // Written type arguments leave only the overloads with that many type parameters.
    print(which[int](1))
    print(shape(1))
    print(shape(Just(1)))
    print(s"${area(2, 3)} ${area(side = 4)} ${area(height = 5, width = 2)}")
    print(s"${count(3)} ${count("abcd")}")
    print(s"${run(x -> x + 1)} ${run((a, b) -> a + b)}")
    var reads = 0
    next() -> int
        reads += 1
        4
    print(s"${twice(next())} $reads")
    print(twice("ab"))
    // An argument some overload takes by name is evaluated once, at the call, by one that takes it
    // strictly.
    var made = 0
    make() -> string
        made += 1
        "cd"
    print(s"${twice(make())} $made")
    print(s"${size(Circle(3))} ${size(Square(4))} ${size(5)}")
    // A function used as a value takes its overload from the expected function type.
    print(apply_int(describe, 7))
    print(apply_text(describe, "seven"))
    val f: (bool) -> string = describe
    print(f(false))
    val g: (int) -> string = which
    print(g(2))

    // Local functions overload one another within their block, and hide outer functions of the
    // same name whatever their parameter types.
    show(n: int) -> string = s"local int $n"
    show(s: string) -> string = s"local string $s"
    print(show(1))
    print(show("x"))
    if true
        describe(n: long) -> string = s"inner long $n"
        print(describe(5))
