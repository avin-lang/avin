// expect: exit 0
// An integer of any width and a `BigInt` meet a `BigDecimal` under every arithmetic operator and
// every comparison, on either side, chains and compound assignments included; each converted operand
// is evaluated once, where it stands.
var calls = 0

counted(n: int) -> int
  calls += 1
  n

countedBig(n: BigInt) -> BigInt
  calls += 1
  n

main()
  val x: BigDecimal = 7.5
  val i: int = 2
  val l: long = 3000000000
  val b: i8 = -4
  val w: i128 = 170141183460469231731687303715884105727
  val big: BigInt = 123456789012345678901234567890
  // Integers of each width, on both sides.
  println(s"${x + i} ${i + x} ${x - i} ${i - x} ${x * i} ${i * x} ${x / i} ${i / x} ${x % i} ${i % x}")
  println(s"${x + l} ${l - x} ${x * b} ${b * x} ${x / b} ${b % x}")
  println(s"${x + w} ${w - x}")
  // A `BigInt`, on both sides.
  println(s"${x + big} ${big + x} ${x - big} ${big - x}")
  println(s"${x * big} ${big * x}")
  println(s"${big / x} ${x / big}")
  println(s"${big % x} ${x % big}")
  // Comparisons and `==`, on both sides, and chains mixing all three.
  println(s"${x > i} ${i < x} ${x == 7} ${7 == x} ${x != i} ${x >= l} ${l > x}")
  println(s"${x < big} ${big > x} ${x == big} ${big != x}")
  val seven: BigInt = 7
  val sevenPoint: BigDecimal = 7.0
  println(s"${sevenPoint == seven} ${seven == sevenPoint} ${seven <= sevenPoint} ${sevenPoint >= 7}")
  println(0 < x < big)
  println(i < x < l < big)
  println(big > x > i > 0)
  println(i <= x <= 8 <= big)
  println(seven < x < 8)
  // Compound assignment converts the value into a `BigDecimal` target.
  var acc: BigDecimal = 1.5
  acc += i
  acc *= l
  acc -= big
  acc /= 4
  acc %= big
  println(acc)
  var bump: BigDecimal = 0
  for k in 1 .. 4 do bump += k
  println(bump)
  // Each converted operand is evaluated once.
  calls = 0
  println(x + counted(1))
  println(counted(2) * x)
  println(x < counted(8))
  println(countedBig(seven) + x)
  println(x == countedBig(seven))
  println(calls)
  // A result is a `BigDecimal`, which takes the next operator in turn.
  val r = i * x + big - 0.5
  println(r)
  println(r.scale)
