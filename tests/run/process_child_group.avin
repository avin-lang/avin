// `inNewGroup()`: every program a command starts joins one group its first program leads, and the
// programs those start stay in it, so `signalGroup` reaches grandchildren, even after the command
// itself has ended. A pipeline's stages share the group; a sequence's later part leads a new one
// where every member of the group has ended; the outermost command's setting decides for its parts.
import avin.fs
import avin.io
import avin.io.IoError
import avin.process.{Child, Command}
import avin.signal
import avin.threads
import avin.time.millis

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

// Waits until `file` holds a line, and answers it.
written(file: string) -> string
  loop
    fs.readText(file) match
      Ok(text) if text.endsWith("\n") -> return text.trim
      _ -> threads.sleep(millis(5))

// Signals the group with zero until nobody is left in it, and answers the refusal's kind.
emptied(c: Child) -> Result[unit, io.ErrorKind]
  loop
    val r = c.signalGroup(0)
    if r.isErr then return r.mapErr(kind)
    threads.sleep(millis(5))

// The process group the program `pid` is in, as `ps` says.
groupOf(pid: string) -> string = ok(Command("/bin/ps", "-o", "pgid=", "-p", pid).output().mapErr(e -> IoError(io.Other("ps")))).trim

// An error's kind, without the process group its message names.
kind(e: IoError) -> io.ErrorKind = e.kind

main()
  val dir = ok(fs.createTempDir("avin-child-group"))
  // The leader's group is its own id.
  val leader = ok(Command("/bin/sleep", "30").inNewGroup.start())
  println(leader.group() == Some(leader.pid()))
  println(groupOf(leader.pid().toString()) == leader.pid().toString())
  println(leader.signalGroup(signal.Terminate).mapErr(kind))
  println(leader.waitFor())
  println(emptied(leader))

  // Grandchildren in the group: a shell that started two and waits for them. Killing the shell alone
  // leaves them; signalling the group reaches them.
  val tree = ok(Command("/bin/sh", "-c", "/bin/sleep 300 & echo $! > \"$0\"; /bin/sleep 301 & wait", dir + "/grandchild").inNewGroup.start())
  val grandchild = written(dir + "/grandchild")
  println(groupOf(grandchild) == tree.pid().toString())
  println(tree.signal(signal.Kill))
  println(tree.waitFor())
  println(tree.signalGroup(0).mapErr(kind))
  println(tree.signalGroup(signal.Terminate).mapErr(kind))
  println(emptied(tree))

  // A leader that exits at once, leaving a grandchild running: the group outlives it.
  val left = ok(Command("/bin/sh", "-c", "/bin/sleep 300 & echo started").inNewGroup.toFile(dir + "/left").start())
  println(left.waitFor())
  println(left.signalGroup(0).mapErr(kind))
  println(left.signalGroup(signal.Kill).mapErr(kind))
  println(emptied(left))

  // A pipeline's stages share the group its first stage leads.
  val piped = ok((Command("/bin/sh", "-c", "echo $$ > \"$0\"; exec /bin/sleep 30", dir + "/a") | Command("/bin/sh", "-c", "echo $$ > \"$0\"; exec /bin/sleep 30", dir + "/b")).inNewGroup.start())
  val a = written(dir + "/a")
  val b = written(dir + "/b")
  println(piped.group() == Some(a.toLong()))
  println(groupOf(a) == a)
  println(groupOf(b) == a)
  println(piped.signalGroup(signal.Terminate).mapErr(kind))
  println(piped.waitFor())

  // A sequence: its second part joins the group while the first is in it...
  val joins = ok((Command("/bin/sh", "-c", "/bin/sleep 300 & exit 0") andThen Command("/bin/sh", "-c", "echo $(/bin/ps -o pgid= -p $$) > \"$0\"", dir + "/joined")).inNewGroup.start())
  val firstGroup = joins.group()
  println(joins.waitFor())
  println(Some(written(dir + "/joined").toLong()) == firstGroup)
  println(joins.group() == firstGroup)
  println(joins.signalGroup(signal.Kill).mapErr(kind))
  println(emptied(joins))
  // ...and leads a new one, which the group becomes, where every member had ended.
  val leads = ok((Command("/usr/bin/true") andThen Command("/bin/sh", "-c", "echo $$ > \"$0\"; exec /bin/sleep 30", dir + "/leads")).inNewGroup.start())
  val before = leads.group()
  val first = leads.pid()
  // The sequence starts its second part when asked whether it is alive.
  while leads.pid() == first do
    leads.isAlive()
    threads.sleep(millis(5))
  val second = written(dir + "/leads")
  println(leads.group() == Some(second.toLong()))
  println(leads.group() != before)
  println(groupOf(second) == second)
  println(leads.signalGroup(signal.Terminate).mapErr(kind))
  println(leads.waitFor())

  // A part asking for a group inside a command started in one joins the outer one.
  val nested = ok((Command("/bin/sh", "-c", "echo $$ > \"$0\"; exec /bin/sleep 30", dir + "/outer") | Command("/bin/sh", "-c", "echo $$ > \"$0\"; exec /bin/sleep 30", dir + "/inner").inNewGroup).inNewGroup.start())
  val outer = written(dir + "/outer")
  println(groupOf(written(dir + "/inner")) == outer)
  println(nested.signalGroup(signal.Kill).mapErr(kind))
  println(nested.waitFor())
  // A part asking for a group in a command that did not: the part leads one, which the command's is.
  val partly = ok((Command("/bin/sh", "-c", "exit 0") | Command("/bin/sleep", "30").inNewGroup).start())
  println(partly.group() == Some(partly.pid()))
  println(partly.signalGroup(signal.Terminate).mapErr(kind))
  println(partly.waitFor())
  _ = fs.removeDirAll(dir)
