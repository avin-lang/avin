// expect: exit 4
// `exit` runs the hooks on the thread that calls it, from inside a nested call, after what was
// printed before it, and the program then ends with its status. Nothing after the `exit` runs, and
// the hooks run once although `main` never returns.
import avin.process

leave(code: int) -> Nothing
  println("leaving")
  process.exit(code)

pick(n: int) -> int = if n > 0 then n else leave(4)

main() -> int
  process.onExit(() -> println("hook one"))
  process.onExit(() -> println("hook two"))
  println(pick(1))
  println(pick(0))
  println("not reached")
  0
