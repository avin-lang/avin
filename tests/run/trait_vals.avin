// A trait's abstract `val` is supplied by a public field of each conforming type: a class parameter
// marked `val` or `var`, a field of the class body, an inherited field, or the field of a data type
// with one variant. Read through the trait, it is found in the value's method table; read through
// the class, it is the field itself.
trait Named
    val name: string
    greet() -> string = s"hello, $name"
    later() -> () -> string = () -> "later " + self.name

trait Tagged: Named
    tag() -> string = s"<$name>"

class Person(val name: string, age: int): Tagged

class Pet(kind: string): Named
    val name = s"a $kind"

// A `var` field supplies a `val`: the class may assign it, and the trait reads the current value.
class Counter(var name: string): Named

open class Base(val name: string)

// The field is inherited from the superclass.
class Derived(n: string): Base(n), Tagged

// An abstract class conforms and leaves the field to its subclass, and reads it through the trait.
abstract class Partial: Named
    shout() -> string = name + "!"

class Full(val name: string): Partial()

data Book(name: string, pages: int)

impl Named for Book

data Pair[A](name: string, value: A)

impl[A] Named for Pair[A]

object Anonymous: Named
    val name = "anonymous"

// A conformance stated by an impl after the class is supplied the same way.
class Late(x: int)
    val name = s"late $x"

impl Named for Late

// A generic trait's `val`, and one whose type is a class, supplied by a subclass-typed field.
trait Holder[T]
    val item: T

class IntBox(val item: int): Holder[int]

class Box[T](val item: T): Holder[T]

open class Shape
    area() -> int = 0

class Circle(r: int): Shape()
    override area() -> int = 3 * r * r

trait HasShape
    val shape: Shape

class Wheel(val shape: Circle): HasShape

// A `val` holding a function is called through the trait.
trait Op
    val apply: int -> int

class Doubler: Op
    val apply = (x: int) -> x * 2

data List[+T]
    Cons(head: T, tail: List[T])
    Empty

printAll(items: List[Named]) -> unit = items match
    Cons(h, t) ->
        print(h.name + " / " + h.greet())
        printAll(t)
    Empty -> ()

main()
    val p = Person("ada", 36)
    print(p.name)
    val n: Named = p
    print(n.name)
    print(p.tag())
    val c = Counter("one")
    val viewed: Named = c
    c.name = "two"
    print(viewed.name)
    val f: Partial = Full("full")
    print(f.shout() + " " + f.name)
    printAll(Cons(p, Cons(Pet("cat"), Cons(c, Cons(Derived("derived"), Cons(Book("Dune", 412), Cons(Pair("pair", 5), Cons(Anonymous, Cons(f, Cons(Late(3), Empty))))))))))
    val t: Tagged = Derived("tagged")
    print(t.tag())
    print(t.later()())
    val h: Holder[int] = IntBox(4)
    print(s"${h.item + 1}")
    val g: Holder[string] = Box("boxed")
    print(g.item)
    val w: HasShape = Wheel(Circle(2))
    print(s"${w.shape.area()}")
    val o: Op = Doubler()
    print(s"${o.apply(21)}")
    val read = n.name
    print(read)
