// expect: trap
// A width written as a hole is evaluated in its place, after the value before it, and an overflow
// in it traps there, as anywhere.
shown(n: int) -> int =
    print(s"value $n")
    n

main()
    val big = 2147483600
    print(f"[${shown(1)}%${big - 2147483590}d]")
    print(f"[${shown(2)}%${big + 100}d]")
