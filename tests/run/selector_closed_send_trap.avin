// expect: trap
// A selector's send entry on a closed channel traps when it is tried, as a select's send arm does.
import avin.threads.{Channel, Selector}

main()
  val a = Channel[int](1)
  val sel = Selector[string]()
  sel.send(a, 1, "a")
  println(sel.wait())
  a.close()
  sel.send(a, 2, "a")
  println(sel.wait())
