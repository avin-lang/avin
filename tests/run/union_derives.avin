// expect: exit 0
// A data type or a class with a union field derives `Eq`, `Hash`, `Display` and `Debug` as with any
// field: the field compares, hashes and shows as its member does. A derive template sees a union
// field as a field of that type, and takes it where the union meets the hook's bound, here because
// every member implements a trait taking `Self` only as the receiver. Generic types, several
// variants, nested unions and a union of data types holding unions are derived too.

trait Describe
    describe() -> string

impl Describe for int
    describe() -> string = s"int $self"

impl Describe for string
    describe() -> string = s"string \"$self\""

derive Describe for T
    describe() -> string = T.walk(self, Describer("")).text

data Describer(text: string)

impl ShapeVisitor for Describer
    variant(v: VariantShape) -> Describer = Describer(v.name)

impl Describer
    field[F: Describe](f: FieldShape, value: F) -> Describer = Describer(s"$text ${f.name}=${value.describe()}")

data Cell(v: int | string) derives Eq, Hash, Display, Debug, Describe

class Slot(val v: int | string, val tag: string) derives Eq, Hash, Display, Debug

data Shape derives Eq, Hash, Display, Debug
    Dot(at: int | long)
    Label(text: string | char, size: int)

data Holder[T](item: T | string) derives Eq, Hash, Display, Debug

data Leaf(n: int) derives Eq, Hash, Display, Debug

data Tree(kids: Vector[Leaf | Tree | string]) derives Eq, Hash, Display, Debug

main()
    // Eq and Hash: the same member and value, a different value, a different member.
    println(s"${Cell(1) == Cell(1)} ${Cell(1) == Cell(2)} ${Cell(1) == Cell("1")} ${Cell("") == Cell("")}")
    println(s"${Cell(1).hash() == Cell(1).hash()} ${Cell("x").hash() == Cell("x").hash()}")
    println(s"${Slot(1, "a") == Slot(1, "a")} ${Slot(1, "a") == Slot("1", "a")} ${Slot(1, "a") == Slot(1, "b")}")
    println(Slot("q", "t").hash() == Slot("q", "t").hash())
    val one: long = 1
    println(s"${Dot(1) == Dot(1)} ${Dot(1) == Dot(one)} ${Label("a", 1) == Label('a', 1)} ${Label('a', 1) == Label('a', 1)}")
    println(s"${Holder[int](3) == Holder[int](3)} ${Holder[int](3) == Holder[int]("3")}")
    // Display and Debug: strings quoted only by Debug.
    println(Cell(1))
    println(Cell("x"))
    println(debug(Cell("x")))
    println(Slot("q", "t"))
    println(debug(Slot("q", "t")))
    println(s"${Dot(one)} ${Label('c', 2)} ${debug(Label("s", 2))}")
    println(s"${Holder[real](2.5)} ${debug(Holder[real]("h"))}")
    // A union of data types nested in a vector field.
    val tree = Tree([Leaf(1), Tree([Leaf(2), "two"]), "end"])
    println(tree)
    println(debug(tree))
    println(s"${tree == Tree([Leaf(1), Tree([Leaf(2), "two"]), "end"])} ${tree == Tree([Leaf(1)])}")
    println(tree.hash() == Tree([Leaf(1), Tree([Leaf(2), "two"]), "end"]).hash())
    // A set and a map keyed by derived types with union fields.
    val cells: Set[Cell] = Set(Cell(1), Cell("1"), Cell(1))
    println(cells.size())
    val named: Map[Shape, string] = {Dot(1): "int dot", Dot(one): "long dot"}
    println(s"${named.get(Dot(1))} ${named.get(Dot(one))}")
    // The derive template through the union field.
    println(Cell(7).describe())
    println(Cell("seven").describe())
