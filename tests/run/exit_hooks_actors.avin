// Hooks registered by an actor, inside its turn, and by a future's body run with the main thread's
// own when the program ends. A trap an actor's failure contains does not end the program, so it
// runs no hook: they run once, when `main` returns.
import avin.actors.{ActorRef, Stop, spawn}
import avin.process
import avin.threads.{Channel, Future}

actor Registrar(done: Channel[int]) receives int
    receive
        0 ->
            process.onExit(() -> println("registered by the actor"))
            done.send(0)
        n -> println(Vector(1, 2, 3)(n))

main()
    process.onExit(() -> println("registered by main"))
    val done = Channel[int]()
    val a = spawn(Registrar(done), onFailure = Stop)
    a.tell(0)
    done.receive()
    Future(process.onExit(() -> println("registered by a future"))).await()
    a.tell(7)
    println(a.ended().await())
    println("main ends")
