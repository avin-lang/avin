// args: one "two words" ""
// expect: exit 3

// `main` may take the program's arguments: the ones after its name, as `process.args()` answers them.
// Its integer result is the exit status.
main(args: Vector[string]) -> int
    print(args.length())
    for x in args do print(s"[$x]")
    print(args)
    args.length()
