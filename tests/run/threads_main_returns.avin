// expect: exit 3
// The program ends when `main` returns, though threads it started are still running: one loops
// forever, one allocates forever, and one waits forever to join the first. What `main` wrote is
// flushed on the way out, and its result is the exit status.
import avin.threads.spawn

spin() -> int
    var n = 0
    while true
        n = (n + 1) % 1000
    n

churn() -> int
    var words: List[string] = []
    while true
        words = s"word ${words.length()}" :: (if words.length() > 50 then [] else words)
    words.length()

main() -> int
    val forever = spawn(() -> spin())
    val allocating = spawn(() -> churn())
    val waiting = spawn(() -> forever.join())
    print("main is done")
    3
