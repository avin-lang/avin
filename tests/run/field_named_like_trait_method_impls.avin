// expect: exit 0
// A trait's method with a parameter list and a field of the same name live side by side in an impl
// the program writes too. Inside the type's methods a bare `name` reads the field and `name(args)`
// calls the method, as `self.name` and `self.name(args)` do, in a lambda as well; through the trait
// or a type parameter it bounds, only the method is seen. A field holding a function shares the
// rule: a call is the method's, and the field is called by reading it first. A generic class's
// derived methods, and a lambda over its values, see the same.

trait Scaled
  scale(by: int) -> int

data Gauge(scale: int, label: string)

impl Scaled for Gauge
  scale(by: int) -> int = scale * by

impl Gauge
  twice() -> int = scale(2)
  both() -> string = s"$label: $scale -> ${scale(3)}"
  all(xs: Vector[int]) -> Vector[int] = xs.map(x -> scale(x) + scale)

data Card(display: string)

impl Display for Card
  display(out: Writer, spec: FormatSpec) = out.writeField(s"[$display]", spec)

impl Debug for Card
  debug(out: Writer, spec: FormatSpec)
    out.write("Card ")
    display(out, spec)

class Bag(val iterator: int): Iterable[int]
  override iterator() -> Iterator[int] = Vector.tabulate(iterator, i -> i * 10).iterator()

class Meter(val scale: (int) -> int): Scaled
  override scale(by: int) -> int = by + 1
  probe() -> int =
    val held = scale
    scale(3) + held(3) + run(n -> scale(n))
  run(f: (int) -> int) -> int = f(10)

class Holder[A](val display: A, val equals: int = 0) derives Display, Eq, Hash

shownAll[T: Display](xs: Vector[T]) -> string = xs.map(x -> x.toString()).mkString("+")

scaledBy[T: Scaled](x: T, n: int) -> int = x.scale(n)

viaTrait(s: Scaled) -> int = s.scale(5)

main()
  val g = Gauge(4, "g")
  println(g.scale)
  println(g.scale(10))
  println(g.twice())
  println(g.both())
  println(g.all([1, 2, 3]))
  println(scaledBy(g, 7))
  println(viaTrait(g))

  val c = Card("ace")
  println(c)
  println(debug(c))
  println(f"${c}%8s|")
  println(c.display)
  println(c.toString())

  var total = 0
  for x in Bag(4)
    total += x
  println(total)
  println(Bag(3).iterator)
  println(Bag(3).toVector)

  val m = Meter(n -> n * 100)
  println(m.scale(2))
  val f = m.scale
  println(f(2))
  println(m.probe())
  println(viaTrait(m))

  val boxes = [Holder("x"), Holder("y")]
  println(boxes)
  println(boxes.map(b -> b.display + "!"))
  println(shownAll(boxes))
