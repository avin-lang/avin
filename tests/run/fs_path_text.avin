// expect: exit 0
// The path functions of `avin.fs` that answer from the text alone: components, join, parent, file
// name, extension, stem, normalize and relativeTo, at the root, with trailing and doubled
// separators, dotfiles, `..`, the empty path, names beyond ASCII and names with several dots.
import avin.fs

main()
  println("-- isAbsolute")
  for p in ["/", "/a", "a", "", "./a", "//a"] do println(s"[$p] ${fs.isAbsolute(p)} ${fs.isRelative(p)}")
  println("-- components")
  for p in ["/", "", "/a//b/", "a/./../b", "ünï/cødé/文件", "///"] do println(s"[$p] ${fs.components(p)}")
  println("-- join")
  println(fs.join("a", "b"))
  println(fs.join("a/", "b"))
  println(fs.join("a///", "b"))
  println(fs.join("/home/me", "/etc"))
  println(fs.join("/", "etc"))
  println(fs.join("//", "etc"))
  println(fs.join("", "b"))
  println(fs.join("a", ""))
  println(s"[${fs.join("", "")}]")
  println(fs.join("ünï", "文件.txt"))
  println(fs.join(["/home", ".config", "thing"]))
  println(fs.join(["a", "/b", "c"]))
  println(s"[${fs.join(Vector.empty[string]())}]")
  println("-- parent")
  for p in ["/a/b", "/a", "/", "a", "a/b", "a/b/", "/a/b//", "", "../a", "ünï/文件"] do println(s"[$p] ${fs.parent(p)}")
  println("-- fileName")
  for p in [
    "/a/b.txt",
    "/",
    "",
    ".",
    "..",
    "a/..",
    "a/b/",
    ".bashrc",
    "ünï/文件.txt"
  ] do println(s"[$p] ${fs.fileName(p)}")
  println("-- extension and stem")
  for p in ["a.txt", "a.tar.gz", ".bashrc", ".config.json", "a.", "noext", "/", "dir.d/file", "..", "文件.ünï", "a..b"]
    println(s"[$p] ${fs.extension(p)} ${fs.stem(p)}")
  println("-- normalize")
  for p in [
    "/a/./b/../c",
    "a/../..",
    "/..",
    "/../a",
    "",
    ".",
    "a/..",
    "a//b/",
    "../../a/./b",
    "/a/b/../../..",
    "ünï/./文件/.."
  ]
    println(s"[$p] ${fs.normalize(p)}")
  println("-- relativeTo")
  println(fs.relativeTo("/a/c", "/a/b"))
  println(fs.relativeTo("/a/./b", "/a"))
  println(fs.relativeTo("/a/b", "/a/b"))
  println(fs.relativeTo("/a", "a"))
  println(fs.relativeTo("a/b", "../x"))
  println(fs.relativeTo("a/b", "a/b/c/d"))
  println(fs.relativeTo("x/文件", "x/ünï"))
