// Hooks that allocate heavily, under a collector that runs at every allocation, see what they
// captured intact: strings, a vector, a map and a closure made before the hooks were registered,
// and two hundred hooks, each building a string, run newest first.
import avin.process

main()
    val words = Vector("alpha", "beta", "gamma", "δέλτα")
    val lengths = words.map(w -> (w, w.charCount())).toMap()
    val shout: @sendable (string) -> string = w -> w.toUpperCase() + "!"
    for i in 0..<200
        process.onExit(() -> if i % 50 == 0 then println(s"hook $i: ${(0..<i).map(n -> n.toString()).mkString("").charCount()}"))
    process.onExit(() ->
        val parts = Buffer[string]()
        for w in words do parts.addOne(s"${w}=${lengths(w)}")
        println(parts.mkString(" "))
        println(words.map(w -> shout(w)).mkString(" ")))
    println("main ends")
