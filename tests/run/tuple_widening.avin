// expect: exit 0
// A tuple already made converts to a wider tuple where each part already is what the wider one holds:
// a string, a data value, a tuple or an instance of a class is its own `Any`, and an instance of a
// subclass is one of its superclass. A part written out where the wider tuple is expected is boxed
// there, so a number converts that way. Each part keeps its own type at run time.

data P(x: int)

open class Animal(val name: string)

class Dog(name: string): Animal(name)

wide(p: (Any, int)) -> string = p.0 match
    s: string -> s"string $s ${p.1}"
    q: P -> s"data $q ${p.1}"
    t: (int, int) -> s"tuple $t ${p.1}"
    d: Dog -> s"dog ${d.name} ${p.1}"
    n: int -> s"int $n ${p.1}"
    _ -> "other"

animals(p: (Animal, Animal)) -> string = s"${p.0.name} ${p.1.name}"

main()
    val t: (string, int) = ("a", 1)
    println(wide(t))
    val d: (P, int) = (P(4), 2)
    println(wide(d))
    val n: ((int, int), int) = ((1, 2), 3)
    println(wide(n))
    val g: (Dog, int) = (Dog("rex"), 4)
    println(wide(g))
    val e: (string, int) = ("", 0)
    println(wide(e))
    val u: (string, int) = ("é✓", -1)
    println(wide(u))
    val w: Vector[(Any, int)] = [t, d, n, g]
    println(w.map(wide))
    val dogs: (Dog, Dog) = (Dog("a"), Dog("b"))
    println(animals(dogs))
    val x = 7
    println(wide((x, 5)))
    val o: Option[(Any, int)] = Some(t)
    println(o.map(wide))
    var kept: (Any, int) = t
    kept = d
    println(wide(kept))
    val nested: ((string, int), int) = (("in", 1), 2)
    val wider: ((Any, int), int) = nested
    println(wider.0 match
        (s: string, k) -> s"$s $k"
        _ -> "other")
