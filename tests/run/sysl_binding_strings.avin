// Strings of every size cross a Sysl binding in both directions: empty, long and multi-byte.

@sysl("sysl.text.to_upper")
upper(s: string) -> string

@sysl("sysl.text.eq_fold")
sameFolded(a: string, b: string) -> bool

// `n` copies of `s`, by doubling so the recursion stays shallow.
repeat(s: string, n: int) -> string
    if n == 0 then return ""
    val half = repeat(s, n / 2)
    if n % 2 == 0 then half + half else half + half + s

main()
    print(s"[${upper("")}]")
    print(s"${upper("") == ""}")
    // 100 KB each way: 12800 copies of eight bytes.
    val big = repeat("abcdefgh", 12800)
    val bigUpper = upper(big)
    print(s"${bigUpper == repeat("ABCDEFGH", 12800)}")
    print(s"${sameFolded(big, repeat("ABCDEFGH", 12800))}")
    print(s"${bigUpper != big}")
    // Multi-byte UTF-8 keeps every byte: two-, three- and four-byte sequences.
    print(upper("ñandú λ 日本 😀 straße"))
    print(s"${upper(repeat("λ😀", 3)) == "Λ😀Λ😀Λ😀"}")
