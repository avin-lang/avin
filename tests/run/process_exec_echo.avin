// expect: exit 0
// `exec` replaces the program with `/bin/echo`: what the program printed before it reaches standard
// output, written out first though the output is a file, and then echo's. Nothing of the program is
// left: the code after the call never runs, its exit hook does not run, the thread it started and
// the signal watch it holds end with it, and the status the parent sees is echo's.
import avin.process
import avin.signal
import avin.threads
import avin.time

main()
  print("written, ")
  println("not yet flushed")
  process.onExit(() -> println("an exit hook ran"))
  val watched = signal.watch(signal.Terminate)
  val ticker = threads.spawn(() ->
    while true
      threads.sleep(time.millis(1))
    0)
  threads.sleep(time.millis(5))
  val failed = process.exec("/bin/echo", ["from echo", "", "héllo ✓"])
  println(s"exec came back: $failed ${watched.isOk()}")
  println(ticker.join())
