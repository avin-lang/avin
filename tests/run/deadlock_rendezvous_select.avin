// expect: trap
// Two threads selecting to send on channels of capacity zero that nobody receives from, and a select
// with a send and a receive arm on one such channel, which never pairs with itself: each waits
// without a time limit, so the deadlock check counts them, and the program stops once `main` waits
// to join.
import avin.threads.{Channel, spawn}

main()
  val a = Channel[int](0)
  val b = Channel[int](0)
  val c = Channel[int](0)
  val one = spawn(() -> select
    a.send(1) -> "a"
    b.send(2) -> "b")
  val two = spawn(() -> select
    c.send(3) -> "sent"
    c.receive() as Some(x) -> s"got $x")
  println("joining")
  println(one.join(), two.join())
