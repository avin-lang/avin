// expect: trap
// `stop(other)` of an actor that is not one of this actor's children, and has not ended, is an
// error: an actor that should end on request is sent a message saying so. Here a top-level actor
// stops another top-level one, which it was handed in a message.
import avin.actors.{ActorRef, spawn}

data Msg
  Stop(target: ActorRef[Nothing])
  Idle

actor Target receives Msg
  receive
    _ -> ()

actor Bully receives Msg
  receive
    Stop(target) -> stop(target)
    Idle -> ()

main()
  val t = spawn(Target())
  val b = spawn(Bully())
  b.tell(Stop(t))
  b.ended().await()
