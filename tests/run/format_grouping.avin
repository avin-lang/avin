// expect: exit 0
// The `,` flag writes a decimal integer's digits in groups of three from the right, separated by
// commas, under `%d` and `%i`, for every width of integer and for `byte`: zero and values under a
// thousand have no comma, a negative value keeps its sign before the first group, and the least and
// greatest values of each width are grouped whole. It combines with every other flag `%d` takes:
// `-` and a width pad the grouped text with spaces, `+` and a space write the sign, a precision's
// zeros are grouped with the digits, and the `0` flag's zeros fill exactly the width, ungrouped,
// before the grouped digits, the commas and the sign counting in it. A width or precision given as a hole
// keeps the flag, and so does the runtime `f` of a `StringContext`, and a `FormatSpec` made in code.
grouped[T: Integer](x: T) -> string = f"${x}%,d"

main()
    println(f"[${0}%,d] [${7}%,d] [${999}%,d] [${1000}%,d] [${-1000}%,d] [${12345}%,d] [${123456}%,d] [${1234567}%,i]")
    println(f"[${-999}%,d] [${-1}%,d] [${100000}%,d] [${1000000}%,d]")
    println(f"[${2147483647}%,d] [${-2147483648}%,d]")
    val longest: long = 9223372036854775807
    val least: long = -9223372036854775807 - 1
    println(f"[${longest}%,d] [${least}%,d]")
    val small: i8 = -128
    val short: i16 = -32768
    println(f"[${small}%,d] [${short}%,d] [${i16(32767)}%,d]")
    val wide: i128 = 170141183460469231731687303715884105727
    val low: i128 = -170141183460469231731687303715884105728
    println(f"[${wide}%,d]")
    println(f"[${low}%,d]")
    println(f"[${byte(255)}%,d] [${byte(0)}%,d]")
    println(grouped(1234567) + " " + grouped(long(-1234567)) + " " + grouped(i8(100)))
    // Width, left justification, signs.
    println(f"[${1234567}%,12d] [${1234567}%-,12d] [${1234567}%,-12d] [${1234567}%,3d]")
    println(f"[${1234}%+,d] [${-1234}%+,d] [${1234}% ,d] [${-1234}% ,d]")
    // Precision zeros are grouped with the digits.
    println(f"[${5}%,.6d] [${-5}%,.6d] [${1234}%,.2d] [${0}%,.0d] [${1234567}%,.9d]")
    // Zero padding fills exactly the width, its zeros ungrouped before the grouped digits; the commas
    // and the sign count in the width, and a number wider than the width is written whole.
    println(f"[${1234}%0,10d] [${-1234}%0,10d] [${1234}%0,9d] [${1234}%0,8d] [${-1234}%0,8d] [${1234}%0,6d] [${1234}%0,5d] [${1234}%0,4d]")
    println(f"[${1}%0,1d] [${0}%0,3d] [${0}%0,4d] [${1234}%-0,10d|] [${-1234}%+0,7d] [${1234}%+0,8d] [${1234567}%0,12d]")
    // Width and precision together: precision zeros group, and `0` gives way to the precision.
    println(f"[${1234}%,10.6d] [${1234}%0,10.6d] [${-1234}%,10.6d] [${1234}%-,10.6d|] [${1234}%,3.6d]")
    // The extremes of `i128`, zero padded wider than they are, as wide, and narrower.
    println(f"[${wide}%0,57d]")
    println(f"[${low}%0,57d]")
    println(f"[${wide}%0,55d] [${low}%0,10d]")
    // Width and precision as holes.
    val w = 12
    val p = 7
    println(f"[${1234567}%,${w}d] [${1234567}%,-${w}d] [${42}%,.${p}d]")
    // The runtime interpolator reads the flag too.
    println(StringContext(["[", "%,d] [", "%,10d] [", "%0,10d]"]).f(1234567, -98765, 1234))
    // A `FormatSpec` made in code.
    val out = StringWriter()
    9876543.display(out, FormatSpec(grouping = true))
    out.write(" ")
    long(-9876543210).display(out, FormatSpec(width = 16, grouping = true))
    println(out.text)
    // Other conversions are untouched by a spec that asks for grouping.
    val hex = StringWriter()
    255.display(hex, FormatSpec(conversion = 'x', grouping = true))
    println(hex.text)
