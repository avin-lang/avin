// expect: exit 0
// A type's static member is called on its name even where the type has a companion object: the
// companion's own members and its `apply` keep working beside it, a member the companion declares
// itself is the companion's, and the same holds for a data type, a generic class and a library type.

import avin.time.Period

class Cup(val v: int)

impl Add for Cup
  add(other: Cup) -> Cup = Cup(v + other.v)
  static zero() -> Cup = Cup(0)

impl Mul for Cup
  multiply(other: Cup) -> Cup = Cup(v * other.v)
  static one() -> Cup = Cup(1)

object Cup
  apply(text: string) -> Cup = Cup(text.byteLength)
  full() -> Cup = Cup(100)
  // The companion's own `one` is what `Cup.one()` calls.
  one() -> Cup = Cup(-1)

data Pt(x: int)

impl Add for Pt
  add(o: Pt) -> Pt = Pt(x + o.x)
  static zero() -> Pt = Pt(0)

object Pt
  origin() -> Pt = Pt(7)

class Box[T](val item: T)

impl[T: Add] Add for Box[T]
  add(o: Box[T]) -> Box[T] = Box(item + o.item)
  static zero() -> Box[T] = Box(T.zero())

object Box
  of[T](item: T) -> Box[T] = Box(item)

total[T: Add](xs: Vector[T]) -> T
  var t = T.zero()
  for x in xs do t = t + x
  t

main()
  println(Cup.zero().v)
  println(Cup("four").v)
  println(Cup.full().v)
  println(Cup.one().v)
  println((Cup(3) + Cup.zero()).v)
  val z: () -> Cup = Cup.zero
  println(z().v)
  println(total([Cup(1), Cup(2)]).v)
  println(Pt.zero())
  println(Pt.origin())
  println(Box[int].zero().item)
  println(Box[string].zero().item == "")
  println(Box.of(5).item)
  println(total([Box(1.5), Box(2.0)]).item)
  println(Period.zero())
  println(BigInt.zero())
  println(BigInt.one())
