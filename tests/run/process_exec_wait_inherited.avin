// expect: exit 0
// Children started before an `exec` are still the process's children after it, and the new image
// waits for them by pid: the program starts a child that runs until a file appears and one that ends
// at once, then becomes itself again with an argument choosing the "after" path and the children's
// pids as arguments. After the `exec`, `tryWaitPid` finds the first still running, the file is
// made, `waitPid` answers its status and a second wait finds it gone; the second, a `Child` never
// detached and long ended, is reaped by `tryWaitPid` with its status, and is gone after that too.
import avin.fs
import avin.process
import avin.process.Command
import avin.threads
import avin.time

before()
  val dir = fs.createTempDir("avin-exec-wait").ok().get()
  val go = s"$dir/go"
  val waiting = Command("/bin/sh", "-c", s"while [ ! -e '$go' ]; do sleep 0.01; done; exit 7").start().ok().get()
  val quick = Command("/bin/sh", "-c", "exit 3").start().ok().get()
  val first = waiting.detach()
  val second = quick.pid()
  threads.sleep(time.millis(100))
  println("before exec")
  val r = process.exec(process.executable().get(), ["after", s"$first", s"$second", dir])
  println(s"exec came back: ${r.isErr()}")

after(first: long, second: long, dir: string)
  println("after exec")
  println(process.tryWaitPid(first))
  fs.writeText(s"$dir/go", "")
  println(process.waitPid(first))
  println(process.waitPid(first))
  println(process.tryWaitPid(first))
  var reaped = process.tryWaitPid(second)
  while reaped == Ok(None)
    threads.sleep(time.millis(10))
    reaped = process.tryWaitPid(second)
  println(reaped)
  println(process.waitPid(second))
  fs.removeDirAll(dir)

main(args: Vector[string])
  if args.length == 4 && args(0) == "after"
    after(args(1).toLong(), args(2).toLong(), args(3))
  else
    before()
