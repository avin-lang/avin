// expect: exit 0
// A thread is never stopped while it holds a lock, so a mutex a cancelled thread used is never left
// held. A thread computing inside a mutex's `with` when its scope is cancelled finishes the body and
// lets the mutex go, and stops at its next cancellation point after it: the body's effect is there,
// and nothing after that point runs. Waiting for a lock is not a cancellation point: a thread waiting for a mutex another
// thread holds goes on waiting, takes it, runs its body, and stops only after letting it go (here at
// the sleep after it, its next cancellation point). A thread
// waiting on a condition inside its mutex's `with` holds the mutex no longer, so it is stopped there
// and does not take the mutex again. Afterwards the mutex is free.
import avin.threads.{Atomic, Mutex, scope, sleep, spawn}
import avin.time.{hours, millis}

main() -> int
  val box = Mutex(0)
  val inside = Atomic(0)
  val release = Atomic(false)
  val after = Atomic(0)
  // Computing inside the mutex.
  val busy = scope(s ->
    val t = s.spawn(() ->
      box.with(_ ->
        inside.store(1)
        var n = 0
        while !release.load() do n = n +% 1
        inside.store(2)
        0)
      sleep(hours(1))
      after.add(1)
      1)
    while inside.load() == 0 do sleep(millis(1))
    s.cancel()
    sleep(millis(20))
    // Still inside its body, holding the mutex, though cancelled.
    println(inside.load())
    release.store(true)
    t)
  println(busy.result())
  println(inside.load())
  println(after.load())
  println(box.update(v -> v + 1))
  // Waiting for a mutex another thread holds.
  val holding = Atomic(0)
  val letGo = Atomic(false)
  val holder = spawn(() ->
    box.with(_ ->
      holding.store(1)
      while !letGo.load() do sleep(millis(1))
      0))
  while holding.load() == 0 do sleep(millis(1))
  val ran = Atomic(0)
  val waiter = scope(s ->
    val t = s.spawn(() ->
      box.with(v ->
        ran.store(1)
        v)
      sleep(hours(1))
      after.add(1)
      2)
    sleep(millis(20))
    s.cancel()
    sleep(millis(20))
    println(ran.load())
    letGo.store(true)
    t)
  holder.join()
  println(waiter.result())
  println(ran.load())
  println(after.load())
  // Waiting on a condition, which lets the mutex go.
  val changed = box.condition()
  val waiting = Atomic(0)
  val onCondition = scope(s ->
    val t = s.spawn(() ->
      box.with(v ->
        waiting.store(1)
        changed.wait()
        waiting.store(2)
        v)
      after.add(1)
      3)
    while waiting.load() == 0 do sleep(millis(1))
    sleep(millis(10))
    s.cancel()
    t)
  println(onCondition.result())
  println(waiting.load())
  println(after.load())
  println(box.update(v -> v + 1))
  0
