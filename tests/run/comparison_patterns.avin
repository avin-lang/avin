// expect: exit 0
// `n + k` and comparison patterns, in clauses and in match arms: what each matches, what it binds,
// and coverage that they complete without a catch-all.

// `n + 1` matches 1 and up, binding one less; with the clause for 0 and the negative one, every int
// is covered.
factorial(n: int) -> int
factorial(_ < 0) = 0
factorial(0) = 1
factorial(m + 1) = (m + 1) * factorial(m)

// The largest amount still leaves the difference in range.
above(n: int) -> int = n match
    k + 2147483647 -> k
    _ -> -1

bucket(n: int) -> int = n match
    n < 0 -> -1
    0 <= n < 10 -> 0
    10 <= n <= 99 -> 1
    n >= 100 -> 2

// Bounds may be negative, and a binder of `_` binds nothing.
temperature(t: int) -> int = t match
    _ < -10 -> 0
    -10 <= _ < 25 -> 1
    _ >= 25 -> 2

// Comparison patterns on bytes and chars, nested inside a variant.
data Reading(value: byte)

level(r: Reading) -> int = r match
    Reading(v < 0x80) -> 0
    Reading(v >= 0x80) -> 1

letter(c: char) -> int = c match
    c < 'a' -> 0
    'a' <= c <= 'z' -> 1
    c > 'z' -> 2

// Every char below and above the surrogates is covered without them.
plane(c: char) -> int = c match
    c <= '\u{D7FF}' -> 0
    c >= '\u{E000}' -> 1

// Range patterns count for coverage too.
digits(n: i64) -> int = n match
    n < 0 -> -1
    0..9 -> 1
    10..<100 -> 2
    _ >= 100 -> 3

// A wider integer type.
huge(n: i128) -> int = n match
    n < -170141183460469231731687303715884105727 -> 0
    _ > -170141183460469231731687303715884105728 -> 1

// Range patterns in clauses: with the comparisons at either end, every int is covered.
grade(score: int) -> int
grade(_ < 0) = -1
grade(0..<60) = 0
grade(60..100) = 1
grade(_ > 100) = -1

main() -> int
    if factorial(5) != 120 || factorial(0) != 1 || factorial(-3) != 0 then return 1
    if above(2147483647) != 0 || above(5) != -1 then return 2
    if bucket(-1) != -1 || bucket(0) != 0 || bucket(9) != 0 || bucket(10) != 1 || bucket(99) != 1 || bucket(100) != 2 then return 3
    if temperature(-11) != 0 || temperature(-10) != 1 || temperature(24) != 1 || temperature(25) != 2 then return 4
    if level(Reading(0x7f)) != 0 || level(Reading(0x80)) != 1 then return 5
    if letter('A') != 0 || letter('a') != 1 || letter('z') != 1 || letter('{') != 2 then return 6
    if plane('a') != 0 || plane('\u{E000}') != 1 then return 7
    if digits(-1) != -1 || digits(9) != 1 || digits(99) != 2 || digits(100) != 3 then return 8
    if huge(-170141183460469231731687303715884105728) != 0 || huge(0) != 1 then return 9
    if grade(-1) != -1 || grade(0) != 0 || grade(59) != 0 || grade(60) != 1 || grade(100) != 1 || grade(101) != -1 then return 11
    // Bindings in comparison and `n + k` patterns are scoped to their arm.
    val n = 40
    val doubled = 3 match
        m + 1 -> m * 2
        _ -> 0
    if doubled != 4 || n != 40 then return 10
    0
