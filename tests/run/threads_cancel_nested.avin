// expect: exit 0
// A cancelled thread that runs a scope of its own stops first at that scope: the inner scope cancels
// its threads and waits for them to end, and only then does the thread's cancellation go on. So a
// cancellation reaches every thread below the scope cancelled, whether the thread running the inner
// scope is waiting for its threads or still in the inner scope's body, and three levels deep as well
// as two. Cancelling an inner scope cancels only its own threads: the outer scope's other threads and
// the thread that ran the inner scope go on, and see the inner scope cancelled.
import avin.threads.{Atomic, Channel, Thread, scope, sleep}
import avin.time.{hours, millis}

// Runs a scope of `n` sleeping threads, handing them to `out`, and waits for them.
sleepers(n: int, out: Channel[Thread[int]], ready: Atomic[int], after: Atomic[int]) -> int
    scope(s ->
        for i in 0..<n
            out.send(s.spawn(() ->
                ready.add(1)
                sleep(hours(1))
                after.add(1)
                i))
        0)

main() -> int
    val ready = Atomic(0)
    val after = Atomic(0)
    val grand = Channel[Thread[int]](100)
    // The thread running the inner scope waits for its threads when it is cancelled.
    val waiting = scope(s ->
        val t = s.spawn(() ->
            val r = sleepers(3, grand, ready, after)
            after.add(1)
            r)
        while ready.load() < 3 do sleep(millis(1))
        s.cancel()
        t)
    println(waiting.result())
    for _ in 0..<3
        grand.tryReceive() match
            Some(g) -> println(g.result())
            None -> println("missing")
    println(after.load())
    // The thread running the inner scope is still in its body when it is cancelled.
    ready.store(0)
    val inBody = scope(s ->
        val t = s.spawn(() ->
            scope(inner ->
                for _ in 0..<2
                    grand.send(inner.spawn(() ->
                        ready.add(1)
                        sleep(hours(1))
                        after.add(1)
                        0))
                ready.add(1)
                sleep(hours(1))
                after.add(1)
                1))
        while ready.load() < 3 do sleep(millis(1))
        s.cancel()
        t)
    println(inBody.result())
    for _ in 0..<2
        grand.tryReceive() match
            Some(g) -> println(g.result())
            None -> println("missing")
    println(after.load())
    // Three levels.
    ready.store(0)
    val deep = scope(s ->
        val t = s.spawn(() ->
            scope(middle ->
                val m = middle.spawn(() -> sleepers(2, grand, ready, after))
                m.join()))
        while ready.load() < 2 do sleep(millis(1))
        s.cancel()
        t)
    println(deep.result())
    for _ in 0..<2
        grand.tryReceive() match
            Some(g) -> println(g.result())
            None -> println("missing")
    println(after.load())
    // Cancelling an inner scope leaves the outer one alone.
    ready.store(0)
    val partial = scope(s ->
        val sibling = s.spawn(() ->
            sleep(millis(30))
            10)
        val runner = s.spawn(() ->
            val r = scope(inner ->
                val i = inner.spawn(() ->
                    ready.add(1)
                    sleep(hours(1))
                    0)
                while ready.load() < 1 do sleep(millis(1))
                inner.cancel()
                val c = inner.isCancelled()
                (i, c))
            (r.0.result(), r.1, 20))
        (sibling.join(), runner.join(), s.isCancelled()))
    println(partial)
    println(after.load())
    0
