// expect: exit 0
// A machine of one state, with parameters and methods of its own: its parameters and fields are the
// data every state shares, its methods are ordinary methods, and an arm naming the one state is a
// transition into it. A state with no arms of its own takes them all from `receive`, and `else`
// is an arm there as in a `match`.
data Tick
    Add(n: int)
    Reset
    Noop

machine Counter(step: int) receives Tick
    var total = 0
    var entries = 0

    state Counting
        enter
            entries += 1

    receive
        Add(n) ->
            total += n * step
            stay
        Reset ->
            total = 0
            Counting
        else stay

    doubled() -> int = total * 2

main() -> int
    val c = Counter(3)
    println(c.entries)
    c.handle(Add(2))
    c.handle(Noop)
    c.handle(Add(-1))
    println(c.total)
    println(c.doubled())
    println(c.entries)
    println(c.handle(Reset))
    println(c.total)
    println(c.entries)
    println(c.state() == Counting)
    0
