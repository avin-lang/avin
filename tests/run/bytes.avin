// byte: an octet with bitwise operators, unsigned shifts and ordering.

main() -> int
    val high: byte = 0xf0
    val low: byte = 0x0f
    if high | low != 255 then return 1
    if high & low != 0 then return 2
    if high ^ 0xff != low then return 3
    if ~high != low then return 4
    // A byte's bits are unsigned: `>>` shifts zeros in, and 0xf0 is greater than 0x0f.
    if high >> 4 != low then return 5
    if high << 4 != 0 then return 6
    if low << 4 != high then return 7
    if high >> 8 != 0 then return 8
    if !(high > low) then return 9
    if !(0 <= low < 16 <= high) then return 10
    if int(high) != 240 then return 11
    if byte(255) != 0xff then return 12
    if int(byte(200)) + 100 != 300 then return 13
    var b: byte = 1
    b <<= 7
    if int(b) != 128 then return 14
    0
