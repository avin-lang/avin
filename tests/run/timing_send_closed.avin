// expect: trap
// A send with a timeout to a closed channel traps, as `send` does, rather than answering `false`: a
// closed channel is the program's mistake, not a time that ran out.
import avin.threads.Channel
import avin.time.millis

main()
  val c = Channel[int](1)
  c.close()
  println("before")
  println(c.send(1, millis(50)))
  println("after")
