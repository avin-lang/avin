// expect: trap
// A lambda the initializer makes is code it hands on, which the compile-time rule does not follow,
// even when the initializer calls it at once: its read of the value then runs while the
// initializer is still running, and the read traps there, naming the value, rather than wait for
// itself.
lazy val handed: int = (() -> handed + 1)()

main() -> int
  println("before")
  println(handed)
  println("after")
  0
