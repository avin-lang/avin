// expect: exit 0
// A union with a scalar member is a tag and a payload: every kind of member, at its boundary values,
// goes into the union and comes back out unchanged through a local, a parameter and a result, a wider
// union and a narrower one, an `Any` and a `match`, `is` and clauses that take it apart by member.

import avin.math.signBit

class Dog(val name: string)

data Point(x: int, y: int)

type Everything = i8 | i16 | i32 | i64 | byte | real | char | bool | unit | string | Point | Dog | Option[int] | Option[Dog] | (int, string) | ((int) -> int)

// Through a parameter and a result, each a value of several words.
pass(u: Everything) -> Everything = u

// Through a local that is assigned again.
relay(u: Everything) -> Everything
    var held: Everything = 0
    held = u
    held

describe(u: Everything) -> string = u match
    a: i8 -> s"i8 $a"
    b: i16 -> s"i16 $b"
    c: i32 -> s"i32 $c"
    d: i64 -> s"i64 $d"
    e: byte -> s"byte ${int(e)}"
    r: real -> s"real $r"
    ch: char -> s"char ${int(ch)}"
    bo: bool -> s"bool $bo"
    _: unit -> "unit"
    s: string -> s"string \"$s\" ${s.charCount}"
    p: Point -> s"point ${p.x} ${p.y}"
    dog: Dog -> s"dog ${dog.name}"
    o: Option[int] -> s"option $o"
    od: Option[Dog] -> s"dog option ${od.map(d -> d.name)}"
    t: (int, string) -> s"tuple ${t.0} ${t.1}"
    f: ((int) -> int) -> s"function ${f(20)}"

// The same value seen as an `Any` and taken back by a type pattern.
viaAny(u: Everything) -> string
    val a: Any = u
    a match
        back: Everything -> describe(back)
        _ -> "lost"

show(u: Everything)
    println(describe(u))
    if describe(pass(u)) != describe(u) then println("  pass differs")
    if describe(relay(u)) != describe(u) then println("  relay differs")
    if viaAny(u) != describe(u) then println("  any differs")

// Nested unions are flattened: a union inside a union is its members.
type Inner = int | bool

flat(u: Inner | string) -> string = u match
    n: int -> s"int $n"
    b: bool -> s"bool $b"
    s: string -> s"string $s"

// A smaller union widens into a wider one, its members moved to their places there, and a type
// pattern naming a smaller union narrows back to it.
widen(u: int | bool) -> int | bool | string | real = u

small(ib: int | bool) -> string = ib match
    n: int -> s"int $n"
    b: bool -> s"bool $b"

narrow(u: int | bool | string | real) -> string = u match
    ib: (int | bool) -> s"small ${small(ib)}"
    sr: (string | real) -> s"other $sr"

// Clauses take a union parameter apart by member.
clause(n: int) = s"clause int $n"
clause(s: string) = s"clause string $s"

byClauses(u: int | string) -> string = u match
    n: int -> clause(n)
    s: string -> clause(s)

// `is` binds the member it names and leaves the union as it is.
isTest(u: long | char) -> string
    if u is l: long then return s"long $l"
    if u is c: char then return s"char $c"
    "none"

main()
    show(i8.MinValue)
    show(i8.MaxValue)
    show(i16.MinValue)
    show(i16.MaxValue)
    show(int.MinValue)
    show(int.MaxValue)
    show(long.MinValue)
    show(long.MaxValue)
    show(byte(0))
    show(byte(255))
    show(0.0)
    show(-0.0)
    show(real.NaN)
    show(real.PositiveInfinity)
    show(real.NegativeInfinity)
    show(real.MinPositiveValue)
    show(1.0e308)
    show('\u{0}')
    show('é')
    show('\u{10FFFF}')
    show(true)
    show(false)
    show(())
    show("")
    show("日本🎉")
    show(Point(-1, int.MaxValue))
    show(Dog("rex"))
    show(Some(7))
    val noInt: Option[int] = None
    show(noInt)
    show(Some(Dog("fido")))
    val noDog: Option[Dog] = None
    show(noDog)
    show((3, "three"))
    show((n: int) -> n * 2)
    // The sign of a negative zero and the bits of a NaN survive.
    val nz: real | string = -0.0
    nz match
        r: real -> println(s"sign ${signBit(r)} ${r == 0.0}")
        _: string -> println("string")
    val nan: real | string = real.NaN
    nan match
        r: real -> println(s"nan ${r != r}")
        _: string -> println("string")
    println(flat(1))
    println(flat(true))
    println(flat("s"))
    println(narrow(widen(4)))
    println(narrow(widen(false)))
    println(narrow("text"))
    println(narrow(2.5))
    println(byClauses(5))
    println(byClauses("five"))
    println(isTest(long.MinValue))
    println(isTest('z'))
    // A union written in either order is one layout.
    val forward: int | string = 9
    val backward: string | int = forward
    println(backward)
