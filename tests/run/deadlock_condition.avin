// expect: trap
// A thread waits on a mutex's condition that nothing will notify; another takes the mutex while it
// waits and ends; `main` joins the waiter. The report names the condition and the join, and not the
// thread that ended.
import avin.threads.{Channel, Mutex, spawn}

main()
  val m = Mutex(0)
  val ready = m.condition()
  val waiting = Channel[int]()
  val waiter = spawn(() ->
    m.with(n ->
      waiting.send(1)
      while true do ready.wait()
      n))
  waiting.receive()
  val holder = spawn(() -> m.with(n -> n + 1))
  println("joining")
  println(holder.join())
  println(waiter.join())
