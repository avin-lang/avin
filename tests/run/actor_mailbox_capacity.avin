// expect: exit 0
// A bounded mailbox's capacity is at least one: zero or less traps in `spawn` and in `Router.pool`,
// failing the actor whose code called it, here under `Stop`, so its end tells the reason. The pool's
// check comes before anything is started.
import avin.actors.{Bounded, DropNewest, DropOldest, Mailbox, Router, Stop, spawn}

data Msg
  Ping

actor Idle receives Msg
  receive
    _ -> ()

actor Starter(mailbox: Mailbox, pooled: bool) receives Msg
  if pooled
    _ = Router.pool(2, Idle(), mailbox = mailbox)
  else
    _ = spawn(Idle(), mailbox = mailbox)
  receive
    _ -> ()

main()
  println(spawn(Starter(Bounded(0, DropNewest), false), onFailure = Stop).ended().await())
  println(spawn(Starter(Bounded(-1, DropOldest), false), onFailure = Stop).ended().await())
  println(spawn(Starter(Bounded(-2147483648, DropNewest), false), onFailure = Stop).ended().await())
  println(spawn(Starter(Bounded(0, DropOldest), true), onFailure = Stop).ended().await())
  // A capacity of one, and the largest, start.
  val one = spawn(Idle(), mailbox = Bounded(1, DropNewest))
  val most = spawn(Idle(), mailbox = Bounded(2147483647, DropOldest))
  println(one.offer(Ping) is Ok(_))
  println(most.offer(Ping) is Ok(_))
