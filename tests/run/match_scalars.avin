// match on integers, chars, bytes, bools and unit, with every scalar pattern form.

classify(n: int) -> string = n match
    0 -> "zero"
    -1 -> "minus one"
    1 | 2 | 3 -> "small"
    4..<10 -> "single digit"
    10..99 -> "two digits"
    big if big > 1000 -> "huge"
    _ -> "other"

kind(c: char) -> string = c match
    'a' | 'e' | 'i' | 'o' | 'u' -> "vowel"
    'a'..'z' -> "consonant"
    '0'..'9' -> "digit"
    else "symbol"

describe(flag: bool) -> string = flag match
    true -> "yes"
    false -> "no"

nibble(b: byte) -> int = b match
    0x00..0x0f -> 1
    0xf0..0xff -> 3
    _ -> 2

main()
    print(classify(0))
    print(classify(-1))
    print(classify(2))
    print(classify(7))
    print(classify(10))
    print(classify(99))
    print(classify(5000))
    print(classify(500))
    print(kind('e'))
    print(kind('q'))
    print(kind('7'))
    print(kind('!'))
    print(describe(true))
    print(describe(false))
    // `name @ pattern` binds the whole value; a pattern name may shadow an outer one.
    val n = 3
    val doubled = n match
        small @ 1..5 -> small * 2
        n -> n
    if doubled == 6 then print("bound")
    // A guard is tested after the pattern, and a failing guard moves on to the next arm.
    val sign = n match
        x if x < 0 -> "negative"
        x if x == 0 -> "zero"
        _ -> "positive"
    print(sign)
    if nibble(0x0a) + nibble(0x55) + nibble(0xfe) == 6 then print("bytes")
    // A match on unit, and a match used only for its effects, whose arms need not agree.
    () match
        () -> print("unit")
    n match
        3 -> print("three")
        _ -> ()
