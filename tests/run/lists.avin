// expect: exit 0
// The core library's `List`: built with `::` and `[]`, taken apart by `::` and sequence patterns in
// `match`, clauses and `for`, and every method on short lists. Every allocation collects (the test
// runner sets AVIN_GC_STRESS), so every list still in use must be found by the collector.

show(xs: List[int]) -> string
    var out = "["
    var first = true
    for x in xs
        if !first then out = out + ", "
        out = out + s"$x"
        first = false
    out + "]"

words(xs: List[string]) -> string
    var out = ""
    for x in xs do out = out + x
    out

sum(xs: List[int]) -> int = xs match
    [] -> 0
    head :: tail -> head + sum(tail)

// The same by clauses, with the patterns in the parameters.
total(xs: List[int]) -> int
total([]) = 0
total(x :: rest) = x + total(rest)

// Clauses with a guard, and a sequence pattern beside a `::` one.
count(xs: List[int], limit: int) -> int
count([], _) = 0
count(x :: rest, limit) | x > limit = 1 + count(rest, limit)
count([_], _) = 0
count(_ :: rest, limit) = count(rest, limit)

pairs[A](xs: List[A]) -> List[(A, A)] = xs match
    a :: b :: rest -> (a, b) :: pairs(rest)
    _ -> []

describe(xs: List[string]) -> string = xs match
    [] -> "nobody"
    [one] -> one
    [first, second] -> s"$first and $second"
    first :: _ -> s"$first and ${xs.length() - 1} others"

shape(xs: List[int]) -> string = xs match
    [] -> "empty"
    [0] -> "zero"
    [x] if x < 0 -> "negative"
    a :: [b, c] -> s"three from $a to $c via $b"
    1 :: 2 :: _ -> "one, two, ..."
    whole @ _ :: _ :: _ -> s"${whole.length()} long"
    _ :: _ -> "one"

firsts(xs: List[(int, string)]) -> string
    var out = ""
    for (n, name) in xs do out = out + s"$n$name "
    out

nested(xss: List[List[int]]) -> int = xss match
    (a :: _) :: (b :: _) :: _ -> a + b
    [] :: _ -> -1
    _ -> 0

main()
    val xs = 1 :: 2 :: 3 :: []
    println(show(xs))
    val built: List[int] = [4, 5, 6]
    println(show(built))
    // `::` binds more loosely than arithmetic and more tightly than comparisons.
    val n = 10
    val ys = n + 1 :: n * 2 :: []
    println(show(ys))
    println(ys == 11 :: [20] && ys != 11 :: [])
    println(show(0 :: built))
    println(s"${sum(xs)} ${total(built)} ${count([5, 1, 7, 2, 9], 4)}")
    for (a, b) in pairs(1 :: 2 :: 3 :: 4 :: 5 :: [])
        println(s"$a-$b")
    println(describe([]))
    println(describe(["ann"]))
    println(describe(["ann", "bo"]))
    println(describe(["ann", "bo", "cy", "di"]))
    println(shape([]))
    println(shape([0]))
    println(shape([-4]))
    println(shape([7]))
    println(shape([1, 2, 3]))
    println(shape([1, 2, 3, 4]))
    println(shape([5, 6, 7, 8, 9]))
    println(firsts([(1, "a"), (2, "b")]))
    println(nested([[1, 2], [30]]))
    println(nested([[], [1]]))
    println(nested([[1]]))

    // Methods.
    val empty: List[int] = []
    println(s"${xs.isEmpty()} ${empty.isEmpty()} ${xs.nonEmpty()} ${empty.nonEmpty()}")
    println(s"${xs.head()} ${show(xs.tail())} ${xs.last()} ${xs.length()} ${empty.length()}")
    println(s"${xs.headOption().getOrElse(-1)} ${empty.headOption().getOrElse(-1)}")
    println(s"${xs(0)} ${xs(2)} ${xs.lift(1).getOrElse(-1)} ${xs.lift(3).getOrElse(-1)} ${xs.lift(-1).getOrElse(-1)}")
    println(show(xs.reverse()))
    println(show(xs ++ built))
    println(show(empty ++ xs))
    println(show(xs.++(empty)))
    println(show(xs.map(x -> x * x)))
    println(words(xs.map(x -> s"<$x>")))
    println(show(xs.flatMap(x -> x :: x * 10 :: [])))
    println(show(xs.flatMap(x -> if x == 2 then [] else [x])))
    println(show(built.filter(x -> x % 2 == 0)))
    println(xs.foldLeft("", (acc, x) -> acc + s"$x"))
    println(xs.foldRight("", (x, acc) -> acc + s"$x"))
    println(xs.foldLeft(0, (acc, x) -> acc * 10 + x))
    println(show(xs.take(2)))
    println(show(xs.take(0)))
    println(show(xs.take(9)))
    println(show(xs.drop(2)))
    println(show(xs.drop(9)))
    println(show(xs.drop(-1)))
    println(s"${xs.exists(x -> x > 2)} ${xs.exists(x -> x > 3)} ${empty.exists(x -> true)}")
    println(s"${xs.forall(x -> x > 0)} ${xs.forall(x -> x > 1)} ${empty.forall(x -> false)}")
    println(s"${xs.find(x -> x > 1).getOrElse(-1)} ${xs.find(x -> x > 5).getOrElse(-1)}")
    println(s"${xs.contains(2)} ${xs.contains(4)} ${empty.contains(0)} ${pairs(xs).contains((1, 2))}")
    var seen = 0
    xs.foreach(x -> seen = seen * 10 + x)
    println(seen)
    val a = xs.toArray()
    println(s"${a.length()} ${a(0)} ${a(2)} ${empty.toArray().length()}")
    var through = 0
    val it = xs.iterator()
    while it.hasNext() do through += it.next()
    println(through)

    // Equality, hashing and ordering compare by contents.
    val again = 1 :: [2, 3]
    println(s"${xs == again} ${xs == xs.reverse()} ${xs == xs.take(2)} ${empty == xs.drop(3)}")
    println(xs.hash() == again.hash())
    println(s"${xs < 1 :: [2, 4]} ${xs < 1 :: [2]} ${xs.take(2) < xs} ${xs <= again} ${empty < xs}")
    val names: List[string] = ["b", "a"]
    println(s"${names == "b" :: ["a"]} ${words(names.reverse())}")
