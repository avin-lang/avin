// expect: exit 0
// Every collection, and a class of the program's own that is `Iterable`, has the methods written once
// on `Iterable`: folds, searches, counts, extremes, partitions and conversions. Through `Iterable`
// the added methods answer; on a list, a set or a range its own faster method of the same name
// answers, with the same result. A set's order is its own, so what is printed from one is sorted or
// does not depend on order. An iterator is consumed by the first method that traverses it, so every
// method after that sees it empty.
class Countdown(from: int): Iterable[int]
    override iterator() -> Iterator[int] = Ticks(from)

class Ticks(private var n: int): Iterator[int]
    override hasNext() -> bool = n > 0
    override next() -> int
        n -= 1
        n + 1

sortedText(xs: Vector[int]) -> string = xs.sorted().mkString(",")

survey(name: string, xs: Iterable[int])
    val squares = xs.foldLeft(0, (acc, x) -> acc + x * x)
    val total = xs.reduceOption((a, b) -> a + b).getOrElse(-1)
    val some = xs.exists(x -> x > 2)
    val all = xs.forall(x -> x < 9)
    val three = xs.find(x -> x == 3).isSome()
    val odd = xs.count(x -> x % 2 == 1)
    val least = xs.minBy(x -> -x).getOrElse(-1)
    val greatest = xs.maxBy(x -> -x).getOrElse(-1)
    val low = xs.min().getOrElse(-1)
    val high = xs.max().getOrElse(-1)
    print(s"$name: empty=${xs.isEmpty()} nonEmpty=${xs.nonEmpty()} squares=$squares total=$total some=$some all=$all three=$three odd=$odd")
    print(s"  minBy=$least maxBy=$greatest min=$low max=$high")
    val (evens, odds) = xs.partition(x -> x % 2 == 0)
    print(s"  partition=${sortedText(evens)}|${sortedText(odds)}")
    print(s"  toList=${sortedText(xs.toList().toVector())} toVector=${sortedText(xs.toVector())} toSet=${xs.toSet().size()}")
    print(s"  toArray=${sortedText(xs.toArray().toVector())} toBuffer=${sortedText(xs.toBuffer().toVector())}")
    var indices = 0
    for (x, i) in xs.zipWithIndex() do indices += i
    print(s"  zipWithIndex=${xs.zipWithIndex().length()} indices=$indices")
    var visited = 0
    xs.foreach(x -> visited += x)
    print(s"  foreach=$visited")

main()
    val list: List[int] = [1, 2, 3, 4]
    val vector: Vector[int] = [1, 2, 3, 4]
    val array: Array[int] = [1, 2, 3, 4]
    val buffer: Buffer[int] = [1, 2, 3, 4]
    val deque: Deque[int] = [1, 2, 3, 4]
    val set: Set[int] = [1, 2, 3, 4]
    val range = 1 .. 4
    val countdown = Countdown(4)
    survey("list", list)
    survey("vector", vector)
    survey("array", array)
    survey("buffer", buffer)
    survey("deque", deque)
    survey("range", range)
    survey("set", set)
    survey("countdown", countdown)
    survey("iterator", (1 .. 4).iterator())
    val noList: List[int] = []
    val noVector: Vector[int] = []
    val noSet: Set[int] = []
    survey("empty list", noList)
    survey("empty vector", noVector)
    survey("empty array", Array.empty[int]())
    survey("empty buffer", Buffer[int]())
    survey("empty deque", Deque[int]())
    survey("empty range", 1 ..< 1)
    survey("empty set", noSet)
    survey("empty countdown", Countdown(0))

    // On each type's own static type, its own method where it has one, the added one where not.
    print(list.foldLeft("", (acc, x) -> s"$acc$x"))
    print(vector.foldLeft("", (acc, x) -> s"$acc$x"))
    print(array.reduce((a, b) -> a * 10 + b))
    print(buffer.count(x -> x > 1))
    print(deque.find(x -> x > 2).getOrElse(0))
    print(range.exists(x -> x == 4))
    print(set.forall(x -> x > 0))
    print(countdown.foldLeft("", (acc, x) -> s"$acc$x"))
    print(list.toList() == list)
    print(set.isEmpty())
    print(range.nonEmpty())
    print(countdown.mkString("<", " ", ">"))
    print(list.mkString())
    print(deque.mkString("+"))
    print(array.zipWithIndex().map(p -> p.0 * p.1).sum())
    print(range.toSet() == set)
    print(list.min().getOrElse(0))
    print(range.max().getOrElse(0))
    print(vector.minBy(x -> x % 3).getOrElse(0))
    print(buffer.maxBy(x -> x % 3).getOrElse(0))
    var seen = ""
    list.foreach(x -> seen = s"$seen$x")
    countdown.foreach(x -> seen = s"$seen$x")
    print(seen)
