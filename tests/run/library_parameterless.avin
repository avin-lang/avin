// expect: exit 0
// The standard library's pure accessors beyond the collections are parameterless methods: an
// option's, an either's and a result's, a string's, a char's, an integer's and a real's, a pair's
// `swap`, an enumeration's `values`, `ordinal` and `name`, a string writer's, a regex's and a
// match's, a queue's and the time types'. Each is read by name, chained, interpolated, through
// generic instances and through a type parameter. What has an overload taking parameters keeps
// `()`: the string parsers beside their radix forms, a match's `start`, `end`, `before` and `after`
// beside their group forms.

import avin.regex.Regex
import avin.time

data Suit derives Enumerable
  Hearts
  Spades

// Through a type parameter bounded by the trait, the static `values` is read on the type argument.
everyName[T: Enumerable]() -> string = T.values.map(v -> v.name).mkString(",")

counted[T: Enumerable]() -> int = T.values.size

// Generic code reads an option's accessors the same way at every element type.
shown[T: Display](o: Option[T]) -> string =
  s"defined ${o.isDefined}, empty ${o.isEmpty}, nonEmpty ${o.nonEmpty}, list ${o.toList}, size ${o.knownSize}"

firstOf[T](o: Option[Vector[T]]) -> Option[T] = if o.isDefined && o.get.nonEmpty then Some(o.get.head) else None

described[E: Display](r: Result[string, E]) -> string =
  if r.isOk then s"ok ${r.ok.get.trim.toUpper}" else s"err ${r.err.get}"

main()
  // Option, at a vector element type and nested.
  val some: Option[Vector[int]] = Some([3, 4])
  val none: Option[Vector[int]] = None
  println(shown(some))
  println(shown(none))
  println(firstOf(some), firstOf(none), firstOf(Some(Vector.empty[int]())))
  println(Some(Some(5)).flatten, Some((1, "a")).unzip, some.get.size, some.toVector.size)
  println(Some(2).toArraySeq.length)

  // Either and Result, generic instances included.
  val right: Either[string, int] = Right(7)
  val left: Either[string, int] = Left("no")
  println(right.isRight, right.isLeft, left.swap, right.toOption, left.toOption, right.toList, right.toVector)
  val same: Either[int, int] = Left(9)
  println(same.merge)
  val good: Result[string, int] = Ok("  fine  ")
  val bad: Result[string, int] = Err(404)
  println(described(good), described(bad), good.isErr, bad.isErr, bad.toList.size)
  val nested: Result[Result[int, string], string] = Ok(Ok(1))
  println(nested.flatten)

  // A string: chained, empty and Unicode.
  val s = "  Hello, wörld  "
  val t = s.trim
  println(s"[$t] [${t.toUpper}] [${t.toLower}] ${t.byteLength} ${t.charCount}")
  println(t.tail.head, t.init.last, t.reverse, t.headOption, "".headOption, "".lastOption, "".isEmpty, "".nonEmpty)
  println(t.chars.size, "ab".bytes, "a\nb".lines, "   ".isBlank, s.stripLeading.charCount, s.stripTrailing.byteLength)
  println("word".capitalize, " x ".strip, "line\n".stripLineEnd, "ö".head, "ö".tail.isEmpty)
  println("42".toInt() + "ff".toInt(16), "x".toIntOption(), "2.5".toReal(), "true".toBool(), "  |a".stripMargin())

  // A char, an integer and a real.
  val c = 'a'
  println(
    c.isLetter,
    c.isDigit,
    '7'.asDigit,
    c.toUpper,
    'Q'.toLower,
    ' '.isWhitespace,
    'x'.isLetterOrDigit,
    '\n'.isControl
  )
  println((-5).abs, (-5).sign, 12.bitCount, 1.leadingZeros, 8.trailingZeros, 64.isPowerOfTwo, long.MinValue.sign)
  println((0.0 / 0.0).isNaN, (1.0 / 0.0).isInfinite, 1.5.isFinite)

  // A pair, an enumeration, and through a type parameter.
  println((1, "b").swap, (1, "b").swap.swap)
  println(Suit.values, Spades.ordinal, Hearts.name, everyName[Suit](), counted[Suit]())

  // A string writer.
  val w = StringWriter()
  println(w.isEmpty, w.length)
  w.write("abc")
  println(w.text, w.length, w.isEmpty)

  // A regex and its match.
  val r = Regex("(?<word>[a-z]+)(\\d)")
  println(r.regex, r.pattern.groupCount, r.unanchored.regex)
  val m = r.findFirstMatchIn("xx ab1 yy").get
  println(m.matched, m.start(), m.end(), m.start(1), m.groupCount, m.before(), m.after(), m.groupNames)

  // A queue, a sorted vector and a sorted set.
  val q = Queue(1, 2, 3)
  println(q.front, q.frontOption, q.dequeue.0, q.dequeue.1.front, Queue.empty[int]().dequeueOption)
  println([3, 1, 2].sorted, SortedSet(5, 2, 9).firstKey, SortedSet(5, 2, 9).lastKey)

  // The time types.
  val d = time.date(2024, 2, 29)
  println(d.year, d.month, d.day, d.isLeapYear, d.dayOfYear, d.weekday, d.startOfMonth, d.daysInMonth)
  println(90.seconds.toMinutes, 2.hours.toSeconds, (-3).days.isNegative, 0.seconds.isZero, (-3).days.abs)
