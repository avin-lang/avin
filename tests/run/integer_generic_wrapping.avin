// expect: exit 0
// A type parameter bounded by `Integer` has the wrapping operators `+%`, `-%`, `*%` and the
// saturating operators `+|`, `-|`, `*|` as the machine's, at the width each instance is, including
// through nested generics, closures and compound assignment.

addW[T: Integer](a: T, b: T) -> T = a +% b
subW[T: Integer](a: T, b: T) -> T = a -% b
mulW[T: Integer](a: T, b: T) -> T = a *% b
addS[T: Integer](a: T, b: T) -> T = a +| b
subS[T: Integer](a: T, b: T) -> T = a -| b
mulS[T: Integer](a: T, b: T) -> T = a *| b

all[T: Integer](a: T, b: T) -> string
    s"${addW(a, b)} ${subW(a, b)} ${mulW(a, b)} ${addS(a, b)} ${subS(a, b)} ${mulS(a, b)}"

nested[T: Integer](a: T, b: T) -> string = all(a, b)

viaClosure[T: Integer](a: T, b: T) -> T
    val f = (x: T, y: T) -> (x +% y) -| (y *| x)
    f(a, b)

compound[T: Integer](a: T, b: T) -> string
    var x = a
    x +%= b
    var y = a
    y -%= b
    var z = a
    z *%= b
    var u = a
    u +|= b
    var v = a
    v -|= b
    var w = a
    w *|= b
    s"$x $y $z $u $v $w"

main()
    val i1max: i1 = 0
    val i1min: i1 = -1
    println(s"i1 ${nested(i1min, i1min)} | ${nested(i1max, i1min)} | ${nested(i1max, i1max)}")
    val i8max: i8 = 127
    val i8min: i8 = -128
    println(s"i8 ${nested(i8max, i8max)} | ${nested(i8min, i8min)} | ${nested(i8max, i8min)} | ${nested(i8(100), i8(3))}")
    println(s"int ${nested(int.MaxValue, 1)} | ${nested(int.MinValue, 1)} | ${nested(int.MinValue, int.MinValue)} | ${nested(7, 6)}")
    println(s"long ${nested(long.MaxValue, long(1))} | ${nested(long.MinValue, long(1))} | ${nested(long.MaxValue, long(2))} | ${nested(long(7), long(6))}")
    val i65max: i65 = 18446744073709551615 / 1 / 1 * 1
    println(s"i65 ${nested(i65max, i65(1))} | ${nested(-i65max, i65(2))} | ${nested(i65(7), i65(6))}")
    val one: i128 = 1
    val big: i128 = (one << 126) - one + (one << 126)
    println(s"i128 ${nested(big, one)} | ${nested(-big - one, one)} | ${nested(big, i128(2))} | ${nested(i128(7), i128(6))}")
    println(s"closure ${viaClosure(i8(100), i8(100))} ${viaClosure(int.MaxValue, 2)} ${viaClosure(3, 4)}")
    println(s"compound ${compound(i8(120), i8(10))} | ${compound(int.MinValue, 1)} | ${compound(5, 3)}")
