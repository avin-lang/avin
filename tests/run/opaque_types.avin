// expect: exit 0
// An opaque type is a type of its own laid out as its representation. Its module makes a value with
// `Name(r)` and takes one apart with `x.repr`, or `repr` alone in its impls; its methods, its
// traits' default bodies, equality and hashing work on it, and a type pattern tells it apart from
// its representation and from another opaque type of the same representation.

opaque type UserId = long
opaque type OrderId = long
opaque type Email = string
opaque type Stack[T] = Vector[T]
opaque type Id[T] = long

data User(id: UserId, mail: Email)

data Order(n: int)

impl UserId
  next() -> UserId = UserId(repr + 1)
  def id -> long = repr

impl Ord for UserId
  compare(other: UserId) -> int = repr.compare(other.repr)

impl Display for UserId
  display(out: Writer, spec: FormatSpec) = out.write(s"user#${repr}")

impl Display for Email
  display(out: Writer, spec: FormatSpec) = out.write(s"<$repr>")

impl[T] Stack[T]
  push(x: T) -> Stack[T] = Stack(repr :+ x)
  def size -> int = repr.length
  def top -> Option[T] = repr.lastOption

emptyStack[T]() -> Stack[T] = Stack([])

email(s: string) -> Email = Email(s.toLower)

idOf[T](n: long) -> Id[T] = Id(n)

firstOf[T](xs: Vector[T]) -> T = xs(0)

describe(x: Any) -> string = x match
  u: UserId -> s"a user ${u.id}"
  o: OrderId -> s"an order ${o.repr}"
  e: Email -> s"an email $e"
  n: long -> s"a long $n"
  s: string -> s"a string $s"
  _ -> "other"

pick(x: UserId | long) -> string = x match
  u: UserId -> s"user ${u.id}"
  n: long -> s"long $n"

which(x: UserId | OrderId) -> string = x match
  u: UserId -> s"user ${u.repr}"
  o: OrderId -> s"order ${o.repr}"

main()
  val u = UserId(41)
  val v = u.next()
  println(v.id)
  println(u == v)
  println(v == UserId(42))
  println(u != v)
  println(s"$v")
  println(v)
  // The traits' default bodies run on the value: `<`, `less`, `max` come from `compare`.
  println(u < v)
  println(v.less(u))
  println(max(u, v).id)
  println([v, u, UserId(7)].sorted.map(x -> x.id))
  println(describe(v))
  println(describe(OrderId(42)))
  println(describe(long(42)))
  println(describe(email("Ann@X.org")))
  println(describe("Ann@X.org"))
  println(pick(v))
  println(pick(long(7)))
  println(which(UserId(1)))
  println(which(OrderId(1)))
  val xs: Vector[UserId] = [u, v]
  println(xs.length)
  println(firstOf(xs).id)
  val m = Map((u, "a"), (v, "b"))
  println(m.get(v))
  println(m.get(UserId(9)))
  println(Set(u, v, UserId(41)).size)
  val s = emptyStack[int]().push(1).push(2)
  println(s.size)
  println(s.top)
  println(emptyStack[string]().top)
  val id1: Id[User] = idOf(1)
  val id2: Id[User] = idOf(1)
  val id3: Id[Order] = idOf(1)
  println(id1 == id2)
  println(id3.repr)
  val who = User(u, email("ann@x.org"))
  println(who.id.id)
  println(who == User(UserId(41), email("ANN@x.org")))
  println(who.mail)
  // Equal values held as `Any` are equal; a representation equal to the value is not.
  val a: Any = u
  val b: Any = UserId(41)
  val c: Any = long(41)
  println(a == b)
  println(a == c)
  println(UserId(9223372036854775807).id)
  println(UserId(-9223372036854775807 - 1).id)
  println(UserId(1) <= UserId(1))
  println(UserId(2) >= UserId(3))
  println(Id[User](5).repr)
