// expect: exit 0
// Mutating a linked map or set while iterating it never traps. Replacing values and removing entries
// are defined: an entry removed before the iterator reaches it is not visited. Binding new keys is safe
// whether or not the iterator visits them, including past a squeeze of the map's buffer.

import avin.collections.mutable.{LinkedMap, LinkedSet}

main()
    // Replacing values while iterating.
    val m = LinkedMap[int, int]()
    for i in 0..<6 do m(i) = i
    for (k, v) in m do m(k) = v * 10
    println(m)

    // Removing the entry being visited.
    for (k, _) in m
        if k % 2 == 0 then m.remove(k)
    println(m)

    // Removing entries ahead of the iterator: they are not visited.
    val n = LinkedMap[int, int]()
    for i in 0..<8 do n(i) = i
    var seen: Vector[int] = []
    for (k, _) in n
        seen = seen ++ [k]
        n.remove(k + 1)
        n.remove(k + 2)
    println(s"$seen $n")

    // Removing everything, including by removeFirst, ends the iteration.
    val p = LinkedMap[int, int]()
    for i in 0..<5 do p(i) = i
    var visited = 0
    for e in p
        visited += 1
        p.removeFirst()
    println(s"$visited ${p.size}")
    val q = LinkedMap[int, int]()
    for i in 0..<5 do q(i) = i
    visited = 0
    for e in q
        visited += 1
        q.clear()
    println(s"$visited ${q.size}")

    // Keys iterator and values iterator survive removals the same way.
    val r = LinkedMap[string, int]()
    r("a") = 1
    r("b") = 2
    r("c") = 3
    val ks = r.keysIterator()
    val vs = r.valuesIterator()
    r.remove("a")
    println(s"${ks.next()} ${vs.next()} ${ks.hasNext()} ${vs.hasNext()}")
    r.remove("c")
    println(s"${ks.hasNext()} ${vs.hasNext()}")

    // Binding new keys while iterating, enough to squeeze the buffer, never traps; the entries that
    // were there are visited once each and the map ends with every key bound.
    val s = LinkedMap[int, int]()
    for i in 0..<40 do s(i) = i
    for i in 0..<30 do s.remove(i)
    var existing = 0
    for (k, _) in s
        if k < 40
            existing += 1
            s(1000 + k) = k
    println(s"$existing ${s.size} ${s.contains(1030)} ${s.contains(1039)} ${s.contains(1029)}")

    // The same for a set.
    val set = LinkedSet[int]()
    for i in 0..<6 do set.add(i)
    for x in set
        if x % 2 == 1 then set.remove(x)
        set.remove(x + 1)
    println(set)
    for x in set
        if x < 100 then set.add(x + 100)
    println(set)
