// expect: trap
// A routee's failure under `Escalate`, the default, fails its router, which escalates in turn: a
// top-level router stops the program, the trap reported once, naming the routee. What was printed
// before is kept, and nothing after it is.
import avin.actors.{ActorRef, Router}
import avin.time

data Job
  Parse(text: string, replyTo: ActorRef[int])

actor Parser receives Job
  receive
    Parse(text, replyTo) -> replyTo.tell(text.toInt())

main()
  val router = Router.pool(2, Parser())
  println(router.ask(r -> Parse("12", r), timeout = time.seconds(5)).await())
  println(router.ask(r -> Parse("x", r), timeout = time.seconds(30)).await())
  println("not reached")
