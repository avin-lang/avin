// expect: exit 0
// An actor's states across its lifecycle. A restarted actor starts again in its first state: its
// body runs again and then the first state's `enter`, and the messages queued behind the failure are
// handled there, whatever state the trap left. The current state's `leave` runs only on a transition,
// so neither a failure nor a stop runs it; the `stopping` block runs instead and reads `state()`, the
// state the actor ended in. A trap in an `enter` or a `leave` fails the actor as a trap in an arm
// does. An arm that calls `stop()` and yields a state still completes its transition before the
// actor ends. A trap in the first state's `enter` fails the actor as it starts.
import avin.actors.{ActorRef, Failed, Restart, Stop, spawn}
import avin.threads.Channel
import avin.time

data Msg
    Go(n: int)
    Fail
    BadEnter
    BadLeave
    Halt
    Get(reply: ActorRef[string])

actor Worker(log: Channel[string]) receives Msg
    var handled = 0
    log.send("body")

    state Idle
        enter
            log.send("enter idle")
        Go(n) -> Busy(n)
        BadEnter -> Broken
        Halt ->
            stop()
            Busy(-1)

    state Busy(n: int)
        enter
            log.send(s"enter busy $n")
        leave
            log.send(s"leave busy $n")
            if n == 13 then handled = handled / (n - n)
        Go(m) -> Busy(n + m)
        Fail -> Busy(n / (n - n))
        BadLeave -> Idle
        Halt ->
            stop()
            Idle

    state Broken
        enter
            log.send("enter broken")
            handled = handled / (handled - handled)
        _ -> stay

    receive
        Get(r) ->
            handled += 1
            r.tell(s"${state()} handled $handled")
            stay
        _ -> stay

    stopping
        log.send(s"stopping in ${state()}")

actor StartsBroken(log: Channel[string]) receives Msg
    state First
        enter
            log.send("first enter")
            val zero = 0
            log.send(s"${1 / zero}")
        _ -> stay

main()
    val log = Channel[string]()
    val wait = time.seconds(60)
    val w = spawn(Worker(log), onFailure = Restart(5, time.minutes(1)))
    println(log.receive().get())
    println(log.receive().get())
    w.tell(Go(2))
    println(log.receive().get())
    println(w.ask(r -> Get(r), timeout = wait).await())
    // A failure in `Busy`: no `leave`, the `stopping` block, then the body and the first `enter` again;
    // the message queued behind it is handled in `Idle`.
    w.tell(Fail)
    w.tell(Go(5))
    println(log.receive().get())
    println(log.receive().get())
    println(log.receive().get())
    println(log.receive().get())
    println(w.ask(r -> Get(r), timeout = wait).await())
    // `stop()` in an arm of `Busy` yielding a state: `leave`, `enter`, then the `stopping` block.
    w.tell(Go(1))
    println(log.receive().get())
    println(log.receive().get())
    w.tell(Halt)
    println(log.receive().get())
    println(log.receive().get())
    println(log.receive().get())
    println(w.ended().await())
    val v = spawn(Worker(log), onFailure = Restart(5, time.minutes(1)))
    println(log.receive().get())
    println(log.receive().get())
    // A trap in an `enter`: the state is already the one entered.
    v.tell(BadEnter)
    println(log.receive().get())
    println(log.receive().get())
    println(log.receive().get())
    println(log.receive().get())
    // A trap in a `leave`: the transition stops there, so the state the trap left is still `Busy`.
    v.tell(Go(3))
    println(log.receive().get())
    v.tell(Go(10))
    println(log.receive().get())
    println(log.receive().get())
    v.tell(BadLeave)
    println(log.receive().get())
    println(log.receive().get())
    println(log.receive().get())
    println(log.receive().get())
    println(v.ask(r -> Get(r), timeout = wait).await())
    // `stop()` in an arm of `Idle` yielding a state: the transition completes, then the actor ends.
    v.tell(Halt)
    println(log.receive().get())
    println(log.receive().get())
    println(v.ended().await())
    val b = spawn(StartsBroken(log), onFailure = Stop)
    println(log.receive().get())
    println(b.ended().await() is Failed(_))
    println(log.tryReceive())
