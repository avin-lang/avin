// expect: exit 0
// The elementary functions of `avin.math` on ordinary values, at the edges of their domains, and on
// the infinities and NaN, which give values and never trap.
import avin.math
import avin.math.{Pi, sqrt}

main()
  println(s"${math.Pi} ${math.E} ${Pi}")
  println(s"${sqrt(2.0)} ${math.sqrt(16.0)} ${math.sqrt(0.0)} ${math.sqrt(-0.0)} ${math.sqrt(-1.0)}")
  println(s"${math.sqrt(real.PositiveInfinity)} ${math.sqrt(real.NaN)} ${math.cbrt(-27.0)}")
  println(s"${math.log(1.0)} ${math.log(math.E)} ${math.log(0.0)} ${math.log(-0.0)} ${math.log(-1.0)}")
  println(s"${math.log(real.PositiveInfinity)} ${math.log10(1000.0)} ${math.log1p(0.0)}")
  println(
    s"${math.exp(0.0)} ${math.exp(1.0)} ${math.exp(real.NegativeInfinity)} ${math.exp(1000.0)} ${math.expm1(0.0)}"
  )
  println(s"${math.pow(2.0, 10.0)} ${math.pow(2.0, -1.0)} ${math.pow(real.NaN, 0.0)} ${math.pow(-8.0, 0.5)}")
  println(s"${math.pow(0.0, -1.0)} ${math.pow(-2.0, 3.0)} ${math.hypot(3.0, 4.0)} ${math.hypot(1e300, 1e300) / 1e300}")
  println(s"${math.sin(0.0)} ${math.cos(0.0)} ${math.tan(0.0)} ${math.sin(Pi / 2.0)} ${math.cos(Pi)}")
  println(
    s"${math.sin(real.PositiveInfinity)} ${math.asin(1.0)} ${math.asin(2.0)} ${math.acos(1.0)} ${math.atan(real.PositiveInfinity)}"
  )
  println(s"${math.atan2(1.0, 1.0)} ${math.atan2(0.0, -1.0)} ${math.atan2(-0.0, -1.0)} ${math.atan2(1.0, 0.0)}")
  println(s"${math.sinh(0.0)} ${math.cosh(0.0)} ${math.tanh(real.PositiveInfinity)}")
  println(
    s"${math.floor(2.7)} ${math.floor(-2.5)} ${math.ceil(2.1)} ${math.ceil(-2.5)} ${math.floor(real.NegativeInfinity)}"
  )
  println(s"${math.rint(2.5)} ${math.rint(3.5)} ${math.rint(-0.5)} ${math.abs(-3.0)} ${math.abs(-0.0)}")
  println(
    s"${math.max(1.0, 2.0)} ${math.min(1.0, 2.0)} ${math.max(1.0, real.NaN)} ${math.max(-0.0, 0.0)} ${math.min(-0.0, 0.0)}"
  )
  println(s"${math.signum(-4.0)} ${math.signum(4.0)} ${math.signum(-0.0)} ${math.signum(real.NaN)}")
  println(s"${math.toRadians(180.0)} ${math.toDegrees(Pi)}")
  // A function is a value like any other.
  val f: real -> real = math.sqrt
  println([1.0, 4.0, 9.0].map(f))
