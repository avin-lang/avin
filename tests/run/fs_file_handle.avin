// Files held open through `avin.fs`: the five ways to open one, reading and writing from a
// position, seeking, lines, following a growing file, two handles appending, and each misuse an
// `Err`.
import avin.fs
import avin.fs.File
import avin.io.{IoError, NotFound, Other, InvalidUtf8}

impl[T] Result[T, IoError]
  get() -> T = self match
    Ok(v) -> v
    Err(e) -> fail(s"unexpected $e")

show(r: Result[Array[byte], IoError]) -> string = r match
  Ok(b) -> b.mkString(" ")
  Err(e) -> s"Err($e)"

failure(r: Result[File, IoError]) -> string = r match
  Ok(_) -> "opened"
  Err(e) -> s"Err($e)"

text(bytes: Array[byte]) -> string = string.fromUtf8Lossy(bytes)

// The temporary directory the test works in, written as `DIR` in what it prints, which an error
// names, so the output is the same on every run.
var root = ""

say(line: Any)
  println(if root == "" then s"$line" else s"$line".replace(root, "DIR"))

main()
  val dir = fs.createTempDir("avin-file").get()
  root = dir
  // An empty file: size 0, position 0, every read empty, no line.
  _ = fs.writeText(dir + "/empty", "")
  val e = fs.open(dir + "/empty").get()
  say(s"${e.size()} ${e.position()} ${show(e.read(10))} ${show(e.readAll())} ${e.readLine()} ${e.readText()}")
  say(e.close())
  // One byte.
  _ = fs.writeBytes(dir + "/one", Array.fill(1, byte(7)))
  val o = fs.open(dir + "/one").get()
  say(s"${o.size()} ${show(o.read(10))} ${show(o.read(10))} ${o.position()}")
  _ = o.close()
  // A read of zero bytes, and at the end.
  val lines = dir + "/lines"
  _ = fs.writeText(lines, "alpha\nbeta\r\n\ngamma")
  val l = fs.open(lines).get()
  say(show(l.read(0)))
  say(show(l.read(3)))
  say(s"${l.readLine()} ${l.readLine()} ${l.readLine()} ${l.readLine()} ${l.readLine()} ${l.readLine()}")
  say(s"${l.position()} ${show(l.read(4))}")
  // Seeking: to the start again, to the middle, past the end, and a negative offset.
  say(l.seek(6))
  say(s"${l.position()} ${l.readLine()}")
  say(l.seek(1000))
  say(s"${l.position()} ${show(l.read(4))} ${l.readLine()} ${l.readText()}")
  say(l.seek(-1))
  say(l.seekToEnd())
  say(s"${l.position()} ${show(l.read(1))}")
  say(l.seek(0))
  say(l.readText())
  _ = l.close()
  // Text through a buffer: Unicode and a long line across the 8192-byte chunk.
  val uni = dir + "/uni"
  val wide = "é".repeat(5000) + "\n" + "✓".repeat(3000) + "\n😀x"
  _ = fs.writeText(uni, wide)
  val u = fs.open(uni).get()
  val a = u.readLine().get().get
  val b = u.readLine().get().get
  val c = u.readLine().get().get
  say(s"${a == "é".repeat(5000)} ${b == "✓".repeat(3000)} $c ${u.readLine()}")
  _ = u.close()
  // A character split across the buffer boundary: 8191 ASCII bytes, then a 3-byte character.
  _ = fs.writeText(uni, "a".repeat(8191) + "✓" + "\n")
  val s = fs.open(uni).get()
  say(s.readLine().get().get == "a".repeat(8191) + "✓")
  _ = s.close()
  _ = fs.writeText(uni, "a".repeat(8191) + "😀")
  val s2 = fs.open(uni).get()
  say(s2.readText().get() == "a".repeat(8191) + "😀")
  _ = s2.close()
  // Not UTF-8: text is an error with the offset, a line has U+FFFD.
  _ = fs.writeBytes(dir + "/bad", Array.tabulate(3, i -> if i == 2 then byte(0xff) else byte(65)))
  val bad = fs.open(dir + "/bad").get()
  say(bad.readText())
  _ = bad.seek(0)
  say(bad.readLine())
  _ = bad.close()
  // read(n) takes from what a line read ahead.
  val r = fs.open(lines).get()
  say(s"${r.readLine()} ${text(r.read(4).get())} ${r.position()} ${r.readLine()}")
  _ = r.close()
  // Writing: create empties, and the handle is write-only.
  val w = fs.create(dir + "/w").get()
  say(s"${w.writeText("hello ")} ${w.writeText("wörld")} ${w.write(Array.fill(1, byte(33)))}")
  say(s"${w.size()} ${w.position()} ${w.read(1)} ${w.readLine()} ${w.readText()}")
  say(w.close())
  say(fs.readText(dir + "/w"))
  val w2 = fs.create(dir + "/w").get()
  say(w2.close())
  say(fs.readText(dir + "/w"))
  // Write at a position: seek and overwrite, then a gap past the end.
  val up = fs.createUpdate(dir + "/up").get()
  _ = up.writeText("0123456789")
  _ = up.seek(2)
  _ = up.writeText("ab")
  say(s"${up.position()} ${up.size()}")
  _ = up.seek(0)
  say(up.readText())
  _ = up.seek(14)
  _ = up.writeText("Z")
  _ = up.seek(0)
  say(show(up.read(100)))
  // Read ahead then write: the write lands at the logical position.
  _ = up.seek(0)
  say(up.readLine())
  _ = up.seek(3)
  _ = up.read(2)
  _ = up.writeText("__")
  _ = up.seek(0)
  say(text(up.readAll().get()))
  _ = up.close()
  val ou = fs.openUpdate(dir + "/up").get()
  say(s"${ou.position()} ${ou.read(3).get().length}")
  _ = ou.close()
  // Reading a write-only file and writing a read-only one are errors, not empty answers.
  val ro = fs.open(dir + "/up").get()
  say(ro.writeText("x"))
  say(ro.flush())
  _ = ro.close()
  val wo = fs.create(dir + "/wo").get()
  say(wo.readLine())
  say(wo.readAll())
  say(show(wo.read(1)))
  _ = wo.close()
  // Append: two handles interleave, each write whole, at the end.
  val ap = dir + "/log"
  val a1 = fs.append(ap).get()
  val a2 = fs.append(ap).get()
  _ = a1.writeText("one\n")
  _ = a1.flush()
  _ = a2.writeText("two\n")
  _ = a2.flush()
  _ = a1.writeText("three\n")
  _ = a1.close()
  _ = a2.writeText("four\n")
  _ = a2.close()
  say(fs.readText(ap))
  _ = fs.appendText(ap, "five\n")
  val a3 = fs.append(ap).get()
  _ = a3.writeText("six\n")
  _ = a3.close()
  say(fs.readText(ap).get().split("\n").length)
  // A file followed while it grows: complete lines only, the half line waits.
  val follow = dir + "/follow"
  val writer = fs.create(follow).get()
  val reader = fs.open(follow).get()
  say(reader.readCompleteLine())
  _ = writer.writeText("first\nsec")
  _ = writer.flush()
  say(s"${reader.readCompleteLine()} ${reader.readCompleteLine()} ${reader.position()}")
  _ = writer.writeText("ond\nthird\n")
  _ = writer.flush()
  say(s"${reader.readCompleteLine()} ${reader.readCompleteLine()} ${reader.readCompleteLine()}")
  _ = writer.writeText("tail")
  _ = writer.flush()
  say(s"${reader.readCompleteLine()} ${reader.readLine()} ${reader.readLine()}")
  _ = writer.writeText("s\n")
  _ = writer.flush()
  say(show(reader.read(10)))
  say(s"${reader.size()} ${reader.position()}")
  // Starting a follow at the end of what is there.
  val late = fs.open(follow).get()
  _ = late.seekToEnd()
  _ = writer.writeText("new\n")
  _ = writer.flush()
  say(late.readCompleteLine())
  _ = late.close()
  _ = reader.close()
  _ = writer.close()
  // Closed handles: every call an Err, closing again fine.
  val k = fs.open(lines).get()
  say(s"${k.isClosed()} ${k.close()} ${k.isClosed()} ${k.close()}")
  say(s"${k.size()} ${k.position()} ${k.seek(0)} ${k.seekToEnd()}")
  say(s"${show(k.read(1))} ${show(k.readAll())} ${k.readText()} ${k.readLine()} ${k.readCompleteLine()}")
  say(s"${k.writeText("x")} ${k.write(Array.fill(1, byte(1)))} ${k.flush()}")
  val kw = fs.create(dir + "/kw").get()
  _ = kw.close()
  say(kw.writeText("x"))
  // Missing files and directories, in each way of opening.
  say(failure(fs.open(dir + "/missing")))
  say(failure(fs.openUpdate(dir + "/missing")))
  say(failure(fs.create(dir + "/no/such/dir/f")))
  say(failure(fs.append(dir + "/no/such/dir/f")))
  say(failure(fs.createUpdate(dir + "/no/such/dir/f")))
  say(fs.readBytesFrom(dir + "/missing", 0))
  say(fs.readTail(dir + "/missing", 5))
  say(fs.readTailLines(dir + "/missing", 5))
  // A directory is no file to open for reading data from.
  say(failure(fs.open(dir)))
  say(failure(fs.openUpdate(dir)))
  say(failure(fs.create(dir)))
  say(failure(fs.append(dir)))
  _ = fs.removeDirAll(dir)
