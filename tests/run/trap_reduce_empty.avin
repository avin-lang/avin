// expect: trap
// `reduce` of an empty collection traps where the program called it; `reduceOption` answers `None`.

main()
    val some: Vector[int] = [4, 5]
    print(some.reduce((a, b) -> a + b))
    val none: Vector[int] = []
    print(none.reduceOption((a, b) -> a + b).isNone())
    print(none.reduce((a, b) -> a + b))
