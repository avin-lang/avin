// expect: trap
// `reduce` of an empty collection traps where the program called it; `reduceOption` answers `None`.

main()
    val some: Vector[int] = [4, 5]
    println(some.reduce((a, b) -> a + b))
    val none: Vector[int] = []
    println(none.reduceOption((a, b) -> a + b).isEmpty)
    println(none.reduce((a, b) -> a + b))
