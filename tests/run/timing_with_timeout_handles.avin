// expect: exit 0
// The body of a `withTimeout` reaches the Sysl handles the calling code owns, a connection here: it
// writes to it, and the caller goes on using it after the body returns and after the body is stopped
// by its time; a thread the body's scope starts uses it too, and hands it back as a scope's thread
// does. A connection the body makes is the caller's after it.
import avin.io.IoError
import avin.net.{TcpListener, TcpStream}
import avin.threads.{sleep, withTimeout}
import avin.time.{hours, millis, seconds}

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

main()
  val l = ok(TcpListener.bind("127.0.0.1", 0))
  val c = ok(TcpStream.connect("127.0.0.1", l.port()))
  val s = ok(l.accept())
  println(withTimeout(seconds(30), sc -> ok(c.writeText("from the body\n"))))
  println(ok(s.readLine()))
  println(withTimeout(millis(30), sc ->
    ok(c.writeText("before the time ran out\n"))
    sleep(hours(1))
    ok(c.writeText("never\n"))))
  println(ok(s.readLine()))
  ok(c.writeText("after the timeout\n"))
  println(ok(s.readLine()))
  println(withTimeout(seconds(30), sc -> sc.spawn(() -> ok(c.writeText("from the scope's thread\n"))).join()))
  println(ok(s.readLine()))
  val made = withTimeout(seconds(30), sc -> ok(TcpStream.connect("127.0.0.1", l.port())))
  val other = ok(l.accept())
  made match
    Some(m) ->
      ok(m.writeText("made in the body\n"))
      println(ok(other.readLine()))
      ok(m.close())
    None -> println("none")
  ok(c.close())
