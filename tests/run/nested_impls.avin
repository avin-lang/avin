// An impl may add methods to any type built from its own parameters: a call matches its receiver's
// static type against that type and learns the parameters from it.
data Box[T](value: T)

data Pair[A, B](first: A, second: B)

// A box of a list, whatever the list holds.
impl[T] Box[List[T]]
    size() -> int = value.length

    firstOr(default: T) -> T = value match
        x :: _ -> x
        [] -> default

// Another impl adds a method of the same name to a box of an option: the receiver says which.
impl[T] Box[Option[T]]
    size() -> int = if value.isDefined() then 1 else 0

// Every box has `label`, and the nested impls call it as the box's own method.
impl[T] Box[T]
    label() -> string = "box"

impl[T] Box[Box[T]]
    unwrap() -> Box[T] = value

    describe() -> string = label() + " of " + value.label()

// Two parameters, one of them inside a type of its own.
impl[A, B] Pair[A, List[B]]
    count() -> int = second.length

    tagged() -> List[(A, B)] = second.map(b -> (first, b))

// A bound on a nested impl's parameter still applies.
impl[T: Ord] Box[List[T]]
    largest() -> Option[T] = value.maxOption

// An impl adding to a trait at a type built from its parameters: every holder of a holder, whatever
// class implements either.
trait Holder[+T]
    held() -> T

class Cell[+T](val v: T): Holder[T]
    override held() -> T = v

class Crate[+T](val items: List[T]): Holder[T]
    override held() -> T = items match
        x :: _ -> x
        [] -> fail("an empty crate")

impl[T] Holder[Holder[T]]
    inner() -> T = held().held()

// Only a class of a class: a holder of a cell is not one.
impl[T] Cell[Cell[T]]
    depth() -> int = 2

// A parameter named twice takes one type.
impl[T] Pair[T, T]
    same() -> bool = first == second

main()
    val three: List[int] = [3, 1, 2]
    val none: List[int] = []
    val listed = Box(three)
    println(listed.size())
    println(listed.firstOr(0))
    println(Box(none).firstOr(9))
    println(listed.largest())
    println(Box(Some("x")).size())
    val absent: Option[string] = None
    println(Box(absent).size())
    val nested = Box(Box(7))
    println(nested.unwrap().value)
    println(nested.describe())
    val two: List[int] = [1, 2]
    val p = Pair("k", two)
    println(p.count())
    for t in p.tagged()
        val (a, b) = t
        println(s"$a $b")
    val cells = Cell(Cell(5))
    println(cells.inner())
    println(cells.depth())
    val crates: List[Cell[string]] = [Cell("c")]
    println(Crate(crates).inner())
    // Through a trait-typed receiver.
    val held: Holder[Holder[int]] = Cell(Cell(6))
    println(held.inner())
    println(Pair(1, 1).same())
    println(Pair("a", "b").same())
