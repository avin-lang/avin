// expect: exit 0
// Eight threads run one `Once` at the same moment, a thousand times each: its body runs exactly once,
// and every thread that returns from `run` sees what the body did.
import avin.threads.{Atomic, Once, scope}

main() -> int
    val once = Once()
    val runs = Atomic(0)
    val config = Atomic("")
    val unseen = Atomic(0)
    println(once.isDone())
    scope(s ->
        for t in 0..<8
            s.spawn(() ->
                for i in 0..<1000
                    once.run(() ->
                        runs.add(1)
                        config.store(s"set by $t"))
                    if !config.load().startsWith("set by") then unseen.add(1)))
    println(runs.load())
    println(unseen.load())
    println(once.isDone())
    once.run(() -> runs.add(1))
    println(runs.load())
    0
