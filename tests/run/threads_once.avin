// expect: exit 0
// Eight threads run one `Once` at the same moment, a thousand times each: its body runs exactly once,
// and every thread that returns from `run` sees what the body did.
import avin.threads.{Atomic, Once, scope}

class Config()
    var name = ""

main() -> int
    val once = Once()
    val runs = Atomic(0)
    val config = Config()
    val unseen = Atomic(0)
    print(once.isDone())
    scope(s ->
        for t in 0..<8
            s.spawn(() ->
                for i in 0..<1000
                    once.run(() ->
                        runs.add(1)
                        config.name = s"set by $t")
                    if !config.name.startsWith("set by") then unseen.add(1)))
    print(runs.load())
    print(unseen.load())
    print(once.isDone())
    once.run(() -> runs.add(1))
    print(runs.load())
    0
