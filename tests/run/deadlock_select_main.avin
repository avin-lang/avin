// expect: trap
// The main thread alone in a `select` with no `after`, on two channels nothing will ever send to and
// a third that is full: no other thread exists, so the program is deadlocked at once, and the report
// says `main` waits in a select and on how many channels.
import avin.threads.Channel

main()
  val a = Channel[int]()
  val b = Channel[string]()
  val full = Channel[int](1)
  full.send(0)
  println("selecting")
  select
    a.receive() as Some(x) -> println(x)
    b.receive() -> println("b")
    full.send(1) -> println("sent")
  println("not reached")
