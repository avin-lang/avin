// expect: exit 0
// A computation that can fail yields a `Result`, and a future of one composes through its `Ok`
// values: `mapOk` and `flatMapOk` pass an `Err` through unchanged, and a body uses `?` on the results
// it awaits as any function does.
import avin.threads.Future

parse(s: string) -> Result[int, string] = s.toInt() match
    Some(n) -> Ok(n)
    None -> Err(s"not a number: $s")

fetch(s: string) -> Future[Result[int, string]] = Future.apply(parse(s))

halve(n: int) -> Future[Result[int, string]] = Future.apply(if n % 2 == 0 then Ok(n / 2) else Err(s"odd: $n"))

added(a: string, b: string) -> Result[int, string]
    val x = fetch(a).await()?
    val y = fetch(b).await()?
    Ok(x + y)

show(r: Result[int, string]) -> string = r match
    Ok(n) -> s"ok $n"
    Err(e) -> s"err $e"

main() -> int
    print(show(fetch("20").mapOk(n -> n + 1).await()))
    print(show(fetch("twenty").mapOk(n -> n + 1).await()))
    print(show(fetch("20").flatMapOk(halve).await()))
    print(show(fetch("21").flatMapOk(halve).await()))
    print(show(fetch("x").flatMapOk(halve).await()))
    print(show(Future.apply(added("40", "2")).await()))
    print(show(Future.apply(added("40", "two")).await()))
    0
