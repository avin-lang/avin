// expect: trap
// An `after` guarded off is absent too, so a select whose other arms are all guarded off as well has
// nothing to wait on, and traps.
import avin.threads.Channel
import avin.time.millis

main()
  val a = Channel[int]()
  var tries = 0
  while tries < 3
    println(select
      a.receive() if tries > 5 -> "received"
      after millis(1) if tries < 2 -> "timed out")
    tries += 1
