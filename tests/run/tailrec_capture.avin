// expect: exit 0
// A function that is a loop gives each pass its own parameters: a lambda made in one pass keeps that
// pass's values, a `var` declared in the body is a new one each pass, and a local function sees the
// parameters of the pass that calls it. Every allocation collects, so the references the loop keeps
// in its parameters between passes must be found by the collector.

@tailrec
collect(n: int, acc: Vector[() -> int]) -> Vector[() -> int] = if n == 0 then acc else collect(n - 1, acc :+ (() -> n * 10))

@tailrec
counters(n: int, acc: Vector[() -> int]) -> Vector[() -> int]
    if n == 0 then return acc
    var seen = n
    val bump = () ->
        seen += 1
        seen
    counters(n - 1, acc :+ bump)

@tailrec
labels(n: int, prefix: string, acc: string) -> string
    describe(x: int) -> string = s"$prefix$n.$x"
    if n == 0 then acc else labels(n - 1, prefix, acc + describe(n) + " ")

data Chain
    Link(head: string, tail: Chain)
    End

@tailrec
build(n: int, acc: Chain) -> Chain = if n == 0 then acc else build(n - 1, Link(s"item $n", acc))

@tailrec
joined(xs: Chain, acc: string) -> string = xs match
    Link(h, End) -> acc + h
    Link(h, t) -> joined(t, acc + h + ",")
    End -> acc

main() -> int
    val fs = collect(3, [])
    for f in fs
        println(f())
    val cs = counters(3, [])
    for c in cs
        println(c())
    println(cs(0)())
    println(labels(3, "p", ""))
    println(joined(build(5, End), ""))
    println(joined(build(500, End), "").byteLength)
    0
