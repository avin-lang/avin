// expect: trap
// A scope's threads are started while it is open: `s.spawn` on a scope that has returned traps.
import avin.threads.{Scope, scope, spawn}

main()
    var kept: Option[Scope] = None
    println(scope(s ->
        kept = Some(s)
        1))
    kept match
        Some(s) -> s.spawn(() -> println("never"))
        None -> ()
