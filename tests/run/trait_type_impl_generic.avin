// expect: exit 0
// An impl of a trait for a generic trait type names the trait type's parameters and may bound them:
// `Map[K, A]` conforms where its arguments meet the bounds. A field, a type argument and a nested
// type find it as they find any impl, and a static member of the trait is the trait type's too. An
// impl for an instance of the trait type holds of that instance.
trait Named
  name() -> string

trait Codec: Named
  encode() -> string
  static decode(text: string) -> Option[Self]

trait Key
  key() -> string

impl Key for string
  key() -> string = self

impl Key for int
  key() -> string = s"#$self"

impl Named for int
  name() -> string = "int"

impl Codec for int
  encode() -> string = s"$self"
  static decode(text: string) -> Option[int] = text.toIntOption()

impl[K: Key, A: Codec] Codec for Map[K, A]
  name() -> string = "map"
  encode() -> string
    var out = "{"
    for (k, v) in self
      out = out + k.key() + "=" + v.encode() + ";"
    out + "}"
  static decode(text: string) -> Option[Map[K, A]] = if text == "{}" then Some({}) else None

impl[K: Key, A: Codec] Codec for TreeMap[K, A]
  name() -> string = "tree"
  encode() -> string = s"tree of $size"
  static decode(text: string) -> Option[TreeMap[K, A]] = None

impl[A: Codec] Codec for Seq[A]
  name() -> string = "seq"
  encode() -> string
    var out = "["
    for v in self
      out = out + v.encode() + ","
    out + "]"
  static decode(text: string) -> Option[Seq[A]] = None

impl[A: Codec] Codec for Option[A]
  name() -> string = "option"
  encode() -> string = self match
    Some(x) -> "some " + x.encode()
    None -> "none"
  static decode(text: string) -> Option[Option[A]] = None

data Holder(byName: Map[string, int], rows: Seq[Map[int, int]], maybe: Option[Map[string, int]])

impl Codec for Holder
  name() -> string = "holder"
  encode() -> string = byName.encode() + rows.encode() + maybe.encode()
  static decode(text: string) -> Option[Holder] = None

trait Sized
  count() -> int

impl[A] Sized for Map[string, A]
  count() -> int = size

impl[A] Sized for Map[int, A]
  count() -> int = -size

// A static member's default body of a trait the impl's trait requires is the trait type's.
trait Origin
  static origin() -> string = "default"

trait Tagged: Origin
  tag() -> string

impl[K, A] Tagged for Map[K, A]
  tag() -> string = "map"

origin[T: Tagged](x: T) -> string = T.origin() + " " + x.tag()

enc[T: Codec](x: T) -> string = x.name() + ":" + x.encode()

dec[T: Codec](text: string) -> bool = T.decode(text) is Some(_)

counted[T: Sized](x: T) -> int = x.count()

main()
  val m: Map[string, int] = {"a": 1, "b": 2}
  val empty: Map[int, int] = {}
  val rows: Seq[Map[int, int]] = [{1: 2}, empty]
  println(enc(m))
  println(enc(empty))
  println(enc(rows))
  println(enc(Holder(m, rows, Some(m))))
  println(enc(Holder(m, rows, None)))
  // The implementing type's own impl is the one a value of that type has.
  val t = TreeMap(("a", 1))
  println(enc(t))
  val up: Map[string, int] = t
  println(enc(up))
  println(dec[Map[string, int]]("{}"))
  println(dec[Map[string, int]]("x"))
  println(dec[TreeMap[string, int]]("{}"))
  println(dec[int]("4"))
  println(counted(m))
  println(counted(empty))
  println(m.count())
  val byInt: Map[int, string] = {1: "é", 2: "b"}
  println(byInt.count())
  println(origin(m))
