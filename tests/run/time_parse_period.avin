// expect: exit 0
// `parsePeriod`: what `toIsoString()` writes reads back equal (`P1Y2M3D`, `P0D`, a sign on each
// negative part), over a sweep of months and days and at every `int` edge; the parts in the order
// years, months, days, at least one, years twelve months each; a part beyond an `int` out of range;
// and every refusal with its byte.
import avin.time.{Period, BadShape, OutOfRange, Trailing, months, years, parsePeriod}

main()
    println(parsePeriod("P1Y2M3D"))
    println(parsePeriod("P0D") == Ok(Period.Zero))
    println(parsePeriod("P-1Y-2M"))
    println(parsePeriod("P1M-3D"))
    println(parsePeriod("P14D"))
    println(parsePeriod("P1Y"))
    println(parsePeriod("P5M"))
    println(parsePeriod("P1Y3D"))
    println(parsePeriod("P-1Y2M") == Ok(Period(-10, 0)))
    // Forms `toIsoString()` does not write, read as their numbers say.
    println(parsePeriod("P12M") == Ok(years(1)))
    println(parsePeriod("P0Y") == Ok(Period.Zero))
    println(parsePeriod("P0Y0M0D") == Ok(Period.Zero))
    println(parsePeriod("P-0D") == Ok(Period.Zero))
    println(parsePeriod("P007D") == Ok(Period(0, 7)))
    println(parsePeriod("P25M") == Ok(months(25)))

    // The edges of an `int`, both parts.
    val least = Period(int.MinValue, int.MinValue)
    val greatest = Period(int.MaxValue, int.MaxValue)
    println(least.toIsoString)
    println(greatest.toIsoString)
    println(parsePeriod(least.toIsoString) == Ok(least))
    println(parsePeriod(greatest.toIsoString) == Ok(greatest))
    println(parsePeriod("P-178956970Y-9M"))
    println(parsePeriod("P178956970Y8M"))
    println(parsePeriod("P178956971Y"))
    println(parsePeriod("P2147483648M"))
    println(parsePeriod("P2147483648D"))
    println(parsePeriod("P-2147483649D"))
    println(parsePeriod("P2147483647M2147483647D") == Ok(greatest))
    println(parsePeriod("P99999999999999999999D"))
    println(parsePeriod("P99999999999999999999Y-99999999999999999999M"))
    println(parsePeriod("P99999999999D"))

    // Shapes.
    println(parsePeriod(""))
    println(parsePeriod("P"))
    println(parsePeriod("p1D"))
    println(parsePeriod("1D"))
    println(parsePeriod("-P1D"))
    println(parsePeriod("P1"))
    println(parsePeriod("P1X"))
    println(parsePeriod("P1d"))
    println(parsePeriod("P-"))
    println(parsePeriod("P-D"))
    println(parsePeriod("P--1D"))
    println(parsePeriod("P+1D"))
    println(parsePeriod("P1W"))
    println(parsePeriod("PT1H"))
    println(parsePeriod("P1M2Y"))
    println(parsePeriod("P1D2M"))
    println(parsePeriod("P1Y1Y"))
    println(parsePeriod("P1M1M"))
    println(parsePeriod("P1.5D"))
    println(parsePeriod("P1Y 2M"))
    println(parsePeriod("P٣D"))
    println(parsePeriod("P３D"))
    println(parsePeriod("1y 2mo 3d"))

    // Text left over.
    println(parsePeriod("P1D "))
    println(parsePeriod("P1DT"))
    println(parsePeriod("P1D2D"))
    println(parsePeriod("P2147483648DX"))

    println(parsePeriod("P1M2Y") == Err(BadShape("P1M2Y", 4, "'D'")))
    println(parsePeriod("P2147483648D") == Err(OutOfRange("P2147483648D", "days")))
    println(parsePeriod("P1D ") == Err(Trailing("P1D ", 3)))

    // Every period's ISO text reads back: a sweep of months and days of either sign.
    var failures = 0
    var checked = 0
    for m in -30 ..< 31
        for d in [-400, -31, -1, 0, 1, 7, 30, 31, 365]
            val p = Period(m * 13, d)
            if parsePeriod(p.toIsoString) != Ok(p) then failures += 1
            checked += 1
    for p in [Period(int.MinValue, 0), Period(0, int.MinValue), Period(int.MaxValue, 0), Period(0, int.MaxValue), Period(int.MinValue, int.MaxValue), Period(-12, 1), Period(12, -1), Period(-11, 0), Period(-13, -1)]
        if parsePeriod(p.toIsoString) != Ok(p) then failures += 1
        checked += 1
    println(s"$checked periods read back, $failures failures")
