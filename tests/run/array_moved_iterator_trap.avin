// expect: trap
// An iterator made before the move reads the array as it steps, so its next step after the move
// traps, at the loop that takes it.
import avin.actors.Isolated

main()
  val a = Array.tabulate[int](3, i -> i)
  val it = a.iterator()
  println(it.next())
  val moved = Isolated.move(a)
  while it.hasNext()
    println(it.next())
  println(moved.take().length)
