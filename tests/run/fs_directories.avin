// Directories through `avin.fs`, made and removed inside a temporary directory, and `IoError`s
// passed on by `?` and shown as values and as sentences.
import avin.fs
import avin.io.{IoError, Other}

// Copies one file to another, every failure on the way passed on by `?`.
copy(from: string, to: string) -> Result[int, IoError]
  val text = fs.readText(from)?
  fs.writeText(to, text)?
  Ok(text.byteLength)

// A file written into a directory made for it.
store(dir: string, name: string, text: string) -> Result[string, IoError]
  fs.createDirAll(dir)?
  val file = dir + "/" + name
  fs.writeText(file, text)?
  Ok(fs.readText(file)?)

// The temporary directory the test works in, written as `DIR` in what it prints, which an error
// names, so the output is the same on every run.
var root = ""

say(line: Any)
  println(if root == "" then s"$line" else s"$line".replace(root, "DIR"))

main()
  val dir = fs.createTempDir("avin-dirs") match
    Ok(d) -> d
    Err(e) ->
      say(s"no directory: $e")
      return
  root = dir
  // One level, then the same again, then one whose parent is missing.
  say(s"${fs.createDir(dir + "/a")} ${fs.createDir(dir + "/a")} ${fs.createDir(dir + "/x/y")}")
  // Every missing level made at once; a directory already there is no error.
  val deep = dir + "/a/b/c/d"
  say(s"${fs.createDirAll(deep)} ${fs.isDir(deep)} ${fs.createDirAll(deep)} ${fs.createDirAll(dir + "/a")}")
  // A file in the way of a directory.
  say(s"${fs.writeText(dir + "/file", "x")} ${fs.createDirAll(dir + "/file/sub")} ${fs.createDir(dir + "/file")}")
  // A directory that holds something is not removed by `removeDir`; an empty one is.
  say(s"${fs.removeDir(dir + "/a")} ${fs.removeDir(deep)} ${fs.isDir(deep)} ${fs.removeDir(deep)}")
  // `?` passes the first failure on, and the success through.
  say(copy(dir + "/file", dir + "/copy"))
  say(copy(dir + "/missing", dir + "/copy2"))
  say(s"${copy(dir + "/file", dir + "/nowhere/copy")} ${fs.exists(dir + "/copy2")}")
  say(store(dir + "/s/t", "u.txt", "stored"))
  say(store(dir + "/file/t", "u.txt", "stored"))
  // An error shown as a value and as a sentence.
  fs.readText(dir + "/missing") match
    Err(e) -> say(s"${e.kind}: ${e.message}")
    Ok(_) -> say("unexpected")
  fs.readText(dir) match
    Err(e) -> say(s"${e.kind}: ${e.message}")
    Ok(_) -> say("unexpected")
  val others: Vector[IoError] = [IoError(Other("disk on fire"))]
  for e in others do say(s"${e.kind}: ${e.message}")
  // Removing the whole tree, then removing it again, which finds nothing to do.
  say(s"${fs.removeDirAll(dir)} ${fs.exists(dir)} ${fs.removeDirAll(dir)}")
