// expect: exit 0
// The core library's methods for types built from others: `flatten` on an option of an option, on a
// result of a result and on a sequence of sequences, `toMap` on a collection of pairs, and `unzip` on
// a sequence of pairs. Each is found by matching the receiver's static type.
main()
    val some: Option[Option[int]] = Some(Some(1))
    val inner_none: Option[Option[int]] = Some(None)
    val none: Option[Option[int]] = None
    println(s"${some.flatten} ${inner_none.flatten} ${none.flatten}")
    val deep: Option[Option[Option[string]]] = Some(Some(Some("x")))
    println(deep.flatten.flatten)

    val ok: Result[Result[int, string], string] = Ok(Ok(2))
    val inner_err: Result[Result[int, string], string] = Ok(Err("inner"))
    val outer_err: Result[Result[int, string], string] = Err("outer")
    println(s"${ok.flatten} ${inner_err.flatten} ${outer_err.flatten}")

    val vv: Vector[Vector[int]] = [[1, 2], [], [3]]
    println(vv.flatten)
    val lists: List[List[string]] = [["a"], ["b", "c"]]
    println(lists.flatten)
    // A vector of lists is a sequence of sequences too, seen through its elements' trait.
    val mixed: Vector[List[int]] = [[4], [5, 6]]
    println(mixed.flatten)
    val seqs: Seq[Seq[int]] = [[7], [8]]
    println(seqs.flatten)

    val pairs: Vector[(string, int)] = [("a", 1), ("b", 2), ("a", 3)]
    val m = pairs.toMap
    println(s"${m.size} ${m("a")} ${m("b")}")
    val listed: List[(int, bool)] = [(1, true), (2, false)]
    println(listed.toMap.get(2))
    // A map is a collection of pairs, so it makes a map of its own entries.
    println(m.toMap == m)

    val (names, counts) = pairs.unzip
    println(s"$names $counts")
    val empty: List[(int, string)] = []
    val (xs, ys) = empty.unzip
    println(s"${xs.length} ${ys.length}")
