// expect: exit 0

// A collection literal checked on trial, as an argument while an overloaded method or function is
// chosen, leaves nothing open behind it once the trial is undone: its element type is settled by the
// call chosen, empty or not, nested or not, in a closure or not.

pick(a: Vector[long], b: Vector[long]) -> string = s"long ${a ++ b}"
pick(a: Vector[string], b: Vector[string]) -> string = s"string ${a ++ b}"

sizes(a: Set[int]) -> int = a.size
sizes(a: Vector[int]) -> int = a.length * 10

main()
  val v: Vector[long] = [1, 2]
  println(v ++ [400], v ++ [], v ++ [3_000_000_000])
  println(pick(v, [5]), pick(["a"], []), pick([], v))
  println(sizes({1, 2}), sizes([1, 2]))
  val s: Set[long] = {1}
  println((s ++ {400}).toVector.sorted, (s ++ [7]).toVector.sorted)
  val nested: Vector[Vector[long]] = [[1]]
  println(nested ++ [[5_000_000_000], []])
  val later = () -> v ++ [7, 8]
  println(later())
