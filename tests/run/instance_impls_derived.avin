// expect: exit 0
// A field of a type that implements a trait through an impl for its instance: a template walking the
// fields at their own types reaches `impl ToSql for Vector[byte]` for a `Vector[byte]` field, the
// generic `impl[T: ToSql] ToSql for Vector[T]` for a `Vector[int]` one, and both through an `Option`,
// in a data type, a generic one at the instance, and a class. The core library's derived traits still
// read each field as its own type does.

trait ToSql
  sql() -> string

impl ToSql for int
  sql() -> string = s"$self"

impl ToSql for string
  sql() -> string = s"'$self'"

impl ToSql for Vector[byte]
  sql() -> string = s"bytea(${length})"

impl[T: ToSql] ToSql for Vector[T]
  sql() -> string = "array[" + map(x -> x.sql()).mkString(", ") + "]"

impl[T: ToSql] ToSql for Option[T]
  sql() -> string = self match
    Some(v) -> v.sql()
    None -> "null"

derive ToSql for T
  sql() -> string = T.walk(self, Encoder("")).finish()

data Encoder(text: string)

impl ShapeVisitor for Encoder
  variant(v: VariantShape) -> Encoder = self

impl Encoder
  field[F: ToSql](f: FieldShape, value: F) -> Encoder =
    val sep = if text == "" then "(" else ", "
    Encoder(s"$text$sep${f.name} = ${value.sql()}")
  finish() -> string = text + ")"

data Row(id: int, data: Vector[byte], tags: Vector[int], blob: Option[Vector[byte]]) derives ToSql, Eq, Hash, Display

data Wrapped[A: ToSql](label: string, value: A) derives ToSql

class Upload(val name: string, val body: Vector[byte]) derives ToSql

main()
  val r = Row(1, "ab".bytes, [2, 3], None)
  println(r.sql())
  println(Row(2, [], [], Some("x".bytes)).sql())
  println(Wrapped("w", "xyz".bytes).sql())
  println(Wrapped("n", [1]).sql())
  println(Upload("f", "abcd".bytes).sql())
  println(r == Row(1, "ab".bytes, [2, 3], None))
  println(r.hash() == Row(1, "ab".bytes, [2, 3], None).hash())
  println(r)
