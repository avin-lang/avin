// expect: exit 0
// `named` changes only the name a handle's traps give it: the class is the same handle, its bound
// methods reach the same Sysl type, it is sendable and moves between threads, and `close()` given
// twice does nothing.
import avin.threads.spawn

@sysl("sysl.checksum.Crc32", named: "Checksum")
class Crc32
  update(bytes: Array[byte])
  finish() -> long

@sysl("sysl.checksum.new_crc32")
newCrc32() -> Crc32

carry[T: Sendable](value: T) -> T = value

main()
  val c = carry(newCrc32())
  c.update(Array.tabulate(9, i -> byte(49 + i)))
  println(c.finish())
  println(spawn(() -> c.finish()).join())
  println(c.finish())
  c.close()
  c.close()
