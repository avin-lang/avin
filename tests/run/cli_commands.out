ok: list all=false
ok: stats
stats work.txt true true
stats todo.txt false false
-- a value that looks like a command is the option's
stats list
list add
-- after `--`, the command; its own `--` is its own
ok: list all=false
ok: add low [] [x]
ok: add normal [] [-p, --tag]
-- commands of a command
ok: remote verbose=false add no command
ok: remote verbose=true remove no command
