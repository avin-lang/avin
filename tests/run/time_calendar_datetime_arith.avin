// expect: exit 0
// A reading moved along its own wall clock by a duration, and the duration between two readings:
// across midnight, a month's end, a leap day, a year's end and the epoch, by negative durations, by
// durations of whole days and of a microsecond, by the least and greatest durations, and to the
// least and greatest readings exactly. `a + (b - a) == b` over a sweep of pairs.
import avin.time.{Date, DateTime, Duration, dateTime, date, time, micros, seconds, minutes, hours, days, weeks}

main()
    val r = dateTime(2026, 12, 31, 23, 30)
    println(r + minutes(30))
    println(r + minutes(29))
    println(r + hours(1))
    println(r - hours(24))
    println(r + days(-365))
    println(r + micros(-1))
    println(dateTime(2026, 1, 1, 0, 0) - micros(1))
    println(dateTime(2024, 2, 28, 12, 0) + days(1))
    println(dateTime(2023, 2, 28, 12, 0) + days(1))
    println(dateTime(1900, 2, 28, 12, 0) + days(1))
    println(dateTime(2000, 2, 28, 12, 0) + days(1))
    println(dateTime(2100, 2, 28, 12, 0) + days(1))
    println(dateTime(1970, 1, 1, 0, 0) - seconds(1))
    println(dateTime(1970, 1, 1, 0, 0) + weeks(-1))
    println(dateTime(2026, 3, 8, 2, 30) + hours(1))
    println(r + Duration.Zero == r)
    println(r - Duration.Zero == r)
    println(r + hours(-2) == r - hours(2))

    // The duration between readings, either way round, across a year's end and the epoch.
    println(dateTime(2027, 1, 1, 0, 0) - r)
    println(r - dateTime(2027, 1, 1, 0, 0))
    println(dateTime(2026, 1, 1, 0, 0, 0, 1) - dateTime(2025, 12, 31, 23, 59, 59, 999999))
    println(dateTime(1970, 1, 1, 0, 0) - dateTime(1969, 12, 31, 12, 0))
    println(dateTime(2024, 3, 1, 0, 0) - dateTime(2024, 2, 28, 0, 0))
    println(dateTime(2023, 3, 1, 0, 0) - dateTime(2023, 2, 28, 0, 0))
    println(r - r)

    // The least and greatest durations from the epoch's reading, and back.
    val epoch = dateTime(1970, 1, 1, 0, 0)
    println(epoch + Duration.Max)
    println(epoch + Duration.Min)
    println(epoch - Duration.Max)
    println(epoch - Duration.Min)
    println((epoch + Duration.Max) - epoch == Duration.Max)
    println((epoch + Duration.Min) - epoch == Duration.Min)
    println(epoch + Duration.Max - Duration.Max == epoch)
    println(epoch + Duration.Min - Duration.Min == epoch)

    // Readings far beyond the instants' range still move, and reach the bounds exactly.
    println(DateTime.Max - micros(1))
    println(DateTime.Min + micros(1))
    println(DateTime.Max - days(1) + days(1) == DateTime.Max)
    println(DateTime.Min + Duration.Max)
    println(DateTime.Max - Duration.Max)
    println(dateTime(2026, 8, 28, 0, 0).date.atTime(time(12, 0)) + hours(12))

    // a + (b - a) == b and (a - d) + d == a over pairs a year apart in steps of 997 hours and a few
    // microseconds, and the order agrees with the sign of the difference.
    val a = dateTime(2023, 12, 31, 22, 15, 7, 1)
    var b = dateTime(2023, 6, 1, 0, 0)
    var faults = 0
    var checked = 0
    while b < dateTime(2025, 6, 1, 0, 0)
        val d = b - a
        if a + d != b || b - d != a || (a < b) != (d > Duration.Zero) then faults += 1
        checked += 1
        b = b + hours(997) + micros(13)
    println(s"faults $faults of $checked")
