// expect: exit 0
// Classes and other values inside one another: a class holding data values and other objects, an
// object inside a data value and a tuple, objects passed to and returned from functions and
// lambdas, a class with no fields, and a class used as a function value through its constructor.

data Point(x: int, y: int)

data Tagged(label: string, item: Cell)

class Cell(var value: int)
    bump() = value++

class Line(val start: Point, val end: Point, val owner: Cell)
    length2() -> int
        val dx = end.x - start.x
        val dy = end.y - start.y
        dx * dx + dy * dy

class Token()
    describe() -> string = "token"

class Tree(val value: int, val left: Option[Tree], val right: Option[Tree])
    sum() -> int = value + total(left) + total(right)

    private total(t: Option[Tree]) -> int = t match
        Some(child) -> child.sum()
        None -> 0

data Option[+T]
    Some(value: T)
    None

build(depth: int, next: Cell) -> Tree
    next.bump()
    if depth == 0 then Tree(next.value, None, None)
    else Tree(next.value, Some(build(depth - 1, next)), Some(build(depth - 1, next)))

swapCells(pair: (Cell, Cell)) -> (Cell, Cell) = (pair.1, pair.0)

main() -> int
    val shared = Cell(1)
    val line = Line(Point(0, 0), Point(3, 4), shared)
    if line.length2() != 25 then return 1
    line.owner.bump()
    if shared.value != 2 then return 2
    val tagged = Tagged("t", shared)
    tagged.item.value = 10
    if shared.value != 10 then return 3
    val (a, b) = swapCells((Cell(1), Cell(2)))
    if a.value != 2 || b.value != 1 then return 4
    if Token() === Token() then return 5
    print(Token().describe())
    val make = Cell
    val made = make(7)
    if made.value != 7 then return 6
    val apply = (c: Cell) -> c.value * 2
    if apply(made) != 14 then return 7
    // Enough objects that collections run while the tree is half built.
    val tree = build(10, Cell(0))
    print(s"${tree.sum()}")
    0
