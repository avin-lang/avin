// expect: exit 0
// env: AVIN_GC_STRESS=0
// A list of a million elements is built, mapped, filtered, folded from both ends, joined, reversed,
// compared, hashed and traversed: every method works in a loop, so no length deepens the stack.

main()
    var xs: List[int] = []
    var i = 1000000
    while i > 0
        xs = i :: xs
        i -= 1
    println(xs.length)
    val doubled = xs.map(x -> long(x) * 2)
    println(doubled.foldLeft(long(0), (acc, x) -> acc + x))
    println(xs.foldRight(long(0), (x, acc) -> acc + long(x)))
    val reversed = xs.reverse
    println(s"${reversed.head} ${reversed.last}")
    val evens = xs.filter(x -> x % 2 == 0)
    println(evens.length)
    val joined = xs ++ xs
    println(joined.length)
    println(xs.flatMap(x -> x :: []).length)
    println(xs.take(999999).length + xs.drop(999999).length)
    println(s"${xs(999999)} ${xs.exists(x -> x == 1000000)} ${xs.forall(x -> x > 0)}")
    println(xs == reversed.reverse)
    println(xs.hash() == reversed.reverse.hash())
    println(xs < reversed)
    var total: long = 0
    for x in xs do total += long(x)
    println(total)
    println(xs.toArray().length)
