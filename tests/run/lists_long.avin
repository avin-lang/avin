// expect: exit 0
// env: AVIN_GC_STRESS=0
// A list of a million elements is built, mapped, filtered, folded from both ends, joined, reversed,
// compared, hashed and traversed: every method works in a loop, so no length deepens the stack.

main()
    var xs: List[int] = []
    var i = 1000000
    while i > 0
        xs = i :: xs
        i -= 1
    print(xs.length())
    val doubled = xs.map(x -> long(x) * 2)
    print(doubled.foldLeft(long(0), (acc, x) -> acc + x))
    print(xs.foldRight(long(0), (x, acc) -> acc + long(x)))
    val reversed = xs.reverse()
    print(s"${reversed.head()} ${reversed.last()}")
    val evens = xs.filter(x -> x % 2 == 0)
    print(evens.length())
    val joined = xs ++ xs
    print(joined.length())
    print(xs.flatMap(x -> x :: []).length())
    print(xs.take(999999).length() + xs.drop(999999).length())
    print(s"${xs(999999)} ${xs.exists(x -> x == 1000000)} ${xs.forall(x -> x > 0)}")
    print(xs == reversed.reverse())
    print(xs.hash() == reversed.reverse().hash())
    print(xs < reversed)
    var total: long = 0
    for x in xs do total += long(x)
    print(total)
    print(xs.toArray().length())
