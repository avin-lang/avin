// expect: trap
// A decompression limit of zero takes an empty stream only; one below zero traps where it is given.
import avin.compress.{decompress, gzip}

main()
  println(decompress(gzip("".utf8), maxBytes = 0).map(b -> b.length))
  println(decompress(gzip("a".utf8), maxBytes = 0).isErr)
  println(decompress(gzip("a".utf8), maxBytes = -1).isErr)
