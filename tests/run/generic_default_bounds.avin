// expect: exit 0
// A default argument of a generic function sees the bounds of the function's type parameters, as
// its body does: an `Integer` default converts with `T(…)` and names `T.MaxValue`, and an `Ord`
// default compares the parameters before it.

offset[T: Integer](x: T, by: T = T(1)) -> T = x + by
top[T: Integer](x: T, limit: T = T.MaxValue - T(1)) -> bool = x < limit
larger[T: Ord](a: T, b: T, pick: T = if a < b then b else a) -> T = pick
named[T: Display](x: T, label: string = x.toString()) -> string = s"[$label]"

// A method's default sees its class's bound and its own.
class Meter[T: Integer](start: T)
  room(cap: T = T.MaxValue) -> T = cap - start
  scaled[U: Integer](by: U, cap: U = U.MaxValue) -> long = long(by) * long(cap)

main()
  val b: i8 = 7
  println(s"${offset(5)} ${offset(b)} ${offset(long(5), long(10))}")
  println(s"${top(b)} ${top(i8(126))} ${top(i8(125))} ${top(int.MaxValue)}")
  println(s"${larger(3, 9)} ${larger("b", "a")} ${larger(1, 2, 0)}")
  println(s"${named(42)} ${named("x", "y")}")
  val m = Meter(i8(100))
  println(s"${m.room()} ${m.room(i8(110))} ${m.scaled(i2(1))} ${m.scaled(3, 2)}")
  // A local generic function's default, inside a lambda.
  val f = (n: int) ->
    inner[V: Integer](v: V, hi: V = V.MinValue) -> string = s"$v $hi"
    inner(i16(n))
  println(f(4))
