// expect: exit 0
// The base a `with` holds while its values are computed stays alive across the allocations those
// values make, at every depth: under collection at every allocation, each new value is checked
// against the one it was made from. The values allocate (strings, vectors, nested data) and a
// value's own computation makes further `with` updates.

data Inner(tag: string, items: Vector[int])

data Middle(inner: Inner, label: string)

data Outer(middle: Middle, extra: Vector[string], n: int)

fresh(i: int) -> string = s"v$i-${i % 5}"

main() -> int
    var o = Outer(Middle(Inner("t", []), "m"), [], 0)
    var kept: Vector[Outer] = []
    for i in 0..<300
        val before = o
        o = o with {
            middle.inner.items = o.middle.inner.items :+ i,
            middle.inner.tag = fresh(i),
            extra = (o with { n = i * 2 }).extra :+ fresh(i + 1),
            n = o.n + 1,
        }
        if before.n != i then return 1
        if o.middle.inner.items.length != i + 1 then return 2
        if o.middle.label != "m" then return 3
        kept = kept :+ before
    println(o.n)
    println(o.middle.inner.tag)
    println(o.middle.inner.items(299))
    println(o.extra(299))
    println(kept(150).middle.inner.items.length)
    println(kept(150).extra.length)
    0
