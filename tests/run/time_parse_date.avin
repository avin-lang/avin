// expect: exit 0
// `parseDate`: `YYYY-MM-DD`, a sign and more digits for a year outside 0 to 9999, the least and
// greatest dates, the leap days the calendar has and the ones it does not, every refusal with the
// byte or the field it names, and every display reading back equal over a sweep from year -1 to 10000.
import avin.time.{Date, TimeParseError, BadShape, OutOfRange, Trailing, date, parseDate}

main()
  // The accepted forms.
  println(parseDate("2026-03-08"))
  println(parseDate("0000-01-01"))
  println(parseDate("9999-12-31"))
  println(parseDate("+10000-01-01"))
  println(parseDate("-0001-12-31"))
  println(parseDate("+2026-03-08"))
  println(parseDate("-0000-01-01"))
  println(parseDate("+0000-01-01") == Ok(date(0, 1, 1)))
  println(parseDate("1970-01-01") == Ok(Date(0)))

  // The least and greatest dates, and one day past each.
  println(parseDate(s"${Date.Min}") == Ok(Date.Min))
  println(parseDate(s"${Date.Max}") == Ok(Date.Max))
  println(parseDate("-5877641-06-22"))
  println(parseDate("+5881580-07-12"))
  println(parseDate("-5877642-01-01"))
  println(parseDate("+5881581-01-01"))
  println(parseDate("+999999999999999999999-01-01"))
  println(parseDate("-999999999999999999999-01-01"))

  // Leap days: every fourth year, not every hundredth, every four hundredth, and year 0.
  println(parseDate("2024-02-29"))
  println(parseDate("2000-02-29"))
  println(parseDate("0000-02-29"))
  println(parseDate("-0004-02-29"))
  println(parseDate("2023-02-29"))
  println(parseDate("1900-02-29"))
  println(parseDate("-0001-02-29"))
  println(parseDate("2026-02-28"))
  println(parseDate("2026-04-31"))
  println(parseDate("2026-12-31"))

  // Out of range: the month, then the day.
  println(parseDate("2026-13-01"))
  println(parseDate("2026-00-01"))
  println(parseDate("2026-01-00"))
  println(parseDate("2026-01-32"))
  println(parseDate("2026-02-30"))
  println(parseDate("2026-99-99"))

  // Shapes.
  println(parseDate(""))
  println(parseDate("2026"))
  println(parseDate("2026-"))
  println(parseDate("2026-03"))
  println(parseDate("2026-03-"))
  println(parseDate("2026-03-0"))
  println(parseDate("2026/03/08"))
  println(parseDate("2026-3-08"))
  println(parseDate("2026-03-8"))
  println(parseDate("26-03-08"))
  println(parseDate("20260-03-08"))
  println(parseDate("+999-01-01"))
  println(parseDate("-"))
  println(parseDate("+-2026-01-01"))
  println(parseDate(" 2026-03-08"))
  println(parseDate("20260308"))

  // Text after a whole date.
  println(parseDate("2026-03-08T"))
  println(parseDate("2026-03-08 "))
  println(parseDate("2026-03-08T09:30"))
  println(parseDate("2026-03-088"))
  println(parseDate("2026-02-30x"))

  // Digits are ASCII only: Arabic-Indic and full-width digits, and a non-ASCII letter.
  println(parseDate("٢٠٢٦-03-08"))
  println(parseDate("2026-٠٣-08"))
  println(parseDate("２０２６-03-08"))
  println(parseDate("2026-03-0８"))
  println(parseDate("2026-03-08é"))

  // The error values themselves, and their messages.
  println(parseDate("2026/03/08") == Err(BadShape("2026/03/08", 4, "'-'")))
  println(parseDate("2026-02-30") == Err(OutOfRange("2026-02-30", "day")))
  println(parseDate("2026-03-08T") == Err(Trailing("2026-03-08T", 10)))
  parseDate("2026-13-01") match
    Ok(_) -> println("no")
    Err(e) -> println(s"[${e.message}] [$e]")
  val e: TimeParseError = OutOfRange("x", "month")
  println(f"|$e%-40s|")

  // Every day of a leap year, a common year, year 0 and year -1 reads back.
  var failures = 0
  var checked = 0
  for start in [date(2024, 1, 1), date(2023, 1, 1), date(0, 1, 1), date(-1, 1, 1), date(9999, 1, 1)]
    var d = start.epochDay
    while d < start.epochDay + start.daysInYear
      val day = Date(d)
      if parseDate(s"$day") != Ok(day) then failures += 1
      checked += 1
      d += 1
  // And a sweep of days from year -1 to 10000.
  var d = date(-1, 1, 1).epochDay
  while d <= date(10000, 12, 31).epochDay
    val day = Date(d)
    if parseDate(s"$day") != Ok(day) then failures += 1
    checked += 1
    d += 997
  println(s"$checked dates read back, $failures failures")
