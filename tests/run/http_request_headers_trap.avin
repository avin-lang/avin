// expect: trap
// A header given to `Request`'s constructor is checked as one added by `withHeader` is, so a value
// holding a line break, which would begin a header of its own, traps as the request is made.
import avin.net.http.Request

main()
  println(Request("GET", "http://example.com/", [("X-Ok", "fine"), ("X-Empty", "")]).headers)
  println(Request("GET", "http://example.com/", [("X-Ok", "fine"), ("X-Bad", "a\r\nInjected: yes")]).headers)
