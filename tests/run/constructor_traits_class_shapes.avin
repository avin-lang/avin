// expect: exit 0
// Constructor traits met by the shapes the standard collections have. A method with a constructor
// parameter of its own, `traverse[G[_]: Pointed, B]`, meets the trait's, the trait's `G` deciding
// its `G`. An abstract class conforms while its subclasses override its abstract methods: the
// conformance is the abstract class's own, never a subclass's. And a class's own method of a name a
// constructor trait declares is the one a call names, so a call on the class answers what it always
// did, even where the trait's declaration would fit the arguments more closely.
trait Pointed[A]
  static pure[X](value: X) -> Self[X]
  map[B](f: (A) -> B) -> Self[B]
  map2[B, C](other: Self[B], f: (A, B) -> C) -> Self[C]

trait Chain[A]: Pointed[A]
  flatMap[B](f: (A) -> Self[B]) -> Self[B]
  override map[B](f: (A) -> B) -> Self[B] = flatMap(a -> Self.pure(f(a)))
  override map2[B, C](other: Self[B], f: (A, B) -> C) -> Self[C] =
    flatMap(a -> other.map(b -> f(a, b)))

trait Walk[A]
  traverse[G[_]: Pointed, B](f: (A) -> G[B]) -> G[Self[B]]

data Maybe[T]
  Just(value: T)
  Nope

impl Chain for Maybe
  static pure[X](value: X) -> Maybe[X] = Just(value)
  flatMap[B](f: (T) -> Maybe[B]) -> Maybe[B] = self match
    Just(v) -> f(v)
    Nope -> Nope

// A constructor parameter of the impl's own method, decided by the trait's.
impl Walk for Maybe
  traverse[G[_]: Pointed, B](f: (T) -> G[B]) -> G[Maybe[B]] = self match
    Just(v) -> f(v).map(b -> Just(b))
    Nope -> G.pure(Nope)

trait Coll[+T]
  first() -> T

// A final class whose own `flatMap` takes the wider `Coll`, as a collection's takes an `Iterable`.
class Bag[+T](val item: T): Coll[T]
  override first() -> T = item

impl[T] Bag[T]
  flatMap[U](f: (T) -> Coll[U]) -> Bag[U] = Bag(f(item).first())
  flatMap[U](f: (T) -> Option[U]) -> Bag[U] = Bag(f(item).get)

impl Chain for Bag
  static pure[X](value: X) -> Bag[X] = Bag(value)

// An abstract class whose methods its subclasses implement.
abstract class Line[+T]: Coll[T]
  map[U](f: (T) -> U) -> Line[U]
  flatMap[U](f: (T) -> Coll[U]) -> Line[U]
  size() -> int

class Point[+T](val at: T): Line[T]
  override first() -> T = at
  override map[U](f: (T) -> U) -> Line[U] = Point(f(at))
  override flatMap[U](f: (T) -> Coll[U]) -> Line[U] = Point(f(at).first())
  override size() -> int = 1

class Gap[+T](val fill: T): Line[T]
  override first() -> T = fill
  override map[U](f: (T) -> U) -> Line[U] = Gap(f(fill))
  override flatMap[U](f: (T) -> Coll[U]) -> Line[U] = Gap(f(fill).first())
  override size() -> int = 0

impl Chain for Line
  static pure[X](value: X) -> Line[X] = Point(value)

// An open class conforming itself, whose subclass inherits its methods and the trait's defaults.
open class Crate[T](val item: T): Chain[T]
  static pure[X](value: X) -> Crate[X] = Crate(value)
  flatMap[B](f: (T) -> Crate[B]) -> Crate[B] = f(item)

class Labelled[T](item: T, val label: string): Crate[T](item)

incr[F[_]: Pointed](x: F[int]) -> F[int] = x.map(n -> n + 1)
paired[F[_]: Chain](x: F[int], y: F[string]) -> F[(int, string)] = x.flatMap(a -> y.map(b -> (a, b)))
walked[F[_]: Walk](x: F[int]) -> Maybe[F[int]] = x.traverse(n -> if n > 0 then Just(n) else Nope)

kind(x: Any) -> string = x match
  _: Bag[int] -> "Bag[int]"
  _: Point[int] -> "Point[int]"
  _: Gap[int] -> "Gap[int]"
  _: Line[int] -> "Line[int]"
  _ -> "other"

main()
  // The impl's `traverse`, called on the type and through the bound.
  println(Just(3).traverse(n -> Just(s"#$n")))
  println(Just(-1).traverse(n -> if n > 0 then Just(n) else Nope))
  val nope: Maybe[int] = Nope
  println(nope.traverse(n -> Just(n)))
  println(walked(Just(4)))
  println(walked(Just(0)))
  println(Just(5).traverse(n -> Bag(n * 2)).item)
  // The class's own `flatMap`, with a function giving the class itself, the trait's narrower type.
  val b: Bag[int] = Bag(1)
  println(b.flatMap(a -> Bag(a + 1)).item)
  println(Bag("é").flatMap(s -> Bag(s + s)).item)
  println(b.flatMap(a -> Some(a * 7)).item)
  println(kind(b.flatMap(a -> Bag(a))))
  println(b.map(a -> a * 3).item)
  println(b.map2(Bag(10), (x, y) -> x + y).item)
  println(incr(b).item)
  println(paired(b, Bag("one")).item)
  // An abstract class conforming, its subclasses overriding what it declares.
  val p: Line[int] = Point(7)
  val g: Line[int] = Gap(int.MaxValue - 1)
  println(incr(p).first(), kind(incr(p)))
  println(incr(g).first(), kind(incr(g)))
  println(paired(g, Line.pure("x")).first())
  println(p.flatMap(a -> Point(a * 2)).first(), kind(p.flatMap(a -> Gap(a))))
  println(p.map2(g, (x, y) -> x < y).first())
  println(Line.pure(()).size(), g.size())
  // The defaults through the table of an open class, on its own object and a subclass's.
  val crates: Vector[Crate[int]] = [Crate(1), Labelled(2, "two")]
  for x in crates
    println(x.map(n -> n * 10).item, x.map2(Crate("c"), (n, s) -> s"$s$n").item, incr(x).item)
  println(paired(Labelled(3, "three"), Crate.pure("p")).item)
