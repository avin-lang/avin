// expect: exit 0
// A wait group counts work, not threads: pieces added in one go or one at a time, finished by threads
// a scope started or by the waiting thread itself, and waited for by several threads at once. A wait
// at zero returns at once, a timed wait answers whether the count reached zero, and every `done`
// happens before the `wait` it lets return.
import avin.threads.{Atomic, WaitGroup, scope, spawn}
import avin.time

main()
  val none = WaitGroup()
  none.wait()
  println(s"zero ${none.pending()} ${none.waitFor(0)} ${none.waitFor(time.millis(5))}")

  // Threads started through a scope, each finishing a piece; the body waits before the scope ends.
  val group = WaitGroup()
  val sum = Atomic(0)
  group.add(100)
  scope(s ->
    for i in 1 .. 100
      s.spawn(() ->
        sum.add(i)
        group.done())
    group.wait()
    println(s"sum ${sum.load()} pending ${group.pending()}"))

  // Several waiters at once, all woken when the count reaches zero.
  val gate = WaitGroup()
  gate.add(1)
  val woke = Atomic(0)
  val waiters = (0 ..< 8).map(_ -> spawn(() ->
    gate.wait()
    woke.add(1))).toVector
  println(s"timed out ${gate.waitFor(time.millis(20))}")
  gate.done()
  for w in waiters do w.join()
  println(s"woke ${woke.load()}")

  // A count raised and lowered from the same thread, and reused once it is back at zero.
  val reused = WaitGroup()
  for round in 0 ..< 3
    reused.add(2)
    reused.add(-1)
    println(s"round $round pending ${reused.pending()}")
    reused.done()
    reused.wait()
  reused.add(0)
  println(s"reached ${reused.waitFor(1000)}")
