// Reals: IEEE results at the edges (signed zero, infinities, NaN, the smallest and largest
// magnitudes), comparisons, matches on literals, updates, conversions to and from integers of many
// widths, and operations that round separately rather than fusing.

arithmetic(a: real, b: real)
    println(a + b, a - b, a * b, a / b, a % b, -a, +a)
    println(a == b, a != b, a < b, a <= b, a > b, a >= b, 0 <= a < b, debug(a))

classify(x: real) -> int = x match
    0.0 -> 1
    1.5 -> 2
    2 -> 3
    else 0

compute(a: real, b: real, c: real) = a * b + c

to_integers(x: real)
    println(i1(x), i2(x), i5(x), i8(x), i17(x), i24(x), int(x), i64(x), i65(x), i128(x))

main()
    arithmetic(0.0, 0.0)
    arithmetic(-0.0, 0.0)
    arithmetic(1.5, -2.25)
    arithmetic(1e308, -1e308)
    arithmetic(5e-324, 2.0)
    arithmetic(1.0000000000000002, 1.0000000000000004)
    val zero = 0.0
    arithmetic(zero / zero, 1.0)
    arithmetic(1.0 / zero, -1.0 / zero)
    var n: real = 1
    println(n +:= 1)
    println(n)
    n *= 0.25
    println(n -:= 1)
    println(1 + 0.5, 1 < 2.5)
    println(classify(-0.0), classify(1.5), classify(2.0), classify(zero / zero))
    println(if true then 0.25 else 0.5)
    val loop_value: real = while false do println(99) else 1.25
    println(loop_value)
    // Multiplication and addition round one after the other.
    println(compute(1.0000000000000002, 0.9999999999999998, -1.0) == 0.0)

    // Reals truncate toward zero and saturate at each width's limits; NaN is zero.
    for x in [0.0, -0.0, 3.99, -3.99, 128.0, -129.0, 1e100, -1e100]
        to_integers(x)
    to_integers(zero / zero)
    to_integers(1.0 / zero)
    to_integers(-1.0 / zero)
    // Integers convert to the nearest real.
    println(real(i8(127)), real(-2147483647 - 1), real(i64(9223372036854775807)))
    println(real(i65(9007199254740993)), real(i65(9007199254740995)), real(i128(-9007199254740995)))
