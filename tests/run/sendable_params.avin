// expect: exit 0
// A `@sendable` parameter is sendable inside its function whatever its type, since what is passed
// for it was checked where it was passed. So a `@sendable` partial function is captured by a
// `@sendable` lambda and passed on, unchecked, for another `@sendable` parameter, through chains of
// any length and through generic functions and methods. What may be passed for one is a `match`
// function written in place, whose arms may use `val`s and sendable values from around them, a value
// of a sendable type, or another parameter so marked. A lambda or a `match` function passed for a
// type argument bounded by `Sendable` is a `@sendable` function, as one passed for a `@sendable`
// function type is.
import avin.threads.spawn

data Rule[T](run: @sendable (char) -> Option[T])

pick[U](@sendable f: PartialFunction[char, U]) -> Rule[U] = Rule(c -> if f.isDefinedAt(c) then Some(f(c)) else None)

pick2[U](@sendable f: PartialFunction[char, U]) -> Rule[U] = pick(f)

pick3[U](@sendable f: PartialFunction[char, U]) -> Rule[U] = pick2(f)

// Captured by a lambda that passes it on from inside.
later[U](@sendable f: PartialFunction[char, U]) -> @sendable () -> Rule[U] = () -> pick(f)

// Two marked parameters, one passed on for each of another function's.
either[U](@sendable f: PartialFunction[char, U], @sendable g: PartialFunction[char, U]) -> Rule[U] =
  val a = pick(f)
  val b = pick(g)
  Rule(c -> a.run(c).orElse(b.run(c)))

// A marked parameter of a type parameter's type, of no bound, holds a value checked to be sendable.
held[T](@sendable value: T) -> @sendable () -> T = () -> value

class Digits(@sendable f: PartialFunction[char, int])
  rule() -> Rule[int] = pick(f)

// A class whose fields are `val`s of sendable types is sendable, and so passes as itself.
class Vowel(val bonus: int): PartialFunction[char, int]
  override isDefinedAt(c: char) -> bool = c == 'a' || c == 'e' || c == 'é'

  override lift() -> char -> Option[int] = c -> if isDefinedAt(c) then Some(int(c) - int('a') + bonus) else None

take[U: Sendable](value: U) -> U = value

class Box[+T](val v: T)
  ^^^[U: Sendable](value: U) -> Box[U] = Box(value)

show[T: Display](r: Rule[T], text: string) -> string
  var out = ""
  for c in text.chars
    out = out + (r.run(c) match
      Some(x) -> s"$x "
      None -> "- ")
  out

main() =
  val offset = 10
  val digit = pick(match c if '0' <= c <= '9' -> int(c) - int('0') + offset)
  println(show(digit, "a1z9"))
  println(show(pick2(match 'x' -> "ex"), "xyx"))
  val names = Vector("zero", "one")
  val named = pick(match c if '0' <= c <= '1' -> names(int(c) - int('0')))
  println(spawn(() -> show(named, "01x")).join())
  println(show(pick3(match
    'é' -> "acute"
    'ü' -> "umlaut"), "éuü"))
  println(show(later(match 'q' -> 1)(), "qq"))
  println(show(either(match 'a' -> 1, match 'b' -> 2), "abc"))
  println(show(Digits(match '7' -> 7).rule(), "76"))
  println(show(pick(Vowel(100)), "aeéi"))
  // A `match` that matches nothing but its wildcard, and one that matches nothing at all.
  println(show(pick(match _ -> 0), "ab"))
  println(show(pick(match c if c > 'z' -> 1), "ab"))
  // The rules run on other threads.
  val r = pick3(match c if 'a' <= c <= 'z' -> int(c) - int('a'))
  println(spawn(() -> show(r, "abz!")).join())
  println(spawn(held(Vector(1, 2, 3))).join())
  // A lambda and a `match` function passed for a type argument bounded by `Sendable`.
  val ok = 5
  val add = take((x: int) -> x + ok)
  println(spawn(() -> add(1)).join())
  val plain: (int) -> int = take(match
    n if n < 0 -> -n
    n -> n)
  println(plain(-3), plain(4))
  val op: Box[(int, int) -> int] = Box(0) ^^^ ((a, b) -> a * b)
  println(op.v(6, 7))
  val sum = Box(0) ^^^ ((a: int, b: int) -> a + b + ok)
  println(spawn(() -> sum.v(1, 2)).join())
