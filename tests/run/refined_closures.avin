// expect: exit 0
// A variant's own parameters are fresh types of each pattern: two `Pair` patterns, nested or one
// after the other, give two sets. Code made in an arm, a lambda or a local function, is compiled at
// each copy with what the value matched says those types are, also when it is called after the arm.
// A `T` an arm makes an `int` has `int`'s traits there, so it sorts and compares.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  BoolLit(value: bool) -> Expr[bool]
  Pair[A, B](first: Expr[A], second: Expr[B]) -> Expr[(A, B)]

eval[T](e: Expr[T]) -> T
eval(IntLit(n)) = n
eval(BoolLit(b)) = b
eval(Pair(a, b)) = (eval(a), eval(b))

// A lambda made in the `Pair` arm names the arm's fresh types and is called after the `match`.
later[T](e: Expr[T]) -> () -> T = e match
  IntLit(n) -> () -> n + 1
  BoolLit(b) -> () -> !b
  Pair(a, b) -> () -> (eval(a), eval(b))

// Local functions declared in an arm: one that names the arm's fresh types through what it
// captures, and a generic one called at them.
again[T](e: Expr[T]) -> T = e match
  Pair(a, b) ->
    pair() -> T = (eval(a), eval(b))
    go[X](x: Expr[X]) -> X = eval(x)
    val made = pair()
    if made == (go(a), go(b)) then made else pair()
  _ -> eval(e)

size[T](e: Expr[T]) -> int = e match
  Pair(a, b) -> 1 + size(a) + size(b)
  _ -> 1

// Nested `Pair` patterns: the outer `A` is the inner pair.
leftmost[T](e: Expr[T]) -> string = e match
  Pair(Pair(x, _), Pair(_, y)) -> s"${size(x)} ${size(y)}"
  Pair(Pair(x, _), _) -> s"${size(x)}"
  _ -> "leaf"

// `||`: the right operand holds the equalities of the left one failing.
small[T](e: Expr[T], x: T) -> bool = e is not IntLit(n) || x + n < 10

// In the `IntLit` arm `T` is an `int`, which is `Ord`.
sortedWith[T](e: Expr[T], xs: Vector[T]) -> Vector[T] = e match
  IntLit(n) -> (xs :+ n).sorted
  _ -> xs

// Matched one after the other, each pattern's types are its own.
zipped[T, U](x: Expr[T], y: Expr[U]) -> string
  var out = ""
  if x is Pair(a, _) then out = out + s"${size(a)}"
  if y is Pair(_, d) then out = out + s":${size(d)}"
  out

main()
  println(later(IntLit(41))())
  println(later(BoolLit(true))())
  val f = later(Pair(IntLit(1), Pair(BoolLit(false), IntLit(3))))
  println(f())
  println(f().1.1)
  println(again(Pair(IntLit(1), BoolLit(true))))
  println(again(Pair(Pair(IntLit(2), IntLit(3)), BoolLit(false))))
  println(again(IntLit(0)))
  println(leftmost(Pair(Pair(IntLit(1), BoolLit(true)), Pair(IntLit(2), Pair(IntLit(3), IntLit(4))))))
  println(leftmost(Pair(Pair(BoolLit(false), IntLit(9)), IntLit(4))))
  println(leftmost(IntLit(1)))
  println(small(IntLit(3), 4))
  println(small(IntLit(30), 4))
  println(small(BoolLit(true), false))
  println(sortedWith(IntLit(5), [9, 1, 7]))
  println(sortedWith(BoolLit(true), [true, false]))
  println(zipped(Pair(IntLit(1), IntLit(2)), Pair(BoolLit(true), BoolLit(false))))
  println(zipped(IntLit(1), Pair(IntLit(5), Pair(IntLit(6), IntLit(7)))))
