// expect: trap
// A semaphore holds at most its capacity: a release with every permit already free gives back a
// permit nobody took, so it traps.
import avin.threads.Semaphore

main()
  val s = Semaphore(2)
  s.acquire()
  s.release()
  println(s"free ${s.availablePermits()}")
  s.release()
  println("after")
