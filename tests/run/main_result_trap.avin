// expect: trap
// A trap in a `main` answering with a `Result` stops the program as in any other `main`: it never
// answers, so nothing reads an `Err` and no `error: ` line is written.
check(n: int) -> Result[int, string] = if n > 0 then Ok(n) else Err("not positive")

main() -> Result[unit, string]
    val n = check(3)?
    println(s"checked $n")
    fail(s"stopped at $n")
    Ok(())
