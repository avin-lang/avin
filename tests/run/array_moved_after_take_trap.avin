// expect: trap
// Once another thread has taken the moved array, it is that thread's: the sender's use of its old
// reference traps, after the receiver has finished with it as before.
import avin.actors.Isolated
import avin.threads.spawn

main()
  val a = Array.fill[byte](16, byte(3))
  val moved = Isolated.move(a)
  val t = spawn(() ->
    val got = moved.take()
    got(0) = byte(4)
    got.length)
  println(t.join())
  println(a(0))
