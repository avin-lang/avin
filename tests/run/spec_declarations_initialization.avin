// expect: exit 0
// Spec probes for declarations, Initialization: lazy vals in a generic class, read through a lambda,
// in an object and at module level beneath an eager value, an open class calling a safe private
// method after its last field, and a final class capturing and storing self after its last field.
var log: Vector[string] = []

note(s: string) -> int
    log = log :+ s
    s.byteLength

class Box[T](val item: T)
    lazy val pair: (T, T) = (item, item)
    lazy val count = note("count")

object Cache
    lazy val table: Vector[string] = ["a", "b"].map(x -> x + s"${note("table")}")

lazy val base = note("base")
val eager = base + 1

open class Shape(val side: int)
    val area = side * side
    private var doubled = 0
    doubled = twice()
    private twice() -> int = area * 2
    shown() -> int = doubled

class Square(s: int): Shape(s)

class Pinned(val n: int)
    val first = n
    val second = first + 1
    var reader: () -> int = () -> 0
    var me: Option[Pinned] = None
    reader = () -> first + second
    me = Some(self)
    run() -> int = reader() + me.map(p -> p.n).getOrElse(0)

main()
    val b = Box("x")
    println(s"${b.pair} ${b.count} ${b.count}")
    val ib = Box(3)
    val get = () -> ib.pair
    println(s"${get()} ${get().0}")
    println(s"${Cache.table} ${Cache.table.length}")
    println(s"$eager $base")
    println(log)
    println(s"${Square(3).shown()} ${Pinned(2).run()}")
