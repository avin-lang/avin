// expect: exit 22
// Strings join with `+`, compare by their bytes, match literal patterns, and live in data fields,
// tuples and locals across collections: every string a program makes is on the collected heap.

data Words
    End
    Word(text: string, rest: Words)

repeat(s: string, n: int) -> string = if n == 0 then "" else s + repeat(s, n - 1)

build(n: int) -> Words = if n == 0 then End else Word(repeat("x", n) + "!", build(n - 1))

printAll(w: Words)
    w match
        End -> ()
        Word(text, rest) ->
            println(text)
            printAll(rest)

greet(name: string) -> string = "Hello, " + name + "!"

classify(word: string) -> int = word match
    "one" -> 1
    "two" | "deux" -> 2
    _ -> 0

main() -> int
    println(greet("strings"))
    var s = ""
    var i = 0
    while i < 5
        s += "ab"
        i += 1
    println(s)
    printAll(build(3))
    val a, b = "left" + "-", "right" + "+"
    println(b + a)
    if "apple" < "banana" < "cherry" then println("chains order")
    if "abc" == "a" + "bc" then println("equal by contents")
    if "abc" != "abd" then println("unequal")
    if "ab" < "abc" then println("a prefix orders first")
    if "é" > "z" then println("code point order")
    if "" + "" == "" then println("empty")
    println("λ" + " " + "🌍")
    classify("two") * 10 + classify("t" + "wo")
