// expect: exit 0
// Generic data types: type arguments inferred from the fields or from the expected type, or
// written; nested patterns; fields of every scalar type.

data Option[+T]
    Some(value: T)
    None

data Pair[+A, +B](first: A, second: B)

data Mixed(flag: bool, ratio: real, letter: char, octet: byte, wide: i128, nothing: unit, name: string)

getOrElse[T](o: Option[T], fallback: T) -> T = o match
    Some(v) -> v
    None -> fallback

empty[T]() -> Option[T] = None

swap[A, B](p: Pair[A, B]) -> Pair[B, A] = Pair(p.second, p.first)

depth(o: Option[Option[bool]]) -> int = o match
    Some(Some(true)) -> 3
    Some(Some(false)) -> 2
    Some(None) -> 1
    None -> 0

main() -> int
    val none: Option[int] = None
    if getOrElse(Some(7), 0) != 7 || getOrElse(none, 9) != 9 then return 1
    if getOrElse(None[i64], 5) != 5 then return 2
    // The inner call's unknown is settled by the literal beside it in the outer call.
    if getOrElse(empty(), 3) != 3 || getOrElse(None, 4) != 4 then return 8
    val p = swap(Pair(1, true))
    if !p.first || p.second != 1 then return 3
    if depth(Some(Some(true))) != 3 || depth(Some(Some(false))) != 2 || depth(Some(None)) != 1 || depth(None) != 0 then return 4
    val m = Mixed(true, 2.5, 'x', byte(200), 170141183460469231731687303715884105727, (), "name")
    if !m.flag || m.ratio != 2.5 || m.letter != 'x' || m.octet != byte(200) then return 5
    if m.wide != 170141183460469231731687303715884105727 then return 6
    m.name match
        _ -> println(m.name)
    val nested = Pair(Some("inner"), Pair(none, 'q'))
    nested match
        Pair(Some(text), Pair(None, c)) if c == 'q' -> println(text)
        _ -> return 7
    0
