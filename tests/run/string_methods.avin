// The methods the core library gives `string`, over ASCII and over multi-byte UTF-8: `é` takes two
// bytes, each of `日本` three, and `😀` four. Offsets count bytes.

show(b: bool) -> string = if b then "yes" else "no"

main()
    val word = "café"
    val wide = "日本😀"
    // Lengths: bytes in O(1), characters by walking them.
    println(s"${word.byteLength} ${word.charCount} ${wide.byteLength} ${wide.charCount} ${"".byteLength} ${"".charCount}")
    println(s"${show("".isEmpty)} ${show("".nonEmpty)} ${show(word.isEmpty)} ${show(word.nonEmpty)}")
    // Searching.
    println(s"${show(word.startsWith("ca"))} ${show(word.startsWith("af"))} ${show(word.startsWith(""))} ${show(word.startsWith("café!"))}")
    println(s"${show(word.endsWith("fé"))} ${show(word.endsWith("é"))} ${show(word.endsWith("e"))} ${show("".endsWith(""))} ${show("a".endsWith("ab"))}")
    println(s"${show(wide.contains("本😀"))} ${show(wide.contains("日😀"))} ${show(wide.contains(""))} ${show("".contains("a"))} ${show("aab".contains("ab"))}")
    // Slicing takes byte offsets on character boundaries.
    println(s"[${word.slice(0, 3)}] [${word.slice(3, 5)}] [${word.slice(5, 5)}] [${wide.slice(3, 6)}] [${wide.slice(6, 10)}]")
    println(s"[${word.slice(0, word.byteLength)}] [${"".slice(0, 0)}]")
    // Case, one character for one.
    println(s"${word.toUpperCase} ${"ÉCOLE Λ".toLowerCase} ${wide.toUpperCase} [${"".toUpperCase}] ${"straße".toUpperCase}")
    // Stripping removes Unicode white space at the ends, never inside; trimming the ASCII controls and
    // spaces.
    println(s"[${"  a b  ".trim}] [${"  a b  ".stripLeading}] [${"  a b  ".stripTrailing}]")
    println(s"[${"\u{a0}\u{3000}日本\u{85}\u{a0}".strip}] [${" \t\n ".trim}] [${"".strip}] [${"é".trim}] [${" é ".stripTrailing}]")
    // Repeating and replacing.
    println(s"[${"ab".repeat(3)}] [${"é".repeat(2)}] [${"ab".repeat(0)}] [${"".repeat(5)}] [${word.repeat(1)}]")
    println(s"[${"a-b-c".replace("-", "+")}] [${"aaa".replace("aa", "b")}] [${word.replace("é", "e")}] [${word.replace("", "x")}] [${word.replace("z", "y")}]")
    // A method takes one argument infix, and is a value bound to its receiver; a parameterless one is read through a lambda.
    println(s"${show(word startsWith "c")} ${show(word contains "fé")} ${word repeat 2}")
    val upper = () -> word.toUpperCase
    val cut: (int, int) -> string = wide.slice
    val count = () -> "aé".charCount
    println(s"${upper()} ${cut(0, 3)} ${count()}")
    // A string made at run time, rather than a literal.
    val built = "日" + "本" + " "
    println(s"${built.byteLength} [${built.trim}] ${show(built.endsWith("本 "))} ${built.trim.slice(3, 6)}")
