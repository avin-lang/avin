// The methods the core library gives `string`, over ASCII and over multi-byte UTF-8: `é` takes two
// bytes, each of `日本` three, and `😀` four. Offsets count bytes.

show(b: bool) -> string = if b then "yes" else "no"

main()
    val word = "café"
    val wide = "日本😀"
    // Lengths: bytes in O(1), characters by walking them.
    print(s"${word.byteLength()} ${word.charCount()} ${wide.byteLength()} ${wide.charCount()} ${"".byteLength()} ${"".charCount()}")
    print(s"${show("".isEmpty())} ${show("".nonEmpty())} ${show(word.isEmpty())} ${show(word.nonEmpty())}")
    // Searching.
    print(s"${show(word.startsWith("ca"))} ${show(word.startsWith("af"))} ${show(word.startsWith(""))} ${show(word.startsWith("café!"))}")
    print(s"${show(word.endsWith("fé"))} ${show(word.endsWith("é"))} ${show(word.endsWith("e"))} ${show("".endsWith(""))} ${show("a".endsWith("ab"))}")
    print(s"${show(wide.contains("本😀"))} ${show(wide.contains("日😀"))} ${show(wide.contains(""))} ${show("".contains("a"))} ${show("aab".contains("ab"))}")
    // Slicing takes byte offsets on character boundaries.
    print(s"[${word.slice(0, 3)}] [${word.slice(3, 5)}] [${word.slice(5, 5)}] [${wide.slice(3, 6)}] [${wide.slice(6, 10)}]")
    print(s"[${word.slice(0, word.byteLength())}] [${"".slice(0, 0)}]")
    // Case, one character for one.
    print(s"${word.toUpper()} ${"ÉCOLE Λ".toLower()} ${wide.toUpper()} [${"".toUpper()}] ${"straße".toUpper()}")
    // Trimming removes Unicode white space at the ends, never inside.
    print(s"[${"  a b  ".trim()}] [${"  a b  ".trimStart()}] [${"  a b  ".trimEnd()}]")
    print(s"[${"\u{a0}\u{3000}日本\u{85}\u{a0}".trim()}] [${" \t\n ".trim()}] [${"".trim()}] [${"é".trim()}] [${" é ".trimEnd()}]")
    // Repeating and replacing.
    print(s"[${"ab".repeat(3)}] [${"é".repeat(2)}] [${"ab".repeat(0)}] [${"".repeat(5)}] [${word.repeat(1)}]")
    print(s"[${"a-b-c".replace("-", "+")}] [${"aaa".replace("aa", "b")}] [${word.replace("é", "e")}] [${word.replace("", "x")}] [${word.replace("z", "y")}]")
    // A method takes one argument infix, and is a value bound to its receiver.
    print(s"${show(word startsWith "c")} ${show(word contains "fé")} ${word repeat 2}")
    val upper = word.toUpper
    val cut: (int, int) -> string = wide.slice
    val count = "aé".charCount
    print(s"${upper()} ${cut(0, 3)} ${count()}")
    // A string made at run time, rather than a literal.
    val built = "日" + "本" + " "
    print(s"${built.byteLength()} [${built.trim()}] ${show(built.endsWith("本 "))} ${built.trim().slice(3, 6)}")
