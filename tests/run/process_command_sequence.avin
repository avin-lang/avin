// `andThen` runs its second command where the first succeeded, `orElse` where it did not, and
// `followedBy` either way; the status is the last one run. A part that cannot be started ends the
// sequence with the error, and sequences nest.
import avin.process.Command

ok(text: string) -> Command = Command("/bin/echo", text)

failing(code: int) -> Command = Command("/bin/sh", "-c", s"exit $code")

main()
  println((ok("a") andThen ok("b")).output())
  println((failing(2) andThen ok("not run")).run())
  println((ok("c") orElse ok("not run")).output())
  println((failing(3) orElse ok("ran after a failure")).output())
  println((failing(4) orElse failing(5)).run())
  println((failing(6) followedBy ok("ran anyway")).output())
  println((ok("d") followedBy failing(7)).run())
  // Words chain from the left: (a andThen b) orElse c.
  println((failing(1) andThen ok("skipped") orElse ok("recovered")).output())
  println((ok("e") andThen ok("f") andThen ok("g")).output())
  println((ok("h") andThen (failing(1) orElse ok("i"))).output())
  // A part killed by a signal is not success.
  println((Command("/bin/sh", "-c", "kill -9 $$") andThen ok("not run")).run())
  println((Command("/bin/sh", "-c", "kill -9 $$") orElse ok("after a signal")).output())
  // A part that cannot be started.
  println((Command("avin-no-such-program") orElse ok("not run either")).run())
  println((ok("j") andThen Command("avin-no-such-program")).output())
  println((failing(1) andThen Command("avin-no-such-program")).run())
  // A command is a value: run twice, it runs twice.
  val twice = ok("k") followedBy ok("l")
  println(twice.output())
  println(twice.output())
