// expect: exit 0
// A module's own variants named `None`, `Some`, `Ok`, `Err`, `Left` and `Right` hide the core
// library's, yet wherever an `Option`, `Result` or `Either` is expected the bare name is that type's
// variant, decided as a name several of the module's types share is. Where nothing expects one of
// those types the module's own variant is meant.
data ImageFormat
  None
  Png

data Choice
  Some(n: int)
  Ok
  Err(code: int)
  Left
  Right

data Pair(a: Option[int], b: ImageFormat)

class Holder(var o: Option[string])

find(n: int) -> Option[int]
  if n > 0 then return Some(n)
  return None

short(n: int) -> Option[int] = if n > 0 then Some(n) else None

parse(s: string) -> Result[int, string]
  if s == "" then return Err("empty")
  Ok(s.charCount)

side(n: int) -> Either[int, string] = if n < 0 then Left(n) else Right(s"$n")

orZero(o: Option[int]) -> int = o match
  Some(v) -> v
  None -> 0

withDefault(o: Option[int] = None) -> int = orZero(o)

firstOf[T](xs: Vector[T]) -> Option[T]
  if xs.length == 0 then return None
  Some(xs(0))

wrapped[T](x: T) -> Option[Option[T]] = Some(Some(x))

nested(o: Option[Option[int]]) -> string = o match
  Some(None) -> "inner none"
  Some(Some(v)) -> s"inner $v"
  None -> "outer none"

format(f: ImageFormat) -> string = f match
  None -> "no format"
  Png -> "png"

choice(c: Choice) -> string = c match
  Some(n) -> s"some $n"
  Ok -> "ok"
  Err(code) -> s"err $code"
  Left -> "left"
  Right -> "right"

result(r: Result[int, string]) -> string = r match
  Ok(n) -> s"ok $n"
  Err(e) -> s"err $e"

either(e: Either[int, string]) -> string = e match
  Left(n) -> s"left $n"
  Right(s) -> s"right $s"

main()
  // An annotated binding, a return, a parameter.
  val x: Option[int] = None
  println(orZero(x))
  println(find(0))
  println(find(4))
  println(short(0))
  println(orZero(None))
  println(withDefault())
  println(withDefault(Some(7)))
  // Fields: a data type's, decided field by field, and a class's, through its constructor and an
  // assignment.
  val p = Pair(None, None)
  println(s"${p.a} ${format(p.b)}")
  val q = Pair(Some(2), Png)
  println(s"${q.a} ${format(q.b)}")
  val h = Holder(None)
  println(h.o)
  h.o = Some("set")
  println(h.o)
  h.o = None
  println(h.o)
  // A collection's element.
  val xs: Vector[Option[int]] = [None, Some(1), None]
  println(xs)
  val fs: Vector[ImageFormat] = [None, Png]
  println(fs)
  // A comparison's other operand, on either side.
  println(x == None)
  println(None == find(1))
  println(find(1) != None)
  val f: ImageFormat = None
  println(f == None)
  println(Png != None)
  // A pattern on an option, and nested, in an expression and in a pattern.
  println(nested(Some(None)))
  println(nested(wrapped(5)))
  println(nested(None))
  val deep: Option[Option[int]] = Some(None)
  println(deep)
  // `is` against an option.
  println(x is None)
  println(find(2) is Some(_))
  // Generic functions and types.
  println(firstOf([3, 4]))
  println(firstOf[string]([]))
  val e: Option[Vector[string]] = None
  println(e)
  // A closure's result.
  val make: (int) -> Option[int] = n -> if n > 1 then Some(n) else None
  println(make(1))
  println(make(2))
  // The other prelude names.
  println(result(parse("")))
  println(result(parse("abc")))
  val r: Result[int, string] = Ok(9)
  println(result(r))
  println(either(side(-1)))
  println(either(side(2)))
  val l: Either[int, string] = Left(1)
  println(either(l))
  // Where nothing decides, the module's own variants.
  val own = None
  println(format(own))
  val c = Some(3)
  println(choice(c))
  println(choice(Ok))
  println(choice(Err(4)))
  println(choice(Left))
  println(choice(Right))
  val k = Ok
  println(k is Ok)
  println(format(f))
