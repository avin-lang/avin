// expect: exit 0
// A child's pipes belong to the code they are handed to, not to the `Child`. A thread waiting for the
// command takes the `Child` and none of its pipes, so the program goes on writing and reading them
// meanwhile. An end handed to a thread is that thread's while it runs and the program's again once it
// has returned, and closing it there ends the command's input.
import avin.io.IoError
import avin.process.Command
import avin.threads.spawn

ok[T](r: Result[T, IoError]) -> T = r match
  Ok(v) -> v
  Err(e) -> fail(e.message)

main() -> int
  val child = Command("cat").pipeInput().pipeOutput().start().ok.get
  val input = child.stdin()
  val output = child.stdout()
  // A thread waits for the command; the program uses the pipes meanwhile.
  val waiter = spawn(() -> child.waitFor().ok.get)
  ok(input.writeText("while a thread waits\n"))
  println(ok(output.readLine()).get)

  // The output handed to a thread, then back.
  ok(input.writeText("read by a thread\n"))
  println(spawn(() -> ok(output.readLine()).get).join())
  ok(input.writeText("read by the program again\n"))
  println(ok(output.readLine()).get)

  // The input handed to a thread, which writes and closes it.
  spawn(() ->
    ok(input.writeText("written by another thread\n"))
    ok(input.close())).join()
  println(ok(output.readLine()).get)
  println(s"end: ${ok(output.readLine())}")
  println(s"the waiting thread saw: ${waiter.join()}")
  ok(output.close())
  0
