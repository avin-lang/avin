// expect: exit 0
// A typed protocol: `Ask` hides the reply type `R`, which its query and its reply address agree on,
// so an actor answers each request with a value of exactly the type its caller awaits. `R` is bounded
// by `Sendable`, which makes `ActorRef[R]` a type in the variant and makes the message type sendable;
// in the arm `R` is a fresh type with that bound, refined further by `answer`'s clauses. Requests at
// `long`, `string` and `unit` are three packs of `Ask`, each with its own arm.

import avin.actors.{ActorRef, AskError, spawn}
import avin.threads.Future
import avin.time

data Query[R]
  Balance -> Query[long]
  Owner -> Query[string]
  Deposit(amount: long) -> Query[unit]
  History -> Query[Vector[long]]

data AccountMsg
  Ask[R: Sendable](query: Query[R], replyTo: ActorRef[R])
  Note(text: string)

actor Account(owner: string) receives AccountMsg
  var balance = long(0)
  var deposits: Vector[long] = []

  answer[R](q: Query[R]) -> R
  answer(Balance) = balance
  answer(Owner) = owner
  answer(Deposit(amount)) =
    deposits = deposits :+ amount
    balance += amount
  answer(History) = deposits

  receive
    Ask(query, replyTo) -> replyTo.tell(answer(query))
    Note(text) -> println(s"note: $text")

request[R: Sendable](account: ActorRef[AccountMsg], q: Query[R]) -> Future[Result[R, AskError]] =
  account.ask(r -> Ask(q, r), timeout = time.seconds(5))

// A hidden type bounded by two traits: each value's own type has both.
data Labelled
  Label[A: Display & Eq](value: A, other: A)

same(l: Labelled) -> string = l match
  Label(a, b) -> s"$a ${if a == b then "=" else "≠"} $b"

main()
  val account = spawn(Account("ada"))
  _ = request(account, Deposit(40)).await()
  _ = request(account, Deposit(2)).await()
  account.tell(Note("two deposits"))
  println(request(account, Balance).await())
  println(request(account, Owner).await())
  println(request(account, History).await())
  println(request(account, Deposit(0)).await())
  println(same(Label(1, 1)))
  println(same(Label("a", "b")))
  println(Label(1, 1))
  println(Label(1, 1) == Label(1, 1))
  println(Label(1, 1) == Label(long(1), long(1)))
