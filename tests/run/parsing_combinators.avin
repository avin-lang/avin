// expect: exit 0
// The combinators and leaf parsers of `avin.parsing` at their edges: repetitions of nothing, a
// repeated parser that can succeed on nothing, optional parts, separators, chains of one, look
// ahead, positions, a parser chosen by a value, prefixes, and the number, name and character parsers.
import avin.parsing.{ParseError, Parser, chainLeft, chainRight, digits, decimal, eof, guard, ident, integer, isDigit, isLetter, lit, notFollowedBy, opt, positioned, rep, rep1, rep1Sep, repSep, satisfy, success, symbol, takeWhile, takeWhile1, token}

show[T: Display](label: string, r: Result[T, ParseError])
    r match
        Ok(v) -> print(s"$label: $v")
        Err(e) -> print(s"$label: error $e")

lazy val number: Parser[long] = token(integer)

lazy val numbers: Parser[Vector[long]] = number.repSep(symbol(","))

// `if` as a keyword, not the start of a longer name.
lazy val ifKeyword: Parser[string] = lit("if") <~ notFollowedBy(satisfy("letter", isLetter))

// `<b>text</b>`: the closing tag must repeat the opening one.
lazy val element: Parser[string] = lit("<") ~> ident.flatMap(open -> (lit(">") ~> takeWhile(c -> c != '<') <~ lit("</")) <~ lit(open) <~ lit(">"))

main()
    show("rep of nothing", rep(lit("a")).parse(""))
    show("rep", rep(lit("a")).parse("aaa"))
    show("rep1 of nothing", rep1(lit("a")).parse(""))
    show("rep1", rep1(lit("a")).parse("aa"))
    show("rep of a parser that reads nothing", rep(takeWhile(isDigit)).parse(""))
    show("rep of a parser that may read nothing", (rep(takeWhile(isDigit) <~ lit(";")) ~> takeWhile(isDigit)).parse("1;22;;333"))
    show("repSep of nothing", numbers.parse(""))
    show("repSep of one", numbers.parse("7"))
    show("repSep", numbers.parse("1, 2 ,3"))
    show("repSep with a separator last", numbers.parse("1, 2,"))
    show("repSep function", repSep(number, symbol(";")).parse("4; 5"))
    show("rep1Sep of nothing", rep1Sep(number, symbol(",")).parse(""))
    show("rep1Sep", number.rep1Sep(symbol(",")).parse("8,9"))
    show("rep method", lit("ab").rep().parse("abab"))
    show("rep1 method", lit("ab").rep1().parse("ab"))

    show("opt absent", (opt(lit("-")) ~ digits ^^ (match (sign, d) -> s"$sign $d")).parse("12"))
    show("opt present", (lit("-").opt() ~ digits ^^ (match (sign, d) -> s"$sign $d")).parse("-12"))

    val add = symbol("+") ^^^ ((a: long, b: long) -> a + b)
    val minus = symbol("-") ^^^ ((a: long, b: long) -> a - b)
    show("chainLeft of one", chainLeft(number, add).parse("5"))
    show("chainLeft", chainLeft(number, minus).parse("10 - 3 - 2"))
    show("chainRight of one", chainRight(number, minus).parse("5"))
    show("chainRight", chainRight(number, minus).parse("10 - 3 - 2"))
    show("chainLeft missing operand", chainLeft(number, minus).parse("10 - "))

    show("keyword", (ifKeyword <~ lit(" x")).parse("if x"))
    show("keyword prefix of a name", ifKeyword.parse("iffy"))
    show("guard", (guard(lit("a")) ~> lit("ab")).parse("ab"))
    show("guard fails", (guard(lit("b")) ~> lit("ab")).parse("ab"))
    show("eof", (lit("a") <~ eof).parse("a"))
    show("eof fails", (lit("a") <~ eof).parsePrefix("ab").map(match (v, at) -> s"$v $at"))

    val located = positioned(token(ident)).rep() ^^ (xs -> xs.map(match (name, at) -> s"$name@$at").mkString(" "))
    show("positioned", located.parse("alpha\n  béta g\n\ndelta"))
    show("positioned method", (lit("x") ~> lit("y").positioned() ^^ (match (v, at) -> s"$v ${at.offset}")).parse("xy"))

    show("flatMap", element.parse("<b>bold</b>"))
    show("flatMap mismatch", element.parse("<b>bold</i>"))
    show("success", (success(long(42)) <~ eof).parse(""))
    show("^^^", (lit("yes") ^^^ true).parse("yes"))
    show("map", lit("abc").map(s -> s.byteLength()).parse("abc"))

    show("parsePrefix", number.parsePrefix("12 abc").map(match (n, at) -> s"$n $at"))
    show("parsePrefix fails", number.parsePrefix("abc").map(match (n, at) -> s"$n $at"))

    show("digits", digits.parse("0123"))
    show("ident", ident.parse("été_2"))
    show("ident from underscore", ident.parse("_x9"))
    show("ident from digit", ident.parse("9x"))
    show("character", lit('é').parse("é"))
    show("characters", (lit('é') ~> lit('\u{1F600}') ~> lit('!')).parse("é\u{1F600}!"))
    show("satisfy", satisfy("vowel", c -> "aeiou".contains(s"$c")).rep().parse("aei"))
    show("takeWhile1 of nothing", takeWhile1("letter", isLetter).parse("1"))
    show("integer least", integer.parse("-9223372036854775808"))
    show("integer negative zero", integer.parse("-0"))
    show("decimal", decimal.parse("1.5E+2"))
    show("decimal stops before a bare dot", decimal.parsePrefix("1.").map(match (x, at) -> s"$x $at"))
    show("decimal stops before a bare exponent", decimal.parsePrefix("2e+").map(match (x, at) -> s"$x $at"))
    show("decimal negative fraction", decimal.parse("-0.25"))
