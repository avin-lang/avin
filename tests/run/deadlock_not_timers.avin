// expect: exit 0
// Waits that a timer ends are never a deadlock, even while every thread waits: `main` joins a thread
// that sleeps; receives from a channel a sleeping thread sends to; waits on a condition with a limit
// that nothing notifies; awaits a future with a limit that nothing completes; and waits for a signal
// that never arrives, with a limit. A thread waits with a limit while `main` waits without one, and a
// thread whose only waker is another thread's sleep is woken in the end.
import avin.signal
import avin.threads.{Channel, Mutex, Promise, sleep, spawn}
import avin.time.millis

main()
  val sleeper = spawn(() ->
    sleep(millis(50))
    7)
  println(sleeper.join())

  val later = Channel[int]()
  spawn(() ->
    sleep(millis(50))
    later.send(8))
  println(later.receive())

  val m = Mutex(0)
  val c = m.condition()
  println(m.with(n -> c.waitFor(50)))
  val timed = spawn(() -> m.with(n -> c.waitFor(50)))
  println(timed.join())

  val p = Promise[int]()
  println(p.future.await(millis(50)))
  val awaiting = spawn(() -> p.future.await(millis(50)).getOrElse(9))
  println(awaiting.join())

  val w = signal.watch(signal.User1).ok.get
  println(w.wait(millis(50)))

  // A chain: the first thread's sleep is the only thing that will wake the second, which `main` joins.
  val first = Channel[int]()
  val second = spawn(() -> first.receive().getOrElse(0) + 1)
  spawn(() ->
    sleep(millis(50))
    first.send(10))
  println(second.join())
