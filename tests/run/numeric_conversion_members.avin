// expect: exit 0
// Every number has `toInt`, `toLong` and `toReal`, parameterless, each the conversion call of that
// type: an integer's narrowing traps (tested beside), a real's truncates toward zero, saturates at
// the bounds and maps NaN to zero.

widen[T: Integer](x: T) -> long = long(x)
narrow[T: Integer](x: T) -> int = int(x)
average[T: Numeric](xs: Vector[T]) -> real = xs.sum.toReal / xs.length.toReal

main()
    // Integers, at every width the values fit.
    val n = 42
    val cents: long = 1999
    println(cents * n.toLong)
    println(n.toLong)
    println(n.toInt)
    println(n.toReal)
    println(int.MaxValue.toLong + 1)
    println(int.MinValue.toLong - 1)
    println(long(int.MaxValue).toInt)
    println(long(int.MinValue).toInt)
    println(i8(-128).toInt)
    println(i8(127).toLong)
    println(i1(-1).toInt)
    println(long.MaxValue.toLong)
    println(long.MaxValue.toReal)
    println(i128(5).toInt)
    println((n + 1).toLong)
    println(-n.toLong)
    // Reals: truncation toward zero, saturation and NaN.
    println(2.7.toInt)
    println((-2.7).toInt)
    println(0.5.toLong)
    println((-0.0).toInt)
    println(1e300.toInt)
    println((-1e300).toInt)
    println(real.PositiveInfinity.toLong)
    println(real.NegativeInfinity.toLong)
    println(real.NaN.toInt)
    println(real.NaN.toLong)
    println(9007199254740993.0.toLong)
    println(2.5.toReal)
    println(real.NaN.toReal.isNaN)
    // A real mixed with an integer, joined by a member.
    val xs = [1.5, 2.5, 3.5]
    println(xs.sum / xs.length.toReal)
    // Generic code: an `Integer` parameter converts by a call, and `toReal` is `Numeric`'s.
    println(widen(i8(-3)))
    println(widen(int.MaxValue))
    println(narrow(long(-7)))
    println(narrow(i16(300)))
    println(average([1, 2, 3, 4]))
    println(average([0.5, 1.5]))
    println(average([long.MaxValue, 0]))
    // A closure over a conversion member, and a member as a function value through a lambda.
    val scale: long = 10000000000
    val toLongs = [1, 2, 3].map(x -> x.toLong * scale)
    println(toLongs)
    println([2.9, -2.9].map(_.toInt))
