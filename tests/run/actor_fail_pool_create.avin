// expect: trap
// A trap inside a pool's `create`, run for an actor's call, stops the program instead of failing the
// actor, as one inside the body does: the place the make holds would otherwise never be given back.
import avin.actors.{Stop, spawn}
import avin.threads.{Channel, Pool}

class Conn(val id: int): Sendable

actor Worker(pool: Pool[Conn, string], done: Channel[int]) receives int
  receive
    n -> done.send(pool.use(c -> c.id).getOrElse(-1))

main()
  val pool = Pool[Conn, string](() -> Ok(Conn(fail("no connection can be made"))), maxSize = 1)
  val done = Channel[int]()
  val w = spawn(Worker(pool, done), onFailure = Stop)
  w.tell(1)
  println(done.receive())
  println("not reached")
