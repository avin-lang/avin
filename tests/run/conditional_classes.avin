// An impl with bounds of its own makes a generic class conform to a trait that is also a type, for
// the type arguments that meet them. Such an instance converts to the trait and is called through
// it; a type pattern on an `Any` matches only the instances that conform; an instance whose
// arguments miss the bounds is still made and used for everything else.

class Box[T](val item: T)

impl[T: Display] Display for Box[T]
    display(out: Writer, spec: FormatSpec)
        out.write("Box(")
        item.display(out, spec)
        out.write(")")

class Plain

trait Shape
    area() -> int

    doubled() -> int = area() * 2

class Square(side: int): Shape
    override area() -> int = side * side

// A holder is a shape when what it holds is one, twice as large.
class Holder[T](val item: T)

impl[T: Shape] Shape for Holder[T]
    area() -> int = item.area() * 2

total(s: Shape) -> int = s.area()

sum(shapes: Array[Shape]) -> int
    var n = 0
    for s in shapes
        n += s.doubled()
    n

describe(x: Any) -> string = x match
    d: Display -> "displays as " + d.toString()
    _ -> "does not display"

shapes(x: Any) -> string = x match
    s: Shape -> s"a shape of ${s.area()}"
    _ -> "not a shape"

show[T: Display](x: T) -> string = x.toString()

// Inside a generic function, `Box[T]` is a `Display` where `T` is.
boxed[T: Display](x: T) -> Display = Box(x)

main()
    val b = Box(3)
    print(b)
    print(s"${Box(Box("hi"))} ${b.toString()} ${show(Box(2.5))} ${boxed('c')}")
    val d: Display = Box(7)
    print(d.toString())
    print(total(Holder(Square(3))))
    print(total(Holder(Holder(Square(2)))))
    val many: Array[Shape] = Array.tabulate(2, i -> Holder(Square(i + 1)))
    print(sum(many))
    print(describe(Box(1)))
    print(describe(Box(Plain())))
    print(describe(Box(Box(Plain()))))
    print(shapes(Holder(Square(1))))
    print(shapes(Holder(Plain())))
    print(shapes(Holder(5)))
    val kept = Box(Plain())
    print(kept.item === kept.item)
    val ro: Ro[Box[int]] = Ro(Box(1))
    val seen: Ro[Display] = ro
    print(seen.item)
    print(readable(ro))
    print(readable(Ro(Box(Plain()))))

// A read-only holder is covariant, so `Ro[Box[int]]` is an `Ro[Display]`; `Ro[Box[Plain]]` is not.
class Ro[+T](val item: T)

readable(x: Any) -> string = x match
    r: Ro[Display] -> "reads " + r.item.toString()
    _ -> "unreadable"
