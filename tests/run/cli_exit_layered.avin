// expect: exit 2
// `parseLayeredOrExit` given an environment variable the option cannot take: the program's name and
// the reason, naming the variable, the usage line and where the help is go to standard error, and the
// program exits with 2 before `main` goes on. No file is read where none is named.
import avin.cli

val parser = cli.Parser("app", "Serve things.")
  .int("port", help = "the port to listen on", default = 80)

main(args: Vector[string]) -> int
  val env = HashMap.empty[string, string]().updated("APP_PORT", "eighty")
  val opts = parser.parseLayeredOrExit(args, envPrefix = "APP_", env = env)
  println(s"not reached: ${opts.int("port")}")
  0
