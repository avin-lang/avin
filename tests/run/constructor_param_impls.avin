// expect: exit 0
// Impls adding methods to the applications of a bounded constructor parameter, `impl[F[_]: B, A]
// F[A]`, and to a type built from them, `F[G[A]]`. The receiver's static type is matched through
// its bound's conformance: a data type, a class, a subclass seen as the superclass that conforms,
// `Option`, `Vector`, and `Result[_, E]` with its error type written out. The type's own method of
// the name and parameter types is found first. Generic code whose own constructor parameter is
// bounded by the trait reaches the methods too, and so do closures and function values.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

trait Pointed[A]: Mappable[A]
  static point[X](value: X) -> Self[X]

data Box[T](value: T)

impl Pointed for Box
  static point[X](value: X) -> Box[X] = Box(value)
  map[B](f: (T) -> B) -> Box[B] = Box(f(value))

open class Shelf[T](val item: T): Pointed[T]
  static point[X](value: X) -> Shelf[X] = Shelf(value)
  map[B](f: (T) -> B) -> Shelf[B] = Shelf(f(item))

class TallShelf[T](item: T): Shelf[T](item)

class IntShelf(item: int): Shelf[int](item)

impl Pointed for Option
  static point[X](value: X) -> Option[X] = Some(value)

impl Pointed for Vector
  static point[X](value: X) -> Vector[X] = Vector(value)

impl[T, E] Pointed[T] for Result[T, E]
  static point[X](value: X) -> Result[X, E] = Ok(value)

// A type with a `twice` of its own, which a call on it finds before the one added to every
// `Mappable`.
data Solo[T](value: T)

impl Mappable for Solo
  map[B](f: (T) -> B) -> Solo[B] = Solo(f(value))

impl[T] Solo[T]
  twice(f: (T) -> T) -> Solo[T] = Solo(f(value))

impl[F[_]: Mappable, A] F[A]
  twice(f: (A) -> A) -> F[A] = map(f).map(f)
  // Overloaded by parameter types, as any added method may be.
  twice(n: int, f: (A) -> A) -> F[A] = if n <= 0 then map(a -> a) else map(f).twice(n - 1, f)
  // `self` is an `F[A]`, passed on as one.
  paired() -> (F[A], F[A]) = (self, self)

// A further bound on the element.
impl[F[_]: Mappable, A: Display] F[A]
  labelled(name: string) -> F[string] = map(a -> s"$name=$a")

// A stronger bound on the constructor gives its static members.
impl[F[_]: Pointed, A] F[A]
  rewrap() -> F[F[A]] = F.point(self)

// Two constructors, each found through its own bound.
impl[F[_]: Mappable, G[_]: Mappable, A] F[G[A]]
  mapIn[B](f: (A) -> B) -> F[G[B]] = map(g -> g.map(f))

// One constructor named twice takes one constructor.
impl[F[_]: Mappable, A] F[F[A]]
  depth() -> int = 2

go[F[_]: Pointed](x: F[int]) -> F[int] = x.twice(n -> n + 1)

goNested[F[_]: Pointed, G[_]: Pointed](x: F[G[int]]) -> F[G[string]] = x.mapIn(n -> s"<$n>")

// A generic class holding an application, reaching the added methods through its parameter's bound.
class Holder[F[_]: Mappable](val held: F[int])
  bumped() -> F[int] = held.twice(n -> n + 1)

main()
  println(Some(3).twice(x -> x * 2))
  val none: Option[int] = None
  println(none.twice(x -> x * 2))
  println(Box(1).twice(x -> x + 10).value)
  println(Shelf("a").twice(s -> s + "b").item)
  println(TallShelf(5).twice(n -> n * n).item)
  println(IntShelf(3).twice(n -> n + 1).item)
  val r: Result[int, string] = Ok(4)
  println(r.twice(n -> n - 1))
  val e: Result[int, string] = Err("bad")
  println(e.twice(n -> n - 1))
  println(Vector(1, 2, 3).twice(n -> n * 10))
  println(Vector[int]().twice(n -> n * 10))
  println(Vector("é", "ü").twice(s -> s + s))
  println(Some(2147483647).twice(n -> n / 2))
  println(Solo(1).twice(n -> n + 100).value)
  println(Some(1).twice(3, n -> n * 2))
  println(Some(1).twice(0, n -> n * 2))
  println(Some("p").paired())
  println(go(Some(7)))
  println(go(Box(7)).value)
  println(go(Vector(1, 2)))
  val k = 5
  println(Some(1).twice(n -> n + k))
  val prefix = "ü"
  println(Vector("a", "").twice(s -> prefix + s))
  val tw: ((int) -> int) -> Option[int] = Some(2).twice
  println(tw(n -> n * 3))
  val nested = Vector(Some(1)).mapIn[int]
  println(nested(n -> n - 1))
  println(Vector(Some(1), None, Some(3)).mapIn(n -> n * 2))
  println(Some(Vector(1, 2)).mapIn(n -> n + 1))
  println(Box(Some(1)).mapIn(n -> n + 1).value)
  println(goNested(Vector(Some(1), None)))
  println(Some(9).labelled("x"))
  println(Some(9).rewrap())
  println(Box("b").rewrap().value.value)
  println(Some(Some(1)).depth())
  println(Holder(Some(1)).bumped())
  println(Holder(Vector(1, 2)).bumped())
