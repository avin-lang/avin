// References kept across allocations, loops and calls, where the compiler keeps only those live
// across a collection point in the frame and lets references never live at once share a slot. Run
// with a collection at every allocation, a reference it failed to keep would be freed and reused.

data Cell(n: int, next: Option[Cell])

use(c: Cell) -> int = c.n

class Holder(var item: Cell)

two() -> int
    val a = Cell(1, None)
    val b = Cell(2, Some(a))
    val x = use(a) + use(b)
    val c = Cell(3, None)
    val d = Cell(4, Some(c))
    val e = Cell(5, d.next)
    x + use(c) + use(d) + use(e)

choose(flag: bool) -> int
    if flag
        val a = Cell(10, None)
        val b = Cell(20, Some(a))
        return use(a) + use(b)
    val c = Cell(30, None)
    val d = Cell(40, Some(c))
    use(c) + use(d)

chain(n: int) -> int
    var head = Cell(0, None)
    var i = 1
    while i < n
        head = Cell(i, Some(head))
        i += 1
    var total = 0
    var at: Option[Cell] = Some(head)
    while at is Some(cell)
        total += cell.n
        at = cell.next
    total

joined(a: string, b: string) -> string = a + "-" + b

refill(h: Holder, k: int) -> int
    val old = h.item
    h.item = Cell(k, Some(old))
    h.item.n + old.n

main()
    print(two().toString())
    print(s"${choose(true)} ${choose(false)}")
    print(chain(100).toString())
    print(joined("left" + "", "right" + ""))
    val h = Holder(Cell(1, None))
    print(refill(h, 5).toString())
    print(refill(h, 7).toString())
