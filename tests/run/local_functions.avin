// Local functions see the locals declared before them, and may call one another in any order.

total_of_squares(n: int) -> int
    square(x: int) -> int = x * x
    var total = 0
    var i = 1
    while i <= n do
        total += square(i)
        i += 1
    total

// A local function captures a `var` by reference: what it assigns, its caller sees.
counter() -> int
    var count = 0
    bump(by: int)
        count += by
    bump(2)
    bump(3)
    count

// Calls before the declaration are fine when what the callee captures is already initialized;
// local functions may be mutually recursive.
parity(n: int) -> string
    val zero = 0
    is_even(k: int) -> bool = if k == zero then true else is_odd(k - 1)
    is_odd(k: int) -> bool = if k == zero then false else is_even(k - 1)
    if is_even(n) then "even" else "odd"

// Captures pass through calls: `outer_step` uses `scale` only through `inner_step`.
scaled(n: int, scale: int) -> int
    var calls = 0
    inner_step(x: int) -> int
        calls += 1
        x * scale
    outer_step(x: int) -> int = inner_step(x) + 1
    val result = outer_step(n) + outer_step(1)
    result * 10 + calls

// Local functions nest, and a nested one reaches the parameters and locals of all its enclosers.
nested(base: int) -> int
    val offset = 100
    outer(a: int) -> int
        val doubled = a * 2
        inner(b: int) -> int = b + doubled + offset + base
        inner(1)
    outer(5)

// A local function has its own loops, `return` and parameters, which shadow outer names.
first_multiple(limit: int) -> int
    val n = 7
    find(n: int) -> int
        var i = 1
        while true do
            if i * n > limit then return i * n
            i += 1
    find(n) + find(3)

// Two blocks may each declare a local function with the same name.
branches(flag: bool) -> int
    if flag
        pick() -> int = 1
        pick()
    else
        pick() -> int = 2
        pick()

main()
    if total_of_squares(3) == 14 then print("squares")
    if counter() == 5 then print("counter")
    print(parity(10))
    print(parity(7))
    if scaled(4, 3) == 172 then print("scaled")
    if nested(1000) == 1111 then print("nested")
    if first_multiple(20) == 42 then print("multiple")
    if branches(true) + branches(false) == 3 then print("branches")
    greet(name: string)
        print(name)
    greet("done")
