// How a class's implementations of trait methods are found: from its own overrides, from its
// superclass, and from the default bodies of the traits it conforms to.
trait Greeter
  greet() -> string = "hello"

trait Polite
  greet() -> string = "good day"
  thanks() -> string = "thank you"

// Two traits with defaults for one method: the class overrides it, and may call either default's
// behaviour through its own code.
class Host: Greeter, Polite
  override greet() -> string = "welcome"

// A superclass's method implements a trait's abstract method of the same name.
trait Sized
  size() -> int

open class Bag(n: int)
  size() -> int = n

class Pouch(n: int): Bag(n), Sized

// An abstract class's method left abstract is filled by a trait's default.
abstract class Widget
  title() -> string

trait Titled
  title() -> string = "untitled"

class Label: Widget(), Titled

// An abstract class may conform to a trait and leave its methods to a subclass.
abstract class Part: Sized

class Bolt: Part()
  override size() -> int = 3

// An object conforms to a trait like a class.
object Origin: Sized
  override size() -> int = 0

measure(s: Sized) -> int = s.size()

main()
  val h = Host()
  println(h.greet() + ", " + h.thanks())
  val g: Greeter = h
  val p: Polite = h
  println(g.greet() + " " + p.greet())
  println(s"${measure(Pouch(4))} ${Pouch(5).size()}")
  val w: Widget = Label()
  println(w.title())
  println(s"${measure(Bolt())} ${measure(Origin)}")
  val pick = true
  val chosen: Sized = if pick then Bolt() else Pouch(1)
  println(s"${chosen.size()}")
