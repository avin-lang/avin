// expect: trap
// A ping carries at most 125 bytes, as every control frame does: 125 are sent, and 126 trap.
import avin.net.http
import avin.net.http.{Route, Router, WebSocket, webSocket}

main()
  val router = Router([Route.get("/", r -> webSocket(r, ws -> _ = ws.receive()))])
  val server = http.serve("127.0.0.1", 0, router.handle).ok.get
  val ws = WebSocket.connect(s"ws://127.0.0.1:${server.port()}/").ok.get
  println(ws.ping(Array.fill(125, byte(1))).isOk)
  _ = ws.ping(Array.fill(126, byte(1)))
