// Small whole programs over scalars: constants, forward calls, literal bases, short-circuit
// operators, matches with guards, recursion, and generic functions at several types.

twice(n: int) = n * 2

forward() = later(21)

later(n: int) = n + n

unused_generic[T](x: T) = x

// An operand that would trap if it ran: it must not run where the left side decides.
require(flag: bool) = flag || (1 / 0 == 0)

accept(flag: bool) = 42

factorial(n: int) -> int = n match
    0 -> 1
    else n * factorial(n - 1)

fib(n: int) -> int = n match
    0 -> 0
    1 -> 1
    else fib(n - 1) + fib(n - 2)

many_arms(n: int) = n match
    0 -> 1
    1 -> 2
    2 -> 3
    3 -> 4
    4 -> 42
    other -> other + 1

guard_skip(n: int) = n match
    0 if 1 / 0 == 0 -> 1
    else 42

guard_fallthrough(n: int) = n match
    0 if false -> 1 / 0
    else 42

guard_shadow(n: int) = n + 1 match
    n if n > 20 -> n * 2
    else 0

identity[T](value: T) = value

second[A, B](first: A, second: B) = second

constant[T]() = 42

choose[T](n: int, a: T, b: T) -> T = n match
    0 -> a
    else choose(n - 1, b, a)

copy[T](value: T) = value match
    local -> local

mutual_f[T](n: int, value: T) -> T = n match
    0 -> value
    else mutual_g(n - 1, value)

mutual_g[U](n: int, value: U) -> U = n match
    0 -> value
    else mutual_f(n - 1, value)

main()
    print(42)
    print(twice(21))
    print(forward())
    print(0b101010)
    print(0x2a)
    print(0o52)
    print(unused_generic(42))
    print(-7 / 2)
    print(-7 % 2)
    // Short-circuit operators skip the operand that would trap.
    print(accept(require(1 < 2)))
    print(accept(require(false || true)))
    print(false && (1 / 0 == 0))
    print(true || (1 / 0 == 0))
    print((false && (1 / 0 == 0)) || true)
    print(true && ((false || true) || (1 / 0 == 0)))
    print(factorial(5))
    print(fib(10))
    print(true match
        true -> 42
        false -> 0)
    print(many_arms(4))
    print(many_arms(9))
    print(20 + 1 match
        other -> other * 2)
    print(guard_skip(1))
    print(guard_fallthrough(0))
    print(guard_shadow(20))
    print(true match
        true -> 21 match
            0 -> 0
            other -> other * 2
        false -> 0)
    print(identity(42))
    print(identity(true), identity(20), identity(22))
    print(identity('é'), identity(0.5), identity("text"))
    print(second[bool](false, 42))
    print(constant[bool]())
    print(choose(4, 42, 0))
    print(choose(3, 42, 0))
    print(copy(true), copy(42))
    print(mutual_f(9, 42))
    print(mutual_g(4, "even"))
