// A trait's method may have type parameters of its own. Every instantiation the program uses is
// known when it is compiled, so a call through a trait-typed value reaches the implementation of the
// object's class at those type arguments, and each list of type arguments has a method table slot.
trait Mappable[A]
    map[B](f: (A) -> B) -> Mappable[B]
    get() -> A
    // A default body with a type parameter of its own.
    pairWith[B](other: B) -> (A, B) = (get(), other)

class Box[T](value: T): Mappable[T]
    override map[B](f: (T) -> B) -> Mappable[B] = Box(f(value))
    override get() -> T = value

class Twice[T](value: T): Mappable[T]
    override map[C](f: (T) -> C) -> Mappable[C] = Twice(f(value))
    override get() -> T = value
    override pairWith[C](other: C) -> (T, C) = (value, other)

// Called through a trait-typed value, at two different type arguments in one program.
describe(m: Mappable[int]) -> string
    val text = m.map((n: int) -> s"#$n")
    val doubled = m.map((n: int) -> n * 2)
    val flag = m.map((n: int) -> n > 2)
    s"${text.get()} ${doubled.get()} ${flag.get()}"

// A generic method of an open class, overridden in a subclass and dispatched.
open class Shelf(name: string)
    tag[U](item: U, show: (U) -> string) -> string = s"$name: ${show(item)}"

class Labelled(name: string): Shelf(name)
    override tag[V](item: V, show: (V) -> string) -> string = s"[${show(item)}]"

shelve(s: Shelf) -> string = s"${s.tag(5, (n: int) -> s"$n")} ${s.tag("x", (t: string) -> t + t)}"

// A data type implementing the method in an impl, and a trait default calling it through `self`.
trait Convert
    convert[B](make: (int) -> B) -> B
    twice[B](make: (int) -> B) -> (B, B) = (convert(make), self.convert(make))

data Seed(n: int)

impl Convert for Seed
    convert[B](make: (int) -> B) -> B = make(n)

// An open class implementing it, inherited by a subclass that does not override it.
open class Grower(n: int): Convert
    override convert[B](make: (int) -> B) -> B = make(n * 10)

class Sprout(n: int): Grower(n)

// An unrelated trait whose generic method may share a table position with `Convert`'s.
trait Render
    convert[B](make: (string) -> B) -> B

class Word(text: string): Render
    override convert[B](make: (string) -> B) -> B = make(text)

converted(c: Convert) -> string
    val pair = c.twice((n: int) -> n + 1)
    pair match
        (a, b) -> s"${c.convert((n: int) -> s"<$n>")} $a $b"

rendered(r: Render) -> string = r.convert((t: string) -> t + "!")

main()
    // Through a final class's type, the calls are direct.
    val b = Box(3)
    print(s"${b.map((n: int) -> n + 1).get()}")
    b.pairWith("three") match
        (n, t) -> print(s"$n $t")
    print(describe(b))
    print(describe(Twice(1)))
    val ms: Mappable[int] = Twice(7)
    ms.pairWith(true) match
        (n, f) -> print(s"$n $f")
    ms.pairWith("seven") match
        (n, t) -> print(s"$n $t")
    val mb: Mappable[int] = Box(8)
    mb.pairWith(2.5) match
        (n, r) -> print(s"$n $r")
    print(shelve(Shelf("shelf")))
    print(shelve(Labelled("label")))
    print(converted(Seed(1)))
    print(converted(Grower(2)))
    print(converted(Sprout(3)))
    print(rendered(Word("hi")))
    val g: Grower = Sprout(4)
    print(s"${g.convert((n: int) -> n > 30)}")
    // A method value of one instantiation, called through the table later.
    val pairer = ms.pairWith[string]
    pairer("later") match
        (n, t) -> print(s"$n $t")
