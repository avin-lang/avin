// expect: exit 0
// Every list, vector, array, buffer and deque is a `Seq`: one generic function takes each of them,
// the methods a sequence has by default are written once over `length` and `apply`, a list answers
// them by walking from its front, and a sequence is a function from its indices to its elements
// wherever one is expected.

open class Animal(val name: string)
class Dog(n: string): Animal(n)

total(xs: Seq[int]) -> int = xs.foldLeft(0, (acc, x) -> acc + x)

joinedBack[T: Display](xs: Seq[T]) -> string
    var out = ""
    for x in xs.reverseIterator() do out = out + s"$x"
    out

summary[T: Display](xs: Seq[T]) -> string
    val first = xs.headOption() match
        Some(x) -> s"$x"
        None -> "-"
    val last = xs.lastOption() match
        Some(x) -> s"$x"
        None -> "-"
    s"${xs.length()} $first..$last empty=${xs.isEmpty()}"

names(xs: Seq[Animal]) -> string = xs.foldRight("", (a, acc) -> if acc == "" then a.name else a.name + "," + acc)

at[T](f: (int) -> T, i: int) -> T = f(i)

main()
    val v = [1, 2, 3]
    val l: List[int] = [4, 5, 6]
    val a: Array[int] = [7, 8, 9]
    val b: Buffer[int] = [10, 11]
    val d: Deque[int] = [12, 13, 14]
    val e: Vector[int] = []
    println(s"${total(v)} ${total(l)} ${total(a)} ${total(b)} ${total(d)} ${total(e)}")
    println(s"${joinedBack(v)} ${joinedBack(l)} ${joinedBack(a)} ${joinedBack(b)} ${joinedBack(d)} [${joinedBack(e)}]")
    println(summary(v))
    println(summary(l))
    println(summary(d))
    println(summary(e))

    // Each default method on each kind of sequence.
    val all: Vector[Seq[int]] = [v, l, a, b, d]
    for xs in all
        val found = xs.find(x -> x % 2 == 0).getOrElse(-1)
        val where = xs.indexWhere(x -> x % 2 == 0)
        val odd = xs.count(x -> x % 2 == 1)
        println(s"$found $where $odd ${xs.exists(x -> x > 10)} ${xs.forall(x -> x > 3)} ${xs.head()} ${xs.last()} ${xs.lift(1).getOrElse(-1)} ${xs.lift(3).getOrElse(-1)} ${xs(2 - 1)}")
    for xs in all
        var seen = ""
        xs.foreach(x -> seen = seen + s"$x;")
        println(s"$seen ${xs.toVector()} ${xs.toList()}")

    // `contains` and `indexOf`, on each sequence that holds its own element type.
    println(s"${v.contains(2)} ${l.contains(9)} ${a.contains(9)} ${b.contains(10)} ${d.contains(1)}")
    println(s"${v.indexOf(3)} ${l.indexOf(5)} ${a.indexOf(1)} ${b.indexOf(11)} ${d.indexOf(14)}")

    // A sequence of dogs is a sequence of animals; a list's methods each walk it once.
    val dogs: List[Dog] = [Dog("rex"), Dog("fido")]
    val kennel: Vector[Dog] = [Dog("max")]
    println(names(dogs))
    println(names(kennel))
    val long = List.newBuilder[int]()
    for i in 0 ..< 3000 do long.addOne(i)
    val big = long.result()
    println(s"${big.count(x -> x % 2 == 0)} ${big.indexWhere(x -> x == 2999)} ${big.lastOption().getOrElse(-1)} ${big.toVector().length()}")

    // A sequence where a function from an index is expected: passed, stored and called.
    val words = ["zero", "one", "two"]
    println(at(words, 2))
    println(at(l, 0))
    val pick: (int) -> string = words
    println(pick(1))
    println(Array.tabulate(3, d).mkString())
    val asAnimal: (int) -> Animal = kennel
    println(asAnimal(0).name)
