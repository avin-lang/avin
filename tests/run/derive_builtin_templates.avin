// expect: exit 0
// The core library's `Eq`, `Hash`, `Ord`, `Display` and `Debug` are derive templates like any
// library's. On a generic recursive type they hold where the type arguments implement the trait, and
// recurse through the type's own impl. A data type of several variants orders by variant, in
// declaration order, and then by the fields, the first that differs deciding.

data Tree[A] derives Ord
    Leaf
    Node(left: Tree[A], value: A, right: Tree[A])

class Chain[A](val head: A, val rest: List[Chain[A]]) derives Eq, Hash, Ord, Display, Debug

data Level derives Ord
    Low
    Mid(n: int)
    High(n: int, tag: string)

// An order whose `compare` answers more than one: a derived `compare` answers -1, 0 or 1.
data Spread(n: int)

impl Ord for Spread
    compare(other: Spread) -> int = (n - other.n) * 10

data Spreads(s: Spread) derives Ord

insert[A: Ord](t: Tree[A], x: A) -> Tree[A] = t match
    Leaf -> Node(Leaf, x, Leaf)
    Node(l, v, r) -> if x < v then Node(insert(l, x), v, r) else Node(l, v, insert(r, x))

shown[T: Display](x: T) -> string = x.toString()

main()
    var t: Tree[string] = Leaf
    for s in ["m", "c", "x"]
        t = insert(t, s)
    println(t)
    println(debug(t))
    StandardOutput.write("[")
    insert(Leaf, 'q').display(StandardOutput, FormatSpec(width = 26))
    println("]")
    println(s"${insert(t, "a") > t} ${Node(Leaf, 1, Leaf) < Node(Leaf, 2, Leaf)} ${Leaf[int] < Node(Leaf, 0, Leaf)}")
    val a = Chain(1, [Chain(2, [])])
    val b = Chain(1, [Chain(2, [])])
    val c = Chain(1, [Chain(3, [])])
    println(a)
    println(debug(Chain("x", [Chain("y", [])])))
    println(s"${a == b} ${a == c} ${a.hash() == b.hash()} ${a < c} ${c > a} ${a.compare(b)}")
    println(shown(Node(Leaf, Chain(7, []), Leaf)))
    println(s"${Low < Mid(0)} ${Mid(5) < High(0, "a")} ${Mid(1) < Mid(2)} ${High(1, "b") > High(1, "a")} ${High(2, "a") > High(1, "z")} ${Low.compare(Low)} ${High(1, "a") <= High(1, "a")}")
    println([High(1, "b"), Low, Mid(3), High(1, "a"), Mid(1), Low].toList.sorted)
    println(s"${Spread(1).compare(Spread(3))} ${Spreads(Spread(1)).compare(Spreads(Spread(3)))} ${Spreads(Spread(5)).compare(Spreads(Spread(3)))} ${High(1, "a").compare(Low)}")
