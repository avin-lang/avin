-- alternation
{a,b}: a b
x{a,b}y: xay xby
{a,b}{1,2}: a1 a2 b1 b2
{a,{b,c}}d: ad bd cd
{a}: a
x{}y: xy
{,a}x: x ax
{a,}: a 
{*.c,*.h}: x.c x.h
*.{c,h}: x.c x.h
{文,字}?: 文a 字ü
[ab]{c,d}: ac bd
-- alternatives across components
{src,lib}/*.c: src/x.c lib/x.c
{src/a,b}/x: src/a/x b/x
{/abs,rel}/x: /abs/x rel/x
{**/,}x.c: x.c a/x.c a/b/x.c
src/{**/*.c,*.h}: src/x.c src/a/b/x.c src/x.h
-- braces that are not alternation
{a,b: {a,b
a,b}: a,b}
}{: }{
\{a,b\}: {a,b}
{a\,b,c}: a,b c
{a\}b,c}: a}b c
[{]a,b}: {a,b}
[{,}]: { , }
{[,],x}: , x
{[}],x}: } x
-- ** at the start, middle and end
**/x: x a/x a/b/x a/b/c/x b/x
a/**/x: a/x a/b/x a/b/c/x
a/**: a/x a/b/x a/b/c/x a a/b
**: x a/x a/b/x a/b/c/x a a/b b/x
/**/x: /x /a/x
a/**/**/x: a/x a/b/x a/b/c/x
**/b/**: a/b/x a/b/c/x a/b b/x
a**: a ab
-- escaped characters
\*: *
\?: ?
\[a]: [a]
a\: a\
\\: \
\.h: .h
\a\b: ab
-- hidden names
{.git,src}: .git src
{*,.*}: a .a .. .
*/{.h,x}: a/.h a/x
?{git,h}: xgit
-- glob with alternation
{lib,src}/*.c: [lib/z.c, src/x.c]
{src,lib}/*.c: [lib/z.c, src/x.c]
{src,src}/*.c: [src/x.c]
src/*.{h,c}: [src/x.c, src/x.h]
{**/*.c,nothing}: [lib/z.c, src/a/y.c, src/x.c]
{lib/.*,src/a/*}: [lib/.w.c, src/a/y.c]
{missing,also-missing}: []
{lib}: [lib]
{lib: []
Ok(())
