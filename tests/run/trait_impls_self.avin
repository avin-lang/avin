// An impl adds methods to a trait that mentions `Self`: in them `Self` is the type of the value the
// method is called on, so a method takes and yields one, on a data type, a class and a bounded type
// parameter alike.
trait Ranked
  score() -> int
  beats(other: Self) -> bool = score() > other.score()

impl Ranked
  // The better of this and `other`, which is of the same type.
  better(other: Self) -> Self = if beats(other) then self else other

data Card(value: int)

impl Ranked for Card
  score() -> int = value

class Player(val points: int): Ranked
  override score() -> int = points

pick[R: Ranked](a: R, b: R) -> R = a.better(b)

main()
  println(Card(3).better(Card(5)).value)
  println(Player(9).better(Player(2)).points)
  println(pick(Card(8), Card(1)).value)
