// expect: trap
// A machine handling an event is busy until it is done: handling another from inside one of its own
// arms traps, as taking a mutex already held does, rather than running a second handler over the
// first one's state.
data Ev
  Kick
  Echo

machine Relay receives Ev
  var me: Option[Relay] = None

  state Ready
    Kick ->
      println("kick")
      if me is Some(r) then r.handle(Echo)
      stay
    Echo -> stay

main() -> int
  val r = Relay()
  r.me = Some(r)
  r.handle(Echo)
  println("echo handled")
  r.handle(Kick)
  println("unreachable")
  0
