// expect: trap
// `between` with a least value that is not below the greatest has nothing to give, and traps; for a
// `real`, so does a NaN bound.
import avin.random.Random

main()
    val g = Random(1)
    println(g.between(1.0, 1.5) < 1.5)
    println(g.between(2.0, real.NaN))
    println("not reached")
