// An object may extend a class: the superclass's constructor runs first with the arguments written
// after `:`, the object overrides methods like a subclass, and it passes wherever the superclass is
// expected. Objects are made before `main`, after the module values their construction reads.
trait Display
    show() -> string

abstract class Shape(val label: string)
    area() -> int
    describe() -> string = s"$label: ${area()}"

open class Account(owner: string, var balance: int)
    print(s"opened an account for $owner, starting at $start")
    describe() -> string = s"$owner: $balance"
    deposit(amount: int)
        balance += amount

note(text: string) -> string
    print(text)
    text

// Declared before `Default` and needing nothing of it, so made before it.
val first = note("first")

// An object implementing an abstract class's abstract method.
object UnitSquare: Shape("unit square")
    override area() -> int = 1

// An object extending an open class and a trait, overriding a method and calling the superclass's.
object Default: Account(note("default"), 0), Display
    val created = "created"
    override describe() -> string = "default " + super.describe()
    override show() -> string = describe()

// The superclass's body reads `start`, so `start` is made before `Default` although declared after.
val start = 100

report(a: Account) = print(a.describe())

total(shapes: List[Shape]) -> int = shapes match
    Cons(s, rest) -> s.area() + total(rest)
    Empty -> 0

data List[+T]
    Cons(head: T, tail: List[T])
    Empty

class Rect(w: int, h: int): Shape("rect")
    override area() -> int = w * h

main()
    print(UnitSquare.describe())
    val s: Shape = UnitSquare
    print(s"${s.area()} ${s.label}")
    print(s"${total(Cons(Rect(2, 3), Cons(UnitSquare, Empty)))}")
    report(Default)
    Default.deposit(5)
    Default.balance += 1
    report(Default)
    val d: Display = Default
    print(d.show())
    print(Default.created)
    val chosen: Account = if Default.balance > 3 then Default else Account("ada", 3)
    report(chosen)
    print(s"${chosen === Default}")
