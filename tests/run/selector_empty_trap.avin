// expect: trap
// `wait` on a selector with no entries traps, as a select with every arm guarded off does: nothing but
// a cancellation could end it. Emptied by `remove`, it traps the same.
import avin.threads.{Channel, Selector}

main()
  val sel = Selector[int]()
  val a = Channel[int](1)
  sel.receive(a, 1)
  a.send(1)
  println(sel.wait())
  println(sel.remove(1), sel.isEmpty)
  println(sel.wait())
