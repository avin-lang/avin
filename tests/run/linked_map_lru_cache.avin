// expect: exit 0
// A least-recently-used cache written over a linked map: a hit moves its key to the end, an insert past
// the capacity evicts the oldest entry with `removeFirst()`.

import avin.collections.mutable.LinkedMap

class LruCache[K: Eq & Hash & Display, V](private val capacity: int)
  private val entries = LinkedMap[K, V]()
  var hits = 0
  var misses = 0
  var evictions = 0
  var lastEvicted = ""

  get(key: K) -> Option[V]
    entries.get(key) match
      Some(v) ->
        entries.moveToEnd(key)
        hits += 1
        Some(v)
      None ->
        misses += 1
        None

  put(key: K, value: V)
    entries.putLast(key, value)
    if entries.size > capacity
      val (evicted, _) = entries.removeFirst()
      evictions += 1
      lastEvicted = s"$evicted"

  keys() -> Vector[K] = entries.keys

main()
  val cache = LruCache[string, int](3)
  cache.put("a", 1)
  cache.put("b", 2)
  cache.put("c", 3)
  println(cache.keys())
  println(cache.get("a"))
  println(cache.keys())
  cache.put("d", 4)
  println(cache.keys())
  println(cache.get("b"))
  cache.put("c", 30)
  cache.put("e", 5)
  println(cache.keys())
  println(s"${cache.hits} ${cache.misses} ${cache.evictions} ${cache.lastEvicted}")

  // A capacity of one, and a long run over a larger key space.
  val tiny = LruCache[int, int](1)
  for i in 0 ..< 5 do tiny.put(i, i)
  println(s"${tiny.keys()} ${tiny.evictions} ${tiny.lastEvicted}")
  val big = LruCache[int, int](100)
  for i in 0 ..< 5000
    val key = (i * 37) % 250
    if big.get(key) is None then big.put(key, i)
  println(s"${big.keys().length} ${big.hits} ${big.misses} ${big.evictions}")
