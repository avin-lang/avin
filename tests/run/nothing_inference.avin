// expect: exit 0
// A type argument that nothing settles and that a call's result names only where a value is read out
// is `Nothing`: `None` alone is an `Option[Nothing]`, `Left(1)` an `Either[int, Nothing]`, `Ok(1)` a
// `Result[int, Nothing]`, `[]` a `Vector[Nothing]`. No value has type `Nothing`, so such a value is
// one of any instance of its type, a value type's too, across modules' values and functions alike.

val noneYet = None

val leftOnly = Left(5)

class Holder
  val held = Ok("fine")

open class Animal(val name: string)
class Cat: Animal("cat")
class Dog: Animal("dog")

show[T](o: Option[T]) -> string = if o.isDefined then "some" else "none"

count[T](xs: Vector[T]) -> int = xs.length

takesInts(o: Option[int]) -> int = o.getOrElse(7)

takesNames(o: Option[string]) -> string = o.getOrElse("nobody")

main()
  // Unannotated, and used only as what they are.
  val none = None
  val left = Left(1)
  val ok = Ok(1)
  val empty = []
  val vector = Vector.empty()
  println(s"$none $left $ok $empty $vector ${debug(left)}")
  println(s"${none.isEmpty} ${left.isLeft} ${ok.isOk} ${empty.isEmpty} ${vector.length}")

  // A later use still settles an unknown first: here `T` is `int`.
  val later = None
  val asInts: Option[int] = later
  println(asInts)

  // Branches and collection literals join each side through its least upper bound.
  val sides = [Left(1), Right("a")]
  println(sides)
  val picked = if sides.length > 1 then Left(1) else Right("b")
  println(picked.fold(n -> n + 1, s -> s.byteLength))
  val maybe = if none.isEmpty then Some(3) else None
  println(maybe.map(n -> n * 2))
  val outcomes = [Ok(1), Err("bad"), Ok(2)]
  println(outcomes.filter(r -> r.isOk).length)
  val pets = [Some(Cat()), None, Some(Dog())]
  println(pets.map(p -> p.map(a -> a.name)))

  // Passed to generic functions, which take `Nothing` for their own parameter.
  println(s"${show(None)} ${show(Some(1))} ${count([])}")

  // Module values and fields keep `Nothing`, and are seen as any instance where one is wanted.
  println(s"${takesInts(noneYet)} ${takesNames(noneYet)} $noneYet")
  val e: Either[int, string] = leftOnly
  println(s"$e ${e == Left(5)} ${e.getOrElse("r")}")
  var held: Option[int] = noneYet
  println(s"${held == None} ${held == noneYet}")
  held = Some(4)
  println(held)
  val labels: Vector[Option[int]] = [noneYet, Some(1)]
  println(labels)
  val set: Set[Option[int]] = {noneYet, None, Some(2)}
  println(set.size)
  val result: Result[string, int] = Holder().held
  println(result)

  // Patterns: a `Right` arm of an `Either[int, Nothing]` never matches, and a type pattern takes
  // an `Option[Nothing]` as an option of any type.
  val n = leftOnly match
    Left(v) -> v
    Right(_) -> 0
  println(n)
  val any: Any = noneYet
  val which = any match
    o: Option[string] -> s"option $o"
    _ -> "other"
  println(which)
  val anyLeft: Any = leftOnly
  val side = anyLeft match
    x: Either[int, string] -> s"either $x"
    _ -> "other"
  println(side)
