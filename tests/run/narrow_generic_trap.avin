// expect: trap
// Converting to a type parameter bounded by `Integer` narrows at the width each instance has.

narrow[T: Integer](n: long) -> T = T(n)

main() -> int
    val small: i5 = narrow(15)
    val least: i5 = narrow(-16)
    println(small, least)
    val tooBig: i5 = narrow(16)
    println(tooBig)
    0
