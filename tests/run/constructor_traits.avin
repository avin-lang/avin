// expect: exit 0
// Constructor traits: `Self[B]` in a trait's methods is the constructor implementing it, applied.
// Impls name the holes (`Either[L, _]`, a two-parameter type at either hole) or leave them off where
// they are all the type's parameters (`impl Chainable for Box`); a class conforms in its header or
// by an impl. A type's own methods meet the trait's wherever they are declared: `List`'s overloaded
// `flatMap`, the one taking an `Iterable`; `Result`'s, whose lower-bounded parameter is decided by
// its bound; `Either`'s. A value of `F[X]` has its bound's members, every call through the bound is
// a direct call of the method that met it, and default bodies are compiled per constructor.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]
  mapTwice[B](f: (A) -> A, g: (A) -> B) -> Self[B] = map(a -> g(f(a)))
  describe() -> string = "mapped"

trait Pointed[A]: Mappable[A]
  static pure[X](value: X) -> Self[X]

trait Chainable[A]: Pointed[A]
  flatMap[B](f: (A) -> Self[B]) -> Self[B]
  override describe() -> string = "chained"

data Box[T](value: T)

impl[T] Box[T]
  map[B](f: (T) -> B) -> Box[B] = Box(f(value))
  flatMap[B](f: (T) -> Box[B]) -> Box[B] = f(value)

impl Chainable for Box
  static pure[X](value: X) -> Box[X] = Box(value)

class Crate[A](val item: A): Mappable[A]
  map[B](f: (A) -> B) -> Crate[B] = Crate(f(item))
  override describe() -> string = "a crate"

// A two-parameter type implementing a trait at its first hole and another at its second.
data Tagged[T, E](value: T, tag: E)

impl[T, E] Mappable[T] for Tagged[T, E]
  map[B](f: (T) -> B) -> Tagged[B, E] = Tagged(f(value), tag)

data Labelled[L, R](label: L, value: R)

impl[L, R] Mappable[L] for Labelled[L, R]
  map[B](f: (L) -> B) -> Labelled[B, R] = Labelled(f(label), value)

impl Chainable for List
  static pure[X](value: X) -> List[X] = List(value)

impl Chainable for Option
  static pure[X](value: X) -> Option[X] = Some(value)

impl[T, E] Chainable[T] for Result[T, E]
  static pure[X](value: X) -> Result[X, E] = Ok(value)

impl[L, R] Chainable[R] for Either[L, R]
  static pure[X](value: X) -> Either[L, X] = Right(value)

incr[F[_]: Mappable](x: F[int]) -> F[int] = x.map(n -> n + 1)

twice[F[_]: Mappable](x: F[int]) -> F[string] = x.mapTwice(n -> n * 2, n -> s"<$n>")

pairs[F[_]: Chainable](x: F[int], y: F[string]) -> F[(int, string)] = x.flatMap(a -> y.map(b -> (a, b)))

said[F[_]: Mappable](x: F[int]) -> string = x.describe()

// Generic code passing its constructor parameter on, written.
incrTwice[F[_]: Chainable](x: F[int]) -> F[int] = incr[F](incr[F](x))

nested[F[_]: Mappable](x: F[F[int]]) -> F[F[int]] = x.map(inner -> incr[F](inner))

// Calls through the bound inside closures that capture values of `F[X]`.
later[F[_]: Mappable](x: F[int]) -> () -> F[bool] = () -> x.map(n -> n > 2)

class Holder[F[_]: Mappable](val inner: F[int])
  bumped() -> F[int] = inner.map(n -> n + 100)

main()
  println(incr[Box](Box(1)).value)
  println(incr[Crate](Crate(2)).item)
  println(incr[Tagged[_, string]](Tagged(3, "three")))
  println(incr[Labelled[_, char]](Labelled(4, 'x')))
  println(incr[List](List(5, 6)))
  println(incr[Option](Some(7)))
  println(incr[Option](None))
  println(incr[Result[_, string]](Ok(8)))
  println(incr[Result[_, string]](Err("no")))
  println(incr[Either[string, _]](Right(9)))
  println(incr[Either[string, _]](Left("left")))
  println(twice[Box](Box(10)).value)
  println(twice[Crate](Crate(11)).item)
  println(twice[List](List(12, 13)))
  println(twice[Option](Some(14)))
  println(twice[Tagged[_, bool]](Tagged(15, true)))
  println(pairs[List](List(1, 2), List("a", "b")))
  println(pairs[Option](Some(1), Some("one")))
  println(pairs[Option](Some(1), None))
  println(pairs[Result[_, string]](Ok(2), Ok("two")))
  println(pairs[Result[_, string]](Err("first"), Ok("two")))
  println(pairs[Either[int, _]](Right(3), Left(-3)))
  println(pairs[Box](Box(4), Box("four")).value)
  println(said[Box](Box(0)))
  println(said[Crate](Crate(0)))
  println(said[List](List(0)))
  println(said[Tagged[_, int]](Tagged(0, 0)))
  println(incrTwice[List](List(1)))
  println(incrTwice[Result[_, string]](Ok(1)))
  println(nested[List](List(List(1, 2), List(3))))
  println(nested[Option](Some(Some(1))))
  println(later[Option](Some(3))())
  println(later[List](List(1, 2, 3))())
  println(Holder[Option](Some(1)).bumped())
  println(Holder[List](List(1, 2)).bumped())
  // The type's own methods answer exactly as before, called on the type itself.
  println(List(1, 2).flatMap(n -> List(n, n)))
  println(Box(5).mapTwice(n -> n + 1, n -> n * 3).value)
  println(Some(2).describe())
