// expect: trap
// A repeating timer's interval must be more than zero, since one of zero would send its message
// without end; `after` takes any delay, one of zero or less being due at once.
import avin.actors.spawn
import avin.time as time

actor Spinner receives int
    after(time.Duration.Zero, 1)
    every(0.seconds(), 2)
    receive
        _ -> ()

main()
    spawn(Spinner()).ended().await()
