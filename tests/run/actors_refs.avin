// An `ActorRef` is shown as its behaviour's name and the actor's number, numbered from one in the
// order actors start; it compares and hashes by the actor it refers to, so the reference an actor's
// start is given equals the one `spawn` gave back, and two actors of one behaviour differ, each with
// state of its own. It is sendable: a thread and a future may hold and use one, and it may be kept
// in a `Map` or a `Set`. It is contravariant: a reference that accepts every `Animal` is one that
// accepts `Dog`s. A generic behaviour makes actors of each message type.
import avin.actors.{ActorRef, Behaviour, spawn}
import avin.threads.{Channel, Future, Promise}
import avin.threads as threads

data Ask(reply: Promise[ActorRef[Ask]])

echo() -> Behaviour[Ask] = Behaviour("Echo", me -> a -> a.reply.complete(me))

trait Animal: Sendable
  name() -> string

class Dog(): Animal
  override name() -> string = "dog"

class Cat(): Animal
  override name() -> string = "cat"

data Tally[T](item: T, reply: Promise[string])

// Counts the messages it is sent; every actor of it counts its own.
tally[T: Sendable + Display](name: string) -> Behaviour[Tally[T]] = Behaviour(name, me ->
  var n = 0
  t ->
    n += 1
    t.reply.complete(s"$me: ${t.item} is message $n"))

ask[T: Sendable + Display](r: ActorRef[Tally[T]], item: T) -> string
  val p = Promise[string]()
  r.tell(Tally(item, p))
  p.future.await()

main()
  val e = spawn(echo())
  println(e)
  println(f"[${e}%10s] [${e}%-10s] [${e}%.4s]")
  val p = Promise[ActorRef[Ask]]()
  e.tell(Ask(p))
  val own = p.future.await()
  println(own == e)
  println(own.hash() == e.hash())
  println(own.name)

  val a = spawn(tally[int]("Tally"))
  val b = spawn(tally[int]("Tally"))
  println(a == b)
  println(a != b)
  println(ask(a, 1))
  println(ask(a, 2))
  println(ask(b, 3))
  val s = spawn(tally[string]("Words"))
  println(ask(s, "héllo wörld"))
  println(ask(s, ""))

  val refs = Set(a, b, a)
  println(refs.size)
  val m = Map((a, "first"), (b, "second"))
  println(m(b))

  val fromThread = threads.spawn(() -> ask(a, 10)).join()
  println(fromThread)
  println(Future(ask(b, 20)).await())

  val names = Channel[string]()
  val animals: ActorRef[Animal] = spawn(Behaviour[Animal]("Animals", me -> x -> names.send(x.name())))
  val dogs: ActorRef[Dog] = animals
  dogs.tell(Dog())
  animals.tell(Cat())
  println(names.receive())
  println(names.receive())
  println(dogs == animals)
  println(dogs)
