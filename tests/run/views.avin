// expect: exit 0
// `xs.view()` is a lazy iterator over any collection: nothing is computed until the view is read or
// forced into a strict collection, each element is computed once as it is read, and a pipeline stops
// reading its source as soon as it has what it was asked for, so a view of a billion-element range
// or of an endless iterator can be taken from. `map`, `filter`, `flatMap`, `collect`, `take`, `drop`,
// `takeWhile`, `dropWhile` and `zip` compose, and every collection has a view: lists, vectors,
// arrays, buffers, deques, ranges, sets, maps (entries as pairs), tree maps and sets, the mutable
// sets and maps, and an iterator, whose view is itself.

import avin.collections.mutable.{Map as MutableMap, Set as MutableSet}

class Naturals(private var n: int): Iterator[int]
    override hasNext() -> bool = true
    override next() -> int
        n += 1
        n

main()
    var calls = 0
    val square: (int) -> int = x ->
        calls += 1
        x * x

    // Nothing runs until the view is read, and forcing computes each element once.
    val xs: List[int] = [1, 2, 3, 4, 5]
    val squares = xs.view().map(square)
    print(calls)
    print(squares.toVector())
    print(calls)

    // Composition: each stage runs element by element, in order, and stops at `take`.
    calls = 0
    var tested = 0
    val odd: (int) -> bool = x ->
        tested += 1
        print(s"test $x")
        x % 2 == 1
    val firstTwo = (1..1000000000).view().filter(odd).map(square).take(2).toList()
    print(s"$firstTwo calls=$calls tested=$tested")

    // An endless source: a view stops reading it at the first element `takeWhile` refuses.
    calls = 0
    print(Naturals(0).view().map(square).takeWhile(x -> x < 50).toVector())
    print(calls)

    // flatMap reaches the next element's collection only once the one before is used up.
    var expanded = 0
    val pairs = Naturals(0).view().flatMap(n ->
        expanded += 1
        [n, n * 10]).take(3).toList()
    print(s"$pairs expanded=$expanded")
    print(Vector.empty[int]().view().flatMap(n -> [n]).toList())
    print([1, 2, 3].view().flatMap(n -> if n == 2 then List.empty[int]() else List(n, n)).toVector())

    // collect keeps `pf` of the elements it is defined at.
    print([1, 2, 3, 4, 5, 6].view().collect(match
        n if n % 3 == 0 -> s"fizz$n").toVector())
    print(Naturals(0).view().collect(match
        n if n % 7 == 0 -> n).take(3).toList())

    // drop, dropWhile and zip, with any collection on the right of `zip`.
    print((1..10).view().drop(7).toList())
    print((1..10).view().dropWhile(x -> x < 9).map(x -> -x).toVector())
    val names: Vector[string] = ["a", "b", "c"]
    print(Naturals(0).view().zip(names).toVector())
    print(names.view().zip(Naturals(100)).map(p -> s"${p.0}${p.1}").toList())

    // A view of every kind of collection.
    val vector: Vector[int] = [1, 2, 3]
    print(vector.view().map(x -> x + 1).toList())
    val array = Array.tabulate(4, i -> i * i)
    print(array.view().filter(x -> x > 0).toVector())
    val buffer: Buffer[int] = [5, 6, 7]
    print(buffer.view().take(2).toArray())
    val deque: Deque[int] = [1, 2, 3]
    deque.addFirst(0)
    print(deque.view().drop(1).toBuffer())
    val set: Set[int] = Set(4)
    print(set.view().map(x -> x * 2).toList())
    val map: Map[string, int] = Map(("k", 1))
    print(map.view().map(e -> s"${e.0}=${e.1}").toList())
    val tree = TreeMap(("b", 2), ("a", 1), ("c", 3))
    print(tree.view().filter(e -> e.1 != 2).map(e -> e.0).toVector())
    val treeSet = TreeSet(3, 1, 2)
    print(treeSet.view().map(x -> x * 10).toList())
    val mutableSet = MutableSet[int]()
    mutableSet.add(9)
    print(mutableSet.view().toVector())
    val mutableMap = MutableMap[string, int]()
    mutableMap("z") = 26
    print(mutableMap.view().map(e -> e.1).toList())
    val it = Naturals(0)
    print(it.view() === it)

    // A view is forced into any strict collection, and the methods every Iterable has read it.
    print(xs.view().map(x -> x % 2).toSet().size())
    print(xs.view().filter(x -> x > 2).sum())
    print(xs.view().map(x -> (x, x * x)).toMap()(3))

    // A view reads its source when read, so a change to a mutable source before then is seen.
    val growing: Buffer[int] = [1]
    val later = growing.view()
    growing += 2
    print(later.toList())

    // A comprehension over a view is lazy too: the guard runs element by element.
    val lazyPairs = for n in Naturals(0).view() if n % 2 == 0 yield n * 100
    print(lazyPairs.take(3).toList())
