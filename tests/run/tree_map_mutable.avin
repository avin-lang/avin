// expect: exit 0
// A mutable tree map, driven by thousands of random updates and removals, visits its entries in key
// order and agrees at every step with a sorted-vector model; the ordered queries agree with the model
// at and between keys; then the rest of its methods.

import avin.collections.mutable.{TreeMap as MutableTreeMap}

// The model: pairs sorted by key, updated by linear search.
modelIndex(m: Vector[(int, int)], key: int) -> int
    var i = 0
    while i < m.size && m(i).0 < key do i += 1
    i

modelPut(m: Vector[(int, int)], key: int, value: int) -> Vector[(int, int)]
    val i = modelIndex(m, key)
    if i < m.size && m(i).0 == key
        m.updated(i, (key, value))
    else
        m.take(i) ++ [(key, value)] ++ m.drop(i)

modelRemove(m: Vector[(int, int)], key: int) -> Vector[(int, int)]
    val i = modelIndex(m, key)
    if i < m.size && m(i).0 == key then m.take(i) ++ m.drop(i + 1) else m

modelGet(m: Vector[(int, int)], key: int) -> Option[int]
    val i = modelIndex(m, key)
    if i < m.size && m(i).0 == key then Some(m(i).1) else None

main()
    val tree = MutableTreeMap[int, int]()
    var model: Vector[(int, int)] = []
    var seed: long = 987654321
    var agreed = true
    for step in 0..<4000
        seed = (seed *% 6364136223846793005 +% 1442695040888963407)
        val key = int((seed >> 40) & 255)
        if (seed >> 20) & 3 == 0
            val had = tree.remove(key)
            if had != modelGet(model, key) then agreed = false
            model = modelRemove(model, key)
        else
            tree(key) = step
            model = modelPut(model, key, step)
        if tree.size != model.size then agreed = false
        if step % 97 == 0
            if tree.iterator().toVector != model then agreed = false
            if tree.reverseIterator().toVector != model.reverse then agreed = false
            for probe in -1..<258
                val after = model.find(e -> e.0 >= probe)
                if tree.minAfter(probe) != after then agreed = false
                val before = model.findLast(e -> e.0 < probe)
                if tree.maxBefore(probe) != before then agreed = false
                if tree.get(probe) != modelGet(model, probe) then agreed = false
                if tree.contains(probe) != (modelGet(model, probe) is Some(_)) then agreed = false
    println(agreed)
    println(tree.iterator().toVector == model)
    println(tree.firstKey() == model(0).0)
    println(tree.lastKey() == model.last.0)
    println(tree.headOption == Some(model(0)))
    println(tree.lastOption == Some(model.last))

    // Ranges at and between keys, against the model.
    var rangesAgree = true
    for low in -1..<258 by 7
        for high in -1..<258 by 11
            val r = tree.range(low, high)
            if r.iterator().toVector != model.filter(e -> low <= e.0 < high) then rangesAgree = false
        if tree.rangeFrom(low).iterator().toVector != model.filter(e -> e.0 >= low) then rangesAgree = false
        if tree.rangeTo(low).iterator().toVector != model.filter(e -> e.0 <= low) then rangesAgree = false
        if tree.rangeUntil(low).iterator().toVector != model.filter(e -> e.0 < low) then rangesAgree = false
    println(rangesAgree)

    // Draining from both ends takes the entries in order.
    val drain = tree.copy()
    var fromFront = true
    var count = 0
    while drain.nonEmpty
        val e = if count % 2 == 0 then drain.removeFirst() else drain.removeLast()
        val want = if count % 2 == 0 then model(count / 2) else model(model.size - 1 - count / 2)
        if e != want then fromFront = false
        count += 1
    println(fromFront && count == model.size)
    println(tree.size == model.size)
