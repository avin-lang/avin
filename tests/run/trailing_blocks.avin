// expect: exit 0
// Trailing blocks: an indented block after the line a call ends is the call's last argument. A
// by-name parameter takes the block as its delayed expression, run at each read and not at the call;
// a function parameter takes it as a lambda's body, its parameters written before `->` at the end of
// the call's line. A callee with no other arguments is called with no parentheses.

times(n: int, action: -> unit)
    var i = 0
    while i < n
        action
        i += 1

twice(value: -> int) -> int = value + value

never(value: -> int) -> int = 0

withValue(v: int, f: (int) -> int) -> int = f(v)

zipWith(a: int, b: int, f: (int, int) -> int) -> int = f(a, b)

scope(f: (string) -> unit) = f("inner")

block(body: -> unit) = body

// The block is given to the last parameter, past a defaulted one in between.
labelled(label: string, width: int = 4, body: -> string) -> string = s"$label/$width: $body"

choose(n: int) -> int = n
choose(n: int, body: -> int) -> int = n + body

class Counter(var count: int)
    run(times: int, body: (int) -> unit)
        var i = 0
        while i < times
            body(i)
            i += 1

main() -> int
    var evaluations = 0
    times(3)
        evaluations += 1
        println(s"tick $evaluations")
    // Read twice, so the block runs twice.
    val r = twice
        evaluations += 1
        evaluations
    println(s"twice $r after $evaluations evaluations")
    // Never read, so the block never runs.
    val n = never
        evaluations += 100
        evaluations
    println(s"never $n after $evaluations evaluations")
    val w = withValue(20) x ->
        val doubled = x * 2
        doubled + 1
    println(s"withValue $w")
    val z = zipWith(3, 4) (x, y) ->
        x * y
    println(s"zipWith $z")
    scope s ->
        println(s"scope $s")
        times(2)
            block
                println(s"nested in $s")
    val boxed = labelled("box")
        "contents"
    println(boxed)
    val named = labelled("named", width = 9)
        "contents"
    println(named)
    println(s"choose ${choose(1)}")
    val chosen = choose(1)
        41
    println(s"choose with a block $chosen")
    val counter = Counter(0)
    counter.run(3) i ->
        counter.count += i
    println(s"counter ${counter.count}")
    val xs = [10, 20, 30]
    xs.foreach x ->
        println(s"element $x")
    var total = 0
    xs.foreach x ->
        xs.foreach y ->
            total += x * y
    println(s"total $total")
    0
