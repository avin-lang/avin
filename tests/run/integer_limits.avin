// The limits of the built-in scalar types are constants: the greatest and least value of every
// integer width, of `byte` and of `char`, and for `real` the finite extremes, the infinities and NaN.

limits[T: Integer](value: T) -> string = s"$value"

main() -> int
    println(int.MaxValue, int.MinValue)
    println(long.MaxValue, long.MinValue)
    println(i8.MaxValue, i8.MinValue)
    println(i16.MaxValue, i16.MinValue)
    println(i1.MaxValue, i1.MinValue)
    println(i2.MaxValue, i2.MinValue)
    println(i17.MaxValue, i17.MinValue)
    println(i65.MaxValue, i65.MinValue)
    println(i128.MaxValue, i128.MinValue)
    println(i257.MaxValue, i257.MinValue)
    println(int(byte.MaxValue), int(byte.MinValue))
    println(int(char.MaxValue), int(char.MinValue))
    println(real.MaxValue > 1.0e308, real.MinValue < -1.0e308, real.MinPositiveValue < 1.0e-323)
    println(real.PositiveInfinity, real.NegativeInfinity, real.NaN)
    // The constants take their type from the name, and compare with their neighbours.
    val top: i8 = i8.MaxValue
    if top + i8.MinValue != -1 then return 1
    if int.MaxValue - 1 >= int.MaxValue then return 2
    if long.MinValue >= long.MaxValue then return 3
    if long(int.MaxValue) + 1 != 2147483648 then return 4
    if int.MaxValue +% 1 != int.MinValue then return 5
    if int.MaxValue +| 1 != int.MaxValue then return 6
    if i8.MinValue -| 1 != i8.MinValue then return 7
    if real.MaxValue * 2.0 != real.PositiveInfinity then return 8
    if real.MinValue * 2.0 != real.NegativeInfinity then return 9
    if real.NaN == real.NaN then return 10
    if !(real.MinPositiveValue > 0.0) then return 11
    if real.MinPositiveValue / 2.0 != 0.0 then return 12
    if real.NegativeInfinity >= real.MinValue then return 13
    // A conversion to the width a limit belongs to keeps it, and round trips.
    if i8(i8.MaxValue) != 127 then return 14
    if i8(int(i8.MinValue)) != i8.MinValue then return 15
    if int(long(int.MaxValue)) != int.MaxValue then return 16
    if int(i128(int.MinValue)) != int.MinValue then return 17
    if byte(int(byte.MaxValue)) != byte.MaxValue then return 18
    if char(int(char.MaxValue)) != char.MaxValue then return 19
    // A limit is one more than its neighbour overflows to.
    var n = long.MaxValue - 1
    n += 1
    if n != long.MaxValue then return 20
    println(limits(i8.MaxValue), limits(i65.MinValue))
    0
