// expect: trap
// A trap in a lambda, called through a closure, reports the place in the lambda's body.

divider(n: int) -> (int) -> int = x -> x / n

apply(f: (int) -> int, x: int) -> int = f(x)

main() -> int
  val half = divider(2)
  println(s"${apply(half, 10)}")
  val broken = divider(0)
  apply(broken, 10)
