// env: AVIN_ENVIRONMENT_SET=hello there
// env: AVIN_ENVIRONMENT_EMPTY=
// env: AVIN_ENVIRONMENT_EQUALS=a=b
import avin.process.{env, environment}

// Every variable is in the map with its value, one set to the empty string is there and empty, a
// value may itself hold `=`, and the map agrees with `env` on every name it holds.
main()
  val all = environment()
  println(all.get("AVIN_ENVIRONMENT_SET"))
  println(all.get("AVIN_ENVIRONMENT_EMPTY"))
  println(all.get("AVIN_ENVIRONMENT_EQUALS"))
  println(all.get("AVIN_ENVIRONMENT_UNSET"))
  println(all.contains("PATH"))
  var agree = true
  for (name, value) in all
    if env(name) != Some(value) then agree = false
  println(agree)
  // Each call reads the environment again, into a map of its own.
  println(environment() == all)
