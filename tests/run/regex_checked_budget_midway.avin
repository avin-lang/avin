// expect: exit 0
// A checked search that meets an attempt spending its budget part of the way through a text: the
// matches before it are found, and the error ends the search there. A search that stops before
// reaching that start answers as usual. The budget is each attempt's own: `n` steps are enough for
// a match that takes `n`, and `n - 1` are not.
import avin.regex.{Regex, MatchError}

show[T: Display](label: string, r: Result[T, MatchError]) = r match
    Ok(v) -> println(s"$label: Ok($v)")
    Err(e) -> println(s"$label: Err(${e.inputLength}, ${e.budget})")

main()
    // `x` matches at once at each `x`; at the run of `a`s the second alternative backtracks
    // exponentially.
    val r = Regex("x|(a+)+?$").withStepLimit(100000)
    val text = "x-x-x-" + "a".repeat(40) + "b"
    show("tryFindFirstIn", r.tryFindFirstIn(text))
    show("tryFindPrefixOf", r.tryFindPrefixOf(text))
    show("tryReplaceFirstIn", r.tryReplaceFirstIn(text, "y").map(s -> s.slice(0, 6)))
    show("tryReplaceSomeIn none", r.tryReplaceSomeIn(text, m -> None))
    show("tryFindAllIn", r.tryFindAllIn(text))
    show("tryFindAllMatchIn", r.tryFindAllMatchIn(text))
    show("tryReplaceAllIn", r.tryReplaceAllIn(text, "y"))
    show("trySplit", r.trySplit(text))
    // A split limited to fewer pieces still searches on, as `split` does, and so meets the error.
    show("Pattern.trySplit 2", r.pattern().trySplit(text, 2))
    show("tryMatches anchored", r.tryMatches(text))
    show("tryMatches unanchored", r.unanchored().tryMatches(text))
    // The matches before the error, through the replacer, are seen before the error ends it.
    var seen = 0
    val replaced = r.tryReplaceAllIn(text) m ->
        seen += 1
        "y"
    show("replacer saw", replaced)
    println(seen)

    // The boundary: `a` matching `a` takes two steps, and `(?:a|b)c` matching `bc` six, the first
    // alternative failing and the frame for the second popped among them.
    for limit in 1..3
        show(s"a at $limit", Regex("a").withStepLimit(long(limit)).tryFindFirstIn("a"))
    for limit in 4..7
        show(s"a|b at $limit", Regex("(?:a|b)c").withStepLimit(long(limit)).tryFindFirstIn("bc"))
    // The limit is per attempt, so many starts each within it never add up to an error.
    show("many starts", Regex("abc").withStepLimit(4).tryFindAllIn("abc".repeat(1000)).map(v -> v.length))
    // The largest limit is no limit in practice.
    show("long limit", Regex("abc").withStepLimit(9223372036854775807).tryFindFirstIn("abc"))

    // Many failed searches in a loop, each leaving its matcher to the collector, between
    // successful ones.
    val bad = Regex("(a+)+?$").withStepLimit(2000)
    val a20b = "a".repeat(20) + "b"
    var errors = 0
    var found = 0
    for k in 0..<3000
        if bad.tryFindFirstMatchIn(a20b).isErr() then errors += 1
        bad.tryFindAllMatchIn("aaa") match
            Ok(ms) -> found += ms.length
            Err(_) -> ()
    println(s"$errors $found")
