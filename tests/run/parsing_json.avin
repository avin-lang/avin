// expect: exit 0
// JSON parsed with `avin.parsing` into a data type and printed back: objects, arrays, strings with
// every escape, numbers, `true`, `false` and `null`, nested and empty, with white space anywhere a
// token may be followed by it. Printing a parsed document and parsing the print gives the same value.
import avin.parsing.{Parser, decimal, defer, stringLiteral, symbol, token, whitespace}

data Json
    JNull
    JBool(value: bool)
    JNumber(value: real)
    JString(value: string)
    JArray(items: Vector[Json])
    JObject(fields: Vector[(string, Json)])

lazy val value: Parser[Json] = symbol("null") ^^^ JNull
    | symbol("true") ^^^ JBool(true)
    | symbol("false") ^^^ JBool(false)
    | token(decimal) ^^ (x -> JNumber(x))
    | token(stringLiteral) ^^ (s -> JString(s))
    | defer(array)
    | defer(obj)

lazy val array: Parser[Json] = symbol("[") ~> value.repSep(symbol(",")) <~ symbol("]") ^^ (items -> JArray(items))

lazy val field: Parser[(string, Json)] = token(stringLiteral) <~ symbol(":") ~ value

lazy val obj: Parser[Json] = symbol("{") ~> field.repSep(symbol(",")) <~ symbol("}") ^^ (fields -> JObject(fields))

lazy val document: Parser[Json] = whitespace ~> value

quote(s: string) -> string
    val out = StringWriter()
    out.write("\"")
    for c in s.chars()
        c match
            '"' -> out.write("\\\"")
            '\\' -> out.write("\\\\")
            '\n' -> out.write("\\n")
            '\t' -> out.write("\\t")
            _ -> if int(c) < 0x20 then out.write(s"\\u00${if int(c) < 16 then "0" else "1"}${"0123456789abcdef".slice(int(c) % 16, int(c) % 16 + 1)}") else out.writeChar(c)
    out.write("\"")
    out.text()

show(j: Json) -> string = j match
    JNull -> "null"
    JBool(b) -> s"$b"
    JNumber(x) -> s"$x"
    JString(s) -> quote(s)
    JArray(items) -> items.map(show).mkString("[", ",", "]")
    JObject(fields) -> fields.map(match (k, v) -> quote(k) + ":" + show(v)).mkString("{", ",", "}")

roundTrip(text: string)
    document.parse(text) match
        Ok(j) ->
            val printed = show(j)
            val again = document.parse(printed)
            print(s"$printed ${if again == Ok(j) then "same" else "DIFFERENT"}")
        Err(e) -> print(s"error $e")

main()
    roundTrip("null")
    roundTrip(" true ")
    roundTrip("false")
    roundTrip("[]")
    roundTrip("{}")
    roundTrip("[ ]")
    roundTrip("{ }")
    roundTrip("[[], [[]], {}]")
    roundTrip("0")
    roundTrip("-12")
    roundTrip("3.25")
    roundTrip("-0.5e2")
    roundTrip("1E3")
    roundTrip("2.5e-3")
    roundTrip("\"\"")
    roundTrip("\"plain\"")
    roundTrip("\"q\\\" b\\\\ s\\/ n\\n t\\t r\\r b\\b f\\f\"")
    roundTrip("\"\\u0041\\u00e9\\u4e2d\\ud83d\\ude00\"")
    roundTrip("\"café \u{1F600}\"")
    roundTrip("{\"name\": \"avin\", \"tags\": [\"fast\", \"small\"], \"version\": 1, \"stable\": false, \"next\": null}")
    roundTrip("\n{\n  \"a\" : {\n    \"b\" : [ 1 , 2 , { \"c\" : [ ] } ]\n  }\n}\n")
