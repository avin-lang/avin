// expect: trap
// A pool's `minIdle` is between 0 and its `maxSize`: one above it traps where the pool is made, as a
// negative one does. `minIdle` equal to `maxSize`, and 0, are allowed.
import avin.threads.Pool

main()
  println(Pool[int, string](() -> Ok(1), maxSize = 2, minIdle = 2).stats())
  println(Pool[int, string](() -> Ok(1), maxSize = 1, minIdle = 0).stats())
  val pool = Pool[int, string](() -> Ok(1), maxSize = 2, minIdle = 3)
  println(pool.stats())
