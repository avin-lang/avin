// args: one "two words" ""
import avin.process

// The arguments after the program's name arrive in order, an argument holding a space and an empty
// one included, and the program's name is separate from them.
main()
    val a = process.args()
    println(a.length)
    for x in a do println(s"[$x]")
    println(a)
    println(process.programName().nonEmpty)
    println(a.contains(process.programName()))
