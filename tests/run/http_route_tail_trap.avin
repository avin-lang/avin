// expect: trap
// A `*name` segment matches the rest of a path, so it may only be a pattern's last: `/a/*rest` is
// taken, and so is a bare `*` anywhere, a literal segment; `/a/*rest/b` traps where the route is made.
import avin.net.http.{Response, Route}

main()
  println(Route.get("/a/*rest", _ -> Response.empty(204)).pattern)
  println(Route.get("/*/b", _ -> Response.empty(204)).pattern)
  println(Route.get("/a/*rest/b", _ -> Response.empty(204)).pattern)
