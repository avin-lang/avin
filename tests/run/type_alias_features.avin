// expect: exit 0
// A type alias meets the rest of the language as its expansion: in data fields updated with `with`,
// in class fields, as the type a placeholder lambda is written for, in type patterns, as the result
// of a function using `?`, captured by closures, as a type argument of a generic function and a
// generic class, and in a generic alias of a generic alias.
// `type` stays an ordinary name everywhere but before an alias's name.

type Coord = (int, int)
type Step = (int) -> int
type Parsed = Result[int, string]
type Maybe[T] = Option[T]
type Table[K] = Map[K, Vector[int]]
type Nested[T] = Maybe[Maybe[T]]
type Pairs[T] = Vector[(T, T)]
type PairsOfPairs[T] = Pairs[Pairs[T]]
type Pred[T] = (T) -> bool
type Label = string

data Robot(name: Label, at: Coord, moves: Vector[Step])

class Inventory(val items: Table[string], var last: Maybe[Label])

run(f: Step, n: int) -> int = f(n)

data Kind(type: string)

parse(text: string) -> Parsed = if text == "" then Err("empty") else Ok(text.byteLength)

sum(a: string, b: string) -> Parsed = Ok(parse(a)? + parse(b)?)

half(n: int) -> Maybe[int] = if n % 2 == 0 then Some(n / 2) else None

quarter(n: int) -> Maybe[int] = half(half(n)?)

describe(x: Any) -> string = x match
    c: Coord -> s"coord ${c.0},${c.1}"
    l: Label -> s"label $l"
    o: Maybe[int] -> s"maybe $o"
    _ -> "other"

keep[T](xs: Vector[T], p: Pred[T]) -> Vector[T] = xs.filter(p)

flatten[T](n: Nested[T]) -> Maybe[T] = n match
    Some(Some(v)) -> Some(v)
    _ -> None

counter() -> () -> int
    var n = 0
    val bump: Step = _ + 1
    () ->
        n = bump(n)
        n

type(x: int) -> int = x + 100

main()
    val r = Robot("r2", (0, 0), [x -> x + 1, x -> x * 3])
    val moved = r with { at = (r.moves(0)(r.at.0), r.moves(1)(5)) }
    println(moved.at)
    println(moved.name)
    val renamed: Robot = moved with { name = "c3" }
    println(s"${renamed.name} ${renamed.at}")
    val inv = Inventory({"bolts": [1, 2]}, None)
    inv.last = Some("bolts")
    println(inv.items("bolts").sum)
    println(inv.last)
    println(run(_ * 2, 21))
    val d: Step = _ - 1
    println(run(d, 1))
    println(sum("ab", "cde"))
    println(sum("", "x"))
    println(quarter(12))
    println(quarter(6))
    println(describe((3, 4)))
    println(describe("hi"))
    println(describe(Some(1)))
    println(keep([1, 2, 3, 4], _ > 2))
    val evens: Pred[int] = _ % 2 == 0
    println(keep([1, 2, 3, 4], evens))
    println(flatten(Some(Some("deep"))))
    val none: Nested[string] = Some(None)
    println(flatten(none))
    val pp: PairsOfPairs[int] = [([(1, 2)], [(3, 4)])]
    println(pp(0).1(0).0)
    val next = counter()
    next()
    println(next())
    val kind = Kind("alias")
    println(kind.type)
    println(type(1))
    val type = 7
    println(type + 1)
