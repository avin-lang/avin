// expect: exit 0
// An impl of a trait for a trait type is the trait type's own conformance: a value whose static type
// is the trait has it, through a bound and by a call, whatever type its object is of; a type
// implementing the trait has its own impl or none. The impl's methods work on the value as the
// trait, calling the trait's members by bare name and through `self`.
trait Show
  show() -> string
  twice() -> string = show() + show()

trait Shape
  area() -> int
  val label: string

class Square(side: int, val label: string = "square"): Shape
  override area() -> int = side * side

class Loud(side: int, val label: string = "loud"): Shape, Show
  override area() -> int = side
  override show() -> string = "LOUD"

data Dot(label: string)

impl Shape for Dot
  area() -> int = 0

impl Show for Shape
  show() -> string = s"$label of ${area()}"
  twice() -> string = show() + "+" + self.show()

impl[A: Show] Show for Vector[A]
  show() -> string
    var out = "["
    for x in self
      out = out + x.show() + ";"
    out + "]"

impl[A: Show] Show for Option[A]
  show() -> string = self match
    Some(x) -> "some " + x.show()
    None -> "none"

shown[T: Show](x: T) -> string = x.show() + "/" + x.twice()

main()
  val s: Shape = Square(3)
  val l: Shape = Loud(2)
  val d: Shape = Dot("dot")
  // By a call on the trait type.
  println(s.show())
  println(s.twice())
  println(l.show())
  println(d.show())
  // The implementing type's own impl is its own.
  println(Loud(2).show())
  println(Loud(2).twice())
  // Through a bound, the type argument decides.
  println(shown(s))
  println(shown(l))
  println(shown(Loud(2)))
  println(shown[Shape](Loud(2)))
  // As a type argument and nested.
  val shapes: Vector[Shape] = [s, l, d]
  println(shown(shapes))
  val none: Vector[Shape] = []
  println(shown(none))
  val some: Option[Shape] = Some(s)
  val missing: Option[Shape] = None
  println(shown(some))
  println(shown(missing))
  val deep: Vector[Option[Vector[Shape]]] = [Some(shapes), None]
  println(shown(deep))
  // A value of the conformance's trait is one only where its own type implements it.
  val a: Any = s
  a match
    x: Show -> println("a show " + x.show())
    _ -> println("no show")
  val b: Any = l
  b match
    x: Show -> println("a show " + x.show())
    _ -> println("no show")
  // In a closure and over a loop.
  val f = () -> s.show()
  println(f())
  println(shapes.map(x -> x.show()).mkString(","))
  var total = ""
  for x in shapes do total = total + shown(x)
  println(total)
