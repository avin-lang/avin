// expect: exit 0
// A generic trait whose members are all static is implemented by one type at several type
// arguments: by impls for a data type and a built-in type, and in a class's header. A call on the
// type picks the member by its parameter types, and a function bounded by one instance, or by two
// of one trait, calls the member that instance names in each of its instances.

trait Make[E]
  static make(source: E) -> Self

data Shape
  Circle(radius: int)
  Label(text: string)

impl Make[int] for Shape
  static make(source: int) -> Shape = Circle(source)

impl Make[string] for Shape
  static make(source: string) -> Shape = Label(source)

impl Make[int] for string
  static make(source: int) -> string = s"#$source"

impl Make[bool] for string
  static make(source: bool) -> string = if source then "yes" else "no"

class Note(val text: string): Make[int], Make[string]
  override static make(source: int) -> Note = Note(s"int $source")
  override static make(source: string) -> Note = Note(s"string $source")

fromInt[T: Make[int]](n: int) -> T = T.make(n)

fromText[T: Make[string]](s: string) -> T = T.make(s)

fromFlag[T: Make[bool]](b: bool) -> T = T.make(b)

pair[T: Make[int] + Make[string]](n: int, s: string) -> (T, T) = (T.make(n), T.make(s))

main()
  println(Shape.make(3))
  println(Shape.make("square"))
  println(string.make(7))
  println(string.make(true))
  println(Note.make(1).text)
  println(Note.make("a").text)
  println(fromInt[Shape](4))
  println(fromText[Shape]("tri"))
  println(fromInt[string](5))
  println(fromFlag[string](false))
  println(fromInt[Note](6).text)
  println(fromText[Note]("b").text)
  println(pair[Shape](8, "hex"))
  val notes = pair[Note](9, "c")
  println(notes.0.text)
  println(notes.1.text)
