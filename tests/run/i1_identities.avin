// `i1` keeps its `zero()`, and every other width keeps its `1`.

oneOf[T: Mul]() -> T = T.one()
zeroOf[T: Add]() -> T = T.zero()

main()
    print(s"${i1.zero()} ${zeroOf[i1]()}")
    print(s"${i2.one()} ${oneOf[i2]()} ${i8.one()} ${int.one()} ${long.one()}")
    print(s"${i64.one()} ${i128.one()} ${oneOf[i128]()} ${i257.one()}")
