// expect: exit 0
// Map methods on the immutable and the mutable map: `++` takes any collection of pairs, `--` any
// collection of keys, `keys()` and `values()` are vectors in the map's own iteration order,
// `keySet`, `filterKeys`, `transform` and `updatedWith` / `updateWith` bind, replace and remove, and
// a mutable map changes in place through `+=`, `-=`, `++=` and `--=` on a `val`. Entries are
// printed sorted, since iteration order is not specified.

import avin.collections.mutable.{Map as MutableMap}

show(m: Map[int, string]) -> string
    val keys = m.keys.sorted()
    keys.map(k -> s"$k=${m(k)}").mkString(",")

showMutable(m: MutableMap[int, string]) -> string
    val keys = m.keys.sorted()
    keys.map(k -> s"$k=${m(k)}").mkString(",")

showSet(s: Set[int]) -> string = s.toVector.sorted().mkString(",")

main()
    val a = Map[int, string]().updated(1, "a").updated(2, "b").updated(3, "c")
    val none = Map[int, string]()
    val noKeys: Vector[int] = []

    val extra: Vector[(int, string)] = [(3, "C"), (4, "D")]
    println(s"[${show(a ++ extra)}] [${show(a ++ none)}] [${show(none ++ a)}] [${show(none ++ none)}]")
    println(s"[${show(a ++ Map[int, string]().updated(2, "B"))}]")
    println(s"[${show(a -- [1, 9])}] [${show(a -- noKeys)}] [${show(none -- [1])}] [${show(a -- a.keySet)}]")
    println(s"[${show(a)}]")

    val ks = a.keys
    val vs = a.values
    var aligned = true
    for i in 0..<ks.length do aligned = aligned && a(ks(i)) == vs(i)
    var entries = 0
    for (k, v) in a
        aligned = aligned && ks(entries) == k && vs(entries) == v
        entries += 1
    println(s"${ks.length} ${vs.length} $aligned [${ks.sorted().mkString(",")}] [${vs.sorted().mkString(",")}]")
    println(s"${none.keys.isEmpty} ${none.values.isEmpty} ${none.keySet.isEmpty}")
    println(s"[${showSet(a.keySet)}] ${a.keySet.contains(2)} ${a.keySet.contains(5)}")

    println(s"[${show(a.filterKeys(k -> k != 2))}] [${show(a.filterKeys(k -> false))}] [${show(a.filterKeys(k -> true))}] [${show(none.filterKeys(k -> true))}]")
    val t = a.transform((k, v) -> s"$k$v")
    println(s"[${show(t)}] ${none.transform((k, v) -> v).isEmpty}")
    val lengths: Map[int, int] = a.transform((k, v) -> k * v.byteLength())
    println(s"${lengths(1)} ${lengths(2)} ${lengths(3)}")

    val added = a.updatedWith(4, o -> Some("d"))
    val replaced = a.updatedWith(2, o -> o match
        Some(v) -> Some(v + v)
        None -> None)
    val removed = a.updatedWith(2, o -> None)
    val absent = a.updatedWith(9, o -> None)
    println(s"[${show(added)}] [${show(replaced)}] [${show(removed)}] [${show(absent)}] [${show(a)}]")

    val m = MutableMap[int, string]()
    val n = MutableMap[int, string]()
    m += (1, "a")
    m += (2, "b")
    m += (2, "B")
    println(s"[${showMutable(m)}] ${m.size}")
    m ++= extra
    m ++= none
    println(s"[${showMutable(m)}]")
    m -= 3
    m -= 99
    println(s"[${showMutable(m)}]")
    m --= [1, 77]
    m --= noKeys
    println(s"[${showMutable(m)}]")
    n ++= a
    n --= a.keySet
    println(s"[${showMutable(n)}] ${n.isEmpty}")
    n ++= a
    println(s"[${showMutable(n)}]")

    val mk = m.keys
    val mv = m.values
    var mAligned = mk.length == mv.length
    for i in 0..<mk.length do mAligned = mAligned && m(mk(i)) == mv(i)
    println(s"${mk.length} $mAligned [${mk.sorted().mkString(",")}] [${mv.sorted().mkString(",")}] [${showSet(m.keySet)}]")
    println(s"${MutableMap[int, string]().keys.isEmpty} ${MutableMap[int, string]().values.isEmpty} ${MutableMap[int, string]().keySet.isEmpty}")

    val doubled = n.mapValues(v -> v + v)
    val tagged = n.transform((k, v) -> s"$k$v")
    n(1) = "z"
    println(s"[${showMutable(doubled)}] [${showMutable(tagged)}] [${showMutable(n)}]")
    val flipped = n.map((k, v) -> (k * 10, v))
    val fanned = n.flatMap(e -> [(e.0, e.1), (e.0 + 100, e.1)])
    println(s"[${showMutable(flipped)}] [${showMutable(fanned)}]")
    println(s"${MutableMap[int, string]().map((k, v) -> (k, v)).isEmpty} ${MutableMap[int, string]().flatMap(e -> [e]).isEmpty}")
    println(s"[${showMutable(n.filterKeys(k -> k > 1))}] [${showMutable(n.filterKeys(k -> false))}]")

    println(s"${n.updateWith(7, o -> Some("g"))} ${n.updateWith(7, o -> o.map(v -> v + "!"))} ${n.updateWith(1, o -> None)} ${n.updateWith(8, o -> None)}")
    println(s"[${showMutable(n)}]")

    val r = MutableMap[int, string]()
    r ++= a
    r.filterInPlace((k, v) -> k != 2)
    println(s"[${showMutable(r)}]")
    r.filterInPlace((k, v) -> true)
    println(s"[${showMutable(r)}]")
    r.filterInPlace((k, v) -> false)
    println(s"[${showMutable(r)}] ${r.isEmpty}")
    println(s"${r.getOrElseUpdate(5, "five")} [${showMutable(r)}]")
