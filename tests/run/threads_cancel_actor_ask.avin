// expect: exit 0
// A scope's thread parked in an actor's `ask` is cancelled like any thread awaiting a future: it stops
// at once, with nothing after the `await` run and no result, while the actor it asked is untouched.
// The actor's turn here is itself parked, mid-wait, when the asker is cancelled; it goes on once
// released, handles the cancelled thread's question in its place among the messages told to it, and
// replies to an ask nobody awaits any more, which changes nothing. The messages after it are handled
// in the order told, one turn at a time, and the actor answers the next ask as usual. Neither the
// cancelled ask's timeout nor its timer holds the program: the reply takes the timer out.
import avin.actors.{ActorRef, Behaviour, spawn}
import avin.threads.{Atomic, Channel, Promise, scope, sleep}
import avin.time

data Msg
  Hold(entered: Promise[unit], gate: Promise[unit])
  Get(reply: ActorRef[int])
  Note(n: int)

// Logs every message it handles to `seen`, and counts the questions it has answered.
actor Keeper(seen: Channel[string]) receives Msg
  var gets = 0
  val active = Atomic[int](0)
  receive
    m ->
      if active.add(1) != 1 then seen.send("overlap")
      m match
        Hold(entered, gate) ->
          entered.complete(())
          gate.future.await()
          seen.send("held")
        Get(reply) ->
          gets += 1
          seen.send(s"get $gets")
          reply.tell(gets)
        Note(n) -> seen.send(s"note $n")
      active.add(-1)
      ()

// Cancels a scope whose one thread asks `k` and is parked in the ask's `await`, and answers that
// thread's result and how many times code after the `await` ran.
cancelledAsk(k: ActorRef[Msg]) -> (Option[Result[int, avin.actors.AskError]], int)
  val asking = Atomic(0)
  val after = Atomic(0)
  val t = scope(s ->
    val t = s.spawn(() ->
      asking.store(1)
      val got = k.ask(r -> Get(r), time.seconds(30)).await()
      after.add(1)
      got)
    while asking.load() == 0 do sleep(time.millis(1))
    sleep(time.millis(30))
    s.cancel()
    t)
  (t.result(), after.load())

main()
  val start = time.monotonic()
  val seen = Channel[string](100)
  val k = spawn(Keeper(seen))
  // The actor's turn parks on the gate; the ask is told behind it and cannot be handled meanwhile.
  val entered = Promise[unit]()
  val gate = Promise[unit]()
  k.tell(Hold(entered, gate))
  entered.future.await()
  val (result, after) = cancelledAsk(k)
  println(result)
  println(after)
  for n in 1 .. 3 do k.tell(Note(n))
  gate.complete(())
  // The actor answers the next ask, the cancelled one having been its first.
  println(k.ask(r -> Get(r), time.seconds(5)).await())
  for _ in 0 ..< 6 do println(seen.receive().get)
  // Many askers cancelled at once while the actor's turn is parked; each question is still handled,
  // in turn, after the gate.
  val entered2 = Promise[unit]()
  val gate2 = Promise[unit]()
  k.tell(Hold(entered2, gate2))
  entered2.future.await()
  val asking = Atomic(0)
  val ts = scope(s ->
    val ts = (0 ..< 20).toVector.map(_ -> s.spawn(() ->
      asking.add(1)
      k.ask(r -> Get(r), time.seconds(30)).await()))
    while asking.load() < 20 do sleep(time.millis(1))
    sleep(time.millis(30))
    s.cancel()
    ts)
  println(ts.count(t -> t.result().isEmpty))
  gate2.complete(())
  println(k.ask(r -> Get(r), time.seconds(5)).await())
  var lines: Vector[string] = Vector()
  for _ in 0 ..< 22 do lines = lines :+ seen.receive().get
  println(lines(0))
  println(lines(21))
  println(lines.count(l -> l == "overlap"))
  println(time.monotonic() - start < time.seconds(10))
