// expect: trap
// A `__Host-` cookie is `Secure` with `Path=/` and no `Domain`; one made otherwise traps.
import avin.net.http.SetCookie

main()
  println(SetCookie("__Host-a", "1", path = Some("/"), secure = true).header)
  println(SetCookie("__Host-a", "1", path = Some("/x"), secure = true).header)
