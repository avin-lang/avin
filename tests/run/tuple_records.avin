// expect: exit 0
// A tuple's record names its parts' records, and a tuple is seen as another tuple type part by
// part: equality, hashing, `Display` and `Debug` hold for tuples of every arity from 0 to 6, nested,
// held as `Any`, as a trait, in generic code, as map keys, and with option and result parts; and a
// type pattern on a tuple type of traits matches each tuple whose class and data parts conform,
// however many parts conform in however many ways, nested tuples part by part. A part of a built-in
// type is never boxed inside a tuple already made, so it is seen only as its own type.

trait Shape
  area() -> int

data Square(side: int) derives Display
data Rect(w: int, h: int) derives Display

impl Shape for Square
  area() -> int = side * side

impl Shape for Rect
  area() -> int = w * h

open class Animal(val name: string)

class Dog(name: string): Animal(name)

asAny(x: Any) -> Any = x

same(a: Any, b: Any) -> bool = a == b

hashOf(a: Any) -> long = a.hash()

render(a: Any) -> string = s"$a"

debugged(a: Any) -> string = debug(a)

shownAs(d: Display) -> string = d.toString()

eqGeneric[T](a: T, b: T) -> bool = a == b

hashGeneric[T](a: T) -> long = a.hash()

showGeneric[T: Display](a: T) -> string = s"$a"

debugGeneric[T: Debug](a: T) -> string = debug(a)

kind(x: Any) -> string = x match
  _: (Display, Display, Display, Display, Display, Display) -> "six shown"
  _: (Shape, int) -> "shape and int"
  _: ((Shape, Shape), int) -> "nested shapes"
  _: (Animal, int) -> "animal and int"
  _: (Display, Display) -> "two shown"
  _ -> "other"

line(label: string, a: Any, b: Any)
  // Equal values hash alike; the last word says so where they are equal, and is true otherwise.
  println(s"$label: ${render(a)} ${debugged(a)} ${same(a, b)} ${!same(a, b) || hashOf(a) == hashOf(b)}")

main()
  // Every arity, held as Any: shown, debugged, compared and hashed through the object's record.
  line("0", asAny(()), asAny(()))
  line("2", asAny((1, "a")), asAny((1, "a")))
  line("3", asAny((1, 'b', true)), asAny((1, 'b', true)))
  line("4", asAny((1, 2, 3, 4)), asAny((1, 2, 3, 5)))
  line("5", asAny((1, 2.5, "c", 'd', false)), asAny((1, 2.5, "c", 'd', false)))
  line(
    "6",
    asAny((Some(1), Some(2), Some(3), Some(4), Some(5), Some(6))),
    asAny((Some(1), Some(2), Some(3), Some(4), Some(5), Some(6)))
  )
  line(
    "6 none",
    asAny((Some(1), Some(2), Some(3), Some(4), Some(5), None)),
    asAny((Some(1), Some(2), Some(3), Some(4), Some(5), Some(6)))
  )
  line("nested", asAny(((1, "x"), (Some(2), (3, 'y')))), asAny(((1, "x"), (Some(2), (3, 'y')))))
  line("nested differ", asAny(((1, "x"), (Some(2), (3, 'y')))), asAny(((1, "x"), (Some(2), (3, 'z')))))
  val ok: Result[int, string] = Ok(1)
  val err: Result[int, string] = Err("bad")
  line("result", asAny((ok, err)), asAny((ok, err)))
  line("result differ", asAny((ok, err)), asAny((err, ok)))
  line("data parts", asAny((Square(2), Rect(1, 3))), asAny((Square(2), Rect(1, 3))))
  line("different types", asAny((1, 2)), asAny((long(1), 2)))

  // As a trait object: a tuple whose parts are all Display is Display.
  println(shownAs((Some(1), Some(2), Some(3), Some(4), Some(5), Some(6))))
  println(shownAs(((1, 2), "three")))
  println(shownAs(()))

  // Generic code at tuple type arguments.
  println(eqGeneric((Some(1), Some(2), Some(3)), (Some(1), Some(2), Some(3))))
  println(eqGeneric((Some(1), None, Some(3)), (Some(1), Some(2), Some(3))))
  println(hashGeneric((Some(1), "a")) == hashGeneric((Some(1), "a")))
  println(showGeneric((Some(1), (Some('x'), None[int]))))
  println(debugGeneric((Some("s"), Ok[int, string](4), (1, 'c'))))

  // Tuples of options as map keys.
  var counts: Map[(Option[int], string), int] = Map()
  counts = counts.updated((Some(1), "a"), 1)
  counts = counts.updated((None, "a"), 2)
  counts = counts.updated((Some(1), "a"), 3)
  println(counts.size)
  println(counts((Some(1), "a")))
  println(counts((None, "a")))
  var anyKeys: Map[Any, string] = Map()
  anyKeys = anyKeys.updated((Some(1), Some(2), Some(3), Some(4), Some(5), Some(6)), "six")
  anyKeys = anyKeys.updated((1, 2), "pair")
  println(anyKeys((Some(1), Some(2), Some(3), Some(4), Some(5), Some(6))))
  println(anyKeys((1, 2)))
  println(anyKeys.get((2, 1)).isDefined)

  // Type patterns on tuples of traits, tested part by part.
  println(kind((Some(1), Some(2), Some(3), Some(4), Some(5), Some(6))))
  println(kind((1, "a", 'c', true, 2.5, ())))
  println(kind((1, "a", 'c', true, 2.5)))
  println(kind((Square(3), 4)))
  println(kind((Rect(1, 2), 4)))
  println(kind((Square(3), long(4))))
  println(kind((Some(1), "s")))
  println(kind(((Square(1), Rect(2, 3)), 4)))
  println(kind(((Square(1), 2), 4)))
  println(kind((Dog("rex"), 1)))
  println(kind((Animal("any"), 1)))
  println(kind((1, 2, 3)))
  println(kind(1))
  println(kind((Some(1), (), "s")))
  println(kind(((Square(1), 2), 3)))
  println(kind(((Square(1), Rect(2, 2)), long(4))))
  println(kind((Some(Square(1)), Some(Rect(1, 1)))))

  // A part seen as a trait is bound and called through it.
  val seen: Any = (Square(4), 2)
  seen match
    p: (Shape, int) -> println(p.0.area() + p.1)
    _ -> println("no")
  val nested: Any = ((Square(2), Rect(3, 3)), 1)
  nested match
    p: ((Shape, Shape), int) -> println(p.0.0.area() + p.0.1.area() + p.1)
    _ -> println("no")
  val options: Any = (Some(1), Some("two"))
  options match
    p: (Display, Display) -> println(s"${p.0} and ${p.1}")
    _ -> println("no")

  // A tuple type with trait parts made directly is its own type, shown and compared as one.
  val direct: (Display, int) = (Some(5), 6)
  println(direct)
  println(render(direct))
  println(same(direct, direct))
  val shapes: (Shape, Shape) = (Square(2), Rect(2, 5))
  println(shapes.0.area() + shapes.1.area())
  println(kind((shapes, 1)))
