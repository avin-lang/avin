// expect: trap
// A scope is cancelled while it is open: `cancel` on a scope that has returned traps, as `spawn` does.
import avin.threads.{Scope, scope}

main()
    var kept: Option[Scope] = None
    println(scope(s ->
        kept = Some(s)
        1))
    kept match
        Some(s) -> s.cancel()
        None -> ()
