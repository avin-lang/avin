// env: AVIN_PROCESS_SET=hello there
// env: AVIN_PROCESS_EMPTY=
import avin.process.env

// A variable that is set has its value, one set to the empty string is present and empty, and one that
// is not set is `None`.
main()
    println(env("AVIN_PROCESS_SET"))
    println(env("AVIN_PROCESS_EMPTY"))
    println(env("AVIN_PROCESS_UNSET"))
    env("AVIN_PROCESS_SET") match
        Some(v) -> println(v.charCount)
        None -> println("missing")
    println(env("AVIN_PROCESS_SET").getOrElse("?"))
    println(env("AVIN_PROCESS_UNSET").getOrElse("?"))
