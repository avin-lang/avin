// env: AVIN_PROCESS_SET=hello there
// env: AVIN_PROCESS_EMPTY=
import avin.process.env

// A variable that is set has its value, one set to the empty string is present and empty, and one that
// is not set is `None`.
main()
    print(env("AVIN_PROCESS_SET"))
    print(env("AVIN_PROCESS_EMPTY"))
    print(env("AVIN_PROCESS_UNSET"))
    env("AVIN_PROCESS_SET") match
        Some(v) -> print(v.charCount())
        None -> print("missing")
    print(env("AVIN_PROCESS_SET").getOrElse("?"))
    print(env("AVIN_PROCESS_UNSET").getOrElse("?"))
