// expect: exit 0
// Neither side of a read-write lock waits for ever while the other keeps coming. Readers who overlap
// one another without a gap, so that the lock is never free of readers, still let a writer in: once
// it waits, new readers wait behind it. And writers who follow one another without a gap still let a
// reader in: when a write ends, the readers waiting for it go in before the next writer. Without
// either rule the side kept out would wait for ever, and the test with it.
import avin.threads.{Atomic, RwLock, scope, sleep}
import avin.time

main()
  // Sixteen readers, each holding the lock a millisecond and coming straight back, until the writer
  // has written twenty times.
  val value = RwLock(0)
  val writerDone = Atomic(false)
  val readsMeanwhile = Atomic(0)
  scope(s ->
    for _ in 0 ..< 16
      s.spawn(() ->
        while !writerDone.load()
          value.read(v ->
            sleep(time.millis(1))
            v)
          readsMeanwhile.add(1))
    s.spawn(() ->
      sleep(time.millis(5))
      for _ in 0 ..< 20 do value.update(v -> v + 1)
      writerDone.store(true)))
  println(s"writes ${value.get()}")

  // Eight writers, each holding the lock a millisecond and coming straight back, until the reader has
  // read twenty times.
  val other = RwLock(0)
  val readerDone = Atomic(false)
  val seen = Atomic(0)
  scope(s ->
    for _ in 0 ..< 8
      s.spawn(() ->
        while !readerDone.load()
          other.write(v ->
            sleep(time.millis(1))
            v)
          other.update(v -> v + 1))
    s.spawn(() ->
      sleep(time.millis(5))
      for _ in 0 ..< 20 do seen.store(other.get())
      readerDone.store(true)))
  println(s"reads done, the last saw ${seen.load() <= other.get()}")
