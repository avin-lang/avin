// The variadic forms separate the values with `, ` and are not a tuple: `println(1, 2, 3)` prints
// `1, 2, 3` and `print(1, 2, 3)` the same without the new line.
// expect: exit 0
main()
    println(1, 2, 3)
    print(1, "two", 'c')
    print(" | ")
    print(4, 5)
    println()
    println("x", 2.5)
    println((1, 2))
    println((1, 2), 3, [4])
    print("a", "b", "c", "d", "e")
    println()
