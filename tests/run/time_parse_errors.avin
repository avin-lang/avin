// expect: exit 0
// `TimeParseError` among its neighbours: each variant taken apart by a match, `?` carrying one out of
// a function of the caller's, a parse inside a closure and over a vector, errors as map values and
// in a `data` type, the message and the display agreeing, and a parse that never traps on any prefix
// of a valid text.
import avin.time.{
  Date, DateTime, Time, TimeParseError, BadShape, OutOfRange, Trailing, parseDate, parseTime, parseDateTime,
  parseTimestamp, parseZoned, parsePeriod
}

// A date and a time read separately and joined, the first failure carried out by `?`.
joined(day: string, clock: string) -> Result[DateTime, TimeParseError]
  val d = parseDate(day)?
  val t = parseTime(clock)?
  Ok(d.atTime(t))

describe(e: TimeParseError) -> string = e match
  BadShape(_, at, expected) -> s"shape at $at, wanted $expected"
  OutOfRange(_, field) -> s"range of $field"
  Trailing(_, at) -> s"left over from $at"
  TimeParseError.UnknownZone(_, name) -> s"zone $name"

data Attempt(text: string, outcome: Result[Date, TimeParseError])

main()
  println(joined("2026-03-08", "09:30"))
  println(joined("2026-02-30", "09:30"))
  println(joined("2026-03-08", "24:00"))
  println(joined("2026-03-08 ", "09:30"))

  for text in ["2026/03/08", "2026-13-01", "2026-03-08T", "2026-03-08T09:00:00Z[Nowhere/Atall]"]
    val outcome = if text.byteLength > 20 then parseZoned(text).map(z -> z.date) else parseDate(text)
    outcome match
      Ok(d) -> println(d)
      Err(e) -> println(s"${describe(e)}: ${e.message == s"$e"}")

  // Parsed in a closure over a vector, the errors kept by text in a map.
  val texts = ["2026-03-08", "2026-02-29", "2024-02-29", "x"]
  var failures = Map[string, TimeParseError]()
  val good = texts.filter(t -> parseDate(t) match
    Ok(_) -> true
    Err(e) ->
      failures = failures.updated(t, e)
      false)
  println(good)
  println(failures.size)
  println(failures.get("x").map(e -> e.message))

  val attempts = texts.map(t -> Attempt(t, parseDate(t)))
  println(attempts(0) == Attempt("2026-03-08", parseDate("2026-03-08")))
  println(attempts(3).outcome)

  // No prefix of a valid text traps; each is a value or an error.
  var answered = 0
  for whole in ["-0001-12-31T23:59:59.999999+05:30", "2026-11-01T01:30:00-04:00[America/Toronto]", "P-1Y-2M-3D"]
    var n = 0
    while n <= whole.byteLength
      val prefix = whole.slice(0, n)
      parseDate(prefix).isOk
      parseTime(prefix).isOk
      parseDateTime(prefix).isOk
      parseTimestamp(prefix).isOk
      parseZoned(prefix).isOk
      parsePeriod(prefix).isOk
      answered += 6
      n += 1
  println(s"$answered prefixes answered")
