// expect: exit 0
// split, lines, chars, count, isBlank, reverse, padStart, padEnd, equalsIgnoreCase, take, drop,
// takeRight and dropRight. These count characters, over ASCII and over multi-byte UTF-8: `é` takes
// two bytes, each of `日本` three, and `😀` four.

show(v: Vector[string]) -> string = s"${v.length()}:" + v.map(x -> "[" + x + "]").mkString("")

main()
    // split keeps every empty piece.
    print(show("a,b,c".split(",")))
    print(show(",a,,b,".split(",")))
    print(show("abc".split(",")))
    print(show("".split(",")))
    print(show(",".split(",")))
    print(show("a--b---c".split("--")))
    print(show("日,本😀,é".split(",")))
    print(show("a😀b😀".split("😀")))
    // lines drop the terminator, \n or \r\n, and the last empty piece.
    print(show("a\nb".lines()))
    print(show("a\nb\n".lines()))
    print(show("a\r\nb\r\n".lines()))
    print(show("a\n\nb".lines()))
    print(show("\n".lines()))
    print(show("\r\n".lines()))
    print(show("".lines()))
    print(s"${"a\rb\r".lines().length()} ${"a\rb\r".lines()(0).byteLength()}")
    print(show("é\r\n日本\n".lines()))
    // chars
    print(s"${"café".chars()} ${"".chars().length()} ${"日本😀".chars().length()}")
    print(s"${"banana".count(c -> c == 'a')} ${"aé日".count(c -> int(c) > 127)} ${"".count(c -> true)}")
    // blank
    print(s"${"".isBlank()} ${" \t\n".isBlank()} ${"\u{3000}\u{a0}".isBlank()} ${" a ".isBlank()} ${"é".isBlank()}")
    // reverse works on characters
    print(s"[${"abc".reverse()}] [${"café".reverse()}] [${"日本😀x".reverse()}] [${"".reverse()}] [${"a".reverse()}]")
    // padding counts characters
    print(s"[${"ab".padStart(5)}] [${"ab".padEnd(5)}] [${"ab".padStart(5, '0')}] [${"ab".padEnd(5, '-')}]")
    print(s"[${"é".padStart(3, '日')}] [${"日".padEnd(3, '😀')}] [${"abc".padStart(2)}] [${"abc".padEnd(3)}] [${"".padStart(2, 'x')}] [${"ab".padStart(-1)}]")
    // case-insensitive equality
    print(s"${"Hello".equalsIgnoreCase("hELLO")} ${"ÉCOLE".equalsIgnoreCase("école")} ${"a".equalsIgnoreCase("b")} ${"".equalsIgnoreCase("")} ${"a".equalsIgnoreCase("ab")}")
    // take, drop and their right-hand forms
    val w = "aé日😀z"
    print(s"[${w.take(0)}] [${w.take(2)}] [${w.take(4)}] [${w.take(5)}] [${w.take(99)}] [${w.take(-3)}]")
    print(s"[${w.drop(0)}] [${w.drop(2)}] [${w.drop(4)}] [${w.drop(5)}] [${w.drop(99)}] [${w.drop(-3)}]")
    print(s"[${w.takeRight(0)}] [${w.takeRight(2)}] [${w.takeRight(4)}] [${w.takeRight(5)}] [${w.takeRight(99)}] [${w.takeRight(-3)}]")
    print(s"[${w.dropRight(0)}] [${w.dropRight(2)}] [${w.dropRight(4)}] [${w.dropRight(5)}] [${w.dropRight(99)}] [${w.dropRight(-3)}]")
    print(s"[${"".take(2)}] [${"".drop(2)}] [${"".takeRight(2)}] [${"".dropRight(2)}]")
