// expect: exit 0
// split, lines, chars, count, isBlank, reverse, padStart, padEnd, equalsIgnoreCase, take, drop,
// takeRight and dropRight. These count characters, over ASCII and over multi-byte UTF-8: `é` takes
// two bytes, each of `日本` three, and `😀` four.

show(v: Vector[string]) -> string = s"${v.length}:" + v.map(x -> "[" + x + "]").mkString("")

main()
    // split keeps every empty piece.
    println(show("a,b,c".split(",")))
    println(show(",a,,b,".split(",")))
    println(show("abc".split(",")))
    println(show("".split(",")))
    println(show(",".split(",")))
    println(show("a--b---c".split("--")))
    println(show("日,本😀,é".split(",")))
    println(show("a😀b😀".split("😀")))
    // lines drop the terminator, \n or \r\n, and the last empty piece.
    println(show("a\nb".lines))
    println(show("a\nb\n".lines))
    println(show("a\r\nb\r\n".lines))
    println(show("a\n\nb".lines))
    println(show("\n".lines))
    println(show("\r\n".lines))
    println(show("".lines))
    println(s"${"a\rb\r".lines.length} ${"a\rb\r".lines(0).byteLength}")
    println(show("é\r\n日本\n".lines))
    // chars
    println(s"${"café".chars} ${"".chars.length} ${"日本😀".chars.length}")
    // bytes
    println(s"${"café".bytes} ${"".bytes.length} ${"日本😀".bytes.length} ${"a\u{0}".bytes}")
    println(s"${"banana".count(c -> c == 'a')} ${"aé日".count(c -> int(c) > 127)} ${"".count(c -> true)}")
    // blank
    println(s"${"".isBlank} ${" \t\n".isBlank} ${"\u{3000}\u{a0}".isBlank} ${" a ".isBlank} ${"é".isBlank}")
    // reverse works on characters
    println(s"[${"abc".reverse}] [${"café".reverse}] [${"日本😀x".reverse}] [${"".reverse}] [${"a".reverse}]")
    // padding counts characters
    println(s"[${"ab".padStart(5)}] [${"ab".padEnd(5)}] [${"ab".padStart(5, '0')}] [${"ab".padEnd(5, '-')}]")
    println(s"[${"é".padStart(3, '日')}] [${"日".padEnd(3, '😀')}] [${"abc".padStart(2)}] [${"abc".padEnd(3)}] [${"".padStart(2, 'x')}] [${"ab".padStart(-1)}]")
    // case-insensitive equality
    println(s"${"Hello".equalsIgnoreCase("hELLO")} ${"ÉCOLE".equalsIgnoreCase("école")} ${"a".equalsIgnoreCase("b")} ${"".equalsIgnoreCase("")} ${"a".equalsIgnoreCase("ab")}")
    // take, drop and their right-hand forms
    val w = "aé日😀z"
    println(s"[${w.take(0)}] [${w.take(2)}] [${w.take(4)}] [${w.take(5)}] [${w.take(99)}] [${w.take(-3)}]")
    println(s"[${w.drop(0)}] [${w.drop(2)}] [${w.drop(4)}] [${w.drop(5)}] [${w.drop(99)}] [${w.drop(-3)}]")
    println(s"[${w.takeRight(0)}] [${w.takeRight(2)}] [${w.takeRight(4)}] [${w.takeRight(5)}] [${w.takeRight(99)}] [${w.takeRight(-3)}]")
    println(s"[${w.dropRight(0)}] [${w.dropRight(2)}] [${w.dropRight(4)}] [${w.dropRight(5)}] [${w.dropRight(99)}] [${w.dropRight(-3)}]")
    println(s"[${"".take(2)}] [${"".drop(2)}] [${"".takeRight(2)}] [${"".dropRight(2)}]")
