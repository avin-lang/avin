// expect: trap
// A `Restart` whose limit is less than zero is refused where the actor is spawned.
import avin.actors.{Restart, spawn}
import avin.time

actor Idle receives int
  receive
    _ -> ()

main()
  val ok = spawn(Idle(), onFailure = Restart(0, time.seconds(1)))
  println(ok)
  spawn(Idle(), onFailure = Restart(-1, time.seconds(1)))
  println("not reached")
