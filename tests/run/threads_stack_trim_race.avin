// expect: exit 0
// env: AVIN_GC_STRESS=0
// Threads that recurse, then sleep for about one of the monitor's ticks, over and over, so their
// stacks are trimmed at every moment of their parks and wakes: a trim the monitor has begun as a
// thread is woken is waited out before the thread runs, and a thread woken just before a trim is left
// alone. Every descent gives the right answer, and so does a ping-pong of a hundred thousand parks
// that run on beside them.
import avin.threads.{Channel, sleep, spawn}
import avin.time.micros

depth(n: int) -> int = if n == 0 then 0 else 1 + depth(n - 1)

main() -> int
  val diggers = (0 ..< 64).map(i ->
    spawn(() ->
      var right = 0
      for round in 0 ..< 60
        if depth(3000 + round) == 3000 + round then right += 1
        sleep(micros(long(500 + 300 * ((i + round) % 5))))
      right)).toVector
  val ping = Channel[int](0)
  val pong = Channel[int](0)
  val a = spawn(() ->
    var sum = 0
    for i in 0 ..< 50000
      ping.send(depth(i % 200))
      sum += pong.receive().get
    sum)
  val b = spawn(() ->
    for i in 0 ..< 50000
      pong.send(ping.receive().get + depth(50))
    0)
  println(diggers.map(t -> t.join()).sum)
  println(a.join() + b.join())
  0
