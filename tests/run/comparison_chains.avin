// Comparison chains on int, long, byte, char, real and string: mixed operators, three and four
// operands, each middle operand evaluated once, and evaluation stopping at the first false link.

var calls = 0

tick(n: int) -> int
  calls += 1
  n

tickLong(n: long) -> long
  calls += 1
  n

tickChar(c: char) -> char
  calls += 1
  c

tickReal(x: real) -> real
  calls += 1
  x

tickString(s: string) -> string
  calls += 1
  s

main()
  // int
  println(1 < 2 < 3, 1 < 2 <= 2, 1 <= 1 < 2, 1 <= 1 <= 1, 3 > 2 > 1, 3 >= 3 > 2, 1 < 3 < 2)
  println(1 < 2 < 3 < 4, 1 < 2 <= 2 < 4, 1 < 2 < 3 < 3, 1 <= 1 <= 1 <= 1, 4 > 3 >= 3 > 2)
  println(0 <= -1 < 5, -5 < -1 <= -1)
  val lo = 10
  val hi = 20
  for x in [9, 10, 15, 19, 20, 21] do
    print(s"${lo <= x < hi} ")
  println()
  // long
  val big: long = 9_000_000_000
  println(0 < big < long(10_000_000_000), big <= big <= big, big < 0 < 1, long(0) < big < big + 1)
  // byte
  val b: byte = 200
  println(0 <= b < 255, b > 100 > 50, byte(0) <= b <= byte(255))
  // char
  for c in ['/', '0', '5', '9', ':', 'a', 'z', '{'] do
    print(s"${'0' <= c <= '9'}${'a' <= c <= 'z'} ")
  println()
  println('a' < 'b' < 'c' < 'd', 'a' <= 'a' < 'b' <= 'b', 'a' < 'c' < 'b')
  println(int('0') <= int('5') <= int('9'), int('a') - int('A') == 32)
  // real
  println(0.0 < 0.5 < 1.0, 0.5 <= 0.5 <= 0.5, 1.0 > 0.5 >= 0.5 > 0.0, 0.0 < 2.0 < 1.0)
  // string
  println("a" < "b" < "c", "a" <= "a" < "b", "ab" < "b" < "ba", "b" < "a" < "c")
  // the middle operand is evaluated once
  calls = 0
  println(tick(1) < tick(5) < tick(9), calls)
  calls = 0
  println(tick(1) <= tick(5) < tick(9) <= tick(9), calls)
  calls = 0
  println(tickLong(1) < tickLong(5) <= tickLong(5), calls)
  calls = 0
  println(tickChar('a') <= tickChar('m') <= tickChar('z'), calls)
  calls = 0
  println(tickReal(0.5) < tickReal(1.5) < tickReal(2.5), calls)
  calls = 0
  println(tickString("a") < tickString("m") < tickString("z"), calls)
  // evaluation stops at the first false link, so later operands are never evaluated
  calls = 0
  println(tick(5) < tick(1) < tick(9), calls)
  calls = 0
  println(tick(1) < tick(5) < tick(2) < tick(9) < tick(10), calls)
  calls = 0
  println(tickChar('z') < tickChar('a') < tickChar('b'), calls)
  calls = 0
  println(tickString("z") < tickString("a") < tickString("b"), calls)
  // a chain is an ordinary bool operand with && and ||
  calls = 0
  println(tick(1) < tick(2) < tick(3) && tick(4) > tick(3) > tick(2), calls)
  calls = 0
  println(tick(3) < tick(2) < tick(1) && tick(7) < tick(8), calls)
  calls = 0
  println(tick(3) < tick(2) < tick(1) || tick(7) < tick(8) < tick(9), calls)
