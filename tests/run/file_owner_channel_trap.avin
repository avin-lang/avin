// expect: trap
// A file sent on a channel is taken by the thread that receives and uses it, and the sender's next
// call on it traps, a read of the size included.
import avin.fs
import avin.threads.{Channel, spawn}

main()
  val dir = fs.createTempDir("file-owner").ok.get
  val f = fs.create(dir + "/a.txt").ok.get
  val files = Channel[fs.File]()
  val used = Channel[int]()
  val finish = Channel[int]()
  val t = spawn(() ->
    val mine = files.receive().get
    _ = mine.writeText("receiver\n")
    used.send(1)
    _ = finish.receive()
    mine.close().isOk)
  files.send(f)
  _ = used.receive()
  println("taken")
  _ = f.size()
  println("not reached")
  finish.send(1)
  println(t.join())
