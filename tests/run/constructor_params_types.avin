// expect: exit 0
// Constructor parameters on data types, classes, traits, impls and aliases: `Nested[F[_], A]` is a
// type, its field an `F[Option[A]]`; a class of a two-hole parameter; a trait taking a constructor
// and a class implementing it at `Vector`; an impl for every `Nested`; an alias taking a
// constructor; and a type with a constructor parameter shown by its type, since what displays an
// `F[A]` is unknown where `F` is any constructor.
data Nested[F[_], A](inner: F[Option[A]])

data Tree[F[_]]
  Leaf(value: int)
  Branch(children: F[Tree[F]])

class Holder[G[_, _]](val pair: G[int, string])

class Box[F[_]](var item: F[int])
  get() -> F[int] = item
  put(x: F[int]) = item = x
  swap[H[_]](other: H[int]) -> H[int] = other

trait Holds[F[_]]
  held() -> F[int]

class Ints(val xs: Vector[int]): Holds[Vector]
  override held() -> Vector[int] = xs

class Maybe(val x: Option[int]): Holds[Option]
  override held() -> Option[int] = x

trait Named
  name() -> string

impl[F[_], A] Named for Nested[F, A]
  name() -> string = "nested"

type IntsOf[F[_]] = F[int]
type Wrapped[F[_]] = Nested[F, int]

total(h: Holds[Vector]) -> int
  var sum = 0
  for x in h.held()
    sum += x
  sum

size(t: Tree[Vector]) -> int = t match
  Leaf(_) -> 1
  Branch(children) ->
    var n = 1
    for c in children
      n += size(c)
    n

main()
  val n = Nested[Vector, int]([Some(1), None])
  println(n.inner)
  println(n == Nested[Vector, int]([Some(1), None]))
  println(n == Nested[Vector, int]([]))
  println(n)
  println(n.name())
  val o = Nested[Option, string](Some(Some("deep")))
  println(o.inner)
  val h = Holder[Either](Left(3))
  println(h.pair)
  println(Holder[Result](Ok(4)).pair)
  val b = Box[Option](Some(5))
  println(b.get())
  b.put(None)
  println(b.get())
  println(b.swap[Vector]([9]))
  println(total(Ints([1, 2, 3])))
  println(Maybe(Some(8)).held())
  val i: IntsOf[Vector] = [4, 5]
  println(i)
  val w: Wrapped[Option] = Nested(Some(Some(1)))
  println(w.inner)
  val t: Tree[Vector] = Branch([Leaf(1), Branch([Leaf(2), Leaf(3)]), Branch([])])
  println(size(t))
