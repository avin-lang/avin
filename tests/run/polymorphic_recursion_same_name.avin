// expect: exit 0
// A method that calls another type's method of the same name, with its own type parameter set to a
// type built from its own, is not recursive: the called method belongs to a type the caller is not
// related to, so the type arguments do not grow without end.

data Box[+V](xs: Vector[Option[(int, V)]])

impl[V] Box[V]
    updated[W >: V](i: int, w: W) -> Box[W]
        val e: Option[(int, W)] = Some((i, w))
        Box[W](xs.updated(i, e))

class Holder[+V](val xs: Vector[List[V]])
    updated[W >: V](i: int, w: W) -> Holder[W]
        val e: List[W] = [w]
        Holder[W](xs.updated(i, e))

trait Slots[+V]
    put[W >: V](i: int, w: W) -> Slots[W]

class Row[+V](val xs: Vector[Option[V]]): Slots[V]
    override put[W >: V](i: int, w: W) -> Row[W]
        val e: Option[W] = Some(w)
        Row[W](xs.updated(i, e))

main(args: Vector[string])
    val b = Box[int]([Some((1, 2))])
    println(b.updated(0, 5).xs)
    val h = Holder[int]([[1]])
    println(h.updated(0, 4).xs)
    val r: Slots[int] = Row[int]([Some(1), None])
    r.put(1, 9) match
        row: Row[int] -> println(row.xs)
        _ -> println("not a row")
