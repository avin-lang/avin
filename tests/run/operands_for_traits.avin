// An operator's operands are checked on their own when the whole operation is expected as a trait or
// `Any`: the value is computed at its own type, then converted. The two-argument `print` takes
// `Display` parameters, so each argument here is such a position.

trait Shape
    area() -> int

data Square
    Square(side: int)

impl Shape for Square
    area() -> int = side * side

describe(first: Display, second: Display) = print(first, second)

total(shape: Shape, extra: Shape) -> int = shape.area() + extra.area()

main()
    val k = 6
    print(1 + 2, 3)
    print(12 & 5, 1)
    print(~0, -k)
    print(1 + 2 << 3, k & 5)
    print(k * 7, k > 3, k + 1 == 7)
    print(-k * 2, +k)
    describe(k % 4, k / 4)
    describe(k +| 1, 2147483647 +| k)
    describe(-2147483647 - 1 -% 1, ~k)
    val shown: Display = k + 1
    val anything: Any = k * 2
    print(shown, anything is int)
    print(total(Square(k - 3), Square(1 + 1)))
