// A trait declares methods, abstract or with a default body; a value of the trait's type is a
// reference to an object of any class conforming to it, and its calls reach that class's methods.
trait Shape
    area() -> int
    name() -> string = "shape"
    describe() -> string = s"${name()} of area ${area()}"

class Square(side: int): Shape
    override area() -> int = side * side
    override name() -> string = "square"

class Rect(w: int, h: int): Shape
    override area() -> int = w * h

// A trait may require another; a value of it is also one of the trait it requires.
trait Named
    label() -> string

trait Tagged: Named
    tag() -> string = s"<${label()}>"

class Item(text: string): Tagged
    override label() -> string = text

// A superclass and traits together, and a subclass that inherits the conformance and overrides the
// implementation.
open class Base(val n: int)
    twice() -> int = n * 2

open class Counter(n: int): Base(n), Shape, Named
    override area() -> int = n
    override label() -> string = s"counter $n"

class Doubled(n: int): Counter(n)
    override area() -> int = twice()

// A generic trait, used with different type arguments by two classes.
trait Source[T]
    get() -> T
    both() -> (T, T) = (get(), get())

class IntSource(v: int): Source[int]
    override get() -> int = v

class Echo[T](v: T): Source[T]
    override get() -> T = v

show(s: Shape) = println(s.describe())

label_of(n: Named) -> string = n.label()

main()
    val shapes: (Shape, Shape, Shape) = (Square(3), Rect(2, 5), Doubled(4))
    show(shapes.0)
    show(shapes.1)
    show(shapes.2)
    val square = Square(2)
    println(square.describe())
    var current: Shape = Square(1)
    println(s"${current.area()}")
    current = Rect(3, 4)
    println(s"${current.area()}")
    val t: Tagged = Item("x")
    println(t.tag())
    println(label_of(t))
    println(label_of(Counter(7)))
    val c: Counter = Doubled(5)
    println(s"${c.area()} ${c.twice()} ${c.n}")
    val s: Source[int] = IntSource(9)
    println(s"${s.get()} ${s.both().1}")
    val e: Source[string] = Echo("hi")
    println(e.both().0 + e.get())
    val same: Shape = square
    println(s"${same === square} ${same === current}")
