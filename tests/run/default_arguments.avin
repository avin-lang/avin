// expect: exit 0
// Default and named arguments. A default is computed at each call that omits its argument, in the
// scope the function is declared in, and may use the parameters before it. Named arguments may come
// in any order after the positional ones; the arguments written at a call run in the order written,
// then the omitted ones' defaults, in parameter order.

data Box
    Box(width: int, height: int)

limit() -> int = 100

sized(size: int = 16) -> int = size

// A default may use the parameters before it, and what is in scope where the function is declared.
area(width: int, height: int = width, scale: int = limit()) -> int = width * height * scale

label(text: string, prefix: string = "<", suffix: string = ">") -> string = prefix + text + suffix

shown(tag: string, value: int) -> int
    print(s"$tag=$value")
    value

ordered(a: int, b: int, c: int) -> string = s"$a $b $c"

counted(first: int, n: int = shown("default", 7)) -> int = first + n

first[T](items: (T, T), fallback: T) -> T = items.0

wrapped[T](value: T, times: int = 2) -> (T, int) = (value, times)

// A default may be a lambda, checked against the parameter's function type.
transformed(n: int, f: (int) -> int = x -> x + 1) -> int = f(n)

// A function defined by clauses has its defaults on its signature line.
describe(n: int, zero: string = "none") -> string
describe(0, zero) = zero
describe(n, _) = s"$n"

boxed(width: int = 1, height: int = 2) -> Box = Box(width, height)

// An argument that never finishes ends the call: what is written before it has run, and nothing after.
stopped() -> string = ordered(c = shown("c", 3), a = (return "stopped"), b = shown("b", 2))

main()
    print(s"${sized()} ${sized(4)} ${sized(size = 8)}")
    print(s"${area(2)} ${area(2, 3)} ${area(2, scale = 1)} ${area(height = 5, width = 2, scale = 1)}")
    print(label("x"))
    print(label("x", suffix = "]"))
    print(label(suffix = ")", text = "y", prefix = "("))
    // Written out of parameter order, the arguments still run in the order written.
    print(ordered(c = shown("c", 3), a = shown("a", 1), b = shown("b", 2)))
    // The default runs after every written argument, and only when it is omitted.
    val total = counted(shown("first", 1))
    print(s"$total")
    val given = counted(n = shown("n", 9), first = shown("first", 2))
    print(s"$given")
    // A named argument's type takes part in inference as a positional one does.
    print(s"${first(fallback = 0, items = (5, 6))}")
    print(first(fallback = "z", items = ("a", "b")))
    val w = wrapped(value = "w")
    print(s"${w.0} ${w.1}")
    val v = wrapped(true, times = 3)
    print(s"${v.0} ${v.1}")
    print(s"${transformed(1)} ${transformed(1, f = x -> x * 10)} ${transformed(f = x -> x - 1, n = 1)}")
    print(s"${describe(0)} ${describe(0, zero = "zero")} ${describe(5)}")
    val b = boxed(height = 9)
    print(s"${b.width} ${b.height}")
    // A variant takes its fields by name too.
    val p = Box(height = 4, width = 3)
    print(s"${p.width} ${p.height}")
    print(stopped())

    // A local function's defaults are checked where it is declared, and may use what it captures.
    var base = 10
    offset(n: int, by: int = base) -> int = n + by
    print(s"${offset(1)}")
    base = 20
    print(s"${offset(1)}")
    print(s"${offset(by = 2, n = 1)}")
