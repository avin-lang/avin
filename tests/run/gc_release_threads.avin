// expect: exit 0
// env: AVIN_GC_STRESS=0
// Threads allocating while another thread's collections give free pages back: four threads each
// hold bursts of strings and arrays and drop them, while the main thread does the same with larger
// bursts, so collections run from every thread and release runs that the others then allocate into.
// Every value each thread reads back is the one it wrote.
import avin.threads.spawn

// Builds a burst of `count` strings and small arrays tagged by `tag`, checks every one, and drops it.
burst(tag: int, count: int) -> bool
  val strings = Buffer[string]()
  val arrays = Buffer[Array[int]]()
  for i in 0 ..< count
    strings += s"thread $tag value $i"
    if i % 50 == 0 then arrays += Array.fill(2000, tag * 100000 + i)
  val stringsOk = (0 ..< count).forall(i -> strings(i) == s"thread $tag value $i")
  val arraysOk = (0 ..< arrays.length).forall(k -> arrays(k).forall(x -> x == tag * 100000 + k * 50))
  stringsOk && arraysOk

main()
  val workers = (1 ..< 5).map(t -> spawn(() -> (0 ..< 12).forall(_ -> burst(t, 40000)))).toVector
  val mainOk = (0 ..< 6).forall(_ -> burst(0, 300000))
  println(mainOk)
  println(workers.map(w -> w.join()))
