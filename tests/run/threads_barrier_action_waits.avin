// expect: trap
// A barrier's action runs while the other parties wait; one that waits on its own barrier would wait
// for ever, so it traps.
import avin.threads.{Atomic, Barrier}

main()
  val again = Barrier(1, () -> println("action"))
  println(s"last ${again.wait()}")
  val itself = Atomic[Option[Barrier]](None)
  val b = Barrier(1, () ->
    if itself.load() is Some(x) then x.wait())
  itself.store(Some(b))
  b.wait()
  println("after")
