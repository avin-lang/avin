// expect: exit 0
// A class's parameters are fields, its body runs top to bottom when an instance is made, and its
// methods reach the fields and each other by bare name or through `self`.

class Account(owner: string, val number: int, var balance: int)
    print(s"opening $number for $owner")
    if balance < 0 then print("opened overdrawn")
    val opened = number * 10
    var deposits = 0
    print(s"opened at $opened")

    deposit(amount: int)
        balance += amount
        deposits++

    withdraw(amount: int) -> bool
        if amount > balance then return false
        self.balance = balance - amount
        true

    describe() -> string = s"$owner #$number: $balance after ${count()} deposits"

    count() -> int = self.deposits

    private secret() -> string = owner

    reveal() -> string = secret()

class P(x: int)

main() -> int
    val a = Account("ada", 7, 100)
    a.deposit(50)
    a.deposit(25)
    if a.balance != 175 then return 1
    if a.number != 7 || a.opened != 70 then return 2
    if !a.withdraw(75) || a.withdraw(1000) then return 3
    print(a.describe())
    a.balance = 3
    a.balance += 4
    print(a.describe())
    print(a.reveal())
    val b = Account("bob", 8, -5)
    if a === b then return 4
    if !(a === a) || a !== a then return 5
    val c = a
    c.deposit(1)
    if a.balance != 8 then return 6
    val p = P(1)
    val q = P(1)
    if p === q then return 7
    val before = a.deposits++
    if before != 3 || ++a.deposits != 5 then return 8
    0
