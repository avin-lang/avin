// expect: exit 0
// `not` is a keyword only directly after `is`, where it negates the pattern: `x is not T`. Everywhere
// else it is an ordinary name, so a function, method, parameter or local may be called `not`, and
// `not(p)` calls it. After `is`, `not` is always the keyword, so `x is not(y)` tests the pattern `(y)`.

// A predicate, and its complement made by a function named `not`.
class Pred(val test: (int) -> bool)
  not() -> Pred = Pred((n) -> !test(n))
  and(other: Pred) -> Pred = Pred((n) -> test(n) && other.test(n))

not(p: Pred) -> Pred = p.not()

flip(not: bool) -> bool = !not

// A local named `not`, tested with `is not`.
local() -> bool
  val not = 7
  var total = not + 1
  total += not
  not is not 7 || total == 15

data Shape
  Circle(r: int)
  Square(side: int)

main()
  val even = Pred((n) -> n % 2 == 0)
  val odd = not(even)
  println(s"${odd.test(3)} ${odd.test(4)} ${even.not().test(5)}")
  println(s"${(even and not(even)).test(2)}")
  println(s"${flip(true)} ${flip(not = false)} ${local()}")

  // `is not` in all its forms.
  val s: Shape = Circle(2)
  println(s"${s is not Square(_)} ${s is not Circle(_)} ${s is not(Square(_))}")
  val o: Option[int] = Some(3)
  println(s"${o is not None} ${o is not Some(3)} ${o is not(Some(4))}")
  if o is not None then println("some")
  val a: Any = 5
  println(s"${a is not _: string} ${a is not _: int}")
  var i = 0
  while o is not None && i < 2 do i += 1
  println(s"$i")
