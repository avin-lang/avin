// expect: exit 0
// Closures in generic code and data, local functions as values that share their captured `var`s
// with direct calls, a new variable per loop iteration, generic and intrinsic functions as
// values, `return` local to a lambda, curried and nested lambdas, wide and string captures, and
// closure identity. Run under a collection at every allocation, every closure is a root.

data List[+T]
    Nil
    Cons(head: T, tail: List[T])

map[A, B](xs: List[A], f: (A) -> B) -> List[B] = xs match
    Nil -> Nil
    Cons(h, t) -> Cons(f(h), map(t, f))

fold[A, B](xs: List[A], start: B, f: (B, A) -> B) -> B = xs match
    Nil -> start
    Cons(h, t) -> fold(t, f(start, h), f)

range(lo: int, hi: int) -> List[int] = if lo >= hi then Nil else Cons(lo, range(lo + 1, hi))

identity[T](x: T) -> T = x

sign(n: int) -> int
sign(0) = 0
sign(n)
    | n < 0 = -1
    | _ = 1

apply(f: (unit) -> unit) = f(())

scaled(k: int) -> List[int]
    val xs = range(1, 4)
    helper(x: int) -> int = x * k
    map(xs, x -> helper(x) + k)

main() -> int
    val squares = map(range(1, 6), x -> x * x)
    print(s"${fold(squares, 0, (a, b) -> a + b)}")
    val words = map(range(1, 4), n -> s"w$n")
    print(fold(words, "", (acc, w) -> acc + w))
    print(s"${fold(scaled(10), 0, (a, b) -> a + b)}")
    // A local function used as a value shares its captured var with direct calls.
    var hits = 0
    hit(n: int) -> int
        hits += n
        hits
    val h = hit
    h(2)
    hit(3)
    print(s"${h(5)} $hits")
    // Every iteration's var is a new variable.
    var fs: List[() -> int] = Nil
    var i = 0
    while i < 3
        var j = i * 10
        fs = Cons(() -> j, fs)
        j += 1
        i += 1
    print(s"${fold(fs, 0, (a, f) -> a + f())}")
    // Generic and intrinsic functions as values.
    val id: (string) -> string = identity
    print(id("same"))
    val p = print
    p(identity[string]("printed"))
    print(s"${fold(map(range(-2, 3), sign), 0, (a, b) -> a * 10 + b)}")
    // Return inside a lambda leaves only the lambda.
    val firstNegative: (int) -> bool = n ->
        if n < 0 then return true
        false
    print(s"${firstNegative(-1)} ${firstNegative(1)}")
    // Curried lambdas, function type sugar, calling a call.
    val plus: int -> int -> int = x -> y -> x + y
    print(s"${plus(3)(4)}")
    apply(u -> print("unit"))
    // Nested lambdas capture through the lambda around them.
    val outer = (a: int) -> (b: int) -> (c: int) -> a * 100 + b * 10 + c
    print(s"${outer(1)(2)(3)}")
    val wide: i128 = 170141183460469231731687303715884105727
    val text = "captured"
    val show = () -> s"$text $wide"
    print(show())
    print(s"${show === show} ${p === print}")
    0
