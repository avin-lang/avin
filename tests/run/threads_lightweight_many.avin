// expect: exit 0
// env: AVIN_GC_STRESS=0
// A hundred thousand threads, each a lightweight thread with a stack reserved but barely touched,
// all started before any is joined, and every one joined for its result; then as many again started
// through a scope, which joins them itself.
import avin.threads.{Atomic, scope, spawn}

main() -> int
    val n = 100000
    val threads = (0..<n).map(i -> spawn(() -> i % 7)).toVector()
    var total = 0
    for t in threads do total += t.join()
    println(total)
    val counted = Atomic(0)
    scope(s ->
        for i in 0..<n
            s.spawn(() -> counted.update(c -> c + 1)))
    println(counted.load())
    0
