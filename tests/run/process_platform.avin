// The platform functions of `avin.process`: the process id, the current directory, the home
// directory, the program's own file, the processors and the operating system, each checked against
// what a child program or the environment says; and `newSession`, run by the program in a copy of
// itself, which leads a session and a group from then on and is refused a second time.
import avin.fs
import avin.process
import avin.process.{Command, Linux, MacOS}

said(c: Command) -> string = c.output() match
  Ok(text) -> text.trim
  Err(e) -> fail(s"did not run: $e")

session()
  val first = process.newSession()
  println(first.map(s -> s == process.pid()))
  println(said(Command("/bin/ps", "-o", "pgid=", "-p", process.pid().toString())) == process.pid().toString())
  // A session leader leads its group already, and is refused a second.
  println(process.newSession().isErr)

main()
  if process.args() == ["session"]
    session()
    return
  // The pid is the parent a child program sees, the same at every call.
  val pid = process.pid()
  println(pid > 0)
  println(pid == process.pid())
  println(said(Command("/bin/sh", "-c", "echo $PPID")) == pid.toString())
  // The current directory is the one a child program starts in, with no directory of its own.
  val here = process.currentDir()
  println(here.isOk)
  println(said(Command("/bin/pwd", "-P")) == here.ok.get)
  println(Command("/bin/sh", "-c", "test \"$(pwd)\" = \"$0\"", here.ok.get).run())
  // The home directory is the platform's, which the environment says here.
  println(process.homeDir() == process.env("HOME"))
  // The program's own file: an absolute path to a file that is there.
  val exe = process.executable()
  println(exe.isDefined)
  println(exe.get.startsWith("/"))
  println(fs.exists(exe.get))
  // At least one processor, and the same answer twice.
  println(process.processors() >= 1)
  println(process.processors() == process.processors())
  // The operating system, which `uname` names too.
  val os = process.os()
  val uname = said(Command("/usr/bin/uname"))
  println(os match
    MacOS -> uname == "Darwin"
    Linux -> uname == "Linux"
    _ -> false)
  // A copy of the program leads a session of its own.
  println(Command(exe.get, "session").output())
