// expect: exit 0
// `avin.target`'s two values are the machine the program is compiled for: an operating system of
// `avin.process` and an `Arch`, known when the program is compiled. A `match`, an `is` test and `==`
// or `!=` on them are decided then, every branch still checked; each agrees with what the program
// asks at run time, through a value passed around or a closure as well as read directly.
import avin.process
import avin.target
import avin.process.{Linux, MacOS, Os}
import avin.target.{Aarch64, Arch, X86_64}

systemName(os: Os) -> string = os match
  MacOS -> "macos"
  Linux -> "linux"
  _ -> "other"

archName(arch: Arch) -> string = arch match
  Aarch64 -> "aarch64"
  X86_64 -> "x86_64"

main()
  val folded = target.os match
    MacOS -> "macos"
    Linux -> "linux"
    _ -> "other"
  println(folded == systemName(process.os()))
  println(target.os == process.os())
  println(!(target.os != process.os()))
  println((target.os is MacOS) == (process.os() is MacOS))
  println((target.os is not Linux) == !(process.os() is Linux))
  val bound = target.os match
    MacOS | Linux -> "posix"
    other -> systemName(other)
  println(bound)
  val named = target.arch match
    a @ Aarch64 -> archName(a)
    a -> archName(a)
  println(named == archName(target.arch))
  val read = () -> target.arch
  println(read() == target.arch)
  println(if target.arch == Aarch64 || target.arch == X86_64 then "known" else "unknown")
  println(if target.os == MacOS && target.arch == X86_64 then "never" else "a built target")
