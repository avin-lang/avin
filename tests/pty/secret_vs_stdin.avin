import avin.io
import avin.threads.{scope, sleep}
import avin.time.millis

// A thread reading standard input holds it until it has its line; a secret asked for meanwhile waits,
// since the two read the same terminal.
main()
  scope(sc ->
    sc.spawn(() -> println(s"line: ${io.readLine()}"))
    sleep(millis(300))
    sc.spawn(() ->
      val r = io.readSecret("secret: ")
      println(s"secret: ${r.map(s -> s.charCount)}")))
  println("done")
