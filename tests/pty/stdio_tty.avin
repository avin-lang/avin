import avin.io

// Standard input and output as bytes when both are a terminal: each line typed is read as bytes and
// written back as bytes with its length, until the input ends.
main()
  val input = io.stdin()
  val out = io.stdout()
  out.write("ready\n".utf8).getOrElse(())
  var more = true
  while more
    val got = input.read(64).getOrElse(Array.empty[byte]())
    more = got.length > 0
    if more
      out.write(s"[${got.length}]".utf8).getOrElse(())
      out.write(got).getOrElse(())
  out.write("ended\n".utf8).getOrElse(())
