import avin.io
import avin.io.IoError

// Asks for a secret at the terminal and says what came back as byte values, so what was typed never
// appears in the output. `bytes` reads it as bytes, `text` as a string, `or-line` as a string that may
// come from standard input where there is no terminal.
codes(bytes: Vector[byte]) -> string
  var out = ""
  for b in bytes do out = out + s" ${int(b)}"
  out

report(e: IoError)
  println(s"error: ${e.message}")
  println(s"no terminal: ${e.kind is io.NoTerminal}")

main(args: Vector[string])
  val prompt = args(1)
  args(0) match
    "bytes" -> io.readSecretBytes(prompt) match
      Ok(b) -> println(s"got ${b.length} bytes:${codes(b.toVector)}")
      Err(e) -> report(e)
    "text" -> io.readSecret(prompt) match
      Ok(s) -> println(s"got ${s.charCount} chars, ${s.byteLength} bytes:${codes(s.bytes)}")
      Err(e) -> report(e)
    _ -> io.readSecretOrLine(prompt) match
      Ok(s) -> println(s"got ${s.charCount} chars, ${s.byteLength} bytes:${codes(s.bytes)}")
      Err(e) -> report(e)
  println(s"then: ${io.readLine()}")
