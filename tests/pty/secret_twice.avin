import avin.io

// Two secrets one after the other: each read puts the terminal back, so the second finds it as the
// first did and neither is left hidden.
show(label: string, r: Result[string, avin.io.IoError])
  r match
    Ok(s) -> println(s"$label: ${s.charCount} chars")
    Err(e) -> println(s"$label: error ${e.message}")

main()
  show("first", io.readSecret("one: "))
  show("second", io.readSecret("two: "))
