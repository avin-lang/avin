import avin.io
import avin.threads.{scope, sleep}
import avin.time.millis

// A lightweight thread cancelled while it waits for a secret: the terminal is hidden until the line
// arrives, the read finishes, the terminal is put back, and only then does the thread stop.
main()
  val t = scope(sc ->
    val t = sc.spawn(() ->
      val r = io.readSecret("secret: ")
      println(s"read: ${r.isOk}")
      sleep(millis(10000)))
    sleep(millis(300))
    sc.cancel()
    t)
  println(s"thread: ${t.result().isDefined}")
  println("scope done")
