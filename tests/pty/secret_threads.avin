import avin.io
import avin.threads.scope

// Two threads ask at once: the second prompt is not written until the first line has been read.
main()
  scope(sc ->
    for n in 0 ..< 2 do sc.spawn(() ->
      val r = io.readSecret(s"prompt-$n: ")
      println(s"thread $n: ${r.map(s -> s.charCount)}")))
  println("done")
