import avin.io
import avin.signal

// A program that watches the interrupt signal and survives it: the read fails as interrupted, the
// signal reaches the watch, and the terminal is put back.
main()
  val w = signal.watch(signal.Interrupt).ok.get
  io.readSecret("secret: ") match
    Ok(_) -> println("read")
    Err(e) -> println(s"error: ${e.message}")
  println(s"watched: ${w.take()}")
