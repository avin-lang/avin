import avin.io
import avin.process
import avin.threads.{Channel, sleep, spawn}
import avin.time.{millis, seconds}

// A terminal as standard input, waited on in a select beside a channel a thread ticks on: each line
// typed is taken with `readAvailable` as soon as it is entered and written back with its length, the
// ticks going on meanwhile, until the input ends.
main()
  val ticks = Channel[int](1)
  spawn(() ->
    while true
      sleep(millis(5))
      if ticks.trySend(0) then ())
  println("ready")
  flush()
  var more = true
  var ticked = 0
  while more
    select
      io.stdin().readable() -> io.stdin().readAvailable(64) match
        Ok(Some(b)) ->
          more = b.length > 0
          if more
            print(s"[${b.length}]${string.fromUtf8Lossy(b)}")
            flush()
        Ok(None) -> ()
        Err(e) -> fail(e.message)
      ticks.receive() -> ticked += 1
      after seconds(20) -> fail("no input came")
  println(s"ended, ticked: ${ticked > 0}")
  flush()
  process.exit(0)
