module avintest.digits

import sysl.time.{millis, sleep}

/** What a check decided about a number: the methods Avin binds on a value it mirrors. */
struct Verdict
    code: i64
    note: string

    /** The kind of verdict the code is, or `None` for zero, which is no verdict. Taken by value. */
    kind(self) -> Option[Kind]
        if self.code == 0 then return None
        if self.code < 0 then return Some(Kind.Negative)
        if self.code > 1000 then return Some(Kind.Large(self.code))
        Some(Kind.Small)

    /** The note and the code in words. Read through a borrow. */
    describe(&self) -> string = s"${self.note}:${self.code}"

    /** The code scaled by a whole number. */
    scaled_by(&self, n: i32) -> i64 = self.code * i64(n)

    /** The code scaled by a fraction, rounded toward zero. */
    scaled_by_fraction(&self, x: f64) -> i64 = i64(f64(self.code) * x)

    /** The verdict with its code moved on by `n`, a new value. */
    moved(self, n: i64) -> Verdict = Verdict(self.code + n, self.note)

    /** Whether the code is even. */
    even(self) -> bool = self.code % 2 == 0

    /** The code's digits as bytes. */
    digit_bytes(&self) -> []u8 = digits_of(self.code)

    /** Moves the code on by one, through a pointer to the value. */
    bump(*self) -> i64
        self.code += 1
        self.code

    /** The verdict, or an error when its code is over `limit`. */
    checked(&self, limit: i64) -> Result[Verdict, string] = if self.code > limit then Err("over") else Ok(Verdict(self.code, self.note))

    /** The note between `left` and `right`, each with a default. */
    framed(&self, left: string = "<", right: string = ">") -> string = s"$left${self.note}$right"

    /** A tally starting at the code, a counted reference of its own. */
    tally(&self) -> &Tally = Tally(self.code)

    /** The code, after a short wait. */
    code_after_wait(&self) -> i64
        sleep(millis(1))
        self.code

/** A verdict's kind, an enum with a method of its own. */
enum Kind
    Small
    Negative
    Large(code: i64)

    /** How serious the kind is. */
    weight(self) -> i32 = self match
        Small -> 1
        Negative -> 2
        Large(c) -> if c > 1000000 then 4 else 3

    /** The kind one step more serious, or `None` past the last. */
    worse(self) -> Option[Kind] = self match
        Small -> Some(Kind.Negative)
        Negative -> Some(Kind.Large(1001))
        Large(_) -> None

/** A verdict on `n`. */
verdict_on(n: i64) -> Verdict = Verdict(n, "n")
