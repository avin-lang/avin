module avintest.digits

import sysl.buf.{Buf, buf}
import sysl.math.Float
import sysl.time.{millis, sleep}

// Functions taking and answering the narrower floating-point types, which an Avin `real` crosses into
// and out of. Each answers what it was given, or its bits, so a test sees exactly what crossed.

/** The bits of `x`, which tell a rounded value, the sign of a zero and a NaN apart. */
f32_bits(x: f32) -> i64 = i64(x.bits())

/** The `f32` whose bits are the low 32 of `b`. */
f32_of_bits(b: i64) -> f32 = f32.from_bits(u32(b))

/** `x`, as it was given. */
f32_same(x: f32) -> f32 = x

/** `x` halved, at the precision of an `f32`. */
f32_half(x: f32) -> f32 = x / f32(2)

/** The sum of `a`, an `f32`, and `b`, a `real`, as a `real`. */
f32_mixed(a: f32, b: real) -> real = real(a) + b

/** The largest finite `f32`. */
f32_largest() -> f32 = f32.max_value()

/** The smallest positive normal `f32`, two to the power of minus 126. */
f32_smallest_normal() -> f32 = f32.from_bits(0x00800000u32)

/** The smallest positive `f32`, a subnormal, two to the power of minus 149. */
f32_smallest() -> f32 = f32.from_bits(1u32)

/** The bits of `x` as an `f16`, rounded into it. */
f16_bits(x: f16) -> i64 = i64(x.bits())

/** `x`, an `f16`, as it was given. */
f16_same(x: f16) -> f16 = x

/** `x`, a `bf16`, as it was given. */
bf16_same(x: bf16) -> bf16 = x

/** Which overload was called, the one at `real` or the one at `f32`, and the value it was given. */
width_of(x: real) -> string = s"real $x"
width_of(x: f32) -> string = s"f32 $x"

/** `x`, a quadruple-precision number, as it was given. */
f128_same(x: f128) -> f128 = x

/** A weighed thing: a struct with an `f32` field among others. */
struct Weighed
    name: string
    weight: f32
    exact: real

/** A thing weighing `w`, its exact weight `w` as a `real`. */
weighed(name: string, w: f32) -> Weighed = Weighed(name, w, real(w))

/** The bits of `t`'s weight, as Sysl holds it. */
weight_bits(t: Weighed) -> i64 = i64(t.weight.bits())

/** `x`, or none when `x` is negative. */
f32_maybe(x: f32) -> Option[f32] = if x < f32(0) then None else Some(x)

/** The value `x` holds, or zero. */
f32_or_zero(x: Option[f32]) -> f32 = x match
    Some(y) -> y
    None -> f32(0)

/** The first `n` halvings of `x`, as `f32`s. */
f32_halvings(x: f32, n: i32) -> Buf[f32]
    var out: Buf[f32] = buf()
    var y = x
    for _ in 0..<n
        out.push(y)
        y = y / f32(2)
    out

/** `x` with its bits, as a tuple. */
f32_with_bits(x: f32) -> (f32, i64) = (x, i64(x.bits()))

/** What `f` answers for `x`, an `f32` given and answered. */
f32_apply(f: &Fn(f32) -> f32, x: f32) -> f32 = f(x)

/** The bits of what `f` answers for the `f32` whose bits are `b`. */
f32_apply_bits(f: &Fn(f32) -> f32, b: i64) -> i64 = i64(f(f32.from_bits(u32(b))).bits())

/** A factor at the precision of an `f32`, held by a handle. */
struct Scale
    factor: f32

    /** `x` times the factor, at the precision of an `f32`. */
    scaled(self, x: f32) -> f32 = x * self.factor

    /** The factor. */
    factor_of(self) -> f32 = self.factor

/** A scale by `f`. */
new_scale(f: f32) -> &Scale = Scale(f)

/** `x` after a sleep of `ms` milliseconds, halved at the precision of an `f32`. */
f32_half_after(ms: u16, x: f32) -> f32
    sleep(millis(i64(ms)))
    x / f32(2)
