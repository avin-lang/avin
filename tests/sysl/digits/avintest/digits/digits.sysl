module avintest.digits

import sysl.buf.{Buf, buf}
import sysl.text.str_builder

/** The number of decimal digits of `n`, its sign not counted. */
digit_count(n: i64) -> i32
    var m = n
    var count = 1
    while m >= 10 || m <= -10
        m = m / 10
        count += 1
    count

/** The sum of the decimal digits of `n`, its sign not counted. */
digit_sum(n: i32) -> i32
    var m = n
    var sum = 0
    while m != 0
        val d = m % 10
        sum += if d < 0 then -d else d
        m = m / 10
    sum

/** `x` scaled by ten to the power `places`. */
shift(x: f64, places: i32) -> f64
    var out = x
    var k = places
    while k > 0
        out = out * 10.0
        k -= 1
    while k < 0
        out = out / 10.0
        k += 1
    out

/** Whether `c` is an ASCII decimal digit. */
is_digit(c: char) -> bool = c >= '0' && c <= '9'

/** The digit `d` stands for, or '?' when `d` is not between zero and nine. */
digit_char(d: i32) -> char = if d >= 0 && d <= 9 then char(u32('0') + u32(d)) else '?'

/** `text` with every decimal digit removed. */
without_digits(text: string) -> string
    var out = str_builder()
    for c in text.chars
        if !is_digit(c) then out.push_char(c)
    out.finish()

/** The sum of `bytes`, wrapping at 256. */
checksum(bytes: []const u8) -> u8
    var sum = 0u8
    for b in bytes
        sum = sum +% b
    sum

/** The number of decimal digits of `n`, as a `u8`. */
digit_count_u8(n: i64) -> u8 = u8(digit_count(n))

/** The number of decimal digits of `n`, as a `u16`. */
digit_count_u16(n: i64) -> u16 = u16(digit_count(n))

/** The number of decimal digits of `n`, as a `u32`. */
digit_count_u32(n: i64) -> u32 = u32(digit_count(n))

/** The number of decimal digits of `n`, as a `u64`. */
digit_count_u64(n: i64) -> u64 = u64(digit_count(n))

/** The number of decimal digits of `n`, as a `usize`. */
digit_count_usize(n: i64) -> usize = usize(digit_count(n))

/** The number of decimal digits of `n`, as an `isize`. */
digit_count_isize(n: i64) -> isize = isize(digit_count(n))

/** Ten to the power `places`. */
power_of_ten(places: i32) -> i64
    var out = 1i64
    for _ in 0..<places
        out = out * 10
    out

/** The largest unsigned 64-bit integer. */
largest_u64() -> u64 = 18446744073709551615u64

/** Writes `text` and a line break to standard output. */
say(text: string)
    prints(text + "\n")

/** The number of decimal digits of `n` as a `usize`, or none when `n` is zero. */
maybe_count(n: i64) -> Option[usize] = if n == 0 then None else Some(usize(digit_count(n)))

/** The largest unsigned 64-bit integer, as an option. */
maybe_largest() -> Option[u64] = Some(largest_u64())

/** The number of decimal digits of `n` as a `u32`, or an error when `n` is negative. */
counted(n: i64) -> Result[u32, string] = if n < 0 then Err("negative") else Ok(u32(digit_count(n)))

/** `text` back, or the error code `code` when `text` is empty. */
coded(text: string, code: i64) -> Result[string, i64] = if text == "" then Err(code) else Ok(text)

/** The decimal digits of `n`, most significant first, its sign not counted. */
digits_of(n: i64) -> []u8
    var out: []u8 = [0u8; usize(digit_count(n))]
    var m = if n < 0 then -n else n
    var i = out.len
    while i > 0
        i -= 1
        out[i] = u8(m % 10)
        m = m / 10
    out

/** The decimal digits of `n` as `u16`s in a buffer, least significant first. */
digit_buf(n: i64) -> Buf[u16]
    val ds = digits_of(n)
    var out: Buf[u16] = buf()
    var i = ds.len
    while i > 0
        i -= 1
        out.push(u16(ds[i]))
    out

/** The decimal digits of each of `a` and `b`. */
digit_rows(a: i64, b: i64) -> Buf[[]u8]
    var out: Buf[[]u8] = buf()
    out.push(digits_of(a))
    out.push(digits_of(b))
    out

/** Ten to each power from zero below `count`. */
powers(count: i32) -> []i64
    var out: []i64 = [0i64; usize(count)]
    for i in 0..<usize(count)
        out[i] = power_of_ten(i32(i))
    out

/** The decimal digits of `n`, or none when `n` is zero. */
maybe_digits(n: i64) -> Option[[]u8] = if n == 0 then None else Some(digits_of(n))

/** A number's digits and how far they reach: the count of them, the place of the first nonzero
 * one when there is one, and the digits themselves. */
struct Spread
    count: usize
    first_nonzero: Option[usize]
    digits: []u8

/** The spread of `n`'s decimal digits. */
spread_of(n: i64) -> Spread
    val ds = digits_of(n)
    var first: Option[usize] = None
    for i in 0..<ds.len
        if ds[i] != 0 && first is None then first = Some(i)
    Spread(ds.len, first, ds)

/** The number of decimal digits of the number `n` holds, or zero when it holds none. */
count_or_zero(n: Option[i64]) -> i32 = n match
    Some(m) -> digit_count(m)
    None -> 0

/** How many tallies have been given back. */
var tallies_given_back = 0i64

/** A running total with a destructor, which counts the tallies given back. */
struct Tally
    total: i64

    /** Adds `n` to the total. */
    add(*self, n: i64)
        self.total += n

    /** The total. */
    get(self) -> i64 = self.total

    /** Adds the total of `other` to this one's. */
    absorb(*self, other: &Tally)
        self.total += other.total

impl Drop for Tally
    drop(self) = tallies_given_back += 1

/** A tally starting at `n`. */
new_tally(n: i64) -> &Tally = Tally(n)

/** How many tallies have been given back. */
given_back() -> i64 = tallies_given_back

/** The sum of the totals of `a` and `b`. */
sum_of(a: &Tally, b: &Tally) -> i64 = a.total + b.total

/** Adds one to `t`'s total, which every holder of `t` sees. */
bump(t: &Tally)
    t.total += 1

/** Tallies starting at each number from zero below `n`. */
tallies(n: i64) -> Buf[&Tally]
    var out: Buf[&Tally] = buf()
    for i in 0..<n
        out.push(Tally(i))
    out

/** Tallies starting at each number from zero below `n`, or an error when `n` is negative. */
maybe_tallies(n: i64) -> Result[Buf[&Tally], string] = if n < 0 then Err("negative") else Ok(tallies(n))

/** A place on a line, a value with no destructor. */
struct Mark
    at: i64

    /** The place. */
    place(self) -> i64 = self.at

/** The mark at `n`. */
mark_at(n: i64) -> Mark = Mark(n)

/** The distance from `a` to `b`. */
distance(a: Mark, b: Mark) -> i64 = b.at - a.at

/** Moves `m` one place on, through a pointer to it. */
nudge(m: *Mark)
    m.at += 1

/** Marks at each number from zero below `n`, or none when `n` is zero. */
marks(n: i64) -> Option[[]Mark]
    if n == 0 then return None
    var out: []Mark = [Mark(0); usize(n)]
    for i in 0..<usize(n)
        out[i] = Mark(i64(i))
    Some(out)

/** A book of tallies and marks: a second type whose methods take the others. */
struct Ledger
    sum: i64
    entries: i64

    /** Records `t`'s total. */
    record(*self, t: &Tally)
        self.sum += t.total
        self.entries += 1

    /** Records `m`'s place. */
    mark(*self, m: Mark)
        self.sum += m.at
        self.entries += 1

    /** The sum recorded, and how many entries made it, as `sum * 1000 + entries`. */
    summary(self) -> i64 = self.sum * 1000 + self.entries

/** An empty ledger. */
new_ledger() -> Ledger = Ledger(0, 0)
