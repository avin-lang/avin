module avintest.digits

import sysl.buf.{Buf, buf}
import sysl.sync.Atomic
import sysl.text.str_builder
import sysl.time.{millis, sleep}

/** The number of decimal digits of `n`, its sign not counted. */
digit_count(n: i64) -> i32
    var m = n
    var count = 1
    while m >= 10 || m <= -10
        m = m / 10
        count += 1
    count

/** The sum of the decimal digits of `n`, its sign not counted. */
digit_sum(n: i32) -> i32
    var m = n
    var sum = 0
    while m != 0
        val d = m % 10
        sum += if d < 0 then -d else d
        m = m / 10
    sum

/** `x` scaled by ten to the power `places`. */
shift(x: f64, places: i32) -> f64
    var out = x
    var k = places
    while k > 0
        out = out * 10.0
        k -= 1
    while k < 0
        out = out / 10.0
        k += 1
    out

/** Whether `c` is an ASCII decimal digit. */
is_digit(c: char) -> bool = c >= '0' && c <= '9'

/** The digit `d` stands for, or '?' when `d` is not between zero and nine. */
digit_char(d: i32) -> char = if d >= 0 && d <= 9 then char(u32('0') + u32(d)) else '?'

/** `text` with every decimal digit removed. */
without_digits(text: string) -> string
    var out = str_builder()
    for c in text.chars
        if !is_digit(c) then out.push_char(c)
    out.finish()

/** The sum of `bytes`, wrapping at 256. */
checksum(bytes: []const u8) -> u8
    var sum = 0u8
    for b in bytes
        sum = sum +% b
    sum

/** The number of decimal digits of `n`, as a `u8`. */
digit_count_u8(n: i64) -> u8 = u8(digit_count(n))

/** The number of decimal digits of `n`, as a `u16`. */
digit_count_u16(n: i64) -> u16 = u16(digit_count(n))

/** The number of decimal digits of `n`, as a `u32`. */
digit_count_u32(n: i64) -> u32 = u32(digit_count(n))

/** The number of decimal digits of `n`, as a `u64`. */
digit_count_u64(n: i64) -> u64 = u64(digit_count(n))

/** The number of decimal digits of `n`, as a `usize`. */
digit_count_usize(n: i64) -> usize = usize(digit_count(n))

/** The number of decimal digits of `n`, as an `isize`. */
digit_count_isize(n: i64) -> isize = isize(digit_count(n))

/** Ten to the power `places`. */
power_of_ten(places: i32) -> i64
    var out = 1i64
    for _ in 0..<places
        out = out * 10
    out

/** The largest unsigned 64-bit integer. */
largest_u64() -> u64 = 18446744073709551615u64

/** Writes `text` and a line break to standard output. */
say(text: string)
    prints(text + "\n")

/** The number of decimal digits of `n` as a `usize`, or none when `n` is zero. */
maybe_count(n: i64) -> Option[usize] = if n == 0 then None else Some(usize(digit_count(n)))

/** The largest unsigned 64-bit integer, as an option. */
maybe_largest() -> Option[u64] = Some(largest_u64())

/** The number of decimal digits of `n` as a `u32`, or an error when `n` is negative. */
counted(n: i64) -> Result[u32, string] = if n < 0 then Err("negative") else Ok(u32(digit_count(n)))

/** `text` back, or the error code `code` when `text` is empty. */
coded(text: string, code: i64) -> Result[string, i64] = if text == "" then Err(code) else Ok(text)

/** The decimal digits of `n`, most significant first, its sign not counted. */
digits_of(n: i64) -> []u8
    var out: []u8 = [0u8; usize(digit_count(n))]
    var m = if n < 0 then -n else n
    var i = out.len
    while i > 0
        i -= 1
        out[i] = u8(m % 10)
        m = m / 10
    out

/** The decimal digits of `n` as `u16`s in a buffer, least significant first. */
digit_buf(n: i64) -> Buf[u16]
    val ds = digits_of(n)
    var out: Buf[u16] = buf()
    var i = ds.len
    while i > 0
        i -= 1
        out.push(u16(ds[i]))
    out

/** The decimal digits of `n` as `u8`s in a buffer, least significant first: the element type
 * `digits_of` returns in a slice.
 */
digit_bytes(n: i64) -> Buf[u8]
    val ds = digits_of(n)
    var out: Buf[u8] = buf()
    var i = ds.len
    while i > 0
        i -= 1
        out.push(ds[i])
    out

/** Ten to each power from zero below `count`, largest first, in a buffer: the element type `powers`
 * returns in a slice.
 */
power_buf(count: i32) -> Buf[i64]
    var out: Buf[i64] = buf()
    var i = count
    while i > 0
        i -= 1
        out.push(power_of_ten(i))
    out

/** The decimal digits of each of `a` and `b`. */
digit_rows(a: i64, b: i64) -> Buf[[]u8]
    var out: Buf[[]u8] = buf()
    out.push(digits_of(a))
    out.push(digits_of(b))
    out

/** Ten to each power from zero below `count`. */
powers(count: i32) -> []i64
    var out: []i64 = [0i64; usize(count)]
    for i in 0..<usize(count)
        out[i] = power_of_ten(i32(i))
    out

/** The decimal digits of `n`, or none when `n` is zero. */
maybe_digits(n: i64) -> Option[[]u8] = if n == 0 then None else Some(digits_of(n))

/** A number's digits and how far they reach: the count of them, the place of the first nonzero
 * one when there is one, and the digits themselves. */
struct Spread
    count: usize
    first_nonzero: Option[usize]
    digits: []u8

/** The spread of `n`'s decimal digits. */
spread_of(n: i64) -> Spread
    val ds = digits_of(n)
    var first: Option[usize] = None
    for i in 0..<ds.len
        if ds[i] != 0 && first is None then first = Some(i)
    Spread(ds.len, first, ds)

/** The number of decimal digits of the number `n` holds, or zero when it holds none. */
count_or_zero(n: Option[i64]) -> i32 = n match
    Some(m) -> digit_count(m)
    None -> 0

/** How many tallies have been given back. */
var tallies_given_back = 0i64

/** A running total with a destructor, which counts the tallies given back. */
struct Tally
    total: i64

    /** Adds `n` to the total. */
    add(*self, n: i64)
        self.total += n

    /** The total. */
    get(self) -> i64 = self.total

    /** The total so far. */
    value(*self) -> i64 = self.total

    /** Adds the total of `other` to this one's. */
    absorb(*self, other: &Tally)
        self.total += other.total

    /** Adds `n`, an unsigned amount, to the total. */
    add_unsigned(*self, n: u32)
        self.total += i64(n)

    /** Adds `n`, a byte's worth, to the total, and answers the total. */
    add_small(*self, n: u8) -> i64
        self.total += i64(n)
        self.total

    /** Adds `n` `times` times and `extra` once, and answers the total. */
    add_times(*self, n: i64, times: i64 = 1, extra: i64 = 0) -> i64
        self.total += n * times + extra
        self.total

impl Drop for Tally
    drop(self) = tallies_given_back += 1

/** A tally starting at `n`. */
new_tally(n: i64) -> &Tally = Tally(n)

/** How many tallies have been given back. */
given_back() -> i64 = tallies_given_back

/** The sum of the totals of `a` and `b`. */
sum_of(a: &Tally, b: &Tally) -> i64 = a.total + b.total

/** Adds one to `t`'s total, which every holder of `t` sees. */
bump(t: &Tally)
    t.total += 1

/** Tallies starting at each number from zero below `n`. */
tallies(n: i64) -> Buf[&Tally]
    var out: Buf[&Tally] = buf()
    for i in 0..<n
        out.push(Tally(i))
    out

/** Tallies starting at each number from zero below `n`, or an error when `n` is negative. */
maybe_tallies(n: i64) -> Result[Buf[&Tally], string] = if n < 0 then Err("negative") else Ok(tallies(n))

/** A place on a line, a value with no destructor. */
struct Mark
    at: i64

    /** The place. */
    place(self) -> i64 = self.at

/** The mark at `n`. */
mark_at(n: i64) -> Mark = Mark(n)

/** The distance from `a` to `b`. */
distance(a: Mark, b: Mark) -> i64 = b.at - a.at

/** Moves `m` one place on, through a pointer to it. */
nudge(m: *Mark)
    m.at += 1

/** Marks at each number from zero below `n`, or none when `n` is zero. */
marks(n: i64) -> Option[[]Mark]
    if n == 0 then return None
    var out: []Mark = [Mark(0); usize(n)]
    for i in 0..<usize(n)
        out[i] = Mark(i64(i))
    Some(out)

/** A book of tallies and marks: a second type whose methods take the others. */
struct Ledger
    sum: i64
    entries: i64

    /** Records `t`'s total. */
    record(*self, t: &Tally)
        self.sum += t.total
        self.entries += 1

    /** Records `m`'s place. */
    mark(*self, m: Mark)
        self.sum += m.at
        self.entries += 1

    /** The sum recorded, and how many entries made it, as `sum * 1000 + entries`. */
    summary(self) -> i64 = self.sum * 1000 + self.entries

/** An empty ledger. */
new_ledger() -> Ledger = Ledger(0, 0)

/** The count of `n`'s decimal digits and the digits as text. */
count_and_text(n: i64) -> (i64, string) = (i64(digit_count(n)), digits_text(n))

// The decimal digits of `n` as text, its sign not counted.
private digits_text(n: i64) -> string
    var b = str_builder()
    for d in digits_of(n)
        b.push_char(digit_char(i32(d)))
    b.finish()

/** `n`'s digit count as a `usize` beside `n` itself as a `u64`, for a binding that narrows both. */
wide_pair(n: i64) -> (usize, u64) = (usize(digit_count(n)), u64(n))

/** Each decimal digit of `n` beside the character that writes it. */
digit_pairs(n: i64) -> Buf[(u8, char)]
    var out: Buf[(u8, char)] = buf()
    for d in digits_of(n)
        out.push((d, digit_char(i32(d))))
    out

/** The text and the count of `n`'s digits, or none when `n` is zero. */
maybe_pair(n: i64) -> Option[(string, u32)] = if n == 0 then None else Some((digits_text(n), u32(digit_count(n))))

/** The sum of a pair. */
pair_sum(p: (i64, i32)) -> i64 = p.0 + i64(p.1)

/** Each label and its number, written `label=number` and joined by commas. */
labelled(pairs: [](string, i64)) -> string
    var b = str_builder()
    for i in 0..<pairs.len
        if i > 0 then b.push(",")
        b.push(pairs[i].0)
        b.push("=")
        b.push(s"${pairs[i].1}")
    b.finish()

/** A tally of `n`'s digits beside the digits as text. */
tally_of(n: i64) -> (&Tally, string)
    val t: &Tally = Tally(i64(digit_sum(i32(n))))
    (t, digits_text(n))

/** Two tallies, of `a`'s digit sum and of `b`'s, or an error when either is negative. */
two_tallies(a: i64, b: i64) -> Result[(&Tally, &Tally), string]
    if a < 0 || b < 0 then return Err("negative")
    val x: &Tally = Tally(i64(digit_sum(i32(a))))
    val y: &Tally = Tally(i64(digit_sum(i32(b))))
    Ok((x, y))

/** `n` beside its digits as text and its digit count, a tuple inside a tuple. */
nested_pair(n: i64) -> (i64, (string, u8)) = (n, (digits_text(n), u8(digit_count(n))))

/** A number written out and placed: its digits as text, and its digit count beside itself. */
struct Placed
    text: string
    place: (u32, i64)

/** `n` placed. */
placed(n: i64) -> Placed = Placed(digits_text(n), (u32(digit_count(n)), n))

/** Writes the decimal digits of `n`, most significant first, into the start of `into`, as many as
 * fit, and answers how many it wrote. */
fill_digits(n: i64, into: []u8) -> usize
    val ds = digits_of(n)
    val count = if ds.len < into.len then ds.len else into.len
    for i in 0..<count
        into[i] = ds[i]
    count

/** Writes the digits of `n` into `into` as `fill_digits` does, and answers how many, or none when
 * they did not all fit. */
fill_all_digits(n: i64, into: []u8) -> Option[usize]
    val count = fill_digits(n, into)
    if count == usize(digit_count(n)) then Some(count) else None

/** Copies `from` into the start of `into`, as much as fits, and answers how much it copied. */
copy_into(from: []const u8, into: []u8) -> usize
    val count = if from.len < into.len then from.len else into.len
    for i in 0..<count
        into[i] = from[i]
    count

/** Sets each element of `into` to the square of its index, and answers how many it set. */
fill_squares(into: []i32) -> usize
    for i in 0..<into.len
        into[i] = i32(i * i)
    into.len

/** Sets each element of `into` to ten to the power of its index. */
fill_powers(into: []i64)
    for i in 0..<into.len
        into[i] = power_of_ten(i32(i))

/** Sets each element of `into` to its index and its negation, alternately, and answers the last. */
fill_small(into: []i16) -> i16
    var last = 0i16
    for i in 0..<into.len
        last = if i % 2 == 0 then i16(i) else -i16(i)
        into[i] = last
    last

/** Sets each element of `into` to its index less eight. */
fill_tiny(into: []i8)
    for i in 0..<into.len
        into[i] = i8(i) - 8

/** Sets each element of `into` to half its index, and answers their sum. */
fill_halves(into: []f64) -> f64
    var sum = 0.0
    for i in 0..<into.len
        into[i] = f64(i) / 2.0
        sum = sum + into[i]
    sum

/** Sets each element of `into` to whether its index is even, and answers how many are. */
fill_flags(into: []bool) -> i32
    var count = 0
    for i in 0..<into.len
        into[i] = i % 2 == 0
        if into[i] then count += 1
    count

/** Sets each element of `into` to a letter, from `a` on, and answers the letters as a string. */
fill_letters(into: []char) -> string
    var out = str_builder()
    for i in 0..<into.len
        into[i] = char(u32('a') + u32(i))
        out.push_char(into[i])
    out.finish()

/** Sets each element of `into` to a name, and answers how many it set. */
name_all(into: []string) -> usize
    for i in 0..<into.len
        into[i] = "name"
    into.len

/** Fills the slice `into` holds as `fill_digits` does, or answers zero when it holds none. */
fill_maybe(n: i64, into: Option[[]u8]) -> usize = into match
    Some(s) -> fill_digits(n, s)
    None -> 0

/** The checksum of the bytes `bytes` holds, or zero when it holds none. */
maybe_checksum(bytes: Option[[]const u8]) -> u8 = bytes match
    Some(b) -> checksum(b)
    None -> 0

/** A run of bytes a function may fill. */
struct Window
    bytes: []u8

/** Fills the window's bytes with the digits of `n`, as `fill_digits` does. */
fill_window(n: i64, w: Window) -> usize = fill_digits(n, w.bytes)

/** A source of bytes counting up from where it was started, as a stream hands out what it reads. */
struct Counter
    private next: u8

    /** Fills `into` with the next bytes of the count, and answers how many. */
    read(*self, into: []u8) -> usize
        for i in 0..<into.len
            into[i] = self.next
            self.next = self.next +% 1
        into.len

/** A counter whose first byte is `first`. */
new_counter(first: u8) -> Counter = Counter(first)

// A gate one thread waits at until another opens it, for calls that block.
private var gate_open: Atomic[i32] = Atomic(0)
private var gate_waiters: Atomic[i32] = Atomic(0)

/** Waits until `open_gate` is called, sleeping a millisecond at a time, and answers how many times
 * it slept. The caller is blocked in this call for as long as the gate stays shut. */
wait_at_gate() -> u64
    gate_waiters.add(1)
    var naps = 0u64
    while gate_open.load() == 0
        sleep(millis(1))
        naps += 1
    gate_waiters.sub(1)
    naps

/** How many threads are waiting at the gate. */
gate_waiters_now() -> i32 = gate_waiters.load()

/** Opens the gate, letting every waiter go; `close_gate` shuts it again. */
open_gate() = gate_open.store(1)

/** Shuts the gate. */
close_gate() = gate_open.store(0)

/** `text` after a sleep of `ms` milliseconds, or the error `ms` when it is negative. */
echo_after(text: string, ms: i64) -> Result[string, i64]
    if ms < 0 then return Err(ms)
    sleep(millis(ms))
    Ok(text)

/** A latch with a label: `wait` blocks until `open` is called. */
struct Latch
    opened: Atomic[i32]
    label: Buf[u8]

    /** Waits until the latch or the gate is opened, sleeping a millisecond at a time, and answers
     * its label: a view of the latch. */
    @views(self)
    wait(*self) -> []const u8
        while self.opened.load() == 0 && gate_open.load() == 0
            sleep(millis(1))
        self.label.view()

    /** Opens the latch, letting its waiters go. */
    open(*self) = self.opened.store(1)

/** A shut latch labelled `label`. */
new_latch(label: string) -> Latch
    var b: Buf[u8] = buf()
    for c in label.bytes do b.push(c)
    Latch(Atomic(0), b)

/** Waits at the gate, then writes the digits of `n` into `into` as `fill_digits` does: the slice is
 * written only once the gate opens. */
fill_after_gate(n: i64, into: []u8) -> usize
    wait_at_gate()
    fill_digits(n, into)

/** Waits at the gate, then sets each element of `into` to the square of its index, and answers how
 * many it set beside the squares written out. */
squares_after_gate(into: []i32) -> (usize, string)
    wait_at_gate()
    var b = str_builder()
    for i in 0..<into.len
        into[i] = i32(i * i)
        if i > 0 then b.push(",")
        b.push(s"${into[i]}")
    (into.len, b.finish())

/** Waits at the gate, then answers what `count_and_text` does. */
pair_after_gate(n: i64) -> (i64, string)
    wait_at_gate()
    count_and_text(n)

/** Where a count comes from: a tally, which every holder shares, a mark, a plain number, or a tally
 * and a mark together. */
enum Source
    FromTally(tally: &Tally)
    FromMark(mark: Mark)
    Number(n: i64)
    Both(tally: &Tally, mark: Mark)

/** The count `s` gives: a tally's total, a mark's place, the number, or for both, the total times a
 * hundred and the place. */
count_of(s: Source) -> i64 = s match
    FromTally(t) -> t.total
    FromMark(m) -> m.at
    Number(n) -> n
    Both(t, m) -> t.total * 100 + m.at

/** Adds one to the tally `s` holds, when it holds one, which every holder of the tally sees, and
 * answers the count `s` gives then. */
bump_source(s: Source) -> i64
    s match
        FromTally(t) -> bump(t)
        Both(t, _) -> bump(t)
        _ -> ()
    count_of(s)

/** The sum of the counts `sources` give. */
count_all(sources: []const Source) -> i64
    var sum = 0i64
    for s in sources
        sum += count_of(s)
    sum

/** The count the source `s` holds gives, or minus one when it holds none. */
count_maybe(s: Option[Source]) -> i64 = s match
    Some(x) -> count_of(x)
    None -> -1

/** A source for `n`: a mark at it when it is negative, the number zero for zero, and otherwise a new
 * tally starting at it beside a mark at it. */
source_of(n: i64) -> Source
    if n < 0 then return FromMark(Mark(n))
    if n == 0 then return Number(0)
    val t: &Tally = Tally(n)
    Both(t, Mark(n))

/** A tally pinned to a mark. */
struct Pin
    tally: &Tally
    mark: Mark

/** The pin's total times a thousand and its place. */
pin_count(p: Pin) -> i64 = p.tally.total * 1000 + p.mark.at

/** A new tally starting at `n`, pinned to a mark at `n` less one. */
new_pin(n: i64) -> Pin
    val t: &Tally = Tally(n)
    Pin(t, Mark(n - 1))

/** `x` as its Sysl type writes it: one function for each integer type a binding's parameter is
 * converted into. */
show_u8(x: u8) -> string = s"$x"
show_u16(x: u16) -> string = s"$x"
show_u32(x: u32) -> string = s"$x"
show_u64(x: u64) -> string = s"$x"
show_usize(x: usize) -> string = s"$x"
show_i8(x: i8) -> string = s"$x"
show_i16(x: i16) -> string = s"$x"
show_i32(x: i32) -> string = s"$x"
show_i64(x: i64) -> string = s"$x"

/** Three integers of three Sysl types, written in order. */
show_mixed(a: u8, b: i64, c: u32) -> string = s"$a $b $c"

/** `x` itself, of whatever type it is. */
same[T](x: T) -> T = x

/** `x` added to itself, of whatever integer type it is. */
doubled[T: Integer + Add](x: T) -> T = x + x

/** `x` written after a sleep of `ms` milliseconds. */
show_u32_after(ms: u16, x: u32) -> string
    sleep(millis(i64(ms)))
    s"$x"

/** A place on a grid, a struct of plain fields. */
struct Spot
    x: i32
    y: i32

/** A shade, an enum of plain variants. */
enum Shade
    Light
    Dark(level: i32)

/** The first value `xs` holds, or none. */
first_some[T](xs: []const Option[T]) -> Option[T]
    for x in xs
        if x is Some(_) then return x
    None

/** The parts of `p`, the other way round. */
swapped[A, B](p: (A, B)) -> (B, A)
    val (a, b) = p
    (b, a)

/** The larger of `a` and `b`. */
larger[T: PartialOrd](a: T, b: T) -> T = if a < b then b else a

/** `n` copies of `x`. */
copies[T](x: T, n: i64) -> Buf[T]
    var out: Buf[T] = buf()
    for _ in 0..<n
        out.push(x)
    out

/** What `f` makes of `x`. */
applied[T, U](x: T, f: &Fn(T) -> U) -> U = f(x)

/** `x` when `ok`, or else `e`. */
either[T, E](ok: bool, x: T, e: E) -> Result[T, E] = if ok then Ok(x) else Err(e)
