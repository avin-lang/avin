module avintest.digits

import sysl.time.{millis, sleep}

// Functions whose parameters have defaults, which a binding that passes its arguments by name leaves
// to Sysl. Each answers what it was given, so a test sees which value every parameter took.

var stamps_made = 0i64

/** The next stamp: one more than the last, so each default evaluated is a different one. */
next_stamp() -> i64
    stamps_made += 1
    stamps_made

/** How many stamps have been made. */
stamps() -> i64 = stamps_made

/** A width twice the one the caller would guess. */
wide() -> i32 = 450 * 2

/** What the window would be, said in words, after `on_tick` is called once with a quarter. */
framed(title: string, width: i32 = wide(), height: i32 = 660, label: string = "none", scale: f32 = 1.5,
    on_tick: &Fn(real) -> unit = dt -> ()) -> string
    on_tick(0.25)
    s"$title ${width}x$height $label ${real(scale)}"

/** `text` and the stamp it was given, which by default is a fresh one at every call. */
stamped(text: string, stamp: i64 = next_stamp()) -> string = s"$text#$stamp"

/** `x` times `by`, an integer. */
scaled(x: i64, by: i64 = 2) -> i64 = x * by

/** `x` times `by`, a real. */
scaled(x: real, by: real = 0.5) -> real = x * by

/** `x` after waiting `ms` milliseconds. */
waited(x: i64, ms: i64 = 1, plus: i64 = 100) -> i64
    sleep(millis(ms))
    x + plus

/** The text `a`, `b` and `c` make, the last two defaulted. */
joined(a: string, b: string = "B", c: string = "C") -> string = a + b + c

/** The sum of `n` and `m`, neither defaulted. */
both(n: i64, m: i64) -> i64 = n + m
