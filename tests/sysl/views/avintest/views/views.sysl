module avintest.views

import sysl.buf.{Buf, buf}

/** Something drawn: every view describes itself, and may be padded. */
trait View
    describe(&self) -> string
    padding(&self, n: int) -> &View = Padding(self, n)

/** A line of text. */
struct Text
    s: string
end Text

impl View for Text
    describe(&self) -> string = s"text(${self.s})"

/** A view with room around it. */
struct Padding
    inner: &View
    n: int
end Padding

impl View for Padding
    describe(&self) -> string = s"pad(${self.n}, ${self.inner.describe()})"

/** Views one above another. */
struct Column
    children: []&View
    spacing: int
end Column

impl View for Column
    describe(&self) -> string
        var out = s"column(${self.spacing}"
        for c in self.children
            out = out + ", " + c.describe()
        out + ")"

/** How many `Marked` views have been given back. */
var marks_given_back: i64 = 0

/** A view that counts its being given back. */
struct Marked
    id: int
end Marked

impl View for Marked
    describe(&self) -> string = s"mark(${self.id})"

impl Drop for Marked
    drop(self)
        marks_given_back += 1

/** A line of text. */
text(s: string) -> &View = Text(s)

/** A view that counts its being given back. */
marked(id: int) -> &View = Marked(id)

/** How many `Marked` views have been given back. */
marks_back() -> i64 = marks_given_back

/** Views one above another. */
column(children: []&View, spacing: int) -> &View = Column(children, spacing)

/** Views one above another, from a slice the function may only read. */
column_reading(children: []const &View) -> &View
    var b: Buf[&View] = buf()
    for c in children
        b.push(c)
    Column(b.into_view(), 0)

/** How many views `children` holds. */
count(children: []&View) -> int = int(children.len)

/** The descriptions of `children`, joined. */
describe_all(children: []&View) -> string
    var out = ""
    for c in children
        out = out + "[" + c.describe() + "]"
    out

/** The views `v` is made of: a column's children, and no others. */
children_of(v: &View) -> []&View
    val d = v.describe()
    var b: Buf[&View] = buf()
    b.push(text(d))
    b.push(v)
    b.into_view()

/** `n` texts, numbered, in a `Buf`. */
texts(n: int) -> Buf[&View]
    var b: Buf[&View] = buf()
    for i in 0..<n
        b.push(text(s"$i"))
    b

/** The same view, returned. */
same(v: &View) -> &View = v

/** A view, or none. */
maybe_text(s: string) -> Option[&View] = if s == "" then None else Some(text(s))

/** A value that changes, read and set. */
struct Signal[T]
    value: T
    read(self) -> T = self.value
    set(*self, v: T) = self.value = v
    paired[U](self, u: U) -> (T, U) = (self.value, u)
end Signal

/** A new signal holding `v`. */
signal[T](v: T) -> &Signal[T] = Signal(v)

/** The signal's value held between `lo` and `hi`, as a slider holds its value: the type of the
 * bounds is the signal's, so a call infers it from the signal and the bounds together. */
clamped[T: PartialOrd](s: &Signal[T], lo: T, hi: T) -> T
    val v = s.read()
    if v < lo then lo elif v > hi then hi else v

/** The signal's value written `width` wide, the width an unsigned one. */
padded_count(s: &Signal[int], width: u16) -> string
    var out = s"${s.read()}"
    while out.bytes.len < usize(width)
        out = " " + out
    out

/** A text field showing the signal it edits. */
text_field(text: &Signal[string], width: int) -> &View = Text(s"${text.read()}@$width")

/** A label showing a count. */
counter_label(c: &Signal[int]) -> &View = Text(s"count=${c.read()}")

/** Adds one to a counted signal. */
bump(c: &Signal[int]) = c.set(c.read() + 1)

/** The sum of the signals' values. */
total(signals: []&Signal[int]) -> int
    var t = 0
    for s in signals
        t += s.read()
    t

/** Something holding a value of type `T`. */
trait Thing[T]
    get(&self) -> T
    named(&self) -> string

/** A thing holding its value. */
struct Holder[T]
    v: T
end Holder

impl[U] Thing[U] for Holder[U]
    get(&self) -> U = self.v
    named(&self) -> string = "holder"

/** A thing holding an integer. */
thing_int(v: int) -> &Thing[int] = Holder(v)

/** A thing holding a string. */
thing_string(v: string) -> &Thing[string] = Holder(v)

/** The sum of what each thing holds. */
thing_sum(things: []&Thing[int]) -> int
    var t = 0
    for x in things
        t += x.get()
    t

/** An application: a title and the tree its callback builds. */
struct App
    title: string
    tree: &Fn() -> &View
end App

/** An application whose tree `tree` builds. */
app(title: string, tree: &Fn() -> &View) -> &App = App(title, tree)

/** Builds the application's tree and describes it. */
run(a: &App) -> string = s"${a.title}: ${(a.tree)().describe()}"

/** The tree `tree` builds, described, built `n` times. */
render(tree: &Fn() -> &View, n: int) -> string
    var out = ""
    for _ in 0..<n
        out = out + tree().describe() + ";"
    out

/** A column of what `make` builds for each number below `n`. */
column_of(make: &Fn(int) -> &View, n: int) -> &View
    var b: Buf[&View] = buf()
    for i in 0..<n
        b.push(make(i))
    Column(b.into_view(), 0)

/** A struct with a value of its own, reached by a handle. */
struct Counter
    n: int
    bump(*self) = self.n += 1
    get(self) -> int = self.n
end Counter

/** A new counter. */
counter() -> Counter = Counter(0)

/** The sum of the counters' values. */
counter_sum(counters: []Counter) -> int
    var t = 0
    for c in counters
        t += c.n
    t

/** The sum of the counters' values, read through pointers. */
counter_sum_at(counters: []*Counter) -> int
    var t = 0
    for c in counters
        t += c.n
    t

/** Two views, as a pair. */
pair_of(a: &View, b: &View) -> (&View, &View) = (a, b)

/** A view and its label. */
struct Framed
    view: &View
    label: string
end Framed

/** A view and its label. */
framed(v: &View, label: string) -> Framed = Framed(v, label)

/** A framed view, described. */
frame_text(f: Framed) -> string = s"${f.label}=${f.view.describe()}"

/** Views kept in order, reached by a handle whose methods take slices of views. */
struct Stack
    items: Buf[&View]
    push_all(*self, views: []&View)
        for v in views
            self.items.push(v)
    size(self) -> int = int(self.items.len())
    describe(self) -> string
        var out = ""
        for v in self.items
            out = out + v.describe() + " "
        out
end Stack

/** An empty stack. */
stack() -> &Stack = Stack(buf())

/** A value and the last one it held. */
struct Pair[A, B]
    first: A
    second: B
    swap(self) -> Pair[B, A] = Pair(self.second, self.first)
    first_of(self) -> A = self.first
    second_of(self) -> B = self.second
end Pair

/** A pair of `a` and `b`. */
pair[A, B](a: A, b: B) -> &Pair[A, B] = Pair(a, b)

/** How many views a buffer holds. */
count_buf(children: Buf[&View]) -> int = int(children.len())

/** What `f` makes of `v` and of `v` padded; `f` may keep the view it is given, as a handle does. */
visit(v: &View, f: &Fn(@keeps &View) -> string) -> string = f(v) + "|" + f(v.padding(1))
