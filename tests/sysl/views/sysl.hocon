// A small Sysl package that Avin programs in tests/programs reach through `sysl-dependencies`, shaped
// like a user interface library: a trait `View` with struct implementations, constructors taking a
// slice of views, a generic `Signal[T]` and a generic trait `Thing[T]`, and an application that
// builds its tree by calling back.
package { name = "views", version = "0.1.0", sysl = "0.8.0" }
