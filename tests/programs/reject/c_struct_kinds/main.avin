// The C unit checks a struct mirror's struct is a struct its headers declare, and an opaque value's
// type a struct or a union they declare.
// error: the C struct mirror `Missing` mirrors `as_nope`, which its headers do not declare as a type: clang says 'unknown type name 'as_nope'
// error: the C struct mirror `NotStruct` mirrors `as_not_struct`, which is not a struct in its headers
// error: the C struct mirror `UnionMirror` mirrors `as_some_union`, which is not a struct in its headers
// error: the opaque value `Scalar` holds a copy of `as_scalar_value`, which is not a struct or a union in its headers: a scalar crosses as itself
// error: the opaque value `Nowhere` holds a copy of `as_nowhere`, which its headers do not declare as a type: clang says 'unknown type name 'as_nowhere'

@c(struct: "as_nope")
data Missing(x: int)

@c(struct: "as_not_struct")
data NotStruct(x: int)

@c(struct: "as_some_union")
data UnionMirror(i: int)

@c(value: "as_scalar_value")
class Scalar

@c(value: "as_nowhere")
class Nowhere

main() = 0
