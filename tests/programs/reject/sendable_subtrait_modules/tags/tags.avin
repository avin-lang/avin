module tags

// A trait promising `Sendable`, with a bounded impl for the standard library's `Vector` and impls the
// type's structure cannot keep: for a class with a `var`, and for one instance of a mutable type.
trait Tag: Sendable
  tag -> string

data Label(name: string)

impl[T: Tag] Tag for Vector[T]
  tag -> string = "v"

class Slot[A](var value: A)

impl[A: Tag] Tag for Slot[A]
  tag -> string = "slot"

impl Tag for Buffer[Label]
  tag -> string = "buffer"
