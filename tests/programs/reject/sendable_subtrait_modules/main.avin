// error: `Slot[A]` promises to be `Sendable`, but its field `value` is a `var`; make it a `val`
// error: `Tag` promises to be `Sendable`, so an impl of it for `Buffer[Label]` requires `Buffer[Label]` to be `Sendable` already, but it is mutable; an immutable copy (`toVector`) is sendable
// error: `Vector[int]` does not conform to `Tag`, the bound of `T` in `tagged`
// An imported impl of a trait promising `Sendable` keeps its own bound at a use in another module,
// and the impls its module cannot keep are refused there; `Vector[long]` stays `Sendable`.
import tags.{Label, Tag}

send[T: Sendable](value: T) -> string = "sent"

tagged[T: Tag](value: T) -> string = value.tag

main()
  val longs: Vector[long] = [1]
  println(send(longs))
  println(tagged([1]))
