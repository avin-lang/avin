// An enum mirror is read from and written to a field of an integer type, its enum or another, which
// the C unit checks: a floating-point field and a pointer are neither.
// error: the field `precise` of the C handle `Record` is not an integer type in the headers, so `Record.preciseShade` cannot read it as `Shade`
// error: the field `name` of the C handle `Record` is not an integer type in the headers, so `Record.nameShade` cannot read it as `Shade`
// error: the field `precise` of the C handle `Record` is not an integer type in the headers, so `Record.setPreciseShade` cannot write it as `Shade`

@c(enum: "enum fxf_shade", prefix: "FXF_")
data Shade
    Light
    Dark

@c(type: "fxf_record *", release: "fxf_record_unref", retain: "fxf_record_ref")
class Record
    @c(field: "precise")
    preciseShade() -> Shade

    @c(field: "name")
    nameShade() -> Shade

    @c(field: "precise")
    setPreciseShade(s: Shade)

main() = 0
