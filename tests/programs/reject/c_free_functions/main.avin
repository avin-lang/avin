// The function `free:` names must be declared by the headers as one taking the string, or any
// pointer, and answering nothing.
// error: the C binding `wrongParameter` frees its result with `fixture_wrong_free`, which the headers do not declare as a function taking the string and answering nothing, `void fixture_wrong_free(void *)` or `void fixture_wrong_free(char *)`
// error: the C binding `wrongResult` frees its result with `fixture_free_answer`, which the headers do not declare as a function taking the string and answering nothing, `void fixture_free_answer(void *)` or `void fixture_free_answer(char *)`
// error: the C binding `undeclared` frees its result with `fixture_no_such_free`, which no header of its package declares

@c("char *fixture_copy(const char *s)", free: "fixture_wrong_free")
wrongParameter(s: string) -> string

@c("char *fixture_copy(const char *s)", free: "fixture_free_answer")
wrongResult(s: string) -> string

@c("char *fixture_copy(const char *s)", free: "fixture_no_such_free")
undeclared(s: string) -> string

@c("char *fixture_copy(const char *s)", free: "fixture_free")
fine(s: string) -> string

main()
    println(fine("x"))
