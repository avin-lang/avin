// A mirror's bound method crosses to Sysl as a binding does: its parameters and result are boundary
// types, and Sysl checks that the method it names exists and takes what it is given.
// error: the Sysl binding `Verdict.missing` does not match `avintest.digits.Verdict`: type 'Verdict' has no method 'missing'
// error: the Sysl binding `Verdict.scaledWrongly` does not match `avintest.digits.Verdict`: 'n' of 'avintest.digits.Verdict.scaled_by' is int, but string was given
// error: the Sysl binding `Verdict.even` does not match `avintest.digits.Verdict`: cannot initialize 'r': declared string but the value is bool

@sysl("avintest.digits.Verdict")
data Verdict(code: long, note: string)

impl Verdict
    missing() -> long
    @sysl("scaled_by")
    scaledWrongly(by: string) -> long
    even() -> string

main()
    val v = Verdict(1, "a")
    println(v.missing())
    println(v.scaledWrongly("x"))
    println(v.even())
