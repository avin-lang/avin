// A constant its Avin type cannot hold is refused at the constant, naming its value, as is a string
// constant that is not UTF-8.
// error: the C constant `AE_TOO_BIG_CONST` is greater than any `long` holds, so `tooBig` cannot be `long`
// error: the C constant `AE_INT_MAX_CONST` is 2147483647, which `i16` cannot hold, so `intMaxAsShort` is a wider integer type
// error: the C constant `AE_LIMIT_MIN` is -2147483648, which `i16` cannot hold, so `enumeratorAsShort` is a wider integer type
// error: the C constant `AE_LONG_MIN_CONST` is -9223372036854775808, which `int` cannot hold, so `longMinAsInt` is a wider integer type
// error: the C constant `AE_BAD_UTF8_CONST` is a string that is not UTF-8, so `badText` cannot be a `string`

@c(const: "AE_TOO_BIG_CONST")
val tooBig: long

@c(const: "AE_INT_MAX_CONST")
val intMaxAsShort: i16

@c(const: "AE_LIMIT_MIN")
val enumeratorAsShort: i16

@c(const: "AE_LONG_MIN_CONST")
val longMinAsInt: int

@c(const: "AE_BAD_UTF8_CONST")
val badText: string

main() = 0
