import palette

probe(n: int) -> int = n match
    palette.Secret.Hush -> 1
    palette.Hush -> 2
    _ -> 0

main()
    println(palette.Color.Purple)
    println(palette.Secret.Hush)
    palette.Color.Red match
        palette.Color.Green -> println("green")
        _ -> println("other")
