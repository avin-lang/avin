// A binding is checked against a header always: a function the library holds but no header of the
// package declares is refused, and so is a prototype naming a type the headers do not declare.
// error: the C binding `undeclared` names `fixture_undeclared`, which no header of its package declares: avin_fixture.h
// error: the C binding `missing` names `avin_no_such_function`, which no header of its package declares: avin_fixture.h
// error: the C binding `unknownType` does not compile against its headers: unknown type name 'avin_no_such_t'

@c("int fixture_undeclared(int)")
undeclared(x: int) -> int

@c("int avin_no_such_function(void)")
missing() -> int

@c("avin_no_such_t fixture_echo_int(int)")
unknownType(x: int) -> int

main()
    println(undeclared(1))
