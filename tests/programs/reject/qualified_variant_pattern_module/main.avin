// error: a pattern takes its type arguments from the value it matches; write `heaps.Heap.Leaf`
// error: a pattern takes its type arguments from the value it matches; write `heaps.Heap.Node`
// A pattern on another module's variant writes no type arguments either, on the type or on the
// variant.
import heaps

main()
    val h: heaps.Heap[int] = heaps.Heap.Leaf
    h match
        heaps.Heap.Leaf[int] -> println("leaf")
        heaps.Heap[int].Node(v) -> println(v)
