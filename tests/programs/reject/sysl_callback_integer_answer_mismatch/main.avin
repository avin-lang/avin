// A callback's integer answer converts into any integer the closure Sysl takes answers, and into
// nothing else: a closure answering a string or a real is refused at the binding.
// error: the Sysl binding `integerForText` does not match `avintest.callbacks.text_op`: the function answers an integer, which goes into Sysl only as an integer, but the closure Sysl takes answers string
// error: the Sysl binding `integerForReal` does not match `avintest.callbacks.real_op`: the function answers an integer, which goes into Sysl only as an integer, but the closure Sysl takes answers real

@sysl("avintest.callbacks.text_op")
integerForText(f: (string) -> int, s: string) -> string

@sysl("avintest.callbacks.real_op")
integerForReal(f: (real) -> long, x: real) -> real

main()
    println(integerForText(s -> 1, "a"))
    println(integerForReal(x -> 1, 1.0))
