// The C unit checks each field of a struct mirror is the kind its Avin type asks for, or the struct
// another mirror mirrors; an array field is no scalar, and a bit-field no mirror holds.
// error: the field `x` of `as_point` is not an integer type in the headers, so the field `x` of the C struct mirror `IntPoint` cannot be `int`
// error: the field `origin` of `as_rect` is not `as_pair` in the headers, so the field `origin` of the C struct mirror `PairRect` cannot be `Pair`, which mirrors it
// error: the field `values` of `as_with_array` is not an integer type in the headers, so the field `values` of the C struct mirror `WithArray` cannot be `int`
// error: the field `bits` of `as_bits` is a bit-field, which no mirror holds: a struct with one crosses as an opaque value, a class declared `@c(value: "as_bits")`
// error: the field `a` of `as_pair` is not `char *` or `const char *` in the headers, so the field `name` of the C struct mirror `NamedId` cannot be `string`

@c(struct: "as_point")
data IntPoint(x: int, y: real)

@c(struct: "as_pair")
data Pair(a: int, b: int)

@c(struct: "as_point")
data Point(x: real, y: real)

@c(struct: "as_rect")
data PairRect(origin: Pair, size: Point)

@c(struct: "as_with_array")
data WithArray(values: int)

@c(struct: "as_bits")
data Bits(bits: int, rest: int)

@c(struct: "as_pair")
data NamedId(@c("a") name: string, b: int)

main() = 0
