import app.store
import app.store as s
import avin.threads.spawn
import avin.actors.isolate

var mine = 0

main()
  spawn(() ->
    var n = 0
    store.latest, n = n, 1
  ).join()
  spawn(() ->
    var n = 0
    n, s.latest = 1, n
  ).join()
  val v = isolate
    var n = 0
    store.latest, n = 1, 1
    Buffer[int]()
  val w = isolate
    var n = 0
    mine, n = 2, 3
    Buffer[int]()
  spawn(() ->
    var n = 0
    n, mine = 1, n
  ).join()
