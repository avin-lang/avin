// question failed and what the manifest says to do.
// error: the C library `nothing` of package `c-library-not-found` was not found: `pkg-config --cflags avin-no-such-module` failed. Nothing installs it.

@c("int nothing(void)")
nothing() -> int

main()
  println(nothing())
