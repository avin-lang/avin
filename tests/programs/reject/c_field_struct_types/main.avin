// A struct mirror is read from and written to a field of the struct it mirrors, which the C unit
// checks: a field of another struct and a `const` field written are refused, and a field pointing at
// bytes is no string, through an accessor or a mirror's field, the diagnostic saying why.
// error: the field `name` of `struct fxf_raw_named` points at `unsigned char` or `signed char` in the headers, which hold bytes rather than text, so the field `name` of the C struct mirror `RawNamed` cannot be `string`: a string is a pointer to `char`
// error: the field `box` of the C handle `Record` is not `struct fxf_point`, which `Spot` mirrors, in the headers, so `Record.boxAsSpot` cannot read it as `Spot`
// error: the field `anchor` of the C handle `Record` cannot be written by `Record.setAnchor`: clang says 'cannot assign to non-static data member 'anchor' with const-qualified type 'const struct fxf_point''
// error: the field `raw` of the C handle `Record` points at `unsigned char` or `signed char` in the headers, which hold bytes rather than text, so `Record.rawText` cannot read it as `string`: a string is a pointer to `char`, and bytes are lent as a view with `view` and `length:`
// error: the field `signed_raw` of the C handle `Record` points at `unsigned char` or `signed char` in the headers, which hold bytes rather than text, so `Record.signedText` cannot read it as `Option[string]`: a string is a pointer to `char`, and bytes are lent as a view with `view` and `length:`

@c(struct: "struct fxf_point")
data Spot(x: int, y: int)

@c(struct: "struct fxf_raw_named")
data RawNamed(name: string, id: int)

@c(type: "fxf_record *", release: "fxf_record_unref", retain: "fxf_record_ref")
class Record
    @c(field: "box")
    boxAsSpot() -> Spot

    @c(field: "anchor")
    setAnchor(s: Spot)

    @c(field: "raw")
    rawText() -> string

    @c(field: "signed_raw")
    signedText() -> Option[string]

main() = 0
