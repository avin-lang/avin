// The header check holds a `void *` to the header's type as it holds every pointer: a binding saying
// `const void *` where the header writes `void *` is refused, as is one saying `void *` where the
// header writes a typed pointer.
// error: the C binding `fill` does not match `aa_void_fill` in avin_arrays.h: the header declares 'void (void *, int, size_t)', but the binding says 'void (const void *, int, size_t)'
// error: the C binding `sumInts` does not match `aa_sum_ints` in avin_arrays.h: the header declares 'long long (const int32_t *, int)', but the binding says 'long long (const void *, int)'

@c("void aa_void_fill(const void *p, int c, length(p) size_t n)")
fill(p: Array[int], c: int)

@c("long long aa_sum_ints(const void *p, length(p) int n)")
sumInts(p: Array[int]) -> long

main()
  println(0)
