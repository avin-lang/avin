// A private method declared with no parameter list is read only inside its class, and its public
// one is still called without parentheses from another module.
// error: `secret` is private to `Square`
// error: `area` takes no parameter list, so it is called without parentheses: write `area`, not `area()`
import shapes.Square

main()
    val s = Square(2)
    println(s.secret)
    println(s.area())
