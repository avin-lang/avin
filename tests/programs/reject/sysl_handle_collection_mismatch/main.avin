// A collection of handles goes into Sysl as a slice of the handles' Sysl values, which the Sysl
// parameter must take: an `Array` is a slice Sysl may only read, so it does not reach a `[]&View`
// or a `[]Counter`, and a vector of one handle type does not reach a slice of another, as a handle
// on one instance of a generic type does not reach a parameter that takes another.
// error: the Sysl handle `Counter` is passed to a Sysl parameter that does not take `avintest.views.Counter`: the collection's handles go in as a `[]&Counter`, and the parameter takes a `[]&View`
// error: the Sysl handle `StringThing` is passed to a Sysl parameter that does not take `avintest.views.Thing[string]`: the collection's handles go in as a `[]&Thing[string]`, and the parameter takes a `[]&Thing[int]`
// error: the Sysl binding `counterLabel` does not match `avintest.views.counter_label`: the handle goes in as a `&Signal[long]`, and Sysl takes a `&Signal[int]` there
// error: the Sysl binding `columnOfArray` does not match `avintest.views.column`: Sysl may write the elements of its `[]&View`
// error: the Sysl binding `counterSumOfArray` does not match `avintest.views.counter_sum`: Sysl may write the elements of its `[]Counter`

@sysl("avintest.views.View")
class View
  describe() -> string

@sysl("avintest.views.Counter")
class Counter
  get() -> int

@sysl("avintest.views.Thing[string]")
class StringThing
  get() -> string

@sysl("avintest.views.Signal[long]")
class LongSignal
  read() -> long

@sysl("avintest.views.column")
columnOfArray(children: Array[View], spacing: int) -> View

@sysl("avintest.views.counter_sum")
counterSumOfArray(counters: Array[Counter]) -> int

@sysl("avintest.views.count")
countCounters(children: Vector[Counter]) -> int

@sysl("avintest.views.thing_sum")
thingSumOfStrings(things: Vector[StringThing]) -> int

@sysl("avintest.views.counter_label")
counterLabel(c: LongSignal) -> View

main() = ()
