// An import is a file's own: a given one file of a module imports fills that file's calls and no other
// file's. A module-level `val` imported by name is a value and not a given.
// error: `txId` needs a `Tx` for `tx`, and no given of that type is in scope
// error: `labelOf` needs a `Label` for `label`, and no given of that type is in scope
import app.{fromFirst, fromSecond, plain}

main()
  println(fromFirst())
  println(fromSecond())
  println(plain())
