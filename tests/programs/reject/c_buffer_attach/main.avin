// A class's `attach:` and `key:` compile in its glue against its headers.
// error: the `attach:` of the C handle `Unattachable` does not compile against its headers: clang says 'call to undeclared function 'bf_nope'; ISO C99 and later do not support implicit function declarations [-Wimplicit-function-declaration]'
// error: the `key:` of the C handle `Unkeyed` does not compile against its headers: clang says 'unknown type name 'bf_no_such_key_t''
// error: the `attach:` of the C handle `Unkeyed` does not compile against its headers: clang says 'use of undeclared identifier 'key''

@c(type: "bf_surface *", release: "bf_surface_unref", attach: "bf_nope(self, key, data, destroy)")
class Unattachable

@c(
    type: "bf_surface *",
    release: "bf_surface_unref",
    attach: "bf_surface_set_user_data(self, key, data, destroy)",
    key: "bf_no_such_key_t"
)
class Unkeyed

main() = 0
