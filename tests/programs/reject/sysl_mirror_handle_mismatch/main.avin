// A handle a Sysl mirror's field holds is its own Sysl type, which the Sysl field must take: a mark
// does not stand where the Sysl variant holds a tally, nor a tally where the Sysl struct holds a mark.
// error: the Sysl mirror `Source` does not match `avintest.digits.Source`: the handle goes in as a `&digits.avintest.digits.Mark`, and Sysl takes a `&digits.avintest.digits.Tally` there
// error: the Sysl mirror `Pin` does not match `avintest.digits.Pin`: the handle goes in as a `digits.avintest.digits.Tally`, and Sysl takes a `digits.avintest.digits.Mark` there

@sysl("avintest.digits.Tally")
class Tally
    get() -> long

@sysl("avintest.digits.Mark")
class Mark
    place() -> long

@sysl("avintest.digits.Source")
data Source
    FromTally(tally: Mark)
    FromMark(mark: Mark)
    Number(n: long)
    Both(tally: Tally, mark: Mark)

@sysl("avintest.digits.count_of")
countOf(s: Source) -> long

@sysl("avintest.digits.Pin")
data Pin(tally: Tally, mark: Tally)

@sysl("avintest.digits.pin_count")
pinCount(p: Pin) -> long

main() = ()
