// error: a lambda that captures `self` is made in a superclass's arguments, which run before the object is initialized
// error: a lambda that captures `self` is made in a superclass's arguments, which run before the object is initialized
// error: `name` is a method of the object, which a superclass's arguments cannot use as a value: they run before the object is initialized
// A superclass declared in another module is constructed the same way: its arguments still run
// before any field of the object, its own or inherited, is set.
import bases.{Base, Mid}

class Own: Base(() -> s)
  val s: string = "own"

class Leaf: Mid(() -> m)

class Named: Base(name)
  name() -> string = "named"

main()
  println(Own().got)
  println(Leaf().got)
  println(Named().got)
