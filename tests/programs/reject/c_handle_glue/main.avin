// A handle's glue is compiled by the C unit against its headers, and each diagnostic is placed at the
// class: a type the headers do not declare, a typedef that is not a pointer, and a `release:`,
// `retain:` or `kept:` name that does not compile, each in clang's own words.
// error: the C handle `Undeclared` is on `fx_nothing *`, which its headers do not declare as a type: clang says 'unknown type name 'fx_nothing''
// error: the C handle `NotPointer` is on `fx_status`, which is not a pointer in its headers
// error: the `release:` of the C handle `BadRelease` does not compile against its headers: clang says 'too many arguments to function call
// error: the `retain:` of the C handle `BadRetain` does not compile against its headers: clang says 'call to undeclared function 'fx_no_such_ref'
// error: the `release:` of the C handle `BadKept` does not compile against its headers: clang says 'no member named 'nothing' in 'struct fx_face_rec''

@c(type: "fx_nothing *", release: "fx_object_unref")
class Undeclared

@c(type: "fx_status", release: "fx_object_unref")
class NotPointer

@c(type: "fx_object *", release: "fx_object_unref(self, 1)")
class BadRelease

@c(type: "fx_object *", release: "fx_object_unref", retain: "fx_no_such_ref")
class BadRetain

@c(type: "fx_mmvar *", kept: "face: Face", release: "fx_mmvar_free(face->nothing, self)")
class BadKept

@c(type: "fx_face", release: "fx_face_done", retain: "fx_face_reference")
class Face

main() = 0
