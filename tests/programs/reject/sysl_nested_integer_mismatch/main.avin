// An integer an option, a result or a collection holds takes any Sysl integer, and nothing else: a
// Sysl value of another type is not converted into it. A `byte` is a Sysl `u8` only.
// error: the Sysl binding `maybeNumber` does not match `avintest.digits.maybe_digits`: an integer is made from a Sysl integer, but the value is []byte
// error: the Sysl binding `countedCode` does not match `avintest.digits.counted`: an integer is made from a Sysl integer, but the value is string
// error: the Sysl binding `flatRows` does not match `avintest.digits.digit_rows`: `Vector[long]` is made from a Sysl `[]I` or `Buf[I]` of any integer type `I`, and the value is none of these
// error: the Sysl binding `digitBytes` does not match `avintest.digits.digit_buf`: `Vector[byte]` is made from a Sysl `[]u8` or `Buf[u8]`, and the value is none of these
// error: the Sysl binding `countList` does not match `avintest.digits.digit_count`: `Vector[int]` is made from a Sysl `[]I` or `Buf[I]` of any integer type `I`, and the value is none of these

@sysl("avintest.digits.maybe_digits")
maybeNumber(n: long) -> Option[long]

@sysl("avintest.digits.counted")
countedCode(n: long) -> Result[int, int]

@sysl("avintest.digits.digit_rows")
flatRows(a: long, b: long) -> Vector[long]

@sysl("avintest.digits.digit_buf")
digitBytes(n: long) -> Vector[byte]

@sysl("avintest.digits.digit_count")
countList(n: long) -> Vector[int]

main()
    println(s"${maybeNumber(1)} ${countedCode(1)} ${flatRows(1, 2)} ${digitBytes(1)} ${countList(1)}")
