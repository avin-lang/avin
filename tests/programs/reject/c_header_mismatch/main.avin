// A prototype the header declares otherwise is rejected at the binding with both types as clang
// writes them, typedefs by their names, and the header that declares the function, whether a
// parameter, the result or the number of parameters differs.
// error: the C binding `adlerCombine` does not match `adler32_combine` in zlib.h: the header declares 'uLong (uLong, uLong, long)', but the binding says 'uLong (uLong, uLong, int)'
// error: the C binding `echoInt` does not match `fixture_echo_int` in avin_fixture.h: the header declares 'int (int)', but the binding says 'int (long)'
// error: the C binding `maxUint` does not match `fixture_max_uint` in avin_fixture.h: the header declares 'unsigned int (void)', but the binding says 'int (void)'
// error: the C binding `echoSize` does not match `fixture_echo_size` in avin_fixture.h: the header declares 'size_t (size_t)', but the binding says 'unsigned int (unsigned int)'
// error: the C binding `bound` does not match `compressBound` in zlib.h: the header declares 'uLong (uLong)', but the binding says 'uLong (uLong, uLong)'

@c("uLong adler32_combine(uLong, uLong, int)")
adlerCombine(a: long, b: long, n: int) -> long

@c("int fixture_echo_int(long)")
echoInt(x: long) -> int

@c("int fixture_max_uint(void)")
maxUint() -> long

@c("unsigned int fixture_echo_size(unsigned int)")
echoSize(x: long) -> long

@c("uLong compressBound(uLong, uLong)")
bound(a: long, b: long) -> long

main()
  println(echoInt(1))
