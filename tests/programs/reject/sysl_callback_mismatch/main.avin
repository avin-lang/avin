// A callback's type that does not fit the closure Sysl takes is reported at the binding, in Sysl's
// words for the closure: a parameter, the result, the number of parameters, and a closure Sysl may call
// from another thread given to a parameter not marked `@threaded`.
// error: the Sysl binding `shareUnmarked` does not match `avintest.callbacks.share`: Sysl may call the function it is given from another thread, so the parameter that takes it is marked `@threaded`
// error: the Sysl binding `wrongParameter` does not match `avintest.callbacks.apply`: the function's parameter 1 is string, but Sysl calls it with int
// error: the Sysl binding `wrongResult` does not match `avintest.callbacks.apply`: this closure should yield int, but its body yields string
// error: the Sysl binding `wrongArity` does not match `avintest.callbacks.apply`: this closure takes 2 parameters, and what it is being used as takes 1

@sysl("avintest.callbacks.share")
shareUnmarked(f: (int) -> int)

@sysl("avintest.callbacks.apply")
wrongParameter(f: (string) -> int, x: int) -> int

@sysl("avintest.callbacks.apply")
wrongResult(f: (int) -> string, x: int) -> int

@sysl("avintest.callbacks.apply")
wrongArity(f: (int, int) -> int, x: int) -> int

main()
  shareUnmarked(x -> x)
  println(wrongParameter(s -> 1, 2))
  println(wrongResult(x -> "", 2))
  println(wrongArity((a, b) -> a, 2))
