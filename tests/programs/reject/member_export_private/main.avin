// error: `ledger` is private to `Shop`
// error: `secretTotal` is exported privately by `Shop`, so only its own code uses it
// error: audit
// From another module, a wildcard export presents no private member of the wrapped class, the field
// it reads stays private, and a private export is its type's own.
import store.{Ledger, Shop}

main()
  val shop = Shop(Ledger(1))
  println(shop.ledger)
  println(shop.secretTotal)
  println(shop.audit())
