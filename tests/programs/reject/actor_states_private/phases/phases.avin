module phases

import avin.actors.ActorRef

data PhaseMsg
    Next
    Ask(reply: ActorRef[string])

actor Phases receives PhaseMsg
    state Idle
        Next -> Busy(1)
    state Busy(n: int)
        Next -> Busy(n + 1)
    receive
        Ask(r) ->
            r.tell(s"${state()}")
            stay
