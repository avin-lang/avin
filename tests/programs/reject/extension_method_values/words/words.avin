module words

data Tx(id: int)

trait Plain
  plain() -> string

impl Plain for int
  plain() -> string = s"int $self"

impl string
  padded(n: int) -> string = s"$self:$n"
  padded(s: string) -> string = s"$self:'$s'"
  tagged(n: int, using tx: Tx) -> string = s"$self$n#${tx.id}"
  private quiet(n: int) -> string = s"($self$n)"

impl Plain
  loud(k: int) -> string = s"${plain()}!$k"
