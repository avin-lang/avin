module other

// This file imports neither `words` nor `frames`, so their extensions are no values here. `loud` is
// added to `Plain` in `Plain`'s own module, so it is no extension, and is a value wherever an `int` is.
padder() -> (string) -> string = "x".padded

framer() -> (int) -> string = 2.5.framed

louder() -> (int) -> string = 9.loud
