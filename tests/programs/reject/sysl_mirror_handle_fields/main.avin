// A Sysl mirror's field is a Sysl handle only by itself: not in an `Option`, a collection or a tuple.
// error: `Option[Tally]` cannot be a Sysl mirror's field: a Sysl handle is one only by itself
// error: `Vector[Mark]` cannot be a Sysl mirror's field: a Sysl handle is one only by itself
// error: `(Tally, long)` cannot be a Sysl mirror's field: a Sysl handle is one only by itself

@sysl("avintest.digits.Tally")
class Tally
    get() -> long

@sysl("avintest.digits.Mark")
class Mark
    place() -> long

@sysl("avintest.digits.Pin")
data Pin(tally: Option[Tally], mark: Vector[Mark])

@sysl("avintest.digits.Pin")
data Pair(tally: (Tally, long), mark: Mark)

@sysl("avintest.digits.pin_count")
pinCount(p: Pin) -> long

main() = ()
