// A binding is checked against a header, always: a package whose C libraries name none has no C
// binding.
// error: the C binding `sqrt` has no header to be checked against: name the one that declares `sqrt` in a `headers` list of the `c-libraries` of package `c-no-headers`

@c("double sqrt(double)")
sqrt(x: real) -> real

main()
  println(sqrt(2.0))
