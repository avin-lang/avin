// A string binding is held against the header as every binding is: a `const` the header does not
// write, a pointer to a pointer written as one pointer, and a string where the header takes an
// `int` are each rejected with both types; a typedef crossing as a string must be a pointer to
// `char`, and `const char *` where it is a parameter, since C may write through a `char *`.
// error: the C binding `copy` does not match `fixture_copy` in avin_fixture.h: the header declares 'char *(const char *)', but the binding says 'const char *(const char *)'
// error: the C binding `countArgs` does not match `fixture_count_args` in avin_fixture.h: the header declares 'int (const char **)', but the binding says 'int (const char *)'
// error: the C binding `byteAt` does not match `fixture_byte_at` in avin_fixture.h: the header declares 'int (const char *, int)', but the binding says 'int (const char *, const char *)'
// error: the C binding `nowhere` does not fit its headers: the C type `fixture_pointer` of the result is not `char *` or `const char *` in the headers, so it cannot cross as `string`
// error: the C binding `writableLength` does not fit its headers: the C type `fixture_text` of parameter 1 is not `const char *` in the headers, so it cannot cross as `string`

@c("const char *fixture_copy(const char *s)")
copy(s: string) -> string

@c("int fixture_count_args(const char *argv)")
countArgs(argv: string) -> int

@c("int fixture_byte_at(const char *s, const char *i)")
byteAt(s: string, i: string) -> int

@c("fixture_pointer fixture_nowhere(void)")
nowhere() -> string

@c("long fixture_writable_length(fixture_text s)")
writableLength(s: string) -> long

main()
  println(copy("x"))
