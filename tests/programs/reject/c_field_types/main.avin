// The kind a field must be for its Avin type, checked by the C unit: a handle field of another class's
// C type, an array read as a string, a floating-point field read as an integer and a wider integer
// read as a byte; and a field of a struct the headers declare without its members.
// error: the field `derived` of the C handle `Record` is not `fxf_base`, the C type of `Base` in the headers, so `Record.derivedAsBase` cannot read it as `Option[Base]`
// error: the field `text` of the C handle `Record` is not `char *` or `const char *` in the headers, so `Record.text` cannot read it as `string`
// error: the field `precise` of the C handle `Record` is not an integer type in the headers, so `Record.preciseAsInt` cannot read it as `int`
// error: the field `i32` of the C handle `Record` is not an integer type one byte wide in the headers, so `Record.i32AsByte` cannot read it as `byte`
// error: the field `held` of the C handle `Holder`, which `Holder.held` reads, does not compile against its headers: clang says 'incomplete definition of type 'fxf_holder'

@c(type: "fxf_base", release: "fxf_base_close", retain: "fxf_base_inc_ref")
class Base

@c(type: "fxf_record *", release: "fxf_record_unref", retain: "fxf_record_ref")
class Record
  @c(field: "derived")
  derivedAsBase() -> Option[Base]

  @c(field: "text")
  text() -> string

  @c(field: "precise")
  preciseAsInt() -> int

  @c(field: "i32")
  i32AsByte() -> byte

@c(type: "fxf_holder *", release: "fxf_holder_free")
class Holder
  @c(field: "held")
  held() -> Option[Base]

main() = 0
