// A collection of handles goes into Sysl as a slice, as every collection does: a Sysl function that
// takes a `Buf` of views is not reached through a vector of them.
// error: the Sysl binding `countBuf` does not match `avintest.views.count_buf`: a collection of handles goes into Sysl as a slice, which the Sysl parameter does not take

@sysl("avintest.views.View")
class View
  describe() -> string

@sysl("avintest.views.count_buf")
countBuf(children: Vector[View]) -> int

main() = ()
