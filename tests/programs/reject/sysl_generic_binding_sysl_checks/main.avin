// Sysl checks each instance of a generic binding: a type argument the Sysl function's own bound
// refuses, and a generic handle with fewer type parameters than its Sysl type, are reported at the
// binding, as Sysl says them.
// error: the Sysl handle `Half` does not match `avintest.views.Pair`: type 'Pair' takes 2 type arguments, but 1 type argument was given
// error: the Sysl binding `largest` does not match `avintest.digits.larger`: 'avintest.digits.larger' requires its type parameter 'T' to implement 'PartialOrd', but Spot does not

@sysl("avintest.digits.Spot")
data Spot(x: int, y: int)

@sysl("avintest.digits.larger")
largest[T: Boundary](a: T, b: T) -> T

@sysl("avintest.views.Pair")
class Half[A: Boundary]
    firstOf() -> A

@sysl("avintest.views.pair")
half[A: Boundary](a: A, b: A) -> Half[A]

main()
    println(largest(1, 2))
    println(largest(Spot(1, 2), Spot(3, 4)))
    println(half(1, 2).firstOf())
