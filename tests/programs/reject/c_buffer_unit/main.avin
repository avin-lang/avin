// What the C unit checks of memory crossing in place: a view's bytes and a block's are one byte wide,
// a view's `length:` compiles in its glue, and a class's `attach:` and `key:` compile against its
// headers.
// error: the C binding `sumInts` does not fit its headers: parameter 1 of `sumInts`, `const int *`, is not a pointer to an integer type one byte wide in the headers, so a `ByteBlock` cannot be passed to it
// error: the C binding `Frame.ints` does not fit its headers: the C binding `Frame.ints` lends the memory its result points at as a view, and its bytes are not of an integer type one byte wide in the headers
// error: the C binding `Frame.badLength` gives the length of the memory its result points at as `nope(self)`, which does not compile against its headers: clang says 'call to undeclared function 'nope'; ISO C99 and later do not support implicit function declarations [-Wimplicit-function-declaration]'
import avin.c.{ByteBlock, ByteView}

@c(type: "bf_frame *", release: "bf_frame_unref")
class Frame
    @c("int *bf_frame_ints(bf_frame *self)", view, length: "4")
    ints() -> ByteView

    @c("unsigned char *bf_frame_data(bf_frame *self)", view, length: "nope(self)")
    badLength() -> ByteView

@c("long bf_sum_ints(const int *values, length(values) int n)")
sumInts(values: ByteBlock) -> long

main() = 0
