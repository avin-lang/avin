// error: `Order` cannot derive `JsonEncoder`: field `lines` has type `List[Line]`, which does not implement `JsonEncoder`
// error: `Table` cannot derive `JsonEncoder`: field `cells` has type `Map[string, int]`, which does not implement `JsonEncoder`
// error: `Pick` cannot derive `JsonDecoder`: field `value` has type `int | string`, which does not implement `JsonDecoder`: `JsonDecoder` takes `Self` other than as the receiver, and a union conforms only to a trait whose methods take it as the receiver alone
// error: `Codes` cannot derive `JsonEncoder`: field `raw` has type `Vector[byte]`, which does not implement `JsonEncoder`
// error: `Animal` cannot derive `JsonDecoder`: its template builds values, and `Animal` is open, so a value of its type could be of any subclass
// A type derives the JSON traits only where every field's type has them: a data type that does not
// derive them, a `Map` field (a map's own type, a `HashMap` or a `TreeMap`, has them), a union,
// which has no static `decode`, and a byte vector. An open class has an encoder but cannot be decoded,
// since its value could be any subclass.
import json.JsonEncoder
import json.JsonDecoder

data Line(sku: string)

data Order(id: long, lines: List[Line]) derives JsonEncoder

data Table(cells: Map[string, int]) derives JsonEncoder

data Pick(value: int | string) derives JsonEncoder, JsonDecoder

data Codes(raw: Vector[byte]) derives JsonEncoder

open class Animal(name: string) derives JsonEncoder, JsonDecoder

main()
    println(Order(1, []), Table({"a": 1}), Pick(1), Codes([]))
