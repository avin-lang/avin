// A field accessor's glue is compiled by the C unit against its headers, and each diagnostic is placed
// at the accessor: a field the struct does not have, a field of a kind its Avin type cannot carry
// either way, a `const` field written, and a `bound:` that does not compile, each in clang's words or
// the kind the field must be.
// error: the field `nothing` of the C handle `Record`, which `Record.nothing` reads, does not compile against its headers: clang says 'no member named 'nothing' in 'struct fxf_record''
// error: the field `name` of the C handle `Record` is not an integer type in the headers, so `Record.nameAsInt` cannot read it as `int`
// error: the field `i32` of the C handle `Record` is not `char *` or `const char *` in the headers, so `Record.i32AsString` cannot read it as `string`
// error: the field `fixed` of the C handle `Record` cannot be written by `Record.setFixed`: clang says 'cannot assign to non-static data member 'fixed' with const-qualified type 'const int''
// error: the `bound:` `self->nothing` of the field accessor `Record.value` does not compile against the headers of the C handle `Record`: clang says 'no member named 'nothing' in 'struct fxf_record''

@c(type: "fxf_record *", release: "fxf_record_unref", retain: "fxf_record_ref")
class Record
  @c(field: "nothing")
  nothing() -> int

  @c(field: "name")
  nameAsInt() -> int

  @c(field: "i32")
  i32AsString() -> string

  @c(field: "fixed")
  setFixed(value: int)

  @c(field: "values[i]", bound: "self->nothing")
  value(i: int) -> int

  // Correct, and compiled beside them.
  @c(field: "i32")
  i32() -> int

main() = 0
