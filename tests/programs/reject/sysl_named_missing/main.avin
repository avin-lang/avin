// A `named` binding may leave out only the parameters that have a Sysl default, and names only
// parameters the Sysl function has.
// error: the Sysl binding `bothMissingLast` does not match `avintest.digits.both`: function 'avintest.digits.both' was given no value for 'm', and that parameter declares no default
// error: the Sysl binding `framedNoTitle` does not match `avintest.digits.framed`: function 'avintest.digits.framed' was given no value for 'title', and that parameter declares no default
// error: the Sysl binding `joinedWrongName` does not match `avintest.digits.joined`: function 'avintest.digits.joined' declares no parameter named 'd' — it takes 'a', 'b' and 'c'
// error: the Sysl binding `joinedSkipping` does not match `avintest.digits.joined`: parameter 2 is a real, which goes into Sysl only as a floating-point number, but the Sysl parameter is string

@sysl("avintest.digits.both", named)
bothMissingLast(n: long) -> long

@sysl("avintest.digits.framed", named)
framedNoTitle(width: int) -> string

@sysl("avintest.digits.joined", named)
joinedWrongName(a: string, d: string) -> string

// Without `named`, the arguments are passed by position, so a binding cannot skip a parameter.
@sysl("avintest.digits.joined")
joinedSkipping(a: string, c: real) -> string

main()
    println(bothMissingLast(1))
    println(framedNoTitle(1))
    println(joinedWrongName("a", "d"))
    println(joinedSkipping("a", 1.0))
