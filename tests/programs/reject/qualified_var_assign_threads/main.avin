import app.store
import app.store as s
import avin.threads.spawn
import avin.actors.isolate

main()
    spawn(() -> store.latest = 1).join()
    spawn(() -> s.latest += 1).join()
    val v = isolate
        store.latest = 2
        Buffer[int]()
    spawn(() -> store.Tally.count = 3).join()
    val w = isolate
        s.latest++
        Buffer[int]()
