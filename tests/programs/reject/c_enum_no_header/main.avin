// An enum mirror and a constant are measured against their package's headers, so a package declaring
// one names them.
// error: the C enum mirror `Format` has no header to be measured against: name the one that declares `ae_format_t` in a `headers` list of the `c-libraries` of package `c-enum-no-header`
// error: the C constant `answer` has no header to be measured against: name the one that defines `AE_INT_CONST` in a `headers` list of the `c-libraries` of package `c-enum-no-header`

@c(enum: "ae_format_t", prefix: "AE_FORMAT_")
data Format
    A8

@c(const: "AE_INT_CONST")
val answer: int

main() = answer
