// A binding's `length:` and `free:` compile in its glue against its headers, and an array of
// scalars C answers holds them as they are.
// error: the C binding `badLength` gives the length of the array `glyphs` as `nope + 1`, which does not compile against its headers: clang says 'use of undeclared identifier 'nope''
// error: the C binding `badFree` frees the array `glyphs` with `glyphs->nope`, which does not compile against its headers: clang says 'no member named 'nope' in 'as_glyph''
// error: the C binding `ints` does not fit its headers: the C type `double` the array `values` points at is not a signed integer type 4 bytes wide in the headers, so it cannot hold the elements of an `Array[int]` as they are
// error: the C binding `dashAfter` gives the length of the array `dashes` as `offset > 0 ? 1 : 0`, which does not compile against its headers: clang says 'use of undeclared identifier 'offset''
// error: the C binding `filledInts` does not fit its headers: the C type `double` the array `dashes` points at is not a signed integer type 8 bytes wide in the headers, so it cannot hold the elements of an `Array[long]` as they are

@c(struct: "as_glyph")
data Glyph(index: long, x: real, y: real)

@c("void as_glyphs_answer(int n, out as_glyph **glyphs, out long *count)", array: "glyphs", length: "nope + 1")
badLength(n: int) -> (Array[Glyph], long)

@c("void as_glyphs_answer(int n, out as_glyph **glyphs, out long *count)", array: "glyphs", length: "count", free: "glyphs->nope")
badFree(n: int) -> (Array[Glyph], long)

@c("void as_reals_make(int n, out double **values, out size_t *count)", array: "values", length: "count")
ints(n: int) -> (Array[int], long)

@c("void as_dash_get(out double *dashes, out double *offset)", array: "dashes", length: "offset > 0 ? 1 : 0")
dashAfter() -> (Array[real], real)

@c("void as_dash_get(out double *dashes, out double *offset)", array: "dashes", length: "as_dash_count()")
filledInts() -> (Array[long], real)

main() = 0
