// The C unit checks each constant is the kind its Avin type asks for, and that the headers define it.
// error: the C constant `AE_NOT_DEFINED` of `undefined` is not defined by any header of its package
// error: the C constant `AE_STRING_CONST` is not an integer in its headers, so `stringAsInt` cannot be `int`
// error: the C constant `AE_INT_CONST` is not a string literal in its headers, so `intAsString` cannot be `string`
// error: the C constant `ae_string_pointer` is not a string literal in its headers, so `pointerAsString` cannot be `string`
// error: the C constant `AE_STRING_CONST` is not a number in its headers, so `stringAsReal` cannot be `real`

@c(const: "AE_NOT_DEFINED")
val undefined: int

@c(const: "AE_STRING_CONST")
val stringAsInt: int

@c(const: "AE_INT_CONST")
val intAsString: string

@c(const: "ae_string_pointer")
val pointerAsString: string

@c(const: "AE_STRING_CONST")
val stringAsReal: real

main() = 0
