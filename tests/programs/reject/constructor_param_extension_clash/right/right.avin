module right

import traits.Mappable

// Adds to a type built from the parameters, which an `Option` of an `Option` matches as the left
// module's `F[A]` does.
impl[F[_]: Mappable, A] F[Option[A]]
  twice(f: (Option[A]) -> Option[A]) -> F[Option[A]] = map(f)

impl[F[_]: Mappable, A] F[A]
  label() -> string = "right"
  // The bound's own method, which every receiver has, so an extension's could never be called.
  map[B](f: (A) -> B) -> F[B] = map(f)
