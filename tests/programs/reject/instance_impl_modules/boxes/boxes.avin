module boxes

import shows.Show
import plain.Plain

data Box[T](value: T)

impl[T: Show] Show for Box[T]
  show() -> string = value.show()

// `Plain` is no `Show` today, but `shows` could make it one without importing this module.
impl Show for Box[Plain]
  show() -> string = "plain box"

// Only this module can make `Local` a `Show`, and it does not: the two stay apart.
data Local(n: int)

impl Show for Box[Local]
  show() -> string = "local box"
