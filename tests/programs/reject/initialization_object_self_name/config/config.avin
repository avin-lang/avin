module config

import probe

// The body calls, while the object is made, a function of another module that reads the object:
// that call runs before `Config` exists, so it is a real cycle, however the body names the object.
object Config
  val port: int = 80
  println(probe.peek())

// Before its last field the object's name is `self`, here passed on.
object Early
  probe.keep(Early)
  val last: int = 1
