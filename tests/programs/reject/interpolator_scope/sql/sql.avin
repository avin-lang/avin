module sql

// A query whose values travel beside its text, never pasted into it.
data Query(text: string, values: Vector[int])

// `sql"…"`: each hole must be an `int`, and becomes a parameter of the query.
trait SqlInterpolation
    sql(args: int*) -> Query

impl SqlInterpolation for StringContext
    sql(args: int*) -> Query = Query(parts.mkString("?"), args)
