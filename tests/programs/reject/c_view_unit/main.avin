// What the C unit checks of memory lent by a field and to a callback: a field's view points at bytes one
// byte wide, a `writable` one at memory that is not `const`, and its `length:` compiles in its glue; a
// callback's view points at bytes one byte wide.
// error: the field `ints` of the C handle `Face` is not a pointer to an integer type one byte wide in the headers, so `Face.ints` cannot lend the memory it points at as `ByteView`
// error: the field `name` of the C handle `Face` points at `const` memory in the headers, so `Face.name` cannot lend it `writable`
// error: the field accessor `Face.badLength` gives the length of the memory `name` points at as `nope(self)`, which does not compile against the headers of the C handle `Face`: clang says 'call to undeclared function 'nope'; ISO C99 and later do not support implicit function declarations [-Wimplicit-function-declaration]'
// error: the field `loads` of the C handle `Face` is not a pointer to an integer type one byte wide in the headers, so `Face.notPointer` cannot lend the memory it points at as `ByteView`
// error: the C binding `intStream` does not fit its headers: the function `intStream` passes for `seen` is lent the memory `data` points at as a view, and `data` is not a pointer to an integer type one byte wide in the headers
import avin.c.{ByteView, MutByteView}

@c(type: "bf_face *", release: "bf_face_unref")
class Face
    @c(field: "ints", view, length: "4")
    ints() -> ByteView

    @c(field: "name", view, writable, length: "self->name_length")
    name() -> MutByteView

    @c(field: "name", view, length: "nope(self)")
    badLength() -> ByteView

    @c(field: "loads", view, length: "4")
    notPointer() -> ByteView

@c("void bf_stream_ints(int n, void (*seen)(userdata void *closure, const int *data, length(data) int length), userdata void *closure)")
intStream(n: int, seen: (ByteView) -> unit)

main() = 0
