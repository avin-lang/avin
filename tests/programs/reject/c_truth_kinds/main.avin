// A typedef crossing as `bool` is a C `bool` or an integer used as a truth value, which the C unit
// checks: a struct, a pointer and a floating-point typedef are neither.
// error: the C binding `pointTruth` does not fit its headers: the C type `fixture_point` of parameter 1 is not a bool or an integer type in the headers, so it cannot cross as `bool`
// error: the C binding `pointerTruth` does not fit its headers: the C type `fixture_pointer` of the result is not a bool or an integer type in the headers, so it cannot cross as `bool`
// error: the C binding `realTruth` does not fit its headers: the C type `fixture_real` of the result is not a bool or an integer type in the headers, so it cannot cross as `bool`

@c("int fixture_point_x(fixture_point)")
pointTruth(p: bool) -> int

@c("fixture_pointer fixture_nowhere(void)")
pointerTruth() -> bool

@c("fixture_real fixture_echo_real(fixture_real)")
realTruth(x: real) -> bool

@c("fixture_truth fixture_truth_of(int)")
fine(x: int) -> bool

main()
  println(fine(1))
