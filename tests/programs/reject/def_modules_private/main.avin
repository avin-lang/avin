// A function declared with `def` and no parameter list in another module keeps its privacy, has no
// function value through the module, and takes no parentheses there when it yields a plain value.
// error: `hidden` is private to module `clock`
// error: `now` takes no parameter list, so it has no function value
// error: `now` takes no parameter list, so it is called without parentheses
import clock

main()
  println(clock.hidden)
  val f: () -> int = clock.now
  println(clock.now())
