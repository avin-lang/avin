// error: `Note` does not conform to `Ord`, the bound of `A` in `Sorted`
// error: `T` does not conform to `Ord`, the bound of `A` in `Sorted`
// error: `<` on `T` needs a bound that is `Ord` or requires it, as in `[T: Ord]`
// error: `T` does not implement `Display`, so it cannot be interpolated
// A variant of another module bounding its own parameter checks its bound where a value is made, in
// this module as in its own, and an arm on it gives the enclosing code exactly that bound: not
// another trait, and not outside the arm.
import colls.{Coll, Plain, Sorted}

class Note(val text: string)

wrapped[T](items: Vector[T]) -> Coll[T] = Sorted(items)

after[T](c: Coll[T], a: T, b: T) -> bool =
  val sorted = c match
    Plain(_) -> false
    Sorted(_) -> true
  sorted && a < b

shown[T](c: Coll[T], x: T) -> string = c match
  Plain(_) -> ""
  Sorted(_) -> s"$x"

main()
  val n = Sorted([Note("x")])
