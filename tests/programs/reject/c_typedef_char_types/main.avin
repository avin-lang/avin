// One pointer to a typedef crosses as a string only where the headers make the typedef `char`: a
// parameter C may write through, `fxf_string *`, is refused as `char *` is, and a typedef of
// `unsigned char` or `signed char` holds bytes rather than text, whether passed or answered.
// error: the C binding `mutableLength` does not fit its headers: the C type `fxf_string *` of parameter 1 is not `const char *` in the headers, so it cannot cross as `string`
// error: the C binding `signedLength` does not fit its headers: the C type `const fxf_sbyte *` of parameter 1 points at `unsigned char` or `signed char` in the headers, which hold bytes rather than text, so it cannot cross as `string`: a string is a pointer to `char`, and bytes cross as `Array[byte]`
// error: the C binding `Record.rawText` does not fit its headers: the C type `const fxf_ubyte *` of the result points at `unsigned char` or `signed char` in the headers, which hold bytes rather than text, so it cannot cross as `string`: a string is a pointer to `char`, and bytes cross as `Array[byte]`

@c("long fxf_mutable_length(fxf_string *s)")
mutableLength(s: string) -> long

@c(type: "fxf_record *", release: "fxf_record_unref", retain: "fxf_record_ref")
class Record
    @c("const fxf_ubyte *fxf_raw(const fxf_record *self)")
    rawText() -> string

@c("long fxf_sbyte_length(const fxf_sbyte *s)")
signedLength(s: string) -> long

main() = 0
