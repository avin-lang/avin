// A handle passed to Sysl is its own Sysl type, which the Sysl parameter must take: a tally does not
// reach a parameter that takes a mark, by value or through a pointer, and a mark does not reach one
// that takes a tally, whether or not the binding waits. Each is reported at its binding, in the
// handle's and the parameter's types, never in the shim's own words.
// error: the Sysl binding `distanceOfTallies` does not match `avintest.digits.distance`: the handle goes in as a `Tally`, and Sysl takes a `Mark` there
// error: the Sysl binding `nudgeTally` does not match `avintest.digits.nudge`: the handle goes in as a `*Tally`, and Sysl takes a `*Mark` there
// error: the Sysl binding `bumpMark` does not match `avintest.digits.bump`: the handle goes in as a `&Mark`, and Sysl takes a `&Tally` there
// error: the Sysl binding `bumpMarkWaiting` does not match `avintest.digits.bump`: the handle goes in as a `&Mark`, and Sysl takes a `&Tally` there

@sysl("avintest.digits.Tally")
class Tally
    get() -> long

@sysl("avintest.digits.Mark")
class Mark
    place() -> long

@sysl("avintest.digits.distance")
distanceOfTallies(a: Tally, b: Tally) -> long

@sysl("avintest.digits.nudge")
nudgeTally(t: Tally)

@sysl("avintest.digits.bump")
bumpMark(m: Mark)

@sysl("avintest.digits.bump", blocking)
bumpMarkWaiting(m: Mark)

main() = ()
