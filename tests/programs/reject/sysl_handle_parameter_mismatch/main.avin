// A handle passed to Sysl is its own Sysl type, which the Sysl parameter must take: a tally does not
// reach a parameter that takes a mark, by value or through a pointer, and a mark does not reach one
// that takes a tally.
// error: the Sysl binding `distanceOfTallies` does not match `avintest.digits.distance`
// error: the Sysl binding `nudgeTally` does not match `avintest.digits.nudge`
// error: the Sysl binding `bumpMark` does not match `avintest.digits.bump`
// error: the Sysl handle `Mark` is passed to a Sysl parameter that does not take `avintest.digits.Mark`

@sysl("avintest.digits.Tally")
class Tally
    get() -> long

@sysl("avintest.digits.Mark")
class Mark
    place() -> long

@sysl("avintest.digits.distance")
distanceOfTallies(a: Tally, b: Tally) -> long

@sysl("avintest.digits.nudge")
nudgeTally(t: Tally)

@sysl("avintest.digits.bump")
bumpMark(m: Mark)

main() = ()
