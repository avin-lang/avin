// The C unit measures every enumerator a mirror holds and checks the type it mirrors: an enumerator
// the headers do not declare is refused at its variant (a name that starts with a digit after the
// prefix is no variant's words, so it is named with `@c`), as is one that is no integer constant, and
// a type the headers do not declare or that is no integer type at the mirror.
// error: the C enum mirror `Undeclared` mirrors `ae_nope_t`, which its headers do not declare as a type: clang says 'unknown type name 'ae_nope_t'
// error: the C enum mirror `NotInteger` mirrors `ae_real_t`, which is not an enumeration or an integer type in its headers
// error: the variant `V1_4` of the C enum mirror `PdfVersion` mirrors `AE_PDF_VERSION_V1_4`, which no header of its package declares; a variant whose enumerator is not the prefix and its words names it with `@c("<enumerator>")` before the variant
// error: the variant `Rgb48` of the C enum mirror `Format` mirrors `AE_FORMAT_RGB48`, which no header of its package declares
// error: the variant `Text` of the C enum mirror `Pointer` mirrors `ae_string_pointer`, which is not an integer constant in its headers

@c(enum: "ae_pdf_version_t", prefix: "AE_PDF_VERSION_")
data PdfVersion
    V1_4

@c(enum: "ae_format_t", prefix: "AE_FORMAT_")
data Format
    @c("AE_FORMAT_RGB48")
    Rgb48

@c(enum: "ae_nope_t", prefix: "AE_NOPE_")
data Undeclared
    One

@c(enum: "ae_real_t", prefix: "AE_FORMAT_")
data NotInteger
    A8

@c(enum: "ae_format_t", prefix: "AE_FORMAT_")
data Pointer
    @c("ae_string_pointer")
    Text

main() = 0
