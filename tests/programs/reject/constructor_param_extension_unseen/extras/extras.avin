module extras

import traits.Mappable

impl[F[_]: Mappable, A] F[A]
  twice(f: (A) -> A) -> F[A] = map(f).map(f)
  private once(f: (A) -> A) -> F[A] = map(f)

impl[F[_]: Mappable, G[_]: Mappable, A] F[G[A]]
  mapIn[B](f: (A) -> B) -> F[G[B]] = map(g -> g.map(f))

impl string
  shout() -> string = self + "!"

marker() -> int = 0
