// A prototype writing `void *` or the struct where the header of `proc_pid_rusage` writes
// `rusage_info_t *` is refused by the header check, which holds every pointer to the header's type:
// the binding writes `out rusage_info_t *buffer`, as the header does, and C fills an array or a struct
// mirror through it. A mirror of `struct rusage_info_v2` cannot leave out its first field, the
// 16-byte `ri_uuid`, which no mirror's field holds; its bytes are answered as an array instead.
// error: the field `ri_user_time` is not the first field of `struct rusage_info_v2` in its headers: a struct mirror lists its struct's fields in the header's order
// error: the C binding `untyped` does not match `proc_pid_rusage` in <libproc.h>: the header declares 'int (int, int, rusage_info_t *)', but the binding says 'int (int, int, void *, int)'
// error: the C binding `mirrored` does not match `proc_pid_rusage` in <libproc.h>: the header declares 'int (int, int, rusage_info_t *)', but the binding says 'int (int, int, struct rusage_info_v2 *)'

@c("int proc_pid_rusage(int pid, int flavor, void *buffer, length(buffer) int n)")
untyped(pid: int, flavor: int, buffer: Array[long]) -> int

@c(struct: "struct rusage_info_v2")
data Times(@c("ri_user_time") userTime: long, @c("ri_system_time") systemTime: long)

@c("int proc_pid_rusage(int pid, int flavor, out struct rusage_info_v2 *buffer)")
mirrored(pid: int, flavor: int) -> Result[Times, int]

main()
  println(0)
