// More element types the C unit refuses: pointers, a `long` array to a typedef of a byte, a byte
// array to an `int`, and a length whose typedef is no integer, which the header check refuses too.
// error: the C binding `sumPointers` does not fit its headers: the C type `const uint8_t *` parameter 1 points at is not an integer type one byte wide in the headers, so it cannot hold the elements of an `Array[byte]` as they are
// error: the C binding `sumOctets` does not fit its headers: the C type `const aa_octet` parameter 1 points at is not a signed integer type 8 bytes wide in the headers, so it cannot hold the elements of an `Array[long]` as they are
// error: the C binding `sumInts` does not fit its headers: the C type `const int32_t` parameter 1 points at is not an integer type one byte wide in the headers, so it cannot hold the elements of an `Array[byte]` as they are
// error: the C binding `realLength` does not match `aa_sum_aa_reals` in avin_arrays.h: the header declares 'double (const aa_real *, size_t)', but the binding says 'double (const aa_real *, aa_real)'
// error: the C binding `realLength` does not fit its headers: the C type `aa_real` of parameter 2 is not an integer type in the headers, so it cannot cross as `int`

@c("long long aa_sum_pointers(const uint8_t **p, length(p) size_t n)")
sumPointers(p: Array[byte]) -> long

@c("long long aa_sum_octets(const aa_octet *p, length(p) aa_size n)")
sumOctets(p: Array[long]) -> long

@c("long long aa_sum_ints(const int32_t *p, length(p) int n)")
sumInts(p: Array[byte]) -> long

@c("double aa_sum_aa_reals(const aa_real *p, length(p) aa_real n)")
realLength(p: Array[real]) -> real

main()
  println(sumInts(Array.empty()))
