// An integer a parameter holds is passed as the type it is declared, and is not widened into the
// Sysl parameter's type: an `Option[int]` does not reach an `Option[i64]` parameter.
// error: the Sysl binding `countOrZero` does not match `avintest.digits.count_or_zero`: 'n' of 'digits.avintest.digits.count_or_zero' is Option[i64], but Option[int] was given

@sysl("avintest.digits.count_or_zero")
countOrZero(n: Option[int]) -> int

main()
    println(countOrZero(Some(12)))
