// A pointer to a typedef points at memory of no type only where the headers make the typedef
// `void *`: one to a typedef of an integer or a floating-point type points at its elements, checked
// by kind and size, and a struct mirror is filled through one only where the typedef is its struct.
// error: the C type `aa_fixed` the `out` parameter `p` points at is neither the struct `Counts` mirrors nor `void *` in the headers, so C cannot fill a `Counts` through it
// error: the C type `const aa_real` parameter 1 points at is not a signed integer type 8 bytes wide in the headers, nor `void *`, which would make it memory of no type, so it cannot hold the elements of an `Array[long]` as they are
// error: the C type `aa_fixed` the array `p` points at is not a floating-point type eight bytes wide in the headers, nor `void *`, which would make it memory of no type, so it cannot hold the elements of an `Array[real]` as they are
// error: parameter 1 of `sumBlock`, `const aa_fixed *`, is not a pointer to an integer type one byte wide in the headers, nor `void *`, which would make it memory of no type, so a `ByteBlock` cannot be passed to it

import avin.c.ByteBlock

@c(struct: "struct aa_counts")
data Counts(a: long, b: long, c: long)

@c("int aa_fixed_out(out aa_fixed *p, int k)")
fixedCounts(k: int) -> Result[Counts, int]

@c("double aa_sum_aa_reals(const aa_real *p, length(p) size_t n)")
sumReals(p: Array[long]) -> real

@c("int aa_fixed_out(out aa_fixed *p, int k)", array: "p", length: "1")
fixedReals(k: int) -> Result[Array[real], int]

@c("long long aa_sum_fixed(const aa_fixed *p, length(p) long long n)")
sumBlock(p: ByteBlock) -> long

main()
  println(0)
