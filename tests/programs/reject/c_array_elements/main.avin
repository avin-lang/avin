// What an array's pointer points at holds the elements as they are, which the C unit checks: an
// `int` or a `long` is signed, so an unsigned element is refused; a `real` is eight bytes, so a
// `float` is; an element of another size is; and a `bool` is no integer.
// error: the C binding `sumUints` does not fit its headers: the C type `const unsigned int` parameter 1 points at is not a signed integer type 4 bytes wide in the headers, so it cannot hold the elements of an `Array[int]` as they are
// error: the C binding `sumUlongs` does not fit its headers: the C type `const uint64_t` parameter 1 points at is not a signed integer type 8 bytes wide in the headers, so it cannot hold the elements of an `Array[long]` as they are
// error: the C binding `sumFloats` does not fit its headers: the C type `const float` parameter 1 points at is not a floating-point type eight bytes wide in the headers, so it cannot hold the elements of an `Array[real]` as they are
// error: the C binding `sumShorts` does not fit its headers: the C type `const short` parameter 1 points at is not a signed integer type 4 bytes wide in the headers, so it cannot hold the elements of an `Array[int]` as they are
// error: the C binding `sumBools` does not fit its headers: the C type `const bool` parameter 1 points at is not an integer type one byte wide in the headers, so it cannot hold the elements of an `Array[byte]` as they are

@c("long long aa_sum_uints(const unsigned int *p, length(p) size_t n)")
sumUints(p: Array[int]) -> long

@c("long long aa_sum_ulongs(const uint64_t *p, length(p) size_t n)")
sumUlongs(p: Array[long]) -> long

@c("double aa_sum_floats(const float *p, length(p) size_t n)")
sumFloats(p: Array[real]) -> real

@c("long long aa_sum_shorts(const short *p, length(p) size_t n)")
sumShorts(p: Array[int]) -> long

@c("int aa_sum_bools(const bool *p, length(p) size_t n)")
sumBools(p: Array[byte]) -> int

main()
    println(sumUints(Array.empty()))
