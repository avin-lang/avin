// A function pointer's prototype is checked against the header as the rest of the binding's is, the
// markers removed, and a callback's typedef is checked as its kind; a `forget:` is compiled against
// the headers with the rest of the handle's glue, and each diagnostic is placed at its binding or
// class.
// error: the `forget:` of the C handle `Forgetful` does not compile against its headers: clang says 'call to undeclared function 'cb_registry_no_such_forget'; ISO C99 and later do not support implicit function declarations [-Wimplicit-function-declaration]'
// error: the C binding `wrongCallback` does not match `cb_repeat` in avin_callbacks.h: the header declares 'long long (int, int (void *, int), void *)', but the binding says 'long long (int, long (void *, int), void *)'

@c("long long cb_repeat(int n, long (*f)(userdata void *ud, int i), userdata void *ud)")
wrongCallback(n: int, f: int -> long) -> long

@c(type: "cb_registry *", release: "cb_registry_unref", forget: "cb_registry_no_such_forget")
class Forgetful
  @c(
      "int cb_registry_listen(cb_registry *self, void (*listener)(userdata void *ud, int value), userdata void *ud)",
      keeps: "listener"
