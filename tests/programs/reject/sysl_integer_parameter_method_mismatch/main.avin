// A handle method's integer parameter goes into an integer only, as a top-level binding's does, and
// is named by its place among the method's own parameters, the handle not counted.
// error: the Sysl binding `Tally.absorb` does not match `avintest.digits.Tally`: parameter 1 is an integer, which goes into Sysl only as an integer, but the Sysl parameter is digits.avintest.digits.Tally

@sysl("avintest.digits.Tally")
class Tally
    add(n: int)
    absorb(other: long)

@sysl("avintest.digits.new_tally")
newTally(n: long) -> Tally

main()
    val t = newTally(1)
    t.add(2)
    t.absorb(3)
