// A real a parameter holds is passed as the type it is declared, and is not rounded into the Sysl
// parameter's floating-point type as the binding's own real parameter is: an `Option[real]` does not
// reach an `Option[f32]` parameter, and the diagnostic says why. A real a result holds comes out of
// any Sysl floating-point type, and of nothing else, and the diagnostic names what it is made from.
// error: the Sysl binding `orZero` does not match `avintest.digits.f32_or_zero`: 'x' of 'avintest.digits.f32_or_zero' is Option[f32], but Option[real] was given: a real inside an `Option`, a `Result`, a tuple or a collection is passed as the type it is declared, and only a binding's own real parameter is rounded into the Sysl parameter's floating-point type
// error: the Sysl binding `rows` does not match `avintest.digits.digit_rows`: `Vector[real]` is made from a Sysl `[]F` or `Buf[F]` of any floating-point type `F`, and the value is none of these
// error: the Sysl binding `widePair` does not match `avintest.digits.wide_pair`: a real is made from a Sysl floating-point number, but the value is usize
// error: the Sysl binding `maybeCount` does not match `avintest.digits.maybe_count`: a real is made from a Sysl floating-point number, but the value is usize

@sysl("avintest.digits.f32_or_zero")
orZero(x: Option[real]) -> real

@sysl("avintest.digits.digit_rows")
rows(a: long, b: long) -> Vector[real]

@sysl("avintest.digits.wide_pair")
widePair(n: long) -> (real, long)

@sysl("avintest.digits.maybe_count")
maybeCount(n: long) -> Option[real]

main()
  println(orZero(Some(1.0)))
  println(rows(1, 2))
  println(widePair(1))
  println(maybeCount(1))
