// A typedef crosses as the Avin type of the kind the header gives it, which the C unit checks: a
// struct, a pointer or a floating-point typedef is no integer, an integer no `real`, a `bool` no
// integer, and an integer two bytes wide no `byte`.
// error: the C binding `pointX` does not fit its headers: the C type `fixture_point` of parameter 1 is not an integer type in the headers, so it cannot cross as `int`
// error: the C binding `countUp` does not fit its headers: the C type `fixture_pointer` of parameter 1 is not an integer type in the headers, so it cannot cross as `long`
// error: the C binding `echoReal` does not fit its headers: the C type `fixture_real` of the result is not an integer type in the headers, so it cannot cross as `long`
// error: the C binding `minCount` does not fit its headers: the C type `fixture_count` of the result is not a floating-point type in the headers, so it cannot cross as `real`
// error: the C binding `wide` does not fit its headers: the C type `fixture_wide_octet` of the result is not an integer type one byte wide in the headers, so it cannot cross as `byte`

@c("int fixture_point_x(fixture_point)")
pointX(p: int) -> int

@c("int fixture_count_up(fixture_pointer)")
countUp(p: long) -> int

@c("fixture_real fixture_echo_real(fixture_real)")
echoReal(x: real) -> long

@c("fixture_count fixture_min_count(void)")
minCount() -> real

@c("fixture_wide_octet fixture_wide(fixture_wide_octet)")
wide(x: int) -> byte

main()
    println(minCount())
