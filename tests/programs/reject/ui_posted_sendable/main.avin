// A message and an answer cross between threads, so both are sendable; work posted runs on the main
// thread while the poster goes on, so it is a sendable function and captures none of the interface's
// state, which an inbox's handler, made on the main thread, may.
import ui.{inbox, post, state}

main()
    val count = state(0)
    val fine = inbox((n: int) -> count.set(n))
    val arrays = inbox((a: Array[int]) -> a.length)
    val answers = inbox((n: int) -> Array.fill(n, 0))
    post(() -> count.set(1))
