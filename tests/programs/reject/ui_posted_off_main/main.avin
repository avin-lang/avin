// error: what is passed for `body` of `spawn` may run on another thread, which shares the program's module-level state, but through `inbox` it reaches `inboxes`, a module-level `var`, which every thread would share; share it through an `Atomic` or a `Mutex` held in a `val`
// error: what is passed for `body` of `spawn` may run on another thread, which shares the program's module-level state, but through `handlePosted` → `handleOne` it reaches `handlers`, a module-level value holding a `Map[int, () -> unit]`, which is mutable; an immutable copy (`toMap`) is sendable
// error: what is passed for `body` of `spawn` may run on another thread, which shares the program's module-level state, but through `run` → `handlePosted` → `handleOne` it reaches `handlers`, a module-level value holding a `Map[int, () -> unit]`, which is mutable; an immutable copy (`toMap`) is sendable
// error: what is passed for `body` of `Future.apply` may run on another thread, which shares the program's module-level state, but through `handlePosted` → `handleOne` it reaches `handlers`, a module-level value holding a `Map[int, () -> unit]`, which is mutable; an immutable copy (`toMap`) is sendable
// What only the main thread may do is refused where code for another thread would do it: making an
// inbox, handling the work waiting, and running a window reach the main thread's own state, so a
// thread's body or a future's body that does any of them does not compile. Sending to an inbox and
// posting work are what other threads do, and are accepted.
import avin.threads.{Future, spawn}
import ui.{app, handlePosted, inbox, post, run, text}

main()
  val box = inbox((n: int) -> n)
  _ = spawn(() -> box.send(1)).join()
  spawn(() -> post(() -> println("fine"))).join()
  spawn(() -> inbox((s: string) -> s)).join()
  spawn(() -> handlePosted()).join()
  _ = spawn(() -> run(app("Elsewhere", () -> text("hi"), () -> 0))).join()
  Future(handlePosted()).await()
