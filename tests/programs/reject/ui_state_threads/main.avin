// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it uses `count`, a `State[int]`, whose field `held` is a `var`; make it a `val`
// error: `State[int]` does not conform to `Sendable`, the bound of `T` in `send`: its field `held` is a `var`; make it a `val`
// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it uses `total`, a `Derived[int]`, whose field `f` holds a `() -> int`, which is a function value, whose type does not say what it captures
// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it uses `kept`, a `State[string]`, whose field `held` is a `var`; make it a `val`
// error: what is passed for `body` of `spawn` may use only sendable values from around it, but it uses `c`, a `Scope`, whose field `node` holds a `Node`, whose field `builds` holds a `Builds`, whose field `current` is a `var`; make it a `val`
// The interface's state belongs to the thread that runs it: a state, a derived value and a
// component's scope are mutable, so none is sendable, and a thread is never handed one, whether a
// program's own or one a component keeps.
import avin.threads.{spawn}
import ui.{View, component, derived, root, state, text}

send[T: Sendable](value: T) -> string = "sent"

main()
  val count = state(0)
  spawn(() -> count.set(1)).join()
  println(send(count))
  val total = derived(() -> count.get() + 1)
  spawn(() -> total.get()).join()
  val build = root(() -> component c ->
    val kept = c.state("")
    spawn(() -> kept.set("x")).join()
    spawn(() -> c.remember(1)).join()
    text(kept.get()))
  println(build)
