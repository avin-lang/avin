// A real goes into and comes out of a Sysl floating-point type, `f32`, `f16`, `bf16` or `real`, and
// no other: not an integer or a string, in either direction, as a parameter, a result or a callback's
// answer. Sysl widens a real into its quadruple-precision `f128` itself, but a real is not made from
// one.
// error: the Sysl binding `quadSame` does not match `avintest.digits.f128_same`: a real is made from a Sysl floating-point number, but the value is f128
// error: the Sysl binding `countReal` does not match `avintest.digits.digit_count`: parameter 1 is a real, which goes into Sysl only as a floating-point number, but the Sysl parameter is long
// error: the Sysl binding `realText` does not match `avintest.digits.without_digits`: a real is made from a Sysl floating-point number, but the value is string
// error: the Sysl binding `applyReal` does not match `avintest.callbacks.apply`: the function answers a real, which goes into Sysl only as a floating-point number, but the closure Sysl takes answers int
// error: the Sysl binding `countFromReal` does not match `avintest.digits.digit_count`: a real is made from a Sysl floating-point number, but the value is int

@sysl("avintest.digits.f128_same")
quadSame(x: real) -> real

@sysl("avintest.digits.digit_count")
countReal(n: real) -> int

@sysl("avintest.digits.without_digits")
realText(text: string) -> real

@sysl("avintest.callbacks.apply")
applyReal(f: int -> real, x: int) -> int

@sysl("avintest.digits.digit_count")
countFromReal(n: long) -> real

main()
    println(quadSame(1.0))
    println(countReal(1.0))
    println(realText("a"))
    println(applyReal(x -> 1.0, 1))
    println(countFromReal(1))
