// error: `IntLit(2)` is an `Expr[int]`, and an `Expr[bool]` is expected here
// error: `exprs.Expr[bool].IntLit(3)` is an `Expr[int]`, and an `Expr[bool]` is expected here
// error: the result of a variant is an instance of its own type: `Local` of `Mine` declares `Plain[int]`
// error: the result of a variant is an instance of its own type: `Other` of `Mine` declares `Expr[int]`
// A refined variant of another module makes the instance its result declares, as in its own, and is
// refused where another is expected; a variant's result is an instance of the type it belongs to,
// never a type of the same name or shape from another module.

import exprs
import exprs.{IntLit, Wrap, Plain}

data Mine[T]
  Local(value: int) -> Plain[int]
  Other(value: int) -> exprs.Expr[int]

main()
  println(Wrap(1))
  val wrong: exprs.Expr[bool] = IntLit(2)
  val also = exprs.Expr[bool].IntLit(3)
