// error: this `match` does not cover every Json value, such as `Obj(_)`
// error: expected long, found Option[long]
// error: `TextReader` is private to module `json`
// A match over `Json` must cover every variant, the accessors answer Options rather than values, and
// the reader's class is the package's own.
import json
import json.Json

kind(j: Json) -> string = j match
    Json.Null -> "null"
    Json.Bool(_) -> "bool"
    Json.Long(_) | Json.Real(_) -> "number"
    Json.Str(_) -> "string"
    Json.Arr(_) -> "array"

main()
    val n: long = json.parse("1").ok.get.asLong
    val r = json.TextReader("1", 1)
    println(kind(Json.Null), n, r)
