// expect: exit 0
// A trait's field is computed in the trait's own module, where its private functions are seen,
// however far away the class storing it is declared. A trait's field supplies another trait's `val`
// of its name, as a field the class declares would.
import parts.Numbered
import parts.Labelled
import parts.DefaultLabel

private start() -> int = 0

class Ticket: Numbered, Labelled, DefaultLabel

describe(l: Labelled) -> string = l.label

main()
    val t = Ticket()
    println(t.next())
    val n: Numbered = t
    n.number = start()
    println(n.next())
    println(describe(t))
