module doors

data DoorEvent
    Open
    Close

machine Door receives DoorEvent
    state Shut
        Open -> Ajar(1)
        Close -> stay

    state Ajar(times: int)
        Open -> Ajar(times + 1)
        Close -> Shut

// Inside its own module the state type is named as `Door.State`.
opened(d: Door) -> int = d.state() match
    Ajar(n) -> n
    Shut -> 0

private machine Hidden receives DoorEvent
    state Only
        _ -> stay

hiddenState() -> string = Hidden().state().toString()
