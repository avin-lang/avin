// expect: exit 0
// A machine declared in another module: imported, `Door` makes one and `Door.State` names its state
// type; through the module, `doors.Door.State` does. Its states are that module's variants, and a
// private machine is used only inside its module.
import doors
import doors.{Door, DoorEvent, Open, Close, Ajar, Shut, opened, hiddenState}

describe(s: Door.State) -> string = s match
    Shut -> "shut"
    Ajar(n) -> s"ajar $n"

viaModule(d: doors.Door) -> doors.Door.State = d.state()

main()
    val d = Door()
    println(describe(d.state()))
    d.handle(Open)
    d.handle(Open)
    println(describe(d.state()))
    println(opened(d))
    println(viaModule(d))
    d.handle(Close)
    println(viaModule(d) is Shut)
    println(hiddenState())
