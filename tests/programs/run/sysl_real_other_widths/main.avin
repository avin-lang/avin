// expect: exit 0
// A real goes into every Sysl floating-point type, the half-precision `f16` and `bf16` as well as
// `f32`, rounded to the nearest value each holds, and a Sysl `real` takes it unchanged. A Sysl
// parameter or closure answer whose type is a type parameter of a generic function says no type to
// round into, and takes the real itself, and a Sysl function overloaded at `real` and at a narrower
// type is called at `real`.

@sysl("avintest.digits.f16_same")
f16Same(x: real) -> real

@sysl("avintest.digits.f16_bits")
f16Bits(x: real) -> long

@sysl("avintest.digits.bf16_same")
bf16Same(x: real) -> real

@sysl("avintest.digits.shift")
shift(x: real, places: int) -> real

@sysl("avintest.digits.same")
same(x: real) -> real

@sysl("avintest.digits.larger")
larger(a: real, b: real) -> real

@sysl("avintest.digits.applied")
applied(x: real, f: real -> real) -> real

@sysl("avintest.digits.applied")
appliedGeneric[T: Boundary, U: Boundary](x: T, f: T -> U) -> U

@sysl("avintest.digits.width_of")
widthOf(x: real) -> string

@sysl("sysl.math.ulp")
unitInLastPlace(x: real) -> real

@sysl("avintest.digits.either")
either(ok: bool, x: real, e: string) -> Result[real, string]

main()
  // `f16`: eleven bits of precision, and nothing past 65504.
  println(s"${f16Same(0.1)} ${f16Bits(0.1)} ${f16Same(65504.0)} ${f16Same(65520.0)} ${f16Same(-65520.0)}")
  println(s"${f16Bits(-0.0)} ${f16Same(1.0e-8)} ${f16Same(real.NaN).isNaN} ${f16Same(real.NegativeInfinity)}")
  // `bf16`: eight bits of precision, the range of an `f32`.
  println(s"${bf16Same(0.1)} ${bf16Same(1.0e38)} ${bf16Same(-0.0)}")
  // A Sysl `real` takes the value unchanged.
  println(s"${shift(0.1, 1)} ${shift(real.MaxValue, 0) == real.MaxValue} ${shift(4.9e-324, 0) == 4.9e-324}")
  // Generic Sysl functions take the real itself, a value no `f32` holds included.
  println(s"${same(0.1)} ${same(-0.0)} ${same(real.MaxValue) == real.MaxValue} ${same(4.9e-324) == 4.9e-324}")
  println(s"${larger(0.1, 0.2)} ${larger(real.NegativeInfinity, -real.MaxValue) == -real.MaxValue}")
  println(applied(0.1, x -> x * 3.0))
  println(appliedGeneric(0.1, x -> x + 1.0))
  println(appliedGeneric(2.5, x -> s"$x"))
  println(s"${either(true, 0.1, "no")} ${either(false, 0.1, "no")}")
  // A Sysl function overloaded at `real` and at `f32` is called at `real`, the value unrounded.
  println(widthOf(0.1))
  println(s"${unitInLastPlace(1.0)} ${unitInLastPlace(1.0) == 2.220446049250313e-16}")
