// expect: exit 0
// Extractors from another module: imported by name, reached through the module, and a value of a
// generic class the module declares.
import parsing
import parsing.{Number, Blank}

classify(s: string) -> string
  val hex = parsing.Prefixed[int]("#", t -> t.toIntOption())
  s match
    Number(n) -> s"number $n"
    Blank() -> "blank"
    parsing.Fields(key, value) -> s"$key is $value"
    parsing.Fields(first, rest*) -> s"$first and ${rest.length} more"
    hex(n) -> s"tagged $n"
    _ -> "text"

main()
  println(classify("42"))
  println(classify("   "))
  println(classify("a:b"))
  println(classify("a:b:c"))
  println(classify("#7"))
  println(classify("word"))
