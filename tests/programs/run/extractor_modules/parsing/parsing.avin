module parsing

// Extractors declared in a module of their own and matched from another.
object Number: Extractor[string, int]
  override unapply(s: string) -> Option[int] = s.toIntOption()

object Blank: BoolExtractor[string]
  override unapply(s: string) -> bool = s.trim == ""

object Fields: SeqExtractor[string, List[string]]
  override unapplySeq(s: string) -> Option[List[string]] = if s.contains(":") then Some(s.split(":").toList) else None

class Prefixed[T](prefix: string, parse: (string) -> Option[T]): Extractor[string, T]
  override unapply(s: string) -> Option[T]
    if !s.startsWith(prefix) then return None
    parse(s.slice(prefix.byteLength, s.byteLength))
