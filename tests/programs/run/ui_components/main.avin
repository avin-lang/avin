// expect: exit 0
// Components: functions building a view, each keeping what its scope remembers from one build of
// its root to the next. A component without a key is found again by its place among the components
// its parent builds without one; a keyed one by its key, wherever it is built; and one a build
// leaves out loses what it kept.
import ui.{Rect, Scope, State, View, button, column, component, derived, keyed, recorder, root, row, snapshot, state, tabs, intSignal, tap, text}

val Screen = Rect(0, 0, 400, 600)

// The texts on screen, in order, joined by a space.
texts(v: View) -> string
    val lines = snapshot(v, recorder(), Screen).dump().split("\n")
    lines.filter(l -> l.contains(" text \"")).map(l -> l.split("\"")(1)).mkString(" ")

said(r: Result[unit, ui.Missed]) -> string = r match
    Ok(_) -> "tapped"
    Err(m) -> m.message

counter(label: string) -> View = component c ->
    val n = c.state(0)
    row([text(s"$label=${n.get()}"), button("+", () -> n.update(x -> x + 1)).named(s"add-$label")])

keyedCounter(label: string) -> View = keyed(label) c ->
    val n = c.state(0)
    row([text(s"$label=${n.get()}"), button("+", () -> n.update(x -> x + 1)).named(s"add-$label")])

deep() -> View = component c ->
    val m = c.state(100)
    column([text(s"deep=${m.get()}"), button("d", () -> m.update(x -> x + 1)).named("d")])

main()
    // State kept across builds, one for each component, and the snapshot shows the new value only
    // after the next build.
    val two = root(() -> column([counter("a"), counter("b")]))
    var v = two()
    println(texts(v))
    tap(v, "add-a", Screen)
    tap(v, "add-a", Screen)
    tap(v, "add-b", Screen)
    println(texts(v))
    v = two()
    println(texts(v))
    v = two()
    println(texts(v))

    // The state's initial value is evaluated on the component's first build only.
    var made = 0
    val once = root(() -> component c ->
        val s = c.state
            made += 1
            "first"
        text(s.get()))
    once()
    once()
    println(texts(once()))
    println(made)

    // Several values in one component, each its own, and `remember` keeping any value.
    var buildsSeen = 0
    val several = root(() -> component c ->
        val a = c.state(1)
        val b = c.state("x")
        val kept = c.remember(Buffer[int]())
        kept.append(buildsSeen)
        buildsSeen += 1
        a.update(x -> x * 2)
        b.update(x -> x + "y")
        text(s"${a.get()} ${b.get()} ${kept.length}"))
    several()
    several()
    println(texts(several()))

    // Separate roots keep separate trees; the same component function built under each is two
    // components.
    val left = root(() -> counter("l"))
    val right = root(() -> counter("l"))
    tap(left(), "add-l", Screen)
    println(s"${texts(left())} ${texts(right())}")

    // Nested components: each keeps its own state inside its parent's.
    val nested = root(() -> component outer ->
        val n = outer.state(10)
        column([text(s"outer=${n.get()}"), button("o", () -> n.update(x -> x + 1)).named("o"), counter("inner"), deep()]))
    v = nested()
    tap(v, "o", Screen)
    tap(v, "add-inner", Screen)
    tap(v, "add-inner", Screen)
    tap(v, "d", Screen)
    println(texts(nested()))
    tap(nested(), "d", Screen)
    println(texts(nested()))

    // Keyed components keep their state when the list is reordered; unkeyed ones keep it by place,
    // so their state stays where it was while their labels move.
    val order = state(["x", "y", "z"])
    val keyedList = root(() -> column(order.get().map(k -> keyedCounter(k))))
    val placedList = root(() -> column(order.get().map(k -> counter(k))))
    v = keyedList()
    tap(v, "add-x", Screen)
    tap(v, "add-z", Screen)
    tap(v, "add-z", Screen)
    var p = placedList()
    tap(p, "add-x", Screen)
    tap(p, "add-z", Screen)
    tap(p, "add-z", Screen)
    order.set(["z", "x", "y"])
    println(texts(keyedList()))
    println(texts(placedList()))
    order.set(["y", "z", "x"])
    println(texts(keyedList()))
    // Keys by int, and keys that look alike: "1" written as an int and as a string is one key, and a
    // key never meets a component placed without one.
    val mixed = root(() -> column([keyed(1, c -> text(s"${c.state(5).get()}")), component(c -> text(s"${c.state(6).get()}"))]))
    println(texts(mixed()))
    // Empty and Unicode keys are keys like any other.
    val odd = root(() -> column([keyedCounter(""), keyedCounter("ключ ✓")]))
    tap(odd(), "add-ключ ✓", Screen)
    println(texts(odd()))

    // A component left out of a build loses its state: built again, it starts from the beginning.
    val showing = state(true)
    val toggled = root(() -> column([if showing.get() then keyedCounter("t") else text("hidden"), counter("stays")]))
    v = toggled()
    tap(v, "add-t", Screen)
    tap(v, "add-stays", Screen)
    println(texts(toggled()))
    showing.set(false)
    println(texts(toggled()))
    showing.set(true)
    println(texts(toggled()))
    // A component left out drops what it built inside it too.
    val inside = state(true)
    val parent = root(() -> if inside.get() then component(c -> column([text("p"), counter("child")])) else text("none"))
    tap(parent(), "add-child", Screen)
    println(texts(parent()))
    inside.set(false)
    parent()
    inside.set(true)
    println(texts(parent()))
    // An unkeyed component that disappears shifts the places after it: the next one takes its state.
    val first = state(true)
    val shifting = root(() -> column((if first.get() then [counter("one")] else []) ++ [counter("two")]))
    tap(shifting(), "add-one", Screen)
    first.set(false)
    println(texts(shifting()))

    // Components in a tab's body, which the tabs build during the root's build. Each tab's body is
    // built in one place, so an unkeyed component there is one component whichever tab shows it,
    // and a keyed one is one for each key.
    val tab = state(0)
    val tabbed = root(() -> tabs(["a", "b"], tab, i -> counter(s"tab$i")))
    tap(tabbed(), "add-tab0", Screen)
    println(texts(tabbed()))
    tab.set(1)
    println(texts(tabbed()))
    tab.set(0)
    println(texts(tabbed()))
    val keyedTabs = root(() -> tabs(["a", "b"], tab, i -> keyedCounter(s"tab$i")))
    tap(keyedTabs(), "add-tab0", Screen)
    tab.set(1)
    println(texts(keyedTabs()))
    tab.set(0)
    println(texts(keyedTabs()))

    // A component's derived value is kept across builds and computed again after a write.
    var computed = 0
    val source = state(3)
    val withDerived = root(() -> component c ->
        val sq = c.derived(() ->
            computed += 1
            source.get() * source.get())
        text(s"sq=$sq"))
    println(texts(withDerived()))
    println(texts(withDerived()))
    println(computed)
    source.set(4)
    println(texts(withDerived()))
    println(computed)

    // A tap's callback that sets state, then the build after it.
    val lastTapped = state("")
    val buttons = root(() -> column([button("left", () -> lastTapped.set("left")).named("left"), text(s"last=${lastTapped.get()}")]))
    println(said(tap(buttons(), "left", Screen)))
    println(texts(buttons()))
