// expect: exit 0
// A file that imports another module's `Display` still prints its data types through the core
// library's: what a type has without asking names the core trait itself, and the imported trait is
// usable beside it. The other module's own `Display` leaves its types printable too.
import shapes.Display
import shapes.Square

data Point(x: int, y: int)

impl Display for Point
  label() -> string = s"a point at $x, $y"

class Origin derives Eq, Hash

show(d: Display) -> string = d.label()

main()
  val p = Point(1, 2)
  println(p)
  println(s"$p ${debug(p)}")
  println(show(p))
  println(Square(3))
  println(show(Square(3)))
  println(Origin() == Origin())
