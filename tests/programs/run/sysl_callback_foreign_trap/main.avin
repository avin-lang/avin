// expect: trap
// A callback the binding does not mark `@threaded` belongs to the code that gave it: called by a
// thread Sysl started itself, which the program never knew, it stops the program, and nothing of
// the callback runs.

@sysl("avintest.callbacks.keep")
keep(f: (int) -> int)

@sysl("avintest.callbacks.call_kept")
callKept(i: int, x: int) -> int

@sysl("avintest.callbacks.call_kept_on_thread", blocking)
callKeptOnThread(x: int) -> int

main()
  keep(x ->
    println("ran")
    x)
  println(callKept(0, 5))
  println(callKeptOnThread(6))
  println("not reached")
