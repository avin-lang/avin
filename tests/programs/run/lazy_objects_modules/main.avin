// expect: exit 0
// Two objects in two modules whose lazy fields read each other need nothing of each other to be
// made, since a lazy field's initializer runs only when the field is read; a module-level lazy
// value of one module holding a handler that reads its own module's object, called from the other.
import near.Near
import peer.{Remote, callBack}

main()
  println(Near.x)
  println(Remote.y)
  println(Remote.z)
  println(callBack())
