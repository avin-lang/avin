// expect: exit 0
// Two impls of one type, each in a file of its own and each bounding the type's parameter by a
// different trait at the same place in its file, keep their own bounds: `Shout` needs its item to be
// `Display`, `Whisper` its item to be `Debug`, and each body uses what its own bound gives it. The
// type's automatic `Display` and `Debug` are two more impls declared at one place, the type itself.

data Cell[T](item: T)

trait Shout
    shout() -> string

trait Whisper
    whisper() -> string

main()
    print(Cell(1).shout())
    print(Cell("two").whisper())
    print(s"${Cell('c')} ${debug(Cell("s"))}")
