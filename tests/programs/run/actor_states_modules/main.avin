// expect: exit 0
// An actor's states are names of its own module, so actors of different modules may each have a
// state called `Idle`, and so may the program's own data, and each actor reads its own.
import phases.{Phases, Next, Ask}
import lights.{Light, Toggle, Show}
import avin.actors.spawn
import avin.time

data Mode
  Idle
  Running

main()
  val p = spawn(Phases())
  val l = spawn(Light())
  val wait = time.seconds(60)
  println(p.ask(r -> Ask(r), timeout = wait).await())
  p.tell(Next)
  p.tell(Next)
  println(p.ask(r -> Ask(r), timeout = wait).await())
  p.tell(Next)
  println(p.ask(r -> Ask(r), timeout = wait).await())
  l.tell(Toggle)
  println(l.ask(r -> Show(r), timeout = wait).await())
  l.tell(Toggle)
  println(l.ask(r -> Show(r), timeout = wait).await())
  val m: Mode = Idle
  println(m)
