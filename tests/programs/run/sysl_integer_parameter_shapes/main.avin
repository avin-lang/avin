// expect: exit 0
// An integer parameter is converted into the Sysl parameter's integer wherever a binding takes one:
// a handle's method, a call that waits. A Sysl parameter whose type is a type parameter of a generic
// function says no integer to convert into, and takes the Avin type itself.

@sysl("avintest.digits.Tally")
class Tally
    get() -> long
    addUnsigned(n: long)
    addSmall(n: int) -> long

@sysl("avintest.digits.new_tally")
newTally(n: long) -> Tally

@sysl("avintest.digits.show_u32_after", blocking)
showU32After(ms: int, x: long) -> string

@sysl("avintest.digits.same")
same(x: int) -> int

@sysl("avintest.digits.same")
sameLong(x: long) -> long

@sysl("avintest.digits.same")
sameSmall(x: i8) -> i8

@sysl("avintest.digits.doubled")
doubled(x: int) -> int

@sysl("avintest.digits.doubled")
doubledLong(x: long) -> long

main()
    val t = newTally(0)
    t.addUnsigned(4294967295)
    t.addUnsigned(0)
    println(t.get())
    println(t.addSmall(255))
    println(t.addSmall(0))
    t.close()
    println(showU32After(0, 0))
    println(showU32After(1, 4294967295))
    println(showU32After(65535 - 65535, 7))
    // Many waiting calls, each converting its arguments, while objects are made between them.
    var made: Vector[string] = []
    for i in 0..<200
        made = made :+ showU32After(0, long(i) * 21474836)
    println(made(199))
    println(same(-2147483648))
    println(same(2147483647))
    println(sameLong(-9223372036854775807 - 1))
    println(sameSmall(-128))
    println(doubled(-21))
    println(doubledLong(4611686018427387903))
