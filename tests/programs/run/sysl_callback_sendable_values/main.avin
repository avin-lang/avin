// expect: exit 0
// A value of a `@sendable` function type, and a parameter marked `@sendable`, were checked to be what
// any thread may run where they were made or passed, so a `@threaded` parameter takes them as they
// are: a `val` of the type, a data field of it, a function's `@sendable` result, a marked parameter
// passed on through a chain of marked parameters, and one captured by a lambda or a local function.
// Each is called by Avin threads and by a thread of Sysl's own, many times, allocating as it runs.
import avin.threads.spawn

@sysl("avintest.callbacks.share")
share(@threaded f: (int) -> int)

@sysl("avintest.callbacks.call_shared")
callShared(x: int) -> int

@sysl("avintest.callbacks.forget_shared")
forgetShared()

@sysl("avintest.callbacks.apply_on_thread")
applyOnThread(@threaded f: (int) -> int, x: int) -> int

@sysl("avin.rt.callbacks_held")
held() -> long

data Task(name: string, run: @sendable (int) -> int)

// A function whose result is a `@sendable` function, made where it is returned.
adder(n: int) -> @sendable (int) -> int = x -> x + n

shareMarked(@sendable f: (int) -> int) = share(f)

// A marked parameter passed on through marked parameters to the binding.
passOn(@sendable f: (int) -> int) = passOnAgain(f)

passOnAgain(@sendable f: (int) -> int) = shareMarked(f)

// A marked parameter of a `@sendable` function type.
shareTyped(@sendable f: @sendable (int) -> int) = share(f)

// A marked parameter captured by the lambda shared, and by a local function that shares it.
shareAround(@sendable f: (int) -> int) = share(x -> f(x) * 2)

shareInside(@sendable f: (int) -> int)
  inner() = share(f)
  inner()

// A marked parameter given to a binding on a thread of Sysl's own.
onSyslThread(@sendable f: (int) -> int, x: int) -> int = applyOnThread(f, x)

// Allocates on every call, so the collector runs while other threads call it.
spell(x: int) -> int
  var text = ""
  for i in 0 ..< x
    text = text + s"$i,"
  text.byteLength

fromThreads() -> int
  val threads = [0, 1, 2, 3].map(t -> spawn(() ->
    var total = 0
    for i in 0 ..< 100
      total += callShared(i % 10)
    total))
  var sum = 0
  for t in threads do sum += t.join()
  sum

main()
  val words = Vector("one", "two", "three")
  val g: @sendable (int) -> int = x -> spell(x) + words.length
  share(g)
  println(callShared(10))
  println(fromThreads())
  forgetShared()
  val task = Task("double", x -> x * 2)
  share(task.run)
  println(spawn(() -> callShared(21)).join())
  forgetShared()
  share(adder(1000))
  println(callShared(1))
  forgetShared()
  shareMarked(x -> x + 1)
  println(callShared(0))
  forgetShared()
  passOn(x -> spell(x))
  println(fromThreads())
  forgetShared()
  passOn(g)
  println(callShared(3))
  forgetShared()
  shareTyped(adder(-1))
  println(callShared(int.MinValue + 1))
  forgetShared()
  shareAround(adder(5))
  println(callShared(0))
  forgetShared()
  shareInside(task.run)
  println(callShared(-4))
  forgetShared()
  println(onSyslThread(x -> spell(x), 30))
  println(onSyslThread(g, 0))
  println(held())
