// Views a field accessor and a callback are lent, under collections at every allocation: a field's
// view keeps its face alive while the program holds nothing else of it and is read between
// allocations; a callback's views are read, written and copied while it allocates, two at once, and a
// copy outlives the call.
import avin.c.{ByteView, MutByteView}

@c(type: "bf_face *", release: "bf_face_unref", retain: "bf_face_ref")
class Face
    @c(field: "glyph->bitmap.buffer", view,
       length: "(self->glyph->bitmap.pitch < 0 ? -self->glyph->bitmap.pitch : self->glyph->bitmap.pitch) * self->glyph->bitmap.rows")
    bitmap() -> Option[ByteView]

    @c(field: "glyph->bitmap.buffer", view, writable, length: "self->glyph->bitmap.pitch * self->glyph->bitmap.rows")
    pixels() -> MutByteView

    @c("void bf_face_load(bf_face *self, int rows, int width, int pitch, int fill)")
    load(rows: int, width: int, pitch: int, fill: int)

    @c("long bf_face_sum(bf_face *self)")
    sum() -> long

@c("bf_face *bf_face_new(void)")
newFace() -> Face

@c("int bf_stream_write(int total, int chunk, int (*write)(userdata void *closure, const unsigned char *data, length(data) unsigned int length), userdata void *closure)")
writeStream(total: int, chunk: int, write: (ByteView) -> int) -> int

@c("long bf_stream_read(int total, int chunk, int (*read)(userdata void *closure, unsigned char *data, length(data) unsigned int length), userdata void *closure)")
readStream(total: int, chunk: int, read: (MutByteView) -> int) -> long

@c("long bf_stream_pair(int a, int b, long (*seen)(userdata void *closure, const unsigned char *first, length(first) unsigned int n, unsigned char *second, length(second) unsigned int m), userdata void *closure)")
pairStream(a: int, b: int, seen: (ByteView, MutByteView) -> long) -> long

// The bitmap of a face nothing else holds.
orphanBitmap() -> ByteView
    val f = newFace()
    f.load(4, 4, -4, 0)
    f.bitmap().get()

main()
    val v = orphanBitmap()
    var total = 0
    for i in 0..<v.length()
        val boxed = [i]
        total += int(v(i)) + boxed(0) - i
    println(total)
    val f = newFace()
    f.load(2, 8, 8, 0)
    val px = f.pixels()
    for i in 0..<16
        val boxed = [byte(3)]
        px.update(i, boxed(0))
    println(f.sum())
    val copies = Buffer[Array[byte]]()
    var seen = 0
    writeStream(300, 100, chunk ->
        for i in 0..<chunk.length()
            val boxed = [int(chunk(i))]
            seen += boxed(0)
        copies.append(chunk.copy())
        0)
    println(seen)
    println(int(copies(2)(99)))
    println(readStream(64, 16, chunk ->
        for i in 0..<chunk.length()
            val boxed = [byte(1)]
            chunk(i) = boxed(0)
        0))
    println(pairStream(3, 2, (a, b) ->
        val boxed = [a(0), a(1), a(2)]
        b(0) = boxed(2)
        long(int(boxed(0)) + int(boxed(1)))))
