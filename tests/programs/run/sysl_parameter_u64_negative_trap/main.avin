// expect: trap
// A negative `long` for a `u64`, whose every bit pattern is a value, stops the program where the
// binding was called: the sign is checked, not only the bits.

@sysl("avintest.digits.show_u64")
showU64(x: long) -> string

main()
  println(showU64(9223372036854775807))
  println(showU64(-9223372036854775807 - 1))
