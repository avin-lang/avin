// expect: exit 0
// A `lazy val` reads module-level values of another module, one of them lazy itself, and is read
// from another module: each is computed once, on its first read, wherever that read is.
import config.{limit, loads}

lazy val doubled: int = limit * 2

main() -> int
  println(loads)
  println(doubled)
  println(limit)
  println(loads)
  0
