// expect: exit 0
// A value narrower than 32 bits crosses the boundary widened as the C convention widens it, which
// Sysl relies on: a signed one sign-extended, a byte and a bool zero-extended. Every value of each
// type is computed while the program runs and passed to a Sysl function taking that type, and to one
// taking a wider type, and a callback answers each into Sysl, which widens it.

@sysl("avintest.digits.show_i8")
showI8(x: i8) -> string

@sysl("avintest.digits.show_i16")
showI16(x: i16) -> string

@sysl("avintest.digits.show_i64")
showI8AsI64(x: i8) -> string

@sysl("avintest.digits.show_i64")
showI16AsI64(x: i16) -> string

@sysl("avintest.digits.show_u8")
showByte(x: byte) -> string

@sysl("avintest.digits.show_u32")
showByteAsU32(x: byte) -> string

@sysl("avintest.callbacks.answer_i8")
answerI8(f: () -> i8) -> int

@sysl("avintest.callbacks.answer_i16")
answerI16(f: () -> i16) -> int

@sysl("avintest.callbacks.small")
small(f: (i8, i16) -> i16, a: i8, b: i16) -> i16

main()
  var wrong = 0
  var seen = 0
  for i in -128 ..< 128
    val x = i8(i)
    if showI8(x) != s"$x" then wrong += 1
    if showI8AsI64(x) != s"$x" then wrong += 1
    if answerI8(() -> x) != i then wrong += 1
    seen += 1
  var j = -32768
  while j < 32768
    val x = i16(j)
    if showI16(x) != s"$x" then wrong += 1
    if showI16AsI64(x) != s"$x" then wrong += 1
    if answerI16(() -> x) != j then wrong += 1
    seen += 1
    j += 97
  for k in 0 ..< 256
    val b = byte(k)
    if showByte(b) != s"$k" then wrong += 1
    if showByteAsU32(b) != s"$k" then wrong += 1
    seen += 1
  // Arguments and an answer computed from the callback's own narrow parameters.
  println(small((a, b) -> b - i16(a), i8(seen % 100 - 128), i16(-seen)))
  println(seen)
  println(wrong)
