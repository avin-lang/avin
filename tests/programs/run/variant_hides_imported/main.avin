// expect: exit 0
// An imported variant hides the core library's of its name; a bare name where the core library's
// type is expected is still that type's variant, and where nothing decides it the import is meant.
// An imported generic type's variants are decided by its instances.
import codes
import codes.Status
import codes.None
import codes.Just
import codes.Maybe

lookup(n: int) -> Option[int] = if n > 0 then Some(n) else None

wrap[T](x: T) -> Maybe[T] = Just(x)

data Pair(a: Option[int], b: Status)

main()
    // `None` here is `codes.Status`'s, hiding `Option`'s.
    val s = None
    println(codes.label(s))
    val st: Status = None
    println(codes.label(st))
    val o: Option[int] = None
    println(o)
    println(lookup(0))
    println(lookup(1) == None)
    println(None == st)
    lookup(0) match
        None -> println("no value")
        Some(v) -> println(v)
    val p = Pair(None, None)
    println(s"${p.a} ${codes.label(p.b)}")
    val nested: Option[Option[int]] = Some(None)
    println(nested)
    val m: Maybe[string] = Just("yes")
    println(m)
    println(wrap(3))
    val ms: Vector[Maybe[int]] = [Just(1), Maybe.Nothing]
    println(ms)
    m match
        Just(v) -> println(s"just $v")
        Maybe.Nothing -> println("nothing")
