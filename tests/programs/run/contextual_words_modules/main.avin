// expect: exit 0
// A module may be named by a word that begins a declaration, and so may what it declares: `import
// data` imports the module `data`, whose `object`, `module`, `class` and variants are reached through
// it, `data.object`, and imported by name, `import data.{class, Kind}`.
import data
import data.{class, Kind, Config}
import data.{object as answer}

main()
  println(data.object)
  println(answer)
  println(data.class(1))
  println(class(2))
  println(data.module)
  data.module = "second"
  println(data.module)
  val kinds: Vector[Kind] = [Kind.trait, Kind.impl(3)]
  for k in kinds
    k match
      Kind.trait -> println("trait")
      Kind.impl(n) -> println(n)
  val c = Config(type = "json", import = 2)
  println(c.data)
  println(data.Config("x", 1).data)
