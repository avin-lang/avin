// expect: exit 0
// The view tree through `ui`: leaves, containers and modifiers built in Avin, laid out and drawn on
// syslui's recording canvas, with no window, and read back as what was drawn and as a snapshot.
import ui.{Body, Caption, Display, Rect, Title, View, column, divider, grid, intSignal, recorder, render, row, scroll, snapshot, spacer, text}

val Screen = Rect(0, 0, 400, 300)

// What `v` draws in `at`, one operation a line.
drawn(v: View, at: Rect = Screen) -> string
    val c = recorder()
    render(v, c, at)
    c.dump()

// What `v` puts on screen in `at`.
shown(v: View, at: Rect = Screen) -> string = snapshot(v, recorder(), at).dump()

show(title: string, v: View)
    println(s"-- $title")
    print(drawn(v))
    print(shown(v))

main()
    // Leaves: text, the empty string and Unicode, a spacer and a divider.
    show("text", text("hello"))
    show("empty text", text(""))
    // Unicode is drawn and reported whole, in a snapshot's `dump()` as in its JSON.
    val unicode = text("héllo, 世界 ✓")
    println(drawn(unicode))
    println(shown(unicode))
    println(snapshot(unicode, recorder(), Screen).toJson())
    // Labels of 2-, 3- and 4-byte characters, alone and mixed: `dump()` quotes each whole and
    // `toJson()` carries the same text.
    for label in ["é", "日本", "😀", "a é 日本 😀 z", "😀😀"]
        val snap = snapshot(text(label), recorder(), Screen)
        println(s"$label dump=${snap.dump().contains(label)} json=${snap.toJson().contains(label)}")
        println(snap.dump())
    show("spacer", spacer())
    show("divider", divider())
    show("thick divider", divider(4))
    // Containers: none, one and several children, with and without spacing.
    show("empty column", column([]))
    show("one in a column", column([text("only")]))
    show("column", column([text("a"), text("b"), text("c")], 4))
    show("row", row([text("a"), text("bb"), text("ccc")], 10))
    show("empty row", row([]))
    show("spacers share a row", row([spacer(), text("mid"), spacer()]))
    show("one spacer pushes to the end", row([spacer(), text("end")]))
    show("nested", column([row([text("1"), text("2")], 2), row([text("3")]), column([])], 6))
    show("grid", grid([text("half").cell(12), text("half").cell(12), text("all")]))
    show("scroll", scroll(column([text("r0"), text("r1"), text("r2"), text("r3")]), intSignal(16), 32))
    // Every modifier, alone and chained.
    val t = text("m")
    show("padding", t.padding(8))
    show("pad", t.pad(bottom = 12, left = 3))
    show("pad none", t.pad())
    show("padded", t.padded())
    show("panel", t.panel())
    show("frame", t.frame(50, 20))
    show("font size", t.fontSize(32.0))
    show("display", t.textStyle(Display))
    show("title", t.textStyle(Title))
    show("body", t.textStyle(Body))
    show("caption", t.textStyle(Caption))
    show("flex in a column", column([text("top"), text("grow").flex(), text("bottom")]))
    show("flex shares", row([text("a").flex(1), text("b").flex(3)]))
    show("named", t.named("the.m"))
    show("chain", text("chain").padding(2).panel().padding(4).named("chained"))
    // What a view asks of its container's leftover.
    println(s"weights ${t.weight()} ${spacer().weight()} ${t.flex().weight()} ${t.flex(5).weight()} ${t.padding(1).weight()}")
    // A tree from a collection, and a deep one.
    val labels = (0..<5).map(i -> s"item $i")
    show("mapped", column(labels.map(s -> text(s)).toVector, 1))
    var deep = text("core")
    for i in 0..<40
        deep = deep.padding(1)
    show("deep", deep)
    var wide: Vector[View] = []
    for i in 0..<200
        wide = wide :+ text(s"$i")
    println(snapshot(column(wide), recorder(), Rect(0, 0, 400, 4000)).len())
    // One view is the child of two containers, and outlives the vector it was given in.
    val shared = text("shared")
    var kids = [shared, shared]
    val both = row(kids, 1)
    kids = []
    show("shared child", both)
    // Views kept in Avin's own collections and objects, while the collector runs.
    var many: List[View] = List()
    var drawnBytes = 0
    for i in 0..<3000
        val v = column([text(s"$i").padding(i % 7), row([spacer(), text("x")])], i % 3)
        if i % 100 == 0 then many = v :: many
        drawnBytes += drawn(v).byteLength
        Array.fill(32, i)
    println(many.length)
    println(drawnBytes > 0)
    println(drawn(column(many.toVector)).byteLength > 0)
