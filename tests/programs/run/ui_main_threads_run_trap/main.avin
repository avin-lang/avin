// expect: trap
// A window runs in the main thread's own code, whose frames run the threads pinned to it, so `run`
// called on a pinned thread stops the program before any window is made.
import avin.threads.spawnOnMain
import ui.{app, column, run, text}

main()
  println("starting")
  spawnOnMain(() ->
    _ = run(app("never", () -> column([text("never")]), () -> 0x000000))
  ).join()
  println("not reached")
