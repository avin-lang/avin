// expect: exit 0
// An extension's method is taken as a function value as a type's own is: with and without an
// expected function type, passed to a higher-order function, with its `using` section filled where it
// is taken, overloaded with the overload chosen by the expected type, generic, and of no parameters
// where a function type is expected. Methods an extension adds to a trait reach the built-in types
// implementing it: a core trait's (`Display`) and a trait of the extension's module.
import words
import words.Tx

twice(f: (string, string) -> string) -> string = f("<", ">") + f("(", ")")

main()
  given tx = Tx(3)
  val w = "x".wrapped
  println(w("[", "]"))
  println(twice("y".wrapped))
  val t = "z".tagged
  println(t(1))
  println([1, 2].map("q".tagged))
  val cur: () -> string = "c".current
  println(cur())
  val sh: () -> string = "s".shout
  println(sh())
  val pi: (int) -> string = "p".padded
  val ps: (string) -> string = "p".padded
  println(s"${pi(4)} ${ps("v")}")
  println(["a", "b"].map("m".padded))
  val f = "word".framed
  println(f(4))
  println([1, 2].map(2.5.framed))
  println([7, 8].map(true.framed))
  val fi = 7.framed
  println(fi(1))
  val l = 6.loud
  println(l(1))
  println([1, 2].map("e".loud))
  val n = 9.noted
  println(n(2))
  val cm = [3, 9, 4].clampedMax
  println(s"${cm(5)} ${cm(12)}")
  val empty: Vector[string] = []
  val em = empty.clampedMax
  println(em("none"))
  var held: Vector[(int) -> string] = []
  for s in ["", "é", "end"]
    held = held :+ s.loud
  println(held.map(g -> g(0)))
