module words

// Extensions taken as function values by the files importing this module: methods added to a
// built-in type, to a trait of the core library the built-in types implement, to a trait of the
// program the built-in types implement, and to a sequence, generic, overloaded,
// with a `using` section, and of no parameters.
data Tx(id: int)

trait Plain
  plain() -> string

impl Plain for int
  plain() -> string = s"int $self"

impl Plain for string
  plain() -> string = s"string $self"

impl string
  wrapped(left: string, right: string) -> string = s"$left$self$right"
  tagged(n: int, using tx: Tx) -> string = s"$self$n#${tx.id}"
  current(using tx: Tx) -> string = s"$self@${tx.id}"
  shout() -> string = s"$self!"
  padded(n: int) -> string = s"$self:$n"
  padded(s: string) -> string = s"$self:'$s'"

impl Display
  framed(width: int) -> string = s"[${toString()}/$width]"

impl Plain
  loud(k: int) -> string = s"${plain()}!$k"
  noted(k: int, using tx: Tx) -> string = s"${plain()}#$k/${tx.id}"

impl[T: Ord] Seq[T]
  clampedMax(floor: T) -> T = if isEmpty then floor elif max < floor then floor else max
