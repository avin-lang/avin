// expect: exit 0
// args: a b
// A program that reads and writes JSON through the package it depends on: a settings file written
// from a type of its own and read back, a member changed and written indented, a file that is not
// JSON reported with its place, a decode error with its path, and the module imported under a name
// of the program's choosing.
import avin.fs
import dev.avinlang.json
import dev.avinlang.json.{Json, JsonEncoder, JsonDecoder, JsonKey}
import dev.avinlang.json as js

data Server(host: string, port: int) derives JsonEncoder, JsonDecoder

data Settings(
    name: string,
    @JsonKey("max_jobs") maxJobs: int,
    servers: Vector[Server],
    note: Option[string]
) derives JsonEncoder, JsonDecoder

main(args: Vector[string])
  val dir = fs.createTempDir("json-script").ok.get
  val file = dir + "/settings.json"
  val settings = Settings("café ☕", 4, [Server("a.example", 80), Server("b.example", 8080)], None)
  _ = fs.writeText(file, json.encode(settings))
  println(fs.readText(file).ok.get)
  val back = json.decode[Settings](fs.readText(file).ok.get)
  println(back.ok.get == settings)
  println(back.ok.get.servers.map(s -> s.port))
  val doc = json.parse(fs.readText(file).ok.get).ok.get
  val changed = doc.with("max_jobs", Json.num(8)).with("note", Json.str("tab\there"))
  _ = fs.writeText(file, changed.pretty())
  println(fs.readText(file).ok.get)
  println(json.decode[Settings](fs.readText(file).ok.get).ok.get.maxJobs)
  _ = fs.writeText(file, "{\"name\": \"x\",\n \"max_jobs\": 03}")
  println(json.parse(fs.readText(file).ok.get).err.get)
  println(
    json.decode[Settings](
      "{\"name\": \"x\", \"max_jobs\": 1, \"servers\": [{\"host\": \"h\", \"port\": \"80\"}], \"note\": null}"
    ).err.get
  )
  println(json.decode[Settings]("{}").err.get)
  println(js.parse("[]").ok.get.size)
  println(js.encode(Vector[Server]()))
  println(args.size)
  _ = fs.removeDirAll(dir)
