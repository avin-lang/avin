// expect: trap
// An unsigned Sysl integer in an option, too large for the `long` the binding declares, traps where
// the result is converted, rather than arriving negative.

@sysl("avintest.digits.maybe_count")
maybeCount(n: long) -> Option[long]

@sysl("avintest.digits.maybe_largest")
maybeLargest() -> Option[long]

main()
  println(maybeCount(-1000))
  println(maybeLargest())
