// expect: trap
// A string holding U+0000 passed to a `const char *` stops the program at the call, before C is
// called, naming the parameter and the byte the NUL is at: C would read that NUL as the string's end.

@c("long fixture_length(const char *s)")
length(text: string) -> long

main()
  println(length("before"))
  val parts = ["one", "two"]
  println(length(parts(0) + "\0" + parts(1)))
  println("not reached")
