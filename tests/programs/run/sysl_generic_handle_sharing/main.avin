// expect: exit 0
// ignore: Sysl 0.9.0 binds the shim's generic helper to `T` where a `&T` is expected, so a `&T` parameter of a type without a destructor is given a reference to a copy; the next Sysl release settles it at the `&T`
// A handle on an instance of a generic Sysl struct without a destructor, passed to a Sysl `&T`
// parameter, shares its value with Sysl: what the Sysl function sets, the handle reads.

@sysl("avintest.views.View")
class View
    describe() -> string

@sysl("avintest.views.Signal[int]")
class IntSignal
    read() -> int

@sysl("avintest.views.signal")
intSignal(v: int) -> IntSignal

@sysl("avintest.views.bump")
bump(c: IntSignal)

@sysl("avintest.views.counter_label")
counterLabel(c: IntSignal) -> View

main()
    val c = intSignal(0)
    bump(c)
    bump(c)
    println(c.read())
    println(counterLabel(c).describe())
