module pg

// A client's codecs: `bytea` is a `Vector[byte]`, an array any other vector of a type with a codec.
trait ToPg
  toPg() -> string

trait FromPg
  static fromPg(text: string) -> Option[Self]

impl ToPg for int
  toPg() -> string = s"$self"

impl FromPg for int
  static fromPg(text: string) -> Option[int] = text.toIntOption()

impl ToPg for Vector[byte]
  toPg() -> string = s"bytea:${length}"

impl FromPg for Vector[byte]
  static fromPg(text: string) -> Option[Vector[byte]] = Some(text.bytes)

impl[T: ToPg] ToPg for Vector[T]
  toPg() -> string = "{" + map(x -> x.toPg()).mkString(",") + "}"

impl[T: FromPg] FromPg for Vector[T]
  static fromPg(text: string) -> Option[Vector[T]]
    var out: Vector[T] = []
    for part in text.split(',')
      T.fromPg(part) match
        Some(v) -> out = out :+ v
        None -> return None
    Some(out)

encode[T: ToPg](x: T) -> string = x.toPg()

decode[T: FromPg](text: string) -> Option[T] = T.fromPg(text)

params(xs: ToPg*) -> string = xs.map(x -> x.toPg()).mkString(" ")
