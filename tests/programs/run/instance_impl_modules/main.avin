// expect: exit 0
// Impls for instances declared in the trait's module (`pg`, for the core library's `Vector`) and in
// the type's (`geo`), reached from a third module through bounds, static members and trait values.
import pg
import pg.ToPg
import geo.Point
import geo.Local

main()
  val bytes: Vector[byte] = "pg".bytes
  println(pg.encode(bytes))
  println(pg.encode([1, 2]))
  println(pg.decode[Vector[byte]]("abc").map(v -> v.length))
  println(pg.decode[Vector[int]]("3,4"))
  println(pg.params(bytes, [5], 6, Point(1, 2), Point(Local(3), Local(4))))
  println(bytes.toPg())
  println(Point(Local(1), Local(2)).toPg())
  val t: ToPg = Point(Local(5), Local(6))
  println(t.toPg())
