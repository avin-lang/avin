module geo

import pg.ToPg

data Point[T](x: T, y: T)

// The type's own impl, and one for an instance whose argument only this module could make a `ToPg`:
// `pg` cannot import this module, which imports it.
impl[T: ToPg] ToPg for Point[T]
  toPg() -> string = s"(${x.toPg()},${y.toPg()})"

data Local(n: int)

impl ToPg for Point[Local]
  toPg() -> string = s"local(${x.n},${y.n})"
