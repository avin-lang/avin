// expect: trap
// A handle a thread's body captures is the thread's while the body runs: the code that started it
// has given it up, and its next use stops the program, though the thread has not used it yet.
import avin.threads.{Channel, spawn}

@sysl("avintest.digits.Tally")
class Tally
    add(n: long)
    get() -> long

@sysl("avintest.digits.new_tally")
newTally(n: long) -> Tally

main()
    val t = newTally(1)
    val go = Channel[unit]()
    spawn(() ->
        go.receive()
        t.add(1))
    println(t.get())
