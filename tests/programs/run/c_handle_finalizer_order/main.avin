// expect: exit 0
// A face keeps its library by a C reference of its own, given back after the face's own release, so
// whichever of the two handles the collector finalizes first, the library is freed after its face:
// in the order the collector sweeps, by address, the library's handle made first and then made
// last, both found dead in one collection. Without the reference, the library's release would free
// the face and the face's would free it again, which the fixture stops the process for.
import fixture.{faces, facesFreedAfterLibrary, facesFreedBeforeLibrary, libraries, newFace, newLibrary}

// The library's handle made before the face's, at the lower address.
first(i: int) -> int = newFace(newLibrary(), i).id()

// The library's handle made after the face's, lent by the face, at the higher address.
last(i: int) -> int
    val made = newLibrary()
    val face = newFace(made, i)
    made.close()
    face.library().faces() + face.id()

main()
    for i in 0..<200
        first(i)
        last(i)
    var n = 0
    while (faces().freed < faces().created || libraries().freed < libraries().created) && n < 1000000
        val v = [n, n + 1]
        n += v(1) - v(0)
    println(faces().created == faces().freed)
    println(libraries().created == libraries().freed)
    // Each order happened, every time.
    println(facesFreedAfterLibrary())
    println(facesFreedBeforeLibrary())
