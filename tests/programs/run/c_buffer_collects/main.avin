// Views and blocks under collections at every allocation: a view keeps its frame alive while the
// program holds nothing else of it, reads and writes its bytes between allocations, and a block's bytes
// stay where they are through a blocking call while the program allocates.
import avin.c.{ByteBlock, ByteView, MutByteView}

@c(type: "bf_frame *", release: "bf_frame_unref")
class Frame
  @c("const unsigned char *bf_frame_cdata(bf_frame *self)", view, length: "bf_frame_size(self)")
  bytes() -> ByteView

  @c("unsigned char *bf_frame_data(bf_frame *self)", view, writable, length: "bf_frame_size(self)")
  pixels() -> MutByteView

  @c("long bf_frame_sum(bf_frame *self)")
  sum() -> long

@c("bf_frame *bf_frame_new(int size, int fill)")
newFrame(size: int, fill: int) -> Frame

@c("long bf_sum(const unsigned char *bytes, length(bytes) int n)")
sumOf(bytes: ByteBlock) -> long

@c("void bf_fill_slowly(unsigned char *bytes, length(bytes) int n, unsigned char value, int ms)", blocking)
fillSlowly(bytes: ByteBlock, value: byte, ms: int)

// A view of a frame nothing else holds.
orphanView(size: int) -> ByteView = newFrame(size, 1).bytes()

main()
  val v = orphanView(100)
  var total = 0
  for i in 0 ..< v.length
    val boxed = [i]
    total += int(v(i)) + boxed(0) - i
  println(total)
  val f = newFrame(16, 0)
  val px = f.pixels()
  for i in 0 ..< 16
    val boxed = [byte(2)]
    px.update(i, boxed(0))
  println(px.copy().length)
  println(f.sum())
  val b = ByteBlock(256)
  val w: MutByteView = b
  w.fill(0, 256, byte(1))
  fillSlowly(b, byte(3), 5)
  println(sumOf(b))
  println(b.slice(254, 256).length)
