package { name = "c-out-finalizers", version = "0.1.0" }

// The handle classes of tests/c/handles, over the C library the test harness builds from tests/c.
dependencies {
  fixture-handles { path = "../../../c/handles" }
}

// The enums, constants and out parameters of avin_enums.h, in the same C library.
c-libraries {
  enums { pkg-config = "avin-c-fixture", headers = ["avin_enums.h"] }
}
