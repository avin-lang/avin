// expect: exit 0
// Handles answered through out pointers are given back by the collector's finalizer exactly once:
// 10,000 objects made through an out pointer alone, in an `Option`, two at once in a status's tuple
// and lent through one, and 10,000 faces each keeping its library through an out pointer, every one
// given back with nothing freed twice; enum mirrors, constants and strings cross beside them. The
// corpus runs this with the collector at every allocation, at -O0 and -O2.
import fixture.{Counts, Face, Library, Object, faces, libraries, newLibrary, newObject, objects}

@c(enum: "ae_status_t", prefix: "AE_STATUS_")
data Status
  Success
  NoMemory
  Invalid

@c(enum: "ae_format_t", prefix: "AE_FORMAT_")
data Format
  Invalid
  Argb32
  Rgb24
  A8
  Rgb16_565
  Rgb30

@c(const: "AE_STRING_CONST")
val tag: string

@c(const: "AE_INT_CONST")
val answer: int

@c("int ae_object_make(int value, out fx_object **object)")
objectMake(value: int) -> Result[Object, int]

@c("void ae_object_maybe(int value, out fx_object **object)")
objectMaybe(value: int) -> Option[Object]

@c("ae_status_t ae_object_pair(int a, int b, out fx_object **first, out fx_object **second)")
objectPair(a: int, b: int) -> Result[(Object, Object), Status]

@c("void ae_object_lent(fx_object *of, out fx_object **object)", borrowed)
objectLent(of: Object) -> Object

@c("int ae_face_make(fx_library library, int id, out fx_face *face)", keeps: "library")
faceMake(library: Library, id: int) -> Result[Face, int]

@c("void ae_format_out(int code, out ae_format_t *f)")
formatOut(code: int) -> Format

@c("void ae_name_out(int which, out const char **name)")
nameOut(which: int) -> string

line(c: Counts) -> string = s"${c.created} ${c.retained} ${c.released} ${c.freed}"

// Allocates until every object of `counts` has been freed, or gives up after a bound.
settle(counts: () -> Counts) -> bool
  var n = 0
  while counts().freed < counts().created && n < 1000000
    val v = [n, n + 1]
    n += v(1) - v(0)
  counts().freed == counts().created

made(i: int) -> int = objectMake(i).fold(_ -> 0, o -> o.value())

maybe(i: int) -> int = objectMaybe(i).map(o -> o.value()).getOrElse(0)

paired(i: int) -> int = objectPair(i, 1) match
  Ok((a, b)) -> a.value() + b.value()
  Err(_) -> 0

lent(i: int) -> int = objectLent(newObject(i)).value()

faced(i: int) -> int = faceMake(newLibrary(), i).fold(_ -> 0, f -> f.id())

main()
  var sum: long = 0
  var text = 0
  for i in 0 ..< 10000
    sum += long(made(i)) + long(maybe(i % 2)) + long(paired(i)) + long(lent(i))
    if formatOut(i % 3) == Format.A8 then sum += 1
    text += nameOut(i % 2).byteLength
  println(sum)
  println(text)
  println(settle(() -> objects()))
  println(line(objects()))
  for i in 0 ..< 10000
    sum += long(faced(i))
  println(settle(() -> faces()))
  println(settle(() -> libraries()))
  println(line(faces()))
  println(line(libraries()))
  println(s"$tag $answer $sum")
