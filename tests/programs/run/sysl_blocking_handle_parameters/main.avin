// expect: exit 0
// A binding declared `blocking` takes handles as parameters as any binding does: a value without a
// destructor by copy or through a pointer to the handle's own value, a counted reference shared, as a
// function's parameters and as a handle's method's, on a program's only thread and while other threads
// allocate and collect.
import avin.threads.spawn

@sysl("avintest.digits.Tally")
class Tally
    get() -> long

@sysl("avintest.digits.new_tally")
newTally(n: long) -> Tally

@sysl("avintest.digits.sum_of", blocking)
sumOf(a: Tally, b: Tally) -> long

@sysl("avintest.digits.Mark")
class Mark
    place() -> long

@sysl("avintest.digits.mark_at")
markAt(n: long) -> Mark

@sysl("avintest.digits.distance", blocking)
distance(a: Mark, b: Mark) -> long

@sysl("avintest.digits.nudge", blocking)
nudge(m: Mark)

@sysl("avintest.digits.Ledger")
class Ledger
    @sysl(blocking)
    record(t: Tally)
    @sysl(blocking)
    mark(m: Mark)
    summary() -> long

@sysl("avintest.digits.new_ledger")
newLedger() -> Ledger

churn(rounds: int) -> int
    var kept: List[string] = []
    for r in 0..<rounds
        kept = s"r$r" :: kept
        if r % 50 == 0 then kept = []
    kept.length()

// Each kind of handle parameter through a blocking call, `rounds` times over.
exercise(rounds: int) -> string
    val m = markAt(10)
    val n = markAt(25)
    val a = newTally(3)
    val b = newTally(4)
    val book = newLedger()
    var total: long = 0
    for _ in 0..<rounds
        total = total + distance(m, n) + sumOf(a, b)
        book.mark(n)
        book.record(a)
    nudge(m)
    nudge(m)
    s"$total ${m.place()} ${distance(m, n)} ${book.summary()}"

main()
    println(exercise(1))
    val workers = (0..<3).map(_ -> spawn(() -> exercise(200))).toVector()
    println(churn(3000))
    for w in workers do println(w.join())
