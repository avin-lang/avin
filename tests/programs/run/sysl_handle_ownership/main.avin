// expect: exit 0
// A Sysl handle belongs to the code that made it, and moves with what is handed to code that runs
// elsewhere: a thread's body and a pool task own the handles they capture until they return, and
// what they return or complete a future with is in transit, taken by the next code to use it. A
// handle made on a thread that has ended, and dropped, is given back by the collector there.
import avin.threads.{Future, Promise, spawn}

@sysl("avintest.digits.Tally")
class Tally
    add(n: long)
    get() -> long
    absorb(other: Tally)

@sysl("avintest.digits.new_tally")
newTally(n: long) -> Tally

@sysl("avintest.digits.given_back")
givenBack() -> long

@sysl("avintest.digits.sum_of")
sumOf(a: Tally, b: Tally) -> long

@sysl("avintest.digits.tallies")
tallies(n: long) -> Vector[Tally]

class Box(val tally: Tally)

// A tally one more than `c` is once three is added to it.
grown(c: Tally) -> Tally
    c.add(3)
    val r = newTally(c.get())
    r.add(1)
    r

main()
    // On the thread that made it, every use is fine.
    val a = newTally(1)
    a.add(1)
    println(a.get())
    // A thread's body uses what it captures, directly or through an object or a collection.
    val b = newTally(10)
    val box = Box(newTally(20))
    val many = tallies(3)
    val t = spawn(() ->
        b.add(1)
        box.tally.add(1)
        for x in many do x.add(5)
        sumOf(b, box.tally))
    println(t.join())
    // Once the body has returned, what it held is in transit, and the next user takes it.
    b.add(1)
    println(s"${b.get()} ${box.tally.get()} ${many(2).get()}")
    // A handle a thread makes and returns is taken by whoever joins it.
    val made = spawn(() -> newTally(7)).join()
    made.absorb(a)
    println(made.get())
    // A handle the thread that made it never returns stays its own, so it never conflicts.
    val other = spawn(() ->
        val own = newTally(100)
        own.add(1)
        own.get())
    println(other.join())
    // A pool task owns what it captures until it returns, whichever worker runs it, and a future's
    // value is taken by the code that awaits it.
    val c = newTally(30)
    val f = Future(grown(c))
    val r = f.await()
    println(s"${r.get()} ${c.get()}")
    // A callback owns what it captures, and the value it is given.
    val d = newTally(40)
    val g = Future(newTally(2)).map(x ->
        d.absorb(x)
        d.get())
    println(g.await())
    // A promise completed on one thread hands its value to the thread that waits for it.
    val p = Promise[Tally]()
    spawn(() -> p.complete(newTally(50))).join()
    val q = p.future.await()
    q.add(1)
    println(q.get())
    // Close on the owner gives the value back, and closing again does nothing.
    val before = givenBack()
    q.close()
    q.close()
    println(givenBack() - before)
    // Handles made and dropped on threads that have ended are given back by the collector, which
    // may run their finalizers on any thread.
    val start = givenBack()
    for i in 0..<20
        spawn(() ->
            for j in 0..<1000
                val x = tallies(5)
                x(4).add(1)
            ()).join()
    var collected = false
    for i in 0..<20000
        val x = tallies(10)
        x(9).add(1)
        if givenBack() - start > 1000 then collected = true
    println(collected)
