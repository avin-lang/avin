// expect: exit 0
// What a handle keeps lives while the handle does, though nothing else reaches it: a plain object a
// shelf keeps as the Avin object, a face and library a variation descriptor keeps by C references,
// and an object a library has taken, whose closed handle the collector frees with nothing to give
// back. Once the holder goes, so does what it kept, each once.
import fixture.{
  Shelf, MMVar, faces, libraries, mmVar, mmVars, newFace, newLibrary, newObject, newPlain, newShelf, objects, plains,
  shelves
}

churn()
  var n = 0
  for i in 0 ..< 2000
    val v = [n, n + 1]
    n += v(1) - v(0)

settle()
  var n = 0
  while (
    plains().freed < plains().created || faces().freed < faces().created || objects().freed < objects().created
  ) && n < 1000000
    val v = [n, n + 1]
    n += v(1) - v(0)

shelf() -> Shelf = newShelf(newPlain(6))

descriptor() -> MMVar = mmVar(newFace(newLibrary(), 4))

main()
  var s = Some(shelf())
  var m = Some(descriptor())
  val lib = newLibrary()
  lib.adopt(newObject(5))
  churn()
  println(s.map(x -> x.peek()))
  println(m.map(x -> x.axes()))
  println(plains().freed)
  println(faces().freed)
  println(libraries().freed)
  println(objects().released)
  s = None
  m = None
  lib.close()
  settle()
  println(shelves().freed)
  println(plains().freed)
  println(mmVars().freed)
  println(faces().freed)
  println(libraries().freed)
  println(objects().freed)
