// expect: exit 0
// env: AVIN_GC_STRESS=2
// An array of struct mirrors passed to C is laid out element by element in a loop, and the loop
// polls, so a collection may run partway through. The array is made in the call's argument and
// nothing else holds it, yet it stays alive until the last element is copied: the collector runs at
// every allocation and every poll here, so a copy that let it go would read freed memory. Each shape
// a struct array crosses in: a plain struct, one holding a string, a nested one, passed to a
// `blocking` call, at lengths 0, 1, 2 and many; and an optional array of a primitive type.
@c("void aa_set_flag(void)")
setFlag()

@c(enum: "as_kind", prefix: "AS_KIND_")
data Kind
  Plain
  Bold
  Faint

@c(struct: "as_point")
data Point(x: real, y: real)

@c(struct: "as_rect")
data Rect(origin: Point, size: Point)

@c(struct: "as_named")
data Named(name: Option[string], id: int, kind: Kind, on: bool, truth: bool)

@c(struct: "as_glyph")
data Glyph(index: long, x: real, y: real)

@c("double as_glyphs_sum(const as_glyph *glyphs, length(glyphs) int count)")
glyphsSum(glyphs: Array[Glyph]) -> real

@c("long long as_names_total(const as_named *names, length(names) size_t count)")
namesTotal(names: Array[Named]) -> long

@c("double as_rects_area(length(rects) size_t count, const as_rect *rects)")
rectsArea(rects: Array[Rect]) -> real

@c("double as_wait_glyphs(const as_glyph *glyphs, length(glyphs) int count, int timeout_ms)", blocking)
waitGlyphs(glyphs: Array[Glyph], timeout: int) -> real

@c("uLong crc32(uLong crc, const Bytef *buf, length(buf) uInt len)")
crc32(crc: long, buf: Option[Array[byte]]) -> long

main()
  for n in [0, 1, 2, 100]
    println(glyphsSum(Array.tabulate(n, i -> Glyph(long(i), 1.0, 2.0))))
    println(namesTotal(Array.tabulate(n, i -> Named(Some(s"n${i}"), i, Bold, false, false))))
    println(rectsArea(Array.tabulate(n, i -> Rect(Point(real(i), 0.0), Point(real(i), 2.0)))))
    setFlag()
    println(waitGlyphs(Array.tabulate(n, i -> Glyph(long(i), 1.0, 2.0)), 60000))
    println(crc32(0, Some(Array.tabulate(n, i -> byte(i % 100)))))
  println(crc32(0, None))
