package { name = "c-struct-array-poll-collects", version = "0.1.0" }

c-libraries {
  structs { pkg-config = "avin-c-fixture", headers = ["avin_arrays.h", "avin_structs.h"], install = "the test harness builds it from tests/c" }
  zlib { pkg-config = "zlib", headers = ["zlib.h"], install = "zlib: `brew install zlib`; Debian's zlib1g-dev" }
}
