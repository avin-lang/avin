// expect: exit 0
// An application is made without opening a window: `app` keeps the tree and ground functions for
// `run`, which is what calls them. With no window running, retitling answers `false`, and asking
// for a frame or for the loop to stop waits for a loop that is not there.
import ui.{App, View, app, button, column, invalidate, saveFrame, setTitle, stop, text}

screen(count: int) -> View = column([text(s"count $count"), button("Add", () -> invalidate())], 8)

main()
    var built = 0
    val tree = () ->
        built += 1
        screen(built)
    val a = app("Counter", tree, () -> 0x202020)
    val b = app("Sized", () -> text("sized"), () -> 4294967295, width = 320, height = 480)
    val apps: Vector[App] = [a, b]
    println(apps.length())
    println(built)
    println(setTitle("nothing to retitle"))
    saveFrame("never-written.png")
    stop()
    a.close()
    b.close()
    println("done")
