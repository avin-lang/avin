// expect: exit 0
// A given imported by name is a value and a given of the importing file: it is read, `current.id`,
// passed by name, `tx = current`, and fills a call that names no argument for it, of its own module's
// functions and of this file's. Importing its module whole as well changes nothing.
import context
import context.{current}

local(using tx: context.Tx) -> int = tx.id * 100

main()
  println(current.id)
  println(context.tag(tx = current))
  println(context.tag())
  println(local())
