// expect: trap
// A trap inside a callback stops the program, reported at its own place in the callback's code,
// however deep in C it was called: here three calls down, inside a comparator `qsort_r` runs.

@c("long long cb_repeat(int n, int (*f)(userdata void *ud, int i), userdata void *ud)")
repeat(n: int, f: int -> int) -> long

@c("void cb_sort_ints(int *values, length(values) size_t n, int (*compare)(userdata void *ud, int a, int b), userdata void *ud)")
sortInts(values: Array[int], compare: (int, int) -> int)

compare(a: int, b: int) -> int
    val big = 2147483647
    if a + b == 5 then big + a else a - b

sortThenAnswer(j: int) -> int
    sortInts(Array.tabulate(4, k -> k), compare)
    j

main()
    println(repeat(2, i -> int(repeat(2, j -> j))))
    println(repeat(2, i -> int(repeat(2, sortThenAnswer))))
