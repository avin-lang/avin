package { name = "c-callback-argument-trap", version = "0.1.0" }

// `avin-c-fixture` is the C library in tests/c, which the test harness builds and names to
// `pkg-config`.
c-libraries {
  callbacks { pkg-config = "avin-c-fixture", headers = ["avin_callbacks.h"], install = "the test harness builds it from tests/c" }
}
