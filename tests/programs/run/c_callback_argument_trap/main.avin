// expect: trap
// What C calls a callback with crosses as a binding's result does: a `uint32_t` past the greatest
// `int` stops the program where the binding was called, before the function runs.

@c("uint32_t cb_u32(uint32_t (*f)(userdata void *ud, uint32_t x), userdata void *ud, uint32_t x)")
u32(f: int -> long, x: long) -> long

noisy(x: int) -> long
  println("never")
  long(x)

main()
  println(u32(x -> long(x), 2147483647))
  println(u32(noisy, 2147483648))
