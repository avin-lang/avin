module registry

open class Named(val label: string)
  describe() -> string = s"named $label"

// An object in another module than `main`'s, naming itself in a `lazy val`, a lambda made after its
// last field, a method and an override: none of these makes the object need itself.
object Registry: Named("registry")
  var entries: Vector[string] = ["first"]
  lazy val size: int = Registry.entries.length
  var onAdd: (string) -> unit = (_) -> ()
  onAdd = (name) -> Registry.entries = Registry.entries :+ name
  add(name: string) -> int
    Registry.onAdd(name)
    Registry.entries.length
  override describe() -> string = s"${super.describe()} with ${Registry.entries}"
