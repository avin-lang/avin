// expect: exit 0
// env: SDL_VIDEODRIVER=dummy
// The frame loop runs the work waiting for the main thread at the start of every frame, before it
// decides whether to build the tree again, so what that work writes is built in the same frame. The
// window runs on SDL's dummy video driver, which shows nothing. Each frame asks for the colour once,
// after the tree, so counting those calls numbers the frames. The loop builds the tree once as it
// starts; work sent before then is built again in the first frame, and work sent during a frame is
// built in the next one, never a frame later.
import ui.{app, inbox, intSignal, post, run, stop, text}

main()
  val count = intSignal(0)
  val setTo = inbox((n: int) -> count.set(n))
  val builds = Buffer[string]()
  var frames = 0
  val tree = () ->
    builds.append(s"built in frame ${frames + 1} with ${count.read()}")
    text(s"${count.read()}")
  val ground: () -> long = () ->
    frames += 1
    if frames == 1
      _ = setTo.send(8)
      post(() -> println("posted in frame 1, run at the start of frame 2"))
    if frames == 3 then stop()
    0x202020
  _ = setTo.send(7)
  println(run(app("frames", tree, ground, width = 160, height = 120)).isOk)
  for b in builds do println(b)
  println(s"$frames frames")
