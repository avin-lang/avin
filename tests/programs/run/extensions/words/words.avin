module words

// Extensions: impls adding methods to types and traits of the core library, from a module of the
// program. A file importing this module, or a declaration of it, sees them.
impl string
  shout() -> string = s"${self}!"
  whisper() -> string = quiet()
  // Private to this module.
  private quiet() -> string = s"(${self})"
  // Overloads the type's own `repeat(count: int)`, with other parameter types.
  repeat(count: long) -> string = s"${self} x$count"

impl[T: Ord] Seq[T]
  median() -> T = sorted.apply(length / 2)

impl[T] Option[T]
  valueOr(fallback: T) -> T = self match
    Some(x) -> x
    None -> fallback

impl[T] Option[Option[T]]
  depth() -> int = self match
    Some(Some(_)) -> 2
    Some(None) -> 1
    None -> 0

impl int
  plus(n: int) -> int = self + n

val one = 1
