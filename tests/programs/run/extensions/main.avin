// expect: exit 0
// The methods an impl adds in another module than its type's are seen by a file importing that
// module whole (`words`, `geometry`) or a declaration of it. They are called dotted, infix, as
// method values and through a bound.
import words
import shapes.Box
import geometry

middle[S: Seq[int]](xs: S) -> int = xs.median()

main()
    println("hey".shout())
    println("hey".whisper())
    println("hey".repeat(2))
    println("hey".repeat(long(2)))
    println(s"${[3, 1, 2].median()} ${middle([5, 9, 7])}")
    val nested: Option[Option[int]] = Some(Some(1))
    println(s"${nested.depth()}")
    val none: Option[int] = None
    println(s"${Some(4).valueOr(0)} ${none.valueOr(5)} ${none valueOr 6}")
    println(s"${3 plus 4}")
    val b = Box(2, 3)
    println(s"${b.perimeter()} ${b.area()} ${b.area(2)}")
    val f: () -> string = "x".shout
    println(f())
