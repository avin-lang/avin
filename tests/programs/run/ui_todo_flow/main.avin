// expect: exit 0
// A list of things to do, driven with no window: text typed into the field's state is added by
// the button, each row is a component keyed by its item and keeps whether it is asking to confirm
// a removal while the filter moves it, the filter is a radio group over a state, and the count of
// what is left is a derived value.
import ui.{Rect, State, View, button, checkbox, column, component, keyed, radioGroup, recorder, root, row, snapshot, state, tap, text, textField}

val Screen = Rect(0, 0, 400, 800)

class Item(val id: int, val label: string)
    val done = state(false)

shown(v: View) -> string = snapshot(v, recorder(), Screen).dump()

texts(v: View) -> string
    val lines = shown(v).split("\n")
    lines.filter(l -> l.contains(" text \"") || l.contains(" checkbox \"") || l.contains(" button \"")).map(l -> l.split("\"")(1)).mkString(" | ")

entry(item: Item, remove: (Item) -> unit) -> View = keyed(item.id) c ->
    val confirming = c.state(false)
    val removal = if confirming.get()
        button("Sure?", () -> remove(item)).named(s"sure-${item.id}")
    else
        button("Remove", () -> confirming.set(true)).named(s"remove-${item.id}")
    row([checkbox(item.done, item.label).named(s"done-${item.id}"), removal], 8)

main()
    var draftState: Option[State[string]] = None
    val build = root(() -> component c ->
        val nextId = c.state(0)
        val items: State[Vector[Item]] = c.state([])
        val draft = c.state("")
        draftState = Some(draft)
        val filter = c.state(0)
        val add = () ->
            val label = draft.get().trim
            if label != ""
                items.update(xs -> xs :+ Item(nextId.get(), label))
                nextId.update(n -> n + 1)
                draft.set("")
        val left = c.derived(() -> items.get().count(x -> !x.done.get()))
        val visible = items.get().filter(x -> filter.get() match
            1 -> !x.done.get()
            2 -> x.done.get()
            _ -> true)
        column([textField(draft, 1, onEnter = add).named("draft"), button("Add", add).named("add"), radioGroup(["All", "Active", "Done"], filter).named("filter"), column(visible.map(x -> entry(x, gone -> items.update(xs -> xs.filter(y -> y.id != gone.id))))), text(s"$left left")]))
    // Empty: nothing to show, and adding nothing, or only spaces, adds nothing.
    var v = build()
    println(texts(v))
    println(shown(v))
    tap(v, "add", Screen)
    val draft = draftState.getOrElse(state(""))
    State.signal(draft).set("   ")
    tap(build(), "add", Screen)
    println(texts(build()))
    // Typing is the field's signal changing, the state's own; the button adds it and clears the field.
    for word in ["milk", "eggs", "brød ✓"]
        State.signal(draft).set(word)
        tap(build(), "add", Screen)
    v = build()
    println(texts(v))
    println(shown(v).contains("value=\"\"") || !shown(v).contains("value="))
    // Done, then the filters: the group's options are @4, @5 and @6.
    tap(v, "done-1", Screen)
    v = build()
    println(texts(v))
    tap(v, "@5", Screen)
    println(texts(build()))
    tap(build(), "@6", Screen)
    println(texts(build()))
    // A row asking to confirm keeps asking when the filter moves it: under Active, the last row
    // moves up past the hidden one, and is still the component it was.
    tap(build(), "@4", Screen)
    v = build()
    tap(v, "remove-2", Screen)
    v = build()
    println(texts(v))
    tap(v, "@5", Screen)
    v = build()
    println(texts(v))
    // A row the filter leaves out loses what it kept: hidden, it asks again from the start.
    tap(v, "@4", Screen)
    tap(build(), "remove-1", Screen)
    println(texts(build()))
    tap(build(), "@5", Screen)
    tap(build(), "@4", Screen)
    v = build()
    println(texts(v))
    // Confirming removes the item; the count follows.
    tap(v, "sure-2", Screen)
    v = build()
    println(texts(v))
    tap(v, "remove-0", Screen)
    tap(build(), "sure-0", Screen)
    println(texts(build()))
