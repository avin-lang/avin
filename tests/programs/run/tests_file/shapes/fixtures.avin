module shapes
@tests

data Square(side: int)

impl Square
    perimeter() -> int = side * 4

unitSquare() -> Square = Square(1)

val corners = announced(1)

announced(n: int) -> int
    print("a test's value was initialized")
    n

@setup
opens()
    print("setting up")

@test
perimeterOfTheUnitSquare()
    assertEq(unitSquare().perimeter(), 4)
