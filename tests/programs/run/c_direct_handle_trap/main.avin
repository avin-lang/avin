// expect: exit 0
// A handle made as a binding's argument, never stored, is given back exactly once when the actor
// using it traps: before the call, where a later argument traps, and after it, where C answers a
// null the binding's type does not allow. Each actor traps on its one message and fails; once all
// have ended, the collector frees every handle they made, and each line is the fixture's counts of
// what was made, references taken and given back and objects freed, and whether every one made
// was freed. The corpus runs this with the collector at every allocation, at -O0 and -O2.
import avin.actors.{Stop, spawn}
import fixture.{Counts, Library, Object, SharedObject, libraries, newLibrary, newObject, newShared, objects}

@c("void aa_set_flag(void)")
setFlag()

@c("int aa_wait_object(const fx_object *o, int timeout_ms)", blocking)
waitShared(o: SharedObject, timeout: int) -> int

@c("int aa_wait_object(const fx_object *o, int timeout_ms)")
peekOwned(o: Object, timeout: int) -> int

// Null where the library has adopted nothing, which an `Object` result does not allow.
@c("fx_object *fx_library_adopted(fx_library library)", borrowed)
adoptedOf(library: Library) -> Object

data Shape
  SharedBefore(zero: int)
  OwnedBefore(zero: int)
  LibraryAfter

actor Trapper receives Shape
  receive
    SharedBefore(zero) -> println(waitShared(newShared(7), 1000 / zero))
    OwnedBefore(zero) -> println(peekOwned(newObject(8), 1000 / zero))
    LibraryAfter -> println(adoptedOf(newLibrary()).value())

line(c: Counts) -> string = s"${c.created} ${c.retained} ${c.released} ${c.freed}"

// Allocates until every object of `counts` has been freed, or gives up after a bound.
settle(counts: () -> Counts) -> bool
  var n = 0
  while counts().freed < counts().created && n < 1000000
    val v = [n, n + 1]
    n += v(1) - v(0)
  counts().freed == counts().created

// Sends `shape` to a new actor and waits for it to end.
fail(shape: Shape)
  val t = spawn(Trapper(), Stop)
  t.tell(shape)
  println(t.ended().await())

main()
  setFlag()
  fail(SharedBefore(0))
  fail(OwnedBefore(0))
  println(settle(() -> objects()))
  println(line(objects()))
  fail(LibraryAfter)
  println(settle(() -> libraries()))
  println(line(libraries()))
