// expect: exit 0
// A module of several files declares its givens in each, of different types, and every file of the
// module reads them as values; another module reads them by their names, as values. A private given
// stays in its module.
import context
import context.{log}

data Clock(start: long)

given clock = Clock(1)

main()
  println(log.line("hello"))
  println(context.stamp())
  println(context.clock.start)
  println(clock.start)
  println(context.secretValue())
