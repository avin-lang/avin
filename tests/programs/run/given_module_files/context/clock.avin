module context

data Clock(start: long)

given clock = Clock(1000)

stamp() -> long = clock.start + long(log.prefix.byteLength)

tagged(text: string, using l: Log, c: Clock) -> string = l.line(s"$text at ${c.start}")

// The module's givens, of every file, fill a call in any of its files.
logged(text: string) -> string = tagged(text)
