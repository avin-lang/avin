// expect: exit 0
// A real goes into a Sysl `f32` rounded to the nearest value an `f32` holds, a tie to the one whose
// last bit is zero, and comes out of one widened exactly: as a parameter, a result, a mirror's field,
// a value an option, a collection or a tuple holds, a handle's method's parameter and result, a call
// that waits, and a callback's parameter and answer. Nothing stops the program: a value past the
// largest `f32` rounds to an infinity, one below the smallest to a zero of its sign, and a NaN stays
// one. The bits Sysl sees are printed, so a rounding shows.

@sysl("avintest.digits.f32_bits")
f32Bits(x: real) -> long

@sysl("avintest.digits.f32_of_bits")
f32OfBits(b: long) -> real

@sysl("avintest.digits.f32_same")
f32Same(x: real) -> real

@sysl("avintest.digits.f32_half")
f32Half(x: real) -> real

@sysl("avintest.digits.f32_mixed")
f32Mixed(a: real, b: real) -> real

@sysl("avintest.digits.f32_largest")
f32Largest() -> real

@sysl("avintest.digits.f32_smallest_normal")
f32SmallestNormal() -> real

@sysl("avintest.digits.f32_smallest")
f32Smallest() -> real

@sysl("avintest.digits.Weighed")
data Weighed(name: string, weight: real, exact: real)

@sysl("avintest.digits.weighed")
weighed(name: string, w: real) -> Weighed

@sysl("avintest.digits.weight_bits")
weightBits(t: Weighed) -> long

@sysl("avintest.digits.f32_maybe")
f32Maybe(x: real) -> Option[real]

@sysl("avintest.digits.f32_halvings")
f32Halvings(x: real, n: int) -> Vector[real]

@sysl("avintest.digits.f32_halvings")
f32HalvingsArray(x: real, n: int) -> Array[real]

@sysl("avintest.digits.f32_with_bits")
f32WithBits(x: real) -> (real, long)

@sysl("avintest.digits.Scale")
class Scale
    scaled(x: real) -> real
    factorOf() -> real

@sysl("avintest.digits.new_scale")
newScale(f: real) -> Scale

@sysl("avintest.digits.f32_half_after", blocking)
f32HalfAfter(ms: int, x: real) -> real

@sysl("avintest.digits.f32_apply")
f32Apply(f: real -> real, x: real) -> real

@sysl("avintest.digits.f32_apply_bits")
f32ApplyBits(f: real -> real, b: long) -> long

main()
    // Rounding: to the nearest, a tie to even.
    println(s"${f32Same(0.1)} ${f32Bits(0.1)}")
    println(s"${f32Same(1.0 / 3.0)} ${f32Same(-1.0 / 3.0)}")
    println(s"${f32Same(16777217.0)} ${f32Same(16777219.0)} ${f32Same(1.5)}")
    // The zeros keep their signs.
    println(s"${f32Bits(0.0)} ${f32Bits(-0.0)} ${f32Same(-0.0)} ${1.0 / f32Same(-0.0)}")
    // The infinities, and a value past the largest `f32`, which rounds to one.
    println(s"${f32Bits(real.PositiveInfinity)} ${f32Bits(real.NegativeInfinity)} ${f32Same(1.0e39)} ${f32Same(-1.0e39)}")
    println(s"${f32Same(real.MaxValue)} ${f32Same(-real.MaxValue)}")
    // NaN goes in and comes out a NaN.
    println(s"${f32Same(real.NaN).isNaN} ${f32OfBits(2143289344).isNaN}")
    // The largest and the smallest normal and subnormal `f32`, given and answered exactly.
    println(s"${f32Largest()} ${f32Bits(f32Largest())} ${f32Same(3.4028234663852886e38) == f32Largest()}")
    println(s"${f32SmallestNormal()} ${f32Bits(f32SmallestNormal())}")
    println(s"${f32Smallest()} ${f32Bits(f32Smallest())} ${f32Bits(-f32Smallest())}")
    // A subnormal rounds as any value does; below half the smallest it is a zero of its sign.
    println(s"${f32Bits(2.0e-45)} ${f32Bits(7.006492321624085e-46)} ${f32Bits(1.0e-46)} ${f32Bits(-1.0e-46)} ${f32Bits(1.0e-300)}")
    println(s"${f32OfBits(1)} ${f32OfBits(2139095040)} ${f32OfBits(4286578688)} ${f32OfBits(2147483648)}")
    // Arithmetic in Sysl at the precision of an `f32`, and an `f32` beside a `real`.
    println(s"${f32Half(1.0)} ${f32Half(f32Smallest())} ${f32Half(f32Largest())}")
    println(f32Mixed(0.1, 0.1))
    // A mirror's `f32` field, in each direction.
    val w = weighed("salt", 0.1)
    println(s"${w.name} ${w.weight} ${w.exact} ${weightBits(w)}")
    println(weightBits(Weighed("pepper", -0.0, 0.0)))
    println(weightBits(Weighed("sugar", 1.0e39, 0.0)))
    // An `f32` an option, a collection or a tuple holds comes out widened.
    println(s"${f32Maybe(0.1)} ${f32Maybe(-1.0)}")
    println(f32Halvings(0.1, 3))
    println(f32HalvingsArray(1.0, 3).toVector)
    println(f32WithBits(-0.1))
    // A handle's method.
    val s = newScale(0.1)
    println(s"${s.factorOf()} ${s.scaled(3.0)} ${s.scaled(1.0e39)}")
    s.close()
    // A call that waits, many times while objects are made between them.
    println(f32HalfAfter(1, 0.1))
    var made: Vector[real] = []
    for i in 0..<200
        made = made :+ f32HalfAfter(0, real(i) / 3.0)
    println(made(199))
    // A callback is given an `f32` widened and answers one rounded.
    println(f32Apply(x -> x * 3.0, 0.1))
    println(f32Apply(x -> x * 2.0, f32Largest()))
    println(s"${f32ApplyBits(x -> -x, 0)} ${f32ApplyBits(x -> 1.0e-46, 0)} ${f32ApplyBits(x -> x / 2.0, 1)}")
    println(f32OfBits(f32ApplyBits(x -> real.NaN, 0)).isNaN)
    // A binding with an `f32` parameter and result is a function like any other.
    val f: real -> real = f32Same
    println(f(0.2))
