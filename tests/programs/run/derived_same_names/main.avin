// expect: exit 0
// Two modules each declare a `Point` and a `Mark` deriving the core library's traits. The methods
// made from the core library's templates belong to each type's own module, so the two types' derived
// methods are kept apart, and each type shows, compares and hashes by its own fields.
import geo.showGeo

data Point(name: string, rank: int) derives Ord

class Mark[T](val at: T, val note: string) derives Eq, Hash, Ord, Display

main()
    print(Point("p", 1))
    print(s"${Point("p", 2) > Point("p", 1)} ${Mark(Point("q", 0), "n")} ${Mark(1, "a") == Mark(1, "a")}")
    showGeo()
