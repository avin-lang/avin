package { name = "c-handle-cross-package", version = "0.1.0" }

// The handle classes of tests/c/handles and of tests/c/shapes, which binds the first's, over the C
// library the test harness builds from tests/c.
dependencies {
  fixture-handles { path = "../../../c/handles" }
  fixture-shapes { path = "../../../c/shapes" }
}
