// expect: exit 0
// A shape of one package keeps an object of the package it depends on by a C reference of its own,
// so the object outlives its own handle until the shape goes; a borrowed object answered is the other
// package's class, and one the shape takes is closed here and freed when the shape is.
import fixture.{newObject, objects, shapes}
import shapes.{Shape, newShape}

made() -> Shape = newShape(newObject(5))

main()
    var s = Some(made())
    var n = 0
    for i in 0..<2000
        val v = [n, n + 1]
        n += v(1) - v(0)
    println(s.map(x -> x.value()))
    s.foreach(x -> x.absorb(x.copy()))
    println(s.map(x -> x.object().value()))
    println(objects().freed)
    s = None
    while (shapes().freed < 1 || objects().freed < objects().created) && n < 1000000
        val v = [n, n + 1]
        n += v(1) - v(0)
    println(shapes().freed)
    println(objects().created)
    println(objects().freed)
