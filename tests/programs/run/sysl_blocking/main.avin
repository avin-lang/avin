// expect: exit 0
// A binding declared `blocking` marks its thread safe for the collector while the Sysl call waits, so
// threads blocked in Sysl calls hold up no collection: the main thread allocates and collects many
// times over while they wait, then lets them go. What the calls take and answer still crosses whole.
import avin.threads.spawn

@sysl("avintest.digits.wait_at_gate", blocking)
waitAtGate() -> long

@sysl("avintest.digits.gate_waiters_now")
gateWaiters() -> int

@sysl("avintest.digits.open_gate")
openGate()

// A call that answers nothing, and one whose argument is a collection, may be declared blocking too.
@sysl("avintest.digits.close_gate", blocking)
closeGate()

@sysl("sysl.path.join_all", blocking)
joinAll(parts: Vector[string]) -> string

// The arguments are converted before the call waits, and what it answers once it has returned.
@sysl("avintest.digits.echo_after", blocking)
echoAfter(text: string, ms: long) -> Result[string, long]

@sysl("avintest.digits.Latch")
class Latch
  // Bound to the Sysl method of its own name, and blocking: it answers a view of the latch, which
  // is copied out after the wait.
  @sysl(blocking)
  wait() -> Array[byte]
  open() -> unit

@sysl("avintest.digits.new_latch")
newLatch(label: string) -> Latch

churn(rounds: int) -> int
  var kept: List[string] = []
  for r in 0 ..< rounds
    kept = s"r$r" :: kept
    if r % 50 == 0 then kept = []
  kept.length

main() -> int
  // On a thread alone, a blocking binding is an ordinary call.
  println(echoAfter("alone", 1))
  println(echoAfter("never", -3))
  println(joinAll(["a", "b", "c"]))
  val gated = [spawn(() -> waitAtGate()), spawn(() -> waitAtGate())]
  while gateWaiters() < 2
    churn(10)
  // Both waiters are inside the Sysl call now, and every collection goes on without them.
  println(churn(3000))
  openGate()
  for t in gated do println(t.join() >= 0)
  closeGate()
  // The latch is the waiting thread's while it waits, so it is let go through the gate; once the
  // thread has returned, the latch is the next user's again.
  val latch = newLatch("latched")
  val latchWaiter = spawn(() -> latch.wait().length)
  val echoes = [spawn(() -> echoAfter(s"echo ${1 + 1}", 20)), spawn(() -> echoAfter("late", 40))]
  println(churn(3000))
  openGate()
  println(latchWaiter.join())
  for e in echoes do println(e.join())
  closeGate()
  latch.open()
  println(latch.wait().length)
  latch.close()
  0
