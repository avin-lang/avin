// expect: exit 0
// A type written through the name of a module imported whole, `m.T`, is resolved wherever a type is
// written: annotations, parameters, results, fields, type arguments, nested generics, function
// types, bounds, impl targets and type patterns. It works for a nested module, a renamed one, a
// standard library module and from a literate file; its companion is reached the same way.
import avin.collections.mutable
import avin.collections.mutable as mut
import geometry.shapes
import geometry.shapes as gs
import notes

count(s: mutable.Set[int]) -> int = s.size

table() -> mutable.Map[string, int]
  val m = mutable.Map[string, int]()
  m("a") = 1
  m

class Holder(val seen: mutable.Set[int], val boxes: Vector[shapes.Box[shapes.Shape]])

impl mutable.Set[int]
  total() -> int
    var t = 0
    for x in self
      t += x
    t

impl shapes.Box[int]
  doubled() -> int = item * 2

measure[T: shapes.Sized](x: T) -> int = x.size()

describe(x: Any) -> string = x match
  s: mutable.Set[int] -> s"set of ${s.size}"
  b: gs.Box[string] -> s"box of ${b.item}"
  _ -> "other"

main()
  val seen = mutable.Set[int]()
  seen += 3
  seen += 4
  val circle: shapes.Shape = shapes.Circle(2)
  val box: shapes.Box[shapes.Shape] = shapes.Box.of[shapes.Shape](circle)
  val h = Holder(seen, [box])
  println(s"${count(h.seen)} ${table().size} ${seen.total()}")
  println(s"${shapes.area(h.boxes(0).item)} ${shapes.Box.of[int](5).doubled()}")
  val pair: Option[(int, mut.Map[string, int])] = Some((1, table()))
  pair match
    Some((n, m)) -> println(s"$n ${m("a")}")
    None -> ()
  val a: Any = seen
  println(s"${a is _: mutable.Set[int]} ${describe(a)} ${describe(gs.Box("hat"))} ${describe(1)}")
  val f: (mutable.Set[int]) -> int = count
  println(s"${f(seen)} ${measure(shapes.Ruler(7))}")
  val wide = notes.widen(shapes.Square(2))
  println(s"${shapes.area(wide)} ${shapes.area(notes.Note(circle).shape)}")
