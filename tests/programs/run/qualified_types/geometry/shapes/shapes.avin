module geometry.shapes

data Shape
  Circle(r: int)
  Square(side: int)

class Box[T](val item: T)

object Box
  of[T](item: T) -> Box[T] = Box(item)

trait Sized
  size() -> int

class Ruler(val length: int): Sized
  override size() -> int = length

area(s: Shape) -> int = s match
  Circle(r) -> 3 * r * r
  Square(side) -> side * side
