// expect: exit 0
// Struct mirrors read from and written to fields under collections at every allocation: a mirror
// holding another and an enum mirror, through a pointer; a struct holding a string, copied; strings
// spelled through a typedef of `char`; each value whole while the collector moves around it.

@c(enum: "enum fxf_shade", prefix: "FXF_")
data Shade
  Light
  Dark

@c(struct: "struct fxf_point")
data Spot(x: int, y: int)

@c(struct: "struct fxf_metrics")
data Metrics(xPpem: int, ascender: long, origin: Spot, shade: Shade)

@c(struct: "struct fxf_labelled")
data Labelled(label: string, id: int)

@c(type: "fxf_record *", release: "fxf_record_unref", retain: "fxf_record_ref")
class Shapes
  @c(field: "scaled->metrics")
  metrics() -> Metrics
  @c(field: "scaled->metrics")
  setMetrics(m: Metrics)
  @c(field: "corners[i]", bound: "3")
  corner(i: int) -> Spot
  @c(field: "labelled")
  labelled() -> Labelled
  @c("const fxf_string *fxf_family(const fxf_record *self)")
  family() -> string
  @c("const char *fxf_record_shapes(fxf_record *self)")
  shapes() -> string

@c("fxf_record *fxf_record_new(void)")
newShapes() -> Shapes

@c("long fxf_string_length(const fxf_string *s)")
stringLength(s: string) -> long

main()
  val s = newShapes()
  var kept: Vector[Metrics] = []
  var total: long = 0
  for i in 0 ..< 300
    val junk = [i, i, i]
    s.setMetrics(Metrics(i, long(junk(1)) * 1000000000, Spot(-i, i), if i % 2 == 0 then Shade.Light else Shade.Dark))
    val m = s.metrics()
    if i % 100 == 0 then kept = kept :+ m
    total = total + long(m.xPpem) + long(s.corner(i % 3).x) + stringLength(s.family()) + long(s.labelled().id)
  println(total)
  for m in kept
    println(s"${m.xPpem} ${m.ascender} ${m.origin.x} ${m.origin.y} ${m.shade}")
  println(s.labelled().label)
  println(s.family())
  println(s.shapes())
