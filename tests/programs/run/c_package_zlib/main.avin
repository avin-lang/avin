// expect: exit 0
// A library package whose C bindings call zlib, which its manifest finds through `pkg-config`: the
// program names no C library itself, and is built with zlib because the library is in it.
import zlibtools

main()
    println(zlibtools.compressBound(0))
    println(zlibtools.compressBound(1000))
    println(zlibtools.compressBound(1048576))
    println(zlibtools.uIntIs32Bits())
    println(zlibtools.crcCombine(123, 0, 0))
    println(zlibtools.adlerCombine(1, 1, 0))
    // zlib answers 0xffffffff for a negative length: an unsigned long, which a `long` holds.
    println(zlibtools.adlerCombine(1, 1, -1))
