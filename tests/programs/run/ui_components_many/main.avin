// expect: exit 0
// Many components, built again and again while the collector runs: each keeps its own state and
// the closures its buttons hold, a reordered list keeps every keyed component's state, and the
// components a build leaves out are gone, so the ones built again later start afresh.
import ui.{Rect, View, button, column, component, keyed, recorder, root, row, snapshot, state, tap, text}

val Screen = Rect(0, 0, 400, 20000)

item(id: int) -> View = keyed(id) c ->
    val n = c.state(id)
    val notes = c.remember(Buffer[string]())
    notes.append(s"$id")
    row([text(s"${n.get()}"), button("+", () -> n.update(x -> x + 1000)).named(s"b$id"), inner(id)])

inner(id: int) -> View = component c ->
    val label = c.state(s"in$id")
    text(label.get())

// The sum of the numbers the items show.
total(v: View) -> long
    var sum: long = 0
    for line in snapshot(v, recorder(), Screen).dump().split("\n")
        if line.contains(" text \"") && !line.contains("\"in")
            sum += long(line.split("\"")(1).toInt())
    sum

main()
    val ids = state((0..<150).toVector)
    val build = root(() -> column(ids.get().map(i -> item(i))))
    var v = build()
    println(total(v))
    for round in 0..<10
        Array.fill(256, round)
        tap(v, s"b${round * 7}", Screen)
        ids.update(xs -> xs.reverse)
        v = build()
    println(total(v))
    // Keep the even ones: the odd ones' state is gone, and built again they start from their id.
    ids.update(xs -> xs.filter(i -> i % 2 == 0))
    v = build()
    println(total(v))
    ids.set((0..<150).toVector)
    v = build()
    println(total(v))
    // Many builds of a root that makes and drops whole subtrees.
    var shown: long = 0
    for round in 0..<20
        val few = (round * 5..<round * 5 + 50).toVector
        ids.set(few)
        Array.fill(128, round)
        shown += total(build())
    println(shown)
