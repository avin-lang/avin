// expect: exit 0
// A function C keeps is held by the handle keeping it, and given back with it, exactly once: 10,000
// registries made with one or two listeners each and dropped, every listener forgotten before its
// registry goes, and no record left. Listeners fired many times, allocating as they run, and nested
// calls through bindings passing functions in between. The corpus runs this with the collector at
// every allocation, at -O0 and -O2.

@c(type: "cb_registry *", release: "cb_registry_unref", forget: "cb_registry_forget")
class Registry
    @c("int cb_registry_listen(cb_registry *self, void (*listener)(userdata void *ud, int value), userdata void *ud)", keeps: "listener")
    listen(listener: int -> unit) -> int

    @c("int cb_registry_fire(cb_registry *self, int value)")
    fire(value: int) -> int

@c("cb_registry *cb_registry_new(void)")
newRegistry() -> Registry

@c("long cb_registry_count(int what)")
count(what: int) -> long

@c("long long cb_repeat(int n, int (*f)(userdata void *ud, int i), userdata void *ud)")
repeat(n: int, f: int -> int) -> long

@sysl("avin.rt.callbacks_held")
held() -> long

// Allocates until every registry made has been freed, or gives up after a bound.
settle() -> bool
    var n = 0
    while count(1) < count(0) && n < 1000000
        val v = [n, n + 1]
        n += v(1) - v(0)
    count(1) == count(0)

made(i: int) -> int
    val r = newRegistry()
    var heard = 0
    r.listen(v -> heard += v)
    if i % 2 == 0 then r.listen(v -> heard += s"$v".byteLength)
    r.fire(i)
    heard

main()
    var sum: long = 0
    for i in 0..<10000
        sum += long(made(i))
    println(sum)
    println(settle())
    println(s"${count(0)} ${count(1)} ${count(2)} ${count(3)}")
    println(held())
    val r = newRegistry()
    val words = Buffer[string]()
    r.listen(v -> words.append(s"w$v"))
    for i in 0..<1000
        r.fire(int(repeat(2, j -> i + j)))
    println(words.length)
    println(words(999))
    println(held())
    r.close()
    println(held())
