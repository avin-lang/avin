module shapes

trait Named
  name() -> string

trait Measured
  area() -> int

// A function and a class of another module, bounded by both of its traits.
report[T: Named & Measured](x: T) -> string = s"${x.name()}=${x.area()}"

class Gallery[T: Named & Measured](val items: Vector[T])
  largest() -> string = items.maxBy(x -> x.area()).name()
