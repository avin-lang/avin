// expect: exit 0
// Bounds joined by `&` declared in one module are met by types of another: a data type through two
// impls written beside it, a class through its header.
import shapes.{Named, Measured, report, Gallery}

data Square(side: int)

impl Named for Square
  name() -> string = s"square$side"

impl Measured for Square
  area() -> int = side * side

class Strip(val width: int, val height: int): Named, Measured
  override name() -> string = "strip"
  override area() -> int = width * height

main()
  println(report(Square(3)))
  println(report(Strip(2, 7)))
  println(Gallery([Square(1), Square(4), Square(2)]).largest())
  println(Gallery([Strip(1, 1)]).largest())
