// expect: trap
// A string C answers that is not UTF-8 stops the program at the call, naming the C function and the
// byte the first ill-formed sequence starts at; bound as `Array[byte]`, the same bytes arrive as they
// are.

@c("const char *fixture_invalid(int which)")
invalidBytes(which: int) -> Array[byte]
@c("const char *fixture_invalid(int which)")
invalid(which: int) -> string

main()
    println(invalidBytes(0).length())
    println(invalid(6))
    println(invalid(0))
    println("not reached")
