// expect: exit 0
// `?` converts through conformances to `From` an impl states in another module, the error type's,
// for a function here and for one generic over its error type.
import errors.AppError
import errors.read

checked(n: int) -> Result[int, int] = if n < 0 then Err(n) else Ok(n)

load(path: string, n: int) -> Result[string, AppError]
  val text = read(path)?
  checked(n)?
  Ok(text)

lifted[F: From[int]](n: int) -> Result[int, F]
  val x = checked(n)?
  Ok(x + 1)

main()
  println(load("a", 1))
  println(load("", 1))
  println(load("a", -2))
  println(lifted[AppError](-5))
  println(lifted[AppError](5))
