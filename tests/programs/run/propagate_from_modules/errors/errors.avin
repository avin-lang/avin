module errors

data IoError
    NotFound(path: string)

data AppError
    Io(cause: IoError)
    Code(code: int)

impl From[IoError] for AppError
    static from(value: IoError) -> AppError = Io(value)

impl From[int] for AppError
    static from(value: int) -> AppError = Code(value)

read(path: string) -> Result[string, IoError] = if path == "" then Err(NotFound("<empty>")) else Ok(path)
