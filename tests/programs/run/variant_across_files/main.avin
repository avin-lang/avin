// expect: exit 0
// Data types in different files of one module may share a variant's name, a private type's with a
// public type's included. From another module a name only one visible type has needs nothing to
// decide it; a name two visible types share, reached through the module (`fonts.Normal`) or
// imported (`import fonts.Normal`), is decided by the expected type there as in its own module.
import signals
import fonts
import fonts.{Slant, Weight, Normal, describe}

main()
  println(signals.describe())
  println(signals.Stop)
  val l: signals.Light = signals.Go
  println(l)
  val s: Slant = Normal
  val w: Weight = fonts.Normal
  println(describe(Normal, Normal))
  println(describe(fonts.Italic, fonts.Bold))
  println(s == fonts.Slant.Normal && w == Normal && Normal == w)
  val ws: Vector[Weight] = [fonts.Bold, Normal]
  for x in ws
    x match
      Normal -> println("normal weight")
      fonts.Bold -> println("bold weight")
