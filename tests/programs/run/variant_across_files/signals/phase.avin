module signals

// Private, so another module sees only `Light`'s `Stop`.
private data Phase
    Stop
    Wait

private phaseCode(p: Phase) -> int = p match
    Stop -> 0
    Wait -> 1

private lightCode(l: Light) -> int = l match
    Stop -> 10
    Go -> 11

describe() -> string = s"${Wait} ${phaseCode(Stop)} ${lightCode(Stop)} ${phaseCode(Phase.Stop)}"
