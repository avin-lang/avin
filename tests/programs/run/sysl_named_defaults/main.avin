// expect: exit 0
// A binding marked `named` passes each argument by its parameter's name, spelled as Sysl spells it
// (`onTick` is `on_tick`), so it lists only the parameters it passes, in any order, and every one it
// leaves out takes the Sysl function's own default, evaluated by Sysl at each call.

@sysl("avintest.digits.framed", named)
framedOnFrame(title: string, onTick: real -> unit) -> string

@sysl("avintest.digits.framed", named)
framedTitle(title: string) -> string

@sysl("avintest.digits.framed", named)
framedEvery(title: string, width: int, height: int, label: string, scale: real, onTick: real -> unit) -> string

// Listed in another order than the Sysl function's.
@sysl("avintest.digits.framed", named)
framedBackwards(scale: real, label: string, title: string) -> string

// An Avin default is the Avin caller's: Sysl is always given it.
@sysl("avintest.digits.framed", named)
framedAvinDefault(title: string, label: string = "avin") -> string

@sysl("avintest.digits.stamped", named)
stamped(text: string) -> string

@sysl("avintest.digits.stamped", named)
stampedAt(text: string, stamp: long) -> string

@sysl("avintest.digits.stamps")
stamps() -> long

// Avin overloads, each reaching one of the Sysl function's own overloads by its argument's type.
@sysl("avintest.digits.scaled", named)
scaled(x: long) -> long

@sysl("avintest.digits.scaled", named)
scaled(x: real) -> real

@sysl("avintest.digits.scaled", named)
scaled(x: long, by: long) -> long

@sysl("avintest.digits.waited", blocking, named)
waited(x: long, plus: long) -> long

@sysl("avintest.digits.joined", named)
joinedC(a: string, c: string) -> string

@sysl("avintest.digits.joined", named)
joinedB(b: string, a: string) -> string

// Positional, as every binding without `named` is.
@sysl("avintest.digits.joined")
joinedPositional(a: string, b: string) -> string

@sysl("avintest.digits.Tally")
class Tally
  @sysl(named)
  addTimes(n: long, extra: long) -> long
  @sysl("add_times", named)
  addOnce(n: long) -> long

@sysl("avintest.digits.new_tally")
newTally(n: long) -> Tally

main()
  var ticks = 0.0
  println(framedOnFrame("ticked", dt -> ticks = ticks + dt))
  println(ticks)
  println(framedTitle("plain"))
  println(framedEvery("every", 1, 2, "all", 0.1, dt -> ()))
  println(framedBackwards(2.0, "back", "wards"))
  println(framedAvinDefault("avin"))
  println(framedAvinDefault("given", "mine"))
  println(framedTitle("ünïcödé ✓"))
  println(framedTitle(""))
  // Each call that leaves `stamp` out has Sysl make a fresh one; one that passes it makes none.
  println(stamped("a"))
  println(stamped("b"))
  println(stampedAt("c", 99))
  println(stamps())
  println(stamped("d"))
  val n: long = 21
  println(scaled(n))
  println(scaled(3.0))
  println(scaled(7, 3))
  println(waited(1, 2))
  println(joinedC("a", "c"))
  println(joinedB("b", "a"))
  println(joinedPositional("x", "y"))
  val t = newTally(10)
  println(t.addTimes(5, 1))
  println(t.addOnce(4))
