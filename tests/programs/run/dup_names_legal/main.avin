// expect: exit 0
// Functions of one name and different parameter types overload one another across the files of a
// module, and two modules may each declare a type, a function and a value of one name.
import geo
import text

main() =
  println(parse("12") + parse(3))
  println(geo.Filter(4).width)
  println(text.Filter("ab").label)
  println(geo.limit)
  println(text.limit)
  println(geo.measure(2))
  println(text.measure(2))
