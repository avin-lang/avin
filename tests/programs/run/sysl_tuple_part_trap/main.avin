// expect: trap
// An integer part of a tuple that does not fit the type the binding declares for it traps where the
// tuple is converted, rather than arriving truncated, inside a collection as anywhere.

@sysl("avintest.digits.wide_pair")
widePair(n: long) -> (int, i8)

@sysl("avintest.digits.maybe_pair")
maybePair(n: long) -> Option[(string, i8)]

main()
  println(widePair(127))
  println(maybePair(5))
  println(widePair(128))
