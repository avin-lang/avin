package { name = "c-direct-handle-release", version = "0.1.0" }

// The handle classes of tests/c/handles, whose C library the test harness builds from tests/c and
// names to `pkg-config`.
dependencies {
  fixture-handles { path = "../../../c/handles" }
}

c-libraries {
  arrays { pkg-config = "avin-c-fixture", headers = ["avin_arrays.h", "avin_handles.h"], install = "the test harness builds it from tests/c" }
}
