// expect: trap
// `close()` is a use like any other: closing a handle another thread owns, having taken it from a
// channel and used it, while that thread runs, stops the program, and the handle keeps its value.
import avin.threads.{Channel, spawn}

@sysl("avintest.digits.Tally")
class Tally
  get() -> long

@sysl("avintest.digits.new_tally")
newTally(n: long) -> Tally

main()
  val mine = newTally(2)
  val handed = Channel[Tally]()
  val used = Channel[unit]()
  val done = Channel[unit]()
  spawn(() ->
    _ = handed.receive().get.get()
    used.send(())
    done.receive())
  handed.send(mine)
  _ = used.receive()
  println("handed over")
  mine.close()
