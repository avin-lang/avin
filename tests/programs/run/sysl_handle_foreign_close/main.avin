// expect: trap
// `close()` is a use like any other: closing a handle another thread owns, while that thread runs,
// stops the program, and the handle keeps its value.
import avin.threads.{Channel, spawn}

@sysl("avintest.digits.Tally")
class Tally
    get() -> long

@sysl("avintest.digits.new_tally")
newTally(n: long) -> Tally

main()
    val made = Channel[Tally]()
    val done = Channel[unit]()
    spawn(() ->
        made.send(newTally(2))
        done.receive())
    val theirs = made.receive().get()
    println("received")
    theirs.close()
