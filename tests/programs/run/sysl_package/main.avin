// Bindings to a Sysl package other than Sysl's standard library: the manifest names the package in
// `sysl-dependencies`, and every kind of value a binding carries crosses to it and back. The
// standard library is still reached beside it.

@sysl("avintest.digits.digit_count")
digitCount(n: long) -> int

@sysl("avintest.digits.digit_sum")
digitSum(n: int) -> int

@sysl("avintest.digits.shift")
shift(x: real, places: int) -> real

@sysl("avintest.digits.is_digit")
isDigit(c: char) -> bool

@sysl("avintest.digits.digit_char")
digitChar(d: int) -> char

@sysl("avintest.digits.without_digits")
withoutDigits(text: string) -> string

@sysl("avintest.digits.checksum")
checksum(bytes: Array[byte]) -> byte

// Narrower integers cross to the package as they do to the standard library.
@sysl("avintest.digits.digit_sum")
digitSumNarrow(n: i16) -> int

@sysl("avintest.digits.say")
say(text: string)

@sysl("sysl.text.to_upper")
upper(s: string) -> string

main()
  println(s"${digitCount(0)} ${digitCount(-12345)} ${digitCount(9000000000)}")
  println(s"${digitSum(1907)} ${digitSum(-46)} ${digitSumNarrow(999)}")
  println(s"${shift(1.5, 2)} ${shift(250.0, -1)}")
  println(s"${isDigit('7')} ${isDigit('x')} ${digitChar(4)} ${digitChar(12)}")
  println(s"[${withoutDigits("a1b22c333")}] [${withoutDigits("")}] [${upper(withoutDigits("route 66"))}]")
  val bytes = Array.fill(3, byte(0x90))
  println(s"${checksum(bytes)} ${checksum(Array.fill(0, byte(0)))}")
  // The package's standard output is the program's, so the writes stay in order.
  say("from the package")
  println("then Avin")
  // A binding to the package is a function like any other.
  val f: int -> char = digitChar
  println(s"${f(9)}")
