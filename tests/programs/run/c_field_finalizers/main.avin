// expect: exit 0
// Handles passed through `as:` conversions and handles read from fields, never closed, are given back
// by the collector's finalizer exactly once: 10,000 derived objects used through each conversion and
// dropped, middles lent by their derived, derived objects kept by a holder through a conversion, and
// records whose fields lend the records and bases they point at, every one given back with nothing
// freed twice. The corpus runs this with the collector at every allocation, at -O0 and -O2.
import fields.{Counts, bases, holder, holders, link, newBase, newDerived, newRecord, records, valueOfDerived}

line(c: Counts) -> string = s"${c.created} ${c.retained} ${c.released} ${c.freed}"

// Allocates until every object of `counts` has been freed, or gives up after a bound.
settle(counts: () -> Counts) -> bool
    var n = 0
    while counts().freed < counts().created && n < 1000000
        val v = [n, n + 1]
        n += v(1) - v(0)
    counts().freed == counts().created

converted(i: int) -> int
    val d = newDerived(i, 1, 2)
    d.value() + valueOfDerived(d) + d.extra() + d.baseValue() - d.moreField()

middled(i: int) -> int = newDerived(i, 0, 0).middle().value()

held(i: int) -> int = holder(newDerived(i, 0, 0)).peek()

read(i: int) -> int
    val r = newRecord()
    link(r, Some(newRecord()), Some(newBase(i)), Some(newDerived(i, 0, 3)))
    r.base().get().value() + r.derived().get().more() + r.mustNext().value(1) + r.value(4)

main()
    var sum: long = 0
    for i in 0..<10000
        sum += long(converted(i))
    println(sum)
    println(settle(() -> bases()))
    println(line(bases()))
    for i in 0..<1000
        sum += long(middled(i)) + long(held(i))
    println(settle(() -> bases()))
    println(settle(() -> holders()))
    println(line(bases()))
    println(line(holders()))
    for i in 0..<1000
        sum += long(read(i))
    println(settle(() -> records()))
    println(settle(() -> bases()))
    println(line(records()))
    println(line(bases()))
    println(sum)
