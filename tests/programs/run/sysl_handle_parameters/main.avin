// expect: exit 0
// A Sysl handle goes back into Sysl as a parameter, of a top-level binding or of another handle's
// method, as well as the receiver of its own methods. A type with a destructor is passed as the
// counted reference the handle holds, so what Sysl does to it the handle sees; one without is passed
// as the Sysl parameter takes it, by value or as a pointer to the handle's own value. A binding's
// result may be a collection of handles, also in an `Option` or a `Result`, each element a handle of
// its own, given back by `close()` or by the collector.

@sysl("avintest.digits.Tally")
class Tally
    add(n: long)
    get() -> long
    // A handle's method taking another handle of its own type.
    absorb(other: Tally)

@sysl("avintest.digits.new_tally")
newTally(n: long) -> Tally

@sysl("avintest.digits.given_back")
givenBack() -> long

@sysl("avintest.digits.sum_of")
sumOf(a: Tally, b: Tally) -> long

@sysl("avintest.digits.bump")
bump(t: Tally)

@sysl("avintest.digits.tallies")
tallies(n: long) -> Vector[Tally]

@sysl("avintest.digits.tallies")
tallyArray(n: long) -> Array[Tally]

@sysl("avintest.digits.maybe_tallies")
maybeTallies(n: long) -> Result[Vector[Tally], string]

@sysl("avintest.digits.Mark")
class Mark
    place() -> long

@sysl("avintest.digits.mark_at")
markAt(n: long) -> Mark

@sysl("avintest.digits.distance")
distance(a: Mark, b: Mark) -> long

@sysl("avintest.digits.nudge")
nudge(m: Mark)

@sysl("avintest.digits.marks")
marks(n: long) -> Option[Vector[Mark]]

@sysl("avintest.digits.Ledger")
class Ledger
    // Methods of one handle taking handles of two other types.
    record(t: Tally)
    mark(m: Mark)
    summary() -> long

@sysl("avintest.digits.new_ledger")
newLedger() -> Ledger

// A handle passed through an Avin function before it reaches Sysl.
total(t: Tally) -> long = sumOf(t, t) / 2

main()
    val a = newTally(3)
    val b = newTally(4)
    println(sumOf(a, b))
    bump(a)
    println(s"${a.get()} ${total(a)}")
    a.absorb(b)
    a.absorb(a)
    println(s"${a.get()} ${b.get()}")
    // Marks are values: `distance` takes copies, `nudge` a pointer to the handle's own value.
    val m = markAt(10)
    val n = markAt(25)
    println(distance(m, n))
    nudge(m)
    nudge(m)
    println(s"${m.place()} ${distance(m, n)}")
    val book = newLedger()
    book.record(a)
    book.record(b)
    book.mark(n)
    println(book.summary())
    // Collections of handles, each element its own handle on its own Sysl value.
    val ts = tallies(5)
    var sum: long = 0
    for t in ts
        sum = sum + t.get()
    println(s"${ts.length()} $sum")
    ts(2).add(40)
    println(s"${ts(2).get()} ${ts(3).get()} ${ts(2) == ts(3)}")
    val arr = tallyArray(3)
    println(s"${arr.length()} ${arr(2).get()}")
    println(tallies(0).length())
    maybeTallies(4) match
        Ok(v) -> println(s"ok ${v.length()} ${v(3).get()}")
        Err(e) -> println(s"err $e")
    maybeTallies(-1) match
        Ok(v) -> println(s"ok ${v.length()}")
        Err(e) -> println(s"err $e")
    println(marks(0).isEmpty())
    marks(3) match
        Some(v) -> println(s"${v.length()} ${distance(v(0), v(2))}")
        None -> println("no marks")
    // `close()` gives one element's value back, and the others stay.
    val before = givenBack()
    ts(0).close()
    ts(0).close()
    println(s"${givenBack() - before} ${ts(1).get()}")
    for t in ts
        t.close()
    println(givenBack() - before)
    // Elements nothing holds any longer are collected, each value given back by its finalizer.
    var collected = false
    for i in 0..<20000
        val many = tallies(10)
        many(9).add(1)
        if givenBack() - before > 1000 then collected = true
    println(collected)
