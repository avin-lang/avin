// expect: exit 0
// ignore: Sysl 0.9.0 binds the shim's generic helper to `T` where a `&T` is expected, so a control given a signal handle writes a copy of the signal; the next Sysl release settles it at the `&T`
// A control given a signal writes the application's own signal when it is tapped: the switch and
// the checkbox flip it, a radio sets its group's index, a slider the value under the pointer and a
// tab header the chosen tab.
import ui.{Rect, boolSignal, checkbox, intSignal, radio, radioGroup, realSignal, slider, switch, tabs, tap, text}

val Screen = Rect(0, 0, 400, 300)

main()
    val on = boolSignal(false)
    tap(switch(on).named("sw"), "sw", Screen)
    println(on.read())
    tap(switch(on).named("sw"), "sw", Screen)
    println(!on.read())
    tap(checkbox(on, "Check").named("cb"), "cb", Screen)
    println(on.read())
    val chosen = intSignal(0)
    tap(radio(chosen, 2, "Two").named("two"), "two", Screen)
    println(chosen.read() == 2)
    tap(radioGroup(["Red", "Green", "Blue"], chosen), "@1", Screen)
    println(chosen.read() == 0)
    tap(radioGroup(["Red", "Green", "Blue"], chosen), "@3", Screen)
    println(chosen.read() == 2)
    val level = intSignal(0)
    tap(slider(level, 0, 100, 200).named("level"), "level", Screen)
    println(0 < level.read() < 100)
    val gain = realSignal(0.0)
    tap(slider(gain, 0.0, 1.0, 200).named("gain"), "gain", Screen)
    println(0.0 < gain.read() < 1.0)
    val stepped = intSignal(0)
    tap(slider(stepped, 0, 100, 200, step = 30).named("stepped"), "stepped", Screen)
    println(stepped.read() % 30 == 0 && stepped.read() > 0)
    val tab = intSignal(0)
    tap(tabs(["One", "Two", "Three"], tab, i -> text(s"body $i")), "@3", Screen)
    println(tab.read() == 2)
