// expect: exit 0
// A handle on a Sysl trait holds a trait object: it is made by the bindings that return one, and
// its methods, a trait's own default among them, are bound as a struct handle's are. It is passed
// back as a parameter, by a call that waits too, returned by itself, in an `Option`, a tuple and a
// collection, given to a callback, held in a mirror's field, kept in Avin's collections and objects, closed, and given
// back by the collector.
import avin.collections.mutable.{Map as MutableMap}

@sysl("avintest.views.View")
class View
  describe() -> string
  padding(n: int) -> View
  label() -> string = s"<${describe()}>"

@sysl("avintest.views.text")
text(s: string) -> View

@sysl("avintest.views.marked")
marked(id: int) -> View

@sysl("avintest.views.marks_back")
marksBack() -> long

@sysl("avintest.views.same")
same(v: View) -> View

@sysl("avintest.views.same", blocking)
sameWhileSafe(v: View) -> View

@sysl("avintest.views.maybe_text")
maybeText(s: string) -> Option[View]

@sysl("avintest.views.pair_of")
pairOf(a: View, b: View) -> (View, View)

@sysl("avintest.views.texts")
texts(n: int) -> Vector[View]

@sysl("avintest.views.children_of")
childrenOf(v: View) -> Array[View]

@sysl("avintest.views.Framed")
data Framed(view: View, label: string)

@sysl("avintest.views.framed")
framed(v: View, label: string) -> Framed

@sysl("avintest.views.frame_text")
frameText(f: Framed) -> string

@sysl("avintest.views.visit")
visit(v: View, f: (View) -> string) -> string

class Card(val view: View, val title: string)

main()
  // Made, and its methods called, the trait's default method answering a handle of its own.
  val t = text("hello")
  println(t.describe())
  println(t.padding(4).describe())
  println(t.padding(1).padding(2).describe())
  println(t.label())
  // Unicode and the empty string pass through unchanged.
  println(text("").describe())
  println(text("héllo, 世界").describe())
  // Passed back, by itself and while the thread is safe for the collector.
  println(same(t).describe())
  println(sameWhileSafe(t.padding(3)).describe())
  println(same(same(same(t))).describe())
  // Returned in an option, a tuple and collections.
  println(maybeText("x").map(v -> v.describe()))
  println(maybeText("").map(v -> v.describe()))
  val (a, b) = pairOf(t, text("b"))
  println(s"${a.describe()} ${b.describe()}")
  val many = texts(3)
  println(many.map(v -> v.describe()))
  println(texts(0).length)
  val kids = childrenOf(t.padding(2))
  println(kids.length)
  println(kids(0).describe())
  println(kids(1).describe())
  // A callback is given trait handles of its own.
  var seen: Vector[View] = []
  println(visit(t, v ->
    seen = seen :+ v
    v.padding(2).describe()))
  println(seen.map(v -> v.describe()))
  // A mirror's field, in each direction.
  val f = framed(t, "title")
  println(f.label)
  println(f.view.describe())
  println(frameText(Framed(text("in"), "made")))
  println(frameText(f))
  // Kept in Avin's collections and objects.
  var list: List[View] = List()
  for i in 0 ..< 5
    list = text(s"item$i") :: list
  println(list.map(v -> v.describe()))
  val byName = Map(("a", text("A")), ("b", text("B").padding(1)))
  println(byName("b").describe())
  val built = MutableMap[int, View]()
  for i in 0 ..< 3
    built(i) = text(s"m$i")
  println(built(2).describe())
  val card = Card(text("card"), "c")
  println(s"${card.title}: ${card.view.describe()}")
  val nested = Vector(Vector(text("x")), Vector(text("y"), text("z")))
  println(nested.flatMap(row -> row.map(v -> v.describe())))
  // `close()` gives the trait object back, once; the value goes when its last share does.
  val before = marksBack()
  val m = marked(1)
  println(m.describe())
  m.close()
  m.close()
  println(marksBack() - before)
  val kept = marked(2)
  val again = same(kept)
  kept.close()
  println(marksBack() - before)
  println(again.describe())
  again.close()
  println(marksBack() - before)
  // A trait handle never closed is given back by the collector.
  val start = marksBack()
  var i = 0
  while marksBack() - start <= 1000 && i < 100000
    val x = marked(i)
    x.padding(1)
    Array.fill(64, i)
    i += 1
  println(marksBack() - start > 1000)
