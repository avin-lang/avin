// expect: exit 0
// JSON read on lightweight threads: eight at once, each reading and writing its own documents, a
// value handed back from a thread through `join`, and the deepest nesting the default limit allows
// read on a thread's own stack.
import json
import json.Json
import avin.threads as threads

main()
    val workers = (0..<8).map(t -> threads.spawn(() ->
        var sum: long = 0
        for i in 0..<50
            val j = json.parse(s"{\"t\": $t, \"i\": $i, \"xs\": [$t, $i, \"é\"]}").ok().get()
            sum += j("t").asLong().get() + j("xs")(1).asLong().get()
        sum)).toVector
    println(workers.map(w -> w.join()).foldLeft(long(0), (a, b) -> a + b))
    val made = threads.spawn(() -> json.parse("{\"made\": [\"on\", \"a\", \"thread\"]}").ok().get())
    println(made.join())
    val depth = threads.spawn(() -> json.parse("[".repeat(512) + "]".repeat(512)).isOk())
    println(depth.join())
