// expect: trap
// A call that waits converts its integer parameters while its thread is safe for the collector, and
// one that does not fit stops the program where the binding was called, as any call does.

@sysl("avintest.digits.show_u32_after", blocking)
showU32After(ms: int, x: long) -> string

main()
    println(showU32After(1, 3))
    println(showU32After(65536, 3))
