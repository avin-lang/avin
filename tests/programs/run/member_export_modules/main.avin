// expect: exit 0
// A class's exports serve other modules: a wildcard presents the wrapped class's public members
// and the shop's own `report` comes first; an export by name renames one. A forwarded call is the
// call written where it is used, so an extension method of the wrapped type is reached through a
// wildcard where the file sees the extension.
import store.{Ledger, Shop, Till}
import words

main()
  val shop = Shop(Ledger(1))
  shop.add(4)
  println(shop.total)
  println(shop.report())
  println(shop.doubled())
  val till = Till(Ledger(10))
  till.ring(5)
  println(till.total)
