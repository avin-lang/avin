module store

// A ledger whose members another module's class presents.
class Ledger(var total: int)
  add(n: int) = total += n
  private audit() -> int = total * 100
  report() -> string = s"ledger at $total"

// A shop presenting its ledger's public members, its private field kept private.
class Shop(ledger: Ledger)
  export ledger.*
  report() -> string = "shop: " + ledger.report()

// A shop presenting one member by name, under a name of its own.
class Till(ledger: Ledger)
  export ledger.{add as ring, total}
