// A mirror's methods without a body, in an `impl` of the mirror, are bound to the Sysl methods of the
// value it mirrors: each call converts the receiver into that value, calls the Sysl method on it,
// and converts what it answers back. The Sysl method takes its receiver by value (`kind`, `moved`,
// `even`), through a borrow (`describe`, `scaled_by`, `digit_bytes`), or through a pointer (`bump`),
// which moves the copy the call made and leaves the mirror as it was.

@sysl("avintest.digits.Verdict")
data Verdict(code: long, note: string)

@sysl("avintest.digits.Kind")
data Kind
  Small
  Negative
  Large(code: long)

@sysl("avintest.digits.Tally")
class Tally
  get() -> long

@sysl("avintest.digits.verdict_on")
verdictOn(n: long) -> Verdict

impl Verdict
  // Bound to the Sysl method of its own name.
  kind() -> Option[Kind]
  describe() -> string
  even() -> bool
  // `digitBytes` is Sysl's `digit_bytes`.
  digitBytes() -> Array[byte]
  // A method answering the mirror itself.
  moved(n: long) -> Verdict
  // Overloads by parameter type, each bound to the Sysl method its `@sysl` names.
  @sysl("scaled_by")
  scaled(by: int) -> long
  @sysl("scaled_by_fraction")
  scaled(by: real) -> long
  bump() -> long
  @sysl("code_after_wait", blocking)
  codeAfterWait() -> long
  // A `Result` holding the mirror, a handle, and arguments passed by name.
  checked(limit: long) -> Result[Verdict, string]
  tally() -> Tally
  @sysl(named)
  framed(right: string) -> string
  // A method with a body calls the bound ones as any other method.
  summary() -> string = s"${describe()} even=${even()} kind=${kindName(kind())}"

impl Kind
  weight() -> int
  worse() -> Option[Kind]

impl Display for Verdict
  display(out: Writer, spec: FormatSpec) = out.writeField(describe(), spec)

kindName(k: Option[Kind]) -> string = k match
  Some(Small) -> "Small"
  Some(Negative) -> "Negative"
  Some(Large(c)) -> s"Large($c)"
  None -> "none"

// The bound method reached from generic code, through a trait and through a closure.
shown[T: Display](x: T) -> string = s"[$x]"

applied[T, R](x: T, f: (T) -> R) -> R = f(x)

main()
  val v = Verdict(7, "seven")
  println(v.summary())
  println(v.describe())
  println(kindName(Verdict(0, "zero").kind()))
  println(kindName(Verdict(-5, "minus").kind()))
  println(kindName(Verdict(1001, "big").kind()))
  // The extremes of a long cross both ways.
  println(kindName(Verdict(9223372036854775807, "max").kind()))
  println(kindName(Verdict(-9223372036854775807 - 1, "min").kind()))
  // An empty note, and one outside ASCII.
  println(Verdict(1, "").describe())
  println(Verdict(2, "naïve ✓ 日本").describe())
  println(v.even())
  println(Verdict(8, "eight").even())
  println(v.digitBytes().length)
  println(Verdict(12345, "d").digitBytes().length)
  val w = v.moved(10)
  println(s"${w.code} ${w.note} ${v.code}")
  println(v.moved(-7).kind() is None)
  println(v.scaled(3))
  println(v.scaled(0.5))
  // A Sysl method through a pointer moves the call's own copy; the mirror is a value, unchanged.
  println(v.bump())
  println(v.bump())
  println(v.code)
  println(v.codeAfterWait())
  println(v.checked(10).map(x -> x.describe()))
  println(v.checked(6).isErr)
  println(v.tally().get())
  println(v.framed("]"))
  // A value a binding made has the methods too.
  println(verdictOn(42).describe())
  // A bound method answering a bound enum, whose own bound methods are called on what it answers.
  println(Small.weight())
  println(Large(5).weight())
  println(Large(2000000).weight())
  println(Verdict(-1, "x").kind().map(k -> k.weight()))
  println(kindName(Small.worse()))
  println(kindName(Negative.worse()))
  println(kindName(Large(1).worse()))
  println(shown(v))
  println(applied(v, x -> x.describe()))
  val bound = (n: long) -> Verdict(n, "c").scaled(2)
  println(bound(21))
  // Many calls, each converting a receiver and the answer, while the collector runs.
  var total: long = 0
  var text = 0
  for i in 0 ..< 20000
    val x = Verdict(long(i), s"n$i")
    total += x.moved(1).code
    text += x.describe().byteLength
  println(s"$total $text")
