// expect: exit 0
// env: AVIN_C_STRINGS_GREETING=grüß dich 😀
// The C library's and zlib's string functions, bound directly: `strlen` takes a string, `getenv`
// answers one C keeps or null, `strerror` one C keeps, `strchr` and `strstr` a pointer into the
// string they were passed, or null, `strdup` one the binding frees with the C library's own `free`,
// and `zlibVersion` zlib's.

@c("size_t strlen(const char *s)")
strlen(s: string) -> long
@c("char *getenv(const char *name)")
getenv(name: string) -> Option[string]
@c("char *strerror(int errnum)")
strerror(n: int) -> string
@c("char *strchr(const char *s, int c)")
strchr(s: string, c: int) -> Option[string]
@c("char *strstr(const char *haystack, const char *needle)")
strstr(haystack: string, needle: string) -> Option[string]
@c("char *strdup(const char *s)", free: "free")
strdup(s: string) -> string
@c("int strcmp(const char *a, const char *b)")
strcmp(a: string, b: string) -> int
@c("const char *zlibVersion(void)")
zlibVersion() -> string

private show(o: Option[string]) -> string = o match
    Some(s) -> "Some(" + s + ")"
    None -> "None"

main()
    println(s"strlen ${strlen("")} ${strlen("abc")} ${strlen("é€😀")}")
    println(s"getenv ${show(getenv("AVIN_C_STRINGS_GREETING"))} ${show(getenv("AVIN_C_STRINGS_SURELY_UNSET"))} ${show(getenv(""))}")
    println(s"strerror ${strerror(2)}")
    println(s"strchr ${show(strchr("key=value", int('=')))} ${show(strchr("key", int('=')))} ${show(strchr("abc", 0))}")
    println(s"strstr ${show(strstr("a needle in it", "needle"))} ${show(strstr("hay", "needle"))} ${show(strstr("hay", ""))}")
    println(s"strdup ${strdup("")} ${strdup("dup 😀")}")
    println(s"strcmp ${strcmp("a", "b") < 0} ${strcmp("b", "a") > 0} ${strcmp("é", "é")}")
    val version = zlibVersion()
    println(s"zlib ${version.startsWith("1.")} ${version.contains(".")}")
    var n: long = 0
    for i in 0..<3000
        n += strlen(strdup("x".repeat(i % 50)))
    println(s"loop $n")
