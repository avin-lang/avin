// expect: exit 0
// Exports chain: `top` exports what `mid` exports from `base`, and each name reaches the declaration
// at the end of the chain, so values made through any link are of one type. An import through an
// export brings in the extensions of the module that declares the name; `top` and `mid` export each
// other's declarations without looping.
import top.{Token, Text, Number, Stop, Named, Bag, Box, firstOf, lengthOf, Front, Back}
import base.Token
import base
import mid
import top

main()
    val tokens: Vector[Token] = [Text("hey"), Number(9), Stop, base.Word("x"), mid.Stop]
    for t in tokens
        println(t.name())
    val n: Named = Text("named")
    println(n.name())
    println(lengthOf(mid.Word("four")))
    println(tokens(0) == base.Word("hey"))
    val bag: Bag[int] = [3, 4]
    println(firstOf(bag))
    val none: base.Bag[string] = []
    println(firstOf(none))
    val b: base.Box[string] = Box("boxed")
    println(b.get())
    // A module-level `var`, assigned through each path.
    top.hits = 5
    mid.hits += 1
    base.hits += 1
    println(base.hits)
    println("loud".shout())
    println(Front("f").label)
    println(mid.Front("g"))
    println(Back(3))
    println(loudly("chained"))
    println(framed("framed"))
    println(mid.shouted(Number(1)))
