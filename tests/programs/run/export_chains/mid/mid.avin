module mid

// The first link of a chain, renaming one declaration and importing another it also exports: two
// paths to one declaration, and no clash.
import base.Token
export base.{Token, Word, Number, End as Stop, Named, Bag, Box, firstOf, hits}

// The module's own code reaches an exported type's variants through the type, by the export's name.
lengthOf(t: Token) -> int = t match
    Token.Word(s) -> s.charCount()
    _ -> 0

// `Back` is declared here and exported by `top`, which `mid` exports from in turn: two modules
// exporting each other's declarations is no cycle.
export top.Front

data Back(n: int)

// `mid` exports declarations of `base`, so its own files see `base`'s extensions without an import.
shouted(t: Token) -> string = t.name().shout()
