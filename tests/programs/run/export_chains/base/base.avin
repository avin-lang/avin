module base

trait Named
    name() -> string

data Token
    Word(text: string)
    Number(value: long)
    End

impl Named for Token
    name() -> string = self match
        Word(t) -> t
        Number(v) -> s"#$v"
        End -> "end"

type Bag[T] = Vector[T]

class Box[T](val item: T)
    get() -> T = item

firstOf[T](xs: Bag[T]) -> Option[T] = if xs.length() == 0 then None else Some(xs(0))

var hits: int = 0

// An extension: seen by a file importing this module, or any declaration of it, however reached.
impl string
    shout() -> string = self + "!"
