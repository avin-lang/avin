// expect: exit 0
// A function passed to a `@threaded` parameter may be called by any thread: Sysl keeps it and other
// Avin threads call it, many at once, each running it with its own context; and a thread Sysl
// started itself, which the program never did, is attached for the call. What the function captures
// is sendable: `val`s of immutable types, an object of a class with no `var`, a parameter, or
// nothing at all.
import avin.threads.spawn

@sysl("avintest.callbacks.share")
share(@threaded f: (int) -> int)

@sysl("avintest.callbacks.call_shared")
callShared(x: int) -> int

@sysl("avintest.callbacks.forget_shared")
forgetShared()

// A call that waits for a thread of Sysl's own is blocking, so the collections the callback makes
// there need not wait for it.
@sysl("avintest.callbacks.apply_on_thread", blocking)
applyOnThread(@threaded f: (int) -> int, x: int) -> int

@sysl("avintest.callbacks.call_shared_on_thread", blocking)
callSharedOnThread(x: int) -> int

@sysl("avin.rt.callbacks_held")
held() -> long

class Scale(factor: int)
    times(x: int) -> int = x * factor

triple(x: int) -> int = x * 3

// A parameter captured by the function shared.
shareOffset(offset: int) = share(x -> x + offset)

main()
    val words = ["one", "two", "three"]
    val name = "añ"
    share(x -> x + words.length() + name.byteLength())
    println(callShared(10))
    // Called by other Avin threads, each allocating as it runs the function.
    val threads = [0, 1, 2, 3].map(t -> spawn(() ->
        var total = 0
        for i in 0..<200
            total += callShared(i) + s"$i".byteLength()
        total))
    for t in threads do println(t.join())
    forgetShared()
    // A method value of an immutable object, a top-level function, and a captured parameter.
    share(Scale(7).times)
    println(spawn(() -> callShared(6)).join())
    forgetShared()
    share(triple)
    println(callShared(5))
    forgetShared()
    shareOffset(100)
    println(spawn(() -> callShared(1)).join())
    // Called on a thread of Sysl's own: attached for the call, and detached after.
    println(callSharedOnThread(2))
    forgetShared()
    println(applyOnThread(x -> s"$x".byteLength() + words.length(), 12345))
    spellOut(x: int) -> int
        var text = ""
        for i in 0..<x
            text = text + s"$i,"
        text.byteLength()
    println(applyOnThread(spellOut, 50))
    println(held())
