// expect: exit 0
// A `Vector` or an `Array` of handles passed to Sysl becomes a slice of the handles' Sysl values,
// each element checked as a handle passed by itself is and shared for the call: a vector as a `[]T`,
// an array as a `[]const T`, the elements counted references, values or pointers as the Sysl
// parameter takes them. Collections of none, one and a thousand cross, the same handle more than
// once, through a handle's own method, a call that waits and a callback; Sysl keeps its shares, so
// what it holds outlives the Avin collection and a closed handle. Trees are built by Avin recursion
// and by Sysl calling back, and a slice or a `Buf` of handles comes back as a vector.

@sysl("avintest.views.View")
class View
  describe() -> string
  padding(n: int) -> View

@sysl("avintest.views.text")
text(s: string) -> View

@sysl("avintest.views.column")
column(children: Vector[View], spacing: int) -> View

@sysl("avintest.views.column", blocking)
columnWhileSafe(children: Vector[View], spacing: int) -> View

@sysl("avintest.views.column_reading")
columnReading(children: Array[View]) -> View

@sysl("avintest.views.count")
count(children: Vector[View]) -> int

@sysl("avintest.views.describe_all")
describeAll(children: Vector[View]) -> string

@sysl("avintest.views.texts")
texts(n: int) -> Vector[View]

@sysl("avintest.views.children_of")
childrenOf(v: View) -> Vector[View]

@sysl("avintest.views.column_of")
columnOf(make: (int) -> View, n: int) -> View

@sysl("avintest.views.render")
render(tree: () -> View, n: int) -> string

@sysl("avintest.views.Stack")
class Stack
  pushAll(views: Vector[View])
  @sysl("push_all", blocking)
  pushAllWhileSafe(views: Vector[View])
  size() -> int
  describe() -> string

@sysl("avintest.views.stack")
stack() -> Stack

@sysl("avintest.views.Counter")
class Counter
  bump() -> unit
  get() -> int

@sysl("avintest.views.counter")
counter() -> Counter

@sysl("avintest.views.counter_sum")
counterSum(counters: Vector[Counter]) -> int

@sysl("avintest.views.counter_sum_at")
counterSumAt(counters: Vector[Counter]) -> int

@sysl("avintest.views.counter_sum_at", blocking)
counterSumAtWhileSafe(counters: Vector[Counter]) -> int

// A tree of columns `depth` deep, each holding two smaller trees and a leaf.
tree(depth: int) -> View =
  if depth == 0 then text("leaf")
  else column([tree(depth - 1), text(s"d$depth"), tree(depth - 1)], depth)

// How many leaves `tree(depth)` has.
leaves(depth: int) -> int = if depth == 0 then 1 else 2 * leaves(depth - 1)

main()
  // None, one and many.
  println(count([]))
  println(column([], 0).describe())
  println(count([text("one")]))
  println(column([text("one")], 7).describe())
  val thousand = Vector.tabulate(1000, i -> text(s"$i"))
  println(count(thousand))
  println(describeAll(thousand).byteLength)
  println(describeAll(thousand.drop(997)))
  println(count(texts(1000)))
  println(count(texts(0)))
  // The same handle more than once, and nested handles.
  val a = text("a")
  println(describeAll([a, a, a.padding(1), a]))
  // An array goes in as a slice Sysl may only read.
  val arr = Array.fill(3, a)
  arr(1) = text("b")
  println(columnReading(arr).describe())
  println(columnReading(Array.fill(0, a)).describe())
  // A call that waits.
  println(columnWhileSafe([a, text("safe")], 2).describe())
  // Sysl keeps its shares: the column outlives the vector it was made from, and a handle closed.
  val kept = text("kept")
  val c = column([kept, text("temporary")], 1)
  kept.close()
  for i in 0 ..< 100
    Array.fill(16, i)
  println(c.describe())
  // A handle's method takes a collection.
  val s = stack()
  s.pushAll([a, text("x")])
  s.pushAll([])
  s.pushAll(thousand)
  s.pushAllWhileSafe([text("waited"), a])
  println(s.size())
  // Slices and buffers of handles come back as vectors, and go back in.
  println(describeAll(childrenOf(text("p").padding(2))))
  println(column(childrenOf(a) ++ texts(2), 0).describe())
  // Trees built by Avin recursion.
  println(tree(0).describe())
  println(tree(1).describe())
  println(tree(2).describe())
  val big = tree(8)
  println(big.describe().byteLength)
  println(leaves(8))
  // Trees built by Sysl calling back.
  println(columnOf(i -> column([text(s"r$i"), tree(1)], i), 3).describe())
  println(render(() -> column([text("built"), a], 0), 2))
  var n = 0
  val growing = () ->
    n += 1
    column(Vector.tabulate(n, i -> text(s"$i")), n)
  println(render(growing, 3))
  // Struct handles in collections reach a Sysl slice of values and of pointers.
  val counters = Vector.tabulate(5, i -> counter())
  for i in 0 ..< 5
    for j in 0 ..< i
      counters(i).bump()
  println(counterSum(counters))
  println(counterSumAt(counters))
  println(counterSumAtWhileSafe(counters))
  println(counterSum([]))
  println(counterSumAt([counters(4)]))
