// expect: trap
// A handle method's integer parameter is checked as a top-level binding's is.

@sysl("avintest.digits.Tally")
class Tally
  get() -> long
  addUnsigned(n: long)

@sysl("avintest.digits.new_tally")
newTally(n: long) -> Tally

main()
  val t = newTally(5)
  t.addUnsigned(1)
  println(t.get())
  t.addUnsigned(-1)
  println(t.get())
