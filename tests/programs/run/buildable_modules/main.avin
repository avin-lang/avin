// expect: exit 0
// A program's generic collection declared with its `Buildable` impl in one module is built by
// sequence, set, map, nested and empty literals in another, and through a bound.
import shelf.{Labels, Shelf, starter}

collect[C: Buildable[int]](n: int) -> C
  val b = C.newBuilder()
  for i in 1 .. n do b.addOne(i * 10)
  b.result()

main()
  val ints: Shelf[int] = [1, 2, 3]
  val set: Shelf[string] = {"x", "y"}
  val nested: Shelf[Shelf[int]] = [[1], [], [2, 3]]
  val empty: Shelf[real] = []
  val labels: Labels = {a: 1, b: 2}
  val none: Labels = {}
  println(ints.items)
  println(set.items)
  println(nested.items.map(_.items))
  println(empty.items.isEmpty)
  println(labels.text)
  println(none.text.isEmpty)
  println(starter().items)
  val tens: Shelf[int] = collect(3)
  println(tens.items)
  val shelves: Vector[Shelf[int]] = [[4], [5, 6]]
  println(shelves.map(_.items))
