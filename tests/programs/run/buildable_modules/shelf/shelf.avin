module shelf

// A generic collection with its builder and its `Buildable` conformance in its own module, built by
// literals written in another.
class Shelf[T](val items: Vector[T])

class ShelfBuilder[T]: Builder[T, Shelf[T]]
  private var items: Vector[T] = []

  override addOne(element: T)
    items = items :+ element

  override result() -> Shelf[T] = Shelf(items)

  override clear()
    items = []

impl[T] Buildable[T] for Shelf[T]
  static newBuilder() -> ShelfBuilder[T] = ShelfBuilder[T]()

// A collection of pairs, built by map literals in another module.
class Labels(val text: string)

class LabelsBuilder: Builder[(string, int), Labels]
  private var text = ""

  override addOne(element: (string, int))
    text = text + s"${element.0}:${element.1};"

  override result() -> Labels = Labels(text)

  override clear()
    text = ""

impl Buildable[(string, int)] for Labels
  static newBuilder() -> LabelsBuilder = LabelsBuilder()

// A literal written in the collection's own module.
starter() -> Shelf[string] = ["first"]
