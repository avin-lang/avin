// expect: trap
// A handle on a Sysl trait used by a thread while another owns it stops the program at the call,
// as a struct handle does: the thread that made it is still running, and hands it over through a
// channel, which does not move what it carries.
import avin.threads.{Channel, spawn}

@sysl("avintest.views.View")
class View
    describe() -> string

@sysl("avintest.views.text")
text(s: string) -> View

main()
    val mine = text("mine")
    val made = Channel[View]()
    val done = Channel[unit]()
    spawn(() ->
        made.send(text("theirs"))
        done.receive())
    val theirs = made.receive().get()
    println(mine.describe())
    println(theirs.describe())
