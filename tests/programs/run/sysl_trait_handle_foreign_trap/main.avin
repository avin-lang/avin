// expect: trap
// A handle on a Sysl trait used by a thread while another owns it stops the program at the call,
// as a struct handle does: the handle went through a channel to a thread that used it, so it is that
// thread's, and that thread is still running.
import avin.threads.{Channel, spawn}

@sysl("avintest.views.View")
class View
  describe() -> string

@sysl("avintest.views.text")
text(s: string) -> View

main()
  val mine = text("mine")
  val theirs = text("theirs")
  val handed = Channel[View]()
  val used = Channel[unit]()
  val done = Channel[unit]()
  spawn(() ->
    _ = handed.receive().get.describe()
    used.send(())
    done.receive())
  handed.send(theirs)
  _ = used.receive()
  println(mine.describe())
  println(theirs.describe())
