module shapes

// A package's one surface: declarations of its internal modules, presented as the package's own.
// Every kind of declaration is exported here: data types, a generic one, an alias, a class, an
// object, a trait, overloaded functions, a value and variants, one of them renamed.
export shapes.geometry.{Point, Pair, Path, distance, origin, Counter, Registry}
export shapes.color.{Color, Red, Blue as Navy}
export shapes.paint.Shape

// A declaration of the module itself names exported types by their bare names: an export is a name
// of the module, seen by each of its files.
centre(p: Point, q: Point) -> Point = Point((p.x + q.x) / 2, (p.y + q.y) / 2)
