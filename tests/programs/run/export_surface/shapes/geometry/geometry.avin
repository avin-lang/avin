module shapes.geometry

data Point(x: int, y: int)

data Pair[T](first: T, second: T)

type Path = Vector[Point]

// Overloads: an export of the name exports every one of them.
distance(a: Point, b: Point) -> int = gap(a.x, b.x) + gap(a.y, b.y)

distance(path: Path) -> int
    var total = 0
    for i in 1..<path.length()
        total += distance(path(i - 1), path(i))
    total

private gap(a: int, b: int) -> int = if a < b then b - a else a - b

val origin = Point(0, 0)

class Counter(var count: int)
    bump() -> int
        count += 1
        count

object Registry
    var hits = 0
