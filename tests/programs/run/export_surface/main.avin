// expect: exit 0
// A module's exports are reached as its own declarations: imported by name, renamed on import, or
// through the module imported whole. Each is the very declaration it presents, so a value made
// through the export is one of the declaring module's type, and the other way round.
import shapes
import shapes.{Point, Pair, Path, Color, Red, Navy, Shape, distance, origin, Counter, Registry as Reg}
import shapes.geometry

class Square(side: int): Shape
  override corner() -> Point = Point(side, side)

main()
  // A type: the same type whichever path names it.
  val p: Point = geometry.Point(1, 2)
  val q: geometry.Point = shapes.Point(4, 6)
  val r: shapes.Point = p
  println(r)
  println(p == geometry.Point(1, 2))
  // Overloads, all exported by one name.
  println(distance(p, q))
  val path: Path = [p, q, origin]
  println(distance(path))
  println(shapes.distance(p, q))
  // A value.
  println(origin)
  println(shapes.origin.x)
  // A generic data type, and `with` on one.
  val pair: Pair[Point] = Pair(p, q)
  println(pair with {second.y = 0})
  val ints = shapes.Pair(1, 2)
  println(ints with {first = 7})
  // A class and an object.
  val c = Counter(0)
  c.bump()
  println(c.bump())
  Reg.hits += 1
  shapes.Registry.hits += 1
  println(geometry.Registry.hits)
  // Variants, one renamed, in construction and in patterns.
  val colours: Vector[Color] = [Red, Navy(3), shapes.Color.Green]
  for k in colours
    println(k match
      Red -> "red"
      Navy(d) -> s"blue $d"
      Color.Green -> "green")
  // Patterns written through the module imported whole.
  for k in colours
    println(k match
      shapes.Red -> 0
      shapes.Navy(d) -> d
      shapes.Color.Green -> -1)
  println(shapes.warm(Red))
  println(shapes.warm(shapes.Navy(1)))
  // A trait: a class of this module implements it, and its default methods are seen.
  val s: Shape = Square(5)
  println(s.describe())
  println(s.tint() == Color.Green)
  // The exporting module's own declarations, which name exported types.
  println(shapes.centre(p, q))
  println(shapes.farthest([origin, q]))
