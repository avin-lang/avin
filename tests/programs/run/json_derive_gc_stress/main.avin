// expect: exit 0
// Derived encoders and decoders run under the collector at every allocation, at -O0 and -O2: values
// of a sum type, a generic type, a recursive type, maps, options and text beyond ASCII encoded,
// decoded and kept across rounds, in a vector and in closures, and decode errors with their paths.
import dev.avinlang.json
import dev.avinlang.json.Json
import dev.avinlang.json.JsonEncoder
import dev.avinlang.json.JsonDecoder
import dev.avinlang.json.JsonKey
import dev.avinlang.json.JsonTag

@JsonTag("op")
data Step derives JsonEncoder, JsonDecoder
    Push(value: long)
    @JsonKey("add") Add
    Call(name: string, args: Vector[Json])

data Program[A](name: string, steps: List[Step], meta: Option[A], labels: TreeMap[string, int]) derives JsonEncoder, JsonDecoder

data Tree(label: string, kids: Vector[Tree]) derives JsonEncoder, JsonDecoder

grow(depth: int, round: int) -> Tree =
    if depth == 0 then Tree(s"leaf $round é😀", []) else Tree(s"$depth", [grow(depth - 1, round), Tree("x", [])])

main()
    val kept = Buffer[Program[Tree]]()
    val checks = Buffer[() -> bool]()
    var bytes = 0
    for round in 0..<30
        val program = Program(s"p$round \"q\"", [Push(long(round)), Push(-9223372036854775807), Add, Call("f", [Json.num(1.5), Json.str("日本")])], Some(grow(4, round)), TreeMap(("a", round), ("b", -round)))
        val text = json.encode(program)
        bytes += text.byteLength
        val back = json.decode[Program[Tree]](text).ok.get
        if back != program then println(s"mismatch in round $round")
        kept.addOne(back)
        checks.addOne(() -> json.decode[Program[Tree]](text) == Ok(program))
        val broken = text.replace("\"leaf", "1, \"bad\":\"")
        if json.decode[Program[Tree]](broken).isOk then println(s"accepted broken text in round $round")
    println(kept.length, checks.toVector.forall(c -> c()), bytes > 0)
    println(json.encode(kept(0).steps))
    println(json.decode[Program[Tree]]("{\"name\":\"n\",\"steps\":[{\"op\":\"Push\",\"value\":\"7\"}],\"labels\":{}}").err.get)
    println(json.decode[Program[Tree]]("{\"name\":\"n\",\"steps\":[],\"meta\":{\"label\":\"r\",\"kids\":[{\"label\":2}]},\"labels\":{}}").err.get)
    println(json.decode[Program[int]]("{\"name\":\"n\",\"steps\":[{\"op\":\"add\"}],\"labels\":{\"z\":1}}").ok.get)
