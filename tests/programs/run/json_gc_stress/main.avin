// expect: exit 0
// JSON values read, taken apart, rebuilt and written under the collector running at every
// allocation: every kind of value, strings with escapes, surrogate pairs and text beyond ASCII,
// nesting, an error's message, and values held in closures and in a vector across reads.
import json
import json.Json

main()
    val text = "{\"id\": 9223372036854775807, \"name\": \"a\\\"b\\\\c\\n\\u00e9\\ud83d\\ude00 日本\", \"ok\": true, \"none\": null, \"xs\": [1, -2.5e-3, [], {}, [[\"deep\"]]], \"r\": 1e21}"
    val kept = Buffer[Json]()
    var total = 0
    for round in 0..<20
        val j = json.parse(text).ok().get()
        kept.addOne(j)
        total += j("xs").size()
        val rebuilt = j.with("round", Json.num(round)).with("name", Json.str(j("name").asString().get() + "!"))
        val back = json.parse(rebuilt.pretty()).ok().get()
        if back != rebuilt then println(s"mismatch in round $round")
    println(kept(0))
    println(kept(19) == kept(0), total)
    val names = kept.toVector().map(j -> () -> j("name").asString().get())
    println(names(7)().charCount())
    println(json.parse("[1, 2,]").err().get())
    println(Json.obj(("é", Json.arr(Json.str("😀"), Json.Real(0.1)))).renderAscii())
    val big = Json.Arr((0..<300).map(i -> Json.obj(("i", Json.num(i)), ("s", Json.str(s"v$i")))).toVector())
    println(json.parse(big.render()).ok().get() == big, big.render().byteLength())
