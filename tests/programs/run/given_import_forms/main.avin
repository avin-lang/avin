// expect: exit 0
// A given of another module fills a file's calls once the file imports it by name: directly, in
// braces, under an `as` name, or through a module that exports it. Two imports of one given are one
// given. The module's own givens fill beside the imported ones; a named argument, a block's given, a
// function's `using` parameter and an object's given are nearer and win. An imported given is also
// an ordinary value, read by the name the import binds. A module's givens are made with its values,
// in initialization order, so a given of this module may be made by a call an imported given fills.
import clock.{Clock, Fixed, stamp}
import clock.systemClock
import log.{Logger, say, twice, logger}
import log.logger as jürnal
import db.{Tx, txId, current as tx}
import kit.{current, kitTx, kitTwice, kitStart}

data Box(n: int)

given box = Box(txId() + 1)

boxed(using b: Box) -> int = b.n

viaUsing(using c: Clock) -> long = stamp()

inner() -> long
  given near: Clock = Fixed(1)
  stamp()

object Holder
  given held: Clock = Fixed(2)
  val first = stamp()
  show() -> long = stamp()

main()
  println(stamp())
  println(say("hi"))
  println(twice(4))
  println(txId())
  println(kitTx())
  println(kitTwice())
  println(kitStart)
  println(boxed())
  println(stamp(clock = Fixed(5)))
  println(inner())
  println(viaUsing(c = Fixed(9)))
  println(Holder.first)
  println(Holder.show())
  val later = () -> stamp()
  println(later())
  println(tx.id + current.id)
  println(systemClock.now())
  println(jürnal.prefix + logger.prefix + "|")
  println(say("named", l = Logger("own: ")))
