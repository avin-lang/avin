module kit

// A module that exports another module's given by name presents it to its importers, and takes it
// as a given of its own files, as it is one of their names.
export db.{Tx, current, txId}

// Made when the module's values are, after `db`'s, from the given it exports.
val kitStart = txId() * 10

kitTx() -> int = txId()
