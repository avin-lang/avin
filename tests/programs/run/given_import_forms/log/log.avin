module log

class Logger(val prefix: string)
  line(text: string) -> string = prefix + text

given logger = Logger("log: ")

say(text: string, using l: Logger) -> string = l.line(text)

// A function generic in its other parameters, its section filled from the importer's given.
twice[T: Display](x: T, using l: Logger) -> string = l.line(s"$x$x")
