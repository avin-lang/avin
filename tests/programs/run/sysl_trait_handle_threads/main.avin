// expect: exit 0
// A handle on a Sysl trait belongs to the code that made it and moves as a struct handle does: a
// thread's body and a pool task own the trait handles they capture, directly, in a collection or in
// an object, until they return; what they return, or complete a future with, is taken by the next
// code to use it; and trait handles made and dropped on threads that have ended are given back by
// the collector.
import avin.threads.{Future, Promise, spawn}

@sysl("avintest.views.View")
class View
  describe() -> string
  padding(n: int) -> View

@sysl("avintest.views.text")
text(s: string) -> View

@sysl("avintest.views.marked")
marked(id: int) -> View

@sysl("avintest.views.marks_back")
marksBack() -> long

@sysl("avintest.views.column")
column(children: Vector[View], spacing: int) -> View

class Holder(val view: View)

main()
  val a = text("a")
  val many = [text("x"), text("y")]
  val held = Holder(text("held"))
  val t = spawn(() ->
    val c = column([a, held.view] ++ many, 1)
    c.padding(2).describe())
  println(t.join())
  // Once the body has returned, what it held is in transit, and the caller takes it back.
  println(column([a, held.view] ++ many, 0).describe())
  // A trait handle a thread makes and returns is taken by whoever joins it.
  val made = spawn(() -> text("made").padding(1)).join()
  println(column([made, a], 3).describe())
  // A pool task owns what it captures until it returns; a future's value is taken by its awaiter.
  val f = Future(column([a, text("pool")], 0))
  println(f.await().describe())
  val g = Future(text("mapped")).map(v -> column([v, a], 2))
  println(g.await().describe())
  val p = Promise[View]()
  spawn(() -> p.complete(text("promised"))).join()
  println(p.future.await().padding(5).describe())
  // Trait handles made and dropped on threads that have ended are given back by the collector.
  val start = marksBack()
  for i in 0 ..< 4
    spawn(() ->
      for j in 0 ..< 200
        marked(j).padding(1)
      ()).join()
  var k = 0
  while marksBack() - start < 100 && k < 100000
    marked(k)
    Array.fill(64, k)
    k += 1
  println(marksBack() - start >= 100)
