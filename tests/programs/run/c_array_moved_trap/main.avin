// expect: trap
// An array the program moved, passed to a C function that writes it, stops the program at the call,
// before C sees it: C would write elements the receiver owns. Passing it before the move, an array
// never moved, and a moved array the program took back, whose length C is told whole, all cross.
import avin.actors.Isolated

@c("long long aa_sum_bytes(const uint8_t *p, length(p) size_t n)")
sumBytes(p: Array[byte]) -> long

@c("void aa_fill_bytes(uint8_t *p, length(p) size_t n, int start)")
fillBytes(p: Array[byte], start: int)

main()
  val a = Array.fill[byte](4, byte(2))
  println(sumBytes(a))
  val back = Isolated.move(Array.fill[byte](5, byte(3))).take()
  fillBytes(back, 1)
  println(sumBytes(back))
  val moved = Isolated.move(a)
  println(sumBytes(Array.fill[byte](3, byte(1))))
  fillBytes(a, 1)
  println(moved.take().length)
