// expect: exit 0
// Another module's `var`s are places of a multiple assignment, reached through the module's name,
// through the name `as` gives it, and by the bare name an import brings in.
import app.store
import app.store as s
import app.store.total

var mine = 100
var order = ""

step(tag: string, v: int) -> int
    order = order + tag
    v

pairUp[T](x: T, y: T) -> (T, T) = (x, y)

main()
    store.latest, store.total = 1, 2
    println(store.show())
    store.latest, store.total = store.total, store.latest
    println(store.show())
    // through the alias, the bare imported name, and mixed with this module's own and a local
    var n = 7
    s.latest, total, mine, n = mine, s.latest, n, total
    println(s"${store.show()} | $mine $n")
    // the module's own function swapping by bare name
    store.swapOwn()
    println(store.show())
    // a module object's field and a module value's field among the places
    store.Tally.count, s.box.n, store.latest = store.latest, store.total, 42
    println(store.show())
    // Unicode and long extremes
    var tag = "Ωmega 🚀"
    store.label, tag = tag, store.label
    store.big, s.big = -9223372036854775807 - 1, 9223372036854775807
    println(s"${store.show()} | $tag")
    // compound form reads every place first
    store.latest, s.total += s.total, store.latest
    println(store.show())
    // evaluation order: every part made, left to right, before any store
    order = ""
    store.total = 5
    store.latest, store.total = step("a", store.total), step("b", store.latest)
    println(s"${store.show()} $order")
    // a computed tuple, a generic function's result
    store.label, _ = pairUp("x", "y")
    println(store.show())
    // inside a closure
    val rotate = () ->
        store.latest, store.total, mine = store.total, mine, store.latest
    rotate()
    println(s"${store.show()} | $mine")
    // many allocations stored through another module's places, for the collector
    for i in 0..<1500
        store.names, s.label = store.names :+ s"n$i", s"l$i"
        if store.names.length >= 40
            store.names, total = Vector[string](), total + 1
    println(s"${store.names.length} ${store.show()}")
