module app.store

var latest = 0
var total = 10
var label = "ñandú"
var big: long = 0
var names = Vector[string]()

object Tally
    var count = 0

class Box(var n: int)

val box = Box(0)

// The module's own functions see what another module stored.
show() -> string = s"$latest $total $label $big ${Tally.count} ${box.n}"

// The module swaps its own values by their bare names.
swapOwn()
    latest, total = total, latest
