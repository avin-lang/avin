// expect: trap
// A handle on a Sysl trait that `close()` has given back stops the program where it is passed to
// Sysl, as a struct handle does; its methods with a body still run.

@sysl("avintest.views.View")
class View
  describe() -> string
  named() -> string = "a view"

@sysl("avintest.views.text")
text(s: string) -> View

@sysl("avintest.views.same")
same(v: View) -> View

main()
  val v = text("v")
  println(same(v).describe())
  v.close()
  println(v.named())
  println(same(v).describe())
