// expect: exit 0
// Arrays crossing to zlib: checksums of an `Array[byte]` through a `const Bytef *` with its length
// in a `uInt`, an empty array and `None` passing null; `compress` and `uncompress`, each told the
// destination's length through an `inout uLongf *` and answering how much of it they used inside a
// status, round-tripping text, a large array and an empty one, one of them `blocking`; and a
// destination too small, which zlib refuses with its status.

@c("uLong crc32(uLong crc, const Bytef *buf, length(buf) uInt len)")
crc32(crc: long, buf: Array[byte]) -> long

@c("uLong crc32(uLong crc, const Bytef *buf, length(buf) uInt len)", blocking)
crc32Waiting(crc: long, buf: Option[Array[byte]]) -> long

@c("uLong adler32(uLong adler, const Bytef *buf, length(buf) uInt len)")
adler32(adler: long, buf: Option[Array[byte]]) -> long

@c("uLong compressBound(uLong sourceLen)")
compressBound(n: long) -> long

@c("int compress(Bytef *dest, length(dest) inout uLongf *destLen, const Bytef *source, length(source) uLong sourceLen)")
compress(dest: Array[byte], source: Array[byte]) -> Result[long, int]

@c("int uncompress(Bytef *dest, length(dest) inout uLongf *destLen, const Bytef *source, length(source) uLong sourceLen)", blocking)
uncompress(dest: Array[byte], source: Array[byte]) -> Result[long, int]

bytesOf(text: string) -> Array[byte] = Array.tabulate(text.byteLength, i -> text.byteAt(i))

roundTrip(source: Array[byte]) -> bool
    val packed = Array.fill(int(compressBound(long(source.length))), byte(0))
    val n = compress(packed, source).ok.get
    val back = Array.fill(source.length, byte(0))
    val m = uncompress(back, packed.slice(0, int(n))).ok.get
    m == long(source.length) && back == source

main()
    val text = bytesOf("hello, hello, hello, hello")
    println(crc32(0, text))
    println(crc32Waiting(0, Some(text)))
    println(crc32(0, Array.empty()))
    println(crc32Waiting(0, None))
    println(adler32(1, Some(bytesOf("Wikipedia"))))
    println(adler32(1, None))
    println(roundTrip(text))
    println(roundTrip(Array.tabulate(300000, i -> byte(i * 7 % 251))))
    println(roundTrip(Array.empty()))
    val tiny = Array.fill(2, byte(0))
    println(compress(tiny, text).err)
