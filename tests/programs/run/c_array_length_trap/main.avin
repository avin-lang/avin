// expect: trap
// An array whose length an `unsigned char` cannot hold stops the program at the call, naming the
// length's C type and the array, through a function value as through a direct call; 255 elements
// cross.

@c("int aa_count_uchar(const uint8_t *p, length(p) unsigned char n)")
countUchar(p: Array[byte]) -> int

main()
  val f: Array[byte] -> int = countUchar
  println(f(Array.fill(255, byte(0))))
  println(countUchar(Array.fill(0, byte(0))))
  println(f(Array.fill(256, byte(0))))
