module lib

// A machine, its events, a class with its companion object, a lazy value, a value of boundary
// numbers and a generic function, exported; one name exported twice, from two files, is the same
// declaration and no clash.
export lib.doors.{Door, DoorEvent, Open, Close, Shut, Ajar}
export lib.tally.{Tally, greeting, limits, applyAll}

// The module's own code names the machine's state type through the export.
describe(s: Door.State) -> string = s match
    Shut -> "shut"
    Ajar(n) -> s"ajar $n"
