module lib.tally

class Tally(var total: long)
    add(n: long) -> Tally
        total += n
        self

object Tally
    start() -> Tally = Tally(0)

lazy val greeting: string = "héllo, wörld ✓"

val limits: (int, long) = (2147483647, -9223372036854775807 - 1)

// A generic function whose argument is a closure: the exported name calls it with captured state.
applyAll[T](xs: Vector[T], f: (T) -> T) -> Vector[T] = xs.map(f)
