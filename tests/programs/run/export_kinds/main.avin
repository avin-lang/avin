// expect: exit 0
// Declarations of every kind reached through exports: a machine and its state type, by the imported
// name and through the module; a class's companion object; a lazy value; boundary numbers; Unicode
// text; a generic function called with a closure capturing a local.
import lib
import lib.{Door, Open, Close, Shut, Tally, greeting, limits, applyAll}

viaModule(d: lib.Door) -> lib.Door.State = d.state()

main()
    val d = Door()
    d.handle(Open)
    d.handle(Open)
    println(lib.describe(d.state()))
    val s: Door.State = viaModule(d)
    println(s)
    d.handle(Close)
    println(viaModule(d) is Shut)
    println(lib.describe(d.state()))
    val t = Tally.start().add(5).add(6)
    println(t.total)
    println(lib.Tally.start().add(1).total)
    println(greeting)
    println(limits.0)
    println(limits.1)
    val step = 3
    println(applyAll([1, 2, 3], (x: int) -> x * step))
    println(lib.applyAll(["a", ""], (w: string) -> w + "é"))
    println(applyAll([], (x: int) -> x))
