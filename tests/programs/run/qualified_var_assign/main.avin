// expect: exit 0
// Another module's public `var` is assigned as it is read: through the module's name, through the
// name `as` gives it, and by the bare name an import brings in. Every assignment form reaches the
// one variable, and its own module sees what was stored.
import app.store
import app.store as s
import app.store.total
import a.b.c

class Local(var latest: int)

setFrom[T](value: T, measure: (T) -> int) = store.latest = measure(value)

main()
    store.latest = 5
    println(s"${store.latest} ${s.latest} ${store.latestValue()}")
    store.latest += 2
    store.latest *= 3
    store.latest -= 1
    println(s"${store.latest}")
    store.latest++
    ++store.latest
    store.latest--
    println(s"${store.latest}")
    println(s"${store.latest +:= 10} ${store.latest := 1} ${store.latest}")
    s.latest = 40
    s.latest += 2
    println(s"${store.latest} ${store.latestValue()}")
    store.bump()
    println(s"${s.latest}")
    total = 7
    total += 1
    println(s"${total} ${store.total} ${s.total}")
    store.total = 20
    println(s"${total}")
    c.x = 1
    c.x += 2
    c.x++
    println(s"${c.x}")
    store.label = "héllo 🌍"
    store.label += "!"
    println(store.label)
    store.latest = 2147483647
    println(s"${store.latest}")
    store.latest = -2147483648
    println(s"${store.latest}")
    store.big = 9223372036854775807
    println(s"${store.big}")
    store.Tally.count = 1
    store.Tally.count += 1
    store.box.n = 4
    store.box.n *= 2
    println(s"${store.Tally.count} ${store.box.n}")
    val set = (n: int) -> store.latest = n
    set(77)
    println(s"${store.latest}")
    val add = (n: int) -> s.latest += n
    add(3)
    println(s"${store.latest}")
    setFrom("four", w -> w.byteLength())
    println(s"${store.latest}")
    setFrom(Vector(1, 2, 3), v -> v.size() * 10)
    println(s"${store.latest}")
    for i in 0..<2000
        store.items = Vector(i, i + 1, i + 2)
    println(s"${store.items.sum()}")
    println(s"${store.reveal()}")
    val store = Local(1)
    store.latest = 2
    println(s"${store.latest} ${s.latest}")
