// expect: exit 0
// A Sysl mirror's field may be a Sysl handle, passed into Sysl as a handle parameter is: a type with
// a destructor as the counted reference the handle holds, so what Sysl does to it the handle sees, and
// one without as the Sysl field takes it, a copy. The mirror may be an enum's variant or a struct, a
// binding's parameter by itself or held in an `Option` or a collection, and one variant may hold
// handles of two types. A mirror holding a handle also comes out of Sysl, each field a handle of its
// own.

@sysl("avintest.digits.Tally")
class Tally
    add(n: long)
    get() -> long

@sysl("avintest.digits.new_tally")
newTally(n: long) -> Tally

@sysl("avintest.digits.Mark")
class Mark
    place() -> long

@sysl("avintest.digits.mark_at")
markAt(n: long) -> Mark

@sysl("avintest.digits.Source")
data Source
    FromTally(tally: Tally)
    FromMark(mark: Mark)
    Number(n: long)
    Both(tally: Tally, mark: Mark)

@sysl("avintest.digits.count_of")
countOf(s: Source) -> long

// A call that may wait converts the mirror, and checks its handles, before the thread is safe.
@sysl("avintest.digits.count_of", blocking)
countWaiting(s: Source) -> long

@sysl("avintest.digits.bump_source")
bumpSource(s: Source) -> long

@sysl("avintest.digits.count_all")
countAll(sources: Vector[Source]) -> long

@sysl("avintest.digits.count_all")
countArray(sources: Array[Source]) -> long

@sysl("avintest.digits.count_maybe")
countMaybe(s: Option[Source]) -> long

@sysl("avintest.digits.source_of")
sourceOf(n: long) -> Source

@sysl("avintest.digits.Pin")
data Pin(tally: Tally, mark: Mark)

@sysl("avintest.digits.pin_count")
pinCount(p: Pin) -> long

@sysl("avintest.digits.new_pin")
newPin(n: long) -> Pin

main()
    val t = newTally(7)
    val m = markAt(3)
    println(countOf(FromTally(t)))
    println(countOf(FromMark(m)))
    println(countOf(Number(9)))
    println(countOf(Both(t, m)))
    println(countWaiting(Both(t, m)))
    // Sysl adds to the tally the mirror holds, which is the handle's own.
    println(bumpSource(FromTally(t)))
    println(bumpSource(Both(t, m)))
    println(t.get())
    t.add(10)
    println(countOf(FromTally(t)))
    // In a collection and an option.
    println(countAll([FromTally(t), FromMark(m), Number(1)]))
    println(countArray(Array.fill(2, Both(t, m))))
    println(countMaybe(Some(FromTally(t))))
    println(countMaybe(None))
    // A struct mirror holding handles.
    println(pinCount(Pin(t, m)))
    // Out of Sysl: each field a handle of its own.
    sourceOf(5) match
        Both(made, at) ->
            made.add(1)
            println(made.get())
            println(at.place())
            println(countOf(Both(made, at)))
            made.close()
        _ -> println("unexpected")
    sourceOf(-4) match
        FromMark(at) -> println(at.place())
        _ -> println("unexpected")
    val p = newPin(20)
    println(p.tally.get())
    println(p.mark.place())
    println(pinCount(p))
