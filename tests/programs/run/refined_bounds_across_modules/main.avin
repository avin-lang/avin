// expect: exit 0
// A variant bounding its own parameter, declared in another module: values made in either module,
// at types of either module, are taken apart by arms in both, which compare their elements; a copy
// at a type that is not ordered leaves the `Sorted` arm out.
import colls
import colls.{Coll, Plain, Sorted, smallest, sorted}

class Money(val cents: long): Ord, Display
  override compare(other: Money) -> int = cents.compare(other.cents)
  override display(out: Writer, spec: FormatSpec) = out.write(s"$cents¢")

class Note(val text: string)

largest[T](c: Coll[T]) -> Option[T] = c match
  Plain(_) -> None
  Sorted(items) -> items.maxOption

main()
  val m: Coll[Money] = Sorted([Money(250), Money(-5), Money(long.MaxValue)])
  println(smallest(m))
  println(largest(m))
  println(largest(sorted([3, 9, 1])))
  println(smallest(sorted(["β", "α"])))
  val n: Coll[Note] = Plain([Note("x")])
  println(smallest(n).isEmpty)
  println(largest(n).isEmpty)
