module colls

// A type whose refined variant bounds its own parameter: a value of `Sorted` is made only at an
// ordered type, and an arm on it, here or in another module, may compare the elements.

data Coll[T]
  Plain(items: Vector[T])
  Sorted[A: Ord](items: Vector[A]) -> Coll[A]

// A value made at the caller's type, which the bound holds of.
sorted[A: Ord](items: Vector[A]) -> Coll[A] = Sorted(items)

// An arm in the type's own module, where `T` is `Ord` because `Sorted` makes the value.
smallest[T](c: Coll[T]) -> Option[T] = c match
  Plain(_) -> None
  Sorted(items) -> items.minOption
