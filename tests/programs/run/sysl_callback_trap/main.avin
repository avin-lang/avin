// expect: trap
// A trap inside a callback stops the whole program, as any trap does, reported at its own place in
// the callback's code, three calls deep in Sysl; what was printed before it is kept.

@sysl("avintest.callbacks.apply")
apply(f: (int) -> int, x: int) -> int

down(n: int) -> int
    if n == 0
        val big = 2147483647
        return big + n + 1
    apply(x -> down(x - 1), n)

main()
    println(apply(x -> x + 1, 1))
    println(down(3))
    println("not reached")
