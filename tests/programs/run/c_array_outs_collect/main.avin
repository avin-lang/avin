// expect: exit 0
// Arrays answered while the collector runs: arrays C fills, at a length the call before says, and
// several arrays C allocates in one call beside out pointers passed null, copied into new arrays
// while another thread allocates, each array read back whole once the loop is done. The corpus runs
// this with the collector at every allocation, at -O0 and -O2.
import avin.threads.spawn

@c(struct: "as_glyph")
data Glyph(index: long, x: real, y: real)

@c(struct: "as_cluster")
data Cluster(numBytes: int, numGlyphs: int)

@c("void as_dash_set(int n)")
dashSet(n: int)

@c("void as_dash_get(out double *dashes, out double *offset)", array: "dashes", length: "as_dash_count()")
getDash() -> (Array[real], real)

@c(
    "int as_shape(const char *text, int n, out as_glyph **glyphs, out int *num_glyphs, out as_cluster **clusters, out int *num_clusters, null as_cluster_flags *flags)",
    array: ["glyphs", "clusters"],
    length: ["num_glyphs", "num_clusters"],
    free: ["as_glyphs_free", "as_clusters_free"]
)
shape(text: string, n: int) -> Result[(Array[Glyph], int, Array[Cluster], int), int]

@c("int as_glyphs_fill(int n, out as_glyph *glyphs)", array: "glyphs", length: "n")
glyphsFill(n: int) -> Result[Array[Glyph], int]

churn() -> int
  var total = 0
  for i in 0 ..< 2000
    total += [i, i + 1].length
  total

main()
  val busy = spawn(() -> churn())
  var dashes: Vector[Array[real]] = []
  var glyphs: Vector[Array[Glyph]] = []
  var clusters: Vector[Array[Cluster]] = []
  for i in 0 ..< 60
    dashSet(i % 4)
    val (d, _) = getDash()
    dashes = dashes :+ d
    shape("é" + i.toString(), i % 5) match
      Ok((g, _, c, _)) ->
        glyphs = glyphs :+ g
        clusters = clusters :+ c
      Err(_) -> println("failed")
    glyphsFill(3) match
      Ok(g) -> glyphs = glyphs :+ g
      Err(_) -> println("failed")
  var sum = 0.0
  for d in dashes
    for x in d
      sum += x
  var indices = long(0)
  for g in glyphs
    for x in g
      indices += x.index
  var bytes = 0
  for c in clusters
    for x in c
      bytes += x.numBytes
  println(sum)
  println(indices)
  println(bytes)
  println(busy.join())
