module texts

// A module's extension adds static members to built-in types as it adds methods; a private one is
// the module's own.
impl string
    static joined(parts: Vector[string]) -> string = parts.foldLeft("", (a, b) -> if a.isEmpty then b else a + "-" + b)
    static framed(s: string) -> string = string.bracket() + s + "]"
    private static bracket() -> string = "["

impl int
    static digitsOf(s: string) -> int = s.toInt()
