// expect: exit 0
// Static members an extension adds to a built-in type are seen by a file importing its module, whole
// or by a declaration, as the extension's methods are, called and as function values; the core
// library's own are seen everywhere.
import texts

main()
    println(string.joined(["a", "b", "c"]))
    println(string.framed("x"))
    println(int.digitsOf("42") + 1)
    println(["p", "q"].map(string.framed))
    println(string.fromUtf8Lossy("ok".bytes.toArray()))
