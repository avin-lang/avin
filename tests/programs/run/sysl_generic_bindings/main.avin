// expect: exit 0
// A generic binding is bound to a generic Sysl function once, and called at any `Boundary` type: the
// compiler generates one shim per instantiation the program uses, which Sysl checks at that type. A
// generic handle class is a handle on every instance of a generic Sysl type, each a class of its own.

@sysl("avintest.digits.Spot")
data Spot(x: int, y: int)

@sysl("avintest.digits.Shade")
data Shade
    Light
    Dark(level: int)

@sysl("avintest.digits.same")
same[T: Boundary](x: T) -> T

@sysl("avintest.digits.same", blocking)
sameWaiting[T: Boundary](x: T) -> T

@sysl("avintest.digits.first_some")
firstSome[T: Boundary](xs: Vector[Option[T]]) -> Option[T]

@sysl("avintest.digits.first_some")
firstSomeOf[T: Boundary](xs: Array[Option[T]]) -> Option[T]

@sysl("avintest.digits.swapped")
swapped[A: Boundary, B: Boundary](p: (A, B)) -> (B, A)

@sysl("avintest.digits.larger")
larger[T: Boundary + Ord](a: T, b: T) -> T

@sysl("avintest.digits.copies")
copies[T: Boundary](x: T, n: long) -> Vector[T]

@sysl("avintest.digits.copies")
copiesInArray[T: Boundary](x: T, n: long) -> Array[T]

@sysl("avintest.digits.applied")
applied[T: Boundary, U: Boundary](x: T, f: T -> U) -> U

@sysl("avintest.digits.either")
either[T: Boundary, E: Boundary](ok: bool, x: T, e: E) -> Result[T, E]

@sysl("avintest.views.Signal")
class Signal[T: Boundary]
    read() -> T
    set(v: T)
    paired[U: Boundary](u: U) -> (T, U)
    // A method with a body is written over the bound ones, at every instance.
    swapIn(v: T) -> T
        val old = read()
        set(v)
        old

@sysl("avintest.views.signal")
signal[T: Boundary](v: T) -> Signal[T]

@sysl("avintest.views.clamped")
clamped[T: Boundary + Ord](s: Signal[T], lo: T, hi: T) -> T

@sysl("avintest.views.Pair")
class Pair[A: Boundary, B: Boundary]
    swap() -> Pair[B, A]
    firstOf() -> A
    secondOf() -> B

@sysl("avintest.views.pair")
pair[A: Boundary, B: Boundary](a: A, b: B) -> Pair[A, B]

@sysl("avintest.views.Thing")
class Thing[T: Boundary]
    get() -> T
    named() -> string

@sysl("avintest.views.thing_int")
intThing(v: int) -> Thing[int]

@sysl("avintest.views.thing_string")
stringThing(v: string) -> Thing[string]

@sysl("avintest.views.View")
class View
    describe() -> string

@sysl("avintest.views.counter_label")
counterLabel(c: Signal[int]) -> View

@sysl("avintest.views.text_field")
textField(text: Signal[string], width: int) -> View

@sysl("avintest.views.total")
total(signals: Vector[Signal[int]]) -> int

// A generic function passes its own type parameter on to a binding where it is bounded by `Boundary`.
roundTrip[T: Boundary](x: T) -> Option[T] = Some(same(x))

exchange[T: Boundary](s: Signal[T], v: T) -> (T, T)
    val old = s.swapIn(v)
    (old, s.read())

main()
    // One binding at every scalar, at its boundary values.
    println(same(byte(0)), same(byte(255)))
    println(same(i8(-128)), same(i8(127)))
    println(same(i16(-32768)), same(i16(32767)))
    println(same(-2147483648), same(2147483647))
    println(same(long(-9223372036854775807) - 1), same(long(9223372036854775807)))
    println(same(0.5), same(-0.0), same(true), same(false))
    println(same('a'), same('é'), same('😀'))
    println(same(()))
    println(same(""), same("héllo, 世界"))
    // At options, results, tuples and mirrors, nested.
    val nothing: Option[string] = None
    val fine: Result[Option[char], string] = Ok(Some('x'))
    val bad: Result[int, string] = Err("bad")
    println(same(Some(Some(1))), same(nothing))
    println(same(fine), same(bad))
    println(same((1, ("two", (byte(3), 4.5)))))
    println(same(Spot(-1, 2147483647)), same(Light), same(Dark(-5)))
    println(same(Some((Spot(0, 0), Dark(1)))))
    // A call that waits, at an integer, a string and a mirror.
    println(sameWaiting(5), sameWaiting("w"), sameWaiting(Some(Spot(5, 5))))
    // Two type parameters.
    println(swapped((1, "a")), swapped((Spot(1, 2), (true, 'c'))))
    println(either(true, 1, "no"), either[int, string](false, 1, "no"))
    println(either(false, Light, Spot(3, 3)))
    // Nested generics: a collection of options of the type parameter, empty and not.
    println(firstSome([None, Some("b"), Some("c")]))
    val nones: Vector[Option[long]] = [None, None]
    println(firstSome[int]([]), firstSome(nones))
    println(firstSome([None, Some(Spot(1, 1))]))
    println(firstSomeOf(Array.tabulate(3, i -> if i == 1 then Some(Dark(i)) else None)))
    println(copies("ab", 3), copies(Some(1), 0), copies(Spot(9, 9), 2))
    println(copiesInArray('z', 4).length())
    // A callback over the type parameters, a closure capturing a local.
    val suffix = "!"
    println(applied(4, x -> s"<$x>"), applied("abc", x -> x + suffix))
    println(applied(Spot(2, 3), s -> s.x * s.y), applied(Light, s -> s == Light))
    // A Sysl bound and an Avin one, each checked on its side.
    println(larger(3, 9), larger("b", "a"), larger(i8(-1), i8(-2)), larger(2.5, 1.5))
    // Through a generic function of its own.
    println(roundTrip(7), roundTrip("seven"), roundTrip(Spot(7, 7)))
    // A generic handle at many instances, each a class of its own.
    val n = signal(3)
    n.set(n.read() + 1)
    println(n.read(), counterLabel(n).describe())
    val t = signal("x")
    println(exchange(t, "y"), textField(t, 10).describe())
    println(signal(Some((1, "a"))).read(), signal(Spot(4, 5)).read(), signal(Dark(9)).read())
    println(signal(byte(200)).read(), signal('ß').read(), signal(()).read(), signal(-0.25).read())
    println(n.paired("p"), t.paired(Spot(0, 1)))
    println(clamped(signal(50), 0, 10), clamped(signal("m"), "a", "k"))
    val p = pair(1, "one")
    val q = p.swap()
    println(s"${p.firstOf()} ${p.secondOf()} ${q.firstOf()} ${q.secondOf()}")
    println(pair(Light, Spot(1, 1)).swap().firstOf())
    // A generic trait instance.
    println(intThing(41).get(), stringThing("held").get(), intThing(0).named())
    // Collections of an instance.
    println(total(Vector.tabulate(100, i -> signal(i))), total([]))
    // Many objects of many instances, collected as the program runs.
    var sum: long = 0
    for i in 0..<2000
        val s = signal(s"v$i")
        val l = signal(long(i))
        l.set(l.read() * 2)
        sum = sum + l.read() + long(s.read().count(c -> true))
        if i % 3 == 0 then s.close()
    println(sum)
    n.close()
    t.close()
