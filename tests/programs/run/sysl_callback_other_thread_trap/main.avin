// expect: trap
// A callback the binding does not mark `@threaded` belongs to the code that gave it: called by
// another Avin thread, it stops the program where that thread called into Sysl.
import avin.threads.spawn

@sysl("avintest.callbacks.keep")
keep(f: (int) -> int)

@sysl("avintest.callbacks.call_kept")
callKept(i: int, x: int) -> int

main()
    keep(x -> x * 2)
    println(callKept(0, 5))
    val t = spawn(() -> callKept(0, 6))
    println(t.join())
