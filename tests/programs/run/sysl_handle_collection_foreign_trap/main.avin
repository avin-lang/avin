// expect: trap
// Each handle of a collection passed to Sysl is checked as a handle passed by itself is: one that
// another thread owns stops the program at the call, though the others are the caller's own.
import avin.threads.{Channel, spawn}

@sysl("avintest.views.View")
class View
    describe() -> string

@sysl("avintest.views.text")
text(s: string) -> View

@sysl("avintest.views.count")
count(children: Vector[View]) -> int

main()
    val made = Channel[View]()
    val done = Channel[unit]()
    spawn(() ->
        made.send(text("theirs"))
        done.receive())
    val theirs = made.receive().get()
    val mine = [text("a"), text("b")]
    println(count(mine))
    println(count(mine :+ theirs))
