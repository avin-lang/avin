// expect: trap
// Each handle of a collection passed to Sysl is checked as a handle passed by itself is: one that
// another thread owns, having taken it from a channel and used it, stops the program at the call,
// though the others are the caller's own.
import avin.threads.{Channel, spawn}

@sysl("avintest.views.View")
class View
  describe() -> string

@sysl("avintest.views.text")
text(s: string) -> View

@sysl("avintest.views.count")
count(children: Vector[View]) -> int

main()
  val theirs = text("theirs")
  val handed = Channel[View]()
  val used = Channel[unit]()
  val done = Channel[unit]()
  spawn(() ->
    _ = handed.receive().get.describe()
    used.send(())
    done.receive())
  handed.send(theirs)
  _ = used.receive()
  val mine = [text("a"), text("b")]
  println(count(mine))
  println(count(mine :+ theirs))
