// expect: trap
// Two components built under one parent with one key would be one component twice, so the second
// stops the program, naming the key; the same key under two parents is two components.
import ui.{column, component, keyed, root, text}

main()
  val fine = root(
    () -> column([component(c -> keyed("k", d -> text("1"))), component(c -> keyed("k", d -> text("2")))])
  )
  fine()
  fine()
  println("two parents")
  val build = root(() -> column([keyed("k", c -> text("1")), keyed(7, c -> text("7")), keyed("k", c -> text("2"))]))
  build()
  println("never")
