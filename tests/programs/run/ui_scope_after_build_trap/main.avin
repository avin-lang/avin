// expect: trap
// A scope answers by the order of the requests its component's build makes, so a request made
// after the build, from a callback the build left behind, stops the program.
import ui.{Rect, button, component, root, tap}

main()
    val build = root(() -> component c ->
        button("ask", () -> c.state(0).set(1)).named("ask"))
    val v = build()
    println("built")
    tap(v, "ask", Rect(0, 0, 200, 100))
    println("never")
