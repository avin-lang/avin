// expect: trap
// A handle belongs to the code that made it: one made by another thread and sent here stops the
// program at its first use, while that thread runs.
import avin.threads.{Channel, spawn}
import fixture.{Object, newObject}

main()
    val made = Channel[Object]()
    val done = Channel[unit]()
    spawn(() ->
        made.send(newObject(2))
        done.receive())
    val theirs = made.receive().get()
    println("received")
    println(theirs.value())
