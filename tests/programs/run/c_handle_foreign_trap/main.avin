// expect: trap
// A handle belongs to the thread that uses it: one handed to another thread through a channel and
// used there stops the program at the sender's next use, while that thread runs.
import avin.threads.{Channel, spawn}
import fixture.{Object, newObject}

main()
  val mine = newObject(2)
  val handed = Channel[Object]()
  val used = Channel[unit]()
  val done = Channel[unit]()
  spawn(() ->
    _ = handed.receive().get.value()
    used.send(())
    done.receive())
  handed.send(mine)
  _ = used.receive()
  println("handed over")
  println(mine.value())
