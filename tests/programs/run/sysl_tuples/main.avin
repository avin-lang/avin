// A tuple of boundary types crosses as a Sysl tuple of the same arity, each part converted as it
// would be alone: an integer part takes any Sysl integer, checked, and a handle part is made into an
// object of its class.

@sysl("avintest.digits.count_and_text")
countAndText(n: long) -> (long, string)

// Each part narrows on its own: a `usize` into an `int`, a `u64` into a `long`.
@sysl("avintest.digits.wide_pair")
widePair(n: long) -> (int, long)

@sysl("avintest.digits.digit_pairs")
digitPairs(n: long) -> Vector[(byte, char)]

@sysl("avintest.digits.digit_pairs")
digitPairArray(n: long) -> Array[(byte, char)]

@sysl("avintest.digits.maybe_pair")
maybePair(n: long) -> Option[(string, int)]

// A tuple goes into Sysl the same way, part by part.
@sysl("avintest.digits.pair_sum")
pairSum(p: (long, int)) -> long

@sysl("avintest.digits.labelled")
labelled(pairs: Vector[(string, long)]) -> string

// Tuples nest, in one another and in a mirror's fields.
@sysl("avintest.digits.nested_pair")
nestedPair(n: long) -> (long, (string, int))

@sysl("avintest.digits.Placed")
data Placed(text: string, place: (int, long))

@sysl("avintest.digits.placed")
placed(n: long) -> Placed

@sysl("avintest.digits.Tally")
class Tally
    value() -> long

@sysl("avintest.digits.tally_of")
tallyOf(n: long) -> (Tally, string)

@sysl("avintest.digits.two_tallies")
twoTallies(a: long, b: long) -> Result[(Tally, Tally), string]

main()
    println(countAndText(90210))
    val (count, text) = countAndText(-7)
    println(s"$count $text")
    println(widePair(123456789))
    println(digitPairs(4096))
    val a = digitPairArray(37)
    println(s"${a.length} ${a(0)} ${a(1)}")
    println(digitPairs(0).length)
    println(s"${maybePair(512)} ${maybePair(0)}")
    println(pairSum((long(40), 2)))
    println(labelled([("a", long(1)), ("b", long(-2))]))
    println(labelled([]))
    println(nestedPair(-305))
    val p = placed(4040)
    println(s"${p.text} ${p.place}")
    val (t, digits) = tallyOf(1234)
    println(s"${t.value()} $digits")
    t.close()
    twoTallies(19, 28) match
        Ok((x, y)) -> println(s"${x.value()} ${y.value()} ${x === y}")
        Err(e) -> println(e)
    twoTallies(-1, 2) match
        Ok(_) -> println("both")
        Err(e) -> println(e)
    // Converted tuples are ordinary Avin values: they compare and order as any others do.
    println(countAndText(55) == (long(2), "55"))
    println(digitPairs(21).map(p -> p.1).toString())
