// expect: exit 0
// A handle may name an instance of a generic Sysl type, a struct or a trait, with its type
// arguments written as Avin writes boundary types: integers, `byte`, `real`, `char`, `bool`,
// `unit`, `string`, and `Option`s, `Result`s and tuples of these. Its methods are bound at that
// instance, a generic Sysl function makes one, and it is passed back by itself and in collections.
// Two classes may name the same instance, and one generic type has a handle at each of several.

@sysl("avintest.views.View")
class View
    describe() -> string

@sysl("avintest.views.Signal[string]")
class StringSignal
    read() -> string
    set(v: string)

@sysl("avintest.views.Signal[int]")
class IntSignal
    read() -> int
    set(v: int)

@sysl("avintest.views.Signal[ int ]")
class OtherIntSignal
    read() -> int

@sysl("avintest.views.Signal[long]")
class LongSignal
    read() -> long
    set(v: long)

@sysl("avintest.views.Signal[byte]")
class ByteSignal
    read() -> byte
    set(v: byte)

@sysl("avintest.views.Signal[bool]")
class BoolSignal
    read() -> bool

@sysl("avintest.views.Signal[char]")
class CharSignal
    read() -> char

@sysl("avintest.views.Signal[real]")
class RealSignal
    read() -> real

@sysl("avintest.views.Signal[Option[int]]")
class MaybeSignal
    read() -> Option[int]
    set(v: Option[int])

@sysl("avintest.views.Signal[Result[string, i16]]")
class ResultSignal
    read() -> Result[string, i16]

@sysl("avintest.views.Signal[(int, (string, byte))]")
class TupleSignal
    read() -> (int, (string, byte))

@sysl("avintest.views.Signal[unit]")
class UnitSignal
    read() -> unit

@sysl("avintest.views.Pair[int, string]")
class IntStringPair
    swap() -> StringIntPair
    firstOf() -> int
    secondOf() -> string

@sysl("avintest.views.Pair[string, int]")
class StringIntPair
    firstOf() -> string
    secondOf() -> int

@sysl("avintest.views.Thing[int]")
class IntThing
    get() -> int
    named() -> string

@sysl("avintest.views.Thing[string]")
class StringThing
    get() -> string

@sysl("avintest.views.signal")
stringSignal(v: string) -> StringSignal

@sysl("avintest.views.signal")
intSignal(v: int) -> IntSignal

@sysl("avintest.views.signal")
otherIntSignal(v: int) -> OtherIntSignal

@sysl("avintest.views.signal")
longSignal(v: long) -> LongSignal

@sysl("avintest.views.signal")
byteSignal(v: byte) -> ByteSignal

@sysl("avintest.views.signal")
boolSignal(v: bool) -> BoolSignal

@sysl("avintest.views.signal")
charSignal(v: char) -> CharSignal

@sysl("avintest.views.signal")
realSignal(v: real) -> RealSignal

@sysl("avintest.views.signal")
maybeSignal(v: Option[int]) -> MaybeSignal

@sysl("avintest.views.signal")
resultSignal(v: Result[string, i16]) -> ResultSignal

@sysl("avintest.views.signal")
tupleSignal(v: (int, (string, byte))) -> TupleSignal

@sysl("avintest.views.signal")
unitSignal(v: unit) -> UnitSignal

@sysl("avintest.views.pair")
intStringPair(a: int, b: string) -> IntStringPair

@sysl("avintest.views.text_field")
textField(text: StringSignal, width: int) -> View

@sysl("avintest.views.counter_label")
counterLabel(c: IntSignal) -> View

@sysl("avintest.views.total")
total(signals: Vector[IntSignal]) -> int

@sysl("avintest.views.thing_int")
intThing(v: int) -> IntThing

@sysl("avintest.views.thing_string")
stringThing(v: string) -> StringThing

@sysl("avintest.views.thing_sum")
thingSum(things: Vector[IntThing]) -> int

main()
    // A struct instance, its methods bound there, and passed back.
    val s = stringSignal("hi")
    println(s.read())
    s.set("there")
    println(textField(s, 120).describe())
    s.set("")
    println(textField(s, 0).describe())
    val c = intSignal(0)
    c.set(c.read() + 2)
    println(counterLabel(c).describe())
    c.set(2147483647)
    println(c.read())
    // The same instance under two classes, each its own handle type.
    println(otherIntSignal(-2147483648).read())
    // Several instances of one generic type.
    val l = longSignal(9223372036854775807)
    println(l.read())
    l.set(-9223372036854775807 - 1)
    println(l.read())
    val b = byteSignal(byte(255))
    b.set(byte(7))
    println(b.read())
    println(boolSignal(true).read())
    println(charSignal('é').read())
    println(realSignal(2.5).read())
    val m = maybeSignal(None)
    println(m.read())
    m.set(Some(3))
    println(m.read())
    println(resultSignal(Ok("fine")).read())
    println(resultSignal(Err(i16(-5))).read())
    println(tupleSignal((1, ("two", byte(3)))).read())
    println(unitSignal(()).read())
    // A type of two parameters, a method answering another instance.
    val p = intStringPair(1, "one")
    println(s"${p.firstOf()} ${p.secondOf()}")
    val q = p.swap()
    println(s"${q.firstOf()} ${q.secondOf()}")
    // Instances in collections.
    val signals = Vector.tabulate(10, i -> intSignal(i))
    println(total(signals))
    println(total([]))
    // A trait instance.
    val t = intThing(41)
    println(s"${t.get()} ${t.named()}")
    println(stringThing("held").get())
    println(thingSum(Vector.tabulate(100, i -> intThing(i))))
    t.close()
    s.close()
