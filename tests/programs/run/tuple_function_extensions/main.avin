// expect: exit 0
// Methods an impl in another module adds to tuples and to functions are seen by a file importing that
// module, called dotted, as method values and through a generic function, beside the core library's.
import pairs

turn[A, B](p: (A, B)) -> (B, A) = p.mirrored()

main()
    println((1, "a").mirrored(), (1, "a").swap().mirrored())
    println(turn(('x', 2.5)), ("only", 0).firstOr("none"))
    val later = (true, 3).mirrored
    println(later())
    val inc = (n: int) -> n + 1
    println(inc.times(0)(5), inc.times(3)(5), inc.andThen(n -> n * 2).times(2)(1))
