module boxes

// A type whose variant hides a type, made here and in another module, and taken apart in both.

data Box
  Hold[A: Display](value: A, label: string)
  Empty

// A value made at the caller's type: each copy makes its own pack.
held[A: Display](x: A) -> Box = Hold(x, "made in boxes")

// An arm in the type's own module, compiled for every pack the program makes, in either module.
describe(b: Box) -> string = b match
  Hold(v, label) -> s"$v ($label)"
  Empty -> "empty"
