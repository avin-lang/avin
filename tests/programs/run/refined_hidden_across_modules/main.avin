// expect: exit 0
// A variant of another module that hides a type: values made in either module, at packs of either
// module's types, are taken apart by the arms of both, each arm compiled for every pack.
import boxes
import boxes.{Hold, Empty, held, describe}

data Point(x: int, y: int)

local(b: boxes.Box) -> string = b match
  Hold(v, _) -> s"<$v>"
  Empty -> "<>"

main()
  val all = [held(1), held("two"), Hold(Point(3, 4), "made in main"), Hold(2.5, "real"), Empty]
  for b in all
    println(s"${describe(b)} ${local(b)}")
  println(held(1) == Hold(1, "made in boxes"))
  println(held(1) == held(long(1)))
