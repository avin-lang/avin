// expect: exit 0
// An Avin function passed to a binding's parameter of function type reaches Sysl as a closure: a
// lambda, a closure capturing locals or an object, a method value, a top-level function, a function
// value held in a variable, and a function a generic function passes on. Sysl calls it once, many
// times, keeps it and calls it later after the Avin side has let go of it, and drops it; each
// closure Sysl holds keeps its function alive, and lets it go when Sysl drops it.

@sysl("avintest.callbacks.apply")
apply(f: (int) -> int, x: int) -> int

@sysl("avintest.callbacks.apply_direct")
applyDirect(f: (int) -> int, x: int) -> int

@sysl("avintest.callbacks.sum_over")
sumOver(f: (int) -> int, n: int) -> int

@sysl("avintest.callbacks.repeat")
repeat(f: () -> unit, n: int)

@sysl("avintest.callbacks.ignore")
ignore(f: (int) -> int)

@sysl("avintest.callbacks.keep")
keep(f: (int) -> int)

@sysl("avintest.callbacks.kept_count")
keptCount() -> int

@sysl("avintest.callbacks.call_kept")
callKept(i: int, x: int) -> int

@sysl("avintest.callbacks.call_all_kept")
callAllKept(x: int) -> int

@sysl("avintest.callbacks.forget_kept")
forgetKept()

@sysl("avintest.callbacks.forget_last")
forgetLast()

@sysl("avin.rt.callbacks_held")
held() -> long

class Counter(var n: int)
    bump(by: int) -> int
        n += by
        n

class Scale(factor: int)
    times(x: int) -> int = x * factor

double(x: int) -> int = x * 2

// A generic function passing on a function of its type parameter's values.
viaGeneric[T](make: (T) -> int, value: T) -> int = apply(x -> make(value) + x, 1)

// Kept callbacks built in a function that returns, each capturing its own locals.
keepAdders(n: int)
    for i in 0..<n
        val label = s"adder $i"
        keep(x -> x + i + label.byteLength())

main()
    // Once, from a lambda, a top-level function, and a function value in a variable.
    println(apply(x -> x + 1, 41))
    println(apply(double, 21))
    val f: (int) -> int = x -> x * x
    println(apply(f, 7))
    println(applyDirect(x -> x - 1, 10))
    // Many times.
    println(sumOver(x -> x * 10, 5))
    var calls = 0
    repeat(() -> calls += 1, 1000)
    println(calls)
    repeat(() -> calls += 1, 0)
    println(calls)
    // A local function capturing a `var`, which every call updates.
    var total = 0
    addTo(x: int) -> int
        total += x
        total
    println(sumOver(addTo, 4))
    println(total)
    // An object captured, and a method value.
    val c = Counter(0)
    println(sumOver(x -> c.bump(x), 4))
    println(c.n)
    val s = Scale(3)
    println(apply(s.times, 14))
    println(apply(c.bump, 100))
    // Generic code passing a callback on.
    println(viaGeneric((t: string) -> t.byteLength(), "four"))
    println(viaGeneric((t: int) -> t * 2, 20))
    // A callback Sysl only takes is let go at once.
    ignore(x -> x)
    println(held())
    // Kept, then called after the Avin side has let go, the collector running in between.
    keepAdders(3)
    keep(s.times)
    keep(double)
    println(keptCount())
    println(held())
    var garbage: List[string] = []
    for i in 0..<2000
        garbage = s"$i" :: garbage
    println(callKept(0, 100))
    println(callKept(1, 100))
    println(callKept(2, 100))
    println(callKept(3, 100))
    println(callKept(4, 100))
    println(callAllKept(1))
    // Each drop gives its function back.
    forgetLast()
    println(held())
    forgetKept()
    println(held())
    println(keptCount())
    // The same lambda kept many times is many callbacks.
    for i in 0..<100
        keep(x -> x + i)
    println(held())
    println(callAllKept(0))
    forgetKept()
    println(held())
