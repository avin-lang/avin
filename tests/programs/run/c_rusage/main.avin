// expect: exit 0
// macOS's `proc_pid_rusage`, whose `rusage_info_t *` is a pointer to `void *` the kernel writes a
// `struct rusage_info_v2` through: the struct's bytes answered as `long`s, each field found by its
// offset; `errno` says why it failed, `ESRCH` for a process that does not exist. The same prototype
// read as a status alone answers `Err(-1)`.

import avin.c.{Errno, ESRCH}

@c(const: "RUSAGE_INFO_V2")
val rusageInfoV2: int

// The `long`s the fields are, after the 16 bytes of `ri_uuid`: `ri_resident_size` is the eighth
// `uint64_t` field and `ri_phys_footprint` the ninth.
val residentAt = 8
val footprintAt = 9

@c(
    "int proc_pid_rusage(int pid, int flavor, out rusage_info_t *buffer)",
    array: "buffer",
    length: "sizeof(struct rusage_info_v2)",
    errno
)
private rusage(pid: int, flavor: int) -> Result[Array[long], Errno]

@c("int proc_pid_rusage(int pid, int flavor, out rusage_info_t *buffer)", array: "buffer", length: "20 * 8")
private rusageStatus(pid: int, flavor: int) -> Result[Array[long], int]

@c("int getpid(void)")
private getpid() -> int

// The physical footprint of the process `pid`, in bytes, as Activity Monitor shows it.
footprintBytes(pid: int) -> Result[long, Errno] = rusage(pid, rusageInfoV2).map(info -> info(footprintAt))

main()
  val mine = rusage(getpid(), rusageInfoV2).ok.get
  println(mine.length)
  println(mine(footprintAt) > 0)
  println(mine(residentAt) > 0)
  println(footprintBytes(getpid()).ok.get > 0)
  println(footprintBytes(99999999))
  println(footprintBytes(99999999) == Err(ESRCH))
  println(rusageStatus(getpid(), rusageInfoV2).map(info -> info.length))
  println(rusageStatus(99999999, rusageInfoV2))
