// expect: trap
// A closed handle passed to a top-level binding stops the program at the call, naming its class, though
// the binding's other handle is open; the open one's methods still run.

@sysl("avintest.digits.Mark")
class Mark
  place() -> long

@sysl("avintest.digits.mark_at")
markAt(n: long) -> Mark

@sysl("avintest.digits.distance")
distance(a: Mark, b: Mark) -> long

main()
  val m = markAt(1)
  val n = markAt(4)
  println(distance(m, n))
  n.close()
  println(m.place())
  println(distance(m, n))
