// expect: exit 0
// An extension module adding to every `Pointed` constructor's applications, seen where it is
// imported: whole by `user`, and here through one of its declarations. The trait's own module adds
// `doubled`, which every file sees. A type's own `twice` is found before the extension's; generic
// code of the extension's module and function values reach the added methods too.
import extras.useTwice
import shapes.{Crate, Tin}
import user

main()
  println(user.bump(Some(1)))
  println(user.nested(Vector(Crate(1), Crate(2))).map(c -> c.item))
  println(Some(2).twice(n -> n * n))
  println(Crate("a").twice(s -> s + "!").item)
  println(Tin(1).twice(n -> n + 10).item)
  println(Vector(1, 2).rewrap())
  println(useTwice(Some(1)))
  println(useTwice(Crate(2)).item)
  println(useTwice(Tin(3)).item)
  println(Some(5).doubled(n -> n - 1))
  println(Crate(5).doubled(n -> n * 2).item)
  val added: ((int) -> int) -> Option[int] = Some(4).twice
  println(added(n -> n + 1))
  println(Some(Vector("x")).mapIn(s -> s + "y"))
