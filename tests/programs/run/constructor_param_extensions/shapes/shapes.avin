module shapes

import traits.Pointed

data Crate[T](item: T)

impl Pointed for Crate
  static point[X](value: X) -> Crate[X] = Crate(value)
  map[B](f: (T) -> B) -> Crate[B] = Crate(f(item))

// A type with a `twice` of its own, which every call on it finds before an extension's.
data Tin[T](item: T)

impl Pointed for Tin
  static point[X](value: X) -> Tin[X] = Tin(value)
  map[B](f: (T) -> B) -> Tin[B] = Tin(f(item))

impl[T] Tin[T]
  twice(f: (T) -> T) -> Tin[T] = Tin(f(item))
