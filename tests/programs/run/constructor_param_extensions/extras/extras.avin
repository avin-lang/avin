module extras

import traits.{Mappable, Pointed}

// An extension adding to every `Pointed`: seen by this module and by the files that import it.
impl[F[_]: Pointed, A] F[A]
  twice(f: (A) -> A) -> F[A] = applied(f).map(f)
  rewrap() -> F[F[A]] = F.point(self)
  private applied(f: (A) -> A) -> F[A] = map(f)

impl[F[_]: Mappable, G[_]: Mappable, A] F[G[A]]
  mapIn[B](f: (A) -> B) -> F[G[B]] = map(g -> g.map(f))

// Generic code of the extension's own module reaches its methods through its parameter's bound.
useTwice[F[_]: Pointed](x: F[int]) -> F[int] = x.twice(n -> n * 3)
