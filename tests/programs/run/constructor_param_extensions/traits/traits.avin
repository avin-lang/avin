module traits

trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]

trait Pointed[A]: Mappable[A]
  static pure[X](value: X) -> Self[X]

impl Pointed for Option
  static pure[X](value: X) -> Option[X] = Some(value)

impl Pointed for Vector
  static pure[X](value: X) -> Vector[X] = Vector(value)

// Written in the module of the trait bounding `F`, this impl is the trait's own: every file sees
// its methods, importing nothing.
impl[F[_]: Mappable, A] F[A]
  doubled(f: (A) -> A) -> F[A] = map(f).map(f)
