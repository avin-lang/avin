// expect: exit 0
// Memory of no type through a pointer to an opaque pointer, as Apple's `proc_pid_rusage` takes it:
// `aa_info_t` is `void *` in the headers, so a pointer to it points at memory of no type, as `void *`
// and `void **` do. C fills an array of any element type through one, as many bytes as `length:`
// says, rounded up to whole elements; C fills a struct mirror through one; and one passed in takes an
// array or a `ByteBlock`, told its length in bytes. A pointer to a typedef of an integer type is no
// such pointer: its length counts elements.

import avin.c.ByteBlock

@c(struct: "struct aa_counts")
data Counts(a: long, b: long, c: long)

@c("int aa_info(int flavor, out aa_info_t *buffer)", array: "buffer", length: "sizeof(struct aa_info_v1)")
private infoLongs(flavor: int) -> Result[Array[long], int]

@c("int aa_info(int flavor, out aa_info_t *buffer)", array: "buffer", length: "sizeof(struct aa_info_v1)")
private infoBytes(flavor: int) -> Result[Array[byte], int]

@c("int aa_info(int flavor, out aa_info_t *buffer)", array: "buffer", length: "sizeof(struct aa_info_v1)")
private infoInts(flavor: int) -> (int, Array[int])

@c("int aa_info(int flavor, out aa_info_t *buffer)", array: "buffer", length: "sizeof(struct aa_info_v1)")
private infoReals(flavor: int) -> Result[Array[real], int]

// 44 bytes are five and a half `long`s, so six, the last zero past what C writes.
@c("int aa_info(int flavor, out aa_info_t *buffer)", array: "buffer", length: "sizeof(struct aa_info_v1) + 4")
private infoRounded(flavor: int) -> Result[Array[long], int]

// A typedef of `const void *` is memory of no type too.
@c("int aa_info_const(int flavor, out aa_const_info_t *buffer)", array: "buffer", length: "sizeof(struct aa_info_v1)")
private infoConst(flavor: int) -> Result[Array[long], int]

@c("int aa_counts(out void *into, int k)", array: "into", length: "sizeof(struct aa_counts)")
private countsArray(k: int) -> Result[Array[long], int]

@c("int aa_counts(out void *into, int k)")
private countsVoid(k: int) -> Result[Counts, int]

@c("int aa_counts_pp(out void **into, int k)")
private countsPointer(k: int) -> Result[Counts, int]

@c("int aa_info_counts(out aa_info_t *buffer, int k)")
private countsInfo(k: int) -> Result[Counts, int]

@c("long long aa_info_sum(aa_info_t *p, length(p) size_t n)")
private infoSumLongs(p: Array[long]) -> long

@c("long long aa_info_sum(aa_info_t *p, length(p) size_t n)")
private infoSumBytes(p: Array[byte]) -> long

@c("long long aa_info_sum(aa_info_t *p, length(p) size_t n)")
private infoSumBlock(p: ByteBlock) -> long

@c("long long aa_info_sum(aa_info_t *p, length(p) size_t n)")
private infoSumMaybe(p: Option[Array[int]]) -> long

@c("long long aa_pp_sum(void **p, length(p) size_t n)")
private pointerSum(p: Array[int]) -> long

@c("void aa_info_fill(aa_info_t *p, int c, length(p) size_t n)")
private infoFill(p: Array[long], c: int)

// A pointer to a typedef of an integer type points at elements, which its length counts.
@c("long long aa_sum_fixed(const aa_fixed *p, length(p) long long n)")
private sumFixed(p: Array[long]) -> long

@c("int aa_info_octets(aa_octet *p, length(p) int n)")
private octets(p: Array[byte]) -> int

// Memory of no type C allocates is answered as its bytes.
@c("int aa_alloc_bytes(out void **into, int n, out int *len)", bytes: "into", length: "len", free: "free")
private allocBytes(n: int) -> Result[(Array[byte], int), int]

main()
  println(infoLongs(3))
  println(infoBytes(4))
  println(infoInts(5))
  println(infoReals(1).map(a -> a.length))
  println(infoRounded(6))
  println(infoConst(7))
  // A status that fails frees the memory unread.
  println(infoLongs(0))
  println(infoInts(10))
  println(countsArray(9))
  println(countsVoid(10))
  println(countsPointer(11))
  println(countsInfo(12))
  println(infoSumLongs([long(1), long(2), long(3)]))
  println(infoSumBytes([byte(1), byte(2), byte(3)]))
  println(infoSumLongs(Array.fill(0, long(0))))
  val block = ByteBlock(4)
  block.update(0, byte(9))
  block.update(3, byte(1))
  println(infoSumBlock(block))
  println(infoSumMaybe(Some([5, 6])))
  println(infoSumMaybe(None))
  println(pointerSum([5, 6]))
  val filled = Array.fill(2, long(0))
  infoFill(filled, 1)
  println(filled)
  println(sumFixed([long(10), long(20), long(30)]))
  val bytes = Array.fill(3, byte(0))
  println(octets(bytes))
  println(bytes)
  println(allocBytes(4))
  println(allocBytes(0))
