// expect: exit 0
// The JSON chapter's examples: reading an event, its accessors, setting a member, the accessors
// chained with `?`, and an error displayed with its place.
import json
import json.Json

exitCode(event: Json) -> Option[int] = event.get("result")?.get("exit")?.asInt()

main()
    val event = json.parse("{\"id\": 7, \"cmd\": \"make\", \"tags\": [\"a\", \"b\"]}") match
        Ok(j) -> j
        Err(e) -> fail(s"bad event: $e")
    println(event("cmd").asString())
    println(event.get("exit").flatMap(x -> x.asInt()))
    println(event.with("exit", Json.num(0)))
    println(exitCode(event))
    println(exitCode(json.parse("{\"result\": {\"exit\": 3}}").ok().get()))
    println(json.parse("[1,]").err().get())
    println(json.parse("\"\\ud800\"").err().get())
    println(json.parse("[01]").err().get())
    println(Json.obj(("a", Json.arr(Json.num(1), Json.num(2)))).pretty())
