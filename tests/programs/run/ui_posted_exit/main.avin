// expect: exit 0
// The program ends when `main` returns, as it always does: work still waiting for the main thread is
// never run, and a lightweight thread parked on an ask the main thread never handles does not keep
// the program alive.
import avin.threads.{Promise, spawn}
import ui.{inbox, post}

main()
  val shout = inbox((s: string) -> println(s"never: $s"))
  post(() -> println("never run"))
  _ = shout.send("queued")
  val asking = Promise[unit]()
  spawn(() ->
    asking.complete(())
    shout.ask("parked"))
  asking.future.await()
  println("main returns")
