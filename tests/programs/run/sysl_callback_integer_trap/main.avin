// expect: trap
// An integer Sysl gives a callback in a wider type is converted as a binding's integer result is: a
// value the callback's parameter cannot hold stops the program where the binding was called.

@sysl("avintest.callbacks.size_op")
sizeOp(f: (int) -> int, n: long) -> int

main()
    println(sizeOp(n -> n, 2147483647))
    println(sizeOp(n -> n, 2147483648))
