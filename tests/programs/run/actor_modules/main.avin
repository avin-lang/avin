// expect: exit 0
// An actor declared in another module: imported by name, `Squarer` makes its behaviour, with its
// default and with an argument; through the module, `workers.Squarer` does. A private actor of that
// module is started from the behaviour a public function of the module gives back, and its
// reference is shown by the declaration's name.
import workers
import workers.{Squarer, Square, Twice, doubler}
import avin.actors.spawn
import avin.threads.Promise

main()
  val plain = spawn(Squarer())
  val shifted = spawn(workers.Squarer(100))
  val a = Promise[int]()
  plain.tell(Square(7, a))
  val b = Promise[int]()
  shifted.tell(Twice(4, b))
  println(s"${a.future.await()} ${b.future.await()}")
  val d = spawn(doubler())
  val c = Promise[int]()
  d.tell((5, c))
  println(c.future.await())
  println(s"$plain $shifted $d")
