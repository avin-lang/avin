module workers

// This module declares actors without importing `avin.actors`: a declaration makes its behaviour
// from that module all the same. Its actors reach the module's private function, and its private
// actor is handed out through a public function, its behaviour's type named through the library's
// module.
import avin.threads.Promise

data Job
  Square(n: int, reply: Promise[int])
  Twice(n: int, reply: Promise[int])

private double(n: int) -> int = n * 2

actor Squarer(offset: int = 0) receives Job
  receive
    Square(n, reply) -> reply.complete(n * n + offset)
    Twice(n, reply) -> reply.complete(double(n) + offset)

private actor Doubler receives (int, Promise[int])
  receive
    (n, reply) -> reply.complete(double(double(n)))

doubler() -> avin.actors.Behaviour[(int, Promise[int])] = Doubler()
