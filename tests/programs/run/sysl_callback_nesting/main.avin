// expect: exit 0
// Calls nest: Avin calls Sysl, which calls an Avin callback, which calls Sysl again, a hundred deep,
// each level allocating, so the collector runs with every level's objects live. A callback made
// while its thread waits in a blocking call makes the thread running first, and safe again after,
// while other threads go on allocating and collecting; a blocking call may itself be made from
// inside a callback another blocking call runs.
import avin.threads.spawn

@sysl("avintest.callbacks.apply")
apply(f: (int) -> int, x: int) -> int

@sysl("avintest.callbacks.text_op")
textOp(f: (string) -> string, s: string) -> string

@sysl("avintest.callbacks.apply_after", blocking)
applyAfter(f: (int) -> int, x: int, ms: long) -> int

@sysl("avintest.callbacks.keep")
keep(f: (int) -> int)

@sysl("avintest.callbacks.keep_relay")
keepRelay(i: int)

@sysl("avintest.callbacks.call_kept")
callKept(i: int, x: int) -> int

@sysl("avintest.callbacks.forget_kept")
forgetKept()

@sysl("avin.rt.callbacks_held")
held() -> long

// Each level holds a list it made before going deeper, and checks it after.
depth(n: int) -> int
    if n == 0 then return 0
    val mine = [n, n + 1, n + 2].toList()
    val below = apply(x -> depth(x - 1) + 1, n)
    if mine.sum() != 3 * n + 3 then -1000 else below

// The same through strings, which each level converts both ways.
spell(n: int) -> string = if n == 0 then "" else textOp(s -> s + spell(n - 1), s"$n.")

churn(rounds: int) -> int
    var kept: List[string] = []
    for r in 0..<rounds
        kept = s"r$r" :: kept
        if r % 50 == 0 then kept = []
    kept.length()

main()
    println(depth(100))
    println(depth(1))
    println(depth(0))
    println(spell(12))
    // A kept callback whose call goes through Sysl to another kept callback.
    keep(x -> x * 2)
    keepRelay(0)
    keep(x -> callKept(1, x) + 1)
    println(callKept(2, 20))
    forgetKept()
    println(held())
    // Called from inside a blocking call, alone and while other threads collect.
    println(applyAfter(x -> x + churn(500), 1, 1))
    val others = [spawn(() -> churn(20000)), spawn(() -> churn(20000))]
    var results: List[int] = []
    for i in 0..<20
        results = applyAfter(x -> [x, x].toList().sum() + churn(100), i, 2) :: results
    println(results.reverse())
    for t in others do println(t.join())
    // A blocking call inside a callback another blocking call runs.
    println(applyAfter(x -> applyAfter(y -> y * 3, x + 1, 1) + 1, 4, 1))
    println(held())
