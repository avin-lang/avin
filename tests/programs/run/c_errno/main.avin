// expect: exit 0
// A binding marked `errno` answers `Err` of `errno` where C answers -1, read straight after the call,
// and `Ok` of the C result and the out values otherwise: as an `Errno`, by name, or as the number
// itself, an integer of any type; the C result kept or left out, through an `int`, a `long` or an
// `ssize_t`; out values read only where C did not fail; a C function that sets `errno` and answers no
// -1 has not failed; a number no named case is is `Other`; and a `blocking` call reads `errno` where it
// ran.

import avin.c.{Errno, EINVAL, ENOENT, EACCES, Other}

@c(const: "EINVAL")
val einval: int

@c(const: "ENOENT")
val enoent: int

@c(const: "EACCES")
val eacces: int

@c("int aa_errno(int code, int value)", errno)
private failing(code: int, value: int) -> Result[int, Errno]

@c("int aa_errno(int code, int value)", errno)
private failingCode(code: int, value: int) -> Result[int, int]

@c("int aa_errno(int code, int value)", errno)
private failingWide(code: int, value: int) -> Result[long, long]

@c("int aa_errno(int code, int value)", errno)
private failingUnit(code: int, value: int) -> Result[unit, Errno]

@c("long aa_errno_long(int code, long value)", errno)
private failingLong(code: int, value: long) -> Result[long, Errno]

@c("ssize_t aa_errno_ssize(int code, ssize_t value)", errno)
private failingSize(code: int, value: long) -> Result[long, Errno]

@c("size_t aa_errno_size(int code, size_t value)", errno)
private failingUnsigned(code: int, value: long) -> Result[long, Errno]

@c("int aa_errno_out(int code, int value, out int *out)", errno)
private failingOut(code: int, value: int) -> Result[int, Errno]

@c("int aa_errno_out(int code, int value, out int *out)", errno)
private failingBoth(code: int, value: int) -> Result[(int, int), Errno]

@c("int aa_errno_set(int code, int value)", errno)
private setting(code: int, value: int) -> Result[int, Errno]

@c("int aa_errno(int code, int value)", errno, blocking)
private failingBlocked(code: int, value: int) -> Result[int, Errno]

@c("int aa_info(int flavor, out aa_info_t *buffer)", array: "buffer", length: "sizeof(struct aa_info_v1)", errno)
private info(flavor: int) -> Result[Array[long], Errno]

@c("int access(const char *path, int mode)", errno)
private access(path: string, mode: int) -> Result[unit, Errno]

@c("int chdir(const char *path)", errno)
private chdir(path: string) -> Result[unit, int]

// Why `path` cannot be read, in words.
describe(path: string) -> string = access(path, 4) match
  Ok(()) -> "readable"
  Err(ENOENT) -> "missing"
  Err(EACCES) -> "forbidden"
  Err(e) -> e.message

main()
  println(failing(0, 5))
  println(failing(einval, 5))
  println(failing(einval, 5) == Err(EINVAL))
  println(failingCode(einval, 0) == Err(einval))
  println(failingCode(0, -2))
  println(failingWide(enoent, 0) == Err(long(enoent)))
  println(failingUnit(0, 9))
  println(failingUnit(eacces, 9) == Err(EACCES))
  println(failingLong(0, long(1) << 40))
  println(failingLong(einval, 0))
  println(failingSize(0, 7))
  println(failingSize(enoent, 7))
  println(failingUnsigned(0, 8))
  println(failingUnsigned(enoent, 8))
  println(failingOut(0, 42))
  println(failingOut(einval, 42))
  println(failingBoth(0, 43))
  // A number no named case is, and zero, which a C function answering -1 without setting `errno`
  // leaves.
  println(failing(9999, 0))
  println(failing(9999, 0) == Err(Other(9999)))
  println(setting(einval, 3))
  println(setting(0, -1))
  println(failingBlocked(enoent, 1) == Err(ENOENT))
  println(failingBlocked(0, 1))
  println(info(2).map(a -> a(4)))
  println(info(0))
  println(describe("/no/such/file"))
  println(describe("/"))
  println(chdir("/no/such/directory") == Err(enoent))
  println(chdir("/"))
