package { name = "c-errno", version = "0.1.0" }

// The C library in tests/c, which the test harness builds and names to `pkg-config`, and the C
// library's own functions, which set `errno`.
c-libraries {
  arrays { pkg-config = "avin-c-fixture", headers = ["avin_arrays.h"] }
  libc { headers = ["<errno.h>", "<unistd.h>"] }
}
