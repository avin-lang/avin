// expect: trap
// A handle C lends a callback is null-checked as a handle a binding answers: `None` for an `Option`,
// and a stop for the class itself.

@c(type: "cb_registry *", release: "cb_registry_unref", retain: "cb_registry_ref")
class Registry
    @c("int cb_registry_visit(cb_registry *self, int (*f)(userdata void *ud, cb_registry *self), userdata void *ud, int null)")
    visit(f: Registry -> int, null: int) -> int

@c("cb_registry *cb_registry_new(void)")
newRegistry() -> Registry

main()
    val r = newRegistry()
    println(r.visit(x -> 5, 0))
    println(r.visit(x -> 6, 1))
