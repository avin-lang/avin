// expect: exit 0
// `import geo` binds the module under its last segment, and `as` renames it. A module's public
// types, functions, values, objects and variants are reached through that name, in type position
// too. A local of the same name as the module hides it.
import geo
import geo as g

describe(p: geo.Point) -> int = geo.area(p)

main()
  val p: geo.Point = geo.Point(3, 4)
  println(s"${describe(p)}")
  println(s"${geo.area(5)}")
  println(s"${g.area(p) + g.unit}")
  println(s"${geo.Origin.at.sum()}")
  println(s"${geo.reveal()}")
  val shape = geo.Dot(p)
  val n = shape match
    geo.Dot(q) -> q.sum()
    _ -> 0
  println(s"${n}")
  val geo = Local(2)
  println(s"${geo.v}")

class Local(val v: int)
