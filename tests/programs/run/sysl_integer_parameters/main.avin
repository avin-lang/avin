// expect: exit 0
// A binding's integer parameter goes into whatever integer the Sysl parameter is, converted with a
// check: Avin has no unsigned integers, so a Sysl `u32` takes an Avin `int` or `long`, and each width
// and sign takes every value it holds, its smallest and largest included, from either.

@sysl("avintest.digits.show_u8")
showU8(x: int) -> string

@sysl("avintest.digits.show_u8")
showU8Long(x: long) -> string

@sysl("avintest.digits.show_u16")
showU16(x: int) -> string

@sysl("avintest.digits.show_u16")
showU16Long(x: long) -> string

@sysl("avintest.digits.show_u32")
showU32(x: long) -> string

@sysl("avintest.digits.show_u32")
showU32Int(x: int) -> string

@sysl("avintest.digits.show_u64")
showU64(x: long) -> string

@sysl("avintest.digits.show_u64")
showU64Int(x: int) -> string

@sysl("avintest.digits.show_usize")
showUsize(x: long) -> string

@sysl("avintest.digits.show_i8")
showI8(x: int) -> string

@sysl("avintest.digits.show_i8")
showI8Long(x: long) -> string

@sysl("avintest.digits.show_i16")
showI16(x: int) -> string

@sysl("avintest.digits.show_i16")
showI16Long(x: long) -> string

// A `long` reaches an `i32` parameter where its value fits, and an `int` an `i64` always.
@sysl("avintest.digits.show_i32")
showI32(x: long) -> string

@sysl("avintest.digits.show_i64")
showI64(x: int) -> string

// Avin's own narrow integers convert too.
@sysl("avintest.digits.show_u8")
showU8FromI8(x: i8) -> string

@sysl("avintest.digits.show_u32")
showU32FromI16(x: i16) -> string

@sysl("avintest.digits.show_i8")
showI8FromI16(x: i16) -> string

// A byte is a Sysl `u8` itself.
@sysl("avintest.digits.show_u8")
showByte(x: byte) -> string

// Each parameter of one call is converted on its own.
@sysl("avintest.digits.show_mixed")
showMixed(a: int, b: int, c: long) -> string

main()
    println(showU8(0))
    println(showU8(255))
    println(showU8Long(255))
    println(showU16(0))
    println(showU16(65535))
    println(showU16Long(65535))
    println(showU32(0))
    println(showU32(4294967295))
    println(showU32Int(2147483647))
    println(showU64(0))
    println(showU64(9223372036854775807))
    println(showU64Int(2147483647))
    println(showUsize(0))
    println(showUsize(9223372036854775807))
    println(showI8(-128))
    println(showI8(0))
    println(showI8(127))
    println(showI8Long(-128))
    println(showI16(-32768))
    println(showI16(32767))
    println(showI16Long(32767))
    println(showI32(-2147483648))
    println(showI32(2147483647))
    println(showI64(-2147483648))
    println(showU8FromI8(127))
    println(showU8FromI8(0))
    println(showU32FromI16(32767))
    println(showI8FromI16(-128))
    println(showByte(byte(200)))
    println(showMixed(7, -3, 4000000000))
    // A value made at run time is checked the same way as a literal.
    var total = 0
    for i in 0..<300
        val shown = showU8(i % 256)
        total += shown.byteLength()
    println(total)
