// expect: exit 0
// A callback's integer answer is converted, with a check, into whatever integer the closure Sysl
// takes answers: a Sysl `u32`, `u16`, `u8`, `u64` or `usize` answer, which Avin has no type for, is
// given by a `long` or an `int`, and a narrower signed answer by a wider Avin integer. Every value
// the Sysl type holds crosses, its bounds included, on every path a callback is called by.

@sysl("avintest.callbacks.answer_u32")
answerU32(f: () -> long) -> long

@sysl("avintest.callbacks.answer_u32")
answerU32FromInt(f: () -> int) -> long

@sysl("avintest.callbacks.answer_u16")
answerU16(f: () -> long) -> long

@sysl("avintest.callbacks.answer_u8")
answerU8(f: () -> int) -> long

@sysl("avintest.callbacks.answer_u64")
answerU64(f: () -> long) -> string

@sysl("avintest.callbacks.answer_usize")
answerUsize(f: (int) -> long, x: int) -> long

@sysl("avintest.callbacks.answer_i8")
answerI8(f: () -> long) -> int

@sysl("avintest.callbacks.answer_i16")
answerI16(f: () -> int) -> int

@sysl("avintest.callbacks.sum_u32")
sumU32(f: (int) -> long, n: int) -> long

@sysl("avintest.callbacks.answer_any")
answerAny(f: () -> long) -> long

@sysl("avintest.callbacks.answer_any")
answerAnyInt(f: () -> int) -> int

@sysl("avintest.callbacks.answer_u32_after", blocking)
answerU32After(f: () -> long, ms: long) -> long

@sysl("avintest.callbacks.keep_unsigned")
keepUnsigned(f: (int) -> long)

@sysl("avintest.callbacks.call_kept_unsigned")
callKeptUnsigned(x: int) -> long

@sysl("avintest.callbacks.forget_kept_unsigned")
forgetKeptUnsigned()

@sysl("avintest.callbacks.answer_u32_on_thread")
answerU32OnThread(@threaded f: (int) -> long, x: int) -> long

@sysl("avintest.callbacks.Box")
class Box
    applyUnsigned(f: (long) -> long) -> long

@sysl("avintest.callbacks.new_box")
newBox(n: long) -> Box

class Palette(val base: long)
    colour(shade: int) -> long = base + long(shade)

main()
    // In range, zero and the largest `u32`, from a lambda, a constant and an `int`.
    println(answerU32(() -> 0x336699))
    println(answerU32(() -> 0))
    println(answerU32(() -> 4294967295))
    println(answerU32FromInt(() -> 2147483647))
    // The other unsigned widths, each at its bounds.
    println(answerU16(() -> 0))
    println(answerU16(() -> 65535))
    println(answerU8(() -> 0))
    println(answerU8(() -> 255))
    println(answerU64(() -> 0))
    println(answerU64(() -> 9223372036854775807))
    println(answerUsize(x -> long(x) * 2, 21))
    // A narrower signed answer from a wider Avin integer.
    println(answerI8(() -> -128))
    println(answerI8(() -> 127))
    println(answerI16(() -> -32768))
    // Called many times by Sysl, each answer checked.
    println(sumU32(i -> long(i) * 1000000, 100))
    // A closure capturing a local and an object, and a method value.
    val base: long = 0x100000
    println(answerU32(() -> base + 0xFF))
    val palette = Palette(0xFF0000)
    println(answerU32(() -> palette.colour(0x10)))
    println(sumU32(palette.colour, 3))
    // A generic Sysl function whose closure answers its type parameter takes the Avin type.
    println(answerAny(() -> 9223372036854775807))
    println(answerAnyInt(() -> -2147483648))
    // While the thread is safe for the collector, kept for later, on a handle's method, and on a
    // thread Sysl started.
    println(answerU32After(() -> 4294967295, 1))
    var shade = 7
    keepUnsigned(x -> long(x + shade))
    shade = 8
    println(callKeptUnsigned(1))
    forgetKeptUnsigned()
    println(newBox(41).applyUnsigned(n -> n + 1))
    println(answerU32OnThread(x -> long(x) * 3, 1431655765))
    // Many answers while the collector runs.
    var total: long = 0
    for i in 0..<2000
        val words = Array.fill(16, i)
        total += answerU32(() -> long(words.length() + i))
    println(total)
