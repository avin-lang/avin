// expect: trap
// An enumerator no variant of the mirror holds, which C calls a callback with, stops the program
// where the binding was called.

@c(enum: "cb_level", prefix: "CB_")
data Level
    Low
    Mid
    High

@c("cb_level cb_level_of(cb_level (*f)(userdata void *ud, cb_level x), userdata void *ud, int x)")
levelOf(f: Level -> Level, x: int) -> Level

main()
    println(levelOf(x -> x, 7))
    println(levelOf(x -> x, 3))
