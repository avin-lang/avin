// expect: exit 0
// A function declared with `def` and no parameter list in another module is read through the
// module, `clock.now`, and by its imported name, `now`, each read running it again. Parentheses
// after it call what it yields, a function or a sequence given an index; a lambda gives a function
// that reads it.
import clock
import clock.{now, stamp}

main()
  println(clock.now)
  println(clock.now)
  println(now)
  println(s"${now} ${clock.now}")
  println(stamp)
  println(clock.stamp)
  println(clock.adder(100))
  println(clock.history(1))
  println(clock.peek)
  val f: () -> int = () -> clock.now
  println(f() + f())
  println(clock.now.toString() + "!")
