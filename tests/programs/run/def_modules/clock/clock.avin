module clock

// Functions declared with `def` and no parameter list, read from another module: each read runs the
// body again, here against the module's own counter.

private var ticks = 0

def now -> int
  ticks += 1
  ticks

def stamp -> string = s"t$now"
def adder -> (int) -> int = x -> x + now
def history -> Vector[int] = [now, now]
private def hidden -> int = 99
def peek -> int = hidden + ticks
