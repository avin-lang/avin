// expect: exit 0
// A control given a state reads and writes it through the state's signal: a tap's write is the
// state's value at once, with no build in between, and a set from Avin is what the control shows
// on the next build. Neither direction writes back into the other, so a write is one write.
import ui.{Rect, State, View, checkbox, column, component, radio, radioGroup, recorder, root, scroll, slider, snapshot, state, switch, tabs, tap, text, textArea, textField, writes}

val Screen = Rect(0, 0, 400, 300)

shown(v: View) -> string = snapshot(v, recorder(), Screen).dump()

main()
    // A switch and a checkbox over one state: each tap flips it, and the other shows it.
    val on = state(false)
    tap(switch(on).named("sw"), "sw", Screen)
    println(on.get())
    val w0 = writes()
    tap(checkbox(on, "Check").named("cb"), "cb", Screen)
    println(s"${on.get()} ${writes() - w0}")
    on.set(true)
    println(shown(switch(on)))
    println(shown(checkbox(on, "Check")))
    on.set(false)
    println(shown(checkbox(on, "Check")))
    // A radio, a group and tabs over an int state.
    val chosen = state(0)
    tap(radio(chosen, 2, "Two").named("two"), "two", Screen)
    println(chosen.get())
    tap(radioGroup(["Red", "Green", "Blue"], chosen), "@2", Screen)
    println(chosen.get())
    chosen.set(2)
    println(shown(radioGroup(["Red", "Green", "Blue"], chosen)))
    tap(tabs(["One", "Two", "Three"], chosen, i -> text(s"body $i")), "@1", Screen)
    println(chosen.get())
    chosen.set(1)
    println(shown(tabs(["One", "Two", "Three"], chosen, i -> text(s"body $i"))))
    // Sliders over int and real states, stepped and not: the tap moves the value under the pointer,
    // and a value set from Avin is drawn where it is.
    val level = state(0)
    tap(slider(level, 0, 100, 200).named("level"), "level", Screen)
    println(0 < level.get() < 100)
    level.set(100)
    val atTop = shown(slider(level, 0, 100, 200))
    level.set(0)
    println(atTop != shown(slider(level, 0, 100, 200)))
    val gain = state(0.0)
    tap(slider(gain, 0.0, 1.0, 200).named("gain"), "gain", Screen)
    println(0.0 < gain.get() < 1.0)
    val stepped = state(0)
    tap(slider(stepped, 0, 100, 200, step = 30).named("stepped"), "stepped", Screen)
    println(stepped.get() % 30 == 0 && stepped.get() > 0)
    // Text fields and areas show their state's text, Unicode and empty included; what the field
    // writes is its signal, the state's own, so the state reads it at once.
    val draft = state("héllo ✓")
    println(shown(textField(draft, 1, hint = "name")))
    State.signal(draft).set("typed")
    println(draft.get())
    draft.set("")
    println(shown(column([textField(draft, 1, hint = "empty"), textArea(state("two\nlines"), 2, rows = 2)])))
    // A scroll over an int state.
    val offset = state(0)
    offset.set(16)
    println(shown(scroll(column((0..<10).map(i -> text(s"line $i")).toVector()), offset, 48)).contains("line 1"))
    // Inside a component, the state the component keeps is the control's: a tap is seen on the
    // next build, and kept for the builds after.
    val build = root(() -> component c ->
        val done = c.state(false)
        val amount = c.state(10)
        column([checkbox(done, "Done").named("done"), slider(amount, 0, 100, 200, step = 50).named("amount"), text(s"done=${done.get()} amount=${amount.get()}")]))
    var v = build()
    println(shown(v).contains("done=false amount=10"))
    tap(v, "done", Screen)
    tap(v, "amount", Screen)
    v = build()
    println(shown(v).contains("done=true amount=50"))
    v = build()
    println(shown(v).contains("done=true amount=50"))
    tap(v, "done", Screen)
    println(shown(build()).contains("done=false amount=50"))
