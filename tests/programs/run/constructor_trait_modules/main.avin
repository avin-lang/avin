// expect: exit 0
// A constructor trait of one module, implemented in the type's module and in the trait's: generic
// code of the trait's module, called from a third, reaches each type's own method directly, and the
// trait's default body is compiled for each constructor.
import traits
import traits.incr
import shapes.Crate

main()
  println(incr[Crate](Crate(1)).item)
  println(incr[Option](Some(2)))
  println(traits.incr[Option](None))
  println(Crate(3).doubled().item)
  println(Some("a").doubled())
