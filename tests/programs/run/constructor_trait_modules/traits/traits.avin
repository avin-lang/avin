module traits

// A constructor trait and generic code bounded by it, which knows nothing of the types that
// implement it in other modules.
trait Mappable[A]
  map[B](f: (A) -> B) -> Self[B]
  doubled() -> Self[(A, A)] = map(a -> (a, a))

incr[F[_]: Mappable](x: F[int]) -> F[int] = x.map(n -> n + 1)

// The trait's module may make a type of another module conform.
impl Mappable for Option
