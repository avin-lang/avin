// expect: exit 0
// The C library's `void *` parameters: `sysctlbyname` writes an `int` or a `long` into an array of
// one, told its length in bytes and answering how many it wrote; `None` asks the size it needs; an
// array too short is refused by C; and `write` reads the bytes of an array of any element type
// through `const void *`; a `void *` result is discarded.

@c(
  "int sysctlbyname(const char *name, void *oldp, length(oldp) inout size_t *oldlenp, void *newp, length(newp) size_t newlen)"
)
private sysctlInt(name: string, old: Option[Array[int]], new: Option[Array[byte]]) -> (int, long)

@c("int sysctlbyname(const char *name, void *oldp, length(oldp) inout size_t *oldlenp, null void *newp, size_t newlen)")
private sysctlLong(name: string, old: Array[long], newlen: long) -> (int, long)

@c("int sysctlbyname(const char *name, void *oldp, length(oldp) inout size_t *oldlenp, null void *newp, size_t newlen)")
private sysctlBytes(name: string, old: Array[byte], newlen: long) -> (int, long)

// A `void *` result is discarded by a binding answering `unit`.
@c("void *memchr(const void *s, int c, length(s) size_t n)")
private scan(s: Array[long], c: int)

@c("ssize_t write(int fd, const void *buf, length(buf) size_t nbyte)")
private writeInts(fd: int, buf: Array[int]) -> long

@c("ssize_t write(int fd, const void *buf, length(buf) size_t nbyte)")
private writeBytes(fd: int, buf: Array[byte]) -> long

// The value of the `int` sysctl `name`, where there is one.
intOf(name: string) -> Option[int] =
  val v = Array.fill(1, 0)
  sysctlInt(name, Some(v), None) match
    (0, 4) -> Some(v(0))
    _ -> None

main()
  val cpus = intOf("hw.ncpu").get
  println(cpus >= 1)
  println(intOf("kern.maxfilesperproc").get > 0)
  println(intOf("no.such.name"))
  val memory = Array.fill(1, long(0))
  println(sysctlLong("hw.memsize", memory, 0))
  println(memory(0) > long(cpus))
  // An `int` written into the first four of a `long`'s eight bytes.
  val wide = Array.fill(1, long(0))
  println(sysctlLong("hw.ncpu", wide, 0))
  println(wide(0) == long(cpus))
  println(sysctlInt("hw.memsize", None, None))
  val (short, _) = sysctlBytes("hw.ncpu", Array.fill(2, byte(0)), 0)
  println(short)
  val text = Array.fill(16, byte(0))
  val (status, used) = sysctlBytes("kern.ostype", text, 0)
  println(status)
  println(string.fromUtf8(text.slice(0, int(used) - 1)))
  // Four bytes of one `int`, written as they are, after what was printed before them.
  StandardOutput.flush()
  println(writeInts(1, [int('o') | int('k') << 8 | int('!') << 16 | int('\n') << 24]))
  println(writeBytes(1, Array.fill(0, byte(0))))
  scan([long(1), long(2)], 2)
  println("scanned")
