// expect: exit 0
// A callback's parameters are any type that crosses out of Sysl and its result any type that crosses
// into Sysl: each scalar at its limits, `unit`, strings with Unicode, arrays of bytes and of numbers,
// vectors, options, results, tuples, mirrors of a Sysl struct and enum, and handles, given to the
// callback and answered by it. An integer Sysl gives in a wider type is checked as a result is.

@sysl("avintest.callbacks.twice_long")
twiceLong(f: (long) -> long, x: long) -> long

@sysl("avintest.callbacks.small")
small(f: (i8, i16) -> i16, a: i8, b: i16) -> i16

@sysl("avintest.callbacks.byte_op")
byteOp(f: (byte) -> byte, b: byte) -> byte

@sysl("avintest.callbacks.real_op")
realOp(f: (real) -> real, x: real) -> real

@sysl("avintest.callbacks.char_op")
charOp(f: (char) -> char, c: char) -> char

@sysl("avintest.callbacks.bool_op")
boolOp(f: (bool) -> bool, b: bool) -> bool

@sysl("avintest.callbacks.text_op")
textOp(f: (string) -> string, s: string) -> string

@sysl("avintest.callbacks.unit_op")
unitOp(f: (unit, int) -> unit, n: int)

@sysl("avintest.callbacks.size_op")
sizeOp(f: (int) -> int, n: long) -> int

@sysl("avintest.callbacks.bytes_op")
bytesOp(f: (Array[byte]) -> Array[byte]) -> long

@sysl("avintest.callbacks.option_op")
optionOp(f: (Option[string]) -> Option[int]) -> string

@sysl("avintest.callbacks.result_op")
resultOp(f: (Result[int, string]) -> Result[string, int]) -> string

@sysl("avintest.callbacks.vector_op")
vectorOp(f: (Vector[int]) -> Vector[int]) -> int

@sysl("avintest.callbacks.array_op")
arrayOp(f: (Array[int]) -> Array[int], n: int) -> int

@sysl("avintest.callbacks.tuple_op")
tupleOp(f: ((int, string)) -> (string, int)) -> string

@sysl("avintest.callbacks.Point")
data Point(x: int, y: int)

@sysl("avintest.callbacks.Shape")
data Shape
    Dot
    Circle(radius: int)
    Label(text: string, at: Point)

@sysl("avintest.callbacks.point_op")
pointOp(f: (Point) -> Point) -> int

@sysl("avintest.callbacks.shape_op")
shapeOp(f: (Shape) -> Shape) -> string

@sysl("avintest.callbacks.Box")
class Box
    get() -> long
    // A handle's method taking a callback, and one that waits before calling it.
    applyTo(f: (long) -> long) -> long
    @sysl(blocking)
    applyLater(f: (long) -> long, ms: long) -> long

@sysl("avintest.callbacks.new_box")
newBox(n: long) -> Box

@sysl("avintest.callbacks.given_back")
givenBack() -> long

@sysl("avintest.callbacks.with_box")
withBox(f: (Box) -> long) -> long

@sysl("avintest.callbacks.make_box")
makeBox(f: (long) -> Box, n: long) -> long

@sysl("avintest.callbacks.combine")
combine(f: (string) -> Option[string], g: (Option[string]) -> Result[long, string], s: string) -> string

@sysl("avintest.callbacks.Spot")
class Spot
    place() -> long

@sysl("avintest.callbacks.spot_at")
spotAt(n: long) -> Spot

@sysl("avintest.callbacks.with_spot")
withSpot(f: (Spot) -> Spot) -> long

main()
    println(twiceLong(x -> x + 1, 9223372036854775805))
    println(twiceLong(x -> x / 2, -9223372036854775808))
    println(small((a, b) -> b + i16(a), -128, 32767))
    println(small((a, b) -> i16(a) + b, 127, -32768))
    println(byteOp(b -> b ^ byte(255), byte(15)))
    println(realOp(x -> x * 2.5, -1.5))
    println(charOp(c -> if c == 'é' then '😀' else c, 'é'))
    println(charOp(c -> c, '\u{0}') == '\u{0}')
    println(boolOp(b -> !b, true))
    println(boolOp(b -> !b, false))
    println(textOp(s -> s + "|" + s, "añ😀"))
    println(textOp(s -> s"[${s}]", ""))
    var units = 0
    unitOp((u, n) -> units += n, 7)
    println(units)
    println(sizeOp(n -> n + 1, 2147483646))
    println(bytesOp(b -> [b(2), b(1), b(0), byte(250)]))
    println(bytesOp(b -> []))
    println(optionOp(o -> o.map(s -> s.byteLength())))
    println(optionOp(o -> None))
    println(resultOp(r -> r match
        Ok(n) -> Err(n * 2)
        Err(e) -> Ok(e + "!")))
    println(vectorOp(v -> v.map(x -> x * 10)))
    println(vectorOp(v -> Vector()))
    println(arrayOp(a -> [a.length, a.length], 4))
    println(arrayOp(a -> a, 0))
    println(tupleOp(t -> t match
        (n, s) -> (s"$s$n", n + 1)))
    println(pointOp(p -> Point(p.y * 10, p.x * 100)))
    println(shapeOp(s -> s match
        Dot -> Circle(1)
        Circle(r) -> Label(s"r$r", Point(r, -r))
        Label(t, at) -> Label(t + t, Point(at.y, at.x))))
    // A handle given to a callback, kept by the program after the callback returns.
    var kept: Option[Box] = None
    println(withBox(b ->
        kept = Some(b)
        b.get() + 2))
    println(kept.map(b -> b.get()))
    // A handle the callback answers: one the program made, and one made in the callback.
    val made = newBox(5)
    println(makeBox(n -> made, 0))
    println(made.get())
    println(makeBox(n -> newBox(n * 3), 14))
    println(withSpot(s -> spotAt(s.place() + 1)))
    println(withSpot(s -> s))
    // Through a handle's methods.
    val box = newBox(8)
    println(box.applyTo(n -> n * n))
    println(box.applyLater(n -> n + long(s"$n".byteLength()), 1))
    // Two callbacks in one call.
    measure(o: Option[string]) -> Result[long, string] = o match
        Some(t) -> Ok(long(t.byteLength()))
        None -> Err("empty")
    println(combine(s -> if s.isEmpty() then None else Some(s + s), measure, "ab"))
    println(combine(s -> None, measure, "ab"))
