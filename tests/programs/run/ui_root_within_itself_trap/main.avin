// expect: trap
// A root built while it is being built would build its components twice in one build, so it stops
// the program; another root built inside a component's build is its own tree and is fine.
import ui.{View, column, component, root, text}

var again: () -> View = () -> text("")

main()
    val other = root(() -> component(c -> text(s"${c.state(3).get()}")))
    val outer = root(() -> component(c -> column([text("outer"), other()])))
    outer()
    println("another root inside")
    again = root(() -> component(c -> again()))
    again()
    println("never")
