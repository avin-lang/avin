// expect: trap
// An unsigned Sysl result too large for the binding's `long` traps where the result is converted,
// rather than arriving negative.

@sysl("avintest.digits.digit_count_u64")
countU64(n: long) -> long

@sysl("avintest.digits.largest_u64")
largest() -> long

main()
  println(countU64(-1000))
  println(largest())
