// expect: trap
// A glyph's bitmap lent by a field accessor is closed by the face's next load, which frees and replaces
// the buffer: a read after it stops the program at the read, naming the view and its lender.
import avin.c.ByteView

@c(type: "bf_face *", release: "bf_face_unref", retain: "bf_face_ref")
class Face
    @c(field: "glyph->bitmap.buffer", view, length: "self->glyph->bitmap.pitch * self->glyph->bitmap.rows")
    bitmap() -> Option[ByteView]

    @c("void bf_face_load(bf_face *self, int rows, int width, int pitch, int fill)")
    load(rows: int, width: int, pitch: int, fill: int)

@c("bf_face *bf_face_new(void)")
newFace() -> Face

main()
    val f = newFace()
    f.load(2, 2, 2, 5)
    val v = f.bitmap().get()
    println(v(0))
    f.load(2, 2, 2, 6)
    println(v(0))
