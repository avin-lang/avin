// expect: trap
// A handle used by a thread while another owns it stops the program, here as a parameter of a
// binding: the thread that made it is still running, and hands it over through a channel, which
// does not move what it carries.
import avin.threads.{Channel, spawn}

@sysl("avintest.digits.Tally")
class Tally
  add(n: long)
  get() -> long

@sysl("avintest.digits.new_tally")
newTally(n: long) -> Tally

@sysl("avintest.digits.sum_of")
sumOf(a: Tally, b: Tally) -> long

main()
  val mine = newTally(1)
  val made = Channel[Tally]()
  val done = Channel[unit]()
  spawn(() ->
    made.send(newTally(2))
    done.receive())
  val theirs = made.receive().get
  println(sumOf(mine, mine))
  println(sumOf(mine, theirs))
