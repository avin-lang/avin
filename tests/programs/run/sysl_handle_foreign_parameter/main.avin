// expect: trap
// A handle used by a thread while another owns it stops the program, here as a parameter of a
// binding: the handle went through a channel to a thread that used it, so it is that thread's, and
// that thread is still running.
import avin.threads.{Channel, spawn}

@sysl("avintest.digits.Tally")
class Tally
  add(n: long)
  get() -> long

@sysl("avintest.digits.new_tally")
newTally(n: long) -> Tally

@sysl("avintest.digits.sum_of")
sumOf(a: Tally, b: Tally) -> long

main()
  val mine = newTally(1)
  val given = newTally(2)
  val handed = Channel[Tally]()
  val used = Channel[unit]()
  val done = Channel[unit]()
  spawn(() ->
    _ = handed.receive().get.get()
    used.send(())
    done.receive())
  handed.send(given)
  _ = used.receive()
  println(sumOf(mine, mine))
  println(sumOf(mine, given))
