module geometry

// A type's module adds the operators a built-in value on the left calls, as `k * v`.
data Vec(x: real, y: real)

impl Vec
  *(k: real) -> Vec = Vec(x * k, y * k)
  show() -> string = s"($x, $y)"

data Pair[T](a: T, b: T)

impl real
  *(v: Vec) -> Vec = v * self

impl int
  *[T](p: Pair[T]) -> Pair[Pair[T]] = Pair(p, p)

// Inside the module, too.
halve(v: Vec) -> Vec = 0.5 * v
