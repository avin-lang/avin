// expect: exit 0
// Operator methods added to built-in types for a type of the program are seen where their module is
// imported, whole or by a declaration, the type's own module and an extension's alike, and a
// built-in value calls them on the operator's left.
import geometry.{Vec, Pair, halve}
import units

main()
  val v = Vec(2.0, 4.0)
  println((3.0 * v).show())
  println((2 * v).show())
  val big: long = 5
  println((big * v).show())
  println(halve(v).show())
  println("v=" + v)
  println(1.0 < v)
  println(3.0 < v)
  println(0.0 < 1.0 < v)
  println(3 * Pair(1, 2))
