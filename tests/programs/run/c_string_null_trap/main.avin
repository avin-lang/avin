// expect: trap
// Null answered for a binding whose result is a bare `string` stops the program at the call, naming
// the C function; the same function bound as an `Option[string]` answers `None`.

@c("const char *fixture_maybe(int present)")
maybe(present: int) -> Option[string]

@c("const char *fixture_maybe(int present)")
must(present: int) -> string

main()
  println(maybe(0).isEmpty)
  println(must(1))
  println(must(0))
  println("not reached")
