// A binding's integer result takes any Sysl integer, unsigned or of another width, converted with a
// check into the integer type the binding declares, as a mirror's integer field does.

@sysl("avintest.digits.digit_count_u8")
countU8(n: long) -> int

@sysl("avintest.digits.digit_count_u16")
countU16(n: long) -> i16

@sysl("avintest.digits.digit_count_u32")
countU32(n: long) -> long

@sysl("avintest.digits.digit_count_u64")
countU64(n: long) -> long

@sysl("avintest.digits.digit_count_usize")
countUsize(n: long) -> int

@sysl("avintest.digits.digit_count_isize")
countIsize(n: long) -> i8

// A wider Sysl integer narrows into a narrower Avin one when its value fits.
@sysl("avintest.digits.power_of_ten")
powerOfTen(places: int) -> int

@sysl("avintest.digits.digit_count")
digitCountWide(n: long) -> long

main()
  println(s"${countU8(7)} ${countU16(-123)} ${countU32(123456)} ${countU64(9000000000)}")
  println(s"${countUsize(0)} ${countIsize(-99999)}")
  println(s"${powerOfTen(0)} ${powerOfTen(9)} ${digitCountWide(100)}")
  // A binding with an integer result is a function like any other.
  val f: long -> long = countU64
  println(f(42))
