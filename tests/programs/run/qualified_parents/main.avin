// expect: exit 0
// A class names its superclass and its traits through the module that declares them, as `m.Base(…)`,
// `m.Trait` and `m.Generic[T]`, beside one named bare, and a library trait through its module.
import shapes
import shapes.Sized
import avin.io
import avin.io.IoError

class Box(val n: int): shapes.Base("box"), Sized, shapes.Holder[int]
  override size() -> int = n
  override held() -> int = n * 2

class Named: shapes.Base("named")

class Empty: io.Reader
  override read(max: int) -> Result[Array[byte], IoError] = Ok(Array.empty[byte]())

sized(s: Sized) -> int = s.size()
holding(h: shapes.Holder[int]) -> int = h.held()
reading(r: io.Reader) -> int = r.read(4).ok.get.length

main()
  val b = Box(3)
  println(b.describe(), sized(b), holding(b))
  println(Named().describe())
  println(reading(Empty()))
