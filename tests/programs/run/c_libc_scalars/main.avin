// expect: exit 0
// C bindings to the C library and libm, two C libraries of one manifest: each is a direct call of the
// C function, checked against the headers the manifest names.

@c("int abs(int)")
abs(n: int) -> int

@c("long labs(long)")
labs(n: long) -> long

@c("long long llabs(long long)")
llabs(n: long) -> long

@c("int toupper(int c)")
toupper(c: int) -> int

@c("int isdigit(int)")
isdigit(c: int) -> int

@c("double sqrt(double x)")
sqrt(x: real) -> real

@c("double pow(double, double)")
pow(x: real, y: real) -> real

@c("double fmax(double, double);")
fmax(a: real, b: real) -> real

@c("float sqrtf(float)")
sqrtf(x: real) -> real

@c("pid_t getpid(void)")
getpid() -> long

@c("pid_t getppid()")
getppid() -> int

main()
    println(abs(-5))
    println(abs(0))
    println(labs(-9000000000))
    println(llabs(-9223372036854775807))
    println(toupper(int('a')))
    println(toupper(int('Z')))
    println(isdigit(int('7')) != 0)
    println(isdigit(int('x')) != 0)
    println(sqrt(2.0))
    println(pow(2.0, 10.0))
    println(fmax(-1.5, 3.25))
    // A `float` parameter is rounded to the nearest binary32, and its result widened exactly.
    println(sqrtf(2.0))
    println(getpid() > 0)
    println(getppid() > 0)
