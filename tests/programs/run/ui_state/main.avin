// expect: exit 0
// A state is an Avin object holding a value: `get` reads it, `set` replaces it and `update`
// replaces it with a function of it. Every set is one write, which the frame loop builds again
// after. A control's signal for a state, `State.signal`, is made once and is then where the value
// lives, so the state and the control never disagree. A derived value is computed again only
// after something has been written.
import ui.{Derived, State, derived, intSignal, invalidate, state, writes}

data Point(x: int, y: int)

class Box(var n: int)

main()
  // get, set and update, at the bounds of an int.
  val n = state(0)
  println(n.get())
  n.set(2147483647)
  println(n.get())
  n.set(-2147483648)
  println(n.get())
  n.update(x -> x + 1)
  println(n.get())
  n.update(x -> x * 0)
  println(n.get())
  // One write for each set and each update, whatever it writes, the same value included; a get is
  // none.
  val before = writes()
  n.set(0)
  n.set(0)
  n.update(x -> x)
  println(writes() - before)
  val read = n.get() + n.get()
  println(writes() - before)
  // Generic instances: values and references, collections, options, tuples, functions.
  val s = state("")
  println(s"[${s.get()}]")
  s.set("héllo, 世界 ✓")
  s.update(t -> t + "!")
  println(s.get())
  val r = state(0.5)
  r.update(x -> x * 3.0)
  println(r.get())
  val b = state(false)
  b.update(x -> !x)
  println(b.get())
  val xs: State[Vector[int]] = state([])
  for i in 1 .. 3
    xs.update(v -> v :+ i)
  println(xs.get())
  val o: State[Option[string]] = state(None)
  println(o.get())
  o.set(Some("there"))
  println(o.get())
  val p = state(Point(1, 2))
  p.update(q -> Point(q.y, q.x))
  println(p.get())
  val t = state((1, "one"))
  t.update((k, w) -> (k + 1, w + "+"))
  println(t.get())
  val f = state((x: int) -> x + 1)
  f.set(x -> x * 10)
  println(f.get()(4))
  // A state of a reference holds the reference: changing the object in place is not a write.
  val box = state(Box(1))
  val w0 = writes()
  box.get().n = 5
  println(s"${box.get().n} ${writes() - w0}")
  // States inside states, and a state set from a closure kept in a collection.
  val outer = state(state(1))
  outer.get().set(7)
  println(outer.get().get())
  val all = (0 ..< 5).map(i -> state(i)).toVector
  val bumps = all.map(st -> () -> st.update(x -> x + 100))
  for bump in bumps
    bump()
  println(all.map(st -> st.get()))
  // The signal of a state, for each type a control takes: it holds the state's value, a control's
  // write to it is the state's new value, and the state's set is the signal's.
  val gi = State.signal(n)
  println(gi.read() == n.get())
  gi.set(42)
  println(n.get())
  n.set(43)
  println(gi.read())
  n.update(x -> x + 1)
  println(s"${gi.read()} ${n.get()}")
  val gr = State.signal(r)
  gr.set(-0.25)
  println(r.get())
  val gb = State.signal(b)
  gb.set(!gb.read())
  println(b.get())
  val gs = State.signal(s)
  println(gs.read())
  gs.set("")
  println(s"[${s.get()}]")
  s.set("ünïcode")
  println(gs.read())
  // The signal is made once: asking again answers the same one.
  println(State.signal(n) === gi)
  println(State.signal(s) === gs)
  // Through its signal, a set is still exactly one write, and so is the control's own write.
  val w1 = writes()
  n.set(1)
  gi.set(2)
  n.update(x -> x + 1)
  println(writes() - w1)
  println(n.get())
  // A state linked after it has been set starts its signal from its value.
  val late = state(10)
  late.set(11)
  println(State.signal(late).read())
  // Derived values: computed when first asked for, kept while nothing is written, and computed
  // again after any write: a state's, a signal's or an `invalidate`.
  var computed = 0
  val sum = derived(() ->
    computed += 1
    all.map(st -> st.get()).sum)
  println(computed)
  println(sum.get())
  println(sum.get())
  println(computed)
  all(0).set(0)
  println(sum.get())
  println(computed)
  intSignal(0).set(1)
  sum.get()
  println(computed)
  invalidate()
  sum.get()
  sum.get()
  println(computed)
  // A derived value of a derived one, and one of another type.
  val doubled = derived(() -> sum.get() * 2)
  val label: Derived[string] = derived(() -> s"sum ${sum.get()}")
  println(doubled.get())
  all(1).set(0)
  println(s"${doubled.get()} ${label.get()}")
  // Many states made and dropped while the collector runs, each set and read back.
  var total: long = 0
  for i in 0 ..< 3000
    val st = state(s"$i")
    Array.fill(32, i)
    st.update(v -> v + "0")
    if i % 3 == 0 then State.signal(st).set(s"$i")
    total += long(st.get().toInt())
  println(total)
