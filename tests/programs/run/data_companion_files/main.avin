// expect: exit 0
// A data type and its companion object are in one module, here in two of its files. Imported, the
// name is both: `Point(…)` makes a point and `Point.member` is the companion's.
import geometry.Point

main()
    print(Point.origin().describe())
    print(Point.diagonal(3).describe())
    print(Point(1, 2).describe())
