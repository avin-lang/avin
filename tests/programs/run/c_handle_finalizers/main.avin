// expect: exit 0
// A handle never closed is given back by the collector's finalizer, exactly once: 10,000 objects made
// and dropped, owned and borrowed, alone, in a data value and in a vector, and 10,000 faces each
// keeping its library, every one given back with nothing freed twice. The corpus runs this with the
// collector at every allocation, at -O0 and -O2.
import fixture.{Counts, Object, faces, lend, libraries, newFace, newLibrary, newObject, objects}

data Holder(held: Object, label: string)

line(c: Counts) -> string = s"${c.created} ${c.retained} ${c.released} ${c.freed}"

// Allocates until every object of `counts` has been freed, or gives up after a bound.
settle(counts: () -> Counts) -> bool
    var n = 0
    while counts().freed < counts().created && n < 1000000
        val v = [n, n + 1]
        n += v(1) - v(0)
    counts().freed == counts().created

made(i: int) -> int = newObject(i).value()

borrowed(i: int) -> int
    val o = newObject(i)
    lend(o).value() + lend(o).value()

held(i: int) -> int = Holder(newObject(i), "h").held.value()

listed(i: int) -> int
    val all = [newObject(i), newObject(i + 1)]
    all(0).value() + all(1).value()

faced(i: int) -> int = newFace(newLibrary(), i).id()

main()
    var sum: long = 0
    for i in 0..<10000
        sum += long(made(i))
    println(sum)
    println(settle(() -> objects()))
    println(line(objects()))
    for i in 0..<1000
        sum += long(borrowed(i)) + long(held(i)) + long(listed(i))
    println(settle(() -> objects()))
    println(line(objects()))
    for i in 0..<10000
        sum += long(faced(i))
    println(settle(() -> faces()))
    println(settle(() -> libraries()))
    println(line(faces()))
    println(line(libraries()))
    println(sum)
