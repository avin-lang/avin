// expect: exit 0
// A root that keeps a branch which keeps the root back, with no C reference, is a cycle through a
// pin: the branch keeps the root from the collector until the branch's release has run, and the root
// keeps the branch, so neither is collected while both are open. Closing the branch lets go of the
// pin, and the collector then frees the root, whose own release is passed nothing it no longer has.
import fixture.{Branch, newRoot, nodes, nodesFreedByParent, nodesFreedOwn}

// A root keeping its branch, answered alone: nothing else reaches either.
cycle() -> Branch
  val root = newRoot()
  val b = root.branch()
  root.adopt(b)
  b

collect(rounds: int)
  var n = 0
  while n < rounds
    val v = [n, n + 1]
    n += v(1) - v(0)

main()
  var kept: Vector[Branch] = []
  for _ in 0 ..< 50 do kept = kept :+ cycle()
  for _ in 0 ..< 50 do cycle()
  collect(300000)
  // Neither half of any cycle was freed.
  println(nodes().created)
  println(nodes().freed)
  for b in kept
    b.close()
  var n = 0
  while nodes().freed < 100 && n < 1000000
    val v = [n, n + 1]
    n += v(1) - v(0)
  collect(300000)
  // Each closed branch freed its own node, and the collector its root; the cycles nobody closed stay.
  println(nodes().freed)
  println(nodesFreedOwn())
  println(nodesFreedByParent())
