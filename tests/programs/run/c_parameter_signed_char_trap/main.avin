// expect: trap
// An `int` too large for a `signed char` parameter stops the program at the call, through a function
// value as through a direct call.

@c("signed char fixture_echo_schar(signed char)")
echoSchar(n: int) -> int

main()
    val f: int -> int = echoSchar
    println(f(127))
    println(f(-128))
    println(f(128))
