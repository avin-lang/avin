// expect: exit 0
// An impl in another module of a trait promising `Sendable` leaves the `Sendable` a type has from its
// own source: `Vector[long]` and `Vector[byte]` cross threads, and so do the standard library's
// classes holding a `Vector`, while the imported impls make the types `Tag` where their bounds hold.
import tags.{Holder, Label, Tag}
import avin.threads.spawn

across[T: Sendable](value: T) -> T = spawn(() -> value).join()

tagged[T: Tag](value: T) -> string = value.tag

main()
  val longs: Vector[long] = [4, 5]
  println(across(longs).sum)
  val bytes: Vector[byte] = [byte(1), byte(2), byte(3)]
  println(across(bytes).length)
  println(tagged(bytes))
  println(tagged([Label("a"), Label("b")]))
  println(across([Label("x")]).tag)
  println(across(Holder(7)).value)
  println(tagged(across(Holder(Label("h")))))
  println(across(Set(1, 2, 3)).size)
