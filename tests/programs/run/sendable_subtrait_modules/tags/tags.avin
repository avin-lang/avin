module tags

// A trait promising `Sendable`, with a bounded impl for the standard library's `Vector`, an impl for
// one of its instances, and an impl for a class of this module whose only promise it is.
trait Tag: Sendable
  tag -> string

data Label(name: string)

impl Tag for Label
  tag -> string = name

impl[T: Tag] Tag for Vector[T]
  tag -> string = "v" + self.map((x) -> x.tag).mkString(",")

impl Tag for Vector[byte]
  tag -> string = s"bytes(${self.length})"

class Holder[A](val value: A)

impl[A: Tag] Tag for Holder[A]
  tag -> string = "holder " + value.tag
