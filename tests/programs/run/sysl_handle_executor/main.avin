// expect: exit 0
// An executor hands handles over as the shared pool does: the body of `ex.future` owns the handles it
// captures until it returns, whichever worker runs it, a value it yields is taken by the code that
// awaits it, and the `map`, `flatMap` and `onComplete` functions of a future made on the executor own
// what they capture and are given.
import avin.threads.{Executor, Future}

@sysl("avintest.digits.Tally")
class Tally
    add(n: long)
    get() -> long
    absorb(other: Tally)

@sysl("avintest.digits.new_tally")
newTally(n: long) -> Tally

@sysl("avintest.digits.sum_of")
sumOf(a: Tally, b: Tally) -> long

class Box(val tally: Tally)

// A tally one more than `c` is once three is added to it.
grown(c: Tally) -> Tally
    c.add(3)
    val r = newTally(c.get())
    r.add(1)
    r

bumped(b: Box) -> long
    b.tally.add(10)
    b.tally.get()

absorbed(into: Tally, x: Tally) -> long
    into.absorb(x)
    into.get()

main()
    val ex = Executor.fixed(2)
    // A body on a fixed executor uses what it captures, and the value it yields is taken by the awaiter.
    val c = newTally(30)
    val r = ex.future(grown(c)).await()
    println(s"${r.get()} ${c.get()}")
    // Through an object and a collection, on more tasks than the executor has workers.
    val boxes = (0..<6).map(i -> Box(newTally(long(i)))).toVector()
    val sums = boxes.map(b -> ex.future(bumped(b)))
    println(Future.all(sums).await().sum())
    println(boxes.map(b -> b.tally.get()).sum())
    // A continuation on the executor owns what it captures and the value it is given.
    val d = newTally(40)
    val g = ex.future(newTally(2)).map(x ->
        d.absorb(x)
        d.get())
    println(g.await())
    val e = newTally(5)
    val h = ex.future(newTally(1)).flatMap(x -> ex.future(absorbed(e, x)))
    println(h.await())
    val f = newTally(60)
    val done = ex.future(newTally(3)).map(x ->
        f.add(x.get())
        f.get())
    println(done.await())
    println(f.get())
    ex.shutdown()
