// A collection out of Sysl is converted by two overloads of one function, one for a slice and one for
// a `Buf`, both generic in the Sysl integer type of the elements. A program whose bindings return the
// same Avin collection from a slice and from a `Buf` of the same Sysl integer type reaches both
// overloads at one type argument, and each converts its own argument.

@sysl("avintest.digits.digits_of")
digitsOf(n: long) -> Vector[int]

@sysl("avintest.digits.digit_bytes")
digitBytes(n: long) -> Vector[int]

// The same Sysl type into an array, and into a vector of another integer type.
@sysl("avintest.digits.digits_of")
digitArray(n: long) -> Array[i16]

@sysl("avintest.digits.digit_bytes")
digitByteArray(n: long) -> Array[i16]

@sysl("avintest.digits.digit_bytes")
digitLongs(n: long) -> Vector[long]

// A wider Sysl integer, from a slice and from a `Buf`.
@sysl("avintest.digits.powers")
powers(count: int) -> Vector[long]

@sysl("avintest.digits.power_buf")
powerBuf(count: int) -> Vector[long]

main()
    // Slice first, then `Buf`, then each again, so neither use stands alone.
    println(digitsOf(90210))
    println(digitBytes(90210))
    println(digitBytes(7))
    println(digitsOf(-305))
    // Zero has one digit; the boundaries of a `long`.
    println(s"${digitsOf(0)} ${digitBytes(0)}")
    println(digitBytes(9223372036854775807).length)
    println(digitsOf(-9223372036854775807).length)
    val a = digitArray(1234)
    val b = digitByteArray(1234)
    println(s"${a.length} ${a(0)} ${a(3)} ${b.length} ${b(0)} ${b(3)}")
    println(digitLongs(56))
    println(powers(4))
    println(powerBuf(4))
    println(s"${powers(0).length} ${powerBuf(0).length}")
    // Converted values are ordinary Avin values, and the two are each other's reverse.
    println(digitBytes(123456).reverse == digitsOf(123456))
    println(powerBuf(19).reverse == powers(19))
    // Many conversions, alternating, under the collections their results cause.
    var total = 0
    for i in 0 ..< 2000
        total += digitsOf(long(i)).sum + digitBytes(long(i)).sum
    println(total)
