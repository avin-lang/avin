// expect: trap
// A callback's answer that the closure's unsigned Sysl type cannot hold stops the program where the
// binding was called: a negative `long` is no `u32`.

@sysl("avintest.callbacks.answer_u32")
answerU32(f: () -> long) -> long

main()
    println(answerU32(() -> 0))
    println(answerU32(() -> -1))
