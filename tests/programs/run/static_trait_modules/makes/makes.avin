module makes

// A trait whose members are all static, with generic code over it, and a trait type of this module
// stating its own conformance to it here, in the static trait's module.
trait Make[A]
  static make(x: A) -> Self

build[C: Make[A], A](x: A) -> C = C.make(x)

trait Stack[A]
  top -> A

class OneStack[A](val a: A): Stack[A]
  override top -> A = a

impl[A] Make[A] for Stack[A]
  static make(x: A) -> Stack[A] = OneStack(x)
