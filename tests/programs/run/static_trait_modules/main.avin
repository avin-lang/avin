// expect: exit 0
// Conformances to a static trait of one module, stated in the modules of covariant classes and of
// trait types: generic code of the trait's module, called from a third, reaches each type's own
// static member, and a trait type's own conformance holds wherever the trait type is the argument.
import makes
import makes.build
import bags.Box
import bags.Bag

main()
  println(build[Box[int], int](1).item)
  val wide: Box[Any] = build[Box[string], string]("two")
  println(wide.item)
  println(build[Bag[string], string]("three").first)
  println(Bag[int].make(4).first)
  println(build[makes.Stack[int], int](5).top)
