module bags

import makes.Make

// A covariant class and a trait type of this module, each stating its conformance to another
// module's static trait in the type's own module.
abstract class Box[+T]
  item -> T

class Full[+T](val value: T): Box[T]
  override item -> T = value

impl[T] Make[T] for Box[T]
  static make(x: T) -> Box[T] = Full(x)

trait Bag[A]
  first -> A

class OneBag[A](val a: A): Bag[A]
  override first -> A = a

impl[A] Make[A] for Bag[A]
  static make(x: A) -> Bag[A] = OneBag(x)
