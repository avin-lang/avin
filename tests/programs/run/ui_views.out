-- row
text 0,142 8x16 'a'
text 18,142 16x16 'bb'
text 44,142 24x16 'ccc'
@1 text "a" [0,142 8x16]
@2 text "bb" [18,142 16x16]
@3 text "ccc" [44,142 24x16]
-- empty row
-- spacers share a row
text 188,142 24x16 'mid'
@1 text "mid" [188,142 24x16]
-- one spacer pushes to the end
text 376,142 24x16 'end'
@1 text "end" [376,142 24x16]
-- nested
