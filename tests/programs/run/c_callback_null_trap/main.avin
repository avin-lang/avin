// expect: trap
// A null string C calls a callback with is `None` for an `Option`, and stops the program for a
// `string`.

@c("int cb_string(int (*f)(userdata void *ud, const char *s), userdata void *ud, const char *s, int null)")
withMaybe(f: Option[string] -> int, s: string, null: int) -> int

@c("int cb_string(int (*f)(userdata void *ud, const char *s), userdata void *ud, const char *s, int null)")
withString(f: string -> int, s: string, null: int) -> int

main()
  println(withMaybe(s -> if s is Some(_) then 1 else 0, "x", 1))
  println(withString(s -> s.byteLength, "abc", 0))
  println(withString(s -> s.byteLength, "abc", 1))
