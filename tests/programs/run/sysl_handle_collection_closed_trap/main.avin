// expect: trap
// Each handle of a collection passed to Sysl must still hold its Sysl value: a closed one, here the
// last of an array, stops the program at the call, naming the handle's class.

@sysl("avintest.views.View")
class View
    describe() -> string

@sysl("avintest.views.text")
text(s: string) -> View

@sysl("avintest.views.column_reading")
columnReading(children: Array[View]) -> View

main()
    val views = Array.fill(3, text("same"))
    views(2) = text("last")
    println(columnReading(views).describe())
    views(2).close()
    println(columnReading(views).describe())
