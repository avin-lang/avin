// expect: exit 0
// A `void *` or `const void *` parameter is memory of no type: it takes an array of any element type
// an array crosses as, or a `ByteBlock`, and its length is the array's length in bytes. C writes
// through `void *`, and what it wrote is in the array after the call, `blocking` or not; it only
// reads through `const void *`. An `inout` length C writes back is in bytes too. `None` and a
// pointer marked `null` pass null.
import avin.c.ByteBlock

@c("void aa_void_fill(void *p, int c, length(p) size_t n)")
fillBytes(p: Array[byte], c: int)

@c("void aa_void_fill(void *p, int c, length(p) size_t n)")
fillInts(p: Array[int], c: int)

@c("void aa_void_fill(void *p, int c, length(p) size_t n)")
fillLongs(p: Array[long], c: int)

@c("void aa_void_fill(void *p, int c, length(p) size_t n)")
fillReals(p: Array[real], c: int)

@c("void aa_void_fill(void *p, int c, length(p) size_t n)", blocking)
fillLongsWaiting(p: Array[long], c: int)

@c("void aa_void_fill(void *p, int c, length(p) size_t n)")
fillBlock(p: ByteBlock, c: int)

@c("long long aa_void_sum(const void *p, length(p) size_t n)")
sumBytes(p: Array[byte]) -> long

@c("long long aa_void_sum(const void *p, length(p) size_t n)")
sumInts(p: Array[int]) -> long

@c("long long aa_void_sum(const void *p, length(p) size_t n)")
sumLongs(p: Array[long]) -> long

@c("long long aa_void_sum(const void *p, length(p) size_t n)")
sumReals(p: Array[real]) -> long

@c("long long aa_void_sum(const void *p, length(p) size_t n)", blocking)
sumIntsWaiting(p: Array[int]) -> long

@c("long long aa_void_sum(const void *p, length(p) size_t n)")
sumBlock(p: ByteBlock) -> long

@c("long long aa_void_sum(const void *p, length(p) size_t n)")
sumMaybe(p: Option[Array[long]]) -> long

// Two arrays of different element types in one call, the second's length an `int`.
@c("long long aa_void_sum_two(const void *a, length(a) size_t na, const void *b, length(b) int nb)")
sumTwo(a: Array[int], b: Array[byte]) -> long

@c("void aa_void_take(void *buf, length(buf) inout size_t *len)")
takeInts(buf: Option[Array[int]]) -> long

@c("void aa_void_take(void *buf, length(buf) inout size_t *len)")
takeLongs(buf: Array[long]) -> long

@c("void aa_void_take(void *buf, length(buf) inout size_t *len)", blocking)
takeIntsWaiting(buf: Array[int]) -> long

@c("int aa_void_null(const void *p, length(p) size_t n)")
nullOf(p: Option[Array[real]]) -> int

@c("int aa_void_null(null const void *p, size_t n)")
nullNamed(n: long) -> int

main()
  val b = Array.fill(3, byte(0))
  fillBytes(b, 9)
  println(b)
  val i = Array.fill(2, 0)
  fillInts(i, 1)
  println(i)
  val l = Array.fill(2, long(5))
  fillLongs(l, 1)
  println(l)
  val r = Array.fill(2, 1.5)
  fillReals(r, 0)
  println(r)
  val w = Array.fill(3, long(0))
  fillLongsWaiting(w, 255)
  println(w)
  val e: Array[int] = Array.empty()
  fillInts(e, 1)
  println(e.length)
  val k = ByteBlock(5)
  fillBlock(k, 3)
  println(sumBlock(k))
  println(sumBytes(Array.fill(4, byte(2))))
  println(sumInts([1, 256, 65536, 16777216]))
  println(sumInts([-1]))
  println(sumLongs([-1, 1]))
  println(sumReals([1.0]))
  println(sumIntsWaiting([2, 3]))
  println(sumInts(Array.empty()))
  println(sumMaybe(None))
  println(sumMaybe(Some([long(7)])))
  println(sumTwo([1, 2], Array.fill(3, byte(4))))
  println(takeInts(None))
  val t = Array.fill(2, 0)
  println(takeInts(Some(t)))
  println(t)
  val tl = Array.fill(1, long(0))
  println(takeLongs(tl))
  println(tl)
  val tw = Array.fill(3, 0)
  println(takeIntsWaiting(tw))
  println(tw)
  println(nullOf(None))
  println(nullOf(Some(Array.fill(3, 0.0))))
  println(nullNamed(0))
  println(nullNamed(3))
