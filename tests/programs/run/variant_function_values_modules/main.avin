// expect: exit 0
// Another module's variants are function values as the program's own are: through the module,
// through their type, and imported by name; a generic one takes its instance from the expected type;
// and where a companion object of the variant's name declares `apply`, the expected function type
// chooses between the variant and the `apply`.
import events
import events.{Box, Heard, Stamp}

main()
  println(["a", "b"].map(Heard).map(events.describe))
  println([1, 2].map(events.Counted).map(events.describe))
  println([3].map(events.Event.Counted).map(events.describe))
  val full: (string) -> Box[string] = Box.Full
  println(full("f"))
  println([true].map(events.Full))
  val byLabel: (string) -> Stamp = Stamp
  val byNumber: (int) -> Stamp = Stamp
  println(byLabel("label"))
  println(byNumber(7))
  println(events.Closed)
