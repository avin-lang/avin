module events

data Event
  Heard(text: string)
  Counted(n: int)
  Closed

data Box[T]
  Full(value: T)
  Empty

// A data type whose one variant shares its name, with a companion whose `apply` takes another type.
data Stamp
  Stamp(label: string)

object Stamp
  apply(n: int) -> Stamp = Stamp(s"#$n")

describe(e: Event) -> string = e match
  Heard(t) -> s"heard $t"
  Counted(n) -> s"counted $n"
  Closed -> "closed"
