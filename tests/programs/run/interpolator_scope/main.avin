// expect: exit 0
// An interpolator is in scope where its module is: the file's own module, a module imported whole, or
// one of whose declarations the file imports by name. The core library's `s`, `f` and `raw` need no
// import, and a module's own use of an interpolator does not make it visible to its importers.
import shout.{loud}
import user.{describe}

// An interpolator of this file's own module.
trait Echo
    echo(args: int*) -> string

impl Echo for StringContext
    echo(args: int*) -> string = s"${parts.mkString("+")}${args.length()}"

main()
    println(loud("world"))
    println(describe(3))
    println(echo"a ${1} b ${2}")
    println(s"${1 + 1} ${raw"\d"} ${f"${1.5}%.2f"}")
