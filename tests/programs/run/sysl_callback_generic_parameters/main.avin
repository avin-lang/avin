// expect: exit 0
// A callback whose closure takes a type parameter of the generic Sysl function, `applied[T, U](x: T,
// f: &Fn(T) -> U)`, gives Sysl nothing to infer the closure's parameters from, so the shim writes
// each as the Avin type's: an integer, a string, an option, a tuple and a mirror, from bindings that
// are not generic themselves as from one that is.

@sysl("avintest.digits.Spot")
data Spot(x: int, y: int)

@sysl("avintest.digits.applied")
showInt(x: int, f: int -> string) -> string

@sysl("avintest.digits.applied")
showLong(x: long, f: long -> long) -> long

@sysl("avintest.digits.applied")
measure(x: string, f: string -> int) -> int

@sysl("avintest.digits.applied")
unwrap(x: Option[int], f: Option[int] -> int) -> int

@sysl("avintest.digits.applied")
joined(x: (string, byte), f: ((string, byte)) -> string) -> string

@sysl("avintest.digits.applied")
area(x: Spot, f: Spot -> int) -> int

@sysl("avintest.digits.applied")
applied[T: Boundary, U: Boundary](x: T, f: T -> U) -> U

main()
  val tag = "#"
  println(showInt(-2147483648, x -> s"$tag$x"))
  println(showLong(9223372036854775806, x -> x + 1))
  println(measure("héllo", s -> s.count(c -> true)))
  println(unwrap(None, o -> o.getOrElse(-1)), unwrap(Some(4), o -> o.getOrElse(-1)))
  println(joined(("a", byte(7)), p -> s"$p"))
  println(area(Spot(3, 4), s -> s.x * s.y))
  println(applied(Spot(1, 1), s -> Some(s)), applied('c', c -> c == 'c'))
