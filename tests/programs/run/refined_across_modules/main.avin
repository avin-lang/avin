// expect: exit 0
// Refined variants of another module are made by name, through the module, with written type
// arguments and at the instance written on the type; their values are printed, compared and told
// apart by type pattern as values of the module's own are.
import exprs
import exprs.{IntLit, BoolLit, Pair, twice}

isPair(x: Any) -> bool = x match
  _: exprs.Expr[(int, bool)] -> true
  _ -> false

main()
  val one = IntLit(1)
  val yes: exprs.Expr[bool] = BoolLit(true)
  val p = Pair(one, yes)
  println(p)
  println(p == Pair[int, bool](IntLit(1), BoolLit(true)))
  println(exprs.Expr[int].If(yes, one, exprs.IntLit(2)))
  println(exprs.Expr[(int, bool)].Pair(one, yes) == p)
  println(twice(yes))
  println(isPair(p))
  println(isPair(one))
