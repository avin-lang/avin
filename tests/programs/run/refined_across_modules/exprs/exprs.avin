module exprs

// A type with refined variants, made and compared in another module.

data Expr[T]
  IntLit(value: int) -> Expr[int]
  BoolLit(value: bool) -> Expr[bool]
  Pair[A, B](first: Expr[A], second: Expr[B]) -> Expr[(A, B)]
  If(cond: Expr[bool], yes: Expr[T], no: Expr[T])

// A pair of a value with itself, made in this module at the caller's instance.
twice[A](e: Expr[A]) -> Expr[(A, A)] = Pair(e, e)
