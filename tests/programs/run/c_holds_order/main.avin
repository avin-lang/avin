// expect: exit 0
// A connection holds its own copy of a stream's descriptor for its release, which writes a farewell
// to it, as `libssh2_session_free` writes to its socket. With the stream and the connection found
// dead in one collection, in either address order, the stream's descriptor may be closed first, and
// its number given to the next descriptor opened; the connection's own copy is still open, and the
// farewell reaches the pipe it was meant for, every time.
import fixture.{conns, drain, dup, farewellsFailed, farewellsWritten, newConn, newStream, pipe, streamsFreed}

// The stream's handle made before the connection's, at the lower address; the pipe's read end.
streamFirst() -> int
  val (r, w) = pipe()
  val s = newStream(w)
  _ = newConn().start(dup(s.descriptor()))
  r

// The connection's handle made first.
connFirst() -> int
  val (r, w) = pipe()
  val c = newConn()
  val s = newStream(w)
  _ = c.start(dup(s.descriptor()))
  r

main()
  var ends: Vector[int] = []
  // Few enough that every descriptor fits under the least limit a process is given.
  for _ in 0 ..< 30
    ends = ends :+ streamFirst()
    ends = ends :+ connFirst()
  var n = 0
  while (conns().freed < conns().created || streamsFreed() < 60) && n < 1000000
    val v = [n, n + 1]
    n += v(1) - v(0)
  // Every stream is collected too, so each pipe reads to its end.
  var all = true
  for r in ends
    if drain(r) != "bye" then all = false
  println(conns().created)
  println(all)
  println(farewellsWritten())
  println(farewellsFailed())
