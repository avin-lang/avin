// expect: exit 0
// Opaque types declared in another module: imported by name or reached through the module, their
// values are made and taken apart by that module's functions and impls; this module names the
// types, passes, stores, compares and orders their values and adds methods of its own that use only
// what the declaring module offers.
import ids
import ids.{UserId, Email, Bag, user, email}

impl UserId
  def twice -> long = id * 2

type Users = Vector[UserId]

describe(x: Any) -> string = x match
  u: UserId -> s"user ${u.id}"
  _: long -> "long"
  _ -> "other"

main()
  val a = user(1)
  val b: ids.UserId = a.next()
  println(b.id)
  println(b.twice)
  println(a < b)
  println(a == user(1))
  val us: Users = [b, a]
  println(us.sorted.map(u -> u.id))
  val e: Email = email("Ann@Example.org")
  println(e)
  println(ids.domain(e))
  println(ids.bag[string]().add("x").add("y").count)
  val bb: Bag[int] = ids.bag()
  println(bb.count)
  println(ids.hidden())
  println(describe(a))
  println(describe(long(1)))
