module ids

// The module that declares the opaque types: it alone makes their values and takes them apart.

opaque type UserId = long
opaque type Email = string
opaque type Bag[T] = Vector[T]
private opaque type Secret = int

impl UserId
  def id -> long = repr
  next() -> UserId = UserId(repr + 1)

impl Ord for UserId
  compare(other: UserId) -> int = repr.compare(other.repr)

impl Display for Email
  display(out: Writer, spec: FormatSpec) = out.write(s"<$repr>")

impl[T] Bag[T]
  add(x: T) -> Bag[T] = Bag(repr :+ x)
  def count -> int = repr.length

user(n: long) -> UserId = UserId(n)

email(s: string) -> Email = Email(s.toLower)

bag[T]() -> Bag[T] = Bag([])

hidden() -> int = Secret(7).repr

// A value from outside is taken apart here, in its module.
domain(e: Email) -> string = e.repr.split("@")(1)
