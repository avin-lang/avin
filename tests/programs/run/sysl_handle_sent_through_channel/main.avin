// expect: exit 0
// A Sysl handle sent through a channel is the receiving thread's: one made by another thread is used
// and closed here, and one made here is used by the thread it went to, as a parameter of a binding
// there too.
import avin.threads.{Channel, spawn}

@sysl("avintest.digits.Tally")
class Tally
  add(n: long)
  get() -> long

@sysl("avintest.digits.new_tally")
newTally(n: long) -> Tally

@sysl("avintest.digits.sum_of")
sumOf(a: Tally, b: Tally) -> long

main()
  val made = Channel[Tally]()
  val done = Channel[unit]()
  spawn(() ->
    made.send(newTally(2))
    done.receive())
  val theirs = made.receive().get
  theirs.add(5)
  println(theirs.get())
  println(sumOf(theirs, theirs))
  theirs.close()
  done.send(())
  val mine = newTally(3)
  val handed = Channel[Tally]()
  val answer = Channel[long]()
  spawn(() ->
    val t = handed.receive().get
    answer.send(sumOf(t, t)))
  handed.send(mine)
  println(answer.receive().get)
