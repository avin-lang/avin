// expect: exit 0
// A blocking binding may fill an array and answer a tuple. The array is copied into the slice the
// Sysl function writes before the thread is safe for the collector, and kept on the thread's stack
// while the call waits and collections run on other threads; what the function left in the slice is
// copied back, and the tuple it answers converted, once the thread is running again.
import avin.threads.spawn

@sysl("avintest.digits.fill_after_gate", blocking)
fillAfterGate(n: long, into: Array[byte]) -> long

@sysl("avintest.digits.squares_after_gate", blocking)
squaresAfterGate(into: Array[int]) -> (long, string)

@sysl("avintest.digits.pair_after_gate", blocking)
pairAfterGate(n: long) -> (long, string)

@sysl("avintest.digits.gate_waiters_now")
gateWaiters() -> int

@sysl("avintest.digits.open_gate")
openGate()

@sysl("avintest.digits.close_gate")
closeGate()

show(a: Array[byte]) -> string = a.map(b -> int(b)).mkString("[", ",", "]")

churn(rounds: int) -> int
  var kept: List[string] = []
  for r in 0 ..< rounds
    kept = s"r$r" :: kept
    if r % 50 == 0 then kept = []
  kept.length

main() -> int
  // On a thread alone, each is an ordinary call once the gate is open.
  openGate()
  val alone = Array.fill(4, byte(9))
  println(s"${fillAfterGate(271, alone)} ${show(alone)}")
  println(squaresAfterGate(Array.fill(3, -1)))
  println(pairAfterGate(90210))
  closeGate()
  // Four threads wait in the calls while this one allocates and collects many times over.
  val bytes = spawn(() ->
    val into = Array.fill(6, byte(7))
    val count = fillAfterGate(31415, into)
    s"$count ${show(into)}")
  // An array nothing else holds is kept by the call itself while it waits.
  val unheld = spawn(() -> fillAfterGate(8128, Array.fill(2, byte(0))))
  val squares = spawn(() ->
    val into = Array.fill(5, 0)
    val (count, text) = squaresAfterGate(into)
    s"$count $text ${into.mkString(",")}")
  val pair = spawn(() -> pairAfterGate(1234567))
  while gateWaiters() < 4
    churn(10)
  println(churn(3000))
  openGate()
  println(bytes.join())
  println(unheld.join())
  println(squares.join())
  println(pair.join())
  closeGate()
  0
