// expect: trap
// An index past its bound stops the program at the call before C reads anything, naming the index
// and the accessor; the first and the last are read.
import fields.newRecord

main()
  val r = newRecord()
  println(r.value(0))
  println(r.value(r.count() - 1))
  println(r.value(r.count()))
  println("not reached")
