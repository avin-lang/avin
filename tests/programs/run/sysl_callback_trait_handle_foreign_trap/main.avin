// expect: trap
// A trait handle a callback answers goes into Sysl as a parameter does, checked the same way: one
// that another thread owns, having taken it from a channel and used it, stops the program where
// Sysl called the function.
import avin.threads.{Channel, spawn}

@sysl("avintest.views.View")
class View
  describe() -> string

@sysl("avintest.views.text")
text(s: string) -> View

@sysl("avintest.views.render")
render(tree: () -> View, n: int) -> string

main()
  val theirs = text("theirs")
  val handed = Channel[View]()
  val used = Channel[unit]()
  val done = Channel[unit]()
  spawn(() ->
    _ = handed.receive().get.describe()
    used.send(())
    done.receive())
  handed.send(theirs)
  _ = used.receive()
  println(render(() -> text("mine"), 2))
  println(render(() -> theirs, 1))
