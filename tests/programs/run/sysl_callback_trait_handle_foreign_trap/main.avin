// expect: trap
// A trait handle a callback answers goes into Sysl as a parameter does, checked the same way: one
// that another thread owns stops the program where Sysl called the function.
import avin.threads.{Channel, spawn}

@sysl("avintest.views.View")
class View
    describe() -> string

@sysl("avintest.views.text")
text(s: string) -> View

@sysl("avintest.views.render")
render(tree: () -> View, n: int) -> string

main()
    val made = Channel[View]()
    val done = Channel[unit]()
    spawn(() ->
        made.send(text("theirs"))
        done.receive())
    val theirs = made.receive().get
    println(render(() -> text("mine"), 2))
    println(render(() -> theirs, 1))
