// A Sysl package reached through an Avin library: the library's manifest names it, and a program
// depending on the library builds the library's bindings without naming the Sysl package itself.

import digittools.{digits, letters}

main()
  println(s"${digits(7)} ${digits(-100)} ${digits(123456789012)}")
  println(s"[${letters(" 2024 report 2 ")}]")
