module plat

import avin.process
import avin.process.{Linux, MacOS}

// What the machine's own file says, the same sentence on each.
describe() -> string = s"a ${kind()} machine"

// The system as `avin.process` tells it at run time.
expected() -> string = process.os() match
  MacOS -> "macos"
  Linux -> "linux"
  _ -> "other"
