// expect: exit 0
// Files for one machine: `plat` is one module on every machine, its shared file calling `system()`,
// which the machine's own file supplies, with a private helper the shared file cannot see on a
// machine whose file does not declare it. `avin.target`'s values are the machine's, decided as the
// program is compiled: each branch is checked, and the one taken agrees with `avin.process.os()`.
import plat
import avin.process
import avin.target
import avin.process.{Linux, MacOS}
import avin.target.{Aarch64, X86_64}

main()
  println(plat.describe())
  println(plat.system() == plat.expected())
  val os = target.os match
    MacOS -> "macos"
    Linux -> "linux"
    _ -> "other"
  println(os == plat.system())
  println(target.os == process.os())
  val arch = if target.arch == Aarch64 then "aarch64" else "x86_64"
  println(arch.byteLength > 0)
  println(target.arch is Aarch64 || target.arch is X86_64)
  println(plat.onLinuxOnly() == (target.os == Linux))
