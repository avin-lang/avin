// expect: trap
// A function C keeps belongs to the code that gave it: another thread of the program making C call
// it stops the program, before any of the function runs, where that thread entered C.
import avin.threads.spawn

@c(type: "cb_registry *", release: "cb_registry_unref", forget: "cb_registry_forget", shared)
class Registry
    @c("int cb_registry_listen(cb_registry *self, void (*listener)(userdata void *ud, int value), userdata void *ud)", keeps: "listener")
    listen(listener: int -> unit) -> int

    @c("int cb_registry_fire(cb_registry *self, int value)")
    fire(value: int) -> int

@c("cb_registry *cb_registry_new(void)")
newRegistry() -> Registry

main()
    val r = newRegistry()
    r.listen(v -> println(s"heard $v"))
    println(r.fire(1))
    println(spawn(() -> r.fire(2)).join())
