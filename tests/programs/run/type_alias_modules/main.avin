// expect: exit 0
// A type alias is imported like any type, by name or through its module, and is as transparent in
// the module that imports it as in its own: an imported generic alias takes type arguments, and the
// expansion of a private alias reaches this module through the signatures that use it.
import geometry
import geometry.{Point, Path, Route as Trip}

type Local = geometry.Plane

main()
    val p: Point = (3, 4)
    val q: geometry.Point = p
    println(q.0 * q.1)
    val words: Path[string] = [("a", "b")]
    println(words(0).1)
    val trip: Trip = [(1, 5), (2, 10)]
    println(geometry.lengthOf(trip))
    val r: Local = geometry.square(2)
    println(r.name)
    val cs: Vector[(int, int)] = geometry.corners(r)
    println(cs.length())
    val g: geometry.Path[geometry.Point] = [((0, 0), (1, 1))]
    println(g(0).1.0)
