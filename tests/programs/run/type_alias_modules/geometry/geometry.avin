module geometry

// Aliases a module exports, used by another: a plain one, a generic one, one naming another of this
// module's aliases, and one standing for a data type of the module. A private alias serves the
// module's own functions, whose signatures another module then sees in their expansions.

type Point = (int, int)
type Path[T] = Vector[(T, T)]
type Route = Path[int]
type Plane = Region

private type Inner = Vector[Point]

data Region(name: string, corners: Inner)

square(side: int) -> Region = Region("square", [(0, 0), (side, 0), (side, side), (0, side)])

corners(r: Region) -> Inner = r.corners

lengthOf(p: Route) -> int = p.map((a, b) -> b - a).sum()
