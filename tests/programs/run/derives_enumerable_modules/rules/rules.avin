module rules

// A trait of this module's own named `Enumerable`, with its own template: a type deriving it here
// follows its template's rules, not the core library's, so a type with fields derives it.
trait Enumerable
    count() -> int

derive Enumerable for T
    count() -> int = T.variantOf(self).fieldCount

data Shape derives Enumerable
    Circle(radius: int)
    Rect(width: int, height: int)

counts() -> Vector[int] = [Circle(1).count(), Rect(2, 3).count()]
