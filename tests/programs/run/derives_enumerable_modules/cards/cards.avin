module cards

// An enumeration declared in a module of its own, used there and from the module importing it.
data Suit derives Ord, Enumerable
    Clubs
    Diamonds
    Hearts
    Spades

// The suits from `first` on, in declaration order.
suitsFrom(first: Suit) -> Vector[Suit] = Suit.values.filter(s -> s >= first)

private data Hidden derives Enumerable
    Secret
    Kept

hiddenNames() -> Vector[string] = Hidden.values.map(h -> h.name)
