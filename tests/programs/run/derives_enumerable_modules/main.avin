// expect: exit 0
// An enumeration from another module: its `values()`, `ordinal()`, `name()` and `valueOf` reached
// through the import, and from generic code given it as a type argument. A private enumeration is
// used inside its module. A module's own trait named `Enumerable` keeps its own template's rules.
import cards.{Suit, Hearts, suitsFrom, hiddenNames}
import rules.counts

ordinals[E: Enumerable](items: Vector[E]) -> Vector[int] = items.map(e -> e.ordinal())

main()
    println(Suit.values())
    println(Hearts.ordinal())
    println(Hearts.name())
    println(Suit.valueOf("Spades"))
    println(Suit.valueOf("spades"))
    println(suitsFrom(Hearts))
    println(ordinals(Suit.values()))
    println(hiddenNames())
    println(counts())
