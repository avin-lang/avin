module shapes

// A module that declares a union alias, the data types it names, and functions taking and giving the
// union, used from another module.

data Circle(r: int)

data Square(side: int)

type Shape = Circle | Square | string

area(s: Shape) -> int = s match
    Circle(r) -> 3 * r * r
    Square(side) -> side * side
    _: string -> 0

parse(text: string) -> Shape = text match
    "circle" -> Circle(1)
    "square" -> Square(2)
    other -> other

measured(s: Circle | Square) -> int | string = s match
    Circle(r) -> r
    Square(_) -> "square"
