// expect: exit 0
// A union alias declared in another module is the union here: its values are made, passed, matched
// by type and by constructor, and widened, across the module boundary.
import shapes.{Circle, Square, Shape, area, parse, measured}

describe(s: Shape) -> string = s match
    c: Circle -> s"circle of ${c.r}"
    q: Square -> s"square of ${q.side}"
    t: string -> s"text $t"

main()
    val made: Shape = Square(3)
    println(area(made))
    println(area(Circle(2)))
    println(area("none"))
    for word in ["circle", "square", "blob"]
        println(describe(parse(word)))
    val both: Circle | Square = Circle(5)
    println(area(both))
    println(measured(both))
    println(measured(Square(1)))
