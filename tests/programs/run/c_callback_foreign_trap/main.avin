// expect: trap
// A function C calls from a thread it started itself, which the program never knew, is caught at
// the first such call when its parameter is not marked `@threaded`: the program stops, before any of
// the function runs, saying how to mark it.

@c("int cb_on_thread(int (*f)(userdata void *ud, int x), userdata void *ud, int x)")
onThread(f: int -> int, x: int) -> int

noisy(x: int) -> int
  println("never")
  x

main()
  println("before")
  println(onThread(noisy, 1))
