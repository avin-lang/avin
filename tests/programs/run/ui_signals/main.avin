// expect: exit 0
// syslui's signals through `ui`: one handle class for each instance a control takes, each read and
// set from Avin, at its bounds, and every write moving the counter the frame loop rebuilds by.
import ui.{boolSignal, intSignal, invalidate, realSignal, stringSignal, writes}

main()
    val n = intSignal(0)
    println(n.read())
    n.set(2147483647)
    println(n.read())
    n.set(-2147483648)
    println(n.read())
    n.set(n.read() + 1)
    println(n.read())
    val r = realSignal(0.5)
    r.set(r.read() * 3.0)
    println(r.read())
    r.set(-0.0)
    println(r.read())
    val b = boolSignal(true)
    b.set(!b.read())
    println(b.read())
    val s = stringSignal("")
    println(s"[${s.read()}]")
    s.set("héllo, 世界 ✓")
    println(s.read())
    s.set(s.read() + "!")
    println(s.read())
    // Each set is one write, whatever it writes, and so is each `invalidate`; a read is none.
    val before = writes()
    n.set(1)
    n.set(1)
    r.set(1.0)
    b.set(true)
    s.set("x")
    println(writes() - before)
    val read = s"${n.read()}${s.read()}"
    println(writes() - before)
    invalidate()
    println(writes() - before)
    // Two signals are two values.
    val a = intSignal(1)
    val c = intSignal(1)
    a.set(5)
    println(s"${a.read()} ${c.read()}")
    // Signals kept in Avin's collections and set in a closure.
    val all = (0..<10).map(i -> intSignal(i)).toVector()
    val bump = (k: int) -> all(k).set(all(k).read() * 10)
    for k in 0..<10
        bump(k)
    println(all.map(x -> x.read()))
    // Made and dropped while the collector runs, each read back.
    var sum: long = 0
    for i in 0..<3000
        val t = stringSignal(s"$i")
        Array.fill(32, i)
        sum += long(t.read().toInt())
    println(sum)
    // Closed, a signal's value goes back, and the handle is closed for good.
    val gone = intSignal(7)
    gone.close()
    gone.close()
    println("closed")
