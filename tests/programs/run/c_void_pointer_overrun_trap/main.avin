// expect: trap
// A length in bytes C writes back through an `inout` pointer beside a `void *` is bounded by the
// array's length in bytes, not its count of elements: eight bytes of two `int`s answer, nine stop
// the program at the call.

@c("void aa_void_take(void *buf, length(buf) inout size_t *len)")
take(buf: Array[int]) -> long

@c("void aa_void_overrun(void *buf, length(buf) inout size_t *len)")
overrun(buf: Array[int]) -> long

main()
  println(take(Array.fill(2, 0)))
  println(overrun(Array.fill(2, 0)))
