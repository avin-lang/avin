package { name = "c-array-inout-length-trap", version = "0.1.0" }

// `avin-c-fixture` is the C library in tests/c, which the test harness builds and names to
// `pkg-config`.
c-libraries {
  arrays { pkg-config = "avin-c-fixture", headers = ["avin_arrays.h"], install = "the test harness builds it from tests/c" }
}
