// expect: trap
// A length C writes back through an `inout` pointer greater than the array's stops the program at the
// call, after the lengths it may answer have crossed: `None`, which asks C the length it needs, is
// bounded by nothing.

@c("void aa_take(uint8_t *buf, length(buf) inout size_t *len)", blocking)
take(buf: Option[Array[byte]]) -> long

@c("void aa_overrun(uint8_t *buf, length(buf) inout size_t *len)")
overrun(buf: Option[Array[byte]]) -> long

main()
    println(take(None))
    println(take(Some(Array.fill(10, byte(0)))))
    println(overrun(None))
    println(overrun(Some(Array.fill(5, byte(0)))))
