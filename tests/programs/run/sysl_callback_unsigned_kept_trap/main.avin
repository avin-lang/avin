// expect: trap
// A callback Sysl keeps and calls later is checked when it answers: the program stops where the
// binding that Sysl was running in, the one calling the kept function, was called.

@sysl("avintest.callbacks.keep_unsigned")
keepUnsigned(f: (int) -> long)

@sysl("avintest.callbacks.call_kept_unsigned")
callKeptUnsigned(x: int) -> long

main()
  keepUnsigned(x -> 4294967295 - long(x))
  println(callKeptUnsigned(0))
  println(callKeptUnsigned(-1))
