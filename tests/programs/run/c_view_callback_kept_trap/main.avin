// expect: trap
// The view C lends a callback is closed when the callback returns, since C frees the memory then: a view
// kept past the call stops the program at its use, naming the view and the binding.
import avin.c.ByteView

@c(
  "int bf_stream_write(int total, int chunk, int (*write)(userdata void *closure, const unsigned char *data, length(data) unsigned int length), userdata void *closure)"
)
writeStream(total: int, chunk: int, write: (ByteView) -> int) -> int

main()
  var kept: Option[ByteView] = None
  writeStream(8, 8, chunk ->
    kept = Some(chunk)
    0)
  println(kept.get.length)
