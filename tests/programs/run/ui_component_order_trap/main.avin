// expect: trap
// A component's scope gives back what it keeps by the order the component asks in, so a build that
// asks for a value of another type where the last one asked stops the program; asking for the same
// types in the same order, or for more than before, is fine.
import ui.{component, root, state, text}

main()
    val flip = state(false)
    val build = root(() -> component c ->
        if flip.get()
            val s = c.state("text")
            text(s.get())
        else
            val n = c.state(1)
            text(s"${n.get()}"))
    build()
    build()
    println("same order")
    flip.set(true)
    build()
    println("never")
