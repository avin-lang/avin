// expect: exit 0
// Work for the main thread, with no window: `handlePosted` is what the frame loop calls at the start
// of every frame. Messages and posted work run on the main thread, in the order they were sent, a
// thread's own order kept among many senders; a lightweight thread that asks waits, parked, for the
// answer; what a handler sends or posts waits for the next call; and an inbox's handler changes the
// interface's state, which the next build shows.
import avin.threads.{Future, Promise, isMainThread, scope, sleep, spawn}
import avin.time.millis
import ui.{Inbox, Rect, State, View, column, component, handlePosted, inbox, post, recorder, root, snapshot, state, text}

data Note(who: string, n: int)

data Boxed(box: Inbox[string, int])

// `body` run on a lightweight thread of its own, and the future of what it answers.
started[T: Sendable](@sendable body: () -> T) -> Future[T]
    val p = Promise[T]()
    spawn(() -> p.complete(body()))
    p.future

// Handles everything waiting until `f` is complete, as the frames of a window would; answers how many.
pump[T](f: Future[T]) -> int
    var handled = 0
    while !f.isCompleted()
        handled += handlePosted()
        sleep(millis(1))
    handled + handlePosted()

shown(count: State[int]) -> View = component c ->
    column([text(s"count=${count.get()}")])

texts(v: View) -> string
    val lines = snapshot(v, recorder(), Rect(0, 0, 400, 600)).dump().split("\n")
    lines.filter(l -> l.contains(" text \"")).map(l -> l.split("\"")(1)).mkString(" ")

main()
    // Nothing waiting: nothing runs.
    println(handlePosted())

    // Posted from the main thread itself: queued, run by the next call and not before.
    post(() -> println(s"posted, on main: ${isMainThread()}"))
    println("before")
    println(handlePosted())
    println(handlePosted())

    // An inbox's messages and posted work, interleaved by one thread, run in the order sent.
    val seen = Buffer[string]()
    val notes = inbox((m: Note) -> seen.append(s"${m.who}${m.n}"))
    val lengths = inbox((s: string) -> s.byteLength())
    notes.send(Note("a", 1))
    post(() -> println("work 1"))
    val f = lengths.send("größe ✓")
    notes.send(Note("a", 2))
    post(() -> println("work 2"))
    println(f.isCompleted())
    println(handlePosted())
    println(seen.mkString(" "))
    println(f.await())

    // A lightweight thread sends, then waits on the future: the main thread answers it.
    val squares = inbox((n: long) -> n * n)
    val t = started(() -> squares.send(9223372036854775807 / 4294967296).await())
    pump(t)
    println(t.await())

    // A lightweight thread that asks parks until the main thread has handled the message.
    val asked = started(() -> (squares.ask(-3), isMainThread()))
    pump(asked)
    println(asked.await())

    // The handler runs on the main thread, whichever thread sent.
    val where = inbox((u: unit) -> isMainThread())
    val fromThread = started(() -> where.ask(()))
    pump(fromThread)
    println(fromThread.await())

    // Many senders at once: every message runs once, and each thread's in the order it sent them.
    seen.clear()
    val senders = 8
    val each = 50
    val all = started(() -> scope(s ->
        for k in 0..<senders do s.spawn(() -> for i in 0..<each do notes.send(Note(s"t$k.", i)))
        ()))
    println(pump(all))
    println(seen.length())
    var ordered = true
    for k in 0..<senders
        val mine = seen.filter(x -> x.startsWith(s"t$k.")).mkString(",")
        val sent = (0..<each).map(i -> s"t$k.$i").mkString(",")
        if mine != sent then ordered = false
    println(ordered)

    // Posted and asked from another thread, and asked from a pool's future, in that thread's order.
    val log = inbox((s: string) -> println(s))
    val mixed = started(() ->
        log.send("first")
        post(() -> println("second"))
        log.ask("third")
        Future(log.ask("fourth")).await())
    pump(mixed)

    // What a handler sends or posts waits for the next call.
    val again = inbox((n: int) -> println(s"again $n"))
    post(() ->
        println("outer")
        again.send(1)
        post(() -> println("inner")))
    println(handlePosted())
    println(handlePosted())
    println(handlePosted())

    // A handler that changes the interface's state: the next build shows it.
    val count = state(0)
    val build = root(() -> shown(count))
    val bump = inbox((by: int) -> count.update(n -> n + by))
    println(texts(build()))
    val bumper = started(() ->
        bump.ask(2)
        bump.ask(40))
    pump(bumper)
    println(texts(build()))

    // An inbox handed on: through a thread to a thread, and inside a data value.
    val boxed = Boxed(lengths)
    val nested = started(() -> spawn(() -> boxed.box.ask("")).join())
    pump(nested)
    println(nested.await())
