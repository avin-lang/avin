// expect: trap
// An `unsigned long` result past the greatest `long` stops the program at the call, naming the Avin
// type that cannot hold it, rather than arriving negative.

@c("unsigned long fixture_max_ulong(void)")
maxUlong() -> long

@c("unsigned long fixture_echo_ulong(unsigned long)")
echoUlong(n: long) -> long

main()
    println(echoUlong(9223372036854775807))
    println(maxUlong())
