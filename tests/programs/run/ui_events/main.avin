// expect: exit 0
// Events through `ui`, with no window: a tree is drawn on syslui's recording canvas, a control is
// found by its key in the snapshot, and the pointer is pressed and let go at it. What the control
// does then is Avin code, called back on the thread that let go.
import ui.{
  Duplicate, Missed, Rect, Unknown, Warning, button, column, intSignal, invalidate, recorder, render, row, snapshot,
  stringSignal, tabs, tap, text, textArea, textField, writes
}

val Screen = Rect(0, 0, 400, 300)

said(r: Result[unit, Missed]) -> string = r match
  Ok(_) -> "tapped"
  Err(m) -> s"${m.kind}: ${m.message}"

class Counter
  var count = 0
  bump() = count += 1

main()
  // A button's callback, a closure over a local, runs once for each tap.
  var count = 0
  val add = button("Add", () -> count += 1).named("add")
  println(said(tap(add, "add", Screen)))
  println(said(tap(add, "add", Screen)))
  println(count)
  // By a method value, and on buttons inside containers.
  val counter = Counter()
  val panel = column(
    [
      text("title"),
      row([button("+", counter.bump).named("plus"), button("-", () -> counter.count -= 1, Warning).named("minus")], 4)
    ],
    8
  )
  for _ in 0 ..< 3
    _ = tap(panel, "plus", Screen)
  _ = tap(panel, "minus", Screen)
  println(counter.count)
  // By its reference in the snapshot, `@n`.
  println(snapshot(panel, recorder(), Screen).dump())
  println(said(tap(panel, "@3", Screen)))
  println(counter.count)
  // `onTap` makes any view tappable.
  var tapped = ""
  val label = text("label").onTap(() -> tapped = tapped + "!").named("label")
  _ = tap(label, "label", Screen)
  _ = tap(label, "label", Screen)
  println(tapped)
  // A key that reaches nothing, a text that is no control's name, and a name two controls share.
  println(said(tap(panel, "nothing", Screen)))
  println(said(tap(panel, "@99", Screen)))
  println(said(tap(panel, "", Screen)))
  println(tap(text("x"), "x", Screen) match
    Err(Missed(Unknown, _)) -> "unknown"
    _ -> "other")
  val twice = row([button("a", () -> count += 1000).named("same"), button("b", () -> count += 1000).named("same")])
  println(tap(twice, "same", Screen) match
    Err(Missed(Duplicate, m)) -> s"duplicate: ${m.contains("names two controls")}"
    _ -> "other")
  println(count)
  // A control laid out past the drawn area is not on screen.
  val far = column([text("top").frame(10, 400), button("low", () -> count += 100).named("low")])
  println(said(tap(far, "low", Screen)))
  println(count)
  // Where to tap, as the snapshot says.
  val s = snapshot(add, recorder(), Screen)
  println(s.clickPoint("add"))
  println(s.clickPoint("absent").isErr)
  println(s.len())
  println(s.toJson().contains("\"name\":\"add\""))
  println(snapshot(column([]), recorder(), Screen).len())
  // A tap is a press and a release in one control: a press alone does nothing, and a release
  // outside the control the press began in is not a tap.
  val small = column([button("Add", () -> count += 1).named("add"), text("below")])
  val (x, y) = snapshot(small, recorder(), Screen).clickPoint("add").getOrElse((-1, -1))
  val c = recorder()
  render(small, c, Screen)
  c.point(x, y, true)
  println(count)
  c.release(x, y)
  println(count)
  val d = recorder()
  render(small, d, Screen)
  d.point(x, y, true)
  d.release(390, 290)
  println(count)
  // Tabs build their body by calling back with the chosen index.
  var built: Vector[int] = []
  val tabbed = tabs(["One", "Two", "Three"], intSignal(1), i ->
    built = built :+ i
    text(s"body $i"))
  println(snapshot(tabbed, recorder(), Screen).dump())
  println(built)
  // A text field and an area show the text they edit.
  println(
    snapshot(
      column(
        [
          textField(stringSignal("typed"), 1, hint = "name"),
          textArea(stringSignal("two\nlines"), 2, rows = 2),
          textField(stringSignal(""), 3, width = 50, hint = "empty")
        ]
      ),
      recorder(),
      Screen
    ).dump()
  )
  // A tap's callback may move the counter the frame loop rebuilds by, as `invalidate` does.
  val rebuild = button("rebuild", () -> invalidate()).named("rebuild")
  val before = writes()
  _ = tap(rebuild, "rebuild", Screen)
  println(writes() - before)
  _ = tap(rebuild, "rebuild", Screen)
  println(writes() - before)
  // A callback that builds and taps another tree while it runs.
  var inner = 0
  val outer = button("outer", () ->
    _ = tap(button("inner", () -> inner += 1).named("inner"), "inner", Screen)
    inner += 10).named("outer")
  _ = tap(outer, "outer", Screen)
  println(inner)
  // A callback's trees outlive it: the view a callback built is tapped afterwards.
  var later: Vector[ui.View] = []
  _ = tap(
    button("make", () -> later = later :+ button("made", () -> inner += 100).named("made")).named("make"),
    "make",
    Screen
  )
  _ = tap(later(0), "made", Screen)
  println(inner)
  // Many taps while the collector runs, each callback a closure of its own.
  var total = 0
  for i in 0 ..< 500
    val b = button(s"$i", () -> total += i).named("b")
    Array.fill(64, i)
    _ = tap(b, "b", Screen)
  println(total)
