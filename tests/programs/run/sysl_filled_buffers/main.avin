// A Sysl function may fill an array the binding passes it: an `Array` of bytes, integers, reals,
// booleans or characters, as the binding's own parameter, is copied into a slice the function may
// write, and what the function left there is copied back into the array when it returns. Its result
// says how much it wrote; the rest of the array keeps what it held.

@sysl("avintest.digits.fill_digits")
fillDigits(n: long, into: Array[byte]) -> long

@sysl("avintest.digits.fill_all_digits")
fillAllDigits(n: long, into: Array[byte]) -> Option[long]

@sysl("avintest.digits.copy_into")
copyInto(from: Array[byte], into: Array[byte]) -> long

@sysl("avintest.digits.fill_squares")
fillSquares(into: Array[int]) -> long

@sysl("avintest.digits.fill_powers")
fillPowers(into: Array[long])

@sysl("avintest.digits.fill_small")
fillSmall(into: Array[i16]) -> i16

@sysl("avintest.digits.fill_tiny")
fillTiny(into: Array[i8])

@sysl("avintest.digits.fill_halves")
fillHalves(into: Array[real]) -> real

@sysl("avintest.digits.fill_flags")
fillFlags(into: Array[bool]) -> int

@sysl("avintest.digits.fill_letters")
fillLetters(into: Array[char]) -> string

@sysl("avintest.digits.checksum")
checksum(bytes: Array[byte]) -> byte

// An array anywhere but a binding's own parameter crosses as a copy Sysl may only read.
@sysl("avintest.digits.maybe_checksum")
maybeChecksum(bytes: Option[Array[byte]]) -> byte

// A vector cannot change, so one passed where the function writes is a copy it may write and Avin
// never sees.
@sysl("avintest.digits.fill_digits")
fillVector(n: long, into: Vector[byte]) -> long

// A handle's method fills an array as a function does, as a stream's `read` would.
@sysl("avintest.digits.Counter")
class Counter
  read(into: Array[byte]) -> long

@sysl("avintest.digits.new_counter")
newCounter(first: byte) -> Counter

show(a: Array[byte]) -> string = a.map(b -> int(b)).mkString("[", ",", "]")

main()
  // A whole fill, a partial one into a shorter array, and one into nothing.
  val whole = Array.fill(5, byte(9))
  println(s"${fillDigits(12345, whole)} ${show(whole)}")
  val short = Array.fill(3, byte(9))
  println(s"${fillDigits(9876543, short)} ${show(short)}")
  val longer = Array.fill(6, byte(9))
  println(s"${fillDigits(42, longer)} ${show(longer)}")
  val empty = Array.fill(0, byte(9))
  println(s"${fillDigits(7, empty)} ${show(empty)}")
  // The result is made while the array is kept, and the array is filled all the same.
  val some = Array.fill(4, byte(0))
  println(s"${fillAllDigits(2024, some)} ${show(some)} ${fillAllDigits(123456, some)} ${show(some)}")
  // An array nothing else holds is kept until it is filled, while the result is made.
  println(s"${fillAllDigits(77, Array.fill(2, byte(0)))} ${fillLetters(Array.fill(2, ' '))}")
  // One parameter read and another filled; the one read keeps what it held.
  val from = Array.tabulate(4, i -> byte(i + 1))
  val into = Array.fill(2, byte(0))
  println(s"${copyInto(from, into)} ${show(from)} ${show(into)}")
  // Each kind of element.
  val squares = Array.fill(5, -1)
  println(s"${fillSquares(squares)} ${squares.mkString(",")}")
  val powers = Array.fill(4, long(0))
  fillPowers(powers)
  println(powers.mkString(","))
  val small = Array.fill(4, i16(0))
  println(s"${fillSmall(small)} ${small.mkString(",")}")
  val tiny = Array.fill(3, i8(0))
  fillTiny(tiny)
  println(tiny.mkString(","))
  val halves = Array.fill(4, 0.0)
  println(s"${fillHalves(halves)} ${halves.mkString(",")}")
  val flags = Array.fill(5, false)
  println(s"${fillFlags(flags)} ${flags.mkString(",")}")
  val letters = Array.fill(3, '?')
  println(s"${fillLetters(letters)} ${letters.mkString(",")}")
  // A function that only reads its slice leaves the array as it was.
  val read = Array.tabulate(4, i -> byte(i * 10))
  println(s"${int(checksum(read))} ${show(read)}")
  println(s"${int(maybeChecksum(Some(read)))} ${int(maybeChecksum(None))}")
  // A vector passed to a function that writes stays what it was.
  val fixed: Vector[byte] = [byte(9), byte(9)]
  println(s"${fillVector(55, fixed)} $fixed")
  // A filled array is an ordinary array afterwards, through many calls and collections.
  var total = long(0)
  for i in 0 ..< 2000
    val buffer = Array.fill(8, byte(0))
    total += fillDigits(long(i) * 1000003, buffer)
    total += long(buffer(0))
  println(total)
  val counter = newCounter(byte(250))
  val chunk = Array.fill(4, byte(0))
  println(s"${counter.read(chunk)} ${show(chunk)}")
  println(s"${counter.read(chunk)} ${show(chunk)}")
  println(counter.read(Array.fill(0, byte(0))))
  counter.close()
