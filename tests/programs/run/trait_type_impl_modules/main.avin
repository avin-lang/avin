// expect: exit 0
// A trait type's impl stated in the trait's module, and one stated in the trait type's module, are
// found from a third: by a call, through a bound, and inside another module's generic function.
import shapes.{Shape, Square}
import shows.{Show, shown}

both[T: Show](x: T) -> string = x.show() + "|" + shown(x)

main()
  val m: Map[string, int] = {"a": 1, "b": 2}
  println(m.show())
  println(shown(m))
  println(both(m))
  val s: Shape = Square(3)
  println(s.show())
  println(shown(s))
  println(both(s))
  val nested: Map[int, Map[string, int]] = {1: m}
  println(shown(nested))
