module shows

// A trait with its impl for a trait type of the core library, stated in the trait's module.
trait Show
  show() -> string

impl Show for int
  show() -> string = s"i$self"

impl[K, A: Show] Show for Map[K, A]
  show() -> string
    var out = "map"
    for (_, v) in self
      out = out + " " + v.show()
    out

shown[T: Show](x: T) -> string = x.show()
