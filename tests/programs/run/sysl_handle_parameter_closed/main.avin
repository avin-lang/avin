// expect: trap
// A handle `close()` has given back, passed to Sysl as a parameter, stops the program at the call, as
// calling one of its bound methods does: here as the parameter of another handle's method, after a
// top-level binding has taken an open one and a closed one has been closed again.

@sysl("avintest.digits.Tally")
class Tally
  get() -> long

@sysl("avintest.digits.new_tally")
newTally(n: long) -> Tally

@sysl("avintest.digits.sum_of")
sumOf(a: Tally, b: Tally) -> long

@sysl("avintest.digits.Ledger")
class Ledger
  record(t: Tally)
  summary() -> long

@sysl("avintest.digits.new_ledger")
newLedger() -> Ledger

main()
  val a = newTally(2)
  val b = newTally(5)
  val book = newLedger()
  println(sumOf(a, b))
  book.record(b)
  b.close()
  b.close()
  println(book.summary())
  book.record(b)
  println("not reached")
