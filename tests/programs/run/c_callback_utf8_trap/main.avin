// expect: trap
// A string C calls a callback with is checked as UTF-8 as it is copied: an ill-formed sequence stops
// the program where the binding was called, at the byte it starts at.

@c("int cb_bad_string(int (*f)(userdata void *ud, const char *s), userdata void *ud)")
badString(f: string -> int) -> int

@c("int cb_bad_string(int (*f)(userdata void *ud, const char *s), userdata void *ud)")
badBytes(f: Array[byte] -> int) -> int

main()
    println(badBytes(b -> b.length))
    println(badString(s -> s.byteLength))
