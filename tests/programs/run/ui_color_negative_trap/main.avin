// expect: trap
// A colour syslui's unsigned colour cannot hold, a negative one, stops the program where the
// modifier was called, naming the Sysl type.
import ui.{Rect, recorder, render, text}

main()
    val c = recorder()
    render(text("a").foreground(0x000001), c, Rect(0, 0, 10, 10))
    println("drawn")
    val shade = 1 - 2
    render(text("a").background(shade), c, Rect(0, 0, 10, 10))
    println("not drawn")
