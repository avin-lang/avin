// A surface with `attach:` keeps the block it was made over for as long as C holds the surface, under
// collections at every allocation: its handle is collected while a holder draws into the block, and
// C's destroy, when the holder lets go, runs once.
import avin.c.ByteBlock

@c(type: "bf_surface *", release: "bf_surface_unref",
   attach: "bf_surface_set_user_data(self, key, data, destroy)", key: "bf_user_data_key_t")
class Surface

@c("bf_surface *bf_surface_new(unsigned char *pixels, length(pixels) int n)", keeps: "pixels")
surfaceOver(pixels: ByteBlock) -> Surface

@c(type: "bf_holder *", release: "bf_holder_free")
class Holder
    @c("long bf_holder_sum(bf_holder *self)")
    sum() -> long

    @c("void bf_holder_paint(bf_holder *self, unsigned char value)")
    paint(value: byte)

@c("bf_holder *bf_holder_new(bf_surface *s)")
holderOf(s: Surface) -> Holder

@c("int bf_destroys(void)")
destroys() -> int

holderOverBlock(n: int) -> Holder
    val b = ByteBlock(n)
    b.fill(0, n, byte(1))
    holderOf(surfaceOver(b))

main()
    val h = holderOverBlock(64)
    for i in 0..<100
        val junk = [i, i, i]
        h.paint(byte(junk(0) % 256))
    println(h.sum())
    println(destroys())
    h.close()
    println(destroys())
    for i in 0..<100
        val junk = [i]
        junk(0)
