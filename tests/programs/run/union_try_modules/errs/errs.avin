module errs

// Error types, their conversions, an error union alias and a function yielding it, used with `?`
// from another module.

data IoError(path: string)
data ParseError(line: int)
data ConfigError(msg: string)

impl From[IoError] for ConfigError
  static from(e: IoError) -> ConfigError = ConfigError(s"io ${e.path}")

impl From[ParseError] for ConfigError
  static from(e: ParseError) -> ConfigError = ConfigError(s"parse ${e.line}")

type LoadError = IoError | ParseError

readText(p: string) -> Result[string, IoError] = if p == "" then Err(IoError("none")) else Ok(p)

parseIt(t: string) -> Result[int, ParseError] = if t.startsWith("x") then Err(
  ParseError(t.charCount)
) else Ok(t.charCount)

load(p: string) -> Result[int, LoadError]
  val t = readText(p)?
  Ok(parseIt(t)?)
