// expect: exit 0
// `?` across modules: errors of another module's types passed on as members of a union declared
// here and through that module's alias, converted member by member by that module's `From` impls,
// and by the one member implementing `From`, with members and methods of the union reached here.
import errs.{IoError, ParseError, ConfigError, LoadError, readText, parseIt, load}

data Invalid(why: string)

checked(p: string) -> Result[int, LoadError | Invalid]
    val n = load(p)?
    if n > 3 then Err(Invalid("long")) else Ok(n)

direct(p: string) -> Result[int, IoError | ParseError]
    val t = readText(p)?
    Ok(parseIt(t)?)

settings(p: string) -> Result[int, ConfigError]
    val n = load(p)?
    Ok(n)

either(p: string) -> Result[int, ConfigError | Invalid]
    val t = readText(p)?
    if t == "bad" then Err(Invalid("bad")) else Ok(t.charCount())

main()
    for p in ["", "xy", "abcdef", "ab"]
        println(s"${checked(p)} ${direct(p)} ${settings(p)} ${either(p)}")
    val e: LoadError = ParseError(9)
    println(s"$e ${e == ParseError(9)} ${e.toString()}")
