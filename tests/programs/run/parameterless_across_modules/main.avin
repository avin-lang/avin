// expect: exit 0
// A method declared with no parameter list in another module is called by its name alone, through
// the class, the trait it implements and its default, a field implementing it, and an impl that
// module adds to a built-in type; a private one is read by the module's own public method.
import shapes
import shapes.{Shape, Square, Label}

main()
    val s = Square(3)
    println(s.area)
    println(s.reveal)
    val all: Vector[Shape] = [s, Label(5)]
    for x in all
        println(x.describe)
    println("avin".initial)
    println(shapes.Square(2).area)
