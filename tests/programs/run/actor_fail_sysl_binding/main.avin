// expect: trap
// A value a Sysl binding cannot take, passed from an actor, stops the program instead of failing
// the actor, whatever its supervision: the trap is inside the Sysl call. The report names the actor
// and the place the binding was called.
import avin.actors.{Stop, spawn}
import avin.threads.Channel

@sysl("avintest.digits.show_u8")
showU8(x: int) -> string

actor Shower(done: Channel[string]) receives int
    receive
        n -> done.send(showU8(n))

main()
    val done = Channel[string]()
    val a = spawn(Shower(done), onFailure = Stop)
    a.tell(255)
    println(done.receive().get)
    a.tell(256)
    println(done.receive())
    println("not reached")
