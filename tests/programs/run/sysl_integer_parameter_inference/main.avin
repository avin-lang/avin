// expect: exit 0
// A binding to a generic Sysl function that infers a type parameter from its integer parameters
// together with another argument, here a signal handle, passes those integers as the Avin type
// itself, as syslui's `slider` takes its bounds; a function that is not generic converts its integer
// parameter beside the same handle.

@sysl("avintest.views.Signal[int]")
class IntSignal
  read() -> int
  set(v: int)

@sysl("avintest.views.Signal[long]")
class LongSignal
  read() -> long

@sysl("avintest.views.signal")
intSignal(v: int) -> IntSignal

@sysl("avintest.views.signal")
longSignal(v: long) -> LongSignal

@sysl("avintest.views.clamped")
clamped(s: IntSignal, lo: int, hi: int) -> int

@sysl("avintest.views.clamped")
clampedLong(s: LongSignal, lo: long, hi: long) -> long

@sysl("avintest.views.padded_count")
paddedCount(s: IntSignal, width: int) -> string

main()
  val s = intSignal(50)
  println(clamped(s, 0, 100))
  println(clamped(s, 60, 100))
  println(clamped(s, -2147483648, 10))
  s.set(-7)
  println(clamped(s, -5, 5))
  println(clampedLong(longSignal(9223372036854775807), 0, 4294967296))
  println(s"[${paddedCount(s, 6)}]")
  println(s"[${paddedCount(s, 0)}]")
