// expect: exit 0
// Two modules each with a file named `codec.avin`, holding derive templates whose text is the same at
// the same offsets: a trap site in a template two types derive is named by its file and offset, and
// the module the file belongs to tells the two apart, so the program builds. Three formats of the
// standard library (`avin.toml`, `avin.cbor`, `avin.msgpack`) each have a `codec.avin` the same way.
import alpha.Alpha
import gamma.Gamma

data One(a: int) derives Alpha, Gamma

data Two(a: int, b: int) derives Alpha, Gamma

data Four(a: int, b: int, c: int, d: int) derives Alpha, Gamma

main()
  println(One(1).alpha())
  println(One(1).gamma())
  println(Two(1, 2).alpha())
  println(Two(1, 2).gamma())
  println(Four(1, 2, 3, 4).alpha() + Four(1, 2, 3, 4).gamma())
