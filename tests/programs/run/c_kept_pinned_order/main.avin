// expect: exit 0
// A node keeps its parent with no C reference, and its release frees it only while the parent is
// open: the parent's free would free it first, and the node's own free afterwards would be a use
// after free, which the fixture stops the process for. The kept parent is kept from the collector
// until the node's release has run, so whichever handle the collector finds dead first, and in either
// address order, every node is freed by its own release, children before parents: in pairs, in
// chains of three, and with several branches of one root.
import fixture.{Root, newRoot, nodes, nodesFreedByParent, nodesFreedOwn}

// The root's handle made before the branch's, at the lower address.
pair(i: int) -> int = newRoot().branch().depth() + i

// The branch's handle made before a root's made last, which a second branch keeps.
later(i: int) -> int
  val root = newRoot()
  val b = root.branch()
  val other = newRoot()
  other.branch().depth() + b.depth() + i

// A root, a branch and a leaf, all dead at once.
chain(i: int) -> int = newRoot().branch().leaf().depth() + i

// Several branches of one root.
several(root: Root) -> int = root.branch().depth() + root.branch().leaf().depth()

main()
  var sum = 0
  for i in 0 ..< 200
    sum += pair(i)
    sum += later(i)
    sum += chain(i)
    sum += several(newRoot())
  var n = 0
  while nodes().freed < nodes().created && n < 1000000
    val v = [n, n + 1]
    n += v(1) - v(0)
  println(nodes().created)
  println(nodes().created == nodes().freed)
  println(nodesFreedOwn() == nodes().created)
  println(nodesFreedByParent())
