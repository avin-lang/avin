// expect: exit 0
// The colour modifiers through `ui`: a colour is an `int` holding `0xRRGGBB`, passed into syslui's
// unsigned colour with a check, and the recording canvas writes down the colour each one drew.
import ui.{Rect, View, button, column, darken, lighten, mix, recorder, render, rgb, snapshot, text}

val Screen = Rect(0, 0, 200, 100)

// What `v` draws, one operation a line.
show(title: string, v: View)
    println(s"-- $title")
    val c = recorder()
    render(v, c, Screen)
    print(c.dump())

main()
    show("background", text("a").background(0xFF0000))
    show("background rounded", text("a").background(0x00FF00, 4))
    show("black and white", column([text("b").background(0x000000), text("w").background(0xFFFFFF)]))
    show("border", text("a").border(0x0000FF))
    show("border wide dashed", text("a").border(0x123456, 2, 3, 5))
    show("foreground", text("ink").foreground(0xABCDEF))
    show("foreground nested", column([text("x"), text("y").foreground(0x010203)]).foreground(0x0A0B0C))
    show("tinted", button("go", () -> ()).tinted(0x3A6EA5))
    // Every modifier at once, in a chain read from the innermost view out.
    show("chain", text("all").foreground(0x111111).padding(2).background(0x222222, 1).border(0x333333))
    show("spec example", text("Saved").foreground(0xFFFFFF).padding(8).background(darken(0x3E9B5F, 20), 6))
    // A colour made while the program runs is checked as a literal is.
    var shades: Vector[View] = []
    for i in 0..<4
        shades = shades :+ text(s"$i").background(rgb(i * 85, 255 - i * 85, 0))
    show("computed", column(shades))
    println(rgb(0, 0, 0))
    println(rgb(255, 255, 255) == 0xFFFFFF)
    println(rgb(0x12, 0x34, 0x56) == 0x123456)
    println(mix(0x000000, 0xFFFFFF, 50) == rgb(127, 127, 127))
    println(mix(0x102030, 0x405060, -5) == 0x102030)
    println(mix(0x102030, 0x405060, 500) == 0x405060)
    println(lighten(0x000000, 100) == 0xFFFFFF)
    println(darken(0xFFFFFF, 100))
    println(lighten(0x3A6EA5, 0) == 0x3A6EA5)
    // The snapshot names what is on screen through a colour modifier, as through any other.
    print(snapshot(text("seen").background(0xFF00FF).named("tag"), recorder(), Screen).dump())
