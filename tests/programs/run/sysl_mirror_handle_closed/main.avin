// expect: trap
// A handle `close()` has given back, passed to Sysl as a mirror's field, stops the program at the
// call, as passing it as a parameter does: here a mark, the second field of a variant, inside an
// `Option`, after an open one has crossed the same way.

@sysl("avintest.digits.Tally")
class Tally
    get() -> long

@sysl("avintest.digits.new_tally")
newTally(n: long) -> Tally

@sysl("avintest.digits.Mark")
class Mark
    place() -> long

@sysl("avintest.digits.mark_at")
markAt(n: long) -> Mark

@sysl("avintest.digits.Source")
data Source
    FromTally(tally: Tally)
    FromMark(mark: Mark)
    Number(n: long)
    Both(tally: Tally, mark: Mark)

@sysl("avintest.digits.count_maybe")
countMaybe(s: Option[Source]) -> long

main()
    val t = newTally(4)
    val m = markAt(2)
    println(countMaybe(Some(Both(t, m))))
    m.close()
    println(t.get())
    println(countMaybe(Some(Both(t, m))))
    println("not reached")
