// expect: exit 0
// `with` on data types declared in other modules: a path reaches through a field whose type is from
// a third module, and a generic data type from another module keeps its type argument.
import scene.{Sprite, Tagged, start}
import geometry.Point

main()
    val s = start()
    println(s with { pos.x = 5, name = "moved" })
    println(s with { pos = Point(9, 9) })
    val t: Tagged[Sprite] = Tagged(s, "first")
    println(t with { item.pos.y = 0, tag = "second" })
    println(t)
