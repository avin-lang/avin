// expect: exit 0
// An interpolator declared in another module, through a trait and its impl for `StringContext`, is
// called wherever the trait's module is imported. The holes are its arguments, checked against its
// parameters, and the parts reach it as written.
import sql

main()
  val id = 7
  val q = sql"select * from t where id = $id and n = ${id + 1}"
  println(q.text)
  println(q.values)
  println(sql"no holes \n".text)
