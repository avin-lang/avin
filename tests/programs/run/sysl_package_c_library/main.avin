// A binding to a Sysl package that binds a C library the machine supplies: SQLite, which the package
// names with `@link` and as a `pkg_config` requirement. The executable is linked with the library.

@sysl("sh.sysl.sqlite.compiled_with")
compiledWith(option: string) -> bool

main()
    // Asking SQLite about an option no build of it has calls into the library.
    println(compiledWith("AVIN_NOT_AN_OPTION"))
