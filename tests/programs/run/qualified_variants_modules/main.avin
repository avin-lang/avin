// expect: exit 0
// A type of another module reaches its variants through the module, `m.Type.Variant`, where the
// module is imported whole, and as `Type.Variant` where the type itself is imported; the module's
// bare `m.Variant` still works. Patterns take every form, and a generic type's arguments are inferred.
import palette
import palette.Shade

describe(s: Shade[int]) -> string = s match
  Shade.Tinted(palette.Color.Red, n) -> s"red $n"
  Shade.Tinted(palette.Green, n) -> s"green $n"
  palette.Shade.Tinted(_, n) -> s"other $n"
  Shade.Plain -> "plain"

main()
  println(palette.Color.Red)
  println(palette.Red == palette.Color.Red)
  println(palette.warmth(palette.Color.Green))
  println(describe(Shade.Tinted(palette.Color.Red, 3)))
  println(describe(palette.Shade.Tinted(palette.Green, 4)))
  println(describe(Shade.Tinted(palette.Color.Blue, 5)))
  println(describe(palette.Shade.Plain))
  val plain: Shade[string] = Shade.Plain
  println(plain)
  palette.Color.Blue match
    palette.Color.Red | palette.Color.Green -> println("warm")
    palette.Color.Blue -> println("cool")
