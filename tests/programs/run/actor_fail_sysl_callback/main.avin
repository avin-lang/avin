// expect: trap
// A trap inside an Avin function Sysl called, from an actor, stops the program instead of failing
// the actor, whatever its supervision: the Sysl frames waiting below it would never finish. The
// report names the actor and the callback's own place. A callback that has returned leaves the
// actor able to fail alone again.
import avin.actors.{Stop, spawn}
import avin.threads.Channel

@sysl("avintest.callbacks.apply")
apply(f: (int) -> int, x: int) -> int

data Msg
  Inside(n: int)
  After(n: int)

actor Caller(done: Channel[string]) receives Msg
  receive
    Inside(n) -> done.send(s"${apply(x -> 100 / x, n)}")
    After(n) ->
      val r = apply(x -> x, n)
      done.send(s"${100 / r}")

main()
  val done = Channel[string]()
  val a = spawn(Caller(done), onFailure = Stop)
  a.tell(Inside(4))
  println(done.receive().get)
  // After the callback has returned, a trap in the actor's own code fails it alone.
  val b = spawn(Caller(done), onFailure = Stop)
  b.tell(After(0))
  println(b.ended().await())
  a.tell(After(5))
  println(done.receive().get)
  a.tell(Inside(0))
  println(done.receive())
  println("not reached")
