// expect: trap
// A handle used by a thread while another owns it stops the program, here as a field of a Sysl
// mirror passed to a binding: the thread that made it is still running, and hands it over through a
// channel, which does not move what it carries.
import avin.threads.{Channel, spawn}

@sysl("avintest.digits.Tally")
class Tally
  get() -> long

@sysl("avintest.digits.new_tally")
newTally(n: long) -> Tally

@sysl("avintest.digits.Mark")
class Mark
  place() -> long

@sysl("avintest.digits.mark_at")
markAt(n: long) -> Mark

@sysl("avintest.digits.Pin")
data Pin(tally: Tally, mark: Mark)

@sysl("avintest.digits.pin_count")
pinCount(p: Pin) -> long

main()
  val mine = newTally(1)
  val at = markAt(3)
  val made = Channel[Tally]()
  val done = Channel[unit]()
  spawn(() ->
    made.send(newTally(2))
    done.receive())
  val theirs = made.receive().get
  println(pinCount(Pin(mine, at)))
  println(pinCount(Pin(theirs, at)))
  println("not reached")
