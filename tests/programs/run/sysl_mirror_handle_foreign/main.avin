// expect: trap
// A handle used by a thread while another owns it stops the program, here as a field of a Sysl
// mirror passed to a binding: the handle went through a channel to a thread that used it, so it is
// that thread's, and that thread is still running.
import avin.threads.{Channel, spawn}

@sysl("avintest.digits.Tally")
class Tally
  get() -> long

@sysl("avintest.digits.new_tally")
newTally(n: long) -> Tally

@sysl("avintest.digits.Mark")
class Mark
  place() -> long

@sysl("avintest.digits.mark_at")
markAt(n: long) -> Mark

@sysl("avintest.digits.Pin")
data Pin(tally: Tally, mark: Mark)

@sysl("avintest.digits.pin_count")
pinCount(p: Pin) -> long

main()
  val mine = newTally(1)
  val at = markAt(3)
  val theirs = newTally(2)
  val handed = Channel[Tally]()
  val used = Channel[unit]()
  val done = Channel[unit]()
  spawn(() ->
    _ = handed.receive().get.get()
    used.send(())
    done.receive())
  handed.send(theirs)
  _ = used.receive()
  println(pinCount(Pin(mine, at)))
  println(pinCount(Pin(theirs, at)))
  println("not reached")
