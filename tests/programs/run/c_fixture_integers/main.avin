// expect: exit 0
// Every C integer type crosses a C binding as an Avin integer, at the width and sign the C unit
// measured: each answers its least and greatest values, takes them back unchanged, and arrives in C
// extended as its sign says, which widening it to `long long` in C shows.

@c("signed char fixture_echo_schar(signed char)")
echoSchar(x: i8) -> i8

@c("signed char fixture_min_schar(void)")
minSchar() -> i8

@c("signed char fixture_max_schar(void)")
maxSchar() -> i8

@c("long long fixture_widen_schar(signed char)")
widenSchar(x: i8) -> long

@c("unsigned char fixture_echo_uchar(unsigned char)")
echoUchar(x: int) -> int

@c("unsigned char fixture_max_uchar(void)")
maxUchar() -> int

@c("long long fixture_widen_uchar(unsigned char)")
widenUchar(x: int) -> long

@c("short fixture_echo_short(short)")
echoShort(x: i16) -> i16

@c("short fixture_min_short(void)")
minShort() -> i16

@c("short fixture_max_short(void)")
maxShort() -> i16

@c("long long fixture_widen_short(short)")
widenShort(x: i16) -> long

@c("unsigned short fixture_echo_ushort(unsigned short)")
echoUshort(x: int) -> int

@c("unsigned short fixture_max_ushort(void)")
maxUshort() -> int

@c("long long fixture_widen_ushort(unsigned short)")
widenUshort(x: int) -> long

@c("int fixture_echo_int(int)")
echoInt(x: int) -> int

@c("int fixture_min_int(void)")
minInt() -> int

@c("int fixture_max_int(void)")
maxInt() -> int

@c("long long fixture_widen_int(int)")
widenInt(x: int) -> long

@c("unsigned int fixture_echo_uint(unsigned int)")
echoUint(x: long) -> long

@c("unsigned int fixture_max_uint(void)")
maxUint() -> long

@c("long long fixture_widen_uint(unsigned int)")
widenUint(x: long) -> long

@c("long fixture_echo_long(long)")
echoLong(x: long) -> long

@c("long fixture_min_long(void)")
minLong() -> long

@c("long fixture_max_long(void)")
maxLong() -> long

@c("unsigned long fixture_echo_ulong(unsigned long)")
echoUlong(x: long) -> long

@c("unsigned long fixture_min_ulong(void)")
minUlong() -> long

@c("long long fixture_echo_llong(long long)")
echoLlong(x: long) -> long

@c("long long fixture_min_llong(void)")
minLlong() -> long

@c("long long fixture_max_llong(void)")
maxLlong() -> long

@c("unsigned long long fixture_echo_ullong(unsigned long long)")
echoUllong(x: long) -> long

@c("int8_t fixture_echo_i8(int8_t)")
echoI8(x: i8) -> i8

@c("int8_t fixture_min_i8(void)")
minI8() -> i8

@c("long long fixture_widen_i8(int8_t)")
widenI8(x: i8) -> long

@c("int16_t fixture_max_i16(void)")
maxI16() -> i16

@c("long long fixture_widen_i16(int16_t)")
widenI16(x: i16) -> long

@c("int32_t fixture_min_i32(void)")
minI32() -> int

@c("int64_t fixture_max_i64(void)")
maxI64() -> long

@c("uint8_t fixture_max_u8(void)")
maxU8() -> int

@c("long long fixture_widen_u8(uint8_t)")
widenU8(x: int) -> long

@c("uint16_t fixture_max_u16(void)")
maxU16() -> int

@c("long long fixture_widen_u16(uint16_t)")
widenU16(x: int) -> long

@c("uint32_t fixture_max_u32(void)")
maxU32() -> long

@c("uint64_t fixture_echo_u64(uint64_t)")
echoU64(x: long) -> long

@c("size_t fixture_echo_size(size_t)")
echoSize(x: long) -> long

@c("ssize_t fixture_min_ssize(void)")
minSsize() -> long

@c("ptrdiff_t fixture_max_ptrdiff(void)")
maxPtrdiff() -> long

@c("intptr_t fixture_min_intptr(void)")
minIntptr() -> long

@c("uintptr_t fixture_echo_uintptr(uintptr_t)")
echoUintptr(x: long) -> long

// An enumeration with no negative value is unsigned, and one with a negative value signed.
@c("fixture_colour fixture_max_colour(void)")
maxColour() -> long

@c("fixture_colour fixture_echo_colour(fixture_colour)")
echoColour(x: int) -> int

@c("enum fixture_tag fixture_min_tag(void)")
minTag() -> int

@c("enum fixture_tag fixture_echo_tag(enum fixture_tag)")
echoTag(x: i8) -> i8

@c("fixture_count fixture_min_count(void)")
minCount() -> int

// An Avin integer narrower than the C type is widened; one wider is narrowed where it fits, both ways.
@c("long long fixture_echo_llong(long long)")
echoLlongAsI8(x: i8) -> i8

@c("signed char fixture_echo_schar(signed char)")
echoScharAsLong(x: long) -> long

// Spelled as C allows: keywords in another order, `int` written out, a parameter named.
@c("long unsigned int fixture_echo_ulong(unsigned long int value)")
echoUlongSpelled(x: long) -> long

@c("signed fixture_echo_int(signed int)")
echoSigned(x: int) -> int

@c("short int fixture_echo_short(short int n)")
echoShortInt(x: i16) -> i16

@c("extern long long int fixture_echo_llong(signed long long);")
echoExtern(x: long) -> long

// A binding is a function like any other: overloaded, with a default, and passed as a value.
@c("int fixture_echo_int(int)")
echo(x: int) -> int

@c("long fixture_echo_long(long)")
echo(x: long) -> long

@c("int fixture_echo_int(int)")
echoOr(x: int = 42) -> int

main()
  println(s"schar ${echoSchar(minSchar())} ${echoSchar(maxSchar())} ${widenSchar(-1)} ${widenSchar(minSchar())}")
  println(s"uchar ${echoUchar(0)} ${echoUchar(maxUchar())} ${widenUchar(255)} ${widenUchar(128)}")
  println(s"short ${echoShort(minShort())} ${echoShort(maxShort())} ${widenShort(-1)} ${widenShort(minShort())}")
  println(s"ushort ${echoUshort(0)} ${echoUshort(maxUshort())} ${widenUshort(65535)} ${widenUshort(32768)}")
  println(s"int ${echoInt(minInt())} ${echoInt(maxInt())} ${widenInt(-1)} ${widenInt(minInt())}")
  println(s"uint ${echoUint(0)} ${echoUint(maxUint())} ${widenUint(4294967295)} ${widenUint(2147483648)}")
  println(s"long ${echoLong(minLong())} ${echoLong(maxLong())}")
  println(s"ulong ${minUlong()} ${echoUlong(0)} ${echoUlong(9223372036854775807)}")
  println(s"llong ${echoLlong(minLlong())} ${echoLlong(maxLlong())}")
  println(s"ullong ${echoUllong(0)} ${echoUllong(9223372036854775807)}")
  println(s"int8_t ${echoI8(minI8())} ${widenI8(-128)} ${widenI8(127)}")
  println(s"int16_t ${maxI16()} ${widenI16(-32768)}")
  println(s"int32_t ${minI32()} int64_t ${maxI64()}")
  println(s"uint8_t ${maxU8()} ${widenU8(200)} uint16_t ${maxU16()} ${widenU16(40000)} uint32_t ${maxU32()}")
  println(s"uint64_t ${echoU64(0)} ${echoU64(9223372036854775807)}")
  println(s"size_t ${echoSize(0)} ${echoSize(9223372036854775807)} ssize_t ${minSsize()}")
  println(s"ptrdiff_t ${maxPtrdiff()} intptr_t ${minIntptr()} uintptr_t ${echoUintptr(4096)}")
  println(s"colour ${maxColour()} ${echoColour(2)} tag ${minTag()} ${echoTag(-1)}")
  println(s"count ${minCount()}")
  println(s"narrow ${echoLlongAsI8(-128)} ${echoLlongAsI8(127)} wide ${echoScharAsLong(-128)} ${echoScharAsLong(127)}")
  println(s"spelled ${echoUlongSpelled(7)} ${echoSigned(-7)} ${echoShortInt(-300)} ${echoExtern(-9)}")
  println(s"overloads ${echo(-2147483648)} ${echo(-2147483649)} ${echoOr()} ${echoOr(5)}")
  val f: int -> int = echoInt
  val g = echoLong
  println(s"values ${f(-3)} ${g(9000000000)} ${[1, -2, 3].map(echoInt)}")
