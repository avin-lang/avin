// expect: trap
// A writable view of a frame's bytes is closed by the frame's next use, which may replace them: a
// write after it stops the program at the write, naming the view and its lender.
import avin.c.MutByteView

@c(type: "bf_frame *", release: "bf_frame_unref")
class Frame
    @c("unsigned char *bf_frame_data(bf_frame *self)", view, writable, length: "bf_frame_size(self)")
    pixels() -> MutByteView

    @c("void bf_frame_replace(bf_frame *self, int size, int fill)")
    replace(size: int, fill: int)

    @c("long bf_frame_sum(bf_frame *self)")
    sum() -> long

@c("bf_frame *bf_frame_new(int size, int fill)")
newFrame(size: int, fill: int) -> Frame

main()
    val f = newFrame(8, 0)
    val px = f.pixels()
    px.fill(0, 4, byte(255))
    println(f.sum())
    px.update(4, byte(0))
