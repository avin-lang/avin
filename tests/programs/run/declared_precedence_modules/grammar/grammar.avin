module grammar

// A small grammar library whose alternative `<|>` binds as `|` does, below sequencing with `~`, and
// whose `^^` groups to the right. Its own code reads them so too.

class G(val s: string)
  ~(o: G) -> G = G(s"(${s} ~ ${o.s})")
  @precedence("|")
  <|>(o: G) -> G = G(s"(${s} <|> ${o.s})")
  @groupsRight
  ^^(o: G) -> G = G(s"(${s} ^^ ${o.s})")
  <(o: G) -> G = G(s"(${s} < ${o.s})")

// A trait declaring the operator, and a type implementing it, each with the same declaration.
trait Alt
  @precedence("|")
  <|>(o: G) -> G

data Word(text: string)

impl Alt for Word
  @precedence("|")
  <|>(o: G) -> G = G(s"(${text} <|> ${o.s})")

g(s: string) -> G = G(s)

// Built here, with the library's own reading.
inside() -> G = g("a") ~ g("b") <|> g("c") < g("d")
