// expect: exit 0
// A declaration travels with the method's name across modules: this module imports the grammar
// module and reads `<|>` as `|` and `^^` as grouping right, as the grammar module does itself.

import grammar.{G, Word, g, inside}

show(x: G) = println(x.s)

main()
  show(inside())
  show(g("a") ~ g("b") <|> g("c") < g("d"))
  show(g("a") <|> g("b") ~ g("c"))
  show(g("a") ^^ g("b") ^^ g("c"))
  show(Word("w") <|> g("b") ~ g("c"))
  // A value of the type reached through a function rather than named reads alike.
  show(inside() <|> inside() < g("e"))
