// expect: exit 0
// The streaming reader under the collector running at every allocation: a document fed a byte at a
// time, so every token and character crosses pieces; events, names and values built whole kept
// across reads and in closures; a key with escapes and surrogate pairs; errors met and met again.
import dev.avinlang.json
import dev.avinlang.json.Json
import dev.avinlang.json.JsonEvent
import dev.avinlang.json.JsonReader
import avin.io.IoError
import avin.io.Reader

// A source giving one byte at a time.
class Trickle(private val bytes: Array[byte]): Reader
    private var at = 0

    override read(max: int) -> Result[Array[byte], IoError]
        val piece = bytes.slice(at, if at < bytes.length then at + 1 else at)
        at += piece.length
        Ok(piece)

trickle(text: string, maxDepth: int = json.defaultMaxDepth) -> JsonReader =
    JsonReader.fromReader(Trickle(text.bytes.toArray()), maxDepth)

main()
    val text = "{\"k\\u00e9\\ud83d\\ude00\": [1, -2.5e-3, \"a\\\"b\\\\c\\n日本😀\", true, null, {\"deep\": [[\"x\"]]}], \"n\": 9223372036854775807, \"r\": 1e21}"
    val kept = Buffer[JsonEvent]()
    val r = trickle(text)
    loop
        val e = r.next().ok.get
        kept.addOne(e)
        if e == JsonEvent.EndOfText then break
    println(kept.length, kept(1), kept(5))
    val whole = trickle(text).readDocument().ok.get
    println(whole == json.parse(text).ok.get)
    val values = Buffer[() -> Json]()
    for round in 0..<10
        val v = trickle(text)
        v.beginObject().ok.get
        v.nextKey().ok.get
        val inner = v.readValue().ok.get
        values.addOne(() -> inner)
    println(values(9)().render)
    val deep = "[".repeat(600) + "]".repeat(600)
    println(trickle(deep).readDocument().err.get)
    println(trickle(deep, 600).readDocument().isOk)
    val bad = trickle("[1, \"\\uDE00\"]")
    println(bad.readValue().err.get)
    println(bad.next().err.get)
