// expect: exit 0
// An impl lives in the module of its trait or of its type: `traits` makes `boxes.Box` conform to its
// `Area`, and `boxes` adds a method to its own `Box`. A class and its companion object are in one
// module, here in two of its files, and each uses the other's private members.
import boxes.Box
import traits.Area
import accounts.Account

main()
    val shape: Area = Box(2, 3)
    print(s"${shape.area()}")
    print(s"${Box(4, 5).perimeter()}")
    val a = Account.open("ann")
    val b = Account.open("bob")
    print(s"${a.owner} ${Account.number(a)}, ${b.owner} ${Account.number(b)}")
