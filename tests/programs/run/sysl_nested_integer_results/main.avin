// An integer an option, a result or a collection holds takes any Sysl integer, unsigned or of
// another width, converted with a check into the integer type the binding declares, as a binding's
// integer result does.

@sysl("avintest.digits.maybe_count")
maybeCount(n: long) -> Option[long]

@sysl("avintest.digits.maybe_count")
maybeCountSmall(n: long) -> Option[i8]

@sysl("avintest.digits.counted")
counted(n: long) -> Result[int, string]

@sysl("avintest.digits.coded")
coded(text: string, code: long) -> Result[string, int]

// A Sysl slice of `u8` is a vector or an array of any integer type that holds its values.
@sysl("avintest.digits.digits_of")
digitsOf(n: long) -> Vector[int]

@sysl("avintest.digits.digits_of")
digitArray(n: long) -> Array[i16]

// A `Buf` converts as a slice does.
@sysl("avintest.digits.digit_buf")
digitBuf(n: long) -> Vector[int]

@sysl("avintest.digits.digit_rows")
digitRows(a: long, b: long) -> Vector[Vector[long]]

@sysl("avintest.digits.powers")
powers(count: int) -> Vector[long]

// A wider Sysl integer narrows into a narrower Avin one when its values fit.
@sysl("avintest.digits.powers")
smallPowers(count: int) -> Array[int]

@sysl("avintest.digits.maybe_digits")
maybeDigits(n: long) -> Option[Vector[byte]]

@sysl("avintest.digits.maybe_digits")
maybeDigitInts(n: long) -> Option[Array[int]]

// A mirror's field holding an integer in an option or a collection converts the same way.
@sysl("avintest.digits.Spread")
data Spread(count: long, firstNonzero: Option[long], digits: Vector[int])

@sysl("avintest.digits.spread_of")
spreadOf(n: long) -> Spread

// An integer a parameter holds is passed as the type it is declared, which is the Sysl parameter's.
@sysl("avintest.digits.count_or_zero")
countOrZero(n: Option[long]) -> int

main()
    println(s"${countOrZero(Some(long(123456)))} ${countOrZero(None)}")
    val s = spreadOf(1020)
    println(s"${s.count} ${s.firstNonzero} ${s.digits}")
    val z = spreadOf(0)
    println(s"${z.count} ${z.firstNonzero} ${z.digits}")
    println(s"${maybeCount(12345)} ${maybeCount(0)} ${maybeCountSmall(-7)}")
    println(s"${counted(999)} ${counted(-1)}")
    println(s"${coded("ok", 3)} ${coded("", -40000)}")
    println(digitsOf(90210))
    val a = digitArray(-305)
    println(s"${a.length()} ${a(0)} ${a(1)} ${a(2)}")
    println(digitBuf(1234))
    println(digitRows(12, 3400))
    println(powers(12))
    val p = smallPowers(10)
    println(s"${p.length()} ${p(9)}")
    println(s"${maybeDigits(507)} ${maybeDigits(0)}")
    maybeDigitInts(42) match
        Some(ds) -> println(s"${ds(0) + ds(1)}")
        None -> println("none")
    // Converted values are ordinary Avin values: they compute and compare as any others do.
    println(digitsOf(123).foldLeft(0, (x, y) -> x + y))
    println(maybeCount(1000000) == Some(long(7)))
