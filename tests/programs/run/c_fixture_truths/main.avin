// expect: exit 0
// An integer used as a truth value crosses as `bool`, as Cairo's `cairo_bool_t`, an `int`, does: a
// result is false for zero and true for every other value, at the C type's full width, and a
// parameter passes 0 or 1, extended as the C type's sign says. A typedef crossing as `bool` may be
// an integer or a C `bool`, which the C unit checks.

@c("int fixture_echo_int(int)")
echoTruth(b: bool) -> bool
@c("int fixture_echo_int(int)")
truthArg(b: bool) -> int
@c("int fixture_echo_int(int)")
truthOf(x: int) -> bool
@c("fixture_truth fixture_truth_of(int)")
typedefTruth(x: int) -> bool
@c("int fixture_truth_value(fixture_truth)")
typedefValue(b: bool) -> int
@c("fixture_truth fixture_truth_of(int)")
typedefEcho(b: bool) -> bool
@c("unsigned char fixture_echo_uchar(unsigned char)")
ucharTruth(x: int) -> bool
@c("long long fixture_widen_uchar(unsigned char)")
widenUchar(b: bool) -> long
@c("long long fixture_widen_schar(signed char)")
widenSchar(b: bool) -> long
@c("signed char fixture_echo_schar(signed char)")
scharTruth(x: int) -> bool
@c("long long fixture_echo_llong(long long)")
llongTruth(x: long) -> bool
@c("unsigned long long fixture_echo_ullong(unsigned long long)")
ullongTruth(x: long) -> bool
@c("uint16_t fixture_echo_u16(uint16_t)")
u16Truth(b: bool) -> bool
@c("fixture_flag fixture_echo_flag(fixture_flag)")
flag(b: bool) -> bool

main()
    println(s"echo ${echoTruth(true)} ${echoTruth(false)} ${truthArg(true)} ${truthArg(false)}")
    println(s"int ${truthOf(0)} ${truthOf(1)} ${truthOf(-1)} ${truthOf(2)} ${truthOf(-2147483648)} ${truthOf(2147483647)}")
    println(s"typedef ${typedefTruth(0)} ${typedefTruth(1)} ${typedefTruth(-1)} ${typedefTruth(2)} ${typedefValue(true)} ${typedefValue(false)} ${typedefEcho(true)} ${typedefEcho(false)}")
    println(s"uchar ${ucharTruth(0)} ${ucharTruth(1)} ${ucharTruth(255)} ${widenUchar(true)} ${widenUchar(false)} ${widenSchar(true)}")
    println(s"schar ${scharTruth(-1)} ${scharTruth(-128)} ${scharTruth(0)}")
    // Only bits above the lowest 32 set is still true: the whole width is compared.
    println(s"llong ${llongTruth(4294967296)} ${llongTruth(-9223372036854775807 - 1)} ${llongTruth(0)} ${ullongTruth(4294967296)}")
    println(s"u16 ${u16Truth(true)} ${u16Truth(false)} ${flag(true)} ${flag(false)}")
