module describe

trait Describe
  describe() -> string

impl Describe for int
  describe() -> string = s"$self"

derive Describe for T
  describe() -> string = T.walk(self, Writer("")).text

data Writer(text: string)

impl ShapeVisitor for Writer
  variant(v: VariantShape) -> Writer = Writer(v.name)
  finish(v: VariantShape) -> Writer = Writer(text + "!")

impl Writer
  field[F: Describe](f: FieldShape, value: F) -> Writer = Writer(s"$text ${f.name}=${value.describe()}")
