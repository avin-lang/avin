// expect: exit 0
// A `derives` entry finds the template in a module its file imports from; the template's names,
// its visitor among them, resolve in the trait's module. The visitor's own `finish` replaces the default.
import describe.Describe

data Point(x: int, y: int) derives Describe

data Pair[A](a: A, b: A) derives Describe

main()
    println(Point(1, 2).describe())
    println(Pair(Point(1, 2), Point(3, 4)).describe())
