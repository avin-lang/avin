module counts

import ui.{Signal, signal, echo, Spot}

// Another module instantiates the same bindings at types of its own and at the ones `main` uses.
counter(start: long) -> Signal[long] = signal(start)

bumped(s: Signal[long]) -> long
    s.set(s.read() + 1)
    s.read()

spots(n: int) -> Signal[Option[Spot]] = signal(if n > 0 then Some(Spot(n, echo(n))) else None)

texts(t: string) -> Signal[string] = signal(t)
