module ui

// A module's generic bindings and generic handle, private bindings behind a public generic API.

@sysl("avintest.views.Signal")
class Signal[T: Boundary]
    read() -> T
    set(v: T)

@sysl("avintest.views.signal")
private rawSignal[T: Boundary](v: T) -> Signal[T]

@sysl("avintest.digits.same")
private rawSame[T: Boundary](x: T) -> T

@sysl("avintest.digits.Spot")
data Spot(x: int, y: int)

signal[T: Boundary](v: T) -> Signal[T] = rawSignal(rawSame(v))

echo[T: Boundary](x: T) -> T = rawSame(x)
