// expect: exit 0
// Generic bindings declared in one module are instantiated in others, the same instance in two
// modules sharing one shim and one handle class, and each module's own instances made too.
import ui.{Signal, signal, echo, Spot}
import counts.{counter, bumped, spots, texts}

main()
    val c = counter(41)
    println(bumped(c), c.read())
    println(spots(3).read(), spots(0).read())
    // `Signal[string]` is made here and in `counts`: one class, set on either side.
    val a = signal("main")
    val b = texts("counts")
    a.set(b.read() + "+" + a.read())
    println(a.read())
    println(echo(Spot(1, 2)), echo((byte(1), 'q')), echo("ünïcode"))
    val held: Signal[(int, string)] = signal((1, "one"))
    println(held.read())
