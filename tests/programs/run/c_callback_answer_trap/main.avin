// expect: trap
// A callback's answer crosses into C as a binding's argument does: one the C type cannot hold stops
// the program where the binding C was running was called, naming the C type and the function.

@c("int8_t cb_i8(int8_t (*f)(userdata void *ud, int8_t x), userdata void *ud, int8_t x)")
i8(f: int -> int, x: int) -> int

main()
    println(i8(x -> x + 1, 126))
    println(i8(x -> x - 1, -127))
    println(i8(x -> x + 1, 127))
