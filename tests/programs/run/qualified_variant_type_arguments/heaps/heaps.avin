module heaps

data Heap[T]
  Leaf
  Node(value: T, left: Heap[T], right: Heap[T])

data Tree[T]
  Leaf
  Branch(left: Tree[T], right: Tree[T])

size[T](h: Heap[T]) -> int = h match
  Heap.Leaf -> 0
  Heap.Node(_, l, r) -> 1 + size(l) + size(r)

depth[T](t: Tree[T]) -> int = t match
  Tree.Leaf -> 1
  Tree.Branch(l, r) -> 1 + max(depth(l), depth(r))
