// expect: exit 0
// Another module's generic variant takes its type arguments on the type, `heaps.Heap[int].Leaf`, or
// on the variant, `heaps.Heap.Leaf[int]`, as in its own module, with fields or without; the type
// written before a variant name the module's types share decides which variant it is, and an
// imported type is written by its own name.
import heaps
import heaps.Tree

main()
  val a = heaps.Heap.Leaf[int]
  println(a == heaps.Heap[int].Leaf)
  val n = heaps.Heap.Node[long](1, heaps.Heap.Leaf[long], heaps.Heap[long].Leaf)
  println(n)
  println(heaps.size(n))
  val t = Tree.Branch[string](Tree.Leaf[string], heaps.Tree.Leaf[string])
  println(heaps.depth(t))
  println(heaps.depth(heaps.Tree[int].Leaf))
  n match
    heaps.Heap.Node(v, _, _) -> println(v)
    heaps.Heap.Leaf -> println("empty")
