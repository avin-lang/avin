// expect: exit 0
// A surface answered in a `Result` under collections at every allocation: one C was told of keeps
// its block through a holder after its handle is collected, and one in error is `Err` of its status,
// given back at once, its block kept by nothing.
import avin.c.ByteBlock

@c(enum: "bf_status", prefix: "BF_")
data Status
  Success
  NoMemory
  InvalidStride

@c(
    type: "bf_surface *",
    release: "bf_surface_unref",
    attach: "bf_surface_set_user_data_checked(self, key, data, destroy)",
    key: "bf_user_data_key_t"
)
class Surface

@c("bf_surface *bf_surface_new_checked(unsigned char *pixels, length(pixels) int n, int stride)", keeps: "pixels")
surfaceOver(pixels: ByteBlock, stride: int) -> Result[Surface, Status]

@c(type: "bf_holder *", release: "bf_holder_free")
class Holder
  @c("long bf_holder_sum(bf_holder *self)")
  sum() -> long

@c("bf_holder *bf_holder_new(bf_surface *s)")
holderOf(s: Surface) -> Holder

@c("int bf_surfaces_alive(void)")
surfacesAlive() -> int

holderOverBlock(n: int) -> Holder
  val b = ByteBlock(n)
  b.fill(0, n, byte(2))
  surfaceOver(b, 4) match
    Ok(s) -> holderOf(s)
    Err(e) -> fail(s"error $e")

main()
  val h = holderOverBlock(32)
  var errors = 0
  for i in 0 ..< 100
    val junk = [i, i, i]
    if surfaceOver(ByteBlock(junk(0) % 7 + 1), 0) is Err(InvalidStride) then errors += 1
  println(h.sum())
  println(errors)
  println(surfacesAlive())
  h.close()
  println(surfacesAlive())
