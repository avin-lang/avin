// expect: trap
// An integer parameter the Sysl parameter's type cannot hold stops the program where the binding
// was called, naming the Sysl type by its sign and width: a negative `int` for a `u32`.

@sysl("avintest.digits.show_u32")
showU32(x: int) -> string

main()
  println(showU32(0))
  val n = -1
  println(showU32(n))
