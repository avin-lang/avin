module shapes

import geometry.Point

class Circle(val r: int)
  center() -> Point = Point(r, 0)

class Square(val side: int)

area(c: Circle) -> int = 3 * c.r * c.r
area(s: Square) -> int = s.side * s.side

// `secret` is declared private in another file of this module, which sees it.
helper() -> string = s"shapes helper ${secret()}"

val base = trace("shapes.base", 10)
