// expect: exit 0
// A program of four modules: this directory's files are the root module, and `shapes`, `geometry`
// and `geometry.counter` are its directories. `shapes` and `geometry` import each other. Each file
// imports the names it uses, and `as` renames one: both `shapes` and `geometry` declare `helper`.
import shapes.{Circle, Square, area as shapeArea, helper as shapesHelper}
import geometry.{describe, total, helper}
import geometry.counter.tally

main()
    println(describe(Circle(2)))
    println(s"${shapeArea(Square(3))}")
    println(s"${total()}")
    println(helper())
    println(shapesHelper())
    println(s"${tally}")
    println(s"${Circle(5).center().x}")
