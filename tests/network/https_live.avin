// expect: exit 0
// HTTPS against a real site, trusting only the machine's own certificate store. It needs the
// network, so it is not part of the gate's corpus; run it by hand from the repository root:
//
//     avin run tests/network/https_live.avin
//
// It fetches https://example.com/ and checks the answer, then asks for the same site under a name its
// certificate does not cover, and for a host whose certificate has expired, each refused.
import avin.net.http
import avin.net.http.{HttpError, Tls}
import avin.net.tls.Certificate

main()
  http.get("https://example.com/") match
    Ok(r) -> println(s"example.com: ${r.status}, mentions its domain: ${r.text().contains("Example Domain")}")
    Err(e) -> fail(s"example.com: ${e.message}")
  for url in ["https://wrong.host.badssl.com/", "https://expired.badssl.com/", "https://self-signed.badssl.com/"]
    http.get(url) match
      Err(Tls(Certificate(_, why))) -> println(s"$url: certificate refused, ${why.message}")
      Err(e) -> println(s"$url: ${e.message}")
      Ok(r) -> fail(s"$url answered ${r.status}")
