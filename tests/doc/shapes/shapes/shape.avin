// Plane shapes and what can be measured of them.
//
// Every shape is a [Shape]; [area] measures one, and [`geometry.Point`] places one.
module shapes

import shapes.geometry.Point
import units.Metres

export shapes.geometry.Point

// A shape in the plane.
//
// ```
// val s = Circle(1.0)
// println(area(s))
// ```
data Shape
  // A circle of the given radius.
  Circle(radius: real)
  // A rectangle, `width` across and `height` high.
  Rect(width: real, height: real)

// A labelled value, with its label first.
data Labelled[+T](label: string, value: T)

// A name for a list of shapes, so a drawing reads as one.
type Drawing = Vector[Shape]

// A side of a polygon, kept apart from other reals by its type.
opaque type Side = real

// The area of `s`; see [Shape.Circle] for what a circle holds.
area(s: Shape) -> real = s match
  Circle(r) -> 3.14159 * r * r
  Rect(w, h) -> w * h

// The total area of a drawing.
area(d: Drawing) -> real = d.map(s -> area(s)).sum

// The larger of two values, by the ordering `T` has.
larger[T: Ord](a: T, b: T) -> T = if a > b then a else b

// How far `p` is from the origin, in [Metres].
reach(p: Point) -> Metres = Metres(p.x)

// The unit square.
val unitSquare: Shape = Rect(1.0, 1.0)

// How many shapes have been drawn.
var drawn: int = 0

// Never documented: private.
private secret() -> int = 7

// A thing with a name.
trait Named
  // The thing's name.
  name -> string

  // The name, shouted.
  shout -> string = name + "!"

// A canvas that shapes are drawn on, `width` across.
class Canvas(val width: int, private var used: int): Named
  // The shapes drawn so far.
  var shapes: Vector[Shape] = Vector.empty[Shape]()

  // Draws `s` on the canvas.
  draw(s: Shape)
    shapes = shapes :+ s
    used += 1

  private scratch() -> int = used

  override name -> string = "canvas"

// The palette every drawing uses.
object Palette
  // The colour drawn when none is named.
  val ink: string = "black"

impl Shape
  // Whether the shape covers no area.
  isEmpty -> bool = area(self) == 0.0

impl Named for Shape
  name -> string = self match
    Circle(_) -> "circle"
    Rect(_, _) -> "rect"
