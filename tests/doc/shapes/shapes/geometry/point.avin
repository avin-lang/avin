// Points of the plane.
module shapes.geometry

import shapes.Named

// A point, `x` across and `y` up.
data Point
  // Where it is.
  Point(x: real, y: real)

// Points are named by where they are; see [Named.name].
impl Named for Point
  name -> string = "(" + x.toString() + ", " + y.toString() + ")"

// A module nobody imports: its point is the origin, an [`Option`] of none.
origin() -> Option[Point] = Some(Point(0.0, 0.0))
