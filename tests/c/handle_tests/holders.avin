// A handle whose `release:` uses what it keeps or holds: a `kept:` handle with no C reference, kept
// as its Avin object and passed to the release as its pointer, null once it was closed; a C integer
// `holds:` declares, set by a binding's `hold:`; and the strings C answers through `out` pointers
// that `free:` frees, by the receiver's `kept:` name, `self` or a function of the string. Each test
// runs in a process of its own, so the fixture's counts start at zero, and the fixture stops the
// process on a node freed twice or after its parent, or a string freed twice or with another root.
import fixture.{
  closeDescriptor, connWith, conns, drain, dup, farewellsFailed, farewellsWritten, maybeConnWith, newConn, newRoot,
  newStream, nodes, nodesFreedByParent, nodesFreedOwn, pipe, texts, textsOf
}

@test("a node kept with no C reference is freed by its own release while its parent is open")
keptClosedFirst()
  val root = newRoot()
  val b = root.branch()
  assertEq(b.depth(), 1)
  b.close()
  assertEq(nodesFreedOwn(), 1)
  root.close()
  assertEq(nodesFreedOwn(), 2)
  assertEq(nodesFreedByParent(), 0)
  assertEq(nodes().freed, 2)

@test("a release is passed null for a kept handle closed first, and does no harm")
parentClosedFirst()
  val root = newRoot()
  val b = root.branch()
  root.close()
  // The root's free freed the branch's node with it.
  assertEq(nodesFreedByParent(), 1)
  b.close()
  assertEq(nodes().freed, 2)
  assertEq(nodesFreedOwn(), 1)
  // Closing again does nothing.
  b.close()
  root.close()
  assertEq(nodes().freed, 2)

@test("a chain of three: each release is passed what it keeps, the middle closed first")
chainOfThree()
  val root = newRoot()
  val b = root.branch()
  val leaf = b.leaf()
  assertEq(leaf.depth(), 2)
  b.close()
  assertEq(nodesFreedOwn(), 1)
  assertEq(nodesFreedByParent(), 1)
  leaf.close()
  root.close()
  assertEq(nodes().freed, 3)
  assertEq(nodesFreedOwn(), 2)

@test("several branches of one root, each kept from the collector by its own pin")
branchesOfOneRoot()
  val root = newRoot()
  val bs = [root.branch(), root.branch(), root.branch()]
  for b in bs
    assertEq(b.depth(), 1)
  bs(1).close()
  root.close()
  for b in bs
    b.close()
  assertEq(nodes().freed, 4)
  assertEq(nodesFreedOwn(), 2)
  assertEq(nodesFreedByParent(), 2)

@test("strings C answers through out pointers are freed once copied, through the kept root and `self`")
outStringsFreed()
  val root = newRoot()
  val b = root.branch()
  assertEq(b.texts(0), Ok((Some("node ñ"), 7, Some("other"))))
  assertEq(texts().created, 2)
  assertEq(texts().freed, 2)
  // Null is `None`, and is not freed.
  assertEq(b.texts(1), Ok((None, 0, Some("other"))))
  assertEq(texts().created, 3)
  assertEq(texts().freed, 3)
  b.close()
  root.close()

@test("strings C answered before a failed status are freed unread, and none answered frees nothing")
outStringsFailed()
  val root = newRoot()
  val b = root.branch()
  assertEq(b.texts(2), Err(7))
  assertEq(texts().created, 2)
  assertEq(texts().freed, 2)
  assertEq(b.texts(3), Err(7))
  assertEq(texts().created, 2)
  assertEq(texts().freed, 2)
  b.close()
  root.close()

@test("strings beside a result are freed whatever it is, as bytes and by a function of the string")
outStringsAnswered()
  val root = newRoot()
  val b = root.branch()
  val (status, name, length, other) = b.textsAnswered(2)
  assertEq(status, 7)
  assertEq(name.map(a -> a.length), Some(7))
  assertEq(length, 7)
  assertEq(other, Some("other"))
  assertEq(texts().freed, 2)
  val (_, none, _, _) = b.textsAnswered(1)
  assertEq(none.isDefined, false)
  assertEq(texts().created, 3)
  assertEq(texts().freed, 3)
  b.close()
  root.close()

@test("a binding that is no method frees its out strings by a function of the string, or an expression in it")
outStringsTopLevel()
  val root = newRoot()
  val b = root.branch()
  assertEq(textsOf(b, 0), Ok((Some("node ñ"), 7, Some("other"))))
  assertEq(textsOf(b, 2), Err(7))
  assertEq(texts().created, 4)
  assertEq(texts().freed, 4)
  b.close()
  root.close()

@test("a held descriptor is given to the release, which writes to it and closes it")
heldDescriptor()
  val (r, w) = pipe()
  val c = newConn()
  assertEq(c.start(dup(w)), Ok(()))
  closeDescriptor(w)
  c.close()
  assertEq(drain(r), "bye")
  assertEq(farewellsWritten(), 1)
  assertEq(conns().freed, 1)

@test("a handle holding nothing yet is given the value `holds:` starts as, and a failed call holds nothing")
heldNothing()
  val c = newConn()
  assertEq(c.start(-5), Err(1))
  c.close()
  assertEq(farewellsFailed(), 1)
  assertEq(farewellsWritten(), 0)

@test("a value held again replaces the one held before")
heldReplaced()
  val (r1, w1) = pipe()
  val (r2, w2) = pipe()
  val first = dup(w1)
  val c = newConn()
  assertEq(c.start(first), Ok(()))
  assertEq(c.start(dup(w2)), Ok(()))
  closeDescriptor(w1)
  closeDescriptor(w2)
  c.close()
  closeDescriptor(first)
  assertEq(drain(r1), "")
  assertEq(drain(r2), "bye")

@test("a binding answering a handle holds what it names in the handle it makes, in an Option too")
heldByMade()
  val (r, w) = pipe()
  val c = connWith(dup(w))
  val m = maybeConnWith(dup(w))
  assertEq(maybeConnWith(-1).isDefined, false)
  closeDescriptor(w)
  c.close()
  assertEq(m.isDefined, true)
  m match
    Some(x) -> x.close()
    None -> ()
  assertEq(drain(r), "byebye")
  assertEq(farewellsWritten(), 2)

@test("a stream closed before the connection holding its own copy of the descriptor does no harm")
streamClosedFirst()
  val (r, w) = pipe()
  val s = newStream(w)
  val c = newConn()
  assertEq(c.start(dup(s.descriptor())), Ok(()))
  s.close()
  c.close()
  assertEq(drain(r), "bye")
  assertEq(farewellsWritten(), 1)
