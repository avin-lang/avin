// Every rule of a C handle, held against the fixture's counts of what was made, retained, released
// and freed, each test in a process of its own so the counts start at zero: `close()` gives the
// reference back once, a closed handle stops the program at its next use, a borrowed result takes a
// reference of its own, `keeps:` and `consumes:` hold and take what they name, a class's `kept:` name
// reaches the pointer it keeps, statuses answer `Ok` for zero, and a handle belongs to the thread
// that made it unless its class is `shared`.
import avin.threads.{Channel, spawn}
import fixture.{Counts, Face, Library, MMVar, Object, Plain, SharedObject, Shelf, byteStatus, checkOf, faceOver, faces, lend, libraries, longStatus, maybeObject, mmVar, mmVars, mustObject, narrowStatus, newFace, newLibrary, newObject, newPlain, newShared, newShelf, objects, plains, resultOf, shelves, status, valueOf}
import shapes.{Shape, newShape}

// The counts, written as one line.
line(c: Counts) -> string = s"${c.created} ${c.retained} ${c.released} ${c.freed}"

@test("a handle's bound methods reach its C object, and a method with a body calls them")
methods()
    val o = newObject(5)
    assertEq(o.value(), 5)
    o.set(-7)
    assertEq(valueOf(o), -7)
    assertEq(o.describe(), "object -7 with 1 references")
    o.set(2147483647)
    assertEq(o.value(), 2147483647)

@test("close() gives the reference back once, and closing again does nothing")
closeOnce()
    val o = newObject(1)
    o.close()
    assertEq(line(objects()), "1 0 1 1")
    o.close()
    o.close()
    assertEq(line(objects()), "1 0 1 1")

@test(should_trap: "`Object` is closed")
closedMethod()
    val o = newObject(1)
    o.close()
    o.value()

@test(should_trap: "`Object` is closed")
closedParameter()
    val o = newObject(1)
    o.close()
    valueOf(o)

@test(should_trap: "`Object` is closed")
closedReceiverOfStatus()
    val o = newObject(1)
    o.close()
    _ = o.check(1)

@test("a handle compares by identity: two handles on one C object are two values")
identity()
    val o = newObject(3)
    val same = o
    assert(o == same)
    val other = o.lend()
    assert(!(o == other))
    assertEq(other.value(), 3)

@test("a borrowed result takes a reference of its own, which its close() gives back, and the object goes with the last")
borrowed()
    val o = newObject(4)
    val b = lend(o)
    assertEq(o.refs(), 2)
    assertEq(line(objects()), "1 1 0 0")
    val c = o.lend()
    assertEq(o.refs(), 3)
    o.close()
    assertEq(b.value(), 4)
    b.close()
    assertEq(c.refs(), 1)
    c.close()
    assertEq(line(objects()), "1 2 3 1")

@test("an owned result is the handle's reference: nothing is retained")
owned()
    val o = newObject(1)
    assertEq(o.refs(), 1)
    assertEq(line(objects()), "1 0 0 0")

@test("null answered is None for an Option, and any other pointer Some")
nullAsNone()
    assert(maybeObject(0) is None)
    maybeObject(8) match
        Some(o) -> assertEq(o.value(), 8)
        None -> assert(false)
    assertEq(line(objects()), "1 0 0 0")

@test(should_trap: "`fx_object_none` answered null")
nullTraps()
    mustObject(0)

@test("a status is Ok for zero and Err of the code otherwise, at every width and sign")
statuses()
    assertEq(status(0), Ok(()))
    assertEq(status(-5), Err(-5))
    assertEq(status(2147483647), Err(2147483647))
    assertEq(status(-2147483648), Err(-2147483648))
    assertEq(resultOf(0), Ok(()))
    assertEq(resultOf(1), Err(3))
    assertEq(resultOf(2), Err(-2))
    assertEq(longStatus(0), Ok(()))
    val most: long = 9223372036854775807
    val least: long = -9223372036854775807 - 1
    assertEq(longStatus(most), Err(most))
    assertEq(longStatus(least), Err(least))
    assertEq(narrowStatus(-2147483648), Err(-2147483648))
    assertEq(byteStatus(0), Ok(()))
    assertEq(byteStatus(255), Err(255))
    val o = newObject(6)
    assertEq(o.check(6), Ok(()))
    assertEq(o.check(10), Err(-4))
    assertEq(checkOf(o, 1), Err(5))

@test(should_trap: "value out of range for int")
statusTooWide()
    _ = narrowStatus(2147483648)

@test(should_trap: "value out of range for u8 (unsigned char)")
statusArgumentTooWide()
    _ = byteStatus(256)

@test("a face keeps its library by a reference of its own: the library outlives its handle's close() until the face goes")
keepsByReference()
    val lib = newLibrary()
    val face = newFace(lib, 3)
    assertEq(line(libraries()), "1 1 0 0")
    lib.close()
    assertEq(line(libraries()), "1 1 1 0")
    assertEq(face.id(), 3)
    face.close()
    assertEq(line(faces()), "1 0 1 1")
    assertEq(line(libraries()), "1 1 2 1")

@test("a method keeping `self` makes the handle it answers keep its receiver")
keepsSelf()
    val lib = newLibrary()
    val face = lib.face(9)
    assertEq(lib.faces(), 1)
    lib.close()
    assertEq(face.id(), 9)
    assertEq(face.library().faces(), 1)
    face.close()
    assertEq(libraries().freed, 0)

@test("`keeps:` naming a list keeps each, and None keeps nothing")
keepsList()
    val lib = newLibrary()
    val memory = newObject(12)
    val face = faceOver(lib, Some(memory), 1).get
    assertEq(line(objects()), "1 1 0 0")
    memory.close()
    lib.close()
    assertEq(face.memoryValue(), 12)
    face.close()
    assertEq(line(objects()), "1 1 2 1")
    assertEq(libraries().freed, 1)
    val bare = faceOver(newLibrary(), None, 2).get
    assertEq(bare.memoryValue(), -1)
    assertEq(objects().retained, 1)

@test("a class's `kept:` name is the pointer of the handle it keeps, still valid in its release")
keptName()
    val lib = newLibrary()
    val face = newFace(lib, 4)
    val mm = mmVar(face)
    lib.close()
    face.close()
    assertEq(mm.axes(), 8)
    assertEq(faces().freed, 0)
    mm.close()
    assertEq(line(mmVars()), "1 0 0 1")
    assertEq(faces().freed, 1)
    assertEq(libraries().freed, 1)

@test("`consumes:` closes the handle passed without its release: C frees the object once, when it is done")
consumes()
    val lib = newLibrary()
    val o = newObject(5)
    lib.adopt(o)
    assertEq(line(objects()), "1 0 0 0")
    o.close()
    assertEq(line(objects()), "1 0 0 0")
    lib.adopted() match
        Some(a) ->
            assertEq(a.value(), 5)
            a.close()
        None -> assert(false)
    lib.close()
    assertEq(line(objects()), "1 1 2 1")

@test(should_trap: "`Object` is closed")
consumedUnusable()
    val lib = newLibrary()
    val o = newObject(5)
    lib.adopt(o)
    o.value()

@test(should_trap: "`Object` is closed")
consumedTwice()
    val lib = newLibrary()
    val o = newObject(5)
    lib.adopt(o)
    lib.adopt(o)

@test("a borrowed Option answers None for null, and takes nothing")
borrowedNone()
    val lib = newLibrary()
    assert(lib.adopted() is None)
    assertEq(objects().retained, 0)

@test("a handle with no `retain` is kept as the Avin object, and given back by its own release")
keepsObject()
    val p = newPlain(6)
    val shelf = newShelf(p)
    assertEq(shelf.peek(), 6)
    shelf.close()
    assertEq(line(shelves()), "1 0 0 1")
    assertEq(plains().freed, 0)
    p.close()
    assertEq(plains().freed, 1)

@test("a handle in a data value and in a Vector is used and closed through them")
inValues()
    val pair = (newObject(1), newObject(2))
    val (first, second) = pair
    assertEq(first.value() + second.value(), 3)
    val all = [newObject(3), newObject(4), newObject(5)]
    var sum = 0
    for o in all
        sum += o.value()
        o.close()
    assertEq(sum, 12)
    assertEq(objects().freed, 3)
    val maybe = Some(newObject(7))
    assertEq(maybe.map(o -> o.value()), Some(7))

@test("another package's handle class crosses its bindings: kept, borrowed, answered, taken and checked")
crossPackage()
    val o = newObject(11)
    val shape = newShape(o)
    o.close()
    assertEq(shape.value(), 11)
    val back = shape.object()
    assertEq(back.value(), 11)
    val copy = shape.copy()
    assertEq(shape.matches(copy), Ok(()))
    copy.set(1)
    assertEq(shape.matches(copy), Err(1))
    shape.absorb(copy)
    shape.close()
    back.close()
    assertEq(objects().created, objects().freed)

@test(should_trap: "`Object` is closed")
crossPackageConsumed()
    val shape = newShape(newObject(1))
    val o = newObject(2)
    shape.absorb(o)
    o.value()

@test(should_trap: "`Object` belongs to another thread")
otherThread()
    val made = Channel[Object]()
    val done = Channel[unit]()
    spawn(() ->
        made.send(newObject(2))
        done.receive())
    made.receive().get.value()

@test(should_trap: "`Object` belongs to another thread")
otherThreadParameter()
    val made = Channel[Object]()
    val done = Channel[unit]()
    spawn(() ->
        made.send(newObject(2))
        done.receive())
    valueOf(made.receive().get)

@test(should_trap: "`Object` belongs to another thread")
otherThreadClose()
    val made = Channel[Object]()
    val done = Channel[unit]()
    spawn(() ->
        made.send(newObject(2))
        done.receive())
    made.receive().get.close()

@test("a `shared` handle is used from any thread")
sharedHandle()
    val made = Channel[SharedObject]()
    val done = Channel[unit]()
    spawn(() ->
        made.send(newShared(2))
        done.receive())
    val s = made.receive().get
    assertEq(s.value(), 2)
    s.close()
    done.send(())
    assertEq(objects().freed, 1)

@test("a handle a thread's body captures is the body's, and back with its caller once the body is done")
handedToThread()
    val o = newObject(3)
    val got = spawn(() -> o.value()).join()
    assertEq(got, 3)
    assertEq(o.value(), 3)
