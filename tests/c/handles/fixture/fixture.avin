module fixture

// Handles on the counted C objects of tests/c/avin_handles.h: every shape of handle class, binding
// and ownership the C bindings have, with the fixture's counts of what was made, retained, released
// and freed, which the tests compare.

// A counted object, given back through `fx_object_unref` and retained through `fx_object_ref`.
@c(type: "fx_object *", release: "fx_object_unref", retain: "fx_object_ref")
class Object
  @c("int fx_object_value(const fx_object *self)")
  value() -> int

  @c("void fx_object_set(fx_object *self, int value)")
  set(value: int)

  @c("int fx_object_refs(const fx_object *self)")
  refs() -> int

  @c("int fx_object_check(fx_object *self, int want)")
  check(want: int) -> Result[unit, int]

  // The object itself, lent by C, so the handle made takes a reference of its own.
  @c("fx_object *fx_object_lend(fx_object *self)", borrowed)
  lend() -> Object

  // A method with a body, calling the bound ones.
  describe() -> string = s"object ${value()} with ${refs()} references"

@c("fx_object *fx_object_new(int value)")
newObject(value: int) -> Object

// Null for zero.
@c("fx_object *fx_object_none(int value)")
maybeObject(value: int) -> Option[Object]

@c("fx_object *fx_object_none(int value)")
mustObject(value: int) -> Object

@c("fx_object *fx_object_lend(fx_object *o)", borrowed)
lend(o: Object) -> Object

@c("int fx_object_value(const fx_object *o)")
valueOf(o: Object) -> int

// A status of a top-level binding taking a handle.
@c("int fx_object_check(fx_object *o, int want)")
checkOf(o: Object, want: int) -> Result[unit, int]

// The same C object, as a handle any thread may use: its count is atomic.
@c(type: "fx_object *", release: "fx_object_unref", retain: "fx_object_ref", shared)
class SharedObject
  @c("int fx_object_value(const fx_object *self)")
  value() -> int

@c("fx_object *fx_object_new(int value)")
newShared(value: int) -> SharedObject

// A library owning its faces, which frees every face still in it when its last reference goes.
@c(type: "fx_library", release: "fx_library_done", retain: "fx_library_reference")
class Library
  @c("int fx_library_faces(fx_library self)")
  faces() -> int

  // The library takes the reference it is passed.
  @c("void fx_library_adopt(fx_library self, fx_object *o)", consumes: "o")
  adopt(o: Object)

  @c("fx_object *fx_library_adopted(fx_library self)", borrowed)
  adopted() -> Option[Object]

  // A face made by a method keeps the method's receiver.
  @c("fx_face fx_face_new(fx_library self, int id)", keeps: "self")
  face(id: int) -> Face

@c("fx_library fx_library_new(void)")
newLibrary() -> Library

@c(type: "fx_face", release: "fx_face_done", retain: "fx_face_reference")
class Face
  @c("int fx_face_id(fx_face self)")
  id() -> int

  @c("int fx_face_memory_value(fx_face self)")
  memoryValue() -> int

  // The face's library, lent: a handle of its own, made after the face's.
  @c("fx_library fx_face_library(fx_face self)", borrowed)
  library() -> Library

@c("fx_face fx_face_new(fx_library library, int id)", keeps: "library")
newFace(library: Library, id: int) -> Face

// A face kept by both its library and the object it is made over; `None` for no memory.
@c("fx_face fx_face_new_over(fx_library library, fx_object *memory, int id)", keeps: ["library", "memory"])
faceOver(library: Library, memory: Option[Object], id: int) -> Option[Face]

// A variation descriptor, freed through the library of the face it keeps.
@c(type: "fx_mmvar *", kept: "face: Face", release: "fx_mmvar_free(face->library, self)")
class MMVar
  @c("int fx_mmvar_axes(const fx_mmvar *self)")
  axes() -> int

@c("fx_mmvar *fx_mmvar_new(fx_face face)", keeps: "face")
mmVar(face: Face) -> MMVar

// An object with no count, and a shelf keeping one, as the Avin object.
@c(type: "fx_plain *", release: "fx_plain_free")
class Plain
  @c("int fx_plain_value(const fx_plain *self)")
  value() -> int

@c("fx_plain *fx_plain_new(int value)")
newPlain(value: int) -> Plain

@c(type: "fx_shelf *", release: "fx_shelf_free")
class Shelf
  @c("int fx_shelf_peek(const fx_shelf *self)")
  peek() -> int

@c("fx_shelf *fx_shelf_new(fx_plain *p)", keeps: "p")
newShelf(p: Plain) -> Shelf

// Statuses of every C integer shape.
@c("fx_status fx_status_of(int code)")
status(code: int) -> Result[unit, int]

@c("enum fx_result fx_result_of(int which)")
resultOf(which: int) -> Result[unit, int]

@c("long long fx_long_status(long long code)")
longStatus(code: long) -> Result[unit, long]

@c("long long fx_long_status(long long code)")
narrowStatus(code: long) -> Result[unit, int]

@c("unsigned char fx_byte_status(unsigned char code)")
byteStatus(code: int) -> Result[unit, int]

// The fixture's counts: what was made of each kind, each reference taken and given back, and each
// object freed.
@c("long fx_count(int kind, int what)")
private count(kind: int, what: int) -> long

// The counts of one kind of C object.
data Counts(created: long, retained: long, released: long, freed: long)

private countsOf(kind: int) -> Counts = Counts(count(kind, 0), count(kind, 1), count(kind, 2), count(kind, 3))

objects() -> Counts = countsOf(0)
libraries() -> Counts = countsOf(1)
faces() -> Counts = countsOf(2)
mmVars() -> Counts = countsOf(3)
plains() -> Counts = countsOf(4)
shelves() -> Counts = countsOf(5)
shapes() -> Counts = countsOf(6)

// How many faces were freed after their library's own handle had given its reference back, and how
// many before.
facesFreedAfterLibrary() -> long = count(2, 4)
facesFreedBeforeLibrary() -> long = count(2, 5)
