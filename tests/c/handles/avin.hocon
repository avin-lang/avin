package { name = "fixture-handles", version = "0.1.0", description = "Handles on the counted C objects of tests/c, for the handle tests" }

// `avin-c-fixture` is the C library in tests/c, which the test harness builds and names to
// `pkg-config`.
c-libraries {
  fixture { pkg-config = "avin-c-fixture", headers = ["avin_handles.h"], install = "the test harness builds it from tests/c" }
}
