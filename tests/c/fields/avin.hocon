package { name = "fixture-fields", version = "0.1.0", description = "Conversions and field accessors over the counted C objects of tests/c, for the field tests" }

// `avin-c-fixture` is the C library in tests/c, which the test harness builds and names to
// `pkg-config`.
c-libraries {
  fields { pkg-config = "avin-c-fixture", headers = ["avin_fields.h"], install = "the test harness builds it from tests/c" }
}
