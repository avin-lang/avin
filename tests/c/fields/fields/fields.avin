module fields

// Handles on the C objects of tests/c/avin_fields.h: a chain of structs each with its parent as its
// first member, passed up the chain through `as:` conversions, and a record whose fields of every kind
// are read and written through field accessors, with the fixture's counts of what was made, retained,
// released and freed.

// The root of the chain, which holds the count.
@c(type: "fxf_base", release: "fxf_base_close", retain: "fxf_base_inc_ref")
class Base
    @c("int fxf_base_value(fxf_base self)")
    value() -> int

    @c("int fxf_base_refs(fxf_base self)")
    refs() -> int

@c("fxf_base fxf_base_new(int value)")
newBase(value: int) -> Base

// A middle, passed as a base through the conversion C's function makes.
@c(type: "fxf_middle", release: "fxf_base_close(fxf_middle_base(self))", retain: "fxf_base_inc_ref(fxf_middle_base(self))",
   as: "fxf_base = fxf_middle_base")
class Middle
    @c("int fxf_base_value(fxf_base self)")
    value() -> int

    @c("int fxf_middle_extra(fxf_middle self)")
    extra() -> int

    @c("int fxf_base_refs(fxf_base self)")
    refs() -> int

@c("fxf_middle fxf_middle_new(int value, int extra)")
newMiddle(value: int, extra: int) -> Middle

// A derived, passed as a middle through a function and as a base through an expression, two steps up
// the chain; its `release:` and `retain:` are expressions too.
@c(type: "fxf_derived", release: "fxf_base_close(&self->middle.base)", retain: "fxf_base_inc_ref(&self->middle.base)",
   as: ["fxf_middle = fxf_derived_middle", "fxf_base = &self->middle.base"])
class Derived
    @c("int fxf_base_value(fxf_base self)")
    value() -> int

    @c("void fxf_base_set(fxf_base self, int value)")
    set(value: int)

    @c("int fxf_middle_extra(fxf_middle self)")
    extra() -> int

    @c("int fxf_derived_more(fxf_derived self)")
    more() -> int

    // The base `const`-qualified is the same pointer.
    @c("int fxf_base_refs(const fxf_base self)")
    refs() -> int

    // The middle it is, lent by C: a handle of its own, which takes a reference.
    @c("fxf_middle fxf_derived_middle(fxf_derived self)", borrowed)
    middle() -> Middle

    // The base's field, reached through the chain's first members, read and written.
    @c(field: "middle.base.value")
    baseValue() -> int

    @c(field: "middle.base.value")
    setBaseValue(value: int)

    @c(field: "more")
    moreField() -> int

    // A method with a body, calling bound methods through each conversion.
    describe() -> string = s"derived ${value()} ${extra()} ${more()}"

@c("fxf_derived fxf_derived_new(int value, int extra, int more)")
newDerived(value: int, extra: int, more: int) -> Derived

// Top-level bindings taking a base or a middle, passed handles that convert to one.
@c("int fxf_base_value(fxf_base b)")
valueOfDerived(b: Derived) -> int

@c("int fxf_base_value(fxf_base b)")
valueOfMiddle(b: Middle) -> int

@c("int fxf_base_value(fxf_base b)")
valueOfBase(b: Base) -> int

// Null for `None`, converted as null.
@c("int fxf_base_value_or(fxf_base b, int fallback)")
valueOr(b: Option[Derived], fallback: int) -> int

@c("int fxf_middle_extra(fxf_middle m)")
extraOf(m: Derived) -> int

@c("bool fxf_same(fxf_base a, fxf_base b)")
same(a: Derived, b: Middle) -> bool

@c("bool fxf_same(fxf_base a, fxf_base b)")
sameDerived(a: Derived, b: Derived) -> bool

// A holder keeps the base it is passed as a derived, by a reference of the derived's own `retain`.
@c(type: "fxf_holder *", release: "fxf_holder_free")
class Holder
    @c("int fxf_holder_peek(const fxf_holder *self)")
    peek() -> int

@c("fxf_holder *fxf_holder_new(fxf_base b)", keeps: "b")
holder(b: Derived) -> Holder

// The sink takes the reference it is passed, converted.
@c("void fxf_sink_take(fxf_base b)", consumes: "b")
sink(b: Derived)

@c("int fxf_sink_drain(void)")
drain() -> int

// A record with a field of every kind.
@c(type: "fxf_record *", release: "fxf_record_unref", retain: "fxf_record_ref")
class Record
    // Integers at every width and sign, at their least and greatest.
    @c(field: "tiny")
    tiny() -> int
    @c(field: "small")
    small() -> int
    @c(field: "small")
    smallByte() -> byte
    @c(field: "i16")
    i16() -> int
    @c(field: "u16")
    u16() -> int
    @c(field: "i32")
    i32() -> int
    @c(field: "u32")
    u32() -> long
    @c(field: "u32")
    u32AsInt() -> int
    @c(field: "i64")
    i64() -> long
    @c(field: "u64")
    u64() -> long
    @c(field: "along")
    along() -> long
    @c(field: "size")
    size() -> long
    @c(field: "shade")
    shade() -> int

    // Truth values: a C `bool`, and an integer used as one.
    @c(field: "flag")
    flag() -> bool
    @c(field: "truth")
    truth() -> bool
    @c(field: "truth")
    truthInt() -> int

    @c(field: "letter")
    letter() -> byte
    @c(field: "single")
    single() -> real
    @c(field: "precise")
    precise() -> real

    // Strings, null as `None`.
    @c(field: "name")
    name() -> Option[string]
    @c(field: "name")
    mustName() -> string
    @c(field: "label")
    label() -> Option[string]
    @c(field: "label")
    labelBytes() -> Option[Array[byte]]

    // A nested struct, and one reached through a pointer.
    @c(field: "origin.x")
    originX() -> int
    @c(field: "origin.y")
    originY() -> int
    @c(field: "corner->x")
    cornerX() -> int
    @c(field: "corner->y")
    cornerY() -> int

    // An array C points at, its length a field, indexed by an `int` and by a `long`.
    @c(field: "count")
    count() -> int
    @c(field: "values[i]", bound: "self->count")
    value(i: int) -> int
    @c(field: "values[i]", bound: "self->count")
    valueAt(i: long) -> long

    // A two-dimensional array, each index with its own bound.
    @c(field: "grid[r][c]", bound: ["self->rows", "self->columns"])
    grid(r: int, c: int) -> int

    // A C-owned array of a union, as Cairo's path data is.
    @c(field: "num_cells")
    cellCount() -> int
    @c(field: "cells[i].header.kind", bound: "self->num_cells")
    cellKind(i: int) -> int
    @c(field: "cells[i].header.length", bound: "self->num_cells")
    cellLength(i: int) -> int
    @c(field: "cells[i].point.x", bound: "self->num_cells")
    cellX(i: int) -> real
    @c(field: "cells[i].point.y", bound: "self->num_cells")
    cellY(i: int) -> real

    // An array of strings, some null.
    @c(field: "tags[i]", bound: "self->tag_count")
    tag(i: int) -> Option[string]

    // Handles, lent: each read takes a reference of its own.
    @c(field: "next")
    next() -> Option[Record]
    @c(field: "next")
    mustNext() -> Record
    @c(field: "base")
    base() -> Option[Base]
    @c(field: "derived")
    derived() -> Option[Derived]

    // Writers, each the reader's field and the value written.
    @c(field: "tiny")
    setTiny(value: int)
    @c(field: "small")
    setSmall(value: int)
    @c(field: "i32")
    setI32(value: int)
    @c(field: "u32")
    setU32(value: long)
    @c(field: "u64")
    setU64(value: long)
    @c(field: "flag")
    setFlag(value: bool)
    @c(field: "truth")
    setTruth(value: bool)
    @c(field: "letter")
    setLetter(value: byte)
    @c(field: "single")
    setSingle(value: real)
    @c(field: "precise")
    setPrecise(value: real)
    @c(field: "origin.x")
    setOriginX(value: int)
    @c(field: "corner->y")
    setCornerY(value: int)
    @c(field: "values[i]", bound: "self->count")
    setValue(i: int, value: int)
    @c(field: "grid[r][c]", bound: ["self->rows", "self->columns"])
    setGrid(r: int, c: int, value: int)

    // What C reads of the values written.
    @c("long long fxf_record_sum(const fxf_record *self)")
    sum() -> long

    @c("void fxf_record_clear_text(fxf_record *self)")
    clearText()

    @c("void fxf_record_bad_text(fxf_record *self)")
    badText()

    @c("void fxf_record_u64_max(fxf_record *self)")
    u64Max()

    // The values, read through the bounded accessor.
    values() -> Vector[int] = (0..<count()).map(i -> value(i)).toVector

@c("fxf_record *fxf_record_new(void)")
newRecord() -> Record

@c("void fxf_record_link(fxf_record *r, fxf_record *next, fxf_base base, fxf_derived derived)")
link(r: Record, next: Option[Record], base: Option[Base], derived: Option[Derived])

// The fixture's counts.
@c("long fxf_count(int kind, int what)")
private count(kind: int, what: int) -> long

// The counts of one kind of C object.
data Counts(created: long, retained: long, released: long, freed: long)

private countsOf(kind: int) -> Counts = Counts(count(kind, 0), count(kind, 1), count(kind, 2), count(kind, 3))

bases() -> Counts = countsOf(0)
records() -> Counts = countsOf(1)
holders() -> Counts = countsOf(2)
