module shapes

// A handle class of this package whose bindings take and answer `fixture.Object`, a handle class of
// the package it depends on: checked with that package's headers before its own, and with ownership
// crossing as it does within one package.
import fixture.Object

@c(type: "fx_shape *", release: "fx_shape_free")
class Shape
  @c("int fx_shape_value(const fx_shape *self)")
  value() -> int

  @c("fx_object *fx_shape_object(fx_shape *self)", borrowed)
  object() -> Object

  @c("fx_object *fx_shape_copy(const fx_shape *self)")
  copy() -> Object

  @c("void fx_shape_absorb(fx_shape *self, fx_object *o)", consumes: "o")
  absorb(o: Object)

  @c("int fx_shape_matches(const fx_shape *self, const fx_object *o)")
  matches(o: Object) -> Result[unit, int]

@c("fx_shape *fx_shape_new(fx_object *o)", keeps: "o")
newShape(o: Object) -> Shape
