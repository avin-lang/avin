package { name = "fixture-shapes", version = "0.1.0", description = "Shapes over the handles of fixture-handles, for the handle tests" }

dependencies {
  fixture-handles { path = "../handles" }
}

// Its declarations are named by a macro its first header defines, and use the C type of
// fixture-handles' `Object`, which only that package's header declares.
c-libraries {
  shapes { pkg-config = "avin-c-fixture", headers = ["avin_shapes.h", "AVIN_SHAPES_DECLARED"], install = "the test harness builds it from tests/c" }
}
