// `out` and `inout` parameters joined into the result: every scalar kind at its bounds, reals at
// their special values, truth values, bytes, enum mirrors, strings and handles; the C result first
// and the out values after it as a tuple, the C result left out where it is `void` or the binding
// answers the out values alone, one value alone no tuple; statuses holding the out values in their
// `Ok`, read only when the status is zero.
import fixture.{Face, Library, Object, faces, newLibrary, newObject, objects}

@c("void ae_signed_out(int which, out signed char *a, out short *b, out int *c, out long long *d)")
signedOut(which: int) -> (i8, i16, int, long)

@c(
  "void ae_unsigned_out(int which, out unsigned char *a, out unsigned short *b, out unsigned int *c, out unsigned long long *d)"
)
unsignedOut(which: int) -> (int, int, long, long)

@c("void ae_sizes_out(int which, out size_t *a, out int8_t *b, out uint16_t *c, out int64_t *d)")
sizesOut(which: int) -> (long, i8, int, long)

@c(
  "void ae_unsigned_out(int which, out unsigned char *a, out unsigned short *b, out unsigned int *c, out unsigned long long *d)"
)
unsignedNarrow(which: int) -> (i8, i16, int, long)

@c("void ae_reals_out(int which, out double *a, out float *b, out ae_real_t *c)")
realsOut(which: int) -> (real, real, real)

@c("void ae_truths_out(int value, out bool *a, out int *b)")
truthsOut(value: int) -> (bool, bool)

@c("void ae_byte_out(int value, out uint8_t *b)")
byteOut(value: int) -> byte

@c("int ae_minmax(int a, int b, out int *lo, out int *hi)")
minmax(a: int, b: int) -> (int, int, int)

// The same function, its C result left out.
@c("int ae_minmax(int a, int b, out int *lo, out int *hi)")
bounds(a: int, b: int) -> (int, int)

@c("void ae_sum_out(int a, int b, out long long *sum)")
sumOut(a: int, b: int) -> long

@c("void ae_leave_out(out int *a, out double *b, out const char **c, out fx_object **d)")
leaveOut() -> (int, real, Option[string], Option[Object])

@c("void ae_signed_inout(inout signed char *a, inout short *b, inout int *c, inout long long *d)")
signedInout(a: i8, b: i16, c: int, d: long) -> (i8, i16, int, long)

@c("void ae_signed_inout(inout signed char *a, inout short *b, inout int *c, inout long long *d)")
signedWide(a: int, b: int, c: int, d: long) -> (int, int, int, long)

@c("void ae_unsigned_inout(inout unsigned char *a, inout unsigned int *b, inout unsigned long long *c)")
unsignedInout(a: int, b: long, c: long) -> (int, long, long)

@c("void ae_reals_inout(inout double *a, inout float *b)")
realsInout(a: real, b: real) -> (real, real)

@c("void ae_truths_inout(inout bool *a, inout int *b)")
truthsInout(a: bool, b: int) -> (bool, int)

@c("void ae_device_to_user(inout double *x, inout double *y)")
deviceToUser(x: real, y: real) -> (real, real)

@c("void ae_prefix_length(const char *text, inout size_t *length)")
prefixLength(text: string, length: long) -> long

@c("void ae_format_out(int code, out ae_format_t *f)")
formatOut(code: int) -> Format

@c("void ae_format_next(inout ae_format_t *f)")
formatNext(f: Format) -> Format

@c("ae_format_t ae_parse_format(const char *text, out int *consumed)")
parseFormat(text: string) -> (Format, int)

@c("void ae_name_out(int which, out const char **name)")
nameOut(which: int) -> string

@c("void ae_name_out(int which, out const char **name)")
maybeName(which: int) -> Option[string]

@c("void ae_name_out(int which, out const char **name)")
nameBytes(which: int) -> Option[Array[byte]]

@c("void ae_two_names(out const char **first, out char **second)")
twoNames() -> (string, string)

@c("void ae_skip_spaces(inout const char **text)")
skipSpaces(text: string) -> string

@c("void ae_replace(inout const char **text)")
replace(text: Option[string]) -> Option[string]

@c("int ae_object_make(int value, out fx_object **object)")
objectMake(value: int) -> Result[Object, int]

@c("void ae_object_maybe(int value, out fx_object **object)")
objectMaybe(value: int) -> Option[Object]

@c("void ae_object_maybe(int value, out fx_object **object)")
objectMust(value: int) -> Object

@c("void ae_object_lent(fx_object *of, out fx_object **object)", borrowed)
objectLent(of: Object) -> Object

@c("ae_status_t ae_object_pair(int a, int b, out fx_object **first, out fx_object **second)")
objectPair(a: int, b: int) -> Result[(Object, Object), Status]

@c("int ae_face_make(fx_library library, int id, out fx_face *face)", keeps: "library")
faceMake(library: Library, id: int) -> Result[Face, int]

// A tuple of the types the binding answers, which its literal's numbers take.
want2[A, B](t: (A, B)) -> (A, B) = t
want3[A, B, C](t: (A, B, C)) -> (A, B, C) = t
want4[A, B, C, D](t: (A, B, C, D)) -> (A, B, C, D) = t

// A handle class of this package over the counted object, whose methods answer through out pointers.
@c(type: "fx_object *", release: "fx_object_unref", retain: "fx_object_ref")
class Counted
  @c("int ae_object_digits(fx_object *self, out int *tens, out int *units)")
  digits() -> (int, int, int)

  @c("ae_status_t ae_object_half(fx_object *self, out int *half)")
  half() -> Result[int, Status]

@c("fx_object *fx_object_new(int value)")
newCounted(value: int) -> Counted

line(o: Object) -> string = s"${o.value()} ${o.refs()}"

@test("out values of every signed width at their least and greatest")
signedBounds()
  assertEq(signedOut(0), want4[i8, i16, int, long]((-128, -32768, -2147483648, -9223372036854775807 - 1)))
  assertEq(signedOut(1), want4[i8, i16, int, long]((127, 32767, 2147483647, 9223372036854775807)))

@test("out values of every unsigned width at zero and their greatest, as wider Avin integers")
unsignedBounds()
  assertEq(unsignedOut(0), want4[int, int, long, long]((0, 0, 0, 0)))
  assertEq(unsignedOut(1), want4[int, int, long, long]((255, 65535, 4294967295, 9223372036854775807)))
  assertEq(sizesOut(0), want4[long, i8, int, long]((0, -128, 0, -9223372036854775807 - 1)))
  assertEq(sizesOut(1), want4[long, i8, int, long]((9223372036854775807, 127, 65535, 9223372036854775807)))

@test(should_trap: "value out of range for long")
unsignedPastLong()
  unsignedOut(2)

@test(should_trap: "value out of range for i8")
unsignedPastI8()
  unsignedNarrow(1)

@test("real out values: a `double`, a `float` and a typedef, at their special values")
realValues()
  assertEq(realsOut(0), want3[real, real, real]((1.5, 0.25, -2.5)))
  val (n1, n2, n3) = realsOut(1)
  assert(n1 != n1 && n2 != n2 && n3 != n3)
  assertEq(realsOut(2), want3[real, real, real]((1.0 / 0.0, -1.0 / 0.0, 1.0 / 0.0)))
  val (z, f, d) = realsOut(3)
  assertEq(1.0 / z, -1.0 / 0.0)
  assertEq(f, 1.401298464324817e-45)
  assertEq(d, 4.9406564584124654e-324)
  assertEq(
    realsOut(4),
    want3[real, real, real]((1.7976931348623157e308, 3.4028234663852886e38, -1.7976931348623157e308))
  )

@test("truth values through a `bool` and an `int`, and a byte")
truths()
  assertEq(truthsOut(0), want2[bool, bool]((false, false)))
  assertEq(truthsOut(1), want2[bool, bool]((true, true)))
  assertEq(truthsOut(-1), want2[bool, bool]((true, true)))
  assertEq(truthsOut(256), want2[bool, bool]((true, true)))
  assertEq(byteOut(255), byte(255))
  assertEq(byteOut(0), byte(0))

@test("the C result comes first and the out values after it, or the out values alone")
resultFirst()
  assertEq(minmax(5, 3), want3[int, int, int]((8, 3, 5)))
  assertEq(minmax(-4, 9), want3[int, int, int]((5, -4, 9)))
  assertEq(bounds(5, 3), want2[int, int]((3, 5)))
  assertEq(sumOut(2147483647, 2147483647), 4294967294)

@test("an out value C leaves alone is zero, and null is `None`")
leftAlone()
  val (a, b, c, d) = leaveOut()
  assertEq(a, 0)
  assertEq(b, 0.0)
  assert(c.isEmpty)
  assert(d.isEmpty)

@test("inout values of every kind are passed in and answered back changed")
inouts()
  assertEq(
    signedInout(-128, 300, -2147483647, -9223372036854775807),
    want4[i8, i16, int, long]((-127, 600, 2147483647, -9223372036854775807 - 1))
  )
  assertEq(
    unsignedInout(254, 2147483647, 9223372036854775806),
    want3[int, long, long]((255, 4294967294, 9223372036854775807))
  )
  assertEq(realsInout(1.25, 0.1), want2[real, real]((2.5, 0.20000000298023224)))
  assertEq(truthsInout(true, 7), want2[bool, int]((false, 21)))
  assertEq(truthsInout(false, -1), want2[bool, int]((true, -3)))
  assertEq(deviceToUser(3.0, -5.0), want2[real, real]((1.5, -2.5)))
  assertEq(prefixLength("hello world", 11), 5)
  assertEq(prefixLength("hello world", 3), 3)
  assertEq(prefixLength("", 0), 0)

@test(should_trap: "value out of range for u8 (unsigned char)")
inoutPastByte()
  unsignedInout(256, 0, 0)

@test(should_trap: "value out of range for i8 (signed char)")
inoutPastSignedChar()
  signedWide(128, 0, 0, 0)

@test("an inout value C wraps comes back as C wrote it, at the least of its type")
inoutWrapped()
  val (a, b, c, d) = signedInout(127, -16384, -2147483647, 0)
  assertEq(a, i8(-128))
  assertEq(b, i16(-32768))
  assertEq(c, 2147483647)
  assertEq(d, -1)

@test(should_trap: "value out of range for long")
inoutPastLong()
  unsignedInout(0, 0, 9223372036854775807)

@test("enum mirrors through out and inout pointers, and beside a C result")
mirrorOuts()
  assert(formatOut(4) == Rgb16_565)
  assert(formatOut(-1) == Format.Invalid)
  assert(formatNext(Format.Invalid) == Argb32)
  assert(formatNext(A8) == Rgb16_565)
  assert(formatNext(Rgb30) == Format.Invalid)
  assertEq(parseFormat("a8"), want2[Format, int]((A8, 2)))
  assertEq(parseFormat("rgb"), want2[Format, int]((Rgb24, 3)))
  assertEq(parseFormat("?"), want2[Format, int]((Format.Invalid, 0)))

@test(should_trap: "`ae_format_out` answered through `f` a value no variant of `Format` holds")
mirrorOutUnknown()
  formatOut(3)

@test("strings through out pointers: copied, empty, non-ASCII, null as `None`, and as bytes")
stringOuts()
  assertEq(nameOut(0), "argb")
  assertEq(nameOut(1), "")
  assertEq(nameOut(2), "héllo ✓ 𝄞")
  assert(maybeName(3).isEmpty)
  assertEq(maybeName(0), Some("argb"))
  assertEq(nameBytes(4).map(b -> b.length), Some(1))
  assert(nameBytes(3).isEmpty)
  assertEq(twoNames(), want2[string, string](("first", "second")))

@test(should_trap: "`ae_name_out` answered through `name` null")
stringOutNull()
  nameOut(3)

@test(should_trap: "`ae_name_out` answered through `name` a string that is not UTF-8")
stringOutIllFormed()
  nameOut(4)

@test(
  "an inout string is passed as a copy and read back where C pointed it: into the copy, at a string of C's, or null"
)
stringInouts()
  assertEq(skipSpaces("   three"), "three")
  assertEq(skipSpaces("none"), "none")
  assertEq(skipSpaces(""), "")
  assertEq(skipSpaces("  ✓ é"), "✓ é")
  assertEq(replace(Some("old")), Some("replaced"))
  assert(replace(Some("nothing")).isEmpty)
  assertEq(replace(Some("")), Some("replaced"))

@test(should_trap: "the string passed to `text` of `skipSpaces` holds a NUL at byte 1")
stringInoutNul()
  skipSpaces("a\0b")

@test("handles through out pointers: owned, null as `None`, lent and retained, two at once")
handleOuts()
  val o = objectMake(5).ok.get
  assertEq(line(o), "5 1")
  assertEq(objectMake(-1).map(x -> x.value()), Err(-1))
  assert(objectMaybe(0).isEmpty)
  assertEq(objectMaybe(3).map(x -> x.value()), Some(3))
  val lent = objectLent(o)
  assertEq(line(o), "5 2")
  lent.close()
  assertEq(line(o), "5 1")
  val (a, b) = objectPair(1, 2).ok.get
  assertEq(a.value() + b.value(), 3)
  assert(objectPair(-1, 2).isErr)
  o.close()
  a.close()
  b.close()

@test(should_trap: "`ae_object_maybe` answered through `object` null")
handleOutNull()
  objectMust(0)

@test("a handle made through an out pointer keeps what the call keeps, only when it succeeded")
handleKeeps()
  val library = newLibrary()
  val face = faceMake(library, 7).ok.get
  assertEq(face.id(), 7)
  assert(faceMake(library, -1).isErr)
  library.close()
  // The face kept the library: it is still alive for the face.
  assertEq(face.id(), 7)
  face.close()
  assertEq(faces().freed, 1)

@test("many out values of every kind under collection")
manyOuts()
  var total: long = 0
  for i in 0 ..< 5000
    val (s, lo, hi) = minmax(i, -i)
    total = total + long(s + hi - lo)
    assertEq(nameOut(i % 3), if i % 3 == 0 then "argb" elif i % 3 == 1 then "" else "héllo ✓ 𝄞")
    assert(formatOut(i % 3) == formatEcho(formatOf(i % 3)))
  assertEq(total, 24995000)

@test("a handle's method takes its receiver first and answers through out pointers after its result")
methodOuts()
  val c = newCounted(42)
  assertEq(c.digits(), want3[int, int, int]((42, 4, 2)))
  assert(c.half() == Ok(21))
  assert(newCounted(7).half() == Err(Status.Invalid))
  c.close()
