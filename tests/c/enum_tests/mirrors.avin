// Enum mirrors held against the fixture's enumerations: each variant crosses as its enumerator's
// value, at the width of the C type, both ways; upper- and lower-case prefixes find their
// enumerators, a variant's `@c` names its own, and values that are negative, sparse, duplicated, at
// the least and greatest `int`, `unsigned int` and `long long`, or the only one cross; two mirrors
// share a variant's name; a value no variant holds stops the program.

@c(enum: "ae_format_t", prefix: "AE_FORMAT_")
data Format
  Invalid
  Argb32
  Rgb24
  A8
  Rgb16_565
  Rgb30

@c("ae_format_t ae_format_echo(ae_format_t f)")
formatEcho(f: Format) -> Format

@c("int ae_format_code(ae_format_t f)")
formatCode(f: Format) -> int

@c("ae_format_t ae_format_of(int code)")
formatOf(code: int) -> Format

@c("int ae_format_code(ae_format_t f)")
formatCodeOfInt(f: int) -> int

@c("const ae_format_t ae_format_const(void)")
formatConst() -> Format

// A mirror leaving enumerators out, which cannot take them.
@c(enum: "ae_format_t", prefix: "AE_FORMAT_")
data FewFormats
  Argb32
  A8

@c("ae_format_t ae_format_of(int code)")
fewOf(code: int) -> FewFormats

@c("int ae_format_code(ae_format_t f)")
fewCode(f: FewFormats) -> int

// Lower-case enumerators of a tagged enumeration; one variant names its own, and `None` shares its
// name with `Option`'s.
@c(enum: "enum ae_image_format", prefix: "ae_image_")
data ImageFormat
  None
  Rgb
  Rgba
  Yuv422
  @c("ae_image_yuv420p")
  Planar

@c("enum ae_image_format ae_image_echo(enum ae_image_format f)")
imageEcho(f: ImageFormat) -> ImageFormat

@c("int ae_image_code(enum ae_image_format f)")
imageCode(f: ImageFormat) -> int

// Enumerators that start with a digit after the prefix, each named by its variant's `@c`.
@c(enum: "ae_pdf_version_t", prefix: "AE_PDF_VERSION_")
data PdfVersion
  @c("AE_PDF_VERSION_1_4")
  V1_4
  @c("AE_PDF_VERSION_1_5") V1_5

@c("ae_pdf_version_t ae_pdf_echo(ae_pdf_version_t v)")
pdfEcho(v: PdfVersion) -> PdfVersion

@c(enum: "ae_limit_t", prefix: "AE_LIMIT_")
data Limit
  Min
  Zero
  Max

@c("ae_limit_t ae_limit_echo(ae_limit_t v)")
limitEcho(v: Limit) -> Limit

@c("int ae_limit_code(ae_limit_t v)")
limitCode(v: Limit) -> int

// Two enumerators with one value: the first variant holding it is the one C's value is.
@c(enum: "enum ae_alias", prefix: "AE_ALIAS_")
data Alias
  First
  Same
  Other

@c("enum ae_alias ae_alias_echo(enum ae_alias a)")
aliasEcho(a: Alias) -> Alias

@c("int ae_alias_code(enum ae_alias a)")
aliasCode(a: Alias) -> int

@c(enum: "ae_only_t", prefix: "AE_ONLY_")
data Only
  One

@c("ae_only_t ae_only_echo(ae_only_t o)")
onlyEcho(o: Only) -> Only

// Two mirrors of one module sharing the variant `Normal`.
@c(enum: "ae_slant_t", prefix: "AE_SLANT_")
data Slant
  Normal
  Italic
  Oblique

@c(enum: "ae_weight_t", prefix: "AE_WEIGHT_")
data Weight
  Normal
  Bold

@c("ae_slant_t ae_slant_echo(ae_slant_t s)")
slantEcho(s: Slant) -> Slant

@c("ae_weight_t ae_weight_echo(ae_weight_t w)")
weightEcho(w: Weight) -> Weight

@c(enum: "ae_big_t", prefix: "AE_BIG_")
data Big
  Low
  High

@c("ae_big_t ae_big_echo(ae_big_t b)")
bigEcho(b: Big) -> Big

@c("long long ae_big_code(ae_big_t b)")
bigCode(b: Big) -> long

@c(enum: "ae_wide_t", prefix: "AE_WIDE_")
data Wide
  Min
  Zero
  Max

@c("ae_wide_t ae_wide_echo(ae_wide_t w)")
wideEcho(w: Wide) -> Wide

@c("long long ae_wide_code(ae_wide_t w)")
wideCode(w: Wide) -> long

@c("ae_wide_t ae_wide_of(long long code)")
wideOf(code: long) -> Wide

@c(enum: "ae_status_t", prefix: "AE_STATUS_")
data Status
  Success
  NoMemory
  Invalid

@c("ae_status_t ae_status_of(int code)")
statusOf(code: int) -> Status

// A mirror is an ordinary data type: it has methods, is matched, compared and held in collections.
impl Format
  bytesPerPixel() -> int = self match
    Argb32 -> 4
    Rgb24 -> 4
    Rgb30 -> 4
    Rgb16_565 -> 2
    A8 -> 1
    Invalid -> 0

data Pixel(format: Format, width: int)

@test("every variant crosses as its enumerator's value, a negative and a sparse one too, and back")
formats()
  assertEq(formatCode(Invalid), -1)
  assertEq(formatCode(Argb32), 0)
  assertEq(formatCode(Rgb24), 1)
  assertEq(formatCode(A8), 2)
  assertEq(formatCode(Rgb16_565), 4)
  assertEq(formatCode(Rgb30), 5)
  val all: Vector[Format] = [Invalid, Argb32, Rgb24, A8, Rgb16_565, Rgb30]
  for f in all
    assert(formatEcho(f) == f)
  assert(formatOf(-1) == Format.Invalid)
  assert(formatOf(4) == Rgb16_565)
  assert(formatOf(5) == Rgb30)
  assertEq(formatCodeOfInt(4), 4)
  assert(formatConst() == A8)

@test("a mirror that leaves enumerators out crosses those it lists")
fewFormats()
  assertEq(fewCode(FewFormats.Argb32), 0)
  assertEq(fewCode(FewFormats.A8), 2)
  assert(fewOf(2) == FewFormats.A8)
  assert(fewOf(0) == FewFormats.Argb32)

@test(should_trap: "`ae_format_of` answered a value no variant of `FewFormats` holds")
fewFormatsUnlisted()
  fewOf(1)

@test(should_trap: "`ae_format_of` answered a value no variant of `Format` holds")
formatUnknown()
  formatOf(3)

@test(should_trap: "`ae_format_of` answered a value no variant of `Format` holds")
formatPastGreatest()
  formatOf(6)

@test("a lower-case prefix finds lower-case enumerators, and a variant's `@c` names its own")
images()
  assertEq(imageCode(ImageFormat.None), 0)
  assertEq(imageCode(Rgb), 1)
  assertEq(imageCode(Rgba), 2)
  assertEq(imageCode(Yuv422), 3)
  assertEq(imageCode(Planar), 7)
  assert(imageEcho(Planar) == Planar)
  assert(imageEcho(ImageFormat.None) == ImageFormat.None)

// The mirror's own `None` where nothing expects an `Option`, and `Option`'s where one is expected.
imageOf(code: int) -> Option[ImageFormat]
  if code < 0 then return None
  if code == 0 then return Some(imageEcho(None))
  Some(imageEcho(Rgb))

@test("a mirror's bare `None` crosses as its enumerator, and `Option`'s is still meant where an option is expected")
imageNone()
  assertEq(imageCode(None), 0)
  assert(imageEcho(None) == None)
  val none: Option[ImageFormat] = None
  assert(imageOf(-1) == none)
  assert(imageOf(0) == Some(None))
  assert(imageOf(1) == Some(Rgb))
  val described = imageOf(0) match
    None -> "no image"
    Some(None) -> "image none"
    Some(_) -> "image"
  assertEq(described, "image none")

@test("enumerators whose names start with a digit after the prefix are named by `@c`")
pdfVersions()
  assert(pdfEcho(V1_4) == V1_4)
  assert(pdfEcho(V1_5) == V1_5)

@test("the least and greatest `int` cross both ways")
limits()
  assertEq(limitCode(Limit.Min), -2147483648)
  assertEq(limitCode(Limit.Zero), 0)
  assertEq(limitCode(Limit.Max), 2147483647)
  assert(limitEcho(Limit.Min) == Limit.Min)
  assert(limitEcho(Limit.Max) == Limit.Max)

@test("two variants of one value both cross as it, and the value comes back as the first")
aliases()
  assertEq(aliasCode(First), 3)
  assertEq(aliasCode(Same), 3)
  assertEq(aliasCode(Other), 9)
  assert(aliasEcho(Same) == First)
  assert(aliasEcho(First) == First)
  assert(aliasEcho(Other) == Other)

@test("an enumeration of one enumerator")
only()
  assert(onlyEcho(One) == One)

@test("two mirrors share the variant `Normal`, which the expected type decides")
sharedNames()
  assert(slantEcho(Normal) == Slant.Normal)
  assert(weightEcho(Normal) == Weight.Normal)
  assert(slantEcho(Oblique) == Oblique)
  assert(weightEcho(Bold) == Bold)
  val s: Slant = Normal
  val w: Weight = Normal
  assert(slantEcho(s) == Slant.Normal && weightEcho(w) == Weight.Normal)

@test("an unsigned enumeration's greatest value crosses at its width")
big()
  assertEq(bigCode(High), 4294967295)
  assertEq(bigCode(Low), 0)
  assert(bigEcho(High) == High)
  assert(bigEcho(Low) == Low)

@test("an enumeration as wide as `long long` crosses at its least and greatest")
wide()
  assertEq(wideCode(Wide.Min), -9223372036854775807 - 1)
  assertEq(wideCode(Wide.Max), 9223372036854775807)
  assertEq(wideCode(Wide.Zero), 0)
  assert(wideEcho(Wide.Min) == Wide.Min)
  assert(wideEcho(Wide.Max) == Wide.Max)
  assert(wideOf(9223372036854775807) == Wide.Max)

@test(should_trap: "`ae_wide_of` answered a value no variant of `Wide` holds")
wideUnknown()
  wideOf(1)

@test(should_trap: "`ae_status_of` answered a value no variant of `Status` holds")
statusUnlisted()
  statusOf(3)

@test("a mirror has methods, is matched, and is held in data values and vectors")
ordinary()
  assertEq(formatEcho(Rgb16_565).bytesPerPixel(), 2)
  val p = Pixel(formatEcho(A8), 3)
  assertEq(formatCode(p.format), 2)
  var total = 0
  val some: Vector[Format] = [Rgb30, Argb32, A8, Invalid]
  for f in some
    total = total + formatCode(formatEcho(f))
  assertEq(total, 6)
  val name = formatOf(1) match
    Rgb24 -> "rgb24"
    _ -> "other"
  assertEq(name, "rgb24")

@test("many crossings, each answer a constant variant, under collection")
manyCrossings()
  var n = 0
  for i in 0 ..< 20000
    val f = formatOf(i % 3)
    val boxed: Any = f
    if boxed is Format then n = n + formatCode(f)
  assertEq(n, 19999)
