// Statuses: a C enum bound as `Result[unit, E]` with `E` its mirror, `Ok(())` for the zero
// enumerator and `Err` of the variant otherwise; and statuses with out values, holding them in their
// `Ok`, one alone or a tuple of them, read only when the status is zero.

@c("ae_status_t ae_status_nothing(int code)")
statusNothing(code: int) -> Result[unit, Status]

@c("ae_status_t ae_divide(int a, int b, out int *quotient, out int *remainder)")
divide(a: int, b: int) -> Result[(int, int), Status]

@c("ae_status_t ae_status_name(int code, out const char **name)")
statusName(code: int) -> Result[string, Status]

@c("ae_status_t ae_status_format(int code, out ae_format_t *f)")
statusFormat(code: int) -> Result[Format, Status]

@c("int ae_checked_half(int value, out int *half)")
checkedHalf(value: int) -> Result[int, int]

@c("int ae_checked_half(int value, out int *half)")
checkedHalfLong(value: int) -> Result[int, long]

@c("int ae_failing_write(out int *value)")
failingWrite() -> Result[int, int]

// The library's own error type over the mirror, as a public function would map it.
data DivisionError
    ByZero
    Other(status: Status)

safeDivide(a: int, b: int) -> Result[int, DivisionError] = divide(a, b) match
    Ok((q, _)) -> Ok(q)
    Err(Status.Invalid) -> Err(ByZero)
    Err(s) -> Err(Other(s))

@test("a status mirror: `Ok(())` for the zero enumerator and `Err` of the variant otherwise")
nothing()
    assertEq(statusNothing(0), Ok(()))
    assert(statusNothing(1) == Err(NoMemory))
    assert(statusNothing(2) == Err(Status.Invalid))

@test(should_trap: "`ae_status_nothing` answered a value no variant of `Status` holds")
nothingUnlisted()
    statusNothing(3)

@test("a status with two out values holds them in its `Ok` as a tuple")
division()
    assertEq(divide(7, 2).ok, Some((3, 1)))
    assertEq(divide(-7, 2).ok, Some((-3, -1)))
    assert(divide(7, 0) == Err(Status.Invalid))
    assert(safeDivide(1, 0) == Err(ByZero))
    assert(safeDivide(9, 3) == Ok(3))

@test("a status with one out value, a string or a mirror, holds it alone")
oneOut()
    assert(statusName(0) == Ok("named"))
    assert(statusName(1) == Err(NoMemory))
    assert(statusFormat(0) == Ok(Rgb30))
    assert(statusFormat(2) == Err(Status.Invalid))

@test("an integer status with an out value, at two widths")
integerStatus()
    assertEq(checkedHalf(8), Ok(4))
    assertEq(checkedHalf(-8), Ok(-4))
    assertEq(checkedHalf(7), Err(-7))
    assertEq(checkedHalfLong(3).err, Some(long(-3)))

@test("out values are not read when the status is not zero")
failing()
    assertEq(failingWrite(), Err(5))

@test("many statuses under collection")
manyStatuses()
    var ok = 0
    for i in 0..<10000
        if statusName(i % 3) is Ok(name)
            if name == "named" then ok += 1
        if divide(i, i % 2) is Ok((q, r))
            ok += q - i + r
    assertEq(ok, 3334)
