// `@c(const:)` values measured by the C unit and folded into the program: integers at the bounds of
// `int` and `long`, an expression, a character, an enumerator and a `static const`; reals including
// an integer constant, a `float`, NaN, the infinities, minus zero and the least subnormal; strings
// that are empty, non-ASCII, concatenated, and the same constant as two kinds.

@c(const: "AE_INT_CONST")
val intConst: int

@c(const: "AE_NEG_CONST")
val negConst: int

@c(const: "AE_INT_MIN_CONST")
val intMin: int

@c(const: "AE_INT_MAX_CONST")
val intMax: int

@c(const: "AE_LONG_MIN_CONST")
val longMin: long

@c(const: "AE_LONG_MAX_CONST")
val longMax: long

// An `int` constant as a `long`, and one that fits an `i16` exactly.
@c(const: "AE_INT_MAX_CONST")
val intMaxAsLong: long

@c(const: "AE_SHORT_MAX_CONST")
val shortMax: i16

@c(const: "AE_EXPR_CONST")
val expr: int

@c(const: "AE_CHAR_CONST")
val letter: int

@c(const: "AE_FORMAT_RGB16_565")
val enumerator: int

@c(const: "ae_static_const")
val staticConst: int

@c(const: "AE_REAL_CONST")
val realConst: real

@c(const: "AE_REAL_INT_CONST")
val realFromInt: real

@c(const: "AE_FLOAT_CONST")
val floatConst: real

@c(const: "AE_NAN_CONST")
val nan: real

@c(const: "AE_INF_CONST")
val inf: real

@c(const: "AE_NEG_INF_CONST")
val negInf: real

@c(const: "AE_NEG_ZERO_CONST")
val negZero: real

@c(const: "AE_TINY_CONST")
val tiny: real

@c(const: "AE_STRING_CONST")
val tagDest: string

@c(const: "AE_EMPTY_CONST")
val empty: string

@c(const: "AE_UNICODE_CONST")
val unicode: string

@c(const: "AE_CONCAT_CONST")
val concat: string

// A private constant, read through a function of the module.
@c(const: "AE_INT_CONST")
private val hidden: int

hiddenTwice() -> int = hidden * 2

// A value initialized from constants.
val sum: long = long(intConst) - longMax + longMax

@test("integer constants at the bounds of `int` and `long`, an expression, a character, an enumerator and a `static const`")
integers()
    assertEq(intConst, 42)
    assertEq(negConst, -7)
    assertEq(intMin, -2147483648)
    assertEq(intMax, 2147483647)
    assertEq(longMin, -9223372036854775807 - 1)
    assertEq(longMax, 9223372036854775807)
    assertEq(intMaxAsLong, 2147483647)
    assertEq(shortMax, 32767)
    assertEq(expr, 1048576)
    assertEq(letter, int('A'))
    assertEq(enumerator, 4)
    assertEq(staticConst, 11)
    assertEq(hiddenTwice(), 84)
    assertEq(sum, 42)

@test("real constants: an integer constant, a `float`, NaN, the infinities, minus zero and the least subnormal")
reals()
    assertEq(realConst, 1.5)
    assertEq(realFromInt, 3.0)
    // A C `float` constant is the binary32 nearest 0.1, widened exactly.
    assertEq(floatConst, 0.10000000149011612)
    assert(nan != nan)
    assertEq(inf, 1.0 / 0.0)
    assertEq(negInf, -1.0 / 0.0)
    assertEq(negZero, 0.0)
    assertEq(1.0 / negZero, -1.0 / 0.0)
    assertEq(tiny, 4.9406564584124654e-324)
    assert(tiny > 0.0)

@test("string constants: a tag name, an empty string, non-ASCII text and concatenated literals")
strings()
    assertEq(tagDest, "cairo.dest")
    assertEq(empty, "")
    assert(empty.isEmpty)
    assertEq(unicode, "héllo ✓ 𝄞")
    assertEq(unicode.byteLength, 15)
    assertEq(concat, "two parts")
