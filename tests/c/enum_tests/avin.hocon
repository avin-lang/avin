package { name = "c-enum-tests", version = "0.1.0" }

// The handle classes of tests/c/handles, whose C library the test harness builds from tests/c and
// names to `pkg-config`.
dependencies {
  fixture-handles { path = "../handles" }
}

// The enums, constants and out parameters of avin_enums.h, in the same C library.
c-libraries {
  enums { pkg-config = "avin-c-fixture", headers = ["avin_enums.h"], install = "the test harness builds it from tests/c" }
}
