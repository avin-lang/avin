// Strings whose C type is spelled through a typedef of `char`, as FreeType's `const FT_String *` is:
// a result, `const` or not, through one typedef or a chain of two; a parameter `const` before the
// typedef, after it, or inside a typedef of `const char`; an `out` value; a callback's parameter; and
// fields, read as strings or in an `Option`, every UTF-8 width.

@c(type: "fxf_record *", release: "fxf_record_unref", retain: "fxf_record_ref")
class Named
  @c("const fxf_string *fxf_family(const fxf_record *self)")
  family() -> string
  @c("const fxf_string *fxf_family(const fxf_record *self)")
  maybeFamily() -> Option[string]
  @c("fxf_string2 *fxf_style(const fxf_record *self)")
  style() -> string
  @c("void fxf_family_out(const fxf_record *self, out const fxf_string **name)")
  familyOut() -> string
  @c(
    "int fxf_with_family(const fxf_record *self, int (*f)(const fxf_string *name, userdata void *ud), userdata void *ud)"
  )
  withFamily(f: string -> int) -> int
  @c(field: "family_name")
  familyName() -> string
  @c(field: "style_name")
  styleName() -> Option[string]

@c("fxf_record *fxf_record_new(void)")
newNamed() -> Named

@c("long fxf_string_length(const fxf_string *s)")
stringLength(s: string) -> long

@c("long fxf_string2_length(fxf_string2 const *s)")
string2Length(s: string) -> long

@c("long fxf_cstring_length(fxf_cstring *s)")
cstringLength(s: string) -> long

@c("long fxf_string_length(const fxf_string *const s)")
constPointerLength(s: string) -> long

@test("a result spelled through a typedef of `char` is a string, copied, `const` or not, through a chain of typedefs")
charTypedefResults()
  val n = newNamed()
  assertEq(n.family(), "Kaisei Decol")
  assertEq(n.maybeFamily(), Some("Kaisei Decol"))
  assertEq(n.style(), "Regular")

@test(
  "a parameter spelled through a typedef of `char` takes a string, `const` before or after the typedef or inside it"
)
charTypedefParameters()
  assertEq(stringLength("Kaisei"), long(6))
  assertEq(stringLength(""), long(0))
  assertEq(string2Length("é日😀"), long(9))
  assertEq(cstringLength("abc"), long(3))
  assertEq(constPointerLength("ab"), long(2))

@test(should_trap: "holds a NUL")
charTypedefParameterWithNul()
  stringLength("a\u{0}b")

@test("an `out` value and a callback's parameter spelled through a typedef of `char` are strings")
charTypedefOutAndCallback()
  val n = newNamed()
  assertEq(n.familyOut(), "Kaisei Decol")
  assertEq(n.withFamily(s -> s.byteLength), 12)
  var seen = ""
  assertEq(n.withFamily(s ->
    seen = s
    1), 1)
  assertEq(seen, "Kaisei Decol")

@test("fields typed through a typedef of `char` are read as strings")
charTypedefFields()
  val n = newNamed()
  assertEq(n.familyName(), "Kaisei Decol")
  assertEq(n.styleName(), Some("Regular"))

@test("many strings through typedefs of `char`, each a copy, survive the collector")
manyCharTypedefReads()
  val n = newNamed()
  var kept: Vector[string] = []
  for i in 0 ..< 5000
    val s = if i % 2 == 0 then n.family() else n.style()
    if i % 500 == 0 then kept = kept :+ s
    assertEq(stringLength(s), long(s.byteLength))
  assertEq(kept.length, 10)
  assertEq(kept(0), "Kaisei Decol")
  assertEq(kept(1), "Kaisei Decol")
