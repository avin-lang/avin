package { name = "c-field-tests", version = "0.1.0" }

// The handle classes of tests/c/fields, whose C library the test harness builds from tests/c and
// names to `pkg-config`.
dependencies {
  fixture-fields { path = "../fields" }
}

// This package binds the same header too, so its own bindings and field accessors name that
// package's handle classes and their `as:` types.
c-libraries {
  fields { pkg-config = "avin-c-fixture", headers = ["avin_fields.h"], install = "the test harness builds it from tests/c" }
}
