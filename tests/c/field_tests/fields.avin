// Conversions between handle types and field accessors, held against the fixture's counts, each test
// in a process of its own so the counts start at zero: a handle passed as one of its `as:` types
// reaches the same C object through a function or an expression, lends it and stays its owner, and is
// checked as any handle passed is; a field is read and written at its own C type, at every width and
// sign, as a truth value, a `real`, a string, a lent handle and through nested structs, pointers and
// unions, an index checked against its bound before C reads anything.
import avin.threads.{Channel, spawn}

import fields.{
  Base, Counts, Derived, Middle, Record, bases, drain, extraOf, holder, holders, link, newBase, newDerived, newMiddle,
  newRecord, records, same, sameDerived, sink, valueOfBase, valueOfDerived, valueOfMiddle, valueOr
}

// A binding of this package passing another package's handle through that package's `as:` glue.
@c("int fxf_base_value(fxf_base b)")
crossValue(d: Derived) -> int

@c("int fxf_middle_extra(fxf_middle m)")
crossExtra(d: Derived) -> int

// A handle class of this package on the record, whose field accessors answer another package's
// handles.
@c(type: "fxf_record *", release: "fxf_record_unref", retain: "fxf_record_ref")
class View
  @c(field: "base")
  base() -> Option[Base]
  @c(field: "derived")
  derived() -> Option[Derived]
  @c(field: "i32")
  i32() -> int
  // An array C fills, as many elements as a field of the receiver says.
  @c("void fxf_record_copy_values(const fxf_record *self, out int *into)", array: "into", length: "self->count")
  values() -> Array[int]
  @c("void fxf_record_set_count(fxf_record *self, int count)")
  setCount(count: int)
  // Enum mirrors read and written through fields: an enum field, and an `int` one holding a
  // cell's kind, as a path's header holds it.
  @c(field: "shade")
  shade() -> Shade
  @c(field: "shade")
  setShade(s: Shade)
  @c(field: "cells[i].header.kind", bound: "self->num_cells")
  cellKind(i: int) -> PathKind
  @c(field: "cells[i].header.kind", bound: "self->num_cells")
  setCellKind(i: int, k: PathKind)
  @c(field: "cells[i].header.kind", bound: "self->num_cells")
  setCellKindRaw(i: int, k: int)
  @c(field: "cells[i].header.kind", bound: "self->num_cells")
  cellKindRaw(i: int) -> int

@c(enum: "enum fxf_shade", prefix: "FXF_")
data Shade
  Light
  Dark

@c(enum: "enum fxf_path_kind", prefix: "FXF_")
data PathKind
  MoveTo
  LineTo
  CurveTo
  ClosePath

@c("fxf_record *fxf_record_new(void)")
newView() -> View

@c("void fxf_record_link(fxf_record *r, fxf_record *next, fxf_base base, fxf_derived derived)")
linkView(r: View, next: Option[Record], base: Option[Base], derived: Option[Derived])

line(c: Counts) -> string = s"${c.created} ${c.retained} ${c.released} ${c.freed}"

@test(
  "a handle passed as one of its `as:` types reaches the same C object, through a function and through an expression"
)
conversions()
  val d = newDerived(1, 2, 3)
  assertEq(d.value(), 1)
  assertEq(d.extra(), 2)
  assertEq(d.more(), 3)
  assertEq(valueOfDerived(d), 1)
  assertEq(extraOf(d), 2)
  assertEq(d.describe(), "derived 1 2 3")
  d.set(-9)
  assertEq(valueOfDerived(d), -9)
  d.set(2147483647)
  assertEq(d.value(), 2147483647)
  val m = newMiddle(4, 5)
  assertEq(m.value(), 4)
  assertEq(m.extra(), 5)
  assertEq(valueOfMiddle(m), 4)
  val b = newBase(6)
  assertEq(valueOfBase(b), 6)
  assertEq(b.value(), 6)

@test("a conversion lends: the handle stays the owner, and nothing is retained or released")
conversionLends()
  val d = newDerived(7, 0, 0)
  for _ in 0 ..< 1000
    assertEq(d.value() + valueOfDerived(d) + extraOf(d), 14)
  assertEq(d.refs(), 1)
  assertEq(line(bases()), "1 0 0 0")
  d.close()
  assertEq(line(bases()), "1 0 1 1")
  d.close()
  assertEq(line(bases()), "1 0 1 1")

@test("None is passed as null, which no conversion is made of")
noneConverts()
  assertEq(valueOr(None, -5), -5)
  val d = newDerived(8, 0, 0)
  assertEq(valueOr(Some(d), 0), 8)

@test("a handle converted two ways is one C pointer, and a borrowed middle of a derived takes a reference of its own")
oneObject()
  val d = newDerived(3, 4, 5)
  val m = d.middle()
  assert(same(d, m))
  assert(sameDerived(d, d))
  assertEq(m.refs(), 2)
  assertEq(m.extra(), 4)
  d.close()
  assertEq(m.value(), 3)
  assertEq(line(bases()), "1 1 1 0")
  m.close()
  assertEq(line(bases()), "1 1 2 1")

@test(should_trap: "`Derived` is closed")
closedConvertedReceiver()
  val d = newDerived(1, 2, 3)
  d.close()
  d.value()

@test(should_trap: "`Derived` is closed")
closedConvertedParameter()
  val d = newDerived(1, 2, 3)
  d.close()
  valueOfDerived(d)

@test(should_trap: "`Derived` is closed")
closedConvertedOption()
  val d = newDerived(1, 2, 3)
  d.close()
  valueOr(Some(d), 0)

@test(should_trap: "`Derived` is closed")
closedConvertedAcrossPackages()
  val d = newDerived(1, 2, 3)
  d.close()
  crossValue(d)

@test("`keeps:` of a converted handle holds it by the class's own reference, given back after the holder")
keepsConverted()
  val d = newDerived(11, 0, 0)
  val h = holder(d)
  assertEq(line(bases()), "1 1 0 0")
  d.close()
  assertEq(h.peek(), 11)
  assertEq(line(bases()), "1 1 1 0")
  h.close()
  assertEq(line(bases()), "1 1 2 1")
  assertEq(line(holders()), "1 0 0 1")

@test("`consumes:` of a converted handle closes it without its release, and C gives the reference back")
consumesConverted()
  val d = newDerived(12, 0, 0)
  sink(d)
  assertEq(line(bases()), "1 0 0 0")
  d.close()
  assertEq(line(bases()), "1 0 0 0")
  assertEq(drain(), 1)
  assertEq(line(bases()), "1 0 1 1")

@test(should_trap: "`Derived` is closed")
consumedConverted()
  val d = newDerived(12, 0, 0)
  sink(d)
  d.extra()

@test("another package's bindings pass a handle through its class's `as:` glue")
crossPackageConversion()
  val d = newDerived(21, 22, 23)
  assertEq(crossValue(d), 21)
  assertEq(crossExtra(d), 22)
  assertEq(d.refs(), 1)

@test(should_trap: "`Derived` belongs to another thread")
convertedOtherThread()
  val made = Channel[Derived]()
  val done = Channel[unit]()
  spawn(() ->
    made.send(newDerived(1, 2, 3))
    done.receive())
  made.receive().get.extra()

@test("a field of the chain's first members is read and written")
chainFields()
  val d = newDerived(30, 31, 32)
  assertEq(d.baseValue(), 30)
  assertEq(d.moreField(), 32)
  d.setBaseValue(-2147483648)
  assertEq(d.value(), -2147483648)
  assertEq(d.baseValue(), -2147483648)

@test("integer fields at every width and sign are read at their least and greatest")
integers()
  val r = newRecord()
  assertEq(r.tiny(), -128)
  assertEq(r.small(), 255)
  assertEq(r.smallByte(), byte(255))
  assertEq(r.i16(), -32768)
  assertEq(r.u16(), 65535)
  assertEq(r.i32(), -2147483648)
  val u32: long = 4294967295
  assertEq(r.u32(), u32)
  val least: long = -9223372036854775807 - 1
  val most: long = 9223372036854775807
  assertEq(r.i64(), least)
  assertEq(r.u64(), most)
  val along: long = 1234567890123
  assertEq(r.along(), along)
  assertEq(r.size(), long(4096))
  assertEq(r.shade(), -3)

@test(should_trap: "value out of range for int")
fieldTooWide()
  newRecord().u32AsInt()

@test(should_trap: "value out of range for long")
unsignedFieldTooWide()
  val r = newRecord()
  r.u64Max()
  r.u64()

@test("truth values, a byte and reals are read at their C types")
otherScalars()
  val r = newRecord()
  assert(r.flag())
  assert(r.truth())
  assertEq(r.truthInt(), -1)
  assertEq(r.letter(), byte(int('A')))
  assertEq(r.single(), 1.5)
  assertEq(r.precise(), -2.25)

@test("string fields are copied, every UTF-8 width, and a null one is None")
strings()
  val r = newRecord()
  assertEq(r.name(), Some("nombre ü 日本 😀"))
  assertEq(r.mustName(), "nombre ü 日本 😀")
  assertEq(r.label(), Some("label"))
  assertEq(r.labelBytes().map(b -> b.length), Some(5))
  r.clearText()
  assertEq(r.name(), None)
  assertEq(r.label(), None)
  assertEq(r.labelBytes().map(b -> b.length), None)

@test(should_trap: "the field `name` of `Record` holds null")
nullString()
  val r = newRecord()
  r.clearText()
  r.mustName()

@test(should_trap: "the field `name` of `Record` holds a string that is not UTF-8 at byte 3")
badString()
  val r = newRecord()
  r.badText()
  r.name()

@test("nested structs and structs through a pointer are read")
nested()
  val r = newRecord()
  assertEq(r.originX(), 3)
  assertEq(r.originY(), -4)
  assertEq(r.cornerX(), 10)
  assertEq(r.cornerY(), 20)

@test("an index is read at the first and the last, as an `int` and a `long`")
indices()
  val r = newRecord()
  assertEq(r.count(), 5)
  assertEq(r.value(0), 10)
  assertEq(r.value(4), 50)
  assertEq(r.valueAt(0), long(10))
  assertEq(r.valueAt(4), long(50))
  assertEq(r.values(), [10, 20, 30, 40, 50])
  assertEq(r.grid(0, 0), 0)
  assertEq(r.grid(2, 3), 23)
  assertEq(r.grid(1, 2), 12)
  assertEq(r.grid(2, 0), 20)

@test(should_trap: "index `i` of `Record.value` out of range")
indexNegative()
  newRecord().value(-1)

@test(should_trap: "index `i` of `Record.value` out of range")
indexAtLength()
  newRecord().value(5)

@test(should_trap: "index `i` of `Record.valueAt` out of range")
longIndexPastInt()
  newRecord().valueAt(4294967296)

@test(should_trap: "index `i` of `Record.valueAt` out of range")
longIndexLeast()
  newRecord().valueAt(-9223372036854775807 - 1)

@test(should_trap: "index `r` of `Record.grid` out of range")
firstIndexAtBound()
  newRecord().grid(3, 0)

@test(should_trap: "index `c` of `Record.grid` out of range")
secondIndexAtBound()
  newRecord().grid(0, 4)

@test(should_trap: "index `c` of `Record.grid` out of range")
secondIndexNegative()
  newRecord().grid(0, -1)

@test("a union in an array C points at is read through each of its members")
unions()
  val r = newRecord()
  assertEq(r.cellCount(), 3)
  assertEq(r.cellKind(0), 0)
  assertEq(r.cellLength(0), 2)
  assertEq(r.cellX(1), 1.5)
  assertEq(r.cellY(1), -2.5)
  assertEq(r.cellKind(2), 3)
  assertEq(r.cellLength(2), 1)

@test(should_trap: "index `i` of `Record.cellX` out of range")
unionPastBound()
  newRecord().cellX(3)

@test("an array of strings is read with null entries as None")
stringArray()
  val r = newRecord()
  assertEq(r.tag(0), Some("a"))
  assertEq(r.tag(1), None)
  assertEq(r.tag(2), Some("ccc"))

@test(should_trap: "index `i` of `Record.tag` out of range")
stringArrayPastBound()
  newRecord().tag(3)

@test("a handle field is lent: each read takes a reference of its own, and everything is given back once")
handleFields()
  val r = newRecord()
  assert(r.next().isEmpty)
  assert(r.base().isEmpty)
  assert(r.derived().isEmpty)
  val r2 = newRecord()
  r2.setI32(42)
  val b = newBase(5)
  val d = newDerived(6, 7, 8)
  link(r, Some(r2), Some(b), Some(d))
  assertEq(line(records()), "2 1 0 0")
  assertEq(line(bases()), "2 2 0 0")
  val n = r.mustNext()
  assert(!(n == r2))
  assertEq(n.i32(), 42)
  val again = r.next().get
  assertEq(again.i32(), 42)
  again.close()
  val rb = r.base().get
  assertEq(rb.value(), 5)
  assertEq(rb.refs(), 3)
  val rd = r.derived().get
  assertEq(rd.describe(), "derived 6 7 8")
  assertEq(valueOfDerived(rd), 6)
  n.close()
  rb.close()
  rd.close()
  r2.close()
  b.close()
  d.close()
  assertEq(line(bases()), "2 4 4 0")
  r.close()
  assertEq(line(records()), "2 3 5 2")
  assertEq(line(bases()), "2 4 6 2")

@test(should_trap: "the field `next` of `Record` holds null")
nullHandleField()
  newRecord().mustNext()

@test("another package's field accessors answer this package's handles, and this package's answer another's")
crossPackageFields()
  val v = newView()
  assertEq(v.i32(), -2147483648)
  assert(v.base().isEmpty)
  val b = newBase(9)
  val d = newDerived(10, 11, 12)
  linkView(v, None, Some(b), Some(d))
  val vb = v.base().get
  assertEq(vb.value(), 9)
  val vd = v.derived().get
  assertEq(crossExtra(vd), 11)
  vb.close()
  vd.close()
  b.close()
  d.close()
  v.close()
  assertEq(line(records()), "1 0 1 1")
  assertEq(line(bases()), "2 4 6 2")

@test("every scalar field is written at its C type, and C reads what was written")
writers()
  val r = newRecord()
  val before = r.sum()
  r.setTiny(127)
  assertEq(r.tiny(), 127)
  r.setTiny(-128)
  assertEq(r.tiny(), -128)
  r.setSmall(0)
  assertEq(r.small(), 0)
  r.setSmall(255)
  assertEq(r.small(), 255)
  r.setI32(2147483647)
  assertEq(r.i32(), 2147483647)
  r.setU32(0)
  assertEq(r.u32(), long(0))
  val most: long = 9223372036854775807
  r.setU64(most)
  assertEq(r.u64(), most)
  r.setFlag(false)
  assert(!r.flag())
  r.setTruth(false)
  assertEq(r.truthInt(), 0)
  r.setTruth(true)
  assertEq(r.truthInt(), 1)
  r.setLetter(byte(int('z')))
  assertEq(r.letter(), byte(int('z')))
  r.setSingle(0.25)
  assertEq(r.single(), 0.25)
  r.setPrecise(1.0e300)
  assertEq(r.precise(), 1.0e300)
  r.setPrecise(-2.25)
  r.setOriginX(-100)
  assertEq(r.originX(), -100)
  r.setCornerY(-20)
  assertEq(r.cornerY(), -20)
  r.setValue(0, 1)
  r.setValue(4, -50)
  assertEq(r.values(), [1, 20, 30, 40, -50])
  r.setGrid(2, 3, -23)
  assertEq(r.grid(2, 3), -23)
  // What C reads, each field at its own width: the i32 and u32 changes cancel, and the rest are the
  // letter (+57), the truth (+2), the origin (-103), the corner (-40), the grid (-46), the values
  // (-109), the float (-125) and the flag (-1000).
  assertEq(r.sum() - before, long(-1364))

@test(should_trap: "value out of range for u8 (the field `small`)")
writeTooWide()
  newRecord().setSmall(256)

@test(should_trap: "value out of range for u8 (the field `small`)")
writeNegativeUnsigned()
  newRecord().setSmall(-1)

@test(should_trap: "value out of range for i8 (the field `tiny`)")
writeSignedTooWide()
  newRecord().setTiny(128)

@test(should_trap: "value out of range for u32 (the field `u32`)")
writeUnsignedPastWidth()
  newRecord().setU32(4294967296)

@test(should_trap: "value out of range for u64 (the field `u64`)")
writeNegativeU64()
  newRecord().setU64(-1)

@test(should_trap: "index `i` of `Record.setValue` out of range")
writeIndexAtLength()
  newRecord().setValue(5, 0)

@test(should_trap: "`Record` is closed")
closedRead()
  val r = newRecord()
  r.close()
  r.i32()

@test(should_trap: "`Record` is closed")
closedWrite()
  val r = newRecord()
  r.close()
  r.setI32(1)

@test(should_trap: "`Record` is closed")
closedIndexed()
  val r = newRecord()
  r.close()
  r.value(0)

@test("a handle read from a field many times is given back each time it is closed or collected")
manyReads()
  val r = newRecord()
  val r2 = newRecord()
  link(r, Some(r2), None, None)
  r2.close()
  for _ in 0 ..< 1000
    r.mustNext().close()
  assertEq(line(records()), "2 1001 1001 0")
  r.close()
  assertEq(line(records()), "2 1001 1003 2")

@test("a method's array C fills is as long as its receiver's field says, at the call")
filledByReceiver()
  val v = newView()
  assertEq(v.values(), Array.tabulate(5, i -> (i + 1) * 10))
  v.setCount(2)
  assertEq(v.values(), Array.tabulate(2, i -> (i + 1) * 10))
  v.setCount(0)
  assertEq(v.values().length, 0)
  v.setCount(5)
  for _ in 0 ..< 2000
    assertEq(v.values().length, 5)

@test(should_trap: "`fxf_record_copy_values` answered through `into` a negative length")
filledNegative()
  val v = newView()
  v.setCount(-4)
  v.values()

@test(should_trap: "`View` is closed")
filledClosed()
  val v = newView()
  v.close()
  v.values()

@test("an enum mirror is read from an enum field and written back, at the enum's values")
enumField()
  val v = newView()
  assertEq(v.shade(), Dark)
  v.setShade(Light)
  assertEq(v.shade(), Light)
  v.setShade(Dark)
  assertEq(v.shade(), Dark)
  val read = () -> v.shade()
  assertEq(read(), Dark)
  assertEq(equalValues(v.shade(), Dark), true)

equalValues[T](a: T, b: T) -> bool = a == b

@test("an enum mirror is read from an `int` field holding its values, by index, and written as its value")
cellKinds()
  val v = newView()
  assertEq(v.cellKind(0), MoveTo)
  assertEq(v.cellKind(2), ClosePath)
  v.setCellKind(0, CurveTo)
  assertEq(v.cellKindRaw(0), 2)
  assertEq(v.cellKind(0), CurveTo)
  v.setCellKindRaw(2, 1)
  assertEq(v.cellKind(2), LineTo)
  for i in 0 ..< 2000
    val k = if i % 2 == 0 then LineTo else ClosePath
    v.setCellKind(2, k)
    assertEq(v.cellKind(2), k)

@test(should_trap: "the field `cells[i].header.kind` of `View` held a value no variant of `PathKind` holds")
cellKindOutOfRange()
  val v = newView()
  v.setCellKindRaw(0, 4)
  v.cellKind(0)

@test(should_trap: "the field `cells[i].header.kind` of `View` held a value no variant of `PathKind` holds")
cellKindNegative()
  val v = newView()
  v.setCellKindRaw(0, -1)
  v.cellKind(0)

@test(should_trap: "index `i` of `View.cellKind` out of range")
cellKindIndex()
  newView().cellKind(3)

@test(should_trap: "`View` is closed")
enumFieldClosed()
  val v = newView()
  v.close()
  v.shade()
