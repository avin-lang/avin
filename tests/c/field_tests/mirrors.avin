// Struct mirrors read and written whole through field accessors, as FreeType's `face->bbox` and
// `face->size->metrics` are: a box at the greatest and least `long`s, metrics reached through a
// pointer holding another mirror and an enum mirror, a member path into them, an element of an array
// of structs with its index checked against its bound, a `const` field read, and a struct holding a
// string read and copied. What a writer stored C reads back.
import avin.threads.spawn

@c(struct: "fxf_box")
data Box(xMin: long, yMin: long, xMax: long, yMax: long)

@c(struct: "struct fxf_point")
data Spot(x: int, y: int)

@c(struct: "struct fxf_metrics")
data Metrics(xPpem: int, ascender: long, origin: Spot, shade: Shade)

@c(struct: "struct fxf_labelled")
data Labelled(label: string, id: int)

@c(type: "fxf_record *", release: "fxf_record_unref", retain: "fxf_record_ref")
class Shapes
  @c(field: "box")
  box() -> Box
  @c(field: "box")
  setBox(b: Box)
  @c(field: "scaled->metrics")
  metrics() -> Metrics
  @c(field: "scaled->metrics")
  setMetrics(m: Metrics)
  @c(field: "scaled->metrics.origin")
  origin() -> Spot
  @c(field: "scaled->metrics.origin")
  setOrigin(s: Spot)
  @c(field: "corners[i]", bound: "3")
  corner(i: int) -> Spot
  @c(field: "corners[i]", bound: "3")
  setCorner(i: int, s: Spot)
  @c(field: "anchor")
  anchor() -> Spot
  @c(field: "labelled")
  labelled() -> Labelled
  @c("const char *fxf_record_shapes(fxf_record *self)")
  shapes() -> string
  @c("void fxf_record_bad_metrics(fxf_record *self)")
  spoilMetrics()

@c("fxf_record *fxf_record_new(void)")
newShapes() -> Shapes

// Two reads of whatever `read` reads, at any type.
twice[T](read: () -> T) -> (T, T) = (read(), read())

@test("a struct mirror is read from a field whole, at the boundaries of its fields' C types")
readBox()
  val s = newShapes()
  val b = s.box()
  val least: long = -9223372036854775807 - 1
  val greatest: long = 9223372036854775807
  assertEq(b.xMin, least)
  assertEq(b.yMin, long(-2))
  assertEq(b.xMax, long(300))
  assertEq(b.yMax, greatest)
  assertEq(b, Box(least, -2, 300, greatest))

@test("a struct mirror written to a field is what C reads back, and what the reader reads")
writeBox()
  val s = newShapes()
  s.setBox(Box(0, -1, 1, 2))
  assertEq(s.box(), Box(0, -1, 1, 2))
  assert(s.shapes().startsWith("box 0 -1 1 2;"))

@test("a field reached through a pointer reads a mirror holding another mirror and an enum mirror")
readMetrics()
  val s = newShapes()
  val m = s.metrics()
  assertEq(m.xPpem, 65535)
  assertEq(m.ascender, long(-9000000000))
  assertEq(m.origin, Spot(11, -12))
  assertEq(m.shade, Shade.Light)

@test("a nested mirror is written in place, its enum mirror as its enumerator's value")
writeMetrics()
  val s = newShapes()
  s.setMetrics(Metrics(0, 9000000000, Spot(-2147483648, 2147483647), Shade.Dark))
  val m = s.metrics()
  assertEq(m, Metrics(0, 9000000000, Spot(-2147483648, 2147483647), Shade.Dark))
  assertEq(
    s.shapes(),
    "box -9223372036854775808 -2 300 9223372036854775807; metrics 0 9000000000 (-2147483648, 2147483647) -3; corners (1, 2) (3, 4) (5, 6); labelled 42"
  )

@test("a member path reads and writes a mirror nested inside another struct")
memberPath()
  val s = newShapes()
  assertEq(s.origin(), Spot(11, -12))
  s.setOrigin(Spot(7, 8))
  assertEq(s.origin(), Spot(7, 8))
  assertEq(s.metrics().origin, Spot(7, 8))
  assertEq(s.metrics().xPpem, 65535)

@test("an element of an array of structs is read and written as a mirror, its index checked")
arrayElements()
  val s = newShapes()
  assertEq(s.corner(0), Spot(1, 2))
  assertEq(s.corner(2), Spot(5, 6))
  s.setCorner(1, Spot(-3, -4))
  assertEq(s.corner(1), Spot(-3, -4))
  assert(s.shapes().contains("corners (1, 2) (-3, -4) (5, 6)"))

@test(should_trap: "index `i` of `Shapes.corner` out of range")
arrayElementPastBound()
  newShapes().corner(3)

@test(should_trap: "index `i` of `Shapes.setCorner` out of range")
arrayElementWrittenBeforeZero()
  newShapes().setCorner(-1, Spot(0, 0))

@test("a `const` struct field is read")
constField()
  assertEq(newShapes().anchor(), Spot(-7, 8))

@test("a struct holding a string is read with the string copied and checked as UTF-8")
labelledRead()
  val l = newShapes().labelled()
  assertEq(l.label, "étiquette 😀")
  assertEq(l.id, 42)

@test(should_trap: "no variant of `Shade`")
metricsWithNoVariant()
  val s = newShapes()
  s.spoilMetrics()
  s.metrics()

@test(should_trap: "`Shapes` is closed")
closedReader()
  val s = newShapes()
  s.close()
  s.box()

@test(should_trap: "`Shapes` is closed")
closedWriter()
  val s = newShapes()
  s.close()
  s.setBox(Box(0, 0, 0, 0))

@test("a struct mirror field read through a closure and a generic function")
closuresAndGenerics()
  val s = newShapes()
  val read = () -> s.metrics()
  val (a, b) = twice(read)
  assertEq(a, b)
  val (c, d) = twice(s.box)
  assertEq(c, d)
  val corners = (0 ..< 3).map(i -> s.corner(i))
  assertEq(corners, [Spot(1, 2), Spot(3, 4), Spot(5, 6)])

@test("many reads and writes, each a new value, keep every value whole while the collector runs")
manyMirrorReads()
  val s = newShapes()
  var total: long = 0
  var kept: Vector[Labelled] = []
  for i in 0 ..< 20000
    s.setOrigin(Spot(i, -i))
    val m = s.metrics()
    total = total + long(m.origin.x - m.origin.y)
    if i % 1000 == 0 then kept = kept :+ s.labelled()
  assertEq(total, long(399980000))
  assertEq(kept.length, 20)
  for l in kept
    assertEq(l.label, "étiquette 😀")

@test("threads read struct mirrors from fields of handles of their own")
threadedReads()
  val workers = (0 ..< 4).map(k -> spawn(() ->
    val s = newShapes()
    var sum: long = 0
    for i in 0 ..< 2000
      s.setCorner(i % 3, Spot(k, i))
      sum = sum + long(s.corner(i % 3).y)
    sum))
  for w in workers
    assertEq(w.join(), long(1999000))
