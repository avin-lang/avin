// Several arrays in one call, named as a list by `array:`, each with its `length:` and its `free:` in
// lists of their own in the same order: each copied and freed by its own function, all freed unread
// where a status fails; arrays C fills and arrays C allocates in one list; and out pointers marked
// `null`, passed null as C allows, which are no part of the result.
import avin.threads.spawn

@c(struct: "as_cluster")
data Cluster(numBytes: int, numGlyphs: int)

@c(enum: "as_cluster_flags", prefix: "AS_CLUSTER_")
data ClusterFlags
    Forward
    Backward

@c("int as_shape(const char *text, int n, out as_glyph **glyphs, out int *num_glyphs, out as_cluster **clusters, out int *num_clusters, out as_cluster_flags *flags)",
   array: ["glyphs", "clusters"], length: ["num_glyphs", "num_clusters"], free: ["as_glyphs_free", "as_clusters_free"])
shape(text: string, n: int) -> Result[(Array[Glyph], int, Array[Cluster], int, ClusterFlags), int]

@c("int as_shape(const char *text, int n, out as_glyph **glyphs, out int *num_glyphs, out as_cluster **clusters, out int *num_clusters, out as_cluster_flags *flags)",
   array: ["clusters", "glyphs"], length: ["num_clusters * 1", "num_glyphs"], free: ["as_clusters_free(clusters)", "as_glyphs_free"])
shapeReversed(text: string, n: int) -> Result[(Array[Glyph], int, Array[Cluster], int, ClusterFlags), int]

@c("int as_shape(const char *text, int n, out as_glyph **glyphs, out int *num_glyphs, out as_cluster **clusters, out int *num_clusters, out as_cluster_flags *flags)",
   array: ["glyphs", "clusters"], length: ["num_glyphs", "num_clusters"], free: ["as_glyphs_free", "as_clusters_free"])
shapeOptional(text: string, n: int) -> Result[(Option[Array[Glyph]], int, Option[Array[Cluster]], int, ClusterFlags), int]

@c("int as_shape(const char *text, int n, out as_glyph **glyphs, out int *num_glyphs, null as_cluster **clusters, null int *num_clusters, null as_cluster_flags *flags)",
   array: "glyphs", length: "num_glyphs", free: "as_glyphs_free")
shapeGlyphs(text: string, n: int) -> Result[(Array[Glyph], int), int]

@c("int as_shape(const char *text, int n, out as_glyph **glyphs, out int *num_glyphs, out as_cluster **clusters, out int *num_clusters, null as_cluster_flags *flags)",
   array: ["glyphs", "clusters"], length: ["num_glyphs", "num_clusters"], free: ["as_glyphs_free", "as_clusters_free"])
shapeNoFlags(text: string, n: int) -> Result[(Array[Glyph], int, Array[Cluster], int), int]

@c("int as_shape(const char *text, int n, out as_glyph **glyphs, out int *num_glyphs, null as_cluster **clusters, null int *num_clusters, null as_cluster_flags *flags)",
   array: "glyphs", length: "num_glyphs", free: "as_glyphs_free", blocking)
shapeGlyphsBlocking(text: string, n: int) -> Result[(Array[Glyph], int), int]

@c("int as_shape_nulls(void)")
shapeNulls() -> int

@c("int as_clusters_allocated(void)")
clustersAllocated() -> int

@c("int as_clusters_freed(void)")
clustersFreed() -> int

@c("int as_spread(int n, out int32_t *ints, out uint8_t *bytes)", array: ["ints", "bytes"], length: ["n", "n * 2"])
spread(n: int) -> (int, Array[int], Array[byte])

@c("int as_spread(int n, out int32_t *ints, out uint8_t *bytes)", array: ["bytes", "ints"], length: ["n * 2", "n"], free: ["", ""])
spreadListed(n: int) -> (int, Array[int], Array[byte])

@c("int as_mixed(int n, out int32_t *filled, out double **made, out int *count)", array: ["made", "filled"], length: ["count", "n"], free: ["free", ""])
mixed(n: int) -> (int, Array[int], Array[real], int)

@test("an array C fills and one it allocates in one call")
fillAndAllocate()
    val (r, filled, made, count) = mixed(5)
    assertEq((r, filled.length, made.length, count), (5, 5, 5, 5))
    assertEq((filled(4), made(3)), (16, 1.5))
    val (z, none, nothing, zero) = mixed(0)
    assertEq((z, none.length, nothing.length, zero), (0, 0, 0, 0))
    for i in 0..<1000
        val (_, f, m, _) = mixed(i % 9)
        assertEq(f.length + m.length, 2 * (i % 9))

@test("two arrays C allocates in one call, each copied and freed by its own function")
twoArrays()
    val (glyphsBefore, clustersBefore) = (freed(), clustersFreed())
    shape("hello", 3) match
        Ok((glyphs, n, clusters, k, flags)) ->
            assertEq((glyphs.length, n, clusters.length, k), (3, 3, 2, 2))
            assertEq(glyphs(2), Glyph(3, 1.0, -2.0))
            assertEq(clusters(0), Cluster(5, 2))
            assertEq(clusters(1), Cluster(6, 1))
            assertEq(flags, Forward)
        Err(code) -> assert(false, s"status $code")
    assertEq((freed(), clustersFreed()), (glyphsBefore + 1, clustersBefore + 1))
    assertEq(allocated(), freed())
    assertEq(clustersAllocated(), clustersFreed())

@test("the order the binding names the arrays in is its own, the result keeping the prototype's")
reversedOrder()
    shapeReversed("rtl", 4) match
        Ok((glyphs, n, clusters, k, flags)) ->
            assertEq((glyphs.length, n, clusters.length, k), (4, 4, 2, 2))
            assertEq(clusters(1), Cluster(4, 2))
            assertEq(flags, Backward)
        Err(code) -> assert(false, s"status $code")
    assertEq(clustersAllocated(), clustersFreed())

@test("every array C allocated before a status failed is freed unread")
failedFreesAll()
    val (glyphsBefore, clustersBefore) = (freed(), clustersFreed())
    assertEq(shape("x", -1).map(_ -> 0), Err(7))
    assertEq((freed(), clustersFreed()), (glyphsBefore + 1, clustersBefore + 1))
    assertEq(allocated(), freed())
    assertEq(clustersAllocated(), clustersFreed())

@test("null arrays are `None` each on its own, or empty where the binding answers none")
nullArrays()
    shapeOptional("", 0) match
        Ok((glyphs, n, clusters, k, _)) ->
            assert(glyphs is None)
            assert(clusters is None)
            assertEq(n + k, 0)
        Err(_) -> assert(false)
    shape("", 0) match
        Ok((glyphs, _, clusters, _, _)) -> assertEq(glyphs.length + clusters.length, 0)
        Err(_) -> assert(false)
    shapeOptional("ab", 1) match
        Ok((glyphs, _, clusters, _, _)) -> assertEq((glyphs.map(g -> g.length), clusters.map(c -> c.length)), (Some(1), Some(1)))
        Err(_) -> assert(false)

@test("out pointers marked `null` are passed null and are no part of the result")
nullOuts()
    val before = shapeNulls()
    val clusters = clustersAllocated()
    shapeGlyphs("abc", 2) match
        Ok((glyphs, n)) ->
            assertEq(glyphs.length, 2)
            assertEq(n, 2)
        Err(_) -> assert(false)
    assertEq(shapeNulls(), before + 1)
    assertEq(clustersAllocated(), clusters)
    shapeNoFlags("r", 2) match
        Ok((g, n, c, k)) -> assertEq((g.length, n, c.length, k), (2, 2, 1, 1))
        Err(_) -> assert(false)
    assertEq(shapeNulls(), before + 1)
    assertEq(shapeGlyphs("x", -2).map(_ -> 0), Err(7))
    assertEq(allocated(), freed())

@test("two arrays C fills in one call, each at its own length")
twoFilled()
    val (sum, ints, bytes) = spread(4)
    assertEq(sum, 12)
    assertEq((ints.length, ints(0), ints(1), ints(2), ints(3)), (4, -2147483648, 2147483647, -6, -9))
    assertEq(bytes.length, 8)
    assertEq(bytes(0), byte(255))
    assertEq(bytes(7), byte(248))
    val (z, none, nothing) = spreadListed(0)
    assertEq((z, none.length, nothing.length), (0, 0, 0))
    val (s, i, b) = spreadListed(1)
    assertEq((s, i(0), b(1)), (3, -2147483648, byte(254)))

@test("many calls answering several arrays, blocking and not, free everything")
manySeveral()
    for i in 0..<2000
        shape("abc", i % 6) match
            Ok((g, _, c, _, _)) -> assertEq(g.length + c.length, i % 6 + (i % 6 + 1) / 2)
            Err(_) -> assert(false)
        if i % 10 == 0
            shapeGlyphsBlocking("abc", 3) match
                Ok((g, _)) -> assertEq(g.length, 3)
                Err(_) -> assert(false)
    assertEq(allocated(), freed())
    assertEq(clustersAllocated(), clustersFreed())

@test("several arrays answered in a closure, a generic function and another thread")
severalNeighbours()
    val count = (n: int) -> shape("ab", n).map(r -> r match
        (g, _, c, _, _) -> g.length + c.length)
    assertEq(count(4), Ok(6))
    assertEq(apply(5, count), Ok(8))
    val t = spawn(() -> shapeGlyphs("ab", 2).map(r -> r match
        (g, n) -> g.length + n))
    assertEq(t.join(), Ok(4))

apply[A, B](a: A, f: (A) -> B) -> B = f(a)
