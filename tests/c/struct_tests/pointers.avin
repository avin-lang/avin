// Struct mirrors through pointers: read by C through `const T *`, null for an `Option`'s `None`,
// filled through `out` and updated through `inout`, as part of the result, a status's `Ok` among
// them; nested mirrors in place, a struct padded around every scalar kind, a struct named by its tag
// and an empty struct, each laid out as the C unit measured the header's struct.

@c(struct: "as_point")
data Point(x: real, y: real)

@c(struct: "as_rect")
data Rect
  Rect(origin: Point, size: Point)

@c(struct: "as_matrix")
data Matrix(xx: real, yx: real, xy: real, yy: real, x0: real, y0: real)

@c("double as_point_length2(const as_point *p)")
length2(p: Point) -> real

@c("int as_point_is_null(const as_point *p)")
isNull(p: Option[Point]) -> bool

@c("double as_rect_area(as_rect r)")
area(r: Rect) -> real

@c("double as_rect_area_or(const as_rect *r)")
areaOr(r: Option[Rect]) -> real

@c("as_rect as_rect_grow(as_rect r, double by)")
grow(r: Rect, by: real) -> Rect

@c("void as_matrix_init_translate(out as_matrix *m, double tx, double ty)")
translation(tx: real, ty: real) -> Matrix

@c("void as_matrix_translate(inout as_matrix *m, double tx, double ty)")
translate(m: Matrix, tx: real, ty: real) -> Matrix

@c("as_point as_matrix_transform(const as_matrix *m, as_point p)")
transform(m: Matrix, p: Point) -> Point

@c("void as_matrix_multiply(out as_matrix *result, const as_matrix *a, const as_matrix *b)")
multiply(a: Matrix, b: Matrix) -> Matrix

@c("int as_matrix_scale_status(inout as_matrix *m, double s)")
scaled(m: Matrix, s: real) -> Result[Matrix, int]

@c(struct: "as_padded")
data Padded(
    c1: byte,
    l: long,
    c2: byte,
    i: int,
    c3: byte,
    s: i16,
    c4: byte,
    d: real,
    c5: byte,
    f: real,
    c6: byte,
    t: bool,
    c7: byte,
    ul: long,
    c8: byte,
    ui: long,
    c9: byte,
    us: int,
    c10: byte,
    sc: i8,
    c11: byte,
    uc: int
)

@c("as_padded as_padded_make(int which)")
paddedMake(which: int) -> Padded

@c("int as_padded_check(const as_padded *p, int which)")
paddedCheck(p: Padded, which: int) -> bool

@c(struct: "struct as_tagged")
data Tagged(x: int, y: int)

@c("struct as_tagged as_tagged_swap(struct as_tagged t)")
swap(t: Tagged) -> Tagged

@c(struct: "as_empty")
data Empty
  Empty

@c("int as_empty_count(as_empty e)")
emptyCount(e: Empty) -> int

@c("as_empty as_empty_make(void)")
emptyMake() -> Empty

impl Point
  plus(o: Point) -> Point = Point(x + o.x, y + o.y)

@test("a mirror passed through a `const` pointer, nested mirrors in place")
constPointers()
  assertEq(length2(Point(3.0, 4.0)), 25.0)
  assertEq(area(Rect(Point(1.0, 2.0), Point(3.0, 4.0))), 12.0)
  assertEq(grow(Rect(Point(1.0, 2.0), Point(3.0, 4.0)), 1.0), Rect(Point(0.0, 1.0), Point(5.0, 6.0)))
  assertEq(length2(Point(1.0, 1.0).plus(Point(1.0, 1.0))), 8.0)

@test("an `Option` of a mirror passes null for `None`")
optionalPointers()
  assert(isNull(None))
  assert(!isNull(Some(Point(0.0, 0.0))))
  assertEq(areaOr(None), -1.0)
  assertEq(areaOr(Some(Rect(Point(0.0, 0.0), Point(2.0, 5.0)))), 10.0)

@test("a mirror C fills through `out`, updates through `inout`, and answers by value")
outAndInout()
  val m = translation(2.0, 3.0)
  assertEq(m, Matrix(1.0, 0.0, 0.0, 1.0, 2.0, 3.0))
  assertEq(translate(m, 1.0, 1.0), Matrix(1.0, 0.0, 0.0, 1.0, 3.0, 4.0))
  assertEq(m, Matrix(1.0, 0.0, 0.0, 1.0, 2.0, 3.0))
  assertEq(transform(m, Point(1.0, 1.0)), Point(3.0, 4.0))
  val s = Matrix(2.0, 0.0, 0.0, 2.0, 0.0, 0.0)
  assertEq(multiply(m, s), Matrix(2.0, 0.0, 0.0, 2.0, 4.0, 6.0))

@test("a status holds the mirror C updated in its `Ok`, and nothing on failure")
statuses()
  assertEq(scaled(Matrix(1.0, 0.0, 0.0, 1.0, 5.0, 6.0), 3.0), Ok(Matrix(3.0, 0.0, 0.0, 3.0, 5.0, 6.0)))
  assertEq(scaled(Matrix(1.0, 0.0, 0.0, 1.0, 5.0, 6.0), 0.0), Err(1))

@test("a struct padded around every scalar kind, at each kind's least and greatest")
padding()
  val low = paddedMake(0)
  assertEq(low.l, -9223372036854775807 - 1)
  assertEq(low.i, -2147483648)
  assertEq(low.s, i16(-32768))
  assertEq(low.f, -3.4028234663852886e38)
  assertEq(low.d, -1.7976931348623157e308)
  assert(!low.t)
  assertEq(low.ul, 0)
  assertEq(low.ui, 0)
  assertEq(low.us, 0)
  assertEq(low.sc, i8(-128))
  assertEq(low.uc, 0)
  assertEq(low.c1, byte(int('a')))
  assertEq(low.c11, byte(int('k')))
  val high = paddedMake(1)
  assertEq(high.l, 9223372036854775807)
  assertEq(high.i, 2147483647)
  assertEq(high.s, i16(32767))
  assertEq(high.f, 3.4028234663852886e38)
  assertEq(high.d, 1.7976931348623157e308)
  assert(high.t)
  assertEq(high.ul, 9223372036854775807)
  assertEq(high.ui, 4294967295)
  assertEq(high.us, 65535)
  assertEq(high.sc, i8(127))
  assertEq(high.uc, 255)
  assert(paddedCheck(low, 0))
  assert(paddedCheck(high, 1))
  assert(!paddedCheck(high, 0))

@test(should_trap: "value out of range for u32 (`ui` of `as_padded`)")
paddedPastField()
  val high = paddedMake(1)
  paddedCheck(
    Padded(
      high.c1,
      high.l,
      high.c2,
      high.i,
      high.c3,
      high.s,
      high.c4,
      high.d,
      high.c5,
      high.f,
      high.c6,
      high.t,
      high.c7,
      high.ul,
      high.c8,
      4294967296,
      high.c9,
      high.us,
      high.c10,
      high.sc,
      high.c11,
      high.uc
    ),
    1
  )

@test(should_trap: "value out of range for u16 (`us` of `as_padded`)")
paddedNegativeField()
  val low = paddedMake(0)
  paddedCheck(
    Padded(
      low.c1,
      low.l,
      low.c2,
      low.i,
      low.c3,
      low.s,
      low.c4,
      low.d,
      low.c5,
      low.f,
      low.c6,
      low.t,
      low.c7,
      low.ul,
      low.c8,
      low.ui,
      low.c9,
      -1,
      low.c10,
      low.sc,
      low.c11,
      low.uc
    ),
    0
  )

@test("a struct named by its tag, and an empty struct")
tagsAndEmpty()
  assertEq(swap(Tagged(1, -2)), Tagged(-2, 1))
  assertEq(emptyCount(Empty), 0)
  assertEq(emptyMake(), Empty)
