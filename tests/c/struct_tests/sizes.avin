// Struct mirrors passed and answered by value in every size class the platforms' calling conventions
// tell apart: 1, 2, 3, 4, 8, 12, 16, 24, 32 and 40 bytes, of integers, floats, doubles and both,
// which go in integer registers, floating-point registers, both, or memory. Each crosses through the
// C unit's glue, which clang compiles for the target, between scalars that use the registers too.

@c(struct: "as_one")
data One(c: byte)

@c("as_one as_one_make(int seed)")
oneMake(seed: int) -> One
@c("as_one as_one_echo(as_one v)")
oneEcho(v: One) -> One
@c("double as_one_sum(int a, as_one v, double b)")
oneSum(a: int, v: One, b: real) -> real

@c(struct: "as_two")
data Two(a: i16)

@c("as_two as_two_make(int seed)")
twoMake(seed: int) -> Two
@c("as_two as_two_echo(as_two v)")
twoEcho(v: Two) -> Two
@c("double as_two_sum(int a, as_two v, double b)")
twoSum(a: int, v: Two, b: real) -> real

@c(struct: "as_three")
data Three(a: int, b: int, c: byte)

@c("as_three as_three_make(int seed)")
threeMake(seed: int) -> Three
@c("as_three as_three_echo(as_three v)")
threeEcho(v: Three) -> Three
@c("double as_three_sum(int a, as_three v, double b)")
threeSum(a: int, v: Three, b: real) -> real

@c(struct: "as_four")
data Four(v: int)

@c("as_four as_four_make(int seed)")
fourMake(seed: int) -> Four
@c("as_four as_four_echo(as_four v)")
fourEcho(v: Four) -> Four
@c("double as_four_sum(int a, as_four v, double b)")
fourSum(a: int, v: Four, b: real) -> real

@c(struct: "as_eight")
data Eight(a: int, b: real)

@c("as_eight as_eight_make(int seed)")
eightMake(seed: int) -> Eight
@c("as_eight as_eight_echo(as_eight v)")
eightEcho(v: Eight) -> Eight
@c("double as_eight_sum(int a, as_eight v, double b)")
eightSum(a: int, v: Eight, b: real) -> real

@c(struct: "as_twelve")
data Twelve(a: real, b: real, c: real)

@c("as_twelve as_twelve_make(int seed)")
twelveMake(seed: int) -> Twelve
@c("as_twelve as_twelve_echo(as_twelve v)")
twelveEcho(v: Twelve) -> Twelve
@c("double as_twelve_sum(int a, as_twelve v, double b)")
twelveSum(a: int, v: Twelve, b: real) -> real

@c(struct: "as_sixteen")
data Sixteen(a: long, b: real)

@c("as_sixteen as_sixteen_make(int seed)")
sixteenMake(seed: int) -> Sixteen
@c("as_sixteen as_sixteen_echo(as_sixteen v)")
sixteenEcho(v: Sixteen) -> Sixteen
@c("double as_sixteen_sum(int a, as_sixteen v, double b)")
sixteenSum(a: int, v: Sixteen, b: real) -> real

@c(struct: "as_twentyfour")
data TwentyFour(a: long, b: long, c: long)

@c("as_twentyfour as_twentyfour_make(int seed)")
twentyFourMake(seed: int) -> TwentyFour
@c("as_twentyfour as_twentyfour_echo(as_twentyfour v)")
twentyFourEcho(v: TwentyFour) -> TwentyFour
@c("double as_twentyfour_sum(int a, as_twentyfour v, double b)")
twentyFourSum(a: int, v: TwentyFour, b: real) -> real

@c(struct: "as_thirtytwo")
data ThirtyTwo(a: real, b: real, c: real, d: real)

@c("as_thirtytwo as_thirtytwo_make(int seed)")
thirtyTwoMake(seed: int) -> ThirtyTwo
@c("as_thirtytwo as_thirtytwo_echo(as_thirtytwo v)")
thirtyTwoEcho(v: ThirtyTwo) -> ThirtyTwo
@c("double as_thirtytwo_sum(int a, as_thirtytwo v, double b)")
thirtyTwoSum(a: int, v: ThirtyTwo, b: real) -> real

@c(struct: "as_forty")
data Forty(a: long, b: long, c: long, d: long, e: long)

@c("as_forty as_forty_make(int seed)")
fortyMake(seed: int) -> Forty
@c("as_forty as_forty_echo(as_forty v)")
fortyEcho(v: Forty) -> Forty
@c("double as_forty_sum(int a, as_forty v, double b)")
fortySum(a: int, v: Forty, b: real) -> real

@c("double as_many(as_thirtytwo a, int i, as_forty b, double d, as_sixteen c, as_three e, as_twelve f)")
many(a: ThirtyTwo, i: int, b: Forty, d: real, c: Sixteen, e: Three, f: Twelve) -> real

@test("a struct of one byte is answered, passed back and passed between scalars")
one()
    assertEq(oneMake(65), One(byte(65)))
    assertEq(oneEcho(One(byte(65))), One(byte(66)))
    assertEq(oneEcho(One(byte(255))), One(byte(0)))
    assertEq(oneSum(1, One(byte(10)), 0.5), 11.5)

@test("a struct of two bytes, a short at its least and greatest")
two()
    assertEq(twoMake(3), Two(300))
    assertEq(twoEcho(Two(-32768)), Two(-32767))
    assertEq(twoEcho(Two(32766)), Two(32767))
    assertEq(twoSum(1, Two(-5), 0.25), -3.75)

@test("a struct of three bytes, which no register holds whole")
three()
    assertEq(threeMake(7), Three(7, 8, byte(9)))
    assertEq(threeEcho(Three(0, 254, byte(1))), Three(1, 255, byte(2)))
    assertEq(threeSum(1, Three(255, 255, byte(255)), 1.0), 767.0)

@test("a struct of one int")
four()
    assertEq(fourMake(-2), Four(-2000))
    assertEq(fourEcho(Four(2147483646)), Four(2147483647))
    assertEq(fourSum(1, Four(-2147483648), 0.5), -2147483646.5)

@test("a struct of an int and a float, eight bytes in one integer register")
eight()
    assertEq(eightMake(4), Eight(4, 4.5))
    assertEq(eightEcho(Eight(-1, 0.25)), Eight(0, 1.25))
    assertEq(eightSum(1, Eight(2, 0.5), 0.25), 3.75)

@test("a struct of three floats, twelve bytes of floating point")
twelve()
    assertEq(twelveMake(1), Twelve(1.25, 1.5, 1.75))
    assertEq(twelveEcho(Twelve(-1.0, 0.0, 1.0)), Twelve(0.0, 1.0, 2.0))
    assertEq(twelveSum(1, Twelve(0.5, 0.25, 0.125), 1.0), 2.875)

@test("a struct of a long and a double, sixteen bytes in two kinds of register")
sixteen()
    assertEq(sixteenMake(1), Sixteen(8589934592, 1.125))
    assertEq(sixteenEcho(Sixteen(-9223372036854775807 - 1, -0.5)), Sixteen(-9223372036854775807, 0.5))
    assertEq(sixteenSum(1, Sixteen(2, 0.5), 0.5), 4.0)

@test("a struct of three longs, twenty-four bytes passed in memory")
twentyFour()
    assertEq(twentyFourMake(5), TwentyFour(5, -5, 15))
    assertEq(twentyFourEcho(TwentyFour(9223372036854775806, -1, 0)), TwentyFour(9223372036854775807, 0, 1))
    assertEq(twentyFourSum(1, TwentyFour(1, 2, 3), 0.5), 7.5)

@test("a struct of four doubles, thirty-two bytes")
thirtyTwo()
    assertEq(thirtyTwoMake(2), ThirtyTwo(2.0, 4.0, 6.0, 8.0))
    assertEq(thirtyTwoEcho(ThirtyTwo(0.5, -0.5, 1.0 / 0.0, -1.5)), ThirtyTwo(1.5, 0.5, 1.0 / 0.0, -0.5))
    assertEq(thirtyTwoSum(1, ThirtyTwo(1.0, 2.0, 3.0, 4.0), 0.5), 11.5)

@test("a struct of five longs, forty bytes")
forty()
    assertEq(fortyMake(1), Forty(1, 2, 3, 4, 5))
    assertEq(fortyEcho(Forty(-1, -2, -3, -4, -5)), Forty(0, -1, -2, -3, -4))
    assertEq(fortySum(0, Forty(1, 1, 1, 1, 1), 0.0), 5.0)

@test("structs and scalars in one call, past the argument registers")
manyArguments()
    val total = many(ThirtyTwo(1.0, 2.0, 3.0, 4.0), 5, Forty(1, 2, 3, 4, 5), 0.5, Sixteen(100, 0.25), Three(1, 2, byte(3)), Twelve(0.5, 0.25, 0.25))
    assertEq(total, 10.0 + 5.0 + 15.0 + 0.5 + 100.25 + 6.0 + 1.0)

@test("a value answered by one call is passed to the next, many times over")
chained()
    var v = fourMake(0)
    var s = sixteenMake(0)
    var w = fortyMake(0)
    for _ in 0..<1000
        v = fourEcho(v)
        s = sixteenEcho(s)
        w = fortyEcho(w)
    assertEq(v, Four(1000))
    assertEq(s, Sixteen(1000, 1000.125))
    assertEq(w, Forty(1000, 1001, 1002, 1003, 1004))
