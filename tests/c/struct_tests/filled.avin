// Arrays C fills: an `out T *` named with `array:`, its `length:` a C expression over the call's
// parameters evaluated before the call, the memory allocated by the binding at that length, filled by
// C, copied into a new `Array` and freed. A length of zero is an empty array, C still called; a
// negative length, or one longer than an array holds, stops the program without calling C.
import avin.threads.spawn

@c("void as_dash_set(int n)")
dashSet(n: int)

@c("int as_dash_calls(void)")
dashCalls() -> int

@c("void as_dash_get(out double *dashes, out double *offset)", array: "dashes", length: "as_dash_count()")
getDash() -> (Array[real], real)

@c("void as_dash_get(out double *dashes, out double *offset)", array: "dashes", length: "as_dash_count()", blocking)
getDashBlocking() -> (Array[real], real)

@c("void as_dash_get(out double *dashes, out double *offset)", array: "dashes", length: "as_dash_count() * 1000000000LL")
getDashHuge() -> (Array[real], real)

@c("int as_glyphs_fill(int n, out as_glyph *glyphs)", array: "glyphs", length: "n")
glyphsFill(n: int) -> Result[Array[Glyph], int]

@test("an array C fills is as long as the call before it says")
dashes()
    dashSet(3)
    val (d, offset) = getDash()
    assertEq(d.length, 3)
    assertEq(d(0), 0.5)
    assertEq(d(2), 2.5)
    assertEq(offset, 6.0)
    dashSet(1)
    val (one, o) = getDash()
    assertEq(one.length, 1)
    assertEq(o, 2.0)

@test("a length of zero is an empty array, and C is still called")
emptyDashes()
    dashSet(0)
    val before = dashCalls()
    val (d, offset) = getDash()
    assertEq(d.length, 0)
    assertEq(offset, 0.0)
    assertEq(dashCalls(), before + 1)

@test("an array of a struct mirror C fills, in a status's `Ok`, and none where it fails")
glyphs()
    glyphsFill(3) match
        Ok(g) ->
            assertEq(g.length, 3)
            assertEq(g(0), Glyph(1, 0.0, 0.0))
            assertEq(g(2), Glyph(3, 1.0, -2.0))
        Err(code) -> assert(false, s"status $code")
    assertEq(glyphsFill(2), Err(4))
    glyphsFill(0) match
        Ok(g) -> assertEq(g.length, 0)
        Err(_) -> assert(false)

@test("a blocking call fills its array while a collection may run")
blockingDashes()
    dashSet(5)
    for _ in 0..<200
        val (d, offset) = getDashBlocking()
        assertEq(d.length, 5)
        assertEq(d(4), 4.5)
        assertEq(offset, 10.0)

@test("arrays filled many times over are each their own")
manyFilled()
    var kept: Vector[Array[real]] = []
    for i in 0..<3000
        dashSet(i % 7)
        val (d, _) = getDash()
        assertEq(d.length, i % 7)
        if i % 500 == 0 then kept = kept :+ d
    assertEq(kept.length, 6)
    assertEq(kept(1).length, 500 % 7)

@test("a binding filling an array is called from a closure, a generic function and another thread")
neighbours()
    dashSet(2)
    val f = () ->
        val (d, _) = getDash()
        d.length
    assertEq(f(), 2)
    val ((a, x), (b, y)) = twice(() -> getDash())
    assertEq((a.length, x, b.length, y), (2, 4.0, 2, 4.0))
    val t = spawn(() -> glyphsFill(5).map(g -> g.length))
    assertEq(t.join(), Ok(5))

twice[T](f: () -> T) -> (T, T) = (f(), f())

@test(should_trap: "`as_dash_get` answered through `dashes` a negative length")
negativeFilledLength()
    dashSet(-1)
    getDash()

@test(should_trap: "`as_dash_get` answered through `dashes` more elements than an array holds")
hugeLength()
    dashSet(3)
    getDashHuge()
