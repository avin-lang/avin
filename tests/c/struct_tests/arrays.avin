// Arrays of struct mirrors: passed to a `const` pointer, each element converted into C's layout in
// memory that lives for the call, strings in them copied and freed; and arrays C allocates and
// answers through an `out` pointer named with `array:`, its length the C expression `length:`
// gives, copied into a new `Array` of a mirror or of a scalar and then freed by `free:`, also when a
// status says the call failed. Null is `None` for an `Option`, an empty array for a length of zero,
// and a stop for any other; a negative length stops the program too.

@c(struct: "as_glyph")
data Glyph(index: long, x: real, y: real)

@c("double as_glyphs_sum(const as_glyph *glyphs, length(glyphs) int count)")
glyphsSum(glyphs: Array[Glyph]) -> real

@c("double as_glyphs_sum(const as_glyph *glyphs, length(glyphs) int count)")
glyphsSumOr(glyphs: Option[Array[Glyph]]) -> real

@c("long long as_names_total(const as_named *names, length(names) size_t count)")
namesTotal(names: Array[Named]) -> long

@c("double as_rects_area(length(rects) size_t count, const as_rect *rects)")
rectsArea(rects: Array[Rect]) -> real

@c(
    "int as_glyphs_make(int n, out as_glyph **glyphs, out int *count)",
    array: "glyphs",
    length: "count",
    free: "as_glyphs_free"
)
glyphsMake(n: int) -> Result[(Array[Glyph], int), int]

@c(
    "void as_glyphs_answer(int n, out as_glyph **glyphs, out long *count)",
    array: "glyphs",
    length: "count",
    free: "as_glyphs_free(glyphs)"
)
glyphsAnswer(n: int) -> (Option[Array[Glyph]], long)

@c(
    "void as_glyphs_answer(int n, out as_glyph **glyphs, out long *count)",
    array: "glyphs",
    length: "count",
    free: "as_glyphs_free"
)
glyphsEmpty(n: int) -> (Array[Glyph], long)

@c("int as_glyphs_allocated(void)")
allocated() -> int

@c("int as_glyphs_freed(void)")
freed() -> int

@c(
    "void as_reals_make(int n, out double **values, out size_t *count)",
    array: "values",
    length: "count",
    free: "as_reals_free"
)
realsMake(n: int) -> (Array[real], long)

@c("void as_names_make(int n, out as_named **names, out int *count)", array: "names", length: "count * 1", free: "free")
namesMake(n: int) -> (Array[Named], int)

@c(
    "void as_bad_answer(int which, out as_point **points, out int *count)",
    array: "points",
    length: "count",
    free: "free"
)
badAnswer(which: int) -> (Array[Point], int)

@test("an array of a mirror goes to a `const` pointer, each element laid out as C's struct")
arraysIn()
  assertEq(glyphsSum(Array.fill(1, Glyph(2, 0.5, 1.0))), 2006.0)
  val glyphs = Array.tabulate(100, i -> Glyph(long(i), real(i), -1.0))
  assertEq(glyphsSum(glyphs), 4950.0 * 1000.0 + 49500.0 - 100.0)
  assertEq(glyphsSum(Array.empty()), 0.0)
  assertEq(glyphsSumOr(None), 0.0)
  assertEq(glyphsSumOr(Some(Array.fill(3, Glyph(1, 0.0, 0.0)))), 3000.0)
  assertEq(rectsArea(Array.tabulate(4, i -> Rect(Point(0.0, 0.0), Point(real(i), 2.0)))), 12.0)

@test("strings in an array of mirrors are copied for the call and freed after it")
stringsInArrays()
  val names = Array.tabulate(3, i -> Named(Some("é".repeat(i)), i, Plain, false, false))
  assertEq(namesTotal(names), 0 + 2001 + 4002)
  for _ in 0 ..< 5000
    assertEq(namesTotal(names), 6003)
  assertEq(namesTotal(Array.empty()), 0)

@test("an array C allocates is copied into an `Array` and freed, in a status's `Ok`")
arraysOut()
  val before = freed()
  glyphsMake(3) match
    Ok((glyphs, count)) ->
      assertEq(count, 3)
      assertEq(glyphs.length, 3)
      assertEq(glyphs(0), Glyph(1, 0.0, 0.0))
      assertEq(glyphs(2), Glyph(3, 1.0, -2.0))
    Err(code) -> assert(false, s"status $code")
  assertEq(freed(), before + 1)
  assertEq(allocated(), freed())

@test("an array C allocated before failing is freed unread")
failedStatus()
  val before = freed()
  assertEq(glyphsMake(-1), Err(2))
  assertEq(freed(), before + 1)
  assertEq(allocated(), freed())

@test("null is `None` for an `Option`, and an empty array for a length of zero")
nullAnswers()
  val (none, zero) = glyphsAnswer(0)
  assert(none is None)
  assertEq(zero, 0)
  val (some, n) = glyphsAnswer(2)
  assertEq(n, 2)
  assertEq(some.map(a -> a.length), Some(2))
  val (empty, m) = glyphsEmpty(0)
  assertEq(empty.length, 0)
  assertEq(m, 0)
  glyphsMake(0) match
    Ok((glyphs, count)) -> assertEq(glyphs.length + count, 0)
    Err(_) -> assert(false)
  assertEq(allocated(), freed())

@test("arrays of reals and of mirrors holding strings are copied out, the strings checked")
copiedElements()
  val (values, count) = realsMake(4)
  assertEq(count, 4)
  assertEq(values(1), 1.0 / 0.0)
  assertEq(values(3), 4.5)
  assertEq(1.0 / values(0), -1.0 / 0.0)
  val (none, zero) = realsMake(0)
  assertEq(long(none.length) + zero, 0)
  val (names, n) = namesMake(4)
  assertEq(n, 4)
  assertEq(names(1), Named(Some("plain"), 2147483647, Bold, true, true))
  assertEq(names(3), Named(Some(""), -2147483648, Plain, false, false))

@test("many arrays copied out are all freed")
manyOut()
  for i in 0 ..< 2000
    val (_, k) = glyphsAnswer(i % 5)
    assertEq(k, long(i % 5))
  assertEq(allocated(), freed())

@test(should_trap: "`as_bad_answer` answered through `points` null")
nullWithLength()
  badAnswer(0)

@test(should_trap: "`as_bad_answer` answered through `points` a negative length")
negativeLength()
  badAnswer(1)
