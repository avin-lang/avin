package { name = "c-struct-tests", version = "0.1.0" }

// The structs of avin_structs.h, in the C library the test harness builds from tests/c and names to
// `pkg-config`.
c-libraries {
  structs { pkg-config = "avin-c-fixture", headers = ["avin_structs.h"], install = "the test harness builds it from tests/c" }
}
