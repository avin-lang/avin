// Opaque values: a union and a struct with bit-fields, which no mirror holds, each a class declared
// `@c(value: …)` whose object is a copy of the C value's bytes. Bindings answer one by value and take
// one by value, a method taking it as `self`; each object is its own, compared by identity, and
// lives in collections and through many calls.

@c(value: "as_event")
class Event
  @c("int32_t as_event_to_int(as_event self)")
  toInt() -> int

  @c("float as_event_to_float(as_event self)")
  toFloat() -> real

  @c("as_event as_event_negate(as_event self)")
  negate() -> Event

  twice() -> int = toInt() * 2

@c("as_event as_event_int(int32_t i)")
eventOfInt(i: int) -> Event

@c("as_event as_event_float(float f)")
eventOfFloat(f: real) -> Event

@c("int32_t as_event_to_int(as_event self)")
intOf(e: Event) -> int

@c(value: "as_flags")
class Flags
  @c("unsigned as_flags_bits(as_flags self)")
  bits() -> long

  @c("int32_t as_flags_kind(as_flags self)")
  kind() -> int

@c("as_flags as_flags_make(int32_t kind, unsigned bits)")
flags(kind: int, bits: long) -> Flags

@test("a union answered by value is passed back by value, as a method's receiver and a parameter")
unions()
  val e = eventOfInt(42)
  assertEq(e.toInt(), 42)
  assertEq(intOf(e), 42)
  assertEq(e.twice(), 84)
  assertEq(e.negate().toInt(), -42)
  assertEq(e.toInt(), 42)
  assertEq(eventOfFloat(1.5).toFloat(), 1.5)
  assertEq(eventOfInt(-2147483648).toInt(), -2147483648)

@test("a struct with bit-fields keeps its bits")
bitFields()
  val f = flags(-7, 9)
  assertEq(f.kind(), -7)
  assertEq(f.bits(), 9 + 27)
  assertEq(flags(0, 15).bits(), 15 + 45)

@test("each value is its own object, compared by identity, and held in collections")
identity()
  val a = eventOfInt(1)
  val b = eventOfInt(1)
  assert(a === a)
  assert(!(a === b))
  val all = Vector.tabulate(1000, i -> eventOfInt(i))
  var total = 0
  for x in all
    total += x.toInt()
  assertEq(total, 499500)
