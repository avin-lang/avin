// Mirrors holding strings, enum mirrors and truth values: a string copied into C memory for the call,
// NUL-terminated and freed after it, a held NUL stopping the program; a string C answers in a field
// copied and checked as UTF-8, null `None` in an `Option[string]` and a stop in a `string`; an enum
// field crossing as its enumerator's value, a value no variant holds stopping the program; a C
// `bool` and an `int` used as one; and nesting two levels deep, by value, through `out` and `inout`.

@c(enum: "as_kind", prefix: "AS_KIND_")
data Kind
    Plain
    Bold
    Faint

@c(struct: "as_named")
data Named(name: Option[string], id: int, kind: Kind, on: bool, truth: bool)

// The same struct mirrored again, its name a `string` that is never null.
@c(struct: "as_named")
data Label(name: string, id: int, kind: Kind, on: bool, truth: bool)

// `Rect` and `Point` are the mirrors of pointers.avin.
@c(struct: "as_deep")
data Deep(bounds: Rect, tag: Named, level: i8)

@c("as_named as_named_make(int which)")
namedMake(which: int) -> Named

@c("as_named as_named_make(int which)")
labelMake(which: int) -> Label

@c("long long as_named_length(const as_named *n)")
namedLength(n: Named) -> long

@c("long long as_named_length(const as_named *n)")
labelLength(n: Label) -> long

@c("long long as_named_by_value(as_named n)")
namedByValue(n: Named) -> long

@c("as_deep as_deep_make(int which)")
deepMake(which: int) -> Deep

@c("long long as_deep_check(as_deep d)")
deepCheck(d: Deep) -> long

@c("void as_named_fill(out as_named *n, int which)")
namedFill(which: int) -> Named

@c("void as_named_rename(inout as_named *n)")
rename(n: Named) -> Named

@test("strings of every UTF-8 width, an enum mirror and truth values cross into C")
stringsIn()
    assertEq(namedLength(Named(Some("plain"), 7, Bold, true, false)), 100005007)
    assertEq(namedLength(Named(Some("aé✓😀z"), 3, Faint, false, true)), 600011003)
    assertEq(namedLength(Named(Some(""), -5, Plain, false, false)), -5)
    assertEq(namedLength(Named(None, 0, Plain, false, false)), -1)
    assertEq(labelLength(Label("plain", 7, Bold, true, false)), 100005007)
    assertEq(namedByValue(Named(Some("aé✓😀z"), 3, Faint, false, true)), 600011003)

@test("strings C answers in a field are copied, null `None`; the enum and the truth values read back")
stringsOut()
    assertEq(namedMake(0), Named(Some(""), -2147483648, Plain, false, false))
    assertEq(namedMake(1), Named(Some("plain"), 2147483647, Bold, true, true))
    assertEq(namedMake(2), Named(Some("aé✓😀z"), 2, Faint, false, true))
    assertEq(namedMake(3), Named(None, 3, Plain, true, true))
    assertEq(labelMake(1), Label("plain", 2147483647, Bold, true, true))

@test(should_trap: "the field `name` of the `Label` `as_named_make` answered null")
nullInAString()
    labelMake(3)

@test(should_trap: "the field `name` of the `Named` `as_named_make` answered a string that is not UTF-8 at byte 3")
illFormedField()
    namedMake(4)

@test(should_trap: "the field `kind` of the `Named` `as_named_make` answered a value no variant of `Kind` holds")
kindNoVariantHolds()
    namedMake(5)

@test(should_trap: "the string in the field `name` of `Named` passed to `namedLength` holds a NUL at byte 1")
heldNul()
    namedLength(Named(Some("a\0b"), 0, Plain, false, false))

@test(should_trap: "the string in the field `name` of `Label` passed to `labelLength` holds a NUL at byte 0")
heldNulFirst()
    labelLength(Label("\0", 0, Plain, false, false))

@test("a mirror two levels deep, with strings inside, by value both ways")
deep()
    val d = deepMake(1)
    assertEq(d, Deep(Rect(Point(1.0, 2.0), Point(3.0, 4.0)), Named(Some("plain"), 2147483647, Bold, true, true), i8(-127)))
    assertEq(deepCheck(d), 10 * 1000000000000 + 300005647 - 127)
    assertEq(deepCheck(Deep(Rect(Point(0.0, 0.0), Point(0.0, 1.0)), Named(Some("é"), 1, Plain, false, false), i8(127))), 1000000000000 + 2001 + 127)

@test("a mirror with strings C fills through `out`, and one it rewrites through `inout`")
namedOutAndInout()
    assertEq(namedFill(2), Named(Some("aé✓😀z"), 2, Faint, false, true))
    assertEq(rename(Named(Some("old"), 9, Bold, true, false)), Named(Some("renamed"), 10, Bold, true, false))
    assertEq(rename(Named(None, -1, Plain, false, true)), Named(Some("other"), 0, Plain, false, true))

@test("strings copied into many calls are each freed, the program's memory steady")
manyCalls()
    var total: long = 0
    for i in 0..<20000
        total += namedLength(Named(Some("x".repeat(i % 7)), i % 10, Plain, false, false))
        total += deepCheck(Deep(Rect(Point(0.0, 0.0), Point(0.0, 0.0)), Named(Some("ab"), 0, Plain, false, false), i8(0)))
    assert(total > 0)
