// The bindings every buffer test uses: a frame lending its bytes as views, by its result and through
// an out pointer, read-only and writable, and copying them; functions over blocks; and surfaces kept
// alive by C through `attach:`.
import avin.c.{ByteBlock, ByteView, MutByteView}

@c(type: "bf_frame *", release: "bf_frame_unref", retain: "bf_frame_ref")
class Frame
  @c("unsigned char *bf_frame_data(bf_frame *self)", view, writable, length: "bf_frame_size(self)")
  pixels() -> MutByteView

  @c("const unsigned char *bf_frame_cdata(bf_frame *self)", view, length: "bf_frame_size(self)")
  bytes() -> ByteView

  @c("uint8_t *bf_frame_bytes(bf_frame *self)", view, length: "bf_frame_size(self)")
  maybeBytes() -> Option[ByteView]

  @c(
      "int bf_frame_image(bf_frame *self, int fail, out uint8_t **buffer, out int *width, out int *height)",
      view: "buffer",
      length: "width * height"
  )
  image(fail: int) -> Result[(ByteView, int, int), int]

  @c(
      "int bf_frame_image(bf_frame *self, int fail, out uint8_t **buffer, out int *width, out int *height)",
      view: "buffer",
      writable,
      length: "width * height"
  )
  mutableImage(fail: int) -> Result[(MutByteView, int, int), int]

  @c("unsigned char *bf_frame_null(bf_frame *self)", view, length: "0")
  nothing() -> ByteView

  @c("unsigned char *bf_frame_null(bf_frame *self)", view, length: "4")
  nothingCounted() -> ByteView

  @c("unsigned char *bf_frame_null(bf_frame *self)", view, length: "0")
  maybeNothing() -> Option[ByteView]

  @c("unsigned char *bf_frame_null(bf_frame *self)", view, length: "4")
  maybeNothingCounted() -> Option[ByteView]

  @c("unsigned char *bf_frame_static(bf_frame *self)", view, length: "2147483647")
  widest() -> ByteView

  @c("unsigned char *bf_frame_static(bf_frame *self)", view, length: "2147483648LL")
  tooWide() -> ByteView

  @c("unsigned char *bf_frame_static(bf_frame *self)", view, length: "-1")
  negative() -> ByteView

  @c(
      "void bf_frame_copy_out(bf_frame *self, int none, out unsigned char **bytes, out int *n)",
      bytes: "bytes",
      length: "n",
      free: "free"
  )
  copied(none: int) -> (Option[Array[byte]], int)

  @c(
      "void bf_frame_copy_out(bf_frame *self, int none, out unsigned char **bytes, out int *n)",
      bytes: "bytes",
      length: "n",
      free: "free"
  )
  copiedAlways(none: int) -> (Array[byte], int)

  @c("int bf_frame_size(bf_frame *self)")
  size() -> int

  @c("long bf_frame_sum(bf_frame *self)")
  sum() -> long

  @c("int bf_frame_at(bf_frame *self, int i)")
  at(i: int) -> int

  @c("void bf_frame_replace(bf_frame *self, int size, int fill)")
  replace(size: int, fill: int)

@c("bf_frame *bf_frame_new(int size, int fill)")
newFrame(size: int, fill: int) -> Frame

@c("int bf_frames_alive(void)")
framesAlive() -> int

@c("long bf_sum(const unsigned char *bytes, length(bytes) int n)")
sumOf(bytes: ByteBlock) -> long

@c("void bf_fill(unsigned char *bytes, length(bytes) int n, unsigned char value)")
fill(bytes: ByteBlock, value: byte)

@c("int bf_peek(const uint8_t *bytes, int i)")
peek(bytes: ByteBlock, i: int) -> int

@c("int bf_is_null(const unsigned char *bytes)")
isNull(bytes: ByteBlock) -> bool

@c("void bf_fill_slowly(unsigned char *bytes, length(bytes) int n, unsigned char value, int ms)", blocking)
fillSlowly(bytes: ByteBlock, value: byte, ms: int)

// A surface over a block, which C keeps for the surface's life, by the surface's own lifetime.
@c(
    type: "bf_surface *",
    release: "bf_surface_unref",
    retain: "bf_surface_ref",
    attach: "bf_surface_set_user_data(self, key, data, destroy)",
    key: "bf_user_data_key_t"
)
class Surface
  @c("long bf_surface_sum(bf_surface *self)")
  sum() -> long

  @c("void bf_surface_paint(bf_surface *self, unsigned char value)")
  paint(value: byte)

  // Keeps a second block, by a second `keeps:` on the same surface.
  @c("long bf_surface_also(bf_surface *self, const unsigned char *other, length(other) int n)", keeps: "other")
  also(other: ByteBlock) -> long

@c("bf_surface *bf_surface_new(unsigned char *pixels, length(pixels) int n)", keeps: "pixels")
surfaceOver(pixels: ByteBlock) -> Surface

// The same surface keeping by its handle alone, with no `attach:`.
@c(type: "bf_surface *", release: "bf_surface_unref", retain: "bf_surface_ref")
class LooseSurface
  @c("long bf_surface_sum(bf_surface *self)")
  sum() -> long

@c("bf_surface *bf_surface_new(unsigned char *pixels, length(pixels) int n)", keeps: "pixels")
looseOver(pixels: ByteBlock) -> LooseSurface

// A surface whose `attach:` fails.
@c(
    type: "bf_surface *",
    release: "bf_surface_unref",
    attach: "bf_surface_refuse_user_data(self, key, data, destroy)",
    key: "bf_user_data_key_t"
)
class Refusing

@c("bf_surface *bf_surface_new(unsigned char *pixels, length(pixels) int n)", keeps: "pixels")
refusingOver(pixels: ByteBlock) -> Refusing

// A surface with `attach:` and no `key:`, keyed by a `char`.
@c(
    type: "bf_surface *",
    release: "bf_surface_unref",
    attach: "bf_surface_set_user_data(self, (const bf_user_data_key_t *)key, data, destroy)"
)
class Keyless
  @c("long bf_surface_sum(bf_surface *self)")
  sum() -> long

@c("bf_surface *bf_surface_new(unsigned char *pixels, length(pixels) int n)", keeps: "pixels")
keylessOver(pixels: ByteBlock) -> Keyless

@c("int bf_destroys(void)")
destroys() -> int

@c("int bf_surfaces_alive(void)")
surfacesAlive() -> int

// A holder taking a C reference to a surface, as a Cairo context does its target.
@c(type: "bf_holder *", release: "bf_holder_free")
class Holder
  @c("long bf_holder_sum(bf_holder *self)")
  sum() -> long

  @c("void bf_holder_paint(bf_holder *self, unsigned char value)")
  paint(value: byte)

@c("bf_holder *bf_holder_new(bf_surface *s)")
holderOf(s: Surface) -> Holder

@c("bf_holder *bf_holder_new(bf_surface *s)")
looseHolderOf(s: LooseSurface) -> Holder
