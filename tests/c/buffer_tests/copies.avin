// Bytes C answers through an out pointer, copied with `bytes:` into an `Array[byte]` that never reads
// C's memory again, `length:` evaluated after the call and `free:` freeing C's copy; null `None` in an
// `Option`, and in an array an empty one where its length is zero.

@test("`bytes:` copies the bytes into a new array, which C freeing and replacing its own does not change")
copyCopied()
  val f = newFrame(5, 250)
  val (bytes, n) = f.copied(0)
  assertEq(n, 5)
  bytes match
    Some(a) ->
      assertEq(a.length, 5)
      assertEq(a(0), byte(250))
      assertEq(a(4), byte(254))
      f.replace(5, 0)
      assertEq(a(0), byte(250))
    None -> fail("expected bytes")

@test("null bytes are `None`, and in an array an empty one with a length of zero")
copyNulls()
  val f = newFrame(5, 0)
  val (bytes, n) = f.copied(1)
  assert(bytes is None)
  assertEq(n, 0)
  val (a, m) = f.copiedAlways(1)
  assertEq(a.length, 0)
  assertEq(m, 0)

@test("an empty frame's copy is empty, and a one-byte frame's one byte")
copyEmptyAndOne()
  val (e, n) = newFrame(0, 0).copiedAlways(0)
  assertEq(e.length, 0)
  assertEq(n, 0)
  val (one, _) = newFrame(1, 77).copiedAlways(0)
  val want: Array[byte] = [byte(77)]
  assertEq(one, want)

@test(should_trap: "the `ByteView` of `Frame` was closed when `Frame` was used again")
copyCopyIsAUse()
  val f = newFrame(3, 1)
  val v = f.bytes()
  val (a, _) = f.copiedAlways(0)
  assertEq(a.length, 3)
  v(0)

@test("many copies, each freed by `free:`, under collections")
copyMany()
  val f = newFrame(1000, 3)
  var total = 0
  for i in 0 ..< 2000
    val (a, _) = f.copiedAlways(0)
    total += int(a(i % 1000))
  assert(total > 0)
