// A view belongs to the code that owns the frame that lent it, whichever carrier that code runs on: a
// lightweight thread reads a view across its own switches, a body that captures a view takes its
// frame with it, and a view used by another thread stops the program.
import avin.c.ByteView
import avin.threads.{Channel, sleep, spawn}
import avin.time


@test("a lightweight thread reads its view across switches, sleeps and collections")
threadAcrossSwitches()
    val total = spawn(() ->
        val f = newFrame(64, 1)
        val v = f.bytes()
        var sum = 0
        for i in 0..<64
            if i % 8 == 0 then sleep(1.millis)
            val junk = [i, i]
            sum += int(v(i)) + junk(0) - junk(1)
        sum).join()
    assertEq(total, 64 * 65 / 2)

@test("many threads each read their own frame's view while the others collect")
threadManyThreads()
    val threads = Vector.tabulate(8, k -> spawn(() ->
        val f = newFrame(256, k)
        val v = f.bytes()
        var sum = 0
        for round in 0..<20
            for i in 0..<256
                sum += int(v(i))
            val junk = Array.fill(1000, round)
            sum += junk(0) - junk(1)
        sum))
    for k in 0..<8
        var expected = 0
        for i in 0..<256
            expected += (k + i) % 256
        assertEq(threads(k).join(), expected * 20)

@test("a view a thread's body captures goes with its frame, and is back with its caller once the body is done")
threadHandedToThread()
    val f = newFrame(3, 4)
    val v = f.bytes()
    val got = spawn(() -> int(v(2))).join()
    assertEq(got, 6)
    assertEq(v(0), byte(4))

@test(should_trap: "the `ByteView` of `Frame` belongs to another thread")
threadOtherThread()
    val made = Channel[ByteView]()
    val done = Channel[unit]()
    spawn(() ->
        val f = newFrame(2, 0)
        made.send(f.bytes())
        done.receive())
    made.receive().get(0)
