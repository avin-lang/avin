// Views of memory a frame lends: read in place and bounds-checked, lent by the C result or through an
// out pointer, null as `None` or as an empty view, lengths up to the greatest `int` and the traps past
// them; closed by the frame's next use, whether a bound method, a status, `close()` or a method of a
// view lent later, wherever the view was kept: a local, a closure, a field, a collection.
import avin.c.{ByteView, MutByteView}

// Allocates until the collector has run several times.
churn()
    var n = 0
    for i in 0..<200000
        val v = [i, i + 1]
        n += v(1) - v(0)

@test("a view reads the bytes C lends in place, by index, from the first to the last")
viewReads()
    val f = newFrame(10, 1)
    val v = f.bytes()
    assertEq(v.length(), 10)
    assertEq(v(0), byte(1))
    assertEq(v(9), byte(10))
    var total = 0
    for i in 0..<v.length()
        total += int(v(i))
    assertEq(total, 55)

@test("bytes past 127 read as the bytes they are, and `slice` copies a range out")
viewSlices()
    val f = newFrame(256, 0)
    val v = f.bytes()
    assertEq(v(255), byte(255))
    assertEq(v(128), byte(128))
    val part = v.slice(254, 256)
    assertEq(part.length, 2)
    assertEq(part(0), byte(254))
    assertEq(part(1), byte(255))
    assertEq(v.slice(3, 3).length, 0)
    assertEq(v.slice(0, 0).length, 0)
    assertEq(v.slice(256, 256).length, 0)
    assertEq(v.slice(0, 256).length, 256)

@test("`copy` is a new array of every byte, which C replacing them does not change")
viewCopies()
    val f = newFrame(4, 7)
    val a = f.bytes().copy()
    f.replace(4, 100)
    assertEq(a.length, 4)
    assertEq(a(0), byte(7))
    assertEq(a(3), byte(10))
    assertEq(f.bytes()(0), byte(100))

@test("an empty frame lends an empty view, and a one-byte frame a view of one byte")
viewEmptyAndOne()
    val e = newFrame(0, 0)
    assertEq(e.bytes().length(), 0)
    assertEq(e.bytes().copy().length, 0)
    val one = newFrame(1, 42)
    val v = one.bytes()
    assertEq(v.length(), 1)
    assertEq(v(0), byte(42))
    assertEq(v.copy()(0), byte(42))

@test(should_trap: "index out of range")
viewIndexAtLength()
    val f = newFrame(3, 0)
    f.bytes()(3)

@test(should_trap: "index out of range")
viewIndexNegative()
    val f = newFrame(3, 0)
    f.bytes()(-1)

@test(should_trap: "index out of range")
viewIndexOfEmpty()
    val f = newFrame(0, 0)
    f.bytes()(0)

@test(should_trap: "slice out of range")
viewSlicePastEnd()
    val f = newFrame(3, 0)
    f.bytes().slice(1, 4)

@test(should_trap: "slice out of range")
viewSliceBackwards()
    val f = newFrame(3, 0)
    f.bytes().slice(2, 1)

@test(should_trap: "slice out of range")
viewSliceNegative()
    val f = newFrame(3, 0)
    f.bytes().slice(-1, 1)

@test("a view through an out pointer comes with the out values beside it, in a status's `Ok`")
viewOutPointer()
    val f = newFrame(6, 3)
    f.image(0) match
        Ok((v, w, h)) ->
            assertEq(w, 6)
            assertEq(h, 1)
            assertEq(v.length(), 6)
            assertEq(v(5), byte(8))
        Err(_) -> fail("expected Ok")

@test("a failed status lends nothing")
viewFailedStatus()
    val f = newFrame(6, 3)
    assert(f.image(5) is Err(5))
    // The failed call is a use of the frame all the same.
    assertEq(f.bytes()(0), byte(3))

@test("an empty image through an out pointer is an empty view")
viewEmptyOutPointer()
    val f = newFrame(0, 3)
    f.image(0) match
        Ok((v, w, h)) ->
            assertEq(v.length(), 0)
            assertEq(w * h, 0)
        Err(_) -> fail("expected Ok")

@test("null is `None` in an `Option`, whatever length the binding says; otherwise null with a length of zero is an empty view")
viewNulls()
    val f = newFrame(3, 0)
    assertEq(f.nothing().length(), 0)
    assert(f.maybeNothing() is None)
    assert(f.maybeNothingCounted() is None)
    f.maybeBytes() match
        Some(v) -> assertEq(v.length(), 3)
        None -> fail("expected a view")

@test(should_trap: "`bf_frame_null` answered null")
viewNullCounted()
    val f = newFrame(3, 0)
    f.nothingCounted()

@test("a view may be as long as the greatest `int`")
viewWidest()
    val f = newFrame(1, 0)
    val v = f.widest()
    assertEq(v.length(), 2147483647)
    assertEq(v(0), byte(7))

@test(should_trap: "`bf_frame_static` answered more bytes than a view holds")
viewTooWide()
    val f = newFrame(1, 0)
    f.tooWide()

@test(should_trap: "`bf_frame_static` answered a negative length")
viewNegativeLength()
    val f = newFrame(1, 0)
    f.negative()

@test(should_trap: "the `ByteView` of `Frame` was closed when `Frame` was used again")
viewClosedByMethod()
    val f = newFrame(4, 0)
    val v = f.bytes()
    f.sum()
    v(0)

@test(should_trap: "the `ByteView` of `Frame` was closed when `Frame` was used again")
viewClosedByReplace()
    val f = newFrame(4, 0)
    val v = f.bytes()
    f.replace(100000, 1)
    v(0)

@test(should_trap: "the `ByteView` of `Frame` was closed when `Frame` was used again")
viewClosedLength()
    val f = newFrame(4, 0)
    val v = f.bytes()
    f.size()
    v.length()

@test(should_trap: "the `ByteView` of `Frame` was closed when `Frame` was used again")
viewClosedCopy()
    val f = newFrame(4, 0)
    val v = f.bytes()
    f.size()
    v.copy()

@test(should_trap: "the `ByteView` of `Frame` was closed when `Frame` was used again")
viewClosedByClose()
    val f = newFrame(4, 0)
    val v = f.bytes()
    f.close()
    v(0)

@test(should_trap: "the `ByteView` of `Frame` was closed when `Frame` was used again")
viewClosedByStatus()
    val f = newFrame(4, 0)
    val v = f.bytes()
    f.image(1)
    v(0)

@test(should_trap: "the `ByteView` of `Frame` was closed when `Frame` was used again")
viewClosedByNextView()
    val f = newFrame(4, 0)
    val v = f.bytes()
    val w = f.bytes()
    assertEq(w(0), byte(0))
    v(0)

@test(should_trap: "the `ByteView` of `Frame` was closed when `Frame` was used again")
viewClosedOutPointerView()
    val f = newFrame(4, 0)
    val v = f.image(0) match
        Ok((v, _, _)) -> v
        Err(_) -> fail("expected Ok")
    f.size()
    v(0)

@test("using one frame closes none of another frame's views")
viewOtherFrame()
    val a = newFrame(2, 1)
    val b = newFrame(2, 5)
    val v = a.bytes()
    b.sum()
    b.bytes()
    assertEq(v(1), byte(2))

@test("a view's lender is not collected while the view is open, though nothing else holds it")
viewKeepsLender()
    val before = framesAlive()
    val v = newFrame(3, 9).bytes()
    churn()
    churn()
    assertEq(framesAlive(), before + 1)
    assertEq(v(2), byte(11))

@test("a frame and the views it lent are collected together once nothing holds them")
viewCollectedTogether()
    val before = framesAlive()
    for i in 0..<1000
        newFrame(16, i).bytes()
    var tries = 0
    while framesAlive() > before && tries < 50
        churn()
        tries += 1
    assertEq(framesAlive(), before)

// A view kept in a field of an object of the program's own.
class Kept(val view: ByteView)

@test("a view kept in a closure or a field reads while its frame is unused")
viewKeptOpen()
    val f = newFrame(5, 20)
    val v = f.bytes()
    val read = (i: int) -> v(i)
    val k = Kept(v)
    assertEq(read(4), byte(24))
    assertEq(k.view(0), byte(20))
    val all = [v, v]
    assertEq(all(1)(1), byte(21))

@test(should_trap: "the `ByteView` of `Frame` was closed when `Frame` was used again")
viewKeptInClosure()
    val f = newFrame(5, 20)
    val v = f.bytes()
    val read = (i: int) -> v(i)
    f.sum()
    read(0)

@test(should_trap: "the `ByteView` of `Frame` was closed when `Frame` was used again")
viewKeptInField()
    val f = newFrame(5, 20)
    val k = Kept(f.bytes())
    f.sum()
    k.view(0)

@test("a `MutByteView` is a `ByteView`, read as one")
viewMutableIsView()
    val f = newFrame(3, 1)
    val v: ByteView = f.pixels()
    assertEq(v(2), byte(3))
    assertEq(v.length(), 3)

@test(should_trap: "the `MutByteView` of `Frame` was closed when `Frame` was used again")
viewMutableClosed()
    val f = newFrame(3, 1)
    val v: ByteView = f.pixels()
    f.size()
    v(0)

@test("a view survives a collection under way while it is read")
viewReadsWhileCollecting()
    val f = newFrame(1000, 0)
    val v = f.bytes()
    var total = 0
    for i in 0..<1000
        val junk = [i, i, i]
        total += int(v(i)) + junk(0) - junk(1)
    churn()
    assertEq(total, 1000 / 256 * (255 * 256 / 2) + (1000 % 256) * (1000 % 256 - 1) / 2)
