// Writing into memory C lends through a `MutByteView`: `update`, `fill` and `write`, each bounds-checked
// at both ends, every write seen by C reading the same bytes, and the view closed by the frame's next
// use, so a write after it stops the program before it reaches memory C may have freed.
import avin.c.MutByteView

@test("`update` writes one byte where C reads it, at the first and the last")
writableUpdates()
    val f = newFrame(4, 0)
    val px = f.pixels()
    px.update(0, byte(200))
    px.update(3, byte(255))
    assertEq(px(0), byte(200))
    assertEq(px(3), byte(255))
    assertEq(f.at(0), 200)
    assertEq(f.at(3), 255)

@test("`fill` sets a range, empty, one byte or every byte")
writableFills()
    val f = newFrame(6, 0)
    val px = f.pixels()
    px.fill(2, 2, byte(9))
    px.fill(0, 6, byte(1))
    px.fill(5, 6, byte(7))
    assertEq(f.sum(), long(1 * 5 + 7))
    val g = newFrame(6, 0)
    val all = g.pixels()
    all.fill(6, 6, byte(3))
    all.fill(0, 0, byte(3))
    assertEq(g.sum(), long(0 + 1 + 2 + 3 + 4 + 5))

@test("`write` copies bytes in, ending at the last byte or writing none at the end")
writableWrites()
    val f = newFrame(5, 0)
    val px = f.pixels()
    px.write(0, [byte(9)])
    px.write(3, [byte(1), byte(2)])
    px.write(5, Array.empty[byte]())
    px.write(0, Array.empty[byte]())
    val want: Array[byte] = [byte(9), byte(1), byte(2), byte(1), byte(2)]
    assertEq(px.copy(), want)
    assertEq(f.sum(), long(15))

@test("a writable view through an out pointer writes the frame's bytes")
writableOutPointer()
    val f = newFrame(3, 0)
    f.mutableImage(0) match
        Ok((px, _, _)) -> px.fill(0, 3, byte(4))
        Err(_) -> fail("expected Ok")
    assertEq(f.sum(), long(12))

@test("a write to an empty frame's view of nothing writes nothing")
writableEmptyWrites()
    val f = newFrame(0, 0)
    val px = f.pixels()
    px.fill(0, 0, byte(1))
    px.write(0, Array.empty[byte]())
    assertEq(px.length(), 0)

@test(should_trap: "index out of range")
writableUpdateAtLength()
    newFrame(4, 0).pixels().update(4, byte(1))

@test(should_trap: "index out of range")
writableUpdateNegative()
    newFrame(4, 0).pixels().update(-1, byte(1))

@test(should_trap: "slice out of range")
writableFillPastEnd()
    newFrame(4, 0).pixels().fill(2, 5, byte(1))

@test(should_trap: "slice out of range")
writableFillBackwards()
    newFrame(4, 0).pixels().fill(3, 2, byte(1))

@test(should_trap: "slice out of range")
writableFillNegative()
    newFrame(4, 0).pixels().fill(-1, 2, byte(1))

@test(should_trap: "write out of range")
writableWriteOverEnd()
    newFrame(4, 0).pixels().write(3, [byte(1), byte(2)])

@test(should_trap: "write out of range")
writableWriteAfterEnd()
    newFrame(4, 0).pixels().write(5, Array.empty[byte]())

@test(should_trap: "write out of range")
writableWriteNegative()
    newFrame(4, 0).pixels().write(-1, [byte(1)])

@test(should_trap: "write out of range")
writableWriteIntoEmpty()
    newFrame(0, 0).pixels().write(0, [byte(1)])

@test(should_trap: "the `MutByteView` of `Frame` was closed when `Frame` was used again")
writableWriteAfterUse()
    val f = newFrame(4, 0)
    val px = f.pixels()
    px.fill(0, 4, byte(255))
    f.sum()
    px.update(0, byte(0))

@test(should_trap: "the `MutByteView` of `Frame` was closed when `Frame` was used again")
writableFillAfterReplace()
    val f = newFrame(4, 0)
    val px = f.pixels()
    f.replace(1, 0)
    px.fill(0, 4, byte(1))

@test(should_trap: "the `MutByteView` of `Frame` was closed when `Frame` was used again")
writableWriteAfterClose()
    val f = newFrame(4, 0)
    val px = f.pixels()
    f.close()
    px.write(0, [byte(1)])

@test(should_trap: "the `MutByteView` of `Frame` was closed when `Frame` was used again")
writableMutableOutPointerClosed()
    val f = newFrame(4, 0)
    val px = f.mutableImage(0) match
        Ok((px, _, _)) -> px
        Err(_) -> fail("expected Ok")
    f.size()
    px.update(0, byte(1))
