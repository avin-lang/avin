package { name = "c-buffer-tests", version = "0.1.0" }

// The frames and surfaces of avin_buffers.h, in the C library the test harness builds from tests/c and
// names to `pkg-config`.
c-libraries {
  buffers { pkg-config = "avin-c-fixture", headers = ["avin_buffers.h"], install = "the test harness builds it from tests/c" }
}
