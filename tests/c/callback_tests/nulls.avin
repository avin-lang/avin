// Function pointers marked `null`: passed null, as C allows where a library takes optional hooks
// (libssh2's allocators), each kind of pointer beside them, mixed with ordinary parameters, `out`
// values and a callback that is called.

// Every pointer passed null: two function pointers, one answering a string through a typedef, the
// `void *` beside them and an int pointer; nothing is an Avin parameter but `n`.
@c(
  "int cb_nulls(null void *(*alloc)(size_t count, void **abstract), null void (*release)(void *ptr, void **abstract), null const char *(*name)(char **into, cb_count *n), null void *abstract, int n, null int *counts, null int *next)"
)
allNull(n: int) -> int

// The same, with the last pointer an `out` value.
@c(
  "int cb_nulls(null void *(*alloc)(size_t count, void **abstract), null void (*release)(void *ptr, void **abstract), null const char *(*name)(char **into, cb_count *n), null void *abstract, int n, null int *counts, out int *next)"
)
nullsAndNext(n: int) -> (int, int)

// Names left out of the function pointer's own parameters.
@c(
  "int cb_nulls(null void *(*alloc)(size_t, void **), null void (*release)(void *, void **), null const char *(*name)(char **, cb_count *), null void *abstract, int n, null int *counts, out int *next)"
)
unnamed(n: int) -> (int, int)

// A callback C calls, with a `userdata`, beside a function pointer passed null.
@c("int cb_nulls_beside(int (*f)(userdata void *ud, int x), userdata void *ud, null void (*g)(void *ud), int x)")
beside(f: int -> int, x: int) -> int

@test("function pointers marked `null` are passed null, beside every other pointer passed null")
allPassedNull()
  assertEq(allNull(0), 31)
  assertEq(allNull(-7), 31)
  assertEq(nullsAndNext(41), (31, 42))
  assertEq(nullsAndNext(-2147483648), (31, -2147483647))
  assertEq(unnamed(0), (31, 1))

@test("a function pointer passed null sits beside a callback C calls through its `userdata`")
besideCallback()
  assertEq(beside(x -> x * 2, 21), 1042)
  var seen = 0
  see(x: int) -> int
    seen = x
    x
  assertEq(beside(see, 5), 1005)
  assertEq(seen, 5)
