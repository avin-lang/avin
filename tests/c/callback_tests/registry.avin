// Functions C keeps: a registry holds each listener it is given until its handle is given back, when
// `forget:` tells C to stop calling it, before `release`, and its record goes, exactly once. A
// `@threaded` listener is called from threads C started, each attached for the call, and from threads
// of the program; a handle C lends a callback is a handle of its own reference.
import avin.threads.{Atomic, spawn}

@c(type: "cb_registry *", release: "cb_registry_unref", retain: "cb_registry_ref", forget: "cb_registry_forget", shared)
class Registry
    @c("int cb_registry_listen(cb_registry *self, void (*listener)(userdata void *ud, int value), userdata void *ud)", keeps: "listener")
    listen(listener: int -> unit) -> int

    @c("int cb_registry_listen(cb_registry *self, void (*listener)(userdata void *ud, int value), userdata void *ud)", keeps: "listener")
    listenAnywhere(@threaded listener: int -> unit) -> int

    @c("int cb_registry_fire(cb_registry *self, int value)")
    fire(value: int) -> int

    @c("int cb_registry_fire_on_thread(cb_registry *self, int value)", blocking)
    fireOnThread(value: int) -> int

    @c("int cb_registry_listeners(const cb_registry *self)")
    listeners() -> int

    @c("int cb_registry_visit(cb_registry *self, int (*f)(userdata void *ud, cb_registry *self), userdata void *ud, int null)")
    visit(f: Registry -> int, null: int) -> int

    @c("int cb_registry_visit(cb_registry *self, int (*f)(userdata void *ud, cb_registry *self), userdata void *ud, int null)")
    visitMaybe(f: Option[Registry] -> int, null: int) -> int

// The same C object, with `forget:` written as an expression in `self` and `userdata`.
@c(type: "cb_registry *", release: "cb_registry_unref", retain: "cb_registry_ref", forget: "cb_registry_forget(self, userdata)")
class Spelled
    @c("int cb_registry_listen(cb_registry *self, void (*listener)(userdata void *ud, int value), userdata void *ud)", keeps: "listener")
    listen(listener: int -> unit) -> int

    @c("int cb_registry_fire(cb_registry *self, int value)")
    fire(value: int) -> int

@c("cb_registry *cb_registry_new(void)")
newRegistry() -> Registry

@c("cb_registry *cb_registry_new(void)")
newSpelled() -> Spelled

@c("long cb_registry_count(int what)")
count(what: int) -> long

@c("int cb_on_thread(int (*f)(userdata void *ud, int x), userdata void *ud, int x)")
onThread(@threaded f: int -> int, x: int) -> int

@c("long long cb_on_threads(int (*f)(userdata void *ud, int x), userdata void *ud, int x, int threads, int calls)")
onThreads(@threaded f: int -> int, x: int, threads: int, calls: int) -> long


// Makes `n` registries and lets go of each, every one with a listener and half with two.
makeRegistries(n: int)
    for i in 0..<n
        val r = newRegistry()
        r.listen(v -> ())
        if i % 2 == 0 then r.listen(v -> ())

// Allocates until the collector has run several times.
churn()
    var n = 0
    for i in 0..<200000
        val v = [i, i + 1]
        n += v(1) - v(0)

@test("a kept listener is called whenever C fires, and forgotten and freed once when the handle is closed")
kept()
    val before = held()
    val forgotten = count(3)
    val r = newRegistry()
    var seen = 0
    r.listen(v -> seen += v)
    r.listen(v -> seen += v * 100)
    assertEq(held(), before + 2)
    assertEq(r.listeners(), 2)
    assertEq(r.fire(3), 2)
    assertEq(seen, 303)
    assertEq(r.fire(1), 2)
    assertEq(seen, 404)
    r.close()
    assertEq(count(3), forgotten + 2)
    assertEq(held(), before)
    // Closing again forgets nothing more.
    r.close()
    assertEq(count(3), forgotten + 2)

@test("`forget:` written as an expression in `self` and `userdata` tells C the same")
spelled()
    val forgotten = count(3)
    val s = newSpelled()
    var seen = 0
    s.listen(v -> seen = v)
    s.fire(9)
    assertEq(seen, 9)
    s.close()
    assertEq(count(3), forgotten + 1)

@test("a registry the program lets go of is finalized: its listeners forgotten and their records freed, each once")
collected()
    val before = held()
    val forgotten = count(3)
    val freed = count(1)
    makeRegistries(1000)
    var tries = 0
    while count(3) < forgotten + 1500 && tries < 50
        churn()
        tries += 1
    assertEq(count(3), forgotten + 1500)
    assertEq(count(1), freed + 1000)
    assertEq(held(), before)

@test("a listener lives as long as the handle keeping it, after the code that gave it lets go")
outlives()
    val r = newRegistry()
    val total = Atomic(0)
    listenTo(r, total)
    churn()
    r.fire(2)
    r.fire(5)
    assertEq(total.load(), 7)
    r.close()

listenTo(r: Registry, total: Atomic[int])
    val words = ["a", "b"]
    r.listen(v -> total.store(total.load() + v + words.length - 2))

@test("a `@threaded` listener is called from a thread C started, attached for the call, and from the program's threads")
threadedListener()
    val r = newRegistry()
    val total = Atomic(0)
    r.listenAnywhere(v ->
        val shown = s"$v"
        total.store(total.load() + shown.byteLength() * 0 + v))
    assertEq(r.fireOnThread(4), 1)
    assertEq(total.load(), 4)
    val t = spawn(() -> r.fire(6))
    assertEq(t.join(), 1)
    assertEq(total.load(), 10)
    r.close()

@test("a `@threaded` function is called from threads C starts, many at once, each allocating")
threads()
    assertEq(onThread(x -> x * 2, 21), 42)
    val words = ["x", "yy"]
    assertEq(onThreads(x -> s"$x".byteLength() + words.length, 12345, 4, 200), 4 * 200 * 7)
    assertEq(held(), 0)

@test("a handle C lends a callback is a handle of its own, given back on its own")
lent()
    val r = newRegistry()
    assertEq(r.visit(x -> x.listeners(), 0), 0)
    var other: Option[Registry] = None
    take(x: Registry) -> int
        other = Some(x)
        0
    r.visit(take, 0)
    r.close()
    // The lent handle took a reference of its own, so the object outlives `r`.
    assertEq(other.get().listeners(), 0)
    other.get().close()
    val q = newRegistry()
    assertEq(q.visitMaybe(maybeListeners, 0), 0)
    assertEq(q.visitMaybe(maybeListeners, 1), -1)
    q.close()

maybeListeners(r: Option[Registry]) -> int = r match
    Some(x) -> x.listeners()
    None -> -1
