// Avin functions C calls back through a function pointer, found through the `userdata` beside it:
// called zero, one and many times; with every scalar kind and answering it; with strings and enum
// mirrors; by the C library's own `qsort_r` and `bsearch`; nested, a callback calling a binding that
// calls back; as lambdas, closures capturing locals, local and top-level functions, method values
// and generic functions; allocating until the collector runs during the call.

@c("long long cb_repeat(int n, int (*f)(userdata void *ud, int i), userdata void *ud)")
repeat(n: int, f: int -> int) -> long

@c("int8_t cb_i8(int8_t (*f)(userdata void *ud, int8_t x), userdata void *ud, int8_t x)")
i8(f: int -> int, x: int) -> int

@c("uint8_t cb_u8(uint8_t (*f)(userdata void *ud, uint8_t x), userdata void *ud, uint8_t x)")
u8(f: int -> int, x: int) -> int

@c("int16_t cb_i16(int16_t (*f)(userdata void *ud, int16_t x), userdata void *ud, int16_t x)")
i16(f: int -> int, x: int) -> int

@c("uint16_t cb_u16(uint16_t (*f)(userdata void *ud, uint16_t x), userdata void *ud, uint16_t x)")
u16(f: int -> int, x: int) -> int

@c("int32_t cb_i32(int32_t (*f)(userdata void *ud, int32_t x), userdata void *ud, int32_t x)")
i32(f: int -> int, x: int) -> int

@c("uint32_t cb_u32(uint32_t (*f)(userdata void *ud, uint32_t x), userdata void *ud, uint32_t x)")
u32(f: long -> long, x: long) -> long

@c("int64_t cb_i64(int64_t (*f)(userdata void *ud, int64_t x), userdata void *ud, int64_t x)")
i64(f: long -> long, x: long) -> long

@c("uint64_t cb_u64(uint64_t (*f)(userdata void *ud, uint64_t x), userdata void *ud, uint64_t x)")
u64(f: long -> long, x: long) -> long

@c("size_t cb_size(size_t (*f)(userdata void *ud, size_t x), userdata void *ud, size_t x)")
size(f: long -> long, x: long) -> long

@c("cb_count cb_typedef(cb_count (*f)(userdata void *ud, cb_count x), userdata void *ud, cb_count x)")
counted(f: int -> int, x: int) -> int

@c("double cb_double(double (*f)(userdata void *ud, double x), userdata void *ud, double x)")
double(f: real -> real, x: real) -> real

@c("float cb_float(float (*f)(userdata void *ud, float x), userdata void *ud, float x)")
float(f: real -> real, x: real) -> real

@c("bool cb_bool(bool (*f)(userdata void *ud, bool x), userdata void *ud, bool x)")
truth(f: bool -> bool, x: bool) -> bool

@c("int cb_truth(int (*f)(userdata void *ud, int x), userdata void *ud, int x)")
intTruth(f: bool -> bool, x: bool) -> bool

@c("unsigned char cb_byte(unsigned char (*f)(userdata void *ud, unsigned char x), userdata void *ud, unsigned char x)")
octet(f: byte -> byte, x: byte) -> byte

@c("void cb_void(void (*f)(userdata void *ud, int x), userdata void *ud, int x)")
each(f: int -> unit, x: int)

@c(
  "double cb_mixed(double (*f)(int a, userdata void *ud, double b, long long c, bool d), int a, double b, long long c, bool d, userdata void *ud)"
)
mixed(f: (int, real, long, bool) -> real, a: int, b: real, c: long, d: bool) -> real

@c(enum: "cb_level", prefix: "CB_")
data CLevel
  Low
  Mid
  High

@c("cb_level cb_level_of(cb_level (*f)(userdata void *ud, cb_level x), userdata void *ud, int x)")
cLevelOf(f: CLevel -> CLevel, x: int) -> CLevel

@c("int cb_string(int (*f)(userdata void *ud, const char *s), userdata void *ud, const char *s, int null)")
withString(f: string -> int, s: string, null: int) -> int

@c("int cb_string(int (*f)(userdata void *ud, const char *s), userdata void *ud, const char *s, int null)")
withMaybe(f: Option[string] -> int, s: string, null: int) -> int

@c("int cb_string(int (*f)(userdata void *ud, const char *s), userdata void *ud, const char *s, int null)")
withBytes(f: Option[Array[byte]] -> int, s: string, null: int) -> int

@c(
  "void cb_sort_ints(int *values, length(values) size_t n, int (*compare)(userdata void *ud, int a, int b), userdata void *ud)"
)
sortInts(values: Array[int], compare: (int, int) -> int)

@c(
  "long long cb_search_ints(const int *values, length(values) size_t n, int key, int (*compare)(userdata void *ud, int a, int b), userdata void *ud)"
)
searchInts(values: Array[int], key: int, compare: (int, int) -> int) -> long

@sysl("avin.rt.callbacks_held")
held() -> long

twice(x: int) -> int = x * 2

identity[T](x: T) -> T = x

ascending[T: Ord](a: T, b: T) -> int = if a < b then -1 elif a > b then 1 else 0

class Offset(by: int)
  add(x: int) -> int = x + by

@test("a callback is called as many times as C calls it: none, once and a hundred thousand")
counts()
  var calls = 0
  assertEq(repeat(0, i ->
    calls += 1
    i), 0)
  assertEq(calls, 0)
  assertEq(repeat(1, i ->
    calls += 1
    i + 41), 41)
  assertEq(calls, 1)
  assertEq(repeat(100000, i ->
    calls += 1
    i % 3), 99999)
  assertEq(calls, 100001)
  // Each record is given back when its binding returns.
  assertEq(held(), 0)

@test("every scalar kind crosses into a callback and back, at its least and greatest")
scalars()
  assertEq(i8(x -> x, -128), -128)
  assertEq(i8(x -> x + 1, 126), 127)
  assertEq(u8(x -> x, 255), 255)
  assertEq(u8(x -> x - 1, 1), 0)
  assertEq(i16(x -> x, -32768), -32768)
  assertEq(u16(x -> x, 65535), 65535)
  assertEq(i32(x -> x, -2147483648), -2147483648)
  assertEq(i32(x -> x, 2147483647), 2147483647)
  assertEq(u32(x -> x, 4294967295), 4294967295)
  assertEq(u32(x -> x, 0), 0)
  assertEq(i64(x -> x, -9223372036854775807 - 1), -9223372036854775807 - 1)
  assertEq(i64(x -> x, 9223372036854775807), 9223372036854775807)
  assertEq(u64(x -> x, 9223372036854775807), 9223372036854775807)
  assertEq(size(x -> x * 2, 21), 42)
  assertEq(counted(x -> -x, 5), -5)
  assertEq(double(x -> x * 2.0, 1.25), 2.5)
  assertEq(double(x -> x, -0.0), -0.0)
  assertEq(float(x -> x + 0.5, 1.0), 1.5)
  assertEq(float(x -> x, 0.1), real(float_round(0.1)))
  assertEq(truth(x -> !x, true), false)
  assertEq(truth(x -> x, true), true)
  assertEq(intTruth(x -> !x, false), true)
  assertEq(octet(x -> x ^ byte(255), byte(15)), byte(240))
  var seen = 0
  each(x -> seen = x, 7)
  assertEq(seen, 7)
  assertEq(mixed((a, b, c, d) -> if d then real(a) + b + real(c) else 0.0, 1, 0.5, 2, true), 3.5)

// What C makes of a `real` it is handed as a `float`, and back.
float_round(x: real) -> real = float(y -> y, x)

@test("an enum mirror crosses into a callback as its variant and back as its enumerator")
enums()
  assertEq(cLevelOf(x -> x, -1), CLevel.Low)
  assertEq(cLevelOf(x -> x, 7), CLevel.High)
  assertEq(cLevelOf(x -> if x == CLevel.Mid then CLevel.High else CLevel.Low, 0), CLevel.High)

maybeLength(s: Option[string]) -> int = s match
  Some(t) -> t.byteLength
  None -> -1

bytesLength(b: Option[Array[byte]]) -> int = b match
  Some(a) -> a.length
  None -> -1

@test("a string C calls a callback with is copied and checked, null as `None` or as no bytes")
strings()
  assertEq(withString(s -> s.byteLength, "añ€😀", 0), 10)
  assertEq(withString(s -> s.byteLength, "", 0), 0)
  assertEq(withMaybe(maybeLength, "abc", 0), 3)
  assertEq(withMaybe(maybeLength, "abc", 1), -1)
  assertEq(withBytes(bytesLength, "xyz", 0), 3)
  assertEq(withBytes(bytesLength, "xyz", 1), -1)
  // A copy outlives the call that made it.
  var kept = ""
  keep(s: string) -> int
    kept = s
    0
  withString(keep, "kept", 0)
  assertEq(kept, "kept")

@test("the C library's qsort_r and bsearch call a comparator")
librarySort()
  val values = Array.tabulate(1000, i -> (i * 7919) % 1000)
  sortInts(values, (a, b) -> a - b)
  for i in 0 ..< 1000 do assertEq(values(i), i)
  sortInts(values, (a, b) -> b - a)
  assertEq(values(0), 999)
  sortInts(values, ascending)
  assertEq(values(999), 999)
  assertEq(searchInts(values, 500, ascending), 500)
  assertEq(searchInts(values, 1000, ascending), -1)
  val empty: Array[int] = Array.empty()
  sortInts(empty, (a, b) -> a - b)
  assertEq(searchInts(empty, 1, ascending), -1)
  val one = Array.fill(1, 9)
  var compared = 0
  sortInts(one, (a, b) ->
    compared += 1
    a - b)
  assertEq(compared, 0)
  assertEq(searchInts(one, 9, ascending), 0)

@test("a comparator that allocates runs while C sorts an array in the collected heap")
sortAllocating()
  val values = Array.tabulate(300, i -> 300 - i)
  var made = 0
  sortInts(values, (a, b) ->
    val shown = s"$a" + "," + s"$b"
    made += shown.byteLength
    ascending(a, b))
  for i in 0 ..< 300 do assertEq(values(i), i + 1)
  assert(made > 0)

@test("a callback that allocates heavily, so collections run during it, keeps what it captured")
allocating()
  val words = ["alpha", "beta", "gamma"]
  val lines = Buffer[string]()
  val total = repeat(2000, i ->
    val line = s"${words(i % 3)}-$i"
    if i % 500 == 0 then lines.append(line)
    line.byteLength)
  assert(total > 0)
  assertEq(lines.toVector, ["alpha-0", "gamma-500", "beta-1000", "alpha-1500"])

@test("a callback calls a binding that calls back, nested to any depth")
nested()
  assertEq(repeat(3, i -> int(repeat(i + 1, j -> j))), 0 + 1 + 3)
  deep(n: int) -> int = if n == 0 then 1 else int(repeat(1, _ -> deep(n - 1))) + 1
  assertEq(deep(50), 51)
  assertEq(held(), 0)

@test("lambdas, closures, local and top-level functions, method values and generic functions are callbacks")
functions()
  assertEq(repeat(4, twice), 12)
  val by = 10
  assertEq(repeat(2, i -> i + by), 21)
  var counter = 0
  bump(i: int) -> int
    counter += i
    counter
  assertEq(repeat(4, bump), 0 + 1 + 3 + 6)
  assertEq(counter, 6)
  assertEq(repeat(3, Offset(100).add), 303)
  assertEq(repeat(3, identity), 3)
  assertEq(i32(identity[int], 77), 77)
  val f: int -> int = i -> i * i
  assertEq(repeat(4, f), 14)
  // A binding passing a function may be used as a value itself.
  val call: (int, int -> int) -> long = repeat
  assertEq(call(3, twice), 6)
