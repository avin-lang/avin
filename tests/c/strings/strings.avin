// Every check of a string crossing a C binding: a string holding U+0000 stops the program at the
// call, naming the parameter and the byte the NUL is at, wherever it is and in an `Option` too; a
// string C answers that is not UTF-8 stops it naming the byte the first ill-formed sequence starts
// at; and null answered where the binding's result is no `Option` stops it naming the C function.

@c("long fixture_length(const char *s)")
length(s: string) -> long
@c("long fixture_length(const char *s)")
maybeLength(s: Option[string]) -> long
@c("const char *fixture_join(const char *a, const char *b)")
join(a: Option[string], b: Option[string]) -> string
@c("const char *fixture_invalid(int which)")
invalid(which: int) -> string
@c("const char *fixture_invalid(int which)")
maybeInvalid(which: int) -> Option[string]
@c("const char *fixture_invalid(int which)")
invalidBytes(which: int) -> Array[byte]
@c("const char *fixture_maybe(int present)")
mustText(present: int) -> string
@c("const char *fixture_maybe(int present)")
mustBytes(present: int) -> Array[byte]
@c("char *fixture_maybe_copy(const char *s)", free: "fixture_free")
mustCopy(s: Option[string]) -> string
@c("char *fixture_copy(const char *s)", free: "fixture_free")
copy(s: string) -> string
@c("long fixture_allocated(void)")
allocated() -> long
@c("long fixture_freed(void)")
freed() -> long

@test("strings without a NUL cross, and valid UTF-8 comes back")
crossing()
    assertEq(length("a"), 1)
    assertEq(maybeLength(Some("é")), 2)
    assertEq(join(Some("x"), None), "x+(null)")
    assertEq(invalid(6), "€😀")
    assertEq(invalidBytes(0).length(), 3)
    assertEq(mustText(1), "present")
    assertEq(copy("c"), "c")
    assertEq(allocated(), freed())

@test(should_trap: "the string passed to `s` of `length` holds a NUL at byte 0")
nulFirst()
    length("\0")

@test(should_trap: "the string passed to `s` of `length` holds a NUL at byte 3")
nulMiddle()
    length("abc\0def")

@test(should_trap: "the string passed to `s` of `length` holds a NUL at byte 5")
nulAfterUnicode()
    length("é€\0")

@test(should_trap: "the string passed to `s` of `length` holds a NUL at byte 1")
nulLast()
    length("a\0")

@test(should_trap: "the string passed to `s` of `length` holds a NUL at byte 100000")
nulFarIn()
    length("x".repeat(100000) + "\0")

@test(should_trap: "the string passed to `s` of `maybeLength` holds a NUL at byte 2")
nulInOption()
    maybeLength(Some("ab\0"))

@test(should_trap: "the string passed to `b` of `join` holds a NUL at byte 0")
nulInSecondParameter()
    join(Some("fine"), Some("\0"))

@test(should_trap: "the string passed to `s` of `copy` holds a NUL at byte 1")
nulToFreedBinding()
    copy("a\0b")

@test(should_trap: "`fixture_invalid` answered a string that is not UTF-8 at byte 2")
invalidStart()
    invalid(0)

@test(should_trap: "`fixture_invalid` answered a string that is not UTF-8 at byte 1")
invalidTruncated()
    invalid(1)

@test(should_trap: "`fixture_invalid` answered a string that is not UTF-8 at byte 0")
invalidOverlong()
    invalid(2)

@test(should_trap: "`fixture_invalid` answered a string that is not UTF-8 at byte 2")
invalidSurrogate()
    invalid(3)

@test(should_trap: "`fixture_invalid` answered a string that is not UTF-8 at byte 0")
invalidPastMax()
    invalid(4)

@test(should_trap: "`fixture_invalid` answered a string that is not UTF-8 at byte 3")
invalidContinuation()
    invalid(5)

@test(should_trap: "`fixture_invalid` answered a string that is not UTF-8 at byte 2")
invalidInOption()
    maybeInvalid(0)

@test(should_trap: "`fixture_maybe` answered null")
nullAsString()
    mustText(0)

@test(should_trap: "`fixture_maybe` answered null")
nullAsBytes()
    mustBytes(0)

@test(should_trap: "`fixture_maybe_copy` answered null")
nullFromFreedBinding()
    mustCopy(None)
