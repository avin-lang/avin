// Arrays passed to C as pointers to their elements: an `Array[byte]` to `uint8_t *`, `char *`,
// `unsigned char *` and a typedef of a byte, an `Array[int]` to `int32_t *` and `int *`, an
// `Array[long]` to `int64_t *` and a typedef of one, an `Array[real]` to `double *` and a typedef of
// one, nothing converted; each read through a `const` pointer, and written through one that is not,
// what C wrote in the array after the call. Empty arrays, one element, every element's extremes, and
// a slice, which is an array of its own.

@c("long long aa_sum_bytes(const uint8_t *p, length(p) size_t n)")
sumBytes(p: Array[byte]) -> long

@c("long long aa_sum_chars(const char *p, length(p) int n)")
sumChars(p: Array[byte]) -> long

@c("long long aa_sum_uchars(const unsigned char *p, length(p) int n)")
sumUchars(p: Array[byte]) -> long

@c("long long aa_sum_octets(const aa_octet *p, length(p) aa_size n)")
sumOctets(p: Array[byte]) -> long

@c("long long aa_sum_ints(const int32_t *p, length(p) int n)")
sumInts(p: Array[int]) -> long

@c("long long aa_sum_plain_ints(const int *p, length(p) unsigned n)")
sumPlainInts(p: Array[int]) -> long

@c("long long aa_sum_longs(const int64_t *p, length(p) long n)")
sumLongs(p: Array[long]) -> long

@c("long long aa_sum_fixed(const aa_fixed *p, length(p) long long n)")
sumFixed(p: Array[long]) -> long

@c("double aa_sum_reals(const double *p, length(p) unsigned n)")
sumReals(p: Array[real]) -> real

@c("double aa_sum_aa_reals(const aa_real *p, length(p) size_t n)")
sumAaReals(p: Array[real]) -> real

@c("void aa_fill_bytes(uint8_t *p, length(p) size_t n, int start)")
fillBytes(p: Array[byte], start: int)

@c("void aa_fill_chars(char *p, length(p) size_t n)")
fillChars(p: Array[byte])

@c("void aa_scale_ints(int *p, length(p) size_t n, int k)")
scaleInts(p: Array[int], k: int)

@c("void aa_negate_longs(long long *p, length(p) size_t n)")
negateLongs(p: Array[long])

@c("void aa_halve_reals(double *p, length(p) size_t n)")
halveReals(p: Array[real])

@c("long long aa_sum_mutable(int *p, length(p) size_t n)")
sumMutable(p: Array[int]) -> long

@c("long long aa_last(const int64_t *p, length(p) size_t n)")
last(p: Array[long]) -> long

@test("an `Array[byte]` crosses to every pointer to a byte, nothing converted")
byteArrays()
  val b: Array[byte] = [byte(0), byte(1), byte(127), byte(128), byte(255)]
  assertEq(sumBytes(b), 511)
  assertEq(sumChars(b), 511)
  assertEq(sumUchars(b), 511)
  assertEq(sumOctets(b), 511)

@test("an `Array[int]` and an `Array[long]` cross at their extremes, as they are")
integerArrays()
  assertEq(sumInts([2147483647, -2147483647 - 1, -1]), -2)
  assertEq(sumPlainInts([2147483647, 1]), 2147483648)
  assertEq(sumLongs([9223372036854775807, -9223372036854775807]), 0)
  assertEq(sumFixed(Array.tabulate(3, i -> long(i) * 65536)), 196608)
  assertEq(last([-9223372036854775807 - 1, 9223372036854775807]), 9223372036854775807)

@test("an `Array[real]` crosses as `double`s, special values included")
realArrays()
  assertEq(sumReals([0.5, 0.25, -2.0]), -1.25)
  assertEq(sumAaReals([1.5, 2.5]), 4.0)
  val inf = sumReals(Array.fill(1, 1.0 / 0.0))
  assertEq(inf, 1.0 / 0.0)
  val nan = sumReals(Array.fill(2, 0.0 / 0.0))
  assert(nan != nan)

@test("empty arrays: C is passed a length of zero and reads nothing")
emptyArrays()
  assertEq(sumBytes(Array.empty()), 0)
  assertEq(sumInts(Array.empty()), 0)
  assertEq(sumLongs(Array.empty()), 0)
  assertEq(sumReals(Array.empty()), 0.0)
  assertEq(last(Array.empty()), -1)
  val none: Array[byte] = Array.empty()
  fillBytes(none, 3)
  assertEq(none.length, 0)

@test("arrays of one element")
oneElement()
  assertEq(sumBytes([byte(200)]), 200)
  assertEq(sumInts(Array.fill(1, -7)), -7)
  assertEq(last(Array.fill(1, 42)), 42)
  val one = Array.fill(1, 3.0)
  halveReals(one)
  assertEq(one(0), 1.5)

@test("what C writes through a pointer that is not `const` is in the array after the call")
writes()
  val b = Array.fill(4, byte(0))
  fillBytes(b, 254)
  assertEq(b.toVector, [byte(254), byte(255), byte(0), byte(1)])
  val c = Array.fill(28, byte(0))
  fillChars(c)
  assertEq(string.fromUtf8(c), Ok("abcdefghijklmnopqrstuvwxyzab"))
  val ints = Array.tabulate(4, i -> i - 1)
  scaleInts(ints, -3)
  assertEq(ints.toVector, [3, 0, -3, -6])
  val longs: Array[long] = [9223372036854775807, -5]
  negateLongs(longs)
  val negated: Vector[long] = [-9223372036854775807, 5]
  assertEq(longs.toVector, negated)
  val reals = Array.tabulate(3, i -> real(i) + 1.0)
  halveReals(reals)
  assertEq(reals.toVector, [0.5, 1.0, 1.5])
  assertEq(sumMutable(ints), -6)

@test("a slice is an array of its own, and C writes only it")
slices()
  val whole = Array.tabulate(6, i -> i)
  val part = whole.slice(2, 5)
  scaleInts(part, 10)
  assertEq(part.toVector, [20, 30, 40])
  assertEq(whole.toVector, [0, 1, 2, 3, 4, 5])
  assertEq(sumInts(whole.slice(3, 3)), 0)

@test("large arrays, read and written in place")
largeArrays()
  val n = 1000000
  val big = Array.tabulate(n, i -> i % 1000)
  assertEq(sumInts(big), 499500000)
  scaleInts(big, 2)
  assertEq(sumInts(big), 999000000)
  assertEq(big(n - 1), 1998)
  val bytes = Array.fill(n, byte(1))
  assertEq(sumBytes(bytes), long(n))
