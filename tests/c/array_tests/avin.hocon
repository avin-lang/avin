package { name = "c-array-tests", version = "0.1.0" }

// The handle classes of tests/c/handles, whose C library the test harness builds from tests/c and
// names to `pkg-config`.
dependencies {
  fixture-handles { path = "../handles" }
}

// The arrays and blocking calls of avin_arrays.h, in the same C library.
c-libraries {
  arrays { pkg-config = "avin-c-fixture", headers = ["avin_arrays.h"], install = "the test harness builds it from tests/c" }
}
