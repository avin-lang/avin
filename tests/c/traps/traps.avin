// Every checked conversion of a C binding at its boundaries: an argument one past the least or the
// greatest value of its C type stops the program, naming the C type by its sign and width, and a C
// result one past what its Avin type holds stops it naming the Avin type. The values at the
// boundaries themselves cross.

@c("signed char fixture_echo_schar(signed char)")
schar(x: long) -> long
@c("short fixture_echo_short(short)")
short(x: long) -> long
@c("int fixture_echo_int(int)")
int32(x: long) -> long
@c("int8_t fixture_echo_i8(int8_t)")
i8t(x: long) -> long
@c("int16_t fixture_echo_i16(int16_t)")
i16t(x: long) -> long
@c("int32_t fixture_echo_i32(int32_t)")
i32t(x: long) -> long
@c("unsigned char fixture_echo_uchar(unsigned char)")
uchar(x: long) -> long
@c("unsigned short fixture_echo_ushort(unsigned short)")
ushort(x: long) -> long
@c("unsigned int fixture_echo_uint(unsigned int)")
uint(x: long) -> long
@c("unsigned long fixture_echo_ulong(unsigned long)")
ulong(x: long) -> long
@c("unsigned long long fixture_echo_ullong(unsigned long long)")
ullong(x: long) -> long
@c("uint8_t fixture_echo_u8(uint8_t)")
u8t(x: long) -> long
@c("uint16_t fixture_echo_u16(uint16_t)")
u16t(x: long) -> long
@c("uint32_t fixture_echo_u32(uint32_t)")
u32t(x: long) -> long
@c("uint64_t fixture_echo_u64(uint64_t)")
u64t(x: long) -> long
@c("size_t fixture_echo_size(size_t)")
size(x: long) -> long
@c("uintptr_t fixture_echo_uintptr(uintptr_t)")
uintptr(x: long) -> long
@c("fixture_colour fixture_echo_colour(fixture_colour)")
colour(x: long) -> long
@c("enum fixture_tag fixture_echo_tag(enum fixture_tag)")
tag(x: long) -> long

// Avin integers narrower than the C type, and as wide.
@c("unsigned char fixture_echo_uchar(unsigned char)")
ucharFromI8(x: i8) -> int
@c("unsigned char fixture_echo_uchar(unsigned char)")
ucharFromI16(x: i16) -> int
@c("uint32_t fixture_echo_u32(uint32_t)")
u32FromInt(x: int) -> long
@c("unsigned short fixture_echo_ushort(unsigned short)")
ushortFromI16(x: i16) -> int

// Results wider than the Avin type, or unsigned past its greatest.
@c("unsigned long long fixture_max_ullong(void)")
maxUllong() -> long
@c("uint64_t fixture_max_u64(void)")
maxU64() -> long
@c("size_t fixture_max_size(void)")
maxSize() -> long
@c("uintptr_t fixture_max_uintptr(void)")
maxUintptr() -> long
@c("unsigned int fixture_max_uint(void)")
maxUintAsInt() -> int
@c("uint32_t fixture_max_u32(void)")
maxU32AsInt() -> int
@c("unsigned short fixture_max_ushort(void)")
maxUshortAsI16() -> i16
@c("unsigned char fixture_max_uchar(void)")
maxUcharAsI8() -> i8
@c("long fixture_min_long(void)")
minLongAsInt() -> int
@c("long fixture_max_long(void)")
maxLongAsInt() -> int
@c("short fixture_min_short(void)")
minShortAsI8() -> i8
@c("int fixture_min_int(void)")
minIntAsI16() -> i16
@c("fixture_colour fixture_max_colour(void)")
maxColourAsI8() -> i8
@c("short fixture_max_short(void)")
maxShortAsI16() -> i16
@c("unsigned char fixture_max_uchar(void)")
maxUcharAsI16() -> i16

@test("the boundaries of every width cross")
boundaries()
    assertEq(schar(-128), -128)
    assertEq(schar(127), 127)
    assertEq(short(-32768), -32768)
    assertEq(short(32767), 32767)
    assertEq(int32(-2147483648), -2147483648)
    assertEq(int32(2147483647), 2147483647)
    assertEq(i8t(-128) + i16t(32767) + i32t(-2147483648), -2147451009)
    assertEq(uchar(0) + uchar(255), 255)
    assertEq(ushort(65535), 65535)
    assertEq(uint(4294967295), 4294967295)
    assertEq(ulong(9223372036854775807), 9223372036854775807)
    assertEq(ullong(0) + u64t(0) + size(0) + uintptr(0), 0)
    assertEq(u8t(255) + u16t(65535) + u32t(4294967295), 4295033085)
    assertEq(colour(4294967295), 4294967295)
    assertEq(tag(-2147483648), -2147483648)
    assertEq(ucharFromI8(127), 127)
    assertEq(ucharFromI16(255), 255)
    assertEq(u32FromInt(2147483647), 2147483647)
    assertEq(ushortFromI16(32767), 32767)
    assertEq(maxShortAsI16(), 32767)
    assertEq(maxUcharAsI16(), 255)

@test(should_trap: "value out of range for i8 (signed char)")
scharPastMin()
    schar(-129)

@test(should_trap: "value out of range for i8 (signed char)")
scharPastMax()
    schar(128)

@test(should_trap: "value out of range for i16 (short)")
shortPastMin()
    short(-32769)

@test(should_trap: "value out of range for i16 (short)")
shortPastMax()
    short(32768)

@test(should_trap: "value out of range for i32 (int)")
intPastMin()
    int32(-2147483649)

@test(should_trap: "value out of range for i32 (int)")
intPastMax()
    int32(2147483648)

@test(should_trap: "value out of range for i8 (int8_t)")
int8PastMin()
    i8t(-129)

@test(should_trap: "value out of range for i8 (int8_t)")
int8PastMax()
    i8t(128)

@test(should_trap: "value out of range for i16 (int16_t)")
int16PastMin()
    i16t(-32769)

@test(should_trap: "value out of range for i16 (int16_t)")
int16PastMax()
    i16t(32768)

@test(should_trap: "value out of range for i32 (int32_t)")
int32PastMin()
    i32t(-2147483649)

@test(should_trap: "value out of range for i32 (int32_t)")
int32PastMax()
    i32t(2147483648)

@test(should_trap: "value out of range for u8 (unsigned char)")
ucharNegative()
    uchar(-1)

@test(should_trap: "value out of range for u8 (unsigned char)")
ucharPastMax()
    uchar(256)

@test(should_trap: "value out of range for u16 (unsigned short)")
ushortNegative()
    ushort(-1)

@test(should_trap: "value out of range for u16 (unsigned short)")
ushortPastMax()
    ushort(65536)

@test(should_trap: "value out of range for u32 (unsigned int)")
uintNegative()
    uint(-1)

@test(should_trap: "value out of range for u32 (unsigned int)")
uintPastMax()
    uint(4294967296)

@test(should_trap: "value out of range for u64 (unsigned long)")
ulongNegative()
    ulong(-1)

@test(should_trap: "value out of range for u64 (unsigned long long)")
ullongNegative()
    ullong(-9223372036854775808)

@test(should_trap: "value out of range for u8 (uint8_t)")
uint8Negative()
    u8t(-1)

@test(should_trap: "value out of range for u8 (uint8_t)")
uint8PastMax()
    u8t(256)

@test(should_trap: "value out of range for u16 (uint16_t)")
uint16PastMax()
    u16t(65536)

@test(should_trap: "value out of range for u32 (uint32_t)")
uint32PastMax()
    u32t(4294967296)

@test(should_trap: "value out of range for u32 (uint32_t)")
uint32Negative()
    u32t(-1)

@test(should_trap: "value out of range for u64 (uint64_t)")
uint64Negative()
    u64t(-1)

@test(should_trap: "value out of range for u64 (size_t)")
sizeNegative()
    size(-1)

@test(should_trap: "value out of range for u64 (uintptr_t)")
uintptrNegative()
    uintptr(-1)

@test(should_trap: "value out of range for u32 (fixture_colour)")
colourNegative()
    colour(-1)

@test(should_trap: "value out of range for i32 (enum fixture_tag)")
tagPastMax()
    tag(2147483648)

@test(should_trap: "value out of range for u8 (unsigned char)")
narrowNegativeIntoUchar()
    ucharFromI8(-1)

@test(should_trap: "value out of range for u8 (unsigned char)")
widerPastUchar()
    ucharFromI16(256)

@test(should_trap: "value out of range for u32 (uint32_t)")
sameWidthNegative()
    u32FromInt(-2147483648)

@test(should_trap: "value out of range for u16 (unsigned short)")
sameWidthNegativeShort()
    ushortFromI16(-1)

@test(should_trap: "value out of range for long")
ullongResultPastLong()
    maxUllong()

@test(should_trap: "value out of range for long")
uint64ResultPastLong()
    maxU64()

@test(should_trap: "value out of range for long")
sizeResultPastLong()
    maxSize()

@test(should_trap: "value out of range for long")
uintptrResultPastLong()
    maxUintptr()

@test(should_trap: "value out of range for int")
uintResultPastInt()
    maxUintAsInt()

@test(should_trap: "value out of range for int")
uint32ResultPastInt()
    maxU32AsInt()

@test(should_trap: "value out of range for i16")
ushortResultPastI16()
    maxUshortAsI16()

@test(should_trap: "value out of range for i8")
ucharResultPastI8()
    maxUcharAsI8()

@test(should_trap: "value out of range for int")
longResultPastIntMin()
    minLongAsInt()

@test(should_trap: "value out of range for int")
longResultPastIntMax()
    maxLongAsInt()

@test(should_trap: "value out of range for i8")
shortResultPastI8()
    minShortAsI8()

@test(should_trap: "value out of range for i16")
intResultPastI16()
    minIntAsI16()

@test(should_trap: "value out of range for i8")
colourResultPastI8()
    maxColourAsI8()
