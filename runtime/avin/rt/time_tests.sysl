module avin.rt

@test("the monotonic reading never runs backward")
monotonic_reading_is_ordered()
    val a = monotonic_micros()
    val b = monotonic_micros()
    assert(b >= a)

@test("the wall reading is after the start of 2020")
wall_reading_is_current()
    assert(wall_micros() > 1577836800000000)
