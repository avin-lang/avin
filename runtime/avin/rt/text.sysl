module avin.rt

import sysl.buf.{Buf, buf}
import sysl.raw.ptr_cast
import sysl.slices.copy
import sysl.fmt as printf
import sysl.text.{from_utf8_unchecked, parse_real}

// Avin's strings. A string is a reference to an object holding its length in bytes and then its
// UTF-8 bytes; its descriptor is in the header the collector keeps before it. A literal is a constant object the compiler emits; a string the program
// makes is allocated here, on the collected heap. A string holds no references, so the collector
// marks it and never looks inside.

/** The header of a string object. `length` bytes follow it. */
struct Text
    length: usize

/** The descriptor of the strings this runtime allocates before a program names its own: it holds no
 * references and names no type record. */
var text_descriptor: Descriptor = descriptor(0, sizeof(Text), 0)

/** The descriptor a program gives its strings, which its string literals have too: it holds no
 * references, and names the program's type record for `string` and its method table, so a string is
 * a value of the traits it implements like any other object. Null until the program names it. */
var program_text_descriptor: *Descriptor = null

/** Allocates the strings made from now on with `d`. A program names its descriptor as it starts, before
 * it makes any string or starts any thread. */
@export("avin_rt_string_descriptor")
use_text_descriptor(d: *Descriptor)
    program_text_descriptor = d

/** The length in bytes of the string at `p`. */
text_length(p: *u8) -> usize
    val t: *Text = ptr_cast(p)
    t.length

/** The first byte of the string at `p`. */
text_bytes(p: *u8) -> *u8 = ptr_cast(usize(p) + sizeof(Text))

/** The most bytes a string holds: the largest `int`, so every byte offset into one is an `int`. */
const max_text_length: usize = 2147483647

/** A new string of `length` bytes, all zero, for the caller to fill and then hand to `published`
 * before anything else sees it. A string longer than `max_text_length` stops the program, as running
 * out of memory does. */
@export("avin_rt_new_text")
new_text(ctx: *Context, length: usize) -> *u8
    if length > max_text_length
        begin_stop(ctx)
        flush()
        eprints("avin: out of memory: a string of " + length.to_string() + " bytes is longer than the most a string holds, " + max_text_length.to_string() + "\n")
        end_trapped(ctx)
    val d = if program_text_descriptor == null then &text_descriptor else program_text_descriptor
    val p = allocate_sized(ctx, d, sizeof(Text) + length)
    val t: *Text = ptr_cast(p)
    t.length = length
    p

/** `a` followed by `b`. Joining with an empty string gives back the other string itself. */
@export("avin_rt_string_concat")
concat(ctx: *Context, a: *u8, b: *u8) -> *u8
    val m = text_length(a)
    val n = text_length(b)
    if n == 0 then return a
    if m == 0 then return b
    // Allocating may collect; `a` and `b` stay alive because the caller holds them as roots, and the
    // collector never moves an object.
    val p = new_text(ctx, m + n)
    val to = text_bytes(p)
    val x = text_bytes(a)
    val y = text_bytes(b)
    for i in 0..<m do to[i] = x[i]
    for i in 0..<n do to[m + i] = y[i]
    published(p)

/** Negative, zero or positive as `a` orders before, the same as, or after `b`. Strings order by
 * their bytes, which for UTF-8 is the order of their code points, and a string orders after every
 * string it begins with. */
@export("avin_rt_string_compare")
compare(ctx: *Context, a: *u8, b: *u8) -> int
    if a == b then return 0
    val m = text_length(a)
    val n = text_length(b)
    val x = text_bytes(a)
    val y = text_bytes(b)
    val shorter = if m < n then m else n
    for i in 0..<shorter
        if x[i] != y[i] then return if x[i] < y[i] then -1 else 1
    if m < n then -1 elif m > n then 1 else 0

/** The hash of a string: FNV-1a over its bytes, so strings with equal bytes hash alike. */
@export("avin_rt_string_hash")
string_hash(ctx: *Context, a: *u8) -> u64
    val n = text_length(a)
    val x = text_bytes(a)
    var h = 0xcbf29ce484222325u64
    for i in 0..<n
        h = (h ^ u64(x[i])) *% 0x100000001b3u64
    h

/** The hash of a reference compared by identity: its address, which never changes, since the
 * collector never moves an object. */
@export("avin_rt_identity_hash")
identity_hash(ctx: *Context, a: *u8) -> u64 = u64(usize(a)) >> 4u64

/** The hash of a real: its bits, with both zeros hashing alike, as they compare equal. */
@export("avin_rt_real_hash")
real_hash(ctx: *Context, x: real) -> u64
    if x == 0.0 then return 0u64
    var copy = x
    val bits: *u64 = ptr_cast(&copy)
    *bits

/** Whether byte offset `i` of the string at `p` starts a character or ends the string: it is not
 * inside a character's encoding. */
private at_boundary(p: *u8, i: usize) -> bool = i == text_length(p) || (text_bytes(p)[i] & 192) != 128

/** The bytes of `s` from offset `from` up to `until`, which the caller has checked lie in order
 * within it; null when either offset falls inside a character. The whole string is `s` itself. */
@export("avin_rt_string_slice")
slice(ctx: *Context, s: *u8, from: int, until: int) -> *u8
    val lo = usize(from)
    val hi = usize(until)
    if !at_boundary(s, lo) || !at_boundary(s, hi) then return null
    if lo == 0 && hi == text_length(s) then return s
    // Allocating may collect; `s` stays alive because the caller holds it as a root.
    val p = new_text(ctx, hi - lo)
    val to = text_bytes(p)
    val x = text_bytes(s)
    for i in lo..<hi do to[i - lo] = x[i]
    published(p)

/** The byte offset of the first place at or after `from` where `needle` occurs in `s`, or -1. An
 * empty needle occurs at `from` itself; a `from` past the end finds nothing. */
@export("avin_rt_string_find")
find(ctx: *Context, s: *u8, needle: *u8, from: int) -> int
    val m = text_length(s)
    val n = text_length(needle)
    val start = if from < 0 then 0usize else usize(from)
    if start > m || n > m - start then return -1
    val x = text_bytes(s)
    val y = text_bytes(needle)
    if n == 0 then return int(start)
    val first = y[0]
    for i in start..<(m - n + 1)
        if x[i] != first then continue
        var j = 1usize
        while j < n && x[i + j] == y[j]
            j += 1
        if j == n then return int(i)
    -1

/** The number `s` writes, correctly rounded, or NaN when `s` is not a number or is not finite: NaN is
 * the one value a caller can tell from every number, so it is the answer for a refusal. */
@export("avin_rt_string_parse_real")
parse_real_text(ctx: *Context, s: *u8) -> real
    val n = text_length(s)
    val x = text_bytes(s)
    // A number begins at its first byte: the parser's leading white space is not accepted.
    if n > 0 && x[0] <= 32 then return real.nan()
    var b: Buf[u8] = buf()
    for i in 0..<n
        // Only decimal is read; the parser's hexadecimal form is told by its `x`.
        if x[i] == u8('x') || x[i] == u8('X') then return real.nan()
        b.push(x[i])
    val parsed = parse_real(b.view())
    if parsed is Err(_) then return real.nan()
    val v = parsed.unwrap()
    if v - v != 0.0 then real.nan() else v

/** `s` written `count` times over; `count` is not negative. Once is `s` itself. */
@export("avin_rt_string_repeat")
repeat(ctx: *Context, s: *u8, count: int) -> *u8
    if count == 1 then return s
    val m = text_length(s)
    val k = usize(count)
    val p = new_text(ctx, m * k)
    val to = text_bytes(p)
    val x = text_bytes(s)
    for r in 0..<k
        for i in 0..<m do to[r * m + i] = x[i]
    published(p)

/** A new string holding the bytes of `s`. */
text_of(ctx: *Context, s: string) -> *u8
    val p = new_text(ctx, s.bytes.len)
    val to = text_bytes(p)
    copy(to[0..<s.bytes.len], s.bytes)
    published(p)

// Rendering a built-in value as text, for its `Display`.

/** The decimal digits of an integer of at most 64 bits, with a sign when it is negative. */
@export("avin_rt_render_int")
render_int(ctx: *Context, value: long) -> *u8 = text_of(ctx, value.to_string())

/** The shortest decimal form that reads back as the same real. */
@export("avin_rt_render_real")
render_real(ctx: *Context, value: real) -> *u8 = text_of(ctx, value.to_string())

/** A real under a format conversion: `conversion` is `f`, `e`, `g`, `E` or `G`; `flags` holds a bit
 * for each flag written, 1 for `-`, 2 for `+`, 4 for a space, 8 for `0` and 16 for `#`; `width` is the
 * field's least width, 0 for none, and `precision` the count of digits, negative for the
 * conversion's default. The digits are the exact value's, rounded half to even. */
@export("avin_rt_format_real")
format_real(ctx: *Context, value: real, conversion: char, flags: int, width: int, precision: int) -> *u8
    var spec = "%"
    if flags & 1 != 0 then spec = spec + "-"
    if flags & 2 != 0 then spec = spec + "+"
    if flags & 4 != 0 then spec = spec + " "
    if flags & 8 != 0 then spec = spec + "0"
    if flags & 16 != 0 then spec = spec + "#"
    text_of(ctx, printf.format_real(value, spec + "*.*" + conversion.to_string(), width, precision))

/** The character itself. */
@export("avin_rt_render_char")
render_char(ctx: *Context, value: char) -> *u8 = text_of(ctx, value.to_string())

/** The length of a string in bytes. */
@export("avin_rt_text_size")
text_size(ctx: *Context, text: *u8) -> long = long(text_length(text))

/** The number of characters in a string: its bytes that do not continue a UTF-8 sequence. */
@export("avin_rt_text_width")
text_width(ctx: *Context, text: *u8) -> long
    val data = text_bytes(text)
    var n: long = 0
    for i in 0..<text_length(text)
        if data[i] & 0xC0 != 0x80 then n += 1
    n

// A string writer keeps what has been written in a string object of its own, the storage, whose
// length is its capacity; only the first `used` bytes are text. The writer never hands its storage
// out, so filling it in place is seen by nothing else. An empty storage, such as the constant `""`
// a writer starts with, has no room, so a constant is never written to.

/** The storage holding the `used` bytes of `store` followed by `text`: `store` itself when it has
 * room, or else a new storage of twice the size needed so far. */
@export("avin_rt_text_append")
text_append(ctx: *Context, store: *u8, used: long, text: *u8) -> *u8
    val n = text_length(text)
    val at = usize(used)
    var target = store
    if at + n > text_length(store)
        var room = text_length(store) * 2
        if room < 32 then room = 32
        while room < at + n do room = room * 2
        // Allocating may collect; `store` and `text` stay alive because the caller holds them as
        // roots, and the collector never moves an object.
        target = new_text(ctx, room)
        val from = text_bytes(store)
        val to = text_bytes(target)
        for i in 0..<at do to[i] = from[i]
    val to = text_bytes(target)
    val bytes = text_bytes(text)
    for i in 0..<n do to[at + i] = bytes[i]
    target

/** A new string holding the first `used` bytes of the storage `store`. */
@export("avin_rt_text_take")
text_take(ctx: *Context, store: *u8, used: long) -> *u8
    val n = usize(used)
    val p = new_text(ctx, n)
    val from = text_bytes(store)
    val to = text_bytes(p)
    for i in 0..<n do to[i] = from[i]
    published(p)

/** A string as the literal that writes it: in double quotes, with each quote, backslash and control
 * character escaped. */
@export("avin_rt_quote_text")
quote_text(ctx: *Context, text: *u8) -> *u8
    var out: Buf[u8] = buf()
    val data = text_bytes(text)
    quote_bytes(&out, data[0..<text_length(text)], 34)
    text_of(ctx, from_utf8_unchecked(out.view()))

/** A character as the literal that writes it: in single quotes, escaped as in a string. */
@export("avin_rt_quote_char")
quote_char(ctx: *Context, value: char) -> *u8
    var out: Buf[u8] = buf()
    quote_bytes(&out, value.to_string().bytes, 39)
    text_of(ctx, from_utf8_unchecked(out.view()))

// `data` between two `quote` bytes, with the quote, the backslash and the control characters
// escaped: `\n`, `\t`, `\r`, `\0` by name, and the others as `\u{…}` in hex.
private quote_bytes(out: *Buf[u8], data: []const u8, quote: u8)
    val hex = "0123456789abcdef".bytes
    out.push(quote)
    for i in 0..<data.len
        val b = data[i]
        if b == quote || b == 92
            out.push(92)
            out.push(b)
        elif b == 10
            out.push(92)
            out.push(u8('n'))
        elif b == 9
            out.push(92)
            out.push(u8('t'))
        elif b == 13
            out.push(92)
            out.push(u8('r'))
        elif b == 0
            out.push(92)
            out.push(u8('0'))
        elif b < 32 || b == 127
            out.push(92)
            out.push(u8('u'))
            out.push(u8('{'))
            out.push(hex[b >> 4])
            out.push(hex[b & 15])
            out.push(u8('}'))
        else out.push(b)
    out.push(quote)
