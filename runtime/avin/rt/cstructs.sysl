module avin.rt

// Structs crossing a C binding. A struct mirror's value is converted into C memory off the collected
// heap, laid out as the header lays the struct out, which lives for one call: C reads it through a
// pointer, or the glue the call goes through passes it by value, and C writes the struct it fills or
// answers into memory of the same kind, which the binding reads its mirror's value out of.

private extern "calloc" struct_calloc(count: usize, size: usize) -> *u8
private extern "free" struct_free(p: *u8) -> unit

/** `size` bytes off the heap, every one zero, for the structs of one call of a C binding; at least
 * one, so an empty struct's memory is never null. */
@export("avin_rt_c_struct_new")
c_struct_new(ctx: *Context, size: i64) -> *u8
    val p = struct_calloc(if size <= 0 then 1 else usize(size), 1)
    if p == null
        flush()
        eprints("avin: out of memory: no room for " + size.to_string() + " bytes of structs passed to C\n")
        trap()
    p

/** Frees memory `c_struct_new` made, once the call it was made for has returned; null is nothing. */
@export("avin_rt_c_struct_free")
c_struct_free(ctx: *Context, p: *u8)
    if p != null then struct_free(p)
