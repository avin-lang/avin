module avin.rt

import sysl.fs.IoError
import sysl.io.wait.{Readable, Writable, ready}
import sysl.net.{Address, Ipv6, UdpSocket, ipv4, ipv6, would_block}
import sysl.slices.copy
import sysl.time.micros

// UDP sockets that wait without holding a worker, as every socket `avin.net` makes does: a datagram
// socket is non-blocking, and a send or a receive that would have to wait waits for its descriptor on
// the runtime's poller (`sockets.sysl`), a lightweight thread parked, any other thread waiting on the
// descriptor alone. And the conversions between `avin.net`'s `IpAddress` and `sysl.net`'s `Address`.

/** The largest UDP datagram's payload over IPv6 without jumbograms, and so the most bytes one receive
 * needs room for: a datagram's length field is sixteen bits. */
const DatagramMost: int = 65535

/** Makes `s` non-blocking, as every socket the runtime waits on is. */
udp_non_blocking(s: UdpSocket) -> Result[unit, IoError]
    var c = s
    c.non_blocking(true)

/** Sends `bytes` to `to` as one datagram, waiting for room where there is none; a wait longer than
 * `limit_ms` milliseconds, where it is positive, fails as timed out. */
udp_send_to(s: UdpSocket, bytes: []const u8, to: Address, limit_ms: int) -> Result[unit, IoError]
    var c = s
    loop
        c.send_to(bytes, to) match
            Ok(_) -> return Ok(())
            Err(e) if would_block(e) ->
                if !wait_for_fd(c.fd()?, Writable, limit_ms)? then return Err(timed_out_error())
            Err(e) -> return Err(e)

/** Sends `bytes` as one datagram to where `s` is connected, waiting as `udp_send_to` does. */
udp_send(s: UdpSocket, bytes: []const u8, limit_ms: int) -> Result[unit, IoError]
    var c = s
    loop
        c.send(bytes) match
            Ok(_) -> return Ok(())
            Err(e) if would_block(e) ->
                if !wait_for_fd(c.fd()?, Writable, limit_ms)? then return Err(timed_out_error())
            Err(e) -> return Err(e)

/** The next datagram to arrive at `s` and who sent it, waiting for one; a wait longer than `limit_ms`
 * milliseconds, where it is positive, fails as timed out. At most `room` bytes of it are answered,
 * `room` being from 1 to one more than `DatagramMost`: a caller that wants `max` asks for `max + 1`,
 * and an answer longer than `max` says the datagram was longer than `max`, the platform having thrown
 * the rest away. The bytes are received into the carrier's buffer, as a stream's are
 * (`socket_receive`), and copied out at their length. */
udp_receive_from(s: UdpSocket, room: int, limit_ms: int) -> Result[([]u8, Address), IoError]
    val want = usize(if room > DatagramMost + 1 then DatagramMost + 1 elif room < 1 then 1 else room)
    var c = s
    loop
        datagram_now(&c, want)? match
            Some(got) -> return Ok(got)
            None -> if !wait_for_fd(c.fd()?, Readable, limit_ms)? then return Err(timed_out_error())

/** One try at receiving a datagram into `want` bytes of room without waiting, as `receive_now` tries a
 * stream: nothing in it can switch the thread to another carrier, and the view of the carrier's buffer
 * ends with it. */
private datagram_now(c: *UdpSocket, want: usize) -> Result[Option[([]u8, Address)], IoError]
    val ctx = current_context
    val k = if ctx == null then null else ctx.carrier
    var own: []u8 = []
    if k == null
        own = [0; want]
    elif k.receiving.len < want
        k.receiving = [0; want]
    val room: []u8 = if k == null then own[0..<want] else k.receiving[0..<want]
    c.recv_from(room) match
        Ok((n, from)) ->
            var out: []u8 = [0; n]
            copy(out, room[0..<n])
            Ok(Some((out, from)))
        Err(e) if would_block(e) -> Ok(None)
        Err(e) -> Err(e)

/** Whether a receive on `s` would answer without waiting: a datagram has arrived, or the socket has
 * failed. One whose readiness cannot be read counts as readable, so the receive that follows answers
 * why. */
udp_readable(s: UdpSocket) -> bool
    var c = s
    val fd = c.fd() match
        Ok(d) -> d
        Err(_) -> return true
    ready(fd, Readable, micros(0)) match
        Ok(b) -> b
        Err(_) -> true

/** Whether a send on `s` would go without waiting, as `udp_readable` says of a receive. */
udp_writable(s: UdpSocket) -> bool
    var c = s
    val fd = c.fd() match
        Ok(d) -> d
        Err(_) -> return true
    ready(fd, Writable, micros(0)) match
        Ok(b) -> b
        Err(_) -> true

/** The address of `octets`, four bytes for IPv4 or sixteen for IPv6, at `port`; `scope` is the
 * interface an IPv6 one is scoped to, zero for none. */
ip_address(octets: []const u8, scope: int, port: int) -> Address
    val p = u16(port)
    if octets.len == 4 then return ipv4(octets[0], octets[1], octets[2], octets[3], p)
    var groups: [8]u16 = [0; 8]
    for i in 0..<8 do groups[i] = (u16(octets[2 * i]) << 8) | u16(octets[2 * i + 1])
    ipv6(groups, p, u32(scope))

/** The bytes of `a`'s address, the most significant first: four of an IPv4 one, sixteen of an IPv6. */
address_octets(a: Address) -> []u8
    val o = a.octets()
    val n: usize = if a.family() == Ipv6 then 16 else 4
    var out: []u8 = [0; n]
    for i in 0..<n do out[i] = o[i]
    out
