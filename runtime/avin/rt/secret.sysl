module avin.rt

import sysl.buf.{Buf, buf}
import sysl.fs.from_errno
import sysl.io.wait.Readable
import sysl.slices.{as_mut_ptr, as_ptr}

// A line read from the controlling terminal with what is typed not shown, for a password or a
// passphrase. The terminal is `/dev/tty` rather than standard input, so a program whose input is a
// pipe can still ask, as `sudo` and `ssh` do. The prompt is written to the terminal too.
//
// The terminal's echo is off for the length of the read, its line editing stays on, and its settings
// are put back exactly as they were found whichever way the read ends (`__posix__/secret_tty.c`
// also puts them back when a signal is about to end the program). A line is at most what the
// terminal itself keeps of one: 1023 bytes on macOS, 4095 on Linux.
//
// Standard input and this read are never at the terminal at once: the read holds `input_readers`, the
// lock every reader of standard input holds, so a thread reading either waits for the other.

/** Why a secret could not be read, as `avin.io` tells the failures apart. */
enum SecretFailure
    NoTty
    Ended
    Signalled
    Failed(message: string)

private extern "avin_rt_secret_open" c_secret_open() -> i32
private extern "avin_rt_secret_close" c_secret_close(fd: i32) -> unit
private extern "avin_rt_secret_hide" c_secret_hide(fd: i32) -> i32
private extern "avin_rt_secret_restore" c_secret_restore(fd: i32) -> unit
private extern "avin_rt_secret_write" c_secret_write(fd: i32, p: *u8, n: i64) -> i32
private extern "avin_rt_secret_read" c_secret_read(fd: i32, p: *u8, n: i64) -> i64

/** How many bytes one read of the terminal asks for. */
const secret_chunk: usize = 1024

/** The failure an errno stands for. A process with no controlling terminal has no `/dev/tty` to open
 * (ENXIO, ENOENT, ENODEV) or one that is not a terminal (ENOTTY). */
private secret_failure(code: i64) -> SecretFailure
    if code == 2 || code == 6 || code == 19 || code == 25 then return NoTty
    Failed(from_errno(int(code)).message())

/** Waits until the terminal has a line to read, for a lightweight thread, which parks on the poller
 * and leaves its worker to the others. A terminal the poller cannot take leaves the wait to the read,
 * which blocks the worker. The wait is no cancellation point, as standard input's is not. */
private await_terminal(ctx: *Context, fd: i32)
    if ctx == null || !runs_lightweight(ctx) then return
    ctx.uncancellable += 1
    _ = wait_for_fd(int(fd), Readable, 0)
    ctx.uncancellable -= 1

/** Reads one line from the terminal at `fd`, with the prompt written first: the bytes of the line
 * without their `\n` and without a `\r` before it. The end of input before any byte is a failure; one
 * after some is the end of the line. */
private ask(ctx: *Context, fd: i32, prompt: string) -> Result[[]u8, SecretFailure]
    val said = prompt.bytes
    if said.len > 0
        val w = c_secret_write(fd, as_ptr(said), i64(said.len))
        if w < 0 then return Err(secret_failure(i64(-w)))
    var line: Buf[u8] = buf()
    var chunk: []u8 = [0; secret_chunk]
    var ended = false
    while !ended
        await_terminal(ctx, fd)
        if ctx != null then enter_safe(ctx)
        val n = c_secret_read(fd, as_mut_ptr(chunk), i64(secret_chunk))
        if ctx != null then leave_safe(ctx)
        // EINTR: a signal the program survived. EIO: the terminal's other end went away.
        if n == -4 then return Err(Signalled)
        // Stopped and continued: the terminal is hidden again, and the user is asked again.
        if n == -4097
            if said.len > 0
                val again = c_secret_write(fd, as_ptr(said), i64(said.len))
                if again < 0 then return Err(secret_failure(i64(-again)))
            continue
        if n == -5 || n == 0
            ended = true
        elif n < 0
            return Err(secret_failure(-n))
        else
            var i: usize = 0
            while i < usize(n)
                line.push(chunk[i])
                i += 1
            if chunk[usize(n) - 1] == 10 then ended = true
    var have = line.len()
    if have == 0 then return Err(Ended)
    if line[have - 1] == 10
        have -= 1
        if have > 0 && line[have - 1] == 13 then have -= 1
    var out: []u8 = [0; have]
    var i: usize = 0
    while i < have
        out[i] = line[i]
        i += 1
    // What was typed does not stay behind in the buffers used to gather it.
    i = 0
    while i < line.len()
        line[i] = 0
        i += 1
    i = 0
    while i < chunk.len
        chunk[i] = 0
        i += 1
    Ok(out)

/** The secret read, the lock over standard input held. The terminal is put back and closed on every
 * path out of `ask`. The newline the user's Enter did not echo is written once the echo is back. */
private read_secret_held(ctx: *Context, prompt: string) -> Result[[]u8, SecretFailure]
    if ctx != null then flush_safely(ctx)
    val fd = c_secret_open()
    if fd < 0 then return Err(secret_failure(i64(-fd)))
    val hid = c_secret_hide(fd)
    if hid < 0
        c_secret_close(fd)
        return Err(secret_failure(i64(-hid)))
    val answer = ask(ctx, fd, prompt)
    c_secret_restore(fd)
    val newline: []u8 = [10]
    _ = c_secret_write(fd, as_ptr(newline), 1)
    c_secret_close(fd)
    answer

/** `avin.io.readSecretBytes`: one line from the controlling terminal with echo off, after `prompt`.
 * A trap while the lock over standard input is held is not contained, as one holding any other lock
 * is not. */
read_secret(prompt: string) -> Result[[]u8, SecretFailure]
    val ctx = current_context
    if ctx == null then return read_secret_held(ctx, prompt)
    input_hold(ctx)
    val answer = read_secret_held(ctx, prompt)
    input_release(ctx)
    answer
