module avin.rt

import sysl.raw.ptr_cast
import sysl.sync.*
import sysl.threads.{SleepLock, Thread, spawn}

// The threads a program starts. Each runs a closure the program hands `avin_rt_thread_start`, with a
// context of its own that is attached before the thread exists, so the closure is a root of every
// collection from the moment the program lets go of it until the thread has finished with it. What a
// thread is joined by is an object on the collected heap, so it lives as long as the program can reach
// the thread and no longer.

// The storage of a started thread's context, which keeps itself alive until the thread ends. Its
// context's stack begins with `root`, a frame of two slots: the closure the thread runs, and its
// joint, the object it is joined by.
private struct Started
    context: Context
    root: Frame
    run: *u8
    joint: *u8
    /** The program's closure runner, which calls `run` with the program's own convention. */
    runner: *u8
    me: Option[&Started]

@assert(offsetof(Started, context) == 0, "a started thread's context is the start of its storage")
@assert(offsetof(Started, run) == offsetof(Started, root) + sizeof(Frame), "a frame's slots follow its header")

// The payload of a joint: the operating system's thread, and whether it has been waited for. `lock`
// makes one waiter wait for the thread and every other wait for that one.
private struct Joint
    thread: Thread
    lock: SleepLock
    joined: bool

/** The descriptor of a joint. It holds no reference and names no type record: the library keeps it as
 * an opaque `Any` and never asks its type. */
var joint_descriptor: Descriptor = descriptor(0, sizeof(Joint), 0)

/** Starts a thread running `run`, a closure that takes nothing and returns nothing, on a stack of
 * `stack` bytes, and gives back the object the thread is joined by. `ctx` is the calling thread's.
 * `runner` is the program's closure runner: a function the C convention calls with a context and a
 * closure, which runs the closure. */
@export("avin_rt_thread_start")
thread_start(ctx: *Context, run: *u8, stack: long, runner: *u8) -> *u8
    val s: &Started = Started(new_context(), Frame(null, 2), run, null, runner, None)
    s.me = Some(s)
    val p: *Started = ptr_cast(&*s)
    // The new thread's frame is the caller's top frame until the thread's context is attached, so the
    // closure and the joint are roots while the joint is allocated and the heap lock is awaited.
    p.root.prev = ctx.top
    ctx.top = &p.root
    p.joint = allocate(ctx, &joint_descriptor)
    lock_heap(ctx)
    ctx.top = p.root.prev
    p.root.prev = null
    p.context.top = &p.root
    p.context.next = contexts
    contexts = &p.context
    heap_lock.unlock()
    // The thread may run, finish and give its storage back before `spawn` returns, so nothing of it is
    // read after.
    val joint = p.joint
    val j: *Joint = ptr_cast(joint)
    j.lock = SleepLock.new()
    j.joined = false
    val arg: *u8 = ptr_cast(p)
    j.thread = spawn(&run_started, arg, usize(stack)) match
        Some(t) -> t
        None -> cannot_start(ctx)
    joint

private cannot_start(ctx: *Context) -> never
    begin_stop(ctx)
    eprints("avin: cannot start a thread: the system refused one\n")
    trap()

// The body of every started thread. It waits for any collection in progress, runs the closure through
// the program's runner, and detaches, giving its storage back. The closure's own code has the
// program's calling convention, not the C one, so it is never called from here directly.
private run_started(arg: *u8) -> unit
    val p: *Started = ptr_cast(arg)
    val c = &p.context
    install_stack_guard()
    leave_safe(c)
    val entry: *extern(*Context, *u8) -> unit = ptr_cast(p.runner)
    entry(c, p.run)
    remove_stack_guard()
    detach(c)
    p.me = None

/** Waits until the thread `joint` was given back for has finished. The calling thread is safe while
 * it waits, so it holds up no collection; a second wait for the same thread returns at once. */
@export("avin_rt_thread_join")
thread_join(ctx: *Context, joint: *u8)
    val j: *Joint = ptr_cast(joint)
    enter_safe(ctx)
    j.lock.lock()
    if !j.joined
        _ = j.thread.join()
        j.joined = true
    j.lock.unlock()
    leave_safe(ctx)

/** The calling thread's identity while it runs: its context's address. */
@export("avin_rt_thread_current")
thread_current(ctx: *Context) -> long = long(usize(ctx))

// Taken by the first thread that stops the program and never given back, so a thread that traps while
// another is already stopping it waits for the end instead of reporting a second time.
private var stopping: SleepLock = SleepLock.new()

/** Begins stopping the program from `ctx`'s thread. The first thread to call it returns, and goes on
 * to flush and report; any other is marked safe and waits until the process ends. */
begin_stop(ctx: *Context)
    if stopping.try_lock() then return
    enter_safe(ctx)
    loop
        stopping.lock()
