module avin.rt

import sysl.raw.ptr_cast
import sysl.sync.*
import sysl.fiber
import sysl.threads.SleepLock

// The threads a program starts, each a lightweight thread (`scheduler.sysl`) running a closure the
// program hands `avin_rt_thread_start`, with a context of its own that is attached before the thread
// is ready, so the closure is a root of every collection from the moment the program lets go of it
// until the thread has finished with it. What a thread is joined by is an object on the collected
// heap, so it lives as long as the program can reach the thread and no longer.

// The payload of a joint: whether the thread has ended, and the threads waiting for it to.
private struct Joint
    waiting: WaitQueue
    done: bool

/** The descriptor of a joint. It holds no reference and names no type record: the library keeps it as
 * an opaque `Any` and never asks its type. */
var joint_descriptor: Descriptor = descriptor(0, sizeof(Joint), 0)

/** Starts a lightweight thread running `run`, a closure that takes nothing and returns nothing, on a
 * stack of `stack` bytes, reserved and committed as it is touched, and gives back the object the
 * thread is joined by. A stack under `LeastStack` is given `LeastStack`. `ctx` is the calling
 * thread's. `runner` is the program's closure runner: a function the C convention calls with a
 * context and a closure, which runs the closure. */
@export("avin_rt_thread_start")
thread_start(ctx: *Context, run: *u8, stack: long, runner: *u8) -> *u8
    val size: usize = if stack < LeastStack then usize(LeastStack) else usize(stack)
    val s: &Lwt = Lwt(new_context(), Frame(null, 2), run, null, runner, fiber.Context.new(), None, size, null, null, None)
    s.me = Some(s)
    val p: *Lwt = ptr_cast(&*s)
    // The new thread's frame is the caller's top frame until the thread's context is attached, so the
    // closure and the joint are roots while the joint is allocated and the heap lock is awaited.
    p.root.prev = ctx.top
    ctx.top = &p.root
    p.joint = allocate(ctx, &joint_descriptor)
    val j: *Joint = ptr_cast(p.joint)
    *j = Joint(new_wait_queue(), false)
    val st = take_stack(size) match
        Some(st) -> st
        None -> cannot_start(ctx)
    p.size = st.len()
    p.fiber = fiber.Context.start(st, &lwt_entry, p)
    p.stack = Some(st)
    lock_heap(ctx)
    ctx.top = p.root.prev
    p.root.prev = null
    p.context.top = &p.root
    link_context(&p.context)
    heap_lock.unlock()
    // The thread may run, finish and give its storage back before this returns, so nothing of it is
    // read after.
    val joint = p.joint
    start_lightweight(p)
    joint

private cannot_start(ctx: *Context) -> never
    begin_stop(ctx)
    eprints("avin: cannot start a thread: the system refused one\n")
    trap()

/** Marks the thread `joint` was given back for as ended, and wakes every thread waiting for it. */
joint_finished(joint: *u8)
    val j: *Joint = ptr_cast(joint)
    j.waiting.guard.lock()
    j.done = true
    wake_all(&j.waiting)
    j.waiting.guard.unlock()

/** Waits until the thread `joint` was given back for has ended. A lightweight thread parks; any other
 * blocks, safe for the collector. A second wait for the same thread returns at once. */
@export("avin_rt_thread_join")
thread_join(ctx: *Context, joint: *u8)
    val j: *Joint = ptr_cast(joint)
    j.waiting.guard.lock()
    if j.done
        j.waiting.guard.unlock()
        return
    val w = waiter_of(ctx)
    var r = Holding(Frame(ctx.top, 1), joint, null)
    ctx.top = &r.frame
    enqueue(&j.waiting, w)
    _ = wait_on(ctx, &j.waiting, w, 0)
    ctx.top = r.frame.prev

/** The calling thread's identity while it runs: its context's address. */
@export("avin_rt_thread_current")
thread_current(ctx: *Context) -> long = long(usize(ctx))

// Taken by the first thread that stops the program and never given back, so a thread that traps while
// another is already stopping it waits for the end instead of reporting a second time.
private var stopping: SleepLock = SleepLock.new()

/** Begins stopping the program from `ctx`'s thread. The first thread to call it returns, and goes on
 * to flush and report; any other is marked safe and waits until the process ends. */
begin_stop(ctx: *Context)
    if stopping.try_lock() then return
    enter_safe(ctx)
    loop
        stopping.lock()

/** Whether a thread has begun stopping the program. */
stopping_now() -> bool
    if stopping.try_lock()
        stopping.unlock()
        return false
    true

/** Waits, safe for the collector, until the program another thread is stopping has ended. */
wait_for_end(ctx: *Context) -> never
    enter_safe(ctx)
    loop
        stopping.lock()

/** Begins stopping the program from a thread with no context, as `begin_stop` does: the first
 * thread to stop it returns, and any other waits until the process ends. */
begin_stop_foreign()
    if stopping.try_lock() then return
    loop
        stopping.lock()
