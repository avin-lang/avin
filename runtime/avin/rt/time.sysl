module avin.rt

import sysl.time.{micros, monotonic, now, sleep}

/** Microseconds on a clock that only moves forward, from an origin of no meaning: the difference of
 * two readings is the time between them. */
monotonic_micros() -> long = monotonic().us

/** Microseconds since 1970-01-01T00:00:00 UTC on the wall clock, which anyone may set and which two
 * readings may therefore find running backwards. */
wall_micros() -> long = now().us

/** Waits until `us` microseconds have passed; a time of zero or less returns at once. The calling
 * thread is the one its context says: a lightweight thread parks on a timer and frees its worker, and
 * any other blocks, safe for the collector for the whole wait. A thread the runtime has not attached
 * simply sleeps. */
sleep_micros(us: long)
    val c = current_context
    if c == null then sleep(micros(us)) else sleep_for(c, us)
