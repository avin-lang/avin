module avin.rt

import sysl.time.{micros, monotonic, now, sleep}

/** Microseconds on a clock that only moves forward, from an origin of no meaning: the difference of
 * two readings is the time between them. */
monotonic_micros() -> long = monotonic().us

/** Microseconds since 1970-01-01T00:00:00 UTC on the wall clock, which anyone may set and which two
 * readings may therefore find running backwards. */
wall_micros() -> long = now().us

/** Waits until `us` microseconds have passed, however many attempts the host needs; a time of zero or
 * less returns at once. Its binding is declared blocking, so the thread is safe for the collector for
 * the whole wait. */
sleep_micros(us: long) = sleep(micros(us))
