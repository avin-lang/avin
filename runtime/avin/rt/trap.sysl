module avin.rt

import sysl.buf.{Buf, buf}
import sysl.text.from_utf8_unchecked

/** A place where a compiled program can trap, which the compiler emits as constant data: the
 * reason and the file name as constant strings, then the line and column of the operation, both
 * counted from 1. */
struct TrapSite
    reason: *u8
    file: *u8
    line: usize
    col: usize

/** Stops the program on a failed check at `site`: an integer overflow, a division by zero, a value
 * a conversion cannot hold, a match no arm takes. What the program has written so far is flushed
 * first, so output that went to a pipe or a file before the failure is not lost; then the reason
 * and the place go to standard error, as `avin: trap: integer overflow at gcd.avin:12:9`. A trap in
 * any thread stops the whole program, and only the first thread to stop it reports. */
@export("avin_rt_trap")
stop(ctx: *Context, site: *TrapSite) -> never
    begin_stop(ctx)
    flush()
    report(site.reason, site)

/** Stops the program on a failed check inside the core library, at `site` in the library's own
 * code. The program's author did not write that code, so the place reported is the one where the
 * program last entered the library, which the context holds, with `site`'s reason; before the
 * program has entered the library at all, it is `site` itself. */
@export("avin_rt_caller_trap")
stop_at_caller(ctx: *Context, site: *TrapSite) -> never
    begin_stop(ctx)
    flush()
    report(site.reason, if ctx.caller == null then site else ctx.caller)

/** Stops the program on a failed check at `site` whose reason was made while the program ran: the
 * string at `reason` rather than the site's own. */
@export("avin_rt_trap_message")
stop_with(ctx: *Context, site: *TrapSite, reason: *u8) -> never
    begin_stop(ctx)
    flush()
    report(reason, site)

/** Stops the program on a failed check inside the core library with the string at `reason` as its
 * reason, reported where the program last entered the library, as `stop_at_caller` reports it. A
 * failed assertion, whose message shows the values it compared, stops this way. */
@export("avin_rt_caller_trap_message")
stop_at_caller_with(ctx: *Context, site: *TrapSite, reason: *u8) -> never
    begin_stop(ctx)
    flush()
    report(reason, if ctx.caller == null then site else ctx.caller)

private report(reason: *u8, place: *TrapSite) -> never
    eprints("avin: trap: " + text_string(reason) + " at " + text_string(place.file) + ":" + place.line.to_string() + ":" + place.col.to_string() + "\n")
    trap()

/** The string at `p` as a Sysl string, copied. */
private text_string(p: *u8) -> string
    val data = text_bytes(p)
    var bytes: Buf[u8] = buf()
    for i in 0..<text_length(p) do bytes.push(data[i])
    from_utf8_unchecked(bytes.view())
