module avin.rt

/** Stops the program on a failed check: an integer overflow, a division by zero, a value a
 * conversion cannot hold, a match no arm takes. What the program has written so far is flushed
 * first, so output that went to a pipe or a file before the failure is not lost. */
@export("avin_rt_trap")
stop(ctx: *Context) -> never
    flush()
    trap()
