module avin.rt

import sysl.buf.Buf
import sysl.fs.IoError
import sysl.net.{Address, Shutdown, Socket, peer_closed, resolve, socket, timed_out}

/** Why an operation on a connection failed, as `avin.net` tells failures apart: the other end
 * refused or reset it, a timeout ran out, or anything else, in the platform's words. */
enum NetFailure
    Refused
    Reset
    TimedOut
    Failed(message: string)

/** A TCP socket that `avin.net` holds through a handle: a connection, or a listener. Its socket is
 * closed when the last reference to it is given back, which is when the handle is closed or, for one
 * the program forgot, when the collector frees it. */
struct Connection
    sock: Socket

    /** Connects to `to`, waiting until the other end answers or refuses. */
    @blocks
    connect(*self, to: Address) -> Result[unit, NetFailure] = self.sock.connect(to).map_err(failure_of)

    /** Binds to `to`, letting a port a recently stopped listener used be taken again, and listens. */
    listen_at(*self, to: Address) -> Result[unit, NetFailure]
        self.sock.reuse_address().map_err(failure_of)?
        self.sock.bind(to).map_err(failure_of)?
        self.sock.listen().map_err(failure_of)
    end listen_at

    /** The port this socket is bound to, which is how a listener asked for port 0 learns its own. */
    local_port(self) -> Result[int, NetFailure] = self.sock.local().map(a -> a.port()).map_err(failure_of)

    /** Waits for the next connection. */
    @blocks
    accept(*self) -> Result[&Connection, NetFailure]
        val (s, _) = self.sock.accept().map_err(failure_of)?
        Ok(Connection(s))
    end accept

    /** Sends every byte of `bytes`. */
    @blocks
    send_all(*self, bytes: []const u8) -> Result[unit, NetFailure] = self.sock.send_all(bytes).map_err(failure_of)

    /** Reads what has arrived into `into`, waiting for at least one byte, and says how many; zero is
     * the end of what the other end sends. */
    @blocks
    recv(*self, into: []u8) -> Result[i64, NetFailure] = self.sock.recv(into).map(n -> i64(n)).map_err(failure_of)

    /** Tells the other end nothing more will be sent. */
    shutdown_output(*self) -> Result[unit, NetFailure] = self.sock.shutdown(Shutdown.Write).map_err(failure_of)

    /** How long a read or a write may wait, in milliseconds, zero being no limit. */
    set_timeout(*self, ms: int) -> Result[unit, NetFailure]
        self.sock.read_timeout(ms).map_err(failure_of)?
        self.sock.write_timeout(ms).map_err(failure_of)
    end set_timeout

impl Drop for Connection
    drop(self)
        var s = self.sock
        _ = s.close()

/** Every address `host` and `port` resolve to, in the order the platform prefers them. */
resolve_host(host: string, port: int) -> Result[Buf[Address], NetFailure] = resolve(host, port).map_err(failure_of)

/** A stream socket of the family `to` belongs to, not yet connected or bound. */
open_connection(to: Address) -> Result[&Connection, NetFailure] =
    socket(to).map(s -> Connection(s)).map_err(failure_of)

private failure_of(e: IoError) -> NetFailure =
    if e.code() == refused_code() then Refused
    else if peer_closed(e) then Reset
    else if timed_out(e) then TimedOut
    else Failed(e.message())

#if bsd
private refused_code() -> int = 61
#else
private refused_code() -> int = 111
#endif
