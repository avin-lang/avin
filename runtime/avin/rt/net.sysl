module avin.rt

import sysl.fs.IoError
import sysl.net.{peer_closed, timed_out}

/** Why an operation on a connection failed, as `avin.net` tells failures apart: the other end
 * refused or reset it, a timeout ran out, or anything else, in the platform's words. */
enum NetFailure
    Refused
    Reset
    TimedOut
    Failed(message: string)

/** Which of the failures `avin.net` tells apart a `sysl.net` error is. */
net_failure(e: IoError) -> NetFailure =
    if e.code() == refused_code() then Refused
    else if peer_closed(e) then Reset
    else if timed_out(e) then TimedOut
    else Failed(e.message())

/** Whether a lookup's error is the resolver finding no address for the name, which `sysl.net.resolve`
 * reports as `NotFound` (`ENOENT`, 2 on every hosted platform) whatever the resolver's own reason, and
 * `resolve_host` for a name too long to ask about; rather than the runtime failing to make the lookup
 * at all. */
lookup_not_found(e: IoError) -> bool = e.code() == 2

#if bsd
private refused_code() -> int = 61
#else
private refused_code() -> int = 111
#endif
