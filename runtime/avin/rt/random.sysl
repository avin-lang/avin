module avin.rt

import sysl.posix.rand.seed_from_os
import sysl.time.{monotonic, now}

/** A seed for `avin.random`: 63 bits of the host's entropy, so it is a non-negative `long`. Where the
 * host supplies none, the two clocks' microsecond readings combined, which differ from run to run. */
random_seed() -> long = seed_from_os() match
    Some(s) -> i64(s >> 1)
    None -> monotonic().us ^ now().us
