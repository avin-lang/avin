module avin.rt

import sysl.fs.{read_bytes, read_link}
import sysl.time.Instant
import sysl.time.tzif.{abbrev_at, is_dst_at, offset_at}
import sysl.time.tzif

// A zone of the tz database, asked about one instant at a time. `avin.time` keeps a zone's table as
// the bytes of its file, an immutable value any thread may hold, and passes them here with each
// question: Sysl's decoded zone is a view of the bytes it was decoded from, so it cannot outlive the
// call that made it, and decoding a table is a walk over its header, short beside reading one.

/** The bytes of a zone's file, or `None` where it cannot be read: there is no such file, or it is a
 * directory, or it may not be read. */
zone_file_bytes(file: string) -> Option[[]u8] = read_bytes(file) match
    Ok(b) -> Some(b)
    Err(_) -> None

/** Where the symbolic link `file` points, or `None` where it is no link. */
zone_link_target(file: string) -> Option[string] = read_link(file) match
    Ok(t) -> Some(t)
    Err(_) -> None

/** Whether the bytes are a tz database file this reads: its header, its tables and its footer. */
zone_table_valid(data: []const u8) -> bool = tzif.parse(data) match
    Ok(_) -> true
    Err(_) -> false

/** How many minutes the zone's clocks are set from UTC at the instant `us` microseconds after the
 * epoch; a table that does not decode answers zero, which `zone_table_valid` has ruled out. */
zone_offset_minutes(data: []const u8, us: long) -> int = tzif.parse(data) match
    Ok(z) -> offset_at(z, Instant(us)) match
        Ok(o) -> o.minutes
        Err(_) -> 0
    Err(_) -> 0

/** Whether the zone's clocks are on daylight saving time at the instant. */
zone_is_dst(data: []const u8, us: long) -> bool = tzif.parse(data) match
    Ok(z) -> is_dst_at(z, Instant(us)) match
        Ok(d) -> d
        Err(_) -> false
    Err(_) -> false

/** The abbreviation the zone's clocks went by at the instant: `EST`, `EDT`, `+0545`. */
zone_abbreviation(data: []const u8, us: long) -> string = tzif.parse(data) match
    Ok(z) -> abbrev_at(z, Instant(us)) match
        Ok(a) -> a
        Err(_) -> ""
    Err(_) -> ""
