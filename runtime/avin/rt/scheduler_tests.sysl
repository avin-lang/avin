module avin.rt
@tests

import sh.sysl.gc
import sysl.raw.ptr_cast
import sysl.sync.*
import sysl.threads.yield_now as os_yield
import sysl.time.{millis, sleep}

// Lightweight threads started as compiled code starts them, through `thread_start` with a runner the
// C convention calls: here a Sysl function, handed a pointer to the test's own state as its closure,
// which the collector ignores since it is outside the heap.

// A frame of up to 64 slots holding the joints of the threads a test starts, so a collection while
// it starts more keeps them.
private struct Joints
    frame: Frame
    slots: [64]*u8

@assert(offsetof(Joints, slots) == sizeof(Frame), "a frame's slots follow its header")

private var joints: Joints = Joints(Frame(null, 64), [null; 64])

// Starts `n` lightweight threads running `body` with `state`, from `me`, their joints held in `joints`.
private start_n(me: *Context, n: usize, body: *extern(@lets_out *Context, *u8) -> unit, state: *u8)
    for i in 0..<n
        joints.slots[i] = thread_start(me, state, LeastStack, ptr_cast(body))

private join_n(me: *Context, n: usize)
    for i in 0..<n
        thread_join(me, joints.slots[i])
        joints.slots[i] = null

private with_joints(me: *Context)
    joints.frame.prev = me.top
    me.top = &joints.frame

private without_joints(me: *Context)
    me.top = joints.frame.prev

// How many lightweight threads to start so that every worker has one and some wait: four for each
// processor, within the 64 slots.
private crowd() -> usize
    val n = usize(processors()) * 4
    if n > 64 then 64 else n

// Waits, polling, for `flag` to be raised, for at most `ms` milliseconds; answers whether it was.
private raised_within(flag: *Atomic[u32], ms: int) -> bool
    for _ in 0..<ms
        if flag.load() != 0 then return true
        sleep(millis(1))
    flag.load() != 0

private struct Counting
    runs: Atomic[u32]
    lightweight: Atomic[u32]

private var counting: Counting = Counting(Atomic(0), Atomic(0))

private count_run(c: *Context, run: *u8) -> unit
    val s: *Counting = ptr_cast(run)
    if runs_lightweight(c) then _ = s.lightweight.add(1)
    _ = s.runs.add(1)

@test("lightweight threads run on the scheduler's workers and are joined, twice over, from a thread that is not one")
start_and_join()
    counting.runs.store(0)
    counting.lightweight.store(0)
    val me = thread_attach()
    assert(!runs_lightweight(me))
    with_joints(me)
    val n = crowd()
    start_n(me, n, &count_run, ptr_cast(&counting))
    join_n(me, n)
    assert_eq(counting.runs.load(), u32(n))
    assert_eq(counting.lightweight.load(), u32(n))
    assert(workers_started.load() >= 1)
    assert(workers_started.load() <= u64(processors()) + 64)
    // A second join of an ended thread returns at once.
    joints.slots[0] = thread_start(me, ptr_cast(&counting), LeastStack, ptr_cast(&count_run))
    thread_join(me, joints.slots[0])
    thread_join(me, joints.slots[0])
    joints.slots[0] = null
    without_joints(me)
    collect(me)
    assert_eq(gc.live(&space), 0usize)
    thread_detach(me)

private struct Hops
    moved: Atomic[u32]
    turns: Atomic[u32]

private var hops: Hops = Hops(Atomic(0), Atomic(0))

private hop(c: *Context, run: *u8) -> unit
    val h: *Hops = ptr_cast(run)
    val first = c.carrier
    var moved = false
    for _ in 0..<2000
        yield_now(c)
        if c.carrier != first then moved = true
    if moved then _ = h.moved.add(1)
    _ = h.turns.add(1)

@test("a lightweight thread that yields resumes on whichever worker takes it, which may be another")
resumes_elsewhere()
    hops.moved.store(0)
    hops.turns.store(0)
    val me = thread_attach()
    with_joints(me)
    val n = crowd()
    start_n(me, n, &hop, ptr_cast(&hops))
    join_n(me, n)
    without_joints(me)
    thread_detach(me)
    assert_eq(hops.turns.load(), u32(n))
    if processors() > 1 then assert(hops.moved.load() > 0)

// A lock the test's own thread holds while lightweight threads wait for it, and a thread that needs
// none, which must still run while they wait.
private struct Contended
    lock: *u8
    taken: Atomic[u32]
    free_ran: Atomic[u32]

private var contended: Contended = Contended(null, Atomic(0), Atomic(0))

private take_contended(c: *Context, run: *u8) -> unit
    val s: *Contended = ptr_cast(run)
    lock_acquire(c, s.lock)
    _ = s.taken.add(1)
    lock_release(c, s.lock)

private run_free(c: *Context, run: *u8) -> unit
    val s: *Contended = ptr_cast(run)
    s.free_ran.store(1)

@test("lightweight threads waiting for a lock park, leaving their workers to run others, and each takes it in turn")
lock_waiters_park()
    val me = thread_attach()
    with_joints(me)
    joints.slots[63] = lock_new(me)
    contended.lock = joints.slots[63]
    contended.taken.store(0)
    contended.free_ran.store(0)
    lock_acquire(me, contended.lock)
    val n = crowd() - 1
    start_n(me, n, &take_contended, ptr_cast(&contended))
    sleep(millis(20))
    assert_eq(contended.taken.load(), 0u32)
    joints.slots[n] = thread_start(me, ptr_cast(&contended), LeastStack, ptr_cast(&run_free))
    assert(raised_within(&contended.free_ran, 5000))
    lock_release(me, contended.lock)
    join_n(me, n + 1)
    assert_eq(contended.taken.load(), u32(n))
    val l: *ParkLock = ptr_cast(contended.lock)
    assert(!l.held)
    assert(l.waiting.head == null)
    joints.slots[63] = null
    contended.lock = null
    without_joints(me)
    collect(me)
    assert_eq(gc.live(&space), 0usize)
    thread_detach(me)

// A condition lightweight threads wait on with a time limit.
private struct Timed
    lock: *u8
    condition: *u8
    notified: Atomic[u32]
    ran_out: Atomic[u32]
    waiting: Atomic[u32]
    millis: long

private var timed: Timed = Timed(null, null, Atomic(0), Atomic(0), Atomic(0), 0)

private wait_timed(c: *Context, run: *u8) -> unit
    val s: *Timed = ptr_cast(run)
    lock_acquire(c, s.lock)
    _ = s.waiting.add(1)
    val before = now_micros()
    if condition_wait_for(c, s.condition, s.lock, s.millis)
        _ = s.notified.add(1)
    else
        if now_micros() - before >= s.millis * 1000 then _ = s.ran_out.add(1)
    lock_release(c, s.lock)

private timed_round(me: *Context, n: usize, ms: long, notify: bool)
    timed.notified.store(0)
    timed.ran_out.store(0)
    timed.waiting.store(0)
    timed.millis = ms
    start_n(me, n, &wait_timed, ptr_cast(&timed))
    if notify
        while timed.waiting.load() < u32(n)
            sleep(millis(1))
        lock_acquire(me, timed.lock)
        condition_notify_all(me, timed.condition)
        lock_release(me, timed.lock)
    join_n(me, n)

@test("a timed condition wait in a lightweight thread runs out after its time, or ends early when notified")
timed_waits_park()
    val me = thread_attach()
    with_joints(me)
    joints.slots[62] = lock_new(me)
    joints.slots[63] = condition_new(me)
    timed.lock = joints.slots[62]
    timed.condition = joints.slots[63]
    val n = crowd() - 2
    timed_round(me, n, 30, false)
    assert_eq(timed.ran_out.load(), u32(n))
    assert_eq(timed.notified.load(), 0u32)
    val before = now_micros()
    timed_round(me, n, 60000, true)
    assert_eq(timed.notified.load(), u32(n))
    assert(now_micros() - before < 30000000)
    val q: *ParkCondition = ptr_cast(timed.condition)
    assert(q.waiting.head == null)
    joints.slots[62] = null
    joints.slots[63] = null
    timed.lock = null
    timed.condition = null
    without_joints(me)
    collect(me)
    assert_eq(gc.live(&space), 0usize)
    thread_detach(me)

// Lightweight threads that block in the operating system, as a blocking binding does, on every
// worker at once, and one more thread that has to run meanwhile.
private struct Blocking
    done: Atomic[u32]
    other_ran: Atomic[u32]
    other_first: Atomic[u32]

private var blocking: Blocking = Blocking(Atomic(0), Atomic(0), Atomic(0))

private block_a_while(c: *Context, run: *u8) -> unit
    val s: *Blocking = ptr_cast(run)
    enter_safe(c)
    sleep(millis(400))
    leave_safe(c)
    _ = s.done.add(1)

private run_meanwhile(c: *Context, run: *u8) -> unit
    val s: *Blocking = ptr_cast(run)
    if s.done.load() == 0 then s.other_first.store(1)
    s.other_ran.store(1)

@test("a worker held by a blocking call is replaced, so a ready thread runs while every worker blocks")
blocked_workers_are_replaced()
    blocking.done.store(0)
    blocking.other_ran.store(0)
    blocking.other_first.store(0)
    val before = releases.load()
    val me = thread_attach()
    with_joints(me)
    val n = crowd() - 1
    start_n(me, n, &block_a_while, ptr_cast(&blocking))
    sleep(millis(20))
    joints.slots[n] = thread_start(me, ptr_cast(&blocking), LeastStack, ptr_cast(&run_meanwhile))
    join_n(me, n + 1)
    without_joints(me)
    thread_detach(me)
    assert_eq(blocking.done.load(), u32(n))
    assert_eq(blocking.other_ran.load(), 1u32)
    assert_eq(blocking.other_first.load(), 1u32)
    assert(releases.load() > before)

// Lightweight threads, one on every worker, whose blocking calls return while a collection holds every
// thread, and sleepers whose timers make them ready meanwhile.
private struct HeldByCollector
    started: Atomic[u32]
    entered: Atomic[u32]
    returned: Atomic[u32]
    done: Atomic[u32]
    slept: Atomic[u32]

private var held: HeldByCollector = HeldByCollector(Atomic(0), Atomic(0), Atomic(0), Atomic(0), Atomic(0))

// Takes a worker of its own: polls until every blocker has started, so none is still waiting to run
// once they block, then makes a blocking call that returns when the test says, during a collection.
private return_during_collection(c: *Context, run: *u8) -> unit
    val s: *HeldByCollector = ptr_cast(run)
    _ = s.started.add(1)
    while s.started.load() < u32(processors())
        safepoint(c)
        os_yield()
    enter_safe(c)
    _ = s.entered.add(1)
    while s.returned.load() == 0 do os_yield()
    leave_safe(c)
    _ = s.done.add(1)

private sleep_through_collection(c: *Context, run: *u8) -> unit
    val s: *HeldByCollector = ptr_cast(run)
    sleep_for(c, 50000)
    _ = s.slept.add(1)

@test("a worker whose blocking call has returned and that waits for a collection is not replaced, while threads are ready")
waiting_for_the_collector_is_not_blocking()
    held.started.store(0)
    held.entered.store(0)
    held.returned.store(0)
    held.done.store(0)
    held.slept.store(0)
    val me = thread_attach()
    with_joints(me)
    val n = usize(processors())
    val sleepers = 4usize
    // The sleepers park first, so the ready queue is empty while the blockers take every worker.
    for i in 0..<sleepers
        joints.slots[n + i] = thread_start(me, ptr_cast(&held), LeastStack, ptr_cast(&sleep_through_collection))
    var ms = 0
    while timers_pending() < sleepers && ms < 10000
        sleep(millis(1))
        ms += 1
    start_n(me, n, &return_during_collection, ptr_cast(&held))
    ms = 0
    while held.entered.load() < u32(n) && ms < 10000
        sleep(millis(1))
        ms += 1
    assert_eq(held.entered.load(), u32(n))
    // A collection that lasts many ticks: every blocker's call returns at its start, and the sleepers'
    // timers make them ready while every worker waits for it. The monitor replaces no worker while a
    // collection holds every thread; once it has finished, the blockers are held back a while longer,
    // as on a busy system, and the monitor sees their workers still waiting with threads ready.
    lock_heap(me)
    assert(stop_others(me))
    val before = releases.load()
    held.returned.store(1)
    sleep(millis(100))
    resume_others_late(20000)
    val during = releases.load() - before
    heap_lock.unlock()
    join_n(me, n + sleepers)
    without_joints(me)
    thread_detach(me)
    assert_eq(held.done.load(), u32(n))
    assert_eq(held.slept.load(), u32(sleepers))
    assert_eq(during, 0u64)

// Threads that spin, polling as compiled code does, until one more thread has run: with more spinners
// than workers, it runs only if the spinners are made to yield.
private struct Spinning
    halt: Atomic[u32]
    spun: Atomic[u32]

private var spinning: Spinning = Spinning(Atomic(0), Atomic(0))

private spin_polling(c: *Context, run: *u8) -> unit
    val s: *Spinning = ptr_cast(run)
    while s.halt.load(Relaxed) == 0
        if requested.load(Relaxed) != 0 then safepoint(c)
    _ = s.spun.add(1)

private halt_spinners(c: *Context, run: *u8) -> unit
    val s: *Spinning = ptr_cast(run)
    s.halt.store(1)

@test("a thread that overruns its slice while another is ready yields at its next poll")
overrunning_threads_yield()
    spinning.halt.store(0)
    spinning.spun.store(0)
    val before = yields.load()
    val me = thread_attach()
    with_joints(me)
    val n = crowd() - 1
    start_n(me, n, &spin_polling, ptr_cast(&spinning))
    sleep(millis(30))
    joints.slots[n] = thread_start(me, ptr_cast(&spinning), LeastStack, ptr_cast(&halt_spinners))
    join_n(me, n + 1)
    without_joints(me)
    thread_detach(me)
    assert_eq(spinning.spun.load(), u32(n))
    assert(yields.load() > before)
    // Once nothing overruns, the monitor lowers the bit by its next tick.
    sleep(millis(20))
    assert_eq(requested.load() & Yield, 0u32)

// A thread that builds a list rooted in its own frame, parks on a condition while collections run,
// and checks the list when it wakes.
private struct ParkedList
    root: Frame
    head: *u8
    lock: *u8
    condition: *u8
    built: Atomic[u32]
    go: Atomic[u32]
    ok: Atomic[u32]

@assert(offsetof(ParkedList, head) == sizeof(Frame), "a frame's slots follow its header")

private struct Cell
    header: Descriptor
    offset: usize

private var cell_kind: Cell = Cell(descriptor(2, 16, 1), 0)

private var parked_list: ParkedList = ParkedList(Frame(null, 1), null, null, null, Atomic(0), Atomic(0), Atomic(0))

private build_and_park(c: *Context, run: *u8) -> unit
    val s: *ParkedList = ptr_cast(run)
    s.root.prev = c.top
    c.top = &s.root
    for i in 0..<500
        val p = allocate(c, &cell_kind.header)
        val words: *usize = ptr_cast(p)
        val next: **u8 = ptr_cast(p)
        next[0] = s.head
        words[1] = i
        s.head = p
    lock_acquire(c, s.lock)
    s.built.store(1)
    while s.go.load() == 0
        condition_wait(c, s.condition, s.lock)
    lock_release(c, s.lock)
    var p = s.head
    var n = 500usize
    var intact = true
    while p != null
        if n == 0 then intact = false
        n -= 1
        val words: *usize = ptr_cast(p)
        if words[1] != n then intact = false
        val next: **u8 = ptr_cast(p)
        p = next[0]
    if intact && n == 0 then s.ok.store(1)
    c.top = s.root.prev
    s.head = null

@test("a parked lightweight thread's frames are roots of every collection while it waits")
parked_frames_are_roots()
    parked_list.built.store(0)
    parked_list.go.store(0)
    parked_list.ok.store(0)
    val me = thread_attach()
    with_joints(me)
    joints.slots[62] = lock_new(me)
    joints.slots[63] = condition_new(me)
    parked_list.lock = joints.slots[62]
    parked_list.condition = joints.slots[63]
    val parker: *extern(@lets_out *Context, *u8) -> unit = &build_and_park
    joints.slots[0] = thread_start(me, ptr_cast(&parked_list), LeastStack, ptr_cast(parker))
    assert(raised_within(&parked_list.built, 5000))
    for _ in 0..<10
        collect(me)
    assert(gc.live(&space) >= 500usize)
    lock_acquire(me, parked_list.lock)
    parked_list.go.store(1)
    condition_notify(me, parked_list.condition)
    lock_release(me, parked_list.lock)
    thread_join(me, joints.slots[0])
    assert_eq(parked_list.ok.load(), 1u32)
    joints.slots[0] = null
    joints.slots[62] = null
    joints.slots[63] = null
    parked_list.lock = null
    parked_list.condition = null
    without_joints(me)
    collect(me)
    assert_eq(gc.live(&space), 0usize)
    thread_detach(me)

private var queue: WaitQueue = new_wait_queue()
private var first_waiter: Waiter = new_waiter()
private var second_waiter: Waiter = new_waiter()
private var third_waiter: Waiter = new_waiter()

@test("a waiter is put at the back of its queue and taken off from anywhere in it")
wait_queues()
    val q = &queue
    val a = &first_waiter
    val b = &second_waiter
    val c = &third_waiter
    enqueue(q, a)
    enqueue(q, b)
    enqueue(q, c)
    assert(q.head == a && q.tail == c)
    unlink_waiter(q, b)
    assert(!b.linked)
    assert(a.next == c && c.prev == a)
    unlink_waiter(q, b)
    unlink_waiter(q, a)
    assert(q.head == c && q.tail == c && c.prev == null)
    unlink_waiter(q, c)
    assert(q.head == null && q.tail == null)

@test("a deadline is the time asked from now, and one too far away is held to about thirty years")
deadlines()
    val now = now_micros()
    val d = deadline_after(5)
    assert(d >= now + 5000)
    assert(d < now + 5000 + 1000000)
    val far = deadline_after(9223372036854775807)
    assert(far > now)
    assert(far <= now_micros() + 1000000000000000)

// Threads queued for a lock one after another, and the order they took it in.
private struct Queued
    lock: *u8
    taken: [8]usize
    count: usize

private var queued: Queued = Queued(null, [0; 8], 0)

private take_in_turn(c: *Context, run: *u8) -> unit
    val s: *Queued = ptr_cast(run)
    lock_acquire(c, s.lock)
    s.taken[s.count] = usize(c)
    s.count += 1
    lock_release(c, s.lock)

private queue_length(q: *WaitQueue) -> usize
    q.guard.lock()
    var n = 0usize
    var w = q.head
    while w != null
        n += 1
        w = w.next
    q.guard.unlock()
    n

@test("a lock let go goes to the thread that has waited for it longest")
locks_go_in_turn()
    val me = thread_attach()
    with_joints(me)
    joints.slots[63] = lock_new(me)
    queued.lock = joints.slots[63]
    queued.count = 0
    val l: *ParkLock = ptr_cast(queued.lock)
    lock_acquire(me, queued.lock)
    var expected: [8]usize = [0; 8]
    for i in 0..<8
        joints.slots[i] = thread_start(me, ptr_cast(&queued), LeastStack, ptr_cast(&take_in_turn))
        var waited = 0
        while queue_length(&l.waiting) < i + 1 && waited < 5000
            sleep(millis(1))
            waited += 1
        assert_eq(queue_length(&l.waiting), i + 1)
        l.waiting.guard.lock()
        expected[i] = usize(&*l.waiting.tail.lwt)
        l.waiting.guard.unlock()
    lock_release(me, queued.lock)
    join_n(me, 8)
    assert_eq(queued.count, 8usize)
    for i in 0..<8
        assert_eq(queued.taken[i], expected[i])
    assert(!l.held)
    joints.slots[63] = null
    queued.lock = null
    without_joints(me)
    collect(me)
    assert_eq(gc.live(&space), 0usize)
    thread_detach(me)

// A thread that ends once `go` is raised, raising `ended` first, and a lightweight thread joining it,
// which raises `joined` once its join has answered.
private struct Ending
    running: Atomic[u32]
    joining: Atomic[u32]
    go: Atomic[u32]
    ended: Atomic[u32]
    joined: Atomic[u32]
    joint: *u8

private var ending: Ending = Ending(Atomic(0), Atomic(0), Atomic(0), Atomic(0), Atomic(0), null)

private end_on_go(c: *Context, run: *u8) -> unit
    ending.running.store(1)
    while ending.go.load() == 0
        sleep(millis(1))
    _ = ending.ended.add(1)

private join_ending(c: *Context, run: *u8) -> unit
    ending.joining.store(1)
    thread_join(c, ending.joint)
    ending.joined.store(1)

private end_at_once(c: *Context, run: *u8) -> unit
    ()

@test("a join answers only once the ended thread is detached, so its frames are no longer roots")
join_answers_after_detach()
    ending.running.store(0)
    ending.joining.store(0)
    ending.go.store(0)
    ending.ended.store(0)
    ending.joined.store(0)
    val me = thread_attach()
    with_joints(me)
    // The closure is an object on the heap, which only the thread's own frame holds once it starts.
    joints.slots[2] = allocate(me, &cell_kind.header)
    joints.slots[0] = thread_start(me, joints.slots[2], LeastStack, ptr_cast(&end_on_go))
    joints.slots[2] = null
    ending.joint = joints.slots[0]
    joints.slots[1] = thread_start(me, null, LeastStack, ptr_cast(&join_ending))
    // Both run on workers before the heap lock is taken, since a worker starting links its carrier
    // under it; the joiner is given time to park in its join.
    assert(raised_within(&ending.running, 5000))
    assert(raised_within(&ending.joining, 5000))
    sleep(millis(20))
    // While the heap lock is held the ended thread cannot detach, so its join must not answer.
    heap_lock.lock()
    ending.go.store(1)
    assert(raised_within(&ending.ended, 5000))
    sleep(millis(50))
    assert_eq(ending.joined.load(), 0u32)
    heap_lock.unlock()
    assert(raised_within(&ending.joined, 5000))
    thread_join(me, joints.slots[0])
    thread_join(me, joints.slots[1])
    joints.slots[0] = null
    joints.slots[1] = null
    ending.joint = null
    without_joints(me)
    collect(me)
    assert_eq(gc.live(&space), 0usize)
    thread_detach(me)

@test("a joined thread keeps neither its closure nor its joint alive at the first collection after the join")
joined_threads_keep_nothing()
    val me = thread_attach()
    with_joints(me)
    // Slot 63 holds each closure until its thread starts.
    val n = if crowd() < 63 then crowd() else 63usize
    for _ in 0..<20
        for i in 0..<n
            joints.slots[63] = allocate(me, &cell_kind.header)
            joints.slots[i] = thread_start(me, joints.slots[63], LeastStack, ptr_cast(&end_at_once))
            joints.slots[63] = null
        join_n(me, n)
        collect(me)
        assert_eq(gc.live(&space), 0usize)
    without_joints(me)
    thread_detach(me)

@test("a thread nobody joins lets its closure and its joint go once it has ended, while collections run")
unjoined_threads_keep_nothing()
    counting.runs.store(0)
    counting.lightweight.store(0)
    val me = thread_attach()
    with_joints(me)
    val n = crowd()
    for _ in 0..<n
        joints.slots[0] = thread_start(me, ptr_cast(&counting), LeastStack, ptr_cast(&count_run))
        joints.slots[0] = null
        collect(me)
    var waited = 0
    while counting.runs.load() < u32(n) && waited < 5000
        sleep(millis(1))
        waited += 1
    assert_eq(counting.runs.load(), u32(n))
    // The bodies have run; their ends follow, each letting its joint go.
    collect(me)
    var rounds = 0
    while gc.live(&space) != 0 && rounds < 5000
        sleep(millis(1))
        collect(me)
        rounds += 1
    assert_eq(gc.live(&space), 0usize)
    without_joints(me)
    thread_detach(me)

// What a lightweight thread saw of its stack: whether the overflow report's low end was its stack's
// own lowest usable address, before and after it yielded, and whether a local of its frame lay
// between that address and the stack's top.
private struct Bounds
    exact: Atomic[u32]
    inside: Atomic[u32]
    runs: Atomic[u32]

private var bounds: Bounds = Bounds(Atomic(0), Atomic(0), Atomic(0))

private look_at_bounds(c: *Context, run: *u8) -> unit
    val b: *Bounds = ptr_cast(run)
    val p: *Lwt = ptr_cast(c)
    var mark: u8 = 0
    p.stack match
        Some(st) ->
            val before = stack_guard_low() == st.low()
            yield_now(c)
            val after = stack_guard_low() == st.low()
            if before && after then _ = b.exact.add(1)
            val at = usize(&mark)
            if usize(st.low()) < at && at < usize(st.high()) then _ = b.inside.add(1)
        None -> ()
    _ = b.runs.add(1)

// Starts `n` threads looking at their bounds on stacks of `size` bytes, and joins them.
private bounds_at(me: *Context, n: usize, size: long)
    for i in 0..<n
        joints.slots[i] = thread_start(me, ptr_cast(&bounds), size, ptr_cast(&look_at_bounds))
    join_n(me, n)

@test("a lightweight thread's overflow report knows its stack's real low end, at every size and on a stack kept from an ended thread")
stack_bounds_are_the_stacks_own()
    bounds.exact.store(0)
    bounds.inside.store(0)
    bounds.runs.store(0)
    val me = thread_attach()
    with_joints(me)
    val n = crowd()
    // Below the least, at the least, a size that is not whole pages, and the library's default.
    bounds_at(me, n, 1)
    bounds_at(me, n, LeastStack)
    bounds_at(me, n, 100001)
    bounds_at(me, n, 8388608)
    // A megabyte's stacks, kept as their threads end, are handed to threads asking for less.
    bounds_at(me, n, 1048576)
    bounds_at(me, n, 600000)
    without_joints(me)
    thread_detach(me)
    assert_eq(bounds.runs.load(), u32(n * 6))
    assert_eq(bounds.exact.load(), u32(n * 6))
    assert_eq(bounds.inside.load(), u32(n * 6))

// Recursion that commits about 4 KiB of stack a call, each frame's bytes read back on the way out, so
// a page given back under live frames would show as a wrong sum.
private dig(depth: usize) -> usize
    var pad: [4096]u8 = [0; 4096]
    for i in 0..<4096 do pad[i] = u8((depth + i) % 251)
    val below = if depth == 0 then 0 else dig(depth - 1)
    var sum: usize = 0
    for i in 0..<4096 do sum += usize(pad[i])
    below + sum

/** How deep the threads dig: about 1.5 MiB of stack. */
private const DigDepth: usize = 384

// What threads that dug deep and then parked saw of their stacks: what was committed after the dig,
// after the park and after a second dig, and whether every dig summed as the first did.
private struct Trimmed
    lock: *u8
    condition: *u8
    go: bool
    parked: Atomic[u32]
    right: Atomic[u32]
    deep: Atomic[u64]
    after_park: Atomic[u64]
    sleep_ms: long

private var trimmed: Trimmed = Trimmed(null, null, false, Atomic(0), Atomic(0), Atomic(0), Atomic(0), 0)

private committed_now(c: *Context) -> u64
    val p: *Lwt = ptr_cast(c)
    p.stack match
        Some(st) -> u64(st.committed())
        None -> 0

// Digs, records what its stack holds, parks until told to go (or sleeps, where `sleep_ms` is set), then
// records what its stack holds after the park and digs again.
private dig_and_park(c: *Context, run: *u8) -> unit
    val s: *Trimmed = ptr_cast(run)
    val first = dig(DigDepth)
    _ = s.deep.add(committed_now(c))
    if s.sleep_ms > 0
        _ = s.parked.add(1)
        sleep_for(c, s.sleep_ms * 1000)
    else
        lock_acquire(c, s.lock)
        _ = s.parked.add(1)
        while !s.go do condition_wait(c, s.condition, s.lock)
        lock_release(c, s.lock)
    _ = s.after_park.add(committed_now(c))
    if dig(DigDepth) == first then _ = s.right.add(1)

private trimmed_round(me: *Context, n: usize, sleep_ms: long)
    trimmed.go = false
    trimmed.parked.store(0)
    trimmed.right.store(0)
    trimmed.deep.store(0)
    trimmed.after_park.store(0)
    trimmed.sleep_ms = sleep_ms
    for i in 0..<n
        joints.slots[i] = thread_start(me, ptr_cast(&trimmed), 8388608, ptr_cast(&dig_and_park))
    while trimmed.parked.load() < u32(n) do sleep(millis(1))
    if sleep_ms == 0
        // Long enough for every parked stack to be trimmed: the monitor trims after a millisecond
        // parked, a batch a tick.
        sleep(millis(50))
        lock_acquire(me, trimmed.lock)
        trimmed.go = true
        condition_notify_all(me, trimmed.condition)
        lock_release(me, trimmed.lock)
    join_n(me, n)

@test("a thread that dug deep and parked gives back the pages below where it parked, and digs again correctly once woken")
parked_stacks_are_trimmed()
    val me = thread_attach()
    with_joints(me)
    joints.slots[62] = lock_new(me)
    joints.slots[63] = condition_new(me)
    trimmed.lock = joints.slots[62]
    trimmed.condition = joints.slots[63]
    val n = crowd() - 2
    val before = stacks_trimmed.load()
    trimmed_round(me, n, 0)
    assert_eq(trimmed.right.load(), u32(n))
    // Each dig committed well over a mebibyte; each parked thread came back holding a few pages.
    assert(trimmed.deep.load() / u64(n) > 1048576u64)
    assert(trimmed.after_park.load() / u64(n) < 131072u64)
    assert(stacks_trimmed.load() - before >= u64(n))
    joints.slots[62] = null
    joints.slots[63] = null
    trimmed.lock = null
    trimmed.condition = null
    without_joints(me)
    thread_detach(me)

@test("a thread that dug deep and then sleeps is trimmed while it sleeps")
sleeping_stacks_are_trimmed()
    val me = thread_attach()
    with_joints(me)
    val n = crowd()
    val before = stacks_trimmed.load()
    trimmed_round(me, n, 50)
    assert_eq(trimmed.right.load(), u32(n))
    assert(trimmed.deep.load() / u64(n) > 1048576u64)
    assert(trimmed.after_park.load() / u64(n) < 131072u64)
    assert(stacks_trimmed.load() - before >= u64(n))
    without_joints(me)
    thread_detach(me)

// What a thread saw of its stack as it began: what was committed before it touched anything below
// its first frame.
private struct Fresh
    committed: Atomic[u64]
    runs: Atomic[u32]

private var fresh: Fresh = Fresh(Atomic(0), Atomic(0))

private dig_and_end(c: *Context, run: *u8) -> unit
    _ = dig(DigDepth)

private look_at_start(c: *Context, run: *u8) -> unit
    val s: *Fresh = ptr_cast(run)
    _ = s.committed.add(committed_now(c))
    _ = s.runs.add(1)

@test("a stack kept from a thread that dug deep is given back down to its top pages before the next thread takes it")
kept_stacks_are_trimmed()
    fresh.committed.store(0)
    fresh.runs.store(0)
    val me = thread_attach()
    with_joints(me)
    val n = crowd()
    for i in 0..<n do joints.slots[i] = thread_start(me, null, 8388608, ptr_cast(&dig_and_end))
    join_n(me, n)
    for i in 0..<n do joints.slots[i] = thread_start(me, ptr_cast(&fresh), 8388608, ptr_cast(&look_at_start))
    join_n(me, n)
    without_joints(me)
    thread_detach(me)
    assert_eq(fresh.runs.load(), u32(n))
    assert(fresh.committed.load() / u64(n) < 131072u64)

@test("a release of stack pages the system refuses is counted and leaves the pages committed, and every thread runs on correctly")
refused_releases_leave_stacks_whole()
    val me = thread_attach()
    with_joints(me)
    joints.slots[62] = lock_new(me)
    joints.slots[63] = condition_new(me)
    trimmed.lock = joints.slots[62]
    trimmed.condition = joints.slots[63]
    val n = crowd() - 2
    val refused_before = stack_releases_refused.load()
    refuse_stack_releases.store(1)
    // Parked threads: each trim is refused, so each thread comes back holding what it dug.
    trimmed_round(me, n, 0)
    assert_eq(trimmed.right.load(), u32(n))
    assert(trimmed.after_park.load() / u64(n) > 1048576u64)
    assert(stack_releases_refused.load() - refused_before >= u64(n))
    // Kept stacks: each release as a deep thread ends is refused, and the next threads run on them.
    fresh.committed.store(0)
    fresh.runs.store(0)
    for i in 0..<n do joints.slots[i] = thread_start(me, null, 8388608, ptr_cast(&dig_and_end))
    join_n(me, n)
    for i in 0..<n do joints.slots[i] = thread_start(me, ptr_cast(&fresh), 8388608, ptr_cast(&look_at_start))
    join_n(me, n)
    assert_eq(fresh.runs.load(), u32(n))
    refuse_stack_releases.store(0)
    // With releases allowed again, the same stacks are trimmed as before.
    trimmed_round(me, n, 0)
    assert_eq(trimmed.right.load(), u32(n))
    assert(trimmed.after_park.load() / u64(n) < 131072u64)
    joints.slots[62] = null
    joints.slots[63] = null
    trimmed.lock = null
    trimmed.condition = null
    without_joints(me)
    thread_detach(me)

// Threads pinned to the main thread. The test's own thread stands for the main thread: it attaches the
// main thread's context as the program's start does, and a thread-local flag set on it alone tells
// whether code runs on that operating system thread.
@thread_local private var on_test_thread: bool = false

private struct Pinning
    runs: Atomic[u32]
    elsewhere: Atomic[u32]
    not_main: Atomic[u32]
    started: Atomic[u32]

private var pinning: Pinning = Pinning(Atomic(0), Atomic(0), Atomic(0), Atomic(0))

// Counts, in `s`, a step of a pinned thread that is not on the test's thread or not seen as the main
// thread's.
private pinned_check(s: *Pinning)
    if !on_test_thread then _ = s.elsewhere.add(1)
    if !on_main_thread() || !on_main_scheduler() then _ = s.not_main.add(1)

// A pinned thread: it parks on a sleep, then on a join of a thread it starts on the workers, and looks
// where it runs before and after each wait.
private pinned_run(c: *Context, run: *u8) -> unit
    val s: *Pinning = ptr_cast(run)
    _ = s.started.add(1)
    pinned_check(s)
    sleep_for(c, 2000)
    pinned_check(s)
    val j = thread_start(c, ptr_cast(&counting), LeastStack, ptr_cast(&count_run))
    var r = Holding(Frame(c.top, 1), j, null)
    c.top = &r.frame
    thread_join(c, j)
    c.top = r.frame.prev
    pinned_check(s)
    _ = s.runs.add(1)

// `pinned_run` as a thread's runner, whose context outlives the call.
private pinned_runner() -> *u8
    val runner: *extern(@lets_out *Context, *u8) -> unit = &pinned_run
    ptr_cast(runner)

// Makes the test's thread the main thread, as the program's start does.
private as_main() -> *Context
    on_test_thread = true
    attach(&main_context)
    leave_safe(&main_context)
    current_context = &main_context
    &main_context

private no_longer_main()
    detach(&main_context)
    on_test_thread = false

private reset_pinning()
    pinning.runs.store(0)
    pinning.elsewhere.store(0)
    pinning.not_main.store(0)
    pinning.started.store(0)
    counting.runs.store(0)
    counting.lightweight.store(0)

@test("threads pinned to the main thread run on it only: they park there without blocking it, and resume there when a worker or a timer makes them ready")
pinned_threads_run_on_main()
    reset_pinning()
    val me = as_main()
    with_joints(me)
    val n: usize = 40
    for i in 0..<n
        joints.slots[i] = thread_start_main(me, ptr_cast(&pinning), LeastStack, pinned_runner())
    // Started, ready on the main scheduler, and not run until the main thread runs it: the scheduler
    // is not quiet meanwhile.
    sleep(millis(5))
    assert_eq(pinning.started.load(), 0u32)
    assert(!scheduler_quiet())
    // One step runs each once, to its sleep.
    assert_eq(main_step(), long(n))
    assert_eq(pinning.started.load(), u32(n))
    var parked_lines = 0
    for line in lightweight_lines(now_micros(), false)
        if line.contains(", pinned to the main thread: sleeping") then parked_lines += 1
    assert(parked_lines > 0)
    // The main thread's joins run them as their waits end.
    join_n(me, n)
    assert_eq(pinning.runs.load(), u32(n))
    assert_eq(pinning.elsewhere.load(), 0u32)
    assert_eq(pinning.not_main.load(), 0u32)
    // The threads they started ran on the workers.
    assert_eq(counting.lightweight.load(), u32(n))
    assert_eq(main_step(), 0)
    without_joints(me)
    collect(me)
    no_longer_main()

@test("only the main thread's own code runs the main scheduler: another thread's step runs nothing")
main_step_elsewhere()
    reset_pinning()
    val me = as_main()
    with_joints(me)
    joints.slots[0] = thread_start_main(me, ptr_cast(&pinning), LeastStack, pinned_runner())
    val other = thread_attach()
    assert(!on_main_thread())
    assert_eq(main_step(), 0)
    thread_detach(other)
    current_context = me
    assert_eq(pinning.started.load(), 0u32)
    join_n(me, 1)
    assert_eq(pinning.runs.load(), 1u32)
    assert_eq(pinning.elsewhere.load(), 0u32)
    without_joints(me)
    no_longer_main()
