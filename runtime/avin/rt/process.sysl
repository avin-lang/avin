module avin.rt

import sysl.args.args_of
import sysl.buf.{Buf, buf}
import sysl.signal.{CHLD, CONT, STOP, TSTP, USR1, USR2}

// The program's process: the arguments it was started with, and ending it with a status. The
// arguments are kept as the platform handed them to `main`, converted to strings once at startup, so
// an argument that is not UTF-8 stops the program before it begins rather than when it is read.

/** The program's arguments, its own name first. */
var arguments: Buf[string] = buf()

/** Keeps the arguments the platform handed `main`: `argc` of them at `argv`. */
keep_arguments(argc: i32, argv: **u8)
    for a in args_of(argc, argv) do arguments.push(a)

/** How many arguments the program was started with, its own name included. */
@export("avin_rt_argument_count")
argument_count(ctx: *Context) -> int = int(arguments.len())

/** The argument at `index`, counting the program's name as 0, as a new string. The library asks only
 * for an index below `argument_count`. */
@export("avin_rt_argument")
argument(ctx: *Context, index: int) -> *u8 = text_of(ctx, arguments[usize(index)])

/** Ends the program with `code` as its exit status. What it has written so far is flushed first, as a
 * trap flushes it, so output that went to a pipe or a file is not lost, and the exit hooks run then
 * (`exit_hooks.sysl`). */
@export("avin_rt_exit")
exit_with(ctx: *Context, code: int) -> never
    exit_after_hooks(ctx, code)

/** The number this platform gives the user-defined signal `which`, 1 or 2: the one signal number the
 * library names that differs between the platforms it runs on. */
user_signal(which: int) -> int = if which == 1 then USR1 else USR2

/** The number this platform gives the job-control or child signal `which`: 1 stop, 2 continue,
 * 3 terminal stop, 4 child ended. Like the user signals, their numbers differ between the platforms
 * the library runs on. */
job_signal(which: int) -> int = if which == 1 then STOP else if which == 2 then CONT else if which == 3 then TSTP else CHLD
