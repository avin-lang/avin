module avin.rt
@tests

import sysl.net.{Socket, resolve, socket, timed_out, would_block}
import sysl.io.poll.{Event, Poller}
import sysl.io.wait.{Readable, Writable}
import sysl.time.monotonic

// The poller's tokens, and the waits and operations of a thread that is not lightweight, which waits
// on the descriptor alone. A lightweight thread's parking is exercised by the programs that serve
// connections from threads (`tests/run/net_lwt_sockets.avin`).

private var parked: [3]Waiter = [new_waiter(); 3]

@test("a token names its slot only until the slot is let go, and a slot taken again names a new token")
tokens_name_their_slots_once()
    io_lock.lock()
    val a = take_slot(&parked[0])
    val b = take_slot(&parked[1])
    assert(a != b)
    assert(give_slot(a) == &parked[0])
    // A report that arrives after its wait has ended wakes nobody.
    assert(give_slot(a) == null)
    // The slot is taken again under a token the old one does not match.
    val c = take_slot(&parked[2])
    assert(c != a)
    assert(c & 4294967295 == a & 4294967295)
    assert(give_slot(a) == null)
    assert(give_slot(c) == &parked[2])
    assert(give_slot(b) == &parked[1])
    // A token for a slot that never existed names nobody.
    assert(give_slot(u64(1) << 32 | 100000) == null)
    io_lock.unlock()

// A listener on this machine and a connection to it, both non-blocking, and the accepted end.
private struct Ends
    listener: Socket
    client: Socket
    served: Socket

private ends() -> Ends
    val at = resolve("127.0.0.1", 0).unwrap()[0]
    var l = socket(at).unwrap()
    l.bind(at).unwrap()
    l.listen().unwrap()
    socket_non_blocking(&l).unwrap()
    val to = l.local().unwrap()
    val c = socket(to).unwrap()
    socket_connect(c, to).unwrap()
    val (s, _) = socket_accept(l).unwrap()
    Ends(l, c, s)

@test("a wait with a limit on a socket nothing arrives on answers not ready once the limit has passed")
fd_wait_times_out()
    val e = ends()
    val before = monotonic()
    assert(!wait_for_fd(e.served.fd().unwrap(), Readable, 30).unwrap())
    assert((monotonic() - before).us >= 30000)
    assert(wait_for_fd(e.served.fd().unwrap(), Writable, 30).unwrap())

@test("bytes sent arrive, a receive with a limit and nothing to read times out, and the end of the input is zero")
send_and_receive()
    val e = ends()
    socket_send_all(e.client, "ping".bytes, 0).unwrap()
    var into: [8]u8 = [0; 8]
    assert_eq(socket_recv(e.served, into[..], 1000).unwrap(), 4usize)
    socket_recv(e.served, into[..], 20) match
        Ok(_) -> panic("nothing was sent")
        Err(err) -> assert(timed_out(err))
    var c = e.client
    c.close().unwrap()
    assert_eq(socket_recv(e.served, into[..], 1000).unwrap(), 0usize)

@test("an accepted connection is non-blocking, so a receive with nothing to read answers would-block rather than waiting")
accepted_is_non_blocking()
    val e = ends()
    var s = e.served
    s.recv([0u8; 1][..]) match
        Ok(_) -> panic("nothing was sent")
        Err(err) -> assert(would_block(err))

@test("a connection nobody listens for is refused")
connect_refused()
    val at = resolve("127.0.0.1", 0).unwrap()[0]
    var l = socket(at).unwrap()
    l.bind(at).unwrap()
    val to = l.local().unwrap()
    l.close().unwrap()
    socket_connect(socket(to).unwrap(), to) match
        Ok(_) -> panic("nobody listens")
        Err(err) -> assert(net_failure(err) is Refused)

private var waiting: [2]Waiter = [new_waiter(); 2]

// A report of `fd`, as the poller's thread reads one.
private report(fd: int, readable: bool, writable: bool, hangup: bool, error: bool) -> Event
    var e = Event.none
    e.token = u64(fd)
    e.readable = readable
    e.writable = writable
    e.hangup = hangup
    e.error = error
    e

// Under `io_lock`: a slot for each direction of `fd`, both waited for at once.
private both_ways(p: Poller, fd: int) -> (u64, u64)
    val r = take_slot(&waiting[0])
    val w = take_slot(&waiting[1])
    begin_fd_wait(p, fd, Readable, r).unwrap()
    begin_fd_wait(p, fd, Writable, w).unwrap()
    assert_eq(io_fds[usize(fd)].reading, r)
    assert_eq(io_fds[usize(fd)].writing, w)
    (r, w)

@test("a descriptor waited on for reading and for writing at once keeps both waiters, and a report of one direction wakes that direction's alone")
two_directions_on_one_descriptor()
    val e = ends()
    val fd = e.served.fd().unwrap()
    io_lock.lock()
    val p = poller().unwrap()
    val (r, w) = both_ways(p, fd)
    reported(p, report(fd, true, false, false, false))
    assert_eq(io_fds[usize(fd)].reading, 0u64)
    assert_eq(io_fds[usize(fd)].writing, w)
    // The report let the reader's slot go, and the writer's is still taken.
    assert(give_slot(r) == null)
    reported(p, report(fd, false, true, false, false))
    assert_eq(io_fds[usize(fd)].writing, 0u64)
    assert(give_slot(w) == null)
    // Writable first, the other way round.
    val (r2, w2) = both_ways(p, fd)
    reported(p, report(fd, false, true, false, false))
    assert_eq(io_fds[usize(fd)].reading, r2)
    assert_eq(io_fds[usize(fd)].writing, 0u64)
    assert(give_slot(w2) == null)
    reported(p, report(fd, true, false, false, false))
    assert(give_slot(r2) == null)
    io_lock.unlock()

@test("a hang-up with one direction named wakes that direction alone, a hang-up naming neither or a failure wakes both, and a report for a descriptor nobody waits on wakes nobody")
hangups_and_failures()
    val e = ends()
    val fd = e.served.fd().unwrap()
    io_lock.lock()
    val p = poller().unwrap()
    // A peer that has only finished sending leaves the descriptor writable: the writer waits on.
    val (r, w) = both_ways(p, fd)
    reported(p, report(fd, true, false, true, false))
    assert_eq(io_fds[usize(fd)].reading, 0u64)
    assert_eq(io_fds[usize(fd)].writing, w)
    assert(give_slot(w) != null)
    end_fd_wait(fd, w)
    // A hang-up naming neither direction.
    val (r2, w2) = both_ways(p, fd)
    reported(p, report(fd, false, false, true, false))
    assert(give_slot(r2) == null)
    assert(give_slot(w2) == null)
    // A failure, with the readable direction named.
    val (r3, w3) = both_ways(p, fd)
    reported(p, report(fd, true, false, false, true))
    assert(give_slot(r3) == null)
    assert(give_slot(w3) == null)
    // Nobody waits now, and a report for a descriptor beyond any waited on is dropped.
    reported(p, report(fd, true, true, false, false))
    reported(p, report(fd + 100000, true, true, false, false))
    assert_eq(io_fds[usize(fd)].reading, 0u64)
    assert_eq(io_fds[usize(fd)].writing, 0u64)
    io_lock.unlock()

@test("a wait that ends by itself takes its direction's waiter off the descriptor and leaves the other's")
ended_wait_leaves_the_other_direction()
    val e = ends()
    val fd = e.served.fd().unwrap()
    io_lock.lock()
    val p = poller().unwrap()
    val (r, w) = both_ways(p, fd)
    _ = give_slot(r)
    end_fd_wait(fd, r)
    assert_eq(io_fds[usize(fd)].reading, 0u64)
    assert_eq(io_fds[usize(fd)].writing, w)
    // Ending it again, or under a token it never had, changes nothing.
    end_fd_wait(fd, r)
    end_fd_wait(fd, 12345)
    assert_eq(io_fds[usize(fd)].writing, w)
    _ = give_slot(w)
    end_fd_wait(fd, w)
    assert_eq(io_fds[usize(fd)].writing, 0u64)
    // A descriptor that is not one is refused, and leaves nothing waiting.
    val t = take_slot(&waiting[0])
    assert(begin_fd_wait(p, -1, Readable, t).is_err())
    assert(give_slot(t) == &waiting[0])
    io_lock.unlock()

@test("a socket is writable until its buffers fill, a send of some sends at least one byte while it is, and then waits at most its limit; a send of nothing sends nothing at once; once the peer has read everything, a send goes through again")
send_some_until_full()
    val e = ends()
    val fd = e.client.fd().unwrap()
    val block = [7u8; 65536]
    assert_eq(socket_send_some(e.client, block[0..<0], 0).unwrap(), 0usize)
    assert(socket_writable(e.client))
    assert(descriptor_writable(fd))
    // The kernel moves queued bytes on to the peer, and takes them out of the sender's buffer, after the
    // send that queued them has returned, so a socket found without room can have room again a moment
    // later, until the peer's receive buffer has filled as well. Room only grows while nothing is sent:
    // the descriptor looked at between two looks at the socket that both find no room has none either.
    // Filling goes on until a send with a limit finds no room for its whole limit.
    var sent: usize = 0
    var full = false
    while !full
        while socket_writable(e.client)
            val n = socket_send_some(e.client, block[..], 0).unwrap()
            assert(n >= 1)
            sent += n
        val between = descriptor_writable(fd)
        if socket_writable(e.client) then continue
        assert(!between)
        socket_send_some(e.client, block[..], 20) match
            Ok(n) ->
                assert(n >= 1)
                sent += n
            Err(err) ->
                assert(timed_out(err))
                full = true
    assert(sent > 0)
    // The peer reads every byte sent, and the connection has room again.
    var into: [65536]u8 = [0; 65536]
    var got: usize = 0
    while got < sent
        val n = socket_recv(e.served, into[..], 5000).unwrap()
        assert(n >= 1)
        assert(into[0] == 7)
        got += n
    assert_eq(got, sent)
    assert(socket_send_some(e.client, block[..], 5000).unwrap() >= 1)
    // A descriptor that is not one counts as writable, so the write that follows answers why.
    assert(descriptor_writable(-1))

@test("a socket shared for the other half of a connection names its descriptor, and closing either closes both")
shared_socket_is_one_descriptor()
    val e = ends()
    var shared = socket_share(e.client)
    assert_eq(shared.fd().unwrap(), e.client.fd().unwrap())
    shared.close().unwrap()
    assert(e.client.fd().is_err())
    assert(socket_writable(e.client))
