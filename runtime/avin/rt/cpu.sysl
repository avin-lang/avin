module avin.rt

import sysl.fs.{IoError, from_errno}
import sysl.process.Status

// CPU time, read from the kernel's own accounting: `getrusage` for the program itself and for the
// children it has reaped, and `wait4` for one child at the moment it is reaped. A child's figure
// takes in every descendant it reaped in turn, so the CPU of a whole tree of processes reaches the
// program through the one child it started, once each process in the tree was waited for by its
// parent.

/** A `struct timeval` as the 64-bit platforms the runtime builds for lay it out: whole seconds, then
 * microseconds, which Linux keeps in a 64-bit field and macOS in a 32-bit one followed by padding.
 * Both are little-endian, so the low half read here is the count on either. */
struct TimeVal
    sec: i64
    usec: i32
    pad: i32

/** A `struct rusage`: the user and system CPU times, then fourteen counters not read here. */
struct RUsage
    user: TimeVal
    system: TimeVal
    rest: [14]i64

private extern "getrusage" c_getrusage(who: int, usage: *RUsage) -> int
private extern "wait4" c_wait4(pid: i32, status: *i32, options: int, usage: *RUsage) -> i32

#if bsd
private extern "__error" cpu_errno_location() -> *i32
#elif android
private extern "__errno" cpu_errno_location() -> *i32
#else
private extern "__errno_location" cpu_errno_location() -> *i32
#endif

// The same numbers on every platform the runtime builds for.
private const RusageSelf: int = 0
private const RusageChildren: int = -1
private const NoHang: int = 1
private const Interrupted: int = 4

/** CPU time used, in microseconds: in user mode and in the kernel on the process's behalf. */
struct CpuReading
    user: i64
    system: i64

    user_micros(self) -> long = self.user
    system_micros(self) -> long = self.system
end CpuReading

/** What one wait for a child found: whether it had ended, and if so how and with what CPU time, its
 * reaped descendants' included. */
struct Reaped
    done: bool
    how: Status
    user: i64
    system: i64

    ended(self) -> bool = self.done
    status(self) -> Status = self.how
    user_micros(self) -> long = self.user
    system_micros(self) -> long = self.system
end Reaped

private micros_of(t: TimeVal) -> i64 = t.sec * 1000000 + i64(t.usec)

private no_usage() -> RUsage = RUsage(TimeVal(0, 0, 0), TimeVal(0, 0, 0), [0; 14])

private cpu_of(who: int) -> CpuReading
    var u = no_usage()

    // `getrusage` fails only for a `who` it does not know, and both asked for here are POSIX's.
    if c_getrusage(who, &u) != 0 then return CpuReading(0, 0)

    CpuReading(micros_of(u.user), micros_of(u.system))

/** The CPU time the program has used, every thread's together. */
cpu_self() -> CpuReading = cpu_of(RusageSelf)

/** The CPU time of the program's children that have ended and been reaped, each with the children it
 * reaped in turn. */
cpu_children() -> CpuReading = cpu_of(RusageChildren)

/** A wait status read as `sysl.process` reads one: an exit code, or the signal that ended it. */
private decoded(raw: i32) -> Status =
    if (raw & 127) == 0 then Status.Exited(int((raw >> 8) & 255)) else Status.Signalled(int(raw & 127))

private reap(pid: int, options: int) -> Result[Reaped, IoError]
    var u = no_usage()
    var raw: i32 = 0

    while true
        val got = c_wait4(i32(pid), &raw, options, &u)

        if got == i32(pid) then return Ok(Reaped(true, decoded(raw), micros_of(u.user), micros_of(u.system)))
        if got == 0 then return Ok(Reaped(false, Status.Exited(0), 0, 0))

        // A signal arriving during the wait is not the child's doing, so the wait is asked again.
        val code = cpu_errno_location()[0]

        if code != Interrupted then return Err(from_errno(int(code)))

    Ok(Reaped(false, Status.Exited(0), 0, 0))

/** Waits for the child `pid` to end and reaps it, answering how it ended and its CPU time. */
@blocks
reap_usage(pid: int) -> Result[Reaped, IoError] = reap(pid, 0)

/** Reaps the child `pid` if it has ended, without waiting: `ended()` is false while it runs. */
poll_usage(pid: int) -> Result[Reaped, IoError] = reap(pid, NoHang)
