module avin.rt

import sysl.raw.ptr_cast

// Type records: what a type pattern reads to learn an object's type. The compiler writes one record
// per type as constant data, and every descriptor of an object of that type names it, so a record's
// address is its type's identity at run time. A record holds the addresses of the records of the
// type's ancestors: the classes and traits a class conforms to, with their type arguments. A tuple
// type's record holds its parts' records instead, so a tuple is tested against another tuple type
// part by part. A string's descriptor names no record.

/** The head of a type record; the addresses of `count` ancestors' records follow it, and then those
 * of `parts` parts' records. `equals` and `hash` are the type's equality entries, compiled code that
 * `==` and the hash on values of unknown type call; `display` and `debug` its rendering entries,
 * which showing such values calls. The runtime never calls them. `apart` is nonzero for a type whose
 * objects keep the owners of the handles they hold when a value reaching them is handed over
 * (`hand_over`). `parts` is the number of a tuple type's parts, and zero for every other type.
 * `part_view` is how many of the first ancestors a value of the type is seen as when it is a tuple's
 * part: those a class or data type has by its declarations, which keep a part's representation. */
struct TypeRecord
    count: usize
    equals: *u8
    hash: *u8
    display: *u8
    debug: *u8
    apart: usize
    parts: usize
    part_view: usize

/** Whether the type whose record is `record` is the type whose record is `target` or has it among
 * its ancestors, or both are tuple types of as many parts and each of `record`'s parts is seen as
 * `target`'s; nonzero when it does. */
@export("avin_rt_conforms")
conforms(ctx: *Context, record: *u8, target: *u8) -> int
    if record == target then return 1
    if record == null || target == null then return 0
    val head: *TypeRecord = ptr_cast(record)
    val ancestors: **u8 = ptr_cast(usize(record) + sizeof(TypeRecord))
    for i in 0..<head.count
        if ancestors[i] == target then return 1
    tuple_conforms(record, target)

/** Whether a tuple's part, of the type whose record is `record`, is seen as one of the type whose
 * record is `target`: the same type, one of its first `part_view` ancestors, or a tuple type seen as
 * it part by part. */
private part_conforms(record: *u8, target: *u8) -> bool
    if record == target then return true
    if record == null || target == null then return false
    val head: *TypeRecord = ptr_cast(record)
    val ancestors: **u8 = ptr_cast(usize(record) + sizeof(TypeRecord))
    for i in 0..<head.part_view
        if ancestors[i] == target then return true
    tuple_conforms(record, target) != 0

/** Whether the records `record` and `target` are of tuple types of as many parts, each of the first's
 * parts seen as the second's; nonzero when they are. */
private tuple_conforms(record: *u8, target: *u8) -> int
    val head: *TypeRecord = ptr_cast(record)
    val goal: *TypeRecord = ptr_cast(target)
    if head.parts == 0 || head.parts != goal.parts then return 0
    val mine: **u8 = ptr_cast(usize(record) + sizeof(TypeRecord) + head.count * sizeof(usize))
    val theirs: **u8 = ptr_cast(usize(target) + sizeof(TypeRecord) + goal.count * sizeof(usize))
    for i in 0..<head.parts
        if !part_conforms(mine[i], theirs[i]) then return 0
    1
