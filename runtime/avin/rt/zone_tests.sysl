module avin.rt

import sysl.posix.time.zoneinfo_root

private new_york() -> []u8 = zone_file_bytes(zoneinfo_root() + "/America/New_York").unwrap()

@test("a zone's file is read, and a file that is not there answers None")
zone_file_is_read()
    assert(zone_file_bytes(zoneinfo_root() + "/America/New_York").is_some())
    assert(zone_file_bytes(zoneinfo_root() + "/Mars/Olympus_Mons").is_none())

@test("a tz database file decodes, and bytes that are not one do not")
zone_table_validity()
    assert(zone_table_valid(new_york()))
    assert(!zone_table_valid([]))
    val junk: []u8 = [u8('n'), u8('o'), u8('t'), u8(' '), u8('a'), u8(' '), u8('z'), u8('o')]
    assert(!zone_table_valid(junk))

@test("New York's offset, daylight saving and abbreviation either side of a transition")
zone_answers_across_a_transition()
    val ny = new_york()
    // 2026-03-08T06:59:59Z is 01:59:59 EST; a second later the clocks show 03:00:00 EDT.
    val before: long = 1772953199000000
    val after: long = 1772953200000000
    assert(zone_offset_minutes(ny, before) == -300)
    assert(zone_offset_minutes(ny, after) == -240)
    assert(!zone_is_dst(ny, before))
    assert(zone_is_dst(ny, after))
    assert(zone_abbreviation(ny, before) == "EST")
    assert(zone_abbreviation(ny, after) == "EDT")

@test("a table that does not decode answers zero, no daylight saving and no abbreviation")
zone_answers_from_a_bad_table()
    assert(zone_offset_minutes([], 0) == 0)
    assert(!zone_is_dst([], 0))
    assert(zone_abbreviation([], 0) == "")

@test("a link's target is read, and a file that is no link answers None")
zone_link_is_read()
    assert(zone_link_target(zoneinfo_root() + "/Mars/Olympus_Mons").is_none())
