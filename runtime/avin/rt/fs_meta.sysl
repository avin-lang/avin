module avin.rt

import sysl.fs.{IoError, metadata, set_modified, set_permissions}
import sysl.time.Instant

/** What one `stat` of a path answered, as the five facts `avin.fs.metadata` hands on: the size in
 * bytes, the modification time in microseconds since 1970-01-01T00:00:00 UTC, whether the path names
 * a directory or something else, and the twelve permission bits (the nine `rwx` with setuid, setgid
 * and the sticky bit). */
struct FsStat
    bytes: long
    micros: long
    dir: bool
    file: bool
    mode: int

    size_bytes(self) -> long = self.bytes
    modified_micros(self) -> long = self.micros
    is_dir(self) -> bool = self.dir
    is_file(self) -> bool = self.file
    permission_bits(self) -> int = self.mode
end FsStat

/** One reading of `path`, following a symbolic link. */
fs_stat(path: string) -> Result[FsStat, IoError]
    metadata(path) match
        Ok(m) -> Ok(FsStat(m.size, m.modified.us, m.is_dir(), !m.is_dir(), int(m.permissions())))
        Err(e) -> Err(e)

/** Sets the modification time of `path` (and its access time) to `micros` since the epoch. */
fs_set_modified(path: string, micros: long) -> Result[unit, IoError] = set_modified(path, Instant(micros))

/** Sets the twelve permission bits of `path` to `mode`, following a symbolic link. The caller has
 * checked that `mode` is within `0o0`..`0o7777`. */
fs_set_permissions(path: string, mode: int) -> Result[unit, IoError] = set_permissions(path, u32(mode))
