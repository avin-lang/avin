module avin.rt

import sysl.buf.{Buf, buf}
import sysl.fs.{IoError, InvalidUtf8, Meta, Regular, Directory, Symlink, Special, entry_bytes, link_metadata, metadata, set_modified, set_permissions}
import sysl.text.from_utf8
import sysl.time.Instant

/** The names in the directory `path`, `.` and `..` left out, in the order the file system keeps them.
 * A name that is not UTF-8 is `InvalidUtf8` when `skip` is false, and left out when it is true. */
fs_entry_names(path: string, skip: bool) -> Result[Buf[string], IoError]
    var names: Buf[string] = buf()

    for name in entry_bytes(path)?.view()
        from_utf8(name) match
            Ok(s) -> names.push(s)
            Err(e) -> if !skip then return Err(InvalidUtf8(e.offset))

    Ok(names)
end fs_entry_names


/** What one `stat` of a path answered, as the facts `avin.fs.metadata` hands on: the size in bytes;
 * the modification, access and status-change times in microseconds since 1970-01-01T00:00:00 UTC;
 * whether the path names a directory and whether a regular file; the twelve permission bits (the
 * nine `rwx` with setuid, setgid and the sticky bit); the file type as the platform's type bits
 * (`0o100000` a regular file, `0o040000` a directory, `0o120000` a symbolic link, and the rest as
 * `stat` reports them); the owner's user and group ids; the number of hard links; and the inode
 * and device numbers. */
struct FsStat
    bytes: long
    micros: long
    dir: bool
    file: bool
    mode: int
    type_bits: int
    accessed: long
    changed: long
    owner: long
    group: long
    links: long
    inode: long
    device: long

    size_bytes(self) -> long = self.bytes
    modified_micros(self) -> long = self.micros
    is_dir(self) -> bool = self.dir
    is_file(self) -> bool = self.file
    permission_bits(self) -> int = self.mode
    kind_bits(self) -> int = self.type_bits
    accessed_micros(self) -> long = self.accessed
    changed_micros(self) -> long = self.changed
    owner_id(self) -> long = self.owner
    group_id(self) -> long = self.group
    link_count(self) -> long = self.links
    inode_number(self) -> long = self.inode
    device_number(self) -> long = self.device
end FsStat

/** The type bits of `m`, read through `Meta.kind`. */
private type_bits_of(m: Meta) -> int = m.kind() match
    Regular -> 0o100000
    Directory -> 0o040000
    Symlink -> 0o120000
    Special(bits) -> int(bits)

private stat_of(m: Meta) -> FsStat =
    FsStat(m.size, m.modified.us, m.is_dir(), m.is_file(), int(m.permissions()), type_bits_of(m), m.accessed.us,
        m.changed.us, long(m.owner), long(m.group), long.wrap(m.links), long.wrap(m.inode), long.wrap(m.device))

/** One reading of `path`, following a symbolic link. */
fs_stat(path: string) -> Result[FsStat, IoError]
    metadata(path) match
        Ok(m) -> Ok(stat_of(m))
        Err(e) -> Err(e)

/** One reading of `path` itself: a symbolic link is described, not followed. */
fs_link_stat(path: string) -> Result[FsStat, IoError]
    link_metadata(path) match
        Ok(m) -> Ok(stat_of(m))
        Err(e) -> Err(e)

/** Sets the modification time of `path` (and its access time) to `micros` since the epoch. */
fs_set_modified(path: string, micros: long) -> Result[unit, IoError] = set_modified(path, Instant(micros))

/** Sets the twelve permission bits of `path` to `mode`, following a symbolic link. The caller has
 * checked that `mode` is within `0o0`..`0o7777`. */
fs_set_permissions(path: string, mode: int) -> Result[unit, IoError] = set_permissions(path, u32(mode))
