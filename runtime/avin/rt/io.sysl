module avin.rt

// Entry points compiled Avin code calls with the C convention. Their names and signatures are a
// private contract with the compiler's intrinsics. Each takes the calling thread's context first.

/** Writes the string at `text`, then a new line, to standard output. */
@export("avin_rt_print_line")
print_line(ctx: *Context, text: *u8)
    write_out(ctx, text)
    putbytes("\n".bytes)

/** Writes the string at `text` to standard output, with nothing after it. */
@export("avin_rt_write_out")
write_out(ctx: *Context, text: *u8)
    val data = text_bytes(text)
    putbytes(data[0..<text_length(text)])

/** Sends everything written to standard output so far on its way, whether or not a line is complete. */
@export("avin_rt_flush_out")
flush_out(ctx: *Context)
    flush()

/** Writes the string at `text` to standard error, flushing standard output first so that what the
 * program wrote to the two streams arrives in the order it wrote it. Standard error keeps no buffer:
 * the text has left when this returns. */
@export("avin_rt_write_err")
write_err(ctx: *Context, text: *u8)
    flush()
    val data = text_bytes(text)
    eputbytes(data[0..<text_length(text)])

/** Writes the decimal digits of `value`, with a sign when it is negative, to standard output,
 * rendered on the stack. */
@export("avin_rt_write_int")
write_int(ctx: *Context, value: long)
    printi(value)
