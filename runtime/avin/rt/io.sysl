module avin.rt

import sysl.buf.{Buf, buf}
import sysl.text.from_utf8_unchecked

// Entry points compiled Avin code calls with the C convention. Their names and signatures are a
// private contract with the compiler's intrinsics.

/** Writes the string at `text`, then a new line, to standard output. */
@export("avin_rt_print_line")
print_line(text: *u8)
    val data = text_bytes(text)
    var bytes: Buf[u8] = buf()
    for i in 0..<text_length(text) do bytes.push(data[i])
    print(from_utf8_unchecked(bytes.view()))
