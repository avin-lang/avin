module avin.rt

import sh.sysl.gc
import sysl.raw.ptr_cast

// Avin's arrays. An array is a reference to an object holding its length and then its elements,
// each its element type's width, with no gaps; its descriptor is in the header the collector keeps
// before it. An array descriptor's `size` is one element's size, and its kind's tracer says which of
// an element's words are references, in one of three ways:
//
// - `avin_rt_trace_array`: every element is one reference, and the tracer marks each. The
//   descriptor lists no offsets.
// - `avin_rt_trace`, the ordinary tracer: no element holds a reference. The descriptor lists no
//   offsets, so the tracer marks nothing.
// - `avin_rt_trace_array_map`: an element is `size` bytes, some of its words references and the
//   rest scalars, and the descriptor's offsets are the element's map: the byte offset, within each
//   element, of every word that holds a reference. The tracer marks those words of every element
//   and never reads the others, so a scalar word whose bits look like a heap address keeps nothing
//   alive.
//
// The first two are the fast paths, and the compiler uses them whenever they fit; the map is for an
// element of several words that mixes the two, such as a union's tag, bits and reference.

/** The header of an array object. `length` elements follow it. */
struct ArrayHeader
    length: usize

/** The length of the array at `p`. */
array_length(p: *u8) -> usize
    val h: *ArrayHeader = ptr_cast(p)
    h.length

/** The first element of the array at `p`. */
array_elements(p: *u8) -> *u8 = ptr_cast(usize(p) + sizeof(ArrayHeader))

/** A new array of `length` elements laid out by `d`, every byte zero, for the caller to fill before
 * anything else sees it. The compiler has checked that `length` is a non-negative `int`. Allocating
 * may collect, so every reference the caller still needs must be a root. The array's header and its
 * zero bytes are published: a thread that reads a reference to it sees its length. */
@export("avin_rt_new_array")
new_array(ctx: *Context, d: *Descriptor, length: usize) -> *u8 = published(made_array(ctx, d, length))

// A new array as `new_array` makes it, for a caller here that fills it and then publishes it.
private made_array(ctx: *Context, d: *Descriptor, length: usize) -> *u8
    val p = allocate_sized(ctx, d, sizeof(ArrayHeader) + length * d.size)
    val h: *ArrayHeader = ptr_cast(p)
    h.length = length
    p

/** A new array of the elements of `p` from `from` up to `until`, which the compiler has checked lie
 * in order within it. `p` stays alive while the new array is allocated, since the caller holds it as
 * a root, and the collector never moves an object. */
@export("avin_rt_array_slice")
array_slice(ctx: *Context, p: *u8, from: int, until: int) -> *u8
    val d = descriptor_of(p)
    val n = usize(until - from)
    val q = made_array(ctx, d, n)
    val size = d.size
    val source = array_elements(p)
    val target = array_elements(q)
    val start = usize(from) * size
    for i in 0..<n * size do target[i] = source[start + i]
    published(q)

/** Sets the elements of `p` from `from` up to `until`, which the compiler has checked lie in order
 * within it, to zero bytes. */
@export("avin_rt_array_clear")
array_clear(ctx: *Context, p: *u8, from: int, until: int)
    val size = descriptor_of(p).size
    val elements = array_elements(p)
    for i in usize(from) * size ..< usize(until) * size do elements[i] = 0

// The tracer of an array whose elements are references. An element may still be null in an array
// being filled, or a constant object outside the heap; the collector ignores both.
@export("avin_rt_trace_array")
trace_array(p: *u8, h: *gc.Heap)
    var m = HeapMarker(h)
    scan_references(p, &m)

// The tracer of an array whose elements hold references at the offsets its descriptor maps. A word
// the map names may be null, or a constant object outside the heap, as a field may.
@export("avin_rt_trace_array_map")
trace_array_map(p: *u8, h: *gc.Heap)
    var m = HeapMarker(h)
    scan_mapped(p, &m)

/** What reading an object's reference words does with each one: a collection marks it, and handing
 * a value over follows it. Every tracer reads its object's words through one, so whatever reads them
 * reads exactly the words a collection does. */
trait Marker
    mark(*self, p: *u8)

/** The marker of a collection: each word read marks its object in `heap`. */
struct HeapMarker
    heap: *gc.Heap

impl Marker for HeapMarker
    mark(*self, p: *u8) = gc.mark(self.heap, p)

/** Reads every word of the object at `p` that holds a reference, as its descriptor's tracer reads
 * them, giving each to `m`: every element of an array of references, the mapped words of every
 * element of an array with an element map, and otherwise the fields at the descriptor's offsets. */
scan_object[M: Marker](p: *u8, m: *M)
    val tracer = descriptor_of(p).kind.trace
    if tracer == &trace_array then scan_references(p, m)
    else if tracer == &trace_array_map then scan_mapped(p, m)
    else scan_fields(p, m)

/** Reads every element of the array of references at `p`. */
scan_references[M: Marker](p: *u8, m: *M)
    val elements: **u8 = ptr_cast(array_elements(p))
    for i in 0..<array_length(p)
        m.mark(elements[i])

/** Reads, in every element of the array at `p`, the words its descriptor's element map names. */
scan_mapped[M: Marker](p: *u8, m: *M)
    val d = descriptor_of(p)
    val offsets: *usize = ptr_cast(usize(d) + sizeof(Descriptor))
    val size = d.size
    val refs = d.refs
    var element = usize(array_elements(p))
    for _ in 0..<array_length(p)
        for j in 0..<refs
            val word: **u8 = ptr_cast(element + offsets[j])
            m.mark(word[0])
        element = element + size

/** Reads the fields of the object at `p` at its descriptor's offsets, counted from its start. */
scan_fields[M: Marker](p: *u8, m: *M)
    val d = descriptor_of(p)
    val offsets: *usize = ptr_cast(usize(d) + sizeof(Descriptor))
    for i in 0..<d.refs
        val field: **u8 = ptr_cast(usize(p) + offsets[i])
        m.mark(field[0])
