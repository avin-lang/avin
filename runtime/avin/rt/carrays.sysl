module avin.rt

// Arrays crossing a C binding. A call that is not `blocking` is passed a pointer to an array's
// elements in place, since no collection runs while it holds the thread, and the collector never moves
// an object. A `blocking` call is passed a copy of them off the collected heap, made before the thread
// is marked safe and copied back, where C may have written it, once the thread is running again. An
// array in an `Option` is null for `None`, which passes null and a length of zero.

private extern "malloc" copy_malloc(size: usize) -> *u8
private extern "free" copy_free(p: *u8) -> unit

/** The first element of the array at `a`, or null for null. */
@export("avin_rt_c_array_elements")
c_array_elements(ctx: *Context, a: *u8) -> *u8 = if a == null then null else array_elements(a)

/** The length of the array at `a`, or zero for null. */
@export("avin_rt_c_array_length")
c_array_length(ctx: *Context, a: *u8) -> i32 = if a == null then 0 else i32(array_length(a))

/** The most a length C writes back for the array at `a` may be: its length, or, for null, which asks
 * C the length it needs, the greatest `long`. */
@export("avin_rt_c_array_limit")
c_array_limit(ctx: *Context, a: *u8) -> i64 = if a == null then 9223372036854775807 else i64(array_length(a))

/** A copy off the heap of the elements of the array at `a`, each `size` bytes, for one `blocking`
 * call; null for null. An empty array's copy is a byte long, so C is never passed null for it. */
@export("avin_rt_c_array_copy")
c_array_copy(ctx: *Context, a: *u8, size: i64) -> *u8
    if a == null then return null
    val n = array_length(a) * usize(size)
    val p = copy_malloc(if n == 0 then 1 else n)
    if p == null
        begin_stop(ctx)
        flush()
        eprints("avin: out of memory: no room for a copy of an array of " + n.to_string() + " bytes passed to C\n")
        end_trapped(ctx)
    val from = array_elements(a)
    for i in 0..<n do p[i] = from[i]
    p

/** Copies the copy `p` made of the array at `a` back into it where `write` is not zero, C having
 * been free to write it, and frees it. */
@export("avin_rt_c_array_back")
c_array_back(ctx: *Context, a: *u8, p: *u8, size: i64, write: i32)
    if p == null then return
    if write != 0
        val n = array_length(a) * usize(size)
        val to = array_elements(a)
        for i in 0..<n do to[i] = p[i]
    copy_free(p)
