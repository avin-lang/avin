module avin.rt

import sysl.fs.{File, IoError, Mapped, MappedMut, open_update}
import sysl.slices.copy

// What `avin.fs`'s mapped files reach of a mapping: one byte read or written, a range copied out into
// a new array, and an array's bytes copied in. The caller has checked
// every offset against the mapping's length, so the casts to `usize` never meet a negative value and
// every index is inside the view; Sysl's own bounds check stays behind them.

/** The file at `path`, opened for reading and writing and mapped shared and writable over its whole
 * length. The file is closed before this answers; the mapping does not need it. */
fs_map_mutable(path: string) -> Result[&MappedMut, IoError]
    var f = open_update(path)?

    // The mapping outlives the descriptor, and nothing was written through the file to report.
    defer _ = f.close()

    f.map_mut()
end fs_map_mutable

/** The open file `f` mapped shared and writable over its whole length. */
fs_file_map_mutable(f: *File) -> Result[&MappedMut, IoError] = f.map_mut()

/** The byte at offset `at` of a read-only mapping. */
fs_mapped_byte(m: &Mapped, at: long) -> u8 = m.bytes()[usize(at)]

/** Copies the bytes of a read-only mapping from offset `from` on into all of `into`, which the binding
 * copies back into the array it was given. */
fs_mapped_read(m: &Mapped, from: long, into: []u8)
    val start = usize(from)

    copy(into, m.bytes()[start..<start + into.len])
end fs_mapped_read

/** The byte at offset `at` of a writable mapping. */
fs_mapped_mut_byte(m: &MappedMut, at: long) -> u8 = m.bytes()[usize(at)]

/** Writes `value` at offset `at` of a writable mapping. */
fs_mapped_mut_set(m: &MappedMut, at: long, value: u8)
    val v = m.bytes()

    v[usize(at)] = value
end fs_mapped_mut_set

/** Copies the bytes of a writable mapping from offset `from` on into all of `into`, as `fs_mapped_read`. */
fs_mapped_mut_read(m: &MappedMut, from: long, into: []u8)
    val start = usize(from)

    copy(into, m.bytes()[start..<start + into.len])
end fs_mapped_mut_read

/** Writes what was written through a writable mapping to its file, returning once it is there. */
fs_mapped_mut_flush(m: &MappedMut) -> Result[unit, IoError] = m.flush()

/** Copies every byte of `bytes` into a writable mapping from offset `at` on. */
fs_mapped_mut_write(m: &MappedMut, at: long, bytes: []const u8)
    val v = m.bytes()
    val start = usize(at)

    copy(v[start..<start + bytes.len], bytes)
end fs_mapped_mut_write
