module avin.rt

import sysl.buf.{Buf, buf}
import sysl.crypto.{hmac256, hmac512, md5, sha1, sha256, sha512}

// The bytes of a fixed-size digest as a buffer, the shape a binding turns into a vector.
private digest_bytes(d: []const u8) -> Buf[u8]
    var out: Buf[u8] = buf()
    for b in d do out.push(b)
    out

/** `avin.crypto`'s one-shot digests: the SHA-256, SHA-512, SHA-1 and MD5 of `bytes`. */
digest_sha256(bytes: []const u8) -> Buf[u8] = digest_bytes(sha256(bytes)[..])
digest_sha512(bytes: []const u8) -> Buf[u8] = digest_bytes(sha512(bytes)[..])
digest_sha1(bytes: []const u8) -> Buf[u8] = digest_bytes(sha1(bytes)[..])
digest_md5(bytes: []const u8) -> Buf[u8] = digest_bytes(md5(bytes)[..])

/** HMAC-SHA-256 and HMAC-SHA-512 of `message` under `key`. */
digest_hmac_sha256(key: []const u8, message: []const u8) -> Buf[u8] = digest_bytes(hmac256(key, message)[..])
digest_hmac_sha512(key: []const u8, message: []const u8) -> Buf[u8] = digest_bytes(hmac512(key, message)[..])
