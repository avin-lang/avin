module avin.rt

import sysl.buf.{Buf, buf}
import sysl.crypto.{Md5, Sha1, Sha256, Sha512, hmac256, hmac512, md5, pbkdf2_hmac256, pbkdf2_hmac512, sha1, sha256, sha512}

// The bytes of a fixed-size digest as a buffer, the shape a binding turns into a vector.
private digest_bytes(d: []const u8) -> Buf[u8]
    var out: Buf[u8] = buf()
    for b in d do out.push(b)
    out

/** `avin.crypto`'s one-shot digests: the SHA-256, SHA-512, SHA-1 and MD5 of `bytes`. */
digest_sha256(bytes: []const u8) -> Buf[u8] = digest_bytes(sha256(bytes)[..])
digest_sha512(bytes: []const u8) -> Buf[u8] = digest_bytes(sha512(bytes)[..])
digest_sha1(bytes: []const u8) -> Buf[u8] = digest_bytes(sha1(bytes)[..])
digest_md5(bytes: []const u8) -> Buf[u8] = digest_bytes(md5(bytes)[..])

/** HMAC-SHA-256 and HMAC-SHA-512 of `message` under `key`. */
digest_hmac_sha256(key: []const u8, message: []const u8) -> Buf[u8] = digest_bytes(hmac256(key, message)[..])
digest_hmac_sha512(key: []const u8, message: []const u8) -> Buf[u8] = digest_bytes(hmac512(key, message)[..])

/** `avin.crypto`'s PBKDF2 (RFC 8018) over HMAC-SHA-256 and HMAC-SHA-512: `length` bytes of key. The caller
 *  has already refused an iteration count below one and a length the derivation cannot produce. */
digest_pbkdf2_sha256(password: []const u8, salt: []const u8, iterations: i32, length: i32) -> Buf[u8]
    var out: []u8 = [0; usize(length)]
    pbkdf2_hmac256(password, salt, u32(iterations), out).expect("a key of a length this can produce")
    digest_bytes(out)

digest_pbkdf2_sha512(password: []const u8, salt: []const u8, iterations: i32, length: i32) -> Buf[u8]
    var out: []u8 = [0; usize(length)]
    pbkdf2_hmac512(password, salt, u32(iterations), out).expect("a key of a length this can produce")
    digest_bytes(out)

/** A hasher fed `bytes[from ..< until]` in place, with no copy. The caller has checked
 *  `0 <= from <= until <= bytes.len`. */
digest_update_sha256(h: *Sha256, bytes: []const u8, from: i32, until: i32) = h.update(bytes[usize(from)..<usize(until)])
digest_update_sha512(h: *Sha512, bytes: []const u8, from: i32, until: i32) = h.update(bytes[usize(from)..<usize(until)])
digest_update_sha1(h: *Sha1, bytes: []const u8, from: i32, until: i32) = h.update(bytes[usize(from)..<usize(until)])
digest_update_md5(h: *Md5, bytes: []const u8, from: i32, until: i32) = h.update(bytes[usize(from)..<usize(until)])
