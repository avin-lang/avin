module avin.rt

import sh.sysl.gc
import sysl.env
import sysl.fiber
import sysl.raw.ptr_cast
import sysl.sync.*
import sysl.threads.{Condvar, Mutex, SleepLock}

// The collected heap. Objects are allocated by compiled code through `avin_rt_alloc` and found by
// the collector through the shadow stacks: every thread has a context, which compiled code receives
// as a hidden first argument, and every function that holds references links a frame of them into
// its thread's context while it runs, so the roots are exact and nothing is ever scanned. A
// collection walks the frames of every attached context, and the frames of module-level values,
// which belong to no thread.
//
// Threads share the heap. Each operating system thread running compiled code has a carrier, and
// allocates small objects from the chunk of the heap its carrier holds, with no lock; a thread takes
// the heap lock only to claim a fresh chunk, to allocate an object too large for one, or to collect.
// A context reaches the chunk through `carrier`, the carrier it is running on, so an allocation costs
// one load more than a chunk in the context itself would, and a context that is not running holds no
// chunk. Attaching a thread makes its carrier and detaching it retires the carrier's chunk; every
// collection retires the chunk of every carrier first, so the collector sees whole objects and free
// blocks only.
//
// A context's `carrier` changes only while the context is safe, at one of the runtime's own
// safepoints, and by a single store: no allocation of that context is then in progress, and its
// chunk stays with the carrier it leaves, so moving a context between carriers moves no chunk. The
// main thread and a thread the runtime attaches for a callback each have a carrier of their own; the
// lightweight threads share the carriers of the scheduler's worker threads (`scheduler.sysl`), and a
// worker stores its carrier in a lightweight thread's context just before it switches to it.
//
// That one lock, `heap_lock`, serializes claims, large allocations, collection and changes to the
// lists of contexts and carriers. A collection stops the world: the collecting thread raises the
// `Stop` bit of `requested`, waits until every other attached context is safe, collects, lowers the
// bit and wakes the others. A context is safe when its thread is parked at a safepoint, inside a
// region that touches no reference, such as a wait for the heap lock or a blocking call, or when it is
// a lightweight thread that is not running. Compiled code polls `requested` on every back edge of its
// control flow and before every call that may recur, and calls `avin_rt_safepoint` only when it is not
// zero; the `Stop` bit is never raised while one context is attached. The scheduler raises the other
// bit, `Yield`, when a lightweight thread has run past its time slice while another is ready, and the
// same call answers it (`scheduler.sysl`), so the poll stays one load and one branch.
//
// The heap is one block reserved at startup, `AVIN_HEAP_LIMIT` bytes or 8 GiB. The operating system
// commits its pages only as they are first touched, so the reservation costs nothing until it is
// used, and the heap grows within it.

/** One frame of the shadow stack. `count` reference slots follow this header in the frame, which
 * compiled code keeps on its own stack. */
struct Frame
    prev: *Frame
    count: usize

/** One thread's state. Compiled code passes it to every function and every runtime entry point, and
 * reads and writes `top`, its first word, directly: a function sets `top` to its own frame on entry
 * and back to its caller's on return. */
struct Context
    top: *Frame
    /** The next attached context. */
    next: *Context
    /** `Running` while the thread may read or write references; `Safe` while its frames hold every
     * reference it still needs and it touches none until it is running again. */
    state: Atomic[u32]
    /** Where the thread's code last entered the core library from the program's own code, or null
     * before it first has: a trap inside the library reports this place. Compiled code writes it
     * directly, at offset 24. */
    caller: *TrapSite
    /** The owner of the code the thread is running, which every use of a Sysl handle compares with
     * the handle's own (see `owners.sysl`). Compiled code reads it directly, at offset 32. */
    owner: u64
    /** The carrier the context is running on, whose chunk it allocates from, or null while the
     * context is not attached. Stored only while the context is safe. */
    carrier: *Carrier
    /** Where a trap in the actor the thread is running returns to, or null where the thread runs no
     * actor's turn (see `recovery.sysl`). */
    recovery: *Recovery
    /** How many regions the thread is inside that other threads may be waiting on or that Sysl code
     * is part of: a lock held, a `lazy val` being initialized, an Avin function Sysl called. A trap
     * inside one stops the program even in an actor. */
    doubt: u32
    /** The previous attached context, so a context leaves the list in one step however many there
     * are. */
    prev: *Context
    /** What the thread waits as, while it waits on a lock, a condition or a join (`scheduler.sysl`). */
    waiter: Waiter
    /** Where a cancellation of the thread returns to, or null where it has none (`cancel.sysl`). */
    cancel_point: *CancelPoint
    /** How many regions the thread is inside that its cancellation may not stop it in though no lock
     * is held: running what waits for a future it completed. */
    uncancellable: u32

@assert(offsetof(Context, caller) == 24, "the compiler writes a context's caller site at 24")
@assert(offsetof(Context, owner) == OwnerOffset, "the compiler reads a context's owner at 32")

/** A context's state while its thread may touch references. */
const Running: u32 = 0
/** A context's state while its thread is stopped for a collection or in a region that touches no
 * reference. */
const Safe: u32 = 1

/** A context no thread is running yet: safe, with an empty stack, and an owner of its own. */
new_context() -> Context = Context(null, null, Atomic(Safe), null, fresh_owner(), null, null, 0, null, new_waiter(), null, 0)

/** One operating system thread's state: the chunk of the heap that the contexts running on the thread
 * allocate from with no lock, and, on a worker of the scheduler, what the scheduler keeps about the
 * lightweight thread it runs. Only the context running on it touches the chunk, except under the heap
 * lock: by that context's thread, or by a collector while the context is safe. A carrier keeps itself
 * alive until its thread detaches; a worker's lives as long as the program. */
struct Carrier
    chunk: gc.Chunk
    /** The next carrier of an attached thread. */
    next: *Carrier
    me: Option[&Carrier]
    /** Whether the thread is one of the scheduler's workers, which run lightweight threads only. */
    worker: bool
    /** Where a lightweight thread switches back to: the worker's own stack, in its scheduling loop. */
    home: fiber.Context
    /** What the worker does once the lightweight thread it ran has switched back (`scheduler.sysl`),
     * with the guard to let go, and the waiter and time of a timed wait to register. */
    after: u32
    after_guard: *SleepLock
    after_waiter: *Waiter
    after_deadline: long
    /** The waiter of a wait the thread's cancellation may end, for the worker to arm, or null. */
    after_cancel: *Waiter
    /** 1 while the worker runs a lightweight thread. */
    busy: Atomic[u32]
    /** 1 while the context running on the carrier is in a blocking call, and how many blocking calls
     * it has begun, which the monitor compares from one tick to the next. */
    blocked: Atomic[u32]
    blocks: Atomic[u32]
    /** `blocks` as the monitor saw it at its last tick. */
    seen_blocks: u32
    /** Whether the monitor has stopped counting the worker against the target, since its thread is
     * held by a blocking call; under the scheduler's lock. */
    released: bool
    /** When the running lightweight thread was switched to, in microseconds of the monotonic clock. */
    slice_start: Atomic[long]
    /** 1 when the monitor asks the running lightweight thread to yield at its next poll. */
    yield_wanted: Atomic[u32]
    /** The next of the scheduler's workers. */
    worker_next: *Carrier
    /** The low end of the worker's own stack, for the overflow report. */
    own_low: *u8

/** A carrier holding no chunk, for an attached thread or, with `worker`, for a worker of the
 * scheduler. It keeps itself alive until `me` is cleared. */
new_carrier(worker: bool) -> *Carrier
    val k: &Carrier = Carrier(gc.chunk(), null, None, worker, fiber.Context.new(), AfterNothing, null, null, 0, null, Atomic(0), Atomic(0), Atomic(0), 0, false, Atomic(0), Atomic(0), null, null)
    k.me = Some(k)
    ptr_cast(&*k)

/** Every attached thread's carrier, whose chunks a collection retires. */
var carriers: *Carrier = null

// The storage of a context the runtime made for a thread, which keeps itself alive until the thread
// detaches.
private struct ThreadContext
    context: Context
    me: Option[&ThreadContext]

@assert(offsetof(ThreadContext, context) == 0, "a thread's context is the start of its storage")

/** A variant's layout, emitted by the compiler as constant data. It begins with the collector's
 * `Kind`, whose `trace` is `avin_rt_trace` and whose other hooks are null, so the kind the collector
 * keeps in an object's header, `gc.kind_of(p)`, is the object's descriptor. `record` is the type
 * record a type pattern reads (see `types.sysl`). `refs` byte offsets of the fields that hold
 * references follow this header, counted from the start of the payload; an array's descriptor
 * counts them from the start of each element instead, when it has an element map (see
 * `array.sysl`). */
struct Descriptor
    kind: gc.Kind
    tag: usize
    size: usize
    refs: usize
    record: *u8

@assert(offsetof(Descriptor, kind) == 0, "a descriptor begins with its kind")
@assert(offsetof(Descriptor, record) == 56, "the compiler reads a descriptor's type record at 56")

/** A descriptor's header for objects whose variant is `tag`, of `size` bytes, holding `refs`
 * references, and with no type record. */
descriptor(tag: usize, size: usize, refs: usize) -> Descriptor = Descriptor(gc.Kind(&trace, null, null, null), tag, size, refs, null)

/** The descriptor of the object at `p`, which may be on the heap or a constant outside it. */
descriptor_of(p: *u8) -> *Descriptor = ptr_cast(gc.kind_of(p))

private const DefaultLimit: usize = 8589934592

/** The least the heap may allocate between collections, so a small heap does not collect at every
 * step. */
private const Floor: usize = 8388608

private heap_limit() -> usize
    val text = env.get("AVIN_HEAP_LIMIT") match
        Some(t) -> t
        None -> return DefaultLimit
    var n = 0usize
    for b in text.bytes
        if b < u8('0') || b > u8('9') then return DefaultLimit
        n = n * 10 + usize(b - u8('0'))
    if n < 4096 then 4096 else n

var main_context: Context = new_context()
/** Every attached context, whose frames are the roots of a collection. */
var contexts: *Context = null
var block: []u8 = [0u8; heap_limit()]
var space: gc.Heap = gc.heap(&block[0], block.len, null)

/** With `AVIN_GC_STRESS=1` every allocation collects first, which finds a missing root at the
 * first allocation it matters to. `AVIN_GC_STRESS=2` also collects at every safepoint poll, which
 * finds a reference not kept alive across a loop that does not allocate. */
var stress: bool = env.get("AVIN_GC_STRESS") == Some("1") || env.get("AVIN_GC_STRESS") == Some("2")
var poll_stress: bool = env.get("AVIN_GC_STRESS") == Some("2")
var budget: usize = Floor
/** What the heap held when the last collection finished. A carrier's chunk is charged whole when it
 * is claimed, so what has been allocated since is at most what the heap holds now beyond this. */
var settled: usize = 0

// The tracer of every object. A reference may be null or to a constant object outside the heap;
// the collector ignores both.
@export("avin_rt_trace")
trace(p: *u8, h: *gc.Heap)
    var m = HeapMarker(h)
    scan_fields(p, &m)

private mark_frames(h: *gc.Heap, top: *Frame)
    var f = top
    while f != null
        val slots: **u8 = ptr_cast(usize(f) + sizeof(Frame))
        for i in 0..<f.count
            gc.mark(h, slots[i])
        f = f.prev

private roots(h: *gc.Heap)
    mark_frames(h, globals)
    mark_pinned(h)
    mark_attached(h)
    var c = contexts
    while c != null
        mark_frames(h, c.top)
        c = c.next

/** The frames of module-level values, linked through `prev`: each program's references that live
 * for the whole run, which every collection keeps. */
var globals: *Frame = null

/** Makes the slots of `f`, a frame the compiler emits as constant storage for a program's
 * module-level references, roots of every collection from now on. Called once, before any of them
 * is stored. */
@export("avin_rt_globals")
register_globals(f: *Frame)
    f.prev = globals
    globals = f

/** Not zero while some thread is asked to call `avin_rt_safepoint`: the `Stop` bit while a collection
 * waits for the other threads to stop, the `Yield` bit while a lightweight thread has overrun its time
 * slice, the `Cancel` bit while a cancelled lightweight thread has not yet ended, and the `Poll` bit
 * for good under `AVIN_GC_STRESS=2`. Each is cleared by clearing its own bit alone. Compiled code
 * reads it at every safepoint poll and calls `avin_rt_safepoint` when it is not zero. */
@export("avin_rt_requested")
var requested: Atomic[u32] = Atomic(0)

/** The bit of `requested` a collection raises. */
const Stop: u32 = 1
/** The bit of `requested` the scheduler raises for a lightweight thread to yield its carrier. */
const Yield: u32 = 2
/** The bit of `requested` raised for good under `AVIN_GC_STRESS=2`, so every poll calls the runtime,
 * which collects. (`Cancel`, in `cancel.sysl`, is 4.) */
const Poll: u32 = 8

/** Whether a collection has asked the other threads to stop. */
stop_requested() -> bool = (requested.load() & Stop) != 0

/** Held by the thread that allocates, collects, attaches or detaches: the collector's heap, the list
 * of contexts and the collection budget are touched only under it. A collecting thread holds it for
 * the whole stop. */
var heap_lock: SleepLock = SleepLock.new()

// The handshake of a stop. The collector sleeps on `parked` until every other context is safe;
// stopped threads sleep on `resumed` until the `Stop` bit is lowered. Both are notified under `world`,
// so no wake is lost between a check and a wait.
private var world: Mutex[u32] = Mutex.new(0)
private var parked: Condvar = Condvar.new()
private var resumed: Condvar = Condvar.new()

/** How many collections have stopped other threads, which a collection with one context attached
 * never does. */
var stops: usize = 0

/** Marks `c` safe for a call that may wait: its frames hold every reference its thread still needs,
 * and the thread touches no reference until it calls `leave_safe`. A blocking call is made between
 * the two, so a thread that waits does not hold up a collection; on a worker of the scheduler the
 * carrier counts as blocked meanwhile, and the monitor runs another worker in its place when the wait
 * outlasts a tick. */
@export("avin_rt_enter_safe")
enter_safe(c: *Context)
    val k = c.carrier
    if k != null
        k.blocks.store(k.blocks.load(Relaxed) + 1, Relaxed)
        k.blocked.store(1)
    mark_safe(c)

/** Marks `c` running again after a call `enter_safe` began, first waiting until any collection in
 * progress has finished. */
@export("avin_rt_leave_safe")
leave_safe(c: *Context)
    mark_running(c)
    val k = c.carrier
    if k != null then k.blocked.store(0, Relaxed)

/** Marks `c` safe, for a wait of the runtime's own that holds no carrier for long. */
mark_safe(c: *Context)
    c.state.store(Safe)
    // The store and the load are both sequentially consistent, as the collector's raising of the
    // flag and its reading of the states are: either this thread sees the flag and wakes the
    // collector, or the collector sees this context safe.
    if stop_requested()
        world.lock_raw()
        parked.notify_all()
        world.unlock_raw()

/** Marks `c` running again, first waiting until any collection in progress has finished. */
mark_running(c: *Context)
    loop
        c.state.store(Running)
        if !stop_requested() then return
        // A collection started while this thread was safe: step back, and wait for it.
        c.state.store(Safe)
        world.lock_raw()
        parked.notify_all()
        while stop_requested()
            resumed.wait(&world)
        world.unlock_raw()

/** Answers a raised `requested` from a poll, with the calling thread's frames consistent: parks the
 * thread until the collection that raised `Stop` has finished, and yields the carrier where the
 * scheduler has asked the lightweight thread running on it to (`scheduler.sysl`). */
safepoint(c: *Context)
    if stop_requested()
        mark_safe(c)
        mark_running(c)
    if poll_stress then collect(c)
    answer_yield(c)

/** The safepoint poll of compiled code: `safepoint`, and where the thread is cancelled, its stop
 * (`cancel.sysl`). */
@export("avin_rt_safepoint")
safepoint_cancellable(c: *Context)
    safepoint(c)
    cancel_at_poll(c)

/** Takes the heap lock for `c`'s thread, safe while it waits, since the holder may be collecting.
 * Once it holds the lock no collection is in progress, so `mark_running` returns at once. */
lock_heap(c: *Context)
    if heap_lock.try_lock() then return
    mark_safe(c)
    heap_lock.lock()
    mark_running(c)

private others_safe(c: *Context) -> bool
    var o = contexts
    while o != null
        if o != c && o.state.load() != Safe then return false
        o = o.next
    true

/** Stops every attached thread but `c`'s, under the heap lock, and answers whether there was any.
 * `resume_others` lets them run again. */
stop_others(c: *Context) -> bool
    if contexts == null || contexts == c && c.next == null then return false
    _ = requested.or(Stop)
    world.lock_raw()
    while !others_safe(c)
        parked.wait(&world)
    world.unlock_raw()
    stops += 1
    true

resume_others()
    world.lock_raw()
    _ = requested.and(~Stop)
    resumed.notify_all()
    world.unlock_raw()

/** Makes `c`'s frames roots of every collection from now on, and gives `c` a carrier of its own for
 * the calling thread, holding no chunk until it first allocates. A context is attached in the state
 * it has; a thread's own is marked running after it is attached. */
attach(c: *Context)
    heap_lock.lock()
    link_attached(c)
    heap_lock.unlock()

/** Under the heap lock: links `c` into the list of contexts, and a fresh carrier for it into the list
 * of carriers. */
link_attached(c: *Context)
    val carrier = new_carrier(false)
    link_carrier(carrier)
    c.carrier = carrier
    link_context(c)

/** Under the heap lock: links the carrier `k` into the list of carriers, whose chunks every
 * collection retires. */
link_carrier(k: *Carrier)
    k.next = carriers
    carriers = k

/** Under the heap lock: links `c` into the list of contexts, whose frames are the roots. */
link_context(c: *Context)
    c.prev = null
    c.next = contexts
    if contexts != null then contexts.prev = c
    contexts = c

/** Stops treating `c`'s frames as roots, retires its carrier's chunk and gives the carrier back. A
 * thread detaches its context when it has finished running compiled code, with no frame left on it;
 * the context is safe from then on. Detaching a context that is not attached changes nothing. */
detach(c: *Context)
    if current_context == c then current_context = null
    mark_safe(c)
    heap_lock.lock()
    unlink(c)
    val carrier = c.carrier
    c.carrier = null
    if carrier != null
        gc.retire(&space, &carrier.chunk)
        unlink_carrier(carrier)
    heap_lock.unlock()
    if carrier != null then carrier.me = None

private unlink_carrier(k: *Carrier)
    if carriers == k
        carriers = k.next
        return
    var p = carriers
    while p != null
        if p.next == k
            p.next = k.next
            return
        p = p.next

/** Under the heap lock: takes `c` out of the list of contexts; one that is not in it is left alone. */
unlink(c: *Context)
    if c.prev != null
        c.prev.next = c.next
    elif contexts == c
        contexts = c.next
    else
        return
    if c.next != null then c.next.prev = c.prev
    c.next = null
    c.prev = null

/** A context for the calling thread, attached and running, which it passes to the compiled code it
 * runs. The thread gives it back with `avin_rt_thread_detach` before it finishes. */
@export("avin_rt_thread_attach")
thread_attach() -> *Context
    val t: &ThreadContext = ThreadContext(new_context(), None)
    t.me = Some(t)
    val c: *Context = ptr_cast(&*t)
    // Attached safe, then running once no collection is in progress.
    attach(c)
    leave_safe(c)
    current_context = c
    c

/** Detaches `c`, a context `avin_rt_thread_attach` made, and gives back its storage. The thread
 * calls it last, with no frame left on its stack. */
@export("avin_rt_thread_detach")
thread_detach(c: *Context)
    detach(c)
    val t: *ThreadContext = ptr_cast(c)
    t.me = None

// After a collection the next one waits until as much has been allocated as survived, so the heap
// stays within about twice what is live and collecting costs in proportion to what is allocated.
// The caller holds the heap lock and every other thread is stopped. The chunk of every carrier is
// given back first, so the collector sees the heap as a run of whole objects and free blocks; a
// detached thread's carrier gave its own back when it detached.
collect_now()
    var k = carriers
    while k != null
        gc.retire(&space, &k.chunk)
        k = k.next
    gc.collect(&space, &roots)
    val live = gc.live_size(&space)
    settled = live
    budget = if live > Floor then live else Floor

// How much the heap has taken on since the last collection, counting every chunk out whole.
private allocated_since() -> usize
    val now = gc.live_size(&space)
    if now > settled then now - settled else 0

// A collection by `c`'s thread, which holds the heap lock: the others are stopped around it.
private collect_stopped(c: *Context)
    val stopped = stop_others(c)
    collect_now()
    if stopped then resume_others()

/** Collects now, stopping every other attached thread for the collection. `c` is the calling
 * thread's context, with its frames consistent. */
@export("avin_rt_collect")
collect(c: *Context)
    lock_heap(c)
    collect_stopped(c)
    heap_lock.unlock()

/** The main thread's context, attached and running, for the program's entry function, which passes on
 * the `argc` arguments at `argv` the platform handed it. */
@export("avin_rt_start")
start(argc: i32, argv: **u8) -> *Context
    keep_arguments(argc, argv)
    install_stack_guard()
    main_context.owner = fresh_owner()
    if poll_stress then _ = requested.or(Poll)
    attach(&main_context)
    leave_safe(&main_context)
    current_context = &main_context
    &main_context

/** A new object laid out by `d`, all zero; its header holds `d`. */
@export("avin_rt_alloc")
allocate(ctx: *Context, d: *Descriptor) -> *u8 = allocate_sized(ctx, d, d.size)

/** A new object of `size` bytes, all zero, whose header holds `d`, for an object whose size is not
 * its descriptor's, such as a string, whose bytes follow its length. Allocating may collect, so
 * every reference the caller still needs must be a root. An allocation the carrier's chunk serves
 * takes no lock; one that takes the heap lock is also a safepoint, since a thread waiting for it is
 * safe. `ctx` is the allocating thread's. */
allocate_sized(ctx: *Context, d: *Descriptor, size: usize) -> *u8
    if !stress
        val p = gc.chunk_alloc(&ctx.carrier.chunk, size, &d.kind)
        if p != null then return p
    allocate_locked(ctx, d, size)

// The allocation a carrier's chunk cannot serve: the chunk is spent, or the object is too large for
// any chunk. Under stress every allocation comes here, collects first, and is then taken from a
// freshly claimed chunk like any other.
private allocate_locked(ctx: *Context, d: *Descriptor, size: usize) -> *u8
    lock_heap(ctx)
    if stress || allocated_since() >= budget then collect_stopped(ctx)
    var p = take(ctx, d, size)
    if p == null
        collect_stopped(ctx)
        p = take(ctx, d, size)
        if p == null
            heap_lock.unlock()
            begin_stop(ctx)
            flush()
            eprints("avin: out of memory: the heap limit is " + block.len.to_string() + " bytes; set AVIN_HEAP_LIMIT to raise it\n")
            end_trapped(ctx)
    heap_lock.unlock()
    p

// Under the heap lock: an object too large for a chunk from the heap itself; any other from a fresh
// chunk for the carrier `ctx` is running on. Null when the heap holds no block large enough.
private take(ctx: *Context, d: *Descriptor, size: usize) -> *u8
    if size > gc.CHUNK_OBJECT_MAX then return gc.alloc(&space, size, &d.kind)
    val k = ctx.carrier
    if !gc.claim(&space, &k.chunk, size) then return null
    gc.chunk_alloc(&k.chunk, size, &d.kind)
