module avin.rt

import sysl.fs.{File, IoError, create, create_update}

/** `path` opened for writing, made with the permission bits `mode` (which the umask narrows) if it is
 * not there and emptied if it is; an existing file keeps its mode. The caller has checked that
 * `mode` is within `0o0`..`0o7777`. */
fs_create(path: string, mode: int) -> Result[File, IoError] = create(path, u32(mode))

/** As `fs_create`, open for reading as well. */
fs_create_update(path: string, mode: int) -> Result[File, IoError] = create_update(path, u32(mode))

/** Sets the twelve permission bits of the open file `f` to exactly `mode`, the umask playing no part:
 * `fchmod` on its descriptor, so the file the handle holds changes whatever its name now is. The
 * caller has checked that `mode` is within `0o0`..`0o7777`. */
fs_file_set_permissions(f: *File, mode: int) -> Result[unit, IoError] = f.set_permissions(u32(mode))
