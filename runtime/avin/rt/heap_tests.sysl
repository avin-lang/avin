module avin.rt
@tests

import sh.sysl.gc
import sysl.raw.ptr_cast

// A frame holding one reference, laid out as compiled code lays out its frames: the header, then the
// slots. The contexts and frames are module-level, as a thread's are for as long as it is attached.
private struct OneRoot
    frame: Frame
    slot: *u8

private var small: Descriptor = descriptor(1, 16, 0)
private var first: Context = Context(null, null)
private var second: Context = Context(null, null)
private var third: Context = Context(null, null)
private var a: OneRoot = OneRoot(Frame(null, 1), null)
private var b: OneRoot = OneRoot(Frame(null, 1), null)
private var c: OneRoot = OneRoot(Frame(null, 1), null)

private live_objects() -> usize
    collect_now()
    gc.live(&space)

// One object rooted in `r`'s slot, allocated through `ctx`, with `r`'s frame on top of `ctx`.
private hold(ctx: *Context, r: *OneRoot)
    r.slot = allocate(ctx, &small)
    r.frame.prev = ctx.top
    ctx.top = &r.frame

private reset()
    for ctx in [&first, &second, &third]
        ctx.top = null
        detach(ctx)

@test("a collection keeps what the frames of every attached context hold")
every_attached_context_is_a_root()
    attach(&first)
    attach(&second)
    hold(&first, &a)
    hold(&second, &b)
    assert_eq(live_objects(), 2)
    detach(&second)
    assert_eq(live_objects(), 1)
    detach(&first)
    assert_eq(live_objects(), 0)
    reset()

@test("detaching a context from the middle of the list keeps the ones around it")
detaching_from_the_middle()
    attach(&first)
    attach(&second)
    attach(&third)
    hold(&first, &a)
    hold(&second, &b)
    hold(&third, &c)
    detach(&second)
    assert_eq(live_objects(), 2)
    detach(&first)
    assert_eq(live_objects(), 1)
    detach(&third)
    assert_eq(live_objects(), 0)
    reset()

// Frames of module-level references, laid out as the compiler emits them.
private var module_a: OneRoot = OneRoot(Frame(null, 1), null)
private var module_b: OneRoot = OneRoot(Frame(null, 1), null)

@test("the frames of module-level values are roots while no context holds anything")
module_values_are_roots()
    attach(&first)
    register_globals(&module_a.frame)
    register_globals(&module_b.frame)
    module_a.slot = allocate(&first, &small)
    module_b.slot = allocate(&first, &small)
    // The garbage allocated after them is reclaimed; the two stored ones are not.
    var garbage: *u8 = null
    for _ in 0..<1000
        garbage = allocate(&first, &small)
    assert(garbage != null)
    assert_eq(live_objects(), 2)
    module_a.slot = null
    assert_eq(live_objects(), 1)
    module_b.slot = null
    assert_eq(live_objects(), 0)
    globals = null
    reset()

@test("a null slot of a module-level frame is skipped")
null_module_slot()
    register_globals(&module_a.frame)
    module_a.slot = null
    assert_eq(live_objects(), 0)
    globals = null

@test("each context's frames are walked to the bottom of its stack, not only its top frame")
every_frame_of_a_context_is_walked()
    attach(&first)
    hold(&first, &a)
    hold(&first, &b)
    assert_eq(live_objects(), 2)
    first.top = &a.frame
    assert_eq(live_objects(), 1)
    detach(&first)
    assert_eq(live_objects(), 0)
    reset()

@test("an object's descriptor is the kind in its header, and its payload starts at the reference")
descriptor_is_the_header_kind()
    attach(&first)
    hold(&first, &a)
    assert(descriptor_of(a.slot) == &small)
    assert(gc.kind_of(a.slot) == &small.kind)
    val words: *usize = ptr_cast(a.slot)
    assert_eq(words[0], 0usize)
    assert_eq(words[1], 0usize)
    reset()

// A descriptor whose one reference is the first word of the payload, laid out as the compiler emits
// one: the header, then the offsets.
private struct OneRef
    header: Descriptor
    offset: usize

private var pair: OneRef = OneRef(descriptor(0, 16, 1), 0)

@test("a reference held in a field keeps its object alive")
fields_are_traced()
    attach(&first)
    hold(&first, &a)
    val p = allocate(&first, &pair.header)
    a.slot = p
    val field: **u8 = ptr_cast(p)
    field[0] = allocate(&first, &small)
    assert_eq(live_objects(), 2)
    field[0] = null
    assert_eq(live_objects(), 1)
    reset()

// A constant object outside the heap, laid out as the compiler emits one: its descriptor's kind and
// a word left zero before its payload.
private struct Constant
    kind: *gc.Kind
    word: usize
    value: usize

private var constant: Constant = Constant(&small.kind, 0, 7)

@test("a constant outside the heap, held by a root and by a field, is found by its kind and never collected")
constants_outside_the_heap()
    val k: *u8 = ptr_cast(&constant.value)
    assert(descriptor_of(k) == &small)
    attach(&first)
    hold(&first, &a)
    a.slot = k
    assert_eq(live_objects(), 0)
    val p = allocate(&first, &pair.header)
    val field: **u8 = ptr_cast(p)
    field[0] = k
    a.slot = p
    assert_eq(live_objects(), 1)
    assert(gc.is_live(&space, k))
    assert_eq(constant.word, 0usize)
    assert_eq(constant.value, 7usize)
    reset()
