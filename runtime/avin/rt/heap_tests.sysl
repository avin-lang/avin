module avin.rt
@tests

import sh.sysl.gc
import sysl.raw.ptr_cast

// A frame holding one reference, laid out as compiled code lays out its frames: the header, then the
// slots. The contexts and frames are module-level, as a thread's are for as long as it is attached.
private struct OneRoot
    frame: Frame
    slot: *u8

private var small: Descriptor = descriptor(1, 16, 0)
private var first: Context = new_context()
private var second: Context = new_context()
private var third: Context = new_context()
private var a: OneRoot = OneRoot(Frame(null, 1), null)
private var b: OneRoot = OneRoot(Frame(null, 1), null)
private var c: OneRoot = OneRoot(Frame(null, 1), null)

private live_objects() -> usize
    collect_now()
    gc.live(&space)

// One object rooted in `r`'s slot, allocated through `ctx`, with `r`'s frame on top of `ctx`.
private hold(ctx: *Context, r: *OneRoot)
    r.slot = allocate(ctx, &small)
    r.frame.prev = ctx.top
    ctx.top = &r.frame

private reset()
    for ctx in [&first, &second, &third]
        ctx.top = null
        detach(ctx)

@test("a collection keeps what the frames of every attached context hold")
every_attached_context_is_a_root()
    attach(&first)
    attach(&second)
    hold(&first, &a)
    hold(&second, &b)
    assert_eq(live_objects(), 2)
    detach(&second)
    assert_eq(live_objects(), 1)
    detach(&first)
    assert_eq(live_objects(), 0)
    reset()

@test("detaching a context from the middle of the list keeps the ones around it")
detaching_from_the_middle()
    attach(&first)
    attach(&second)
    attach(&third)
    hold(&first, &a)
    hold(&second, &b)
    hold(&third, &c)
    detach(&second)
    assert_eq(live_objects(), 2)
    detach(&first)
    assert_eq(live_objects(), 1)
    detach(&third)
    assert_eq(live_objects(), 0)
    reset()

// Frames of module-level references, laid out as the compiler emits them.
private var module_a: OneRoot = OneRoot(Frame(null, 1), null)
private var module_b: OneRoot = OneRoot(Frame(null, 1), null)

@test("the frames of module-level values are roots while no context holds anything")
module_values_are_roots()
    attach(&first)
    register_globals(&module_a.frame)
    register_globals(&module_b.frame)
    module_a.slot = allocate(&first, &small)
    module_b.slot = allocate(&first, &small)
    // The garbage allocated after them is reclaimed; the two stored ones are not.
    var garbage: *u8 = null
    for _ in 0..<1000
        garbage = allocate(&first, &small)
    assert(garbage != null)
    assert_eq(live_objects(), 2)
    module_a.slot = null
    assert_eq(live_objects(), 1)
    module_b.slot = null
    assert_eq(live_objects(), 0)
    globals = null
    reset()

@test("a null slot of a module-level frame is skipped")
null_module_slot()
    register_globals(&module_a.frame)
    module_a.slot = null
    assert_eq(live_objects(), 0)
    globals = null

@test("each context's frames are walked to the bottom of its stack, not only its top frame")
every_frame_of_a_context_is_walked()
    attach(&first)
    hold(&first, &a)
    hold(&first, &b)
    assert_eq(live_objects(), 2)
    first.top = &a.frame
    assert_eq(live_objects(), 1)
    detach(&first)
    assert_eq(live_objects(), 0)
    reset()

@test("an object's descriptor is the kind in its header, and its payload starts at the reference")
descriptor_is_the_header_kind()
    attach(&first)
    hold(&first, &a)
    assert(descriptor_of(a.slot) == &small)
    assert(gc.kind_of(a.slot) == &small.kind)
    val words: *usize = ptr_cast(a.slot)
    assert_eq(words[0], 0usize)
    assert_eq(words[1], 0usize)
    reset()

// A descriptor whose one reference is the first word of the payload, laid out as the compiler emits
// one: the header, then the offsets.
private struct OneRef
    header: Descriptor
    offset: usize

private var pair: OneRef = OneRef(descriptor(0, 16, 1), 0)

@test("a reference held in a field keeps its object alive")
fields_are_traced()
    attach(&first)
    hold(&first, &a)
    val p = allocate(&first, &pair.header)
    a.slot = p
    val field: **u8 = ptr_cast(p)
    field[0] = allocate(&first, &small)
    assert_eq(live_objects(), 2)
    field[0] = null
    assert_eq(live_objects(), 1)
    reset()

// A constant object outside the heap, laid out as the compiler emits one: its descriptor's kind and
// a word left zero before its payload.
private struct Constant
    kind: *gc.Kind
    word: usize
    value: usize

private var constant: Constant = Constant(&small.kind, 0, 7)

@test("a constant outside the heap, held by a root and by a field, is found by its kind and never collected")
constants_outside_the_heap()
    val k: *u8 = ptr_cast(&constant.value)
    assert(descriptor_of(k) == &small)
    attach(&first)
    hold(&first, &a)
    a.slot = k
    assert_eq(live_objects(), 0)
    val p = allocate(&first, &pair.header)
    val field: **u8 = ptr_cast(p)
    field[0] = k
    a.slot = p
    assert_eq(live_objects(), 1)
    assert(gc.is_live(&space, k))
    assert_eq(constant.word, 0usize)
    assert_eq(constant.value, 7usize)
    reset()

@test("each thread allocates from a chunk of its own, which a collection and a detach give back")
chunks_are_given_back()
    attach(&first)
    attach(&second)
    hold(&first, &a)
    hold(&second, &b)
    assert_eq(gc.chunks_out(&space), 2usize)
    assert_eq(live_objects(), 2)
    assert_eq(gc.chunks_out(&space), 0usize)
    _ = allocate(&first, &small)
    assert_eq(gc.chunks_out(&space), 1usize)
    detach(&first)
    assert_eq(gc.chunks_out(&space), 0usize)
    assert_eq(live_objects(), 1)
    reset()

@test("an object too large for a chunk comes from the heap itself, zeroed, and leaves the chunk alone")
large_objects_skip_the_chunk()
    attach(&first)
    hold(&first, &a)
    val size = gc.CHUNK_OBJECT_MAX + 1
    val p = allocate_sized(&first, &small, size)
    for i in 0..<size
        assert_eq(p[i], 0u8)
    a.slot = p
    assert_eq(live_objects(), 1)
    reset()

@test("an object too large for a chunk claims no chunk for a carrier that has none, and keeps the one it has")
large_objects_leave_the_carrier_alone()
    attach(&first)
    a.slot = allocate_sized(&first, &small, gc.CHUNK_OBJECT_MAX + 1)
    a.frame.prev = first.top
    first.top = &a.frame
    assert_eq(gc.chunks_out(&space), 0usize)
    // The largest object a chunk serves takes one; the next too large one leaves it out.
    val held = allocate_sized(&first, &small, gc.CHUNK_OBJECT_MAX)
    assert(held != null)
    assert_eq(gc.chunks_out(&space), 1usize)
    _ = allocate_sized(&first, &small, gc.CHUNK_OBJECT_MAX + 1)
    assert_eq(gc.chunks_out(&space), 1usize)
    assert_eq(live_objects(), 1)
    reset()

@test("attaching gives a context a carrier of its own, holding no chunk until it allocates")
attaching_makes_a_carrier()
    assert(first.carrier == null)
    attach(&first)
    attach(&second)
    assert(first.carrier != null)
    assert(second.carrier != null)
    assert(first.carrier != second.carrier)
    assert(carriers == second.carrier)
    assert(second.carrier.next == first.carrier)
    assert_eq(gc.chunks_out(&space), 0usize)
    reset()
    assert(carriers == null)

@test("a carrier's chunk serves many allocations, claiming a fresh one only when it is spent")
a_carrier_chunk_is_reused()
    attach(&first)
    val carrier = first.carrier
    _ = allocate(&first, &small)
    assert_eq(gc.chunks_out(&space), 1usize)
    val claims = gc.live_size(&space)
    // Every allocation after the first that fits the claimed chunk is served from it: the heap's
    // charge, which counts a chunk whole when it is claimed, does not move.
    var served = 1usize
    while gc.live_size(&space) == claims
        _ = allocate(&first, &small)
        served += 1
    assert(served > 100, "a chunk served only " + served.to_string() + " allocations")
    assert_eq(gc.chunks_out(&space), 1usize)
    assert(first.carrier == carrier)
    reset()

@test("detaching retires the carrier's chunk, gives the carrier back and leaves the others' alone")
detach_retires_the_carrier()
    attach(&first)
    attach(&second)
    attach(&third)
    _ = allocate(&first, &small)
    _ = allocate(&second, &small)
    _ = allocate(&third, &small)
    assert_eq(gc.chunks_out(&space), 3usize)
    val kept_first = first.carrier
    val kept_third = third.carrier
    detach(&second)
    assert(second.carrier == null)
    assert_eq(gc.chunks_out(&space), 2usize)
    assert(carriers == kept_third)
    assert(kept_third.next == kept_first)
    assert(kept_first.next == null)
    // A second detach changes nothing.
    detach(&second)
    assert_eq(gc.chunks_out(&space), 2usize)
    // The others go on allocating from the chunks they hold.
    _ = allocate(&first, &small)
    _ = allocate(&third, &small)
    assert_eq(gc.chunks_out(&space), 2usize)
    reset()
    assert_eq(gc.chunks_out(&space), 0usize)
    assert(carriers == null)

@test("a context attached again gets a fresh carrier, which claims a fresh chunk")
reattaching_makes_a_fresh_carrier()
    attach(&first)
    hold(&first, &a)
    detach(&first)
    assert_eq(gc.chunks_out(&space), 0usize)
    first.top = null
    attach(&first)
    hold(&first, &a)
    assert_eq(gc.chunks_out(&space), 1usize)
    assert_eq(live_objects(), 1)
    reset()

@test("under stress every allocation collects, retiring every carrier's chunk, and then claims its own")
stress_retires_every_carrier()
    attach(&first)
    attach(&second)
    attach(&third)
    hold(&second, &b)
    hold(&third, &c)
    assert_eq(gc.chunks_out(&space), 2usize)
    stress = true
    hold(&first, &a)
    stress = false
    assert_eq(gc.chunks_out(&space), 1usize)
    assert_eq(live_objects(), 3)
    reset()

@test("an object from a chunk carved out of reclaimed space is all zero")
reused_chunks_are_zeroed()
    attach(&first)
    for _ in 0..<1000
        val p = allocate(&first, &small)
        for i in 0..<16
            p[i] = 0xffu8
    assert_eq(live_objects(), 0)
    for _ in 0..<1000
        val p = allocate(&first, &small)
        for i in 0..<16
            assert_eq(p[i], 0u8)
    reset()
