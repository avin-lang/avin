module avin.rt

import sysl.raw.ptr_cast
import sysl.sync.*
import sysl.threads.{Condvar, Mutex, SleepLock}
import sysl.time.monotonic

// The waiting the synchronization library is built on: a lock and a condition, each the payload of an
// object on the collected heap, which the library keeps as an opaque `Any`. Each keeps a queue of the
// threads waiting on it (`scheduler.sysl`): a lightweight thread that waits parks, leaving its worker
// to run another, and any other thread blocks. The collector never moves an object, so a waiter may be
// linked from one, and a thread that waits keeps what it waits on as a root of its own until it wakes.
// A thread that waits is safe for the collector while it waits, so it holds up no collection however
// long it sleeps.
//
// A lock is one word, `state`: `LockHeld` while a thread holds it, `LockParked` while a thread is on
// its queue, and `LockWoken` while a thread that will try for it again is awake. A thread takes a
// free lock with one compare-and-set and lets go of one nobody waits for with another, never touching
// the queue. A thread that finds the lock busy spins for up to `LockSpinMicros`, since a critical
// section is often over sooner than a park and a wake, and then parks on the queue. Letting go of a
// lock with waiters wakes the oldest, which then competes for the lock with any thread that comes for
// it meanwhile: the lock is not reserved for it, so a stream of threads taking and letting go of the
// lock never waits for a parked thread to be scheduled. A woken waiter that loses parks again at the
// front of the queue, so the oldest waiter stays first. Where the first waiter has waited longer than
// `LockFairAfter` since it first found the lock busy, the lock is handed to it instead, holding it as
// it wakes, so no thread is overtaken for ever; a lock hands itself over at most once every
// `LockFairAfter`, so that a lock whose waiters have all waited long does not fall back to handing
// itself from thread to thread at every release, each hand-over a parked thread to schedule.
//
// `LockWoken` belongs to one thread at a time: a thread letting the lock go sets it as it wakes a
// waiter, and a spinning thread sets it where waiters are parked, each with a compare-and-set from
// clear, and the thread that set it, or was woken under it, clears it as it takes the lock or parks.
// While it is set, letting the lock go wakes nobody, since a thread that will try for it is already
// awake; so the lock never has two threads woken for it at once, and a lock let go with waiters
// parked always has a thread awake to take it.
//
// `LockParked` is set, and the queue changed, only under the queue's guard, and only while the lock is
// held, so a thread letting go of a lock whose `LockParked` is set, and not `LockWoken`, takes the
// guard and sees every waiter.

/** The payload of a lock: its state, the threads waiting to take it, and when it may next be handed
 * to a waiter, in microseconds of the monotonic clock, under the queue's guard. */
struct ParkLock
    waiting: WaitQueue
    state: Atomic[u32]
    fair_at: long

/** A lock's `state` while a thread holds it. */
const LockHeld: u32 = 1
/** A lock's `state` while a thread is parked on its queue. */
const LockParked: u32 = 2
/** A lock's `state` while a thread that will try for it again is awake: woken, or spinning. */
const LockWoken: u32 = 4

/** How long a thread that finds a lock busy spins before it parks, in microseconds: long enough for a
 * short critical section to end, and short beside the slice a lightweight thread runs for, so a
 * spinning thread holds its worker for no longer than a few switches would take. */
const LockSpinMicros: long = 10

/** How many times a spinning thread looks at the lock between readings of the clock. */
const LockSpinsPerLook: i32 = 32

/** How long a waiter may be overtaken, in microseconds: the first waiter, once it has waited longer
 * than this since it first found the lock busy, is handed the lock by the next thread to let it go,
 * where the lock has not been handed over in the last `LockFairAfter` either. */
const LockFairAfter: long = 1000

/** A free lock, which threads waiting for it wait on as `kind`. */
new_park_lock(kind: u32) -> ParkLock = ParkLock(new_wait_queue_for(kind), Atomic(0), 0)

/** Whether a thread holds the lock `l`. */
park_lock_held(l: *ParkLock) -> bool = (l.state.load() & LockHeld) != 0

/** The payload of a condition: the threads waiting to be notified. */
struct ParkCondition
    waiting: WaitQueue

/** The descriptor of a lock, holding no reference and naming no type record. */
var lock_descriptor: Descriptor = descriptor(0, sizeof(ParkLock), 0)

/** The descriptor of a condition, holding no reference and naming no type record. */
var condition_descriptor: Descriptor = descriptor(0, sizeof(ParkCondition), 0)

/** A frame of two slots holding what a thread waits on, pushed on its context's stack for the wait, so
 * the objects stay alive while it waits on them whatever the program still holds. */
struct Holding
    frame: Frame
    first: *u8
    second: *u8

@assert(offsetof(Holding, first) == offsetof(Holding, frame) + sizeof(Frame), "a frame's slots follow its header")

/** A new lock, free. */
@export("avin_rt_lock_new")
lock_new(ctx: *Context) -> *u8
    val p = allocate(ctx, &lock_descriptor)
    val l: *ParkLock = ptr_cast(p)
    *l = new_park_lock(WaitsOnLock)
    published(p)

/** Takes the lock `p`, waiting, safe for the collector, while another thread holds it. */
@export("avin_rt_lock_acquire")
lock_acquire(ctx: *Context, p: *u8)
    enter_doubt(ctx)
    take_lock(ctx, p)

// Takes the lock `p`: at once where it is free, and otherwise once it comes free or is handed over.
private take_lock(ctx: *Context, p: *u8)
    val l: *ParkLock = ptr_cast(p)
    if l.state.cas(0, LockHeld) == 0 then return
    var r = Holding(Frame(ctx.top, 1), p, null)
    ctx.top = &r.frame
    take_contended(ctx, l)
    ctx.top = r.frame.prev

/** Takes the lock `l`, which is not on the collected heap: at once where it is free, and otherwise once
 * it comes free or is handed over. A lightweight thread waiting for it parks. */
hold_park_lock(ctx: *Context, l: *ParkLock)
    if l.state.cas(0, LockHeld) != 0 then take_contended(ctx, l)

/** Takes the lock `l`, which is not on the collected heap, where it is free, answering whether it
 * did; never waits. A lock free with threads still parked on it is taken too. */
try_hold_park_lock(l: *ParkLock) -> bool
    loop
        val s = l.state.load()
        if (s & LockHeld) != 0 then return false
        if l.state.cas(s, s | LockHeld) == s then return true

// Takes the lock `l`, which was busy a moment ago: spins for up to `LockSpinMicros`, then parks on its
// queue until a thread letting it go wakes it, and spins and tries again, until it takes the lock or
// is handed it. `woken` says whether this thread is the one `LockWoken` stands for, which it claims
// while it spins where waiters are parked, and is given when it is woken. The time it first parked is
// kept across its tries, and a thread woken that loses the lock parks again at the front of the queue,
// so that once it has waited longer than `LockFairAfter` the lock is handed to it.
private take_contended(ctx: *Context, l: *ParkLock)
    var woken = false
    var since: long = 0
    var spins: i32 = 0
    var spin_until = now_micros() + LockSpinMicros
    loop
        val s = l.state.load()
        if (s & LockHeld) == 0
            val taken = if woken then (s | LockHeld) & ~LockWoken else s | LockHeld
            if l.state.cas(s, taken) == s then return
            continue
        if spins >= 0
            if !woken && (s & LockParked) != 0
                // With waiters parked, one thread spins for the lock at a time: the one that claims
                // `LockWoken`. Every other parks at once rather than add to the traffic on the lock.
                if (s & LockWoken) != 0
                    spins = -1
                    continue
                if l.state.cas(s, s | LockWoken) == s then woken = true
                continue
            spin_hint()
            spins += 1
            if spins % LockSpinsPerLook == 0 && now_micros() >= spin_until then spins = -1
            continue
        l.waiting.guard.lock()
        if !mark_parked(l, woken)
            l.waiting.guard.unlock()
            continue
        woken = false
        val again = since != 0
        if !again then since = now_micros()
        val w = waiter_of(ctx)
        w.since = since
        if again then enqueue_first(&l.waiting, w) else enqueue(&l.waiting, w)
        _ = wait_on(ctx, &l.waiting, w, 0)
        if w.handed then return
        woken = true
        spins = 0
        spin_until = now_micros() + LockSpinMicros

// Under the guard of the lock `l`: sets `LockParked` where the lock is held, answering whether it is,
// so a thread about to park on it is sure to be woken by the one letting it go; where the thread is
// the one `LockWoken` stands for (`woken`), it clears `LockWoken` in the same step, since it is no
// longer awake to take the lock.
private mark_parked(l: *ParkLock, woken: bool) -> bool
    loop
        val s = l.state.load()
        if (s & LockHeld) == 0 then return false
        val marked = if woken then (s | LockParked) & ~LockWoken else s | LockParked
        if marked == s || l.state.cas(s, marked) == s then return true

/** Lets the lock `p` go, which the calling thread holds. */
@export("avin_rt_lock_release")
lock_release(ctx: *Context, p: *u8)
    leave_doubt(ctx)
    let_lock_go(p)

/** Lets the lock `p` go, which the calling thread holds, staying in the region in doubt taking it
 * entered: for a thread that took, under the lock, a share of what it guards (a read-write lock's
 * share, a semaphore's permit), and holds that share until `cancel_guarded_held` gives it back and
 * leaves the region. Nothing can stop the thread between the two. */
@export("avin_rt_lock_release_holding")
lock_release_holding(ctx: *Context, p: *u8)
    let_lock_go(p)

// Lets the lock `p` go, as `let_park_lock_go` does.
private let_lock_go(p: *u8) = let_park_lock_go(ptr_cast(p))

/** Lets the lock `l` go, which the calling thread holds: free, waking the first thread waiting for it
 * to try for it again, or, where that thread has waited longer than `LockFairAfter` and the lock has
 * not been handed over in the last `LockFairAfter`, to that thread, which then holds it. Where a
 * thread that will try for it is awake already (`LockWoken`), or none waits, the lock is only let go. */
let_park_lock_go(l: *ParkLock)
    if l.state.cas(LockHeld, 0) == LockHeld then return
    if let_go_waking_nobody(l) then return
    l.waiting.guard.lock()
    val w = l.waiting.head
    if w == null
        // `LockParked` is never set with the queue empty; were it, the lock is let go and the mark cleared.
        loop
            val s = l.state.load()
            if l.state.cas(s, s & ~(LockHeld | LockParked)) == s then break
        l.waiting.guard.unlock()
        return
    val parked = if w.next == null then 0u32 else LockParked
    val now = now_micros()
    val handed = now - w.since > LockFairAfter && now >= l.fair_at
    loop
        val s = l.state.load()
        if !handed && (s & LockWoken) != 0
            // A spinning thread claimed the wake meanwhile; it takes the lock, and nobody is woken.
            if l.state.cas(s, s & ~LockHeld) == s
                l.waiting.guard.unlock()
                return
            continue
        val kept = s & ~(LockHeld | LockParked)
        val after = if handed then kept | LockHeld | parked else kept | LockWoken | parked
        if l.state.cas(s, after) == s then break
    unlink_waiter(&l.waiting, w)
    if handed then l.fair_at = now + LockFairAfter
    w.handed = handed
    // A wait for a lock has no time limit and no cancellation, so nothing but this wake ends it.
    _ = wake_waiter(w)
    l.waiting.guard.unlock()

// Lets the lock `l` go where no thread is parked on it, or one that will try for it is awake already,
// answering whether it did; otherwise leaves it held, for the caller to wake a waiter.
private let_go_waking_nobody(l: *ParkLock) -> bool
    loop
        val s = l.state.load()
        if (s & LockParked) != 0 && (s & LockWoken) == 0 then return false
        if l.state.cas(s, s & ~LockHeld) == s then return true

/** A new condition, with no thread waiting on it. */
@export("avin_rt_condition_new")
condition_new(ctx: *Context) -> *u8 = condition_made(ctx, WaitsOnCondition)

/** A new condition, with no thread waiting on it, which a thread waiting on it waits on as `kind`: a
 * channel's receive (6) or send (7), a future (8), an executor's work (9), or a plain condition (any
 * other), as the thread dump and the deadlock report name it. */
@export("avin_rt_condition_new_kind")
condition_new_kind(ctx: *Context, kind: i32) -> *u8 = condition_made(ctx, condition_kind(kind))

private condition_made(ctx: *Context, kind: u32) -> *u8
    val p = allocate(ctx, &condition_descriptor)
    val c: *ParkCondition = ptr_cast(p)
    *c = ParkCondition(new_wait_queue_for(kind))
    published(p)

/** Lets the lock `lock` go, which the calling thread holds, waits until the condition `p` is notified,
 * and takes the lock again. The thread is safe for the collector from before it lets the lock go until
 * it holds it again. A wait may also end with no notification, so the caller checks what it waits for
 * again. */
condition_wait(ctx: *Context, p: *u8, lock: *u8)
    _ = wait_notified(ctx, p, lock, 0, false)

/** `condition_wait` for at most `millis` milliseconds: answers `false` where the time ran out before a
 * notification came. Either way the lock is held again when it answers, and the caller checks what it
 * waits for again. A time that is not positive answers `false` at once, without letting the lock go. */
condition_wait_for(ctx: *Context, p: *u8, lock: *u8, millis: long) -> bool
    if millis <= 0 then return false
    wait_notified(ctx, p, lock, deadline_after(millis), false) == WaitWoken

/** `condition_wait` as compiled code waits, which the thread's cancellation also ends where the lock
 * is the only region the thread is in (`cancel.sysl`): the thread then stops, without the lock, which
 * it let go to wait. */
@export("avin_rt_condition_wait")
condition_wait_cancellable(ctx: *Context, p: *u8, lock: *u8)
    if wait_notified(ctx, p, lock, 0, may_cancel(ctx, 1)) == WaitCancelled then unwind_unlocked(ctx)

/** `condition_wait_for` as compiled code waits, which the thread's cancellation also ends, as in
 * `condition_wait_cancellable`. */
@export("avin_rt_condition_wait_for")
condition_wait_for_cancellable(ctx: *Context, p: *u8, lock: *u8, millis: long) -> bool
    if millis <= 0 then return false
    val ended = wait_notified(ctx, p, lock, deadline_after(millis), may_cancel(ctx, 1))
    if ended == WaitCancelled then unwind_unlocked(ctx)
    ended == WaitWoken

/** Stops the thread of `ctx`, cancelled in a wait on a condition that let its lock go: the lock is no
 * longer held, so the deferred statements the stop runs run outside its region. */
private unwind_unlocked(ctx: *Context) -> never
    leave_doubt(ctx)
    unwind_cancelled(ctx)

/** How `condition_wait_settling` answers: notified (or woken with nothing changed), out of time, or
 * cancelled. */
const WaitEndedWoken: i32 = 0
const WaitEndedTimedOut: i32 = 1
const WaitEndedCancelled: i32 = 2

/** A cancellable wait on the condition `p` for a waiter that has state of its own to put right before
 * its thread stops: where the thread's cancellation ends the wait, it takes the lock again and answers
 * `WaitEndedCancelled` instead of stopping, and the caller puts its state right, lets the lock go and
 * reaches a cancellation point, which stops it. Otherwise it waits as `condition_wait_for_cancellable`
 * does, for at most `millis` milliseconds, or with no limit where `millis` is negative; a limit of zero
 * answers `WaitEndedTimedOut` at once, holding the lock throughout. The lock is held when it answers,
 * however the wait ended. */
@export("avin_rt_condition_wait_settling")
condition_wait_settling(ctx: *Context, p: *u8, lock: *u8, millis: long) -> i32
    if millis == 0 then return WaitEndedTimedOut
    val deadline = if millis < 0 then 0 else deadline_after(millis)
    val ended = wait_notified(ctx, p, lock, deadline, may_cancel(ctx, 1))
    if ended == WaitCancelled
        take_lock(ctx, lock)
        return WaitEndedCancelled
    if ended == WaitWoken then WaitEndedWoken else WaitEndedTimedOut

// Waits on the condition `p` with the lock `lock` let go, until notified or, where `deadline` is
// positive, until then; takes the lock again and answers how the wait ended. Where `cancellable`, the
// thread's cancellation ends the wait too, answering `WaitCancelled` without taking the lock again.
// The waiter joins the condition's queue before the lock is let go, so a notification made under the
// lock after that is never missed.
private wait_notified(ctx: *Context, p: *u8, lock: *u8, deadline: long, cancellable: bool) -> u32
    val c: *ParkCondition = ptr_cast(p)
    val w = waiter_of(ctx)
    var r = Holding(Frame(ctx.top, 2), p, lock)
    ctx.top = &r.frame
    c.waiting.guard.lock()
    enqueue(&c.waiting, w)
    let_lock_go(lock)
    _ = wait_on_as(ctx, &c.waiting, w, deadline, cancellable)
    val ended = w.state.load()
    if ended != WaitCancelled then take_lock(ctx, lock)
    ctx.top = r.frame.prev
    ended

/** Milliseconds on a clock that only moves forward, from a starting point of no meaning: the
 * difference between two readings is the time between them, which a bounded wait counts down. */
monotonic_millis() -> long = monotonic().us / 1000

/** How many processors the machine offers the program, and at least one: the size of the library's
 * pool of workers. */
processors() -> long
    val n = long(cpu_count())
    if n < 1 then 1 else n

/** Wakes the oldest thread waiting on the condition `p`, if any is. */
@export("avin_rt_condition_notify")
condition_notify(ctx: *Context, p: *u8)
    val c: *ParkCondition = ptr_cast(p)
    c.waiting.guard.lock()
    _ = wake_one(&c.waiting)
    c.waiting.guard.unlock()

/** Wakes every thread waiting on the condition `p`. */
@export("avin_rt_condition_notify_all")
condition_notify_all(ctx: *Context, p: *u8)
    val c: *ParkCondition = ptr_cast(p)
    c.waiting.guard.lock()
    wake_all(&c.waiting)
    c.waiting.guard.unlock()

// Held for each operation on an `Atomic` whose value is wider than a word, which has no single atomic
// access: every such operation takes this one lock, so each is indivisible from every other. No
// operation under it allocates or waits for anything but the lock.
private var wide_atomics: SpinLock = SpinLock(0)

/** Begins an operation on an `Atomic` wider than a word. */
@export("avin_rt_wide_atomic_begin")
wide_atomic_begin()
    wide_atomics.lock()

/** Ends an operation on an `Atomic` wider than a word. */
@export("avin_rt_wide_atomic_end")
wide_atomic_end()
    wide_atomics.unlock()

// The first reads of `lazy val`s. A lazy value's state is a word: 0 before anything has read it, the
// context of the thread running its initializer while that runs, and `LazyReady` once the value is
// stored. Compiled code reads a ready value with one load and calls here otherwise. Threads that
// find another running the initializer sleep on one lock and condition shared by every lazy value,
// which only first reads ever touch.
private const LazyReady: i64 = 1

private var lazy_lock: SleepLock = SleepLock.new()

private var lazy_stored: Condvar = Condvar.new()

/** Begins a read of the lazy value whose state is at `state` that did not find it ready: answers 1
 * where the calling thread has claimed the value and is to run its initializer, and 0 once another
 * thread has stored it, having waited for that thread, safe for the collector. A thread whose read
 * of a value runs while its own initialization of the value is running, so that the initializer
 * needs its own result, stops the program at `site`. */
@export("avin_rt_lazy_begin")
lazy_begin(ctx: *Context, state: *i64, site: *TrapSite) -> int
    val me = i64(usize(ctx))
    val found = atomic_cas(state, 0, me, AcqRel)
    if found == 0
        enter_doubt(ctx)
        return 1
    if found == LazyReady then return 0
    if found == me then stop(ctx, site)
    enter_safe(ctx)
    lazy_lock.lock()
    while atomic_load(state, Acquire) != LazyReady
        lazy_stored.wait_raw(&lazy_lock)
    lazy_lock.unlock()
    leave_safe(ctx)
    0

/** Ends the initialization of the lazy value whose state is at `state`, which the calling thread has
 * stored: marks it ready with a release store, so a thread that sees the mark sees the whole value,
 * and wakes every thread waiting for a lazy value. */
@export("avin_rt_lazy_end")
lazy_end(ctx: *Context, state: *i64)
    leave_doubt(ctx)
    lazy_lock.lock()
    atomic_store(state, LazyReady, Release)
    lazy_stored.notify_all()
    lazy_lock.unlock()

/** `p`, an object the runtime has just made, once it is complete: a release fence makes every store
 * before it, the object's header and contents, visible to another thread no later than any store
 * after it, such as the one that hands the object over. Compiled code ends the making of its own
 * objects the same way. */
published(p: *u8) -> *u8
    atomic_fence(Release)
    p
