module avin.rt

import sysl.raw.ptr_cast
import sysl.sync.*
import sysl.threads.{Condvar, Mutex, SleepLock}
import sysl.time.monotonic

// The waiting the synchronization library is built on: a lock that sleeps and a condition variable,
// each the payload of an object on the collected heap, which the library keeps as an opaque `Any`.
// The collector never moves an object, so a thread may sleep on a word inside one, and a thread that
// sleeps keeps what it sleeps on as a root of its own until it wakes. A thread that has to wait is
// safe for the collector while it waits, so it holds up no collection however long it sleeps.
//
// A lock is a `Mutex` guarding nothing, so a condition can wait on it for a bounded time as well as
// for ever.

/** The descriptor of a lock: a `Mutex[unit]`, holding no reference and naming no type record. */
var lock_descriptor: Descriptor = descriptor(0, sizeof(Mutex[unit]), 0)

/** The descriptor of a condition: a `Condvar`, holding no reference and naming no type record. */
var condition_descriptor: Descriptor = descriptor(0, sizeof(Condvar), 0)

// A frame of two slots holding what a thread waits on, pushed on its context's stack for the wait, so
// the objects stay alive while it sleeps on them whatever the program still holds.
private struct Waiting
    frame: Frame
    first: *u8
    second: *u8

@assert(offsetof(Waiting, first) == offsetof(Waiting, frame) + sizeof(Frame), "a frame's slots follow its header")

/** A new lock, free. */
@export("avin_rt_lock_new")
lock_new(ctx: *Context) -> *u8
    val p = allocate(ctx, &lock_descriptor)
    val l: *Mutex[unit] = ptr_cast(p)
    *l = Mutex.new(())
    published(p)

/** Takes the lock `p`, safe for the collector while it waits for another thread to let it go. */
@export("avin_rt_lock_acquire")
lock_acquire(ctx: *Context, p: *u8)
    val l: *Mutex[unit] = ptr_cast(p)
    enter_doubt(ctx)
    if l.try_lock_raw().is_some() then return
    var w = Waiting(Frame(ctx.top, 1), p, null)
    ctx.top = &w.frame
    enter_safe(ctx)
    l.lock_raw()
    leave_safe(ctx)
    ctx.top = w.frame.prev

/** Lets the lock `p` go, which the calling thread holds. */
@export("avin_rt_lock_release")
lock_release(ctx: *Context, p: *u8)
    val l: *Mutex[unit] = ptr_cast(p)
    leave_doubt(ctx)
    l.unlock_raw()

/** A new condition, with no thread waiting on it. */
@export("avin_rt_condition_new")
condition_new(ctx: *Context) -> *u8
    val p = allocate(ctx, &condition_descriptor)
    val c: *Condvar = ptr_cast(p)
    *c = Condvar.new()
    published(p)

/** Lets the lock `lock` go, which the calling thread holds, sleeps until the condition `p` is
 * notified, and takes the lock again. The thread is safe for the collector from before it lets the
 * lock go until it holds it again. A wait may also end with no notification, so the caller checks
 * what it waits for again. */
@export("avin_rt_condition_wait")
condition_wait(ctx: *Context, p: *u8, lock: *u8)
    val c: *Condvar = ptr_cast(p)
    val l: *Mutex[unit] = ptr_cast(lock)
    var w = Waiting(Frame(ctx.top, 2), p, lock)
    ctx.top = &w.frame
    enter_safe(ctx)
    c.wait(l)
    leave_safe(ctx)
    ctx.top = w.frame.prev

/** `condition_wait` for at most `millis` milliseconds: answers `false` where the time ran out before a
 * notification came. Either way the lock is held again when it answers, and the caller checks what it
 * waits for again. A time that is not positive answers `false` at once, without letting the lock go. */
@export("avin_rt_condition_wait_for")
condition_wait_for(ctx: *Context, p: *u8, lock: *u8, millis: long) -> bool
    if millis <= 0 then return false
    val c: *Condvar = ptr_cast(p)
    val l: *Mutex[unit] = ptr_cast(lock)
    val ns: i64 = if millis > 9223372036854 then 9223372036854000000 else millis * 1000000
    var w = Waiting(Frame(ctx.top, 2), p, lock)
    ctx.top = &w.frame
    enter_safe(ctx)
    val notified = c.wait_for(l, ns)
    leave_safe(ctx)
    ctx.top = w.frame.prev
    notified

/** Milliseconds on a clock that only moves forward, from a starting point of no meaning: the
 * difference between two readings is the time between them, which a bounded wait counts down. */
monotonic_millis() -> long = monotonic().us / 1000

/** How many processors the machine offers the program, and at least one: the size of the library's
 * pool of workers. */
processors() -> long
    val n = long(cpu_count())
    if n < 1 then 1 else n

/** Wakes one thread waiting on the condition `p`, if any is. */
@export("avin_rt_condition_notify")
condition_notify(ctx: *Context, p: *u8)
    val c: *Condvar = ptr_cast(p)
    c.notify_one()

/** Wakes every thread waiting on the condition `p`. */
@export("avin_rt_condition_notify_all")
condition_notify_all(ctx: *Context, p: *u8)
    val c: *Condvar = ptr_cast(p)
    c.notify_all()

// Held for each operation on an `Atomic` whose value is wider than a word, which has no single atomic
// access: every such operation takes this one lock, so each is indivisible from every other. No
// operation under it allocates or waits for anything but the lock.
private var wide_atomics: SpinLock = SpinLock(0)

/** Begins an operation on an `Atomic` wider than a word. */
@export("avin_rt_wide_atomic_begin")
wide_atomic_begin()
    wide_atomics.lock()

/** Ends an operation on an `Atomic` wider than a word. */
@export("avin_rt_wide_atomic_end")
wide_atomic_end()
    wide_atomics.unlock()

// The first reads of `lazy val`s. A lazy value's state is a word: 0 before anything has read it, the
// context of the thread running its initializer while that runs, and `LazyReady` once the value is
// stored. Compiled code reads a ready value with one load and calls here otherwise. Threads that
// find another running the initializer sleep on one lock and condition shared by every lazy value,
// which only first reads ever touch.
private const LazyReady: i64 = 1

private var lazy_lock: SleepLock = SleepLock.new()

private var lazy_stored: Condvar = Condvar.new()

/** Begins a read of the lazy value whose state is at `state` that did not find it ready: answers 1
 * where the calling thread has claimed the value and is to run its initializer, and 0 once another
 * thread has stored it, having waited for that thread, safe for the collector. A thread whose read
 * of a value runs while its own initialization of the value is running, so that the initializer
 * needs its own result, stops the program at `site`. */
@export("avin_rt_lazy_begin")
lazy_begin(ctx: *Context, state: *i64, site: *TrapSite) -> int
    val me = i64(usize(ctx))
    val found = atomic_cas(state, 0, me, AcqRel)
    if found == 0
        enter_doubt(ctx)
        return 1
    if found == LazyReady then return 0
    if found == me then stop(ctx, site)
    enter_safe(ctx)
    lazy_lock.lock()
    while atomic_load(state, Acquire) != LazyReady
        lazy_stored.wait_raw(&lazy_lock)
    lazy_lock.unlock()
    leave_safe(ctx)
    0

/** Ends the initialization of the lazy value whose state is at `state`, which the calling thread has
 * stored: marks it ready with a release store, so a thread that sees the mark sees the whole value,
 * and wakes every thread waiting for a lazy value. */
@export("avin_rt_lazy_end")
lazy_end(ctx: *Context, state: *i64)
    leave_doubt(ctx)
    lazy_lock.lock()
    atomic_store(state, LazyReady, Release)
    lazy_stored.notify_all()
    lazy_lock.unlock()

/** `p`, an object the runtime has just made, once it is complete: a release fence makes every store
 * before it, the object's header and contents, visible to another thread no later than any store
 * after it, such as the one that hands the object over. Compiled code ends the making of its own
 * objects the same way. */
published(p: *u8) -> *u8
    atomic_fence(Release)
    p
