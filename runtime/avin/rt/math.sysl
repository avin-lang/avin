module avin.rt

import sysl.math.Float
import sysl.math.{nextafter, ulp}

// The elementary functions of `avin.math`, each the platform's correctly behaved function on a
// binary64: a NaN argument gives NaN, an argument outside a function's domain gives NaN, and a pole
// gives the infinity the limit approaches.

real_sqrt(x: real) -> real = x.sqrt()
real_cbrt(x: real) -> real = x.cbrt()
real_exp(x: real) -> real = x.exp()
real_expm1(x: real) -> real = x.expm1()
real_log(x: real) -> real = x.ln()
real_log10(x: real) -> real = x.log10()
real_log1p(x: real) -> real = x.ln1p()
real_pow(x: real, y: real) -> real = x.pow(y)
real_hypot(x: real, y: real) -> real = x.hypot(y)

real_sin(x: real) -> real = x.sin()
real_cos(x: real) -> real = x.cos()
real_tan(x: real) -> real = x.tan()
real_asin(x: real) -> real = x.asin()
real_acos(x: real) -> real = x.acos()
real_atan(x: real) -> real = x.atan()
real_atan2(y: real, x: real) -> real = y.atan2(x)
real_sinh(x: real) -> real = x.sinh()
real_cosh(x: real) -> real = x.cosh()
real_tanh(x: real) -> real = x.tanh()

real_floor(x: real) -> real = x.floor()
real_ceil(x: real) -> real = x.ceil()
real_rint(x: real) -> real = x.round_even()
real_abs(x: real) -> real = x.abs()
real_max(x: real, y: real) -> real = x.maximum(y)
real_min(x: real, y: real) -> real = x.minimum(y)

real_trunc(x: real) -> real = x.trunc()
real_round(x: real) -> real = x.round()
real_log2(x: real) -> real = x.log2()
real_fma(x: real, y: real, z: real) -> real = x.mul_add(y, z)
real_copysign(x: real, sign: real) -> real = x.copysign(sign)
real_ulp(x: real) -> real = ulp(x)
real_next_up(x: real) -> real = nextafter(x, real.infinity())
real_next_down(x: real) -> real = nextafter(x, -real.infinity())
