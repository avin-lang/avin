{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Literate Avin",
  "scopeName": "text.lavin",
  "fileTypes": ["lavin"],
  "comment": "A .lavin file is a Markdown document whose lines indented four columns are an Avin program. The rules are the compiler's: a line indented four columns is program text, a fenced block is an illustration however it is indented, and an indented line under a list item belongs to the item. Every other line is prose, under meta.prose.lavin, set with the Markdown rules below, which are self-contained.",
  "patterns": [
    { "include": "#program" },
    { "include": "#prose" }
  ],
  "repository": {
    "prose": {
      "comment": "Every run of lines that is not the program is the Markdown document, under meta.prose.lavin, so that a theme or an editor can style the prose apart from the program. A run ends at a line indented four columns, unless a fence or a list item inside it has claimed that line.",
      "name": "meta.prose.lavin",
      "begin": "^(?! {4})",
      "end": "^(?= {4})",
      "patterns": [
        { "include": "#fence-avin" },
        { "include": "#fence" },
        { "include": "#heading" },
        { "include": "#setext" },
        { "include": "#rule" },
        { "include": "#quote" },
        { "include": "#list" },
        { "include": "#table" },
        { "include": "#paragraph" }
      ]
    },
    "program": {
      "comment": "A run of lines indented four columns, with blank lines between them, is the program. It ends at a line of prose: one with content less than four columns in.",
      "name": "meta.embedded.block.avin",
      "contentName": "source.avin",
      "begin": "^(?= {4})",
      "end": "^(?! {4}|[ \\t]*$)",
      "patterns": [{ "include": "source.avin" }]
    },
    "fence-avin": {
      "comment": "A fenced illustration marked avin is not compiled, and is coloured as Avin.",
      "name": "markup.fenced_code.block.markdown",
      "begin": "^ {0,3}(`{3,}|~{3,})[ \\t]*(avin)\\b.*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.markdown" },
        "2": { "name": "fenced_code.block.language.markdown" }
      },
      "end": "^ {0,3}(\\1[`~]*)[ \\t]*$",
      "endCaptures": { "1": { "name": "punctuation.definition.markdown" } },
      "contentName": "meta.embedded.block.avin",
      "patterns": [{ "include": "source.avin" }]
    },
    "fence": {
      "comment": "Any other fenced block is an illustration, set as it is written.",
      "name": "markup.fenced_code.block.markdown",
      "begin": "^ {0,3}(`{3,}|~{3,})(.*)$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.markdown" },
        "2": { "name": "fenced_code.block.language.markdown" }
      },
      "end": "^ {0,3}(\\1[`~]*)[ \\t]*$",
      "endCaptures": { "1": { "name": "punctuation.definition.markdown" } },
      "contentName": "markup.raw.block.markdown"
    },
    "heading": {
      "comment": "An ATX heading: one to six hashes, the text, and optional closing hashes.",
      "name": "markup.heading.markdown",
      "begin": "^ {0,3}(#{1,6})(?:[ \\t]+|$)",
      "beginCaptures": { "1": { "name": "punctuation.definition.heading.markdown" } },
      "end": "$",
      "contentName": "entity.name.section.markdown",
      "patterns": [
        { "match": "[ \\t]+#+[ \\t]*$", "name": "punctuation.definition.heading.markdown" },
        { "include": "#inline" }
      ]
    },
    "setext": {
      "comment": "The underline of a setext heading. A line cannot see the one above it, so the underline is what is marked; three or more dashes are a horizontal rule.",
      "patterns": [
        {
          "match": "^ {0,3}(=+)[ \\t]*$",
          "name": "markup.heading.setext.1.markdown",
          "captures": { "1": { "name": "punctuation.definition.heading.setext.markdown" } }
        },
        {
          "match": "^ {0,3}(-{1,2})[ \\t]*$",
          "name": "markup.heading.setext.2.markdown",
          "captures": { "1": { "name": "punctuation.definition.heading.setext.markdown" } }
        }
      ]
    },
    "rule": {
      "name": "meta.separator.markdown",
      "match": "^ {0,3}(?:(?:-[ \\t]*){3,}|(?:\\*[ \\t]*){3,}|(?:_[ \\t]*){3,})$"
    },
    "quote": {
      "comment": "A block quote runs while its lines begin with a marker.",
      "name": "markup.quote.markdown",
      "begin": "^ {0,3}(>)[ \\t]?",
      "beginCaptures": { "1": { "name": "punctuation.definition.quote.begin.markdown" } },
      "end": "^(?! {0,3}>)",
      "patterns": [
        { "match": "^ {0,3}(>)[ \\t]?", "captures": { "1": { "name": "punctuation.definition.quote.begin.markdown" } } },
        { "include": "#inline" }
      ]
    },
    "list": {
      "comment": "A list item runs to the first line with content no further in than its marker, so a blank line does not end it, and what is indented under it is prose, never program.",
      "name": "markup.list.markdown",
      "begin": "^ {0,3}([-*+]|[0-9]+[.)])[ \\t]",
      "beginCaptures": { "1": { "name": "punctuation.definition.list.begin.markdown" } },
      "end": "^(?= {0,3}\\S)",
      "patterns": [
        { "match": "^[ \\t]+([-*+]|[0-9]+[.)])[ \\t]", "captures": { "1": { "name": "punctuation.definition.list.begin.markdown" } } },
        { "include": "#inline" }
      ]
    },
    "table": {
      "comment": "A table row that begins with a pipe. A row written without a leading pipe is not recognised, since a line cannot see the delimiter row below it.",
      "patterns": [
        {
          "name": "markup.table.markdown",
          "match": "^ {0,3}\\|?[ \\t]*:?-+:?[ \\t]*(?:\\|[ \\t]*:?-+:?[ \\t]*)+\\|?[ \\t]*$",
          "captures": {}
        },
        {
          "name": "markup.table.markdown",
          "begin": "^ {0,3}(?=\\|)",
          "end": "$",
          "patterns": [
            { "match": "\\|", "name": "punctuation.separator.table.markdown" },
            { "include": "#inline" }
          ]
        }
      ]
    },
    "paragraph": {
      "patterns": [
        { "include": "#reference-definition" },
        { "include": "#inline" }
      ]
    },
    "reference-definition": {
      "match": "^ {0,3}(\\[)([^\\]]+)(\\]:)[ \\t]*(\\S+)",
      "name": "meta.link.reference.def.markdown",
      "captures": {
        "1": { "name": "punctuation.definition.constant.begin.markdown" },
        "2": { "name": "constant.other.reference.link.markdown" },
        "3": { "name": "punctuation.definition.constant.end.markdown" },
        "4": { "name": "markup.underline.link.markdown" }
      }
    },
    "inline": {
      "patterns": [
        { "include": "#escape" },
        { "include": "#code-span" },
        { "include": "#image" },
        { "include": "#link" },
        { "include": "#autolink" },
        { "include": "#html" },
        { "include": "#strong" },
        { "include": "#emphasis" },
        { "include": "#strike" }
      ]
    },
    "escape": {
      "name": "constant.character.escape.markdown",
      "match": "\\\\[\\\\`*_{}\\[\\]()#+\\-.!~<>|]"
    },
    "code-span": {
      "comment": "A run of backticks opens a span and an equal run closes it, so a longer run holds a shorter one.",
      "name": "markup.inline.raw.string.markdown",
      "match": "(?<!`)(`+)(?!`)(.+?)(?<!`)(\\1)(?!`)",
      "captures": {
        "1": { "name": "punctuation.definition.raw.markdown" },
        "3": { "name": "punctuation.definition.raw.markdown" }
      }
    },
    "image": {
      "name": "meta.image.inline.markdown",
      "match": "(!\\[)([^\\]]*)(\\])(\\()([^)\\s]*)(?:[ \\t]+(\"[^\"]*\"))?(\\))",
      "captures": {
        "1": { "name": "punctuation.definition.link.description.begin.markdown" },
        "2": { "name": "string.other.link.description.markdown" },
        "3": { "name": "punctuation.definition.link.description.end.markdown" },
        "4": { "name": "punctuation.definition.metadata.markdown" },
        "5": { "name": "markup.underline.link.image.markdown" },
        "6": { "name": "string.other.link.description.title.markdown" },
        "7": { "name": "punctuation.definition.metadata.markdown" }
      }
    },
    "link": {
      "patterns": [
        {
          "name": "meta.link.inline.markdown",
          "match": "(\\[)([^\\]]*)(\\])(\\()([^)\\s]*)(?:[ \\t]+(\"[^\"]*\"))?(\\))",
          "captures": {
            "1": { "name": "punctuation.definition.link.title.begin.markdown" },
            "2": { "name": "string.other.link.title.markdown" },
            "3": { "name": "punctuation.definition.link.title.end.markdown" },
            "4": { "name": "punctuation.definition.metadata.markdown" },
            "5": { "name": "markup.underline.link.markdown" },
            "6": { "name": "string.other.link.description.title.markdown" },
            "7": { "name": "punctuation.definition.metadata.markdown" }
          }
        },
        {
          "name": "meta.link.reference.markdown",
          "match": "(\\[)([^\\]]+)(\\])(\\[)([^\\]]*)(\\])",
          "captures": {
            "1": { "name": "punctuation.definition.link.title.begin.markdown" },
            "2": { "name": "string.other.link.title.markdown" },
            "3": { "name": "punctuation.definition.link.title.end.markdown" },
            "4": { "name": "punctuation.definition.constant.begin.markdown" },
            "5": { "name": "constant.other.reference.link.markdown" },
            "6": { "name": "punctuation.definition.constant.end.markdown" }
          }
        }
      ]
    },
    "autolink": {
      "name": "meta.link.inet.markdown",
      "match": "(<)((?:https?|ftp|mailto):[^>\\s]+|[^>\\s@]+@[^>\\s]+)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.link.markdown" },
        "2": { "name": "markup.underline.link.markdown" },
        "3": { "name": "punctuation.definition.link.markdown" }
      }
    },
    "html": {
      "patterns": [
        { "name": "comment.block.html", "match": "<!--.*?-->" },
        {
          "name": "meta.tag.inline.any.html",
          "match": "(</?)([A-Za-z][A-Za-z0-9:-]*)(?:[ \\t][^<>]*)?(/?>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.html" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          }
        }
      ]
    },
    "strong": {
      "patterns": [
        {
          "name": "markup.bold.markdown",
          "begin": "(\\*\\*)(?=\\S)",
          "beginCaptures": { "1": { "name": "punctuation.definition.bold.markdown" } },
          "end": "(?<=\\S)(\\*\\*)|$",
          "endCaptures": { "1": { "name": "punctuation.definition.bold.markdown" } },
          "patterns": [{ "include": "#inline" }]
        },
        {
          "name": "markup.bold.markdown",
          "begin": "(?<!\\w)(__)(?=\\S)",
          "beginCaptures": { "1": { "name": "punctuation.definition.bold.markdown" } },
          "end": "(?<=\\S)(__)(?!\\w)|$",
          "endCaptures": { "1": { "name": "punctuation.definition.bold.markdown" } },
          "patterns": [{ "include": "#inline" }]
        }
      ]
    },
    "emphasis": {
      "patterns": [
        {
          "name": "markup.italic.markdown",
          "begin": "(\\*)(?![*\\s])",
          "beginCaptures": { "1": { "name": "punctuation.definition.italic.markdown" } },
          "end": "(?<![\\s*])(\\*)|$",
          "endCaptures": { "1": { "name": "punctuation.definition.italic.markdown" } },
          "patterns": [{ "include": "#inline" }]
        },
        {
          "name": "markup.italic.markdown",
          "begin": "(?<![\\w_])(_)(?![_\\s])",
          "beginCaptures": { "1": { "name": "punctuation.definition.italic.markdown" } },
          "end": "(?<![\\s_])(_)(?!\\w)|$",
          "endCaptures": { "1": { "name": "punctuation.definition.italic.markdown" } },
          "patterns": [{ "include": "#inline" }]
        }
      ]
    },
    "strike": {
      "name": "markup.strikethrough.markdown",
      "begin": "(~~)(?=\\S)",
      "beginCaptures": { "1": { "name": "punctuation.definition.strikethrough.markdown" } },
      "end": "(?<=\\S)(~~)|$",
      "endCaptures": { "1": { "name": "punctuation.definition.strikethrough.markdown" } },
      "patterns": [{ "include": "#inline" }]
    }
  }
}
