{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Avin",
  "scopeName": "source.avin",
  "fileTypes": ["avin"],
  "patterns": [{ "include": "#shebang" }, { "include": "#header" }, { "include": "#code" }],
  "repository": {
    "shebang": {
      "comment": "A first line beginning `#!` names the program that runs the file, and is not Avin.",
      "name": "comment.line.number-sign.shebang.avin",
      "match": "\\A#!.*$"
    },
    "header": {
      "comment": "A dependencies header: `// avin.hocon` and the comment lines under it, whose text after `//` is a manifest's HOCON. It ends at the first line that is not a `//` comment.",
      "begin": "^\\s*(//)\\s*(avin\\.hocon)\\s*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.comment.avin" },
        "2": { "name": "keyword.other.header.avin" }
      },
      "end": "^(?!\\s*//)",
      "name": "meta.header.dependencies.avin",
      "patterns": [
        {
          "begin": "^\\s*(//)",
          "beginCaptures": { "1": { "name": "punctuation.definition.comment.avin" } },
          "end": "$",
          "patterns": [{ "include": "#hocon" }]
        }
      ]
    },
    "hocon": {
      "comment": "The HOCON of a dependencies header: comments, quoted strings, keys, booleans, numbers and punctuation.",
      "patterns": [
        { "name": "comment.line.hocon.avin", "match": "(#|//).*$" },
        {
          "name": "string.quoted.double.hocon.avin",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [{ "name": "constant.character.escape.hocon.avin", "match": "\\\\." }]
        },
        { "name": "constant.language.hocon.avin", "match": "\\b(true|false|null)\\b" },
        { "name": "constant.numeric.hocon.avin", "match": "-?\\b[0-9][0-9.]*\\b" },
        { "name": "variable.other.key.hocon.avin", "match": "[A-Za-z_][A-Za-z0-9_-]*(?=\\s*[{=:])" },
        { "name": "punctuation.separator.hocon.avin", "match": "[{}\\[\\],=:]" }
      ]
    },
    "code": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#char" },
        { "include": "#number" },
        { "include": "#annotation" },
        { "include": "#declaration" },
        { "include": "#keyword" },
        { "include": "#type" },
        { "include": "#call" },
        { "include": "#operator" },
        { "include": "#brackets" }
      ]
    },
    "comment": {
      "comment": "A line comment runs to the end of the line. Avin has no block comments.",
      "name": "comment.line.double-slash.avin",
      "begin": "//",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.avin" } },
      "end": "$"
    },
    "annotation": {
      "comment": "`@test`, `@intrinsic(\"…\")`, `@sysl(\"…\")`: the arguments are ordinary expressions.",
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
      "name": "meta.annotation.avin",
      "captures": {
        "1": { "name": "punctuation.definition.annotation.avin" },
        "2": { "name": "entity.name.function.decorator.avin" }
      }
    },
    "string": {
      "patterns": [
        { "include": "#rawTextBlock" },
        { "include": "#interpolatedTextBlock" },
        { "include": "#textBlock" },
        { "include": "#rawString" },
        { "include": "#formattedString" },
        { "include": "#interpolatedString" },
        { "include": "#plainString" }
      ]
    },
    "plainString": {
      "name": "string.quoted.double.avin",
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.avin" } },
      "end": "\"|$",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.avin" } },
      "patterns": [{ "include": "#escape" }]
    },
    "rawString": {
      "comment": "`raw\"…\"` keeps its text as written: holes, but no escapes.",
      "name": "string.quoted.double.raw.avin",
      "begin": "\\b(raw)(\")",
      "beginCaptures": {
        "1": { "name": "keyword.other.string-prefix.avin" },
        "2": { "name": "punctuation.definition.string.begin.avin" }
      },
      "end": "\"|$",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.avin" } },
      "patterns": [{ "include": "#holes" }]
    },
    "formattedString": {
      "comment": "`f\"…\"`: a hole may be followed by a format specifier, `${x}%08.3f`.",
      "name": "string.quoted.double.interpolated.avin",
      "begin": "\\b(f)(\")",
      "beginCaptures": {
        "1": { "name": "keyword.other.string-prefix.avin" },
        "2": { "name": "punctuation.definition.string.begin.avin" }
      },
      "end": "\"|$",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.avin" } },
      "patterns": [{ "include": "#escape" }, { "include": "#holes" }, { "include": "#specifier" }]
    },
    "interpolatedString": {
      "comment": "Any word directly before the quote names an interpolator: `s\"…\"`, `sql\"…\"`.",
      "name": "string.quoted.double.interpolated.avin",
      "begin": "\\b([A-Za-z_][A-Za-z0-9_]*)(\")",
      "beginCaptures": {
        "1": { "name": "keyword.other.string-prefix.avin" },
        "2": { "name": "punctuation.definition.string.begin.avin" }
      },
      "end": "\"|$",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.avin" } },
      "patterns": [{ "include": "#escape" }, { "include": "#holes" }]
    },
    "textBlock": {
      "name": "string.quoted.triple.avin",
      "begin": "\"\"\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.avin" } },
      "end": "\"\"\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.avin" } },
      "patterns": [{ "include": "#escape" }]
    },
    "rawTextBlock": {
      "name": "string.quoted.triple.raw.avin",
      "begin": "\\b(raw)(\"\"\")",
      "beginCaptures": {
        "1": { "name": "keyword.other.string-prefix.avin" },
        "2": { "name": "punctuation.definition.string.begin.avin" }
      },
      "end": "\"\"\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.avin" } },
      "patterns": [{ "include": "#holes" }]
    },
    "interpolatedTextBlock": {
      "name": "string.quoted.triple.interpolated.avin",
      "begin": "\\b([A-Za-z_][A-Za-z0-9_]*)(\"\"\")",
      "beginCaptures": {
        "1": { "name": "keyword.other.string-prefix.avin" },
        "2": { "name": "punctuation.definition.string.begin.avin" }
      },
      "end": "\"\"\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.avin" } },
      "patterns": [{ "include": "#escape" }, { "include": "#holes" }, { "include": "#specifier" }]
    },
    "escape": {
      "patterns": [
        {
          "name": "constant.character.escape.avin",
          "match": "\\\\(?:[ntr0abfve\\\\\"'`/]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
        },
        { "name": "invalid.illegal.escape.avin", "match": "\\\\." }
      ]
    },
    "holes": {
      "patterns": [
        { "name": "constant.character.escape.dollar.avin", "match": "\\$\\$" },
        {
          "name": "meta.embedded.expression.avin",
          "begin": "\\$\\{",
          "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.avin" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.section.embedded.end.avin" } },
          "patterns": [{ "include": "#braces" }, { "include": "#code" }]
        },
        {
          "match": "(\\$)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.variable.avin" },
            "2": { "name": "variable.other.interpolated.avin" }
          }
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [{ "include": "#braces" }, { "include": "#code" }]
    },
    "specifier": {
      "comment": "A format specifier directly after a hole: flags, width, precision, conversion.",
      "name": "constant.other.placeholder.avin",
      "match": "(?<=\\}|[A-Za-z0-9_])%[-+ 0#,(<]*(?:\\d+|\\$\\{[^}]*\\})?(?:\\.(?:\\d+|\\$\\{[^}]*\\}))?[A-Za-z%]"
    },
    "char": {
      "name": "string.quoted.single.avin",
      "match": "(')((?:\\\\(?:u\\{[0-9A-Fa-f]{1,6}\\}|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|.)|[^\\\\'\\n]))(')",
      "captures": {
        "1": { "name": "punctuation.definition.string.begin.avin" },
        "2": { "patterns": [{ "include": "#escape" }] },
        "3": { "name": "punctuation.definition.string.end.avin" }
      }
    },
    "number": {
      "patterns": [
        { "name": "constant.numeric.hex.avin", "match": "\\b0[xX][0-9A-Fa-f_]+\\b" },
        { "name": "constant.numeric.octal.avin", "match": "\\b0[oO][0-7_]+\\b" },
        { "name": "constant.numeric.binary.avin", "match": "\\b0[bB][01_]+\\b" },
        {
          "comment": "A real has a fraction or an exponent; `0..<n` is an integer and a range.",
          "name": "constant.numeric.float.avin",
          "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*(?:[eE][+-]?\\d[\\d_]*)?|[eE][+-]?\\d[\\d_]*)\\b"
        },
        { "name": "constant.numeric.integer.avin", "match": "\\b\\d[\\d_]*\\b" }
      ]
    },
    "declaration": {
      "patterns": [
        {
          "match": "\\b(class|trait|data|object)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.avin" },
            "2": { "name": "entity.name.type.avin" }
          }
        },
        {
          "match": "\\b(module)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.declaration.avin" },
            "2": { "name": "entity.name.namespace.avin" }
          }
        },
        {
          "comment": "`def` before a function or a method, which it names, or a symbol method.",
          "match": "\\b(def)\\s+([A-Za-z_][A-Za-z0-9_]*|(?:(?!//)[-+*/%<>=!&|^~:?#])+)",
          "captures": {
            "1": { "name": "keyword.declaration.avin" },
            "2": { "name": "entity.name.function.avin" }
          }
        },
        { "match": "\\b(impl|def)\\b", "name": "keyword.declaration.avin" },
        { "match": "\\b(import|export)\\b", "name": "keyword.control.import.avin" },
        {
          "comment": "A type alias: `type Parsed[T] = Result[T, ParseError]`; the name is a type, the body is read as types.",
          "match": "^(\\s*(?:private\\s+)?)(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "patterns": [{ "include": "#modifier" }] },
            "2": { "name": "keyword.declaration.avin" },
            "3": { "name": "entity.name.type.avin" }
          }
        },
        {
          "match": "\\b(val|var)\\b(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.declaration.avin" },
            "2": { "name": "variable.other.definition.avin" }
          }
        },
        {
          "comment": "A function at column 0 whose empty parameter list ends the line: `main()` with its body below.",
          "match": "^((?:(?:private|override|open|abstract|static|lazy)\\s+)*)(?!(?:if|elif|while|for|match|return|yield|loop|do|then|else)\\b)([A-Za-z_][A-Za-z0-9_]*)(?=(?:\\[[^\\]]*\\])?\\(\\s*\\)\\s*(?://.*)?$)",
          "captures": {
            "1": { "patterns": [{ "include": "#modifier" }] },
            "2": { "name": "entity.name.function.avin" }
          }
        },
        {
          "comment": "A function or method: a name, optional type parameters, and a parameter list that is empty and followed by `->` or `=`, or whose first entry is `name: Type`. A method may be named by a symbol.",
          "match": "^(\\s*(?:(?:private|override|open|abstract|static|lazy)\\s+)*)(?!(?:if|elif|while|for|match|return|yield|loop|do|then|else|val|var)\\b)([A-Za-z_][A-Za-z0-9_]*|(?:(?!//)[-+*/%<>=!&|^~:?#])+)(?=(?:\\[[^\\]]*\\])?\\((?:\\s*\\)\\s*(?:->|=(?!=))|\\s*(?:(?:private|val|var)\\s+)*[A-Za-z_][A-Za-z0-9_]*\\s*:(?!:)))",
          "captures": {
            "1": { "patterns": [{ "include": "#modifier" }] },
            "2": { "name": "entity.name.function.avin" }
          }
        },
        {
          "comment": "A member declared with no parameter list: an indented name, then `->`, its result type and a lone `=`. A match arm such as `None -> 0` has no lone `=` after its arrow.",
          "match": "^(\\s+(?:(?:private|override|open|abstract|static|lazy)\\s+)*)(?!(?:if|elif|while|for|match|return|yield|loop|do|then|else|val|var|case)\\b)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*->[^=]*(?<![=!<>+\\-*/%|&^:~])=(?![=>]))",
          "captures": {
            "1": { "patterns": [{ "include": "#modifier" }] },
            "2": { "name": "entity.name.function.avin" }
          }
        }
      ]
    },
    "modifier": {
      "name": "storage.modifier.avin",
      "match": "\\b(open|abstract|override|private|static|lazy|derives)\\b"
    },
    "keyword": {
      "patterns": [
        { "include": "#modifier" },
        {
          "name": "keyword.control.avin",
          "match": "\\b(if|then|elif|else|match|for|in|do|while|loop|return|break|continue|yield|defer|end)\\b"
        },
        {
          "comment": "`not` is a keyword only directly after `is`; elsewhere it is an ordinary name.",
          "match": "\\b(is)\\s+(not)\\b",
          "captures": {
            "1": { "name": "keyword.operator.word.avin" },
            "2": { "name": "keyword.operator.word.avin" }
          }
        },
        { "name": "keyword.operator.word.avin", "match": "\\b(is|as|with)\\b" },
        {
          "comment": "`_` alone is a placeholder: a lambda parameter in a call's argument, or a wildcard in a pattern.",
          "name": "variable.language.placeholder.avin",
          "match": "(?<![A-Za-z0-9_])_(?![A-Za-z0-9_])"
        },
        { "name": "variable.language.self.avin", "match": "\\bself\\b" },
        { "name": "variable.language.super.avin", "match": "\\bsuper\\b" },
        { "name": "constant.language.boolean.avin", "match": "\\b(true|false)\\b" }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "support.type.primitive.avin",
          "match": "\\b(int|long|byte|real|char|bool|string|unit|i[1-9][0-9]*)\\b"
        },
        { "name": "support.type.builtin.avin", "match": "\\b(Any|Nothing)\\b" },
        { "name": "entity.name.type.avin", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "call": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)(?=(?:\\[[^\\]]*\\])?\\()",
      "captures": { "1": { "name": "entity.name.function.call.avin" } }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.avin",
          "match": "(?<![-+*/%<>=!&|^~:?#])->(?![-+*/%<>=!&|^~:?#])"
        },
        { "name": "keyword.operator.range.avin", "match": "\\.\\.<?" },
        {
          "name": "keyword.operator.comparison.avin",
          "match": "(?<![-+*/%<>=!&|^~:?#])(?:===|!==|==|!=|<=|>=|<|>)(?![-+*/%<>=!&|^~:?#])"
        },
        {
          "comment": "`=` and every run ending in `=` that is not a comparison: `+=`, `+%=`, `++=`.",
          "name": "keyword.operator.assignment.avin",
          "match": "(?<![-+*/%<>=!&|^~:?#])(?:(?!//)[-+*/%<>&|^~:?#])*=(?![-+*/%<>=!&|^~:?#])"
        },
        {
          "comment": "Any other run of operator characters: arithmetic, the wrapping and saturating families, `::`, and methods named by symbols. A run stops before `//`.",
          "name": "keyword.operator.avin",
          "match": "(?:(?!//)[-+*/%<>=!&|^~:?#])+"
        },
        { "name": "punctuation.accessor.avin", "match": "\\." },
        { "name": "punctuation.separator.avin", "match": "," }
      ]
    },
    "brackets": {
      "patterns": [{ "match": "[\\[\\]()]", "name": "punctuation.bracket.avin" }]
    }
  }
}
