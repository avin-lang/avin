{
  "name": "avin",
  "displayName": "Avin",
  "description": "Syntax highlighting and language-server client for Avin",
  "version": "0.1.0",
  "publisher": "avin-lang",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/avin-lang/avin.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:avin"
  ],
  "main": "./out/extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "avin",
        "aliases": [
          "Avin",
          "avin"
        ],
        "extensions": [
          ".avin"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/icon.png",
          "dark": "./images/icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "avin",
        "scopeName": "source.avin",
        "path": "./syntaxes/avin.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Avin",
      "properties": {
        "avin.server.path": {
          "type": "string",
          "default": "avin",
          "description": "The avin executable. The extension runs it as '<path> lsp --stdio'."
        },
        "avin.server.repository": {
          "type": "string",
          "default": "",
          "description": "A checkout of the Avin repository to run the language server from instead of 'avin.server.path': the extension runs 'sysl run <repository>/compiler -- lsp --stdio' with AVIN_ROOT set to the checkout. Empty uses the installed executable."
        },
        "avin.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the messages exchanged with the language server in the Avin output channel."
        }
      }
    },
    "commands": [
      {
        "command": "avin.restartServer",
        "title": "Avin: Restart Language Server"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.cjs --sourcemap",
    "compile": "npm run typecheck && npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "package": "npm run compile && vsce package --no-dependencies --skip-license"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "type": "module"
}
