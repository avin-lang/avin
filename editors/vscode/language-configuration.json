{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*(->|(?<![=!<>])=|\\bmatch|\\bthen|\\belse|\\bdo)\\s*(//.*)?$|^\\s*(if|elif|while|for)\\b(?!.*\\b(then|do)\\s+[^/\\s]).*$|^\\s*(else|loop)\\s*(//.*)?$|^\\s*((private|open|abstract|static)\\s+)*(class|trait|data|object|impl)(\\s+[A-Za-z_(@]|\\[)[^=]*$|^((private|override|open|abstract|static|lazy|def)\\s+)*[A-Za-z_][A-Za-z0-9_]*(\\[[^\\]]*\\])?\\(.*\\)(\\s*->[^=]*)?\\s*(//.*)?$",
    "decreaseIndentPattern": "^\\s*(else|elif)\\b"
  },
  "folding": {
    "offSide": true
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|-?\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d+)?|[-+*/%<>=!&|^~:?]+"
}
