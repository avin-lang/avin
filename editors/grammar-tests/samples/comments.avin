// A comment runs to the end of its line.
// <-- comment.line.double-slash.avin punctuation.definition.comment.avin
//           ^^^^ comment.line.double-slash.avin
val x = 1 // trailing, with if then while
// <--- keyword.declaration.avin -comment
//        ^^ punctuation.definition.comment.avin
//           ^^^^^^^^ comment.line.double-slash.avin
//                          ^^ comment.line.double-slash.avin -keyword
val s = "not // a comment"
//           ^^ string.quoted.double.avin -comment
val w = a+// the run of operator characters stops before the comment
//       ^ keyword.operator.avin -comment
//        ^^ comment.line.double-slash.avin
val d = a /* b
//        ^^ keyword.operator.avin -comment
//           ^ -comment
    // indented
//  ^^ comment.line.double-slash.avin
val after = 2
// <--- keyword.declaration.avin -comment
