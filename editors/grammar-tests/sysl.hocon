// The tests of the editor grammar, editors/vscode/syntaxes/avin.tmLanguage.json, run on the same
// TextMate tokenizer an editor uses:
//
//     sysl test editors/grammar-tests
//
// A package of its own, so the compiler's gate does not need Oniguruma.
package {
  name    = "avin-grammar-tests"
  version = "0.1.0"
  sysl    = "0.8.0"
}

dependencies {
  highlighter { git = "github.com/sysl-lang/highlighter", version = "0.2.1" }
}

requires { heap = true, posix = true }
